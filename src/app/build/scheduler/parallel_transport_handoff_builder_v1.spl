# Parent-only conversion of an admitted immutable upload into child authority.
# No admission, transport, publication, or cleanup occurs here.
use app.build.scheduler.distributed_attempt.{
    PreparedDistributedBuildAttemptV1, DistributedBuildNodeV1}
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportFileV1, ParallelTransportHandoffV1,
    parallel_transport_approved_node_digest_v1,
    encode_parallel_transport_handoff_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1, encode_build_worker_request_v1,
    parse_build_worker_request_v1}
use app.build.scheduler.worker_ready.{BUILD_WORKER_CONTROL_DIRECTORY_V1,
    BUILD_WORKER_READY_MARKER_MAX_BYTES_V1, encode_build_worker_ready_v1,
    worker_ready_control_collision_v1}
use app.build.scheduler.trusted_sftp.{BUILD_SFTP_MAX_FILES_V1}
use app.build.scheduler.dispatch_wire.{encode_build_dispatch_v1}
use std.common.io.read_only_file_view.{read_only_file_view_open_v1,
    read_only_file_view_read_v1, read_only_file_view_close_v1}
use std.common.io.file_read_policy.{FileReadPolicyV1}
use std.async.cancellation.{CancellationToken}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_sync_mut.composition.native_build_argv_v1.{
    native_build_argv_encode_v1}
use std.io_runtime.{time_now_monotonic_ms}

struct PreparedParallelTransportHandoffV1:
    valid: bool
    reason: text
    handoff: ParallelTransportHandoffV1?
    wire: [u8]
    digest: text

fn _handoff_builder_reject_v1(reason: text) ->
        PreparedParallelTransportHandoffV1:
    PreparedParallelTransportHandoffV1(false, reason, nil, [], "")

fn _handoff_builder_batch_v1(root: text, relative_path: text,
        expected: text, snapshot_digest: text,
        maximum: i64) -> ParallelTransportFileV1?:
    val expected_bytes = expected.bytes()
    if expected_bytes.len() == 0 or expected_bytes.len() > maximum:
        return nil
    val opened = read_only_file_view_open_v1(root, relative_path,
        snapshot_digest, FileReadPolicyV1.buffered)
    if opened.is_err(): return nil
    var view = opened.unwrap()
    val size = view.identity.size
    if size == 0u64 or size > maximum.to_u64() or
       size != expected_bytes.len().to_u64():
        val _ = read_only_file_view_close_v1(view)
        return nil
    val read = read_only_file_view_read_v1(&view, 0u64, size,
        CancellationToken.new())
    val closed = read_only_file_view_close_v1(view)
    if read.is_err() or closed.is_err(): return nil
    val bytes = read.unwrap().bytes
    if bytes.len().to_u64() != size or bytes != expected_bytes:
        return nil
    Some(ParallelTransportFileV1(relative_path, bytes.len(),
        sha256_u8_hex(bytes)))

fn _handoff_builder_path_v1(path: text, absolute: bool) -> bool:
    if path == "" or path.len() > 4096 or
       path.starts_with("/") != absolute or path.ends_with("/"):
        return false
    val parts = path.split("/")
    var i: i64 = if absolute: 1 else: 0
    while i < parts.len():
        val part = parts[i]
        if part == "" or part == "." or part == ".." or
           part.len() > 128 or part.starts_with("-"):
            return false
        for ch in part.chars():
            if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
               (ch >= "0" and ch <= "9") or ch == "_" or ch == "-" or ch == ".":
                continue
            return false
        i = i + 1
    true

fn _handoff_builder_input_commands_v1(request: BuildWorkerRequestV1,
        root: text, remote: text) -> text:
    if not _handoff_builder_path_v1(remote, true) or
       request.action.inputs.env_inputs.len() != 0:
        return ""
    var paths: [text] = []
    for item in request.action.inputs.source_inputs:
        paths.push(item.logical_path)
    for item in request.action.inputs.generated_inputs:
        paths.push(item.logical_path)
    for item in request.action.inputs.dependency_outputs:
        paths.push(item.output_path)
    if paths.len() == 0 or paths.len() > BUILD_SFTP_MAX_FILES_V1:
        return ""
    var batch = "mkdir " + remote + "\n"
    var directories: [text] = []
    var seen: [text] = []
    for path in paths:
        if not _handoff_builder_path_v1(path, false) or
           worker_ready_control_collision_v1(path) or seen.contains(path):
            return ""
        seen.push(path)
        val parts = path.split("/")
        var parent = remote
        var i: i64 = 0
        while i + 1 < parts.len():
            parent = parent + "/" + parts[i]
            if not directories.contains(parent):
                batch = batch + "mkdir " + parent + "\n"
                directories.push(parent)
            i = i + 1
        batch = batch + "put " + root + "/inputs/" + path + " " +
            remote + "/" + path + "\n"
        if batch.bytes().len() > 65536: return ""
    batch

fn build_parallel_transport_handoff_v1(
        prepared_attempt: PreparedDistributedBuildAttemptV1,
        approved_node: DistributedBuildNodeV1, result_root: text,
        deadline_tick: i64, max_output_files: i64,
        max_output_bytes: i64) -> PreparedParallelTransportHandoffV1:
    """Bind an admitted request to bounded pinned batches and child authority.

    deadline_tick is an absolute host monotonic millisecond deadline. The
    caller owns both roots and retains the prepared snapshot until all child
    writers have ceased. Failure leaves admission and cleanup to that owner.
    """
    val now_tick = time_now_monotonic_ms()
    if now_tick < 0 or deadline_tick <= now_tick or
       deadline_tick > 1000000000000000:
        return _handoff_builder_reject_v1("handoff-deadline-invalid")
    if not prepared_attempt.ready or prepared_attempt.prepared == nil or
       prepared_attempt.request == nil or prepared_attempt.approved_node == nil:
        return _handoff_builder_reject_v1("prepared-attempt-invalid")
    val prepared = prepared_attempt.prepared.unwrap()
    val request = prepared_attempt.request.unwrap()
    val node_digest = parallel_transport_approved_node_digest_v1(approved_node)
    if node_digest == "" or node_digest !=
       parallel_transport_approved_node_digest_v1(
           prepared_attempt.approved_node.unwrap()):
        return _handoff_builder_reject_v1("approved-node-mismatch")
    val request_wire = encode_build_worker_request_v1(request)
    val parsed = parse_build_worker_request_v1(request_wire)
    if request_wire == "" or parsed == nil or
       encode_build_worker_request_v1(parsed.unwrap()) != request_wire or
       request.attempt.worker_id != approved_node.ssh.node.worker_id or
       prepared_attempt.request_digest != sha256_text(request_wire) or
       not prepared.ready or not prepared.plan.valid or
       not prepared.plan.input_plan.valid or
       prepared.plan.request_wire != request_wire or
       prepared.plan.request_digest != prepared_attempt.request_digest or
       prepared_attempt.dispatch_wire != encode_build_dispatch_v1(
           request.action, request.attempt, request.fence,
           request.cpu_tokens, request.fd_tokens):
        return _handoff_builder_reject_v1("prepared-request-mismatch")
    # Failure proof is the fourth file even when the action has no outputs.
    val required_files = if request.action.output_paths.len() > 0:
        request.action.output_paths.len() + 3 else: 4
    if max_output_files < required_files:
        return _handoff_builder_reject_v1("handoff-output-files-too-small")
    if not prepared.root.starts_with(approved_node.local_state_dir + "/") or
       prepared.input_batch_path != prepared.root + "/inputs.batch" or
       prepared.control_batch_path != prepared.root + "/control.batch":
        return _handoff_builder_reject_v1("prepared-batch-path-invalid")
    # This nonce is a non-secret deterministic binding, not authorization or
    # randomness. A unique prepared root scopes the admitted attempt.
    val nonce = sha256_u8_hex(native_build_argv_encode_v1([
        "simple-parent-transport-nonce-v1", prepared_attempt.request_digest,
        node_digest, prepared.root, result_root, deadline_tick.to_text(),
        max_output_files.to_text(), max_output_bytes.to_text()]))
    var handoff = ParallelTransportHandoffV1(true, "", nonce,
        request_wire, prepared_attempt.request_digest, approved_node,
        node_digest, prepared.root,
        ParallelTransportFileV1("inputs.batch",
            prepared.plan.input_plan.batch.bytes().len(),
            sha256_text(prepared.plan.input_plan.batch)),
        ParallelTransportFileV1("control.batch",
            prepared.control_batch.bytes().len(),
            sha256_text(prepared.control_batch)),
        result_root, deadline_tick, max_output_files, max_output_bytes)
    # Validate paths, disjoint roots, canonical request, and policy bounds
    # before any file open. The descriptors below come from pinned bytes.
    if encode_parallel_transport_handoff_v1(handoff).len() == 0:
        return _handoff_builder_reject_v1("handoff-policy-invalid")
    val remote = approved_node.sftp.remote_inbox_root + "/" +
        request.attempt.attempt_id
    val input_commands = _handoff_builder_input_commands_v1(request,
        prepared.root, remote)
    val remote_control = remote + "/" + BUILD_WORKER_CONTROL_DIRECTORY_V1
    val control_commands = "mkdir " + remote_control + "\n" +
        "put " + prepared.root + "/request.wire " + remote_control +
        "/request.wire\n" + "put " + prepared.root + "/ready " +
        remote_control + "/ready\n"
    val ready_wire = encode_build_worker_ready_v1(request)
    if input_commands == "" or
       input_commands != prepared.plan.input_plan.batch or
       control_commands != prepared.control_batch or
       remote != prepared.plan.remote_attempt_root or
       remote != prepared.plan.input_plan.remote_attempt_root or
       ready_wire == "" or ready_wire != prepared.plan.ready_wire:
        return _handoff_builder_reject_v1("prepared-plan-mismatch")
    val input = _handoff_builder_batch_v1(prepared.root, "inputs.batch",
        input_commands, prepared_attempt.request_digest, 65536)
    val control = _handoff_builder_batch_v1(prepared.root, "control.batch",
        control_commands, prepared_attempt.request_digest, 65536)
    if input == nil or control == nil:
        return _handoff_builder_reject_v1("prepared-batch-mismatch")
    handoff.input_batch = input
    handoff.control_batch = control
    val wire = encode_parallel_transport_handoff_v1(handoff)
    if wire.len() == 0:
        return _handoff_builder_reject_v1("handoff-encoding-invalid")
    val digest = sha256_u8_hex(wire)
    val pinned_request = _handoff_builder_batch_v1(prepared.root,
        "request.wire", request_wire, digest, 262144)
    val pinned_ready = _handoff_builder_batch_v1(prepared.root, "ready",
        ready_wire, digest, BUILD_WORKER_READY_MARKER_MAX_BYTES_V1)
    if pinned_request == nil or pinned_ready == nil:
        return _handoff_builder_reject_v1("prepared-control-mismatch")
    # Snapshot payloads were hashed during preparation and are checked again
    # by child_input before network. Pins here do not freeze later pathname
    # reopens; the process owner must enforce immutability and writer cessation.
    val finished_tick = time_now_monotonic_ms()
    if finished_tick < now_tick or finished_tick >= deadline_tick:
        return _handoff_builder_reject_v1("handoff-deadline-invalid")
    PreparedParallelTransportHandoffV1(true, "", handoff, wire, digest)

export PreparedParallelTransportHandoffV1
export build_parallel_transport_handoff_v1
