# Content-addressed storage for administrator-issued staged launch records.
# The caller must obtain trusted_root from installed administrator policy, not
# candidate input, CLI arguments, environment, cwd or repository contents.
use app.io.mod.{file_read_regular_no_follow_bounded, file_create_exclusive,
    file_fsync, directory_fsync, secure_temp_dir, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{file_publish_noreplace}
use app.build.scheduler.parent_issued_plan_wire.{ParentIssuedPlanWireV1,
    PARENT_ISSUED_PLAN_MAX_BYTES_V1, parse_parent_issued_plan_wire_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}

struct ParentIssuedPlanLoadV1:
    valid: bool
    reason: text
    record_digest: text
    record: ParentIssuedPlanWireV1?

struct ParentIssuedPlanPublishV1:
    published: bool
    durable: bool
    reason: text
    record_digest: text

fn issued_store_root_valid_v1(path: text) -> bool:
    if not path.starts_with("/") or path.len() < 2 or path.len() > 4000 or
       path.ends_with("/"):
        return false
    val parts = path.split("/")
    var i: i64 = 1
    while i < parts.len():
        val part = parts[i]
        if part == "" or part == "." or part == ".." or
           part.len() > 128 or part.starts_with("-"):
            return false
        for ch in part.chars():
            if (ch >= "a" and ch <= "z") or
               (ch >= "A" and ch <= "Z") or
               (ch >= "0" and ch <= "9") or
               ch == "-" or ch == "_" or ch == ".":
                continue
            return false
        i = i + 1
    true

fn _issued_store_path_v1(root: text, digest: text) -> text:
    root + "/staged-plans/" + digest + ".wire"

fn _issued_load_reject_v1(reason: text) -> ParentIssuedPlanLoadV1:
    ParentIssuedPlanLoadV1(false, reason, "", nil)

fn load_issued_parent_plan_v1(trusted_root: text,
        record_digest: text) -> ParentIssuedPlanLoadV1:
    """Read one exact record once from a separately trusted installation root."""
    if not issued_store_root_valid_v1(trusted_root) or
       not scheduler_action_digest_valid_v1(record_digest):
        return _issued_load_reject_v1("issued-plan-lookup-invalid")
    val path = _issued_store_path_v1(trusted_root, record_digest)
    val read = file_read_regular_no_follow_bounded(path,
        PARENT_ISSUED_PLAN_MAX_BYTES_V1)
    if read.is_err() or sha256_text(read.unwrap()) != record_digest:
        return _issued_load_reject_v1("issued-plan-record-mismatch")
    val parsed = parse_parent_issued_plan_wire_v1(read.unwrap())
    if not parsed.valid:
        return _issued_load_reject_v1(parsed.reason)
    ParentIssuedPlanLoadV1(true, "", record_digest, parsed)

fn _issued_existing_result_v1(trusted_root: text,
        digest: text) -> ParentIssuedPlanPublishV1:
    val path = _issued_store_path_v1(trusted_root, digest)
    val directory = trusted_root + "/staged-plans"
    val synced = file_fsync(path) and directory_fsync(directory)
    val retained = load_issued_parent_plan_v1(trusted_root, digest)
    if not retained.valid:
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-existing-invalid", digest)
    ParentIssuedPlanPublishV1(true, synced,
        if synced: "issued-plan-already-present" else:
            "issued-plan-durability-uncertain", digest)

fn publish_issued_parent_plan_v1(trusted_root: text,
        wire: text) -> ParentIssuedPlanPublishV1:
    """Publish an administrator-approved canonical record without replacement.

    Issuer must already have checked the full staged closure and policy. The
    existing protected directory and its ancestors must be administrator-owned.
    """
    val parsed = parse_parent_issued_plan_wire_v1(wire)
    if not issued_store_root_valid_v1(trusted_root) or not parsed.valid:
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-publication-invalid", "")
    val digest = sha256_text(wire)
    val existing = load_issued_parent_plan_v1(trusted_root, digest)
    if existing.valid:
        return _issued_existing_result_v1(trusted_root, digest)
    val directory = trusted_root + "/staged-plans"
    val temporary = secure_temp_dir(directory, "staged-plan-")
    if temporary.is_err():
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-stage-unavailable", digest)
    val stage = temporary.unwrap()
    val staged_file = stage + "/record.wire"
    if not file_create_exclusive(staged_file, wire) or
       not file_fsync(staged_file):
        dir_remove_all(stage)
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-stage-write-failed", digest)
    val destination = _issued_store_path_v1(trusted_root, digest)
    val published = file_publish_noreplace(staged_file, destination)
    if published.is_err():
        dir_remove_all(stage)
        return ParentIssuedPlanPublishV1(false, false,
            "issued-plan-publish-failed", digest)
    if not published.unwrap():
        dir_remove_all(stage)
        return _issued_existing_result_v1(trusted_root, digest)
    val durable = directory_fsync(directory)
    dir_remove_all(stage)
    ParentIssuedPlanPublishV1(true, durable,
        if durable: "issued-plan-published" else:
            "issued-plan-durability-uncertain", digest)

export ParentIssuedPlanLoadV1, ParentIssuedPlanPublishV1
export load_issued_parent_plan_v1, publish_issued_parent_plan_v1
export issued_store_root_valid_v1
