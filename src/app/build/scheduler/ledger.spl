# Parent-owned attempt journal state. Callers persist each returned ledger before
# dispatching an attempt or acknowledging a revocation.
use app.build.scheduler.planner.{SchedulerActionV1, plan_ready_actions_v1,
    scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{AcceptedResult, ActionResultCandidate}

struct SchedulerCapacityV1:
    cpu_tokens: i64
    memory_bytes: i64
    memory_reserve_bytes: i64
    fd_tokens: i64

struct SchedulerFenceV1:
    action_digest: text
    epoch: i64

struct SchedulerAttemptV1:
    action_digest: text
    attempt_id: text
    worker_id: text
    fence: i64
    cpu_tokens: i64
    memory_bytes: i64
    fd_tokens: i64
    active: bool

struct SchedulerFailedAttemptV1:
    action_digest: text
    attempt_id: text
    worker_id: text
    fence: i64
    classification: text
    output_manifest_digest: text
    diagnostic_digest: text

struct SchedulerLedgerV1:
    attempts: [SchedulerAttemptV1]
    fences: [SchedulerFenceV1]
    accepted: [AcceptedResult]
    failures: [SchedulerFailedAttemptV1]

struct SchedulerTransitionV1:
    ledger: SchedulerLedgerV1
    admitted: bool
    fence: i64
    error: text

fn empty_scheduler_ledger_v1() -> SchedulerLedgerV1:
    SchedulerLedgerV1([], [], [], [])

fn scheduler_failure_class_valid_v1(value: text) -> bool:
    ["source-diagnostic", "compiler-failure", "infrastructure-crash",
     "deadline", "cancelled", "result-invalid",
     "action-failure-unclassified"].contains(value)

fn scheduler_current_fence_v1(ledger: SchedulerLedgerV1, action_digest: text) -> i64:
    for fence in ledger.fences:
        if fence.action_digest == action_digest:
            return fence.epoch
    0

fn scheduler_next_retry_number_v1(ledger: SchedulerLedgerV1,
        action_digest: text) -> i64:
    """Count every durable admission, including revoked and failed attempts."""
    var count: i64 = 0
    for attempt in ledger.attempts:
        if attempt.action_digest == action_digest:
            count = count + 1
    count

fn scheduler_worker_busy_v1(ledger: SchedulerLedgerV1,
        worker_id: text) -> bool:
    """A one-shot worker holds its worker lock through one OCI execution."""
    for attempt in ledger.attempts:
        if attempt.active and attempt.worker_id == worker_id:
            return true
    false

fn scheduler_ledger_valid_v1(ledger: SchedulerLedgerV1) -> bool:
    if ledger.attempts.len() > 4096 or ledger.fences.len() > 256 or
       ledger.accepted.len() > 256 or ledger.failures.len() > 4096:
        return false
    var seen: [text] = []
    for fence in ledger.fences:
        if not scheduler_action_digest_valid_v1(fence.action_digest) or
           fence.epoch <= 0 or seen.contains(fence.action_digest):
            return false
        seen.push(fence.action_digest)
    var ids: [text] = []
    var active_actions: [text] = []
    for attempt in ledger.attempts:
        if not scheduler_action_digest_valid_v1(attempt.action_digest) or
           attempt.attempt_id == "" or attempt.worker_id == "" or
           ids.contains(attempt.attempt_id) or attempt.fence <= 0 or
           attempt.cpu_tokens <= 0 or attempt.memory_bytes <= 0 or attempt.fd_tokens <= 0:
            return false
        ids.push(attempt.attempt_id)
        if attempt.active:
            if active_actions.contains(attempt.action_digest) or
               scheduler_current_fence_v1(ledger, attempt.action_digest) != attempt.fence:
                return false
            active_actions.push(attempt.action_digest)
    var accepted_actions: [text] = []
    for accepted in ledger.accepted:
        if accepted.version != 1 or
           not scheduler_action_digest_valid_v1(accepted.action_digest) or
           accepted.accepted_attempt_id == "" or accepted.output_manifest_digest == "" or
           accepted.broker_receipt_digest == "" or
           accepted_actions.contains(accepted.action_digest) or
           active_actions.contains(accepted.action_digest):
            return false
        accepted_actions.push(accepted.action_digest)
    var failed_ids: [text] = []
    for failure in ledger.failures:
        if not scheduler_action_digest_valid_v1(failure.action_digest) or
           failure.attempt_id == "" or failure.worker_id == "" or
           failure.fence <= 0 or
           not scheduler_failure_class_valid_v1(failure.classification) or
           not scheduler_action_digest_valid_v1(failure.diagnostic_digest) or
           (failure.output_manifest_digest != "" and
            not scheduler_action_digest_valid_v1(failure.output_manifest_digest)) or
           failed_ids.contains(failure.attempt_id):
            return false
        var found = false
        for attempt in ledger.attempts:
            if attempt.attempt_id == failure.attempt_id and
               attempt.action_digest == failure.action_digest and
               attempt.worker_id == failure.worker_id and
               attempt.fence == failure.fence and not attempt.active:
                found = true
        if not found:
            return false
        for accepted in ledger.accepted:
            if accepted.accepted_attempt_id == failure.attempt_id:
                return false
        failed_ids.push(failure.attempt_id)
    true

fn _scheduler_replace_fence_v1(fences: [SchedulerFenceV1], action_digest: text,
                               epoch: i64) -> [SchedulerFenceV1]:
    var out: [SchedulerFenceV1] = []
    var found = false
    for fence in fences:
        if fence.action_digest == action_digest:
            out.push(SchedulerFenceV1(action_digest, epoch))
            found = true
        else:
            out.push(fence)
    if not found:
        out.push(SchedulerFenceV1(action_digest, epoch))
    out

fn _scheduler_dispatch_id_valid_v1(value: text) -> bool:
    # Keep admission within the dispatch wire's ID grammar. Otherwise the
    # journal append or worker dispatch can fail after capacity is reserved.
    if value.len() == 0 or value.len() > 128:
        return false
    var i: i64 = 0
    while i < value.len():
        val c = value[i:i + 1]
        if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
                (c >= "0" and c <= "9") or c == "-" or c == "_" or c == "."):
            return false
        i = i + 1
    true

fn admit_attempt_v1(ledger: SchedulerLedgerV1, actions: [SchedulerActionV1],
                    action_digest: text,
                    attempt_id: text, worker_id: text,
                    capacity: SchedulerCapacityV1, now_tick: i64) -> SchedulerTransitionV1:
    """Reserve local CPU/memory/FD capacity and advance this action's fence.

    This pure transition is serialized by the parent; persist its result before
    sending work to a child. The worker receives only the attempt envelope.
    """
    if not scheduler_ledger_valid_v1(ledger):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: ledger-invalid")
    var accepted_actions: [text] = []
    var active_actions: [text] = []
    for accepted in ledger.accepted:
        for action in actions:
            if action.action_digest == accepted.action_digest:
                accepted_actions.push(accepted.action_digest)
    for attempt in ledger.attempts:
        if attempt.active:
            for action in actions:
                if action.action_digest == attempt.action_digest:
                    active_actions.push(attempt.action_digest)
    val plan = plan_ready_actions_v1(actions, accepted_actions, active_actions, now_tick)
    if plan.error != "":
        return SchedulerTransitionV1(ledger, false, 0, plan.error)
    if not plan.ready.contains(action_digest):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: action-not-ready")
    var action = actions[0]
    for item in actions:
        if item.action_digest == action_digest:
            action = item
    if not _scheduler_dispatch_id_valid_v1(attempt_id) or
       not _scheduler_dispatch_id_valid_v1(worker_id):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: attempt-invalid")
    if action.cpu_tokens > 1000000 or action.memory_bytes > 1000000000000000 or
       action.fd_tokens > 1000000:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: action-resource-bound")
    if capacity.cpu_tokens <= 0 or capacity.memory_bytes <= 0 or
       capacity.fd_tokens <= 0 or capacity.memory_reserve_bytes < 0 or
       capacity.memory_reserve_bytes >= capacity.memory_bytes:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: capacity-invalid")
    for accepted in ledger.accepted:
        if accepted.action_digest == action.action_digest:
            return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: already-accepted")
    var cpu_left = capacity.cpu_tokens
    var memory_left = capacity.memory_bytes - capacity.memory_reserve_bytes
    var fd_left = capacity.fd_tokens
    for attempt in ledger.attempts:
        if attempt.attempt_id == attempt_id:
            return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: attempt-id-reused")
        if attempt.active:
            if attempt.action_digest == action.action_digest:
                return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: action-active")
            if attempt.cpu_tokens > cpu_left or attempt.memory_bytes > memory_left or
               attempt.fd_tokens > fd_left:
                return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: capacity-overcommitted")
            cpu_left = cpu_left - attempt.cpu_tokens
            memory_left = memory_left - attempt.memory_bytes
            fd_left = fd_left - attempt.fd_tokens
    if action.cpu_tokens > cpu_left or action.memory_bytes > memory_left or action.fd_tokens > fd_left:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: capacity-exhausted")
    if ledger.attempts.len() >= 4096:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: ledger-bound")
    val old_fence = scheduler_current_fence_v1(ledger, action.action_digest)
    # Reserve epoch 1,000,000,000 for durable failure/revocation closure.
    if old_fence >= 999999999 or (old_fence == 0 and ledger.fences.len() >= 256):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: fence-bound")
    val fence = old_fence + 1
    var attempts = ledger.attempts
    attempts.push(SchedulerAttemptV1(action.action_digest, attempt_id, worker_id,
                                     fence, action.cpu_tokens, action.memory_bytes,
                                     action.fd_tokens, true))
    SchedulerTransitionV1(SchedulerLedgerV1(attempts,
        _scheduler_replace_fence_v1(ledger.fences, action.action_digest, fence),
        ledger.accepted, ledger.failures), true, fence, "")

fn revoke_attempt_v1(ledger: SchedulerLedgerV1, attempt_id: text) -> SchedulerTransitionV1:
    """Close the active attempt and advance its fence before reassignment."""
    if not scheduler_ledger_valid_v1(ledger):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: ledger-invalid")
    var target: i64 = -1
    var i: i64 = 0
    while i < ledger.attempts.len():
        if ledger.attempts[i].attempt_id == attempt_id and ledger.attempts[i].active:
            target = i
        i = i + 1
    if target < 0:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: attempt-not-active")
    val old = ledger.attempts[target]
    val fence = scheduler_current_fence_v1(ledger, old.action_digest) + 1
    if fence > 1000000000:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: fence-bound")
    var attempts: [SchedulerAttemptV1] = []
    i = 0
    while i < ledger.attempts.len():
        val attempt = ledger.attempts[i]
        if i == target:
            attempts.push(SchedulerAttemptV1(attempt.action_digest, attempt.attempt_id,
                attempt.worker_id, attempt.fence, attempt.cpu_tokens,
                attempt.memory_bytes, attempt.fd_tokens, false))
        else:
            attempts.push(attempt)
        i = i + 1
    SchedulerTransitionV1(SchedulerLedgerV1(attempts,
        _scheduler_replace_fence_v1(ledger.fences, old.action_digest, fence),
        ledger.accepted, ledger.failures), true, fence, "")

fn fail_attempt_v1(ledger: SchedulerLedgerV1, candidate: ActionResultCandidate,
                   fence: i64, classification: text) -> SchedulerTransitionV1:
    """Close a failed current attempt and retain its diagnostic evidence."""
    if not scheduler_ledger_valid_v1(ledger):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: ledger-invalid")
    if candidate.version != 1 or candidate.success or
       not scheduler_action_digest_valid_v1(candidate.action_digest) or
       not _scheduler_dispatch_id_valid_v1(candidate.attempt_id) or
       not _scheduler_dispatch_id_valid_v1(candidate.worker_id) or
       not scheduler_failure_class_valid_v1(classification) or
       not scheduler_action_digest_valid_v1(candidate.diagnostic_digest) or
       (candidate.output_manifest_digest != "" and
        not scheduler_action_digest_valid_v1(candidate.output_manifest_digest)):
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: failure-invalid")
    if fence <= 0 or fence != scheduler_current_fence_v1(ledger,
            candidate.action_digest) or fence >= 1000000000:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: stale-fence")
    if ledger.failures.len() >= 4096:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: ledger-bound")
    var found = false
    var attempts: [SchedulerAttemptV1] = []
    for attempt in ledger.attempts:
        if attempt.action_digest == candidate.action_digest and
           attempt.attempt_id == candidate.attempt_id and
           attempt.worker_id == candidate.worker_id and
           attempt.fence == fence and attempt.active:
            found = true
            attempts.push(SchedulerAttemptV1(attempt.action_digest,
                attempt.attempt_id, attempt.worker_id, attempt.fence,
                attempt.cpu_tokens, attempt.memory_bytes, attempt.fd_tokens, false))
        else:
            attempts.push(attempt)
    if not found:
        return SchedulerTransitionV1(ledger, false, 0, "scheduler-error: attempt-not-current")
    var failures = ledger.failures
    failures.push(SchedulerFailedAttemptV1(candidate.action_digest,
        candidate.attempt_id, candidate.worker_id, fence, classification,
        candidate.output_manifest_digest, candidate.diagnostic_digest))
    val next_fence = fence + 1
    SchedulerTransitionV1(SchedulerLedgerV1(attempts,
        _scheduler_replace_fence_v1(ledger.fences, candidate.action_digest,
            next_fence), ledger.accepted, failures), true, next_fence, "")

export SchedulerCapacityV1, SchedulerFenceV1, SchedulerAttemptV1
export SchedulerFailedAttemptV1, scheduler_failure_class_valid_v1
export SchedulerLedgerV1, SchedulerTransitionV1
export empty_scheduler_ledger_v1, scheduler_current_fence_v1
export scheduler_next_retry_number_v1, scheduler_worker_busy_v1
export scheduler_ledger_valid_v1
export admit_attempt_v1, revoke_attempt_v1, fail_attempt_v1
