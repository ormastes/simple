# Versioned protected file format for a cold-link template. The base request is
# a canonical no-dependency intent; this loader never dispatches it.
use app.io.mod.{file_read_regular_no_follow_bounded}
use app.build.scheduler.parent_link_template.{ParentLinkInputV1,
    ParentLinkTemplateV1, PARENT_LINK_MAX_INPUTS_V1,
    parent_link_template_problem_v1}
use app.build.scheduler.worker_request.{
    BUILD_WORKER_REQUEST_MAX_BYTES_V1, parse_build_worker_request_v1}
use app.build.scheduler.planner.{scheduler_action_digest_valid_v1}
use compiler.common.build_contract.{AttemptSpec}
use std.common.crypto.sha256.{sha256_text}

val PARENT_LINK_TEMPLATE_WIRE_MAX_BYTES_V1: i64 = 32768

struct ParentLinkTemplateLoadV1:
    valid: bool
    reason: text
    template: ParentLinkTemplateV1?
    attempt: AttemptSpec?
    cpu_tokens: i64
    fd_tokens: i64
    template_wire_digest: text

struct _ParentLinkTemplateFileV1:
    valid: bool
    reason: text
    request_digest: text
    request_path: text
    inputs: [ParentLinkInputV1]

fn _link_template_file_reject_v1(reason: text) -> _ParentLinkTemplateFileV1:
    _ParentLinkTemplateFileV1(false, reason, "", "", [])

fn _link_template_load_reject_v1(reason: text) -> ParentLinkTemplateLoadV1:
    ParentLinkTemplateLoadV1(false, reason, nil, nil, 0, 0, "")

fn _link_template_path_token_v1(value: text) -> bool:
    if value == "" or value.len() > 128 or value == "." or value == ".." or
       value.starts_with("-"):
        return false
    for c in value.chars():
        if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
           (c >= "0" and c <= "9") or c == "-" or c == "_" or c == ".":
            continue
        return false
    true

fn _link_template_file_path_v1(value: text) -> bool:
    if not value.starts_with("/") or value.len() < 2 or
       value.len() > 4096 or value.ends_with("/"):
        return false
    val parts = value.split("/")
    var i: i64 = 1
    while i < parts.len():
        if not _link_template_path_token_v1(parts[i]): return false
        i = i + 1
    true

fn _link_template_index_v1(value: text) -> i64:
    if value == "" or value.len() > 3: return -1
    for c in value.chars():
        if c < "0" or c > "9": return -1
    val index = value.to_i64() ?? -1
    if index < 1 or index > 255 or index.to_text() != value: return -1
    index

fn parse_parent_link_template_file_v1(wire: text) -> _ParentLinkTemplateFileV1:
    if wire.len() == 0 or wire.len() > PARENT_LINK_TEMPLATE_WIRE_MAX_BYTES_V1 or
       not wire.ends_with("\n") or wire.contains("\r") or
       wire.contains("\x00"):
        return _link_template_file_reject_v1("link-template-wire-invalid")
    val lines = wire[0:wire.len() - 1].split("\n")
    if lines.len() < 3 or lines.len() > PARENT_LINK_MAX_INPUTS_V1 + 2 or
       lines[0] != "simple-parent-link-template-v1" or
       not lines[1].starts_with("base-request="):
        return _link_template_file_reject_v1("link-template-shape-invalid")
    val base = lines[1][13:].split("|")
    if base.len() != 2 or
       not scheduler_action_digest_valid_v1(base[0]) or
       not _link_template_file_path_v1(base[1]):
        return _link_template_file_reject_v1("link-template-base-invalid")
    var inputs: [ParentLinkInputV1] = []
    var prior_index: i64 = 0
    var i: i64 = 2
    while i < lines.len():
        if not lines[i].starts_with("input="):
            return _link_template_file_reject_v1("link-template-row-invalid")
        val fields = lines[i][6:].split("|")
        if fields.len() != 3 or
           not scheduler_action_digest_valid_v1(fields[0]):
            return _link_template_file_reject_v1("link-template-row-invalid")
        val index = _link_template_index_v1(fields[2])
        if index <= prior_index:
            return _link_template_file_reject_v1("link-template-index-invalid")
        inputs.push(ParentLinkInputV1(fields[0], fields[1], index))
        prior_index = index
        i = i + 1
    _ParentLinkTemplateFileV1(true, "", base[0], base[1], inputs)

fn load_pinned_parent_link_template_v1(path: text,
        expected_digest: text) -> ParentLinkTemplateLoadV1:
    """Read both exact files without following their final path components."""
    if not _link_template_file_path_v1(path) or
       not scheduler_action_digest_valid_v1(expected_digest):
        return _link_template_load_reject_v1("link-template-path-or-pin-invalid")
    val template_read = file_read_regular_no_follow_bounded(path,
        PARENT_LINK_TEMPLATE_WIRE_MAX_BYTES_V1)
    if template_read.is_err() or
       sha256_text(template_read.unwrap()) != expected_digest:
        return _link_template_load_reject_v1("link-template-digest-mismatch")
    val parsed = parse_parent_link_template_file_v1(template_read.unwrap())
    if not parsed.valid:
        return _link_template_load_reject_v1(parsed.reason)
    val request_read = file_read_regular_no_follow_bounded(
        parsed.request_path, BUILD_WORKER_REQUEST_MAX_BYTES_V1)
    if request_read.is_err() or
       sha256_text(request_read.unwrap()) != parsed.request_digest:
        return _link_template_load_reject_v1("link-template-base-digest-mismatch")
    val base_request = parse_build_worker_request_v1(request_read.unwrap())
    if base_request == nil or base_request.unwrap().fence != 1:
        return _link_template_load_reject_v1("link-template-base-request-invalid")
    val request = base_request.unwrap()
    val template = ParentLinkTemplateV1(request.action, parsed.inputs)
    val problem = parent_link_template_problem_v1(template)
    if problem != "": return _link_template_load_reject_v1(problem)
    var attempt = request.attempt
    attempt.action_digest = ""
    ParentLinkTemplateLoadV1(true, "", template, attempt,
        request.cpu_tokens, request.fd_tokens, expected_digest)

export PARENT_LINK_TEMPLATE_WIRE_MAX_BYTES_V1
export ParentLinkTemplateLoadV1, load_pinned_parent_link_template_v1
