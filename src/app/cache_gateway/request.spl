# Promotion-request decoding for the cache promotion gateway (C9 slice 1).
#
# A promotion request is an SDN file produced by a CI job. It carries the
# PromotionReceipt fields (C2, promotion/promotion_receipt.spl) plus the CI
# attestation fields and the artifact-closure digest list.
#
# Fail-closed decoding rules:
#   - empty / whitespace-only source            -> Invalid (gateway ERROR 2)
#   - unparsable SDN                            -> Invalid (gateway ERROR 2)
#   - not a mapping, or no `receipt.source_commit` -> Invalid (gateway ERROR 2)
#   - any OTHER absent field                    -> decoded as "" / false / []
#
# The last rule is deliberate: a missing attestation must reach the C2
# eligibility gate as an unmet condition so the gateway can REJECT it by
# NAME, rather than being swallowed as a decode error. Nothing here weakens
# any eligibility condition — absent evidence decodes to "no evidence".

use std.common.sdn.parser.{parse as sdn_parse}
use std.common.sdn.schema.{SdnDecodeIssues, sdn_get_text, sdn_get_int, sdn_get_bool, sdn_get_text_array}
use compiler.driver.cache.promotion.promotion_receipt.{PromotionReceipt}

# Everything the gateway is given about one candidate promotion.
struct PromotionRequest:
    receipt: PromotionReceipt
    ci_run_id: text          # CI run attestation — empty means "not attested"
    ci_builder_id: text      # must match receipt.builder_id to count as trusted
    ci_workflow_ref: text    # must be the protected main ref
    required_checks_passed: bool
    closure_digests: [text]  # digests of every artifact in the result closure

enum RequestParse:
    Parsed(PromotionRequest)
    Invalid(text)

# The one ref a protected promotion workflow may run from.
val PROTECTED_WORKFLOW_REF: text = "refs/heads/main"

fn _text_at(root, path: text, issues: SdnDecodeIssues) -> text:
    sdn_get_text(root, path, issues) ?? ""

fn parse_promotion_request(source: text) -> RequestParse:
    if source.trim().len() == 0:
        return RequestParse.Invalid("empty request")
    match sdn_parse(source):
        case Err(e):
            RequestParse.Invalid("unparsable SDN: {e}")
        case Ok(root):
            val issues = SdnDecodeIssues.new()
            val source_commit = _text_at(root, "receipt.source_commit", issues)
            if source_commit.len() == 0:
                return RequestParse.Invalid("request has no receipt.source_commit")
            val receipt = PromotionReceipt(
                repository_id: _text_at(root, "receipt.repository_id", issues),
                source_commit: source_commit,
                source_tree: _text_at(root, "receipt.source_tree", issues),
                trusted_ref: _text_at(root, "receipt.trusted_ref", issues),
                trusted_ref_tip: _text_at(root, "receipt.trusted_ref_tip", issues),
                clean_tree_digest: _text_at(root, "receipt.clean_tree_digest", issues),
                action_digest: _text_at(root, "receipt.action_digest", issues),
                result_manifest_digest: _text_at(root, "receipt.result_manifest_digest", issues),
                builder_id: _text_at(root, "receipt.builder_id", issues),
                workflow_digest: _text_at(root, "receipt.workflow_digest", issues),
                toolchain_digest: _text_at(root, "receipt.toolchain_digest", issues),
                external_parameters_digest: _text_at(root, "receipt.external_parameters_digest", issues),
                timestamp: sdn_get_int(root, "receipt.timestamp", issues) ?? 0,
                signature: _text_at(root, "receipt.signature", issues)
            )
            RequestParse.Parsed(PromotionRequest(
                receipt: receipt,
                ci_run_id: _text_at(root, "attestation.ci_run_id", issues),
                ci_builder_id: _text_at(root, "attestation.ci_builder_id", issues),
                ci_workflow_ref: _text_at(root, "attestation.ci_workflow_ref", issues),
                required_checks_passed: sdn_get_bool(root, "attestation.required_checks_passed", issues) ?? false,
                closure_digests: sdn_get_text_array(root, "closure.digests", issues) ?? []
            ))

export PromotionRequest, RequestParse, PROTECTED_WORKFLOW_REF
export parse_promotion_request
