# cache_gateway admin entry.
#
#   cache_gateway audit    — print the resolved §15.4 authority matrix
#   cache_gateway metrics  — print the metrics/quota report schema
#
# `audit` is the artifact CI publishes to prove the read-only-on-main property
# holds in the DEPLOYED code rather than in the design document. It derives the
# matrix by calling the real policy functions; it does not restate them.

use compiler.driver.cache.remote.namespace_policy.{
    namespace_policy_for_attestation, namespace_policy_may_write,
    namespace_policy_can_ever_write_main,
    NS_MAIN, NS_BRANCH,
    ROLE_DIRTY_DEVELOPER, ROLE_CLEAN_DEVELOPER, ROLE_UNTRUSTED_PR,
    ROLE_TRUSTED_BRANCH_CI, ROLE_TRUSTED_MAIN_CI, ROLE_RELEASE_CI
}
use app.cache_gateway.quota.{gateway_quota_default, gateway_quota_report}
use app.cache_gateway.metrics.{gateway_metrics_new, gateway_metrics_report}
use app.cache_gateway.publish.{load_git_provenance_facts, publish_via_gateway, env_or}
use compiler.driver.cache.promotion.promotion_receipt.{
    promotion_receipt_from_facts, promotion_receipt_sign
}
use std.env.{args}

fn yes_no(b: bool) -> text:
    if b:
        return "WRITE"
    "read-only"

# Each row asks the real code: given this attestation, can main be written?
fn audit_row(label: text, requested_role: text, builder_id: text, workflow_digest: text, approved: bool, dirty: bool) -> text:
    val policy = namespace_policy_for_attestation(
        requested_role: requested_role,
        user_name: "audit",
        attested_builder_id: builder_id,
        attested_workflow_digest: workflow_digest,
        workflow_is_approved: approved,
        worktree_dirty: dirty,
        branch_namespace_enabled: true
    )
    label + " -> role=" + policy.role
        + " main=" + yes_no(namespace_policy_may_write(policy, NS_MAIN))
        + " branch=" + yes_no(namespace_policy_may_write(policy, NS_BRANCH))
        + " can_ever_write_main=" + namespace_policy_can_ever_write_main(policy).to_text()

fn run_audit() -> i64:
    print("cache gateway authority audit (design §15.4, as resolved by deployed code)")
    print(audit_row("developer, dirty worktree", ROLE_TRUSTED_MAIN_CI, "b", "w", true, true))
    print(audit_row("developer, clean, no attestation", ROLE_TRUSTED_MAIN_CI, "", "", false, false))
    print(audit_row("developer claiming main CI", ROLE_TRUSTED_MAIN_CI, "", "w", true, false))
    print(audit_row("PR/fork, unapproved workflow", ROLE_TRUSTED_BRANCH_CI, "b", "w", false, false))
    print(audit_row("trusted branch CI", ROLE_TRUSTED_BRANCH_CI, "b", "w", true, false))
    print(audit_row("trusted main CI", ROLE_TRUSTED_MAIN_CI, "b", "w", true, false))
    print(audit_row("release CI", ROLE_RELEASE_CI, "b", "w", true, false))
    # Fail closed: if any developer-shaped row ever gained main write, the
    # audit itself must fail, not merely print.
    val dev = namespace_policy_for_attestation(
        requested_role: ROLE_TRUSTED_MAIN_CI,
        user_name: "audit",
        attested_builder_id: "",
        attested_workflow_digest: "",
        workflow_is_approved: true,
        worktree_dirty: false,
        branch_namespace_enabled: true
    )
    if namespace_policy_can_ever_write_main(dev):
        print("FAIL — an unattested developer credential resolved to main-write authority")
        return 1
    print("PASS — no unattested credential can write the main namespace")
    0

fn run_metrics() -> i64:
    val quota = gateway_quota_default(
        main_max_bytes: 64000000000,
        branch_max_bytes: 8000000000,
        cas_max_bytes: 32000000000,
        fs_free_bytes: 200000000000,
        fs_total_bytes: 500000000000
    )
    for line in gateway_quota_report(quota):
        print(line)
    for line in gateway_metrics_report(gateway_metrics_new()):
        print(line)
    0

fn flag_value(argv: [text], name: text) -> text:
    var i: i64 = 0
    while i + 1 < argv.len():
        if argv[i] == name:
            return argv[i + 1]
        i = i + 1
    ""

# Mode A publish. Builds the receipt from the provenance the CI job collected,
# signs it, runs C2's gate, and writes through the gateway — which re-derives
# the namespace from the credential, so this command cannot address main by
# itself either.
fn run_publish_main(argv: [text]) -> i64:
    val prov_path = flag_value(argv, "--provenance")
    val action_digest = flag_value(argv, "--action")
    val manifest_digest = flag_value(argv, "--manifest")
    if prov_path == "" or action_digest == "" or manifest_digest == "":
        print("usage: cache_gateway publish-main --provenance F --action D --manifest D")
        return 2
    val facts = load_git_provenance_facts(prov_path)
    if not facts:
        print("FAIL — could not read provenance from " + prov_path)
        return 1
    val signing_key = env_or(name: "PROMOTION_SIGNING_KEY", fallback: "")
    if signing_key == "":
        print("FAIL — PROMOTION_SIGNING_KEY is not set; refusing to publish unsigned")
        return 1
    val f = facts
    val receipt = promotion_receipt_sign(
        promotion_receipt_from_facts(
            facts: f,
            action_digest: action_digest,
            result_manifest_digest: manifest_digest,
            toolchain_digest: env_or(name: "CACHE_TOOLCHAIN_DIGEST", fallback: ""),
            external_parameters: env_or(name: "CACHE_EXTERNAL_PARAMETERS", fallback: ""),
            timestamp: f.now_epoch_seconds
        ),
        signing_key
    )
    val out = publish_via_gateway(f, receipt)
    print(out.reason)
    if out.ok:
        return 0
    1

fn run_publish_branch(argv: [text]) -> i64:
    val action_digest = flag_value(argv, "--action")
    val manifest_digest = flag_value(argv, "--manifest")
    if action_digest == "" or manifest_digest == "":
        print("usage: cache_gateway publish-branch --action D --manifest D")
        return 2
    # The wall clock comes from the caller (`date +%s` in the CI script), so the
    # command stays deterministic and testable.
    val now_raw = env_or(name: "CACHE_NOW_EPOCH", fallback: "0")
    val out = publish_branch_via_gateway(action_digest, manifest_digest, now_raw.to_i64())
    print(out.reason)
    if out.ok:
        return 0
    1

fn main() -> i64:
    val argv = args()
    var cmd = "audit"
    if argv.len() > 1:
        cmd = argv[1]
    if cmd == "audit":
        return run_audit()
    if cmd == "metrics":
        return run_metrics()
    if cmd == "publish-main":
        return run_publish_main(argv)
    if cmd == "publish-branch":
        return run_publish_branch(argv)
    print("usage: cache_gateway [audit|metrics|publish-main|publish-branch]")
    2
