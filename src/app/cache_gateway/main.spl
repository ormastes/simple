# cache_gateway — promotion policy gateway CLI (C9 slice 1).
#
# CI runs this ONCE PER PROMOTION REQUEST before anything is written to the
# trusted remote-main namespace. It validates the request against the C2
# eligibility policy and either emits an APPROVED receipt into an output
# directory, or reports the failing rule by name.
#
# NON-NEGOTIABLE, and true by construction in this file:
#   - NO network I/O. The only subprocess is a LOCAL `git merge-base
#     --is-ancestor`; the fetch that produced the trusted origin/main snapshot
#     is performed by CI before this runs, and its identity/authenticity/age
#     are passed in as arguments so `snapshot_is_fresh` can still reject a
#     stale one.
#   - NO remote write of any kind, from any machine. The remote-main write
#     step is C9 slice 2 and lives in the protected workflow, not here.
#     Approving on a developer machine therefore grants nothing — the
#     approved receipt is a local file.
#
# Verdict contract (last line of stdout, exit code authoritative):
#   PASS — promoted <n>            exit 0
#   FAIL — <rule>                  exit 1
#   ERROR — nothing was checked …  exit 2

use std.cli.cli_util (get_cli_args)
use app.io.mod (file_exists, file_read_text, file_write, dir_create_all, is_dir, process_run)
use compiler.driver.cache.promotion.git_ancestry.{MainSnapshot, GitAncestryOracle}
use compiler.driver.cache.promotion.promotion_receipt.{PromotionReceipt, promotion_receipt_digest}
use app.cache_gateway.request.{PromotionRequest, RequestParse, parse_promotion_request}
use app.cache_gateway.validate.{GatewayVerdict, validate_promotion, gateway_verdict_line, gateway_exit_code}

use std.io_runtime.{time_now_unix_micros}

# Ancestry oracle that never touches the network: the snapshot was fetched by
# the CI step before us and is handed in verbatim; only the ancestry query is
# evaluated here, against the local object database.
struct LocalGitAncestryOracle:
    repo_dir: text
    snapshot: MainSnapshot

impl GitAncestryOracle for LocalGitAncestryOracle:
    fn fetch_main_snapshot() -> MainSnapshot:
        self.snapshot

    fn is_ancestor(commit: text, snapshot: MainSnapshot) -> bool:
        if snapshot.tip_commit.len() == 0:
            return false
        val (_out, _err, code) = process_run("git", ["-C", self.repo_dir, "merge-base", "--is-ancestor", commit, snapshot.tip_commit])
        code == 0

struct GatewayOptions:
    request_path: text
    out_dir: text
    repo_dir: text
    main_tip: text
    fetched_at_micros: i64
    fetch_authenticated: bool
    repository_id: text
    remote_url: text
    error: text

fn print_help():
    print "Usage: simple run src/app/cache_gateway/main.spl <request.sdn> [options]"
    print ""
    print "Validate a cache promotion request against the remote-main eligibility policy."
    print "Performs no network I/O and never writes to a remote namespace."
    print ""
    print "Options:"
    print "  --out <dir>              Directory to write the approved receipt into"
    print "  --repo <dir>             Repository to run the local ancestry query in (default: .)"
    print "  --main-tip <commit>      Tip of the trusted origin/main snapshot CI already fetched"
    print "  --fetched-at-micros <n>  Unix micros at which that snapshot was fetched"
    print "  --fetch-authenticated    The fetch used an authenticated transport"
    print "  --repository-id <id>     Authenticated repository identity digest"
    print "  --remote-url <url>       Remote the snapshot came from"
    print "  -h, --help               Show this help"

fn parse_options(args: [text]) -> GatewayOptions:
    var opts = GatewayOptions(
        request_path: "", out_dir: "", repo_dir: ".", main_tip: "",
        fetched_at_micros: 0, fetch_authenticated: false,
        repository_id: "", remote_url: "", error: ""
    )
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--out" and i + 1 < args.len():
            opts.out_dir = args[i + 1]
            i = i + 1
        elif arg == "--repo" and i + 1 < args.len():
            opts.repo_dir = args[i + 1]
            i = i + 1
        elif arg == "--main-tip" and i + 1 < args.len():
            opts.main_tip = args[i + 1]
            i = i + 1
        elif arg == "--fetched-at-micros" and i + 1 < args.len():
            opts.fetched_at_micros = args[i + 1].to_i64()
            i = i + 1
        elif arg == "--repository-id" and i + 1 < args.len():
            opts.repository_id = args[i + 1]
            i = i + 1
        elif arg == "--remote-url" and i + 1 < args.len():
            opts.remote_url = args[i + 1]
            i = i + 1
        elif arg == "--fetch-authenticated":
            opts.fetch_authenticated = true
        elif arg.starts_with("--"):
            opts.error = "unknown option '{arg}'"
        elif opts.request_path == "":
            opts.request_path = arg
        else:
            opts.error = "unexpected extra argument '{arg}'"
        i = i + 1
    opts

fn snapshot_from(opts: GatewayOptions) -> MainSnapshot:
    MainSnapshot(
        remote_url: opts.remote_url,
        repository_id: opts.repository_id,
        ref_name: "refs/remotes/origin/main",
        tip_commit: opts.main_tip,
        fetched_at_unix_micros: opts.fetched_at_micros,
        fetch_authenticated: opts.fetch_authenticated
    )

# The APPROVED artifact. It records the receipt digest the gateway approved
# and the rule set it was approved under — it is evidence, not a credential:
# nothing downstream may treat this file as authorisation to write remote-main
# outside the protected workflow.
fn approved_receipt_sdn(receipt: PromotionReceipt) -> text:
    var lines: [text] = []
    lines.push("verdict: approved")
    lines.push("policy: simple/promotion-receipt/v1")
    lines.push("receipt_digest: \"{promotion_receipt_digest(receipt)}\"")
    lines.push("action_digest: \"{receipt.action_digest}\"")
    lines.push("result_manifest_digest: \"{receipt.result_manifest_digest}\"")
    lines.push("source_commit: \"{receipt.source_commit}\"")
    lines.join("\n") + "\n"

fn emit_error(reason: text) -> i64:
    val verdict = GatewayVerdict.Errored(reason)
    print gateway_verdict_line(verdict, 0)
    gateway_exit_code(verdict)

fn run(args: [text]) -> i64:
    if args.len() == 0:
        print_help()
        return emit_error("no request given")
    if args[0] == "-h" or args[0] == "--help":
        print_help()
        return 0

    val opts = parse_options(args)
    if opts.error != "":
        return emit_error(opts.error)
    if opts.request_path == "":
        return emit_error("no request given")
    if not file_exists(opts.request_path):
        return emit_error("request file not found: {opts.request_path}")

    val source = file_read_text(opts.request_path)
    match parse_promotion_request(source):
        case RequestParse.Invalid(reason):
            emit_error(reason)
        case RequestParse.Parsed(req):
            val oracle = LocalGitAncestryOracle(repo_dir: opts.repo_dir, snapshot: snapshot_from(opts))
            val verdict = validate_promotion(req, oracle, time_now_unix_micros())
            match verdict:
                case GatewayVerdict.Approved:
                    if opts.out_dir != "":
                        if not is_dir(opts.out_dir):
                            dir_create_all(opts.out_dir)
                        val name = "{opts.out_dir}/{req.receipt.action_digest}.approved.sdn"
                        file_write(name, approved_receipt_sdn(req.receipt))
                    print gateway_verdict_line(verdict, 1)
                    gateway_exit_code(verdict)
                case _:
                    print gateway_verdict_line(verdict, 0)
                    gateway_exit_code(verdict)

fn main() -> i64:
    run(get_cli_args())
