# Promotion-gateway validation (C9 slice 1).
#
# The gateway is the TRUSTED-WRITER-SIDE validator that CI runs before any
# remote-main write exists. It is a pure decision function: it performs no
# network I/O and no write of any kind, and it does not re-implement the C2
# policy layer — every accept/reject decision routes through
# `eligibility_check` in promotion/eligibility.spl, so the ten §15.1
# conditions stay the single source of truth.
#
# This module's only job is to turn a decoded `PromotionRequest` plus an
# independently-obtained ancestry answer into the `EligibilityInput` snapshot
# that gate consumes, WITHOUT taking any claim on faith that it can check
# itself:
#   - reachability comes from the injected `GitAncestryOracle`, never from a
#     field in the request,
#   - every other condition is derived from evidence PRESENT in the request;
#     absent evidence derives to `false`, so it is rejected by name.
#
# Rule 6 (developer machines never write remote-main) is preserved
# structurally: there is no write path here at all, in any branch.

use compiler.driver.cache.promotion.eligibility.{
    EligibilityInput, EligibilityResult,
    eligibility_check, eligibility_condition_text
}
use compiler.driver.cache.promotion.git_ancestry.{
    GitAncestryOracle, check_commit_reachable_from_main
}
use app.cache_gateway.request.{PromotionRequest, PROTECTED_WORKFLOW_REF}

# The gateway's three-valued verdict, matching the PASS/FAIL/ERROR contract.
enum GatewayVerdict:
    Approved
    Rejected(text)   # the failing eligibility rule, by name
    Errored(text)    # nothing could be checked

# An exact, immutable git commit id — 40 lowercase hex characters. A branch
# name, tag, or short id is a movable reference and does not satisfy §15.1's
# "exact immutable source commit".
fn commit_is_exact_id(commit: text) -> bool:
    if commit.len() != 40:
        return false
    for ch in commit.chars():
        if not "0123456789abcdef".contains(ch):
            return false
    true

# The CI attestation is present only when all three fields are populated AND
# the builder named by the attestation is the builder the receipt claims —
# a receipt whose builder disagrees with the run that produced it is not
# attested.
fn ci_attestation_present(req: PromotionRequest) -> bool:
    if req.ci_run_id.len() == 0:
        return false
    if req.ci_builder_id.len() == 0:
        return false
    req.ci_builder_id == req.receipt.builder_id

# The workflow is protected only when the run's ref is the protected main ref
# and the receipt pins the workflow definition it ran.
fn workflow_is_protected(req: PromotionRequest) -> bool:
    if req.ci_workflow_ref != PROTECTED_WORKFLOW_REF:
        return false
    req.receipt.workflow_digest.len() > 0

# The artifact closure must be non-empty and the manifest digest pinned —
# publishing a mapping whose closure is absent is exactly the crash-window
# bug layer rule 4 exists to prevent.
fn closure_exists(req: PromotionRequest) -> bool:
    if req.closure_digests.len() == 0:
        return false
    req.receipt.result_manifest_digest.len() > 0

fn eligibility_input_for(req: PromotionRequest, reachable: bool, snapshot_fresh: bool) -> EligibilityInput:
    EligibilityInput(
        clean_tree: req.receipt.clean_tree_digest.len() > 0,
        exact_commit_pinned: commit_is_exact_id(req.receipt.source_commit),
        repository_identity_authenticated: req.receipt.repository_id.len() > 0,
        origin_main_snapshot_trusted: snapshot_fresh,
        origin_main_snapshot_fresh: snapshot_fresh,
        commit_reachable_from_snapshot: reachable,
        builder_is_trusted_ci: ci_attestation_present(req),
        workflow_is_protected: workflow_is_protected(req),
        inputs_are_hermetic_and_declared: req.receipt.external_parameters_digest.len() > 0,
        manifest_and_artifacts_strictly_verified: closure_exists(req),
        required_tests_or_proofs_passed: req.required_checks_passed,
        receipt: req.receipt
    )

fn validate_promotion(req: PromotionRequest, oracle: GitAncestryOracle, now_unix_micros: i64) -> GatewayVerdict:
    val ancestry = check_commit_reachable_from_main(oracle, req.receipt.source_commit, now_unix_micros)
    val input = eligibility_input_for(req, ancestry.reachable, ancestry.snapshot_fresh)
    match eligibility_check(input):
        case EligibilityResult.Eligible:
            GatewayVerdict.Approved
        case EligibilityResult.Rejected(condition):
            GatewayVerdict.Rejected(eligibility_condition_text(condition))

fn gateway_verdict_line(verdict: GatewayVerdict, promoted: i64) -> text:
    match verdict:
        case GatewayVerdict.Approved:
            "PASS — promoted {promoted}"
        case GatewayVerdict.Rejected(rule):
            "FAIL — {rule}"
        case GatewayVerdict.Errored(reason):
            "ERROR — nothing was checked ({reason})"

fn gateway_exit_code(verdict: GatewayVerdict) -> i64:
    match verdict:
        case GatewayVerdict.Approved: 0
        case GatewayVerdict.Rejected(_): 1
        case GatewayVerdict.Errored(_): 2

export GatewayVerdict
export commit_is_exact_id, ci_attestation_present, workflow_is_protected, closure_exists
export eligibility_input_for, validate_promotion
export gateway_verdict_line, gateway_exit_code
