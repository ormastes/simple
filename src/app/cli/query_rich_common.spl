# Simple Language - Query Rich Common Utilities
#
# Shared state and utility functions used across query_rich split files.
# All extern fn declarations for query_* modules are centralised here.

use app.io.mod.{process_run}
use std.io_runtime.{file_write, file_exists, dir_list, get_args}
use std.nogc_sync_mut.io.file_ops.{file_mmap_read_text}

# ---------------------------------------------------------------------------
# Thin wrappers — importable by other query_* modules via `use`
# ---------------------------------------------------------------------------

fn query_file_exists(path: text) -> bool:
    file_exists(path)

fn query_file_write(path: text, content: text) -> bool:
    file_write(path, content)

fn query_process_run(cmd: text, args: [text]) -> (text, text, i64):
    process_run(cmd, args)

fn query_dir_list(path: text) -> [text]:
    dir_list(path)

fn query_cli_get_args() -> [text]:
    get_args()

# Module-level diagnostic accumulator for JSON collection mode
var _DIAG_COLLECT_MODE: bool = false
var _DIAG_COLLECTED: [text] = []

# Per-lint severity override, keyed by lint code. Populated by query_lint from the
# resolved LintConfig (strictness tier + sdn + @lint_profile). Value -1 suppresses
# the diagnostic (Allow); a positive value rewrites the LSP severity (Deny -> 1).
# Codes absent from the map keep their emitted severity (Warn / unconfigurable).
var _DIAG_SEVERITY_OVERRIDE: Dict<text, i64> = {}
var _DIAG_SEVERITY_OVERRIDE_COUNT: i64 = 0

export _DIAG_COLLECT_MODE, _DIAG_COLLECTED, _DIAG_SEVERITY_OVERRIDE, _DIAG_SEVERITY_OVERRIDE_COUNT
export _diag_emit_or_collect, query_file_read_rich
export _find_in_line, _find_in_line_from, _parse_error_location, _extract_decl_name
export query_split_structured_error
export query_mcp_diagnostics_wrapper_json, query_emit_mcp_diagnostics_wrapper

fn query_mcp_diagnostics_wrapper_json(diagnostics: [text]) -> text:
    val count_text = str(diagnostics.len())
    var parts: [text] = [
        "{\"content\":[{\"type\":\"text\",\"text\":\"",
        count_text,
        " diagnostics found\"}],\"structuredContent\":{\"diagnostics\":["
    ]
    var index = 0
    while index < diagnostics.len():
        if index > 0:
            parts.push(",")
        parts.push(diagnostics[index])
        index = index + 1
    parts.push("],\"count\":")
    parts.push(count_text)
    parts.push("},\"isError\":false}")
    parts.join("")

fn query_emit_mcp_diagnostics_wrapper(diagnostics: [text]):
    print query_mcp_diagnostics_wrapper_json(diagnostics)

fn _diag_is_digit_byte(byte: i64) -> bool:
    byte >= 48 and byte <= 57

fn _diag_code_of(json_str: text) -> text:
    """Extract the "code":"XXX" value from a diagnostic JSON string ("" if absent)."""
    val marker = "\"code\":\""
    val start = _find_in_line_from(json_str, marker, 0)
    if start < 0:
        return ""
    val vstart = start + marker.len()
    val vend = _find_in_line_from(json_str, "\"", vstart)
    if vend < 0:
        return ""
    json_str.substring(vstart, vend)

fn _diag_rewrite_severity(json_str: text, sev: i64) -> text:
    """Rewrite the "severity":N field of a diagnostic JSON to sev."""
    val marker = "\"severity\":"
    val start = _find_in_line_from(json_str, marker, 0)
    if start < 0:
        return json_str
    val vstart = start + marker.len()
    var vend = vstart
    while vend < json_str.len() and _diag_is_digit_byte(json_str.byte_at(vend)):
        vend = vend + 1
    if vend == vstart:
        return json_str
    val severity_text = sev.to_string()
    var same = severity_text.len() == vend - vstart
    var si = 0
    while same and si < severity_text.len():
        if json_str.byte_at(vstart + si) != severity_text.byte_at(si):
            same = false
        si = si + 1
    if same:
        return json_str
    var parts: [text] = [
        json_str.substring(0, vstart), severity_text, json_str.substring(vend)]
    parts.join("")

fn _diag_emit_or_collect(json_str: text):
    """Either print or collect a JSON diagnostic string depending on mode.

    Applies the LintConfig-derived severity override (suppress / elevate) so the
    LSP/build diagnostic path honors the strictness tier, matching `simple lint`.
    """
    var out = json_str
    if _DIAG_SEVERITY_OVERRIDE_COUNT > 0:
        val code = _diag_code_of(json_str)
        if code != "" and _DIAG_SEVERITY_OVERRIDE.has(code):
            val ov = _DIAG_SEVERITY_OVERRIDE[code]
            if ov < 0:
                return  # suppressed (Allow)
            out = _diag_rewrite_severity(json_str, ov)
    if _DIAG_COLLECT_MODE:
        _DIAG_COLLECTED.push(out)
    else:
        print out

fn query_file_read_rich(path: text) -> text:
    # Query/check entrypoints parse immediately after this read.  Mapping keeps
    # that early pure-Simple path off the buffered file reader while preserving
    # the same text ownership at the parser boundary.
    file_mmap_read_text(path)

# Escape JSON string content without repeatedly copying the whole value.  Keep
# this deliberately aligned with the historical query serializers: only the
# five characters below are escaped; Unicode and every other byte are retained.
fn query_json_escape(value: text) -> text:
    var needs_escape = false
    for ch in value.chars():
        if ch == "\\" or ch == "\"" or ch == "\n" or ch == "\r" or ch == "\t":
            needs_escape = true
            break
    if not needs_escape:
        return value

    var parts: [text] = []
    var span_start = 0
    for (i, ch) in value.chars().enumerate():
        var escaped = ""
        if ch == "\\":
            escaped = "\\\\"
        elif ch == "\"":
            escaped = "\\\""
        elif ch == "\n":
            escaped = "\\n"
        elif ch == "\r":
            escaped = "\\r"
        elif ch == "\t":
            escaped = "\\t"
        if escaped != "":
            if i > span_start:
                parts.push(value.substring(span_start, i))
            parts.push(escaped)
            span_start = i + 1
    if span_start < value.len():
        parts.push(value.substring(span_start))
    parts.join("")

fn _find_in_line(line: text, pattern: text) -> i64:
    """Find the 0-based position of pattern in line. Returns 0 if not found."""
    var pos = 0
    while pos <= line.len() - pattern.len():
        if line.substring(pos, pos + pattern.len()) == pattern:
            return pos
        pos = pos + 1
    0

fn _find_in_line_from(line: text, needle: text, start: i64) -> i64:
    """Find needle in line starting from a given position. Returns -1 if not found."""
    var i = if start < 0: 0 else: start
    val nlen = needle.len()
    if nlen == 0:
        if i <= line.len():
            return i
        return -1
    while i <= line.len() - nlen:
        var matched = true
        var ni = 0
        while ni < nlen:
            if line.byte_at(i + ni) != needle.byte_at(ni):
                matched = false
                break
            ni = ni + 1
        if matched:
            return i
        i = i + 1
    -1

fn query_rich_nonnegative_int_or_zero(value: text) -> i64:
    val trimmed = value.trim()
    if trimmed == "":
        return 0
    for ch in trimmed:
        if ch < "0" or ch > "9":
            return 0
    trimmed.to_int() ?? 0

fn _parse_error_location(err: text) -> (i64, i64, text):
    """Parse line:col:message from an error string. Returns (line, col, message)."""
    var colon1 = -1
    var colon2 = -1
    var ci = 0
    while ci < err.len():
        if err.byte_at(ci) == 58:
            if colon1 == -1:
                colon1 = ci
            elif colon2 == -1:
                colon2 = ci
                break
        ci = ci + 1
    if colon1 > 0 and colon2 > colon1:
        val line_str = err.substring(0, colon1)
        val col_str = err.substring(colon1 + 1, colon2)
        val msg = err.substring(colon2 + 1).trim()
        val line = query_rich_nonnegative_int_or_zero(line_str)
        val col = query_rich_nonnegative_int_or_zero(col_str)
        if line > 0:
            return (line, if col > 0: col else: 1, msg)
    (1, 1, err)

fn query_split_structured_error(err: text) -> (text, [text], text):
    """Parse `|||RELATED:` and `|||HELP:` metadata without a split array."""
    val separator = "|||"
    val first_separator = _find_in_line_from(err, separator, 0)
    if first_separator < 0:
        return (err, [], "")

    val core = err.substring(0, first_separator)
    var related: [text] = []
    var help = ""
    var segment_start = first_separator + separator.len()
    while segment_start <= err.len():
        val next_separator = _find_in_line_from(err, separator, segment_start)
        val segment_end = if next_separator < 0: err.len() else: next_separator
        val segment = err.substring(segment_start, segment_end).trim()
        if segment.starts_with("RELATED:"):
            related.push(segment.substring(8))
        elif segment.starts_with("HELP:"):
            help = segment.substring(5)
        if next_separator < 0:
            break
        segment_start = next_separator + separator.len()
    (core, related, help)

fn _extract_decl_name(after_kw: text) -> text:
    """Extract the variable name from text after val/var keyword."""
    var name_chars: [text] = []
    for ch in after_kw:
        val ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
        if not ok:
            break
        name_chars.push(ch)
    name_chars.join("")
