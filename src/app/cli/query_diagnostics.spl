# Simple Language - Query Diagnostics Subcommands
#
# Diagnostics query implementations: check, workspace-diagnostics,
# and their helper functions.

use app.cli.query_sanitize.{sanitize_path}
use app.cli.query_helpers.{_extract_flag}
use app.cli.query_error_codes.{query_extract_error_code}
use app.cli.query_rich_common.{_DIAG_COLLECT_MODE, _DIAG_COLLECTED, _diag_emit_or_collect, _parse_error_location, _find_in_line_from, query_file_read_rich, query_file_exists, query_dir_list, query_process_run, query_json_escape, query_emit_mcp_diagnostics_wrapper}
use app.cli.query_lint.{_emit_lint_if_readable, _emit_source_lint_diagnostics, _collect_lint_diagnostics_json}

fn query_check(file: text, cmd_args: [text]) -> i64:
    val format = _extract_flag(cmd_args, "--format", "text")
    val check_result = _run_simple_check(file)
    val check_stdout = check_result.0
    val check_stderr = check_result.1
    val check_code = check_result.2
    # JSON diagnostics and the lint gate consume the same normalized compiler
    # output. Own that O(S) combine/ANSI scan once at the command boundary.
    val clean_output = _clean_check_output(check_stdout, check_stderr)
    val should_lint = _should_run_lint_after_clean_output(clean_output)

    if format == "json":
        _DIAG_COLLECT_MODE = true
        _DIAG_COLLECTED = []
        val check_diags = _collect_check_output_diagnostics_json_clean(
            file, clean_output)
        for diagnostic in check_diags:
            _diag_emit_or_collect(diagnostic)
        if should_lint:
            _emit_lint_if_readable(file, format)
        query_emit_mcp_diagnostics_wrapper(_DIAG_COLLECTED)
        _DIAG_COLLECT_MODE = false
        if check_code != 0:
            return 1
        return 0

    if check_stdout != "":
        print check_stdout
    if check_stderr != "":
        print check_stderr
    if should_lint:
        _emit_lint_if_readable(file, format)
    if check_code != 0:
        return 1
    0

fn _split_structured_error(err: text) -> (text, [text], text):
    """Split a structured error string into (core_error, related_items, help_text).

    Structured error format uses '|||' as segment separator:
    - "core_error|||RELATED:line:col:message|||HELP:message"
    - Multiple RELATED segments are allowed
    - HELP segment is optional

    Returns (core_error, [related_items as "line:col:message"], help_text).
    """
    var core = err
    var related: [text] = []
    var help = ""

    # Check for structured metadata
    val sep = "|||"
    val sep_idx = _find_in_line_from(err, sep, 0)
    if sep_idx < 0:
        return (err, related, help)

    # Split on the first ||| to get core error
    core = err.substring(0, sep_idx)
    val rest = err.substring(sep_idx)

    # Parse remaining segments
    val segments = rest.split(sep)
    for segment in segments:
        val trimmed = segment.trim()
        if trimmed == "":
            continue
        if trimmed.starts_with("RELATED:"):
            val rel_content = trimmed.substring(8)
            related = related.push(rel_content)
        elif trimmed.starts_with("HELP:"):
            help = trimmed.substring(5)

    (core, related, help)

fn _extract_error_code(msg: text, error_kind: text) -> text:
    query_extract_error_code(msg, error_kind, "SFFI error")

fn query_workspace_diagnostics(dir_path: text, cmd_args: [text]) -> i64:
    """Run diagnostics on all .spl files in a directory.

    Outputs diagnostics grouped by file. Supports --format=json for
    structured JSON output suitable for LSP workspace diagnostics.
    """
    val format = _extract_flag(cmd_args, "--format", "text")
    val clean_dir = sanitize_path(dir_path)
    if clean_dir == "":
        print "Error: invalid directory path"
        return 1

    # Collect all .spl files recursively
    var spl_files: [text] = []
    _collect_spl_files(clean_dir, spl_files)

    if spl_files.len() == 0:
        if format == "json":
            print "[]"
        else:
            print "No .spl files found in: {clean_dir}"
        return 0

    var total_diagnostics = 0
    var files_with_issues = 0
    var json_file_entries: [text] = []

    for spl_file in spl_files:
        var file_has_issues = false
        var file_diag_count = 0
        var file_json_diags: [text] = []

        if format == "json":
            val query_json = _run_query_check_json(spl_file)
            val compiler_diags = _extract_query_check_diagnostics(query_json.0)
            file_diag_count = compiler_diags.len()
            if file_diag_count > 0:
                file_has_issues = true
                for diagnostic in compiler_diags:
                    file_json_diags.push(diagnostic)
            if file_has_issues:
                files_with_issues = files_with_issues + 1
                if file_json_diags.len() > 0:
                    json_file_entries.push("{\"file\":{_json_text(spl_file)},\"diagnostics\":[{file_json_diags.join(\",\")}]}")
            total_diagnostics = total_diagnostics + file_diag_count
            continue
        val check_result = _run_simple_check(spl_file)
        val check_stdout = check_result.0
        val check_stderr = check_result.1
        val check_code = check_result.2
        val clean_output = _clean_check_output(check_stdout, check_stderr)
        val should_lint = _should_run_lint_after_clean_output(clean_output)
        if format != "json":
            if check_stdout != "":
                print check_stdout
            if check_stderr != "":
                print check_stderr
            if check_code != 0:
                file_has_issues = true
                file_diag_count = file_diag_count +
                    _count_check_output_diagnostics_clean(
                        spl_file, clean_output)

        if format != "json" and query_file_exists(spl_file):
            val source = query_file_read_rich(spl_file) ?? ""
            if source != "" and should_lint:
                val lint_count = _emit_source_lint_diagnostics(spl_file, source, format)
                if lint_count > 0:
                    file_has_issues = true
                    file_diag_count = file_diag_count + lint_count

        if file_has_issues:
            files_with_issues = files_with_issues + 1
        total_diagnostics = total_diagnostics + file_diag_count

    if format == "json":
        print "[{json_file_entries.join(\",\")}]"
    else:
        print ""
        print "--- Summary ---"
        print "Files scanned: {spl_files.len()}"
        print "Files with issues: {files_with_issues}"
        print "Total diagnostics: {total_diagnostics}"

    if total_diagnostics > 0:
        return 1
    0

fn _collect_spl_files(dir: text, files: [text]):
    """Recursively collect all .spl files in a directory."""
    val entries = query_dir_list(dir)
    for entry in entries:
        if entry == "." or entry == "..":
            continue
        val full_path = if dir.ends_with("/"): dir + entry else: dir + "/" + entry
        if entry.ends_with(".spl"):
            files.push(full_path)
        # Recurse into subdirectories (heuristic: no extension = directory)
        elif not entry.contains("."):
            _collect_spl_files(full_path, files)

fn _find_simple_binary() -> text:
    if query_file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    if query_file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if query_file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if query_file_exists("bin/simple"):
        return "bin/simple"
    "bin/simple"

fn _run_simple_check(file: text) -> (text, text, i64):
    query_process_run(_find_simple_binary(), ["check", file])

fn _run_query_check_json(file: text) -> (text, text, i64):
    query_process_run(_find_simple_binary(), ["run", "src/app/cli/query.spl", "check", file, "--format", "json"])

fn _should_run_lint_after_check(check_stdout: text, check_stderr: text) -> bool:
    _should_run_lint_after_clean_output(
        _clean_check_output(check_stdout, check_stderr))

fn _clean_check_output(check_stdout: text, check_stderr: text) -> text:
    _strip_ansi(check_stdout + "\n" + check_stderr)

fn _should_run_lint_after_clean_output(clean_output: text) -> bool:
    if clean_output.trim() == "":
        return true
    if clean_output.contains("unexpected token") or clean_output.contains("ParseError"):
        return false
    true

fn _strip_ansi(s: text) -> text:
    # Compiler output is normally plain text. Avoid allocating one fragment per
    # character plus a joined copy when no escape sequence can be present.
    if not s.contains("\x1b"):
        return s

    var parts: [text] = []
    var in_escape = false
    for ch in s:
        if in_escape:
            if ch == "m":
                in_escape = false
            continue
        if ch == "\033" or ch == "\x1b":
            in_escape = true
            continue
        parts.push(ch)
    parts.join("")

fn _count_check_output_diagnostics(file: text, check_stdout: text, check_stderr: text) -> i64:
    _count_check_output_diagnostics_clean(
        file, _clean_check_output(check_stdout, check_stderr))

fn _count_check_output_diagnostics_clean(file: text, clean_output: text) -> i64:
    val prefix = file + ":"
    var count = 0
    for line in clean_output.split("\n"):
        val trimmed = line.trim()
        # _parse_check_output_line_json emits one object for every nonblank
        # line with this prefix, even when location fields fall back to 1:1.
        # Count that exact admission predicate without allocating JSON objects.
        if trimmed != "" and trimmed.starts_with(prefix):
            count = count + 1
    count

fn _collect_check_output_diagnostics_json(file: text, check_stdout: text, check_stderr: text) -> [text]:
    _collect_check_output_diagnostics_json_clean(
        file, _clean_check_output(check_stdout, check_stderr))

fn _collect_check_output_diagnostics_json_clean(
    file: text, clean_output: text
) -> [text]:
    val lines = clean_output.split("\n")
    var diagnostics: [text] = []
    for line in lines:
        val diagnostic = _parse_check_output_line_json(file, line)
        if diagnostic != "":
            diagnostics.push(diagnostic)
    diagnostics

fn _extract_query_check_diagnostics(check_json: text) -> [text]:
    val key = "\"diagnostics\":["
    val key_idx = _find_query_diagnostics_key(check_json, key)
    if key_idx < 0:
        return []
    var result: [text] = []
    var array_depth = 1
    var object_depth = 0
    var object_start = key_idx + key.len()
    var in_string = false
    var escaped = false
    var i = object_start
    while i < check_json.len():
        val ch = check_json.byte_at(i)
        if in_string:
            if escaped:
                escaped = false
            elif ch == 92:
                escaped = true
            elif ch == 34:
                in_string = false
            i = i + 1
            continue
        if ch == 34:
            in_string = true
        elif ch == 91:
            array_depth = array_depth + 1
        elif ch == 93:
            array_depth = array_depth - 1
            if array_depth == 0:
                return result
        elif ch == 123:
            if object_depth == 0:
                object_start = i
            object_depth = object_depth + 1
        elif ch == 125:
            object_depth = object_depth - 1
            if object_depth == 0:
                result.push(check_json.substring(object_start, i + 1))
        i = i + 1
    # The legacy two-pass path discarded even completed objects when the outer
    # diagnostics array had no matching close.
    []

fn _find_query_diagnostics_key(s: text, key: text) -> i64:
    # Both lengths and byte_at indices use byte offsets. Unlike the generic
    # substring search this remains allocation-free and valid when arbitrary
    # Unicode precedes the compact ASCII key.
    val key_len = key.len()
    val source_len = s.len()
    if key_len == 0:
        return 0
    var i = 0
    while i + key_len <= source_len:
        var matched = true
        var j = 0
        while j < key_len:
            if s.byte_at(i + j) != key.byte_at(j):
                matched = false
                break
            j = j + 1
        if matched:
            return i
        i = i + 1
    -1

fn _find_matching_json_array_end(s: text, start: i64) -> i64:
    var depth = 1
    var i = start
    var in_string = false
    var escaped = false
    while i < s.len():
        val ch = s.byte_at(i)
        if in_string:
            if escaped:
                escaped = false
            elif ch == 92:
                escaped = true
            elif ch == 34:
                in_string = false
            i = i + 1
            continue
        if ch == 34:
            in_string = true
        elif ch == 91:
            depth = depth + 1
        elif ch == 93:
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    -1

fn _split_top_level_json_objects(s: text) -> [text]:
    _split_top_level_json_objects_range(s, 0, s.len())

fn _split_top_level_json_objects_range(
    s: text, range_start: i64, range_end: i64
) -> [text]:
    var result: [text] = []
    var depth = 0
    var start = range_start
    var in_string = false
    var escaped = false
    var i = range_start
    while i < range_end:
        val ch = s.byte_at(i)
        if in_string:
            if escaped:
                escaped = false
            elif ch == 92:
                escaped = true
            elif ch == 34:
                in_string = false
            i = i + 1
            continue
        if ch == 34:
            in_string = true
        elif ch == 123:
            if depth == 0:
                start = i
            depth = depth + 1
        elif ch == 125:
            depth = depth - 1
            if depth == 0:
                result.push(s.substring(start, i + 1))
        i = i + 1
    result

fn _parse_check_output_line_json(file: text, line: text) -> text:
    val trimmed = line.trim()
    if trimmed == "":
        return ""
    val prefix = file + ":"
    if not trimmed.starts_with(prefix):
        return ""
    val parsed = _parse_error_location(trimmed.substring(prefix.len()))
    val line_num = parsed.0
    val col_num = parsed.1
    var msg = parsed.2
    var severity = 1
    if msg.starts_with("warning"):
        severity = 2
        msg = _strip_diag_severity_prefix(msg, "warning")
    elif msg.starts_with("info"):
        severity = 3
        msg = _strip_diag_severity_prefix(msg, "info")
    elif msg.starts_with("hint"):
        severity = 4
        msg = _strip_diag_severity_prefix(msg, "hint")
    elif msg.starts_with("error"):
        msg = _strip_diag_severity_prefix(msg, "error")
    val code = _extract_error_code(msg, "ParseError")
    "{\"severity\":{severity},\"code\":{_json_text(code)},\"message\":{_json_text(msg)},\"line\":{line_num},\"col\":{col_num},\"end_line\":{line_num},\"end_col\":{col_num},\"tags\":[],\"source\":\"simple\"}"

fn _strip_diag_severity_prefix(msg: text, severity_word: text) -> text:
    var rest = msg.substring(severity_word.len()).trim()
    if rest.starts_with(":"):
        rest = rest.substring(1).trim()
    rest

fn _json_text(value: text) -> text:
    "\"" + _escape_json(value) + "\""

fn _escape_json(value: text) -> text:
    query_json_escape(value)
