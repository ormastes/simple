# Minimal pure-Simple bootstrap authorization planner.
#
# This entrypoint deliberately imports only the typed policy and canonical file
# facade. It lets an admitted Stage-2 compiler produce the policy receipt needed
# to rebuild a stale Stage-2 authority without pulling the full CLI/compiler
# closure into the planner itself.

extern fn rt_get_args() -> [text]
# Bootstrap recovery boundary: the stale Stage-2 compiler cannot lower the
# current general file facade because that module contains the folded constants
# this planner exists to replace. Keep the two canonical runtime operations
# local and bounded; no process execution or arbitrary file reads are exposed.
# rt_file_write_text (not rt_file_write_text_at): the (ptr, len) text-extern
# ABI for both text args is registered in
# src/compiler/50.mir/text_extern_abi.spl, matching the C/pure-Simple runtime
# ABI. rt_file_write_text_at has a boxed-handle runtime ABI
# (runtime_native.c / file_ops.rs tagged_text_to_str) and is absent from that
# registry, so cranelift-direct lowering bridges its text args through
# rt_interp_cstr and the strict-handle runtime rejects the raw cstr, returning
# -1 without any syscall. See doc/08_tracking/bug/cranelift_extern_text_cstr_bridge_vs_handle_abi_2026-10-10.md
extern fn rt_file_remove(path: text) -> bool
extern fn rt_file_write_text(path: text, data: text) -> bool

fn planner_reason_allowed(target: text, reason: text) -> bool:
    (target == "//bootstrap:stage3" and (reason == "seed-missing" or
        reason == "seed-corrupt" or
        reason == "seed-target-unsupported" or
        reason == "seed-cannot-parse-required-language-feature" or
        reason == "seed-cannot-lower-required-compiler-feature" or
        reason == "bootstrap-runtime-abi-major-changed" or
        reason == "bootstrap-artifact-format-major-changed" or
        reason == "bootstrap-core-interface-major-changed" or
        reason == "verify-landed-compiler-fix")) or
        (target == "//bootstrap:stage4" and (reason == "self-host-convergence-check" or
        reason == "release-trust-verification" or
        reason == "diverse-double-compilation"))

fn planner_sha256_allowed(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        if not "0123456789abcdef".contains(value.substring(i, i + 1)):
            return false
        i = i + 1
    true

fn planner_arg_value(args: [text], prefix: text) -> text:
    var i = 0
    while i < args.len():
        if args[i].starts_with(prefix):
            return args[i].substring(prefix.len())
        i = i + 1
    ""

fn planner_file_write(path: text, content: text) -> bool:
    rt_file_remove(path)
    rt_file_write_text(path, content)

fn main() -> i64:
    val args = rt_get_args()
    val reason_name = planner_arg_value(args, "--bootstrap-reason=")
    val receipt_path = planner_arg_value(args, "--bootstrap-receipt=")
    val target = planner_arg_value(args, "--bootstrap-target=")
    val parent_sha = planner_arg_value(args, "--parent-compiler-sha256=")
    val runtime_sha = planner_arg_value(args, "--runtime-snapshot-sha256=")
    val closure_sha = planner_arg_value(args, "--planner-source-closure-sha256=")
    val planner_sha = planner_arg_value(args, "--planner-sha256=")
    if not planner_reason_allowed(target, reason_name):
        print("bootstrap-policy-error: typed-reason-required")
        return 2
    if receipt_path.trim().len() == 0:
        print("bootstrap-policy-error: receipt-path-required")
        return 2
    if not planner_sha256_allowed(parent_sha) or
            not planner_sha256_allowed(runtime_sha) or
            not planner_sha256_allowed(closure_sha) or
            not planner_sha256_allowed(planner_sha):
        print("bootstrap-policy-error: admission-hash-required")
        return 2
    val receipt = "simple-bootstrap-authorization-v2" +
        "|producer=simple-build-planner-v2" +
        "|target=" + target + "|reason=" + reason_name +
        "|parent_sha256=" + parent_sha +
        "|runtime_sha256=" + runtime_sha +
        "|source_closure_sha256=" + closure_sha +
        "|planner_sha256=" + planner_sha
    if not planner_file_write(receipt_path, receipt + "\n"):
        print("bootstrap-policy-error: receipt-write-failed: " + receipt_path)
        return 2
    print("bootstrap-plan: execution=not-attempted receipt=" + receipt_path +
        " reason=" + reason_name)
    0
