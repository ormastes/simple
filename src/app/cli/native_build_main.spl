# Absolute path of the current bootstrap-stage compiler.
fn self_exe() -> text:
    # argv[0] first: it names the running compiler on EVERY platform and needs
    # neither /proc (Linux-only) nor `ps -o comm=` (POSIX-only). Windows has
    # neither, so before this probe self_exe() returned "" there and
    # resolve_simple_binary() fell through to the literal "bin/simple" -- a
    # name that does not exist on Windows (the binary is bin/simple.exe),
    # producing "The filename, directory name, or volume label syntax is
    # incorrect." from CreateProcess and a native-build worker spawn failure.
    # Same shape as the existing probe in
    # src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl:119.
    val argv = get_args() ?? []
    if argv.len() > 0:
        val argv0 = argv[0]
        if argv0 != "" and (argv0.ends_with("/simple") or argv0.ends_with("simple.exe")) and file_exists(argv0):
            return argv0
    val pid = getpid()
    val (out, _err, code) = process_run_timeout("readlink", ["-f", "/proc/{pid}/exe"], 2000)
    if code == 0 and out != "":
        return out.trim()
    # Darwin has no /proc. `ps ... -o comm=` returns the executable path
    # without the argv tail, so bootstrap workers keep using the compiler that
    # invoked native-build instead of silently falling back to stale bin/simple.
    val (darwin_out, _darwin_err, darwin_code) = process_run_timeout("ps", ["-p", "{pid}", "-o", "comm="], 2000)
    if darwin_code == 0 and darwin_out != "":
        return darwin_out.trim()
    # Windows has neither /proc nor ps, and under the seed argv[0] is the
    # script path, not the exe. Without this probe the worker fell through to
    # bin/simple.exe -- a stale copy that lacked rt_env_vars and failed every
    # native-build with "unknown extern function: rt_env_vars".
    _cli_self_exe_via_pid_query()

# Absolutize a repo-relative path for the timeout wrapper.
fn abs_path(rel: text) -> text:
    val here = cwd()
    if here == "" or here == ".":
        return rel
    # cwd() can come back in MSYS form ("/c/Users/...") when launched from an
    # MSYS2/Git-bash shell (PWD-derived); normalize so CreateProcess can spawn
    # the result. Verified-rewrite only — a no-op on Unix (see
    # windows_native_path).
    windows_native_path("{here}/{rel}")

# A Windows drive-absolute path ("C:\..." or "C:/..."). Detected by the
# drive-colon at index 1 so this needs no backslash literal.
fn is_drive_absolute(p: text) -> bool:
    if p.len() < 3:
        return false
    p.substring(1).starts_with(":")

# MSYS2/Git-bash hand argv[0] in POSIX form ("/c/Users/.../simple.exe").
# CreateProcess cannot parse that — the spawn dies with "The filename,
# directory name, or volume label syntax is incorrect." — so rewrite
# "/<drive>/rest" to "<DRIVE>:/rest", but only when the rewritten path is
# VERIFIED to exist (never assume the mapping). On Unix a real path like
# "/c/foo" never has an existing "C:/foo" twin, so this is a no-op there;
# no env probe is involved.
fn windows_native_path(p: text) -> text:
    if p.len() >= 3 and p.starts_with("/") and p.substring(2).starts_with("/"):
        val drive = p.substring(1, 2)
        val lower = drive.lower()
        if lower >= "a" and lower <= "z":
            val candidate = drive.upper() + ":" + p.substring(2)
            if file_exists(candidate):
                return candidate
    p

fn abs_if_needed(p: text) -> text:
    # A leading "/" is the POSIX absolute form; a drive-colon is the Windows
    # one. Testing only for "/" made abs_path() prepend the cwd to an ALREADY
    # absolute Windows path, so an explicit SIMPLE_BINARY=C:/.../simple.exe was
    # rewritten to "/c/Users/.../simple/C:/Users/.../simple.exe" and the worker
    # spawn failed.
    if p.starts_with("/") or is_drive_absolute(p):
        return windows_native_path(p)
    abs_path(p)

# Opt-in parent-side receipt for distinguishing a worker that was never
# spawned from one that is still executing below process_run_timeout_live.
# Keep the gate independent of broader compiler/profile traces so normal
# native-build output remains unchanged.
fn native_build_worker_spawn_trace_enabled() -> bool:
    (env_get("SIMPLE_NATIVE_BUILD_WORKER_SPAWN_TRACE") ?? "") == "1"

# Resolve the compiler binary used to run the native-build worker. The old
# `SIMPLE_BINARY -> SIMPLE_BIN -> "bin/simple"` chain handed an empty/relative
# argv[0] to the worker during bootstrap:
#   - env_get returns nil (not "") for an unset var, so the `== ""` fallback
#     never fired -> empty binary -> `timeout: failed to run command 'run'`.
#   - the "bin/simple" fallback is relative, which the timeout wrapper cannot
#     exec -> worker spawn fails (reported as a spurious timeout).
# Guard nil, and return an ABSOLUTE path.
fn resolve_simple_binary() -> text:
    val from_binary = env_get("SIMPLE_BINARY")
    if from_binary != nil and from_binary != "" and file_exists(from_binary):
        return abs_if_needed(from_binary)
    val from_bin = env_get("SIMPLE_BIN")
    if from_bin != nil and from_bin != "" and file_exists(from_bin):
        return abs_if_needed(from_bin)
    # Prefer the binary that invoked us during bootstrap.
    val se = self_exe()
    if se != "" and file_exists(se):
        return abs_if_needed(se)
    # Windows deploys the compiler as bin/simple.exe; probe it before the
    # extensionless POSIX name so the fallback names a file that exists.
    if file_exists("bin/simple.exe"):
        return abs_path("bin/simple.exe")
    if file_exists("bin/simple"):
        return abs_path("bin/simple")
    if file_exists("src/compiler_rust/target/bootstrap/simple"):
        return abs_path("src/compiler_rust/target/bootstrap/simple")
    "bin/simple"

val OUTPUT_LIMIT = 12000
var native_build_stderr_spill_seq: i64 = 0

fn native_build_text_eq(a: text, b: text) -> bool:
    a.len() == b.len() and a.starts_with(b)

fn native_build_entry_args() -> [text]:
    val raw_args = get_args() ?? []
    var start_idx = 1
    var i = 0
    while i < raw_args.len():
        if raw_args[i].ends_with("native_build_main.spl") or native_build_text_eq(raw_args[i], "native-build"):
            start_idx = i + 1
            break
        i = i + 1
    var args: [text] = []
    i = start_idx
    while i < raw_args.len():
        args = args.push(raw_args[i])
        i = i + 1
    args

# The interpreted worker loads the compiler graph before codegen.
#
# Raised from 7200000 (2h) to 6h on 2026-09-04. 2h is not enough for a Stage-3
# self-host on aarch64: measured here, phase 3 alone takes ~57 min and the AOT
# phase after it ran >1h33m in a comparable build, so the worker was reaped
# mid-codegen with no artifact and no compile error — the failure surfaces as
# "worker timed out ... before producing a binary", which reads like a hang
# rather than a budget. The cost is dominated by step 5 being SERIAL regardless
# of --threads (a 20-core box runs it at cpu_pct=100); see
# doc/08_tracking/bug/native_build_step5_serial_threads_ignored_2026-09-04.md
# and doc/03_plan/compiler/native_codegen/step5_real_parallelism_plan_2026-09-04.md.
# Lower this again once step 5 is genuinely parallel.
val DEFAULT_TIMEOUT_MS = 21600000

fn print_help():
    print "Simple Native Build"
    print ""
    print "Usage: simple native-build [options] [source-dirs...]"
    print ""
    print "Options:"
    print "  --source <dir>       Source directory to compile (repeatable)"
    print "  -o <path>            Output binary path"
    print "  --entry <file>       Entry file"
    print "  --target <triple>    Target triple (for example x86_64-unknown-simpleos)"
    print "  --cpu <policy>       CPU policy: default, native, or x86-64-v1..v4"
    print "  --backend <name>     Codegen backend: llvm-lib, llvm, cranelift"
    print "  --mode <name>        Build mode: dynload (default) or one-binary"
    print "  --cache-dir <dir>    Native cache directory (default: SIMPLE_USER_STORAGE_ROOT/cache/compiler/native-build/v1)"
    print "  --refresh-source-authority  Admit current checkout sources in this coordinator"
    print "  --timeout <secs>     Worker timeout in seconds (default 21600; 0 disables)"
    print "  --emit-object        Emit relocatable object output"
    print "  --emit-entry-object  Emit one admitted entry object before linking"
    print "  --emit-archive       Emit a static archive instead of an executable"
    print "  --emit-shared        Emit a native shared library with no entry shim"
    print "  --no-mangle          Preserve declared function symbol names"
    print "  --release            Release build"
    print "  -h, --help           Show this help"

pub fn native_build_parse_secs(s: text) -> i64:
    # Safe numeric parse (avoids int() erroring on a non-numeric --timeout value).
    # Digit value = code point - 48, NOT `int(ch)`: on the seed interpreter
    # `int("3")` is the code point 51, so `--timeout 36000` parsed as 569328 s
    # (run6 stage-1, 2026-08-21) and `--timeout 1` as 49 s.
    var n = 0
    var ok = false
    for ch in s:
        if ch >= "0" and ch <= "9":
            n = n * 10 + (ch.char_code_at(0) - 48)
            ok = true
        else:
            return -1
    if ok: n else: -1

pub fn native_build_timeout_ms(args: [text]) -> i64:
    # Worker subprocess timeout. Honors --timeout <secs> (also forwarded to the
    # worker as its per-file budget); 0 disables the worker deadline and
    # preserves the compiler's zero-is-unlimited per-unit budget. Defaults
    # large because the old hardcoded
    # 120s killed any real multi-file freestanding build mid-compile.
    var i = 0
    while i < args.len():
        if native_build_text_eq(args[i], "--timeout") and i + 1 < args.len():
            val secs = native_build_parse_secs(args[i + 1])
            if secs >= 0:
                return secs * 1000
        elif args[i].starts_with("--timeout="):
            val secs = native_build_parse_secs(args[i].substring(10))
            if secs >= 0:
                return secs * 1000
        i = i + 1
    DEFAULT_TIMEOUT_MS

fn env_enabled(name: text) -> bool:
    val value = env_get(name)
    if value == nil:
        return false
    if value == "":
        return false
    if native_build_text_eq(value, "0"):
        return false
    if native_build_text_eq(value, "false"):
        return false
    true

fn native_build_has_timeout(args: [text]) -> bool:
    var i = 0
    while i < args.len():
        val arg = args[i]
        if native_build_text_eq(arg, "--timeout") or arg.starts_with("--timeout="):
            return true
        i = i + 1
    false

fn native_build_should_use_worker(args: [text]) -> bool:
    val mode = env_get("SIMPLE_EXECUTION_MODE") ?? ""
    if env_enabled("SIMPLE_NATIVE_BUILD_FORCE_WORKER"):
        return true
    if env_enabled("SIMPLE_BOOTSTRAP"):
        return true
    if native_build_text_eq(mode, "interpret"):
        return true
    if native_build_text_eq(mode, "interpreter"):
        return true
    native_build_has_timeout(args)

# Best-effort extraction of the `-o`/`--output` path from the raw native-build
# args, so the parent can verify the worker actually produced a binary instead
# of trusting a bare exit code of 0 (see
# doc/08_tracking/bug/native_build_worker_zombie_parent_hang_2026-07-03.md).
fn output_path_arg(args: [text]) -> text:
    var i = 0
    while i < args.len():
        val a = args[i]
        if (native_build_text_eq(a, "-o") or native_build_text_eq(a, "--output")) and i + 1 < args.len():
            return args[i + 1]
        elif a.starts_with("--output="):
            return a.substring(9)
        elif a.starts_with("-o") and a.len() > 2:
            return a.substring(2)
        i = i + 1
    ""

# An output path that merely exists is not proof that native-build produced an
# artifact. A failed worker can leave a pre-created empty file behind while
# still returning status 0. Keep the decision pure so the parent check and its
# regression spec exercise the same rule.
pub fn native_build_artifact_valid(
    present: bool, size: i64, worker_success: bool
) -> bool:
    # The worker receipt is emitted only after the staged artifact has passed
    # the driver's existence check and has been published. This accepts a
    # deterministic rebuild with unchanged bytes while rejecting a silent
    # zero-exit/no-work worker that leaves an old file in place.
    present and size > 0 and worker_success

pub fn native_build_worker_success_receipt(
    requested_output: text, stdout: text, stderr: text
) -> bool:
    if requested_output == "":
        return false
    val receipt = "[native-build] Artifact published: {requested_output}"
    val normalized_stdout = stdout.replace("\r\n", "\n")
    val normalized_stderr = stderr.replace("\r\n", "\n")
    # The worker frames publication receipts with newlines. A glued fragment
    # is ambiguous with another output path and cannot prove this artifact.
    normalized_stdout.split("\n").contains(receipt) or
        normalized_stderr.split("\n").contains(receipt)

# Do not enter the timeout runner with a guessed fallback path. On a stale
# self-hosted deployment that path can be missing or non-runnable; some seed
# runtimes collapse that spawn failure into a successful-looking parent return,
# which is the original silent-no-artifact failure mode.
pub fn native_build_worker_binary_valid(path: text, present: bool) -> bool:
    path != "" and present

fn native_build_output_exists(path: text, worker_success: bool) -> bool:
    if path == "" or not file_exists(path):
        return false
    native_build_artifact_valid(true, file_size_raw(path), worker_success)

pub fn native_build_strict_stub_evidence(output: text) -> bool:
    output.contains("stub functions for unresolved symbols") or
        output.contains("Unresolved symbol preview:") or
        output.contains("fabricated as weak stubs") or
        output.contains("fabricated stub") or
        output.contains("stub fallback")

pub fn native_build_strict_stub_violation(strict_no_stub: bool, stdout: text, stderr: text) -> bool:
    strict_no_stub and
        (native_build_strict_stub_evidence(stdout) or
            native_build_strict_stub_evidence(stderr))

# Keep the front-end cache beside the explicitly selected native-build cache.
# Parse shards inherit this environment, so an isolated bootstrap worktree can
# reuse its warmed parser entries across parent/child processes.
fn native_build_frontend_cache_dir_arg(args: [text]) -> text:
    var i = 0
    while i < args.len():
        val a = args[i]
        if a == "--cache-dir" and i + 1 < args.len():
            return "{args[i + 1]}/default/frontend"
        elif a.starts_with("--cache-dir=") and a.len() > 12:
            return "{a.substring(12)}/default/frontend"
        i = i + 1
    ""

fn native_build_normalize_exit_code(raw: i64) -> i64:
    """The worker's exit status, sign-restored.

    It is an i32 that arrives ZERO-EXTENDED across the wrapper boundary, so a
    genuine -1 presents as 4294967295 (0xFFFFFFFF). Every `code == -1` test
    downstream therefore never matched and BOTH abnormal-exit branches were dead
    code: an operator saw the bare number 4294967295 instead of this file's own
    accurate message.

    Widened 2026-09-05 from an equality test on 4294967295 alone: `rt_process_wait`
    now reports a signal death as `-(128+signo)`, and a SIGSEGV (-139) would
    otherwise have surfaced as the equally unreadable 4294967157.
    See doc/08_tracking/bug/stage3_worker_reaped_silently_in_hir_typecheck_2026-09-05.md"""
    if raw > 2147483647:
        return raw - 4294967296
    raw

fn native_build_line_is_diagnostic(line: text) -> bool:
    """True for lines a caller greps for when deciding why native-build failed.

    Deliberately broad: a missed diagnostic is silently dropped evidence, while
    an extra kept line only costs a few bytes in the preserved block.

    `timeout: the monitored command dumped core` earns its place here: it is the
    ONLY record that a worker died by SIGSEGV rather than being killed or
    exiting -1. On 2026-09-05 that line sat in the middle of a 9.9 MB Stage-3
    stderr, was dropped by the truncation below, and three investigations (OOM,
    rogue killer, double reap) chased causes measurement had already excluded.
    See doc/08_tracking/bug/stage3_worker_reaped_silently_in_hir_typecheck_2026-09-05.md"""
    native_build_range_is_diagnostic(line, 0, line.len())

fn native_build_range_contains(
    output: text, needle: text, line_start: i64, line_end: i64
) -> bool:
    val needle_len = needle.len()
    if needle_len == 0: return true
    var at = line_start
    val last_start = line_end - needle_len
    while at <= last_start:
        var offset = 0
        while (offset < needle_len and
            output.byte_at(at + offset) == needle.byte_at(offset)):
            offset = offset + 1
        if offset == needle_len: return true
        at = at + 1
    false

fn native_build_range_is_diagnostic(
    output: text, line_start: i64, line_end: i64
) -> bool:
    native_build_range_contains(output, "error:", line_start, line_end)
        or native_build_range_contains(output, "error :", line_start, line_end)
        or native_build_range_contains(output, "[ERROR]", line_start, line_end)
        or native_build_range_contains(output, "warning:", line_start, line_end)
        or native_build_range_contains(output, "[WARN]", line_start, line_end)
        or native_build_range_contains(output, "undefined field", line_start, line_end)
        or native_build_range_contains(output, "type 'nil'", line_start, line_end)
        or native_build_range_contains(output, "MIR error", line_start, line_end)
        or native_build_range_contains(output, "MIR lowering error", line_start, line_end)
        or native_build_range_contains(output, "panic", line_start, line_end)
        or native_build_range_contains(output, "unimplemented runtime entrypoint", line_start, line_end)
        or native_build_range_contains(output, "Traceback", line_start, line_end)
        or native_build_range_contains(output, "unresolved", line_start, line_end)
        or native_build_range_contains(output, "unsupported", line_start, line_end)
        or native_build_range_contains(output, "Assertion", line_start, line_end)
        or native_build_range_contains(output, "Segmentation fault", line_start, line_end)
        or native_build_range_contains(output, "dumped core", line_start, line_end)
        or native_build_range_contains(output, "core dumped", line_start, line_end)
        or native_build_range_contains(output, "[hir-fatal", line_start, line_end)
        or native_build_range_contains(output, "[post-hir-validation-fatal", line_start, line_end)
        or native_build_range_contains(output, "[bootstrap-phase3-error", line_start, line_end)
        or native_build_range_contains(output, "[mir-type-invariant]", line_start, line_end)
        or native_build_range_contains(output, "[mir-tag-probe]", line_start, line_end)

fn native_build_collect_diagnostics(output: text) -> [text]:
    """Every diagnostic line in the WHOLE stream, including the part head+tail drops."""
    var kept: [text] = []
    var line_start = 0
    while line_start <= output.len():
        val newline = output.index_of("\n", line_start)
        var line_end = output.len()
        if newline >= 0: line_end = newline
        if native_build_range_is_diagnostic(output, line_start, line_end):
            val line = output.substring(line_start, line_end)
            kept.push(line)
        if newline < 0: break
        line_start = newline + 1
    kept

fn eprint_bounded(output: text):
    if output.len() == 0:
        return
    if output.len() <= OUTPUT_LIMIT:
        stderr_write(output + "\n")
        return
    # OVER THE LIMIT. A plain head+tail print DISCARDS THE MIDDLE, so a
    # `grep -c` over this output can report 0 for a diagnostic that actually
    # fired -- that exact fail-open produced a bogus `0` for the lane that
    # filed native_build_nil_deref_total_outage_2026-08-08.md. So before
    # truncating we re-emit every diagnostic line found in the FULL text,
    # and we make the truncation itself impossible to overlook.
    val omitted = output.len() - OUTPUT_LIMIT
    stderr_write("!!!!!! NATIVE-BUILD STDERR TRUNCATED !!!!!!\n")
    # Truncation must never make evidence UNRECOVERABLE. Spill the FULL stream
    # to a file first and name the path, so a head+tail print is a convenience
    # view rather than the only surviving copy. Best-effort: a failed spill is
    # stated, never silent.
    # NOTE: the `env_get(...)` call is hoisted out of the interpolation on
    # purpose. A nested double-quoted string literal INSIDE an f-string
    # interpolation (`"{env_get("TMPDIR") ?? "/tmp"}/..."`) is mis-parsed: the
    # interpolation scanner ends the inner literal early, so `TMPDIR` is read as
    # a call target and the file fails to compile with
    # `error[E1002]: function \`TMPDIR\` not found`. Because this line sits on
    # native-build's stderr-truncation path, that parse error was emitted
    # INSTEAD of the real build diagnostic. See
    # doc/08_tracking/bug/fstring_nested_quoted_literal_in_interpolation_misparsed_2026-08-17.md
    # Windows has no TMPDIR and no writable "/tmp": the CRT-visible temp dir is
    # TEMP (or TMP). Falling through to "/tmp" there made file_write fail on
    # every truncated build, so the FULL stderr was lost and 1.3 MB of
    # diagnostics were dropped from the middle (measured 2026-08-31 on the
    # lint_entry native-build). A provenance-bound native cache is preferred
    # when available so cleanup of TMPDIR cannot erase the full stream; the
    # platform temp variables remain the portable fallback.
    val cache_dir_env = env_get("SIMPLE_NATIVE_BUILD_CACHE_DIR") ?? ""
    val tmpdir_env = env_get("TMPDIR") ?? ""
    val temp_env = env_get("TEMP") ?? ""
    val tmp_env = env_get("TMP") ?? ""
    var spill_root = "/tmp"
    if cache_dir_env != "":
        val durable_diagnostic_dir = "{cache_dir_env}/diagnostics"
        if dir_create_all(durable_diagnostic_dir):
            spill_root = durable_diagnostic_dir
        elif tmpdir_env != "":
            spill_root = tmpdir_env
        elif temp_env != "":
            spill_root = temp_env
        elif tmp_env != "":
            spill_root = tmp_env
    elif tmpdir_env != "":
        spill_root = tmpdir_env
    elif temp_env != "":
        spill_root = temp_env
    elif tmp_env != "":
        spill_root = tmp_env
    native_build_stderr_spill_seq = native_build_stderr_spill_seq + 1
    var spill_path = "{spill_root}/native-build-stderr-{getpid()}-{native_build_stderr_spill_seq}.log"
    while file_exists(spill_path):
        native_build_stderr_spill_seq = native_build_stderr_spill_seq + 1
        spill_path = "{spill_root}/native-build-stderr-{getpid()}-{native_build_stderr_spill_seq}.log"
    if file_write(spill_path, output):
        stderr_write("[native-build] FULL stderr ({output.len()} bytes) saved to: {spill_path}\n")
    else:
        stderr_write("[native-build] WARNING: could not save full stderr to {spill_path}; only the excerpt below survives.\n")
    stderr_write("[native-build] TRUNCATED: {omitted} of {output.len()} bytes of worker stderr were dropped from the MIDDLE.\n")
    stderr_write("[native-build] Raw head+tail below is INCOMPLETE -- counting over it is unreliable.\n")
    val diags = native_build_collect_diagnostics(output)
    if diags.len() > 0:
        stderr_write("[native-build] BEGIN PRESERVED DIAGNOSTICS ({diags.len()} line(s), from the full stream)\n")
        for line in diags:
            stderr_write(line + "\n")
        stderr_write("[native-build] END PRESERVED DIAGNOSTICS\n")
    else:
        stderr_write("[native-build] PRESERVED DIAGNOSTICS: none matched in the full stream.\n")
    val head_len = OUTPUT_LIMIT / 2
    val tail_len = OUTPUT_LIMIT - head_len
    stderr_write(output[0:head_len] + "\n")
    stderr_write("[stderr truncated by native-build entry: {omitted} bytes omitted from the middle]\n")
    stderr_write(output[output.len() - tail_len:output.len()] + "\n")
    stderr_write("!!!!!! END NATIVE-BUILD TRUNCATED STDERR !!!!!!\n")

fn native_build_output_has_nil_field_id(stdout: text, stderr: text) -> bool:
    stdout.contains("undefined field 'id'") or stderr.contains("undefined field 'id'")

fn native_build_print_failure_hints(stdout: text, stderr: text):
    if native_build_output_has_nil_field_id(stdout, stderr):
        stderr_write("hint: nil `.id` field access usually lost the MIR/HIR context above.\n")
        stderr_write("      Rerun with SIMPLE_BOOTSTRAP_DIAG=1 SIMPLE_COMPILER_TRACE=1 to print phase and function names.\n")

fn native_build_last_diagnostic_line(output: text) -> text:
    """The single most useful line to show FIRST, before any bulk relay.

    A real worker failure has been observed to SIGILL partway through the bulk
    stderr relay below (see the comment on the `stderr_ops` import above), which
    can lose the worker's own error text entirely if that text is only ever
    printed as part of the bulk dump. Extracting and printing the last matching
    diagnostic line immediately -- via the unambiguous `stderr_write`, not the
    bulk path -- means the essential fact survives even if the detailed dump
    that follows does not.
    """
    val diags = native_build_collect_diagnostics(output)
    if diags.len() > 0: return diags[diags.len() - 1]
    ""


# ===== Parse sharding =======================================================
#
# The parse phase is serial by construction and, before the front-end cache,
# was the bulk of a stage build's wall clock. With the cache in place the phase
# is trivially parallelisable ACROSS PROCESSES: each shard child parses its own
# slice of the module list into the shared cache directory and exits before
# HIR; the real build then runs with every entry already stored and parses
# nothing. No shared mutable parser state ever crosses a process boundary --
# which is exactly why this is process sharding and not threads, since the flat
# AST pools are module-level globals.
#
# Deterministic by construction: ownership is a pure function of the module
# path (driver_source_pipeline_parsing.spl), so the union of the shards is
# every module exactly once regardless of how many shards run or in what order
# they finish. The output binary is therefore byte-identical to an unsharded
# build -- what changed is only WHICH PROCESS did the parsing, and a cache hit
# reproduces the identical ParserModule.
#
# A shard that fails is NOT fatal. Its modules simply have no cache entry and
# the real build parses them itself, exactly as it would have without
# sharding. Sharding is a pure optimisation and must never be able to turn a
# working build into a broken one.
fn native_build_parse_shard_count(args: [text]) -> i64:
    # Shard children do not install collection feedback. Their unprofiled
    # parser cache is bypassed by the real profiled build, so warming it wastes
    # work and can publish misleading cache entries into the profile scope.
    for arg in args:
        if arg == "--collection-profile" or arg.starts_with("--collection-profile="):
            return 0
    if (env_get("SIMPLE_PARSE_SHARD") ?? "") != "":
        return 0      # already a shard child; never recurse
    if (env_get("SIMPLE_FRONTEND_CACHE") ?? "") == "0":
        return 0      # nothing to warm
    if (env_get("SIMPLE_PARSE_SHARDING") ?? "") == "0":
        return 0
    if native_build_streaming_surfaces():
        return 0      # streaming parse has no front-end parse cache to warm
    val requested = native_build_shard_threads(args, shard_worker_budget_kb("SIMPLE_PARSE_SHARD_WORKER_KB", SHARD_PARSE_WORKER_KB_V1))
    if requested <= 0:
        return 0
    # A parse shard is a process, not a lightweight task: the seed interpreter
    # eagerly loads its transitive front-end graph before the shard can claim
    # one source file.  Fan-out equal to --threads therefore turns an innocent
    # `--threads 8` into eight multi-GiB resident heaps.  Keep the default
    # within the one-process allocation budget for interpreter-mode bootstrap;
    # a measured host may raise it explicitly.  On the QEMU/container capture
    # hosts, two otherwise healthy parse children reached roughly 1.86 GiB
    # each and were OOM-killed together before completing their cache warm-up.
    # One child keeps the cache process-isolated while leaving enough headroom
    # for the supervising native-build process and the later renderer capture.
    val configured_cap = (env_get("SIMPLE_PARSE_SHARD_MAX") ?? "").to_i64() ?? 0
    val default_cap = if (env_get("SIMPLE_EXECUTION_MODE") ?? "") == "interpret": 1 else: requested
    val cap = if configured_cap > 0: configured_cap else: default_cap
    if requested > cap: cap else: requested

fn native_build_requested_shard_threads(args: [text]) -> i64:
    # Keep the Phase-2 shard request aligned with the existing AOT setting.
    # An explicit command-line worker count remains the narrower, per-build
    # override; without it SIMPLE_NATIVE_BUILD_THREADS must warm the same
    # process-isolated parser cache rather than only influencing later AOT.
    var threads: i64 = (env_get("SIMPLE_NATIVE_BUILD_THREADS") ?? "").to_i64() ?? 0
    var i = 0
    while i < args.len():
        val a = args[i]
        if (a == "--threads" or a == "--jobs" or a == "-j") and i + 1 < args.len():
            threads = args[i + 1].to_i64() ?? 0
        elif a.starts_with("--threads="):
            threads = a.substring(10).to_i64() ?? 0
        elif a.starts_with("--jobs="):
            threads = a.substring(7).to_i64() ?? 0
        i = i + 1
    threads

fn native_build_shard_threads(args: [text], budget_kb: i64) -> i64:
    val threads = native_build_requested_shard_threads(args)
    if threads <= 1:
        return 0
    val capped = shard_threads_mem_cap(threads, budget_kb)
    if capped <= 1:
        return 0
    capped

# Shared work queue for the shard children. Mirrors frontend_parse_cache_dir()
# so the claim markers live next to the entries they guard, one private dir
# per orchestrator pid, removed when the phase ends. With the queue published
# the children claim modules dynamically instead of taking a static hash slice
# (see driver_source_pipeline_parsing.spl, "Shared work queue"), which removes
# the tail where the slowest slice gated the phase. SIMPLE_PARSE_SHARD_QUEUE=0
# keeps the static split.
fn parse_shard_queue_dir() -> text:
    if (env_get("SIMPLE_PARSE_SHARD_QUEUE") ?? "") == "0":
        return ""
    var root = env_get("SIMPLE_FRONTEND_CACHE_DIR") ?? ""
    if root == "":
        val lane = env_get("SIMPLE_CACHE_SCOPE") ?? ""
        val lane_name = if lane == "": "default" else: lane
        val user_root = env_get("SIMPLE_USER_STORAGE_ROOT") ?? ""
        if user_root == "":
            return ""
        root = "{user_root}/cache/compiler/native-build/v1/{lane_name}/frontend"
    val dir = "{root}/queue-{getpid()}"
    if not dir_create_all(dir):
        return ""
    dir

fn spawn_parse_shards(base: [text], indices: [i64], count: i64, simple_bin: text, timeout_ms: i64,
        split_flag: text) -> [i64]:
    # Spawn one child per index, wait for all, and ALWAYS print each child's
    # exit status. run11 (2026-08-21): shard 6/8 was killed by the
    # kill_simple_monitor CPU guard and the only trace was "7/8 completed" --
    # the non-zero wait result was counted and dropped. Returns the failed
    # shard indices.
    var pids: [i64] = []
    for i in indices:
        var shard_args = base
        shard_args = shard_args.push("{split_flag}={i}/{count}")
        val pid = process_spawn_async(simple_bin, shard_args)
        pids = pids.push(pid)
    var failed: [i64] = []
    var k = 0
    while k < pids.len():
        val i = indices[k]
        val pid = pids[k]
        val code = if pid > 0: process_wait(pid, timeout_ms) else: -1
        if code != 0:
            eprint "[parse-shard] shard={i}/{count} pid={pid} FAILED {parse_shard_exit_label(code)}"
            failed = failed.push(i)
            # A timed-out (-2) child is STILL RUNNING and holds its multi-GiB
            # interpreter heap. If it stays alive it competes with the HIR
            # shards and the real worker for the runner's memory and can push
            # the worker into alloc-failure (beta.9 windows leg: leaked shard
            # + worker OOM, "memory allocation of 65520 bytes failed").
            # Best-effort kill; an already-exited child makes this a no-op.
            if pid > 0:
                val killed = process_kill(pid)
                eprint "[parse-shard] shard={i}/{count} pid={pid} dead-child cleanup: kill={killed}"
        else:
            print "[parse-shard] shard={i}/{count} pid={pid} exit=0"
        k = k + 1
    failed

fn run_parse_shards(args: [text], count: i64, simple_bin: text, timeout_ms: i64):
    # Parse warming only needs source discovery and the front-end parser.  Do
    # not route it through native_build_worker: importing that full CLI pulls
    # the complete compiler/JIT prelude into every shard before its first line
    # runs.  parse_shard_main owns the deliberately slim equivalent path.
    var base = ["run", "src/app/cli/parse_shard_main.spl"]
    for arg in args:
        base = base.push(arg)
    # The interpreted parser retains a large front-end graph.  Keep the
    # cache warmer below constrained container/QEMU host limits; the shard is
    # best-effort and its only output is content-addressed parser cache files.
    if (env_get("SIMPLE_EXECUTION_MODE") ?? "") == "interpret" and not base.contains("--low-memory"):
        base = base.push("--low-memory")
    # FileFiber children (default): same claim-queue split, each claimed file
    # runs as one fiber (pre-read content, one driver parse, TLDR publish,
    # same-child import parking). SIMPLE_FILE_FIBERS=0 keeps the plain shard.
    # The capsule route (bootstrap_main children) stays on --parse-shard.
    val split_flag = if (env_get("SIMPLE_FILE_FIBERS") ?? "") == "0": "--parse-shard" else: "--parse-fibers"
    run_parse_shards_with_base(base, count, simple_bin, timeout_ms, split_flag)

# Measured knee for the exact Stage3 capsule on the 80-thread windows-gnu host
# (bootstrap_main closure, 1441 files, claim queue): 1 worker 459 s, 8 -> 103 s,
# 16 -> 114 s, 40 -> 211 s. Each worker repeats the ~25 s source closure walk
# and contends on the shared cache directory, so wider fan-out is slower.
val CAPSULE_PARSE_SHARD_DEFAULT_MAX: i64 = 8

# Parse fan-out for the exact focused capsules: the coordinator's admission
# (opt-outs, collection profile, memory clamp) with the measured default cap.
# SIMPLE_PARSE_SHARD_MAX still overrides the cap.
fn native_build_focused_capsule_parse_shard_count(args: [text]) -> i64:
    val count = native_build_parse_shard_count(args)
    if (env_get("SIMPLE_PARSE_SHARD_MAX") ?? "") != "":
        return count
    if count > CAPSULE_PARSE_SHARD_DEFAULT_MAX: CAPSULE_PARSE_SHARD_DEFAULT_MAX else: count

# `base` is a complete argv for `simple_bin`; each child gets
# `--parse-shard=i/count` appended.
fn run_parse_shards_with_base(base: [text], count: i64, simple_bin: text, timeout_ms: i64,
        split_flag: text = "--parse-shard"):
    val queue_dir = parse_shard_queue_dir()
    val old_queue = env_get("SIMPLE_PARSE_SHARD_QUEUE") ?? ""
    if queue_dir != "":
        env_set("SIMPLE_PARSE_SHARD_QUEUE", queue_dir)
    var indices: [i64] = []
    var i: i64 = 0
    while i < count:
        indices = indices.push(i)
        i = i + 1
    var failed = spawn_parse_shards(base, indices, count, simple_bin, timeout_ms, split_flag)
    var done = count - failed.len()
    # Orphan reclaim: a dead shard's claims are released and the same indices
    # are run once more. Every other module is already claimed (and cached),
    # so the retry claims exactly the orphans. One round only -- a second
    # death degrades to the real build parsing the remainder, as before.
    if queue_dir != "" and failed.len() > 0:
        var dead_specs: [text] = []
        for d in failed:
            dead_specs = dead_specs.push("{d}/{count}")
        val released = parse_shard_release_claims(queue_dir, dead_specs)
        print "[parse-shard] reclaim: {failed.len()} dead shard(s), {released} orphaned claim(s) released, retrying"
        val failed_again = spawn_parse_shards(base, failed, count, simple_bin, timeout_ms, split_flag)
        done = count - failed_again.len()
    if queue_dir != "":
        env_set("SIMPLE_PARSE_SHARD_QUEUE", old_queue)
        val _removed = dir_remove_all(queue_dir)
    val mode = if queue_dir != "": "queue" else: "static"
    print "[parse-shard] {done}/{count} shard(s) completed split={mode}"

# ===== HIR sharding =========================================================
#
# Same process model one phase later. Each HIR shard child runs the real
# pipeline through parse (all cache hits after the parse shards) and the
# surface freeze, then lowers ONLY the modules it claims from a shared queue,
# stores each HirModule into the HIR cache (driver_hir_cache.spl) and exits
# before typecheck; the real build loads every module from the cache and
# lowers nothing. Claims are taken in dependency-level order of the import
# graph (see driver_hir_cache.spl for why no inter-level barrier is needed).
# A failed shard preserves completed cache entries but fails the build. Only
# unfinished modules are visited by replacement workers; linking needs PASS.
fn native_build_hir_shard_count(args: [text]) -> i64:
    if (env_get("SIMPLE_HIR_SHARD") ?? "") != "" or (env_get("SIMPLE_PARSE_SHARD") ?? "") != "":
        return 0      # already a shard child; never recurse
    if (env_get("SIMPLE_HIR_CACHE") ?? "") == "0":
        return 0      # nothing to fill
    if native_build_hir_shard_policy_v1(env_get("SIMPLE_PARSE_SHARDING") ?? "",
            env_get("SIMPLE_HIR_SHARDING") ?? "") == 0:
        return 0
    # Sample after parse/closure preparation, immediately before HIR admission.
    # The producer HWM scales the default estimate with this workload; explicit
    # per-phase estimates remain deliberate overrides. The RSS guard enforces
    # the actual tree cap: this estimate does not promise a future RSS bound.
    val measured_peak = process_peak_rss_kb()
    val parent_peak = if measured_peak > 0: measured_peak else: 0
    if parent_peak == 0:
        eprint "[hir-shard] parent peak unavailable; using unqualified phase estimate"
    val worker_budget = shard_worker_budget_kb("SIMPLE_HIR_SHARD_WORKER_KB", SHARD_HIR_WORKER_KB_V1, parent_peak)
    val requested = native_build_requested_shard_threads(args)
    # Serial isolation is admitted too: never revive a rejected child as N=1.
    val isolation_request = if requested > 0: requested else: 1
    shard_threads_mem_cap(isolation_request, worker_budget, parent_peak)

fn hir_shard_queue_dir(args: [text]) -> text:
    shard_ledger_queue_dir(args, "queue", "hir-shard")

# Invocation-private ledger directory under the HIR cache root. HIR uses
# "queue-<pid>-<n>", MIR uses "mir-queue-<pid>-<n>" next to it.
fn shard_ledger_queue_dir(args: [text], prefix: text, label: text) -> text:
    var root = env_get("SIMPLE_HIR_CACHE_DIR") ?? ""
    var cache_selection = "ambient SIMPLE_HIR_CACHE_DIR"
    if root == "":
        root = native_build_frontend_cache_dir_arg(args)
        cache_selection = "--cache-dir"
    if root == "":
        cache_selection = "storage fallback"
        val lane = env_get("SIMPLE_CACHE_SCOPE") ?? ""
        val lane_name = if lane == "": "default" else: lane
        val user_root = env_get("SIMPLE_USER_STORAGE_ROOT") ?? ""
        if user_root == "":
            root = "{machine_cache_root()}/hir-recovery"
        else:
            root = "{user_root}/cache/compiler/native-build/v1/{lane_name}/hir"
    # A prior invocation can retain its evidence even after PID reuse.
    var serial: i64 = 0
    var dir = "{root}/{prefix}-{getpid()}-{serial}"
    while dir_exists(dir):
        serial = serial + 1
        dir = "{root}/{prefix}-{getpid()}-{serial}"
    if not dir_create_all(dir):
        eprint "[{label}] ERROR: cannot create invocation ledger directory '{dir}' (selected by {cache_selection})"
        return ""
    dir

fn run_hir_shards(args: [text], count: i64, simple_bin: text, timeout_ms: i64) -> i64:
    var base = ["run", "src/app/cli/native_build_worker.spl"]
    for arg in args:
        base = base.push(arg)
    val queue_dir = hir_shard_queue_dir(args)
    if queue_dir == "":
        eprint "[hir-shard] BLOCKED: cannot establish invocation ledger"
        return 1
    run_ledger_shards("hir-shard", "--hir-shard", "SIMPLE_HIR_SHARD_QUEUE",
        "SIMPLE_HIR_SHARD_OWNER", base, queue_dir, args, count, count,
        simple_bin, timeout_ms).code

# Shared worker-pool driver for the HIR and MIR shard ledgers
# (driver_hir_recovery.spl). Spawns `count` owners at most `parallel` at a
# time (a free slot is refilled at once), reaps and seals each, replaces a
# crashed owner that made progress (unless fail-fast), closes the inventory,
# and returns the aggregate exit with the evidence behind it (LedgerShardRunV1).
# timeout_ms (0 = none) runs from each
# worker's own spawn; the old sequential waits let the k-th worker of a wave
# run up to k x timeout_ms. Reap (and log) order is exit order, not index.
const SHARD_POOL_POLL_MS: i64 = 200

# One pool run's verdict. total_claims sums every owner's claim count; -1 when
# any count was unreadable. all_stopped is false when a worker could not be
# reaped. blocked_reason is the ledger's BLOCKED record ("" when not blocked).
struct LedgerShardRunV1:
    code: i64
    failed_modules: i64
    total_claims: i64
    blocked_reason: text
    all_stopped: bool

fn run_ledger_shards(label: text, flag: text, queue_env: text, owner_env: text,
        base: [text], queue_dir: text, args: [text], count: i64, parallel: i64,
        simple_bin: text, timeout_ms: i64) -> LedgerShardRunV1:
    val old_queue = env_get(queue_env) ?? ""
    val old_owner = env_get(owner_env) ?? ""
    if not env_set(queue_env, queue_dir):
        return LedgerShardRunV1(code: 1, failed_modules: 0, total_claims: 0,
            blocked_reason: "worker queue environment could not be installed", all_stopped: true)
    val fail_fast = compile_fail_fast_requested(args, env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "", env_get("CI") ?? "")
    val window_size = if parallel > 0: parallel else: count
    var pending: [i64] = []
    var i: i64 = 0
    while i < count:
        pending = pending.push(i)
        i = i + 1
    var generation: i64 = 0
    var failed_workers: i64 = 0
    var done: i64 = 0
    var all_stopped = true
    var total_claims: i64 = 0
    while pending.len() > 0 and not hir_shard_recovery_blocked(queue_dir):
        var replacements: [i64] = []
        # Slot pool, not waves: a worker starts as soon as any of the
        # `window_size` slots frees, so one slow worker no longer idles the
        # rest of its wave (count > parallel is the per-worker memory knob).
        # Replacements still wait for the next generation, as before.
        var next_pending: i64 = 0
        var pids: [i64] = []
        var owners: [text] = []
        var indices: [i64] = []
        var started_ms: [i64] = []
        while next_pending < pending.len() or pids.len() > 0:
            while pids.len() < window_size and next_pending < pending.len() and
                    not hir_shard_recovery_blocked(queue_dir):
                val index = pending[next_pending]
                next_pending = next_pending + 1
                val owner = "{index}/{count}@{generation}"
                val owner_installed = env_set(owner_env, owner)
                var shard_args = base
                shard_args = shard_args.push("{flag}={index}/{count}")
                pids = pids.push(if owner_installed: process_spawn_async(simple_bin, shard_args) else: -1)
                owners = owners.push(owner)
                indices = indices.push(index)
                started_ms = started_ms.push(time_now_monotonic_ms())
            if pids.len() == 0:
                break
            # Reap the first live worker that exited, failed to wait, or ran
            # past timeout_ms (0 = no deadline); -2 from a short poll is
            # "still running", exactly what the blocking wait returned on
            # timeout, so the kill/seal handling below is unchanged.
            var reap_at: i64 = -1
            var code: i64 = -1
            i = 0
            while reap_at < 0 and i < pids.len():
                if pids[i] <= 0:
                    reap_at = i
                else:
                    val polled = native_build_normalize_exit_code(process_wait(pids[i], SHARD_POOL_POLL_MS))
                    if polled != -2 or (timeout_ms > 0 and time_now_monotonic_ms() - started_ms[i] >= timeout_ms):
                        reap_at = i
                        code = polled
                i = i + 1
            if reap_at < 0:
                continue
            val pid = pids[reap_at]
            val owner = owners[reap_at]
            val reaped_index = indices[reap_at]
            var kept_pids: [i64] = []
            var kept_owners: [text] = []
            var kept_indices: [i64] = []
            var kept_started: [i64] = []
            i = 0
            while i < pids.len():
                if i != reap_at:
                    kept_pids = kept_pids.push(pids[i])
                    kept_owners = kept_owners.push(owners[i])
                    kept_indices = kept_indices.push(indices[i])
                    kept_started = kept_started.push(started_ms[i])
                i = i + 1
            pids = kept_pids
            owners = kept_owners
            indices = kept_indices
            started_ms = kept_started
            # -1 is a wait error, not proof of exit. Even a false liveness
            # probe also means invalid handle; require a real reap result.
            var owner_stopped = pid <= 0 or (code != -2 and code != -1 and not process_is_running(pid))
            if not owner_stopped and pid > 0:
                val _killed = process_kill(pid)
                val reaped = native_build_normalize_exit_code(process_wait(pid, 5000))
                owner_stopped = reaped != -2 and reaped != -1 and not process_is_running(pid)
                if not owner_stopped:
                    all_stopped = false
                    val _blocked = hir_shard_recovery_block(queue_dir, "worker could not be reaped")
            # A MIR fork root claims under "+fork" child owners (native_mir_fork_v1).
            val progress = hir_shard_recovery_owner_tree_progress_v1(queue_dir, owner)
            total_claims = if progress < 0 or total_claims < 0: -1 else: total_claims + progress
            val finished = hir_shard_recovery_finished(queue_dir, owner)
            val state = if hir_shard_recovery_blocked(queue_dir): "BLOCKED" elif code < 0: "CRASH" elif finished: "FAILED" else: "BLOCKED"
            val sealed = if owner_stopped: hir_shard_recovery_seal(queue_dir, owner, state) else: -1
            if code != 0 or sealed != 0 or not finished:
                failed_workers = failed_workers + 1
                eprint "[{label}] owner={owner} status={state} exit={code} claimed={progress} sealed={sealed} finished={finished}"
                if sealed < 0 or progress < 0 or (not finished and progress == 0) or code == 0 or (code > 0 and sealed > 0):
                    val _blocked = hir_shard_recovery_block(queue_dir, "incomplete worker or ledger publication")
                elif not finished and not hir_shard_recovery_blocked(queue_dir) and hir_shard_recovery_can_replace(fail_fast, code, progress, hir_shard_recovery_unclaimed_count(queue_dir)):
                    replacements = replacements.push(reaped_index)
            else:
                done = done + 1
            if fail_fast and failed_workers > 0:
                var remaining = 0
                while remaining < pids.len():
                    if pids[remaining] > 0:
                        val _killed = process_kill(pids[remaining])
                        val reaped = native_build_normalize_exit_code(process_wait(pids[remaining], 5000))
                        if reaped != -2 and reaped != -1 and not process_is_running(pids[remaining]):
                            val _sealed = hir_shard_recovery_seal(queue_dir, owners[remaining], "BLOCKED")
                        else:
                            all_stopped = false
                            val _blocked = hir_shard_recovery_block(queue_dir, "cancelled worker could not be reaped")
                    remaining = remaining + 1
                break
        if fail_fast and failed_workers > 0:
            break
        pending = replacements
        generation = generation + 1
    env_set(queue_env, old_queue)
    env_set(owner_env, old_owner)
    val unfinished = if all_stopped: hir_shard_recovery_close_inventory(queue_dir, fail_fast) else: -1
    if unfinished != 0:
        failed_workers = failed_workers + 1
        eprint "[{label}] inventory incomplete rows={unfinished} policy_fail_fast={fail_fast}"
    val failed_modules = hir_shard_recovery_failure_count(queue_dir)
    print "[{label}] completed_workers={done} failed_workers={failed_workers} failed_modules={failed_modules} unfinished={unfinished} ledger={queue_dir}"
    val blocked = hir_shard_recovery_blocked(queue_dir)
    val blocked_reason = if blocked: file_read("{queue_dir}/BLOCKED") else: ""
    val code = if blocked: 1 else: hir_shard_aggregate_exit(failed_workers, failed_modules)
    LedgerShardRunV1(code: code, failed_modules: failed_modules,
        total_claims: total_claims, blocked_reason: blocked_reason,
        all_stopped: all_stopped)

# ===== MIR sharding =========================================================
#
# Same process model after HIR aggregate PASS (driver_build/native_mir_shard.spl).
# Opt-in with SIMPLE_MIR_SHARDING=1. Each worker lowers only the modules it
# claims (at most ceil(schedule / count)), emits their objects into the shared
# native object cache, records one terminal per module and exits, returning
# its memory to the OS. The final worker then links from the sealed ledger
# (SIMPLE_MIR_SHARD_LINK) and lowers nothing. Any non-PASS module blocks the
# link; keep-going reports every one.
#
# SIMPLE_MIR_SHARD_COUNT sets the number of shards (default: the concurrent
# worker count). Concurrency is the memory-clamped --threads value under the
# SIMPLE_MIR_SHARD_WORKER_KB per-worker budget; more shards than concurrent
# workers queue for a free slot, so each worker's MIR share shrinks with the count.
fn native_build_mir_shard_parallel(args: [text]) -> i64:
    if (env_get("SIMPLE_MIR_SHARD") ?? "") != "" or (env_get("SIMPLE_HIR_SHARD") ?? "") != "" or
            (env_get("SIMPLE_PARSE_SHARD") ?? "") != "":
        return 0      # already a shard child; never recurse
    val selective = (env_get("SIMPLE_MIR_SELECTIVE") ?? "") == "1"
    # Ad-hoc lanes (hand-driven native-build outside the managed bootstrap
    # stages) default to MIR sharding: each shard worker lowers its claimed
    # modules, emits their objects, records terminals and EXITS, returning
    # its memory to the OS — this both parallelizes per-module object
    # generation and breaks the single-worker RSS accumulation that pins the
    # self-hosted MIR phase against the allocation cap for hours
    # (doc/08_tracking/bug/self_hosted_mir_lowering_pathologically_slow_2026_10_22.md).
    # Managed bootstrap stages set SIMPLE_BOOTSTRAP=1 and drive the shard
    # schedule themselves; they keep the historical in-process behavior.
    # Explicit opt-out: SIMPLE_MIR_SHARDING=0. Explicit opt-in (=1) unchanged.
    val shard_flag = env_get("SIMPLE_MIR_SHARDING") ?? ""
    val adhoc_default = shard_flag == "" and
        (env_get("SIMPLE_BOOTSTRAP") ?? "") != "1" and not selective
    if shard_flag != "1" and not selective and not adhoc_default:
        return 0
    # Every worker would wipe the shared object scope under --clean.
    if (env_get("SIMPLE_NATIVE_BUILD_CLEAN") ?? "") == "1" or args.contains("--clean"):
        eprint "[mir-shard] disabled: --clean wipes the object scope the shards share"
        return if selective: -1 else: 0
    if selective:
        return native_build_mir_selective_parallel_v1(args)
    # Ordinary workers cannot evict MIR for Both/SMF output. Screen the known
    # output intent before budgeting or spawning a worker that must refuse it.
    if native_build_mir_output_requires_full_set_v1(args, selective,
            (env_get("SIMPLE_NATIVE_GROUP_MANIFEST") ?? "") != ""):
        eprint "[mir-shard] disabled: output format re-reads MIR set"
        return 0
    val requested = native_build_shard_threads(args, shard_worker_budget_kb("SIMPLE_MIR_SHARD_WORKER_KB", 16000000))
    if requested > 0: requested else: 1

fn native_build_mir_selective_parallel_v1(args: [text]) -> i64:
    val requested = native_mir_selective_requested_workers_v1(args,
        env_get("SIMPLE_NATIVE_BUILD_THREADS") ?? "")
    val host_request = shard_host_threads_cap(requested,
        env_get("SIMPLE_HOST_MAX_THREADS") ?? "")
    val parent = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_PARENT_KIB") ?? "")
    val worker = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_WORKER_KIB") ?? "")
    val exporter = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_EXPORTER_KIB") ?? "")
    val phase = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_PHASE_KIB") ?? "")
    val declared_tree = shard_mem_available_kb_from_field(env_get("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB") ?? "")
    val tree = shard_tree_budget_kb_for(declared_tree, shard_cgroup_memory_max_kb())
    val disk_budget = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_DISK_BYTES") ?? "")
    val disk_reserve = shard_mem_available_kb_from_field(env_get("SIMPLE_MIR_SELECTIVE_DISK_RESERVE_BYTES") ?? "")
    val root = machine_cache_root()
    if not dir_exists(root) and not dir_create_all(root):
        eprint "[mir-selective] cache disk probe directory unavailable"
        return -1
    val (disk_out, _disk_err, disk_code) = process_run_timeout("df", ["-Pk", root], 2000)
    val disk_available = if disk_code == 0: native_mir_selective_disk_bytes_v1(disk_out) else: 0
    val admission = native_mir_selective_admission_v1(host_request, phase, tree,
        shard_mem_available_kb(), parent, worker, exporter, disk_budget,
        disk_reserve, disk_available)
    if admission.workers <= 0:
        eprint "[mir-selective] admission refused: {admission.reason}"
        return -1
    print "[mir-selective] admitted_workers={admission.workers} requested={requested} phase_kib={phase} tree_kib={tree} parent_estimate_kib={parent} worker_estimate_kib={worker} exporter_estimate_kib={exporter} disk_budget_bytes={disk_budget} disk_reserve_bytes={disk_reserve}"
    admission.workers

fn native_build_mir_shard_count(parallel: i64) -> i64:
    val configured = (env_get("SIMPLE_MIR_SHARD_COUNT") ?? "").to_i64() ?? 0
    if configured > 0: configured else: parallel

# Returns (outcome, ledger): outcome is native_mir_shard_outcome_v1's
# "link" (ledger = the sealed directory), "fail" or "fallback" (ledger "").
fn run_mir_shards(args: [text], parallel: i64, simple_bin: text, timeout_ms: i64) -> (text, text):
    var base = ["run", "src/app/cli/native_build_worker.spl"]
    for arg in args:
        base = base.push(arg)
    val queue_dir = shard_ledger_queue_dir(args, "mir-queue", "mir-shard")
    if queue_dir == "":
        eprint "[mir-shard] cannot establish invocation ledger"
        # No worker ran: nothing claimed, nothing left running.
        return (native_mir_shard_outcome_v1(1, 0, 0, true), "")
    val selective = (env_get("SIMPLE_MIR_SELECTIVE") ?? "") == "1"
    val old_export_dir = env_get("SIMPLE_MIR_SHARD_EXPORT_DIR") ?? ""
    val export_dir = run_mir_shard_export_summaries(base, queue_dir, simple_bin, timeout_ms)
    var count = native_build_mir_shard_count(parallel)
    if selective:
        if export_dir == "": return ("fail", "")
        val jobs = native_mir_selective_job_count_v1(export_dir)
        if jobs.is_err():
            eprint "[mir-selective] physical emission schedule refused: {jobs.unwrap_err()}"
            return ("fail", "")
        # One process owns one physical emission and all of its logical
        # specialization bodies. No previous job's lazy canonical IDs or
        # promoted heap can affect the next emission's output or footprint.
        count = jobs.unwrap()
    # EXPERIMENTAL SIMPLE_MIR_FORK_WORKERS=N: spawn ONE root shard worker; it
    # forks N copy-on-write MIR children after mono
    # (compiler/80.driver/driver_build/native_mir_fork_v1.spl). K roots would
    # each fork N children and each hold a full post-mono heap.
    var run_parallel = parallel
    val fork_workers = native_mir_fork_workers_of_v1(env_get("SIMPLE_MIR_FORK_WORKERS") ?? "")
    if not selective and fork_workers > 0:
        count = 1
        run_parallel = 1
        print "[mir-shard] fork_workers={fork_workers} (experimental): one root worker"
    print "[mir-shard] shards={count} parallel={run_parallel} ledger={queue_dir}"
    if not env_set("SIMPLE_MIR_SHARD_EXPORT_DIR", export_dir):
        eprint "[mir-shard] export directory environment could not be installed"
        return ("fail", "")
    val run = run_ledger_shards("mir-shard", "--mir-shard", "SIMPLE_MIR_SHARD_QUEUE",
        "SIMPLE_MIR_SHARD_OWNER", base, queue_dir, args, count, run_parallel,
        simple_bin, timeout_ms)
    env_set("SIMPLE_MIR_SHARD_EXPORT_DIR", old_export_dir)
    val outcome = native_mir_shard_outcome_v1(run.code, run.failed_modules,
        run.total_claims, run.all_stopped)
    if outcome != "link":
        eprint "[mir-shard] outcome={outcome} exit={run.code} failed_modules={run.failed_modules} claims={run.total_claims} all_stopped={run.all_stopped} blocked={run.blocked_reason}"
        if selective: return ("fail", "")
    if outcome == "link": (outcome, queue_dir) else: (outcome, "")

# ===== Focused-capsule shard pre-pass (exact Stage3/Stage4) =================
#
# The exact focused capsules (bootstrap_focused_native_build.spl) drive the
# driver in process and never reach the coordinator above, so before this they
# ran HIR, MIR and codegen serially in one process. The driver side of every
# shard ledger is environment-driven and lane-agnostic (driver_hir_cache.spl
# hir_shard_owns, driver_aot_pipeline.spl aot_compile), so the capsule shards
# by re-executing ITSELF with the identical argv (`base`) plus the shard flag:
# every worker therefore runs the exact same capsule options (sources, strip,
# opt level, arena decls, entry-closure env) as the final in-process build.
#
#   1. HIR workers (--hir-shard=i/n): each lowers only the modules it claims,
#      reading every other module through its surface, into the HIR cache.
#   2. MIR workers (--mir-shard=i/n, allow_mir only): each lowers + emits the
#      objects of its claimed modules into the shared native object cache.
#
# Returns the sealed MIR ledger the caller installs as SIMPLE_MIR_SHARD_LINK
# (the in-process build then links from it and lowers nothing), "" for the
# ordinary in-process build, or "fail" for a MIR aggregate failure (some
# module did not PASS: the link is blocked, exactly as in run_mir_shards).
# Everything else -- disabled, no worker budget, HIR warm-up failure,
# ineligible lane (MIR fallback) -- degrades to the unsharded in-process build,
# so sharding can never turn a working capsule into a failing one by itself.
# Opt-outs: SIMPLE_HIR_SHARDING=0, SIMPLE_MIR_SHARDING=0.
# Publish ONE frontend/HIR cache scope before any shard is spawned so parse,
# HIR and MIR children and the parent pipeline inherit the same identity.
# Children are spawned before the parent's phase 2 publishes, so without this
# no process had a scope (hir-cache disabled reason=no-compiler-scope). See
# doc/08_tracking/bug/hir_cache_scope_never_published_shards_disabled_2026-10-25.md.
fn native_build_publish_cache_scope_v1(simple_bin: text):
    if (env_get("SIMPLE_FRONTEND_CACHE_SCOPE") ?? "") != "":
        return
    if (env_get("SIMPLE_FRONTEND_CACHE") ?? "") == "0" and (env_get("SIMPLE_HIR_CACHE") ?? "") == "0":
        return
    # The scope hashes SIMPLE_BINARY; pin it to the running compiler first.
    if (env_get("SIMPLE_BINARY") ?? "") == "":
        env_set("SIMPLE_BINARY", simple_bin)
    val scope = native_build_cache_scope_key(nil, nil, [], 0, native_build_frontend_identity())
    if scope == "":
        return
    env_set("SIMPLE_FRONTEND_CACHE_SCOPE", scope)
    print "[cache-scope] published source=orchestrator"

pub fn native_build_focused_capsule_shards_v1(base: [text], args: [text], allow_mir: bool) -> text:
    if (env_get("SIMPLE_MIR_SHARD") ?? "") != "" or (env_get("SIMPLE_HIR_SHARD") ?? "") != "" or
            (env_get("SIMPLE_PARSE_SHARD") ?? "") != "" or
            (env_get("SIMPLE_MIR_SHARD_LINK") ?? "") != "":
        return ""      # a shard child (or an externally driven link); never recurse
    if (env_get("SIMPLE_NATIVE_BUILD_CLEAN") ?? "") == "1" or args.contains("--clean"):
        return ""      # every worker would wipe the shared object scope
    # Workers must be the RUNNING compiler: the MIR link admits objects by the
    # source fingerprint only, so a different binary (e.g. a stale
    # SIMPLE_BINARY) must never produce them. No self path, no sharding.
    val simple_bin = self_exe()
    if simple_bin == "" or not file_exists(simple_bin):
        eprint "[capsule-shard] disabled: running compiler path unavailable"
        return ""
    native_build_publish_cache_scope_v1(simple_bin)
    val timeout_ms = native_build_timeout_ms(args)
    # Workers write no run evidence: the memory snapshot is O_EXCL (a worker
    # would take the parent's file); the phase profile and progress events belong to the
    # final build. Blank both for the spawn window only.
    val old_mem_snapshot = env_get("SIMPLE_MEM_SNAPSHOT_FILE") ?? ""
    val old_phase_file = env_get("SIMPLE_COMPILER_PHASE_PROFILE_FILE") ?? ""
    val old_progress_events = env_get("SIMPLE_BUILD_PROGRESS_EVENTS") ?? ""
    env_set("SIMPLE_MEM_SNAPSHOT_FILE", "")
    env_set("SIMPLE_COMPILER_PHASE_PROFILE_FILE", "")
    env_set("SIMPLE_BUILD_PROGRESS_EVENTS", "")
    # 0. Parse workers (--parse-shard=i/n): each parses only the modules it
    #    claims into the front-end parse cache and exits before surfaces
    #    (driver_source_pipeline_parsing.spl). Ownership is the path-hash /
    #    claim-queue split, so the cache content is independent of N.
    val parse_count = native_build_focused_capsule_parse_shard_count(args)
    if parse_count > 1:
        print "[capsule-shard] parse shards={parse_count}"
        run_parse_shards_with_base(base, parse_count, simple_bin, timeout_ms)
    # Opt-in per-file worker pool (SIMPLE_FILE_WORKERS=1): replaces the HIR
    # pass + MIR pass below with one claim-loop pool; "skip" = not admitted,
    # continue with the two-pass path.
    if allow_mir and native_file_workers_selected_v1(env_get(NATIVE_FILE_WORKERS_ENV_V1) ?? NATIVE_PER_FILE_PIPELINE_DEFAULT_V1) and
            (env_get("SIMPLE_MIR_SHARDING") ?? "") != "0" and (env_get("SIMPLE_MIR_SELECTIVE") ?? "") != "1":
        val file_result = run_file_worker_pool_v1(base, args, simple_bin, timeout_ms)
        if file_result != "skip":
            env_set("SIMPLE_MEM_SNAPSHOT_FILE", old_mem_snapshot)
            env_set("SIMPLE_COMPILER_PHASE_PROFILE_FILE", old_phase_file)
            env_set("SIMPLE_BUILD_PROGRESS_EVENTS", old_progress_events)
            return file_result
    var hir_ok = true
    val hir_count = if native_build_hir_shard_policy_v1(env_get("SIMPLE_PARSE_SHARDING") ?? "",
            env_get("SIMPLE_HIR_SHARDING") ?? "") == 1: native_build_hir_shard_count(args) else: 0
    if hir_count > 1:
        val hir_queue = shard_ledger_queue_dir(args, "queue", "hir-shard")
        if hir_queue == "":
            hir_ok = false
        else:
            print "[capsule-shard] hir shards={hir_count} ledger={hir_queue}"
            val hir_run = run_ledger_shards("hir-shard", "--hir-shard", "SIMPLE_HIR_SHARD_QUEUE",
                "SIMPLE_HIR_SHARD_OWNER", base, hir_queue, args, hir_count, hir_count,
                simple_bin, timeout_ms)
            hir_ok = hir_run.code == 0
            if not hir_ok:
                eprint "[capsule-shard] HIR warm-up failed (exit={hir_run.code} failed_modules={hir_run.failed_modules}); in-process build redoes HIR and reports it"
    var result = ""
    val mir_flag = env_get("SIMPLE_MIR_SHARDING") ?? ""
    if allow_mir and hir_ok and mir_flag != "0" and (env_get("SIMPLE_MIR_SELECTIVE") ?? "") != "1":
        val parallel = native_build_shard_threads(args, shard_worker_budget_kb("SIMPLE_MIR_SHARD_WORKER_KB", 16000000))
        if parallel > 1:
            val mir_queue = shard_ledger_queue_dir(args, "mir-queue", "mir-shard")
            if mir_queue != "":
                val count = native_build_mir_shard_count(parallel)
                print "[capsule-shard] mir shards={count} parallel={parallel} ledger={mir_queue}"
                val mir_run = run_ledger_shards("mir-shard", "--mir-shard", "SIMPLE_MIR_SHARD_QUEUE",
                    "SIMPLE_MIR_SHARD_OWNER", base, mir_queue, args, count, parallel,
                    simple_bin, timeout_ms)
                val outcome = native_mir_shard_outcome_v1(mir_run.code, mir_run.failed_modules,
                    mir_run.total_claims, mir_run.all_stopped)
                if outcome == "link":
                    result = mir_queue
                elif outcome == "fail":
                    eprint "[capsule-shard] MIR aggregate failure exit={mir_run.code} failed_modules={mir_run.failed_modules} blocked={mir_run.blocked_reason}; link blocked"
                    result = "fail"
                else:
                    eprint "[capsule-shard] MIR shards recorded no module verdict (lane ineligible or no HIR inventory); falling back to in-process MIR"
    env_set("SIMPLE_MEM_SNAPSHOT_FILE", old_mem_snapshot)
    env_set("SIMPLE_COMPILER_PHASE_PROFILE_FILE", old_phase_file)
    env_set("SIMPLE_BUILD_PROGRESS_EVENTS", old_progress_events)
    result

# ===== Per-file worker pool (P3, driver_build/native_file_worker_v1.spl) =====
#
# Coordinator side: one pool of `--file-worker=i/n` processes over a fresh HIR
# ledger and a fresh MIR ledger, admitted by the same memory caps as the two
# passes it replaces (HIR count, MIR per-worker budget; the smaller wins).
# Returns the MIR ledger to link from, "fail", "" (in-process fallback) or
# "skip" (pool not admitted; caller runs the two-pass path).
fn run_file_worker_pool_v1(base: [text], args: [text], simple_bin: text, timeout_ms: i64) -> text:
    val hir_count = native_build_hir_shard_count(args)
    val mir_parallel = native_build_shard_threads(args, shard_worker_budget_kb("SIMPLE_MIR_SHARD_WORKER_KB", 16000000))
    val parallel = if hir_count < mir_parallel: hir_count else: mir_parallel
    if parallel <= 1:
        eprint "[file-worker] not admitted hir_count={hir_count} mir_parallel={mir_parallel}; two-pass path"
        return "skip"
    val hir_queue = shard_ledger_queue_dir(args, "queue", "hir-shard")
    val mir_queue = shard_ledger_queue_dir(args, "mir-queue", "mir-shard")
    if hir_queue == "" or mir_queue == "":
        return "skip"
    val old_hir_queue = env_get(NATIVE_FILE_WORKER_HIR_QUEUE_ENV_V1) ?? ""
    if not env_set(NATIVE_FILE_WORKER_HIR_QUEUE_ENV_V1, hir_queue):
        return "skip"
    print "[file-worker] workers={parallel} hir_ledger={hir_queue} mir_ledger={mir_queue}"
    # P-E incremental: reuse cached objects for modules the planner keeps.
    val inc_output = output_path_arg(args)
    if (env_get("SIMPLE_BINARY") ?? "") == "":
        env_set("SIMPLE_BINARY", simple_bin)
    val inc_producer = file_worker_inc_producer_v1(
        native_build_cache_scope_key(nil, nil, [], 0, native_build_frontend_identity()), args)
    val inc_dir = if inc_output == "": "" else: file_worker_inc_dir_v1(machine_cache_root(), inc_producer, path_absolute(inc_output))
    val (reuse_path, reused) = file_worker_inc_prepare_v1(inc_dir, inc_producer)
    val old_reuse = env_get(FILE_WORKER_REUSE_ENV_V1) ?? ""
    env_set(FILE_WORKER_REUSE_ENV_V1, reuse_path)
    val run = run_ledger_shards("file-worker", "--file-worker", NATIVE_FILE_WORKER_QUEUE_ENV_V1,
        NATIVE_FILE_WORKER_OWNER_ENV_V1, base, mir_queue, args, parallel, parallel,
        simple_bin, timeout_ms)
    env_set(FILE_WORKER_REUSE_ENV_V1, old_reuse)
    env_set(NATIVE_FILE_WORKER_HIR_QUEUE_ENV_V1, old_hir_queue)
    if reuse_path != "":
        val _dropped = file_delete(reuse_path)
    var receipts = native_file_worker_receipts_in_v1(hir_queue)
    for r in native_file_worker_receipts_in_v1(mir_queue):
        receipts = receipts.push(r)
    print "[file-worker] receipts={receipts.len()} overlap_proven={file_worker_overlap_proven_v1(receipts)}"
    val outcome = native_mir_shard_outcome_v1(run.code, run.failed_modules, run.total_claims, run.all_stopped)
    if outcome == "link":
        if inc_dir != "":
            val fin = file_worker_inc_finish_v1(inc_dir, inc_producer, mir_queue, hir_queue, inc_output, reused)
            print file_worker_inc_receipt_line_v1(fin.reused, fin.rebuilt, fin.relink)
            env_set(FILE_WORKER_INC_DIR_ENV_V1, inc_dir)
            env_set(FILE_WORKER_INC_PRODUCER_ENV_V1, inc_producer)
            if not fin.relink:
                env_set(FILE_WORKER_LINK_PLACED_ENV_V1, "1")
        return mir_queue
    if outcome == "fail":
        eprint "[file-worker] aggregate failure exit={run.code} failed_modules={run.failed_modules} blocked={run.blocked_reason}; link blocked"
        return "fail"
    eprint "[file-worker] no MIR module verdict; falling back to in-process build"
    ""

# Worker side of `--file-worker=i/n` (bootstrap_main.spl dispatch). Claims
# one module (SIMPLE_FILE_WORKER_BATCH, default 1) per round through a HIR
# child, then lowers + emits objects through a MIR child once the HIR ledger is
# complete (global mono gate -- see native_file_worker_v1.spl). Exit 0 only
# when every child succeeded and the MIR ledger has no unclaimed row.
pub fn run_native_file_worker_v1(args: [text]) -> i64:
    val spec = native_file_worker_spec_from_args_v1(args)
    val owner = env_get(NATIVE_FILE_WORKER_OWNER_ENV_V1) ?? spec
    val mir_queue = env_get(NATIVE_FILE_WORKER_QUEUE_ENV_V1) ?? ""
    val hir_queue = env_get(NATIVE_FILE_WORKER_HIR_QUEUE_ENV_V1) ?? ""
    val simple_bin = self_exe()
    if not native_file_worker_spec_valid_v1(spec) or mir_queue == "" or hir_queue == "" or simple_bin == "":
        eprint "[file-worker] invalid role spec={spec} or ledger/self path missing"
        return 1
    val batch = native_file_worker_batch_from_env_v1()
    if mono_module_scoped_selected_v1(env_get(NATIVE_BOOTSTRAP_WHOLE_PROGRAM_ENV_V1) ?? "", true):
        return run_native_file_worker_scoped_v1(args, spec, owner, mir_queue, hir_queue, simple_bin, batch)
    var round: i64 = 0
    # Phase A: HIR, one claim batch per child, until the HIR ledger is drained.
    var hir_drained = false
    while not hir_drained:
        val child_owner = "{owner}~h{round}"
        round = round + 1
        env_set("SIMPLE_HIR_SHARD_QUEUE", hir_queue)
        env_set("SIMPLE_HIR_SHARD_OWNER", child_owner)
        env_set("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "{batch}")
        val hir_start = time_now_monotonic_ms()
        val pid = process_spawn_async(simple_bin, native_file_worker_child_args_v1(args, "--hir-shard={spec}"))
        val code = if pid > 0: native_build_normalize_exit_code(process_wait(pid, 0)) else: -1
        val hir_done = time_now_monotonic_ms()
        env_set("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "")
        env_set("SIMPLE_HIR_SHARD_QUEUE", "")
        env_set("SIMPLE_HIR_SHARD_OWNER", "")
        val _sealed = hir_shard_recovery_seal(hir_queue, child_owner, if code < 0: "CRASH" else: "FAILED")
        val claimed = native_file_worker_owner_claims_v1(hir_queue, child_owner)
        for path in claimed:
            val passed = native_file_worker_terminal_state_v1(hir_queue, path) == "PASS"
            val _published = native_file_worker_receipt_publish_v1(hir_queue, NativeFileWorkerReceiptV1(
                module: path, hir_start_ms: hir_start, hir_done_ms: hir_done, deps_ready_ms: -1, mir_done_ms: -1,
                obj_done_ms: -1, status: if passed: "MONO-PENDING" else: "FAILED", object: ""))
        if code != 0:
            eprint "[file-worker] owner={owner} HIR child exit={code} claimed={claimed.len()}"
            return 1
        hir_drained = claimed.len() == 0 and hir_shard_recovery_unclaimed_count(hir_queue) == 0
        if claimed.len() == 0 and not hir_drained:
            eprint "[file-worker] owner={owner} HIR child claimed nothing with rows unclaimed"
            return 1
    # Mono gate: global mono needs every module's HIR (P4 removes this wait).
    var state = native_file_worker_hir_ledger_state_v1(hir_queue)
    while state == 0:
        thread_sleep(SHARD_POOL_POLL_MS)
        state = native_file_worker_hir_ledger_state_v1(hir_queue)
    if state < 0:
        eprint "[file-worker] owner={owner} HIR ledger has a non-PASS module; MIR not admitted"
        return 1
    # Phase B: MIR + object, one claim batch per child.
    val mir_count = native_file_worker_mir_count_v1(native_file_worker_inventory_rows_v1(hir_queue), batch)
    var mir_round: i64 = 0
    var mir_drained = false
    while not mir_drained:
        val child_owner = "{owner}{HIR_SHARD_FORK_OWNER_MARK_V1}-m{mir_round}"
        mir_round = mir_round + 1
        env_set("SIMPLE_MIR_SHARD_QUEUE", mir_queue)
        env_set("SIMPLE_MIR_SHARD_OWNER", child_owner)
        val pid = process_spawn_async(simple_bin, native_file_worker_child_args_v1(args, "--mir-shard=0/{mir_count}"))
        val code = if pid > 0: native_build_normalize_exit_code(process_wait(pid, 0)) else: -1
        val obj_done = time_now_monotonic_ms()
        val _sealed = hir_shard_recovery_seal(mir_queue, child_owner, if code < 0: "CRASH" else: "FAILED")
        val claimed = native_file_worker_owner_claims_v1(mir_queue, child_owner)
        for name in claimed:
            val passed = native_file_worker_terminal_state_v1(mir_queue, name) == "PASS"
            val object_path = native_file_worker_object_path_v1(mir_queue, name)
            val _published = native_file_worker_receipt_publish_v1(mir_queue, NativeFileWorkerReceiptV1(
                module: name, hir_start_ms: -1, hir_done_ms: -1, deps_ready_ms: -1, mir_done_ms: -1, obj_done_ms: obj_done,
                status: if passed: "PASS" else: "FAILED", object: if passed: object_path else: ""))
        if code != 0:
            eprint "[file-worker] owner={owner} MIR child exit={code} claimed={claimed.len()}"
            return 1
        val unclaimed = hir_shard_recovery_unclaimed_count(mir_queue)
        mir_drained = claimed.len() == 0 or unclaimed == 0
        if claimed.len() == 0 and unclaimed != 0:
            eprint "[file-worker] owner={owner} MIR child claimed nothing with rows unclaimed={unclaimed}"
            return 1
    if not hir_shard_recovery_complete(mir_queue, owner):
        return 1
    print "[file-worker] done owner={owner} hir_rounds={round} mir_rounds={mir_round}"
    0

# Opt-in SIMPLE_MIR_SHARD_EXPORT_SUMMARIES=1: one process runs through mono and
# writes per-module declaration summaries
# (compiler/80.driver/driver_build/native_mir_shard_export_v1.spl). Returns the
# bundle directory for workers, or "" -- every failure is a worker-side
# fallback to the full HIR load, never a build failure.
fn run_mir_shard_export_summaries(base: [text], queue_dir: text, simple_bin: text,
        timeout_ms: i64) -> text:
    val selective = (env_get("SIMPLE_MIR_SELECTIVE") ?? "") == "1"
    if (env_get("SIMPLE_MIR_SHARD_EXPORT_SUMMARIES") ?? "") != "1" and not selective:
        return ""
    val export_dir = "{queue_dir}.export"
    # A bundle from an earlier invocation must never be admitted by this one.
    if file_exists("{export_dir}/manifest") and not file_delete("{export_dir}/manifest"):
        eprint "[mir-shard-export] stale manifest could not be removed; workers use full HIR"
        return ""
    val old_write = env_get("SIMPLE_MIR_SHARD_EXPORT_WRITE") ?? ""
    if not env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", export_dir):
        eprint "[mir-shard-export] producer environment could not be installed"
        return ""
    val pid = process_spawn_async(simple_bin, base)
    env_set("SIMPLE_MIR_SHARD_EXPORT_WRITE", old_write)
    val code = if pid > 0: native_build_normalize_exit_code(process_wait(pid, timeout_ms)) else: -1
    var stopped = pid <= 0 or (code != -1 and code != -2 and not process_is_running(pid))
    if pid > 0 and process_is_running(pid):
        val _killed = process_kill(pid)
        val reaped = native_build_normalize_exit_code(process_wait(pid, 5000))
        stopped = reaped != -1 and reaped != -2 and not process_is_running(pid)
    val manifest = if selective: "{export_dir}/selective.manifest" else: "{export_dir}/manifest"
    if code != 0 or not stopped or not file_exists(manifest):
        if selective:
            eprint "[mir-selective] export failed exit={code} stopped={stopped}; no MIR children admitted"
        else:
            eprint "[mir-shard-export] summary step exit={code}; workers use full HIR"
        return ""
    print "[mir-shard-export] bundle={export_dir}"
    export_dir

struct NativeBuildAuthorityRequestV1:
    args: [text]
    refresh: bool

pub fn native_build_authority_request_v1(args: [text], internal_worker: bool) -> Result<NativeBuildAuthorityRequestV1, text>:
    var forwarded: [text] = []
    var refresh = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        if arg == "--refresh-source-authority":
            if internal_worker: return Err("internal worker cannot refresh source authority")
            if refresh: return Err("duplicate source authority refresh request")
            refresh = true
        else:
            forwarded.push(arg)
            # Values belong to their preceding option, even when their bytes
            # happen to equal this coordinator option. Worker validation still
            # owns malformed/missing ordinary option values.
            if native_build_is_value_consuming_flag(arg) and index + 1 < args.len():
                index = index + 1
                forwarded.push(args[index])
        index = index + 1
    Ok(NativeBuildAuthorityRequestV1(args: forwarded, refresh: refresh))

# ICE boundary, parent side, OPT-IN (SIMPLE_ICE_CRASH_RETRIES; the default
# budget is 0 and this returns the first launch untouched). The worker appends
# a `start` breadcrumb before each module and a `done` after it, so a worker
# that crashed with a module still open died INSIDE that module: nothing
# in-process can catch that. With a budget, re-launch the worker with the module
# on SIMPLE_ICE_SKIP_MODULES so the remaining modules are still compiled and the
# run reaches its end. The caller fails the build whenever a re-launch happened,
# whatever the re-launched worker reports.
# Never re-launched: an external kill (SIGKILL/SIGTERM), a wait failure
# (status -1) or a timeout -- none of them says the module in flight is at
# fault (ice_crash_retry_allowed).
# Takes the result of the launch the caller already made and returns the result
# of the last launch.
pub fn native_build_relaunch_past_ice_crashes(worker_bin: text, relaunch_args: [text], timeout_ms: i64, retries_left: i64, stdout: text, stderr: text, code_raw: i32) -> (text, text, i32):
    val worker_status = native_build_normalize_exit_code(code_raw as i64)
    if not ice_crash_retry_allowed(worker_status, native_build_posix_signal(worker_status),
            stderr.contains("[TIMEOUT:"), retries_left):
        return (stdout, stderr, code_raw)
    # A runtime NAMED TRAP is a producer capability gap: every module that
    # reaches the trapped entrypoint dies the same way, so stepping past the
    # one in flight only burns the retry budget.
    if ice_runtime_trap_symbol(stderr) != "":
        return (stdout, stderr, code_raw)
    val dead = ice_boundary_dead_worker_modules()
    if dead.len() == 0:
        return (stdout, stderr, code_raw)
    eprint_bounded(stderr)
    for crumb in dead:
        stderr_write("error: ICE: native-build worker died (exit status {code_raw}) inside {crumb.phase} of module {crumb.module_name} ({crumb.source_path}); re-launching past it, {retries_left} retries left.\n")
    env_set("SIMPLE_ICE_SKIP_MODULES",
        ice_skip_list_extend(env_get("SIMPLE_ICE_SKIP_MODULES") ?? "", dead))
    ice_boundary_begin_run()
    val (next_stdout, next_stderr, next_code) = process_run_timeout_live(worker_bin, relaunch_args, timeout_ms)
    native_build_relaunch_past_ice_crashes(worker_bin, relaunch_args, timeout_ms,
        retries_left - 1, next_stdout, next_stderr, next_code)

pub fn run_native_build_worker(raw_args: [text]) -> i64:
    val request = match native_build_authority_request_v1(raw_args,
            (env_get("SIMPLE_NATIVE_BUILD_WORKER") ?? "") == "1"):
        case Ok(value): value
        case Err(reason):
            eprint "SCV-E-ADMISSION: " + reason
            return 1
    val args = request.args
    val fail_fast = compile_fail_fast_requested(args, env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "", env_get("CI") ?? "")
    env_set("SIMPLE_COMPILE_FAIL_FAST", if fail_fast: "1" else: "0")
    # This is the parent coordinator; native_build_worker.spl and shard
    # children never publish the derived index. One changed-path batch keeps
    # recovery links current without changing compilation cache identities.
    if (env_get("SIMPLE_NATIVE_BUILD_WORKER") ?? "") != "1":
        match refresh_workarounds(false, []):
            case Ok(index):
                if not index.complete:
                    stderr_write("workarounds: incomplete coverage; run simple check-dbs --fullscan bugs\n")
            case Err(reason):
                stderr_write("workarounds: refresh failed: " + reason + "\n")
    val compiled_bootstrap_route =
        (env_get("SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING") ?? "") == "1"
    val simple_bin = if compiled_bootstrap_route:
        match bootstrap_native_build_producer_binding(
            cli_kernel_executable_path(), env_get("SIMPLE_BINARY") ?? "", env_get("SIMPLE_BIN") ?? ""):
            case Ok(binary): binary
            case Err(reason):
                eprint "error: " + reason
                return 1
    else:
        resolve_simple_binary()
    if not native_build_worker_binary_valid(simple_bin, file_exists(simple_bin)):
        eprint "error: native-build worker binary is unavailable: {simple_bin}"
        return 1
    if compiled_bootstrap_route:
        env_set("SIMPLE_BINARY", simple_bin)
        env_set("SIMPLE_BIN", simple_bin)
    val policy = match environment_variant_policy_handoff_prepare_v1(args):
        case Ok(value): value
        case Err(failure):
            val reason = environment_variant_policy_handoff_owner_error_label_v1(failure)
            eprint "error: native-build could not collect a valid environment variant policy: {reason}"
            return 1
    val forwarded_args = match environment_variant_policy_handoff_attach_v1(
        args, policy.encoded_payload):
        case Ok(value): value
        case Err(failure):
            val reason = environment_variant_policy_handoff_owner_error_label_v1(failure)
            eprint "error: native-build could not create its internal policy handoff: {reason}"
            return 1
    # Publish complete immutable authority once, before any shard is spawned.
    # A generation alone leaves the child without a snapshot and makes every
    # child repeat cold inventory admission while the parent retains its work.
    # The explicit request is consumed in this compiler coordinator, never in
    # the test-runner parent or a shard. Ordinary inherited generations remain
    # immutable and are not silently refreshed.
    if request.refresh and not compiler_source_authority_clear_v1():
        eprint "SCV-E-ADMISSION: snapshot-authority-env-clear-failed"
        return 1
    if request.refresh or (env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? "") == "":
        val scv_root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
        val source_roots = native_build_authority_source_roots_v1(args, scv_root)
        if source_roots.len() == 0:
            eprint "SCV-E-ADMISSION: source-inventory-scope-unsupported"
            return 1
        val cold_init = (env_get("SIMPLE_SCV_INVENTORY_COLD_INIT") ?? "") == "1"
        val authority = compiler_source_authority_acquire_v1(scv_root,
            compile_source_inventory_checkout_cache_root_v1(scv_root), source_roots, cold_init)
        if not authority.valid:
            eprint "SCV-E-ADMISSION: " + authority.reason
            return 1
        if not compiler_source_authority_publish_v1(authority):
            eprint "SCV-E-ADMISSION: snapshot-authority-env-publish-failed"
            return 1
    var worker_args = ["run", "src/app/cli/native_build_worker.spl"]
    val mode = env_get("SIMPLE_EXECUTION_MODE")
    # A compiled bootstrap capsule can route the two internal `run` targets
    # itself. Do not label that native subprocess lane as interpreted: doing so
    # clamps parse warming to one child before the memory-aware clamp is even
    # consulted. Source-run wrappers retain the established interpreter marker.
    if (mode == nil or mode == "") and not compiled_bootstrap_route:
        env_set("SIMPLE_EXECUTION_MODE", "interpret")
    for arg in forwarded_args:
        # Preserve every public argument byte and its order. Only the worker
        # removes the one internal handoff argument before cli_native_build.
        worker_args = worker_args.push(arg)
    # A grouped request has one private result file owned by the compiler
    # child. It must never enter the ordinary warm-artifact or parse/HIR shard
    # paths: those paths assume one linked binary and can restore a stale one.
    val grouped_result = env_get("SIMPLE_NATIVE_GROUP_RESULT") ?? ""
    if grouped_result != "":
        if file_exists(grouped_result) and not file_delete(grouped_result):
            eprint "error: grouped native result path is not fresh"
            return 1
        val prior_worker = env_get("SIMPLE_NATIVE_BUILD_WORKER") ?? ""
        env_set("SIMPLE_BINARY", simple_bin)
        env_set("SIMPLE_NATIVE_BUILD_WORKER", "1")
        val (group_stdout, group_stderr, group_code) =
            process_run_timeout_live(simple_bin, worker_args,
                native_build_timeout_ms(args))
        env_set("SIMPLE_NATIVE_BUILD_WORKER", prior_worker)
        if group_code != 0:
            eprint "error: grouped native child exited {group_code}"
            eprint_bounded(group_stderr)
            if group_stdout.trim() != "": eprint_bounded(group_stdout)
            return 1
        if not file_exists(grouped_result):
            eprint "error: grouped native child returned without a fresh result"
            return 1
        return 0
    val requested_output = output_path_arg(args)
    # Propagate the resolved absolute/validated binary so the worker (and any
    # child it spawns) inherit a runnable SIMPLE_BINARY instead of re-deriving
    # an empty one.
    env_set("SIMPLE_BINARY", simple_bin)
    val frontend_cache_dir = native_build_frontend_cache_dir_arg(args)
    if frontend_cache_dir != "":
        env_set("SIMPLE_FRONTEND_CACHE_DIR", frontend_cache_dir)
    val old_worker_marker = env_get("SIMPLE_NATIVE_BUILD_WORKER") ?? ""
    env_set("SIMPLE_NATIVE_BUILD_WORKER", "1")
    # Warm artifact receipts do not bind --input-manifest or the provider
    # bytes it declares. Always run the worker for dependency link builds.
    val warm_receipt = if native_build_manifest_requested(args):
        NativeBuildWarmReceiptState(
            eligible: false, hit: false, key: "", receipt_path: "",
            candidate_path: "", artifact_path: "", artifact_digest: "",
            output_path: "", args: [], closure_count: 0)
    else:
        native_build_warm_receipt_prepare(
            args, simple_bin, policy.handoff.cache_identity)
    if warm_receipt.hit:
        if native_build_warm_artifact_restore(warm_receipt):
            print "[native-build-warm] exact final artifact restored; worker skipped"
            env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
            return 0
        print "[native-build-warm] final artifact restore refused; running normal worker"
    val old_warm_candidate = env_get(NATIVE_BUILD_WARM_CANDIDATE_ENV) ?? ""
    # Never leak a caller's stale candidate into warm-up children. The real
    # worker receives only this invocation's pid-private path below.
    env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, "")
    # process_run_timeout_live relays the worker's stdout/stderr to ours AS
    # THEY ARE PRODUCED (see process_ops.spl), so a slow-but-progressing
    # multi-minute worker no longer reads as a silent hang. stdout/stderr
    # below are still the full captured text, used only for the
    # output-path/failure-hint checks that follow -- no separate
    # print_bounded(stdout) recap here, since that would just reprint what
    # was already streamed live.
    # Warm the front-end cache in parallel BEFORE the real worker runs, so
    # its parse phase is all hits. SIMPLE_NATIVE_BUILD_WORKER is already 1
    # here, so the shard children pass the worker entrypoint guard.
    val shard_count = native_build_parse_shard_count(args)
    if not env_set("SIMPLE_PARSE_CLOSURE_REQUEST", "") or
            not env_set("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", ""):
        eprint "error: stale parse closure request could not be cleared"
        return 1
    # Compute the complete frozen selection once, even with no parse shards.
    # Parse shards partition parse work only; HIR/MIR shard workers and the
    # real worker admit the same request (native_build_closure_request_admit)
    # instead of each re-walking the entry closure. The bootstrap capsule's
    # stage3 process route reaches this point too, but passes its cache via
    # SIMPLE_FRONTEND_CACHE_DIR rather than --cache-dir.
    var closure_request_dir = frontend_cache_dir
    if closure_request_dir == "":
        closure_request_dir = env_get("SIMPLE_FRONTEND_CACHE_DIR") ?? ""
    if args.contains("--entry-closure") and closure_request_dir != "":
        # With parse shards a failed publication stays fatal (unchanged
        # contract). Without shards it only costs the workers their own walk,
        # exactly the pre-publication behaviour, so it degrades to that.
        var publish_error = ""
        val source_root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
        val roots = native_build_authority_source_roots_v1(args, source_root)
        if roots.len() == 0:
            publish_error = "parse-shard closure request has no authority roots"
        else:
            var selected_entry = ""
            var entry_arg_index = 0
            while entry_arg_index < args.len():
                val entry_arg = args[entry_arg_index]
                if entry_arg == "--entry" and entry_arg_index + 1 < args.len():
                    entry_arg_index = entry_arg_index + 1
                    selected_entry = args[entry_arg_index]
                elif entry_arg.starts_with("--entry="):
                    selected_entry = entry_arg.substring(8)
                elif native_build_is_value_consuming_flag(entry_arg):
                    entry_arg_index = entry_arg_index + 1
                elif not entry_arg.starts_with("-") and selected_entry == "":
                    selected_entry = entry_arg
                entry_arg_index = entry_arg_index + 1
            val absolute_entry = path_absolute(selected_entry).replace("\\", "/")
            if not absolute_entry.starts_with(source_root + "/"):
                publish_error = "parse-shard closure entry outside source authority"
            elif not native_build_publish_parse_closure_v1(source_root, roots,
                    absolute_entry.substring(source_root.len() + 1),
                    policy.handoff.policy_digest, simple_bin, closure_request_dir):
                publish_error = "parse-shard closure request publication failed"
        if publish_error != "":
            env_set("SIMPLE_PARSE_CLOSURE_REQUEST", "")
            env_set("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "")
            if shard_count > 0:
                eprint "error: " + publish_error
                return 1
            eprint "[parse-closure] WARNING: " + publish_error + "; workers walk their own closure"
    if shard_count > 0:
        run_parse_shards(forwarded_args, shard_count, simple_bin, native_build_timeout_ms(args))
    # The request stays published for the HIR/MIR shard workers and the real
    # worker; it is cleared once the real worker has returned.
    # Then fill the HIR cache the same way, so the real build's HIR phase is
    # all hits too. Runs AFTER the parse shards: each HIR child's own parse
    # phase is then pure cache hits.
    val hir_shard_count = native_build_hir_shard_count(args)
    if hir_shard_count > 0:
        # Explicit HIR-only warming may bypass the parse-publication phase,
        # but never its immutable source ownership requirement. Inherited
        # environment fields alone are not proof of an admitted generation.
        if native_build_hir_shard_policy_v1(env_get("SIMPLE_PARSE_SHARDING") ?? "",
                env_get("SIMPLE_HIR_SHARDING") ?? "") == 2:
            val source_root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
            val authority = compiler_source_authority_open_published_v1(source_root)
            if not authority.valid:
                env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
                env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
                eprint "SCV-E-HIR-ADMISSION: " + authority.reason
                return 1
        val hir_result = run_hir_shards(forwarded_args, hir_shard_count, simple_bin, native_build_timeout_ms(args))
        if hir_result != 0 and args.contains("--go-to-end"):
            # go-to-end (compiler/80.driver/driver_build/go_to_end.spl): the
            # shards only warm the HIR cache. The final worker redoes HIR for
            # the failed modules in process, drops them and their importers,
            # and continues; it never links and always exits non-zero then.
            eprint "[go-to-end] HIR shard aggregate failure; continuing to the final worker"
        elif hir_result != 0:
            env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
            env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
            eprint "error: HIR aggregate failure; final worker and artifact publication blocked"
            return hir_result
    # MIR + codegen in bounded worker processes (opt-in SIMPLE_MIR_SHARDING=1).
    # On aggregate PASS the final worker links from the ledger and lowers
    # nothing; any failed module blocks the final worker entirely.
    val old_mir_link = env_get("SIMPLE_MIR_SHARD_LINK") ?? ""
    val old_mir_export_dir = env_get("SIMPLE_MIR_SHARD_EXPORT_DIR") ?? ""
    val mir_shard_parallel = native_build_mir_shard_parallel(args)
    if mir_shard_parallel < 0:
        env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
        eprint "error: selective MIR admission refused; no serial fallback"
        return 1
    if mir_shard_parallel > 0:
        val (mir_outcome, mir_ledger) = run_mir_shards(forwarded_args, mir_shard_parallel, simple_bin, native_build_timeout_ms(args))
        if mir_outcome == "link":
            if not env_set("SIMPLE_MIR_SHARD_LINK", mir_ledger):
                env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
                env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
                eprint "error: MIR link ledger environment could not be installed"
                return 1
            if (env_get("SIMPLE_MIR_SELECTIVE") ?? "") == "1":
                if not env_set("SIMPLE_MIR_SHARD_EXPORT_DIR", mir_ledger + ".export"):
                    env_set("SIMPLE_MIR_SHARD_LINK", old_mir_link)
                    env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
                    env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
                    eprint "error: selective MIR link bundle environment could not be installed"
                    return 1
        elif mir_outcome == "fallback":
            # No module verdict: the workers never got a usable HIR
            # inventory/cache. The final worker lowers MIR in process.
            eprint "[mir-shard] WARNING: shard pass recorded no module verdict (every MIR worker stopped before claiming a module: HIR inventory/cache unavailable); falling back to in-process unsharded MIR"
        else:
            env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
            env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
            eprint "error: MIR shard aggregate failure; link and artifact publication blocked"
            return 1
    # Publish the candidate path only for the real worker. Parse-shard_main
    # computes its closure before setting SIMPLE_PARSE_SHARD, so inheriting this
    # env into warm-up children would let a partial child author the candidate.
    if warm_receipt.eligible:
        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, warm_receipt.candidate_path)
    val worker_spawn_trace = native_build_worker_spawn_trace_enabled()
    if worker_spawn_trace:
        eprint "[native-build-trace] worker_spawn:start timeout_ms={native_build_timeout_ms(args)} args={worker_args.len()}"
    # ICE boundary: this process owns a run directory keyed by its pid and the
    # output path and exports it to the worker (SIMPLE_ICE_DIR). False, with
    # nothing created, when the boundary is off.
    val old_ice_skip = env_get("SIMPLE_ICE_SKIP_MODULES") ?? ""
    val ice_owned = ice_boundary_claim_run(requested_output)
    val (first_stdout, first_stderr, first_code) = process_run_timeout_live(simple_bin, worker_args, native_build_timeout_ms(args))
    val (stdout, stderr, code_raw) = native_build_relaunch_past_ice_crashes(
        simple_bin, worker_args, native_build_timeout_ms(args),
        ice_crash_retry_budget(), first_stdout, first_stderr, first_code)
    val worker_code = native_build_normalize_exit_code(code_raw as i64)
    # A re-launch stepped over a module the worker died in. The re-launched
    # worker normally records it and fails, but a module that takes a codegen
    # path the boundary does not bracket would be compiled silently: a build
    # that needed a re-launch never passes, whatever the last worker reports.
    val ice_skip_now = env_get("SIMPLE_ICE_SKIP_MODULES") ?? ""
    val ice_relaunched = ice_skip_now != old_ice_skip
    val code = if ice_relaunched and worker_code == 0: 1 else: worker_code
    # A module still open in the breadcrumbs is where the worker died. Record
    # it while the run directory is still ours, then hand the directory back.
    var ice_dead_lines: [text] = []
    var ice_dead_summary = ""
    if code != 0:
        ice_dead_lines = ice_boundary_attribute_dead_worker_with_stderr(code as i64, stderr)
    # Merge every writer's rows into ice_receipt.tsv while the directory is ours.
    val ice_merged_summary = ice_boundary_merge_receipt(ice_owned)
    if ice_dead_lines.len() > 0:
        ice_dead_summary = ice_merged_summary
    if ice_relaunched:
        env_set("SIMPLE_ICE_SKIP_MODULES", old_ice_skip)
    ice_boundary_release_run(ice_owned)
    if worker_spawn_trace:
        eprint "[native-build-trace] worker_spawn:returned status={code} stdout_len={stdout.len()} stderr_len={stderr.len()}"
    env_set("SIMPLE_NATIVE_BUILD_WORKER", old_worker_marker)
    env_set("SIMPLE_PARSE_CLOSURE_REQUEST", "")
    env_set("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "")
    env_set("SIMPLE_MIR_SHARD_LINK", old_mir_link)
    env_set("SIMPLE_MIR_SHARD_EXPORT_DIR", old_mir_export_dir)
    val output_path = requested_output
    val output_ok = native_build_output_exists(
        output_path, native_build_worker_success_receipt(output_path, stdout, stderr))
    val strict_no_stub = (env_get("SIMPLE_NO_STUB_FALLBACK") ?? "") == "1"
    if native_build_strict_stub_violation(strict_no_stub, stdout, stderr):
        if output_ok:
            file_delete(output_path)
        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
        stderr_write("error: SIMPLE_NO_STUB_FALLBACK=1 rejected native-build output containing unresolved-symbol stub evidence.\n")
        stderr_write("  The worker reported success, but strict mode forbids publishing or caching a fabricated binary.\n")
        return 1
    val _warm_promoted = native_build_warm_receipt_finish(
        warm_receipt, stdout, code == 0, output_ok)
    env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_warm_candidate)
    if code == 0 and output_path != "" and not output_ok:
        # Parent-side belt-and-suspenders: never trust a bare exit code 0. If the
        # worker chain died in a way that still reports success (an early-exit
        # helper, a killed sibling, etc.) but left no output file, fail loudly
        # here immediately instead of letting the caller silently proceed with a
        # stale/missing binary.
        stderr_write("error: native-build worker exited 0 but produced no output binary: {output_path}\n")
        stderr_write("  Treating a successful-looking exit with a missing output file as a hard failure.\n")
        eprint_bounded(stderr)
        native_build_print_failure_hints(stdout, stderr)
        return 1
    if code != 0:
        # Front-load the single most important fact -- via the unambiguous
        # stderr_write, before the bulk relay below -- so it survives even if
        # the bulk dump does not reach the terminal (see the stderr_ops import
        # comment above and defect 3 of
        # doc/08_tracking/bug/native_build_worker_sigill_ud2_at_codegen_entry_2026-09-26.md).
        val last_diag = native_build_last_diagnostic_line(stderr)
        stderr_write("error: native-build worker exited with code {code}.\n")
        # ICE boundary: name the module the worker died in up front.
        for ice_line in ice_dead_lines:
            stderr_write("error: {ice_line}\n")
        if ice_dead_summary != "":
            stderr_write("error: {ice_dead_summary}\n")
        val trap_symbol = ice_runtime_trap_symbol(stderr)
        if trap_symbol != "":
            stderr_write("error: worker hit runtime NAMED TRAP `{trap_symbol}`; the producer binary does not implement it.\n")
            if trap_symbol.contains("cranelift"):
                stderr_write("  hint: this producer links the core-c-bootstrap Cranelift trap stubs (src/runtime/runtime_cranelift_bridge_stub.c); use --backend llvm, or a producer linked with the Rust Cranelift bridge (hosted / native_all lane).\n")
        if ice_relaunched:
            stderr_write("error: native-build was re-launched past module(s) the worker died in ({ice_skip_now}); the build fails regardless of the last worker's status.\n")
        if last_diag != "":
            stderr_write("  worker error: {last_diag}\n")
        eprint_bounded(stderr)
        # On Windows process_run_timeout_live degrades to a captured (non-live)
        # run, so on failure the worker's stdout — which carries the [build]
        # step log and the real error line — would otherwise be discarded.
        # Bounded, failure-path only.
        if stdout.trim() != "":
            stderr_write("--- worker stdout (bounded) ---\n")
            eprint_bounded(stdout)
        native_build_print_failure_hints(stdout, stderr)
        # Keep the real cause visible after stderr truncation.
        val windows_status = native_build_windows_status_label(code)
        if code == -1 and (stderr.contains("dumped core") or stderr.contains("core dumped")):
            # A crash, not a kill and not a wait failure. `timeout` reports
            # WCOREDUMP on the monitored command, and that single line is the
            # only evidence that survives to here -- the wrapper collapses the
            # child's signal status to -1 (rt_process_wait's Rust twin does
            # `status.code().unwrap_or(-1)`, discarding WTERMSIG), so the number
            # alone cannot tell a SIGSEGV from a failed wait. Say which.
            stderr_write("error: native-build worker CRASHED -- the child dumped core (see the 'dumped core' line above). NOT a timeout, NOT a kill, NOT a compile failure.\n")
            stderr_write("  For a backtrace, let the crash reporter keep cores for unpackaged binaries, then re-run:\n")
            stderr_write("    printf '[main]\\nunpackaged=true\\n' > ~/.config/apport/settings\n")
            stderr_write("    apport-unpack /var/crash/<report>.crash /tmp/u\n")
            # `bt` alone is not enough: measured 2026-09-05 on a real compiler
            # SIGSEGV, the PC lands in a non-executable mimalloc heap mapping
            # with no symbol and an unwindable-to-garbage stack. The registers
            # and the PC's mapping are what identify the fault.
            stderr_write("    gdb <worker-binary> /tmp/u/CoreDump -batch -ex bt -ex 'info registers pc lr x0 x8' -ex 'x/4xg $pc'\n")
            stderr_write("    # then locate the PC in /tmp/u/ProcMaps: a rw-p [anon:mimalloc] hit means a branch to data, not a code bug at that address\n")
        elif windows_status != "":
            stderr_write("error: native-build worker terminated with Windows native status {windows_status} before producing a binary.\n")
        elif native_build_posix_signal(code) > 0:
            val signo = native_build_posix_signal(code)
            stderr_write("error: native-build worker terminated with signal {signo} before producing a binary; NOT a compile failure.\n")
            if signo == 11 or signo == 6:
                stderr_write("  A SIGSEGV/SIGABRT is a crash in the compiler itself; take a backtrace from the core (see /var/crash).\n")
            elif signo == 9 or signo == 15:
                stderr_write("  hint: check for an out-of-memory reaper (earlyoom/systemd-oomd: 'journalctl -t earlyoom').\n")
        elif code == -1 and not stderr.contains("[TIMEOUT:"):
            # -1 without the wrapper's [TIMEOUT:] marker is NOT a timeout: the
            # wrapper died by a signal (status.code() is None) or the wait
            # itself failed. Say so instead of blaming --timeout (run6, 2026-08-21:
            # reported "timed out after 569328s" at 2742 s of wall).
            stderr_write("error: native-build worker wrapper exited abnormally (signal or wait failure, code -1) before producing a binary; its process group has been terminated.\n")
        elif code == -1:
            val secs = native_build_timeout_ms(args) / 1000
            stderr_write("error: native-build worker timed out after {secs}s before producing a binary.\n")
            stderr_write("  The interpreted worker loads the whole compiler + LLVM import graph before any\n")
            stderr_write("  codegen; a large --source set (e.g. src/os + src/lib) exceeds the budget.\n")
            stderr_write("  Read the last '[build] N/6' progress line to see which phase ran out of time.\n")
            stderr_write("  Steps 4 (mir, driver_pipeline_lowering.spl:262) and 5 (native_compile,\n")
            stderr_write("  driver_build/parallel.spl:480) are both SEQUENTIAL regardless of --threads.\n")
            stderr_write("  Options: shrink --source, keep build/native_cache warm, pass --low-memory,\n")
            stderr_write("  use --backend llvm-lib (in-process LLVM C API), or raise --timeout.\n")
        else:
            stderr_write("  interpreter: {simple_bin} (exit code {code})\n")
    code as i64

fn native_build_has_help(args: [text]) -> bool:
    for arg in args:
        if native_build_text_eq(arg, "-h") or native_build_text_eq(arg, "--help"):
            return true
    false

# Fail-open guard (see
# doc/08_tracking/bug/native_build_scoping_and_bootstrap_readthrough_2026-07-30.md):
# the worker's own entry-point check (compile_targets.spl `cli_native_build`,
# `if entry_point == "": ... return 1`) is logically immediate, but the
# source-run worker normally runs under a forced tree-walking interpreter
# (`run_native_build_worker` sets `SIMPLE_EXECUTION_MODE=interpret` when unset
# outside the compiled bootstrap route) and must first interpret its large `compiler.driver`-
# touching module graph before that check's first line ever executes. So an
# invocation that is DESTINED to fail this check still pays the full,
# multi-minute interpreter-bootstrap cost before the (correct) error ever
# reaches the user. (Previously this was also indistinguishable in practice
# from a silent hang, because the parent captured the worker's entire
# stdout/stderr and only printed it once the whole subprocess exited --
# `process_run_timeout_live` now relays output live as it's produced; see
# doc/08_tracking/bug/native_build_direct_seed_jit_hang_2026-07-30.md.)
# This is a cheap, purely-syntactic pre-check in the always-fast wrapper
# (this file's own header: "Lightweight entrypoint for `simple
# native-build`") that mirrors the worker's OWN entry-detection rule
# (`--entry`/`--entry=<path>`, or a bare non-flag positional --
# `cli_native_build_is_entry_arg` plus the `not a.starts_with("-") and
# entry_point == ""` fallback in compile_targets.spl).
#
# Correctly skips the VALUE of every value-consuming flag the worker's own
# parser recognizes (the same enumeration compile_targets.spl uses at its
# own `cli_native_build_option_error` validation site: --backend,
# --runtime-bundle, --runtime-path, --linker-script, --entry, --source, -o,
# --output, --mode, --build-mode, --cache-dir, --target, --cpu,
# --opt-level, plus --timeout/--threads/--jobs/-j/--log) -- an EARLIER,
# simpler version of this check treated any arg not starting with "-" as a
# possible positional entry without excluding flag values, which made it
# never actually fire for realistic invocations (every real native-build
# call passes at least one of --source/-o/--cache-dir/etc., whose
# non-flag-shaped VALUE tripped the same heuristic that was supposed to
# detect a missing entry). This version tracks consumed-value indices so it
# only treats a genuinely unconsumed, non-flag arg as a candidate
# positional entry. Deliberately still conservative on the OTHER side: an
# arg this function doesn't recognize as a known flag is treated as a
# possible positional entry (skips the fast-fail, exactly matching prior
# behavior) rather than being assumed to be an unknown flag -- so this can
# still only ever skip the fast-fail, never incorrectly trigger it, for an
# invocation shape not covered by the flag list above. Verified against
# every native-build call site in this repo
# (scripts/bootstrap/bootstrap-from-scratch.sh, 6/6 sites) -- all pass an
# entry, via `--entry <file>` or a bare positional -- so no legitimate
# caller depends on reaching the worker without one.

fn native_build_manifest_requested(args: [text]) -> bool:
    for arg in args:
        if arg == "--input-manifest" or arg.starts_with("--input-manifest="):
            return true
    false

fn native_build_has_entry(args: [text]) -> bool:
    var i = 0
    while i < args.len():
        val arg = args[i]
        if cli_native_build_is_entry_arg_stub(arg):
            return true
        if native_build_is_value_consuming_flag(arg):
            # Skip this flag's value -- it is never itself a positional entry.
            i = i + 2
            continue
        if not arg.starts_with("-"):
            return true
        i = i + 1
    false

pub fn native_build_authority_source_roots_v1(args: [text], root: text) -> [text]:
    # Extract only source selection; the worker remains the CLI validator.
    # Reuse its default root policy and this coordinator's value-flag table,
    # so an output path or backend value cannot become a positional entry.
    var entry = ""
    var sources: [text] = []
    var index = 0
    while index < args.len():
        val arg = args[index]
        if native_build_text_eq(arg, "--entry") or native_build_text_eq(arg, "--source"):
            if index + 1 >= args.len(): return []
            index = index + 1
            if native_build_text_eq(arg, "--entry"): entry = args[index]
            else: sources.push(args[index])
        elif arg.starts_with("--entry="):
            entry = arg.substring(8)
        elif arg.starts_with("--source="):
            sources.push(arg.substring(9))
        elif native_build_is_value_consuming_flag(arg):
            index = index + 1
        elif not arg.starts_with("-") and entry == "":
            entry = arg
        index = index + 1
    if entry == "" or root == "": return []
    val absolute = compile_source_inventory_plain_checkout_v1(path_absolute(entry))
    if not absolute.starts_with(root + "/"): return []
    val relative = absolute.substring(root.len() + 1)
    var roots = native_build_snapshot_source_roots_v1(relative, sources)
    if roots.len() == 0: return []
    if not roots.contains(relative): roots.push(relative)
    roots

# Local mirror of compile_targets.spl's `cli_native_build_is_entry_arg`
# (`arg == "--entry" or arg.starts_with("--entry=")`) -- not imported
# directly to avoid pulling this lightweight entrypoint into the same
# heavy `compiler.driver` import graph the worker pays to load.
fn cli_native_build_is_entry_arg_stub(arg: text) -> bool:
    arg == "--entry" or arg.starts_with("--entry=")

pub fn run_native_build_entry_v1(raw_args: [text]) -> i64:
    var args: [text] = []
    var group_manifest = ""
    var group_result = ""
    var group_source_root = ""
    var group_index = 0
    while group_index < raw_args.len():
        val arg = raw_args[group_index]
        if arg == "--group-manifest" or arg == "--group-result" or
                arg == "--source-root":
            if group_index + 1 >= raw_args.len():
                eprint "error: {arg} requires an absolute path"
                return 2
            val value = raw_args[group_index + 1]
            val drive_rooted = is_drive_absolute(value) and value.len() >= 3 and
                (value[2:3] == "/" or value[2:3] == "\\")
            if value == "" or not (value.starts_with("/") or drive_rooted) or
                    value.contains("\0") or value.contains("\n"):
                eprint "error: {arg} requires an absolute path"
                return 2
            if arg == "--group-manifest":
                if group_manifest != "": return 2
                group_manifest = value
            elif arg == "--group-result":
                if group_result != "": return 2
                group_result = value
            else:
                if group_source_root != "": return 2
                group_source_root = value
            group_index = group_index + 2
            continue
        args = args.push(arg)
        group_index = group_index + 1
    if group_manifest != "" or group_result != "" or group_source_root != "":
        if group_manifest == "" or group_result == "" or group_source_root == "":
            eprint "error: grouped native request requires manifest, result, and source root"
            return 2
        if not env_set("SIMPLE_NATIVE_GROUP_MANIFEST", group_manifest) or
                not env_set("SIMPLE_NATIVE_GROUP_RESULT", group_result) or
                not env_set("SIMPLE_NATIVE_GROUP_SOURCE_ROOT", group_source_root):
            eprint "error: grouped native request environment handoff failed"
            return 2
    if args.len() == 0:
        print_help()
        return 0
    if native_build_has_help(args):
        print_help()
        return 0
    if not native_build_has_entry(args):
        eprint "Error: No entry point specified for native-build backend"
        eprint "Usage: simple native-build --backend=llvm --entry <file.spl> -o <output> [--source <dir>]..."
        return 1

    run_native_build_worker(args)

fn main() -> i64:
    run_native_build_entry_v1(native_build_entry_args())

# P4/P-G3 worker loop (default in the per-file lane): no whole-ledger wait. After
# every HIR round the worker admits MIR for each module it HIR-claimed whose
# own HIR and whose direct imports' HIR are PASS (deps record written by the
# HIR child; native_file_worker_deps_ready_v1). The MIR child gets exactly
# those paths in SIMPLE_MIR_SHARD_ONLY_PATHS and runs module-scoped mono for
# them. A module without a deps record fails closed (P-G3): MIR never waits
# on the whole HIR ledger for mono.
fn run_native_file_worker_scoped_v1(args: [text], spec: text, owner: text, mir_queue: text,
        hir_queue: text, simple_bin: text, batch: i64) -> i64:
    var pending: [text] = []
    var pending_hir_start: [i64] = []
    var pending_hir_done: [i64] = []
    var round: i64 = 0
    var mir_round: i64 = 0
    var hir_drained = false
    while not hir_drained or pending.len() > 0:
        if not hir_drained:
            val child_owner = "{owner}~h{round}"
            round = round + 1
            env_set("SIMPLE_HIR_SHARD_QUEUE", hir_queue)
            env_set("SIMPLE_HIR_SHARD_OWNER", child_owner)
            env_set("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "{batch}")
            val hir_start = time_now_monotonic_ms()
            val pid = process_spawn_async(simple_bin, native_file_worker_child_args_v1(args, "--hir-shard={spec}"))
            val code = if pid > 0: native_build_normalize_exit_code(process_wait(pid, 0)) else: -1
            val hir_done = time_now_monotonic_ms()
            env_set("SIMPLE_HIR_SHARD_CLAIM_LIMIT", "")
            env_set("SIMPLE_HIR_SHARD_QUEUE", "")
            env_set("SIMPLE_HIR_SHARD_OWNER", "")
            val _sealed = hir_shard_recovery_seal(hir_queue, child_owner, if code < 0: "CRASH" else: "FAILED")
            val claimed = native_file_worker_owner_claims_v1(hir_queue, child_owner)
            for path in claimed:
                val passed = native_file_worker_terminal_state_v1(hir_queue, path) == "PASS"
                if passed:
                    pending = pending.push(path)
                    pending_hir_start = pending_hir_start.push(hir_start)
                    pending_hir_done = pending_hir_done.push(hir_done)
                    val _hir_receipt = native_file_worker_receipt_publish_v1(hir_queue, NativeFileWorkerReceiptV1(
                        module: path, hir_start_ms: hir_start, hir_done_ms: hir_done, deps_ready_ms: -1,
                        mir_done_ms: -1, obj_done_ms: -1, status: "PASS", object: ""))
                else:
                    val _published = native_file_worker_receipt_publish_v1(hir_queue, NativeFileWorkerReceiptV1(
                        module: path, hir_start_ms: hir_start, hir_done_ms: hir_done, deps_ready_ms: -1,
                        mir_done_ms: -1, obj_done_ms: -1, status: "FAILED", object: ""))
            if code != 0:
                eprint "[file-worker] owner={owner} HIR child exit={code} claimed={claimed.len()}"
                return 1
            hir_drained = claimed.len() == 0 and hir_shard_recovery_unclaimed_count(hir_queue) == 0
            if claimed.len() == 0 and not hir_drained:
                eprint "[file-worker] owner={owner} HIR child claimed nothing with rows unclaimed"
                return 1
        # Readiness: F and its direct imports PASS (or, without a deps
        # record, the whole ledger PASS).
        var ready: [text] = []
        var ready_hir_start: [i64] = []
        var ready_hir_done: [i64] = []
        var waiting: [text] = []
        var waiting_hir_start: [i64] = []
        var waiting_hir_done: [i64] = []
        var index = 0
        while index < pending.len():
            val path = pending[index]
            val deps = native_file_worker_deps_read_v1(hir_queue, path)
            var verdict: i64 = 0
            if deps.is_ok():
                var states: Dict<text, text> = {}
                states[path] = native_file_worker_terminal_state_v1(hir_queue, path)
                for dep in deps.unwrap():
                    states[dep] = native_file_worker_terminal_state_v1(hir_queue, dep)
                verdict = native_file_worker_deps_ready_v1(path, deps.unwrap(), states)
            else:
                eprint "[file-worker] owner={owner} module={path} has no deps record; MIR not admitted (no whole-ledger wait)"
                verdict = -1
            if verdict < 0:
                val _published = native_file_worker_receipt_publish_v1(hir_queue, NativeFileWorkerReceiptV1(
                    module: path, hir_start_ms: pending_hir_start[index], hir_done_ms: pending_hir_done[index],
                    deps_ready_ms: -1, mir_done_ms: -1, obj_done_ms: -1, status: "FAILED", object: ""))
                eprint "[file-worker] owner={owner} module={path} has a non-PASS import; MIR not admitted"
                return 1
            if verdict == 1:
                ready = ready.push(path)
                ready_hir_start = ready_hir_start.push(pending_hir_start[index])
                ready_hir_done = ready_hir_done.push(pending_hir_done[index])
            else:
                waiting = waiting.push(path)
                waiting_hir_start = waiting_hir_start.push(pending_hir_start[index])
                waiting_hir_done = waiting_hir_done.push(pending_hir_done[index])
            index = index + 1
        pending = waiting
        pending_hir_start = waiting_hir_start
        pending_hir_done = waiting_hir_done
        if ready.len() > 0:
            val deps_ready = time_now_monotonic_ms()
            val child_owner = "{owner}{HIR_SHARD_FORK_OWNER_MARK_V1}-m{mir_round}"
            mir_round = mir_round + 1
            env_set("SIMPLE_MIR_SHARD_QUEUE", mir_queue)
            env_set("SIMPLE_MIR_SHARD_OWNER", child_owner)
            env_set(NATIVE_FILE_WORKER_ONLY_PATHS_ENV_V1, ready.join("\n"))
            val pid = process_spawn_async(simple_bin, native_file_worker_child_args_v1(args, "--mir-shard=0/1"))
            val code = if pid > 0: native_build_normalize_exit_code(process_wait(pid, 0)) else: -1
            val obj_done = time_now_monotonic_ms()
            env_set(NATIVE_FILE_WORKER_ONLY_PATHS_ENV_V1, "")
            val _sealed = hir_shard_recovery_seal(mir_queue, child_owner, if code < 0: "CRASH" else: "FAILED")
            val mir_done = native_file_worker_mir_done_read_v1(mir_queue, child_owner)
            var mono_pending = false
            var r = 0
            while r < ready.len():
                if file_exists(native_file_worker_mono_pending_path_v1(mir_queue, ready[r])):
                    mono_pending = true
                    val _published = native_file_worker_receipt_publish_v1(hir_queue, NativeFileWorkerReceiptV1(
                        module: ready[r], hir_start_ms: ready_hir_start[r], hir_done_ms: ready_hir_done[r],
                        deps_ready_ms: deps_ready, mir_done_ms: -1, obj_done_ms: -1, status: "MONO-PENDING", object: ""))
                r = r + 1
            # HIR stamps travel on the MIR receipt only when the round admitted
            # one module (MIR claims are keyed by module name, not path).
            val one = ready.len() == 1
            val claimed = native_file_worker_owner_claims_v1(mir_queue, child_owner)
            for name in claimed:
                val passed = native_file_worker_terminal_state_v1(mir_queue, name) == "PASS"
                val object_path = native_file_worker_object_path_v1(mir_queue, name)
                val _published = native_file_worker_receipt_publish_v1(mir_queue, NativeFileWorkerReceiptV1(
                    module: name, hir_start_ms: if one: ready_hir_start[0] else: -1,
                    hir_done_ms: if one: ready_hir_done[0] else: -1, deps_ready_ms: deps_ready,
                    mir_done_ms: mir_done, obj_done_ms: obj_done,
                    status: if passed: "PASS" else: "FAILED", object: if passed: object_path else: ""))
            if code != 0 or mono_pending:
                eprint "[file-worker] owner={owner} MIR child exit={code} claimed={claimed.len()} mono_pending={mono_pending}"
                return 1
        elif hir_drained and pending.len() > 0:
            thread_sleep(SHARD_POOL_POLL_MS)
    if not hir_shard_recovery_complete(mir_queue, owner):
        return 1
    print "[file-worker] done owner={owner} hir_rounds={round} mir_rounds={mir_round} scoped_mono=true"
    0
