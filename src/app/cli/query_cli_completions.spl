# Standalone entry for `query cli-completions`. Kept out of query.spl because
# cli_helpers -> dispatch.table loads the whole CLI (~60 s under the seed),
# which every other heavy query would pay (lsp_heavy_query_child_exceeds_timeout_2026_11_07).
use std.io_runtime.{get_args}
use app.cli.cli_helpers.{cli_generated_completion_candidates_v1}

fn main() -> i64:
    val args = get_args()
    var rest: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "--":
            rest = args[(i + 1):]
        i = i + 1
    val prefix = if rest.len() > 0: rest[0] else: ""
    var extensions: [text] = []
    var k = 1
    while k < rest.len():
        extensions.push(rest[k])
        k = k + 1
    for candidate in cli_generated_completion_candidates_v1(prefix, extensions):
        print candidate
    0

main()
