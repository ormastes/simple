@unsafe(reason: "raw bootstrap argument-array ABI", capabilities: [ffi])
extern fn rt_get_args() -> [text]?

fn main() -> i64:
    val args = unsafe(capabilities: [ffi]): rt_get_args()
    if args == nil:
        print "argc=unavailable"
        return 1
    print "argc={args.unwrap().len()}"
    0
