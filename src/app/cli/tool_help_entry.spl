# Thin help entry for `simple lint|fmt|fix|test --help`.
#
# Both dispatchers (the Rust seed driver and src/app/cli/dispatch.spl) route a
# help request for those commands here instead of to the command's real entry,
# so printing four lines of usage does not resolve the command's implementation
# closure first. See src/app/cli/tool_help.spl for the measurements and why
# `use lazy` / a function-local `use` cannot do this job on the seed.
#
# Keep this file's imports at TWO leaves. `app.cli.entry_args` reads argv
# through the raw `sys_get_args()` ABI (the same vector std.cli.cli_util
# reaches through the CLI hub, verified byte-identical there) and adds no
# closure; `app.cli.tool_help` imports nothing at all.

use app.cli.entry_args.{get_cli_args}
use app.cli.tool_help.{print_tool_help}

fn main() -> i64:
    val all_args = get_cli_args()

    # `entry_args.get_cli_args()` already drops the launcher and a `.spl`
    # script path, so dispatch leaves the command token first ("lint",
    # "test", ...) exactly as check_entry.normalize_args observes it. Skip one
    # leading `.spl` path anyway, so a direct
    # `simple run src/app/cli/tool_help_entry.spl lint` behaves the same.
    var i = 0
    if all_args.len() > 0 and all_args[0].ends_with(".spl"):
        i = 1

    var command = ""
    if i < all_args.len():
        command = all_args[i]

    print_tool_help(command)
    0
