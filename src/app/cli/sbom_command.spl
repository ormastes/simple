# `simple sbom` CLI command — SPDX-2.3-minimal SBOM generation for the
# current package.
#
# Mission-critical robustness campaign, lane SBOM2 sbom-cli-wiring. Wires the
# sbom_model/sbom_generator library (src/lib/nogc_sync_mut/sbom/ — owned by
# lane SBOM, do NOT edit those files here) into a CLI subcommand:
#   1. enumerate this package's own .spl source files under a root dir
#   2. split out the CLAUDE.md "Owned-Code Scope" vendored/third-party paths
#      as DEPENDS_ON components instead of ordinary CONTAINS file entries
#   3. call the existing deterministic generator
#   4. write the resulting SPDX-2.3 JSON to --out= (default build/sbom.spdx.json)
#
# Usage: simple sbom [root_dir] [--out=path] [--name=pkg] [--version=v]

use std.io_runtime.{file_write, mkdir_p}
use app.io.source_discovery.{discover_spl_files}
use std.nogc_sync_mut.sbom.sbom_generator.{generate_sbom_json}

# CLAUDE.md § "Owned-Code Scope" — vendored/third-party paths excluded from
# ordinary code counts, reviews, and verification scans. Any discovered file
# under one of these becomes a DEPENDS_ON component rather than a tracked
# CONTAINS package entry.
val SBOM_VENDORED_PREFIXES: [text] = [
    "src/compiler_rust/vendor/",
    "src/runtime/vendor/",
    "src/runtime/miniaudio.h",
    "src/runtime/stb_image.h",
    "src/runtime/stb_truetype.h",
]

val SBOM_DEFAULT_OUT: text = "build/sbom.spdx.json"
val SBOM_DEFAULT_PACKAGE_NAME: text = "ormastes.simple"
val SBOM_DEFAULT_PACKAGE_VERSION: text = "0.1.0"

fn sbom_is_vendored(rel_path: text) -> bool:
    for prefix in SBOM_VENDORED_PREFIXES:
        if rel_path == prefix or rel_path.starts_with(prefix):
            return true
    false

fn sbom_flag_value(args: [text], prefix: text, default_value: text) -> text:
    for arg in args:
        if arg.starts_with(prefix):
            return arg.substring(prefix.len())
    default_value

fn sbom_positional(args: [text], default_value: text) -> text:
    for arg in args:
        if not arg.starts_with("--"):
            return arg
    default_value

fn sbom_parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        ""
    else:
        path.substring(0, idx)

# Enumerate this package's own source files under `root_dir`. Returns
# (tracked_files, vendored_files) — both sorted (discover_spl_files sorts),
# so downstream JSON generation is deterministic regardless of directory
# listing order.
fn sbom_collect_files(root_dir: text) -> ([text], [text]):
    val all_files = discover_spl_files(root_dir)
    var files: [text] = []
    var vendored: [text] = []
    for f in all_files:
        if sbom_is_vendored(f):
            vendored = vendored.push(f)
        else:
            files = files.push(f)
    (files, vendored)

fn run_sbom(args: [text]) -> i64:
    """Generate an SPDX-2.3-minimal SBOM for the current package and write
    it to --out= (default build/sbom.spdx.json).

    Usage: simple sbom [root_dir] [--out=path] [--name=pkg] [--version=v]"""
    val root_dir = sbom_positional(args, ".")
    val out_path = sbom_flag_value(args, "--out=", SBOM_DEFAULT_OUT)
    val package_name = sbom_flag_value(args, "--name=", SBOM_DEFAULT_PACKAGE_NAME)
    val package_version = sbom_flag_value(args, "--version=", SBOM_DEFAULT_PACKAGE_VERSION)
    val (files, vendored_files) = sbom_collect_files(root_dir)
    # discover_spl_files() already returns paths that resolve on their own
    # (absolute, or relative to the CWD the CLI runs from — it embeds
    # root_dir's own prefix into each entry). Pass "" as the generator's
    # root_dir so it does not re-join root_dir onto an already-resolvable
    # path (that would double the prefix and break sha256_hex_of_file).
    val json = generate_sbom_json(
        "", package_name, package_version,
        files, vendored_files, ["Tool: simple-sbom-0.1"], ""
    )
    val out_dir = sbom_parent_dir(out_path)
    if out_dir != "" and not mkdir_p(out_dir):
        print "sbom: failed to create output directory: {out_dir}"
        return 1
    if not file_write(out_path, json):
        print "sbom: failed to write {out_path}"
        return 1
    print "sbom: wrote {files.len()} file(s), {vendored_files.len()} vendored component(s) -> {out_path}"
    0

export run_sbom
