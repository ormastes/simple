# Canonical full bootstrap composition. The LLVM producer projects its own
# implementation at this exact logical module; bootstrap_main keeps its ABI.
use compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use plugins.backend_registry.full_static_backend_registry.{
    install_full_static_backends_for_k1_policy_v1}

pub fn bootstrap_install_worker_backends_v1() -> bool:
    if not install_selected_k1_backend_table_v1(): return false
    install_full_static_backends_for_k1_policy_v1(selected_k1_backend_policy_v1())

pub fn bootstrap_backend_request_error_v1(backend: text, plugin_path: text) -> text:
    # Full composition adds no restriction. Existing driver/plugin validation
    # remains authoritative; this does not claim any request has compiled.
    ""

pub fn bootstrap_backend_choices_v1() -> text: "llvm|cranelift"

pub fn bootstrap_backend_capability_label_v1() -> text: ""
