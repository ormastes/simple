# Shared line scan context for query lint and diagnostics passes.

use app.cli.query_helpers.{_count_indent}
use app.cli.query_source_mask.{first_code_pattern_column_at, first_code_pattern_columns}

struct LintScanLine:
    line: text
    trimmed: text
    line_num: i64
    indent: i64

fn lint_scan_line(lines: [text], idx: i64) -> LintScanLine:
    val line = lines[idx]
    LintScanLine(
        line: line,
        trimmed: line.trim(),
        line_num: idx + 1,
        indent: _count_indent(line))

fn deprecated_new_column(line: text) -> i64:
    """Return the one-based `.new(` column in code, or zero when absent."""
    deprecated_new_columns([line])[0]

fn deprecated_new_columns(lines: [text]) -> [i64]:
    """Return DEPR002 columns for one request, including multiline strings."""
    first_code_pattern_columns(lines, ".new(")

fn deprecated_new_column_at(lines: [text], target_line: i64) -> i64:
    """Return DEPR002's column for one zero-based requested source line."""
    first_code_pattern_column_at(lines, ".new(", target_line)
