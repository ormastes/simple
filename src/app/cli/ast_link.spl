# REQ-MC-008 ast-link command boundary. Caller owns output/exit presentation.
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkErrorV1, SemanticLinkFailureV1, semantic_link_error_v1}
use compiler.semantics.symbol_id.semantic_link_source.{open_semantic_link_document_v1, resolve_semantic_link_source_v1}
use compiler.semantics.symbol_id.semantic_link_location.{semantic_link_from_line_v1}

fn ast_link_line_number_v1(value: text) -> i64:
    if value == "" or value.len() > 9:
        return -1
    var result = 0
    for i in 0..value.len():
        val digit = value.slice(i, i + 1)
        if digit < "0" or digit > "9":
            return -1
        result = result * 10 + (digit.to_int() ?? 0)
    result

pub fn ast_link_command_v1(args: [text]) -> Result<text, SemanticLinkErrorV1>:
    """from-line FILE#Lx[-Ly] or resolve URI, with explicit configured authority.

    Both require --package P --module M --revision SHA256. Resolve additionally
    requires --file FILE. No guessed module identity, cwd walk, or latest revision.
    """
    if args.len() < 2 or (args[0] != "from-line" and args[0] != "resolve"):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected ast-link from-line FILE#Lx[-Ly] or resolve URI"))
    var options: Dict<text, text> = {}
    var position = 2
    while position < args.len():
        val key = args[position]
        if not ["--package", "--module", "--revision", "--file"].contains(key) or position + 1 >= args.len() or options.contains_key(key):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "unknown, duplicate, or missing option value"))
        options[key] = args[position + 1]
        position = position + 2
    for required in ["--package", "--module", "--revision"]:
        if not options.contains_key(required):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "package, module and exact revision are required"))
    var first = 0
    var last = 0
    var file = ""
    if args[0] == "from-line":
        val fragment = args[1].split("#L")
        if fragment.len() != 2 or fragment[0] == "" or options.contains_key("--file"):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidSpan, "expected exactly FILE#Lx[-Ly]"))
        file = fragment[0]
        val range = fragment[1].split("-L")
        if range.len() < 1 or range.len() > 2:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidSpan, "invalid source line range"))
        first = ast_link_line_number_v1(range[0])
        last = if range.len() == 2: ast_link_line_number_v1(range[1]) else: first
    else:
        if not options.contains_key("--file"):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "resolve requires configured --file"))
        file = options["--file"]
    val revision = options["--revision"]
    val document = open_semantic_link_document_v1(options["--package"], options["--module"], file, revision)?
    if args[0] == "from-line":
        return semantic_link_from_line_v1(document, revision, first, last, false)
    val declaration = resolve_semantic_link_source_v1(args[1], document, revision)?
    Ok(declaration.file + ":{declaration.line}:{declaration.column}")
