# Shared identity for the staged bootstrap compiler and focused compiler tools.

# Keep in sync with ./VERSION file.
pub fn bootstrap_version() -> text:
    "1.0.0-rc.1"

@allow(primitive_api)  # CLI boundary: boolean predicate for Rust bootstrap seed path detection
pub fn native_build_runtime_is_rust_seed(path: text) -> bool:
    """Return true when `path` resolves to a Rust bootstrap seed binary."""
    if path == "":
        return false
    val norm = path.replace("\\", "/")
    norm.contains("src/compiler_rust/") or norm.contains("/target/bootstrap/simple") or norm.starts_with("target/bootstrap/simple")

@allow(primitive_api)  # CLI boundary: candidate availability flags matching bootstrap probe call sites
pub fn native_build_select_worker_runtime(
    explicit_binary: text,
    explicit_binary_ok: bool,
    explicit_bin: text,
    explicit_bin_ok: bool,
    invoking_exe: text,
    invoking_ok: bool,
) -> text:
    """Select the highest-priority valid pure-Simple runtime candidate, or empty string."""
    if explicit_binary_ok and explicit_binary != "" and not native_build_runtime_is_rust_seed(explicit_binary):
        return explicit_binary
    if explicit_bin_ok and explicit_bin != "" and not native_build_runtime_is_rust_seed(explicit_bin):
        return explicit_bin
    if invoking_ok and invoking_exe != "" and not native_build_runtime_is_rust_seed(invoking_exe):
        return invoking_exe
    ""

@allow(primitive_api)  # CLI boundary: returns POSIX process preflight exit code (0/1)
pub fn native_build_worker_preflight_code(selected_runtime: text) -> i64:
    """Return 0 when a valid non-seed worker runtime was selected, otherwise 1."""
    if selected_runtime == "" or native_build_runtime_is_rust_seed(selected_runtime):
        return 1
    0
