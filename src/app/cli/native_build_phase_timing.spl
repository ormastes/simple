# Opt-in parent phase timings. This module owns no mutable process state.
# Reuse SIMPLE_NATIVE_BUILD_WORKER_SPAWN_TRACE at the coordinator call site;
# disabled begin/finish calls do not sample a clock or construct receipt text.

use std.nogc_sync_mut.io.time_ops.{time_sample_monotonic_nanos_or_failure}
use std.nogc_sync_mut.io.stderr_ops.{stderr_write}

pub fn native_build_phase_elapsed_ns_v1(start_ns: i64, end_ns: i64) -> i64:
    # Do not turn provider failure or a backwards sample into a fast PASS.
    if start_ns < 0 or end_ns < start_ns:
        return -1
    end_ns - start_ns

pub fn native_build_phase_begin_v1(enabled: bool, phase: text) -> i64:
    if not enabled:
        return -1
    stderr_write("[native-build-phase] phase={phase} event=start\n")
    time_sample_monotonic_nanos_or_failure()

pub fn native_build_phase_finish_v1(enabled: bool, phase: text, start_ns: i64):
    if not enabled:
        return
    val end_ns = time_sample_monotonic_nanos_or_failure()
    val elapsed_ns = native_build_phase_elapsed_ns_v1(start_ns, end_ns)
    if elapsed_ns < 0:
        stderr_write("[native-build-phase] phase={phase} event=finish elapsed_ns=unavailable\n")
    else:
        stderr_write("[native-build-phase] phase={phase} event=finish elapsed_ns={elapsed_ns}\n")
