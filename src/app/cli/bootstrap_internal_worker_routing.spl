# Fixed internal worker routes; this owner carries no compiler/backend imports.
pub fn bootstrap_internal_worker_entry_v1(path: text) -> bool:
    path.ends_with("src/app/cli/parse_shard_main.spl") or
        path.ends_with("src/app/cli/native_build_worker.spl")

pub fn bootstrap_internal_worker_run_v1(args: [text], worker_marker: text) -> bool:
    worker_marker == "1" and args.len() >= 3 and args[1] == "run" and
        bootstrap_internal_worker_entry_v1(args[2])

pub fn bootstrap_internal_worker_is_parse_v1(args: [text], worker_marker: text) -> bool:
    bootstrap_internal_worker_run_v1(args, worker_marker) and
        args[2].ends_with("src/app/cli/parse_shard_main.spl")

pub fn bootstrap_internal_worker_args_v1(args: [text], worker_marker: text) -> [text]:
    """Return the admitted fixed worker's payload without CLI flag filtering.

    The caller must test admission separately: a valid request can have an
    empty payload, which the worker's policy handoff validator then rejects.
    Unmarked and unknown entrypoints never yield a worker payload.
    """
    if not bootstrap_internal_worker_run_v1(args, worker_marker):
        return []
    var payload: [text] = []
    var index = 3
    while index < args.len():
        payload = payload.push(args[index])
        index = index + 1
    payload
