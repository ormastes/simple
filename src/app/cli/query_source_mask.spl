# Shared source-line masking for lightweight query and lint scanners.

fn strip_strings_and_comments(line: text) -> text:
    """Mask string bytes one-for-one and discard inline comment payload."""
    var parts: [text] = []
    var segment_start = 0
    var i = 0
    val n = line.len()

    while i < n:
        val byte = line.byte_at(i)
        if byte == 35:
            if parts.len() == 0:
                if i == 0:
                    return ""
                return line.substring(0, i)
            if i > segment_start:
                parts.push(line.substring(segment_start, i))
            return parts.join("")
        if byte == 34:
            if i > segment_start:
                parts.push(line.substring(segment_start, i))
            val string_start = i
            i = i + 1
            while i < n:
                val string_byte = line.byte_at(i)
                if string_byte == 92:
                    i = i + 2
                    continue
                i = i + 1
                if string_byte == 34:
                    break
            parts.push(" ".repeat(i - string_start))
            segment_start = i
            continue
        i = i + 1

    if parts.len() == 0:
        return line
    if segment_start < n:
        parts.push(line.substring(segment_start, n))
    parts.join("")

fn _source_bytes_match_at(line: text, pattern: text, offset: i64) -> bool:
    if offset < 0 or offset + pattern.len() > line.len():
        return false
    var i = 0
    while i < pattern.len():
        if line.byte_at(offset + i) != pattern.byte_at(i):
            return false
        i = i + 1
    true

fn _source_ascii_ident_start(byte: i64) -> bool:
    (byte >= 65 and byte <= 90) or byte == 95 or
        (byte >= 97 and byte <= 122)

fn _source_ascii_ident_continue(byte: i64) -> bool:
    _source_ascii_ident_start(byte) or (byte >= 48 and byte <= 57)

struct DeprecatedDunderFact:
    line: i64
    start_column: i64
    end_column: i64
    name: text

fn deprecated_dunder_facts(lines: [text]) -> [DeprecatedDunderFact]:
    """Collect code-only Type__method( calls in source order.

    The state machine skips comments and ordinary/triple string payload. Each
    accepted identifier is sliced exactly once, after its byte bounds and
    deprecated shape have been proven.
    """
    var result: [DeprecatedDunderFact] = []
    var in_triple_string = false
    var line_i = 0
    while line_i < lines.len():
        val line = lines[line_i]
        var i = 0
        val n = line.len()
        while i < n:
            if in_triple_string:
                if i + 2 < n and line.byte_at(i) == 34 and
                    line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                    in_triple_string = false
                    i = i + 3
                else:
                    i = i + 1
                continue
            val byte = line.byte_at(i)
            if byte == 35:
                break
            if i + 2 < n and byte == 34 and
                line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                in_triple_string = true
                i = i + 3
                continue
            if byte == 34:
                i = i + 1
                while i < n:
                    val string_byte = line.byte_at(i)
                    if string_byte == 92:
                        i = i + 2
                        continue
                    i = i + 1
                    if string_byte == 34:
                        break
                continue
            if (_source_ascii_ident_start(byte) and
                (i == 0 or not _source_ascii_ident_continue(line.byte_at(i - 1)))):
                val start = i
                var has_middle_dunder = false
                i = i + 1
                while i < n and _source_ascii_ident_continue(line.byte_at(i)):
                    if i > start and line.byte_at(i - 1) == 95 and line.byte_at(i) == 95:
                        has_middle_dunder = true
                    i = i + 1
                val length = i - start
                val starts_dunder = length >= 2 and
                    line.byte_at(start) == 95 and line.byte_at(start + 1) == 95
                val ends_dunder = length >= 2 and
                    line.byte_at(i - 2) == 95 and line.byte_at(i - 1) == 95
                if (length > 4 and has_middle_dunder and not starts_dunder and
                    not ends_dunder and i < n and line.byte_at(i) == 40):
                    result.push(DeprecatedDunderFact(
                        line_i + 1, start + 1, i + 1,
                        line.substring(start, i)))
                continue
            i = i + 1
        line_i = line_i + 1
    result

struct CodePatternProjection:
    columns: [i64]
    target_column: i64

fn _first_code_pattern_projection(
    lines: [text], pattern: text, target_line: i64, collect_all: bool
) -> CodePatternProjection:
    if not collect_all and (target_line < 0 or target_line >= lines.len()):
        return CodePatternProjection([], 0)
    var columns: [i64] = []
    var target_column = 0
    var in_triple_string = false
    var line_i = 0
    val stop_line = if collect_all: lines.len() - 1 else: target_line
    while line_i <= stop_line:
        val line = lines[line_i]
        var column = 0
        var i = 0
        val n = line.len()
        while i < n:
            if in_triple_string:
                if i + 2 < n and line.byte_at(i) == 34 and
                    line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                    in_triple_string = false
                    i = i + 3
                else:
                    i = i + 1
                continue

            val byte = line.byte_at(i)
            if byte == 35:
                break
            if i + 2 < n and byte == 34 and
                line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                in_triple_string = true
                i = i + 3
                continue
            if byte == 34:
                i = i + 1
                while i < n:
                    val string_byte = line.byte_at(i)
                    if string_byte == 92:
                        i = i + 2
                        continue
                    i = i + 1
                    if string_byte == 34:
                        break
                continue
            if column == 0 and i + pattern.len() <= n:
                if _source_bytes_match_at(line, pattern, i):
                    column = i + 1
                    i = i + pattern.len()
                    continue
            i = i + 1
        if collect_all:
            columns.push(column)
        else:
            target_column = column
        line_i = line_i + 1
    CodePatternProjection(columns, target_column)

fn first_code_pattern_columns(lines: [text], pattern: text) -> [i64]:
    """Return one-based first code-only match per line, tracking docstrings."""
    _first_code_pattern_projection(lines, pattern, -1, true).columns

fn first_code_pattern_column_at(lines: [text], pattern: text, target_line: i64) -> i64:
    """Return one code-only column without allocating a per-line result array.

    `target_line` is a zero-based physical-line index. Earlier lines are scanned
    only to preserve multiline triple-string state; later lines are untouched.
    """
    _first_code_pattern_projection(lines, pattern, target_line, false).target_column

struct CodePatternLineFacts:
    first_executable_column: i64
    first_code_column: i64
    pattern_columns: [i64]

fn code_pattern_line_facts(lines: [text], patterns: [text]) -> [CodePatternLineFacts]:
    """Collect executable-token and code-only pattern columns in one scan.

    String openers are executable tokens, but their payload is excluded from
    first_code_column and pattern matching. Triple-string interior and a
    closing-only delimiter line have no executable token.
    """
    var result: [CodePatternLineFacts] = []
    var in_triple_string = false
    for line in lines:
        var columns: [i64] = []
        for _pattern in patterns:
            columns.push(0)
        var first_executable_column = 0
        var first_code_column = 0
        var i = 0
        val n = line.len()
        while i < n:
            if in_triple_string:
                if i + 2 < n and line.byte_at(i) == 34 and
                    line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                    in_triple_string = false
                    i = i + 3
                else:
                    i = i + 1
                continue

            val byte = line.byte_at(i)
            if byte == 35:
                break
            # A string's payload is not searchable code, but its opening quote
            # is still an executable expression token. Triple-string interior
            # and a delimiter that only closes an earlier line stay non-code.
            if first_executable_column == 0 and byte != 32 and byte != 9:
                first_executable_column = i + 1
            if i + 2 < n and byte == 34 and
                line.byte_at(i + 1) == 34 and line.byte_at(i + 2) == 34:
                in_triple_string = true
                i = i + 3
                continue
            if byte == 34:
                i = i + 1
                while i < n:
                    val string_byte = line.byte_at(i)
                    if string_byte == 92:
                        i = i + 2
                        continue
                    i = i + 1
                    if string_byte == 34:
                        break
                continue
            if first_code_column == 0 and byte != 32 and byte != 9:
                first_code_column = i + 1
            var pattern_i = 0
            while pattern_i < patterns.len():
                if columns[pattern_i] == 0:
                    if _source_bytes_match_at(line, patterns[pattern_i], i):
                        columns[pattern_i] = i + 1
                pattern_i = pattern_i + 1
            i = i + 1
        result.push(CodePatternLineFacts(
            first_executable_column, first_code_column, columns))
    result
