# `simple robust inventory [--sdn] <file.spl|dir>...` — print the
# boundary/origin inventory (origin facts per bound value). Directories are
# walked for `.spl` files (sorted); text mode prints per-file blocks, `--sdn`
# prints one cross-file SDN document.
# `simple robust boundaries <file.spl|dir>...` — list boundary sites only.
# `--source text|hir` picks the origin-fact source; `hir` is the default,
# `text` stays the parity reference.
# Exit 2 on usage error or a missing path.

use std.io_runtime.{file_read, is_dir, dir_walk}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use app.cli.robust_source.{robust_render, robust_source_available, ROBUST_SOURCES, ROBUST_DEFAULT_SOURCE}

val ROBUST_USAGE = "Usage: simple robust inventory [--sdn] [--source text|hir] <file.spl|dir>... | simple robust boundaries [--source text|hir] <file.spl|dir>..."

fn _robust_paths(args: [text]) -> [text]?:
    # Expand file/dir arguments in argument order; None if a path is missing.
    var out: [text] = []
    for a in args:
        if is_dir(a):
            var found: [text] = []
            for p in dir_walk(a):
                if p.ends_with(".spl"):
                    found.push(p.replace("\\", "/"))
            for p in found.sort():
                out.push(p)
        elif file_exists(a):
            out.push(a)
        else:
            print "robust: path not found: {a}"
            return None
    Some(out)

fn run_robust(args: [text]) -> i64:
    """Usage: simple robust inventory [--sdn] [--source text|hir] <file.spl|dir>... | boundaries [--source text|hir] <file.spl|dir>..."""
    if args.len() < 2 or (args[0] != "inventory" and args[0] != "boundaries"):
        print ROBUST_USAGE
        return 2
    var sdn = false
    var source = ROBUST_DEFAULT_SOURCE
    var targets: [text] = []
    var i = 1
    while i < args.len():
        if args[i] == "--sdn" and args[0] == "inventory":
            sdn = true
        elif args[i] == "--source":
            if i + 1 >= args.len() or not ROBUST_SOURCES.contains(args[i + 1]):
                print ROBUST_USAGE
                return 2
            source = args[i + 1]
            i = i + 1
        else:
            targets.push(args[i])
        i = i + 1
    if targets.len() == 0:
        print ROBUST_USAGE
        return 2
    if not robust_source_available(source):
        print "robust: --source {source} unavailable"
        return 2
    val paths_opt = _robust_paths(targets)
    if not paths_opt.?:
        return 2
    val paths = paths_opt.unwrap()
    var sources: [text] = []
    for p in paths:
        sources.push(file_read(p))
    # The hir source renders None when a file does not parse: fail, never
    # fall back to text.
    if args[0] == "boundaries" or sdn:
        val surface = if args[0] == "boundaries": "boundaries" else: "inventory_sdn"
        if val out = robust_render(surface, source, paths, sources):
            print out
            return 0
        print "robust: --source {source}: a file did not parse"
        return 2
    var j = 0
    while j < paths.len():
        if val one = robust_render("inventory_text", source, [paths[j]], [sources[j]]):
            print one.substring(0, one.byte_len() - 1)
        else:
            print "robust: --source {source}: {paths[j]} did not parse"
            return 2
        j = j + 1
    0

export run_robust
