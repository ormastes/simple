# `simple robust inventory <file.spl>...` — print the boundary/origin
# inventory (origin facts per bound value) for the given files, deterministic
# text, files in argument order. Exit 2 on usage error or unreadable file.

use std.io_runtime.{file_read}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use compiler.semantics.lint.bound_origin_facts.{bound_origin_inventory_text}

fn run_robust(args: [text]) -> i64:
    """Usage: simple robust inventory <file.spl> [more files...]"""
    if args.len() < 2 or args[0] != "inventory":
        print "Usage: simple robust inventory <file.spl> [more files...]"
        return 2
    var i = 1
    while i < args.len():
        val path = args[i]
        if not file_exists(path):
            print "robust: file not found: {path}"
            return 2
        print bound_origin_inventory_text(file_read(path), path)
        i = i + 1
    0

export run_robust
