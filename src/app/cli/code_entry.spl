# Entry point for `simple code <refactor|ast>` — the CLI surface of the shared
# source-edit core. Keep this wrapper thin: the work lives in
# app.io.cli_code_commands, which the LSP and the LSP-MCP bridge also reach
# through this entry as a child process.
use std.cli.cli_util (get_cli_args)
use app.io.cli_code_commands.{run_code_command}

fn main() -> i64:
    val all_args = get_cli_args()
    var filtered_args: [text] = []
    var i = 0
    if all_args.len() > 0 and (all_args[0].ends_with("code_entry.spl") or all_args[0].ends_with("simple_code")):
        i = 1
    while i < all_args.len():
        filtered_args.push(all_args[i])
        i = i + 1
    run_code_command(filtered_args)
