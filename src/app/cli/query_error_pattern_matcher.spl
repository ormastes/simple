fn _query_error_direct_transition(state: i64, byte: i64) -> i64:
    if state == 0:
        if byte < 0 or byte >= 128:
            return 0
        return _QEC_ROOT_NEXT[byte].to_i64()
    val edge_end = _QEC_EDGE_START[state + 1].to_i64()
    var edge = _QEC_EDGE_START[state].to_i64()
    while edge < edge_end:
        val candidate = _QEC_EDGE_BYTE[edge].to_i64()
        if candidate == byte:
            return _QEC_EDGE_NEXT[edge].to_i64()
        if candidate > byte:
            return -1
        edge = edge + 1
    -1

fn query_error_pattern_hits(message: text) -> QueryErrorPatternHits:
    var lo = 0u64
    var hi = 0u64
    var state = 0
    var offset = 0
    while offset < message.len():
        val byte = message.byte_at(offset)
        var next_state = _query_error_direct_transition(state, byte)
        while next_state < 0:
            state = _QEC_FAIL[state].to_i64()
            next_state = _query_error_direct_transition(state, byte)
        state = next_state
        val output_index = _QEC_OUTPUT_INDEX[state].to_i64()
        if output_index > 0:
            lo = lo | _QEC_OUTPUT_LO[output_index]
            hi = hi | _QEC_OUTPUT_HI[output_index]
        offset = offset + 1
    QueryErrorPatternHits(lo: lo, hi: hi)

fn query_error_pattern_hit(hits: QueryErrorPatternHits, pattern_id: i64) -> bool:
    if pattern_id < 0 or pattern_id >= QUERY_ERROR_PATTERN_COUNT:
        return false
    if pattern_id < 64:
        return (hits.lo & (1u64 << pattern_id.to_u64())) != 0u64
    (hits.hi & (1u64 << (pattern_id - 64).to_u64())) != 0u64
