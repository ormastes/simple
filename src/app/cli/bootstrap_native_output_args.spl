# Shared operand skipping for the bootstrap positional and output-mode parsers.
# Keep i64 here: the admitted capsule has a bool branch-merge codegen defect.
pub fn native_build_flag_needs_value(flag: text) -> i64:
    if flag == "-o":
        1
    elif flag == "--output":
        1
    elif flag == "--source":
        1
    elif flag == "--entry":
        1
    elif flag == "--threads":
        1
    elif flag == "--timeout":
        1
    elif flag == "--cache-dir":
        1
    elif flag == "--backend":
        1
    elif flag == "--backend-plugin":
        1
    elif flag == "--runtime-bundle":
        1
    elif flag == "--runtime-path":
        1
    elif flag == "--mode":
        1
    elif flag == "--target":
        1
    elif flag == "--linker-script":
        1
    elif flag == "--log":
        1
    else:
        0

# Driver wire values are 1/object, archive, shared. Empty means no CLI override;
# conflict is rejected by the caller before dispatch or environment mutation.
pub fn bootstrap_native_build_output_mode(args: [text]) -> text:
    var selected = ""
    var index = 0
    while index < args.len():
        val arg = args[index]
        if native_build_flag_needs_value(arg) == 1:
            index = index + 2
            continue
        val requested = if arg == "--emit-object": "1" elif arg == "--emit-archive": "archive" elif arg == "--emit-shared": "shared" else: ""
        if requested != "":
            if selected != "" and selected != requested:
                return "conflict"
            selected = requested
        index = index + 1
    selected
