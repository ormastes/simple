# Shared operand skipping for the bootstrap positional and output-mode parsers.
# Keep i64 here: the admitted capsule has a bool branch-merge codegen defect.
pub fn native_build_flag_needs_value(flag: text) -> i64:
    if flag == "-o":
        1
    elif flag == "--output":
        1
    elif flag == "--source":
        1
    elif flag == "--entry":
        1
    elif flag == "--threads":
        1
    elif flag == "--timeout":
        1
    elif flag == "--cache-dir":
        1
    elif flag == "--backend":
        1
    elif flag == "--backend-plugin":
        1
    elif flag == "--runtime-bundle":
        1
    elif flag == "--runtime-owner":
        1
    elif flag == "--runtime-path":
        1
    elif flag == "--profile" or flag == "--managed-build-phase":
        1
    elif flag == "--mode":
        1
    elif flag == "--target":
        1
    elif flag == "--linker-script":
        1
    elif flag == "--log":
        1
    else:
        0

# Driver wire values are 1/aggregate-object, entry/single-entry-object, archive, shared. Empty means no CLI override;
# conflict is rejected by the caller before dispatch or environment mutation.
pub fn bootstrap_native_build_output_mode(args: [text]) -> text:
    var selected = ""
    var index = 0
    while index < args.len():
        val arg = args[index]
        if native_build_flag_needs_value(arg) == 1:
            index = index + 2
            continue
        val requested = if arg == "--emit-object": "1" elif arg == "--emit-entry-object": "entry" elif arg == "--emit-archive": "archive" elif arg == "--emit-shared": "shared" else: ""
        if requested != "":
            if selected != "" and selected != requested:
                return "conflict"
            selected = requested
        index = index + 1
    selected

# Route-level artifact gate for a top-level `native-build` (1 = fail closed).
# A build that owns an executable artifact (top_level == 1: not a worker/shard/
# role child, not help, not object/archive/shared output) and returns 0 with
# its explicit -o path absent did not build. Every route below main already
# fails closed in source; this is the one check that no route can bypass.
# i64, not bool: the admitted capsule has a bool branch-merge codegen defect.
# Bug: doc/08_tracking/bug/native_build_exit0_no_artifact_after_pool_refusal_2026-11-22.md
pub fn bootstrap_native_build_missing_artifact_v1(code: i64, output: text,
        output_present: i64, top_level: i64) -> i64:
    if code != 0 or top_level != 1:
        return 0
    if output == "" or output_present == 1:
        return 0
    1
