# CLI argument parsing, version/target reporting, OS build/run/test dispatch, and global-flag handling.
# Simple Language - Unified CLI (Written in Simple)
#
# This is the main entry point for the Simple CLI, written in Simple itself.
# Most functionality is implemented in Simple; SFFI is only used for runtime operations.
#
# Usage like Python:
#   simple              - Start interactive REPL
#   simple file.spl     - Run source file
#   simple file.smf     - Run compiled binary
#   simple -c "code"    - Run code string

# Direct sub-module imports (bypass app.io.mod hub for faster startup)
use app.io.env_ops.{env_get}
use app.io.cli_ops.{cli_get_args}
use app.io.cli_commands.{cli_run_lex}
use app.io.cli_ops.{fault_set_stack_overflow_detection, fault_set_max_recursion_depth, fault_set_timeout, fault_set_execution_limit}
use app.io.cli_ops.{_cli_eprint}
use app.io.cli_commands.{cli_handle_linkers, cli_run_file}
use app.cli.cli_helpers.{print_cli_help, read_sdn_run_config}

# `dashboard` is a deprecated alias for the real LLM agent dashboard (`agents`).
# Both delegate to src/app/llm_dashboard/main.spl (TUI by default, --web/--ios
# for the web surface) — no dead "moved to simple-ide" stub left.
fn run_dashboard(args: [text]) -> i64:
    for arg in args:
        if arg == "--help" or arg == "-h" or arg == "help":
            print "Note: 'dashboard' is a deprecated alias for 'agents' (LLM dashboard)."
    run_llm_dashboard(args)

fn run_llm_dashboard(args: [text]) -> i64:
    cli_run_file("src/app/llm_dashboard/main.spl", args, false, false)

# True only when arg is the CLI entry script itself (interpreted mode:
# `bin/simple src/app/cli/main.spl args...`). A bare ends_with("main.spl")
# check misroutes user files like build/h_main.spl or xmain.spl to the REPL
# when this CLI runs as a compiled (stage4) binary.
fn arg_is_cli_entry_script(arg: text) -> bool:
    if arg.ends_with("/app/cli/main.spl"):
        return true
    if arg == "src/app/cli/main.spl":
        return true
    if arg == "app/cli/main.spl":
        return true
    if arg.ends_with("/app/cli/_CliMain/main_and_help.spl"):
        return true
    if arg == "src/app/cli/_CliMain/main_and_help.spl":
        return true
    if arg == "app/cli/_CliMain/main_and_help.spl":
        return true
    if arg.ends_with("/app/cli/bootstrap_main.spl"):
        return true
    if arg == "src/app/cli/bootstrap_main.spl":
        return true
    return false

# Extract CLI args, skipping program name and script path
fn copy_cli_args_from(raw_args: [text], start_idx: i64) -> [text]:
    var args: [text] = []
    var i = start_idx
    while i < raw_args.len():
        args.push(raw_args[i])
        i = i + 1
    args

fn get_cli_args() -> [text]:
    val raw_args = cli_get_args()
    if raw_args == nil:
        return []
    if raw_args.len() > 1:
        if arg_is_cli_entry_script(raw_args[1]):
            return copy_cli_args_from(raw_args, 2)
    copy_cli_args_from(raw_args, 1)

# =========================================================================
# Version and Help - implemented in Simple
# =========================================================================
fn get_version() -> text:
    "1.0.0-RC"

fn print_version():
    val v = get_version()
    print "Simple v{v}"

# =========================================================================
# Target architectures - implemented in Simple
# =========================================================================
fn print_targets():
    print "Available target architectures:"
    print ""
    print "  x86_64          64-bit x86 Linux (ELF)"
    print "  aarch64         64-bit ARM Linux (ELF)"
    print "  riscv64         64-bit RISC-V Linux (ELF)"
    print "  aarch64-macos   64-bit ARM macOS (Mach-O, Apple Silicon)"
    print "  x86_64-macos    64-bit x86 macOS (Mach-O, Intel Mac)"
    print "  i686            32-bit x86"
    print "  armv7           32-bit ARM"
    print "  riscv32         32-bit RISC-V"
    print ""
    print "WebAssembly:"
    print "  wasm32-wasi     32-bit WebAssembly (WASI Preview 1)"
    print "  wasm32          32-bit WebAssembly (standalone, no WASI)"
    print "  wasm64          64-bit WebAssembly (Memory64 proposal)"
    print ""
    print "SimpleOS (bare-metal):"
    print "  x86_64-simpleos         64-bit x86 SimpleOS kernel (ELF, no OS)"
    print "  x86_64-unknown-simpleos Full triple form (same as above)"
    print "  simpleos                Default SimpleOS target (x86_64)"
    print ""
    print "Usage:"
    print "  simple compile app.spl --target aarch64"
    print "  simple compile app.spl --target aarch64-macos"
    print "  simple compile app.spl --target wasm32-wasi -o app.wasm"

# =========================================================================
# Native linkers - implemented in Simple
# =========================================================================
fn print_linkers():
    val _ = cli_handle_linkers()

# =========================================================================
# Error messages - implemented in Simple
# =========================================================================
fn print_error(msg: text):
    print "ERROR: " + msg

fn print_error_with_help(msg: text):
    print "ERROR: " + msg
    print ""
    print_cli_help()

# =========================================================================
# Simple Lexer - delegates to Rust runtime
# =========================================================================

fn run_lex_command(path: text) -> i64:
    val args = get_cli_args()
    cli_run_lex(args)

# Global flags struct
struct GlobalFlags:
    gc_log: bool
    gc_off: bool
    use_notui: bool
    max_recursion_depth: i64
    timeout_secs: i64
    execution_limit: i64
    stack_overflow_detection: bool
    backend: text
    force_interpret: bool
    interpreter_mode: text
    run_config: text
    no_jit: bool
    jit_threshold: i64
    mem_infra_requested: [text]
    mem_infra_strict: bool

struct CoreFlags:
    gc_log: bool
    gc_off: bool
    use_notui: bool
    force_interpret: bool
    interpreter_mode: text
    run_config: text
    no_jit: bool
    jit_threshold: i64

struct BackendFlags:
    backend: text

struct LimitFlags:
    max_recursion_depth: i64
    timeout_secs: i64
    execution_limit: i64
    stack_overflow_detection: bool

fn parse_cli_nonnegative_or_default(value: text, default_value: i64) -> i64:
    val trimmed = value.trim()
    if trimmed == "":
        return default_value
    for ch in trimmed:
        if ch < "0" or ch > "9":
            return default_value
    return trimmed.to_int() ?? default_value

fn parse_core_flags(args: [text]) -> CoreFlags:
    var gc_log = false
    var gc_off = false
    var use_notui = false
    var force_interpret = false
    var interpreter_mode = "optimized"
    var run_config = ""
    var no_jit = false
    var jit_threshold = 10

    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--gc-log":
            gc_log = true
        elif arg == "--gc-off":
            gc_off = true
        elif arg == "--notui":
            use_notui = true
        elif arg == "--interpret":
            force_interpret = true
        elif arg == "--interpret-optimized":
            force_interpret = true
            interpreter_mode = "optimized"
        elif arg == "--no-jit":
            no_jit = true
        elif arg.starts_with("--jit-threshold="):
            val val_str = arg[16:]
            jit_threshold = parse_cli_nonnegative_or_default(val_str, jit_threshold)
        elif arg == "--jit-threshold" and i + 1 < args.len():
            i = i + 1
            jit_threshold = parse_cli_nonnegative_or_default(args[i], jit_threshold)
        elif arg.starts_with("--interpreter-mode="):
            interpreter_mode = arg[19:]
        elif arg == "--interpreter-mode" and i + 1 < args.len():
            i = i + 1
            interpreter_mode = args[i]
        elif arg.starts_with("--run-config="):
            run_config = arg[13:]
        elif arg == "--run-config" and i + 1 < args.len():
            i = i + 1
            run_config = args[i]
        i = i + 1

    return CoreFlags(gc_log: gc_log, gc_off: gc_off, use_notui: use_notui,
        force_interpret: force_interpret, interpreter_mode: interpreter_mode,
        run_config: run_config, no_jit: no_jit, jit_threshold: jit_threshold)

fn parse_backend_flags(args: [text]) -> BackendFlags:
    var backend = "auto"

    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg.starts_with("--backend="):
            backend = arg[10:]
        elif arg == "--backend" and i + 1 < args.len():
            i = i + 1
            backend = args[i]
        elif arg == "--fixed-be":
            backend = "llvm"
        elif arg.starts_with("--fixed-be="):
            val fixed_backend = arg[11:]
            if fixed_backend == "":
                backend = "llvm"
            else:
                backend = fixed_backend
        i = i + 1

    return BackendFlags(backend: backend)

fn parse_limit_flags(args: [text]) -> LimitFlags:
    var max_recursion_depth = 0
    var timeout_secs = 0
    var execution_limit = 0
    var stack_overflow_detection = false

    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--stack-overflow-detection":
            stack_overflow_detection = true
        elif arg == "--no-stack-overflow-detection":
            stack_overflow_detection = false
        elif arg.starts_with("--max-recursion-depth="):
            val val_str = arg[21:]
            max_recursion_depth = parse_cli_nonnegative_or_default(val_str, max_recursion_depth)
        elif arg == "--max-recursion-depth" and i + 1 < args.len():
            i = i + 1
            max_recursion_depth = parse_cli_nonnegative_or_default(args[i], max_recursion_depth)
        elif arg.starts_with("--timeout="):
            val val_str = arg[10:]
            timeout_secs = parse_cli_nonnegative_or_default(val_str, timeout_secs)
        elif arg == "--timeout" and i + 1 < args.len():
            i = i + 1
            timeout_secs = parse_cli_nonnegative_or_default(args[i], timeout_secs)
        elif arg.starts_with("--execution-limit="):
            val val_str = arg[18:]
            execution_limit = parse_cli_nonnegative_or_default(val_str, execution_limit)
        elif arg == "--execution-limit" and i + 1 < args.len():
            i = i + 1
            execution_limit = parse_cli_nonnegative_or_default(args[i], execution_limit)
        i = i + 1

    return LimitFlags(max_recursion_depth: max_recursion_depth,
        timeout_secs: timeout_secs, execution_limit: execution_limit,
        stack_overflow_detection: stack_overflow_detection)

fn parse_global_flags(args: [text]) -> GlobalFlags:
    val core = parse_core_flags(args)
    val backend_flags = parse_backend_flags(args)
    val limits = parse_limit_flags(args)
    var backend = backend_flags.backend
    var force_interpret = core.force_interpret
    var interpreter_mode = core.interpreter_mode
    var run_config = core.run_config
    var mem_infra_requested: [text] = []
    var mem_infra_strict = false

    var mem_index: i64 = 0
    while mem_index < args.len():
        val arg = args[mem_index]
        var requested = ""
        if arg.starts_with("--mem-infra="):
            requested = arg[12:]
        elif arg == "--mem-infra" and mem_index + 1 < args.len():
            mem_index = mem_index + 1
            requested = args[mem_index]
        elif arg == "--mem-infra-strict":
            mem_infra_strict = true
        if requested != "":
            for name in requested.split(","):
                if name != "":
                    mem_infra_requested.push(name)
        mem_index = mem_index + 1

    # Check SIMPLE_EXECUTION_MODE env var as fallback.
    #
    # Engine selection must never fail open: an unrecognized value used to fall
    # through to the JIT silently, so a typo (or the `interpreter` spelling the
    # Rust seed accepts) produced JIT results while the caller believed they had
    # pinned the interpreter. Accept both spellings and warn on anything else.
    # See doc/07_guide/runtime/execution_engine_selection.md
    if not force_interpret and backend == "auto":
        val env_mode = env_get("SIMPLE_EXECUTION_MODE")
        if env_mode == "interpret" or env_mode == "interpreter":
            force_interpret = true
        elif env_mode == "interpret-optimized":
            force_interpret = true
            interpreter_mode = "optimized"
        elif env_mode == "cranelift":
            backend = "cranelift"
        elif env_mode == "llvm":
            backend = "llvm"
        elif env_mode == "vhdl":
            backend = "vhdl"
        elif env_mode == "jit":
            backend = "auto"
        elif env_mode != "" and env_mode != nil:
            _cli_eprint("warning: SIMPLE_EXECUTION_MODE=\"{env_mode}\" is not a recognized execution mode; running with the default JIT. Valid: interpret, interpreter, interpret-optimized, jit, cranelift, llvm, vhdl.")

    # SIMPLE_NO_JIT=1 is a long-documented knob (and the `--no-jit` flag sets it),
    # but it only ever reached the interpreter's JIT threshold — it never selected
    # the engine, so A/B runs done with it silently compared JIT against JIT.
    # Treat it as a real request for the interpreter.
    if not force_interpret and backend == "auto":
        if core.no_jit or env_get("SIMPLE_NO_JIT") == "1":
            force_interpret = true

    # Read run-config from simple.sdn if not set via CLI/env
    if run_config == "":
        run_config = read_sdn_run_config()

    # Map run_config to interpreter_mode
    if run_config == "compiler" or run_config == "shared":
        interpreter_mode = "optimized"
        force_interpret = true
    elif run_config == "interpreter":
        interpreter_mode = "optimized"
        force_interpret = true
    elif run_config == "legacy":
        interpreter_mode = "classic"
        force_interpret = true

    return GlobalFlags(gc_log: core.gc_log, gc_off: core.gc_off, use_notui: core.use_notui,
        max_recursion_depth: limits.max_recursion_depth, timeout_secs: limits.timeout_secs,
        execution_limit: limits.execution_limit, stack_overflow_detection: limits.stack_overflow_detection,
        backend: backend, force_interpret: force_interpret,
        interpreter_mode: interpreter_mode, run_config: run_config,
        no_jit: core.no_jit, jit_threshold: core.jit_threshold,
        mem_infra_requested: mem_infra_requested,
        mem_infra_strict: mem_infra_strict)

fn apply_fault_detection(flags: GlobalFlags):
    if flags.max_recursion_depth > 0:
        fault_set_max_recursion_depth(flags.max_recursion_depth)
        fault_set_stack_overflow_detection(true)
    if flags.stack_overflow_detection:
        fault_set_stack_overflow_detection(true)
    if flags.timeout_secs > 0:
        fault_set_timeout(flags.timeout_secs)
    if flags.execution_limit > 0:
        fault_set_execution_limit(flags.execution_limit)
