# The final-artifact warm key must change when an admitted collection profile
# changes at the same path. This runs once before a build, never in a request
# or container operation hot path.

use std.io_runtime.{file_hash_sha256}

fn native_build_warm_collection_profile_digest(args: [text]) -> (bool, text):
    """Return (valid, digest); an absent profile has an empty digest."""
    var path = ""
    var present = false
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--collection-profile":
            if i + 1 >= args.len():
                return (false, "")
            i = i + 1
            path = args[i]
            present = true
        elif arg.starts_with("--collection-profile="):
            path = arg.substring("--collection-profile=".len())
            present = true
        i = i + 1
    if not present:
        return (true, "")
    if path == "":
        return (false, "")
    val digest = file_hash_sha256(path)
    if digest.len() != 64:
        return (false, "")
    for ch in digest:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return (false, "")
    (true, digest)

export native_build_warm_collection_profile_digest
