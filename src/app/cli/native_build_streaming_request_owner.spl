use app.io.env_ops.{env_get}
use compiler.driver.driver_streaming_surface_policy.{driver_streaming_surface_requested_values}

# Streaming has no parser cache to warm, including ordinary AOT requests.
# Entry authority and unsupported mode checks remain the driver's responsibility.
pub fn native_build_streaming_surfaces() -> bool:
    driver_streaming_surface_requested_values(
        env_get("SIMPLE_STAGE3_STREAMING_SURFACES") ?? "",
        env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "",
        env_get("SIMPLE_STAGE4_STREAMING_SURFACES") ?? "")
