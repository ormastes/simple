# Compatibility command-table projection of the canonical root CLI registry.
# Do not add command rows here; add one structured CliCommandSpecV1 record.

use app.cli.dispatch.types.{CommandEntry}
use app.cli.command_registry.{
    cli_registry_command_names_v1,
    cli_registry_app_path_v1,
}

fn get_command_table() -> [CommandEntry]:
    var table: [CommandEntry] = []
    for name in cli_registry_command_names_v1():
        table.push(CommandEntry(
            name: name,
            app_path: cli_registry_app_path_v1(name),
            env_override: "",
            needs_rust_flags: []
        ))
    table

fn get_all_commands() -> [text]:
    var names: [text] = []
    for name in cli_registry_command_names_v1():
        names.push(name)
    names
