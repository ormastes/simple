fn get_all_commands() -> [text]:
    """Get the name of every registered command.

    `get_command_table()` is the entry accessor; this is the name accessor, so
    callers that only need identifiers do not have to reach into the entries.
    Names are returned in canonical table order and every one of them resolves
    through `find_command`.

    Returns:
        Command names in table order
    """
    var names: [text] = []
    for entry in get_command_table():
        names.push(entry.name)
    names
