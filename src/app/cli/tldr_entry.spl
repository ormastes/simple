# `simple tldr --out <dir> <file.spl>...`
#
# Emits each module's TLDR companion and fills the full-AST parse caches from
# the same single parse (compiler.driver.cache.module_artifacts_v1). The test
# runner's TLDR refresh invokes this same command, so producer and consumers
# share one contract.

use std.cli.cli_util (get_cli_args)
use compiler.driver.cache.source_reader_v1.{file_source_reader_v1}

fn tldr_usage() -> i64:
    print "Usage: simple tldr --out <dir> <file.spl> [more.spl...]"
    1

fn main() -> i64:
    val all_args = get_cli_args()
    var out_root = ""
    var sources: [text] = []
    var i = 0
    while i < all_args.len():
        val arg = all_args[i]
        if arg.ends_with("tldr_entry.spl") or arg == "tldr":
            i = i + 1
            continue
        if arg == "--out" and i + 1 < all_args.len():
            out_root = all_args[i + 1]
            i = i + 2
            continue
        if arg.starts_with("--out="):
            out_root = arg.substring(6)
        elif arg == "--help" or arg == "-h":
            return tldr_usage()
        elif arg.ends_with(".spl"):
            sources.push(arg)
        i = i + 1
    if out_root == "" or sources.len() == 0:
        return tldr_usage()
    var failed = 0
    for source in sources:
        val error = file_source_reader_v1(out_root).update_tldr(source)
        if error != "":
            print "error: tldr: {error}"
            failed = failed + 1
    print "tldr: {sources.len() - failed}/{sources.len()} module(s) current under {out_root}"
    if failed > 0: 1 else: 0
