# Classify refresh intent before the bootstrap coordinator's stale-source prepass.
# The canonical coordinator remains the only owner that consumes the request.
use app.cli.native_build_main.{native_build_authority_request_v1}
use app.cli.native_build_output_plan.{native_build_is_value_consuming_flag}

pub fn bootstrap_source_authority_refresh_route_v1(args: [text], internal_worker: bool,
        stage3: bool, stage4: bool) -> Result<bool, text>:
    var child = internal_worker
    var grouped = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        if arg == "--group-manifest" or arg.starts_with("--group-manifest="):
            grouped = true
        if arg == "--file-worker" or arg.starts_with("--file-worker=") or
                arg == "--parse-shard" or arg.starts_with("--parse-shard=") or
                arg == "--hir-shard" or arg.starts_with("--hir-shard=") or
                arg == "--mir-shard" or arg.starts_with("--mir-shard=") or
                arg == "--group-result" or arg.starts_with("--group-result="):
            child = true
        if native_build_is_value_consuming_flag(arg) and index + 1 < args.len():
            index = index + 1
        index = index + 1
    val request = match native_build_authority_request_v1(args, child):
        case Ok(value): value
        case Err(reason): return Err(reason)
    if request.refresh and (stage3 or stage4 or grouped):
        return Err("source authority refresh requires an ordinary bootstrap coordinator")
    Ok(request.refresh)
