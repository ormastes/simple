# Shared compiled entry body for admitted native-build worker processes.
# Backend composition is installed by each caller before entering this module.
use app.io._CliCompile.compile_targets.{
    cli_native_build_with_environment_variant_policy_v1}
use app.io.env_ops.{env_get}
use app.cli.environment_variant_policy_handoff_owner_v1.{
    environment_variant_policy_handoff_extract_v1,
    environment_variant_policy_handoff_owner_error_label_v1}

pub fn run_native_build_worker_entry(args: [text]) -> i64:
    if (env_get("SIMPLE_NATIVE_BUILD_WORKER") ?? "") != "1":
        print "error: native_build_worker.spl is an internal entrypoint"
        return 1
    val opened = match environment_variant_policy_handoff_extract_v1(args):
        case Ok(value): value
        case Err(failure):
            val reason = environment_variant_policy_handoff_owner_error_label_v1(failure)
            print "error: native-build worker rejected its internal policy handoff: {reason}"
            return 1
    cli_native_build_with_environment_variant_policy_v1(
        opened.user_args, opened.handoff.collection)
