# Lightweight output intent shared by the coordinator and authoritative worker.
use compiler.common.driver_core_modes.{OutputFormat, driver_output_format_native,
    driver_output_format_both, driver_output_format_is_both}

pub fn native_build_output_format_v1(build_mode: text, emit_smf: bool,
        explicit_native_output: bool, native_group: bool) -> OutputFormat:
    if emit_smf or (build_mode == "dynload" and not explicit_native_output and not native_group):
        return driver_output_format_both()
    driver_output_format_native()

pub fn native_build_is_value_consuming_flag(arg: text) -> bool:
    arg == "--backend" or arg == "--backend-plugin" or arg == "--runtime-bundle" or arg == "--runtime-owner" or arg == "--runtime-path"
        or arg == "--linker-script" or arg == "--entry" or arg == "--source"
        or arg == "-o" or arg == "--output" or arg == "--mode" or arg == "--build-mode"
        or arg == "--cache-dir" or arg == "--input-manifest"
        or arg == "--target" or arg == "--cpu"
        or arg == "--opt-level" or arg == "--timeout" or arg == "--threads"
        or arg == "--jobs" or arg == "-j" or arg == "--log"
        or arg == "--parser-impl" or arg == "--parser-prefer"
        or arg == "--parser-require" or arg == "--host-cpu-max"
        or arg == "--frontend-offload"
        or arg == "--frontend-offload-fallback"
        or arg == "--collection-profile" or arg == "--collection-workload"
        or arg == "--collection-target"
        or arg == "--collection-policy" or arg == "--collection-memory-budget"


pub fn native_build_is_standalone_flag_v1(arg: text) -> bool:
    arg == "--entry-closure" or arg == "--low-memory" or arg == "--verbose" or arg == "-v" or arg == "--strip" or arg == "--emit-smf" or arg == "--emit-object" or arg == "--emit-entry-object" or arg == "--emit-archive" or arg == "--emit-shared" or arg == "--release" or arg == "--release-optimized" or arg == "--no-borrow-check" or arg == "--no-mangle" or arg == "--no-incremental" or arg == "--clean" or arg == "--fail-fast" or arg == "--keep-going" or arg == "--go-to-end" or arg == "--keep-intermediates" or arg == "--print-intermediates"

pub fn native_build_mir_output_requires_full_set_v1(args: [text], selective: bool,
        native_group: bool = false) -> bool:
    """Skip only a known incompatible ordinary output; uncertain argv retains
    existing worker admission. Selective MIR has a separate authoritative lane.
    This is scheduling preflight, not argument validation or lane admission.
    """
    if selective: return false
    var mode = "dynload"
    var emit_smf = false
    var explicit_native = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        if native_build_is_value_consuming_flag(arg):
            if index + 1 >= args.len(): return false
            index = index + 1
            if arg == "--mode" or arg == "--build-mode": mode = args[index]
        elif arg.starts_with("--mode="):
            mode = arg.substring(7)
        elif arg.starts_with("--build-mode="):
            mode = arg.substring(13)
        elif arg == "--emit-smf":
            emit_smf = true
        elif arg == "--emit-object" or arg == "--emit-entry-object" or
                arg == "--emit-archive" or arg == "--emit-shared":
            explicit_native = true
        elif arg.starts_with("-") and not native_build_is_standalone_flag_v1(arg):
            # Recognized inline value options cannot consume a following mode
            # or emit flag. Unknown options may: defer to normal worker parsing.
            val equals = arg.index_of("=")
            if equals < 0 or not native_build_is_value_consuming_flag(arg.substring(0, equals)):
                return false
        index = index + 1
    if mode != "dynload" and mode != "one-binary": return false
    driver_output_format_is_both(native_build_output_format_v1(mode, emit_smf,
        explicit_native, native_group))
