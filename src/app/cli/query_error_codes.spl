# Shared query diagnostic error-code classifier.
# Keeps ordered, case-sensitive legacy inference in one cycle-free owner.
use app.cli.query_rich_common.{_find_in_line_from}
use app.cli.query_error_pattern_matcher.{query_error_pattern_hits}

fn query_extract_error_code(msg: text, error_kind: text, codegen_phrase: text) -> text:
    """Extract an E-code from an error message or infer one from the error kind.

    Strategy:
    1. Check if the message already contains an explicit error code (e.g. error[E1001])
    2. Pattern-match common error message phrases to known E-codes
    3. Fall back to a generic code based on error_kind
    """
    # --- Strategy 1: explicit error code in message ---
    val bracket_idx = _find_in_line_from(msg, "[E", 0)
    if bracket_idx >= 0:
        val close_idx = _find_in_line_from(msg, "]", bracket_idx)
        if close_idx > bracket_idx + 1:
            return msg.substring(bracket_idx + 1, close_idx)

    # Check for an "Edddd" byte prefix. A suffix or colon is optional.
    if msg.len() >= 5 and msg.byte_at(0) == 69:
        val leading_code = msg.substring(0, 5)
        if _query_has_error_code_prefix(leading_code):
            return leading_code

    val pattern_hits = query_error_pattern_hits(msg)

    # BEGIN GENERATED QUERY ERROR RULES
    # --- Strategy 2: pattern-match message content to known E-codes ---
    # Semantic errors (E10xx)
    if (((pattern_hits.lo & 0x0000000000000001u64) != 0u64) or ((pattern_hits.lo & 0x0000000000000002u64) != 0u64)) and ((pattern_hits.lo & 0x0000000000000004u64) != 0u64):
        return "E1001"
    if (((pattern_hits.lo & 0x0000000000000008u64) != 0u64) or ((pattern_hits.lo & 0x0000000000000010u64) != 0u64)) and ((pattern_hits.lo & 0x0000000000000020u64) != 0u64):
        return "E1002"
    if ((pattern_hits.lo & 0x0000000000000040u64) != 0u64) and ((pattern_hits.lo & 0x0000000000000080u64) != 0u64):
        return "E1003"
    if ((pattern_hits.lo & 0x0000000000000100u64) != 0u64) or ((pattern_hits.lo & 0x0000000000000200u64) != 0u64):
        return "E1003"
    if ((pattern_hits.lo & 0x0000000000000400u64) != 0u64) or ((pattern_hits.lo & 0x0000000000000800u64) != 0u64):
        return "E1004"
    if ((pattern_hits.lo & 0x0000000000001000u64) != 0u64):
        return "E1005"
    if ((pattern_hits.lo & 0x0000000000002000u64) != 0u64):
        return "E1006"
    if ((pattern_hits.lo & 0x0000000000004000u64) != 0u64) or ((pattern_hits.lo & 0x0000000000008000u64) != 0u64):
        return "E1007"
    if ((pattern_hits.lo & 0x0000000000010000u64) != 0u64) or ((pattern_hits.lo & 0x0000000000020000u64) != 0u64):
        return "E1008"
    if ((pattern_hits.lo & 0x0000000000040000u64) != 0u64) or ((pattern_hits.lo & 0x0000000000080000u64) != 0u64):
        return "E1009"
    if ((pattern_hits.lo & 0x0000000000100000u64) != 0u64) and ((pattern_hits.lo & 0x0000000000000008u64) != 0u64):
        return "E1010"
    if ((pattern_hits.lo & 0x0000000000200000u64) != 0u64) and ((pattern_hits.lo & 0x0000000000000008u64) != 0u64) and not ((pattern_hits.lo & 0x0000000000000020u64) != 0u64):
        return "E1011"
    if ((pattern_hits.lo & 0x0000000000400000u64) != 0u64):
        return "E1012"
    if ((pattern_hits.lo & 0x0000000000800000u64) != 0u64):
        return "E1013"
    if ((pattern_hits.lo & 0x0000000001000000u64) != 0u64):
        return "E1014"
    if ((pattern_hits.lo & 0x0000000002000000u64) != 0u64):
        return "E1015"
    if ((pattern_hits.lo & 0x0000000004000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000008000000u64) != 0u64):
        return "E1020"
    if ((pattern_hits.lo & 0x0000000010000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000020000000u64) != 0u64):
        return "E1021"
    if ((pattern_hits.lo & 0x0000000040000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000080000000u64) != 0u64):
        return "E1025"
    if ((pattern_hits.lo & 0x0000000010000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000100000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000080000000u64) != 0u64):
        return "E1031"
    if ((pattern_hits.lo & 0x0000000200000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000400000000u64) != 0u64):
        return "E1032"
    if ((pattern_hits.lo & 0x0000000800000000u64) != 0u64):
        return "E1034"
    if ((pattern_hits.lo & 0x0000001000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000002000000000u64) != 0u64):
        return "E1046"
    if ((pattern_hits.lo & 0x0000004000000000u64) != 0u64) or ((pattern_hits.lo & 0x0000008000000000u64) != 0u64):
        return "E1048"
    if ((pattern_hits.lo & 0x0000010000000000u64) != 0u64):
        return "E1068"

    # Control flow errors (E11xx / E1057)
    if ((pattern_hits.lo & 0x0000020000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000040000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000080000000000u64) != 0u64):
        return "E1101"
    if ((pattern_hits.lo & 0x0000100000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000040000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000080000000000u64) != 0u64):
        return "E1102"
    if ((pattern_hits.lo & 0x0000200000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000040000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000000000000020u64) != 0u64):
        return "E1103"
    if ((pattern_hits.lo & 0x0000200000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000400000000000u64) != 0u64):
        return "E1104"
    if ((pattern_hits.lo & 0x0000800000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000040000000000u64) != 0u64) and ((pattern_hits.lo & 0x0001000000000000u64) != 0u64):
        return "E1057"
    if ((pattern_hits.lo & 0x0002000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0000040000000000u64) != 0u64) and ((pattern_hits.lo & 0x0004000000000000u64) != 0u64):
        return "E1105"

    # Actor/concurrency errors (E12xx)
    if ((pattern_hits.lo & 0x0008000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0010000000000000u64) != 0u64):
        return "E1201"
    if ((pattern_hits.lo & 0x0008000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0020000000000000u64) != 0u64):
        return "E1202"
    if ((pattern_hits.lo & 0x0040000000000000u64) != 0u64):
        return "E1203"
    if ((pattern_hits.lo & 0x0080000000000000u64) != 0u64):
        return "E1204"

    # Capability errors (E13xx)
    if ((pattern_hits.lo & 0x0100000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0200000000000000u64) != 0u64):
        return "E1301"
    if ((pattern_hits.lo & 0x0400000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0200000000000000u64) != 0u64):
        return "E1302"
    if ((pattern_hits.lo & 0x0800000000000000u64) != 0u64) and ((pattern_hits.lo & 0x0200000000000000u64) != 0u64):
        return "E1303"

    # Macro errors (E14xx)
    if ((pattern_hits.lo & 0x1000000000000000u64) != 0u64):
        return "E1401"
    if ((pattern_hits.lo & 0x2000000000000000u64) != 0u64) and ((pattern_hits.lo & 0x4000000000000000u64) != 0u64):
        return "E1402"
    if ((pattern_hits.lo & 0x2000000000000000u64) != 0u64) and ((pattern_hits.lo & 0x8000000000000000u64) != 0u64):
        return "E1401"

    # AOP errors (E15xx)
    if ((pattern_hits.hi & 0x0000000000000001u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000002u64) != 0u64):
        return "E1501"
    if ((pattern_hits.hi & 0x0000000000000004u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000008u64) != 0u64):
        return "E1502"
    if ((pattern_hits.hi & 0x0000000000000010u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000020u64) != 0u64):
        return "E1503"
    if ((pattern_hits.hi & 0x0000000000000040u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000080u64) != 0u64):
        return "E1505"
    if ((pattern_hits.hi & 0x0000000000000100u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000200u64) != 0u64):
        return "E1506"

    # Mixin errors (E17xx)
    if ((pattern_hits.hi & 0x0000000000000400u64) != 0u64) and ((pattern_hits.lo & 0x0000000000000008u64) != 0u64):
        return "E1701"
    if ((pattern_hits.hi & 0x0000000000000400u64) != 0u64) and ((pattern_hits.hi & 0x0000000000000800u64) != 0u64):
        return "E1702"

    # Codegen errors (E20xx)
    if ((pattern_hits.hi & 0x0000000000001000u64) != 0u64):
        return "E2001"
    if msg.contains(codegen_phrase):
        return "E2002"

    # Runtime errors (E30xx)
    if ((pattern_hits.hi & 0x0000000000002000u64) != 0u64):
        return "E3001"
    if ((pattern_hits.hi & 0x0000000000004000u64) != 0u64) and ((pattern_hits.hi & 0x0000000000008000u64) != 0u64):
        return "E3002"
    if ((pattern_hits.hi & 0x0000000000010000u64) != 0u64):
        return "E3003"
    if ((pattern_hits.hi & 0x0000000000020000u64) != 0u64):
        return "E3004"

    # Method resolution special case
    if ((pattern_hits.hi & 0x0000000000040000u64) != 0u64):
        return "E1013"

    # Type inference errors
    if ((pattern_hits.hi & 0x0000000000080000u64) != 0u64) or ((pattern_hits.hi & 0x0000000000100000u64) != 0u64):
        return "E0391"
    if ((pattern_hits.hi & 0x0000000000200000u64) != 0u64) or ((pattern_hits.hi & 0x0000000000400000u64) != 0u64):
        return "E0277"

    # Dimension constraint errors (E05xx from dim_constraints_types)
    if ((pattern_hits.hi & 0x0000000000800000u64) != 0u64):
        return "E0501"
    if ((pattern_hits.hi & 0x0000000001000000u64) != 0u64):
        return "E0502"
    if ((pattern_hits.hi & 0x0000000002000000u64) != 0u64):
        return "E0503"
    if ((pattern_hits.hi & 0x0000000004000000u64) != 0u64):
        return "E0504"
    if ((pattern_hits.hi & 0x0000000008000000u64) != 0u64):
        return "E0505"
    if ((pattern_hits.hi & 0x0000000010000000u64) != 0u64):
        return "E0506"
    if ((pattern_hits.hi & 0x0000000020000000u64) != 0u64):
        return "E0507"
    if ((pattern_hits.hi & 0x0000000040000000u64) != 0u64):
        return "E0508"

    # Borrow checking errors
    if ((pattern_hits.hi & 0x0000000080000000u64) != 0u64) or ((pattern_hits.hi & 0x0000000100000000u64) != 0u64):
        return "E0502"
    if ((pattern_hits.hi & 0x0000000200000000u64) != 0u64) and ((pattern_hits.hi & 0x0000000400000000u64) != 0u64):
        return "E0503"
    if ((pattern_hits.hi & 0x0000000800000000u64) != 0u64) and ((pattern_hits.hi & 0x0000001000000000u64) != 0u64):
        return "E0505"
    if ((pattern_hits.lo & 0x0800000000000000u64) != 0u64) and ((pattern_hits.hi & 0x0000002000000000u64) != 0u64):
        return "E0515"

    # Trait coherence errors
    if ((pattern_hits.hi & 0x0000004000000000u64) != 0u64) and ((pattern_hits.hi & 0x0000008000000000u64) != 0u64):
        return "E0117"
    if ((pattern_hits.hi & 0x0000010000000000u64) != 0u64):
        return "E0119"
    if ((pattern_hits.hi & 0x0000020000000000u64) != 0u64) and ((pattern_hits.hi & 0x0000040000000000u64) != 0u64):
        return "E0119"
    if ((pattern_hits.hi & 0x0000080000000000u64) != 0u64):
        return "E0271"

    # Trait validation errors
    if ((pattern_hits.hi & 0x0000100000000000u64) != 0u64):
        return "E0283"
    if ((pattern_hits.hi & 0x0000200000000000u64) != 0u64):
        return "E0119"
    if ((pattern_hits.hi & 0x0000400000000000u64) != 0u64) and ((pattern_hits.hi & 0x0000800000000000u64) != 0u64):
        return "E0046"
    if ((pattern_hits.hi & 0x0001000000000000u64) != 0u64):
        return "E0275"
    if ((pattern_hits.hi & 0x0002000000000000u64) != 0u64):
        return "E0405"
    if ((pattern_hits.hi & 0x0004000000000000u64) != 0u64):
        return "E0191"
    if ((pattern_hits.hi & 0x0008000000000000u64) != 0u64):
        return "E0271"
    # END GENERATED QUERY ERROR RULES

    # BEGIN GENERATED QUERY ERROR FALLBACKS
    # --- Strategy 3: fall back to generic code based on error_kind ---
    match error_kind:
        "TypeError": "E1003"
        "ParseError": "E0001"
        "BlockError": "E1601"
        "ResolveError": "E1013"
        "BorrowError": "E1303"
        "CodegenError": "E2001"
        "RuntimeError": "E3001"
        _: "E0000"
    # END GENERATED QUERY ERROR FALLBACKS

fn _query_has_error_code_prefix(s: text) -> bool:
    """Check for an E plus four ASCII digits at the byte prefix; suffixes are allowed."""
    if s.len() < 5 or s.byte_at(0) != 69:
        return false
    var i = 1
    while i < 5:
        val byte = s.byte_at(i)
        if byte < 48 or byte > 57:
            return false
        i = i + 1
    true
