# Shared query diagnostic error-code classifier.
# Keeps ordered, case-sensitive legacy inference in one cycle-free owner.
use app.cli.query_rich_common.{_find_in_line_from}
use app.cli.query_error_pattern_matcher.{query_error_pattern_hits, query_error_pattern_hit}

fn query_extract_error_code(msg: text, error_kind: text, codegen_phrase: text) -> text:
    """Extract an E-code from an error message or infer one from the error kind.

    Strategy:
    1. Check if the message already contains an explicit error code (e.g. error[E1001])
    2. Pattern-match common error message phrases to known E-codes
    3. Fall back to a generic code based on error_kind
    """
    # --- Strategy 1: explicit error code in message ---
    val bracket_idx = _find_in_line_from(msg, "[E", 0)
    if bracket_idx >= 0:
        val close_idx = _find_in_line_from(msg, "]", bracket_idx)
        if close_idx > bracket_idx + 1:
            return msg.substring(bracket_idx + 1, close_idx)

    # Check for "Exxxx:" at the start of the message
    if msg.len() >= 5 and msg.substring(0, 1) == "E":
        val maybe_code = msg.substring(0, 5)
        if _query_is_error_code(maybe_code):
            return maybe_code

    val pattern_hits = query_error_pattern_hits(msg)

    # --- Strategy 2: pattern-match message content to known E-codes ---
    # Semantic errors (E10xx)
    if (query_error_pattern_hit(pattern_hits, 0) or query_error_pattern_hit(pattern_hits, 1)) and query_error_pattern_hit(pattern_hits, 2):
        return "E1001"
    if (query_error_pattern_hit(pattern_hits, 3) or query_error_pattern_hit(pattern_hits, 4)) and query_error_pattern_hit(pattern_hits, 5):
        return "E1002"
    if query_error_pattern_hit(pattern_hits, 6) and query_error_pattern_hit(pattern_hits, 7):
        return "E1003"
    if query_error_pattern_hit(pattern_hits, 8) or query_error_pattern_hit(pattern_hits, 9):
        return "E1003"
    if query_error_pattern_hit(pattern_hits, 10) or query_error_pattern_hit(pattern_hits, 11):
        return "E1004"
    if query_error_pattern_hit(pattern_hits, 12):
        return "E1005"
    if query_error_pattern_hit(pattern_hits, 13):
        return "E1006"
    if query_error_pattern_hit(pattern_hits, 14) or query_error_pattern_hit(pattern_hits, 15):
        return "E1007"
    if query_error_pattern_hit(pattern_hits, 16) or query_error_pattern_hit(pattern_hits, 17):
        return "E1008"
    if query_error_pattern_hit(pattern_hits, 18) or query_error_pattern_hit(pattern_hits, 19):
        return "E1009"
    if query_error_pattern_hit(pattern_hits, 20) and query_error_pattern_hit(pattern_hits, 3):
        return "E1010"
    if query_error_pattern_hit(pattern_hits, 21) and query_error_pattern_hit(pattern_hits, 3) and not query_error_pattern_hit(pattern_hits, 5):
        return "E1011"
    if query_error_pattern_hit(pattern_hits, 22):
        return "E1012"
    if query_error_pattern_hit(pattern_hits, 23):
        return "E1013"
    if query_error_pattern_hit(pattern_hits, 24):
        return "E1014"
    if query_error_pattern_hit(pattern_hits, 25):
        return "E1015"
    if query_error_pattern_hit(pattern_hits, 26) and query_error_pattern_hit(pattern_hits, 27):
        return "E1020"
    if query_error_pattern_hit(pattern_hits, 28) and query_error_pattern_hit(pattern_hits, 29):
        return "E1021"
    if query_error_pattern_hit(pattern_hits, 30) and query_error_pattern_hit(pattern_hits, 31):
        return "E1025"
    if query_error_pattern_hit(pattern_hits, 28) and query_error_pattern_hit(pattern_hits, 32) and query_error_pattern_hit(pattern_hits, 31):
        return "E1031"
    if query_error_pattern_hit(pattern_hits, 33) and query_error_pattern_hit(pattern_hits, 34):
        return "E1032"
    if query_error_pattern_hit(pattern_hits, 35):
        return "E1034"
    if query_error_pattern_hit(pattern_hits, 36) and query_error_pattern_hit(pattern_hits, 37):
        return "E1046"
    if query_error_pattern_hit(pattern_hits, 38) or query_error_pattern_hit(pattern_hits, 39):
        return "E1048"
    if query_error_pattern_hit(pattern_hits, 40):
        return "E1068"

    # Control flow errors (E11xx / E1057)
    if query_error_pattern_hit(pattern_hits, 41) and query_error_pattern_hit(pattern_hits, 42) and query_error_pattern_hit(pattern_hits, 43):
        return "E1101"
    if query_error_pattern_hit(pattern_hits, 44) and query_error_pattern_hit(pattern_hits, 42) and query_error_pattern_hit(pattern_hits, 43):
        return "E1102"
    if query_error_pattern_hit(pattern_hits, 45) and query_error_pattern_hit(pattern_hits, 42) and query_error_pattern_hit(pattern_hits, 5):
        return "E1103"
    if query_error_pattern_hit(pattern_hits, 45) and query_error_pattern_hit(pattern_hits, 46):
        return "E1104"
    if query_error_pattern_hit(pattern_hits, 47) and query_error_pattern_hit(pattern_hits, 42) and query_error_pattern_hit(pattern_hits, 48):
        return "E1057"
    if query_error_pattern_hit(pattern_hits, 49) and query_error_pattern_hit(pattern_hits, 42) and query_error_pattern_hit(pattern_hits, 50):
        return "E1105"

    # Actor/concurrency errors (E12xx)
    if query_error_pattern_hit(pattern_hits, 51) and query_error_pattern_hit(pattern_hits, 52):
        return "E1201"
    if query_error_pattern_hit(pattern_hits, 51) and query_error_pattern_hit(pattern_hits, 53):
        return "E1202"
    if query_error_pattern_hit(pattern_hits, 54):
        return "E1203"
    if query_error_pattern_hit(pattern_hits, 55):
        return "E1204"

    # Capability errors (E13xx)
    if query_error_pattern_hit(pattern_hits, 56) and query_error_pattern_hit(pattern_hits, 57):
        return "E1301"
    if query_error_pattern_hit(pattern_hits, 58) and query_error_pattern_hit(pattern_hits, 57):
        return "E1302"
    if query_error_pattern_hit(pattern_hits, 59) and query_error_pattern_hit(pattern_hits, 57):
        return "E1303"

    # Macro errors (E14xx)
    if query_error_pattern_hit(pattern_hits, 60):
        return "E1401"
    if query_error_pattern_hit(pattern_hits, 61) and query_error_pattern_hit(pattern_hits, 62):
        return "E1402"
    if query_error_pattern_hit(pattern_hits, 61) and query_error_pattern_hit(pattern_hits, 63):
        return "E1401"

    # AOP errors (E15xx)
    if query_error_pattern_hit(pattern_hits, 64) and query_error_pattern_hit(pattern_hits, 65):
        return "E1501"
    if query_error_pattern_hit(pattern_hits, 66) and query_error_pattern_hit(pattern_hits, 67):
        return "E1502"
    if query_error_pattern_hit(pattern_hits, 68) and query_error_pattern_hit(pattern_hits, 69):
        return "E1503"
    if query_error_pattern_hit(pattern_hits, 70) and query_error_pattern_hit(pattern_hits, 71):
        return "E1505"
    if query_error_pattern_hit(pattern_hits, 72) and query_error_pattern_hit(pattern_hits, 73):
        return "E1506"

    # Mixin errors (E17xx)
    if query_error_pattern_hit(pattern_hits, 74) and query_error_pattern_hit(pattern_hits, 3):
        return "E1701"
    if query_error_pattern_hit(pattern_hits, 74) and query_error_pattern_hit(pattern_hits, 75):
        return "E1702"

    # Codegen errors (E20xx)
    if query_error_pattern_hit(pattern_hits, 76):
        return "E2001"
    if msg.contains(codegen_phrase):
        return "E2002"

    # Runtime errors (E30xx)
    if query_error_pattern_hit(pattern_hits, 77):
        return "E3001"
    if query_error_pattern_hit(pattern_hits, 78) and query_error_pattern_hit(pattern_hits, 79):
        return "E3002"
    if query_error_pattern_hit(pattern_hits, 80):
        return "E3003"
    if query_error_pattern_hit(pattern_hits, 81):
        return "E3004"

    # Method resolution special case
    if query_error_pattern_hit(pattern_hits, 82):
        return "E1013"

    # Type inference errors
    if query_error_pattern_hit(pattern_hits, 83) or query_error_pattern_hit(pattern_hits, 84):
        return "E0391"
    if query_error_pattern_hit(pattern_hits, 85) or query_error_pattern_hit(pattern_hits, 86):
        return "E0277"

    # Dimension constraint errors (E05xx from dim_constraints_types)
    if query_error_pattern_hit(pattern_hits, 87):
        return "E0501"
    if query_error_pattern_hit(pattern_hits, 88):
        return "E0502"
    if query_error_pattern_hit(pattern_hits, 89):
        return "E0503"
    if query_error_pattern_hit(pattern_hits, 90):
        return "E0504"
    if query_error_pattern_hit(pattern_hits, 91):
        return "E0505"
    if query_error_pattern_hit(pattern_hits, 92):
        return "E0506"
    if query_error_pattern_hit(pattern_hits, 93):
        return "E0507"
    if query_error_pattern_hit(pattern_hits, 94):
        return "E0508"

    # Borrow checking errors
    if query_error_pattern_hit(pattern_hits, 95) or query_error_pattern_hit(pattern_hits, 96):
        return "E0502"
    if query_error_pattern_hit(pattern_hits, 97) and query_error_pattern_hit(pattern_hits, 98):
        return "E0503"
    if query_error_pattern_hit(pattern_hits, 99) and query_error_pattern_hit(pattern_hits, 100):
        return "E0505"
    if query_error_pattern_hit(pattern_hits, 59) and query_error_pattern_hit(pattern_hits, 101):
        return "E0515"

    # Trait coherence errors
    if query_error_pattern_hit(pattern_hits, 102) and query_error_pattern_hit(pattern_hits, 103):
        return "E0117"
    if query_error_pattern_hit(pattern_hits, 104):
        return "E0119"
    if query_error_pattern_hit(pattern_hits, 105) and query_error_pattern_hit(pattern_hits, 106):
        return "E0119"
    if query_error_pattern_hit(pattern_hits, 107):
        return "E0271"

    # Trait validation errors
    if query_error_pattern_hit(pattern_hits, 108):
        return "E0283"
    if query_error_pattern_hit(pattern_hits, 109):
        return "E0119"
    if query_error_pattern_hit(pattern_hits, 110) and query_error_pattern_hit(pattern_hits, 111):
        return "E0046"
    if query_error_pattern_hit(pattern_hits, 112):
        return "E0275"
    if query_error_pattern_hit(pattern_hits, 113):
        return "E0405"
    if query_error_pattern_hit(pattern_hits, 114):
        return "E0191"
    if query_error_pattern_hit(pattern_hits, 115):
        return "E0271"

    # --- Strategy 3: fall back to generic code based on error_kind ---
    match error_kind:
        "TypeError": "E1003"
        "ParseError": "E0001"
        "BlockError": "E1601"
        "ResolveError": "E1013"
        "BorrowError": "E1303"
        "CodegenError": "E2001"
        "RuntimeError": "E3001"
        _: "E0000"

fn _query_is_error_code(s: text) -> bool:
    """Check if a string looks like an error code (E followed by 4 digits)."""
    if s.len() < 5:
        return false
    if s.substring(0, 1) != "E":
        return false
    var i = 1
    while i < 5:
        val ch = s.substring(i, i + 1)
        if ch < "0" or ch > "9":
            return false
        i = i + 1
    true
