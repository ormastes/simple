# Deterministic identity generator/checker for the structured CLI registry.
# Legacy help/table extractors below are migration-test oracles only. Neither
# production generation nor rendering reads the old print program.

use app.io.args_ops.{get_args}
use app.io.mod.{file_exists, file_read, file_write}
use std.common.crypto.sha256.{sha256_text}
use app.cli.command_registry.{
    cli_registry_command_names_v1,
    cli_registry_option_tokens_v1,
    cli_registry_payload_sha256_v1,
    cli_registry_structurally_valid_v1,
    cli_registry_provider_route_valid_v1,
}
use app.cli.dispatch.table.{get_all_commands}

val CLI_SURFACE_DISPATCH_SOURCE_V1: text = "src/app/cli/_CliMain/main_and_help.spl"
val CLI_SURFACE_HELP_SOURCE_V1: text = "src/app/cli/command_registry.spl"
val CLI_SURFACE_TABLE_SOURCE_V1: text = "src/app/cli/dispatch/table.spl"
val CLI_SURFACE_ARGS_SOURCE_V1: text = "src/app/cli/_CliMain/args_and_os_commands.spl"
val CLI_SURFACE_GENERATED_OUTPUT_V1: text = "src/app/cli/help_surface_generated_data.spl"

struct CliSurfaceCodegenCheckV1:
    ok: bool
    detail: text

fn _codegen_result_v1(ok: bool, detail: text) -> CliSurfaceCodegenCheckV1:
    CliSurfaceCodegenCheckV1(ok: ok, detail: detail)

fn _codegen_token_v1(token: text) -> bool:
    if token == "" or token.starts_with("-"):
        return false
    var i = 0
    while i < token.len():
        val ch = token.slice(i, i + 1)
        val ok = (ch >= "a" and ch <= "z") or
            (ch >= "0" and ch <= "9") or ch == "-"
        if not ok:
            return false
        i = i + 1
    true

fn _codegen_push_unique_v1(items: [text], value: text) -> [text]:
    if not items.contains(value):
        items.push(value)
    items

fn _codegen_sorted_v1(items: [text]) -> [text]:
    var pending: [text] = []
    for item in items:
        pending.push(item)
    var out: [text] = []
    while pending.len() > 0:
        var best = 0
        var j = 1
        while j < pending.len():
            if pending[j] < pending[best]:
                best = j
            j = j + 1
        out.push(pending[best])
        var rest: [text] = []
        var k = 0
        while k < pending.len():
            if k != best:
                rest.push(pending[k])
            k = k + 1
        pending = rest
    out

fn _codegen_extract_dispatch_needle_v1(
        source: text, needle: text, initial: [text]) -> [text]:
    var out = initial
    for line in source.split("\n"):
        var rest = line
        while true:
            val at = rest.index_of(needle)
            if at < 0:
                break
            rest = rest.substring(at + needle.len(), rest.len())
            val close = rest.index_of("\"")
            if close < 0:
                break
            val token = rest.substring(0, close)
            if _codegen_token_v1(token):
                out = _codegen_push_unique_v1(out, token)
            rest = rest.substring(close + 1, rest.len())
    out

fn cli_surface_codegen_extract_dispatch_v1(source: text) -> [text]:
    var out: [text] = []
    out = _codegen_extract_dispatch_needle_v1(source, "str_eq(first, \"", out)
    out = _codegen_extract_dispatch_needle_v1(source, "str_eq(args[0], \"", out)
    _codegen_sorted_v1(out)

# Test-only migration oracle for the retired handwritten print source.
fn cli_surface_codegen_extract_help_v1(source: text) -> [text]:
    var out: [text] = []
    val needle = "print \"  simple "
    for line in source.split("\n"):
        val stripped = line.trim()
        if stripped.starts_with(needle):
            val rest = stripped.substring(needle.len(), stripped.len())
            var token = rest
            val space = rest.index_of(" ")
            if space >= 0:
                token = rest.substring(0, space)
            if _codegen_token_v1(token):
                out = _codegen_push_unique_v1(out, token)
    _codegen_sorted_v1(out)

# Test-only migration oracle for retired literal CommandEntry tables.
fn cli_surface_codegen_extract_table_v1(source: text) -> [text]:
    var out: [text] = []
    val needle = "name: \""
    for line in source.split("\n"):
        val stripped = line.trim()
        if stripped.starts_with(needle):
            val rest = stripped.substring(needle.len(), stripped.len())
            val close = rest.index_of("\"")
            if close >= 0:
                val token = rest.substring(0, close)
                if _codegen_token_v1(token):
                    out = _codegen_push_unique_v1(out, token)
    _codegen_sorted_v1(out)

fn _codegen_between_v1(source: text, start: text, finish: text) -> text:
    val start_at = source.index_of(start)
    if start_at < 0:
        return ""
    val rest = source.substring(start_at, source.len())
    val finish_at = rest.index_of(finish)
    if finish_at < 0:
        return rest
    rest.substring(0, finish_at)

fn _codegen_extract_flag_needle_v1(
        source: text, needle: text, initial: [text]) -> [text]:
    var out = initial
    for line in source.split("\n"):
        var rest = line
        while true:
            val at = rest.index_of(needle)
            if at < 0:
                break
            rest = rest.substring(at + needle.len(), rest.len())
            val close = rest.index_of("\"")
            if close < 0:
                break
            var flag = rest.substring(0, close)
            if flag.ends_with("="):
                flag = flag.substring(0, flag.len() - 1)
            if flag.starts_with("--"):
                out = _codegen_push_unique_v1(out, flag)
            rest = rest.substring(close + 1, rest.len())
    out

fn cli_surface_codegen_extract_log_flags_v1(source: text) -> [text]:
    val body = _codegen_between_v1(
        source, "fn cli_is_log_option", "fn cli_clean_log_args")
    var out: [text] = []
    out = _codegen_extract_flag_needle_v1(body, "str_eq(arg, \"", out)
    out = _codegen_extract_flag_needle_v1(body, "arg.starts_with(\"", out)
    _codegen_sorted_v1(out)

fn cli_surface_codegen_extract_internal_flags_v1(source: text) -> [text]:
    val body = _codegen_between_v1(
        source, "fn parse_core_flags", "# Check SIMPLE_EXECUTION_MODE")
    var out: [text] = []
    out = _codegen_extract_flag_needle_v1(body, "arg == \"", out)
    out = _codegen_extract_flag_needle_v1(body, "arg.starts_with(\"", out)
    _codegen_sorted_v1(out)

fn _codegen_same_v1(left: [text], right: [text]) -> bool:
    if left.len() != right.len():
        return false
    var i = 0
    while i < left.len():
        if left[i] != right[i]:
            return false
        i = i + 1
    true

fn _codegen_generated_hash_v1(source: text, constant_name: text) -> text:
    val needle = "val " + constant_name + ": text = \""
    val at = source.index_of(needle)
    if at < 0:
        return ""
    val rest = source.substring(at + needle.len(), source.len())
    val close = rest.index_of("\"")
    if close < 0:
        return ""
    rest.substring(0, close)

fn _codegen_generation_id_v1(dispatch_source: text, registry_source: text,
        table_source: text, args_source: text, payload_hash: text) -> text:
    sha256_text(sha256_text(dispatch_source) + sha256_text(registry_source) +
        sha256_text(table_source) + sha256_text(args_source) + payload_hash)

fn _codegen_validate_canonical_inputs_v1(dispatch_source: text,
        args_source: text) -> CliSurfaceCodegenCheckV1:
    if not cli_registry_structurally_valid_v1():
        return _codegen_result_v1(false, "registry-invalid")
    val dispatch = cli_surface_codegen_extract_dispatch_v1(dispatch_source)
    val registry = _codegen_sorted_v1(cli_registry_command_names_v1())
    val table = _codegen_sorted_v1(get_all_commands())
    val log_flags = cli_surface_codegen_extract_log_flags_v1(dispatch_source)
    val internal_flags = cli_surface_codegen_extract_internal_flags_v1(args_source)
    if dispatch.len() == 0 or registry.len() == 0 or log_flags.len() == 0 or
            internal_flags.len() == 0:
        return _codegen_result_v1(false, "extraction-empty")
    if not _codegen_same_v1(dispatch, registry):
        return _codegen_result_v1(false, "dispatch-registry-drift")
    if not _codegen_same_v1(table, registry):
        return _codegen_result_v1(false, "table-registry-drift")
    if not _codegen_same_v1(log_flags, cli_registry_option_tokens_v1("log")):
        return _codegen_result_v1(false, "log-option-owner-drift")
    if not _codegen_same_v1(
            internal_flags, cli_registry_option_tokens_v1("runtime")):
        return _codegen_result_v1(false, "runtime-option-owner-drift")
    if not cli_registry_provider_route_valid_v1():
        return _codegen_result_v1(false, "provider-route-drift")
    _codegen_result_v1(true, "inputs-valid")

fn cli_surface_codegen_check_v1() -> CliSurfaceCodegenCheckV1:
    if not file_exists(CLI_SURFACE_DISPATCH_SOURCE_V1) or
            not file_exists(CLI_SURFACE_HELP_SOURCE_V1) or
            not file_exists(CLI_SURFACE_TABLE_SOURCE_V1) or
            not file_exists(CLI_SURFACE_ARGS_SOURCE_V1) or
            not file_exists(CLI_SURFACE_GENERATED_OUTPUT_V1):
        return _codegen_result_v1(false, "source-missing")
    val dispatch_source = file_read(CLI_SURFACE_DISPATCH_SOURCE_V1)
    val registry_source = file_read(CLI_SURFACE_HELP_SOURCE_V1)
    val table_source = file_read(CLI_SURFACE_TABLE_SOURCE_V1)
    val args_source = file_read(CLI_SURFACE_ARGS_SOURCE_V1)
    val generated_source = file_read(CLI_SURFACE_GENERATED_OUTPUT_V1)
    val validated = _codegen_validate_canonical_inputs_v1(
        dispatch_source, args_source)
    if not validated.ok:
        return validated
    val payload_hash = cli_registry_payload_sha256_v1()
    val generation_id = _codegen_generation_id_v1(
        dispatch_source, registry_source, table_source, args_source, payload_hash)
    if sha256_text(dispatch_source) != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_DISPATCH_SOURCE_SHA256_V1"):
        return _codegen_result_v1(false, "dispatch-hash-drift")
    if sha256_text(registry_source) != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_HELP_SOURCE_SHA256_V1"):
        return _codegen_result_v1(false, "registry-hash-drift")
    if sha256_text(table_source) != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_TABLE_SOURCE_SHA256_V1"):
        return _codegen_result_v1(false, "table-hash-drift")
    if sha256_text(args_source) != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_ARGS_SOURCE_SHA256_V1"):
        return _codegen_result_v1(false, "args-hash-drift")
    if payload_hash != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1"):
        return _codegen_result_v1(false, "payload-hash-drift")
    if generation_id != _codegen_generated_hash_v1(
            generated_source, "CLI_SURFACE_GENERATION_ID_V1"):
        return _codegen_result_v1(false, "generation-id-drift")
    _codegen_result_v1(true, "current")

fn cli_surface_codegen_render_v1(dispatch_source: text, registry_source: text,
        table_source: text, args_source: text) -> text:
    val payload_hash = cli_registry_payload_sha256_v1()
    var out = "# @generated identity receipt for the canonical structured CLI registry.\n"
    out = out + "# Contains hashes and registry projections, never copied help rows.\n\n"
    out = out + "use app.cli.command_registry.{\n"
    out = out + "    cli_registry_command_names_v1,\n"
    out = out + "    cli_registry_option_tokens_v1,\n"
    out = out + "    cli_registry_render_help_v1,\n}\n\n"
    out = out + "val CLI_SURFACE_DISPATCH_SOURCE_SHA256_V1: text = \"" + sha256_text(dispatch_source) + "\"\n"
    out = out + "val CLI_SURFACE_HELP_SOURCE_SHA256_V1: text = \"" + sha256_text(registry_source) + "\"\n"
    out = out + "val CLI_SURFACE_TABLE_SOURCE_SHA256_V1: text = \"" + sha256_text(table_source) + "\"\n"
    out = out + "val CLI_SURFACE_ARGS_SOURCE_SHA256_V1: text = \"" + sha256_text(args_source) + "\"\n"
    out = out + "val CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1: text = \"" + payload_hash + "\"\n"
    out = out + "val CLI_SURFACE_GENERATION_ID_V1: text = \"" +
        _codegen_generation_id_v1(dispatch_source, registry_source,
            table_source, args_source, payload_hash) + "\"\n\n"
    out = out + "fn cli_surface_generated_command_names_v1() -> [text]:\n    cli_registry_command_names_v1()\n\n"
    out = out + "fn cli_surface_generated_log_flags_v1() -> [text]:\n    cli_registry_option_tokens_v1(\"log\")\n\n"
    out = out + "fn cli_surface_generated_internal_flags_v1() -> [text]:\n    cli_registry_option_tokens_v1(\"runtime\")\n\n"
    out + "fn cli_surface_generated_help_lines_v1() -> [text]:\n    cli_registry_render_help_v1(\"1.0.0-RC\").split(\"\\n\")\n"

fn cli_surface_codegen_write_v1() -> CliSurfaceCodegenCheckV1:
    if not file_exists(CLI_SURFACE_DISPATCH_SOURCE_V1) or
            not file_exists(CLI_SURFACE_HELP_SOURCE_V1) or
            not file_exists(CLI_SURFACE_TABLE_SOURCE_V1) or
            not file_exists(CLI_SURFACE_ARGS_SOURCE_V1):
        return _codegen_result_v1(false, "source-missing")
    val dispatch_source = file_read(CLI_SURFACE_DISPATCH_SOURCE_V1)
    val registry_source = file_read(CLI_SURFACE_HELP_SOURCE_V1)
    val table_source = file_read(CLI_SURFACE_TABLE_SOURCE_V1)
    val args_source = file_read(CLI_SURFACE_ARGS_SOURCE_V1)
    val validated = _codegen_validate_canonical_inputs_v1(
        dispatch_source, args_source)
    if not validated.ok:
        return validated
    val rendered = cli_surface_codegen_render_v1(
        dispatch_source, registry_source, table_source, args_source)
    if not file_write(CLI_SURFACE_GENERATED_OUTPUT_V1, rendered):
        return _codegen_result_v1(false, "write-failed")
    _codegen_result_v1(true, "written")

fn main() -> i64:
    val args = get_args()
    val result = if args.contains("--write"):
        cli_surface_codegen_write_v1()
    else:
        cli_surface_codegen_check_v1()
    if result.ok:
        print "cli_help_surface_codegen=PASS detail={result.detail}"
        return 0
    print "cli_help_surface_codegen=FAIL detail={result.detail}"
    1
