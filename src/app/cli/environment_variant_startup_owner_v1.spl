# Application-facing lifecycle owner for the compiler environment-variant
# startup port. It receives an already-collected policy request and delegates
# all authority validation to the loader owner; it performs no policy lookup.

use compiler.common.structural_contracts.environment_variant_startup_port_v1.*
use compiler.loader.environment_variant_startup_binding_v1.*
use compiler.driver.driver.{CompilerDriver,
    compiler_driver_apply_environment_variant_startup_v1}

pub class AppEnvironmentVariantStartupOwnerV1:
    var loader: EnvironmentVariantStartupOwnerV1
    var active: EnvironmentVariantStartupHandleV1?

    pub static fn create() -> AppEnvironmentVariantStartupOwnerV1:
        AppEnvironmentVariantStartupOwnerV1(
            loader: EnvironmentVariantStartupOwnerV1.create(), active: nil)

pub fn app_environment_variant_startup_set_candidate_v1(
    owner: AppEnvironmentVariantStartupOwnerV1,
    context: FrontendLexicalAdvisoryBindingContextV1
) -> Result<(), EnvironmentVariantStartupErrorV1>:
    environment_variant_startup_set_candidate_v1(owner.loader, context)

pub fn app_environment_variant_startup_open_v1(
    owner: AppEnvironmentVariantStartupOwnerV1,
    request: EnvironmentVariantStartupRequestV1
) -> Result<EnvironmentVariantStartupReceiptV1, EnvironmentVariantStartupErrorV1>:
    if owner.active.?: return Err(EnvironmentVariantStartupErrorV1.Busy)
    val opened = environment_variant_startup_open_v1(owner.loader, request)?
    owner.active = Some(opened.0)
    Ok(opened.1)

pub fn app_environment_variant_startup_open_driver_v1(
    owner: AppEnvironmentVariantStartupOwnerV1,
    request: EnvironmentVariantStartupRequestV1,
    driver: CompilerDriver
) -> Result<EnvironmentVariantStartupReceiptV1, EnvironmentVariantStartupErrorV1>:
    val receipt = app_environment_variant_startup_open_v1(owner, request)?
    if not app_environment_variant_startup_validate_v1(owner) or
       compiler_driver_apply_environment_variant_startup_v1(
            driver, request, receipt).is_err():
        if app_environment_variant_startup_close_v1(owner).is_err():
            return Err(EnvironmentVariantStartupErrorV1.CleanupFailed)
        return Err(EnvironmentVariantStartupErrorV1.InvalidRequest)
    Ok(receipt)

pub fn app_environment_variant_startup_validate_v1(
    owner: AppEnvironmentVariantStartupOwnerV1
) -> bool:
    match owner.active:
        Some(handle): environment_variant_startup_validate_v1(owner.loader, handle)
        nil: false

pub fn app_environment_variant_startup_close_v1(
    owner: AppEnvironmentVariantStartupOwnerV1
) -> Result<(), EnvironmentVariantStartupErrorV1>:
    match owner.active:
        Some(handle):
            environment_variant_startup_close_v1(owner.loader, handle)?
            owner.active = nil
            Ok(())
        nil: Err(EnvironmentVariantStartupErrorV1.AlreadyClosed)
