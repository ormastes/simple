# Simple Language - Unified CLI (Written in Simple)
#
# This is the main entry point for the Simple CLI, written in Simple itself.
# Most functionality is implemented in Simple; SFFI is only used for runtime operations.
#
# Usage like Python:
#   simple              - Start interactive REPL
#   simple file.spl     - Run source file
#   simple file.smf     - Run compiled binary
#   simple -c "code"    - Run code string

# Bootstrap helper: avoid undefined 'code' symbol during minimal semantic pass

# Split from src/app/cli/main.spl to keep module cohesion under the 800-line source limit.
export use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
export use app.cli._CliMain.args_and_os_commands.{run_dashboard, run_llm_dashboard, arg_is_cli_entry_script, copy_cli_args_from, get_cli_args, get_version, print_version, print_targets, print_linkers, print_error, print_error_with_help, run_lex_command, GlobalFlags, CoreFlags, BackendFlags, LimitFlags, parse_cli_nonnegative_or_default, parse_core_flags, parse_backend_flags, parse_limit_flags, parse_global_flags, apply_fault_detection, handle_os_build_inline, handle_os_inline}
export use app.cli._CliMain.main_and_help.{str_eq, apply_jit_env_vars, mem_infra_effective_backend, apply_mem_infra_env_assignment, apply_mem_infra_flags, run_native_build_bootstrap, native_build_backend_supported, native_build_requests_simple_llvm, cli_log_options_help, cli_print_help_with_progress, CLI_STATIC_FAST_PATH_NONE, CLI_STATIC_FAST_PATH_HELP, CLI_STATIC_FAST_PATH_VERSION, cli_static_fast_path_kind, cli_is_log_option, cli_clean_log_args, filter_internal_flags, activate_required_child_coverage_apk, cli_interpreter_main, cli_main_with_execution_mode, CLI_USAGE_ERROR_EXIT_CODE, cli_dispatch_fallthrough_exit_code}

# The entry module must define `main` itself. The flattened module graph
# co-compiles sibling app modules that also define `main` (app.ide.main,
# app.play.main, ...), and the tree-walk interpreter binds `main` by
# first registration in flattened item order: when the entry only re-exported
# `main` via `export use`, an imported module's `main` won the binding and the
# cli app "ran" the wrong entry (silent exit 0, no command executed). See
# doc/08_tracking/bug/cli_app_child_process_hang_2026-11-12.md.
fn main() -> i64:
    cli_main_with_execution_mode(false)
