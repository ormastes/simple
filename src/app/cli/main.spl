# Simple Language - Unified CLI (Written in Simple)
#
# This is the main entry point for the Simple CLI, written in Simple itself.
# Most functionality is implemented in Simple; SFFI is only used for runtime operations.
#
# Usage like Python:
#   simple              - Start interactive REPL
#   simple file.spl     - Run source file
#   simple file.smf     - Run compiled binary
#   simple -c "code"    - Run code string

# Bootstrap helper: avoid undefined 'code' symbol during minimal semantic pass

# Split from src/app/cli/main.spl to keep module cohesion under the 800-line source limit.
export use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
export use app.cli._CliMain.args_and_os_commands.*
export use app.cli._CliMain.main_and_help.*

# The entry module must define `main` itself. The flattened module graph
# co-compiles sibling app modules that also define `main` (app.ide.main,
# app.play.main, ...), and the tree-walk interpreter binds `main` by
# first registration in flattened item order: when the entry only re-exported
# `main` via `export use`, an imported module's `main` won the binding and the
# cli app "ran" the wrong entry (silent exit 0, no command executed). See
# doc/08_tracking/bug/cli_app_child_process_hang_2026-11-12.md.
fn main() -> i64:
    cli_main_with_execution_mode(false)
