# Coordinator admission only; this does not terminate or reap workers.
# Unconfirmed retirement forbids both successful continuation and fallback.
pub fn native_build_hir_warmup_outcome_v1(aggregate_code: i64, all_stopped: bool) -> text:
    if not all_stopped:
        return "fail"
    if aggregate_code == 0:
        return "ready"
    "fallback"

export native_build_hir_warmup_outcome_v1
