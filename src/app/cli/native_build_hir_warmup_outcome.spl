# Coordinator admission only; this does not terminate or reap workers.
# Unconfirmed retirement forbids both successful continuation and fallback.
pub fn native_build_hir_warmup_outcome_v1(aggregate_code: i64, all_stopped: bool) -> text:
    if not all_stopped:
        return "fail"
    if aggregate_code == 0:
        return "ready"
    "fallback"

# The bootstrap capsule hands over `native-build <args>`; the HIR profile and
# the internal worker take the user args after the subcommand.
pub fn native_build_capsule_user_args_v1(args: [text]) -> [text]:
    if args.len() > 0 and args[0] == "native-build":
        return args[1:]
    args

# Tool-build coordinator (native_build_main.spl). A pool refused before any
# worker started (profile admission, worker route, owner bound or ledger set-up)
# left no claim, ledger row or cache entry, and the pool only warms the HIR
# cache: the final worker lowers HIR serially in process. A pool that started
# and then failed stays fatal (bootstrap-fable-17, 2026-11-12).
pub fn native_build_hir_refusal_runs_serial_v1(code: i64, refused_before_spawn: bool) -> bool:
    code != 0 and refused_before_spawn

export native_build_hir_warmup_outcome_v1, native_build_capsule_user_args_v1,
    native_build_hir_refusal_runs_serial_v1
