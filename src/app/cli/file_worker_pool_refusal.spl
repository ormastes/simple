# Per-file worker pool fail-closed refusal and its admission arithmetic. The
# decisions are pure so a spec can drive them on any host; the few live probes
# (host memory, the running image's pointer width) are thin wrappers over them.
# "" = admitted (>= 2 workers fit); otherwise the stderr error text naming the
# cause: HIR sharding disabled (hir_disabled_by names the switch), a single
# requested worker (threads <= 1), or memory (usable memory is 60% of free, so
# 2 workers need 2 * budget / 0.6 free; the guarded parallel floor,
# shard_threads_guarded_floor_v1, instead needs 2 * budget + the coordinator
# base inside an ENFORCING tree RSS cap -- both figures are named).
use app.cli.shard_mem_clamp.{SHARD_FLOOR_UNKNOWN_PARENT_KB_V1, SHARD_MIR_WORKER_KB_V1,
    SHARD_MIR_WORKER_FLOOR_KB_V1, SHARD_MIR_WORKER_PER_MODULE_KB_V1, SHARD_HIR_WORKER_KB_V1,
    shard_worker_budget_kb, shard_mem_available_kb, shard_mem_available_kb_from_field,
    shard_host_worker_budget_kb, shard_cgroup_memory_max_kb, shard_tree_budget_kb_for}
use app.io.env_ops.{env_get}
use app.io.process_ops.{process_run_timeout}
use app.io.cli_ops.{cli_kernel_executable_path}
use std.nogc_sync_mut.host_limits.{host_limit_value}

val FILE_WORKER_POOL_I64_MAX_V1: i64 = 9223372036854775807

# Pointer width this module was compiled for (`@when(arch=...)`). Only a
# FALLBACK for the host width: under source/interpreted execution the cfg
# follows SIMPLE_NATIVE_BUILD_TARGET, which a cross-build exports to itself and
# every child, so it can name the cross target instead of this host.
@when(arch="x86"):
pub const FILE_WORKER_POOL_CFG_POINTER_BITS_V1: i64 = 32
@else:
@when(arch="arm"):
pub const FILE_WORKER_POOL_CFG_POINTER_BITS_V1: i64 = 32
@else:
@when(arch="riscv32"):
pub const FILE_WORKER_POOL_CFG_POINTER_BITS_V1: i64 = 32
@else:
pub const FILE_WORKER_POOL_CFG_POINTER_BITS_V1: i64 = 64
@end
@end
@end

# The most a 32-bit worker process can ever address: 4 GiB under a 64-bit
# kernel's compat mode (3 GiB on a native i686/armv7/riscv32 kernel). The
# larger figure is the safe one for admission: clamping lowers each worker's
# reservation, so the clamp must never go below what a worker can really use.
pub const FILE_WORKER_POOL_ADDR32_KIB_V1: i64 = 4194304

# Per-process address-space bound in KiB: 32-bit -> 4 GiB, 64-bit -> 0 (no
# bound below any host memory figure), any other width -> -1 (unknown).
pub fn file_worker_pool_address_space_kib_v1(pointer_bits: i64) -> i64:
    if pointer_bits == 32: return FILE_WORKER_POOL_ADDR32_KIB_V1
    if pointer_bits == 64: return 0
    return -1

# A worker cannot use more memory than it can address, so on a 32-bit host the
# per-worker reservation is min(budget, 4 GiB): 9 GB defaults otherwise admit
# no second worker on any 32-bit host. 64-bit budgets are returned unchanged,
# and an unknown width or an unknown (<= 0) budget is never lowered.
pub fn file_worker_pool_addressable_budget_kb_v1(budget_kb: i64, pointer_bits: i64) -> i64:
    val space_kb = file_worker_pool_address_space_kib_v1(pointer_bits)
    if space_kb > 0 and budget_kb > space_kb: return space_kb
    return budget_kb

# Closure-scaled MIR price = clamp(PER_MODULE x modules, FLOOR, CEILING), with
# unknown size (< 0) at the ceiling (constants and rationale:
# shard_mem_clamp.spl, SHARD_MIR_WORKER_*). The module count is compared
# before multiplying: a product past i64 used to wrap negative and price the
# closure at the FLOOR (fail-open).
pub fn file_worker_pool_mir_price_kb_v1(modules: i64) -> i64:
    if modules < 0: return SHARD_MIR_WORKER_KB_V1
    if modules > SHARD_MIR_WORKER_KB_V1 / SHARD_MIR_WORKER_PER_MODULE_KB_V1: return SHARD_MIR_WORKER_KB_V1
    val scaled = SHARD_MIR_WORKER_PER_MODULE_KB_V1 * modules
    if scaled < SHARD_MIR_WORKER_FLOOR_KB_V1: return SHARD_MIR_WORKER_FLOOR_KB_V1
    return scaled

# ===== scale-to-host default budget (user decision 2026-11-13) ===============
# Lowest default per-worker budget: 6.5 GiB. The measured per-file worker
# (HIR+MIR in one process) peaked at 5.04-5.65 GiB (2026-10-27, see
# SHARD_HIR_WORKER_KB_V1); HIR workers at 5.3-6.3 GiB (2026-10-25). 6.5 GiB is
# that peak plus a ~15% margin.
pub const FILE_WORKER_POOL_SCALED_FLOOR_KB_V1: i64 = 6815744

# Memory the workers may use: 60% of the tighter of host free memory and the
# enclosing tree budget (the same 60/40 split as shard_threads_cap_for),
# divided first so no i64 input overflows. Unknown (<= 0) on both sides is 0.
pub fn file_worker_pool_usable_kb_v1(avail_kb: i64, tree_kb: i64) -> i64:
    var base = avail_kb
    if tree_kb > 0 and (base <= 0 or tree_kb < base): base = tree_kb
    if base <= 0: return 0
    return (base / 10) * 6 + ((base % 10) * 6) / 10

# A valid phase env value (SIMPLE_HIR/MIR_SHARD_WORKER_KB) or the host config
# key worker_mem_mib is an explicit override; explicit budgets are never scaled.
pub fn file_worker_pool_budget_explicit_v1(env_field: text, host_mib_field: text) -> bool:
    return shard_mem_available_kb_from_field(env_field) > 0 or shard_host_worker_budget_kb(host_mib_field) > 0

# Scale to host: when 2 workers fit at the 9 GB default, the budget is
# unchanged (big hosts behave exactly as before). Otherwise it drops toward
# usable / 2 -- the largest budget that still admits 2 workers -- but never
# below FILE_WORKER_POOL_SCALED_FLOOR_KB_V1; a host where even the floor does
# not fit 2 workers is refused by admission, not priced lower. Never raises a
# budget, and an explicit, unknown or non-positive input is returned as is.
pub fn file_worker_pool_scaled_budget_kb_v1(budget_kb: i64, usable_kb: i64, explicit: bool) -> i64:
    if explicit or budget_kb <= 0 or usable_kb <= 0: return budget_kb
    val half = usable_kb / 2
    if half >= SHARD_HIR_WORKER_KB_V1: return budget_kb
    var target = FILE_WORKER_POOL_SCALED_FLOOR_KB_V1
    if half > target: target = half
    if target < budget_kb: return target
    return budget_kb

# One phase budget: scale to host, then the address-space clamp (a 32-bit
# worker can address 4 GiB, below the floor, so the clamp binds there).
pub fn file_worker_pool_phase_budget_kb_v1(budget_kb: i64, explicit: bool, usable_kb: i64, pointer_bits: i64) -> i64:
    return file_worker_pool_addressable_budget_kb_v1(file_worker_pool_scaled_budget_kb_v1(budget_kb, usable_kb, explicit), pointer_bits)

# Live usable memory for the pool: host MemAvailable unless SIMPLE_SHARD_MEM_CLAMP=0,
# bounded by the declared tree budget and the enclosing cgroup memory.max.
pub fn file_worker_pool_live_usable_kb_v1() -> i64:
    val avail_kb = if (env_get("SIMPLE_SHARD_MEM_CLAMP") ?? "") != "0": shard_mem_available_kb() else: 0
    val declared_kb = shard_mem_available_kb_from_field(env_get("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB") ?? "")
    return file_worker_pool_usable_kb_v1(avail_kb, shard_tree_budget_kb_for(declared_kb, shard_cgroup_memory_max_kb()))

# Live HIR per-worker budget (override > host worker_mem_mib > scaled 9 GB default).
pub fn file_worker_pool_hir_budget_kb_v1() -> i64:
    val explicit = file_worker_pool_budget_explicit_v1(env_get("SIMPLE_HIR_SHARD_WORKER_KB") ?? "", host_limit_value("worker_mem_mib"))
    val budget = shard_worker_budget_kb("SIMPLE_HIR_SHARD_WORKER_KB", SHARD_HIR_WORKER_KB_V1)
    return file_worker_pool_phase_budget_kb_v1(budget, explicit, file_worker_pool_live_usable_kb_v1(), file_worker_pool_host_pointer_bits_v1())

# Live MIR per-worker budget for a closure of `modules`. `scale` is true only
# for the per-file pool, whose worker peak is the measured 5.04-5.65 GiB; a MIR
# SHARD worker holds the whole-program HIR (24-25 GiB measured, run 11), so the
# shard path keeps the closure price and only takes the address-space clamp.
pub fn file_worker_pool_mir_budget_kb_v1(modules: i64, scale: bool) -> i64:
    val explicit = file_worker_pool_budget_explicit_v1(env_get("SIMPLE_MIR_SHARD_WORKER_KB") ?? "", host_limit_value("worker_mem_mib"))
    val budget = shard_worker_budget_kb("SIMPLE_MIR_SHARD_WORKER_KB", file_worker_pool_mir_price_kb_v1(modules))
    val usable_kb = if scale: file_worker_pool_live_usable_kb_v1() else: 0
    return file_worker_pool_phase_budget_kb_v1(budget, explicit, usable_kb, file_worker_pool_host_pointer_bits_v1())

# ===== host pointer width ====================================================
# The width of the RUNNING image, never the cfg target: an interpreted
# coordinator cross-building to i686 would otherwise clamp its own 64-bit
# workers to 4 GiB and over-admit. Never `uname -m` either: a 32-bit userland
# on a 64-bit kernel reports x86_64.

# ELF EI_CLASS from `od -An -tu1 -N5` of the image: 1 -> 32, 2 -> 64; anything
# else (not ELF, short read, Mach-O, PE) is unknown (-1).
pub fn file_worker_pool_pointer_bits_from_elf_header_v1(od_output: text) -> i64:
    var fields: [text] = []
    for part in od_output.trim().split(" "):
        if part.trim() != "": fields = fields.push(part.trim())
    if fields.len() < 5: return -1
    if fields[0] != "127" or fields[1] != "69" or fields[2] != "76" or fields[3] != "70": return -1
    if fields[4] == "1": return 32
    if fields[4] == "2": return 64
    return -1

# Windows sets PROCESSOR_ARCHITECTURE per process: a 32-bit process under
# WOW64 sees "x86" even on a 64-bit OS.
pub fn file_worker_pool_pointer_bits_from_windows_arch_v1(arch: text) -> i64:
    val name = arch.trim().lower()
    if name == "x86": return 32
    if name == "amd64" or name == "arm64": return 64
    return -1

# Image first, then the Windows process variable, then the compiled cfg width
# only while no cross target is exported (cfg_overridden); otherwise unknown,
# which leaves every budget unclamped (never lowers a reservation).
pub fn file_worker_pool_host_pointer_bits_for_v1(image_bits: i64, windows_bits: i64, cfg_bits: i64, cfg_overridden: bool) -> i64:
    if image_bits == 32 or image_bits == 64: return image_bits
    if windows_bits == 32 or windows_bits == 64: return windows_bits
    if not cfg_overridden: return cfg_bits
    return -1

pub fn file_worker_pool_probe_pointer_bits_v1(exe_path: text) -> i64:
    var header = ""
    if exe_path != "":
        val (out, _err, code) = process_run_timeout("od", ["-An", "-tu1", "-N5", exe_path], 2000)
        if code == 0: header = out
    val overridden = (env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? "") != "" or (env_get("SIMPLE_TARGET_ARCH") ?? "") != ""
    return file_worker_pool_host_pointer_bits_for_v1(file_worker_pool_pointer_bits_from_elf_header_v1(header),
        file_worker_pool_pointer_bits_from_windows_arch_v1(env_get("PROCESSOR_ARCHITECTURE") ?? ""),
        FILE_WORKER_POOL_CFG_POINTER_BITS_V1, overridden)

# Process-lifetime cache: the running image never changes.
var _file_worker_pool_host_bits_v1: i64 = 0

pub fn file_worker_pool_host_pointer_bits_v1() -> i64:
    if _file_worker_pool_host_bits_v1 == 0:
        _file_worker_pool_host_bits_v1 = file_worker_pool_probe_pointer_bits_v1(cli_kernel_executable_path())
    return _file_worker_pool_host_bits_v1

# Saturating non-negative arithmetic for the refusal figures (a, b >= 0, k > 0).
fn file_worker_pool_sat_mul_v1(a: i64, k: i64) -> i64:
    if a > FILE_WORKER_POOL_I64_MAX_V1 / k: return FILE_WORKER_POOL_I64_MAX_V1
    return a * k

fn file_worker_pool_sat_add_v1(a: i64, b: i64) -> i64:
    if a > FILE_WORKER_POOL_I64_MAX_V1 - b: return FILE_WORKER_POOL_I64_MAX_V1
    return a + b

pub fn file_worker_pool_refusal_v1(hir_count: i64, mir_parallel: i64, avail_kb: i64,
        hir_budget_kb: i64, mir_budget_kb: i64, threads: i64 = 2, hir_disabled_by: text = "",
        clamp_limited: bool = false, pointer_bits: i64 = -1) -> text:
    val parallel = if hir_count < mir_parallel: hir_count else: mir_parallel
    if parallel > 1:
        return ""
    val hir_kb = file_worker_pool_addressable_budget_kb_v1(hir_budget_kb, pointer_bits)
    val mir_kb = file_worker_pool_addressable_budget_kb_v1(mir_budget_kb, pointer_bits)
    val larger = if hir_kb > mir_kb: hir_kb else: mir_kb
    val budget = if larger > 0: larger else: 0
    # need = round(2 * budget / 0.6) = (20 * budget + 5) / 6, divided first:
    # budget = 3q + r gives 10q + (20r + 5) / 6 exactly, saturating at i64 max.
    val needed_kb = file_worker_pool_sat_add_v1(file_worker_pool_sat_mul_v1(budget / 3, 10), ((budget % 3) * 20 + 5) / 6)
    val floor_kb = file_worker_pool_sat_add_v1(file_worker_pool_sat_mul_v1(budget, 2), SHARD_FLOOR_UNKNOWN_PARENT_KB_V1)
    var causes: [text] = []
    if hir_count < 2 and hir_disabled_by != "":
        causes = causes.push("HIR sharding is disabled by {hir_disabled_by}")
    if threads <= 1:
        causes = causes.push("only {threads} worker was requested (--threads / SIMPLE_NATIVE_BUILD_THREADS)")
    var memory_note = ""
    if causes.len() == 0:
        var mem_cause = "not enough free memory for 2 workers"
        if clamp_limited:
            mem_cause = "{mem_cause} (tree-budget clamp: effective budget = min(declared, cap, host-free - reserve; unknown host-free uses cap - reserve; reserve = SIMPLE_BUILD_MEMORY_RESERVE_BYTES, else host mem_reserve_free_mib, else 24 GiB), workers = floor(effective / per-worker estimate))"
        causes = causes.push(mem_cause)
        memory_note = " Free memory={avail_kb} kB, per-worker budget={budget} kB (HIR {hir_kb} kB, MIR {mir_kb} kB), need >= {needed_kb} kB free, or a guarded floor of 2 x {budget} kB + {SHARD_FLOOR_UNKNOWN_PARENT_KB_V1} kB coordinator = {floor_kb} kB inside an enforcing tree RSS cap. Default budgets are already scaled to this host (floor {FILE_WORKER_POOL_SCALED_FLOOR_KB_V1} kB); override them with SIMPLE_MIR_SHARD_WORKER_KB / SIMPLE_HIR_SHARD_WORKER_KB or the host config key worker_mem_mib (SIMPLE_HOST_WORKER_MEM_MIB)."
        if pointer_bits == 32:
            memory_note = "{memory_note} 32-bit host: per-worker budgets are clamped to the {FILE_WORKER_POOL_ADDR32_KIB_V1} kB a 32-bit worker can address; a workload whose worker peak exceeds that (the full compiler's does) cannot run here -- cross-compile from a 64-bit host with --target."
    var cause_text = ""
    for c in causes:
        cause_text = if cause_text == "": c else: "{cause_text}; {c}"
    return "error: per-file worker pool refused (hir_workers={hir_count} mir_workers={mir_parallel}, need >= 2): {cause_text}.{memory_note} No fallback to the two-pass or in-process whole-program build; set SIMPLE_BOOTSTRAP_WHOLE_PROGRAM=1 for the explicit single-process build."
