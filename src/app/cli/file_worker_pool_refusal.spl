# Per-file worker pool fail-closed refusal. Pure so a spec can drive it.
# "" = admitted (>= 2 workers fit); otherwise the stderr error text. The pool
# needs >= 2 workers of the larger per-worker budget; usable memory is 60% of
# free (shard_threads_cap_for), so the needed free amount is 2 * budget / 0.6.
pub fn file_worker_pool_refusal_v1(hir_count: i64, mir_parallel: i64, avail_kb: i64,
        hir_budget_kb: i64, mir_budget_kb: i64) -> text:
    val parallel = if hir_count < mir_parallel: hir_count else: mir_parallel
    if parallel > 1:
        return ""
    val budget = if hir_budget_kb > mir_budget_kb: hir_budget_kb else: mir_budget_kb
    val needed_kb = (budget * 2 * 10 + 5) / 6
    "error: per-file worker pool refused (hir_workers={hir_count} mir_workers={mir_parallel}, need >= 2): free memory={avail_kb} kB, per-worker budget={budget} kB (HIR {hir_budget_kb} kB, MIR {mir_budget_kb} kB), need >= {needed_kb} kB free for 2 workers. No fallback to the two-pass or in-process whole-program build. Override the budgets with SIMPLE_MIR_SHARD_WORKER_KB / SIMPLE_HIR_SHARD_WORKER_KB, or set SIMPLE_BOOTSTRAP_WHOLE_PROGRAM=1 for the explicit single-process build."
