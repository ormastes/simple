"""Read-only configured compiler-reference command; no edit/redirect admission."""
use app.io.mod.{file_read_regular_no_follow_bounded}
use std.common.sdn.parser.{parse_untrusted, parse_with_issues}
use std.common.sdn.value.{SdnValue}
use std.common.json.value.{JsonValue, json_value_serialize}
use compiler.driver.driver_rename_references_v1.{RenameReferenceConfiguredFileV1, RenameReferenceLimitsV1, RenameReferenceRequestV1, RenameReferenceSnapshotV1, driver_collect_rename_references_v1}

fn reference_failure_json_v1(category: text, message: text) -> text:
    json_value_serialize(JsonValue.Object(["kind", "category", "message"], [
        JsonValue.Str("resolved-reference-failure-v1"), JsonValue.Str(category), JsonValue.Str(message)]))

fn reference_exact_fields_v1(value: SdnValue, fields: [text]) -> Result<bool, text>:
    val mapping = value.as_dict() ?? return Err("expected configuration mapping")
    if mapping.len() != fields.len():
        return Err("missing or unexpected configuration field")
    for key in fields:
        if not mapping.contains_key(key):
            return Err("missing configuration field: " + key)
    Ok(true)

fn reference_required_text_v1(value: SdnValue, field: text) -> Result<text, text>:
    val item = value.get(field) ?? return Err("missing field: " + field)
    val result = item.as_str() ?? return Err("expected text field: " + field)
    if result == "" or result.contains("\0"):
        return Err("empty or NUL-bearing field: " + field)
    Ok(result)

fn reference_required_limit_v1(value: SdnValue, field: text) -> Result<i64, text>:
    val item = value.get(field) ?? return Err("missing limit: " + field)
    val number = item.as_i64() ?? return Err("expected integer limit: " + field)
    if number <= 0:
        return Err("limit must be positive: " + field)
    Ok(number)

fn reference_request_from_manifest_v1(source: text, file: text, line: i64, column: i64) -> Result<RenameReferenceRequestV1, text>:
    # Harden structural limits before collecting duplicate-key diagnostics.
    # The existing SDN API exposes these separately; both operations are once
    # per bounded configuration, never per source reference or warm lookup.
    val bounded = parse_untrusted(source)?
    val (manifest, issues) = parse_with_issues(source)?
    if issues.len() != 0:
        return Err("configuration has duplicate or ambiguous SDN fields")
    reference_exact_fields_v1(bounded, ["version", "workspace_root", "source_roots", "files", "limits"])?
    val version_value = manifest.get("version") ?? return Err("missing manifest version")
    if version_value.as_i64() != Some(1):
        return Err("identity manifest version must be 1")
    val workspace_root = reference_required_text_v1(manifest, "workspace_root")?
    val root_values = manifest.get("source_roots") ?? return Err("missing source_roots")
    val root_array = root_values.as_array() ?? return Err("source_roots must be an array")
    var roots: [text] = []
    for item in root_array:
        val root = item.as_str() ?? return Err("source root must be text")
        roots.push(root)
    val limit_value = manifest.get("limits") ?? return Err("missing limits")
    reference_exact_fields_v1(limit_value, ["max_files", "max_total_bytes", "max_nodes", "max_references", "max_inventory_entries"])?
    val limits = RenameReferenceLimitsV1(max_files: reference_required_limit_v1(limit_value, "max_files")?,
        max_total_bytes: reference_required_limit_v1(limit_value, "max_total_bytes")?,
        max_nodes: reference_required_limit_v1(limit_value, "max_nodes")?,
        max_references: reference_required_limit_v1(limit_value, "max_references")?,
        max_inventory_entries: reference_required_limit_v1(limit_value, "max_inventory_entries")?)
    val file_values = manifest.get("files") ?? return Err("missing files")
    val file_array = file_values.as_array() ?? return Err("files must be an array")
    if file_array.len() > limits.max_files:
        return Err("configured file count exceeds limit")
    var files: [RenameReferenceConfiguredFileV1] = []
    for item in file_array:
        reference_exact_fields_v1(item, ["package", "module_path", "file", "revision_sha256"])?
        files.push(RenameReferenceConfiguredFileV1(package: reference_required_text_v1(item, "package")?,
            module_path: reference_required_text_v1(item, "module_path")?,
            file: reference_required_text_v1(item, "file")?,
            revision_sha256: reference_required_text_v1(item, "revision_sha256")?))
    Ok(RenameReferenceRequestV1(workspace_root: workspace_root, source_roots: roots, files: files,
        selection_file: file, line: line, column: column, limits: limits))

fn reference_positive_argument_v1(value: text) -> Result<i64, text>:
    if value == "" or value.len() > 18:
        return Err("line and column must be positive decimal integers")
    for ch in value.chars():
        if ch < "0" or ch > "9":
            return Err("line and column must be positive decimal integers")
    val number = value.to_int() ?? 0
    if number <= 0:
        return Err("line and column must be positive decimal integers")
    Ok(number)

fn reference_command_request_v1(cmd_args: [text]) -> Result<RenameReferenceRequestV1, text>:
    var flags: Dict<text, text> = {}
    var enabled = false
    var position = 0
    if cmd_args.len() > 0 and cmd_args[0] == "rename":
        position = 1
    while position < cmd_args.len():
        val flag = cmd_args[position]
        if flag == "--apply":
            return Err("--resolved-references is read-only; --apply is refused")
        if flag == "--resolved-references":
            if enabled:
                return Err("duplicate --resolved-references")
            enabled = true
            position = position + 1
            continue
        if flag != "--identity-manifest" and flag != "--file" and flag != "--line" and flag != "--column":
            return Err("unsupported resolved-reference argument: " + flag)
        if flags.contains_key(flag) or position + 1 >= cmd_args.len():
            return Err("duplicate or missing flag value: " + flag)
        val value = cmd_args[position + 1]
        if value.starts_with("--"):
            return Err("missing flag value: " + flag)
        flags[flag] = value
        position = position + 2
    if not enabled or flags.len() != 4:
        return Err("requires --resolved-references --identity-manifest --file --line --column")
    val line = reference_positive_argument_v1(flags["--line"] ?? "")?
    val column = reference_positive_argument_v1(flags["--column"] ?? "")?
    val source = file_read_regular_no_follow_bounded(flags["--identity-manifest"] ?? "", 1048576)?
    reference_request_from_manifest_v1(source, flags["--file"] ?? "", line, column)

fn rename_reference_snapshot_json_v1(snapshot: RenameReferenceSnapshotV1) -> text:
    var facts: [JsonValue] = []
    for fact in snapshot.facts:
        facts.push(JsonValue.Object(["module_ordinal", "local_symbol_id", "origin_key", "role", "file",
            "revision_sha256", "byte_start", "byte_end", "spelling", "line", "column"], [
            JsonValue.Int(fact.module_ordinal), JsonValue.Int(fact.local_symbol_id), JsonValue.Str(fact.origin_key),
            JsonValue.Str(fact.role), JsonValue.Str(fact.file), JsonValue.Str(fact.revision_sha256),
            JsonValue.Int(fact.byte_start), JsonValue.Int(fact.byte_end), JsonValue.Str(fact.spelling),
            JsonValue.Int(fact.line), JsonValue.Int(fact.column)]))
    var files: [JsonValue] = []
    for row in snapshot.inspected_files:
        files.push(JsonValue.Object(["package", "module_path", "file", "revision_sha256"], [
            JsonValue.Str(row.package), JsonValue.Str(row.module_path), JsonValue.Str(row.file), JsonValue.Str(row.revision_sha256)]))
    json_value_serialize(JsonValue.Object(["kind", "configuration_sha256", "inventory_sha256", "content_sha256",
        "selected_origin_key", "facts", "inspected_files", "complete_for_manifest", "visited_nodes",
        "parsed_files", "lowered_files", "admission"], [
        JsonValue.Str(snapshot.kind), JsonValue.Str(snapshot.configuration_sha256), JsonValue.Str(snapshot.inventory_sha256),
        JsonValue.Str(snapshot.content_sha256), JsonValue.Str(snapshot.selected_origin_key), JsonValue.Array(facts),
        JsonValue.Array(files), JsonValue.Bool(snapshot.complete_for_manifest), JsonValue.Int(snapshot.visited_nodes),
        JsonValue.Int(snapshot.parsed_files), JsonValue.Int(snapshot.lowered_files),
        JsonValue.Str("no edits or redirects admitted")]))

fn query_rename_resolved_references_v1(file: text, line_num: i64, cmd_args: [text]) -> i64:
    # Selection comes solely from explicit flags. Legacy positional strings
    # reaching this adapter never supply compiler identity or authorization.
    val request = match reference_command_request_v1(cmd_args):
        case Err(reason):
            print reference_failure_json_v1("configuration", reason)
            return 1
        case Ok(value): value
    match driver_collect_rename_references_v1(request):
        case Err(reason):
            print reference_failure_json_v1(reason.category, reason.message)
            1
        case Ok(snapshot):
            print rename_reference_snapshot_json_v1(snapshot)
            0
