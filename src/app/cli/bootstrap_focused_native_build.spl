# Pure-Simple native-build dispatch for exact, focused compiler capsules.
#
# This module drives CompilerDriver directly, with no legacy native-build FFI,
# so exact Stage4 provider composition stays on the localized
# compiler-backfill + core-runtime lane.

use compiler.driver.bootstrap_api_fixed.{aot_native_project_with_backend_fixed_v2, bootstrap_native_driver_with_backend_fixed_v1}
use app.cli.bootstrap_surface_inspection_v1.{bootstrap_surface_inspection_publish_v1}
use compiler.driver.driver_native_surface_inspection_v1.{NativeSurfaceInspectionRequestV1, driver_inspect_native_surfaces_v1}
use compiler.driver.bootstrap_k1_selected.{install_selected_k1_backend_table_v1,
    selected_k1_backend_policy_v1, selected_k1_backend_table_diagnostic_v1}
use compiler.backend.backend_port.{codegen_optimization_from_scalar_v1}
use compiler.common.driver_compile_result.{CompileResult, compile_result_is_success, compile_result_errors}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set, host_os, host_arch}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use app.cli.native_build_env_restore_v1.{native_build_env_saved_v1, native_build_env_restore_v1}
use app.cli.native_build_hir_warmup_outcome.{native_build_stage3_capsule_shard_entry_selected_v1}
use app.cli.bootstrap_backend_installer.{bootstrap_backend_request_error_v1}
use app.cli.bootstrap_essential_backend_request.{bootstrap_essential_dynamic_backend_request_v1}
pub use app.cli.bootstrap_focused_native_build_args.{
    FocusedNativeTargetProfileV1,
    focused_native_build_arg_value, focused_native_build_sources, focused_native_build_target_profile_v1,
    focused_native_build_target, focused_native_build_linker_script,
    focused_native_build_runtime_path, focused_native_build_cache_dir,
    focused_native_build_backend, focused_native_build_backend_plugin,
    focused_native_build_backend_plugin_error,
    focused_native_build_effective_sources,
    focused_native_build_effective_cache_dir,
    focused_native_build_profile_cache_dir_v1,
    focused_native_build_profile_receipt_namespace_v1,
    focused_native_build_receipt_dir_from_env_v1,
    focused_native_build_receipt_path_v1,
    focused_native_build_strip,
    focused_native_build_exact_capsule_entry_allowed,
    focused_native_build_has_flag, focused_native_build_source_at,
    focused_native_build_opt_level
}

use app.cli.collection_planner_options.{collection_planner_options}
use app.cli.bootstrap_native_output_args.{bootstrap_native_build_output_mode}
use app.io.native_build_output_mode.{native_build_output_mode_snapshot, native_build_output_mode_bind, native_build_output_mode_restore}

enum FocusedNativeExecutionV1:
    Compiled(CompileResult)
    Inspected(Result<text, text>)

# reason: bootstrap command entry returns the operating-system process exit status
@allow(primitive_api)
pub fn run_focused_native_surface_inspection_v1(args: [text], request: NativeSurfaceInspectionRequestV1) -> i64:
    run_focused_native_build_plan(args, false, Some(request))

pub fn focused_native_build_error(args: [text], inspection: NativeSurfaceInspectionRequestV1? = None) -> text:
    val output_mode = bootstrap_native_build_output_mode(args)
    if output_mode == "conflict":
        return "Error: --emit-object, --emit-entry-object, --emit-archive, and --emit-shared are mutually exclusive"
    if output_mode != "" and env_get("SIMPLE_BOOTSTRAP_STAGE4") == "1":
        return "Error: Stage4 strict profile does not support object, entry object, archive, or shared output"
    val plugin_error = focused_native_build_backend_plugin_error(args)
    if plugin_error != "": return plugin_error
    val planner = collection_planner_options(args)
    if planner.error != "": return "Error: " + planner.error
    if planner.specified:
        return "Error: focused native-build does not support collection planner controls; use the full native-build worker"
    val mode = focused_native_build_arg_value(args, "--mode")
    if mode != "" and mode != "dynload" and mode != "one-binary":
        return "Error: invalid --mode '{mode}' (expected dynload or one-binary)"
    val sources = focused_native_build_sources(args)
    if sources.len() > 6:
        return "Error: focused native-build accepts at most six --source roots"
    if focused_native_build_arg_value(args, "--entry") == "":
        return "Error: focused native-build requires --entry"
    if (focused_native_build_arg_value(args, "--output") == "" and
        focused_native_build_arg_value(args, "-o") == "") and inspection == None:
        return "Error: focused native-build requires --output"
    if focused_native_build_has_flag(args, "--xray-startup-consumer"):
        if not focused_native_build_has_flag(args, "--xray") or (mode != "" and mode != "one-binary"):
            return "XRAY-E-STARTUP-CONSUMER: requires --xray --mode one-binary executable output"
        val explicit_target = focused_native_build_target(args)
        if explicit_target != "" and not explicit_target.contains("-linux"):
            return "XRAY-E-STARTUP-CONSUMER: startup consumer is supported on Linux ELF targets only (got '{explicit_target}')"
    ""

pub fn run_focused_native_build(args: [text]) -> i64:
    run_focused_native_build_plan(args, false)

pub fn run_exact_stage4_focused_capsule(args: [text]) -> i64:
    if env_get("SIMPLE_BOOTSTRAP_STAGE4") != "1":
        print "Error: exact focused capsule requires SIMPLE_BOOTSTRAP_STAGE4=1"
        return 1
    val entry = focused_native_build_arg_value(args, "--entry")
    if not focused_native_build_exact_capsule_entry_allowed(entry):
        print "Error: exact focused capsule entry must be src/app/cli/main.spl or src/app/os/main.spl"
        return 1
    run_focused_native_build_plan(args, true)

pub fn run_exact_stage3_focused_capsule(args: [text]) -> i64:
    if env_get("SIMPLE_BOOTSTRAP_STAGE3") != "1":
        print "Error: exact Stage3 capsule requires SIMPLE_BOOTSTRAP_STAGE3=1"
        return 1
    val entry = focused_native_build_arg_value(args, "--entry")
    val mode = focused_native_build_arg_value(args, "--mode")
    if not native_build_stage3_capsule_shard_entry_selected_v1(entry, mode,
            (env_get("SIMPLE_MIR_SHARDING") ?? "") == "1"):
        print "Error: exact Stage3 capsule requires bootstrap_main.spl or an explicit MIR-sharded dynload tool entry"
        return 1
    if mode != "dynload":
        print "Error: exact Stage3 capsule requires --mode dynload"
        return 1
    run_focused_native_build_plan(args, false)

fn _focused_default_xray_target_v1(explicit_target: text) -> text:
    if explicit_target != "":
        return explicit_target
    val os_name = host_os()
    val raw_arch = host_arch()
    val arch = if raw_arch == "arm64": "aarch64" else: raw_arch
    if os_name == "macos" or os_name == "darwin":
        return "{arch}-apple-darwin"
    if os_name == "linux":
        return "{arch}-unknown-linux-gnu"
    ""

fn run_focused_native_build_plan(args: [text], exact_stage4_capsule: bool,
        inspection: NativeSurfaceInspectionRequestV1? = None) -> i64:
    val plan_error = focused_native_build_error(args, inspection)
    if plan_error != "":
        print plan_error
        return 1

    val selected_profile = focused_native_build_target_profile_v1(args)
    if selected_profile.is_err():
        print selected_profile.unwrap_err()
        return 1
    val target_profile = selected_profile.unwrap()

    # Exact Stage3/Stage4 dispatch returns here before bootstrap_main's
    # positional-route installation. Admit the selected composition before
    # the direct driver constructs its backend session or we mutate run env.
    if not install_selected_k1_backend_table_v1():
        print "PLUG-E-K1-POLICY: focused native-build backend composition admission failed (selected policy '{selected_k1_backend_policy_v1()}')"
        print "  k1-table: {selected_k1_backend_table_diagnostic_v1()}"
        return 1

    val sources = focused_native_build_effective_sources(args, exact_stage4_capsule)
    val entry = focused_native_build_arg_value(args, "--entry")
    var output = focused_native_build_arg_value(args, "--output")
    if output == "":
        output = focused_native_build_arg_value(args, "-o")
    val backend = focused_native_build_backend(args)
    val backend_plugin_path = focused_native_build_backend_plugin(args)
    val xray_enabled = focused_native_build_has_flag(args, "--xray")
    val xray_startup_consumer = focused_native_build_has_flag(args, "--xray-startup-consumer")
    val debug_requested = focused_native_build_has_flag(args, "--debug") or focused_native_build_has_flag(args, "-g")
    val target = if xray_enabled:
        _focused_default_xray_target_v1(focused_native_build_target(args))
    else:
        focused_native_build_target(args)
    if xray_startup_consumer and not target.contains("-linux"):
        print "XRAY-E-STARTUP-CONSUMER: startup consumer is supported on Linux ELF targets only (got '{target}')"
        return 1
    val opt_level = if focused_native_build_arg_value(args, "--opt-level") != "":
        focused_native_build_opt_level(args)
    elif not target_profile.release:
        0
    else:
        focused_native_build_opt_level(args)
    val composition_error = bootstrap_backend_request_error_v1(backend, backend_plugin_path)
    if composition_error != "":
        print "Error: {composition_error}"
        return 1
    if backend_plugin_path != "":
        val dyn_req = bootstrap_essential_dynamic_backend_request_v1(
            selected_k1_backend_policy_v1(), backend, backend_plugin_path,
            target, "", codegen_optimization_from_scalar_v1(opt_level))
        if dyn_req.is_err():
            print "Error: {dyn_req.unwrap_err()}"
            return 1
    val linker_script = focused_native_build_linker_script(args)
    val runtime_path = focused_native_build_runtime_path(args)
    val runtime_bundle = focused_native_build_arg_value(args, "--runtime-bundle")

    # Focused dispatch returns before bootstrap_main's positional binding.
    # Bind the same driver contract here and restore it on every result path.
    val previous_output_mode = native_build_output_mode_snapshot()
    val requested_output_mode = bootstrap_native_build_output_mode(args)
    if not native_build_output_mode_bind(requested_output_mode):
        val output_restored = native_build_output_mode_restore(previous_output_mode)
        if not output_restored:
            print "error: could not restore focused native-build output-mode environment"
        print "error: could not bind focused native-build output mode '{requested_output_mode}'"
        return 1

    val old_entry = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_ENTRY")
    val old_entry_closure = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE")
    val old_target = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_TARGET")
    val old_linker_script = native_build_env_saved_v1("SIMPLE_LINKER_SCRIPT")
    val old_runtime_path = native_build_env_saved_v1("SIMPLE_RUNTIME_PATH")
    val old_cache_dir_saved = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_CACHE_DIR")
    val old_cache_dir = old_cache_dir_saved ?? ""
    val old_receipt_dir_saved = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_RECEIPT_DIR")
    val old_receipt_dir = old_receipt_dir_saved ?? ""
    val old_runtime_bundle = native_build_env_saved_v1("SIMPLE_NATIVE_RUNTIME_BUNDLE")
    val old_native_arena_decls = native_build_env_saved_v1("SIMPLE_NATIVE_ARENA_DECLS")
    val old_build_mode = native_build_env_saved_v1("SIMPLE_NATIVE_BUILD_MODE")
    val old_lib_units = native_build_env_saved_v1("SIMPLE_NATIVE_LIBRARY_UNITS")
    val old_stage3_dynlib = native_build_env_saved_v1("SIMPLE_STAGE3_LIB_DYNLIB")
    val old_dynlib_explicit = native_build_env_saved_v1("SIMPLE_LIBRARY_UNITS_DYNLIB_EXPLICIT")
    val requested_mode = focused_native_build_arg_value(args, "--mode")
    val effective_cache_dir = focused_native_build_profile_cache_dir_v1(args, old_cache_dir, target_profile)
    val effective_receipt_dir = focused_native_build_receipt_dir_from_env_v1(
        old_receipt_dir, target_profile, effective_cache_dir, xray_enabled
    )
    env_set("SIMPLE_NATIVE_BUILD_ENTRY", entry)
    env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "0")
    env_set("SIMPLE_NATIVE_ARENA_DECLS", "1")
    if target != "":
        env_set("SIMPLE_NATIVE_BUILD_TARGET", target)
    if linker_script != "":
        env_set("SIMPLE_LINKER_SCRIPT", linker_script)
    if runtime_path != "":
        env_set("SIMPLE_RUNTIME_PATH", runtime_path)
    env_set("SIMPLE_NATIVE_BUILD_CACHE_DIR", effective_cache_dir)
    env_set("SIMPLE_NATIVE_BUILD_RECEIPT_DIR", effective_receipt_dir)
    if runtime_bundle != "":
        env_set("SIMPLE_NATIVE_RUNTIME_BUNDLE", runtime_bundle)
    if requested_mode != "":
        env_set("SIMPLE_NATIVE_BUILD_MODE", requested_mode)
    if focused_native_build_has_flag(args, "--no-library-units"):
        env_set("SIMPLE_NATIVE_LIBRARY_UNITS", "0")
        env_set("SIMPLE_STAGE3_LIB_DYNLIB", "0")
        env_set("SIMPLE_LIBRARY_UNITS_DYNLIB_EXPLICIT", "")
    elif focused_native_build_has_flag(args, "--library-units-dynlib"):
        env_set("SIMPLE_NATIVE_LIBRARY_UNITS", "1")
        env_set("SIMPLE_STAGE3_LIB_DYNLIB", "1")
        env_set("SIMPLE_LIBRARY_UNITS_DYNLIB_EXPLICIT", "1")
    elif focused_native_build_has_flag(args, "--library-units"):
        env_set("SIMPLE_NATIVE_LIBRARY_UNITS", "1")
        env_set("SIMPLE_STAGE3_LIB_DYNLIB", "0")
        env_set("SIMPLE_LIBRARY_UNITS_DYNLIB_EXPLICIT", "")

    val effective_strip = focused_native_build_strip(args, exact_stage4_capsule)
    val debug_info_override = if debug_requested: 1 elif target_profile.release: 0 else: 1
    val execution = if val request = inspection:
        val inspected = match bootstrap_native_driver_with_backend_fixed_v1(
            focused_native_build_source_at(sources, 0),
            focused_native_build_source_at(sources, 1),
            focused_native_build_source_at(sources, 2),
            focused_native_build_source_at(sources, 3),
            focused_native_build_source_at(sources, 4),
            focused_native_build_source_at(sources, 5),
            sources.len(),
            entry,
            output,
            backend,
            effective_strip,
            target_profile.release,
            opt_level,
            focused_native_build_has_flag(args, "--no-borrow-check"),
            target_profile.managed_build_phase,
            backend_plugin_path,
            xray_enabled,
            xray_startup_consumer,
            debug_info_override
        ):
            case Ok(driver): driver_inspect_native_surfaces_v1(driver, request)
            case Err(reason): Err(reason)
        FocusedNativeExecutionV1.Inspected(inspected)
    else:
        FocusedNativeExecutionV1.Compiled(aot_native_project_with_backend_fixed_v2(
            focused_native_build_source_at(sources, 0),
            focused_native_build_source_at(sources, 1),
            focused_native_build_source_at(sources, 2),
            focused_native_build_source_at(sources, 3),
            focused_native_build_source_at(sources, 4),
            focused_native_build_source_at(sources, 5),
            sources.len(),
            entry,
            output,
            backend,
            effective_strip,
            target_profile.release,
            opt_level,
            focused_native_build_has_flag(args, "--no-borrow-check"),
            target_profile.managed_build_phase,
            backend_plugin_path,
            xray_enabled,
            xray_startup_consumer,
            debug_info_override
        ))
    val active_receipt_dir = focused_native_build_receipt_dir_from_env_v1(
        env_get("SIMPLE_NATIVE_BUILD_RECEIPT_DIR"), target_profile, effective_cache_dir, xray_enabled)
    val focused_receipt_path = focused_native_build_receipt_path_v1(
        output, active_receipt_dir, target_profile, effective_cache_dir, xray_enabled)

    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_ENTRY", old_entry)
    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", old_entry_closure)
    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_TARGET", old_target)
    native_build_env_restore_v1("SIMPLE_LINKER_SCRIPT", old_linker_script)
    native_build_env_restore_v1("SIMPLE_RUNTIME_PATH", old_runtime_path)
    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_CACHE_DIR", old_cache_dir_saved)
    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_RECEIPT_DIR", old_receipt_dir_saved)
    native_build_env_restore_v1("SIMPLE_NATIVE_RUNTIME_BUNDLE", old_runtime_bundle)
    native_build_env_restore_v1("SIMPLE_NATIVE_ARENA_DECLS", old_native_arena_decls)
    native_build_env_restore_v1("SIMPLE_NATIVE_BUILD_MODE", old_build_mode)
    native_build_env_restore_v1("SIMPLE_NATIVE_LIBRARY_UNITS", old_lib_units)
    native_build_env_restore_v1("SIMPLE_STAGE3_LIB_DYNLIB", old_stage3_dynlib)
    native_build_env_restore_v1("SIMPLE_LIBRARY_UNITS_DYNLIB_EXPLICIT", old_dynlib_explicit)

    val output_restored = native_build_output_mode_restore(previous_output_mode)
    if not output_restored:
        print "error: could not restore focused native-build output-mode environment"
        return 1

    # Both branches restore the exact same ambient configuration before reporting.
    val result = match execution:
        case FocusedNativeExecutionV1.Inspected(observation):
            match observation:
                case Ok(sdn):
                    if val request = inspection:
                        match bootstrap_surface_inspection_publish_v1(request, sdn):
                            case Ok(path):
                                print "diagnostic-only: {path}; no compile admission"
                                return 0
                            case Err(reason):
                                print "error: surface inspection publication: {reason}"
                                return 1
                    print "error: surface inspection diagnostic publication failed"
                    return 1
                case Err(reason):
                    print "error: surface inspection: {reason}"
                    return 1
        case FocusedNativeExecutionV1.Compiled(compiled): compiled
    if compile_result_is_success(result):
        if dir_create_all(active_receipt_dir):
            val receipt_sdn = "format: \"simple/focused-native-build-receipt/v1\"\n" +
                "entry: \"{entry}\"\n" +
                "output: \"{output}\"\n" +
                "backend: \"{backend}\"\n" +
                "backend_plugin_path: \"{backend_plugin_path}\"\n" +
                "profile: \"{target_profile.profile}\"\n" +
                "managed_build_phase: \"{target_profile.managed_build_phase}\"\n"
            val _published = file_atomic_write(focused_receipt_path, receipt_sdn)
        return 0
    for err in compile_result_errors(result):
        print "error: focused native-build: {err}"
    1
