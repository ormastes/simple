# Pure-Simple native-build dispatch for exact, focused compiler capsules.
#
# This module drives CompilerDriver directly, with no legacy native-build FFI,
# so exact Stage4 provider composition stays on the localized
# compiler-backfill + core-runtime lane.

use app.cli.bootstrap_native_nonpositional.{run_bootstrap_native_nonpositional}
use app.cli.bootstrap_positional_native_build.{run_bootstrap_positional_native_build}
pub use app.cli.bootstrap_focused_native_build_plan.{focused_native_build_error, run_focused_native_build}
pub use app.cli.bootstrap_focused_native_build_args.{
    focused_native_build_arg_value, focused_native_build_sources,
    focused_native_build_target, focused_native_build_linker_script,
    focused_native_build_runtime_path, focused_native_build_cache_dir,
    focused_native_build_backend, focused_native_build_effective_sources,
    focused_native_build_effective_cache_dir, focused_native_build_strip,
    focused_native_build_exact_capsule_entry_allowed,
    focused_native_build_has_flag, focused_native_build_source_at,
    focused_native_build_opt_level
}

extern fn rt_bootstrap_native_build_single_spl_positional(args: [text]) -> text

pub fn run_bootstrap_native_build_dispatch(args: [text]) -> i64:
    val entry_path = rt_bootstrap_native_build_single_spl_positional(args)
    if entry_path != "":
        return run_bootstrap_positional_native_build(args, entry_path)
    run_bootstrap_native_nonpositional(args)
