# Scan captured process receipts without copying or splitting the entire log.
# Keep the former replace("\r\n", "\n").split("\n").contains(line) semantics.

pub fn native_build_log_has_exact_line_v1(output: text, expected: text) -> bool:
    if expected.contains("\n"):
        return false
    val output_len = output.len()
    val expected_len = expected.len()
    var line_start: i64 = 0
    while line_start <= output_len:
        # Native text.index_of returns -1 on a miss; interpreted callers may
        # return nil. Both mean the final unterminated line, including empty.
        val newline = output.index_of("\n", line_start) ?? -1
        var line_end = if newline < 0: output_len else: newline
        # CR is removed only when it belongs to CRLF. A final bare CR, or
        # the first CR of CRCRLF, remains part of the exact expected line.
        if newline >= 0 and line_end > line_start:
            if output.byte_at(line_end - 1) == 13:
                line_end = line_end - 1
        if line_end - line_start == expected_len:
            var index: i64 = 0
            while index < expected_len:
                if output.byte_at(line_start + index) != expected.byte_at(index):
                    break
                index = index + 1
            if index == expected_len:
                return true
        if newline < 0:
            return false
        line_start = newline + 1
    false
