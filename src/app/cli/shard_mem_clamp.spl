# Memory-aware clamp for native-build shard concurrency.
#
# Why this exists: the shard thread count was derived from CPU count alone --
# scripts/bootstrap/bootstrap-from-scratch.sh picks host_cpus/2, which is 16 on
# a 32-core box -- while a measured worker holds 2.4-2.7 GB RSS (VmPeak 3.37 GB,
# 99.4% anonymous, Pss ~= Rss so nothing is shared between siblings). A single
# stage1 run therefore asked for ~40 GB, and on a shared box the whole worker
# group was OOM-reaped mid-HIR after an hour of work (run17: rc=255 after
# 12,643 s across 3 attempts, death points 13/688, 288/688, 509/688 -- flaky, so
# not a deterministic compiler defect). Nothing anywhere derived concurrency
# from memory; check-heavy-work-preflight.shs is a one-shot admission gate that
# refuses to start, it never lowers N.
# Measurements: doc/09_report/build_parallelism_memory_audit_2026-08-23.md
#
# Safety properties: sharding is a cache warm-up, so the compiled output is
# byte-identical at any N and lowering N is always semantics-preserving. The
# clamp only ever *reduces* the count, reads one file once at spawn time, and is
# deliberately NOT a mid-run feedback loop -- killing or suspending live shards
# would re-open the orphaned-claim class fixed by 6cedd51faec.
# std-only on purpose: the orchestrator is a slim entry that must not drag the
# compiler closure in.
use app.io.env_ops.{env_get}
use app.io.process_ops.{process_run_timeout}

@when(os="windows"):
use std.nogc_sync_mut.io.windows_process_owner.{windows_available_memory_headroom_v1}

pub fn shard_mem_available_kb() -> i64:
    match windows_available_memory_headroom_v1():
        case Ok(bytes): bytes / 1024
        case Err(_): 0
@else:
@when(os="macos"):
# Darwin has no /proc/meminfo and no MemAvailable analogue. `vm_stat` reports
# page counts (suffixed with '.') and the page size only inside its header
# line. Headroom is free + inactive pages: inactive is the reclaimable cache
# pool (file-backed pages purgeable under pressure), while active/wired/
# speculative/compressed are not real headroom. Same subprocess mechanism as
# the Linux probe below (see the NOTE there): `process_run_timeout`, never
# `file_read`, which fatally recursed in the run20-class seed.
pub fn shard_mem_available_kb() -> i64:
    val (out, _err, code) = process_run_timeout("vm_stat", [], 2000)
    if code != 0:
        return 0
    shard_macos_available_kb_from_vm_stat(out)

# Page count on one "Pages <kind>: <n>." vm_stat line; -1 when the prefix
# does not match or the count is not plain digits (a garbage count makes the
# whole probe "unknown", same as a missing line -- never a silent 0-pages).
fn shard_macos_page_count_from_line(line: text, prefix: text) -> i64:
    if not line.starts_with(prefix):
        return -1
    var field = line.substring(prefix.len()).trim()
    if field.ends_with("."):
        field = field.substring(0, field.len() - 1)
    if field == "":
        return -1
    var i = 0
    while i < field.len():
        val b = field.byte_at(i)
        if b < 48 or b > 57:
            return -1
        i = i + 1
    shard_mem_available_kb_from_field(field)

# Pure vm_stat parser, split out so the unit spec can pin it without a host
# probe: free + inactive pages times the header page size, in kB. 0 when the
# page size or either count is missing/unparseable -- unknown memory permits
# only the sequential path, same contract as the Linux probe.
pub fn shard_macos_available_kb_from_vm_stat(output: text) -> i64:
    var page_size: i64 = 0
    var free_pages: i64 = 0
    var inactive_pages: i64 = 0
    var saw_free = false
    var saw_inactive = false
    for raw_line in output.split("\n"):
        val line = raw_line.trim()
        if line == "":
            continue
        if line.contains("page size of"):
            # "Mach Virtual Memory Statistics: (page size of 16384 bytes)"
            val start = line.index_of("page size of") + "page size of".len()
            val rest = line.substring(start).trim()
            var digits = ""
            var i = 0
            while i < rest.len():
                val b = rest.byte_at(i)
                if b >= 48 and b <= 57:
                    digits = digits + rest.substring(i, i + 1)
                else:
                    break
                i = i + 1
            page_size = shard_mem_available_kb_from_field(digits)
            continue
        val free_count = shard_macos_page_count_from_line(line, "Pages free:")
        if free_count >= 0:
            free_pages = free_count
            saw_free = true
            continue
        val inactive_count = shard_macos_page_count_from_line(line, "Pages inactive:")
        if inactive_count >= 0:
            inactive_pages = inactive_count
            saw_inactive = true
    if page_size <= 0 or not saw_free or not saw_inactive:
        return 0
    val pages = free_pages + inactive_pages
    if pages <= 0:
        return 0
    # bytes = pages * page_size, kB = bytes / 1024; guard i64 overflow first.
    if pages > 9223372036854775807 / page_size:
        return 0
    (pages * page_size) / 1024
@else:
# MemAvailable (kB) from /proc/meminfo; 0 when unavailable. Unknown memory
# permits only the existing sequential path, never CPU-count fanout.
# NOTE: deliberately NOT std.io_runtime.file_read. In the run20-class seed
# `file_read` infinitely recurses and aborts the process with
# "fatal runtime error: stack overflow" on ANY file, regular or procfs --
# doc/08_tracking/bug/seed_file_read_infinite_recursion_stack_overflow_2026-08-23.md.
# The first landing of this clamp (ff095d31591) used it and took down every
# native-build before step 0/6. `process_run_timeout` is the same mechanism
# native_build_main already uses for `readlink` on this exact path, so it is
# proven live here.
pub fn shard_mem_available_kb() -> i64:
    val (out, _err, code) = process_run_timeout("awk", ["/^MemAvailable:/ {print $2}", "/proc/meminfo"], 2000)
    if code != 0:
        return 0
    shard_mem_available_kb_from_field(out.trim())
@end
@end

# Split out so a spec can feed a fixture without a /proc dependency.
pub fn shard_mem_available_kb_from_field(field: text) -> i64:
    val trimmed = field.trim()
    if trimmed == "" or trimmed.len() > 19:
        return 0
    # Some bootstrap providers saturate overflowing to_i64 input. Reject its
    # decimal magnitude before conversion rather than trusting that sentinel.
    val maximum = "9223372036854775807"
    var larger = false
    var smaller = false
    var index = 0
    while index < trimmed.len():
        val digit = trimmed.byte_at(index)
        if digit < 48 or digit > 57: return 0
        if trimmed.len() == 19 and not larger and not smaller:
            val bound = maximum.byte_at(index)
            if digit > bound: larger = true
            elif digit < bound: smaller = true
        index = index + 1
    if larger: return 0
    val n = trimmed.to_i64() ?? 0
    if n < 0:
        return 0
    n


# Default per-worker admission estimates (kB), set from measured peaks of the
# largest workload (doc/08_tracking/bug/stage2_compiler_tests_frontend_shard_rss_2026-10-25.md).
# 2937-module full CLI, 20 threads: parse workers 3.1-3.6 GiB, HIR workers
# 5.3-6.3 GiB. The old 1650000/3000000 were about half of that, so admission
# let in more workers than the tree cap could hold. A 1062-module closure
# measured parse 1.45-1.86 GiB and HIR 3.6-4.0 GiB, so these constants
# over-reserve on smaller closures; a phase override lowers them deliberately.
pub const SHARD_PARSE_WORKER_KB_V1: i64 = 3800000
pub const SHARD_HIR_WORKER_KB_V1: i64 = 6700000

# Per-worker memory budget in kB. Parse shards run the slim parse-lane entry;
# HIR shards spawn the full worker closure, so they carry a larger budget and
# are clamped harder (measured defaults: SHARD_PARSE/HIR_WORKER_KB_V1 above). Precedence: the per-phase
# variable (a deliberate override, may go lower), then the host config key
# worker_mem_mib (environment layer SIMPLE_HOST_WORKER_MEM_MIB), then the
# default. The host key is a machine-wide hint shared by every phase, so it may
# only make a phase MORE conservative: a value below the phase default (e.g.
# below the measured HIR RSS behind the 3 GB HIR default) is ignored, with a
# warning, rather than silently loosening the clamp.
#
# The parent peak is deliberately NOT a budget floor by default. When it was
# one (61bb554b161), a large tree priced every HIR worker at the supervisor's
# own front-end high-water mark (~8.16 GiB on the phase-3 tree); host headroom
# then could not fit even one floored estimate and admission collapsed to
# exactly one worker, which re-ran the entire front-end replay (load_sources
# through surface_freeze and hir) as its baseline -- double the retained
# parent footprint -- and was SIGBUS-killed near 7-8 GB RSS (41 deaths,
# 2026-10-24 phase-3 lane). With the floor dropped, fanout is sized from the
# measured per-worker default (or a deliberate override) and RSS splits across
# queue-claiming workers; the tree reserve in shard_threads_parent_cap_for
# still protects the supervisor. SIMPLE_HIR_SHARD_PARENT_FLOOR=1 restores the
# old floor explicitly. A valid phase override still wins over everything.
pub fn shard_worker_budget_kb(var_name: text, default_kb: i64, parent_peak_kb: i64 = 0) -> i64:
    val raw = env_get(var_name) ?? ""
    if raw != "":
        val parsed = shard_mem_available_kb_from_field(raw)
        if parsed > 0:
            return parsed
    val host_kb = shard_host_worker_budget_kb(env_get("SIMPLE_HOST_WORKER_MEM_MIB") ?? "")
    val chosen = shard_host_budget_floor_kb(host_kb, default_kb)
    if host_kb > 0 and chosen != host_kb:
        val host_mib = host_kb / 1024
        print "[shard] ignoring worker_mem_mib={host_mib} MiB below the {var_name} default {default_kb} kB; set {var_name} to lower it deliberately"
    if parent_peak_kb > 0 and (env_get("SIMPLE_HIR_SHARD_PARENT_FLOOR") ?? "") == "1":
        return shard_host_budget_floor_kb(parent_peak_kb, chosen)
    chosen

# worker_mem_mib in kB; 0 (use the default) when absent, invalid or so large
# that the KiB value would overflow i64.
pub fn shard_host_worker_budget_kb(mib_field: text) -> i64:
    val mib = shard_mem_available_kb_from_field(mib_field)
    if mib <= 0 or mib > 9007199254740991:
        return 0
    mib * 1024

# Floor: the host key may raise a phase budget, never lower it.
pub fn shard_host_budget_floor_kb(host_kb: i64, default_kb: i64) -> i64:
    if host_kb > default_kb:
        return host_kb
    default_kb

# Host config key max_threads (environment layer SIMPLE_HOST_MAX_THREADS) is an
# upper bound only: it never raises the request, and absent/invalid is no bound.
pub fn shard_host_threads_cap(requested: i64, max_threads_field: text) -> i64:
    val max_threads = shard_mem_available_kb_from_field(max_threads_field)
    if max_threads > 0 and max_threads < requested:
        return max_threads
    requested

# The clamp itself, pure: N x budget must fit inside 60% of MemAvailable.
# Unknown memory or an invalid estimate permits only the sequential path.
pub fn shard_threads_cap_for(requested: i64, budget_kb: i64, avail_kb: i64) -> i64:
    if requested <= 1:
        return requested
    if budget_kb <= 0 or avail_kb <= 0:
        return 1
    # Divide first; an arbitrary positive i64 input must not overflow at * 6.
    val usable_kb = (avail_kb / 10) * 6 + ((avail_kb % 10) * 6) / 10
    var cap = usable_kb / budget_kb
    if cap < 1:
        cap = 1
    if cap >= requested:
        return requested
    cap

# The tree budget includes the supervisor, compiler and siblings. Keep 40%
# for those owners, just as the host clamp reserves 40% of available memory.
# The enforcing owner exports this hint from its actual enforced RSS cap; the
# watchdog remains the enforcement authority.
#
# DESIGN CHANGE (2026-10-09) to 4584489a62c (2026-10-03). That commit added the
# GlobalMemoryStatusEx probe and, deliberately, sent every Windows run without a
# tree budget down the sequential path, because a correct host-memory answer
# would still miss a much smaller enforced process-tree cap that had not been
# passed down. That fallback serialized every Windows native-build outside the
# transcribing wrapper, sized against per-worker figures the later
# re-measurement no longer supports (real Stage 2 peak below 1 GB per process;
# the ~15 GB reading traced to a 16x Windows /proc unit error -- see the
# 2026-09-26 and 2026-10-03 records).
#
# The hazard is now closed at its root instead: process-tree-rss-watchdog.pl,
# which every enforcing wrapper goes through, exports its enforced cap as
# SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB to the whole tree (keeping a smaller
# inherited one), pinned by scripts/bootstrap/tests/watchdog-shard-budget-export-test.shs.
# So the rule here is uniform on every platform: a declared budget clamps;
# an undeclared one means no enclosing cap and fanout is bounded by measured
# host headroom (60% of min(available physical, available commit) on
# Windows, MemAvailable elsewhere). Unknown host memory is still sequential.
# An enforcing wrapper that bypasses the watchdog is a bug in that wrapper.
pub fn shard_threads_tree_cap_for(requested: i64, budget_kb: i64,
        avail_kb: i64, tree_kb: i64, host_clamp: bool) -> i64:
    if requested <= 1: return requested
    var capped = requested
    if host_clamp:
        capped = shard_threads_cap_for(capped, budget_kb, avail_kb)
    if tree_kb > 0:
        capped = shard_threads_cap_for(capped, budget_kb, tree_kb)
    capped

# HIR workers run the same producer closure as their supervisor. Its retained
# high-water mark is a workload-sensitive estimate floor, not a future RSS bound.
# Keep the existing 40% tree reserve, or the measured parent peak if larger.
# A known tree that cannot fit one estimate admits no HIR child, including N=1.
# The final compiler worker is outside this pool calculation and remains guarded.
# ===== measured commit admission ============================================
#
# The start-time cap above divides headroom by a FIXED per-worker estimate.
# s3-wa (2026-10-25) admitted 5 HIR workers at 6 GB each; their real commit
# was far higher, the host commit limit (RAM + pagefile) ran out, and all five
# died together on failed allocations. The slot pool therefore also gates each
# further spawn on LIVE system commit headroom against the measured footprint:
#   est  = max(static estimate, largest private KiB any worker has reached)
#   need = est for the new worker + (est - current) for every live worker
#          that has not yet grown to est
# A worker is always admitted when none is live (no deadlock, serial floor),
# and an unknown headroom (-1, probe unavailable) keeps the static cap.
pub fn shard_commit_estimate_kib_v1(static_kib: i64, observed_peak_kib: i64) -> i64:
    if observed_peak_kib > static_kib: observed_peak_kib else: static_kib

pub fn shard_commit_spawn_admit_v1(headroom_kib: i64, reserve_kib: i64, est_kib: i64, live_private_kib: [i64]) -> bool:
    if headroom_kib < 0: return true
    if live_private_kib.len() == 0: return true
    var need = est_kib
    for current in live_private_kib:
        if current < 0:
            need = need + est_kib
        elif current < est_kib:
            need = need + (est_kib - current)
    headroom_kib - reserve_kib >= need

pub fn shard_threads_parent_cap_for(requested: i64, budget_kb: i64,
        avail_kb: i64, tree_kb: i64, host_clamp: bool, parent_peak_kb: i64) -> i64:
    if requested <= 0: return 0
    if budget_kb <= 0: return 0
    var capped = requested
    if host_clamp:
        capped = shard_threads_cap_for(capped, budget_kb, avail_kb)
    if tree_kb > 0:
        val usable = (tree_kb / 10) * 6 + ((tree_kb % 10) * 6) / 10
        val reserve = shard_host_budget_floor_kb(parent_peak_kb, tree_kb - usable)
        if reserve >= tree_kb: return 0
        val slots = (tree_kb - reserve) / budget_kb
        if slots < capped: capped = slots
    capped

# ===== cgroup v2 memory.max ==================================================
#
# A cgroup memory.max (systemd-run -p MemoryMax=, a container limit, a CI
# runner slice) is an enforced cap on this whole process tree that no wrapper
# exports as SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB. Host MemAvailable does not
# see it: on a 121 GB host inside a 24 GiB scope the clamp admitted every
# requested HIR worker and the kernel OOM-killed the tree. The smallest
# numeric memory.max on the chain from this process's cgroup up to the root is
# the binding cap; "max" is unlimited and an unreadable level is skipped, never
# read as 0. Pure helpers are split from the one live reader so the spec can
# pin them without a cgroup.

# cgroup v2 path of this process from a /proc/self/cgroup table ("0::<path>").
# A v1-only table (controller rows, no "0::" row) yields "" -- no bound known.
pub fn shard_cgroup_v2_path_from_proc(table: text) -> text:
    for line in table.split("\n"):
        if line.starts_with("0::"):
            return line.substring(3).trim()
    ""

# memory.max files from the leaf cgroup up to the unified-hierarchy root.
pub fn shard_cgroup_memory_max_paths(cgroup_path: text) -> [text]:
    if cgroup_path == "" or not cgroup_path.starts_with("/"):
        return []
    var paths: [text] = []
    var current = cgroup_path
    while current.len() > 1 and current.ends_with("/"):
        current = current.substring(0, current.len() - 1)
    while true:
        val prefix = if current == "/": "" else: current
        paths = paths.push("/sys/fs/cgroup" + prefix + "/memory.max")
        if current == "/":
            break
        val slash = current.rfind("/")
        current = if slash <= 0: "/" else: current.substring(0, slash)
    paths

# Smallest numeric memory.max (bytes) on the chain, in kB; 0 when every level
# is "max", junk or unreadable.
pub fn shard_cgroup_memory_max_kb_from_fields(fields: [text]) -> i64:
    var best: i64 = 0
    for field in fields:
        val bytes = shard_mem_available_kb_from_field(field)
        if bytes <= 0:
            continue
        val kb = bytes / 1024
        if kb <= 0:
            continue
        if best == 0 or kb < best:
            best = kb
    best

@when(os="windows"):
# Windows job objects export their cap through the RSS watchdog; no cgroup.
pub fn shard_cgroup_memory_max_kb() -> i64:
    0
@else:
# Same subprocess mechanism as shard_mem_available_kb (see the NOTE there); a
# child inherits this process's cgroup, so its /proc/self/cgroup is ours.
pub fn shard_cgroup_memory_max_kb() -> i64:
    val (table, _err, code) = process_run_timeout("cat", ["/proc/self/cgroup"], 2000)
    if code != 0:
        return 0
    var fields: [text] = []
    for candidate in shard_cgroup_memory_max_paths(shard_cgroup_v2_path_from_proc(table)):
        val (out, _e, rc) = process_run_timeout("cat", [candidate], 2000)
        if rc == 0:
            fields = fields.push(out.trim())
    shard_cgroup_memory_max_kb_from_fields(fields)
@end

# The enclosing cgroup cap may only tighten a declared tree budget: an
# undeclared budget takes the cap, a declared one keeps the smaller of the two.
pub fn shard_tree_budget_kb_for(declared_kb: i64, cgroup_kb: i64) -> i64:
    if cgroup_kb <= 0:
        return declared_kb
    if declared_kb <= 0 or cgroup_kb < declared_kb:
        return cgroup_kb
    declared_kb

# An explicit opt-out disables the host estimate, not a known enclosing cap
# (declared budget or cgroup memory.max). Host config max_threads
# (SIMPLE_HOST_MAX_THREADS) bounds the request on every platform; it can only
# lower it.
pub fn shard_threads_mem_cap(requested: i64, budget_kb: i64, parent_peak_kb: i64 = -1) -> i64:
    if requested <= 1 and parent_peak_kb < 0:
        return requested
    val bounded = shard_host_threads_cap(requested, env_get("SIMPLE_HOST_MAX_THREADS") ?? "")
    val host_clamp = (env_get("SIMPLE_SHARD_MEM_CLAMP") ?? "") != "0"
    val avail_kb = if host_clamp: shard_mem_available_kb() else: 0
    val declared_kb = shard_mem_available_kb_from_field(
        env_get("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB") ?? "")
    val cgroup_kb = shard_cgroup_memory_max_kb()
    val tree_kb = shard_tree_budget_kb_for(declared_kb, cgroup_kb)
    val cap = if parent_peak_kb >= 0:
        shard_threads_parent_cap_for(bounded, budget_kb, avail_kb, tree_kb, host_clamp, parent_peak_kb)
    else:
        shard_threads_tree_cap_for(bounded, budget_kb, avail_kb, tree_kb, host_clamp)
    if parent_peak_kb >= 0:
        print "[hir-shard] admission estimate={budget_kb} kB historical parent peak={parent_peak_kb} kB; warmup pool only, RSS guard authoritative"
    if cap < requested:
        print "[shard] threads={cap} (requested {requested}, host max_threads bound={bounded}, available={avail_kb} kB, tree budget={tree_kb} kB (declared {declared_kb} kB, cgroup memory.max {cgroup_kb} kB), worker budget={budget_kb} kB, parent peak={parent_peak_kb} kB)"
    cap
