# Memory-aware clamp for native-build shard concurrency.
#
# Why this exists: the shard thread count was derived from CPU count alone --
# scripts/bootstrap/bootstrap-from-scratch.sh picks host_cpus/2, which is 16 on
# a 32-core box -- while a measured worker holds 2.4-2.7 GB RSS (VmPeak 3.37 GB,
# 99.4% anonymous, Pss ~= Rss so nothing is shared between siblings). A single
# stage1 run therefore asked for ~40 GB, and on a shared box the whole worker
# group was OOM-reaped mid-HIR after an hour of work (run17: rc=255 after
# 12,643 s across 3 attempts, death points 13/688, 288/688, 509/688 -- flaky, so
# not a deterministic compiler defect). Nothing anywhere derived concurrency
# from memory; check-heavy-work-preflight.shs is a one-shot admission gate that
# refuses to start, it never lowers N.
# Measurements: doc/09_report/build_parallelism_memory_audit_2026-08-23.md
#
# Safety properties: sharding is a cache warm-up, so the compiled output is
# byte-identical at any N and lowering N is always semantics-preserving. The
# clamp only ever *reduces* the count, reads one file once at spawn time, and is
# deliberately NOT a mid-run feedback loop -- killing or suspending live shards
# would re-open the orphaned-claim class fixed by 6cedd51faec.
# std-only on purpose: the orchestrator is a slim entry that must not drag the
# compiler closure in.
use app.io.env_ops.{env_get}
use app.io.process_ops.{process_run_timeout}

@when(os="windows"):
use std.nogc_sync_mut.io.windows_process_owner.{windows_available_memory_headroom_v1}

pub fn shard_mem_available_kb() -> i64:
    match windows_available_memory_headroom_v1():
        case Ok(bytes): bytes / 1024
        case Err(_): 0
@else:
# MemAvailable (kB) from /proc/meminfo; 0 when unavailable. Unknown memory
# permits only the existing sequential path, never CPU-count fanout.
# NOTE: deliberately NOT std.io_runtime.file_read. In the run20-class seed
# `file_read` infinitely recurses and aborts the process with
# "fatal runtime error: stack overflow" on ANY file, regular or procfs --
# doc/08_tracking/bug/seed_file_read_infinite_recursion_stack_overflow_2026-08-23.md.
# The first landing of this clamp (ff095d31591) used it and took down every
# native-build before step 0/6. `process_run_timeout` is the same mechanism
# native_build_main already uses for `readlink` on this exact path, so it is
# proven live here.
pub fn shard_mem_available_kb() -> i64:
    val (out, _err, code) = process_run_timeout("awk", ["/^MemAvailable:/ {print $2}", "/proc/meminfo"], 2000)
    if code != 0:
        return 0
    shard_mem_available_kb_from_field(out.trim())
@end

# Split out so a spec can feed a fixture without a /proc dependency.
pub fn shard_mem_available_kb_from_field(field: text) -> i64:
    val trimmed = field.trim()
    if trimmed == "" or trimmed.len() > 19:
        return 0
    # Some bootstrap providers saturate overflowing to_i64 input. Reject its
    # decimal magnitude before conversion rather than trusting that sentinel.
    val maximum = "9223372036854775807"
    var larger = false
    var smaller = false
    var index = 0
    while index < trimmed.len():
        val digit = trimmed.byte_at(index)
        if digit < 48 or digit > 57: return 0
        if trimmed.len() == 19 and not larger and not smaller:
            val bound = maximum.byte_at(index)
            if digit > bound: larger = true
            elif digit < bound: smaller = true
        index = index + 1
    if larger: return 0
    val n = trimmed.to_i64() ?? 0
    if n < 0:
        return 0
    n


# Per-worker memory budget in kB. Parse shards run the slim parse-lane entry
# (~1.5 GB, pinned by scripts/check/check-parse-shard-rss-budget.shs); HIR
# shards still spawn the full worker closure (measured 2.4-2.7 GB RSS), so they
# carry a larger budget and are clamped harder. Precedence: the per-phase
# variable (a deliberate override, may go lower), then the host config key
# worker_mem_mib (environment layer SIMPLE_HOST_WORKER_MEM_MIB), then the
# default. The host key is a machine-wide hint shared by every phase, so it may
# only make a phase MORE conservative: a value below the phase default (e.g.
# below the measured HIR RSS behind the 3 GB HIR default) is ignored, with a
# warning, rather than silently loosening the clamp.
pub fn shard_worker_budget_kb(var_name: text, default_kb: i64) -> i64:
    val raw = env_get(var_name) ?? ""
    if raw != "":
        val parsed = shard_mem_available_kb_from_field(raw)
        if parsed > 0:
            return parsed
    val host_kb = shard_host_worker_budget_kb(env_get("SIMPLE_HOST_WORKER_MEM_MIB") ?? "")
    val chosen = shard_host_budget_floor_kb(host_kb, default_kb)
    if host_kb > 0 and chosen != host_kb:
        val host_mib = host_kb / 1024
        print "[shard] ignoring worker_mem_mib={host_mib} MiB below the {var_name} default {default_kb} kB; set {var_name} to lower it deliberately"
    chosen

# worker_mem_mib in kB; 0 (use the default) when absent, invalid or so large
# that the KiB value would overflow i64.
pub fn shard_host_worker_budget_kb(mib_field: text) -> i64:
    val mib = shard_mem_available_kb_from_field(mib_field)
    if mib <= 0 or mib > 9007199254740991:
        return 0
    mib * 1024

# Floor: the host key may raise a phase budget, never lower it.
pub fn shard_host_budget_floor_kb(host_kb: i64, default_kb: i64) -> i64:
    if host_kb > default_kb:
        return host_kb
    default_kb

# Host config key max_threads (environment layer SIMPLE_HOST_MAX_THREADS) is an
# upper bound only: it never raises the request, and absent/invalid is no bound.
pub fn shard_host_threads_cap(requested: i64, max_threads_field: text) -> i64:
    val max_threads = shard_mem_available_kb_from_field(max_threads_field)
    if max_threads > 0 and max_threads < requested:
        return max_threads
    requested

# The clamp itself, pure: N x budget must fit inside 60% of MemAvailable.
# Unknown memory or an invalid estimate permits only the sequential path.
pub fn shard_threads_cap_for(requested: i64, budget_kb: i64, avail_kb: i64) -> i64:
    if requested <= 1:
        return requested
    if budget_kb <= 0 or avail_kb <= 0:
        return 1
    # Divide first; an arbitrary positive i64 input must not overflow at * 6.
    val usable_kb = (avail_kb / 10) * 6 + ((avail_kb % 10) * 6) / 10
    var cap = usable_kb / budget_kb
    if cap < 1:
        cap = 1
    if cap >= requested:
        return requested
    cap

# The tree budget includes the supervisor, compiler and siblings. Keep 40%
# for those owners, just as the host clamp reserves 40% of available memory.
# The enforcing owner exports this hint from its actual enforced RSS cap; the
# watchdog remains the enforcement authority.
#
# DESIGN CHANGE (2026-10-09) to 4584489a62c (2026-10-03). That commit added the
# GlobalMemoryStatusEx probe and, deliberately, sent every Windows run without a
# tree budget down the sequential path, because a correct host-memory answer
# would still miss a much smaller enforced process-tree cap that had not been
# passed down. That fallback serialized every Windows native-build outside the
# transcribing wrapper, sized against per-worker figures the later
# re-measurement no longer supports (real Stage 2 peak below 1 GB per process;
# the ~15 GB reading traced to a 16x Windows /proc unit error -- see the
# 2026-09-26 and 2026-10-03 records).
#
# The hazard is now closed at its root instead: process-tree-rss-watchdog.pl,
# which every enforcing wrapper goes through, exports its enforced cap as
# SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB to the whole tree (keeping a smaller
# inherited one), pinned by scripts/bootstrap/tests/watchdog-shard-budget-export-test.shs.
# So the rule here is uniform on every platform: a declared budget clamps;
# an undeclared one means no enclosing cap and fanout is bounded by measured
# host headroom (60% of min(available physical, available commit) on
# Windows, MemAvailable elsewhere). Unknown host memory is still sequential.
# An enforcing wrapper that bypasses the watchdog is a bug in that wrapper.
pub fn shard_threads_tree_cap_for(requested: i64, budget_kb: i64,
        avail_kb: i64, tree_kb: i64, host_clamp: bool) -> i64:
    if requested <= 1: return requested
    var capped = requested
    if host_clamp:
        capped = shard_threads_cap_for(capped, budget_kb, avail_kb)
    if tree_kb > 0:
        capped = shard_threads_cap_for(capped, budget_kb, tree_kb)
    capped

# An explicit opt-out disables the host estimate, not a known enclosing cap.
# Host config max_threads (SIMPLE_HOST_MAX_THREADS) bounds the request on every
# platform; it can only lower it.
pub fn shard_threads_mem_cap(requested: i64, budget_kb: i64) -> i64:
    if requested <= 1:
        return requested
    val bounded = shard_host_threads_cap(requested, env_get("SIMPLE_HOST_MAX_THREADS") ?? "")
    val host_clamp = (env_get("SIMPLE_SHARD_MEM_CLAMP") ?? "") != "0"
    val avail_kb = if host_clamp: shard_mem_available_kb() else: 0
    val tree_kb = shard_mem_available_kb_from_field(
        env_get("SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB") ?? "")
    val cap = shard_threads_tree_cap_for(bounded, budget_kb, avail_kb,
        tree_kb, host_clamp)
    if cap < requested:
        print "[shard] threads={cap} (requested {requested}, host max_threads bound={bounded}, available={avail_kb} kB, tree budget={tree_kb} kB, worker budget={budget_kb} kB)"
    cap
