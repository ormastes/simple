# Simple Language - Query Lint Advanced Checks
#
# Advanced lint check implementations: match exhaustiveness, closure capture,
# ignored return value, multiline boolean, safety, visibility.

use app.cli.query_helpers.{_count_indent}
use app.cli.query_rich_common.{_diag_emit_or_collect, _find_in_line, _find_in_line_from, _extract_decl_name}
use app.cli.query_lint_scan.{lint_scan_line}
use app.cli.query_source_mask.{code_pattern_line_facts}
export use compiler.tools.fix.rules.impl_.lint_match_exhaustive.{QueryEnumFacts, QueryMexhSpan, MexhFinding, _query_enum_facts, _infer_type_from_patterns, match_exhaustiveness_findings}

# ============================================================================
# MEXH001-005: Match exhaustiveness (text-based heuristic)
# ============================================================================

# Detector lives in compiler.tools.fix.rules.impl_.lint_match_exhaustive so the
# CLI lint engine reports the same findings (RB-DIAG-01, SPL-MATCH-001).
fn _check_match_exhaustiveness_text(lines: [text], file: text, format: text) -> i64:
    var count = 0
    for finding in match_exhaustiveness_findings(lines):
        count = count + _emit_mexh(file, finding.line, finding.span, finding.code, finding.message, format)
    count

fn _emit_mexh(file: text, line_num: i64, span: QueryMexhSpan, code: text, message: text, format: text) -> i64:
    """Emit a MEXH warning in the requested format. Returns 1."""
    if format == "json":
        _diag_emit_or_collect("{\"severity\":2,\"code\":\"{code}\",\"message\":\"{message}\",\"line\":{line_num},\"col\":{span.start_col},\"end_line\":{line_num},\"end_col\":{span.end_col},\"tags\":[],\"source\":\"simple-lint\"}")
    else:
        print "{file}:{line_num}: warning[{code}]: {message}"
    1


# ============================================================================
# CLOS001: Closure modifies outer variable (text-based heuristic)
# ============================================================================

fn _check_closure_capture_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for closure capture modification detection."""
    # Resolve the nearest prior lower-indent declaration boundary in logarithmic
    # time, then advance declaration counts once per (boundary, indent) group.
    # Sibling closures therefore share the same forward scan instead of each
    # rebuilding a dictionary by walking the outer body backward.
    var max_indent = 0
    for source_line in lines:
        val source_indent = _count_indent(source_line)
        if source_indent > max_indent:
            max_indent = source_indent
    var boundary_tree: [i64] = []
    var boundary_slot = 0
    while boundary_slot < max_indent + 2:
        boundary_tree.push(-1)
        boundary_slot = boundary_slot + 1
    var group_by_scope: Dict<text, i64> = {}
    var group_scan_start: [i64] = []
    var group_var_counts: Dict<text, i64> = {}

    var count = 0
    var clos_i = 0
    while clos_i < lines.len():
        val scan = lint_scan_line(lines, clos_i)
        val line = scan.line
        val trimmed = scan.trimmed
        if (trimmed.starts_with("fn ") or trimmed.starts_with("me ")):
            val fn_indent = _count_indent(line)
            if fn_indent > 0:
                # Fenwick prefix maximum over declaration-boundary indentation.
                # Indent d queries stored indentation ranks [0, d).
                var boundary = -1
                var query_slot = fn_indent
                while query_slot > 0:
                    if boundary_tree[query_slot] > boundary:
                        boundary = boundary_tree[query_slot]
                    query_slot = query_slot - (query_slot & (0 - query_slot))

                val scope_key = "{boundary}:{fn_indent}"
                var group_id = 0
                if group_by_scope.contains_key(scope_key):
                    group_id = group_by_scope[scope_key]
                else:
                    group_id = group_scan_start.len()
                    group_by_scope[scope_key] = group_id
                    group_scan_start.push(boundary + 1)

                var scan_i = group_scan_start[group_id]
                while scan_i < clos_i:
                    val prior_line = lines[scan_i]
                    val prior_trimmed = prior_line.trim()
                    if (prior_trimmed.starts_with("var ") and
                        _count_indent(prior_line) <= fn_indent):
                        val var_name = _extract_decl_name(
                            prior_trimmed.substring(4))
                        if var_name != "":
                            val count_key = "{group_id}:{var_name}"
                            group_var_counts[count_key] =
                                (group_var_counts[count_key] ?? 0) + 1
                    scan_i = scan_i + 1
                group_scan_start[group_id] = clos_i + 1

                var body_start = clos_i + 1
                while body_start < lines.len():
                    val bline = lines[body_start]
                    val bt = bline.trim()
                    if bt == "":
                        body_start = body_start + 1
                        continue
                    val bindent = _count_indent(bline)
                    if bindent <= fn_indent:
                        break
                    val assigned = _closure_assignment_target(bt)
                    if assigned != "":
                        val assigned_key = "{group_id}:{assigned}"
                        if group_var_counts.contains_key(assigned_key):
                            var occurrence = 0
                            while occurrence < group_var_counts[assigned_key]:
                                val bline_num = body_start + 1
                                if format == "json":
                                    _diag_emit_or_collect("{\"severity\":2,\"code\":\"CLOS001\",\"message\":\"closure modifies outer variable '{assigned}' — changes won't persist (capture-by-value)\",\"line\":{bline_num},\"col\":1,\"end_line\":{bline_num},\"end_col\":{bt.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                                else:
                                    print "{file}:{bline_num}: warning[CLOS001]: closure modifies outer variable '{assigned}'"
                                count = count + 1
                                occurrence = occurrence + 1
                    body_start = body_start + 1

        # A boundary becomes visible only to following lines. All five legacy
        # forms participate, including top-level and nested declarations.
        val is_boundary = (trimmed.starts_with("fn ") or
            trimmed.starts_with("me ") or
            trimmed.starts_with("static fn ") or
            trimmed.starts_with("class ") or
            trimmed.starts_with("struct "))
        if is_boundary and trimmed != "" and not trimmed.starts_with("#"):
            val boundary_indent = _count_indent(line)
            var update_slot = boundary_indent + 1
            while update_slot < boundary_tree.len():
                if clos_i > boundary_tree[update_slot]:
                    boundary_tree[update_slot] = clos_i
                update_slot = update_slot + (update_slot & (0 - update_slot))
        clos_i = clos_i + 1
    count

fn _closure_assignment_target(trimmed: text) -> text:
    """Extract the leading identifier only when the line assigns to it."""
    var end = 0
    while end < trimmed.len():
        val character = trimmed.substring(end, end + 1)
        val is_identifier = (character >= "a" and character <= "z") or
            (character >= "A" and character <= "Z") or
            (character >= "0" and character <= "9") or character == "_"
        if not is_identifier: break
        end = end + 1
    if end == 0: return ""
    val target = trimmed.substring(0, end)
    val operator = trimmed.substring(end).trim()
    if (operator.starts_with("= ") or operator.starts_with("=\t") or
        operator == "=" or operator.starts_with("+= ") or
        operator.starts_with("-= ") or operator.starts_with("*= ") or
        operator.starts_with("/= ")):
        return target
    ""

# ============================================================================
# RET001: Ignored function return value (text-based heuristic)
# ============================================================================

fn _check_ignored_return_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for ignored return value detection."""
    _check_ignored_return_text_indexed(
        lines, file, format, _query_indent_successor_index(lines))

fn _check_ignored_return_text_indexed(
    lines: [text], file: text, format: text,
    indent_successors: QueryIndentSuccessorIndex
) -> i64:
    """Emit RET001 using caller-owned indentation facts."""
    var count = 0
    val side_effects: [text] = [
        "print", "println", "eprint", "eprintln",
        "push", "pop", "clear", "sort", "reverse", "remove", "insert",
        "write", "close", "flush", "set", "delete", "reset", "append",
        "log", "info", "warn", "error", "debug", "trace",
        "sleep", "exit", "abort", "send", "emit", "notify",
        "lock", "unlock", "continue", "break", "return",
        "pass_todo", "pass_do_nothing", "pass_dn"
    ]
    val side_prefixes: [text] = [
        "set_", "add_", "remove_", "delete_", "clear_", "reset_",
        "push_", "init_", "register_", "emit_", "on_", "handle_",
        "log_", "print_", "write_", "assert", "expect", "check_", "_"
    ]
    var ret_i = 0
    while ret_i < lines.len():
        val scan = lint_scan_line(lines, ret_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        val indent = scan.indent
        if indent > 0 and trimmed.len() > 0:
            val call_name = _extract_call_name_ret(trimmed)
            if call_name != "":
                if (not trimmed.starts_with("val ") and not trimmed.starts_with("var ") and
                    not _is_any_assign_ret(trimmed)):
                    var is_side_effect = false
                    for se in side_effects:
                        if call_name == se:
                            is_side_effect = true
                            break
                    if not is_side_effect:
                        for prefix in side_prefixes:
                            if call_name.starts_with(prefix):
                                is_side_effect = true
                                break
                    if not is_side_effect:
                        if not indent_successors.last_statement[ret_i]:
                            if format == "json":
                                _diag_emit_or_collect("{\"severity\":3,\"code\":\"RET001\",\"message\":\"return value of '{call_name}()' is discarded\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[1],\"source\":\"simple-lint\"}")
                            else:
                                print "{file}:{line_num}: info[RET001]: return value of '{call_name}()' is discarded"
                            count = count + 1
        ret_i = ret_i + 1
    count

fn _check_print_to_log_text(lines: [text], file: text, format: text) -> i64:
    """Warn when production source uses print instead of structured logging.

    Script-style print remains allowed outside src/app, src/lib, and src/compiler.
    """
    if not (file.starts_with("src/app/") or file.starts_with("src/lib/") or file.starts_with("src/compiler/")):
        return 0
    var count = 0
    var li = 0
    while li < lines.len():
        val scan = lint_scan_line(lines, li)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        var is_print = false
        if trimmed == "print":
            is_print = true
        elif trimmed.starts_with("print "):
            is_print = true
        elif trimmed.starts_with("print("):
            is_print = true
        elif trimmed.starts_with("println("):
            is_print = true
        if is_print:
            if format == "json":
                _diag_emit_or_collect("{\"severity\":2,\"code\":\"LOG001\",\"message\":\"use structured logging instead of print in production source; scripts may keep print\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
            else:
                print "{file}:{line_num}: warning[LOG001]: use structured logging instead of print in production source; scripts may keep print"
            count = count + 1
        li = li + 1
    count

fn _extract_call_name_ret(trimmed: text) -> text:
    """Extract function/method call name from a trimmed line."""
    val paren_pos = _find_in_line_from(trimmed, "(", 0)
    if paren_pos <= 0:
        return ""
    val before_paren = trimmed.substring(0, paren_pos)
    if (before_paren == "if" or before_paren == "while" or before_paren == "for" or
        before_paren == "match" or before_paren == "return" or before_paren == "elif"):
        return ""
    var end_idx = before_paren.len()
    var start_idx = end_idx - 1
    while start_idx >= 0:
        val ch = before_paren.substring(start_idx, start_idx + 1)
        val is_id = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
        if not is_id:
            break
        start_idx = start_idx - 1
    start_idx = start_idx + 1
    if start_idx >= end_idx:
        return ""
    before_paren.substring(start_idx, end_idx)

fn _is_any_assign_ret(trimmed: text) -> bool:
    """Check if a line contains an assignment before a function call."""
    val eq_pos = _find_in_line_from(trimmed, " = ", 0)
    val paren_pos = _find_in_line_from(trimmed, "(", 0)
    if eq_pos >= 0 and (paren_pos < 0 or eq_pos < paren_pos):
        return true
    val walrus_pos = _find_in_line_from(trimmed, ":=", 0)
    if walrus_pos >= 0 and (paren_pos < 0 or walrus_pos < paren_pos):
        return true
    false

struct QueryIndentSuccessorIndex:
    last_statement: [bool]
    next_same_or_shallower: [i64]
    is_return_statement: [bool]
    first_executable_column: [i64]
    first_token_end_column: [i64]

fn _query_first_token_end_column(line: text, first_code_column: i64) -> i64:
    if first_code_column <= 0:
        return 0
    var i = first_code_column - 1
    val n = line.byte_len()
    while i < n:
        val byte = line.byte_at(i)
        val is_ident = ((byte >= 48 and byte <= 57) or
            (byte >= 65 and byte <= 90) or byte == 95 or
            (byte >= 97 and byte <= 122))
        if not is_ident:
            break
        i = i + 1
    if i == first_code_column - 1:
        return first_code_column + 1
    i + 1

fn _query_is_return_code_line(
    line: text, first_code_column: i64, return_column: i64
) -> bool:
    if first_code_column <= 0 or return_column != first_code_column:
        return false
    val after = first_code_column - 1 + 6
    if after >= line.byte_len():
        return true
    val byte = line.byte_at(after)
    byte == 32

fn _query_indent_successor_index(lines: [text]) -> QueryIndentSuccessorIndex:
    """Index block successors for each executable source line.

    One stateful lexical projection excludes comments and string payload while
    retaining executable string openers and original columns. A reverse stack then
    exposes the first later executable line at the same or a shallower indent.
    RET001 and UNREACH001 share these facts without suffix rescans.
    """
    val lexical = code_pattern_line_facts(lines, ["return"])
    var last_statement: [bool] = []
    var next_same_or_shallower: [i64] = []
    var is_return_statement: [bool] = []
    var first_executable_column: [i64] = []
    var first_token_end_column: [i64] = []
    var fill = 0
    while fill < lines.len():
        last_statement.push(true)
        next_same_or_shallower.push(-1)
        val executable_column = lexical[fill].first_executable_column
        first_executable_column.push(executable_column)
        first_token_end_column.push(
            _query_first_token_end_column(lines[fill], executable_column))
        is_return_statement.push(_query_is_return_code_line(
            lines[fill], lexical[fill].first_code_column,
            lexical[fill].pattern_columns[0]))
        fill = fill + 1
    var stack: [i64] = []
    var line_index = lines.len() - 1
    while line_index >= 0:
        if first_executable_column[line_index] <= 0:
            line_index = line_index - 1
            continue
        val indent = _count_indent(lines[line_index])
        while (stack.len() > 0 and
            _count_indent(lines[stack.last()]) > indent):
            stack.pop()
        if stack.len() > 0:
            val successor = stack.last()
            next_same_or_shallower[line_index] = successor
            last_statement[line_index] = _count_indent(lines[successor]) < indent
        stack.push(line_index)
        line_index = line_index - 1
    QueryIndentSuccessorIndex(
        last_statement, next_same_or_shallower, is_return_statement,
        first_executable_column, first_token_end_column)

fn _query_last_statement_flags(lines: [text]) -> [bool]:
    _query_indent_successor_index(lines).last_statement

# ============================================================================
# BOOL001: Multiline boolean without parentheses (text-based heuristic)
# ============================================================================

fn _check_multiline_bool_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for multiline boolean detection."""
    var count = 0
    var bool_i = 0
    while bool_i < lines.len():
        val scan = lint_scan_line(lines, bool_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        var keyword = ""
        var cond_start = ""
        if trimmed.starts_with("if "):
            keyword = "if"
            cond_start = trimmed.substring(3)
        elif trimmed.starts_with("elif "):
            keyword = "elif"
            cond_start = trimmed.substring(5)
        elif trimmed.starts_with("while "):
            keyword = "while"
            cond_start = trimmed.substring(6)
        if keyword != "":
            val cs = cond_start.trim()
            var stripped = trimmed
            if stripped.ends_with(":"):
                stripped = stripped.substring(0, stripped.byte_len() - 1).trim()
            val ends_with_bool = (stripped.ends_with(" and") or stripped.ends_with(" or"))
            var next_starts_bool = false
            if bool_i + 1 < lines.len():
                val next_t = lines[bool_i + 1].trim()
                next_starts_bool = (next_t.starts_with("and ") or next_t.starts_with("or "))
            if ends_with_bool or next_starts_bool:
                if not cs.starts_with("("):
                    if format == "json":
                        _diag_emit_or_collect("{\"severity\":2,\"code\":\"BOOL001\",\"message\":\"multiline boolean in '{keyword}' without parentheses — may parse incorrectly\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                    else:
                        print "{file}:{line_num}: warning[BOOL001]: multiline boolean in '{keyword}' without parentheses"
                    count = count + 1
        bool_i = bool_i + 1
    count

# ============================================================================
# SAFE001/SAFE003: Safety violations (text-based heuristic)
# ============================================================================

fn _check_safety_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for safety checking."""
    val safety_patterns = [
        "unsafe:", "unsafe {",
        "asm ", "asm(", "asm",
        "ptr_read(", "ptr_write(", "ptr_cast(", "ptr_offset(",
        "mem_copy(", "mem_set("]
    val facts = code_pattern_line_facts(lines, safety_patterns)
    var count = 0
    var unsafe_indents: [i64] = []
    var safe_i = 0
    while safe_i < lines.len():
        val scan = lint_scan_line(lines, safe_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        val indent = scan.indent
        val line_facts = facts[safe_i]
        val first_code = line_facts.first_code_column
        val columns = line_facts.pattern_columns
        val starts_unsafe_block = (
            (columns[0] > 0 and columns[0] == first_code) or
            (columns[1] > 0 and columns[1] == first_code))
        if first_code > 0:
            while unsafe_indents.len() > 0 and indent <= unsafe_indents[unsafe_indents.len() - 1]:
                unsafe_indents.pop()
        if starts_unsafe_block:
            unsafe_indents.push(indent)
        if unsafe_indents.len() == 0 and indent > 0:
            var asm_col = 0
            var asm_len = 0
            if columns[2] > 0 and columns[2] == first_code:
                asm_col = columns[2]
                asm_len = 4
            elif columns[3] > 0 and columns[3] == first_code:
                asm_col = columns[3]
                asm_len = 4
            elif columns[4] > 0 and columns[4] == first_code and trimmed == "asm":
                asm_col = columns[4]
                asm_len = 3
            if asm_col > 0:
                if format == "json":
                    _diag_emit_or_collect("{\"severity\":1,\"code\":\"SAFE001\",\"message\":\"inline assembly outside unsafe block\",\"line\":{line_num},\"col\":{asm_col},\"end_line\":{line_num},\"end_col\":{asm_col + asm_len},\"tags\":[],\"source\":\"simple-lint\"}")
                else:
                    print "{file}:{line_num}: error[SAFE001]: inline assembly outside unsafe block"
                count = count + 1
            var pointer_col = 0
            var pointer_len = 0
            var pointer_i = 5
            while pointer_i < safety_patterns.len():
                val candidate_col = columns[pointer_i]
                if candidate_col > 0 and (pointer_col == 0 or candidate_col < pointer_col):
                    pointer_col = candidate_col
                    pointer_len = safety_patterns[pointer_i].len()
                pointer_i = pointer_i + 1
            if pointer_col > 0:
                if format == "json":
                    _diag_emit_or_collect("{\"severity\":1,\"code\":\"SAFE003\",\"message\":\"raw pointer operation outside unsafe block\",\"line\":{line_num},\"col\":{pointer_col},\"end_line\":{line_num},\"end_col\":{pointer_col + pointer_len},\"tags\":[],\"source\":\"simple-lint\"}")
                else:
                    print "{file}:{line_num}: error[SAFE003]: raw pointer operation outside unsafe block"
                count = count + 1
        safe_i = safe_i + 1
    count

# ============================================================================
# W0401: Visibility violations (text-based heuristic)
# ============================================================================

fn _check_visibility_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for visibility checking."""
    var count = 0
    var vis_i = 0
    while vis_i < lines.len():
        val scan = lint_scan_line(lines, vis_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        if trimmed.starts_with("use ") and trimmed.contains(".{"):
            val brace_start = _find_in_line_from(trimmed, "{", 0)
            val brace_end = _find_in_line_from(trimmed, "}", 0)
            if brace_start >= 0 and brace_end > brace_start:
                val imports_str = trimmed.substring(brace_start + 1, brace_end)
                val imports = imports_str.split(",")
                for imp in imports:
                    val imp_name = imp.trim()
                    if (imp_name.starts_with("_") and not imp_name.starts_with("__") and
                        imp_name.len() > 1):
                        if format == "json":
                            val col = _find_in_line(trimmed, imp_name) + 1
                            _diag_emit_or_collect("{\"severity\":2,\"code\":\"W0401\",\"message\":\"importing private symbol '{imp_name}' from another module\",\"line\":{line_num},\"col\":{col},\"end_line\":{line_num},\"end_col\":{col + imp_name.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                        else:
                            print "{file}:{line_num}: warning[W0401]: importing private symbol '{imp_name}' from another module"
                        count = count + 1
        vis_i = vis_i + 1
    count
