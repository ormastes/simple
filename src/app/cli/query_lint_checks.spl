# Simple Language - Query Lint Advanced Checks
#
# Advanced lint check implementations: match exhaustiveness, closure capture,
# ignored return value, multiline boolean, safety, visibility.

use app.cli.query_helpers.{_count_indent}
use app.cli.query_rich_common.{_diag_emit_or_collect, _find_in_line, _find_in_line_from, _extract_decl_name}
use app.cli.query_lint_scan.{lint_scan_line}

# ============================================================================
# MEXH001-005: Match exhaustiveness (text-based heuristic)
# ============================================================================

struct QueryEnumFacts:
    variants: [text]
    variant_set: Dict<text, bool>

fn _query_enum_facts(variants: [text]) -> QueryEnumFacts:
    var variant_set: Dict<text, bool> = {}
    for variant in variants:
        variant_set[variant] = true
    QueryEnumFacts(variants, variant_set)

fn _check_match_exhaustiveness_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for match exhaustiveness.

    Checks:
    - MEXH001: Enum match missing variant(s)
    - MEXH002: Match without wildcard/default case
    - MEXH003: Boolean match missing true or false
    - MEXH004: Unreachable arm (after wildcard or duplicate)
    - MEXH005: Option/Result match missing variant(s)

    Pass 1: Collect enum definitions from the file.
    Pass 2: Scan match expressions for exhaustiveness.
    """
    var count = 0

    # Pass 1: Collect enum definitions  { name -> [variant_names] }
    var enum_defs: Dict<text, QueryEnumFacts> = {}
    var li = 0
    while li < lines.len():
        val line = lines[li]
        val trimmed = line.trim()
        if trimmed.starts_with("enum ") and trimmed.ends_with(":"):
            val enum_name = trimmed.substring(5, trimmed.len() - 1).trim()
            val enum_indent = _count_indent(line)
            var variants: [text] = []
            var vi = li + 1
            while vi < lines.len():
                val vline = lines[vi]
                val vt = vline.trim()
                if vt == "":
                    vi = vi + 1
                    continue
                val vindent = _count_indent(vline)
                if vindent <= enum_indent:
                    break
                # Variant line: just a name (possibly with payload)
                val vname = vt.split("(")[0].split(" ")[0].trim()
                if vname != "" and not vname.starts_with("#"):
                    variants.push(vname)
                vi = vi + 1
            if variants.len() > 0:
                enum_defs[enum_name] = _query_enum_facts(variants)
        li = li + 1

    # Add built-in exhaustible types
    if not enum_defs.has("bool"):
        enum_defs["bool"] = _query_enum_facts(["true", "false"])
    if not enum_defs.has("Bool"):
        enum_defs["Bool"] = _query_enum_facts(["true", "false"])
    if not enum_defs.has("Option"):
        enum_defs["Option"] = _query_enum_facts(["Some", "nil"])
    if not enum_defs.has("Result"):
        enum_defs["Result"] = _query_enum_facts(["Ok", "Err"])

    # Pass 2: Scan match expressions
    li = 0
    while li < lines.len():
        val line = lines[li]
        val trimmed = line.trim()

        if trimmed.starts_with("match ") and trimmed.ends_with(":"):
            val match_indent = _count_indent(line)
            val line_num = li + 1

            # Scan case arms
            var has_wildcard = false
            var wildcard_pos = -1
            var arm_count = 0
            var arm_patterns: [text] = []
            var arm_pattern_set: Dict<text, bool> = {}
            var ai = li + 1
            while ai < lines.len():
                val aline = lines[ai]
                val at = aline.trim()
                if at == "":
                    ai = ai + 1
                    continue
                val aindent = _count_indent(aline)
                if aindent <= match_indent:
                    break

                # Extract the pattern name from "case PATTERN:" or "PATTERN:"
                var pat_name = ""
                if at.starts_with("case "):
                    pat_name = at.substring(5).split(":")[0].split("(")[0].trim()
                elif at.contains(":"):
                    pat_name = at.split(":")[0].split("(")[0].trim()

                if pat_name == "_":
                    if not has_wildcard:
                        has_wildcard = true
                        wildcard_pos = arm_count
                    else:
                        # Duplicate wildcard — unreachable
                        count = count + _emit_mexh(file, ai + 1, at.len(), "MEXH004",
                            "unreachable match arm: duplicate wildcard '_'", format)
                elif pat_name != "":
                    # Check for duplicate exact pattern
                    if arm_pattern_set.has(pat_name):
                        count = count + _emit_mexh(file, ai + 1, at.len(), "MEXH004",
                            "unreachable match arm: duplicate pattern '{pat_name}'", format)

                # Check for unreachable arm after wildcard
                if has_wildcard and arm_count > wildcard_pos:
                    count = count + _emit_mexh(file, ai + 1, at.len(), "MEXH004",
                        "unreachable match arm after wildcard '_'", format)

                if pat_name != "" and pat_name != "_":
                    arm_patterns.push(pat_name)
                    arm_pattern_set[pat_name] = true
                arm_count = arm_count + 1
                ai = ai + 1

            # Exhaustiveness checks (only if no wildcard)
            if arm_count > 0 and not has_wildcard:
                # Try to infer type from arm patterns
                var inferred_type = _infer_type_from_patterns(arm_patterns, enum_defs)

                if inferred_type != "":
                    if enum_defs.has(inferred_type):
                        val all_variants = enum_defs[inferred_type].variants
                        var missing: [text] = []
                        for v in all_variants:
                            if not arm_pattern_set.has(v):
                                missing.push(v)

                        if missing.len() > 0:
                            val missing_text = missing.join(", ")
                            val warn_code = if (inferred_type == "bool" or inferred_type == "Bool"):
                                "MEXH003"
                            elif (inferred_type == "Option" or inferred_type == "Result"):
                                "MEXH005"
                            else:
                                "MEXH001"
                            val type_label = if (inferred_type == "bool" or inferred_type == "Bool"):
                                "boolean"
                            elif inferred_type == "Option":
                                "Option<T>"
                            elif inferred_type == "Result":
                                "Result<T, E>"
                            else:
                                "enum '{inferred_type}'"
                            count = count + _emit_mexh(file, line_num, trimmed.len(), warn_code,
                                "non-exhaustive match on {type_label}: missing [{missing_text}]", format)
                else:
                    # Unknown type — generic MEXH002
                    count = count + _emit_mexh(file, line_num, trimmed.len(), "MEXH002",
                        "match expression has no wildcard/default case", format)

        li = li + 1
    count

fn _emit_mexh(file: text, line_num: i64, end_col: i64, code: text, message: text, format: text) -> i64:
    """Emit a MEXH warning in the requested format. Returns 1."""
    if format == "json":
        _diag_emit_or_collect("{\"severity\":2,\"code\":\"{code}\",\"message\":\"{message}\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{end_col},\"tags\":[],\"source\":\"simple-lint\"}")
    else:
        print "{file}:{line_num}: warning[{code}]: {message}"
    1

fn _infer_type_from_patterns(
    patterns: [text], enums: Dict<text, QueryEnumFacts>
) -> text:
    """Infer the match scrutinee type from arm pattern names.

    Checks built-in types first (bool, Option, Result), then
    user-defined enums. Returns the type name or "" if ambiguous.
    """
    if patterns.len() == 0:
        return ""

    # Boolean check
    var all_bool = true
    for p in patterns:
        if p != "true" and p != "false":
            all_bool = false
    if all_bool and patterns.len() > 0:
        return "bool"

    # Option check
    var all_option = true
    for p in patterns:
        if p != "Some" and p != "nil" and p != "None":
            all_option = false
    if all_option and patterns.len() > 0:
        return "Option"

    # Result check
    var all_result = true
    for p in patterns:
        if p != "Ok" and p != "Err":
            all_result = false
    if all_result and patterns.len() > 0:
        return "Result"

    # General enum check: find enums whose variants are a superset
    var matches: [text] = []
    for enum_name in enums.keys():
        if (enum_name == "bool" or enum_name == "Bool" or
            enum_name == "Option" or enum_name == "Result"):
            continue
        val variants = enums[enum_name].variant_set
        var is_subset = true
        for p in patterns:
            if not variants.has(p):
                is_subset = false
        if is_subset:
            matches.push(enum_name)

    if matches.len() == 1:
        return matches[0]

    ""

# ============================================================================
# CLOS001: Closure modifies outer variable (text-based heuristic)
# ============================================================================

fn _check_closure_capture_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for closure capture modification detection."""
    var count = 0
    var clos_i = 0
    while clos_i < lines.len():
        val scan = lint_scan_line(lines, clos_i)
        val line = scan.line
        val trimmed = scan.trimmed
        if (trimmed.starts_with("fn ") or trimmed.starts_with("me ")):
            val fn_indent = _count_indent(line)
            if fn_indent > 0:
                val outer_vars = _collect_outer_var_counts_clos(
                    lines, clos_i, fn_indent)
                var body_start = clos_i + 1
                while body_start < lines.len():
                    val bline = lines[body_start]
                    val bt = bline.trim()
                    if bt == "":
                        body_start = body_start + 1
                        continue
                    val bindent = _count_indent(bline)
                    if bindent <= fn_indent:
                        break
                    val assigned = _closure_assignment_target(bt)
                    if assigned != "" and outer_vars.has(assigned):
                        var occurrence = 0
                        while occurrence < outer_vars[assigned]:
                            val bline_num = body_start + 1
                            if format == "json":
                                _diag_emit_or_collect("{\"severity\":2,\"code\":\"CLOS001\",\"message\":\"closure modifies outer variable '{assigned}' — changes won't persist (capture-by-value)\",\"line\":{bline_num},\"col\":1,\"end_line\":{bline_num},\"end_col\":{bt.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                            else:
                                print "{file}:{bline_num}: warning[CLOS001]: closure modifies outer variable '{assigned}'"
                            count = count + 1
                            occurrence = occurrence + 1
                    body_start = body_start + 1
        clos_i = clos_i + 1
    count

fn _collect_outer_var_counts_clos(
    lines: [text], fn_line: i64, fn_indent: i64
) -> Dict<text, i64>:
    """Collect outer declaration multiplicities without a growing COW array."""
    var vars: Dict<text, i64> = {}
    var si = fn_line - 1
    while si >= 0:
        val sline = lines[si]
        val st = sline.trim()
        val sindent = _count_indent(sline)
        if sindent < fn_indent and st != "" and not st.starts_with("#"):
            if (st.starts_with("fn ") or st.starts_with("me ") or
                st.starts_with("static fn ") or st.starts_with("class ") or
                st.starts_with("struct ")):
                break
        if st.starts_with("var ") and sindent <= fn_indent:
            val var_name = _extract_decl_name(st.substring(4))
            if var_name != "":
                vars[var_name] = (vars[var_name] ?? 0) + 1
        si = si - 1
    vars

fn _closure_assignment_target(trimmed: text) -> text:
    """Extract the leading identifier only when the line assigns to it."""
    var end = 0
    while end < trimmed.len():
        val character = trimmed.substring(end, end + 1)
        val is_identifier = (character >= "a" and character <= "z") or
            (character >= "A" and character <= "Z") or
            (character >= "0" and character <= "9") or character == "_"
        if not is_identifier: break
        end = end + 1
    if end == 0: return ""
    val target = trimmed.substring(0, end)
    val operator = trimmed.substring(end).trim()
    if (operator.starts_with("= ") or operator.starts_with("=\t") or
        operator == "=" or operator.starts_with("+= ") or
        operator.starts_with("-= ") or operator.starts_with("*= ") or
        operator.starts_with("/= ")):
        return target
    ""

# ============================================================================
# RET001: Ignored function return value (text-based heuristic)
# ============================================================================

fn _check_ignored_return_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for ignored return value detection."""
    var count = 0
    val last_statement = _query_last_statement_flags(lines)
    val side_effects: [text] = [
        "print", "println", "eprint", "eprintln",
        "push", "pop", "clear", "sort", "reverse", "remove", "insert",
        "write", "close", "flush", "set", "delete", "reset", "append",
        "log", "info", "warn", "error", "debug", "trace",
        "sleep", "exit", "abort", "send", "emit", "notify",
        "lock", "unlock", "continue", "break", "return",
        "pass_todo", "pass_do_nothing", "pass_dn"
    ]
    val side_prefixes: [text] = [
        "set_", "add_", "remove_", "delete_", "clear_", "reset_",
        "push_", "init_", "register_", "emit_", "on_", "handle_",
        "log_", "print_", "write_", "assert", "expect", "check_", "_"
    ]
    var ret_i = 0
    while ret_i < lines.len():
        val scan = lint_scan_line(lines, ret_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        val indent = scan.indent
        if indent > 0 and trimmed.len() > 0:
            val call_name = _extract_call_name_ret(trimmed)
            if call_name != "":
                if (not trimmed.starts_with("val ") and not trimmed.starts_with("var ") and
                    not _is_any_assign_ret(trimmed)):
                    var is_side_effect = false
                    for se in side_effects:
                        if call_name == se:
                            is_side_effect = true
                            break
                    if not is_side_effect:
                        for prefix in side_prefixes:
                            if call_name.starts_with(prefix):
                                is_side_effect = true
                                break
                    if not is_side_effect:
                        if not last_statement[ret_i]:
                            if format == "json":
                                _diag_emit_or_collect("{\"severity\":3,\"code\":\"RET001\",\"message\":\"return value of '{call_name}()' is discarded\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[1],\"source\":\"simple-lint\"}")
                            else:
                                print "{file}:{line_num}: info[RET001]: return value of '{call_name}()' is discarded"
                            count = count + 1
        ret_i = ret_i + 1
    count

fn _check_print_to_log_text(lines: [text], file: text, format: text) -> i64:
    """Warn when production source uses print instead of structured logging.

    Script-style print remains allowed outside src/app, src/lib, and src/compiler.
    """
    if not (file.starts_with("src/app/") or file.starts_with("src/lib/") or file.starts_with("src/compiler/")):
        return 0
    var count = 0
    var li = 0
    while li < lines.len():
        val scan = lint_scan_line(lines, li)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        var is_print = false
        if trimmed == "print":
            is_print = true
        elif trimmed.starts_with("print "):
            is_print = true
        elif trimmed.starts_with("print("):
            is_print = true
        elif trimmed.starts_with("println("):
            is_print = true
        if is_print:
            if format == "json":
                _diag_emit_or_collect("{\"severity\":2,\"code\":\"LOG001\",\"message\":\"use structured logging instead of print in production source; scripts may keep print\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
            else:
                print "{file}:{line_num}: warning[LOG001]: use structured logging instead of print in production source; scripts may keep print"
            count = count + 1
        li = li + 1
    count

fn _extract_call_name_ret(trimmed: text) -> text:
    """Extract function/method call name from a trimmed line."""
    val paren_pos = _find_in_line_from(trimmed, "(", 0)
    if paren_pos <= 0:
        return ""
    val before_paren = trimmed.substring(0, paren_pos)
    if (before_paren == "if" or before_paren == "while" or before_paren == "for" or
        before_paren == "match" or before_paren == "return" or before_paren == "elif"):
        return ""
    var end_idx = before_paren.len()
    var start_idx = end_idx - 1
    while start_idx >= 0:
        val ch = before_paren.substring(start_idx, start_idx + 1)
        val is_id = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
        if not is_id:
            break
        start_idx = start_idx - 1
    start_idx = start_idx + 1
    if start_idx >= end_idx:
        return ""
    before_paren.substring(start_idx, end_idx)

fn _is_any_assign_ret(trimmed: text) -> bool:
    """Check if a line contains an assignment before a function call."""
    val eq_pos = _find_in_line_from(trimmed, " = ", 0)
    val paren_pos = _find_in_line_from(trimmed, "(", 0)
    if eq_pos >= 0 and (paren_pos < 0 or eq_pos < paren_pos):
        return true
    val walrus_pos = _find_in_line_from(trimmed, ":=", 0)
    if walrus_pos >= 0 and (paren_pos < 0 or walrus_pos < paren_pos):
        return true
    false

fn _query_last_statement_flags(lines: [text]) -> [bool]:
    """Index whether each non-empty line is last at its indentation level.

    A reverse monotonic stack exposes the first later non-empty line at the
    same or a shallower indent. This preserves `_is_last_stmt_ret` semantics
    without scanning the suffix once per call candidate.
    """
    var result: [bool] = []
    var fill = 0
    while fill < lines.len():
        result.push(true)
        fill = fill + 1
    var stack: [i64] = []
    var line_index = lines.len() - 1
    while line_index >= 0:
        if lines[line_index].trim() == "":
            line_index = line_index - 1
            continue
        val indent = _count_indent(lines[line_index])
        while (stack.len() > 0 and
            _count_indent(lines[stack.last()]) > indent):
            stack.pop()
        if stack.len() > 0:
            result[line_index] = _count_indent(lines[stack.last()]) < indent
        stack.push(line_index)
        line_index = line_index - 1
    result

# ============================================================================
# BOOL001: Multiline boolean without parentheses (text-based heuristic)
# ============================================================================

fn _check_multiline_bool_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for multiline boolean detection."""
    var count = 0
    var bool_i = 0
    while bool_i < lines.len():
        val scan = lint_scan_line(lines, bool_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        var keyword = ""
        var cond_start = ""
        if trimmed.starts_with("if "):
            keyword = "if"
            cond_start = trimmed.substring(3)
        elif trimmed.starts_with("elif "):
            keyword = "elif"
            cond_start = trimmed.substring(5)
        elif trimmed.starts_with("while "):
            keyword = "while"
            cond_start = trimmed.substring(6)
        if keyword != "":
            val cs = cond_start.trim()
            var stripped = trimmed
            if stripped.ends_with(":"):
                stripped = stripped.substring(0, stripped.len() - 1).trim()
            val ends_with_bool = (stripped.ends_with(" and") or stripped.ends_with(" or"))
            var next_starts_bool = false
            if bool_i + 1 < lines.len():
                val next_t = lines[bool_i + 1].trim()
                next_starts_bool = (next_t.starts_with("and ") or next_t.starts_with("or "))
            if ends_with_bool or next_starts_bool:
                if not cs.starts_with("("):
                    if format == "json":
                        _diag_emit_or_collect("{\"severity\":2,\"code\":\"BOOL001\",\"message\":\"multiline boolean in '{keyword}' without parentheses — may parse incorrectly\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                    else:
                        print "{file}:{line_num}: warning[BOOL001]: multiline boolean in '{keyword}' without parentheses"
                    count = count + 1
        bool_i = bool_i + 1
    count

# ============================================================================
# SAFE001/SAFE003: Safety violations (text-based heuristic)
# ============================================================================

fn _check_safety_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for safety checking."""
    var count = 0
    var in_unsafe = false
    var unsafe_indent = -1
    var safe_i = 0
    while safe_i < lines.len():
        val scan = lint_scan_line(lines, safe_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        val indent = scan.indent
        if trimmed.starts_with("unsafe:") or trimmed.starts_with("unsafe {"):
            in_unsafe = true
            unsafe_indent = indent
        if in_unsafe and indent <= unsafe_indent and trimmed != "" and not trimmed.starts_with("unsafe"):
            in_unsafe = false
            unsafe_indent = -1
        if not in_unsafe and indent > 0:
            if trimmed.starts_with("asm ") or trimmed.starts_with("asm(") or trimmed == "asm":
                if format == "json":
                    _diag_emit_or_collect("{\"severity\":1,\"code\":\"SAFE001\",\"message\":\"inline assembly outside unsafe block\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                else:
                    print "{file}:{line_num}: error[SAFE001]: inline assembly outside unsafe block"
                count = count + 1
            if (trimmed.contains("ptr_read(") or trimmed.contains("ptr_write(") or
                trimmed.contains("ptr_cast(") or trimmed.contains("ptr_offset(") or
                trimmed.contains("mem_copy(") or trimmed.contains("mem_set(")):
                if format == "json":
                    _diag_emit_or_collect("{\"severity\":1,\"code\":\"SAFE003\",\"message\":\"raw pointer operation outside unsafe block\",\"line\":{line_num},\"col\":1,\"end_line\":{line_num},\"end_col\":{trimmed.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                else:
                    print "{file}:{line_num}: error[SAFE003]: raw pointer operation outside unsafe block"
                count = count + 1
        safe_i = safe_i + 1
    count

# ============================================================================
# W0401: Visibility violations (text-based heuristic)
# ============================================================================

fn _check_visibility_text(lines: [text], file: text, format: text) -> i64:
    """Text-based heuristic for visibility checking."""
    var count = 0
    var vis_i = 0
    while vis_i < lines.len():
        val scan = lint_scan_line(lines, vis_i)
        val trimmed = scan.trimmed
        val line_num = scan.line_num
        if trimmed.starts_with("use ") and trimmed.contains(".{"):
            val brace_start = _find_in_line_from(trimmed, "{", 0)
            val brace_end = _find_in_line_from(trimmed, "}", 0)
            if brace_start >= 0 and brace_end > brace_start:
                val imports_str = trimmed.substring(brace_start + 1, brace_end)
                val imports = imports_str.split(",")
                for imp in imports:
                    val imp_name = imp.trim()
                    if (imp_name.starts_with("_") and not imp_name.starts_with("__") and
                        imp_name.len() > 1):
                        if format == "json":
                            val col = _find_in_line(trimmed, imp_name) + 1
                            _diag_emit_or_collect("{\"severity\":2,\"code\":\"W0401\",\"message\":\"importing private symbol '{imp_name}' from another module\",\"line\":{line_num},\"col\":{col},\"end_line\":{line_num},\"end_col\":{col + imp_name.len()},\"tags\":[],\"source\":\"simple-lint\"}")
                        else:
                            print "{file}:{line_num}: warning[W0401]: importing private symbol '{imp_name}' from another module"
                        count = count + 1
        vis_i = vis_i + 1
    count
