# Query Engine - Structured code analysis using lightweight heuristic parsing
#
# Replaces grep-based query functions with scope-aware, line-based parsing.
# Each function parses the target file into a lightweight outline and queries it.
# Falls back to a BOUNDED pure-Simple walk for cross-file references (it used to
# shell out to an unbounded `grep -rn`; see
# src/lib/nogc_sync_mut/lsp/lsp_bounded_search.spl).
#
# Each public `engine_*` is a thin printer over an `engine_*_lines` core that
# RETURNS its lines. The in-process MCP adapter
# (app.simple_lsp_mcp.lsp_query_inproc) calls the cores directly, so it needs no
# child process and stays byte-identical to the printed one-shot by construction.
#
# Functions: engine_find_definition, engine_find_references, engine_hover,
#            engine_completions, engine_type_at, engine_signature_help,
#            engine_document_symbols

use app.cli.query_rich_common.{query_file_read_rich}
use std.nogc_sync_mut.lsp.lsp_bounded_search.{lsp_bounded_search_budget_default_v1,
    lsp_bounded_search_word_v1, lsp_bounded_search_decl_v1,
    lsp_bounded_search_truncation_note_v1}
use app.cli.query_helpers.{_extract_params_from, _extract_ident_from, _extract_return_from, _count_indent}
use app.cli.query_outline.{OutlineSymbol, OutlineImport, OutlineSnapshot,
    OutlineOptions, parse_outline_file, parse_outline_snapshot,
    parse_outline_import_lines}

# ============================================================================
# Internal Types (used within this file only)
# ============================================================================


struct _ImportedSym:
    source_file: text
    module_path: text
    symbol: OutlineSymbol

# ============================================================================
# Lightweight Heuristic Parser
# ============================================================================

fn _parse_file(file: text) -> [OutlineSymbol]:
    parse_outline_file(file, OutlineOptions(parent_for_types: false, include_import_symbols: false, include_fields: false, extract_binding_types: true))

fn _parse_snapshot(file: text) -> OutlineSnapshot:
    parse_outline_snapshot(file, OutlineOptions(parent_for_types: false,
        include_import_symbols: false, include_fields: false,
        extract_binding_types: true))

# ============================================================================
# Bounded cross-file search (replaces the unbounded `grep -rn` child)
# ============================================================================

# Both helpers return (lines, truncation_note). The note is "" when the walk
# covered its whole root; callers append it so a short answer is never presented
# as a complete one.
fn _bounded_decl_search(symbol: text) -> ([text], text):
    val found = lsp_bounded_search_decl_v1(
        "src", ".spl", symbol, lsp_bounded_search_budget_default_v1())
    (found.lines, lsp_bounded_search_truncation_note_v1(found))

fn _bounded_word_search(symbol: text) -> ([text], text):
    val found = lsp_bounded_search_word_v1(
        "src", ".spl", symbol, lsp_bounded_search_budget_default_v1())
    (found.lines, lsp_bounded_search_truncation_note_v1(found))

fn _print_lines(lines: [text]):
    for line in lines:
        print line

fn _collect_imported_symbols(imports: [OutlineImport]) -> [_ImportedSym]:
    var imported: [_ImportedSym] = []
    for imp in imports:
        val resolved = _resolve_module_path(imp.module_path)
        if resolved != "":
            val imp_syms = _parse_file(resolved)
            for sym in imp_syms:
                imported.push(_ImportedSym(source_file: resolved, module_path: imp.module_path, symbol: sym))
    imported

# ============================================================================
# Public Engine Functions
# ============================================================================

# Find definition of symbol — scope-aware, cross-file via imports
fn engine_find_definition_lines(file: text, symbol: text) -> ([text], i64):
    var out: [text] = []
    val snapshot = _parse_snapshot(file)
    val symbols = snapshot.symbols
    var found = false

    # Search in file's own symbols
    for sym in symbols:
        if sym.name == symbol:
            if sym.parent != "":
                out.push("{file}:{sym.line}: [{sym.kind}] {sym.parent}.{sym.name}")
            else:
                out.push("{file}:{sym.line}: [{sym.kind}] {sym.signature}")
            found = true

    if found:
        return (out, 0)

    for imported in _collect_imported_symbols(
        parse_outline_import_lines(snapshot.lines)):
        val sym = imported.symbol
        if sym.name == symbol:
            out.push("{imported.source_file}:{sym.line}: [{sym.kind}] {sym.signature}")
            found = true

    if found:
        return (out, 0)

    # Fallback: bounded walk across src/
    val (hits, note) = _bounded_decl_search(symbol)
    if hits.len() > 0:
        # Limit output
        var count = 0
        for rline in hits:
            if rline.trim() != "" and count < 20:
                out.push(rline)
                count = count + 1
        if note != "":
            out.push(note)
        return (out, 0)

    out.push("No definition found for: {symbol}")
    if note != "":
        out.push(note)
    (out, 1)

fn engine_find_definition(file: text, symbol: text) -> i64:
    val (lines, code) = engine_find_definition_lines(file, symbol)
    _print_lines(lines)
    code

# Find references to symbol — same-file outline + bounded cross-file walk
fn engine_find_references_lines(file: text, symbol: text) -> ([text], i64):
    var out: [text] = []
    val content = query_file_read_rich(file) ?? ""
    var found_count = 0

    # Same-file: scan all lines for word boundary matches
    if content != "":
        val lines = content.split("\n")
        var li = 0
        while li < lines.len():
            val line = lines[li]
            li = li + 1
            if _contains_word(line, symbol):
                out.push("{file}:{li}: {line.trim()}")
                found_count = found_count + 1

    # Cross-file references via the bounded walk
    val (hits, note) = _bounded_word_search(symbol)
    if hits.len() > 0:
        var count = 0
        for rline in hits:
            val rt = rline.trim()
            if rt != "" and not rt.starts_with(file + ":") and count < 50:
                out.push(rt)
                count = count + 1
                found_count = found_count + 1

    if found_count == 0:
        out.push("No references found for: {symbol}")
        if note != "":
            out.push(note)
        return (out, 1)
    if note != "":
        out.push(note)
    (out, 0)

fn engine_find_references(file: text, symbol: text) -> i64:
    val (lines, code) = engine_find_references_lines(file, symbol)
    _print_lines(lines)
    code

# Hover info — type signature + doc comment + kind from outline
fn engine_hover_lines(file: text, line_num: i64, symbol: text) -> ([text], i64):
    val snapshot = _parse_snapshot(file)
    val symbols = snapshot.symbols

    # First check in this file's symbols
    for sym in symbols:
        if sym.name == symbol:
            return (_hover_info_lines(sym, file), 0)

    for imported in _collect_imported_symbols(
        parse_outline_import_lines(snapshot.lines)):
        val sym = imported.symbol
        if sym.name == symbol:
            return (_hover_info_lines(sym, imported.source_file), 0)

    # Fallback: basic info
    var out: [text] = []
    out.push("Symbol: {symbol}")
    out.push("Location: {file}:{line_num}")

    val (hits, note) = _bounded_decl_search(symbol)
    if hits.len() > 0:
        out.push("")
        out.push("Definition:")
        var dc = 0
        for dl in hits:
            if dl.trim() != "" and dc < 5:
                out.push(dl)
                dc = dc + 1
    if note != "":
        out.push(note)
    (out, 0)

fn engine_hover(file: text, line_num: i64, symbol: text) -> i64:
    val (lines, code) = engine_hover_lines(file, line_num, symbol)
    _print_lines(lines)
    code

fn _hover_info_lines(sym: OutlineSymbol, file: text) -> [text]:
    var out: [text] = []
    out.push("Symbol: {sym.name}")
    out.push("Kind: {sym.kind}")
    out.push("Location: {file}:{sym.line}")
    if sym.parent != "":
        out.push("Parent: {sym.parent}")
    out.push("")
    out.push("Signature:")
    out.push("  {sym.signature}")
    if sym.return_type != "":
        out.push("Return type: {sym.return_type}")
    if sym.params != "":
        out.push("Parameters: {sym.params}")
    if sym.doc_comment != "":
        out.push("")
        out.push("Documentation:")
        val doc_lines = sym.doc_comment.split("\n")
        for dl in doc_lines:
            out.push("  {dl}")
    out

# Completions — collect local symbols + imported symbols + keywords
fn engine_completions_lines(file: text, line_num: i64, prefix: text) -> ([text], i64):
    var out: [text] = []
    var found: [text] = []
    val snapshot = _parse_snapshot(file)
    val symbols = snapshot.symbols

    # Local symbols matching prefix
    out.push("--- Local ---")
    for sym in symbols:
        if sym.name.starts_with(prefix) and not _list_contains(found, sym.name):
            out.push("{sym.name} [{sym.kind}]")
            found.push(sym.name)

    var imp_found: [text] = []
    for imported in _collect_imported_symbols(
        parse_outline_import_lines(snapshot.lines)):
        val sym = imported.symbol
        if sym.name.starts_with(prefix) and not _list_contains(imp_found, sym.name) and not _list_contains(found, sym.name):
            imp_found.push(sym.name + " [" + sym.kind + "] (" + imported.module_path + ")")

    if imp_found.len() > 0:
        out.push("")
        out.push("--- Imported ---")
        for entry in imp_found:
            out.push(entry)

    # Keywords matching prefix
    val keywords = _matching_keywords(prefix)
    if keywords.len() > 0:
        out.push("")
        out.push("--- Keywords ---")
        for kw in keywords:
            out.push(kw)

    (out, 0)

fn engine_completions(file: text, line_num: i64, prefix: text) -> i64:
    val (lines, code) = engine_completions_lines(file, line_num, prefix)
    _print_lines(lines)
    code

# Type at position — extract type from declaration
fn engine_type_at_lines(file: text, line_num: i64, symbol: text) -> ([text], i64):
    var out: [text] = []
    val snapshot = _parse_snapshot(file)
    val symbols = snapshot.symbols

    # Read the line at position
    if line_num >= 1 and line_num <= snapshot.lines.len():
        out.push("Line {line_num}: {snapshot.lines[line_num - 1].trim()}")

    out.push("Symbol: {symbol}")

    for sym in symbols:
        if sym.name == symbol:
            if sym.return_type != "":
                out.push("Type: {sym.return_type}")
            elif sym.kind == "class" or sym.kind == "struct" or sym.kind == "enum" or sym.kind == "trait":
                out.push("Type: {sym.kind} {sym.name}")
            else:
                out.push("Type: (inferred)")
            out.push("Kind: {sym.kind}")
            out.push("Definition: {sym.signature}")
            return (out, 0)

    for imported in _collect_imported_symbols(
        parse_outline_import_lines(snapshot.lines)):
        val sym = imported.symbol
        if sym.name == symbol:
            if sym.return_type != "":
                out.push("Type: {sym.return_type}")
            else:
                out.push("Type: {sym.kind} {sym.name}")
            out.push("Source: {imported.source_file}:{sym.line}")
            return (out, 0)

    out.push("Type: (unknown)")
    (out, 0)

fn engine_type_at(file: text, line_num: i64, symbol: text) -> i64:
    val (lines, code) = engine_type_at_lines(file, line_num, symbol)
    _print_lines(lines)
    code

# Signature help — function params with types, active param index
fn engine_signature_help_lines(file: text, line_num: i64, col: i64, symbol: text) -> ([text], i64):
    var out: [text] = []
    var fn_sym: OutlineSymbol = OutlineSymbol(name: "", kind: "", line: 0, signature: "", doc_comment: "", parent: "", return_type: "", params: "")
    var found_fn = false

    # Search in file
    val snapshot = _parse_snapshot(file)
    val symbols = snapshot.symbols
    for sym in symbols:
        if sym.name == symbol and (sym.kind == "fn" or sym.kind == "method" or sym.kind == "static_method" or sym.kind == "extern_fn"):
            fn_sym = sym
            found_fn = true
            break

    # Search imported files if not found
    if not found_fn:
        for imported in _collect_imported_symbols(
            parse_outline_import_lines(snapshot.lines)):
            val sym = imported.symbol
            if sym.name == symbol and (sym.kind == "fn" or sym.kind == "method" or sym.kind == "static_method" or sym.kind == "extern_fn"):
                fn_sym = sym
                found_fn = true
                break

    if not found_fn:
        out.push("No function definition found for: {symbol}")
        return (out, 1)

    # Count commas before cursor to find active parameter
    var active_param = 0
    if col > 0:
        if line_num >= 1 and line_num <= snapshot.lines.len():
            val call_line = snapshot.lines[line_num - 1]
            var paren_depth = 0
            var ci = 0
            while ci < col and ci < call_line.len():
                val c = call_line.substring(ci, ci + 1)
                if c == "(":
                    paren_depth = paren_depth + 1
                elif c == ")":
                    paren_depth = paren_depth - 1
                elif c == "," and paren_depth == 1:
                    active_param = active_param + 1
                ci = ci + 1

    out.push("Function: {fn_sym.name}")
    out.push("Parameters: {fn_sym.params}")
    if fn_sym.return_type != "":
        out.push("Returns: {fn_sym.return_type}")
    out.push("Active parameter: {active_param}")
    (out, 0)

fn engine_signature_help(file: text, line_num: i64, col: i64, symbol: text) -> i64:
    val (lines, code) = engine_signature_help_lines(file, line_num, col, symbol)
    _print_lines(lines)
    code

# Document symbols — list all symbols with kind and line
fn engine_document_symbols_lines(file: text) -> ([text], i64):
    var out: [text] = []
    val symbols = _parse_file(file)
    if symbols.len() == 0:
        out.push("No symbols found in {file}")
        return (out, 0)
    for sym in symbols:
        if sym.parent != "":
            out.push("{sym.name}:{sym.kind}:{sym.line} (in {sym.parent})")
        else:
            out.push("{sym.name}:{sym.kind}:{sym.line}")
    (out, 0)

fn engine_document_symbols(file: text) -> i64:
    val (lines, code) = engine_document_symbols_lines(file)
    _print_lines(lines)
    code

# ============================================================================
# Utility Helpers
# ============================================================================

fn _resolve_module_path(mod_path: text) -> text:
    # Convert module path (std.text, app.cli.query) to file path
    if mod_path.contains("/"):
        val slash_parts = mod_path.split("/")
        if slash_parts.len() >= 2 and slash_parts[0].contains("-"):
            val owner_segment = slash_parts[0]
            val owner_domain = owner_segment.replace("-", "_")
            val type_base = "src/type/" + owner_domain + "/" + slash_parts[1..].join("/")
            val type_mod = type_base + "/mod.spl"
            val type_direct = type_base + ".spl"
            val type_mod_content = query_file_read_rich(type_mod) ?? ""
            if type_mod_content != "":
                return type_mod
            val type_direct_content = query_file_read_rich(type_direct) ?? ""
            if type_direct_content != "":
                return type_direct

    if not mod_path.contains("."):
        val type_base = "src/type/simple_lang/" + mod_path
        val type_mod = type_base + "/mod.spl"
        val type_direct = type_base + ".spl"
        val type_mod_content = query_file_read_rich(type_mod) ?? ""
        if type_mod_content != "":
            return type_mod
        val type_direct_content = query_file_read_rich(type_direct) ?? ""
        if type_direct_content != "":
            return type_direct

    var path = mod_path
    # std -> lib
    if path.starts_with("std."):
        path = "lib." + path.substring(4)
    elif path.starts_with("lib."):
        pass
    elif path.starts_with("app."):
        pass
    elif path.starts_with("compiler."):
        pass
    else:
        path = "lib." + path

    # Replace dots with /
    var parts = path.split(".")
    var file_path = "src/" + parts.join("/")

    # Try mod.spl first, then direct .spl
    val mod_file = file_path + "/mod.spl"
    val direct_file = file_path + ".spl"

    # Check mod.spl
    val mod_content = query_file_read_rich(mod_file) ?? ""
    if mod_content != "":
        return mod_file

    # Check direct .spl
    val direct_content = query_file_read_rich(direct_file) ?? ""
    if direct_content != "":
        return direct_file

    ""

fn _contains_word(line: text, word: text) -> bool:
    # Check if line contains the word with word boundary-like checks
    var pos = 0
    while pos <= line.len() - word.len():
        val candidate = line.substring(pos, pos + word.len())
        if candidate == word:
            # Check boundaries
            var left_ok = true
            var right_ok = true
            if pos > 0:
                val lch = line.substring(pos - 1, pos)
                left_ok = not _is_word_char(lch)
            if pos + word.len() < line.len():
                val rch = line.substring(pos + word.len(), pos + word.len() + 1)
                right_ok = not _is_word_char(rch)
            if left_ok and right_ok:
                return true
        pos = pos + 1
    false

fn _is_word_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"

fn _list_contains(items: [text], item: text) -> bool:
    for x in items:
        if x == item:
            return true
    false

fn _matching_keywords(prefix: text) -> [text]:
    val all_kw = ["fn", "val", "var", "class", "struct", "enum", "trait", "impl", "if", "elif", "else", "for", "while", "match", "case", "return", "break", "continue", "use", "import", "export", "extern", "static", "me", "in", "not", "and", "or", "true", "false", "nil", "self"]
    var result: [text] = []
    for kw in all_kw:
        if kw.starts_with(prefix):
            result.push(kw)
    result
