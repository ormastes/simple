# Exact environment save/restore for the native-build coordinator.
#
# `env_set(key, old)` with `old = env_get(key) ?? ""` leaves a key that was
# ABSENT before present-but-empty afterwards. The HIR worker profile
# (worker_hir_profile_v1.spl) admits the parent's environment by key presence
# and rejects unknown keys, so every such restore that ran before HIR admission
# refused the HIR pool (2026-11-12: SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING,
# SIMPLE_PARSE_SHARD_QUEUE, SIMPLE_NATIVE_BUILD_WARM_CLOSURE_CANDIDATE). The
# environment fingerprint also folds present SIMPLE_* keys, so a stray empty
# key shifted cache scopes too.
use app.io.env_ops.{env_set, env_unset}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}

# The key's current value, or None when it is not set at all.
pub fn native_build_env_saved_v1(key: text) -> text?:
    env_get_nullable(key)

# Put `key` back exactly: its saved value, or absent when it was absent.
pub fn native_build_env_restore_v1(key: text, saved: text?):
    if val value = saved:
        env_set(key, value)
    else:
        env_unset(key)

export native_build_env_saved_v1, native_build_env_restore_v1
