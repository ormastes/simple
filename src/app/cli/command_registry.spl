# Canonical structured registry for the production root CLI.
#
# Command names, route identity, help grouping, usage, summaries, and completion
# metadata live here once. Help rendering, completion, the compatibility command
# table, and root command admission are projections of these records.

use std.common.crypto.sha256.{sha256_text}

class CliCommandSpecV1:
    name: text
    usage_tail: text
    summary: text
    group: text
    route_kind: text
    route_target: text
    app_path: text

class CliHelpDetailV1:
    group: text
    owner: text
    usage_tail: text
    summary: text
    row_kind: text

class CliOptionSpecV1:
    owner: text
    token: text
    usage_tail: text
    summary: text
    group: text
    visible: bool

fn _cmd(name: text, usage_tail: text, summary: text, group: text,
        route_kind: text, route_target: text, app_path: text) -> CliCommandSpecV1:
    CliCommandSpecV1(name: name, usage_tail: usage_tail, summary: summary,
        group: group, route_kind: route_kind, route_target: route_target,
        app_path: app_path)

