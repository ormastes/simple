fn cli_help_groups_v1() -> [text]:
    ["Usage", "Testing", "Code Quality", "LLM-Friendly Tools", "Project Info",
        "SFFI Generation", "Build System", "Package Management",
        "Version Control (JJ)", "Running and REPL", "Editing and Debugging",
        "Code Generation and Docs", "Project and Packaging", "Media and Games",
        "Options", "Execution Mode", "Fault Detection", "Examples",
        "Experimental (subject to change)"]

fn _detail(group: text, owner: text, usage_tail: text, summary: text,
        row_kind: text) -> CliHelpDetailV1:
    CliHelpDetailV1(group: group, owner: owner, usage_tail: usage_tail,
        summary: summary, row_kind: row_kind)

