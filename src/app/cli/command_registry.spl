        _detail("Options", "", "--low-memory", "Aggressive memory eviction between compilation phases", "option"),
        _detail("Execution Mode", "", "--run-config", "", "registered-option"),
        _detail("Execution Mode", "", "--backend", "", "registered-option"),
        _detail("Execution Mode", "", "--interpret", "", "registered-option"),
        _detail("Execution Mode", "", "--interpret-optimized", "", "registered-option"),
        _detail("Execution Mode", "", "--interpreter-mode", "", "registered-option"),
        _detail("Execution Mode", "", "--mem-infra", "", "registered-option"),
        _detail("Execution Mode", "", "SIMPLE_EXECUTION_MODE env var", "jit|interpret|interpreter|interpret-optimized|cranelift|llvm", "option"),
        _detail("Execution Mode", "", "", "THE reliable way to force the interpreter. The --interpret", "note"),
        _detail("Execution Mode", "", "", "and --no-jit flags are no-ops on the bootstrap seed binary.", "note"),
        _detail("Execution Mode", "", "", "doc/07_guide/runtime/execution_engine_selection.md", "note"),
        _detail("Fault Detection", "", "--no-jit", "", "registered-option"),
        _detail("Fault Detection", "", "--jit-threshold", "", "registered-option"),
        _detail("Fault Detection", "", "--backend=NAME", "JIT backend: auto, cranelift, llvm", "option"),
        _detail("Fault Detection", "", "--stack-overflow-detection", "", "registered-option"),
        _detail("Fault Detection", "", "--no-stack-overflow-detection", "", "registered-option"),
        _detail("Fault Detection", "", "--max-recursion-depth", "", "registered-option"),
        _detail("Fault Detection", "", "--timeout", "", "registered-option"),
        _detail("Fault Detection", "", "--execution-limit", "", "registered-option"),
        _detail("Examples", "", "", "Start REPL", "example"),
        _detail("Examples", "", "hello.spl", "Run source", "example"),
        _detail("Examples", "", "-c \"print 42\"", "Run expression", "example"),
        _detail("Examples", "", "compile app.spl --opt-level=aggressive", "Compile to native", "example"),
        _detail("Examples", "", "test", "Run all tests", "example"),
    ]

fn _option(owner: text, token: text, usage_tail: text, summary: text,
        group: text, visible: bool) -> CliOptionSpecV1:
    CliOptionSpecV1(owner: owner, token: token, usage_tail: usage_tail,
        summary: summary, group: group, visible: visible)

fn cli_option_registry_v1() -> [CliOptionSpecV1]:
    [
        _option("log", "--count", "--count", "Count progress output", "Shared log options", false),
        _option("log", "--dots", "--dots", "Dot progress output", "Shared log options", false),
        _option("log", "--human", "--human", "Human log mode", "Shared log options", false),
        _option("log", "--json", "--json", "JSON log mode", "Shared log options", false),
        _option("log", "--llm", "--llm", "LLM log mode", "Shared log options", false),
        _option("log", "--log-mode", "--log-mode=<mode>", "Select log mode", "Shared log options", false),
        _option("log", "--no-progress", "--no-progress", "Disable progress output", "Shared log options", false),
        _option("log", "--progress", "--progress=<mode>", "Select progress mode", "Shared log options", false),
        _option("log", "--quiet", "--quiet", "Suppress non-error output", "Shared log options", false),
        _option("log", "--stdout", "--stdout", "Write logs to stdout", "Shared log options", false),
        _option("log", "--surface", "--surface=<name>", "Select output surface", "Shared log options", false),
        _option("log", "--tui", "--tui", "TUI output surface", "Shared log options", false),
        _option("log", "--verbose", "--verbose", "Verbose output", "Shared log options", false),
        _option("runtime", "--backend", "--backend=auto|cranelift|llvm", "Select JIT backend (default: auto)", "Execution Mode", true),
        _option("runtime", "--execution-limit", "--execution-limit=N", "Set instruction count limit", "Fault Detection", true),
        _option("runtime", "--fixed-be", "--fixed-be=<name>", "Select fixed backend", "Execution Mode", false),
        _option("runtime", "--gc-log", "--gc-log", "Enable verbose GC logging", "Options", true),
        _option("runtime", "--gc-off", "--gc-off", "Disable garbage collection", "Options", true),
        _option("runtime", "--interpret", "--interpret", "Force interpreter mode (no JIT)", "Execution Mode", true),
        _option("runtime", "--interpret-optimized", "--interpret-optimized", "Alias for shared/optimized interpreter mode", "Execution Mode", true),
        _option("runtime", "--interpreter-mode", "--interpreter-mode=optimized|classic", "Select interpreter mode (classic is legacy)", "Execution Mode", true),
        _option("runtime", "--jit-threshold", "--jit-threshold=N", "JIT compile after N calls (default: 10)", "Fault Detection", true),
        _option("runtime", "--max-recursion-depth", "--max-recursion-depth=N", "Set max call depth (default: 1000)", "Fault Detection", true),
        _option("runtime", "--mem-infra", "--mem-infra=a,b,c[,auto] [--mem-infra-strict]", "Enable memory-infra rows (attr, guard, harden, genarena, strict, asan, memprof) for the active backend", "Execution Mode", true),
        _option("runtime", "--mem-infra-strict", "--mem-infra-strict", "Require memory infrastructure", "Execution Mode", false),
        _option("runtime", "--no-jit", "--no-jit", "Disable JIT compilation (pure tree-walk)", "Fault Detection", true),
        _option("runtime", "--no-stack-overflow-detection", "--no-stack-overflow-detection", "Disable recursion depth check", "Fault Detection", true),
        _option("runtime", "--notui", "--notui", "Use Normal REPL instead of TUI", "Options", true),
        _option("runtime", "--run-config", "--run-config=shared|interpreter|compiler|legacy", "Set execution behavior (default: shared)", "Execution Mode", true),
        _option("runtime", "--stack-overflow-detection", "--stack-overflow-detection", "Enable recursion depth check", "Fault Detection", true),
        _option("runtime", "--timeout", "--timeout=N", "Set wall-clock timeout in seconds", "Fault Detection", true),
    ]

fn cli_registry_command_names_v1() -> [text]:
    var names: [text] = []
    for spec in cli_command_registry_v1():
        names.push(spec.name)
    names.sort()
    names

fn cli_registry_option_tokens_v1(owner: text) -> [text]:
    var tokens: [text] = []
    for option in cli_option_registry_v1():
        if option.owner == owner:
            tokens.push(option.token)
    tokens

fn cli_registry_find_command_v1(name: text) -> CliCommandSpecV1?:
    for spec in cli_command_registry_v1():
        if spec.name == name:
            return Some(spec)
    nil

fn cli_registry_has_command_v1(name: text) -> bool:
    cli_registry_find_command_v1(name) != nil

fn cli_registry_app_path_v1(name: text) -> text:
    if val spec = cli_registry_find_command_v1(name):
        return spec.app_path
    ""

fn cli_registry_dispatch_form_v1(name: text) -> text:
    if val spec = cli_registry_find_command_v1(name):
        return spec.route_kind + ":" + spec.route_target
    ""

fn cli_registry_usage_tail_v1(name: text) -> text:
    if val spec = cli_registry_find_command_v1(name):
        return spec.usage_tail
    ""

fn cli_registry_summary_v1(name: text) -> text:
    if val spec = cli_registry_find_command_v1(name):
        return spec.summary
    ""

fn cli_registry_provider_route_valid_v1() -> bool:
    if val spec = cli_registry_find_command_v1("provider"):
        return spec.route_kind == "script-tail" and
            spec.route_target == "src/app/provider_cli/main.spl" and
            spec.app_path == spec.route_target
    false

fn cli_registry_direct_script_target_v1(name: text) -> text:
    if val spec = cli_registry_find_command_v1(name):
        if spec.route_kind == "script-tail":
            return spec.route_target
    ""

fn _registry_pad_v1(prefix: text, column: i64) -> text:
    var out = prefix
    if out.len() >= column:
        return out + "  "
    while out.len() < column:
        out = out + " "
    out

fn _registry_render_row_v1(prefix: text, summary: text, column: i64) -> text:
    if summary == "":
        return prefix
    _registry_pad_v1(prefix, column) + summary

fn _registry_render_detail_v1(row: CliHelpDetailV1) -> text:
    if row.row_kind == "registered-option":
        for option in cli_option_registry_v1():
            if option.token == row.usage_tail and option.visible:
                return _registry_render_row_v1(
                    "  " + option.usage_tail, option.summary, 35)
        return "  [invalid option anchor: " + row.usage_tail + "]"
    if row.row_kind == "simple":
        return _registry_render_row_v1("  simple " + row.usage_tail, row.summary, 32)
    if row.row_kind == "default":
        return _registry_render_row_v1("  simple", row.summary, 32)
    if row.row_kind == "option":
        return _registry_render_row_v1("  " + row.usage_tail, row.summary, 35)
    if row.row_kind == "example":
        val prefix = if row.usage_tail == "": "  simple" else: "  simple " + row.usage_tail
        return _registry_pad_v1(prefix, 32) + "# " + row.summary
    if row.row_kind == "note":
        if row.usage_tail == "":
            return "    " + row.summary
        return "    " + row.usage_tail + " " + row.summary
    row.summary

fn cli_registry_render_help_v1(version: text) -> text:
    var lines: [text] = ["Simple Language v" + version, ""]
    val commands = cli_command_registry_v1()
    val details = cli_help_details_v1()
    for group in cli_help_groups_v1():
        lines.push(group + ":")
        for detail in details:
            if detail.group == group and detail.owner == "":
                lines.push(_registry_render_detail_v1(detail))
        for spec in commands:
            if spec.group == group:
                lines.push(_registry_render_row_v1(
                    "  simple " + spec.usage_tail, spec.summary, 32))
                for detail in details:
                    if detail.group == group and detail.owner == spec.name:
                        lines.push(_registry_render_detail_v1(detail))
        lines.push("")
    lines.join("\n")

fn cli_registry_payload_text_v1() -> text:
    var rows: [text] = []
    for spec in cli_command_registry_v1():
        rows.push("command|" + spec.name + "|" + spec.usage_tail + "|" +
            spec.summary + "|" + spec.group + "|" + spec.route_kind + "|" +
            spec.route_target + "|" + spec.app_path)
    for detail in cli_help_details_v1():
        rows.push("detail|" + detail.group + "|" + detail.owner + "|" +
            detail.usage_tail + "|" + detail.summary + "|" + detail.row_kind)
    for option in cli_option_registry_v1():
        rows.push("option|" + option.owner + "|" + option.token + "|" +
            option.usage_tail + "|" + option.summary + "|" + option.group +
            "|" + if option.visible: "1" else: "0")
    rows.join("\n")

fn cli_registry_payload_sha256_v1() -> text:
    sha256_text(cli_registry_payload_text_v1())

fn cli_registry_structurally_valid_v1() -> bool:
    val commands = cli_command_registry_v1()
    if commands.len() == 0:
        return false
    var names: [text] = []
    for spec in commands:
        if spec.name == "" or spec.usage_tail == "" or spec.summary == "" or
                spec.group == "" or spec.route_kind == "" or
                spec.route_target == "" or names.contains(spec.name):
            return false
        if spec.route_kind == "script-tail" and spec.app_path != spec.route_target:
            return false
        names.push(spec.name)
    for detail in cli_help_details_v1():
        if detail.group == "" or detail.row_kind == "" or
                (detail.owner != "" and not names.contains(detail.owner)):
            return false
        if detail.row_kind == "registered-option":
            var found_option = false
            for option in cli_option_registry_v1():
                if option.token == detail.usage_tail and option.visible:
                    found_option = true
            if not found_option:
                return false
    var option_keys: [text] = []
    var visible_tokens: [text] = []
    for option in cli_option_registry_v1():
        val key = option.owner + "|" + option.token
        if option.owner == "" or option.token == "" or
                not option.token.starts_with("--") or option_keys.contains(key):
            return false
        option_keys.push(key)
        if option.visible:
            if visible_tokens.contains(option.token):
                return false
            visible_tokens.push(option.token)
            var anchor_count = 0
            for detail in cli_help_details_v1():
                if detail.row_kind == "registered-option" and
                        detail.usage_tail == option.token:
                    anchor_count = anchor_count + 1
            if anchor_count != 1:
                return false
    true

export CliCommandSpecV1, CliHelpDetailV1, CliOptionSpecV1
export cli_command_registry_v1, cli_help_details_v1, cli_option_registry_v1
export cli_registry_command_names_v1, cli_registry_option_tokens_v1
export cli_registry_find_command_v1, cli_registry_has_command_v1
export cli_registry_app_path_v1, cli_registry_dispatch_form_v1
export cli_registry_usage_tail_v1, cli_registry_summary_v1
export cli_registry_provider_route_valid_v1
export cli_registry_direct_script_target_v1, cli_registry_render_help_v1
export cli_registry_payload_text_v1, cli_registry_payload_sha256_v1
export cli_registry_structurally_valid_v1
