# Linked CLI entry: no source interpreter, implicit executable lookup or seed.
use app.orchestrator.command.orchestrator_command_v1
use app.orchestrator.reply_cleanup_v2.orchestrator_reply_cleanup_v2
use std.nogc_async_mut.sosix.host_facade.sosix_print_raw

pub fn cli_orchestrator_entry_v1(args: [text]) -> i64:
    val reply = orchestrator_reply_cleanup_v2(orchestrator_command_v1(args))
    val output = if reply.output.ends_with("\n"): reply.output else: reply.output + "\n"
    sosix_print_raw(output)
    reply.exit_code
