# Shard worker reap policy shared by the parse-shard fan-out and the ledger
# shard pools (src/app/cli/native_build_main.spl spawn_parse_shards and
# run_ledger_shards).
use app.io.process_ops.{process_wait, process_kill, process_is_running}
use app.cli.parse_shard_queue.{parse_shard_exit_label}
use std.io_runtime.{time_now_monotonic_ms}
use std.nogc_sync_mut.io.process_ops.{eprint}
use compiler.driver.driver_build.native_file_worker_v1.{NATIVE_FILE_WORKER_TIMEOUT_CODE_V1}

# Poll quantum for a child that may still be running.
pub const SHARD_REAP_POLL_MS_V1: i64 = 200

# After a timed-out worker was handed to process_kill (`killed`), the pool
# re-waits it (`reaped`) and probes liveness (`running`). -2 means it is still
# running. -1 is a wait error, not proof of exit -- EXCEPT right after a
# successful kill: both host runtimes reap inside the kill primitive (seed
# rt_process_kill: SIGKILL + wait, pid forgotten; hosted C unix_common.h:
# SIGKILL + reap after the 100 ms grace), so the re-wait answers -1 for a
# child that is dead, and the liveness probe is the deciding evidence.
# Measured 2026-11-13: kill=true rewait=-1 running=false on every timed-out
# worker; the old reading BLOCKED the ledger "worker could not be reaped".
pub fn shard_worker_kill_stopped_v1(killed: bool, reaped: i64, running: bool) -> bool:
    if running or reaped == -2:
        return false
    if reaped == -1:
        return killed
    true

# The pool's confirmation sequence after process_kill(pid) returned `killed`.
# Probe first: a child the kill primitive already reaped is not waitable, and
# waiting on it only prints the hosted runtime's "waitpid failed: errno=10"
# (ECHILD) for the expected case. A child still dying gets the 5 s re-wait.
pub fn shard_worker_confirm_kill_v1(pid: i64, killed: bool) -> bool:
    if pid <= 0:
        return true
    if not process_is_running(pid):
        return shard_worker_kill_stopped_v1(killed, -1, false)
    var reaped = process_wait(pid, 5000)
    # Sign-restore an i32 that crossed the wrapper boundary zero-extended
    # (native_build_main.spl native_build_normalize_exit_code).
    if reaped > 2147483647:
        reaped = reaped - 4294967296
    shard_worker_kill_stopped_v1(killed, reaped, process_is_running(pid))

# Live-sibling bound after a parse shard dies (see parse_shard_reap_v1).
pub const PARSE_SHARD_DEATH_GRACE_MS_V1: i64 = 300000

# A finished child whose status is neither success (0) nor "still running" (-2).
pub fn parse_shard_abnormal_exit_v1(code: i64) -> bool:
    code != 0 and code != -2

# The reap deadline after a sibling died at `now`: the earlier of the current
# deadline (0 = none) and now + grace; grace <= 0 leaves it unchanged.
pub fn parse_shard_death_deadline_v1(deadline: i64, now: i64, grace_ms: i64) -> i64:
    if grace_ms <= 0:
        return deadline
    val bounded = now + grace_ms
    if deadline > 0 and deadline < bounded: deadline else: bounded

# Wait for every parse shard child under ONE shared deadline (`timeout_ms`
# from now; 0 = no deadline), kill the ones that outlive it, and ALWAYS print
# each child's exit status. run11 (2026-08-21): shard 6/8 was killed by the
# kill_simple_monitor CPU guard and the only trace was "7/8 completed" -- the
# non-zero wait result was counted and dropped. Until 2026-11-13 the children
# were waited one after another, each with the full budget, so the Nth child
# could run N x timeout_ms. Returns (failed, unconfirmed) shard indices in
# `indices` order: `unconfirmed` names killed children whose death could not
# be confirmed, so the caller must not reclaim or remove the queue they may
# still write into.
#
# A shard that dies (crash/abnormal exit) bounds its live siblings by
# `death_grace_ms` (<= 0 = no bound). Windows diag-phase4 lint_entry
# (2026-11-13): shard 0/2 exited 0xC0000005, shard 1/2 stayed alive, and the
# parent sat silent for 85 minutes under the 6 h default build timeout until
# killed by hand (same shape as the 2026-11-07 c56 run, shard 2/4 live to the
# deadline). Shards only warm per-module cache entries, so killing a sibling
# loses no finished work: the real build parses the remainder in process.
pub fn parse_shard_reap_v1(pids: [i64], indices: [i64], count: i64, timeout_ms: i64,
        death_grace_ms: i64) -> ([i64], [i64]):
    var deadline = if timeout_ms > 0: time_now_monotonic_ms() + timeout_ms else: 0
    var codes: [i64] = []
    var pending = 0
    for pid in pids:
        codes = codes.push(if pid > 0: -2 else: -1)
        if pid > 0: pending = pending + 1
    while pending > 0:
        val expired = deadline > 0 and time_now_monotonic_ms() >= deadline
        var k = 0
        while k < pids.len():
            if codes[k] == -2:
                # Sign-restore: a zero-extended -2 ("still running") must not
                # be recorded as an exit status for a live child.
                val code = if expired: -2 else: shard_exit_code_sign_restored_v1(process_wait(pids[k], SHARD_REAP_POLL_MS_V1))
                if code != -2 or expired:
                    codes[k] = code
                    pending = pending - 1
                    if pending > 0 and death_grace_ms > 0 and parse_shard_abnormal_exit_v1(code):
                        deadline = parse_shard_death_deadline_v1(deadline, time_now_monotonic_ms(), death_grace_ms)
                        eprint("[parse-shard] shard={indices[k]}/{count} pid={pids[k]} died {parse_shard_exit_label(code)}; {pending} live sibling(s) bounded by death_grace_ms={death_grace_ms}, remainder parses in process")
            k = k + 1
    var failed: [i64] = []
    var unconfirmed: [i64] = []
    var k = 0
    while k < pids.len():
        val i = indices[k]
        val pid = pids[k]
        val code = codes[k]
        if code != 0:
            eprint("[parse-shard] shard={i}/{count} pid={pid} FAILED {parse_shard_exit_label(code)}")
            failed = failed.push(i)
            # A timed-out (-2) child is STILL RUNNING and holds its multi-GiB
            # interpreter heap. If it stays alive it competes with the HIR
            # shards and the real worker for the runner's memory and can push
            # the worker into alloc-failure (beta.9 windows leg: leaked shard
            # + worker OOM, "memory allocation of 65520 bytes failed"), and it
            # keeps writing claims into a queue the caller is about to reclaim
            # and remove. Kill, confirm, and report an unconfirmed death.
            if pid > 0 and code == -2:
                val killed = process_kill(pid)
                val stopped = shard_worker_confirm_kill_v1(pid, killed)
                if not stopped:
                    unconfirmed = unconfirmed.push(i)
                eprint("[parse-shard] shard={i}/{count} pid={pid} dead-child cleanup: kill={killed} stopped={stopped}")
        else:
            print "[parse-shard] shard={i}/{count} pid={pid} exit=0"
        k = k + 1
    (failed, unconfirmed)

# Per-child poll quantum for a pool that waits its live children one after
# another (run_ledger_shards): a full round costs at most `poll_ms` however
# many are live. Before this every live worker got the full quantum, so with
# 16 workers a finished worker's slot waited up to 16 x 200 ms = 3.2 s to be
# refilled. A liveness pre-probe is NOT the alternative: both host runtimes
# implement rt_process_is_running by reaping (seed try_wait, hosted
# waitpid(WNOHANG)), so a probe before the wait loses the exit status.
pub fn shard_pool_poll_quantum_v1(live: i64, poll_ms: i64) -> i64:
    if poll_ms <= 0:
        return 1
    if live <= 1:
        return poll_ms
    val quantum = poll_ms / live
    if quantum < 1: 1 else: quantum

# Sign-restore an i32 exit status that crossed the wrapper boundary
# zero-extended (native_build_main.spl native_build_normalize_exit_code): a
# -2 "still running" presents as 4294967294, a -1 as 4294967295.
pub fn shard_exit_code_sign_restored_v1(raw: i64) -> i64:
    if raw > 2147483647: raw - 4294967296 else: raw

# Verdict of one bounded wait on the RAW process_wait return: the sign-restored
# status, which is NATIVE_FILE_WORKER_TIMEOUT_CODE_V1 (-2) exactly when the
# child is still running past a positive budget and must be killed. Comparing
# the raw value would miss a zero-extended -2 on that lane: the kill would
# never fire and a live child would be sealed as if it had exited.
pub fn shard_child_wait_verdict_v1(raw: i64, timeout_ms: i64) -> i64:
    val code = shard_exit_code_sign_restored_v1(raw)
    if code == -2 and timeout_ms > 0: NATIVE_FILE_WORKER_TIMEOUT_CODE_V1 else: code

# Wait for ONE shard child under `timeout_ms` (<= 0 = no deadline: the user's
# explicit `--timeout 0`). A child that outlives the budget is killed and its
# stop confirmed through shard_worker_confirm_kill_v1 (probe first, then the
# sign-restored re-wait), the reason is printed, and
# NATIVE_FILE_WORKER_TIMEOUT_CODE_V1 is returned so the caller seals TIMEOUT.
# Replaces the file-worker's process_wait(pid, 0) forever-waits.
pub fn shard_child_wait_bounded_v1(label: text, pid: i64, timeout_ms: i64) -> i64:
    if pid <= 0:
        return -1
    val code = shard_child_wait_verdict_v1(process_wait(pid, if timeout_ms > 0: timeout_ms else: 0), timeout_ms)
    if code != NATIVE_FILE_WORKER_TIMEOUT_CODE_V1 or timeout_ms <= 0:
        return code
    val killed = process_kill(pid)
    val stopped = shard_worker_confirm_kill_v1(pid, killed)
    eprint("[{label}] pid={pid} exceeded timeout_ms={timeout_ms}; kill={killed} stopped={stopped}")
    NATIVE_FILE_WORKER_TIMEOUT_CODE_V1
