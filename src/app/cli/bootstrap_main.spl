extern fn sys_get_args() -> [text]

# Non-lazy AND direct-from-defining-module: `use lazy` deferred the driver to
# a dynload lib that was never implemented (#99), linking as undefined
# compiler_driver_create/run_compile. And native-build closure discovery
# follows plain `use` recursively but does NOT follow `export use`, so the
# compiler.driver __init__ re-export shim was a dead end (4-file closure).
# Importing driver.spl directly lets discovery pull the driver and its
# transitive imports statically. (2026-07-13 redeploy)
use app.cli.bootstrap_identity.{bootstrap_version}
use app.cli.bootstrap_focused_native_build.{run_bootstrap_native_build_dispatch}
use app.cli.bootstrap_focused_compile.{run_bootstrap_compile_dispatch}

fn native_build_help() -> i64:
    0

# NOTE: this function's name is a hardcoded "known bootstrap builtin" in the
# Stage3/4 self-hosting capsule lowering (see is_bootstrap_builtin_fn /
# bootstrap_hir_symbol_for_name in src/compiler/20.hir + 50.mir) -- its
# (args: [text], i: i64) -> text SIGNATURE must not change, only literal
# values inside it. The "not specified" sentinel is "" (empty text), resolved
# to the contained build/native/<entry-stem> default at the call site instead.
fn bootstrap_output_from_args(args: [text], i: i64) -> text:
    if i >= args.len():
        ""
    elif args[i].starts_with("-o") and args[i].len() == 2 and i + 1 < args.len():
        args[i + 1]
    elif args[i].starts_with("-o") and args[i].len() > 2:
        args[i].substring(2)
    elif args[i].starts_with("--output") and args[i].len() == 8 and i + 1 < args.len():
        args[i + 1]
    elif args[i].starts_with("--output="):
        args[i].substring(9)
    else:
        bootstrap_output_from_args(args, i + 1)

# #138/#19: the authorized Stage4 explicit entry and the single-file positional
# shape (no --source dirs -- i.e. `bm native-build foo.spl -o out`) compile
# THROUGH THE PURE-SIMPLE IN-PROCESS PIPELINE instead of the Rust
# rt_native_build FFI seed. The in-process failure surfaces loudly; it never
# silently retries the seed.
pub fn run_native_build_bootstrap(args: [text]) -> i64:
    run_native_build_dispatch(args)

fn run_native_build_dispatch(args: [text]) -> i64:
    run_bootstrap_native_build_dispatch(args)

fn get_cli_args() -> [text]:
    sys_get_args()

fn main() -> i64:
    val all_args = get_cli_args()
    val argc = all_args.len()
    if argc < 2:
        print "Simple Bootstrap Compiler v{bootstrap_version()}"
        # `compile` accepts --format=smf ONLY (run_compile_bootstrap rejects
        # everything else); advertising --native here made the usage text lie
        # about an interface the implementation refuses. Native output is
        # reached through `native-build`, which is listed separately.
        print "Usage: simple compile <file> --format=smf [-o <output>] [--opt-level=<level>] [--list-optimizations]"
        print "       simple native-build <file>.spl [-o <output>] [--backend=<llvm|cranelift>]"
        return 0
    val first = all_args[1]
    if first == "native-build":
        return run_native_build_bootstrap(all_args)
    if first.len() == 9 and first.starts_with("--version"):
        print "simple-bootstrap {bootstrap_version()}"
        return 0
    if first.len() == 6 and first.starts_with("--help"):
        print "Simple Bootstrap Compiler v{bootstrap_version()}"
        print "Built from Simple source via the staged bootstrap"
        print ""
        print "Commands:"
        print "  compile <file> --format=smf   Compile to SMF (the ONLY format `compile` supports)"
        print "  native-build <file>.spl       Compile to a native executable"
        print ""
        print "Compile-related flags include:"
        print "  --opt-level=<none|basic|standard|aggressive>"
        print "  --list-optimizations"
        return 0
    if first.len() == 7 and first.starts_with("compile"):
        return run_bootstrap_compile_dispatch(all_args)
    print "error: unknown command '{first}'"
    return 1
