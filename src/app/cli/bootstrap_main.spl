extern fn sys_get_args() -> [text]

# Non-lazy AND direct-from-defining-module: `use lazy` deferred the driver to
# a dynload lib that was never implemented (#99), linking as undefined
# compiler_driver_create/run_compile. And native-build closure discovery
# follows plain `use` recursively but does NOT follow `export use`, so the
# compiler.driver __init__ re-export shim was a dead end (4-file closure).
# Importing driver.spl directly lets discovery pull the driver and its
# transitive imports statically. (2026-07-13 redeploy)
use app.cli.bootstrap_positional_native_build.{run_bootstrap_positional_native_build}
use app.cli.bootstrap_native_nonpositional.{run_bootstrap_native_nonpositional}
use app.cli.bootstrap_cli_dispatch.{run_bootstrap_cli_dispatch}

fn native_build_help() -> i64:
    0

# NOTE: this function's name is a hardcoded "known bootstrap builtin" in the
# Stage3/4 self-hosting capsule lowering (see is_bootstrap_builtin_fn /
# bootstrap_hir_symbol_for_name in src/compiler/20.hir + 50.mir) -- its
# (args: [text], i: i64) -> text SIGNATURE must not change, only literal
# values inside it. The "not specified" sentinel is "" (empty text), resolved
# to the contained build/native/<entry-stem> default at the call site instead.
fn bootstrap_output_from_args(args: [text], i: i64) -> text:
    if i >= args.len():
        ""
    elif args[i].starts_with("-o") and args[i].len() == 2 and i + 1 < args.len():
        args[i + 1]
    elif args[i].starts_with("-o") and args[i].len() > 2:
        args[i].substring(2)
    elif args[i].starts_with("--output") and args[i].len() == 8 and i + 1 < args.len():
        args[i + 1]
    elif args[i].starts_with("--output="):
        args[i].substring(9)
    else:
        bootstrap_output_from_args(args, i + 1)

# #138/#19: the authorized Stage4 explicit entry and the single-file positional
# shape (no --source dirs -- i.e. `bm native-build foo.spl -o out`) compile
# THROUGH THE PURE-SIMPLE IN-PROCESS PIPELINE instead of the Rust
# rt_native_build FFI seed. The in-process failure surfaces loudly; it never
# silently retries the seed.
pub fn run_native_build_bootstrap(args: [text]) -> i64:
    bootstrap_native_build_route(args, bootstrap_positional_index(args, 0, 0, 0, -1, 0))

fn bootstrap_native_flag_needs_value(arg: text) -> i64:
    if arg == "-o" or arg == "--output" or arg == "--entry": return 1
    if arg == "--threads" or arg == "--timeout" or arg == "--cache-dir": return 1
    if arg == "--backend" or arg == "--runtime-bundle" or arg == "--runtime-path": return 1
    if arg == "--mode" or arg == "--target" or arg == "--linker-script" or arg == "--log": return 1
    0

fn bootstrap_positional_index(args: [text], i: i64, scanning: i64, has_source: i64, entry_index: i64, entry_count: i64) -> i64:
    if i >= args.len():
        if entry_count == 1 and has_source == 0: entry_index else: -1
    elif args[i] == "native-build":
        bootstrap_positional_index(args, i + 1, 1, has_source, entry_index, entry_count)
    elif scanning == 0:
        bootstrap_positional_index(args, i + 1, scanning, has_source, entry_index, entry_count)
    elif args[i] == "--source":
        bootstrap_positional_index(args, i + 2, scanning, 1, entry_index, entry_count)
    elif args[i].starts_with("--source="):
        bootstrap_positional_index(args, i + 1, scanning, 1, entry_index, entry_count)
    elif bootstrap_native_flag_needs_value(args[i]) == 1:
        bootstrap_positional_index(args, i + 2, scanning, has_source, entry_index, entry_count)
    elif args[i].starts_with("-"):
        bootstrap_positional_index(args, i + 1, scanning, has_source, entry_index, entry_count)
    elif args[i].ends_with(".spl"):
        bootstrap_positional_index(args, i + 1, scanning, has_source, i, entry_count + 1)
    else:
        bootstrap_positional_index(args, i + 1, scanning, 1, entry_index, entry_count)

fn bootstrap_native_build_route(args: [text], entry_index: i64) -> i64:
    if entry_index >= 0:
        run_bootstrap_positional_native_build(args, entry_index)
    else:
        run_bootstrap_native_nonpositional(args)

fn get_cli_args() -> [text]:
    sys_get_args()

fn main() -> i64:
    bootstrap_main_from_args(get_cli_args())

fn bootstrap_main_from_args(args: [text]) -> i64:
    if args.len() > 1 and args[1] == "native-build":
        run_native_build_bootstrap(args)
    else:
        run_bootstrap_cli_dispatch(args)
