# Query CLI - LSP visibility JSON adapters
#
# Wraps the existing text-oriented query commands and enriches them with
# lightweight visibility metadata derived from file/module boundaries.

use app.cli.query_rich_common.{query_process_run, query_cli_get_args}
use app.cli._QueryVisibility.source_reader.{query_visibility_source_exists_v1, query_visibility_source_read_v1}
use app.cli._QueryVisibility.source_reader.{query_visibility_source_begin_v1, query_visibility_source_finish_v1,
    query_visibility_source_disk_begin_v1, query_visibility_source_disk_finish_v1}
