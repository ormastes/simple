fn query_visibility_nonnegative_int_or_zero(value: text) -> i64:
    val trimmed = value.trim()
    if trimmed == "":
        return 0
    for ch in trimmed:
        if ch < "0" or ch > "9":
            return 0
    trimmed.to_int() ?? 0

# `--flag value` lookup; `default` when absent. Values are `file[:line]`
# requester specs or plain words — never another flag.
fn query_visibility_flag_value(args: [text], flag: text, default: text) -> text:
    var j = 1
    while j + 1 < args.len():
        if args[j] == flag and not args[j + 1].starts_with("--"):
            return args[j + 1]
        j = j + 1
    default

# A requester location is `path` or `path:line`; the line is echoed back to the
# caller (visibility is file-granular today) — never treated as part of the path.
fn requester_file_part(spec: text) -> text:
    val idx = spec.last_index_of(":")
    if idx <= 0:
        return spec
    val tail = spec.substring(idx + 1)
    if tail == "" or query_visibility_nonnegative_int_or_zero(tail) == 0 and tail != "0":
        return spec
    spec.substring(0, idx)

fn requester_line_part(spec: text) -> i64:
    val file = requester_file_part(spec)
    if file == spec:
        return 0
    query_visibility_nonnegative_int_or_zero(spec.substring(query_text_len(file) + 1))

pub fn query_visibility_main() -> i64:
    val all_args = query_cli_get_args()
    var args: [text] = []
    var start_idx = 0
    if all_args.len() >= 2 and all_args[1].ends_with(".spl"):
        start_idx = 2
    elif all_args.len() >= 1 and all_args[0].ends_with(".spl"):
        start_idx = 1
    var i = 0
    for arg in all_args:
        if i >= start_idx:
            args = args.push(arg)
        i = i + 1
    if args.len() == 0:
        return 0
    val subcmd = args[0]
    if subcmd == "hover" and args.len() >= 4:
        return query_visibility_hover(file: args[1], line_num: query_visibility_nonnegative_int_or_zero(args[2]), col: query_visibility_nonnegative_int_or_zero(args[3]), requester_file: query_visibility_flag_value(args, "--requester", args[1]))
    if subcmd == "completions" and args.len() >= 4:
        return query_visibility_completions(file: args[1], line_num: query_visibility_nonnegative_int_or_zero(args[2]), col: query_visibility_nonnegative_int_or_zero(args[3]))
    if subcmd == "symbols" and args.len() >= 2:
        return query_visibility_symbols(file: args[1], requester_file: query_visibility_flag_value(args, "--requester", args[1]),
            level: query_visibility_flag_value(args, "--visibility", ""),
            feature: query_visibility_flag_value(args, "--feature", ""), layer: query_visibility_flag_value(args, "--layer", ""))
    if subcmd == "hidden-summary" and args.len() >= 2:
        return query_visibility_hidden_summary(file: args[1], level: query_visibility_flag_value(args, "--visibility", ""))
    if subcmd == "visibility":
        var file = ""
        if args.len() >= 2 and not args[1].starts_with("--"):
            file = args[1]
        val requester = query_visibility_flag_value(args, "--requester", "")
        var source = query_visibility_flag_value(args, "--requester-source", "")
        if source == "":
            source = if requester == "": "none" else: "explicit"
        return query_visibility_sets(file: file, requester_spec: requester, requester_source: source)
    if subcmd == "workspace-symbols":
        var query = ""
        var requester = ""
        var j = 1
        while j < args.len():
            if args[j] == "--query" and j + 1 < args.len():
                query = args[j + 1]
            elif args[j] == "--requester" and j + 1 < args.len():
                requester = args[j + 1]
            j = j + 1
        return query_visibility_workspace_symbols(query, requester,
            level: query_visibility_flag_value(args, "--visibility", ""),
            feature: query_visibility_flag_value(args, "--feature", ""),
            layer: query_visibility_flag_value(args, "--layer", ""),
            root: query_visibility_flag_value(args, "--root", "src"))
    if subcmd == "semantic-tokens" and args.len() >= 2:
        var start_line = 0
        var end_line = 0
        var j = 2
        while j < args.len():
            if args[j] == "--start-line" and j + 1 < args.len():
                start_line = query_visibility_nonnegative_int_or_zero(args[j + 1])
            elif args[j] == "--end-line" and j + 1 < args.len():
                end_line = query_visibility_nonnegative_int_or_zero(args[j + 1])
            j = j + 1
        return query_visibility_semantic_tokens(file: args[1], start_line: start_line, end_line: end_line)
    1

pub fn query_visibility_hover(file: text, line_num: i64, col: i64, requester_file: text) -> i64:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        print "null"
        return 1
    val fwd = forwarding_resolve_at(file: clean_file, line_num: line_num, col: col)
    var symbol = extract_symbol_at(file: clean_file, line_num: line_num, col: col)
    if fwd.name != "":
        symbol = fwd.name
    if symbol == "":
        print "null"
        return 1
    var resolved = resolve_symbol_file(current_file: clean_file, symbol: symbol)
    if fwd.name != "":
        resolved = clean_file
    var hover = declaration_line(symbol: symbol, owner_file: resolved)
    if fwd.name != "":
        hover = fwd.decl
    val vis = visibility_json(symbol: symbol, owner_file: resolved, requester_file: sanitize_path(requester_file_part(requester_file)))
    var lines: [text] = []
    if hover != "":
        lines = lines.push(hover)
    if fwd.name != "" and fwd.via != "":
        lines = lines.push("Forwarded: " + fwd.owner + "." + fwd.name + " via " + fwd.via)
    lines = lines.push("")
    lines = lines.push("Visibility: **" + visibility_display(symbol: symbol, owner_file: resolved) + "**")
    val boundary = boundary_module(owner_file: resolved)
    if boundary != "":
        lines = lines.push("Boundary: `" + boundary + "` (" + boundary_kind(owner_file: resolved) + ")")
    val exported = exported_by(symbol: symbol, owner_file: resolved)
    if exported != "":
        lines = lines.push("Exported by: `" + exported + "`")
    print "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_text(lines.join("\n")) + "},\"simpleVisibility\":" + vis + "}"
    0

pub fn query_visibility_completions(file: text, line_num: i64, col: i64) -> i64:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        print "[]"
        return 1
    var items: [text] = []
    val prefix = extract_symbol_at(file: clean_file, line_num: line_num, col: col)
    val local_symbols = parse_symbols_in_file(file_path: clean_file)
    val local_facts = build_file_boundary_facts(clean_file, "", false)
    val local_req = build_requester_boundary_facts(local_facts, clean_file)
    for sym in local_symbols:
        if prefix != "" and not sym.name.starts_with(prefix):
            continue
        val declared = symbol_declared_vis(sym, local_facts)
        val display = symbol_visibility_display(sym.name, declared, local_facts)
        val reachable = symbol_visibility_reachable(declared, display, local_facts, local_req)
        if not reachable:
            continue
        val vis = symbol_visibility_json(sym.name, declared, display, reachable, local_facts, local_req)
        val detail = "[" + display + "] " + sym.kind
        items.push("{\"label\":" + json_text(sym.name) + ",\"kind\":6,\"detail\":" + json_text(detail) + ",\"data\":{\"simpleVisibility\":" + vis + "}" + "}")
    val imports = parse_imported_modules(file_path: clean_file)
    for module_path in imports:
        val imported_file = resolve_module_path(mod_path: module_path)
        if imported_file == "":
            continue
        val imported_symbols = parse_symbols_in_file(file_path: imported_file)
        val imported_facts = build_file_boundary_facts(imported_file, "", false)
        val imported_req = build_requester_boundary_facts(imported_facts, clean_file)
        for sym in imported_symbols:
            if prefix != "" and not sym.name.starts_with(prefix):
                continue
            val declared = symbol_declared_vis(sym, imported_facts)
            val display = symbol_visibility_display(sym.name, declared, imported_facts)
            val reachable = symbol_visibility_reachable(declared, display, imported_facts, imported_req)
            if not reachable:
                continue
            val vis = symbol_visibility_json(sym.name, declared, display, reachable, imported_facts, imported_req)
            val detail = "[" + display + "] " + sym.kind
            items.push("{\"label\":" + json_text(sym.name) + ",\"kind\":6,\"detail\":" + json_text(detail) + ",\"data\":{\"simpleVisibility\":" + vis + "}" + "}")
    val keywords = matching_keywords(prefix)
    for kw in keywords:
        items.push("{\"label\":" + json_text(kw) + ",\"kind\":14,\"detail\":\"[public]\",\"data\":{\"simpleVisibility\":{\"display\":\"public\",\"reachable\":true,\"boundaryKind\":\"open\"}" + "}" + "}")
    print "[" + items.join(",") + "]"
    0

# --- MDSOC+ public view (REQ-PUBVIEW-001..009) ---
# Fact gathering for the classifier seam (symbol_views.visibility_class_from_facts).
pub fn visibility_class_of(symbol: text, owner_file: text) -> text:
    val declared = declared_visibility(symbol, owner_file)
    val has_boundary = nearest_boundary_dir(owner_file) != ""
    val layer_exported = exported_by(symbol, owner_file) != ""
    val feature_dir = feature_dir_of(owner_file)
    var feature_exported = false
    if feature_dir != "":
        feature_exported = list_has_text(feature_root_export_names(feature_dir), symbol) or
            (feature_file_exposed(feature_dir, owner_file) and declared != "private")
    visibility_class_from_facts(declared, has_boundary, layer_exported, feature_dir != "", feature_exported)

# Names the capsule ROOT manifest exports (not the nested layer manifests —
# those make a symbol feature-private, the root makes it public).
fn feature_root_export_names(feature_dir: text) -> [text]:
    val content = query_visibility_source_read_v1(feature_dir + "/__init__.spl") ?? ""
    var names: [text] = []
    var seen: {text: bool} = {}
    for line in content.split("\n"):
        for name in feature_export_names_in_line(line.trim()):
            if not seen.contains_key(name):
                seen[name] = true
                names.push(name)
    names

struct FileBoundaryFacts:
    owner_file: text
    boundary_dir: text
    has_boundary: bool
    boundary_manifest: text
    boundary_kind_val: text
    boundary_module_val: text
    exported_symbols: {text: bool}
    export_lines: [text]
    friends: [text]
    owner_pkg: text
    capsule: text
    layer_dir: text
    layer_id: text
    owner_peer_tail: text
    owner_parent_facade: text
    feature_dir: text
    feature_id: text
    feature_root_exports: {text: bool}
    feature_manifest_export_set: {text: bool}
    feature_exposed: bool
    feature_reexport_set: {text: bool}

struct RequesterBoundaryFacts:
    requester_file: text
    requester_empty: bool
    same_file: bool
    same_boundary: bool
    same_peer: bool
    is_parent_facade: bool
    requester_pkg: text
    is_friend_pkg: bool
    same_feature: bool

fn build_file_boundary_facts(owner_file: text, known_boundary_dir: text, has_known_boundary: bool) -> FileBoundaryFacts:
    val bdir = if has_known_boundary: known_boundary_dir else: nearest_boundary_dir(owner_file)
    var bmanifest = ""
    var bkind = "open"
    var bmodule = ""
    var exported_symbols: {text: bool} = {}
    var export_lines: [text] = []
    var friends: [text] = []
    if bdir != "":
        bmodule = relative_to_src(bdir).replace("/", ".")
        val candidate_manifest = bdir + "/__init__.spl"
        if has_known_boundary or query_visibility_source_exists_v1(candidate_manifest):
            bmanifest = candidate_manifest
            val content = query_visibility_source_read_v1(candidate_manifest) ?? ""
            bkind = if content.contains("#[bypass]"): "bypass" else: "boundary"
            for line in content.split("\n"):
                val trimmed = line.trim()
                if trimmed.starts_with("export "):
                    export_lines.push(trimmed)
                    collect_ident_tokens_into(trimmed, exported_symbols)
                elif trimmed.starts_with("friend "):
                    friends.push(trimmed.substring(7).trim())
    val ldir = layer_dir_name(owner_file)
    val lid = layer_id_of(owner_file, ldir)
    val odir = parent_dir(owner_file)
    val parent_facade = if odir != "": odir + "/__init__.spl" else: ""
    val fdir = feature_dir_of(owner_file)
    var fid = ""
    var f_root_exports: {text: bool} = {}
    var f_manifest_exports: {text: bool} = {}
    var f_exposed = false
    var f_reexports: {text: bool} = {}
    if fdir != "":
        fid = relative_to_src(fdir).replace("/", ".")
        for rn in feature_root_export_names(fdir):
            f_root_exports[rn] = true
        for mn in feature_manifest_exports(fdir, owner_file):
            f_manifest_exports[mn] = true
        f_exposed = feature_file_exposed(fdir, owner_file)
        if f_exposed:
            for rx in feature_reexports_in_file(owner_file):
                f_reexports[rx] = true
    FileBoundaryFacts(
        owner_file: owner_file,
        boundary_dir: bdir,
        has_boundary: bdir != "",
        boundary_manifest: bmanifest,
        boundary_kind_val: bkind,
        boundary_module_val: bmodule,
        exported_symbols: exported_symbols,
        export_lines: export_lines,
        friends: friends,
        owner_pkg: package_name(owner_file),
        capsule: capsule_name(owner_file),
        layer_dir: ldir,
        layer_id: lid,
        owner_peer_tail: peer_path_tail(owner_file),
        owner_parent_facade: parent_facade,
        feature_dir: fdir,
        feature_id: fid,
        feature_root_exports: f_root_exports,
        feature_manifest_export_set: f_manifest_exports,
        feature_exposed: f_exposed,
        feature_reexport_set: f_reexports)

fn build_requester_boundary_facts(facts: FileBoundaryFacts, requester_file: text) -> RequesterBoundaryFacts:
    if requester_file == "":
        return RequesterBoundaryFacts(
            requester_file: "", requester_empty: true, same_file: false,
            same_boundary: false, same_peer: false, is_parent_facade: false,
            requester_pkg: "", is_friend_pkg: false, same_feature: false)
    if requester_file == facts.owner_file:
        return RequesterBoundaryFacts(
            requester_file: requester_file, requester_empty: false, same_file: true,
            same_boundary: true, same_peer: false, is_parent_facade: false,
            requester_pkg: facts.owner_pkg, is_friend_pkg: false,
            same_feature: facts.feature_dir != "")
    val req_bdir = nearest_boundary_dir(requester_file)
    val shared_boundary = if req_bdir != "" and facts.boundary_dir != "":
        req_bdir == facts.boundary_dir
    else:
        parent_dir(requester_file) == parent_dir(facts.owner_file)
    var shared_peer = false
    if shared_boundary and facts.owner_peer_tail != "" and facts.layer_dir != "":
        val req_tail = peer_path_tail(requester_file)
        val req_layer = layer_dir_name(requester_file)
        if req_tail != "" and req_layer != "" and req_tail == facts.owner_peer_tail:
            shared_peer = facts.layer_dir != req_layer
    val is_facade = facts.owner_parent_facade != "" and requester_file == facts.owner_parent_facade
    val req_pkg = package_name(requester_file)
    val is_friend = list_has_text(facts.friends, req_pkg)
    val same_feat = if facts.feature_dir != "":
        facts.feature_dir == feature_dir_of(requester_file)
    else:
        false
    RequesterBoundaryFacts(
        requester_file: requester_file, requester_empty: false, same_file: false,
        same_boundary: shared_boundary, same_peer: shared_peer,
        is_parent_facade: is_facade, requester_pkg: req_pkg,
        is_friend_pkg: is_friend, same_feature: same_feat)

fn symbol_declared_vis(parsed: ParsedSymbol, facts: FileBoundaryFacts) -> text:
    if parsed.raw_line != "":
        return declared_visibility_from_line(parsed.raw_line)
    declared_visibility(parsed.name, facts.owner_file)

fn symbol_is_layer_exported(symbol: text, facts: FileBoundaryFacts) -> bool:
    if facts.boundary_manifest == "":
        return false
    if is_ident_word(symbol):
        return facts.exported_symbols.contains_key(symbol)
    for line in facts.export_lines:
        if contains_symbol_token(line, symbol):
            return true
    false

fn symbol_visibility_class(symbol: text, declared: text, facts: FileBoundaryFacts) -> text:
    var feature_exported = false
    if facts.feature_dir != "":
        feature_exported = facts.feature_root_exports.contains_key(symbol) or
            (facts.feature_exposed and declared != "private")
    visibility_class_from_facts(declared, facts.has_boundary, symbol_is_layer_exported(symbol, facts), facts.feature_dir != "", feature_exported)

fn symbol_visibility_display(symbol: text, declared: text, facts: FileBoundaryFacts) -> text:
    if declared == "peer":
        return "peer"
    if declared == "up":
        return "up"
    if declared == "private":
        return "private"
    if facts.boundary_kind_val == "open" or facts.boundary_kind_val == "bypass":
        if declared == "public":
            return "public"
        return "boundary"
    if declared == "public" and symbol_is_layer_exported(symbol, facts):
        return "public"
    "boundary"

fn symbol_visibility_reachable(declared: text, display: text, facts: FileBoundaryFacts, req_facts: RequesterBoundaryFacts) -> bool:
    if req_facts.same_file:
        return true
    if req_facts.requester_empty:
        return display == "public"
    if declared == "peer":
        return req_facts.same_peer
    if declared == "up":
        return req_facts.is_parent_facade
    if display == "public":
        return true
    if display == "private":
        return false
    if req_facts.same_boundary:
        return true
    if declared == "package":
        return facts.owner_pkg == req_facts.requester_pkg
    if declared == "internal":
        if facts.owner_pkg == req_facts.requester_pkg:
            return true
        return req_facts.is_friend_pkg
    false

fn symbol_feature_export_reason_rel(symbol: text, declared: text, facts: FileBoundaryFacts, owner_rel: text) -> text:
    if facts.feature_dir == "":
        return ""
    if facts.feature_manifest_export_set.contains_key(symbol):
        return "named in an export line of a capsule __init__.spl"
    if facts.feature_exposed:
        if declared != "private":
            return "declared " + declared + " in exposed port " + owner_rel
        if facts.feature_reexport_set.contains_key(symbol):
            return "re-exported by exposed port " + owner_rel
    ""

fn symbol_feature_export_reason(symbol: text, declared: text, facts: FileBoundaryFacts) -> text:
    if facts.feature_dir == "":
        return ""
    if facts.feature_manifest_export_set.contains_key(symbol):
        return "named in an export line of a capsule __init__.spl"
    if facts.feature_exposed:
        symbol_feature_export_reason_rel(symbol, declared, facts, relative_to_src(facts.owner_file))
    else:
        ""

fn symbol_feature_visibility_json(symbol: text, declared: text, facts: FileBoundaryFacts, req_facts: RequesterBoundaryFacts) -> text:
    if facts.feature_id == "":
        return ""
    val why = symbol_feature_export_reason(symbol, declared, facts)
    val exported = why != ""
    val reachable = if exported: true elif req_facts.requester_empty: false else: req_facts.same_feature
    var parts: [text] = []
    parts.push("\"feature\":" + json_text(facts.feature_id))
    parts.push("\"exported\":" + bool_json(exported))
    parts.push("\"reachable\":" + bool_json(reachable))
    if exported:
        parts.push("\"why\":" + json_text(why))
    "{" + parts.join(",") + "}"

struct FileBoundaryJsonCache:
    boundary_kind_and_mod: text
    exported_by_field: text
    friends_and_capsule_fields: text
    feature_prefix: text
    owner_rel_src: text

fn build_file_boundary_json_cache(facts: FileBoundaryFacts) -> FileBoundaryJsonCache:
    var bkm = "\"boundaryKind\":" + json_text(facts.boundary_kind_val)
    if facts.boundary_module_val != "":
        bkm = bkm + ",\"boundaryModule\":" + json_text(facts.boundary_module_val)
    val exp_field = if facts.boundary_manifest != "": ",\"exportedBy\":" + json_text(facts.boundary_manifest) else: ""
    var fc = ""
    if facts.friends.len() > 0:
        fc = fc + ",\"friendPackages\":[" + json_text_array(facts.friends) + "]"
    if facts.capsule != "":
        fc = fc + ",\"capsuleName\":" + json_text(facts.capsule) + ",\"capsuleVisibility\":\"internal\""
    val feat_prefix = if facts.feature_id != "": "{\"feature\":" + json_text(facts.feature_id) else: ""
    val rel_src = if facts.feature_exposed: relative_to_src(facts.owner_file) else: ""
    FileBoundaryJsonCache(
        boundary_kind_and_mod: bkm,
        exported_by_field: exp_field,
        friends_and_capsule_fields: fc,
        feature_prefix: feat_prefix,
        owner_rel_src: rel_src)

fn symbol_visibility_json_fast(symbol: text, declared: text, display: text, reachable: bool,
        facts: FileBoundaryFacts, req_facts: RequesterBoundaryFacts, jcache: FileBoundaryJsonCache) -> text:
    var out = "{\"display\":" + json_text(display) +
        ",\"reachable\":" + bool_json(reachable) +
        "," + jcache.boundary_kind_and_mod +
        ",\"declared\":" + json_text(declared)
    if symbol_is_layer_exported(symbol, facts):
        out = out + jcache.exported_by_field
    if jcache.friends_and_capsule_fields != "":
        out = out + jcache.friends_and_capsule_fields
    if jcache.feature_prefix != "":
        val why = symbol_feature_export_reason_rel(symbol, declared, facts, jcache.owner_rel_src)
        val exported = why != ""
        val feat_reach = if exported: true elif req_facts.requester_empty: false else: req_facts.same_feature
        out = out + ",\"featureVisibility\":" + jcache.feature_prefix +
            ",\"exported\":" + bool_json(exported) +
            ",\"reachable\":" + bool_json(feat_reach)
        if exported:
            out = out + ",\"why\":" + json_text(why)
        out = out + "}"
    out + "}"

fn symbol_visibility_json(symbol: text, declared: text, display: text, reachable: bool,
        facts: FileBoundaryFacts, req_facts: RequesterBoundaryFacts) -> text:
    var parts: [text] = []
    parts.push("\"display\":" + json_text(display))
    parts.push("\"reachable\":" + bool_json(reachable))
    parts.push("\"boundaryKind\":" + json_text(facts.boundary_kind_val))
    if facts.boundary_module_val != "":
        parts.push("\"boundaryModule\":" + json_text(facts.boundary_module_val))
    parts.push("\"declared\":" + json_text(declared))
    if symbol_is_layer_exported(symbol, facts):
        parts.push("\"exportedBy\":" + json_text(facts.boundary_manifest))
    if facts.friends.len() > 0:
        parts.push("\"friendPackages\":[" + json_text_array(facts.friends) + "]")
    if facts.capsule != "":
        parts.push("\"capsuleName\":" + json_text(facts.capsule))
        parts.push("\"capsuleVisibility\":\"internal\"")
    val feat = symbol_feature_visibility_json(symbol, declared, facts, req_facts)
    if feat != "":
        parts.push("\"featureVisibility\":" + feat)
    "{" + parts.join(",") + "}"

var _LAST_SYMBOLS_OK: bool = false
var _LAST_SYMBOLS_HAS_BOUNDARY: bool = false

# reason: cached success flag from last query_visibility_symbols_payload_core call
@allow(primitive_api)
pub fn query_visibility_last_ok() -> bool:
    _LAST_SYMBOLS_OK

# reason: cached MDSOC boundary flag from last query_visibility_symbols_payload_core call to avoid duplicate tree walks
@allow(primitive_api)
pub fn query_visibility_last_has_boundary() -> bool:
    _LAST_SYMBOLS_HAS_BOUNDARY

fn _qv_vis_level_rank(level: text) -> i64:
    if level == "public": return 0
    if level == "feature_private": return 1
    if level == "layer_private": return 2
    if level == "all": return 3
    -1

fn _qv_vis_class_rank(cls: text) -> i64:
    if cls == "public": return 0
    if cls == "feature_private": return 1
    if cls == "layer_private": return 2
    3

fn _qv_symbol_admits_fast(symbol: SourceVisibleSymbolV1, level_rank: i64, feature: text, layer: text) -> bool:
    if level_rank < 0: return false
    if _qv_vis_class_rank(symbol.visibility_class) > level_rank: return false
    if feature != "" and symbol.feature != feature: return false
    if layer != "" and symbol.layer != layer: return false
    true

fn file_visible_symbols_with_facts(facts: FileBoundaryFacts, parsed_symbols: [ParsedSymbol]) -> [SourceVisibleSymbolV1]:
    var result: [SourceVisibleSymbolV1] = []
    for parsed in parsed_symbols:
        if parsed.kind == "domain": continue
        val declared = symbol_declared_vis(parsed, facts)
        val vis_class = symbol_visibility_class(parsed.name, declared, facts)
        result.push(SourceVisibleSymbolV1(parsed.name, parsed.kind, vis_class, facts.feature_id, facts.layer_id))
    result

fn file_visible_symbols(file: text, parsed_symbols: [ParsedSymbol]) -> [SourceVisibleSymbolV1]:
    val facts = build_file_boundary_facts(file, "", false)
    file_visible_symbols_with_facts(facts, parsed_symbols)

fn _query_visibility_symbols_payload_inner(clean_file: text, requester: text,
        level: text, feature: text, layer: text) -> (text, i64):
    val bdir = nearest_boundary_dir(clean_file)
    val has_boundary = bdir != ""
    val effective = match visibility_level_or_error(level, has_boundary):
        Ok(value): value
        Err(reason):
            _LAST_SYMBOLS_OK = false
            _LAST_SYMBOLS_HAS_BOUNDARY = has_boundary
            return ("{\"error\":" + json_text(reason) + "}", 1)
    val parsed_symbols = parse_symbols_in_file(file_path: clean_file)
    val facts = build_file_boundary_facts(clean_file, bdir, true)
    val req_facts = build_requester_boundary_facts(facts, requester)
    var classified: [SourceVisibleSymbolV1] = []
    var declared_list: [text] = []
    for parsed in parsed_symbols:
        if parsed.kind == "domain": continue
        val declared = symbol_declared_vis(parsed, facts)
        val vis_class = symbol_visibility_class(parsed.name, declared, facts)
        classified.push(SourceVisibleSymbolV1(parsed.name, parsed.kind, vis_class, facts.feature_id, facts.layer_id))
        declared_list.push(declared)
    val jcache = build_file_boundary_json_cache(facts)
    val level_rank = _qv_vis_level_rank(effective)
    var items: [text] = []
    var index = 0
    for parsed in parsed_symbols:
        if parsed.kind == "domain": continue
        val symbol = classified[index]
        val declared = declared_list[index]
        index = index + 1
        if not _qv_symbol_admits_fast(symbol, level_rank, feature, layer): continue
        val display = symbol_visibility_display(parsed.name, declared, facts)
        val reachable = symbol_visibility_reachable(declared, display, facts, req_facts)
        val vis = symbol_visibility_json_fast(parsed.name, declared, display, reachable, facts, req_facts, jcache)
        val range = symbol_range_json(parsed)
        items.push("{\"name\":" + json_text(parsed.name) + ",\"kind\":" + str(symbol_kind_number(parsed.kind)) + ",\"detail\":" + json_text("[" + display + "]") + ",\"range\":" + range + ",\"selectionRange\":" + range + ",\"visibilityClass\":" + json_text(symbol.visibility_class) + ",\"simpleVisibility\":" + vis + "}")
    val summary = symbol_view_summary(classified, effective, feature, layer)
    if summary.hidden > 0:
        items.push(symbol_view_summary_entry(summary, has_boundary, ""))
    _LAST_SYMBOLS_OK = true
    _LAST_SYMBOLS_HAS_BOUNDARY = has_boundary
    ("[" + items.join(",") + "]", 0)

pub fn query_visibility_symbols_payload_core(file: text, requester_file: text,
        level: text, feature: text, layer: text) -> (text, i64):
    val clean_file = sanitize_path(file)
    val requester = sanitize_path(requester_file_part(requester_file))
    if clean_file == "":
        _LAST_SYMBOLS_OK = false
        _LAST_SYMBOLS_HAS_BOUNDARY = false
        return ("[]", 1)
    val owns_disk_scope = query_visibility_source_disk_begin_v1()
    val res = _query_visibility_symbols_payload_inner(clean_file, requester, level, feature, layer)
    if owns_disk_scope:
        query_visibility_source_disk_finish_v1()
    res

pub fn query_visibility_symbols_payload_v1(file: text, requester_file: text,
        level: text, feature: text, layer: text,
        reader: LspVisibilitySourceReaderV1, overlay_generation: i64) -> LspVisibilityQueryResultV1:
    query_visibility_source_begin_v1(reader, overlay_generation)
    val (payload, code) = query_visibility_symbols_payload_core(file, requester_file, level, feature, layer)
    val trace = query_visibility_source_finish_v1()
    if trace.status == LspVisibilityQueryStatusV1.Pending:
        return LspVisibilityQueryResultV1(
            status: LspVisibilityQueryStatusV1.Pending, payload: "",
            diagnostic: "an open visibility dependency is not synchronized",
            overlay_generation: overlay_generation, dependencies: trace.dependencies)
    if trace.status == LspVisibilityQueryStatusV1.Unavailable or code != 0:
        return LspVisibilityQueryResultV1(
            status: LspVisibilityQueryStatusV1.Unavailable, payload: payload,
            diagnostic: "visibility source or query options are unavailable",
            overlay_generation: overlay_generation, dependencies: trace.dependencies)
    LspVisibilityQueryResultV1(
        status: LspVisibilityQueryStatusV1.Ready, payload: payload, diagnostic: "",
        overlay_generation: overlay_generation, dependencies: trace.dependencies)

pub fn query_visibility_symbols(file: text, requester_file: text, level: text, feature: text, layer: text) -> i64:
    val (payload, code) = query_visibility_symbols_payload_core(file, requester_file, level, feature, layer)
    print payload
    code

fn query_visibility_hidden_summary(file: text, level: text) -> i64:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        print "{}"
        return 1
    val bdir = nearest_boundary_dir(clean_file)
    val has_boundary = bdir != ""
    val effective = match visibility_level_or_error(level, has_boundary):
        Ok(value): value
        Err(reason):
            print "{\"error\":" + json_text(reason) + "}"
            return 1
    val parsed_symbols = parse_symbols_in_file(file_path: clean_file)
    val facts = build_file_boundary_facts(clean_file, bdir, true)
    val classified = file_visible_symbols_with_facts(facts, parsed_symbols)
    print symbol_view_summary_json(symbol_view_summary(classified, effective, "", ""), has_boundary)
    0

# Feature selector: a capsule id (`a.b.feature_x`) or a directory path.
fn feature_selector_dir(feature: text) -> text:
    if feature == "": return ""
    if is_dir(feature): return feature
    val path = feature.replace(".", "/")
    if is_dir("src/" + path): return "src/" + path
    if is_dir(path): return path
    ""

fn workspace_view_files(root: text, feature: text, layer: text) -> [text]:
    val base = if feature != "": feature_selector_dir(feature) else: root
    if base == "": return []
    var files: [text] = []
    for path in dir_walk(base):
        val normalized = path.replace("\\", "/")
        if not normalized.ends_with(".spl") or normalized.ends_with("__init__.spl"): continue
        if layer != "" and layer_id_of(normalized, layer_dir_name(normalized)) != layer: continue
        files.push(normalized)
        if files.len() >= 200: break
    files

pub fn query_visibility_workspace_symbols(query: text, requester_file: text, level: text,
        feature: text, layer: text, root: text) -> i64:
    val clean_query = sanitize_symbol(query.trim())
    val clean_query_lower = clean_query.lower()
    val selected = feature != "" or layer != ""
    if clean_query == "" and not selected:
        print "[]"
        return 0
    val effective = match visibility_level_or_error(level, true):
        Ok(value): value
        Err(reason):
            print "{\"error\":" + json_text(reason) + "}"
            return 1
    var candidates: [ParsedSymbol] = []
    if selected:
        for file in workspace_view_files(root, feature, layer):
            for parsed in parse_symbols_in_file(file_path: file):
                if parsed.kind != "domain": candidates.push(parsed)
    else:
        candidates = grep_workspace_symbol_candidates(root, clean_query)
    var classified: [SourceVisibleSymbolV1] = []
    var facts_by_owner: {text: FileBoundaryFacts} = {}
    var items: [text] = []
    for candidate in candidates:
        if candidate.name == "" or (clean_query != "" and not candidate.name.lower().contains(clean_query_lower)):
            continue
        val owner = candidate.file_path.replace("\\", "/")
        if not facts_by_owner.contains_key(owner):
            facts_by_owner[owner] = build_file_boundary_facts(owner, "", false)
        val facts = facts_by_owner[owner]
        val declared = symbol_declared_vis(candidate, facts)
        val vis_class = symbol_visibility_class(candidate.name, declared, facts)
        val symbol = SourceVisibleSymbolV1(candidate.name, candidate.kind, vis_class,
            facts.feature_id, facts.layer_id)
        classified.push(symbol)
        # Selector match on the symbol's own identity: a capsule id selector
        # matches by id; a directory selector already bounded the walk.
        val feature_key = if feature != "" and symbol.feature != feature: "" else: feature
        if not symbol_view_admits(symbol, effective, feature_key, layer): continue
        val range = symbol_range_json(candidate)
        items.push("{\"name\":" + json_text(candidate.name) + ",\"kind\":" + str(symbol_kind_number(candidate.kind)) + ",\"visibilityClass\":" + json_text(symbol.visibility_class) + ",\"feature\":" + json_text(symbol.feature) + ",\"layer\":" + json_text(symbol.layer) + ",\"location\":{\"uri\":" + json_text("file://" + owner) + ",\"range\":" + range + "}" + "}")
        if items.len() >= 100:
            break
    val summary = symbol_view_summary(classified, effective, "", layer)
    if summary.hidden > 0:
        items.push(symbol_view_summary_entry(summary, true, "file://" + root))
    print "[" + items.join(",") + "]"
    0

pub fn query_visibility_semantic_tokens(file: text, start_line: i64, end_line: i64) -> i64:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        print "{\"data\":[]}"
        return 1
    var public_names: {text: bool} = {}
    var boundary_names: {text: bool} = {}
    var private_names: {text: bool} = {}
    val parsed_symbols = parse_symbols_in_file(file_path: clean_file)
    val facts = build_file_boundary_facts(clean_file, "", false)
    for parsed in parsed_symbols:
        val declared = symbol_declared_vis(parsed, facts)
        val display = symbol_visibility_display(parsed.name, declared, facts)
        if display == "public":
            public_names[parsed.name] = true
        elif display == "private":
            private_names[parsed.name] = true
        else:
            boundary_names[parsed.name] = true
    val lines = scan_semantic_tokens(file_path: clean_file, start_line: start_line, end_line: end_line)
    var data: [text] = []
    var prev_line = 0
    var prev_col = 0
    for line in lines:
        val parts = line.split(":")
        if parts.len() < 4:
            continue
        val token_line = query_visibility_nonnegative_int_or_zero(parts[0]) - 1
        val token_col = query_visibility_nonnegative_int_or_zero(parts[1])
        val token_len = query_visibility_nonnegative_int_or_zero(parts[2])
        val token_type = semantic_token_type_number(parts[3])
        val name = token_name_at(file: clean_file, line_num: token_line, col: token_col, length: token_len)
        var modifiers = 0
        if public_names.contains_key(name):
            modifiers = 512
        elif boundary_names.contains_key(name):
            modifiers = 1024
        elif private_names.contains_key(name):
            modifiers = 2048
        val delta_line = token_line - prev_line
        val delta_col = if delta_line == 0: token_col - prev_col else: token_col
        data.push(str(delta_line))
        data.push(str(delta_col))
        data.push(str(token_len))
        data.push(str(token_type))
        data.push(str(modifiers))
        prev_line = token_line
        prev_col = token_col
    print "{\"data\":[" + data.join(",") + "]}"
    0

struct ParsedSymbol:
    name: text
    kind: text
    line_num: i64
    start_col: i64
    end_col: i64
    file_path: text
    raw_line: text = ""

struct ScoredSymbol:
    symbol: ParsedSymbol
    score: i64

fn _parse_decl_kind_and_name(trimmed: text) -> (text, text):
    val body = strip_visibility_prefix(trimmed)
    if body.byte_len() < 3:
        return ("", "")
    val b0 = body.byte_at(0) as i64
    if b0 == 102 and body.starts_with("fn "):
        return ("fn", declaration_token(body.substring(3)))
    if b0 == 109 and body.starts_with("me "):
        return ("method", declaration_token(body.substring(3)))
    if b0 == 118:
        if body.starts_with("val "):
            return ("var", declaration_token(body.substring(4)))
        if body.starts_with("var "):
            return ("var", declaration_token(body.substring(4)))
        return ("", "")
    if b0 == 99 and body.starts_with("class "):
        return ("class", declaration_token(body.substring(6)))
    if b0 == 115 and body.starts_with("struct "):
        return ("struct", declaration_token(body.substring(7)))
    if b0 == 101 and body.starts_with("enum "):
        return ("enum", declaration_token(body.substring(5)))
    if b0 == 116 and body.starts_with("trait "):
        return ("trait", declaration_token(body.substring(6)))
    ("", "")

fn parse_symbols_in_file(file_path: text) -> [ParsedSymbol]:
    val content_opt = query_visibility_source_read_v1(file_path)
    if content_opt.is_none():
        return []
    val content = content_opt ?? ""
    val lines = content.split("\n")
    var items: [ParsedSymbol] = []
    var line_num = 1
    for line in lines:
        val trimmed = line.trim()
        if trimmed != "" and not trimmed.starts_with("#"):
            val domain_kind = domain_block_kind(trimmed)
            if domain_kind != "":
                val start_col = leading_space_count(line)
                val end_col = start_col + query_text_len(domain_kind)
                items.push(ParsedSymbol(name: domain_kind + "{}", kind: "domain", line_num: line_num, start_col: start_col, end_col: end_col, file_path: file_path, raw_line: trimmed))
            else:
                val (kind, name) = _parse_decl_kind_and_name(trimmed)
                if kind != "" and name != "":
                    val start_col = leading_space_count(line) + declaration_name_column(trimmed, name)
                    val end_col = start_col + query_text_len(name)
                    items.push(ParsedSymbol(name: name, kind: kind, line_num: line_num, start_col: start_col, end_col: end_col, file_path: file_path, raw_line: trimmed))
        line_num = line_num + 1
    items

fn visibility_json(symbol: text, owner_file: text, requester_file: text) -> text:
    val facts = build_file_boundary_facts(owner_file, "", false)
    val req_facts = build_requester_boundary_facts(facts, requester_file)
    val declared = declared_visibility(symbol, owner_file)
    val display = symbol_visibility_display(symbol, declared, facts)
    val reachable = symbol_visibility_reachable(declared, display, facts, req_facts)
    symbol_visibility_json(symbol, declared, display, reachable, facts, req_facts)

# Why a layer-public symbol is visible from the requester (compact, one line).
fn layer_visible_reason_with_facts(symbol: text, declared: text, display: text,
        facts: FileBoundaryFacts, req_facts: RequesterBoundaryFacts) -> text:
    if display == "public":
        if symbol_is_layer_exported(symbol, facts):
            return "pub, re-exported by " + relative_to_src(facts.boundary_manifest)
        return "pub in open module (no __init__.spl boundary)"
    if display == "peer":
        return "pub(peer): same peer path in a sibling layer"
    if display == "up":
        return "pub(up): requester is the parent facade"
    if not req_facts.requester_empty and req_facts.same_boundary:
        return "pub inside shared boundary " + facts.boundary_module_val
    if declared == "package" or declared == "internal":
        return "pub(" + declared + "): same package as requester"
    "pub inside boundary " + facts.boundary_module_val

fn layer_visible_reason(symbol: text, owner_file: text, requester_file: text) -> text:
    val facts = build_file_boundary_facts(owner_file, "", false)
    val req_facts = build_requester_boundary_facts(facts, requester_file)
    val declared = declared_visibility(symbol, owner_file)
    val display = symbol_visibility_display(symbol, declared, facts)
    layer_visible_reason_with_facts(symbol, declared, display, facts, req_facts)

fn visibility_set_entry(symbol: text, kind: text, scope_key: text, scope: text, why: text) -> text:
    "{\"symbol\":" + json_text(symbol) + ",\"kind\":" + json_text(kind) + ",\"" + scope_key + "\":" + json_text(scope) + ",\"why\":" + json_text(why) + "}"

# `visibility [file] --requester path[:line] --requester-source explicit|last_read|none`
# Two compact sets for the requester location: layer-public (MDSOC layer
# boundary) and feature-public (MDSOC feature capsule). With NO requester the
# sets hold only what crosses the boundary from anywhere — never "self".
fn query_visibility_sets(file: text, requester_spec: text, requester_source: text) -> i64:
    val requester = sanitize_path(requester_file_part(requester_spec))
    val requester_line = requester_line_part(requester_spec)
    val target = if file != "": sanitize_path(file) else: requester
    if target == "":
        print "{\"error\":\"visibility needs a target file or a requester location\"}"
        return 1
    var req_parts: [text] = []
    req_parts.push("\"file\":" + json_text(requester))
    req_parts.push("\"line\":" + str(requester_line))
    req_parts.push("\"source\":" + json_text(requester_source))
    if requester == "":
        req_parts.push("\"note\":\"no requester: none given and no file was read/opened in this session; sets contain only symbols exported across their boundary (not the target's own view)\"")
    val symbols = parse_symbols_in_file(file_path: target)
    val facts = build_file_boundary_facts(target, "", false)
    val req_facts = build_requester_boundary_facts(facts, requester)
    val layer_module = facts.boundary_module_val
    val feature = facts.feature_id
    var layer_items: [text] = []
    var feature_items: [text] = []
    for parsed in symbols:
        val declared = symbol_declared_vis(parsed, facts)
        val display = symbol_visibility_display(parsed.name, declared, facts)
        if display != "private":
            val cross = if requester == "": display == "public" else: symbol_visibility_reachable(declared, display, facts, req_facts)
            if cross:
                layer_items.push(visibility_set_entry(parsed.name, parsed.kind, "module", layer_module, layer_visible_reason_with_facts(parsed.name, declared, display, facts, req_facts)))
        if feature != "":
            val why = symbol_feature_export_reason(parsed.name, declared, facts)
            if why != "" or (requester != "" and req_facts.same_feature and declared != "private"):
                val reason = if why != "": why else: "same feature capsule as requester"
                feature_items.push(visibility_set_entry(parsed.name, parsed.kind, "feature", feature, reason))
    if feature != "" and facts.feature_exposed:
        for name in feature_reexports_in_file(target):
            feature_items.push(visibility_set_entry(name, "reexport", "feature", feature, "re-exported by exposed port " + relative_to_src(target)))
    print "{\"requester\":{" + req_parts.join(",") + "},\"target\":" + json_text(target) + ",\"layerModule\":" + json_text(layer_module) + ",\"feature\":" + json_text(feature) + ",\"layerPublic\":[" + layer_items.join(",") + "],\"featurePublic\":[" + feature_items.join(",") + "]}"
    0

fn grep_workspace_symbol_candidates(root: text, query: text) -> [ParsedSymbol]:
    val pattern = "^(pub\\(peer\\)|pub\\(up\\)|pub\\(friend\\)|pub\\(package\\)|pub|pri)?[[:space:]]*(fn|me|class|struct|enum|trait|val|var)[[:space:]]+.*" + query
    val (stdout, stderr, code) = query_process_run("grep", ["-RInE", pattern, root, "--include=*.spl"])
    if stdout.trim() == "":
        return []
    var items: [ParsedSymbol] = []
    val lines = stdout.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "":
            continue
        val parsed = parse_grep_symbol_candidate(trimmed)
        if parsed.name != "" and parsed.kind != "":
            items.push(parsed)
            if items.len() >= 200:
                break
    items

fn parse_grep_symbol_candidate(line: text) -> ParsedSymbol:
    val n = line.byte_len()
    var first_colon = -1
    var second_colon = -1
    var idx = 0
    while idx < n:
        if line.byte_at(idx) == 58:
            if first_colon < 0:
                first_colon = idx
            elif second_colon < 0:
                second_colon = idx
                break
        idx = idx + 1
    if first_colon < 0 or second_colon < 0:
        return ParsedSymbol(name: "", kind: "", line_num: 0, start_col: 0, end_col: 0, file_path: "")
    val file_path = line.substring(0, first_colon)
    val line_num_str = line.substring(first_colon + 1, second_colon)
    val source_line = line.substring(second_colon + 1, n)
    val trimmed = source_line.trim()
    val kind = declaration_kind(trimmed)
    if kind == "":
        return ParsedSymbol(name: "", kind: "", line_num: 0, start_col: 0, end_col: 0, file_path: "")
    val name = declaration_name(trimmed)
    val start_col = leading_space_count(source_line) + declaration_name_column(trimmed, name)
    val end_col = start_col + query_text_len(name)
    ParsedSymbol(name: name, kind: kind, line_num: query_visibility_nonnegative_int_or_zero(line_num_str), start_col: start_col, end_col: end_col, file_path: file_path, raw_line: trimmed)

fn symbol_range_json(parsed: ParsedSymbol) -> text:
    val line_idx = if parsed.line_num > 0: parsed.line_num - 1 else: 0
    val start_col = if parsed.start_col >= 0: parsed.start_col else: 0
    val end_col = if parsed.end_col > start_col: parsed.end_col else: start_col
    # The two trailing braces close `end` and the range object itself. They are
    # emitted as two SEPARATE single-brace literals on purpose: inside an
    # ordinary (non-raw) Simple string, `}}` is the interpolation escape for one
    # literal `}`, so writing "}}" here silently produced ONE brace and left the
    # range object unclosed — `lsp_symbols` returned unbalanced JSON (16 `{` vs
    # 12 `}` on a two-symbol file). `"}" + "}"` renders as `}}` under both
    # collapse and literal lexer semantics, so it stays correct on any engine.
    "{\"start\":{\"line\":" + str(line_idx) + ",\"character\":" + str(start_col) + "},\"end\":{\"line\":" + str(line_idx) + ",\"character\":" + str(end_col) + "}" + "}"

fn leading_space_count(line: text) -> i64:
    val n = line.byte_len()
    var count = 0
    while count < n:
        val b = line.byte_at(count) as i64
        if b != 32 and b != 9:
            return count
        count = count + 1
    count

fn _skip_decl_ws_bytes(s: text, start_pos: i64, n: i64) -> i64:
    var p = start_pos
    while p < n:
        val b = s.byte_at(p) as i64
        if b != 32 and b != 9:
            return p
        p = p + 1
    p

fn _is_decl_pre_modifier(word: text) -> bool:
    word == "static" or word == "async" or word == "extern" or word == "kernel"

fn _is_decl_keyword(word: text) -> bool:
    word == "fn" or word == "me" or word == "val" or word == "var" or
        word == "class" or word == "struct" or word == "enum" or
        word == "trait" or word == "type" or word == "unit" or word == "actor"

fn _find_bounded_ident_byte(line: text, symbol: text, from_byte: i64) -> i64:
    val sym_len = symbol.byte_len()
    val line_len = line.byte_len()
    if sym_len == 0 or from_byte < 0 or from_byte + sym_len > line_len:
        return -1
    val first_b = symbol.byte_at(0) as i64
    var pos = from_byte
    while pos + sym_len <= line_len:
        if (line.byte_at(pos) as i64) == first_b:
            var matches = true
            var j = 1
            while j < sym_len:
                if (line.byte_at(pos + j) as i64) != (symbol.byte_at(j) as i64):
                    matches = false
                    break
                j = j + 1
            if matches:
                val left_ok = if pos == 0: true else: not qv_is_ident_byte(line.byte_at(pos - 1) as i64)
                val right_pos = pos + sym_len
                val right_ok = if right_pos >= line_len: true else: not qv_is_ident_byte(line.byte_at(right_pos) as i64)
                if left_ok and right_ok:
                    return pos
        pos = pos + 1
    -1

fn declaration_name_column(trimmed: text, name: text) -> i64:
    val n = trimmed.byte_len()
    if name.byte_len() == 0 or n == 0:
        return 0
    var pos = _skip_decl_ws_bytes(trimmed, 0, n)
    while pos < n and qv_is_ident_byte(trimmed.byte_at(pos) as i64):
        var word_end = pos + 1
        while word_end < n and qv_is_ident_byte(trimmed.byte_at(word_end) as i64):
            word_end = word_end + 1
        val word = trimmed.substring(pos, word_end)
        if word == "pub" and word_end < n and (trimmed.byte_at(word_end) as i64) == 40:
            var close = word_end + 1
            while close < n and (trimmed.byte_at(close) as i64) != 41:
                close = close + 1
            if close < n:
                pos = _skip_decl_ws_bytes(trimmed, close + 1, n)
                continue
            break
        val followed_by_ws = word_end < n and
            ((trimmed.byte_at(word_end) as i64) == 32 or (trimmed.byte_at(word_end) as i64) == 9)
        if not followed_by_ws:
            break
        val next_pos = _skip_decl_ws_bytes(trimmed, word_end, n)
        if word == "pub" or word == "pri" or word == "priv" or _is_decl_pre_modifier(word):
            pos = next_pos
            continue
        if word == "const":
            pos = next_pos
            if next_pos + 3 <= n and trimmed.substring(next_pos, next_pos + 2) == "fn" and
                    ((trimmed.byte_at(next_pos + 2) as i64) == 32 or (trimmed.byte_at(next_pos + 2) as i64) == 9):
                continue
            break
        if _is_decl_keyword(word):
            pos = next_pos
            break
        break
    var idx = _find_bounded_ident_byte(trimmed, name, pos)
    if idx < 0:
        idx = _find_bounded_ident_byte(trimmed, name, 0)
    if idx <= 0:
        return 0
    query_text_len(trimmed.substring(0, idx))

fn query_text_len(value: text) -> i64:
    val n = value.byte_len()
    var count = 0
    var i = 0
    while i < n:
        val b = value.byte_at(i) as i64
        if b < 128:
            count = count + 1
        elif b >= 240:
            count = count + 2
        elif b >= 192:
            count = count + 1
        i = i + 1
    count

fn rank_workspace_symbol_candidate(candidate: ParsedSymbol, query: text, requester: text) -> i64:
    var score = 1000
    val name_lower = candidate.name.lower()
    val query_lower = query.lower()
    if candidate.name == query:
        score = score - 300
    elif name_lower == query_lower:
        score = score - 280
    elif candidate.name.starts_with(query):
        score = score - 220
    elif name_lower.starts_with(query_lower):
        score = score - 200
    elif name_lower.contains(query_lower):
        score = score - 120
    else:
        score = score - 20
    score = score + visibility_rank_for_display(visibility_display(candidate.name, candidate.file_path))
    score = score + kind_rank(candidate.kind)
    score = score + candidate.line_num
    score

fn sort_workspace_symbol_candidates(items: [ParsedSymbol], query: text, requester: text) -> [ScoredSymbol]:
    if items.len() == 0:
        return []
    var sorted: [ScoredSymbol] = []
    for item in items:
        val item_rank = rank_workspace_symbol_candidate(item, query, requester)
        var inserted = false
        var next: [ScoredSymbol] = []
        for existing in sorted:
            if not inserted and item_rank < existing.score:
                next.push(ScoredSymbol(symbol: item, score: item_rank))
                inserted = true
            next.push(existing)
        if not inserted:
            next.push(ScoredSymbol(symbol: item, score: item_rank))
        sorted = next
    sorted

fn visibility_rank_for_display(display: text) -> i64:
    if display == "public":
        return 0
    if display == "peer":
        return 6
    if display == "up":
        return 8
    if display == "boundary":
        return 10
    20

fn kind_rank(kind: text) -> i64:
    if kind == "fn" or kind == "method":
        return 0
    if kind == "class" or kind == "struct" or kind == "trait" or kind == "enum":
        return 5
    10

fn visibility_display(symbol: text, owner_file: text) -> text:
    val declared = declared_visibility(symbol, owner_file)
    if declared == "peer":
        return "peer"
    if declared == "up":
        return "up"
    val boundary = boundary_kind(owner_file)
    if declared == "private":
        return "private"
    if boundary == "open" or boundary == "bypass":
        if declared == "public":
            return "public"
        return "boundary"
    if declared == "public" and exported_by(symbol, owner_file) != "":
        return "public"
    "boundary"

fn visibility_reachable(symbol: text, owner_file: text, requester_file: text) -> bool:
    if requester_file == owner_file:
        return true
    # No requester location: only what crosses the boundary from anywhere
    # counts — never the owner's own (self) view.
    if requester_file == "":
        return visibility_display(symbol, owner_file) == "public"
    val declared = declared_visibility(symbol, owner_file)
    if declared == "peer":
        return same_peer_path(requester_file, owner_file)
    if declared == "up":
        return is_parent_facade_requester(requester_file, owner_file)
    val display = visibility_display(symbol, owner_file)
    if display == "public":
        return true
    if display == "private":
        return false
    if same_boundary(requester_file, owner_file):
        return true
    val owner_pkg = package_name(owner_file)
    val requester_pkg = package_name(requester_file)
    if declared == "package":
        return owner_pkg == requester_pkg
    if declared == "internal":
        if owner_pkg == requester_pkg:
            return true
        return list_has_text(friend_packages(owner_file), requester_pkg)
    false

fn declared_visibility_from_line(raw_line: text) -> text:
    val line = raw_line.trim()
    if not line.contains("pub("):
        if not line.contains("pri"):
            if line.starts_with("pub "):
                return "public"
            return "private"
        if line.starts_with("pri ") or line.contains(" pri "):
            return "private"
        if line.starts_with("pub "):
            return "public"
        return "private"
    if line.starts_with("pub(peer)") or line.contains(" pub(peer) "):
        return "peer"
    if line.starts_with("pub(up)") or line.contains(" pub(up) "):
        return "up"
    if line.starts_with("pub(friend)") or line.contains(" pub(friend) "):
        return "internal"
    if line.starts_with("pub(package)") or line.contains(" pub(package) "):
        return "package"
    if line.starts_with("pri ") or line.contains(" pri "):
        return "private"
    if line.starts_with("pub "):
        return "public"
    "private"

fn declared_visibility(symbol: text, owner_file: text) -> text:
    declared_visibility_from_line(declaration_line(symbol, owner_file))

fn declaration_kind(line: text) -> text:
    val trimmed = strip_visibility_prefix(line.trim())
    if trimmed.starts_with("fn "):
        return "fn"
    if trimmed.starts_with("me "):
        return "method"
    if trimmed.starts_with("class "):
        return "class"
    if trimmed.starts_with("struct "):
        return "struct"
    if trimmed.starts_with("enum "):
        return "enum"
    if trimmed.starts_with("trait "):
        return "trait"
    if trimmed.starts_with("val ") or trimmed.starts_with("var "):
        return "var"
    ""

fn domain_block_kind(line: text) -> text:
    if line.byte_len() < 2:
        return ""
    val b0 = line.byte_at(0) as i64
    if b0 == 115:
        if line.starts_with("schema") and not line.starts_with("schema "):
            return "schema"
        if line.starts_with("style") and not line.starts_with("style "):
            return "style"
        return ""
    if b0 == 117 and line.starts_with("ui") and not line.starts_with("ui "):
        return "ui"
    if b0 == 109 and line.starts_with("music") and not line.starts_with("music "):
        return "music"
    if b0 == 98 and line.starts_with("bim") and not line.starts_with("bim "):
        return "bim"
    if b0 == 99:
        if line.starts_with("cad") and not line.starts_with("cad "):
            return "cad"
        if line.starts_with("city") and not line.starts_with("city "):
            return "city"
        return ""
    if b0 == 114 and line.starts_with("rtl") and not line.starts_with("rtl "):
        return "rtl"
    ""

fn boundary_kind(owner_file: text) -> text:
    val dir = nearest_boundary_dir(owner_file)
    if dir == "":
        return "open"
    val manifest = dir + "/__init__.spl"
    val content_opt = query_visibility_source_read_v1(manifest)
    if content_opt.is_none():
        return "open"
    val content = content_opt ?? ""
    if content.contains("#[bypass]"):
        return "bypass"
    "boundary"

fn same_peer_path(requester_file: text, owner_file: text) -> bool:
    if requester_file == "" or owner_file == "":
        return false
    if not same_boundary(requester_file, owner_file):
        return false
    val owner_tail = peer_path_tail(owner_file)
    val requester_tail = peer_path_tail(requester_file)
    if owner_tail == "" or requester_tail == "":
        return false
    if owner_tail != requester_tail:
        return false
    val owner_layer = layer_dir_name(owner_file)
    val requester_layer = layer_dir_name(requester_file)
    if owner_layer == "" or requester_layer == "":
        return false
    owner_layer != requester_layer

fn is_parent_facade_requester(requester_file: text, owner_file: text) -> bool:
    if requester_file == "" or owner_file == "":
        return false
    val owner_dir = parent_dir(owner_file)
    if owner_dir == "":
        return false
    requester_file == owner_dir + "/__init__.spl"

fn peer_path_tail(file_path: text) -> text:
    val rel = relative_to_src(file_path)
    if rel == "":
        return ""
    val parts = rel.split("/")
    if parts.len() >= 3 and parts[0] == "compiler":
        # @workaround bug=query-native-array-tail-range-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-range-lowering
        return query_join_slash_tail_v1(parts, 2)
    if parts.len() >= 2:
        # @workaround bug=query-native-array-tail-range-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-range-lowering
        return query_join_slash_tail_v1(parts, 1)
    rel

fn layer_dir_name(file_path: text) -> text:
    val rel = relative_to_src(file_path)
    if rel == "":
        return ""
    val parts = rel.split("/")
    if parts.len() >= 2 and parts[0] == "compiler":
        return parts[1]
    if parts.len() >= 1:
        return parts[0]
    ""

fn boundary_module(owner_file: text) -> text:
    val dir = nearest_boundary_dir(owner_file)
    if dir == "":
        return ""
    val rel = relative_to_src(dir)
    rel.replace("/", ".")

fn exported_by(symbol: text, owner_file: text) -> text:
    val dir = nearest_boundary_dir(owner_file)
    if dir == "":
        return ""
    val manifest = dir + "/__init__.spl"
    val content = query_visibility_source_read_v1(manifest) ?? ""
    if content == "":
        return ""
    val lines = content.split("\n")
    for line in lines:
        val trimmed = line.trim()
        # Both manifest forms: `export use m.{A, B}` and bare `export A, B`.
        if trimmed.starts_with("export ") and contains_symbol_token(trimmed, symbol):
            return manifest
    ""

fn friend_packages(owner_file: text) -> [text]:
    val dir = nearest_boundary_dir(owner_file)
    if dir == "":
        return []
    val manifest = dir + "/__init__.spl"
    val content = query_visibility_source_read_v1(manifest) ?? ""
    if content == "":
        return []
    val lines = content.split("\n")
    var friends: [text] = []
    for line in lines:
        val trimmed = line.trim()
        if trimmed.starts_with("friend "):
            friends = friends.push(trimmed.substring(7).trim())
    friends

pub fn nearest_boundary_dir(file_path: text) -> text:
    var current = parent_dir(file_path)
    while current != "":
        val manifest = current + "/__init__.spl"
        if query_visibility_source_exists_v1(manifest):
            return current
        val next = parent_dir(current)
        if next == current:
            break
        current = next
    ""

fn same_boundary(a: text, b: text) -> bool:
    val a_boundary = nearest_boundary_dir(a)
    val b_boundary = nearest_boundary_dir(b)
    if a_boundary != "" and b_boundary != "":
        return a_boundary == b_boundary
    parent_dir(a) == parent_dir(b)

fn package_name(file_path: text) -> text:
    val rel = relative_to_src(file_path)
    if rel == "":
        return ""
    val parts = rel.split("/")
    if parts.len() == 0:
        return ""
    if parts[0] == "compiler" and parts.len() > 1:
        val layer = parts[1]
        val dot = layer.index_of(".")
        if dot >= 0 and dot + 1 < layer.len():
            return layer.substring(dot + 1)
        return layer
    parts[0]

fn scan_semantic_tokens(file_path: text, start_line: i64, end_line: i64) -> [text]:
    val content = query_visibility_source_read_v1(file_path) ?? ""
    if content == "":
        return []
    val lines = content.split("\n")
    var fn_names: {text: bool} = {}
    var type_names: {text: bool} = {}
    val parsed = parse_symbols_in_file(file_path)
    for sym in parsed:
        if sym.kind == "fn" or sym.kind == "method":
            fn_names[sym.name] = true
        elif sym.kind == "class" or sym.kind == "struct" or sym.kind == "enum" or sym.kind == "trait":
            type_names[sym.name] = true
    var results: [text] = []
    var line_idx = 1
    var last_line = end_line
    if last_line <= 0 or last_line > lines.len():
        last_line = lines.len()
    for line in lines:
        if line_idx < start_line and start_line > 0:
            line_idx = line_idx + 1
            continue
        if line_idx > last_line:
            break
        val n = line.byte_len()
        var bi = 0
        var ci = 0
        while bi < n:
            val b = line.byte_at(bi) as i64
            if b == 32 or b == 9:
                bi = bi + 1
                ci = ci + 1
                continue
            if b == 35:
                val rem_chars = query_text_len(line.substring(bi, n))
                results.push(str(line_idx) + ":" + str(ci) + ":" + str(rem_chars) + ":comment")
                break
            if b == 34:
                var si = bi + 1
                var sc = ci + 1
                while si < n:
                    val cb = line.byte_at(si) as i64
                    if cb < 128 or cb >= 192:
                        sc = sc + 1
                    if cb == 34:
                        si = si + 1
                        break
                    si = si + 1
                results.push(str(line_idx) + ":" + str(ci) + ":" + str(sc - ci) + ":string")
                bi = si
                ci = sc
                continue
            if b >= 48 and b <= 57:
                var ni = bi + 1
                while ni < n:
                    val cb = line.byte_at(ni) as i64
                    if not ((cb >= 48 and cb <= 57) or cb == 46):
                        break
                    ni = ni + 1
                val tok_len = ni - bi
                results.push(str(line_idx) + ":" + str(ci) + ":" + str(tok_len) + ":number")
                bi = ni
                ci = ci + tok_len
                continue
            if qv_is_ident_byte(b):
                var wi = bi + 1
                while wi < n and qv_is_ident_byte(line.byte_at(wi) as i64):
                    wi = wi + 1
                val word = line.substring(bi, wi)
                val word_len = wi - bi
                var token_type = "variable"
                if list_has_text(matching_keywords(word), word):
                    token_type = "keyword"
                elif fn_names.contains_key(word):
                    token_type = "function"
                elif type_names.contains_key(word):
                    token_type = "type"
                results.push(str(line_idx) + ":" + str(ci) + ":" + str(word_len) + ":" + token_type)
                bi = wi
                ci = ci + word_len
                continue
            if bi + 1 < n:
                val b1 = line.byte_at(bi + 1) as i64
                if (b == 45 and b1 == 62) or (b == 58 and b1 == 61) or (b == 61 and b1 == 61) or (b == 33 and b1 == 61) or (b == 62 and b1 == 61) or (b == 60 and b1 == 61):
                    results.push(str(line_idx) + ":" + str(ci) + ":2:operator")
                    bi = bi + 2
                    ci = ci + 2
                    continue
            if b < 128 or b >= 192:
                ci = ci + 1
            bi = bi + 1
        line_idx = line_idx + 1
    results
