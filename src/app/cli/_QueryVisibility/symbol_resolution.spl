# Query visibility — symbol + module path resolution helpers
# (leaf module: no facade import — query_commands imports this file directly)
# Query CLI - LSP visibility JSON adapters
#
# Wraps the existing text-oriented query commands and enriches them with
# lightweight visibility metadata derived from file/module boundaries.

use app.cli.query_rich_common.{query_process_run, query_cli_get_args}
use app.cli._QueryVisibility.source_reader.{query_visibility_source_exists_v1, query_visibility_source_read_v1}
use app.cli.query_sanitize.{sanitize_path, sanitize_symbol}
use app.io.env_ops.{cwd}

# Native bootstrap tail-range workaround; callers pass guarded starts1 or2.
# Keep empty elements, including trailing separators, exactly as slice.join.
# @workaround bug=query-native-array-tail-range-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-range-lowering
fn query_join_slash_tail_v1(parts: [text], start: i64) -> text:
    var result = ""
    var index = start
    while index < parts.len():
        if index > start: result = result + "/"
        result = result + parts[index]
        index = index + 1
    result

# Literal-dot suffix removal: preserve internal dots and remove every tail dot.
# @workaround bug=query-native-trim-end-dot-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-method-resolution
fn query_trim_trailing_dots_v1(value: text) -> text:
    var result = value
    while result.ends_with("."):
        result = result.substring(0, result.byte_len() - 1)
    result

# Declaration-text helpers (moved down from query_commands 2026-10-16):
# symbol_resolution is the leaf of this package -- query_commands imports
# it by glob -- but resolve_symbol_file / resolve_symbol_file_and_line and
# symbol_declaration above reached declaration_line / declaration_name
# upward, which the manual stage3 per-module object sweep exposed as
# unresolved-name hard errors (unqualified callees are not importable).
# The whole helper cluster lives here now; query_commands keeps its access
# through its existing `use app.cli._QueryVisibility.symbol_resolution.*`.

fn declaration_line(symbol: text, owner_file: text) -> text:
    val content = query_visibility_source_read_v1(owner_file) ?? ""
    if content == "":
        return ""
    val lines = content.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if declaration_name(trimmed) == symbol:
            return trimmed
    ""

fn declaration_name(line: text) -> text:
    var trimmed = strip_visibility_prefix(line.trim())
    if trimmed.starts_with("static "):
        trimmed = trimmed.substring(7).trim()
    if trimmed.starts_with("async "):
        trimmed = trimmed.substring(6).trim()
    if trimmed.starts_with("extern "):
        trimmed = trimmed.substring(7).trim()
    if trimmed.starts_with("const "):
        trimmed = trimmed.substring(6).trim()
    if trimmed.starts_with("kernel "):
        trimmed = trimmed.substring(7).trim()
    if trimmed.starts_with("val "):
        return declaration_token(trimmed.substring(4))
    if trimmed.starts_with("var "):
        return declaration_token(trimmed.substring(4))
    if trimmed.starts_with("fn "):
        return declaration_token(trimmed.substring(3))
    if trimmed.starts_with("me "):
        return declaration_token(trimmed.substring(3))
    if trimmed.starts_with("class "):
        return declaration_token(trimmed.substring(6))
    if trimmed.starts_with("struct "):
        return declaration_token(trimmed.substring(7))
    if trimmed.starts_with("enum "):
        return declaration_token(trimmed.substring(5))
    if trimmed.starts_with("trait "):
        return declaration_token(trimmed.substring(6))
    val prefixes = ["fn ", "me ", "class ", "struct ", "enum ", "trait ", "val ", "var "]
    for prefix in prefixes:
        if trimmed.starts_with(prefix):
            trimmed = trimmed.substring(prefix.len())
            break
    declaration_token(trimmed)

fn declaration_token(rest: text) -> text:
    val trimmed = rest.trim()
    val n = trimmed.byte_len()
    var i = 0
    while i < n:
        val b = trimmed.byte_at(i) as i64
        if b == 32 or b == 40 or b == 58 or b == 61 or b == 46:
            return trimmed.substring(0, i).trim()
        i = i + 1
    trimmed


pub fn strip_visibility_prefix(line: text) -> text:
    if line.byte_len() < 4 or (line.byte_at(0) as i64) != 112:
        return line
    var trimmed = line
    if trimmed.starts_with("pub(peer)"):
        return trimmed.substring(9).trim()
    if trimmed.starts_with("pub(up)"):
        return trimmed.substring(7).trim()
    if trimmed.starts_with("pub(friend)"):
        return trimmed.substring(11).trim()
    if trimmed.starts_with("pub(package)"):
        return trimmed.substring(12).trim()
    if trimmed.starts_with("pub "):
        return trimmed.substring(4).trim()
    if trimmed.starts_with("pri "):
        return trimmed.substring(4).trim()
    trimmed

fn capsule_name(file_path: text) -> text:
    val idx = file_path.index_of("/85.mdsoc/")
    if idx < 0:
        return ""
    val rest = file_path.substring(idx + 10)
    val parts = rest.split("/")
    if parts.len() >= 2:
        return parts[0] + "." + parts[1]
    if parts.len() >= 1:
        return parts[0]
    ""

fn resolve_symbol_file(current_file: text, symbol: text) -> text:
    if declaration_line(symbol: symbol, owner_file: current_file) != "":
        return current_file
    val imports = parse_imported_modules(file_path: current_file)
    for module_path in imports:
        val resolved = resolve_module_path(mod_path: module_path)
        if resolved != "" and declaration_line(symbol: symbol, owner_file: resolved) != "":
            return resolved
    current_file

fn parse_imported_modules(file_path: text) -> [text]:
    val content = query_visibility_source_read_v1(file_path) ?? ""
    if content == "":
        return []
    val lines = content.split("\n")
    var modules: [text] = []
    for line in lines:
        val trimmed = line.trim()
        if trimmed.starts_with("use "):
            val rest = trimmed.substring(4)
            val end_idx = rest.index_of("{")
            if end_idx >= 0:
                # @workaround bug=query-native-trim-end-dot-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-method-resolution
                modules = modules.push(query_trim_trailing_dots_v1(rest.substring(0, end_idx).trim()))
            else:
                val star_idx = rest.index_of("*")
                if star_idx >= 0:
                    # @workaround bug=query-native-trim-end-dot-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-method-resolution
                    modules = modules.push(query_trim_trailing_dots_v1(rest.substring(0, star_idx).trim()))
                else:
                    modules = modules.push(rest.trim())
    modules

fn resolve_module_path(mod_path: text) -> text:
    if mod_path.contains("/"):
        val slash_parts = mod_path.split("/")
        if slash_parts.len() >= 2 and slash_parts[0].contains("-"):
            val owner_segment = slash_parts[0]
            val owner_domain = owner_segment.replace("-", "_")
            # @workaround bug=query-native-array-tail-range-20261016 recover=5e9123a377ef9a6278ec1ae6e65954112b84a4de reason=native-range-lowering
            val type_base = "src/type/" + owner_domain + "/" + query_join_slash_tail_v1(slash_parts, 1)
            val init_type_base = type_base + "/__init__.spl"
            if query_visibility_source_exists_v1(init_type_base):
                return init_type_base
            val type_mod = type_base + "/mod.spl"
            if query_visibility_source_exists_v1(type_mod):
                return type_mod
            val type_direct = type_base + ".spl"
            if query_visibility_source_exists_v1(type_direct):
                return type_direct

    if not mod_path.contains("."):
        val type_base = "src/type/simple_lang/" + mod_path
        val init_type_base = type_base + "/__init__.spl"
        if query_visibility_source_exists_v1(init_type_base):
            return init_type_base
        val type_mod = type_base + "/mod.spl"
        if query_visibility_source_exists_v1(type_mod):
            return type_mod
        val type_direct = type_base + ".spl"
        if query_visibility_source_exists_v1(type_direct):
            return type_direct

    var path = mod_path
    if path.starts_with("std."):
        path = "lib." + path.substring(4)
    elif path.starts_with("lib.") or path.starts_with("app.") or path.starts_with("compiler."):
        path = path
    else:
        path = "lib." + path
    val file_base = "src/" + path.split(".").join("/")
    val init_file_base = file_base + "/__init__.spl"
    if query_visibility_source_exists_v1(init_file_base):
        return init_file_base
    val mod_file = file_base + "/mod.spl"
    if query_visibility_source_exists_v1(mod_file):
        return mod_file
    val direct_file = file_base + ".spl"
    if query_visibility_source_exists_v1(direct_file):
        return direct_file
    ""

fn _qv_utf8_char_byte_offset(value: text, char_idx: i64) -> i64:
    val n = value.byte_len()
    if char_idx <= 0:
        return 0
    var count = 0
    var i = 0
    while i < n:
        val b = value.byte_at(i) as i64
        if b < 128 or b >= 192:
            if count == char_idx:
                return i
            count = count + 1
        i = i + 1
    if count == char_idx:
        return n
    -1

fn extract_symbol_at(file: text, line_num: i64, col: i64) -> text:
    val content = query_visibility_source_read_v1(file) ?? ""
    if content == "":
        return ""
    val lines = content.split("\n")
    if line_num < 1 or line_num > lines.len():
        return ""
    val target = lines[line_num - 1]
    val declared = declaration_name(target)
    if declared != "":
        return declared
    val n = target.byte_len()
    if col > 0 and n > 0:
        var idx = _qv_utf8_char_byte_offset(target, col - 1)
        if idx >= 0 and idx < n:
            if not qv_is_ident_byte(target.byte_at(idx) as i64) and idx > 0 and qv_is_ident_byte(target.byte_at(idx - 1) as i64):
                idx = idx - 1
            if qv_is_ident_byte(target.byte_at(idx) as i64):
                var start = idx
                var end_pos = idx
                while start > 0 and qv_is_ident_byte(target.byte_at(start - 1) as i64):
                    start = start - 1
                while end_pos + 1 < n and qv_is_ident_byte(target.byte_at(end_pos + 1) as i64):
                    end_pos = end_pos + 1
                return target.substring(start, end_pos + 1)
    ""

fn token_name_at(file: text, line_num: i64, col: i64, length: i64) -> text:
    if col < 0 or length <= 0:
        return ""
    val content = query_visibility_source_read_v1(file) ?? ""
    if content == "":
        return ""
    val lines = content.split("\n")
    if line_num < 0 or line_num >= lines.len():
        return ""
    val line = lines[line_num]
    val b_start = _qv_utf8_char_byte_offset(line, col)
    if b_start < 0:
        return ""
    val b_end = _qv_utf8_char_byte_offset(line, col + length)
    if b_end < b_start:
        return ""
    line.substring(b_start, b_end)

fn semantic_token_type_number(name: text) -> i64:
    if name == "namespace":
        return 0
    elif name == "type":
        return 1
    elif name == "class":
        return 2
    elif name == "enum":
        return 3
    elif name == "struct":
        return 4
    elif name == "function":
        return 5
    elif name == "method":
        return 6
    elif name == "property":
        return 7
    elif name == "variable":
        return 8
    elif name == "parameter":
        return 9
    elif name == "enumMember":
        return 10
    elif name == "keyword":
        return 11
    elif name == "comment":
        return 12
    elif name == "string":
        return 13
    elif name == "number":
        return 14
    elif name == "operator":
        return 15
    8

fn symbol_kind_number(kind: text) -> i64:
    if kind == "fn" or kind == "function" or kind == "extern_fn":
        return 12
    elif kind == "method" or kind == "static_method":
        return 6
    elif kind == "class":
        return 5
    elif kind == "struct":
        return 23
    elif kind == "enum":
        return 10
    elif kind == "trait":
        return 11
    elif kind == "module":
        return 2
    elif kind == "domain":
        return 2
    13

fn parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        return ""
    path.substring(0, idx)

# Normalise "\\" to "/" and make an absolute path repo-relative by stripping
# the process cwd prefix (the repo root when run from it).
fn repo_relative_path(raw: text) -> text:
    val path = if raw.contains("\\"): raw.replace("\\", "/") else: raw
    if path == "":
        return ""
    val b0 = path.byte_at(0) as i64
    val is_abs = b0 == 47 or (path.byte_len() >= 2 and (path.byte_at(1) as i64) == 58)
    if not is_abs:
        return path
    var root = cwd()
    if root.contains("\\"):
        root = root.replace("\\", "/")
    if root == "":
        return path
    if not root.ends_with("/"):
        root = root + "/"
    if path.lower().starts_with(root.lower()):
        return path.substring(root.len())
    path

fn relative_to_src(raw: text) -> text:
    if raw.starts_with("src/"):
        return raw.substring(4)
    val path = repo_relative_path(raw)
    val idx = path.index_of("/src/")
    if idx >= 0:
        return path.substring(idx + 5)
    if path.starts_with("src/"):
        return path.substring(4)
    path

fn qv_is_ident_byte(b: i64) -> bool:
    (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95

fn is_ident_word(value: text) -> bool:
    val n = value.byte_len()
    if n == 0:
        return false
    var i = 0
    while i < n:
        if not qv_is_ident_byte(value.byte_at(i) as i64):
            return false
        i = i + 1
    true

pub fn collect_ident_tokens_into(line: text, mut out: {text: bool}):
    val n = line.byte_len()
    var i = 0
    while i < n:
        if qv_is_ident_byte(line.byte_at(i) as i64):
            val start = i
            i = i + 1
            while i < n and qv_is_ident_byte(line.byte_at(i) as i64):
                i = i + 1
            out[line.substring(start, i)] = true
        else:
            i = i + 1

fn contains_symbol_token(line: text, symbol: text) -> bool:
    val sym_len = symbol.byte_len()
    val line_len = line.byte_len()
    if sym_len == 0 or line_len < sym_len:
        return false
    val first_b = symbol.byte_at(0) as i64
    var pos = 0
    while pos + sym_len <= line_len:
        if (line.byte_at(pos) as i64) == first_b:
            var matches = true
            var j = 1
            while j < sym_len:
                if (line.byte_at(pos + j) as i64) != (symbol.byte_at(j) as i64):
                    matches = false
                    break
                j = j + 1
            if matches:
                val left_ok = if pos == 0: true else: not qv_is_ident_byte(line.byte_at(pos - 1) as i64)
                val right_pos = pos + sym_len
                val right_ok = if right_pos >= line_len: true else: not qv_is_ident_byte(line.byte_at(right_pos) as i64)
                if left_ok and right_ok:
                    return true
        pos = pos + 1
    false

fn is_ident_char(ch: text) -> bool:
    (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"

fn list_has_text(items: [text], value: text) -> bool:
    for item in items:
        if item == value:
            return true
    false

fn bool_json(value: bool) -> text:
    if value:
        return "true"
    "false"

val _QV_JSON_HEX = "0123456789abcdef"

fn _qv_escape_json_ctrl(code: i64) -> text:
    if code == 8:
        return "\\b"
    if code == 9:
        return "\\t"
    if code == 10:
        return "\\n"
    if code == 12:
        return "\\f"
    if code == 13:
        return "\\r"
    val hi = code / 16
    val lo = code % 16
    "\\u00" + _QV_JSON_HEX.substring(hi, hi + 1) + _QV_JSON_HEX.substring(lo, lo + 1)

pub fn escape_json(s: text) -> text:
    val n = s.byte_len()
    var i = 0
    while i < n:
        val b = s.byte_at(i) as i64
        if b < 32 or b == 34 or b == 92:
            break
        i = i + 1
    if i == n:
        return s
    var parts: [text] = []
    if i > 0:
        parts.push(s.substring(0, i))
    var span_start = i
    while i < n:
        val b = s.byte_at(i) as i64
        if b < 32 or b == 34 or b == 92:
            if i > span_start:
                parts.push(s.substring(span_start, i))
            if b == 34:
                parts.push("\\\"")
            elif b == 92:
                parts.push("\\\\")
            else:
                parts.push(_qv_escape_json_ctrl(b))
            span_start = i + 1
        i = i + 1
    if span_start < n:
        parts.push(s.substring(span_start, n))
    parts.join("")

pub fn json_text_array(items: [text]) -> text:
    var encoded: [text] = []
    for item in items:
        encoded.push(json_text(item))
    encoded.join(",")

pub fn json_text(value: text) -> text:
    "\"" + escape_json(value) + "\""

fn find_spl_files(root: text) -> [text]:
    val (stdout, stderr, code) = query_process_run("/bin/sh", ["-c", "find " + root + " -type f -name '*.spl' | sort"])
    if code != 0 or stdout.trim() == "":
        return []
    var result: [text] = []
    val lines = stdout.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "":
            continue
        result = result.push(trimmed)
    result

fn matching_keywords(prefix: text) -> [text]:
    val all = ["fn", "val", "var", "class", "struct", "enum", "trait", "impl", "if", "elif", "else", "for", "while", "match", "case", "return", "break", "continue", "use", "import", "export", "extern", "static", "me", "in", "not", "and", "or", "true", "false", "nil", "self"]
    var items: [text] = []
    for kw in all:
        if prefix == "" or kw.starts_with(prefix):
            items = items.push(kw)
    items

fn text_chars(value: text) -> [text]:
    var chars: [text] = []
    val parts = value.split("")
    for part in parts:
        if part != "":
            chars = chars.push(part)
    chars

fn join_char_slice(chars: [text], start_idx: i64, end_idx: i64) -> text:
    var out: [text] = []
    var i = start_idx
    while i < end_idx and i < chars.len():
        out = out.push(chars[i])
        i = i + 1
    out.join("")
