# Essential-backend implementation of app.cli.bootstrap_backend_installer.
# Each kernel composition root (src/compositions/kernel_llvm{,_cranelift})
# re-exports it at app/cli/bootstrap_backend_installer.spl, so the bootstrap
# CLI (Stage 2/3 pass a kernel root ahead of src/app; first root wins) binds
# this variant with no extra --source root. bootstrap-from-scratch.sh Stage 4
# passes no kernel root and keeps src/app/cli/bootstrap_backend_installer.spl;
# the managed Phase 4 lanes (build-phase4-direct-product.shs,
# bootstrap-phase4-grouped.shs) do pass one, so the request policy defers to an
# installed full static table (the full CLI installs it before dispatch). It
# installs only the K1 table of the paired kernel root and never names
# plugins.backend_registry, so the P-static backends and their closures
# (native isel/encode, C, Wasm, CUDA, HIP, OpenCL, Vulkan, Lean, Byl, IrTc,
# Lua, LlvmLib, and the VHDL driver lane with HWIR) are not compiled into the
# binary. CUDA placement is installed as "disabled" so a PTX request answers
# PLUG-E-DISABLED rather than an unselected policy.
use compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use compiler.backend.static_backend_registry.{
    active_static_backend_table_v1, validate_k1_static_backend_table_v1,
    full_static_backend_table_installed_v1,
    install_host_only_static_backend_composition_v1}
use compiler.common.cuda_backend_policy.{install_cuda_backend_mode_v1}
use app.cli.bootstrap_essential_backend_request.{
    bootstrap_essential_backend_choices_v1,
    bootstrap_essential_backend_request_error_v1}

# reason: boolean installation verdict is the canonical bootstrap_backend_installer ABI shared with bootstrap_main
@allow(primitive_api)
pub fn bootstrap_install_worker_backends_v1() -> bool:
    val policy = selected_k1_backend_policy_v1()
    if not install_selected_k1_backend_table_v1(): return false
    if not install_cuda_backend_mode_v1("disabled"): return false
    if not install_host_only_static_backend_composition_v1(policy): return false
    # A previously installed full table cannot silently widen this composition.
    validate_k1_static_backend_table_v1(policy,
        active_static_backend_table_v1())

pub fn bootstrap_backend_request_error_v1(backend: text, plugin_path: text) -> text:
    bootstrap_essential_backend_request_error_v1(selected_k1_backend_policy_v1(),
        backend, plugin_path, full_static_backend_table_installed_v1())

pub fn bootstrap_backend_choices_v1() -> text:
    bootstrap_essential_backend_choices_v1(selected_k1_backend_policy_v1())

pub fn bootstrap_backend_capability_label_v1() -> text: ""
