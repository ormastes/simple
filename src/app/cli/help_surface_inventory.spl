# Admitted inventory projection of the canonical structured CLI registry.

use app.cli.dispatch.table.{get_all_commands}
use app.cli.command_registry.{
    cli_registry_command_names_v1,
    cli_registry_app_path_v1,
    cli_registry_dispatch_form_v1,
    cli_registry_usage_tail_v1,
    cli_registry_summary_v1,
    cli_registry_option_tokens_v1,
    cli_registry_payload_sha256_v1,
    cli_registry_structurally_valid_v1,
}
use app.io.mod.{file_exists, file_read}
use std.common.crypto.sha256.{sha256_text}
use app.cli.help_surface_generated_data.{
    CLI_SURFACE_DISPATCH_SOURCE_SHA256_V1,
    CLI_SURFACE_HELP_SOURCE_SHA256_V1,
    CLI_SURFACE_TABLE_SOURCE_SHA256_V1,
    CLI_SURFACE_ARGS_SOURCE_SHA256_V1,
    CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1,
    CLI_SURFACE_GENERATION_ID_V1,
}

struct CliSurfaceCommandRowV1:
    name: text
    in_dispatch: bool
    in_help: bool
    in_table: bool
    app_path: text
    dispatch_form: text
    help_line: text
    notes: text

struct CliSurfaceSnapshotV1:
    commands: [CliSurfaceCommandRowV1]
    log_flags: [text]
    internal_flags: [text]

val _CLI_SURFACE_DISPATCH_SOURCE_V1: text = "src/app/cli/_CliMain/main_and_help.spl"
val _CLI_SURFACE_HELP_SOURCE_V1: text = "src/app/cli/command_registry.spl"
val _CLI_SURFACE_TABLE_SOURCE_V1: text = "src/app/cli/dispatch/table.spl"
val _CLI_SURFACE_ARGS_SOURCE_V1: text = "src/app/cli/_CliMain/args_and_os_commands.spl"

fn _table_contains_v1(name: text) -> bool:
    for table_name in get_all_commands():
        if table_name == name:
            return true
    false

fn cli_surface_snapshot_v1() -> CliSurfaceSnapshotV1:
    var rows: [CliSurfaceCommandRowV1] = []
    for name in cli_registry_command_names_v1():
        val in_table = _table_contains_v1(name)
        rows.push(CliSurfaceCommandRowV1(
            name: name,
            in_dispatch: true,
            in_help: true,
            in_table: in_table,
            app_path: cli_registry_app_path_v1(name),
            dispatch_form: cli_registry_dispatch_form_v1(name),
            help_line: "  simple " + cli_registry_usage_tail_v1(name) +
                "  " + cli_registry_summary_v1(name),
            notes: if in_table: "" else: "registry-table-projection-drift",
        ))
    CliSurfaceSnapshotV1(
        commands: rows,
        log_flags: cli_registry_option_tokens_v1("log"),
        internal_flags: cli_registry_option_tokens_v1("runtime"),
    )

fn cli_surface_exact_help_dispatch_parity_v1(
        snapshot: CliSurfaceSnapshotV1) -> bool:
    if not cli_registry_structurally_valid_v1() or snapshot.commands.len() == 0:
        return false
    for row in snapshot.commands:
        if not row.in_dispatch or not row.in_help or not row.in_table or
                row.dispatch_form == "" or row.help_line == "":
            return false
    true

fn cli_surface_source_hashes_match_v1(dispatch_hash: text,
        registry_hash: text, table_hash: text) -> bool:
    dispatch_hash == CLI_SURFACE_DISPATCH_SOURCE_SHA256_V1 and
        registry_hash == CLI_SURFACE_HELP_SOURCE_SHA256_V1 and
        table_hash == CLI_SURFACE_TABLE_SOURCE_SHA256_V1

fn cli_surface_generated_payload_hash_v1() -> text:
    cli_registry_payload_sha256_v1()

fn cli_surface_generated_sources_current_v1() -> bool:
    val payload_hash = cli_surface_generated_payload_hash_v1()
    val generation_id = sha256_text(
        CLI_SURFACE_DISPATCH_SOURCE_SHA256_V1 +
        CLI_SURFACE_HELP_SOURCE_SHA256_V1 +
        CLI_SURFACE_TABLE_SOURCE_SHA256_V1 +
        CLI_SURFACE_ARGS_SOURCE_SHA256_V1 + payload_hash)
    if payload_hash != CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1 or
            generation_id != CLI_SURFACE_GENERATION_ID_V1:
        return false

    # A source-free installed binary admits its embedded registry by the
    # payload and generation hashes above. A live workspace must contain all
    # canonical sources and match every bound hash; partial layouts fail.
    val has_dispatch = file_exists(_CLI_SURFACE_DISPATCH_SOURCE_V1)
    val has_registry = file_exists(_CLI_SURFACE_HELP_SOURCE_V1)
    val has_table = file_exists(_CLI_SURFACE_TABLE_SOURCE_V1)
    val has_args = file_exists(_CLI_SURFACE_ARGS_SOURCE_V1)
    val present = (if has_dispatch: 1 else: 0) +
        (if has_registry: 1 else: 0) + (if has_table: 1 else: 0) +
        (if has_args: 1 else: 0)
    if present == 0:
        return true
    if present != 4:
        return false
    cli_surface_workspace_sources_current_v1()

fn cli_surface_workspace_sources_current_v1() -> bool:
    if not file_exists(_CLI_SURFACE_DISPATCH_SOURCE_V1) or
            not file_exists(_CLI_SURFACE_HELP_SOURCE_V1) or
            not file_exists(_CLI_SURFACE_TABLE_SOURCE_V1) or
            not file_exists(_CLI_SURFACE_ARGS_SOURCE_V1):
        return false
    cli_surface_source_hashes_match_v1(
        sha256_text(file_read(_CLI_SURFACE_DISPATCH_SOURCE_V1)),
        sha256_text(file_read(_CLI_SURFACE_HELP_SOURCE_V1)),
        sha256_text(file_read(_CLI_SURFACE_TABLE_SOURCE_V1))) and
        sha256_text(file_read(_CLI_SURFACE_ARGS_SOURCE_V1)) ==
            CLI_SURFACE_ARGS_SOURCE_SHA256_V1

fn cli_surface_generation_ready_v1(snapshot: CliSurfaceSnapshotV1) -> bool:
    cli_surface_exact_help_dispatch_parity_v1(snapshot) and
        cli_surface_generated_sources_current_v1()

fn cli_surface_command_names_v1(snapshot: CliSurfaceSnapshotV1,
        surface: text) -> [text]:
    var names: [text] = []
    for row in snapshot.commands:
        val include = surface == "all" or
            (surface == "dispatch" and row.in_dispatch) or
            (surface == "help" and row.in_help) or
            (surface == "table" and row.in_table)
        if include:
            names.push(row.name)
    names

fn _cli_surface_only_v1(snapshot: CliSurfaceSnapshotV1,
        surface: text) -> [text]:
    var names: [text] = []
    for row in snapshot.commands:
        val include =
            (surface == "table" and row.in_table and not row.in_dispatch) or
            (surface == "help" and row.in_help and not row.in_dispatch) or
            (surface == "dispatch" and row.in_dispatch and not row.in_table)
        if include:
            names.push(row.name)
    names

fn cli_surface_table_only_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    _cli_surface_only_v1(snapshot, "table")

fn cli_surface_help_only_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    _cli_surface_only_v1(snapshot, "help")

fn cli_surface_dispatch_only_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    _cli_surface_only_v1(snapshot, "dispatch")

fn cli_surface_table_only_commands_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    cli_surface_table_only_v1(snapshot)

fn cli_surface_help_only_commands_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    cli_surface_help_only_v1(snapshot)

fn cli_surface_dispatch_only_commands_v1(snapshot: CliSurfaceSnapshotV1) -> [text]:
    cli_surface_dispatch_only_v1(snapshot)
