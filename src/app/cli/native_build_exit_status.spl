# Inputs are signed statuses after native_build_normalize_exit_code.
pub fn native_build_windows_status_label(code: i64) -> text:
    match code:
        case -1073741819: "0xC0000005 (access violation)"
        case -1073741795: "0xC000001D (illegal instruction)"
        case -1073741676: "0xC0000094 (integer divide by zero)"
        case -1073741571: "0xC00000FD (stack overflow)"
        case -1073741510: "0xC000013A (control-C exit)"
        case -1073740940: "0xC0000374 (heap corruption)"
        case -1073740791: "0xC0000409 (fail-fast termination)"
        case _: ""

pub fn native_build_posix_signal(code: i64) -> i64:
    # rt_process_wait encodes a POSIX signal as -(128 + signal). Limit the
    # signal domain to 1..127; Windows NTSTATUS values are not this encoding.
    if code >= -255 and code <= -129:
        return 0 - code - 128
    0
