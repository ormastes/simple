# Values come from the existing command argument owners; this policy neither
# parses a second argv grammar nor restricts the source programs compiled.
pub fn bootstrap_llvm_backend_request_error_v1(backend: text, plugin_path: text) -> text:
    if plugin_path != "":
        return "PLUG-E-UNSUPPORTED: LLVM-only bootstrap producer cannot load backend plugin '{plugin_path}'"
    if backend != "" and backend != "auto" and backend != "llvm":
        return "PLUG-E-NOTFOUND: backend '{backend}' is unavailable in the LLVM-only bootstrap producer"
    ""
