# Request policy for the essential-backend composition (the bootstrap CLI;
# app.cli.bootstrap_essential_backend_installer, re-exported by each kernel
# composition root). It links only the K1 table selected by the paired kernel
# root (kernel_llvm / kernel_llvm_cranelift); every P-static backend (native
# isel/encode, C, Wasm, CUDA, HIP, OpenCL, Vulkan, Lean, Byl, IrTc, Lua,
# LlvmLib, VHDL) is left out of the closure.
# A request for one of them is refused here, by name, before any compile starts.
# Plan: doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.3.

pub fn bootstrap_essential_backend_choices_v1(policy: text) -> text:
    if policy == "llvm-cranelift":
        return "llvm|cranelift"
    "llvm"

pub fn bootstrap_essential_backend_request_error_v1(policy: text, backend: text,
        plugin_path: text, full_table_installed: bool = false) -> text:
    # The kernel roots also precede src/app in the managed Phase 4 builds of the
    # full CLI, MCP, LSP and test runner. Once a full static table is installed
    # (the full CLI installs it before dispatch) this composition adds no
    # restriction, exactly like the full src/app installer.
    if full_table_installed:
        return ""
    # No provider exports simple_backend_plugin_v1 yet (plan PR2-3), so a
    # plugin path would be dropped, not loaded. Refuse it instead.
    if plugin_path != "":
        return "PLUG-E-UNSUPPORTED: backend plugin '{plugin_path}' not loadable in the essential composition: " +
            "no provider exports simple_backend_plugin_v1 yet"
    if backend == "" or backend == "auto" or backend == "llvm":
        return ""
    if backend == "cranelift" and policy == "llvm-cranelift":
        return ""
    "PLUG-E-NOTFOUND: backend '{backend}' not linked in the essential composition (K1 policy '{policy}'): " +
        "use the full CLI (src/app/cli/main.spl), which links the P-static backends"
