# Memory admission for parse/HIR cache-warming processes.
#
# This is deliberately a pure O(1) calculation.  Shard children remain
# independent processes and retain their existing deterministic path ownership;
# only the number admitted by the orchestrator changes.

val DEFAULT_SHARD_RSS_BUDGET_MB: i64 = 5120
val DEFAULT_SHARD_ESTIMATED_RSS_MB: i64 = 2560

pub fn native_build_hir_shard_policy_v1(parse_sharding: text, hir_sharding: text) -> i64:
    """Return 0 disabled, 1 ordinary, or 2 explicit HIR-only admission.

    Disabling parse warming keeps its historical HIR opt-out unless HIR is
    explicitly enabled. Route 2 requires canonical source authority validation
    before the coordinator starts any HIR child.
    """
    if hir_sharding == "0": return 0
    if parse_sharding == "0":
        return if hir_sharding == "1": 2 else: 0
    1

pub fn native_build_shard_worker_limit(requested: i64, rss_budget_mb: i64,
                                       estimated_worker_rss_mb: i64,
                                       max_workers: i64) -> i64:
    if requested <= 1:
        return requested

    # An explicit zero budget opts out of RSS admission.  This preserves the
    # old opt-in parallel behavior for controlled hosts and benchmark lanes.
    var admitted = requested
    var effective_budget = rss_budget_mb
    if effective_budget < 0:
        effective_budget = DEFAULT_SHARD_RSS_BUDGET_MB
    if effective_budget > 0:
        var estimate = estimated_worker_rss_mb
        if estimate <= 0:
            estimate = DEFAULT_SHARD_ESTIMATED_RSS_MB
        var budget_slots = effective_budget / estimate
        if budget_slots < 1:
            budget_slots = 1
        if budget_slots < admitted:
            admitted = budget_slots

    if max_workers > 0 and max_workers < admitted:
        admitted = max_workers
    if admitted < 1:
        return 1
    admitted

# Closure-size bound for shard fan-out (first-object latency, TODO #437).
# Every parse/HIR/MIR shard is a full process: ~4-5 s start plus a ~3.7 s
# load_sources before it claims a unit (stage2, 2026-11-02). A one-file
# closure got 8 + 5 + 5 children and its first .o moved from 74 s (in
# process) to 124 s. Closures at or below this bound run in process; larger
# ones never get more shards than files. SIMPLE_SHARD_SMALL_CLOSURE_MAX
# overrides the bound; 0 keeps only the file-count clamp.
pub val NATIVE_BUILD_SMALL_CLOSURE_DEFAULT_MAX_V1: i64 = 4

pub fn native_build_small_closure_max_v1(configured: text) -> i64:
    if configured == "":
        return NATIVE_BUILD_SMALL_CLOSURE_DEFAULT_MAX_V1
    # Digits only: some runtimes parse junk as 0, which would silently drop
    # the small-closure bound instead of keeping the default.
    for ch in configured:
        if not "0123456789".contains(ch):
            return NATIVE_BUILD_SMALL_CLOSURE_DEFAULT_MAX_V1
    # Explicit match: a parsed 0 is a real value (keep only the file clamp).
    match configured.to_i64():
        case Some(value):
            if value < 0: NATIVE_BUILD_SMALL_CLOSURE_DEFAULT_MAX_V1 else: value
        case None:
            NATIVE_BUILD_SMALL_CLOSURE_DEFAULT_MAX_V1

pub fn native_build_shard_count_for_closure_v1(requested: i64, closure_files: i64,
                                               small_closure_max: i64) -> i64:
    """Clamp a shard phase's process count to the published closure size.

    closure_files < 0 means the size is unknown (no published closure); the
    requested count is kept. A disabled phase (requested <= 0) stays disabled.
    """
    if requested <= 0 or closure_files < 0:
        return requested
    if closure_files <= small_closure_max:
        return 0
    if closure_files < requested:
        return closure_files
    requested
