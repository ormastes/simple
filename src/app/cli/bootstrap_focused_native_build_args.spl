pub fn focused_native_build_arg_value(args: [text], flag: text) -> text:
    var i = 0
    val prefix = flag + "="
    while i < args.len():
        if args[i] == flag:
            if i + 1 < args.len():
                return args[i + 1]
            return ""
        if args[i].starts_with(prefix):
            return args[i].substring(prefix.len())
        i = i + 1
    ""

pub fn focused_native_build_sources(args: [text]) -> [text]:
    var sources: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "--source":
            if i + 1 < args.len():
                sources.push(args[i + 1])
                i = i + 1
        elif args[i].starts_with("--source="):
            sources.push(args[i].substring(9))
        i = i + 1
    sources

pub fn focused_native_build_target(args: [text]) -> text:
    focused_native_build_arg_value(args, "--target")

pub fn focused_native_build_linker_script(args: [text]) -> text:
    focused_native_build_arg_value(args, "--linker-script")

pub fn focused_native_build_runtime_path(args: [text]) -> text:
    focused_native_build_arg_value(args, "--runtime-path")

pub fn focused_native_build_cache_dir(args: [text]) -> text:
    focused_native_build_arg_value(args, "--cache-dir")

pub fn focused_native_build_backend(args: [text]) -> text:
    val backend = focused_native_build_arg_value(args, "--backend")
    if backend == "":
        "llvm"
    else:
        backend

pub fn focused_native_build_effective_sources(args: [text], exact_stage4_capsule: bool) -> [text]:
    if exact_stage4_capsule:
        []
    else:
        focused_native_build_sources(args)

pub fn focused_native_build_effective_cache_dir(args: [text], previous: text) -> text:
    val requested = focused_native_build_cache_dir(args)
    if requested == "": previous else: requested

pub fn focused_native_build_strip(args: [text], exact_stage4_capsule: bool) -> bool:
    exact_stage4_capsule or focused_native_build_has_flag(args, "--strip")

pub fn focused_native_build_exact_capsule_entry_allowed(entry: text) -> bool:
    entry == "src/app/cli/main.spl" or entry == "src/app/os/main.spl"

pub fn focused_native_build_has_flag(args: [text], flag: text) -> bool:
    for arg in args:
        if arg == flag:
            return true
    false

pub fn focused_native_build_source_at(sources: [text], index: i64) -> text:
    if index >= 0 and index < sources.len():
        sources[index]
    else:
        ""

pub fn focused_native_build_opt_level(args: [text]) -> i64:
    val value = focused_native_build_arg_value(args, "--opt-level")
    if value == "none":
        0
    elif value == "basic":
        1
    elif value == "standard":
        2
    else:
        3
