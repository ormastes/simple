pub fn focused_native_build_arg_value(args: [text], flag: text) -> text:
    var i = 0
    val prefix = flag + "="
    while i < args.len():
        if args[i] == flag:
            if i + 1 < args.len():
                return args[i + 1]
            return ""
        if args[i].starts_with(prefix):
            return args[i].substring(prefix.len())
        i = i + 1
    ""

pub fn focused_native_build_sources(args: [text]) -> [text]:
    var sources: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "--source":
            if i + 1 < args.len():
                sources.push(args[i + 1])
                i = i + 1
        elif args[i].starts_with("--source="):
            sources.push(args[i].substring(9))
        i = i + 1
    sources

pub fn focused_native_build_target(args: [text]) -> text:
    focused_native_build_arg_value(args, "--target")

pub fn focused_native_build_linker_script(args: [text]) -> text:
    focused_native_build_arg_value(args, "--linker-script")

pub fn focused_native_build_runtime_path(args: [text]) -> text:
    focused_native_build_arg_value(args, "--runtime-path")

pub fn focused_native_build_runtime_bundle(args: [text]) -> text:
    focused_native_build_arg_value(args, "--runtime-bundle")

pub fn focused_native_build_cache_dir(args: [text]) -> text:
    focused_native_build_arg_value(args, "--cache-dir")

pub fn focused_native_build_backend(args: [text]) -> text:
    val backend = focused_native_build_arg_value(args, "--backend")
    if backend == "":
        "llvm"
    else:
        backend

pub fn focused_native_build_effective_sources(args: [text], exact_stage4_capsule: bool) -> [text]:
    if exact_stage4_capsule:
        []
    else:
        focused_native_build_sources(args)

pub fn focused_native_build_effective_cache_dir(args: [text], previous: text) -> text:
    val requested = focused_native_build_cache_dir(args)
    if requested == "": previous else: requested

pub fn focused_native_build_strip(args: [text], exact_stage4_capsule: bool) -> bool:
    exact_stage4_capsule or focused_native_build_has_flag(args, "--strip")

pub fn focused_native_build_exact_capsule_entry_allowed(entry: text) -> bool:
    entry == "src/app/cli/main.spl" or entry == "src/app/os/main.spl"

pub fn focused_native_build_has_flag(args: [text], flag: text) -> bool:
    for arg in args:
        if arg == flag:
            return true
    false

pub fn focused_native_build_source_at(sources: [text], index: i64) -> text:
    if index >= 0 and index < sources.len():
        sources[index]
    else:
        ""

pub fn focused_native_build_opt_level(args: [text]) -> i64:
    val value = focused_native_build_arg_value(args, "--opt-level")
    if value == "none":
        0
    elif value == "basic":
        1
    elif value == "standard":
        2
    else:
        3

# Target policy intake is shared by positional and source-root native builds.
# Packaging --mode is deliberately unrelated to this development/release profile.
pub struct FocusedNativeTargetProfileV1:
    release: bool
    profile: text
    managed_build_phase: text

pub fn focused_native_build_target_profile_v1(args: [text], default_release: bool = true) -> Result<FocusedNativeTargetProfileV1, text>:
    var explicit_profile = ""
    var phase = ""
    var release_requested = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        var profile_value = ""
        var phase_value = ""
        if arg == "--release" or arg == "--release-optimized":
            release_requested = true
        elif arg == "--profile" or arg == "--managed-build-phase":
            if index + 1 >= args.len() or args[index + 1].starts_with("--"):
                return Err("TARGET-PROFILE-E-ARG: missing value for " + arg)
            index = index + 1
            if arg == "--profile": profile_value = args[index]
            else: phase_value = args[index]
        elif arg.starts_with("--profile="):
            profile_value = arg.substring(10)
            if profile_value == "": return Err("TARGET-PROFILE-E-ARG: empty profile")
        elif arg.starts_with("--managed-build-phase="):
            phase_value = arg.substring(22)
            if phase_value == "": return Err("TARGET-PROFILE-E-ARG: empty managed phase")
        if profile_value != "":
            if profile_value != "dev" and profile_value != "prod":
                return Err("TARGET-PROFILE-E-ARG: native profile must be dev or prod")
            if explicit_profile != "" and explicit_profile != profile_value:
                return Err("TARGET-PROFILE-E-CONFLICT: conflicting explicit profiles")
            explicit_profile = profile_value
        if phase_value != "":
            if phase_value != "phase3" and phase_value != "phase4":
                return Err("TARGET-PROFILE-E-PHASE: unknown managed build phase")
            if phase != "" and phase != phase_value:
                return Err("TARGET-PROFILE-E-CONFLICT: conflicting managed phases")
            phase = phase_value
        index = index + 1
    val phase_profile = if phase == "phase3": "dev" else: if phase == "phase4": "prod" else: ""
    if phase_profile != "" and explicit_profile != "" and phase_profile != explicit_profile:
        return Err("TARGET-PROFILE-E-CONFLICT: managed phase and explicit profile differ")
    val selected = if explicit_profile != "": explicit_profile else: if phase_profile != "": phase_profile else: if default_release or release_requested: "prod" else: "dev"
    if release_requested and selected == "dev":
        return Err("TARGET-PROFILE-E-CONFLICT: release and development both requested")
    Ok(FocusedNativeTargetProfileV1(selected == "prod", selected, phase))
