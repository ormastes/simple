# Deterministic reports and generated core help for CliSurfaceSnapshotV1.
# Extension help remains owned by the existing SCI extension helpers; callers
# pass their rendered text to cli_surface_generated_help_text_v1.

use app.cli.help_surface_inventory.{
    CliSurfaceSnapshotV1,
    cli_surface_command_names_v1,
    cli_surface_exact_help_dispatch_parity_v1,
    cli_surface_generated_sources_current_v1,
    cli_surface_table_only_v1,
    cli_surface_help_only_v1,
    cli_surface_dispatch_only_v1,
}
use app.cli.command_registry.{cli_registry_render_help_v1}

fn _cli_surface_sorted_text_v1(items: [text]) -> [text]:
    var pending: [text] = []
    var i = 0
    while i < items.len():
        pending.push(items[i])
        i = i + 1
    var sorted: [text] = []
    while pending.len() > 0:
        var best = 0
        var j = 1
        while j < pending.len():
            if pending[j] < pending[best]:
                best = j
            j = j + 1
        sorted.push(pending[best])
        var rest: [text] = []
        var k = 0
        while k < pending.len():
            if k != best:
                rest.push(pending[k])
            k = k + 1
        pending = rest
    sorted

fn _cli_surface_markdown_list_v1(title: text, items: [text]) -> text:
    val sorted = _cli_surface_sorted_text_v1(items)
    var out = "## " + title + " (" + "{sorted.len()}" + ")\n\n"
    if sorted.len() == 0:
        return out + "- None\n\n"
    var i = 0
    while i < sorted.len():
        out = out + "- `" + sorted[i] + "`\n"
        i = i + 1
    out + "\n"

fn cli_surface_migration_report_markdown_v1(snapshot: CliSurfaceSnapshotV1,
        report_date: text) -> text:
    val dispatch = cli_surface_command_names_v1(snapshot, "dispatch")
    val help = cli_surface_command_names_v1(snapshot, "help")
    val table = cli_surface_command_names_v1(snapshot, "table")
    val table_only = cli_surface_table_only_v1(snapshot)
    val help_only = cli_surface_help_only_v1(snapshot)
    val dispatch_only = cli_surface_dispatch_only_v1(snapshot)
    var out = "# CLI help-surface migration report\n\n"
    out = out + "Date: " + report_date + "\n\n"
    out = out + "- Root dispatch commands: " + "{dispatch.len()}" + "\n"
    out = out + "- Help commands: " + "{help.len()}" + "\n"
    out = out + "- Dispatch-table commands: " + "{table.len()}" + "\n\n"
    out = out + _cli_surface_markdown_list_v1("Table-only", table_only)
    out = out + _cli_surface_markdown_list_v1("Help-only", help_only)
    out = out + _cli_surface_markdown_list_v1("Dispatch-only", dispatch_only)
    out

fn _cli_surface_extension_help_v1(prefix: text, extension_help: text) -> text:
    var out = prefix
    if extension_help != "":
        if out != "" and not out.ends_with("\n\n"):
            out = out + "\n"
        out = out + extension_help
        if not extension_help.ends_with("\n"):
            out = out + "\n"
    out

fn cli_surface_generated_help_text_checked_v1(
        snapshot: CliSurfaceSnapshotV1, extension_help: text,
        source_hashes_current: bool) -> text:
    if not cli_surface_exact_help_dispatch_parity_v1(snapshot) or
            not source_hashes_current:
        return _cli_surface_extension_help_v1(
            "Core commands unavailable: generated CLI surface is stale.\n",
            extension_help)
    # Render canonical structured command, option, and detail records once.
    var out = cli_registry_render_help_v1("1.0.0-RC")
    if out != "" and not out.ends_with("\n"):
        out = out + "\n"
    _cli_surface_extension_help_v1(out, extension_help)

fn cli_surface_generated_help_text_v1(snapshot: CliSurfaceSnapshotV1,
        extension_help: text) -> text:
    cli_surface_generated_help_text_checked_v1(
        snapshot, extension_help, cli_surface_generated_sources_current_v1())

fn _cli_surface_push_candidate_v1(candidates: [text], candidate: text,
        prefix: text) -> [text]:
    if candidate.starts_with(prefix) and not candidates.contains(candidate):
        candidates.push(candidate)
    candidates

fn cli_surface_completion_candidates_checked_v1(
        snapshot: CliSurfaceSnapshotV1, prefix: text,
        extension_candidates: [text], source_hashes_current: bool) -> [text]:
    # Core completion only. Config-driven --x candidates continue to come
    # from cli_extension_completions_v1, the existing extension owner.
    var candidates: [text] = []
    if cli_surface_exact_help_dispatch_parity_v1(snapshot) and
            source_hashes_current:
        var i = 0
        while i < snapshot.commands.len():
            val row = snapshot.commands[i]
            if row.in_dispatch:
                candidates = _cli_surface_push_candidate_v1(
                    candidates, row.name, prefix)
            i = i + 1
        var j = 0
        while j < snapshot.log_flags.len():
            candidates = _cli_surface_push_candidate_v1(
                candidates, snapshot.log_flags[j], prefix)
            j = j + 1
        var k = 0
        while k < snapshot.internal_flags.len():
            candidates = _cli_surface_push_candidate_v1(
                candidates, snapshot.internal_flags[k], prefix)
            k = k + 1
    var ext = 0
    while ext < extension_candidates.len():
        candidates = _cli_surface_push_candidate_v1(
            candidates, extension_candidates[ext], prefix)
        ext = ext + 1
    _cli_surface_sorted_text_v1(candidates)

fn cli_surface_completion_candidates_with_extensions_v1(
        snapshot: CliSurfaceSnapshotV1, prefix: text,
        extension_candidates: [text]) -> [text]:
    cli_surface_completion_candidates_checked_v1(
        snapshot, prefix, extension_candidates,
        cli_surface_generated_sources_current_v1())

fn cli_surface_completion_candidates_v1(snapshot: CliSurfaceSnapshotV1,
        prefix: text) -> [text]:
    cli_surface_completion_candidates_with_extensions_v1(snapshot, prefix, [])
