use app.orchestrator.validation.{OrchestratorValidationReplyV1, orchestrator_validate_command_v1}
use app.orchestrator.explain.orchestrator_explain_command_v1
use app.orchestrator.local_controller.orchestrator_local_command_v1
use app.orchestrator.execution.orchestrator_execution_command_v2

pub fn orchestrator_command_v1(args: [text]) -> OrchestratorValidationReplyV1:
    if args.len() > 0 and ["dispatch-init", "dispatch", "resume-execution", "inspect-execution", "preflight-dispatch", "preflight-resume", "inspect-preflight", "host-enrollment-observe",
            "host-local-init", "host-status", "host-prepare", "host-execute", "host-inspect", "host-validate", "host-parent-budget", "host-exec-control-install"].contains(args[0]):
        return orchestrator_execution_command_v2(args)
    if args.len() > 0 and args[0] == "explain":
        return orchestrator_explain_command_v1(args)
    if args.len() > 0 and ["local-init", "submit", "pin-policy", "inspect", "cancel"].contains(args[0]):
        return orchestrator_local_command_v1(args)
    orchestrator_validate_command_v1(args)
