use app.orchestrator.agent_task_command_v1.orchestrator_agent_task_command_v1
use app.orchestrator.host_auth_setup_command_v6.host_auth_setup_command_v6
use app.orchestrator.validation.{OrchestratorValidationReplyV1, orchestrator_validate_command_v1}
use app.orchestrator.explain.orchestrator_explain_command_v1
use app.orchestrator.local_controller.orchestrator_local_command_v1
use app.orchestrator.execution.orchestrator_execution_command_v2
use std.nogc_sync_mut.orchestration.host_service_command_v3.host_service_command_v3
use app.orchestrator.host_primary_service_v5.host_primary_service_command_v5
use app.orchestrator.host_authenticated_service_v6.host_authenticated_service_command_v6
use app.orchestrator.controller_service_command_v3.controller_service_command_v3
use app.orchestrator.server_command_v1.{orchestrator_server_command_v1, orchestrator_identity_exchange_command_v1}
use app.orchestrator.host_identity_command_v1.host_identity_command_v1
use app.orchestrator.host_identity_profile_v1.host_identity_profile_command_v1
use app.orchestrator.help_v1.orchestrator_help_v1
use app.orchestrator.container_plan_prepare_v1.orchestrator_container_plan_prepare_v1
use app.orchestrator.remote_run_plan_v1.remote_run_plan_command_v1
use app.orchestrator.remote_build_port_install_v3.remote_build_environment_install_command_v3

pub fn orchestrator_command_v1(args: [text]) -> OrchestratorValidationReplyV1:
    if args.len() > 0 and ["task-retain", "task-use"].contains(args[0]):
        return orchestrator_agent_task_command_v1(args)
    if args.len() > 0 and args[0].starts_with("controller-service-"):
        return controller_service_command_v3(args)
    if args.len() > 0 and args[0] == "host-auth-setup":
        return host_auth_setup_command_v6(args)
    if args.len() > 0 and args[0] == "host-authenticated-service":
        return host_authenticated_service_command_v6(args)
    if args.len() > 0 and args[0] == "host-primary-service":
        return host_primary_service_command_v5(args)
    if args.len() > 0 and args[0] == "host-service":
        val reply = host_service_command_v3(args)
        return OrchestratorValidationReplyV1(exit_code: reply.exit_code, output: reply.output,
            service_cleanup: reply.cleanup)
    if args.len() == 1 and ["help", "--help", "-h"].contains(args[0]):
        return orchestrator_help_v1()
    if args.len() > 0 and args[0] == "container-plan-prepare":
        return orchestrator_container_plan_prepare_v1(args)
    if args.len() > 0 and args[0] == "remote-run-plan":
        return remote_run_plan_command_v1(args)
    if args.len() > 0 and args[0] == "remote-build-environment-install":
        return remote_build_environment_install_command_v3(args)
    if args.len() > 0 and args[0] == "key-profile-install":
        return host_identity_profile_command_v1(args)
    if args.len() > 0 and ["key-sendserver", "key-takeserver"].contains(args[0]):
        return orchestrator_identity_exchange_command_v1(args)
    if args.len() > 0 and args[0].starts_with("key-"):
        return host_identity_command_v1(args)
    if args.len() > 0 and ["server-resolve", "server-request"].contains(args[0]):
        return orchestrator_server_command_v1(args)
    if args.len() > 0 and ["dispatch-init", "dispatch", "resume-execution", "inspect-execution", "preflight-dispatch", "preflight-resume", "inspect-preflight", "host-enrollment-observe",
            "host-local-init", "host-status", "host-prepare", "host-execute", "host-inspect", "host-validate", "host-parent-budget", "host-exec-control-install", "host-containment-install"].contains(args[0]):
        return orchestrator_execution_command_v2(args)
    if args.len() > 0 and args[0] == "explain":
        return orchestrator_explain_command_v1(args)
    if args.len() > 0 and ["local-init", "submit", "pin-policy", "inspect", "cancel"].contains(args[0]):
        return orchestrator_local_command_v1(args)
    orchestrator_validate_command_v1(args)
