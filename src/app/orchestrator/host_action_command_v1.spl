# milestone_0046 (owner decision 2026-11-19 "Both"): the controller operator commands for the controller-signed Host
# service actions, over the shared authenticated control exchange (V6 `host-control`, dispatch mode `host-action`):
#   helper-abandon  - release one charged V4 attach-broker helper row the deadline reap cannot prove (milestone_0036 A)
#   handoff-abandon - void the one OPS-01 pending handoff a successor cannot verify (AT-OPS-01 recovery a)
# Phase 1 (no --confirm) reads the Host's read-only inspect, checks it names the requested row and the installed host,
# prints the exact canonical record and its sha256, and signs nothing. Phase 2 (--confirm <sha256> plus the signing
# options) re-reads it, refuses unless the digest is the confirmed one, issues the grant+approval with the controller's
# existing issuer and approver keys (controller_host_action_issue_v1), and sends the signed proof. The Host verifies it
# with distributed_verify_grant_approval_from_snapshot_v2; its reply (or refusal) is printed and archived by the dispatch
# owner. Nothing is settled on the controller journal from Host text.
use app.orchestrator.controller_authority_issue_v1.{controller_host_action_issue_v1, controller_authority_store_reader_v1}
use app.orchestrator.validation.OrchestratorValidationReplyV1
use std.nogc_sync_mut.orchestration.controller_local_root_v3.{ControllerLocalRootV3, controller_local_root_open_v3}
use std.nogc_sync_mut.orchestration.controller_dispatch_owner_v3.{ControllerDispatchOwnerV3, ControllerDispatchOwnedTurnV3,
    controller_dispatch_host_action_begin_v3, controller_dispatch_host_action_send_v3, controller_dispatch_step_v3,
    controller_dispatch_close_v3}
use std.nogc_sync_mut.orchestration.controller_dispatch_config_v1.controller_dispatch_grant_clock_v1
use std.common.contracts.orchestration.host_control_operation_v6.{HostControlSubRequestV6, host_control_sub_encode_v6}
use std.common.contracts.orchestration.host_service_operation_reply_v6.host_service_operation_reply_decode_v6
use std.common.contracts.orchestration.host_helper_abandon_v1.{HostHelperAbandonProofV1, host_helper_abandon_decode_v1,
    host_helper_abandon_proof_encode_v1}
use std.common.contracts.orchestration.host_service_handoff_v1.{HostServiceHandoffAbandonProofV1,
    host_service_handoff_abandon_decode_v1, host_service_handoff_abandon_proof_encode_v1}
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.sosix.time.{sosix_time_now_monotonic_ms, sosix_sleep_ms}

val HOST_ACTION_BASE_OPTIONS_V1 = ["--dispatch-root", "--config-digest", "--abandon-id"]
val HOST_ACTION_SIGN_OPTIONS_V1 = ["--confirm", "--key-store", "--approver", "--grant-id", "--expires-in-ms"]
# One authenticated exchange never waits longer than this (same bound as remote-run).
val HOST_ACTION_EXCHANGE_MS_V1: i64 = 120000

class HostActionBoxV1:
    var owner: Option<ControllerDispatchOwnerV3> = None
    var root_cleanup: Option<ControllerLocalRootV3> = None

# `helper-abandon` needs --operation (the charged helper row); `handoff-abandon` names none (the Host's current pending
# sequence). The five signing options are all present (phase 2) or all absent (phase 1). Each option once.
pub fn host_action_options_v1(args: [text]) -> Result<Dict<text, text>, text>:
    if args.len() < 1 or not ["helper-abandon", "handoff-abandon"].contains(args[0]): return Err("host-action-usage")
    var allowed: [text] = HOST_ACTION_BASE_OPTIONS_V1 + HOST_ACTION_SIGN_OPTIONS_V1
    if args[0] == "helper-abandon": allowed = allowed + ["--operation"]
    if args.len() % 2 != 1: return Err("host-action-usage")
    var options: Dict<text, text> = {}
    var index = 1
    while index + 1 < args.len():
        val name = args[index]
        if not allowed.contains(name) or options.contains_key(name) or args[index + 1].starts_with("--"):
            return Err("host-action-usage")
        options[name] = args[index + 1]
        index = index + 2
    for name in HOST_ACTION_BASE_OPTIONS_V1:
        if not options.contains_key(name): return Err("host-action-usage")
    if args[0] == "helper-abandon" and not options.contains_key("--operation"): return Err("host-action-usage")
    var signing = 0
    for name in HOST_ACTION_SIGN_OPTIONS_V1:
        if options.contains_key(name): signing = signing + 1
    if signing != 0 and signing != HOST_ACTION_SIGN_OPTIONS_V1.len(): return Err("host-action-usage")
    if not builder_digest_valid_v1(options["--config-digest"]) or not builder_identifier_valid_v1(options["--abandon-id"]):
        return Err("host-action-usage")
    if options.contains_key("--operation") and not builder_identifier_valid_v1(options["--operation"]): return Err("host-action-usage")
    if signing > 0 and (not builder_digest_valid_v1(options["--confirm"]) or not builder_identifier_valid_v1(options["--approver"]) or
            not builder_identifier_valid_v1(options["--grant-id"])):
        return Err("host-action-usage")
    Ok(options)

pub fn host_action_inspect_payload_v1(command: text, operation_id: text) -> Result<text, text>:
    if command == "helper-abandon": return host_control_sub_encode_v6(HostControlSubRequestV6(sub: "helper-inspect", frame: operation_id))
    host_control_sub_encode_v6(HostControlSubRequestV6(sub: "handoff-inspect", frame: "pending"))

# The inspected bytes must be the canonical record of this command's kind, name the requested helper row (helper only)
# and the installed binding's physical host. Returns sha256 of the bytes: the record digest the envelope binds.
pub fn host_action_record_check_v1(command: text, source: text, operation_id: text, host_id: text) -> Result<text, text>:
    if command == "helper-abandon":
        val record = host_helper_abandon_decode_v1(source)?
        if record.operation_id != operation_id: return Err("host-action-record-operation")
        if record.physical_host_id != host_id: return Err("host-action-record-host")
        return Ok(sha256_text(source))
    val record = host_service_handoff_abandon_decode_v1(source)?
    if record.physical_host_id != host_id: return Err("host-action-record-host")
    Ok(sha256_text(source))

pub fn host_action_confirm_v1(confirmed: text, digest: text) -> Result<(), text>:
    if confirmed != digest: return Err("host-action-confirm-mismatch:expected=" + digest)
    Ok(())

pub fn host_action_refused_detail_v1(encoded: text) -> text:
    val decoded = host_service_operation_reply_decode_v6(encoded)
    if decoded.is_err(): return "host-action-refused-undecodable"
    val reply = decoded.unwrap()
    (if reply.error != "": reply.error else: "dispatch-host-nonzero") + "\n" + reply.payload

fn host_action_millis_v1(value: text) -> Result<i64, text>:
    if value.byte_len() < 1 or value.byte_len() > 9: return Err("host-action-expiry-invalid")
    val digits = "0123456789"
    var total: i64 = 0
    for index in 0..value.byte_len():
        val digit = digits.index_of(value.substring(index, index + 1))
        if digit < 0: return Err("host-action-expiry-invalid")
        total = total * 10 + digit
    Ok(total)

# Steps one exchange to phase ready. An authenticated Host refusal (outcome host-refused) is an Err carrying the Host's
# own reason; the owner stays alive for local cleanup.
fn host_action_wait_v1(box: HostActionBoxV1, first: ControllerDispatchOwnedTurnV3) -> Result<text, text>:
    var turn = first
    val started = sosix_time_now_monotonic_ms()
    var steps = 0
    while steps < 100000:
        box.owner = turn.owner
        if turn.root_cleanup.is_some(): box.root_cleanup = turn.root_cleanup
        if turn.error != "": return Err(turn.error)
        if turn.phase == "ready" and turn.owner.is_some() and turn.outcome == "host-refused":
            return Err(host_action_refused_detail_v1(turn.response))
        if turn.phase == "ready" and turn.owner.is_some(): return Ok(turn.response)
        if turn.owner.is_none() or turn.completed: return Err("host-action-link-closed")
        if started >= 0 and sosix_time_now_monotonic_ms() - started > HOST_ACTION_EXCHANGE_MS_V1:
            return Err("host-action-link-timeout")
        sosix_sleep_ms(5)
        turn = controller_dispatch_step_v3(turn.owner.unwrap())
        steps = steps + 1
    Err("host-action-link-steps")

fn host_action_send_v1(box: HostActionBoxV1, payload: text) -> Result<text, text>:
    if box.owner.is_none(): return Err("host-action-link-closed")
    host_action_wait_v1(box, controller_dispatch_host_action_send_v3(box.owner.unwrap(), payload))

fn host_action_abandon_payload_v1(command: text, record: text, operation: OperationEnvelopeV2,
        signed: DistributedSignedGrantV2, approval: DistributedSignedApprovalV2) -> Result<text, text>:
    if command == "helper-abandon":
        val proof = host_helper_abandon_proof_encode_v1(HostHelperAbandonProofV1(abandon: host_helper_abandon_decode_v1(record)?,
            operation: operation, signed: signed, approval: approval))?
        return host_control_sub_encode_v6(HostControlSubRequestV6(sub: "helper-abandon", frame: proof))
    val proof = host_service_handoff_abandon_proof_encode_v1(HostServiceHandoffAbandonProofV1(
        abandon: host_service_handoff_abandon_decode_v1(record)?, operation: operation, signed: signed, approval: approval))?
    host_control_sub_encode_v6(HostControlSubRequestV6(sub: "handoff-abandon", frame: proof))

fn host_action_output_v1(command: text, state: text, abandon_id: text, record: text, digest: text, detail: text) -> text:
    var bounded = detail
    if bounded.byte_len() > 4096: bounded = bounded.substring(0, 4096)
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String(command), "state": SdnValue.String(state),
        "operationId": SdnValue.String(abandon_id), "record": SdnValue.String(record), "recordDigest": SdnValue.String(digest),
        "detail": SdnValue.String(bounded)}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

# Local cleanup only: closing never sends another Host request.
fn host_action_finish_v1(box: HostActionBoxV1, exit_code: i64, output: text) -> OrchestratorValidationReplyV1:
    var close_steps = 0
    var cleanup_error = ""
    while box.owner.is_some() and close_steps < 64:
        val closed = controller_dispatch_close_v3(box.owner.unwrap())
        box.owner = closed.owner
        if closed.root_cleanup.is_some(): box.root_cleanup = closed.root_cleanup
        close_steps = close_steps + 1
        if closed.error != "": cleanup_error = closed.error
    # A clean answer whose local cleanup did not confirm is reported as needing recovery (exit 2), never as success.
    val cleanup_pending = cleanup_error != "" or box.owner.is_some()
    val code = if exit_code == 0 and cleanup_pending: 2 else: exit_code
    var reply = OrchestratorValidationReplyV1(exit_code: code, output: output)
    reply.controller_dispatch_cleanup = box.owner
    reply.controller_root_cleanup = box.root_cleanup
    reply

fn host_action_refusal_v1(command: text, exit_code: i64, code: text) -> OrchestratorValidationReplyV1:
    OrchestratorValidationReplyV1(exit_code: exit_code, output: host_action_output_v1(command, "refused", "", "", "", code))

pub fn host_action_command_v1(args: [text]) -> OrchestratorValidationReplyV1:
    val command = if args.len() > 0: args[0] else: ""
    val parsed = host_action_options_v1(args)
    if parsed.is_err(): return host_action_refusal_v1(command, 2, parsed.unwrap_err())
    val options = parsed.unwrap()
    val helper_operation = if options.contains_key("--operation"): options["--operation"] else: ""
    val abandon_id = options["--abandon-id"]
    val opened = controller_local_root_open_v3(options["--dispatch-root"], options["--config-digest"])
    if not opened.ready or opened.owner.is_none() or opened.error != "":
        return host_action_refusal_v1(command, 1, if opened.error != "": opened.error else: "host-action-root-unavailable")
    val root = opened.owner.unwrap()
    val box = HostActionBoxV1()
    val context = root.current_v3()
    val config = root.config_v3()
    if context.is_err() or config.is_err():
        box.root_cleanup = Some(root)
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, "", "",
            if context.is_err(): context.unwrap_err() else: config.unwrap_err()))
    val host_id = config.unwrap().host_binding.physical_host_id
    val begun = host_action_wait_v1(box, controller_dispatch_host_action_begin_v3(root, abandon_id))
    if begun.is_err(): return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, "", "", begun.unwrap_err()))
    val inspect = host_action_inspect_payload_v1(command, helper_operation)
    if inspect.is_err(): return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, "", "", inspect.unwrap_err()))
    val inspected = host_action_send_v1(box, inspect.unwrap())
    if inspected.is_err():
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "host-refused", abandon_id, "", "", inspected.unwrap_err()))
    val record = inspected.unwrap()
    val digest = host_action_record_check_v1(command, record, helper_operation, host_id)
    if digest.is_err(): return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, "", "", digest.unwrap_err()))
    # Phase 1: print exactly what phase 2 would sign; nothing is signed or sent.
    if not options.contains_key("--confirm"):
        return host_action_finish_v1(box, 0, host_action_output_v1(command, "plan", abandon_id, record, digest.unwrap(), ""))
    val confirmed = host_action_confirm_v1(options["--confirm"], digest.unwrap())
    if confirmed.is_err():
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, record, digest.unwrap(), confirmed.unwrap_err()))
    val ttl = host_action_millis_v1(options["--expires-in-ms"])
    if ttl.is_err(): return host_action_finish_v1(box, 2, host_action_output_v1(command, "refused", abandon_id, record, digest.unwrap(), ttl.unwrap_err()))
    val now = controller_dispatch_grant_clock_v1()
    if now.is_err(): return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, record, digest.unwrap(), now.unwrap_err()))
    val kind = if command == "helper-abandon": "helper-abandon" else: "service-handoff-abandon"
    val issued = controller_host_action_issue_v1(context.unwrap(), controller_authority_store_reader_v1(options["--key-store"]),
        options["--approver"], kind, abandon_id, digest.unwrap(), host_id, options["--grant-id"], ttl.unwrap(), now.unwrap())
    if issued.is_err():
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, record, digest.unwrap(), issued.unwrap_err()))
    val authority = issued.unwrap()
    val payload = host_action_abandon_payload_v1(command, record, authority.operation, authority.authority.signed,
        authority.authority.approval)
    if payload.is_err():
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "refused", abandon_id, record, digest.unwrap(), payload.unwrap_err()))
    val sent = host_action_send_v1(box, payload.unwrap())
    if sent.is_err():
        return host_action_finish_v1(box, 1, host_action_output_v1(command, "host-refused", abandon_id, record, digest.unwrap(), sent.unwrap_err()))
    host_action_finish_v1(box, 0, host_action_output_v1(command, "abandoned", abandon_id, record, digest.unwrap(), sent.unwrap()))

export host_action_options_v1, host_action_inspect_payload_v1, host_action_record_check_v1, host_action_confirm_v1
export host_action_refused_detail_v1, host_action_command_v1
