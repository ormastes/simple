# milestone_0037: the controller-side SETTLE of a remote-run build row that ends without a signed bundle (Host settled
# without a bundle, failed, wedged, cancelled, never answered, or the exchange broke after the row was admitted).
# Before this the row stayed `executing` forever. The settle runs as a journal edit through the ROOT's single writer
# (controller_dispatch_remote_edit_v3): it publishes a typed, content-addressed record
#   SIMPLE-REMOTE-RUN-SETTLE-1 | operation id | request envelope digest | state | reason | typed exit status
# and moves the row to `failed`, `cancelled` or the honest non-terminal `outcome-unknown` (a local timeout or a broken
# exchange proves nothing about the Host). The terminal outcome digest is sha256 of that record.
# Success is never recorded here: there is no signed completion, so the exit status can only be Unobserved, NotExited,
# Unknown or a non-zero Exited; Exited(0) and `completed` are refused. Only accept_wire_v3 over a verified bundle completes
# a row (RuntimeExitStatusV1 Exited(0)). First terminal wins: a terminal row is never overwritten.
use std.nogc_sync_mut.orchestration.workload_store_v1.ControllerJournalEditV1
use std.common.contracts.container.runtime_v1.RuntimeExitStatusV1
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.contracts.distributed_operation_state_v2.distributed_operation_transition_v2
use std.common.task_runner.distributed_operation_journal_v2.{DistributedOperationJournalV2, distributed_operation_journal_lookup_v2,
    distributed_operation_journal_commit_v2, distributed_operation_journal_publish_v3, distributed_operation_journal_read_required_v3}
use std.common.build_manager.codec.builder_wire_line_v1
use std.common.build_manager.contracts.builder_identifier_valid_v1
use std.common.crypto.sha256.sha256_text

val REMOTE_RUN_SETTLE_STATES_V1 = ["failed", "cancelled", "outcome-unknown"]
# Typed reasons only: no free text ever reaches the record.
val REMOTE_RUN_SETTLE_REASONS_V1 = ["host-failed", "host-wedged", "host-settled-without-bundle", "host-cancelled",
    "wait-bounded-cancel-sent", "wait-bounded-cancel-unsent", "exchange-failed-after-admit", "accept-refused"]

pub fn remote_run_exit_text_v1(exit: RuntimeExitStatusV1) -> text:
    match exit:
        case RuntimeExitStatusV1.Unobserved: "unobserved"
        case RuntimeExitStatusV1.NotExited(status): "not-exited:" + status
        case RuntimeExitStatusV1.Exited(code): "exited:" + str(code)
        case RuntimeExitStatusV1.Unknown(reason): "unknown:" + reason

pub fn remote_run_settle_record_v1(request: OperationEnvelopeV2, state: text, reason: text,
        exit: RuntimeExitStatusV1) -> Result<text, text>:
    val envelope = distributed_encode_operation_v2(request)?
    var wire = builder_wire_line_v1("SIMPLE-REMOTE-RUN-SETTLE-1")
    for field in [request.id, sha256_text(envelope), state, reason, remote_run_exit_text_v1(exit)]:
        wire = wire + builder_wire_line_v1(field)
    Ok(wire)

# What a Host reply that ended the run WITHOUT a bundle means for the row. Only a settled run carrying a cancel cause is
# cancelled; a wedged run keeps its reserved record charged and a failed or bundle-less settled run is failed.
pub fn remote_run_terminal_settle_v1(stage: text, cancel_cause: text) -> (text, text):
    if stage == "settled" and cancel_cause != "": return ("cancelled", "host-cancelled")
    if stage == "wedged": return ("failed", "host-wedged")
    if stage == "failed": return ("failed", "host-failed")
    ("failed", "host-settled-without-bundle")

fn remote_run_settle_refused_v1(journal: DistributedOperationJournalV2, code: text) -> ControllerJournalEditV1:
    ControllerJournalEditV1(journal: journal, result: "", error: code)

# The journal edit: result `state:record-digest` (`outcome-unknown:` carries no digest). The returned journal is always the
# most advanced one. A Host `wedged` run is settled failed on purpose: the Host itself ended it (reserved record stays
# charged, a started run never survives), unlike a local timeout, which proves nothing and stays outcome-unknown.
pub fn remote_run_settle_apply_v1(request: OperationEnvelopeV2, state: text, reason: text, exit: RuntimeExitStatusV1,
        journal: DistributedOperationJournalV2) -> ControllerJournalEditV1:
    if not REMOTE_RUN_SETTLE_STATES_V1.contains(state): return remote_run_settle_refused_v1(journal, "remote-run-settle-state")
    if not REMOTE_RUN_SETTLE_REASONS_V1.contains(reason): return remote_run_settle_refused_v1(journal, "remote-run-settle-reason")
    # Only typed exit facts reach the record: Exited(0) is success and needs a bundle; the free-text variants must be
    # identifiers (no verbatim Host text, no size surprise).
    match exit:
        case RuntimeExitStatusV1.Exited(code):
            if code == 0: return remote_run_settle_refused_v1(journal, "remote-run-settle-success-needs-bundle")
        case RuntimeExitStatusV1.NotExited(status):
            if not builder_identifier_valid_v1(status): return remote_run_settle_refused_v1(journal, "remote-run-settle-exit")
        case RuntimeExitStatusV1.Unknown(why):
            if not builder_identifier_valid_v1(why): return remote_run_settle_refused_v1(journal, "remote-run-settle-exit")
        case _: pass
    val encoded = distributed_encode_operation_v2(request)
    if encoded.is_err(): return remote_run_settle_refused_v1(journal, encoded.unwrap_err())
    val record = remote_run_settle_record_v1(request, state, reason, exit)
    if record.is_err(): return remote_run_settle_refused_v1(journal, record.unwrap_err())
    val digest = sha256_text(record.unwrap())
    val prior = distributed_operation_journal_lookup_v2(journal, request.id)
    if prior.is_err():
        return remote_run_settle_refused_v1(journal, if prior.unwrap_err() == "OPERATION_NOT_FOUND": "remote-run-settle-row-missing" else: prior.unwrap_err())
    val row = prior.unwrap()
    if row.envelope != encoded.unwrap() or row.envelope_digest != sha256_text(encoded.unwrap()):
        return remote_run_settle_refused_v1(journal, "remote-run-settle-envelope")
    val terminal = row.state == "completed" or row.state == "failed" or row.state == "cancelled"
    if terminal and not (row.state == state and row.outcome_digest == digest):
        return remote_run_settle_refused_v1(journal, "remote-run-settle-already-terminal")
    if not terminal and row.state != "executing" and row.state != "outcome-unknown":
        return remote_run_settle_refused_v1(journal, "remote-run-settle-row-state")
    # An unproven row stays unproven: a repeated outcome-unknown settle writes nothing (the row cannot carry a digest).
    if row.state == "outcome-unknown" and state == "outcome-unknown":
        return ControllerJournalEditV1(journal: journal, result: state + ":", error: "")
    # The record is published (create-only, content-addressed) and read back BEFORE the row may reference its digest.
    val key = "controller-remote-settle-v3/" + digest + ".sdn"
    val published = distributed_operation_journal_publish_v3(journal, key, record.unwrap())
    if published.is_err(): return remote_run_settle_refused_v1(journal, published.unwrap_err())
    val readback = distributed_operation_journal_read_required_v3(journal, key, 4096)
    if readback.is_err() or readback.unwrap() != record.unwrap():
        return remote_run_settle_refused_v1(journal, "remote-run-settle-record-readback")
    if terminal: return ControllerJournalEditV1(journal: journal, result: state + ":" + digest, error: "")
    val next = distributed_operation_transition_v2(row, state, if state == "outcome-unknown": "" else: digest)
    if next.is_err(): return remote_run_settle_refused_v1(journal, next.unwrap_err())
    val committed = distributed_operation_journal_commit_v2(journal, next.unwrap())
    if committed.is_err(): return remote_run_settle_refused_v1(journal, committed.unwrap_err())
    ControllerJournalEditV1(journal: committed.unwrap(), result: state + ":" + digest, error: "")

export REMOTE_RUN_SETTLE_STATES_V1, remote_run_exit_text_v1, remote_run_settle_record_v1, remote_run_terminal_settle_v1, remote_run_settle_apply_v1
