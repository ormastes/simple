# Static help data; configuration resolution and credential owners are not run.
use app.orchestrator.validation.OrchestratorValidationReplyV1
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

pub fn orchestrator_help_v1() -> OrchestratorValidationReplyV1:
    val commands: [SdnValue] = [
        SdnValue.String("container-plan-prepare <linux-podman|windows-docker-process> <candidate-context.sdn> <native-request.sdn> <config|-> <consumer> <context|-> <server|->"),
        SdnValue.String("server-resolve <config|-> <consumer> <context|-> <server|-> <host|container>"),
        SdnValue.String("server-request <config|-> <consumer> <context|-> <server|-> <host|container> <profile> <request>"),
        SdnValue.String("key-generate --store-root <private-root> --auth-ref <secret://name> --name <label>"),
        SdnValue.String("key-public --store-root <private-root> --auth-ref <secret://name>"),
        SdnValue.String("key-inspect --store-root <private-root> --auth-ref <secret://name>"),
        SdnValue.String("key-registration --store-root <private-root> --auth-ref <secret://name> --server <alias>"),
        SdnValue.String("key-pin --store-root <private-root> --public-key-file <file> --trust-ref <trust://name> --server <alias> --expected-fingerprint <SHA256:...>"),
        SdnValue.String("key-profile-install --store-root <private-root> --profile-file <public-SDN-profile>"),
        SdnValue.String("key-sendserver <config|-> <consumer> <context|-> <server|-> <host|container> <profile> --store-root <root> --auth-ref <secret://name> --server <name> --controller-id <id> --request-uid <uid>"),
        SdnValue.String("key-takeserver <config|-> <consumer> <context|-> <server|-> <host|container> <profile> --store-root <root> --trust-ref <trust://name> --server <name> --controller-id <id> --request-uid <uid> --expected-fingerprint <SHA256:...>")]
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
        "kind": SdnValue.String("orchestrator-help"), "commands": SdnValue.Array(commands),
        "consumers": SdnValue.Array([SdnValue.String("simple"), SdnValue.String("orchestrator"), SdnValue.String("caret"), SdnValue.String("agent")]),
        "registration": SdnValue.String("pending public-key request; server authorization is separate"),
        "keyEntropy": SdnValue.String("OS cryptographic entropy; text/time are labels only")}
    OrchestratorValidationReplyV1(exit_code: 0, output: sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")
