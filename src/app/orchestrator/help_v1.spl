# Static help data; configuration resolution and credential owners are not run.
use app.orchestrator.validation.OrchestratorValidationReplyV1
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

pub fn orchestrator_help_v1() -> OrchestratorValidationReplyV1:
    val commands: [SdnValue] = [
        SdnValue.String("task-retain <root> <controller> <config-digest> <packet-file>"),
        SdnValue.String("task-use <root> <controller> <config-digest> <packet-file>"),
        SdnValue.String("container-plan-prepare <linux-podman|windows-docker-process> <candidate-context.sdn> <native-request.sdn> <config|-> <consumer> <context|-> <server|->"),
        SdnValue.String("remote-run-plan --dispatch-root <private-root> --controller <id> --key-store <private-root> --approver <id> --operation <DBC_OPERATION_V2-file> --environment <remote-run-environment.sdn> --grant-id <id> --expires-in-ms <1..86400000>"),
        SdnValue.String("remote-run --dispatch-root <private-root> --config-digest <64hex> --key-store <private-root> --approver <id> --spec <dir> --out <private-state-root> --grant-id <id> --expires-in-ms <1..86400000>  (Windows or Linux controller: the dispatch owner admits the canonical native origin, the Linux root is provisioned out of band; the approver key must be enrolled for build|test, host_reservation_v1, host_execute_associated_v3 and host_agent_cancel_v4)"),
        SdnValue.String("remote-build-environment-install --store-root <private-root> --host <id> --environment <remote-run-environment-file>"),
        SdnValue.String("helper-abandon --dispatch-root <private-root> --config-digest <64hex> --abandon-id <id> --operation <helper-operation-id> [--confirm <record-sha256> --key-store <private-root> --approver <id> --grant-id <id> --expires-in-ms <1..86400000>]  (without --confirm: print the Host's exact abandon record and its sha256, sign nothing; each signed run needs a fresh --abandon-id; the approver key must be enrolled for helper-abandon)"),
        SdnValue.String("handoff-abandon --dispatch-root <private-root> --config-digest <64hex> --abandon-id <id> [--confirm <record-sha256> --key-store <private-root> --approver <id> --grant-id <id> --expires-in-ms <1..86400000>]  (OPS-01: void the pending handoff the successor cannot verify; the approver key must be enrolled for service-handoff-abandon)"),
        SdnValue.String("retention-release --dispatch-root <private-root> --config-digest <64hex> --abandon-id <id> --operation <remote-build-operation-id> [--confirm <record-sha256> --key-store <private-root> --approver <id> --grant-id <id> --expires-in-ms <1..86400000>]  (milestone_0045: delete a remote build's retained workspace on the Host after this controller settled the run completed/failed/cancelled; without --confirm print the record and its sha256; the approver key must be enrolled for retention-release; only that run's own run-<sha256(op)> child of the provisioned workspace is removed; the workspace, its quota and other runs stay)"),
        SdnValue.String("server-resolve <config|-> <consumer> <context|-> <server|-> <host|container>"),
        SdnValue.String("server-request <config|-> <consumer> <context|-> <server|-> <host|container> <profile> <request>"),
        SdnValue.String("key-generate --store-root <private-root> --auth-ref <secret://name> --name <label>"),
        SdnValue.String("key-public --store-root <private-root> --auth-ref <secret://name>"),
        SdnValue.String("key-inspect --store-root <private-root> --auth-ref <secret://name>"),
        SdnValue.String("key-registration --store-root <private-root> --auth-ref <secret://name> --server <alias>"),
        SdnValue.String("key-pin --store-root <private-root> --public-key-file <file> --trust-ref <trust://name> --server <alias> --expected-fingerprint <SHA256:...>"),
        SdnValue.String("key-profile-install --store-root <private-root> --profile-file <public-SDN-profile>"),
        SdnValue.String("key-sendserver <config|-> <consumer> <context|-> <server|-> <host|container> <profile> --store-root <root> --auth-ref <secret://name> --server <name> --controller-id <id> --request-uid <uid>"),
        SdnValue.String("key-takeserver <config|-> <consumer> <context|-> <server|-> <host|container> <profile> --store-root <root> --trust-ref <trust://name> --server <name> --controller-id <id> --request-uid <uid> --expected-fingerprint <SHA256:...>")]
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
        "kind": SdnValue.String("orchestrator-help"), "commands": SdnValue.Array(commands),
        "consumers": SdnValue.Array([SdnValue.String("simple"), SdnValue.String("orchestrator"), SdnValue.String("caret"), SdnValue.String("agent")]),
        "registration": SdnValue.String("pending public-key request; server authorization is separate"),
        "keyEntropy": SdnValue.String("OS cryptographic entropy; text/time are labels only")}
    OrchestratorValidationReplyV1(exit_code: 0, output: sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")
