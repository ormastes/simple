# Startup-only config discovery. No probing, environment mutation or retries.
use app.io.mod.{env_get, home, file_exists, file_read_regular_no_follow_bounded}
use std.common.config_core.server_context_types_v1.{ServerConfigV1, default_server_config_v1}
use std.common.config_core.server_context_decode_v1.decode_server_config_v1
use std.nogc_sync_mut.fs.host_path.host_path_is_absolute
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.value.SdnValue

# The ordinary host reader is intentionally tolerant for machine defaults.
# Endpoint routing consumes the strict decoded value without flattening or
# reparsing quoted strings through the tolerant machine-default line reader.
pub fn server_host_reference_v1(source: text) -> Result<text, text>:
    val limits = SdnStrictLimitsV1(max_source_bytes: 65536, max_depth: 3,
        max_nodes: 256, max_rows: 0, max_cells: 0, max_columns: 128)
    val parsed = sdn_parse_strict_v1(source, limits)
    if parsed.is_err(): return Err("server-host-config-invalid")
    val root = match parsed.unwrap().value:
        case SdnValue.Dict(fields): fields
        case _: return Err("server-host-config-invalid")
    if not root.contains_key("host_config"): return Err("server-host-config-invalid")
    val fields = match root["host_config"]:
        case SdnValue.Dict(values): values
        case _: return Err("server-host-config-invalid")
    if fields.contains_key("schema"):
        match fields["schema"]:
            case SdnValue.String(value):
                if value != "simple-host-config-v1": return Err("server-host-config-schema")
            case _: return Err("server-host-config-schema")
    if fields.contains_key("server_config"):
        match fields["server_config"]:
            case SdnValue.String(value):
                if value != "" and (not host_path_is_absolute(value) or value.trim() != value or value.contains("\0") or value.contains("\n") or value.contains("\r")):
                    return Err("server-host-config-path")
                return Ok(value)
            case _: return Err("server-host-config-path")
    Ok("")

pub fn server_host_reference_validate_v1(source: text) -> Result<(), text>:
    val reference = server_host_reference_v1(source)?
    Ok(())

pub fn server_config_load_v1(explicit_path: text) -> Result<ServerConfigV1, text>:
    var path = explicit_path
    var required = path != ""
    if path == "":
        path = env_get("SIMPLE_SERVERS_CONFIG")
        required = path != ""
    if path == "":
        # Public, bounded snapshot supplied by the container launch plan. This
        # carries endpoint/reference data only, never a key or runtime socket.
        val inline_source = env_get("SIMPLE_SERVERS_SDN")
        if inline_source != "": return decode_server_config_v1(inline_source)
    if path == "":
        val selected_host = env_get("SIMPLE_HOST_CONFIG")
        val user_home = home()
        val host_path = if selected_host != "": selected_host else: user_home + "/.config/simple/host.sdn"
        var host_reference = ""
        if selected_host != "" or file_exists(host_path):
            val loaded = file_read_regular_no_follow_bounded(host_path, 65536)
            if loaded.is_err(): return Err("server-host-config-unavailable")
            host_reference = server_host_reference_v1(loaded.unwrap())?
        val host_override = env_get("SIMPLE_HOST_SERVER_CONFIG")
        path = if host_override != "": host_override else: host_reference
        required = path != ""
    if path == "":
        val user_home = home()
        if user_home == "": return Err("server-config-home-unavailable")
        path = user_home + "/.config/simple/servers.sdn"
    if not host_path_is_absolute(path): return Err("server-config-absolute-path-required")
    if not required and not file_exists(path): return Ok(default_server_config_v1())
    val source = file_read_regular_no_follow_bounded(path, 65536)
    if source.is_err(): return Err("server-config-unavailable")
    decode_server_config_v1(source.unwrap())
