# Simple Orchestrator Server (`caret-serve`) driving Caret Suite (`cs`) sessions.
#
# Resolves `orchestrator` server context from `host.sdn` -> `servers.sdn`,
# opens a real WAL-backed Orchestrator Controller (`local-init`/`submit`/`inspect`/`cancel`),
# binds an authenticated loopback TCP listener (`127.0.0.1:0`), and coordinates
# Caret Suite agent + container + worktree lifecycle (launch, inspect, send,
# crashed-list, relaunch, clean close, and full shutdown cleanup).

use std.nogc_sync_mut.sosix.host.{sosix_getpid, file_remove, dir_exists, dir_create_all,
    dir_list, dir_remove, dir_remove_all}
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex
use std.nogc_sync_mut.fs.host_path.host_path_is_absolute
use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}
use std.common.build_manager.contracts.builder_identifier_valid_v1
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use app.orchestrator.validation.OrchestratorValidationReplyV1
use app.orchestrator.local_controller.orchestrator_local_input_command_v1
use app.orchestrator.reply_cleanup_v2.orchestrator_reply_cleanup_v2
use app.orchestrator.server_command_v1.server_selection_v1
use app.orchestrator.caret_session_protocol_v1.{OrchestratorCaretServerInfoV1,
    orchestrator_caret_error_reply_v1, orchestrator_caret_parse_dict_v1,
    orchestrator_caret_str_v1, orchestrator_caret_arr_v1,
    orchestrator_caret_write_frame_v1, orchestrator_caret_read_frame_v1,
    orchestrator_caret_server_info_save_v1}
use app.llm_caret.cs_dashboard.{CsDashboard, cs_dashboard_new, cs_refresh,
    cs_handle_command, cs_apply_action, cs_quote_word_if_needed, cs_reap_containers}
use app.llm_caret.cs_container_lifecycle_v1.{cs_container_records_load_v1,
    cs_container_reconcile_v1, cs_container_crashed_records_v1, cs_container_close_record_v1,
    cs_container_cleanup_old_v1}
use app.llm_caret.pane_backend.{pane_list, pane_cleanup_session}

fn _orch_caret_provider_v1(spec_arg: text) -> text:
    val head = spec_arg.split(":")[0].split("/")[0].trim().lower()
    if ["codex", "claude", "gemini", "kimi", "agy"].contains(head):
        return head
    "gemini"

fn _orch_caret_pod_sdn_v1(ns: text, name: text, provider_name: text, task_ref: text) -> text:
    ("apiVersion: orchestration.simple/v1alpha1\n" +
     "kind: AgentSession\n" +
     "metadata:\n" +
     "    name: " + name + "\n" +
     "    namespace: " + ns + "\n" +
     "spec:\n" +
     "    resourceProfileRef: agent-cpu\n" +
     "    hostPoolRef: same-host-pool\n" +
     "    runtimeClassRef: macos-seatbelt\n" +
     "    agent:\n" +
     "        provider: " + provider_name + "\n" +
     "        taskRef: " + task_ref + "\n" +
     "    workspace:\n" +
     "        repositoryRef: simple-local\n" +
     "        revisionRef: head\n" +
     "        isolation: worktree\n" +
     "        retention: retain-on-failure-or-dirty\n" +
     "    session:\n" +
     "        frontend: smux\n" +
     "        persistent: true\n" +
     "        disconnectPolicy: retain\n" +
     "    template:\n" +
     "        os:\n" +
     "            name: linux\n" +
     "        containers:\n" +
     "            - name: agent\n" +
     "              image: \"local/simple-agent:1.0.0\"\n")

fn _orch_caret_live_pane_ids_v1(session: text) -> [text]:
    var ids: [text] = []
    for p in pane_list(session):
        ids.push(p.pane_id)
    ids

fn _orch_caret_encode_reply_v1(fields: Dict<text, SdnValue>) -> text:
    var out = fields
    out["version"] = SdnValue.Int(1)
    out["kind"] = SdnValue.String("orchestrator-caret-reply")
    sdn_encode_canonical(SdnValue.Dict(out)) + "\n"

fn _orch_caret_handle_request_v1(info: OrchestratorCaretServerInfoV1, dash: CsDashboard,
        req_source: text, uid_seq: i64) -> (CsDashboard, i64, bool, text):
    val parsed = orchestrator_caret_parse_dict_v1(req_source)
    if parsed.is_err():
        return (dash, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
            "code": SdnValue.String(parsed.unwrap_err())}))
    val req = parsed.unwrap()
    if (orchestrator_caret_str_v1(req, "token") != info.token or
            orchestrator_caret_str_v1(req, "controllerId") != info.controller_id):
        return (dash, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
            "code": SdnValue.String("orchestrator-caret-unauthorized")}))
    val action = orchestrator_caret_str_v1(req, "action")
    val target = orchestrator_caret_str_v1(req, "target")
    val args = orchestrator_caret_arr_v1(req, "args")
    var d = cs_refresh(dash)
    val live_ids = _orch_caret_live_pane_ids_v1(d.session)

    if action == "status":
        val all_recs = cs_container_reconcile_v1(d.session, live_ids)
        val crashed_recs = cs_container_crashed_records_v1(d.session, live_ids)
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(true),
            "status": SdnValue.String("running"),
            "controllerId": SdnValue.String(info.controller_id),
            "listenAddr": SdnValue.String(info.listen_addr),
            "stateRoot": SdnValue.String(info.state_root),
            "session": SdnValue.String(d.session),
            "serverName": SdnValue.String(info.server_name),
            "contextName": SdnValue.String(info.context_name),
            "clientServer": SdnValue.String(orchestrator_caret_str_v1(req, "clientServer")),
            "agentCount": SdnValue.Int(d.agents.len()),
            "containerCount": SdnValue.Int(all_recs.len()),
            "crashedCount": SdnValue.Int(crashed_recs.len())
        }))

    if action == "launch":
        if args.len() == 0:
            return (d, uid_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("launch-args-empty")}))
        val next_seq = uid_seq + 1
        val req_uid = "req-agent-" + next_seq.to_text()
        val pod_name = "agent-" + next_seq.to_text()
        val provider_name = _orch_caret_provider_v1(args[0])
        val pod_sdn = _orch_caret_pod_sdn_v1("caret", pod_name, provider_name, "task-" + next_seq.to_text())
        val submitted = orchestrator_reply_cleanup_v2(orchestrator_local_input_command_v1(
            ["submit", info.state_root, info.controller_id, req_uid, "framed-source", "caret", pod_name],
            Some(pod_sdn)))
        if submitted.exit_code != 0:
            return (d, next_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("controller-submit-failed"),
                "controllerReply": SdnValue.String(submitted.output)}))
        var cmd_line = "/launch"
        for tok in args:
            cmd_line = cmd_line + " " + cs_quote_word_if_needed(tok)
        val (d1, cs_action) = cs_handle_command(d, cmd_line)
        if not cs_action.starts_with("launch:"):
            return (d, next_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("caret-launch-rejected"),
                "message": SdnValue.String(cs_action)}))
        val (d2, outcome) = cs_apply_action(d1, cs_action)
        d = cs_refresh(d2)
        val ok = outcome.starts_with("launched ")
        val agent_id = if d.agents.len() > 0: d.agents[d.agents.len() - 1].agent_id else: ""
        var container_name = ""
        var worktree_path = ""
        var attempt_dir = ""
        for rec in cs_container_records_load_v1(d.session):
            if rec.agent_id == agent_id:
                container_name = rec.name
                worktree_path = rec.worktree_path
                attempt_dir = rec.attempt_dir
        return (d, next_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(ok),
            "status": SdnValue.String(if ok: "launched" else: "launch-failed"),
            "requestUid": SdnValue.String(req_uid),
            "sourceDigest": SdnValue.String(sha256_text(pod_sdn)),
            "agentId": SdnValue.String(agent_id),
            "containerName": SdnValue.String(container_name),
            "worktreePath": SdnValue.String(worktree_path),
            "attemptDir": SdnValue.String(attempt_dir),
            "outcome": SdnValue.String(outcome)
        }))

    if action == "inspect":
        val pre_recs = cs_container_reconcile_v1(d.session, live_ids)
        val inspect_key = if target != "": target
            else: (if d.selected >= 0 and d.selected < d.agents.len(): d.agents[d.selected].agent_id else: "")
        var resolved_agent_id = inspect_key
        var container_state = "none"
        var exit_code = -1
        var worktree_path = ""
        for rec in pre_recs:
            if rec.agent_id == inspect_key or rec.name == inspect_key:
                resolved_agent_id = rec.agent_id
                container_state = rec.state
                exit_code = rec.exit_code
                worktree_path = rec.worktree_path
        var agent_status = "not-found"
        var pane_id = ""
        var screen_text = ""
        var idx = 0
        while idx < d.agents.len():
            if d.agents[idx].agent_id == resolved_agent_id:
                agent_status = d.agents[idx].status
                pane_id = d.agents[idx].pane_id
                val (ds, _sw) = cs_handle_command(d, "/switch " + resolved_agent_id)
                d = cs_refresh(ds)
                screen_text = d.screen.join("\n")
                break
            idx = idx + 1
        for rec in cs_container_reconcile_v1(d.session, _orch_caret_live_pane_ids_v1(d.session)):
            if rec.agent_id == resolved_agent_id or rec.name == inspect_key:
                container_state = rec.state
                exit_code = rec.exit_code
                worktree_path = rec.worktree_path
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(agent_status != "not-found" or container_state != "none"),
            "status": SdnValue.String("inspected"),
            "agentId": SdnValue.String(resolved_agent_id),
            "agentStatus": SdnValue.String(agent_status),
            "paneId": SdnValue.String(pane_id),
            "containerState": SdnValue.String(container_state),
            "exitCode": SdnValue.Int(exit_code),
            "worktreePath": SdnValue.String(worktree_path),
            "screen": SdnValue.String(screen_text)
        }))

    if action == "send":
        val (ds, _sw) = cs_handle_command(d, "/switch " + target)
        val msg = args.join(" ")
        val (dm, chat_act) = cs_handle_command(ds, msg)
        val (da, outcome) = cs_apply_action(dm, chat_act)
        d = cs_refresh(da)
        val ok = outcome.starts_with("sent to ")
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(ok),
            "status": SdnValue.String(if ok: "sent" else: "send-failed"),
            "agentId": SdnValue.String(target),
            "outcome": SdnValue.String(outcome)
        }))

    if action == "crashed":
        val crashed = cs_container_crashed_records_v1(d.session, live_ids)
        var items: [SdnValue] = []
        var names: [SdnValue] = []
        for rec in crashed:
            names.push(SdnValue.String(rec.name))
            items.push(SdnValue.Dict({
                "agentId": SdnValue.String(rec.agent_id),
                "containerName": SdnValue.String(rec.name),
                "exitCode": SdnValue.Int(rec.exit_code),
                "worktreePath": SdnValue.String(rec.worktree_path),
                "spec": SdnValue.String(rec.spec)
            }))
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(true),
            "status": SdnValue.String("crashed-list"),
            "crashedCount": SdnValue.Int(crashed.len()),
            "crashedNames": SdnValue.Array(names),
            "containers": SdnValue.Array(items)
        }))

    if action == "relaunch":
        var cmd_line = "/relaunch " + cs_quote_word_if_needed(target)
        for tok in args:
            cmd_line = cmd_line + " " + cs_quote_word_if_needed(tok)
        val (d1, rl_action) = cs_handle_command(d, cmd_line)
        val (d2, outcome) = cs_apply_action(d1, rl_action)
        d = cs_refresh(d2)
        val ok = outcome.starts_with("relaunched ")
        var wt_path = ""
        for rec in cs_container_records_load_v1(d.session):
            if rec.agent_id == target or rec.name == target:
                wt_path = rec.worktree_path
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(ok),
            "status": SdnValue.String(if ok: "relaunched" else: "relaunch-failed"),
            "target": SdnValue.String(target),
            "worktreePath": SdnValue.String(wt_path),
            "outcome": SdnValue.String(outcome)
        }))

    if action == "cleanup-old":
        val apply_changes = args.len() == 1 and args[0] == "--apply"
        if target != "" or (args.len() != 0 and not apply_changes):
            return (d, uid_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("cleanup-old-expected-optional-apply")}))
        val result = cs_container_cleanup_old_v1(d.session, live_ids, apply_changes)
        val ok = result.failures.len() == 0
        var status = if apply_changes: "cleanup-complete" else: "cleanup-preview"
        if not ok:
            status = "cleanup-failed"
        var eligible: [SdnValue] = []
        var removed: [SdnValue] = []
        var failures: [SdnValue] = []
        for id in result.eligible:
            eligible.push(SdnValue.String(id))
        for id in result.removed:
            removed.push(SdnValue.String(id))
        for reason in result.failures:
            failures.push(SdnValue.String(reason))
        return (cs_refresh(d), uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(ok), "status": SdnValue.String(status),
            "eligible": SdnValue.Array(eligible), "removed": SdnValue.Array(removed),
            "failures": SdnValue.Array(failures)}))

    if action == "cleanup":
        if target == "" or args.len() != 0:
            return (d, uid_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("cleanup-requires-one-target")}))
        for rec in cs_container_crashed_records_v1(d.session, live_ids):
            if rec.agent_id == target or rec.name == target:
                val (removed, outcome) = cs_container_close_record_v1(d.session, rec.agent_id, live_ids, true)
                val deleted = removed and (rec.attempt_dir == "" or not dir_exists(rec.attempt_dir)) and
                    (not rec.worktree_owned or rec.worktree_path == "" or not dir_exists(rec.worktree_path))
                return (cs_refresh(d), uid_seq, false, _orch_caret_encode_reply_v1({
                    "ok": SdnValue.Bool(deleted),
                    "status": SdnValue.String(if deleted: "cleaned" else: "cleanup-failed"),
                    "target": SdnValue.String(target),
                    "outcome": SdnValue.String(outcome)}))
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
            "code": SdnValue.String("no-matching-crashed-session")}))

    if action == "close":
        if target == "":
            return (d, uid_seq, false, _orch_caret_encode_reply_v1({
                "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                "code": SdnValue.String("close-target-required")}))
        var wt_before = ""
        var wt_owned_before = false
        var attempt_before = ""
        var agent_key = target
        for rec in cs_container_records_load_v1(d.session):
            if rec.agent_id == target or rec.name == target:
                agent_key = rec.agent_id
                wt_before = rec.worktree_path
                wt_owned_before = rec.worktree_owned
                attempt_before = rec.attempt_dir
        val (d1, cl_action) = cs_handle_command(d, "/close " + agent_key)
        val (d2, outcome) = cs_apply_action(d1, cl_action)
        d = cs_refresh(d2)
        val preserved = outcome.contains("preserved worktree")
        val wt_deleted = if wt_owned_before and wt_before != "": not dir_exists(wt_before) else: wt_before == ""
        val wt_ok = (not wt_owned_before) or wt_before == "" or not dir_exists(wt_before)
        val temp_deleted = attempt_before == "" or not dir_exists(attempt_before)
        val closed = wt_ok and temp_deleted and not outcome.starts_with("could not close pane ") and not outcome.starts_with("worktree still present:")
        var status = if closed: "closed" else: "close-failed"
        if preserved:
            status = "crashed-preserved"
        return (d, uid_seq, false, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(preserved or closed),
            "status": SdnValue.String(status),
            "target": SdnValue.String(target),
            "preservedForRelaunch": SdnValue.Bool(preserved),
            "worktreeDeleted": SdnValue.Bool(wt_deleted),
            "tempFilesDeleted": SdnValue.Bool(temp_deleted),
            "outcome": SdnValue.String(outcome)
        }))

    if action == "shutdown":
        val reap_note = cs_reap_containers(d)
        pane_cleanup_session(d.session)
        return (d, uid_seq, true, _orch_caret_encode_reply_v1({
            "ok": SdnValue.Bool(true),
            "status": SdnValue.String("stopped"),
            "note": SdnValue.String(reap_note.trim())
        }))

    (d, uid_seq, false, _orch_caret_encode_reply_v1({
        "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
        "code": SdnValue.String("action-unsupported:" + action)}))

pub fn orchestrator_caret_serve_command_v1(args: [text]) -> OrchestratorValidationReplyV1:
    var runtime_dir = ""
    var config_arg = "-"
    var controller_id = "caret-orchestrator"
    var session_name = "caret-orch"
    var i = 1
    while i < args.len():
        if args[i] == "--runtime-dir" and i + 1 < args.len():
            runtime_dir = args[i + 1]
            i = i + 2
            continue
        if args[i] == "--config" and i + 1 < args.len():
            config_arg = args[i + 1]
            i = i + 2
            continue
        if args[i] == "--controller-id" and i + 1 < args.len():
            controller_id = args[i + 1]
            i = i + 2
            continue
        if args[i] == "--session" and i + 1 < args.len():
            session_name = args[i + 1]
            i = i + 2
            continue
        return orchestrator_caret_error_reply_v1("caret-serve-argument-invalid:" + args[i], 2)
    if not host_path_is_absolute(runtime_dir) or not builder_identifier_valid_v1(controller_id):
        return orchestrator_caret_error_reply_v1("usage: caret-serve --runtime-dir <abs-dir> [--config <file|->] [--controller-id <id>] [--session <name>]", 2)
    val selected = match server_selection_v1(["server-resolve", config_arg, "orchestrator", "-", "-", "host"]):
        case Ok(sel): sel
        case Err(reason): return orchestrator_caret_error_reply_v1(reason, 1)
    dir_create_all(runtime_dir)
    val init_reply = orchestrator_reply_cleanup_v2(
        orchestrator_local_input_command_v1(["local-init", runtime_dir, controller_id], None))
    if init_reply.exit_code != 0:
        return orchestrator_caret_error_reply_v1("caret-serve-local-init-failed", 1)
    val init_dict = match orchestrator_caret_parse_dict_v1(init_reply.output):
        case Ok(d): d
        case Err(reason): return orchestrator_caret_error_reply_v1(reason, 1)
    val state_root = orchestrator_caret_str_v1(init_dict, "stateRoot")
    val token_opt = sosix_random_hex(32)
    if not token_opt.?:
        return orchestrator_caret_error_reply_v1("caret-serve-entropy-unavailable", 1)
    val listener = match TcpListener.bind("127.0.0.1:0"):
        case Ok(l): l
        case Err(_): return orchestrator_caret_error_reply_v1("caret-serve-bind-failed", 1)
    val addr = match listener.local_addr():
        case Ok(a): a
        case Err(_):
            val _c = listener.close()
            return orchestrator_caret_error_reply_v1("caret-serve-local-addr-failed", 1)
    val info = OrchestratorCaretServerInfoV1(
        controller_id: controller_id, state_root: state_root, listen_addr: addr,
        token: token_opt ?? "", pid: sosix_getpid(), session: session_name,
        server_name: selected.record.name, context_name: selected.context)
    if not orchestrator_caret_server_info_save_v1(runtime_dir, info):
        val _c = listener.close()
        return orchestrator_caret_error_reply_v1("caret-serve-info-write-failed", 1)

    var dash = cs_refresh(cs_dashboard_new(session_name))
    var uid_seq = 0
    var stopping = false
    while not stopping:
        match listener.accept_timeout(500):
            case Err(_): continue
            case Ok(stream):
                match orchestrator_caret_read_frame_v1(stream):
                    case Ok(req_source):
                        val (next_d, next_seq, stop_now, reply_text) = _orch_caret_handle_request_v1(info, dash, req_source, uid_seq)
                        dash = next_d
                        uid_seq = next_seq
                        stopping = stop_now
                        val _w = orchestrator_caret_write_frame_v1(stream, reply_text)
                    case Err(reason):
                        val _w = orchestrator_caret_write_frame_v1(stream, _orch_caret_encode_reply_v1({
                            "ok": SdnValue.Bool(false), "status": SdnValue.String("error"),
                            "code": SdnValue.String(reason)}))
                val _cs = stream.close()
    val _cl = listener.close()
    val _rm_srv = file_remove(runtime_dir + "/server.sdn")
    if state_root != "" and dir_exists(state_root):
        val _rm_state = dir_remove_all(state_root)
    if dir_exists(runtime_dir) and dir_list(runtime_dir).len() == 0:
        val _rm_rt = dir_remove(runtime_dir, false)
    OrchestratorValidationReplyV1(exit_code: 0, output: _orch_caret_encode_reply_v1({
        "ok": SdnValue.Bool(true), "status": SdnValue.String("stopped"),
        "controllerId": SdnValue.String(controller_id)}))

export orchestrator_caret_serve_command_v1
