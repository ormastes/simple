# Internal OpenSSH private-file codec. Private bytes never enter SDN or logs.
use app.orchestrator.host_identity_public_v1.{HostPublicKeyV1, host_identity_public_parse_v1}
use std.common.base_encoding.base64.base64_encode_bytes
use std.common.crypto.ed25519.{ed25519_pubkey, pure_ed25519_sign, pure_ed25519_verify}
use std.common.crypto.sha256.sha256_text
use std.common.crypto.secure_memory.secure_zero_u8_slots
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex

pub struct HostIdentityGeneratedKeyV1:
    public_key: HostPublicKeyV1
    private_file: [u8]
    label: text

# Sign domains (milestone_0030 D2): each public sign entry point is pinned to ONE signed V2 payload domain, the
# first wire line of that payload. A message outside the entry point's domain is refused, so no key file is a
# general signing oracle: a grant-issuer key signs only grants, an approver key only approvals.
val HOST_IDENTITY_SIGN_GRANT_V1 = "DBC_GRANT_SIGNATURE_V2\n"
val HOST_IDENTITY_SIGN_APPROVAL_V1 = "DBC_APPROVAL_SIGNATURE_V2\n"
# milestone_0030 13.1: the execution-host key signs only V3 remote-container completions.
val HOST_IDENTITY_SIGN_COMPLETION_V3 = "SIMPLE_REMOTE_CONTAINER_COMPLETION_SIGNATURE_V3\n"
# milestone_0038: the same key signs a Host reset-failure receipt only under its own domain, never as a completion.
val HOST_IDENTITY_SIGN_RESET_FAILURE_V3 = "SIMPLE_REMOTE_RESET_FAILURE_SIGNATURE_V3\n"

fn host_identity_sign_domain_v1(message: [u8], domain_line: text) -> bool:
    val domain = domain_line.bytes()
    if message.len() <= domain.len(): return false
    for index in 0..domain.len():
        if message[index] != domain[index]: return false
    true

struct HostIdentityPrivateUseV1:
    public_key: HostPublicKeyV1
    signature: [u8]

fn host_identity_u32_v1(value: i64) -> [u8]:
    [((value >> 24) & 255) as u8, ((value >> 16) & 255) as u8,
        ((value >> 8) & 255) as u8, (value & 255) as u8]

fn host_identity_ssh_string_v1(value: [u8]) -> [u8]:
    host_identity_u32_v1(value.len()) + value

fn host_identity_u32_at_v1(bytes: [u8], offset: i64) -> i64:
    if offset < 0 or offset + 4 > bytes.len(): return -1
    (((bytes[offset] as i64) << 24) | ((bytes[offset + 1] as i64) << 16) |
        ((bytes[offset + 2] as i64) << 8) | (bytes[offset + 3] as i64))

fn host_identity_slice_v1(bytes: [u8], offset: i64, length: i64) -> [u8]:
    if offset < 0 or length < 0 or offset > bytes.len() or length > bytes.len() - offset: return []
    # Pre-sized and written by index: no push, so no reallocation can leave a partial copy of private bytes.
    var result: [u8] = [0u8; length]
    for index in 0..length: result[index] = bytes[offset + index]
    result

pub fn host_identity_public_wire_v1(public_key: [u8]) -> Result<[u8], text>:
    if public_key.len() != 32: return Err("host-identity-key-size")
    Ok(host_identity_ssh_string_v1("ssh-ed25519".bytes()) + host_identity_ssh_string_v1(public_key))

struct HostIdentityEncodeRunV1:
    outcome: Result<[u8], text>
    # Count of owned private buffers (body, raw) whose wipe was verified.
    wiped: i64

fn host_identity_encode_refuse_v1(code: text) -> HostIdentityEncodeRunV1:
    HostIdentityEncodeRunV1(outcome: Err(code), wiped: 0)

# Standard padded base64 of `raw` wrapped at 70 columns (every line LF-terminated) between the OpenSSH armour lines,
# written by index into one buffer sized up front: byte-identical to base64 text cut into 70-character lines, without
# any text copy of the private body. Sextets are local integers, never a collection.
fn host_identity_pem_encode_v1(raw: [u8]) -> [u8]:
    val header = "-----BEGIN OPENSSH PRIVATE KEY-----\n".bytes()
    val footer = "-----END OPENSSH PRIVATE KEY-----\n".bytes()
    val alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes()
    val encoded_len = (raw.len() + 2) / 3 * 4
    val lines = (encoded_len + 69) / 70
    var pem: [u8] = [0u8; header.len() + encoded_len + lines + footer.len()]
    for index in 0..header.len(): pem[index] = header[index]
    var at = header.len()
    var column = 0
    var group = 0
    while group < raw.len():
        val b0 = raw[group] as i64
        val b1 = if group + 1 < raw.len(): raw[group + 1] as i64 else: 0
        val b2 = if group + 2 < raw.len(): raw[group + 2] as i64 else: 0
        for slot in 0..4:
            var sextet = -1
            if slot == 0: sextet = b0 >> 2
            elif slot == 1: sextet = ((b0 & 3) << 4) | (b1 >> 4)
            elif slot == 2 and group + 1 < raw.len(): sextet = ((b1 & 15) << 2) | (b2 >> 6)
            elif slot == 3 and group + 2 < raw.len(): sextet = b2 & 63
            pem[at] = if sextet < 0: 61u8 else: alphabet[sextet]
            at = at + 1
            column = column + 1
            if column == 70:
                pem[at] = 10u8
                at = at + 1
                column = 0
        group = group + 3
    if column > 0:
        pem[at] = 10u8
        at = at + 1
    for index in 0..footer.len(): pem[at + index] = footer[index]
    pem

# This pure codec accepts explicit material for interoperability regression vectors; the CLI generator obtains
# material only from the OS entropy owner. The OpenSSH private body (check words, seed + public key, label, padding)
# and the raw container are each allocated once at their exact size and written by index: no push, so no
# reallocation can leave a partial private copy. Only public parts are concatenated. The base64 body and the PEM
# armour are written straight into ONE pre-sized [u8] (host_identity_pem_encode_v1): no base64 text and no growing
# PEM text holds the seed. Body and raw are wiped on the single exit after they exist. The returned private file is
# the caller's buffer (it IS the key file); the caller owns `seed` and `check`.
pub fn host_identity_private_encode_run_v1(seed: [u8], public_key: [u8], check: [u8],
        label: text) -> HostIdentityEncodeRunV1:
    if seed.len() != 32 or public_key.len() != 32 or check.len() != 4 or label.byte_len() > 96:
        return host_identity_encode_refuse_v1("host-identity-key-size")
    for scalar in label.chars():
        if scalar < " " or scalar > "~": return host_identity_encode_refuse_v1("host-identity-key-label")
    val wire_result = host_identity_public_wire_v1(public_key)
    if wire_result.is_err(): return host_identity_encode_refuse_v1(wire_result.unwrap_err())
    val wire = wire_result.unwrap()
    val label_bytes = label.bytes()
    val unpadded = 131 + label_bytes.len()
    val body_len = (unpadded + 7) / 8 * 8
    var body: [u8] = [0u8; body_len]
    for index in 0..4:
        body[index] = check[index]
        body[4 + index] = check[index]
    val algorithm_and_key = (host_identity_ssh_string_v1("ssh-ed25519".bytes()) +
        host_identity_ssh_string_v1(public_key))
    for index in 0..51: body[8 + index] = algorithm_and_key[index]
    body[62] = 64u8
    for index in 0..32:
        body[63 + index] = seed[index]
        body[95 + index] = public_key[index]
    val label_head = host_identity_u32_v1(label_bytes.len())
    for index in 0..4: body[127 + index] = label_head[index]
    for index in 0..label_bytes.len(): body[131 + index] = label_bytes[index]
    for index in 0..body_len - unpadded: body[unpadded + index] = (index + 1) as u8
    val head = ("openssh-key-v1".bytes() + [0u8] + host_identity_ssh_string_v1("none".bytes()) +
        host_identity_ssh_string_v1("none".bytes()) + host_identity_ssh_string_v1([]) +
        host_identity_u32_v1(1) + host_identity_ssh_string_v1(wire) + host_identity_u32_v1(body_len))
    var raw: [u8] = [0u8; 98 + body_len]
    for index in 0..98: raw[index] = head[index]
    for index in 0..body_len: raw[98 + index] = body[index]
    var pem = host_identity_pem_encode_v1(raw)
    # These reports cover the owned mutable buffers only; crypto-internal temporaries do not have a RAM erasure
    # guarantee (bug doc host_identity_ed25519_std_temporaries_unwiped_2026-11-19).
    val body_wipe = secure_zero_u8_slots(body)
    val raw_wipe = secure_zero_u8_slots(raw)
    var wiped = 0
    if body_wipe.verified(): wiped = wiped + 1
    if raw_wipe.verified(): wiped = wiped + 1
    if wiped != 2:
        # The private file is never handed out on a refusal; its own wipe result cannot change the refusal.
        val _pem_wipe = secure_zero_u8_slots(pem)
        return HostIdentityEncodeRunV1(outcome: Err("host-identity-key-buffer-wipe"), wiped: wiped)
    HostIdentityEncodeRunV1(outcome: Ok(pem), wiped: wiped)

pub fn host_identity_private_encode_v1(seed: [u8], public_key: [u8], check: [u8],
        label: text) -> Result<[u8], text>:
    host_identity_private_encode_run_v1(seed, public_key, check, label).outcome

struct HostIdentityPrivateRunV1:
    outcome: Result<HostIdentityPrivateUseV1, text>
    # Count of the decoded body and seed slice wipes that were verified. Decoder refusals report 0: the decoder wipes
    # its own sextet and output buffers internally and reports a failed wipe as host-identity-key-buffer-wipe.
    wiped: i64

fn host_identity_b64_value_v1(byte: u8) -> i64:
    val c = byte as i64
    if c >= 65 and c <= 90: return c - 65
    if c >= 97 and c <= 122: return c - 97 + 26
    if c >= 48 and c <= 57: return c - 48 + 52
    if c == 43: return 62
    if c == 47: return 63
    -1

# Strict canonical base64 over the armour body, read straight from the [u8] (no text copy of the private
# section exists). Canonical layout (REVIEW_B P3-7): every line is exactly 70 characters except a non-empty last line,
# and every line, the last included, ends in LF (the OpenSSH ssh-keygen layout; a file wrapped at another width, e.g.
# 64-column PEM writers, is refused by contract: this codec's files and ssh-keygen's 70-column layout decode); padding
# only in the final quad, zero leftover bits. The decoded
# length follows from the character count and padding, so the output is allocated once and written by index (no
# push, hence no reallocation leaving a partial private copy). The four pending sextets live in ONE 4-byte [u8] that
# is reset in place after every quad and wiped (and the wipe checked) on every exit (REVIEW_B P2-2, P3-6).
fn host_identity_pem_decoded_len_v1(file: [u8], start: i64, end: i64) -> i64:
    var chars = 0
    var pads = 0
    for index in start..end:
        if file[index] != 10u8: chars = chars + 1
        if file[index] == 61u8: pads = pads + 1
    if chars == 0 or chars % 4 != 0 or pads > 2: return 0
    chars / 4 * 3 - pads

struct HostIdentityPemDecodedV1:
    # The decoded body on success; [] on any refusal (every decoder buffer was then wiped, or `error` says it was not).
    raw: [u8]
    # "" on success, else `host-identity-private-format` or `host-identity-key-buffer-wipe`.
    error: text

fn host_identity_pem_refused_v1(mut out: [u8], mut values: [u8]) -> HostIdentityPemDecodedV1:
    val out_wiped = out.len() == 0 or secure_zero_u8_slots(out).verified()
    val values_wiped = secure_zero_u8_slots(values).verified()
    if not out_wiped or not values_wiped: return HostIdentityPemDecodedV1(raw: [], error: "host-identity-key-buffer-wipe")
    HostIdentityPemDecodedV1(raw: [], error: "host-identity-private-format")

fn host_identity_pem_decode_v1(file: [u8], start: i64, end: i64) -> HostIdentityPemDecodedV1:
    var values: [u8] = [0u8; 4]
    val out_len = host_identity_pem_decoded_len_v1(file, start, end)
    if out_len <= 0: return host_identity_pem_refused_v1([], values)
    var out: [u8] = [0u8; out_len]
    var written = 0
    var count = 0
    var pad = 0
    var ended = false
    var line = 0
    var last_line = false
    var failed = false
    var index = start
    while index < end and not failed:
        val byte = file[index]
        index = index + 1
        if byte == 10u8:
            if line == 0 or last_line: failed = true
            elif line < 70: last_line = true
            line = 0
        else:
            line = line + 1
            if line > 70 or ended or last_line: failed = true
            elif byte == 61u8:
                if count < 2: failed = true
                else:
                    pad = pad + 1
                    count = count + 1
            else:
                val value = host_identity_b64_value_v1(byte)
                if value < 0 or pad > 0: failed = true
                else:
                    values[count] = value as u8
                    count = count + 1
            if not failed and count == 4:
                val v0 = values[0] as i64
                val v1 = values[1] as i64
                val v2 = values[2] as i64
                val v3 = values[3] as i64
                if written + 3 - pad > out_len: failed = true
                else:
                    out[written] = ((v0 << 2) | (v1 >> 4)) as u8
                    written = written + 1
                    if pad == 2 and (v1 & 15) != 0: failed = true
                    if pad < 2:
                        out[written] = (((v1 & 15) << 4) | (v2 >> 2)) as u8
                        written = written + 1
                    if pad == 1 and (v2 & 3) != 0: failed = true
                    if pad == 0:
                        out[written] = (((v2 & 3) << 6) | v3) as u8
                        written = written + 1
                    if pad > 0: ended = true
                count = 0
                pad = 0
                for slot in 0..4: values[slot] = 0u8
    if count != 0 or written != out_len or line != 0: failed = true
    if failed: return host_identity_pem_refused_v1(out, values)
    if not secure_zero_u8_slots(values).verified():
        return host_identity_pem_refused_v1(out, values)
    HostIdentityPemDecodedV1(raw: out, error: "")

fn host_identity_private_ascii_v1(prefix: [u8], file: [u8], at: i64) -> bool:
    if at < 0 or at + prefix.len() > file.len(): return false
    for index in 0..prefix.len():
        if file[at + index] != prefix[index]: return false
    true

fn host_identity_private_refuse_v1(code: text, wiped: i64) -> HostIdentityPrivateRunV1:
    HostIdentityPrivateRunV1(outcome: Err(code), wiped: wiped)

# Structural validation of the decoded OpenSSH body. Needs only `raw`, so it runs before the seed slice or any
# derived key exists. Returns a fixed error code, or "" when well formed. No buffer is wiped here.
fn host_identity_private_structure_v1(raw: [u8]) -> text:
    val fixed = ("openssh-key-v1".bytes() + [0u8] + host_identity_ssh_string_v1("none".bytes()) +
        host_identity_ssh_string_v1("none".bytes()) + host_identity_ssh_string_v1([]) + host_identity_u32_v1(1))
    for index in 0..fixed.len():
        if raw[index] != fixed[index]: return "host-identity-private-format"
    if host_identity_u32_at_v1(raw, 39) != 51 or host_identity_u32_at_v1(raw, 94) != raw.len() - 98:
        return "host-identity-private-format"
    if (raw.len() - 98) % 8 != 0: return "host-identity-private-padding"
    for index in 0..4:
        if raw[98 + index] != raw[102 + index]: return "host-identity-private-check"
    if (host_identity_u32_at_v1(raw, 106) != 11 or host_identity_u32_at_v1(raw, 121) != 32 or
            host_identity_u32_at_v1(raw, 157) != 64):
        return "host-identity-private-format"
    val algorithm = "ssh-ed25519".bytes()
    for index in 0..11:
        if raw[110 + index] != algorithm[index]: return "host-identity-private-format"
    val comment_length = host_identity_u32_at_v1(raw, 225)
    if comment_length < 0 or comment_length > 96 or comment_length > raw.len() - 229:
        return "host-identity-private-format"
    val padding_count = raw.len() - 229 - comment_length
    if padding_count > 7: return "host-identity-private-padding"
    for index in 0..padding_count:
        if raw[229 + comment_length + index] != (index + 1) as u8:
            return "host-identity-private-padding"
    ""

# Validate the decoded body against the public key derived from the seed (consistency), and with `sign` check the
# caller's protected key and release only a verified signature. No buffer is wiped here (the caller owns the
# single exit). Structure was already checked by host_identity_private_structure_v1.
fn host_identity_private_check_v1(raw: [u8], seed: [u8], expected_public: [u8], sign: bool,
        required_public_key: [u8], message: [u8], domain_line: text) -> Result<HostIdentityPrivateUseV1, text>:
    if expected_public.len() != 32: return Err("host-identity-private-consistency")
    for index in 0..32:
        if (raw[62 + index] != expected_public[index] or raw[125 + index] != expected_public[index] or
                raw[193 + index] != expected_public[index]):
            return Err("host-identity-private-consistency")
    val expected_wire = host_identity_public_wire_v1(expected_public)?
    for index in 0..51:
        if raw[43 + index] != expected_wire[index]: return Err("host-identity-private-consistency")
    var signature: [u8] = []
    if sign:
        if required_public_key.len() != 32: return Err("host-identity-sign-key-size")
        if message.len() < 1 or message.len() > 65536: return Err("host-identity-sign-message-size")
        if not host_identity_sign_domain_v1(message, domain_line): return Err("host-identity-sign-domain")
        for index in 0..32:
            if required_public_key[index] != expected_public[index]: return Err("host-identity-sign-key-differs")
        signature = pure_ed25519_sign(seed, expected_public, message)
        if signature.len() != 64 or not pure_ed25519_verify(expected_public, message, signature):
            return Err("host-identity-sign-failed")
    val public_key = host_identity_public_parse_v1("ssh-ed25519 " + base64_encode_bytes(expected_wire))?
    Ok(HostIdentityPrivateUseV1(public_key: public_key, signature: signature))

# Decode only our bounded unencrypted Ed25519 OpenSSH format. Validate both embedded public copies against a
# public key re-derived from the private seed. Errors are fixed codes; neither the private PEM nor a substring
# is returned. The armour and base64 are parsed on the [u8] directly, so the only private copies are the decoded
# body `raw` and the `seed` slice, both [u8], each allocated once and never grown; every exit after the decode
# wipes them (a failed wipe overrides the outcome). Structural checks run before the seed is sliced or a key derived.
fn host_identity_private_run_v1(private_file: [u8], sign: bool, required_public_key: [u8],
        message: [u8], domain_line: text) -> HostIdentityPrivateRunV1:
    if private_file.len() < 300 or private_file.len() > 4096:
        return host_identity_private_refuse_v1("host-identity-private-size", 0)
    for byte in private_file:
        if byte != 10u8 and (byte < 32u8 or byte > 126u8):
            return host_identity_private_refuse_v1("host-identity-private-format", 0)
    val header = "-----BEGIN OPENSSH PRIVATE KEY-----\n".bytes()
    val footer = "-----END OPENSSH PRIVATE KEY-----\n".bytes()
    if (not host_identity_private_ascii_v1(header, private_file, 0) or
            not host_identity_private_ascii_v1(footer, private_file, private_file.len() - footer.len())):
        return host_identity_private_refuse_v1("host-identity-private-format", 0)
    var decoded = host_identity_pem_decode_v1(private_file, header.len(), private_file.len() - footer.len())
    if decoded.error != "": return host_identity_private_refuse_v1(decoded.error, 0)
    # The decoder's own buffer is the place wiped (milestone_0050 REVIEW_C P1-1): a `var raw = decoded.raw` local would be a
    # SEPARATE value, so wiping it left this buffer, seed included, unwiped until it was freed.
    host_identity_private_body_run_v1(decoded.raw, sign, required_public_key, message, domain_line)

# The decoded-body half of host_identity_private_run_v1. `raw` is the caller's buffer (a `mut` place, never copied into
# a local): every exit wipes it in place, and the seed slice once it exists.
fn host_identity_private_body_run_v1(mut raw: [u8], sign: bool, required_public_key: [u8],
        message: [u8], domain_line: text) -> HostIdentityPrivateRunV1:
    if raw.len() < 234 or raw.len() > 512:
        val short_wipe = secure_zero_u8_slots(raw)
        if not short_wipe.verified(): return host_identity_private_refuse_v1("host-identity-key-buffer-wipe", 0)
        return host_identity_private_refuse_v1("host-identity-private-format", 1)
    val structure = host_identity_private_structure_v1(raw)
    if structure != "":
        val structure_wipe = secure_zero_u8_slots(raw)
        if not structure_wipe.verified(): return host_identity_private_refuse_v1("host-identity-key-buffer-wipe", 0)
        return host_identity_private_refuse_v1(structure, 1)
    var seed = host_identity_slice_v1(raw, 161, 32)
    # ed25519_pubkey returns only the public key: no tuple or second seed binding exists, so `seed` is the single
    # derivation-side buffer we own. Std-internal temporaries (SHA-512 output, clamped scalar) are immutable
    # values inside the std function and carry no erasure guarantee, as with the encode path.
    val derived_public = ed25519_pubkey(seed)
    val outcome = host_identity_private_check_v1(raw, seed, derived_public, sign, required_public_key, message, domain_line)
    val seed_wipe = secure_zero_u8_slots(seed)
    val raw_wipe = secure_zero_u8_slots(raw)
    var wiped = 0
    if seed_wipe.verified(): wiped = wiped + 1
    if raw_wipe.verified(): wiped = wiped + 1
    if wiped != 2: return host_identity_private_refuse_v1("host-identity-key-buffer-wipe", wiped)
    HostIdentityPrivateRunV1(outcome: outcome, wiped: wiped)

fn host_identity_private_use_v1(private_file: [u8], sign: bool, required_public_key: [u8],
        message: [u8], domain_line: text) -> Result<HostIdentityPrivateUseV1, text>:
    host_identity_private_run_v1(private_file, sign, required_public_key, message, domain_line).outcome

pub fn host_identity_private_public_v1(private_file: [u8]) -> Result<HostPublicKeyV1, text>:
    val used = host_identity_private_use_v1(private_file, false, [], [], "")?
    Ok(used.public_key)

# Sign-only capability: each entry returns the 64-byte Ed25519 signature and nothing else, only for a message
# in its domain. The seed is never returned, stored or logged; `required_public_key` is the verifier's
# protected 32-byte key (the snapshot key for the role), so a file holding another key cannot sign.
# Controller grant-issuer key (milestone_0030 D2): signs only DBC_GRANT_SIGNATURE_V2 messages.
pub fn host_identity_private_sign_grant_v1(private_file: [u8], required_public_key: [u8],
        message: [u8]) -> Result<[u8], text>:
    val used = host_identity_private_use_v1(private_file, true, required_public_key, message, HOST_IDENTITY_SIGN_GRANT_V1)?
    Ok(used.signature)

# Controller approver key (milestone_0030 D1/D2): signs only DBC_APPROVAL_SIGNATURE_V2 messages.
pub fn host_identity_private_sign_approval_v1(private_file: [u8], required_public_key: [u8],
        message: [u8]) -> Result<[u8], text>:
    val used = host_identity_private_use_v1(private_file, true, required_public_key, message,
        HOST_IDENTITY_SIGN_APPROVAL_V1)?
    Ok(used.signature)

# Execution-host key (milestone_0030 13.1): signs only SIMPLE_REMOTE_CONTAINER_COMPLETION_SIGNATURE_V3 messages.
pub fn host_identity_private_sign_completion_v3(private_file: [u8], required_public_key: [u8],
        message: [u8]) -> Result<[u8], text>:
    val used = host_identity_private_use_v1(private_file, true, required_public_key, message,
        HOST_IDENTITY_SIGN_COMPLETION_V3)?
    Ok(used.signature)

# Execution-host key (milestone_0038): signs only SIMPLE_REMOTE_RESET_FAILURE_SIGNATURE_V3 messages.
pub fn host_identity_private_sign_reset_failure_v3(private_file: [u8], required_public_key: [u8],
        message: [u8]) -> Result<[u8], text>:
    val used = host_identity_private_use_v1(private_file, true, required_public_key, message,
        HOST_IDENTITY_SIGN_RESET_FAILURE_V3)?
    Ok(used.signature)

pub fn host_identity_entropy_valid_v1(hex: text) -> bool:
    if hex.byte_len() != 72: return false
    var seed_nonzero = false
    for index in 0..72:
        val code = hex.char_code_at(index)
        if not ((code >= 48 and code <= 57) or (code >= 97 and code <= 102)): return false
        if index < 64 and code != 48: seed_nonzero = true
    seed_nonzero

# Decodes the validated 72-hex entropy into 36 bytes, written by index into a single pre-sized buffer. Invalid
# input returns [] before any buffer exists, so no partial secret buffer can be returned on an error path.
fn host_identity_entropy_bytes_v1(hex: text) -> [u8]:
    if not host_identity_entropy_valid_v1(hex): return []
    var result: [u8] = [0u8; 36]
    var high = 0
    for index in 0..72:
        val code = hex.char_code_at(index)
        val digit = if code <= 57: code - 48 else: code - 97 + 10
        if index % 2 == 0: high = digit * 16
        else: result[index / 2] = (high + digit) as u8
    result

# Raw user text, including controls, becomes a hash fragment in a public label.
pub fn host_identity_label_v1(user_text: text, unix_micros: i64) -> Result<text, text>:
    if user_text.byte_len() < 1 or user_text.byte_len() > 256 or unix_micros < 0:
        return Err("host-identity-name-invalid")
    val name_digest = sha256_text(user_text)
    Ok("host-" + name_digest.substring(0, 16) + "-" + unix_micros.to_text())

# Absence selects a time-only public name; an explicitly empty name still goes
# through named-label validation and fails. Neither branch supplies key entropy.
pub fn host_identity_generation_label_v1(name: Option<text>, unix_micros: i64) -> Result<text, text>:
    if val user_text = name: return host_identity_label_v1(user_text, unix_micros)
    if unix_micros < 0: return Err("host-identity-name-invalid")
    Ok("host-" + unix_micros.to_text())

struct HostIdentityGenerateRunV1:
    outcome: Result<HostIdentityGeneratedKeyV1, text>
    # Count of owned private buffers (seed, check, entropy bytes, plus the encoder's body and raw) wiped and verified.
    wiped: i64

fn host_identity_generate_refuse_v1(code: text, wiped: i64) -> HostIdentityGenerateRunV1:
    HostIdentityGenerateRunV1(outcome: Err(code), wiped: wiped)

fn host_identity_generated_public_v1(derived_public: [u8]) -> Result<HostPublicKeyV1, text>:
    val wire = host_identity_public_wire_v1(derived_public)?
    host_identity_public_parse_v1("ssh-ed25519 " + base64_encode_bytes(wire))

# Key generation from explicit entropy hex (the OS entropy owner supplies it in production). The entropy bytes, seed
# slice and check slice are each allocated once, never grown, and all wiped on the single exit after they exist
# (including when a later step refuses); a failed wipe overrides the outcome. The `entropy` hex text itself is an
# immutable plaintext copy of the seed and check that this function cannot erase (REVIEW_B P2-3).
pub fn host_identity_key_generate_from_entropy_run_v1(entropy: text, label: text) -> HostIdentityGenerateRunV1:
    var bytes = host_identity_entropy_bytes_v1(entropy)
    if bytes.len() != 36: return host_identity_generate_refuse_v1("host-identity-entropy-unavailable", 0)
    var seed = host_identity_slice_v1(bytes, 0, 32)
    var check = host_identity_slice_v1(bytes, 32, 4)
    val derived_public = ed25519_pubkey(seed)
    val encoded = host_identity_private_encode_run_v1(seed, derived_public, check, label)
    val public_result = host_identity_generated_public_v1(derived_public)
    val seed_wipe = secure_zero_u8_slots(seed)
    val check_wipe = secure_zero_u8_slots(check)
    val bytes_wipe = secure_zero_u8_slots(bytes)
    var wiped = encoded.wiped
    if seed_wipe.verified(): wiped = wiped + 1
    if check_wipe.verified(): wiped = wiped + 1
    if bytes_wipe.verified(): wiped = wiped + 1
    # A refusal never hands out the private file: it is wiped here (its wipe result cannot change the refusal), and a
    # failed seed/check/entropy wipe still overrides every other outcome.
    if not seed_wipe.verified() or not check_wipe.verified() or not bytes_wipe.verified():
        if encoded.outcome.is_ok():
            var dropped = encoded.outcome.unwrap()
            val _dropped_wipe = secure_zero_u8_slots(dropped)
        return host_identity_generate_refuse_v1("host-identity-key-buffer-wipe", wiped)
    if encoded.outcome.is_err(): return host_identity_generate_refuse_v1(encoded.outcome.unwrap_err(), wiped)
    var private_file = encoded.outcome.unwrap()
    if public_result.is_err():
        val _file_wipe = secure_zero_u8_slots(private_file)
        return host_identity_generate_refuse_v1(public_result.unwrap_err(), wiped)
    HostIdentityGenerateRunV1(
        outcome: Ok(HostIdentityGeneratedKeyV1(public_key: public_result.unwrap(), private_file: private_file,
            label: label)),
        wiped: wiped)

# Caller must admit/retain its private store BEFORE calling this function.
# Name/time affect only a bounded public comment; the seed/check come from the
# existing checked OS CSPRNG owner, never from text, time, hashes or a password.
# Residue stated plainly (REVIEW_B P2-3): that owner's only API returns the 36 entropy bytes as immutable hex TEXT,
# so `entropy` is a plaintext copy of the seed and check that cannot be wiped. Removing it needs a bytes-returning
# entropy extern (a runtime change); tracked in host_identity_ed25519_std_temporaries_unwiped_2026-11-19.
pub fn host_identity_key_generate_v1(name: Option<text>, unix_micros: i64) -> Result<HostIdentityGeneratedKeyV1, text>:
    val label = host_identity_generation_label_v1(name, unix_micros)?
    val entropy = sosix_random_hex(36)
    if entropy == nil: return Err("host-identity-entropy-unavailable")
    host_identity_key_generate_from_entropy_run_v1(entropy.unwrap(), label).outcome

export HostIdentityGeneratedKeyV1, host_identity_public_wire_v1, host_identity_private_encode_v1
export host_identity_private_encode_run_v1, host_identity_key_generate_from_entropy_run_v1
export host_identity_private_public_v1, host_identity_key_generate_v1
export host_identity_private_sign_grant_v1, host_identity_private_sign_approval_v1
export host_identity_private_sign_completion_v3, host_identity_private_sign_reset_failure_v3
export host_identity_entropy_valid_v1
export host_identity_label_v1
export host_identity_generation_label_v1
