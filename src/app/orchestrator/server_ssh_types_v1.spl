# Explicit SSH credential references and one owned, bounded transport turn.
# Neither a decoded reference nor remote metadata grants a local descriptor.
use std.nogc_sync_mut.io.stdin_command_v1.StdinCommandOwnerV1
use std.nogc_sync_mut.io.host_identity_store_v1.HostIdentityStoreV1
use std.nogc_sync_mut.daemon_sdk.local_gateway_protocol_v1.LocalGatewayHeaderV1

pub const SERVER_SSH_STDOUT_LIMIT_V1: i64 = 8396816
pub const SERVER_SSH_STDERR_LIMIT_V1: i64 = 16384

pub struct ServerSshProfileV1:
    auth_ref: text
    trust_ref: text
    user: text
    ssh_executable: text
    identity_path: text
    known_hosts_path: text
    host_key_alias: text
    ssh_digest: text = ""
    store_root: text = ""

pub struct ServerGatewayStdioRequestV1:
    header: LocalGatewayHeaderV1
    payload: text

pub struct ServerSshProfileLoadTurnV1:
    profile: Option<ServerSshProfileV1>
    cleanup: Option<HostIdentityStoreV1>
    error: text

pub struct ServerSshTurnV1:
    # Retain this turn while either cleanup owner is present, including on
    # error. complete means released, not successful remote action.
    lease: StdinCommandOwnerV1?
    request_id: text
    input_bytes: i64
    stdout: [u8]
    stderr: [u8]
    stdout_received: i64
    stderr_received: i64
    response_header: LocalGatewayHeaderV1?
    response_payload: text
    cancel_requested: bool
    complete: bool
    error: text
    store_cleanup: HostIdentityStoreV1? = None

export ServerSshProfileV1, ServerSshTurnV1, ServerGatewayStdioRequestV1
export ServerSshProfileLoadTurnV1
export SERVER_SSH_STDOUT_LIMIT_V1, SERVER_SSH_STDERR_LIMIT_V1
