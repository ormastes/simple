# Offline authoring for the existing Linux V4 Host agent path. The resulting
# draft must still be reserved, signed and accepted by the native Host.
use app.orchestrator.validation.OrchestratorValidationReplyV1
use std.common.contracts.container.execution_draft_v3.{ContainerExecutionDraftV3, container_execution_draft_encode_v3}
use std.common.contracts.container.agent_workspace_manifest_v1.agent_workspace_manifest_decode_v1
use std.common.contracts.container.agent_executable_profile_v1.{agent_executable_profile_encode_v1,
    agent_executable_profile_minimum_memory_v1}
use std.common.contracts.container.linux_agent_workspace_profile_v2.{linux_agent_workspace_profile_decode_v2,
    linux_agent_workspace_profile_match_v2}
use std.common.contracts.orchestration.agent_workspace_invocation_v2.agent_workspace_invocation_manifest_decode_v2
use std.common.contracts.provider_cli.adapter_types_v1.ProviderCliProviderV1
use std.common.crypto.sha256.sha256_text
use std.common.build_manager.contracts.builder_digest_valid_v1
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.value.SdnValue
use std.nogc_async_mut.container.providers.linux.request_v1.linux_oci_request_digest_v1
use std.nogc_async_mut.container.providers.linux.request_codec_v1.{linux_oci_retained_request_decode_v1,
    linux_oci_retained_request_encode_v1}
use std.nogc_async_mut.llm.provider_cli_profiled_probe_v2.provider_cli_profiled_probe_transcripts_digest_v2
use std.nogc_sync_mut.orchestration.host_linux_service_agent_v4.{HostAgentInvokeRequestV4, host_agent_invoke_request_encode_v4}
use std.nogc_sync_mut.sosix.host.file_read_regular_no_follow_bounded
use std.nogc_sync_mut.fs.host_path.host_path_is_absolute

pub struct LinuxAgentRunPlanV1:
    draft: ContainerExecutionDraftV3
    invocation: text

pub fn linux_agent_run_plan_v1(template_bytes: text, manifest_bytes: text, profile_bytes: text,
        probe_transcripts: [text]) -> Result<LinuxAgentRunPlanV1, text>:
    val manifest = agent_workspace_invocation_manifest_decode_v2(manifest_bytes)?
    if manifest.base.task_use.provider != "codex": return Err("agent-run-provider-unsupported")
    if manifest.base.credential_refs.len() != 0: return Err("agent-run-credential-projection-unavailable")
    val workspace = agent_workspace_manifest_decode_v1(manifest.base.workspace_manifest)?
    val profile = linux_agent_workspace_profile_decode_v2(profile_bytes)?
    if workspace.profile_digest != sha256_text(profile_bytes): return Err("agent-run-profile-digest-mismatch")
    val _matched = linux_agent_workspace_profile_match_v2(profile, workspace)?
    if (agent_executable_profile_encode_v1(profile.executable_profile)? !=
            agent_executable_profile_encode_v1(manifest.executable_profile)?):
        return Err("agent-run-executable-profile-mismatch")
    if manifest.base.image_config_id != profile.base.image_config_id or manifest.base.inner_argv[0] != profile.base.agent_program:
        return Err("agent-run-program-binding")
    var request = linux_oci_retained_request_decode_v1(template_bytes)?
    if (request.operation_id != manifest.base.operation_id or request.pod_uid != manifest.base.desired.workload_uid or
            request.attempt != manifest.base.task_use.attempt):
        return Err("agent-run-workload-binding")
    val image = request.image.split("@sha256:")
    if image.len() != 2 or image[0] == "" or not builder_digest_valid_v1(image[1]):
        return Err("agent-run-image-digest-required")
    if (request.image != profile.base.image or request.command != [profile.base.bootstrap_program] or
            request.args.len() != 0 or not request.replace_entrypoint or request.filesystem_policy != "read-only" or
            request.build_output_root != "" or request.bundle_path != ""):
        return Err("agent-run-bootstrap-template")
    val minimum = agent_executable_profile_minimum_memory_v1(manifest.executable_profile)?
    if request.memory_limit_bytes < minimum: return Err("agent-run-memory-below-profile")
    if request.timeout_ms <= 0 or request.timeout_ms > manifest.base.workload_duration_ms:
        return Err("agent-run-timeout-outside-manifest")
    val probes = provider_cli_profiled_probe_transcripts_digest_v2(ProviderCliProviderV1.Codex, probe_transcripts)?
    val manifest_digest = sha256_text(manifest_bytes)
    request.args = ["--invocation-manifest-sha256", manifest_digest]
    val draft = ContainerExecutionDraftV3(backend: "linux-podman", workload_uid: request.pod_uid,
        attempt: request.attempt, operation_id: request.operation_id, request_digest: linux_oci_request_digest_v1(request)?,
        request_bytes: linux_oci_retained_request_encode_v1(request)?, readonly_rootfs: true,
        agent_invocation_manifest_digest: manifest_digest, agent_probe_list_digest: probes)
    val _draft_bytes = container_execution_draft_encode_v3(draft)?
    val invocation = host_agent_invoke_request_encode_v4(HostAgentInvokeRequestV4(request.operation_id, manifest_bytes))?
    Ok(LinuxAgentRunPlanV1(draft, invocation))

fn agent_run_read_v1(path: text, maximum: i64) -> Result<text, text>:
    if (not host_path_is_absolute(path) or path.byte_len() > 4096 or path.contains("\0") or
            path.contains("\n") or path.contains("\r") or path.contains("\t")):
        return Err("agent-run-input-path")
    file_read_regular_no_follow_bounded(path, maximum)

fn agent_run_probes_v1(source: text) -> Result<[text], text>:
    val parsed = sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 4096, max_depth: 2,
        max_nodes: 16, max_rows: 0, max_cells: 0, max_columns: 8))
    if parsed.is_err(): return Err("agent-run-probe-list-syntax")
    val items = match parsed.unwrap().value:
        case SdnValue.Array(values): values
        case _: return Err("agent-run-probe-list-type")
    var digests: [text] = []
    for item in items:
        match item:
            case SdnValue.String(digest): digests.push(digest)
            case _: return Err("agent-run-probe-list-type")
    Ok(digests)

fn agent_run_plan_output_v1(args: [text]) -> Result<text, text>:
    if args.len() != 5 or args[0] != "agent-run-plan":
        return Err("agent-run-plan-usage")
    val template = agent_run_read_v1(args[1], 1048576)?
    val manifest = agent_run_read_v1(args[2], 1048576)?
    val profile = agent_run_read_v1(args[3], 16384)?
    val probes = agent_run_probes_v1(agent_run_read_v1(args[4], 4096)?)?
    val plan = linux_agent_run_plan_v1(template, manifest, profile, probes)?
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("agent-run-plan"),
        "draft": SdnValue.String(container_execution_draft_encode_v3(plan.draft)?),
        "invocation": SdnValue.String(plan.invocation), "executionAuthorized": SdnValue.Bool(false)}
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

pub fn agent_run_plan_command_v1(args: [text]) -> OrchestratorValidationReplyV1:
    match agent_run_plan_output_v1(args):
        case Ok(output): OrchestratorValidationReplyV1(exit_code: 0, output: output)
        case Err(code):
            val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("agent-run-plan-error"),
                "code": SdnValue.String(code), "executionAuthorized": SdnValue.Bool(false)}
            OrchestratorValidationReplyV1(exit_code: 2, output: sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")
