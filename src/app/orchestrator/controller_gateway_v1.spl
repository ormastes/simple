# SSH is authenticated carriage. Installed local controller policy selects the
# domain; no wire field selects a filesystem root, executable or peer identity.
use std.nogc_sync_mut.sosix.host.{file_read_regular_no_follow_bounded, file_is_regular_no_follow}
use app.orchestrator.validation.OrchestratorValidationReplyV1
use app.orchestrator.local_controller.orchestrator_local_input_command_v1
use app.orchestrator.execution.orchestrator_execution_input_command_v2
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.nogc_sync_mut.daemon_sdk.local_gateway_protocol_v1.LocalGatewayHeaderV1
use std.nogc_sync_mut.sosix.host.file_mode_bits
use std.nogc_sync_mut.fs.host_path.host_path_is_absolute
use app.llm_caret.orchestrator_client.{CaretOrchestratorRequestV1, caret_orchestrator_decode_reply_v1}
use app.llm_caret.orchestrator_execution_client_v2.{CaretExecutionRequestV2, caret_execution_decode_v2}
use app.orchestrator.host_identity_exchange_v1.{host_identity_gateway_v1, host_identity_exchange_response_v1}
use app.orchestrator.host_identity_public_v1.host_identity_public_parse_v1
use app.orchestrator.host_action_command_v1.{host_action_agent_gateway_v1, host_action_pane_refusal_code_v1}
use std.common.contracts.orchestration.host_control_operation_v6.{HOST_AGENT_PANE_SUBS_V6, HOST_AGENT_PANE_TARGET_SUB_V6,
    HostControlSubRequestV6, host_control_sub_decode_v6}
use std.common.contracts.orchestration.host_agent_pane_stream_v6.{HostAgentPaneStreamRequestV6,
    host_agent_pane_stream_request_decode_v6, host_agent_pane_stream_request_matches_v6,
    host_agent_pane_stream_receipt_decode_v6, host_agent_pane_stream_receipt_matches_v6, host_agent_pane_target_receipt_decode_v6}
use std.nogc_sync_mut.orchestration.host_agent_attachment_v4.{host_agent_attach_request_decode_v4,
    host_agent_detach_request_decode_v4}
use std.nogc_sync_mut.orchestration.host_linux_service_agent_v4.host_agent_invoke_request_decode_v4

pub struct ControllerGatewayConfigV1:
    state_root: text
    controller_id: text
    allowed_actions: [text]
    server_name: text = ""
    identity_store_root: text = ""
    server_public_key_path: text = ""
    dispatch_root: text = ""
    dispatch_config_digest: text = ""

pub struct ControllerGatewayRequestV1:
    action: text
    controller_id: text
    request_uid: text
    source: text
    ns: text
    name: text
    source_digest: text

fn gateway_fields_v1(source: text, maximum: i64) -> Result<Dict<text, SdnValue>, text>:
    val limits = SdnStrictLimitsV1(max_source_bytes: maximum, max_depth: 3,
        max_nodes: 64, max_rows: 0, max_cells: 0, max_columns: 16)
    val parsed = sdn_parse_strict_v1(source, limits)
    if parsed.is_err(): return Err("controller-gateway-syntax")
    match parsed.unwrap().value:
        case SdnValue.Dict(fields): Ok(fields)
        case _: Err("controller-gateway-object-required")

fn gateway_keys_v1(fields: Dict<text, SdnValue>, keys: [text], expected_version: i64 = 1) -> Result<(), text>:
    if fields.len() != keys.len(): return Err("controller-gateway-fields")
    for key in keys:
        if not fields.contains_key(key): return Err("controller-gateway-fields")
    match fields["version"]:
        case SdnValue.Int(version):
            if version != expected_version: return Err("controller-gateway-version")
        case _: return Err("controller-gateway-version")
    Ok(())

fn gateway_text_v1(fields: Dict<text, SdnValue>, key: text) -> Result<text, text>:
    match fields[key]:
        case SdnValue.String(value): Ok(value)
        case _: Err("controller-gateway-text:" + key)

fn gateway_existing_actions_v1() -> [text]:
    ["submit", "inspect", "cancel", "dispatch", "resume-execution", "inspect-execution", "identity-register",
        "identity-server", "agent-attachment", "agent-invoke", HOST_AGENT_PANE_TARGET_SUB_V6]

pub fn controller_gateway_actions_v1() -> [text]:
    gateway_existing_actions_v1() + HOST_AGENT_PANE_SUBS_V6

fn gateway_pane_request_v1(request: ControllerGatewayRequestV1) -> Result<HostAgentPaneStreamRequestV6, text>:
    if request.ns != "" or request.name != "" or request.source_digest != "":
        return Err("controller-gateway-agent-pane-fields")
    val sub = host_control_sub_decode_v6(request.source)?
    if sub.sub != request.action: return Err("controller-gateway-agent-pane-sub")
    val pane = host_agent_pane_stream_request_decode_v6(sub.frame)?
    if not host_agent_pane_stream_request_matches_v6(sub.sub, pane):
        return Err("controller-gateway-agent-pane-request")
    Ok(pane)

fn gateway_pane_response_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    val pane = gateway_pane_request_v1(request)?
    val receipt = host_agent_pane_stream_receipt_decode_v6(response)?
    if not host_agent_pane_stream_receipt_matches_v6(request.request_uid, pane, receipt):
        return Err("controller-gateway-agent-pane-receipt-mismatch")
    Ok(response)

fn gateway_pane_refusal_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    val fields = gateway_fields_v1(response, 4096)?
    gateway_keys_v1(fields, ["version", "kind", "state", "operationId", "record", "recordDigest", "detail"])?
    if gateway_text_v1(fields, "kind")? != request.action or gateway_text_v1(fields, "state")? != "host-refused" or
            gateway_text_v1(fields, "operationId")? != request.request_uid or gateway_text_v1(fields, "record")? != "" or
            gateway_text_v1(fields, "recordDigest")? != "" or not host_action_pane_refusal_code_v1(gateway_text_v1(fields, "detail")?):
        return Err("controller-gateway-agent-pane-refusal-mismatch")
    val canonical = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if canonical != response: return Err("controller-gateway-agent-pane-refusal-noncanonical")
    Ok(canonical)

# A pinned remote gateway's nonzero pane frames still need schema and subject
# validation before any detail reaches the terminal-facing caller.
pub fn controller_gateway_nonzero_reply_v1(request_source: text, exit_code: i64,
        response: text) -> OrchestratorValidationReplyV1:
    val request = controller_gateway_request_decode_v1(request_source)
    if request.is_ok():
        val exact = request.unwrap()
        if not HOST_AGENT_PANE_SUBS_V6.contains(exact.action) and exact.action != HOST_AGENT_PANE_TARGET_SUB_V6:
            return OrchestratorValidationReplyV1(exit_code: exit_code, output: response)
        if exit_code == 1 and HOST_AGENT_PANE_SUBS_V6.contains(exact.action):
            val checked = gateway_pane_refusal_v1(exact, response)
            if checked.is_ok():
                return OrchestratorValidationReplyV1(exit_code: 1, output: checked.unwrap())
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("server-command-error"),
        "code": SdnValue.String("server-pane-outcome-unconfirmed"), "reconciliationRequired": SdnValue.Bool(true)}
    OrchestratorValidationReplyV1(exit_code: 2, output: sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

fn gateway_attachment_sub_v1(request: ControllerGatewayRequestV1) -> Result<HostControlSubRequestV6, text>:
    if request.ns != "" or request.name != "" or request.source_digest != "":
        return Err("controller-gateway-agent-attachment-fields")
    val sub = host_control_sub_decode_v6(request.source)?
    val operation_id = match sub.sub:
        case "agent-inspect": sub.frame
        case "agent-attach":
            val attach = host_agent_attach_request_decode_v4(sub.frame)?
            attach.operation_id
        case "agent-detach":
            val detach = host_agent_detach_request_decode_v4(sub.frame)?
            detach.operation_id
        case _: return Err("controller-gateway-agent-attachment-sub")
    if operation_id != request.request_uid: return Err("controller-gateway-agent-attachment-operation")
    Ok(sub)

fn gateway_invocation_frame_v1(request: ControllerGatewayRequestV1) -> Result<text, text>:
    val prefix = "controller-gateway-" + request.action
    if request.ns != "" or request.name != "" or request.source_digest != "":
        return Err(prefix + "-fields")
    val sub = host_control_sub_decode_v6(request.source)?
    if sub.sub != request.action: return Err(prefix + "-sub")
    val invoke = host_agent_invoke_request_decode_v4(sub.frame)?
    if invoke.operation_id != request.request_uid: return Err(prefix + "-operation")
    Ok(sub.frame)

fn gateway_pane_target_response_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    val frame = gateway_invocation_frame_v1(request)?
    val receipt = host_agent_pane_target_receipt_decode_v6(response)?
    if receipt.operation_id != request.request_uid or receipt.invoke_digest != sha256_text(frame):
        return Err("controller-gateway-agent-pane-target-receipt-mismatch")
    Ok(response)

fn gateway_invoke_response_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    val fields = gateway_fields_v1(response, 65536)?
    gateway_keys_v1(fields, ["version", "kind", "operationId", "associationDigest", "stage", "workloadIndex",
        "outcome", "pending"], 4)?
    if gateway_text_v1(fields, "kind")? != "linux-host-agent-invoke-reply" or
            gateway_text_v1(fields, "operationId")? != request.request_uid:
        return Err("controller-gateway-agent-invoke-report-operation")
    val stage = gateway_text_v1(fields, "stage")?
    val outcome = gateway_text_v1(fields, "outcome")?
    if not builder_digest_valid_v1(gateway_text_v1(fields, "associationDigest")?) or
            not builder_identifier_valid_v1(stage) or not ["", "succeeded", "failed"].contains(outcome):
        return Err("controller-gateway-agent-invoke-report-invalid")
    match fields["workloadIndex"]:
        case SdnValue.Int(index):
            if index < 0: return Err("controller-gateway-agent-invoke-report-invalid")
        case _: return Err("controller-gateway-agent-invoke-report-invalid")
    match fields["pending"]:
        case SdnValue.Bool(pending):
            if pending != (stage != "settled") or (not pending and outcome == ""):
                return Err("controller-gateway-agent-invoke-report-invalid")
        case _: return Err("controller-gateway-agent-invoke-report-invalid")
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

fn gateway_attachment_response_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    val sub = gateway_attachment_sub_v1(request)?
    val fields = gateway_fields_v1(response, 65536)?
    val base = ["version", "kind", "operationId", "attachStage"]
    for key in base:
        if not fields.contains_key(key): return Err("controller-gateway-attachment-report")
    match fields["version"]:
        case SdnValue.Int(version):
            if version != 4: return Err("controller-gateway-attachment-report")
        case _: return Err("controller-gateway-attachment-report")
    if gateway_text_v1(fields, "kind")? != "linux-host-agent-attachment" or
            gateway_text_v1(fields, "operationId")? != request.request_uid:
        return Err("controller-gateway-attachment-report-operation")
    val stage = gateway_text_v1(fields, "attachStage")?
    if stage == "none":
        if sub.sub != "agent-inspect" or fields.len() != base.len(): return Err("controller-gateway-attachment-report")
        return Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")
    if not ["refused", "refused-expire-pending", "opening", "ready", "adopted", "revoked", "cleaned", "settling",
            "returned", "failed", "release-blocked"].contains(stage):
        return Err("controller-gateway-attachment-report-stage")
    val digests = ["attachDigest", "detachDigest", "quiesceProofDigest"]
    val live = ["leaseEpoch", "readyDeadlineMs", "ioDeadlineMs", "detachDeadlineMs"]
    val allowed = base + digests + live + ["error", "terminalAuthority"]
    for key in fields.keys():
        if not allowed.contains(key):
            return Err("controller-gateway-attachment-report-fields")
    for key in ["attachDigest", "detachDigest", "error"]:
        if not fields.contains_key(key): return Err("controller-gateway-attachment-report-fields")
    val attach_digest = gateway_text_v1(fields, "attachDigest")?
    val detach_digest = gateway_text_v1(fields, "detachDigest")?
    val _error = gateway_text_v1(fields, "error")?
    if not builder_digest_valid_v1(attach_digest) or (detach_digest != "" and not builder_digest_valid_v1(detach_digest)):
        return Err("controller-gateway-attachment-report-digest")
    if fields.contains_key("quiesceProofDigest") and not builder_digest_valid_v1(gateway_text_v1(fields, "quiesceProofDigest")?):
        return Err("controller-gateway-attachment-report-digest")
    val retained = fields.contains_key("leaseEpoch")
    for key in live:
        if fields.contains_key(key) != retained:
            return Err("controller-gateway-attachment-report-fields")
        if retained and not fields[key].is_int(): return Err("controller-gateway-attachment-report-fields")
    if fields.contains_key("terminalAuthority"):
        if sub.sub != "agent-inspect" or not ["ready", "adopted"].contains(stage) or
                not retained or gateway_text_v1(fields, "terminalAuthority")? == "":
            return Err("controller-gateway-attachment-report-authority")
    if ((sub.sub == "agent-attach" and attach_digest != sha256_text(sub.frame)) or
            (sub.sub == "agent-detach" and detach_digest != sha256_text(sub.frame))):
        return Err("controller-gateway-attachment-report-digest")
    Ok(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n")

pub fn controller_gateway_config_decode_v1(source: text) -> Result<ControllerGatewayConfigV1, text>:
    var fields = gateway_fields_v1(source, 16384)?
    for key in ["serverName", "identityStoreRoot", "serverPublicKeyPath", "dispatchRoot", "dispatchConfigDigest"]:
        if not fields.contains_key(key): fields[key] = SdnValue.String("")
    gateway_keys_v1(fields, ["version", "stateRoot", "controllerId", "allowedActions", "serverName",
        "identityStoreRoot", "serverPublicKeyPath", "dispatchRoot", "dispatchConfigDigest"])?
    val root = gateway_text_v1(fields, "stateRoot")?
    val controller = gateway_text_v1(fields, "controllerId")?
    if not host_path_is_absolute(root) or root.bytes().len() > 4096 or root.contains("\0") or root.contains("\n") or root.contains("\r"):
        return Err("controller-gateway-root")
    if not builder_identifier_valid_v1(controller): return Err("controller-gateway-controller")
    val values = match fields["allowedActions"]:
        case SdnValue.Array(items): items
        case _: return Err("controller-gateway-actions")
    val supported = gateway_existing_actions_v1() + ["agent-pane"]
    if values.len() == 0 or values.len() > supported.len(): return Err("controller-gateway-actions")
    var actions: [text] = []
    for value in values:
        val action = match value:
            case SdnValue.String(item): item
            case _: return Err("controller-gateway-actions")
        if not supported.contains(action) or actions.contains(action):
            return Err("controller-gateway-actions")
        actions.push(action)
    val server_name = gateway_text_v1(fields, "serverName")?
    val identity_root = gateway_text_v1(fields, "identityStoreRoot")?
    val server_public_key_path = gateway_text_v1(fields, "serverPublicKeyPath")?
    if actions.contains("identity-register") or actions.contains("identity-server"):
        if not builder_identifier_valid_v1(server_name) or not host_path_is_absolute(identity_root) or
                not host_path_is_absolute(server_public_key_path): return Err("controller-gateway-identity-profile")
    val dispatch_root = gateway_text_v1(fields, "dispatchRoot")?
    val dispatch_digest = gateway_text_v1(fields, "dispatchConfigDigest")?
    val pane_target = actions.contains(HOST_AGENT_PANE_TARGET_SUB_V6)
    if actions.contains("agent-attachment") or actions.contains("agent-invoke") or actions.contains("agent-pane") or pane_target:
        if not host_path_is_absolute(dispatch_root) or dispatch_root.byte_len() > 4096 or
                dispatch_root.contains("\0") or dispatch_root.contains("\n") or dispatch_root.contains("\r") or
                not builder_digest_valid_v1(dispatch_digest):
            if actions.contains("agent-pane"): return Err("controller-gateway-agent-pane-profile")
            if pane_target: return Err("controller-gateway-agent-pane-target-profile")
            return Err(if actions.contains("agent-attachment"): "controller-gateway-attachment-profile"
                else: "controller-gateway-agent-invoke-profile")
    Ok(ControllerGatewayConfigV1(state_root: root, controller_id: controller, allowed_actions: actions,
        server_name: server_name, identity_store_root: identity_root, server_public_key_path: server_public_key_path,
        dispatch_root: dispatch_root, dispatch_config_digest: dispatch_digest))

pub fn controller_gateway_config_load_v1(path: text) -> Result<ControllerGatewayConfigV1, text>:
    if not host_path_is_absolute(path) or not file_is_regular_no_follow(path): return Err("controller-gateway-profile-path")
    val mode = file_mode_bits(path)
    if mode < 0 or (mode & 0o400) == 0 or (mode & 0o7077) != 0: return Err("controller-gateway-profile-private-required")
    val config = controller_gateway_config_decode_v1(file_read_regular_no_follow_bounded(path, 16384)?)?
    if file_mode_bits(config.state_root) != 0o700: return Err("controller-gateway-root-private-required")
    Ok(config)

pub fn controller_gateway_request_decode_v1(source: text) -> Result<ControllerGatewayRequestV1, text>:
    val fields = gateway_fields_v1(source, 2097152)?
    gateway_keys_v1(fields, ["version", "action", "controllerId", "requestUid", "source", "namespace", "name", "sourceDigest"])?
    val request = ControllerGatewayRequestV1(action: gateway_text_v1(fields, "action")?,
        controller_id: gateway_text_v1(fields, "controllerId")?, request_uid: gateway_text_v1(fields, "requestUid")?,
        source: gateway_text_v1(fields, "source")?, ns: gateway_text_v1(fields, "namespace")?,
        name: gateway_text_v1(fields, "name")?, source_digest: gateway_text_v1(fields, "sourceDigest")?)
    if not controller_gateway_actions_v1().contains(request.action): return Err("controller-gateway-action")
    if not builder_identifier_valid_v1(request.controller_id) or not builder_identifier_valid_v1(request.request_uid):
        return Err("controller-gateway-identity")
    if request.action == "submit":
        if request.source.bytes().len() == 0 or request.source.bytes().len() > 1048576 or
                not builder_identifier_valid_v1(request.ns) or not builder_identifier_valid_v1(request.name) or request.source_digest != "":
            return Err("controller-gateway-submit-fields")
    elif request.action == "identity-register" or request.action == "identity-server":
        if request.ns != "" or not builder_identifier_valid_v1(request.name) or request.source_digest != "":
            return Err("controller-gateway-identity-fields")
        if (request.action == "identity-register" and (request.source == "" or request.source.bytes().len() > 16384)) or
                (request.action == "identity-server" and request.source != ""):
            return Err("controller-gateway-identity-fields")
    elif request.action == "dispatch" or request.action == "resume-execution":
        if request.source == "" or request.ns != "" or request.name != "" or request.source_digest != "":
            return Err("controller-gateway-execution-fields")
    elif request.action == "agent-attachment":
        gateway_attachment_sub_v1(request)?
    elif request.action == "agent-invoke" or request.action == HOST_AGENT_PANE_TARGET_SUB_V6:
        val _frame = gateway_invocation_frame_v1(request)?
    elif HOST_AGENT_PANE_SUBS_V6.contains(request.action):
        val _pane = gateway_pane_request_v1(request)?
    else:
        if request.source != "" or request.ns != "" or request.name != "": return Err("controller-gateway-unused-fields")
        if request.action == "cancel":
            if not builder_digest_valid_v1(request.source_digest): return Err("controller-gateway-cancel-digest")
        elif request.source_digest != "": return Err("controller-gateway-unused-fields")
    Ok(request)

pub fn controller_gateway_request_encode_v1(request: ControllerGatewayRequestV1) -> Result<text, text>:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "action": SdnValue.String(request.action),
        "controllerId": SdnValue.String(request.controller_id), "requestUid": SdnValue.String(request.request_uid),
        "source": SdnValue.String(request.source), "namespace": SdnValue.String(request.ns),
        "name": SdnValue.String(request.name), "sourceDigest": SdnValue.String(request.source_digest)}
    val source = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    val checked = controller_gateway_request_decode_v1(source)?
    Ok(source)

pub fn controller_gateway_header_v1(source: text) -> Result<LocalGatewayHeaderV1, text>:
    val request = controller_gateway_request_decode_v1(source)?
    Ok(LocalGatewayHeaderV1(response: false, request_id: sha256_text(source), action: request.action,
        operation_id: request.request_uid, exit_code: 0, payload_bytes: source.bytes().len(), handoff_metadata: ""))

pub fn controller_gateway_authorize_v1(config: ControllerGatewayConfigV1,
        header: LocalGatewayHeaderV1, source: text) -> Result<ControllerGatewayRequestV1, text>:
    val request = controller_gateway_request_decode_v1(source)?
    if header.response or header.request_id != sha256_text(source) or header.action != request.action or
            header.operation_id != request.request_uid or header.payload_bytes != source.bytes().len() or
            header.exit_code != 0 or header.handoff_metadata != "": return Err("controller-gateway-frame-correlation")
    if request.controller_id != config.controller_id: return Err("controller-gateway-controller-mismatch")
    val grant = if HOST_AGENT_PANE_SUBS_V6.contains(request.action): "agent-pane" else: request.action
    if not config.allowed_actions.contains(grant): return Err("controller-gateway-action-denied")
    Ok(request)

pub fn controller_gateway_dispatch_v1(config: ControllerGatewayConfigV1,
        header: LocalGatewayHeaderV1, source: text) -> Result<OrchestratorValidationReplyV1, text>:
    val request = controller_gateway_authorize_v1(config, header, source)?
    if request.action == "identity-register" or request.action == "identity-server":
        if request.name != config.server_name: return Err("controller-gateway-server-name-mismatch")
        return Ok(host_identity_gateway_v1(request.action, config.controller_id, request.request_uid,
            config.server_name, config.identity_store_root, config.server_public_key_path, request.source))
    if (["agent-attachment", "agent-invoke", HOST_AGENT_PANE_TARGET_SUB_V6].contains(request.action) or
            HOST_AGENT_PANE_SUBS_V6.contains(request.action)):
        var reply = host_action_agent_gateway_v1(request.action, config.dispatch_root, config.dispatch_config_digest,
            config.controller_id, request.request_uid, request.source)
        if reply.exit_code == 0:
            val checked = gateway_agent_response_v1(request, reply.output)
            if checked.is_err():
                reply.exit_code = 2
                val effect = if request.action == "agent-attachment": "attachment" else: request.action
                reply.output = "controller-gateway-" + effect + "-report-unconfirmed\n"
            else:
                reply.output = checked.unwrap()
        return Ok(reply)
    var args = [request.action, config.state_root, config.controller_id, request.request_uid]
    if request.action == "submit":
        args = args + ["framed-source", request.ns, request.name]
    elif request.action == "cancel": args.push(request.source_digest)
    elif request.action == "dispatch" or request.action == "resume-execution": args.push("framed-packet")
    if ["dispatch", "resume-execution", "inspect-execution"].contains(request.action):
        return Ok(orchestrator_execution_input_command_v2(args, Some(request.source)))
    Ok(orchestrator_local_input_command_v1(args, Some(request.source)))

fn gateway_agent_response_v1(request: ControllerGatewayRequestV1, response: text) -> Result<text, text>:
    if request.action == "agent-attachment": return gateway_attachment_response_v1(request, response)
    if request.action == "agent-invoke": return gateway_invoke_response_v1(request, response)
    if request.action == HOST_AGENT_PANE_TARGET_SUB_V6: return gateway_pane_target_response_v1(request, response)
    gateway_pane_response_v1(request, response)

# Fixed paths satisfy the existing decode-only API's local request shape;
# these calls never execute a process or access those paths.
pub fn controller_gateway_response_v1(request_source: text, response: text) -> Result<text, text>:
    val request = controller_gateway_request_decode_v1(request_source)?
    if request.action == "agent-attachment": return gateway_attachment_response_v1(request, response)
    if request.action == "agent-invoke": return gateway_invoke_response_v1(request, response)
    if request.action == HOST_AGENT_PANE_TARGET_SUB_V6: return gateway_pane_target_response_v1(request, response)
    if HOST_AGENT_PANE_SUBS_V6.contains(request.action): return gateway_pane_response_v1(request, response)
    if request.action == "identity-register" or request.action == "identity-server":
        val checked = host_identity_exchange_response_v1(request.action, request.controller_id, request.request_uid, request.name, response)?
        val fields = gateway_fields_v1(response, 16384)?
        if request.action == "identity-register":
            val uploaded = host_identity_public_parse_v1(request.source)?
            if gateway_text_v1(fields, "clientPublicKey")? != uploaded.public_key:
                return Err("controller-identity-upload-mismatch")
        # The public-key validator returns one key, but the caller needs the
        # complete validated pending-grant receipt and durability fields.
        return Ok(sdn_encode_canonical(SdnValue.Dict(fields)))
    if ["dispatch", "resume-execution", "inspect-execution"].contains(request.action):
        val packet_path = if request.action == "inspect-execution": "" else: "/transport-packet"
        val shape = CaretExecutionRequestV2(executable: "/transport-decoder", action: request.action,
            state_root: "/transport-state", controller_id: request.controller_id,
            request_uid: request.request_uid, packet_path: packet_path)
        val checked = caret_execution_decode_v2(shape, response, "", 0)
        if not checked.confirmed: return Err(checked.code)
        return Ok(checked.output)
    if request.action == "cancel":
        val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1),
            "kind": SdnValue.String("orchestrator-local-controller"),
            "controllerId": SdnValue.String(request.controller_id), "requestUid": SdnValue.String(request.request_uid),
            "executionAuthorized": SdnValue.Bool(false), "status": SdnValue.String("intent-cancelled"),
            "sourceDigest": SdnValue.String(request.source_digest), "terminationObserved": SdnValue.Bool(false)}
        val actual = gateway_fields_v1(response, 65536)?
        if sdn_encode_canonical(SdnValue.Dict(actual)) != sdn_encode_canonical(SdnValue.Dict(fields)):
            return Err("controller-cancellation-reply-mismatch")
        return Ok(sdn_encode_canonical(SdnValue.Dict(actual)))
    val source_path = if request.action == "submit": "/transport-source" else: ""
    val shape = CaretOrchestratorRequestV1(executable: "/transport-decoder", action: request.action,
        state_root: "/transport-state", controller_id: request.controller_id, request_uid: request.request_uid,
        source_path: source_path, ns: request.ns, name: request.name)
    val checked = caret_orchestrator_decode_reply_v1(shape, response, "", 0)
    if not checked.confirmed: return Err(checked.code)
    if request.action == "submit":
        val fields = gateway_fields_v1(checked.output, 65536)?
        if gateway_text_v1(fields, "sourceDigest")? != sha256_text(request.source):
            return Err("controller-submit-source-digest-mismatch")
    Ok(checked.output)
