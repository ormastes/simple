# Standalone compiled application entrypoint; intentionally human/CLI output.
use std.sffi.cli_args.cli_get_args
use app.orchestrator.command.orchestrator_command_v1
use std.nogc_async_mut.sosix.host_facade.sosix_print_raw

fn main() -> i64:
    val raw = cli_get_args()
    var args: [text] = []
    var index = 1
    while index < raw.len():
        args.push(raw[index])
        index = index + 1
    val reply = orchestrator_command_v1(args)
    # Canonical execution codecs already include their one record terminator.
    # Preserve legacy metadata output while never adding a second newline.
    val output = if reply.output.ends_with("\n"): reply.output else: reply.output + "\n"
    sosix_print_raw(output)
    reply.exit_code
