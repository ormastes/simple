# Standalone compiled application entrypoint; intentionally human/CLI output.
use std.sffi.cli_args.cli_get_args
use app.orchestrator.command.orchestrator_command_v1

fn main() -> i64:
    val raw = cli_get_args()
    var args: [text] = []
    var index = 1
    while index < raw.len():
        args.push(raw[index])
        index = index + 1
    val reply = orchestrator_command_v1(args)
    print reply.output
    reply.exit_code
