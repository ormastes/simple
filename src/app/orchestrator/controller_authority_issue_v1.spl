# milestone_0030 D1/D2: controller-side issuance of ONE signed grant and a policy-driven (non-interactive)
# approval for the pre-authorized remote build/test class, issue-then-verify against the controller's installed
# snapshot. Issuer and approver seeds are OpenSSH Ed25519 private files in the protected identity store (dir 0700,
# file 0600, owner uid, no links: host_identity_store_linux_v1); each signature reads its file, signs through the
# domain-pinned sign-only entry point and wipes the bytes. No seed, key file, path or signer error detail is logged.
use std.common.contracts.distributed_control_v2.{ExecutionGrantV2, OperationEnvelopeV2, ExecutionEnvironmentV2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_grant_digest_v2, distributed_encode_operation_v2}
use std.nogc_sync_mut.daemon_sdk.distributed_grant_verification_v2.{DistributedAuthorityKeyV2,
    distributed_grant_signature_message_v2, distributed_approval_signature_message_v2}
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.{distributed_authority_snapshot_key_v2,
    distributed_verify_grant_approval_from_snapshot_v2}
use std.nogc_sync_mut.orchestration.controller_dispatch_config_v1.ControllerDispatchContextV1
use std.nogc_sync_mut.daemon_sdk.remote_build_task_class_v1.remote_build_task_class_v1
use std.nogc_sync_mut.io.host_identity_store_v1.{host_identity_store_open_v1, host_identity_store_read_v1,
    host_identity_store_close_v1}
use app.orchestrator.host_identity_key_v1.{host_identity_private_sign_grant_v1, host_identity_private_sign_approval_v1}
use std.common.crypto.sha256.sha256_text
use std.common.crypto.secure_memory.secure_zero_u8_slots

pub struct ControllerIssuedAuthorityV1:
    signed: DistributedSignedGrantV2
    approval: DistributedSignedApprovalV2

pub fn controller_authority_key_leaf_v1(key: DistributedAuthorityKeyV2) -> text:
    sha256_text("simple-controller-authority-key-v1\n" + key.role + "\n" + key.identity + "\n" + str(key.revision)) + ".key"

# Production key reader: one bounded read of the role key's leaf from the protected store, which is closed
# before the bytes are used. Store errors are fixed codes.
fn controller_authority_store_read_v1(store_root: text, key: DistributedAuthorityKeyV2) -> Result<[u8], text>:
    val opened = host_identity_store_open_v1(store_root)
    if opened.owner.is_none(): return Err("controller-key-store-unavailable")
    # Read only through a cleanly opened store; a refused open is closed and nothing is read.
    if not opened.ready or opened.cleanup_pending or opened.error != "":
        host_identity_store_close_v1(opened.owner.unwrap())
        return Err("controller-key-store-unavailable")
    val read = host_identity_store_read_v1(opened.owner.unwrap(), controller_authority_key_leaf_v1(key), 4096)
    val closed = host_identity_store_close_v1(read.owner)
    # Exactly one binding of the returned buffer exists after this point: `held` is wiped on a refusal and is the
    # value returned on success (the caller wipes it after signing). No second unwrap or copy is taken.
    if val held = read.bytes:
        if read.error != "" or read.absent or read.cleanup_pending or not closed.completed or closed.error != "":
            if held.len() > 0 and not secure_zero_u8_slots(held).verified(): return Err("controller-key-buffer-wipe")
            return Err("controller-key-unavailable")
        return Ok(held)
    Err("controller-key-unavailable")

pub fn controller_authority_store_reader_v1(store_root: text) -> fn(DistributedAuthorityKeyV2) -> Result<[u8], text>:
    \key: controller_authority_store_read_v1(store_root, key)

fn controller_authority_sign_v1(read_key: fn(DistributedAuthorityKeyV2) -> Result<[u8], text>,
        key: DistributedAuthorityKeyV2, message: [u8], grant_domain: bool) -> Result<[u8], text>:
    val file = read_key(key)?
    val signed = if grant_domain: host_identity_private_sign_grant_v1(file, key.public_key, message)
        else: host_identity_private_sign_approval_v1(file, key.public_key, message)
    val wipe = secure_zero_u8_slots(file)
    if not wipe.verified(): return Err("controller-key-buffer-wipe")
    signed

# Issue-then-verify. Nothing is returned unless the pair verifies from the same installed snapshot the host uses,
# at `now` (the controller grant clock, controller_dispatch_grant_clock_v1), under issuer == controller.
pub fn controller_authority_issue_v1(context: ControllerDispatchContextV1,
        read_key: fn(DistributedAuthorityKeyV2) -> Result<[u8], text>, issuer_id: text, approver_id: text,
        grant: ExecutionGrantV2, request: OperationEnvelopeV2, requested: ExecutionEnvironmentV2,
        approval_expires_at: i64, now: i64) -> Result<ControllerIssuedAuthorityV1, text>:
    if now <= 0: return Err("dispatch-wall-clock-unavailable")
    if issuer_id != context.config.controller_id: return Err("controller-issuer-not-controller")
    val snapshot = context.policy.snapshot
    val issuer = distributed_authority_snapshot_key_v2(snapshot, "grant-issuer", issuer_id)?
    val approver = distributed_authority_snapshot_key_v2(snapshot, "human-approver", approver_id)?
    # D1 class (shared with the Host remote-build route); refused before any key is read.
    if remote_build_task_class_v1(approver, grant, request, requested, approval_expires_at, now) != "":
        return Err("controller-approval-outside-task-class")
    controller_authority_sign_pair_v1(context, read_key, issuer, approver, grant, request, approval_expires_at, now)

# The shared issue-then-verify tail of every class: nothing is returned unless the pair verifies from the installed
# snapshot at `now`. The class predicate already ran; the issuer is the configured controller's grant-issuer key.
fn controller_authority_sign_pair_v1(context: ControllerDispatchContextV1,
        read_key: fn(DistributedAuthorityKeyV2) -> Result<[u8], text>, issuer: DistributedAuthorityKeyV2,
        approver: DistributedAuthorityKeyV2, grant: ExecutionGrantV2, request: OperationEnvelopeV2,
        approval_expires_at: i64, now: i64) -> Result<ControllerIssuedAuthorityV1, text>:
    val snapshot = context.policy.snapshot
    val issuer_id = issuer.identity
    val approver_id = approver.identity
    var signed = DistributedSignedGrantV2(grant: grant, issuer_id: issuer_id, key_revision: issuer.revision, signature: [])
    var approval = DistributedSignedApprovalV2(approver_id: approver_id, key_revision: approver.revision,
        grant_digest: distributed_grant_digest_v2(grant)?, request_digest: sha256_text(distributed_encode_operation_v2(request)?),
        policy_revision: snapshot.policy_revision, session_generation: context.policy.session_generation,
        expires_at: approval_expires_at, signature: [])
    # Refuse BEFORE any key is read: with empty signatures the verifier runs every non-signature check (key
    # revocation/expiry/scope for both roles, role separation, request-vs-grant) and can only end at SIGNATURE_INVALID.
    match distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed, approval, request, now,
        snapshot.generation, snapshot.policy_revision, snapshot.revocation_epoch, context.policy.session_generation):
        case Err(code):
            if code != "SIGNATURE_INVALID": return Err(code)
        case Ok(_): return Err("controller-unsigned-pair-accepted")
    # Both messages (and their metadata validation) before the first signature.
    val grant_message = distributed_grant_signature_message_v2(signed)?
    val approval_message = distributed_approval_signature_message_v2(approval)?
    signed.signature = controller_authority_sign_v1(read_key, issuer, grant_message, true)?
    approval.signature = controller_authority_sign_v1(read_key, approver, approval_message, false)?
    distributed_verify_grant_approval_from_snapshot_v2(snapshot, signed, approval, request, now,
        snapshot.generation, snapshot.policy_revision, snapshot.revocation_epoch, context.policy.session_generation)?
    Ok(ControllerIssuedAuthorityV1(signed: signed, approval: approval))

# milestone_0046 (owner decision 2026-11-19 "Both"): controller-signed Host service actions. The allow-list is exactly the
# operator abandons; a policy key must also be enrolled for the kind (installed policy, AUTHORITY_OPERATION_DENIED
# otherwise). Same issuer (controller grant-issuer) and approver (human-approver) keys and store as the remote-build
# class: no new key, no new custody. milestone_0045: `remote-run-abandon` is verified by the CONTROLLER's own journal
# edit (remote_run_abandon_v1.spl), never sent to a Host; a pair of one kind can never verify as another.
pub val CONTROLLER_HOST_ACTION_KINDS_V1: [text] = ["helper-abandon", "service-handoff-abandon", "remote-run-abandon"]
val CONTROLLER_HOST_ACTION_MAX_TTL_MS_V1: i64 = 86400000

pub struct ControllerHostActionAuthorityV1:
    operation: OperationEnvelopeV2
    authority: ControllerIssuedAuthorityV1

# An abandon runs no workload: the environment digest only binds the kind (grant and request carry the same value) and
# the budget is the minimum the verifier accepts (1 byte, 1 ms).
pub fn controller_host_action_environment_digest_v1(kind: text) -> text:
    sha256_text("simple-host-service-action-v1\n" + kind)

# The host-action class: one allow-listed kind on both grant and request, an unrevoked human-approver key whose scope and
# operations cover the grant, and an approval that is live and cannot outlive the grant. Returns "" when admitted.
pub fn controller_host_action_class_v1(approver: DistributedAuthorityKeyV2, grant: ExecutionGrantV2,
        request: OperationEnvelopeV2, approval_expires_at: i64, now: i64) -> text:
    if approver.role != "human-approver" or approver.revoked: return "controller-host-action-approver-key"
    if not CONTROLLER_HOST_ACTION_KINDS_V1.contains(request.operation): return "controller-host-action-kind"
    if grant.operations.len() != 1 or grant.operations[0] != request.operation: return "controller-host-action-grant-operations"
    if (grant.environment_digest != controller_host_action_environment_digest_v1(request.operation) or
            request.environment_digest != grant.environment_digest):
        return "controller-host-action-environment"
    if approver.principal != grant.principal or approver.project != grant.project or approver.host_id != grant.host_id:
        return "controller-host-action-approver-scope"
    if not approver.operations.contains(request.operation): return "controller-host-action-approver-operations"
    if grant.expires_at > approver.expires_at: return "controller-host-action-approver-budget"
    if approval_expires_at <= now or approval_expires_at > grant.expires_at: return "controller-host-action-approval-expiry"
    ""

# Builds the `kind` envelope for the record digest `payload_digest` on `host_id` (the installed binding's physical host),
# then issue-then-verify. Every refusal before the signatures happens before any key is read.
pub fn controller_host_action_issue_v1(context: ControllerDispatchContextV1,
        read_key: fn(DistributedAuthorityKeyV2) -> Result<[u8], text>, approver_id: text, kind: text, operation_id: text,
        payload_digest: text, host_id: text, grant_id: text, ttl_ms: i64, now: i64) -> Result<ControllerHostActionAuthorityV1, text>:
    if now <= 0: return Err("dispatch-wall-clock-unavailable")
    if not CONTROLLER_HOST_ACTION_KINDS_V1.contains(kind): return Err("controller-host-action-kind")
    if ttl_ms <= 0 or ttl_ms > CONTROLLER_HOST_ACTION_MAX_TTL_MS_V1: return Err("controller-host-action-ttl")
    val snapshot = context.policy.snapshot
    val issuer = distributed_authority_snapshot_key_v2(snapshot, "grant-issuer", context.config.controller_id)?
    val approver = distributed_authority_snapshot_key_v2(snapshot, "human-approver", approver_id)?
    val expires = now + ttl_ms
    val environment = controller_host_action_environment_digest_v1(kind)
    val grant = ExecutionGrantV2(id: grant_id, principal: approver.principal, project: approver.project, host_id: host_id,
        operations: [kind], environment_digest: environment, policy_revision: snapshot.policy_revision,
        revocation_epoch: snapshot.revocation_epoch, expires_at: expires, maximum_memory_bytes: 1, maximum_duration_ms: 1)
    val request = OperationEnvelopeV2(version: 2, id: operation_id, payload_digest: payload_digest, principal: approver.principal,
        project: approver.project, host_id: host_id, operation: kind, environment_digest: environment,
        policy_revision: snapshot.policy_revision, revocation_epoch: snapshot.revocation_epoch,
        session_generation: context.policy.session_generation, memory_bytes: 1, duration_ms: 1)
    val refused = controller_host_action_class_v1(approver, grant, request, expires, now)
    if refused != "": return Err(refused)
    val authority = controller_authority_sign_pair_v1(context, read_key, issuer, approver, grant, request, expires, now)?
    Ok(ControllerHostActionAuthorityV1(operation: request, authority: authority))

export ControllerIssuedAuthorityV1, controller_authority_key_leaf_v1, controller_authority_store_reader_v1
export controller_authority_issue_v1
export ControllerHostActionAuthorityV1, CONTROLLER_HOST_ACTION_KINDS_V1, controller_host_action_environment_digest_v1
export controller_host_action_class_v1, controller_host_action_issue_v1
