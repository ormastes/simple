# Compiler schema registry emitter — src/app/compiler_schema/registry.spl
#
# Hardening plan §11.2 / §11.9: the registry is GENERATED, never hand-edited.
# Output is fully deterministic — sources are listed in a fixed order, rows are
# sorted by stable id, and nothing carries a timestamp, host name, or path from
# the generating machine.

use std.io_runtime.{read_file_text, file_exists, file_write, dir_create_all}
use app.compiler_schema.extract.{
    VariantRow, variant_id, variant_owner, extract_enum_variants
}

val SINCE_EDITION = "2026"

struct EnumSource:
    """One authoritative enum declaration to extract."""
    path: text
    module_id: text
    enum_name: text

struct EnumResult:
    """Extraction outcome for one enum."""
    source: EnumSource
    rows: [VariantRow]

fn enum_sources() -> [EnumSource]:
    """The authoritative enum declarations tracked by §11.2.

    Deviations from the §11.2 wish-list, verified by grep on 2026-08-21:
      - `HirItemKind` does not exist; HIR items are `HirItem` structs. The
        nearest real closed HIR enum is `HirPatternKind`, tracked instead.
      - `FlatExprKind` / `FlatStmtKind` / `FlatDeclKind` do not exist; the flat
        AST is the `Node` enum in 10.frontend/ast.spl, tracked instead.
      - `MirInst` is spelled `MirInstKind`.
    These are recorded here rather than silently dropped.
    """
    [
        EnumSource("src/compiler/10.frontend/ast.spl", "compiler.frontend", "Node"),
        EnumSource("src/compiler/10.frontend/parser_types_expr.spl", "compiler.frontend", "ExprKind"),
        EnumSource("src/compiler/10.frontend/parser_types_expr.spl", "compiler.frontend", "PatternKind"),
        EnumSource("src/compiler/10.frontend/parser_types_expr.spl", "compiler.frontend", "StmtKind"),
        EnumSource("src/compiler/10.frontend/parser_types_expr.spl", "compiler.frontend", "TypeKind"),
        EnumSource("src/compiler/20.hir/hir_definitions.spl", "compiler.hir", "HirExprKind"),
        EnumSource("src/compiler/20.hir/hir_definitions.spl", "compiler.hir", "HirPatternKind"),
        EnumSource("src/compiler/20.hir/hir_definitions.spl", "compiler.hir", "HirStmtKind"),
        EnumSource("src/compiler/20.hir/hir_types.spl", "compiler.hir", "HirTypeKind"),
        EnumSource("src/compiler/50.mir/mir_instruction_kinds.spl", "compiler.mir", "MirInstKind"),
        EnumSource("src/compiler/50.mir/mir_instruction_support.spl", "compiler.mir", "MirTerminator"),
        EnumSource("src/compiler/50.mir/mir_types.spl", "compiler.mir", "MirTypeKind")
    ]

fn _sort_texts(items: [text]) -> [text]:
    var out = items
    var i = 1
    while i < out.len():
        val key = out[i]
        var j = i - 1
        while j >= 0 and out[j] > key:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    out

fn registry_file_name(source: EnumSource) -> text:
    source.module_id + "." + source.enum_name + ".sdn"

fn render_registry(source: EnumSource, rows: [VariantRow]) -> text:
    """SDN body for one enum. Rows sorted by id; no timestamps."""
    var by_id: {text: VariantRow} = {}
    var ids: [text] = []
    for row in rows:
        val id = variant_id(row)
        by_id[id] = row
        ids.push(id)
    val sorted = _sort_texts(ids)
    var out = "# GENERATED by src/app/compiler_schema — do not edit by hand.\n"
    out = out + "# Regenerate: bin/simple run src/app/compiler_schema/main.spl generate\n"
    out = out + "# Freshness gate: scripts/check/check-compiler-schema-fresh.shs\n"
    out = out + "owner: " + source.module_id + "." + source.enum_name + "\n"
    out = out + "declared_in: " + source.path + "\n"
    out = out + "variant_count: {sorted.len()}\n"
    for id in sorted:
        val row = by_id[id]
        if row != nil:
            out = out + "\nvariant:\n"
            out = out + "  id: " + id + "\n"
            out = out + "  owner: " + variant_owner(row) + "\n"
            out = out + "  domain: static\n"
            out = out + "  payload_schema: " + row.payload_schema + "\n"
            out = out + "  since_edition: " + SINCE_EDITION + "\n"
    out

fn render_index(results: [EnumResult]) -> text:
    """index.sdn — one row per enum, sorted by owner."""
    var lines: [text] = []
    var total = 0
    for r in results:
        val owner = r.source.module_id + "." + r.source.enum_name
        lines.push(owner + "|" + r.source.path + "|{r.rows.len()}")
        total = total + r.rows.len()
    val sorted = _sort_texts(lines)
    var out = "# GENERATED by src/app/compiler_schema — do not edit by hand.\n"
    out = out + "enum_count: {sorted.len()}\n"
    out = out + "variant_total: {total}\n"
    for line in sorted:
        val parts = line.split("|")
        out = out + "\nenum:\n"
        out = out + "  owner: " + parts[0] + "\n"
        out = out + "  declared_in: " + parts[1] + "\n"
        out = out + "  domain: static\n"
        out = out + "  variant_count: " + parts[2] + "\n"
        out = out + "  registry: " + parts[0] + ".sdn\n"
    out

fn extract_all(repo_root: text) -> [EnumResult]:
    """Extract every tracked enum. A missing source yields an empty row set —
    the caller decides whether that is an ERROR (the freshness gate does)."""
    var results: [EnumResult] = []
    for source in enum_sources():
        val path = repo_root + "/" + source.path
        var rows: [VariantRow] = []
        if file_exists(path):
            rows = extract_enum_variants(read_file_text(path), source.enum_name, source.module_id)
        results.push(EnumResult(source, rows))
    results

fn generate_into(repo_root: text, out_dir: text) -> i64:
    """Write the registry into `out_dir`. Returns the number of variants."""
    dir_create_all(out_dir)
    val results = extract_all(repo_root)
    var total = 0
    for r in results:
        file_write(out_dir + "/" + registry_file_name(r.source), render_registry(r.source, r.rows))
        total = total + r.rows.len()
    file_write(out_dir + "/index.sdn", render_index(results))
    total

export EnumSource, EnumResult, SINCE_EDITION
export enum_sources, registry_file_name, render_registry, render_index
export extract_all, generate_into
