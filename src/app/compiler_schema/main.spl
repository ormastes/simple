# Compiler schema CLI — src/app/compiler_schema/main.spl
#
# bin/simple run src/app/compiler_schema/main.spl generate [out_dir]
# bin/simple run src/app/compiler_schema/main.spl grammar [out_dir]
# bin/simple run src/app/compiler_schema/main.spl coverage
# bin/simple run src/app/compiler_schema/main.spl visitors [out_dir] [fold_out_root]
# bin/simple run src/app/compiler_schema/main.spl folds [out_root]
# bin/simple run src/app/compiler_schema/main.spl codec [out_dir]
#
# Hardening plan §11.2 / §11.8 / §11.9.

use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{cwd, env_get}
use app.compiler_schema.registry.{generate_into, extract_all}
use app.compiler_schema.coverage.{coverage_report}
use app.compiler_schema.visitor_gen.{generate_visitors_into, visitor_kind_count}
use app.compiler_schema.fold_gen.{generate_folds_into, fold_variant_report}
use app.compiler_schema.grammar_extract.{generate_grammar_into, grammar_report}
use app.compiler_schema.codec_gen.{generate_codec_into}

fn _repo_root() -> text:
    val root = env_get("SIMPLE_REPO_ROOT")
    if root == "":
        return cwd()
    root

fn run_compiler_schema(args: [text]) -> i64:
    val root = _repo_root()
    if args.len() == 0:
        print "Usage: bin/simple run src/app/compiler_schema/main.spl <generate|grammar|visitors|folds|codec|coverage> [out_dir]"
        return 1
    val cmd = args[0]
    if cmd == "generate":
        val out_dir = if args.len() > 1: args[1] else: root + "/spec/compiler_schema/registry"
        val total = generate_into(root, out_dir)
        val enums = extract_all(root).len()
        print "generated {total} variant(s) across {enums} enum(s) into {out_dir}"
        # The grammar axis (§11.3, lane C1) is part of the same registry, so a
        # single `generate` keeps enums and grammar in lockstep and the
        # freshness gate covers both.
        val gmodel = generate_grammar_into(root, out_dir)
        print grammar_report(gmodel)
        return 0
    if cmd == "grammar":
        val gdir = if args.len() > 1: args[1] else: root + "/spec/compiler_schema/registry"
        val model = generate_grammar_into(root, gdir)
        print grammar_report(model)
        return 0
    if cmd == "visitors":
        val vdir = if args.len() > 1: args[1] else: root + "/src/compiler/20.hir/generated"
        val emitted = generate_visitors_into(root, vdir)
        print "generated {emitted} visitor function(s) across {visitor_kind_count(root)} kind(s) into {vdir}"
        val out_root = if args.len() > 2: args[2] else: root
        val folds = generate_folds_into(root, out_root)
        print "generated {folds} fold visitor file(s) into {out_root}"
        print fold_variant_report(root)
        return 0
    if cmd == "folds":
        val out_root = if args.len() > 1: args[1] else: root
        val folds = generate_folds_into(root, out_root)
        print "generated {folds} fold visitor file(s) into {out_root}"
        print fold_variant_report(root)
        return 0
    if cmd == "codec":
        val cdir = if args.len() > 1: args[1] else: root + "/src/compiler/20.hir/generated"
        val covered = generate_codec_into(root, cdir)
        print "generated HirModule codec over {covered} declaration(s) into {cdir}"
        return 0
    if cmd == "coverage":
        print coverage_report(root)
        return 0
    print "Unknown compiler_schema subcommand: {cmd}"
    1

fn main() -> i64:
    var args = get_cli_args()
    if args.len() > 0 and args[0] == "compiler":
        args = args[1:]
    run_compiler_schema(args)

export run_compiler_schema
