# LSP fast-query child entry (app-rooted).
# The query helpers live in std.nogc_sync_mut.lsp.lsp_query but import app.cli.*,
# which only resolves when the entry file sits under src/app. The LSP server and
# the LSP MCP launch this file: `simple src/app/lsp/lsp_query.spl <subcmd> <file> [line] [col]`.
use std.nogc_sync_mut.lsp.lsp_query.{lsp_query_main}

lsp_query_main()
