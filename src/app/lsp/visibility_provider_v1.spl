# App composition adapter: reuse the visibility query's existing classifier
# and inject the protocol-owned current-source reader for this request.
use app.cli._QueryVisibility.query_commands.{query_visibility_symbols_payload_v1}
use std.nogc_sync_mut.lsp.lsp_visibility_provider_v1.{
    LspVisibilitySourceReaderV1, LspVisibilityQueryProviderV1,
    LspVisibilityQueryRequestV1, LspVisibilityQueryResultV1
}
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_set_visibility_query_provider_v1}

fn _lsp_visibility_query_v1(request: LspVisibilityQueryRequestV1,
        reader: LspVisibilitySourceReaderV1) -> LspVisibilityQueryResultV1:
    query_visibility_symbols_payload_v1(request.snapshot.path,
        request.requester_path, request.visibility, request.feature, request.layer,
        reader, request.snapshot.overlay_generation)

pub fn lsp_install_visibility_provider_v1():
    lsp_set_visibility_query_provider_v1(
        LspVisibilityQueryProviderV1(_lsp_visibility_query_v1))

export lsp_install_visibility_provider_v1
