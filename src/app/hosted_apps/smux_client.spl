use os.apps.smux.smux_remote.{smux_remote_main, smux_remote_reply_ok}
use os.apps.smux.server.{smux_server_serve, smux_server_request}
use std.cli.cli_util.{get_cli_args}
use os.apps.smux.interactive_client.{smux_interactive_attach}

fn main() -> i64:
    val args = get_cli_args()
    if args.len() > 0:
        if args[0] == "--help":
            print("smux --serve 127.0.0.1:PORT TOKEN\nsmux --request 127.0.0.1:PORT TOKEN VERB [args]\nsmux --attach 127.0.0.1:PORT TOKEN SESSION CLIENT_ID\nCtrl-B d detaches. Without arguments: legacy stdin owner; EOF stops its children.")
            return 0
        if args[0] == "--attach" and args.len() == 5:
            return smux_interactive_attach(args[1], args[2], args[3], args[4])
        if args[0] == "--serve" and args.len() == 3:
            return smux_server_serve(args[1], args[2])
        if args[0] == "--request" and args.len() >= 4:
            val reply = smux_server_request(args[1], args[2], args[3:].join(" "))
            if reply.is_err():
                print("smux: " + reply.unwrap_err())
                return 1
            val body = reply.unwrap()
            print(body)
            if not smux_remote_reply_ok(body):
                return 1
            return 0
        print("smux: invalid arguments; use --help")
        return 1
    smux_remote_main()
    0
