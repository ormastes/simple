# codex-impl
# Typed SJ operation vocabulary. String translation is compatibility only.

val SJ_OP_OBSERVE = "observe"
val SJ_OP_SNAPSHOT = "snapshot"
val SJ_OP_CREATE_CHANGE = "create_change"
val SJ_OP_REWRITE_STACK = "rewrite_stack"
val SJ_OP_FETCH = "fetch"
val SJ_OP_REBASE = "rebase"
val SJ_OP_PUBLISH_REVIEW_REF = "publish_review_ref"
val SJ_OP_INTEGRATE = "integrate"
val SJ_OP_BACKPORT = "backport"
val SJ_OP_CREATE_RELEASE_TAG = "create_release_tag"
val SJ_OP_PUBLISH_RELEASE_REFS = "publish_release_refs"
val SJ_OP_RECOVER = "recover"
val SJ_OP_BREAK_GLASS = "raw_break_glass"

struct VcsOperation:
    kind: text
    entity_id: text
    target_ref: text
    dry_run: bool
    reason: text

fn vcs_operation(kind: text, entity_id: text, target_ref: text, dry_run: bool) -> VcsOperation:
    VcsOperation(kind: kind, entity_id: entity_id, target_ref: target_ref, dry_run: dry_run, reason: "")

fn vcs_operation_valid(operation: VcsOperation) -> bool:
    val known = operation.kind == SJ_OP_OBSERVE or operation.kind == SJ_OP_SNAPSHOT or
        operation.kind == SJ_OP_CREATE_CHANGE or operation.kind == SJ_OP_REWRITE_STACK or
        operation.kind == SJ_OP_FETCH or operation.kind == SJ_OP_REBASE or
        operation.kind == SJ_OP_PUBLISH_REVIEW_REF or operation.kind == SJ_OP_INTEGRATE or
        operation.kind == SJ_OP_BACKPORT or operation.kind == SJ_OP_CREATE_RELEASE_TAG or
        operation.kind == SJ_OP_PUBLISH_RELEASE_REFS or operation.kind == SJ_OP_RECOVER or
        operation.kind == SJ_OP_BREAK_GLASS
    known and (operation.kind == SJ_OP_OBSERVE or operation.entity_id != "")

fn legacy_argv_operation(argv: [text]) -> VcsOperation:
    if argv.len() == 0:
        return vcs_operation(SJ_OP_OBSERVE, "", "", true)
    if argv[0] == "integrate" and argv.len() > 1:
        val target = if argv.len() > 2: argv[2] else: "integration/main"
        return vcs_operation(SJ_OP_INTEGRATE, argv[1], target, true)
    if argv[0] == "git" and argv.len() > 1 and argv[1] == "push":
        return VcsOperation(kind: SJ_OP_INTEGRATE, entity_id: "legacy-unbound", target_ref: "main", dry_run: true, reason: "legacy push requires exact lifecycle identity before execution")
    if argv[0] == "git" and argv.len() > 1 and argv[1] == "fetch":
        return vcs_operation(SJ_OP_FETCH, "legacy-fetch", "", true)
    VcsOperation(kind: SJ_OP_OBSERVE, entity_id: "", target_ref: "", dry_run: true, reason: "legacy command has no protected typed mutation mapping")

export SJ_OP_OBSERVE, SJ_OP_SNAPSHOT, SJ_OP_CREATE_CHANGE, SJ_OP_REWRITE_STACK
export SJ_OP_FETCH, SJ_OP_REBASE, SJ_OP_PUBLISH_REVIEW_REF, SJ_OP_INTEGRATE
export SJ_OP_BACKPORT, SJ_OP_CREATE_RELEASE_TAG, SJ_OP_PUBLISH_RELEASE_REFS
export SJ_OP_RECOVER, SJ_OP_BREAK_GLASS, VcsOperation, vcs_operation, vcs_operation_valid
export legacy_argv_operation
