# codex-impl
# Typed protected-gate invocation planning against pinned BASE and HEAD.

struct GateManifestEntry:
    gate_id: text
    tier: text
    push_blocking: bool
    mode: text
    command: text
    description: text

struct GateInvocation:
    gate_id: text
    command: text
    args: [text]
    base_revision: text
    head_revision: text

struct GateManifestPlan:
    valid: bool
    error: text
    invocations: [GateInvocation]

fn _gate_unquote(value: text) -> text:
    val trimmed = value.trim()
    if trimmed.len() >= 2 and trimmed.starts_with("\"") and trimmed.ends_with("\""):
        return trimmed[1:trimmed.len() - 1]
    trimmed

fn _gate_csv_fields(line: text) -> [text]:
    var fields: [text] = []
    var current = ""
    var quoted = false
    var i = 0
    while i < line.len():
        val code = line.char_code_at(i)
        if code == 34:
            if quoted and i + 1 < line.len() and line.char_code_at(i + 1) == 34:
                current = current + "\""
                i = i + 1
            else:
                quoted = not quoted
        elif code == 44 and not quoted:
            fields.push(current.trim())
            current = ""
        else:
            current = current + line[i:i + 1]
        i = i + 1
    if quoted:
        return []
    fields.push(current.trim())
    fields

fn parse_gate_manifest(payload: text) -> [GateManifestEntry]:
    var entries: [GateManifestEntry] = []
    for raw in payload.split("\n"):
        val line = raw.trim()
        if line == "" or line.starts_with("#") or line.starts_with("must_check_gates"):
            continue
        val fields = _gate_csv_fields(line)
        # 6 columns is the historical shape; 8 adds `ci_job, inputs` between
        # `command` and `description` (see config/check/must_check_gates.sdn).
        # Both are accepted, nothing between them is: a row of any other width
        # stays MALFORMED rather than being reinterpreted with shifted fields.
        if fields.len() != 6 and fields.len() != 8:
            entries.push(GateManifestEntry(gate_id: "", tier: "push", push_blocking: true, mode: "", command: "", description: "malformed mandatory gate row"))
            continue
        val tier = fields[1].trim()
        val blocking_token = fields[2].trim()
        # `ci` rows are read so the registry stays parseable, and are then
        # ignored by plan_protected_gate_manifest, which selects `push` only.
        if (tier != "push" and tier != "bootstrap" and tier != "ci") or (blocking_token != "true" and blocking_token != "false"):
            entries.push(GateManifestEntry(gate_id: "", tier: "push", push_blocking: true, mode: "", command: "", description: "invalid mandatory gate tier or blocking token"))
            continue
        entries.push(GateManifestEntry(
            gate_id: fields[0].trim(), tier: tier,
            push_blocking: blocking_token == "true", mode: fields[3].trim(),
            command: _gate_unquote(fields[4]), description: _gate_unquote(fields[fields.len() - 1])
        ))
    entries

fn plan_protected_gate_manifest(entries: [GateManifestEntry], base_revision: text, head_revision: text) -> GateManifestPlan:
    if base_revision == "" or head_revision == "" or base_revision == head_revision:
        return GateManifestPlan(valid: false, error: "distinct pinned BASE and HEAD revisions are required", invocations: [])
    var invocations: [GateInvocation] = []
    var seen_gate_ids: [text] = []
    for entry in entries:
        if entry.tier != "push" or not entry.push_blocking:
            continue
        if entry.gate_id == "" or entry.command == "":
            return GateManifestPlan(valid: false, error: "push-blocking gate has no identity or command", invocations: [])
        if seen_gate_ids.contains(entry.gate_id):
            return GateManifestPlan(valid: false, error: "duplicate push-blocking gate identity: " + entry.gate_id, invocations: [])
        seen_gate_ids.push(entry.gate_id)
        val args = if entry.mode == "range":
            [base_revision + ".." + head_revision]
        else if entry.mode == "ref" or entry.mode == "tree":
            [head_revision]
        else:
            return GateManifestPlan(valid: false, error: "unsupported protected gate mode: " + entry.mode, invocations: [])
        invocations.push(GateInvocation(gate_id: entry.gate_id, command: entry.command, args: args, base_revision: base_revision, head_revision: head_revision))
    if invocations.len() == 0:
        return GateManifestPlan(valid: false, error: "protected gate manifest selected zero push-blocking gates", invocations: [])
    GateManifestPlan(valid: true, error: "", invocations: invocations)

export GateManifestEntry, GateInvocation, GateManifestPlan, parse_gate_manifest, plan_protected_gate_manifest
