# spec-to-sspec: modernize an existing SSpec toward the SSDOC manual-first bar.
#
# The honest scope: a non-fabricating converter. It assembles structure that is
# derivable from the source itself and never invents narrative prose (SSDOC-NAR-002
# explicitly penalizes generated filler). It lifts only deductions a machine can
# lift without lying:
#   * SSDOC-MNT-003/006 — mechanical syntax/import fixes (delegated to improve).
#   * SSDOC-BEH-001     — inject an imperative step("...") into step-less
#                         executable scenarios, label derived verbatim from the
#                         scenario's own `it` name. Every original assertion is
#                         preserved untouched, so fault detection is unchanged.
# Deductions that require human authoring (NAR-001 purpose/audience, ORA-001 real
# oracles, ORA-003 explained literals, EVD-001 captured evidence, COV-001 adverse
# paths, TRC-001 requirement identity, lifecycle links) are reported, not faked.
# This is why automation lifts a score partway, never to ~100 on its own.

use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read, file_atomic_write, file_exists}
use app.io.cli_ops.{_cli_eprint}
use app.sspec_maintain.improve.{safe_sspec_easyfixes, apply_sspec_easyfixes_result}

fn _usage():
    print "spec-to-sspec: modernize an existing SSpec (non-fabricating)"
    print "Usage: simple spec-to-sspec modernize <spec.spl> [--apply] [-o <out>]"
    print "  modernize  Apply mechanical SSDOC fixes + inject step() flow; preview to stdout."
    print "             --apply writes back in place; -o <out> writes to a path."
    print "Assertions are preserved exactly; only structure is assembled."

fn _option(args: [text], name: text, fallback: text) -> text:
    var i = 0
    while i + 1 < args.len():
        if args[i] == name:
            return args[i + 1]
        i = i + 1
    fallback

fn _has(args: [text], name: text) -> bool:
    args.contains(name)

fn _leading_ws(line: text) -> text:
    val trimmed = line.trim()
    line[:line.len() - trimmed.len()]

fn _is_it_header(trimmed: text) -> bool:
    # `it "outcome name":` — not xit/fit, must open a quoted name and close with ':'.
    trimmed.starts_with("it \"") and trimmed.ends_with(":")

fn _is_assertion(trimmed: text) -> bool:
    trimmed.starts_with("expect(") or trimmed.starts_with("assert_") or
        trimmed.starts_with("assert(")

fn _step_label(trimmed: text) -> text:
    # Verbatim scenario name between the first and last quote; never invented.
    var body = trimmed
    if body.starts_with("it \""):
        body = body[4:]
    var label = body
    if label.ends_with(":"):
        label = label[:label.len() - 1]
    if label.starts_with("\""):
        label = label[1:]
    if label.ends_with("\""):
        label = label[:label.len() - 1]
    label = label.trim()
    # Escape any embedded quote so the generated string literal stays valid.
    label.replace("\"", "'")

# Look ahead from an `it` header (index i): find the body indent, and decide
# whether the block both (a) contains a real assertion and (b) lacks a step().
# Returns the body indent to use, or "" when no injection is warranted.
fn _scan_scenario(lines: [text], from: i64) -> text:
    val header_indent = _leading_ws(lines[from])
    var k = from + 1
    var body_indent = ""
    var has_assert = false
    var has_step = false
    while k < lines.len():
        val line = lines[k]
        if line.trim() == "":
            k = k + 1
            continue
        val ind = _leading_ws(line)
        if ind.len() <= header_indent.len():
            break
        if body_indent == "":
            body_indent = ind
        val trimmed = line.trim()
        if trimmed.starts_with("step("):
            has_step = true
        if _is_assertion(trimmed):
            has_assert = true
        k = k + 1
    if has_step or not has_assert:
        return ""
    body_indent

fn inject_step_flow(source: text) -> text:
    """Insert step("<scenario name>") as the first statement of executable,
    step-less scenarios. O(lines); assertions are never modified or removed."""
    val lines = source.split("\n")
    var out: [text] = []
    var i = 0
    while i < lines.len():
        val line = lines[i]
        out.push(line)
        val trimmed = line.trim()
        if _is_it_header(trimmed):
            val body_indent = _scan_scenario(lines, i)
            if body_indent != "":
                out.push(body_indent + "step(\"" + _step_label(trimmed) + "\")")
        i = i + 1
    out.join("\n")

fn modernize_source(path: text, source: text) -> text:
    # 1. mechanical SSDOC fixes (MNT-003/006), then 2. step-flow injection (BEH-001).
    val fixes = safe_sspec_easyfixes(path, source)
    val mechanical = match apply_sspec_easyfixes_result(path, source, fixes):
        case Err(_): source
        case Ok(value): value
    inject_step_flow(mechanical)

fn _modernize(args: [text]) -> i64:
    var positional: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "--apply" or args[i] == "-o":
            i = i + 1
        else:
            positional.push(args[i])
        i = i + 1
    if positional.len() < 1:
        _cli_eprint("spec-to-sspec: missing spec path")
        return 2
    val path = positional[0]
    if not file_exists(path):
        _cli_eprint("spec-to-sspec: file does not exist: {path}")
        return 2
    val source = match file_read(path):
        case Some(value): value
        case None:
            _cli_eprint("spec-to-sspec: cannot read: {path}")
            return 2
    val modernized = modernize_source(path, source)
    if _has(args, "--apply"):
        file_atomic_write(path, modernized)
        print "spec-to-sspec: modernized {path}"
    else:
        val out_path = _option(args, "-o", "")
        if out_path != "":
            file_atomic_write(out_path, modernized)
            print "spec-to-sspec: wrote {out_path}"
        else:
            print modernized
    0

fn main():
    val args = get_cli_args()
    if args.len() < 1 or args[0] == "--help" or args[0] == "-h":
        _usage()
        return
    val sub = args[0]
    val rest = args[1:]
    if sub == "modernize":
        return _modernize(rest)
    _usage()

main()
