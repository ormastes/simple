# spec-to-sspec: modernize an existing SSpec toward the SSDOC manual-first bar.
#
# The honest scope: a non-fabricating converter. It assembles structure that is
# derivable from the source itself and never invents narrative prose (SSDOC-NAR-002
# explicitly penalizes generated filler). It lifts only deductions a machine can
# lift without lying:
#   * SSDOC-MNT-003/006 — mechanical syntax/import fixes (delegated to improve).
#   * SSDOC-BEH-001     — inject an imperative step("...") into step-less
#                         executable scenarios, label derived verbatim from the
#                         scenario's own `it` name. Every original assertion is
#                         preserved untouched, so fault detection is unchanged.
# Deductions that require human authoring (NAR-001 purpose/audience, ORA-001 real
# oracles, ORA-003 explained literals, EVD-001 captured evidence, COV-001 adverse
# paths, TRC-001 requirement identity, lifecycle links) are reported, not faked.
# This is why automation lifts a score partway, never to ~100 on its own.

use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read, file_atomic_write, file_exists}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use std.crypto.sha256.{sha256_text}
use app.io.cli_ops.{_cli_eprint}
use app.sspec_maintain.improve.{safe_sspec_easyfixes, apply_sspec_easyfixes_result}
use app.sspec_maintain.analyzer.{derive_manual_path}
use app.sspec_maintain.documentize.{compose_sspec_documentized_manual}
use app.spipe_docgen.spipe_docgen.main.{run_spipe_docgen}
use app.spec_to_sspec.spipe_evidence_emit.{spipe_evidence_sidecar_path, spipe_evidence_sidecar_content}

fn _usage():
    print "spec-to-sspec: modernize an existing SSpec (non-fabricating)"
    print "Usage: simple spec-to-sspec modernize <spec.spl> [--apply] [-o <out>] [--with-manual]"
    print "  modernize  Apply mechanical SSDOC fixes + inject step() flow; preview to stdout."
    print "             --apply writes back in place; -o <out> writes to a path."
    print "             --with-manual also regenerates the doc/06_spec mirror (clears MNT-002);"
    print "                        needs --apply or -o (docgen reads the written file)."
    print "Assertions are preserved exactly; only structure is assembled."

fn _option(args: [text], name: text, fallback: text) -> text:
    var i = 0
    while i + 1 < args.len():
        if args[i] == name:
            return args[i + 1]
        i = i + 1
    fallback

fn _spec_to_sspec_has_arg(args: [text], name: text) -> bool:
    args.contains(name)

fn _leading_ws(line: text) -> text:
    val trimmed = line.trim()
    line[:line.len() - trimmed.len()]

fn _is_it_header(trimmed: text) -> bool:
    # `it "outcome name":` — not xit/fit, must open a quoted name and close with ':'.
    trimmed.starts_with("it \"") and trimmed.ends_with(":")

fn _is_assertion(trimmed: text) -> bool:
    trimmed.starts_with("expect(") or trimmed.starts_with("assert_") or
        trimmed.starts_with("assert(")

fn _step_label(trimmed: text) -> text:
    # Verbatim scenario name between the first and last quote; never invented.
    var body = trimmed
    if body.starts_with("it \""):
        body = body[4:]
    var label = body
    if label.ends_with(":"):
        label = label[:label.len() - 1]
    if label.starts_with("\""):
        label = label[1:]
    if label.ends_with("\""):
        label = label[:label.len() - 1]
    label = label.trim()
    # Escape any embedded quote so the generated string literal stays valid.
    label.replace("\"", "'")

fn _has_evidence(trimmed: text) -> bool:
    # Mirrors the SSDOC EVD-001 detector (source_facts.spl): a scenario is
    # evidence-bearing when it retains a capture_*/@capture/evidence() call.
    trimmed.contains("capture_") or trimmed.contains("@capture") or
        trimmed.contains("evidence(")

# Look ahead from an `it` header (index i): inject a step ONLY when the scenario
# already has a real assertion AND retained evidence. Steps are the manual-flow
# idiom for observable scenarios; injecting them into assertion-only pure-function
# specs would just trade SSDOC-BEH-001 for SSDOC-EVD-001 (the assertion IS the
# evidence there), so we leave those alone rather than regress the score.
fn _scan_scenario(lines: [text], from: i64) -> text:
    val header_indent = _leading_ws(lines[from])
    var k = from + 1
    var body_indent = ""
    var has_assert = false
    var has_step = false
    var has_evidence = false
    while k < lines.len():
        val line = lines[k]
        if line.trim() == "":
            k = k + 1
            continue
        val ind = _leading_ws(line)
        if ind.len() <= header_indent.len():
            break
        if body_indent == "":
            body_indent = ind
        val trimmed = line.trim()
        if trimmed.starts_with("step("):
            has_step = true
        if _is_assertion(trimmed):
            has_assert = true
        if _has_evidence(trimmed):
            has_evidence = true
        k = k + 1
    if has_step or not has_assert or not has_evidence:
        return ""
    body_indent

fn inject_step_flow(source: text) -> text:
    """Insert step("<scenario name>") as the first statement of executable,
    step-less scenarios. O(lines); assertions are never modified or removed."""
    val lines = source.split("\n")
    var out: [text] = []
    var i = 0
    while i < lines.len():
        val line = lines[i]
        out.push(line)
        val trimmed = line.trim()
        if _is_it_header(trimmed):
            val body_indent = _scan_scenario(lines, i)
            if body_indent != "":
                out.push(body_indent + "step(\"" + _step_label(trimmed) + "\")")
        i = i + 1
    out.join("\n")

fn _ensure_spec_import(source: text) -> text:
    # step() lives in std.spec (not a prelude global like describe/it/expect),
    # so a modernized spec needs `use std.spec.*` to resolve under `run`.
    if source.contains("use std.spec"):
        return source
    val lines = source.split("\n")
    var out: [text] = []
    var inserted = false
    for line in lines:
        if not inserted and line.trim().starts_with("use "):
            out.push("use std.spec.*")
            inserted = true
        out.push(line)
    if not inserted:
        var with_import: [text] = ["use std.spec.*"]
        for line in out:
            with_import.push(line)
        return with_import.join("\n")
    out.join("\n")

fn modernize_source(path: text, source: text) -> text:
    # 1. mechanical SSDOC fixes (MNT-003/006), then 2. step-flow injection (BEH-001).
    val fixes = safe_sspec_easyfixes(path, source)
    val mechanical = match apply_sspec_easyfixes_result(path, source, fixes):
        case Err(_): source
        case Ok(value): value
    val stepped = inject_step_flow(mechanical)
    if stepped != mechanical:
        # step() calls were added; make sure they resolve.
        _ensure_spec_import(stepped)
    else:
        stepped

# Regenerate the doc/06_spec mirror for `source` (already on disk at `written_path`)
# by mirroring sspec-maintain documentize staging: SPipe docgen into a hashed
# staging dir, wrap with provenance + scorecard, write the canonical mirror.
# Clears SSDOC-MNT-002 (mirrored manual is stale) — the one mechanical lift that
# also produces the spec-like doc. Heavy (runs spipe_docgen); opt-in via flag.
fn _regenerate_manual(written_path: text, source: text) -> i64:
    val output = derive_manual_path(written_path)
    val staging_root = "build/spec-to-sspec/documentize/" + sha256_text(written_path + "\n" + source)
    dir_remove(staging_root, true)
    val generated = run_spipe_docgen([written_path, "--output", staging_root, "--no-index"])
    if generated != 0:
        dir_remove(staging_root, true)
        _cli_eprint("spec-to-sspec: SPipe manual generation failed")
        return 3
    val prefix = "doc/06_spec/"
    val canonical = derive_manual_path(written_path)
    val rel = if canonical.starts_with(prefix): canonical[prefix.len():] else: canonical
    val staged_path = staging_root + "/" + rel
    val spipe_manual = file_read(staged_path) ?? ""
    if spipe_manual == "":
        dir_remove(staging_root, true)
        _cli_eprint("spec-to-sspec: canonical SPipe manual not produced at {staged_path}")
        return 3
    dir_remove(staging_root, true)
    val result = compose_sspec_documentized_manual(written_path, source, spipe_manual, true)
    if file_atomic_write(output, result.content):
        print "spec-to-sspec: regenerated manual {output}"
        0
    else:
        _cli_eprint("spec-to-sspec: cannot write manual {output}")
        3

fn _modernize(args: [text]) -> i64:
    var positional: [text] = []
    var i = 0
    while i < args.len():
        if args[i] == "-o":
            i = i + 1   # -o <value>: skip flag and its value
        elif args[i] == "--apply" or args[i] == "--with-manual":
            # bare flags: skip just the token
            pass
        else:
            positional.push(args[i])
        i = i + 1
    if positional.len() < 1:
        _cli_eprint("spec-to-sspec: missing spec path")
        return 2
    val path = positional[0]
    if not file_exists(path):
        _cli_eprint("spec-to-sspec: file does not exist: {path}")
        return 2
    val source = match file_read(path):
        case Some(value): value
        case None:
            _cli_eprint("spec-to-sspec: cannot read: {path}")
            return 2
    val modernized = modernize_source(path, source)
    val want_manual = _spec_to_sspec_has_arg(args, "--with-manual")
    if _spec_to_sspec_has_arg(args, "--apply"):
        file_atomic_write(path, modernized)
        print "spec-to-sspec: modernized {path}"
        file_atomic_write(spipe_evidence_sidecar_path(path), spipe_evidence_sidecar_content(path, modernized))
        if want_manual:
            return _regenerate_manual(path, modernized)
    else:
        val out_path = _option(args, "-o", "")
        if out_path != "":
            file_atomic_write(out_path, modernized)
            print "spec-to-sspec: wrote {out_path}"
            file_atomic_write(spipe_evidence_sidecar_path(out_path), spipe_evidence_sidecar_content(out_path, modernized))
            if want_manual:
                return _regenerate_manual(out_path, modernized)
        else:
            if want_manual:
                _cli_eprint("spec-to-sspec: --with-manual needs --apply or -o (docgen reads the file)")
                return 2
            print modernized
    0

fn main():
    val args = get_cli_args()
    if args.len() < 1 or args[0] == "--help" or args[0] == "-h":
        _usage()
        return
    val sub = args[0]
    if sub == "modernize":
        return _modernize(args[1:])
    # Bare `spec-to-sspec <spec>` defaults to modernize for convenience.
    _modernize(args)

main()
