# Parent-side preparation transport; not yet connected to test dispatch.
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# The v1 request is unverified intent, not proof of source/selector closure.
# This legacy source-entry invocation does not admit a deployed artifact.
use std.common.traceability.run_plan.{TraceRunPlan}
use std.common.traceability.run_request.{TraceRunRequest, materialize_trace_run_plan}
use std.common.traceability.run_request_codec.{encode_trace_run_request}
use std.common.traceability.run_selection.{validate_trace_request_selection}
use std.common.traceability.run_preparation.{decode_trace_run_preparation,
    encode_trace_run_preparation, validate_trace_run_preparation}
use std.common.traceability.sspec_inventory.{TraceSspecPlannedRequest}
use std.common.traceability.sspec_inventory_codec.{encode_trace_sspec_planned_request}
use std.common.traceability.sspec_preparation.{verify_trace_sspec_preparation}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_create_exclusive, file_atomic_write, file_remove}
use std.nogc_sync_mut.io.process_ops.{OwnedProcessLease}

val TRACE_PREPARATION_OUTPUT_MAX: i64 = 1048576
val TRACE_PREPARATION_TIMEOUT_MS: i64 = 60000

# Accept one complete canonical document with at most one print newline.
# Never recover a document from logs, comments, or a second document.
pub fn verify_trace_preparation_output(request: TraceRunRequest, stdout: text, exit_code: i64) -> Result<TraceRunPlan, text>:
    if exit_code != 0:
        return Err("trace preparation child exited unsuccessfully")
    if stdout == "" or stdout.len() > TRACE_PREPARATION_OUTPUT_MAX:
        return Err("trace preparation output is empty or exceeds 1 MiB")
    val receipt = decode_trace_run_preparation(stdout)?
    val canonical = encode_trace_run_preparation(receipt)?
    if stdout != canonical and stdout != canonical + "\n" and stdout != canonical + "\r\n":
        return Err("trace preparation output is not exactly one canonical acknowledgement")
    val plan = materialize_trace_run_plan(request, receipt.run_id)?
    validate_trace_run_preparation(receipt, request, plan)?
    Ok(plan)

# Retain byte output until explicit UTF-8 validation. Terminal process state
# alone is insufficient: drain all retained stdout/stderr before collection.
fn preparation_child_output(binary: text, request_path: text, option: text) -> Result<text, text>:
    val args = ["run", "src/app/test_runner_new/test_db_lane_main.spl", option + request_path]
    val started = OwnedProcessLease.start(binary, args, [], TRACE_PREPARATION_TIMEOUT_MS, 1000, TRACE_PREPARATION_OUTPUT_MAX)?
    var lease = started.lease()
    var output: [u8] = []
    var drained = false
    var failure = ""
    var polls = 0
    while not drained:
        polls += 1
        if polls > 2401:
            failure = "trace preparation process polling budget exhausted"
            break
        val polled = lease.poll(25, 65536, 65536)
        if polled.is_err():
            failure = "trace preparation process poll failed"
            break
        val poll = polled.unwrap()
        if poll.timed_out or poll.stdout_truncated or poll.stderr_truncated or poll.runtime_error != 0:
            failure = "trace preparation process timed out, truncated output, or failed"
            break
        for byte in poll.stdout:
            if output.len() >= TRACE_PREPARATION_OUTPUT_MAX:
                failure = "trace preparation stdout exceeds 1 MiB"
                break
            output.push(byte)
        drained = poll.terminal and poll.stdout_delivered == poll.stdout_kept and poll.stderr_delivered == poll.stderr_kept
        if failure != "": break
    if not drained:
        lease.cancel()
        var cleanup_polls = 0
        while not drained and cleanup_polls < 1201:
            cleanup_polls += 1
            val polled = lease.poll(25, 65536, 65536)
            if polled.is_err(): break
            val poll = polled.unwrap()
            drained = poll.terminal and poll.stdout_delivered == poll.stdout_kept and poll.stderr_delivered == poll.stderr_kept
        if not drained:
            failure = "trace preparation process cleanup could not be confirmed"
    val completed = lease.result()
    if completed.is_err():
        failure = "trace preparation process result is unavailable"
    if completed.is_ok():
        val result = completed.unwrap()
        if not result.reaped or result.timed_out or result.cancel_requested or result.exit_code != 0 or result.runtime_error != 0 or result.stdout_truncated or result.stderr_truncated:
            if failure == "": failure = "trace preparation process failed or was not reaped intact"
        if failure == "" and (result.stdout_seen != output.len() or result.stdout_kept != output.len()):
            failure = "trace preparation stdout was not completely collected"
    val collected = lease.collect()
    if collected.is_err():
        failure = "trace preparation process collection failed"
    if collected.is_ok():
        val result = collected.unwrap()
        if not result.reaped or result.runtime_error != 0:
            failure = "trace preparation process collection did not confirm reaping"
    val released = lease.release()
    if released.is_err():
        failure = "trace preparation process lease release failed"
    if failure != "": return Err(failure)
    validated_utf8_bytes_to_text_linear(output)

# request_path must be in a caller-owned temporary directory. Exclusive
# reservation prevents clobbering an existing entry; directory ownership is
# still required to exclude external replacement between facade operations.
# After reservation, all paths attempt cleanup before returning. A transport
# failure may leave a prepared DB run; it never authorizes test dispatch.
pub fn prepare_trace_run_via_db_lane(request: TraceRunRequest, selected_paths: [text], binary: text, request_path: text) -> Result<TraceRunPlan, text>:
    validate_trace_request_selection(request, selected_paths)?
    val source = encode_trace_run_request(request)?
    val stdout = prepare_trace_payload(binary, request_path, source, "--prepare-request=")?
    verify_trace_preparation_output(request, stdout, 0)

# The full metadata acknowledgement is required for this path. This persists
# declared intent only; it does not resolve configuration or admit a binary.
pub fn prepare_trace_sspec_run_via_db_lane(metadata: TraceSspecPlannedRequest, selected_paths: [text], binary: text, request_path: text) -> Result<TraceRunPlan, text>:
    validate_trace_request_selection(metadata.request, selected_paths)?
    val source = encode_trace_sspec_planned_request(metadata)?
    val stdout = prepare_trace_payload(binary, request_path, source, "--prepare-sspec-request=")?
    verify_trace_sspec_preparation(metadata, stdout, 0)

# Shared reservation, process lifetime and cleanup for both typed payloads.
fn prepare_trace_payload(binary: text, request_path: text, source: text, option: text) -> Result<text, text>:
    if binary == "" or request_path == "":
        return Err("trace preparation requires a binary and owned temporary request path")
    for value in [binary, request_path]:
        for byte in value.bytes():
            if byte == 0 or byte == 10 or byte == 13:
                return Err("trace preparation binary or request path contains a protocol control byte")
    if file_exists(request_path):
        return Err("trace preparation request path already exists")
    if not file_create_exclusive(request_path, ""):
        return Err("trace preparation could not exclusively reserve request path")
    if not file_atomic_write(request_path, source):
        if not file_remove(request_path):
            return Err("trace preparation write failed and owned request cleanup failed")
        return Err("trace preparation request atomic write failed")
    val captured = preparation_child_output(binary, request_path, option)
    if not file_remove(request_path):
        return Err("trace preparation owned request cleanup failed")
    captured
