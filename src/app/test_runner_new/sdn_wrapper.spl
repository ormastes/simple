# Native SDN result-file transport. Diagnostics never share the result channel.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# V4 supplies a child-scoped environment, pinned executable/cwd and frozen
# process ownership. Current native V4 supports leader-only retirement and
# rejects this required ProcessGroup request, including on Linux. A provider
# with proven group retirement is a prerequisite, not an enabled capability.
# This transport is not provenance admission or proof of test/source closure.
use app.io.cli_ops.{cli_current_exe_path}
use app.io.env_ops.{cwd, env_get, env_vars}
use app.test_runner_new.sdn_worker_args.{parse_private_sdn_worker_args}
use app.test_runner_new.sdn_worker_protocol.{TestRunnerSdnMessage, validate_test_runner_sdn_message}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.process.observation_v4.{ProcessObservationEnvironmentV4, ProcessObservationRequestV4,
    ProcessObservationReceiptV4, ProcessObservationPacketKindV4, ProcessObservationStatusV4,
    ProcessObservationFailurePhaseV4, ProcessObservationFailureReasonV4, ProcessObservationStreamStateV4,
    ProcessObservationEnforcementKindV4, ProcessObservationDescendantPolicyV4,
    freeze_process_observation_receipt_v4, freeze_process_observation_cleanup_receipt_v4}
use std.nogc_sync_mut.io.process_observation_v4.{OwnedExecutablePin, OwnedCwdPinV4,
    ProcessObservationStartV4, process_observation_capabilities_v4, process_observation_start_pinned_v4}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_create_exclusive, file_remove,
    file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use std.nogc_sync_mut.io.stderr_ops.{stderr_write, stderr_flush}

val SDN_RESULT_LIMIT: i64 = 1048576
val SDN_DIAGNOSTIC_LIMIT: i64 = 4194304
val SDN_CALLER_WAIT_NS: i64 = 25000000

pub struct TestSdnFrame:
    document: text
    exit_code: i32

# Current native V4 declares nine capability bits (0..8), ending with
# POV4_CAP_LEADER_ONLY; there is no declared process-group retirement bit.
# runtime_process_owned.c rejects any non-LeaderOnly descendant policy and
# emits TREE_EMPTY=0. Keep the unsupported boundary explicit until the owner
# publishes an implemented, typed group-retirement capability and fixtures.
# Unknown future bits are not evidence of that capability.
pub fn test_sdn_group_retirement_preflight(capability_bits: i64) -> Result<(), text>:
    if capability_bits >= 0 and (capability_bits & ~511) == 0:
        return Err("SDN result-file transport unavailable: current V4 providers support leader-only retirement; process-group retirement is required")
    Err("SDN result-file transport unavailable: provider capabilities do not declare a recognized process-group retirement contract")

fn _sdn_exit(code: i64) -> i32:
    if code > 0 and code <= 2147483647: code as i32 else: 1

pub fn test_sdn_failure_frame(reason: text, worker_exit_code: i64) -> TestSdnFrame:
    # Callers use fixed bounded diagnostics. This pure API also bounds arbitrary
    # input before canonical encoding, without slicing a UTF-8 code point.
    val message = if reason == "" or reason.len() > 4096: "SDN worker transport failed" else: reason
    val code = if worker_exit_code < -1: -1 else: worker_exit_code
    var fields: Dict<text, SdnValue> = {}
    fields["schema"] = SdnValue.String("simple.test-runner.failure/v1")
    fields["success"] = SdnValue.Bool(false)
    fields["worker_exit_code"] = SdnValue.Int(code)
    fields["error"] = SdnValue.String(message)
    TestSdnFrame(document: sdn_encode_canonical(SdnValue.Dict(fields)), exit_code: _sdn_exit(code))

pub fn verify_test_sdn_result_frame(source: text, worker_exit_code: i64) -> Result<TestSdnFrame, text>:
    if worker_exit_code < 0:
        return Err("SDN worker has no valid process exit status")
    val message = validate_test_runner_sdn_message(source)?
    var fields: Dict<text, SdnValue> = {}
    var code = _sdn_exit(worker_exit_code)
    match message:
        case TestRunnerSdnMessage.Output(output):
            if output.success and worker_exit_code != 0:
                return Err("SDN worker success contradicts its nonzero process exit")
            if output.success: code = 0
            fields["schema"] = SdnValue.String("simple.test-runner.output/v1")
            fields["success"] = SdnValue.Bool(output.success)
            fields["runner_ok"] = SdnValue.Bool(output.runner_ok)
            fields["spec"] = output.spec
            fields["spl_doctest"] = output.spl_doctest
            fields["sdoctest"] = output.sdoctest
        case TestRunnerSdnMessage.Failure(failure):
            if failure.worker_exit_code != worker_exit_code:
                return Err("SDN failure envelope disagrees with its observed process exit")
            fields["schema"] = SdnValue.String("simple.test-runner.failure/v1")
            fields["success"] = SdnValue.Bool(false)
            fields["worker_exit_code"] = SdnValue.Int(worker_exit_code)
            fields["error"] = SdnValue.String(failure.error)
    Ok(TestSdnFrame(document: sdn_encode_canonical(SdnValue.Dict(fields)), exit_code: code))

# Deterministic child-only environment. Preserve the snapshot except for the
# private worker authorization and recursion depth; never mutate ambient state.
pub fn test_sdn_worker_environment(snapshot: [(text, text)]) -> Result<[ProcessObservationEnvironmentV4], text>:
    if snapshot.len() > 1024: return Err("SDN worker environment has too many entries")
    # Reserve both inserted key/value pairs before accepting inherited bytes.
    var remaining: i64 = 131072 - "SIMPLE_TEST_SDN_WORKER_AUTH".len() - "SIMPLE_TEST_DEPTH".len() - 2
    var values: Dict<text, text> = {}
    var keys: [text] = []
    for item in snapshot:
        val key = item.0
        val value = item.1
        if key.len() > remaining: return Err("SDN worker environment exceeds 128 KiB")
        remaining -= key.len()
        if value.len() > remaining: return Err("SDN worker environment exceeds 128 KiB")
        remaining -= value.len()
        if key == "" or key.contains("=") or key.contains("\0") or value.contains("\0"):
            return Err("SDN worker environment has an invalid entry")
        if key == "SIMPLE_TEST_SDN_WORKER_AUTH" or key == "SIMPLE_TEST_DEPTH": continue
        if values.contains_key(key): return Err("SDN worker environment has duplicate keys")
        if keys.len() >= 1022: return Err("SDN worker environment including controls exceeds 1024 entries")
        values[key] = value
        keys.push(key)
    values["SIMPLE_TEST_SDN_WORKER_AUTH"] = "1"
    values["SIMPLE_TEST_DEPTH"] = "1"
    keys.push("SIMPLE_TEST_SDN_WORKER_AUTH")
    keys.push("SIMPLE_TEST_DEPTH")
    # Insertion sort is bounded to 1024 host-environment keys, not test rows.
    var index = 1
    while index < keys.len():
        val key = keys[index]
        var position = index
        while position > 0 and keys[position - 1] > key:
            keys[position] = keys[position - 1]
            position -= 1
        keys[position] = key
        index += 1
    var result: [ProcessObservationEnvironmentV4] = []
    for key in keys: result.push(ProcessObservationEnvironmentV4(key: key, value: values[key]))
    Ok(result)

# Include argv[0] and the three private framing arguments in the native
# provider's 4096-argument and aggregate-text limits before concatenation.
pub fn test_sdn_worker_argv(binary: text, result_path: text, forwarded: [text]) -> Result<[text], text>:
    if forwarded.len() > 4092 or binary == "" or result_path == "":
        return Err("SDN worker argv framing is empty or exceeds its count bound")
    if binary.len() > 4096 or result_path.len() > 4096:
        return Err("SDN worker argv path exceeds its bound")
    var remaining: i64 = 1048576 - "test".len() - "--test-sdn-worker".len() - "--test-sdn-result=".len()
    for item in [binary, result_path] + forwarded:
        if item.len() > 65536 or item.len() > remaining or item.contains("\0"):
            return Err("SDN worker complete argv is invalid or oversized")
        remaining -= item.len()
    Ok(["test", "--test-sdn-worker", "--test-sdn-result=" + result_path] + forwarded)

struct SdnChildCapture:
    exit_code: i64
    failure: text
    cleanup_safe: bool

fn _sdn_diagnostics(receipt: ProcessObservationReceiptV4) -> Result<(), text>:
    if receipt.stdout.len() > SDN_DIAGNOSTIC_LIMIT or receipt.stderr.len() > SDN_DIAGNOSTIC_LIMIT:
        return Err("SDN worker diagnostics exceeded the capture bound")
    val stdout = validated_utf8_bytes_to_text_linear(receipt.stdout)?
    val stderr = validated_utf8_bytes_to_text_linear(receipt.stderr)?
    if stdout != "": stderr_write(stdout)
    if stderr != "": stderr_write(stderr)
    stderr_flush()
    Ok(())

fn _sdn_collect(started: ProcessObservationStartV4) -> SdnChildCapture:
    var lease = started.lease
    var receipt = started.receipt
    if receipt.packet.status == ProcessObservationStatusV4.Rejected:
        return SdnChildCapture(exit_code: -1, failure: "SDN worker process provider rejected the request", cleanup_safe: true)
    var failure = ""
    var frozen = false
    var polls = 0
    while polls < 1152001:
        polls += 1
        val collected = lease.collect(SDN_CALLER_WAIT_NS)
        if collected.is_err():
            failure = "SDN worker process collection failed"
            break
        receipt = collected.unwrap()
        if receipt.packet.packet_kind == ProcessObservationPacketKindV4.Frozen or receipt.packet.packet_kind == ProcessObservationPacketKindV4.CleanupFrozen:
            frozen = true
            break
    if not frozen:
        if failure == "": failure = "SDN worker process polling budget exhausted"
        val _cancelled = lease.cancel(0)
        var cleanup_polls = 0
        while cleanup_polls < 1201:
            cleanup_polls += 1
            val collected = lease.collect(SDN_CALLER_WAIT_NS)
            if collected.is_err(): break
            receipt = collected.unwrap()
            if receipt.packet.packet_kind == ProcessObservationPacketKindV4.Frozen or receipt.packet.packet_kind == ProcessObservationPacketKindV4.CleanupFrozen:
                frozen = true
                break
    if not frozen:
        return SdnChildCapture(exit_code: -1, failure: "SDN worker cleanup was not confirmed; owned directory retained", cleanup_safe: false)
    if receipt.packet.packet_kind == ProcessObservationPacketKindV4.CleanupFrozen:
        val cleanup = freeze_process_observation_cleanup_receipt_v4(receipt)
        if cleanup.is_err():
            return SdnChildCapture(exit_code: -1, failure: "SDN worker cleanup receipt is invalid", cleanup_safe: false)
        val acknowledged = lease.acknowledge_cleanup(cleanup.unwrap())
        val safe = acknowledged.is_ok() and receipt.packet.leader_reaped and receipt.packet.tree_empty
        val _diagnosed = _sdn_diagnostics(receipt)
        return SdnChildCapture(exit_code: -1, failure: "SDN worker failed before executable confirmation", cleanup_safe: safe)
    val frozen_receipt = freeze_process_observation_receipt_v4(receipt)
    if frozen_receipt.is_err():
        return SdnChildCapture(exit_code: -1, failure: "SDN worker frozen receipt is invalid", cleanup_safe: false)
    val packet = receipt.packet
    val acknowledged = lease.acknowledge(frozen_receipt.unwrap())
    val safe = acknowledged.is_ok() and packet.leader_reaped and packet.tree_control_available and packet.tree_empty
    if not safe: failure = "SDN worker process-group retirement or acknowledgement is incomplete"
    if packet.failure_phase != ProcessObservationFailurePhaseV4.Unknown or packet.failure_reason != ProcessObservationFailureReasonV4.Unknown or packet.errno_value != 0 or packet.exec_errno != 0 or packet.signal_number != 0 or packet.term_attempted or packet.kill_attempted:
        failure = "SDN worker timed out, was cancelled, or failed natively"
    if packet.stdout.state != ProcessObservationStreamStateV4.Eof or packet.stderr.state != ProcessObservationStreamStateV4.Eof or packet.stdout.seen_bytes != packet.stdout.retained_bytes or packet.stderr.seen_bytes != packet.stderr.retained_bytes or packet.stdout.retained_bytes != receipt.stdout.len() or packet.stderr.retained_bytes != receipt.stderr.len():
        failure = "SDN worker diagnostic capture is truncated or incomplete"
    if _sdn_diagnostics(receipt).is_err(): failure = "SDN worker diagnostics are oversized or invalid UTF-8"
    SdnChildCapture(exit_code: packet.exit_code, failure: failure, cleanup_safe: safe)

fn _sdn_launch(binary: text, directory: text, arguments: [text], environment: [ProcessObservationEnvironmentV4], capabilities: i64) -> SdnChildCapture:
    val executable_result = OwnedExecutablePin.pin(binary)
    if executable_result.is_err():
        return SdnChildCapture(exit_code: -1, failure: "SDN worker executable pin failed", cleanup_safe: true)
    var executable = executable_result.unwrap()
    val cwd_result = OwnedCwdPinV4.pin(directory)
    if cwd_result.is_err():
        val _closed = executable.close()
        return SdnChildCapture(exit_code: -1, failure: "SDN worker cwd pin failed", cleanup_safe: true)
    var cwd_pin = cwd_result.unwrap()
    # The owner replaces all placeholder pin identities/digests with its sealed
    # owners before canonical request validation and spawning.
    val request = ProcessObservationRequestV4(argv: [binary] + arguments,
        environment: environment, canonical_cwd: directory, canonical_pinned_directory: directory,
        executable_pin: 0, executable_digest: [], cwd_pin_claim: 0, cwd_identity_digest: [],
        capability_bits: capabilities, wall_budget_ns: 28800000000000,
        term_grace_ns: 1000000000, cleanup_budget_ns: 30000000000,
        stdout_limit_bytes: SDN_DIAGNOSTIC_LIMIT, stderr_limit_bytes: SDN_DIAGNOSTIC_LIMIT,
        memory_limit_bytes: 0, enforcement_kind: ProcessObservationEnforcementKindV4.None,
        descendant_policy: ProcessObservationDescendantPolicyV4.ProcessGroup, max_clock_resolution_ns: 1000000000)
    val started = process_observation_start_pinned_v4(executable, cwd_pin, request)
    # A malformed start receipt may describe an already spawned child. Retain
    # the directory when ownership cannot be recovered; never guess no spawn.
    var capture = if started.is_ok(): _sdn_collect(started.unwrap()) else:
        SdnChildCapture(exit_code: -1, failure: "SDN worker process start failed without a validated receipt", cleanup_safe: false)
    val closed_cwd = cwd_pin.close()
    val closed_executable = executable.close()
    if closed_cwd.is_err() or closed_executable.is_err(): capture.failure = "SDN worker pin close failed"
    capture

fn _sdn_run(args: [text]) -> TestSdnFrame:
    if args.len() > 4096: return test_sdn_failure_frame("SDN test argument count exceeds its bound", -1)
    var remaining: i64 = 1048576
    for arg in args:
        if arg.len() > 65536 or arg.len() > remaining or arg.contains("\0"):
            return test_sdn_failure_frame("SDN test arguments are invalid or oversized", -1)
        remaining -= arg.len()
    val parsed = parse_private_sdn_worker_args(args, false)
    if parsed.is_err(): return test_sdn_failure_frame("Invalid public SDN test arguments", -1)
    if env_get("SIMPLE_TEST_DEPTH") != "" and env_get("SIMPLE_TEST_DEPTH") != "0":
        return test_sdn_failure_frame("Recursive SDN test wrapper invocation refused", -1)
    val capabilities = process_observation_capabilities_v4()
    if capabilities.is_err(): return test_sdn_failure_frame("SDN worker requires the scoped-environment V4 process owner", -1)
    val provider = capabilities.unwrap()
    if not provider.available or provider.runtime_error != 0 or provider.max_capture_bytes < SDN_DIAGNOSTIC_LIMIT or provider.max_caller_wait_ns < SDN_CALLER_WAIT_NS:
        return test_sdn_failure_frame("SDN worker scoped-environment process provider is unavailable or insufficient", -1)
    match test_sdn_group_retirement_preflight(provider.capability_bits):
        case Err(reason): return test_sdn_failure_frame(reason, -1)
        case Ok(_): pass
    val snapshot = unsafe(capabilities: [ffi]): env_vars()
    if snapshot == nil: return test_sdn_failure_frame("SDN worker environment snapshot failed", -1)
    val environment = test_sdn_worker_environment(snapshot ?? [])
    if environment.is_err(): return test_sdn_failure_frame("SDN worker environment is invalid or oversized", -1)
    val binary = cli_current_exe_path()
    val directory = cwd()
    if binary == "" or directory == "": return test_sdn_failure_frame("SDN worker executable or cwd is unavailable", -1)
    var parent = env_get("TMPDIR")
    if parent == "": parent = env_get("TEMP")
    if parent == "": parent = directory
    for path in [binary, directory, parent]:
        if path.len() > 4096 or path.contains("\0") or path.contains("\r") or path.contains("\n"):
            return test_sdn_failure_frame("SDN worker path is invalid or oversized", -1)
    val created = secure_temp_dir(parent, "simple-test-sdn")
    if created.is_err(): return test_sdn_failure_frame("SDN worker private temporary directory creation failed", -1)
    val owned_directory = created.unwrap()
    val result_path = owned_directory + "/result.sdn"
    if not file_create_exclusive(result_path, ""):
        val _removed = dir_remove(owned_directory, false)
        return test_sdn_failure_frame("SDN worker result reservation failed", -1)
    val worker_args = test_sdn_worker_argv(binary, result_path, parsed.unwrap().forwarded_args)
    if worker_args.is_err():
        val _removed_file = file_remove(result_path)
        val _removed_directory = dir_remove(owned_directory, false)
        return test_sdn_failure_frame("SDN worker complete argv exceeds its framing bounds", -1)
    val capture = _sdn_launch(binary, directory, worker_args.unwrap(), environment.unwrap(), provider.capability_bits)
    var frame = test_sdn_failure_frame(capture.failure, capture.exit_code)
    if capture.failure == "" and capture.cleanup_safe:
        val read = file_read_regular_no_follow_bounded(result_path, SDN_RESULT_LIMIT)
        if read.is_err():
            frame = test_sdn_failure_frame("SDN worker result is missing, nonregular, linked, or oversized", capture.exit_code)
        else:
            val verified = verify_test_sdn_result_frame(read.unwrap(), capture.exit_code)
            frame = if verified.is_ok(): verified.unwrap() else:
                test_sdn_failure_frame("SDN worker result is malformed or contradicts its process exit", capture.exit_code)
    if capture.cleanup_safe:
        val removed_file = file_remove(result_path)
        val removed_directory = dir_remove(owned_directory, false)
        if not removed_file or not removed_directory:
            frame = test_sdn_failure_frame("SDN worker owned temporary cleanup failed", capture.exit_code)
    else:
        stderr_write("SDN worker directory retained because process retirement is unconfirmed: " + owned_directory + "\n")
    frame

pub fn run_test_sdn_wrapper(args: [text]) -> i32:
    val frame = _sdn_run(args)
    print frame.document
    frame.exit_code
