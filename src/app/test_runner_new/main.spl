# Simple Test Runner entrypoint.

use app.test_runner_new.test_runner_main.{run_test_cli}
use std.io_runtime.{env_get_opt, env_remove_process}
use std.nogc_sync_mut.io.file_ops.{file_create_exclusive}
use std.test_runner.runner_self_coverage.{runner_self_coverage_start, runner_self_coverage_sdn}

fn main() -> i64:
    val self_coverage_output = env_get_opt("SIMPLE_RUNNER_SELF_COVERAGE_OUTPUT") ?? ""
    if self_coverage_output != "":
        # Descendant runners must not overwrite this process's receipt.
        if not env_remove_process("SIMPLE_RUNNER_SELF_COVERAGE_OUTPUT"):
            print "ERROR: cannot isolate scoped runner self-coverage output"
            return 1
        runner_self_coverage_start()
    val result = run_test_cli()
    if self_coverage_output != "":
        # Refuse existing receipts and destination symlinks; never clobber a
        # previous run's evidence. The caller owns the parent directory.
        if not file_create_exclusive(self_coverage_output, runner_self_coverage_sdn()):
            print "ERROR: cannot create scoped runner self-coverage at {self_coverage_output}"
            return 1
    result
