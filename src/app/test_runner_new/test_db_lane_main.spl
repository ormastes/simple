# Test-database lane child entry.
#
# The core test runner records a finished spec run by writing a
# std.nogc_sync_mut.test_runner.test_db_record file and spawning
# `simple run <this file> --record=<path>`. Running the database
# writer here, in a child interpreter, keeps std.database.test_extended,
# std.database.feature, test_db_compat and doc_generator out of the core
# runner's static closure.
#
# Contract: exit 0 after the run was recorded and test_result.md rewritten;
# otherwise a non-zero exit with the named reason on
# stderr as `test-db lane error: <reason>`.
# Preparation mode instead accepts --prepare-request=<SDN path>, persists
# immutable intent and emits a strict SDN acknowledgement of reloaded intent.
# It does not execute tests, render reports or qualify evidence.

use std.sffi.cli_args.{cli_get_args}
use std.nogc_sync_mut.io.file_ops.{file_read, file_exists, file_size, file_atomic_write, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.test_runner.test_db_record.{test_db_run_record_decode, test_db_run_record_attach_trace_events}
use std.nogc_sync_mut.test_runner.test_db_trace_record.{test_db_trace_record_decode}
use std.nogc_sync_mut.test_runner.test_runner_helpers.{update_test_database_from_record}
use std.test_runner.doc_generator.{generate_test_result_md}
use std.nogc_sync_mut.test_runner.test_db_compat.{RunnerTestDb}
use std.common.traceability.run_request_codec.{decode_trace_run_request}
use std.common.traceability.run_preparation.{build_trace_run_preparation, encode_trace_run_preparation}
use std.common.traceability.sspec_inventory_codec.{decode_trace_sspec_planned_request, encode_trace_sspec_planned_request}
use std.common.traceability.sspec_preparation.{build_trace_sspec_preparation, encode_trace_sspec_preparation}

val TEST_RESULT_MD_PATH = "doc/08_tracking/test/test_result.md"

fn _lane_arg(args: [text], key: text) -> text:
    val prefix = "--{key}="
    for arg in args:
        if arg.starts_with(prefix):
            return arg[prefix.len():]
    ""

fn main() -> i64:
    val args = cli_get_args()
    # Empty or repeated protocol values must not silently select a different
    # run. Prepare and result submission are separate owner operations.
    for key in ["record", "trace-record", "trace-run", "prepare-request", "prepare-sspec-request"]:
        val prefix = "--{key}="
        var count = 0
        for arg in args:
            if arg.starts_with(prefix):
                count += 1
                if arg.len() == prefix.len():
                    eprint "test-db lane error: empty --{key}="
                    return 2
        if count > 1:
            eprint "test-db lane error: repeated --{key}="
            return 2
    val prepare_path = _lane_arg(args, "prepare-request")
    val metadata_path = _lane_arg(args, "prepare-sspec-request")
    if prepare_path != "" and metadata_path != "":
        eprint "test-db lane error: preparation modes are mutually exclusive"
        return 2
    if prepare_path != "" or metadata_path != "":
        if _lane_arg(args, "record") != "" or _lane_arg(args, "trace-record") != "" or _lane_arg(args, "trace-run") != "":
            eprint "test-db lane error: preparation cannot include result submission"
            return 2
        val prepared = if metadata_path != "": _prepare_trace_sspec_request(metadata_path) else: _prepare_trace_request(prepare_path)
        match prepared:
            case Ok(acknowledgement):
                print acknowledgement
                return 0
            case Err(reason):
                eprint "test-db lane error: {reason}"
                return 2
    val record_path = _lane_arg(args, "record")
    if record_path == "":
        eprint "test-db lane error: missing --record="
        return 2
    if not file_exists(record_path):
        eprint "test-db lane error: record file not found: {record_path}"
        return 2
    val record_size = file_size(record_path)
    if record_size < 0 or record_size > 16777216:
        eprint "test-db lane error: record size unavailable or exceeds 16 MiB"
        return 2
    val decoded = test_db_run_record_decode(file_read(record_path))
    var record = match decoded:
        case Ok(value): value
        case Err(reason):
            eprint "test-db lane error: {reason}"
            return 2
    var trace_error = ""
    val trace_path = _lane_arg(args, "trace-record")
    if trace_path != "":
        if not file_exists(trace_path):
            trace_error = "trace record file not found: {trace_path}"
        else:
            val trace_size = file_size(trace_path)
            if trace_size < 0 or trace_size > 16777216:
                trace_error = "trace record size unavailable or exceeds 16 MiB"
            else:
                match test_db_trace_record_decode(file_read(trace_path)):
                    case Ok(trace_record):
                        match test_db_run_record_attach_trace_events(record, trace_record.files):
                            case Ok(attached): record = attached
                            case Err(reason): trace_error = reason
                    case Err(reason): trace_error = reason
    val trace_run_id = _lane_arg(args, "trace-run")
    match update_test_database_from_record(record, trace_run_id, trace_error):
        case Ok(database):
            # The database is already saved. Report failure must remain visible
            # without discarding persisted observations or returning success.
            if not file_atomic_write(TEST_RESULT_MD_PATH, generate_test_result_md(database)):
                eprint "test-db lane error: persisted results but Markdown report could not be written"
                return 1
            print "test-db lane: recorded {record.files.len()} file(s)"
            if trace_error != "":
                eprint "test-db lane error: {trace_error}"
                return 1
            0
        case Err(reason):
            eprint "test-db lane error: {reason}"
            1

# The acknowledgement describes reloaded persisted intent, not authentication
# or complete execution provenance. The parent must verify it before dispatch.
fn _prepare_trace_request(path: text) -> Result<text, text>:
    val source = file_read_regular_no_follow_bounded(path, 1048576)?
    val request = decode_trace_run_request(source)?
    var owner = RunnerTestDb.load()?
    val prepared = owner.prepare_trace_request(request)?
    val persisted = RunnerTestDb.resume_trace_run(prepared.run_id)?
    match persisted.db.get_trace_run_plan(prepared.run_id)?:
        case Some(plan):
            val acknowledgement = build_trace_run_preparation(request, plan)?
            encode_trace_run_preparation(acknowledgement)
        case nil:
            Err("saved trace intent disappeared before acknowledgement")

# Metadata-aware preparation has a distinct acknowledgement schema so a
# request-only parent cannot mistake it for the older plan-only protocol.
fn _prepare_trace_sspec_request(path: text) -> Result<text, text>:
    val source = file_read_regular_no_follow_bounded(path, 1048576)?
    val metadata = decode_trace_sspec_planned_request(source)?
    val canonical = encode_trace_sspec_planned_request(metadata)?
    var owner = RunnerTestDb.load()?
    val prepared = owner.prepare_trace_sspec_request(metadata)?
    val persisted = RunnerTestDb.resume_trace_sspec_run(prepared.run_id)?
    val saved = match persisted.db.get_trace_sspec_metadata(prepared.run_id)?:
        case Some(value): value
        case nil: return Err("saved trace SSpec metadata disappeared before acknowledgement")
    if encode_trace_sspec_planned_request(saved)? != canonical:
        return Err("saved trace SSpec metadata changed before acknowledgement")
    val plan = match persisted.db.get_trace_run_plan(prepared.run_id)?:
        case Some(value): value
        case nil: return Err("saved trace SSpec plan disappeared before acknowledgement")
    val acknowledgement = build_trace_sspec_preparation(saved, plan)?
    encode_trace_sspec_preparation(acknowledgement)
