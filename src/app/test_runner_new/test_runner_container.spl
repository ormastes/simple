# Compatibility facade: one implementation owns argv and cleanup policy.
use std.nogc_sync_mut.test_runner.test_runner_container.{
    container_detect_runtime as backend_detect,
    container_check_image as backend_check_image,
    container_run_test as backend_run_test,
    container_build_test_image as backend_build_image,
    container_get_version as backend_version,
    container_cleanup_volumes as backend_cleanup
}

pub fn container_detect_runtime() -> text:
    backend_detect()

pub fn container_check_image(image: text, runtime: text) -> bool:
    backend_check_image(image, runtime)

pub fn container_run_test(test_file: text, runtime: text, image: text, memory_mb: i64,
        cpu_count: f64, network: text, readonly: bool, workspace: text) -> (text, text, i64, i64):
    backend_run_test(test_file, runtime, image, memory_mb, cpu_count, network, readonly, workspace)

pub fn container_build_test_image(runtime: text, dockerfile_path: text, image_name: text) -> bool:
    backend_build_image(runtime, dockerfile_path, image_name)

pub fn container_get_version(runtime: text) -> text:
    backend_version(runtime)

pub fn container_cleanup_volumes(runtime: text) -> bool:
    backend_cleanup(runtime)
