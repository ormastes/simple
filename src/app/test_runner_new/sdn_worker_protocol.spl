# Strict consumer-side validation for the versioned native-SDN worker stream.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.traceability.schema.{trace_sdn_preflight}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.test_runner.test_runner_types.{TestFileResult, test_file_result_outcome_class}

pub struct TestRunnerSdnOutput:
    success: bool
    runner_ok: bool
    spec: SdnValue
    spl_doctest: SdnValue
    sdoctest: SdnValue

pub struct TestRunnerSdnFailure:
    worker_exit_code: i64
    error: text

pub enum TestRunnerSdnMessage:
    Output(TestRunnerSdnOutput)
    Failure(TestRunnerSdnFailure)

fn _worker_record(value: SdnValue, names: [text]) -> Result<Dict<text, SdnValue>, text>:
    match value:
        case SdnValue.Dict(fields):
            if fields.len() != names.len():
                return Err("unexpected or missing worker SDN fields")
            for name in names:
                if not fields.contains_key(name):
                    return Err("missing worker SDN field: " + name)
            Ok(fields)
        case _: Err("worker SDN value must be a dictionary")

fn _worker_text(fields: Dict<text, SdnValue>, name: text) -> Result<text, text>:
    match fields[name]:
        case SdnValue.String(value): Ok(value)
        case _: Err("worker SDN field must be text: " + name)

fn _worker_bool(fields: Dict<text, SdnValue>, name: text) -> Result<bool, text>:
    match fields[name]:
        case SdnValue.Bool(value): Ok(value)
        case _: Err("worker SDN field must be boolean: " + name)

fn _worker_int(fields: Dict<text, SdnValue>, name: text) -> Result<i64, text>:
    match fields[name]:
        case SdnValue.Int(value): Ok(value)
        case _: Err("worker SDN field must be integer: " + name)

fn _worker_nonnegative(fields: Dict<text, SdnValue>, name: text) -> Result<(), text>:
    if _worker_int(fields, name)? < 0:
        return Err("worker SDN counter must be nonnegative: " + name)
    Ok(())

fn _worker_text_array(value: SdnValue, name: text, maximum: i64) -> Result<(), text>:
    val items = match value:
        case SdnValue.Array(values): values
        case _: return Err("worker SDN field must be an array: " + name)
    if items.len() > maximum:
        return Err("worker SDN array exceeds its bound: " + name)
    for item in items:
        match item:
            case SdnValue.String(_): pass
            case _: return Err("worker SDN array must contain text: " + name)
    Ok(())

fn _worker_validate_omission(value: SdnValue) -> Result<(), text>:
    val fields = _worker_record(value, ["status", "scenario_id", "reason", "prerequisite", "owner", "tracking_id", "artifact_paths", "resume_command"])?
    val status = _worker_text(fields, "status")?
    if status != "blocked" and status != "unsupported":
        return Err("worker omission status is unknown")
    for name in ["scenario_id", "reason", "prerequisite", "owner", "tracking_id", "resume_command"]:
        _worker_text(fields, name)?
    _worker_text_array(fields["artifact_paths"], "artifact_paths", 65536)

fn _worker_validate_resource(value: SdnValue) -> Result<(), text>:
    if value == SdnValue.Null: return Ok(())
    val fields = _worker_record(value, ["wall_ms", "user_cpu_ms", "system_cpu_ms", "peak_tree_charge_bytes", "peak_direct_child_rss_bytes", "heap_live_end_bytes", "heap_peak_bytes", "io_read_bytes", "io_write_bytes", "pids_peak", "evidence_quality", "termination", "signal", "exit_code"])?
    for name in ["wall_ms", "user_cpu_ms", "system_cpu_ms", "peak_tree_charge_bytes", "peak_direct_child_rss_bytes", "heap_live_end_bytes", "heap_peak_bytes", "io_read_bytes", "io_write_bytes", "pids_peak", "signal"]:
        _worker_nonnegative(fields, name)?
    _worker_int(fields, "exit_code")?
    val quality = _worker_text(fields, "evidence_quality")?
    if not ["exact_tree", "exact_direct_child", "sampled_tree", "process_only", "unavailable"].contains(quality):
        return Err("worker resource evidence quality is unknown")
    val termination = _worker_text(fields, "termination")?
    if not ["exited", "wall_timeout", "no_progress_timeout", "cpu_limit", "memory_high", "memory_max", "process_limit", "output_limit", "signal", "external_termination", "infrastructure_failure"].contains(termination):
        return Err("worker resource termination is unknown")
    Ok(())

fn _worker_validate_completion(value: SdnValue) -> Result<(), text>:
    if value == SdnValue.Null: return Ok(())
    val fields = _worker_record(value, ["pid", "process_generation", "exit_code", "signal_number", "tree_reaped", "timed_out", "cancelled", "stdout_digest", "stderr_digest", "transport_execution_digest"])?
    for name in ["pid", "process_generation", "signal_number"]: _worker_nonnegative(fields, name)?
    _worker_int(fields, "exit_code")?
    for name in ["tree_reaped", "timed_out", "cancelled"]: _worker_bool(fields, name)?
    for name in ["stdout_digest", "stderr_digest", "transport_execution_digest"]: _worker_text(fields, name)?
    Ok(())

fn _worker_validate_file(value: SdnValue) -> Result<bool, text>:
    val fields = _worker_record(value, ["path", "passed", "failed", "skipped", "pending", "duration_ms", "setup_ms", "error", "timed_out", "cached", "in_development", "feature_gated", "mcdc_evidence_v1", "mcdc_skip_reason", "degraded_reason", "blocked", "unsupported", "omission_evidence", "compile_ms", "execution_ms", "resource_usage", "resource_class", "cohort_id", "budget_status", "anomaly_status", "process_completion", "trace_case_events_sdn"])?
    for name in ["path", "error", "feature_gated", "mcdc_evidence_v1", "mcdc_skip_reason", "degraded_reason", "resource_class", "cohort_id", "budget_status", "anomaly_status", "trace_case_events_sdn"]:
        _worker_text(fields, name)?
    if _worker_text(fields, "path")? == "": return Err("worker spec file path is empty")
    for name in ["passed", "failed", "skipped", "pending", "duration_ms", "setup_ms", "in_development", "blocked", "unsupported", "compile_ms", "execution_ms"]:
        _worker_nonnegative(fields, name)?
    _worker_bool(fields, "timed_out")?
    _worker_bool(fields, "cached")?
    val omissions = match fields["omission_evidence"]:
        case SdnValue.Array(items): items
        case _: return Err("worker omission evidence must be an array")
    if omissions.len() > 65536: return Err("worker omission evidence exceeds its bound")
    for omission in omissions: _worker_validate_omission(omission)?
    _worker_validate_resource(fields["resource_usage"])?
    _worker_validate_completion(fields["process_completion"])?
    val result = TestFileResult(
        path: _worker_text(fields, "path")?,
        passed: _worker_int(fields, "passed")?,
        failed: _worker_int(fields, "failed")?,
        skipped: _worker_int(fields, "skipped")?,
        pending: _worker_int(fields, "pending")?,
        duration_ms: _worker_int(fields, "duration_ms")?,
        setup_ms: _worker_int(fields, "setup_ms")?,
        error: _worker_text(fields, "error")?,
        timed_out: _worker_bool(fields, "timed_out")?,
        cached: _worker_bool(fields, "cached")?,
        in_development: _worker_int(fields, "in_development")?,
        feature_gated: _worker_text(fields, "feature_gated")?,
        mcdc_evidence_v1: "", mcdc_skip_reason: "", degraded_reason: "",
        blocked: _worker_int(fields, "blocked")?,
        unsupported: _worker_int(fields, "unsupported")?,
        omission_evidence: [], compile_ms: 0, execution_ms: 0,
        resource_usage: None, resource_class: "", cohort_id: "", budget_status: "",
        anomaly_status: "", process_completion: None, trace_case_events_sdn: "")
    val outcome = test_file_result_outcome_class(result)
    Ok(outcome == "OK" or outcome == "SKIP")

fn _worker_validate_group(value: SdnValue) -> Result<(), text>:
    val fields = _worker_record(value, ["name", "passed", "failed", "skipped", "pending", "done_pct"])?
    _worker_text(fields, "name")?
    for name in ["passed", "failed", "skipped", "pending", "done_pct"]: _worker_nonnegative(fields, name)?
    if _worker_int(fields, "done_pct")? > 100: return Err("worker group completion percentage exceeds 100")
    Ok(())

fn _worker_validate_spec(value: SdnValue) -> Result<bool, text>:
    val fields = _worker_record(value, ["success", "total_passed", "total_failed", "total_skipped", "total_pending", "total_timed_out", "total_duration_ms", "total_setup_ms", "total_cached", "groups", "files"])?
    val success = _worker_bool(fields, "success")?
    for name in ["total_passed", "total_failed", "total_skipped", "total_pending", "total_timed_out", "total_duration_ms", "total_setup_ms", "total_cached"]:
        _worker_nonnegative(fields, name)?
    val groups = match fields["groups"]:
        case SdnValue.Array(items): items
        case _: return Err("worker spec groups must be an array")
    val files = match fields["files"]:
        case SdnValue.Array(items): items
        case _: return Err("worker spec files must be an array")
    if groups.len() > 65536 or files.len() > 65536: return Err("worker spec arrays exceed their bound")
    for group in groups: _worker_validate_group(group)?
    var files_success = true
    for file in files:
        val file_success = _worker_validate_file(file)?
        files_success = files_success and file_success
    val expected_success = _worker_int(fields, "total_failed")? == 0 and
        _worker_int(fields, "total_timed_out")? == 0 and files_success
    if success != expected_success:
        return Err("worker spec success flag disagrees with its result rows")
    Ok(success)

fn _worker_validate_modifier(value: SdnValue) -> Result<(), text>:
    match value:
        case SdnValue.Dict(fields):
            if not fields.contains_key("kind"):
                return Err("worker sdoctest modifier has no kind")
            val kind = match fields["kind"]:
                case SdnValue.String(text): text
                case _: return Err("worker sdoctest modifier kind must be text")
            if ["skip", "ignore", "should_fail", "fail_as_success", "ignore_output"].contains(kind):
                if fields.len() != 1: return Err("unexpected fields on worker sdoctest modifier")
                Ok(())
            elif ["init", "env", "tag", "run_config"].contains(kind):
                if fields.len() != 2 or not fields.contains_key("value"): return Err("unexpected fields on valued worker sdoctest modifier")
                match fields["value"]:
                    case SdnValue.String(_): Ok(())
                    case _: Err("worker sdoctest modifier value must be text")
            else:
                Err("unknown worker sdoctest modifier kind")
        case _: Err("worker sdoctest modifier must be a dictionary")

fn _worker_validate_sdoc_block(value: SdnValue) -> Result<(), text>:
    val fields = _worker_record(value, ["block", "status", "duration_ms", "stdout", "stderr", "error"])?
    val status = _worker_text(fields, "status")?
    if not ["passed", "failed", "skipped", "error"].contains(status): return Err("unknown worker sdoctest block status")
    _worker_nonnegative(fields, "duration_ms")?
    for name in ["stdout", "stderr", "error"]: _worker_text(fields, name)?
    val block = _worker_record(fields["block"], ["source_file", "line_number", "code", "language", "modifiers", "transcript"])?
    for name in ["source_file", "code", "language", "transcript"]: _worker_text(block, name)?
    _worker_nonnegative(block, "line_number")?
    val modifiers = match block["modifiers"]:
        case SdnValue.Array(items): items
        case _: return Err("worker sdoctest modifiers must be an array")
    if modifiers.len() > 65536: return Err("worker sdoctest modifiers exceed their bound")
    for modifier in modifiers: _worker_validate_modifier(modifier)?
    Ok(())

fn _worker_validate_sdoc_file(value: SdnValue) -> Result<(), text>:
    val fields = _worker_record(value, ["source_file", "blocks", "total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms"])?
    _worker_text(fields, "source_file")?
    for name in ["total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms"]: _worker_nonnegative(fields, name)?
    val blocks = match fields["blocks"]:
        case SdnValue.Array(items): items
        case _: return Err("worker sdoctest blocks must be an array")
    if blocks.len() > 65536: return Err("worker sdoctest blocks exceed their bound")
    for block in blocks: _worker_validate_sdoc_block(block)?
    Ok(())

fn _worker_validate_sdoc(value: SdnValue) -> Result<bool, text>:
    if value == SdnValue.Null: return Ok(true)
    val fields = _worker_record(value, ["total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms", "files"])?
    for name in ["total", "passed", "failed", "skipped", "errors", "accepted", "duration_ms"]: _worker_nonnegative(fields, name)?
    val files = match fields["files"]:
        case SdnValue.Array(items): items
        case _: return Err("worker sdoctest files must be an array")
    if files.len() > 65536: return Err("worker sdoctest files exceed their bound")
    for file in files: _worker_validate_sdoc_file(file)?
    Ok(_worker_int(fields, "failed")? == 0 and _worker_int(fields, "errors")? == 0)

fn _worker_one_document(source: text) -> Result<SdnValue, text>:
    if source == "" or source.len() > 1048576:
        return Err("worker SDN message must be nonempty and at most 1 MiB")
    trace_sdn_preflight(source)?
    # Frame offsets are bytes. Do not combine byte lengths with a text slice
    # whose character-index behavior may vary between runtime implementations.
    val bytes = source.bytes()
    var end = bytes.len()
    if end > 0 and bytes[end - 1] == 10:
        end -= 1
        if end > 0 and bytes[end - 1] == 13: end -= 1
    var frame: [u8] = []
    for i in 0..end: frame.push(bytes[i])
    val body = validated_utf8_bytes_to_text_linear(frame)?
    if body == "" or body.ends_with("\n") or body.ends_with("\r"):
        return Err("worker SDN message must contain exactly one document frame")
    val parsed = parse_with_spans_and_issues(body)?
    if parsed.2.len() > 0: return Err("worker SDN message contains duplicate or invalid fields")
    if sdn_encode_canonical(parsed.0) != body:
        return Err("worker SDN message is not canonical")
    Ok(parsed.0)

pub fn validate_test_runner_sdn_message(source: text) -> Result<TestRunnerSdnMessage, text>:
    val root_value = _worker_one_document(source)?
    val root = match root_value:
        case SdnValue.Dict(fields): fields
        case _: return Err("worker SDN root must be a dictionary")
    if not root.contains_key("schema"):
        return Err("worker SDN root has no schema field")
    val schema = match root["schema"]:
        case SdnValue.String(value): value
        case _: return Err("worker SDN schema must be text")
    if schema == "simple.test-runner.failure/v1":
        val fields = _worker_record(root_value, ["schema", "success", "worker_exit_code", "error"])?
        if _worker_bool(fields, "success")? or _worker_text(fields, "error")? == "":
            return Err("worker failure envelope must report failure and a reason")
        val exit_code = _worker_int(fields, "worker_exit_code")?
        if exit_code < -1: return Err("worker failure exit code is outside its bound")
        return Ok(TestRunnerSdnMessage.Failure(TestRunnerSdnFailure(worker_exit_code: exit_code, error: _worker_text(fields, "error")?)))
    if schema != "simple.test-runner.output/v1":
        return Err("unsupported test runner worker SDN schema")
    val fields = _worker_record(root_value, ["schema", "success", "runner_ok", "spec", "spl_doctest", "sdoctest"])?
    val success = _worker_bool(fields, "success")?
    val runner_ok = _worker_bool(fields, "runner_ok")?
    var expected_success = runner_ok
    var spec = SdnValue.Null
    var spl = SdnValue.Null
    var doc = SdnValue.Null
    if fields["spec"] != SdnValue.Null:
        spec = fields["spec"]
        val spec_success = _worker_validate_spec(spec)?
        expected_success = expected_success and spec_success
    val spl_success = _worker_validate_sdoc(fields["spl_doctest"])?
    val doc_success = _worker_validate_sdoc(fields["sdoctest"])?
    if fields["spl_doctest"] != SdnValue.Null:
        spl = fields["spl_doctest"]
        expected_success = expected_success and spl_success
    if fields["sdoctest"] != SdnValue.Null:
        doc = fields["sdoctest"]
        expected_success = expected_success and doc_success
    if success != expected_success:
        return Err("worker output success flag disagrees with its enabled result families")
    Ok(TestRunnerSdnMessage.Output(TestRunnerSdnOutput(success: success, runner_ok: runner_ok, spec: spec, spl_doctest: spl, sdoctest: doc)))
