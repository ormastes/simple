"""Where a test-runner invocation's timeout budget comes from.

Three sources, most-specific-wins: an explicit `--timeout N` / `--timeout=N`
flag, then the SIMPLE_TIMEOUT_SECONDS environment variable, then the built-in
default. This lives in its own module rather than inside
`test_runner_client.spl` for two reasons: that file is a standalone script with
a bare `fn main`, which collides with the `fn main` every interpreter-mode spec
is given (see `.claude/rules/testing.md`, "fn main name collision"), so a spec
cannot import it; and the same ladder is wanted by more than one entry point.

History: until 2026-08-17 SIMPLE_TIMEOUT_SECONDS was read by nothing on the
client path. `parse_client_run` hardcoded 120, and since `run.timeout_secs`
feeds both the light-daemon request budget and the direct-child `--timeout`
argument, every session exporting the variable silently got 120s and long specs
were recorded as `failed=1 reason=daemon-no-response budget_ms=120000` — a false
RED that reads like a defect in the spec under test. Bug:
`doc/08_tracking/bug/simple_timeout_seconds_ignored_by_light_daemon_budget_2026-08-17.md`.
Spec: `test/01_unit/app/test_runner_new/client_timeout_env_spec.spl`.
"""

use std.nogc_sync_mut.io.env_ops.{env_get}

# 2026-08-17: raised 120 -> 900. 120s was BELOW the floor cost of running any
# spec at all: a single trivial one-example spec measured 3m07s wall
# (`bin/simple test .tmp_probe/a_spec.spl`, one `assert_equal`), because the
# child pays the full session-setup + module-graph compile before it executes a
# line. With the old default every spec therefore died as
# `error: test-daemon: worker killed at 120s budget` /
# `reason=daemon-worker-timeout budget_ms=119762` — which is exactly the shape
# of a directory sweep that emits thousands of warning lines and no `Results:`
# summary at all. 900 matches `KILL_SIMPLE_MIN_AGE_SECS` in
# `scripts/resource/kill_simple_monitor.shs`, so the per-spec budget and the
# runaway reaper agree instead of racing.
# Bug: doc/08_tracking/bug/test_runner_emits_no_result_summary_silent_exit0_2026-08-17.md
val CLIENT_DEFAULT_TIMEOUT_SECS = 900

pub fn parse_env_timeout_secs(raw: text) -> i64:
    """Parse a SIMPLE_TIMEOUT_SECONDS value. Returns 0 for anything that is not
    a non-empty run of decimal digits, so a malformed value falls back to the
    built-in default rather than silently becoming a 0-second — instantly
    expiring — budget that would report every spec as a timeout."""
    if raw == "":
        return 0
    var value: i64 = 0
    var digits = 0
    var i = 0
    while i < raw.len():
        val c = raw.char_code_at(i)
        if c < 48 or c > 57:
            return 0
        value = value * 10 + (c - 48)
        digits = digits + 1
        i = i + 1
    if digits == 0:
        return 0
    value

# `0` is the documented way to say "no limit" (`SIMPLE_TIMEOUT_SECONDS=0`, and
# `--timeout 0`). Until 2026-09-13 it parsed to 0, was indistinguishable from a
# malformed value, and silently became the 900s default — so the incantation
# used across the repo requested exactly the budget it was trying to escape.
# Bug: doc/08_tracking/bug/web_showcase_slow_specs_relaunch_loop_at_900s_cap_2026-09-13.md
#
# "Unlimited" is represented as a very large FINITE budget rather than a
# sentinel: every downstream consumer (light_request_timeout_ms_from_seconds,
# the outer bounded wait, the `--timeout` argument handed to the child) does
# arithmetic on this number and treats <= 0 as "absent", so a negative or zero
# sentinel would be silently re-defaulted at each hop. 365 days is unreachable
# in practice while keeping every fail-closed bound intact, and it is far above
# LIGHT_REQUEST_MAX_TIMEOUT_MS so the daemon lane is bypassed and the spec runs
# directly with no cap.
val TIMEOUT_UNLIMITED_SECS = 31536000

pub fn timeout_value_is_well_formed(raw: text) -> bool:
    """True when `raw` is a non-empty run of decimal digits — i.e. a value the
    caller actually supplied, as distinct from an absent or malformed one.
    `"0"` is well formed and means unlimited; `"abc"`, `"-5"`, `"800s"` and
    `""` are not."""
    if raw == "":
        return false
    var i = 0
    while i < raw.len():
        val c = raw.char_code_at(i)
        if c < 48 or c > 57:
            return false
        i = i + 1
    true

pub fn timeout_secs_from_value(raw: text) -> i64:
    """The budget a well-formed value asks for, with `0` meaning unlimited.
    Callers must have checked `timeout_value_is_well_formed` first."""
    val secs = parse_env_timeout_secs(raw)
    if secs <= 0:
        return TIMEOUT_UNLIMITED_SECS
    secs

pub fn resolve_timeout_secs(flag_raw: text, env_raw: text) -> i64:
    """The documented ladder, most-specific-wins: an explicit `--timeout N`
    flag, then SIMPLE_TIMEOUT_SECONDS, then the built-in default. `0` at
    either level means unlimited. A malformed value at either level is ignored
    and the next rung is consulted, never turned into a 0-second budget."""
    if timeout_value_is_well_formed(flag_raw):
        return timeout_secs_from_value(flag_raw)
    if timeout_value_is_well_formed(env_raw):
        return timeout_secs_from_value(env_raw)
    CLIENT_DEFAULT_TIMEOUT_SECS

pub fn client_default_timeout_secs() -> i64:
    """The budget to use when no explicit `--timeout` was given: the
    environment override when it is usable, otherwise the built-in default."""
    resolve_timeout_secs("", env_get("SIMPLE_TIMEOUT_SECONDS") ?? "")

export CLIENT_DEFAULT_TIMEOUT_SECS
export TIMEOUT_UNLIMITED_SECS
export parse_env_timeout_secs
export timeout_value_is_well_formed
export timeout_secs_from_value
export resolve_timeout_secs
export client_default_timeout_secs
