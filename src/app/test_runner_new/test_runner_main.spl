pub fn generate_spipe_docs_for_results(results: [TestFileResult], options: TestOptions, binary: text = "bin/simple") -> i64:
    if options.format != "doc" or options.list or options.list_ignored:
        return 0

    var docgen_args: [text] = ["spipe-docgen"]
    for result in results:
        if result.cached or not result.is_ok():
            continue
        if not result.path.ends_with("_spec.spl"):
            continue
        if result.path.contains("/.spipe_matchers_") or result.path.contains("/.sspec_wrapped_entry_"):
            continue
        docgen_args.push(result.path)

    if docgen_args.len() <= 1:
        return 0

    docgen_args.push("--output")
    docgen_args.push("doc/06_spec")
    docgen_args.push("--no-index")
    val (stdout, stderr, code) = process_run_bounded(binary, docgen_args, 600000, TEST_OUTPUT_CAPTURE_BYTES)
    val spec_count = docgen_args.len() - 4
    if code == 0:
        if options.verbose:
            print "Generated SPipe manual docs for {spec_count} spec file(s)"
    else:
        print "ERROR: spipe-docgen failed for {spec_count} spec file(s)"
        if options.verbose:
            print stderr
        return 3
    0

# Discover test files across EVERY requested target, not just the first.
#
# `simple test a/ b/` used to discover only `a/` because parse_test_args kept a
# single scalar path; the remaining targets were dropped with no diagnostic.
# Discovery now unions all of them, and the per-target counts are reported so a
# target that contributes nothing is visible in the log rather than silent.
fn spec_timeout_secs_directive(file_path: text) -> i64:
    """Parse `# @timeout_secs <N>` from a spec header (0 when absent/invalid).

    Mirrors test_runner_single.spl / test_runner_client.spl. Raw scan rather
    than index_of for the same reason those do it: Option<i64> value 3 reads
    as None on the seed-JIT flat-i64 path."""
    val content = file_read(file_path) ?? ""
    val key = "# @timeout_secs "
    val klen = key.len()
    val n = content.len()
    var idx = -1
    var i = 0
    while i + klen <= n:
        if content[i:i + klen] == key:
            idx = i
            break
        i = i + 1
    if idx < 0:
        return 0
    var pos = idx + klen
    var value: i64 = 0
    var digits = 0
    while pos < n:
        val c = content.char_code_at(pos)
        if c >= 48 and c <= 57:
            value = value * 10 + (c - 48)
            digits = digits + 1
            pos = pos + 1
        else:
            break
    if digits == 0:
        return 0
    value

fn discover_all_requested_files(options: TestOptions, use_cache: bool) -> [text]:
    val requested = if options.paths.len() > 0: options.paths else: [options.path]
    if requested.len() == 1:
        return discover_test_files_fast(requested[0], options, use_cache)
    var all_files: [text] = []
    # contains_key + bracket assign only: Dict.len()/.get() are unreliable
    # under native codegen (doc/07_guide/language/dict_native_pitfalls.md).
    var seen: dict<text, bool> = {}
    for rp in requested:
        val found = discover_test_files_fast(rp, options, use_cache)
        var added = 0
        for f in found:
            if not seen.contains_key(f):
                seen[f] = true
                all_files.push(f)
                added = added + 1
        print "  target {rp}: {found.len()} test file(s) discovered, {added} new"
    print "Requested {requested.len()} target(s); {all_files.len()} distinct test file(s) to run."
    all_files

fn run_tests(options: TestOptions) -> TestRunResult:
    # CI mode override (config already loaded by main(), use options.ci_mode)
    # Apply CI mode overrides
    var updated_options = options
    if options.ci_mode:
        updated_options.run_all = true
        updated_options.fail_fast = false
        updated_options.verbose = true
        print "CI mode enabled (via --ci flag)"
        print ""

    # Unstable mode: run to the END of the test list with classified outcomes.
    # Default ON for the bootstrap path, OFF for ordinary interactive runs;
    # `--unstable` / `--no-unstable` override in both directions.
    # Bootstrap detection reuses the EXISTING marker, not a new mechanism:
    # `SIMPLE_BOOTSTRAP=1` is exported by scripts/bootstrap/bootstrap-from-scratch.sh
    # and by every stage-3 driver, and is already read across the compiler
    # (e.g. src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl).
    val bootstrap_path = (env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
    var unstable_origin = "interactive default"
    if options.unstable_mode_set:
        updated_options.unstable_mode = options.unstable_mode
        unstable_origin = if options.unstable_mode: "--unstable" else: "--no-unstable"
    else:
        updated_options.unstable_mode = bootstrap_path
        if bootstrap_path:
            unstable_origin = "bootstrap default"
    val unstable_state = if updated_options.unstable_mode: "ON" else: "OFF"
    # The mode must be visible: today the keep-going behaviour is an emergent
    # property of a default, so a human cannot tell which mode actually ran.
    print "Unstable mode: {unstable_state} ({unstable_origin})"
    if updated_options.unstable_mode:
        # Explicit, not emergent — run to the end of the test list.
        updated_options.fail_fast = false
    print ""

    # MEMORY DEBUG: checkpoint disabled (GROUP 6)
    # Load checkpoint if resuming
    # var ckpt_loaded = false
    var ckpt_passed = 0
    var ckpt_failed = 0
    var ckpt_skipped = 0

    # Handle --manifest-status: show manifest info and exit
    if updated_options.manifest_status:
        val manifest = manifest_load(MANIFEST_PATH)
        val fresh = manifest_is_fresh(manifest)
        val fresh_str = if fresh: "fresh" else: "stale"
        print "Manifest: {MANIFEST_PATH}"
        print "  Status: {fresh_str}"
        val manifest_entries = manifest.entries
        val manifest_sdoctest = manifest.sdoctest_entries
        print "  Entries: {manifest_entries.len()} test files"
        print "  Sdoctest: {manifest_sdoctest.len()} files"
        print "  Scan timestamp: {manifest.scan_timestamp}"
        return TestRunResult(files: [], total_passed: 0, total_failed: 0, total_skipped: 0, total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0, total_cached: 0)

    # Handle --refresh-manifest: force full rescan before running
    if updated_options.refresh_manifest:
        print "Refreshing test manifest..."
        var scan_dirs: [text] = ["test/"]
        if updated_options.path != "test/" and updated_options.path != "test":
            scan_dirs = [updated_options.path]
        val fresh_manifest = manifest_full_scan(scan_dirs)
        manifest_save(fresh_manifest, MANIFEST_PATH)
        val fresh_entries = fresh_manifest.entries
        val fresh_sdoctest = fresh_manifest.sdoctest_entries
        print "  Indexed {fresh_entries.len()} test files, {fresh_sdoctest.len()} sdoctest files"
        print ""

    # Session env setup starts here — this time is tracked separately
    val session_setup_start = time_now_unix_micros()

    # Phase timings for session setup. Emitted as they COMPLETE, not batched
    # into the single trailing "Session setup: Nms" line, because that line is
    # printed only after every phase is done -- on a slow tree that is minutes
    # of total silence, which three separate lanes on 2026-08-17 mistook for a
    # hang and killed while the run was healthy. A phase line the moment each
    # phase ends is what distinguishes "slow" from "dead".
    val use_cache = not updated_options.no_cache
    # BEGIN marker, not just the completion line below: measured 2026-08-17, a
    # one-file directory target sat >10min with `AFTER_PARSE_ARGS` as its last
    # output and never reached the completion line, so a completion-only timer
    # reports nothing at all for exactly the runs that need it most. The begin
    # marker is what tells an operator which phase is in progress.
    print "  [setup] discover: begin (target: {updated_options.path})"
    val _t_discover_start = time_now_unix_micros()
    val all_files = discover_all_requested_files(updated_options, use_cache)
    val _t_discover_ms = (time_now_unix_micros() - _t_discover_start) / 1000
    print "  [setup] discover: {_t_discover_ms}ms ({all_files.len()} file(s))"

    # Validate # @cover annotations for system tests
    if not updated_options.no_cover_check:
        val _t_cover_start = time_now_unix_micros()
        val missing_covers = validate_system_test_covers(all_files)
        val _t_cover_ms = (time_now_unix_micros() - _t_cover_start) / 1000
        print "  [setup] cover-check: {_t_cover_ms}ms"
        if missing_covers.len() > 0:
            print ""
            print "ERROR: System test(s) missing required # @cover annotation:"
            for mc in missing_covers:
                print "  {mc}"
            print ""
            print "Add at the top of each file:"
            print "  # @cover src/path/to/component.spl 80%"
            print ""
            print "Bypass: --no-cover-check"
            print "Found {missing_covers.len()} system test(s) without # @cover."
            return TestRunResult(files: [], total_passed: 0, total_failed: missing_covers.len(), total_skipped: 0, total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0, total_cached: 0)

    # MEMORY DEBUG: checkpoint filtering disabled (GROUP 6)
    var files = all_files
    # if options.resume and checkpoint_exists():
    #     val ckpt = checkpoint_load()
    #     ckpt_loaded = true
    #     ckpt_passed = ckpt.total_passed
    #     ckpt_failed = ckpt.total_failed
    #     ckpt_skipped = ckpt.total_skipped
    #     files = checkpoint_skip_completed(all_files, ckpt)
    #     print "Resuming from checkpoint (reason: {ckpt.shutdown_reason})"
    #     print "Previous progress: {ckpt_passed} passed, {ckpt_failed} failed, {ckpt_skipped} skipped"
    #     print ""

    if options.list:
        print_discovery_summary(files, options)
        return TestRunResult(files: [], total_passed: 0, total_failed: 0, total_skipped: 0, total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0, total_cached: 0)

    if files.len() == 0:
        print "No test files found in {options.path}"
        return TestRunResult(files: [], total_passed: 0, total_failed: 0, total_skipped: 0, total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0, total_cached: 0)

    if options.coverage:
        setup_coverage()

    # Propagate env vars
    propagate_env_vars(options)

    # MEMORY DEBUG: container mode disabled (GROUP 3)
    # val exec_mode = options.execution_mode
    # val is_container_seq1 = exec_mode == "container-seq"
    # val is_container_seq2 = exec_mode == "container_seq"
    # val is_container_seq3 = exec_mode == "container-sequential"
    # val is_container_seq = is_container_seq1 or is_container_seq2 or is_container_seq3
    # if is_container_seq or options.container_sequential:
    #     return run_tests_sequential_containers(files, options)

    # Session-daemon mode: route every test through the daemon. Direct execution
    # is only for daemon-owned child invocations using --no-session-daemon.
    val config = load_test_config()
    val session_enabled = updated_options.session_daemon or updated_options.session_share
    val show_session_debug = updated_options.session_debug or config.session_debug
    if session_enabled:
        val daemon_config = _make_daemon_config(updated_options, config)
        val daemon_ok = test_daemon_ensure_responsive(daemon_config)
        if daemon_ok:
            if show_session_debug:
                print "  [session] Routing {files.len()} test(s) through daemon"
            val daemon_results = run_tests_via_daemon(files, updated_options, daemon_config)
            for dr in daemon_results:
                print_result(dr, updated_options.format)
            return reconcile_discovered_vs_executed(files, summarize_test_results(daemon_results), false)
        else:
            # Daemon could not start/respond (e.g. stale pidfile, light_daemon
            # IPC mismatch). Fall back to direct execution instead of failing the
            # whole run 0/N — the parallel path below has its own resource
            # governor. Mirrors test_runner_client.spl's "running directly".
            print "WARNING: test daemon unavailable; running directly [fallback]"

    # Sequential flag overrides parallel
    if updated_options.sequential:
        updated_options.parallel = false

    # Parallel execution with resource governor
    if updated_options.parallel:
        if not is_linux():
            print "WARNING: --parallel is experimental on non-Linux platforms. Attempting with graceful fallback."
        val parallel_result = run_tests_parallel_mode(
            files,
            updated_options,
            ckpt_passed: ckpt_passed,
            ckpt_failed: ckpt_failed,
            ckpt_skipped: ckpt_skipped
        )
        return reconcile_discovered_vs_executed(files, parallel_result, false)

    report_free_mem("BEFORE_TEST_LOOP")
    val mode_name = mode_to_str(updated_options.mode)
    var fork_label = ""
    if updated_options.fork_mode:
        fork_label = ", fork"
    print "Running {files.len()} test file(s) [mode: {mode_name}{fork_label}]..."
    if updated_options.seed_set:
        print "Seed: {updated_options.seed}"
    if updated_options.self_protect:
        val free_cpu = 100.0 - updated_options.cpu_threshold
        val free_mem = 100.0 - updated_options.mem_threshold
        print "Self-protection enabled (stops when free CPU < {free_cpu}% AND free RAM < {free_mem}%)"
    if updated_options.max_mem_gb > 0 and not updated_options.no_limits:
        print "  Max memory per test: {updated_options.max_mem_gb}GB"

    # Load change-detection cache (skip if --clean)
    val cache_path = ".simple/test-result-cache.sdn"
    var incremental_state = incremental_test_state_new(cache_path, "", false)
    var use_result_cache = false
    if use_result_cache:
        incremental_state = incremental_test_state_load(cache_path, "", false)
    else:
        print "Change-detection cache bypassed (--clean)"

    # Smart test ordering: sort longest-first to avoid tail blockers
    if use_result_cache:
        files = order_tests_by_duration(files, incremental_state.entries)

    # Session env setup complete — record setup time
    val session_setup_end = time_now_unix_micros()
    val session_setup_ms = (session_setup_end - session_setup_start) / 1000
    if session_setup_ms > 0:
        print "Session setup: {session_setup_ms}ms"

    print ""

    var results: [TestFileResult] = []
    var total_passed = ckpt_passed
    var total_failed = ckpt_failed
    var total_skipped = ckpt_skipped
    var total_pending = 0
    var total_timed_out = 0
    var total_duration_ms = 0
    var total_setup_ms = session_setup_ms
    var total_cached = 0
    var completed_files: [text] = []
    var tests_run = 0
    var stopped_early = false

    for file_path in files:
        # Only check system thresholds every 20 tests (avoids 100ms CPU sleep per check)
        if updated_options.self_protect and tests_run % 20 == 0:
            val (violated, reason) = system_exceeds_threshold(updated_options.cpu_threshold, updated_options.mem_threshold)
            if violated:
                shutdown_graceful(reason, completed_files, total_passed, total_failed, total_skipped)

        if updated_options.self_protect and tests_run % 50 == 0 and tests_run > 0:
            checkpoint_save(completed_files, total_passed, total_failed, total_skipped, "periodic")

        # Check change-detection cache before running.
        # EXCEPTION: system specs (test/03_system/*) MUST actually execute their
        # `it{}` bodies — they drive QEMU guests, capture framebuffers, and
        # check serial markers. The change-detection cache would replay a
        # silent PASSED (0ms) from an earlier interpreter-mode load, hiding
        # real regressions. Route system specs through the real execution
        # path instead. Mirrors the Rust seed `is_system_spec` bypass in
        # src/compiler_rust/driver/src/cli/test_runner/runner.rs.
        if use_result_cache and not file_path.contains("test/03_system/"):
            val cached_entry = incremental_state.check_freshness(file_path)
            if cached_entry.result_status != -1:
                val cached_result = TestFileResult(
                    path: file_path,
                    passed: cached_entry.passed,
                    failed: cached_entry.failed,
                    skipped: cached_entry.skipped,
                    pending: 0,
                    duration_ms: cached_entry.duration_ms,
                    setup_ms: 0,
                    error: "",
                    timed_out: false,
                    cached: true
                )
                print_result(cached_result, updated_options.format)
                total_passed = total_passed + cached_result.passed
                total_failed = total_failed + cached_result.failed
                total_skipped = total_skipped + cached_result.skipped
                total_duration_ms = total_duration_ms + cached_result.duration_ms
                total_cached = total_cached + 1
                results.push(cached_result)
                completed_files.push(file_path)
                tests_run = tests_run + 1
                continue

        # Run test
        val result = run_single_test(file_path, updated_options)
        print_result(result, updated_options.format)

        # Record result in cache (system specs skip the cache entirely so
        # a stale interpreter-mode load never replays as a silent 0ms pass)
        if use_result_cache and not file_path.contains("test/03_system/"):
            incremental_state.record_runner_result(file_path, result.passed, result.failed, result.skipped, result.duration_ms)

        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        total_setup_ms = total_setup_ms + result.setup_ms
        results.push(result)
        completed_files.push(file_path)
        tests_run = tests_run + 1

        if updated_options.fail_fast and (result.failed > 0 or result.timed_out):
            print ""
            print "Stopping early (--fail-fast)"
            stopped_early = true
            break

    # Save cache
    if use_result_cache:
        incremental_state.save()

    if total_cached > 0:
        print "Skipped {total_cached} unchanged test(s) (cached)"

    # MEMORY DEBUG: checkpoint cleanup disabled (GROUP 6)
    # if options.resume and checkpoint_exists():
    #     checkpoint_delete()

    val sequential_result = TestRunResult(
        files: results,
        total_passed: total_passed,
        total_failed: total_failed,
        total_skipped: total_skipped,
        total_pending: total_pending,
        total_timed_out: total_timed_out,
        total_duration_ms: total_duration_ms,
        total_setup_ms: total_setup_ms,
        total_cached: total_cached
    )
    reconcile_discovered_vs_executed(files, sequential_result, stopped_early)

fn run_tests_parallel_mode(
    files: [text],
    options: TestOptions,
    ckpt_passed: i64,
    ckpt_failed: i64,
    ckpt_skipped: i64
) -> TestRunResult:
    val parallel_setup_start = time_now_unix_micros()
    val mode_name = mode_to_str(options.mode)

    # Load change-detection cache (skip if --clean)
    val cache_path = ".simple/test-result-cache.sdn"
    var incremental_state = incremental_test_state_new(cache_path, "", false)
    var use_result_cache = false
    if use_result_cache:
        incremental_state = incremental_test_state_load(cache_path, "", false)
    var cached_results: [TestFileResult] = []
    var uncached_files: [text] = []

    if use_result_cache:
        for file_path in files:
            # System specs (test/03_system/*) bypass the change-detection cache
            # so they always go through real execution. See the sequential
            # mode comment above for the rationale.
            if file_path.contains("test/03_system/"):
                uncached_files.push(file_path)
                continue
            val cached_entry = incremental_state.check_freshness(file_path)
            if cached_entry.result_status != -1:
                val cached_result = TestFileResult(
                    path: file_path,
                    passed: cached_entry.passed,
                    failed: cached_entry.failed,
                    skipped: cached_entry.skipped,
                    pending: 0,
                    duration_ms: cached_entry.duration_ms,
                    setup_ms: 0,
                    error: "",
                    timed_out: false,
                    cached: true
                )
                cached_results.push(cached_result)
            else:
                uncached_files.push(file_path)
    else:
        uncached_files = files

    # Smart test ordering: sort longest-first to avoid tail blockers
    if use_result_cache:
        uncached_files = order_tests_by_duration(uncached_files, incremental_state.entries)

    # Session-aware routing: if --session-daemon, route session tests through daemon
    # CLI flags OR SDN config can enable session sharing
    val par_config = load_test_config()
    val par_session_enabled = options.session_daemon or options.session_share
    val par_session_debug = options.session_debug or par_config.session_debug
    var daemon_results: [TestFileResult] = []
    var session_routed: i64 = 0
    if par_session_enabled:
        val daemon_config = _make_daemon_config(options, par_config)
        val daemon_ok = test_daemon_ensure_responsive(daemon_config)
        if daemon_ok:
            val (regular_files, session_files) = separate_session_tests(uncached_files)
            if session_files.len() > 0:
                # Build schedule for optimal ordering
                var session_metas: [TestSessionMeta] = []
                for sf in session_files:
                    session_metas.push(classify_test_session(sf))
                val schedule = schedule_session_tests(session_metas)
                val ordered_session_files = schedule_session_file_paths(schedule)
                if par_session_debug:
                    print "  [session] {schedule_summary(schedule)}"
                    print "  [session] {ordered_session_files.len()} session-capable test(s) routed to daemon"
                daemon_results = run_tests_via_daemon(ordered_session_files, options, daemon_config)
                session_routed = ordered_session_files.len()
            uncached_files = regular_files
        else:
            if par_session_debug:
                print "  [session] Daemon unavailable, falling back to direct execution"

    # Separate QEMU and normal tests from uncached files
    val (normal_files, qemu_files) = separate_qemu_tests(uncached_files)

    # Determine worker count
    var max_workers = options.max_workers
    if max_workers <= 0:
        max_workers = get_cpu_count() * options.resource_limit_pct / 100
        if max_workers < 1:
            max_workers = 1
        # Cap auto-detected worker count to prevent process explosion on
        # high-core machines. Each worker spawns shell + simple binary (2
        # processes), so 8 workers = up to 16 OS processes at peak.
        # Use --max-workers=N to override explicitly.
        if max_workers > 8:
            max_workers = 8

    val parallel_setup_end = time_now_unix_micros()
    val parallel_setup_ms = (parallel_setup_end - parallel_setup_start) / 1000

    val total_cached = cached_results.len()
    print "Running {files.len()} test file(s) in parallel [mode: {mode_name}, workers: {max_workers}]"
    if parallel_setup_ms > 0:
        print "  Session setup: {parallel_setup_ms}ms"
    if total_cached > 0:
        print "  Cached: {total_cached}, to run: {uncached_files.len()}"
    if session_routed > 0:
        print "  Session-routed: {session_routed}"
    if qemu_files.len() > 0:
        print "  Normal tests: {normal_files.len()}, QEMU tests: {qemu_files.len()}"
    print ""

    # Print cached results first
    for cached_r in cached_results:
        print_result(cached_r, options.format)

    # Run normal files via parallel runner with resource governor
    val normal_results = run_tests_parallel_with_monitoring(normal_files, options, max_workers)

    # Run QEMU files via session-sharing runner
    val qemu_results = run_qemu_tests_all(qemu_files, options)

    # Combine results
    var total_passed = ckpt_passed
    var total_failed = ckpt_failed
    var total_skipped = ckpt_skipped
    var total_pending = 0
    var total_timed_out = 0
    var total_duration_ms = 0
    var all_results: [TestFileResult] = []

    # Add cached results
    for cached_r in cached_results:
        total_passed = total_passed + cached_r.passed
        total_failed = total_failed + cached_r.failed
        total_skipped = total_skipped + cached_r.skipped
        total_duration_ms = total_duration_ms + cached_r.duration_ms
        all_results.push(cached_r)

    for result in normal_results:
        print_result(result, options.format)
        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        all_results.push(result)

        # Record result in cache (system specs skip caching — see sequential mode)
        if use_result_cache and not result.path.contains("test/03_system/"):
            incremental_state.record_runner_result(result.path, result.passed, result.failed, result.skipped, result.duration_ms)

    for result in qemu_results:
        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        all_results.push(result)

    # Add daemon session results
    for result in daemon_results:
        print_result(result, options.format)
        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        all_results.push(result)

        if use_result_cache and not result.path.contains("test/03_system/"):
            incremental_state.record_runner_result(result.path, result.passed, result.failed, result.skipped, result.duration_ms)

    # Save cache
    if use_result_cache:
        incremental_state.save()

    if total_cached > 0:
        print "Skipped {total_cached} unchanged test(s) (cached)"

    TestRunResult(
        files: all_results,
        total_passed: total_passed,
        total_failed: total_failed,
        total_skipped: total_skipped,
        total_pending: total_pending,
        total_timed_out: total_timed_out,
        total_duration_ms: total_duration_ms,
        total_setup_ms: parallel_setup_ms,
        total_cached: total_cached
    )

fn run_single_test(file_path: text, options: TestOptions) -> TestFileResult:
    if is_skip_marker_file(file_path):
        val skipped = count_skip_marker_cases(file_path)
        return TestFileResult(path: file_path, passed: 0, failed: 0, skipped: skipped, pending: 0, duration_ms: 0, setup_ms: 0, error: "", timed_out: false, cached: false)

    # Set runtime mode env var so skip_it/skip_on_interpreter can detect mode
    val mode_str = mode_to_str(options.mode)
    env_set("SIMPLE_RUNTIME_MODE", mode_str)
    if options.assert_ran:
        env_set("SIMPLE_TEST_ASSERT_RAN", "1")
    else:
        env_set("SIMPLE_TEST_ASSERT_RAN", "0")

    # DI system test lock: block DI modifications in system tests unless @di_test
    val is_system = file_path.contains("/system/") or file_path.contains("/feature/")
    if is_system:
        env_set("SIMPLE_SYSTEM_TEST", "1")
    else:
        env_set("SIMPLE_SYSTEM_TEST", "0")
    if is_system and file_has_di_test_tag(file_path):
        env_set("SIMPLE_DI_TEST", "1")
    else:
        env_set("SIMPLE_DI_TEST", "0")

    # Override timeout for advanced testing modes
    var effective_options = options
    if options.fuzz_mode:
        val fuzz_timeout = options.fuzz_time_secs + 30
        if fuzz_timeout > effective_options.timeout:
            effective_options.timeout = fuzz_timeout
    if options.chaos_mode:
        var chaos_timeout = options.chaos_trials * 2
        if chaos_timeout < 300:
            chaos_timeout = 300
        if chaos_timeout > effective_options.timeout:
            effective_options.timeout = chaos_timeout
    if file_has_slow_test(file_path) and effective_options.timeout < 600:
        effective_options.timeout = 600
    # `# @timeout_secs <N>` header directive — mirrors
    # test_runner_single.spl/test_runner_client.spl. Raise-only: a spec whose
    # honest run exceeds even the slow_it 600s floor declares what it needs,
    # instead of being killed mid-run and reporting no verdict line at all.
    val declared_timeout = spec_timeout_secs_directive(file_path)
    if declared_timeout > effective_options.timeout:
        effective_options.timeout = declared_timeout

    val monitor_timeout = env_get("SIMPLE_TIMEOUT_SECONDS") ?? ""
    # to_int("") throws, and the interpreter evaluates both sides of `and`,
    # so the unset case MUST be split out before any to_int call — the
    # combined condition broke every `simple test` run when the var was
    # unset. Unset means the monitor may use a lower default, so set it.
    if monitor_timeout == "":
        env_set("SIMPLE_TIMEOUT_SECONDS", "{effective_options.timeout}")
    elif monitor_timeout != "0":
        if (monitor_timeout.to_int() ?? 0) < effective_options.timeout:
            env_set("SIMPLE_TIMEOUT_SECONDS", "{effective_options.timeout}")

    # G1: Use safe mode with resource limits when enabled
    if effective_options.safe_mode:
        return run_test_file_safe_mode(file_path, effective_options)
    match effective_options.mode:
        case TestExecutionMode.Interpreter:
            run_test_file_interpreter(file_path, effective_options)
        case TestExecutionMode.Smf:
            run_test_file_smf(file_path, effective_options)
        case TestExecutionMode.Native:
            run_test_file_native(file_path, effective_options)
        case TestExecutionMode.Compile:
            run_test_file_compile(file_path, effective_options)
        case TestExecutionMode.Composite(spec):
            run_test_file_composite(file_path, effective_options, spec)

# =========================================================================
# Session Config Propagation
# =========================================================================

fn _make_daemon_config(options: TestOptions, config: TestConfig) -> TestDaemonConfig:
    """
    Builds a TestDaemonConfig merging SDN config and CLI overrides.
    CLI flags take precedence over SDN settings.
    """
    var dc = test_daemon_config_default()
    # Apply SDN config
    dc.session_share = config.session_share
    dc.session_daemon = config.session_daemon
    dc.session_idle_timeout_ms = config.session_idle_timeout_ms
    dc.session_startup_timeout_ms = config.session_startup_timeout_ms
    # CLI overrides SDN
    if options.session_share:
        dc.session_share = true
    if options.session_daemon:
        dc.session_daemon = true
        dc.session_share = true
    if options.max_sessions > 0:
        dc.max_qemu_sessions = options.max_sessions
    # `--timeout N` must govern the session STARTUP wall too, not just the
    # per-file run budget. Previously session_startup_timeout_ms stayed pinned
    # at its SDN value (default 60000) no matter what --timeout said, so a spec
    # whose module-level `val`s took longer than 60s to evaluate was cut off
    # mid-startup and reported "no examples executed" — and raising --timeout
    # did nothing to help, because the flag never reached this field. A startup
    # wall TIGHTER than the declared per-file budget is never what the caller
    # asked for, so take the larger of the two.
    val requested_startup_ms = options.timeout * 1000
    if requested_startup_ms > dc.session_startup_timeout_ms:
        dc.session_startup_timeout_ms = requested_startup_ms
    dc

# =========================================================================
# Session-Aware Daemon Execution
# =========================================================================

fn run_tests_via_daemon(
    files: [text],
    options: TestOptions,
    daemon_config: TestDaemonConfig
) -> [TestFileResult]:
    """
    Runs tests through the test daemon, which manages session sharing.
    Falls back to direct execution if daemon is unavailable.
    """
    var results: [TestFileResult] = []
    # `--no-cache` must bypass the daemon's own incremental result cache, not
    # just file-discovery caching (that's the separate `use_cache` check in
    # run_test_cli above). Before this fix, `clean` was `options.clean` alone
    # (the explicit `--clean` flag), so a `--no-cache` request still hit
    # handle_run_single's freshness check and got a stale TRESP_CACHED replay
    # of whatever an EARLIER daemon-served run recorded (e.g. a genuine
    # timeout from a slow render) -- fast (cache lookup only, no re-execution)
    # and, per the bug below, silently missing its own diagnostic text. See
    # doc/08_tracking/bug/wm_showcase_session_capture_spec_no_examples_executed_2026-08-06.md.
    val clean = options.clean or options.no_cache

    if options.session_debug:
        print "  [session] Routing {files.len()} test(s) through daemon"

    for file_path in files:
        val start_time = time_now_unix_micros()

        # Submit to daemon and wait for result
        val daemon_result = test_submit_and_wait(file_path, daemon_config, clean, options.timeout * 1000)
        val duration_ms = (time_now_unix_micros() - start_time) / 1000

        if daemon_result.status == TRESP_COMPLETED or daemon_result.status == TRESP_FAILED or daemon_result.status == TRESP_CACHED:
            val result = TestFileResult(
                path: file_path,
                passed: daemon_result.passed,
                failed: daemon_result.failed,
                skipped: daemon_result.skipped,
                pending: 0,
                duration_ms: if daemon_result.duration_ms > 0: daemon_result.duration_ms else: duration_ms,
                setup_ms: 0,
                # A TRESP_CACHED replay of a stale FAILED run must not go
                # silent: before this fix only TRESP_FAILED copied `.output`
                # into `.error`, so a cached failure (daemon_result.failed >
                # 0) displayed as a bare "0 passed, 1 failed" with no `Error:`
                # line at all -- the exact "no examples executed, zero
                # diagnostic output" symptom in the bug doc referenced above.
                error: if daemon_result.status == TRESP_FAILED or (daemon_result.status == TRESP_CACHED and daemon_result.failed > 0): daemon_result.output else: "",
                timed_out: false,
                cached: daemon_result.cached
            )
            results.push(result)

            if options.session_debug:
                val cached_str = if daemon_result.cached: " (cached)" else: ""
                print "  [session] {file_path}: {daemon_result.passed}p {daemon_result.failed}f{cached_str}"
        else:
            val failed_result = TestFileResult(
                path: file_path,
                passed: 0,
                failed: 1,
                skipped: 0,
                pending: 0,
                duration_ms: duration_ms,
                setup_ms: 0,
                error: "daemon returned unexpected status",
                timed_out: false,
                cached: false
            )
            results.push(failed_result)

        if options.fail_fast:
            val last = results[results.len() - 1]
            if last.failed > 0 or last.timed_out:
                break

    results

fn reconcile_discovered_vs_executed(
    discovered: [text],
    result: TestRunResult,
    stopped_early: bool
) -> TestRunResult:
    """Fail-closed accounting: every discovered spec file must produce a result.

    A directory run that returns fewer file results than files discovered has
    silently truncated coverage — the historical failure mode where an abort
    part-way through a directory still printed a clean `Results:` line for the
    subset that happened to run. Print the discovered/executed pair on EVERY
    run so the gap is visible, and turn each unaccounted-for file into a
    counted failure so a truncated run can never read green.

    `stopped_early` marks a deliberate stop (--fail-fast). It is still
    reported, but it is not re-counted as extra failures.
    """
    var executed_paths: {text: bool} = {}
    for r in result.files:
        executed_paths[r.path] = true

    var missing: [text] = []
    for f in discovered:
        if not executed_paths.contains_key(f):
            missing.push(f)

    val discovered_n = discovered.len()
    val executed_n = discovered_n - missing.len()
    print ""
    print "Files:   {discovered_n} discovered, {executed_n} executed"

    if missing.len() == 0:
        return result

    if stopped_early:
        print "         {missing.len()} not executed (stopped early by --fail-fast)"
        return result

    print ""
    print "ERROR: {missing.len()} discovered test file(s) produced NO result."
    print "       A directory run must never silently skip files; each is counted as failed."
    var shown = 0
    for m in missing:
        if shown < 25:
            print "  NOT EXECUTED  {m}"
        shown = shown + 1
    if missing.len() > 25:
        print "  ... and {missing.len() - 25} more"
    print ""

    var augmented = result.files
    for m in missing:
        augmented.push(TestFileResult(
            path: m,
            passed: 0,
            failed: 1,
            skipped: 0,
            pending: 0,
            duration_ms: 0,
            setup_ms: 0,
            error: "NOT EXECUTED: discovered but never run (truncated test run)",
            timed_out: false,
            cached: false
        ))

    TestRunResult(
        files: augmented,
        total_passed: result.total_passed,
        total_failed: result.total_failed + missing.len(),
        total_skipped: result.total_skipped,
        total_pending: result.total_pending,
        total_timed_out: result.total_timed_out,
        total_duration_ms: result.total_duration_ms,
        total_setup_ms: result.total_setup_ms,
        total_cached: result.total_cached
    )

fn emit_spec_file_verdicts(results: [TestFileResult]):
    """
    Emit one `SPEC FILE VERDICT:` line per file for the AGGREGATING lane.

    This is the directory-lane half of the fail-open that 0ff267a366a closed
    only for single files. `bin/simple test <dir>` builds TestFileResult records
    and prints its own `PASS`/`FAIL` summary lines; it never routed through
    test_runner_single's zero-executed branch, so it emitted no verdict lines at
    all -- measured on test/01_unit/lib/blink: 24 files, exit 1, ZERO verdict
    lines, while the same spec run singly emitted exactly one. Every sweep that
    counts verdict lines rather than exit codes was therefore blind to the whole
    directory, which is how 24 unresolvable modules stayed invisible for weeks.

    ONE emission site, delegating every classification decision to
    light_protocol -- the module both runner lanes already import. Nothing here
    re-derives a reason token or re-formats a verdict; adding a third
    independent emitter is what would let the lanes drift apart again.
    """
    for r in results:
        if r.timed_out:
            print timeout_verdict_line(r.path, "aggregate-lane-timeout", r.duration_ms)
        elif r.error != "" and is_load_failure(r.error):
            # Declared examples, loaded nothing. `executed=0 dropped=1` keeps
            # the file RED under the existing `dropped == 0` greenwash gate.
            print unrun_verdict_line(r.path, unrun_reason(r.error))
        else:
            print ran_verdict_line(r.path, r.passed, r.failed)

fn summarize_test_results(results: [TestFileResult]) -> TestRunResult:
    var total_passed = 0
    var total_failed = 0
    var total_skipped = 0
    var total_pending = 0
    var total_timed_out = 0
    var total_duration_ms = 0
    var total_setup_ms = 0
    var total_cached = 0
    for result in results:
        total_passed = total_passed + result.passed
        total_failed = total_failed + result.failed
        total_skipped = total_skipped + result.skipped
        total_pending = total_pending + result.pending
        if result.timed_out:
            total_timed_out = total_timed_out + 1
        total_duration_ms = total_duration_ms + result.duration_ms
        total_setup_ms = total_setup_ms + result.setup_ms
        if result.cached:
            total_cached = total_cached + 1
    TestRunResult(files: results, total_passed: total_passed, total_failed: total_failed, total_skipped: total_skipped, total_pending: total_pending, total_timed_out: total_timed_out, total_duration_ms: total_duration_ms, total_setup_ms: total_setup_ms, total_cached: total_cached)

# =========================================================================
# Main Entry Point
# =========================================================================

fn run_test_cli() -> i64:
    report_free_mem("START")
    # Start resource safeguard before any test discovery or execution.
    ensure_kill_monitor_running()
    val all_args = get_cli_args()
    var args: [text] = []
    var json_worker = false
    var i = if all_args.len() > 0 and all_args[0] == "test": 1 else: 0
    var marker = -1
    var scan = 0
    while scan < all_args.len():
        if all_args[scan] == "--test-json-worker":
            marker = scan
            break
        scan = scan + 1
    if marker >= 0:
        if env_get("SIMPLE_TEST_JSON_WORKER_AUTH") != "1":
            print "ERROR: unauthorized private test JSON worker marker"
            return 2
        env_set("SIMPLE_TEST_JSON_WORKER_AUTH", "")
        json_worker = true
        i = marker + 1
    while i < all_args.len():
        args.push(all_args[i])
        i = i + 1

    # Handle run management commands (status/stop/etc.)
    if has_run_management_flag(args):
        return handle_run_management(args)

    val args_error = test_args_validation_error(args)
    if args_error != "":
        print "Error: {args_error}"
        return 2

    val options = parse_test_args(args)
    report_free_mem("AFTER_PARSE_ARGS")

    # Load test configuration to determine what to run
    val config = load_test_config()
    var run_spec = config.run_spec_tests
    var run_sdoc = config.run_sdoctests
    var run_spl_doc = config.run_spl_doctests

    if options.sdoctest:
        run_sdoc = true

    # A target that is explicitly a markdown file has no other meaning to this
    # runner (unlike a bare .spl target, which already means "run this spec"),
    # so naming one directly is an unambiguous request to run its sdoctest
    # fences — mirrors --spl-doctest's explicit-flag requirement for .spl
    # targets, where the extension alone is ambiguous with a normal spec run.
    # Also skip the spec lane entirely for a .md target: it can never match a
    # *_spec.spl/_test.spl file, so running it only prints a confusing "No
    # test files found" and (worse) still exercises update_test_database's
    # DB-write path for a target that was never asking for it.
    if options.path.ends_with(".md"):
        run_sdoc = true
        run_spec = false

    if options.spl_doctest:
        run_spl_doc = true

    var spec_result = TestRunResult(files: [], total_passed: 0, total_failed: 0, total_skipped: 0, total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0, total_cached: 0)
    var spl_doctest_result = SdoctestRunResult(files: [], total: 0, passed: 0, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 0)
    var sdoctest_result = SdoctestRunResult(files: [], total: 0, passed: 0, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 0)

    if not run_spec and not run_sdoc and not run_spl_doc:
        print "Error: No test types enabled. Check config/simple.test.sdn configuration."
        print "  run_spec_tests: {config.run_spec_tests}"
        print "  run_sdoctests: {config.run_sdoctests}"
        print "  run_spl_doctests: {config.run_spl_doctests}"
        if json_worker:
            print combined_test_run_json(false, false, spec_result, false, spl_doctest_result, false, sdoctest_result)
        return 1

    propagate_env_vars(options)

    var exit_code = 0
    var db: Result<RunnerTestDb, text> = Err("not_run")

    # Run spec tests with self-protection enabled in run_tests()
    if run_spec:
        print "Simple Test Runner v0.8.1"
        print ""

        val run_start = time_now_unix_micros()
        spec_result = run_tests(options)
        val run_end = time_now_unix_micros()
        val spec_exit_code = test_run_outcome_exit_code(classify_test_run_result(spec_result, test_empty_selection_is_success(options)))

        val result_files = spec_result.files
        report_free_mem("AFTER_RUN_{result_files.len()}_files")
        if generate_spipe_docs_for_results(result_files, options) != 0:
            return 3
        if not json_worker:
            emit_spec_file_verdicts(result_files)
            print_summary(spec_result, options.format)

        if options.coverage:
            val coverage = collect_coverage()
            if not json_worker:
                print_coverage_summary(coverage)
            generate_coverage_reports(coverage)
            print_coverage_delta(coverage)
            val threshold = get_coverage_threshold()
            if threshold > 0 and not check_coverage_threshold(coverage, threshold):
                exit_code = 1
            var coverage_test_files: [text] = []
            for result_file in result_files:
                coverage_test_files.push(result_file.path)
            if not options.no_cover_check and not check_cover_annotation_thresholds(coverage, coverage_test_files):
                exit_code = 1

        # Persist test results to database and regenerate reports
        if result_files.len() > 0 and not options.list and not options.no_db:
            db = update_test_database(spec_result, run_start, run_end)

        # Name every spec that produced no verdict. Absence of a result must
        # never read as success, and an unnamed non-zero exit is nearly as hard
        # to act on as a silent green. R3, supervised_test_runner.md.
        if spec_exit_code == 5:
            for unverified_file in result_files:
                if test_file_result_is_unverified(unverified_file):
                    val why = unverified_file.error
                    if why == "":
                        print "  UNVERIFIED  {unverified_file.path}: child produced no result line"
                    else:
                        print "  UNVERIFIED  {unverified_file.path}: {why}"
            print "ERROR — nothing was verified: spec produced no verdict (unverified, not a pass)"

        if spec_exit_code != 0:
            exit_code = spec_exit_code

    # spl_doctest execution (complement to sdoctest)
    var spl_doctest_passed = 0
    var spl_doctest_failed = 0
    var spl_doctest_skipped = 0
    var spl_doctest_ok = true
    if run_spl_doc:
        print "=== Running SPL Doctests ==="
        print ""
        spl_doctest_result = run_spl_doctest_mode(options, config)
        spl_doctest_passed = spl_doctest_result.passed
        spl_doctest_failed = spl_doctest_result.failed
        spl_doctest_skipped = spl_doctest_result.skipped
        spl_doctest_ok = spl_doctest_result.is_ok()
        print "SPL Doctest: {spl_doctest_passed} passed, {spl_doctest_failed} failed, {spl_doctest_skipped} skipped"
        print ""

        if not spl_doctest_ok:
            exit_code = 1

    if run_sdoc:
        val sdoctest_config = load_sdoctest_config("config/sdoctest.sdn")
        sdoctest_result = run_sdoctest_mode(options, sdoctest_config)
        print_sdoctest_summary(sdoctest_result)
        if not sdoctest_result.is_ok():
            exit_code = 1

    # Generate test_result.md from database
    match db:
        Ok(database):
            if not options.list and not options.no_db:
                val md_content = generate_test_result_md(database)
                file_atomic_write("doc/08_tracking/test/test_result.md", md_content)
        Err(_): ()  # Silent failure; database may not have been attempted

    if json_worker:
        print combined_test_run_json(
            exit_code == 0,
            run_spec,
            spec_result,
            run_spl_doc,
            spl_doctest_result,
            run_sdoc,
            sdoctest_result
        )

    exit_code

