# Pure argument validation for the authenticated SDN worker boundary.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018

pub struct PrivateSdnWorkerArgs:
    worker: bool
    result_path: text
    forwarded_args: [text]
    public_sdn_requested: bool

fn _sdn_path_valid(path: text) -> bool:
    if path == "" or path.len() > 4096 or path.starts_with("-"):
        return false
    val bytes = path.bytes()
    for byte in bytes:
        # UTF-8 continuation bytes span 0x80..0xBF; reject only ASCII
        # controls (C0 and DEL), never bytes that are part of Unicode paths.
        if byte < 32 or byte == 127:
            return false
    true

pub fn parse_private_sdn_worker_args(args: [text], authorized: bool) -> Result<PrivateSdnWorkerArgs, text>:
    if args.len() == 0:
        return Ok(PrivateSdnWorkerArgs(worker: false, result_path: "",
            forwarded_args: [], public_sdn_requested: false))
    if args.len() > 4096:
        return Err("runner argument count exceeds its bound")

    # get_cli_args() has already removed the executable/script prefix. It may
    # retain the ordinary top-level `test` verb, which main consumes itself.
    var start = 0
    if args[0] == "test": start = 1
    var worker_count = 0
    var result_count = 0
    var result_path = ""
    var public_sdn_requested = false
    var forwarded: [text] = []
    var i = start
    while i < args.len():
        val arg = args[i]
        if arg == "": return Err("runner arguments may not be empty")
        if arg == "--json" or arg == "--test-json-worker" or arg.starts_with("--json="):
            return Err("JSON test output is retired; use --sdn or --format sdn")
        if arg == "--format" and i + 1 < args.len() and args[i + 1] == "json":
            return Err("JSON test output is retired; use --format sdn")
        if arg == "--format=json":
            return Err("JSON test output is retired; use --format sdn")

        if arg == "--test-sdn-worker":
            worker_count += 1
        elif arg.starts_with("--test-sdn-result="):
            result_count += 1
            result_path = arg[18:arg.len()]
            if not _sdn_path_valid(result_path):
                return Err("private SDN result path is empty, oversized, or contains a reserved control")
        elif arg == "--sdn":
            public_sdn_requested = true
        elif arg == "--format" and i + 1 < args.len() and args[i + 1] == "sdn":
            public_sdn_requested = true
            i += 1
        else:
            if arg.starts_with("--test-sdn-result"):
                return Err("private SDN result path must use --test-sdn-result=<path>")
            forwarded.push(arg)
        i += 1

    if worker_count > 1: return Err("private SDN worker marker must appear exactly once")
    if result_count > 1: return Err("private SDN result path must appear exactly once")
    if worker_count == 0 and result_count > 0:
        return Err("private SDN result path requires the private worker marker")
    if worker_count == 1 and result_count == 0:
        return Err("private SDN worker requires --test-sdn-result=<owned-path>")
    if worker_count == 1 and not authorized:
        return Err("unauthorized private SDN worker marker")
    if worker_count == 1 and public_sdn_requested:
        return Err("public SDN flags cannot be combined with the private worker marker")

    Ok(PrivateSdnWorkerArgs(
        worker: worker_count == 1,
        result_path: result_path,
        forwarded_args: forwarded,
        public_sdn_requested: public_sdn_requested))
