# Which space-separated `simple test` flags consume the NEXT argument as their value.
#
# The single-spec client scans raw argv for positional paths. A value such as
# the `doc` in `--format doc` must not be mistaken for a spec path (it used to
# fail the run with "expected .spl test file: doc"). Keep in step with the value
# flags parsed in test_runner_args.spl.

use std.test_runner.test_runner_files.{file_has_tag}

fn client_flag_consumes_value(arg: text) -> bool:
    arg in [
        "--timeout", "--tag", "--format", "--mode", "--native-backend", "--seed",
        "--max-mem", "--worker-memory-mb", "--max-procs", "--execution-mode", "--cpu-threshold",
        "--mem-threshold", "--resource-limit", "--max-workers", "--parallel-timeout",
        "--fuzz-time", "--fuzz-corpus", "--chaos-trials", "--chaos-fault-rate",
        "--deploy-platform", "--batch-size", "--session-kind", "--max-sessions",
        "--session-reset", "--sdoctest-env", "--native-source", "--library-mode", "--profile",
        "--compiler"
    ]

export client_flag_consumes_value

fn client_select_tagged(paths: [text], tag: text) -> [text]:
    """`--tag` applies to explicit paths exactly as to a directory walk: a path
    that does not carry the tag is not selected. An empty result is an empty
    selection ("No tests selected.", exit 4), never a silent full run."""
    if tag == "":
        return paths
    var selected: [text] = []
    for p in paths:
        if file_has_tag(p, tag):
            selected.push(p)
    selected

export client_select_tagged

fn client_tag_value(args: [text]) -> text:
    """The `--tag <x>` / `--tag=<x>` value in a raw argv, "" when absent."""
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--tag" and i + 1 < args.len():
            return args[i + 1]
        if arg.starts_with("--tag="):
            return arg[6:]
        i = i + 1
    ""

export client_tag_value

# Execution-mode/backend flags that select a COMPILED lane (native, smf,
# compile, jit, ...). The single-spec client cannot honour any of them: the
# light-daemon request is path-only, and the direct lane's inner runner
# (test_runner_single.spl) always interprets. test_runner_client.spl main()
# refuses the run, naming exactly the flags returned here, instead of
# silently downgrading to the tagged interpreter and reporting PASS for a
# lane that never ran (fail-open, measured 2026-11-09: a --mode=native
# request executed in ~31 ms on the interpreter with a PASS verdict).
# Bug: test_runner_direct_lane_drops_mode_backend_flags_2026_11_09.
# Interpreter-family --mode values this lane CAN honour. Anything else —
# native, smf, compile, binary, loader, jit, a non-interpreter composite
# (native(baremetal(...)), jit(...)), or a typo the mode parser would quietly
# default to "interpreter" — is a compiled-lane request this client must not
# silently downgrade. The empty value parses to the interpreter default.
fn _mode_value_is_interpreter(value: text) -> bool:
    val v = value.trim()
    v == "" or v == "interpreter" or v.starts_with("interpreter(")

fn client_dropped_execution_flags(args: [text]) -> [text]:
    var dropped: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--compile":
            dropped.push(arg)
        elif arg.starts_with("--compile="):
            if arg.replace("--compile=", "") != "interpreter":
                dropped.push(arg)
        elif arg.starts_with("--mode="):
            if not _mode_value_is_interpreter(arg.replace("--mode=", "")):
                dropped.push(arg)
        elif arg == "--mode":
            if i + 1 < args.len():
                if not _mode_value_is_interpreter(args[i + 1]):
                    dropped.push("--mode " + args[i + 1])
                i = i + 1
        elif arg.starts_with("--native-backend="):
            dropped.push(arg)
        elif arg == "--native-backend":
            if i + 1 < args.len():
                dropped.push("--native-backend " + args[i + 1])
                i = i + 1
        i = i + 1
    dropped

export client_dropped_execution_flags
