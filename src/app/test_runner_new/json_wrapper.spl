# Legacy JSON-mode subprocess boundary, retired onto the SDN result-file
# transport. JSON test output is retired (see sdn_worker_args.spl); the
# legacy --json / --format json spellings are translated to the public SDN
# request and delegated to sdn_wrapper.spl, which now owns the subprocess
# boundary and the result channel.

use app.test_runner_new.sdn_wrapper.{run_test_sdn_wrapper}

fn test_json_worker_requested(args: [text]) -> bool:
    # The private JSON worker marker is retired; the SDN worker boundary uses
    # --test-sdn-worker. Report it so the CLI dispatch exempts an SDN worker
    # from the public wrapper and the recursion guard, as the JSON worker was.
    args.contains("--test-sdn-worker")

fn test_json_requested(args: [text]) -> bool:
    var i = 0
    while i < args.len():
        # --json is a shorthand alias for --format json (dashboard consumers).
        if args[i] == "--json":
            return true
        if args[i] == "--format" and i + 1 < args.len() and args[i + 1] == "json":
            return true
        i = i + 1
    false

fn run_test_json_wrapper(test_args: [text]) -> i64:
    # Translate the retired JSON request spellings to the public SDN request;
    # every other argument passes through unchanged.
    var sdn_args: [text] = []
    var i = 0
    while i < test_args.len():
        val arg = test_args[i]
        if arg == "--json":
            sdn_args.push("--sdn")
        elif arg == "--format" and i + 1 < test_args.len() and test_args[i + 1] == "json":
            sdn_args.push("--sdn")
            i = i + 1
        else:
            sdn_args.push(arg)
        i = i + 1
    run_test_sdn_wrapper(sdn_args) as i64
