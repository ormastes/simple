# Coverage admission is a per-file failure, never an executed assertion.
use std.test_runner.test_runner_types.{TestFileResult, TestRunResult}

fn cover_admitted_files(files: [text], rejected: [text]) -> [text]:
    var denied: {text: bool} = {}
    for path in rejected:
        denied[path] = true
    var admitted: [text] = []
    for path in files:
        if not denied.contains_key(path):
            admitted.push(path)
    admitted

fn cover_append_failures(result: TestRunResult, rejected: [text]) -> TestRunResult:
    var rows = result.files
    for path in rejected:
        rows.push(TestFileResult(path: path, passed: 0, failed: 1, skipped: 0,
            pending: 0, duration_ms: 0, setup_ms: 0,
            error: "COVER ADMISSION FAILED: missing required header # @cover annotation; test not executed",
            timed_out: false, cached: false))
    TestRunResult(files: rows, total_passed: result.total_passed,
        total_failed: result.total_failed + rejected.len(),
        total_skipped: result.total_skipped, total_pending: result.total_pending,
        total_timed_out: result.total_timed_out, total_duration_ms: result.total_duration_ms,
        total_setup_ms: result.total_setup_ms, total_cached: result.total_cached)
