# Minimal pure-Simple child test runner.
#
# Used by daemon-owned child runs (`simple test <file> --no-session-daemon`).
# Keep this file independent from std.test_runner.* so child execution does not
# import discovery, cache, fork, composite, QEMU, or daemon modules.
#
# NOTE on zero-executed detection: this file deliberately does NOT use
# std.test_runner.test_result_wrapper.build_interpreter_result_wrapper (the
# usual cross-module "wrap the source + panic on get_executed_test_count()==0"
# contract). That harness generates `use std.spec.{print_summary, ...}`, and in
# this interpreter-mode default-family context `std.spec` resolves to the
# `spec/` package directory (src/lib/<family>/spec/__init__.spl), which does
# NOT re-export print_summary/get_exit_code/get_executed_test_count (only the
# sibling spec.spl FILE does) — every wrapped run, including genuinely green
# ones, hard-fails with "function `print_summary` not found" (verified via
# bin/simple, not just the bootstrap seed). Reusing that wrapper here would
# turn the zero-executed greenwash into a universal false-RED. See
# doc/08_tracking/bug/test_runner_zero_executed_single_file_greenwash_2026-07-17.md
# for the repro and doc/08_tracking/bug/std_spec_package_shadows_file_print_summary_2026-07-17.md
# for the underlying resolution defect (out of scope for the runner layer).
#
# Under `--assert-ran`, the child writes versioned pass/fail counts through
# `SIMPLE_TEST_RESULT_FILE`; stdout markers remain only for legacy runs.

use std.sffi.cli.{cli_get_args}
use app.io.process_ops.{process_run_bounded}
use app.io.mod.{env_get}
use std.test_runner.test_runner_types.{TEST_OUTPUT_CAPTURE_BYTES}
use std.string_core.{char_code}
use std.common.coverage_sdn.{parse_coverage_sdn, merge_coverage, render_coverage_sdn}
use app.test_daemon.light_protocol.{timeout_verdict_line, has_verdict_line, exit_code_reason, unrun_verdict_line, unrun_reason}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64
extern fn rt_path_absolute(path: text) -> text

# --- Legacy word-infix matcher preprocessing (self-contained; this file is kept
# independent of std.test_runner.* so child runs stay lightweight). Mirrors
# test_runner_execute.preprocess_infix_matchers_only. ---

fn _single_rewrite_infix_expect_line(line: text) -> text:
    val trimmed = line.trim()
    if not trimmed.starts_with("expect ") or trimmed.starts_with("expect("):
        return line
    val matchers: [text] = ["to_equal", "to_be", "to_contain", "to_start_with", "to_end_with", "to_be_greater_than", "to_be_less_than", "to_be_at_least", "to_be_at_most", "to_be_nil", "to_be_truthy", "to_be_falsy", "to_be_true", "to_be_false", "to_have_length", "to_be_empty"]
    var i = 0
    while i < matchers.len():
        val matcher = matchers[i]
        val needle = " " + matcher + " "
        val split_at = trimmed.index_of(needle)
        if split_at >= 0:
            val actual = trimmed.substring(7, split_at).trim()
            val expected = trimmed.substring(split_at + needle.len()).trim()
            if actual.len() == 0 or expected.len() == 0:
                return line
            val indent_len = line.len() - line.trim_start().len()
            val indent = line.substring(0, indent_len)
            return indent + "expect(" + actual + ")." + matcher + "(" + expected + ")"
        i = i + 1
    line

fn _single_last_slash(s: text) -> i64:
    var idx = -1
    var i = 0
    while i < s.len():
        if s.substring(i, i + 1) == "/":
            idx = i
        i = i + 1
    idx

fn preprocess_infix_for_child(file_path: text) -> text:
    if not file_path.ends_with("_spec.spl"):
        return file_path
    val content = rt_file_read_text(file_path)
    if content == "":
        return file_path
    val lines = content.split("\n")
    var joined = ""
    var first = true
    var changed = false
    for raw_line in lines:
        val rewritten = _single_rewrite_infix_expect_line(raw_line)
        if rewritten != raw_line:
            changed = true
        if first:
            joined = rewritten
            first = false
        else:
            joined = joined + "\n" + rewritten
    if not changed:
        return file_path
    val slash = _single_last_slash(file_path)
    val dir = if slash >= 0: file_path.substring(0, slash + 1) else: ""
    val base = if slash >= 0: file_path.substring(slash + 1) else: file_path
    val tmp = dir + ".spipe_matchers_{rt_getpid()}_{rt_time_now_unix_micros()}_" + base
    val ok = rt_file_write_text(tmp, joined)
    if not ok:
        return file_path
    tmp

struct ChildRun:
    path: text
    timeout_secs: i64
    list_only: bool
    valid: bool
    error: text

fn clean_args() -> [text]:
    val raw = cli_get_args()
    var args: [text] = []
    var i = 0
    while i < raw.len():
        val arg = raw[i]
        if arg == "test" or arg == "run":
            i = i + 1
            continue
        if arg.ends_with("/simple") or arg.ends_with("simple.exe") or arg.ends_with("test_runner_single.spl"):
            i = i + 1
            continue
        args.push(arg)
        i = i + 1
    args

fn parse_child_run(args: [text]) -> ChildRun:
    var path = ""
    var timeout_secs = 120
    var list_only = false
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--timeout" and i + 1 < args.len():
            timeout_secs = args[i + 1].to_i64() ?? 0
            i = i + 2
            continue
        if arg.starts_with("--timeout="):
            timeout_secs = arg[10:].to_i64() ?? 0
            i = i + 1
            continue
        if arg == "--list":
            list_only = true
            i = i + 1
            continue
        if not arg.starts_with("-") and path == "":
            path = arg
        i = i + 1
    if path == "":
        return ChildRun(path: "", timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "missing test file")
    if not path.ends_with(".spl"):
        return ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "expected .spl test file")
    if not rt_file_exists(path):
        return ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: false, error: "test file not found")
    ChildRun(path: path, timeout_secs: timeout_secs, list_only: list_only, valid: true, error: "")

fn find_simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != nil and configured != "" and rt_file_exists(configured):
        return configured
    # Resolve the invoking binary IN-PROCESS via /proc/self/exe
    # (std::fs::canonicalize). Never shell out to `readlink`: a spawned
    # helper's /proc/self describes the HELPER, which is how the CLI's guard
    # became a fork bomb on 2026-07-25. cli_get_args()[0] below is the
    # SUBCOMMAND ("test"), not argv0, so without this step the resolver always
    # fell through to a possibly-stale bin/simple — see
    # doc/08_tracking/bug/test_runner_child_binary_ignores_invoking_binary_2026-07-27.md.
    val self_path = rt_path_absolute("/proc/self/exe") ?? ""
    if self_path.len() > 0 and self_path != "/proc/self/exe" and rt_file_exists(self_path):
        return self_path
    val raw = cli_get_args()
    # Source-mode argv can begin with test_runner_single.spl itself. It exists,
    # but it is not executable; passing it to process_run_timeout produces a
    # misleading permission-denied failure instead of running the test.
    if raw.len() > 0 and (raw[0].ends_with("/simple") or raw[0].ends_with("simple.exe")) and rt_file_exists(raw[0]):
        return raw[0]
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    "./bin/simple"

fn file_has_di_test_tag(file_path: text) -> bool:
    """Check if file has # @di_test tag, allowing DI modifications in system tests.

    Mirrors std.test_runner.test_runner_files.file_has_di_test_tag. Duplicated
    here (rather than imported) so this child runner stays independent of
    std.test_runner.* per the file-level design note above."""
    val content = rt_file_read_text(file_path)
    content.contains("# @di_test")

fn spec_exec_limit_directive(file_path: text) -> i64:
    """Parse `# @exec_limit <N>` from a spec header (0 when absent/invalid).

    Specs whose honest interpreter run exceeds the driver's default
    10M-operation cap declare the cap they need; run_spec forwards it into
    the child env (raise-only) because the driver reads
    SIMPLE_EXECUTION_LIMIT once at startup and in-process arming is inert."""
    val content = rt_file_read_text(file_path)
    val idx = find_raw(content, "# @exec_limit ")
    if idx < 0:
        return 0
    var pos = idx + 14
    val n = content.len()
    var value: i64 = 0
    var digits = 0
    while pos < n:
        val c = content.char_code_at(pos)
        if c >= 48 and c <= 57:
            value = value * 10 + (c - 48)
            digits = digits + 1
            pos = pos + 1
        else:
            break
    if digits == 0:
        return 0
    value

fn spec_timeout_secs_directive(file_path: text) -> i64:
    """Parse `# @timeout_secs <N>` from a spec header (0 when absent/invalid).

    The per-spec child wall-clock budget defaults to 120s and the only other
    lever is the `slow_it` 600s floor. A spec whose HONEST run exceeds 600s
    therefore had no way to ask for more: the child was killed mid-run and the
    outer runner printed "Process timed out" with NO verdict line at all — a
    fail-open hole, because a spec that cannot report a verdict can never
    report a failure either. Raise-only, same shape as @exec_limit."""
    val content = rt_file_read_text(file_path)
    val idx = find_raw(content, "# @timeout_secs ")
    if idx < 0:
        return 0
    var pos = idx + 16
    val n = content.len()
    var value: i64 = 0
    var digits = 0
    while pos < n:
        val c = content.char_code_at(pos)
        if c >= 48 and c <= 57:
            value = value * 10 + (c - 48)
            digits = digits + 1
            pos = pos + 1
        else:
            break
    if digits == 0:
        return 0
    value

fn print_summary(path: text, passed: i64, failed: i64, skipped: i64, pending: i64, duration_ms: i64):
    print ""
    print "========================================="
    print "Test Summary"
    print "========================================="
    print "Files: 1"
    print "Passed: {passed}"
    print "Failed: {failed}"
    print "Results: {passed + failed} total, {passed} passed, {failed} failed"
    if skipped > 0:
        print "Skipped: {skipped}"
    if pending > 0:
        print "Pending: {pending}"
    print "Duration: {duration_ms}ms"
    if failed == 0:
        print ""
        print "PASS {path}"
    else:
        print ""
        print "FAIL {path}"

# Raw scan instead of index_of: on the seed-JIT flat-i64 path Some(3) reads as
# None ("example" sits at offset 3 in "10 examples".."99 examples"), which
# false-failed 10-99-example specs with "no parseable summary". Mirrors
# test_executor_parsing.find_raw (b19fc038); see
# doc/08_tracking/bug/jit_option_i64_value3_reads_as_none_2026-07-24.md.
fn find_raw(s: text, keyword: text) -> i64:
    val klen = keyword.len()
    if klen == 0:
        return 0
    val slen = s.len()
    var i = 0
    while i + klen <= slen:
        if s[i:i + klen] == keyword:
            return i
        i = i + 1
    -1

fn extract_number_before(s: text, keyword: text) -> i64:
    val idx = find_raw(s, keyword)
    if idx < 0:
        return -1
    val prefix = s[0:idx]
    var current = ""
    var last = ""
    var i = 0
    while i < prefix.len():
        val ch = prefix[i:i + 1]
        # char_code + i64 compares, NOT text `<`/`>` — text ordering
        # miscompiles to a raw pointer cmp on the native flat-HIR path (see
        # sspec_test_path_false_green_undercount_2026-07-20.md).
        val code: i64 = char_code(ch)
        if code >= 48 and code <= 57:
            current = current + ch
        else:
            if current != "":
                last = current
                current = ""
        i = i + 1
    if current != "":
        last = current
    if last == "":
        return -1
    last.to_i64() ?? -1

fn extract_number_after(s: text, keyword: text) -> i64:
    """Digits immediately following `keyword` (-1 when absent/no digits).

    Mirror of extract_number_before for `key=<n>` shaped fields."""
    val idx = find_raw(s, keyword)
    if idx < 0:
        return -1
    var pos = idx + keyword.len()
    val n = s.len()
    var value: i64 = 0
    var digits = 0
    while pos < n:
        val c = s.char_code_at(pos)
        if c >= 48 and c <= 57:
            value = value * 10 + (c - 48)
            digits = digits + 1
            pos = pos + 1
        else:
            break
    if digits == 0:
        return -1
    value

fn parse_spec_file_verdict(output: text) -> (i64, i64, i64, i64, i64):
    """Parse the driver's authoritative per-file verdict line.

    `report_spec_file_verdict` (src/compiler_rust/driver/src/cli/basic.rs)
    emits exactly one such line per spec FILE, always, on stdout, LAST:

        SPEC FILE VERDICT: <path> declared>=N executed=N passed=N failed=N dropped=N

    Its counts come from the interpreter's own BDD result table, not from
    scraping display text, so it is strictly more reliable than the per-example
    glyphs and the per-describe "N examples, M failures" lines. It deliberately
    omits the substrings `examples, ` / `failures` so parse_child_example_summary
    never double-counts it.

    `dropped` is `declared - executed`: examples the file DECLARED but never
    ran. A verdict with `dropped>0` is NOT a clean bill of health -- it is the
    signature of a file that silently ran a fraction of itself
    (`declared>=10 executed=1 passed=1 failed=0 dropped=9`). Every consumer
    below that treats a verdict as POSITIVE evidence of completion must
    therefore also require `dropped == 0`, or it greenwashes exactly that case.
    Bug: spec_runner_verdict_dropped_gate_reverted.

    Returns (executed, passed, failed, dropped, has_verdict)."""
    var executed = -1
    var passed = -1
    var failed = -1
    var dropped = -1
    val lines = output.split("\n")
    for line in lines:
        if line.contains("SPEC FILE VERDICT:"):
            val e = extract_number_after(line, " executed=")
            val p = extract_number_after(line, " passed=")
            val f = extract_number_after(line, " failed=")
            val d = extract_number_after(line, " dropped=")
            if e >= 0 and p >= 0 and f >= 0:
                executed = e
                passed = p
                failed = f
                dropped = d
    if executed >= 0:
        # A verdict line with no parseable `dropped=` field is treated as
        # dropped-unknown, and unknown must fail closed: report a nonzero
        # value so neither bypass below can accept it as clean.
        val d_out = if dropped >= 0: dropped else: 1
        return (executed, passed, failed, d_out, 1)
    (0, 0, 0, 0, 0)

fn output_was_truncated(output: text) -> bool:
    """True when the bounded-capture reader discarded part of the child output.

    rt_process_run_bounded keeps only the first and last 2MB of a >4MB stream
    and splices in `[output truncated: N bytes omitted]` where the MIDDLE was
    dropped (spawn_bounded_output_reader,
    src/compiler_rust/runtime/src/value/sffi/env_process.rs). Every text-scraped
    signal below is unreliable once this is set."""
    output.contains("[output truncated:")

fn _count_lines_containing(output: text, marker: text) -> i64:
    var count = 0
    val lines = output.split("\n")
    for line in lines:
        if line.contains(marker):
            count = count + 1
    count

fn count_real_examples(output: text) -> (i64, i64):
    """Count REAL executed `it` blocks from the runner's own per-example
    markers instead of the aggregate "N examples, M failures" summary line.
    Interpreter-mode intrinsic BDD reporting marks each real execution with a
    glyph (✓ pass / ✗ fail); pending()/skip() use a different marker (○ ...
    (skipped) / ... skipped / ... pending) and are never counted here.
    Compiled-mode reporting (std.spec._execute_it) uses the textual
    "it ... ok" / "it ... FAILED" suffixes instead, so both are recognized.
    This is fail-closed against the summary line, which miscounts a
    pending()-only spec as "1 example, 0 failures" (zero-executed greenwash:
    doc/08_tracking/bug/test_runner_zero_executed_single_file_greenwash_2026-07-17.md)."""
    val real_passed = _count_lines_containing(output, "✓") + _count_lines_containing(output, "... ok")
    val real_failed = _count_lines_containing(output, "✗") + _count_lines_containing(output, "... FAILED")
    (real_passed, real_failed)

fn parse_child_example_summary(output: text) -> (i64, i64, i64):
    # Sum across ALL per-describe "N examples, M failures" lines. Last-wins
    # here previously let a passing final describe erase earlier failures
    # (file summary "Failed: 0" + PASS + exit 0 on a red spec).
    var examples = -1
    var failures = -1
    val lines = output.split("\n")
    for line in lines:
        if line.contains("example") and line.contains("failure"):
            val parsed_examples = extract_number_before(line, "example")
            val parsed_failures = extract_number_before(line, "failure")
            if parsed_examples >= 0 and parsed_failures >= 0:
                if examples < 0:
                    examples = 0
                    failures = 0
                examples = examples + parsed_examples
                failures = failures + parsed_failures
    if examples >= 0 and failures >= 0:
        return (examples - failures, failures, 1)
    (0, 0, 0)

fn read_test_result_evidence(path: text) -> (i64, i64, i64):
    if path == "" or not rt_file_exists(path):
        return (0, 0, 0)
    val content = rt_file_read_text(path)
    val parts = content.split("\n")
    if parts.len() < 3 or parts[0] != "simple-bdd-v1":
        return (0, 0, 0)
    val passed_text = parts[1].trim()
    val failed_text = parts[2].trim()
    if passed_text == "" or failed_text == "":
        return (0, 0, 0)
    val passed = passed_text.to_i64() ?? -1
    val failed = failed_text.to_i64() ?? -1
    if passed < 0 or failed < 0 or passed.to_text() != passed_text or failed.to_text() != failed_text:
        return (0, 0, 0)
    if content != "simple-bdd-v1\n{passed_text}\n{failed_text}\n":
        return (0, 0, 0)
    (passed, failed, 1)

# --- SIMPLE_COVERAGE measured line coverage (2026-08-02) -------------------
# The seed interpreter already records executed statement lines in a global
# collector when SIMPLE_COVERAGE=1 (driver real_main -> init_coverage_from_env,
# node_exec -> record_node_coverage). Two gaps kept it inert on `simple test`:
# the `run` child never dumped the collector, and span_to_location attributes
# every hit to the placeholder file "<source>" (line numbers stay
# module-relative). This block wires the dormant mechanism without touching
# the Rust seed (unbuildable while WC conflict markers sit in base crates):
#  1. inject a tiny epilogue into the child spec copy that prints the SDN dump
#     between sentinel markers (rt_coverage_dump_sdn is a registered extern),
#  2. strip that region from the echoed child output,
#  3. re-attribute hits per target source file: a recordable line counts as
#     covered when its line number was hit AND it sits inside a function the
#     collector recorded as called (or in module top-level code). Targets come
#     from `# @cover <path>` annotations plus the spec's use-imports.
# Attribution is now exact on both axes: the collector records the owning
# module per line (CURRENT_EXEC_MODULE, see coverage_helpers.rs) and the
# reporter keys hits on (file, line).
#
# FIXED 2026-08-04 — cross-file line conflation. Hits used to be keyed by line
# NUMBER alone, because the collector stamped every record with the constant
# file "<source>". A line executed in file A therefore marked the same line
# number in file B as covered whenever B's enclosing function had also been
# called — inflating every percentage in the flattering direction, silently.
# Fixture (test/01_unit/app/test/coverage_line_key_spec.spl): file B's lines
# 4..11 never execute and its function IS called; it reported 100% (10/10)
# against a hand-computed honest 2/10. Measured damage on the browser-engine
# campaign modules ran to 13 points, and one module reporting 100% was really
# 96%. Do NOT reintroduce a line-only key.
#
# RESIDUAL (open, conservative direction). An imported module's TOP-LEVEL
# statements are flattened into the entry program before execution, so
# CURRENT_EXEC_MODULE still reads `<entry>` for them and they are filed under
# `<entry>` rather than their own module. Those lines therefore report as
# uncovered even when they ran: fixture covkey_toplevel_d.spl measures 66%
# (2/3) where the honest answer is 3/3. This UNDER-reports, so a number is a
# floor, never a flattering estimate. It is bounded: module-level recordable
# statements are <=2 lines (<=0.9%) in each of the eight browser-engine
# campaign modules. Fixing it needs the flatten path to carry the owning module
# through to execution; do NOT "fix" it by accepting `<entry>` hits for a
# target file, which would re-pool every module's top level into one bucket and
# reintroduce exactly the conflation above.
#
# FIXED 2026-08-04 — instance methods used to always score 0 (was: KNOWN CAP).
# The collector's `functions` section used to contain only free functions and
# `static fn`s, because `record_function_call` was reached from just three of
# the call paths in
# src/compiler_rust/compiler/src/interpreter_call/core/function_exec.rs
# (`exec_function_inner`, `exec_function_with_values_and_writeback_inner`,
# `exec_function_with_bound_args_inner`). Five other body-execution paths
# bypassed it entirely: `exec_function_with_values_inner`,
# `exec_function_with_values_and_self` (class/enum method dispatch),
# `exec_function_with_captured_env` (closures/lambdas),
# interpreter_control::exec_method_body (`with` + `call_method_if_exists`) and
# interpreter_method::special::execution::exec_function_with_self_return
# (mutating-self dispatch). A `me name()` body therefore failed the
# called-function gate no matter how thoroughly it was tested.
#
# The seed fix moved the coverage hook DOWN to `execute_function_body`, the one
# choke point all eight paths funnel through (and deleted the three upstream
# copies, so counts did not double), plus one extra hook in
# interpreter_call/core/class_instantiation.rs for `new` bodies, which run via
# `exec_block_fn` and so miss the choke point. Measured A/B on two seed binaries
# built from the same tree, same specs, same .spl sources:
#
#   html_tree_builder.spl    75% (210/277)  ->  95% (264/277)
#   dom_identity_index.spl   52% (123/234)  ->  98% (230/234)
#   html_tokenizer.spl       97% (377/386)  ->  98% (380/386)   (free-fn control)
#
# and the previously-absent method names now appear with real call counts
# (`push_open` 423, `close_through` 74, `foster_push_open` 1, `contains_route`
# 5, `path_for_route` 3, `radio_members` 2). Free-function call counts are
# byte-identical across the two arms (`_dom_attr` 333215, `_dom_route_key`
# 67213), which is the no-double-count proof.
#
# The gate is still doing real work — do NOT relax it. A purpose-built probe
# module with one called method, one uncalled method, one called free fn and
# one uncalled free fn scores 5/12, not 12/12: the uncalled bodies stay out of
# the `functions` dump and their lines stay uncovered. Line numbers are still
# conflated across files, so line-hit alone would credit untaken error
# branches; the called-function gate is what bounds that error.

fn _cov_enabled() -> bool:
    val v = env_get("SIMPLE_COVERAGE") ?? ""
    v != "" and v != "0"

fn _cov_instrument_for_coverage(current: text, original: text) -> text:
    """Append a coverage-dump epilogue to the child spec copy. When `current`
    is already a temp copy (infix preprocessing), append in place; otherwise
    create a fresh temp copy next to the original so imports still resolve."""
    val content = rt_file_read_text(current)
    if content == "":
        return current
    var epilogue = "\n\n# --- coverage epilogue injected by test_runner_single (SIMPLE_COVERAGE) ---\n"
    epilogue = epilogue + "extern fn rt_coverage_dump_sdn() -> text\n"
    epilogue = epilogue + "fn __simple_cov_dump():\n"
    epilogue = epilogue + "    print \"__SIMPLE_COV_SDN_BEGIN__\"\n"
    epilogue = epilogue + "    print rt_coverage_dump_sdn()\n"
    epilogue = epilogue + "    print \"__SIMPLE_COV_SDN_END__\"\n"
    epilogue = epilogue + "__simple_cov_dump()\n"
    if current != original:
        val _ = rt_file_write_text(current, content + epilogue)
        return current
    val slash = _single_last_slash(original)
    val dir = if slash >= 0: original.substring(0, slash + 1) else: ""
    val base = if slash >= 0: original.substring(slash + 1) else: original
    val tmp = dir + ".spipe_cov_{rt_getpid()}_{rt_time_now_unix_micros()}_" + base
    if rt_file_write_text(tmp, content + epilogue):
        return tmp
    current

fn _cov_split_output(output: text) -> (text, text):
    """Split child stdout into (clean output, coverage SDN region)."""
    val lines = output.split("\n")
    var clean = ""
    var sdn = ""
    var in_cov = false
    var first_clean = true
    for line in lines:
        if line.contains("__SIMPLE_COV_SDN_BEGIN__"):
            in_cov = true
            continue
        if line.contains("__SIMPLE_COV_SDN_END__"):
            in_cov = false
            continue
        if in_cov:
            sdn = sdn + line + "\n"
        else:
            if first_clean:
                clean = line
                first_clean = false
            else:
                clean = clean + "\n" + line
    (clean, sdn)

fn _cov_dots_to_slashes(s: text) -> text:
    var out = ""
    var i = 0
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if ch == ".":
            out = out + "/"
        else:
            out = out + ch
        i = i + 1
    out

fn _cov_targets(spec_src: text) -> [text]:
    """Target source files: `@cover <path>` annotations plus std./lib./app.
    use-imports mapped to src/ paths. Only existing .spl files, deduped."""
    var seen: dict<text, bool> = {}
    var targets: [text] = []
    for raw in spec_src.split("\n"):
        val t = raw.trim()
        var path = ""
        val cov_idx = find_raw(t, "@cover ")
        if cov_idx >= 0:
            val rest = t.substring(cov_idx + 7).trim()
            val sp = find_raw(rest, " ")
            path = if sp >= 0: rest.substring(0, sp) else: rest
        elif t.starts_with("use "):
            var module = t.substring(4)
            val sp = find_raw(module, " ")
            if sp >= 0:
                module = module.substring(0, sp)
            val brace = find_raw(module, ".{")
            if brace >= 0:
                module = module.substring(0, brace)
            var rel = ""
            if module.starts_with("std."):
                rel = "src/lib/" + _cov_dots_to_slashes(module.substring(4))
            elif module.starts_with("lib."):
                rel = "src/lib/" + _cov_dots_to_slashes(module.substring(4))
            elif module.starts_with("app."):
                rel = "src/app/" + _cov_dots_to_slashes(module.substring(4))
            if rel != "":
                path = rel + ".spl"
        if path != "" and path.ends_with(".spl") and rt_file_exists(path):
            if not seen.contains_key(path):
                seen[path] = true
                targets.push(path)
    targets

fn _cov_fn_name(header: text) -> text:
    """Extract function name from a `fn `/`me `/`gen ` header line."""
    var rest = ""
    if header.starts_with("fn "):
        rest = header.substring(3)
    elif header.starts_with("me "):
        rest = header.substring(3)
    else:
        rest = header.substring(4)
    var name = ""
    var i = 0
    while i < rest.len():
        val ch = rest.substring(i, i + 1)
        if ch == "(" or ch == ":" or ch == " " or ch == "<":
            return name
        name = name + ch
        i = i + 1
    name

fn _cov_is_recordable(t: text) -> bool:
    """Approximate the statement kinds the interpreter collector records
    (Let/Assignment/If/While/For/Loop/Return/Break/Continue/Match/With).
    Bare expression statements, case arms, `elif`/`else` branch heads, prints,
    and struct fields are never recorded, so they stay out of the denominator."""
    # `elif` heads are NEVER recorded, even when the branch is taken: a probe
    # of `if n > 100 / elif n > 10 / elif n > 1` driven through both `elif`
    # arms recorded each arm's BODY line and neither `elif` line (the `if`
    # head is recorded). Counting them inflated the denominator with lines no
    # test can ever reach — 13 such lines in html_tokenizer.spl alone. The
    # `contains(" = ")` fallback below would otherwise re-admit binding forms
    # like `elif val Some(x) = ...`, so this check has to come first.
    if t.starts_with("elif "):
        return false
    if (t.starts_with("val ") or t.starts_with("var ") or t.starts_with("if ") or
        t.starts_with("while ") or t.starts_with("for ") or
        t.starts_with("loop") or t.starts_with("return") or t.starts_with("break") or
        t.starts_with("continue") or t.starts_with("match ") or t.starts_with("with ")):
        return true
    # plain assignment statement: `lhs = rhs` (not `==`)
    t.contains(" = ") and not t.contains(" == ")

fn _cov_norm_path(p: text) -> text:
    """Normalise a path for cross-form comparison: strip a leading `./` and
    collapse nothing else. The collector emits `normalize_path_key` output,
    which may be absolute while `@cover` targets are repo-relative; matching is
    done by suffix in _cov_hit_key_for_target."""
    var s = p.trim()
    while s.starts_with("./"):
        s = s.substring(2)
    s

fn _cov_hit_key(file: text, line: text) -> text:
    """Key a line hit by (file, line) instead of line alone.

    Keying on the line number alone conflated every file in the run: the
    collector pools all hits into one set, so line 412 executing in file A
    marked line 412 of file B covered whenever B's enclosing function had also
    been called. That inflated coverage in the flattering direction only."""
    _cov_norm_path(file) + "|" + line.trim()

fn _cov_recorded_file_for_target(path: text, files: [text]) -> text:
    """Pick the recorded module path that denotes `path`. The collector's key
    comes from `normalize_path_key`, which can be absolute; `@cover` targets are
    repo-relative. Accept an exact match, or the longest path-suffix match, so
    `/abs/repo/src/lib/x.spl` matches target `src/lib/x.spl` without letting
    `other_x.spl` match `x.spl` (the suffix must start at a `/` boundary)."""
    val want = _cov_norm_path(path)
    var best = ""
    for f in files:
        if f == want:
            return f
        if f.ends_with("/" + want) or want.ends_with("/" + f):
            if f.len() > best.len():
                best = f
    best

fn _cov_report_for_file(path: text, hits: dict<text, bool>, called: dict<text, bool>,
                        files: [text]) -> text:
    val content = rt_file_read_text(path)
    if content == "":
        return "coverage: {path} 0% (0/0 lines)"
    # Resolve which recorded module path denotes this target once, up front; a
    # target the collector never recorded has no hits and reports 0%.
    val rec_file = _cov_recorded_file_for_target(path, files)
    var current_fn = ""
    var in_doc = false
    var total = 0
    var hit = 0
    var line_no = 0
    for raw in content.split("\n"):
        line_no = line_no + 1
        val t = raw.trim()
        if t == "":
            continue
        if t.starts_with("#"):
            continue
        if t.starts_with("\"\"\""):
            if in_doc:
                in_doc = false
            elif not (t.len() >= 6 and t.ends_with("\"\"\"")):
                in_doc = true
            continue
        if in_doc:
            if t.ends_with("\"\"\""):
                in_doc = false
            continue
        var h = t
        # Strip every visibility/storage prefix, not just `static `. Missing
        # `pub ` made `pub fn foo()` invisible as a header, so every line of a
        # `pub fn` body stayed attributed to the PREVIOUS declaration; that
        # stale name then failed the called-function gate and the whole body
        # read as uncovered. Measured on html_tokenizer.spl: the entire body of
        # `html_tokenizer_tokenize_with_limits` was charged to the `_TokenSink`
        # method declared above it, costing 22 points (65% -> 87%) with no test
        # change at all.
        var stripping = true
        while stripping:
            stripping = false
            if h.starts_with("pub "):
                h = h.substring(4)
                stripping = true
            elif h.starts_with("priv "):
                h = h.substring(5)
                stripping = true
            elif h.starts_with("static "):
                h = h.substring(7)
                stripping = true
        if h.starts_with("fn ") or h.starts_with("me ") or h.starts_with("gen "):
            current_fn = _cov_fn_name(h)
            continue
        if not _cov_is_recordable(t):
            continue
        total = total + 1
        # The line must have been hit IN THIS FILE. The enclosing-function gate
        # stays exactly as strict as it was (defect B's standing rule): a
        # genuinely-uncalled body must still read as uncovered.
        if rec_file != "" and hits.contains_key(_cov_hit_key(rec_file, "{line_no}")):
            if current_fn == "" or called.contains_key(current_fn):
                hit = hit + 1
    if total == 0:
        return "coverage: {path} 0% (0/0 lines)"
    val pct = (hit * 100) / total
    "coverage: {path} {pct}% ({hit}/{total} lines)"

fn _cov_print_report(spec_path: text, sdn: text):
    var hits: dict<text, bool> = {}
    var called: dict<text, bool> = {}
    var seen_files: dict<text, bool> = {}
    var files: [text] = []
    # Branch (decision) coverage: per-file executed-decision accounting from
    # the runtime store's `decisions |id, file, line, column, true_count,
    # false_count|` section. A decision is covered when BOTH outcomes were
    # taken. Denominator = decisions the run actually executed (the runtime
    # store records nothing for never-reached decisions), so this measures
    # decision-outcome coverage over executed decisions — stated as such in
    # the bug doc; a static all-decisions denominator is future work.
    var dec_total: dict<text, i64> = {}
    var dec_hit: dict<text, i64> = {}
    var seen_dec_files: dict<text, bool> = {}
    var dec_files: [text] = []
    var section = ""
    for raw in sdn.split("\n"):
        val t = raw.trim()
        if t.starts_with("lines |"):
            section = "lines"
            continue
        if t.starts_with("functions |"):
            section = "functions"
            continue
        if t.starts_with("decisions |"):
            section = "decisions"
            continue
        if t.starts_with("sffi_calls |") or t.starts_with("summary") or t.starts_with("conditions |") or t.starts_with("paths |"):
            section = ""
            continue
        if t == "":
            continue
        if section == "lines":
            # Row shape: `file, line, hit_count`. The file column used to be the
            # constant "<source>" for every row, so this kept only the line and
            # the hit set was pooled across files — see _cov_hit_key. Now the
            # collector emits the real owning module, so the key is (file, line).
            val parts = t.split(", ")
            if parts.len() >= 3:
                val f = _cov_norm_path(parts[0])
                hits[_cov_hit_key(f, parts[parts.len() - 2])] = true
                if not seen_files.contains_key(f):
                    seen_files[f] = true
                    files.push(f)
        elif section == "functions":
            val parts = t.split(", ")
            if parts.len() >= 2:
                called[parts[0]] = true
        elif section == "decisions":
            # Row: id, file, line, column, true_count, false_count
            val parts = t.split(", ")
            if parts.len() >= 6:
                val f = _cov_norm_path(parts[1])
                val tc = parts[4].trim().to_i64() ?? 0
                val fc = parts[5].trim().to_i64() ?? 0
                if dec_total.contains_key(f):
                    dec_total[f] = dec_total[f] + 1
                else:
                    dec_total[f] = 1
                if tc > 0 and fc > 0:
                    if dec_hit.contains_key(f):
                        dec_hit[f] = dec_hit[f] + 1
                    else:
                        dec_hit[f] = 1
                if not seen_dec_files.contains_key(f):
                    seen_dec_files[f] = true
                    dec_files.push(f)
    val spec_src = rt_file_read_text(spec_path)
    if spec_src == "":
        return
    val targets = _cov_targets(spec_src)
    if targets.len() == 0:
        return
    print ""
    for tpath in targets:
        print _cov_report_for_file(tpath, hits, called, files)
    for tpath in targets:
        print _cov_branch_report_for_file(tpath, dec_total, dec_hit, dec_files)

fn _cov_branch_report_for_file(path: text, dec_total: dict<text, i64>,
                               dec_hit: dict<text, i64>, dec_files: [text]) -> text:
    """`coverage-branch: <path> NN% (hit/total decisions)` — decision-outcome
    coverage over decisions this run executed in `path` (both outcomes taken
    = hit). 0/0 means the run never reached a decision in the file."""
    val rec = _cov_recorded_file_for_target(path, dec_files)
    if rec == "" or not dec_total.contains_key(rec):
        return "coverage-branch: {path} 0% (0/0 decisions)"
    val total = dec_total[rec]
    val hit = if dec_hit.contains_key(rec): dec_hit[rec] else: 0
    if total == 0:
        return "coverage-branch: {path} 0% (0/0 decisions)"
    val pct = (hit * 100) / total
    "coverage-branch: {path} {pct}% ({hit}/{total} decisions)"

fn main() -> i64:
    var run = parse_child_run(clean_args())
    if not run.valid:
        print "Simple Test Runner child"
        print "error: {run.error}: {run.path}"
        return 1
    if run.list_only:
        print run.path
        return 0
    if rt_file_read_text(run.path).contains("slow_it ") and run.timeout_secs < 600:
        run.timeout_secs = 600
    val declared_timeout = spec_timeout_secs_directive(run.path)
    if declared_timeout > run.timeout_secs:
        run.timeout_secs = declared_timeout

    rt_env_set("SIMPLE_RUNTIME_MODE", "interpreter")
    rt_env_set("SIMPLE_EXECUTION_MODE", "interpret")
    val monitor_timeout = env_get("SIMPLE_TIMEOUT_SECONDS") ?? ""
    # Converting an empty string must not become a valid timeout value.
    # split the unset case out before any to_int call (this condition broke
    # every `simple test` run while the var was unset).
    if monitor_timeout == "":
        rt_env_set("SIMPLE_TIMEOUT_SECONDS", "{run.timeout_secs}")
    elif monitor_timeout != "0":
        if (monitor_timeout.to_i64() ?? 0) < run.timeout_secs:
            rt_env_set("SIMPLE_TIMEOUT_SECONDS", "{run.timeout_secs}")
    # `# @exec_limit <N>` spec-header directive: the driver reads
    # SIMPLE_EXECUTION_LIMIT once at startup (driver/src/cli/init.rs), so a
    # spec cannot raise its own op cap in-process — the runner must forward
    # it into the child env. Raise-only: an existing higher env value wins.
    val exec_limit = spec_exec_limit_directive(run.path)
    if exec_limit > 0:
        val cur = env_get("SIMPLE_EXECUTION_LIMIT") ?? ""
        if cur == "" or (cur.to_i64() ?? 0) < exec_limit:
            rt_env_set("SIMPLE_EXECUTION_LIMIT", "{exec_limit}")
    val is_system = run.path.contains("/system/") or run.path.contains("/feature/")
    if is_system:
        rt_env_set("SIMPLE_SYSTEM_TEST", "1")
    else:
        rt_env_set("SIMPLE_SYSTEM_TEST", "0")
    if is_system and file_has_di_test_tag(run.path):
        rt_env_set("SIMPLE_DI_TEST", "1")
    else:
        rt_env_set("SIMPLE_DI_TEST", "0")

    val binary = find_simple_binary()
    # Evidence must be self-describing: name the binary that executes the spec.
    print "child binary: {binary}"
    # ...and name it LOUDLY when it is not the binary the caller is running.
    # A silent substitution is the whole defect: the run then reports on a
    # compiler the verifying lane never built. SIMPLE_BINARY is the one
    # legitimate divergence, so it downgrades the line to a note.
    val self_exe = rt_path_absolute("/proc/self/exe") ?? ""
    if self_exe.len() > 0 and self_exe != "/proc/self/exe" and self_exe != binary:
        val explicit = env_get("SIMPLE_BINARY") ?? ""
        if explicit != "":
            print "child binary: explicitly overridden by SIMPLE_BINARY (invoking binary: {self_exe})"
        else:
            print "WARNING: child binary {binary} is NOT the invoking binary {self_exe}; this run does not measure the invoking compiler"
    val timeout_ms = run.timeout_secs * 1000
    # Rewrite legacy word-infix `expect X to_equal Y` to method form so the
    # interpreter `run` path evaluates the matcher (else it drops it → false-red
    # on falsy calls, silent false-green otherwise).
    var exec_path = preprocess_infix_for_child(run.path)
    val cov_on = _cov_enabled()
    if cov_on:
        exec_path = _cov_instrument_for_coverage(exec_path, run.path)
    val assert_ran = env_get("SIMPLE_TEST_ASSERT_RAN") == "1"
    var evidence_path = ""
    var previous_evidence_path = ""
    if assert_ran:
        var temp_root = env_get("TMPDIR")
        if temp_root == "":
            temp_root = env_get("TMP")
        if temp_root == "":
            temp_root = env_get("TEMP")
        if temp_root == "":
            temp_root = "/tmp"
        val temp_sep = if temp_root.ends_with("/") or temp_root.ends_with("\\"): "" else: "/"
        evidence_path = "{temp_root}{temp_sep}simple_bdd_result_{rt_getpid()}_{rt_time_now_unix_micros()}.txt"
        if rt_file_exists(evidence_path):
            val _ = rt_file_delete(evidence_path)
        if rt_file_exists(evidence_path):
            if exec_path != run.path:
                val _ = rt_file_delete(exec_path)
            print "error: test-runner: cannot prepare structured result evidence"
            return 1
        previous_evidence_path = env_get("SIMPLE_TEST_RESULT_FILE") ?? ""
        if not rt_env_set("SIMPLE_TEST_RESULT_FILE", evidence_path):
            if exec_path != run.path and rt_file_exists(exec_path):
                val _ = rt_file_delete(exec_path)
            print "error: test-runner: cannot configure structured result evidence"
            return 1
    val start = rt_time_now_unix_micros()
    val child_args = if assert_ran: ["run", exec_path, "--test-result-file={evidence_path}"] else: ["run", exec_path]
    val (stdout, stderr, code) = process_run_bounded(binary, child_args, timeout_ms, TEST_OUTPUT_CAPTURE_BYTES)
    val duration_ms = (rt_time_now_unix_micros() - start) / 1000
    if assert_ran and not rt_env_set("SIMPLE_TEST_RESULT_FILE", previous_evidence_path):
        if evidence_path != "" and rt_file_exists(evidence_path):
            val _ = rt_file_delete(evidence_path)
        if exec_path != run.path and rt_file_exists(exec_path):
            val _ = rt_file_delete(exec_path)
        print "error: test-runner: cannot restore structured result environment"
        return 1
    val (evidence_passed, evidence_failed, has_evidence) = read_test_result_evidence(evidence_path)
    if evidence_path != "" and rt_file_exists(evidence_path):
        val _ = rt_file_delete(evidence_path)
    if exec_path != run.path and rt_file_exists(exec_path):
        val _ = rt_file_delete(exec_path)
    var child_stdout = stdout
    var cov_sdn = ""
    if cov_on:
        val (cov_clean, cov_extracted) = _cov_split_output(stdout)
        child_stdout = cov_clean
        cov_sdn = cov_extracted
        if cov_sdn.trim() == "":
            # A coverage request without the injected dump is never a valid
            # test result.  Previously this silently printed a normal PASS and
            # omitted SIMPLE_COVERAGE_OUTPUT, allowing a stale runner binary
            # to masquerade as a measured ML-KEM coverage run.
            print "error: coverage dump sentinels absent from child output"
            if stderr != "": print stderr
            return 1
        val cov_output_path = env_get("SIMPLE_COVERAGE_OUTPUT") ?? ""
        if cov_output_path != "" and cov_sdn != "":
            # Multi-spec invocations: each spec's child inherits the SAME
            # SIMPLE_COVERAGE_OUTPUT path from the parent. Prerequisite 5
            # (std.common.coverage_sdn) now provides a real per-key union, so
            # a second (third, ...) spec writing to the same path ACCUMULATES
            # instead of overwriting (previously: last spec wins, silently
            # dropping every earlier spec's coverage). If the path already
            # holds a well-formed prior artifact, merge this spec's SDN into
            # it before writing; otherwise (first spec, or a stale/garbage
            # file at that path) write this spec's SDN alone — never block a
            # test run on a malformed pre-existing artifact.
            val new_cov = parse_coverage_sdn(cov_sdn)
            val to_write = if rt_file_exists(cov_output_path):
                val existing_raw = rt_file_read_text(cov_output_path)
                if existing_raw.trim().starts_with("# Coverage Report"):
                    render_coverage_sdn(merge_coverage(parse_coverage_sdn(existing_raw), new_cov))
                else:
                    cov_sdn
            else:
                cov_sdn
            val _ = rt_file_write_text(cov_output_path, to_write)
    if child_stdout != "":
        print child_stdout
    if stderr != "":
        print stderr
    val combined = child_stdout + "\n" + stderr
    val (real_passed, real_failed) = count_real_examples(combined)
    val real_executed = real_passed + real_failed
    val (summary_passed, summary_failed, has_summary) = parse_child_example_summary(combined)
    val (verdict_executed, verdict_passed, verdict_failed, verdict_dropped, has_verdict) = parse_spec_file_verdict(combined)
    val was_truncated = output_was_truncated(combined)
    if env_get("SIMPLE_TEST_RUNNER_DEBUG") == "1":
        print "test-runner debug: code={code} assert_ran={assert_ran} has_evidence={has_evidence} ev_p={evidence_passed} ev_f={evidence_failed} real_p={real_passed} real_f={real_failed} has_sum={has_summary} sum_p={summary_passed} sum_f={summary_failed} has_v={has_verdict} v_e={verdict_executed} v_p={verdict_passed} v_f={verdict_failed} v_d={verdict_dropped} trunc={was_truncated}"
    var failed = 0
    var passed = 0
    if code == -1 and (stderr.contains("TIMEOUT") or stderr.contains("timed out")):
        # process_run_bounded killed the child at the configured per-file
        # budget: it never got a chance to finish, so nothing it printed
        # (partial summary lines included) can be trusted as a real result.
        # Bug: test_runner_60s_silent_kill_greenwash — a killed file must
        # never read as PASS just because the pre-kill output looked clean.
        failed = 1
        passed = 0
        print "error: test-runner: file timed out"
        # Emit a verdict line for the KILLED file. Without it this branch
        # produced "Process timed out" and nothing else, so a sweep that
        # counts `^SPEC FILE VERDICT:` lines saw the file as NEVER RUN rather
        # than BROKEN, and the breakage was invisible. Suppressed when the
        # child somehow already printed one, so a real verdict is never
        # shadowed by a synthetic one.
        # Bug: killed_spec_emits_no_verdict_line_2026-08-09.
        if not has_verdict_line(combined):
            print "error: test-runner: {exit_code_reason(code)} after {run.timeout_secs}s budget"
            print timeout_verdict_line(run.path, "child-timeout", timeout_ms)
    elif code != 0 and assert_ran:
        passed = if has_evidence == 1: evidence_passed else: 0
        failed = if has_evidence == 1 and evidence_failed > 0: evidence_failed else: 1
        print "error: test-runner: spec failed"
    elif assert_ran and (has_evidence == 0 or evidence_passed + evidence_failed == 0):
        failed = 1
        passed = 0
        print "error: --assert-ran: no BDD examples executed"
    elif assert_ran:
        passed = evidence_passed
        failed = evidence_failed
        if failed > 0:
            print "error: test-runner: spec failed"
    elif was_truncated and has_verdict == 1 and verdict_executed > 0 and verdict_dropped == 0 and real_executed == 0 and has_summary == 0:
        # BUG FIX (spec_harness_truncated_output_false_red): the bounded-capture
        # reader keeps the first and last 2MB of a >4MB child stream and DROPS
        # THE MIDDLE. A spec that prints heavily both before its first example
        # and after its last one pushes every ✓/✗ glyph AND every per-describe
        # "N examples, M failures" line into that discarded middle, while the
        # driver's SPEC FILE VERDICT line — always emitted last — survives in
        # the retained tail. The zero-executed guard below then fail-closed on
        # evidence that was merely DELETED, not absent, and reported
        # "Results: 1 total, 0 passed, 1 failed" + exit 1 for a spec whose
        # example demonstrably ran and passed (ground truth: a file written from
        # inside the `it` body). Both surfaces contradicted each other in the
        # same run: VERDICT said executed=1 passed=1 failed=0, Results said
        # 1 failed. The VERDICT was the truthful one.
        #
        # This is NOT a weakening of the zero-executed greenwash guard: it is
        # gated on the truncation marker actually being present (so nothing
        # changes for any run whose output fit in the cap) AND on the
        # authoritative verdict line reporting real executions. Absent
        # truncation, the guard below is untouched.
        passed = verdict_passed
        failed = verdict_failed
        print "warning: test-runner: child output truncated; trusting SPEC FILE VERDICT"
        if code != 0 and failed == 0:
            failed = 1
        if failed > 0:
            print "error: test-runner: spec failed"
    elif real_executed == 0 and (has_summary == 0 or summary_failed == 0):
        # Fail-closed zero-executed check: a spec whose only content is
        # pending()/an orphan describe with no real `it` executions must not
        # read as PASS just because the child process happened to exit 0 and
        # its aggregate "N examples, M failures" summary line looked clean
        # (that line counts pending() as an executed example — bug:
        # zero-executed single-file greenwash). Skipped when the summary
        # line ALREADY reports real failures (has_summary==1 and
        # summary_failed>0): that signal is trustworthy on its own even
        # without a corroborating ✓/✗ glyph (e.g. a non-interpreter child
        # that reports failures as plain text).
        failed = 1
        passed = 0
        print "error: test-runner: no examples executed"
        # Emit a verdict line for the file that RAN NOTHING. The exit code was
        # already correct here (this branch fails closed at exit 1), but with no
        # `^SPEC FILE VERDICT:` line the file was invisible to every sweep that
        # counts verdict lines rather than exit codes — reading as NOT YET RUN
        # instead of BROKEN. That is the same invisibility the timeout branch
        # above closed, and it is why 24 unresolvable render-lane modules sat
        # undetected. Suppressed when the child already printed a verdict, so a
        # real verdict is never shadowed by a synthetic one.
        # Bug: unrun_spec_emits_no_verdict_line_2026-08-10.
        if not has_verdict_line(combined):
            val unrun_why = unrun_reason(combined)
            print "error: test-runner: spec executed nothing ({unrun_why})"
            print unrun_verdict_line(run.path, unrun_why)
    else:
        # BUG FIX (spec_runner_describe_tail_expression_exit_code): when a
        # `describe(...)` block is the TAIL EXPRESSION of `fn main()`, its
        # return value — a constant 1, NOT an example count (proven: a
        # 3-example spec still exits 1) — becomes the child's process exit
        # status. So a wholly passing spec of that shape hands us code=1, and
        # the `code != 0` clamp below then manufactured a phantom failure:
        # "Results: 1 total, 0 passed, 1 failed" + exit 1 for a spec whose
        # example demonstrably ran and passed. Adding ANY statement after the
        # block (a `print`, a literal `0`) cures it, which is why holding the
        # `fn main()` entry shape constant did not reproduce it. The exit
        # status is pinned red for passing AND failing specs alike, so it also
        # SUPPRESSES real reds for this shape.
        #
        # This is NOT a weakening of the greenwash guards. The child's
        # SPEC FILE VERDICT line is emitted by the driver epilogue, which only
        # runs if the spec process reached the end normally: a spec that
        # passes its examples and THEN dies abnormally emits no verdict line
        # at all (proven: `exit(7)` after the block yields has_verdict=0 and
        # stays RED). So requiring a clean verdict, corroborated by the
        # independent ✗-glyph tally and by any summary line present, is
        # POSITIVE evidence that the process completed and nothing failed —
        # exactly the shape of the truncation fix above. Every genuinely
        # nonzero exit that is not backed by that evidence still fails closed.
        # `verdict_dropped == 0` is load-bearing and was MISSING when this
        # bypass first landed: without it, a file reporting
        # `declared>=10 executed=1 passed=1 failed=0 dropped=9` plus a nonzero
        # exit read as fully GREEN -- reopening the greenwash that
        # 24cfc32db98 closed on the truncation bypass above. Same rule, same
        # reason: a verdict is positive evidence of completion only when it
        # accounts for every example the file declared.
        val verdict_clean = has_verdict == 1 and verdict_executed > 0 and verdict_dropped == 0 and verdict_failed == 0
        val exit_code_spurious = code != 0 and verdict_clean and real_failed == 0 and (has_summary == 0 or summary_failed == 0)
        if exit_code_spurious:
            print "warning: test-runner: child exit {code} contradicted by a clean SPEC FILE VERDICT; trusting the verdict"
        val exit_ok = code == 0 or exit_code_spurious
        passed = if has_summary == 1: summary_passed else: (if exit_ok: 1 else: 0)
        failed = if has_summary == 1: summary_failed else: (if exit_ok: 0 else: 1)
        # Fail-closed: never let either counting method's LOWER failure count
        # silently win. This is what catches an orphan top-level `it` (bug:
        # test_runner_orphan_it_silently_ignored) — its real ✗ marker prints,
        # but it has no enclosing `describe` to fold it into any "N examples,
        # M failures" summary line, so the summary alone would miss it.
        if real_failed > failed:
            failed = real_failed
            if real_passed < passed:
                passed = real_passed
        # Fail-closed: never let the aggregated per-describe summary
        # UNDERCOUNT the total relative to the REAL executed-example tally
        # (bug: sspec_test_runner_undercounts_it_blocks_2026-07-24 — a spec
        # registering 74 `it` examples reported "34 total" because the
        # per-describe "N examples, M failures" lines the summary sums were
        # incomplete while every example still printed its own real ✓/✗
        # marker). count_real_examples()'s tally is the authoritative,
        # fail-closed source per its own docstring, so whenever it reports
        # MORE total examples than the summary-derived total, trust it.
        if real_passed + real_failed > passed + failed:
            passed = real_passed
            if real_failed > failed:
                failed = real_failed
        if not exit_ok and failed == 0:
            failed = 1
        if failed > 0:
            print "error: test-runner: spec failed"
    print_summary(run.path, passed, failed, 0, 0, duration_ms)
    if cov_on and cov_sdn != "":
        _cov_print_report(run.path, cov_sdn)
    if failed == 0:
        return 0
    1
