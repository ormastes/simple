# Test Runner Output Formatting
#
# Routed to the canonical std printers so the app surface and the runner share
# one outcome classification (SKIP / CRASHED / TIMEOUT / ...). The former local
# copy was SKIP-unaware and drifted from what the runner actually prints.

export use std.test_runner.test_runner_output.{print_result_default, print_result_doc, print_result, print_summary}
