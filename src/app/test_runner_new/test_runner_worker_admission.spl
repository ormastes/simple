# Resolve test-runner concurrency before the shared scheduler is configured.
# Explicit --max-workers remains the request; host max_threads is an upper bound
# for both explicit and automatic worker counts.

use app.cli.shard_mem_clamp.{shard_host_threads_cap}

pub fn test_runner_admitted_worker_count(requested: i64, automatic: i64,
        host_max_threads: text) -> i64:
    var workers = requested
    if workers <= 0:
        workers = automatic
        if workers < 1:
            workers = 1
        # Preserve the runner's existing safety ceiling for auto-detection.
        if workers > 8:
            workers = 8
    shard_host_threads_cap(workers, host_max_threads)

export test_runner_admitted_worker_count
