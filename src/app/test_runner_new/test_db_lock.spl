# Test Database File Locking
#
# PID-based file locking with timeout and stale lock detection.
# Uses file_lock/file_unlock SFFI for OS-level locking.

use std.nogc_sync_mut.io.file_ops.{file_lock, file_unlock}

# =========================================================================
# FileLock
# =========================================================================

struct FileLock:
    handle: i64
    path: text

impl FileLock:
    static fn acquire(path: text, timeout_secs: i64) -> FileLock?:
        # Lock a sidecar `.lock` file so reads, backups, and atomic renames on
        # `path` succeed under Windows mandatory byte-range locks.
        val lock_path = "{path}.lock"
        val handle = file_lock(lock_path, timeout_secs)
        if handle < 0:
            eprint("Failed to acquire lock for {path} (timeout: {timeout_secs}s)")
            return None
        Some(FileLock(handle: handle, path: path))

    fn release() -> bool:
        if self.handle < 0:
            return false
        file_unlock(self.handle)

    fn is_valid() -> bool:
        self.handle >= 0

