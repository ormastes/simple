# Fault boundary for spec-source preprocessing (runner_inprocess_spec_lexing_has_no_fault_boundary_2026-09-13).
# The runner executes this in a CHILD process before it lexes a spec in its own
# process: a spec whose source defeats the lexer (stack overflow, segfault)
# kills only this child and is reported as one FAIL; the sweep continues.
use std.sffi.cli_args.{cli_get_args}
use std.io_runtime.{file_read_text}
use compiler.frontend.core.source_facts.{simple_code_lines, simple_string_continuation_lines}

fn main() -> i64:
    var path = ""
    for arg in cli_get_args():
        if arg.starts_with("--file="):
            path = arg[7:]
    if path == "":
        print "preprocess-probe: missing --file="
        return 2
    val source = file_read_text(path) ?? ""
    val code_lines = simple_code_lines(source)
    val cont_lines = simple_string_continuation_lines(source)
    print "PREPROCESS_PROBE_OK lines={code_lines.len()} cont={cont_lines.len()}"
    0
