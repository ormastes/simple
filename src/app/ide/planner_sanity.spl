# Planner capability sanity probe.
#
# Runs against app.office.planner directly so the feature-check row reports real
# behavior instead of "manifest-only". Mirrors ide_agent_dashboard_summary.

use app.office.planner.planner_app.{PlannerApp}
use common.ui.widget.{UIEvent}

fn ide_planner_summary() -> text:
    var app = PlannerApp.new()
    val view_before = app.active_view
    # Adding a task must actually grow the project.
    val before = app.project.tasks.len()
    app.handle_event(UIEvent.Action("add_task"))
    val after = app.project.tasks.len()
    val added = after > before
    # Every declared view must be reachable, and an unknown one must not stick.
    var views = 0
    for v in ["kanban", "list", "calendar", "timeline"]:
        app.switch_view(v)
        if app.active_view == v:
            views = views + 1
    app.switch_view("nope")
    val rejects_unknown = app.active_view == "timeline"
    "planner: app.office.planner tasks={before}->{after} add={added} views={views}/4 reject-unknown={rejects_unknown} default-view={view_before}"
