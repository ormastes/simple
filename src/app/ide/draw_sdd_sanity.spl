# Draw/SDD capability sanity probe.
#
# Runs against std.editor.services.sdn_graph directly so the feature-check row
# reports real behavior instead of "manifest-only". Mirrors ide_mail_summary.

use std.editor.services.sdn_graph.{sdn_graph_parse, sdn_graph_to_canonical_sdn, sdn_graph_render_html}

# Dense-syntax graph exercising node metadata, both edge operators, and a weave
# rule that must rewrite the matching node's style and shape.
fn _ide_draw_sdd_source() -> text:
    val lines = [
        "graph: pipeline",
        "direction: LR",
        "parse: Parser @core role: stage",
        "lower: Lowering @core role: stage",
        "emit: Emit role: sink",
        "parse -> lower: hir",
        "lower ~> emit: mir",
        "weave @:",
        "    node where role = \"sink\":",
        "        add: highlight",
        "        shape: box"
    ]
    lines.join("\n")

fn ide_draw_sdd_summary() -> text:
    val graph = sdn_graph_parse(_ide_draw_sdd_source())
    val nodes = graph.nodes.len()
    val edges = graph.edges.len()
    # The weave rule must have reached the role=sink node and only that node.
    var weaved = false
    for node in graph.nodes:
        if node.role == "sink" and node.css == "highlight" and node.shape == "box":
            weaved = true
    # The async operator must survive parsing as a distinct edge kind.
    var async_edges = 0
    for edge in graph.edges:
        if edge.kind == "async":
            async_edges = async_edges + 1
    # Canonical SDN must round-trip back through the table parser unchanged.
    val again = sdn_graph_parse(sdn_graph_to_canonical_sdn(graph))
    val rt_nodes = again.nodes.len()
    val rt_edges = again.edges.len()
    val html = sdn_graph_render_html(graph)
    val html_nodes = html.split("sdn-graph-node").len() - 1
    "draw-sdd: std.editor.services.sdn_graph nodes={nodes} edges={edges} async={async_edges} weave={weaved} canonical={rt_nodes}/{rt_edges} html-nodes={html_nodes}"
