fn ide_capability_count() -> i64:
    ide_capabilities().len()

fn ide_capability_ids() -> [text]:
    var ids: [text] = []
    for cap in ide_capabilities():
        ids.push(cap.id)
    ids

fn ide_capability_report() -> [text]:
    var lines: [text] = []
    for cap in ide_capabilities():
        val compat = cap.compatible_with.join(", ")
        lines.push(cap.id + ": " + cap.label + " [" + cap.plugin_kind + "] -> " + cap.owner_module + " (" + compat + ")")
        lines.push("  check: " + cap.feature_check)
    lines

# Returns true when a capability entry has non-empty required fields.
fn ide_capability_valid(cap: IdeCapability) -> bool:
    cap.id != "" and cap.label != "" and cap.owner_module != "" and cap.plugin_kind != ""

# Returns true when both preview pane dimensions are positive (sane defaults).
fn ide_preview_bounds_valid(width: i64, height: i64) -> bool:
    width > 0 and height > 0

# Returns the count of capabilities that pass ide_capability_valid.
fn ide_capability_valid_count() -> i64:
    var count: i64 = 0
    for cap in ide_capabilities():
        if ide_capability_valid(cap):
            count = count + 1
    count

# ---- live capability truth (kernel-backed) --------------------------------

# True when `tag` identifies `manifest` via a contributed language id/file
# extension, or the manifest's own name. Substring match on language id lets
# related tags (e.g. "sdn" / "sdn-graph") line up without a hardcoded table.
fn _ide_manifest_matches_tag(manifest: ExtensionManifest, tag: text) -> bool:
    if tag == "":
        return false
    for lang in manifest.contributes_languages:
        if lang.id == tag or lang.id.contains(tag) or tag.contains(lang.id):
            return true
        for ext in lang.extensions:
            if ext.contains(tag):
                return true
    manifest.name.contains(tag)

fn _ide_capability_manifest_for(compatible_with: [text], manifests: [ExtensionManifest]) -> ExtensionManifest?:
    for tag in compatible_with:
        for m in manifests:
            if _ide_manifest_matches_tag(m, tag):
                return Some(m)
    None

fn _ide_capability_first_command_id(manifest: ExtensionManifest) -> text:
    if manifest.contributes_commands.len() == 0:
        return ""
    manifest.contributes_commands[0].id

# First contributed command that actually has a handler on this host, or "" if
# none does. `bound` deliberately asks about ANY contributed command rather
# than the first one: declaration order is arbitrary, and markdown is the
# proof -- it declares `md.preview` first (no handler, it is a view command)
# while its five real handlers sit on `markdown.toggle_bold` and friends.
# Probing index 0 alone would report the whole extension unbound because of
# how its manifest happens to be ordered.
fn _ide_capability_bound_command_id(manifest: ExtensionManifest, host: ExtensionHost) -> text:
    for cmd in manifest.contributes_commands:
        if host.command_handler_registered(cmd.id):
            return cmd.id
    ""

# Synthetic probe token for capabilities with no builtin manifest yet, so
# `feature_check` always names the id that was (unsuccessfully) probed.
fn _ide_capability_smoke_token(id: text) -> text:
    id.replace("-", ".") + ".smoke"

fn _ide_capability_with_live_state(cap: IdeCapability, host: ExtensionHost, manifests: [ExtensionManifest]) -> IdeCapability:
    match _ide_capability_manifest_for(cap.compatible_with, manifests):
        case Some(m):
            val command_id = _ide_capability_first_command_id(m)
            var state = "indexed"
            var checked = if command_id != "": command_id else: m.name
            if command_id != "":
                host.activate_command(command_id)
            if command_id != "" and host.is_active(m.name):
                state = "activatable"
                val bound_id = _ide_capability_bound_command_id(m, host)
                if bound_id != "":
                    state = "bound"
                    checked = bound_id
            IdeCapability(
                id: cap.id,
                label: cap.label,
                plugin_kind: cap.plugin_kind,
                owner_module: cap.owner_module,
                compatible_with: cap.compatible_with,
                feature_check: checked,
                state: state
            )
        case None:
            IdeCapability(
                id: cap.id,
                label: cap.label,
                plugin_kind: cap.plugin_kind,
                owner_module: cap.owner_module,
                compatible_with: cap.compatible_with,
                feature_check: _ide_capability_smoke_token(cap.id),
                state: "declared"
            )

# Recompute `state`/`feature_check` for one capability entry against a fresh
# extension host. Intended for probing a SINGLE (possibly fabricated)
# capability id in tests; `ide_capabilities_live()` shares one host instead.
fn ide_capability_live_state(cap: IdeCapability) -> IdeCapability:
    val host = extension_host_with_builtin_handlers()
    val manifests = builtin_manifest_providers()
    _ide_capability_with_live_state(cap, host, manifests)

# Live variant of ide_capabilities(): recomputes `state` and `feature_check`
# against the real extension kernel. Not cheap (builds an ExtensionHost) --
# call this from reports/specs, not hot paths. ide_capabilities() itself stays
# static so callers that only need id/label/owner metadata pay nothing extra.
fn ide_capabilities_live() -> [IdeCapability]:
    val host = extension_host_with_builtin_handlers()
    val manifests = builtin_manifest_providers()
    var out: [IdeCapability] = []
    for cap in ide_capabilities():
        out.push(_ide_capability_with_live_state(cap, host, manifests))
    out
