# IDE capability registry.
#
# This is product-level metadata only: each capability points at the existing
# implementation owner so the IDE can expose app/plugin support without forking
# renderers, document models, spreadsheets, slide decks, dashboards, or DB code.
#
# `state` is capability TRUTH, not aspiration. The static `ide_capabilities()`
# list stays cheap (`state: "declared"` for every row, no kernel calls). Call
# `ide_capabilities_live()` (or `ide_capability_live_state()` for one entry) to
# recompute `state` against the real extension kernel:
#   declared    -> static entry only (this list), no builtin backs it yet.
#   indexed     -> a builtin manifest (builtin_manifest_providers()) declares
#                  a matching language/command for one of `compatible_with`.
#   activatable -> extension_host_with_builtin_handlers() has that extension
#                  active.
#   bound       -> a real CommandRegistry handler (contributed by the
#                  extension itself, not by this probe) is registered for AT
#                  LEAST ONE of the extension's contributed commands, and is
#                  reachable via host.dispatch_command. `feature_check` names
#                  the command that satisfied it, not a fixed index. Nothing
#                  here writes a handler -- see
#                  doc/08_tracking/bug/builtin_extensions_activate_eagerly_2026-07-30.md
#                  "CRITICAL" for why the old self-registering probe made
#                  "bound" unfalsifiable, and why it was removed 2026-07-31.
#
# The census builds its host via extension_host_with_builtin_handlers() so it
# inspects the same dispatchable host the editor runs on. Before 2026-07-31 it
# built a bare extension_host_with_builtins(), while EditorController.new()
# registered the builtin handlers on a host it kept to itself -- so the census
# was reporting on a host nobody used.

use std.editor.extensions.manifest.{ExtensionManifest}
use std.editor.extensions.builtin.index.{builtin_manifest_providers}
use std.editor.extensions.host.{ExtensionHost, extension_host_with_builtin_handlers}

struct IdeCapability:
    id: text
    label: text
    plugin_kind: text
    owner_module: text
    compatible_with: [text]
    feature_check: text
    state: text

fn ide_capability_new(id: text, label: text, plugin_kind: text, owner_module: text, compatible_with: [text], feature_check: text) -> IdeCapability:
    IdeCapability(
        id: id,
        label: label,
        plugin_kind: plugin_kind,
        owner_module: owner_module,
        compatible_with: compatible_with,
        feature_check: feature_check,
        state: "declared"
    )

fn ide_capabilities() -> [IdeCapability]:
    [
        ide_capability_new(
            "sheets",
            "Calc Spreadsheet",
            "office-app",
            "app.office.sheets",
            ["excel", "xlsx", "tabular", "csv"],
            ""
        ),
        ide_capability_new(
            "markdown",
            "Markdown/Writer",
            "document-renderer",
            "std.editor.render.md_renderer",
            ["md", "markdown", "writer", "html"],
            ""
        ),
        ide_capability_new(
            "slides",
            "Impress/PPT",
            "office-app",
            "app.office.slides",
            ["ppt", "presentation", "slides"],
            ""
        ),
        ide_capability_new(
            "draw-sdd",
            "Draw/SDD",
            "diagram-app",
            "std.editor.services.sdn_graph",
