# Simple IDE entrypoint.
#
# Thin VS Code-like product entry that reuses the shared editor launch contract.
# The heavy controller/rendering logic remains in src/app/editor and
# src/lib/editor so embedded and example IDEs consume the same reusable core.

use std.cli.cli_util (get_cli_args)
use std.editor.core.launch.*
use std.editor.core.session.{EditSession}
use app.ide.feature_report.{ide_feature_check_report}
use app.editor.gui_shell.{gui_shell_run_profile, gui_shell_run_sdl_profile}
use app.editor.gui_shell_render.{IdeGuiFrame, ide_render_gui_frame}
use app.editor.tui_shell.{editor_tui_run_profile}
use app.editor.profile_plan.{profile_activation_plan}

struct IdeFrameCliFlags:
    frame_once: bool
    backend: text
    remaining: [text]

fn _ide_strip_frame_args(args: [text]) -> IdeFrameCliFlags:
    var frame_once = false
    var backend = "software"
    var rest: [text] = []
    var i: i64 = 0
    while i < args.len():
        val a = args[i]
        if i == 0 and a == "--":
            i = i + 1
            continue
        if a == "--gui-frame-once":
            frame_once = true
        elif a == "--backend" and i + 1 < args.len():
            backend = args[i + 1]
            i = i + 1
        elif a.starts_with("--backend="):
            backend = a[10:a.len()]
        else:
            rest.push(a)
        i = i + 1
    IdeFrameCliFlags(frame_once: frame_once, backend: backend, remaining: rest)

fn main() -> i64:
    run_ide_cli(get_cli_args())

fn run_ide_cli(raw_args: [text]) -> i64:
    """Run the IDE command with arguments owned by the IDE.

    The unified CLI delegates here before shared log-option filtering so
    `--tui` remains an IDE launch-mode flag instead of being consumed as a
    global output-mode flag.
    """
    val cleaned = editor_launch_clean_log_args(raw_args)
    val frame_flags = _ide_strip_frame_args(cleaned)
    val args = frame_flags.remaining
    if not frame_flags.frame_once and args.len() == 0:
        ide_print_help()
        return 0
    if args.len() > 0 and (args[0] == "--help" or args[0] == "-h"):
        ide_print_help()
        return 0
    if args.len() > 0 and (args[0] == "--version" or args[0] == "-v"):
        print "Simple IDE v0.1.0"
        return 0
    if args.len() > 0 and args[0] == "--feature-check":
        val launch = editor_launch_parse(args.slice(1, args.len()))
        for line in ide_feature_check_report(launch.mode):
            print line
        return 0
    val launch = editor_launch_parse(args)
    if launch.unknown_option != "":
        print "Error: unknown option '" + launch.unknown_option + "'"
        print ""
        ide_print_help()
        return 1
    val plan = profile_activation_plan(launch.profile)
    if not plan.ok:
        print "Error: {plan.error}"
        return 1
    if frame_flags.frame_once:
        val session = _ide_session_for(launch)
        val frame = ide_render_gui_frame(session, launch.profile, 960, 600, frame_flags.backend)
        print "ide-gui-frame: profile={frame.profile} backend={frame.resolved_backend} source={frame.readback_source} cpu_fallback={frame.cpu_fallback_used} width={frame.width} height={frame.height} checksum={frame.checksum}"
        if frame.pixels.len() == 0:
            return 1
        return 0
    if args.contains("--gui-sdl"):
        gui_shell_run_sdl_profile(_ide_session_for(launch), launch.profile)
        return 0
    if args.contains("--gui"):
        gui_shell_run_profile(_ide_session_for(launch), launch.profile)
        return 0
    if args.contains("--tui"):
        editor_tui_run_profile(_ide_session_for(launch), launch.profile)
        return 0
    print "Simple IDE v0.1.0"
    print "Ready for {launch.mode} IDE startup with {launch.files.len()} file(s)."
    0

fn _ide_session_for(launch: EditorLaunchOptions) -> EditSession:
    var session = EditSession.new()
    for path in launch.files:
        session.open_file(path)
    if session.documents.len() == 0:
        session.open_empty()
    session

fn ide_print_help():
    print "Simple IDE"
    print ""
    print "Usage: simple ide [options] [workspace-or-file ...]"
    print ""
    print "Options:"
    print "  -h, --help         Show this help message"
    print "  -v, --version      Show version information"
    print "  --tui              Select terminal IDE mode"
    print "  --gui              Select GUI mode"
    print "  --gui-sdl          Select SDL GUI mode"
    print "  --gui-frame-once   Render one headless desktop Engine2D GUI frame"
    print "  --backend <name>   Engine2D backend for --gui-frame-once (software|vulkan)"
    print "  --feature-check    Print IDE plugin/app capability checks"
    print "  --profile <name>   Narrow which apps/extensions activate (editor, caret)"

export run_ide_cli
