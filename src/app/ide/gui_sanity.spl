# IDE GUI sanity surface.
#
# Uses the existing editor GUI backend and editor-area renderer. This adapter is
# intentionally probe-only so feature checks do not start a GUI event loop.

use std.editor.backend.gui_backend.{gui_backend_default_config}
use std.common.markdown.render.{render_markdown_line_html}

struct IdeGuiSanity:
    theme: text
    width: i64
    height: i64
    renders_markdown: bool
    renders_presentation: bool
    renders_sheet: bool
    has_backend_config: bool

fn ide_gui_sanity() -> IdeGuiSanity:
    val config = gui_backend_default_config()
    val markdown_source = "# GUI\n\nBody"
    val presentation_source = "---\nlayout: presentation\n---\n\n## Slide One\n\nBody"
    val sheet_source = "---\nlayout: spreadsheet\n---\n\n| A | B |\n|---|---|\n| 1 | 2 |"
    # Keep the deployed feature check on scalar render values. Phase-3 cannot
    # safely move BlockModel aggregates through the full document renderer ABI.
    val markdown_html = render_markdown_line_html("# GUI")
    IdeGuiSanity(
        theme: config.theme,
        width: config.initial_width,
        height: config.initial_height,
        renders_markdown: markdown_html.contains("<h1>") and markdown_html.contains("GUI"),
        renders_presentation: presentation_source.contains("layout: presentation") and render_markdown_line_html("## Slide One").contains("Slide One"),
        renders_sheet: sheet_source.contains("layout: spreadsheet") and render_markdown_line_html("| A | B |").contains("A"),
        has_backend_config: config.window_title == "Simple Editor" and config.initial_width > 0 and config.initial_height > 0
    )

fn ide_gui_sanity_summary() -> text:
    val sanity = ide_gui_sanity()
    "gui-backend: theme={sanity.theme} size={sanity.width}x{sanity.height} md={sanity.renders_markdown} ppt={sanity.renders_presentation} sheet={sanity.renders_sheet} config={sanity.has_backend_config}"

# Returns true when the backend config has sane (positive) window dimensions.
# In headless environments the config is still returned but a display may be
# absent; this helper lets probes degrade gracefully instead of crashing.
fn ide_gui_bounds_valid() -> bool:
    val config = gui_backend_default_config()
    config.initial_width > 0 and config.initial_height > 0
