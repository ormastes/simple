# SAML analysis capability for the Simple IDE.
#
# Renders the same `SamlAnalysis` the CLI and the LSP serve, so the editor
# panel, the hover card, and an agent all read one source of truth. Mirrors
# ide_math_summary: the probe runs the real library rather than reporting
# manifest-only status.
#
# Three surfaces, matching how an editor consumes analysis:
#   ide_saml_diagnostics  -> line-anchored findings for inline squiggles
#   ide_saml_hover        -> the block for one function, for a hover card
#   ide_saml_panel        -> the whole-module view for a side panel
#
# Design: doc/05_design/infra/llm/saml_baml_integration_research_design_plan_2026-08-09.md

use std.common.saml.parser.{parse_saml}
use std.common.saml.analysis.{analyze_module, analyze_module_with_specs, SamlAnalysis}
use std.common.saml.emit.{emit_analysis_report, emit_markdown_manual}

# Diagnostics an editor can attach to a line. Format is `line:severity:message`
# so a plugin can split on the first two colons without a parser.
fn ide_saml_diagnostics(source: text, path: text) -> [text]:
    """Line-anchored SAML findings for inline editor diagnostics."""
    val module = parse_saml(source, path)
    val analysis = analyze_module(module)
    var out: [text] = []
    for d in module.diagnostics:
        out.push(d.line.to_text() + ":" + d.severity + ":" + d.code + ": " + d.message)
    for fun in analysis.functions:
        for w in fun.warnings:
            out.push(fun.line.to_text() + ":warning:" + w)
    for w in analysis.module_warnings:
        out.push("1:warning:" + w)
    out

# The hover card for one function: signature, schema reach, evidence, findings.
fn ide_saml_hover(source: text, path: text, function_name: text) -> [text]:
    """Render the hover card lines for a single llm fn, or a not-found note."""
    val module = parse_saml(source, path)
    val analysis = analyze_module(module)
    for a in analysis.functions:
        if a.name == function_name:
            var lines: [text] = []
            lines.push(a.signature)
            lines.push("client " + a.client + " · parse " + a.parse_strictness + " · traced " + a.traced.to_text())
            lines.push("schema " + a.reachable_types.join(", "))
            lines.push("evidence " + a.evidence_state + " · tests " + a.covering_tests.len().to_text() + " · examples " + a.example_count.to_text() + " · counter " + a.counter_example_count.to_text())
            if a.sensitive_fields.len() > 0:
                lines.push("sensitive " + a.sensitive_fields.join(", "))
            for w in a.warnings:
                lines.push("! " + w)
            return lines
    ["no llm fn named " + function_name + " in " + path]

fn ide_saml_panel(source: text, path: text) -> [text]:
    """Whole-module analysis lines for the IDE side panel."""
    val module = parse_saml(source, path)
    val analysis = analyze_module(module)
    emit_analysis_report(analysis).split("\n")

fn ide_saml_manual(source: text, path: text) -> text:
    """Generated Markdown manual, for the IDE's document preview pane."""
    val module = parse_saml(source, path)
    val analysis = analyze_module(module)
    emit_markdown_manual(module, analysis)

# Whole-module analysis lines, but with evidence enriched by real sspec unit
# tests: `spec_paths`/`spec_sources` are pre-read `test/**/*_spec.spl` files
# (parallel arrays, same convention as `analysis.analyze_module_with_specs`).
# Wired directly into A2's `analyze_module_with_specs` — the merge here is
# a direct call, not a standalone reimplementation.
fn ide_saml_evidence(source: text, path: text, spec_paths: [text], spec_sources: [text]) -> [text]:
    """Whole-module analysis lines with external sspec coverage folded in."""
    val module = parse_saml(source, path)
    val analysis = analyze_module_with_specs(module, spec_paths, spec_sources)
    emit_analysis_report(analysis).split("\n")

# A self-contained probe over a module that deliberately contains one clean
# function and one defective one, so the row reports real detection counts
# rather than "loaded successfully".
fn ide_saml_analysis_summary() -> text:
    # NOTE: a `{...}` pair inside one literal is string interpolation, so the
    # prompt placeholders are spliced across two literals.
    val open_var = "{{ resume_text "
    val close_var = "}}"
    val open_fmt = "{{ saml.output_format "
    var src = "module ide.probe\n"
    src = src + "\n"
    src = src + "class Resume:\n"
    src = src + "    name: text @alias(\"candidate_name\") @sensitive(pii)\n"
    src = src + "\n"
    src = src + "# example: Extract(\"Grace Hopper\") => name == \"Grace Hopper\"\n"
    src = src + "# counter-example: Extract(\"\") => error, no fabricated name\n"
    src = src + "@trace\n"
    src = src + "@redact(input.resume_text: hash)\n"
    src = src + "llm fn Extract(resume_text: text) -> Resume:\n"
    src = src + "    client: Prod\n"
    src = src + "    prompt:\n"
    src = src + "        \"\"\"\n"
    src = src + "        " + open_var + close_var + "\n"
    src = src + "        " + open_fmt + close_var + "\n"
    src = src + "        \"\"\"\n"
    src = src + "\n"
    src = src + "llm fn Weak(resume_text: text) -> Resume:\n"
    src = src + "    client: Prod\n"
    src = src + "    prompt:\n"
    src = src + "        \"\"\"\n"
    src = src + "        " + "{{ missing " + close_var + "\n"
    src = src + "        \"\"\"\n"
    src = src + "\n"
    src = src + "test ExtractCase:\n"
    src = src + "    functions:\n"
    src = src + "        - Extract\n"
    src = src + "    evidence:\n"
    src = src + "        source: fixture\n"

    val path = "ide-probe.saml"
    val module = parse_saml(src, path)
    val analysis = analyze_module(module)
    val diagnostics = ide_saml_diagnostics(src, path)

    var strong = ""
    var weak = ""
    for a in analysis.functions:
        if a.name == "Extract":
            strong = a.evidence_state
        if a.name == "Weak":
            weak = a.evidence_state

    var checks = 0
    # The well-evidenced function reaches red_proven and raises nothing.
    if strong == "red_proven":
        checks = checks + 1
    # The defective one is caught, not merely listed.
    if weak == "unevidenced":
        checks = checks + 1
    # Its unbound prompt variable is reported against its own line.
    var found_unbound = false
    for d in diagnostics:
        if d.contains("unbound variable"):
            found_unbound = true
    if found_unbound:
        checks = checks + 1
    # Sensitive reach is tracked and the redacted function is not flagged.
    if analysis.functions.len() == 2 and analysis.error_count == 0:
        checks = checks + 1

    # A spec-derived external coverage entry for `Extract` shows up in the
    # evidence-enriched report, proving ide_saml_evidence actually merges
    # sspec coverage rather than just re-rendering the plain report.
    val spec_path = "test/a4_ide_saml_probe_spec.spl"
    val spec_source = "it \"extracts a resume\":\n    Extract(resume_text: \"x\")\n"
    val evidence_lines = ide_saml_evidence(src, path, [spec_path], [spec_source])
    var found_external = false
    for l in evidence_lines:
        if l.contains("external:" + spec_path):
            found_external = true
    if found_external:
        checks = checks + 1

    val fns = analysis.functions.len()
    val diags = diagnostics.len()
    "saml: std.common.saml functions={fns} diagnostics={diags} strong={strong} weak={weak} checks={checks}/5"

export ide_saml_diagnostics, ide_saml_hover, ide_saml_panel, ide_saml_manual
export ide_saml_evidence
export ide_saml_analysis_summary
