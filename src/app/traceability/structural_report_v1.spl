"""The structural producer reports claims about captured inputs, never evidence eligibility."""

use app.traceability.core.{TraceabilityWarning, analyze_virtual_files_bounded_v1}
use app.traceability.capture_v1.{TraceCapturedInputsV1}
use app.traceability.cli_options_v1.{TraceCliOptionsV1}
use std.common.crypto.sha256.{sha256_text}
use std.common.traceability.types_v1.{TraceQualificationV1, TraceSnapshotV1,
    TraceSelectionV1, TraceEvaluationV1, TraceDiagnosticV1}

pub fn trace_evaluate_captured_v1(inputs: TraceCapturedInputsV1, scope: text,
    max_diagnostics: i64) -> Result<[TraceabilityWarning], text>:
    analyze_virtual_files_bounded_v1(inputs.files, scope, inputs.config, true, max_diagnostics)

pub fn trace_qualification_from_structural_result_v1(snapshot_id: text,
    options: TraceCliOptionsV1, warnings: [TraceabilityWarning]) -> TraceQualificationV1:
    var diagnostics: [TraceDiagnosticV1] = []
    for warning in warnings:
        # The legacy checker supplies a line but no exact column. A complete
        # span is unavailable; do not invent a column or graph entity.
        diagnostics.push(TraceDiagnosticV1(code: warning.code, severity: "warning",
            entity: "observed-path:" + sha256_text(warning.path),
            path: warning.path, path_available: warning.path != "",
            span_available: false, line: 0, column: 0, message: warning.message,
            snapshot_id: snapshot_id, rule_version: "legacy-structural/v1",
            origin: "app.traceability.core/analyze_parsed_traceability_v1; materialized worktree reads",
            repair: "Correct the reported structural link or path and rerun traceability-check"))
    TraceQualificationV1(snapshot: TraceSnapshotV1(id: snapshot_id, kind: "worktree", complete: true),
        selection: TraceSelectionV1(paths: options.paths, full_repository: options.paths.len() == 0),
        evaluation: TraceEvaluationV1(scope: options.scope, profile: "worktree", kind: "structural",
            complete: true, exit_code: if warnings.len() == 0: 0 else: 1, qualification: "incomplete"),
        diagnostics: diagnostics)

pub fn trace_qualification_infrastructure_v1(snapshot_id: text, snapshot_complete: bool,
    options: TraceCliOptionsV1, code: text, path: text, message: text) -> TraceQualificationV1:
    val diagnostic = TraceDiagnosticV1(code: code, severity: "error",
        entity: if path == "": "capture" else: "observed-path:" + sha256_text(path),
        path: path, path_available: path != "", span_available: false, line: 0, column: 0,
        message: message, snapshot_id: snapshot_id, rule_version: "materialized-worktree/v1",
        origin: "app.traceability.capture_v1/structural_report_v1",
        repair: "Resolve the input, provider or budget failure and rerun traceability-check")
    TraceQualificationV1(snapshot: TraceSnapshotV1(id: snapshot_id, kind: "worktree", complete: snapshot_complete),
        selection: TraceSelectionV1(paths: options.paths, full_repository: options.paths.len() == 0),
        evaluation: TraceEvaluationV1(scope: options.scope, profile: "worktree", kind: "structural",
            complete: false, exit_code: 2, qualification: "incomplete"),
        diagnostics: [diagnostic])

export trace_evaluate_captured_v1, trace_qualification_from_structural_result_v1
export trace_qualification_infrastructure_v1
