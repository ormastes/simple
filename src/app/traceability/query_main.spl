# Direct compiled CLI handler; capture and query never re-read source to render.
use std.common.traceability.query_nodes_v1.{TraceNodeQueryV1, query_trace_nodes_v1}
use app.traceability.query_options_v1.{trace_query_options_parse_v1, trace_query_help_v1, trace_query_sdn_requested_v1}
use app.traceability.query_snapshot_v1.{trace_query_build_snapshot_v1}
use app.traceability.query_render_v1.{trace_query_render_v1, trace_query_error_v1}

fn query_print_v1(output: text):
    if output.ends_with("\n"): print output.substring(0, output.len() - 1)
    else: print output

pub fn trace_query_error_exit_v1(reason: text) -> i64:
    if reason.starts_with("TRACE-QUERY-NOT-FOUND:"): 1 else: 2

pub fn run_trace_query_v1(args: [text]) -> i64:
    val options = match trace_query_options_parse_v1(args):
        case Ok(value): value
        case Err(reason):
            # Even malformed SDN requests produce a structured error, not mixed stdout.
            val format = if trace_query_sdn_requested_v1(args): "sdn" else: "table"
            query_print_v1(trace_query_error_v1(reason, "unresolved", format))
            return 2
    if options.help:
        query_print_v1(trace_query_help_v1())
        return 0
    val build = match trace_query_build_snapshot_v1(options):
        case Ok(value): value
        case Err(reason):
            query_print_v1(trace_query_error_v1(reason, options.snapshot, options.format))
            return 2
    val page = match query_trace_nodes_v1(build.graph, TraceNodeQueryV1(
        snapshot_id: build.graph.subject.snapshot_id, operation: options.operation,
        kind: options.kind, selected_id: options.selected_id, id_prefix: options.id_prefix,
        limit: options.limit, cursor: options.cursor)):
        case Ok(value): value
        case Err(reason):
            query_print_v1(trace_query_error_v1(reason, build.graph.subject.snapshot_id, options.format, true))
            return trace_query_error_exit_v1(reason)
    val output = trace_query_render_v1(build, page, options)
    if output.len() > 1048576:
        query_print_v1(trace_query_error_v1("TRACE-QUERY-BUDGET: response exceeds 1 MiB; narrow the page", build.graph.subject.snapshot_id, options.format, true))
        return 2
    query_print_v1(output)
    if not build.graph.complete: return 1
    0
