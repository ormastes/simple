# Production query composition: immutable capture -> canonical extraction/resolution.
use std.common.traceability.model.*
use app.traceability.query_options_v1.{TraceQueryOptionsV1}
use app.traceability.snapshot.git_provider.{GitSnapshotRequest, snapshot_git_inputs}
use app.traceability.snapshot.query_scope_v1.{trace_query_default_declarations_v1, trace_query_closure_paths_v1}
use app.traceability.snapshot.worktree_query_v1.{trace_worktree_query_inputs_v1}
use app.traceability.extract.snapshot_pipeline.{TraceSnapshotScope, TraceSnapshotBuild, build_snapshot_trace_graph_with_sidecar_v1}
use app.traceability.snapshot.legacy_bug_db_v1.{trace_legacy_bug_db_capture_v1}
use app.traceability.snapshot.spec_annotations_v1.{trace_spec_annotations_capture_v1}
use std.common.traceability.legacy_bugs_v1.{LegacyBugRowV1, legacy_bug_nodes_v1}
use std.common.traceability.sidecar_v1.{TraceSidecarSourceV1, TraceSidecarReferenceV1, legacy_bug_sidecar_source_v1, legacy_bug_sidecar_references_v1}

pub fn trace_query_build_snapshot_v1(options: TraceQueryOptionsV1) -> Result<TraceSnapshotBuild, text>:
    val declarations = if options.declarations.len() == 0: trace_query_default_declarations_v1() else: options.declarations
    if options.snapshot != "worktree" and options.spec_roots.len() > 0:
        return Err("TRACE-QUERY-UNAVAILABLE: spec-root scanning is a worktree-preview sidecar")
    var snapshot: SnapshotInput
    if options.snapshot == "worktree":
        snapshot = trace_worktree_query_inputs_v1(declarations, options.paths)?
    else:
        val kind = if options.snapshot == "index": "git_index" else: "git_commit"
        val selector = if options.snapshot == "index": "index" else: options.snapshot.substring(4, options.snapshot.len())
        val initial = snapshot_git_inputs(GitSnapshotRequest(repository: ".", selector: selector,
            paths: declarations, max_entries: 256, max_blob_bytes: 1048576, max_total_bytes: 2097152, snapshot_kind: kind))?
        val closure = trace_query_closure_paths_v1(initial, declarations, options.paths)?
        snapshot = snapshot_git_inputs(GitSnapshotRequest(repository: ".", selector: selector,
            paths: closure, max_entries: 256, max_blob_bytes: 1048576, max_total_bytes: 2097152,
            snapshot_kind: kind, frozen_tree: initial.subject.tree_id, frozen_revision: initial.subject.revision_id))?
        if snapshot.subject.repository_id != initial.subject.repository_id or
            snapshot.subject.snapshot_id != initial.subject.snapshot_id or
            snapshot.subject.revision_id != initial.subject.revision_id:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: immutable closure changed repository or subject")
    var paths: [text] = []
    for artifact in snapshot.artifacts: paths.push(artifact.path)
    val policy = TracePolicy(id: "policy:local-registered-query/v1", authorities: [],
        max_nodes: 40000, max_claims: 100000, conventions: [])
    val scope = TraceSnapshotScope(selected_roots: trace_sorted_ids(paths), authority_id: "", closure_kind: "selected_scope")
    # Sidecars (worktree preview only, read-only, identity-bound): the legacy
    # bug DB by default, `# @req` spec headers under explicit --spec-root dirs.
    var sources: [TraceSidecarSourceV1] = []
    var nodes: [TraceNode] = []
    var diagnostics: [TraceDiagnostic] = []
    var references: [TraceSidecarReferenceV1] = []
    var rows: [LegacyBugRowV1] = []
    if options.snapshot == "worktree":
        if options.bug_db != "none":
            val legacy = trace_legacy_bug_db_capture_v1(options.bug_db, options.bug_db_explicit)?
            if legacy.?:
                val source = legacy.unwrap()
                sources.push(legacy_bug_sidecar_source_v1(source))
                nodes = legacy_bug_nodes_v1(source)
                diagnostics = source.diagnostics
                rows = source.rows
                references = legacy_bug_sidecar_references_v1(source.rows)
        if options.spec_roots.len() > 0:
            val scan = trace_spec_annotations_capture_v1(options.spec_roots)?
            for source in scan.sources: sources.push(source)
            for diagnostic in scan.diagnostics: diagnostics.push(diagnostic)
            for reference in scan.references: references.push(reference)
    var build = build_snapshot_trace_graph_with_sidecar_v1(snapshot, policy, declarations, scope, sources, nodes, diagnostics)?
    build.legacy_bugs = rows
    build.sidecar_references = references
    Ok(build)
