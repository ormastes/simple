# Exact candidate reconciliation for snapshot deltas. This adapter validates
# delta completeness then cold-builds the graph; it does not reuse cached facts.
# @req REQ-TRC-017
use std.common.traceability.model.*
use std.common.traceability.incremental.{TraceInvalidationInput, TraceInvalidation, plan_trace_invalidation}
use app.traceability.extract.snapshot_pipeline.{TraceSnapshotScope, TraceSnapshotBuild, build_snapshot_trace_graph}

pub struct TraceSnapshotDelta:
    removed_paths: [text]
    upserted_artifacts: [SnapshotArtifact]

pub struct TraceSnapshotDeltaBuild:
    build: TraceSnapshotBuild
    invalidation: TraceInvalidation
    reused_base_facts: bool

fn delta_subject_compatible(base: SnapshotSubject, candidate: SnapshotSubject) -> bool:
    base.repository_id != "" and candidate.repository_id == base.repository_id and
        candidate.object_format == base.object_format

fn snapshot_artifact_equal(left: SnapshotArtifact, right: SnapshotArtifact) -> bool:
    left.path == right.path and left.blob_id == right.blob_id and
        left.content == right.content and left.visibility == right.visibility

fn snapshot_subject_equal(left: SnapshotSubject, right: SnapshotSubject) -> bool:
    left.repository_id == right.repository_id and left.snapshot_id == right.snapshot_id and
        left.kind == right.kind and left.revision_id == right.revision_id and
        left.tree_id == right.tree_id and left.object_format == right.object_format

fn snapshot_paths_unique(artifacts: [SnapshotArtifact]) -> bool:
    var paths: Dict<text, bool> = {}
    for artifact in artifacts:
        if artifact.path == "" or paths.contains_key(artifact.path): return false
        paths[artifact.path] = true
    true

fn snapshot_exact_inventory(left: SnapshotInput, right: SnapshotInput) -> bool:
    if not left.complete or not right.complete or not snapshot_subject_equal(left.subject, right.subject): return false
    if left.artifacts.len() != right.artifacts.len() or not snapshot_paths_unique(left.artifacts) or not snapshot_paths_unique(right.artifacts): return false
    var by_path: Dict<text, SnapshotArtifact> = {}
    for artifact in left.artifacts: by_path[artifact.path] = artifact
    for expected in right.artifacts:
        if not by_path.contains_key(expected.path) or not snapshot_artifact_equal(by_path[expected.path], expected): return false
    true

fn apply_snapshot_delta(base: SnapshotInput, candidate_subject: SnapshotSubject,
    delta: TraceSnapshotDelta) -> Result<SnapshotInput, text>:
    if not base.complete or base.subject.snapshot_id == "" or not delta_subject_compatible(base.subject, candidate_subject):
        return Err("TRACE-DELTA-INCOMPLETE: compatible complete base and candidate subject required")
    if base.artifacts.len() > 40000 or delta.removed_paths.len() + delta.upserted_artifacts.len() > 40000:
        return Err("TRACE-DELTA-INCOMPLETE: artifact delta budget exhausted")
    if not snapshot_paths_unique(base.artifacts) or not snapshot_paths_unique(delta.upserted_artifacts):
        return Err("TRACE-DELTA-INCOMPLETE: duplicate or empty artifact path")
    var removed: Dict<text, bool> = {}
    for path in delta.removed_paths:
        if path == "" or removed.contains_key(path): return Err("TRACE-DELTA-INCOMPLETE: duplicate or empty removal path")
        removed[path] = true
    for artifact in delta.upserted_artifacts:
        if removed.contains_key(artifact.path): return Err("TRACE-DELTA-INCOMPLETE: path cannot be removed and upserted in one delta")
    var base_paths: Dict<text, bool> = {}
    for artifact in base.artifacts: base_paths[artifact.path] = true
    for path in delta.removed_paths:
        if not base_paths.contains_key(path): return Err("TRACE-DELTA-INCOMPLETE: removal path absent from base inventory")
    var upsert_paths: Dict<text, bool> = {}
    for artifact in delta.upserted_artifacts:
        if artifact.blob_id == "" or artifact.visibility == "": return Err("TRACE-DELTA-INCOMPLETE: invalid upsert artifact")
        upsert_paths[artifact.path] = true
    var artifacts: [SnapshotArtifact] = []
    for artifact in base.artifacts:
        if not removed.contains_key(artifact.path):
            if not upsert_paths.contains_key(artifact.path): artifacts.push(artifact)
    for artifact in delta.upserted_artifacts: artifacts.push(artifact)
    if artifacts.len() > 40000: return Err("TRACE-DELTA-INCOMPLETE: resulting inventory budget exhausted")
    Ok(SnapshotInput(subject: candidate_subject, artifacts: artifacts, complete: true))

fn exact_delta_invalidation(base: SnapshotInput, delta: TraceSnapshotDelta,
    context: TraceInvalidationInput) -> TraceInvalidation:
    var known: [text] = []
    for artifact in base.artifacts: known.push(artifact.path)
    var changed: [text] = []
    for path in delta.removed_paths: changed.push(path)
    for artifact in delta.upserted_artifacts:
        if not changed.contains(artifact.path): changed.push(artifact.path)
    plan_trace_invalidation(TraceInvalidationInput(known_paths: known, changed_paths: changed,
        changed_identities: context.changed_identities, changed_memberships: context.changed_memberships,
        changed_configurations: context.changed_configurations, dependencies: context.dependencies,
        dependency_inventory_complete: context.dependency_inventory_complete,
        policy_changed: context.policy_changed, extractor_changed: context.extractor_changed,
        schema_changed: context.schema_changed, max_affected: context.max_affected))

# The independently supplied candidate is compared field-for-field (not by
# count) before the existing full snapshot builder is allowed to run.
pub fn build_snapshot_trace_delta(base: SnapshotInput, candidate: SnapshotInput,
    delta: TraceSnapshotDelta, candidate_declarations: [text],
    policy: TracePolicy, scope: TraceSnapshotScope,
    invalidation_context: TraceInvalidationInput) -> Result<TraceSnapshotDeltaBuild, text>:
    val composed = apply_snapshot_delta(base, candidate.subject, delta)?
    if not snapshot_exact_inventory(composed, candidate):
        return Err("TRACE-DELTA-MISMATCH: composed inventory differs from exact candidate")
    # Declaration membership is explicit candidate input, never inferred from
    # the artifact count. The graph builder checks every declared path.
    if candidate_declarations.len() > 40000:
        return Err("TRACE-DELTA-INCOMPLETE: declaration budget exhausted")
    val built = build_snapshot_trace_graph(candidate, policy, candidate_declarations, scope)?
    Ok(TraceSnapshotDeltaBuild(build: built,
        invalidation: exact_delta_invalidation(base, delta, invalidation_context),
        reused_base_facts: false))
