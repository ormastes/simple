# Native-only, single-owner extraction from immutable source, without executing
# candidate code. This optional compiler provider must not enter the lightweight
# checker's closure. It destructively resets the shared frontend arena; callers
# must own the native frontend exclusively for the entire call. No thread-safe
# or interpreter-isolation guarantee is made by this interface.
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013
# This closed syntax profile rejects unsupported definitions rather than
# silently returning a partial plan. Import/source closure, binary admission,
# runtime mode selection and requirement provenance remain separate contracts.
use compiler.frontend.core.parser.{parse_module_silent_checked}
use compiler.frontend.core.lexer.{lex_init_with_path, lex_next}
use compiler.core.tokens.{TOK_EOF, TOK_ERROR, TOK_AT, TOK_INDENT, TOK_DEDENT,
    TOK_LPAREN, TOK_RPAREN, TOK_LBRACKET, TOK_RBRACKET, TOK_LBRACE, TOK_RBRACE}
use compiler.core.ast.{module_get_decls, decl_get_tag, decl_get_name, decl_get_body,
    decl_get_imports, DECL_USE, DECL_VAL}
use compiler.core.ast_expr.{expr_count, expr_get_tag, expr_get_str, expr_get_left,
    expr_get_args, expr_get_arg_names, expr_get_call_type_args, expr_get_stmts, expr_get_int, expr_get_span,
    EXPR_CALL, EXPR_IDENT, EXPR_STRING_LIT, EXPR_LAMBDA, EXPR_BLOCK, EXPR_FIELD_ACCESS, EXPR_METHOD_CALL}
use compiler.core.ast_stmt.{stmt_get_tag, stmt_get_expr, STMT_EXPR}
use compiler.core.types.{span_is_valid, span_start, span_end, span_line, span_col}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.crypto.sha256.{sha256_u8_hex}
export use std.common.traceability.sspec_inventory.{TraceSspecCase, TraceSspecInventory}

struct SspecInventoryFrame:
    expression: i64
    suite_path: [text]
    context_path: [text]
    depth: i64

fn sspec_registration_name(name: text) -> bool:
    name == "describe" or name == "context" or name == "it" or name == "test" or name == "example" or name == "slow_it"

# Lexer use is only a resource/conditional-preprocessing guard; definitions
# and selectors below come exclusively from the actual compiler AST.
fn sspec_inventory_preflight(source: text, path: text) -> Result<(), text>:
    lex_init_with_path(source, path)
    var tokens = 0
    var depth = 0
    while true:
        val kind = lex_next()
        tokens += 1
        if tokens > 65536:
            return Err("SSPEC-INVENTORY: token budget exceeded")
        if kind == TOK_ERROR:
            return Err("SSPEC-INVENTORY: lexical error")
        if kind == TOK_AT:
            return Err("SSPEC-INVENTORY: decorators and conditional preprocessing are unsupported")
        if kind == TOK_EOF: break
        if kind == TOK_INDENT or kind == TOK_LPAREN or kind == TOK_LBRACKET or kind == TOK_LBRACE:
            depth += 1
            if depth > 64: return Err("SSPEC-INVENTORY: syntax nesting budget exceeded")
        if kind == TOK_DEDENT or kind == TOK_RPAREN or kind == TOK_RBRACKET or kind == TOK_RBRACE:
            depth -= 1
            if depth < 0: return Err("SSPEC-INVENTORY: unbalanced syntax")
    Ok(())

fn sspec_colon_body(callback: i64) -> Result<[i64], text>:
    if expr_get_tag(callback) != EXPR_LAMBDA or expr_get_args(callback).len() != 0 or expr_get_int(callback) != 1:
        return Err("SSPEC-INVENTORY: only direct zero-argument colon callbacks are supported")
    val body = expr_get_stmts(callback)
    if body.len() != 1 or expr_get_tag(body[0]) != EXPR_BLOCK:
        return Err("SSPEC-INVENTORY: unsupported callback body")
    Ok(expr_get_stmts(body[0]))

pub fn extract_sspec_inventory_single_owner(test_path: text, source: text) -> Result<TraceSspecInventory, text>:
    if test_path == "" or test_path.len() > 4096 or source == "" or source.len() > 1048576:
        return Err("SSPEC-INVENTORY: invalid path or source size (maximum 1 MiB)")
    var source_bytes: [u8] = []
    for byte in source.bytes(): source_bytes.push(byte)
    validated_utf8_bytes_to_text_linear(source_bytes)?
    sspec_inventory_preflight(source, test_path)?
    # The checked entry returns true on failure; reading parser global error
    # state after crossing modules is explicitly not a reliable alternative.
    if parse_module_silent_checked(source, test_path):
        return Err("SSPEC-INVENTORY: compiler parse error")
    # Flat AST spans use source-character coordinates. Build one UTF-8 prefix
    # map, then convert each AST span in O(1), including non-ASCII prefixes.
    var byte_offsets: [i64] = [0]
    var byte_offset: i64 = 0
    for ch in source.chars():
        byte_offset += ch.len()
        byte_offsets.push(byte_offset)
    if byte_offset != source_bytes.len():
        return Err("SSPEC-INVENTORY: source character/byte mapping mismatch")
    var roots: [i64] = []
    var imported_spec = false
    for declaration in module_get_decls():
        val tag = decl_get_tag(declaration)
        val name = decl_get_name(declaration)
        if tag == DECL_USE:
            # The profile requires the unaliased canonical framework import.
            # Other imports need a frozen dependency/visibility contract before
            # their registration or shadowing effects can be admitted.
            if name != "std.spec" or decl_get_imports(declaration).len() != 0:
                return Err("SSPEC-INVENTORY: only unaliased std.spec import is supported")
            imported_spec = true
        elif tag == DECL_VAL and name.starts_with("_expr_"):
            val body = decl_get_body(declaration)
            if body.len() != 1: return Err("SSPEC-INVENTORY: invalid expression declaration")
            roots.push(body[0])
        else:
            return Err("SSPEC-INVENTORY: declarations, aliases and parameterization are unsupported")
    if not imported_spec:
        return Err("SSPEC-INVENTORY: canonical std.spec import is required")
    var frames: [SspecInventoryFrame] = []
    for i in 0..roots.len():
        frames.push(SspecInventoryFrame(expression: roots[roots.len() - 1 - i], suite_path: [], context_path: [], depth: 0))
    var accepted_callees: Dict<i64, bool> = {}
    var seen_selectors: Dict<text, bool> = {}
    var cases: [TraceSspecCase] = []
    var visited = 0
    while frames.len() > 0:
        val frame = frames[frames.len() - 1]
        frames.pop()
        visited += 1
        if visited > 65536 or frame.depth > 64:
            return Err("SSPEC-INVENTORY: definition traversal budget exceeded")
        val expression = frame.expression
        if expr_get_tag(expression) != EXPR_CALL:
            return Err("SSPEC-INVENTORY: conditional, dynamic or non-call registration is unsupported")
        val callee = expr_get_left(expression)
        if expr_get_tag(callee) != EXPR_IDENT:
            return Err("SSPEC-INVENTORY: aliases and qualified registration calls are unsupported")
        val name = expr_get_str(callee)
        if not sspec_registration_name(name):
            return Err("SSPEC-INVENTORY: unsupported registration call: " + name)
        accepted_callees[callee] = true
        val args = expr_get_args(expression)
        if expr_get_call_type_args(expression).len() != 0:
            return Err("SSPEC-INVENTORY: generic registration arguments are unsupported")
        if args.len() != 2 or expr_get_tag(args[0]) != EXPR_STRING_LIT:
            return Err("SSPEC-INVENTORY: registration requires a literal name and one colon callback")
        for arg_name in expr_get_arg_names(expression):
            if arg_name != "": return Err("SSPEC-INVENTORY: named registration arguments are unsupported")
        val literal = expr_get_str(args[0])
        # The raw parser leaves interpolation in string nodes until a later
        # expansion pass. Reject braces conservatively, even in raw literals;
        # never mistake an unexpanded dynamic name for a constant selector.
        if literal == "" or literal.contains("{") or literal.contains("}"):
            return Err("SSPEC-INVENTORY: empty or interpolated names are unsupported")
        val statements = sspec_colon_body(args[1])?
        if name == "describe" or name == "context":
            var suites = frame.suite_path
            var contexts = frame.context_path
            if name == "describe": suites.push(literal)
            else: contexts.push(literal)
            for i in 0..statements.len():
                val statement = statements[statements.len() - 1 - i]
                if stmt_get_tag(statement) != STMT_EXPR:
                    return Err("SSPEC-INVENTORY: conditional, loop, binding or parameterized registration is unsupported")
                frames.push(SspecInventoryFrame(expression: stmt_get_expr(statement), suite_path: suites,
                    context_path: contexts, depth: frame.depth + 1))
        else:
            if frame.suite_path.len() == 0:
                return Err("SSPEC-INVENTORY: a case requires a literal describe scope")
            # Match spec._execute_it: only the current (innermost) suite and
            # current context enter runtime event names. Keep full paths as
            # separate structural facts, never fabricate runtime selectors.
            var selector = frame.suite_path[frame.suite_path.len() - 1] + " > "
            if frame.context_path.len() > 0:
                selector += frame.context_path[frame.context_path.len() - 1] + " > "
            selector += literal
            if seen_selectors.contains_key(selector):
                return Err("SSPEC-INVENTORY: duplicate runtime selector: " + selector)
            seen_selectors[selector] = true
            val span = expr_get_span(expression)
            if not span_is_valid(span): return Err("SSPEC-INVENTORY: registration source span is missing")
            val first = span_start(span)
            val last = span_end(span)
            if first < 0 or last <= first or last >= byte_offsets.len() or span_line(span) < 1 or span_col(span) < 1:
                return Err("SSPEC-INVENTORY: registration source span is invalid")
            var kind = "normal"
            if name == "test": kind = "test"
            elif name == "example": kind = "example"
            elif name == "slow_it": kind = "slow"
            cases.push(TraceSspecCase(test_path: test_path, case_name: selector, leaf_name: literal,
                kind: kind, suite_path: frame.suite_path, context_path: frame.context_path,
                start_byte: byte_offsets[first], end_byte: byte_offsets[last], line: span_line(span), column: span_col(span)))
    # Catch DSL references hidden in case callbacks (nested registration),
    # aliases, or other unvisited expressions. String/comment decoys are not
    # identifiers and cannot create phantom cases. No callback is executed.
    for index in 0..expr_count():
        val tag = expr_get_tag(index)
        if (tag == EXPR_FIELD_ACCESS or tag == EXPR_METHOD_CALL) and sspec_registration_name(expr_get_str(index)):
            return Err("SSPEC-INVENTORY: qualified or aliased registration reference is unsupported")
        if tag == EXPR_IDENT and sspec_registration_name(expr_get_str(index)):
            if not accepted_callees.contains_key(index):
                return Err("SSPEC-INVENTORY: indirect or nested registration reference is unsupported")
    if cases.len() == 0: return Err("SSPEC-INVENTORY: no literal cases were declared")
    Ok(TraceSspecInventory(test_path: test_path, source_sha256: "sha256:" + sha256_u8_hex(source_bytes),
        extractor_version: "simple.sspec.literal-ast/v1", evidence_validity: "unverified", cases: cases))
