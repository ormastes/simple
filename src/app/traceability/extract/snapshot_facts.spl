# Immutable-input extraction boundary. Only registered declaration documents
# establish semantics; an ID inside prose or a quoted example creates no claim.
use std.common.traceability.model.*
use std.common.traceability.schema.{trace_path_valid}
use std.common.traceability.sdn_codec.{decode_trace_declarations}

fn artifact_trace_id(path: text) -> text:
    # A reversible path encoding keeps non-ASCII/space paths distinct without
    # inventing a cryptographic identity or case-folding Git names.
    val digits = "0123456789abcdef"
    var encoded = "artifact:"
    for byte in path.bytes():
        val value = byte.to_i64()
        encoded = encoded + digits.substring(value / 16, value / 16 + 1)
        encoded = encoded + digits.substring(value % 16, value % 16 + 1)
    encoded

fn extraction_diagnostic(subject: SnapshotSubject, code: text, path: text, reason: text) -> TraceDiagnostic:
    TraceDiagnostic(code: code, subject_id: subject.snapshot_id,
        rule_id: "snapshot-extraction-v1", entity_id: path,
        origin_id: "", message: reason, severity: "error")

fn empty_trace_facts(snapshot: SnapshotInput, manifest_id: text, generation_id: text) -> TraceFacts:
    TraceFacts(subject: snapshot.subject, input_manifest_id: manifest_id,
        nodes: [], test_definitions: [], claims: [], origins: [], locators: [], diagnostics: [],
        generation_id: generation_id, complete: snapshot.complete)

# Registered paths come from admitted policy/ownership, never from a generated
# document or a candidate's request to become an authoritative declaration.
pub fn extract_snapshot_trace_facts(snapshot: SnapshotInput, policy: TracePolicy,
    declaration_paths: [text], input_manifest_id: text, generation_id: text) -> TraceFacts:
    var facts = empty_trace_facts(snapshot, input_manifest_id, generation_id)
    if input_manifest_id == "" or generation_id == "" or snapshot.subject.snapshot_id == "":
        facts.complete = false
        facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", "", "missing immutable extraction identities"))
        return facts
    if not snapshot.complete:
        facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", "", "snapshot existence inventory is incomplete"))
    if policy.max_nodes < 1 or policy.max_claims < 1:
        facts.complete = false
        facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", "", "invalid policy extraction budgets"))
        return facts
    var seen_paths: [text] = []
    var artifact_by_path: Dict<text, SnapshotArtifact> = {}
    var loaded_declarations: [text] = []
    for artifact in snapshot.artifacts:
        if not trace_path_valid(artifact.path) or artifact.blob_id == "" or seen_paths.contains(artifact.path):
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", artifact.path, "invalid, unpinned or duplicate snapshot artifact"))
            continue
        seen_paths.push(artifact.path)
        artifact_by_path[artifact.path] = artifact
        if declaration_paths.contains(artifact.path):
            loaded_declarations.push(artifact.path)
            match decode_trace_declarations(artifact.content, snapshot.subject, artifact.path, artifact.blob_id):
                case Err(diagnostics):
                    facts.complete = false
                    for diagnostic in diagnostics:
                        facts.diagnostics.push(diagnostic)
                case Ok(declared):
                    for node in declared.nodes:
                        facts.nodes.push(node)
                    for definition in declared.test_definitions:
                        facts.test_definitions.push(definition)
                    for claim in declared.claims:
                        facts.claims.push(claim)
                    for origin in declared.origins:
                        facts.origins.push(origin)
                    for locator in declared.locators:
                        facts.locators.push(locator)
        if facts.nodes.len() > policy.max_nodes or facts.claims.len() > policy.max_claims:
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", artifact.path, "extraction policy budget exhausted"))
            return facts
    var registered: [text] = []
    for path in declaration_paths:
        if registered.contains(path) or not trace_path_valid(path):
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-AUTHORITY-CONFLICT", path, "invalid or repeated declaration registration"))
        registered.push(path)
        if not loaded_declarations.contains(path):
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-MISSING-ENDPOINT", path, "registered declaration is absent from exact snapshot"))
    # Resolve file identity before adding inventory fallbacks. A declared
    # canonical source/suite/document is the same physical artifact, not a
    # second convention candidate. Several authored owners remain ambiguous;
    # no first-match owner is selected here. Semantic sections (requirements,
    # criteria, cases) do not replace the containing file identity.
    var declared_kinds: Dict<text, TraceNodeKind> = {}
    for node in facts.nodes:
        declared_kinds[node.id] = node.kind
    var declared_files: Dict<text, bool> = {}
    for locator in facts.locators:
        if locator.locator_kind == "file" and declared_kinds.contains_key(locator.entity_id):
            val kind = declared_kinds[locator.entity_id]
            if kind == TraceNodeKind.SourceFile or kind == TraceNodeKind.TestSuite or kind == TraceNodeKind.Document:
                declared_files[locator.path] = true
    for path in seen_paths:
        if declared_files.contains_key(path):
            continue
        val artifact = artifact_by_path[path]
        var kind = TraceNodeKind.Document
        if path.starts_with("src/") and path.ends_with(".spl"):
            kind = TraceNodeKind.SourceFile
        elif path.starts_with("test/") and path.ends_with(".spl"):
            kind = TraceNodeKind.TestSuite
        val artifact_id = artifact_trace_id(path)
        facts.nodes.push(TraceNode(id: artifact_id, kind: kind, title: path))
        facts.locators.push(TraceLocator(entity_id: artifact_id, path: path,
            locator_kind: "file", locator: "", blob_id: artifact.blob_id))
        if facts.nodes.len() > policy.max_nodes:
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", path, "inventory node budget exhausted"))
            return facts
    # Pin each declared file locator against actual inventory. A symbolic span
    # needs a separately admitted semantic extractor and is never guessed here.
    var pinned: [TraceLocator] = []
    for locator in facts.locators:
        if not artifact_by_path.contains_key(locator.path):
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-MISSING-ENDPOINT", locator.path, "locator path is absent from exact snapshot"))
            continue
        val artifact = artifact_by_path[locator.path]
        if locator.blob_id != "" and locator.blob_id != artifact.blob_id:
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-MISSING-ENDPOINT", locator.path, "declared locator blob differs from snapshot"))
        if locator.locator_kind != "file":
            facts.complete = false
            facts.diagnostics.push(extraction_diagnostic(snapshot.subject, "TRACE-SNAPSHOT-INCOMPLETE", locator.path, "non-file locator requires an admitted symbol/section extractor"))
        pinned.push(TraceLocator(entity_id: locator.entity_id, path: locator.path,
            locator_kind: locator.locator_kind, locator: locator.locator, blob_id: artifact.blob_id))
    facts.locators = pinned
    facts
