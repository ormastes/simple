# Rendering for `trace refs`: same envelope as node pages, reference rows added.
use std.common.traceability.model.*
use std.common.traceability.query_refs_v1.{TraceReferencePageV1}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use app.traceability.query_options_v1.{TraceQueryOptionsV1}
use app.traceability.extract.snapshot_pipeline.{TraceSnapshotBuild}
use app.traceability.query_render_v1.{trace_query_ingestion_line_v1, trace_query_ingestion_sdn_v1}
use std.common.traceability.sidecar_v1.{sidecar_references_from_v1, sidecar_references_at_path_v1}

fn refs_table_text_v1(value: text) -> text:
    var out = ""
    for ch in value.chars():
        if ch == "\t" or ch == "\n" or ch == "\r": out = out + " "
        else: out = out + ch
    out

pub fn trace_query_render_refs_v1(build: TraceSnapshotBuild, page: TraceReferencePageV1, options: TraceQueryOptionsV1) -> text:
    val graph = build.graph
    val capture = if graph.subject.kind == "worktree_preview": "non-atomic-sequential-preview" else: "immutable-git-tree"
    val selected_kind = node_kind_name(page.selected.kind)
    var rows: [SdnValue] = []
    for reference in page.references:
        var other_paths: [SdnValue] = []
        for path in reference.other_paths: other_paths.push(SdnValue.String(path))
        rows.push(SdnValue.Dict({"claim": SdnValue.String(reference.claim_id), "other_paths": SdnValue.Array(other_paths),
            "direction": SdnValue.String(reference.direction), "relation": SdnValue.String(reference.relation),
            "from": SdnValue.String(reference.from_id), "to": SdnValue.String(reference.to_id),
            "other": SdnValue.String(reference.other_id), "other_kind": SdnValue.String(reference.other_kind),
            "other_title": SdnValue.String(reference.other_title), "operation": SdnValue.String(reference.operation),
            "origin": SdnValue.String(reference.origin_id), "authority": SdnValue.String(reference.authority)}))
    var source_rows: [SdnValue] = []
    for locator in page.locators:
        source_rows.push(SdnValue.Dict({"entity": SdnValue.String(locator.entity_id),
            "path": SdnValue.String(locator.path), "blob": SdnValue.String(locator.blob_id),
            "locator_kind": SdnValue.String(locator.locator_kind), "locator": SdnValue.String(locator.locator)}))
    var diagnostics: [SdnValue] = []
    var shown = 0
    for issue in page.diagnostics:
        if shown >= 200: break
        diagnostics.push(SdnValue.Dict({"code": SdnValue.String(issue.code),
            "subject": SdnValue.String(issue.subject_id), "entity": SdnValue.String(issue.entity_id),
            "rule": SdnValue.String(issue.rule_id), "origin": SdnValue.String(issue.origin_id),
            "severity": SdnValue.String(issue.severity), "message": SdnValue.String(issue.message)}))
        shown = shown + 1
    var scope: [SdnValue] = []
    for path in build.scope.selected_roots: scope.push(SdnValue.String(path))
    val ingestion = trace_query_ingestion_sdn_v1(build)
    # A file page selects a path: sidecar rows match on path, not on node id.
    val sidecar = if options.kind == "file": sidecar_references_at_path_v1(build.sidecar_references, options.selected_id)
        else: sidecar_references_from_v1(build.sidecar_references, page.selected.id)
    var sidecar_rows: [SdnValue] = []
    for reference in sidecar:
        sidecar_rows.push(SdnValue.Dict({"source_kind": SdnValue.String(reference.source_kind),
            "from": SdnValue.String(reference.from_id),
            "relation": SdnValue.String(reference.relation), "path": SdnValue.String(reference.path),
            "locator": SdnValue.String(reference.locator), "authority": SdnValue.String(reference.authority)}))
    if options.format == "sdn":
        return sdn_encode_canonical(SdnValue.Dict({
            "schema": SdnValue.String("simple.trace.reference-query/v1"),
            "sidecar_references": SdnValue.Array(sidecar_rows), "sidecar_sources": ingestion["sidecar_sources"],
            "snapshot": SdnValue.String(graph.subject.snapshot_id),
            "snapshot_kind": SdnValue.String(graph.subject.kind), "capture": SdnValue.String(capture),
            "repository": SdnValue.String(graph.subject.repository_id),
            "revision": SdnValue.String(graph.subject.revision_id), "tree": SdnValue.String(graph.subject.tree_id),
            "generation": SdnValue.String(graph.generation_id), "input_manifest": SdnValue.String(graph.input_manifest_id),
            "scope": SdnValue.Array(scope), "ingestion": ingestion["ingestion"],
            "legacy_database_ingestion": ingestion["legacy_database_ingestion"],
            "qualification": SdnValue.String("unverified"), "admission_eligible": SdnValue.Bool(false),
            "operation": SdnValue.String("refs"), "kind": SdnValue.String(options.kind),
            "selected": SdnValue.Dict({"id": SdnValue.String(page.selected.id),
                "kind": SdnValue.String(selected_kind), "title": SdnValue.String(page.selected.title)}),
            "limit": SdnValue.Int(options.limit),
            "page_complete": SdnValue.Bool(page.complete), "graph_complete": SdnValue.Bool(graph.complete),
            "total_count": SdnValue.Int(page.total_count), "reference_count": SdnValue.Int(page.references.len()),
            "next_cursor": SdnValue.String(page.next_cursor),
            "projection": SdnValue.String("references-only; not a graph export"),
            "references": SdnValue.Array(rows), "locators": SdnValue.Array(source_rows),
            "diagnostics": SdnValue.Array(diagnostics), "diagnostic_count": SdnValue.Int(page.diagnostics.len()),
            "diagnostics_truncated": SdnValue.Bool(page.diagnostics.len() > shown)}))
    var output = "Snapshot: " + graph.subject.snapshot_id + "\nCapture: " + capture + "\n"
    output = output + trace_query_ingestion_line_v1(build)
    output = output + "Graph complete: " + graph.complete.to_text() + "; page complete: " + page.complete.to_text() + "\n"
    output = output + "Qualification: unverified; admission eligible: false\n"
    output = output + "Generation: " + graph.generation_id + "\nInput manifest: " + graph.input_manifest_id + "\n"
    output = output + "Selected: " + selected_kind + " " + refs_table_text_v1(page.selected.id) + " " + refs_table_text_v1(page.selected.title) + "\n"
    output = output + "DIRECTION\tRELATION\tID\tKIND\tTITLE\tAUTHORITY\tPATHS\n"
    for reference in page.references:
        var paths = ""
        for path in reference.other_paths:
            paths = if paths == "": refs_table_text_v1(path) else: paths + "," + refs_table_text_v1(path)
        output = output + reference.direction + "\t" + reference.relation + "\t" + refs_table_text_v1(reference.other_id) + "\t" +
            reference.other_kind + "\t" + refs_table_text_v1(reference.other_title) + "\t" + reference.authority + "\t" + paths + "\n"
    output = output + "Total references: " + page.total_count.to_text() + "\n"
    if page.next_cursor != "": output = output + "Next cursor: " + page.next_cursor + "\n"
    for locator in page.locators:
        output = output + "LOCATOR\t" + refs_table_text_v1(locator.path) + "\t" + refs_table_text_v1(locator.locator_kind) + "\t" + refs_table_text_v1(locator.locator) + "\t" + refs_table_text_v1(locator.entity_id) + "\n"
    for reference in sidecar:
        output = output + "SIDECAR\t" + reference.relation + "\t" + refs_table_text_v1(reference.path) + "\t" + refs_table_text_v1(reference.locator) + "\t" + reference.authority + "\t" + refs_table_text_v1(reference.from_id) + "\n"
    shown = 0
    for issue in page.diagnostics:
        if shown >= 200: break
        output = output + refs_table_text_v1(issue.code + ": " + issue.message) + "\n"
        shown = shown + 1
    if page.diagnostics.len() > shown: output = output + "Additional diagnostics omitted: " + (page.diagnostics.len() - shown).to_text() + "\n"
    output
