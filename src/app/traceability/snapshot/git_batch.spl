# Byte-framed Git cat-file --batch decoding for selected textual trace inputs.
# The effectful snapshot owner supplies the independently resolved blob IDs.
# No working-tree text, C-style quoting, or line splitting of bodies is used.
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}

pub struct TraceGitBlob:
    oid: text
    content: text
    byte_size: i64

fn trace_batch_size(value: text, limit: i64) -> Result<i64, text>:
    if value == "":
        return Err("TRACE-SNAPSHOT-INCOMPLETE: missing object size")
    var size: i64 = 0
    for byte in value.bytes():
        val digit = byte.to_i64() - 48
        if digit < 0 or digit > 9:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: invalid object size")
        if size > (limit - digit) / 10:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: blob byte budget exhausted")
        size = size * 10 + digit
        if size > limit:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: blob byte budget exhausted")
    Ok(size)

fn trace_batch_bytes(data: [u8], first: i64, end: i64) -> [u8]:
    var result: [u8] = []
    for i in first..end:
        result.push(data[i])
    result

# A successful decode proves framing and association only. Git object-store
# integrity and immutable subject resolution remain the snapshot owner's job.
pub fn decode_trace_git_batch(data: [u8], expected_oids: [text], max_blob_bytes: i64, max_total_bytes: i64) -> Result<[TraceGitBlob], text>:
    if max_blob_bytes < 1 or max_blob_bytes > 4194304 or max_total_bytes < 1 or max_total_bytes > 4194304:
        return Err("TRACE-SNAPSHOT-INCOMPLETE: invalid batch limits")
    if data.len() > max_total_bytes:
        return Err("TRACE-SNAPSHOT-INCOMPLETE: batch output exceeds byte budget")
    var offset: i64 = 0
    var blobs: [TraceGitBlob] = []
    for expected in expected_oids:
        val header_start = offset
        while offset < data.len() and data[offset] != 10:
            if offset - header_start >= 160:
                return Err("TRACE-SNAPSHOT-INCOMPLETE: oversized batch header")
            offset = offset + 1
        if offset >= data.len():
            return Err("TRACE-SNAPSHOT-INCOMPLETE: missing batch header")
        val header = validated_utf8_bytes_to_text_linear(trace_batch_bytes(data, header_start, offset))?
        val fields = header.split(" ")
        if fields.len() != 3:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: missing or malformed Git object")
        if fields[0] != expected or fields[1] != "blob":
            return Err("TRACE-SNAPSHOT-INCOMPLETE: batch object identity or type mismatch")
        val size = trace_batch_size(fields[2], max_blob_bytes)?
        offset = offset + 1
        if size >= data.len() - offset:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: truncated blob body")
        val body_end = offset + size
        if data[body_end] != 10:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: missing blob frame terminator")
        val content = validated_utf8_bytes_to_text_linear(trace_batch_bytes(data, offset, body_end))?
        blobs.push(TraceGitBlob(oid: expected, content: content, byte_size: size))
        offset = body_end + 1
    if offset != data.len():
        return Err("TRACE-SNAPSHOT-INCOMPLETE: unexpected trailing batch output")
    Ok(blobs)
