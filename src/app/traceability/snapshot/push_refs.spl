# Exact pre-push subject decoding. This adapter does not execute Git or grant
# admission: ancestry, protected-ref policy and candidate facts are evaluated
# separately for every retained row. An unread/empty input is incomplete.

pub enum TraceRefUpdateKind:
    Create
    Delete
    Update
    NoChange

pub enum TraceRefKind:
    Branch
    Tag
    Other

pub struct TraceRefUpdate:
    local_ref: text
    local_oid: text
    remote_ref: text
    remote_oid: text
    kind: TraceRefUpdateKind
    ref_kind: TraceRefKind

fn trace_oid_valid(oid: text) -> bool:
    if oid.len() != 40 and oid.len() != 64:
        return false
    val hex = "0123456789abcdef"
    for i in 0..oid.len():
        if not hex.contains(oid.substring(i, i + 1)):
            return false
    true

fn trace_oid_zero(oid: text) -> bool:
    for i in 0..oid.len():
        if oid.substring(i, i + 1) != "0":
            return false
    true

# Reject Git's prohibited ref syntax before a value reaches any object command.
# The effectful adapter additionally resolves the exact object/type with Git.
pub fn trace_remote_ref_valid(name: text) -> bool:
    if not name.starts_with("refs/") or name.ends_with("/"):
        return false
    if name.ends_with(".") or name.contains("..") or name.contains("@{"):
        return false
    val forbidden = [" ", "\t", "\r", "\n", "~", "^", ":", "?", "*", "[", "\\"]
    for token in forbidden:
        if name.contains(token):
            return false
    for ch in name.bytes():
        if ch < 32 or ch == 127:
            return false
    for part in name.split("/"):
        if part == "" or part.starts_with(".") or part.ends_with(".lock"):
            return false
    true

fn trace_ref_kind(name: text) -> TraceRefKind:
    if name.starts_with("refs/heads/"):
        return TraceRefKind.Branch
    if name.starts_with("refs/tags/"):
        return TraceRefKind.Tag
    TraceRefKind.Other

# Parse the complete captured Git hook stdin once, before children can consume
# it. Every row remains a separate subject. The output is not a passing receipt.
pub fn parse_trace_push_refs(input: text, max_refs: i64) -> Result<[TraceRefUpdate], text>:
    if max_refs < 1 or max_refs > 4096:
        return Err("TRACE-SNAPSHOT-INCOMPLETE: invalid ref budget")
    if input == "" or input.len() > 1048576:
        return Err("TRACE-SNAPSHOT-INCOMPLETE: missing or oversized push input")
    var updates: [TraceRefUpdate] = []
    var remote_names: [text] = []
    var object_width: i64 = 0
    val lines = input.split("\n")
    for index in 0..lines.len():
        var line = lines[index]
        if line.ends_with("\r"):
            line = line.substring(0, line.len() - 1)
        if line == "" and index == lines.len() - 1:
            continue
        val fields = line.split(" ")
        if fields.len() != 4 or fields[0] == "":
            return Err("TRACE-SNAPSHOT-INCOMPLETE: malformed push row {index + 1}")
        val local_oid = fields[1]
        val remote_ref = fields[2]
        val remote_oid = fields[3]
        if not trace_oid_valid(local_oid) or not trace_oid_valid(remote_oid):
            return Err("TRACE-SNAPSHOT-INCOMPLETE: invalid object identity in row {index + 1}")
        if local_oid.len() != remote_oid.len():
            return Err("TRACE-SNAPSHOT-INCOMPLETE: mixed object formats in row {index + 1}")
        if object_width != 0 and object_width != local_oid.len():
            return Err("TRACE-SNAPSHOT-INCOMPLETE: mixed repository object formats")
        object_width = local_oid.len()
        if not trace_remote_ref_valid(remote_ref):
            return Err("TRACE-SNAPSHOT-INCOMPLETE: invalid remote ref in row {index + 1}")
        if remote_names.contains(remote_ref):
            return Err("TRACE-SNAPSHOT-INCOMPLETE: duplicate remote ref {remote_ref}")
        val deleting = trace_oid_zero(local_oid)
        val creating = trace_oid_zero(remote_oid)
        if deleting and creating:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: both subjects absent in row {index + 1}")
        if deleting and fields[0] != "(delete)":
            return Err("TRACE-SNAPSHOT-INCOMPLETE: deletion marker missing in row {index + 1}")
        if not deleting and fields[0] == "(delete)":
            return Err("TRACE-SNAPSHOT-INCOMPLETE: deletion marker conflicts with subject")
        if updates.len() >= max_refs:
            return Err("TRACE-SNAPSHOT-INCOMPLETE: push ref budget exhausted")
        var kind = TraceRefUpdateKind.Update
        if deleting:
            kind = TraceRefUpdateKind.Delete
        elif creating:
            kind = TraceRefUpdateKind.Create
        elif local_oid == remote_oid:
            kind = TraceRefUpdateKind.NoChange
        updates.push(TraceRefUpdate(
            local_ref: fields[0], local_oid: local_oid,
            remote_ref: remote_ref, remote_oid: remote_oid,
            kind: kind, ref_kind: trace_ref_kind(remote_ref)))
        remote_names.push(remote_ref)
    if updates.len() == 0:
        return Err("TRACE-SNAPSHOT-INCOMPLETE: no push subjects captured")
    Ok(updates)
