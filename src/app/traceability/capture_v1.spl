"""Checked, bounded materialization for the structural worktree command.

These sequential reads are untrusted observed inputs, not an atomic Git/index
snapshot or a descriptor-confined filesystem view.
"""

use app.io.minimal_runtime_ops.{cwd, process_run_bounded, time_now_unix_micros}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.crypto.sha256.{sha256_text, sha256_stream_v1_new}
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use app.traceability.cli_options_v1.{TraceCliOptionsV1, trace_cli_options_validate_v1}
use app.traceability.core.{VirtualFile, TraceabilityConfig, is_traceable_file_path,
    traceability_config_from_captured_text_v1, traceability_config_validate_captured_v1, default_traceability_config}

pub struct TraceCaptureLimitsV1:
    max_files: i64 = 65536
    max_total_bytes: i64 = 268435456
    max_file_bytes: i64 = 4194304
    max_walk_bytes: i64 = 16777216
    max_processes: i64 = 64
    max_capture_ms: i64 = 30000

pub struct TraceCaptureIssueV1:
    code: text
    path: text
    message: text
    snapshot_id: text

pub struct TraceCapturedInputsV1:
    snapshot_id: text
    root: text
    files: [VirtualFile]
    config: TraceabilityConfig
    total_bytes: i64

fn capture_issue_v1(code: text, path: text, message: text, id: text) -> TraceCaptureIssueV1:
    TraceCaptureIssueV1(code: code, path: path, message: message, snapshot_id: id)

fn capture_min_v1(a: i64, b: i64) -> i64:
    if a < b: a else: b

fn capture_text_v1(path: text, limit: i64) -> Result<text, text>:
    val observed = file_read_regular_no_follow_bounded(path, limit)?
    if observed.len() < 0 or observed.len() > limit:
        return Err("bounded reader returned an invalid length")
    validated_utf8_bytes_to_text_linear(observed.bytes())

pub fn trace_capture_normalize_selector_v1(path: text) -> Result<text, text>:
    if path == "" or path.starts_with("/") or path.bytes().contains(0u8):
        return Err("select a nonempty repository-relative path without NUL")
    var parts: [text] = []
    for part in path.split("/"):
        if part == "..":
            return Err("parent traversal is not a repository-relative selection")
        if part != "" and part != ".":
            parts.push(part)
    if parts.len() == 0:
        return Err("select src, test, doc or a path within those roots")
    val normalized = parts.join("/")
    if normalized != "src" and normalized != "test" and normalized != "doc" and
        not normalized.starts_with("src/") and not normalized.starts_with("test/") and not normalized.starts_with("doc/"):
        return Err("selection is outside the source/test/document roots")
    Ok(normalized)

fn capture_ancestors_v1(path: text) -> bool:
    val parts = path.split("/")
    var prefix = ""
    var index = 0
    while index + 1 < parts.len():
        prefix = if prefix == "": parts[index] else: prefix + "/" + parts[index]
        if not dir_is_real_no_follow(prefix):
            return false
        index = index + 1
    true

pub fn trace_capture_enumeration_v1(stdout: text, stderr: text, code: i64,
    max_bytes: i64, max_entries: i64) -> Result<[text], text>:
    """Validate a bounded native capture before interpreting any path record.

    This provider inserts truncation bytes beyond its retained byte cap.
    Incomplete-stream markers end without NUL. Both cases reject even at exit0;
    legitimate filenames are not rejected for resembling marker text.
    """
    if max_bytes < 0 or max_entries < 0 or code != 0 or stderr != "" or stdout.len() < 0 or stdout.len() > max_bytes:
        return Err("directory enumeration failed or capture exceeded its byte budget")
    val valid = validated_utf8_bytes_to_text_linear(stdout.bytes())?
    if valid == "":
        return Ok([])
    val bytes = valid.bytes()
    if bytes[bytes.len() - 1] != 0u8:
        return Err("directory enumeration did not provide complete NUL records")
    var paths: [text] = []
    var start = 0
    var index = 0
    while index < bytes.len():
        if bytes[index] == 0u8:
            val record = valid[start:index]
            if record == "" or not record.starts_with("./") or record.len() > 4098:
                return Err("directory enumeration returned an invalid path record")
            if paths.len() >= max_entries:
                return Err("directory enumeration entry budget exceeded")
            paths.push(record[2:record.len()])
            start = index + 1
        index = index + 1
    Ok(paths)

fn capture_remaining_ms_v1(started: i64, budget: i64) -> i64:
    val now = time_now_unix_micros()
    if now < started:
        return 0
    val elapsed = (now - started) / 1000
    if elapsed >= budget: 0 else: budget - elapsed

fn capture_walk_v1(root: text, extra: [text], started: i64,
    limits: TraceCaptureLimitsV1) -> Result<[text], text>:
    val remaining = capture_remaining_ms_v1(started, limits.max_capture_ms)
    if remaining <= 0:
        return Err("input capture time budget exceeded")
    val (out, err, code) = process_run_bounded("find",
        ["-P", if root == ".": "." else: "./" + root] + extra + ["-print0"], remaining, limits.max_walk_bytes)
    trace_capture_enumeration_v1(out, err, code, limits.max_walk_bytes, limits.max_files)

fn capture_attempt_id_v1(options: TraceCliOptionsV1, root: text) -> text:
    var selectors: [SdnValue] = []
    for path in options.paths:
        selectors.push(SdnValue.String(path))
    val context = SdnValue.Dict({"schema": SdnValue.String("simple.trace.worktree-attempt"),
        "version": SdnValue.Int(1), "cwd_sha256": SdnValue.String(sha256_text(root)),
        "scope": SdnValue.String(options.scope), "selectors": SdnValue.Array(selectors)})
    "worktree-attempt:" + sha256_text(sdn_encode_canonical(context) + "\n")

pub fn trace_capture_worktree_v1(options: TraceCliOptionsV1,
    limits: TraceCaptureLimitsV1) -> Result<TraceCapturedInputsV1, TraceCaptureIssueV1>:
    # This reserved unavailable-attempt marker binds no captured subject.
    # Early refusals remain snapshot.complete=false in the command report.
    match trace_cli_options_validate_v1(options):
        case Err(reason): return Err(capture_issue_v1("TRC-CAPTURE-OPTIONS", "", reason, "worktree-attempt:unavailable"))
        case Ok(_): pass
    if limits.max_files < 0 or limits.max_files > 65536 or limits.max_total_bytes < 0 or
        limits.max_total_bytes > 268435456 or limits.max_file_bytes < 0 or limits.max_file_bytes > 16777216 or
        limits.max_walk_bytes < 1 or limits.max_walk_bytes > 16777216 or limits.max_processes < 2 or
        limits.max_processes > 256 or limits.max_capture_ms < 1 or limits.max_capture_ms > 300000:
        return Err(capture_issue_v1("TRC-CAPTURE-LIMIT", "", "Invalid input capture limits", "worktree-attempt:unavailable"))
    val root = cwd()
    if root == "" or root.len() > 4096 or root.bytes().contains(0u8):
        return Err(capture_issue_v1("TRC-CAPTURE-ROOT", "", "A valid working directory is required", "worktree-attempt:unavailable"))
    match validated_utf8_bytes_to_text_linear(root.bytes()):
        case Err(_): return Err(capture_issue_v1("TRC-CAPTURE-ROOT", "", "Working directory is not UTF-8", "worktree-attempt:unavailable"))
        case Ok(_): pass
    val attempt = capture_attempt_id_v1(options, root)
    val roots = if options.paths.len() == 0: ["src", "test", "doc"] else: options.paths
    if roots.len() > limits.max_processes - 2:
        return Err(capture_issue_v1("TRC-CAPTURE-LIMIT", "", "Selection exceeds the enumeration process budget", attempt))
    val started = time_now_unix_micros()
    # A successful checked enumeration establishes authorized config absence.
    # file_exists alone cannot distinguish absence from permission/provider failure.
    var config = default_traceability_config()
    var config_source = "absent-default"
    var config_content = ""
    val root_entries = match capture_walk_v1(".", ["-maxdepth", "1", "-name", "config"], started, limits):
        case Ok(entries): entries
        case Err(_): return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "", "Cannot establish configuration presence", attempt))
    if root_entries.len() > 0:
        if root_entries.len() != 1 or root_entries[0] != "config" or not dir_is_real_no_follow("config"):
            return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "config", "Configuration root must be an observed real directory", attempt))
        val entries = match capture_walk_v1("config", ["-maxdepth", "1", "-name", "traceability.sdn"], started, limits):
            case Ok(values): values
            case Err(_): return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "config", "Cannot enumerate configuration", attempt))
        if entries.len() > 0:
            if entries.len() != 1 or entries[0] != "config/traceability.sdn":
                return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "config", "Unexpected configuration path", attempt))
            match capture_text_v1("config/traceability.sdn", capture_min_v1(1048576, capture_min_v1(limits.max_file_bytes, limits.max_total_bytes))):
                case Ok(content):
                    config_content = content
                    config_source = "captured"
                    config = traceability_config_from_captured_text_v1(content)
                    match traceability_config_validate_captured_v1(config):
                        case Err(_): return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "config/traceability.sdn", "Configuration exceeds member or byte limits", attempt))
                        case Ok(_): pass
                case Err(_): return Err(capture_issue_v1("TRC-CONFIG-CAPTURE", "config/traceability.sdn", "Cannot read complete UTF-8 configuration", attempt))
    var selected: Dict<text, bool> = {}
    for requested in roots:
        val path = match trace_capture_normalize_selector_v1(requested):
            case Ok(value): value
            case Err(reason): return Err(capture_issue_v1("TRC-INPUT", requested, reason, attempt))
        if not capture_ancestors_v1(path):
            return Err(capture_issue_v1("TRC-INPUT", path, "Input ancestor is missing, inaccessible or a symbolic link", attempt))
        var entries: [text] = []
        if dir_is_real_no_follow(path):
            entries = match capture_walk_v1(path, [], started, limits):
                case Ok(values): values
                case Err(_): return Err(capture_issue_v1("TRC-ENUMERATION", path, "Cannot enumerate complete input paths within budget", attempt))
        elif is_traceable_file_path(path) and file_is_regular_no_follow(path):
            entries = [path]
        else:
            return Err(capture_issue_v1("TRC-INPUT", path, "Input is missing, inaccessible, symbolic or unsupported", attempt))
        var observed_root = false
        for entry in entries:
            if entry == path:
                observed_root = true
            if entry != path and not entry.starts_with(path + "/"):
                return Err(capture_issue_v1("TRC-ENUMERATION", path, "Enumeration escaped its requested path", attempt))
            if not capture_ancestors_v1(entry):
                return Err(capture_issue_v1("TRC-INPUT", entry, "Input has an unaccepted observed ancestor", attempt))
            if dir_is_real_no_follow(entry):
                continue
            if not file_is_regular_no_follow(entry):
                return Err(capture_issue_v1("TRC-INPUT", entry, "Input must be an observed regular file", attempt))
            if is_traceable_file_path(entry) and not selected.contains_key(entry):
                if selected.len() >= limits.max_files:
                    return Err(capture_issue_v1("TRC-CAPTURE-LIMIT", entry, "Captured file count budget exceeded", attempt))
                selected[entry] = true
        if not observed_root:
            return Err(capture_issue_v1("TRC-ENUMERATION", path, "Enumeration omitted its selected root", attempt))
    var paths: [text] = []
    for path in selected.keys():
        paths.push(path)
    paths.sort()
    var selectors: [SdnValue] = []
    for path in options.paths:
        selectors.push(SdnValue.String(path))
    var warn_roots: [SdnValue] = []
    for path in config.warn_source_roots:
        warn_roots.push(SdnValue.String(path))
    val header = SdnValue.Dict({"schema": SdnValue.String("simple.trace.materialized-inputs"),
        "version": SdnValue.Int(1), "kind": SdnValue.String("worktree"), "cwd": SdnValue.String(root),
        "scope": SdnValue.String(options.scope), "selectors": SdnValue.Array(selectors),
        "full_repository": SdnValue.Bool(options.paths.len() == 0),
        "configuration": SdnValue.Dict({"source": SdnValue.String(config_source),
            "sha256": SdnValue.String(sha256_text(config_content)),
            "generated_spec_root": SdnValue.String(config.generated_spec_root),
            "legacy_requirement_root": SdnValue.String(config.legacy_requirement_root),
            "warn_source_roots": SdnValue.Array(warn_roots)}),
        "policy": SdnValue.String("sequential-observed-utf8/no-follow-checks/legacy-structural-v1")})
    var digest = sha256_stream_v1_new()
    if not digest.update((sdn_encode_canonical(header) + "\n").bytes()):
        return Err(capture_issue_v1("TRC-CAPTURE-HASH", "", "Cannot hash captured context", attempt))
    var total = config_content.len()
    var files: [VirtualFile] = []
    for path in paths:
        if capture_remaining_ms_v1(started, limits.max_capture_ms) <= 0:
            return Err(capture_issue_v1("TRC-CAPTURE-LIMIT", path, "Input capture time budget exceeded", attempt))
        if not capture_ancestors_v1(path):
            return Err(capture_issue_v1("TRC-INPUT", path, "Observed input ancestor changed before read", attempt))
        val content = match capture_text_v1(path, capture_min_v1(limits.max_file_bytes, limits.max_total_bytes - total)):
            case Ok(value): value
            case Err(_): return Err(capture_issue_v1("TRC-INPUT-READ", path, "Cannot read complete bounded UTF-8 input", attempt))
        total = total + content.len()
        val record = SdnValue.Dict({"path": SdnValue.String(path), "bytes": SdnValue.Int(content.len()),
            "sha256": SdnValue.String(sha256_text(content))})
        if not digest.update((sdn_encode_canonical(record) + "\n").bytes()):
            return Err(capture_issue_v1("TRC-CAPTURE-HASH", path, "Cannot hash captured input", attempt))
        files.push(VirtualFile(path: path, content: content))
    if capture_remaining_ms_v1(started, limits.max_capture_ms) <= 0:
        return Err(capture_issue_v1("TRC-CAPTURE-LIMIT", "", "Input capture time budget exceeded", attempt))
    val hash = digest.finish_hex() ?? ""
    if hash.len() != 64:
        return Err(capture_issue_v1("TRC-CAPTURE-HASH", "", "Cannot finalize captured input identity", attempt))
    Ok(TraceCapturedInputsV1(snapshot_id: "worktree-input:" + hash,
        root: root, files: files, config: config, total_bytes: total))

export TraceCaptureLimitsV1, TraceCaptureIssueV1, TraceCapturedInputsV1
export trace_capture_normalize_selector_v1, trace_capture_enumeration_v1, trace_capture_worktree_v1
