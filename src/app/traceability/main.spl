# Traceability Checker CLI

use std.cli.cli_util.{get_cli_args}
use std.cli.log_modes.{render_progress}
use app.io.minimal_runtime_ops.{report_error, exit}
use app.traceability.cli_options_v1.{trace_cli_options_parse_v1, trace_cli_help_v1}
use app.traceability.capture_v1.{trace_capture_worktree_v1, TraceCaptureLimitsV1}
use app.traceability.structural_report_v1.{trace_evaluate_captured_v1,
    trace_qualification_from_structural_result_v1, trace_qualification_infrastructure_v1}
use std.common.traceability.types_v1.{TraceQualificationV1, trace_qualification_codec_limits_v1}
use std.common.traceability.qualification_v1.{trace_qualification_encode_v1}

fn trace_cli_run_v1(args: [text]) -> i64:
    val options = match trace_cli_options_parse_v1(args):
        case Ok(value): value
        case Err(reason):
            report_error("traceability", reason)
            return 2
    if options.help:
        val help = trace_cli_help_v1()
        print help.substring(0, help.len() - 1)
        return 0
    var document: TraceQualificationV1
    match trace_capture_worktree_v1(options, TraceCaptureLimitsV1()):
        case Err(issue):
            document = trace_qualification_infrastructure_v1(issue.snapshot_id, false,
                options, issue.code, issue.path, issue.message)
        case Ok(inputs):
            match trace_evaluate_captured_v1(inputs, options.scope, 100000):
                case Ok(warnings):
                    document = trace_qualification_from_structural_result_v1(inputs.snapshot_id, options, warnings)
                case Err(reason):
                    document = trace_qualification_infrastructure_v1(inputs.snapshot_id, true,
                        options, "TRC-EVALUATION-BUDGET", "", reason)
    var code = document.evaluation.exit_code
    var output = ""
    match trace_qualification_encode_v1(document, trace_qualification_codec_limits_v1()):
        case Ok(encoded): output = encoded
        case Err(issue):
            # Argument bytes are capped at 64 KiB before capture. Reserve the
            # standard 1 MiB report budget for this infrastructure summary,
            # retaining the captured snapshot and authored selection.
            code = 2
            val incomplete = trace_qualification_infrastructure_v1(document.snapshot.id,
                document.snapshot.complete, options, "TRC-REPORT", "",
                "Cannot encode the complete structural report within the codec contract")
            match trace_qualification_encode_v1(incomplete, trace_qualification_codec_limits_v1()):
                case Ok(encoded): output = encoded
                case Err(_):
                    report_error("traceability", "Infrastructure report encoding failed: " + issue.code)
                    return 2
    # The encoder includes one LF. The print primitive supplies that LF, so
    # remove exactly its final byte and emit one machine document.
    print output.substring(0, output.len() - 1)
    if not options.quiet and (options.progress != "summary" or options.verbose):
        val mode = if options.verbose and options.progress == "summary": "count" else: options.progress
        val line = render_progress(mode, options.paths.len(),
            if options.paths.len() == 0: 3 else: options.paths.len(), "traceability")
        if line != "":
            report_error("traceability", line)
    code

fn main() -> i64:
    # Use the canonical process boundary for explicit CLI status.
    val code = trace_cli_run_v1(get_cli_args())
    exit(code)
    code
