"""Strict command options. Validation finishes before any input capture."""

use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}

pub struct TraceCliOptionsV1:
    scope: text = "all"
    paths: [text] = []
    progress: text = "summary"
    quiet: bool = false
    verbose: bool = false
    help: bool = false

fn trace_cli_option_issue_v1(option: text, reason: text) -> text:
    "traceability: " + option + ": " + reason + "; structured output is SDN"

pub fn trace_cli_options_validate_v1(options: TraceCliOptionsV1) -> Result<bool, text>:
    if options.scope != "all" and options.scope != "src" and options.scope != "spec" and options.scope != "doc":
        return Err("unsupported structural scope")
    if options.progress != "summary" and options.progress != "count" and options.progress != "dot" and options.progress != "none":
        return Err("unsupported progress mode")
    if options.paths.len() > 4096:
        return Err("too many input selectors")
    var bytes = 0
    for path in options.paths:
        if path == "" or path.len() > 4096 or path.bytes().contains(0u8):
            return Err("invalid input selector")
        match validated_utf8_bytes_to_text_linear(path.bytes()):
            case Err(_): return Err("input selectors must be UTF-8")
            case Ok(_): pass
        if path.len() > 65536 - bytes:
            return Err("input selector byte budget exceeded")
        bytes = bytes + path.len()
    Ok(true)

pub fn trace_cli_options_parse_v1(args: [text]) -> Result<TraceCliOptionsV1, text>:
    if args.len() > 4096:
        return Err(trace_cli_option_issue_v1("arguments", "too many arguments"))
    var bytes = 0
    for arg in args:
        if arg.len() > 4096 or arg.bytes().contains(0u8):
            return Err(trace_cli_option_issue_v1("arguments", "oversized or NUL argument"))
        match validated_utf8_bytes_to_text_linear(arg.bytes()):
            case Err(_): return Err(trace_cli_option_issue_v1("arguments", "arguments must be UTF-8"))
            case Ok(_): pass
        bytes = bytes + arg.len()
        if bytes > 65536:
            return Err(trace_cli_option_issue_v1("arguments", "argument byte budget exceeded"))
    var options = TraceCliOptionsV1()
    var positional = false
    var index = 0
    while index < args.len():
        val arg = args[index]
        if positional:
            options.paths.push(arg)
        elif arg == "--":
            positional = true
        elif arg == "--help" or arg == "-h":
            options.help = true
        elif arg == "--quiet":
            options.quiet = true
        elif arg == "--verbose":
            options.verbose = true
        elif arg == "--no-progress":
            options.progress = "none"
        elif arg == "--dots":
            options.progress = "dot"
        elif arg == "--count":
            options.progress = "count"
        elif arg == "--human" or arg == "--llm" or arg == "--stdout":
            pass
        elif arg == "--json":
            return Err(trace_cli_option_issue_v1(arg, "obsolete flag; use --format=sdn"))
        elif arg.starts_with("--"):
            val equal = arg.index_of("=") ?? -1
            var name = arg
            var value = ""
            if equal >= 0:
                name = arg.substring(0, equal)
                value = arg.substring(equal + 1, arg.len())
            else:
                if name != "--scope" and name != "--format" and name != "--progress" and name != "--log-mode" and name != "--surface":
                    return Err(trace_cli_option_issue_v1(name, "unknown option"))
                if index + 1 >= args.len() or args[index + 1].starts_with("-"):
                    return Err(trace_cli_option_issue_v1(name, "missing value"))
                index = index + 1
                value = args[index]
            if name == "--scope":
                if value != "all" and value != "src" and value != "spec" and value != "doc":
                    return Err(trace_cli_option_issue_v1(name, "unsupported scope: " + value))
                options.scope = value
            elif name == "--format":
                if value != "sdn":
                    return Err(trace_cli_option_issue_v1(name, "unsupported format: " + value))
            elif name == "--progress":
                if value != "summary" and value != "count" and value != "dot" and value != "none":
                    return Err(trace_cli_option_issue_v1(name, "unsupported progress: " + value))
                options.progress = value
            elif name == "--log-mode":
                if value != "human" and value != "llm":
                    return Err(trace_cli_option_issue_v1(name, "unsupported log mode: " + value))
            elif name == "--surface":
                if value != "stdout":
                    return Err(trace_cli_option_issue_v1(name, "unsupported surface: " + value))
            else:
                return Err(trace_cli_option_issue_v1(name, "unknown option"))
        elif arg.starts_with("-"):
            return Err(trace_cli_option_issue_v1(arg, "unknown option"))
        else:
            options.paths.push(arg)
        index = index + 1
    if options.quiet:
        options.progress = "none"
    trace_cli_options_validate_v1(options)?
    Ok(options)

pub fn trace_cli_help_v1() -> text:
    "Usage: simple traceability-check [options] [paths...]\n" +
    "\nChecks source/test/doc traceability. Structured stdout is SDN.\n\n" +
    "  --scope=<name>     all (default), src, spec, doc\n" +
    "  --format=sdn       SDN (default)\n" +
    "  --progress=<mode>  summary, count, dot, none; stderr only\n" +
    "  --quiet            Suppress progress; retain the SDN verdict\n" +
    "  --verbose          Show structural progress on stderr\n" +
    "  --log-mode=<mode>  human, llm\n" +
    "  --surface=stdout   SDN stdout\n" +
    "  --                  End options\n" +
    "  -h, --help          Show this help\n"

export trace_cli_options_validate_v1, TraceCliOptionsV1, trace_cli_options_parse_v1, trace_cli_help_v1
