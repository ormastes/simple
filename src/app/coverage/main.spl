"""
Coverage Analysis Tool

Commands:
  scan     - Scan source code and generate/update public_api.yml
  class    - Show class/struct touch coverage (for System Tests)
  func     - Show public function touch coverage (for Integration Tests)
  report   - Show full coverage report
  generate - Generate extended coverage reports
  check    - Check coverage against threshold
  summary  - Print coverage summary
"""

# Note: std.cli, std.fs, std.process would be used if available
# For now, we use basic functions and SFFI

# SFFI declarations for CLI
use std.cli.cli_util (get_cli_args)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use app.io.mod.{file_exists, file_read, file_read_bytes}
use std.common.string_core.{bytes_to_text}
use std.nogc_sync_mut.io.coverage_mcdc.{
    MCDC_VECTOR_V1_BYTES, MCDC_EXCLUSION_V1_BYTES, MCDC_REPORT_V1_BYTES,
    MCDC_DECISION_EXPR_V1_BYTES, MCDC_EXPR_TOKEN_V1_BYTES,
    MCDC_WITNESS_V1_BYTES, MCDC_STATUS_OK, MCDC_STATUS_GATE_FAILED,
    MCDC_STATUS_EMPTY_DENOMINATOR,
    mcdc_runtime_report_manifest
}
use std.common.structural.mcdc.contracts.{
    McdcReportModeV1, mcdc_coverage_summary_v1, mcdc_normal_gate_v1
}
use compiler.tools.verify.mcdc_scenario_exclusion.{
    MCDC_EXCLUSION_MAX_LINE_BYTES,
    parse_mcdc_scenario_exclusion_v1, mcdc_scenario_exclusion_report_v1,
    mcdc_exclusion_line_is_directive_v1,
    bind_mcdc_scenario_exclusions_v1,
    mcdc_bound_normal_gate_v1_passes
}

# SFFI declarations for Rust coverage functions
extern fn coverage_scan(source_dir: text, output_file: text) -> i64
extern fn coverage_class(coverage_json: text, source_dir: text, filter: text) -> i64
extern fn coverage_func(coverage_json: text, source_dir: text, filter: text) -> i64
extern fn coverage_report(coverage_json: text, public_api: text, type_filter: text) -> i64
extern fn coverage_generate(llvm_cov: text, api: text, output_dir: text, report_type: text) -> i64
extern fn coverage_check(coverage_file: text, threshold: f64) -> i64
extern fn coverage_summary(coverage_file: text) -> i64


fn print_usage():
    print "Usage: simple coverage <command> [options]"
    print ""
    print "Commands:"
    print "  scan      Scan source and generate public_api.yml"
    print "            --source <dir>   Source directory (default: src)"
    print "            --output <file>  Output YAML file (default: public_api.yml)"
    print ""
    print "  class     Show class/struct touch coverage"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --source <dir>          Source directory (default: src)"
    print "            --filter <pattern>      Filter by type name"
    print ""
    print "  func      Show public function touch coverage"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --source <dir>          Source directory (default: src)"
    print "            --filter <pattern>      Filter by crate/module"
    print ""
    print "  report    Show full coverage report (legacy)"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --public-api <file>     Public API YAML"
    print "            --type-filter <pattern> Filter by type name"
    print ""
    print "  generate  Generate extended coverage reports"
    print "            --llvm-cov <file>       LLVM coverage JSON"
    print "            --api <file>            Public API YAML"
    print "            --output-dir <dir>      Output directory (default: target/coverage)"
    print "            --report-type <type>    system|integration|merged|all (default: all)"
    print ""
    print "  check     Check coverage against threshold"
    print "            --coverage <file>       Extended coverage JSON"
    print "            --threshold <percent>   Threshold percentage (default: 80.0)"
    print ""
    print "  summary   Print coverage summary"
    print "            --coverage <file>       Extended coverage JSON"
    print ""
    print "  mcdc      Build the authoritative masking MC/DC report and gate"
    print "            --manifest <file>       Compiler MCDP V1 manifest (required)"
    print "            --events <file>         Sealed V1 vector rows (required)"
    print "            --exclusions <file>     Governed V1 exclusion rows (optional)"
    print "            --exclusion-source <f>  Source containing governed directives; repeatable"
    print "            --mode <mode>           normal|alpha|beta (default: normal)"
    print "            --current-epoch <n>     Exclusion freshness epoch"
    print "            --max-events <n>        Event bound (default: 65536)"
    print "            --max-manifest-bytes <n> Manifest bound (default: 65536)"
    print "            --max-programs <n>      Decision bound (default: 4096)"
    print "            --max-tokens <n>        Boolean token bound (default: 65536)"
    print "            --max-witnesses <n>     Evidence bound (default: 65536)"
    print "            --proof-budget <n>      Masking proof bound (default: 1000000)"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"


fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")


fn clean_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if _is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned


fn get_arg(args: [text], flag: text, default_val: text) -> text:
    var i = 0
    while i < args.len() - 1:
        if args[i] == flag:
            return args[i + 1]
        i = i + 1
    default_val

fn get_all_args(args: [text], flag: text) -> [text]:
    var result: [text] = []
    var i = 0
    while i < args.len() - 1:
        if args[i] == flag:
            result.push(args[i + 1])
        i = i + 1
    result


fn cmd_scan(args: [text]) -> i64:
    val source = get_arg(args, "--source", "src")
    val output = get_arg(args, "--output", "public_api.yml")

    print "Scanning source directory: {source}"
    val result = coverage_scan(source, output)

    if result == 0:
        print "Written to: {output}"
    else:
        print "Error: scan failed with code {result}"

    result


fn cmd_class(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val source = get_arg(args, "--source", "src")
    val filter = get_arg(args, "--filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    coverage_class(coverage_json, source, filter)


fn cmd_func(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val source = get_arg(args, "--source", "src")
    val filter = get_arg(args, "--filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    coverage_func(coverage_json, source, filter)


fn cmd_report(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val public_api = get_arg(args, "--public-api", "")
    val type_filter = get_arg(args, "--type-filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    if public_api == "":
        print "Error: --public-api is required"
        return 1

    coverage_report(coverage_json, public_api, type_filter)


fn cmd_generate(args: [text]) -> i64:
    val llvm_cov = get_arg(args, "--llvm-cov", "")
    val api = get_arg(args, "--api", "")
    val output_dir = get_arg(args, "--output-dir", "target/coverage")
    val report_type = get_arg(args, "--report-type", "all")

    if llvm_cov == "":
        print "Error: --llvm-cov is required"
        return 1

    if api == "":
        print "Error: --api is required"
        return 1

    print "Loading coverage data from {llvm_cov}"
    print "Loading API spec from {api}"

    coverage_generate(llvm_cov, api, output_dir, report_type)


fn cmd_check(args: [text]) -> i64:
    val coverage = get_arg(args, "--coverage", "")
    val threshold_str = get_arg(args, "--threshold", "80.0")

    if coverage == "":
        print "Error: --coverage is required"
        return 1

    # Default threshold of 80.0
    val threshold = 80.0

    print "Checking coverage in {coverage} against {threshold}% threshold"

    coverage_check(coverage, threshold)


fn cmd_summary(args: [text]) -> i64:
    val coverage = get_arg(args, "--coverage", "")

    if coverage == "":
        print "Error: --coverage is required"
        return 1

    coverage_summary(coverage)

fn _bounded_number(args: [text], flag: text, default_value: i64,
                   hard_max: i64) -> i64:
    val raw = get_arg(args, flag, default_value.to_string())
    val parsed = raw.to_i64() ?? -1
    if parsed < 0 or parsed > hard_max:
        return -1
    parsed

fn _zero_workspace(byte_count: i64) -> [u8]:
    [for _ in 0..byte_count: 0u8]

fn _report_u64(bytes: [u8], offset: i64) -> u64:
    var result: u64 = 0u64
    var i = 0
    while i < 8:
        result = result | ((bytes[offset + i] as u64) << ((i * 8) as u64))
        i = i + 1
    result

fn _report_digest(bytes: [u8]) -> text:
    var digest: [u8] = []
    var i = 88
    while i < 152:
        digest.push(bytes[i])
        i = i + 1
    bytes_to_text(digest)

fn cmd_mcdc(args: [text]) -> i64:
    val manifest_path = get_arg(args, "--manifest", "")
    val events_path = get_arg(args, "--events", "")
    val exclusions_path = get_arg(args, "--exclusions", "")
    val exclusion_sources = get_all_args(args, "--exclusion-source")
    if manifest_path == "" or events_path == "":
        print "Error: mcdc requires --manifest and --events"
        return 1
    if not file_exists(manifest_path) or not file_exists(events_path):
        print "Error: MC/DC manifest or events file does not exist"
        return 1
    if exclusions_path != "" and not file_exists(exclusions_path):
        print "Error: MC/DC exclusions file does not exist"
        return 1
    for source_path in exclusion_sources:
        if not file_exists(source_path):
            print "Error: MC/DC exclusion source does not exist: {source_path}"
            return 1

    val max_events = _bounded_number(args, "--max-events", 65536, 1048576)
    val max_manifest_bytes = _bounded_number(
        args, "--max-manifest-bytes", 65536, 67108864)
    val max_programs = _bounded_number(args, "--max-programs", 4096, 1048576)
    val max_tokens = _bounded_number(args, "--max-tokens", 65536, 8388608)
    val max_witnesses = _bounded_number(args, "--max-witnesses", 65536, 1048576)
    val proof_budget = _bounded_number(args, "--proof-budget", 1000000, 1000000000)
    val current_epoch = _bounded_number(args, "--current-epoch", 0, 9223372036854775807)
    if max_events < 0 or max_manifest_bytes <= 0 or max_programs <= 0 or max_tokens <= 0 or
            max_witnesses <= 0 or proof_budget <= 0 or current_epoch < 0:
        print "Error: MC/DC capacity/epoch argument is invalid or above its hard bound"
        return 1
    val mode_name = get_arg(args, "--mode", "normal")
    val mode = if mode_name == "normal": 0 elif mode_name == "alpha": 1 elif mode_name == "beta": 2 else: -1
    if mode < 0:
        print "Error: --mode must be normal, alpha, or beta"
        return 1

    var manifest = file_read_bytes(manifest_path)
    var events = file_read_bytes(events_path)
    var exclusions: [u8] = []
    if exclusions_path != "":
        exclusions = file_read_bytes(exclusions_path)
    var exclusion_source = ""
    for source_path in exclusion_sources:
        val source_text = file_read(source_path) ?? ""
        if source_text == "":
            print "Error: MC/DC exclusion source is empty or unreadable: {source_path}"
            return 1
        exclusion_source = exclusion_source + source_text + "\n"
    val exclusion_binding = bind_mcdc_scenario_exclusions_v1(
        exclusion_source, exclusions, current_epoch)
    var exclusion_cursor: i64 = 0
    while exclusion_cursor <= exclusion_source.len():
        var line_end = exclusion_source.index_of("\n", exclusion_cursor)
        if line_end < 0:
            line_end = exclusion_source.len()
        val next_cursor = line_end + 1
        if mcdc_exclusion_line_is_directive_v1(
                exclusion_source, exclusion_cursor, line_end):
            if line_end - exclusion_cursor <= MCDC_EXCLUSION_MAX_LINE_BYTES:
                val line = exclusion_source.substring(exclusion_cursor, line_end)
                val parsed = parse_mcdc_scenario_exclusion_v1(line, current_epoch)
                print mcdc_scenario_exclusion_report_v1(parsed)
            else:
                print "ERROR mcdc-exclusion invalid"
        exclusion_cursor = next_cursor
        if line_end == exclusion_source.len(): break
    if manifest.len() == 0 or manifest.len() > max_manifest_bytes:
        print "Error: MC/DC manifest is empty or exceeds --max-manifest-bytes"
        return 1
    if events.len() % MCDC_VECTOR_V1_BYTES != 0 or
            events.len() / MCDC_VECTOR_V1_BYTES > max_events:
        print "Error: MC/DC events are malformed or exceed --max-events"
        return 1
    if exclusions.len() % MCDC_EXCLUSION_V1_BYTES != 0 or
            exclusions.len() / MCDC_EXCLUSION_V1_BYTES > max_programs:
        print "Error: MC/DC exclusions are malformed or exceed --max-programs"
        return 1

    # All allocation ends before the report boundary. The runtime analyzer only
    # mutates these fixed caller-owned regions and performs no I/O or allocation.
    var programs = _zero_workspace(max_programs * MCDC_DECISION_EXPR_V1_BYTES)
    var tokens = _zero_workspace(max_tokens * MCDC_EXPR_TOKEN_V1_BYTES)
    var witnesses = _zero_workspace(max_witnesses * MCDC_WITNESS_V1_BYTES)
    var report = _zero_workspace(MCDC_REPORT_V1_BYTES)
    val status = mcdc_runtime_report_manifest(
        events, manifest, exclusions, current_epoch as u64, mode as u32,
        programs, tokens, witnesses, proof_budget as u64, report)

    if status != MCDC_STATUS_OK and status != MCDC_STATUS_GATE_FAILED:
        if status == MCDC_STATUS_EMPTY_DENOMINATOR:
            print "MC/DC gate=ERROR reason=eligible denominator is empty"
            return 1
        print "MC/DC gate=ERROR status={status}"
        return 1

    val eligible = _report_u64(report, 24)
    val covered = _report_u64(report, 32)
    val uncovered = _report_u64(report, 40)
    val excluded = _report_u64(report, 16)
    val gross = _report_u64(report, 8)
    val decisions = _report_u64(report, 0)
    val events_count = _report_u64(report, 56)
    val witnesses_count = _report_u64(report, 64)
    val checks = _report_u64(report, 72)
    print "MC/DC mode={mode_name} decisions={decisions} eligible={eligible} covered={covered} uncovered={uncovered} excluded={excluded}"
    print "MC/DC evidence events={events_count} witnesses={witnesses_count} proof_checks={checks} provenance_sha256={_report_digest(report)}"
    val summary = mcdc_coverage_summary_v1(
        gross as i64, excluded as i64, covered as i64)
    val report_mode = if mode_name == "alpha":
        McdcReportModeV1.Alpha
    elif mode_name == "beta":
        McdcReportModeV1.Beta
    else:
        McdcReportModeV1.Normal
    val gate = mcdc_normal_gate_v1(
        report_mode, true, summary,
        excluded as i64, excluded as i64, 0)
    val audited_pass = mcdc_bound_normal_gate_v1_passes(gate, exclusion_binding)
    if status == MCDC_STATUS_OK and audited_pass:
        print "MC/DC gate=PASS"
        return 0
    if status == MCDC_STATUS_GATE_FAILED:
        print "MC/DC gate=FAIL reason=eligible coverage is not exactly 100%"
        return 1
    if status == MCDC_STATUS_OK:
        print "MC/DC gate=FAIL reason=governed exclusion directive audit failed"
        return 1
    1


fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("coverage", log_opts.error)
        return 1

    val args = clean_args(raw_args)

    if args.len() < 1:
        if log_opts.log_mode == "json":
            print "{\"command\":\"coverage\",\"status\":\"usage\"}"
            return 0
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_usage()
        return 0

    val command = args[0]

    match command:
        case "scan":
            return cmd_scan(args)
        case "class":
            return cmd_class(args)
        case "func":
            return cmd_func(args)
        case "report":
            return cmd_report(args)
        case "generate":
            return cmd_generate(args)
        case "check":
            return cmd_check(args)
        case "summary":
            return cmd_summary(args)
        case "mcdc":
            return cmd_mcdc(args)
        case "--help" | "-h" | "help":
            print_usage()
            return 0
        case _:
            print "Unknown command: {command}"
            print_usage()
            return 1
