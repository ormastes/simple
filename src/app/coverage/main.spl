"""
Coverage Analysis Tool

Commands:
  scan     - Scan source code and generate/update public_api.yml
  class    - Show class/struct touch coverage (for System Tests)
  func     - Show public function touch coverage (for Integration Tests)
  report   - Show full coverage report
  generate - Generate extended coverage reports
  check    - Check coverage against threshold
  summary  - Print coverage summary
"""

# Note: std.cli, std.fs, std.process would be used if available
# For now, we use basic functions and SFFI

# SFFI declarations for CLI
use std.cli.cli_util (get_cli_args)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use app.io.mod.{file_exists, file_size, file_read, file_read_bytes}
use std.common.string_core.{bytes_to_text}
use std.nogc_sync_mut.io.coverage_mcdc.{
    MCDC_VECTOR_V1_BYTES, MCDC_EXCLUSION_V1_BYTES, MCDC_REPORT_V1_BYTES,
    MCDC_DECISION_EXPR_V1_BYTES, MCDC_EXPR_TOKEN_V1_BYTES,
    MCDC_WITNESS_V1_BYTES, MCDC_STATUS_OK, MCDC_STATUS_GATE_FAILED,
    MCDC_STATUS_EMPTY_DENOMINATOR,
    MCDC_SOURCE_LOCATION_V2_BYTES, MCDC_DECISION_REPORT_V2_BYTES,
    MCDC_REPORT_V2_BYTES,
    mcdc_runtime_report_manifest, mcdc_runtime_report_manifest_v2,
    mcdc_runtime_merge_reports_v2
}
use std.common.structural.mcdc.contracts.{
    McdcReportModeV1, mcdc_coverage_summary_v1, mcdc_normal_gate_v1
}
use compiler.tools.verify.mcdc_scenario_exclusion.{
    MCDC_EXCLUSION_MAX_LINE_BYTES,
    parse_mcdc_scenario_exclusion_v1, mcdc_scenario_exclusion_report_v1,
    mcdc_exclusion_line_is_directive_v1,
    bind_mcdc_scenario_exclusions_with_evidence_v1,
    mcdc_bound_normal_gate_v1_passes
}

# SFFI declarations for Rust coverage functions
extern fn coverage_scan(source_dir: text, output_file: text) -> i64
extern fn coverage_class(coverage_json: text, source_dir: text, filter: text) -> i64
extern fn coverage_func(coverage_json: text, source_dir: text, filter: text) -> i64
extern fn coverage_report(coverage_json: text, public_api: text, type_filter: text) -> i64
extern fn coverage_generate(llvm_cov: text, api: text, output_dir: text, report_type: text) -> i64
extern fn coverage_check(coverage_file: text, threshold: f64) -> i64
extern fn coverage_summary(coverage_file: text) -> i64


fn print_usage():
    print "Usage: simple coverage <command> [options]"
    print ""
    print "Commands:"
    print "  scan      Scan source and generate public_api.yml"
    print "            --source <dir>   Source directory (default: src)"
    print "            --output <file>  Output YAML file (default: public_api.yml)"
    print ""
    print "  class     Show class/struct touch coverage"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --source <dir>          Source directory (default: src)"
    print "            --filter <pattern>      Filter by type name"
    print ""
    print "  func      Show public function touch coverage"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --source <dir>          Source directory (default: src)"
    print "            --filter <pattern>      Filter by crate/module"
    print ""
    print "  report    Show full coverage report (legacy)"
    print "            --coverage-json <file>  LLVM coverage JSON"
    print "            --public-api <file>     Public API YAML"
    print "            --type-filter <pattern> Filter by type name"
    print ""
    print "  generate  Generate extended coverage reports"
    print "            --llvm-cov <file>       LLVM coverage JSON"
    print "            --api <file>            Public API YAML"
    print "            --output-dir <dir>      Output directory (default: target/coverage)"
    print "            --report-type <type>    system|integration|merged|all (default: all)"
    print ""
    print "  check     Check coverage against threshold"
    print "            --coverage <file>       Extended coverage JSON"
    print "            --threshold <percent>   Threshold percentage (default: 80.0)"
    print ""
    print "  summary   Print coverage summary"
    print "            --coverage <file>       Extended coverage JSON"
    print ""
    print "  mcdc      Build the authoritative masking MC/DC report and gate"
    print "            --manifest <file>       Compiler MCDP V1 manifest (required)"
    print "            --events <file>         Sealed V1 vector rows (required)"
    print "            --exclusions <file>     Governed V1 exclusion rows (optional)"
    print "            --exclusion-source <f>  Source containing governed directives; repeatable"
    print "            --exclusion-evidence <f> Signed fixed-width evidence receipts"
    print "            --exclusion-trust-key <f> Trusted raw Ed25519 public key (32 bytes)"
    print "            --mode <mode>           normal|alpha|beta (default: normal)"
    print "            --current-epoch <n>     Exclusion freshness epoch"
    print "            --max-events <n>        Event bound (default: 65536)"
    print "            --max-manifest-bytes <n> Manifest bound (default: 65536)"
    print "            --max-programs <n>      Decision bound (default: 4096)"
    print "            --max-tokens <n>        Boolean token bound (default: 65536)"
    print "            --max-witnesses <n>     Evidence bound (default: 65536)"
    print "            --proof-budget <n>      Masking proof bound (default: 1000000)"
    print "            --report-version <v>    v1|v2 (default: v1)"
    print "            --locations <file>      V2 fixed 32-byte source rows"
    print "            --binary-identity <file> V2 raw lowercase executable SHA-256 text"
    print "            --process-id <n>        V2 nonzero process identity"
    print "            --process-sequence <n>  V2 nonzero process sequence"
    print "            --max-output-lines <n>  Fail-closed V2 display bound"
    print "  mcdc-merge Merge sorted authenticated V2 decision rows"
    print "            --input <file>          Fixed 208-byte V2 rows; repeatable"
    print "            --max-input-rows <n>    Aggregate row bound (default: 16384)"
    print "            --max-output-lines <n>  Fail-closed display bound"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"


fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")


fn clean_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if _is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned


fn get_arg(args: [text], flag: text, default_val: text) -> text:
    var i = 0
    while i < args.len() - 1:
        if args[i] == flag:
            return args[i + 1]
        i = i + 1
    default_val

fn get_all_args(args: [text], flag: text) -> [text]:
    var result: [text] = []
    var i = 0
    while i < args.len() - 1:
        if args[i] == flag:
            result.push(args[i + 1])
        i = i + 1
    result


fn cmd_scan(args: [text]) -> i64:
    val source = get_arg(args, "--source", "src")
    val output = get_arg(args, "--output", "public_api.yml")

    print "Scanning source directory: {source}"
    val result = coverage_scan(source, output)

    if result == 0:
        print "Written to: {output}"
    else:
        print "Error: scan failed with code {result}"

    result


fn cmd_class(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val source = get_arg(args, "--source", "src")
    val filter = get_arg(args, "--filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    coverage_class(coverage_json, source, filter)


fn cmd_func(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val source = get_arg(args, "--source", "src")
    val filter = get_arg(args, "--filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    coverage_func(coverage_json, source, filter)


fn cmd_report(args: [text]) -> i64:
    val coverage_json = get_arg(args, "--coverage-json", "")
    val public_api = get_arg(args, "--public-api", "")
    val type_filter = get_arg(args, "--type-filter", "")

    if coverage_json == "":
        print "Error: --coverage-json is required"
        return 1

    if public_api == "":
        print "Error: --public-api is required"
        return 1

    coverage_report(coverage_json, public_api, type_filter)


fn cmd_generate(args: [text]) -> i64:
    val llvm_cov = get_arg(args, "--llvm-cov", "")
    val api = get_arg(args, "--api", "")
    val output_dir = get_arg(args, "--output-dir", "target/coverage")
    val report_type = get_arg(args, "--report-type", "all")

    if llvm_cov == "":
        print "Error: --llvm-cov is required"
        return 1

    if api == "":
        print "Error: --api is required"
        return 1

    print "Loading coverage data from {llvm_cov}"
    print "Loading API spec from {api}"

    coverage_generate(llvm_cov, api, output_dir, report_type)


fn cmd_check(args: [text]) -> i64:
    val coverage = get_arg(args, "--coverage", "")
    val threshold_str = get_arg(args, "--threshold", "80.0")

    if coverage == "":
        print "Error: --coverage is required"
        return 1

    # Default threshold of 80.0
    val threshold = 80.0

    print "Checking coverage in {coverage} against {threshold}% threshold"

    coverage_check(coverage, threshold)


fn cmd_summary(args: [text]) -> i64:
    val coverage = get_arg(args, "--coverage", "")

    if coverage == "":
        print "Error: --coverage is required"
        return 1

    coverage_summary(coverage)

fn _bounded_number(args: [text], flag: text, default_value: i64,
                   hard_max: i64) -> i64:
    val raw = get_arg(args, flag, default_value.to_string())
    val parsed = raw.to_i64() ?? -1
    if parsed < 0 or parsed > hard_max:
        return -1
    parsed

fn _zero_workspace(byte_count: i64) -> [u8]:
    [for _ in 0..byte_count: 0u8]

fn _report_u64(bytes: [u8], offset: i64) -> u64:
    var result: u64 = 0u64
    var i = 0
    while i < 8:
        result = result | ((bytes[offset + i] as u64) << ((i * 8) as u64))
        i = i + 1
    result

fn _report_u32(bytes: [u8], offset: i64) -> u32:
    var result: u32 = 0u32
    var i = 0
    while i < 4:
        result = result | ((bytes[offset + i] as u32) << ((i * 8) as u32))
        i = i + 1
    result

fn _fixed_text(bytes: [u8], offset: i64, byte_count: i64) -> text:
    var selected: [u8] = []
    selected.reserve(byte_count)
    var i = 0
    while i < byte_count:
        selected.push(bytes[offset + i])
        i = i + 1
    bytes_to_text(selected)

fn _report_digest(bytes: [u8]) -> text:
    var digest: [u8] = []
    var i = 88
    while i < 152:
        digest.push(bytes[i])
        i = i + 1
    bytes_to_text(digest)

fn _emit_mcdc_v2(report: [u8], rows: [u8], witnesses: [u8],
                 witness_rows: i64, max_output_lines: i64) -> bool:
    val decision_rows = _report_u64(report, 96) as i64
    # Four summary lines, every decision row, and every concrete witness row.
    # Refuse partial output: certification evidence must never look complete
    # after display truncation.
    if decision_rows < 0 or witness_rows < 0 or
            decision_rows + witness_rows + 4 > max_output_lines:
        print "Error: MC/DC V2 report exceeds --max-output-lines"
        return false
    val process_count = _report_u64(report, 88)
    val process_id = _report_u64(report, 104)
    val process_sequence = _report_u64(report, 112)
    val mode = _report_u32(report, 120)
    val gate = _report_u32(report, 124)
    print "MC/DC report_schema=v2 mode={mode} gate={gate} process_count={process_count} process_id={process_id} process_sequence={process_sequence}"
    print "MC/DC identity binary_sha256={_fixed_text(report, 128, 64)} provenance_sha256={_fixed_text(report, 192, 64)}"
    print "MC/DC decisions gross={_report_u64(report, 0)} eligible={_report_u64(report, 8)} excluded={_report_u64(report, 16)} covered={_report_u64(report, 24)} uncovered={_report_u64(report, 32)}"
    print "MC/DC conditions gross={_report_u64(report, 40)} eligible={_report_u64(report, 48)} excluded={_report_u64(report, 56)} covered={_report_u64(report, 64)} uncovered={_report_u64(report, 72)} witnessed_pairs={_report_u64(report, 80)}"
    var row_index = 0
    while row_index < decision_rows:
        val offset = row_index * MCDC_DECISION_REPORT_V2_BYTES
        print "MC/DC decision index={row_index} decision_id={_report_u64(rows, offset)} source_digest={_report_u64(rows, offset + 8)} file_digest={_report_u64(rows, offset + 16)} line={_report_u32(rows, offset + 64)} column={_report_u32(rows, offset + 68)} conditions={_report_u32(rows, offset + 72)} covered_mask={_report_u64(rows, offset + 24)} excluded_mask={_report_u64(rows, offset + 32)} eligible_mask={_report_u64(rows, offset + 40)} process_id={_report_u64(rows, offset + 48)} process_sequence={_report_u64(rows, offset + 56)} binary_sha256={_fixed_text(rows, offset + 80, 64)} row_provenance_sha256={_fixed_text(rows, offset + 144, 64)}"
        row_index = row_index + 1
    var witness_index = 0
    while witness_index < witness_rows:
        val offset = witness_index * MCDC_WITNESS_V1_BYTES
        print "MC/DC witness index={witness_index} decision_id={_report_u64(witnesses, offset)} source_digest={_report_u64(witnesses, offset + 8)} condition={_report_u32(witnesses, offset + 16)} policy={_report_u32(witnesses, offset + 20)} owner_a={_report_u64(witnesses, offset + 24)} sequence_a={_report_u64(witnesses, offset + 32)} owner_b={_report_u64(witnesses, offset + 40)} sequence_b={_report_u64(witnesses, offset + 48)}"
        witness_index = witness_index + 1
    true

fn cmd_mcdc_merge(args: [text]) -> i64:
    val input_paths = get_all_args(args, "--input")
    if input_paths.len() == 0:
        print "Error: mcdc-merge requires at least one --input"
        return 1
    val max_input_rows = _bounded_number(args, "--max-input-rows", 16384, 1048576)
    val max_output_lines = _bounded_number(args, "--max-output-lines", 20000, 1048580)
    if max_input_rows <= 0 or max_output_lines < 4:
        print "Error: MC/DC V2 merge capacity is invalid or above its hard bound"
        return 1
    var total_bytes: i64 = 0
    for path in input_paths:
        if not file_exists(path):
            print "Error: MC/DC V2 merge input does not exist: {path}"
            return 1
        val byte_count = file_size(path)
        if byte_count <= 0 or byte_count % MCDC_DECISION_REPORT_V2_BYTES != 0 or
                total_bytes > max_input_rows * MCDC_DECISION_REPORT_V2_BYTES - byte_count:
            print "Error: MC/DC V2 merge input is malformed or exceeds --max-input-rows"
            return 1
        total_bytes = total_bytes + byte_count
    var inputs: [u8] = []
    inputs.reserve(total_bytes)
    for path in input_paths:
        val part = file_read_bytes(path)
        for byte in part:
            inputs.push(byte)
    val input_rows = total_bytes / MCDC_DECISION_REPORT_V2_BYTES
    # At least two processes are required, so output rows cannot exceed the
    # input count. The native owner validates the exact common process set.
    var outputs = _zero_workspace(input_rows * MCDC_DECISION_REPORT_V2_BYTES)
    var report = _zero_workspace(MCDC_REPORT_V2_BYTES)
    val status = mcdc_runtime_merge_reports_v2(inputs, outputs, report)
    if status != MCDC_STATUS_OK and status != MCDC_STATUS_GATE_FAILED:
        print "MC/DC V2 merge=ERROR status={status}"
        return 1
    val merged_rows = _report_u64(report, 96) as i64
    val merged_processes = _report_u64(report, 88) as i64
    val merged_witnesses = _report_u64(report, 80) as i64
    if merged_rows + merged_processes + merged_witnesses + 4 > max_output_lines:
        print "Error: MC/DC V2 merge report exceeds --max-output-lines"
        return 1
    if not _emit_mcdc_v2(report, outputs, [], 0, max_output_lines):
        return 1
    var process_index = 0
    while process_index < merged_processes:
        val offset = process_index * MCDC_DECISION_REPORT_V2_BYTES
        print "MC/DC merge_process index={process_index} process_id={_report_u64(inputs, offset + 48)} process_sequence={_report_u64(inputs, offset + 56)}"
        process_index = process_index + 1
    var row_index = 0
    while row_index < merged_rows:
        val offset = row_index * MCDC_DECISION_REPORT_V2_BYTES
        val covered_mask = _report_u64(outputs, offset + 24)
        val condition_count = _report_u32(outputs, offset + 72) as i64
        var condition_index = 0
        while condition_index < condition_count:
            if (covered_mask & (1u64 << (condition_index as u64))) != 0u64:
                print "MC/DC merged_witness decision_id={_report_u64(outputs, offset)} source_digest={_report_u64(outputs, offset + 8)} condition={condition_index}"
            condition_index = condition_index + 1
        row_index = row_index + 1
    if status == MCDC_STATUS_OK:
        print "MC/DC gate=PASS"
        return 0
    print "MC/DC gate=FAIL reason=eligible coverage is not exactly 100%"
    1

fn cmd_mcdc(args: [text]) -> i64:
    val manifest_path = get_arg(args, "--manifest", "")
    val events_path = get_arg(args, "--events", "")
    val report_version = get_arg(args, "--report-version", "v1")
    val locations_path = get_arg(args, "--locations", "")
    val binary_identity_path = get_arg(args, "--binary-identity", "")
    val exclusions_path = get_arg(args, "--exclusions", "")
    val evidence_path = get_arg(args, "--exclusion-evidence", "")
    val trust_key_path = get_arg(args, "--exclusion-trust-key", "")
    val exclusion_sources = get_all_args(args, "--exclusion-source")
    if manifest_path == "" or events_path == "":
        print "Error: mcdc requires --manifest and --events"
        return 1
    if report_version != "v1" and report_version != "v2":
        print "Error: --report-version must be v1 or v2"
        return 1
    if report_version == "v2" and
            (locations_path == "" or binary_identity_path == ""):
        print "Error: MC/DC V2 requires --locations and --binary-identity"
        return 1
    if not file_exists(manifest_path) or not file_exists(events_path):
        print "Error: MC/DC manifest or events file does not exist"
        return 1
    if report_version == "v2" and
            (not file_exists(locations_path) or not file_exists(binary_identity_path)):
        print "Error: MC/DC V2 locations or binary identity file does not exist"
        return 1
    if exclusions_path != "" and not file_exists(exclusions_path):
        print "Error: MC/DC exclusions file does not exist"
        return 1
    if evidence_path != "" and not file_exists(evidence_path):
        print "Error: MC/DC exclusion evidence file does not exist"
        return 1
    if trust_key_path != "" and not file_exists(trust_key_path):
        print "Error: MC/DC exclusion trust key does not exist"
        return 1
    if exclusions_path != "" and (evidence_path == "" or trust_key_path == ""):
        print "Error: governed exclusions require signed evidence and a trust key"
        return 1
    # Size before read: adversarial evidence must not allocate an unbounded
    # buffer merely to reach the bounded decoder.
    val exclusion_file_bytes = if exclusions_path != "": file_size(exclusions_path) else: 0
    val evidence_file_bytes = if evidence_path != "": file_size(evidence_path) else: 0
    val trust_key_bytes = if trust_key_path != "": file_size(trust_key_path) else: 0
    if exclusion_file_bytes < 0 or exclusion_file_bytes > 96256:
        print "Error: MC/DC exclusions exceed the 256-row hard bound"
        return 1
    if evidence_file_bytes < 0 or evidence_file_bytes > 81920:
        print "Error: MC/DC exclusion evidence exceeds the 256-row hard bound"
        return 1
    if trust_key_path != "" and trust_key_bytes != 32:
        print "Error: MC/DC exclusion trust key must be exactly 32 bytes"
        return 1
    for source_path in exclusion_sources:
        if not file_exists(source_path):
            print "Error: MC/DC exclusion source does not exist: {source_path}"
            return 1

    val max_events = _bounded_number(args, "--max-events", 65536, 1048576)
    val max_manifest_bytes = _bounded_number(
        args, "--max-manifest-bytes", 65536, 67108864)
    val max_programs = _bounded_number(args, "--max-programs", 4096, 1048576)
    val max_tokens = _bounded_number(args, "--max-tokens", 65536, 8388608)
    val max_witnesses = _bounded_number(args, "--max-witnesses", 65536, 1048576)
    val max_output_lines = _bounded_number(args, "--max-output-lines", 20000, 1048580)
    val proof_budget = _bounded_number(args, "--proof-budget", 1000000, 1000000000)
    val current_epoch = _bounded_number(args, "--current-epoch", 0, 9223372036854775807)
    val process_id = _bounded_number(args, "--process-id", 1, 9223372036854775807)
    val process_sequence = _bounded_number(args, "--process-sequence", 1, 9223372036854775807)
    if max_events < 0 or max_manifest_bytes <= 0 or max_programs <= 0 or max_tokens <= 0 or
            max_witnesses <= 0 or max_output_lines < 4 or proof_budget <= 0 or
            current_epoch < 0 or process_id <= 0 or process_sequence <= 0:
        print "Error: MC/DC capacity/epoch argument is invalid or above its hard bound"
        return 1
    val mode_name = get_arg(args, "--mode", "normal")
    val mode = if mode_name == "normal": 0 elif mode_name == "alpha": 1 elif mode_name == "beta": 2 else: -1
    if mode < 0:
        print "Error: --mode must be normal, alpha, or beta"
        return 1

    var manifest = file_read_bytes(manifest_path)
    var events = file_read_bytes(events_path)
    var locations: [u8] = []
    var binary_identity: [u8] = []
    if report_version == "v2":
        val locations_bytes = file_size(locations_path)
        val identity_bytes = file_size(binary_identity_path)
        if locations_bytes <= 0 or
                locations_bytes > max_programs * MCDC_SOURCE_LOCATION_V2_BYTES or
                locations_bytes % MCDC_SOURCE_LOCATION_V2_BYTES != 0:
            print "Error: MC/DC V2 locations are malformed or exceed --max-programs"
            return 1
        if identity_bytes != 64:
            print "Error: MC/DC V2 binary identity must be exactly 64 raw lowercase SHA-256 bytes"
            return 1
        locations = file_read_bytes(locations_path)
        binary_identity = file_read_bytes(binary_identity_path)
    var exclusions: [u8] = []
    if exclusions_path != "":
        exclusions = file_read_bytes(exclusions_path)
    var exclusion_source = ""
    for source_path in exclusion_sources:
        val source_text = file_read(source_path) ?? ""
        if source_text == "":
            print "Error: MC/DC exclusion source is empty or unreadable: {source_path}"
            return 1
        exclusion_source = exclusion_source + source_text + "\n"
    var evidence_rows: [u8] = []
    var trust_key: [u8] = []
    if evidence_path != "": evidence_rows = file_read_bytes(evidence_path)
    if trust_key_path != "": trust_key = file_read_bytes(trust_key_path)
    val exclusion_binding = bind_mcdc_scenario_exclusions_with_evidence_v1(
        exclusion_source, exclusions, evidence_rows, trust_key, current_epoch)
    var exclusion_cursor: i64 = 0
    while exclusion_cursor <= exclusion_source.len():
        var line_end = exclusion_source.index_of("\n", exclusion_cursor)
        if line_end < 0:
            line_end = exclusion_source.len()
        val next_cursor = line_end + 1
        if mcdc_exclusion_line_is_directive_v1(
                exclusion_source, exclusion_cursor, line_end):
            if line_end - exclusion_cursor <= MCDC_EXCLUSION_MAX_LINE_BYTES:
                val line = exclusion_source.substring(exclusion_cursor, line_end)
                val parsed = parse_mcdc_scenario_exclusion_v1(line, current_epoch)
                print mcdc_scenario_exclusion_report_v1(parsed)
            else:
                print "ERROR mcdc-exclusion invalid"
        exclusion_cursor = next_cursor
        if line_end == exclusion_source.len(): break
    if manifest.len() == 0 or manifest.len() > max_manifest_bytes:
        print "Error: MC/DC manifest is empty or exceeds --max-manifest-bytes"
        return 1
    if events.len() % MCDC_VECTOR_V1_BYTES != 0 or
            events.len() / MCDC_VECTOR_V1_BYTES > max_events:
        print "Error: MC/DC events are malformed or exceed --max-events"
        return 1
    if exclusions.len() % MCDC_EXCLUSION_V1_BYTES != 0 or
            exclusions.len() / MCDC_EXCLUSION_V1_BYTES > max_programs:
        print "Error: MC/DC exclusions are malformed or exceed --max-programs"
        return 1

    # All allocation ends before the report boundary. The runtime analyzer only
    # mutates these fixed caller-owned regions and performs no I/O or allocation.
    var programs = _zero_workspace(max_programs * MCDC_DECISION_EXPR_V1_BYTES)
    var tokens = _zero_workspace(max_tokens * MCDC_EXPR_TOKEN_V1_BYTES)
    var witnesses = _zero_workspace(max_witnesses * MCDC_WITNESS_V1_BYTES)
    var report = if report_version == "v2":
        _zero_workspace(MCDC_REPORT_V2_BYTES)
    else:
        _zero_workspace(MCDC_REPORT_V1_BYTES)
    var decision_rows: [u8] = []
    var status: i32 = MCDC_STATUS_INVALID
    if report_version == "v2":
        decision_rows = _zero_workspace(max_programs * MCDC_DECISION_REPORT_V2_BYTES)
        status = mcdc_runtime_report_manifest_v2(
            events, manifest, binary_identity, exclusions, locations,
            current_epoch as u64, mode as u32,
            process_id as u64, process_sequence as u64,
            programs, tokens, witnesses, decision_rows,
            proof_budget as u64, report)
    else:
        status = mcdc_runtime_report_manifest(
            events, manifest, exclusions, current_epoch as u64, mode as u32,
            programs, tokens, witnesses, proof_budget as u64, report)

    if status != MCDC_STATUS_OK and status != MCDC_STATUS_GATE_FAILED:
        if status == MCDC_STATUS_EMPTY_DENOMINATOR:
            print "MC/DC gate=ERROR reason=eligible denominator is empty"
            return 1
        print "MC/DC gate=ERROR status={status}"
        return 1

    if report_version == "v2":
        val witness_rows = _report_u64(report, 80) as i64
        if not _emit_mcdc_v2(
                report, decision_rows, witnesses, witness_rows, max_output_lines):
            return 1
        if status == MCDC_STATUS_OK:
            print "MC/DC gate=PASS"
            return 0
        print "MC/DC gate=FAIL reason=eligible coverage is not exactly 100%"
        return 1

    val eligible = _report_u64(report, 24)
    val covered = _report_u64(report, 32)
    val uncovered = _report_u64(report, 40)
    val excluded = _report_u64(report, 16)
    val gross = _report_u64(report, 8)
    val decisions = _report_u64(report, 0)
    val events_count = _report_u64(report, 56)
    val witnesses_count = _report_u64(report, 64)
    val checks = _report_u64(report, 72)
    print "MC/DC mode={mode_name} decisions={decisions} eligible={eligible} covered={covered} uncovered={uncovered} excluded={excluded}"
    print "MC/DC evidence events={events_count} witnesses={witnesses_count} proof_checks={checks} provenance_sha256={_report_digest(report)}"
    val summary = mcdc_coverage_summary_v1(
        gross as i64, excluded as i64, covered as i64)
    val report_mode = if mode_name == "alpha":
        McdcReportModeV1.Alpha
    elif mode_name == "beta":
        McdcReportModeV1.Beta
    else:
        McdcReportModeV1.Normal
    val gate = mcdc_normal_gate_v1(
        report_mode, true, summary,
        excluded as i64, excluded as i64, 0)
    val audited_pass = mcdc_bound_normal_gate_v1_passes(gate, exclusion_binding)
    if status == MCDC_STATUS_OK and audited_pass:
        print "MC/DC gate=PASS"
        return 0
    if status == MCDC_STATUS_GATE_FAILED:
        print "MC/DC gate=FAIL reason=eligible coverage is not exactly 100%"
        return 1
    if status == MCDC_STATUS_OK:
        print "MC/DC gate=FAIL reason=governed exclusion directive audit failed"
        return 1
    1


fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("coverage", log_opts.error)
        return 1

    val args = clean_args(raw_args)

    if args.len() < 1:
        if log_opts.log_mode == "json":
            print "{\"command\":\"coverage\",\"status\":\"usage\"}"
            return 0
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_usage()
        return 0

    val command = args[0]

    match command:
        case "scan":
            return cmd_scan(args)
        case "class":
            return cmd_class(args)
        case "func":
            return cmd_func(args)
        case "report":
            return cmd_report(args)
        case "generate":
            return cmd_generate(args)
        case "check":
            return cmd_check(args)
        case "summary":
            return cmd_summary(args)
        case "mcdc":
            return cmd_mcdc(args)
        case "mcdc-merge":
            return cmd_mcdc_merge(args)
        case "--help" | "-h" | "help":
            print_usage()
            return 0
        case _:
            print "Unknown command: {command}"
            print_usage()
            return 1
