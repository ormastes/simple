# LabLocalExec — minimal real local-lane `NotebookExecutor` for Simple Lab
# (Stream L, task L2: doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md).
#
# K2 ("Port existing local execution behind `LocalExec`") has not landed yet
# (its target home is `src/lib/nogc_sync_mut/notebook/local_exec.spl`, refactored
# out of `src/app/jupyter_kernel/session.spl`). L2 needs *some* real
# `NotebookExecutor` to drive `KernelSessionManager` in-process (the repo's
# anti-dummy-body rule forbids a fabricated/stub executor), so this module is a
# small, Lab-scoped, real-execution stand-in: it accumulates cell source per
# executor instance (not the module-level globals `session.spl` uses, which
# would corrupt concurrent sessions) and runs it through a real
# `bin/simple run` subprocess, same mechanism as the Jupyter kernel.
#
# This is intentionally NOT the final local-lane implementation — when K2
# lands its shared `LocalExec`, Simple Lab should switch its factory to that
# module and this file can be deleted. Until then it gives L2 (and its
# verification spec) genuine cell execution instead of a placeholder.

use std.notebook.types.{CellResult, SessionOpts, LaneStatus, cell_result_ok, cell_result_error}
use std.notebook.executor.{NotebookExecutor, NotebookExecutorFactory}
use app.io.mod.{process_run_timeout}
use std.io_runtime.{file_write, file_exists, getpid}

val LAB_EXEC_TIMEOUT_MS: i64 = 15000

fn _lab_find_simple_runtime() -> text:
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("bin/release/x86_64-unknown-linux-gnu/simple"):
        return "bin/release/x86_64-unknown-linux-gnu/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

class LabLocalExec:
    mode_text: text
    started: bool
    code_history: [text]
    last_stdout: text
    temp_path: text

    static fn create(mode_spec: text) -> LabLocalExec:
        LabLocalExec(mode_text: mode_spec, started: false, code_history: [], last_stdout: "", temp_path: "")

impl NotebookExecutor for LabLocalExec:
    fn mode_spec() -> text:
        self.mode_text

    fn probe() -> LaneStatus:
        LaneStatus.Available

    me start(opts: SessionOpts):
        self.started = true
        self.code_history = []
        self.last_stdout = ""
        self.temp_path = "/tmp/simple_lab_{getpid()}_{opts.session_id}.spl"

    me execute_cell(code: text, cell_id: text) -> CellResult:
        if not self.started:
            return cell_result_error("Executor not started", 0)

        self.code_history.push(code)
        var full_code = ""
        var i = 0
        while i < self.code_history.len():
            full_code = full_code + self.code_history[i] + "\n"
            i = i + 1

        file_write(self.temp_path, full_code)
        val runtime = _lab_find_simple_runtime()
        val (stdout, stderr, exit_code) = process_run_timeout(runtime, ["run", self.temp_path], LAB_EXEC_TIMEOUT_MS)

        if exit_code != 0:
            self.code_history = _lab_remove_last(self.code_history)
            return cell_result_error(stderr, 0)

        val delta = _lab_stdout_delta(self.last_stdout, stdout)
        self.last_stdout = stdout
        cell_result_ok(delta, [], [], 0)

    me interrupt():
        pass_do_nothing("subprocess-per-cell execution has nothing in flight to interrupt between cells")

    me reset():
        self.code_history = []
        self.last_stdout = ""

    me shutdown():
        self.started = false

fn _lab_remove_last(arr: [text]) -> [text]:
    if arr.len() <= 1:
        return []
    var result: [text] = []
    var i = 0
    while i < arr.len() - 1:
        result.push(arr[i])
        i = i + 1
    result

fn _lab_stdout_delta(previous: text, current: text) -> text:
    if previous == "":
        return current
    if current.starts_with(previous):
        return current.substring(previous.length(), current.length())
    current

class LabLocalExecFactory:
    static fn create() -> LabLocalExecFactory:
        LabLocalExecFactory()

impl NotebookExecutorFactory for LabLocalExecFactory:
    me create(mode_spec: text) -> NotebookExecutor:
        LabLocalExec.create(mode_spec)

export LabLocalExec, LabLocalExecFactory
