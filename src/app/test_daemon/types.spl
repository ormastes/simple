# Test Daemon Types — Request kinds, response statuses, configuration
#
# Defines the test-specific protocol layered on top of daemon_sdk.


use std.daemon_sdk.types.{DaemonConfig, DaemonRequest, DaemonResponse, daemon_config_new, daemon_request_new}
use app.test_daemon.resource_policy.{TestDaemonResourcePolicy, test_daemon_resource_policy_default}

# ============================================================================
# Request Kinds
# ============================================================================

val TREQ_RUN_SINGLE: i64 = 1
val TREQ_RUN_ALL: i64 = 2
val TREQ_CLEAN_RUN: i64 = 3
pub val TREQ_STATUS: i64 = 4
pub val TREQ_STOP: i64 = 5
val TREQ_AGENT_REGISTER: i64 = 10
val TREQ_AGENT_HEARTBEAT: i64 = 11
val TREQ_AGENT_CLAIM_BATCH: i64 = 12
val TREQ_AGENT_REPORT_RESULT: i64 = 13
val TREQ_AGENT_DEREGISTER: i64 = 14

# Session management request kinds
val TREQ_SESSION_ACQUIRE: i64 = 20
val TREQ_SESSION_RELEASE: i64 = 21
val TREQ_SESSION_STATUS: i64 = 22
val TREQ_SESSION_RESET: i64 = 23
val TREQ_SESSION_EXECUTE: i64 = 24
val TREQ_SESSION_STOP: i64 = 25

# ============================================================================
# Response Statuses
# ============================================================================

val TRESP_QUEUED: i64 = 0
val TRESP_RUNNING: i64 = 1
pub val TRESP_COMPLETED: i64 = 2
pub val TRESP_FAILED: i64 = 3
val TRESP_SKIPPED: i64 = 4
pub val TRESP_ERROR: i64 = 5
val TRESP_CACHED: i64 = 6

# ============================================================================
# Configuration
# ============================================================================

struct TestDaemonConfig:
    daemon: DaemonConfig
    cache_path: text
    dep_graph_path: text
    qemu_session_timeout_ms: i64
    max_qemu_sessions: i64
    session_share: bool
    session_daemon: bool
    session_idle_timeout_ms: i64
    session_startup_timeout_ms: i64
    resource_policy: TestDaemonResourcePolicy

fn test_daemon_config_default() -> TestDaemonConfig:
    val dc = daemon_config_new(
        ".build/test_daemon/test_daemon.lock",
        ".build/test_daemon/requests",
        ".build/test_daemon/responses"
    )
    TestDaemonConfig(
        daemon: dc,
        # Renamed when the cache became MC/DC-on only: entries recorded by an
        # older daemon may come from an MC/DC-off environment.
        cache_path: ".build/test_daemon/test_cache_mcdc_on.sdn",
        dep_graph_path: ".build/test_daemon/dep_graph.sdn",
        qemu_session_timeout_ms: 300000,
        max_qemu_sessions: 4,
        session_share: false,
        session_daemon: false,
        session_idle_timeout_ms: 300000,
        session_startup_timeout_ms: 60000,
        resource_policy: test_daemon_resource_policy_default()
    )

# ============================================================================
# Test Result
# ============================================================================

struct TestResult:
    test_path: text
    status: i64
    passed: i64
    failed: i64
    skipped: i64
    duration_ms: i64
    output: text
    cached: bool

# ============================================================================
# Agent Info
# ============================================================================

struct AgentInfo:
    agent_id: text
    registered_at: i64
    last_heartbeat: i64
    tests_completed: i64
    tests_in_progress: i64
    capabilities: text

# ============================================================================
# Conversions
# ============================================================================

fn test_request_to_daemon(kind: i64, test_path: text, filter: text, clean: bool) -> DaemonRequest:
    var req = daemon_request_new(kind)
    req.fields["test_path"] = test_path
    req.fields["filter"] = filter
    if clean:
        req.fields["clean"] = "true"
    req

fn daemon_response_to_test_result(resp: DaemonResponse) -> TestResult:
    TestResult(
        test_path: resp.fields["test_path"] ?? "",
        status: resp.status,
        passed: (resp.fields["passed"] ?? "0").to_i64() ?? 0,
        failed: (resp.fields["failed"] ?? "0").to_i64() ?? 0,
        skipped: (resp.fields["skipped"] ?? "0").to_i64() ?? 0,
        duration_ms: (resp.fields["duration_ms"] ?? "0").to_i64() ?? 0,
        output: resp.fields["output"] ?? "",
        cached: resp.fields["cached"] ?? "" == "true"
    )

# ============================================================================
# Per-request MC/DC mode (the CLIENT's resolved mode, never the daemon's env)
# ============================================================================
#
# A daemon-run child used to inherit the DAEMON's environment, so a daemon
# started with SIMPLE_MCDC_MODE=off plus a valid waiver kept MC/DC off for
# every later client, waiver or not. The client resolves its own mode
# (apply_mcdc_mode_env, which already refused invalid-off with exit 2) and
# sends it here; the daemon applies exactly that to each child.
# Fail closed both ways: a request without the field (old client) runs with
# MC/DC on and no waiver, and a response without the echoed mode (old daemon)
# is rejected by the client.

val TEST_DAEMON_MCDC_WAIVER_VARS: [text] = [
    "SIMPLE_MCDC_OFF_WAIVER_REASON", "SIMPLE_MCDC_OFF_WAIVER_REVIEWER",
    "SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID", "SIMPLE_MCDC_OFF_WAIVER_VERSION"]

fn test_request_set_mcdc(req: DaemonRequest, mode: text, waivers: [text], profile: text = "") -> DaemonRequest:
    var out = req
    out.fields["mcdc_mode"] = mode
    out.fields["mcdc_profile"] = profile
    var i = 0
    while i < TEST_DAEMON_MCDC_WAIVER_VARS.len():
        out.fields["mcdc_waiver_{i}"] = if mode == "off" and i < waivers.len(): waivers[i] else: ""
        i = i + 1
    out

fn test_request_mcdc_mode(fields: {text: text}) -> text:
    val mode = fields["mcdc_mode"] ?? ""
    if mode == "off" or mode == "dynamic": mode else: "on"

fn _test_daemon_shell_quote(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

# Shell prefix that pins the child's MC/DC environment to the request,
# overriding whatever the daemon inherited. Waivers travel only with "off".
fn test_daemon_mcdc_child_env_prefix(fields: {text: text}) -> text:
    val mode = test_request_mcdc_mode(fields)
    var parts: [text] = ["SIMPLE_MCDC_MODE=" + _test_daemon_shell_quote(mode),
        "SIMPLE_MCDC_MODE_ERROR="]
    var i = 0
    while i < TEST_DAEMON_MCDC_WAIVER_VARS.len():
        val value = if mode == "off": fields["mcdc_waiver_{i}"] ?? "" else: ""
        parts.push(TEST_DAEMON_MCDC_WAIVER_VARS[i] + "=" + _test_daemon_shell_quote(value))
        i = i + 1
    parts.join(" ")

# The client's resolved safety profile decides whether "off" needs a waiver;
# the child must re-resolve against the same profile, not the daemon's.
fn test_daemon_mcdc_child_profile_arg(fields: {text: text}) -> text:
    val profile = fields["mcdc_profile"] ?? ""
    if profile == "": "" else: " " + _test_daemon_shell_quote("--profile=" + profile)
