# Lightweight test daemon for explicit single-file test requests.

use std.sffi.cli.{cli_get_args}
use app.io.process_ops.{process_run_bounded}
use std.test_runner.test_runner_types.{TEST_OUTPUT_CAPTURE_BYTES}
use app.test_daemon.light_protocol.{light_request_deadline, light_request_parse, timeout_verdict_line, has_verdict_line, exit_code_reason}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_list(path: text) -> [text]
use std.io_runtime.{file_exists}
extern fn rt_file_read_text(path: text) -> text
use std.io_runtime.{read_file_text}
extern fn rt_file_write_text(path: text, content: text) -> bool
use std.io_runtime.{file_delete}
extern fn rt_file_rename(from: text, to: text) -> bool
use std.io_runtime.{getpid}
use std.io_runtime.{thread_sleep}
use std.io_runtime.{time_now_unix_micros}
extern fn rt_path_absolute(path: text) -> text
use std.io_runtime.{env_get}

# Atomic write: tmp + rename (see test_runner_client.spl for the race this
# closes — #98: a plain rt_file_write_text response could be observed
# 0-byte/partial by the polling client between this daemon's open(truncate)
# and its write()).
fn atomic_write_text(path: text, content: text) -> bool:
    val tmp_path = "{path}.tmp"
    if rt_file_write_text(tmp_path, content):
        if rt_file_rename(tmp_path, path):
            return true
        file_delete(tmp_path)
    rt_file_write_text(path, content)

val LIGHT_DAEMON_DIR: text = ".build/test_daemon_light"
val LIGHT_REQ_DIR: text = ".build/test_daemon_light/requests"
val LIGHT_RESP_DIR: text = ".build/test_daemon_light/responses"
val LIGHT_LOCK: text = ".build/test_daemon_light/daemon.lock"
val LIGHT_STOP: text = ".build/test_daemon_light/stop"
# Published so a client can see WHICH compiler this daemon will run every served
# spec with. Without it the daemon lane is unobservable: the caller cannot tell
# that its freshly built binary was replaced by whatever started the daemon.
val LIGHT_BINARY: text = ".build/test_daemon_light/daemon.binary"

fn invoking_binary() -> text:
    """Absolute path of the compiler binary running THIS process ("" if unknown).

    Canonicalizes /proc/self/exe IN-PROCESS; never shells out (a spawned
    helper's /proc/self describes the HELPER). The daemon is spawned as
    `<binary> run light_daemon.spl`, so this is exactly the compiler the client
    chose — inheriting it is what keeps a daemon-served spec honest. See
    doc/08_tracking/bug/
    simple_test_child_binary_ignores_invoking_binary_recurrence_2026-08-08.md."""
    val self_path = rt_path_absolute("/proc/self/exe") ?? ""
    if self_path.len() > 0 and self_path != "/proc/self/exe" and file_exists(self_path):
        return self_path
    ""

fn simple_binary() -> text:
    val configured = (env_get("SIMPLE_BINARY") ?? "")
    if configured != "" and file_exists(configured):
        return configured
    # The invoking binary outranks every guessed candidate below. argv[0] here
    # is this script's own source path, so the raw[0] check never fires for the
    # daemon and the old order fell straight through to bin/simple — pinning
    # every served spec to the deployed binary regardless of who started us.
    val invoker = invoking_binary()
    if invoker != "":
        return invoker
    val raw = cli_get_args()
    # Source-mode argv can begin with this file's own .spl path (when the seed
    # interprets light_daemon.spl directly via `simple run <this file>`). It
    # exists, but it is not executable; passing it to process_run_timeout
    # produces a misleading permission-denied failure instead of running the
    # test. Same fix as test_runner_single.spl's simple_binary().
    if raw.len() > 0 and (raw[0].ends_with("/simple") or raw[0].ends_with("simple.exe")) and file_exists(raw[0]):
        return raw[0]
    # bin/simple (the deployed pure-Simple self-hosted binary — see
    # .claude/rules/bootstrap.md "Default tooling runs on pure-Simple") MUST be
    # tried before any Rust-seed candidate. This daemon is long-lived (it
    # serves every `bin/simple test <spec>` request until stopped), and the
    # raw[0] check above reliably fails here (argv[0] is this script's own
    # source path when the daemon itself was launched via `simple run
    # light_daemon.spl`), so the old order — debug seed checked before
    # bin/simple — pinned the daemon to a stray dev-loop
    # src/compiler_rust/target/debug/simple build for every test it served,
    # for its entire lifetime. A debug interpreter is 10-50x slower than
    # release, so specs that finish in seconds under bin/simple instead blow
    # through *any* --timeout / SIMPLE_TIMEOUT_SECONDS override passed to this
    # daemon (the override still fires — it just can't rescue a run that was
    # never going to finish in time), always ending in "Process timed out".
    # See doc/08_tracking/bug/test_client_debug_seed_binary_shadowing_timeout_2026-08-06.md.
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("/proc/self/exe"):
        return "/proc/self/exe"
    if file_exists("src/compiler_rust/target/debug/simple"):
        return "src/compiler_rust/target/debug/simple"
    "./bin/simple"

fn ensure_dirs():
    rt_dir_create_all(LIGHT_DAEMON_DIR)
    rt_dir_create_all(LIGHT_REQ_DIR)
    rt_dir_create_all(LIGHT_RESP_DIR)

fn response_path(name: text) -> text:
    "{LIGHT_RESP_DIR}/{basename(name)}.resp"

fn basename(path: text) -> text:
    val parts = path.split("/")
    if parts.len() == 0:
        return path
    parts[parts.len() - 1]

fn handle_request(binary: text, name: text):
    if not name.ends_with(".req"):
        return
    val req_path = if name.contains("/"): name else: "{LIGHT_REQ_DIR}/{name}"
    val request = light_request_parse(read_file_text(req_path))
    val test_path = request.0
    if test_path == "":
        atomic_write_text(response_path(name), "1\nmissing test path")
        file_delete(req_path)
        return
    val deadline = light_request_deadline(request.1, time_now_unix_micros())
    if deadline.0:
        atomic_write_text(response_path(name), "1\nERROR: test daemon request expired before execution")
        file_delete(req_path)
        return
    val timeout_ms = deadline.1
    val timeout_secs = (timeout_ms + 999) / 1000
    val (stdout, stderr, code) = process_run_bounded(
        binary,
        ["run", "src/app/test_runner_new/test_runner_single.spl", test_path, "--no-session-daemon", "--sequential", "--timeout", timeout_secs.to_string()],
        timeout_ms,
        TEST_OUTPUT_CAPTURE_BYTES
    )
    var body = stdout
    if stderr != "":
        body = body + stderr
    # The worker was KILLED at the budget: process_run_bounded returns -1 (or
    # the shell's 124/143/255) and the child never reached its own epilogue, so
    # nothing in `body` carries a verdict. Synthesise one here rather than
    # handing the client a bare "Process timed out", which reads as
    # "never run" in any sweep that counts verdict lines.
    # Bug: killed_spec_emits_no_verdict_line_2026-08-09.
    var out_code = code
    val killed = code == -1 or code == 124 or code == 143 or code == 255
    if killed and not has_verdict_line(body):
        body = body + "\nerror: test-daemon: worker killed at {timeout_secs}s budget: {exit_code_reason(code)}\n" + timeout_verdict_line(test_path, "daemon-worker-timeout", timeout_ms) + "\n"
        if out_code == 0:
            out_code = 1
    atomic_write_text(response_path(name), "{out_code}\n{body}")
    file_delete(req_path)

fn main() -> i64:
    ensure_dirs()
    rt_file_write_text(LIGHT_LOCK, "{getpid()}")
    val binary = simple_binary()
    # Publish the served binary BEFORE accepting any request, so a client that
    # observes the lock also observes an accurate binary record.
    atomic_write_text(LIGHT_BINARY, binary)
    var idle = 0
    while idle < 240:
        if file_exists(LIGHT_STOP):
            file_delete(LIGHT_STOP)
            file_delete(LIGHT_LOCK)
            file_delete(LIGHT_BINARY)
            return 0
        val entries = rt_dir_list(LIGHT_REQ_DIR)
        if entries.len() == 0:
            idle = idle + 1
            thread_sleep(250)
            continue
        idle = 0
        var i = 0
        while i < entries.len():
            handle_request(binary, entries[i])
            i = i + 1
    file_delete(LIGHT_LOCK)
    file_delete(LIGHT_BINARY)
    0
