# Launch the repository's actual generic test daemon in the current checkout.
use app.test_daemon.daemon.{test_daemon_start}
use app.test_daemon.types.{test_daemon_config_default}

fn main() -> i64:
    var daemon = test_daemon_start(test_daemon_config_default())
    if not daemon.is_running():
        print "generic test daemon failed to acquire its lock"
        return 1
    daemon.run()
    0
