# Lightweight test daemon CLI entrypoint.

use std.sffi.cli.{cli_get_args}
use app.io.process_ops.{process_run, process_run_timeout}
use app.test_daemon.light_protocol.{timeout_verdict_line}

use std.io_runtime.{dir_create_all}
use std.io_runtime.{file_exists}
use std.io_runtime.{read_file_text}
use std.io_runtime.{file_write}
use std.io_runtime.{file_delete}
use std.io_runtime.{file_rename}
use std.io_runtime.{getpid}
use std.io_runtime.{thread_sleep}
use std.io_runtime.{time_now_unix_micros}
extern fn rt_path_absolute(path: text) -> text
use std.io_runtime.{env_get}

# Atomic write: tmp + rename. Plain rt_file_write_text does open(create,
# truncate) then write() as two separate steps, so a concurrent reader that
# lists the directory and opens the file between those steps can observe a
# 0-byte (or partially written) file. The daemon's poll loop lists+reads
# request files this way, so a non-atomic write here races with it and the
# daemon can misread an in-flight request as empty ("missing test path"),
# consuming and discarding the real request (#98).
fn atomic_write_text(path: text, content: text) -> bool:
    val tmp_path = "{path}.tmp"
    if file_write(tmp_path, content):
        if file_rename(tmp_path, path):
            return true
        file_delete(tmp_path)
    file_write(path, content)

val LIGHT_DAEMON_DIR: text = ".build/test_daemon_light"
val LIGHT_REQ_DIR: text = ".build/test_daemon_light/requests"
val LIGHT_RESP_DIR: text = ".build/test_daemon_light/responses"
val LIGHT_LOCK: text = ".build/test_daemon_light/daemon.lock"
val LIGHT_STOP: text = ".build/test_daemon_light/stop"

fn test_daemon_args() -> [text]:
    val raw = cli_get_args()
    var args: [text] = []
    var found_command = false
    var i = 0
    while i < raw.len():
        if found_command:
            args.push(raw[i])
        elif raw[i] == "test-daemon":
            found_command = true
        i = i + 1
    if found_command:
        return args

    var start_idx = 1
    i = 0
    while i < raw.len():
        if raw[i].ends_with("/app/test_daemon/main.spl") or raw[i] == "src/app/test_daemon/main.spl":
            start_idx = i + 1
        i = i + 1

    i = start_idx
    while i < raw.len():
        args.push(raw[i])
        i = i + 1
    args

fn print_usage():
    print "Usage:"
    print "  simple test-daemon start       Start lightweight test daemon"
    print "  simple test-daemon stop        Stop lightweight test daemon"
    print "  simple test-daemon status      Show lightweight daemon status"
    print "  simple test-daemon run <path>  Run test via daemon"
    print "  simple test-daemon clean <path> Force-run via daemon"

fn invoking_binary() -> text:
    """Absolute path of the compiler binary running THIS process ("" if unknown).

    Canonicalizes /proc/self/exe IN-PROCESS; never shells out (a spawned
    helper's /proc/self describes the HELPER). See doc/08_tracking/bug/
    simple_test_child_binary_ignores_invoking_binary_recurrence_2026-08-08.md."""
    val self_path = rt_path_absolute("/proc/self/exe") ?? ""
    if self_path.len() > 0 and self_path != "/proc/self/exe" and file_exists(self_path):
        return self_path
    ""

fn simple_binary() -> text:
    val configured = (env_get("SIMPLE_BINARY") ?? "")
    if configured != "" and file_exists(configured):
        return configured
    # The invoking binary outranks every guessed candidate below; guessing here
    # is what silently substituted the stale deployed binary for a freshly
    # rebuilt one and voided the verification run that used it.
    val invoker = invoking_binary()
    if invoker != "":
        return invoker
    val raw = cli_get_args()
    # Source-mode argv can begin with this file's own .spl path (when the seed
    # interprets test_daemon/main.spl directly). It exists, but it is not
    # executable; passing it to process_run(_timeout) produces a misleading
    # permission-denied failure instead of running the test. Same fix as
    # test_runner_single.spl's simple_binary().
    if raw.len() > 0 and (raw[0].ends_with("/simple") or raw[0].ends_with("simple.exe")) and file_exists(raw[0]):
        return raw[0]
    # bin/simple (the deployed pure-Simple self-hosted binary) MUST be tried
    # before any Rust-seed candidate — a stray dev-loop
    # src/compiler_rust/target/debug/simple must never outrank it. Same class
    # of defect as light_daemon.spl / test_runner_client.spl; see
    # doc/08_tracking/bug/test_client_debug_seed_binary_shadowing_timeout_2026-08-06.md.
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("src/compiler_rust/target/debug/simple"):
        return "src/compiler_rust/target/debug/simple"
    "./bin/simple"

fn ensure_dirs():
    dir_create_all(LIGHT_DAEMON_DIR)
    dir_create_all(LIGHT_REQ_DIR)
    dir_create_all(LIGHT_RESP_DIR)

fn daemon_pid() -> text:
    if not file_exists(LIGHT_LOCK):
        return ""
    val content = read_file_text(LIGHT_LOCK)
    if content == "":
        return ""
    content.split("\n")[0].trim()

fn daemon_lock_alive() -> bool:
    """True only when the lock is held by a LIVE light-daemon process.

    Mirrors test_runner_client.daemon_lock_alive: a reused PID passes kill -0,
    so a crashed daemon's lock made every request wait out the full budget and
    report a timeout with no verdict. A D-state daemon matches its own cmdline
    and is left strictly alone; no process is ever signalled, only the lock
    file is removed. Bug: stale_daemon_lock_fakes_total_red_2026-08-09."""
    val pid = daemon_pid()
    if pid == "":
        return false
    val (_stdout, _stderr, code) = process_run_timeout(
        "/bin/sh",
        ["-c", "kill -0 {pid} 2>/dev/null || exit 1; test -r /proc/{pid}/cmdline || exit 0; tr '\\0' ' ' < /proc/{pid}/cmdline | grep -q light_daemon"],
        2000
    )
    code == 0

fn ensure_daemon() -> bool:
    ensure_dirs()
    if daemon_lock_alive():
        return true
    val stale_pid = daemon_pid()
    if stale_pid != "":
        print "warning: test-daemon: stale lock {LIGHT_LOCK} (recorded pid {stale_pid} is not a live light_daemon); removing it and respawning."
        print "warning: test-daemon: if this repeats, clear the lane by hand: rm -rf {LIGHT_DAEMON_DIR}"
    file_delete(LIGHT_LOCK)
    file_delete(LIGHT_STOP)
    val binary = simple_binary()
    val (_daemon_out, _daemon_err, daemon_code) = process_run(
        "/bin/sh",
        ["-c", "SIMPLE_EXECUTION_MODE=interpret {binary} run src/app/test_daemon/light_daemon.spl >/tmp/simple-test-daemon-light.log 2>&1 &"]
    )
    if daemon_code != 0:
        file_write("/tmp/simple-test-daemon-light.log", "failed to spawn light daemon: {daemon_code}\n")
        return false
    var waits = 0
    while waits < 40:
        if daemon_lock_alive():
            return true
        thread_sleep(50)
        waits = waits + 1
    file_write("/tmp/simple-test-daemon-light.log", "light daemon shell exited but did not create lock\n")
    false

fn cli_test_daemon_start() -> i64:
    if not ensure_daemon():
        print "Failed to start test daemon"
        return 1
    print "Test daemon running (pid: {daemon_pid()})"
    0

fn cli_test_daemon_stop() -> i64:
    ensure_dirs()
    if not daemon_lock_alive():
        file_delete(LIGHT_LOCK)
        print "Test daemon: not running"
        return 0
    file_write(LIGHT_STOP, "stop")
    var waits = 0
    while waits < 40:
        if not daemon_lock_alive():
            file_delete(LIGHT_LOCK)
            print "Test daemon stopped"
            return 0
        thread_sleep(50)
        waits = waits + 1
    print "Failed to stop test daemon"
    1

fn cli_test_daemon_status() -> i64:
    if daemon_lock_alive():
        print "Test daemon: running (pid: {daemon_pid()})"
        return 0
    file_delete(LIGHT_LOCK)
    print "Test daemon: not running"
    0

fn print_response(content: text) -> i64:
    val newline = content.find("\n")
    if newline < 0:
        print content
        return 1
    val code = content[0:newline].trim().to_i64() ?? 1
    val body = content[newline + 1:]
    if body != "":
        print body
    code

fn cli_test_daemon_run(args: [text], clean: bool) -> i64:
    if args.len() == 0:
        print "Usage: simple test-daemon run <path>"
        return 1
    val path = args[0]
    if not path.ends_with(".spl") or not file_exists(path):
        print "error: test file not found: {path}"
        return 1
    if not ensure_daemon():
        print "Failed to start test daemon"
        return 1

    val id = "{time_now_unix_micros()}-{getpid()}.req"
    val req_path = "{LIGHT_REQ_DIR}/{id}"
    val resp_path = "{LIGHT_RESP_DIR}/{id}.resp"
    file_delete(resp_path)
    atomic_write_text(req_path, path)
    val deadline = time_now_unix_micros() + 600000000
    while time_now_unix_micros() < deadline:
        if file_exists(resp_path):
            val content = read_file_text(resp_path)
            file_delete(resp_path)
            return print_response(content)
        thread_sleep(100)
    print "ERROR: test daemon timed out: {path}"
    print "ERROR: no response from the light daemon within 600000ms."
    print "ERROR: if EVERY spec reports this, the lock at {LIGHT_LOCK} is stale/wedged; fix: rm -rf {LIGHT_DAEMON_DIR}"
    print timeout_verdict_line(path, "daemon-no-response", 600000)
    1

fn main() -> i64:
    val args = test_daemon_args()
    if args.len() == 0:
        print_usage()
        return 1

    val subcmd = args[0]
    if subcmd == "start":
        return cli_test_daemon_start()
    elif subcmd == "stop":
        return cli_test_daemon_stop()
    elif subcmd == "status":
        return cli_test_daemon_status()
    elif subcmd == "run":
        return cli_test_daemon_run(args[1:], false)
    elif subcmd == "clean":
        return cli_test_daemon_run(args[1:], true)

    print "Unknown test-daemon subcommand: {subcmd}"
    1
