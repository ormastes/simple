# Shared immutable-source admission for compiler-facing entrypoints.

use app.io.file_ops.{path_absolute}
use app.io.env_ops.{env_get, env_set}
use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.cache.package_module_index.{
    PACKAGE_MODULE_INDEX_SCHEMA_V1, PackageModuleIndexGenerationV1, PackageModuleIndexReadV1,
    package_module_index_publish_if_current_v1,
    package_module_index_read_current_v1}
use std.common.crypto.sha256.{sha256_text}
use std.scv.compile_snapshot.{ScvCompileSnapshotV1}
use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1,
    compiler_source_authority_publish_v1, compiler_source_authority_clear_v1}
use std.scv.compile_source_inventory.{compile_source_inventory_checkout_cache_root_v1,
    compile_source_inventory_plain_checkout_v1}
use app.compiler_entrypoint.index_compatibility.{
    compiler_entrypoint_publish_index_compatibility_v1}

struct CompilerEntrypointAdmissionV1:
    valid: bool
    reason: text
    root: text
    snapshot_root: text
    revision_id: text
    index_digest: text
    inventory_generation: i64

fn compiler_entrypoint_invalid_v1(reason: text) -> CompilerEntrypointAdmissionV1:
    CompilerEntrypointAdmissionV1(false, reason, "", "", "", "", -1)

# Binding-only generation: it records exactly which SCV snapshot the index
# belongs to and carries no module entries. It also clears warm compatibility
# markers while an explicit cold graph rebuild is pending.
fn compiler_entrypoint_binding_generation_v1(
    snapshot: ScvCompileSnapshotV1
) -> PackageModuleIndexGenerationV1:
    PackageModuleIndexGenerationV1(
        schema_version: PACKAGE_MODULE_INDEX_SCHEMA_V1,
        producer_digest: sha256_text("simple/package-module-index/admission-snapshot-binding/v1"),
        root_generation: "scv-snapshot-binding-v1",
        scv_revision_id: snapshot.revision_id,
        scv_commit_id: snapshot.commit_id,
        scv_tree_id: snapshot.tree_id,
        inventory_digest: snapshot.inventory_digest,
        entries: [])

fn compiler_entrypoint_index_binds_snapshot_v1(
    index: PackageModuleIndexReadV1, snapshot: ScvCompileSnapshotV1
) -> bool:
    if not index.valid or index.generation == nil:
        return false
    val generation = index.generation!
    generation.scv_revision_id == snapshot.revision_id and
        generation.scv_commit_id == snapshot.commit_id and
        generation.scv_tree_id == snapshot.tree_id and
        generation.inventory_digest == snapshot.inventory_digest

# A stale graph is immutable evidence from the prior snapshot. An explicit
# cold rebuild may compile against the new snapshot without moving CURRENT;
# only a complete graph publisher may replace that pointer afterward.
fn compiler_entrypoint_index_transition_v1(
    index: PackageModuleIndexReadV1,
    snapshot: ScvCompileSnapshotV1,
    explicit_cold_rebuild: bool
) -> text:
    if compiler_entrypoint_index_binds_snapshot_v1(index, snapshot):
        return "bound"
    if index.valid and index.generation != nil:
        if index.generation!.entries.len() > 0:
            if explicit_cold_rebuild:
                return "cold-rebuild-pending"
            return "stale-graph-rebuild-required"
    "publish-binding"

fn compiler_entrypoint_admit_v1(source_roots: [text]) -> CompilerEntrypointAdmissionV1:
    if not compiler_source_authority_clear_v1():
        return compiler_entrypoint_invalid_v1("source-authority-env-clear-failed")
    # A failed later admission must not inherit a prior request's permission
    # to resolve frozen paths without a matching published graph.
    if not env_set("SIMPLE_PACKAGE_INDEX_REBUILD_PENDING", "0"):
        return compiler_entrypoint_invalid_v1(
            "package-index-rebuild-env-clear-failed")
    val root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
    if root == "":
        return compiler_entrypoint_invalid_v1("repository-root-unavailable")
    val cache_root = compile_source_inventory_checkout_cache_root_v1(root)
    val cold_init = (env_get("SIMPLE_SCV_INVENTORY_COLD_INIT") ?? "") == "1"
    val authority = compiler_source_authority_acquire_v1(
        root, cache_root, source_roots, cold_init)
    if not authority.valid:
        return compiler_entrypoint_invalid_v1(authority.reason)
    val snapshot = authority.snapshot
    var index = package_module_index_read_current_v1(machine_cache_root())
    val transition = compiler_entrypoint_index_transition_v1(
        index, snapshot,
        (env_get("SIMPLE_PACKAGE_INDEX_COLD_INIT") ?? "") == "1")
    if transition == "stale-graph-rebuild-required":
        return compiler_entrypoint_invalid_v1(
            "package-index:stale-graph-rebuild-required")
    val cold_rebuild_pending = transition == "cold-rebuild-pending"
    if transition == "publish-binding":
        # Nothing else in the tree produces this index (no caller of
        # package_module_index_publish_v1 since it was introduced), so every
        # fresh HOME failed package-index:missing-or-invalid-generation on
        # every platform. Publish the snapshot-binding generation here:
        # content-addressed and idempotent (same snapshot -> same digest),
        # and fail closed if it cannot be published or read back.
        val expected_index_digest = if index.valid: index.digest else: ""
        val published = package_module_index_publish_if_current_v1(
            machine_cache_root(),
            compiler_entrypoint_binding_generation_v1(snapshot),
            expected_index_digest)
        index = package_module_index_read_current_v1(machine_cache_root())
        if not published and not compiler_entrypoint_index_binds_snapshot_v1(
                index, snapshot):
            return compiler_entrypoint_invalid_v1(
                "package-index:publish-conflict-or-failed")
    if not index.valid or index.generation == nil:
        return compiler_entrypoint_invalid_v1("package-index:" + index.reason)
    val generation = index.generation!
    if not cold_rebuild_pending and
            (generation.scv_revision_id != snapshot.revision_id or
            generation.scv_commit_id != snapshot.commit_id or
            generation.scv_tree_id != snapshot.tree_id or
            generation.inventory_digest != snapshot.inventory_digest):
        return compiler_entrypoint_invalid_v1("package-index-scv-binding-mismatch")
    val active_index_digest = if cold_rebuild_pending: "" else: index.digest
    if not env_set("SIMPLE_PACKAGE_INDEX_DIGEST", active_index_digest):
        return compiler_entrypoint_invalid_v1("package-index-env-publish-failed")
    val compatibility_generation = if cold_rebuild_pending:
        compiler_entrypoint_binding_generation_v1(snapshot)
    else:
        generation
    if not compiler_entrypoint_publish_index_compatibility_v1(
            compatibility_generation):
        return compiler_entrypoint_invalid_v1(
            "package-index-compatibility-env-publish-failed")
    if not env_set("SIMPLE_PACKAGE_INDEX_REBUILD_PENDING",
            if cold_rebuild_pending: "1" else: "0"):
        return compiler_entrypoint_invalid_v1("package-index-rebuild-env-publish-failed")
    if not compiler_source_authority_publish_v1(authority):
        return compiler_entrypoint_invalid_v1("source-authority-env-publish-failed")
    CompilerEntrypointAdmissionV1(
        true, if cold_rebuild_pending: "cold-rebuild-pending" else: "ok",
        root, snapshot.snapshot_root, snapshot.revision_id,
        active_index_digest, authority.inventory_generation)

fn compiler_entrypoint_frozen_path_v1(
    admission: CompilerEntrypointAdmissionV1, path: text
) -> text:
    if not admission.valid or path == "":
        return ""
    val absolute = path_absolute(path).replace("\\", "/")
    if absolute == admission.root:
        return admission.snapshot_root
    if not absolute.starts_with(admission.root + "/"):
        return ""
    admission.snapshot_root + absolute.substring(admission.root.len(), absolute.len())

fn compiler_entrypoint_frozen_env_path_v1(path: text) -> text:
    val root = path_absolute(".").replace("\\", "/")
    val snapshot_root = env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? ""
    val revision_id = env_get("SIMPLE_SCV_REVISION_ID") ?? ""
    val index_digest = env_get("SIMPLE_PACKAGE_INDEX_DIGEST") ?? ""
    val rebuild_pending =
        (env_get("SIMPLE_PACKAGE_INDEX_REBUILD_PENDING") ?? "") == "1"
    if root == "" or snapshot_root == "" or revision_id == "" or
            (index_digest == "" and not rebuild_pending):
        return ""
    val absolute = path_absolute(path).replace("\\", "/")
    if absolute == snapshot_root or absolute.starts_with(snapshot_root + "/"):
        return absolute
    compiler_entrypoint_frozen_path_v1(CompilerEntrypointAdmissionV1(
        true, "ok", root, snapshot_root, revision_id, index_digest, -1), path)

export CompilerEntrypointAdmissionV1
export compiler_entrypoint_admit_v1, compiler_entrypoint_frozen_path_v1
export compiler_entrypoint_frozen_env_path_v1
export compiler_entrypoint_index_transition_v1
