# Shared immutable-source admission for compiler-facing entrypoints.

use app.io.file_ops.{path_absolute}
use app.io.env_ops.{env_get, env_set}
use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.cache.package_module_index.{
    PACKAGE_MODULE_INDEX_SCHEMA_V1, PackageModuleIndexGenerationV1, PackageModuleIndexReadV1,
    package_module_index_publish_v1, package_module_index_read_current_v1}
use std.common.crypto.sha256.{sha256_text}
use std.scv.compile_snapshot.{ScvCompileSnapshotV1, scv_compile_snapshot_acquire_v1}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_v1}

struct CompilerEntrypointAdmissionV1:
    valid: bool
    reason: text
    root: text
    snapshot_root: text
    revision_id: text
    index_digest: text
    inventory_generation: i64

fn compiler_entrypoint_invalid_v1(reason: text) -> CompilerEntrypointAdmissionV1:
    CompilerEntrypointAdmissionV1(false, reason, "", "", "", "", -1)

# Binding-only generation: it records exactly which SCV snapshot the index
# belongs to and carries no module entries. Admission consumes only this
# binding; the warm per-module route (package_index_route.spl) stays on its
# cold path until a real module-graph producer exists, because it is gated on
# producer/root/variant markers nothing sets.
fn compiler_entrypoint_binding_generation_v1(
    snapshot: ScvCompileSnapshotV1
) -> PackageModuleIndexGenerationV1:
    PackageModuleIndexGenerationV1(
        schema_version: PACKAGE_MODULE_INDEX_SCHEMA_V1,
        producer_digest: sha256_text("simple/package-module-index/admission-snapshot-binding/v1"),
        root_generation: "scv-snapshot-binding-v1",
        scv_revision_id: snapshot.revision_id,
        scv_commit_id: snapshot.commit_id,
        scv_tree_id: snapshot.tree_id,
        inventory_digest: snapshot.inventory_digest,
        entries: [])

fn compiler_entrypoint_index_binds_snapshot_v1(
    index: PackageModuleIndexReadV1, snapshot: ScvCompileSnapshotV1
) -> bool:
    if not index.valid or index.generation == nil:
        return false
    val generation = index.generation!
    generation.scv_revision_id == snapshot.revision_id and
        generation.scv_commit_id == snapshot.commit_id and
        generation.scv_tree_id == snapshot.tree_id and
        generation.inventory_digest == snapshot.inventory_digest

fn compiler_entrypoint_admit_v1(source_roots: [text]) -> CompilerEntrypointAdmissionV1:
    var root = path_absolute(".").replace("\\", "/")
    # Windows returns the verbatim `\\?\C:\...` form for an existing path;
    # `git -C` rejects it ("cannot change to '\?\C:\...'") and every refresh
    # failed with git-event-source-unavailable. Same strip as compile_snapshot.
    if root.starts_with("//?/"):
        root = root.substring(4)
    if root == "":
        return compiler_entrypoint_invalid_v1("repository-root-unavailable")
    val cache_root = root + "/build/scv"
    val cold_init = (env_get("SIMPLE_SCV_INVENTORY_COLD_INIT") ?? "") == "1"
    val refresh = compiler_inventory_refresh_v1(
        root, cache_root, source_roots, cold_init)
    if not refresh.valid:
        return compiler_entrypoint_invalid_v1(refresh.reason)
    val snapshot = scv_compile_snapshot_acquire_v1(
        root, cache_root, source_roots)
    if not snapshot.valid:
        return compiler_entrypoint_invalid_v1(snapshot.reason)
    var index = package_module_index_read_current_v1(machine_cache_root())
    if not compiler_entrypoint_index_binds_snapshot_v1(index, snapshot):
        # Nothing else in the tree produces this index (no caller of
        # package_module_index_publish_v1 since it was introduced), so every
        # fresh HOME failed package-index:missing-or-invalid-generation on
        # every platform. Publish the snapshot-binding generation here:
        # content-addressed and idempotent (same snapshot -> same digest),
        # and fail closed if it cannot be published or read back.
        if not package_module_index_publish_v1(machine_cache_root(),
                compiler_entrypoint_binding_generation_v1(snapshot)):
            return compiler_entrypoint_invalid_v1("package-index:publish-failed")
        index = package_module_index_read_current_v1(machine_cache_root())
    if not index.valid or index.generation == nil:
        return compiler_entrypoint_invalid_v1("package-index:" + index.reason)
    val generation = index.generation!
    if (generation.scv_revision_id != snapshot.revision_id or
            generation.scv_commit_id != snapshot.commit_id or
            generation.scv_tree_id != snapshot.tree_id or
            generation.inventory_digest != snapshot.inventory_digest):
        return compiler_entrypoint_invalid_v1("package-index-scv-binding-mismatch")
    env_set("SIMPLE_SCV_SNAPSHOT_ROOT", snapshot.snapshot_root)
    env_set("SIMPLE_SCV_REVISION_ID", snapshot.revision_id)
    env_set("SIMPLE_SCV_COMMIT_ID", snapshot.commit_id)
    env_set("SIMPLE_SCV_TREE_ID", snapshot.tree_id)
    env_set("SIMPLE_SCV_INVENTORY_DIGEST", snapshot.inventory_digest)
    env_set("SIMPLE_SCV_INVENTORY_GENERATION", str(refresh.inventory_generation))
    env_set("SIMPLE_PACKAGE_INDEX_DIGEST", index.digest)
    CompilerEntrypointAdmissionV1(
        true, "ok", root, snapshot.snapshot_root, snapshot.revision_id,
        index.digest, refresh.inventory_generation)

fn compiler_entrypoint_frozen_path_v1(
    admission: CompilerEntrypointAdmissionV1, path: text
) -> text:
    if not admission.valid or path == "":
        return ""
    val absolute = path_absolute(path).replace("\\", "/")
    if absolute == admission.root:
        return admission.snapshot_root
    if not absolute.starts_with(admission.root + "/"):
        return ""
    admission.snapshot_root + absolute.substring(admission.root.len(), absolute.len())

fn compiler_entrypoint_frozen_env_path_v1(path: text) -> text:
    val root = path_absolute(".").replace("\\", "/")
    val snapshot_root = env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? ""
    val revision_id = env_get("SIMPLE_SCV_REVISION_ID") ?? ""
    val index_digest = env_get("SIMPLE_PACKAGE_INDEX_DIGEST") ?? ""
    if root == "" or snapshot_root == "" or revision_id == "" or index_digest == "":
        return ""
    val absolute = path_absolute(path).replace("\\", "/")
    if absolute == snapshot_root or absolute.starts_with(snapshot_root + "/"):
        return absolute
    compiler_entrypoint_frozen_path_v1(CompilerEntrypointAdmissionV1(
        true, "ok", root, snapshot_root, revision_id, index_digest, -1), path)

export CompilerEntrypointAdmissionV1
export compiler_entrypoint_admit_v1, compiler_entrypoint_frozen_path_v1
export compiler_entrypoint_frozen_env_path_v1
