# BUG-SCV-BOOTSTRAP-COMPOSITION-SCOPE-20261011
# Generated bootstrap CUDA roots are selectors for canonical source records,
# never a new inventory family. No arbitrary build-tree source is admitted.
use app.io.mod.{file_read_regular_no_follow_bounded}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.path.{normalize}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.nogc_sync_mut.io_runtime.{dir_list_optional}

val CUDA_COMPOSITION_LEAF_V1 = "/plugins/backend_registry/selected_cuda_backend.spl"
val CUDA_COMPOSITION_MANIFEST_V1 = "src/compiler/simple.sdn"

pub fn compiler_source_selector_relative_v1(root: text, selector: text) -> text:
    val raw = selector.replace("\\", "/")
    if raw == "" or raw.contains("\0") or raw.contains("\n") or raw.contains("|"):
        return ""
    if raw.split("/").contains(".."): return ""
    val owner = normalize(root.replace("\\", "/"))
    var relative = normalize(raw)
    if relative.starts_with(owner + "/"):
        relative = relative.substring(owner.len() + 1)
    if relative.starts_with("/") or relative.contains(":"): return ""
    relative

pub fn compiler_cuda_composition_mode_v1(manifest: text) -> text:
    var section = false
    var cuda = false
    var sections = 0
    var cuda_sections = 0
    var enabled_count = 0
    var placement_count = 0
    var enabled = ""
    var placement = ""
    for line in manifest.split("\n"):
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"): continue
        if not line.starts_with(" "):
            section = trimmed == "compiler_backends:"
            cuda = false
            if section: sections = sections + 1
        elif section and line.starts_with("  ") and not line.starts_with("   "):
            cuda = trimmed == "cuda:"
            if cuda: cuda_sections = cuda_sections + 1
        elif cuda:
            var fields: [text] = []
            for field in trimmed.replace("\t", " ").split(" "):
                if field != "": fields = fields.push(field)
            if fields[0] == "enabled:":
                enabled_count = enabled_count + 1
                enabled = if fields.len() > 1: fields[1] else: ""
            elif fields[0] == "placement:":
                placement_count = placement_count + 1
                placement = if fields.len() > 1: fields[1] else: ""
    if sections != 1 or cuda_sections != 1 or enabled_count != 1 or placement_count != 1:
        return ""
    if placement != "static" and placement != "dynamic": return ""
    if enabled == "false": return "disabled"
    if enabled == "true": return placement
    ""

pub fn compiler_cuda_composition_identity_v1(selector: text, manifest: text, template: text) -> bool:
    if not selector.starts_with("build/"): return false
    val suffix = "/compositions/cuda-" + sha256_text(manifest) + "-" + sha256_text(template)
    selector.ends_with(suffix)

fn compiler_composition_owned_directories_v1(root: text, relative: text) -> bool:
    var current = root
    for component in relative.split("/"):
        current = current + "/" + component
        if not dir_is_real_no_follow(current): return false
    true

fn compiler_composition_single_child_v1(path: text, child: text) -> bool:
    val entries = dir_list_optional(path)
    if entries == nil: return false
    entries!.len() == 1 and entries![0] == child

# During admission check the generated bytes too. In an inherited snapshot,
# validate only frozen records: subsequent live edits cannot change authority.
pub fn compiler_cuda_composition_root_v1(
    checkout: text, records_root: text, source_root: text, check_generated: bool
) -> Result<text, text>:
    val relative = compiler_source_selector_relative_v1(checkout, source_root)
    if not relative.starts_with("build/"):
        return Err("derived-composition-selector-invalid")
    val loaded_manifest = file_read_regular_no_follow_bounded(
        records_root + "/" + CUDA_COMPOSITION_MANIFEST_V1, 1024 * 1024)
    if loaded_manifest.is_err(): return Err("derived-composition-manifest-unreadable")
    val manifest = loaded_manifest.unwrap()
    val mode = compiler_cuda_composition_mode_v1(manifest)
    if mode == "": return Err("derived-composition-policy-invalid")
    val canonical = "src/compositions/cuda_" + mode
    val template_root = if mode == "static": "src" else: canonical
    val loaded_template = file_read_regular_no_follow_bounded(
        records_root + "/" + template_root + CUDA_COMPOSITION_LEAF_V1, 1024 * 1024)
    if loaded_template.is_err(): return Err("derived-composition-template-unreadable")
    val template = loaded_template.unwrap()
    if not compiler_cuda_composition_identity_v1(relative, manifest, template):
        return Err("derived-composition-identity-mismatch")
    val loaded_canonical = file_read_regular_no_follow_bounded(
        records_root + "/" + canonical + CUDA_COMPOSITION_LEAF_V1, 1024 * 1024)
    if loaded_canonical.is_err(): return Err("derived-composition-canonical-unreadable")
    if loaded_canonical.unwrap() != template:
        return Err("derived-composition-canonical-mismatch")
    if check_generated:
        if not compiler_composition_owned_directories_v1(checkout,
                relative + "/plugins/backend_registry"):
            return Err("derived-composition-directory-unowned")
        val generated = checkout + "/" + relative
        if (not compiler_composition_single_child_v1(generated, "plugins") or
                not compiler_composition_single_child_v1(generated + "/plugins", "backend_registry") or
                not compiler_composition_single_child_v1(generated + "/plugins/backend_registry", "selected_cuda_backend.spl")):
            return Err("derived-composition-membership-mismatch")
        val loaded = file_read_regular_no_follow_bounded(
            generated + CUDA_COMPOSITION_LEAF_V1, 1024 * 1024)
        if loaded.is_err(): return Err("derived-composition-source-unreadable")
        if loaded.unwrap() != template: return Err("derived-composition-content-mismatch")
    Ok(canonical)

pub fn compiler_source_authority_selectors_v1(root: text, selectors: [text]) -> Result<[text], text>:
    var selected: [text] = []
    for selector in selectors:
        val relative = compiler_source_selector_relative_v1(root, selector)
        if relative == "": return Err("source-inventory-scope-unsupported")
        if relative.starts_with("build/"):
            val derived = compiler_cuda_composition_root_v1(root, root, relative, true)
            if derived.is_err(): return Err(derived.unwrap_err())
            selected = selected.push(derived.unwrap() + CUDA_COMPOSITION_LEAF_V1)
            selected = selected.push(CUDA_COMPOSITION_MANIFEST_V1)
            # Static's historical producer template remains an independently
            # admitted canonical row; workers verify equality in the snapshot.
            if derived.unwrap() == "src/compositions/cuda_static":
                selected = selected.push("src/plugins/backend_registry/selected_cuda_backend.spl")
        else:
            selected = selected.push(relative)
    Ok(selected)
