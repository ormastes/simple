# One file's canonicalization and hashing scratch belongs to that file. Keep
# only its event alive; promoting the accumulated event array each time would
# walk every earlier event again and turn cold admission quadratic.
# rt_fs_read_text is C-only by design (rt_dual_implementation_baseline.txt),
# which made cold SCV inventory init impossible on every Rust-lane binary
# since 966bc0159ed. Read through the Rust-backed checked text reader instead.
use std.nogc_sync_mut.sffi.fs.{file_read_text_at_checked}
use std.scv.compile_source_inventory_core.{CompileSourceEventV1, compile_source_inventory_git_event_cost_v1}
use std.scv.compile_cost_v1.{ScvCompileCostV1, scv_cost_now_v1, scv_cost_elapsed_v1}
use compiler.mir._MirLowering.transient_owner_sffi.{transient_array_scope_begin_v1, transient_array_scope_pause_v1, transient_array_scope_end_v1, transient_heap_promote_v1}

fn compiler_inventory_file_event_v1(
    operation: text, identity: text, absolute: text
) -> CompileSourceEventV1?:
    compiler_inventory_file_event_cost_v1(operation, identity, absolute, nil)

fn compiler_inventory_file_event_cost_v1(
    operation: text, identity: text, absolute: text, cost: ScvCompileCostV1?
) -> CompileSourceEventV1?:
    if not transient_array_scope_begin_v1():
        return nil
    val read_started = scv_cost_now_v1(cost)
    val content: text? = file_read_text_at_checked(absolute, 0, 1073741824)
    if cost != nil:
        cost!.record_read(scv_cost_elapsed_v1(cost, read_started),
            if content == nil: 0 else: content!.len())
    if content == nil:
        transient_array_scope_end_v1()
        return nil
    # `content!` on a native `text?` decodes the payload through
    # rt_interp_cstr, so a source holding a NUL byte
    # (src/lib/scv/identity_corrections.spl) was digested only up to its
    # first NUL and admission refused it as snapshot-index-drift. `??`
    # keeps the length-carrying string; nil was already refused above.
    # @workaround bug=optional_text_unwrap_truncates_at_nul_2026-10-25 reason=nul-handling
    val content_text: text = content ?? ""
    val event_started = scv_cost_now_v1(cost)
    val event = compile_source_inventory_git_event_cost_v1(
        operation, identity, content_text, cost)
    if cost != nil: cost!.record_event(scv_cost_elapsed_v1(cost, event_started))
    if not transient_array_scope_pause_v1():
        transient_array_scope_end_v1()
        return nil
    val retained = transient_heap_promote_v1<CompileSourceEventV1>(event)
    val ended = transient_array_scope_end_v1()
    if not retained or not ended:
        return nil
    Some(event)

export compiler_inventory_file_event_v1
export compiler_inventory_file_event_cost_v1
