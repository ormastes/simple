# One file's canonicalization and hashing scratch belongs to that file. Keep
# only its event alive; promoting the accumulated event array each time would
# walk every earlier event again and turn cold admission quadratic.
# rt_fs_read_text is C-only by design (rt_dual_implementation_baseline.txt),
# which made cold SCV inventory init impossible on every Rust-lane binary
# since 966bc0159ed. Read through the Rust-backed checked text reader instead.
use std.nogc_sync_mut.sffi.fs.{file_read_text_at_checked}
use std.scv.compile_source_inventory_core.{CompileSourceEventV1, compile_source_inventory_git_event_v1}
use compiler.mir._MirLowering.transient_owner_sffi.{transient_array_scope_begin_v1, transient_array_scope_pause_v1, transient_array_scope_end_v1, transient_heap_promote_v1}

fn compiler_inventory_file_event_v1(
    operation: text, identity: text, absolute: text
) -> CompileSourceEventV1?:
    if not transient_array_scope_begin_v1():
        return nil
    val event = compile_source_inventory_git_event_v1(
        operation, identity, file_read_text_at_checked(absolute, 0, 1073741824) ?? "")
    if not transient_array_scope_pause_v1():
        transient_array_scope_end_v1()
        return nil
    val retained = transient_heap_promote_v1(event)
    val ended = transient_array_scope_end_v1()
    if not retained or not ended:
        return nil
    Some(event)

export compiler_inventory_file_event_v1
