# Git lists directory aliases as leaf entries. Expand their checkout-owned
# physical Git namespace into logical compiler identities before admission.
# No recursive filesystem walk and no live-source fallback from a snapshot.
use app.io.mod.{dir_exists, process_run_bounded, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.path_identity.{path_final_existing, path_entry_present,
    path_identity_contains, path_identity_same}
use std.scv.core.{scv_worktree_path_safe}
use std.scv.compile_source_inventory.{CompileSourceEventV1,
    compile_source_inventory_path_valid_v1, compile_source_inventory_git_event_v1,
    compile_source_inventory_plain_checkout_v1}

struct CompilerInventoryAliasesV1:
    paths: [text]
    events: [CompileSourceEventV1]

struct CompilerAliasGitPathV1:
    path: text
    link: bool
    untracked: bool

fn compiler_alias_git_paths_v1(root: text, scopes: [text]) -> [CompilerAliasGitPathV1]?:
    var literal: [text] = []
    for scope in scopes:
        if not scv_worktree_path_safe(scope): return nil
        literal.push(":(literal){scope}")
    val (output, _error, code) = process_run_bounded("git",
        ["-C", root, "--no-optional-locks", "-c", "core.quotePath=false",
            "ls-files", "--stage", "--cached", "--others", "--exclude-standard", "--"] + literal,
        300000, 16 * 1024 * 1024)
    if code != 0: return nil
    var result: [CompilerAliasGitPathV1] = []
    var seen: Dict<text, bool> = {}
    for line in output.split("\n"):
        if line == "": continue
        val separator = line.index_of("\t")
        var path = line
        var link = false
        val untracked = separator < 0
        if not untracked:
            val fields = line[:separator].split(" ")
            if fields.len() != 3 or fields[2] != "0": return nil
            if fields[0] == "160000": continue
            if fields[0] != "100644" and fields[0] != "100755" and fields[0] != "120000": return nil
            link = fields[0] == "120000"
            path = line[separator + 1:]
        if not scv_worktree_path_safe(path) or path.starts_with("\"") or path.contains("\r") or path.contains("\t"): return nil
        if not seen.has(path):
            seen[path] = true
            result.push(CompilerAliasGitPathV1(path, link, untracked))
    Some(result)

# An index may retain files below a removed directory. Prove absence at the
# first missing component; an inaccessible parent remains a hard failure.
fn compiler_alias_present_v1(base: text, relative: text) -> bool?:
    val leaf = path_entry_present(base + "/" + relative)
    if leaf.is_ok(): return Some(leaf.unwrap())
    var current = base
    for component in relative.split("/"):
        current = current + "/" + component
        val observed = path_entry_present(current)
        if observed.is_err(): return nil
        if not observed.unwrap(): return Some(false)
    nil

fn compiler_inventory_aliases_v1(root: text, scopes: [text]) -> CompilerInventoryAliasesV1?:
    val checkout_result = path_final_existing(root)
    if checkout_result.is_err(): return nil
    val checkout = checkout_result.unwrap()
    val base = compile_source_inventory_plain_checkout_v1(checkout.path)
    val listed = compiler_alias_git_paths_v1(base, scopes)
    if listed == nil: return nil
    var paths: [text] = []
    var events: [CompileSourceEventV1] = []
    var seen: Dict<text, bool> = {}
    # WORKAROUND(#3319): the bootstrap seed loses optional-array loop element types.
    # Keep explicit array and element owners until the compact-form regression passes.
    val listed_entries: [CompilerAliasGitPathV1] = listed!
    for entry_value in listed_entries:
        val entry: CompilerAliasGitPathV1 = entry_value
        if not entry.link and not entry.untracked: continue
        val alias = base + "/" + entry.path
        if not entry.link and not dir_exists(alias): continue
        val present = compiler_alias_present_v1(base, entry.path)
        if present == nil: return nil
        if not present!: continue
        # Existing non-directory links are outside this directory adapter.
        # An unresolved tracked link remains fail-closed: it might name a
        # formerly admitted directory, so guessing file-kind loses authority.
        val owner_result = path_final_existing(alias)
        if owner_result.is_err(): return nil
        val owner = owner_result.unwrap()
        if not dir_exists(alias): continue
        if not path_identity_contains(checkout, owner) or path_identity_same(checkout, owner): return nil
        val physical = compile_source_inventory_plain_checkout_v1(owner.path)
        if not physical.starts_with(base + "/"): return nil
        val owner_relative = physical[base.len() + 1:]
        if (owner_relative == "build" or owner_relative.starts_with("build/") or
                owner_relative == ".simple" or owner_relative.starts_with(".simple/") or
                owner_relative == ".git" or owner_relative.starts_with(".git/")):
            return nil
        if not dir_exists(physical):
            # Leaf source aliases retain the existing no-follow admission policy.
            continue
        val children = compiler_alias_git_paths_v1(base, [owner_relative])
        if children == nil: return nil
        val child_entries: [CompilerAliasGitPathV1] = children!
        for child_value in child_entries:
            val child: CompilerAliasGitPathV1 = child_value
            # Nested aliases require their own explicit logical mapping; refusing
            # them prevents an incomplete walk or cycles from becoming authority.
            if child.link: return nil
            if not child.path.starts_with(owner_relative + "/"): return nil
            val suffix = child.path[owner_relative.len() + 1:]
            val identity = entry.path + "/" + suffix
            if not compile_source_inventory_path_valid_v1(identity):
                if child.untracked and dir_exists(base + "/" + child.path): return nil
                continue
            val source = base + "/" + child.path
            val source_present = compiler_alias_present_v1(base, child.path)
            if source_present == nil: return nil
            if not source_present!: continue
            val resolved_result = path_final_existing(source)
            if resolved_result.is_err(): return nil
            val resolved = resolved_result.unwrap()
            if not path_identity_contains(owner, resolved): return nil
            val content = file_read_regular_no_follow_bounded(source, 64 * 1024 * 1024)
            if content.is_err(): return nil
            val after = path_final_existing(alias)
            if after.is_err(): return nil
            if not path_identity_same(owner, after.unwrap()): return nil
            val source_after = path_final_existing(source)
            if source_after.is_err(): return nil
            if not path_identity_same(resolved, source_after.unwrap()): return nil
            if seen.has(identity): return nil
            seen[identity] = true
            paths.push(identity)
            events.push(compile_source_inventory_git_event_v1("modify", identity, content.unwrap()))
    # Resolution/readback assumes a trusted, stable checkout parent, matching
    # path_identity and snapshot admission. This is not dirfd-pinned protection
    # against hostile remove-and-restore races. Snapshot materialization still
    # rehashes every selected source and rejects drift.
    # Stable membership keeps duplicate physical owners under their distinct
    # logical namespaces without order-dependent generations.
    paths.sort()
    Some(CompilerInventoryAliasesV1(paths, events))

export CompilerInventoryAliasesV1, compiler_inventory_aliases_v1
