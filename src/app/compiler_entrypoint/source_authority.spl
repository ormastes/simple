# Snapshot and canonical inventory authority shared by public compiler routes.
# This seam does not import the driver or the package-module index.
use app.io.env_ops.{env_get, env_set}
use app.io.file_ops.{path_absolute}
use app.io.mod.{file_read_regular_no_follow_bounded}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_traced_cost_v1,
    compiler_inventory_admit_extra_roots_v1, compiler_inventory_cursor_present_v1}
use std.nogc_sync_mut.io.file_ops.{file_is_regular_no_follow}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use app.compiler_entrypoint.inventory_trace.{inventory_trace_cost_create_v1, inventory_trace_cost_emit_v1}
use std.scv.compile_cost_v1.{scv_cost_now_v1, scv_cost_elapsed_v1}
use app.compiler_entrypoint.inventory_families.{compiler_inventory_family_v1}
use app.compiler_entrypoint.source_manifest_membership.{compiler_source_manifest_membership_v1}
use app.compiler_entrypoint.derived_composition.{compiler_source_authority_selectors_v1,
    compiler_source_selector_relative_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin,
    transient_scope_pause, transient_scope_end, transient_promote}
use std.scv.compile_snapshot.{ScvCompileSnapshotV1,
    scv_compile_snapshot_acquire_cost_v1, scv_compile_snapshot_open_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryV1}
use std.scv.compile_source_inventory.{CompileSourceInventoryReadV1,
    CompileSourceInventoryBindingV1, compile_source_inventory_binding_reason_v1,
    compile_source_inventory_read_at_pointer_v1,
    compile_source_inventory_plain_checkout_v1, compile_source_inventory_checkout_cache_root_v1,
    compile_source_inventory_snapshot_cache_root_v1}

struct CompilerSourceAuthorityV1:
    valid: bool
    reason: text
    snapshot: ScvCompileSnapshotV1
    source_inventory_digest: text
    inventory_generation: i64

# Return precisely the generation admitted by the inherited snapshot, not
# CURRENT. Receiving selection owners still check their request and every row.
pub fn compiler_source_authority_inventory_v1(root: text, authority: CompilerSourceAuthorityV1) -> Result<CompileSourceInventoryV1, text>:
    if not authority.valid: return Err(authority.reason)
    val cache_root = compile_source_inventory_snapshot_cache_root_v1(
        root, authority.snapshot.snapshot_root, authority.snapshot.revision_id)
    if cache_root == "": return Err("snapshot-source-owner-mismatch")
    val admitted = compile_source_inventory_read_at_pointer_v1(
        cache_root, authority.source_inventory_digest)
    val manifest = file_read_regular_no_follow_bounded(
        authority.snapshot.snapshot_root + "/SCV_COMPILE_INVENTORY", 256 * 1024 * 1024)
    if manifest.is_err(): return Err("snapshot-source-manifest-unreadable")
    val reason = compiler_source_authority_binding_reason_v1(
        authority.snapshot, authority.source_inventory_digest,
        authority.inventory_generation, admitted, manifest.unwrap())
    if reason != "ok": return Err(reason)
    Ok(admitted.inventory!)

fn compiler_source_authority_invalid_v1(reason: text) -> CompilerSourceAuthorityV1:
    val snapshot = ScvCompileSnapshotV1(
        valid: false, reason: reason, revision_id: "", commit_id: "", tree_id: "",
        inventory_digest: "", inventory_count: 0, snapshot_root: "",
        provenance_path: "", receipt_path: "", source_drifted: false)
    CompilerSourceAuthorityV1(false, reason, snapshot, "", -1)

fn compiler_source_authority_clear_v1() -> bool:
    var cleared = true
    for name in ["SIMPLE_SCV_SNAPSHOT_ROOT", "SIMPLE_SCV_REVISION_ID",
            "SIMPLE_SCV_COMMIT_ID", "SIMPLE_SCV_TREE_ID", "SIMPLE_SCV_INVENTORY_DIGEST",
            "SIMPLE_SCV_SOURCE_INVENTORY_DIGEST", "SIMPLE_SCV_INVENTORY_GENERATION",
            "SIMPLE_SCV_SOURCE_DRIFTED"]:
        if not env_set(name, ""):
            cleared = false
    cleared

fn compiler_source_authority_binding_reason_v1(
    snapshot: ScvCompileSnapshotV1, expected_digest: text, expected_generation: i64,
    actual: CompileSourceInventoryReadV1, manifest: text
) -> text:
    if not snapshot.valid: return snapshot.reason
    if not actual.valid or actual.inventory == nil: return actual.reason
    val binding = CompileSourceInventoryBindingV1(snapshot.inventory_digest, expected_digest)
    val reason = compile_source_inventory_binding_reason_v1(binding, actual.digest)
    if reason != "ok": return reason
    if expected_generation < 0 or actual.inventory!.generation != expected_generation:
        return "source-inventory-generation-mismatch"
    if sha256_text(manifest) != snapshot.inventory_digest:
        return "snapshot-source-manifest-mismatch"
    val rows = if manifest == "": [] else: manifest.split("\n")
    if rows.len() != snapshot.inventory_count:
        return "snapshot-source-count-mismatch"
    if not compiler_source_manifest_membership_v1(actual.inventory!.entries, rows):
        return "snapshot-source-membership-mismatch"
    "ok"

fn compiler_source_authority_validate_v1(
    root: text, cache_root: text, snapshot: ScvCompileSnapshotV1,
    expected_digest: text, expected_generation: i64, inherited: bool
) -> CompilerSourceAuthorityV1:
    # Decoded inventory, manifest rows and membership scratch do not escape.
    # An existing active OR paused scope remains entirely caller-owned. A
    # refused begin keeps the original validation behavior without retirement.
    if transient_array_scope_state_v1() != 0:
        return compiler_source_authority_validate_unscoped_v1(
            root, cache_root, snapshot, expected_digest, expected_generation, inherited)
    if not transient_scope_begin():
        return compiler_source_authority_validate_unscoped_v1(
            root, cache_root, snapshot, expected_digest, expected_generation, inherited)
    val result = compiler_source_authority_validate_unscoped_v1(
        root, cache_root, snapshot, expected_digest, expected_generation, inherited)
    # The validation call graph contains no unconditional pause/end. Its only
    # nested begin (entry validation) ends scratch only when it owns that begin.
    val scope_state = transient_array_scope_state_v1()
    if scope_state != 1:
        # A paused scope still belongs to this successful begin. Retire it
        # before allocating the invalid result. State 0 is already retired.
        if scope_state == 2:
            val ended = transient_scope_end()
        return compiler_source_authority_invalid_v1("source-authority-scratch-state-invalid")
    if not transient_scope_pause():
        val ended = transient_scope_end()
        return compiler_source_authority_invalid_v1("source-authority-scratch-pause-failed")
    val retained = transient_promote(result)
    val ended = transient_scope_end()
    # Construct failure results AFTER retirement; result may now be dangling.
    if not retained:
        return compiler_source_authority_invalid_v1("source-authority-scratch-promote-failed")
    if not ended:
        return compiler_source_authority_invalid_v1("source-authority-scratch-end-failed")
    result

fn compiler_source_authority_validate_unscoped_v1(
    root: text, cache_root: text, snapshot: ScvCompileSnapshotV1,
    expected_digest: text, expected_generation: i64, inherited: bool
) -> CompilerSourceAuthorityV1:
    # Read only the generation the parent admitted; CURRENT may have advanced.
    # Both fresh and inherited snapshots must remain owned by this checkout.
    if compile_source_inventory_snapshot_cache_root_v1(
            root, snapshot.snapshot_root, snapshot.revision_id) != cache_root:
        return compiler_source_authority_invalid_v1("snapshot-source-owner-mismatch")
    # A competing invocation can advance CURRENT after either a fresh refresh
    # or an inherited admission. Validate the exact admitted immutable record
    # in both cases; all digest/generation/manifest/membership checks remain.
    val actual = compile_source_inventory_read_at_pointer_v1(cache_root, expected_digest)
    val manifest = match file_read_regular_no_follow_bounded(
            snapshot.snapshot_root + "/SCV_COMPILE_INVENTORY", 256 * 1024 * 1024):
        case Ok(content): content
        case Err(_): return compiler_source_authority_invalid_v1("snapshot-source-manifest-unreadable")
    val reason = compiler_source_authority_binding_reason_v1(
        snapshot, expected_digest, expected_generation, actual, manifest)
    if reason != "ok": return compiler_source_authority_invalid_v1(reason)
    CompilerSourceAuthorityV1(true, "ok", snapshot, expected_digest, expected_generation)

fn compiler_source_authority_acquire_v1(
    root: text, cache_root: text, source_roots: [text], cold_init: bool
) -> CompilerSourceAuthorityV1:
    val resolved = compiler_source_authority_selectors_v1(root, source_roots)
    if resolved.is_err(): return compiler_source_authority_invalid_v1(resolved.unwrap_err())
    val selectors = resolved.unwrap()
    # Selectors outside the closed event families (e.g. an entry under
    # build/hw) are auto-added and committed into the inventory below, so the
    # snapshot can freeze them. They never become event scopes.
    var extra_roots: [text] = []
    var selected_families: [text] = []
    for selector in selectors:
        val relative = compiler_source_selector_relative_v1(root, selector)
        val family = compiler_inventory_family_v1(relative)
        if family == "":
            if not compiler_source_authority_extra_root_valid_v1(root, relative):
                return compiler_source_authority_invalid_v1("source-inventory-scope-unsupported")
            if not extra_roots.contains(relative): extra_roots = extra_roots.push(relative)
        elif not selected_families.contains(family):
            selected_families = selected_families.push(family)
    if selected_families.len() == 0 and extra_roots.len() == 0:
        return compiler_source_authority_invalid_v1("source-inventory-scope-unsupported")
    if selected_families.len() == 0: selected_families = ["src"]
    var inventory_roots = selected_families
    # First build in a checkout: no event cursor exists yet, so nothing was
    # ever admitted. Auto cold-init (list + commit the src/test generation)
    # instead of failing; every other refresh failure stays fail-closed.
    var cold = cold_init
    if not cold and not compiler_inventory_cursor_present_v1(cache_root):
        cold = true
    if cold:
        if not inventory_roots.contains("src"): inventory_roots = inventory_roots.push("src")
        if not inventory_roots.contains("test"): inventory_roots = inventory_roots.push("test")
        if not inventory_roots.contains("examples/10_tooling"):
            inventory_roots = inventory_roots.push("examples/10_tooling")
    val trace_token = env_get("SIMPLE_INVENTORY_TRACE_ATTEMPT") ?? ""
    val cost = inventory_trace_cost_create_v1(trace_token)
    val inventory_started = scv_cost_now_v1(cost)
    var refresh = compiler_inventory_refresh_traced_cost_v1(
        root, cache_root, inventory_roots, cold, trace_token, cost)
    if refresh.valid and extra_roots.len() > 0:
        refresh = compiler_inventory_admit_extra_roots_v1(root, cache_root, extra_roots)
    if cost != nil: cost!.inventory_ns = scv_cost_elapsed_v1(cost, inventory_started)
    if not refresh.valid:
        inventory_trace_cost_emit_v1(trace_token, cost)
        return compiler_source_authority_invalid_v1(refresh.reason)
    val snapshot_started = scv_cost_now_v1(cost)
    val snapshot = scv_compile_snapshot_acquire_cost_v1(root, cache_root, selectors, cost)
    if cost != nil: cost!.snapshot_ns = scv_cost_elapsed_v1(cost, snapshot_started)
    if not snapshot.valid:
        inventory_trace_cost_emit_v1(trace_token, cost)
        return compiler_source_authority_invalid_v1(snapshot.reason)
    val result = compiler_source_authority_validate_v1(root, cache_root, snapshot,
        refresh.inventory_digest, refresh.inventory_generation, false)
    inventory_trace_cost_emit_v1(trace_token, cost)
    result

fn compiler_source_authority_inventory_roots_v1(root: text, source_roots: [text]) -> [text]:
    # The event protocol admits only the closed canonical families. Snapshot roots are
    # independent, exact selectors and must never be passed as event scopes.
    var families: [text] = []
    for source_root in source_roots:
        val relative = compiler_source_selector_relative_v1(root, source_root)
        val family = compiler_inventory_family_v1(relative)
        if family == "": return []
        if not families.contains(family): families = families.push(family)
    families

fn compiler_source_authority_extra_root_valid_v1(root: text, relative: text) -> bool:
    # An auto-admitted selector must name an existing real file or directory
    # inside the checkout, never SCV/VCS state.
    if relative == "" or relative.contains("|") or relative.contains("\n"): return false
    for owned in ["build/scv", ".simple", ".git", ".scv", ".jj"]:
        # Reject the state itself, anything inside it, and any ancestor of it.
        if relative == owned or relative.starts_with(owned + "/") or
                owned.starts_with(relative + "/"):
            return false
    val path = root + "/" + relative
    file_is_regular_no_follow(path) or dir_is_real_no_follow(path)

fn compiler_source_authority_inherit_v1(snapshot: ScvCompileSnapshotV1) -> CompilerSourceAuthorityV1:
    val root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
    val cache_root = compile_source_inventory_checkout_cache_root_v1(root)
    val digest = env_get("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST") ?? ""
    val generation = (env_get("SIMPLE_SCV_INVENTORY_GENERATION") ?? "").to_i64() ?? -1
    compiler_source_authority_validate_v1(root, cache_root, snapshot, digest, generation, true)

fn compiler_source_authority_open_published_v1(root: text) -> CompilerSourceAuthorityV1:
    # Never refresh CURRENT here: workers and warm receipts must use exactly
    # the immutable generation admitted by the parent, even after a new one
    # is published by another invocation.
    val snapshot = scv_compile_snapshot_open_v1(root,
        env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? "",
        env_get("SIMPLE_SCV_REVISION_ID") ?? "",
        env_get("SIMPLE_SCV_COMMIT_ID") ?? "",
        env_get("SIMPLE_SCV_TREE_ID") ?? "",
        env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "")
    if not snapshot.valid: return compiler_source_authority_invalid_v1(snapshot.reason)
    compiler_source_authority_validate_v1(root,
        compile_source_inventory_checkout_cache_root_v1(root), snapshot,
        env_get("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST") ?? "",
        (env_get("SIMPLE_SCV_INVENTORY_GENERATION") ?? "").to_i64() ?? -1, true)

fn compiler_source_authority_publish_v1(authority: CompilerSourceAuthorityV1) -> bool:
    # The root is the permission marker. Stage every check before calling this
    # function, clear old bindings, and publish root last. Any failed setter
    # clears the partial record instead of leaving a mixed generation.
    if not compiler_source_authority_clear_v1(): return false
    if not authority.valid: return false
    val snapshot = authority.snapshot
    val published = env_set("SIMPLE_SCV_REVISION_ID", snapshot.revision_id) and
        env_set("SIMPLE_SCV_COMMIT_ID", snapshot.commit_id) and
        env_set("SIMPLE_SCV_TREE_ID", snapshot.tree_id) and
        env_set("SIMPLE_SCV_INVENTORY_DIGEST", snapshot.inventory_digest) and
        env_set("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST", authority.source_inventory_digest) and
        env_set("SIMPLE_SCV_INVENTORY_GENERATION", str(authority.inventory_generation)) and
        env_set("SIMPLE_SCV_SOURCE_DRIFTED", if snapshot.source_drifted: "1" else: "0") and
        env_set("SIMPLE_SCV_SNAPSHOT_ROOT", snapshot.snapshot_root)
    if not published:
        compiler_source_authority_clear_v1()
    published
