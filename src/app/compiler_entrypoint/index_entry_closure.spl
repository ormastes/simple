# Select an entry closure from one immutable admitted package graph before the
# native-build source scanner. The caller has already frozen the SCV snapshot.
use app.io.env_ops.{env_get}
use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.cache.package_module_index.{
    PACKAGE_MODULE_INDEX_SCHEMA_V1, PACKAGE_MODULE_INDEX_SCHEMA_V2,
    PACKAGE_MODULE_INDEX_SCHEMA_V3, PackageModuleIndexGenerationV1,
    package_module_index_find_v1, package_module_index_read_current_v1}
use std.scv.compile_source_inventory_core.{compile_source_inventory_path_valid_v1}

pub struct IndexEntryClosureSelectionV1:
    available: bool
    valid: bool
    reason: text
    paths: [text]

fn _index_closure_invalid(reason: text) -> IndexEntryClosureSelectionV1:
    IndexEntryClosureSelectionV1(true, false, reason, [])

fn _index_closure_cold() -> IndexEntryClosureSelectionV1:
    IndexEntryClosureSelectionV1(false, true, "cold-scan", [])

fn _index_closure_root_valid(root: text) -> bool:
    if root == "": return true
    if root.starts_with("/") or root.contains("\\") or root.contains("//") or
            root.contains(":") or root.contains("\n") or root.contains("\r"):
        return false
    for segment in root.split("/"):
        if segment == "" or segment == "." or segment == "..":
            return false
    true

fn _index_closure_under_root(identity: text, roots: [text]) -> bool:
    for root in roots:
        if root == "" or identity == root or identity.starts_with(root + "/"):
            return true
    false

pub fn index_entry_closure_select_v1(
    generation: PackageModuleIndexGenerationV1, entry_identity: text,
    source_roots: [text]
) -> IndexEntryClosureSelectionV1:
    if not compile_source_inventory_path_valid_v1(entry_identity) or
            not entry_identity.ends_with(".spl") or source_roots.len() == 0:
        return _index_closure_invalid("index-entry-or-roots-invalid")
    for root in source_roots:
        if not _index_closure_root_valid(root):
            return _index_closure_invalid("index-source-root-invalid")
    if generation.schema_version != PACKAGE_MODULE_INDEX_SCHEMA_V2 and
            generation.schema_version != PACKAGE_MODULE_INDEX_SCHEMA_V3:
        return _index_closure_invalid("index-graph-schema-invalid")
    if generation.schema_version == PACKAGE_MODULE_INDEX_SCHEMA_V3 and
            generation.scope_entry_source_identity != entry_identity:
        return _index_closure_invalid("index-scope-mismatch")
    var root_module = ""
    for indexed in generation.entries:
        if indexed.source_identity == entry_identity:
            if root_module != "":
                return _index_closure_invalid("index-entry-duplicate")
            root_module = indexed.module_identity
    if root_module == "":
        return _index_closure_invalid("index-entry-not-found")
    var queue: [text] = [root_module]
    var queued: Dict<text, bool> = {}
    var seen_sources: Dict<text, bool> = {}
    queued[root_module] = true
    var selected: [text] = []
    var cursor = 0
    while cursor < queue.len():
        if selected.len() >= 20000:
            return _index_closure_invalid("index-closure-too-large")
        val module_identity = queue[cursor]
        cursor = cursor + 1
        val indexed = package_module_index_find_v1(generation, module_identity)
        if indexed == nil:
            return _index_closure_invalid("index-import-missing")
        val identity = indexed!.source_identity
        if not compile_source_inventory_path_valid_v1(identity) or
                not identity.ends_with(".spl") or
                not _index_closure_under_root(identity, source_roots):
            return _index_closure_invalid("index-source-outside-roots")
        if seen_sources.has(identity):
            return _index_closure_invalid("index-source-duplicate")
        seen_sources[identity] = true
        selected = selected.push(identity)
        for imported in indexed!.direct_imports:
            if not queued.has(imported):
                queue = queue.push(imported)
                queued[imported] = true
    IndexEntryClosureSelectionV1(true, true, "ok", selected)

fn _index_closure_relative(path: text, snapshot_root: text) -> text:
    if path == snapshot_root:
        return ""
    val prefix = snapshot_root + "/"
    if not path.starts_with(prefix):
        return ""
    path.substring(prefix.len(), path.len())

pub fn index_entry_closure_pinned_v1(
    snapshot_root: text, entry: text, source_dirs: [text]
) -> IndexEntryClosureSelectionV1:
    val expected_digest = env_get("SIMPLE_PACKAGE_INDEX_DIGEST") ?? ""
    val expected_producer = env_get("SIMPLE_PACKAGE_INDEX_PRODUCER_DIGEST") ?? ""
    val expected_root = env_get("SIMPLE_PACKAGE_INDEX_ROOT_GENERATION") ?? ""
    val expected_variant = env_get("SIMPLE_PACKAGE_INDEX_VARIANT_DIGEST") ?? ""
    val partial_markers = expected_producer != "" or expected_root != "" or
        expected_variant != ""
    val rebuild_pending =
        (env_get("SIMPLE_PACKAGE_INDEX_REBUILD_PENDING") ?? "") == "1"
    if rebuild_pending:
        if expected_digest != "" or partial_markers:
            return _index_closure_invalid("index-rebuild-pin-conflict")
        return _index_closure_cold()
    if expected_digest == "":
        if partial_markers:
            return _index_closure_invalid("index-partial-markers")
        return _index_closure_cold()
    val admitted = package_module_index_read_current_v1(machine_cache_root())
    if not admitted.valid or admitted.generation == nil:
        return _index_closure_invalid("index-" + admitted.reason)
    if admitted.digest != expected_digest:
        return _index_closure_invalid("index-digest-mismatch")
    val generation = admitted.generation!
    if generation.scv_revision_id != (env_get("SIMPLE_SCV_REVISION_ID") ?? "") or
            generation.scv_commit_id != (env_get("SIMPLE_SCV_COMMIT_ID") ?? "") or
            generation.scv_tree_id != (env_get("SIMPLE_SCV_TREE_ID") ?? ""):
        return _index_closure_invalid("index-scv-identity-mismatch")
    val expected_inventory = if generation.schema_version == PACKAGE_MODULE_INDEX_SCHEMA_V1:
        env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? ""
    else:
        env_get("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST") ?? ""
    if expected_inventory == "" or generation.inventory_digest != expected_inventory:
        return _index_closure_invalid("index-inventory-mismatch")
    if generation.schema_version == PACKAGE_MODULE_INDEX_SCHEMA_V1:
        return _index_closure_cold()
    if generation.producer_digest != expected_producer or
            generation.root_generation != expected_root or
            generation.variant_digest != expected_variant:
        return _index_closure_invalid("index-compatibility-mismatch")
    if snapshot_root == "" or entry == "" or source_dirs.len() == 0:
        return _index_closure_invalid("index-snapshot-path-missing")
    val entry_identity = _index_closure_relative(entry, snapshot_root)
    var root_identities: [text] = []
    for source_dir in source_dirs:
        if source_dir != snapshot_root and
                not source_dir.starts_with(snapshot_root + "/"):
            return _index_closure_invalid("index-source-root-outside-snapshot")
        root_identities = root_identities.push(_index_closure_relative(source_dir, snapshot_root))
    val selected = index_entry_closure_select_v1(
        generation, entry_identity, root_identities)
    if not selected.valid:
        return selected
    var paths: [text] = []
    for identity in selected.paths:
        paths = paths.push(snapshot_root + "/" + identity)
    IndexEntryClosureSelectionV1(true, true, "ok", paths)
