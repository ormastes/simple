# Membership only: digest, generation, count and publication remain owned by
# source_authority. A selected snapshot must never certify a wider inventory.
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1,
    compile_source_inventory_identity_cmp_v1}

fn compiler_source_manifest_membership_v1(
    entries: [CompileSourceInventoryEntryV1], rows: [text]
) -> bool:
    if rows.len() == 0:
        return true
    # Full inventory validation already guarantees canonical ordering. Avoid
    # building a checkout-sized hash table for a small selected snapshot.
    # Keep the binary path for tiny selections; ordered batches use one merge
    # instead of constructing a checkout-sized table of rendered row strings.
    if rows.len() <= 32 and rows.len() * 16 <= entries.len():
        for row in rows:
            if not compiler_source_manifest_row_present_v1(entries, row):
                return false
        return true
    if compiler_source_manifest_ordered_v1(entries, rows):
        return compiler_source_manifest_merge_v1(entries, rows)
    var admitted_rows: {text: bool} = {}
    for entry in entries:
        admitted_rows["{entry.source_identity}|sha256_{entry.content_digest}|{entry.byte_count}"] = true
    for row in rows:
        if not admitted_rows.contains_key(row):
            return false
    true

fn compiler_source_manifest_ordered_v1(
    entries: [CompileSourceInventoryEntryV1], rows: [text]
) -> bool:
    var index = 0
    while index < entries.len():
        val identity = entries[index].source_identity
        # Caller-created records may contain delimiters or duplicate identities.
        # They retain the original exact-row table semantics below.
        if identity.contains("|"):
            return false
        if index > 0 and compile_source_inventory_identity_cmp_v1(
                entries[index - 1].source_identity, identity) >= 0:
            return false
        index = index + 1
    var previous = ""
    index = 0
    while index < rows.len():
        val separator = rows[index].index_of("|")
        if separator < 0:
            return false
        val identity = rows[index][0:separator]
        # Repeated selected rows are permitted; inventory identities are unique.
        if index > 0 and compile_source_inventory_identity_cmp_v1(previous, identity) > 0:
            return false
        previous = identity
        index = index + 1
    true

fn compiler_source_manifest_merge_v1(
    entries: [CompileSourceInventoryEntryV1], rows: [text]
) -> bool:
    var position = 0
    for row in rows:
        val separator = row.index_of("|")
        val identity = row[0:separator]
        while position < entries.len() and compile_source_inventory_identity_cmp_v1(
                entries[position].source_identity, identity) < 0:
            position = position + 1
        if position >= entries.len():
            return false
        val entry = entries[position]
        if row != "{entry.source_identity}|sha256_{entry.content_digest}|{entry.byte_count}":
            return false
    true

fn compiler_source_manifest_row_present_v1(
    entries: [CompileSourceInventoryEntryV1], row: text
) -> bool:
    val separator = row.index_of("|")
    if separator < 0:
        return false
    val identity = row[0:separator]
    var low = 0
    var high = entries.len()
    while low < high:
        val middle = low + (high - low) / 2
        val entry = entries[middle]
        val order = compile_source_inventory_identity_cmp_v1(entry.source_identity, identity)
        if order < 0:
            low = middle + 1
        elif order > 0:
            high = middle
        else:
            if row == "{entry.source_identity}|sha256_{entry.content_digest}|{entry.byte_count}":
                return true
            break
    # Preserve the helper's original membership behavior for caller-created
    # (not decoded) records too, including unsorted or duplicate identities.
    # Canonical successful admission never needs this fallback.
    for entry in entries:
        if row == "{entry.source_identity}|sha256_{entry.content_digest}|{entry.byte_count}":
            return true
    false
