# Closed compiler inventory families. Snapshot selectors remain exact paths;
# this policy never admits arbitrary examples or build output as event scope.
fn compiler_inventory_scope_valid_v1(scope: text) -> bool:
    scope == "src" or scope == "test" or scope == "examples/10_tooling"

fn compiler_inventory_family_v1(relative: text) -> text:
    if relative == "" or relative.contains("\\") or relative.contains(":"):
        return ""
    for component in relative.split("/"):
        if component == "" or component == "." or component == "..": return ""
    for character in relative:
        if character < " " or character == "\x7f": return ""
    if relative == "src" or relative.starts_with("src/"): return "src"
    if relative == "test" or relative.starts_with("test/"): return "test"
    if relative == "examples/10_tooling" or relative.starts_with("examples/10_tooling/"):
        return "examples/10_tooling"
    ""

fn compiler_inventory_path_selected_v1(path: text, scopes: [text]) -> bool:
    val family = compiler_inventory_family_v1(path)
    family != "" and scopes.contains(family)

export compiler_inventory_scope_valid_v1, compiler_inventory_family_v1
export compiler_inventory_path_selected_v1
