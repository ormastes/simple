# One refresh owns at most one descriptor. Discovery owns copied snapshot
# values, not the shared cursor or the membership record's on-disk lifetime.
use std.nogc_sync_mut.io.file_ops.{file_lock, file_unlock, file_write, file_read}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.stderr_ops.{stderr_write}
use app.io.env_ops.{env_get}
use std.scv.compile_source_inventory.{compile_source_inventory_read_pointer_content_v1}
use std.common.crypto.sha256.{sha256_text}
use app.compiler_entrypoint.inventory_trace.{CompilerInventoryTraceV1}
use std.scv.compile_cost_v1.{ScvCompileCostV1}

# Total wait budget for the shared refresh lock. Many parse shards can
# cold-acquire one refresh.lock; they serialise, so the budget must cover the
# whole queue, not one holder. Fail closed only after this real timeout.
val COMPILER_INVENTORY_LOCK_BUDGET_DEFAULT_S: i64 = 900
val COMPILER_INVENTORY_LOCK_SLICE_S: i64 = 5

fn compiler_inventory_lock_budget_v1() -> i64:
    val raw = env_get("SIMPLE_SCV_REFRESH_LOCK_WAIT_S") ?? ""
    if raw == "":
        return COMPILER_INVENTORY_LOCK_BUDGET_DEFAULT_S
    val n = raw.to_int()
    if n <= 0:
        return COMPILER_INVENTORY_LOCK_BUDGET_DEFAULT_S
    n

# Waiting acquisition: bounded retry in short slices so the wait is observable
# and the holder is named. The OS releases flock/LockFileEx when a holder dies,
# so a dead holder never wedges the queue; the waiter simply wins next slice.
fn compiler_inventory_lock_wait_v1(lock_path: text, budget_secs: i64) -> i64:
    var waited: i64 = 0
    var announced = false
    while true:
        val h = file_lock(lock_path, COMPILER_INVENTORY_LOCK_SLICE_S)
        if h >= 0:
            val _owner = file_write(lock_path + ".owner", "pid={getpid()}\n")
            return h
        waited = waited + COMPILER_INVENTORY_LOCK_SLICE_S
        if not announced:
            announced = true
            stderr_write("compile-event-refresh-lock-waiting path={lock_path} holder={_compiler_inventory_lock_holder_v1(lock_path)}\n")
        if waited >= budget_secs:
            break
    stderr_write("compile-event-refresh-lock-unavailable path={lock_path} waited_s={waited} holder={_compiler_inventory_lock_holder_v1(lock_path)}\n")
    -1

fn _compiler_inventory_lock_holder_v1(lock_path: text) -> text:
    val owner = file_read(lock_path + ".owner")
    if owner == "":
        return "unknown"
    owner.trim()

class CompilerInventoryRefreshLeaseV1:
    cache_root: text
    trace: CompilerInventoryTraceV1? = nil
    cost: ScvCompileCostV1? = nil
    handle: i64 = -1

    me acquire(timeout_secs: i64) -> bool:
        return self.acquire_waiting(timeout_secs)

    me acquire_waiting(budget_secs: i64) -> bool:
        if self.handle >= 0:
            return false
        self.handle = compiler_inventory_lock_wait_v1(
            self.cache_root + "/compile-events/refresh.lock", budget_secs)
        if self.handle < 0:
            return false
        if self.trace != nil: self.trace!.lock_released = false
        if self.cost != nil: self.cost!.lock_released = false
        true

    me release() -> bool:
        if self.handle < 0:
            return true
        if not file_unlock(self.handle):
            return false
        self.handle = -1
        if self.trace != nil: self.trace!.lock_released = true
        if self.cost != nil: self.cost!.lock_released = true
        true

    me resume(expected_pointer: text, timeout_secs: i64 = 0) -> text:
        if not self.acquire_waiting(if timeout_secs > 0: timeout_secs else: compiler_inventory_lock_budget_v1()):
            return "compile-event-refresh-lock-unavailable"
        val current = compile_source_inventory_read_pointer_content_v1(self.cache_root) ?? ""
        # Full-byte digest comparison also rejects suffix changes after NUL.
        # A superseded caller still owns this descriptor and must release it.
        if sha256_text(current) != sha256_text(expected_pointer):
            return "compile-event-refresh-snapshot-superseded"
        ""

export CompilerInventoryRefreshLeaseV1, compiler_inventory_lock_wait_v1, compiler_inventory_lock_budget_v1
