# Minimal enterprise notifications entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_notifications.notifications.{notify_setup, notify_status_of, notify_pending}

fn main():
    val store = store_open_file("build/test-artifacts/probe_notifications.splstore")
    val ok = notify_setup(store)
    val pending = notify_pending(store, "t1")
    print("enterprise notifications probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + notify_status_of(store, "t1", "none") + "] pending_count=" + pending.len().to_text())
    store_close(store)
