# Minimal enterprise expense entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_expense.expense.{
    expense_setup, expense_required_role, expense_lines_sum, expense_cap_cents
}

fn main():
    val store = store_open_file("build/test-artifacts/probe_expense.splstore")
    val ok = expense_setup(store)
    # 50_000 cents is the inclusive manager boundary; 50_001 routes to finance.
    val tier = expense_required_role(50000)
    val next_tier = expense_required_role(50001)
    val total = expense_lines_sum([1200, 3400])
    val cap = expense_cap_cents(store, "t1", "travel")
    print("enterprise expense probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " tier=" + tier + " next_tier=" + next_tier + " total=" + total.to_text() + " no_cap=" + cap.to_text())
    store_close(store)
