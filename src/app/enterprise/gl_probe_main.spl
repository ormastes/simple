# Minimal enterprise general-ledger entry — one codebase for host OS and
# SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_gl.gl.{gl_setup, GlLine, gl_entry_balanced, gl_account_balance_of}

fn main():
    val store = store_open_file("build/test-artifacts/probe_gl.splstore")
    val ok = gl_setup(store)
    # A balanced entry: 1000 debit == 1000 credit.
    val balanced = gl_entry_balanced([
        GlLine(account: "cash", debit_cents: 1000, credit_cents: 0),
        GlLine(account: "revenue", debit_cents: 0, credit_cents: 1000)])
    # An unbalanced entry: 1000 debit vs 900 credit -> not balanced.
    val unbalanced = gl_entry_balanced([
        GlLine(account: "cash", debit_cents: 1000, credit_cents: 0),
        GlLine(account: "revenue", debit_cents: 0, credit_cents: 900)])
    val bal = gl_account_balance_of(store, "t1", "cash")
    print("enterprise gl probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " balanced=" + balanced.to_text() + " unbalanced=" + unbalanced.to_text() + " empty_balance=" + bal.to_text())
    store_close(store)
