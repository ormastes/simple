# Minimal enterprise HCM entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_hcm.hcm.{hcm_setup, hcm_employee_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_hcm.splstore")
    val ok = hcm_setup(store)
    print("enterprise hcm probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + hcm_employee_status(store, "t1", "none") + "]")
    store_close(store)
