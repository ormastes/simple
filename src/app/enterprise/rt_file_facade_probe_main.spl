# AC-17 evidence probe: prove the SimpleOS userland rt_file facade
# (os.userlib.rt_file_facade) compiles for the SimpleOS target, so an
# in-guest image carrying it exports rt_file_exists / rt_file_size /
# rt_file_read_text_at / rt_file_atomic_write for SMF-loaded apps.
use os.userlib.rt_file_facade.{rt_file_exists, rt_file_size}

fn main():
    val e = rt_file_exists("/nonexistent")
    val s = rt_file_size("/nonexistent")
    print("rt_file facade probe: exists={e} size={s}")
