# Minimal enterprise inventory entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_inventory.inventory.{inv_setup, stock_on_hand, stock_available}

fn main():
    val store = store_open_file("build/test-artifacts/probe_inventory.splstore")
    val ok = inv_setup(store)
    print("enterprise inventory probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " on_hand=" + stock_on_hand(store, "t1", "SKU-1", "L1").to_text() + " available=" + stock_available(store, "t1", "SKU-1", "L1").to_text())
    store_close(store)
