# Minimal enterprise SESSION entry — one codebase for host OS and SimpleOS
# (AC-17). `std.enterprise_session.session` is the frozen identity/token module
# added after the last cross-OS proof: credential hashing, token derivation, and
# the server-side entropy-min-length floor (`session_entropy_min_len`). It sits
# on the same SMF-safe `enterprise_store.audit_hash` facade the store probe
# uses, so it must stay standalone-SMF-compilable for both targets. A newly
# introduced host-only helper here would break the simpleos artifact while host
# stays green; this probe forces the gate to catch that.
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close}
use std.nogc_sync_mut.enterprise_session.session.{session_setup, session_issue, session_entropy_min_len}
fn main():
    val store = store_open(":memory:")
    session_setup(store)
    val floor = session_entropy_min_len()
    val r = session_issue(store, "t1", "alice", "secret", 1000, 3600, "server-supplied-entropy-value")
    print("session floor=" + floor.to_text() + " issue_ok=" + r.ok.to_text())
    store_close(store)
