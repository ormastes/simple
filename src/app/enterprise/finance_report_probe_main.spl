# Minimal enterprise finance reporting entry — one codebase for host OS and
# SimpleOS (cross-OS AC-17). Exercises the session-gated trial balance report.
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_sale.foundation.{TenantContext, ActorContext, SessionContext}
use std.nogc_sync_mut.enterprise_finance.finance.{fin_setup}
use std.nogc_sync_mut.enterprise_finance.reporting.{trial_balance}

fn main():
    val store = store_open_file("build/test-artifacts/probe_finance_report.splstore")
    val ok = fin_setup(store)
    val tenant = TenantContext(tenant_id: "t1", name: "t1")
    val who = ActorContext(actor_id: "a1", role: "finance")
    val session = SessionContext(token: "tok-a1", actor_id: "a1", tenant_id: "t1", active: true)
    val rep = trial_balance(store, session, tenant, who)
    print("enterprise finance report probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " ok=" + rep.ok.to_text() + " balanced=" + rep.balanced.to_text() + " debit=" + rep.debit_total.to_text() + " credit=" + rep.credit_total.to_text())
    store_close(store)
