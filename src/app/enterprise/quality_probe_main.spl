# Minimal enterprise quality entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_quality.quality.{quality_setup, ncr_id_for, ncr_state, qc_plan_sample_size}

fn main():
    val store = store_open_file("build/test-artifacts/probe_quality.splstore")
    val ok = quality_setup(store)
    val state = ncr_state(store, "t1", ncr_id_for("insp-1"))
    val size = qc_plan_sample_size(store, "t1", "plan-1")
    print("enterprise quality probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " ncr_state=" + state + " no_plan_size=" + size.to_text())
    store_close(store)
