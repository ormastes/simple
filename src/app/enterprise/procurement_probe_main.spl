# Minimal enterprise procurement entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_procurement.procurement.{proc_setup, proc_requisition_status, proc_payable_total}

fn main():
    val store = store_open_file("build/test-artifacts/probe_procurement.splstore")
    val ok = proc_setup(store)
    print("enterprise procurement probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + proc_requisition_status(store, "t1", "none") + "] payable=" + proc_payable_total(store, "t1").to_text())
    store_close(store)
