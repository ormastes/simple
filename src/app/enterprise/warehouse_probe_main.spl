# Minimal enterprise warehouse entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_warehouse.warehouse.{warehouse_setup, wh_bin_capacity, wh_bin_used}

fn main():
    val store = store_open_file("build/test-artifacts/probe_warehouse.splstore")
    val ok = warehouse_setup(store)
    # An unregistered bin is UNKNOWN: capacity -1, occupancy 0.
    val cap = wh_bin_capacity(store, "t1", "A-01")
    val used = wh_bin_used(store, "t1", "A-01")
    print("enterprise warehouse probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " unknown_bin_cap=" + cap.to_text() + " used=" + used.to_text())
    store_close(store)
