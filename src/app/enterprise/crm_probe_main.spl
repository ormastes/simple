# Minimal enterprise CRM entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_crm.crm.{crm_setup, crm_lead_stage, crm_pipeline_summary}

fn main():
    val store = store_open_file("build/test-artifacts/probe_crm.splstore")
    val ok = crm_setup(store)
    val summary = crm_pipeline_summary(store, "t1")
    print("enterprise crm probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " stage=[" + crm_lead_stage(store, "t1", "none") + "] open_count=" + summary.open.count.to_text())
    store_close(store)
