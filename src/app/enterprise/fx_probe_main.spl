# Minimal enterprise FX entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_fx.fx.{fx_setup, fx_scale, fx_round_half_up}

fn main():
    val store = store_open_file("build/test-artifacts/probe_fx.splstore")
    val ok = fx_setup(store)
    # 101 cents at rate 1.5 (micro 1500000) => 151.5 rounds half-up to 152.
    val sample = fx_round_half_up(101 * 1_500_000, fx_scale())
    print("enterprise fx probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " scale=" + fx_scale().to_text() + " round_101x1.5=" + sample.to_text())
    store_close(store)
