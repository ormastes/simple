# Minimal enterprise inter-location transfer entry — one codebase for host OS
# and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_transfer.transfer.{xfer_setup, location_on_hand, transfer_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_transfer.splstore")
    val ok = xfer_setup(store)
    print("enterprise transfer probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " on_hand=" + location_on_hand(store, "t1", "SKU-1", "L1").to_text() + " status=[" + transfer_status(store, "t1", "none") + "]")
    store_close(store)
