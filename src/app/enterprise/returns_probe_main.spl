# Minimal enterprise Returns/RMA entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_returns.returns.{returns_setup, ret_rma_state, rma_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_returns.splstore")
    val ok = returns_setup(store)
    val st = rma_status(store, "t1", "none")
    print("enterprise returns probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " state=[" + ret_rma_state(store, "t1", "none") + "] refund=" + st.refund_cents.to_text())
    store_close(store)
