# Minimal enterprise loyalty entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_loyalty.loyalty.{loyalty_setup, loyalty_balance}

fn main():
    val store = store_open_file("build/test-artifacts/probe_loyalty.splstore")
    val ok = loyalty_setup(store)
    val bal = loyalty_balance(store, "t1", "none")
    print("enterprise loyalty probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " balance=" + bal.to_text())
    store_close(store)
