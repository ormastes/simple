# Minimal enterprise pricing entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_pricing.pricing.{pricing_setup, pricing_percent_discount, discount_effective}

fn main():
    val store = store_open_file("build/test-artifacts/probe_pricing.splstore")
    val ok = pricing_setup(store)
    # 1000 cents at 875 bp = 87.5 -> round-half-up -> 88 (the boundary case).
    val disc = pricing_percent_discount(1000, 875)
    val rule = discount_effective(store, "t1", "SUMMER")
    print("enterprise pricing probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " boundary_disc=" + disc.to_text() + " unknown_found=" + rule.found.to_text())
    store_close(store)
