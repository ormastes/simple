# Minimal enterprise assets entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_assets.assets.{assets_setup, assets_find, assets_cost_basis}

fn main():
    val store = store_open_file("build/test-artifacts/probe_assets.splstore")
    val ok = assets_setup(store)
    # No asset acquired yet: the register folds to not-found with a zero basis.
    val rec = assets_find(store, "t1", "FA-1")
    val basis = assets_cost_basis(store, "t1", "FA-1")
    print("enterprise assets probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " found=" + rec.found.to_text() + " basis=" + basis.to_text())
    store_close(store)
