# Minimal enterprise manufacturing entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_manufacturing.manufacturing.{mfg_setup, bom_exists, produced_qty}

fn main():
    val store = store_open_file("build/test-artifacts/probe_manufacturing.splstore")
    val ok = mfg_setup(store)
    print("enterprise manufacturing probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " bom=" + bom_exists(store, "t1", "FG-1").to_text() + " produced=" + produced_qty(store, "t1", "FG-1").to_text())
    store_close(store)
