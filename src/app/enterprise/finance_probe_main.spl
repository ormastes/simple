# Minimal enterprise finance entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_finance.finance.{fin_setup, fin_trial_balance, fin_period_status}

fn main():
    val store = store_open_file("build/test-artifacts/probe_finance.splstore")
    val ok = fin_setup(store)
    val tb = fin_trial_balance(store, "t1")
    print("enterprise finance probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " balanced=" + tb.balanced.to_text() + " period=" + fin_period_status(store, "t1").to_text())
    store_close(store)
