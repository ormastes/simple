# memstat — out-of-process memory sampler (Stage-4 memory gate, lane L5)
#
# Usage: simple run src/app/memstat/main.spl <pid> <out_csv> [interval_ms]
#
# Samples /proc/<pid>/smaps_rollup (Rss, Pss, Pss_Anon, Private_Dirty, Swap)
# plus /proc/<pid>/stat minflt/majflt at a fixed interval (default 1000 ms) and
# appends CSV rows to <out_csv>. Exits cleanly when the target PID disappears.
#
# Dependency-light by design: only std.io_runtime facades, no app.io coupling,
# so the same module runs under interpreter and native engines.

use std.io_runtime.{get_args, file_read, file_exists, file_write, file_append_text, thread_sleep, time_now_unix_micros}

val CSV_HEADER = "timestamp_us,rss_kb,pss_kb,pss_anon_kb,private_dirty_kb,swap_kb,minflt,majflt"

# Decimal parser over short tokens. Deliberately avoids `parse_int() ?? -1`
# style: `??` on a raw i64 corrupts the value 3 (nil sentinel collision), and
# fault counters legitimately hit small values. Returns -1 when no digits.
fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            # Stop at the first non-digit after the number started.
            return n
        i = i + 1
    if found:
        return n
    -1

# First integer appearing anywhere in a short line ("Rss:  1234 kB" -> 1234).
fn first_int_in(line: text) -> i64:
    parse_dec(line)

# Value for a "Key:   N kB" line in smaps_rollup, or -1 when absent.
fn rollup_value(lines: [text], key: text) -> i64:
    for line in lines:
        if line.starts_with(key):
            return first_int_in(line)
    -1

# minflt (field 10) and majflt (field 12) from /proc/<pid>/stat. The comm
# field can contain spaces, so scan backward for the closing paren first.
# stat content is <1 KB, so the backward char walk is cheap.
fn parse_faults(stat: text) -> (i64, i64):
    var idx = stat.len() - 1
    while idx >= 0 and stat.char_at(idx) != ")":
        idx = idx - 1
    if idx < 0:
        return (-1, -1)
    val rest = stat[idx + 1:].trim()
    val tokens = rest.split(" ")
    # After ')': state ppid pgrp session tty tpgid flags minflt cminflt majflt
    if tokens.len() < 10:
        return (-1, -1)
    (parse_dec(tokens[7]), parse_dec(tokens[9]))

# One CSV row, or "" when the target vanished mid-sample.
fn sample_row(rollup_path: text, stat_path: text) -> text:
    val rollup = file_read(rollup_path)
    val stat = file_read(stat_path)
    if rollup.len() == 0 or stat.len() == 0:
        return ""
    val lines = rollup.split("\n")
    val rss = rollup_value(lines, "Rss:")
    val pss = rollup_value(lines, "Pss:")
    val pss_anon = rollup_value(lines, "Pss_Anon:")
    val private_dirty = rollup_value(lines, "Private_Dirty:")
    val swap = rollup_value(lines, "Swap:")
    val (minflt, majflt) = parse_faults(stat)
    val ts = time_now_unix_micros()
    "{ts},{rss},{pss},{pss_anon},{private_dirty},{swap},{minflt},{majflt}"

# Positional args after the interpreter/script prelude. get_args() yields
# [program, ..., script.spl, user args...]; take everything after the first
# argument ending in ".spl", falling back to argv[1:] for compiled binaries.
fn cli_positional_args() -> [text]:
    val all = get_args()
    var rest: [text] = []
    var seen_script = false
    var i = 1
    while i < all.len():
        val a = all[i]
        if seen_script:
            rest = rest.push(a)
        elif a.ends_with(".spl"):
            seen_script = true
        i = i + 1
    if not seen_script:
        rest = []
        i = 1
        while i < all.len():
            rest = rest.push(all[i])
            i = i + 1
    rest

fn main() -> i64:
    val args = cli_positional_args()
    if args.len() < 2:
        print "usage: memstat <pid> <out_csv> [interval_ms]"
        print "  samples /proc/<pid>/smaps_rollup + stat faults to CSV until <pid> exits"
        return 2
    val pid = parse_dec(args[0])
    if pid <= 0:
        print "memstat: invalid pid '{args[0]}'"
        return 2
    val out_path = args[1]
    var interval_ms = 1000
    if args.len() >= 3:
        val iv = parse_dec(args[2])
        if iv > 0:
            interval_ms = iv

    val stat_path = "/proc/{pid}/stat"
    val rollup_path = "/proc/{pid}/smaps_rollup"

    if not file_exists(stat_path):
        print "memstat: pid {pid} not found (no {stat_path})"
        return 1

    if not file_write(out_path, CSV_HEADER + "\n"):
        print "memstat: cannot write {out_path}"
        return 1

    var rows = 0
    while file_exists(stat_path):
        val row = sample_row(rollup_path, stat_path)
        if row.len() > 0:
            file_append_text(out_path, row + "\n")
            rows = rows + 1
        thread_sleep(interval_ms)

    print "memstat: pid {pid} exited after {rows} samples -> {out_path}"
    0
