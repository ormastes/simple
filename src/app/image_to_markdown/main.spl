# codex-impl
# Direct CLI for the image-to-Markdown service.

use std.cli.cli_util.{get_cli_args}
use app.llm_caret.config.{load_config}
use app.image_to_markdown.app_service.{run_configured_image_file_v1}

fn _image_option_v1(args: [text], name: text) -> text:
    var index = 0
    while index < args.len():
        if args[index] == name and index + 1 < args.len(): return args[index + 1]
        if args[index].starts_with(name + "="): return args[index].substring(name.len() + 1)
        index = index + 1
    ""

fn _image_help_v1():
    print "Usage: image-to-markdown --config FILE --image FILE --root DIR --output DIR --name NAME"

fn main() -> i64:
    val args = get_cli_args()
    val config = _image_option_v1(args, "--config")
    val image = _image_option_v1(args, "--image")
    val root = _image_option_v1(args, "--root")
    val output = _image_option_v1(args, "--output")
    val name = _image_option_v1(args, "--name")
    if config == "" or image == "" or root == "" or output == "" or name == "":
        _image_help_v1()
        return 2
    val config_error = load_config(config)
    if config_error != "":
        print "image-read configuration error: " + config_error
        return 2
    val artifacts = run_configured_image_file_v1(image, root, output, name)
    if artifacts.error != "":
        print "image-read failed: " + artifacts.error
        return 1
    print "Markdown: " + artifacts.markdown_path
    print "Structured: " + artifacts.structured_path
    print "Receipt: " + artifacts.receipt_path
    0
