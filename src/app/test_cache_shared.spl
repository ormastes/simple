# Shared Test Cache — app.test_cache_shared
#
# Shared data structures and helpers for the test result cache.
# Used by test_runner_new/test_result_cache.spl, test_daemon/cache.spl,
# test_incremental_state_shared.spl, and test_runner_files.spl.

use std.nogc_sync_mut.io.file_ops.{file_read_text, file_write, file_stat, file_size, file_exists, file_rename}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.time_ops.{time_sample_unix_micros_or_failure}
use std.nogc_sync_mut.io_runtime.{file_delete, file_hash_sha256_or_empty}

# ============================================================================
# Version & Limits
# ============================================================================

pub val TEST_RESULT_CACHE_VERSION: i64 = 3
pub val MAX_SHARED_TEST_CACHE_ENTRIES: i64 = 8192
val MAX_DEP_HASH_MEMO_ENTRIES: i64 = 16384
val RACELESS_MEMO_MIN_AGE_SECS: i64 = 2

# ============================================================================
# Process-local (mtime, size)-validated SHA-256 memo
# ============================================================================

var _dep_hash_memo: Dict<text, text> = {}
var _dep_hash_memo_count: i64 = 0
var _dep_hash_compute_count: i64 = 0
var _last_recorded_ms: i64 = 0

fn _memo_key(path: text) -> text:
    path.replace("\\", "/")

# reason: file-watcher and runner callers pass raw filesystem paths to evict memoized digests
@allow(primitive_api)
pub fn shared_cache_invalidate_path(path: text):
    """Invalidate any memoized SHA-256 fingerprint for path."""
    if path == "":
        return
    val key = _memo_key(path)
    if _dep_hash_memo.contains_key(key):
        _dep_hash_memo[key] = ""

# reason: runner and daemon lifecycle callers clear process-local digest memo state
@allow(primitive_api)
pub fn shared_cache_clear_memo():
    """Clear all memoized SHA-256 fingerprints."""
    _dep_hash_memo = {}
    _dep_hash_memo_count = 0

# reason: cache telemetry and unit specs read the raw SHA-256 invocation counter
@allow(primitive_api)
pub fn shared_cache_hash_compute_count() -> i64:
    """Return the number of SHA-256 file digests computed in this process."""
    _dep_hash_compute_count

# reason: cache telemetry and unit specs reset the raw SHA-256 invocation counter
@allow(primitive_api)
pub fn shared_cache_reset_hash_compute_count():
    """Reset the SHA-256 file digest computation counter to zero."""
    _dep_hash_compute_count = 0

# ============================================================================
# TestCacheEntry
# ============================================================================

struct TestCacheEntry:
    """Cached result for a single test file."""
    test_path: text
    dep_hash: text           # mtime+content digest of test and dep paths
    result_status: i64       # 0=pass, 1=fail, 2=error, 3=skip
    passed: i64
    failed: i64
    skipped: i64
    duration_ms: i64
    output: text
    cached_at: i64           # Unix micros when entry was written
    last_run_ms: i64         # Unix millis when entry was recorded

fn stale_entry(test_path: text) -> TestCacheEntry:
    """Return a sentinel entry representing a stale/missing cache result."""
    TestCacheEntry(
        test_path: test_path,
        dep_hash: "",
        result_status: -1,
        passed: 0,
        failed: 0,
        skipped: 0,
        duration_ms: 0,
        output: "",
        cached_at: 0,
        last_run_ms: 0
    )

# ============================================================================
# Helpers
# ============================================================================

fn _next_run_timestamps() -> (i64, i64):
    val raw_us = time_sample_unix_micros_or_failure()
    val now_us = if raw_us > 0: raw_us else: 0
    var now_ms = now_us / 1000
    if now_ms <= _last_recorded_ms:
        now_ms = _last_recorded_ms + 1
    _last_recorded_ms = now_ms
    val effective_us = if now_us > now_ms * 1000: now_us else: now_ms * 1000
    (effective_us, now_ms)

fn _entry_last_run_ms(e: TestCacheEntry) -> i64:
    if e.last_run_ms > 0:
        return e.last_run_ms
    if e.cached_at > 0:
        return e.cached_at / 1000
    0

fn _current_unix_secs() -> i64:
    val raw_us = time_sample_unix_micros_or_failure()
    if raw_us <= 0:
        return 0
    raw_us / 1000000

fn _is_raceless_memo_eligible(mtime: i64, size: i64, now_s: i64) -> bool:
    mtime > 0 and size >= 0 and now_s > 0 and (now_s - mtime) >= RACELESS_MEMO_MIN_AGE_SECS

fn _dep_fingerprint(path: text) -> text:
    # mtime alone has one-second resolution, so a same-size rewrite within
    # that second kept the old fingerprint and served a stale cached result.
    # Git-index raceless stat memoization: only serve or store a memoized
    # SHA-256 digest when mtime > 0 and the file's mtime is strictly older
    # than the racy window (now_s - mtime >= 2). Files modified within < 2s
    # of now_s evict any prior memo entry and are always hashed fresh from disk.
    val now_s = _current_unix_secs()
    val mtime = file_stat(path)
    val size = file_size(path)
    val key = _memo_key(path)
    if _is_raceless_memo_eligible(mtime, size, now_s):
        if _dep_hash_memo.contains_key(key):
            val cached = _dep_hash_memo[key]
            if cached != "":
                val parts = cached.split(":")
                if parts.len() == 3 and parts[0] == "{mtime}" and parts[1] == "{size}" and parts[2].len() == 64:
                    return "{mtime}@{parts[2]}"
    elif _dep_hash_memo.contains_key(key):
        _dep_hash_memo[key] = ""
    _dep_hash_compute_count = _dep_hash_compute_count + 1
    val digest = file_hash_sha256_or_empty(path)
    if digest.len() != 64:
        if _dep_hash_memo.contains_key(key):
            _dep_hash_memo[key] = ""
        return "unreadable"
    val post_mtime = file_stat(path)
    val post_size = file_size(path)
    if post_mtime == mtime and post_size == size and _is_raceless_memo_eligible(post_mtime, post_size, now_s):
        if _dep_hash_memo_count >= MAX_DEP_HASH_MEMO_ENTRIES:
            _dep_hash_memo = {}
            _dep_hash_memo_count = 0
        if not _dep_hash_memo.contains_key(key):
            _dep_hash_memo_count = _dep_hash_memo_count + 1
        _dep_hash_memo[key] = "{post_mtime}:{post_size}:{digest}"
    elif _dep_hash_memo.contains_key(key):
        _dep_hash_memo[key] = ""
    val reported_mtime = if post_mtime > 0: post_mtime else: mtime
    "{reported_mtime}@{digest}"

fn _dep_hash(test_path: text, dep_paths: [text]) -> text:
    """Build a fingerprint from file mtimes and content digests."""
    var h: text = _dep_fingerprint(test_path)
    for p in dep_paths:
        h = h + ":" + _dep_fingerprint(p)
    h

fn _select_entries_to_save(entries: {text: TestCacheEntry}) -> ([text], [TestCacheEntry]):
    var kept_entries: [TestCacheEntry] = []
    var kept_ms: [i64] = []
    var kept_keys: [text] = []
    for key in entries.keys():
        val e = entries[key]
        if e.test_path != "" and not file_exists(e.test_path):
            continue
        kept_entries.push(e)
        kept_ms.push(_entry_last_run_ms(e))
        kept_keys.push(key)
    val n = kept_entries.len()
    if n <= MAX_SHARED_TEST_CACHE_ENTRIES:
        return (kept_keys, kept_entries)

    # Shell sort indices descending by last_run_ms (newest first), tie-broken by key.
    var idx: [i64] = []
    var i = 0
    while i < n:
        idx.push(i)
        i = i + 1
    var gap = n / 2
    while gap > 0:
        i = gap
        while i < n:
            val tmp_idx = idx[i]
            val tmp_ms = kept_ms[tmp_idx]
            val tmp_key = kept_keys[tmp_idx]
            var k = i
            while k >= gap:
                val prev_idx = idx[k - gap]
                val prev_ms = kept_ms[prev_idx]
                val move_right = if prev_ms != tmp_ms:
                    prev_ms < tmp_ms
                else:
                    kept_keys[prev_idx] > tmp_key
                if not move_right:
                    break
                idx[k] = prev_idx
                k = k - gap
            idx[k] = tmp_idx
            i = i + 1
        gap = gap / 2

    var capped_keys: [text] = []
    var capped_entries: [TestCacheEntry] = []
    var out_i = 0
    while out_i < MAX_SHARED_TEST_CACHE_ENTRIES:
        val chosen = idx[out_i]
        capped_keys.push(kept_keys[chosen])
        capped_entries.push(kept_entries[chosen])
        out_i = out_i + 1
    (capped_keys, capped_entries)

fn _entries_map_from_selected(selected_keys: [text], selected_entries: [TestCacheEntry]) -> {text: TestCacheEntry}:
    var pruned: {text: TestCacheEntry} = {}
    var i = 0
    while i < selected_keys.len():
        pruned[selected_keys[i]] = selected_entries[i]
        i = i + 1
    pruned

# reason: cache owners pass path-keyed entry maps for missing-file and capacity pruning
@allow(primitive_api)
pub fn shared_cache_prune_entries(entries: {text: TestCacheEntry}) -> {text: TestCacheEntry}:
    """Return a pruned copy of entries with missing test_path rows and overflow past 8192 removed."""
    val (selected_keys, selected_entries) = _select_entries_to_save(entries)
    _entries_map_from_selected(selected_keys, selected_entries)

# ============================================================================
# Shared cache operations
# ============================================================================

fn shared_cache_check_freshness(entries: {text: TestCacheEntry}, test_path: text, dep_paths: [text]) -> TestCacheEntry:
    """Return the cached entry if still fresh, or a stale sentinel."""
    if not entries.contains_key(test_path):
        return stale_entry(test_path)
    val entry = entries[test_path]
    val current_hash = _dep_hash(test_path, dep_paths)
    if entry.dep_hash != current_hash:
        return stale_entry(test_path)
    entry

fn shared_cache_build_entry(test_path: text, dep_paths: [text], status: i64, passed: i64, failed: i64, skipped: i64, duration_ms: i64, output: text) -> TestCacheEntry:
    """Build a new cache entry for the given test result."""
    shared_cache_invalidate_path(test_path)
    val computed_hash = _dep_hash(test_path, dep_paths)
    shared_cache_invalidate_path(test_path)
    val (now_us, now_ms) = _next_run_timestamps()
    TestCacheEntry(
        test_path: test_path,
        dep_hash: computed_hash,
        result_status: status,
        passed: passed,
        failed: failed,
        skipped: skipped,
        duration_ms: duration_ms,
        output: output,
        cached_at: now_us,
        last_run_ms: now_ms
    )

fn shared_cache_save(entries: {text: TestCacheEntry}, cache_path: text) -> {text: TestCacheEntry}:
    """Serialize live, bounded entries to a line-based cache file and return the pruned map."""
    val (selected_keys, selected) = _select_entries_to_save(entries)
    val pruned = _entries_map_from_selected(selected_keys, selected)
    var lines: [text] = []
    lines = lines.push("version:{TEST_RESULT_CACHE_VERSION}")
    for e in selected:
        val run_ms = _entry_last_run_ms(e)
        val line = "{e.test_path}|{e.dep_hash}|{e.result_status}|{e.passed}|{e.failed}|{e.skipped}|{e.duration_ms}|{run_ms}"
        lines = lines.push(line)
    # Atomic: unique temp file + rename, so concurrent runners never tear the file.
    val tmp = "{cache_path}.tmp.{getpid()}"
    if file_write(tmp, lines.join("\n")):
        if not file_rename(tmp, cache_path):
            file_delete(tmp)
    elif file_exists(tmp):
        file_delete(tmp)
    pruned

fn shared_cache_load_entries(cache_path: text) -> {text: TestCacheEntry}:
    """Load entries from a cache file. Returns empty dict on any error."""
    shared_cache_clear_memo()
    var entries: {text: TestCacheEntry} = {}
    val raw = file_read_text(cache_path)
    if raw == "":
        return entries
    val lines = raw.split("\n")
    for line in lines:
        if line.starts_with("version:"):
            pass_dn
        elif line.len() > 0:
            val parts = line.split("|")
            if parts.len() >= 7:
                val loaded_run_ms = if parts.len() >= 8: parts[7].to_int() ?? 0 else: 0
                if loaded_run_ms > _last_recorded_ms:
                    _last_recorded_ms = loaded_run_ms
                val entry = TestCacheEntry(
                    test_path: parts[0],
                    dep_hash: parts[1],
                    result_status: parts[2].to_int() ?? -1,
                    passed: parts[3].to_int() ?? 0,
                    failed: parts[4].to_int() ?? 0,
                    skipped: parts[5].to_int() ?? 0,
                    duration_ms: parts[6].to_int() ?? 0,
                    output: "",
                    cached_at: loaded_run_ms * 1000,
                    last_run_ms: loaded_run_ms
                )
                entries[entry.test_path] = entry
    entries
