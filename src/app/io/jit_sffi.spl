#![allow(REQC004)]
#![allow(primitive_api)]
#!/usr/bin/env simple
# JIT/Execution Manager SFFI Wrapper (single shared surface)
#
# Single point for JIT runtime bindings (and safe stubs when runtime is absent).
# All clients (compiler, loader, interpreter, demos) import from here.
#
# Documentation:
# - Cranelift: https://docs.rs/cranelift-jit/
# - LLVM: https://llvm.org/docs/tutorial/

# ============================================================================
# Tier 1: Soft in-process exec_manager (interpreter-backed)
# ============================================================================
# Provides a functional fallback when native JIT symbols are unavailable.
# Compilation lowers Simple source to HIR and caches handle state in memory;
# execution evaluates directly in-process via InterpreterBackendImpl.

use std.log.{debug}

# Pure Simple frontend + HIR + tree-walking interpreter for in-process execution
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirModule, HirSymbol}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.backend.backend_types.{
    Value,
    FunctionValue,
    backend_value_int_v1,
    backend_value_string_v1,
    backend_value_function_v1
}
use compiler.backend.env.{EvalContext, Environment}
use compiler.backend.interpreter.{InterpreterBackendImpl}

# File I/O through canonical typed owners (no shell dependency and no local
# duplicate SFFI declarations).
use std.io_runtime.{file_write}
use std.io_runtime.{read_file_text_result, file_exists, file_delete}

# Monotonic handle allocator and in-memory handle state tables.
var _next_exec_handle: i64 = 1
var _global_jit_backend: text = "interpreter"
var _exec_valid_handles: Dict<i64, bool> = {}
var _exec_backend_names: Dict<i64, text> = {}
var _exec_opt_levels: Dict<i64, i64> = {}
var _exec_sources: Dict<i64, text> = {}
var _exec_hir_modules: Dict<i64, HirModule> = {}
var _exec_has_hir: Dict<i64, bool> = {}
var _exec_fn_lists: Dict<i64, [text]> = {}
var _exec_fn_lookup: Dict<text, bool> = {}

fn _write_file(fpath: text, content: text) -> bool:
    file_write(fpath, content)

fn _read_file(fpath: text) -> text:
    match read_file_text_result(fpath):
        case Ok(content): content
        case Err(_): ""

fn _delete_file(fpath: text):
    file_delete(fpath)

fn _handle_path(handle: i64) -> text:
    "tmp/jit/simple_soft_jit_{handle}.spl"

fn _parse_int_output_or_neg_one(out: text) -> i64:
    out.to_int() ?? -1

fn _dedent(src: text) -> text:
    """
    Remove common leading indentation from all non-empty lines.
    """
    val lines = src.split("\n")
    var min_indent = 999999
    for ln in lines:
        if ln.trim() == "":
            continue
        var count = 0
        var i = 0
        while i < ln.len() and ln[i:i + 1] == " ":
            count = count + 1
            i = i + 1
        if count < min_indent:
            min_indent = count
    if min_indent == 999999:
        return src
    var out_lines: [text] = []
    for ln in lines:
        if ln.len() >= min_indent:
            out_lines.push(ln[min_indent : ln.len()])
        else:
            out_lines.push(ln)
    out_lines.join("\n")

fn _looks_like_serialized_mir(payload: text) -> bool:
    """Detect raw serialized MIR JSON or textual MIR dumps."""
    val trimmed = payload.trim()
    if trimmed == "":
        return false
    if trimmed.starts_with("{{") or trimmed.starts_with("["):
        return true
    if trimmed.contains("\"blocks\":") and trimmed.contains("\"locals\":"):
        return true
    if trimmed.contains("\"functions\":") and trimmed.contains("\"name\":"):
        return true
    if trimmed.starts_with("mir ") or trimmed.starts_with("MIR "):
        return true
    false

fn _parse_function_names(src: text) -> [text]:
    var names: [text] = []
    val lines = src.split("\n")
    for ln in lines:
        val t = ln.trim()
        if t.starts_with("fn "):
            val rest = t.slice(3, t.byte_len())
            # find returns a plain i64 (-1 == not found), not an Option.
            val idx = rest.find("(")
            if idx >= 0:
                names.push(rest.slice(0, idx).trim())
        elif t.starts_with("pub fn "):
            val rest = t.slice(7, t.byte_len())
            val idx = rest.find("(")
            if idx >= 0:
                names.push(rest.slice(0, idx).trim())
    names

fn _clear_handle_functions(handle: i64):
    if _exec_fn_lists.has(handle):
        val prev_names = _exec_fn_lists[handle]
        for prev_fn in prev_names:
            _exec_fn_lookup["{handle}:{prev_fn}"] = false
    _exec_fn_lists[handle] = []

fn _compile_source_to_hir(handle: i64, source: text) -> Result<HirModule, text>:
    val vpath = "soft_jit/soft_jit_{handle}.spl"
    val mod_name = "soft_jit.soft_jit_{handle}"
    val log = Logger(level: 0)
    val ast = parse_full_frontend(source, vpath, mod_name, log)
    var modules: Dict<text, Module> = {}
    modules[mod_name] = ast
    val sources = [SourceFile(path: vpath, content: source, module_name: mod_name)]
    match module_surfaces_from_modules(modules, sources):
        case Err(err):
            Err("Failed to build module surface: {err}")
        case Ok(surfaces):
            var hl = hirlowering_for_module(vpath, surfaces)
            val hir = hl.lower_module(ast)
            if hl.errors.len() > 0:
                return Err(hl.errors[0].message)
            Ok(hir)

fn _execute_compiled_hir_fn(hir: HirModule, name: text, val_args: [Value]) -> Result<Value, text>:
    val interp = InterpreterBackendImpl.new()
    val env = Environment.new()
    var names_map: Dict<i64, text> = {}
    for nsym_ in hir.symbols.symbols.values():
        val ns: HirSymbol = nsym_
        val ns_id: i64 = ns.id.id
        names_map[ns_id] = ns.name
    var fn_index: Dict<text, HirFunction> = {}
    var target_fn: HirFunction? = None
    for fidx_fn_ in hir.functions.values():
        val fidx_f: HirFunction = fidx_fn_
        fn_index[fidx_f.name] = fidx_f
        val g_fv: FunctionValue = FunctionValue(symbol: fidx_f.symbol, name: fidx_f.name)
        env.define_global(fidx_f.name, backend_value_function_v1(g_fv))
        if fidx_f.name == name:
            target_fn = Some(fidx_f)
    if not target_fn.?:
        return Err("Function '{name}' not found")
    val ctx = EvalContext(
        env: env,
        module: hir,
        backend: interp,
        names: names_map,
        fn_by_name: fn_index,
        has_fn_index: true,
        strict_mem: false
    )
    match interp.call_hir_function(target_fn.unwrap(), val_args, ctx):
        case Ok(v):
            Ok(v)
        case Err(err):
            Err(err.message)

# reason: low-level JIT runtime SFFI configuration takes backend name text and returns admission boolean
@allow(primitive_api)
pub fn rt_set_jit_backend(backend: text) -> bool:
    if backend == "auto" or backend == "interpreter":
        _global_jit_backend = "interpreter"
        return true
    false

# reason: low-level JIT runtime SFFI query returns active backend identifier text
@allow(primitive_api)
pub fn rt_get_jit_backend() -> text:
    _global_jit_backend

# reason: low-level execution manager SFFI handle check takes scalar handle id and returns validity boolean
@allow(primitive_api)
pub fn rt_exec_manager_is_valid(handle: i64) -> bool:
    if handle <= 0:
        return false
    if _exec_valid_handles.has(handle):
        return _exec_valid_handles[handle]
    false

# reason: low-level execution manager SFFI constructor takes backend name text and returns monotonic scalar handle
@allow(primitive_api)
pub fn rt_exec_manager_create(backend: text) -> i64:
    if backend != "auto" and backend != "interpreter":
        return 0
    val handle = _next_exec_handle
    _next_exec_handle = _next_exec_handle + 1
    _exec_valid_handles[handle] = true
    _exec_backend_names[handle] = "interpreter"
    _exec_opt_levels[handle] = 0
    _exec_sources[handle] = ""
    _exec_has_hir[handle] = false
    _exec_fn_lists[handle] = []
    handle

# reason: low-level execution manager SFFI cleanup takes scalar handle and returns status code
@allow(primitive_api)
pub fn rt_exec_manager_cleanup(handle: i64) -> i64:
    if handle > 0:
        _clear_handle_functions(handle)
        _exec_valid_handles[handle] = false
        _exec_sources[handle] = ""
        _exec_has_hir[handle] = false
        val p = _handle_path(handle)
        if file_exists(p):
            _delete_file(p)
    0

# reason: low-level execution manager SFFI source compilation takes scalar handle and source text and returns error text
@allow(primitive_api)
pub fn rt_exec_manager_compile_source(handle: i64, source: text) -> text:
    if not rt_exec_manager_is_valid(handle):
        return "Invalid execution manager handle"
    val trimmed = source.trim()
    if trimmed == "":
        return "Empty source"
    if _looks_like_serialized_mir(trimmed):
        return "Soft JIT backend cannot compile raw serialized MIR payload"
    val normalized = _dedent(trimmed)
    match _compile_source_to_hir(handle, normalized):
        case Err(err_msg):
            err_msg
        case Ok(hir):
            var seen: Dict<text, bool> = {}
            var names: [text] = []
            for fn_item in hir.functions.values():
                val f: HirFunction = fn_item
                if not seen.has(f.name):
                    seen[f.name] = true
                    names.push(f.name)
            if names.len() == 0:
                return "No functions found in source"
            _clear_handle_functions(handle)
            for fn_name in names:
                _exec_fn_lookup["{handle}:{fn_name}"] = true
            _exec_sources[handle] = normalized
            _exec_hir_modules[handle] = hir
            _exec_has_hir[handle] = true
            _exec_fn_lists[handle] = names
            ""

# reason: low-level execution manager SFFI compile entry takes scalar handle and payload text and returns error text
@allow(primitive_api)
pub fn rt_exec_manager_compile(handle: i64, source: text) -> text:
    rt_exec_manager_compile_source(handle, source)

# reason: low-level execution manager SFFI MIR compile entry takes scalar handle and MIR text and returns error text
@allow(primitive_api)
pub fn rt_exec_manager_compile_mir(handle: i64, mir_data: text) -> text:
    if not rt_exec_manager_is_valid(handle):
        return "Invalid execution manager handle"
    val trimmed = mir_data.trim()
    if trimmed == "":
        return "Empty MIR payload"
    if _looks_like_serialized_mir(trimmed):
        return "Soft JIT backend cannot compile raw serialized MIR payload"
    val normalized = _dedent(trimmed)
    if _parse_function_names(normalized).len() == 0:
        return "Soft JIT backend cannot compile raw MIR payload"
    rt_exec_manager_compile_source(handle, normalized)

# reason: low-level execution manager SFFI file compile entry takes scalar handle and path text and returns error text
@allow(primitive_api)
pub fn rt_exec_manager_compile_file(handle: i64, file_path: text) -> text:
    if not rt_exec_manager_is_valid(handle):
        return "Invalid execution manager handle"
    val content = _read_file(file_path)
    if content == "":
        return "empty or unreadable file"
    rt_exec_manager_compile_source(handle, content)

# reason: low-level execution manager SFFI checked execution separates valid -1 return values from execution errors
@allow(primitive_api)
pub fn rt_exec_manager_execute_checked(handle: i64, name: text, args: [i64]) -> (bool, i64, text):
    if not rt_exec_manager_is_valid(handle):
        return (false, 0, "Invalid execution manager handle")
    if not rt_exec_manager_has_function(handle, name):
        return (false, 0, "Function '{name}' not found")
    val has_hir = if _exec_has_hir.has(handle): _exec_has_hir[handle] else: false
    if not has_hir:
        return (false, 0, "No compiled source")
    val hir = _exec_hir_modules[handle]
    var val_args: [Value] = []
    for a in args:
        val_args = val_args.push(backend_value_int_v1(a))
    match _execute_compiled_hir_fn(hir, name, val_args):
        case Err(err_msg):
            (false, 0, err_msg)
        case Ok(v):
            match v:
                case Value.Int(i):
                    (true, i, "")
                case Value.Bool(b):
                    (true, if b: 1 else: 0, "")
                case _:
                    (false, 0, "Execution returned non-integer output")

# reason: legacy execution manager SFFI scalar entry preserves i64 return ABI for existing callers
@allow(primitive_api)
pub fn rt_exec_manager_execute(handle: i64, name: text, args: [i64]) -> i64:
    val (success, value, _) = rt_exec_manager_execute_checked(handle, name, args)
    if success: value else: -1

fn _exec_manager_execute_string_checked(handle: i64, name: text, args: [text]) -> Result<text, text>:
    if not rt_exec_manager_is_valid(handle):
        return Err("Invalid execution manager handle")
    if not rt_exec_manager_has_function(handle, name):
        return Err("Function '{name}' not found")
    val has_hir = if _exec_has_hir.has(handle): _exec_has_hir[handle] else: false
    if not has_hir:
        return Err("No compiled source")
    val hir = _exec_hir_modules[handle]
    var val_args: [Value] = []
    for a in args:
        val_args = val_args.push(backend_value_string_v1(a))
    match _execute_compiled_hir_fn(hir, name, val_args):
        case Err(err_msg):
            Err(err_msg)
        case Ok(v):
            match v:
                case Value.String(s):
                    Ok(s)
                case Value.Int(i):
                    Ok("{i}")
                case Value.Bool(b):
                    Ok(if b: "true" else: "false")
                case _:
                    Err("Execution returned non-string output")

# reason: low-level execution manager SFFI void entry takes scalar handle and function name and returns success boolean
@allow(primitive_api)
pub fn rt_exec_manager_execute_void(handle: i64, name: text) -> bool:
    if not rt_exec_manager_is_valid(handle):
        return false
    if not rt_exec_manager_has_function(handle, name):
        return false
    val has_hir = if _exec_has_hir.has(handle): _exec_has_hir[handle] else: false
    if not has_hir:
        return false
    val hir = _exec_hir_modules[handle]
    match _execute_compiled_hir_fn(hir, name, []):
        case Ok(_): true
        case Err(_): false

# reason: low-level execution manager SFFI O(1) function membership query takes scalar handle and symbol name
@allow(primitive_api)
pub fn rt_exec_manager_has_function(handle: i64, name: text) -> bool:
    if not rt_exec_manager_is_valid(handle):
        return false
    val key = "{handle}:{name}"
    if _exec_fn_lookup.has(key):
        return _exec_fn_lookup[key]
    false

# reason: low-level execution manager SFFI function listing takes scalar handle and returns function name list
@allow(primitive_api)
pub fn rt_exec_manager_list_functions(handle: i64) -> [text]:
    if not rt_exec_manager_is_valid(handle):
        return []
    if _exec_fn_lists.has(handle):
        return _exec_fn_lists[handle]
    []

# reason: low-level execution manager SFFI backend query takes scalar handle and returns backend name text
@allow(primitive_api)
pub fn rt_exec_manager_backend_name(handle: i64) -> text:
    if not rt_exec_manager_is_valid(handle):
        return "unknown"
    if _exec_backend_names.has(handle):
        return _exec_backend_names[handle]
    "interpreter"

# reason: low-level execution manager SFFI optimization level setter takes scalar handle and level
@allow(primitive_api)
pub fn rt_exec_manager_set_opt_level(handle: i64, level: i64) -> bool:
    if not rt_exec_manager_is_valid(handle) or level != 0:
        return false
    _exec_opt_levels[handle] = level
    true

# reason: low-level execution manager SFFI optimization level getter takes scalar handle and returns level
@allow(primitive_api)
pub fn rt_exec_manager_get_opt_level(handle: i64) -> i64:
    if not rt_exec_manager_is_valid(handle):
        return -1
    if _exec_opt_levels.has(handle):
        return _exec_opt_levels[handle]
    0

# ============================================================================
# Tier 2: Simple-Friendly Wrapper Functions
# ============================================================================

# --- Core Types ---

pub enum JitBackend:
    Default     # Automatic selection; interpreter in this soft manager
    Interpreter # In-process InterpreterBackendImpl execution
    Cranelift   # Fast compilation, decent runtime
    LLVM        # Slower compilation, best runtime
    Unknown

# reason: backend wire-name conversion maps JitBackend enum to canonical runtime identifier text
@allow(primitive_api)
pub fn backend_to_string(backend: JitBackend) -> text:
    if backend == JitBackend.Default: "auto"
    elif backend == JitBackend.Interpreter: "interpreter"
    elif backend == JitBackend.Cranelift: "cranelift"
    elif backend == JitBackend.LLVM: "llvm"
    else: "unknown"

# reason: backend wire-name parser maps runtime identifier text to JitBackend enum
@allow(primitive_api)
pub fn string_to_backend(s: text) -> JitBackend:
    if s == "auto": JitBackend.Default
    elif s == "interpreter": JitBackend.Interpreter
    elif s == "cranelift": JitBackend.Cranelift
    elif s == "llvm": JitBackend.LLVM
    else: JitBackend.Unknown

pub struct ExecManager:
    handle: i64
    backend: JitBackend
    is_valid: bool
    opt_level: i64  # Soft interpreter supports only 0 (no native optimization)

pub enum JitCompileResult:
    Success
    Error

pub struct CompileStatus:
    result: JitCompileResult
    error_message: text

pub struct ExecutionResult:
    success: bool
    return_value: i64
    error_message: text

# --- Global JIT Backend Control ---

# reason: global JIT backend setter reports admission as boolean
@allow(primitive_api)
pub fn jit_set_backend(backend: JitBackend) -> bool:
    """Set the global JIT backend for new execution managers."""
    rt_set_jit_backend(backend_to_string(backend))

pub fn jit_get_backend() -> JitBackend:
    """Get the current global JIT backend."""
    val backend_str = rt_get_jit_backend()
    string_to_backend(backend_str)

# --- Capability detection ---

# reason: capability probe returns availability boolean
@allow(primitive_api)
pub fn jit_available() -> bool:
    debug("jit", "jit_available() -> true (in-process interpreter)")
    true  # In-process interpreter always available

# reason: native JIT capability probe returns availability boolean
@allow(primitive_api)
pub fn jit_native_available() -> bool:
    debug("jit", "Native JIT unavailable: using in-process interpreter")
    false

# --- Execution Manager Creation ---

pub fn exec_manager_new() -> ExecManager:
    """
    Create a new execution manager with auto-selected backend.
    Integrates with compiler infrastructure.
    """
    val handle = rt_exec_manager_create("auto")
    val backend = JitBackend.Default
    val valid = rt_exec_manager_is_valid(handle)

    ExecManager(
        handle: handle,
        backend: backend,
        is_valid: valid,
        opt_level: 0
    )

pub fn exec_manager_with_backend(backend: JitBackend) -> ExecManager:
    """
    Create a new execution manager with specific backend.

    Backends:
    - Default: Select the available in-process interpreter
    - Interpreter: Select the in-process interpreter explicitly
    - Cranelift/LLVM: Rejected because this soft manager does not provide them
    """
    val backend_str = backend_to_string(backend)
    val handle = rt_exec_manager_create(backend_str)
    val valid = rt_exec_manager_is_valid(handle)

    ExecManager(
        handle: handle,
        backend: backend,
        is_valid: valid,
        opt_level: 0
    )

pub fn exec_manager_destroy(manager: ExecManager):
    """Release resources for execution manager."""
    if manager.is_valid:
        rt_exec_manager_cleanup(manager.handle)

# --- Compilation Functions ---

# reason: execution manager source compile facade accepts Simple source text
@allow(primitive_api)
pub fn exec_manager_compile_source(manager: ExecManager, source: text) -> CompileStatus:
    """
    Compile Simple source code to executable code.
    """
    if not exec_manager_is_valid(manager):
        CompileStatus(
            result: JitCompileResult.Error,
            error_message: "Invalid execution manager"
        )
    else:
        val error = rt_exec_manager_compile_source(manager.handle, source)
        if error == "":
            CompileStatus(result: JitCompileResult.Success, error_message: "")
        else:
            CompileStatus(result: JitCompileResult.Error, error_message: error)

# reason: execution manager MIR compile facade accepts serialized MIR payload text
@allow(primitive_api)
pub fn exec_manager_compile_mir(manager: ExecManager, mir_data: text) -> CompileStatus:
    """
    Compile MIR (Mid-level IR) to executable code.
    """
    if not exec_manager_is_valid(manager):
        CompileStatus(
            result: JitCompileResult.Error,
            error_message: "Invalid execution manager"
        )
    else:
        val error = rt_exec_manager_compile_mir(manager.handle, mir_data)
        if error == "":
            CompileStatus(result: JitCompileResult.Success, error_message: "")
        else:
            CompileStatus(result: JitCompileResult.Error, error_message: error)

# reason: execution manager file compile facade accepts source file path text
@allow(primitive_api)
pub fn exec_manager_compile_file(manager: ExecManager, file_path: text) -> CompileStatus:
    """
    Compile a .spl file to executable code.
    """
    if not exec_manager_is_valid(manager):
        CompileStatus(
            result: JitCompileResult.Error,
            error_message: "Invalid execution manager"
        )
    else:
        val error = rt_exec_manager_compile_file(manager.handle, file_path)
        if error == "":
            CompileStatus(result: JitCompileResult.Success, error_message: "")
        else:
            CompileStatus(result: JitCompileResult.Error, error_message: error)

# --- Execution Functions ---

# reason: execution manager call facade accepts function name text and i64 ABI argument array
@allow(primitive_api)
pub fn exec_manager_call(manager: ExecManager, function_name: text, args: [i64]) -> ExecutionResult:
    """
    Execute a compiled function with integer arguments.
    """
    if not exec_manager_is_valid(manager):
        ExecutionResult(
            success: false,
            return_value: 0,
            error_message: "Invalid execution manager"
        )
    else:
        if not rt_exec_manager_has_function(manager.handle, function_name):
            ExecutionResult(
                success: false,
                return_value: 0,
                error_message: "Function '{function_name}' not found"
            )
        else:
            val (success, return_val, error) = rt_exec_manager_execute_checked(
                manager.handle, function_name, args)
            if success:
                ExecutionResult(success: true, return_value: return_val, error_message: "")
            else:
                ExecutionResult(success: false, return_value: 0, error_message: error)

# reason: execution manager void call facade accepts function name text
@allow(primitive_api)
pub fn exec_manager_call_void(manager: ExecManager, function_name: text) -> ExecutionResult:
    """
    Execute a compiled function with no arguments (void).
    """
    if not exec_manager_is_valid(manager):
        ExecutionResult(
            success: false,
            return_value: 0,
            error_message: "Invalid execution manager"
        )
    else:
        if rt_exec_manager_execute_void(manager.handle, function_name):
            ExecutionResult(success: true, return_value: 0, error_message: "")
        else:
            ExecutionResult(success: false, return_value: 0, error_message: "Execution failed")

# reason: execution manager string call facade accepts function name and string arguments and returns text result
@allow(primitive_api)
pub fn exec_manager_call_string(manager: ExecManager, function_name: text, args: [text]) -> Result<text, text>:
    """
    Execute a compiled function that returns text.
    """
    if not exec_manager_is_valid(manager):
        Err("Invalid execution manager")
    else:
        _exec_manager_execute_string_checked(manager.handle, function_name, args)

# --- Introspection Functions ---

# reason: execution manager introspection checks function name text and returns membership boolean
@allow(primitive_api)
pub fn exec_manager_has_function(manager: ExecManager, name: text) -> bool:
    """Check if a function has been compiled."""
    if not exec_manager_is_valid(manager):
        false
    else:
        rt_exec_manager_has_function(manager.handle, name)

# reason: execution manager introspection returns compiled function name list
@allow(primitive_api)
pub fn exec_manager_list_functions(manager: ExecManager) -> [text]:
    """List all compiled function names."""
    if not exec_manager_is_valid(manager):
        []
    else:
        rt_exec_manager_list_functions(manager.handle)

pub fn exec_manager_backend(manager: ExecManager) -> JitBackend:
    """Get the backend used by this execution manager."""
    if not exec_manager_is_valid(manager):
        JitBackend.Unknown
    else:
        val backend_str = rt_exec_manager_backend_name(manager.handle)
        string_to_backend(backend_str)

# reason: execution manager validity check returns boolean state
@allow(primitive_api)
pub fn exec_manager_is_valid(manager: ExecManager) -> bool:
    """Check if execution manager is valid."""
    if not manager.is_valid:
        false
    else:
        rt_exec_manager_is_valid(manager.handle)

# --- Optimization Control ---

# reason: execution manager optimization setter takes scalar optimization level and returns admission boolean
@allow(primitive_api)
pub fn exec_manager_set_opt_level(manager: ExecManager, level: i64) -> bool:
    """
    Set optimization level (0-3).

    This interpreter-backed manager accepts only level 0. Native optimization
    requests fail rather than being reported as applied.
    """
    if not exec_manager_is_valid(manager) or level < 0 or level > 3:
        false
    else:
        rt_exec_manager_set_opt_level(manager.handle, level)

# reason: execution manager optimization getter returns scalar optimization level
@allow(primitive_api)
pub fn exec_manager_get_opt_level(manager: ExecManager) -> i64:
    """Get current optimization level."""
    if not exec_manager_is_valid(manager):
        -1
    else:
        rt_exec_manager_get_opt_level(manager.handle)

# --- High-Level Helper Functions ---

# reason: convenience JIT evaluator accepts Simple expression text
@allow(primitive_api)
pub fn jit_eval(source: text) -> ExecutionResult:
    """
    Compile and execute Simple source code immediately.
    Creates a temporary execution manager.
    """
    val mgr = exec_manager_new()

    # Wrap source in a main function if needed
    val wrapped_source = "fn __jit_eval_main() -> i64: {source}"
    val compile_status = exec_manager_compile_source(mgr, wrapped_source)

    if compile_status.result == JitCompileResult.Error:
        exec_manager_destroy(mgr)
        ExecutionResult(
            success: false,
            return_value: 0,
            error_message: compile_status.error_message
        )
    else:
        val result = exec_manager_call(mgr, "__jit_eval_main", [])
        exec_manager_destroy(mgr)
        result

# reason: convenience JIT compile-and-run helper accepts source text, function name, and i64 args
@allow(primitive_api)
pub fn jit_compile_and_run(source: text, function_name: text, args: [i64]) -> ExecutionResult:
    """
    Compile source and execute a specific function.
    """
    val mgr = exec_manager_new()
    val compile_status = exec_manager_compile_source(mgr, source)

    if compile_status.result == JitCompileResult.Error:
        exec_manager_destroy(mgr)
        ExecutionResult(
            success: false,
            return_value: 0,
            error_message: compile_status.error_message
        )
    else:
        val result = exec_manager_call(mgr, function_name, args)
        exec_manager_destroy(mgr)
        result

# reason: convenience JIT file runner accepts file path, function name, and i64 args
@allow(primitive_api)
pub fn jit_load_and_run(file_path: text, function_name: text, args: [i64]) -> ExecutionResult:
    """
    Load a .spl file, compile it, and execute a function.
    """
    val mgr = exec_manager_new()
    val compile_status = exec_manager_compile_file(mgr, file_path)

    if compile_status.result == JitCompileResult.Error:
        exec_manager_destroy(mgr)
        ExecutionResult(
            success: false,
            return_value: 0,
            error_message: compile_status.error_message
        )
    else:
        val result = exec_manager_call(mgr, function_name, args)
        exec_manager_destroy(mgr)
        result

# --- Integration with Compiler Infrastructure ---

# reason: compiler-integrated JIT compile helper accepts source text
@allow(primitive_api)
pub fn jit_compile_with_compiler(manager: ExecManager, source: text) -> CompileStatus:
    """
    Compile using the frontend + HIR pipeline.
    """
    exec_manager_compile_source(manager, source)

