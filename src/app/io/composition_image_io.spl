# Narrow application I/O owner for immutable SCI bytes.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_bytes}

class CompositionImageFileReadV1:
    ok: bool
    bytes: [u8]

fn read_composition_image_file_v1(path: text) -> CompositionImageFileReadV1:
    var bytes: [u8] = []
    if path == "" or not file_exists(path):
        return CompositionImageFileReadV1(false, bytes)
    val raw = file_read_bytes(path)
    var i = 0
    while i < raw.len():
        bytes.push(raw[i] as u8)
        i = i + 1
    CompositionImageFileReadV1(true, bytes)

export CompositionImageFileReadV1, read_composition_image_file_v1
