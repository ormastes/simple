# Canonical narrow runtime boundary for small native application closures.
#
# Importing std.io_runtime materializes its complete extern declaration module.
# Keep this app.io owner limited to operations used by reduced startup servers.

use std.nogc_sync_mut.sffi.process_capture.{process_capture_bounded_native}
use std.nogc_sync_mut.fs.host_path.{host_path_native}

extern fn rt_cli_get_args() -> [text]
extern fn sys_get_args() -> [text]
extern fn rt_exit(code: i64)
extern fn rt_stderr_write(message: text)
extern fn rt_env_get(key: text) -> text?
extern fn rt_env_cwd() -> text?
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_append_text(path: text, content: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_process_run_bounded(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64)
@unsafe(reason: "select boxed interpreter capture or native pointer-and-length capture ABI", capabilities: [ffi])
extern fn rt_is_interpreter_runtime() -> bool
@unsafe(reason: "seed JIT retains the boxed process adapter even when native AOT uses the pointer-and-length ABI", capabilities: [ffi])
extern fn rt_is_jit_runtime() -> bool

fn get_args() -> [text]:
    val runtime_args = rt_cli_get_args() ?? []
    if not runtime_args.is_empty():
        return runtime_args
    sys_get_args() ?? []

fn exit(code: i64):
    rt_exit(code)

fn report_error(scope: text, message: text):
    rt_stderr_write("[" + scope + "] " + message + "\n")

fn env_get(key: text) -> text:
    rt_env_get(key) ?? ""

fn cwd() -> text:
    rt_env_cwd() ?? ""

fn time_now_unix_micros() -> i64:
    rt_time_now_unix_micros()

fn dir_create_all(path: text) -> bool:
    rt_dir_create_all(path)

fn file_exists(path: text) -> bool:
    rt_file_exists(path)

fn file_append_text(path: text, content: text) -> bool:
    rt_file_append_text(path, content)

fn process_run(cmd: text, args: [text]) -> (text, text, i64):
    rt_process_run(cmd, args)

fn process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32):
    rt_process_run_timeout(cmd, args, timeout_ms)

# @workaround bug=phase2_bounded_process_text_abi_2026_10_27 reason=Native AOT code from the deployed P2 marshals the legacy tuple call without the command byte length, so every bounded spawn returned exit 4 with invalid text (LSP-MCP lsp_symbols); use the explicit pointer-and-length capture owner like std process_ops
fn process_run_bounded(cmd: text, args: [text], timeout_ms: i64, max_output_bytes: i64) -> (text, text, i64):
    val interpreted = unsafe(capabilities: [ffi]): rt_is_interpreter_runtime()
    val jit = unsafe(capabilities: [ffi]): rt_is_jit_runtime()
    if not interpreted and not jit:
        # CreateProcessW rejects a relative forward-slash command such as
        # `bin/simple.exe` ("process spawn failed"); std process_ops applies the
        # same host-native conversion (identity off Windows).
        return process_capture_bounded_native(host_path_native(cmd), args, timeout_ms, max_output_bytes)
    rt_process_run_bounded(cmd, args, timeout_ms, max_output_bytes)
