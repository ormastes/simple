#[runtime_intrinsics]
# Process helpers that need explicit environment maps.

@unsafe(reason: "raw owned async-child spawn with environment; positive PID is ownership and -1 is failure", capabilities: [ffi])
extern fn rt_process_spawn_async(cmd: text, args: [text], env: {text: text}) -> i64
@unsafe(reason: "raw owned async-child liveness status; false means stopped, absent, or runtime failure", capabilities: [ffi])
extern fn rt_process_is_running(pid: i64) -> bool

fn _process_spawn_async_env_raw(cmd: text, args: [text], env: {text: text}) -> i64:
    unsafe(capabilities: [ffi]):
        rt_process_spawn_async(cmd, args, env)

fn _process_is_running_raw(pid: i64) -> bool:
    unsafe(capabilities: [ffi]):
        rt_process_is_running(pid)

fn process_spawn_async_env(cmd: text, args: [text], env: {text: text}) -> i64:
    if cmd == "": return -1
    _process_spawn_async_env_raw(cmd, args, env)

fn process_is_alive(pid: i64) -> bool:
    if pid <= 0:
        return false
    _process_is_running_raw(pid)
