# Hosted process compatibility helpers. There is no runtime ABI that accepts
# an environment map at this route. Refuse it before any child is created.
use std.nogc_async_mut.io.process_ops.{process_spawn_async, process_is_running}

val PROCESS_SPAWN_ENV_UNSUPPORTED: i64 = -95

fn process_spawn_async_env(cmd: text, args: [text], env: {text: text}) -> i64:
    if cmd == "": return -1
    if env.len() != 0: return PROCESS_SPAWN_ENV_UNSUPPORTED
    process_spawn_async(cmd, args)

fn process_is_alive(pid: i64) -> bool:
    if pid <= 0:
        return false
    process_is_running(pid)
