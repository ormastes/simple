# Hosted process helpers that apply an explicit environment map.
#
# POSIX keeps its existing env utility route. Windows uses the canonical native
# owner with a private copied UTF16 overlay and the existing async registry.
# Empty values remain present; this map API has no deletion operation.
export use std.nogc_sync_mut.io.process_ops.{process_run_bounded_environment_v1}
use std.nogc_sync_mut.io.process_ops.{process_spawn_environment_overlay_native_v1, process_environment_key_valid_v1}
use std.nogc_async_mut.io.process_ops.{process_spawn_async, process_is_running}
use std.io_runtime.{platform_name, host_os}

val PROCESS_SPAWN_ENV_UNSUPPORTED: i64 = -95
val PROCESS_SPAWN_ENV_INVALID: i64 = -22
val PROCESS_SPAWN_ENV_LAUNCHER: text = "/usr/bin/env"

fn _process_env_host_uses_unix_route() -> bool:
    # OS is caller-mutable and can be absent under a stripped bootstrap env.
    # The runtime platform name is compiled in, so an environment override
    # cannot select the Unix launcher on Windows.
    # The raw owner answers "unknown" (formerly "unix") for OpenBSD/NetBSD;
    # only then ask host_os() for the uname-derived name.
    val raw = platform_name()
    val host = if raw == "unknown": host_os() else: raw
    host == "linux" or host == "macos" or host == "freebsd" or
        host == "illumos" or host == "solaris" or host == "openbsd" or host == "netbsd"

fn process_spawn_async_env(cmd: text, args: [text], env: {text: text}) -> i64:
    if cmd == "": return -1
    if env.len() == 0:
        return process_spawn_async(cmd, args)
    if not _process_env_host_uses_unix_route():
        if platform_name() != "windows": return PROCESS_SPAWN_ENV_UNSUPPORTED
        var assignments: [text] = []
        for key in env.keys():
            val value = env[key] ?? ""
            if not process_environment_key_valid_v1(key) or value.contains("\u{0}"): return PROCESS_SPAWN_ENV_INVALID
            assignments = assignments.push(key + "=" + value)
        return process_spawn_environment_overlay_native_v1(cmd, args, assignments)
    # `env` would parse a utility name containing '=' as another assignment.
    if cmd.contains("="):
        return PROCESS_SPAWN_ENV_INVALID
    var launch_args: [text] = ["--"]
    for key in env.keys():
        if key == "" or key.contains("="):
            return PROCESS_SPAWN_ENV_INVALID
        launch_args.push(key + "=" + (env[key] ?? ""))
    launch_args.push(cmd)
    for arg in args:
        launch_args.push(arg)
    process_spawn_async(PROCESS_SPAWN_ENV_LAUNCHER, launch_args)

fn process_is_alive(pid: i64) -> bool:
    if pid <= 0:
        return false
    process_is_running(pid)
