# REQ-MC-012 profile-aware execution: `--profile=<name>` for `bin/simple run`.
#
# WP-3 (2026-08-07): the alias table that used to be re-typed here now lives
# in compiler.common.assurance.policy_names, which 00.common owns. These two
# wrappers keep their names so the `run` call sites are untouched, but they no
# longer carry a copy of the table -- adding a profile name in 00.common now
# reaches `run` automatically.
#
# Still does NOT import compiler.tools.lint.main / config_and_model.spl's
# parse_lint_profile (even though this file imports LintConfig above for the
# unrelated `lint` command): *executing* parse_lint_profile in the same
# interpreter session that later drives frontend parsing (the in-process
# interpret_file fallback inside cli_run_file) was reported to corrupt that
# later frontend call with "semantic: type mismatch: cannot convert dict to
# int" -- doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md.
# policy_names.spl is safe where lint-main was not: zero `use` lines and zero
# module-level state (the bug record names module-level Dict state as the
# likely trigger), covered by
# test/01_unit/compiler/assurance/policy_graph_contamination_probe_spec.spl.
fn _run_normalize_profile_name(raw: text) -> text:
    normalize_profile_name(raw)

fn _run_valid_profile_names_help() -> text:
    valid_profile_names_help()

# Minimal, self-contained reader for the CANONICAL simple.sdn form
#
#     lints:
#       profile: critical
#
# (doc/06_spec/system/compiler/modules/tooling/formatting_lints.md:345,:438).
# The former TOML-ish `[lints]` / `profile = "x"` shape was removed in WP-4 of
# the aerospace hardening plan — premise 4 established no manifest in the tree
# ever used it, so there is no legacy form to keep.
#
# Still hand-rolled rather than calling
# compiler.driver.project.ProjectContext.load_from_sdn (which is the canonical
# typed mapping and does use std.common.sdn.parser): src/app/io must not pull
# the compiler driver graph into the `run` path, and executing extra module
# init in the session that later drives frontend parsing is the documented
# trigger of the dict-to-int corruption cited above. Collapsing this copy into
# the typed loader is WP-3's job.
#
# Public (and path-taking) so test/01_unit/app/io/run_sdn_lints_profile_spec.spl
# can drive it from a fixture: _run_resolve_profile hardcodes the cwd-relative
# "simple.sdn", which is not testable, and `bin/simple run` cannot exercise this
# file at all today because the deployed binary is the Rust seed (aerospace
# hardening plan premise #0.2).
pub fn run_read_sdn_lints_profile(sdn_path: text) -> text:
    if not file_exists(sdn_path):
        return ""
    val content = rt_file_read_text(sdn_path)
    if content == "":
        return ""
    var in_lints = false
    for line in content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            continue
        val indented = line.starts_with(" ") or line.starts_with("\t")
        if not indented:
            in_lints = trimmed == "lints:"
            continue
        if in_lints and trimmed.starts_with("profile") and trimmed.contains(":"):
            val sep = trimmed.index_of(":") ?? -1
            if sep > 0 and trimmed.substring(0, sep).trim() == "profile":
                var val_str = trimmed.substring(sep + 1).trim()
                val_str = val_str.replace("\"", "")
                val_str = val_str.replace("'", "")
                val_str = val_str.trim()
                return _run_normalize_profile_name(val_str)
    ""

# Resolution order (highest first): explicit --profile= CLI flag (already
# normalized by the caller) > simple.sdn lints.profile in the cwd >
# engine default (unset -- driver_safety_severity.safety_pass_severity()
# treats an unset SIMPLE_SAFETY_PROFILE as Advisory, i.e. today's behavior).
fn _run_resolve_profile(cli_value: text) -> text:
    if cli_value != "":
        return cli_value
    run_read_sdn_lints_profile("simple.sdn")

fn cli_handle_run(args: [text], gc_log: bool, gc_off: bool) -> i64:
    if args.len() > 0:
        var program_args: [text] = []
        var result_file = ""
        var profile_value = ""
        var parse_internal = true
        for arg in args[1:]:
            if parse_internal and arg == "--":
                parse_internal = false
                program_args = program_args.push(arg)
            elif parse_internal and arg.starts_with("--test-result-file="):
                result_file = arg.substring(19)
            elif parse_internal and arg.starts_with("--profile="):
                val raw_profile = arg.substring(10)
                val normalized = _run_normalize_profile_name(raw_profile)
                if normalized == "":
                    _cli_eprint("Error: invalid value for --profile: {raw_profile}")
                    _cli_eprint("  Valid: {_run_valid_profile_names_help()}")
                    return 1
                profile_value = normalized
            else:
                program_args = program_args.push(arg)
        val previous_result_file = env_get("SIMPLE_TEST_RESULT_FILE") ?? ""
        if result_file != "" and not env_set("SIMPLE_TEST_RESULT_FILE", result_file):
            return 1
        val resolved_profile = _run_resolve_profile(profile_value)
        val previous_safety_profile = env_get("SIMPLE_SAFETY_PROFILE") ?? ""
        if resolved_profile != "" and not env_set("SIMPLE_SAFETY_PROFILE", resolved_profile):
            return 1
        val code = cli_run_file(args[0], program_args, gc_log, gc_off)
        if result_file != "" and not env_set("SIMPLE_TEST_RESULT_FILE", previous_result_file):
            return 1
        if resolved_profile != "" and not env_set("SIMPLE_SAFETY_PROFILE", previous_safety_profile):
            return 1
        code
    else:
        print "No file specified"
        1

