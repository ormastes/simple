fn cli_watch_daemon(args: [text]) -> i64:
    if args.len() == 0:
        print "Usage:"
        print "  simple watch-daemon start [options]"
        print "                                  Start watch daemon (foreground, SHB+SMF)"
        print "  simple watch-daemon stop        Stop watch daemon"
        print "  simple watch-daemon status      Show daemon status"
        print ""
        print "Start Options:"
        print "  --backend=<name>        Default SMF backend: auto, cranelift, llvm"
        print "  --opt-level=<level>     Default SMF optimization: none, basic, standard, aggressive"
        print "  --release               Default SMF release mode"
        print "  --debug-info            Keep debug info enabled (default)"
        print "  --no-debug-info         Disable debug info for watcher builds"
        print "  --gc-off                Disable GC for watcher builds"
        print "  --profile=<name>        Default watcher compile profile: dev, test, prod"
        print "  --allow-family=<name>   Allow one runtime family; repeat or comma-separate"
        return 1

    val subcmd = args[0]
    if subcmd == "start":
        return cli_watch_daemon_start(args[1:])
    elif subcmd == "stop":
        return cli_watch_daemon_stop()
    elif subcmd == "status":
        return cli_watch_daemon_status()
    else:
        print "Unknown watch-daemon subcommand: {subcmd}"
        return 1

fn cli_watch_daemon_start(args: [text]) -> i64:
    print "watch-daemon start is unavailable in this compiler CLI build"
    1

fn cli_watch_daemon_stop() -> i64:
    val lock_path = ".build/watcher/watcher.lock"
    if not file_exists(lock_path):
        print "Watch daemon: not running"
        return 1

    val content = read_file_text(lock_path)
    if content == "":
        print "Watch daemon: not running (empty lock)"
        return 1

    val lines = content.split("\n")
    val pid_str = lines[0].trim()
    val pid = pid_str.to_i64() ?? 0
    if pid > 0:
        if rt_process_kill(pid):
            print "Watch daemon stopped (pid: {pid_str})"
            return 0
        else:
            print "Failed to stop watch daemon (pid: {pid_str})"
            return 1
    print "Watch daemon: not running (invalid pid)"
    1

fn cli_watch_daemon_status() -> i64:
    val lock_path = ".build/watcher/watcher.lock"
    if not file_exists(lock_path):
        print "Watch daemon: not running"
        return 0

    val content = read_file_text(lock_path)
    if content == "":
        print "Watch daemon: not running (empty lock)"
        return 0

    val lines = content.split("\n")
    val pid_str = lines[0].trim()

    val pid = pid_str.to_i64() ?? 0
    if pid > 0 and rt_process_exists(pid):
        print "Watch daemon: running (pid: {pid_str})"
    else:
        print "Watch daemon: not running (stale lock, pid: {pid_str})"
    0
