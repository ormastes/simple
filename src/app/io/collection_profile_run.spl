# App-owned capture lifecycle. Events cross interpreter module boundaries via
# the existing process-scoped ABI; profile files are published only here.
use std.nogc_sync_mut.sffi.collection_capture.{
    collection_capture_begin, collection_capture_finish, collection_capture_abort
}
use app.optimize.sprof_collection_profile.{
    sprof_source_module_identity_from_text, sprof_serialize_collection_profile,
    sprof_load_collection_profile_text, sprof_merge_collection_profile_text,
    sprof_load_collection_profile_file, sprof_build_collection_set_index
}
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveSetWorkloadProfile}
use compiler.frontend.core.collection_feedback.{
    parser_collection_feedback_install, parser_collection_feedback_clear,
    parser_collection_feedback_active
}
use compiler.driver.driver_api_interpret.{interpret_file_with_options}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_atomic_write}
use std.nogc_sync_mut.io.path_identity.{path_final_existing, path_identity_same}
use std.io.{file_read}
use app.io._CliCommands.run_commands.{cli_report_interpret_result}
use app.io.cli_ops.{_cli_eprint}

struct CollectionRunOptions:
    output: text
    workload: text
    target: text
    append: bool
    args: [text]
    error: text
    input: text = ""
    module_identity: text = ""

fn collection_run_options(args: [text]) -> CollectionRunOptions:
    var result = CollectionRunOptions(output: "", workload: "", target: "", append: false, args: [], error: "")
    var i = 0
    var internal = true
    while i < args.len():
        val arg = args[i]
        if arg == "--":
            internal = false
        var name = ""
        var value = ""
        if internal:
            for candidate in ["--collection-profile-out", "--collection-profile", "--collection-module", "--collection-workload", "--collection-target"]:
                if arg == candidate:
                    name = candidate
                    i = i + 1
                    if i >= args.len() or args[i].starts_with("--"):
                        result.error = "missing value for {candidate}"
                        return result
                    value = args[i]
                elif arg.starts_with("{candidate}="):
                    name = candidate
                    value = arg.substring(candidate.len() + 1)
        if name != "":
            if value == "":
                result.error = "missing value for {name}"
                return result
            if name == "--collection-profile-out":
                if result.output != "":
                    result.error = "duplicate {name}"
                    return result
                result.output = value
            elif name == "--collection-workload":
                if result.workload != "":
                    result.error = "duplicate {name}"
                    return result
                result.workload = value
            elif name == "--collection-target":
                if result.target != "":
                    result.error = "duplicate {name}"
                    return result
                result.target = value
            elif name == "--collection-profile":
                if result.input != "":
                    result.error = "duplicate {name}"
                    return result
                result.input = value
            else:
                if result.module_identity != "":
                    result.error = "duplicate {name}"
                    return result
                result.module_identity = value
        elif internal and arg == "--collection-profile-append":
            result.append = true
        else:
            result.args.push(arg)
        i = i + 1
    if result.append and result.output == "":
        result.error = "collection append requires --collection-profile-out"
    elif result.output == "" and result.input == "":
        if result.workload != "" or result.target != "" or result.module_identity != "":
            result.error = "collection options require --collection-profile or --collection-profile-out"
    elif result.workload == "" or result.target == "":
        result.error = "collection profiling requires --collection-workload and --collection-target"
    elif result.args.len() == 0:
        result.error = "collection capture requires a source file"
    elif sprof_serialize_collection_profile("capture-validation", result.workload, [], []) == "":
        result.error = "invalid collection workload"
    result

fn collection_run_publish(options: CollectionRunOptions, module_identity: text, snapshot: text) -> bool:
    if options.error != "" or options.output == "" or options.target == "":
        return false
    val header = sprof_serialize_collection_profile(module_identity, options.workload, [], [])
    if header == "":
        return false
    var body = if snapshot == "": header else: "{header}\n{snapshot}"
    val loaded = sprof_load_collection_profile_text(body, module_identity, options.workload)
    if loaded.status != "loaded" or loaded.diagnostic_count != 0:
        return false
    for sample in loaded.samples:
        if sample.profile.target_profile_id != options.target:
            return false
    for sample in loaded.metrics:
        if sample.metric.target_profile_id != options.target:
            return false
    if options.append and file_exists(options.output):
        body = sprof_merge_collection_profile_text(file_read(options.output), body, module_identity, options.workload)
        if body == "":
            return false
    file_atomic_write(options.output, body)

fn collection_run_finish(options: CollectionRunOptions, module_identity: text, exit_code: i64) -> i64:
    if exit_code != 0:
        collection_capture_abort()
        return exit_code
    val snapshot = collection_capture_finish()
    if snapshot == nil:
        collection_capture_abort()
        return 1
    if collection_run_publish(options, module_identity, snapshot.unwrap()): 0 else: 1

fn _collection_run_distinct_output(source: text, output: text) -> bool:
    # Resolve existing aliases, including symlinks and Windows case/volume
    # spellings. A failed identity lookup is not evidence of distinctness.
    match path_final_existing(source):
        case Err(_): false
        case Ok(source_path):
            if not file_exists(output):
                return true
            match path_final_existing(output):
                case Err(_): false
                case Ok(output_path): not path_identity_same(source_path, output_path)

fn collection_run_file(options: CollectionRunOptions, gc_log: bool = false, gc_off: bool = false) -> i64:
    if options.error != "" or (options.output == "" and options.input == "") or options.args.len() == 0:
        return 1
    if gc_log or gc_off:
        _cli_eprint("Error: collection interpreter GC overrides are not implemented")
        return 1
    val path = options.args[0]
    if not path.ends_with(".spl") or not file_exists(path) or (options.output != "" and not _collection_run_distinct_output(path, options.output)):
        return 1
    # This operation owns a fresh parse. Do not overwrite another invocation's
    # parser catalog; an empty catalog forces the existing cache bypass.
    if parser_collection_feedback_active():
        return 1
    val source = file_read(path)
    val identity = sprof_source_module_identity_from_text(path, source)
    if options.module_identity != "" and options.module_identity != identity:
        _cli_eprint("Error: collection profile was not admitted: source module mismatch")
        return 1
    var profiles: [AdaptiveSetWorkloadProfile] = []
    if options.input != "":
        if not file_exists(options.input):
            _cli_eprint("Error: collection profile was not admitted: file missing")
            return 1
        val loaded = sprof_load_collection_profile_file(options.input, identity, options.workload)
        if loaded.status != "loaded":
            _cli_eprint("Error: collection profile was not admitted: {loaded.status}")
            return 1
        val prepared = sprof_build_collection_set_index(loaded)
        for profile in prepared.profiles:
            if profile.target_profile_id == options.target: profiles.push(profile)
        if not prepared.admitted or profiles.len() == 0:
            _cli_eprint("Error: collection profile was not admitted: no samples for target")
            return 1
    if not parser_collection_feedback_install(options.target, profiles):
        _cli_eprint("Error: collection profile was not admitted: invalid target measurements")
        return 1
    if options.output != "" and not collection_capture_begin(options.target):
        parser_collection_feedback_clear()
        return 1
    val execution = interpret_file_with_options(path, options.args, gc_off)
    parser_collection_feedback_clear()
    var code = cli_report_interpret_result(path, execution)
    if not file_exists(path) or file_read(path) != source or (options.output != "" and not _collection_run_distinct_output(path, options.output)):
        _cli_eprint("Error: collection source changed or output aliases the source")
        code = 1
    if options.output == "": return code
    val finished = collection_run_finish(options, identity, code)
    if code == 0 and finished != 0:
        _cli_eprint("Error: collection profile output was rejected")
    finished

export CollectionRunOptions, collection_run_options, collection_run_publish
export collection_run_finish, collection_run_file
