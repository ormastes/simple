# FTP FFI compatibility facade.
# The canonical safe SFFI surface lives in app.io.ftp_sffi; this facade
# re-exports it so legacy `use app.io.ftp_ffi` importers keep working
# without touching raw externs (REQ-APP-IO-001).

export use app.io.ftp_sffi.{
    ftp_connect, ftp_connect_secure, ftp_login, ftp_disconnect, ftp_quit,
    ftp_pwd, ftp_cwd, ftp_cdup, ftp_mkdir, ftp_rmdir, ftp_list,
    ftp_download, ftp_upload, ftp_append, ftp_delete, ftp_rename, ftp_size,
    ftp_get_modify_time, ftp_set_passive_mode, ftp_set_active_mode,
    ftp_set_binary_mode, ftp_set_ascii_mode, ftp_noop, ftp_get_welcome,
    ftp_is_connected
}
