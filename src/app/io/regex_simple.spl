# Compatibility facade for the canonical legacy regex API owner.
# The no-GC async module retains the sole raw boundary and its linear find-all
# accumulation; export resolution adds no regex call or wrapper dispatch.
export use std.nogc_async_mut.io.regex_simple.{
    regex_is_match, regex_test, regex_find, regex_find_all, regex_match,
    regex_captures, parse_named_groups, regex_named_captures,
    regex_replace, regex_replace_all, regex_split, regex_split_n,
    is_valid_email, is_valid_url, is_valid_ipv4, is_valid_uuid,
    is_valid_hex_color, is_valid_phone_us, regex_extract_emails,
    regex_extract_urls, regex_extract_numbers, regex_extract_words,
    regex_remove_html_tags, regex_remove_whitespace,
    regex_normalize_whitespace, regex_trim
}
