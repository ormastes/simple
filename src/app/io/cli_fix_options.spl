# Shared closed option validation for both pure-Simple fix CLI owners.

pub fn fix_option_error(args: [text]) -> text:
    var help_count = 0
    var other_count = 0
    var rule_value_next = false
    for arg in args:
        if arg == "fix":
            continue
        if rule_value_next:
            rule_value_next = false
            if arg.starts_with("-"):
                return "--rule requires a CODE"
            continue
        if arg == "--help" or arg == "-h":
            help_count = help_count + 1
            continue
        other_count = other_count + 1
        if arg == "--dry-run" or arg == "--fix-all" or arg == "--preview" or arg == "--safe-only":
            continue
        if arg == "--rule":
            rule_value_next = true
            continue
        if arg.starts_with("--rule="):
            if arg.len() == "--rule=".len():
                return "--rule requires a CODE"
            continue
        if arg.starts_with("--diagnostic="):
            if arg.len() == "--diagnostic=".len():
                return "--diagnostic requires a CODE"
            continue
        if arg.starts_with("--fix-id="):
            if arg.len() == "--fix-id=".len():
                return "--fix-id requires an ID"
            continue
        if arg.starts_with("-"):
            return "unknown option: {arg}"
    if rule_value_next:
        return "--rule requires a CODE"
    if help_count > 0 and (help_count != 1 or other_count > 0):
        return "help cannot be combined with files or other options"
    ""
