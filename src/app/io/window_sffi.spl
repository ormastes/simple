# Compatibility facade for the canonical library-owned SDL2 SFFI boundary.
#
# Keep one declaration/call authority so ABI signatures, unsafe capabilities,
# sentinel rules, and future evidence receipts cannot drift across app/lib
# copies. The C provider validates generation handles before reaching SDL.
export use std.nogc_sync_mut.io.window_sffi.{
    EventLoop, EventBatch, WindowConfig, Window, Size, Position,
    EventType, Event, KeyState, VirtualKey, KeyboardEvent,
    MouseButton, MouseButtonEvent, MousePosition, MouseWheel, Monitor,
    window_create_event_loop, window_destroy_event_loop,
    window_run_event_loop, window_poll_events, window_wait_events,
    window_config_default, window_create, window_create_with_config,
    window_destroy, window_get_size, window_set_size, window_get_position,
    window_set_position, window_get_inner_size, window_get_outer_size,
    window_set_min_size, window_set_max_size, window_set_title,
    window_set_visible, window_is_visible, window_set_resizable,
    window_set_minimized, window_set_maximized, window_is_maximized,
    window_set_fullscreen, window_is_fullscreen, window_set_decorations,
    window_set_always_on_top, window_focus, window_request_redraw,
    window_present_rgba, window_id,
    window_set_cursor_visible, window_set_cursor_grab,
    window_set_cursor_position, event_get_type_code, event_parse_type,
    event_destroy, event_window_resized, event_window_moved,
    event_window_focused, event_keyboard_input,
    event_received_character, event_mouse_button, event_mouse_moved,
    event_mouse_wheel, parse_virtual_key, window_get_monitor_count,
    window_get_monitor_info, window_clipboard_get, window_clipboard_set,
    window_clipboard_has_text, window_last_error
}
