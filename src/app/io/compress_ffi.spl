# Compression FFI compatibility facade.
# The canonical safe SFFI surface lives in app.io.compress_sffi; this facade
# re-exports it so legacy `use app.io.compress_ffi` importers keep working
# without touching raw externs (REQ-APP-IO-001).

export use app.io.compress_sffi.{
    CompressionLevel,
    compression_level_to_int,
    gzip_compress, gzip_decompress, gzip_compress_file, gzip_decompress_file,
    deflate_compress, deflate_decompress,
    zip_create, zip_open, zip_add_file, zip_add_data, zip_extract,
    zip_extract_file, zip_list, zip_close,
    tar_create, tar_open, tar_add_file, tar_add_data, tar_extract,
    tar_extract_file, tar_list, tar_close,
    targz_create, targz_extract,
    compress, decompress, compress_file, decompress_file
}
