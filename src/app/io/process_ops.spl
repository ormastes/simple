@allow(star_import) # reason: compatibility facade, re-exports backing module symbols
# Compatibility facade: app.io.process_ops -> std.nogc_sync_mut.io.process_ops
#
# This file was a twin of the lib module; the co-compiled duplicate
# definitions were removed 2026-09-19 so every name has exactly one owner
# (Class B silent-win misdispatch; see
# doc/08_tracking/bug/duplicate_public_symbols_differing_return_types_jit_misdispatch_2026-08-09.md
# and its superseding co_compiled_symbol_collision_decision_2026-08-09.md,
# Phase 1: finish the app/io -> std.nogc_sync_mut.io shim migration).
# The lib module owns the canonical bodies; this module's app-only public
# surface (process_run_direct, process_run_inherit, process_spawn_inherit,
# process_exists, process_pid_exists, process_kill_unchecked and their raw
# helpers) was ported into the lib module first, so importers observe
# identical behaviour through this facade.
export use std.nogc_sync_mut.io.process_ops.{
    # raw process primitives
    _process_run_raw, _process_run_bounded_raw, _process_run_inherit_raw,
    _process_run_timeout_raw, _process_spawn_async_raw,
    _process_spawn_inherit_raw, _process_wait_raw, _process_is_running_raw,
    _process_exists_raw, _process_kill_raw,
    # file read helpers
    _read_text_at_checked, _read_text_or_empty,
    # platform / command resolution
    _is_windows_platform, _resolve_process_cmd,
    # process group cleanup / limits engine
    _process_kill_group, _process_run_with_limits,
    # process execution
    process_run, process_run_direct, process_run_bounded, process_run_inherit,
    process_run_timeout, process_run_timeout_unix, process_run_timeout_windows,
    process_run_timeout_live, process_run_with_limits,
    process_run_with_limits_bounded, process_bounded_timed_out,
    process_output,
    # shell functions
    _shell_command_args, shell, shell_bool, shell_output_default,
    shell_output_trimmed, shell_lines, _shell_signed_int_or, shell_int,
    # async process management
    process_spawn_async, process_spawn_inherit, process_wait,
    process_is_running, process_exists, process_pid_exists, process_kill,
    process_kill_unchecked,
    # stderr print
    eprint
}
