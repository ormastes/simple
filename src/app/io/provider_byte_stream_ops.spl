# Host-owned raw byte-stream capability for incremental application protocols.
#
# Concrete stdio/socket adapters live at the app.io/runtime boundary.  Leaf
# applications receive this capability and never declare platform externs.

struct AppByteReadV1:
    status: text
    bytes: [u8]
    detail: text

struct AppByteWriteV1:
    status: text
    written_bytes: i64
    detail: text

trait AppByteStreamPort:
    me read_some(maximum_bytes: i64, deadline_at_ms: i64) -> AppByteReadV1
    me write_some(bytes: [u8], offset: i64, maximum_bytes: i64,
                  deadline_at_ms: i64) -> AppByteWriteV1

export AppByteReadV1, AppByteWriteV1, AppByteStreamPort
