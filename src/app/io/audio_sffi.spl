# App compatibility facade for the canonical no-GC audio SFFI owner.
#
# Keep raw miniaudio declarations, generation-counted handle validation, and
# future ABI evidence in one module. Only the safe wrapper surface is exposed.
export use std.nogc_sync_mut.io.audio_sffi.{
    AudioEngine, AudioSource, AudioPlayback, AudioCapture, audio_init,
    audio_shutdown, audio_load_sound, audio_unload_sound, audio_play,
    audio_play_looped, audio_play_pcm_f32, audio_stop, audio_pause,
    audio_resume, audio_set_volume, audio_set_master_volume,
    audio_get_master_volume, audio_is_playing, audio_live_source_count,
    audio_live_playback_count, audio_live_device_count, audio_backend_name,
    audio_backend_is_real, audio_sdl2_init, audio_sdl2_live_device_count,
    audio_sdl2_close, audio_set_sound_position,
    audio_set_spatialization_enabled, audio_set_listener_position,
    audio_set_listener_direction, audio_set_listener_world_up,
    audio_set_sound_min_distance, audio_set_sound_max_distance,
    audio_capture_start, audio_capture_is_active, audio_capture_frame_count,
    audio_capture_stop
}
