# Parent native-build cache binding. Worker dispatch retains its own explicit
# cache routing; this owner does not infer a parent/worker from environment.
use std.nogc_async_mut.sosix.environment.{
    sosix_env_get_nullable, sosix_env_set, sosix_env_remove
}

pub fn native_build_cache_snapshot() -> text?:
    sosix_env_get_nullable("SIMPLE_NATIVE_BUILD_CACHE_DIR")

pub fn native_build_cache_bind(requested: text) -> bool:
    # An omitted CLI selection preserves the inherited/default driver route.
    # A nonempty CLI selection is authoritative, matching the focused owner.
    if requested == "":
        return true
    sosix_env_set("SIMPLE_NATIVE_BUILD_CACHE_DIR", requested)

pub fn native_build_cache_restore(previous: text?) -> bool:
    # @workaround bug=optional_array_payload_narrowing_native_2026_10_21 reason=old_producer_does_not_narrow_optional_after_nil_guard
    # Stage 2 may pass the Some box itself after a nil comparison. Bind the
    # payload explicitly before calling the SOSIX text setter.
    if val present = previous:
        return sosix_env_set("SIMPLE_NATIVE_BUILD_CACHE_DIR", present)
    sosix_env_remove("SIMPLE_NATIVE_BUILD_CACHE_DIR")
