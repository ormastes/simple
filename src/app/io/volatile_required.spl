"""Native-required volatile operations for hosted device daemons."""

use std.nogc_sync_mut.io.volatile_ops.{
    rt_volatile_read_u64,
    rt_volatile_write_u64,
    rt_memory_barrier,
}

fn volatile_read_u64_required(addr: i64) -> i64:
    """Read through the canonical runtime binding; no interpreter fallback."""
    rt_volatile_read_u64(addr)

fn volatile_write_u64_required(addr: i64, value: i64):
    """Write through the canonical runtime binding; no interpreter fallback."""
    rt_volatile_write_u64(addr, value)

fn memory_barrier_required():
    """Fence through the canonical runtime binding; no interpreter fallback."""
    rt_memory_barrier()
