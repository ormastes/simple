# Positional bootstrap driver output selection. No CLI flag preserves the
# inherited mode; an explicit flag overrides it only for the compile call.
use std.nogc_async_mut.sosix.environment.{
    sosix_env_get_nullable, sosix_env_set, sosix_env_remove
}

pub fn native_build_output_mode_snapshot() -> text?:
    sosix_env_get_nullable("SIMPLE_NATIVE_BUILD_EMIT_OBJECT")

pub fn native_build_output_mode_bind(requested: text) -> bool:
    if requested == "":
        return true
    if requested != "1" and requested != "archive" and requested != "shared":
        return false
    sosix_env_set("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", requested)

pub fn native_build_output_mode_restore(previous: text?) -> bool:
    # @workaround bug=optional_array_payload_narrowing_native_2026_10_21 reason=old_producer_does_not_narrow_optional_after_nil_guard
    if val present = previous:
        return sosix_env_set("SIMPLE_NATIVE_BUILD_EMIT_OBJECT", present)
    sosix_env_remove("SIMPLE_NATIVE_BUILD_EMIT_OBJECT")
