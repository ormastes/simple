# Source roots shared by positional native-build snapshot selection and lookup.
use std.nogc_sync_mut.io.dir_ops.{is_dir}

pub fn native_build_snapshot_source_roots_v1(
    entry_relative: text, source_dirs: [text]
) -> [text]:
    """Preserve explicit roots; cover workspace imports and entry siblings by default.

    entry_relative is the entry's canonical path inside the admitted repository.
    Unsafe or unavailable positional entries must not broaden snapshot selection.
    Root-level entries need explicit finite source roots: selecting their parent
    would admit the entire repository, which compile snapshot ownership rejects.
    """
    if source_dirs.len() > 0:
        return source_dirs
    if entry_relative == "" or entry_relative.starts_with("/") or entry_relative.contains(":"):
        return []
    for segment in entry_relative.split("/"):
        if segment == "" or segment == "." or segment == ".." or segment.contains("\\"):
            return []
    val separator = entry_relative.last_index_of("/")
    if separator <= 0:
        return []
    # Every workspace import namespace the CLI closure reaches (`os.`, `plugins.`
    # included). A root missing here resolves those imports in the LIVE tree,
    # whose own std imports then collide with the snapshot copies.
    var roots: [text] = ["src/app", "src/lib", "src/compiler", "src/os", "src/plugins"]
    val parent = entry_relative[0:separator]
    var covered = false
    for root in roots:
        if parent == root or parent.starts_with(root + "/"):
            covered = true
    if not covered:
        roots = roots.push(parent)
    roots

pub fn native_build_snapshot_drop_missing_default_roots_v1(
    root: text, roots: [text]
) -> [text]:
    """Default roots (src/os, src/plugins) that a checkout lacks are a warning,
    not an admission error. Only call this for DEFAULT root lists: an explicitly
    requested --source root that is empty stays a hard source-inventory-root-empty.
    """
    var kept: [text] = []
    for relative in roots:
        if is_dir(root + "/" + relative):
            kept = kept.push(relative)
        else:
            eprint "SCV-W-ADMISSION: default source root '" + relative + "' not present under " + root + "; skipped"
    kept
