# Source roots shared by positional native-build snapshot selection and lookup.

pub fn native_build_snapshot_source_roots_v1(
    entry_relative: text, source_dirs: [text]
) -> [text]:
    """Preserve explicit roots; cover workspace imports and entry siblings by default.

    entry_relative is the entry's canonical path inside the admitted repository.
    Unsafe or unavailable positional entries must not broaden snapshot selection.
    Root-level entries need explicit finite source roots: selecting their parent
    would admit the entire repository, which compile snapshot ownership rejects.
    """
    if source_dirs.len() > 0:
        return source_dirs
    if entry_relative == "" or entry_relative.starts_with("/") or entry_relative.contains(":"):
        return []
    for segment in entry_relative.split("/"):
        if segment == "" or segment == "." or segment == ".." or segment.contains("\\"):
            return []
    val separator = entry_relative.last_index_of("/")
    if separator <= 0:
        return []
    var roots: [text] = ["src/app", "src/lib", "src/compiler"]
    val parent = entry_relative[0:separator]
    var covered = false
    for root in roots:
        if parent == root or parent.starts_with(root + "/"):
            covered = true
    if not covered:
        roots = roots.push(parent)
    roots
