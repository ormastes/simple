# Entry-closure walker for `native-build --entry-closure`, split out of
# compile_targets.spl so the slim parse-shard entry
# (src/app/cli/parse_shard_main.spl) can compute the same source set without
# importing compile_targets, whose top-level `use compiler.driver.driver`
# evaluates the whole back half of the compiler (~665 modules, ~3.3 GB RSS)
# before a single line of the shard runs. Behaviour is byte-identical: this is
# a move, not a rewrite (doc/08_tracking/bug/memory_retention_compiler_and_interpreter_2026-08-21.md).
use app.io.env_ops (env_get, env_set)
use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1,
    compiler_source_authority_inherit_v1, compiler_source_authority_publish_v1,
    compiler_source_authority_clear_v1}
use app.compiler_entrypoint.derived_composition.{compiler_cuda_composition_root_v1}
use std.scv.compile_source_inventory.{compile_source_inventory_plain_checkout_v1,
    compile_source_inventory_checkout_cache_root_v1}
use app.io.time_ops (time_now_unix_micros)
use app.cli.native_build_warm_receipt.{native_build_warm_candidate_publish}
use compiler.driver.driver_library_mode_resolution_v1.{driver_library_mode_resolve_v1,
    driver_library_mode_native_owner_v1}
use app.io._CliCompile.native_build_snapshot_roots.{native_build_snapshot_source_roots_v1}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.process_ops.{eprint}
use compiler.driver.driver_source_loading.{
    _driver_text_bucket_set_new,
    _driver_cached_entry_source_scan, driver_closure_scan_phase_trace,
    _driver_entry_import_dirname, _driver_physical_source_key,
    driver_resolve_closure_import_v1, driver_closure_native_owner_v1,
    driver_closure_import_specs_v1, driver_closure_importer_module_v1
}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use std.scv.compile_snapshot.{
    scv_compile_snapshot_open_v1
}
@unsafe(reason: "raw path expansion; empty text is the invalid-or-expansion-failure sentinel", capabilities: [ffi])
extern fn rt_path_absolute(path: text) -> text

fn _nb_file_exists_raw(path: text) -> bool:
    file_exists(path)

fn _nb_path_absolute_raw(path: text) -> text:
    unsafe(capabilities: [ffi]):
        rt_path_absolute(path)

fn _cli_eprint(message: text):
    eprint(message)

fn _nb_basename(path: text) -> text:
    val parts = path.split("/")
    if parts.len() == 0:
        return path
    parts[parts.len() - 1]

fn _nb_trim_trailing_slashes(path: text) -> text:
    var p = path
    while p.len() > 1 and p.ends_with("/"):
        p = p.substring(0, p.len() - 1)
    p

fn _nb_source_dirs_cover_workspace(source_dirs: [text]) -> bool:
    var app = false
    var lib = false
    var compiler = false
    for source_dir in source_dirs:
        val name = _nb_basename(_nb_trim_trailing_slashes(source_dir))
        if name == "app": app = true
        if name == "lib": lib = true
        if name == "compiler": compiler = true
    app and lib and compiler

var _nb_scv_snapshot_key_v1: text = ""
var _nb_scv_snapshot_root_v1: text = ""
var _nb_scv_snapshot_revision_v1: text = ""
var _nb_scv_snapshot_commit_v1: text = ""
var _nb_scv_snapshot_tree_v1: text = ""
var _nb_scv_snapshot_inventory_v1: text = ""
# Set when the last freeze refused because the entry lies under no admitted
# source root (an ad-hoc user script, e.g. /tmp/hello.spl). See
# _native_build_entry_closure for the non-strict working-tree fallback.
var _nb_scv_entry_outside_root_v1: bool = false
# True when the last closure was computed from the working tree (either
# fallback); its source roots are then handed off unmapped (driver: Ok([])).
var _nb_scv_unfrozen_closure_v1: bool = false

# Bootstrap lanes keep the frozen-entry contract strict. Mirrors the driver
# cold-entry fallback in src/compiler/80.driver/driver_source_pipeline_loading.spl,
# whose in-process admitted-task check has no CLI-side equivalent. An inherited
# SIMPLE_SCV_SNAPSHOT_ROOT is NOT a strictness signal: the CLI publishes one for
# every native-build before the closure runs.
fn _nb_scv_strict_entry_v1() -> bool:
    (env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" or
        (env_get("SIMPLE_SCV_STRICT_COLD_ENTRY") ?? "") == "1"

pub fn native_build_closure_snapshot_root_v1() -> text:
    # Read only after _native_build_entry_closure has admitted its snapshot.
    _nb_scv_snapshot_root_v1

pub fn native_build_closure_source_roots_v1(entry: text, source_dirs: [text]) -> Result<[text], text>:
    # Admission is established by _nb_scv_freeze_v1, not by path existence.
    # Reuse its mapping for supported argv spellings and effective defaults.
    if _nb_scv_unfrozen_closure_v1:
        return Ok([])
    if _nb_scv_snapshot_root_v1 == "":
        return Err("SOURCE_ROOT_SNAPSHOT_MISSING")
    val effective = native_build_snapshot_source_roots_v1(
        _nb_scv_relative_path_v1(entry), source_dirs)
    if effective.len() == 0:
        return Err("SOURCE_ROOT_SELECTORS_MISSING")
    val prefix = _nb_scv_snapshot_root_v1 + "/"
    var selectors: [text] = []
    for root in effective:
        val mapped = _nb_scv_snapshot_path_v1(root)
        if mapped == "" or not mapped.starts_with(prefix):
            return Err("SOURCE_ROOT_MAPPING_MISSING: " + root)
        selectors = selectors.push(mapped.substring(prefix.len()))
    Ok(selectors)

pub fn native_build_closure_release_snapshot_memo_v1():
    # The parent request publisher owns a scratch walk. Its selected files and
    # request are durable before it drops these process-local lookup hints.
    # A later walk reopens and validates the same inherited authority.
    _nb_scv_snapshot_key_v1 = ""
    _nb_scv_snapshot_root_v1 = ""
    _nb_scv_snapshot_revision_v1 = ""
    _nb_scv_snapshot_commit_v1 = ""
    _nb_scv_snapshot_tree_v1 = ""
    _nb_scv_snapshot_inventory_v1 = ""

fn _nb_scv_relative_path_v1(path: text) -> text:
    val root = _nb_trim_trailing_slashes(
        _nb_path_absolute_raw(".").replace("\\", "/"))
    val absolute = _nb_path_absolute_raw(path).replace("\\", "/")
    if root == "" or absolute == "":
        return ""
    if absolute == root:
        return ""
    val prefix = root + "/"
    if not absolute.starts_with(prefix):
        return ""
    absolute.substring(prefix.len(), absolute.len())

fn _nb_scv_snapshot_path_v1(path: text) -> text:
    val absolute = _nb_path_absolute_raw(path).replace("\\", "/")
    val snapshot_absolute = _nb_path_absolute_raw(
        _nb_scv_snapshot_root_v1).replace("\\", "/")
    if snapshot_absolute != "" and (absolute == snapshot_absolute or
            absolute.starts_with(snapshot_absolute + "/")):
        return absolute
    val relative = _nb_scv_relative_path_v1(path)
    if relative == "" or _nb_scv_snapshot_root_v1 == "":
        return ""
    if relative.starts_with("build/"):
        val checkout = _nb_trim_trailing_slashes(_nb_path_absolute_raw(".").replace("\\", "/"))
        val derived = compiler_cuda_composition_root_v1(
            checkout, _nb_scv_snapshot_root_v1, path, false)
        if derived.is_err(): return ""
        return _nb_scv_snapshot_root_v1 + "/" + derived.unwrap()
    _nb_scv_snapshot_root_v1 + "/" + relative

fn _nb_scv_key_v1(entry: text, source_dirs: [text], revision: text) -> text:
    entry + "|" + source_dirs.join("|") + "|scv=" + revision +
        "|inventory=" + (env_get("SIMPLE_SCV_SOURCE_INVENTORY_DIGEST") ?? "") +
        "|generation=" + (env_get("SIMPLE_SCV_INVENTORY_GENERATION") ?? "") +
        "|root=" + (env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? "") +
        "|manifest=" + (env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? "") +
        "|commit=" + (env_get("SIMPLE_SCV_COMMIT_ID") ?? "") +
        "|tree=" + (env_get("SIMPLE_SCV_TREE_ID") ?? "")

fn _nb_scv_freeze_v1(entry: text, source_dirs: [text]) -> (bool, text, [text]):
    val entry_relative = _nb_scv_relative_path_v1(entry)
    val effective_roots = native_build_snapshot_source_roots_v1(
        entry_relative, source_dirs)
    # A root-level checkout entry keeps its explicit-roots refusal; only an
    # entry under no root at all may take the user-entry fallback.
    _nb_scv_entry_outside_root_v1 = effective_roots.len() == 0 and
        not (entry_relative != "" and not entry_relative.contains("/"))
    if effective_roots.len() == 0:
        if entry_relative != "" and not entry_relative.contains("/"):
            _cli_eprint("SCV-E-ENTRY: root-level entry requires explicit finite --source roots; repository-wide admission is unsupported")
        else:
            _cli_eprint("SCV-E-ENTRY: entry is outside the admitted source root")
        return (false, "", [])
    val key = _nb_scv_key_v1(
        entry, effective_roots, env_get("SIMPLE_SCV_REVISION_ID") ?? "")
    if _nb_scv_snapshot_key_v1 != key:
        val inherited_root = env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? ""
        if inherited_root != "":
            _nb_scv_snapshot_revision_v1 = env_get("SIMPLE_SCV_REVISION_ID") ?? ""
            _nb_scv_snapshot_commit_v1 = env_get("SIMPLE_SCV_COMMIT_ID") ?? ""
            _nb_scv_snapshot_tree_v1 = env_get("SIMPLE_SCV_TREE_ID") ?? ""
            _nb_scv_snapshot_inventory_v1 = env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? ""
            val opened = scv_compile_snapshot_open_v1(
                ".", inherited_root,
                _nb_scv_snapshot_revision_v1, _nb_scv_snapshot_commit_v1,
                _nb_scv_snapshot_tree_v1, _nb_scv_snapshot_inventory_v1)
            if not opened.valid:
                compiler_source_authority_clear_v1()
                _cli_eprint("SCV-E-SNAPSHOT: {opened.reason}")
                return (false, "", [])
            val authority = compiler_source_authority_inherit_v1(opened)
            if not authority.valid:
                compiler_source_authority_clear_v1()
                _cli_eprint("SCV-E-SOURCE-AUTHORITY: {authority.reason}")
                return (false, "", [])
            _nb_scv_snapshot_root_v1 = opened.snapshot_root
            _nb_scv_snapshot_key_v1 = _nb_scv_key_v1(
                entry, effective_roots, opened.revision_id)
            if (env_get("SIMPLE_SCV_SOURCE_DRIFTED") ?? "") == "1":
                _cli_eprint(
                    "SCV-W-DRIFT: frozen revision retained; schedule a new build")
        else:
            var inventory_roots = effective_roots
            if not inventory_roots.contains(entry):
                inventory_roots = inventory_roots.push(entry)
            val root = compile_source_inventory_plain_checkout_v1(_nb_path_absolute_raw("."))
            val cache_root = compile_source_inventory_checkout_cache_root_v1(root)
            val authority = compiler_source_authority_acquire_v1(
                root, cache_root, inventory_roots,
                (env_get("SIMPLE_SCV_INVENTORY_COLD_INIT") ?? "") == "1")
            if not authority.valid:
                compiler_source_authority_clear_v1()
                _cli_eprint("SCV-E-SOURCE-AUTHORITY: {authority.reason}")
                return (false, "", [])
            if not compiler_source_authority_publish_v1(authority):
                _cli_eprint("SCV-E-SOURCE-AUTHORITY: environment publication failed")
                return (false, "", [])
            val snapshot = authority.snapshot
            _nb_scv_snapshot_root_v1 = snapshot.snapshot_root
            _nb_scv_snapshot_revision_v1 = snapshot.revision_id
            _nb_scv_snapshot_commit_v1 = snapshot.commit_id
            _nb_scv_snapshot_tree_v1 = snapshot.tree_id
            _nb_scv_snapshot_inventory_v1 = snapshot.inventory_digest
            _nb_scv_snapshot_key_v1 = _nb_scv_key_v1(
                entry, effective_roots, snapshot.revision_id)
            env_set("SIMPLE_SCV_SOURCE_DRIFTED",
                if snapshot.source_drifted: "1" else: "0")
            if snapshot.source_drifted:
                _cli_eprint("SCV-W-DRIFT: frozen revision retained; schedule a new build")
    val frozen_entry = _nb_scv_snapshot_path_v1(entry)
    if frozen_entry == "" or not _nb_file_exists_raw(frozen_entry):
        _cli_eprint("SCV-E-ENTRY: entry absent from frozen inventory")
        return (false, "", [])
    var frozen_dirs: [text] = []
    for source_dir in effective_roots:
        val frozen = _nb_scv_snapshot_path_v1(source_dir)
        if frozen == "":
            _cli_eprint("SCV-E-SOURCE: source root absent from frozen inventory")
            return (false, "", [])
        frozen_dirs = frozen_dirs.push(frozen)
    env_set("SIMPLE_NATIVE_BUILD_ENTRY", frozen_entry)
    (true, frozen_entry, frozen_dirs)

fn _nb_normalize_source_dirs(source_dirs: [text]) -> [text]:
    # Drop duplicate roots and redundant bare `src` when explicit workspace
    # roots already cover app, lib, and compiler imports.
    var normalized: [text] = []
    for raw_dir in source_dirs:
        val dir = _nb_trim_trailing_slashes(raw_dir)
        if dir == "" or normalized.contains(dir):
            continue
        normalized = normalized.push(dir)
    var result: [text] = []
    val workspace_covered = _nb_source_dirs_cover_workspace(normalized)
    for candidate in normalized:
        if workspace_covered and _nb_basename(candidate) == "src":
            continue
        result = result.push(candidate)
    result

pub fn _native_build_entry_closure(entry: text, source_dirs: [text], library_mode: text = "") -> [text]:
    # BFS the entry's import closure so --entry-closure compiles only reachable
    # modules (one `main`), not every file in the --source dirs. Over-approximates
    # safely: an unresolved `use` is skipped; a genuinely missing import still
    # errors in the compile phase.
    # SCV freeze is an optional consistency/caching layer (a frozen,
    # content-addressed snapshot of the source tree). `_nb_scv_freeze_v1`
    # fails closed whenever there is no admitted source inventory to freeze
    # against (`compile_source_inventory_read_current_v1`), which is the case
    # in EVERY worktree on this host: the inventory is maintained purely by
    # explicit event submission from a git/filesystem watcher adapter
    # (src/lib/scv/compile_source_inventory.spl: "this module never
    # discovers files"), and nothing here ever ran one.
    #
    # Before this fix, a failed freeze made this function return `[]`
    # outright with only the terse, non-actionable `SCV-E-SNAPSHOT:
    # <reason>` line already printed inside `_nb_scv_freeze_v1` -- so every
    # native-build, even a 2-line hello-world entry with no imports, silently
    # compiled an empty closure and died later, deep inside the pipeline,
    # with an opaque, locationless
    # `error: semantic: method \`len\` not found on type \`i64\``. See
    # doc/08_tracking/bug/native_build_entry_closure_scv_freeze_collapses_to_empty_2026-09-13.md.
    #
    # Fail-closed policy is kept (still returns `[]` by default -- a design
    # change to bypass it silently was rejected in review): on freeze failure
    # this now prints a LOUD, actionable diagnostic naming the cause and the
    # remedy instead of the bare reason code. An unfrozen direct filesystem
    # scan (read straight from the working tree, exactly as if no SCV
    # snapshot were ever consulted -- weaker consistency: a concurrent edit
    # is not guaranteed to be seen atomically) is available ONLY as an
    # explicit opt-in via `SIMPLE_SCV_FREEZE_FALLBACK=1`, which prints its own
    # one-line notice when it takes effect.
    val frozen = _nb_scv_freeze_v1(entry, source_dirs)
    val freeze_fallback_enabled = (env_get("SIMPLE_SCV_FREEZE_FALLBACK") ?? "") == "1"
    # A user entry outside every admitted root (`native-build /tmp/hello.spl`)
    # has nothing to freeze against: the snapshot covers inventory families
    # only. Outside bootstrap/admitted lanes it compiles from the working tree,
    # like the explicit fallback, instead of refusing every ad-hoc script.
    val user_entry_unfrozen = not frozen.0 and _nb_scv_entry_outside_root_v1 and
        not _nb_scv_strict_entry_v1()
    if not frozen.0 and not freeze_fallback_enabled and not user_entry_unfrozen:
        _cli_eprint(
            "error: native-build: SCV freeze has no admitted source " +
            "inventory to freeze the entry closure against (see the " +
            "SCV-E-* reason above). Refusing to compute an entry closure " +
            "under the default fail-closed policy. Remedy: set " +
            "SIMPLE_SCV_FREEZE_FALLBACK=1 to opt into an unfrozen direct " +
            "filesystem scan instead (weaker consistency guarantee), or " +
            "populate an admitted source inventory first (see " +
            "src/lib/scv/compile_source_inventory.spl).")
        _nb_scv_unfrozen_closure_v1 = false
        return []
    if not frozen.0 and user_entry_unfrozen and not freeze_fallback_enabled:
        _cli_eprint(
            "SCV-W-USER-ENTRY: entry is outside the admitted source roots; " +
            "compiling it from the working tree (set SIMPLE_SCV_STRICT_COLD_ENTRY=1 " +
            "to refuse instead)")
    elif not frozen.0:
        _cli_eprint(
            "SCV-W-FREEZE-FALLBACK: SIMPLE_SCV_FREEZE_FALLBACK=1 is set; " +
            "scanning the working tree directly instead of a frozen SCV " +
            "snapshot (weaker consistency guarantee: a concurrent edit is " +
            "not guaranteed to be seen atomically)")
    _nb_scv_unfrozen_closure_v1 = not frozen.0
    val frozen_entry = if frozen.0: frozen.1 else: entry
    val frozen_source_dirs = if frozen.0: frozen.2 else: source_dirs
    val trace_closure = (env_get("SIMPLE_NATIVE_BUILD_TRACE_CLOSURE") ?? "") == "1"
    # Level-gated, default-off per-file timing probe. The 25-file checkpoint
    # above only shows aggregate progress; this prints a per-file elapsed-us
    # delta so a flat vs. growing per-file cost (O(n) vs O(n^2)) can be told
    # apart without waiting on the whole closure to finish. See
    # doc/08_tracking/bug/native_build_entry_closure_slow_2026-07-31.md.
    val trace_timing = (env_get("SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING") ?? "") == "1"
    var queue: [text] = [frozen_entry]
    var discovered = _driver_text_bucket_set_new(512)
    discovered[_driver_physical_source_key(frozen_entry)] = true
    var result: [text] = []
    var resolve_cache: Dict<text, text> = {}
    val closure_source_dirs = _nb_normalize_source_dirs(frozen_source_dirs)
    var qi = 0
    var timing_file_start_us: i64 = 0
    while qi < queue.len():
        val f = queue[qi]
        qi = qi + 1
        if trace_timing:
            timing_file_start_us = time_now_unix_micros()
        result.append(f)
        # A start marker must precede the cached scan: completion-only timing
        # cannot identify the physical source when that scan itself times out.
        driver_closure_scan_phase_trace("closure_node:start", f)
        if not _nb_file_exists_raw(f):
            if trace_closure and f == frozen_entry:
                _cli_eprint("[native-build] closure entry missing {f}")
            continue
        val (content, _, _, _) = _driver_cached_entry_source_scan(f)
        driver_closure_scan_phase_trace("closure_node:scanned", f)
        if trace_closure and f == frozen_entry:
            _cli_eprint("[native-build] closure entry read len={content.len()}")
        if trace_closure and result.len() % 25 == 0:
            _cli_eprint("[native-build] closure visited {result.len()} queued={queue.len()} file={f}")
        # Import specs, resolution, and native-owner preference are the
        # driver worker walk's own functions (driver_resolve_closure_import_v1):
        # the two walks must bind every spelling to the same physical file.
        val module_paths = driver_closure_import_specs_v1(f)
        val importer_dir = _driver_entry_import_dirname(f)
        val importer_module = driver_closure_importer_module_v1(f)
        for mp in module_paths:
            # Bare spellings bind importer-relative, so cache per directory.
            val cache_key = importer_dir + "|" + mp
            var rp = ""
            if resolve_cache.has(cache_key):
                rp = resolve_cache[cache_key]
            else:
                val selected = match driver_library_mode_resolve_v1(mp, closure_source_dirs, importer_dir, library_mode, importer_module):
                    case Ok(value): value
                    case Err(reason):
                        _cli_eprint(reason)
                        return []
                match selected:
                    case SourceRootResolutionV1.Found(path):
                        val spelling = if mp.starts_with(".") and not mp.starts_with(".."): importer_module + mp else: mp
                        rp = driver_library_mode_native_owner_v1(path, spelling, importer_dir, library_mode, importer_module)
                    case SourceRootResolutionV1.Missing: ()
                    case SourceRootResolutionV1.Ambiguous(directory):
                        _cli_eprint("SOURCE_ROOT_AMBIGUOUS: import '{mp}' has competing numbered directories under '{directory}'")
                        return []
                resolve_cache[cache_key] = rp
            if trace_closure and f == frozen_entry:
                _cli_eprint("[native-build] closure import {mp} -> {rp}")
            if rp != "":
                val rp_key = _driver_physical_source_key(rp)
                if not discovered.contains_key(rp_key):
                    queue.append(rp)
                    discovered[rp_key] = true
        if trace_timing:
            val elapsed_us = time_now_unix_micros() - timing_file_start_us
            _cli_eprint("[native-build] closure timing n={result.len()} queued={queue.len()} elapsed_us={elapsed_us} imports={module_paths.len()} content_len={content.len()} file={f}")
    val _candidate_written = native_build_warm_candidate_publish(result)
    result
