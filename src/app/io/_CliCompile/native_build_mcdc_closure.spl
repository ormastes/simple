use std.common.mcdc.model.{mcdc_mode_from_text, mcdc_mode_name}

# The MC/DC probe owner is a hidden ABI edge: the program entry calls its
# configure function (emit_mcdc_runtime_configuration) without an authored
# `use`. The pipeline closure scan admits it synthetically, but a frozen
# preclosed request (closure_walks=0) skips that scan, so the CLI entry walk
# must admit it too or the link fails with an undefined
# `mcdc_static_probe_configure_bytes`. Text comparison, not `match`: the
# Stage 2 lane mis-dispatched enum arms on this mode before
# (_driver_mcdc_mir_mode).
pub fn native_build_mcdc_closure_spec_v1(mode_text: text) -> text:
    if val parsed = mcdc_mode_from_text(mode_text):
        val name = mcdc_mode_name(parsed)
        if name == "on": return "std.nogc_sync_mut.mcdc.static_probe"
        if name == "dynamic": return "std.nogc_sync_mut.mcdc.dynamic_probe"
    ""
