# snpm cache — Local package cache management

use app.snpm.config.{SnpmConfig}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_mkdir(path: text, mode: i64) -> i64
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_list_dir(path: text) -> [text]?

fn get_cached(name: text, version: text, config: SnpmConfig) -> text:
    """Check if package is cached, return path or empty string."""
    val cache_path = "{config.cache_dir}/{name}/{version}"
    val tarball = "{cache_path}/{name}-{version}.spk"
    if rt_file_exists(tarball):
        return tarball
    ""

fn cache_package(name: text, version: text, source_path: text, config: SnpmConfig):
    """Copy package tarball to cache."""
    val cache_dir = "{config.cache_dir}/{name}/{version}"
    rt_mkdir("{config.cache_dir}/{name}", 0o755)
    rt_mkdir(cache_dir, 0o755)
    extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
    rt_process_run("cp", [source_path, "{cache_dir}/{name}-{version}.spk"])

fn cache_clean(config: SnpmConfig):
    """Remove all cached packages."""
    if rt_file_exists(config.cache_dir):
        rt_file_delete(config.cache_dir)
        print "snpm: cache cleared"
    else:
        print "snpm: cache already empty"

fn cache_info(config: SnpmConfig):
    """Show cache information."""
    print "Cache directory: {config.cache_dir}"
    if not rt_file_exists(config.cache_dir):
        print "Cache is empty"
        return
    val entries_opt = rt_file_list_dir(config.cache_dir)
    if entries_opt == nil:
        print "Cannot read cache directory: {config.cache_dir}"
        return
    val entries = entries_opt.unwrap()
    print "Cached packages: {entries.len()}"
    var i = 0
    while i < entries.len():
        print "  {entries[i]}"
        i = i + 1
