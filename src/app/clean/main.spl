# `simple clean <flags>` — manual + automatic temp/cache cleanup.
#
# Plan:     doc/03_plan/infra/tooling/simple_clean_plan.md
# Research: doc/01_research/infra/tooling/cache_temp_cleanup_survey.md
#
# Manual:
#   simple clean [--build] [--cargo] [--qemu-images] [--temp] [--all] [--dry-run]
#   Sizes are printed per target before deletion. --dry-run lists but deletes
#   nothing. No target flag -> usage + current sizes, exit 0.
#
# Auto:
#   auto_clean_on_build_start() is called at the top of `simple build`
#   (src/app/build/cli_entry.spl handle_build) ONLY — never on test/run hot
#   paths. Cheap threshold probe first; full sweep only when the SAFE cache
#   total exceeds SIMPLE_CACHE_MAX_GB (default 20). Deletes SAFE entries
#   oldest-first (LRU by mtime) down to 80% of the cap, prints one summary
#   line. OPT-IN: runs only when SIMPLE_AUTO_CLEAN=1 — on this repo the
#   SAFE class currently holds ~286G including 70G of bootstrap artifacts,
#   so an on-by-default sweep would delete high-rebuild-cost state under
#   every parallel session on first build. Fail-open: any stat/du error
#   skips the sweep — auto-clean must never block a build.
#
# Safety: hardcoded NEVER-TOUCH prefixes (.spipe/**, bin/release/**, doc/**,
# .git/**, .jj/**, src/** except src/compiler_rust/target/**) are rejected
# even when passed explicitly, and every delete path must lexically resolve
# (., .., //) inside an allowed root. `git gc` is never invoked (jj-colocated
# repo — see the research doc).

use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{
    env_get, env_set, file_exists, file_delete, file_size, is_dir,
    dir_list, dir_remove, shell_output_trimmed, cwd, time_now_unix_micros
}
use std.nogc_sync_mut.io.file_ops.{file_modified_time}

# -----------------------------------------------------------------------------
# Pure path helpers (unit-tested in test/01_unit/app/clean/clean_spec.spl)
# -----------------------------------------------------------------------------

# Lexically resolve `p` against `base` (used when p is relative) and collapse
# ".", ".." and "//" segments. No symlink resolution — combined with the
# hardcoded never-touch prefixes this is the containment gate for deletion.
fn normalize_path(base: text, p: text) -> text:
    val joined = if p.starts_with("/"): p else: base + "/" + p
    val parts = joined.split("/")
    var out: [text] = []
    var i = 0
    while i < parts.len():
        val seg = parts[i]
        if seg == "" or seg == ".":
            i = i + 1
        elif seg == "..":
            if out.len() > 0:
                out = out[0:out.len() - 1]
            i = i + 1
        else:
            out.push(seg)
            i = i + 1
    var res = ""
    var j = 0
    while j < out.len():
        res = res + "/" + out[j]
        j = j + 1
    if res == "":
        return "/"
    res

fn _is_prefix_dir(path: text, prefix: text) -> bool:
    path == prefix or path.starts_with(prefix + "/")

# rel is a repo-relative path. Hardcoded NEVER-TOUCH list.
fn is_never_touch(rel: text) -> bool:
    if _is_prefix_dir(rel, ".spipe"):
        return true
    if _is_prefix_dir(rel, "bin/release"):
        return true
    if _is_prefix_dir(rel, "doc"):
        return true
    if _is_prefix_dir(rel, ".git"):
        return true
    if _is_prefix_dir(rel, ".jj"):
        return true
    if _is_prefix_dir(rel, "src"):
        # The single carve-out: cargo build cache lives under src/.
        return not _is_prefix_dir(rel, "src/compiler_rust/target")
    false

# Containment gate. `roots` entries ending in "_" are treated as filename
# prefixes (e.g. "/tmp/simple_"); everything else as directory roots.
fn can_delete_with_roots(path: text, repo_root: text, roots: [text]) -> bool:
    val abs = normalize_path(repo_root, path)
    if abs == repo_root:
        return false
    if abs.starts_with(repo_root + "/"):
        val rel = abs.substring(repo_root.len() + 1)
        if is_never_touch(rel):
            return false
    var ok = false
    var i = 0
    while i < roots.len():
        val r = roots[i]
        if r.ends_with("_"):
            if abs.starts_with(r):
                ok = true
        elif _is_prefix_dir(abs, r):
            ok = true
        i = i + 1
    ok

# LRU selection: indices into paths/sizes/mtimes, oldest mtime first, until
# the running total drops to <= target_bytes. Pure — no filesystem access.
fn lru_delete_set(mtimes: [i64], sizes: [i64], total_bytes: i64, target_bytes: i64) -> [i64]:
    var remaining = total_bytes
    var picked: [i64] = []
    var used: [bool] = []
    var i = 0
    while i < mtimes.len():
        used.push(false)
        i = i + 1
    while remaining > target_bytes:
        var best = -1
        var j = 0
        while j < mtimes.len():
            if not used[j]:
                if best < 0 or mtimes[j] < mtimes[best]:
                    best = j
            j = j + 1
        if best < 0:
            break
        used[best] = true
        picked.push(best)
        remaining = remaining - sizes[best]
    picked

# Threshold math (pure).
fn parse_cap_gb(raw: text) -> i64:
    var gb = 20
    if raw != "":
        val parsed = raw.to_i64()
        if parsed > 0:
            gb = parsed
    gb

fn cache_cap_bytes() -> i64:
    parse_cap_gb(env_get("SIMPLE_CACHE_MAX_GB")) * 1073741824

fn auto_clean_target_bytes(cap: i64) -> i64:
    (cap / 10) * 8

fn auto_clean_enabled(env_val: text) -> bool:
    # Opt-in, not opt-out: unset/0/"" all disable (see header safety note).
    env_val == "1"

# -----------------------------------------------------------------------------
# Deletion (guarded)
# -----------------------------------------------------------------------------

# Delete each path after the containment gate. Returns the count actually
# deleted (always 0 under dry_run). Refusals are printed, never fatal.
fn delete_paths(paths: [text], repo_root: text, roots: [text], dry_run: bool) -> i64:
    var deleted = 0
    var i = 0
    while i < paths.len():
        val abs = normalize_path(repo_root, paths[i])
        if not can_delete_with_roots(paths[i], repo_root, roots):
            print "clean: REFUSED (never-touch or outside allowed roots): {abs}"
        elif dry_run:
            print "clean: would delete {abs}"
        elif is_dir(abs):
            if dir_remove(abs, true):
                deleted = deleted + 1
                print "clean: deleted {abs}"
        elif file_exists(abs):
            if file_delete(abs):
                deleted = deleted + 1
                print "clean: deleted {abs}"
        i = i + 1
    deleted

# -----------------------------------------------------------------------------
# Target enumeration
# -----------------------------------------------------------------------------

fn _du_bytes(path: text) -> i64:
    # Fail-open: 0 on any error.
    val out = shell_output_trimmed("du -sb '" + path + "' 2>/dev/null | cut -f1", "0")
    val n = out.to_i64()
    if n > 0: n else: 0

fn _du_human(path: text) -> text:
    shell_output_trimmed("du -sh '" + path + "' 2>/dev/null | cut -f1", "0")

fn _repo_allowed_roots(root: text) -> [text]:
    var roots: [text] = []
    roots.push(root + "/build")
    roots.push(root + "/src/compiler_rust/target")
    roots.push(root + "/target")
    roots.push("/tmp/simple_")
    roots.push("/tmp/spl_")
    roots

# build/* first-level entries, excluding build/freebsd (kept for --qemu-images).
fn _build_entries(root: text) -> [text]:
    var out: [text] = []
    val names = dir_list(root + "/build")
    var i = 0
    while i < names.len():
        val n = names[i]
        if n != "freebsd" and n != "." and n != "..":
            out.push(root + "/build/" + n)
        i = i + 1
    out

fn _cargo_entries(root: text) -> [text]:
    var out: [text] = []
    out.push(root + "/src/compiler_rust/target/debug")
    out.push(root + "/src/compiler_rust/target/release")
    out.push(root + "/target")
    out

fn _qemu_entries(root: text) -> [text]:
    var out: [text] = []
    val base = root + "/build/freebsd"
    val names = dir_list(base)
    var i = 0
    while i < names.len():
        val n = names[i]
        if n == "vm" or n.contains(".qcow2"):
            out.push(base + "/" + n)
        i = i + 1
    out

# /tmp/simple_* and /tmp/spl_* older than 24h (grace period for live sessions).
fn _temp_entries() -> [text]:
    var out: [text] = []
    val cutoff = time_now_unix_micros() / 1000000 - 86400
    val names = dir_list("/tmp")
    var i = 0
    while i < names.len():
        val n = names[i]
        if n.starts_with("simple_") or n.starts_with("spl_"):
            val p = "/tmp/" + n
            val mt = file_modified_time(p)
            if mt > 0 and mt < cutoff:
                out.push(p)
        i = i + 1
    out

# -----------------------------------------------------------------------------
# Auto mode — called from `simple build` start only (handle_build)
# -----------------------------------------------------------------------------

fn auto_clean_on_build_start() -> i64:
    if not auto_clean_enabled(env_get("SIMPLE_AUTO_CLEAN")):
        return 0
    val root = cwd()
    if not is_dir(root + "/build"):
        return 0  # fail-open: not a repo root / nothing tracked
    val cap = cache_cap_bytes()
    val total = _du_bytes(root + "/build") + _du_bytes(root + "/src/compiler_rust/target")
    if total <= 0:
        return 0  # fail-open: probe failed
    if total <= cap:
        return 0
    # Sweep: SAFE first-level entries, oldest-first, down to 80% of cap.
    var entries = _build_entries(root)
    val cargo = _cargo_entries(root)
    var c = 0
    while c < cargo.len():
        entries.push(cargo[c])
        c = c + 1
    var sizes: [i64] = []
    var mtimes: [i64] = []
    var i = 0
    while i < entries.len():
        sizes.push(_du_bytes(entries[i]))
        mtimes.push(file_modified_time(entries[i]))
        i = i + 1
    val picked = lru_delete_set(mtimes, sizes, total, auto_clean_target_bytes(cap))
    val roots = _repo_allowed_roots(root)
    var freed = 0
    var count = 0
    var k = 0
    while k < picked.len():
        val idx = picked[k]
        var one: [text] = []
        one.push(entries[idx])
        if delete_paths(one, root, roots, false) > 0:
            freed = freed + sizes[idx]
            count = count + 1
        k = k + 1
    val freed_gb = freed / 1073741824
    val total_gb = total / 1073741824
    val now_gb = (total - freed) / 1073741824
    print "auto-clean: freed {freed_gb} GB ({count} entries, oldest-first), cache {total_gb} -> {now_gb} GB"
    0

# -----------------------------------------------------------------------------
# Manual CLI
# -----------------------------------------------------------------------------

fn _print_usage(root: text):
    val build_sz = _du_human(root + "/build")
    val cargo_sz = _du_human(root + "/src/compiler_rust/target")
    val qemu_sz = _du_human(root + "/build/freebsd")
    print "Usage: simple clean [--build] [--cargo] [--qemu-images] [--temp] [--all] [--dry-run]"
    print ""
    print "Current sizes:"
    print "  --build        build/ (except build/freebsd)   {build_sz}"
    print "  --cargo        src/compiler_rust/target, target {cargo_sz}"
    print "  --qemu-images  build/freebsd images/overlays    {qemu_sz}"
    print "  --temp         /tmp/simple_*, /tmp/spl_* (>24h)"
    print ""
    print "Never touched: .spipe/, bin/release/, doc/, src/ (except src/compiler_rust/target/), .git/, .jj/"
    print "Auto mode: opt-in via SIMPLE_AUTO_CLEAN=1; runs at `simple build` start; SIMPLE_CACHE_MAX_GB (default 20)."

fn _clean_target(label: text, entries: [text], root: text, roots: [text], dry_run: bool) -> i64:
    # Print target size before deletion, then act.
    var total = 0
    var i = 0
    while i < entries.len():
        total = total + _du_bytes(entries[i])
        i = i + 1
    val gb100 = total / 10737418  # hundredths of a GB
    val whole = gb100 / 100
    val frac = gb100 % 100
    print "clean: target {label}: {entries.len()} entries, {whole}.{frac} GB"
    delete_paths(entries, root, roots, dry_run)

fn main() -> i64:
    val args = get_cli_args()
    val root = cwd()
    var do_build = false
    var do_cargo = false
    var do_qemu = false
    var do_temp = false
    var dry_run = false
    var i = 0
    while i < args.len():
        val a = args[i]
        if a == "--build":
            do_build = true
        elif a == "--cargo":
            do_cargo = true
        elif a == "--qemu-images":
            do_qemu = true
        elif a == "--temp":
            do_temp = true
        elif a == "--all":
            do_build = true
            do_cargo = true
            do_qemu = true
            do_temp = true
        elif a == "--dry-run":
            dry_run = true
        else:
            print "clean: unknown argument: {a}"
            _print_usage(root)
            return 1
        i = i + 1
    if not (do_build or do_cargo or do_qemu or do_temp):
        _print_usage(root)
        return 0
    val roots = _repo_allowed_roots(root)
    if do_build:
        _clean_target("--build", _build_entries(root), root, roots, dry_run)
    if do_cargo:
        _clean_target("--cargo", _cargo_entries(root), root, roots, dry_run)
    if do_qemu:
        _clean_target("--qemu-images", _qemu_entries(root), root, roots, dry_run)
    if do_temp:
        _clean_target("--temp", _temp_entries(), root, roots, dry_run)
    0
