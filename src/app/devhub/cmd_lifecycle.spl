# codex-impl
# Typed lifecycle inspection and observe-only planning command.

use app.io.mod.{file_exists, file_read}
use app.sj.lifecycle_policy.{parse_canonical_lifecycle_vcs_policy}
use app.devhub.version_manifest.{parse_version_manifest, version_undeclared_consumers, version_render_plan, version_explain}
use std.scv.lifecycle.store.{lifecycle_store_probe}
use std.file_system.{dir_walk_files}

fn _lifecycle_json(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")

fn _projection_version(path: text) -> text:
    if not file_exists(path):
        return ""
    val payload = file_read(path).trim()
    if path.ends_with(".spl"):
        var previous = ""
        for raw in payload.split("\n"):
            val line = raw.trim()
            if line == "" or line.starts_with("#"):
                continue
            val context = (previous + " " + line).to_lower()
            val first_quote = line.index_of("\"")
            val last_quote = line.last_index_of("\"")
            if context.contains("version") and first_quote >= 0 and last_quote > first_quote:
                var candidate = line[first_quote + 1:last_quote]
                if candidate.starts_with("Simple v"):
                    candidate = candidate[8:]
                if candidate != "" and candidate.contains("."):
                    return candidate
            previous = line
        return ""
    if not payload.contains("\n") and not payload.contains(":"):
        return payload
    for raw in payload.split("\n"):
        val line = raw.trim()
        if line.starts_with("version:"):
            return line[line.index_of(":") + 1:].trim().replace("\"", "")
    ""

fn _payload_declares_product_version(payload: text, semver: text) -> bool:
    var previous = ""
    for raw in payload.split("\n"):
        val context = (previous + " " + raw).to_lower()
        if context.contains("version") and raw.contains(semver):
            return true
        previous = raw
    false

fn _projection_matches(path: text, semver: text) -> bool:
    if not file_exists(path):
        return false
    _projection_version(path) == semver

fn lifecycle_projection_version(path: text) -> text:
    _projection_version(path)

fn lifecycle_capabilities_json() -> text:
    '{"output_version":"devhub/v1","status":"ok","mutation":"disabled-by-default","domains":["change","review","feature","task","release","sync"],"operations":["inspect","policy-check","dry-run"],"provider_semantics":"capability-explicit"}'

fn lifecycle_policy_json(path: text) -> (text, i64):
    if not file_exists(path):
        return ('{"output_version":"devhub/v1","status":"rejected","code":"POLICY_NOT_FOUND","path":"' + _lifecycle_json(path) + '"}', 1)
    val policy = parse_canonical_lifecycle_vcs_policy(file_read(path))
    if not policy.valid:
        return ('{"output_version":"devhub/v1","status":"rejected","code":"POLICY_INVALID","message":"' + _lifecycle_json(policy.error) + '"}', 1)
    ('{"output_version":"devhub/v1","status":"ok","schema":"' + policy.schema + '","protected_ref_count":' + policy.refs.len().to_text() + ',"mutation":"observe-only"}', 0)

fn lifecycle_domain_known(domain: text) -> bool:
    domain == "change" or domain == "review" or domain == "feature" or domain == "task" or domain == "release" or domain == "sync"

fn lifecycle_inspect_json(domain: text, entity_id: text, idempotency_key: text, explain: bool) -> (text, i64):
    if not lifecycle_domain_known(domain):
        return ('{"output_version":"devhub/v1","status":"rejected","code":"DOMAIN_UNSUPPORTED","domain":"' + _lifecycle_json(domain) + '"}', 2)
    if entity_id == "":
        return ('{"output_version":"devhub/v1","status":"rejected","code":"ENTITY_ID_REQUIRED","domain":"' + _lifecycle_json(domain) + '"}', 2)
    val store_kind = if domain == "sync": "sync_conflict" else: domain
    val stored = lifecycle_store_probe(".", store_kind, entity_id)
    if stored.status == "corrupt" or stored.status == "rejected":
        return ('{"output_version":"devhub/v1","status":"rejected","code":"LIFECYCLE_STORE_INTEGRITY","message":"' + _lifecycle_json(stored.error) + '"}', 1)
    val detail = if explain: ',"explain":"inspection is local and read-only; remote projection requires an explicit binding"' else: ""
    val status = if stored.status == "found": "found" else: "unbound"
    val digest = if stored.status == "found": ',"record_digest":"' + stored.record.?.digest + '"' else: ""
    ('{"output_version":"devhub/v1","status":"' + status + '","domain":"' + _lifecycle_json(domain) + '","entity_id":"' + _lifecycle_json(entity_id) + '","idempotency_key":"' + _lifecycle_json(idempotency_key) + '","mutation":"none"' + digest + detail + '}', 0)

fn handle_lifecycle(args: [text]) -> i64:
    if args.len() == 0 or args[0] == "capabilities":
        print lifecycle_capabilities_json()
        return 0
    if args[0] == "policy-check":
        val path = if args.len() > 1: args[1] else: ".spipe/policy/vcs.sdn"
        val (payload, code) = lifecycle_policy_json(path)
        print payload
        return code
    if args[0] == "version-check":
        val path = if args.len() > 1: args[1] else: "release/version.sdn"
        if not file_exists(path):
            print '{"output_version":"devhub/v1","status":"rejected","code":"VERSION_MANIFEST_NOT_FOUND"}'
            return 1
        val manifest = parse_version_manifest(file_read(path))
        if not manifest.valid:
            print '{"output_version":"devhub/v1","status":"rejected","code":"VERSION_MANIFEST_INVALID","message":"' + _lifecycle_json(manifest.error) + '"}'
            return 1
        var discovered = ["VERSION"]
        for consumer in dir_walk_files("src"):
            if (consumer.ends_with("/simple.sdn") and _projection_version(consumer) == manifest.semver) or (consumer.ends_with(".spl") and _payload_declares_product_version(file_read(consumer), manifest.semver)):
                discovered.push(consumer)
        val undeclared = version_undeclared_consumers(manifest, discovered)
        if undeclared.len() > 0:
            print '{"output_version":"devhub/v1","status":"rejected","code":"VERSION_CONSUMER_UNDECLARED","paths":"' + _lifecycle_json(undeclared.join(",")) + '"}'
            return 1
        var drift: [text] = []
        for projection in manifest.projections:
            if not _projection_matches(projection, manifest.semver):
                drift.push(projection)
        if drift.len() > 0:
            print '{"output_version":"devhub/v1","status":"rejected","code":"VERSION_PROJECTION_DRIFT","paths":"' + _lifecycle_json(drift.join(",")) + '"}'
            return 1
        print '{"output_version":"devhub/v1","status":"ok","schema":"' + _lifecycle_json(manifest.schema) + '","product":"' + _lifecycle_json(manifest.product) + '","semver":"' + _lifecycle_json(manifest.semver) + '","line":"' + _lifecycle_json(manifest.line) + '","projection_count":' + manifest.projections.len().to_text() + '}'
        return 0
    if args[0] == "version-explain":
        val path = if args.len() > 1: args[1] else: "release/version.sdn"
        if not file_exists(path):
            print '{"output_version":"devhub/v1","status":"rejected","code":"VERSION_MANIFEST_NOT_FOUND"}'
            return 1
        val manifest = parse_version_manifest(file_read(path))
        print '{"output_version":"devhub/v1","status":"' + (if manifest.valid: "ok" else: "rejected") + '","explain":"' + _lifecycle_json(version_explain(manifest)) + '","render_count":' + version_render_plan(manifest).len().to_text() + '}'
        return if manifest.valid: 0 else: 1
    if args[0] == "inspect":
        val domain = if args.len() > 1: args[1] else: ""
        val entity_id = if args.len() > 2: args[2] else: ""
        val idempotency_key = if args.len() > 3: args[3] else: ""
        val (payload, code) = lifecycle_inspect_json(domain, entity_id, idempotency_key, true)
        print payload
        return code
    if args[0] == "dry-run":
        print '{"output_version":"devhub/v1","status":"rejected","code":"DRY_RUN_INPUT_REQUIRED","message":"use the typed SJ IntegrateRequest API with exact revision evidence"}'
        return 2
    print '{"output_version":"devhub/v1","status":"rejected","code":"UNKNOWN_LIFECYCLE_COMMAND"}'
    1

export lifecycle_capabilities_json, lifecycle_policy_json, lifecycle_domain_known, lifecycle_inspect_json, lifecycle_projection_version, handle_lifecycle
