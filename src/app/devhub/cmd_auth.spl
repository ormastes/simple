# ITF CLI — Auth commands
#
# Subcommands: login, status, logout
# Manages credentials for Confluence and Jira

use app.devhub.config.{ItfConfig, load_config, save_config, load_auth_token, save_auth_token, config_dir}
use app.devhub.auth.{check_confluence_auth, check_jira_auth}
use app.devhub.atlassian_site.{ATLASSIAN_AUTH_BASIC, ATLASSIAN_AUTH_BEARER, atlassian_normalize_auth, atlassian_deployment_warning}
use app.devhub.flags.{_extract_flag, _has_flag}
use app.devhub.output.{print_error, print_success, print_info, print_warning, should_use_color}
use app.ui.render.ansi.{ansi_green, ansi_red, ansi_bold, ansi_reset}
use std.nogc_sync_mut.file_system.file_ops.{file_exists, file_write_text, file_read_text}
use std.nogc_sync_mut.io.process_ops.{process_run}


fn handle_auth(args: [text]) -> i64:
    """Dispatch auth subcommands."""
    if args.len() == 0:
        _print_auth_help()
        return 0

    val action = args[0]
    val action_args = if args.len() > 1: args[1:] else: []

    match action:
        "login":
            _auth_login(action_args)
        "status":
            _auth_status(action_args)
        "logout":
            _auth_logout(action_args)
        "-h" | "--help" | "help":
            _print_auth_help()
            0
        _:
            print_error("unknown auth command: {action}")
            _print_auth_help()
            1


fn _auth_login(args: [text]) -> i64:
    """Login to a provider.

    Usage:
      itf auth login --confluence --url URL [--user EMAIL] --token TOKEN [--deployment D] [--auth A]
      itf auth login --jira
    """
    val is_confluence = _has_flag(args, "--confluence")
    val is_jira = _has_flag(args, "--jira")

    if not is_confluence and not is_jira:
        print_error("specify --confluence or --jira")
        return 1

    if is_confluence:
        return _login_confluence(args)
    if is_jira:
        return _login_jira(args)
    1


fn _login_confluence(args: [text]) -> i64:
    """Setup Confluence authentication."""
    val url = _extract_flag(args, "--url", "")
    val user = _extract_flag(args, "--user", "")
    val token = _extract_flag(args, "--token", "")
    val deployment = _extract_flag(args, "--deployment", "")
    val auth = _extract_flag(args, "--auth", "")

    if url == "" and user == "" and token == "":
        if check_confluence_auth(load_config()):
            print_success("Confluence token already configured; using REST directly (no login needed).")
            return 0
    val err = _token_login_error(url, user, token, auth)
    if err != "":
        print_error(err)
        if token == "":
            print "Generate a token at: https://id.atlassian.com/manage-profile/security/api-tokens"
        return 1

    # Ensure config dir exists
    _ensure_config_dir()

    # Save config
    var config = load_config()
    val new_deployment = if deployment != "": deployment else: config.confluence_deployment
    val new_auth = if auth != "": auth else: config.confluence_auth
    val new_user = if user != "": user else: config.confluence_user
    config = ItfConfig(
        confluence_url: url,
        confluence_user: new_user,
        confluence_default_space: config.confluence_default_space,
        confluence_target: config.confluence_target,
        confluence_gateway_url: config.confluence_gateway_url,
        confluence_headers: config.confluence_headers,
        jira_url: config.jira_url,
        jira_acli_path: config.jira_acli_path,
        jira_email: config.jira_email,
        default_output: config.default_output,
        color_mode: config.color_mode,
        editor_override: config.editor_override,
        pager_override: config.pager_override,
        token_cmds: config.token_cmds,
        wiki_default_backend: config.wiki_default_backend,
        tasks_default_backend: config.tasks_default_backend,
        tasks_jira_done_status: config.tasks_jira_done_status,
        git_default_backend: config.git_default_backend,
        bb_workspace: config.bb_workspace,
        bb_repo: config.bb_repo,
        token_envs: config.token_envs,
        jira_deployment: config.jira_deployment, jira_auth: config.jira_auth,
        confluence_deployment: new_deployment, confluence_auth: new_auth,
        bb_url: config.bb_url, bb_deployment: config.bb_deployment, bb_project: config.bb_project,
        bb_auth: config.bb_auth, bb_user: config.bb_user
    )
    save_config(config)

    # Save token
    save_auth_token("confluence", token)

    print_success("Confluence REST token authentication configured.")
    print_info("URL", url)
    print_info("Deployment", if new_deployment != "": new_deployment else: "cloud")
    print_info("Auth", atlassian_normalize_auth(new_auth, ATLASSIAN_AUTH_BASIC))
    if user != "":
        print_info("User", user)
    0


fn _token_login_error(url: text, user: text, token: text, auth: text) -> text:
    """Validation for `auth login --confluence|--jira` token flags: url and
    token are required; a user/email is required unless auth is bearer (a
    Data Center PAT). Returns "" when valid, else the error message."""
    if url == "" or token == "":
        return "--url and --token are required for token (REST) auth"
    if user == "" and atlassian_normalize_auth(auth, ATLASSIAN_AUTH_BASIC) != ATLASSIAN_AUTH_BEARER:
        return "--user EMAIL is required with basic auth (use --auth bearer for a Data Center PAT)"
    ""


fn _login_jira(args: [text]) -> i64:
    """Configure Jira authentication.

    Usage:
      itf auth login --jira                                 # delegate to acli --web (skipped when a token exists)
      itf auth login --jira --acli                          # acli --web even when a token exists
      itf auth login --jira --url URL --user EMAIL --token TOKEN  # also wire
        the curl fallback (adapter_jira_curl) that acli lacks update/comment/
        transition verbs for; --url/--user/--token save jira.url, jira.email,
        and the jira auth token so it works even where acli falls short.
    """
    val url = _extract_flag(args, "--url", "")
    val user = _extract_flag(args, "--user", "")
    val token = _extract_flag(args, "--token", "")
    val deployment = _extract_flag(args, "--deployment", "")
    val auth = _extract_flag(args, "--auth", "")

    if url != "" or user != "" or token != "":
        val err = _token_login_error(url, user, token, auth)
        if err != "":
            print_error(err)
            return 1
        _ensure_config_dir()
        var config = load_config()
        val new_deployment = if deployment != "": deployment else: config.jira_deployment
        val new_auth = if auth != "": auth else: config.jira_auth
        val new_email = if user != "": user else: config.jira_email
        config = ItfConfig(
            confluence_url: config.confluence_url,
            confluence_user: config.confluence_user,
            confluence_default_space: config.confluence_default_space,
            confluence_target: config.confluence_target,
            confluence_gateway_url: config.confluence_gateway_url,
            confluence_headers: config.confluence_headers,
            jira_url: url,
            jira_acli_path: config.jira_acli_path,
            jira_email: new_email,
            default_output: config.default_output,
            color_mode: config.color_mode,
            editor_override: config.editor_override,
            pager_override: config.pager_override,
            token_cmds: config.token_cmds,
            wiki_default_backend: config.wiki_default_backend,
            tasks_default_backend: config.tasks_default_backend,
            tasks_jira_done_status: config.tasks_jira_done_status,
            git_default_backend: config.git_default_backend,
            bb_workspace: config.bb_workspace,
            bb_repo: config.bb_repo,
            token_envs: config.token_envs,
            jira_deployment: new_deployment, jira_auth: new_auth,
            confluence_deployment: config.confluence_deployment, confluence_auth: config.confluence_auth,
            bb_url: config.bb_url, bb_deployment: config.bb_deployment, bb_project: config.bb_project,
            bb_auth: config.bb_auth, bb_user: config.bb_user
        )
        save_config(config)
        save_auth_token("jira", token)
        print_success("Jira REST token authentication configured (no acli login needed).")
        print_info("URL", url)
        print_info("Deployment", if new_deployment != "": new_deployment else: "cloud")
        print_info("Auth", atlassian_normalize_auth(new_auth, ATLASSIAN_AUTH_BASIC))
        if user != "":
            print_info("User", user)
        return 0

    val config = load_config()
    # A configured token means REST, so no login — unless --acli explicitly
    # asks to (re)run the acli browser login anyway (e.g. Cloud acli session).
    if check_jira_auth(config) and not _has_flag(args, "--acli"):
        print_success("Jira token already configured; using REST directly (no acli login). Use --acli to run the acli login anyway.")
        return 0
    val acli = config.jira_acli_path

    # Delegate auth to acli. No `which` preflight: it is absent on native
    # Windows and misses .cmd shims; a missing acli fails the call itself.
    print "Delegating to acli for Jira authentication..."
    val (_, stderr, code) = process_run(acli, ["jira", "auth", "login", "--web"])
    if code != 0:
        print_error("acli auth failed (acli_path '{acli}'; install Atlassian CLI or set jira.acli_path): {stderr}")
        return 1

    print_success("Jira authentication configured via acli.")
    0


fn _auth_status(args: [text]) -> i64:
    """Show authentication status for all providers."""
    val config = load_config()
    val use_color = should_use_color()
    val quiet = _has_flag(args, "--quiet") or _has_flag(args, "--silent")

    print "Authentication status:"
    print ""

    # Confluence
    val conf_ok = check_confluence_auth(config)
    if use_color:
        if conf_ok:
            print "  {ansi_green()}●{ansi_reset()} Confluence: {ansi_bold()}authenticated{ansi_reset()}"
        else:
            print "  {ansi_red()}●{ansi_reset()} Confluence: not configured"
    else:
        if conf_ok:
            print "  ● Confluence: authenticated"
        else:
            print "  ○ Confluence: not configured"

    if conf_ok:
        print "    URL:  {config.confluence_url}"
        print "    User: {config.confluence_user}"
        val warning = atlassian_deployment_warning("Confluence", config.confluence_url, config.confluence_deployment, quiet)
        if warning != "":
            print_warning(warning)

    print ""

    # Jira
    val jira_ok = config.jira_url != ""
    if use_color:
        if jira_ok:
            print "  {ansi_green()}●{ansi_reset()} Jira: {ansi_bold()}configured{ansi_reset()}"
        else:
            print "  {ansi_red()}●{ansi_reset()} Jira: not configured"
    else:
        if jira_ok:
            print "  ● Jira: configured"
        else:
            print "  ○ Jira: not configured"

    if jira_ok:
        print "    URL:  {config.jira_url}"
        print "    CLI:  {config.jira_acli_path}"
        val warning = atlassian_deployment_warning("Jira", config.jira_url, config.jira_deployment, quiet)
        if warning != "":
            print_warning(warning)

    0


fn _auth_logout(args: [text]) -> i64:
    """Remove stored credentials."""
    val is_confluence = _has_flag(args, "--confluence")
    val is_jira = _has_flag(args, "--jira")

    if not is_confluence and not is_jira:
        # Logout all
        save_auth_token("confluence", "")
        save_auth_token("jira", "")
        print_success("All credentials removed.")
        return 0

    if is_confluence:
        save_auth_token("confluence", "")
        print_success("Confluence credentials removed.")
    if is_jira:
        save_auth_token("jira", "")
        print_success("Jira credentials removed.")

    0


fn _ensure_config_dir():
    """Create config directory if it doesn't exist."""
    val dir = config_dir()
    # Use mkdir -p via process_run
    process_run("mkdir", ["-p", dir])


fn _print_auth_help():
    """Print auth subcommand help."""
    print "Usage: itf auth <command> [flags]"
    print ""
    print "Commands:"
    print "  login    Configure authentication"
    print "  status   Show authentication status"
    print "  logout   Remove stored credentials"
    print ""
    print "Login examples:"
    print "  itf auth login --confluence --url https://company.atlassian.net/wiki --user email --token TOKEN"
    print "  itf auth login --confluence --url https://wiki.corp:8090/confluence --deployment datacenter --auth bearer --token PAT"
    print "  itf auth login --jira --url https://jira.corp:8443/jira --deployment datacenter --auth bearer --token PAT"
    print "  itf auth login --jira --url https://company.atlassian.net --user email --token API_TOKEN"
    print "  itf auth login --jira            # acli --web login, only when no jira token is configured"
    print "  itf auth login --jira --acli     # run the acli --web login even when a jira token exists"
    print ""
    print "Flags:"
    print "  --confluence   Target Confluence"
    print "  --jira         Target Jira (REST with a token; acli login otherwise)"
    print "  --url URL      Provider base URL (custom port/context path allowed)"
    print "  --user EMAIL   Email/username (basic auth only)"
    print "  --token TOKEN  API token (Cloud) or personal access token (Data Center)"
    print "  --deployment D cloud (default) | datacenter"
    print "  --auth A       basic (default) | bearer"
    print "  --acli         Jira: force the acli --web login even if a token is configured"
    print "  --quiet, --silent  Suppress deployment-shape warnings from auth status"
