# codex-impl
# Provider capability records preserve semantic gaps instead of flattening them.

use std.scv.lifecycle.model.{LifecycleResult, lifecycle_ok, lifecycle_error}

struct ReviewCapabilities:
    create_review: bool
    pre_commit_review: bool
    inline_threads: bool
    approve: bool
    request_changes: bool
    patchsets: bool
    dependent_changes: bool
    merge_queue: bool

struct ProviderCapabilities:
    provider_id: text
    api_version: text
    source: bool
    review: ReviewCapabilities?
    task: bool
    knowledge: bool
    release: bool
    automation: bool

fn provider_review_operation(capabilities: ProviderCapabilities, operation: text, strict_sync: bool) -> LifecycleResult:
    if capabilities.review == nil:
        return lifecycle_error("PROVIDER_REVIEW_UNSUPPORTED", "provider has no review capability")
    val review = capabilities.review.?
    val supported =
        (operation == "create" and review.create_review) or
        (operation == "approve" and review.approve) or
        (operation == "request_changes" and review.request_changes) or
        (operation == "publish_patchset" and review.patchsets) or
        (operation == "enqueue" and review.merge_queue)
    if supported:
        return lifecycle_ok("provider_operation_supported", capabilities.provider_id)
    if operation == "request_changes" and not strict_sync:
        return lifecycle_ok("local_blocking_remote_comment_non_equivalent", capabilities.provider_id)
    lifecycle_error("PROVIDER_SEMANTIC_GAP", "provider cannot represent lifecycle operation: " + operation)

export ReviewCapabilities, ProviderCapabilities, provider_review_operation
