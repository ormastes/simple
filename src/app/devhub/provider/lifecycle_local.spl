# The repository's own .scv/lifecycle store, exposed as a LifecycleProvider.
# This is the in-repo `local_scv` adapter named in
# doc/01_research/app/tools/scv/scv_jj_git_unified_release_review_work_item_2026-08-25.md:662.
# It has no transport and no credentials: every capability below is true only
# when a typed entity codec in src/lib/scv/lifecycle/entity_codec.spl can
# actually represent it, so a semantic gap stays a gap instead of being claimed.
# @ac: AC-15

use app.devhub.provider.lifecycle_capability.{ReviewCapabilities, ProviderCapabilities}
use app.devhub.provider.lifecycle_provider.{LifecycleProvider}

class LocalScvProvider:
    """The local SCV lifecycle store acting as its own provider."""

impl LifecycleProvider for LocalScvProvider:
    fn provider_id() -> text:
        "local_scv"

    fn discover_capabilities() -> ProviderCapabilities:
        ProviderCapabilities(
            provider_id: "local_scv",
            api_version: "scv-lifecycle/1",
            # revision_record carries tree ids, parents and aliases.
            source: true,
            review: ReviewCapabilities(
                # review_session_record / review_run_record exist.
                create_review: true,
                # Records are revision-keyed, never push-keyed.
                pre_commit_review: true,
                # Finding carries a SourceAnchor but there is no thread or
                # reply entity, so inline discussion cannot be represented.
                inline_threads: false,
                # approval_record exists.
                approve: true,
                # finding_record carries a state field.
                request_changes: true,
                # RevisionAliases.provider_patchsets exists.
                patchsets: true,
                # RevisionIdentity.parent_revision_ids exists.
                dependent_changes: true,
                # No queue entity exists locally.
                merge_queue: false
            ),
            # task_record exists.
            task: true,
            # No document or managed-region entity codec exists.
            knowledge: false,
            # release_record / release_candidate_record / release_line_record exist.
            release: true,
            # No webhook or trigger entity exists locally.
            automation: false
        )

fn local_scv_provider() -> LocalScvProvider:
    LocalScvProvider()

export LocalScvProvider, local_scv_provider
