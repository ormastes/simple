# codex-impl
# Canonical release/version manifest validation. Rendering stays a later explicit mutation.

use app.release.policy.{parse_release_version, check_version_channel}

struct VersionManifest:
    schema: text
    product: text
    semver: text
    line: text
    channel: text
    public_api_major: i64
    compiler_abi: i64
    bootstrap_protocol: i64
    package_format: i64
    scv_store_schema: i64
    scv_wire_protocol: i64
    devhub_provider_api: i64
    spipe_skill_api: i64
    release_manifest_schema: i64
    bootstrap_receipt_schema: i64
    projections: [text]
    valid: bool
    error: text

fn _version_value(line: text) -> text:
    val idx = line.index_of(":")
    if idx < 0:
        return ""
    line[idx + 1:].trim().replace("\"", "")

fn _semver_core_valid(version: text) -> bool:
    val core = version.split("-")[0]
    val parts = core.split(".")
    if parts.len() != 3:
        return false
    for part in parts:
        if part == "" or (part.len() > 1 and part.starts_with("0")) or (part.to_int() ?? -1) < 0:
            return false
    true

fn _prerelease_valid(version: text) -> bool:
    if not version.contains("-"):
        return true
    val split = version.split("-")
    if split.len() != 2 or split[1] == "" or split[1].starts_with(".") or split[1].ends_with(".") or split[1].contains(".."):
        return false
    val prerelease = split[1]
    for identifier in prerelease.split("."):
        if identifier.len() > 1 and identifier.starts_with("0") and (identifier.to_int() ?? -1) >= 0:
            return false
    var i = 0
    while i < prerelease.len():
        val code = prerelease.char_code_at(i)
        val alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
        val digit = code >= 48 and code <= 57
        if not alpha and not digit and code != 45 and code != 46:
            return false
        i = i + 1
    true

fn _manifest_shape_error(payload: text) -> text:
    var section = ""
    var seen_sections: [text] = []
    var seen_version: [text] = []
    var seen_compatibility: [text] = []
    var seen_projections: [text] = []
    val version_keys = ["schema", "product", "semver", "line", "channel"]
    val compatibility_keys = ["public_api_major", "compiler_abi", "bootstrap_protocol", "package_format", "scv_store_schema", "scv_wire_protocol", "devhub_provider_api", "spipe_skill_api", "release_manifest_schema", "bootstrap_receipt_schema"]
    for raw in payload.split("\n"):
        val item = raw.trim()
        if item == "":
            continue
        if not raw.starts_with(" "):
            if item != "version:" and item != "compatibility:" and item != "projections:":
                return "unknown top-level version manifest key"
            section = item[0:item.len() - 1]
            if seen_sections.contains(section):
                return "duplicate version manifest section: " + section
            seen_sections.push(section)
            continue
        if not raw.starts_with("  ") or raw.starts_with("   "):
            return "version manifest entries require exactly two-space indentation"
        if section == "projections":
            if not raw.starts_with("  - ") or item.len() <= 1:
                return "invalid version projection entry"
            val projection = item[1:].trim()
            if seen_projections.contains(projection):
                return "duplicate version projection: " + projection
            seen_projections.push(projection)
            continue
        val colon = item.index_of(":")
        if colon <= 0:
            return "version manifest field requires key and value"
        val key = item[0:colon]
        if section == "version":
            if not version_keys.contains(key):
                return "unknown version field: " + key
            if seen_version.contains(key):
                return "duplicate version field: " + key
            seen_version.push(key)
        elif section == "compatibility":
            if not compatibility_keys.contains(key):
                return "unknown compatibility field: " + key
            if seen_compatibility.contains(key):
                return "duplicate compatibility field: " + key
            seen_compatibility.push(key)
        else:
            return "version manifest field appears outside a declared section"
    if seen_sections.len() != 3 or seen_version.len() != version_keys.len() or seen_compatibility.len() != compatibility_keys.len():
        return "version manifest requires every closed-schema section and field exactly once"
    ""

fn parse_version_manifest(payload: text) -> VersionManifest:
    var schema = ""
    var product = ""
    var semver = ""
    var line = ""
    var channel = ""
    var public_api_major = -1
    var compiler_abi = -1
    var bootstrap_protocol = -1
    var package_format = -1
    var scv_store_schema = -1
    var scv_wire_protocol = -1
    var devhub_provider_api = -1
    var spipe_skill_api = -1
    var release_manifest_schema = -1
    var bootstrap_receipt_schema = -1
    var projections: [text] = []
    var in_compatibility = false
    var in_projections = false
    for raw in payload.split("\n"):
        val item = raw.trim()
        if item.starts_with("schema:"):
            schema = _version_value(item)
        elif item.starts_with("product:"):
            product = _version_value(item)
        elif item.starts_with("semver:"):
            semver = _version_value(item)
        elif item.starts_with("line:"):
            line = _version_value(item)
        elif item.starts_with("channel:"):
            channel = _version_value(item)
        elif item == "compatibility:":
            in_compatibility = true
            in_projections = false
        elif in_compatibility and item.starts_with("public_api_major:"):
            public_api_major = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("compiler_abi:"):
            compiler_abi = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("bootstrap_protocol:"):
            bootstrap_protocol = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("package_format:"):
            package_format = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("scv_store_schema:"):
            scv_store_schema = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("scv_wire_protocol:"):
            scv_wire_protocol = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("devhub_provider_api:"):
            devhub_provider_api = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("spipe_skill_api:"):
            spipe_skill_api = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("release_manifest_schema:"):
            release_manifest_schema = (_version_value(item).to_int() ?? -1)
        elif in_compatibility and item.starts_with("bootstrap_receipt_schema:"):
            bootstrap_receipt_schema = (_version_value(item).to_int() ?? -1)
        elif item == "projections:":
            in_compatibility = false
            in_projections = true
        elif in_projections and item.starts_with("-"):
            projections.push(item[1:].trim())
    val shape_error = _manifest_shape_error(payload)
    if shape_error != "":
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: shape_error)
    if schema != "simple-release-version/1":
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "unsupported or missing version schema")
    val strict_version = parse_release_version(semver)
    val strict_channel = check_version_channel(strict_version, channel)
    if product != "simple" or line == "" or channel == "" or not _semver_core_valid(semver) or not _prerelease_valid(semver) or strict_version.canonical != semver or not strict_channel.valid:
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "product, semver, line, or channel is invalid")
    if line != strict_version.line:
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "release line does not match semantic version")
    val semver_major = strict_version.canonical.split(".")[0].to_int() ?? -1
    if public_api_major != semver_major:
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "public API major does not match semantic version major")
    if public_api_major < 0 or compiler_abi < 0 or bootstrap_protocol < 0 or package_format < 0 or scv_store_schema < 0 or scv_wire_protocol < 0 or devhub_provider_api < 0 or spipe_skill_api < 0 or release_manifest_schema < 0 or bootstrap_receipt_schema < 0:
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "all compatibility dimensions are required and must be non-negative")
    if projections.len() == 0:
        return VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: false, error: "no declared version projections")
    VersionManifest(schema: schema, product: product, semver: semver, line: line, channel: channel, public_api_major: public_api_major, compiler_abi: compiler_abi, bootstrap_protocol: bootstrap_protocol, package_format: package_format, scv_store_schema: scv_store_schema, scv_wire_protocol: scv_wire_protocol, devhub_provider_api: devhub_provider_api, spipe_skill_api: spipe_skill_api, release_manifest_schema: release_manifest_schema, bootstrap_receipt_schema: bootstrap_receipt_schema, projections: projections, valid: true, error: "")

fn render_version_manifest(manifest: VersionManifest) -> text:
    "version:\n" +
    "  schema: " + manifest.schema + "\n" +
    "  product: " + manifest.product + "\n" +
    "  semver: " + manifest.semver + "\n" +
    "  line: " + manifest.line + "\n" +
    "  channel: " + manifest.channel + "\n\n" +
    "compatibility:\n" +
    "  public_api_major: " + manifest.public_api_major.to_text() + "\n" +
    "  compiler_abi: " + manifest.compiler_abi.to_text() + "\n" +
    "  bootstrap_protocol: " + manifest.bootstrap_protocol.to_text() + "\n" +
    "  package_format: " + manifest.package_format.to_text() + "\n" +
    "  scv_store_schema: " + manifest.scv_store_schema.to_text() + "\n" +
    "  scv_wire_protocol: " + manifest.scv_wire_protocol.to_text() + "\n" +
    "  devhub_provider_api: " + manifest.devhub_provider_api.to_text() + "\n" +
    "  spipe_skill_api: " + manifest.spipe_skill_api.to_text() + "\n" +
    "  release_manifest_schema: " + manifest.release_manifest_schema.to_text() + "\n" +
    "  bootstrap_receipt_schema: " + manifest.bootstrap_receipt_schema.to_text() + "\n\n" +
    "projections:\n" + [for projection in manifest.projections: "  - " + projection].join("\n") + "\n"

fn version_projection_drift(manifest: VersionManifest, projection_versions: [text]) -> [text]:
    var drift: [text] = []
    if projection_versions.len() != manifest.projections.len():
        drift.push("projection-count")
        return drift
    var i = 0
    while i < projection_versions.len():
        if projection_versions[i] != manifest.semver:
            drift.push(manifest.projections[i])
        i = i + 1
    drift

fn version_undeclared_consumers(manifest: VersionManifest, discovered_consumers: [text]) -> [text]:
    var undeclared: [text] = []
    for consumer in discovered_consumers:
        if not manifest.projections.contains(consumer):
            undeclared.push(consumer)
    undeclared

fn version_render_plan(manifest: VersionManifest) -> [text]:
    var plan: [text] = []
    for projection in manifest.projections:
        plan.push(projection + "=" + manifest.semver)
    plan

fn version_explain(manifest: VersionManifest) -> text:
    if not manifest.valid:
        return "invalid: " + manifest.error
    manifest.product + " " + manifest.semver + " on release/" + manifest.line + " (" + manifest.channel + "), " + manifest.projections.len().to_text() + " declared projections"

export VersionManifest, parse_version_manifest, version_projection_drift
export version_undeclared_consumers, version_render_plan, version_explain
export render_version_manifest
