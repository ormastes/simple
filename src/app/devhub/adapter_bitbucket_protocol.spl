# Bitbucket Cloud / Data Center wire protocol helpers.
# Pure URL, body, error and JSON functions; no dependency on the client adapter.

use std.json.{json_object_get, json_array_get, json_array_length, json_serialize}
use app.devhub.atlassian_site.{AtlassianSite, bitbucket_owner_url, bitbucket_pr_collection_url, bitbucket_repo_url, bitbucket_page_query}
use app.devhub.errors.{ItfError, ITF_ERR_AUTH, ITF_ERR_NOT_FOUND, ITF_ERR_API, ITF_ERR_CONFLICT, ITF_ERR_NETWORK}
use app.devhub.redaction.redact_devhub_diagnostic

val BB_OP_GENERAL = "general"
val BB_OP_MERGE = "merge"

# ============================================================================
# URL builders (pure — covered by unit tests)
# ============================================================================

#
# The `(ws, repo)` builders keep their Cloud-only signatures (and their
# byte-identical output) for existing callers and specs; the `_for` variants
# take the client's deployment shape and place `(workspace, slug)` on Cloud
# or `(PROJECT_KEY, slug)` on Server / Data Center:
#   Cloud  https://api.bitbucket.org/2.0/repositories/{ws}/{slug}/pullrequests
#   DC     {url}/rest/api/1.0/projects/{KEY}/repos/{slug}/pull-requests
# Named DC gaps (URLs only; not translated here): `statuses` is a separate
# build-status API on Server, `approve` is deprecated on REST 1.0 in favour
# of participants, pagination is `limit`/`start` + `isLastPage` (the `next`
# follow below stops after page 1), and PR JSON uses fromRef/toRef.

fn _bb_cloud_site() -> AtlassianSite:
    """The Cloud default shape (api.bitbucket.org/2.0) the `(ws, repo)` builders pin."""
    AtlassianSite.create("", "")


fn bb_pr_collection_url(ws: text, repo: text) -> text:
    """Build URL for the PR collection of a repo (Cloud shape)."""
    bb_pr_collection_url_for(_bb_cloud_site(), ws, repo)


fn bb_pr_url(ws: text, repo: text, pr_id: i64) -> text:
    """Build URL for an individual PR resource (Cloud shape)."""
    bb_pr_url_for(_bb_cloud_site(), ws, repo, pr_id)


fn bb_pr_sub_url(ws: text, repo: text, pr_id: i64, sub: text) -> text:
    """Build URL for a sub-resource of a PR (comments, approve, merge, statuses) (Cloud shape)."""
    bb_pr_sub_url_for(_bb_cloud_site(), ws, repo, pr_id, sub)


fn bb_repo_collection_url(ws: text) -> text:
    """Build URL for the repository collection of a workspace (Cloud shape)."""
    bitbucket_owner_url(_bb_cloud_site(), ws)


fn bb_repo_url(ws: text, repo: text) -> text:
    """Build URL for an individual repository resource (Cloud shape)."""
    bitbucket_repo_url(_bb_cloud_site(), ws, repo)


fn bb_pr_collection_url_for(site: AtlassianSite, owner: text, repo: text) -> text:
    """PR collection for (workspace|project key, slug) on the given deployment."""
    bitbucket_pr_collection_url(site, owner, repo)


fn bb_pr_url_for(site: AtlassianSite, owner: text, repo: text, pr_id: i64) -> text:
    bb_pr_collection_url_for(site, owner, repo) + "/" + pr_id.to_string()


fn bb_pr_sub_url_for(site: AtlassianSite, owner: text, repo: text, pr_id: i64, sub: text) -> text:
    bb_pr_url_for(site, owner, repo, pr_id) + "/" + sub


fn _bb_clamp_pagelen(limit: i64) -> i64:
    """Clamp a requested page size to Bitbucket's [1, 100] pagelen range.

    limit <= 0 falls back to a sane default (30, matching common CLI list
    defaults elsewhere in this codebase).
    """
    if limit <= 0:
        return 30
    if limit > 100:
        return 100
    limit


fn _bb_resolve_total_limit(limit: i64) -> i64:
    """Resolve the TOTAL accumulation limit across all pages for a `bb list`
    call: defaults to 30 when limit is unset/non-positive (matching the
    default pagelen), otherwise the caller's requested value uncapped.

    This is distinct from _bb_clamp_pagelen: pagelen is the per-HTTP-request
    page size (clamped to Bitbucket's 100 max), while the total limit here
    may legitimately exceed 100 and be satisfied across several pages.
    """
    if limit <= 0:
        return 30
    limit


fn bb_repo_list_url(ws: text, limit: i64) -> text:
    """Build URL for the FIRST page of GET /repositories/{ws} with a pagelen
    query param (Cloud shape). Subsequent pages are followed via the
    response's `next` link — see _bb_collect_pages and the pagination note
    at the top of this file.
    """
    bb_repo_list_url_for(_bb_cloud_site(), ws, limit)


fn bb_repo_list_url_for(site: AtlassianSite, owner: text, limit: i64) -> text:
    """First page of the repository collection; `pagelen=N` on Cloud,
    `limit=N` on Server / Data Center."""
    bitbucket_owner_url(site, owner) + "?" + bitbucket_page_query(site, _bb_clamp_pagelen(limit))


fn bb_pr_list_url(ws: text, repo: text, state: text, limit: i64) -> text:
    """Build URL for the FIRST page of GET .../pullrequests with optional
    state filter + pagelen (Cloud shape).

    state: "OPEN" | "MERGED" | "DECLINED" | "SUPERSEDED" | "all" (case
    insensitive; "" or "all" omits the state filter entirely, returning PRs
    in every state). Subsequent pages are followed via the response's `next`
    link — see _bb_collect_pages and the pagination note at the top of this
    file.
    """
    bb_pr_list_url_for(_bb_cloud_site(), ws, repo, state, limit)


fn bb_pr_list_url_for(site: AtlassianSite, owner: text, repo: text, state: text, limit: i64) -> text:
    val base = bb_pr_collection_url_for(site, owner, repo)
    val page = bitbucket_page_query(site, _bb_clamp_pagelen(limit))
    if state == "" or state.lower() == "all":
        # Server / Data Center defaults to OPEN when state is omitted.
        if site.is_datacenter():
            return base + "?state=ALL&" + page
        return base + "?" + page
    base + "?state=" + state.upper() + "&" + page


# ============================================================================
# JSON body builders (pure — covered by unit tests)
# ============================================================================
#
# We build JSON via string concatenation rather than interpolation, mirroring
# adapter_confluence/adapter_outlook patterns. This keeps literal `{` / `}`
# bytes outside of Simple string-interpolation parsing.

fn _bb_lbrace() -> text:
    "{"


fn _bb_rbrace() -> text:
    "}"


fn _bb_json_str(s: text) -> text:
    """Encode a text value as a JSON string literal, escaping per RFC 8259."""
    val escaped = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    "\"" + escaped + "\""


fn bb_build_create_pr_body(title: text, source_branch: text, dest_branch: text, reviewers: [text]) -> text:
    """Build the JSON body for POST /pullrequests.

    reviewers contains UUIDs (Bitbucket deprecated usernames in April 2019).
    """
    bb_build_create_pr_body_full(title, source_branch, dest_branch, reviewers, "")


fn bb_build_create_pr_body_full(title: text, source_branch: text, dest_branch: text, reviewers: [text], description: text) -> text:
    """Build the JSON body for POST /pullrequests, including the PR body.

    `description` is Bitbucket's name for what gh calls the PR body. It was
    missing entirely until 2026-09-06: `bb pr create` had no way to set one,
    so `gh pr create --body "..."` translated through devhub would have
    silently dropped the entire PR description. Added as a separate function
    with the original delegating to it, so no existing caller or spec changes
    shape.

    An empty description omits the key rather than sending "", matching how
    dest_branch and reviewers are already handled here.
    """
    var parts: [text] = []
    parts = parts + ["\"title\": " + _bb_json_str(title)]
    if description != "":
        parts = parts + ["\"description\": " + _bb_json_str(description)]
    parts = parts + ["\"source\": " + _bb_lbrace() + "\"branch\": " + _bb_lbrace() + "\"name\": " + _bb_json_str(source_branch) + _bb_rbrace() + _bb_rbrace()]
    if dest_branch != "":
        parts = parts + ["\"destination\": " + _bb_lbrace() + "\"branch\": " + _bb_lbrace() + "\"name\": " + _bb_json_str(dest_branch) + _bb_rbrace() + _bb_rbrace()]
    if reviewers.len() > 0:
        var rs: [text] = []
        for uuid in reviewers:
            rs = rs + [_bb_lbrace() + "\"uuid\": " + _bb_json_str(uuid) + _bb_rbrace()]
        parts = parts + ["\"reviewers\": [" + rs.join(", ") + "]"]
    _bb_lbrace() + parts.join(", ") + _bb_rbrace()


fn bb_build_comment_body(content: text, inline_path: text, inline_from: i64, inline_to: i64) -> text:
    """Build the JSON body for POST .../comments.

    If inline_path is empty, builds a general comment.
    Otherwise builds an inline comment anchored at (inline_from, inline_to).
    inline_from < 0 (or inline_to < 0) is encoded as JSON null.
    """
    val content_obj = "\"content\": " + _bb_lbrace() + "\"raw\": " + _bb_json_str(content) + ", \"markup\": \"markdown\"" + _bb_rbrace()
    if inline_path == "":
        return _bb_lbrace() + content_obj + _bb_rbrace()
    val from_val = if inline_from < 0: "null" else: inline_from.to_string()
    val to_val = if inline_to < 0: "null" else: inline_to.to_string()
    val inline_obj = "\"inline\": " + _bb_lbrace() + "\"path\": " + _bb_json_str(inline_path) + ", \"from\": " + from_val + ", \"to\": " + to_val + _bb_rbrace()
    _bb_lbrace() + content_obj + ", " + inline_obj + _bb_rbrace()


fn bb_build_merge_body(strategy: text, close_source_branch: bool, message: text) -> text:
    """Build the JSON body for POST .../merge.

    strategy: 'merge_commit' | 'squash' | 'fast_forward'
    """
    var parts: [text] = []
    parts = parts + ["\"type\": \"pullrequest\""]
    parts = parts + ["\"merge_strategy\": " + _bb_json_str(strategy)]
    val close_str = if close_source_branch: "true" else: "false"
    parts = parts + ["\"close_source_branch\": " + close_str]
    if message != "":
        parts = parts + ["\"message\": " + _bb_json_str(message)]
    _bb_lbrace() + parts.join(", ") + _bb_rbrace()


# Server / Data Center REST 1.0 bodies (8.19): refs carry repository +
# project key, comments are `text` (+ `anchor`), merge takes `strategyId`.

fn _bb_dc_ref(branch: text, project_key: text, slug: text) -> text:
    val id = if branch.starts_with("refs/"): branch else: "refs/heads/" + branch
    _bb_lbrace() + "\"id\": " + _bb_json_str(id) + ", \"repository\": " + _bb_lbrace() + "\"slug\": " + _bb_json_str(slug) + ", \"project\": " + _bb_lbrace() + "\"key\": " + _bb_json_str(project_key) + _bb_rbrace() + _bb_rbrace() + _bb_rbrace()


fn bb_build_dc_create_pr_body(project_key: text, slug: text, title: text, source_branch: text, dest_branch: text, reviewers: [text], description: text) -> text:
    """POST .../pull-requests body; reviewers are user names (slugs)."""
    var parts: [text] = []
    parts = parts + ["\"title\": " + _bb_json_str(title)]
    if description != "":
        parts = parts + ["\"description\": " + _bb_json_str(description)]
    parts = parts + ["\"fromRef\": " + _bb_dc_ref(source_branch, project_key, slug)]
    val dest = if dest_branch == "": "master" else: dest_branch
    parts = parts + ["\"toRef\": " + _bb_dc_ref(dest, project_key, slug)]
    if reviewers.len() > 0:
        var rs: [text] = []
        for name in reviewers:
            rs = rs + [_bb_lbrace() + "\"user\": " + _bb_lbrace() + "\"name\": " + _bb_json_str(name) + _bb_rbrace() + _bb_rbrace()]
        parts = parts + ["\"reviewers\": [" + rs.join(", ") + "]"]
    _bb_lbrace() + parts.join(", ") + _bb_rbrace()


fn bb_build_dc_comment_body(content: text, inline_path: text, inline_to: i64) -> text:
    """POST .../comments body: {"text"} plus an `anchor` for inline comments."""
    val text_part = "\"text\": " + _bb_json_str(content)
    if inline_path == "":
        return _bb_lbrace() + text_part + _bb_rbrace()
    var anchor = "\"path\": " + _bb_json_str(inline_path)
    if inline_to >= 0:
        anchor = anchor + ", \"line\": " + inline_to.to_string() + ", \"lineType\": \"ADDED\""
    anchor = anchor + ", \"fileType\": \"TO\""
    _bb_lbrace() + text_part + ", \"anchor\": " + _bb_lbrace() + anchor + _bb_rbrace() + _bb_rbrace()


fn bb_dc_strategy_id(strategy: text) -> text:
    """Cloud merge strategy name -> Server / Data Center strategyId."""
    if strategy == "squash":
        return "squash"
    if strategy == "fast_forward":
        return "ff-only"
    "no-ff"


fn bb_build_dc_merge_body(strategy: text) -> text:
    _bb_lbrace() + "\"strategyId\": " + _bb_json_str(bb_dc_strategy_id(strategy)) + _bb_rbrace()


fn bb_dc_page_url(url: text, start: i64) -> text:
    """Replace (or append) the `start=` query parameter for DC paging."""
    var base = url
    val idx = base.find("&start=")
    if idx >= 0:
        base = base[0:idx]
    val sep = if base.contains("?"): "&" else: "?"
    base + sep + "start=" + start.to_string()


# ============================================================================
# Error mapping (pure — covered by unit tests)
# ============================================================================

fn bb_map_http_error(status: i64, body: text, op: text) -> ItfError:
    """Map a Bitbucket HTTP response to ItfError.

    op disambiguates 403:
      - op == BB_OP_MERGE  → blocked-policy (branch restriction / merge policy)
      - op == BB_OP_GENERAL → blocked-auth (insufficient scope or token revoked)
    """
    val safe_body = redact_devhub_diagnostic(body)
    if status == 401:
        return ItfError(kind: ITF_ERR_AUTH, message: "blocked-auth: unauthorized (HTTP 401)", status_code: 401, trace_id: "")
    if status == 403:
        if op == BB_OP_MERGE:
            return ItfError(kind: ITF_ERR_API, message: "blocked: branch policy or merge restriction (HTTP 403): " + safe_body, status_code: 403, trace_id: "")
        return ItfError(kind: ITF_ERR_AUTH, message: "blocked-auth: forbidden (HTTP 403): " + safe_body, status_code: 403, trace_id: "")
    if status == 404:
        return ItfError(kind: ITF_ERR_NOT_FOUND, message: "not found (HTTP 404)", status_code: 404, trace_id: "")
    if status == 409:
        return ItfError(kind: ITF_ERR_CONFLICT, message: "blocked-conflict: PR is not mergeable (HTTP 409): " + safe_body, status_code: 409, trace_id: "")
    if status == 429:
        return ItfError(kind: ITF_ERR_NETWORK, message: "rate limited (HTTP 429): retry after server-specified interval", status_code: 429, trace_id: "")
    ItfError(kind: ITF_ERR_API, message: safe_body, status_code: status, trace_id: "")


fn bb_should_retry(status: i64, retry_after_header: text) -> (bool, i64):
    """For 429: return (true, seconds_to_wait) parsed from Retry-After.

    Returns (false, 0) for any non-429 status.
    """
    if status != 429:
        return (false, 0)
    if retry_after_header == "":
        return (true, 1)
    var n: i64 = 0
    for ch in retry_after_header:
        if ch >= "0" and ch <= "9":
            n = n * 10 + (ch.to_i64() - "0".to_i64())
    if n <= 0:
        return (true, 1)
    (true, n)


fn _bb_str(obj: any, key: text) -> text:
    """Safely extract a string field from JSON object."""
    if obj == nil:
        return ""
    val value = json_object_get(obj, key)
    if value == nil:
        return ""
    val s = json_serialize(value)
    if s.starts_with("\"") and s.ends_with("\""):
        return s[1:s.len() - 1]
    s


fn _bb_int(obj: any, key: text) -> i64:
    """Safely extract an integer field from JSON object."""
    if obj == nil:
        return 0
    val value = json_object_get(obj, key)
    if value == nil:
        return 0
    val s = json_serialize(value)
    var result: i64 = 0
    for ch in s:
        if ch >= "0" and ch <= "9":
            result = result * 10 + (ch.to_i64() - "0".to_i64())
    result


fn _bb_bool(obj: any, key: text) -> bool:
    """Safely extract a boolean field from JSON object. Missing/non-bool -> false."""
    if obj == nil:
        return false
    val value = json_object_get(obj, key)
    if value == nil:
        return false
    json_serialize(value) == "true"


fn _bb_parse_values_array(parsed: any) -> [any]:
    """Bitbucket paginated responses wrap entries in {'values': [...]}.

    Returns the inner array as a list of raw JSON nodes, or [] on miss.
    """
    if parsed == nil:
        return []
    val values = json_object_get(parsed, "values")
    if values == nil:
        return []
    val n = json_array_length(values)
    var out: [any] = []
    var i: i64 = 0
    while i < n:
        out = out + [json_array_get(values, i)]
        i = i + 1
    out

fn _bb_combine_values_json(values: [any], capped: bool) -> text:
    """Re-serialize accumulated multi-page value nodes as a single
    {"values": [...]} JSON body, for --json output when more than one page
    was fetched.

    When `capped` is true (the BB_MAX_PAGES hard cap was the binding reason
    pagination stopped short — see _bb_collect_pages), adds a `"_capped":
    true` field to the envelope so --json consumers get the same truncation
    signal human output already prints via _bb_print_cap_note(). Absent
    entirely when not capped, so existing --json consumers see no shape
    change in the common case."""
    var parts: [text] = []
    for v in values:
        parts = parts + [json_serialize(v)]
    var body = "\"values\": [" + parts.join(", ") + "]"
    if capped:
        body = body + ", \"_capped\": true"
    _bb_lbrace() + body + _bb_rbrace()


# ============================================================================
# Ready-to-merge logic (pure — covered by unit tests)
# ============================================================================

fn bb_eval_ready_to_merge(pr_parsed: any, statuses_parsed: any) -> (bool, text):
    """Pure helper: given parsed PR JSON + parsed statuses JSON, decide ready.

    Ready iff:
      1. PR state == "OPEN"
      2. participants[role=REVIEWER, approved=true].count >= 1
      3. all statuses[*].state == "SUCCESSFUL"
    """
    if pr_parsed == nil:
        return (false, "missing PR data")
    val state = _bb_str(pr_parsed, "state")
    if state != "OPEN":
        return (false, "PR state is " + state + ", expected OPEN")
    val participants = json_object_get(pr_parsed, "participants")
    if participants == nil:
        return (false, "no participants in PR")
    val pn = json_array_length(participants)
    var approved_reviewers: i64 = 0
    var i: i64 = 0
    while i < pn:
        val p = json_array_get(participants, i)
        val role = _bb_str(p, "role")
        if role == "REVIEWER":
            val approved_obj = json_object_get(p, "approved")
            if approved_obj != nil:
                val s = json_serialize(approved_obj)
                if s == "true":
                    approved_reviewers = approved_reviewers + 1
        i = i + 1
    if approved_reviewers < 1:
        return (false, "no approved reviewers (need >= 1)")
    val values = _bb_parse_values_array(statuses_parsed)
    if values.len() == 0:
        return (false, "no commit statuses found")
    for v in values:
        val st = _bb_str(v, "state")
        if st != "SUCCESSFUL":
            val key = _bb_str(v, "key")
            return (false, "status " + key + " is " + st + ", expected SUCCESSFUL")
    (true, "ready: " + approved_reviewers.to_string() + " approval(s) + all statuses SUCCESSFUL")
