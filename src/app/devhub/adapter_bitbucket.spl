# ITF CLI — Bitbucket Cloud REST 2.0 Adapter
#
# Direct HTTP calls to Bitbucket Cloud REST API 2.0 (api.bitbucket.org/2.0).
# Auth: Repository Access Token via HTTP Bearer.
#       App Passwords are deprecated as of 2026 — do not use.
#
# Endpoints supported (per /doc/01_research/local/spipe_infra/bitbucket_rest_2026.md):
#   POST   /repositories/{ws}/{repo}/pullrequests
#   GET    /repositories/{ws}/{repo}/pullrequests/{id}
#   GET    /repositories/{ws}/{repo}/pullrequests/{id}/comments
#   POST   /repositories/{ws}/{repo}/pullrequests/{id}/comments
#   POST   /repositories/{ws}/{repo}/pullrequests/{id}/approve
#   DELETE /repositories/{ws}/{repo}/pullrequests/{id}/approve
#   POST   /repositories/{ws}/{repo}/pullrequests/{id}/merge
#   GET    /repositories/{ws}/{repo}/pullrequests/{id}/statuses
#   GET    /repositories/{ws}                              (bb_list_repos)
#   GET    /repositories/{ws}/{repo}                        (bb_repo_view)
#   GET    /repositories/{ws}/{repo}/pullrequests?state=X   (bb_list_prs)
#
# All public endpoint functions return (success: bool, parsed: T, raw_json: text)
# matching the jira_view_issue / jira_search shape, except bb_list_repos /
# bb_list_prs which return a 4th `capped: bool` element (see Pagination below).
#
# Pagination (bb_list_repos / bb_list_prs): Bitbucket paginates collection
# endpoints via a `next` URL embedded in the response body (`{"values": [...],
# "next": "https://...?page=2"}`). These adapter fns now follow `next` via the
# shared _bb_collect_pages loop (see below), accumulating values until
# `--limit` items are collected or there is no further `next` page. As a
# safety net against a runaway `next` chain (server bug, or a workspace/repo
# far larger than any CLI list command should page through unbounded), the
# loop hard-caps at BB_MAX_PAGES fetches regardless of `limit`. Callers get a
# `capped` flag back (4th element of the returned tuple) so the CLI layer
# (cmd_bb.spl) can print an explicit dim note instead of silently truncating
# results — see the repo's "no silent truncation" rule.

use std.json.{json_parse, json_object_get, json_array_get, json_array_length, json_serialize, json_get_type}
use std.nogc_sync_mut.io.process_ops.{process_run}
use app.devhub.config.{ItfConfig, load_config, resolve_auth_token}
use app.devhub.atlassian_site.{AtlassianSite, ATLASSIAN_AUTH_BEARER, atlassian_normalize_auth, atlassian_auth_header, atlassian_strip_slash, bitbucket_api_root, bitbucket_owner_url, bitbucket_repo_url, bitbucket_pr_collection_url, bitbucket_page_query, bitbucket_resolve_deployment, bitbucket_server_base}
use app.devhub.errors.{ItfError, ITF_ERR_AUTH, ITF_ERR_NOT_FOUND, ITF_ERR_API, ITF_ERR_CONFLICT, ITF_ERR_NETWORK}
use app.devhub.request_headers.{gateway_request_headers}
use app.devhub.redaction.{redact_devhub_diagnostic}

# Preserve the adapter import surface for commands and existing specs.
export use app.devhub.adapter_bitbucket_protocol.{
    BB_OP_GENERAL,
    BB_OP_MERGE,
    _bb_cloud_site,
    bb_pr_collection_url,
    bb_pr_url,
    bb_pr_sub_url,
    bb_repo_collection_url,
    bb_repo_url,
    bb_pr_collection_url_for,
    bb_pr_url_for,
    bb_pr_sub_url_for,
    _bb_clamp_pagelen,
    _bb_resolve_total_limit,
    bb_repo_list_url,
    bb_repo_list_url_for,
    bb_pr_list_url,
    bb_pr_list_url_for,
    _bb_lbrace,
    _bb_rbrace,
    _bb_json_str,
    bb_build_create_pr_body,
    bb_build_create_pr_body_full,
    bb_build_comment_body,
    bb_build_merge_body,
    _bb_dc_ref,
    bb_build_dc_create_pr_body,
    bb_build_dc_comment_body,
    bb_dc_strategy_id,
    bb_build_dc_merge_body,
    bb_dc_page_url,
    bb_map_http_error,
    bb_should_retry,
    _bb_str,
    _bb_int,
    _bb_bool,
    _bb_parse_values_array,
    _bb_combine_values_json,
    bb_eval_ready_to_merge
}


# ============================================================================
# Constants
# ============================================================================

val BB_API_BASE = "https://api.bitbucket.org/2.0"
val BB_MAX_PAGES = 10  # hard safety cap on `next`-link follows per list call


# ============================================================================
# Data Structures
# ============================================================================

class BbPr:
    id: i64
    title: text
    state: text
    source_branch: text
    dest_branch: text
    author: text
    web_url: text
    merge_commit: text
    updated_on: text


class BbRepo:
    """A Bitbucket Cloud repository (from GET /2.0/repositories/{ws}[/{repo}])."""
    slug: text
    name: text
    full_name: text
    description: text
    is_private: bool
    updated_on: text
    main_branch: text
    web_url: text


class BbComment:
    id: i64
    author: text
    content: text
    inline_path: text
    inline_to: i64


class BbStatus:
    key: text
    state: text
    name: text
    url: text


class BbClient:
    """Bitbucket REST client — Cloud REST 2.0 by default, Server / Data
    Center REST 1.0 when `deployment` is datacenter.

    Holds the token and base URL. Per the arch doc (FooClient with config +
    auth_header()). `deployment`, `auth_scheme` and `user` are optional: an
    omitted/"" deployment is Cloud, an omitted/"" auth_scheme is Bearer —
    the pre-existing behaviour — and `user` is only read for Basic auth.
    """
    token: text
    base_url: text
    deployment: text    # "cloud" | "datacenter" (app.devhub.atlassian_site)
    auth_scheme: text   # "bearer" (access token / DC PAT) | "basic" (base64(user:token))
    user: text
    gateway_url: text
    headers: [text]

    static fn from_token(token: text) -> BbClient:
        BbClient(token: token, base_url: BB_API_BASE, deployment: "", auth_scheme: "", user: "", gateway_url: "", headers: [])

    static fn from_env() -> BbClient:
        """Token from auth.sdn / token_env / token_cmd; deployment shape,
        site URL, auth scheme and user from [bitbucket] in config.sdn."""
        val config = load_config()
        val url = if config.bb_url == nil or config.bb_url == "": BB_API_BASE else: config.bb_url
        BbClient(token: resolve_auth_token(config, "bitbucket"), base_url: url, deployment: config.bb_deployment, auth_scheme: config.bb_auth, user: config.bb_user, gateway_url: config.bb_gateway_url, headers: config.bb_headers)

    fn site() -> AtlassianSite:
        """The deployment shape this client talks to. A Cloud client whose
        base_url is the default keeps "" so the shape helpers emit exactly
        BB_API_BASE. An unset deployment with a non-bitbucket.org URL is
        Server / Data Center, whose root is normalized (trailing slash or
        `/rest/api/1.0` stripped; port and context path kept)."""
        val base = if self.base_url == nil or self.base_url == BB_API_BASE: "" else: self.base_url
        val deployment = bitbucket_resolve_deployment(base, self.deployment)
        if deployment == "datacenter":
            return AtlassianSite(base_url: bitbucket_server_base(base), deployment: deployment)
        AtlassianSite.create(base, deployment)

    fn auth_header() -> text:
        atlassian_auth_header(atlassian_normalize_auth(self.auth_scheme, ATLASSIAN_AUTH_BEARER), self.user, self.token)

    fn is_configured() -> bool:
        self.token != ""


# ============================================================================
# Auth header builder (in-file; auth.spl is owned by orchestrator)
# ============================================================================

fn bb_auth_header(token: text) -> text:
    """Build Authorization header value for Bitbucket Cloud REST 2.0.

    Repository Access Token (Bearer). App Passwords are deprecated 2026.
    Returns "" if no token configured.
    """
    if token == "":
        return ""
    "Bearer " + token

# ============================================================================
# Internal HTTP helpers
# ============================================================================
#
# std.nogc_sync_mut.http_client only BUILDS request tuples (no send), so the
# previous http_get-based wrappers never reached the network: `status` was
# the request's method text and no Authorization header was attached. The
# transport is `curl` (same as adapter_bitbucket_curl.spl) until a real
# http_client send path lands. Retry-After is not captured ("").

fn bb_curl_argv(method: text, url: text, auth: text, payload: text) -> [text]:
    """curl argv for one request: body then a trailing `\\n<http_code>` line."""
    var args: [text] = ["-s", "-S", "-X", method, "-H", "Accept: application/json", "-H", "X-Atlassian-Token: no-check"]
    if auth != "":
        args = args + ["-H", "Authorization: " + auth]
    if payload != "":
        args = args + ["-H", "Content-Type: application/json", "-d", payload]
    args + ["-w", "\n" + "%" + "{" + "http_code" + "}", url]


fn bb_curl_argv_with_headers(method: text, url: text, auth: text, payload: text, headers: [text]) -> [text]:
    """Build argv for every verb with validated gateway headers appended."""
    var args = bb_curl_argv(method, url, auth, payload)
    val tail = args[args.len() - 3:]
    args = args[:args.len() - 3]
    for header in headers:
        args = args + ["-H", header]
    args + tail


fn bb_resolve_gateway_url(client: BbClient, url: text) -> text:
    """Replace this client's primary or DC build-status API root with its gateway root."""
    if client.gateway_url == nil or client.gateway_url == "":
        return url
    val gateway = atlassian_strip_slash(client.gateway_url)
    if url == gateway or url.starts_with(gateway + "/") or url.starts_with(gateway + "?"):
        return url
    val site = client.site()
    val api_root = atlassian_strip_slash(bitbucket_api_root(site))
    if api_root != "" and (url == api_root or url.starts_with(api_root + "/") or url.starts_with(api_root + "?")):
        return gateway + url[api_root.len():]
    if site.is_datacenter():
        val build_status_root = atlassian_strip_slash(site.base_url) + "/rest/build-status/1.0"
        if url == build_status_root or url.starts_with(build_status_root + "/") or url.starts_with(build_status_root + "?"):
            return gateway + url[build_status_root.len():]
    url


fn _bb_gateway_argv(client: BbClient, method: text, url: text, payload: text) -> Result<[text], text>:
    """Resolve gateway routing and attach only headers valid for the resolved URL."""
    val resolved_url = bb_resolve_gateway_url(client, url)
    match gateway_request_headers(resolved_url, client.gateway_url, client.headers, []):
        Err(message):
            Err(message)
        Ok(headers):
            Ok(bb_curl_argv_with_headers(method, resolved_url, client.auth_header(), payload, headers))


fn _bb_split_status(stdout: text) -> (i64, text):
    """Split curl output into (status, body); status 0 when unparseable."""
    var nl: i64 = -1
    var i: i64 = stdout.len() - 1
    while i >= 0 and nl < 0:
        if stdout[i] == "\n":
            nl = i
        i = i - 1
    val tail = if nl < 0: stdout.trim() else: stdout[nl + 1:].trim()
    val body = if nl < 0: "" else: stdout[0:nl]
    if tail.len() == 0:
        return (0, stdout)
    var n: i64 = 0
    for ch in tail:
        if ch < "0" or ch > "9":
            return (0, stdout)
        n = n * 10 + (ch.to_i64() - "0".to_i64())
    (n, body)


fn _bb_send(client: BbClient, method: text, url: text, payload: text) -> (i64, text, text):
    """Authenticated request via curl. Returns (status, body, retry_after)."""
    var argv: [text] = []
    match _bb_gateway_argv(client, method, url, payload):
        Err(message):
            return (0, redact_devhub_diagnostic(message), "")
        Ok(configured_argv):
            argv = configured_argv
    val (stdout, stderr, code) = process_run("curl", argv)
    if code != 0:
        return (0, redact_devhub_diagnostic("network_error: curl failed: " + stderr), "")
    val (status, body) = _bb_split_status(stdout)
    (status, body, "")


fn _bb_get(client: BbClient, url: text) -> (i64, text, text):
    _bb_send(client, "GET", url, "")


fn _bb_post(client: BbClient, url: text, payload: text) -> (i64, text, text):
    _bb_send(client, "POST", url, payload)


fn _bb_put(client: BbClient, url: text, payload: text) -> (i64, text, text):
    _bb_send(client, "PUT", url, payload)


fn _bb_delete(client: BbClient, url: text) -> (i64, text, text):
    _bb_send(client, "DELETE", url, "")


# ============================================================================
# Parsing helpers
# ============================================================================

fn bb_parse_pr(obj: any) -> BbPr:
    """Parse a Bitbucket PR JSON object."""
    val empty = BbPr(id: 0, title: "", state: "", source_branch: "", dest_branch: "", author: "", web_url: "", merge_commit: "", updated_on: "")
    if obj == nil:
        return empty
    val id = _bb_int(obj, "id")
    val title = _bb_str(obj, "title")
    val state = _bb_str(obj, "state")
    var source_branch = ""
    val source = json_object_get(obj, "source")
    if source != nil:
        val br = json_object_get(source, "branch")
        if br != nil:
            source_branch = _bb_str(br, "name")
    var dest_branch = ""
    val dest = json_object_get(obj, "destination")
    if dest != nil:
        val br = json_object_get(dest, "branch")
        if br != nil:
            dest_branch = _bb_str(br, "name")
    var author = ""
    val author_obj = json_object_get(obj, "author")
    if author_obj != nil:
        author = _bb_str(author_obj, "display_name")
    var web_url = ""
    val links = json_object_get(obj, "links")
    if links != nil:
        val html = json_object_get(links, "html")
        if html != nil:
            web_url = _bb_str(html, "href")
    var merge_commit = ""
    val mc = json_object_get(obj, "merge_commit")
    if mc != nil:
        merge_commit = _bb_str(mc, "hash")
    var updated_on = _bb_str(obj, "updated_on")
    # Server / Data Center 1.0 field names.
    if source_branch == "":
        source_branch = _bb_str(json_object_get(obj, "fromRef"), "displayId")
    if dest_branch == "":
        dest_branch = _bb_str(json_object_get(obj, "toRef"), "displayId")
    if author == "" and author_obj != nil:
        author = _bb_str(json_object_get(author_obj, "user"), "displayName")
    if web_url == "" and links != nil:
        val self_links = json_object_get(links, "self")
        if self_links != nil and json_array_length(self_links) > 0:
            web_url = _bb_str(json_array_get(self_links, 0), "href")
    if updated_on == "":
        updated_on = _bb_str(obj, "updatedDate")
    BbPr(id: id, title: title, state: state, source_branch: source_branch, dest_branch: dest_branch, author: author, web_url: web_url, merge_commit: merge_commit, updated_on: updated_on)


fn bb_parse_repo(obj: any) -> BbRepo:
    """Parse a Bitbucket repository JSON object (list or view response)."""
    val empty = BbRepo(slug: "", name: "", full_name: "", description: "", is_private: false, updated_on: "", main_branch: "", web_url: "")
    if obj == nil:
        return empty
    val slug = _bb_str(obj, "slug")
    val name = _bb_str(obj, "name")
    val full_name = _bb_str(obj, "full_name")
    val description = _bb_str(obj, "description")
    val is_private = _bb_bool(obj, "is_private")
    val updated_on = _bb_str(obj, "updated_on")
    var main_branch = ""
    val mb = json_object_get(obj, "mainbranch")
    if mb != nil:
        main_branch = _bb_str(mb, "name")
    var web_url = ""
    val links = json_object_get(obj, "links")
    if links != nil:
        val html = json_object_get(links, "html")
        if html != nil:
            web_url = _bb_str(html, "href")
    BbRepo(slug: slug, name: name, full_name: full_name, description: description, is_private: is_private, updated_on: updated_on, main_branch: main_branch, web_url: web_url)


fn _bb_parse_comment(obj: any) -> BbComment:
    """Parse a Bitbucket PR comment JSON object."""
    val empty = BbComment(id: 0, author: "", content: "", inline_path: "", inline_to: -1)
    if obj == nil:
        return empty
    val id = _bb_int(obj, "id")
    var author = ""
    val user = json_object_get(obj, "user")
    if user != nil:
        author = _bb_str(user, "display_name")
    var content = ""
    val content_obj = json_object_get(obj, "content")
    if content_obj != nil:
        content = _bb_str(content_obj, "raw")
    var inline_path = ""
    var inline_to: i64 = -1
    val inline = json_object_get(obj, "inline")
    if inline != nil:
        inline_path = _bb_str(inline, "path")
        val to_val = json_object_get(inline, "to")
        if to_val != nil:
            inline_to = _bb_int(inline, "to")
    # Server / Data Center 1.0: {text, author.displayName, anchor{path,line}}.
    if content == "":
        content = _bb_str(obj, "text")
    if author == "":
        author = _bb_str(json_object_get(obj, "author"), "displayName")
    val anchor = json_object_get(obj, "anchor")
    if inline_path == "" and anchor != nil:
        inline_path = _bb_str(anchor, "path")
        if json_object_get(anchor, "line") != nil:
            inline_to = _bb_int(anchor, "line")
    BbComment(id: id, author: author, content: content, inline_path: inline_path, inline_to: inline_to)


fn _bb_parse_status(obj: any) -> BbStatus:
    """Parse a Bitbucket commit-status JSON object."""
    val empty = BbStatus(key: "", state: "", name: "", url: "")
    if obj == nil:
        return empty
    BbStatus(
        key: _bb_str(obj, "key"),
        state: _bb_str(obj, "state"),
        name: _bb_str(obj, "name"),
        url: _bb_str(obj, "url")
    )



# ============================================================================
# Pagination loop (shared by bb_list_repos / bb_list_prs)
# ============================================================================

fn _bb_fetch_list_page(client: BbClient, url: text) -> (bool, [any], text, text):
    """Fetch + parse one page of a Bitbucket paginated list endpoint.

    Repositories and pull-requests list responses share the same shape
    (`{"values": [...], "next": "..."}`) and the same error-mapping op
    (BB_OP_GENERAL), so both bb_list_repos and bb_list_prs drive
    _bb_collect_pages with this one fetch-page implementation.

    Returns (ok, page_values, next_url, err_msg). `next_url` is "" when the
    response has no further page.
    """
    val (status, body, _retry) = _bb_get(client, url)
    if status != 200:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, [], "", err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, [], "", "invalid JSON response")
    val values = _bb_parse_values_array(parsed)
    if client.site().is_datacenter():
        # DC paging: no `next` URL — {isLastPage, nextPageStart} + `start=`.
        if _bb_bool(parsed, "isLastPage") or json_object_get(parsed, "nextPageStart") == nil:
            return (true, values, "", "")
        return (true, values, bb_dc_page_url(url, _bb_int(parsed, "nextPageStart")), "")
    val next = _bb_str(parsed, "next")
    (true, values, next, "")


fn _bb_collect_pages(client: BbClient, fetch_page: fn(BbClient, text) -> (bool, [any], text, text), first_url: text, limit: i64) -> (bool, [any], text, bool):
    """Follow a Bitbucket `next`-link chain, accumulating parsed JSON value
    nodes until `limit` items are collected or there is no further page.

    `fetch_page(client, url) -> (ok, page_values, next_url, err_msg)` is an
    explicit parameter rather than a closure, so this loop does no I/O and
    holds no captured state of its own: specs drive it directly with a
    fixture fetch_page (see adapter_bitbucket_spec.spl), no network or
    mocking required.

    Hard-capped at BB_MAX_PAGES fetches regardless of `limit`/`next`, to
    protect against a runaway `next` chain. Returns (ok, collected_values,
    err_msg, capped); `capped` is true only when the page cap is the
    *binding* reason collection stopped short — i.e. `limit` was NOT yet
    satisfied AND a `next` page was still pending. If the cap is reached on
    exactly the page that also satisfies `limit`, that's a success, not a
    truncation — `capped` stays false.
    """
    var out: [any] = []
    var url = first_url
    var page: i64 = 0
    while url != "" and out.len() < limit and page < BB_MAX_PAGES:
        val (ok, values, next_url, err) = fetch_page(client, url)
        if not ok:
            return (false, out, err, false)
        for v in values:
            if out.len() < limit:
                out = out + [v]
        url = next_url
        page = page + 1
    val capped = page >= BB_MAX_PAGES and url != "" and out.len() < limit
    (true, out, "", capped)


# ============================================================================
# Server / Data Center helpers
# ============================================================================

fn _bb_dc_set_participant(client: BbClient, ws: text, repo: text, pr_id: i64, status_value: text, label: text) -> (bool, text, text):
    """PUT .../participants/{userSlug} {"status": APPROVED|UNAPPROVED}."""
    val url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id, "participants/" + client.user)
    val payload = _bb_lbrace() + "\"status\": " + _bb_json_str(status_value) + _bb_rbrace()
    val (status, body, _retry) = _bb_put(client, url, payload)
    if status != 200:
        return (false, "", bb_map_http_error(status, body, BB_OP_GENERAL).display())
    (true, label, body)


fn _bb_dc_statuses_url(client: BbClient, ws: text, repo: text, pr_id: i64) -> text:
    """DC build status lives at {root}/rest/build-status/1.0/commits/{sha}
    (same {values:[{key,state,name,url}]} shape); sha = fromRef.latestCommit."""
    val (status, body, _retry) = _bb_get(client, bb_pr_url_for(client.site(), ws, repo, pr_id))
    if status != 200:
        return ""
    val parsed = json_parse(body)
    if parsed == nil:
        return ""
    val sha = _bb_str(json_object_get(parsed, "fromRef"), "latestCommit")
    if sha == "":
        return ""
    client.site().base_url + "/rest/build-status/1.0/commits/" + sha


# ============================================================================
# Public API
# ============================================================================

fn bb_create_pr(client: BbClient, ws: text, repo: text, title: text, source_branch: text, dest_branch: text, reviewers: [text]) -> (bool, BbPr, text):
    """POST /repositories/{ws}/{repo}/pullrequests."""
    bb_create_pr_with_body(client, ws, repo, title, source_branch, dest_branch, reviewers, "")


fn bb_create_pr_with_body(client: BbClient, ws: text, repo: text, title: text, source_branch: text, dest_branch: text, reviewers: [text], description: text) -> (bool, BbPr, text):
    """POST /repositories/{ws}/{repo}/pullrequests, with a PR description.

    See bb_build_create_pr_body_full for why this exists as a separate entry
    point (gh's `--body` had no Bitbucket equivalent at all before this).
    """
    val empty = BbPr(id: 0, title: "", state: "", source_branch: "", dest_branch: "", author: "", web_url: "", merge_commit: "", updated_on: "")
    if not client.is_configured():
        return (false, empty, "blocked-auth: no Bitbucket token configured")
    val url = bb_pr_collection_url_for(client.site(), ws, repo)
    val payload = if client.site().is_datacenter(): bb_build_dc_create_pr_body(ws, repo, title, source_branch, dest_branch, reviewers, description) else: bb_build_create_pr_body_full(title, source_branch, dest_branch, reviewers, description)
    val (status, body, _retry) = _bb_post(client, url, payload)
    if status != 200 and status != 201:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, empty, err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, empty, "invalid JSON response")
    (true, bb_parse_pr(parsed), body)


fn bb_get_pr(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, BbPr, text):
    """GET /repositories/{ws}/{repo}/pullrequests/{id}."""
    val empty = BbPr(id: 0, title: "", state: "", source_branch: "", dest_branch: "", author: "", web_url: "", merge_commit: "", updated_on: "")
    if not client.is_configured():
        return (false, empty, "blocked-auth: no Bitbucket token configured")
    val url = bb_pr_url_for(client.site(), ws, repo, pr_id)
    val (status, body, _retry) = _bb_get(client, url)
    if status != 200:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, empty, err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, empty, "invalid JSON response")
    (true, bb_parse_pr(parsed), body)


fn bb_list_pr_comments(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, [BbComment], text):
    """GET /repositories/{ws}/{repo}/pullrequests/{id}/comments."""
    if not client.is_configured():
        return (false, [], "blocked-auth: no Bitbucket token configured")
    val is_dc = client.site().is_datacenter()
    # DC's /comments requires ?path=; the general listing is /activities.
    val url = if is_dc: bb_pr_sub_url_for(client.site(), ws, repo, pr_id, "activities") + "?limit=100" else: bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"comments")
    val (status, body, _retry) = _bb_get(client, url)
    if status != 200:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, [], err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, [], "invalid JSON response")
    val raw = _bb_parse_values_array(parsed)
    var out: [BbComment] = []
    for v in raw:
        if not is_dc:
            out = out + [_bb_parse_comment(v)]
        else if _bb_str(v, "action") == "COMMENTED":
            out = out + [_bb_parse_comment(json_object_get(v, "comment"))]
    (true, out, body)


fn bb_post_pr_comment(client: BbClient, ws: text, repo: text, pr_id: i64, content: text, inline_path: text, inline_from: i64, inline_to: i64) -> (bool, BbComment, text):
    """POST /repositories/{ws}/{repo}/pullrequests/{id}/comments.

    inline_path == "" → general comment. Otherwise inline at (from, to).
    Pass -1 for either inline_from / inline_to to encode JSON null.
    """
    val empty = BbComment(id: 0, author: "", content: "", inline_path: "", inline_to: -1)
    if not client.is_configured():
        return (false, empty, "blocked-auth: no Bitbucket token configured")
    val url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"comments")
    val payload = if client.site().is_datacenter(): bb_build_dc_comment_body(content, inline_path, inline_to) else: bb_build_comment_body(content, inline_path, inline_from, inline_to)
    val (status, body, _retry) = _bb_post(client, url, payload)
    if status != 200 and status != 201:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, empty, err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, empty, "invalid JSON response")
    (true, _bb_parse_comment(parsed), body)


fn bb_approve_pr(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, text, text):
    """POST /repositories/{ws}/{repo}/pullrequests/{id}/approve."""
    if not client.is_configured():
        return (false, "", "blocked-auth: no Bitbucket token configured")
    if client.site().is_datacenter() and client.user != nil and client.user != "":
        return _bb_dc_set_participant(client, ws, repo, pr_id, "APPROVED", "approved")
    # DC without bitbucket.user: legacy POST /approve (deprecated, still in 8.x).
    val url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"approve")
    val (status, body, _retry) = _bb_post(client, url, "")
    if status != 200 and status != 201:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, "", err.display())
    (true, "approved", body)


fn bb_unapprove_pr(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, text, text):
    """DELETE /repositories/{ws}/{repo}/pullrequests/{id}/approve."""
    if not client.is_configured():
        return (false, "", "blocked-auth: no Bitbucket token configured")
    if client.site().is_datacenter() and client.user != nil and client.user != "":
        return _bb_dc_set_participant(client, ws, repo, pr_id, "UNAPPROVED", "unapproved")
    val url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"approve")
    val (status, body, _retry) = _bb_delete(client, url)
    if status != 200 and status != 204:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, "", err.display())
    (true, "unapproved", body)


fn bb_merge_pr(client: BbClient, ws: text, repo: text, pr_id: i64, strategy: text, close_source_branch: bool) -> (bool, BbPr, text):
    """POST /repositories/{ws}/{repo}/pullrequests/{id}/merge.

    strategy must be 'merge_commit' | 'squash' | 'fast_forward'.
    """
    val empty = BbPr(id: 0, title: "", state: "", source_branch: "", dest_branch: "", author: "", web_url: "", merge_commit: "", updated_on: "")
    if not client.is_configured():
        return (false, empty, "blocked-auth: no Bitbucket token configured")
    if strategy != "merge_commit" and strategy != "squash" and strategy != "fast_forward":
        return (false, empty, "invalid merge strategy: " + strategy)
    var url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"merge")
    var payload = bb_build_merge_body(strategy, close_source_branch, "")
    if client.site().is_datacenter():
        # DC requires ?version= (optimistic lock) — read it from the PR.
        val (pr_status, pr_body, _r) = _bb_get(client, bb_pr_url_for(client.site(), ws, repo, pr_id))
        if pr_status != 200:
            return (false, empty, bb_map_http_error(pr_status, pr_body, BB_OP_GENERAL).display())
        val pr_parsed = json_parse(pr_body)
        if pr_parsed == nil:
            return (false, empty, "invalid JSON response")
        url = url + "?version=" + _bb_int(pr_parsed, "version").to_string()
        payload = bb_build_dc_merge_body(strategy)
    val (status, body, _retry) = _bb_post(client, url, payload)
    if status != 200 and status != 202:
        val err = bb_map_http_error(status, body, BB_OP_MERGE)
        return (false, empty, err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, empty, "invalid JSON response")
    (true, bb_parse_pr(parsed), body)


fn bb_get_pr_statuses(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, [BbStatus], text):
    """GET /repositories/{ws}/{repo}/pullrequests/{id}/statuses."""
    if not client.is_configured():
        return (false, [], "blocked-auth: no Bitbucket token configured")
    var url = bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"statuses")
    if client.site().is_datacenter():
        url = _bb_dc_statuses_url(client, ws, repo, pr_id)
        if url == "":
            return (false, [], "could not resolve PR head commit for build status")
    val (status, body, _retry) = _bb_get(client, url)
    if status != 200:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, [], err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, [], "invalid JSON response")
    val raw = _bb_parse_values_array(parsed)
    var out: [BbStatus] = []
    for v in raw:
        out = out + [_bb_parse_status(v)]
    (true, out, body)


fn bb_check_ready_to_merge(client: BbClient, ws: text, repo: text, pr_id: i64) -> (bool, text):
    """Compose: GET PR + GET statuses, then evaluate ready-to-merge.

    Returns (ready, reason).
    """
    if not client.is_configured():
        return (false, "blocked-auth: no Bitbucket token configured")
    val pr_url = bb_pr_url_for(client.site(), ws, repo, pr_id)
    val (pr_status, pr_body, _r1) = _bb_get(client, pr_url)
    if pr_status != 200:
        return (false, "GET PR failed: HTTP " + pr_status.to_string())
    val pr_parsed = json_parse(pr_body)
    if pr_parsed == nil:
        return (false, "invalid PR JSON")
    val statuses_url = if client.site().is_datacenter(): _bb_dc_statuses_url(client, ws, repo, pr_id) else: bb_pr_sub_url_for(client.site(), ws, repo, pr_id,"statuses")
    val (st_status, st_body, _r2) = _bb_get(client, statuses_url)
    if st_status != 200:
        return (false, "GET statuses failed: HTTP " + st_status.to_string())
    val st_parsed = json_parse(st_body)
    if st_parsed == nil:
        return (false, "invalid statuses JSON")
    bb_eval_ready_to_merge(pr_parsed, st_parsed)


fn bb_list_repos(client: BbClient, ws: text, limit: i64) -> (bool, [BbRepo], text, bool):
    """GET /repositories/{ws} — list repositories in a workspace.

    Follows Bitbucket's `next` pagination link (via _bb_collect_pages) until
    `limit` items are collected (clamped to Bitbucket's 100 max pagelen per
    page) or there is no further page, hard-capped at BB_MAX_PAGES fetches.
    Returns (ok, repos, raw_json, capped).
    """
    if not client.is_configured():
        return (false, [], "blocked-auth: no Bitbucket token configured", false)
    val n = _bb_resolve_total_limit(limit)
    val first_url = bb_repo_list_url_for(client.site(), ws, limit)
    val (ok, raw, err, capped) = _bb_collect_pages(client, _bb_fetch_list_page, first_url, n)
    if not ok:
        return (false, [], err, false)
    var out: [BbRepo] = []
    for v in raw:
        out = out + [bb_parse_repo(v)]
    (true, out, _bb_combine_values_json(raw, capped), capped)


fn bb_repo_view(client: BbClient, ws: text, repo: text) -> (bool, BbRepo, text):
    """GET /repositories/{ws}/{repo} — view a single repository."""
    val empty = BbRepo(slug: "", name: "", full_name: "", description: "", is_private: false, updated_on: "", main_branch: "", web_url: "")
    if not client.is_configured():
        return (false, empty, "blocked-auth: no Bitbucket token configured")
    val url = bitbucket_repo_url(client.site(), ws, repo)
    val (status, body, _retry) = _bb_get(client, url)
    if status != 200:
        val err = bb_map_http_error(status, body, BB_OP_GENERAL)
        return (false, empty, err.display())
    val parsed = json_parse(body)
    if parsed == nil:
        return (false, empty, "invalid JSON response")
    (true, bb_parse_repo(parsed), body)


fn bb_list_prs(client: BbClient, ws: text, repo: text, state: text, limit: i64) -> (bool, [BbPr], text, bool):
    """GET /repositories/{ws}/{repo}/pullrequests?state=X — list pull requests.

    state: "OPEN" | "MERGED" | "DECLINED" | "SUPERSEDED" | "all". Follows
    Bitbucket's `next` pagination link (via _bb_collect_pages) until `limit`
    items are collected or there is no further page, hard-capped at
    BB_MAX_PAGES fetches. Returns (ok, prs, raw_json, capped).
    """
    if not client.is_configured():
        return (false, [], "blocked-auth: no Bitbucket token configured", false)
    val n = _bb_resolve_total_limit(limit)
    val first_url = bb_pr_list_url_for(client.site(), ws, repo, state, limit)
    val (ok, raw, err, capped) = _bb_collect_pages(client, _bb_fetch_list_page, first_url, n)
    if not ok:
        return (false, [], err, false)
    var out: [BbPr] = []
    for v in raw:
        out = out + [bb_parse_pr(v)]
    (true, out, _bb_combine_values_json(raw, capped), capped)
