# ITF CLI — Raw API command
#
# Usage: itf api <GET|POST|PUT|DELETE> <url> [--jira] [--data JSON] [--header H]
# Direct REST calls to Confluence (default) or Jira (--jira) REST endpoints.

use std.nogc_sync_mut.io.http_sffi.{rt_http_request}
use std.json.{json_parse}
use std.common.json.serializer.{json_pretty}
use app.devhub.config.{load_config, load_config_for_target, confluence_target_from_args}
use app.devhub.auth.{confluence_auth_header, confluence_api_base, jira_auth_header, jira_api_base}
use app.devhub.flags.{_extract_flag, _has_flag, _positional_args}
use app.devhub.output.{print_error}
use app.devhub.redaction.redact_devhub_diagnostic
use app.devhub.request_headers.gateway_request_headers


fn handle_api(args: [text]) -> i64:
    """Raw API call. Usage: itf api <METHOD> <url> [--jira] [--data JSON] [--header H]"""
    if _has_flag(args, "--help") or _has_flag(args, "-h"):
        _print_api_help()
        return 0

    if args.len() < 2:
        _print_api_help()
        return 1

    val method = args[0].upper()
    val url = args[1]
    val remaining = if args.len() > 2: args[2:] else: []
    val data = _extract_flag(remaining, "--data", "")
    val explicit_headers = _extract_flag_values(remaining, "--header")
    val use_jira = _has_flag(remaining, "--jira")
    val verbose = _has_flag(remaining, "--verbose")
    val include = _has_flag(remaining, "--include")

    if method != "GET" and method != "POST" and method != "PUT" and method != "DELETE":
        print_error("unsupported method: {method}. Use GET, POST, PUT, or DELETE.")
        return 1

    # Resolve full URL if relative path given
    val config = if use_jira: load_config() else: load_config_for_target(confluence_target_from_args(remaining))
    val base = if use_jira: jira_api_base(config) else: confluence_api_base(config)
    val full_url = _resolve_api_url(url, base)

    # Build headers — real attachment via rt_http_request's headers: [text]
    # (the prior std.nogc_sync_mut.http_client-based version only *computed*
    # `auth` for a verbose-mode print; it never reached the wire because
    # http_client's http_get/post/put/delete convenience wrappers build a
    # request tuple and don't send it at all — see http_client/request.spl.
    # rt_http_request is the real extern-backed transport, already used this
    # way by adapter_minio.spl).
    val auth = if use_jira: jira_auth_header(config) else: confluence_auth_header(config)
    val selected_headers = if use_jira:
        gateway_request_headers(full_url, "", [], explicit_headers)
    else:
        gateway_request_headers(full_url, config.confluence_gateway_url, config.confluence_headers, explicit_headers)
    var request_headers: [text] = []
    match selected_headers:
        Err(message):
            print_error(redact_devhub_diagnostic(message))
            return 1
        Ok(safe_headers):
            request_headers = safe_headers
    val headers = _build_api_headers_many(auth, request_headers, data != "")

    if verbose:
        print redact_devhub_diagnostic("> {method} {full_url}")
        if auth != "":
            print redact_devhub_diagnostic("> Authorization: {auth}")
        for header in request_headers:
            print redact_devhub_diagnostic("> {header}")
        if data != "":
            print "> Content-Type: application/json"
            print "> "
            print redact_devhub_diagnostic("> {data}")
        print ""

    val (status, body, err) = rt_http_request(method, full_url, headers, data)

    if include or verbose:
        print "HTTP {status}"
        print ""

    if status < 0:
        print_error(redact_devhub_diagnostic("request failed: {err}"))
        return 1

    # Pretty-print JSON if possible
    val parsed = json_parse(body)
    if parsed != nil:
        print json_pretty(parsed)
    else:
        print body

    if status >= 200 and status < 300:
        0
    else:
        1


fn _resolve_api_url(url: text, base: text) -> text:
    """Prefix a relative path (e.g. "/pages?limit=5") with `base`; an
    already-absolute URL (http://..., https://...) passes through
    unchanged. Pure/testable — no config or network access."""
    if url.starts_with("/") and base != "":
        return "{base}{url}"
    url


fn _build_api_headers(auth: text, extra_header: text, has_body: bool) -> [text]:
    """Build the header list for rt_http_request: always Accept: json, plus
    Authorization when auth is configured, Content-Type when a body is
    present, and the user's --header verbatim when given. Pure/testable."""
    val extras = if extra_header == "": [] else: [extra_header]
    _build_api_headers_many(auth, extras, has_body)


fn _build_api_headers_many(auth: text, extra_headers: [text], has_body: bool) -> [text]:
    """Build transport headers and retain every ordered explicit/config entry."""
    var headers: [text] = ["Accept: application/json"]
    if auth != "":
        headers = headers + ["Authorization: {auth}"]
    if has_body:
        headers = headers + ["Content-Type: application/json"]
    headers = headers + extra_headers
    headers


fn _extract_flag_values(args: [text], flag_name: text) -> [text]:
    """Collect repeated `--flag value` and `--flag=value` occurrences in order."""
    var values: [text] = []
    var i: i64 = 0
    while i < args.len():
        if args[i] == flag_name and i + 1 < args.len():
            values = values + [args[i + 1]]
            i = i + 2
        else if args[i].starts_with(flag_name + "="):
            values = values + [args[i].split("=", 2)[1]]
            i = i + 1
        else:
            i = i + 1
    values


fn _print_api_help():
    """Print API command help."""
    print "Usage: itf api <METHOD> <URL> [flags]"
    print ""
    print "Make raw REST API calls (like gh api)."
    print ""
    print "Methods: GET, POST, PUT, DELETE"
    print ""
    print "Flags:"
    print "  --jira          Target the Jira REST v3 base instead of Confluence"
    print "  --data JSON     Request body"
    print "  --header H      Extra header (repeatable; overrides configured name)"
    print "  --host NAME     Select a configured Confluence target"
    print "  --profile NAME  Alias for --host"
    print "  --verbose        Print request/response details"
    print "  --include        Print response headers"
    print ""
    print "Examples:"
    print "  itf api GET /pages?limit=5"
    print "  itf api POST /pages --data '{\"spaceId\":\"123\",\"title\":\"Test\"}'"
    print "  itf api GET /issue/PROJ-1 --jira"
