# Exact decimal parsing for the S3 seven-day presign contract.
fn minio_parse_expiry(value: text) -> i64?:
    if value == "": return nil
    var result: i64 = 0
    var index = 0
    while index < value.len():
        val digit = value.byte_at(index) - 48
        if digit < 0 or digit > 9: return nil
        # Admission precedes multiplication, so oversized input cannot wrap.
        if result > 60480 or (result == 60480 and digit > 0): return nil
        result = result * 10 + digit
        index = index + 1
    if result == 0: return nil
    Some(result)
