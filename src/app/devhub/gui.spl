# DevHub browser/Electron GUI — pure page and response helpers.

use common.ui.generated.fluid_light_theme_snapshot.{fluid_light_theme_render_snapshot}

fn devhub_gui_html() -> text:
    # Consume the generated snapshot of the SimpleOS registry default. Runtime
    # package parsing is unavailable in interpreter-hosted leaf applications;
    # this is its canonical build-time-resolved Fluid OS liquid CSS.
    val glass_css = fluid_light_theme_render_snapshot().composed_css
    """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DevHub</title>
<style>""" + glass_css + """
:root { color-scheme: light; font-family: var(--font-main); }
body { margin: 0; min-height: 100vh; color: var(--ui-fg); background: var(--app-background-image), var(--app-bg); background-attachment: fixed; }
body::before { content: ""; position: fixed; inset: -20%; pointer-events: none; background: radial-gradient(circle at 18% 20%, rgba(125,211,252,.30), transparent 28%), radial-gradient(circle at 82% 18%, rgba(196,181,253,.30), transparent 30%), radial-gradient(circle at 52% 86%, rgba(244,114,182,.18), transparent 28%); filter: blur(24px); }
main { position: relative; width: min(1100px, calc(100vw - 40px)); margin: 28px auto; }
header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; padding: 22px 24px; border: 1px solid var(--app-border-strong); border-radius: var(--radius-xl); background: linear-gradient(180deg, rgba(255,255,255,.22), rgba(255,255,255,.07)), var(--glass-surface); box-shadow: var(--elevation-mid), inset 0 1px 1px rgba(255,255,255,.22); backdrop-filter: blur(var(--blur-surface)) saturate(180%); -webkit-backdrop-filter: blur(var(--blur-surface)) saturate(180%); }
h1 { margin: 0; font-size: 2rem; }
.subtitle { color: var(--ui-dim); margin-top: 6px; }
.status { color: var(--ui-fg); border: 1px solid var(--app-border-strong); background: var(--ui-accent-dim); border-radius: 999px; padding: 7px 12px; backdrop-filter: blur(var(--blur-subtle)); }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.card { appearance: none; width: 100%; color: inherit; font: inherit; text-align: left; cursor: pointer; background: linear-gradient(145deg, rgba(255,255,255,.20), rgba(255,255,255,.055)), var(--glass-surface); border: 1px solid var(--app-border-strong); border-radius: var(--radius-xl); padding: 20px; box-shadow: var(--elevation-low), inset 0 1px 1px rgba(255,255,255,.18); backdrop-filter: blur(var(--blur-surface)) saturate(180%); -webkit-backdrop-filter: blur(var(--blur-surface)) saturate(180%); transition: transform var(--motion-fast) var(--motion-ease), box-shadow var(--motion-fast) var(--motion-ease); }
.card:hover { transform: translateY(-3px); border-color: rgba(147,197,253,.58); }
.card:focus-visible, .card[aria-pressed="true"] { outline: 3px solid var(--ui-accent-dim); border-color: var(--ui-accent); box-shadow: var(--elevation-mid), 0 0 0 4px rgba(0,88,188,.12); }
.card h2 { margin: 0 0 8px; font-size: 1.12rem; }
.card p { color: var(--ui-dim); min-height: 42px; }
code { display: block; background: rgba(255,255,255,.58); color: var(--ui-accent); border: 1px solid var(--app-border); border-radius: var(--radius-md); padding: 11px; overflow-wrap: anywhere; backdrop-filter: blur(var(--blur-subtle)); }
.pill { display: inline-block; color: var(--ui-fg); background: var(--ui-accent-dim); border: 1px solid var(--app-border-strong); border-radius: 999px; padding: 3px 9px; font-size: .78rem; }
.open-label { float: right; color: var(--ui-accent); font-size: .82rem; font-weight: 700; }
.action-panel { margin-top: 20px; padding: 20px 22px; border: 1px solid var(--app-border-strong); border-radius: var(--radius-xl); background: var(--glass-surface); box-shadow: var(--elevation-mid); backdrop-filter: blur(var(--blur-surface)) saturate(180%); }
.action-panel[hidden] { display: none; }
.action-row { display: flex; align-items: center; gap: 12px; margin-top: 14px; }
.action-row code { flex: 1; }
.copy-button { appearance: none; cursor: pointer; min-height: 42px; padding: 0 18px; color: white; font: 700 .9rem var(--font-main); border: 1px solid rgba(255,255,255,.72); border-radius: 999px; background: linear-gradient(135deg, #60cdff, var(--ui-accent)); box-shadow: var(--elevation-low), inset 0 1px 0 rgba(255,255,255,.65); }
.copy-button:hover { filter: brightness(1.05); transform: translateY(-1px); }
footer { color: var(--ui-dim); margin-top: 22px; font-size: .88rem; padding: 12px 16px; border-radius: var(--radius-lg); background: var(--glass-surface); backdrop-filter: blur(var(--blur-subtle)); }
</style>
</head>
<body>
<main aria-label="DevHub developer tools dashboard">
<header>
<div><h1>DevHub</h1><div class="subtitle">One workspace for developer-service facades</div></div>
<div id="status" class="status" role="status">Local GUI connected</div>
</header>
<section class="grid" aria-label="DevHub commands">
<button type="button" class="card" data-name="Tasks" data-command="devhub tasks list --state open" data-description="List, inspect, create, edit, comment on, and close work items." aria-controls="command-detail" aria-pressed="false"><span class="pill">Jira + GitHub</span><span class="open-label">Open →</span><h2>Tasks</h2><p>List, inspect, create, edit, comment on, and close work items.</p><code>devhub tasks list --state open</code></button>
<button type="button" class="card" data-name="GitHub" data-command="devhub github pr list" data-description="Use familiar issue, pull request, and repository workflows." aria-controls="command-detail" aria-pressed="false"><span class="pill">GitHub</span><span class="open-label">Open →</span><h2>GitHub</h2><p>Use familiar issue, pull request, and repository workflows.</p><code>devhub github pr list</code></button>
<button type="button" class="card" data-name="Bitbucket" data-command="devhub bb pr list --state open" data-description="Review repositories, pull requests, approvals, comments, and merges." aria-controls="command-detail" aria-pressed="false"><span class="pill">Bitbucket</span><span class="open-label">Open →</span><h2>Bitbucket</h2><p>Review repositories, pull requests, approvals, comments, and merges.</p><code>devhub bb pr list --state open</code></button>
<button type="button" class="card" data-name="Wiki" data-command="devhub wiki list --space ENG" data-description="Browse and maintain team knowledge through one command surface." aria-controls="command-detail" aria-pressed="false"><span class="pill">Confluence + Wiki</span><span class="open-label">Open →</span><h2>Wiki</h2><p>Browse and maintain team knowledge through one command surface.</p><code>devhub wiki list --space ENG</code></button>
<button type="button" class="card" data-name="Storage" data-command="devhub storage ls minio/" data-description="Inspect buckets and move or mirror development artifacts safely." aria-controls="command-detail" aria-pressed="false"><span class="pill">S3 + MinIO</span><span class="open-label">Open →</span><h2>Storage</h2><p>Inspect buckets and move or mirror development artifacts safely.</p><code>devhub storage ls minio/</code></button>
<button type="button" class="card" data-name="Email" data-command="devhub email inbox --unread" data-description="Read, search, send, label, and archive team mailbox messages." aria-controls="command-detail" aria-pressed="false"><span class="pill">IMAP + Graph</span><span class="open-label">Open →</span><h2>Email</h2><p>Read, search, send, label, and archive team mailbox messages.</p><code>devhub email inbox --unread</code></button>
</section>
<section id="command-detail" class="action-panel" aria-live="polite" hidden>
<h2 id="detail-title">Facade</h2>
<p id="detail-description"></p>
<div class="action-row"><code id="detail-command"></code><button id="copy-command" type="button" class="copy-button">Copy command</button></div>
</section>
<footer>DevHub GUI is loopback-only. Backend operations remain explicit terminal commands.</footer>
</main>
<script>
const cards = Array.from(document.querySelectorAll('.card'));
const panel = document.getElementById('command-detail');
const statusNode = document.getElementById('status');
const commandNode = document.getElementById('detail-command');
cards.forEach((card) => card.addEventListener('click', () => {
  cards.forEach((item) => item.setAttribute('aria-pressed', String(item === card)));
  document.getElementById('detail-title').textContent = card.dataset.name;
  document.getElementById('detail-description').textContent = card.dataset.description;
  commandNode.textContent = card.dataset.command;
  panel.hidden = false;
  statusNode.textContent = card.dataset.name + ' selected';
  panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}));
document.getElementById('copy-command').addEventListener('click', async () => {
  const command = commandNode.textContent;
  try {
    await navigator.clipboard.writeText(command);
    statusNode.textContent = 'Command copied';
  } catch (_) {
    const selection = window.getSelection();
    const range = document.createRange();
    range.selectNodeContents(commandNode);
    selection.removeAllRanges();
    selection.addRange(range);
    statusNode.textContent = 'Command selected — press ⌘C';
  }
});
</script>
</body>
</html>"""

fn devhub_gui_status_json() -> text:
    "{" + "\"app\":\"devhub\",\"status\":\"ready\",\"surface\":\"gui\",\"commands\":6" + "}"
