# DevHub diagnostic secret redaction
#
# Keep this module pure so every verbose/logging boundary can apply the same
# policy before text reaches stdout or stderr.


fn redact_devhub_diagnostic(value: text) -> text:
    """Mask secrets in headers, assignments, and URLs used by diagnostics."""
    val url_safe = _redact_url_secrets(value)
    _redact_sensitive_assignment(url_safe)


fn _sensitive_name(raw: text) -> bool:
    val name = raw.trim().lower().replace("\"", "").replace("'", "")
    if name == "authorization" or name == "cookie" or name == "set-cookie":
        return true
    if name == "token" or name == "key" or name == "secret" or name == "password":
        return true
    name.contains("-token") or name.contains("_token") or name.contains("apitoken") or
        name.contains("api-token") or name.contains("api_token") or name.contains("-key") or
        name.contains("_key") or name.contains("apikey") or name.contains("api-key") or
        name.contains("api_key") or name.contains("-secret") or name.contains("_secret") or
        name.contains("-password") or name.contains("_password")


fn _assignment_name(prefix: text) -> text:
    var name = prefix.trim()
    if name.starts_with(">"):
        name = name[1:].trim()
    val query_parts = name.split("?")
    name = query_parts[query_parts.len() - 1]
    val amp_parts = name.split("&")
    name = amp_parts[amp_parts.len() - 1]
    val brace_parts = name.split("{")
    name = brace_parts[brace_parts.len() - 1]
    val comma_parts = name.split(",")
    name = comma_parts[comma_parts.len() - 1].trim()
    val words = name.replace("\r", " ").replace("\n", " ").replace("\t", " ").split(" ")
    var last_word = ""
    for word in words:
        if word.trim() != "":
            last_word = word.trim()
    last_word


fn _line_end(value: text, start: i64) -> i64:
    val newline = value[start:].find("\n")
    if newline >= 0:
        return start + newline
    value.len()


fn _quoted_end(value: text, open_idx: i64, line_end: i64) -> i64:
    """Index just past the closing quote of the value opened at open_idx.

    Fails closed: an unterminated quote masks through the end of the line."""
    val quote = value[open_idx:open_idx + 1]
    var i = open_idx + 1
    while i < line_end:
        val ch = value[i:i + 1]
        if ch == "\\":
            i = i + 2
        elif ch == quote:
            return i + 1
        else:
            i = i + 1
    line_end


fn _value_end(value: text, start: i64, line_end: i64, name_raw: text) -> i64:
    """End (exclusive) of the secret value that begins after the delimiter."""
    var i = start
    while i < line_end and (value[i:i + 1] == " " or value[i:i + 1] == "\t" or value[i:i + 1] == "\r"):
        i = i + 1
    if i < line_end:
        val first = value[i:i + 1]
        if first == "\"" or first == "'":
            return _quoted_end(value, i, line_end)
    val name = name_raw.trim().lower().replace("\"", "").replace("'", "")
    if name == "authorization" or name == "cookie" or name == "set-cookie":
        return line_end
    # Unquoted value: a comma ends it only when it separates diagnostic
    # fields (followed by whitespace, a quote, or end of line).
    var j = i
    while j < line_end:
        if value[j:j + 1] == ",":
            if j + 1 >= line_end:
                return j
            val nxt = value[j + 1:j + 2]
            if nxt == " " or nxt == "\t" or nxt == "\"" or nxt == "'" or nxt == "\r":
                return j
        j = j + 1
    line_end


fn _redact_sensitive_assignment(value: text) -> text:
    var delimiter = value.find(":")
    val equals = value.find("=")
    if delimiter < 0 or (equals >= 0 and equals < delimiter):
        delimiter = equals
    if delimiter < 0:
        return value
    val prefix = value[:delimiter]
    val assignment_name = _assignment_name(prefix)
    if not _sensitive_name(assignment_name):
        return value[:delimiter + 1] + _redact_sensitive_assignment(value[delimiter + 1:])
    var end = value.len()
    val query_assignment = prefix.contains("?") or prefix.contains("&")
    if query_assignment:
        val amp = value[delimiter + 1:].find("&")
        if amp >= 0 and delimiter + 1 + amp < end:
            end = delimiter + 1 + amp
        val fragment = value[delimiter + 1:].find("#")
        if fragment >= 0 and delimiter + 1 + fragment < end:
            end = delimiter + 1 + fragment
        val comma = value[delimiter + 1:].find(",")
        if comma >= 0 and delimiter + 1 + comma < end:
            end = delimiter + 1 + comma
        val space = value[delimiter + 1:].find(" ")
        if space >= 0 and delimiter + 1 + space < end:
            end = delimiter + 1 + space
    val rest_start = delimiter + 1
    val line_end = _line_end(value, rest_start)
    if not query_assignment:
        end = _value_end(value, rest_start, line_end, assignment_name)
    else:
        if line_end < end:
            end = line_end
    val suffix = if end < value.len(): _redact_sensitive_assignment(value[end:]) else: ""
    val mask = if query_assignment: "***" else: " ***"
    value[:delimiter + 1] + mask + suffix


fn _min_url_boundary(current: i64, candidate: i64) -> i64:
    if candidate >= 0 and candidate < current:
        return candidate
    current


fn _redact_url_userinfo(value: text) -> text:
    val scheme = value.find("://")
    if scheme >= 0:
        val after_scheme = scheme + 3
        val rest = value[after_scheme:]
        var authority_end = rest.len()
        authority_end = _min_url_boundary(authority_end, rest.find("/"))
        authority_end = _min_url_boundary(authority_end, rest.find("?"))
        authority_end = _min_url_boundary(authority_end, rest.find("#"))
        authority_end = _min_url_boundary(authority_end, rest.find(" "))
        authority_end = _min_url_boundary(authority_end, rest.find("\r"))
        authority_end = _min_url_boundary(authority_end, rest.find("\n"))
        authority_end = _min_url_boundary(authority_end, rest.find("\t"))
        authority_end = _min_url_boundary(authority_end, rest.find("]"))
        authority_end = _min_url_boundary(authority_end, rest.find("}"))
        authority_end = _min_url_boundary(authority_end, rest.find("\""))
        val at = rest.find("@")
        if at >= 0 and at < authority_end:
            return value[:after_scheme] + "***" + _redact_url_userinfo(rest[at:])
        return value[:after_scheme] + _redact_url_userinfo(rest)
    value


fn _redact_url_secrets(value: text) -> text:
    val safe = _redact_url_userinfo(value)
    val question = safe.find("?")
    if question < 0:
        return safe
    val after_question = safe[question + 1:]
    var query_end = after_question.len()
    val comma_end = after_question.find(", ")
    if comma_end >= 0:
        query_end = comma_end
    val space_end = after_question.find(" ")
    if space_end >= 0 and space_end < query_end:
        query_end = space_end
    val query_and_fragment = after_question[:query_end]
    val trailing = if query_end < after_question.len(): after_question[query_end:] else: ""
    val fragments = query_and_fragment.split("#", 2)
    val query = fragments[0]
    var redacted_parts: [text] = []
    for part in query.split("&"):
        val equals = part.find("=")
        if equals >= 0 and _sensitive_name(part[:equals]):
            redacted_parts = redacted_parts + [part[:equals + 1] + "***"]
        else:
            redacted_parts = redacted_parts + [part]
    var rebuilt = safe[:question + 1] + redacted_parts.join("&")
    if fragments.len() > 1:
        rebuilt = rebuilt + "#" + fragments[1]
    rebuilt + _redact_url_secrets(trailing)
