# ITF CLI — Authentication helpers
#
# Builds auth headers for Confluence REST v2 (Basic auth with API token)
# Delegates Jira auth to acli

use std.nogc_sync_mut.env.{env_get}
use app.devhub.config.{ItfConfig, load_config, resolve_auth_token}
use app.devhub.errors.{ItfError}
use app.devhub.atlassian_site.{AtlassianSite, ATLASSIAN_AUTH_BASIC, ATLASSIAN_AUTH_BEARER, atlassian_normalize_auth, atlassian_auth_header, jira_rest_root, confluence_rest_root}


fn jira_site(config: ItfConfig) -> AtlassianSite:
    """The configured Jira deployment (jira.url + jira.deployment)."""
    AtlassianSite.create(config.jira_url, config.jira_deployment)


fn confluence_site(config: ItfConfig) -> AtlassianSite:
    """The configured Confluence deployment (confluence.url + confluence.deployment)."""
    AtlassianSite.create(config.confluence_url, config.confluence_deployment)


fn jira_auth_scheme(config: ItfConfig) -> text:
    """jira.auth normalized: basic (default, Cloud email:api_token) or bearer
    (Data Center personal access token)."""
    atlassian_normalize_auth(config.jira_auth, ATLASSIAN_AUTH_BASIC)


fn jira_auth_header(config: ItfConfig) -> text:
    """Build Authorization header value for the Jira REST API (used by
    `itf api --jira`). Cloud (default) uses Basic base64(email:api_token);
    with `jira.auth: bearer` the token is sent as a Data Center PAT."""
    val token = resolve_auth_token(config, "jira")
    atlassian_auth_header(jira_auth_scheme(config), config.jira_email, token)


fn jira_api_base(config: ItfConfig) -> text:
    """Get the Jira REST API base URL (used by `itf api --jira`): REST v3 on
    Cloud, REST v2 on Server / Data Center."""
    jira_rest_root(jira_site(config))


fn confluence_auth_header(config: ItfConfig) -> text:
    """Build Authorization header value for the Confluence REST API.

    Cloud (default) uses Basic base64(email:api_token); with
    `confluence.auth: bearer` the token is sent as a Data Center PAT.
    """
    val token = resolve_auth_token(config, "confluence")
    atlassian_auth_header(atlassian_normalize_auth(config.confluence_auth, ATLASSIAN_AUTH_BASIC), config.confluence_user, token)


fn confluence_api_base(config: ItfConfig) -> text:
    """Get the Confluence REST API base URL: `/api/v2` on Cloud (the
    configured URL already carries `/wiki`), `/rest/api` on Server / Data
    Center (which has no v2 API — see confluence_rest_root for the named
    resource-path gap)."""
    confluence_rest_root(confluence_site(config))


fn check_confluence_auth(config: ItfConfig) -> bool:
    """Check if Confluence auth is configured."""
    val token = resolve_auth_token(config, "confluence")
    token != "" and config.confluence_user != "" and config.confluence_url != ""


fn check_jira_auth(config: ItfConfig) -> bool:
    """Check if Jira auth is configured (acli handles its own auth)."""
    config.jira_url != ""
