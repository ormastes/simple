# Pure JSON presentation shared by the production MinIO command and specs.
use std.common.json.value.{JsonValue, json_value_object_from, json_value_serialize}

fn minio_stat_json(key: text, size: i64, etag: text, last_modified: text) -> text:
    json_value_serialize(json_value_object_from([
        ("key", JsonValue.Str(key)), ("size", JsonValue.Int(size)),
        ("etag", JsonValue.Str(etag)), ("last_modified", JsonValue.Str(last_modified))
    ]))

fn minio_health_json(alive: bool, status: text, latency_ms: i64, endpoint: text) -> text:
    json_value_serialize(json_value_object_from([
        ("alive", JsonValue.Bool(alive)), ("status", JsonValue.Str(status)),
        ("latency_ms", JsonValue.Int(latency_ms)), ("endpoint", JsonValue.Str(endpoint))
    ]))
