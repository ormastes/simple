# devhub messenger — MessengerReadPortV1 contract, static registry, lazy seam.
#
# Plan: simple_devhub_sqlite_sqlcipher_messenger_master_plan_2026-10-21.md
# §10.2 (manifest/versioning/lazy loading), §6.4 (capability matrix), §6.8
# (read-only enforcement), §11.2 (exit codes: 4 = unsupported capability).
#
# REGISTRATION MECHANISM CHOSEN: static registration behind a lazy-load seam.
# The repo's dynamic machinery (os.smf.dynsmf_*, src/app/startup/*, aspect
# packs in src/lib/common/aspect_pack.spl) is an OS-component SMF dynload
# system with admission/trust sessions — the right tool for SimpleOS
# components, far too heavy to pull into a CLI command's import closure, and
# unusable for an app module at this base without the whole startup planner.
# Plan §10.2 itself names static registration "the pure/minimal SimpleOS
# default". So:
#
#   * adapters are VALUES (MessengerReadPortV1) registered in a module-level
#     registry (messenger_register_adapter);
#   * the registry starts EMPTY — importing this module registers nothing and
#     touches no filesystem, environment, or network, so devhub's existing
#     facades and startup are unaffected when the lane is unused;
#   * messenger_load_adapter(kind) is the LAZY SEAM: callers ask it for an
#     adapter at command time, never at import time. Today it returns the
#     built-in stub for database source kinds; INTEGRATION: the sibling
#     sqlite_format pager lane and sqlcipher4 codec lane replace/extend this
#     seam with their real adapters (and may later move admission to
#     os.smf.dynsmf when a messenger plugin ships as an external artifact —
#     the ABI/version fields below are shaped for that).
#
# INTEGRATION (sibling lanes) — LANDED (integration lane,
# work/sqlcipher-server-devhub-integration): the real read-only DB adapters
# live in app.devhub/messenger/adapter/{sqlite_reader,sqlcipher_reader}.spl
# and register through messenger_register_adapter at COMMAND time (never at
# import time — the registry still starts empty). Their execution drives the
# std.database.server storage port (explicit format= open path): sqlite3 for
# the plaintext pager backend, sqlcipher4 for the cipher-c page codec
# backend (per-page HMAC verified before any plaintext is released, §12.2).
# Both keep `read_only: true` and expose no send/write/rekey/DDL verbs — the
# capability closure remains the access boundary (§6.8).
#
# The built-in DB stub remains as the honest answer for an UNREGISTERED
# database kind: capabilities is [], and every read op returns
# CapabilityUnavailable("codec-not-integrated") — never a
# successful-looking placeholder (§6.2).

use app.devhub.messenger.config.{MessengerTarget}
use app.devhub.messenger.policy.{target_is_read_only, check_read, check_agent_body_access}


val MESSENGER_READ_PORT_ABI = "messenger.read.v1"

# Read verbs of the v1 ABI (§6.1 functional goals, first slice). `send` is
# deliberately NOT a read-port verb; the send contract is a separate port
# (messenger.send.v1) owned by the API lane.
val MESSENGER_READ_OPS = ["list_rooms", "list_members", "history", "fetch_message"]

val MESSENGER_PORT_OK = "ok"
val MESSENGER_PORT_PERMISSION_DENIED = "permission_denied"
val MESSENGER_PORT_CAPABILITY_UNAVAILABLE = "capability_unavailable"
# §11.2 exit code 2 (usage/config): a read was admitted by policy but the
# source cannot serve it (missing secret, wrong key, corrupt file, no
# adapter-side schema). Added by the DB adapter integration lane.
val MESSENGER_PORT_CONFIG_ERROR = "config_error"


class MessengerReadPortV1:
    """Versioned read adapter contract (§10.2 PluginDescriptorV1 shaped).

    capabilities lists the read verbs this adapter can actually serve;
    anything not listed answers CapabilityUnavailable, never a placeholder
    success. read_only is part of the TYPE: database adapters must set it,
    and the registry enforces that a read-only source cannot register a
    writable-looking port. unavailable_reason is the honest explanation for
    a stub adapter ("" for real adapters)."""
    abi: text                 # must equal MESSENGER_READ_PORT_ABI
    provider_id: text         # e.g. "messenger.sqlcipher4_database"
    provider_kind: text       # sqlite3_database | sqlcipher4_database | api | provider_specific
    semantic_version: text    # adapter semver, independent of ABI major
    interface_version: i64    # ABI major; only 1 is admitted today
    capabilities: [text]
    permissions: [text]       # declared least-privilege permissions
    read_only: bool
    unavailable_reason: text  # "" for real adapters; stub explains itself


class MessengerPortResult:
    """Uniform typed result for every port operation (§11.2 shape).

    status is one of MESSENGER_PORT_*; exit_code 0 ok / 2 config /
    3 permission / 4 unsupported. `payload` carries nonsecret data only."""
    status: text
    exit_code: i64
    payload: text
    error: text

    static fn ok(payload: text) -> MessengerPortResult:
        MessengerPortResult(status: MESSENGER_PORT_OK, exit_code: 0, payload: payload, error: "")

    static fn permission_denied(reason: text) -> MessengerPortResult:
        MessengerPortResult(status: MESSENGER_PORT_PERMISSION_DENIED, exit_code: 3, payload: "", error: reason)

    static fn capability_unavailable(reason: text) -> MessengerPortResult:
        MessengerPortResult(status: MESSENGER_PORT_CAPABILITY_UNAVAILABLE, exit_code: 4, payload: "", error: reason)

    static fn config_error(reason: text) -> MessengerPortResult:
        """Exit code 2 (§11.2 usage/config): policy admitted the read but
        the source cannot serve it. The reason is sanitized upstream —
        never a secret, key material, or absolute path."""
        MessengerPortResult(status: MESSENGER_PORT_CONFIG_ERROR, exit_code: 2, payload: "", error: reason)


# ----------------------------------------------------------------------------
# Pure registry operations (specs drive these directly — no global state)
# ----------------------------------------------------------------------------

fn registry_admit(ports: [MessengerReadPortV1], port: MessengerReadPortV1) -> ([MessengerReadPortV1], text):
    """Validate and append. Returns (new_list, error); error "" means
    admitted. Admission is fail-closed (§10.2): wrong ABI, unsupported
    interface major, empty provider_id, or a duplicate provider_id are all
    rejected; a read-only source kind cannot register a port that is not
    read_only (capability closure, §6.8)."""
    if port.abi != MESSENGER_READ_PORT_ABI:
        return (ports, "admission rejected: abi '{port.abi}' is not {MESSENGER_READ_PORT_ABI}")
    if port.interface_version != 1:
        return (ports, "admission rejected: unsupported interface major {port.interface_version}")
    if port.provider_id == "" or port.provider_kind == "":
        return (ports, "admission rejected: provider_id and provider_kind are required")
    if (port.provider_kind == "sqlite3_database" or port.provider_kind == "sqlcipher4_database") and not port.read_only:
        return (ports, "admission rejected: a database source adapter must be read_only (§6.8)")
    for existing in ports:
        if existing.provider_id == port.provider_id:
            return (ports, "admission rejected: provider_id '{port.provider_id}' is already registered")
    (ports + [port], "")


fn registry_find(ports: [MessengerReadPortV1], provider_kind: text) -> MessengerReadPortV1?:
    for port in ports:
        if port.provider_kind == provider_kind:
            return port
    nil


fn registry_capabilities(ports: [MessengerReadPortV1], provider_kind: text) -> [text]:
    """Truthful capability list for a provider kind; [] when unregistered."""
    val found = registry_find(ports, provider_kind)
    if found == nil:
        return []
    val port = found.?
    port.capabilities


# ----------------------------------------------------------------------------
# Module-level registry (the static registration surface) + lazy seam
# ----------------------------------------------------------------------------

var _registered_ports: [MessengerReadPortV1] = []


fn messenger_registered_adapters() -> [MessengerReadPortV1]:
    """Snapshot of the current registry (a copy — callers cannot mutate)."""
    var out: [MessengerReadPortV1] = []
    for port in _registered_ports:
        out = out + [port]
    out


fn messenger_register_adapter(port: MessengerReadPortV1) -> bool:
    """Static registration. Fails (returns false) on admission violation —
    never a silent drop."""
    val admitted = registry_admit(_registered_ports, port)
    if admitted.1 != "":
        return false
    _registered_ports = admitted.0
    true


fn messenger_reset_adapters():
    """Test hygiene + the lazy seam's escape hatch. Not called on any
    command path."""
    _registered_ports = []


fn messenger_stub_db_adapter(provider_kind: text) -> MessengerReadPortV1:
    """The INTEGRATION STUB for the sibling DB lanes. It declares NO
    capabilities (nothing works until the codec/pager land) and explains
    itself through unavailable_reason, so a read attempt is an honest
    CapabilityUnavailable("codec-not-integrated") — not an empty success."""
    MessengerReadPortV1(
        abi: MESSENGER_READ_PORT_ABI,
        provider_id: "messenger.{provider_kind}",
        provider_kind: provider_kind,
        semantic_version: "0.0.0-stub",
        interface_version: 1,
        capabilities: [],
        permissions: [],
        read_only: true,
        unavailable_reason: "codec-not-integrated"
    )


fn messenger_load_adapter(provider_kind: text) -> MessengerReadPortV1?:
    """THE LAZY SEAM. Callers obtain an adapter at COMMAND time through this
    function, never by importing adapter modules. Resolution order:
    registered adapter for the kind, else the built-in DB stub for database
    source kinds, else nil (api kinds have no stub — the API lane owns them).

    INTEGRATION: the sqlite_format pager lane and sqlcipher4 codec lane
    register their real adapters (or this seam is extended to construct
    them); everything downstream (cmd_messenger, future MCP surface) keeps
    calling this function unchanged."""
    val found = registry_find(_registered_ports, provider_kind)
    if found != nil:
        return found
    if provider_kind == "sqlite3_database" or provider_kind == "sqlcipher4_database":
        return messenger_stub_db_adapter(provider_kind)
    nil


# ----------------------------------------------------------------------------
# Port invocation — policy first, then capability, always typed results
# ----------------------------------------------------------------------------

fn port_call_read(port: MessengerReadPortV1, target: MessengerTarget, op: text, actor_kind: text) -> MessengerPortResult:
    """Dispatch one read verb through a port for a target.

    Order (deliberate):
      1. policy gate — read allowed, and message-body verbs additionally
         require the agent grant when actor is an agent (§12.2);
      2. capability gate — op must be advertised by the port, else
         CapabilityUnavailable (stub adapters answer with their
         unavailable_reason, e.g. 'codec-not-integrated');
      3. admission ok — execution itself is the adapter module's job (see
         the note at the return site below).
    """
    if not _in_ops(MESSENGER_READ_OPS, op):
        return MessengerPortResult.capability_unavailable("unsupported read verb '{op}' (want one of list_rooms|list_members|history|fetch_message)")
    val read_gate = check_read(target)
    if not read_gate.permitted:
        return MessengerPortResult.permission_denied(read_gate.reason)
    if (op == "history" or op == "fetch_message") and actor_kind == "agent":
        val body_gate = check_agent_body_access(target)
        if not body_gate.permitted:
            return MessengerPortResult.permission_denied(body_gate.reason)
    if not _in_ops(port.capabilities, op):
        if port.unavailable_reason != "":
            return MessengerPortResult.capability_unavailable(port.unavailable_reason)
        return MessengerPortResult.capability_unavailable("{op}-unsupported by {port.provider_id}")
    # Gates passed. For the registered real DB adapters, actual execution
    # lives in app.devhub.messenger.adapter.*_reader (they re-run these same
    # gates and return the rendered payload); this gate-level ok("") is the
    # admission signal for pure-data ports only (API adapters execute in the
    # API lane). A stub never reaches here — its empty capabilities fail the
    # gate above.
    MessengerPortResult.ok("")


fn port_call_send(port: MessengerReadPortV1, target: MessengerTarget) -> MessengerPortResult:
    """SEND through a READ port: always CapabilityUnavailable. The read port
    has no send verb by construction; even if it did, actual API send is out
    of scope for this lane and the future messenger.send.v1 port owns it.
    Policy checks happen BEFORE this call (policy.check_send) so a denied
    send is a PermissionDenied, never this stub."""
    if target_is_read_only(target):
        return MessengerPortResult.permission_denied("read-only database source cannot send (§6.8)")
    MessengerPortResult.capability_unavailable("send-not-integrated")


fn _in_ops(ops: [text], want: text) -> bool:
    for op in ops:
        if op == want:
            return true
    false
