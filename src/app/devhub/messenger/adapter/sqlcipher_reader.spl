# devhub messenger — SQLCipher 4 database read adapter (integration lane).
#
# Replaces the devhub-msg CapabilityUnavailable stub for provider_kind
# "sqlcipher4_database" with the real read-only adapter. Execution drives
# the std.database.server storage port's format=sqlcipher4 open path:
# cipher-b key session (PBKDF2-HMAC-SHA512, locked sqlcipher4_4k_sha512
# profile) + cipher-c page codec (per-page HMAC verified BEFORE any
# plaintext is released) + the merged sqlite_format pager over the decoded
# snapshot. The passphrase arrives as a SecretRef (codec/secret_ref.spl) —
# never as a function argument, never as text in this module.
#
# REGISTRATION (lazy seam contract, plugin_access.spl): importing this
# module registers NOTHING and touches no filesystem/env/network. The
# caller (a devhub command handler, or a spec) invokes
# messenger_register_sqlcipher4_adapter() at command time; the plugin_access
# registry then serves this port through messenger_load_adapter.
#
# READ-ONLY (§6.8): no write/send/rekey/DDL verb exists here. The port gate
# (plugin_access.port_call_read) and the execution core (adapter/db_common)
# both enforce the policy matrix; a denied read is a typed
# PermissionDenied, never an empty success.

use app.devhub.messenger.plugin_access.{
    MessengerReadPortV1, MessengerPortResult, MESSENGER_READ_PORT_ABI,
    messenger_register_adapter
}
use app.devhub.messenger.config.{MessengerTarget}
use app.devhub.messenger.adapter.db_common.{
    messenger_db_list_rooms, messenger_db_list_members,
    messenger_db_history, messenger_db_fetch_message
}

val MESSENGER_SQLCIPHER4_ADAPTER_VERSION: text = "1.0.0"
val MESSENGER_SQLCIPHER4_FORMAT: text = "sqlcipher4"

# The real adapter value: all four read verbs, read-only by construction,
# no unavailable_reason (it can actually serve what it advertises).
fn messenger_sqlcipher4_db_adapter() -> MessengerReadPortV1:
    MessengerReadPortV1(
        abi: MESSENGER_READ_PORT_ABI,
        provider_id: "messenger.sqlcipher4_database",
        provider_kind: "sqlcipher4_database",
        semantic_version: MESSENGER_SQLCIPHER4_ADAPTER_VERSION,
        interface_version: 1,
        capabilities: ["list_rooms", "list_members", "history", "fetch_message"],
        permissions: ["messenger.db.read"],
        read_only: true,
        unavailable_reason: "")

# Command-time registration (lazy seam). Returns false only on an
# admission violation (duplicate provider_id) — never a silent drop.
fn messenger_register_sqlcipher4_adapter() -> bool:
    messenger_register_adapter(messenger_sqlcipher4_db_adapter())

# ----------------------------------------------------------------------------
# Execution verbs — policy-gated, read-only, payload-bearing.
# ----------------------------------------------------------------------------

fn messenger_sqlcipher4_list_rooms(target: MessengerTarget, actor_kind: text) -> MessengerPortResult:
    messenger_db_list_rooms(target, MESSENGER_SQLCIPHER4_FORMAT, actor_kind)

fn messenger_sqlcipher4_list_members(target: MessengerTarget, room: text, actor_kind: text) -> MessengerPortResult:
    messenger_db_list_members(target, MESSENGER_SQLCIPHER4_FORMAT, room, actor_kind)

fn messenger_sqlcipher4_history(target: MessengerTarget, room: text, limit: i64, actor_kind: text) -> MessengerPortResult:
    messenger_db_history(target, MESSENGER_SQLCIPHER4_FORMAT, room, limit, actor_kind)

fn messenger_sqlcipher4_fetch_message(target: MessengerTarget, message_id: text, actor_kind: text) -> MessengerPortResult:
    messenger_db_fetch_message(target, MESSENGER_SQLCIPHER4_FORMAT, message_id, actor_kind)

export MESSENGER_SQLCIPHER4_ADAPTER_VERSION, MESSENGER_SQLCIPHER4_FORMAT
export messenger_sqlcipher4_db_adapter, messenger_register_sqlcipher4_adapter
export messenger_sqlcipher4_list_rooms, messenger_sqlcipher4_list_members
export messenger_sqlcipher4_history, messenger_sqlcipher4_fetch_message
