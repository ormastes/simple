# devhub messenger — plaintext SQLite database read adapter (integration
# lane). Twin of adapter/sqlcipher_reader.spl over the storage port's
# sqlite3 (plaintext pager) backend: same read-only verbs, same policy
# gates, same payload shape. A target's secret_ref is NOT used by this
# backend (the port rejects a secret for plaintext formats); it stays
# opaque configuration data.
#
# See sqlcipher_reader.spl for the registration discipline (command-time,
# lazy seam) and the read-only policy record.

use app.devhub.messenger.plugin_access.{
    MessengerReadPortV1, MessengerPortResult, MESSENGER_READ_PORT_ABI,
    messenger_register_adapter
}
use app.devhub.messenger.config.{MessengerTarget}
use app.devhub.messenger.adapter.db_common.{
    messenger_db_list_rooms, messenger_db_list_members,
    messenger_db_history, messenger_db_fetch_message
}

val MESSENGER_SQLITE3_ADAPTER_VERSION: text = "1.0.0"
val MESSENGER_SQLITE3_FORMAT: text = "sqlite3"

fn messenger_sqlite3_db_adapter() -> MessengerReadPortV1:
    MessengerReadPortV1(
        abi: MESSENGER_READ_PORT_ABI,
        provider_id: "messenger.sqlite3_database",
        provider_kind: "sqlite3_database",
        semantic_version: MESSENGER_SQLITE3_ADAPTER_VERSION,
        interface_version: 1,
        capabilities: ["list_rooms", "list_members", "history", "fetch_message"],
        permissions: ["messenger.db.read"],
        read_only: true,
        unavailable_reason: "")

fn messenger_register_sqlite3_adapter() -> bool:
    messenger_register_adapter(messenger_sqlite3_db_adapter())

fn messenger_sqlite3_list_rooms(target: MessengerTarget, actor_kind: text) -> MessengerPortResult:
    messenger_db_list_rooms(target, MESSENGER_SQLITE3_FORMAT, actor_kind)

fn messenger_sqlite3_list_members(target: MessengerTarget, room: text, actor_kind: text) -> MessengerPortResult:
    messenger_db_list_members(target, MESSENGER_SQLITE3_FORMAT, room, actor_kind)

fn messenger_sqlite3_history(target: MessengerTarget, room: text, limit: i64, actor_kind: text) -> MessengerPortResult:
    messenger_db_history(target, MESSENGER_SQLITE3_FORMAT, room, limit, actor_kind)

fn messenger_sqlite3_fetch_message(target: MessengerTarget, message_id: text, actor_kind: text) -> MessengerPortResult:
    messenger_db_fetch_message(target, MESSENGER_SQLITE3_FORMAT, message_id, actor_kind)

export MESSENGER_SQLITE3_ADAPTER_VERSION, MESSENGER_SQLITE3_FORMAT
export messenger_sqlite3_db_adapter, messenger_register_sqlite3_adapter
export messenger_sqlite3_list_rooms, messenger_sqlite3_list_members
export messenger_sqlite3_history, messenger_sqlite3_fetch_message
