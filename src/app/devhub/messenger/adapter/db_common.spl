# devhub messenger — shared read-only DB adapter execution core.
#
# Consumed by adapter/sqlcipher_reader.spl and adapter/sqlite_reader.spl.
# This module owns the EXECUTION half of the messenger DB read verbs: it
# drives the std.database.server storage port (the plan's format= open
# path) and renders typed rows into the CLI's JSON-record payload shape.
# Adapter VALUE construction and registration live in the sibling reader
# modules; policy gates live in messenger/policy.spl; the port contract
# lives in messenger/plugin_access.spl (imported here for the result type —
# the dependency graph stays acyclic: plugin_access never imports this
# module).
#
# READ-ONLY (§6.8, recorded policy): the only mutation any function here can
# perform is the storage port's close_view zeroization of the decrypted
# snapshot. There is no write verb, no send verb, no rekey, no DDL. The
# storage port itself exposes no write path for file backends.
#
# Policy re-check: every verb re-runs the same typed gates as
# plugin_access.port_call_read (check_read; agent body access for
# history/fetch_message) so a caller that skipped the port gate is still
# denied. Defense in depth, not a second policy.

use app.devhub.messenger.config.{
    MessengerTarget, MESSENGER_DEFAULT_MAX_READ_BATCH
}
use app.devhub.messenger.policy.{
    check_read, check_agent_body_access
}
use app.devhub.messenger.schema_profile.{
    SchemaProfile, is_valid_sqlite_identifier
}
use app.devhub.messenger.plugin_access.{
    MessengerPortResult, MESSENGER_PORT_OK, MESSENGER_PORT_CONFIG_ERROR
}
use std.database.server.storage_port.{
    database_storage_port_v1, StorageOpenResult, StoragePortError
}
use std.database.sql.types.{DbRow, DbValue}

val MESSENGER_ADAPTER_HISTORY_DEFAULT_LIMIT: i64 = 50

# ----------------------------------------------------------------------------
# Small JSON render helpers (house rule: braces composed, not interpolated —
# see cmd_messenger._lb/_rb).
# ----------------------------------------------------------------------------

fn _lb() -> text:
    "{"

fn _rb() -> text:
    "}"

fn _json_escape(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")

fn _json_str(value: text) -> text:
    "\"{_json_escape(value)}\""

# ----------------------------------------------------------------------------
# Row helpers
# ----------------------------------------------------------------------------

# Value of column `name` in a typed row; nil when absent or NULL.
fn _col(row: DbRow, name: text) -> DbValue?:
    var i = 0
    while i < row.columns.len():
        if row.columns[i] == name:
            return Some(row.values[i])
        i = i + 1
    nil

# Text form of a column value; NULL/missing -> "".
fn _col_text(row: DbRow, name: text) -> text:
    match _col(row, name):
        Some(v):
            match v:
                DbValue.Null:
                    ""
                other:
                    other.to_text()
        nil:
            ""

fn _col_int(row: DbRow, name: text) -> i64:
    match _col(row, name):
        Some(v):
            v.as_int() ?? -1
        nil:
            -1

# ----------------------------------------------------------------------------
# Internal read channel: typed rows or an already-rendered failure.
# ----------------------------------------------------------------------------

enum DbReadOutcome:
    Rows(rows: [DbRow])
    Failed(result: MessengerPortResult)

# Open the target's DB through the storage port (explicit format= open
# path), read one table fully, release the plaintext snapshot. The secret
# argument is the target's SecretRef and reaches the port ONLY for the
# sqlcipher4 format; plaintext formats pass "" (their backend rejects a
# secret, and none is needed).
fn _read_table(target: MessengerTarget, format_name: text, table: text) -> DbReadOutcome:
    if target.db == nil:
        return DbReadOutcome.Failed(MessengerPortResult.config_error("target '{target.name}' has no db block"))
    val db = target.db.?
    if not is_valid_sqlite_identifier(table):
        return DbReadOutcome.Failed(MessengerPortResult.config_error("table name '{table}' rejected by the identifier gate"))
    val secret = if format_name == "sqlcipher4": db.secret_ref else: ""
    val port = database_storage_port_v1()
    val opened = match port.open(db.path, format_name, secret):
        Ok(r):
            r
        Err(e):
            return DbReadOutcome.Failed(_map_open_error(e))
    val outcome = match opened:
        case StorageOpenResult.SqliteView(view):
            val rows = match port.read_table(view, table):
                Ok(r):
                    r
                Err(e):
                    val _z = port.close_view(view)
                    return DbReadOutcome.Failed(_map_open_error(e))
            val _z = port.close_view(view)
            DbReadOutcome.Rows(rows: rows)
        case StorageOpenResult.NativeStore(_store):
            DbReadOutcome.Failed(MessengerPortResult.config_error("target '{target.name}' is not a file-backed messenger database"))
    return outcome

fn _map_open_error(e: StoragePortError) -> MessengerPortResult:
    match e:
        StoragePortError.MissingSecret(d):
            MessengerPortResult.config_error("missing-secret: {d}")
        StoragePortError.AuthenticationFailed(_):
            # Never echo codec detail: a wrong-key class is config, and the
            # message must not help a guesser.
            MessengerPortResult.config_error("authentication-failed (wrong key or modified database)")
        StoragePortError.CorruptSource(_):
            MessengerPortResult.config_error("corrupt-source")
        StoragePortError.Io(_):
            MessengerPortResult.config_error("source-unavailable")
        StoragePortError.InvalidFormat(d):
            MessengerPortResult.config_error("invalid-format: {d}")
        StoragePortError.UnsupportedFormat(d):
            MessengerPortResult.config_error("unsupported-format: {d}")

# ----------------------------------------------------------------------------
# Policy re-check (same gates as plugin_access.port_call_read)
# ----------------------------------------------------------------------------

fn _read_gate(target: MessengerTarget, actor_kind: text, body_op: bool) -> MessengerPortResult?:
    val read_gate = check_read(target)
    if not read_gate.permitted:
        return Some(MessengerPortResult.permission_denied(read_gate.reason))
    if body_op and actor_kind == "agent":
        val body_gate = check_agent_body_access(target)
        if not body_gate.permitted:
            return Some(MessengerPortResult.permission_denied(body_gate.reason))
    nil

fn _schema_of(target: MessengerTarget) -> SchemaProfile?:
    target.schema

# ----------------------------------------------------------------------------
# Verbs (each: policy gate -> schema profile -> read -> render)
# ----------------------------------------------------------------------------

fn messenger_db_list_rooms(target: MessengerTarget, format_name: text, actor_kind: text) -> MessengerPortResult:
    if val gate = _read_gate(target, actor_kind, false):
        return gate
    match _schema_of(target):
        case nil:
            return MessengerPortResult.config_error("target '{target.name}' has no schema profile")
        case Some(profile):
            val outcome = match _read_table(target, format_name, profile.room_table):
                case DbReadOutcome.Failed(result):
                    result
                case DbReadOutcome.Rows(rows):
                    var payload = _lb() + "\"rooms\":["
                    var i = 0
                    while i < rows.len():
                        if i > 0:
                            payload = payload + ","
                        payload = payload + _lb() +
                            "\"id\":{_json_str(_col_text(rows[i], profile.room_id))}," +
                            "\"name\":{_json_str(_col_text(rows[i], profile.room_name))}" + _rb()
                        i = i + 1
                    MessengerPortResult.ok(payload + "],\"count\":{rows.len()}" + _rb())
            return outcome

fn messenger_db_list_members(target: MessengerTarget, format_name: text, room: text, actor_kind: text) -> MessengerPortResult:
    if val gate = _read_gate(target, actor_kind, false):
        return gate
    match _schema_of(target):
        case nil:
            return MessengerPortResult.config_error("target '{target.name}' has no schema profile")
        case Some(profile):
            val outcome = match _read_table(target, format_name, profile.member_table):
                case DbReadOutcome.Failed(result):
                    result
                case DbReadOutcome.Rows(rows):
                    var payload = _lb() + "\"members\":["
                    var i = 0
                    var count = 0
                    while i < rows.len():
                        if room == "" or _col_text(rows[i], profile.member_room_id) == room:
                            if count > 0:
                                payload = payload + ","
                            payload = payload + _lb() +
                                "\"room_id\":{_json_str(_col_text(rows[i], profile.member_room_id))}," +
                                "\"identity_id\":{_json_str(_col_text(rows[i], profile.member_identity_id))}," +
                                "\"joined_at\":{_json_str(_col_text(rows[i], profile.member_joined_at))}" + _rb()
                            count = count + 1
                        i = i + 1
                    MessengerPortResult.ok(payload + "],\"count\":{count}" + _rb())
            return outcome

# One message row rendered as a JSON object (body included: reaching this
# point means the policy gate admitted the caller).
fn _message_json(row: DbRow, profile: SchemaProfile) -> text:
    _lb() +
        "\"id\":{_json_str(_col_text(row, profile.message_id))}," +
        "\"room_id\":{_json_str(_col_text(row, profile.message_room_id))}," +
        "\"sender_id\":{_json_str(_col_text(row, profile.message_sender_id))}," +
        "\"created_at\":{_json_str(_col_text(row, profile.message_created_at))}," +
        "\"seq\":{_json_str(_col_text(row, profile.message_sequence))}," +
        "\"body\":{_json_str(_col_text(row, profile.message_body))}" + _rb()

fn messenger_db_history(target: MessengerTarget, format_name: text, room: text, limit: i64, actor_kind: text) -> MessengerPortResult:
    if val gate = _read_gate(target, actor_kind, true):
        return gate
    match _schema_of(target):
        case nil:
            return MessengerPortResult.config_error("target '{target.name}' has no schema profile")
        case Some(profile):
            var bounded = limit
            if bounded <= 0:
                bounded = MESSENGER_ADAPTER_HISTORY_DEFAULT_LIMIT
            if bounded > MESSENGER_DEFAULT_MAX_READ_BATCH:
                bounded = MESSENGER_DEFAULT_MAX_READ_BATCH
            val outcome = match _read_table(target, format_name, profile.message_table):
                case DbReadOutcome.Failed(result):
                    result
                case DbReadOutcome.Rows(rows):
                    # Rows arrive in ascending rowid order; history is
                    # seq-ordered within a room (§7.4: sequence_kind is
                    # monotonic_within_room for this schema profile).
                    var payload = _lb() + "\"room\":{_json_str(room)},\"messages\":["
                    var i = 0
                    var count = 0
                    while i < rows.len():
                        if _col_text(rows[i], profile.message_room_id) == room:
                            if count > 0:
                                payload = payload + ","
                            payload = payload + _message_json(rows[i], profile)
                            count = count + 1
                            if count >= bounded:
                                break
                        i = i + 1
                    MessengerPortResult.ok(payload + "],\"count\":{count}" + _rb())
            return outcome

fn messenger_db_fetch_message(target: MessengerTarget, format_name: text, message_id: text, actor_kind: text) -> MessengerPortResult:
    if val gate = _read_gate(target, actor_kind, true):
        return gate
    match _schema_of(target):
        case nil:
            return MessengerPortResult.config_error("target '{target.name}' has no schema profile")
        case Some(profile):
            val outcome = match _read_table(target, format_name, profile.message_table):
                case DbReadOutcome.Failed(result):
                    result
                case DbReadOutcome.Rows(rows):
                    var i = 0
                    while i < rows.len():
                        if _col_text(rows[i], profile.message_id) == message_id:
                            return MessengerPortResult.ok(_message_json(rows[i], profile))
                        i = i + 1
                    MessengerPortResult.ok(_lb() + "\"found\":false,\"id\":{_json_str(message_id)}" + _rb())
            return outcome

export MESSENGER_ADAPTER_HISTORY_DEFAULT_LIMIT
export messenger_db_list_rooms, messenger_db_list_members
export messenger_db_history, messenger_db_fetch_message
