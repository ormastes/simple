# Pure, bounded sequence selection shared by the read-only database adapter.
use std.database.sql.types.{DbRow, DbValue}

fn _history_column(row: DbRow, name: text) -> DbValue?:
    var i = 0
    while i < row.columns.len() and i < row.values.len():
        if row.columns[i] == name:
            return Some(row.values[i])
        i = i + 1
    nil

fn messenger_history_rows(rows: [DbRow], room_column: text, sequence_column: text, room: text, limit: i64) -> Result<[DbRow], text>:
    if limit <= 0:
        return Err("history limit must be positive")
    var selected: [DbRow] = []
    var sequences: [i64] = []
    for row in rows:
        if row.columns.len() != row.values.len():
            return Err("malformed history row")
        val row_room: text = match _history_column(row, room_column):
            case Some(DbValue.Null): return Err("history room column unavailable")
            case Some(cell): cell.to_text()
            case nil: return Err("history room column unavailable")
        if row_room != room:
            continue
        val sequence: i64 = match _history_column(row, sequence_column):
            case Some(DbValue.Integer(number)): number
            case _: return Err("history sequence must be an integer")
        # Retain the lowest `limit` sequences. Validate every matching row,
        # including those outside the returned page. Equal keys stay in source
        # order, and retained memory stays bounded by the admitted page size.
        if selected.len() < limit:
            selected.push(row)
            sequences.push(sequence)
        elif sequence < sequences[sequences.len() - 1]:
            selected[selected.len() - 1] = row
            sequences[sequences.len() - 1] = sequence
        else:
            continue
        var index = selected.len() - 1
        while index > 0 and sequences[index] < sequences[index - 1]:
            val previous_row = selected[index - 1]
            val previous_sequence = sequences[index - 1]
            selected[index - 1] = selected[index]
            sequences[index - 1] = sequences[index]
            selected[index] = previous_row
            sequences[index] = previous_sequence
            index = index - 1
    Ok(selected)
