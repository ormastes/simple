# devhub messenger — read-only enforcement as data.
#
# Plan: simple_devhub_sqlite_sqlcipher_messenger_master_plan_2026-10-21.md
# §6.8 (messenger DB read-only enforcement, not advisory), §6.7 (send
# contracts, delivery receipts), §12.2 (read-only invariants, agent access,
# sending invariants), §11.2 (exit codes).
#
# This module is PURE: every function takes a typed MessengerTarget and
# returns a typed verdict — no I/O, no environment, no registry. The gh-compat
# lesson applies: translation/policy must be pure and offline-testable.
#
# Type-level read-only (§6.8): a target whose read_provider is a database
# source (sqlite3_database | sqlcipher4_database) IS ReadOnly by construction.
# There is no boolean to flip, no advisory flag — the only representation of
# a DB source is read-only. Every send/write/rekey/DDL/mutation path asks
# these functions first and returns a typed PermissionDenied (exit 3) on
# denial. Actual outbound API send is OUT OF SCOPE for this lane: after the
# policy gate passes, the port itself answers CapabilityUnavailable (see
# plugin_access.spl), so no code path can claim a send happened.
#
# Exit codes (§11.2): 0 ok, 2 usage/config, 3 permission denied,
# 4 unsupported capability. Denials here are always 3 unless noted.

use app.devhub.messenger.config.{MessengerTarget, MessengerPolicy}


val POLICY_OK = "ok"
val POLICY_READ_ONLY_SOURCE = "read_only_source"
val POLICY_SEND_DISABLED = "send_disabled"
val POLICY_SEND_NOT_ALLOWED = "send_not_allowed"
val POLICY_CONFIRMATION_REQUIRED = "confirmation_required"
val POLICY_AGENT_BODY_DENIED = "agent_body_denied"
val POLICY_SOURCE_MUTATION_DENIED = "source_mutation_denied"
val POLICY_ROOM_NOT_ALLOWLISTED = "room_not_allowlisted"


class PermissionVerdict:
    """Typed result of one policy check. `permitted` with code POLICY_OK, or
    denied with a stable machine code and a human reason. exit_code follows
    §11.2 (denials are 3)."""
    permitted: bool
    code: text
    exit_code: i64
    reason: text

    static fn permit() -> PermissionVerdict:
        PermissionVerdict(permitted: true, code: POLICY_OK, exit_code: 0, reason: "")

    static fn deny(code: text, reason: text) -> PermissionVerdict:
        PermissionVerdict(permitted: false, code: code, exit_code: 3, reason: reason)


class SendConfirmReceipt:
    """The explicit-confirmation receipt shape (§6.7 delivery contract).

    Pure data: confirmation is a USER decision recorded BEFORE any port call.
    `body_digest` binds the exact body bytes (FNV-1a hex via the schema
    profile hash discipline) so a replayed or edited body does not match a
    stale receipt. The port send itself is stubbed CapabilityUnavailable in
    this lane; the receipt is what the future sender must verify against
    target/room/body digest and re-check policy at dispatch time (§6.7)."""
    receipt_id: text
    target: text
    room: text
    body_digest: text
    confirmed_by: text
    policy_code: text

    static fn create(receipt_id: text, target: text, room: text, body_digest: text, confirmed_by: text) -> SendConfirmReceipt:
        SendConfirmReceipt(
            receipt_id: receipt_id, target: target, room: room,
            body_digest: body_digest, confirmed_by: confirmed_by,
            policy_code: POLICY_OK
        )


# ----------------------------------------------------------------------------
# Type-level read-only
# ----------------------------------------------------------------------------

fn target_is_read_only(target: MessengerTarget) -> bool:
    """A database source is read-only at the TYPE level (§6.8): the provider
    kind decides, and no config field can widen it. API sources are not
    read-only but are still send-gated by check_send."""
    target.read_provider == "sqlite3_database" or target.read_provider == "sqlcipher4_database"


fn target_read_capabilities(target: MessengerTarget) -> [text]:
    """Truthful capability advertisement for `targets`/`capabilities`
    output: the read verbs the read_provider family supports. `send` is
    NEVER listed — a read port has no send verb, and a database source has
    none at all (§6.8)."""
    ["list_rooms", "list_members", "history", "fetch_message"]


# ----------------------------------------------------------------------------
# Read path
# ----------------------------------------------------------------------------

fn check_read(target: MessengerTarget) -> PermissionVerdict:
    """Reading metadata/rooms/members/history through the read provider is
    the purpose of the lane and is permitted for the interactive user on any
    valid target. Agent (LLM/MCP) access is a separate, narrower gate —
    see check_agent_body_access (§12.2: an agent without a read grant gets
    metadata/denial, not content)."""
    if target.read_provider == "":
        return PermissionVerdict.deny(POLICY_SOURCE_MUTATION_DENIED, "target '{target.name}' declares no read_provider")
    PermissionVerdict.permit()


fn check_agent_body_access(target: MessengerTarget) -> PermissionVerdict:
    """Agent (LLM/MCP) access to MESSAGE BODIES. Default DENY (§7.1, §12.2):
    expose_message_body_to_agents must be explicitly true in the user's own
    untracked messenger.sdn; a repository or session can never set it."""
    if target.policy.expose_message_body_to_agents:
        return PermissionVerdict.permit()
    PermissionVerdict.deny(
        POLICY_AGENT_BODY_DENIED,
        "agent body access denied for target '{target.name}' (expose_message_body_to_agents is false; set it in ~/.config/devhub/messenger.sdn to grant)")


# ----------------------------------------------------------------------------
# Send path (gating only — the port send is CapabilityUnavailable this lane)
# ----------------------------------------------------------------------------

fn check_send(target: MessengerTarget, room: text, confirm: SendConfirmReceipt?) -> PermissionVerdict:
    """Full send gate, in §6.7/§12.2 order:

      1. a read-only (database) source can NEVER send (type-level, §6.8);
      2. send_provider must be 'api';
      3. target send_enabled must be true;
      4. policy allow_remote_send must be true;
      5. the room must be in send_room_allowlist (unless the allowlist is 'none'
         — which means NO room may be sent to; an empty allowlist denies);
      6. an explicit, matching SendConfirmReceipt must be present.

    Passing this gate only means the request may reach the send PORT; the
    port in this lane answers CapabilityUnavailable('send-not-integrated')."""
    if target_is_read_only(target):
        return PermissionVerdict.deny(
            POLICY_READ_ONLY_SOURCE,
            "target '{target.name}' is a read-only database source and cannot send (§6.8)")
    if target.send_provider != "api":
        return PermissionVerdict.deny(
            POLICY_SEND_DISABLED,
            "target '{target.name}' declares send_provider '{target.send_provider}'; only 'api' sources can send")
    if not target.send_enabled:
        return PermissionVerdict.deny(
            POLICY_SEND_DISABLED,
            "target '{target.name}' has send_enabled: false")
    if not target.policy.allow_remote_send:
        return PermissionVerdict.deny(
            POLICY_SEND_NOT_ALLOWED,
            "target '{target.name}' policy denies remote send (allow_remote_send: false)")
    if not _room_send_allowlisted(target.policy, room):
        return PermissionVerdict.deny(
            POLICY_ROOM_NOT_ALLOWLISTED,
            "room '{room}' is not in the send_room_allowlist of target '{target.name}'")
    if confirm == nil:
        return PermissionVerdict.deny(
            POLICY_CONFIRMATION_REQUIRED,
            "sending requires explicit user confirmation (--confirm with a fresh SendConfirmReceipt)")
    val receipt = confirm.?
    if receipt.target != target.name or receipt.room != room:
        return PermissionVerdict.deny(
            POLICY_CONFIRMATION_REQUIRED,
            "confirmation receipt does not match target '{target.name}' room '{room}'")
    PermissionVerdict.permit()


fn _room_send_allowlisted(policy: MessengerPolicy, room: text) -> bool:
    """'none' (the default) allowlists NOTHING — the deny-by-default posture.
    Otherwise a comma-separated list of room identifiers."""
    if policy.send_room_allowlist == "none" or policy.send_room_allowlist == "":
        return false
    for entry in policy.send_room_allowlist.split(","):
        if entry.trim() == room:
            return true
    false


# ----------------------------------------------------------------------------
# Source-mutation paths (all denied for read-only sources, §6.8)
# ----------------------------------------------------------------------------

fn check_source_mutation(target: MessengerTarget, op: text) -> PermissionVerdict:
    """Any write/rekey/DDL/checkpoint/attach/vacuum/mark-read side effect on
    the SOURCE. For a database source these are structurally impossible
    (read-only OS handle, §6.8) — the verdict says so in machine code. For an
    api source, mark-read/presence-style side effects are still denied unless
    the policy explicitly allows them (read receipts are off by default,
    §6.7)."""
    if target_is_read_only(target):
        return PermissionVerdict.deny(
            POLICY_SOURCE_MUTATION_DENIED,
            "'{op}' denied: target '{target.name}' is a read-only database source (§6.8: no rekey, DDL, checkpoint, mark-read, or any source write)")
    if op == "mark_read" and not target.policy.allow_mark_read:
        return PermissionVerdict.deny(
            POLICY_SOURCE_MUTATION_DENIED,
            "'mark_read' denied: target '{target.name}' policy has allow_mark_read: false (§6.7: no read receipts by default)")
    if op == "live_presence" and not target.policy.allow_live_presence:
        return PermissionVerdict.deny(
            POLICY_SOURCE_MUTATION_DENIED,
            "'live_presence' denied: target '{target.name}' policy has allow_live_presence: false")
    PermissionVerdict.permit()


# ----------------------------------------------------------------------------
# Receipt digest helper (pure; binds a body to a confirmation)
# ----------------------------------------------------------------------------

fn _xor_nonneg(a: i64, b: i64) -> i64:
    a + b - 2 * (a & b)


fn messenger_body_digest(body: text) -> text:
    """FNV-1a 32 over the body characters (same discipline as
    schema_profile._fnv1a32_hex; kept separate to avoid importing a private).
    Binds an exact body to a SendConfirmReceipt — a replayed or edited body
    has a different digest and fails the confirmation match."""
    val FNV_OFFSET: i64 = 2166136261
    val FNV_PRIME: i64 = 16777619
    val MASK: i64 = 4294967295
    var hash: i64 = FNV_OFFSET
    for ch in body.chars():
        val c = ch.char_code_at(0) & MASK
        hash = _xor_nonneg(hash, c) & MASK
        hash = (hash * FNV_PRIME) & MASK
    val digits = "0123456789abcdef"
    var out = ""
    var shift: i64 = 28
    while shift >= 0:
        val nibble = (hash >> shift) & 15
        out = out + digits[nibble:nibble + 1]
        shift = shift - 4
    out
