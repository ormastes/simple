# ITF CLI — Configuration (SDN format)
#
# Config: ~/.config/itf/config.sdn
# Auth:   ~/.config/itf/auth.sdn

use std.nogc_sync_mut.env.{env_get, env_has}
use std.nogc_sync_mut.file_system.file_ops.{file_read_text, file_write_text, file_exists}
use std.nogc_sync_mut.io.process_ops.{process_run}
use std.json.{json_parse, json_object_get, json_serialize}
use app.devhub.errors.{ItfError}


class ItfConfig:
    confluence_url: text
    confluence_user: text
    confluence_default_space: text
    jira_url: text
    jira_acli_path: text
    jira_email: text
    default_output: text
    color_mode: text
    editor_override: text
    pager_override: text
    token_cmds: [(text, text)]  # (provider, shell command) pairs from [token_cmd] section
    wiki_default_backend: text  # [wiki] default_backend: confluence|github (D1 in devhub_overview.md; gap G6) — "" means unset, cmd_wiki.spl falls back to "confluence"
    tasks_default_backend: text  # [tasks] default_backend: jira|github (D1 in devhub_overview.md; gap G6) — "" means unset, cmd_tasks.spl falls back to "github"
    tasks_jira_done_status: text  # [tasks] jira_done_status: <status> (D5 in cmd_tasks.spl, gap G6) — "" means unset, cmd_tasks.spl falls back to "Done"
    git_default_backend: text  # [git] default_backend: github|bitbucket (D1 in devhub_overview.md). This closes the drift that doc named explicitly: "git.default_backend does not exist yet". "" means unset — backend_resolve.spl falls through to the git-remote sniff.
    bb_workspace: text  # [bitbucket] workspace: <slug>. Previously resolvable ONLY from --workspace or BB_WORKSPACE (design §4 "Still missing"), so a repo could not record its own workspace.
    bb_repo: text  # [bitbucket] repo: <slug>. Same gap as bb_workspace.
    token_envs: [(text, text)]  # (provider, ENV VAR NAME) pairs from the [token_env] section. The NAME of the variable, never the secret. Mirrors token_cmds; see resolve_auth_token().

    static fn default() -> ItfConfig:
        ItfConfig(
            confluence_url: "",
            confluence_user: "",
            confluence_default_space: "",
            jira_url: "",
            jira_acli_path: "acli",
            jira_email: "",
            default_output: "text",
            color_mode: "auto",
            editor_override: "",
            pager_override: "",
            token_cmds: [],
            wiki_default_backend: "",
            tasks_default_backend: "",
            tasks_jira_done_status: "",
            git_default_backend: "",
            bb_workspace: "",
            bb_repo: "",
            token_envs: []
        )


fn config_dir() -> text:
    """Get config directory path."""
    val home = env_get("HOME")
    if home == "":
        val userprofile = env_get("USERPROFILE")
        if userprofile != "":
            return "{userprofile}/.config/itf"
    "{home}/.config/itf"


fn config_path() -> text:
    """Get main config file path."""
    "{config_dir()}/config.sdn"


fn auth_path() -> text:
    """Get auth token file path."""
    "{config_dir()}/auth.sdn"


fn load_config() -> ItfConfig:
    """Load config from SDN file, returning defaults if not found."""
    val path = config_path()
    if not file_exists(path):
        return ItfConfig.default()

    val content = file_read_text(path)
    if content == nil:
        return ItfConfig.default()

    var config = ItfConfig.default()
    for entry in parse_sdn_sections(content):
        config = _apply_config_value(config, entry.0, entry.1, entry.2)
    config


fn parse_sdn_sections(content: text) -> [(text, text, text)]:
    """Parse the SDN subset devhub's config files use into (section, key,
    value) triples, in file order. A top-level key outside any section gets
    section "".

    Extracted from load_config() so the repo-level `.spipe/config.sdn`
    (read by backend_resolve.spl) shares ONE parser with the user-level
    `~/.config/itf/config.sdn` instead of growing a second, subtly different
    one — including the first-colon fix below, which a hand-rolled second
    parser would almost certainly have got wrong again.

    First-colon-only split (bug itf-config-colon-value-split): `.split(":", 2)`
    splits on EVERY colon, not just the first two, so a value containing its
    own colon (a URL like `https://x.atlassian.net/wiki`, or a token_cmd shell
    command with `://` in it) was truncated at the SECOND colon. `.find`
    locates only the first colon; everything after it is the value, verbatim
    (bug_db.sdn: FIXED 2026-07-20 first-colon split + round-trip specs).
    """
    var out: [(text, text, text)] = []
    var section = ""
    for line in content.split("\n"):
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            pass_dn
        else if trimmed.ends_with(":") and not trimmed.contains(" "):
            # Section header like "confluence:"
            section = trimmed.replace(":", "")
        else if trimmed.contains(":"):
            val colon_idx = trimmed.find(":")
            val key = trimmed[0:colon_idx].trim()
            val value = trimmed[colon_idx + 1:].trim()
            out = out + [(section, key, value)]
    out


fn _with(config: ItfConfig, confluence_url: text, confluence_user: text, confluence_default_space: text, jira_url: text, jira_acli_path: text, jira_email: text, default_output: text, color_mode: text, editor_override: text, pager_override: text, token_cmds: [(text, text)]) -> ItfConfig:
    """Rebuild an ItfConfig with the given field values (helper so each
    _apply_config_value branch only needs to name the ONE field it changes,
    instead of re-listing all 11 — added when jira_email/token_cmds landed;
    the older branches below already existed as fully-spelled-out copies and
    still work, this just gives new/edited branches a shorter form)."""
    ItfConfig(
        confluence_url: confluence_url, confluence_user: confluence_user, confluence_default_space: confluence_default_space,
        jira_url: jira_url, jira_acli_path: jira_acli_path, jira_email: jira_email,
        default_output: default_output, color_mode: color_mode,
        editor_override: editor_override, pager_override: pager_override, token_cmds: token_cmds,
        wiki_default_backend: config.wiki_default_backend,
        tasks_default_backend: config.tasks_default_backend,
        tasks_jira_done_status: config.tasks_jira_done_status,
        git_default_backend: config.git_default_backend,
        bb_workspace: config.bb_workspace,
        bb_repo: config.bb_repo,
        token_envs: config.token_envs
    )


fn _apply_config_value(config: ItfConfig, section: text, key: text, value: text) -> ItfConfig:
    """Apply a single config key-value to the config struct."""
    val full_key = if section != "": "{section}.{key}" else: key

    if section == "token_cmd":
        # [token_cmd] section: provider -> shell command that prints the
        # token on stdout, e.g. `jira: pass show jira/api-token`. Resolved
        # by resolve_auth_token() instead of reading auth.sdn plaintext.
        return _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds + [(key, value)])

    if section == "token_env":
        # [token_env] section: provider -> the NAME of an environment
        # variable holding the token, e.g. `bitbucket: BB_TOKEN`. The name,
        # never the secret — which is what makes this safe to record in a
        # git-tracked config file (`.spipe/config.sdn` IS tracked). The
        # secret itself only ever exists in the process environment.
        # Spelled out rather than routed through _with(), which re-reads
        # config.token_envs and so cannot change it.
        return ItfConfig(
            confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
            jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
            default_output: config.default_output, color_mode: config.color_mode,
            editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
            wiki_default_backend: config.wiki_default_backend,
            tasks_default_backend: config.tasks_default_backend,
            tasks_jira_done_status: config.tasks_jira_done_status,
            git_default_backend: config.git_default_backend,
            bb_workspace: config.bb_workspace,
            bb_repo: config.bb_repo,
            token_envs: config.token_envs + [(key, value)]
        )

    match full_key:
        "confluence.url":
            _with(config, value, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "confluence.user":
            _with(config, config.confluence_url, value, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "confluence.default_space":
            _with(config, config.confluence_url, config.confluence_user, value, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "jira.url":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, value, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "jira.acli_path":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, value, config.jira_email, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "jira.email":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, value, config.default_output, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "output.format":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, value, config.color_mode, config.editor_override, config.pager_override, config.token_cmds)
        "output.color":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, value, config.editor_override, config.pager_override, config.token_cmds)
        "editor":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, value, config.pager_override, config.token_cmds)
        "pager":
            _with(config, config.confluence_url, config.confluence_user, config.confluence_default_space, config.jira_url, config.jira_acli_path, config.jira_email, config.default_output, config.color_mode, config.editor_override, value, config.token_cmds)
        "wiki.default_backend":
            # Not routed through _with() — that helper always re-reads
            # config.wiki_default_backend itself (see its body), so it
            # cannot be used to CHANGE this one field. Spelled out fully
            # instead, matching this file's own mixed style (docstring on
            # _with() above).
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: value,
                tasks_default_backend: config.tasks_default_backend,
                tasks_jira_done_status: config.tasks_jira_done_status,
                git_default_backend: config.git_default_backend,
                bb_workspace: config.bb_workspace,
                bb_repo: config.bb_repo,
                token_envs: config.token_envs
            )
        "tasks.default_backend":
            # Mirrors wiki.default_backend immediately above (same reasoning
            # — _with() re-reads config.tasks_default_backend, so it can't
            # be used to change this field either).
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: config.wiki_default_backend,
                tasks_default_backend: value,
                tasks_jira_done_status: config.tasks_jira_done_status,
                git_default_backend: config.git_default_backend,
                bb_workspace: config.bb_workspace,
                bb_repo: config.bb_repo,
                token_envs: config.token_envs
            )
        "tasks.jira_done_status":
            # Mirrors tasks.default_backend immediately above (gap G6,
            # formerly the unscoped remainder read directly off config.sdn
            # by `_tasks_config_value` in cmd_tasks.spl; now a real
            # ItfConfig field like tasks_default_backend).
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: config.wiki_default_backend,
                tasks_default_backend: config.tasks_default_backend,
                tasks_jira_done_status: value,
                git_default_backend: config.git_default_backend,
                bb_workspace: config.bb_workspace,
                bb_repo: config.bb_repo,
                token_envs: config.token_envs
            )
        "git.default_backend":
            # D1's named drift, now closed: `git` finally has the same
            # config-default rung that `wiki`/`tasks` already had. Same
            # spelled-out shape as its three siblings above (_with() re-reads
            # this field itself, so it cannot set it).
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: config.wiki_default_backend,
                tasks_default_backend: config.tasks_default_backend,
                tasks_jira_done_status: config.tasks_jira_done_status,
                git_default_backend: value,
                bb_workspace: config.bb_workspace,
                bb_repo: config.bb_repo,
                token_envs: config.token_envs
            )
        "bitbucket.workspace":
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: config.wiki_default_backend,
                tasks_default_backend: config.tasks_default_backend,
                tasks_jira_done_status: config.tasks_jira_done_status,
                git_default_backend: config.git_default_backend,
                bb_workspace: value,
                bb_repo: config.bb_repo,
                token_envs: config.token_envs
            )
        "bitbucket.repo":
            ItfConfig(
                confluence_url: config.confluence_url, confluence_user: config.confluence_user, confluence_default_space: config.confluence_default_space,
                jira_url: config.jira_url, jira_acli_path: config.jira_acli_path, jira_email: config.jira_email,
                default_output: config.default_output, color_mode: config.color_mode,
                editor_override: config.editor_override, pager_override: config.pager_override, token_cmds: config.token_cmds,
                wiki_default_backend: config.wiki_default_backend,
                tasks_default_backend: config.tasks_default_backend,
                tasks_jira_done_status: config.tasks_jira_done_status,
                git_default_backend: config.git_default_backend,
                bb_workspace: config.bb_workspace,
                bb_repo: value,
                token_envs: config.token_envs
            )
        _:
            config


fn save_config(config: ItfConfig) -> bool:
    """Save config to SDN file."""
    val dir = config_dir()
    var content = "# ITF Configuration\n\nconfluence:\n    url: {config.confluence_url}\n    user: {config.confluence_user}\n    default_space: {config.confluence_default_space}\n\njira:\n    url: {config.jira_url}\n    acli_path: {config.jira_acli_path}\n    email: {config.jira_email}\n\nwiki:\n    default_backend: {config.wiki_default_backend}\n\ntasks:\n    default_backend: {config.tasks_default_backend}\n    jira_done_status: {config.tasks_jira_done_status}\n\noutput:\n    format: {config.default_output}\n    color: {config.color_mode}\n\neditor: {config.editor_override}\npager: {config.pager_override}\n"
    if config.token_cmds.len() > 0:
        content = content + "\ntoken_cmd:\n"
        for pair in config.token_cmds:
            content = content + "    {pair.0}: {pair.1}\n"
    file_write_text(config_path(), content)


fn load_auth_token(provider: text) -> text:
    """Load auth token for a provider (confluence, jira, bitbucket, minio, outlook)."""
    val path = auth_path()
    if not file_exists(path):
        return ""

    val content = file_read_text(path)
    if content == nil:
        return ""

    # Simple SDN parsing for auth tokens
    var section = ""
    val lines = content.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed == "" or trimmed.starts_with("#"):
            pass_dn
        else if trimmed.ends_with(":") and not trimmed.contains(" "):
            section = trimmed.replace(":", "")
        else if section == provider and trimmed.starts_with("token:"):
            # Same first-colon-only fix as load_config() above (bug
            # itf-config-colon-value-split) — a token value containing its
            # own colon (e.g. a "user:pass" style secret) was truncated at
            # the second colon by `.split(":", 2)`.
            val colon_idx = trimmed.find(":")
            val token = trimmed[colon_idx + 1:].trim()
            # Strip surrounding quotes if present
            if token.starts_with("\"") and token.ends_with("\""):
                return token[1:token.len() - 1]
            return token

    ""


fn save_auth_token(provider: text, token: text) -> bool:
    """Save auth token for a provider, preserving all other known providers' tokens.

    Known providers: confluence, jira, bitbucket, minio, outlook.
    """
    val path = auth_path()
    val known = ["confluence", "jira", "bitbucket", "minio", "outlook"]
    var content = "# ITF Auth Tokens (do not share)\n\n"
    for p in known:
        val tok = if p == provider: token else: load_auth_token(p)
        if tok != "":
            content = content + "{p}:\n    token: \"{tok}\"\n\n"
    file_write_text(path, content)


fn _token_cmd_for(config: ItfConfig, provider: text) -> text:
    """Look up a configured token_cmd for `provider`; "" if none set."""
    for pair in config.token_cmds:
        if pair.0 == provider:
            return pair.1
    ""


fn _token_env_for(config: ItfConfig, provider: text) -> text:
    """Look up the configured [token_env] VARIABLE NAME for `provider`; ""
    if none set. Returns the name, not the value — the caller reads the
    environment."""
    for pair in config.token_envs:
        if pair.0 == provider:
            return pair.1
    ""


fn resolve_auth_token(config: ItfConfig, provider: text) -> text:
    """Resolve a provider's auth token: run its configured `token_cmd` (from
    the [token_cmd] config section) if set, otherwise fall back to the
    plaintext token in auth.sdn via load_auth_token(). Never prints the
    token — callers must not log this return value.

    token_cmd avoids storing the secret at rest at all (e.g. `pass show
    jira/api-token`, `op read op://vault/item/token`); the command's stdout,
    trimmed, is used verbatim as the token.

    Full precedence, highest first:
      1. [token_env] <provider>: NAME  — read $NAME from the environment.
         Cheapest and the standard CI mechanism; the config records only the
         variable's NAME, so it is safe in a git-tracked file.
      2. [token_cmd] <provider>: CMD  — run CMD, use its stdout.
      3. auth.sdn plaintext.
    A configured token_env whose variable is unset falls through rather than
    failing, so a developer with a token_cmd and a CI job with an env var can
    share one config file.
    """
    val env_name = _token_env_for(config, provider)
    if env_name != "":
        val from_env = env_get(env_name)
        if from_env != "":
            return from_env.trim()

    val cmd = _token_cmd_for(config, provider)
    if cmd == "":
        return load_auth_token(provider)
    val (stdout, _stderr, code) = process_run("/bin/sh", ["-c", cmd])
    if code != 0:
        return ""
    stdout.trim()


fn resolve_editor(config: ItfConfig) -> text:
    """Resolve editor from config/env vars. ITF_EDITOR > GH_EDITOR > EDITOR > VISUAL > vi"""
    if config.editor_override != "":
        return config.editor_override
    val itf_editor = env_get("ITF_EDITOR")
    if itf_editor != "":
        return itf_editor
    val gh_editor = env_get("GH_EDITOR")
    if gh_editor != "":
        return gh_editor
    val editor = env_get("EDITOR")
    if editor != "":
        return editor
    val visual = env_get("VISUAL")
    if visual != "":
        return visual
    "vi"
