# Documentation Coverage Scanner - Main Module
# Coordinates file scanning, comment extraction, and declaration detection

use app.io.mod (file_read, file_exists)
use std.text.{NL}
use app.doc_coverage.scanner.comment_extractor.{extract_comments, associate_comments, extract_docstring}
use app.doc_coverage.scanner.file_scanner.{discover_source_files, filter_public_only}
use app.doc_coverage.types.doc_item.{DocItem, DocKind}

# ============================================================================
# Data Types
# ============================================================================

# The scanner produces the shared types.doc_item.DocItem directly; the old
# simplified local struct was the second "DocItem" in every doc-coverage
# program and made the module fail semantic analysis when the command,
# analysis and reporting modules were compiled together
# (doc/08_tracking/bug/doc_coverage_command_broken_missing_load_sdoctest_blocks_2026-09-05.md).

fn _scanned_doc_item(name: text, kind: DocKind, signature: text, file_path: text, line: i64, has_comment: bool, has_docstring: bool) -> DocItem:
    DocItem(
        name: name,
        kind: kind,
        file_path: file_path,
        line: line,
        col: 0,
        visibility: "",
        signature: signature,
        has_inline_comment: has_comment,
        has_docstring: has_docstring,
        has_sdoctest: false,
        is_public: false,
        is_exported: false
    )

# ============================================================================
# File Scanning
# ============================================================================

# Scan a single file for documentation
fn scan_file_for_docs(file_path: text) -> [DocItem]:
    if not file_exists(file_path):
        return []

    val source = file_read(file_path)
    val lines = source.split(NL)

    # Extract all comments first
    val comment_result = extract_comments(source)
    val comment_lines = comment_result.0
    val comment_texts = comment_result.1

    var items: [DocItem] = []

    # Scan for declarations
    var line_num = 0
    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()

        # Detect function declarations
        if trimmed.starts_with("fn "):
            val name = extract_fn_name(trimmed)
            if name.len() > 0:
                val has_comment = associate_comments(comment_lines, comment_texts, line_num).0
                val docstring = extract_docstring(source, line_num)
                val has_docstring = docstring.0

                items.push(_scanned_doc_item(
                    name, DocKind.Function, "fn {name}", file_path, line_num,
                    has_comment, has_docstring
                ))

        # Detect static function declarations
        if trimmed.starts_with("static fn "):
            val name = extract_fn_name(trimmed[7:])
            if name.len() > 0:
                val has_comment = associate_comments(comment_lines, comment_texts, line_num).0
                val docstring = extract_docstring(source, line_num)
                val has_docstring = docstring.0

                items.push(_scanned_doc_item(
                    name, DocKind.Function, "static fn {name}", file_path, line_num,
                    has_comment, has_docstring
                ))

        # Detect struct declarations
        if trimmed.starts_with("struct "):
            val name = extract_type_name(trimmed, "struct ")
            if name.len() > 0:
                val has_comment = associate_comments(comment_lines, comment_texts, line_num).0
                val docstring = extract_docstring(source, line_num)
                val has_docstring = docstring.0

                items.push(_scanned_doc_item(
                    name, DocKind.Struct, "struct {name}", file_path, line_num,
                    has_comment, has_docstring
                ))

        # Detect class declarations
        if trimmed.starts_with("class "):
            val name = extract_type_name(trimmed, "class ")
            if name.len() > 0:
                val has_comment = associate_comments(comment_lines, comment_texts, line_num).0
                val docstring = extract_docstring(source, line_num)
                val has_docstring = docstring.0

                items.push(_scanned_doc_item(
                    name, DocKind.Class, "class {name}", file_path, line_num,
                    has_comment, has_docstring
                ))

        # Detect enum declarations
        if trimmed.starts_with("enum "):
            val name = extract_type_name(trimmed, "enum ")
            if name.len() > 0:
                val has_comment = associate_comments(comment_lines, comment_texts, line_num).0
                val docstring = extract_docstring(source, line_num)
                val has_docstring = docstring.0

                items.push(_scanned_doc_item(
                    name, DocKind.Enum, "enum {name}", file_path, line_num,
                    has_comment, has_docstring
                ))

    items

# ============================================================================
# Name Extraction Helpers
# ============================================================================

# Extract function name from declaration line
fn extract_fn_name(line: text) -> text:
    val trimmed = line.trim()
    # Remove "fn " prefix if present
    var rest = trimmed
    if rest.starts_with("fn "):
        rest = rest[3:]

    # Find first '(' or ':'. index_of returns a raw i64 (-1 when absent), never
    # nil, so `?? 999999` never fired on a miss and instead silently rewrote a
    # genuine index of 3 into the not-found sentinel (TAG_SPECIAL == 3): a
    # 3-character name like `fn get(x):` lost its `(` and yielded "get(x)".
    val paren_idx = rest.index_of("(")
    val colon_idx = rest.index_of(":")
    var end_idx = paren_idx
    if end_idx < 0 or (colon_idx >= 0 and colon_idx < end_idx):
        end_idx = colon_idx

    if end_idx < 0:
        return ""

    val name = rest[0:end_idx]
    name.trim()

# Extract type name from declaration line
fn extract_type_name(line: text, prefix: text) -> text:
    val trimmed = line.trim()
    if not trimmed.starts_with(prefix):
        return ""

    val after_prefix = trimmed[prefix.len():]
    # Find first ':' or '<' (for generics). Same raw-i64 hazard as
    # extract_fn_name above: `?? 999999` was dead on a miss and corrupted a
    # genuine index of 3.
    val colon_idx = after_prefix.index_of(":")
    val angle_idx = after_prefix.index_of("<")
    var end_idx = colon_idx
    if end_idx < 0 or (angle_idx >= 0 and angle_idx < end_idx):
        end_idx = angle_idx

    if end_idx < 0:
        return ""

    val name = after_prefix[0:end_idx]
    name.trim()

# ============================================================================
# Exports
# ============================================================================

export scan_file_for_docs
export discover_source_files
export filter_public_only
