# Documentation coverage aggregate types.

use app.doc_coverage.types.doc_item.{DocItem}

struct FileCoverage:
    path: text
    total_items: i64
    documented_items: i64
    missing_docs: i64
    has_sdoctest: i64
    missing_sdoctest: i64
    items: [DocItem]

    fn coverage_percent(self) -> i64:
        """Documented items in this file as a whole-number percentage.

        Zero items is 100%: a file with nothing in it has nothing missing.
        Called by `reporting/json_exporter.spl`, never declared.
        """
        if self.total_items <= 0:
            return 100
        (self.documented_items * 100) / self.total_items

    fn sdoctest_percent(self) -> i64:
        """Items in this file carrying an sdoctest, as a whole-number percentage."""
        if self.total_items <= 0:
            return 100
        (self.has_sdoctest * 100) / self.total_items

    static fn create(path: text) -> FileCoverage:
        FileCoverage(
            path: path,
            total_items: 0,
            documented_items: 0,
            missing_docs: 0,
            has_sdoctest: 0,
            missing_sdoctest: 0,
            items: []
        )

struct CoverageReport:
    total_items: i64
    documented_items: i64
    missing_docs: i64
    sdoctest_coverage: i64
    missing_sdoctest: i64
    timestamp: i64
    files: [FileCoverage]

    fn overall_percent(self) -> i64:
        """Documented items as a whole-number percentage of all items.

        Zero items is 100% documented, not a division by zero: a report with
        nothing in it has nothing missing. `reporting/json_exporter.spl` has
        always called this; it was never declared.
        """
        if self.total_items <= 0:
            return 100
        (self.documented_items * 100) / self.total_items

    fn sdoctest_percent(self) -> i64:
        """Items carrying an sdoctest as a whole-number percentage of all items.

        Same zero-items convention as `overall_percent`. Also called by
        `reporting/json_exporter.spl` and also never declared.
        """
        if self.total_items <= 0:
            return 100
        (self.sdoctest_coverage * 100) / self.total_items

    static fn create() -> CoverageReport:
        CoverageReport(
            total_items: 0,
            documented_items: 0,
            missing_docs: 0,
            sdoctest_coverage: 0,
            missing_sdoctest: 0,
            timestamp: 0,
            files: []
        )
