# Documentation coverage item types.

enum DocKind:
    Function
    Struct
    Class
    Enum
    Module

struct DocItem:
    name: text
    kind: DocKind
    file_path: text
    line: i64
    col: i64
    visibility: text
    signature: text
    has_inline_comment: bool
    has_docstring: bool
    has_sdoctest: bool
    is_public: bool
    is_exported: bool

    fn kind_str(self) -> text:
        match self.kind:
            case DocKind.Function: "function"
            case DocKind.Struct: "struct"
            case DocKind.Class: "class"
            case DocKind.Enum: "enum"
            case DocKind.Module: "module"

    fn needs_sdoctest(self) -> bool:
        self.is_public and not self.has_sdoctest

    static fn create_function(name: text, path: text, line: i64, col: i64, vis: text, sig: text) -> DocItem:
        DocItem(
            name: name,
            kind: DocKind.Function,
            file_path: path,
            line: line,
            col: col,
            visibility: vis,
            signature: sig,
            has_inline_comment: false,
            has_docstring: false,
            has_sdoctest: false,
            is_public: vis == "pub",
            is_exported: false
        )

    static fn create_struct(name: text, path: text, line: i64, col: i64, vis: text) -> DocItem:
        DocItem(
            name: name,
            kind: DocKind.Struct,
            file_path: path,
            line: line,
            col: col,
            visibility: vis,
            signature: "struct {name}",
            has_inline_comment: false,
            has_docstring: false,
            has_sdoctest: false,
            is_public: vis == "pub",
            is_exported: false
        )

    static fn create_class(name: text, path: text, line: i64, col: i64, vis: text) -> DocItem:
        DocItem(
            name: name,
            kind: DocKind.Class,
            file_path: path,
            line: line,
            col: col,
            visibility: vis,
            signature: "class {name}",
            has_inline_comment: false,
            has_docstring: false,
            has_sdoctest: false,
            is_public: vis == "pub",
            is_exported: false,
            sdoctest_tags: []
        )

    static fn create_enum(name: text, path: text, line: i64, col: i64, vis: text) -> DocItem:
        DocItem(
            name: name,
            kind: DocKind.Enum,
            file_path: path,
            line: line,
            col: col,
            visibility: vis,
            signature: "enum {name}",
            has_inline_comment: false,
            has_docstring: false,
            has_sdoctest: false,
            is_public: vis == "pub",
            is_exported: false,
            sdoctest_tags: []
        )
