use std.io_runtime.{file_read}
use std.common.ponytail.audit.{ponytail_audit_source, ponytail_simplification_report_source}
use std.common.ponytail.ladder.{ponytail_ladder_report_source, ponytail_ladder_report_diff, ponytail_ladder_findings_section}

fn ponytail_audit(path: text) -> text:
    val source = file_read(path)
    if source == "":
        return "Ponytail Audit\nsource: " + path + "\nstatus: missing\nreason: source unavailable"
    ponytail_audit_source(path, source) + "\n" + ponytail_ladder_findings_section(source, "full")

fn ponytail_simplification_report(path: text) -> text:
    val source = file_read(path)
    if source == "":
        return "Ponytail Simplification Report\nsource: " + path + "\nstatus: missing\nreason: source unavailable\ntotal_suggestions: 0"
    ponytail_simplification_report_source(path, source)

fn ponytail_ladder(path: text, diff: text, level: text) -> text:
    # diff wins when given; otherwise the file is scanned whole.
    if diff != "":
        return ponytail_ladder_report_diff(diff, level)
    val source = file_read(path)
    if source == "":
        return "Ponytail Ladder\nsource: " + path + "\nlevel: " + level + "\nstatus: missing\nreason: source unavailable\nfindings: 0"
    ponytail_ladder_report_source(path, source, level)
