# Byte-oriented protocol output. Ordinary console-provider admission does not
# apply to a borrowed binary stdout descriptor carrying JSON-RPC frames.
use std.nogc_sync_mut.sffi.fs.{io_file_write_all}
use std.nogc_sync_mut.io.external_text_io.{TextIoError, io_text_encode, io_text_error_message}
use std.common.encoding.external_text.{utf8_format}
use std.nogc_async_mut.sosix.text_boundary.{sosix_text_check_size}

fn wire_stdout_write_checked(value: text) -> Result<(), TextIoError>:
    sosix_text_check_size(value)?
    val bytes = io_text_encode(value, utf8_format())?
    if not io_file_write_all(1, bytes):
        return Err(TextIoError.Io("protocol stdout write failed; output may be partial"))
    Ok(())

fn wire_stdout_write(value: text):
    match wire_stdout_write_checked(value):
        case Ok(_): ()
        case Err(error): panic(io_text_error_message(error))
