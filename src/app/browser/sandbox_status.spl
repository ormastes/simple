# Browser sandbox posture surface.
#
# The in-process Simple Browser (this app) runs its engine and page script in
# the HOST process with no OS confinement. The jailed path exists elsewhere:
# the hosted renderer worker (src/os/hosted/hosted_browser_renderer_worker.spl)
# enters rt_browser_renderer_sandbox_enter (rlimits + no_new_privs + Landlock
# + seccomp ALLOW-list) via the broker
# (src/os/hosted/hosted_browser_renderer_process.spl). Routing this app's page
# rendering through that broker is NOT yet wired — tracked in
# doc/08_tracking/bug/browser_seccomp_denylist_and_inprocess_unjailed_2026-08-15.md.
#
# This module is the honest surface for that fact:
#   - SIMPLE_BROWSER_SANDBOX=1 REQUESTS sandboxed rendering;
#   - until worker routing lands, a request is REFUSED (never silently served
#     unjailed, never falsely reported as jailed);
#   - the default (knob unset) renders unjailed and SAYS so on query.

use std.io_runtime.{env_get}
use app.browser.sandbox_routing.{
    browser_sandbox_routing_probe, browser_sandbox_routing_reason,
    BROWSER_SANDBOX_WORKER_ENV
}

pub val BROWSER_SANDBOX_ENV: text = "SIMPLE_BROWSER_SANDBOX"

pub val BROWSER_SANDBOX_MODE_UNJAILED: text = "unjailed-in-process"
pub val BROWSER_SANDBOX_MODE_JAILED: text = "worker-jailed"
pub val BROWSER_SANDBOX_MODE_REFUSED: text = "refused"

class BrowserSandboxStatus:
    requested: bool
    jailed: bool
    mode: text
    reason: text

pub fn browser_sandbox_requested() -> bool:
    """True when SIMPLE_BROWSER_SANDBOX=1 asks for jailed page rendering."""
    env_get(BROWSER_SANDBOX_ENV) == "1"

pub fn browser_sandbox_render_route_wired() -> bool:
    """Whether this app's render path actually hands pages to the renderer
    worker.

    Now true: `app.browser.sandbox_render.browser_sandbox_render_pixels`
    drives broker -> jailed worker -> Draw IR -> software raster -> pixels.

    This was previously false on the stated grounds that a
    `DrawIrComposition -> [u32]` rasterization step did not exist. That was a
    FALSE NEGATIVE, not a real blocker:
    `Engine2dCompositorBackend.render_draw_ir_composition`
    (src/os/compositor/compositor_engine2d.spl:364) has always existed, and
    src/os/hosted/hosted_browser_render_evidence.spl:77 already used it for
    exactly this sequence. The search that "proved" it absent used the repo's
    default `grep`, a .gitignore-honouring ugrep wrapper that returned zero
    hits where /usr/bin/grep returns 20 — the trap documented in
    .claude/rules/commands.md § Fast Path.

    The second stated blocker was real but was never a blocker on THIS flag:
    the worker arg is dispatched only at `src/os/hosted/hosted_entry.spl:285`,
    so the CLI must not gain it. It does not need to — the broker takes the
    worker executable as a parameter, which is why the executable stays
    operator-supplied via `sandbox_routing.spl`.

    Still gated behind the routing probe: this flag says the CODE can route,
    not that an operator configured a worker binary."""
    true

pub fn browser_sandbox_worker_routing_available() -> bool:
    """Whether this app can route page rendering through the sandboxed
    renderer worker.

    Requires BOTH a worker-capable executable (probed, operator-supplied) AND
    a wired render route. Fail-closed: either half missing means unavailable,
    which keeps the honest refusal rather than an unjailed render."""
    browser_sandbox_routing_probe() and browser_sandbox_render_route_wired()

pub fn browser_sandbox_unavailable_reason() -> text:
    """Precise, machine-readable reason routing is unavailable, so an operator
    can tell 'you never set the env var' apart from 'the code cannot do this
    yet'. Empty when routing IS available."""
    if not browser_sandbox_routing_probe():
        return browser_sandbox_routing_reason()
    if not browser_sandbox_render_route_wired():
        return "render-route-not-wired"
    ""

pub fn browser_sandbox_status() -> BrowserSandboxStatus:
    """Honest sandbox posture for this process. Fail-closed reporting:
    `jailed` is true only on a path that actually entered the jail, and a
    sandbox request that cannot be honoured is REFUSED, not silently
    downgraded."""
    val requested = browser_sandbox_requested()
    if not requested:
        return BrowserSandboxStatus(
            requested: false, jailed: false,
            mode: BROWSER_SANDBOX_MODE_UNJAILED,
            reason: "engine and page script run in the host process; set {BROWSER_SANDBOX_ENV}=1 to require the jailed renderer worker")
    if browser_sandbox_worker_routing_available():
        return BrowserSandboxStatus(
            requested: true, jailed: true,
            mode: BROWSER_SANDBOX_MODE_JAILED,
            reason: "")
    # Report the ACTUAL cause, not a fixed sentence. The render route is wired
    # now, so blaming it would send an operator to read code when what they
    # really need is to set SIMPLE_BROWSER_RENDERER_WORKER.
    BrowserSandboxStatus(
        requested: true, jailed: false,
        mode: BROWSER_SANDBOX_MODE_REFUSED,
        reason: "sandbox requested but unavailable ({browser_sandbox_unavailable_reason()}); refusing to render unjailed — set {BROWSER_SANDBOX_WORKER_ENV} to a worker-capable executable, see doc/08_tracking/bug/browser_seccomp_denylist_and_inprocess_unjailed_2026-08-15.md")

pub fn browser_sandbox_status_line(status: BrowserSandboxStatus) -> text:
    """One-line human/CLI rendering of the posture."""
    if status.reason == "":
        "browser sandbox: {status.mode}"
    else:
        "browser sandbox: {status.mode} — {status.reason}"

export BROWSER_SANDBOX_ENV
export BROWSER_SANDBOX_MODE_UNJAILED, BROWSER_SANDBOX_MODE_JAILED, BROWSER_SANDBOX_MODE_REFUSED
export BrowserSandboxStatus
export browser_sandbox_requested, browser_sandbox_worker_routing_available
export browser_sandbox_render_route_wired, browser_sandbox_unavailable_reason
export browser_sandbox_status, browser_sandbox_status_line
