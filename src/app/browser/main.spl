# Browser CLI entrypoint.
# Startup-light command planner for source-mode help and readiness probes,
# mirroring src/app/terminal/main.spl's shape.

use std.cli.cli_util (get_cli_args)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use app.ui.render.types.{RenderConfig}
use app.browser.render_adapter.{render_browser, browser_engine_frame_at_dpr,
    browser_viewport, browser_dump_png_if_requested}
use app.browser.gui_window.{browser_window_open, browser_window_drawable, browser_window_dpr,
    browser_window_present, browser_window_wait}
use app.browser.sandbox_status.{browser_sandbox_status, browser_sandbox_status_line}
use std.common.json.{json_escape_string}

val TOOL_NAME = "Simple Browser"
val TOOL_VERSION = "0.1.0"
val DEFAULT_URL = "simple://home"
# Default window/page size: a realistic 4K frame. These are PHYSICAL pixels:
# on a 2x Retina display the window is 1920x1080 points backed by a
# 3840x2160 buffer, and the page is rendered at the window's real drawable
# size (the OS may trim the request to the visible screen area) so the
# present maps 1:1 with no scaling. SIMPLE_BROWSER_VIEWPORT=<W>x<H> overrides
# it (see render_adapter.browser_viewport).
fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("browser", log_opts.error)
        return 1

    val args = browser_clean_log_args(raw_args)
    if args.len() > 0 and (args[0] == "--help" or args[0] == "-h" or args[0] == "help"):
        print_help_with_progress(log_opts.progress)
        return 0
    if args.len() > 0 and (args[0] == "--version" or args[0] == "-v"):
        if log_opts.log_mode == "json":
            print "{\"command\":\"browser\",\"status\":\"ok\",\"version\":\"{TOOL_VERSION}\"}"
        else:
            print "{TOOL_NAME} v{TOOL_VERSION}"
        return 0

    if browser_has_option(args, "--sandbox-status"):
        print browser_sandbox_status_line(browser_sandbox_status())
        return 0

    # Honest sandbox gate: SIMPLE_BROWSER_SANDBOX=1 REQUIRES the jailed
    # renderer worker. Until worker routing lands (see sandbox_status.spl's
    # header), a sandbox request is refused rather than served unjailed —
    # never silently claim or imply sandboxed rendering.
    val sandbox = browser_sandbox_status()
    if sandbox.requested and not sandbox.jailed:
        browser_print_error(log_opts.log_mode, browser_sandbox_status_line(sandbox))
        return 1

    val unknown = browser_first_unknown_option(args)
    if unknown != "":
        val message = "Unknown browser option: {unknown}"
        browser_print_error(log_opts.log_mode, message)
        return 1

    val url = browser_first_positional(args)
    if browser_has_option(args, "--open"):
        val open_url = if url != "": url else: DEFAULT_URL
        return browser_open_window(open_url)

    val display_url = if url != "": url else: DEFAULT_URL
    var config = RenderConfig.default()
    config.adapter_name = "browser"
    config.asset_path = url
    config.format = if log_opts.log_mode == "json": "html" else: "text"
    val result = render_browser(config)
    # Page-load failure is reported truthfully: non-zero exit, and the json
    # status field says "load-failed" instead of "ready" (same object shape).
    val load_failed = (result.metadata.get("status") ?? "") == "failed"
    val json_status = if load_failed: "load-failed" else: "ready"
    if log_opts.log_mode == "json":
        print "{\"command\":\"browser\",\"status\":\"{json_status}\",\"tool\":\"{TOOL_NAME}\",\"version\":\"{TOOL_VERSION}\",\"url\":\"{display_url}\",\"html\":\"{json_escape_string(result.html_output)}\"}"
    else:
        val progress = render_progress(log_opts.progress, 1, 1, "browser")
        if progress != "":
            print progress
        print "{TOOL_NAME} v{TOOL_VERSION}"
        print result.text_output
    if load_failed: 1 else: 0

fn browser_open_window(url: text) -> i64:
    """Open the window, render the page at the window's real drawable size,
    present it 1:1, and re-render on every settled resize. Rendering stays
    HERE, not in gui_window.spl — see browser_window_wait's docstring."""
    val vp = browser_viewport()
    val created = browser_window_open(url, vp.width, vp.height)
    match created:
        case None:
            return 1
        case Some(gui):
            var size = browser_window_drawable(gui, vp.width, vp.height)
            while size[0] > 0:
                val w = size[0]
                val h = size[1]
                # Lay out at the window's size in POINTS and rasterize at the
                # display's backing scale (2 on Retina), so text and boxes are
                # their CSS size on screen. SIMPLE_BROWSER_DPR still overrides.
                val dpr = browser_window_dpr(gui, vp.device_pixel_ratio, w, h)
                val frame = browser_engine_frame_at_dpr(url, w, h, dpr)
                val why = if frame.reason != "": " ({frame.reason})" else: ""
                print "browser window: requested {vp.width}x{vp.height}px, drawable {w}x{h}px @{dpr}x, backend={frame.backend}{why}"
                val dump = browser_dump_png_if_requested(frame.pixels, w, h)
                if dump != "":
                    print dump
                if not browser_window_present(gui, w, h, frame.pixels):
                    gui.close()
                    return 1
                size = browser_window_wait(gui, w, h)
            gui.close()
            0

fn print_help():
    print "{TOOL_NAME}"
    print ""
    print "Usage: simple browser [url] [options]"
    print ""
    print "Arguments:"
    print "  url                 Page to open (default: {DEFAULT_URL})"
    print ""
    print "Options:"
    print "  -h, --help          Show this help message"
    print "  -v, --version       Show version information"
    print "  --open              Launch the browser in a real GUI window (blocks until closed)"
    print "  --sandbox-status    Report sandbox posture (jailed/unjailed) and exit"
    print ""
    print "Environment:"
    print "  SIMPLE_BROWSER_VIEWPORT=WxH  Page/window size in device pixels (default 3840x2160)"
    print "  SIMPLE_BROWSER_RENDER_LANE=vulkan|live|blink  Render lane (default vulkan)"
    print "  SIMPLE_BROWSER_DUMP_PNG=path  Also write the rendered frame as a PNG"
    print "  SIMPLE_BROWSER_SANDBOX=1  Require jailed page rendering; refused (exit 1)"
    print "                            until renderer-worker routing lands"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"

fn print_help_with_progress(progress_mode: text):
    val progress = render_progress(progress_mode, 0, 1, "usage")
    if progress != "":
        print progress
    print_help()

fn browser_print_error(log_mode: text, message: text):
    if log_mode == "json":
        print "{\"command\":\"browser\",\"status\":\"error\",\"message\":\"{message}\"}"
    else:
        error("browser", message)

fn browser_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn browser_clean_log_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if browser_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned

fn browser_first_unknown_option(args: [text]) -> text:
    var i = 0
    while i < args.len():
        val arg = args[i]
        if arg == "--open" or arg == "--sandbox-status":
            i = i + 1
        elif arg.starts_with("-"):
            return arg
        else:
            i = i + 1
    ""

fn browser_has_option(args: [text], name: text) -> bool:
    for arg in args:
        if arg == name:
            return true
    false

fn browser_first_positional(args: [text]) -> text:
    for arg in args:
        if not arg.starts_with("-"):
            return arg
    ""
