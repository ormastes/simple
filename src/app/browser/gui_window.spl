# Simple Browser — real GUI window launch.
#
# Renders the page through the same real engine used by render_adapter.spl's
# text/HTML output (browser_engine_pixels_at -> render_html_to_pixel_array,
# the DOM/CSS/layout/paint pipeline verified in
# doc/08_tracking/bug/browser_text_node_blanks_frame_2026-08-05.md), then
# blits the genuine pixel buffer into a real OS window via GuiRenderer — the
# same backend-isolated winit facade `app.ui.browser.app` uses (no raw
# rt_winit_* externs here, see gui_renderer.spl's header for why). Requires
# `build/sffi/libspl_winit.<so|dylib|dll>` (build with
# scripts/build/build_spl_winit.shs) and a reachable display (X11/Wayland on
# Linux; on macOS the seed driver runs `browser --open` on the main thread
# itself, as SIMPLE_GUI=1 does). Headless environments without a display: run under Xvfb (or a
# container providing one), same as app.ui.browser.

use nogc_sync_mut.ui.gui_renderer.{GuiRenderer, GUI_EVT_NONE, GUI_EVT_CLOSE, GUI_EVT_RESIZED}
use nogc_sync_mut.src.time.{sleep_ms}
use std.io_runtime.{env_get}

pub fn browser_window_open(url: text, width: i32, height: i32) -> GuiRenderer?:
    """Open the browser window. `width`/`height` are PHYSICAL pixels, so a
    3840x2160 request on a 2x Retina display is a 1920x1080-point window.
    The OS may clamp it to the visible screen area (menu bar, title bar);
    read the real drawable extent back with `browser_window_drawable` and
    render at THAT size so the present maps 1:1 onto the backing store.
    nil (GuiRenderer already printed an honest reason) on any failure."""
    GuiRenderer.create("auto", width, height, "Simple Browser - {url}")

pub fn browser_window_drawable(g: GuiRenderer, fallback_w: i32, fallback_h: i32) -> [i32]:
    """[width, height] of the window's drawable area in physical pixels, or
    the requested size when the provider cannot report it."""
    val size = g.inner_size()
    if size[0] > 0 and size[1] > 0:
        [size[0].to_i32(), size[1].to_i32()]
    else:
        [fallback_w, fallback_h]

pub fn browser_window_dpr(g: GuiRenderer, width: i32, height: i32) -> i32:
    """Integer device pixels per CSS pixel for this window, the same source the
    showcase uses (#2530): SIMPLE_GUI_SCALE when it is a positive integer, else
    the window's backing scale factor rounded to an integer, else 1. Never a
    hardcoded 2x: a 1x display (scale_factor 1.0) must render at 1. A ratio
    that does not divide the drawable falls back to 1 (layout would otherwise
    lose a pixel row)."""
    var dpr = 1
    val forced = (env_get("SIMPLE_GUI_SCALE") ?? "").trim().to_i64() ?? 0
    if forced >= 1 and forced <= 4:
        dpr = forced.to_i32()
    else:
        val milli = g.scale_factor_milli()
        if milli >= 500:
            dpr = ((milli + 500) / 1000).to_i32()
    if dpr < 1 or width % dpr != 0 or height % dpr != 0:
        return 1
    dpr

pub fn browser_window_present(g: GuiRenderer, width: i32, height: i32, pixels: [u32]) -> bool:
    """Present one already-rendered frame 1:1 (no scaling)."""
    if g.present_argb_u32(width.to_i64(), height.to_i64(), pixels):
        return true
    print "Error: failed to present the rendered frame to the window"
    false

pub fn browser_window_wait(g: GuiRenderer, width: i32, height: i32) -> [i32]:
    """Block until the window closes ([0, 0]) or its drawable size settles
    at a new extent ([w, h], physical pixels). Rendering stays in the caller
    (main.spl): running the engine from inside this module's call chain
    used to trip a whole-module tree-walk fallback (measured 2026-08-06).
    Resize bursts are coalesced: the size is only reported once no further
    resize event arrives for ~150ms, so a drag re-renders once, not per
    intermediate frame."""
    var pending_w: i32 = 0
    var pending_h: i32 = 0
    var quiet_ms: i64 = 0
    while true:
        val ev = g.poll_event()
        if ev.kind == GUI_EVT_CLOSE:
            return [0, 0]
        if ev.kind == GUI_EVT_RESIZED:
            val nw = ev.x.to_i64().to_i32()
            val nh = ev.y.to_i64().to_i32()
            if nw > 0 and nh > 0:
                pending_w = nw
                pending_h = nh
                quiet_ms = 0
        elif ev.kind == GUI_EVT_NONE:
            # ponytail: fixed poll interval, not an OS-level blocking wait —
            # fine for a static page; switch to a blocking wait if the window
            # needs timer-driven redraws.
            sleep_ms(16)
            if pending_w > 0:
                quiet_ms = quiet_ms + 16
                if quiet_ms >= 150:
                    if pending_w != width or pending_h != height:
                        return [pending_w, pending_h]
                    pending_w = 0
                    pending_h = 0
    [0, 0]

pub fn run_browser_window_gui_frames(
    url: text, width: i32, height: i32, frames: [[u32]], frame_ms: i64
) -> i64:
    """Animated variant of the single-frame window flow: cycles through frames
    pre-rendered by the caller (app.browser.render_adapter's
    browser_engine_animated_frames — one BrowserSession whose advance_time
    drives JS timers/rAF and the CSS keyframe clock between renders).
    Frames are pre-rendered because running the engine from inside THIS
    module trips the silent tree-walk fallback described in
    browser_window_wait's docstring. Returns 0 on clean close, 1 on any
    window failure or when frames is empty."""
    if frames.len() == 0:
        print "Error: no frames to present"
        return 1
    val interval = if frame_ms > 0: frame_ms else: 16
    val created = GuiRenderer.create("auto", width, height, "Simple Browser - {url}")
    match created:
        case None:
            return 1
        case Some(gui):
            var g = gui
            if not g.present_argb_u32(width.to_i64(), height.to_i64(), frames[0]):
                print "Error: failed to present the rendered frame to the window"
                g.close()
                return 1
            var frame_index: i64 = 0
            var running = true
            while running:
                val ev = g.poll_event()
                if ev.kind == GUI_EVT_CLOSE:
                    running = false
                elif ev.kind == GUI_EVT_NONE:
                    sleep_ms(interval)
                    frame_index = (frame_index + 1) % frames.len()
                    if not g.present_argb_u32(width.to_i64(), height.to_i64(), frames[frame_index]):
                        running = false
            g.close()
            0
