# Simple Browser — real GUI window launch.
#
# Renders the page through the same real engine used by render_adapter.spl's
# text/HTML output (browser_engine_pixels_at -> render_html_to_pixel_array,
# the DOM/CSS/layout/paint pipeline verified in
# doc/08_tracking/bug/browser_text_node_blanks_frame_2026-08-05.md), then
# blits the genuine pixel buffer into a real OS window via GuiRenderer — the
# same backend-isolated winit facade `app.ui.browser.app` uses (no raw
# rt_winit_* externs here, see gui_renderer.spl's header for why). Requires
# `build/sffi/libspl_winit.<so|dylib|dll>` (build with
# scripts/build/build_spl_winit.shs) and a reachable display (X11/Wayland on
# Linux; macOS additionally needs SIMPLE_GUI=1 so winit runs on the main
# thread). Headless environments without a display: run under Xvfb (or a
# container providing one), same as app.ui.browser.

use nogc_sync_mut.ui.gui_renderer.{GuiRenderer, GUI_EVT_NONE, GUI_EVT_CLOSE}
use nogc_sync_mut.src.time.{sleep_ms}

pub fn run_browser_window_gui(url: text, width: i32, height: i32, pixels: [u32]) -> i64:
    """Open a real window, paint one already-rendered real-engine frame into
    it, and block until the user closes the window. Returns 0 on a clean
    close, 1 on any window failure (GuiRenderer already prints an honest
    reason). The caller renders the pixels (main.spl, via
    browser_engine_pixels_at): rendering inside THIS function ran the whole
    engine ~10-50x slower — this module's GuiRenderer/extern import chain
    trips the JIT into a silent tree-walk fallback that poisons every callee,
    so the same 64x36 render that takes ~45s from main.spl's call chain never
    finished a 1800s budget from here. Measured 2026-08-06, container + host.
    Keep the render in the caller until the fallback bug is fixed."""
    val created = GuiRenderer.create("auto", width, height, "Simple Browser - {url}")
    match created:
        case None:
            return 1
        case Some(gui):
            var g = gui
            if not g.present_argb_u32(width.to_i64(), height.to_i64(), pixels):
                print "Error: failed to present the rendered frame to the window"
                g.close()
                return 1

            var running = true
            while running:
                val ev = g.poll_event()
                if ev.kind == GUI_EVT_CLOSE:
                    running = false
                elif ev.kind == GUI_EVT_NONE:
                    # ponytail: fixed poll interval, not an OS-level blocking
                    # wait — good enough for a single static frame with no
                    # animation; switch to a blocking wait if/when this window
                    # needs to redraw on a timer.
                    sleep_ms(16)
            g.close()
            0

pub fn run_browser_window_gui_frames(
    url: text, width: i32, height: i32, frames: [[u32]], frame_ms: i64
) -> i64:
    """Animated variant of run_browser_window_gui: cycles through frames
    pre-rendered by the caller (app.browser.render_adapter's
    browser_engine_animated_frames — one BrowserSession whose advance_time
    drives JS timers/rAF and the CSS keyframe clock between renders).
    Frames are pre-rendered because running the engine from inside THIS
    module trips the silent tree-walk fallback described in
    run_browser_window_gui's docstring. Returns 0 on clean close, 1 on any
    window failure or when frames is empty."""
    if frames.len() == 0:
        print "Error: no frames to present"
        return 1
    val interval = if frame_ms > 0: frame_ms else: 16
    val created = GuiRenderer.create("auto", width, height, "Simple Browser - {url}")
    match created:
        case None:
            return 1
        case Some(gui):
            var g = gui
            if not g.present_argb_u32(width.to_i64(), height.to_i64(), frames[0]):
                print "Error: failed to present the rendered frame to the window"
                g.close()
                return 1
            var frame_index: i64 = 0
            var running = true
            while running:
                val ev = g.poll_event()
                if ev.kind == GUI_EVT_CLOSE:
                    running = false
                elif ev.kind == GUI_EVT_NONE:
                    sleep_ms(interval)
                    frame_index = (frame_index + 1) % frames.len()
                    if not g.present_argb_u32(width.to_i64(), height.to_i64(), frames[frame_index]):
                        running = false
            g.close()
            0
