# LLM Caret - JSON Helpers
#
# JSON building and parsing utilities following mcp/helpers.spl patterns.
# Deliberately does NOT import std.mcp.helpers: that module defines a
# same-signature `extract_json_string` (no escape tracking) which, under the
# seed's name-keyed co-compile registry, silently hijacks this module's
# definition in any test that co-compiles both. See
# doc/08_tracking/bug/llm_caret_json_helpers_escaped_quote_cross_module_2026-08-25.md
# Uses string concat (no f-strings) to avoid `}}` brace issues.

use std.text.{escape_json}

# Local one-liners (previously imported from std.mcp.helpers; see header)
fn Q() -> text:
    "\""

fn LB() -> text:
    "{"

fn RB() -> text:
    "}"

fn jp(key: text, value: text) -> text:
    Q() + key + Q() + ":" + value

fn js(value: text) -> text:
    Q() + escape_json(value) + Q()

# ============================================================================
# JSON Escaping
# ============================================================================

fn escape_json_text(s: text) -> text:
    escape_json(s)

# ============================================================================
# JSON Building Helpers
# ============================================================================


# JSON object with 1 pair
fn jo1(pair: text) -> text:
    var r = LB()
    r = r + pair
    r = r + RB()
    r

# JSON object with 2 pairs
fn jo2(p1: text, p2: text) -> text:
    var r = LB()
    r = r + p1
    r = r + ","
    r = r + p2
    r = r + RB()
    r

# JSON object with 3 pairs
fn jo3(p1: text, p2: text, p3: text) -> text:
    var r = LB()
    r = r + p1
    r = r + ","
    r = r + p2
    r = r + ","
    r = r + p3
    r = r + RB()
    r

# JSON object with 4 pairs
fn jo4(p1: text, p2: text, p3: text, p4: text) -> text:
    var r = LB()
    r = r + p1
    r = r + ","
    r = r + p2
    r = r + ","
    r = r + p3
    r = r + ","
    r = r + p4
    r = r + RB()
    r

# JSON object with 5 pairs
fn jo5(p1: text, p2: text, p3: text, p4: text, p5: text) -> text:
    var r = LB()
    r = r + p1
    r = r + ","
    r = r + p2
    r = r + ","
    r = r + p3
    r = r + ","
    r = r + p4
    r = r + ","
    r = r + p5
    r = r + RB()
    r

# JSON object with 6 pairs
fn jo6(p1: text, p2: text, p3: text, p4: text, p5: text, p6: text) -> text:
    var r = LB()
    r = r + p1 + ","
    r = r + p2 + ","
    r = r + p3 + ","
    r = r + p4 + ","
    r = r + p5 + ","
    r = r + p6
    r = r + RB()
    r

# JSON array from list of pre-formatted items
fn ja(items: [text]) -> text:
    var r = "["
    var i = 0
    for item in items:
        if i > 0:
            r = r + ","
        r = r + item
        i = i + 1
    r = r + "]"
    r

# ============================================================================
# JSON Parsing Helpers
# ============================================================================

# Substring search returning a bare index (-1 if absent).
# ponytail: hand-written scan, not text.index_of — the seed's int-boxing
# mangles certain Option<i64> results (e.g. index 3 returns nil) via the
# tag-box wall; see doc/08_tracking/bug/llm_caret_index_of_optioni64_tagbox_2026-07-07.md
fn json_find(s: text, needle: text) -> i64:
    val nlen = needle.len()
    if nlen == 0:
        return 0
    val slen = s.len()
    if nlen > slen:
        return -1
    # Compare with substring, not `s[i + j]`: `.len()`/`.substring()` count
    # BYTES while `[]` counts CHARACTERS, so bounding this loop by the byte
    # length and indexing by character ran off the end of any string holding
    # non-ASCII text -- a provider error message in Chinese was enough to trap.
    # Staying in bytes also keeps the RETURNED index in the same unit every
    # caller feeds it to (`json.substring(idx + ...)`), which the character
    # form silently got wrong even when it did not crash. See
    # doc/08_tracking/bug/text_len_substring_bytes_but_index_chars_2026-08-30.md
    var i = 0
    val last = slen - nlen
    while i <= last:
        if s.substring(i, i + nlen) == needle:
            return i
        i = i + 1
    -1

# Extract a string value for a given key from JSON
fn extract_json_string(json: text, key: text) -> text:
    val quote = "\""
    val search = quote + key + quote + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return ""
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed.starts_with(quote):
        val rest = trimmed.substring(1)
        # Find the unescaped closing quote by ACCUMULATING characters rather
        # than remembering an index and slicing: `.len()`/`.substring()` count
        # BYTES while `[]` counts CHARACTERS, so the index form both ran off
        # the end and sliced at the wrong offset on non-ASCII values. See
        # doc/08_tracking/bug/text_len_substring_bytes_but_index_chars_2026-08-30.md
        var acc = ""
        var escaped = false
        for ch in rest.chars():
            if escaped:
                acc = acc + ch
                escaped = false
            elif ch == "\\":
                acc = acc + ch
                escaped = true
            elif ch == "\"":
                return acc
            else:
                acc = acc + ch
    ""

# Extract a raw value (number, boolean, null) for a given key from JSON
fn extract_json_value(json: text, key: text) -> text:
    val search = Q() + key + Q() + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return "null"
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    # Same byte/char hazard as extract_json_string above.
    var acc = ""
    for ch in trimmed.chars():
        if ch == "," or ch == RB() or ch == "]":
            break
        acc = acc + ch
    acc.trim()

# Digit value of a single-char string, or -1 if not 0-9.
# ponytail: explicit compare, NOT ch.to_i64() — the seed boxes char.to_i64()
# across module boundaries (returns <value:0xN>/digit-value instead of the code
# point), so any to_i64-based digit loop mis-parses when called cross-module.
# See doc/08_tracking/bug/llm_caret_index_of_optioni64_tagbox_2026-07-07.md
fn _digit_val(ch: text) -> i64:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    -1

# Parse a decimal integer from text (bounded, boxing-free).
fn json_parse_int(s: text) -> i64:
    var n = 0
    var i = 0
    var neg = false
    if s.len() > 0 and s[0] == "-":
        neg = true
        i = 1
    while i < s.len():
        val d = _digit_val(s[i])
        if d >= 0:
            n = n * 10 + d
        i = i + 1
    if neg: -n else: n

# Extract integer value for a given key
fn extract_json_int(json: text, key: text) -> i64:
    val raw = extract_json_value(json, key)
    if raw == "null" or raw == "":
        return 0
    json_parse_int(raw)

# Extract boolean value for a given key
fn extract_json_bool(json: text, key: text) -> bool:
    val raw = extract_json_value(json, key)
    raw == "true"

# Extract a nested string value: outer_key -> inner_key
fn extract_nested_string(json: text, outer_key: text, inner_key: text) -> text:
    val search = Q() + outer_key + Q() + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return ""
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    extract_json_string(after, inner_key)

# ============================================================================
# Message JSON Building
# ============================================================================

# Build a single message as JSON object
fn build_message_json(role: text, content: text) -> text:
    jo2(jp("role", js(role)), jp("content", js(content)))

# Build messages array JSON from list of (role, content) pairs
fn build_messages_json(roles: [text], contents: [text]) -> text:
    var items: [text] = []
    var i = 0
    while i < roles.len():
        var r = roles[i]
        var c = ""
        if i < contents.len():
            c = contents[i]
        items = items + [build_message_json(r, c)]
        i = i + 1
    ja(items)
