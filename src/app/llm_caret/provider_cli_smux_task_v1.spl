# Local trusted in-process composition. No Controller writer, transport, root
# opener, PTY, raw input or public DTO-to-authority constructor is introduced.
use app.llm_caret.provider_cli_adapter_types_v1.ProviderCliRequestDataV1
use app.llm_caret.provider_cli_container_probe_v1.{ProviderCliContainedSelectionV1, ProviderCliContainedProbeReceiptV1}
use app.llm_caret.provider_cli_contained_task_v1.provider_cli_contained_task_constraint_data_v1
use std.nogc_sync_mut.orchestration.host_service_domain_v2.HostServiceRequestV2
use os.apps.smux.runtime_connection_owner_v5.{SmuxRuntimeConnectionOwnerV5, SmuxRuntimeConnectionTurnV5,
    SmuxRuntimeConnectionInputTurnV5, smux_runtime_connection_scope_v5,
    smux_runtime_connection_host_constrained_v5, smux_runtime_connection_input_resolve_v5,
    smux_runtime_connection_input_issue_v5, smux_runtime_connection_input_write_v5,
    smux_runtime_connection_input_observe_v5, smux_runtime_connection_input_revoke_v5}

pub fn provider_cli_smux_task_begin_v1(owner: SmuxRuntimeConnectionOwnerV5,
        selection: ProviderCliContainedSelectionV1, version_receipt: ProviderCliContainedProbeReceiptV1,
        request: HostServiceRequestV2, action: ProviderCliRequestDataV1) -> SmuxRuntimeConnectionTurnV5:
    val constraint = provider_cli_contained_task_constraint_data_v1(smux_runtime_connection_scope_v5(owner),
        selection, version_receipt, request, action)
    if constraint.is_err(): return SmuxRuntimeConnectionTurnV5(owner, nil, nil, "", constraint.unwrap_err())
    smux_runtime_connection_host_constrained_v5(owner, request, Some(constraint.unwrap()))

# Existing issuer resolves only an actual adopted pane and current attachment.
pub fn provider_cli_smux_input_resolve_v1(owner: SmuxRuntimeConnectionOwnerV5,
        binding_uid: text, client_id: text, attachment_token: text) -> Result<text, text>:
    smux_runtime_connection_input_resolve_v5(owner, binding_uid, client_id, attachment_token)

pub fn provider_cli_smux_input_issue_v1(owner: SmuxRuntimeConnectionOwnerV5,
        binding_uid: text, client_id: text, attachment_token: text, expected_revision: i64,
        expected_target_digest: text) -> SmuxRuntimeConnectionInputTurnV5:
    smux_runtime_connection_input_issue_v5(owner, binding_uid, client_id, attachment_token,
        expected_revision, expected_target_digest)

pub fn provider_cli_smux_input_write_v1(owner: SmuxRuntimeConnectionOwnerV5,
        binding_uid: text, client_id: text, attachment_token: text, nonce: text, revision: i64,
        attempt: i64, frame_sequence: i64, payload: text, offset: i64, maximum: i64) -> SmuxRuntimeConnectionInputTurnV5:
    # No automatic attempt increment, suffix retry, lease renewal or frame reset.
    # Queued/Unknown retains the canonical request and must be observed first.
    smux_runtime_connection_input_write_v5(owner, binding_uid, client_id, attachment_token,
        nonce, revision, attempt, frame_sequence, payload, offset, maximum)

pub fn provider_cli_smux_input_observe_v1(owner: SmuxRuntimeConnectionOwnerV5,
        binding_uid: text) -> SmuxRuntimeConnectionInputTurnV5:
    smux_runtime_connection_input_observe_v5(owner, binding_uid)

pub fn provider_cli_smux_input_revoke_v1(owner: SmuxRuntimeConnectionOwnerV5,
        binding_uid: text, expected_revision: i64) -> SmuxRuntimeConnectionInputTurnV5:
    # Revokes input authority only. It never sends EOF, detaches, interrupts or
    # settles the workload, and preserves actual pending-native uncertainty.
    smux_runtime_connection_input_revoke_v5(owner, binding_uid, expected_revision)
