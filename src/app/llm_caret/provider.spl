# LLM Caret - Provider Dispatch
#
# Routes requests to the correct backend based on provider name.
# Uses if/elif routing (no dynamic dispatch).

use app.llm_caret.claude_api.{claude_api_send}
use app.llm_caret.claude_cli.{claude_cli_send}
use app.llm_caret.local_torch.{local_torch_send}
use app.llm_caret.opencode_cli.{opencode_cli_send}
use app.llm_caret.openai_api.{openai_send}
use app.llm_caret.openai_compat.{compat_send}

# ============================================================================
# Unified response struct
# ============================================================================

struct LLMResponse:
    content: text
    model: text
    provider: text
    session_id: text
    stop_reason: text
    input_tokens: i64
    output_tokens: i64
    error: text
    is_error: bool
    raw: text

fn new_llm_error(provider: text, error_msg: text) -> LLMResponse:
    LLMResponse(
        content: "",
        model: "",
        provider: provider,
        session_id: "",
        stop_reason: "error",
        input_tokens: 0,
        output_tokens: 0,
        error: error_msg,
        is_error: true,
        raw: ""
    )

# ============================================================================
# Provider list
# ============================================================================

fn list_providers() -> [text]:
    ["dummy", "claude_cli", "opencode_cli", "claude_api", "openai", "openai_compat", "local_torch"]

fn is_valid_provider(provider: text) -> bool:
    if provider == "dummy":
        return true
    if provider == "claude_cli":
        return true
    if provider == "opencode_cli":
        return true
    if provider == "claude_api":
        return true
    if provider == "openai":
        return true
    if provider == "openai_compat":
        return true
    if provider == "local_torch":
        return true
    false

# ============================================================================
# Dispatch
# ============================================================================

fn dispatch_send(provider: text, prompt: text, model: text, api_key: text, base_url: text, cli_path: text, system_prompt: text, session_id: text, max_turns: i64, max_tokens: i64, messages_json: text) -> LLMResponse:
    dispatch_send_advanced(
        provider, prompt, model, api_key, base_url, cli_path,
        system_prompt, session_id, max_turns, max_tokens, messages_json,
        "", [], []
    )

fn dispatch_send_advanced(
    provider: text,
    prompt: text,
    model: text,
    api_key: text,
    base_url: text,
    cli_path: text,
    system_prompt: text,
    session_id: text,
    max_turns: i64,
    max_tokens: i64,
    messages_json: text,
    json_schema: text,
    tools: [text],
    extra_args: [text]
) -> LLMResponse:
    if not is_valid_provider(provider):
        return new_llm_error(provider, "unknown provider: " + provider)
    if provider != "claude_cli" and
       (json_schema != "" or tools.len() > 0 or extra_args.len() > 0):
        return new_llm_error(
            provider,
            "schema, tools, and extra CLI arguments require claude_cli"
        )

    if provider == "dummy":
        return LLMResponse(
            content: "hello",
            model: "dummy-hello",
            provider: "dummy",
            session_id: session_id,
            stop_reason: "end_turn",
            input_tokens: 0,
            output_tokens: 1,
            error: "",
            is_error: false,
            raw: ""
        )
    elif provider == "claude_cli":
        return _dispatch_claude_cli(
            cli_path, prompt, model, system_prompt, session_id,
            max_turns, max_tokens, json_schema, tools, extra_args
        )
    elif provider == "opencode_cli":
        return _dispatch_opencode_cli(cli_path, prompt, model, session_id)
    elif provider == "claude_api":
        return _dispatch_claude_api(api_key, base_url, model, messages_json, system_prompt, max_tokens)
    elif provider == "openai":
        return _dispatch_openai(api_key, base_url, model, messages_json, max_tokens)
    elif provider == "openai_compat":
        return _dispatch_compat(base_url, api_key, model, messages_json, max_tokens)
    elif provider == "local_torch":
        return _dispatch_local_torch(cli_path, model, prompt, max_tokens)
    else:
        return new_llm_error(provider, "provider not implemented: " + provider)

fn _dispatch_opencode_cli(cli_path: text, prompt: text, model: text, session_id: text) -> LLMResponse:
    val resp = opencode_cli_send(cli_path, prompt, model, session_id, "", [])
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "opencode_cli",
        session_id: resp.session_id,
        stop_reason: resp.stop_reason,
        input_tokens: resp.input_tokens,
        output_tokens: resp.output_tokens,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.raw
    )

# ============================================================================
# Claude CLI dispatch
# ============================================================================

fn _dispatch_claude_cli(
    cli_path: text,
    prompt: text,
    model: text,
    system_prompt: text,
    session_id: text,
    max_turns: i64,
    max_tokens: i64,
    json_schema: text,
    tools: [text],
    extra_args: [text]
) -> LLMResponse:
    var path = cli_path
    if path == "":
        path = "claude"
    val resp = claude_cli_send(
        path, prompt, model, system_prompt, session_id, max_turns, max_tokens,
        json_schema, tools, extra_args
    )
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "claude_cli",
        session_id: resp.session_id,
        stop_reason: resp.stop_reason,
        input_tokens: resp.input_tokens,
        output_tokens: resp.output_tokens,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.raw
    )

# ============================================================================
# Claude API dispatch
# ============================================================================

fn _dispatch_claude_api(api_key: text, base_url: text, model: text, messages_json: text, system_prompt: text, max_tokens: i64) -> LLMResponse:
    var url = base_url
    if url == "":
        url = "https://api.anthropic.com"
    val resp = claude_api_send(
        api_key, url, model, messages_json, system_prompt, max_tokens
    )
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "claude_api",
        session_id: "",
        stop_reason: resp.stop_reason,
        input_tokens: resp.input_tokens,
        output_tokens: resp.output_tokens,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.raw
    )

# ============================================================================
# OpenAI dispatch
# ============================================================================

fn _dispatch_openai(api_key: text, base_url: text, model: text, messages_json: text, max_tokens: i64) -> LLMResponse:
    var url = base_url
    if url == "":
        url = "https://api.openai.com"
    val resp = openai_send(
        api_key, url, model, messages_json, max_tokens, -1.0
    )
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "openai",
        session_id: "",
        stop_reason: resp.finish_reason,
        input_tokens: resp.prompt_tokens,
        output_tokens: resp.completion_tokens,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.raw
    )

# ============================================================================
# OpenAI-Compatible dispatch
# ============================================================================

fn _dispatch_compat(base_url: text, api_key: text, model: text, messages_json: text, max_tokens: i64) -> LLMResponse:
    var url = base_url
    if url == "":
        url = "http://localhost:11434"
    val resp = compat_send(
        url, api_key, model, messages_json, max_tokens, -1.0
    )
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "openai_compat",
        session_id: "",
        stop_reason: resp.finish_reason,
        input_tokens: resp.prompt_tokens,
        output_tokens: resp.completion_tokens,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.raw
    )

# ============================================================================
# Local Torch dispatch
# ============================================================================

fn _dispatch_local_torch(python_path: text, model_path: text, prompt: text, max_tokens: i64) -> LLMResponse:
    val resp = local_torch_send(python_path, model_path, prompt, max_tokens)
    var stop_reason = "end_turn"
    if resp.is_error:
        stop_reason = "error"
    LLMResponse(
        content: resp.content,
        model: resp.model,
        provider: "local_torch",
        session_id: "",
        stop_reason: stop_reason,
        input_tokens: 0,
        output_tokens: 0,
        error: resp.error,
        is_error: resp.is_error,
        raw: resp.content
    )
