# Explicit Codex Argv task-input mode through genuine signed Container Host
# execution. No raw write, shell, host task or stdin/EOF capability is created.
use app.llm_caret.provider_cli_adapter_types_v1.ProviderCliRequestDataV1
use app.llm_caret.provider_cli_container_probe_v1.{ProviderCliContainedSelectionV1, ProviderCliContainedProbeReceiptV1}
use app.llm_caret.provider_cli_contained_task_v1.provider_cli_contained_task_argv_constraint_v1
use std.nogc_sync_mut.orchestration.host_service_domain_v3.{HostServiceDomainV3, HostServiceTurnV3,
    host_service_domain_effect_input_constrained_turn_v3}
use std.nogc_sync_mut.orchestration.host_service_domain_v2.{HostServiceRequestV2, host_service_error_payload_v2}
use std.nogc_sync_mut.orchestration.host_service_execution_v4.{HostServiceExecutionTurnV4,
    host_service_execution_begin_input_constrained_v4}

# Finite effect-worker entry preserves the existing Linux/Windows sync routes.
pub fn provider_cli_contained_argv_task_effect_v1(domain: HostServiceDomainV3,
        selection: ProviderCliContainedSelectionV1, version_receipt: ProviderCliContainedProbeReceiptV1,
        request: HostServiceRequestV2, action: ProviderCliRequestDataV1) -> HostServiceTurnV3:
    val restricted = provider_cli_contained_task_argv_constraint_v1(domain, selection, version_receipt, request, action)
    if restricted.is_err():
        return HostServiceTurnV3(domain, 1, host_service_error_payload_v2(request, restricted.unwrap_err(), false))
    host_service_domain_effect_input_constrained_turn_v3(domain, request, restricted.unwrap())

# The existing Windows cooperative owner retains all continuation/native cleanup.
# Continue through the existing service step; canceling launch is not settlement.
pub fn provider_cli_contained_argv_task_begin_v1(domain: HostServiceDomainV3,
        selection: ProviderCliContainedSelectionV1, version_receipt: ProviderCliContainedProbeReceiptV1,
        request: HostServiceRequestV2, action: ProviderCliRequestDataV1) -> HostServiceExecutionTurnV4:
    val restricted = provider_cli_contained_task_argv_constraint_v1(domain, selection, version_receipt, request, action)
    if restricted.is_err():
        return HostServiceExecutionTurnV4(domain, nil,
            Some(host_service_error_payload_v2(request, restricted.unwrap_err(), false)), 1, restricted.unwrap_err())
    host_service_execution_begin_input_constrained_v4(domain, request, restricted.unwrap())
