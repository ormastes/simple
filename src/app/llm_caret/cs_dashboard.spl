# LLM Caret - the `cs` caret-suite DASHBOARD (default view when `cs` runs bare).
#
# Shows overall status, the agent roster, detail for the SELECTED agent, and a
# command/chat input line pinned at the BOTTOM. Panes are switched and
# maximized through app.llm_caret.pane_backend; per-process usage comes from the
# sosix host facade. Nothing here talks to tmux or POSIX directly.
#
# Split by purity so the dashboard is unit-testable:
#   pure   - cs_dashboard_new, cs_handle_command, cs_render, cs_help_text,
#            cs_launch_argv. A command returns the NEXT dashboard plus an
#            action/answer line; it performs no I/O and claims no effect.
#   impure - cs_refresh (re-poll) and cs_apply_action (execute one action line).
#
# Nothing is fabricated: an unreachable pane backend, a dead pid, or a usage
# read that reports `valid: false` renders as "-" / an explicit reason, never as
# a plausible zero.

use std.nogc_sync_mut.tui.style.{Style, styled, make_style, COLOR_NONE,
    COLOR_BLACK, COLOR_BLUE, COLOR_CYAN, COLOR_WHITE}
use std.nogc_async_mut.sosix.{sosix_proc_usage, sosix_is_running, sosix_which,
    sosix_platform}
use std.io_runtime.{env_get, file_exists}
use app.llm_caret.harness_spec.{parse_harness_spec, harness_spec_display}
use app.llm_caret.pane_backend.{Pane, pane_backend_name,
    pane_list, pane_select, pane_zoom, pane_spawn_at, pane_resize, pane_kill,
    pane_send, pane_capture, pane_capture_styled, pane_send_key, pane_key_bytes}

# cpu_pct/rss_mb use -1 as the UNMEASURED sentinel; 0 would be a real idle
# reading and must stay distinguishable from "we never got a number".
struct CsAgent:
    agent_id: text
    spec: text
    status: text
    pid: i64
    pane_id: text
    cpu_pct: f64
    rss_mb: i64
    detail: text

struct CsDashboard:
    session: text
    manager_status: text
    agents: [CsAgent]
    selected: i64
    input: text
    log: [text]
    # What the SELECTED agent's pane child printed, oldest first; empty when
    # nothing is selected or the backend could not capture it.
    screen: [text]

fn cs_dashboard_new(session: text) -> CsDashboard:
    CsDashboard(session: session, manager_status: "unknown: not polled yet",
        agents: [], selected: -1, input: "", log: [], screen: [])

fn _dash(d: CsDashboard, status: text, agents: [CsAgent], selected: i64,
        log: [text]) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: status, agents: agents,
        selected: selected, input: d.input, log: log, screen: d.screen)

fn _logged(d: CsDashboard, entry: text) -> [text]:
    d.log + [entry]

fn _usage_text(a: CsAgent) -> text:
    if a.rss_mb < 0:
        return "cpu -  rss -"
    "cpu " + a.cpu_pct.to_text() + "%  rss " + a.rss_mb.to_text() + "MB"

# ---------------------------------------------------------------------------
# Pure command handling
# ---------------------------------------------------------------------------

fn cs_help_text() -> text:
    val lines = [
        "/launch <spec>   launch an agent (harness[:provider][/model])",
        "/switch <n|id>   select an agent and focus its pane",
        "/max             maximize the selected agent's pane",
        "/key <name>      press enter|esc|tab|space|up|down|ctrl-c in its pane",
        "/kill <n|id>     kill an agent's pane",
        "/agents          list agents",
        "/help            this text",
        "/quit            leave the dashboard",
        "<text>           send a chat message to the selected agent"
    ]
    var out = ""
    for line in lines:
        out = out + line + "\n"
    out

fn _words(line: text) -> [text]:
    var out: [text] = []
    for part in line.split(" "):
        if part.trim() != "":
            out = out + [part.trim()]
    out

# `.split(sep, N)` ignores N on this seed, so the argument tail is rejoined.
fn _rest(words: [text]) -> text:
    var out = ""
    var i = 1
    while i < words.len():
        if out == "":
            out = words[i]
        else:
            out = out + " " + words[i]
        i = i + 1
    out

fn _resolve(d: CsDashboard, key: text) -> i64:
    var i = 0
    while i < d.agents.len():
        if d.agents[i].agent_id == key:
            return i
        i = i + 1
    val n = key.to_i64() ?? -1
    if n >= 1 and n <= d.agents.len():
        return n - 1
    -1

fn _agent_list_text(d: CsDashboard) -> text:
    if d.agents.len() == 0:
        return "(no agents)\n"
    var out = ""
    var i = 0
    while i < d.agents.len():
        val a = d.agents[i]
        val marker = if i == d.selected: ">" else: " "
        out = out + marker + " " + (i + 1).to_text() + " " + a.agent_id + "  " +
            a.spec + "  " + a.status + "\n"
        i = i + 1
    out

fn _with_status(d: CsDashboard, idx: i64, status: text) -> [CsAgent]:
    var out: [CsAgent] = []
    var i = 0
    while i < d.agents.len():
        val a = d.agents[i]
        if i == idx:
            out = out + [CsAgent(agent_id: a.agent_id, spec: a.spec,
                status: status, pid: a.pid, pane_id: a.pane_id,
                cpu_pct: a.cpu_pct, rss_mb: a.rss_mb, detail: a.detail)]
        else:
            out = out + [a]
        i = i + 1
    out

# Returns the next dashboard plus one line: either an ANSWER (help, listing, an
# error) or an ACTION for cs_apply_action to execute. A command never claims an
# effect it did not perform - `/max` yields "pane:zoom <pane_id>", it does not
# report the pane as maximized.
fn cs_handle_command(d: CsDashboard, line: text) -> (CsDashboard, text):
    val trimmed = line.trim()
    if trimmed == "":
        return (d, "")
    if not trimmed.starts_with("/"):
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before sending a message")
        val target = d.agents[d.selected]
        val next = _dash(d, d.manager_status, d.agents, d.selected,
            _logged(d, "-> " + target.agent_id + ": " + trimmed))
        return (next, "chat:" + target.agent_id + " " + trimmed)

    val words = _words(trimmed)
    val cmd = words[0]
    val arg = _rest(words)

    if cmd == "/help":
        return (d, cs_help_text())
    if cmd == "/quit":
        return (d, "quit")
    if cmd == "/agents":
        return (d, _agent_list_text(d))

    if cmd == "/launch":
        val spec = parse_harness_spec(arg)
        if not spec.valid:
            return (d, spec.error)
        val display = harness_spec_display(spec)
        val agent_id = "a" + (d.agents.len() + 1).to_text()
        val fresh = CsAgent(agent_id: agent_id, spec: display,
            status: "pending: not launched", pid: -1, pane_id: "",
            cpu_pct: -1.0, rss_mb: -1, detail: "queued by /launch")
        val agents = d.agents + [fresh]
        val next = _dash(d, d.manager_status, agents, agents.len() - 1,
            _logged(d, "launch " + display + " as " + agent_id))
        return (next, "launch:" + agent_id + " " + display)

    if cmd == "/switch":
        val idx = _resolve(d, arg)
        if idx < 0:
            return (d, "no such agent: " + arg)
        val next = _dash(d, d.manager_status, d.agents, idx,
            _logged(d, "switch to " + d.agents[idx].agent_id))
        if d.agents[idx].pane_id == "":
            return (next, "selected " + d.agents[idx].agent_id +
                ": no pane yet, nothing to focus")
        return (next, "pane:select " + d.agents[idx].pane_id)

    if cmd == "/max":
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before /max")
        val target = d.agents[d.selected]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to maximize")
        return (d, "pane:zoom " + target.pane_id)

    if cmd == "/key":
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before /key")
        if pane_key_bytes(arg) == "":
            return (d, "unknown key " + arg + ": enter|esc|tab|space|up|down|ctrl-c")
        val target = d.agents[d.selected]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to press keys in")
        return (d, "key:" + target.agent_id + " " + target.pane_id + " " + arg)

    if cmd == "/kill":
        val idx = _resolve(d, arg)
        if idx < 0:
            return (d, "no such agent: " + arg)
        val target = d.agents[idx]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to kill")
        val next = _dash(d, d.manager_status,
            _with_status(d, idx, "kill requested: not yet confirmed"),
            d.selected, _logged(d, "kill " + target.agent_id))
        return (next, "pane:kill " + target.agent_id + " " + target.pane_id)

    (d, "unknown command " + cmd + ": /help for usage")

# ---------------------------------------------------------------------------
# Pure rendering - header, roster, selected detail, input pinned at the BOTTOM
# ---------------------------------------------------------------------------

fn _detail_lines(d: CsDashboard) -> [text]:
    if d.selected < 0 or d.selected >= d.agents.len():
        return ["DETAIL  (no agent selected)"]
    val a = d.agents[d.selected]
    val pane = if a.pane_id == "": "(none)" else: a.pane_id
    var out = ["DETAIL  " + a.agent_id,
        "  spec " + a.spec + "   pane " + pane + "   pid " + a.pid.to_text(),
        "  status " + a.status,
        "  " + _usage_text(a),
        "  " + a.detail]
    val err_path = cs_stderr_path(d.session, a.agent_id)
    if a.pane_id != "" and err_path != "":
        out = out + ["  stderr " + err_path]
    out

# Where a launched agent's stderr goes (compile warnings would otherwise flood
# its screen). "" where the spawn cannot redirect it (Windows ConPTY).
fn cs_stderr_path(session: text, agent_id: text) -> text:
    if sosix_platform() == "windows":
        return ""
    var dir = env_get("TMPDIR") ?? ""
    if dir == "":
        dir = "/tmp"
    if dir.ends_with("/"):
        dir = dir.substring(0, dir.len() - 1)
    dir + "/cs-" + session + "-" + agent_id + ".stderr"

# Below this width the agent screen would be an unreadable sliver, so the
# frame stays single-column.
const CS_SPLIT_MIN_COLS: i64 = 60
const CS_LEFT_MIN_COLS: i64 = 32
# Header, help bar and input line: the full-width rows around the split body.
const CS_CHROME_ROWS: i64 = 3
# Log entries kept on screen; older ones scroll off.
const CS_LOG_SHOWN: i64 = 6
const CS_HELP_BAR: text = "/launch <spec>  /switch <n>  /key <name>  /kill <n>  /quit  ·  Enter send"
const CS_DIVIDER: text = "│"

# `content` fitted to exactly `width` terminal cells: escape sequences and
# control characters are dropped, then it is truncated or space-padded. Counts
# characters, not bytes - text.len() is a byte count and would mis-size any
# non-ASCII line.
fn cs_fit(content: text, width: i64) -> text:
    if width <= 0:
        return ""
    var out = ""
    var n = 0
    var mode = 0  # 0 text, 1 after ESC, 2 CSI, 3 OSC
    for ch in content.chars():
        if mode == 1:
            mode = 0
            if ch == "[":
                mode = 2
            if ch == "]":
                mode = 3
        elif mode == 2:
            if ch >= "@" and ch <= "~":
                mode = 0
        elif mode == 3:
            if ch == "\x07":
                mode = 0
        elif ch == "\x1b":
            mode = 1
        elif ch == "\t":
            if n < width:
                out = out + " "
                n = n + 1
        elif ch >= " " and ch != "\x7f":
            if n >= width:
                break
            out = out + ch
            n = n + 1
    while n < width:
        out = out + " "
        n = n + 1
    out

# cs_fit for an agent's styled screen row: SGR colour runs (CSI ... m) are kept,
# every other escape is dropped, and the row ends with a reset so its colours
# never bleed into the divider or the next row.
fn cs_fit_sgr(content: text, width: i64) -> text:
    if width <= 0:
        return ""
    var out = ""
    var seq = ""
    var n = 0
    var mode = 0  # 0 text, 1 after ESC, 2 CSI, 3 OSC
    for ch in content.chars():
        if mode == 1:
            mode = 0
            if ch == "[":
                mode = 2
                seq = "\x1b["
            if ch == "]":
                mode = 3
        elif mode == 2:
            seq = seq + ch
            if ch >= "@" and ch <= "~":
                mode = 0
                if ch == "m":
                    out = out + seq
        elif mode == 3:
            if ch == "\x07":
                mode = 0
        elif ch == "\x1b":
            mode = 1
        elif ch >= " " and ch != "\x7f":
            if n >= width:
                break
            out = out + ch
            n = n + 1
    out = out + "\x1b[0m"
    while n < width:
        out = out + " "
        n = n + 1
    out

# Left-column width and the selected agent's screen size for a frame. The
# agent screen is everything right of the divider below its title row, which
# is the size an agent pane should be given.
fn _left_width(cols: i64) -> i64:
    var left_w = cols * 2 / 5
    if left_w < CS_LEFT_MIN_COLS:
        left_w = CS_LEFT_MIN_COLS
    left_w

fn cs_agent_area(cols: i64, rows: i64) -> (i64, i64):
    if cols < CS_SPLIT_MIN_COLS or rows <= CS_CHROME_ROWS + 1:
        return (0, 0)
    (cols - _left_width(cols) - 1, rows - CS_CHROME_ROWS - 1)

# Right-hand region: the selected agent's own terminal output, newest at the
# bottom, so what the agent is doing right now is always visible.
fn _screen_lines(d: CsDashboard, height: i64) -> [text]:
    if d.selected < 0 or d.selected >= d.agents.len():
        return ["AGENT  (no agent selected)"]
    val a = d.agents[d.selected]
    var out: [text] = ["AGENT  " + a.agent_id + "  " + a.spec]
    if d.screen.len() == 0:
        return out + ["  (no output captured yet)"]
    val room = height - 1
    var start = d.screen.len() - room
    if start < 0:
        start = 0
    var i = start
    while i < d.screen.len():
        out = out + [d.screen[i]]
        i = i + 1
    out

fn _header(d: CsDashboard, clock: text) -> text:
    var running = 0
    for a in d.agents:
        if a.status == "running":
            running = running + 1
    var h = " cs " + d.session + " · " + d.manager_status + " · " +
        d.agents.len().to_text() + " agents · " + running.to_text() + " running"
    if clock != "":
        h = h + " · " + clock
    h

fn _paint(content: text, width: i64, style: Style, styled_out: bool) -> text:
    val fitted = cs_fit(content, width)
    if styled_out:
        return styled(fitted, style)
    fitted

fn _is_section(line: text) -> bool:
    line.starts_with("AGENTS") or line.starts_with("DETAIL") or line == "LOG" or
        line.starts_with("AGENT ")

# The frame as rows. `styled_out` adds ANSI styling for a live terminal; the
# plain form is what cs_render returns. The status header is the FIRST row and
# the input line the LAST, with a help bar above it, all full width. Between
# them the dashboard sits on the left and the selected agent's screen on the
# right. A body longer than its region is truncated; a shorter one is padded
# with blank lines, which is what pins the input to the bottom.
fn cs_frame_rows(d: CsDashboard, cols: i64, rows: i64, clock: text,
        styled_out: bool) -> [text]:
    val header_style = make_style(COLOR_WHITE, COLOR_BLUE, true, false, false, false)
    val plain = make_style(COLOR_NONE, COLOR_NONE, false, false, false, false)
    val title = make_style(COLOR_CYAN, COLOR_NONE, true, false, false, false)
    val chosen = make_style(COLOR_BLACK, COLOR_CYAN, true, false, false, false)
    val muted = make_style(COLOR_NONE, COLOR_NONE, false, false, false, true)
    val body = _dashboard_lines(d)
    val input_row = _paint("> " + d.input, cols, plain, false)
    if cols < CS_SPLIT_MIN_COLS or rows <= CS_CHROME_ROWS:
        var single: [text] = []
        val budget = if rows > 1: rows - 1 else: 0
        var i = 0
        while i < budget:
            if i == 0:
                single = single + [_paint(_header(d, clock), cols, header_style, styled_out)]
            else:
                val line = if i < body.len(): body[i] else: ""
                single = single + [_paint(line, cols, plain, false)]
            i = i + 1
        return single + [input_row]
    val left_w = _left_width(cols)
    val right_w = cols - left_w - 1
    val mid = rows - CS_CHROME_ROWS
    val screen = _screen_lines(d, mid)
    val selected_row = if d.selected >= 0: 2 + d.selected else: -1
    val divider = if styled_out: styled(CS_DIVIDER, muted) else: CS_DIVIDER
    var out: [text] = [_paint(_header(d, clock), cols, header_style, styled_out)]
    var i = 0
    while i < mid:
        val left = if i + 1 < body.len(): body[i + 1] else: ""
        val right = if i < screen.len(): screen[i] else: ""
        var left_style = plain
        var left_styled = false
        if i + 1 == selected_row:
            left_style = chosen
            left_styled = styled_out
        elif _is_section(left):
            left_style = title
            left_styled = styled_out
        val right_cell = if styled_out and i > 0: cs_fit_sgr(right, right_w)
            else: _paint(right, right_w, title, styled_out and i == 0)
        out = out + [_paint(left, left_w, left_style, left_styled) + divider + right_cell]
        i = i + 1
    out + [_paint(CS_HELP_BAR, cols, muted, styled_out), input_row]

fn cs_render(d: CsDashboard, cols: i64, rows: i64) -> text:
    cs_frame_rows(d, cols, rows, "", false).join("\n")

fn _dashboard_lines(d: CsDashboard) -> [text]:
    var body: [text] = [_header(d, ""),
        "AGENTS (" + d.agents.len().to_text() + ")"]
    for line in _agent_list_text(d).split("\n"):
        if line != "":
            body = body + ["  " + line]
    body = body + [""]
    for line in _detail_lines(d):
        body = body + [line]
    if d.log.len() > 0:
        body = body + ["", "LOG"]
        var start = d.log.len() - CS_LOG_SHOWN
        if start < 0:
            start = 0
        var k = start
        while k < d.log.len():
            body = body + ["  " + d.log[k]]
            k = k + 1
    body

# ---------------------------------------------------------------------------
# I/O - re-poll, and execute one action line
# ---------------------------------------------------------------------------

fn _find_pane(panes: [Pane], pane_id: text, title: text) -> [Pane]:
    for pane in panes:
        if pane_id != "" and pane.pane_id == pane_id:
            return [pane]
        if pane_id == "" and title != "" and pane.title == title:
            return [pane]
    []

fn _measured(a: CsAgent, pane: Pane, probe_pid: bool) -> CsAgent:
    var status = "running"
    var detail = "pane " + pane.pane_id + " title " + pane.title
    # smux lists only panes whose child it has confirmed alive, so a listed
    # smux pane IS running; only a tmux pid needs the OS probe (`probe_pid`).
    # TODO: [llm-caret][P1] Reports every live agent as exited on the shipped binary: the seed's rt_process_is_running returns false for any pid it did not spawn and a tmux pane is tmux's child; fixed in source, needs the deploy (doc/08_tracking/bug/interpreter_process_is_running_false_for_unspawned_pid_2026-09-06.md) [blocked:seed-deploy]
    if probe_pid and not sosix_is_running(pane.pid):
        status = "exited: pane pid " + pane.pid.to_text() + " is not running"
    val usage = sosix_proc_usage(pane.pid)
    var cpu = -1.0
    var rss = -1
    if usage.valid:
        cpu = usage.cpu_pct
        rss = usage.rss_mb
    else:
        detail = detail + " (usage unavailable for pid " + pane.pid.to_text() + ")"
    CsAgent(agent_id: a.agent_id, spec: a.spec, status: status, pid: pane.pid,
        pane_id: pane.pane_id, cpu_pct: cpu, rss_mb: rss, detail: detail)

fn _unmeasured(a: CsAgent, status: text, detail: text) -> CsAgent:
    CsAgent(agent_id: a.agent_id, spec: a.spec, status: status, pid: a.pid,
        pane_id: a.pane_id, cpu_pct: -1.0, rss_mb: -1, detail: detail)

fn cs_refresh(d: CsDashboard) -> CsDashboard:
    val backend = pane_backend_name()
    val probe_pid = backend == "tmux"
    val panes = pane_list(d.session)
    var agents: [CsAgent] = []
    for a in d.agents:
        var next = _unmeasured(a, "gone: pane closed", "pane " + a.pane_id +
            " is no longer listed")
        if a.pane_id == "" and (a.status.starts_with("pending") or a.status.starts_with("gone")):
            next = _unmeasured(a, a.status, a.detail)
        for pane in _find_pane(panes, a.pane_id, a.agent_id):
            next = _measured(a, pane, probe_pid)
        agents = agents + [next]
    # The header derives agent and running counts from the roster itself.
    _with_screen(_dash(d, "connected: " + backend, agents, d.selected, d.log))

# Lines kept for the right-hand agent screen; the render shows the newest ones
# that fit.
const CS_SCREEN_LINES: i64 = 200

fn _with_screen(d: CsDashboard) -> CsDashboard:
    var screen: [text] = []
    if d.selected >= 0 and d.selected < d.agents.len():
        val pane_id = d.agents[d.selected].pane_id
        if pane_id != "":
            screen = pane_capture_styled(d.session, pane_id, CS_SCREEN_LINES)
    CsDashboard(session: d.session, manager_status: d.manager_status,
        agents: d.agents, selected: d.selected, input: d.input, log: d.log,
        screen: screen)

# Cheap per-tick poll: re-captures the selected agent's screen and, on smux,
# drains every other agent's PTY as well. A smux child's output is only read
# by a capture, so an undrained child fills its PTY buffer and stalls. tmux
# drains its own panes. No process listing or usage probe - that is cs_refresh.
fn cs_poll_screens(d: CsDashboard) -> CsDashboard:
    if pane_backend_name() == "smux":
        var i = 0
        while i < d.agents.len():
            val pane_id = d.agents[i].pane_id
            if i != d.selected and pane_id != "":
                val _drained = pane_capture(d.session, pane_id, 1)
            i = i + 1
    _with_screen(d)

# Agent pane geometry for new spawns; 0 leaves the backend default.
var _cs_pane_cols: i64 = 0
var _cs_pane_rows: i64 = 0

# Sizes every agent pane to the right-hand screen, and remembers the size for
# panes spawned later, so a child lays out for exactly what is shown.
fn cs_resize_agents(d: CsDashboard, cols: i64, rows: i64):
    _cs_pane_cols = cols
    _cs_pane_rows = rows
    for a in d.agents:
        if a.pane_id != "":
            val _r = pane_resize(d.session, a.pane_id, cols, rows)

# Command line for a launch spec. Pure, so the spawned shape is testable
# without tmux. Element 0 is the command; the rest are its arguments.
fn cs_launch_argv(spec_text: text) -> [text]:
    val spec = parse_harness_spec(spec_text)
    if not spec.valid:
        return []
    if spec.harness == "caret":
        var argv = ["simple", "run", "src/app/llm_caret/main.spl"]
        if spec.provider != "":
            argv = argv + ["--provider", spec.provider]
        if spec.model != "":
            argv = argv + ["--model", spec.model]
        return argv
    if spec.model != "":
        return [spec.harness, "--model", spec.model]
    [spec.harness]

# Resolves a launch command to something that can actually be executed:
# SIMPLE_BINARY, then PATH, then the repo-local wrapper. Returns "" when the
# command genuinely cannot be found, so the caller reports that instead of
# spawning a pane that dies on exec.
fn cs_resolve_exe(name: text) -> text:
    if name == "simple":
        val override = env_get("SIMPLE_BINARY") ?? ""
        if override != "" and file_exists(override):
            return override
        val found = _which(name)
        if found != "":
            return found
        for local in ["bin/simple", "bin/simple.cmd"]:
            if file_exists(local):
                return local
        return ""
    _which(name)

# The names Windows would actually run for a bare command, in PATHEXT priority.
# A name that already carries an extension is taken as-is.
fn windows_executable_names(name: text) -> [text]:
    if name.contains("."):
        return [name]
    [name + ".exe", name + ".cmd", name + ".bat"]

# PATH lookup that honours Windows executable extensions: on Windows `claude`
# is claude.exe and `codex` is the npm shim codex.cmd, and a lookup of the bare
# name finds neither.
fn _which(name: text) -> text:
    if sosix_platform() != "windows":
        return sosix_which(name)
    for candidate in windows_executable_names(name):
        val found = sosix_which(candidate)
        if found != "":
            return found
    ""

fn _attach(d: CsDashboard, agent_id: text, pane: Pane) -> CsDashboard:
    var agents: [CsAgent] = []
    for a in d.agents:
        if a.agent_id == agent_id:
            agents = agents + [_measured(a, pane, pane_backend_name() == "tmux")]
        else:
            agents = agents + [a]
    _dash(d, d.manager_status, agents, d.selected, d.log)

fn _detach(d: CsDashboard, agent_id: text) -> CsDashboard:
    var agents: [CsAgent] = []
    for a in d.agents:
        if a.agent_id == agent_id:
            agents = agents + [CsAgent(agent_id: a.agent_id, spec: a.spec,
                status: "gone: killed", pid: a.pid, pane_id: "", cpu_pct: -1.0,
                rss_mb: -1, detail: "pane " + a.pane_id + " killed")]
        else:
            agents = agents + [a]
    _dash(d, d.manager_status, agents, d.selected, d.log)

# Executes one action line produced by cs_handle_command and reports what
# actually happened. Anything this cannot do is named, never silently swallowed.
fn cs_apply_action(d: CsDashboard, action: text) -> (CsDashboard, text):
    val words = _words(action)
    if words.len() == 0:
        return (d, "")
    val head = words[0]

    if head == "pane:select":
        if pane_select(d.session, words[1]):
            return (d, "focused pane " + words[1])
        return (d, "pane backend refused to focus " + words[1])
    if head == "pane:zoom":
        if pane_zoom(d.session, words[1]):
            return (d, "maximized pane " + words[1])
        return (d, "pane backend refused to maximize " + words[1])
    if head.starts_with("key:"):
        # "key:<agent_id> <pane_id> <key>"
        if words.len() < 3:
            return (d, "malformed key action")
        if pane_send_key(d.session, words[1], words[2]):
            return (d, "pressed " + words[2] + " in pane " + words[1])
        return (d, "pane backend refused key " + words[2] + " for pane " + words[1])
    if head == "pane:kill":
        if pane_kill(d.session, words[2]):
            # Forget the pane id: a backend may reuse it for the next spawn, and
            # the killed agent must not then be reported as that pane's owner.
            return (cs_refresh(_detach(d, words[1])), "killed pane " + words[2])
        return (d, "pane backend refused to kill " + words[2])
    if head.starts_with("launch:"):
        val agent_id = head.split(":")[1]
        val spec_text = _rest(words)
        val argv = cs_launch_argv(spec_text)
        if argv.len() == 0:
            return (d, "cannot launch " + spec_text + ": invalid spec")
        var args: [text] = []
        var i = 1
        while i < argv.len():
            args = args + [argv[i]]
            i = i + 1
        # argv[0] is a NAME, not a path. A caret agent runs the repo's own
        # Simple binary, which is not installed on PATH — launching the bare
        # name would spawn a pane that dies instantly with "command not
        # found", and the roster would show an agent that never existed.
        val exe = cs_resolve_exe(argv[0])
        if exe == "":
            return (d, "cannot launch " + agent_id + ": '" + argv[0] +
                "' is not on PATH and no repo binary was found")
        val pane = pane_spawn_at(d.session, agent_id, exe, args, _cs_pane_cols,
            _cs_pane_rows, cs_stderr_path(d.session, agent_id))
        if pane.pane_id == "":
            return (d, "pane backend could not spawn a pane for " + agent_id)
        return (_attach(d, agent_id, pane), "launched " + agent_id + " in pane " +
            pane.pane_id)
    if head.starts_with("chat:"):
        # "chat:<agent_id> <body>" - the body may contain spaces, so split off
        # the id only, never the remainder.
        val rest = action.substring(5, action.len())
        val sp = rest.index_of(" ")
        if sp <= 0:
            return (d, "malformed chat action")
        val chat_id = rest.substring(0, sp)
        val body = rest.substring(sp + 1, rest.len()).trim()
        if body == "":
            return (d, "empty message not sent")
        var chat_pane = ""
        for a in d.agents:
            if a.agent_id == chat_id:
                chat_pane = a.pane_id
        if chat_pane == "":
            return (d, "cannot deliver message: " + chat_id + " has no pane yet")
        if not pane_send(d.session, chat_pane, body):
            return (d, "pane backend refused the message for " + chat_id)
        return (d, "sent to " + chat_id + " (pane " + chat_pane + ")")
    (d, action)

export CsAgent, CsDashboard
export cs_dashboard_new, cs_refresh, cs_render, cs_handle_command, cs_help_text
export cs_frame_rows, cs_fit, cs_fit_sgr, cs_agent_area, cs_stderr_path, cs_poll_screens
export cs_resize_agents
export cs_launch_argv, cs_apply_action, cs_resolve_exe, windows_executable_names
