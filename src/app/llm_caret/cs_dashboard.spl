# LLM Caret - the `cs` caret-suite DASHBOARD (default view when `cs` runs bare).
#
# Shows overall status, the agent roster, detail for the SELECTED agent, and a
# command/chat input line pinned at the BOTTOM. Panes are switched and
# maximized through app.llm_caret.pane_backend; per-process usage comes from the
# sosix host facade. Nothing here talks to tmux or POSIX directly.
#
# Split by purity so the dashboard is unit-testable:
#   pure   - cs_dashboard_new, cs_handle_command, cs_render, cs_help_text,
#            cs_launch_argv. A command returns the NEXT dashboard plus an
#            action/answer line; it performs no I/O and claims no effect.
#   impure - cs_refresh (re-poll) and cs_apply_action (execute one action line).
#
# Nothing is fabricated: an unreachable pane backend, a dead pid, or a usage
# read that reports `valid: false` renders as "-" / an explicit reason, never as
# a plausible zero.

use std.nogc_sync_mut.tui.style.{Style, styled, make_style, COLOR_NONE,
    COLOR_BLACK, COLOR_BLUE, COLOR_CYAN, COLOR_WHITE}
use std.nogc_async_mut.sosix.host_facade.{sosix_proc_usage, sosix_is_running, sosix_which,
    sosix_platform, sosix_host_os}
use std.io_runtime.{env_get, file_exists, cwd}
use app.io.mod.{file_remove, dir_remove_all}
use std.nogc_sync_mut.container_session.macos_seatbelt_session_v1.{macos_seatbelt_image_selected_v1,
    macos_seatbelt_host_capable_v1, macos_seatbelt_canonical_path_v1}
use app.llm_caret.cs_container.{CsContainerRequest, cs_container_request, cs_container_argv,
    cs_container_name, cs_container_owner, cs_container_reap, cs_container_real_path,
    cs_container_present, cs_container_reap_session, cs_container_instance,
    cs_container_mark_launched, cs_container_launched}
use app.llm_caret.cs_container_lifecycle_v1.{CsContainerSessionRecordV1,
    cs_worktree_extract_flag_v1, cs_strip_workspace_for_cli_harness_v1,
    cs_worktree_create_v1, cs_worktree_remove_owned_v1,
    cs_container_record_save_v1, cs_container_write_runner_v1, cs_container_prepare_macos_seatbelt_v1,
    cs_container_records_load_v1, cs_container_reconcile_v1, cs_container_session_store_root_v1,
    cs_container_close_record_v1, cs_container_crashed_records_v1, cs_container_cleanup_old_v1,
    cs_container_prepare_relaunch_v1}
use app.llm_caret.cs_orchestrator_v1.{cs_orchestrator_dispatch_v1}
use app.llm_caret.workbench.session_contract.{SessionId, new_session_id}
use app.llm_caret.workbench.roster_order.{roster_order}
use app.llm_caret.harness_spec.{parse_harness_spec, harness_spec_display}
use app.llm_caret.cs_dashboard_model.{CsAgent, CsDashboard, cs_dashboard_new}
use app.llm_caret.pane_backend.{Pane, pane_backend_name,
    pane_list, pane_select, pane_zoom, pane_spawn_at, pane_resize, pane_kill,
    pane_send, pane_capture, pane_capture_styled, pane_send_key, pane_key_bytes}

fn _dash(d: CsDashboard, status: text, agents: [CsAgent], selected: i64,
        log: [text]) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: status, agents: agents,
        selected: selected, input: d.input, log: log, screen: d.screen,
        pins: d.pins, mru: d.mru)

fn _with_roster(d: CsDashboard, pins: [text], mru: [text]) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: d.manager_status,
        agents: d.agents, selected: d.selected, input: d.input, log: d.log,
        screen: d.screen, pins: pins, mru: mru)

# Indices into d.agents in display order (pinned, then MRU, then launch order).
fn _roster_indices(d: CsDashboard) -> [i64]:
    var ids: [SessionId] = []
    for a in d.agents:
        ids = ids + [new_session_id(a.agent_id)]
    var out: [i64] = []
    for s in roster_order(ids, d.pins, d.mru):
        var i = 0
        while i < d.agents.len():
            if d.agents[i].agent_id == s.value:
                out = out + [i]
            i = i + 1
    out

# Display row of the selected agent within the roster, or -1.
fn _selected_position(d: CsDashboard) -> i64:
    var pos = 0
    for i in _roster_indices(d):
        if i == d.selected:
            return pos
        pos = pos + 1
    -1

fn _bump_mru(mru: [text], id: text) -> [text]:
    var out = [id]
    for m in mru:
        if m != id:
            out = out + [m]
    out

fn _lower_subsequence(query: text, label: text) -> bool:
    var q: [char] = []
    for c in query.lower().chars():
        q = q + [c]
    var qi = 0
    for c in label.lower().chars():
        if qi < q.len() and c == q[qi]:
            qi = qi + 1
    qi == q.len()

fn _all_digits(s: text) -> bool:
    for c in s.chars():
        if c < '0' or c > '9':
            return false
    s != ""

# Exact id / 1-based number first (existing behaviour); otherwise a fuzzy label
# match. Returns the matching indices: one = resolved, several = ambiguous.
fn _resolve_fuzzy(d: CsDashboard, key: text) -> [i64]:
    val exact = _resolve(d, key)
    if exact >= 0:
        return [exact]
    if key == "" or _all_digits(key):
        return []
    var out: [i64] = []
    var i = 0
    while i < d.agents.len():
        val a = d.agents[i]
        if _lower_subsequence(key, a.agent_id + " " + a.spec):
            out = out + [i]
        i = i + 1
    out

fn _candidates_text(d: CsDashboard, idxs: [i64]) -> text:
    var out = ""
    for i in idxs:
        out = out + " " + d.agents[i].agent_id + " (" + d.agents[i].spec + ")"
    out

fn _logged(d: CsDashboard, entry: text) -> [text]:
    d.log + [entry]

fn _usage_text(a: CsAgent) -> text:
    if a.rss_mb < 0:
        return "cpu -  rss -"
    "cpu " + a.cpu_pct.to_text() + "%  rss " + a.rss_mb.to_text() + "MB"

# ---------------------------------------------------------------------------
# Pure command handling
# ---------------------------------------------------------------------------

fn cs_help_text() -> text:
    val lines = [
        "/launch <spec> [args...]   launch an agent (harness[:provider][/model], incl. agy)",
        "    --container <image|macos-seatbelt>  run via the Simple container layer",
        "    --worktree             create an isolated git worktree (cleaned on close, kept on crash)",
        "    --container-mount <src>:<dst>[:ro|rw]  --container-network host|none|private",
        "    --container-env KEY=VALUE   (e.g. GIT_AUTHOR_NAME, GIT_COMMITTER_EMAIL)",
        "/containers  (/crashed)    list tracked & crashed containers available for relaunch",
        "/relaunch <n|id|name> [args...]  relaunch a crashed container in its preserved worktree",
        "/close <n|id>              close an agent and clean its worktree & temp files",
        "/cleanup-old [--apply]    preview or remove cleanly exited attempts at least one hour old",
        "/orchestrator <sub>        start|status|launch|inspect|crashed|relaunch|close|stop",
        "    cleanup <id>          remove a crashed orchestrator worktree and artifacts",
        "/reap            remove EVERY container on this session, any cs's (after a killed cs)",
        "/switch <n|id|query>  select an agent (fuzzy label match) and focus its pane",
        "/pin [n|id]  /unpin [n|id]   keep an agent at the top of the roster",
        "/max             maximize the selected agent's pane",
        "/key <name>      press enter|esc|tab|space|up|down|left|right|ctrl-c in its pane",
        "/kill <n|id>     kill an agent's pane",
        "/agents          list agents",
        "/help            this text",
        "/quit            leave the dashboard",
        "<text>           send a chat message to the selected agent"
    ]
    var out = ""
    for line in lines:
        out = out + line + "\n"
    out

fn _words(line: text) -> [text]:
    var out: [text] = []
    for part in line.split(" "):
        if part.trim() != "":
            out = out + [part.trim()]
    out

# Quote-aware word splitter so multi-word prompts (`-p "hello world"`) stay intact
# while unquoted words split identically to `_words`.
fn cs_shell_words(line: text) -> [text]:
    var out: [text] = []
    var cur = ""
    var in_token = false
    var quote = ""
    var escaped = false
    for ch in line.chars():
        if escaped:
            cur = cur + ch
            in_token = true
            escaped = false
            continue
        if ch == "\\" and quote != "'":
            escaped = true
            in_token = true
            continue
        if quote != "":
            if ch == quote:
                quote = ""
            else:
                cur = cur + ch
            continue
        if ch == "\"" or ch == "'":
            quote = ch
            in_token = true
            continue
        if ch == " " or ch == "\t":
            if in_token:
                out.push(cur)
                cur = ""
                in_token = false
            continue
        cur = cur + ch
        in_token = true
    if in_token:
        out.push(cur)
    out

fn cs_quote_word_if_needed(word: text) -> text:
    if word == "":
        return "\"\""
    if not word.contains(" ") and not word.contains("\t") and not word.contains("\"") and not word.contains("'"):
        return word
    "\"" + word.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

# `.split(sep, N)` ignores N on this seed, so the argument tail is rejoined.
fn _rest(words: [text]) -> text:
    var out = ""
    var i = 1
    while i < words.len():
        if out == "":
            out = words[i]
        else:
            out = out + " " + words[i]
        i = i + 1
    out

fn _resolve(d: CsDashboard, key: text) -> i64:
    var i = 0
    while i < d.agents.len():
        if d.agents[i].agent_id == key:
            return i
        i = i + 1
    val n = key.to_i64() ?? -1
    if n >= 1 and n <= d.agents.len():
        return n - 1
    -1

fn _agent_list_text(d: CsDashboard) -> text:
    if d.agents.len() == 0:
        return "(no agents)\n"
    var out = ""
    for i in _roster_indices(d):
        val a = d.agents[i]
        val marker = if i == d.selected: ">" else: " "
        val pin = if _is_pinned(d, a.agent_id): "*" else: " "
        out = out + marker + pin + (i + 1).to_text() + " " + a.agent_id + "  " +
            a.spec + "  " + a.status + "\n"
    out

fn _is_pinned(d: CsDashboard, id: text) -> bool:
    for p in d.pins:
        if p == id:
            return true
    false

fn _with_status(d: CsDashboard, idx: i64, status: text) -> [CsAgent]:
    var out: [CsAgent] = []
    var i = 0
    while i < d.agents.len():
        val a = d.agents[i]
        if i == idx:
            out = out + [CsAgent(agent_id: a.agent_id, spec: a.spec,
                status: status, pid: a.pid, pane_id: a.pane_id,
                cpu_pct: a.cpu_pct, rss_mb: a.rss_mb, detail: a.detail)]
        else:
            out = out + [a]
        i = i + 1
    out

# Returns the next dashboard plus one line: either an ANSWER (help, listing, an
# error) or an ACTION for cs_apply_action to execute. A command never claims an
# effect it did not perform - `/max` yields "pane:zoom <pane_id>", it does not
# report the pane as maximized.
fn cs_handle_command(d: CsDashboard, line: text) -> (CsDashboard, text):
    val trimmed = line.trim()
    if trimmed == "":
        return (d, "")
    if not trimmed.starts_with("/"):
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before sending a message")
        val target = d.agents[d.selected]
        val next = _dash(d, d.manager_status, d.agents, d.selected,
            _logged(d, "-> " + target.agent_id + ": " + trimmed))
        return (next, "chat:" + target.agent_id + " " + trimmed)

    val words = _words(trimmed)
    val cmd = words[0]
    val arg = _rest(words)

    if cmd == "/help":
        return (d, cs_help_text())
    if cmd == "/quit":
        return (d, "quit")
    if cmd == "/agents":
        return (d, _agent_list_text(d))

    if cmd == "/launch":
        val launch_words = cs_shell_words(trimmed)
        val first = if launch_words.len() > 1: launch_words[1] else: ""
        val spec = parse_harness_spec(first)
        if not spec.valid:
            return (d, spec.error)
        val display = harness_spec_display(spec)
        var extras_text = ""
        var wi = 2
        while wi < launch_words.len():
            extras_text = extras_text + " " + cs_quote_word_if_needed(launch_words[wi])
            wi = wi + 1
        val shown = display + extras_text
        var next_id = d.agents.len() + 1
        while _resolve(d, "a" + next_id.to_text()) >= 0:
            next_id = next_id + 1
        val agent_id = "a" + next_id.to_text()
        val fresh = CsAgent(agent_id: agent_id, spec: shown,
            status: "pending: not launched", pid: -1, pane_id: "",
            cpu_pct: -1.0, rss_mb: -1, detail: "queued by /launch")
        val agents = d.agents + [fresh]
        val next = _dash(d, d.manager_status, agents, agents.len() - 1,
            _logged(d, "launch " + display + " as " + agent_id))
        return (next, "launch:" + agent_id + " " + shown)

    if cmd == "/containers" or cmd == "/crashed":
        return (d, "container:list-" + (if cmd == "/crashed": "crashed" else: "all"))

    if cmd == "/cleanup-old":
        if arg == "":
            return (d, "container:cleanup-old-preview")
        if arg == "--apply":
            return (d, "container:cleanup-old-apply")
        return (d, "usage: /cleanup-old [--apply]")

    if cmd == "/relaunch":
        val rl_words = cs_shell_words(trimmed)
        if rl_words.len() < 2 or rl_words[1] == "":
            return (d, "usage: /relaunch <n|id|container-name> [override-args...]")
        var target_key = rl_words[1]
        val resolved_idx = _resolve(d, target_key)
        if resolved_idx >= 0:
            target_key = d.agents[resolved_idx].agent_id
        var rl_tail = ""
        var ri = 2
        while ri < rl_words.len():
            rl_tail = rl_tail + " " + cs_quote_word_if_needed(rl_words[ri])
            ri = ri + 1
        return (d, "container:relaunch " + cs_quote_word_if_needed(target_key) + rl_tail)

    if cmd == "/close":
        val key = if arg == "" and d.selected >= 0: d.agents[d.selected].agent_id else: arg
        if key == "":
            return (d, "usage: /close <n|id>")
        val idx = _resolve(d, key)
        val target_id = if idx >= 0: d.agents[idx].agent_id else: key
        val pane_id = if idx >= 0: d.agents[idx].pane_id else: ""
        return (d, "session:close " + target_id + (if pane_id != "": " " + pane_id else: ""))

    if cmd == "/orchestrator" or cmd == "/orch":
        var orch_tail = ""
        val orch_words = cs_shell_words(trimmed)
        var oi = 1
        while oi < orch_words.len():
            orch_tail = orch_tail + (if orch_tail == "": "" else: " ") + cs_quote_word_if_needed(orch_words[oi])
            oi = oi + 1
        return (d, "orchestrator:" + orch_tail)

    if cmd == "/switch":
        val found = _resolve_fuzzy(d, arg)
        if found.len() == 0:
            return (d, "no such agent: " + arg)
        if found.len() > 1:
            return (d, "ambiguous: " + arg + " matches" + _candidates_text(d, found) +
                " - use a number or id")
        val idx = found[0]
        val picked = _dash(d, d.manager_status, d.agents, idx,
            _logged(d, "switch to " + d.agents[idx].agent_id))
        val next = _with_roster(picked, d.pins, _bump_mru(d.mru, d.agents[idx].agent_id))
        if d.agents[idx].pane_id == "":
            return (next, "selected " + d.agents[idx].agent_id +
                ": no pane yet, nothing to focus")
        return (next, "pane:select " + d.agents[idx].pane_id)

    if cmd == "/pin" or cmd == "/unpin":
        val key = if arg == "" and d.selected >= 0: d.agents[d.selected].agent_id else: arg
        val found = _resolve_fuzzy(d, key)
        if found.len() == 0:
            return (d, "no such agent: " + key)
        if found.len() > 1:
            return (d, "ambiguous: " + key + " matches" + _candidates_text(d, found))
        val id = d.agents[found[0]].agent_id
        var pins: [text] = []
        for p in d.pins:
            if p != id:
                pins = pins + [p]
        if cmd == "/pin":
            return (_with_roster(d, pins + [id], d.mru), "pinned " + id)
        return (_with_roster(d, pins, d.mru), "unpinned " + id)

    if cmd == "/max":
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before /max")
        val target = d.agents[d.selected]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to maximize")
        return (d, "pane:zoom " + target.pane_id)

    if cmd == "/key":
        if d.selected < 0:
            return (d, "no agent selected: /switch <n|id> before /key")
        if pane_key_bytes(arg) == "":
            return (d, "unknown key " + arg + ": enter|esc|tab|space|up|down|left|right|ctrl-c")
        val target = d.agents[d.selected]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to press keys in")
        return (d, "key:" + target.agent_id + " " + target.pane_id + " " + arg)

    if cmd == "/reap":
        return (d, "container:reap-session")

    if cmd == "/kill":
        val idx = _resolve(d, arg)
        if idx < 0:
            return (d, "no such agent: " + arg)
        val target = d.agents[idx]
        if target.pane_id == "":
            return (d, "agent " + target.agent_id + " has no pane to kill")
        val next = _dash(d, d.manager_status,
            _with_status(d, idx, "kill requested: not yet confirmed"),
            d.selected, _logged(d, "kill " + target.agent_id))
        return (next, "pane:kill " + target.agent_id + " " + target.pane_id)

    (d, "unknown command " + cmd + ": /help for usage")

# ---------------------------------------------------------------------------
# Pure rendering - header, roster, selected detail, input pinned at the BOTTOM
# ---------------------------------------------------------------------------

fn _detail_lines(d: CsDashboard) -> [text]:
    if d.selected < 0 or d.selected >= d.agents.len():
        return ["DETAIL  (no agent selected)"]
    val a = d.agents[d.selected]
    val pane = if a.pane_id == "": "(none)" else: a.pane_id
    var out = ["DETAIL  " + a.agent_id,
        "  spec " + a.spec + "   pane " + pane + "   pid " + a.pid.to_text(),
        "  status " + a.status,
        "  " + _usage_text(a),
        "  " + a.detail]
    val err_path = cs_stderr_path(d.session, a.agent_id)
    if a.pane_id != "" and err_path != "":
        out = out + ["  stderr " + err_path]
    out

# Where a launched agent's stderr goes (compile warnings would otherwise flood
# its screen). "" where the spawn cannot redirect it (Windows ConPTY).
fn cs_stderr_path(session: text, agent_id: text) -> text:
    if sosix_platform() == "windows":
        return ""
    var dir = env_get("TMPDIR") ?? ""
    if dir == "":
        dir = "/tmp"
    if dir.ends_with("/"):
        dir = dir.substring(0, dir.byte_len() - 1)
    dir + "/cs-" + session + "-" + agent_id + ".stderr"

# Below this width the agent screen would be an unreadable sliver, so the
# frame stays single-column.
const CS_SPLIT_MIN_COLS: i64 = 60
const CS_LEFT_MIN_COLS: i64 = 32
# Header, help bar and input line: the full-width rows around the split body.
const CS_CHROME_ROWS: i64 = 3
# Log entries kept on screen; older ones scroll off.
const CS_LOG_SHOWN: i64 = 6
const CS_HELP_BAR: text = "/launch <spec>  /switch <n>  /key <name>  /kill <n>  /quit  ·  Enter send"
const CS_DIVIDER: text = "│"

# `content` fitted to exactly `width` terminal cells: escape sequences and
# control characters are dropped, then it is truncated or space-padded. Counts
# characters, not bytes - text.len() is a byte count and would mis-size any
# non-ASCII line.
fn cs_fit(content: text, width: i64) -> text:
    if width <= 0:
        return ""
    var out = ""
    var n = 0
    var mode = 0  # 0 text, 1 after ESC, 2 CSI, 3 OSC
    for ch in content.chars():
        if mode == 1:
            mode = 0
            if ch == "[":
                mode = 2
            if ch == "]":
                mode = 3
        elif mode == 2:
            if ch >= "@" and ch <= "~":
                mode = 0
        elif mode == 3:
            if ch == "\x07":
                mode = 0
        elif ch == "\x1b":
            mode = 1
        elif ch == "\t":
            if n < width:
                out = out + " "
                n = n + 1
        elif ch >= " " and ch != "\x7f":
            if n >= width:
                break
            out = out + ch
            n = n + 1
    while n < width:
        out = out + " "
        n = n + 1
    out

# cs_fit for an agent's styled screen row: SGR colour runs (CSI ... m) are kept,
# every other escape is dropped, and the row ends with a reset so its colours
# never bleed into the divider or the next row.
fn cs_fit_sgr(content: text, width: i64) -> text:
    if width <= 0:
        return ""
    var out = ""
    var seq = ""
    var n = 0
    var mode = 0  # 0 text, 1 after ESC, 2 CSI, 3 OSC
    for ch in content.chars():
        if mode == 1:
            mode = 0
            if ch == "[":
                mode = 2
                seq = "\x1b["
            if ch == "]":
                mode = 3
        elif mode == 2:
            seq = seq + ch
            if ch >= "@" and ch <= "~":
                mode = 0
                if ch == "m":
                    out = out + seq
        elif mode == 3:
            if ch == "\x07":
                mode = 0
        elif ch == "\x1b":
            mode = 1
        elif ch >= " " and ch != "\x7f":
            if n >= width:
                break
            out = out + ch
            n = n + 1
    out = out + "\x1b[0m"
    while n < width:
        out = out + " "
        n = n + 1
    out

# Left-column width and the selected agent's screen size for a frame. The
# agent screen is everything right of the divider below its title row, which
# is the size an agent pane should be given.
fn _left_width(cols: i64) -> i64:
    var left_w = cols * 2 / 5
    if left_w < CS_LEFT_MIN_COLS:
        left_w = CS_LEFT_MIN_COLS
    left_w

fn cs_agent_area(cols: i64, rows: i64) -> (i64, i64):
    if cols < CS_SPLIT_MIN_COLS or rows <= CS_CHROME_ROWS + 1:
        return (0, 0)
    (cols - _left_width(cols) - 1, rows - CS_CHROME_ROWS - 1)

# Right-hand region: the selected agent's own terminal output, newest at the
# bottom, so what the agent is doing right now is always visible.
fn _screen_lines(d: CsDashboard, height: i64) -> [text]:
    if d.selected < 0 or d.selected >= d.agents.len():
        return ["AGENT  (no agent selected)"]
    val a = d.agents[d.selected]
    var out: [text] = ["AGENT  " + a.agent_id + "  " + a.spec]
    if d.screen.len() == 0:
        return out + ["  (no output captured yet)"]
    val room = height - 1
    var start = d.screen.len() - room
    if start < 0:
        start = 0
    var i = start
    while i < d.screen.len():
        out = out + [d.screen[i]]
        i = i + 1
    out

fn _header(d: CsDashboard, clock: text) -> text:
    var running = 0
    for a in d.agents:
        if a.status == "running":
            running = running + 1
    var h = " cs " + d.session + " · " + d.manager_status + " · " +
        d.agents.len().to_text() + " agents · " + running.to_text() + " running"
    if clock != "":
        h = h + " · " + clock
    h

fn _paint(content: text, width: i64, style: Style, styled_out: bool) -> text:
    val fitted = cs_fit(content, width)
    if styled_out:
        return styled(fitted, style)
    fitted

fn _is_section(line: text) -> bool:
    line.starts_with("AGENTS") or line.starts_with("DETAIL") or line == "LOG" or
        line.starts_with("AGENT ")

# The frame as rows. `styled_out` adds ANSI styling for a live terminal; the
# plain form is what cs_render returns. The status header is the FIRST row and
# the input line the LAST, with a help bar above it, all full width. Between
# them the dashboard sits on the left and the selected agent's screen on the
# right. A body longer than its region is truncated; a shorter one is padded
# with blank lines, which is what pins the input to the bottom.
fn cs_frame_rows(d: CsDashboard, cols: i64, rows: i64, clock: text,
        styled_out: bool) -> [text]:
    val header_style = make_style(COLOR_WHITE, COLOR_BLUE, true, false, false, false)
    val plain = make_style(COLOR_NONE, COLOR_NONE, false, false, false, false)
    val title = make_style(COLOR_CYAN, COLOR_NONE, true, false, false, false)
    val chosen = make_style(COLOR_BLACK, COLOR_CYAN, true, false, false, false)
    val muted = make_style(COLOR_NONE, COLOR_NONE, false, false, false, true)
    val body = _dashboard_lines(d)
    val input_row = _paint("> " + d.input, cols, plain, false)
    if cols < CS_SPLIT_MIN_COLS or rows <= CS_CHROME_ROWS:
        var single: [text] = []
        val budget = if rows > 1: rows - 1 else: 0
        var i = 0
        while i < budget:
            if i == 0:
                single = single + [_paint(_header(d, clock), cols, header_style, styled_out)]
            else:
                val line = if i < body.len(): body[i] else: ""
                single = single + [_paint(line, cols, plain, false)]
            i = i + 1
        return single + [input_row]
    val left_w = _left_width(cols)
    val right_w = cols - left_w - 1
    val mid = rows - CS_CHROME_ROWS
    val screen = _screen_lines(d, mid)
    val position = _selected_position(d)
    val selected_row = if position >= 0: 2 + position else: -1
    val divider = if styled_out: styled(CS_DIVIDER, muted) else: CS_DIVIDER
    var out: [text] = [_paint(_header(d, clock), cols, header_style, styled_out)]
    var i = 0
    while i < mid:
        val left = if i + 1 < body.len(): body[i + 1] else: ""
        val right = if i < screen.len(): screen[i] else: ""
        var left_style = plain
        var left_styled = false
        if i + 1 == selected_row:
            left_style = chosen
            left_styled = styled_out
        elif _is_section(left):
            left_style = title
            left_styled = styled_out
        val right_cell = if styled_out and i > 0: cs_fit_sgr(right, right_w)
            else: _paint(right, right_w, title, styled_out and i == 0)
        out = out + [_paint(left, left_w, left_style, left_styled) + divider + right_cell]
        i = i + 1
    out + [_paint(CS_HELP_BAR, cols, muted, styled_out), input_row]

fn cs_render(d: CsDashboard, cols: i64, rows: i64) -> text:
    cs_frame_rows(d, cols, rows, "", false).join("\n")

fn _dashboard_lines(d: CsDashboard) -> [text]:
    var body: [text] = [_header(d, ""),
        "AGENTS (" + d.agents.len().to_text() + ")"]
    for line in _agent_list_text(d).split("\n"):
        if line != "":
            body = body + ["  " + line]
    body = body + [""]
    for line in _detail_lines(d):
        body = body + [line]
    if d.log.len() > 0:
        body = body + ["", "LOG"]
        var start = d.log.len() - CS_LOG_SHOWN
        if start < 0:
            start = 0
        var k = start
        while k < d.log.len():
            body = body + ["  " + d.log[k]]
            k = k + 1
    body

# ---------------------------------------------------------------------------
# I/O - re-poll, and execute one action line
# ---------------------------------------------------------------------------

fn _find_pane(panes: [Pane], pane_id: text, title: text) -> [Pane]:
    for pane in panes:
        if pane_id != "" and pane.pane_id == pane_id:
            return [pane]
        if pane_id == "" and title != "" and pane.title == title:
            return [pane]
    []

fn _measured(a: CsAgent, pane: Pane, probe_pid: bool) -> CsAgent:
    var status = "running"
    var detail = "pane " + pane.pane_id + " title " + pane.title
    # smux lists only panes whose child it has confirmed alive, so a listed
    # smux pane IS running; only a tmux pid needs the OS probe (`probe_pid`).
    # TODO: [llm-caret][P1] Reports every live agent as exited on the shipped binary: the seed's rt_process_is_running returns false for any pid it did not spawn and a tmux pane is tmux's child; fixed in source, needs the deploy (doc/08_tracking/bug/interpreter_process_is_running_false_for_unspawned_pid_2026-09-06.md) [blocked:seed-deploy]
    if probe_pid and not sosix_is_running(pane.pid):
        status = "exited: pane pid " + pane.pid.to_text() + " is not running"
    val usage = sosix_proc_usage(pane.pid)
    var cpu = -1.0
    var rss = -1
    if usage.valid:
        cpu = usage.cpu_pct
        rss = usage.rss_mb
    else:
        detail = detail + " (usage unavailable for pid " + pane.pid.to_text() + ")"
    CsAgent(agent_id: a.agent_id, spec: a.spec, status: status, pid: pane.pid,
        pane_id: pane.pane_id, cpu_pct: cpu, rss_mb: rss, detail: detail)

fn _unmeasured(a: CsAgent, status: text, detail: text) -> CsAgent:
    CsAgent(agent_id: a.agent_id, spec: a.spec, status: status, pid: a.pid,
        pane_id: a.pane_id, cpu_pct: -1.0, rss_mb: -1, detail: detail)

fn cs_refresh(d: CsDashboard) -> CsDashboard:
    val backend = pane_backend_name()
    val probe_pid = backend == "tmux"
    val panes = pane_list(d.session)
    var live_pane_ids: [text] = []
    for p in panes:
        if not probe_pid or sosix_is_running(p.pid):
            live_pane_ids.push(p.pane_id)
    val records = cs_container_reconcile_v1(d.session, live_pane_ids)
    var agents: [CsAgent] = []
    for a in d.agents:
        var next = _unmeasured(a, "gone: pane closed", "pane " + a.pane_id +
            " is no longer listed")
        if a.pane_id == "" and (a.status.starts_with("pending") or a.status.starts_with("gone")):
            next = _unmeasured(a, a.status, a.detail)
        for pane in _find_pane(panes, a.pane_id, a.agent_id):
            next = _measured(a, pane, probe_pid)
        for rec in records:
            if rec.agent_id == a.agent_id and rec.state == "crashed":
                next = CsAgent(agent_id: a.agent_id, spec: a.spec,
                    status: "crashed: exit " + rec.exit_code.to_text(), pid: -1,
                    pane_id: "", cpu_pct: -1.0, rss_mb: -1,
                    detail: "container " + rec.name + " worktree " + rec.worktree_path + " preserved for /relaunch")
            elif rec.agent_id == a.agent_id and rec.state == "exited-clean" and next.status.starts_with("gone"):
                next = _unmeasured(a, "exited: clean (0)",
                    "container " + rec.name + " ready to /close")
        agents = agents + [next]
    for rec in records:
        if _resolve(d, rec.agent_id) < 0:
            val status = if rec.state == "crashed": "crashed: exit " + rec.exit_code.to_text() else: rec.state
            agents.push(CsAgent(agent_id: rec.agent_id, spec: rec.spec,
                status: status, pid: rec.pid, pane_id: rec.pane_id, cpu_pct: -1.0,
                rss_mb: -1, detail: rec.worktree_path))
    # The header derives agent and running counts from the roster itself.
    _with_screen(_dash(d, "connected: " + backend, agents, d.selected, d.log))

# Lines kept for the right-hand agent screen; the render shows the newest ones
# that fit.
const CS_SCREEN_LINES: i64 = 200

fn _with_screen(d: CsDashboard) -> CsDashboard:
    var screen: [text] = []
    if d.selected >= 0 and d.selected < d.agents.len():
        val pane_id = d.agents[d.selected].pane_id
        if pane_id != "":
            screen = pane_capture_styled(d.session, pane_id, CS_SCREEN_LINES)
    CsDashboard(session: d.session, manager_status: d.manager_status,
        agents: d.agents, selected: d.selected, input: d.input, log: d.log,
        screen: screen, pins: d.pins, mru: d.mru)

# Cheap per-tick poll: re-captures the selected agent's screen and, on smux,
# drains every other agent's PTY as well. A smux child's output is only read
# by a capture, so an undrained child fills its PTY buffer and stalls. tmux
# drains its own panes. No process listing or usage probe - that is cs_refresh.
fn cs_poll_screens(d: CsDashboard) -> CsDashboard:
    if pane_backend_name() == "smux":
        var i = 0
        while i < d.agents.len():
            val pane_id = d.agents[i].pane_id
            if i != d.selected and pane_id != "":
                val _drained = pane_capture(d.session, pane_id, 1)
            i = i + 1
    _with_screen(d)

# Agent pane geometry for new spawns; 0 leaves the backend default.
var _cs_pane_cols: i64 = 0
var _cs_pane_rows: i64 = 0

# Sizes every agent pane to the right-hand screen, and remembers the size for
# panes spawned later, so a child lays out for exactly what is shown.
fn cs_resize_agents(d: CsDashboard, cols: i64, rows: i64):
    _cs_pane_cols = cols
    _cs_pane_rows = rows
    for a in d.agents:
        if a.pane_id != "":
            val _r = pane_resize(d.session, a.pane_id, cols, rows)

# Command line for a launch spec. Pure, so the spawned shape is testable
# without tmux. Element 0 is the command; the rest are its arguments.
fn cs_launch_argv(spec_text: text) -> [text]:
    val spec = parse_harness_spec(spec_text)
    if not spec.valid:
        return []
    if spec.harness == "caret":
        var argv = ["simple", "run", "src/app/llm_caret/main.spl"]
        if spec.provider != "":
            argv = argv + ["--provider", spec.provider]
        if spec.model != "":
            argv = argv + ["--model", spec.model]
        return argv
    if spec.model != "":
        return [spec.harness, "--model", spec.model]
    [spec.harness]

# Launch argv plus extra words appended verbatim, in order. Invalid spec -> [].
fn cs_launch_argv_with_extras(spec_text: text, extras: [text]) -> [text]:
    val argv = cs_launch_argv(spec_text)
    if argv.len() == 0:
        return []
    argv + extras

# Resolves a launch command to something that can actually be executed:
# SIMPLE_BINARY, then PATH, then the repo-local wrapper. Returns "" when the
# command genuinely cannot be found, so the caller reports that instead of
# spawning a pane that dies on exec.
fn cs_resolve_exe(name: text) -> text:
    if name == "simple":
        val override = env_get("SIMPLE_BINARY") ?? ""
        if override != "" and file_exists(override):
            return override
        val found = _which(name)
        if found != "":
            return found
        for local in ["bin/simple", "bin/simple.cmd"]:
            if file_exists(local):
                return local
        return ""
    _which(name)

# The names Windows would actually run for a bare command, in PATHEXT priority.
# A name that already carries an extension is taken as-is.
fn windows_executable_names(name: text) -> [text]:
    if name.contains("."):
        return [name]
    [name + ".exe", name + ".cmd", name + ".bat"]

# PATH lookup that honours Windows executable extensions: on Windows `claude`
# is claude.exe and `codex` is the npm shim codex.cmd, and a lookup of the bare
# name finds neither.
fn _which(name: text) -> text:
    if sosix_platform() != "windows":
        return sosix_which(name)
    for candidate in windows_executable_names(name):
        val found = sosix_which(candidate)
        if found != "":
            return found
    ""

fn _attach(d: CsDashboard, agent_id: text, pane: Pane) -> CsDashboard:
    var agents: [CsAgent] = []
    for a in d.agents:
        if a.agent_id == agent_id:
            agents = agents + [_measured(a, pane, pane_backend_name() == "tmux")]
        else:
            agents = agents + [a]
    _dash(d, d.manager_status, agents, d.selected, d.log)

fn _detach(d: CsDashboard, agent_id: text) -> CsDashboard:
    var agents: [CsAgent] = []
    for a in d.agents:
        if a.agent_id == agent_id:
            agents = agents + [CsAgent(agent_id: a.agent_id, spec: a.spec,
                status: "gone: killed", pid: a.pid, pane_id: "", cpu_pct: -1.0,
                rss_mb: -1, detail: "pane " + a.pane_id + " killed")]
        else:
            agents = agents + [a]
    _dash(d, d.manager_status, agents, d.selected, d.log)

# Executes one action line produced by cs_handle_command and reports what
# actually happened. Anything this cannot do is named, never silently swallowed.
# Runs the agent through the Simple container layer: the pane's process is
# the engine client attached to the container's tty. A container left by an
# existing container of the same name refuses the launch (see /reap). A
# refused or failed launch leaves the agent unmarked, so it can never cause a
# removal: the name may be another cs's live container. See
# roster entry.
fn _live_pane_ids_for(session: text) -> [text]:
    val probe_pid = pane_backend_name() == "tmux"
    var ids: [text] = []
    for p in pane_list(session):
        if not probe_pid or sosix_is_running(p.pid):
            ids.push(p.pane_id)
    ids

fn _cs_launch_macos_seatbelt(d: CsDashboard, agent_id: text, spec_shown: text,
        exe: text, args: [text], repo_root: text, worktree_path: text,
        worktree_owned: bool, container: CsContainerRequest) -> (CsDashboard, text):
    if not macos_seatbelt_host_capable_v1():
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "cannot launch " + agent_id + ": macOS Seatbelt (/usr/bin/sandbox-exec) unavailable or nested sandbox refused")
    val stderr_path = cs_stderr_path(d.session, agent_id)
    val prepared = match cs_container_prepare_macos_seatbelt_v1(d.session, agent_id,
            spec_shown, exe, args, repo_root, worktree_path, worktree_owned,
            stderr_path, env_get("HOME") ?? "", cs_container_instance(), container):
        case Ok(pair): pair
        case Err(reason):
            if worktree_owned and worktree_path != "":
                val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
            return (d, "cannot launch " + agent_id + ": " + reason)
    var rec = prepared.0
    val run_path = prepared.1
    val pane = pane_spawn_at(d.session, agent_id, "/bin/sh", [run_path], _cs_pane_cols,
        _cs_pane_rows, stderr_path)
    if pane.pane_id == "":
        val _closed = cs_container_close_record_v1(d.session, agent_id, [], true)
        return (d, "pane backend could not spawn a pane for " + agent_id)
    rec.pane_id = pane.pane_id
    rec.pid = pane.pid
    val _saved = cs_container_record_save_v1(rec)
    val wt_note = if worktree_path != "": " worktree " + worktree_path else: ""
    (_attach(d, agent_id, pane), "launched " + agent_id + " in pane " + pane.pane_id +
        " inside container " + rec.name + " (macos-seatbelt)" + wt_note)

fn _cs_launch_owned_worktree(d: CsDashboard, agent_id: text, spec_shown: text,
        exe: text, args: [text], repo_root: text, worktree_path: text) -> (CsDashboard, text):
    val name = cs_container_name(d.session, agent_id)
    val stderr_path = cs_stderr_path(d.session, agent_id)
    var rec = CsContainerSessionRecordV1(
        name: name, owner: cs_container_owner(d.session), session: d.session,
        agent_id: agent_id, spec: spec_shown, backend: "host-worktree", image: "",
        executable: exe, argv: args, repo_root: repo_root, worktree_path: worktree_path,
        worktree_owned: true, attempt_dir: cs_container_session_store_root_v1(d.session) + "/containers/" + name,
        stderr_path: stderr_path, pane_id: "", pid: -1, instance: cs_container_instance(),
        network: "", env: [], state: "running", exit_code: -1)
    val runner = cs_container_write_runner_v1(rec, [exe] + args)
    if runner.is_err() or not cs_container_record_save_v1(rec):
        val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        val _attempt = dir_remove_all(rec.attempt_dir)
        return (d, "cannot launch " + agent_id + ": could not prepare worktree session record")
    val pane = pane_spawn_at(d.session, agent_id, "/bin/sh", [runner.unwrap()],
        _cs_pane_cols, _cs_pane_rows, stderr_path)
    if pane.pane_id == "":
        val _closed = cs_container_close_record_v1(d.session, agent_id, [], true)
        return (d, "pane backend could not spawn a pane for " + agent_id)
    rec.pane_id = pane.pane_id
    rec.pid = pane.pid
    if not cs_container_record_save_v1(rec):
        val _k = pane_kill(d.session, pane.pane_id)
        val _closed = cs_container_close_record_v1(d.session, agent_id, [], true)
        return (d, "cannot launch " + agent_id + ": could not save worktree pane")
    (_attach(d, agent_id, pane), "launched " + agent_id + " in pane " + pane.pane_id +
        " worktree " + worktree_path)

fn cs_repo_root() -> text:
    val explicit = env_get("SIMPLE_CS_REPO_ROOT") ?? ""
    if explicit != "":
        return explicit
    cwd()

fn _cs_launch_in_container(d: CsDashboard, agent_id: text, spec_shown: text, exe: text,
        args: [text], worktree_path: text, worktree_owned: bool,
        container: CsContainerRequest) -> (CsDashboard, text):
    val base_repo = cs_repo_root()
    val real_exe = macos_seatbelt_canonical_path_v1(exe)
    val repo_root = macos_seatbelt_canonical_path_v1(base_repo)
    if real_exe == "" or repo_root == "":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(base_repo, worktree_path)
        return (d, "cannot launch " + agent_id + ": could not resolve the binary or repo path")
    if macos_seatbelt_image_selected_v1(container.image, sosix_host_os()):
        return _cs_launch_macos_seatbelt(d, agent_id, spec_shown, real_exe, args, repo_root,
            worktree_path, worktree_owned, container)
    val podman_exe = cs_container_real_path(exe)
    val podman_repo = cs_container_real_path(base_repo)
    if podman_exe == "" or podman_repo == "":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "cannot launch " + agent_id + ": could not resolve the binary or repo path")
    val engine_argv = match cs_container_argv(d.session, agent_id, podman_exe, args, podman_repo,
            env_get("TERM") ?? "", env_get("HOME") ?? "", cs_container_instance(), container):
        case Ok(value): value
        case Err(reason):
            if worktree_owned and worktree_path != "":
                val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
            return (d, "cannot launch " + agent_id + ": " + reason)
    val engine = _which(engine_argv[0])
    if engine == "":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "cannot launch " + agent_id + ": '" + engine_argv[0] + "' is not on PATH")
    val present = cs_container_present(d.session, agent_id)
    if present == "exists":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "cannot launch " + agent_id + ": container " + cs_container_name(d.session, agent_id) +
            " already exists (another cs on this session, or left by a killed one): /reap removes it")
    if present != "":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "cannot launch " + agent_id + ": container state unknown: " + present)
    var engine_args: [text] = []
    var i = 1
    while i < engine_argv.len():
        engine_args = engine_args + [engine_argv[i]]
        i = i + 1
    val pane = pane_spawn_at(d.session, agent_id, engine, engine_args, _cs_pane_cols,
        _cs_pane_rows, cs_stderr_path(d.session, agent_id))
    if pane.pane_id == "":
        if worktree_owned and worktree_path != "":
            val _rm = cs_worktree_remove_owned_v1(repo_root, worktree_path)
        return (d, "pane backend could not spawn a pane for " + agent_id)
    cs_container_mark_launched(d.session, agent_id)
    (_attach(d, agent_id, pane), "launched " + agent_id + " in pane " + pane.pane_id +
        " inside container " + cs_container_name(d.session, agent_id))

# Removes every non-crashed container and its worktree/temp files when a cs
# loop ends cleanly; crashed containers and their worktrees remain preserved
# on disk for `/containers` and `/relaunch`.
fn cs_reap_containers(d: CsDashboard) -> text:
    var note = ""
    val live_ids = _live_pane_ids_for(d.session)
    for rec in cs_container_reconcile_v1(d.session, live_ids):
        if rec.state == "crashed":
            note = note + "preserved crashed container " + rec.name + " worktree " + rec.worktree_path + "\n"
        else:
            if rec.state == "running" and rec.pane_id != "" and live_ids.contains(rec.pane_id):
                val killed = pane_kill(d.session, rec.pane_id)
                if not killed and _live_pane_ids_for(d.session).contains(rec.pane_id):
                    note = note + "could not close pane " + rec.pane_id + "\n"
                    continue
            val (_ok, msg) = cs_container_close_record_v1(d.session, rec.agent_id, live_ids, rec.state == "running")
            if msg != "" and not _ok:
                note = note + msg + "\n"
    for a in d.agents:
        if cs_container_launched(d.session, a.agent_id):
            val reap_error = cs_container_reap(d.session, a.agent_id)
            if reap_error != "":
                note = note + "container " + cs_container_name(d.session, a.agent_id) + " NOT removed: " + reap_error + "\n"
            else:
                val _spool = file_remove(cs_stderr_path(d.session, a.agent_id))
        elif a.status != "crashed" and not a.status.starts_with("crashed:"):
            val _spool2 = file_remove(cs_stderr_path(d.session, a.agent_id))
    note

fn _format_container_records(session: text, crashed_only: bool) -> text:
    val live_ids = _live_pane_ids_for(session)
    val records = if crashed_only: cs_container_crashed_records_v1(session, live_ids)
        else: cs_container_reconcile_v1(session, live_ids)
    if records.len() == 0:
        return if crashed_only: "(no crashed containers)\n" else: "(no tracked containers)\n"
    var out = ""
    for rec in records:
        out = out + rec.agent_id + "  " + rec.name + "  [" + rec.state +
            " exit=" + rec.exit_code.to_text() + "]  backend=" + rec.backend +
            "  worktree=" + (if rec.worktree_path == "": "(none)" else: rec.worktree_path) +
            "  spec=" + rec.spec + "\n"
    out

fn cs_apply_action(d: CsDashboard, action: text) -> (CsDashboard, text):
    val words = _words(action)
    if words.len() == 0:
        return (d, "")
    val head = words[0]

    if head == "pane:select":
        if pane_select(d.session, words[1]):
            return (d, "focused pane " + words[1])
        return (d, "pane backend refused to focus " + words[1])
    if head == "pane:zoom":
        if pane_zoom(d.session, words[1]):
            return (d, "maximized pane " + words[1])
        return (d, "pane backend refused to maximize " + words[1])
    if head.starts_with("key:"):
        # "key:<agent_id> <pane_id> <key>"
        if words.len() < 3:
            return (d, "malformed key action")
        if pane_send_key(d.session, words[1], words[2]):
            return (d, "pressed " + words[2] + " in pane " + words[1])
        return (d, "pane backend refused key " + words[2] + " for pane " + words[1])
    if head == "container:list-all":
        return (cs_refresh(d), _format_container_records(d.session, false))
    if head == "container:list-crashed":
        return (cs_refresh(d), _format_container_records(d.session, true))
    if head == "container:cleanup-old-preview" or head == "container:cleanup-old-apply":
        val apply_changes = head == "container:cleanup-old-apply"
        val result = cs_container_cleanup_old_v1(d.session, _live_pane_ids_for(d.session), apply_changes)
        if not apply_changes:
            return (d, "eligible clean attempts: " + result.eligible.len().to_text() +
                (if result.eligible.len() == 0: "" else: " (" + result.eligible.join(", ") + ")") +
                "\nRun /cleanup-old --apply to remove their temp files and owned worktrees.")
        var note = "removed clean attempts: " + result.removed.len().to_text()
        if result.failures.len() > 0:
            note = note + "\n" + result.failures.join("\n")
        return (cs_refresh(d), note)
    if head == "container:relaunch":
        val rl_words = cs_shell_words(action)
        if rl_words.len() < 2:
            return (d, "malformed relaunch action")
        val target_key = rl_words[1]
        var override_args: [text] = []
        var ri = 2
        while ri < rl_words.len():
            override_args.push(rl_words[ri])
            ri = ri + 1
        val prepared = match cs_container_prepare_relaunch_v1(d.session, target_key,
                override_args, _live_pane_ids_for(d.session), cs_container_instance(),
                env_get("HOME") ?? ""):
            case Ok(pair): pair
            case Err(reason): return (d, "cannot relaunch " + target_key + ": " + reason)
        var rec = prepared.0
        val run_path = prepared.1
        val pane = pane_spawn_at(d.session, rec.agent_id, "/bin/sh", [run_path],
            _cs_pane_cols, _cs_pane_rows, rec.stderr_path)
        if pane.pane_id == "":
            return (d, "pane backend could not spawn relaunch pane for " + rec.agent_id)
        rec.pane_id = pane.pane_id
        rec.pid = pane.pid
        val _saved = cs_container_record_save_v1(rec)
        var base_d = d
        if _resolve(base_d, rec.agent_id) < 0:
            val restored = CsAgent(agent_id: rec.agent_id, spec: rec.spec,
                status: "running", pid: pane.pid, pane_id: pane.pane_id,
                cpu_pct: -1.0, rss_mb: -1, detail: "relaunched in " + rec.worktree_path)
            val next_agents = base_d.agents + [restored]
            base_d = _dash(base_d, base_d.manager_status, next_agents, next_agents.len() - 1,
                _logged(base_d, "relaunch " + rec.agent_id))
        return (_attach(base_d, rec.agent_id, pane), "relaunched " + rec.agent_id +
            " in pane " + pane.pane_id + " inside container " + rec.name +
            (if rec.worktree_path != "": " worktree " + rec.worktree_path else: ""))
    if head == "session:close":
        val target_id = if words.len() > 1: words[1] else: ""
        var pane_id = if words.len() > 2: words[2] else: ""
        val live_before_close = _live_pane_ids_for(d.session)
        var closing_live = false
        for rec in cs_container_reconcile_v1(d.session, live_before_close):
            if rec.agent_id == target_id or rec.name == target_id:
                closing_live = rec.state == "running"
                pane_id = if closing_live: rec.pane_id else: ""
        if pane_id != "":
            val killed = pane_kill(d.session, pane_id)
            if not killed and _live_pane_ids_for(d.session).contains(pane_id):
                return (cs_refresh(d), "could not close pane " + pane_id)
        val (cleaned, note) = cs_container_close_record_v1(d.session, target_id,
            live_before_close, closing_live)
        if not cleaned:
            return (cs_refresh(d), note)
        if cs_container_launched(d.session, target_id):
            val _reap = cs_container_reap(d.session, target_id)
        val _spool = file_remove(cs_stderr_path(d.session, target_id))
        val detached = if _resolve(d, target_id) >= 0: _detach(d, target_id) else: d
        return (cs_refresh(detached), if note != "": note else: "closed " + target_id)
    if head.starts_with("orchestrator:"):
        val orch_line = action.substring(13, action.byte_len())
        val orch_words = cs_shell_words(orch_line)
        val outcome = cs_orchestrator_dispatch_v1(d.session, orch_words)
        return (cs_refresh(d), outcome)
    if head == "pane:kill":
        val killed = pane_kill(d.session, words[2])
        # Closing the pane only ends the engine CLIENT; the container outlives
        # it. Reap whether or not the pane kill succeeded — but only a
        # container this process launched, verified by its instance label.
        var container_note = ""
        val (lc_cleaned, lc_note) = cs_container_close_record_v1(d.session, words[1],
            _live_pane_ids_for(d.session), false)
        if lc_note != "":
            container_note = "; " + lc_note
        elif cs_container_launched(d.session, words[1]):
            val reap_error = cs_container_reap(d.session, words[1])
            if reap_error != "":
                container_note = "; container " + cs_container_name(d.session, words[1]) +
                    " NOT removed: " + reap_error
            else:
                val _spool = file_remove(cs_stderr_path(d.session, words[1]))
                container_note = ", removed container " + cs_container_name(d.session, words[1])
        elif lc_cleaned:
            val _spool2 = file_remove(cs_stderr_path(d.session, words[1]))
        if killed:
            return (cs_refresh(_detach(d, words[1])), "killed pane " + words[2] + container_note)
        return (d, "pane backend refused to kill " + words[2] + container_note)
    if head == "container:reap-session":
        var reaped_local: [text] = []
        val live_ids = _live_pane_ids_for(d.session)
        for rec in cs_container_reconcile_v1(d.session, live_ids):
            if rec.state == "running" and rec.pane_id != "" and live_ids.contains(rec.pane_id):
                val killed = pane_kill(d.session, rec.pane_id)
                if not killed and _live_pane_ids_for(d.session).contains(rec.pane_id):
                    continue
            val (removed, _msg) = cs_container_close_record_v1(d.session, rec.agent_id, [], true)
            if removed:
                reaped_local.push(rec.name)
        if sosix_host_os() == "macos" and _which("podman") == "":
            if reaped_local.len() == 0:
                return (cs_refresh(d), "no containers owned by session " + d.session)
            return (cs_refresh(d), "removed containers: " + reaped_local.join(" "))
        match cs_container_reap_session(d.session):
            case Ok(names):
                val all_names = reaped_local + names
                if all_names.len() == 0: return (cs_refresh(d), "no containers owned by session " + d.session)
                return (cs_refresh(d), "removed containers: " + all_names.join(" "))
            case Err(reason):
                if reaped_local.len() > 0:
                    return (cs_refresh(d), "removed local containers: " + reaped_local.join(" ") + "; podman: " + reason)
                return (d, "containers NOT removed: " + reason)
    if head.starts_with("launch:"):
        val launch_tokens = cs_shell_words(action)
        val agent_id = launch_tokens[0].split(":")[1]
        val spec_text = if launch_tokens.len() > 1: launch_tokens[1] else: ""
        var raw_extras: [text] = []
        var xi = 2
        while xi < launch_tokens.len():
            raw_extras = raw_extras + [launch_tokens[xi]]
            xi = xi + 1
        val (wants_worktree, extras) = cs_worktree_extract_flag_v1(raw_extras)
        var container = cs_container_request(extras)
        if container.error != "":
            return (d, "cannot launch " + agent_id + ": " + container.error)
        val parsed_spec = parse_harness_spec(spec_text)
        if not parsed_spec.valid:
            return (d, "cannot launch " + spec_text + ": invalid spec")
        val cleaned_rest = cs_strip_workspace_for_cli_harness_v1(parsed_spec.harness, container.rest)
        val argv = cs_launch_argv_with_extras(spec_text, cleaned_rest)
        if argv.len() == 0:
            return (d, "cannot launch " + spec_text + ": invalid spec")
        var args: [text] = []
        var i = 1
        while i < argv.len():
            args = args + [argv[i]]
            i = i + 1
        val exe = cs_resolve_exe(argv[0])
        if exe == "":
            return (d, "cannot launch " + agent_id + ": '" + argv[0] +
                "' is not on PATH and no repo binary was found")
        var worktree_path = ""
        var worktree_owned = false
        if wants_worktree:
            val repo_root = macos_seatbelt_canonical_path_v1(cs_repo_root())
            match cs_worktree_create_v1(repo_root, d.session, agent_id):
                case Ok(wt):
                    worktree_path = wt
                    worktree_owned = true
                    if container.workspace == "":
                        container = CsContainerRequest(image: container.image, network: container.network,
                            mounts: container.mounts, workspace: wt, rest: container.rest,
                            error: "", env: container.env)
                        if parsed_spec.harness == "caret":
                            args = args + ["--workspace", wt]
                case Err(reason):
                    return (d, "cannot launch " + agent_id + ": " + reason)
        elif container.workspace != "":
            worktree_path = macos_seatbelt_canonical_path_v1(container.workspace)
        var spec_shown = spec_text
        for tok in raw_extras:
            spec_shown = spec_shown + " " + cs_quote_word_if_needed(tok)
        if container.image != "":
            return _cs_launch_in_container(d, agent_id, spec_shown, exe, args,
                worktree_path, worktree_owned, container)
        if worktree_owned:
            return _cs_launch_owned_worktree(d, agent_id, spec_shown, exe, args,
                macos_seatbelt_canonical_path_v1(cs_repo_root()), worktree_path)
        if worktree_path != "":
            val cd_cmd = "cd " + cs_quote_word_if_needed(worktree_path) + " && exec " + exe
            var sh_line = "cd '" + worktree_path.replace("'", "'\\''") + "' && exec '" + exe.replace("'", "'\\''") + "'"
            for a in args:
                sh_line = sh_line + " '" + a.replace("'", "'\\''") + "'"
            val _unused = cd_cmd
            val pane_wt = pane_spawn_at(d.session, agent_id, "/bin/sh", ["-c", sh_line],
                _cs_pane_cols, _cs_pane_rows, cs_stderr_path(d.session, agent_id))
            if pane_wt.pane_id == "":
                if worktree_owned:
                    val _rm = cs_worktree_remove_owned_v1(macos_seatbelt_canonical_path_v1(cs_repo_root()), worktree_path)
                return (d, "pane backend could not spawn a pane for " + agent_id)
            return (_attach(d, agent_id, pane_wt), "launched " + agent_id + " in pane " +
                pane_wt.pane_id + " worktree " + worktree_path)
        val pane = pane_spawn_at(d.session, agent_id, exe, args, _cs_pane_cols,
            _cs_pane_rows, cs_stderr_path(d.session, agent_id))
        if pane.pane_id == "":
            return (d, "pane backend could not spawn a pane for " + agent_id)
        return (_attach(d, agent_id, pane), "launched " + agent_id + " in pane " +
            pane.pane_id)
    if head.starts_with("chat:"):
        # "chat:<agent_id> <body>" - the body may contain spaces, so split off
        # the id only, never the remainder.
        val rest = action.substring(5, action.byte_len())
        val sp = rest.index_of(" ")
        if sp <= 0:
            return (d, "malformed chat action")
        val chat_id = rest.substring(0, sp)
        val body = rest.substring(sp + 1, rest.byte_len()).trim()
        if body == "":
            return (d, "empty message not sent")
        var chat_pane = ""
        for a in d.agents:
            if a.agent_id == chat_id:
                chat_pane = a.pane_id
        if chat_pane == "":
            return (d, "cannot deliver message: " + chat_id + " has no pane yet")
        if not pane_send(d.session, chat_pane, body):
            return (d, "pane backend refused the message for " + chat_id)
        return (d, "sent to " + chat_id + " (pane " + chat_pane + ")")
    (d, action)

export CsAgent, CsDashboard
export cs_dashboard_new, cs_refresh, cs_render, cs_handle_command, cs_help_text
export cs_shell_words, cs_quote_word_if_needed
export cs_frame_rows, cs_fit, cs_fit_sgr, cs_agent_area, cs_stderr_path, cs_poll_screens
export cs_resize_agents, cs_reap_containers
export cs_launch_argv, cs_launch_argv_with_extras, cs_apply_action, cs_resolve_exe, windows_executable_names
