# LLM Caret - Infrastructure: object/file storage tools (ls/get/put)
#
# Server-facing code for the `storage_ls`, `storage_get` and `storage_put`
# tools. Only reachable through tools.spl::run_tool (the permission gate).
#
# Backends (selected by `[storage] backend`, never by platform branching):
#   minio - pure-Simple SigV4 REST adapter, app.devhub.adapter_minio (the same
#           code path `bin/itf minio ls/get/put` runs on). No `mc` binary.
#   ftp   - REFUSED with an honest error. The only in-tree FTP client facade,
#           std.nogc_sync_mut.io.ftp_sffi (ftp_connect/ftp_list/ftp_download/
#           ftp_upload), sits on rt_ftp_* externs that are UNBACKED on this
#           build (scripts/check/unbacked_extern_baseline.txt:509); calling
#           ftp_connect aborts the interpreter with "unknown extern function:
#           rt_ftp_connect" instead of returning an invalid handle, which a
#           tool arm must never do. Wire it here once the runtime backs it.
#
# Config: `[storage]` in llm_caret.sdn (config.spl):
#   backend, endpoint, bucket, access_key_env, secret_key_env, tls
# Keys are ONLY read from the env vars named by *_env. `tls` chooses the URL
# scheme when `endpoint` has none; it is never mapped to the adapter's
# tls_skip_verify (that flag is a hard config error there).
#
# Exec order: validate arguments -> config present -> keys present -> network.

use app.llm_caret.config.{
    config_storage_backend, config_storage_endpoint, config_storage_bucket,
    config_storage_access_key_env, config_storage_secret_key_env,
    config_storage_access_key, config_storage_secret_key, config_storage_tls
}
use app.devhub.adapter_minio.{
    MinioConfig, ObjectInfo, GetObjectResult,
    minio_list_objects, minio_get_object, minio_put_text
}

val STORAGE_NOT_CONFIGURED = "storage not configured: set [storage] in llm_caret.sdn"
val STORAGE_GET_MAX_BYTES = 262144
val STORAGE_PUT_MAX_BYTES = 4194304
val STORAGE_LS_MAX = 500
val STORAGE_FTP_UNBACKED = "storage backend 'ftp' is not available: the FTP facade (src/lib/nogc_sync_mut/io/ftp_sffi.spl:17, rt_ftp_connect) is an unbacked runtime extern on this build; use backend: minio"

# ============================================================================
# JSON schema entries (Anthropic `input_schema` shape)
# ============================================================================

fn _LB() -> text:
    (123 as char).to_text()

fn _RB() -> text:
    (125 as char).to_text()

fn _prop(name: text, kind: text, desc: text) -> text:
    "\"" + name + "\": " + _LB() + "\"type\": \"" + kind + "\", \"description\": \"" + desc + "\"" + _RB()

fn _schema(name: text, desc: text, props: [text], required: [text]) -> text:
    var req: [text] = []
    for r in required:
        req.push("\"" + r + "\"")
    _LB() + "\"name\": \"" + name + "\", \"description\": \"" + desc + "\", \"input_schema\": " +
        _LB() + "\"type\": \"object\", \"properties\": " + _LB() + props.join(", ") + _RB() +
        ", \"required\": [" + req.join(", ") + "]" + _RB() + _RB()

fn storage_tool_schemas() -> [text]:
    [
        _schema("storage_ls", "List objects on the configured file server (read-only). One line per object: key, size, last-modified.",
            [_prop("bucket", "string", "Bucket (minio) or top-level directory (ftp); default from config"),
             _prop("prefix", "string", "Key prefix / sub-path filter (optional)")],
            []),
        _schema("storage_get", "Fetch one object as text (read-only). Capped at " + STORAGE_GET_MAX_BYTES.to_text() + " bytes.",
            [_prop("key", "string", "Object key / remote file path"),
             _prop("bucket", "string", "Bucket or directory; default from config"),
             _prop("max_bytes", "integer", "Optional lower cap on returned bytes")],
            ["key"]),
        _schema("storage_put", "Upload text content as an object. MUTATING: requires explicit permission.",
            [_prop("key", "string", "Object key / remote file path"),
             _prop("content", "string", "Text content to store"),
             _prop("bucket", "string", "Bucket or directory; default from config")],
            ["key", "content"])
    ]

# ============================================================================
# Config resolution (pure; no network)
# ============================================================================

fn storage_get_max_bytes() -> i64:
    STORAGE_GET_MAX_BYTES

fn storage_put_max_bytes() -> i64:
    STORAGE_PUT_MAX_BYTES

fn storage_configured() -> bool:
    config_storage_backend() != "" and config_storage_endpoint() != ""

# "" when usable, else an honest error. Never echoes a key value.
fn storage_config_error() -> text:
    if not storage_configured():
        return STORAGE_NOT_CONFIGURED
    val backend = config_storage_backend()
    if backend == "ftp":
        return STORAGE_FTP_UNBACKED
    if backend != "minio":
        return "storage backend '" + backend + "' is not supported (expected minio | ftp)"
    val ak_env = config_storage_access_key_env()
    val sk_env = config_storage_secret_key_env()
    if ak_env == "" or sk_env == "":
        return "storage keys not configured: set [storage] access_key_env and secret_key_env in llm_caret.sdn"
    if config_storage_access_key() == "":
        return "storage access key not set: environment variable '" + ak_env + "' is empty"
    if config_storage_secret_key() == "":
        return "storage secret key not set: environment variable '" + sk_env + "' is empty"
    ""

fn _resolve_bucket(bucket_in: text) -> text:
    if bucket_in != "":
        return bucket_in
    config_storage_bucket()

fn _minio_url() -> text:
    val ep = config_storage_endpoint()
    if ep.starts_with("http://") or ep.starts_with("https://"):
        return ep
    if config_storage_tls():
        return "https://" + ep
    "http://" + ep

fn _minio_cfg() -> MinioConfig:
    MinioConfig(
        url: _minio_url(),
        region: "us-east-1",
        access_key: config_storage_access_key(),
        secret_key: config_storage_secret_key(),
        tls_skip_verify: false
    )

fn _validate_key(tool: text, key: text) -> text:
    if key == "":
        return tool + ": missing required 'key'"
    if key.starts_with("/"):
        return tool + ": 'key' must be relative (no leading '/'): " + key
    for part in key.split("/"):
        if part == "..":
            return tool + ": 'key' must not contain '..': " + key
    ""

# ============================================================================
# Public tool operations: (success, content)
# ============================================================================

fn storage_ls(bucket_in: text, prefix: text) -> (bool, text):
    val cerr = storage_config_error()
    if cerr != "":
        return (false, cerr)
    val bucket = _resolve_bucket(bucket_in)
    if bucket == "":
        return (false, "storage_ls: no bucket given and [storage] bucket is empty")
    if config_storage_backend() == "minio":
        val (ok, objs, err) = minio_list_objects(_minio_cfg(), bucket, prefix)
        if not ok:
            return (false, "storage_ls: " + err)
        if objs.len() == 0:
            return (true, "(no objects under " + bucket + "/" + prefix + ")")
        var rows: [text] = []
        var n = 0
        for o in objs:
            if n >= STORAGE_LS_MAX:
                rows.push("... [" + (objs.len() - n).to_text() + " more]")
                break
            rows.push(o.key + "\t" + o.size.to_text() + "\t" + o.last_modified)
            n = n + 1
        return (true, rows.join("\n"))
    (false, STORAGE_FTP_UNBACKED)

fn storage_get(bucket_in: text, key: text, max_bytes_in: i64) -> (bool, text):
    val verr = _validate_key("storage_get", key)
    if verr != "":
        return (false, verr)
    var cap = STORAGE_GET_MAX_BYTES
    if max_bytes_in > 0:
        if max_bytes_in > STORAGE_GET_MAX_BYTES:
            return (false, "storage_get: max_bytes " + max_bytes_in.to_text() + " exceeds the tool cap of " + STORAGE_GET_MAX_BYTES.to_text() + " bytes")
        cap = max_bytes_in
    val cerr = storage_config_error()
    if cerr != "":
        return (false, cerr)
    val bucket = _resolve_bucket(bucket_in)
    if bucket == "":
        return (false, "storage_get: no bucket given and [storage] bucket is empty")
    if config_storage_backend() != "minio":
        return (false, STORAGE_FTP_UNBACKED)
    # Range-cap at the wire so a huge object never lands in memory.
    val (ok, res, err) = minio_get_object(_minio_cfg(), bucket, key, "bytes=0-" + (cap - 1).to_text())
    if not ok:
        return (false, "storage_get: " + err)
    var body = res.body
    if body.len() > cap:
        body = body.substring(0, cap) + "\n... [truncated at " + cap.to_text() + " bytes]"
    (true, body)

fn storage_put(bucket_in: text, key: text, content: text) -> (bool, text):
    val verr = _validate_key("storage_put", key)
    if verr != "":
        return (false, verr)
    if content.len() > STORAGE_PUT_MAX_BYTES:
        return (false, "storage_put: content is " + content.len().to_text() + " bytes, over the tool cap of " + STORAGE_PUT_MAX_BYTES.to_text())
    val cerr = storage_config_error()
    if cerr != "":
        return (false, cerr)
    val bucket = _resolve_bucket(bucket_in)
    if bucket == "":
        return (false, "storage_put: no bucket given and [storage] bucket is empty")
    if config_storage_backend() != "minio":
        return (false, STORAGE_FTP_UNBACKED)
    val (ok, etag, err) = minio_put_text(_minio_cfg(), bucket, key, content, "text/plain")
    if not ok:
        return (false, "storage_put: " + err)
    (true, "stored " + content.len().to_text() + " bytes at " + bucket + "/" + key + " (etag " + etag + ")")
