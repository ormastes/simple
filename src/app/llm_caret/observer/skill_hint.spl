# Caret observer -- first-use skill hints that decay (CU-020), pure.
#
# A hint is shown for the first SKILL_HINT_DECAY_USES provider-reported uses of
# a skill in a session, then stops.

val SKILL_HINT_DECAY_USES: i64 = 3

fn skill_hint_visible(uses: i64) -> bool:
    uses >= 1 and uses <= SKILL_HINT_DECAY_USES

fn skill_hint_text(skill: text) -> text:
    "hint: " + skill + " loaded by provider (shown for first " + SKILL_HINT_DECAY_USES.to_text() + " uses)"

export SKILL_HINT_DECAY_USES, skill_hint_visible, skill_hint_text
