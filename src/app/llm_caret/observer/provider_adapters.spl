# Caret observer -- provider adapters for installed Codex / Claude, pure.
#
# Each adapter maps ONLY signals that already exist in the repo
# (messaging/adapter/agent/hook_bridge.spl hook and notification names) into
# observer events. A provider signal that carries no structured evidence for
# an observer fact yields an empty list, so the fact stays Unknown. Nothing
# here reads screen text.
#
# Not mapped, deliberately:
#   - Claude stream-json `rate_limit_event`: claude_cli.spl only accepts the
#     type; no reset time is parsed, so the reset is not known.
#   - Claude has no structured question hook in the repo.
#   - Codex `turn/failed` / `turn/blocked`: a failed turn is not owner-detected
#     process/child exit nor a confirmed tool timeout.

use app.llm_caret.observer.observation_builder.*
use app.llm_caret.json_helpers.{extract_json_string}

# Neither provider emits a dedicated heartbeat hook. A completed Claude tool
# call (success or failure) is the only structured proof the job advanced, so
# it doubles as the job heartbeat.
fn _heartbeat(session: text, generation: i64, op: text, seq: i64, at_ms: i64) -> ObserverEvent:
    observer_event(session, generation, op, seq, at_ms, ObserverEventKind.JobHeartbeat, "Claude tool call completed")

fn claude_hook_events(session: text, generation: i64, op: text, seq: i64, at_ms: i64, hook_name: text) -> [ObserverEvent]:
    match hook_name:
        "PermissionRequest": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.StructuredApproval, "Claude permission request")]
        "PreToolUse": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.ToolStart, "Claude tool start")]
        "PostToolUse": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.ToolEnd, "Claude tool end"), _heartbeat(session, generation, op, seq, at_ms)]
        "PostToolUseFailure": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.ToolEnd, "Claude tool failed"), _heartbeat(session, generation, op, seq, at_ms)]
        "SubagentStart": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.ChildStarted, "Claude subagent start")]
        "SubagentStop": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.ChildFinished, "Claude subagent stop")]
        _: []

# Codex `turn/waiting_input` is mapped to an approval, as hook_bridge.spl does
# (progress_kind "approval"); the notification does not distinguish a question.
fn codex_notification_events(session: text, generation: i64, op: text, seq: i64, at_ms: i64, event_name: text) -> [ObserverEvent]:
    match event_name:
        "turn/waiting_input": [observer_event(session, generation, op, seq, at_ms, ObserverEventKind.StructuredApproval, "Codex waiting for input")]
        _: []

# Claude loads a skill through its `Skill` tool, so the PreToolUse payload
# (tool_name "Skill", tool_input.skill) is the structured loaded-skill signal.
# SessionStart carries none. Returns "" when the hook is not a Skill call.
fn claude_loaded_skill(hook_name: text, payload: text) -> text:
    if hook_name != "PreToolUse":
        return ""
    if extract_json_string(payload, "tool_name") != "Skill":
        return ""
    extract_json_string(payload, "skill")

# Codex has no Skill tool: a skill is loaded when the agent reads its
# `skills/<name>/SKILL.md` through a shell tool, which the PreToolUse payload
# carries as tool_input.command. Returns "" when the command reads no SKILL.md.
fn codex_loaded_skill(hook_name: text, payload: text) -> text:
    if hook_name != "PreToolUse":
        return ""
    val command = extract_json_string(payload, "command")
    val tail = "/SKILL.md"
    val end = command.index_of(tail) ?? -1
    if end < 0:
        return ""
    val head = command.substring(0, end)
    val slash = head.last_index_of("/")
    if slash < 0:
        return ""
    head.substring(slash + 1, head.len())

# Codex `$name` skill invocations in a UserPromptSubmit prompt are the skills
# the user requested; compared against codex_loaded_skill for the diff.
fn codex_requested_skills(hook_name: text, payload: text) -> [text]:
    var out: [text] = []
    if hook_name != "UserPromptSubmit":
        return out
    for word in extract_json_string(payload, "prompt").split(" "):
        if word.starts_with("$") and word.len() > 1:
            val name = word.substring(1, word.len())
            if not out.contains(name):
                out = out + [name]
    out

fn provider_events(provider: text, session: text, generation: i64, op: text, seq: i64, at_ms: i64, event_name: text) -> [ObserverEvent]:
    if provider == "claude":
        return claude_hook_events(session, generation, op, seq, at_ms, event_name)
    if provider == "codex":
        return codex_notification_events(session, generation, op, seq, at_ms, event_name)
    []

export claude_hook_events, claude_loaded_skill, codex_loaded_skill, codex_requested_skills, codex_notification_events, provider_events
