# Caret observer -- session-row status text (design section 7.1), pure.
#
# "<label> -- <reason> (<confidence>)", e.g.
# "quiet -- job heartbeat advancing while output is silent (observed)".

use app.llm_caret.observer.state_axes.*
use app.llm_caret.observer.stall_classifier.*

fn class_label(k: ClassKind) -> text:
    match k:
        case ClassKind.StateUnknown: "state unknown"
        case ClassKind.Failure: "failed"
        case ClassKind.NeedsUser: "needs you"
        case ClassKind.QuotaWait: "quota wait"
        case ClassKind.WaitingChildren: "waiting on children"
        case ClassKind.WorkingQuiet: "quiet"
        case ClassKind.SuspectedStall: "suspected stall"
        case ClassKind.QuietObserve: "quiet, observing"
        case ClassKind.Working: "working"
        case ClassKind.Unknown: "unknown"

fn confidence_label(c: EvidenceConfidence) -> text:
    match c:
        case EvidenceConfidence.StructuredOwner: "structured"
        case EvidenceConfidence.ObservedProcess: "observed"
        case EvidenceConfidence.Heuristic: "heuristic"
        case EvidenceConfidence.Unknown: "unknown"

fn classification_status_text(c: Classification) -> text:
    class_label(c.kind) + " -- " + c.reason + " (" + confidence_label(c.confidence) + ")"

export class_label, confidence_label, classification_status_text
