# Caret observer -- state axes (design section 7.1), pure types only.
#
# ProcessLifecycle, Transport and AgentTurn already exist in
# app.llm_caret.workbench.session_contract and are reused from there, not
# redefined. Only the axes absent from that module live here.
#
# Variants with no producer are deliberately omitted: there is no
# ConfirmedStall (silence alone never confirms a stall) and no Pressured
# resource condition until a pressure source exists.

enum TaskProgress:
    # Output/heartbeat is not advancing, but that is not evidence of a hang.
    Quiet
    SuspectedStall
    Unknown

enum Attention:
    None
    Question
    Approval
    Error
    DoneUnread

enum ResourceCondition:
    QuotaWait
    Unknown

# How the evidence behind a classification was obtained.
enum EvidenceConfidence:
    StructuredOwner
    ObservedProcess
    Heuristic
    Unknown

export TaskProgress, Attention, ResourceCondition, EvidenceConfidence
