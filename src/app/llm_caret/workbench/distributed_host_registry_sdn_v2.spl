# Parse once when the authenticated config owner publishes a new snapshot.
# Configuration decoding does not authorize enrollment or resolve secrets.
use std.common.sdn.parser.{parse_untrusted, parse_with_issues}
use std.common.sdn.value.{SdnValue}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use app.llm_caret.workbench.distributed_host_roles_v2.*

fn host_registry_dict_v2(value: SdnValue, keys: [text]) -> Result<Dict<text, SdnValue>, text>:
    match value:
        case SdnValue.Dict(fields):
            if fields.len() != keys.len():
                return Err("HOST_CONFIG_FIELDS")
            for key in keys:
                if not fields.contains_key(key):
                    return Err("HOST_CONFIG_FIELDS")
            Ok(fields)
        case _: Err("HOST_CONFIG_TYPE")

fn host_registry_text_v2(value: SdnValue) -> Result<text, text>:
    match value:
        case SdnValue.String(string): Ok(string)
        case _: Err("HOST_CONFIG_TYPE")

fn host_registry_revision_v2(value: SdnValue) -> Result<i64, text>:
    match value:
        case SdnValue.Int(revision):
            if revision <= 0: return Err("HOST_CONFIG_REVISION")
            Ok(revision)
        case _: Err("HOST_CONFIG_TYPE")

fn host_registry_role_v2(value: SdnValue) -> Result<DistributedCredentialRoleV2, text>:
    val fields = host_registry_dict_v2(value, ["identity", "credential_reference", "revision", "revoked"])?
    val identity = host_registry_text_v2(fields["identity"])?
    val reference = host_registry_text_v2(fields["credential_reference"])?
    val revision = host_registry_revision_v2(fields["revision"])?
    var revoked = false
    match fields["revoked"]:
        case SdnValue.Bool(value): revoked = value
        case _: return Err("HOST_CONFIG_TYPE")
    val role = DistributedCredentialRoleV2(identity: identity,
        credential_reference: reference, revision: revision, revoked: revoked)
    val error = distributed_role_validate_v2(role)
    # Preserve revocation in stored snapshots; resolution rejects its use.
    if error != "" and error != "ROLE_REVOKED":
        return Err(error)
    Ok(role)

fn distributed_host_registry_decode_v2(source: text) -> Result<[DistributedHostRolesV2], text>:
    if source.len() > 65536:
        return Err("HOST_CONFIG_SIZE")
    # The shared untrusted parser enforces depth/entry bounds before parsing.
    # Its normal duplicate handling is last-wins, so require issue-free input
    # too. This bounded second parse runs only at configuration publication.
    val value = parse_untrusted(source)?
    val checked = parse_with_issues(source)?
    if checked.1.len() != 0:
        return Err("HOST_CONFIG_DUPLICATE_KEY")
    val fields = host_registry_dict_v2(value, ["schema", "revision", "hosts"])?
    val schema = host_registry_text_v2(fields["schema"])?
    if schema != "distributed-host-registry-v2":
        return Err("HOST_CONFIG_SCHEMA")
    val revision = host_registry_revision_v2(fields["revision"])?
    var hosts: [SdnValue] = []
    match fields["hosts"]:
        case SdnValue.Array(values): hosts = values
        case _: return Err("HOST_CONFIG_TYPE")
    if hosts.len() > 128:
        return Err("HOST_CONFIG_CAPACITY")
    var decoded: [DistributedHostRolesV2] = []
    var seen: [text] = []
    for value in hosts:
        val row = host_registry_dict_v2(value, ["host_id", "host_key_digest",
            "ssh_account", "provider_profile", "node_identity", "signer_identity"])?
        val host_id = host_registry_text_v2(row["host_id"])?
        val key = host_registry_text_v2(row["host_key_digest"])?
        if not builder_identifier_valid_v1(host_id) or not builder_digest_valid_v1(key):
            return Err("HOST_REGISTRY_INVALID")
        if seen.contains(host_id):
            return Err("HOST_REGISTRY_DUPLICATE")
        seen.push(host_id)
        val ssh = host_registry_role_v2(row["ssh_account"])?
        val provider = host_registry_role_v2(row["provider_profile"])?
        val node = host_registry_role_v2(row["node_identity"])?
        val signer = host_registry_role_v2(row["signer_identity"])?
        decoded.push(DistributedHostRolesV2(host_id: host_id, host_key_digest: key,
            registry_revision: revision, ssh_account: ssh, provider_profile: provider,
            node_identity: node, signer_identity: signer))
    Ok(decoded)
