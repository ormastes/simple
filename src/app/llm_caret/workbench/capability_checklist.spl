# Caret workbench capability checklist (REQ-CARET-UI-020, CU-020).
#
# Every row is met / partial / blocked, derived from CapabilityProbes facts
# gathered by `capability_probes_live`. Rows with no implementation (remote /
# fleet) are blocked with a reason; nothing is hard-coded "met".

use app.llm_caret.workbench.session_source.{live_pane_bindings}
use app.llm_caret.observer.observer_log.{observer_events, observer_all_loaded_skills, observer_all_requested_skills}
use std.editor.extensions.host.{ExtensionHost}
use std.editor.extensions.builtin.caret_workbench_ext.{caret_workbench_ext_load}
use std.nogc_sync_mut.io.dir_ops.{dir_list}

enum CapabilityStatus:
    Met
    Partial
    Blocked

struct CapabilityRow:
    id: text
    title: text
    status: CapabilityStatus
    reason: text

struct CapabilityProbes:
    live_panes: i64
    observer_events: i64
    ext_manifest_ok: bool
    ext_views: i64
    ext_leftover: i64
    trace_view_declared: bool
    skill_count: i64
    loaded_skills: [text]
    requested_skills: [text]

fn _row(id: text, title: text, status: CapabilityStatus, reason: text) -> CapabilityRow:
    CapabilityRow(id: id, title: title, status: status, reason: reason)

fn capability_rows(p: CapabilityProbes) -> [CapabilityRow]:
    var rows: [CapabilityRow] = []
    if p.live_panes > 0:
        rows.push(_row("local_session", "Local session", CapabilityStatus.Met, p.live_panes.to_text() + " live pane binding(s)"))
        rows.push(_row("terminal_passthrough", "Terminal passthrough", CapabilityStatus.Partial, "pane bound; live keystroke passthrough not probed"))
    else:
        rows.push(_row("local_session", "Local session", CapabilityStatus.Partial, "no live pane bound"))
        rows.push(_row("terminal_passthrough", "Terminal passthrough", CapabilityStatus.Blocked, "no bound pane to pass input to"))
    if p.observer_events > 0:
        rows.push(_row("observer", "Observer status", CapabilityStatus.Met, p.observer_events.to_text() + " event(s) recorded"))
    else:
        rows.push(_row("observer", "Observer status", CapabilityStatus.Partial, "no hook events recorded yet"))
    if not p.ext_manifest_ok:
        rows.push(_row("extensions_views", "Extensions / views", CapabilityStatus.Blocked, "caret.workbench manifest failed to decode"))
    elif p.ext_views > 0 and p.ext_leftover == 0:
        rows.push(_row("extensions_views", "Extensions / views", CapabilityStatus.Met, p.ext_views.to_text() + " view(s) declared, no leftover registrations"))
    else:
        rows.push(_row("extensions_views", "Extensions / views", CapabilityStatus.Partial, p.ext_views.to_text() + " view(s), " + p.ext_leftover.to_text() + " leftover registration(s)"))
    if p.trace_view_declared:
        rows.push(_row("trace_views", "Trace views", CapabilityStatus.Partial, "view contributed; trace index not probed"))
    else:
        rows.push(_row("trace_views", "Trace views", CapabilityStatus.Blocked, "no trace view declared"))
    if p.loaded_skills.len() > 0:
        var missing: [text] = []
        for s in p.requested_skills:
            if not p.loaded_skills.contains(s):
                missing = missing + [s]
        var diff = ""
        if p.requested_skills.len() > 0:
            diff = if missing.len() == 0: "; all requested skills loaded" else: "; requested but not loaded: " + missing.join(", ")
        rows.push(_row("skills", "Skills checklist", CapabilityStatus.Met, p.skill_count.to_text() + " skill(s) installed; loaded: " + p.loaded_skills.join(", ") + diff))
    elif p.skill_count > 0:
        rows.push(_row("skills", "Skills checklist", CapabilityStatus.Partial, p.skill_count.to_text() + " skill(s) installed; no provider has reported a loaded skill"))
    else:
        rows.push(_row("skills", "Skills checklist", CapabilityStatus.Blocked, "no skill registry found"))
    rows.push(_row("remote_fleet", "Remote / fleet", CapabilityStatus.Blocked, "no remote transport or handshake implemented"))
    rows

fn capability_row_for(p: CapabilityProbes, id: text) -> CapabilityRow:
    for r in capability_rows(p):
        if r.id == id:
            return r
    _row(id, id, CapabilityStatus.Blocked, "unknown capability")

fn _status_word(s: CapabilityStatus) -> text:
    match s:
        case CapabilityStatus.Met: "met"
        case CapabilityStatus.Partial: "partial"
        case CapabilityStatus.Blocked: "blocked"

fn capability_lines(rows: [CapabilityRow]) -> [text]:
    var lines: [text] = []
    for r in rows:
        lines.push("[" + _status_word(r.status) + "] " + r.title + " - " + r.reason)
    lines

fn capability_probes_live() -> CapabilityProbes:
    val load = caret_workbench_ext_load()
    var trace = false
    for v in load.manifest.contributes_views:
        if v.id == "trace.explorer":
            trace = true
    val host = ExtensionHost.new()
    CapabilityProbes(
        live_panes: live_pane_bindings().len(),
        observer_events: observer_events().len(),
        ext_manifest_ok: load.ok,
        ext_views: load.manifest.contributes_views.len(),
        ext_leftover: host.extension_leftover_count("caret.workbench"),
        trace_view_declared: trace,
        skill_count: dir_list(".claude/skills").len(),
        loaded_skills: observer_all_loaded_skills(),
        requested_skills: observer_all_requested_skills())

export CapabilityStatus, CapabilityRow, CapabilityProbes
export capability_rows, capability_row_for, capability_lines, capability_probes_live
