# Caret GUI workbench -- accessible role/name metadata (CU-017).
#
# Pure data: one A11yNode per workbench widget. gui_page renders the same
# role/name through `a11y_attrs`, so the node list and the markup cannot drift.

use app.llm_caret.workbench.session_contract.{SessionView}
use app.llm_caret.observer.session_status.{session_status_text}
use app.llm_caret.workbench.gui_layout.{WorkbenchMode}

struct A11yNode:
    id: text
    role: text
    name: text

fn _attr_escape(value: text) -> text:
    var out = value.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("'", "&#39;")
    out

# Markup fragment carrying one node's role and accessible name.
pub fn a11y_attrs(role: text, name: text) -> text:
    " role='{role}' aria-label='{_attr_escape(name)}'"

# Accessible name for one roster row: who it is and what it is doing.
pub fn roster_option_name(view: SessionView) -> text:
    "{view.label}, {view.provider}, {session_status_text(view)}"

pub fn workbench_a11y_nodes(sessions: [SessionView], mode: WorkbenchMode) -> [A11yNode]:
    var nodes: [A11yNode] = []
    var controls_name = "Agent control column"
    match mode:
        case WorkbenchMode.Compact: controls_name = "Compact controls (roster, details, composer)"
        case _: controls_name = "Agent control column"
    nodes.push(A11yNode(id: "controls", role: "complementary", name: controls_name))
    if sessions.len() > 0:
        nodes.push(A11yNode(id: "roster", role: "listbox", name: "Agents"))
        for view in sessions:
            nodes.push(A11yNode(id: "agent:{view.id.value}", role: "option", name: roster_option_name(view)))
    nodes.push(A11yNode(id: "details", role: "group", name: "Selected agent details"))
    nodes.push(A11yNode(id: "composer", role: "form", name: "Message composer"))
    nodes.push(A11yNode(id: "session", role: "region", name: "Selected agent session"))
    nodes.push(A11yNode(id: "previews", role: "region", name: "Other sessions"))
    nodes.push(A11yNode(id: "status", role: "status", name: "Connection status"))
    nodes

# Nodes a screen reader could not announce: empty role or empty name.
pub fn a11y_unnamed_nodes(nodes: [A11yNode]) -> [A11yNode]:
    var bad: [A11yNode] = []
    for n in nodes:
        if n.role == "" or n.name == "":
            bad.push(n)
    bad
