# HostAuthority-private verification. Keys/policy arrive from its protected
# publisher, never from a client frame. This module reads no private keys.
# Cold reference path: dynamic message buffers are not an admitted
# no-allocation capsule command path. Activation requires bounded ownership.
use std.common.contracts.distributed_control_v2.*
use std.common.contracts.distributed_authority_v2.*
use std.common.contracts.distributed_authority_codec_v2.{distributed_grant_issuer_metadata_validate_v2, distributed_approval_metadata_validate_v2}
use std.common.contracts.distributed_control_codec_v2.*
use std.common.build_manager.codec.builder_wire_line_v1
use std.common.build_manager.contracts.builder_identifier_valid_v1
use std.common.crypto.sha256.sha256_text
use std.common.crypto.ed25519.pure_ed25519_verify

struct DistributedAuthorityKeyV2:
    identity: text
    role: text
    revision: i64
    public_key: [u8]
    principal: text
    project: text
    host_id: text
    operations: [text]
    maximum_memory_bytes: i64
    maximum_duration_ms: i64
    policy_revision: i64
    revocation_epoch: i64
    expires_at: i64
    revoked: bool

fn distributed_signature_bytes_v2(message: text) -> [u8]:
    var bytes: [u8] = []
    for i in 0..message.len():
        bytes.push(message.byte_at(i) as u8)
    bytes

fn distributed_grant_signature_message_v2(value: DistributedSignedGrantV2) -> Result<[u8], text>:
    val metadata_error = distributed_grant_issuer_metadata_validate_v2(value)
    if metadata_error != "": return Err(metadata_error)
    val grant = distributed_encode_grant_v2(value.grant)?
    val message = builder_wire_line_v1("DBC_GRANT_SIGNATURE_V2") +
        builder_wire_line_v1(value.issuer_id) + builder_wire_line_v1("{value.key_revision}") +
        builder_wire_line_v1(grant)
    if message.len() > DISTRIBUTED_WIRE_MAX_BYTES_V2: return Err("WIRE_TOO_LARGE")
    Ok(distributed_signature_bytes_v2(message))

fn distributed_approval_signature_message_v2(value: DistributedSignedApprovalV2) -> Result<[u8], text>:
    val metadata_error = distributed_approval_metadata_validate_v2(value)
    if metadata_error != "": return Err(metadata_error)
    var lines: [text] = [builder_wire_line_v1("DBC_APPROVAL_SIGNATURE_V2")]
    for field in [value.approver_id, "{value.key_revision}", value.grant_digest,
            value.request_digest, "{value.policy_revision}", "{value.session_generation}", "{value.expires_at}"]:
        lines.push(builder_wire_line_v1(field))
    Ok(distributed_signature_bytes_v2(lines.join("")))

fn distributed_authority_key_check_v2(key: DistributedAuthorityKeyV2, role: text,
        identity: text, revision: i64, grant: ExecutionGrantV2, now: i64,
        policy_revision: i64, revocation_epoch: i64) -> text:
    if key.role != role or key.identity != identity or not builder_identifier_valid_v1(key.identity) or
            key.revision != revision or key.revision <= 0 or key.public_key.len() != 32:
        return "AUTHORITY_KEY_MISMATCH"
    if key.revoked or key.revocation_epoch != revocation_epoch:
        return "AUTHORITY_KEY_REVOKED"
    if key.policy_revision != policy_revision:
        return "AUTHORITY_POLICY_STALE"
    if now < 0 or key.expires_at <= now or grant.expires_at > key.expires_at:
        return "AUTHORITY_KEY_EXPIRED"
    if key.principal != grant.principal or key.project != grant.project or key.host_id != grant.host_id:
        return "AUTHORITY_SCOPE_DENIED"
    if key.maximum_memory_bytes <= 0 or key.maximum_duration_ms <= 0 or
            grant.maximum_memory_bytes > key.maximum_memory_bytes or grant.maximum_duration_ms > key.maximum_duration_ms:
        return "AUTHORITY_BUDGET_DENIED"
    if key.operations.len() == 0 or key.operations.len() > 64:
        return "AUTHORITY_OPERATIONS_INVALID"
    for operation in key.operations:
        if not builder_identifier_valid_v1(operation): return "AUTHORITY_OPERATIONS_INVALID"
    for operation in grant.operations:
        if not key.operations.contains(operation): return "AUTHORITY_OPERATION_DENIED"
    ""

fn distributed_verify_grant_approval_v2(signed: DistributedSignedGrantV2,
        approval: DistributedSignedApprovalV2, issuer: DistributedAuthorityKeyV2,
        approver: DistributedAuthorityKeyV2, request: OperationEnvelopeV2, now: i64,
        policy_revision: i64, revocation_epoch: i64,
        session_generation: i64) -> Result<ExecutionGrantV2, text>:
    val body_error = distributed_grant_wire_validate_v2(signed.grant)
    if body_error != "": return Err(body_error)
    val scope_error = distributed_grant_authorize_v2(signed.grant, request, now,
        policy_revision, revocation_epoch, session_generation)
    if scope_error != "": return Err(scope_error)
    val issuer_error = distributed_authority_key_check_v2(issuer, "grant-issuer", signed.issuer_id,
        signed.key_revision, signed.grant, now, policy_revision, revocation_epoch)
    if issuer_error != "": return Err(issuer_error)
    val approver_error = distributed_authority_key_check_v2(approver, "human-approver", approval.approver_id,
        approval.key_revision, signed.grant, now, policy_revision, revocation_epoch)
    if approver_error != "": return Err(approver_error)
    if issuer.public_key == approver.public_key:
        return Err("AUTHORITY_ROLES_NOT_SEPARATE")
    val grant_digest = distributed_grant_digest_v2(signed.grant)?
    val request_wire = distributed_encode_operation_v2(request)?
    if approval.grant_digest != grant_digest or approval.request_digest != sha256_text(request_wire):
        return Err("APPROVAL_PAYLOAD_MISMATCH")
    if approval.policy_revision != policy_revision or approval.session_generation != session_generation:
        return Err("APPROVAL_STALE")
    if approval.expires_at <= now or approval.expires_at > signed.grant.expires_at:
        return Err("APPROVAL_EXPIRED")
    if signed.signature.len() != 64 or approval.signature.len() != 64:
        return Err("SIGNATURE_INVALID")
    val grant_message = distributed_grant_signature_message_v2(signed)?
    val approval_message = distributed_approval_signature_message_v2(approval)?
    if not pure_ed25519_verify(issuer.public_key, grant_message, signed.signature):
        return Err("ISSUER_SIGNATURE_INVALID")
    if not pure_ed25519_verify(approver.public_key, approval_message, approval.signature):
        return Err("APPROVAL_SIGNATURE_INVALID")
    Ok(signed.grant)
