# Caret workbench - roster ordering (CU-001).
#
# Pinned sessions first (in pin order), then the remaining sessions by recency
# (`mru` is most-recent-first), then everything else in its original order.
# Unknown ids in `pins` / `mru` are ignored; each session appears exactly once.

use app.llm_caret.workbench.session_contract.{SessionId}

fn _contains(xs: [text], x: text) -> bool:
    for y in xs:
        if y == x:
            return true
    false

fn _take(sessions: [SessionId], ids: [text], taken: [text]) -> [SessionId]:
    var out: [SessionId] = []
    var seen = taken
    for id in ids:
        if _contains(seen, id):
            continue
        for s in sessions:
            if s.value == id:
                out = out + [s]
                seen = seen + [id]
                break
    out

fn roster_order(sessions: [SessionId], pins: [text], mru: [text]) -> [SessionId]:
    val pinned = _take(sessions, pins, [])
    var taken: [text] = []
    for p in pinned:
        taken = taken + [p.value]
    val recent = _take(sessions, mru, taken)
    for r in recent:
        taken = taken + [r.value]
    var rest: [SessionId] = []
    for s in sessions:
        if not _contains(taken, s.value):
            rest = rest + [s]
    pinned + recent + rest

export roster_order
