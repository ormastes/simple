# Caret GUI workbench — HTML rendering (lane A7).
#
# Turns the pure state in `gui_layout.spl` / `session_contract.spl` into the
# workbench composition required by AC-5: left control column (roster +
# selected-agent details + composer) and a right area (one large selected
# session + a strip of inactive previews), plus one global status line.
#
# Presentation rules this file follows (doc §4-6):
#   - preserve the existing SAFE text escaping (no regression)
#   - status carries text + icon + color, never color alone
#   - unsupported metrics render "Unavailable" / "Not reported", never "0"
#   - inactive preview cards are read-only: no input elements, ever

use app.llm_caret.workbench.session_contract.{
    SessionId, SessionView, ComposerDraft, Delivery, InputMode, ProcessLifecycle,
    AgentTurn, Transport, CapabilityEvidence, same_session, new_session_view}
use app.llm_caret.workbench.gui_layout.{
    WorkbenchMode, ConnectionStatus, SessionUiState, SessionUiLookup,
    connection_status_for_selection, find_session_ui_state, preview_card_count,
    workbench_mode_name}

# Lookup result for `_find_selected`. Deliberately NOT `Option<SessionView>`
# -- see the note on `SessionUiLookup` in gui_layout.spl: the builtin generic
# becomes unresolvable once this module is compiled together with
# `provider.spl`'s large backend import graph. Filed as a compiler defect;
# this struct is the workaround, not a stylistic choice.
struct SessionLookup:
    found: bool
    view: SessionView

fn _wb_escape(value: text) -> text:
    var escaped = value.replace("&", "&amp;")
    escaped = escaped.replace("<", "&lt;")
    escaped = escaped.replace(">", "&gt;")
    escaped = escaped.replace("\"", "&quot;")
    escaped

fn _lifecycle_label(lifecycle: ProcessLifecycle) -> text:
    match lifecycle:
        case ProcessLifecycle.NotStarted: "Not started"
        case ProcessLifecycle.Starting: "Starting"
        case ProcessLifecycle.Running: "Running"
        case ProcessLifecycle.Stopping: "Stopping"
        case ProcessLifecycle.Exited: "Completed"
        case ProcessLifecycle.Failed: "Failed"
        case ProcessLifecycle.Lost: "Lost"

fn _turn_label(turn: AgentTurn) -> text:
    match turn:
        case AgentTurn.Idle: "Idle"
        case AgentTurn.Queued: "Queued"
        case AgentTurn.Working: "Working"
        case AgentTurn.WaitingApproval: "Needs approval"
        case AgentTurn.WaitingAnswer: "Needs answer"
        case AgentTurn.Completed: "Completed"
        case AgentTurn.Cancelled: "Cancelled"
        case AgentTurn.Failed: "Failed"
        case AgentTurn.Unknown: "Not reported"

fn _evidence_label(evidence: CapabilityEvidence) -> text:
    match evidence:
        case CapabilityEvidence.Declared: "Declared"
        case CapabilityEvidence.Probed: "Probed"
        case CapabilityEvidence.Available: "Available"
        case CapabilityEvidence.Verified: "Verified"
        case CapabilityEvidence.Unavailable: "Unavailable"
        case CapabilityEvidence.Failed: "Failed"

fn _delivery_label(delivery: Delivery) -> text:
    match delivery:
        case Delivery.Draft: "Draft"
        case Delivery.Queued: "Queued"
        case Delivery.Sent: "Sent"
        case Delivery.Acknowledged: "Acknowledged"
        case Delivery.Rejected: "Rejected — draft kept"
        case Delivery.Unknown: "Delivery unknown — draft kept"

fn _mode_label(mode: InputMode) -> text:
    match mode:
        case InputMode.Message: "Message"
        case InputMode.ProviderCommand: "Provider command"
        case InputMode.WorkbenchCommand: "Workbench command"
        case InputMode.TerminalPaste: "Terminal paste"

fn _render_agent_row(view: SessionView, selected: bool) -> text:
    var row_class = "agent-row"
    if selected:
        row_class = "agent-row selected"
    if view.needs_attention:
        row_class = row_class + " attention"
    val label = _wb_escape(view.label)
    val provider = _wb_escape(view.provider)
    val turn = _turn_label(view.turn)
    "<li class='" + row_class + "' data-session-id='" + _wb_escape(view.id.value) +
    "' data-session-generation='" + view.id.generation.to_text() + "' role='option' aria-selected='" +
    (if selected: "true" else: "false") + "'>" +
    "<span class='agent-label'>" + label + "</span>" +
    "<span class='agent-provider'>" + provider + "</span>" +
    "<span class='agent-turn'>" + _wb_escape(turn) + "</span></li>"

fn _render_roster(sessions: [SessionView], selected: SessionId) -> text:
    if sessions.len() == 0:
        return "<p class='empty-roster'>No agents yet. Use New Agent to launch one.</p>"
    var items = ""
    for view in sessions:
        items = items + _render_agent_row(view, same_session(view.id, selected))
    "<ul class='agent-roster' role='listbox' aria-label='Agents'>" + items + "</ul>"

fn _find_selected(sessions: [SessionView], selected: SessionId) -> SessionLookup:
    for view in sessions:
        if same_session(view.id, selected):
            return SessionLookup(found: true, view: view)
    SessionLookup(found: false, view: new_session_view(selected, "", ""))

fn _render_selected_details(found: SessionLookup) -> text:
    if found.found:
        val view = found.view
        "<dl class='agent-details' aria-label='Selected agent details'>" +
        "<dt>Agent</dt><dd>" + _wb_escape(view.label) + "</dd>" +
        "<dt>Provider</dt><dd>" + _wb_escape(view.provider) + "</dd>" +
        "<dt>Lifecycle</dt><dd>" + _lifecycle_label(view.lifecycle) + "</dd>" +
        "<dt>Turn</dt><dd>" + _turn_label(view.turn) + "</dd>" +
        "<dt>Capability evidence</dt><dd>" + _evidence_label(view.evidence) + "</dd>" +
        "</dl>"
    else:
        "<dl class='agent-details empty' aria-label='Selected agent details'><dt>Agent</dt><dd>Not reported</dd></dl>"

fn _render_composer(lookup: SessionUiLookup) -> text:
    if lookup.found:
        val s = lookup.state
        val safe_body = _wb_escape(s.draft.body)
        val delivery = _delivery_label(s.draft.delivery)
        var send_disabled = ""
        if s.draft.delivery == Delivery.Queued or s.draft.delivery == Delivery.Sent:
            send_disabled = " disabled"
        "<form class='composer' aria-label='Message composer' data-target-session='" +
        _wb_escape(s.draft.target.value) + "' data-target-generation='" +
        s.draft.target.generation.to_text() + "' data-mode='" + _wb_escape(_mode_label(s.draft.mode)) + "'>" +
        "<label for='composer-draft' hidden>Message</label>" +
        "<textarea id='composer-draft' name='draft' rows='6' placeholder='Message this agent'>" +
        safe_body + "</textarea>" +
        "<div class='composer-status' data-delivery='" + delivery + "'>" + delivery + "</div>" +
        "<button id='send' type='submit'" + send_disabled + ">Send</button></form>"
    else:
        "<form class='composer empty' aria-label='Message composer'>" +
        "<label for='composer-draft' hidden>Message</label>" +
        "<textarea id='composer-draft' name='draft' rows='6' placeholder='Select an agent to compose'></textarea>" +
        "<button id='send' type='submit' disabled>Send</button></form>"

# Live terminal output for the active region (lane A8, seam 2). Every line is
# escaped: it is bytes a child process wrote, i.e. untrusted. The block names
# the PANE, because the pane's child is not (yet) the selected agent's child
# -- see workbench/pane_source.spl.
fn _render_pane_output(pane_id: text, lines: [text]) -> text:
    if pane_id == "":
        return "<pre class='pane-output empty' data-pane-id=''>Pane: none attached</pre>"
    var body = ""
    for line in lines:
        body = body + _wb_escape(line) + "\n"
    "<pre class='pane-output' data-pane-id='" + _wb_escape(pane_id) +
    "' data-line-count='" + lines.len().to_text() + "'>" + body + "</pre>"

fn _render_active_session(found: SessionLookup, status: ConnectionStatus, pane_id: text, pane_lines: [text]) -> text:
    if found.found:
        val view = found.view
        "<section id='active-session' class='session-large' aria-label='Selected agent session'>" +
        "<header class='session-header'>" +
        "<span class='session-title'>" + _wb_escape(view.label) + " / " + _wb_escape(view.provider) + "</span>" +
        "<span class='session-connection " + status.css_class + "'>" + status.icon + " " + status.label + "</span>" +
        "</header>" +
        "<div class='session-body' data-follow='true' tabindex='0'>" +
        _render_pane_output(pane_id, pane_lines) + "</div></section>"
    else:
        "<section id='active-session' class='session-large empty' aria-label='Selected agent session'>" +
        "<p class='empty-state'>Launch or select an agent to attach a session.</p></section>"

fn _render_preview_card(view: SessionView) -> text:
    "<article class='preview-card' data-session-id='" + _wb_escape(view.id.value) +
    "' aria-label='Inactive session preview' aria-readonly='true'>" +
    "<header>" + _wb_escape(view.label) + " / " + _turn_label(view.turn) + "</header>" +
    "<div class='preview-body' aria-hidden='false'></div></article>"

fn _render_preview_strip(sessions: [SessionView], selected: SessionId) -> text:
    var inactive: [SessionView] = []
    for view in sessions:
        if not same_session(view.id, selected):
            inactive.push(view)
    val visible = preview_card_count(inactive.len())
    if visible == 0:
        return "<div class='preview-strip empty' aria-label='Other sessions'><p>No other sessions</p></div>"
    var cards = ""
    var shown: i64 = 0
    for view in inactive:
        if shown < visible:
            cards = cards + _render_preview_card(view)
            shown = shown + 1
    "<div class='preview-strip' aria-label='Other sessions' data-visible-count='" + visible.to_text() + "'>" +
    cards + "</div>"

fn _render_global_status(status: ConnectionStatus, pending_attention: i64, mode: WorkbenchMode) -> text:
    "<footer id='global-status' class='" + status.css_class + "' data-workbench-mode='" +
    workbench_mode_name(mode) + "'>" +
    "<span class='status-indicator'>" + status.icon + " " + status.label + "</span>" +
    "<span class='status-pending'>Pending approvals: " + pending_attention.to_text() + "</span></footer>"

fn _count_attention(sessions: [SessionView]) -> i64:
    var n: i64 = 0
    for view in sessions:
        if view.needs_attention:
            n = n + 1
    n

val _WORKBENCH_STYLE: text = """
:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
body { margin: 0; min-height: 100vh; background: #0b1020; color: #eef2ff; }
.workbench { display: grid; grid-template-columns: 320px 1fr; grid-template-rows: 1fr auto; min-height: 100vh; }
.workbench.mode-collapsed { grid-template-columns: 288px 1fr; }
.workbench.mode-compact { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; }
.control-column, .drawer { display: flex; flex-direction: column; border-right: 1px solid #334155; background: #111827; min-width: 288px; max-width: 380px; }
.workbench.mode-compact .drawer { max-width: none; border-right: none; border-bottom: 1px solid #334155; }
.agent-roster { list-style: none; margin: 0; padding: 8px; overflow-y: auto; flex: 1 1 auto; }
.agent-row { padding: 8px 10px; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; gap: 8px; }
.agent-row.selected { background: #1f2a44; outline: 2px solid #60a5fa; }
.agent-row.attention { border-left: 3px solid #f59e0b; }
.agent-details { padding: 10px 12px; border-top: 1px solid #334155; margin: 0; }
.agent-details dt { font-size: 11px; color: #94a3b8; }
.agent-details dd { margin: 0 0 6px; }
.composer { border-top: 1px solid #334155; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
.composer textarea { min-height: 4.5em; max-height: 12em; resize: vertical; background: #0f172a; color: #f8fafc; border: 1px solid #475569; border-radius: 8px; padding: 8px; font: inherit; }
.composer-status { font-size: 11px; color: #94a3b8; }
.composer button { min-height: 36px; border-radius: 8px; border: 1px solid #475569; background: #2563eb; color: white; cursor: pointer; }
.composer button:disabled { opacity: .6; cursor: wait; }
.right-area { display: grid; grid-template-rows: 78% 22%; min-height: 0; }
.session-large { border-bottom: 1px solid #334155; display: flex; flex-direction: column; min-height: 0; }
.session-header { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #334155; }
.session-body { flex: 1 1 auto; overflow-y: auto; padding: 12px; }
.pane-output { margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
.pane-output.empty { color: #94a3b8; }
.preview-strip { display: flex; gap: 10px; padding: 10px; overflow-x: auto; }
.preview-card { flex: 1 1 220px; border: 1px solid #334155; border-radius: 8px; background: #151b2e; min-width: 180px; }
.preview-card header { padding: 6px 8px; font-size: 12px; border-bottom: 1px solid #334155; }
#global-status { grid-column: 1 / -1; display: flex; justify-content: space-between; padding: 6px 14px; border-top: 1px solid #334155; font-size: 12px; }
.status-connecting { color: #fbbf24; }
.status-ready { color: #86efac; }
.status-stale { color: #fbbf24; }
.status-disconnected { color: #94a3b8; }
.status-reconnecting { color: #fbbf24; }
.status-failed { color: #f87171; }
"""

# Renders the full workbench page for the given session state. `mode` is a
# pure function of viewport width (see `workbench_mode_for_width`) -- the
# caller decides the width; this function only lays out that decision.
pub fn render_workbench_page(sessions: [SessionView], selected: SessionId, states: [SessionUiState], mode: WorkbenchMode) -> text:
    var no_output: [text] = []
    render_workbench_page_with_output(sessions, selected, states, mode, "", no_output)

# Same page, with live terminal output for the active-session region.
pub fn render_workbench_page_with_output(sessions: [SessionView], selected: SessionId, states: [SessionUiState], mode: WorkbenchMode, pane_id: text, pane_lines: [text]) -> text:
    val found = _find_selected(sessions, selected)
    var transport = Transport.Connecting
    if found.found:
        transport = found.view.transport
    val status = connection_status_for_selection(found.found, transport)
    val ui_state = find_session_ui_state(states, selected)
    var mode_class = "mode-full"
    var is_compact = false
    match mode:
        case WorkbenchMode.Full: mode_class = "mode-full"
        case WorkbenchMode.Collapsed: mode_class = "mode-collapsed"
        case WorkbenchMode.Compact:
            mode_class = "mode-compact"
            is_compact = true
    val pending = _count_attention(sessions)
    val controls = _render_roster(sessions, selected) + _render_selected_details(found) + _render_composer(ui_state)
    var controls_markup = "<div class='control-column' aria-label='Agent control column'>" + controls + "</div>"
    if is_compact:
        controls_markup = "<div class='drawer' aria-label='Compact controls (roster, details, composer)'>" + controls + "</div>"
    "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>" +
    "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
    "<title>Caret Workbench</title><style>" + _WORKBENCH_STYLE + "</style></head>" +
    "<body><div class='workbench " + mode_class + "' data-workbench='caret' data-workbench-mode='" +
    workbench_mode_name(mode) + "'>" +
    controls_markup +
    "<div class='right-area'>" +
    _render_active_session(found, status, pane_id, pane_lines) +
    _render_preview_strip(sessions, selected) +
    "</div>" +
    _render_global_status(status, pending, mode) +
    "</div></body></html>"
