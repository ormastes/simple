# HostAuthority value boundary. Only an authenticated enrollment/config owner
# may publish this snapshot. Resolution never enrolls a host or opens SSH.
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}

struct DistributedCredentialRoleV2:
    identity: text
    credential_reference: text
    revision: i64
    revoked: bool

struct DistributedHostRolesV2:
    host_id: text
    # SHA-256 of the decoded public host key, lowercase hex; not a hostname,
    # SSH account, signer identity, or the displayed base64 fingerprint.
    host_key_digest: text
    registry_revision: i64
    ssh_account: DistributedCredentialRoleV2
    provider_profile: DistributedCredentialRoleV2
    node_identity: DistributedCredentialRoleV2
    signer_identity: DistributedCredentialRoleV2

struct DistributedCredentialDependencyV2:
    host_id: text
    role: text
    role_revision: i64
    revoked: bool

fn distributed_credential_reference_valid_v2(reference: text) -> bool:
    if not reference.starts_with("secret://") or reference.len() > 256:
        return false
    val name = reference.substring(9)
    if name == "" or name.starts_with("/") or name.ends_with("/") or name.contains(".."):
        return false
    for i in 0..name.len():
        val c = name.byte_at(i) as i64
        if not ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or
                (c >= 48 and c <= 57) or c == 45 or c == 95 or c == 46 or c == 47):
            return false
    true

fn distributed_role_validate_v2(role: DistributedCredentialRoleV2) -> text:
    if not builder_identifier_valid_v1(role.identity) or
            not distributed_credential_reference_valid_v2(role.credential_reference):
        return "ROLE_INVALID"
    if role.revision <= 0:
        return "ROLE_REVISION_INVALID"
    if role.revoked:
        return "ROLE_REVOKED"
    ""

# Validate identities across the bounded snapshot before selecting a row. Duplicate host
# IDs never resolve by iteration order, even when both rows have the same key.
fn distributed_host_roles_resolve_v2(registry: [DistributedHostRolesV2],
        host_id: text, observed_host_key_digest: text,
        expected_registry_revision: i64) -> Result<DistributedHostRolesV2, text>:
    if registry.len() > 128 or not builder_identifier_valid_v1(host_id) or
            not builder_digest_valid_v1(observed_host_key_digest) or expected_registry_revision <= 0:
        return Err("HOST_REQUEST_INVALID")
    var seen: [text] = []
    var selected: DistributedHostRolesV2? = nil
    for host in registry:
        if not builder_identifier_valid_v1(host.host_id) or not builder_digest_valid_v1(host.host_key_digest):
            return Err("HOST_REGISTRY_INVALID")
        if host.registry_revision != expected_registry_revision:
            return Err("HOST_REGISTRY_STALE")
        if seen.contains(host.host_id):
            return Err("HOST_REGISTRY_DUPLICATE")
        seen.push(host.host_id)
        if host.host_id == host_id:
            selected = Some(host)
    if not selected.?:
        return Err("HOST_NOT_ENROLLED")
    val host = selected ?? registry[0]
    if host.host_key_digest != observed_host_key_digest:
        return Err("HOST_KEY_CHANGED")
    for role in [host.ssh_account, host.provider_profile, host.node_identity, host.signer_identity]:
        val error = distributed_role_validate_v2(role)
        if error != "":
            return Err(error)
    Ok(host)

# Rotation/revocation planning inspects references, including revoked roles.
# The authenticated owner must publish the actual transaction separately.
fn distributed_host_credential_dependents_v2(registry: [DistributedHostRolesV2],
        reference: text, expected_registry_revision: i64) -> Result<[DistributedCredentialDependencyV2], text>:
    if registry.len() > 128 or not distributed_credential_reference_valid_v2(reference) or
            expected_registry_revision <= 0:
        return Err("HOST_REQUEST_INVALID")
    var seen: [text] = []
    var dependencies: [DistributedCredentialDependencyV2] = []
    val names = ["ssh_account", "provider_profile", "node_identity", "signer_identity"]
    for host in registry:
        if not builder_identifier_valid_v1(host.host_id) or not builder_digest_valid_v1(host.host_key_digest):
            return Err("HOST_REGISTRY_INVALID")
        if host.registry_revision != expected_registry_revision:
            return Err("HOST_REGISTRY_STALE")
        if seen.contains(host.host_id):
            return Err("HOST_REGISTRY_DUPLICATE")
        seen.push(host.host_id)
        val roles = [host.ssh_account, host.provider_profile, host.node_identity, host.signer_identity]
        for i in 0..roles.len():
            val role = roles[i]
            val error = distributed_role_validate_v2(role)
            if error != "" and error != "ROLE_REVOKED":
                return Err(error)
            if role.credential_reference == reference:
                dependencies.push(DistributedCredentialDependencyV2(host_id: host.host_id,
                    role: names[i], role_revision: role.revision, revoked: role.revoked))
    Ok(dependencies)
