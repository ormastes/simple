# Closed userland composition for the distributed Caret control service.
# Descriptor admission is not runtime/provider qualification or activation.
use common.kernel_plugin.ids.{KpfId128}
use common.kernel_plugin.contracts.*
use std.mdsocpp.*

fn control_id(value: u64) -> KpfId128:
    KpfId128(hi: 0x4442435632, lo: value)

fn control_offer(value: u64) -> MdsocppFacetOfferV1:
    MdsocppFacetOfferV1(facet_id: control_id(value))

fn control_require(value: u64) -> MdsocppFacetRequirementV1:
    MdsocppFacetRequirementV1(facet_id: control_id(value), optional: false)

# Caller-supplied capacities are checked by the common sealer, not hidden defaults.
fn control_descriptor(id: u64, offers: [u64], requirements: [u64],
        capabilities: u64, persistent_bytes: u64, sessions: u32,
        inflight: u32, calls: u32) -> CapsuleDescriptorV1:
    var provided: [MdsocppFacetOfferV1] = []
    for value in offers:
        provided.push(control_offer(value))
    var required: [MdsocppFacetRequirementV1] = []
    for value in requirements:
        required.push(control_require(value))
    CapsuleDescriptorV1(
        capsule_id: control_id(id), closure: MdsocppClosure.Static,
        provided_facets: provided, required_facets: required,
        required_capability_bits: capabilities,
        memory: KpfMemoryContractV1(
            memory_class: KPF_MEMORY_NOGC_BOUNDED,
            initialization_bytes: 0, persistent_bytes_per_instance: persistent_bytes,
            bytes_per_session: 0, bytes_per_inflight_request: 0,
            input_alignment: 8, output_alignment: 8,
            maximum_sessions: sessions, maximum_inflight_per_session: inflight,
            maximum_batch_items: 1, may_allocate_after_activation: KPF_FLAG_FALSE,
            reserved0: 0),
        concurrency: KpfConcurrencyContractV1(
            mode: KPF_CONCURRENCY_SNAPSHOT_READ_PARALLEL,
            reentrancy: KPF_REENTRANCY_SIGNAL_ONLY,
            maximum_concurrent_calls: calls,
            deterministic_completion: KPF_FLAG_TRUE, reserved0: 0),
        uses_ecs: false, state_migrations: [])

# Stable facet IDs: 101 HostQuery, 102 GrantQuery, 103 GrantCommand;
# 201 SessionCommand, 202 SessionQuery; 301 BuildCommand, 302 BuildQuery;
# 401 ArtifactCommand, 402 ArtifactQuery; 501 EvidenceCommand, 502 EvidenceQuery;
# 601 SnapshotCommand, 602 SnapshotQuery; 701 ViewQuery.
# Capability bits: 1 authority, 2 process execution, 4 artifact publication,
# 8 protected evidence, 16 source lifecycle. Grants are still checked per command.
pub fn distributed_control_descriptors_v2(persistent_bytes_per_capsule: u64,
        maximum_sessions: u32, maximum_inflight: u32,
        maximum_calls: u32) -> [CapsuleDescriptorV1]:
    [
        control_descriptor(10, [101, 102, 103], [], 1, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(20, [201, 202], [101, 102], 2, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(30, [301, 302], [101, 102, 402], 2, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(40, [401, 402], [102], 4, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(50, [501, 502], [302, 102], 8, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(60, [601, 602], [402, 102], 16, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls),
        control_descriptor(70, [701], [202, 302, 502], 0, persistent_bytes_per_capsule,
            maximum_sessions, maximum_inflight, maximum_calls)
    ]

pub fn distributed_control_seal_v2(capsules: [CapsuleDescriptorV1],
        policy: MdsocppSealPolicyV1) -> MdsocppSealResultV1:
    mdsocpp_seal_v1(capsules, policy)
