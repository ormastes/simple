#![allow(REQC004)]
# Caret workbench — manager -> SessionView adapter + live publication (lane A8).
#
# Seam 1 of the end-to-end wiring: `multi_caret_manager.spl` owns the real
# parent-owned process table; every workbench surface renders `SessionView`
# (session_contract.spl). This file is the ONLY place that translates one into
# the other, so the TUI and the GUI cannot disagree about what a child's state
# means.
#
# Deliberately does NOT import `os.apps.smux.api`. `gui.spl` imports this file
# and `gui.spl` is imported by `main.spl`, which already co-compiles the whole
# `app.llm_caret.provider` backend graph; pulling smux's five distinct
# `Result<T, text>` instantiations into that closure is the same shape as the
# filed generic-resolution defect
# (doc/08_tracking/bug/option_generic_unresolvable_under_large_cocompiled_program_2026-09-05.md).
# The terminal capture adapter lives in `pane_source.spl` instead, and only a
# publisher imports it.

use app.llm_caret.multi_caret_manager.{MultiCaretManager, ManagedAgent,
    list_multi_caret_agents}
use app.llm_caret.workbench.session_contract.{SessionId, SessionView,
    ProcessLifecycle, AgentTurn, Transport, CapabilityEvidence,
    ComposerDraft, Delivery, new_session_id, same_session, draft_targets}
use app.llm_caret.workbench.pane_binding.{PaneBinding, PaneBindingResult,
    input_target_allowed}

# ============================================================================
# State mapping
# ============================================================================

# The manager's per-child status text (from `agent_runtime.agent_process_status`
# / `stop_agent_process`) mapped onto the lifecycle axis. Never defaults to
# Running: an unrecognised status means ownership is UNCERTAIN, which is
# exactly what `Lost` is for.
pub fn lifecycle_for_agent(agent: ManagedAgent) -> ProcessLifecycle:
    if agent.status == "started" or agent.status == "running":
        return ProcessLifecycle.Running
    if agent.status == "stopped":
        return ProcessLifecycle.Exited
    if agent.status == "not_running":
        if agent.pid > 0:
            return ProcessLifecycle.Exited
        # invalid_pid: the slot never spawned at all.
        return ProcessLifecycle.NotStarted
    if agent.status == "not_started":
        return ProcessLifecycle.NotStarted
    if agent.status == "error":
        # A kill that failed on a live pid leaves an unowned running child --
        # the same rule `_leaked_processes` uses. Claiming it exited would
        # invite a double-spawn.
        if agent.pid > 0:
            return ProcessLifecycle.Lost
        return ProcessLifecycle.Failed
    ProcessLifecycle.Lost

# Derived from the lifecycle this file already computed, NOT from
# `ManagedAgent.alive`: that flag only excludes the statuses "stopped" and
# "exited", so a reaped child reported as "not_running" still reads as alive.
# "Ready" here means the parent holds a live handle, not that any provider
# handshake completed.
fn _transport_for(lifecycle: ProcessLifecycle) -> Transport:
    match lifecycle:
        case ProcessLifecycle.Running: Transport.Ready
        case ProcessLifecycle.Starting: Transport.Connecting
        case ProcessLifecycle.NotStarted: Transport.Connecting
        case ProcessLifecycle.Stopping: Transport.Stale
        # Ownership uncertain: the handle may still be live, so neither
        # "Ready" nor "Closed" is honest.
        case ProcessLifecycle.Lost: Transport.Stale
        case _: Transport.Closed

fn _evidence_for(agent: ManagedAgent) -> CapabilityEvidence:
    # The one thing actually exercised end to end is "this child was spawned".
    if agent.pid > 0:
        return CapabilityEvidence.Available
    CapabilityEvidence.Declared

# The manager's process table (`AgentProcess`) retains neither the launch
# provider nor a restart count, so this file keeps the minimum itself: a
# provider hint supplied by whoever launched the child, and a per-slot ledger
# whose generation increases when a slot's live pid is replaced (a restart).
# A provider nobody declared is "unknown", never a guess.
val UNKNOWN_PROVIDER: text = "unknown"

struct AgentProviderHint:
    agent_id: text
    provider: text

struct SessionLedgerEntry:
    agent_id: text
    last_pid: i64
    generation: i64

pub fn provider_for_agent(hints: [AgentProviderHint], agent_id: text) -> text:
    for h in hints:
        if h.agent_id == agent_id and h.provider != "":
            return h.provider
    UNKNOWN_PROVIDER

# Immutable: returns the ledger after observing `agent`. A new slot starts at
# generation 1. A live pid that differs from the last live pid is a restart:
# generation + 1. A dead/never-spawned slot (pid <= 0) keeps its generation and
# last live pid, so a later relaunch is still recognised as a restart.
pub fn ledger_observe(ledger: [SessionLedgerEntry], agent: ManagedAgent) -> [SessionLedgerEntry]:
    var out: [SessionLedgerEntry] = []
    var found = false
    for e in ledger:
        if e.agent_id == agent.agent_id:
            found = true
            if agent.pid > 0 and e.last_pid > 0 and agent.pid != e.last_pid:
                out.push(SessionLedgerEntry(agent_id: e.agent_id, last_pid: agent.pid,
                    generation: e.generation + 1))
            elif agent.pid > 0 and e.last_pid <= 0:
                out.push(SessionLedgerEntry(agent_id: e.agent_id, last_pid: agent.pid,
                    generation: e.generation))
            else:
                out.push(e)
        else:
            out.push(e)
    if not found:
        out.push(SessionLedgerEntry(agent_id: agent.agent_id, last_pid: agent.pid, generation: 1))
    out

pub fn ledger_generation(ledger: [SessionLedgerEntry], agent_id: text) -> i64:
    for e in ledger:
        if e.agent_id == agent_id:
            return e.generation
    1

pub fn session_view_for_agent(agent: ManagedAgent) -> SessionView:
    session_view_for_agent_at(agent, UNKNOWN_PROVIDER, 1)

pub fn session_view_for_agent_at(agent: ManagedAgent, provider: text, generation: i64) -> SessionView:
    val lifecycle = lifecycle_for_agent(agent)
    var shown_provider = provider
    if shown_provider == "":
        shown_provider = UNKNOWN_PROVIDER
    SessionView(
        id: SessionId(value: agent.agent_id, generation: generation),
        label: agent.agent_id,
        provider: shown_provider,
        lifecycle: lifecycle,
        # A raw child process exposes no semantic turn state. Guessing
        # `Working` from "the process is alive" is precisely the axis
        # collapse session_contract.spl exists to prevent.
        turn: AgentTurn.Unknown,
        transport: _transport_for(lifecycle),
        evidence: _evidence_for(agent),
        needs_attention: false)

pub fn manager_session_views(manager: MultiCaretManager) -> [SessionView]:
    var no_hints: [AgentProviderHint] = []
    var no_ledger: [SessionLedgerEntry] = []
    manager_session_views_with(manager, no_hints, no_ledger)

pub fn manager_session_views_with(manager: MultiCaretManager,
        hints: [AgentProviderHint], ledger: [SessionLedgerEntry]) -> [SessionView]:
    var views: [SessionView] = []
    for agent in list_multi_caret_agents(manager):
        views.push(session_view_for_agent_at(agent,
            provider_for_agent(hints, agent.agent_id),
            ledger_generation(ledger, agent.agent_id)))
    views

# ============================================================================
# Guarded send (REQ-CARET-UI-002, CU-019)
# ============================================================================

# A draft is delivered only if its captured (id, generation) still names the
# live session AND an explicit pane binding for that exact generation exists.
# Otherwise it is Rejected, never redirected to the new generation.
pub fn send_draft_guarded(draft: ComposerDraft, live: SessionId,
        binding: PaneBindingResult) -> ComposerDraft:
    var delivery = Delivery.Rejected
    if draft_targets(draft, live) and
            input_target_allowed(binding, draft.target.value, draft.target.generation):
        delivery = Delivery.Queued
    ComposerDraft(target: draft.target, mode: draft.mode, body: draft.body,
        delivery: delivery)

# ============================================================================
# Live publication
# ============================================================================

# The surfaces that render the workbench (`caret_gui_html()` over HTTP, the
# TUI entry) are called with no manager in hand, so the owner of the manager
# publishes here after each launch/poll and the surfaces read it back. Empty
# until something publishes -- an empty roster is the honest render of "no
# agents launched", never a fabricated one.
var _live_sessions: [SessionView] = []
var _live_selected: text = ""

var _live_hints: [AgentProviderHint] = []
var _live_ledger: [SessionLedgerEntry] = []

# The launcher declares the provider it spawned for a slot.
pub fn declare_agent_provider(agent_id: text, provider: text):
    _live_hints.push(AgentProviderHint(agent_id: agent_id, provider: provider))

pub fn publish_manager_sessions(manager: MultiCaretManager):
    for agent in list_multi_caret_agents(manager):
        _live_ledger = ledger_observe(_live_ledger, agent)
    val views = manager_session_views_with(manager, _live_hints, _live_ledger)
    _live_sessions = views
    if views.len() > 0:
        var still_present = false
        for v in views:
            if v.id.value == _live_selected:
                still_present = true
        if not still_present:
            _live_selected = views[0].id.value
    else:
        _live_selected = ""

pub fn select_live_session(id: SessionId):
    _live_selected = id.value

pub fn live_sessions() -> [SessionView]:
    _live_sessions

pub fn live_selected() -> SessionId:
    if _live_selected == "":
        return new_session_id("none")
    new_session_id(_live_selected)

pub fn clear_live_sessions():
    var empty: [SessionView] = []
    var no_hints: [AgentProviderHint] = []
    var no_ledger: [SessionLedgerEntry] = []
    _live_sessions = empty
    _live_hints = no_hints
    _live_ledger = no_ledger
    _live_selected = ""

# ============================================================================
# Live terminal output for the active pane
# ============================================================================

# Published by whoever owns the smux pane (see `pane_source.spl`), read by
# both surfaces. Kept as plain lines so this module needs no smux import.
var _live_pane_id: text = ""
var _live_pane_lines: [text] = []

pub fn publish_pane_output(pane_id: text, lines: [text]):
    _live_pane_id = pane_id
    _live_pane_lines = lines

pub fn live_pane_id() -> text:
    _live_pane_id

pub fn live_pane_lines() -> [text]:
    _live_pane_lines

var _live_bindings: [PaneBinding] = []
var _live_pane_generation: i64 = 0

# Explicit binding of a (session, generation) to the pane now being drained.
pub fn publish_pane_binding(binding: PaneBinding):
    var kept: [PaneBinding] = []
    for b in _live_bindings:
        if b.pane_id != binding.pane_id and not same_session(b.session, binding.session):
            kept.push(b)
    kept.push(binding)
    _live_bindings = kept
    _live_pane_generation = binding.pane_generation

pub fn live_pane_bindings() -> [PaneBinding]:
    _live_bindings

pub fn live_pane_generation() -> i64:
    _live_pane_generation

pub fn clear_pane_output():
    var empty: [text] = []
    var no_bindings: [PaneBinding] = []
    _live_pane_id = ""
    _live_pane_lines = empty
    _live_bindings = no_bindings
    _live_pane_generation = 0

export lifecycle_for_agent, session_view_for_agent, session_view_for_agent_at,
    manager_session_views, manager_session_views_with, UNKNOWN_PROVIDER
export AgentProviderHint, SessionLedgerEntry, provider_for_agent, ledger_observe,
    ledger_generation, send_draft_guarded, declare_agent_provider
export publish_pane_binding, live_pane_bindings, live_pane_generation
export publish_manager_sessions, select_live_session, live_sessions,
    live_selected, clear_live_sessions
export publish_pane_output, live_pane_id, live_pane_lines, clear_pane_output
