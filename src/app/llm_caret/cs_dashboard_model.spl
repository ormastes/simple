# Shared Caret roster and dashboard state for headless and GUI consumers.

# cpu_pct/rss_mb use -1 as the UNMEASURED sentinel; 0 would be a real idle
# reading and must stay distinguishable from "we never got a number".
struct CsAgent:
    agent_id: text
    spec: text
    status: text
    pid: i64
    pane_id: text
    cpu_pct: f64
    rss_mb: i64
    detail: text

struct CsDashboard:
    session: text
    manager_status: text
    agents: [CsAgent]
    selected: i64
    input: text
    log: [text]
    # What the SELECTED agent's pane child printed, oldest first; empty when
    # nothing is selected or the backend could not capture it.
    screen: [text]
    # Roster ordering inputs (agent ids): pinned first, then `mru` (most
    # recently selected first).
    pins: [text]
    mru: [text]

fn cs_dashboard_new(session: text) -> CsDashboard:
    CsDashboard(session: session, manager_status: "unknown: not polled yet",
        agents: [], selected: -1, input: "", log: [], screen: [], pins: [], mru: [])

export CsAgent, CsDashboard, cs_dashboard_new
