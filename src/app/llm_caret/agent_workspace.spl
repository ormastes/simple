@allow(primitive_api)
# LLM Caret - real tmux sessions + git worktrees for agent processes
#
# The model-only `agent_tmux.spl` embed never owns a PID. This module is the
# side-effecting counterpart: every agent gets a detached git worktree and a
# pane in a tmux session on a PRIVATE socket (`tmux -L <socket>`), so nothing
# here can touch another user's attached tmux server.
#
# ponytail: thin facade over `tmux`/`git` CLIs via process_run; no daemon, no
# state file. Upgrade to os.apps.smux when an in-process multiplexer is needed.

use app.io.mod.{process_run, dir_exists, dir_create_all, current_time_ms, sleep_ms}

struct AgentWorkspace:
    socket: text          # tmux -L socket name; private per workspace
    session: text         # tmux session name
    repo: text            # git repo the worktrees are cut from
    worktree_root: text   # where <root>/<agent_id> trees live

struct WorkspaceResult:
    status: text          # "ok" | "error"
    reason: text
    output: text

fn _ok(out: text) -> WorkspaceResult:
    WorkspaceResult(status: "ok", reason: "", output: out)

fn _err(reason: text, out: text) -> WorkspaceResult:
    WorkspaceResult(status: "error", reason: reason, output: out)

fn _run(cmd: text, args: [text], reason: text) -> WorkspaceResult:
    val (out, err, code) = process_run(cmd, args)
    if code != 0:
        return _err(reason: reason, out: out + err)
    _ok(out)

fn _fmt(key: text) -> text:
    "#" + "{" + key + "}"

fn _tmux(ws: AgentWorkspace, args: [text], reason: text) -> WorkspaceResult:
    _run(cmd: "tmux", args: ["-L", ws.socket] + args, reason: reason)

pub fn agent_workspace(id: text, repo: text, worktree_root: text) -> AgentWorkspace:
    AgentWorkspace(socket: "caret_ws_" + id, session: id, repo: repo,
        worktree_root: worktree_root)

pub fn tmux_available() -> bool:
    val (_o, _e, code) = process_run("tmux", ["-V"])
    code == 0

# --- sessions / windows / panes ---------------------------------------------

pub fn session_alive(ws: AgentWorkspace) -> bool:
    _tmux(ws: ws, args: ["has-session", "-t", ws.session], reason: "no_session").status == "ok"

pub fn session_ensure(ws: AgentWorkspace, cwd: text) -> WorkspaceResult:
    if session_alive(ws):
        return _ok("exists")
    _tmux(ws: ws, args: ["new-session", "-d", "-s", ws.session, "-c", cwd], reason: "new_session_failed")

pub fn session_kill(ws: AgentWorkspace) -> WorkspaceResult:
    # Only ever the private socket: `-L caret_ws_*` cannot name the user's server.
    _tmux(ws: ws, args: ["kill-server"], reason: "kill_server_failed")

pub fn window_open(ws: AgentWorkspace, name: text, cwd: text, command: text) -> WorkspaceResult:
    var args = ["new-window", "-d", "-t", ws.session, "-n", name, "-c", cwd]
    if command != "":
        args = args + [command]
    _tmux(ws, args, "new_window_failed")

pub fn pane_split(ws: AgentWorkspace, window: text, cwd: text) -> WorkspaceResult:
    _tmux(ws, ["split-window", "-d", "-t", ws.session + ":" + window, "-c", cwd],
        "split_failed")

pub fn list_panes(ws: AgentWorkspace) -> [text]:
    # `#{...}` inside a literal is string interpolation: build the tmux format by hand.
    val fmt = _fmt("session_name") + ":" + _fmt("window_name") + "." + _fmt("pane_index")
    val r = _tmux(ws, ["list-panes", "-s", "-t", ws.session, "-F", fmt], "list_panes_failed")
    if r.status != "ok":
        return []
    var panes: [text] = []
    for line in r.output.split("\n"):
        if line.trim() != "":
            panes = panes + [line.trim()]
    panes

pub fn send_to_pane(ws: AgentWorkspace, target: text, command: text) -> WorkspaceResult:
    _tmux(ws, ["send-keys", "-t", target, command, "Enter"], "send_keys_failed")

# Send one command to EVERY pane of the session. Returns the panes it reached.
pub fn send_to_each_pane(ws: AgentWorkspace, command: text) -> [text]:
    var reached: [text] = []
    for target in list_panes(ws):
        if send_to_pane(ws: ws, target: target, command: command).status == "ok":
            reached = reached + [target]
    reached

pub fn capture_pane(ws: AgentWorkspace, target: text) -> text:
    _tmux(ws, ["capture-pane", "-p", "-J", "-S", "-", "-t", target], "capture_failed").output

# Poll a pane until `marker` shows up (send-keys is async). Bounded.
pub fn wait_for_pane_text(ws: AgentWorkspace, target: text, marker: text, timeout_ms: i64) -> bool:
    val deadline = current_time_ms() + timeout_ms
    while current_time_ms() < deadline:
        if capture_pane(ws: ws, target: target).contains(marker):
            return true
        sleep_ms(200)
    false

# --- worktrees (paths must be ABSOLUTE: `git -C repo` resolves relative paths against the repo) ---

pub fn worktree_path(ws: AgentWorkspace, agent_id: text) -> text:
    ws.worktree_root + "/" + agent_id

# Detached: this repo NEVER creates branches (CLAUDE.md).
pub fn worktree_add(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    val path = worktree_path(ws: ws, agent_id: agent_id)
    if dir_exists(path):
        return _ok("exists")
    dir_create_all(ws.worktree_root)
    _run(cmd: "git", args: ["-C", ws.repo, "worktree", "add", "--detach", path], reason: "worktree_add_failed")

pub fn worktree_remove(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    val path = worktree_path(ws: ws, agent_id: agent_id)
    if not dir_exists(path):
        return _ok("absent")
    _run(cmd: "git", args: ["-C", ws.repo, "worktree", "remove", "--force", path], reason: "worktree_remove_failed")

pub fn worktree_list(ws: AgentWorkspace) -> [text]:
    val r = _run("git", ["-C", ws.repo, "worktree", "list", "--porcelain"], "worktree_list_failed")
    var paths: [text] = []
    for line in r.output.split("\n"):
        if line.starts_with("worktree "):
            paths = paths + [line.substring(9).trim()]
    paths

# --- composite: one agent = one worktree + one pane --------------------------

pub fn agent_attach(ws: AgentWorkspace, agent_id: text, command: text) -> WorkspaceResult:
    val wt = worktree_add(ws: ws, agent_id: agent_id)
    if wt.status != "ok":
        return wt
    val s = session_ensure(ws: ws, cwd: worktree_path(ws: ws, agent_id: agent_id))
    if s.status != "ok":
        return s
    window_open(ws: ws, name: agent_id, cwd: worktree_path(ws: ws, agent_id: agent_id), command: command)

pub fn agent_detach(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    _tmux(ws, ["kill-window", "-t", ws.session + ":" + agent_id], "kill_window_failed")
    worktree_remove(ws: ws, agent_id: agent_id)

# Launch a caret spec suite in its own tmux window and return the pane target.
pub fn launch_caret_suite(ws: AgentWorkspace, cwd: text, spec: text) -> text:
    val cmd = "SIMPLE_TIMEOUT_SECONDS=900 bin/simple test " + spec + " --no-session-daemon"
    if session_ensure(ws: ws, cwd: cwd).status != "ok":
        return ""
    if window_open(ws: ws, name: "caret_suite", cwd: cwd, command: "").status != "ok":
        return ""
    val target = ws.session + ":caret_suite"
    if send_to_pane(ws: ws, target: target, command: cmd).status != "ok":
        return ""
    target

export AgentWorkspace, WorkspaceResult
export agent_workspace, tmux_available, session_alive, session_ensure, session_kill,
    window_open, pane_split, list_panes, send_to_pane, send_to_each_pane,
    capture_pane, wait_for_pane_text, worktree_path, worktree_add,
    worktree_remove, worktree_list, agent_attach, agent_detach, launch_caret_suite
