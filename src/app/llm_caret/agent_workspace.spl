@allow(primitive_api)
# LLM Caret - real tmux sessions + git worktrees for agent processes
#
# The model-only `agent_tmux.spl` embed never owns a PID. This module is the
# side-effecting counterpart: every agent gets a detached git worktree and a
# pane in a tmux session on a PRIVATE socket (`tmux -L <socket>`), so nothing
# here can touch another user's attached tmux server.
#
# ponytail: thin facade over `tmux`/`git` CLIs via process_run; no daemon, no
# state file. Upgrade to os.apps.smux when an in-process multiplexer is needed.

use app.io.mod.{process_run, dir_exists, file_exists, dir_create_all, current_time_ms, sleep_ms, env_get, env_set}
use std.nogc_async_mut.sosix.{sosix_platform, sosix_which}
use std.common.string_core.{text_to_bytes}
use os.apps.smux.server.{smux_server_request}
use os.apps.smux.smux_remote.{smux_remote_reply_ok}
use app.llm_caret.pane_backend.{pane_backend_name, windows_spawn_command_line, posix_quote_arg}

# Recursion protection. Anything this module spawns (agent commands, the caret
# suite) carries LLM_CARET_WORKSPACE_DEPTH=<n+1>; at MAX_DEPTH a launch is
# refused, so a suite that contains the tmux system spec cannot nest forever.
# ponytail: env counter, not a lock file — good enough until a supervisor needs
# cross-host accounting.
val DEPTH_ENV = "LLM_CARET_WORKSPACE_DEPTH"
val MAX_DEPTH = 1

pub fn workspace_depth() -> i64:
    val raw = env_get(DEPTH_ENV)
    if raw == "":
        return 0
    int(raw) ?? 0

pub fn depth_exceeded() -> bool:
    workspace_depth() >= MAX_DEPTH

# Prefix a shell command with the next depth marker.
pub fn with_depth(command: text) -> text:
    if command == "":
        return ""
    DEPTH_ENV + "=" + (workspace_depth() + 1).to_text() + " " + command

# The pane this process itself runs in (tmux sets TMUX_PANE), or "".
# On smux, panes export SMUX_PANE (their `session:name.i` target) at spawn.
fn _own_pane_id() -> text:
    if _smux():
        return env_get("SMUX_PANE")
    env_get("TMUX_PANE")

struct AgentWorkspace:
    socket: text          # tmux -L socket name; private per workspace
    session: text         # tmux session name
    repo: text            # git repo the worktrees are cut from
    worktree_root: text   # where <root>/<agent_id> trees live

struct WorkspaceResult:
    status: text          # "ok" | "error"
    reason: text
    output: text

fn _ok(out: text) -> WorkspaceResult:
    WorkspaceResult(status: "ok", reason: "", output: out)

fn _err(reason: text, out: text) -> WorkspaceResult:
    WorkspaceResult(status: "error", reason: reason, output: out)

fn _run(cmd: text, args: [text], reason: text) -> WorkspaceResult:
    val (out, err, code) = process_run(cmd, args)
    if code != 0:
        return _err(reason: reason, out: out + err)
    _ok(out)

fn _fmt(key: text) -> text:
    "#" + "{" + key + "}"

fn _tmux(ws: AgentWorkspace, args: [text], reason: text) -> WorkspaceResult:
    _run(cmd: "tmux", args: ["-L", ws.socket] + args, reason: reason)

# `git worktree list` prints symlink-resolved paths; the root is canonicalised
# up front so `worktree_path` and `worktree_list` name the same tree the same
# way (a repo reached through a symlinked cwd otherwise never matches itself).
# `-m` resolves a root that does not exist yet; on failure the raw text stands.
fn _canonical(path: text) -> text:
    if path == "":
        return ""
    val (out, _e, code) = process_run("realpath", ["-m", path])
    if code != 0 or out.trim() == "":
        return path
    out.trim()

pub fn agent_workspace(id: text, repo: text, worktree_root: text) -> AgentWorkspace:
    AgentWorkspace(socket: "caret_ws_" + id, session: id, repo: repo,
        worktree_root: _canonical(worktree_root))

pub fn tmux_available() -> bool:
    val (_o, _e, code) = process_run("tmux", ["-V"])
    code == 0

# tmux stays the backend on every POSIX host. Windows has no tmux, and
# pane_backend selects smux there; the workspace then talks to a persistent
# smux owner process (one per workspace id), so separate CLI processes share
# one session.
fn _smux() -> bool:
    sosix_platform() == "windows" and pane_backend_name() == "smux"

pub fn workspace_backend() -> text:
    if _smux():
        return "smux"
    "tmux"

# Real availability, fail closed: tmux on POSIX; on Windows the pane shell
# (`sh`, which every agent pane runs) must be on PATH.
pub fn workspace_available() -> bool:
    if _smux():
        return sosix_which("sh") != ""
    tmux_available()

# --- smux owner client --------------------------------------------------------
val SMUX_TOKEN = "caret"
val SMUX_FIRST_WINDOW = "main"      # the owner bootstrap window; not an agent name
val SMUX_PANE_COLS = 500            # a line longer than this wraps in capture
val SMUX_PANE_ROWS = 50

struct WsPane:
    window_id: text
    pane_id: text
    title: text
    pid: i64
    target: text

fn _smux_port(session: text) -> i64:
    var h = 7
    for b in text_to_bytes(session):
        h = (h * 31 + b.to_i64()) % 20011
    30000 + h

fn _smux_addr(ws: AgentWorkspace) -> text:
    "127.0.0.1:" + _smux_port(ws.session).to_text()

# The owner reply, or nil when no owner answers.
fn _smux_req(ws: AgentWorkspace, command: text) -> text?:
    val r = smux_server_request(_smux_addr(ws), SMUX_TOKEN, command)
    if r.is_err():
        return nil
    r.unwrap()

fn _smux_req_ok(ws: AgentWorkspace, command: text) -> bool:
    val r = _smux_req(ws, command)
    r != nil and smux_remote_reply_ok(r ?? "")

# Start the owner (`smux_client --serve`) detached when none answers. SIMPLE_BINARY
# is cleared for it so panes that run `bin/simple test` are not pinned to the
# spec runner binary.
#
# Start-Process (ShellExecute) inherits NO handles. A plain process_spawn_async
# hands the owner this process's stdout/stderr, so a caller reading this CLI
# through a pipe (process_run) never sees EOF while the owner lives.
fn _smux_owner_up(ws: AgentWorkspace) -> bool:
    if _smux_req(ws, "list-sessions") != nil:
        return true
    # The spawn inherits this process environment: clear SIMPLE_BINARY for it, then restore.
    val pinned = env_get("SIMPLE_BINARY")
    env_set("SIMPLE_BINARY", "")
    val start = "Start-Process -WindowStyle Hidden -FilePath 'bin/simple.exe' -ArgumentList " +
        "'run','src/app/hosted_apps/smux_client.spl','--serve','" + _smux_addr(ws) + "','" + SMUX_TOKEN + "'"
    val (_o, _e, code) = process_run("powershell", ["-NoProfile", "-NonInteractive", "-Command", start])
    env_set("SIMPLE_BINARY", pinned)
    if code != 0:
        return false
    val deadline = current_time_ms() + 90000
    while current_time_ms() < deadline:
        if _smux_req(ws, "list-sessions") != nil:
            return true
        sleep_ms(500)
    false

fn _ws_panes(ws: AgentWorkspace) -> [WsPane]:
    var out: [WsPane] = []
    val r = _smux_req(ws, "pane-pids " + ws.session)
    if r == nil:
        return out
    var seen: [text] = []
    for line in (r ?? "").split("\n"):
        val f = line.trim().split(" ")
        if f.len() != 5 or f[4] != "1":
            continue
        var idx = 0
        for t in seen:
            if t == f[1]:
                idx = idx + 1
        seen.push(f[1])
        out.push(WsPane(window_id: f[0], pane_id: f[2], title: f[1], pid: int(f[3]) ?? 0,
            target: ws.session + ":" + f[1] + "." + idx.to_text()))
    out

# `session:name` means the first pane of `name`, as in tmux; nil when no such pane.
fn _ws_pane(ws: AgentWorkspace, target: text) -> WsPane?:
    for p in _ws_panes(ws):
        if p.target == target or p.target == target + ".0":
            return p
    nil

# Agent/window names go into targets and owner-protocol lines.
fn _valid_name(name: text) -> bool:
    if name == "" or name == SMUX_FIRST_WINDOW:
        return false
    for b in text_to_bytes(name):
        val c = b.to_i64()
        val ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95
        if not ok:
            return false
    true

# A pane whose shell starts in `cwd`, runs `command` (else stays interactive) and
# knows its own target through SMUX_PANE.
fn _smux_pane_spawn(ws: AgentWorkspace, title: text, cwd: text, command: text, reason: text) -> WorkspaceResult:
    if not _smux_owner_up(ws):
        return _err(reason: reason, out: "smux owner did not start")
    var idx = 0
    for p in _ws_panes(ws):
        if p.title == title:
            idx = idx + 1
    var body = "exec sh -i"
    if command != "":
        body = command
    # SIMPLE_BINARY unset: a pane `bin/simple test` must not be pinned to the
    # binary of whatever process started the owner.
    val script = "unset SIMPLE_BINARY; export SMUX_PANE=" + ws.session + ":" + title + "." + idx.to_text() + "; cd " + posix_quote_arg(cwd) + " && " + body
    val line = windows_spawn_command_line("sh", ["-c", script])
    val r = _smux_req(ws, "spawn-window " + ws.session + " " + title + " " + SMUX_PANE_COLS.to_text() + " " + SMUX_PANE_ROWS.to_text() + " " + line)
    if r == nil or not smux_remote_reply_ok(r ?? ""):
        return _err(reason: reason, out: r ?? "smux owner unavailable")
    _ok(r ?? "")

# --- sessions / windows / panes ---------------------------------------------

pub fn session_alive(ws: AgentWorkspace) -> bool:
    if _smux():
        val r = _smux_req(ws, "has-session " + ws.session)
        return r != nil and (r ?? "").starts_with("smux: session exists")
    _tmux(ws: ws, args: ["has-session", "-t", ws.session], reason: "no_session").status == "ok"

# Whether the workspace's server still answers at all (smux owner process or the
# private tmux server), independent of whether it holds the session.
pub fn workspace_server_alive(ws: AgentWorkspace) -> bool:
    if _smux():
        return _smux_req(ws, "list-sessions") != nil
    _tmux(ws: ws, args: ["list-sessions"], reason: "no_server").status == "ok"

pub fn session_ensure(ws: AgentWorkspace, cwd: text) -> WorkspaceResult:
    if session_alive(ws):
        return _ok("exists")
    if _smux():
        if not _smux_owner_up(ws):
            return _err(reason: "new_session_failed", out: "smux owner did not start")
        val r = _smux_req(ws, "new " + ws.session)
        if r == nil or not smux_remote_reply_ok(r ?? ""):
            return _err(reason: "new_session_failed", out: r ?? "smux owner unavailable")
        return _ok(r ?? "")
    _tmux(ws: ws, args: ["new-session", "-d", "-s", ws.session, "-c", cwd], reason: "new_session_failed")

pub fn session_kill(ws: AgentWorkspace) -> WorkspaceResult:
    if _smux():
        if not session_alive(ws):
            # An owner with no session is still ours to stop.
            val _stopped = _smux_req(ws, "stop-server")
            return _err(reason: "kill_server_failed", out: ws.session)
        val killed = _smux_req_ok(ws, "kill-session " + ws.session)
        val _stop = _smux_req(ws, "stop-server")
        if not killed:
            return _err(reason: "kill_server_failed", out: ws.session)
        return _ok("")
    # Only ever the private socket: `-L caret_ws_*` cannot name the user's server.
    _tmux(ws: ws, args: ["kill-server"], reason: "kill_server_failed")

# Exact-name probe. tmux allows duplicate window names and `-t session:name`
# matches by PREFIX, so neither new-window nor kill-window can tell us this.
pub fn window_exists(ws: AgentWorkspace, name: text) -> bool:
    if _smux():
        for p in _ws_panes(ws):
            if p.title == name:
                return true
        return false
    val r = _tmux(ws: ws, args: ["list-windows", "-t", ws.session, "-F", _fmt("window_name")], reason: "list_windows_failed")
    if r.status != "ok":
        return false
    for line in r.output.split("\n"):
        if line.trim() == name:
            return true
    false

pub fn window_open(ws: AgentWorkspace, name: text, cwd: text, command: text) -> WorkspaceResult:
    if _smux():
        if not _valid_name(name):
            return _err(reason: "invalid_name", out: name)
        return _smux_pane_spawn(ws, name, cwd, command, "new_window_failed")
    var args = ["new-window", "-d", "-t", ws.session, "-n", name, "-c", cwd]
    if command != "":
        args = args + [command]
    _tmux(ws: ws, args: args, reason: "new_window_failed")

pub fn pane_split(ws: AgentWorkspace, window: text, cwd: text) -> WorkspaceResult:
    if _smux():
        # tmux window 0 is the owner first window.
        var name = window
        if name == "0":
            name = SMUX_FIRST_WINDOW
        if not window_exists(ws, name):
            return _err(reason: "split_failed", out: window)
        return _smux_pane_spawn(ws, name, cwd, "", "split_failed")
    _tmux(ws, ["split-window", "-d", "-t", ws.session + ":" + window, "-c", cwd],
        "split_failed")

pub fn list_panes(ws: AgentWorkspace) -> [text]:
    list_panes_except(ws: ws, skip_pane_id: "")

# Every pane target except the one whose id (tmux `%N`, smux `session:name.i`)
# is `skip_pane_id`.
pub fn list_panes_except(ws: AgentWorkspace, skip_pane_id: text) -> [text]:
    if _smux():
        var mine: [text] = []
        for p in _ws_panes(ws):
            if skip_pane_id == "" or p.target != skip_pane_id:
                mine.push(p.target)
        return mine
    # `#{...}` inside a literal is string interpolation: build the tmux format by hand.
    val fmt = _fmt("session_name") + ":" + _fmt("window_name") + "." + _fmt("pane_index") + " " + _fmt("pane_id")
    val r = _tmux(ws, ["list-panes", "-s", "-t", ws.session, "-F", fmt], "list_panes_failed")
    if r.status != "ok":
        return []
    var panes: [text] = []
    for line in r.output.split("\n"):
        val parts = line.trim().split(" ")
        if parts.len() < 2:
            continue
        if skip_pane_id != "" and parts[1] == skip_pane_id:
            continue
        panes.push(parts[0])
    panes

# "<window> <pid>" per pane: the backend own report of each pane child pid
# (smux: the owner spawn pid; tmux: `#{pane_pid}`).
pub fn pane_pid_lines(ws: AgentWorkspace) -> [text]:
    var lines: [text] = []
    if _smux():
        for p in _ws_panes(ws):
            lines.push(p.title + " " + p.pid.to_text())
        return lines
    val fmt = _fmt("window_name") + " " + _fmt("pane_pid")
    val r = _tmux(ws, ["list-panes", "-s", "-t", ws.session, "-F", fmt], "list_panes_failed")
    for line in r.output.split("\n"):
        if line.trim() != "":
            lines.push(line.trim())
    lines

pub fn send_to_pane(ws: AgentWorkspace, target: text, command: text) -> WorkspaceResult:
    if _smux():
        val p = _ws_pane(ws, target)
        if p == nil:
            return _err(reason: "send_keys_failed", out: target)
        val pane = p ?? WsPane(window_id: "", pane_id: "", title: "", pid: 0, target: "")
        if not _smux_req_ok(ws, "send-pane " + ws.session + " " + pane.window_id + " " + pane.pane_id + " " + command):
            return _err(reason: "send_keys_failed", out: target)
        return _ok("")
    _tmux(ws, ["send-keys", "-t", target, command, "Enter"], "send_keys_failed")

# Send one command to EVERY pane of the session except the pane this process
# runs in (a broadcast must never type into its own shell). Returns the panes
# it reached.
pub fn send_to_each_pane(ws: AgentWorkspace, command: text) -> [text]:
    var reached: [text] = []
    for target in list_panes_except(ws, _own_pane_id()):
        if send_to_pane(ws: ws, target: target, command: command).status == "ok":
            reached.push(target)
    reached

pub fn capture_pane(ws: AgentWorkspace, target: text) -> text:
    if _smux():
        val p = _ws_pane(ws, target)
        if p == nil:
            return ""
        val pane = p ?? WsPane(window_id: "", pane_id: "", title: "", pid: 0, target: "")
        val _w = _smux_req(ws, "select-window " + ws.session + " " + pane.window_id)
        val _p = _smux_req(ws, "select-pane " + ws.session + " " + pane.pane_id)
        val h = _smux_req(ws, "history " + ws.session + " 2000")
        if h == nil:
            return ""
        val lines = (h ?? "").split("\n")
        if lines.len() > 0 and lines[0].starts_with("smux: history["):
            return lines.slice(1, lines.len()).join("\n")
        return h ?? ""
    _tmux(ws, ["capture-pane", "-p", "-J", "-S", "-", "-t", target], "capture_failed").output

# Poll a pane until `marker` shows up (send-keys is async). Bounded.
pub fn wait_for_pane_text(ws: AgentWorkspace, target: text, marker: text, timeout_ms: i64) -> bool:
    val deadline = current_time_ms() + timeout_ms
    while current_time_ms() < deadline:
        if capture_pane(ws: ws, target: target).contains(marker):
            return true
        sleep_ms(200)
    false

# --- worktrees (paths must be ABSOLUTE: `git -C repo` resolves relative paths against the repo) ---

pub fn worktree_path(ws: AgentWorkspace, agent_id: text) -> text:
    ws.worktree_root + "/" + agent_id

# Detached: this repo NEVER creates branches (CLAUDE.md).
pub fn worktree_add(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    val path = worktree_path(ws: ws, agent_id: agent_id)
    # "exists" only when git itself lists the path; a plain directory or file
    # there is the operator's and is neither claimed nor deleted.
    for registered in worktree_list(ws):
        if registered == path:
            return _ok("exists")
    if dir_exists(path) or file_exists(path):
        return _err(reason: "path_occupied", out: path)
    dir_create_all(ws.worktree_root)
    _run(cmd: "git", args: ["-C", ws.repo, "worktree", "add", "--detach", path], reason: "worktree_add_failed")

pub fn worktree_remove(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    val path = worktree_path(ws: ws, agent_id: agent_id)
    if not dir_exists(path):
        return _ok("absent")
    _run(cmd: "git", args: ["-C", ws.repo, "worktree", "remove", "--force", path], reason: "worktree_remove_failed")

pub fn worktree_list(ws: AgentWorkspace) -> [text]:
    val r = _run(cmd: "git", args: ["-C", ws.repo, "worktree", "list", "--porcelain"], reason: "worktree_list_failed")
    var paths: [text] = []
    for line in r.output.split("\n"):
        if line.starts_with("worktree "):
            paths.push(line.substring(9).trim())
    paths

# --- composite: one agent = one worktree + one pane --------------------------

pub fn agent_attach(ws: AgentWorkspace, agent_id: text, command: text) -> WorkspaceResult:
    # smux reserves the owner bootstrap window name, so it is never taken for an agent.
    if _smux() and not _valid_name(agent_id):
        return _err(reason: "invalid_name", out: agent_id)
    val wt = worktree_add(ws: ws, agent_id: agent_id)
    if wt.status != "ok":
        return wt
    val s = session_ensure(ws: ws, cwd: worktree_path(ws: ws, agent_id: agent_id))
    if s.status != "ok":
        return s
    if window_exists(ws: ws, name: agent_id):
        return _ok("exists")
    window_open(ws: ws, name: agent_id, cwd: worktree_path(ws: ws, agent_id: agent_id), command: with_depth(command))

# An agent that was never attached is an error and nothing is removed.
pub fn agent_detach(ws: AgentWorkspace, agent_id: text) -> WorkspaceResult:
    if not window_exists(ws: ws, name: agent_id):
        return _err(reason: "kill_window_failed", out: ws.session + ":" + agent_id)
    if _smux():
        for p in _ws_panes(ws):
            if p.title == agent_id and not _smux_req_ok(ws, "kill-window " + ws.session + " " + p.window_id):
                return _err(reason: "kill_window_failed", out: p.window_id)
    else:
        val k = _tmux(ws: ws, args: ["kill-window", "-t", ws.session + ":" + agent_id], reason: "kill_window_failed")
        if k.status != "ok":
            return k
    worktree_remove(ws: ws, agent_id: agent_id)

# Launch a caret spec suite in its own tmux window; `output` is the pane target.
# Refused (reason "recursion_limit") when this process is itself already a
# workspace-launched child.
pub fn launch_caret_suite(ws: AgentWorkspace, cwd: text, spec: text) -> WorkspaceResult:
    if depth_exceeded():
        return _err(reason: "recursion_limit", out: DEPTH_ENV + "=" + workspace_depth().to_text())
    val cmd = with_depth("SIMPLE_TIMEOUT_SECONDS=900 bin/simple test " + spec + " --no-session-daemon")
    val s = session_ensure(ws: ws, cwd: cwd)
    if s.status != "ok":
        return s
    val w = window_open(ws: ws, name: "caret_suite", cwd: cwd, command: "")
    if w.status != "ok":
        return w
    val target = ws.session + ":caret_suite"
    val sent = send_to_pane(ws: ws, target: target, command: cmd)
    if sent.status != "ok":
        return sent
    _ok(target)

export AgentWorkspace, WorkspaceResult
export agent_workspace, tmux_available, workspace_backend, workspace_available, pane_pid_lines,workspace_depth, depth_exceeded, with_depth,
    session_alive, session_ensure, session_kill, workspace_server_alive,
    window_exists, window_open, pane_split, list_panes, list_panes_except, send_to_pane, send_to_each_pane,
    capture_pane, wait_for_pane_text, worktree_path, worktree_add,
    worktree_remove, worktree_list, agent_attach, agent_detach, launch_caret_suite
