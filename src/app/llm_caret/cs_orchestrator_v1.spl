# Caret Suite (`/orchestrator`) client & server-launcher integration.
#
# Allows Caret Suite (`cs`) to start/stop Simple Orchestrator on the host using
# `host.sdn` -> `servers.sdn`, query status, and launch/inspect/relaunch/close
# containerized `agy` + worktree sessions through Simple Orchestrator.

use app.io.mod.{env_get, file_exists, dir_exists, dir_create_all,
    process_spawn_async_env, process_is_running, sleep_ms, cwd}
use std.nogc_async_mut.sosix.host_facade.{sosix_platform}
use std.nogc_sync_mut.container_session.macos_seatbelt_session_v1.{macos_seatbelt_canonical_path_v1}
use app.orchestrator.caret_session_protocol_v1.{orchestrator_caret_server_info_load_v1,
    orchestrator_caret_client_call_v1, orchestrator_caret_parse_dict_v1,
    orchestrator_caret_bool_v1, orchestrator_caret_str_v1}
use app.orchestrator.server_command_v1.{server_selection_v1, ServerSshRequestProgressV1,
    orchestrator_server_ssh_begin_file_v1, orchestrator_server_ssh_begin_v1, orchestrator_server_ssh_step_v1}
use app.orchestrator.reply_cleanup_v2.orchestrator_reply_cleanup_v2
use app.orchestrator.validation.OrchestratorValidationReplyV1
use app.llm_caret.workbench.remote_pane_control_v1.{CaretRemotePaneRouteV1, CaretRemotePaneTargetRequestV1,
    CaretRemotePaneTargetV1, caret_remote_pane_target_request_v1, caret_remote_pane_target_complete_v1, caret_remote_pane_from_attach_v1}
use app.llm_caret.workbench.remote_pane_view_v1.{CaretRemotePaneViewV1, CaretRemotePanePhaseV1, CaretRemotePaneScopeV1,
    caret_remote_pane_begin_v1, caret_remote_pane_retry_v1, caret_remote_pane_complete_v1, caret_remote_pane_server_matches_v1}
use std.common.config_core.server_context_types_v1.ResolvedServerV1
use std.nogc_sync_mut.sosix.host.file_read_regular_no_follow_bounded

enum CsOrchestratorRemotePurposeV1:
    Standard
    PaneTarget(request: CaretRemotePaneTargetRequestV1)
    PaneStream(scope: CaretRemotePaneScopeV1, source: text)

struct CsOrchestratorRemoteV1:
    session: text
    exchange: ServerSshRequestProgressV1
    purpose: CsOrchestratorRemotePurposeV1

struct CsOrchestratorRemoteCleanupV1:
    session: text
    reply: OrchestratorValidationReplyV1
    purpose: CsOrchestratorRemotePurposeV1

struct CsOrchestratorPaneTargetV1:
    session: text
    target: CaretRemotePaneTargetV1

struct CsOrchestratorPaneViewV1:
    session: text
    route: CaretRemotePaneRouteV1
    view: CaretRemotePaneViewV1
    visible: bool = true

# The dashboard thread owns the active exchange and its native cleanup.
var _cs_orch_remote_exchange_v1: Option<CsOrchestratorRemoteV1> = None
var _cs_orch_remote_cleanup_v1: Option<CsOrchestratorRemoteCleanupV1> = None
var _cs_orch_pane_target_v1: Option<CsOrchestratorPaneTargetV1> = None
var _cs_orch_pane_view_v1: Option<CsOrchestratorPaneViewV1> = None
var _cs_orch_runtime_dirs: Dict<text, text> = {}
var _cs_orch_config_args: Dict<text, text> = {}

pub fn cs_orchestrator_default_runtime_dir_v1(session: text) -> text:
    val explicit = env_get("SIMPLE_ORCHESTRATOR_RUNTIME_DIR") ?? ""
    if explicit != "":
        return macos_seatbelt_canonical_path_v1(explicit)
    var tmp = env_get("TMPDIR") ?? ""
    if tmp == "":
        tmp = "/tmp"
    if tmp.ends_with("/"):
        tmp = tmp.substring(0, tmp.byte_len() - 1)
    macos_seatbelt_canonical_path_v1(tmp + "/simple-orchestrator-cs-" + session)

pub fn cs_orchestrator_runtime_dir_v1(session: text) -> text:
    if _cs_orch_runtime_dirs.contains_key(session):
        return _cs_orch_runtime_dirs[session]
    cs_orchestrator_default_runtime_dir_v1(session)

fn _cs_orch_config_v1(session: text) -> text:
    if _cs_orch_config_args.contains_key(session):
        return _cs_orch_config_args[session]
    "-"

fn _cs_orch_find_main_spl_v1() -> text:
    val explicit = env_get("SIMPLE_ORCHESTRATOR_MAIN") ?? ""
    if explicit != "" and file_exists(explicit):
        return explicit
    val lib_dir = env_get("SIMPLE_LIB") ?? ""
    if lib_dir != "":
        val under_lib = lib_dir + "/app/orchestrator/main.spl"
        if file_exists(under_lib):
            return under_lib
        val slash = lib_dir.last_index_of("/")
        if slash > 0:
            val sibling = lib_dir.substring(0, slash) + "/src/app/orchestrator/main.spl"
            if file_exists(sibling):
                return sibling
    val local_main = cwd() + "/src/app/orchestrator/main.spl"
    if file_exists(local_main):
        return local_main
    ""

fn _cs_orch_resolve_spawn_v1(extra_args: [text]) -> Result<(text, [text]), text>:
    val orch_bin = env_get("SIMPLE_ORCHESTRATOR_BINARY") ?? ""
    if orch_bin != "" and file_exists(orch_bin):
        return Ok((orch_bin, ["caret-serve"] + extra_args))
    val orch_main = _cs_orch_find_main_spl_v1()
    val simple_bin = env_get("SIMPLE_BINARY") ?? ""
    if simple_bin != "" and file_exists(simple_bin):
        if orch_main != "":
            return Ok((simple_bin, [orch_main, "caret-serve"] + extra_args))
        return Ok((simple_bin, ["orchestrator", "caret-serve"] + extra_args))
    for candidate in [cwd() + "/bin/simple", "bin/simple"]:
        if file_exists(candidate):
            if orch_main != "":
                return Ok((candidate, [orch_main, "caret-serve"] + extra_args))
            return Ok((candidate, ["orchestrator", "caret-serve"] + extra_args))
    Err("no Simple or Orchestrator binary found (set SIMPLE_BINARY or SIMPLE_ORCHESTRATOR_BINARY)")

pub fn cs_orchestrator_start_v1(session: text, words: [text]) -> text:
    var runtime_dir = cs_orchestrator_runtime_dir_v1(session)
    var config_arg = _cs_orch_config_v1(session)
    var controller_id = "caret-controller-" + session
    var i = 0
    while i < words.len():
        if words[i] == "--runtime-dir" and i + 1 < words.len():
            runtime_dir = macos_seatbelt_canonical_path_v1(words[i + 1])
            i = i + 2
            continue
        if words[i] == "--config" and i + 1 < words.len():
            config_arg = words[i + 1]
            i = i + 2
            continue
        if words[i] == "--controller-id" and i + 1 < words.len():
            controller_id = words[i + 1]
            i = i + 2
            continue
        i = i + 1
    _cs_orch_runtime_dirs[session] = runtime_dir
    _cs_orch_config_args[session] = config_arg
    match orchestrator_caret_server_info_load_v1(runtime_dir):
        case Ok(existing):
            if existing.pid > 0 and process_is_running(existing.pid):
                match orchestrator_caret_client_call_v1(runtime_dir, config_arg, "status", "", []):
                    case Ok(_):
                        return ("orchestrator already running at " + existing.listen_addr +
                            " (controller " + existing.controller_id + ")")
                    case Err(_): pass
        case Err(_): pass
    dir_create_all(runtime_dir)
    val serve_args = ["--runtime-dir", runtime_dir, "--config", config_arg,
        "--controller-id", controller_id, "--session", session + "-orch"]
    val resolved = match _cs_orch_resolve_spawn_v1(serve_args):
        case Ok(pair): pair
        case Err(reason): return "orchestrator start failed: " + reason
    val orch_bin = env_get("SIMPLE_ORCHESTRATOR_BINARY") ?? ""
    val use_source_entry = orch_bin == "" or not file_exists(orch_bin)
    val repo_root_env = env_get("SIMPLE_CS_REPO_ROOT") ?? ""
    var child_env: {text: text} = {
        "SIMPLE_RUST_SEED_WARNING": "0",
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_CS_REPO_ROOT": (if repo_root_env != "": repo_root_env else: cwd())
    }
    for key in ["PATH", "HOME", "TMPDIR", "USER", "TERM", "SIMPLE_LIB", "SIMPLE_BINARY",
            "SIMPLE_ORCHESTRATOR_BINARY", "SIMPLE_ORCHESTRATOR_MAIN",
            "SIMPLE_EXECUTION_MODE",
            "SIMPLE_HOST_CONFIG", "SIMPLE_SERVERS_CONFIG", "SIMPLE_SERVERS_SDN",
            "SIMPLE_CONTAINER_SESSION_ROOT", "CS_PANE_BACKEND"]:
        val v = env_get(key) ?? ""
        if v != "":
            child_env[key] = v
    if use_source_entry and not child_env.contains_key("SIMPLE_EXECUTION_MODE"):
        child_env["SIMPLE_EXECUTION_MODE"] = "interpreter"
    val pid = if sosix_platform() != "windows":
        process_spawn_async_env("/bin/sh",
            ["-c", "exec \"$@\" </dev/null >/dev/null 2>&1", "sh", resolved.0] + resolved.1,
            child_env)
    else:
        process_spawn_async_env(resolved.0, resolved.1, child_env)
    if pid <= 0:
        return "orchestrator start failed: spawn returned " + pid.to_text()
    var waited_ms = 0
    while waited_ms < 120000:
        match orchestrator_caret_client_call_v1(runtime_dir, config_arg, "status", "", []):
            case Ok(reply):
                match orchestrator_caret_parse_dict_v1(reply):
                    case Ok(d):
                        if orchestrator_caret_bool_v1(d, "ok"):
                            return ("orchestrator started pid=" + pid.to_text() +
                                " addr=" + orchestrator_caret_str_v1(d, "listenAddr") +
                                " controller=" + orchestrator_caret_str_v1(d, "controllerId") +
                                " server=" + orchestrator_caret_str_v1(d, "serverName"))
                    case Err(_): pass
            case Err(_): pass
        if not process_is_running(pid):
            return "orchestrator server process exited during startup (pid=" + pid.to_text() + ")"
        sleep_ms(250)
        waited_ms = waited_ms + 250
    "orchestrator start timed out waiting for server readiness in " + runtime_dir

fn cs_orchestrator_remote_cleanup_v1(session: text, reply: OrchestratorValidationReplyV1,
        purpose: CsOrchestratorRemotePurposeV1) -> OrchestratorValidationReplyV1:
    val cleaned = orchestrator_reply_cleanup_v2(reply)
    if (cleaned.transport_cleanup.is_some() or cleaned.transport_store_cleanup.is_some() or cleaned.transport_exit_unconfirmed):
        val custody = OrchestratorValidationReplyV1(exit_code: 2, output: "",
            transport_cleanup: cleaned.transport_cleanup, transport_store_cleanup: cleaned.transport_store_cleanup,
            transport_exit_unconfirmed: cleaned.transport_exit_unconfirmed)
        _cs_orch_remote_cleanup_v1 = Some(CsOrchestratorRemoteCleanupV1(session, custody, purpose))
    else:
        _cs_orch_remote_cleanup_v1 = None
    cleaned

fn cs_orchestrator_pane_finish_v1(session: text, scope: CaretRemotePaneScopeV1, source: text,
        reply: OrchestratorValidationReplyV1) -> text:
    if val active = _cs_orch_pane_view_v1:
        if active.session != session: return "remote pane view owner differs"
        val updated = caret_remote_pane_complete_v1(active.view, scope, source, reply)
        if updated.is_err(): return "remote pane reply refused: " + updated.unwrap_err()
        val view = updated.unwrap()
        _cs_orch_pane_view_v1 = Some(CsOrchestratorPaneViewV1(session, active.route, view, active.visible))
        return match view.phase:
            case CaretRemotePanePhaseV1.Unconfirmed: "remote pane outcome unconfirmed; use /orchestrator pane-retry"
            case CaretRemotePanePhaseV1.Refused: "remote pane refused: " + view.problem
            case CaretRemotePanePhaseV1.Eof: "remote pane reached EOF"
            case _: if view.last_read_id == 0: "remote pane read-only view opened" else: "remote pane read completed"
    "remote pane view is unavailable"

fn cs_orchestrator_remote_finished_v1(session: text, purpose: CsOrchestratorRemotePurposeV1,
        reply: OrchestratorValidationReplyV1) -> text:
    match purpose:
        case CsOrchestratorRemotePurposeV1.Standard: reply.output.trim()
        case CsOrchestratorRemotePurposeV1.PaneTarget(request):
            if _cs_orch_remote_cleanup_v1.is_some(): return "remote pane target transport cleanup is pending"
            if reply.exit_code != 0: return "remote pane target unconfirmed"
            val target = caret_remote_pane_target_complete_v1(request, reply.output)
            if target.is_err(): return "remote pane target receipt refused: " + target.unwrap_err()
            _cs_orch_pane_target_v1 = Some(CsOrchestratorPaneTargetV1(session, target.unwrap()))
            target.unwrap().receipt
        case CsOrchestratorRemotePurposeV1.PaneStream(scope, source):
            if _cs_orch_remote_cleanup_v1.is_some(): return "remote pane transport cleanup is pending"
            cs_orchestrator_pane_finish_v1(session, scope, source, reply)

fn cs_orchestrator_accept_remote_v1(session: text, progress: ServerSshRequestProgressV1,
        purpose: CsOrchestratorRemotePurposeV1 = CsOrchestratorRemotePurposeV1.Standard) -> text:
    if val completed = progress.reply:
        _cs_orch_remote_exchange_v1 = None
        val cleaned = cs_orchestrator_remote_cleanup_v1(session, completed, purpose)
        return cs_orchestrator_remote_finished_v1(session, purpose, cleaned)
    _cs_orch_remote_exchange_v1 = Some(CsOrchestratorRemoteV1(session, progress, purpose))
    ""

pub fn cs_orchestrator_remote_poll_v1(session: text, cancel: bool = false) -> text:
    if val active = _cs_orch_remote_exchange_v1:
        if active.session != session: return ""
        return cs_orchestrator_accept_remote_v1(session, orchestrator_server_ssh_step_v1(active.exchange, cancel), active.purpose)
    if val pending = _cs_orch_remote_cleanup_v1:
        if pending.session == session and not pending.reply.transport_exit_unconfirmed:
            val cleaned = cs_orchestrator_remote_cleanup_v1(session, pending.reply, pending.purpose)
            if _cs_orch_remote_cleanup_v1.is_none():
                match pending.purpose:
                    case CsOrchestratorRemotePurposeV1.Standard: ()
                    case _: return cs_orchestrator_remote_finished_v1(session, pending.purpose, cleaned)
    ""

pub fn cs_orchestrator_remote_close_v1(session: text) -> text:
    var attempts = 0
    while attempts < 101:
        val active = _cs_orch_remote_exchange_v1
        val cleanup = _cs_orch_remote_cleanup_v1
        if active.is_none() and cleanup.is_none():
            cs_orchestrator_pane_clear_v1(session)
            return ""
        if active.is_some() and active.unwrap().session != session: return ""
        if cleanup.is_some():
            if cleanup.unwrap().session != session: return ""
            if cleanup.unwrap().reply.transport_exit_unconfirmed: break
        val _result = cs_orchestrator_remote_poll_v1(session, true)
        attempts = attempts + 1
    if _cs_orch_remote_exchange_v1.is_none() and _cs_orch_remote_cleanup_v1.is_none():
        cs_orchestrator_pane_clear_v1(session)
        return ""
    "orchestrator remote cleanup remains unconfirmed"

fn cs_orchestrator_remote_v1(session: text, args: [text]) -> text:
    if args.len() != 5 or args.contains(""):
        return "usage: /orchestrator remote <config|-> <context|-> <server|-> <profile> <request.sdn>"
    if _cs_orch_remote_exchange_v1.is_some(): return "orchestrator remote request is already pending"
    if _cs_orch_remote_cleanup_v1.is_some(): return "orchestrator remote transport cleanup is pending"
    val config = if args[0] == "-": _cs_orch_config_v1(session) else: args[0]
    val selected = server_selection_v1(["server-resolve", config, "caret", args[1], args[2], "host"])
    if selected.is_err(): return "orchestrator remote selection failed: " + selected.unwrap_err()
    val server = selected.unwrap()
    if server.record.transport != "ssh": return "orchestrator remote requires an SSH server"
    val turn = orchestrator_server_ssh_begin_file_v1(server, args[3], args[4])
    val result = cs_orchestrator_accept_remote_v1(session, turn)
    if result == "" and _cs_orch_remote_exchange_v1.is_some(): return "orchestrator remote request is pending"
    result

fn cs_orchestrator_pane_clear_v1(session: text):
    if val active = _cs_orch_pane_view_v1:
        if active.session == session: _cs_orch_pane_view_v1 = None
    if val target = _cs_orch_pane_target_v1:
        if target.session == session: _cs_orch_pane_target_v1 = None

fn cs_orchestrator_pane_selection_v1(route: CaretRemotePaneRouteV1) -> Result<ResolvedServerV1, text>:
    server_selection_v1(["server-resolve", route.config, "caret", route.context, route.server_name, "host"])

fn cs_orchestrator_pane_target_v1(session: text, args: [text]) -> text:
    if args.len() != 5 or args.contains(""):
        return "usage: /orchestrator pane-target <config|-> <context|-> <server|-> <profile> <request.sdn>"
    if val active = _cs_orch_pane_view_v1:
        if active.session != session or active.visible:
            return "close the remote pane view before selecting another target"
    val config = if args[0] == "-": _cs_orch_config_v1(session) else: args[0]
    val route = CaretRemotePaneRouteV1(config, args[1], args[2], args[3])
    val selected = cs_orchestrator_pane_selection_v1(route)
    if selected.is_err(): return "remote pane selection refused: " + selected.unwrap_err()
    val source = file_read_regular_no_follow_bounded(args[4], 2097152)
    if source.is_err(): return "remote pane target request unavailable"
    val request = caret_remote_pane_target_request_v1(route, selected.unwrap(), source.unwrap())
    if request.is_err(): return "remote pane target request refused: " + request.unwrap_err()
    if val hidden = _cs_orch_pane_view_v1:
        if hidden.view.scope.controller_id == request.unwrap().controller_id and
                hidden.view.scope.operation_id == request.unwrap().operation_id:
            return "use pane-view to reopen the retained cursor for this run"
        _cs_orch_pane_view_v1 = None
    _cs_orch_pane_target_v1 = None
    val result = cs_orchestrator_accept_remote_v1(session, orchestrator_server_ssh_begin_v1(selected.unwrap(),
        route.profile_path, request.unwrap().source), CsOrchestratorRemotePurposeV1.PaneTarget(request.unwrap()))
    if result == "": "remote pane target request is pending" else: result

fn cs_orchestrator_pane_send_v1(session: text, route: CaretRemotePaneRouteV1, selected: ResolvedServerV1,
        pending: CaretRemotePaneViewV1) -> text:
    val source = pending.outstanding.unwrap().source
    _cs_orch_pane_view_v1 = Some(CsOrchestratorPaneViewV1(session, route, pending))
    var observed = pending.scope
    observed.server = selected
    val result = cs_orchestrator_accept_remote_v1(session,
        orchestrator_server_ssh_begin_v1(selected, route.profile_path, source),
        CsOrchestratorRemotePurposeV1.PaneStream(observed, source))
    if result == "": "remote pane request is pending" else: result

fn cs_orchestrator_pane_open_v1(session: text, args: [text]) -> text:
    if args.len() != 1: return "usage: /orchestrator pane-view <signed-attach-frame.sdn>"
    if val active = _cs_orch_pane_view_v1:
        if active.session != session or active.visible: return "close the current remote pane view first"
    if val kept = _cs_orch_pane_target_v1:
        if kept.session != session: return "select a remote pane target in this session first"
        val route = kept.target.request.route
        val selected = cs_orchestrator_pane_selection_v1(route)
        if selected.is_err(): return "remote pane selection refused: " + selected.unwrap_err()
        val attach = file_read_regular_no_follow_bounded(args[0], 1048576)
        if attach.is_err(): return "signed remote pane attach frame unavailable"
        val view = caret_remote_pane_from_attach_v1(kept.target, selected.unwrap(), attach.unwrap())
        if view.is_err(): return "remote pane view refused: " + view.unwrap_err()
        if val hidden = _cs_orch_pane_view_v1:
            if hidden.view.scope.attach_digest != view.unwrap().scope.attach_digest:
                return "remote pane attach frame changed"
            _cs_orch_pane_view_v1 = Some(CsOrchestratorPaneViewV1(session, hidden.route, hidden.view, true))
            return "remote pane read-only view reopened"
        val pending = caret_remote_pane_begin_v1(view.unwrap())
        if pending.is_err(): return "remote pane claim refused: " + pending.unwrap_err()
        return cs_orchestrator_pane_send_v1(session, route, selected.unwrap(), pending.unwrap())
    "select a remote pane target in this session first"

fn cs_orchestrator_pane_command_v1(session: text, action: text, args: [text]) -> text:
    if _cs_orch_remote_exchange_v1.is_some(): return "orchestrator remote request is already pending"
    if _cs_orch_remote_cleanup_v1.is_some(): return "orchestrator remote transport cleanup is pending"
    if action == "pane-target": return cs_orchestrator_pane_target_v1(session, args)
    if action == "pane-view": return cs_orchestrator_pane_open_v1(session, args)
    if args.len() != 0: return "usage: /orchestrator " + action
    if action == "pane-close":
        if val active = _cs_orch_pane_view_v1:
            if active.session == session and active.visible:
                if active.view.stream_epoch < 0 and active.view.phase == CaretRemotePanePhaseV1.Refused:
                    # A closed pre-claim refusal issued no stream cursor.
                    _cs_orch_pane_view_v1 = None
                else:
                    _cs_orch_pane_view_v1 = Some(CsOrchestratorPaneViewV1(session, active.route, active.view, false))
                return "remote pane view closed"
        return "no remote pane view is open"
    if val active = _cs_orch_pane_view_v1:
        if active.session != session or not active.visible: return "open a remote pane view in this session first"
        val selected = cs_orchestrator_pane_selection_v1(active.route)
        if selected.is_err(): return "remote pane selection refused: " + selected.unwrap_err()
        if not caret_remote_pane_server_matches_v1(active.view.scope.server, selected.unwrap()):
            return "remote pane endpoint changed"
        val pending = if action == "pane-retry": caret_remote_pane_retry_v1(active.view)
            else: caret_remote_pane_begin_v1(active.view)
        if pending.is_err(): return "remote pane request refused: " + pending.unwrap_err()
        return cs_orchestrator_pane_send_v1(session, active.route, selected.unwrap(), pending.unwrap())
    "open a remote pane view in this session first"

pub fn cs_orchestrator_pane_visible_v1(session: text) -> bool:
    if val active = _cs_orch_pane_view_v1: return active.session == session and active.visible
    false

pub fn cs_orchestrator_pane_surface_v1(session: text) -> Option<[text]>:
    if val active = _cs_orch_pane_view_v1:
        if active.session != session or not active.visible: return None
        val view = active.view
        val status = match view.phase:
            case CaretRemotePanePhaseV1.Pending: "waiting for reply"
            case CaretRemotePanePhaseV1.Unconfirmed: "unconfirmed; pane-retry reuses the same request"
            case CaretRemotePanePhaseV1.Refused: view.problem
            case CaretRemotePanePhaseV1.Eof: "EOF"
            case _: "pane-read requests the next output"
        val heading = "REMOTE PANE (read-only) " + view.scope.operation_id
        val output = view.transcript.join("")
        if output == "": return Some([heading, status])
        val lines = output.split("\n")
        val start = if lines.len() > 200: lines.len() - 200 else: 0
        return Some([heading, status] + lines.slice(start, lines.len()))
    None

fn cs_orchestrator_remote_control_v1(session: text, action: text, args: [text]) -> text:
    if args.len() != 0: return "usage: /orchestrator " + action
    val result = cs_orchestrator_remote_poll_v1(session, action == "remote-cancel")
    if result != "": return result
    if val pending = _cs_orch_remote_exchange_v1:
        if pending.session == session: return "orchestrator remote request is pending"
    if val cleanup = _cs_orch_remote_cleanup_v1:
        if cleanup.session == session: return "orchestrator remote transport cleanup is pending"
    "no pending orchestrator remote request"

pub fn cs_orchestrator_dispatch_v1(session: text, sub_words: [text]) -> text:
    if sub_words.len() == 0 or sub_words[0] == "help":
        return ("/orchestrator start [--runtime-dir <dir>] [--config <file|->]\n" +
            "/orchestrator status | crashed | stop\n" +
            "/orchestrator remote <config|-> <context|-> <server|-> <profile> <request.sdn>\n" +
            "/orchestrator remote-progress | remote-cancel\n" +
            "/orchestrator pane-target <config|-> <context|-> <server|-> <profile> <request.sdn>\n" +
            "/orchestrator pane-view <signed-attach-frame.sdn> | pane-read | pane-retry | pane-close\n" +
            "/orchestrator launch <spec> [--container <img|macos-seatbelt>] [--worktree] [args...]\n" +
            "/orchestrator inspect [id] | send <id> <msg> | relaunch <id> [args...] | close <id>\n" +
            "/orchestrator cleanup <id>  Remove one crashed agent's worktree and artifacts\n" +
            "/orchestrator cleanup-old [--apply]  Preview artifacts older than one hour. --apply removes eligible artifacts.")
    val sub = sub_words[0]
    var tail: [text] = []
    var i = 1
    while i < sub_words.len():
        tail.push(sub_words[i])
        i = i + 1
    if sub == "start":
        return cs_orchestrator_start_v1(session, tail)
    if sub == "remote":
        return cs_orchestrator_remote_v1(session, tail)
    if sub == "remote-progress" or sub == "remote-cancel":
        return cs_orchestrator_remote_control_v1(session, sub, tail)
    if ["pane-target", "pane-view", "pane-read", "pane-retry", "pane-close"].contains(sub):
        return cs_orchestrator_pane_command_v1(session, sub, tail)
    val runtime_dir = cs_orchestrator_runtime_dir_v1(session)
    val config_arg = _cs_orch_config_v1(session)
    val action = if sub == "stop": "shutdown" else: sub
    if not ["status", "launch", "inspect", "send", "crashed", "relaunch", "close", "cleanup", "cleanup-old", "shutdown"].contains(action):
        return "unknown /orchestrator subcommand '" + sub + "': try /orchestrator help"
    if action == "cleanup" and tail.len() != 1:
        return "usage: /orchestrator cleanup <id>"
    if action == "cleanup-old" and (tail.len() > 1 or (tail.len() == 1 and tail[0] != "--apply")):
        return "usage: /orchestrator cleanup-old [--apply]"
    var target = ""
    var args: [text] = []
    if ["inspect", "close", "cleanup", "relaunch", "send"].contains(action):
        if tail.len() > 0:
            target = tail[0]
            var j = 1
            while j < tail.len():
                args.push(tail[j])
                j = j + 1
    else:
        args = tail
    if ["close", "cleanup", "relaunch", "send"].contains(action) and target == "":
        return "/orchestrator " + sub + " needs an agent or container id"
    if action == "launch" and args.len() == 0:
        return "/orchestrator launch needs a harness spec (e.g. agy --container macos-seatbelt --worktree)"
    match orchestrator_caret_client_call_v1(runtime_dir, config_arg, action, target, args):
        case Err(reason): "orchestrator client error: " + reason
        case Ok(reply):
            if action == "shutdown":
                var wait_ms = 0
                while wait_ms < 5000 and file_exists(runtime_dir + "/server.sdn"):
                    sleep_ms(100)
                    wait_ms = wait_ms + 100
            reply.trim()

export cs_orchestrator_default_runtime_dir_v1, cs_orchestrator_runtime_dir_v1
export cs_orchestrator_start_v1, cs_orchestrator_dispatch_v1
export cs_orchestrator_remote_poll_v1, cs_orchestrator_remote_close_v1
export cs_orchestrator_pane_visible_v1, cs_orchestrator_pane_surface_v1
