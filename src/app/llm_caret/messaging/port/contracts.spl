"""Transport-neutral port contracts. Adapters implement these traits."""

use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{AgentBinding, RoomMessage}

trait ChatTransportPort:
    fn capabilities(self) -> TransportCapabilities
    me connect(self, binding_id: text) -> text
    me send(self, binding_id: text, message: RoomMessage, idempotency_key: text) -> text
    me mark_read(self, binding_id: text, external_message_id: text) -> text
    me open_private(self, binding_id: text, identity_ids: [text]) -> text

trait AgentControlPort:
    fn capabilities(self) -> [text]
    fn attach(self, binding: AgentBinding) -> text
    fn resume(self, session_id: text) -> text
    fn inject_context(self, session_id: text, context_manifest_id: text) -> text
    fn submit(self, session_id: text, message: RoomMessage) -> text
    fn steer(self, session_id: text, message: RoomMessage) -> text
    fn cancel(self, session_id: text, task_id: text) -> text
    fn close(self, session_id: text) -> text

trait MessageStorePort:
    fn append_message(self, message: RoomMessage, idempotency_key: text) -> text
    fn message_history(self, room_id: text, after_seq: i64, limit: i64) -> [RoomMessage]
    fn advance_cursor(self, room_id: text, identity_id: text, room_seq: i64) -> text

export ChatTransportPort, AgentControlPort, MessageStorePort
