"""Execution policy for the pure-Simple messaging database hot path.

PureDatabase remains the only database implementation.  This policy selects a
cached compiled carrier for production, including when the caller itself was
started with the interpreter.
"""

enum DatabaseArtifactKind:
    SmfLibrary
    NativeExecutable
    InterpretedSource

struct DatabaseExecutionPlan:
    kind: DatabaseArtifactKind
    artifact_path: text
    source_path: text
    requires_fresh_artifact: bool
    reason: text

struct DatabaseCarrierCommand:
    command: text
    args: [text]

fn default_database_execution_plan(prefer_executable: bool) -> DatabaseExecutionPlan:
    if prefer_executable:
        return DatabaseExecutionPlan(
            kind: DatabaseArtifactKind.NativeExecutable,
            artifact_path: "build/database/llm_caret_messaging_db",
            source_path: "src/app/llm_caret/messaging/database_worker.spl",
            requires_fresh_artifact: true,
            reason: "cached_native_database_hot_path"
        )
    DatabaseExecutionPlan(
        kind: DatabaseArtifactKind.SmfLibrary,
        artifact_path: "build/database/llm_caret_messaging_db.smf",
        source_path: "src/app/llm_caret/messaging/database_worker.spl",
        requires_fresh_artifact: true,
        reason: "cached_smf_database_hot_path"
    )

fn default_messaging_mcp_execution_plan(prefer_executable: bool) -> DatabaseExecutionPlan:
    if prefer_executable:
        return DatabaseExecutionPlan(
            kind: DatabaseArtifactKind.NativeExecutable,
            artifact_path: "build/database/llm_caret_messaging_mcp",
            source_path: "src/app/llm_caret/messaging/mcp_worker.spl",
            requires_fresh_artifact: true,
            reason: "compiled_mcp_and_database_hot_path"
        )
    DatabaseExecutionPlan(
        kind: DatabaseArtifactKind.SmfLibrary,
        artifact_path: "build/database/llm_caret_messaging_mcp.smf",
        source_path: "src/app/llm_caret/messaging/mcp_worker.spl",
        requires_fresh_artifact: true,
        reason: "compiled_smf_mcp_and_database_hot_path"
    )

fn default_messaging_hook_execution_plan(prefer_executable: bool) -> DatabaseExecutionPlan:
    if prefer_executable:
        return DatabaseExecutionPlan(kind: DatabaseArtifactKind.NativeExecutable,
            artifact_path: "build/database/llm_caret_messaging_hook",
            source_path: "src/app/llm_caret/messaging/hook_worker.spl",
            requires_fresh_artifact: true, reason: "compiled_hook_database_hot_path")
    DatabaseExecutionPlan(kind: DatabaseArtifactKind.SmfLibrary,
        artifact_path: "build/database/llm_caret_messaging_hook.smf",
        source_path: "src/app/llm_caret/messaging/hook_worker.spl",
        requires_fresh_artifact: true, reason: "compiled_smf_hook_database_hot_path")

fn default_messaging_bridge_execution_plan(prefer_executable: bool) -> DatabaseExecutionPlan:
    if prefer_executable:
        return DatabaseExecutionPlan(kind: DatabaseArtifactKind.NativeExecutable,
            artifact_path: "build/database/llm_caret_messaging_bridge",
            source_path: "src/app/llm_caret/messaging/bridge_worker.spl",
            requires_fresh_artifact: true, reason: "compiled_bridge_database_hot_path")
    DatabaseExecutionPlan(kind: DatabaseArtifactKind.SmfLibrary,
        artifact_path: "build/database/llm_caret_messaging_bridge.smf",
        source_path: "src/app/llm_caret/messaging/bridge_worker.spl",
        requires_fresh_artifact: true, reason: "compiled_smf_bridge_database_hot_path")

fn default_messaging_server_execution_plan(prefer_executable: bool) -> DatabaseExecutionPlan:
    if prefer_executable:
        return DatabaseExecutionPlan(kind: DatabaseArtifactKind.NativeExecutable,
            artifact_path: "build/database/llm_caret_messaging_server",
            source_path: "src/app/llm_caret/messaging/server_worker.spl",
            requires_fresh_artifact: true, reason: "compiled_server_database_hot_path")
    DatabaseExecutionPlan(kind: DatabaseArtifactKind.SmfLibrary,
        artifact_path: "build/database/llm_caret_messaging_server.smf",
        source_path: "src/app/llm_caret/messaging/server_worker.spl",
        requires_fresh_artifact: true, reason: "compiled_smf_server_database_hot_path")

fn interpreter_fallback_plan(allow_slow_diagnostics: bool) -> DatabaseExecutionPlan:
    if allow_slow_diagnostics:
        return DatabaseExecutionPlan(
            kind: DatabaseArtifactKind.InterpretedSource,
            artifact_path: "",
            source_path: "src/app/llm_caret/messaging/database_worker.spl",
            requires_fresh_artifact: false,
            reason: "explicit_diagnostic_fallback"
        )
    default_database_execution_plan(true)

fn database_should_use_compiled_carrier(caller_is_interpreted: bool,
        explicit_slow_diagnostic: bool) -> bool:
    # The caller's execution mode never selects the database hot path.  An
    # interpreted caller still uses the cached carrier unless a developer has
    # explicitly requested the slow diagnostic path.
    not explicit_slow_diagnostic

fn database_artifact_build_command(plan: DatabaseExecutionPlan, simple_binary: text) -> DatabaseCarrierCommand:
    match plan.kind:
        DatabaseArtifactKind.SmfLibrary:
            DatabaseCarrierCommand(command: simple_binary,
                args: ["compile", plan.source_path, "-o", plan.artifact_path])
        DatabaseArtifactKind.NativeExecutable:
            DatabaseCarrierCommand(command: simple_binary,
                args: ["native-build", "--source", "src/app", "--source", "src/lib",
                    "--entry-closure", "--entry", plan.source_path,
                    "--strip", "--output", plan.artifact_path])
        DatabaseArtifactKind.InterpretedSource:
            DatabaseCarrierCommand(command: "", args: [])

fn database_artifact_run_command(plan: DatabaseExecutionPlan, simple_binary: text,
        worker_args: [text]) -> DatabaseCarrierCommand:
    match plan.kind:
        DatabaseArtifactKind.SmfLibrary:
            DatabaseCarrierCommand(command: simple_binary, args: ["run", plan.artifact_path] + worker_args)
        DatabaseArtifactKind.NativeExecutable:
            DatabaseCarrierCommand(command: plan.artifact_path, args: worker_args)
        DatabaseArtifactKind.InterpretedSource:
            DatabaseCarrierCommand(command: simple_binary, args: ["run", plan.source_path] + worker_args)

export DatabaseArtifactKind, DatabaseExecutionPlan, DatabaseCarrierCommand
export default_database_execution_plan, default_messaging_mcp_execution_plan
export default_messaging_hook_execution_plan, interpreter_fallback_plan
export default_messaging_bridge_execution_plan
export default_messaging_server_execution_plan
export database_should_use_compiled_carrier
export database_artifact_build_command, database_artifact_run_command
