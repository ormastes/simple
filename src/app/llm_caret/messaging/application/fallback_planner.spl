"""Platform-neutral native/emulated/primitive-sidecar fallback decisions."""

use app.llm_caret.messaging.domain.capability.{CapabilityLevel, TransportCapabilities, capability_level_name}

enum TransportOperation:
    CreateRoom
    OpenPrivate
    UseThread
    Reply
    MarkRead
    NotifyAll
    ReadHistory

struct FallbackDecision:
    accepted: bool
    execution: text
    evidence: text
    error: text

fn operation_level(caps: TransportCapabilities, operation: TransportOperation) -> CapabilityLevel:
    match operation:
        case TransportOperation.CreateRoom: caps.room_create
        case TransportOperation.OpenPrivate: caps.private_message
        case TransportOperation.UseThread: caps.thread
        case TransportOperation.Reply: caps.reply
        case TransportOperation.MarkRead: caps.mark_read
        case TransportOperation.NotifyAll: caps.notify_all
        case TransportOperation.ReadHistory: caps.history_read

fn plan_transport_operation(caps: TransportCapabilities, operation: TransportOperation) -> FallbackDecision:
    val level = operation_level(caps, operation)
    match level:
        case CapabilityLevel.Native:
            FallbackDecision(accepted: true, execution: "native_transport", evidence: "native", error: "")
        case CapabilityLevel.Emulated:
            FallbackDecision(accepted: true, execution: "transport_emulation", evidence: "synthetic", error: "")
        case CapabilityLevel.PrimitiveSidecar:
            FallbackDecision(accepted: true, execution: "primitive_shadow_room", evidence: "local_cursor", error: "")
        case CapabilityLevel.Unsupported:
            FallbackDecision(accepted: false, execution: "reject", evidence: "unknown",
                error: "capability_not_supported:" + capability_level_name(level))

export TransportOperation, FallbackDecision, plan_transport_operation
