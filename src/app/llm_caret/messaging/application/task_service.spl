#![allow(primitive_api, unnamed_duplicate_typed_args)]
@allow(primitive_api, unnamed_duplicate_typed_args)
"""Stateful-task semantics kept separate from canonical room messages."""

enum TaskState:
    Queued
    Running
    WaitingInput
    Blocked
    Completed
    Failed
    Canceled

struct MessagingTask:
    task_id: text
    origin_message_id: text
    assigned_agent_id: text
    state: TaskState
    objective: text
    progress_summary: text
    required_input: text
    created_at: i64
    updated_at: i64
    completed_at: i64

struct TaskMutation:
    accepted: bool
    error: text
    task: MessagingTask

fn _terminal(state: TaskState) -> bool:
    state == TaskState.Completed or state == TaskState.Failed or state == TaskState.Canceled

pub fn create_task(task_id: text, origin_message_id: text, assigned_agent_id: text,
        objective: text, created_at: i64) -> TaskMutation:
    if task_id.trim() == "" or origin_message_id.trim() == "" or assigned_agent_id.trim() == "":
        return TaskMutation(accepted: false, error: "invalid_task_identity",
            task: MessagingTask(task_id: "", origin_message_id: "", assigned_agent_id: "", state: TaskState.Failed,
                objective: "", progress_summary: "", required_input: "", created_at: 0, updated_at: 0, completed_at: 0))
    if objective.trim() == "":
        return TaskMutation(accepted: false, error: "task_objective_required",
            task: MessagingTask(task_id: task_id, origin_message_id: origin_message_id, assigned_agent_id: assigned_agent_id,
                state: TaskState.Failed, objective: "", progress_summary: "", required_input: "",
                created_at: created_at, updated_at: created_at, completed_at: created_at))
    TaskMutation(accepted: true, error: "", task: MessagingTask(task_id: task_id,
        origin_message_id: origin_message_id, assigned_agent_id: assigned_agent_id, state: TaskState.Queued,
        objective: objective.trim(), progress_summary: "queued", required_input: "", created_at: created_at,
        updated_at: created_at, completed_at: 0))

pub fn transition_task(task: MessagingTask, next_state: TaskState, summary: text,
        required_input: text, updated_at: i64) -> TaskMutation:
    if _terminal(task.state):
        return TaskMutation(accepted: false, error: "task_already_terminal", task: task)
    if next_state == TaskState.WaitingInput and required_input.trim() == "":
        return TaskMutation(accepted: false, error: "required_input_missing", task: task)
    val completed_at = if _terminal(next_state): updated_at else: 0
    val changed = MessagingTask(task_id: task.task_id, origin_message_id: task.origin_message_id,
        assigned_agent_id: task.assigned_agent_id, state: next_state, objective: task.objective,
        progress_summary: summary.trim(), required_input: required_input.trim(), created_at: task.created_at,
        updated_at: updated_at, completed_at: completed_at)
    TaskMutation(accepted: true, error: "", task: changed)

pub fn cancel_task(task: MessagingTask, updated_at: i64) -> TaskMutation:
    transition_task(task, TaskState.Canceled, "canceled", "", updated_at)

pub fn approve_task(task: MessagingTask, updated_at: i64) -> TaskMutation:
    if task.state != TaskState.WaitingInput and task.state != TaskState.Blocked:
        return TaskMutation(accepted: false, error: "task_not_awaiting_approval", task: task)
    transition_task(task, TaskState.Running, "approved", "", updated_at)

pub fn decline_task(task: MessagingTask, updated_at: i64) -> TaskMutation:
    if task.state != TaskState.WaitingInput and task.state != TaskState.Blocked:
        return TaskMutation(accepted: false, error: "task_not_awaiting_approval", task: task)
    transition_task(task, TaskState.Canceled, "declined", "", updated_at)

export TaskState, MessagingTask, TaskMutation
export create_task, transition_task, cancel_task, approve_task, decline_task
