"""Separate delivery, reading, consumption, and handling evidence."""

enum ReceiptState:
    Accepted
    Transmitted
    Delivered
    Read
    ConsumedByAgent
    Handled
    Failed

enum ReceiptEvidence:
    Native
    LocalCursor
    Synthetic
    Unknown

struct MessageReceipt:
    message_id: text
    identity_id: text
    state: ReceiptState
    evidence: ReceiptEvidence
    occurred_at: i64
    detail: text

pub fn receipt_tag(receipt: MessageReceipt) -> text:
    match receipt.state:
        case ReceiptState.Accepted: "[unread]"
        case ReceiptState.Transmitted: "[transmitted]"
        case ReceiptState.Delivered: "[delivered]"
        case ReceiptState.Read:
            match receipt.evidence:
                case ReceiptEvidence.Native: "[read:native]"
                case ReceiptEvidence.LocalCursor: "[read:local]"
                case ReceiptEvidence.Synthetic: "[read:synthetic]"
                case ReceiptEvidence.Unknown: "[read:unknown]"
        case ReceiptState.ConsumedByAgent: "[consumed]"
        case ReceiptState.Handled: "[handled]"
        case ReceiptState.Failed: "[delivery-failed]"

export ReceiptState, ReceiptEvidence, MessageReceipt, receipt_tag
