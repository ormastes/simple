"""Compiled stdio MCP entrypoint for LLM Caret messaging.

The whole MCP service and PureDatabase closure execute in this cached artifact;
an interpreter-hosted agent process only supervises it and inherits stdio.
"""

use app.io.mod.{env_get}
use std.io_runtime.{mkdir_p, env_get_opt}
use app.llm_caret.messaging.mcp.protocol.{serve_messaging_mcp}

fn main() -> i64:
    val database = env_get_opt("LLM_CARET_MESSAGING_DB") ?? ".simple/state/llm-caret-messaging.db"
    val slash = database.last_index_of("/")
    if slash > 0: mkdir_p(database.substring(0, slash))
    val identity = env_get_opt("LLM_CARET_MESSAGING_IDENTITY") ?? "local-agent"
    val workspace = env_get_opt("LLM_CARET_MESSAGING_WORKSPACE") ?? "default"
    val scopes = env_get_opt("LLM_CARET_MESSAGING_SCOPES") ??
        "room:read,room:write,profile:read,dm:write,agent:control"
    serve_messaging_mcp(database, identity, workspace, scopes.split(","))
    0
