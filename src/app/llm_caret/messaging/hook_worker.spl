"""Compiled Claude/Codex/Gemini messaging hook entrypoint."""

use std.cli.cli_util.{get_cli_args, get_flag_value}
use app.llm_caret.messaging.adapter.agent.hook_command.{run_hook_command}

fn main() -> i64:
    val args = get_cli_args()
    val provider = get_flag_value(args, "--provider") ?? ""
    val event_name = get_flag_value(args, "--event") ?? ""
    if provider == "" or event_name == "":
        print "ERROR hook worker requires --provider and --event"
        return 2
    run_hook_command(provider, event_name)
