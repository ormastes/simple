"""Typed request and response vocabulary for the messaging MCP server."""

use app.llm_caret.messaging.adapter.server.auth.{AuthPrincipal}
use app.llm_caret.messaging.domain.model.{AgentProfile, MessageOrigin, RoomMessage}
use app.llm_caret.messaging.application.task_service.{MessagingTask, TaskState}

enum ChatTool:
    Join
    Leave
    Send
    Read
    MarkRead
    Who
    OpenPrivate
    NotifyAll
    Assign
    TaskUpdate
    PublishArtifact
    GetContext

struct ChatToolRequest:
    tool: ChatTool
    principal: AuthPrincipal
    workspace_id: text
    room_id: text
    identity_id: text
    target_identity_id: text
    agent_id: text
    message_id: text
    task_id: text
    artifact_id: text
    context_bundle_id: text
    body: text
    detail: text
    idempotency_key: text
    after_seq: i64
    limit: i64
    occurred_at: i64
    task_state: TaskState
    origin: MessageOrigin

struct PublishedArtifact:
    artifact_id: text
    task_id: text
    room_id: text
    media_type: text
    value: text
    published_by: text
    created_at: i64

struct ChatToolResult:
    ok: bool
    status: i64
    error: text
    duplicate: bool
    resource_id: text
    evidence: text
    messages: [RoomMessage]
    profiles: [AgentProfile]
    tasks: [MessagingTask]
    artifacts: [PublishedArtifact]

pub fn empty_chat_result(status: i64, error: text) -> ChatToolResult:
    ChatToolResult(ok: false, status: status, error: error, duplicate: false,
        resource_id: "", evidence: "", messages: [], profiles: [], tasks: [], artifacts: [])

export ChatTool, ChatToolRequest, PublishedArtifact, ChatToolResult, empty_chat_result
