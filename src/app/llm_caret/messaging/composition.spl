"""Instance-scoped composition root for canonical LLM Caret messaging."""

use app.llm_caret.messaging.adapter.store.pure_sql_store.{PureSqlMessagingStore, AppendMessageResult, StoreWriteResult, StoredTransportBinding, StoredExternalRef, StoredTransportRequest}
use app.llm_caret.messaging.adapter.chat.rest_common.{CredentialHttpRequestTemplate}
use app.llm_caret.messaging.application.room_service.{RoomMembership, RoomMutation, create_room, create_direct_room, add_room_member, remove_room_member, identity_can_read}
use app.llm_caret.messaging.application.message_service.{prepare_message}
use app.llm_caret.messaging.application.profile_service.{find_agent_profile, ProfileLookup}
use app.llm_caret.messaging.application.task_service.{MessagingTask, TaskMutation, TaskState, create_task, transition_task, cancel_task, approve_task, decline_task}
use app.llm_caret.messaging.domain.model.{Workspace, Identity, IdentityKind, AgentProfile, MessageOrigin, Room, RoomKind, RoomMessage, messaging_id}
use app.llm_caret.messaging.domain.model.{AgentBinding}
use app.llm_caret.messaging.application.agent_control_service.{AgentControlService, AgentControlResult}
use app.llm_caret.messaging.application.router.{route_message}
use app.llm_caret.messaging.application.context_builder.{build_context_bundle}
use app.llm_caret.messaging.domain.receipt.{MessageReceipt, ReceiptState, ReceiptEvidence}

struct RuntimeMutation:
    accepted: bool
    error: text

struct RoutedTaskResult:
    routed: bool
    task_id: text
    agent_id: text
    session_id: text
    context_bundle_id: text
    error: text

class MessagingRuntime:
    store: PureSqlMessagingStore
    memberships: [RoomMembership]
    profiles: [AgentProfile]
    tasks: [MessagingTask]
    bindings: [AgentBinding]
    binding_sessions: [text]
    agent_control: AgentControlService

    static fn open(path: text) -> MessagingRuntime:
        val store = PureSqlMessagingStore.open(path)
        var runtime = MessagingRuntime(store: store, memberships: store.memberships(), profiles: store.profiles(),
            tasks: store.tasks(), bindings: store.agent_bindings(), binding_sessions: [],
            agent_control: AgentControlService.new(true))
        for binding in runtime.bindings:
            val profile = runtime.who(binding.agent_id.value)
            val attached = if profile.found: runtime.agent_control.attach(profile.profile.provider, binding) else:
                AgentControlResult(ok: false, provider: "", session_id: "", evidence: "", error: "agent_not_found")
            runtime.binding_sessions.push(if attached.ok: attached.session_id else: "")
        runtime

    static fn memory() -> MessagingRuntime:
        MessagingRuntime(store: PureSqlMessagingStore.open_memory(), memberships: [], profiles: [], tasks: [], bindings: [], binding_sessions: [],
            agent_control: AgentControlService.new(true))

    fn ready() -> bool: self.store.ready()
    me close() -> bool: self.store.close()

    me ensure_workspace(workspace_id: text, name: text, at: i64) -> RuntimeMutation:
        if workspace_id == "": return RuntimeMutation(accepted: false, error: "invalid_workspace")
        val write = self.store.put_workspace(Workspace(workspace_id: messaging_id("workspace", workspace_id),
            name: if name == "": workspace_id else: name, created_at: at))
        RuntimeMutation(accepted: write.ok, error: write.error)

    me register_human_identity(workspace_id: text, identity_id: text, account_id: text,
            display_name: text, at: i64) -> RuntimeMutation:
        val workspace = self.ensure_workspace(workspace_id, workspace_id, at)
        if not workspace.accepted: return workspace
        val write = self.store.put_identity(Identity(identity_id: messaging_id("identity", identity_id),
            workspace_id: messaging_id("workspace", workspace_id), kind: IdentityKind.Human,
            account_id: account_id, display_name: display_name, external_transport: "",
            external_id: "", created_at: at))
        RuntimeMutation(accepted: write.ok, error: write.error)

    me create_canonical_room(room_id: text, workspace_id: text, kind: RoomKind, name: text,
            topic: text, visibility: text, mode: text, creator_id: text, at: i64) -> RoomMutation:
        val mutation = create_room(room_id, workspace_id, kind, name, topic, visibility, mode,
            "milestones", "bounded", creator_id, at)
        if not mutation.accepted: return mutation
        val workspace = self.ensure_workspace(workspace_id, workspace_id, at)
        if not workspace.accepted:
            return RoomMutation(accepted: false, error: workspace.error, room: mutation.room, memberships: self.memberships)
        val identity = self.register_human_identity(workspace_id, creator_id, "", creator_id, at)
        if not identity.accepted:
            return RoomMutation(accepted: false, error: identity.error, room: mutation.room, memberships: self.memberships)
        val stored = self.store.create_room(mutation.room)
        if not stored.ok:
            return RoomMutation(accepted: false, error: stored.error, room: mutation.room, memberships: self.memberships)
        self.memberships = self.memberships + mutation.memberships
        for membership in mutation.memberships: self.store.put_membership(membership)
        RoomMutation(accepted: true, error: "", room: mutation.room, memberships: self.memberships)

    me open_direct_room(room_id: text, workspace_id: text, first_identity: text,
            second_identity: text, at: i64) -> RoomMutation:
        val mutation = create_direct_room(room_id, workspace_id, first_identity, second_identity, at)
        if not mutation.accepted: return mutation
        val workspace = self.ensure_workspace(workspace_id, workspace_id, at)
        if not workspace.accepted:
            return RoomMutation(accepted: false, error: workspace.error, room: mutation.room, memberships: self.memberships)
        val first = self.register_human_identity(workspace_id, first_identity, "", first_identity, at)
        if not first.accepted:
            return RoomMutation(accepted: false, error: first.error, room: mutation.room, memberships: self.memberships)
        val second = self.register_human_identity(workspace_id, second_identity, "", second_identity, at)
        if not second.accepted:
            return RoomMutation(accepted: false, error: second.error, room: mutation.room, memberships: self.memberships)
        val stored = self.store.create_room(mutation.room)
        if not stored.ok:
            return RoomMutation(accepted: false, error: stored.error, room: mutation.room, memberships: self.memberships)
        self.memberships = self.memberships + mutation.memberships
        for membership in mutation.memberships: self.store.put_membership(membership)
        RoomMutation(accepted: true, error: "", room: mutation.room, memberships: self.memberships)

    me join_room(room_id: text, identity_id: text, role: text, at: i64) -> RuntimeMutation:
        val room = self.store.room(room_id)
        if room.room_id.value == "": return RuntimeMutation(accepted: false, error: "room_not_found")
        val mutation = add_room_member(room, self.memberships, identity_id, role, at)
        if not mutation.accepted: return RuntimeMutation(accepted: false, error: mutation.error)
        self.memberships = mutation.memberships
        for membership in mutation.memberships:
            if membership.room_id == room_id and membership.identity_id == identity_id:
                self.store.put_membership(membership)
        RuntimeMutation(accepted: true, error: "")

    me leave_room(room_id: text, identity_id: text) -> RuntimeMutation:
        val room = self.store.room(room_id)
        if room.room_id.value == "": return RuntimeMutation(accepted: false, error: "room_not_found")
        val mutation = remove_room_member(room, self.memberships, identity_id)
        if not mutation.accepted: return RuntimeMutation(accepted: false, error: mutation.error)
        self.memberships = mutation.memberships
        self.store.delete_membership(room_id, identity_id)
        RuntimeMutation(accepted: true, error: "")

    me send_message(message_id: text, workspace_id: text, room_id: text, sender_identity: text,
            sender_agent: text, origin: MessageOrigin, body: text, reply_to_id: text,
            correlation_id: text, causation_id: text, hop_count: i64, at: i64,
            idempotency_key: text) -> AppendMessageResult:
        val room = self.store.room(room_id)
        if room.room_id.value == "":
            return AppendMessageResult(ok: false, message_id: message_id, room_seq: 0, duplicate: false, error: "room_not_found")
        if not identity_can_read(room, self.memberships, sender_identity):
            return AppendMessageResult(ok: false, message_id: message_id, room_seq: 0, duplicate: false, error: "room_access_denied")
        val prepared = prepare_message(message_id, workspace_id, room_id, self.store.message_count() + 1,
            sender_identity, sender_agent, origin, body, "", reply_to_id, correlation_id,
            causation_id, hop_count, at)
        if not prepared.accepted:
            return AppendMessageResult(ok: false, message_id: message_id, room_seq: 0, duplicate: false, error: prepared.error)
        self.store.append_message(prepared.message, idempotency_key)

    fn read_messages(room_id: text, identity_id: text, after_seq: i64, limit: i64) -> [RoomMessage]:
        val room = self.store.room(room_id)
        if room.room_id.value == "" or not identity_can_read(room, self.memberships, identity_id): return []
        self.store.message_history(room_id, after_seq, limit)

    me mark_read(room_id: text, identity_id: text, seq: i64, at: i64) -> StoreWriteResult:
        val room = self.store.room(room_id)
        if room.room_id.value == "" or not identity_can_read(room, self.memberships, identity_id):
            return StoreWriteResult(ok: false, error: "room_access_denied")
        self.store.advance_cursor(room_id, identity_id, seq, at)

    me bind_transport(binding_id: text, canonical_room_id: text, transport: text,
            external_room_id: text, mirror_policy: text, capabilities_version: text) -> RuntimeMutation:
        if self.store.room(canonical_room_id).room_id.value == "":
            return RuntimeMutation(accepted: false, error: "room_not_found")
        if mirror_policy != "full" and mirror_policy != "metadata_only" and mirror_policy != "off":
            return RuntimeMutation(accepted: false, error: "invalid_mirror_policy")
        val write = self.store.put_transport_binding(StoredTransportBinding(binding_id: binding_id,
            canonical_room_id: canonical_room_id, transport: transport,
            external_room_id: external_room_id, mirror_policy: mirror_policy,
            capabilities_version: capabilities_version, last_inbound_cursor: "",
            last_outbound_cursor: ""))
        RuntimeMutation(accepted: write.ok, error: write.error)

    me advance_transport_cursors(binding_id: text, inbound_cursor: text,
            outbound_cursor: text) -> RuntimeMutation:
        val binding = self.store.transport_binding(binding_id)
        if binding.binding_id == "": return RuntimeMutation(accepted: false, error: "binding_not_found")
        val write = self.store.put_transport_binding(StoredTransportBinding(binding_id: binding.binding_id,
            canonical_room_id: binding.canonical_room_id, transport: binding.transport,
            external_room_id: binding.external_room_id, mirror_policy: binding.mirror_policy,
            capabilities_version: binding.capabilities_version,
            last_inbound_cursor: inbound_cursor, last_outbound_cursor: outbound_cursor))
        RuntimeMutation(accepted: write.ok, error: write.error)

    me map_external_message(ref_id: text, binding_id: text, canonical_message_id: text,
            external_message_id: text, external_thread_id: text, at: i64) -> RuntimeMutation:
        if self.store.transport_binding(binding_id).binding_id == "":
            return RuntimeMutation(accepted: false, error: "binding_not_found")
        if not self.store.message_exists(canonical_message_id):
            return RuntimeMutation(accepted: false, error: "message_not_found")
        val write = self.store.put_external_ref(StoredExternalRef(ref_id: ref_id,
            binding_id: binding_id, canonical_message_id: canonical_message_id,
            external_message_id: external_message_id, external_thread_id: external_thread_id,
            created_at: at))
        RuntimeMutation(accepted: write.ok, error: write.error)

    fn transport_binding(binding_id: text) -> StoredTransportBinding:
        self.store.transport_binding(binding_id)

    fn external_message_ref(binding_id: text, canonical_message_id: text) -> StoredExternalRef:
        self.store.external_ref(binding_id, canonical_message_id)

    me queue_transport_template(delivery_id: text, message_id: text, binding_id: text,
            request_template: CredentialHttpRequestTemplate, at: i64) -> RuntimeMutation:
        if self.store.transport_binding(binding_id).binding_id == "":
            return RuntimeMutation(accepted: false, error: "binding_not_found")
        if not self.store.message_exists(message_id):
            return RuntimeMutation(accepted: false, error: "message_not_found")
        if not request_template.accepted:
            return RuntimeMutation(accepted: false, error: request_template.error)
        val write = self.store.enqueue_transport_request(StoredTransportRequest(
            delivery_id: delivery_id, message_id: message_id, binding_id: binding_id,
            method: request_template.method, url_template: request_template.url_template,
            headers: request_template.headers, body: request_template.body,
            credential_ref: request_template.credential_ref,
            credential_mode: request_template.credential_mode,
            idempotency_key: request_template.idempotency_key), at)
        RuntimeMutation(accepted: write.ok, error: write.error)

    me register_profile(profile: AgentProfile) -> RuntimeMutation:
        if profile.agent_id.value == "": return RuntimeMutation(accepted: false, error: "invalid_agent_id")
        val existing = find_agent_profile(self.profiles, profile.agent_id.value)
        if existing.found: return RuntimeMutation(accepted: false, error: "agent_already_registered")
        self.profiles = self.profiles + [profile]
        self.store.put_profile(profile)
        if profile.room_ids.len() > 0:
            val room = self.store.room(profile.room_ids[0])
            if room.room_id.value != "":
                val identity_write = self.store.put_identity(Identity(
                    identity_id: messaging_id("identity", profile.agent_id.value),
                    workspace_id: room.workspace_id, kind: IdentityKind.Agent, account_id: "",
                    display_name: profile.display_name, external_transport: "",
                    external_id: "", created_at: profile.last_activity_at))
                if not identity_write.ok: return RuntimeMutation(accepted: false, error: identity_write.error)
        RuntimeMutation(accepted: true, error: "")

    fn who(agent_or_alias: text) -> ProfileLookup: find_agent_profile(self.profiles, agent_or_alias)

    me assign_task(task_id: text, origin_message_id: text, agent_id: text,
            objective: text, at: i64) -> TaskMutation:
        val mutation = create_task(task_id, origin_message_id, agent_id, objective, at)
        if mutation.accepted:
            self.tasks = self.tasks + [mutation.task]
            self.store.put_task(mutation.task)
        mutation

    me update_task(task_id: text, state: TaskState, summary: text, required_input: text, at: i64) -> TaskMutation:
        var i = 0
        while i < self.tasks.len():
            if self.tasks[i].task_id == task_id:
                val mutation = transition_task(self.tasks[i], state, summary, required_input, at)
                if mutation.accepted:
                    self.tasks[i] = mutation.task
                    self.store.put_task(mutation.task)
                return mutation
            i = i + 1
        create_task("", "", "", "", at)

    me act_on_task(task_id: text, action: text, at: i64) -> TaskMutation:
        var i = 0
        while i < self.tasks.len():
            if self.tasks[i].task_id == task_id:
                val mutation = if action == "cancel": cancel_task(self.tasks[i], at)
                    elif action == "approve": approve_task(self.tasks[i], at)
                    elif action == "decline": decline_task(self.tasks[i], at)
                    else: create_task("", "", "", "", at)
                if mutation.accepted:
                    self.tasks[i] = mutation.task
                    self.store.put_task(mutation.task)
                return mutation
            i = i + 1
        create_task("", "", "", "", at)

    me attach_agent(provider: text, binding: AgentBinding) -> AgentControlResult:
        self.agent_control.attach(provider, binding)

    me register_agent_binding(provider: text, binding: AgentBinding) -> AgentControlResult:
        val room = self.store.room(binding.room_id.value)
        if room.room_id.value == "":
            return AgentControlResult(ok: false, provider: provider, session_id: "", evidence: "", error: "room_not_found")
        val profile = self.who(binding.agent_id.value)
        if not profile.found:
            return AgentControlResult(ok: false, provider: provider, session_id: "", evidence: "", error: "agent_not_found")
        val identity = self.store.put_identity(Identity(
            identity_id: messaging_id("identity", binding.agent_id.value),
            workspace_id: room.workspace_id, kind: IdentityKind.Agent, account_id: "",
            display_name: profile.profile.display_name, external_transport: "",
            external_id: "", created_at: profile.profile.last_activity_at))
        if not identity.ok:
            return AgentControlResult(ok: false, provider: provider, session_id: "",
                evidence: "", error: identity.error)
        val attached = self.agent_control.attach(provider, binding)
        if not attached.ok: return attached
        val stored = self.store.put_agent_binding(binding)
        if not stored.ok:
            return AgentControlResult(ok: false, provider: provider, session_id: attached.session_id,
                evidence: "", error: stored.error)
        var replaced = false
        var i = 0
        while i < self.bindings.len():
            if self.bindings[i].binding_id.value == binding.binding_id.value:
                self.bindings[i] = binding
                self.binding_sessions[i] = attached.session_id
                replaced = true
            i = i + 1
        if not replaced:
            self.bindings.push(binding)
            self.binding_sessions.push(attached.session_id)
        attached

    me route_human_message(message_id: text, main_agent_id: text, at: i64) -> RoutedTaskResult:
        val message = self.store.message(message_id)
        if message.message_id.value == "":
            return RoutedTaskResult(routed: false, task_id: "", agent_id: "", session_id: "",
                context_bundle_id: "", error: "message_not_found")
        if message.origin != MessageOrigin.Human:
            return RoutedTaskResult(routed: false, task_id: "", agent_id: "", session_id: "",
                context_bundle_id: "", error: "origin_does_not_trigger")
        val room = self.store.room(message.room_id.value)
        val history = self.store.message_history(message.room_id.value, 0, 1000)
        val decision = route_message(message, history, self.bindings, self.profiles, "", main_agent_id)
        val trigger_allowed = room.mode == "room" or decision.reason == "explicit_mention" or
            decision.reason == "explicit_command_target" or decision.reason == "reply_target"
        if not decision.routed or not trigger_allowed:
            return RoutedTaskResult(routed: false, task_id: "", agent_id: decision.agent_id,
                session_id: "", context_bundle_id: "", error: if decision.selector_required:
                    "selector_required" else: "agent_not_triggered")
        var binding_index = -1
        for i in 0..self.bindings.len():
            if self.bindings[i].room_id.value == message.room_id.value and
                    self.bindings[i].agent_id.value == decision.agent_id:
                binding_index = i
        if binding_index < 0 or self.binding_sessions[binding_index] == "":
            return RoutedTaskResult(routed: false, task_id: "", agent_id: decision.agent_id,
                session_id: "", context_bundle_id: "", error: "agent_session_unavailable")
        val task_id = "task-" + message.message_id.value
        val assigned = self.assign_task(task_id, message.message_id.value, decision.agent_id,
            message.body, at)
        if not assigned.accepted:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: "", context_bundle_id: "", error: assigned.error)
        val bundle_id = "context-" + task_id
        val bundle = build_context_bundle(bundle_id, task_id, decision.agent_id,
            message.room_id.value, message, history, self.profiles, "", "", "", [],
            32768, 2, "room-summary-v1", "redaction-v1")
        if not bundle.accepted:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: "", context_bundle_id: bundle_id, error: bundle.error)
        val manifest_write = self.store.put_context_manifest(bundle_id, task_id, bundle.manifest.included_message_ids,
            bundle.manifest.included_profile_ids, bundle.manifest.source_pack_hash,
            bundle.manifest.summary_version, bundle.manifest.redaction_policy_version,
            bundle.manifest.token_estimate, at)
        if not manifest_write.ok:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: "", context_bundle_id: bundle_id, error: manifest_write.error)
        val session_id = self.binding_sessions[binding_index]
        val profile = self.who(decision.agent_id)
        val injected = self.inject_agent_context(profile.profile.provider, session_id, bundle_id)
        if not injected.ok:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: session_id, context_bundle_id: bundle_id, error: injected.error)
        val consumed = self.store.put_receipt(MessageReceipt(message_id: message.message_id.value,
            identity_id: decision.agent_id, state: ReceiptState.ConsumedByAgent,
            evidence: ReceiptEvidence.Synthetic, occurred_at: at, detail: bundle_id))
        if not consumed.ok:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: session_id, context_bundle_id: bundle_id, error: consumed.error)
        val submitted = self.submit_agent_task(profile.profile.provider, session_id, task_id)
        if not submitted.ok:
            return RoutedTaskResult(routed: false, task_id: task_id, agent_id: decision.agent_id,
                session_id: session_id, context_bundle_id: bundle_id, error: submitted.error)
        RoutedTaskResult(routed: true, task_id: task_id, agent_id: decision.agent_id,
            session_id: session_id, context_bundle_id: bundle_id, error: "")

    me inject_agent_context(provider: text, session_id: text, manifest_id: text) -> AgentControlResult:
        self.agent_control.inject_context(provider, session_id, manifest_id)

    me submit_agent_task(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        self.agent_control.submit(provider, session_id, task_id)

    me steer_agent_task(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        self.agent_control.steer(provider, session_id, task_id)

    me cancel_agent_task(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        self.agent_control.cancel(provider, session_id, task_id)

    me accept_agent_event(provider: text, session_id: text, event_name: text, payload: text) -> AgentControlResult:
        self.agent_control.accept_event(provider, session_id, event_name, payload)

export RuntimeMutation, RoutedTaskResult, MessagingRuntime
