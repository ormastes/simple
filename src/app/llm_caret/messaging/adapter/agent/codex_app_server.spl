"""Codex App Server adapter with explicit hook fallback envelopes."""

use app.llm_caret.messaging.domain.model.{AgentBinding, RoomMessage}
use app.llm_caret.messaging.port.contracts.{AgentControlPort}
use app.llm_caret.messaging.adapter.agent.session_registry.{AgentSessionRegistry, control_command}

class CodexAppServerAdapter:
    registry: AgentSessionRegistry
    app_server_available: bool

impl CodexAppServerAdapter:
    static fn new(app_server_available: bool) -> CodexAppServerAdapter:
        CodexAppServerAdapter(registry: AgentSessionRegistry.new(), app_server_available: app_server_available)

    me attach_session(binding: AgentBinding) -> text:
        self.registry.attach("codex", binding)

    fn operation(operation: text, session_id: text, payload: text) -> text:
        if self.app_server_available:
            control_command("codex-app-server", operation, session_id, payload)
        else:
            control_command("codex-hook-fallback", operation, session_id, payload)

    me accept_notification(session_id: text, notification: text, payload: text) -> text:
        val state = _codex_state(notification)
        if state == "":
            return "error:unknown_codex_notification"
        self.registry.transition(session_id, state, payload)

impl AgentControlPort for CodexAppServerAdapter:
    fn capabilities() -> [text]:
        if self.app_server_available:
            ["turn_start", "turn_steer", "turn_interrupt", "thread_inject_items", "stream_events"]
        else:
            ["hook_fallback", "context_injection", "task_updates"]

    fn attach(binding: AgentBinding) -> text:
        self.operation("thread/attach", binding.agent_id.value, binding.binding_id.value)

    fn resume(session_id: text) -> text:
        self.operation("thread/resume", session_id, "")

    fn inject_context(session_id: text, context_manifest_id: text) -> text:
        self.operation("thread/inject_items", session_id, context_manifest_id)

    fn submit(session_id: text, message: RoomMessage) -> text:
        self.operation("turn/start", session_id, message.message_id.value)

    fn steer(session_id: text, message: RoomMessage) -> text:
        self.operation("turn/steer", session_id, message.message_id.value)

    fn cancel(session_id: text, task_id: text) -> text:
        self.operation("turn/interrupt", session_id, task_id)

    fn close(session_id: text) -> text:
        self.operation("thread/close", session_id, "")

fn _codex_state(notification: text) -> text:
    match notification:
        "thread/started": "idle"
        "turn/started": "running"
        "turn/waiting_input": "waiting_input"
        "turn/blocked": "blocked"
        "turn/completed": "completed"
        "turn/failed": "failed"
        "turn/interrupted": "idle"
        _: ""

export CodexAppServerAdapter
