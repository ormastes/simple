"""In-memory agent session registry and normalized lifecycle event queue."""

use app.llm_caret.messaging.domain.model.{AgentBinding}

struct AgentControlSession:
    session_id: text
    provider: text
    binding_id: text
    agent_id: text
    state: text
    context_manifest_id: text
    active_task_id: text

struct AgentControlEvent:
    sequence: i64
    session_id: text
    kind: text
    payload: text

class AgentSessionRegistry:
    sessions: [AgentControlSession]
    events: [AgentControlEvent]
    next_session: i64
    next_event: i64

impl AgentSessionRegistry:
    static fn new() -> AgentSessionRegistry:
        AgentSessionRegistry(sessions: [], events: [], next_session: 1, next_event: 1)

    fn session(session_id: text) -> AgentControlSession?:
        for session in self.sessions:
            if session.session_id == session_id:
                return session
        nil

    fn event_count() -> i64:
        self.events.len()

    fn event_at(index: i64) -> AgentControlEvent?:
        if index < 0 or index >= self.events.len():
            return nil
        self.events[index]

    me attach(provider: text, binding: AgentBinding) -> text:
        if provider.trim() == "" or binding.binding_id.value == "" or binding.agent_id.value == "":
            return "error:invalid_binding"
        val session_id = provider.lower() + "-" + binding.agent_id.value + "-" + self.next_session.to_string()
        self.next_session = self.next_session + 1
        self.sessions.push(AgentControlSession(
            session_id: session_id, provider: provider.lower(), binding_id: binding.binding_id.value,
            agent_id: binding.agent_id.value, state: "attached", context_manifest_id: "", active_task_id: ""))
        self.enqueue(session_id, "session_attached", binding.binding_id.value)
        session_id

    me resume(session_id: text) -> text:
        val index = self._index(session_id)
        if index < 0 or self.sessions[index].state == "closed":
            return "error:session_unavailable"
        var session = self.sessions[index]
        session.state = "idle"
        self.sessions[index] = session
        self.enqueue(session_id, "session_resumed", "")
        "resumed:" + session_id

    me inject_context(session_id: text, context_manifest_id: text) -> text:
        val index = self._index(session_id)
        if index < 0 or self.sessions[index].state == "closed" or context_manifest_id.trim() == "":
            return "error:context_rejected"
        var session = self.sessions[index]
        session.context_manifest_id = context_manifest_id
        self.sessions[index] = session
        self.enqueue(session_id, "context_injected", context_manifest_id)
        "context_accepted:" + context_manifest_id

    me begin_task(session_id: text, task_id: text, operation: text) -> text:
        val index = self._index(session_id)
        if index < 0 or self.sessions[index].state == "closed" or task_id.trim() == "":
            return "error:task_rejected"
        if operation == "steer" and self.sessions[index].state != "running":
            return "error:no_active_turn"
        var session = self.sessions[index]
        session.state = "running"
        session.active_task_id = task_id
        self.sessions[index] = session
        self.enqueue(session_id, operation, task_id)
        operation + ":" + task_id

    me cancel(session_id: text, task_id: text) -> text:
        val index = self._index(session_id)
        if index < 0 or self.sessions[index].active_task_id != task_id or task_id == "":
            return "error:task_not_active"
        var session = self.sessions[index]
        session.state = "idle"
        session.active_task_id = ""
        self.sessions[index] = session
        self.enqueue(session_id, "task_canceled", task_id)
        "canceled:" + task_id

    me transition(session_id: text, state: text, payload: text) -> text:
        val index = self._index(session_id)
        if index < 0 or self.sessions[index].state == "closed":
            return "error:session_unavailable"
        if not _valid_state(state):
            return "error:unknown_lifecycle_event"
        var session = self.sessions[index]
        session.state = state
        if state == "completed" or state == "failed" or state == "idle":
            session.active_task_id = ""
        self.sessions[index] = session
        self.enqueue(session_id, state, payload)
        "enqueued:" + state

    me close(session_id: text) -> text:
        val index = self._index(session_id)
        if index < 0:
            return "error:session_unavailable"
        var session = self.sessions[index]
        session.state = "closed"
        session.active_task_id = ""
        self.sessions[index] = session
        self.enqueue(session_id, "session_closed", "")
        "closed:" + session_id

    me enqueue(session_id: text, kind: text, payload: text):
        self.events.push(AgentControlEvent(sequence: self.next_event, session_id: session_id, kind: kind, payload: payload))
        self.next_event = self.next_event + 1

    fn _index(session_id: text) -> i64:
        var index: i64 = 0
        while index < self.sessions.len():
            if self.sessions[index].session_id == session_id:
                return index
            index = index + 1
        -1

fn _valid_state(state: text) -> bool:
    state == "idle" or state == "running" or state == "waiting_input" or state == "blocked" or state == "completed" or state == "failed"

pub fn control_command(provider: text, operation: text, session_id: text, payload: text) -> text:
    if provider.trim() == "" or operation.trim() == "" or session_id.trim() == "":
        return "error:invalid_control_request"
    "enqueue:" + provider.lower() + ":" + operation + ":" + session_id + ":" + payload

export AgentControlSession, AgentControlEvent, AgentSessionRegistry, control_command
