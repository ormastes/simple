#![allow(primitive_api, unnamed_duplicate_typed_args)]
@allow(primitive_api, unnamed_duplicate_typed_args)
"""HTTP-independent REST route parsing and response construction."""

struct ApiRoute:
    matched: bool
    operation: text
    required_scope: text
    resource_id: text
    child_id: text
    streaming: bool

struct ApiResponse:
    status: i64
    content_type: text
    body: text

pub fn idempotency_key_valid(method: text, key: text) -> bool:
    if method == "GET" or method == "DELETE":
        return true
    val value = key.trim()
    value.len() >= 8 and value.len() <= 200 and not value.contains(" ")

fn _no_route() -> ApiRoute:
    ApiRoute(matched: false, operation: "", required_scope: "", resource_id: "", child_id: "", streaming: false)

pub fn parse_api_route(method: text, raw_path: text) -> ApiRoute:
    val path = raw_path.split("?")[0]
    val parts = path.split("/")
    if parts.len() < 3 or parts[1] != "v1":
        return _no_route()
    if method == "POST" and path == "/v1/invites":
        return ApiRoute(matched: true, operation: "invite_create", required_scope: "admin:invite", resource_id: "", child_id: "", streaming: false)
    if parts.len() == 5 and parts[2] == "invites" and parts[4] == "accept" and method == "POST":
        return ApiRoute(matched: true, operation: "invite_accept", required_scope: "", resource_id: parts[3], child_id: "", streaming: false)
    if method == "POST" and path == "/v1/sessions/email/start":
        return ApiRoute(matched: true, operation: "email_session_start", required_scope: "admin:invite", resource_id: "", child_id: "", streaming: false)
    if method == "POST" and path == "/v1/sessions/email/verify":
        return ApiRoute(matched: true, operation: "email_session_verify", required_scope: "", resource_id: "", child_id: "", streaming: false)
    if method == "POST" and path == "/v1/rooms":
        return ApiRoute(matched: true, operation: "room_create", required_scope: "room:manage", resource_id: "", child_id: "", streaming: false)
    if method == "GET" and path == "/v1/rooms":
        return ApiRoute(matched: true, operation: "room_list", required_scope: "room:read", resource_id: "", child_id: "", streaming: false)
    if method == "POST" and path == "/v1/direct-rooms":
        return ApiRoute(matched: true, operation: "direct_room_create", required_scope: "dm:write", resource_id: "", child_id: "", streaming: false)
    if method == "GET" and path == "/v1/agents":
        return ApiRoute(matched: true, operation: "agent_list", required_scope: "profile:read", resource_id: "", child_id: "", streaming: false)
    if method == "POST" and path == "/v1/agents":
        return ApiRoute(matched: true, operation: "agent_create", required_scope: "agent:control", resource_id: "", child_id: "", streaming: false)
    if method == "POST" and path == "/v1/agent-bindings":
        return ApiRoute(matched: true, operation: "agent_binding_create", required_scope: "agent:control", resource_id: "", child_id: "", streaming: false)
    if parts.len() >= 4 and parts[2] == "rooms":
        val room_id = parts[3]
        if parts.len() == 4 and method == "GET":
            return ApiRoute(matched: true, operation: "room_get", required_scope: "room:read", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 5 and parts[4] == "messages" and method == "POST":
            return ApiRoute(matched: true, operation: "message_send", required_scope: "room:write", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 5 and parts[4] == "messages" and method == "GET":
            return ApiRoute(matched: true, operation: "message_history", required_scope: "room:read", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 5 and parts[4] == "cursor" and method == "PUT":
            return ApiRoute(matched: true, operation: "cursor_advance", required_scope: "room:read", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 5 and parts[4] == "notify-all" and method == "POST":
            return ApiRoute(matched: true, operation: "notify_all", required_scope: "room:write", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 5 and parts[4] == "events" and method == "GET":
            return ApiRoute(matched: true, operation: "room_events", required_scope: "room:read", resource_id: room_id, child_id: "", streaming: true)
        if parts.len() == 5 and parts[4] == "members" and method == "POST":
            return ApiRoute(matched: true, operation: "member_add", required_scope: "room:manage", resource_id: room_id, child_id: "", streaming: false)
        if parts.len() == 6 and parts[4] == "members" and method == "DELETE":
            return ApiRoute(matched: true, operation: "member_remove", required_scope: "room:manage", resource_id: room_id, child_id: parts[5], streaming: false)
    if parts.len() == 4 and parts[2] == "profiles" and method == "GET":
        return ApiRoute(matched: true, operation: "profile_get", required_scope: "profile:read", resource_id: parts[3], child_id: "", streaming: false)
    if parts.len() == 4 and parts[2] == "tasks" and method == "GET":
        return ApiRoute(matched: true, operation: "task_get", required_scope: "room:read", resource_id: parts[3], child_id: "", streaming: false)
    if parts.len() == 4 and parts[2] == "tasks" and method == "POST" and parts[3].contains(":"):
        val action = parts[3].split(":")
        if action.len() == 2 and (action[1] == "cancel" or action[1] == "approve" or action[1] == "decline"):
            return ApiRoute(matched: true, operation: "task_" + action[1], required_scope: "task:approve", resource_id: action[0], child_id: "", streaming: false)
    if parts.len() == 4 and parts[2] == "webhooks" and method == "POST":
        return ApiRoute(matched: true, operation: "webhook_receive", required_scope: "transport:manage", resource_id: parts[3], child_id: "", streaming: false)
    _no_route()

fn _escape_json(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")

pub fn json_response(status: i64, body: text) -> ApiResponse:
    ApiResponse(status: status, content_type: "application/json", body: body)

pub fn error_response(status: i64, code: text, detail: text) -> ApiResponse:
    json_response(status, "{\"error\":\"{_escape_json(code)}\",\"detail\":\"{_escape_json(detail)}\"}")

pub fn accepted_response(resource_kind: text, resource_id: text) -> ApiResponse:
    json_response(202, "{\"accepted\":true,\"{_escape_json(resource_kind)}_id\":\"{_escape_json(resource_id)}\"}")

export ApiRoute, ApiResponse
export idempotency_key_valid, parse_api_route, json_response, error_response, accepted_response
