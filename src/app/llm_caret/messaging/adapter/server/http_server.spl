"""Primitive HTTP/SSE listener adapter for canonical messaging."""

use std.nogc_sync_mut.http_server.{SimpleHttpServer, SecureServerPolicy,
    plaintext_development_capability, Router, HttpRequest, HttpResponse,
    HttpStatus, http_method_to_text}
use app.io.mod.{current_time_ms}
use app.llm_caret.messaging.adapter.server.auth.{AuthPrincipal, bearer_token}
use app.llm_caret.messaging.adapter.server.primitive_dispatch.{PrimitiveRequest, PrimitiveMessagingApplication}

var PRIMITIVE_HTTP_APP: PrimitiveMessagingApplication = PrimitiveMessagingApplication.memory()
var PRIMITIVE_HTTP_TOKEN = ""
var PRIMITIVE_HTTP_IDENTITY = ""
var PRIMITIVE_HTTP_WORKSPACE = ""
var PRIMITIVE_HTTP_SCOPES: [text] = []
var PRIMITIVE_HTTP_EXPIRES_AT: i64 = 0

fn primitive_http_status(code: i64) -> HttpStatus:
    if code == 200: return HttpStatus.OK
    if code == 201: return HttpStatus.Created
    if code == 202: return HttpStatus.Accepted
    if code == 400: return HttpStatus.BadRequest
    if code == 401: return HttpStatus.Unauthorized
    if code == 403: return HttpStatus.Forbidden
    if code == 404: return HttpStatus.NotFound
    if code == 409: return HttpStatus.Conflict
    if code == 413: return HttpStatus.PayloadTooLarge
    if code == 429: return HttpStatus.TooManyRequests
    if code == 501: return HttpStatus.NotImplemented
    HttpStatus.InternalError

fn primitive_http_principal(req: HttpRequest, now: i64) -> AuthPrincipal:
    val supplied = bearer_token(req.header("Authorization"))
    val authenticated = PRIMITIVE_HTTP_TOKEN != "" and supplied == PRIMITIVE_HTTP_TOKEN
    AuthPrincipal(authenticated: authenticated, identity_id: PRIMITIVE_HTTP_IDENTITY,
        workspace_id: PRIMITIVE_HTTP_WORKSPACE, scopes: PRIMITIVE_HTTP_SCOPES,
        expires_at: if authenticated: PRIMITIVE_HTTP_EXPIRES_AT else: now)

fn primitive_http_handle(req: HttpRequest) -> HttpResponse:
    val now = current_time_ms()
    val result = PRIMITIVE_HTTP_APP.handle(PrimitiveRequest(
        method: http_method_to_text(req.method), path: req.path, body: req.body,
        idempotency_key: req.header("Idempotency-Key"),
        principal: primitive_http_principal(req, now), occurred_at: now))
    HttpResponse(status: primitive_http_status(result.status),
        headers: [("Content-Type", result.content_type), ("Cache-Control", "no-store"),
            ("X-Content-Type-Options", "nosniff")], body: result.body)

fn configure_primitive_http_server(database_path: text, token: text, identity_id: text,
        workspace_id: text, scopes: [text], expires_at: i64):
    PRIMITIVE_HTTP_APP.close()
    PRIMITIVE_HTTP_APP = PrimitiveMessagingApplication.open(database_path)
    PRIMITIVE_HTTP_APP.configure_enrollment_secret(token)
    PRIMITIVE_HTTP_TOKEN = token
    PRIMITIVE_HTTP_IDENTITY = identity_id
    PRIMITIVE_HTTP_WORKSPACE = workspace_id
    PRIMITIVE_HTTP_SCOPES = scopes
    PRIMITIVE_HTTP_EXPIRES_AT = expires_at

fn run_primitive_http_server(host: text, port: i64) -> Result<(), text>:
    var router = Router.new()
    router.mount("/v1", primitive_http_handle)
    router.set_not_found(primitive_http_handle)
    print "llm-caret messaging listening on " + host + ":" + port.to_text()
    var server = SimpleHttpServer.new(host, port.to_i32(), router)
    if host != "127.0.0.1" and host != "::1" and host != "localhost":
        return server.start()
    val capability = plaintext_development_capability(
        "llm-caret messaging loopback listener")?
    server.with_policy(SecureServerPolicy.plaintext_dev(capability))
    server.start_plaintext(capability)

export configure_primitive_http_server, run_primitive_http_server
