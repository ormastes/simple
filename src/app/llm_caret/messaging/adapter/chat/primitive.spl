"""Authoritative primitive-room transport backed by PureDatabase."""

use std.crypto.sha256.{sha256_text}
use app.io.mod.{current_time_ms}
use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.application.room_service.{create_direct_room}
use app.llm_caret.messaging.adapter.chat.capability_registry.{chat_adapter_descriptor}
use app.llm_caret.messaging.adapter.store.pure_sql_store.{PureSqlMessagingStore}

struct PrimitiveDelivery:
    binding_id: text
    message_id: text
    room_seq: i64

class PrimitiveChatTransport with ChatTransportPort:
    store: PureSqlMessagingStore
    workspace_id: text
    identity_id: text
    bindings: [text]
    deliveries: [PrimitiveDelivery]

    static fn open(path: text, workspace_id: text, identity_id: text) -> PrimitiveChatTransport:
        PrimitiveChatTransport(store: PureSqlMessagingStore.open(path), workspace_id: workspace_id,
            identity_id: identity_id, bindings: [], deliveries: [])

    static fn memory(workspace_id: text, identity_id: text) -> PrimitiveChatTransport:
        PrimitiveChatTransport(store: PureSqlMessagingStore.open_memory(), workspace_id: workspace_id,
            identity_id: identity_id, bindings: [], deliveries: [])

    fn capabilities() -> TransportCapabilities:
        chat_adapter_descriptor("primitive").capabilities

    me connect(binding_id: text) -> text:
        if binding_id.trim() == "": return "binding_id_required"
        for existing in self.bindings:
            if existing == binding_id: return "connected:primitive:" + binding_id
        self.bindings.push(binding_id)
        "connected:primitive:" + binding_id

    fn connected(binding_id: text) -> bool:
        for existing in self.bindings:
            if existing == binding_id: return true
        false

    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        if not self.connected(binding_id): return "binding_not_connected"
        if binding_id != message.room_id.value: return "binding_room_mismatch"
        val appended = self.store.append_message(message, idempotency_key)
        if not appended.ok: return appended.error
        if not appended.duplicate:
            self.deliveries.push(PrimitiveDelivery(binding_id: binding_id,
                message_id: appended.message_id, room_seq: appended.room_seq))
        "accepted:" + appended.message_id + ":" + appended.room_seq.to_text()

    me mark_read(binding_id: text, external_message_id: text) -> text:
        if not self.connected(binding_id): return "binding_not_connected"
        for delivery in self.deliveries:
            if delivery.binding_id == binding_id and delivery.message_id == external_message_id:
                val advanced = self.store.advance_cursor(binding_id, self.identity_id,
                    delivery.room_seq, current_time_ms())
                if advanced.ok: return "local_cursor:" + delivery.room_seq.to_text()
                return advanced.error
        "external_message_not_found"

    me open_private(binding_id: text, identity_ids: [text]) -> text:
        if identity_ids.len() != 2 or identity_ids[0] == identity_ids[1]:
            return "private_room_requires_two_identities"
        val ordered = if identity_ids[0] < identity_ids[1]:
            identity_ids[0] + ":" + identity_ids[1]
        else:
            identity_ids[1] + ":" + identity_ids[0]
        val room_id = "dm-" + sha256_text(self.workspace_id + ":" + ordered).substring(0, 20)
        val created = create_direct_room(room_id, self.workspace_id,
            identity_ids[0], identity_ids[1], current_time_ms())
        if not created.accepted: return created.error
        val room_write = self.store.create_room(created.room)
        if not room_write.ok: return room_write.error
        for membership in created.memberships:
            val member_write = self.store.put_membership(membership)
            if not member_write.ok: return member_write.error
        self.connect(room_id)
        "primitive_direct_room:" + room_id

    fn history(binding_id: text, after_seq: i64, limit: i64) -> [RoomMessage]:
        if not self.connected(binding_id): return []
        self.store.message_history(binding_id, after_seq, limit)

    me close() -> bool: self.store.close()

export PrimitiveDelivery, PrimitiveChatTransport
