"""KakaoTalk public API subset: message-to-self and authorized friends only."""

use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.adapter.chat.capability_registry.{chat_adapter_descriptor}
use app.llm_caret.messaging.adapter.chat.rest_common.*

struct KakaoTarget:
    binding_id: text
    canonical_room_id: text
    kind: text
    friend_uuid: text

fn kakao_form_encode(value: text) -> text:
    # Kakao's payload is generated JSON. Encode every delimiter that can alter
    # application/x-www-form-urlencoded parsing while leaving UTF-8 text intact.
    value.replace("%", "%25").replace(" ", "%20").replace("\n", "%0A")
        .replace("\r", "%0D").replace("\"", "%22").replace("\\", "%5C")
        .replace("{", "%7B").replace("}", "%7D").replace("[", "%5B")
        .replace("]", "%5D").replace(":", "%3A").replace(",", "%2C")
        .replace("&", "%26").replace("=", "%3D").replace("+", "%2B")
        .replace("#", "%23").replace("?", "%3F")

class KakaoChatTransport with ChatTransportPort:
    user_access_token: text
    targets: [KakaoTarget]
    outbound_keys: [text]

    static fn new(user_access_token: text) -> KakaoChatTransport:
        KakaoChatTransport(user_access_token: user_access_token, targets: [], outbound_keys: [])
    fn capabilities() -> TransportCapabilities: chat_adapter_descriptor("kakao").capabilities
    me bind_self(binding_id: text, canonical_room_id: text) -> text:
        self.bind_target(binding_id, canonical_room_id, "self", "")
    me bind_friend(binding_id: text, canonical_room_id: text, friend_uuid: text) -> text:
        if friend_uuid == "": return "friend_uuid_required"
        self.bind_target(binding_id, canonical_room_id, "friend", friend_uuid)
    me bind_target(binding_id: text, canonical_room_id: text, kind: text, friend_uuid: text) -> text:
        if binding_id == "" or canonical_room_id == "": return "invalid_binding"
        for value in self.targets:
            if value.binding_id == binding_id: return "binding_exists"
        self.targets.push(KakaoTarget(binding_id: binding_id, canonical_room_id: canonical_room_id,
            kind: kind, friend_uuid: friend_uuid))
        "binding_attached"
    fn target(binding_id: text) -> KakaoTarget?:
        for value in self.targets:
            if value.binding_id == binding_id: return Some(value)
        nil
    me connect(binding_id: text) -> text:
        if self.user_access_token == "": return "user_access_token_required"
        if self.target(binding_id).?: "connected:kakao:" + binding_id else: "binding_not_found"
    fn prepare_send(binding_id: text, message: RoomMessage, idempotency_key: text) -> ChatHttpRequest:
        val bound = self.target(binding_id)
        if not bound.?: return rejected_request("binding_not_connected")
        if idempotency_key.len() < 8: return rejected_request("stable_idempotency_key_required")
        val template = "{\"object_type\":\"text\",\"text\":\"" + json_escape(message.body) +
            "\",\"link\":{\"web_url\":\"https://simple.invalid/primitive-room\"}}"
        var body = "template_object=" + kakao_form_encode(template)
        var endpoint = "https://kapi.kakao.com/v2/api/talk/memo/default/send"
        if bound.kind == "friend":
            endpoint = "https://kapi.kakao.com/v1/api/talk/friends/message/default/send"
            body = "receiver_uuids=" + kakao_form_encode("[\"" + bound.friend_uuid + "\"]") + "&" + body
        ChatHttpRequest(accepted: true, method: "POST", url: endpoint,
            headers: ["Authorization: Bearer " + self.user_access_token,
                "Content-Type: application/x-www-form-urlencoded",
                "X-Idempotency-Key: " + idempotency_key], body: body,
            idempotency_key: idempotency_key, error: "")
    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        for key in self.outbound_keys:
            if key == idempotency_key: return "kakao_outbox_duplicate:" + message.message_id.value
        val request = self.prepare_send(binding_id, message, idempotency_key)
        if not request.accepted: return request.error
        self.outbound_keys.push(idempotency_key)
        "kakao_limited_outbox:" + message.message_id.value
    me mark_read(binding_id: text, external_message_id: text) -> text:
        if not self.target(binding_id).?: return "binding_not_connected"
        "primitive_sidecar:mark_read:" + external_message_id
    me open_private(binding_id: text, identity_ids: [text]) -> text:
        if identity_ids.len() < 2: return "private_room_requires_two_identities"
        "primitive_sidecar:open_private"

export KakaoTarget, KakaoChatTransport, kakao_form_encode
