"""Versioned truthful capability snapshots for chat transport adapters."""

use app.llm_caret.messaging.domain.capability.{CapabilityLevel, TransportCapabilities}

struct ChatAdapterDescriptor:
    name: text
    tier: i64
    live_credential_required: bool
    capabilities: TransportCapabilities

fn transport_caps(room_create: CapabilityLevel, history: CapabilityLevel,
        thread: CapabilityLevel, private_message: CapabilityLevel,
        mention: CapabilityLevel, notify_all: CapabilityLevel,
        mark_read: CapabilityLevel, human_receipt: CapabilityLevel,
        webhook: CapabilityLevel) -> TransportCapabilities:
    TransportCapabilities(version: 1, account_provision: CapabilityLevel.Unsupported,
        room_create: room_create, room_membership: room_create, history_read: history,
        thread: thread, reply: if thread == CapabilityLevel.Unsupported: CapabilityLevel.Emulated else: CapabilityLevel.Native,
        private_message: private_message, native_mention: mention, notify_all: notify_all,
        mark_read: mark_read, human_read_receipt: human_receipt,
        edit: CapabilityLevel.Native, delete: CapabilityLevel.Native,
        attachments: CapabilityLevel.Native, webhook_events: webhook,
        history_backfill: history)

fn primitive_descriptor() -> ChatAdapterDescriptor:
    ChatAdapterDescriptor(name: "primitive", tier: 0, live_credential_required: false,
        capabilities: transport_caps(CapabilityLevel.Native, CapabilityLevel.Native,
            CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
            CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Emulated,
            CapabilityLevel.Native))

fn external_descriptor(name: text) -> ChatAdapterDescriptor:
    if name == "matrix":
        return ChatAdapterDescriptor(name: name, tier: 1, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Emulated,
                CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native))
    if name == "slack":
        return ChatAdapterDescriptor(name: name, tier: 1, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.PrimitiveSidecar, CapabilityLevel.Unsupported, CapabilityLevel.Native))
    if name == "teams":
        return ChatAdapterDescriptor(name: name, tier: 1, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.PrimitiveSidecar, CapabilityLevel.Native,
                CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Emulated, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.Unsupported, CapabilityLevel.Native))
    if name == "telegram":
        return ChatAdapterDescriptor(name: name, tier: 1, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.PrimitiveSidecar, CapabilityLevel.Native,
                CapabilityLevel.Emulated, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Emulated, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.Unsupported, CapabilityLevel.Native))
    if name == "google_chat" or name == "discord" or name == "mattermost":
        return ChatAdapterDescriptor(name: name, tier: 2, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Native, CapabilityLevel.Native, CapabilityLevel.Native,
                CapabilityLevel.Emulated, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.Unsupported, CapabilityLevel.Native))
    if name == "generic_http":
        return ChatAdapterDescriptor(name: name, tier: 2, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.PrimitiveSidecar, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.PrimitiveSidecar, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.Emulated, CapabilityLevel.Emulated,
                CapabilityLevel.PrimitiveSidecar, CapabilityLevel.Unsupported, CapabilityLevel.Native))
    if name == "line" or name == "kakao":
        return ChatAdapterDescriptor(name: name, tier: 3, live_credential_required: true,
            capabilities: transport_caps(CapabilityLevel.PrimitiveSidecar, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.PrimitiveSidecar, CapabilityLevel.PrimitiveSidecar,
                CapabilityLevel.Native, CapabilityLevel.Emulated,
                CapabilityLevel.PrimitiveSidecar, CapabilityLevel.Unsupported, CapabilityLevel.Native))
    ChatAdapterDescriptor(name: name, tier: -1, live_credential_required: false,
        capabilities: transport_caps(CapabilityLevel.Unsupported, CapabilityLevel.Unsupported,
            CapabilityLevel.Unsupported, CapabilityLevel.Unsupported, CapabilityLevel.Unsupported,
            CapabilityLevel.Unsupported, CapabilityLevel.Unsupported, CapabilityLevel.Unsupported,
            CapabilityLevel.Unsupported))

fn chat_adapter_descriptor(name: text) -> ChatAdapterDescriptor:
    if name == "primitive": return primitive_descriptor()
    external_descriptor(name)

fn supported_chat_adapters() -> [text]:
    ["primitive", "matrix", "slack", "teams", "telegram", "google_chat",
        "discord", "mattermost", "generic_http", "line", "kakao"]

export ChatAdapterDescriptor, chat_adapter_descriptor, supported_chat_adapters
