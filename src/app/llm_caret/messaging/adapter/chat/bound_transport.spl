"""Shared normalized runtime for concrete chat transport bindings.

Network SDK clients feed this adapter only after webhook/OAuth verification.
The queue is deliberately transport-neutral and is also the contract-test
simulator; simulator evidence never counts as a live platform pass.
"""

use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.adapter.chat.capability_registry.{ChatAdapterDescriptor, chat_adapter_descriptor}
use app.llm_caret.messaging.application.fallback_planner.{TransportOperation, plan_transport_operation}

struct TransportEnvelope:
    binding_id: text
    canonical_message_id: text
    external_message_id: text
    idempotency_key: text
    body: text
    state: text

struct TransportMutation:
    accepted: bool
    duplicate: bool
    external_message_id: text
    execution: text
    error: text

class BoundChatTransport with ChatTransportPort:
    descriptor: ChatAdapterDescriptor
    bindings: [text]
    outbound: [TransportEnvelope]
    inbound_event_keys: [text]

    static fn for_name(name: text) -> BoundChatTransport:
        BoundChatTransport(descriptor: chat_adapter_descriptor(name), bindings: [],
            outbound: [], inbound_event_keys: [])

    fn capabilities() -> TransportCapabilities: self.descriptor.capabilities

    me connect(binding_id: text) -> text:
        if self.descriptor.tier < 0: return "unsupported_transport"
        if binding_id.trim() == "": return "binding_id_required"
        "connect:" + self.descriptor.name + ":" + binding_id

    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        if binding_id.trim() == "" or message.message_id.value == "": return "invalid_outbound"
        if idempotency_key.len() < 8: return "stable_idempotency_key_required"
        "enqueue:" + self.descriptor.name + ":" + message.message_id.value

    me mark_read(binding_id: text, external_message_id: text) -> text:
        val decision = plan_transport_operation(self.descriptor.capabilities, TransportOperation.MarkRead)
        if not decision.accepted: return decision.error
        decision.execution + ":" + binding_id + ":" + external_message_id

    me open_private(binding_id: text, identity_ids: [text]) -> text:
        val decision = plan_transport_operation(self.descriptor.capabilities, TransportOperation.OpenPrivate)
        if not decision.accepted: return decision.error
        if identity_ids.len() < 2: return "private_room_requires_two_identities"
        decision.execution + ":" + binding_id

    me attach_binding(binding_id: text) -> TransportMutation:
        if binding_id.trim() == "":
            return TransportMutation(accepted: false, duplicate: false, external_message_id: "",
                execution: "", error: "binding_id_required")
        for existing in self.bindings:
            if existing == binding_id:
                return TransportMutation(accepted: true, duplicate: true, external_message_id: "",
                    execution: "binding_exists", error: "")
        self.bindings.push(binding_id)
        TransportMutation(accepted: true, duplicate: false, external_message_id: "",
            execution: "binding_attached", error: "")

    fn has_binding(binding_id: text) -> bool:
        for existing in self.bindings:
            if existing == binding_id: return true
        false

    me enqueue_send(binding_id: text, message: RoomMessage, idempotency_key: text) -> TransportMutation:
        if not self.has_binding(binding_id):
            return TransportMutation(accepted: false, duplicate: false, external_message_id: "",
                execution: "", error: "binding_not_connected")
        if idempotency_key.len() < 8:
            return TransportMutation(accepted: false, duplicate: false, external_message_id: "",
                execution: "", error: "stable_idempotency_key_required")
        for envelope in self.outbound:
            if envelope.idempotency_key == idempotency_key:
                return TransportMutation(accepted: true, duplicate: true,
                    external_message_id: envelope.external_message_id,
                    execution: "transactional_outbox", error: "")
        val external_id = self.descriptor.name + "-pending-" + (self.outbound.len() + 1).to_text()
        self.outbound.push(TransportEnvelope(binding_id: binding_id,
            canonical_message_id: message.message_id.value, external_message_id: external_id,
            idempotency_key: idempotency_key, body: message.body, state: "queued"))
        TransportMutation(accepted: true, duplicate: false, external_message_id: external_id,
            execution: "transactional_outbox", error: "")

    me accept_inbound_event(binding_id: text, external_event_id: text) -> TransportMutation:
        if not self.has_binding(binding_id):
            return TransportMutation(accepted: false, duplicate: false, external_message_id: "",
                execution: "", error: "binding_not_connected")
        val key = binding_id + ":" + external_event_id
        for seen in self.inbound_event_keys:
            if seen == key:
                return TransportMutation(accepted: true, duplicate: true,
                    external_message_id: external_event_id, execution: "inbound_dedup", error: "")
        self.inbound_event_keys.push(key)
        TransportMutation(accepted: true, duplicate: false, external_message_id: external_event_id,
            execution: "normalized_inbound_event", error: "")

export TransportEnvelope, TransportMutation, BoundChatTransport
