"""Discord REST adapter core for bound channels, DMs, and threads."""

use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.adapter.chat.capability_registry.{chat_adapter_descriptor}
use app.llm_caret.messaging.adapter.chat.rest_common.*

class DiscordChatTransport with ChatTransportPort:
    bot_token: text
    bindings: [RestRoomBinding]
    inbound_keys: [text]
    outbound_keys: [text]

    static fn new(bot_token: text) -> DiscordChatTransport:
        DiscordChatTransport(bot_token: bot_token, bindings: [], inbound_keys: [], outbound_keys: [])
    fn capabilities() -> TransportCapabilities: chat_adapter_descriptor("discord").capabilities
    me bind_channel(binding_id: text, canonical_room_id: text, channel_id: text) -> text:
        if binding_id == "" or canonical_room_id == "" or channel_id == "": return "invalid_binding"
        for value in self.bindings:
            if value.binding_id == binding_id: return "binding_exists"
        self.bindings.push(RestRoomBinding(binding_id: binding_id,
            canonical_room_id: canonical_room_id, external_room_id: channel_id))
        "binding_attached"
    fn binding(binding_id: text) -> RestRoomBinding?:
        for value in self.bindings:
            if value.binding_id == binding_id: return Some(value)
        nil
    me connect(binding_id: text) -> text:
        if self.bot_token == "": return "bot_token_required"
        if self.binding(binding_id).?: "connected:discord:" + binding_id else: "binding_not_found"
    fn prepare_send(binding_id: text, message: RoomMessage, idempotency_key: text) -> ChatHttpRequest:
        val bound = self.binding(binding_id)
        if not bound.?: return rejected_request("binding_not_connected")
        if idempotency_key.len() < 8: return rejected_request("stable_idempotency_key_required")
        var body = "{\"content\":\"" + json_escape(message.body) + "\""
        if message.external_ref != "":
            body = body + ",\"message_reference\":{\"message_id\":\"" + json_escape(message.external_ref) + "\"}"
        body = body + "}"
        ChatHttpRequest(accepted: true, method: "POST",
            url: "https://discord.com/api/v10/channels/" + bound.external_room_id + "/messages",
            headers: ["Authorization: Bot " + self.bot_token, "Content-Type: application/json",
                "X-Audit-Log-Reason: llm-caret-" + idempotency_key], body: body,
            idempotency_key: idempotency_key, error: "")
    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        for key in self.outbound_keys:
            if key == idempotency_key: return "discord_outbox_duplicate:" + message.message_id.value
        val request = self.prepare_send(binding_id, message, idempotency_key)
        if not request.accepted: return request.error
        self.outbound_keys.push(idempotency_key)
        "discord_outbox:" + message.message_id.value
    me mark_read(binding_id: text, external_message_id: text) -> text:
        if not self.binding(binding_id).?: return "binding_not_connected"
        "primitive_sidecar:mark_read:" + external_message_id
    me open_private(binding_id: text, identity_ids: [text]) -> text:
        if identity_ids.len() < 2: return "private_room_requires_two_identities"
        "discord_native_dm:create"

export DiscordChatTransport
