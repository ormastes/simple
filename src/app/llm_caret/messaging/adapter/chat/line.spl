"""LINE Messaging API subset for already-bound users, groups, and quote tokens."""

use app.llm_caret.messaging.port.contracts.{ChatTransportPort}
use app.llm_caret.messaging.domain.capability.{TransportCapabilities}
use app.llm_caret.messaging.domain.model.{RoomMessage}
use app.llm_caret.messaging.adapter.chat.capability_registry.{chat_adapter_descriptor}
use app.llm_caret.messaging.adapter.chat.rest_common.*

class LineChatTransport with ChatTransportPort:
    channel_access_token: text
    bindings: [RestRoomBinding]
    outbound_keys: [text]

    static fn new(channel_access_token: text) -> LineChatTransport:
        LineChatTransport(channel_access_token: channel_access_token, bindings: [], outbound_keys: [])
    fn capabilities() -> TransportCapabilities: chat_adapter_descriptor("line").capabilities
    me bind_existing_chat(binding_id: text, canonical_room_id: text, external_chat_id: text) -> text:
        if binding_id == "" or canonical_room_id == "" or external_chat_id == "": return "invalid_binding"
        for value in self.bindings:
            if value.binding_id == binding_id: return "binding_exists"
        self.bindings.push(RestRoomBinding(binding_id: binding_id,
            canonical_room_id: canonical_room_id, external_room_id: external_chat_id))
        "binding_attached"
    fn binding(binding_id: text) -> RestRoomBinding?:
        for value in self.bindings:
            if value.binding_id == binding_id: return Some(value)
        nil
    me connect(binding_id: text) -> text:
        if self.channel_access_token == "": return "channel_access_token_required"
        if self.binding(binding_id).?: "connected:line:" + binding_id else: "binding_not_found"
    fn prepare_send(binding_id: text, message: RoomMessage, idempotency_key: text) -> ChatHttpRequest:
        val bound = self.binding(binding_id)
        if not bound.?: return rejected_request("binding_not_connected")
        if idempotency_key.len() < 8: return rejected_request("stable_idempotency_key_required")
        var part = "{\"type\":\"text\",\"text\":\"" + json_escape(message.body) + "\""
        if message.external_ref != "": part = part + ",\"quoteToken\":\"" + json_escape(message.external_ref) + "\""
        part = part + "}"
        val body = "{\"to\":\"" + json_escape(bound.external_room_id) + "\",\"messages\":[" + part + "]}"
        ChatHttpRequest(accepted: true, method: "POST",
            url: "https://api.line.me/v2/bot/message/push",
            headers: ["Authorization: Bearer " + self.channel_access_token,
                "Content-Type: application/json", "X-Line-Retry-Key: " + idempotency_key],
            body: body, idempotency_key: idempotency_key, error: "")
    me send(binding_id: text, message: RoomMessage, idempotency_key: text) -> text:
        for key in self.outbound_keys:
            if key == idempotency_key: return "line_outbox_duplicate:" + message.message_id.value
        val request = self.prepare_send(binding_id, message, idempotency_key)
        if not request.accepted: return request.error
        self.outbound_keys.push(idempotency_key)
        "line_outbox:" + message.message_id.value
    me mark_read(binding_id: text, external_message_id: text) -> text:
        if not self.binding(binding_id).?: return "binding_not_connected"
        "line_native_mark_as_read_when_enabled:" + external_message_id
    me open_private(binding_id: text, identity_ids: [text]) -> text:
        if identity_ids.len() < 2: return "private_room_requires_two_identities"
        "primitive_sidecar:open_private"

export LineChatTransport
