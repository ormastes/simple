"""Compiled database carrier boundary for LLM Caret messaging.

This is the entry closure for the cached SMF library or native worker. All
persistence remains in the in-tree pure-Simple PureDatabase adapter.
"""

use app.llm_caret.messaging.adapter.store.pure_sql_store.{PureSqlMessagingStore}
use std.cli.cli_util.{get_cli_args, get_flag_value}

class MessagingDatabaseWorker:
    store: PureSqlMessagingStore

    static fn open(path: text) -> MessagingDatabaseWorker:
        MessagingDatabaseWorker(store: PureSqlMessagingStore.open(path))

    static fn memory() -> MessagingDatabaseWorker:
        MessagingDatabaseWorker(store: PureSqlMessagingStore.open_memory())

    fn ready() -> bool: self.store.ready()
    fn room_count() -> i64: self.store.room_count()
    fn message_count() -> i64: self.store.message_count()
    me close() -> bool: self.store.close()

export MessagingDatabaseWorker

fn main() -> i64:
    val args = get_cli_args()
    val database = get_flag_value(args, "--db") ?? ".simple/state/llm-caret-messaging.db"
    val operation = get_flag_value(args, "--operation") ?? "probe"
    var worker = MessagingDatabaseWorker.open(database)
    if not worker.ready():
        print "{\"ok\":false,\"error\":\"database_not_ready\",\"detail\":\"" +
            worker.store.initialization_error.replace("\"", "'") + "\",\"metadata_rows\":" +
            worker.store.metadata_count().to_text() + ",\"metadata_value\":\"" +
            worker.store.metadata_schema_value() + "\"}"
        worker.close()
        return 1
    if operation == "probe":
        print "{\"ok\":true,\"engine\":\"PureDatabase\",\"carrier\":\"compiled\",\"rooms\":" +
            worker.room_count().to_text() + ",\"messages\":" + worker.message_count().to_text() + "}"
        worker.close()
        return 0
    print "{\"ok\":false,\"error\":\"unsupported_database_operation\"}"
    worker.close()
    2
