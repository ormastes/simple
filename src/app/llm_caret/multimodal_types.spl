# codex-impl
# Versioned, provider-neutral multimodal and image-to-Markdown contracts.

enum ImageValueStatusV1:
    observed
    calibrated
    missing
    ambiguous

struct SourceBoundsV1:
    page_index: i64
    x: i64
    y: i64
    width: i64
    height: i64

struct ContentPartV1:
    kind: text
    text_content: text
    artifact_id: text
    mime_type: text
    width: i64
    height: i64
    sha256: text
    detail: text
    image_data_url: text

struct MultimodalMessageV1:
    role: text
    parts: [ContentPartV1]

struct ModelProfileV1:
    profile_id: text
    provider: text
    endpoint: text
    model_id: text
    model_revision: text
    secret_ref: text
    vision: bool
    structured_output: bool
    remote_egress: bool
    fallback_provider: text
    max_images: i64
    max_pixels: i64
    max_request_bytes: i64
    max_output_tokens: i64
    timeout_ms: i64
    max_concurrency: i64
    trust_scope: text

struct MultimodalRequestV1:
    messages: [MultimodalMessageV1]
    profile: ModelProfileV1
    prompt_version: text
    schema_version: text
    preprocessing_version: text

struct VisionCapabilitiesV1:
    vision: bool
    structured_output: bool
    mime_types: [text]
    detail_modes: [text]
    max_images: i64
    max_pixels: i64

struct ModelCompletionV1:
    content: text
    provider: text
    model_id: text
    raw: text
    input_tokens: i64
    output_tokens: i64
    error_code: text
    error_message: text

struct MultimodalErrorV1:
    code: text
    message: text
    retryable: bool
    stage: text

struct TextSpanV1:
    text_content: text
    language: text
    script: text
    confidence_milli: i64
    highlighted: bool
    handwritten: bool
    source_box: SourceBoundsV1

struct TableCellV1:
    row: i64
    column: i64
    row_span: i64
    column_span: i64
    content: text
    status: text
    confidence_milli: i64
    highlighted: bool
    handwritten: bool
    source_box: SourceBoundsV1

struct TableV1:
    table_id: text
    title: text
    row_count: i64
    column_count: i64
    cells: [TableCellV1]
    source_box: SourceBoundsV1

struct ChartPointV1:
    x_lexeme: text
    y_lexeme: text
    x_value: f64
    y_value: f64
    x_present: bool
    y_present: bool
    status: ImageValueStatusV1
    uncertainty_milli: i64
    uncertainty_low: f64
    uncertainty_high: f64
    calibration_method: text
    source_box: SourceBoundsV1

struct ChartSeriesV1:
    name: text
    unit: text
    points: [ChartPointV1]

struct ChartTickV1:
    lexeme: text
    value: f64
    value_present: bool
    source_box: SourceBoundsV1

struct ChartLegendEntryV1:
    label: text
    series_name: text
    marker: text
    source_box: SourceBoundsV1

struct ChartAnnotationV1:
    annotation_id: text
    text_content: text
    target_series: text
    target_point_index: i64
    relation: text
    source_box: SourceBoundsV1

struct ChartPanelV1:
    panel_id: text
    chart_type: text
    title: text
    x_axis: text
    y_axis: text
    x_scale: text
    y_scale: text
    x_min: f64
    x_max: f64
    x_range_present: bool
    y_min: f64
    y_max: f64
    y_range_present: bool
    x_ticks: [ChartTickV1]
    y_ticks: [ChartTickV1]
    shared_legend_id: text
    legend_entries: [ChartLegendEntryV1]
    annotations: [ChartAnnotationV1]
    series: [ChartSeriesV1]
    source_box: SourceBoundsV1

struct ExtractionRegionV1:
    region_id: text
    category: text
    reading_order: i64
    markdown: text
    source_box: SourceBoundsV1
    confidence_milli: i64

struct ExtractionDocumentV1:
    schema_version: text
    source_artifact_id: text
    source_sha256: text
    width: i64
    height: i64
    categories: [text]
    regions: [ExtractionRegionV1]
    text_spans: [TextSpanV1]
    tables: [TableV1]
    charts: [ChartPanelV1]
    unresolved: [text]
    warnings: [text]

struct ExtractionReceiptV1:
    schema_version: text
    extraction_schema_version: text
    renderer_version: text
    status: text
    error_code: text
    source_artifact_id: text
    source_sha256: text
    source_width: i64
    source_height: i64
    markdown_path: text
    markdown_sha256: text
    structured_path: text
    structured_sha256: text
    result_sha256: text
    profile_fingerprint: text
    provider: text
    model_id: text
    model_revision: text
    prompt_version: text
    preprocessing_version: text
    load_ms: i64
    preprocess_ms: i64
    transport_ms: i64
    inference_ms: i64
    validation_ms: i64
    render_ms: i64
    cache_ms: i64
    retry_count: i64
    request_count: i64
    cache_hit: bool
    provenance_item_count: i64
    validation_check_count: i64
    validation_failure_count: i64
    warnings: [text]

struct ExtractionArtifactsV1:
    markdown_path: text
    structured_path: text
    receipt_path: text
    markdown_sha256: text
    structured_sha256: text
    receipt_sha256: text
    error: text

fn empty_source_bounds_v1() -> SourceBoundsV1:
    SourceBoundsV1(page_index: 0, x: 0, y: 0, width: 0, height: 0)

fn text_part_v1(content: text) -> ContentPartV1:
    ContentPartV1(kind: "text", text_content: content, artifact_id: "", mime_type: "", width: 0, height: 0, sha256: "", detail: "auto", image_data_url: "")

fn image_part_v1(artifact_id: text, mime_type: text, width: i64, height: i64, sha256: text, detail: text) -> ContentPartV1:
    ContentPartV1(kind: "image", text_content: "", artifact_id: artifact_id, mime_type: mime_type, width: width, height: height, sha256: sha256, detail: detail, image_data_url: "")

fn image_data_part_v1(artifact_id: text, mime_type: text, width: i64, height: i64, sha256: text, detail: text, image_data_url: text) -> ContentPartV1:
    ContentPartV1(kind: "image", text_content: "", artifact_id: artifact_id,
        mime_type: mime_type, width: width, height: height, sha256: sha256,
        detail: detail, image_data_url: image_data_url)

fn image_value_status_name_v1(status: ImageValueStatusV1) -> text:
    match status:
        case ImageValueStatusV1.observed: "observed"
        case ImageValueStatusV1.calibrated: "calibrated"
        case ImageValueStatusV1.missing: "missing"
        case ImageValueStatusV1.ambiguous: "ambiguous"
        case _: "ambiguous"

fn _is_loopback_http_endpoint_v1(endpoint: text) -> bool:
    if not endpoint.starts_with("http://"): return false
    val remainder = endpoint.substring(7)
    var authority = remainder
    val slash = authority.find("/")
    if slash >= 0: authority = authority.substring(0, slash)
    if authority.contains("@") or authority.contains("?") or authority.contains("#"):
        return false
    if authority == "localhost" or authority == "127.0.0.1" or authority == "[::1]":
        return true
    for prefix in ["localhost:", "127.0.0.1:", "[::1]:"]:
        if authority.starts_with(prefix):
            val port = authority.substring(prefix.len())
            if port == "": return false
            for ch in port:
                if ch < "0" or ch > "9": return false
            return true
    false

fn validate_model_profile_v1(profile: ModelProfileV1) -> text:
    if profile.profile_id == "": return "profile_id required"
    if profile.provider == "": return "provider required"
    if profile.model_id == "": return "model_id required"
    if not profile.vision: return "configured model is not vision-capable"
    if not profile.structured_output: return "configured model does not support structured output"
    if profile.fallback_provider != "": return "implicit fallback is prohibited"
    if profile.endpoint == "": return "image endpoint required"
    if not (profile.endpoint.starts_with("http://") or profile.endpoint.starts_with("https://")):
        return "image endpoint must use HTTP or HTTPS"
    if profile.remote_egress and not profile.endpoint.starts_with("https://"):
        return "remote image endpoint must use HTTPS"
    if profile.remote_egress and (profile.provider == "openai" or
            profile.provider == "claude_api") and profile.secret_ref == "":
        return "hosted image provider requires an API secret reference"
    if profile.endpoint.starts_with("https://") and not profile.remote_egress:
        return "remote endpoint requires explicit egress permission"
    if profile.endpoint.starts_with("http://") and not profile.remote_egress and not _is_loopback_http_endpoint_v1(profile.endpoint):
        return "local image endpoint must be loopback"
    if profile.max_images <= 0 or profile.max_images > 32:
        return "max_images must be between 1 and 32"
    if profile.max_pixels <= 0 or profile.max_pixels > 268435456:
        return "max_pixels must be between 1 and 268435456"
    if profile.max_request_bytes <= 0 or profile.max_request_bytes > 20971520:
        return "max_request_bytes must be between 1 and 20971520"
    if profile.timeout_ms <= 0 or profile.timeout_ms > 120000:
        return "timeout_ms must be between 1 and 120000"
    if profile.max_output_tokens <= 0 or profile.max_output_tokens > 65536:
        return "max_output_tokens must be between 1 and 65536"
    if profile.max_concurrency != 1:
        return "this synchronous adapter requires max_concurrency = 1"
    if profile.trust_scope == "": return "trust_scope required"
    ""

fn validate_content_part_v1(part: ContentPartV1) -> text:
    if part.kind == "text":
        if part.text_content == "": return "text content required"
        return ""
    if part.kind != "image": return "unsupported content part kind: " + part.kind
    if part.artifact_id == "": return "image artifact_id required"
    if not (part.mime_type == "image/png" or part.mime_type == "image/jpeg" or part.mime_type == "image/webp"):
        return "unsupported image MIME type: " + part.mime_type
    if part.width <= 0 or part.height <= 0: return "image dimensions must be positive"
    if part.sha256.len() != 64: return "image sha256 must contain 64 hex characters"
    for ch in part.sha256:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return "image sha256 must contain lowercase hex characters"
    if not (part.detail == "auto" or part.detail == "low" or part.detail == "high"):
        return "image detail must be auto, low, or high"
    if part.image_data_url != "" and not part.image_data_url.starts_with("data:" + part.mime_type + ";base64,"):
        return "image data URL does not match admitted MIME type"
    ""

fn validate_multimodal_request_v1(request: MultimodalRequestV1) -> text:
    val profile_error = validate_model_profile_v1(request.profile)
    if profile_error != "": return profile_error
    if request.messages.len() == 0: return "messages required"
    var image_count = 0
    var pixels = 0
    var encoded_bytes = 0
    for message in request.messages:
        if not (message.role == "system" or message.role == "developer" or message.role == "user" or message.role == "assistant"):
            return "unsupported message role: " + message.role
        if message.parts.len() == 0: return "message content parts required"
        for part in message.parts:
            val part_error = validate_content_part_v1(part)
            if part_error != "": return part_error
            if part.kind == "image":
                if message.role != "user":
                    return "image input parts require a user message"
                image_count = image_count + 1
                if part.width > request.profile.max_pixels or
                        part.height > request.profile.max_pixels or
                        part.width > request.profile.max_pixels / part.height:
                    return "decoded pixels exceed profile limit"
                val part_pixels = part.width * part.height
                if part_pixels > request.profile.max_pixels - pixels:
                    return "decoded pixels exceed profile limit"
                pixels = pixels + part_pixels
                if part.image_data_url != "": encoded_bytes = encoded_bytes + (part.image_data_url.len() * 3 / 4)
    if image_count == 0: return "at least one image required"
    if image_count > request.profile.max_images: return "image count exceeds profile limit"
    if pixels > request.profile.max_pixels: return "decoded pixels exceed profile limit"
    if encoded_bytes > request.profile.max_request_bytes: return "image bytes exceed profile limit"
    ""

fn validate_chart_point_v1(point: ChartPointV1) -> text:
    val status = image_value_status_name_v1(point.status)
    if point.uncertainty_milli < 0 or point.uncertainty_milli > 1000:
        return "chart uncertainty must be 0..1000"
    if point.uncertainty_high < point.uncertainty_low:
        return "chart uncertainty bounds are reversed"
    if status == "observed" and (point.x_lexeme == "" or point.y_lexeme == ""):
        return "observed chart values require visible numeric lexemes"
    if (status == "observed" or status == "calibrated") and
            (not point.x_present or not point.y_present):
        return "observed and calibrated chart values require numeric presence"
    if status == "calibrated":
        if point.calibration_method == "": return "calibrated chart values require a calibration method"
        if point.uncertainty_high < point.uncertainty_low:
            return "calibrated chart uncertainty bounds are reversed"
    if status == "missing" and (point.x_present or point.y_present):
        return "missing chart values cannot contain numeric values"
    if not point.x_present and point.x_lexeme == "": return "unresolved x value requires a visible or ambiguous lexeme"
    if not point.y_present and point.y_lexeme == "": return "unresolved y value requires a visible or ambiguous lexeme"
    ""

fn _source_bounds_inside_v1(bounds: SourceBoundsV1, width: i64, height: i64) -> bool:
    bounds.page_index >= 0 and bounds.x >= 0 and bounds.y >= 0 and
        bounds.width > 0 and bounds.height > 0 and
        bounds.x + bounds.width <= width and bounds.y + bounds.height <= height

fn _image_category_valid_v1(category: text) -> bool:
    for allowed in ["printed_text", "table", "form", "highlight", "annotation",
            "handwriting", "signature", "stamp_seal", "single_chart",
            "multiple_charts", "cell_distribution", "histogram", "line_chart",
            "bar_chart", "scatter_plot", "area_chart", "pie_chart", "donut_chart",
            "box_plot", "violin_plot", "heatmap", "contour_plot", "scientific_plot",
            "radar_chart", "bubble_chart", "candlestick_chart", "waterfall_chart",
            "treemap", "sunburst", "funnel_chart", "polar_chart", "choropleth",
            "density_plot", "error_bar_chart",
            "flowchart", "network_diagram", "schematic", "timeline", "gantt",
            "diagram", "equation", "chemical_structure", "musical_notation",
            "code", "map", "photo", "screenshot", "barcode", "qr_code",
            "mixed_page", "unknown"]:
        if category == allowed: return true
    false

fn chart_type_valid_v1(chart_type: text) -> bool:
    for allowed in ["line", "bar", "scatter", "area", "pie", "donut",
            "histogram", "box", "violin", "heatmap", "contour",
            "cell_distribution", "scientific", "radar", "bubble", "candlestick",
            "waterfall", "treemap", "sunburst", "funnel", "polar", "choropleth",
            "density", "error_bar", "unknown"]:
        if chart_type == allowed: return true
    false

fn validate_extraction_document_v1(document: ExtractionDocumentV1) -> text:
    if document.schema_version != "simple.image-extraction.v2": return "unsupported extraction schema"
    if document.source_artifact_id == "": return "source_artifact_id required"
    if document.source_sha256.len() != 64: return "source_sha256 must contain 64 hex characters"
    for ch in document.source_sha256:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return "source_sha256 must contain lowercase hex characters"
    if document.width <= 0 or document.height <= 0: return "source dimensions must be positive"
    for category in document.categories:
        if not _image_category_valid_v1(category): return "unsupported image category: " + category
    var region_index = 0
    while region_index < document.regions.len():
        val region = document.regions[region_index]
        if region.region_id == "" or region.category == "": return "region identity and category required"
        if not _image_category_valid_v1(region.category): return "unsupported image region category: " + region.category
        if not _source_bounds_inside_v1(region.source_box, document.width, document.height):
            return "region source bounds exceed source dimensions"
        var other_region = region_index + 1
        while other_region < document.regions.len():
            if document.regions[other_region].region_id == region.region_id: return "duplicate region_id"
            other_region = other_region + 1
        region_index = region_index + 1
    for span in document.text_spans:
        if span.text_content == "": return "text span content required"
        if span.confidence_milli < 0 or span.confidence_milli > 1000: return "text confidence must be 0..1000"
        if not _source_bounds_inside_v1(span.source_box, document.width, document.height):
            return "text source bounds exceed source dimensions"
    var table_index = 0
    while table_index < document.tables.len():
        val table = document.tables[table_index]
        if table.table_id == "": return "table_id required"
        if table.row_count <= 0 or table.column_count <= 0: return "table dimensions must be positive"
        if table.row_count > 1024 or table.column_count > 1024 or
                table.row_count * table.column_count > 65536:
            return "table dimensions exceed extraction limits"
        if table.cells.len() > 4096: return "table cell count exceeds extraction limits"
        if not _source_bounds_inside_v1(table.source_box, document.width, document.height):
            return "table source bounds exceed source dimensions"
        var cell_index = 0
        while cell_index < table.cells.len():
            val cell = table.cells[cell_index]
            if cell.row < 0 or cell.column < 0 or cell.row >= table.row_count or cell.column >= table.column_count:
                return "table cell coordinate exceeds table dimensions"
            if cell.row_span <= 0 or cell.column_span <= 0: return "table cell spans must be positive"
            if not (cell.status == "observed" or cell.status == "missing" or cell.status == "ambiguous"):
                return "unsupported table cell status"
            if cell.confidence_milli < 0 or cell.confidence_milli > 1000:
                return "table cell confidence must be 0..1000"
            if cell.row + cell.row_span > table.row_count or cell.column + cell.column_span > table.column_count:
                return "table cell span exceeds table dimensions"
            if not _source_bounds_inside_v1(cell.source_box, document.width, document.height):
                return "table cell source bounds exceed source dimensions"
            var other_index = cell_index + 1
            while other_index < table.cells.len():
                val other = table.cells[other_index]
                val rows_overlap = cell.row < other.row + other.row_span and other.row < cell.row + cell.row_span
                val columns_overlap = cell.column < other.column + other.column_span and other.column < cell.column + cell.column_span
                if rows_overlap and columns_overlap: return "table cells overlap"
                other_index = other_index + 1
            cell_index = cell_index + 1
        var row = 0
        while row < table.row_count:
            var column = 0
            while column < table.column_count:
                var coverage = 0
                for cell in table.cells:
                    if row >= cell.row and row < cell.row + cell.row_span and
                            column >= cell.column and column < cell.column + cell.column_span:
                        coverage = coverage + 1
                if coverage != 1: return "table topology must represent every cell exactly once"
                column = column + 1
            row = row + 1
        var other_table = table_index + 1
        while other_table < document.tables.len():
            if document.tables[other_table].table_id == table.table_id: return "duplicate table_id"
            other_table = other_table + 1
        table_index = table_index + 1
    var chart_index = 0
    while chart_index < document.charts.len():
        val chart = document.charts[chart_index]
        if chart.panel_id == "": return "chart panel_id required"
        if chart.chart_type == "": return "chart type required"
        if not chart_type_valid_v1(chart.chart_type):
            return "unsupported chart type: " + chart.chart_type
        if chart.series.len() == 0: return "chart requires at least one series"
        if not (chart.x_scale == "linear" or chart.x_scale == "log" or
                chart.x_scale == "category" or chart.x_scale == "time" or chart.x_scale == "unknown"):
            return "unsupported chart x scale"
        if not (chart.y_scale == "linear" or chart.y_scale == "log" or
                chart.y_scale == "category" or chart.y_scale == "time" or chart.y_scale == "unknown"):
            return "unsupported chart y scale"
        if chart.x_range_present and chart.x_max < chart.x_min: return "chart x range is reversed"
        if chart.y_range_present and chart.y_max < chart.y_min: return "chart y range is reversed"
        if chart.x_scale == "log" and chart.x_range_present and chart.x_min <= 0.0:
            return "logarithmic chart x range must be positive"
        if chart.y_scale == "log" and chart.y_range_present and chart.y_min <= 0.0:
            return "logarithmic chart y range must be positive"
        if chart.x_ticks.len() > 4096 or chart.y_ticks.len() > 4096:
            return "chart tick count exceeds extraction limits"
        if chart.legend_entries.len() > 1024 or chart.annotations.len() > 4096:
            return "chart metadata count exceeds extraction limits"
        if not _source_bounds_inside_v1(chart.source_box, document.width, document.height):
            return "chart source bounds exceed source dimensions"
        for tick in chart.x_ticks + chart.y_ticks:
            if tick.lexeme == "": return "chart tick lexeme required"
            if not _source_bounds_inside_v1(tick.source_box, document.width, document.height):
                return "chart tick source bounds exceed source dimensions"
        for tick in chart.x_ticks:
            if tick.value_present and chart.x_range_present and
                    (tick.value < chart.x_min or tick.value > chart.x_max):
                return "chart x tick lies outside declared range"
            if tick.value_present and chart.x_scale == "log" and tick.value <= 0.0:
                return "logarithmic chart x tick must be positive"
        for tick in chart.y_ticks:
            if tick.value_present and chart.y_range_present and
                    (tick.value < chart.y_min or tick.value > chart.y_max):
                return "chart y tick lies outside declared range"
            if tick.value_present and chart.y_scale == "log" and tick.value <= 0.0:
                return "logarithmic chart y tick must be positive"
        for legend in chart.legend_entries:
            if legend.label == "" or legend.series_name == "": return "chart legend label and series required"
            if not _source_bounds_inside_v1(legend.source_box, document.width, document.height):
                return "chart legend source bounds exceed source dimensions"
        for annotation in chart.annotations:
            if annotation.annotation_id == "" or annotation.text_content == "" or annotation.relation == "":
                return "chart annotation identity, text, and relation required"
            if annotation.target_point_index < -1: return "chart annotation point index is invalid"
            if not _source_bounds_inside_v1(annotation.source_box, document.width, document.height):
                return "chart annotation source bounds exceed source dimensions"
        for series in chart.series:
            if chart.series.len() > 1024: return "chart series count exceeds extraction limits"
            if series.name == "": return "chart series name required"
            if series.points.len() == 0: return "chart series requires numeric samples"
            if series.points.len() > 1048576: return "chart point count exceeds extraction limits"
            for point in series.points:
                val point_error = validate_chart_point_v1(point)
                if point_error != "": return point_error
                if not _source_bounds_inside_v1(point.source_box, document.width, document.height):
                    return "chart sample source bounds exceed source dimensions"
        var series_index = 0
        while series_index < chart.series.len():
            var other_series = series_index + 1
            while other_series < chart.series.len():
                if chart.series[other_series].name == chart.series[series_index].name:
                    return "duplicate chart series name"
                other_series = other_series + 1
            series_index = series_index + 1
        for legend in chart.legend_entries:
            var legend_target_found = false
            for series in chart.series:
                if series.name == legend.series_name: legend_target_found = true
            if not legend_target_found: return "chart legend references an unknown series"
        var annotation_index = 0
        while annotation_index < chart.annotations.len():
            val annotation = chart.annotations[annotation_index]
            var annotation_target_found = annotation.target_series == "" and annotation.target_point_index == -1
            for series in chart.series:
                if series.name == annotation.target_series:
                    if annotation.target_point_index == -1 or annotation.target_point_index < series.points.len():
                        annotation_target_found = true
            if not annotation_target_found: return "chart annotation target is invalid"
            var other_annotation = annotation_index + 1
            while other_annotation < chart.annotations.len():
                if chart.annotations[other_annotation].annotation_id == annotation.annotation_id:
                    return "duplicate chart annotation_id"
                other_annotation = other_annotation + 1
            annotation_index = annotation_index + 1
        var other_chart = chart_index + 1
        while other_chart < document.charts.len():
            if document.charts[other_chart].panel_id == chart.panel_id: return "duplicate chart panel_id"
            if chart.shared_legend_id != "" and
                    document.charts[other_chart].shared_legend_id == chart.shared_legend_id:
                val other_legends = document.charts[other_chart].legend_entries
                if other_legends.len() != chart.legend_entries.len():
                    return "shared legend entries differ across panels"
                var shared_index = 0
                while shared_index < chart.legend_entries.len():
                    val left = chart.legend_entries[shared_index]
                    val right = other_legends[shared_index]
                    if left.label != right.label or left.series_name != right.series_name or left.marker != right.marker:
                        return "shared legend entries differ across panels"
                    shared_index = shared_index + 1
            other_chart = other_chart + 1
        chart_index = chart_index + 1
    ""

fn model_completion_error_v1(code: text, message: text) -> ModelCompletionV1:
    ModelCompletionV1(content: "", provider: "", model_id: "", raw: "",
        input_tokens: 0, output_tokens: 0, error_code: code, error_message: message)
