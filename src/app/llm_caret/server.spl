# LLM Caret - HTTP API Server
#
# OpenAI-compatible HTTP API server for proxying requests to any backend.
# Endpoints:
#   POST /v1/chat/completions  (OpenAI-compatible)
#   POST /v1/messages          (Anthropic-compatible)
#   GET  /v1/models            (list available models)
#   GET  /v1/health            (health check)

use std.io_runtime.{time_now_unix_micros}
use std.json.{json_parse, json_object_get, json_get_type, json_serialize,
    json_array_length, json_array_get, json_to_string}
use std.common.base_encoding.base64.{base64_decode_bytes}
use app.llm_caret.image_format.{inspect_image_bytes_v1}

extern fn rt_http_request(method: text, url: text, headers: text, body: text) -> (i64, text, text)

# ============================================================================
# JSON helpers (inlined)
# ============================================================================

fn _LB() -> text:
    "{{"

fn _RB() -> text:
    "}}"

fn _Q() -> text:
    "\""

fn _unwrap_idx(opt) -> i64:
    match opt:
        Some(i): return i
        nil: return -1

fn _escape_json(s: text) -> text:
    var result = ""
    var i = 0
    while i < s.len():
        val ch = s[i]
        if ch == "\\":
            result = result + "\\\\"
        elif ch == "\"":
            result = result + "\\\""
        elif ch == "\n":
            result = result + "\\n"
        elif ch == "\r":
            result = result + "\\r"
        elif ch == "\t":
            result = result + "\\t"
        else:
            result = result + ch
        i = i + 1
    result

fn _extract_json_string(json: text, key: text) -> text:
    val quote = "\""
    val search = quote + key + quote + ":"
    val idx = _unwrap_idx(json.index_of(search))
    if idx < 0:
        return ""
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed.starts_with(quote):
        val rest = trimmed.substring(1)
        var end = 0
        var escaped = false
        while end < rest.len():
            val ch = rest[end]
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                return rest.substring(0, end)
            end = end + 1
    ""

# ============================================================================
# Response builders
# ============================================================================

fn build_health_response() -> text:
    var r = _LB()
    r = r + _Q() + "status" + _Q() + ":" + _Q() + "ok" + _Q() + ","
    r = r + _Q() + "service" + _Q() + ":" + _Q() + "llm_caret" + _Q() + ","
    r = r + _Q() + "version" + _Q() + ":" + _Q() + "0.1.0" + _Q()
    r = r + _RB()
    r

fn build_models_response() -> text:
    var models: [text] = []
    # Claude models
    var m1 = _LB()
    m1 = m1 + _Q() + "id" + _Q() + ":" + _Q() + "claude-sonnet-5" + _Q() + ","
    m1 = m1 + _Q() + "provider" + _Q() + ":" + _Q() + "claude_cli" + _Q()
    m1 = m1 + _RB()
    models = models + [m1]
    var m2 = _LB()
    m2 = m2 + _Q() + "id" + _Q() + ":" + _Q() + "claude-opus-4-20250514" + _Q() + ","
    m2 = m2 + _Q() + "provider" + _Q() + ":" + _Q() + "claude_cli" + _Q()
    m2 = m2 + _RB()
    models = models + [m2]
    var m3 = _LB()
    m3 = m3 + _Q() + "id" + _Q() + ":" + _Q() + "gpt-4o" + _Q() + ","
    m3 = m3 + _Q() + "provider" + _Q() + ":" + _Q() + "openai" + _Q()
    m3 = m3 + _RB()
    models = models + [m3]
    # Build array
    var data = "["
    var i = 0
    for md in models:
        if i > 0:
            data = data + ","
        data = data + md
        i = i + 1
    data = data + "]"
    var r = _LB()
    r = r + _Q() + "object" + _Q() + ":" + _Q() + "list" + _Q() + ","
    r = r + _Q() + "data" + _Q() + ":" + data
    r = r + _RB()
    r

fn build_models_response_with_image_v1(profile_id: text, model_id: text,
        provider: text) -> text:
    val base = build_models_response()
    if profile_id == "" or model_id == "" or provider == "": return base
    val image_model = "{\"id\":\"" + _escape_json(model_id) +
        "\",\"profile_id\":\"" + _escape_json(profile_id) +
        "\",\"provider\":\"" + _escape_json(provider) +
        "\",\"capabilities\":[\"vision\",\"structured_output\"]}"
    base.substring(0, base.len() - 2) + "," + image_model + "]}"

fn build_chat_completion_response(content: text, model: text, finish_reason: text,
        input_tokens: i64, output_tokens: i64) -> text:
    var r = _LB()
    r = r + _Q() + "id" + _Q() + ":" + _Q() + "chatcmpl-llm_caret" + _Q() + ","
    r = r + _Q() + "object" + _Q() + ":" + _Q() + "chat.completion" + _Q() + ","
    r = r + _Q() + "created" + _Q() + ":" + (time_now_unix_micros() / 1000000).to_text() + ","
    r = r + _Q() + "model" + _Q() + ":" + _Q() + _escape_json(model) + _Q() + ","
    # choices array
    var choice = _LB()
    choice = choice + _Q() + "index" + _Q() + ":0,"
    var msg = _LB()
    msg = msg + _Q() + "role" + _Q() + ":" + _Q() + "assistant" + _Q() + ","
    msg = msg + _Q() + "content" + _Q() + ":" + _Q() + _escape_json(content) + _Q()
    msg = msg + _RB()
    choice = choice + _Q() + "message" + _Q() + ":" + msg + ","
    choice = choice + _Q() + "finish_reason" + _Q() + ":" + _Q() + finish_reason + _Q()
    choice = choice + _RB()
    r = r + _Q() + "choices" + _Q() + ":[" + choice + "],"
    # usage object
    var usage = _LB()
    usage = usage + _Q() + "prompt_tokens" + _Q() + ":" + input_tokens.to_text() + ","
    usage = usage + _Q() + "completion_tokens" + _Q() + ":" + output_tokens.to_text() + ","
    usage = usage + _Q() + "total_tokens" + _Q() + ":" + (input_tokens + output_tokens).to_text()
    usage = usage + _RB()
    r = r + _Q() + "usage" + _Q() + ":" + usage
    r = r + _RB()
    r

fn build_anthropic_response(content: text, model: text, stop_reason: text,
        input_tokens: i64, output_tokens: i64) -> text:
    var r = _LB()
    r = r + _Q() + "id" + _Q() + ":" + _Q() + "msg_llm_caret" + _Q() + ","
    r = r + _Q() + "type" + _Q() + ":" + _Q() + "message" + _Q() + ","
    r = r + _Q() + "role" + _Q() + ":" + _Q() + "assistant" + _Q() + ","
    r = r + _Q() + "model" + _Q() + ":" + _Q() + _escape_json(model) + _Q() + ","
    r = r + _Q() + "stop_reason" + _Q() + ":" + _Q() + stop_reason + _Q() + ","
    # content array
    var block = _LB()
    block = block + _Q() + "type" + _Q() + ":" + _Q() + "text" + _Q() + ","
    block = block + _Q() + "text" + _Q() + ":" + _Q() + _escape_json(content) + _Q()
    block = block + _RB()
    r = r + _Q() + "content" + _Q() + ":[" + block + "],"
    # usage object
    var usage = _LB()
    usage = usage + _Q() + "input_tokens" + _Q() + ":" + input_tokens.to_text() + ","
    usage = usage + _Q() + "output_tokens" + _Q() + ":" + output_tokens.to_text()
    usage = usage + _RB()
    r = r + _Q() + "usage" + _Q() + ":" + usage
    r = r + _RB()
    r

# ============================================================================
# Streaming (SSE) response builders
# ============================================================================

# One "chat.completion.chunk" JSON object. `role` non-empty => delta carries
# only {"role": role}; `content` non-empty => delta carries only
# {"content": content}; both empty => delta is `{}` (the terminal frame).
# `finish_reason` empty => null, else the quoted reason.
fn _build_chat_completion_chunk(model: text, role: text, content: text, finish_reason: text) -> text:
    var delta = _LB()
    var has_field = false
    if role != "":
        delta = delta + _Q() + "role" + _Q() + ":" + _Q() + role + _Q()
        has_field = true
    if content != "":
        if has_field:
            delta = delta + ","
        delta = delta + _Q() + "content" + _Q() + ":" + _Q() + _escape_json(content) + _Q()
        has_field = true
    delta = delta + _RB()
    var choice = _LB()
    choice = choice + _Q() + "index" + _Q() + ":0,"
    choice = choice + _Q() + "delta" + _Q() + ":" + delta + ","
    if finish_reason == "":
        choice = choice + _Q() + "finish_reason" + _Q() + ":null"
    else:
        choice = choice + _Q() + "finish_reason" + _Q() + ":" + _Q() + finish_reason + _Q()
    choice = choice + _RB()
    var r = _LB()
    r = r + _Q() + "id" + _Q() + ":" + _Q() + "chatcmpl-llm_caret" + _Q() + ","
    r = r + _Q() + "object" + _Q() + ":" + _Q() + "chat.completion.chunk" + _Q() + ","
    r = r + _Q() + "created" + _Q() + ":" + (time_now_unix_micros() / 1000000).to_text() + ","
    r = r + _Q() + "model" + _Q() + ":" + _Q() + _escape_json(model) + _Q() + ","
    r = r + _Q() + "choices" + _Q() + ":[" + choice + "]"
    r = r + _RB()
    r

# Full OpenAI-compatible SSE byte stream: role frame, content frame (if any),
# terminal finish_reason frame, and the literal `data: [DONE]` sentinel.
# TODO: [llm-caret-server][P2] The whole SSE body is built and returned at once; real SDK streaming wants chunked token-by-token delivery. Frame shapes are already correct, so this is a transport change, not a format one
fn build_chat_completion_stream_response(content: text, model: text, finish_reason: text) -> text:
    var out = ""
    out = out + "data: " + _build_chat_completion_chunk(model, "assistant", "", "") + "\n\n"
    if content != "":
        out = out + "data: " + _build_chat_completion_chunk(model, "", content, "") + "\n\n"
    out = out + "data: " + _build_chat_completion_chunk(model, "", "", finish_reason) + "\n\n"
    out = out + "data: [DONE]\n\n"
    out

# Full Anthropic-compatible SSE byte stream: message_start, content_block_start,
# content_block_delta, content_block_stop, message_delta, message_stop -- each
# frame is `event: <name>\ndata: {...}\n\n`.
fn build_anthropic_stream_response(content: text, model: text, stop_reason: text,
        input_tokens: i64, output_tokens: i64) -> text:
    var out = ""
    # message_start
    var msg = _LB()
    msg = msg + _Q() + "id" + _Q() + ":" + _Q() + "msg_llm_caret" + _Q() + ","
    msg = msg + _Q() + "type" + _Q() + ":" + _Q() + "message" + _Q() + ","
    msg = msg + _Q() + "role" + _Q() + ":" + _Q() + "assistant" + _Q() + ","
    msg = msg + _Q() + "model" + _Q() + ":" + _Q() + _escape_json(model) + _Q() + ","
    msg = msg + _Q() + "content" + _Q() + ":[],"
    var usage0 = _LB()
    usage0 = usage0 + _Q() + "input_tokens" + _Q() + ":" + input_tokens.to_text() + ","
    usage0 = usage0 + _Q() + "output_tokens" + _Q() + ":0"
    usage0 = usage0 + _RB()
    msg = msg + _Q() + "usage" + _Q() + ":" + usage0
    msg = msg + _RB()
    var start_data = _LB()
    start_data = start_data + _Q() + "type" + _Q() + ":" + _Q() + "message_start" + _Q() + ","
    start_data = start_data + _Q() + "message" + _Q() + ":" + msg
    start_data = start_data + _RB()
    out = out + "event: message_start\ndata: " + start_data + "\n\n"
    # content_block_start
    var block0 = _LB()
    block0 = block0 + _Q() + "type" + _Q() + ":" + _Q() + "text" + _Q() + ","
    block0 = block0 + _Q() + "text" + _Q() + ":" + _Q() + _Q()
    block0 = block0 + _RB()
    var cbs = _LB()
    cbs = cbs + _Q() + "type" + _Q() + ":" + _Q() + "content_block_start" + _Q() + ","
    cbs = cbs + _Q() + "index" + _Q() + ":0,"
    cbs = cbs + _Q() + "content_block" + _Q() + ":" + block0
    cbs = cbs + _RB()
    out = out + "event: content_block_start\ndata: " + cbs + "\n\n"
    # content_block_delta
    var delta = _LB()
    delta = delta + _Q() + "type" + _Q() + ":" + _Q() + "text_delta" + _Q() + ","
    delta = delta + _Q() + "text" + _Q() + ":" + _Q() + _escape_json(content) + _Q()
    delta = delta + _RB()
    var cbd = _LB()
    cbd = cbd + _Q() + "type" + _Q() + ":" + _Q() + "content_block_delta" + _Q() + ","
    cbd = cbd + _Q() + "index" + _Q() + ":0,"
    cbd = cbd + _Q() + "delta" + _Q() + ":" + delta
    cbd = cbd + _RB()
    out = out + "event: content_block_delta\ndata: " + cbd + "\n\n"
    # content_block_stop
    var cbe = _LB()
    cbe = cbe + _Q() + "type" + _Q() + ":" + _Q() + "content_block_stop" + _Q() + ","
    cbe = cbe + _Q() + "index" + _Q() + ":0"
    cbe = cbe + _RB()
    out = out + "event: content_block_stop\ndata: " + cbe + "\n\n"
    # message_delta
    var delta2 = _LB()
    delta2 = delta2 + _Q() + "stop_reason" + _Q() + ":" + _Q() + stop_reason + _Q()
    delta2 = delta2 + _RB()
    var usage1 = _LB()
    usage1 = usage1 + _Q() + "output_tokens" + _Q() + ":" + output_tokens.to_text()
    usage1 = usage1 + _RB()
    var md = _LB()
    md = md + _Q() + "type" + _Q() + ":" + _Q() + "message_delta" + _Q() + ","
    md = md + _Q() + "delta" + _Q() + ":" + delta2 + ","
    md = md + _Q() + "usage" + _Q() + ":" + usage1
    md = md + _RB()
    out = out + "event: message_delta\ndata: " + md + "\n\n"
    # message_stop
    var ms = _LB()
    ms = ms + _Q() + "type" + _Q() + ":" + _Q() + "message_stop" + _Q()
    ms = ms + _RB()
    out = out + "event: message_stop\ndata: " + ms + "\n\n"
    out

fn build_error_response(error_msg: text, status_code: i64) -> text:
    var r = _LB()
    r = r + _Q() + "error" + _Q() + ":"
    var inner = _LB()
    inner = inner + _Q() + "message" + _Q() + ":" + _Q() + _escape_json(error_msg) + _Q() + ","
    inner = inner + _Q() + "type" + _Q() + ":" + _Q() + "error" + _Q() + ","
    inner = inner + _Q() + "code" + _Q() + ":" + status_code.to_text()
    inner = inner + _RB()
    r = r + inner
    r = r + _RB()
    r

# ============================================================================
# Request parsing
# ============================================================================

fn parse_chat_request_model(body: text) -> text:
    _extract_json_string(body, "model")

fn parse_chat_request_content(body: text) -> text:
    # Extract content from the last message in messages array
    _extract_json_string(body, "content")

fn parse_chat_request_system_text(body: text) -> text:
    val root = json_parse(body)
    if root == nil or json_get_type(root) != "object": return ""
    val system = json_object_get(root, "system")
    if json_get_type(system) == "string": return json_to_string(system) ?? ""
    ""

# Preserve the complete ordered message array for multimodal dispatch. This
# scanner returns exactly one JSON array value and respects strings/escapes;
# provider adapters receive the original content-part shape rather than a
# lossy last-message text reconstruction.
fn parse_chat_request_messages_json(body: text) -> text:
    val root = json_parse(body)
    if root == nil or json_get_type(root) != "object": return ""
    val messages = json_object_get(root, "messages")
    if messages == nil or json_get_type(messages) != "array": return ""
    json_serialize(messages)

fn multimodal_messages_have_image_v1(messages_json: text) -> bool:
    val messages = json_parse(messages_json)
    var message_index = 0
    while message_index < json_array_length(messages):
        val content = json_object_get(json_array_get(messages, message_index), "content")
        var part_index = 0
        while part_index < json_array_length(content):
            val part = json_array_get(content, part_index)
            val kind = json_to_string(json_object_get(part, "type"))
            if kind != nil and (kind == "image" or kind == "image_url"): return true
            part_index = part_index + 1
        message_index = message_index + 1
    false

fn _strict_base64_payload_v1(payload: text) -> bool:
    if payload == "" or payload.len() % 4 != 0: return false
    val bytes = payload.bytes()
    var padding = 0
    var index = 0
    while index < bytes.len():
        val byte = bytes[index] as i64
        val alphabet = (byte >= 65 and byte <= 90) or
            (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or
            byte == 43 or byte == 47
        if byte == 61:
            padding = padding + 1
            if index < bytes.len() - 2 or padding > 2: return false
        elif not alphabet or padding > 0:
            return false
        index = index + 1
    true

fn validate_proxy_image_messages_with_limits_v1(messages_json: text, max_bytes: i64,
        max_images: i64, max_pixels: i64) -> text:
    val messages = json_parse(messages_json)
    if messages == nil or json_get_type(messages) != "array": return "messages must be an array"
    var encoded_bytes = 0
    var image_count = 0
    var decoded_pixels = 0
    var message_index = 0
    while message_index < json_array_length(messages):
        val message = json_array_get(messages, message_index)
        val role = json_to_string(json_object_get(message, "role")) ?? ""
        val content = json_object_get(message, "content")
        if json_get_type(content) == "array":
            var part_index = 0
            while part_index < json_array_length(content):
                val part = json_array_get(content, part_index)
                val kind = json_to_string(json_object_get(part, "type"))
                var data = ""
                if kind != nil and kind == "image_url":
                    val image_url = json_object_get(part, "image_url")
                    data = json_to_string(json_object_get(image_url, "url")) ?? ""
                elif kind != nil and kind == "image":
                    val source = json_object_get(part, "source")
                    if (json_to_string(json_object_get(source, "type")) ?? "") != "base64":
                        return "only inline base64 image sources are allowed"
                    val media = json_to_string(json_object_get(source, "media_type")) ?? ""
                    val payload = json_to_string(json_object_get(source, "data")) ?? ""
                    data = "data:" + media + ";base64," + payload
                if kind != nil and (kind == "image" or kind == "image_url"):
                    if role != "user": return "image input parts require a user message"
                    image_count = image_count + 1
                    if image_count > max_images: return "image count exceeds configured profile limit"
                    if not (data.starts_with("data:image/png;base64,") or
                            data.starts_with("data:image/jpeg;base64,") or
                            data.starts_with("data:image/webp;base64,")):
                        return "proxy requires PNG, JPEG, or WebP data URLs"
                    val marker = data.find(";base64,")
                    val payload = data.substring(marker + 8)
                    var padding = 0
                    if payload.ends_with("="): padding = padding + 1
                    if payload.ends_with("=="): padding = padding + 1
                    val decoded_size = payload.len() / 4 * 3 - padding
                    if encoded_bytes + decoded_size > max_bytes:
                        return "image bytes exceed configured profile limit"
                    if not _strict_base64_payload_v1(payload): return "image Base64 payload is malformed"
                    val raw = base64_decode_bytes(payload)
                    val inspected = inspect_image_bytes_v1(raw)
                    if inspected.error != "" or inspected.mime_type != data.substring(5, marker):
                        return "image data URL does not match its declared MIME type"
                    val width = inspected.width
                    val height = inspected.height
                    if width <= 0 or height <= 0: return "PNG dimensions must be positive"
                    if width > max_pixels or height > max_pixels or width > max_pixels / height:
                        return "decoded pixels exceed configured profile limit"
                    val image_pixels = width * height
                    if image_pixels > max_pixels - decoded_pixels:
                        return "decoded pixels exceed configured profile limit"
                    decoded_pixels = decoded_pixels + image_pixels
                    encoded_bytes = encoded_bytes + decoded_size
                part_index = part_index + 1
        message_index = message_index + 1
    if encoded_bytes > max_bytes: return "image bytes exceed configured profile limit"
    ""

fn validate_proxy_image_messages_v1(messages_json: text, max_bytes: i64) -> text:
    validate_proxy_image_messages_with_limits_v1(messages_json, max_bytes, 1024, 1073741824)

fn anthropic_system_text_v1(messages_json: text) -> text:
    val messages = json_parse(messages_json)
    var result: [text] = []
    var message_index = 0
    while message_index < json_array_length(messages):
        val message = json_array_get(messages, message_index)
        val role = json_to_string(json_object_get(message, "role")) ?? ""
        if role == "system" or role == "developer":
            val content = json_object_get(message, "content")
            if json_get_type(content) == "string":
                result = result + [json_to_string(content) ?? ""]
            elif json_get_type(content) == "array":
                var part_index = 0
                while part_index < json_array_length(content):
                    val part = json_array_get(content, part_index)
                    if (json_to_string(json_object_get(part, "type")) ?? "") == "text":
                        result = result + [json_to_string(json_object_get(part, "text")) ?? ""]
                    part_index = part_index + 1
        message_index = message_index + 1
    result.join("\n\n")

fn openai_messages_to_anthropic_v1(messages_json: text) -> text:
    val messages = json_parse(messages_json)
    var encoded_messages: [text] = []
    var message_index = 0
    while message_index < json_array_length(messages):
        val message = json_array_get(messages, message_index)
        val role = json_to_string(json_object_get(message, "role")) ?? ""
        if role == "user" or role == "assistant":
            val content = json_object_get(message, "content")
            var encoded_parts: [text] = []
            if json_get_type(content) == "string":
                encoded_parts = encoded_parts + ["{\"type\":\"text\",\"text\":\"" +
                    _escape_json(json_to_string(content) ?? "") + "\"}"]
            elif json_get_type(content) == "array":
                var part_index = 0
                while part_index < json_array_length(content):
                    val part = json_array_get(content, part_index)
                    val kind = json_to_string(json_object_get(part, "type")) ?? ""
                    if kind == "text":
                        encoded_parts = encoded_parts + ["{\"type\":\"text\",\"text\":\"" +
                            _escape_json(json_to_string(json_object_get(part, "text")) ?? "") + "\"}"]
                    elif kind == "image":
                        encoded_parts = encoded_parts + [json_serialize(part)]
                    elif kind == "image_url":
                        val data = json_to_string(json_object_get(json_object_get(part, "image_url"), "url")) ?? ""
                        val marker = data.find(";base64,")
                        val mime = if marker < 5: "" else: data.substring(5, marker)
                        val payload = if marker < 0: "" else: data.substring(marker + 8)
                        encoded_parts = encoded_parts + ["{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":\"" +
                            _escape_json(mime) + "\",\"data\":\"" + _escape_json(payload) + "\"}}"]
                    part_index = part_index + 1
            encoded_messages = encoded_messages + ["{\"role\":\"" + role +
                "\",\"content\":[" + encoded_parts.join(",") + "]}"]
        message_index = message_index + 1
    "[" + encoded_messages.join(",") + "]"

fn anthropic_messages_to_openai_v1(messages_json: text) -> text:
    val messages = json_parse(messages_json)
    var encoded_messages: [text] = []
    var message_index = 0
    while message_index < json_array_length(messages):
        val message = json_array_get(messages, message_index)
        val role = json_to_string(json_object_get(message, "role")) ?? ""
        val content = json_object_get(message, "content")
        var encoded_parts: [text] = []
        if json_get_type(content) == "string":
            encoded_parts = encoded_parts + ["{\"type\":\"text\",\"text\":\"" +
                _escape_json(json_to_string(content) ?? "") + "\"}"]
        elif json_get_type(content) == "array":
            var part_index = 0
            while part_index < json_array_length(content):
                val part = json_array_get(content, part_index)
                val kind = json_to_string(json_object_get(part, "type")) ?? ""
                if kind == "text" or kind == "image_url":
                    encoded_parts = encoded_parts + [json_serialize(part)]
                elif kind == "image":
                    val source = json_object_get(part, "source")
                    val media = json_to_string(json_object_get(source, "media_type")) ?? ""
                    val payload = json_to_string(json_object_get(source, "data")) ?? ""
                    encoded_parts = encoded_parts + ["{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:" +
                        _escape_json(media) + ";base64," + _escape_json(payload) + "\",\"detail\":\"high\"}}"]
                part_index = part_index + 1
        encoded_messages = encoded_messages + ["{\"role\":\"" + _escape_json(role) +
            "\",\"content\":[" + encoded_parts.join(",") + "]}"]
        message_index = message_index + 1
    "[" + encoded_messages.join(",") + "]"

# ============================================================================
# Route handling (pure - returns response body text)
# ============================================================================

fn handle_route(method: text, path: text, body: text) -> text:
    if method == "GET" and path == "/v1/health":
        return build_health_response()
    if method == "GET" and path == "/v1/models":
        return build_models_response()
    if method == "POST" and path == "/v1/chat/completions":
        # Would dispatch to provider here
        val model = parse_chat_request_model(body)
        val content = parse_chat_request_content(body)
        if content == "":
            return build_error_response("messages required", 400)
        # Placeholder: actual dispatch would go through provider.spl
        return build_error_response("backend not connected - use provider.dispatch_send()", 501)
    if method == "POST" and path == "/v1/messages":
        val content = parse_chat_request_content(body)
        if content == "":
            return build_error_response("messages required", 400)
        return build_error_response("backend not connected - use provider.dispatch_send()", 501)
    build_error_response("not found: " + path, 404)
