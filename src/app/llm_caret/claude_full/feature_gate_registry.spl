"""
Bounded feature-gate cross-map for the Claude-full parity parts bin.

Each record projects one import-safe owner function into neutral metadata and
links that owner to its focused or aggregate system-test evidence.  The
registry is not imported by shipped Caret entrypoints and does not claim that
future upstream gates are discovered automatically.  Its system spec separately
checks the bounded import frontier against real source declarations; that
test-only oracle does not add filesystem work to production paths.
"""

use app.llm_caret.claude_full.commands.compact.index.{compactCommand}
use app.llm_caret.claude_full.commands.fast.index.{fastCommand}
use app.llm_caret.claude_full.commands.chrome.index.{chromeCommand}
use app.llm_caret.claude_full.commands.insights.{InsightsState, insightsCommand, runInsights}
use app.llm_caret.claude_full.commands.extra_usage.index.{extraUsageCommand, extraUsageNonInteractiveCommand}
use app.llm_caret.claude_full.commands.extra_usage.extra_usage_core.{ExtraUsageState}
use app.llm_caret.claude_full.commands.review.reviewRemote.{ReviewRemoteState, reviewRemoteCommand, reviewRemoteNextStep}
use app.llm_caret.claude_full.commands.review.ultrareviewEnabled.{ultrareviewEnabled}
use app.llm_caret.claude_full.commands.mcp.xaaIdpCommand.{xaaIdpCommand}
use app.llm_caret.claude_full.commands.init.{useNewInitPrompt}
use app.llm_caret.claude_full.commands.bridge.bridge.{bridgeCommand, bridgeCommandFor}
use app.llm_caret.claude_full.hooks.useTasksV2.{useTasksV2Enabled}
use app.llm_caret.claude_full.utils.agentSwarmsEnabled.{isAgentSwarmsEnabled}
use app.llm_caret.claude_full.utils.immediateCommand.{shouldInferenceConfigCommandBeImmediate}
use app.llm_caret.claude_full.utils.worktreeModeEnabled.{isWorktreeModeEnabled}
use app.llm_caret.claude_full.utils.managedEnvConstants.{safeEnvVars, isProviderManagedEnvVar}
use app.llm_caret.claude_full.memdir.teamMemPaths.{isTeamMemoryEnabled}
use app.llm_caret.claude_full.buddy.useBuddyNotification.{buddyNotificationDecision}
use app.llm_caret.claude_full.components.messages.AttachmentMessage.{AttachmentModel, AttachmentSkill, attachmentMessageRenderSkillDiscovery}
use app.llm_caret.claude_full.components.messages.nullRenderingAttachments.{hiddenModelVisibleFeatures}
use app.llm_caret.claude_full.services.api.withRetry.{isPersistentRetryEnabled}
use app.llm_caret.claude_full.bridge.bridgeEnabled.{BridgeEntitlement, BridgeFeatureFlags, isBridgeEnabled, isBridgeEnabledBlocking, getBridgeDisabledReason, isEnvLessBridgeEnabled, isCseShimEnabled, checkBridgeMinVersion, getCcrAutoConnectDefault, isCcrMirrorEnabled}

class ClaudeFeatureGateProbe:
    case_id: text
    condition: text
    hidden: bool
    enabled: bool
    outcome: text

class ClaudeFeatureGateRecord:
    source_id: text
    source_file: text
    owner_spec: text
    surface: text
    state_shape: text
    gate_owner: text
    root_command: text
    root_hidden: bool
    root_enabled: bool
    default_known: bool
    hidden_by_default: bool
    enabled_by_default: bool
    gate_kind: text
    probes: [ClaudeFeatureGateProbe]

fn _claudeFeatureGateProbe(case_id: text, condition: text, hidden: bool, enabled: bool) -> ClaudeFeatureGateProbe:
    ClaudeFeatureGateProbe(
        case_id: case_id,
        condition: condition,
        hidden: hidden,
        enabled: enabled,
        outcome: ""
    )

fn _claudeFeatureGateOutcomeProbe(case_id: text, condition: text, hidden: bool, enabled: bool, outcome: text) -> ClaudeFeatureGateProbe:
    ClaudeFeatureGateProbe(
        case_id: case_id,
        condition: condition,
        hidden: hidden,
        enabled: enabled,
        outcome: outcome
    )

fn _claudeFeatureGateRecord(
    source_id: text,
    source_file: text,
    owner_spec: text,
    surface: text,
    state_shape: text,
    gate_owner: text,
    root_command: text,
    root_hidden: bool,
    root_enabled: bool,
    default_known: bool,
    hidden_by_default: bool,
    enabled_by_default: bool,
    gate_kind: text,
    probes: [ClaudeFeatureGateProbe]
) -> ClaudeFeatureGateRecord:
    ClaudeFeatureGateRecord(
        source_id: source_id,
        source_file: source_file,
        owner_spec: owner_spec,
        surface: surface,
        state_shape: state_shape,
        gate_owner: gate_owner,
        root_command: root_command,
        root_hidden: root_hidden,
        root_enabled: root_enabled,
        default_known: default_known,
        hidden_by_default: hidden_by_default,
        enabled_by_default: enabled_by_default,
        gate_kind: gate_kind,
        probes: probes
    )

fn _claudeFeatureGateContains(values: [text], wanted: text) -> bool:
    for value in values:
        if value == wanted:
            return true
    false

fn _claudeFeatureGateBool(value: bool) -> text:
    if value:
        return "true"
    "false"

fn claudeFeatureGateRegistry() -> [ClaudeFeatureGateRecord]:
    val compact_default = compactCommand(false)
    val compact_disabled = compactCommand(true)
    val fast_default = fastCommand(false, false)
    val fast_enabled = fastCommand(true, true)
    val fast_enabled_deferred = fastCommand(true, false)
    val fast_disabled_immediate = fastCommand(false, true)
    val chrome_default = chromeCommand(false)
    val chrome_noninteractive = chromeCommand(true)
    val insights_disabled = insightsCommand(false)
    val insights_enabled = insightsCommand(true)
    val insights_interactive_state = InsightsState.sample()
    val insights_interactive = runInsights(insights_interactive_state)
    val insights_noninteractive_state = InsightsState.sample()
    insights_noninteractive_state.nonInteractive = true
    val insights_noninteractive = runInsights(insights_noninteractive_state)

    val extra_interactive_state = ExtraUsageState.individualWithBilling()
    val extra_interactive = extraUsageCommand(extra_interactive_state)
    val extra_noninteractive_inactive = extraUsageNonInteractiveCommand(extra_interactive_state)
    val extra_noninteractive_state = ExtraUsageState.individualWithBilling()
    extra_noninteractive_state.nonInteractive = true
    val extra_interactive_inactive = extraUsageCommand(extra_noninteractive_state)
    val extra_noninteractive = extraUsageNonInteractiveCommand(extra_noninteractive_state)
    val extra_interactive_disabled_state = ExtraUsageState.individualWithBilling()
    extra_interactive_disabled_state.disableCommand = true
    val extra_interactive_disabled = extraUsageCommand(extra_interactive_disabled_state)
    val extra_noninteractive_disabled_state = ExtraUsageState.individualWithBilling()
    extra_noninteractive_disabled_state.nonInteractive = true
    extra_noninteractive_disabled_state.disableCommand = true
    val extra_noninteractive_disabled = extraUsageNonInteractiveCommand(extra_noninteractive_disabled_state)
    val extra_interactive_ineligible_state = ExtraUsageState.individualWithBilling()
    extra_interactive_ineligible_state.overageProvisioningAllowed = false
    val extra_interactive_ineligible = extraUsageCommand(extra_interactive_ineligible_state)
    val extra_noninteractive_ineligible_state = ExtraUsageState.individualWithBilling()
    extra_noninteractive_ineligible_state.nonInteractive = true
    extra_noninteractive_ineligible_state.overageProvisioningAllowed = false
    val extra_noninteractive_ineligible = extraUsageNonInteractiveCommand(extra_noninteractive_ineligible_state)

    val remote_review = reviewRemoteCommand()
    val remote_review_signin = ReviewRemoteState.new(false, "sess", "12", "main", "feature", "diff", 1, false, false)
    val remote_review_session = ReviewRemoteState.new(true, "", "12", "main", "feature", "diff", 1, false, false)
    val remote_review_pr = ReviewRemoteState.new(true, "sess", "", "main", "feature", "diff", 1, false, false)
    val remote_review_diff = ReviewRemoteState.new(true, "sess", "12", "main", "feature", "", 0, false, false)
    val remote_review_diff_only = ReviewRemoteState.new(true, "sess", "12", "main", "feature", "diff", 0, false, false)
    val remote_review_file_count_only = ReviewRemoteState.new(true, "sess", "12", "main", "feature", "", 1, false, false)
    val remote_review_ready = ReviewRemoteState.new(true, "sess", "12", "main", "feature", "diff", 1, false, false)
    val xaa_idp = xaaIdpCommand()
    val bridge_command_default = bridgeCommand()
    val bridge_default = bridgeCommandFor(false, false)
    val bridge_enabled = bridgeCommandFor(true, true)
    val bridge_mode_off_gate_on = bridgeCommandFor(false, true)
    val bridge_mode_on_gate_off = bridgeCommandFor(true, false)
    val bridge_unentitled = BridgeEntitlement.new(false, false, false, false, "")
    val bridge_entitled = BridgeEntitlement.new(true, true, true, true, "org")
    val bridge_build_missing = BridgeEntitlement.new(false, true, true, true, "org")
    val bridge_subscriber_missing = BridgeEntitlement.new(true, false, true, true, "org")
    val bridge_profile_missing = BridgeEntitlement.new(true, true, true, false, "org")
    val bridge_org_missing = BridgeEntitlement.new(true, true, true, true, "")
    val bridge_gate_missing = BridgeEntitlement.new(true, true, false, true, "org")
    val bridge_flags_default = BridgeFeatureFlags.new()
    val bridge_flags_envless = BridgeFeatureFlags.new()
    bridge_flags_envless.env_less_bridge = true
    val bridge_flags_mode_off = BridgeFeatureFlags.new()
    bridge_flags_mode_off.bridge_mode = false
    bridge_flags_mode_off.env_less_bridge = true
    val bridge_flags_cse_off = BridgeFeatureFlags.new()
    bridge_flags_cse_off.cse_shim = false
    val bridge_flags_mirror_env = BridgeFeatureFlags.new()
    bridge_flags_mirror_env.ccr_mirror_build = true
    bridge_flags_mirror_env.ccr_mirror_env = true
    val bridge_flags_mirror_gate = BridgeFeatureFlags.new()
    bridge_flags_mirror_gate.ccr_mirror_build = true
    bridge_flags_mirror_gate.ccr_mirror_gate = true
    val bridge_flags_mirror_build_off = BridgeFeatureFlags.new()
    bridge_flags_mirror_build_off.ccr_mirror_env = true
    bridge_flags_mirror_build_off.ccr_mirror_gate = true

    val skill_attachment = AttachmentModel.empty("skill_discovery")
    skill_attachment.skills = [AttachmentSkill.new("test-skill", "skill-1")]
    val skill_hidden = attachmentMessageRenderSkillDiscovery(skill_attachment, false, false)
    val skill_visible = attachmentMessageRenderSkillDiscovery(skill_attachment, true, false)
    val skill_demo = attachmentMessageRenderSkillDiscovery(skill_attachment, true, true)
    val skill_empty_attachment = AttachmentModel.empty("skill_discovery")
    val skill_empty = attachmentMessageRenderSkillDiscovery(skill_empty_attachment, true, false)
    val skill_wrong_attachment = AttachmentModel.empty("file")
    skill_wrong_attachment.skills = [AttachmentSkill.new("test-skill", "skill-1")]
    val skill_wrong = attachmentMessageRenderSkillDiscovery(skill_wrong_attachment, true, false)

    val buddy_default = buddyNotificationDecision(false, false, true)
    val buddy_teaser = buddyNotificationDecision(true, false, true)
    val buddy_companion = buddyNotificationDecision(true, true, true)
    val buddy_outside_window = buddyNotificationDecision(true, false, false)
    val model_visible_features = hiddenModelVisibleFeatures()
    var model_visible_valid = model_visible_features.len() == 6
    for feature in model_visible_features:
        if feature.user_visible or not feature.model_visible:
            model_visible_valid = false
    val safe_env = safeEnvVars()
    val beta_safe = _claudeFeatureGateContains(safe_env, "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS")
    val beta_provider_managed = isProviderManagedEnvVar("CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS")
    val teams_safe = _claudeFeatureGateContains(safe_env, "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS")
    val teams_provider_managed = isProviderManagedEnvVar("CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS")

    [
        _claudeFeatureGateRecord(
            "compact",
            "src/app/llm_caret/claude_full/commands/compact/index.spl",
            "test/03_system/tools/llm/claude_full/commands/compact_command_spec.spl",
            "root-command-admission",
            "enabled",
            "compactCommand",
            "/compact",
            false,
            true,
            true,
            false,
            compact_default.enabled,
            "environment",
            [
                _claudeFeatureGateProbe("default", "disableCompactEnvTruthy=false", false, compact_default.enabled),
                _claudeFeatureGateProbe("disabled-by-env", "disableCompactEnvTruthy=true", false, compact_disabled.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "fast",
            "src/app/llm_caret/claude_full/commands/fast/index.spl",
            "test/03_system/tools/llm/claude_full/commands/fast_command_spec.spl",
            "command-admission",
            "hidden+enabled",
            "fastCommand",
            "",
            false,
            false,
            false,
            fast_default.hidden,
            fast_default.enabled,
            "conditional",
            [
                _claudeFeatureGateProbe("disabled-input", "enabled=false immediate=false", fast_default.hidden, fast_default.enabled),
                _claudeFeatureGateProbe("enabled-input", "enabled=true immediate=true", fast_enabled.hidden, fast_enabled.enabled),
                _claudeFeatureGateProbe("enabled-deferred", "enabled=true immediate=false", fast_enabled_deferred.hidden, fast_enabled_deferred.enabled),
                _claudeFeatureGateProbe("disabled-immediate", "enabled=false immediate=true", fast_disabled_immediate.hidden, fast_disabled_immediate.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "fast-immediacy",
            "src/app/llm_caret/claude_full/commands/fast/index.spl",
            "test/03_system/tools/llm/claude_full/commands/fast_command_spec.spl",
            "command-immediacy",
            "enabled",
            "fastCommand",
            "",
            false,
            false,
            false,
            false,
            false,
            "conditional",
            [
                _claudeFeatureGateProbe("deferred-input", "enabled=false immediate=false", false, fast_default.immediate),
                _claudeFeatureGateProbe("immediate-input", "enabled=true immediate=true", false, fast_enabled.immediate),
                _claudeFeatureGateProbe("enabled-deferred", "enabled=true immediate=false", false, fast_enabled_deferred.immediate),
                _claudeFeatureGateProbe("disabled-immediate", "enabled=false immediate=true", false, fast_disabled_immediate.immediate)
            ]
        ),
        _claudeFeatureGateRecord(
            "chrome",
            "src/app/llm_caret/claude_full/commands/chrome/index.spl",
            "test/03_system/tools/llm/claude_full/commands/chrome_command_spec.spl",
            "session-mode-admission",
            "enabled",
            "chromeCommand",
            "",
            false,
            false,
            true,
            false,
            chrome_default.enabled,
            "context",
            [
                _claudeFeatureGateProbe("default", "nonInteractiveSession=false", false, chrome_default.enabled),
                _claudeFeatureGateProbe("noninteractive", "nonInteractiveSession=true", false, chrome_noninteractive.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "insights",
            "src/app/llm_caret/claude_full/commands/insights.spl",
            "test/03_system/tools/llm/claude_full/commands/insights_command_spec.spl",
            "command-admission",
            "hidden+enabled",
            "insightsCommand",
            "",
            false,
            false,
            false,
            insights_disabled.isHidden,
            insights_disabled.enabled,
            "conditional",
            [
                _claudeFeatureGateProbe("disabled-input", "enabled=false", insights_disabled.isHidden, insights_disabled.enabled),
                _claudeFeatureGateProbe("enabled", "enabled=true", insights_enabled.isHidden, insights_enabled.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "insights-interactive-mode",
            "src/app/llm_caret/claude_full/commands/insights.spl",
            "test/03_system/tools/llm/claude_full/commands/insights_command_spec.spl",
            "interactive-session-admission",
            "outcome",
            "runInsights",
            "",
            false,
            false,
            false,
            false,
            true,
            "context",
            [
                _claudeFeatureGateOutcomeProbe("interactive", "interactive sample session", false, true, insights_interactive.typeName),
                _claudeFeatureGateOutcomeProbe("noninteractive", "nonInteractive=true", false, false, insights_noninteractive.message)
            ]
        ),
        _claudeFeatureGateRecord(
            "extra-usage-interactive",
            "src/app/llm_caret/claude_full/commands/extra_usage/index.spl",
            "test/03_system/tools/llm/claude_full/commands/extra_usage_command_spec.spl",
            "interactive-command-admission",
            "hidden+enabled",
            "extraUsageCommand",
            "",
            false,
            false,
            true,
            extra_interactive.isHidden,
            extra_interactive.enabled,
            "context",
            [
                _claudeFeatureGateProbe("default", "interactive eligible billing state", extra_interactive.isHidden, extra_interactive.enabled),
                _claudeFeatureGateProbe("noninteractive", "nonInteractive=true", extra_interactive_inactive.isHidden, extra_interactive_inactive.enabled),
                _claudeFeatureGateProbe("disabled-command", "interactive disableCommand=true", extra_interactive_disabled.isHidden, extra_interactive_disabled.enabled),
                _claudeFeatureGateProbe("provisioning-blocked", "interactive overageProvisioningAllowed=false", extra_interactive_ineligible.isHidden, extra_interactive_ineligible.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "extra-usage-noninteractive",
            "src/app/llm_caret/claude_full/commands/extra_usage/index.spl",
            "test/03_system/tools/llm/claude_full/commands/extra_usage_command_spec.spl",
            "noninteractive-command-admission",
            "hidden+enabled",
            "extraUsageNonInteractiveCommand",
            "",
            false,
            false,
            true,
            extra_noninteractive_inactive.isHidden,
            extra_noninteractive_inactive.enabled,
            "context",
            [
                _claudeFeatureGateProbe("default", "interactive eligible billing state", extra_noninteractive_inactive.isHidden, extra_noninteractive_inactive.enabled),
                _claudeFeatureGateProbe("noninteractive", "nonInteractive=true", extra_noninteractive.isHidden, extra_noninteractive.enabled),
                _claudeFeatureGateProbe("disabled-command", "nonInteractive=true disableCommand=true", extra_noninteractive_disabled.isHidden, extra_noninteractive_disabled.enabled),
                _claudeFeatureGateProbe("provisioning-blocked", "nonInteractive=true overageProvisioningAllowed=false", extra_noninteractive_ineligible.isHidden, extra_noninteractive_ineligible.enabled)
            ]
        ),
        _claudeFeatureGateRecord(
            "review-remote",
            "src/app/llm_caret/claude_full/commands/review/reviewRemote.spl",
            "test/03_system/tools/llm/claude_full/commands/review_remote_spec.spl",
            "hidden-command-metadata",
            "hidden",
            "reviewRemoteCommand",
            "",
            false,
            false,
            true,
            remote_review.hidden,
            false,
            "static",
            [
                _claudeFeatureGateProbe("default", "hidden immediate command; enablement not represented", remote_review.hidden, false)
            ]
        ),
        _claudeFeatureGateRecord(
            "review-remote-prerequisites",
            "src/app/llm_caret/claude_full/commands/review/reviewRemote.spl",
            "test/03_system/tools/llm/claude_full/commands/review_remote_spec.spl",
            "remote-review-readiness",
            "outcome",
            "reviewRemoteNextStep",
            "",
            false,
            false,
            false,
            false,
            false,
            "context",
            [
                _claudeFeatureGateOutcomeProbe("signed-out", "signed out", false, false, reviewRemoteNextStep(remote_review_signin)),
                _claudeFeatureGateOutcomeProbe("missing-session", "signed in without remote session", false, false, reviewRemoteNextStep(remote_review_session)),
                _claudeFeatureGateOutcomeProbe("missing-pr", "session without pull request", false, false, reviewRemoteNextStep(remote_review_pr)),
                _claudeFeatureGateOutcomeProbe("missing-diff", "pull request without diff", false, false, reviewRemoteNextStep(remote_review_diff)),
                _claudeFeatureGateOutcomeProbe("diff-only", "diff summary without file count", false, true, reviewRemoteNextStep(remote_review_diff_only)),
                _claudeFeatureGateOutcomeProbe("file-count-only", "file count without diff summary", false, true, reviewRemoteNextStep(remote_review_file_count_only)),
                _claudeFeatureGateOutcomeProbe("ready", "signed in session pull request and diff", false, true, reviewRemoteNextStep(remote_review_ready))
            ]
        ),
        _claudeFeatureGateRecord(
            "ultrareview",
            "src/app/llm_caret/claude_full/commands/review/ultrareviewEnabled.spl",
            "test/03_system/tools/llm/claude_full/commands/review_rewind_sandbox_spec.spl",
            "review-entitlement",
            "enabled",
            "ultrareviewEnabled",
            "",
            false,
            false,
            false,
            false,
            ultrareviewEnabled(false, false),
            "conditional",
            [
                _claudeFeatureGateProbe("both-disabled", "flag=false entitled=false", false, ultrareviewEnabled(false, false)),
                _claudeFeatureGateProbe("flag-only", "flag=true entitled=false", false, ultrareviewEnabled(true, false)),
                _claudeFeatureGateProbe("entitlement-only", "flag=false entitled=true", false, ultrareviewEnabled(false, true)),
                _claudeFeatureGateProbe("entitled", "flag=true entitled=true", false, ultrareviewEnabled(true, true))
            ]
        ),
        _claudeFeatureGateRecord(
            "xaa-idp",
            "src/app/llm_caret/claude_full/commands/mcp/xaaIdpCommand.spl",
            "test/03_system/tools/llm/claude_full/commands/mcp_large_spec.spl",
            "hidden-mcp-subcommand",
            "hidden",
            "xaaIdpCommand",
            "",
            false,
            false,
            true,
            xaa_idp.isHidden,
            false,
            "static",
            [
                _claudeFeatureGateProbe("default", "hidden MCP subcommand; enablement not represented", xaa_idp.isHidden, false)
            ]
        ),
        _claudeFeatureGateRecord(
            "immediate-command",
            "src/app/llm_caret/claude_full/utils/immediateCommand.spl",
            "test/03_system/tools/llm/claude_full/utils/immediate_command_spec.spl",
            "command-immediacy",
            "enabled",
            "shouldInferenceConfigCommandBeImmediate",
            "",
            false,
            false,
            false,
            false,
            shouldInferenceConfigCommandBeImmediate("external", false),
            "conditional",
            [
                _claudeFeatureGateProbe("external-disabled", "external experiment=false", false, shouldInferenceConfigCommandBeImmediate("external", false)),
                _claudeFeatureGateProbe("external-experiment", "external experiment=true", false, shouldInferenceConfigCommandBeImmediate("external", true)),
                _claudeFeatureGateProbe("ant", "userType=ant experiment=false", false, shouldInferenceConfigCommandBeImmediate("ant", false))
            ]
        ),
        _claudeFeatureGateRecord(
            "worktree-mode",
            "src/app/llm_caret/claude_full/utils/worktreeModeEnabled.spl",
            "test/03_system/tools/llm/claude_full/utils/worktree_mode_enabled_spec.spl",
            "cli-mode-admission",
            "enabled",
            "isWorktreeModeEnabled",
            "",
            false,
            false,
            true,
            false,
            isWorktreeModeEnabled(),
            "static",
            [
                _claudeFeatureGateProbe("default", "stale feature flag removed", false, isWorktreeModeEnabled())
            ]
        ),
        _claudeFeatureGateRecord(
            "init-prompt",
            "src/app/llm_caret/claude_full/commands/init.spl",
            "test/03_system/tools/llm/claude_full/commands/init_commands_spec.spl",
            "prompt-variant",
            "enabled",
            "useNewInitPrompt",
            "/init",
            false,
            true,
            true,
            false,
            useNewInitPrompt(false, "external", ""),
            "environment",
            [
                _claudeFeatureGateProbe("default", "feature=false external env empty", false, useNewInitPrompt(false, "external", "")),
                _claudeFeatureGateProbe("feature-off-dominates", "feature=false ant env=true", false, useNewInitPrompt(false, "ant", "true")),
                _claudeFeatureGateProbe("ant-enabled", "feature=true ant env empty", false, useNewInitPrompt(true, "ant", "")),
                _claudeFeatureGateProbe("env-enabled", "feature=true external env=true", false, useNewInitPrompt(true, "external", "true"))
            ]
        ),
        _claudeFeatureGateRecord(
            "tasks-v2",
            "src/app/llm_caret/claude_full/hooks/useTasksV2.spl",
            "test/03_system/tools/llm/claude_full/hooks/useTasksV2_spec.spl",
            "task-store-selection",
            "enabled",
            "useTasksV2Enabled",
            "",
            false,
            false,
            true,
            false,
            useTasksV2Enabled(false, false, false),
