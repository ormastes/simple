"""
Production-owned aggregate for Claude-full hidden disabled stub commands.

The registry imports only the import-safe leaf descriptor owners, choosing
underscore forms for hyphenated identities, and projects their heterogeneous
command values into neutral metadata records.
It remains an inward-only claude_full parts-bin capsule; shipped Caret command
admission is owned by the root registry and TUI dispatcher.
"""

use app.llm_caret.claude_full.commands.ant_trace.index.{defaultCommand as antTraceDefaultCommand}
use app.llm_caret.claude_full.commands.env.index.{defaultCommand as envDefaultCommand}
use app.llm_caret.claude_full.commands.bughunter.index.{bughunterCommand}
use app.llm_caret.claude_full.commands.issue.index.{issueCommand}
use app.llm_caret.claude_full.commands.onboarding.index.{onboardingCommand}
use app.llm_caret.claude_full.commands.share.index.{shareCommand}
use app.llm_caret.claude_full.commands.summary.index.{summaryCommand}
use app.llm_caret.claude_full.commands.teleport.index.{teleportCommand}
use app.llm_caret.claude_full.commands.break_cache.index.{breakCacheCommand}
use app.llm_caret.claude_full.commands.ctx_viz.index.{ctxVizCommand}
use app.llm_caret.claude_full.commands.good_claude.index.{goodClaudeCommand}
use app.llm_caret.claude_full.commands.mock_limits.index.{mockLimitsCommand}
use app.llm_caret.claude_full.commands.oauth_refresh.index.{oauthRefreshCommand}
use app.llm_caret.claude_full.commands.perf_issue.index.{perfIssueCommand}

class ClaudeHiddenStubCommandRecord:
    source_id: text
    source_file: text
    command_name: text
    hidden: bool
    enabled: bool

fn _hiddenStubCommandRecord(source_id: text, source_file: text, command_name: text, hidden: bool, enabled: bool) -> ClaudeHiddenStubCommandRecord:
    ClaudeHiddenStubCommandRecord(
        source_id: source_id,
        source_file: source_file,
        command_name: command_name,
        hidden: hidden,
        enabled: enabled
    )

fn hiddenDisabledStubCommandRegistry() -> [ClaudeHiddenStubCommandRecord]:
    val ant_trace = antTraceDefaultCommand()
    val environment = envDefaultCommand
    val bughunter = bughunterCommand()
    val issue = issueCommand()
    val onboarding = onboardingCommand()
    val share = shareCommand()
    val summary = summaryCommand()
    val teleport = teleportCommand()
    val break_cache = breakCacheCommand()
    val ctx_viz = ctxVizCommand()
    val good_claude = goodClaudeCommand()
    val mock_limits = mockLimitsCommand()
    val oauth_refresh = oauthRefreshCommand()
    val perf_issue = perfIssueCommand()

    [
        _hiddenStubCommandRecord("ant-trace", "src/app/llm_caret/claude_full/commands/ant_trace/index.spl", ant_trace.name, ant_trace.isHidden, ant_trace.isEnabled()),
        _hiddenStubCommandRecord("env", "src/app/llm_caret/claude_full/commands/env/index.spl", environment.name, environment.isHidden, environment.isEnabled()),
        _hiddenStubCommandRecord("bughunter", "src/app/llm_caret/claude_full/commands/bughunter/index.spl", bughunter.name, bughunter.isHidden, bughunter.isEnabled()),
        _hiddenStubCommandRecord("issue", "src/app/llm_caret/claude_full/commands/issue/index.spl", issue.name, issue.isHidden, issue.isEnabled()),
        _hiddenStubCommandRecord("onboarding", "src/app/llm_caret/claude_full/commands/onboarding/index.spl", onboarding.name, onboarding.isHidden, onboarding.isEnabled()),
        _hiddenStubCommandRecord("share", "src/app/llm_caret/claude_full/commands/share/index.spl", share.name, share.isHidden, share.isEnabled()),
        _hiddenStubCommandRecord("summary", "src/app/llm_caret/claude_full/commands/summary/index.spl", summary.name, summary.isHidden, summary.isEnabled()),
        _hiddenStubCommandRecord("teleport", "src/app/llm_caret/claude_full/commands/teleport/index.spl", teleport.name, teleport.isHidden, teleport.isEnabled()),
        _hiddenStubCommandRecord("break-cache", "src/app/llm_caret/claude_full/commands/break_cache/index.spl", break_cache.name, break_cache.isHidden, break_cache.isEnabled()),
        _hiddenStubCommandRecord("ctx-viz", "src/app/llm_caret/claude_full/commands/ctx_viz/index.spl", ctx_viz.name, ctx_viz.isHidden, ctx_viz.isEnabled()),
        _hiddenStubCommandRecord("good-claude", "src/app/llm_caret/claude_full/commands/good_claude/index.spl", good_claude.name, good_claude.isHidden, good_claude.isEnabled()),
        _hiddenStubCommandRecord("mock-limits", "src/app/llm_caret/claude_full/commands/mock_limits/index.spl", mock_limits.name, mock_limits.isHidden, mock_limits.isEnabled()),
        _hiddenStubCommandRecord("oauth-refresh", "src/app/llm_caret/claude_full/commands/oauth_refresh/index.spl", oauth_refresh.name, oauth_refresh.isHidden, oauth_refresh.isEnabled()),
        _hiddenStubCommandRecord("perf-issue", "src/app/llm_caret/claude_full/commands/perf_issue/index.spl", perf_issue.name, perf_issue.isHidden, perf_issue.isEnabled())
    ]
