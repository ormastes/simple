# codex-impl

use app.llm_caret.multimodal_types.{MultimodalRequestV1, ModelCompletionV1,
    model_completion_error_v1}
use app.llm_caret.multimodal_provider.{complete_multimodal_v1}
use app.llm_caret.config.{config_image_read_api_key}

fn validate_configured_image_secret_v1(request: MultimodalRequestV1,
        api_key: text) -> text:
    if request.profile.remote_egress and (request.profile.provider == "openai" or
            request.profile.provider == "claude_api") and api_key == "":
        return "configured image API secret is unavailable"
    ""

fn complete_configured_image_v1(request: MultimodalRequestV1) -> ModelCompletionV1:
    val api_key = config_image_read_api_key()
    val secret_error = validate_configured_image_secret_v1(request, api_key)
    if secret_error != "":
        return model_completion_error_v1("missing_secret", secret_error)
    complete_multimodal_v1(request, api_key, "", "")
