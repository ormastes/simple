# codex-impl

use app.llm_caret.multimodal_types.{ModelProfileV1}
use app.llm_caret.config.{
    config_image_read_profile_id, config_image_read_provider,
    config_image_read_base_url, config_image_read_model,
    config_image_read_model_revision, config_image_read_api_key_env,
    config_image_read_location,
    config_image_read_egress, config_image_read_vision,
    config_image_read_structured_output, config_image_read_max_images,
    config_image_read_max_pixels, config_image_read_max_request_bytes,
    config_image_read_max_output_tokens, config_image_read_timeout_ms,
    config_image_read_max_concurrency, config_image_read_trust_scope
}

fn configured_image_profile_v1() -> ModelProfileV1:
    ModelProfileV1(
        profile_id: config_image_read_profile_id(),
        provider: config_image_read_provider(),
        endpoint: config_image_read_base_url(),
        model_id: config_image_read_model(),
        model_revision: config_image_read_model_revision(),
        secret_ref: config_image_read_api_key_env(),
        vision: config_image_read_vision(),
        structured_output: config_image_read_structured_output(),
        remote_egress: config_image_read_egress() and config_image_read_location() == "remote",
        fallback_provider: "",
        max_images: config_image_read_max_images(),
        max_pixels: config_image_read_max_pixels(),
        max_request_bytes: config_image_read_max_request_bytes(),
        max_output_tokens: config_image_read_max_output_tokens(),
        timeout_ms: config_image_read_timeout_ms(),
        max_concurrency: config_image_read_max_concurrency(),
        trust_scope: config_image_read_trust_scope()
    )
