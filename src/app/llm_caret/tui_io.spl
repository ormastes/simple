# LLM Caret terminal I/O seam.
#
# The production adapter is deliberately the only place where the chat loop
# reaches terminal and stdin owners. Tests can provide a CaretIo made from
# deterministic functions without declaring app-leaf runtime externs.

use std.tui.terminal.{
    TerminalSize, terminal_get_size,
    terminal_enter_raw_mode, terminal_exit_raw_mode,
    terminal_enter_alt_screen, terminal_exit_alt_screen,
    terminal_hide_cursor, terminal_show_cursor,
    terminal_clear_screen, terminal_draw_at, terminal_flush,
    terminal_read_byte, terminal_install_recovery, terminal_resize_pending
}
use std.nogc_sync_mut.io.pipe.{Stdin}
use std.sys.pty.{read as pty_read}
use std.sffi.platform.{platform_name_raw}
use std.io_runtime.{time_now_monotonic_ms}
# @workaround bug=caret_essential_leaf_provider_gaps_2026_10_10
use std.nogc_async_mut.sosix.host_facade.{sosix_print_raw}
use app.llm_caret.tui_input.{caret_is_tty}

struct CaretIo:
    is_tty: fn() -> bool
    terminal_size: fn() -> TerminalSize
    begin_tui: fn() -> CaretTerminalResult
    end_tui: fn() -> CaretTerminalResult
    clear_screen: fn()
    draw_at: fn(i64, i64, text)
    flush: fn()
    read_byte: fn() -> i64
    # True when a byte is already waiting, so the line reader can consume a
    # burst (a pasted or injected message) before paying for a redraw.
    input_pending: fn() -> bool
    # Explicit `(has_line, line)` avoids Optional(text) crossing the hybrid
    # InterpCall ABI, where boxed optional payloads were previously corrupted.
    read_line: fn() -> (bool, text)
    emit: fn(text)

# Terminal lifecycle state belongs to the production adapter, not the chat
# loop.  The adapter is process-local because a terminal can only have one
# active raw/alternate-screen session at a time.
var PRODUCTION_RAW_ACQUIRED = false
var PRODUCTION_ALT_ACQUIRED = false
var PRODUCTION_CURSOR_HIDDEN = false

struct CaretTerminalResult:
    ok: bool
    phase: text
    error: text

fn caret_terminal_ok(phase: text) -> CaretTerminalResult:
    CaretTerminalResult(ok: true, phase: phase, error: "")

fn caret_terminal_error(phase: text, error: text) -> CaretTerminalResult:
    CaretTerminalResult(ok: false, phase: phase, error: error)

struct CaretLoopResult:
    mode: text
    ok: bool
    exit_reason: text
    error: text

fn _production_is_tty() -> bool:
    caret_is_tty()

fn _production_terminal_size() -> TerminalSize:
    terminal_resize_pending()
    terminal_get_size()

fn _production_enter_raw() -> bool:
    if not terminal_install_recovery():
        return false
    terminal_enter_raw_mode()

fn _production_begin_tui() -> CaretTerminalResult:
    if not _production_enter_raw():
        return caret_terminal_error("raw-mode", "failed to enter raw mode")
    PRODUCTION_RAW_ACQUIRED = true

    terminal_enter_alt_screen()
    PRODUCTION_ALT_ACQUIRED = true

    terminal_hide_cursor()
    PRODUCTION_CURSOR_HIDDEN = true
    caret_terminal_ok("cursor-hide")

fn _production_end_tui() -> CaretTerminalResult:
    # Reverse the portions actually acquired.  The stdout-only terminal
    # primitives have no failure return; raw restoration is the observable
    # cleanup failure and must still leave the remaining state untouched for a
    # later idempotent retry.
    if PRODUCTION_CURSOR_HIDDEN:
        terminal_show_cursor()
        PRODUCTION_CURSOR_HIDDEN = false

    if PRODUCTION_ALT_ACQUIRED:
        terminal_exit_alt_screen()
        PRODUCTION_ALT_ACQUIRED = false

    if PRODUCTION_RAW_ACQUIRED:
        if not terminal_exit_raw_mode():
            return caret_terminal_error("raw-mode", "failed to exit raw mode")
        PRODUCTION_RAW_ACQUIRED = false

    caret_terminal_ok("terminal-cleanup")

fn _production_clear_screen():
    terminal_clear_screen()

fn _production_draw_at(row: i64, col: i64, content: text):
    terminal_draw_at(row, col, content)

fn _production_flush():
    terminal_flush()

# Stdin is read at the fd, in chunks, into this queue. rt_stdin_read_byte goes
# through the runtime's buffered stdin, which pulls every waiting byte into a
# buffer no poll can see, so "is more input pending?" could never be answered
# and every byte of a burst paid for a full frame redraw.
var PRODUCTION_INPUT: [i64] = []
var PRODUCTION_INPUT_AT = 0
# A hung-up tty makes every read return "" at once; this many back-to-back
# instant empty reads is EOF (same bound as cs_main's input loop).
const _PRODUCTION_MAX_INSTANT_EMPTY_READS: i64 = 200

fn _production_fd_input() -> bool:
    platform_name_raw() != "windows"

fn _production_fill_input(timeout_ms: i64) -> bool:
    if PRODUCTION_INPUT_AT >= PRODUCTION_INPUT.len():
        PRODUCTION_INPUT = []
        PRODUCTION_INPUT_AT = 0
    val chunk = pty_read(0, timeout_ms)
    if chunk == "":
        return false
    for b in chunk.bytes():
        PRODUCTION_INPUT = PRODUCTION_INPUT + [b as i64]
    true

fn _production_read_byte() -> i64:
    if not _production_fd_input():
        return terminal_read_byte()
    var instant_empty = 0
    while PRODUCTION_INPUT_AT >= PRODUCTION_INPUT.len():
        val before = time_now_monotonic_ms()
        if _production_fill_input(200):
            instant_empty = 0
        elif time_now_monotonic_ms() - before < 5:
            instant_empty = instant_empty + 1
            if instant_empty >= _PRODUCTION_MAX_INSTANT_EMPTY_READS:
                return -1
        else:
            instant_empty = 0
    val b = PRODUCTION_INPUT[PRODUCTION_INPUT_AT]
    PRODUCTION_INPUT_AT = PRODUCTION_INPUT_AT + 1
    b

fn _production_input_pending() -> bool:
    if not _production_fd_input():
        return false
    if PRODUCTION_INPUT_AT < PRODUCTION_INPUT.len():
        return true
    _production_fill_input(0)

fn _production_read_line() -> (bool, text):
    val input = Stdin.new()
    match input.read_line():
        case Ok(line): (true, line)
        case Err(_): (false, "")

fn _production_emit(content: text):
    sosix_print_raw(content)

fn production_caret_io() -> CaretIo:
    CaretIo(
        is_tty: _production_is_tty,
        terminal_size: _production_terminal_size,
        begin_tui: _production_begin_tui,
        end_tui: _production_end_tui,
        clear_screen: _production_clear_screen,
        draw_at: _production_draw_at,
        flush: _production_flush,
        read_byte: _production_read_byte,
        input_pending: _production_input_pending,
        read_line: _production_read_line,
        emit: _production_emit
    )
