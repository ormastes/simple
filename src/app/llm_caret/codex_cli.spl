# LLM Caret - Codex CLI Wrapper
#
# ponytail: `codex exec` prints plain text, so there is no JSON parser here.
# Upgrade path: add `--json` parsing if structured usage/session data is needed.

use app.io.mod.{process_run, process_spawn_async, process_is_running, process_kill}

struct CodexCliResponse:
    content: text
    model: text
    session_id: text
    stop_reason: text
    input_tokens: i64
    output_tokens: i64
    error: text
    is_error: bool
    raw: text

struct CodexProcessResult:
    status: text
    reason: text
    pid: i64

struct CodexInvocation:
    path: text
    args: [text]

fn _error_response(error: text, model: text, session_id: text, raw: text) -> CodexCliResponse:
    CodexCliResponse(
        content: "",
        model: model,
        session_id: session_id,
        stop_reason: "error",
        input_tokens: 0,
        output_tokens: 0,
        error: error,
        is_error: true,
        raw: raw
    )

pub fn build_codex_args(prompt: text, model: text, session_id: text, extra_args: [text]) -> [text]:
    var args = ["exec", "--skip-git-repo-check"]
    if model != "":
        args = args + ["--model", model]
    for arg in extra_args:
        if arg != "":
            args = args + [arg]
    args + [prompt]

pub fn build_codex_invocation(cli_path: text, prompt: text, model: text, session_id: text, extra_args: [text]) -> CodexInvocation:
    var path = cli_path
    if path == "":
        path = "codex"
    CodexInvocation(path: path, args: build_codex_args(prompt, model, session_id, extra_args))

pub fn parse_codex_response(raw: text, model: text, session_id: text) -> CodexCliResponse:
    val trimmed = raw.trim()
    if trimmed == "":
        return _error_response("empty response", model, session_id, raw)
    CodexCliResponse(
        content: trimmed,
        model: model,
        session_id: session_id,
        stop_reason: "stop",
        input_tokens: 0,
        output_tokens: 0,
        error: "",
        is_error: false,
        raw: raw
    )

pub fn complete_codex_process(model: text, session_id: text, stdout: text, stderr: text, exit_code: i64) -> CodexCliResponse:
    if exit_code != 0:
        var err = "codex CLI exited with code " + exit_code.to_text()
        if stderr.trim() != "":
            err = err + ": " + stderr.trim()
        return _error_response(err, model, session_id, stdout)
    parse_codex_response(stdout, model, session_id)

pub fn codex_cli_send(cli_path: text, prompt: text, model: text, session_id: text, extra_args: [text]) -> CodexCliResponse:
    val invocation = build_codex_invocation(cli_path, prompt, model, session_id, extra_args)
    val result = process_run(invocation.path, invocation.args)
    val stdout = result.0 ?? ""
    val stderr = result.1 ?? ""
    val exit_code = result.2
    complete_codex_process(model, session_id, stdout, stderr, exit_code)

pub fn codex_cli_spawn(cli_path: text, prompt: text, model: text, session_id: text, extra_args: [text]) -> CodexProcessResult:
    val invocation = build_codex_invocation(cli_path, prompt, model, session_id, extra_args)
    val pid = process_spawn_async(invocation.path, invocation.args)
    if pid <= 0:
        return CodexProcessResult(status: "error", reason: "spawn_failed", pid: pid)
    CodexProcessResult(status: "started", reason: "process_spawned", pid: pid)

pub fn codex_cli_running_status(pid: i64) -> text:
    if pid <= 0:
        return "not_running"
    if process_is_running(pid):
        return "running"
    "not_running"

pub fn codex_cli_kill(pid: i64) -> CodexProcessResult:
    if pid <= 0:
        return CodexProcessResult(status: "not_stopped", reason: "invalid_pid", pid: pid)
    if process_kill(pid):
        return CodexProcessResult(status: "stopped", reason: "process_killed", pid: pid)
    CodexProcessResult(status: "error", reason: "process_kill_failed", pid: pid)

export CodexCliResponse, CodexProcessResult, CodexInvocation
export build_codex_args, build_codex_invocation, parse_codex_response, complete_codex_process
export codex_cli_send, codex_cli_spawn, codex_cli_running_status, codex_cli_kill
