# LLM Caret - Claude API (Anthropic Messages API)
#
# Builds HTTP requests for the Anthropic Messages API.
# Pure functions for request/response JSON building/parsing.

use app.llm_caret.retry.{retry_policy_from_env, with_retry}
use app.llm_caret.json_helpers.{json_find, json_parse_int}

use std.nogc_sync_mut.io.http_sffi.{http_request_raw}

# ============================================================================
# JSON helpers (inlined)
# ============================================================================

fn _LB() -> text:
    (123 as char).to_text()

fn _RB() -> text:
    (125 as char).to_text()

fn _Q() -> text:
    "\""

fn _escape_json(s: text) -> text:
    var parts = []
    var i = 0
    while i < s.len():
        val ch = s[i]
        if ch == "\\":
            parts.append("\\\\")
        elif ch == "\"":
            parts.append("\\\"")
        elif ch == "\n":
            parts.append("\\n")
        elif ch == "\r":
            parts.append("\\r")
        elif ch == "\t":
            parts.append("\\t")
        else:
            parts.append(ch)
        i = i + 1
    parts.join("")

fn _extract_json_string(json: text, key: text) -> text:
    val quote = "\""
    val search = quote + key + quote + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return ""
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    if trimmed.starts_with(quote):
        val rest = trimmed.substring(1)
        var end = 0
        var escaped = false
        while end < rest.len():
            val ch = rest[end]
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                return rest.substring(0, end)
            end = end + 1
    ""

fn _extract_json_value(json: text, key: text) -> text:
    val search = _Q() + key + _Q() + ":"
    val idx = json_find(json, search)
    if idx < 0:
        return "null"
    val slen = search.len()
    val start = idx + slen
    val after = json.substring(start)
    val trimmed = after.trim()
    var end = 0
    while end < trimmed.len():
        val ch = trimmed[end]
        if ch == "," or ch == _RB() or ch == "]":
            break
        end = end + 1
    trimmed.substring(0, end).trim()

fn _extract_json_int(json: text, key: text) -> i64:
    val raw = _extract_json_value(json, key)
    if raw == "null" or raw == "":
        return 0
    json_parse_int(raw)

# ============================================================================
# Response struct
# ============================================================================

struct ApiResponse:
    content: text
    model: text
    stop_reason: text
    input_tokens: i64
    output_tokens: i64
    error: text
    is_error: bool
    raw: text

struct ClaudeApiRequest:
    method: text
    url: text
    headers: text
    body: text

# ============================================================================
# Pure Function: build request body JSON
# ============================================================================

fn build_claude_api_body(model: text, messages_json: text, system_prompt: text, max_tokens: i64) -> text:
    var parts: [text] = []
    # Model
    var model_val = model
    if model_val == "":
        model_val = "claude-sonnet-4-20250514"
    parts = parts + [_Q() + "model" + _Q() + ":" + _Q() + _escape_json(model_val) + _Q()]
    # Max tokens
    var tokens = max_tokens
    if tokens <= 0:
        tokens = 4096
    parts = parts + [_Q() + "max_tokens" + _Q() + ":" + tokens.to_text()]
    # System prompt
    if system_prompt != "":
        parts = parts + [_Q() + "system" + _Q() + ":" + _Q() + _escape_json(system_prompt) + _Q()]
    # Messages
    parts = parts + [_Q() + "messages" + _Q() + ":" + messages_json]
    # Join parts
    var body_parts = []
    body_parts.append(_LB())
    var i = 0
    for part in parts:
        if i > 0:
            body_parts.append(",")
        body_parts.append(part)
        i = i + 1
    body_parts.append(_RB())
    body_parts.join("")

# Build headers string for Anthropic API
fn build_claude_api_headers(api_key: text) -> text:
    var parts = []
    parts.append("x-api-key: " + api_key)
    parts.append("anthropic-version: 2023-06-01")
    parts.append("content-type: application/json")
    parts.join("\n")

# Build a messages array for a single user message
fn build_single_message_json(role: text, content: text) -> text:
    var parts = []
    parts.append(_LB())
    parts.append(_Q() + "role" + _Q() + ":" + _Q() + _escape_json(role) + _Q() + ",")
    parts.append(_Q() + "content" + _Q() + ":" + _Q() + _escape_json(content) + _Q())
    parts.append(_RB())
    "[" + parts.join("") + "]"

fn claude_api_endpoint_url(base_url: text) -> text:
    var base = base_url
    while base.len() > 0 and base.ends_with("/"):
        base = base.substring(0, base.len() - 1)
    base + "/v1/messages"

fn build_claude_api_request(api_key: text, base_url: text, model: text, messages_json: text, system_prompt: text, max_tokens: i64) -> ClaudeApiRequest:
    ClaudeApiRequest(
        method: "POST",
        url: claude_api_endpoint_url(base_url),
        headers: build_claude_api_headers(api_key),
        body: build_claude_api_body(model, messages_json, system_prompt, max_tokens)
    )

# ============================================================================
# Pure Function: parse response JSON
# ============================================================================

fn parse_claude_api_response(raw: text) -> ApiResponse:
    val trimmed_raw = raw.trim()
    if trimmed_raw == "":
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "",
            input_tokens: 0,
            output_tokens: 0,
            error: "empty response",
            is_error: true,
            raw: ""
        )
    if not trimmed_raw.starts_with(_LB()) or not trimmed_raw.ends_with(_RB()):
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "error",
            input_tokens: 0,
            output_tokens: 0,
            error: "malformed response",
            is_error: true,
            raw: raw
        )
    # Check for error response
    val error_type = _extract_json_string(raw, "type")
    if error_type == "error":
        val error_msg = _extract_json_string(raw, "message")
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "error",
            input_tokens: 0,
            output_tokens: 0,
            error: error_msg,
            is_error: true,
            raw: raw
        )
    if not _has_json_key(raw, "text") or not _has_json_string_value(raw, "text"):
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "error",
            input_tokens: 0,
            output_tokens: 0,
            error: "malformed response",
            is_error: true,
            raw: raw
        )
    # Extract content from content[0].text
    val content_text = _extract_json_string(raw, "text")
    val model_val = _extract_json_string(raw, "model")
    val stop = _extract_json_string(raw, "stop_reason")
    val in_tok = _extract_json_int(raw, "input_tokens")
    val out_tok = _extract_json_int(raw, "output_tokens")
    var final_stop = stop
    if final_stop == "":
        final_stop = "end_turn"
    ApiResponse(
        content: content_text,
        model: model_val,
        stop_reason: final_stop,
        input_tokens: in_tok,
        output_tokens: out_tok,
        error: "",
        is_error: false,
        raw: raw
    )

fn _has_json_key(json: text, key: text) -> bool:
    json_find(json, _Q() + key + _Q() + ":") >= 0

fn _has_json_string_value(json: text, key: text) -> bool:
    val marker = _Q() + key + _Q() + ":"
    val index = json_find(json, marker)
    if index < 0:
        return false
    val after = json.substring(index + marker.len()).trim()
    if not after.starts_with(_Q()):
        return false
    val rest = after.substring(1)
    var end = 0
    var escaped = false
    while end < rest.len():
        val ch = rest[end]
        if escaped:
            escaped = false
        elif ch == "\\":
            escaped = true
        elif ch == _Q():
            return true
        end = end + 1
    false

fn complete_claude_api_exchange(raw: text, transport_error: text) -> ApiResponse:
    if transport_error != "":
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "error",
            input_tokens: 0,
            output_tokens: 0,
            error: "HTTP error: " + transport_error,
            is_error: true,
            raw: raw
        )
    parse_claude_api_response(raw)

# ============================================================================
# Impure Function: send request
# ============================================================================

fn claude_api_send(api_key: text, base_url: text, model: text, messages_json: text, system_prompt: text, max_tokens: i64) -> ApiResponse:
    if api_key == "":
        return ApiResponse(
            content: "",
            model: "",
            stop_reason: "error",
            input_tokens: 0,
            output_tokens: 0,
            error: "ANTHROPIC_API_KEY not set",
            is_error: true,
            raw: ""
        )
    val request = build_claude_api_request(api_key, base_url, model, messages_json, system_prompt, max_tokens)
    val policy = retry_policy_from_env()
    val outcome = with_retry(policy, fn(attempt: i64) -> (i64, text, text, i64):
        val result = http_request_raw(request.method, request.url, request.headers, request.body)
        (result.0, result.1 ?? "", result.2 ?? "", 0)
    )
    complete_claude_api_exchange(outcome.body, outcome.error)
