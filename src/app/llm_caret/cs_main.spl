# `cs` — caret suite entry point.
#
# Renders the dashboard, reads a command from the bottom input line, applies it,
# and repeats. Everything terminal-facing goes through the injectable `CaretIo`
# seam (`app.llm_caret.tui_io`), which is why this loop is testable with no TTY,
# no tmux and no live agent: a spec supplies a CaretIo built from deterministic
# functions and asserts on what was emitted.
#
# Host access goes through the sosix facade, never through a native library
# directly — see doc/02_requirements/nfr/cs_caret_suite.md NFR-1.

use app.llm_caret.tui_io.{CaretIo, CaretLoopResult, CaretTerminalResult, caret_terminal_ok}
use std.nogc_sync_mut.io.pipe.{Stdin}
use std.nogc_sync_mut.tui.terminal.{TerminalSize}
use app.llm_caret.cs_dashboard.{CsDashboard, cs_dashboard_new, cs_refresh,
    cs_render, cs_handle_command, cs_apply_action}
use std.nogc_sync_mut.cli.cli_util.{get_cli_args}
use std.io_runtime.{env_get}

const CS_DEFAULT_SESSION: text = "caret"
const _CS_MIN_COLS: i64 = 40
const _CS_MIN_ROWS: i64 = 10

# A non-tty (piped stdin, CI) reports 0x0. Clamp rather than rendering a
# zero-row frame, so the dashboard is still readable when piped.
fn cs_effective_size(cols: i64, rows: i64) -> (i64, i64):
    var c = cols
    var r = rows
    if c < _CS_MIN_COLS:
        c = _CS_MIN_COLS
    if r < _CS_MIN_ROWS:
        r = _CS_MIN_ROWS
    (c, r)

# The session name is the first non-flag argument; flags are reserved for later
# and are ignored rather than being mistaken for a session.
fn cs_session_from_args(args: [text]) -> text:
    var session = CS_DEFAULT_SESSION
    for arg in args:
        if not arg.starts_with("-") and arg != "":
            session = arg
    session

fn cs_run(io: CaretIo, session: text) -> CaretLoopResult:
    var d = cs_refresh(cs_dashboard_new(session))
    var reason = "eof"
    var running = true
    while running:
        val size = io.terminal_size()
        val (cols, rows) = cs_effective_size(size.cols, size.rows)
        io.emit(cs_render(d, cols, rows))
        val (has_line, line) = io.read_line()
        if has_line:
            val (after_cmd, action) = cs_handle_command(d, line)
            if action == "quit":
                d = after_cmd
                reason = "quit"
                running = false
            else:
                val (after_action, outcome) = cs_apply_action(after_cmd, action)
                # Re-poll so the next frame shows the real post-action state
                # rather than the optimistic one the reducer produced.
                d = cs_refresh(after_action)
                if outcome != "":
                    io.emit(outcome)
        else:
            running = false
    CaretLoopResult(mode: "cs", ok: true, exit_reason: reason, error: "")

# `cs` is a LINE-oriented dashboard: it prints a frame and reads a whole line.
# It therefore deliberately does NOT use `production_caret_io()`, whose adapter
# wires raw mode, the alternate screen and signal recovery — that path fails on
# the current toolchain with
#   semantic: dynamic SFFI dispatch has no compiler-owned ABI contract
#             for function 'rt_signal_check'
# and none of it is needed to print a frame and read a line. Using the heavier
# adapter would buy nothing and cost the tool its ability to start at all.
fn _plain_is_tty() -> bool:
    false

# A pipe has no intrinsic size. Honour COLUMNS/LINES when the shell exports
# them, else fall back to the conventional 80x24 rather than to the clamp
# floor, which renders a needlessly cramped frame.
fn _plain_dim(name: text, fallback: i64) -> i64:
    val raw = env_get(name) ?? ""
    if raw == "":
        return fallback
    val parsed = raw.to_int() ?? 0
    if parsed <= 0:
        return fallback
    parsed

fn _plain_size() -> TerminalSize:
    TerminalSize(cols: _plain_dim("COLUMNS", 80), rows: _plain_dim("LINES", 24))

fn _plain_begin() -> CaretTerminalResult:
    caret_terminal_ok("begin")

fn _plain_end() -> CaretTerminalResult:
    caret_terminal_ok("end")

fn _plain_noop():
    pass

fn _plain_draw(row: i64, col: i64, content: text):
    pass

fn _plain_read_byte() -> i64:
    -1

fn _plain_read_line() -> (bool, text):
    val input = Stdin.new()
    match input.read_line():
        case Ok(line): (true, line)
        case Err(_): (false, "")

fn _plain_emit(content: text):
    print content

fn cs_plain_io() -> CaretIo:
    CaretIo(
        is_tty: _plain_is_tty,
        terminal_size: _plain_size,
        begin_tui: _plain_begin,
        end_tui: _plain_end,
        clear_screen: _plain_noop,
        draw_at: _plain_draw,
        flush: _plain_noop,
        read_byte: _plain_read_byte,
        read_line: _plain_read_line,
        emit: _plain_emit
    )

fn main() -> i64:
    val result = cs_run(cs_plain_io(), cs_session_from_args(get_cli_args()))
    if result.ok:
        return 0
    1

export cs_run, cs_session_from_args, cs_effective_size, cs_plain_io, CS_DEFAULT_SESSION
