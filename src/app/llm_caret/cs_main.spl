# `cs` — caret suite entry point.
#
# Renders the dashboard, reads a command from the bottom input line, applies it,
# and repeats. Everything terminal-facing goes through the injectable `CaretIo`
# seam (`app.llm_caret.tui_io`), which is why this loop is testable with no TTY,
# no tmux and no live agent: a spec supplies a CaretIo built from deterministic
# functions and asserts on what was emitted.
#
# Host access goes through the sosix facade, never through a native library
# directly — see doc/02_requirements/nfr/cs_caret_suite.md NFR-1.

use app.llm_caret.tui_io.{CaretIo, CaretLoopResult, CaretTerminalResult, caret_terminal_ok}
use std.nogc_sync_mut.io.pipe.{Stdin}
use std.nogc_sync_mut.tui.terminal.{TerminalSize, terminal_stdin_is_tty,
    terminal_stdout_is_tty, terminal_enter_raw_mode, terminal_exit_raw_mode,
    terminal_get_size}
use std.sys.pty.{read as pty_read}
use app.llm_caret.cs_dashboard.{CsDashboard, cs_dashboard_new, cs_refresh,
    cs_render, cs_handle_command, cs_apply_action, cs_frame_rows,
    cs_poll_screens, cs_resize_agents, cs_agent_area}
use std.nogc_sync_mut.cli.cli_util.{get_cli_args}
use std.io_runtime.{env_get, time_now_unix_micros, time_now_monotonic_ms}

const CS_DEFAULT_SESSION: text = "caret"
const _CS_MIN_COLS: i64 = 40
const _CS_MIN_ROWS: i64 = 10

# ponytail: same gap as chat_tui.spl's run_chat_plain -- CaretIo.read_line()
# cannot currently tell a genuine blank command line apart from EOF (both
# come back as ""); see chat_tui.spl's note above _PLAIN_MAX_CONSECUTIVE_EMPTY_READS
# for the measured evidence and the real upgrade path (the interpreter's
# `rt_stdin_read_line` extern erasing EOF into ""). Bound the spin the same way.
#
# Deliberately far lower than the plain loop's ceiling: cs redraws a FULL FRAME
# every iteration, not a 2-byte prompt, so each spin costs ~1.9KB. Measured at
# 1000 the escape still wrote 1,944,000 bytes to stdout before exiting. 50
# consecutive blank lines is already well beyond anything a user types at a
# dashboard, and caps the worst case near 100KB.
# TODO: [llm-caret][P2] Delete this EOF ceiling once the fixed seed ships; same workaround as chat_tui.spl and obsolete for the same reason [blocked:seed-deploy]
const _CS_MAX_CONSECUTIVE_EMPTY_READS: i64 = 50

# A non-tty (piped stdin, CI) reports 0x0. Clamp rather than rendering a
# zero-row frame, so the dashboard is still readable when piped.
fn cs_effective_size(cols: i64, rows: i64) -> (i64, i64):
    var c = cols
    var r = rows
    if c < _CS_MIN_COLS:
        c = _CS_MIN_COLS
    if r < _CS_MIN_ROWS:
        r = _CS_MIN_ROWS
    (c, r)

# The session name is the first non-flag argument; flags are reserved for later
# and are ignored rather than being mistaken for a session.
fn cs_session_from_args(args: [text]) -> text:
    var session = CS_DEFAULT_SESSION
    for arg in args:
        if not arg.starts_with("-") and arg != "":
            session = arg
    session

# One submitted line: the command reducer, then its action. Returns the next
# dashboard, the outcome to show, and whether the operator quit.
fn _cs_step(d: CsDashboard, line: text) -> (CsDashboard, text, bool):
    val (after_cmd, action) = cs_handle_command(d, line)
    if action == "quit":
        return (after_cmd, "", true)
    val (after_action, outcome) = cs_apply_action(after_cmd, action)
    # Re-poll so the next frame shows the real post-action state rather than
    # the optimistic one the reducer produced.
    (cs_refresh(after_action), outcome, false)

fn cs_run(io: CaretIo, session: text) -> CaretLoopResult:
    var d = cs_refresh(cs_dashboard_new(session))
    var reason = "eof"
    var running = true
    var consecutive_empty_reads = 0
    while running:
        val size = io.terminal_size()
        val (cols, rows) = cs_effective_size(size.cols, size.rows)
        io.emit(cs_render(d, cols, rows))
        val (got_line, line) = io.read_line()
        if got_line:
            if line.trim() == "":
                consecutive_empty_reads = consecutive_empty_reads + 1
                if consecutive_empty_reads >= _CS_MAX_CONSECUTIVE_EMPTY_READS:
                    running = false
                    continue
            else:
                consecutive_empty_reads = 0
            val (next, outcome, quit) = _cs_step(d, line)
            d = next
            if quit:
                reason = "quit"
                running = false
            elif outcome != "":
                io.emit(outcome)
        else:
            running = false
    CaretLoopResult(mode: "cs", ok: true, exit_reason: reason, error: "")

# ---------------------------------------------------------------------------
# Live terminal dashboard: raw-mode keys, in-place repaint, agents polled on a
# timer so their PTYs are drained even while the operator is not typing.
# ---------------------------------------------------------------------------

# Key poll timeout; also the loop's idle tick.
const _CS_TICK_MS: i64 = 50
# Drain agent PTYs and re-capture the selected screen this often.
const _CS_POLL_MS: i64 = 200
# Full roster refresh (pane listing + per-process usage via `ps`) this often.
const _CS_REFRESH_MS: i64 = 2000
# A hung-up tty makes every read return "" at once; this many back-to-back
# instant empty reads is treated as EOF instead of spinning.
const _CS_MAX_INSTANT_EMPTY_READS: i64 = 200

fn _with_input(d: CsDashboard, input: text, log: [text]) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: d.manager_status,
        agents: d.agents, selected: d.selected, input: input, log: log,
        screen: d.screen)

fn _logged_outcome(d: CsDashboard, outcome: text) -> CsDashboard:
    var log = d.log
    for line in outcome.split("\n"):
        if line.trim() != "":
            log = log + [line]
    _with_input(d, d.input, log)

fn _two(n: i64) -> text:
    if n < 10:
        return "0" + n.to_text()
    n.to_text()

fn _clock() -> text:
    val day = (time_now_unix_micros() / 1000000) % 86400
    _two(day / 3600) + ":" + _two((day / 60) % 60) + ":" + _two(day % 60) + " UTC"

fn _live_size() -> TerminalSize:
    val size = terminal_get_size()
    if size.cols > 0 and size.rows > 0:
        return size
    _plain_size()

fn _drop_last_char(s: text) -> text:
    var chars: [text] = []
    for ch in s.chars():
        chars = chars + [ch]
    var out = ""
    var i = 0
    while i + 1 < chars.len():
        out = out + chars[i]
        i = i + 1
    out

fn _same_rows(a: [text], b: [text]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn _char_count(s: text) -> i64:
    var n = 0
    for _ch in s.chars():
        n = n + 1
    n

# The bytes that bring the screen from `prev` to `next`: only changed rows are
# rewritten (all of them when `full`), with the cursor hidden while drawing and
# then parked on the input line, inside one synchronized update (DEC 2026) so
# the terminal shows the frame at once. "" when nothing changed. Rows are exactly the
# terminal width, so no clear-to-EOL is needed (and at the last column it would
# erase the final cell).
fn cs_live_paint(prev: [text], next: [text], full: bool, cursor_col: i64) -> text:
    var body = ""
    var i = 0
    while i < next.len():
        if full or i >= prev.len() or prev[i] != next[i]:
            body = body + "\x1b[" + (i + 1).to_text() + ";1H" + next[i] + "\x1b[0m"
        i = i + 1
    if body == "":
        return ""
    val clear = if full: "\x1b[2J" else: ""
    "\x1b[?2026h\x1b[?25l" + clear + body + "\x1b[" + next.len().to_text() + ";" +
        cursor_col.to_text() + "H\x1b[?25h\x1b[?2026l"

fn _live_end():
    print_raw("\x1b[0m\x1b[?25h\x1b[?1049l")
    val _ok = terminal_exit_raw_mode()

# Requires raw mode to be on already; always leaves it off and the alternate
# screen closed, whichever way the loop ends.
fn cs_run_live(session: text) -> CaretLoopResult:
    print_raw("\x1b[?1049h")
    var d = cs_refresh(cs_dashboard_new(session))
    var prev: [text] = []
    var last_cols = -1
    var last_rows = -1
    var last_poll = time_now_monotonic_ms()
    var last_refresh = last_poll
    var last_clock = ""
    var dirty = true
    var instant_empty = 0
    var reason = "quit"
    var running = true
    while running:
        val size = _live_size()
        val (cols, rows) = cs_effective_size(size.cols, size.rows)
        var full = false
        if cols != last_cols or rows != last_rows:
            last_cols = cols
            last_rows = rows
            full = true
            val (pane_cols, pane_rows) = cs_agent_area(cols, rows)
            if pane_cols > 0:
                cs_resize_agents(d, pane_cols, pane_rows)
        val now = time_now_monotonic_ms()
        if now - last_refresh >= _CS_REFRESH_MS:
            d = cs_refresh(d)
            last_refresh = now
            last_poll = now
            dirty = true
        elif now - last_poll >= _CS_POLL_MS:
            # No agents: nothing to drain or capture. Otherwise repaint only
            # when the captured screen actually changed - an idle agent would
            # else force a full frame rebuild 5x a second for no visible change.
            if d.agents.len() > 0:
                val polled = cs_poll_screens(d)
                if not _same_rows(polled.screen, d.screen):
                    dirty = true
                d = polled
            last_poll = now
        val clock = _clock()
        if clock != last_clock:
            last_clock = clock
            dirty = true
        if dirty or full:
            val frame = cs_frame_rows(d, cols, rows, clock, true)
            var cursor = 3 + _char_count(d.input)
            if cursor > cols:
                cursor = cols
            val paint = cs_live_paint(prev, frame, full, cursor)
            if paint != "":
                print_raw(paint)
            prev = frame
            dirty = false
        val before = time_now_monotonic_ms()
        val chunk = pty_read(0, 50)
        if chunk == "":
            if time_now_monotonic_ms() - before < 5:
                instant_empty = instant_empty + 1
                if instant_empty >= _CS_MAX_INSTANT_EMPTY_READS:
                    reason = "eof"
                    running = false
            continue
        instant_empty = 0
        dirty = true
        # An escape sequence (arrow, function key) is not text input.
        if chunk.starts_with("\x1b") and chunk != "\x1b":
            continue
        for ch in chunk.chars():
            if not running:
                break
            if ch == "\x03" or ch == "\x04":
                running = false
            elif ch == "\r" or ch == "\n":
                val line = d.input
                d = _with_input(d, "", d.log)
                if line.trim() != "":
                    val (next, outcome, quit) = _cs_step(d, line)
                    d = _logged_outcome(next, outcome)
                    last_refresh = time_now_monotonic_ms()
                    if quit:
                        running = false
            elif ch == "\x7f" or ch == "\x08":
                d = _with_input(d, _drop_last_char(d.input), d.log)
            elif ch == "\x1b":
                d = _with_input(d, "", d.log)
            elif ch >= " ":
                d = _with_input(d, d.input + ch, d.log)
    _live_end()
    CaretLoopResult(mode: "cs", ok: true, exit_reason: reason, error: "")

# The line loop (`cs_plain_io`) prints a frame and reads a whole line. Neither
# loop uses `production_caret_io()`, whose adapter wires raw mode, the
# alternate screen and signal recovery — that path fails on the current
# toolchain with
#   semantic: dynamic SFFI dispatch has no compiler-owned ABI contract
#             for function 'rt_signal_check'
# and none of it is needed to print a frame and read a line. Using the heavier
# adapter would buy nothing and cost the tool its ability to start at all.
fn _plain_is_tty() -> bool:
    false

# A pipe has no intrinsic size. Honour COLUMNS/LINES when the shell exports
# them, else fall back to the conventional 80x24 rather than to the clamp
# floor, which renders a needlessly cramped frame.
fn _plain_dim(name: text, fallback: i64) -> i64:
    val raw = env_get(name) ?? ""
    if raw == "":
        return fallback
    val parsed = raw.to_int() ?? 0
    if parsed <= 0:
        return fallback
    parsed

fn _plain_size() -> TerminalSize:
    TerminalSize(cols: _plain_dim("COLUMNS", 80), rows: _plain_dim("LINES", 24))

fn _plain_begin() -> CaretTerminalResult:
    caret_terminal_ok("begin")

fn _plain_end() -> CaretTerminalResult:
    caret_terminal_ok("end")

fn _plain_noop():
    pass

fn _plain_draw(row: i64, col: i64, content: text):
    pass

fn _plain_read_byte() -> i64:
    -1

fn _plain_read_line() -> (bool, text):
    val input = Stdin.new()
    match input.read_line():
        case Ok(line): (true, line)
        case Err(_): (false, "")

fn _plain_emit(content: text):
    print content

fn _plain_no_input() -> bool:
    false

fn cs_plain_io() -> CaretIo:
    CaretIo(
        is_tty: _plain_is_tty,
        terminal_size: _plain_size,
        begin_tui: _plain_begin,
        end_tui: _plain_end,
        clear_screen: _plain_noop,
        draw_at: _plain_draw,
        flush: _plain_noop,
        read_byte: _plain_read_byte,
        input_pending: _plain_no_input,
        read_line: _plain_read_line,
        emit: _plain_emit
    )

# A real terminal gets the live dashboard; a pipe, or a terminal that refuses
# raw mode, gets the line loop.
fn main() -> i64:
    val session = cs_session_from_args(get_cli_args())
    if terminal_stdin_is_tty() and terminal_stdout_is_tty() and terminal_enter_raw_mode():
        if cs_run_live(session).ok:
            return 0
        return 1
    val result = cs_run(cs_plain_io(), session)
    if result.ok:
        return 0
    1

export cs_run, cs_run_live, cs_live_paint, cs_session_from_args, cs_effective_size, cs_plain_io, CS_DEFAULT_SESSION
