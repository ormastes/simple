# `cs` — caret suite entry point.
#
# Renders the dashboard, reads a command from the bottom input line, applies it,
# and repeats. Everything terminal-facing goes through the injectable `CaretIo`
# seam (`app.llm_caret.tui_io`), which is why this loop is testable with no TTY,
# no tmux and no live agent: a spec supplies a CaretIo built from deterministic
# functions and asserts on what was emitted.
#
# Host access goes through the sosix facade, never through a native library
# directly — see doc/02_requirements/nfr/cs_caret_suite.md NFR-1.

use app.llm_caret.tui_io.{CaretIo, CaretLoopResult, CaretTerminalResult, caret_terminal_ok}
use std.nogc_sync_mut.io.pipe.{Stdin}
use std.nogc_sync_mut.tui.terminal.{TerminalSize, terminal_stdin_is_tty,
    terminal_stdout_is_tty, terminal_enter_raw_mode, terminal_exit_raw_mode,
    terminal_get_size}
use std.sosix.pty.{sosix_pty_read as pty_read}
use std.nogc_async_mut.sosix.host_facade.{sosix_platform, sosix_print_raw as print_raw}
use app.llm_caret.cs_dashboard.{CsAgent, CsDashboard, cs_dashboard_new, cs_refresh,
    cs_render, cs_handle_command, cs_apply_action, cs_frame_rows,
    cs_poll_screens, cs_resize_agents, cs_agent_area, cs_reap_containers}
use app.llm_caret.workbench.capability_checklist.{capability_rows, capability_lines,
    capability_probes_live}
use app.llm_caret.workbench.key_resolver.{KeyEvent, KeyFocus, KeyRoute, KeyRouteKind,
    key_event, leader_switch_target}
use app.llm_caret.workbench.tui_entry.{route_workbench_key, key_route_status, workbench_leader}
use app.llm_caret.workbench.leader_keys.{new_leader_state, LeaderState, LeaderAction}
use app.llm_caret.workbench.key_chunker.{split_complete_keys, flush_carry, terminal_key_step,
    toggle_focus, focus_label}
use app.llm_caret.workbench.pane_binding.{PaneBinding, PaneBindingResult, resolve_pane_binding}
use app.llm_caret.cs_gui.{CsGuiFrame, cs_render_gui_html, cs_render_gui_frame, cs_resolve_ui_mode, cs_dashboard_session_views}
use app.llm_caret.a2ui.cs_live_host.{CaretA2uiHost}
use app.llm_caret.workbench.session_contract.{SessionId, new_session_id}
use app.llm_caret.workbench.session_source.{select_live_session, live_selected,
    publish_pane_binding, live_pane_bindings, live_pane_generation, observe_agent_generation,
    publish_live_focus}
use app.llm_caret.pane_backend.{pane_send_raw, pane_cleanup_session}
use std.common.encoding.external_text.{bytes_to_text_checked}
use std.nogc_sync_mut.cli.cli_util.{get_cli_args}
use std.io_runtime.{env_get, time_now_unix_micros, time_now_monotonic_ms}

const CS_DEFAULT_SESSION: text = "caret"
const _CS_MIN_COLS: i64 = 40
const _CS_MIN_ROWS: i64 = 10

# ponytail: same gap as chat_tui.spl's run_chat_plain -- CaretIo.read_line()
# cannot currently tell a genuine blank command line apart from EOF (both
# come back as ""); see chat_tui.spl's note above _PLAIN_MAX_CONSECUTIVE_EMPTY_READS
# for the measured evidence and the real upgrade path (the interpreter's
# `rt_stdin_read_line` extern erasing EOF into ""). Bound the spin the same way.
#
# Deliberately far lower than the plain loop's ceiling: cs redraws a FULL FRAME
# every iteration, not a 2-byte prompt, so each spin costs ~1.9KB. Measured at
# 1000 the escape still wrote 1,944,000 bytes to stdout before exiting. 50
# consecutive blank lines is already well beyond anything a user types at a
# dashboard, and caps the worst case near 100KB.
# TODO: [llm-caret][P2] Delete this EOF ceiling once the fixed seed ships; same workaround as chat_tui.spl and obsolete for the same reason [blocked:seed-deploy]
const _CS_MAX_CONSECUTIVE_EMPTY_READS: i64 = 50

# A non-tty (piped stdin, CI) reports 0x0. Clamp rather than rendering a
# zero-row frame, so the dashboard is still readable when piped.
fn cs_effective_size(cols: i64, rows: i64) -> (i64, i64):
    var c = cols
    var r = rows
    if c < _CS_MIN_COLS:
        c = _CS_MIN_COLS
    if r < _CS_MIN_ROWS:
        r = _CS_MIN_ROWS
    (c, r)

# The session name is the first non-flag argument; flags are reserved for later
# and are ignored rather than being mistaken for a session.
fn cs_session_from_args(args: [text]) -> text:
    var session = CS_DEFAULT_SESSION
    var skip_next = false
    for arg in args:
        if skip_next:
            skip_next = false
            continue
        if arg == "--backend":
            skip_next = true
            continue
        if not arg.starts_with("-") and arg != "":
            session = arg
    session

# One submitted line: the command reducer, then its action. Returns the next
# dashboard, the outcome to show, and whether the operator quit.
fn _cs_step(d: CsDashboard, line: text) -> (CsDashboard, text, bool):
    if line.trim() == "/capabilities":
        return (d, capability_lines(capability_rows(capability_probes_live())).join("\n"), false)
    if line.trim() == "/a2ui":
        val views = cs_dashboard_session_views(d)
        val now_ms = time_now_monotonic_ms()
        match CaretA2uiHost.create(d.session, "local_operator", "caret_session_local_secret_2026", false, now_ms):
            case Err(err):
                return (d, "cs-a2ui error: " + err, false)
            case Ok(host_init):
                var host = host_init
                match host.sync_dashboard(d, views, d.selected >= 0, now_ms):
                    case Err(sync_err):
                        return (d, "cs-a2ui sync error: " + sync_err, false)
                    case Ok(tree):
                        return (d, host.render_summary_line(tree), false)
    val (after_cmd, action) = cs_handle_command(d, line)
    if action == "quit":
        return (after_cmd, "", true)
    val (after_action, outcome) = cs_apply_action(after_cmd, action)
    # Re-poll so the next frame shows the real post-action state rather than
    # the optimistic one the reducer produced.
    (cs_refresh(after_action), outcome, false)

fn cs_run(io: CaretIo, session: text) -> CaretLoopResult:
    var d = cs_refresh(cs_dashboard_new(session))
    var reason = "eof"
    var running = true
    var consecutive_empty_reads = 0
    while running:
        val size = io.terminal_size()
        val (cols, rows) = cs_effective_size(size.cols, size.rows)
        io.emit(cs_render(d, cols, rows))
        val read_result = io.read_line()
        val got_line = read_result.0
        val line = read_result.1
        if got_line:
            if line.trim() == "":
                consecutive_empty_reads = consecutive_empty_reads + 1
                if consecutive_empty_reads >= _CS_MAX_CONSECUTIVE_EMPTY_READS:
                    running = false
                    continue
            else:
                consecutive_empty_reads = 0
            val (next, outcome, quit) = _cs_step(d, line)
            d = next
            if quit:
                reason = "quit"
                running = false
            elif outcome != "":
                io.emit(outcome)
        else:
            running = false
    val _reap_note = cs_reap_containers(d)
    pane_cleanup_session(session)
    CaretLoopResult(mode: "cs", ok: true, exit_reason: reason, error: "")

# ---------------------------------------------------------------------------
# Live terminal dashboard: raw-mode keys, in-place repaint, agents polled on a
# timer so their PTYs are drained even while the operator is not typing.
# ---------------------------------------------------------------------------

# Key poll timeout; also the loop's idle tick.
const _CS_TICK_MS: i64 = 50
# Drain agent PTYs and re-capture the selected screen this often.
const _CS_POLL_MS: i64 = 200
# Full roster refresh (pane listing + per-process usage via `ps`) this often.
const _CS_REFRESH_MS: i64 = 2000
# A hung-up tty makes every read return "" at once; this many back-to-back
# instant empty reads is treated as EOF instead of spinning.
const _CS_MAX_INSTANT_EMPTY_READS: i64 = 200

fn _with_input(d: CsDashboard, input: text, log: [text]) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: d.manager_status,
        agents: d.agents, selected: d.selected, input: input, log: log,
        screen: d.screen, pins: d.pins, mru: d.mru)

fn _logged_outcome(d: CsDashboard, outcome: text) -> CsDashboard:
    var log = d.log
    for line in outcome.split("\n"):
        if line.trim() != "":
            log = log + [line]
    _with_input(d, d.input, log)

fn _two(n: i64) -> text:
    if n < 10:
        return "0" + n.to_text()
    n.to_text()

fn _clock() -> text:
    val day = (time_now_unix_micros() / 1000000) % 86400
    _two(day / 3600) + ":" + _two((day / 60) % 60) + ":" + _two(day % 60) + " UTC"

fn _live_size() -> TerminalSize:
    val size = terminal_get_size()
    if size.cols > 0 and size.rows > 0:
        return size
    _plain_size()

fn _drop_last_char(s: text) -> text:
    var chars: [text] = []
    for ch in s.chars():
        chars = chars + [ch]
    var out = ""
    var i = 0
    while i + 1 < chars.len():
        out = out + chars[i]
        i = i + 1
    out

fn _same_rows(a: [text], b: [text]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn _char_count(s: text) -> i64:
    var n = 0
    for _ch in s.chars():
        n = n + 1
    n

# The bytes that bring the screen from `prev` to `next`: only changed rows are
# rewritten (all of them when `full`), with the cursor hidden while drawing and
# then parked on the input line, inside one synchronized update (DEC 2026) so
# the terminal shows the frame at once. "" when nothing changed. Rows are exactly the
# terminal width, so no clear-to-EOL is needed (and at the last column it would
# erase the final cell).
fn cs_live_paint(prev: [text], next: [text], full: bool, cursor_col: i64) -> text:
    var body = ""
    var i = 0
    while i < next.len():
        if full or i >= prev.len() or prev[i] != next[i]:
            body = body + "\x1b[" + (i + 1).to_text() + ";1H" + next[i] + "\x1b[0m"
        i = i + 1
    if body == "":
        return ""
    val clear = if full: "\x1b[2J" else: ""
    "\x1b[?2026h\x1b[?25l" + clear + body + "\x1b[" + next.len().to_text() + ";" +
        cursor_col.to_text() + "H\x1b[?25h\x1b[?2026l"

fn _live_end():
    print_raw("\x1b[0m\x1b[?25h\x1b[?1049l")
    val _ok = terminal_exit_raw_mode()

# Key name for the resolver: Ctrl+letter (except Tab/Enter/Backspace/Esc) is
# "ctrl+<letter>"; everything else is the character itself.
fn _cs_char_key(ch: text) -> KeyEvent:
    val code = ch.ord()
    val plain = code == 8 or code == 9 or code == 10 or code == 13
    if code >= 1 and code <= 26 and not plain:
        return key_event("ctrl+" + "abcdefghijklmnopqrstuvwxyz".slice(code - 1, code), ch.bytes())
    key_event(ch, ch.bytes())

# Applies a resolved leader route to the dashboard. The live dashboard is a
# command line (no raw-forward pane), so only agent selection is acted on;
# every other bound action is reported as not available yet.
fn _cs_leader_apply(d: CsDashboard, route: KeyRoute) -> CsDashboard:
    if route.kind != KeyRouteKind.Action:
        return d
    val n = leader_switch_target(route.action, route.slot, d.selected, d.agents.len())
    if n > 0:
        val (next, outcome, _quit) = _cs_step(d, "/switch " + n.to_text())
        return _logged_outcome(next, outcome)
    val status = key_route_status(route)
    if status != "":
        return _logged_outcome(d, status)
    _logged_outcome(d, "leader action not available yet")

# Pane id of the selected agent, "" when none or unlaunched.
fn _cs_selected_pane(d: CsDashboard) -> text:
    if d.selected < 0 or d.selected >= d.agents.len():
        return ""
    d.agents[d.selected].pane_id

fn _cs_focus_text(d: CsDashboard, focus: KeyFocus) -> text:
    focus_label(focus, _cs_selected_pane(d))

# The dashboard as drawn: the focus mode rides on the header status line.
fn _cs_show_focus(d: CsDashboard, focus: KeyFocus) -> CsDashboard:
    CsDashboard(session: d.session, manager_status: d.manager_status + " · " + _cs_focus_text(d, focus),
        agents: d.agents, selected: d.selected, input: d.input, log: d.log,
        screen: d.screen)

# Publishes the selected agent's (session, pane) binding through session_source
# and resolves it back. An agent with no pane publishes nothing and selects a
# session no binding names, so the guard sees it as unbound.
fn _cs_terminal_target(d: CsDashboard) -> (PaneBindingResult, SessionId):
    val pane = _cs_selected_pane(d)
    if pane == "":
        select_live_session(new_session_id("none"))
    else:
        # The live generation comes from the restart ledger fed by this
        # agent's pid: a restarted child is generation N+1, not a fresh 1.
        val agent = d.agents[d.selected]
        val gen = observe_agent_generation(agent.agent_id, agent.pid)
        val sid = SessionId(value: agent.agent_id, generation: gen)
        select_live_session(sid)
        publish_pane_binding(PaneBinding(session: sid, pane_id: pane, pane_generation: gen))
    val live = _cs_live_id(d)
    (resolve_pane_binding(live_pane_bindings(), live, live_pane_generation()), live)

# The selected agent's live (id, generation); "none" when nothing is selected.
fn _cs_live_id(d: CsDashboard) -> SessionId:
    if _cs_selected_pane(d) == "":
        return live_selected()
    val agent = d.agents[d.selected]
    SessionId(value: agent.agent_id, generation: observe_agent_generation(agent.agent_id, agent.pid))

# Production send: the smux primitive takes text, so the key bytes go through
# as UTF-8 text (escape sequences and control bytes are plain ASCII).
fn _cs_send_raw(session: text, pane: text, bytes: [u8]) -> bool:
    match bytes_to_text_checked(bytes):
        case Ok(t): pane_send_raw(session, pane, t)
        case Err(_): false

# Runs whole keys through the terminal surface. Returns the dashboard, leader
# state, the focus afterwards, and any bytes after a focus toggle (text), to be
# replayed against the new focus rather than dropped.
fn _cs_terminal_keys(d0: CsDashboard, state0: LeaderState, focus0: KeyFocus,
        keys: [[u8]], session: text) -> (CsDashboard, LeaderState, KeyFocus, text):
    cs_terminal_keys_via(d0, state0, focus0, keys,
        \pane, b: _cs_send_raw(session, pane, b))

# Same, with the pane send injected (production: `_cs_send_raw`).
fn cs_terminal_keys_via(d0: CsDashboard, state0: LeaderState, focus0: KeyFocus,
        keys: [[u8]], send: fn(text, [u8]) -> bool) -> (CsDashboard, LeaderState, KeyFocus, text):
    var d = d0
    var state = state0
    var focus = focus0
    var i = 0
    while i < keys.len():
        val (binding, live) = _cs_terminal_target(d)
        val pane = _cs_selected_pane(d)
        val step = terminal_key_step(workbench_leader(), state, keys[i], binding,
            live.value, live.generation, \b: send(pane, b))
        state = step.state
        i = i + 1
        if step.status != "":
            d = _logged_outcome(d, step.status)
        if step.route.kind == KeyRouteKind.Action:
            if step.route.action == LeaderAction.ToggleComposerTerminal:
                focus = toggle_focus(focus)
                d = _logged_outcome(d, _cs_focus_text(d, focus))
                var rest: [u8] = []
                while i < keys.len():
                    for b in keys[i]:
                        rest.push(b)
                    i = i + 1
                return match bytes_to_text_checked(rest):
                    case Ok(t): (d, state, focus, t)
                    case Err(_): (_logged_outcome(d, "dropped replay keys: not valid UTF-8"), state, focus, "")
            d = _cs_leader_apply(d, step.route)
    (d, state, focus, "")

# Requires raw mode to be on already; always leaves it off and the alternate
# screen closed, whichever way the loop ends.
fn cs_run_live(session: text) -> CaretLoopResult:
    print_raw("\x1b[?1049h")
    var d = cs_refresh(cs_dashboard_new(session))
    var prev: [text] = []
    var last_cols = -1
    var last_rows = -1
    var last_poll = time_now_monotonic_ms()
    var last_refresh = last_poll
    var last_clock = ""
    var dirty = true
    var instant_empty = 0
    var reason = "quit"
    var running = true
    var leader_state = new_leader_state()
    var focus = KeyFocus.NativeView
    var carry: [u8] = []
    var replay = ""
    while running:
        publish_live_focus(focus)
        val size = _live_size()
        val (cols, rows) = cs_effective_size(size.cols, size.rows)
        var full = false
        if cols != last_cols or rows != last_rows:
            last_cols = cols
            last_rows = rows
            full = true
            val (pane_cols, pane_rows) = cs_agent_area(cols, rows)
            if pane_cols > 0:
                cs_resize_agents(d, pane_cols, pane_rows)
        val now = time_now_monotonic_ms()
        if now - last_refresh >= _CS_REFRESH_MS:
            d = cs_refresh(d)
            last_refresh = now
            last_poll = now
            dirty = true
        elif now - last_poll >= _CS_POLL_MS:
            # No agents: nothing to drain or capture. Otherwise repaint only
            # when the captured screen actually changed - an idle agent would
            # else force a full frame rebuild 5x a second for no visible change.
            if d.agents.len() > 0:
                val polled = cs_poll_screens(d)
                if not _same_rows(polled.screen, d.screen):
                    dirty = true
                d = polled
            last_poll = now
        val clock = _clock()
        if clock != last_clock:
            last_clock = clock
            dirty = true
        if dirty or full:
            val frame = cs_frame_rows(_cs_show_focus(d, focus), cols, rows, clock, true)
            var cursor = 3 + _char_count(d.input)
            if cursor > cols:
                cursor = cols
            val paint = cs_live_paint(prev, frame, full, cursor)
            if paint != "":
                print_raw(paint)
            prev = frame
            dirty = false
        val before = time_now_monotonic_ms()
        var chunk = replay
        replay = ""
        if chunk == "":
            chunk = pty_read(0, 50)
        if chunk == "":
            if carry.len() > 0 and focus == KeyFocus.TerminalSurface:
                # Idle: nothing completed the carried tail (a lone Esc).
                val flushed = flush_carry(carry)
                carry = []
                val (fd, fs, ff, fr) = _cs_terminal_keys(d, leader_state, focus, flushed, session)
                d = fd
                leader_state = fs
                focus = ff
                replay = fr
                dirty = true
            if time_now_monotonic_ms() - before < 5:
                instant_empty = instant_empty + 1
                if instant_empty >= _CS_MAX_INSTANT_EMPTY_READS:
                    reason = "eof"
                    running = false
            continue
        instant_empty = 0
        dirty = true
        if focus == KeyFocus.TerminalSurface:
            # The whole chunk is resolved byte-safely; a split escape sequence
            # or UTF-8 character waits in `carry` for the next read.
            val (keys, rest) = split_complete_keys(carry, chunk.bytes())
            carry = rest
            val (td, ts, tf, tr) = _cs_terminal_keys(d, leader_state, focus, keys, session)
            d = td
            leader_state = ts
            focus = tf
            replay = tr
            continue
        # An escape sequence (arrow, function key) is not text input; only an
        # F10 leader (CARET_LEADER_KEY=f10) is routed through the resolver.
        if chunk.starts_with("\x1b") and chunk != "\x1b":
            if chunk == "\x1b[21~":
                val fr = route_workbench_key(leader_state, key_event("f10", chunk.bytes()), KeyFocus.NativeView)
                leader_state = fr.state
                d = _cs_leader_apply(d, fr.route)
            continue
        for ch in chunk.chars():
            if not running:
                break
            val kr = route_workbench_key(leader_state, _cs_char_key(ch), KeyFocus.NativeView)
            leader_state = kr.state
            if kr.route.kind != KeyRouteKind.Widget:
                if kr.route.kind == KeyRouteKind.Action and kr.route.action == LeaderAction.ToggleComposerTerminal:
                    focus = toggle_focus(focus)
                    d = _logged_outcome(d, _cs_focus_text(d, focus))
                    continue
                d = _cs_leader_apply(d, kr.route)
                continue
            if ch == "\x03" or ch == "\x04":
                running = false
            elif ch == "\r" or ch == "\n":
                val line = d.input
                d = _with_input(d, "", d.log)
                if line.trim() != "":
                    val (next, outcome, quit) = _cs_step(d, line)
                    d = _logged_outcome(next, outcome)
                    last_refresh = time_now_monotonic_ms()
                    if quit:
                        running = false
            elif ch == "\x7f" or ch == "\x08":
                d = _with_input(d, _drop_last_char(d.input), d.log)
            elif ch == "\x1b":
                d = _with_input(d, "", d.log)
            elif ch >= " ":
                d = _with_input(d, d.input + ch, d.log)
    _live_end()
    val _reap_note = cs_reap_containers(d)
    pane_cleanup_session(session)
    CaretLoopResult(mode: "cs", ok: true, exit_reason: reason, error: "")

# The line loop (`cs_plain_io`) prints a frame and reads a whole line. Neither
# loop uses `production_caret_io()`, whose adapter wires raw mode, the
# alternate screen and signal recovery — that path fails on the current
# toolchain with
#   semantic: dynamic SFFI dispatch has no compiler-owned ABI contract
#             for function 'rt_signal_check'
# and none of it is needed to print a frame and read a line. Using the heavier
# adapter would buy nothing and cost the tool its ability to start at all.
fn _plain_is_tty() -> bool:
    false

# A pipe has no intrinsic size. Honour COLUMNS/LINES when the shell exports
# them, else fall back to the conventional 80x24 rather than to the clamp
# floor, which renders a needlessly cramped frame.
fn _plain_dim(name: text, fallback: i64) -> i64:
    val raw = env_get(name) ?? ""
    if raw == "":
        return fallback
    val parsed = raw.parse_int() ?? 0
    if parsed <= 0:
        return fallback
    parsed

fn _plain_size() -> TerminalSize:
    TerminalSize(cols: _plain_dim("COLUMNS", 80), rows: _plain_dim("LINES", 24))

fn _plain_begin() -> CaretTerminalResult:
    caret_terminal_ok("begin")

fn _plain_end() -> CaretTerminalResult:
    caret_terminal_ok("end")

fn _plain_noop():
    pass

fn _plain_draw(row: i64, col: i64, content: text):
    pass

fn _plain_read_byte() -> i64:
    -1

fn _plain_read_line() -> (bool, text):
    val input = Stdin.new()
    match input.read_line():
        case Ok(line): (true, line)
        case Err(_): (false, "")

fn _plain_emit(content: text):
    print content

fn _plain_no_input() -> bool:
    false

fn cs_plain_io() -> CaretIo:
    CaretIo(
        is_tty: _plain_is_tty,
        terminal_size: _plain_size,
        begin_tui: _plain_begin,
        end_tui: _plain_end,
        clear_screen: _plain_noop,
        draw_at: _plain_draw,
        flush: _plain_noop,
        read_byte: _plain_read_byte,
        input_pending: _plain_no_input,
        read_line: _plain_read_line,
        emit: _plain_emit
    )

# The current timed input owner reads POSIX fd 0. On Windows its argument is
# a registered ConPTY session id (starting at 1), not console stdin. Raw mode
# support alone therefore does not establish live-input support.
fn cs_live_input_supported(platform: text, stdin_tty: bool, stdout_tty: bool) -> bool:
    platform == "posix" and stdin_tty and stdout_tty

fn _cs_backend_from_args(args: [text]) -> text:
    var i: i64 = 0
    while i < args.len():
        val a = args[i]
        if a == "--backend" and i + 1 < args.len():
            return args[i + 1]
        if a.starts_with("--backend="):
            return a[10:a.len()]
        i = i + 1
    "software"

# A real terminal gets the live dashboard; a pipe, or a terminal that refuses
# raw mode, gets the line loop, unless GUI mode is explicitly requested.
fn main() -> i64:
    val args = get_cli_args()
    val session = cs_session_from_args(args)
    val ui_mode = cs_resolve_ui_mode(args)
    if ui_mode == "gui_frame_once" or ui_mode == "gui":
        val backend = _cs_backend_from_args(args)
        val dash = cs_refresh(cs_dashboard_new(session))
        val frame = cs_render_gui_frame(dash, 960, 600, backend)
        print "cs-gui-frame: session={dash.session} backend={frame.resolved_backend} source={frame.readback_source} cpu_fallback={frame.cpu_fallback_used} width={frame.width} height={frame.height} checksum={frame.checksum}"
        if frame.pixels.len() == 0:
            return 1
        return 0
    if ui_mode == "a2ui" or ui_mode == "a2ui_json":
        val dash = cs_refresh(cs_dashboard_new(session))
        val views = cs_dashboard_session_views(dash)
        val now_ms = time_now_monotonic_ms()
        match CaretA2uiHost.create(session, "local_operator", "caret_session_local_secret_2026", false, now_ms):
            case Err(err):
                print "cs-a2ui-error: " + err
                return 1
            case Ok(host_init):
                var host = host_init
                match host.sync_dashboard(dash, views, dash.selected >= 0, now_ms):
                    case Err(sync_err):
                        print "cs-a2ui-error: " + sync_err
                        return 1
                    case Ok(tree):
                        if ui_mode == "a2ui_json":
                            match host.export_wire_messages([]):
                                case Ok(msgs):
                                    for m in msgs:
                                        print m
                                case Err(jerr):
                                    print "cs-a2ui-error: " + jerr
                                    return 1
                        else:
                            print host.render_summary_line(tree)
                        return 0
    if cs_live_input_supported(sosix_platform(), terminal_stdin_is_tty(), terminal_stdout_is_tty()) and terminal_enter_raw_mode():
        if cs_run_live(session).ok:
            return 0
        return 1
    val result = cs_run(cs_plain_io(), session)
    if result.ok:
        return 0
    1

export cs_terminal_keys_via, cs_live_input_supported, cs_run, cs_run_live, cs_live_paint, cs_session_from_args, cs_effective_size, cs_plain_io, CS_DEFAULT_SESSION, CsGuiFrame, cs_render_gui_html, cs_render_gui_frame, cs_resolve_ui_mode
