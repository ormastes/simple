# LLM Caret - Agent plan runtime launcher

use app.io.mod.{process_spawn_async, process_spawn_async_env, process_is_running, process_kill}
use app.llm_caret.agent_plan.{AgentLaunchPlan, AgentLaunchRequest, build_agent_launch_plan}

struct AgentProcess:
    agent_id: text
    status: text
    reason: text
    pid: i64

struct AgentTeamProcess:
    team_id: text
    status: text
    reason: text
    processes: [AgentProcess]

struct MessagingAgentLaunchContext:
    task_id: text
    room_id: text
    agent_id: text
    database_path: text

pub fn messaging_agent_environment(context: MessagingAgentLaunchContext) -> {text: text}:
    var env: {text: text} = {}
    if context.task_id != "":
        env["LLM_CARET_TASK_ID"] = context.task_id
    if context.room_id != "":
        env["LLM_CARET_ROOM_ID"] = context.room_id
    if context.agent_id != "":
        env["LLM_CARET_AGENT_ID"] = context.agent_id
    if context.database_path != "":
        env["LLM_CARET_MESSAGING_DB"] = context.database_path
    env

pub fn is_known_agent_provider(provider: text) -> bool:
    provider == "" or provider == "claude" or provider == "claude_cli" or
        provider == "codex" or provider == "opencode_cli" or
        provider == "gemini" or provider == "gemini_cli" or
        provider == "kimi" or provider == "kimi_cli" or provider == "team"

pub fn agent_command_for_provider(provider: text, claude_path: text, codex_path: text, opencode_path: text) -> text:
    agent_command_for_provider_with_gemini(provider, claude_path, codex_path, "", opencode_path)

pub fn agent_command_for_provider_with_gemini(provider: text, claude_path: text,
        codex_path: text, gemini_path: text, opencode_path: text) -> text:
    agent_command_for_provider_with_all(provider, claude_path, codex_path,
        gemini_path, "", opencode_path)

pub fn agent_command_for_provider_with_all(provider: text, claude_path: text,
        codex_path: text, gemini_path: text, kimi_path: text,
        opencode_path: text) -> text:
    if provider == "codex":
        if codex_path != "":
            return codex_path
        return "codex"
    if provider == "opencode_cli":
        if opencode_path != "":
            return opencode_path
        return "opencode"
    if provider == "gemini" or provider == "gemini_cli":
        if gemini_path != "":
            return gemini_path
        return "gemini"
    if provider == "kimi" or provider == "kimi_cli":
        if kimi_path != "":
            return kimi_path
        return "kimi"
    if claude_path != "":
        return claude_path
    "claude"

pub fn launch_agent_plan(agent_id: text, plan: AgentLaunchPlan, claude_path: text, codex_path: text, opencode_path: text) -> AgentProcess:
    launch_agent_plan_with_gemini(agent_id, plan, claude_path, codex_path, "", opencode_path)

pub fn launch_agent_plan_with_gemini(agent_id: text, plan: AgentLaunchPlan,
        claude_path: text, codex_path: text, gemini_path: text,
        opencode_path: text) -> AgentProcess:
    launch_agent_plan_with_all(agent_id, plan, claude_path, codex_path,
        gemini_path, "", opencode_path)

pub fn launch_agent_plan_with_all(agent_id: text, plan: AgentLaunchPlan,
        claude_path: text, codex_path: text, gemini_path: text, kimi_path: text,
        opencode_path: text) -> AgentProcess:
    if plan.provider == "team":
        return AgentProcess(agent_id: agent_id, status: "not_started", reason: "team_plan_not_executable", pid: -1)
    if not is_known_agent_provider(plan.provider):
        return AgentProcess(agent_id: agent_id, status: "error",
            reason: "unknown_provider:" + plan.provider, pid: -1)
    val cmd = agent_command_for_provider_with_all(plan.provider, claude_path,
        codex_path, gemini_path, kimi_path, opencode_path)
    val pid = process_spawn_async(cmd, plan.argv)
    if pid <= 0:
        return AgentProcess(agent_id: agent_id, status: "error", reason: "spawn_failed", pid: pid)
    AgentProcess(agent_id: agent_id, status: "started", reason: "process_spawned", pid: pid)

pub fn launch_messaging_agent_plan(agent_id: text, plan: AgentLaunchPlan,
        claude_path: text, codex_path: text, gemini_path: text, opencode_path: text,
        context: MessagingAgentLaunchContext) -> AgentProcess:
    launch_messaging_agent_plan_with_all(agent_id, plan, claude_path,
        codex_path, gemini_path, "", opencode_path, context)

pub fn launch_messaging_agent_plan_with_all(agent_id: text, plan: AgentLaunchPlan,
        claude_path: text, codex_path: text, gemini_path: text, kimi_path: text,
        opencode_path: text, context: MessagingAgentLaunchContext) -> AgentProcess:
    if plan.provider == "team":
        return AgentProcess(agent_id: agent_id, status: "not_started",
            reason: "team_plan_not_executable", pid: -1)
    if context.task_id == "" or context.room_id == "" or context.agent_id == "":
        return AgentProcess(agent_id: agent_id, status: "not_started",
            reason: "messaging_context_required", pid: -1)
    if not is_known_agent_provider(plan.provider):
        return AgentProcess(agent_id: agent_id, status: "error",
            reason: "unknown_provider:" + plan.provider, pid: -1)
    val cmd = agent_command_for_provider_with_all(plan.provider, claude_path,
        codex_path, gemini_path, kimi_path, opencode_path)
    val pid = process_spawn_async_env(cmd, plan.argv, messaging_agent_environment(context))
    if pid <= 0:
        return AgentProcess(agent_id: agent_id, status: "error", reason: "spawn_failed", pid: pid)
    AgentProcess(agent_id: agent_id, status: "started",
        reason: "messaging_process_spawned", pid: pid)

pub fn summarize_agent_team(team_id: text, processes: [AgentProcess]) -> AgentTeamProcess:
    var started = 0
    for proc in processes:
        if proc.status == "started" or proc.status == "running":
            started = started + 1
    var status = "error"
    if processes.len() == 0:
        status = "empty"
    elif started == processes.len():
        status = "started"
    elif started > 0:
        status = "partial"
    AgentTeamProcess(team_id: team_id, status: status, reason: "started:" + started.to_text() + "/" + processes.len().to_text(), processes: processes)

pub fn launch_agent_team(team_id: text, requests: [AgentLaunchRequest], claude_path: text, codex_path: text, opencode_path: text) -> AgentTeamProcess:
    launch_agent_team_with_gemini(team_id, requests, claude_path, codex_path, "", opencode_path)

pub fn launch_agent_team_with_gemini(team_id: text, requests: [AgentLaunchRequest],
        claude_path: text, codex_path: text, gemini_path: text,
        opencode_path: text) -> AgentTeamProcess:
    launch_agent_team_with_all(team_id, requests, claude_path, codex_path,
        gemini_path, "", opencode_path)

pub fn launch_agent_team_with_all(team_id: text, requests: [AgentLaunchRequest],
        claude_path: text, codex_path: text, gemini_path: text, kimi_path: text,
        opencode_path: text) -> AgentTeamProcess:
    var processes: [AgentProcess] = []
    var seen_ids: [text] = []
    var idx = 0
    for req in requests:
        val plan = build_agent_launch_plan(req)
        # Duplicate agent_md_paths would collide in mailbox/usage lookups —
        # suffix repeats with their launch index to keep agent ids unique.
        var aid = req.agent_md_path
        for existing in seen_ids:
            if existing == req.agent_md_path:
                aid = req.agent_md_path + "#" + idx.to_text()
        seen_ids = seen_ids + [req.agent_md_path]
        processes = processes + [launch_agent_plan_with_all(aid,
            plan, claude_path, codex_path, gemini_path, kimi_path, opencode_path)]
        idx = idx + 1
    summarize_agent_team(team_id, processes)

pub fn agent_team_status(team: AgentTeamProcess) -> AgentTeamProcess:
    var processes: [AgentProcess] = []
    for proc in team.processes:
        processes = processes + [agent_process_status(proc)]
    summarize_agent_team(team.team_id, processes)

pub fn stop_agent_team(team: AgentTeamProcess) -> AgentTeamProcess:
    var processes: [AgentProcess] = []
    for proc in team.processes:
        processes = processes + [stop_agent_process(proc)]
    summarize_agent_team(team.team_id, processes)

pub fn agent_process_status(proc: AgentProcess) -> AgentProcess:
    if proc.pid <= 0:
        return AgentProcess(agent_id: proc.agent_id, status: "not_running", reason: "invalid_pid", pid: proc.pid)
    if process_is_running(proc.pid):
        return AgentProcess(agent_id: proc.agent_id, status: "running", reason: "process_running", pid: proc.pid)
    AgentProcess(agent_id: proc.agent_id, status: "not_running", reason: "process_exited", pid: proc.pid)

pub fn stop_agent_process(proc: AgentProcess) -> AgentProcess:
    if proc.pid <= 0:
        return AgentProcess(agent_id: proc.agent_id, status: "not_stopped", reason: "invalid_pid", pid: proc.pid)
    if process_kill(proc.pid):
        return AgentProcess(agent_id: proc.agent_id, status: "stopped", reason: "process_killed", pid: proc.pid)
    AgentProcess(agent_id: proc.agent_id, status: "error", reason: "process_kill_failed", pid: proc.pid)

export AgentProcess, AgentTeamProcess, MessagingAgentLaunchContext
export is_known_agent_provider
export agent_command_for_provider, launch_agent_plan, launch_agent_team, summarize_agent_team, agent_team_status, stop_agent_team, agent_process_status, stop_agent_process
export agent_command_for_provider_with_gemini, launch_agent_plan_with_gemini,
    launch_agent_team_with_gemini
export agent_command_for_provider_with_all, launch_agent_plan_with_all,
    launch_agent_team_with_all
export messaging_agent_environment, launch_messaging_agent_plan,
    launch_messaging_agent_plan_with_all
