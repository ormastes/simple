# LLM Caret - Infrastructure: mail tools (IMAP list/read, SMTP send)
#
# Server-facing code for the `mail_list`, `mail_read` and `mail_send` tools.
# Only reachable through tools.spl::run_tool (the permission gate).
#
# Facades reused (never raw rt_* externs):
#   std.nogc_sync_mut.imap        - IMAP command builders / RFC 3501 FETCH parser
#   std.nogc_sync_mut.smtp.*      - SMTP command builders, AUTH PLAIN, message
#   std.nogc_sync_mut.io.tcp      - plaintext transport (fd helpers)
#   std.nogc_sync_mut.io.tls_sffi - implicit-TLS transport (IMAPS 993 / SMTPS 465)
#   app.llm_caret.infra_mail_starttls - STARTTLS negotiation (transport-free)
#
# Config comes from the `[mail]` section of llm_caret.sdn (config.spl):
#   imap_host, imap_port, smtp_host, smtp_port, user, secret_env
# The secret is ONLY read from the env var named by secret_env.
#
# Transport selection is by port: 993 (imaps_default_port) and 465
# (smtps_default_port) use implicit TLS; any other port is plaintext. SMTP
# submission on 587 needs a STARTTLS upgrade of the live socket, which the
# runtime cannot do (no rt_tls_client_from_fd), so it is refused before any
# connect with an error naming the missing runtime symbol.
#
# Every server read is bounded: a reply that does not complete within
# mail_read_timeout_ms() fails the tool call with
# "mail server timed out after N ms" instead of hanging the caret.
#
# Exec order in every tool: validate arguments -> config present -> secret
# present -> connect. Nothing touches the network before the last step.

use app.llm_caret.config.{
    config_mail_imap_host, config_mail_imap_port,
    config_mail_smtp_host, config_mail_smtp_port,
    config_mail_user, config_mail_secret_env, config_mail_secret
}
use app.llm_caret.infra_mail_starttls.{starttls_runtime_gap_error}
use std.nogc_sync_mut.imap.{
    ImapTag, imap_tag_to_text,
    imap_build_login, imap_build_select, imap_build_fetch, imap_build_uid_fetch, imap_build_logout,
    imap_response_complete, imap_parse_fetch_response, imap_status_is_ok,
    imap_fetch_uid, imap_fetch_item_prefixed, imap_parse_header_fields, imap_header_value
}
use std.nogc_sync_mut.imap.secure.{imaps_default_port}
use std.nogc_sync_mut.smtp.secure.{smtps_default_port, smtp_starttls_port}
use std.nogc_sync_mut.smtp.connect.{
    smtp_command_ehlo, smtp_command_mail_from, smtp_command_rcpt_to,
    smtp_command_data, smtp_command_quit, smtp_command_auth_plain
}
use std.nogc_sync_mut.smtp.auth.{auth_plain_encode}
use std.nogc_sync_mut.smtp.send.{header_from, header_to, header_subject, header_content_type, smtp_dot_stuff}
use std.nogc_sync_mut.io.tcp.{
    TcpStream, tcp_fd_write_text, tcp_fd_read_line_or_empty, tcp_fd_close,
    tcp_fd_set_read_timeout
}
use std.nogc_sync_mut.io.tls_sffi.{TlsClientConnection, tls_connect, tls_write, tls_read_timeout, tls_close}
use std.io_runtime.{time_now_monotonic_ms}

val MAIL_NOT_CONFIGURED = "mail not configured: set [mail] in llm_caret.sdn"
val MAIL_CONNECT_TIMEOUT_MS = 15000
val MAIL_DEFAULT_READ_TIMEOUT_MS = 15000
val MAIL_MAX_LIST = 200
val MAIL_MAX_BODY = 60000

# Per-reply read budget. Specs lower it (a stalled fixture server must fail
# fast); production keeps the default.
var _mail_read_timeout_ms: i64 = 15000

fn mail_read_timeout_ms() -> i64:
    if _mail_read_timeout_ms <= 0:
        return MAIL_DEFAULT_READ_TIMEOUT_MS
    _mail_read_timeout_ms

fn mail_set_read_timeout_ms(ms: i64):
    _mail_read_timeout_ms = ms

# ============================================================================
# JSON schema entries (Anthropic `input_schema` shape)
# ============================================================================

fn _LB() -> text:
    (123 as char).to_text()

fn _RB() -> text:
    (125 as char).to_text()

fn _prop(name: text, kind: text, desc: text) -> text:
    "\"" + name + "\": " + _LB() + "\"type\": \"" + kind + "\", \"description\": \"" + desc + "\"" + _RB()

fn _schema(name: text, desc: text, props: [text], required: [text]) -> text:
    var req: [text] = []
    for r in required:
        req.push("\"" + r + "\"")
    _LB() + "\"name\": \"" + name + "\", \"description\": \"" + desc + "\", \"input_schema\": " +
        _LB() + "\"type\": \"object\", \"properties\": " + _LB() + props.join(", ") + _RB() +
        ", \"required\": [" + req.join(", ") + "]" + _RB() + _RB()

fn mail_tool_schemas() -> [text]:
    [
        _schema("mail_list", "List recent messages in a mailbox (read-only). One line per message: uid, date, from, subject.",
            [_prop("mailbox", "string", "IMAP mailbox name (default INBOX)"),
             _prop("limit", "integer", "Maximum messages to list (default 20, max 200)")],
            []),
        _schema("mail_read", "Read one message by IMAP UID (read-only): headers and body text.",
            [_prop("uid", "string", "IMAP UID as returned by mail_list")],
            ["uid"]),
        _schema("mail_send", "Send a plain-text email over SMTP. MUTATING: requires explicit permission.",
            [_prop("to", "string", "Recipient address"),
             _prop("subject", "string", "Subject line"),
             _prop("body", "string", "Plain-text body")],
            ["to", "subject", "body"])
    ]

# ============================================================================
# Config resolution (pure; no network)
# ============================================================================

fn mail_configured() -> bool:
    config_mail_imap_host() != "" or config_mail_smtp_host() != ""

# Returns "" when the secret is usable, else an honest error naming the env var
# (never the value).
fn mail_secret_error() -> text:
    val env_name = config_mail_secret_env()
    if env_name == "":
        return "mail secret not configured: set [mail] secret_env in llm_caret.sdn"
    if config_mail_secret() == "":
        return "mail secret not set: environment variable '" + env_name + "' is empty"
    ""

fn _uses_implicit_tls(port: i64) -> bool:
    port == imaps_default_port() or port == smtps_default_port()

# ============================================================================
# Transport (plaintext fd or implicit TLS) with bounded reads
# ============================================================================

struct MailLink:
    secure: bool
    fd: i64
    tls: TlsClientConnection
    ok: bool
    error: text

# One complete server reply. `raw` keeps the exact wire bytes (IMAP literals
# intact) for the RFC 3501 parser; `lines` are CRLF-stripped for SMTP and
# status checks. `error` is "" unless the read timed out or the peer closed.
struct MailReply:
    lines: [text]
    raw: text
    error: text

fn _link_error(msg: text) -> MailLink:
    MailLink(secure: false, fd: -1, tls: TlsClientConnection(handle: -1, host: "", port: 0, is_valid: false), ok: false, error: msg)

fn _connect(host: text, port: i64) -> MailLink:
    if _uses_implicit_tls(port):
        match tls_connect(host, port):
            Err(e): return _link_error(e)
            Ok(conn): return MailLink(secure: true, fd: -1, tls: conn, ok: true, error: "")
    val fd = TcpStream.connect_fd_timeout(host + ":" + port.to_text(), MAIL_CONNECT_TIMEOUT_MS)
    if fd < 0:
        return _link_error("tcp connect to " + host + ":" + port.to_text() + " failed")
    tcp_fd_set_read_timeout(fd, mail_read_timeout_ms())
    MailLink(secure: false, fd: fd, tls: TlsClientConnection(handle: -1, host: "", port: 0, is_valid: false), ok: true, error: "")

fn _send(link: MailLink, data: text) -> bool:
    if link.secure:
        match tls_write(link.tls, data):
            Ok(written): return written > 0
            Err(_): return false
    tcp_fd_write_text(link.fd, data)

fn _close(link: MailLink):
    if link.secure:
        val _ = tls_close(link.tls)
    else:
        tcp_fd_close(link.fd)

fn _strip_crlf(line: text) -> text:
    var s = line
    while s.ends_with("\n") or s.ends_with("\r"):
        s = s.substring(0, s.length() - 1)
    s

fn _timeout_error() -> text:
    "mail server timed out after " + mail_read_timeout_ms().to_text() + " ms"

# One bounded read: at most `budget_ms` of waiting. "" means timeout or EOF;
# the caller tells them apart by the clock.
fn _read_chunk(link: MailLink, budget_ms: i64) -> text:
    if link.secure:
        return tls_read_timeout(link.tls, 65536, budget_ms)
    tcp_fd_set_read_timeout(link.fd, budget_ms)
    tcp_fd_read_line_or_empty(link.fd)

# SMTP reply is complete when the last full line is "NNN text" (space after
# the code) or a bare 3-digit code.
fn _smtp_reply_complete(buf: text) -> bool:
    val n = buf.length()
    if n == 0 or buf.substring(n - 1, n) != "\n":
        return false
    val lines = buf.split("\n")
    var i = lines.len() - 2
    while i >= 0:
        val line = _strip_crlf(lines[i])
        if line != "":
            return (line.length() >= 4 and line.substring(3, 4) == " ") or line.length() == 3
        i = i - 1
    false

fn _lines_of(buf: text) -> [text]:
    var out: [text] = []
    for l in buf.split("\n"):
        val s = _strip_crlf(l)
        if s != "" or out.len() > 0:
            out.push(s)
    # drop the trailing empty element produced by the final CRLF
    if out.len() > 0 and out[out.len() - 1] == "":
        var trimmed: [text] = []
        var i = 0
        while i < out.len() - 1:
            trimmed.push(out[i])
            i = i + 1
        return trimmed
    out

# Reads one complete reply or fails with a timeout/closed error. IMAP framing
# is literal-aware (a `{N}` body can never fake the tagged line); `tag` "*"
# accepts the greeting.
fn _read_reply(link: MailLink, tag: text, smtp: bool) -> MailReply:
    val budget = mail_read_timeout_ms()
    val deadline = time_now_monotonic_ms() + budget
    var chunks: [text] = []
    var buf = ""
    var guard = 0
    while guard < 1000000:
        guard = guard + 1
        if smtp:
            if _smtp_reply_complete(buf):
                return MailReply(lines: _lines_of(buf), raw: buf, error: "")
        else:
            val done = imap_response_complete(buf, tag)
            if done >= 0:
                return MailReply(lines: _lines_of(buf), raw: buf.substring(0, done), error: "")
        val remaining = deadline - time_now_monotonic_ms()
        if remaining <= 0:
            return MailReply(lines: _lines_of(buf), raw: buf, error: _timeout_error())
        val chunk = _read_chunk(link, remaining)
        if chunk == "":
            if time_now_monotonic_ms() >= deadline:
                return MailReply(lines: _lines_of(buf), raw: buf, error: _timeout_error())
            return MailReply(lines: _lines_of(buf), raw: buf, error: "mail server closed the connection before replying")
        chunks.push(chunk)
        buf = chunks.join("")
    MailReply(lines: _lines_of(buf), raw: buf, error: "mail reply exceeded the read guard")

fn _last(lines: [text]) -> text:
    if lines.len() == 0:
        return ""
    lines[lines.len() - 1]

# ============================================================================
# IMAP
# ============================================================================

# std.imap's ImapSession tag counter never advances (imap_next_tag returns
# the same seq), so the session keeps its own monotonic tag here.
fn _imap_tag(seq: i64) -> ImapTag:
    ImapTag(seq: seq)

fn _imap_ok(reply: MailReply, tag: text) -> bool:
    _last(reply.lines).starts_with(tag + " OK")

# Sends `wire` (already tagged) and reads until its tagged reply.
fn _imap_command(link: MailLink, wire: text) -> (MailReply, text):
    val tag = wire.split(" ")[0]
    if not _send(link, wire):
        return (MailReply(lines: [], raw: "", error: "imap send failed while writing '" + tag + "'"), tag)
    (_read_reply(link, tag, false), tag)

# Returns "" on success, else the error to surface (timeouts propagate as-is).
fn _imap_login(link: MailLink, tag: ImapTag) -> text:
    val greeting = _read_reply(link, "*", false)
    if greeting.error != "":
        return greeting.error
    val (reply, t) = _imap_command(link, imap_build_login(tag, config_mail_user(), config_mail_secret()))
    if reply.error != "":
        return reply.error
    if not _imap_ok(reply, t):
        return "imap login failed for user '" + config_mail_user() + "'"
    ""

fn _imap_select(link: MailLink, tag: ImapTag, mailbox: text) -> (text, i64):
    val (reply, t) = _imap_command(link, imap_build_select(tag, mailbox))
    if reply.error != "":
        return (reply.error, 0)
    if not _imap_ok(reply, t):
        return ("imap select '" + mailbox + "' failed", 0)
    var exists = 0
    for l in reply.lines:
        if l.starts_with("* ") and l.ends_with(" EXISTS"):
            val parts = l.split(" ")
            if parts.len() >= 3:
                exists = parts[1].to_i64() ?? 0
    ("", exists)

# Turns FETCH (UID BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE)]) messages into
# "uid=<n> | <date> | <from> | <subject>" rows, newest first.
fn _format_list(raw: text, tag: text) -> (bool, text):
    val parsed = imap_parse_fetch_response(raw, tag)
    if parsed.error != "":
        return (false, "imap fetch parse error: " + parsed.error)
    if not imap_status_is_ok(parsed.tag_status):
        return (false, "imap fetch failed: " + parsed.tag_message)
    var rows: [text] = []
    for m in parsed.messages:
        val uid = imap_fetch_uid(m)
        if uid == "":
            continue
        val fields = imap_parse_header_fields(imap_fetch_item_prefixed(m, "BODY[HEADER"))
        rows.push("uid=" + uid + " | " + imap_header_value(fields, "Date") + " | " +
            imap_header_value(fields, "From") + " | " + imap_header_value(fields, "Subject"))
    var rev: [text] = []
    var i = rows.len() - 1
    while i >= 0:
        rev.push(rows[i])
        i = i - 1
    (true, rev.join("\n"))

# Extracts the BODY[] literal of a UID FETCH reply.
fn _format_message(raw: text, tag: text, uid: text) -> (bool, text):
    val parsed = imap_parse_fetch_response(raw, tag)
    if parsed.error != "":
        return (false, "imap uid fetch parse error: " + parsed.error)
    if not imap_status_is_ok(parsed.tag_status):
        return (false, "imap uid fetch failed: " + parsed.tag_message)
    if parsed.messages.len() == 0:
        return (false, "mail_read: no message with uid " + uid)
    var body = imap_fetch_item_prefixed(parsed.messages[0], "BODY[")
    if body.length() > MAIL_MAX_BODY:
        body = body.substring(0, MAIL_MAX_BODY) + "\n... [truncated at " + MAIL_MAX_BODY.to_text() + " bytes]"
    (true, body)

fn _imap_session_run(mailbox: text, on_selected_uid: text, limit: i64) -> (bool, text):
    val link = _connect(config_mail_imap_host(), config_mail_imap_port())
    if not link.ok:
        return (false, link.error)
    val login_err = _imap_login(link, _imap_tag(1))
    if login_err != "":
        _close(link)
        return (false, login_err)
    val (sel_err, exists) = _imap_select(link, _imap_tag(2), mailbox)
    if sel_err != "":
        _close(link)
        return (false, sel_err)
    var result = ""
    var ok = true
    if on_selected_uid == "":
        if exists == 0:
            result = "(mailbox '" + mailbox + "' is empty)"
        else:
            var lo = exists - limit + 1
            if lo < 1:
                lo = 1
            val wire = imap_build_fetch(_imap_tag(3), lo.to_text() + ":" + exists.to_text(), "(UID BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE)])")
            val (reply, t) = _imap_command(link, wire)
            if reply.error != "":
                ok = false
                result = reply.error
            else:
                val (fok, formatted) = _format_list(reply.raw, t)
                ok = fok
                result = formatted
    else:
        val wire = imap_build_uid_fetch(_imap_tag(3), on_selected_uid, "(BODY.PEEK[])")
        val (reply, t) = _imap_command(link, wire)
        if reply.error != "":
            ok = false
            result = reply.error
        else:
            val (fok, formatted) = _format_message(reply.raw, t, on_selected_uid)
            ok = fok
            result = formatted
    _imap_command(link, imap_build_logout(_imap_tag(4)))
    _close(link)
    (ok, result)

# ============================================================================
# Public tool operations: (success, content)
# ============================================================================

fn mail_list(mailbox_in: text, limit_in: i64) -> (bool, text):
    var mailbox = mailbox_in
    if mailbox == "":
        mailbox = "INBOX"
    var limit = limit_in
    if limit < 1:
        limit = 20
    if limit > MAIL_MAX_LIST:
        limit = MAIL_MAX_LIST
    if config_mail_imap_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val serr = mail_secret_error()
    if serr != "":
        return (false, serr)
    _imap_session_run(mailbox, "", limit)

fn mail_read(uid: text) -> (bool, text):
    if uid == "":
        return (false, "mail_read: missing required 'uid'")
    var i = 0
    while i < uid.len():
        if uid[i] < "0" or uid[i] > "9":
            return (false, "mail_read: 'uid' must be a decimal IMAP UID, got '" + uid + "'")
        i = i + 1
    if config_mail_imap_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val serr = mail_secret_error()
    if serr != "":
        return (false, serr)
    _imap_session_run("INBOX", uid, 0)

fn _smtp_code(lines: [text]) -> i64:
    val last = _last(lines)
    if last.length() < 3:
        return 0
    last.substring(0, 3).to_i64() ?? 0

fn _smtp_step(link: MailLink, wire: text, want: i64) -> text:
    if not _send(link, wire):
        return "smtp send failed while writing '" + wire.trim() + "'"
    val reply = _read_reply(link, "", true)
    if reply.error != "":
        return reply.error
    val code = _smtp_code(reply.lines)
    if code != want:
        return "smtp expected " + want.to_text() + " after '" + wire.trim().split(" ")[0] + "', got: " + _last(reply.lines)
    ""

fn mail_send(to: text, subject: text, body: text) -> (bool, text):
    if to == "":
        return (false, "mail_send: missing required 'to'")
    if not to.contains("@"):
        return (false, "mail_send: 'to' is not an email address: " + to)
    if subject == "":
        return (false, "mail_send: missing required 'subject'")
    if config_mail_smtp_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val port = config_mail_smtp_port()
    if port == smtp_starttls_port():
        return (false, "mail_send: smtp_port 587 needs STARTTLS: " + starttls_runtime_gap_error(port))
    val user = config_mail_user()
    if user != "":
        val serr = mail_secret_error()
        if serr != "":
            return (false, serr)
    val link = _connect(config_mail_smtp_host(), port)
    if not link.ok:
        return (false, link.error)
    val greet = _read_reply(link, "", true)
    if greet.error != "":
        _close(link)
        return (false, greet.error)
    if _smtp_code(greet.lines) != 220:
        _close(link)
        return (false, "smtp greeting was not 220: " + _last(greet.lines))
    var err = _smtp_step(link, smtp_command_ehlo("localhost"), 250)
    if err == "" and user != "":
        err = _smtp_step(link, smtp_command_auth_plain().trim() + " " + auth_plain_encode(user, config_mail_secret()) + "\r\n", 235)
    var sender = user
    if sender == "":
        sender = "llm-caret@localhost"
    if err == "":
        err = _smtp_step(link, smtp_command_mail_from(sender), 250)
    if err == "":
        err = _smtp_step(link, smtp_command_rcpt_to(to), 250)
    if err == "":
        err = _smtp_step(link, smtp_command_data(), 354)
    if err == "":
        val msg = mail_build_message(sender, to, subject, body)
        err = _smtp_step(link, msg, 250)
    if err == "":
        _send(link, smtp_command_quit())
    _close(link)
    if err != "":
        return (false, err)
    (true, "sent to " + to + " via " + config_mail_smtp_host() + ":" + port.to_text())

# RFC 5322 headers + blank line + dot-stuffed body. smtp_dot_stuff already
# appends the single DATA terminator <CRLF>.<CRLF>; nothing may follow it.
#
# Why not std.nogc_sync_mut.smtp.send.message_build_simple: it calls
# mime_type_text_plain() through a bodyless "forward declaration" in send.spl
# (`fn mime_type_text_plain() -> text`, no body) that shadows the real one in
# smtp/mime.spl (importing ANY name from send.spl brings the bodyless decl
# into scope, so even smtp.mime.mime_type_text_plain resolves to it — isolated
# with a 2-spec scratch fixture: header_from + mime import fails, mime-only
# import passes; same block in nogc_async_mut/ and gc_async_mut/ send.spl), so the
# first live SMTP send aborted with "semantic: missing
# return in non-unit function 'mime_type_text_plain'" (measured 2026-08-25
# against greenmail/standalone). It also terminated the DATA section twice
# (message_build_simple + message_terminate), sending a stray "." command.
fn mail_build_message(sender: text, to: text, subject: text, body: text) -> text:
    header_from(sender) + header_to(to) + header_subject(subject) +
        header_content_type("text/plain; charset=utf-8") + "\r\n" + smtp_dot_stuff(body)
