# LLM Caret - Infrastructure: mail tools (IMAP list/read, SMTP send)
#
# Server-facing code for the `mail_list`, `mail_read` and `mail_send` tools.
# Only reachable through tools.spl::run_tool (the permission gate).
#
# Facades reused (never raw rt_* externs):
#   std.nogc_sync_mut.imap        - IMAP command builders / tags
#   std.nogc_sync_mut.smtp.*      - SMTP command builders, AUTH PLAIN, message
#   std.nogc_sync_mut.io.tcp      - plaintext transport (fd helpers)
#   std.nogc_sync_mut.io.tls_sffi - implicit-TLS transport (IMAPS 993 / SMTPS 465)
#
# Config comes from the `[mail]` section of llm_caret.sdn (config.spl):
#   imap_host, imap_port, smtp_host, smtp_port, user, secret_env
# The secret is ONLY read from the env var named by secret_env.
#
# Transport selection is by port: 993 (imaps_default_port) and 465
# (smtps_default_port) use implicit TLS; any other port is plaintext. SMTP
# submission on 587 needs a STARTTLS upgrade which the TLS facade cannot do on
# an existing socket, so it is refused with an honest error.
#
# Exec order in every tool: validate arguments -> config present -> secret
# present -> connect. Nothing touches the network before the last step.

use app.llm_caret.config.{
    config_mail_imap_host, config_mail_imap_port,
    config_mail_smtp_host, config_mail_smtp_port,
    config_mail_user, config_mail_secret_env, config_mail_secret
}
use std.nogc_sync_mut.imap.{
    imap_session_new, imap_next_tag, imap_tag_to_text,
    imap_build_login, imap_build_select, imap_build_fetch, imap_build_logout
}
use std.nogc_sync_mut.imap.secure.{imaps_default_port}
use std.nogc_sync_mut.smtp.secure.{smtps_default_port, smtp_starttls_port}
use std.nogc_sync_mut.smtp.connect.{
    smtp_command_ehlo, smtp_command_mail_from, smtp_command_rcpt_to,
    smtp_command_data, smtp_command_quit, smtp_command_auth_plain
}
use std.nogc_sync_mut.smtp.auth.{auth_plain_encode}
use std.nogc_sync_mut.smtp.send.{header_from, header_to, header_subject, header_content_type, smtp_dot_stuff}
use std.nogc_sync_mut.io.tcp.{
    TcpStream, tcp_fd_write_text, tcp_fd_read_line_or_empty, tcp_fd_close,
    tcp_fd_set_read_timeout
}
use std.nogc_sync_mut.io.tls_sffi.{TlsClientConnection, tls_connect, tls_write, tls_read, tls_close}

val MAIL_NOT_CONFIGURED = "mail not configured: set [mail] in llm_caret.sdn"
val MAIL_CONNECT_TIMEOUT_MS = 15000
val MAIL_MAX_LIST = 200
val MAIL_MAX_BODY = 60000

# ============================================================================
# JSON schema entries (Anthropic `input_schema` shape)
# ============================================================================

fn _LB() -> text:
    (123 as char).to_text()

fn _RB() -> text:
    (125 as char).to_text()

fn _prop(name: text, kind: text, desc: text) -> text:
    "\"" + name + "\": " + _LB() + "\"type\": \"" + kind + "\", \"description\": \"" + desc + "\"" + _RB()

fn _schema(name: text, desc: text, props: [text], required: [text]) -> text:
    var req: [text] = []
    for r in required:
        req.push("\"" + r + "\"")
    _LB() + "\"name\": \"" + name + "\", \"description\": \"" + desc + "\", \"input_schema\": " +
        _LB() + "\"type\": \"object\", \"properties\": " + _LB() + props.join(", ") + _RB() +
        ", \"required\": [" + req.join(", ") + "]" + _RB() + _RB()

fn mail_tool_schemas() -> [text]:
    [
        _schema("mail_list", "List recent messages in a mailbox (read-only). One line per message: uid, date, from, subject.",
            [_prop("mailbox", "string", "IMAP mailbox name (default INBOX)"),
             _prop("limit", "integer", "Maximum messages to list (default 20, max 200)")],
            []),
        _schema("mail_read", "Read one message by IMAP UID (read-only): headers and body text.",
            [_prop("uid", "string", "IMAP UID as returned by mail_list")],
            ["uid"]),
        _schema("mail_send", "Send a plain-text email over SMTP. MUTATING: requires explicit permission.",
            [_prop("to", "string", "Recipient address"),
             _prop("subject", "string", "Subject line"),
             _prop("body", "string", "Plain-text body")],
            ["to", "subject", "body"])
    ]

# ============================================================================
# Config resolution (pure; no network)
# ============================================================================

fn mail_configured() -> bool:
    config_mail_imap_host() != "" or config_mail_smtp_host() != ""

# Returns "" when the secret is usable, else an honest error naming the env var
# (never the value).
fn mail_secret_error() -> text:
    val env_name = config_mail_secret_env()
    if env_name == "":
        return "mail secret not configured: set [mail] secret_env in llm_caret.sdn"
    if config_mail_secret() == "":
        return "mail secret not set: environment variable '" + env_name + "' is empty"
    ""

fn _uses_implicit_tls(port: i64) -> bool:
    port == imaps_default_port() or port == smtps_default_port()

# ============================================================================
# Transport (plaintext fd or implicit TLS)
# ============================================================================

struct MailLink:
    secure: bool
    fd: i64
    tls: TlsClientConnection
    ok: bool
    error: text

fn _link_error(msg: text) -> MailLink:
    MailLink(secure: false, fd: -1, tls: TlsClientConnection(handle: -1, host: "", port: 0, is_valid: false), ok: false, error: msg)

fn _connect(host: text, port: i64) -> MailLink:
    if _uses_implicit_tls(port):
        val conn = tls_connect(host, port)
        if not conn.is_valid:
            return _link_error("tls connect to " + host + ":" + port.to_text() + " failed")
        return MailLink(secure: true, fd: -1, tls: conn, ok: true, error: "")
    val fd = TcpStream.connect_fd_timeout(host + ":" + port.to_text(), MAIL_CONNECT_TIMEOUT_MS)
    if fd < 0:
        return _link_error("tcp connect to " + host + ":" + port.to_text() + " failed")
    tcp_fd_set_read_timeout(fd, MAIL_CONNECT_TIMEOUT_MS)
    MailLink(secure: false, fd: fd, tls: TlsClientConnection(handle: -1, host: "", port: 0, is_valid: false), ok: true, error: "")

fn _send(link: MailLink, data: text) -> bool:
    if link.secure:
        match tls_write(link.tls, data):
            Ok(written): return written > 0
            Err(_): return false
    tcp_fd_write_text(link.fd, data)

fn _close(link: MailLink):
    if link.secure:
        val _ = tls_close(link.tls)
    else:
        tcp_fd_close(link.fd)

fn _strip_crlf(line: text) -> text:
    var s = line
    while s.ends_with("\n") or s.ends_with("\r"):
        s = s.substring(0, s.len() - 1)
    s

# Reads server lines until `done(line)` would be true for the last line.
# IMAP: the line starting with our tag. SMTP: a line whose 4th char is a space.
fn _read_until_tag(link: MailLink, tag: text) -> [text]:
    _read_lines(link, tag, false)

fn _read_smtp_reply(link: MailLink) -> [text]:
    _read_lines(link, "", true)

fn _is_final_line(line: text, tag: text, smtp: bool) -> bool:
    if smtp:
        return (line.len() >= 4 and line.substring(3, 4) == " ") or line.len() == 3
    line.starts_with(tag + " ")

fn _read_lines(link: MailLink, tag: text, smtp: bool) -> [text]:
    var out: [text] = []
    if link.secure:
        var chunks: [text] = []
        var buf = ""
        var guard = 0
        while guard < 100000:
            guard = guard + 1
            val chunk = tls_read(link.tls, 65536)
            if chunk == "":
                break
            chunks.push(chunk)
            if not chunk.contains("\n"):
                continue
            buf = chunks.join("")
            val lines = buf.split("\n")
            # last element may be a partial line; check completed lines only
            var i = 0
            var finished = false
            while i < lines.len() - 1:
                if _is_final_line(_strip_crlf(lines[i]), tag, smtp):
                    finished = true
                i = i + 1
            if finished:
                break
        buf = chunks.join("")
        for l in buf.split("\n"):
            val s = _strip_crlf(l)
            if s != "" or out.len() > 0:
                out.push(s)
        return out
    var guard2 = 0
    while guard2 < 100000:
        guard2 = guard2 + 1
        val raw = tcp_fd_read_line_or_empty(link.fd)
        if raw == "":
            break
        val line = _strip_crlf(raw)
        out.push(line)
        if _is_final_line(line, tag, smtp):
            break
    out

fn _last(lines: [text]) -> text:
    if lines.len() == 0:
        return ""
    lines[lines.len() - 1]

# ============================================================================
# IMAP
# ============================================================================

fn _imap_ok(lines: [text], tag: text) -> bool:
    val last = _last(lines)
    last.starts_with(tag + " OK")

fn _imap_command(link: MailLink, session, wire: text) -> ([text], text, bool):
    # `wire` already carries the tag; recover it to detect the tagged reply.
    val tag = wire.split(" ")[0]
    if not _send(link, wire):
        return ([], tag, false)
    val lines = _read_until_tag(link, tag)
    (lines, tag, _imap_ok(lines, tag))

fn _imap_login(link: MailLink, session) -> text:
    # Greeting first (untagged "* OK ...").
    _read_until_tag(link, "*")
    val tag = imap_next_tag(session)
    val (_lines, _t, ok) = _imap_command(link, session, imap_build_login(tag, config_mail_user(), config_mail_secret()))
    if not ok:
        return "imap login failed for user '" + config_mail_user() + "'"
    ""

fn _imap_select(link: MailLink, session, mailbox: text) -> (bool, i64):
    val tag = imap_next_tag(session)
    val (lines, _t, ok) = _imap_command(link, session, imap_build_select(tag, mailbox))
    if not ok:
        return (false, 0)
    var exists = 0
    for l in lines:
        if l.starts_with("* ") and l.ends_with(" EXISTS"):
            val parts = l.split(" ")
            if parts.len() >= 3:
                exists = parts[1].to_i64() ?? 0
    (true, exists)

fn _header_value(line: text, name: text) -> text:
    val lower = line.to_lower()
    if lower.starts_with(name.to_lower() + ":"):
        return line.substring(name.len() + 1).trim()
    ""

fn _uid_from_fetch_line(line: text) -> text:
    val marker = "UID "
    val parts = line.split(marker)
    if parts.len() < 2:
        return ""
    val rest = parts[1]
    var uid = ""
    var i = 0
    while i < rest.len():
        val ch = rest[i]
        if ch >= "0" and ch <= "9":
            uid = uid + ch
        else:
            break
        i = i + 1
    uid

# Turns a FETCH (UID BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE)]) response
# into "uid=<n> | <date> | <from> | <subject>" rows, newest first.
fn _format_list(lines: [text]) -> text:
    var rows: [text] = []
    var uid = ""
    var subject = ""
    var from = ""
    var date = ""
    var in_msg = false
    for l in lines:
        if l.starts_with("* ") and l.contains(" FETCH "):
            if in_msg and uid != "":
                rows.push("uid=" + uid + " | " + date + " | " + from + " | " + subject)
            uid = _uid_from_fetch_line(l)
            subject = ""
            from = ""
            date = ""
            in_msg = true
            continue
        if not in_msg:
            continue
        val s = _header_value(l, "Subject")
        if s != "":
            subject = s
        val f = _header_value(l, "From")
        if f != "":
            from = f
        val d = _header_value(l, "Date")
        if d != "":
            date = d
    if in_msg and uid != "":
        rows.push("uid=" + uid + " | " + date + " | " + from + " | " + subject)
    var rev: [text] = []
    var i = rows.len() - 1
    while i >= 0:
        rev.push(rows[i])
        i = i - 1
    rev.join("\n")

fn _imap_session_run(mailbox: text, on_selected_uid: text, limit: i64) -> (bool, text):
    val link = _connect(config_mail_imap_host(), config_mail_imap_port())
    if not link.ok:
        return (false, link.error)
    val session = imap_session_new()
    val login_err = _imap_login(link, session)
    if login_err != "":
        _close(link)
        return (false, login_err)
    val (sel_ok, exists) = _imap_select(link, session, mailbox)
    if not sel_ok:
        _close(link)
        return (false, "imap select '" + mailbox + "' failed")
    var result = ""
    var ok = true
    if on_selected_uid == "":
        if exists == 0:
            result = "(mailbox '" + mailbox + "' is empty)"
        else:
            var lo = exists - limit + 1
            if lo < 1:
                lo = 1
            val tag = imap_next_tag(session)
            val wire = imap_build_fetch(tag, lo.to_text() + ":" + exists.to_text(), "(UID BODY.PEEK[HEADER.FIELDS (SUBJECT FROM DATE)])")
            val (lines, _t, fok) = _imap_command(link, session, wire)
            if fok:
                result = _format_list(lines)
            else:
                ok = false
                result = "imap fetch failed: " + _last(lines)
    else:
        # Facade gap: imap_build_fetch emits FETCH, not UID FETCH; build the
        # UID form from the same tag text.
        val tag = imap_next_tag(session)
        val wire = imap_tag_to_text(tag) + " UID FETCH " + on_selected_uid + " (BODY.PEEK[])\r\n"
        val (lines, _t, fok) = _imap_command(link, session, wire)
        if fok:
            var body: [text] = []
            var seen_fetch = false
            for l in lines:
                if not seen_fetch:
                    if l.starts_with("* ") and l.contains(" FETCH "):
                        seen_fetch = true
                    continue
                if l.starts_with(_t + " "):
                    break
                body.push(l)
            # drop the closing ")" of the FETCH response
            if body.len() > 0 and _last(body) == ")":
                var trimmed: [text] = []
                var bi = 0
                while bi < body.len() - 1:
                    trimmed.push(body[bi])
                    bi = bi + 1
                body = trimmed
            if not seen_fetch:
                ok = false
                result = "mail_read: no message with uid " + on_selected_uid
            else:
                result = body.join("\n")
                if result.len() > MAIL_MAX_BODY:
                    result = result.substring(0, MAIL_MAX_BODY) + "\n... [truncated at " + MAIL_MAX_BODY.to_text() + " bytes]"
        else:
            ok = false
            result = "imap uid fetch failed: " + _last(lines)
    val ltag = imap_next_tag(session)
    _imap_command(link, session, imap_build_logout(ltag))
    _close(link)
    (ok, result)

# ============================================================================
# Public tool operations: (success, content)
# ============================================================================

fn mail_list(mailbox_in: text, limit_in: i64) -> (bool, text):
    var mailbox = mailbox_in
    if mailbox == "":
        mailbox = "INBOX"
    var limit = limit_in
    if limit < 1:
        limit = 20
    if limit > MAIL_MAX_LIST:
        limit = MAIL_MAX_LIST
    if config_mail_imap_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val serr = mail_secret_error()
    if serr != "":
        return (false, serr)
    _imap_session_run(mailbox, "", limit)

fn mail_read(uid: text) -> (bool, text):
    if uid == "":
        return (false, "mail_read: missing required 'uid'")
    var i = 0
    while i < uid.len():
        if uid[i] < "0" or uid[i] > "9":
            return (false, "mail_read: 'uid' must be a decimal IMAP UID, got '" + uid + "'")
        i = i + 1
    if config_mail_imap_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val serr = mail_secret_error()
    if serr != "":
        return (false, serr)
    _imap_session_run("INBOX", uid, 0)

fn _smtp_code(lines: [text]) -> i64:
    val last = _last(lines)
    if last.len() < 3:
        return 0
    last.substring(0, 3).to_i64() ?? 0

fn _smtp_step(link: MailLink, wire: text, want: i64) -> text:
    if not _send(link, wire):
        return "smtp send failed while writing '" + wire.trim() + "'"
    val reply = _read_smtp_reply(link)
    val code = _smtp_code(reply)
    if code != want:
        return "smtp expected " + want.to_text() + " after '" + wire.trim().split(" ")[0] + "', got: " + _last(reply)
    ""

fn mail_send(to: text, subject: text, body: text) -> (bool, text):
    if to == "":
        return (false, "mail_send: missing required 'to'")
    if not to.contains("@"):
        return (false, "mail_send: 'to' is not an email address: " + to)
    if subject == "":
        return (false, "mail_send: missing required 'subject'")
    if config_mail_smtp_host() == "":
        return (false, MAIL_NOT_CONFIGURED)
    val port = config_mail_smtp_port()
    if port == smtp_starttls_port():
        return (false, "mail_send: smtp_port 587 needs STARTTLS, which the TLS facade cannot upgrade in place; use 465 (implicit TLS) or a plaintext port")
    val user = config_mail_user()
    if user != "":
        val serr = mail_secret_error()
        if serr != "":
            return (false, serr)
    val link = _connect(config_mail_smtp_host(), port)
    if not link.ok:
        return (false, link.error)
    val greet = _read_smtp_reply(link)
    if _smtp_code(greet) != 220:
        _close(link)
        return (false, "smtp greeting was not 220: " + _last(greet))
    var err = _smtp_step(link, smtp_command_ehlo("localhost"), 250)
    if err == "" and user != "":
        err = _smtp_step(link, smtp_command_auth_plain().trim() + " " + auth_plain_encode(user, config_mail_secret()) + "\r\n", 235)
    var sender = user
    if sender == "":
        sender = "llm-caret@localhost"
    if err == "":
        err = _smtp_step(link, smtp_command_mail_from(sender), 250)
    if err == "":
        err = _smtp_step(link, smtp_command_rcpt_to(to), 250)
    if err == "":
        err = _smtp_step(link, smtp_command_data(), 354)
    if err == "":
        val msg = mail_build_message(sender, to, subject, body)
        err = _smtp_step(link, msg, 250)
    if err == "":
        _send(link, smtp_command_quit())
    _close(link)
    if err != "":
        return (false, err)
    (true, "sent to " + to + " via " + config_mail_smtp_host() + ":" + port.to_text())

# RFC 5322 headers + blank line + dot-stuffed body. smtp_dot_stuff already
# appends the single DATA terminator <CRLF>.<CRLF>; nothing may follow it.
#
# Why not std.nogc_sync_mut.smtp.send.message_build_simple: it calls
# mime_type_text_plain() through a bodyless "forward declaration" in send.spl
# (`fn mime_type_text_plain() -> text`, no body) that shadows the real one in
# smtp/mime.spl (importing ANY name from send.spl brings the bodyless decl
# into scope, so even smtp.mime.mime_type_text_plain resolves to it — isolated
# with a 2-spec scratch fixture: header_from + mime import fails, mime-only
# import passes; same block in nogc_async_mut/ and gc_async_mut/ send.spl), so the
# first live SMTP send aborted with "semantic: missing
# return in non-unit function 'mime_type_text_plain'" (measured 2026-08-25
# against greenmail/standalone). It also terminated the DATA section twice
# (message_build_simple + message_terminate), sending a stray "." command.
fn mail_build_message(sender: text, to: text, subject: text, body: text) -> text:
    header_from(sender) + header_to(to) + header_subject(subject) +
        header_content_type("text/plain; charset=utf-8") + "\r\n" + smtp_dot_stuff(body)
