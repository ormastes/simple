# LLM Caret - pane backend for the `cs` caret-suite dashboard.
#
# Lists panes, switches the active pane, and MAXIMIZES (zooms) the pane that is
# currently taking a command. Two backends behind one surface: tmux (POSIX) and
# Windows.
#
# Every host call goes through the sosix facade (std.nogc_async_mut.sosix) -
# tools depend on sosix, never on process_run/tmux directly.
#
# Windows has no tmux. The windows backend does not fake panes: it reports
# failure with a concrete reason instead of inventing a pane list.

use std.nogc_async_mut.sosix.{sosix_platform, sosix_run, sosix_which}

struct Pane:
    pane_id: text
    title: text
    pid: i64
    active: bool
    zoomed: bool

# tmux emits one line per pane. pane_title may contain spaces, so it is LAST and
# the remaining columns are rejoined into it. `.split(sep, N)` ignores N on this
# seed, so a limited split is not available.
#
# Zoom is a WINDOW property in tmux: window_zoomed_flag is 1 on every pane of a
# zoomed window. The pane that is actually maximized is the active one, so the
# zoom column is `window_zoomed_flag AND pane_active` - verified against tmux.
val PANE_FORMAT = "#{{pane_id}} #{{pane_pid}} #{{pane_active}} #{{?window_zoomed_flag,#{{pane_active}},0}} #{{pane_title}}"

fn _fields(line: text) -> [text]:
    var out: [text] = []
    for part in line.split(" "):
        if part.trim() != "":
            out = out + [part.trim()]
    out

fn _is_digits(raw: text) -> bool:
    if raw == "":
        return false
    for ch in raw.chars():
        if ch < "0" or ch > "9":
            return false
    true

# Parses one `tmux list-panes` line. Fails CLOSED: a malformed line yields an
# empty list, never a Pane carrying garbage fields.
fn pane_parse_line(line: text) -> [Pane]:
    val cols = _fields(line)
    if cols.len() < 4:
        return []
    if not cols[0].starts_with("%"):
        return []
    if not _is_digits(cols[1]):
        return []
    if cols[2] != "0" and cols[2] != "1":
        return []
    if cols[3] != "0" and cols[3] != "1":
        return []
    var title = ""
    var idx = 4
    while idx < cols.len():
        if title == "":
            title = cols[idx]
        else:
            title = title + " " + cols[idx]
        idx = idx + 1
    [Pane(pane_id: cols[0], title: title, pid: cols[1].to_i64() ?? 0,
        active: cols[2] == "1", zoomed: cols[3] == "1")]

fn pane_parse_lines(raw: text) -> [Pane]:
    var out: [Pane] = []
    for line in raw.split("\n"):
        for pane in pane_parse_line(line):
            out = out + [pane]
    out

# argv builders - pure, so the command shape is testable without tmux.
# tmux pane ids (`%3`) are globally unique, so -t takes the pane id alone.
fn pane_list_argv(session: text) -> [text]:
    ["list-panes", "-t", session, "-F", PANE_FORMAT]

fn pane_select_argv(pane_id: text) -> [text]:
    ["select-pane", "-t", pane_id]

fn pane_zoom_argv(pane_id: text) -> [text]:
    ["resize-pane", "-Z", "-t", pane_id]

fn pane_kill_argv(pane_id: text) -> [text]:
    ["kill-pane", "-t", pane_id]

# Two calls, deliberately: `-l` sends the text LITERALLY, so a message
# containing tmux key names ("Enter", "C-c") is typed rather than interpreted.
# The Enter that submits it is therefore a separate, explicit keystroke.
fn pane_send_literal_argv(pane_id: text, body: text) -> [text]:
    ["send-keys", "-t", pane_id, "-l", body]

fn pane_send_enter_argv(pane_id: text) -> [text]:
    ["send-keys", "-t", pane_id, "Enter"]

fn _is_windows() -> bool:
    sosix_platform() == "windows"

fn pane_backend_name() -> text:
    if _is_windows():
        return "windows"
    if pane_available():
        return "tmux"
    "none"

# POSITIVE probe: tmux must be on PATH and must actually answer.
fn pane_available() -> bool:
    if _is_windows():
        return false
    if sosix_which("tmux") == "":
        return false
    sosix_run("tmux", ["-V"]).exit_code == 0

fn _tmux_ok(args: [text]) -> bool:
    if not pane_available():
        return false
    sosix_run("tmux", args).exit_code == 0

fn pane_list(session: text) -> [Pane]:
    if not pane_available():
        return []
    val result = sosix_run("tmux", pane_list_argv(session))
    if result.exit_code != 0:
        return []
    pane_parse_lines(result.stdout)

fn pane_select(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    _tmux_ok(pane_select_argv(pane_id))

# Toggle maximize on the pane currently taking a command.
fn pane_zoom(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    _tmux_ok(pane_zoom_argv(pane_id))

fn pane_kill(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    _tmux_ok(pane_kill_argv(pane_id))

# Delivers `body` into a pane as if typed, then submits it. Returns false
# rather than half-sending: if the literal write fails, Enter is not sent, so a
# partial line is never submitted to an agent.
fn pane_send(session: text, pane_id: text, body: text) -> bool:
    if session == "" or pane_id == "" or body == "":
        return false
    if not _tmux_ok(pane_send_literal_argv(pane_id, body)):
        return false
    _tmux_ok(pane_send_enter_argv(pane_id))

# Returns a Pane with an empty pane_id when the backend cannot spawn - callers
# check `pane_id != ""`. Nothing fabricated.
fn pane_spawn(session: text, title: text, cmd: text, args: [text]) -> Pane:
    val empty = Pane(pane_id: "", title: title, pid: 0, active: false, zoomed: false)
    if not pane_available():
        return empty
    if session == "" or cmd == "":
        return empty
    var argv: [text] = []
    if pane_list(session).len() == 0:
        argv = ["new-session", "-d", "-s", session, "-P", "-F", "#{{pane_id}}"]
    else:
        argv = ["split-window", "-d", "-t", session, "-P", "-F", "#{{pane_id}}"]
    argv = argv + [cmd] + args
    val result = sosix_run("tmux", argv)
    if result.exit_code != 0:
        return empty
    val pane_id = result.stdout.trim()
    if not pane_id.starts_with("%"):
        return empty
    if title != "":
        sosix_run("tmux", ["select-pane", "-t", pane_id, "-T", title])
    for pane in pane_list(session):
        if pane.pane_id == pane_id:
            return pane
    empty

export Pane, PANE_FORMAT
export pane_parse_line, pane_parse_lines
export pane_list_argv, pane_select_argv, pane_zoom_argv, pane_kill_argv
export pane_send_literal_argv, pane_send_enter_argv
export pane_backend_name, pane_available
export pane_list, pane_select, pane_zoom, pane_spawn, pane_kill, pane_send
