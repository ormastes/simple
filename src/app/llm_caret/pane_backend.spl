# LLM Caret - pane backend for the `cs` caret-suite dashboard.
#
# Lists panes, switches the active pane, MAXIMIZES (zooms) the pane that is
# currently taking a command, and captures what a pane's child printed (the
# dashboard's right-hand agent screen). Two backends behind one surface:
#
#   smux  - Simple's own multiplexer (os.apps.smux.api): the DEFAULT on every
#           host, including Windows, where each pane child runs on a real ConPTY.
#   tmux  - opt-in with CS_PANE_BACKEND=tmux, on POSIX hosts where tmux
#           answers a positive probe.
#
# tmux calls go through the sosix facade (std.nogc_async_mut.sosix) - tools
# depend on sosix, never on process_run/tmux directly. smux is in-process, so
# its panes live as long as the dashboard process does.

use std.nogc_async_mut.sosix.{sosix_platform, sosix_run, sosix_which}
use os.apps.smux.api.{smux_create_session, smux_list_sessions,
    smux_list_windows, smux_list_panes, smux_split_pane, smux_focus_pane,
    smux_focused_pane, smux_close_pane, smux_pane_close_pty, smux_pane_spawn_pty, smux_pane_alive, smux_resize,
    smux_send_command, smux_send_text, smux_capture, smux_capture_styled,
    smux_paste_text}
use std.nogc_sync_mut.io.{thread_sleep_ms}
use app.io.mod.{env_get}

# Gap between typing a message and pressing Enter, so the TUI sees two input
# events. Measured enough for codex and kimi on ConPTY.
const PANE_SUBMIT_DELAY_MS: i64 = 150

struct Pane:
    pane_id: text
    title: text
    pid: i64
    active: bool
    zoomed: bool

fn windows_quote_arg(arg: text) -> text:
    """Quote one CreateProcess command-line argument using Windows CRT rules."""
    if arg != "" and not arg.contains(" ") and not arg.contains("\t") and not arg.contains("\""):
        return arg
    var out = "\""
    var slashes: i64 = 0
    for ch in arg.chars():
        if ch == "\\":
            slashes = slashes + 1
        else:
            if ch == "\"":
                var qi: i64 = 0
                while qi < slashes * 2 + 1:
                    out = out + "\\"
                    qi = qi + 1
                out = out + "\""
            else:
                var si: i64 = 0
                while si < slashes:
                    out = out + "\\"
                    si = si + 1
                out = out + ch
            slashes = 0
    var ti: i64 = 0
    while ti < slashes * 2:
        out = out + "\\"
        ti = ti + 1
    out + "\""

fn windows_command_line(cmd: text, args: [text]) -> text:
    var line = windows_quote_arg(cmd)
    for arg in args:
        line = line + " " + windows_quote_arg(arg)
    line

fn windows_spawn_command_line(cmd: text, args: [text]) -> text:
    """Build a ConPTY command line, routing Windows batch shims via cmd.exe."""
    val lower = cmd.lower()
    if lower.ends_with(".cmd") or lower.ends_with(".bat"):
        return windows_command_line("cmd.exe", ["/d", "/c", "call", cmd] + args)
    windows_command_line(cmd, args)

# POSIX shell single-quoting: 'it'\''s'.
fn posix_quote_arg(arg: text) -> text:
    "'" + arg.replace("'", "'\\''") + "'"

fn posix_command_line(cmd: text, args: [text]) -> text:
    var line = posix_quote_arg(cmd)
    for arg in args:
        line = line + " " + posix_quote_arg(arg)
    line

# `exec` line for a pane shell. A non-empty `stderr_path` appends the child's
# stderr there, so diagnostics stay on disk instead of flooding the screen.
fn posix_exec_line(cmd: text, args: [text], stderr_path: text) -> text:
    var line = "exec " + posix_command_line(cmd, args)
    if stderr_path != "":
        line = line + " 2>>" + posix_quote_arg(stderr_path)
    line

# tmux emits one line per pane. pane_title may contain spaces, so it is LAST and
# the remaining columns are rejoined into it. `.split(sep, N)` ignores N on this
# seed, so a limited split is not available.
#
# Zoom is a WINDOW property in tmux: window_zoomed_flag is 1 on every pane of a
# zoomed window. The pane that is actually maximized is the active one, so the
# zoom column is `window_zoomed_flag AND pane_active` - verified against tmux.
val PANE_FORMAT = "#{{pane_id}} #{{pane_pid}} #{{pane_active}} #{{?window_zoomed_flag,#{{pane_active}},0}} #{{pane_title}}"

fn _fields(line: text) -> [text]:
    var out: [text] = []
    for part in line.split(" "):
        if part.trim() != "":
            out = out + [part.trim()]
    out

fn _is_digits(raw: text) -> bool:
    if raw == "":
        return false
    for ch in raw.chars():
        if ch < "0" or ch > "9":
            return false
    true

# Parses one `tmux list-panes` line. Fails CLOSED: a malformed line yields an
# empty list, never a Pane carrying garbage fields.
fn pane_parse_line(line: text) -> [Pane]:
    val cols = _fields(line)
    if cols.len() < 4:
        return []
    if not cols[0].starts_with("%"):
        return []
    if not _is_digits(cols[1]):
        return []
    if cols[2] != "0" and cols[2] != "1":
        return []
    if cols[3] != "0" and cols[3] != "1":
        return []
    var title = ""
    var idx = 4
    while idx < cols.len():
        if title == "":
            title = cols[idx]
        else:
            title = title + " " + cols[idx]
        idx = idx + 1
    [Pane(pane_id: cols[0], title: title, pid: cols[1].to_i64() ?? 0,
        active: cols[2] == "1", zoomed: cols[3] == "1")]

fn pane_parse_lines(raw: text) -> [Pane]:
    var out: [Pane] = []
    for line in raw.split("\n"):
        for pane in pane_parse_line(line):
            out = out + [pane]
    out

# argv builders - pure, so the command shape is testable without tmux.
# tmux pane ids (`%3`) are globally unique, so -t takes the pane id alone.
fn pane_list_argv(session: text) -> [text]:
    ["list-panes", "-t", session, "-F", PANE_FORMAT]

fn pane_select_argv(pane_id: text) -> [text]:
    ["select-pane", "-t", pane_id]

fn pane_zoom_argv(pane_id: text) -> [text]:
    ["resize-pane", "-Z", "-t", pane_id]

fn pane_kill_argv(pane_id: text) -> [text]:
    ["kill-pane", "-t", pane_id]

fn pane_capture_argv(pane_id: text, lines: i64) -> [text]:
    ["capture-pane", "-p", "-J", "-t", pane_id, "-S", "-" + lines.to_text()]

# Two calls, deliberately: `-l` sends the text LITERALLY, so a message
# containing tmux key names ("Enter", "C-c") is typed rather than interpreted.
# The Enter that submits it is therefore a separate, explicit keystroke.
fn pane_send_literal_argv(pane_id: text, body: text) -> [text]:
    ["send-keys", "-t", pane_id, "-l", body]

fn pane_send_enter_argv(pane_id: text) -> [text]:
    ["send-keys", "-t", pane_id, "Enter"]

fn _is_windows() -> bool:
    sosix_platform() == "windows"

# POSITIVE probe: tmux must be on PATH and must actually answer.
fn _tmux_available() -> bool:
    if _is_windows():
        return false
    if sosix_which("tmux") == "":
        return false
    sosix_run("tmux", ["-V"]).exit_code == 0

# Default is Simple's own smux; tmux is opt-in via CS_PANE_BACKEND=tmux.
fn _use_tmux() -> bool:
    (env_get("CS_PANE_BACKEND") ?? "") == "tmux" and _tmux_available()

fn pane_backend_name() -> text:
    if _use_tmux():
        return "tmux"
    "smux"

fn _tmux_ok(args: [text]) -> bool:
    sosix_run("tmux", args).exit_code == 0

# ---------------------------------------------------------------------------
# smux backend. A cs session NAME maps to the smux session of that name, with
# all agent panes in its first window.
# ---------------------------------------------------------------------------

struct SmuxScope:
    session_id: text
    window_id: text

fn _smux_scope(session: text) -> SmuxScope:
    for s in smux_list_sessions():
        if s.name == session:
            val ws = smux_list_windows(s.id)
            if ws.len() > 0:
                return SmuxScope(session_id: s.id, window_id: ws[0].id)
    SmuxScope(session_id: "", window_id: "")

fn _smux_list(session: text) -> [Pane]:
    val scope = _smux_scope(session)
    var out: [Pane] = []
    if scope.session_id == "":
        return out
    val focused = smux_focused_pane(scope.session_id, scope.window_id)
    val focused_id = if focused.is_ok(): focused.unwrap().id else: ""
    for p in smux_list_panes(scope.session_id, scope.window_id):
        val alive = smux_pane_alive(scope.session_id, scope.window_id, p.id)
        # An empty slot (no child, or an exited one) is not an agent pane.
        if alive.is_ok() and alive.unwrap():
            out = out + [Pane(pane_id: p.id, title: _smux_title(p.id),
                pid: _smux_pid(p.id), active: p.id == focused_id,
                zoomed: p.id == _smux_zoomed)]
    out

# smux panes carry no title or pid field; the backend remembers both.
struct SmuxPaneInfo:
    pane_id: text
    title: text
    pid: i64

var _smux_info: [SmuxPaneInfo] = []
var _smux_zoomed: text = ""

fn _smux_title(pane_id: text) -> text:
    for info in _smux_info:
        if info.pane_id == pane_id:
            return info.title
    ""

fn _smux_pid(pane_id: text) -> i64:
    for info in _smux_info:
        if info.pane_id == pane_id:
            return info.pid
    0

# A free pane slot for a new child: the session's first pane while it is still
# empty, otherwise a fresh split.
fn _smux_free_pane(scope: SmuxScope) -> text:
    val panes = smux_list_panes(scope.session_id, scope.window_id)
    for p in panes:
        val alive = smux_pane_alive(scope.session_id, scope.window_id, p.id)
        if alive.is_ok() and not alive.unwrap() and _smux_pid(p.id) == 0:
            return p.id
    if panes.len() == 0:
        return ""
    val split = smux_split_pane(scope.session_id, scope.window_id, panes[0].id, "vertical")
    if split.is_err():
        return ""
    split.unwrap().id

fn _smux_spawn(session: text, title: text, cmd: text, args: [text], cols: i64,
        rows: i64, stderr_path: text) -> Pane:
    val empty = Pane(pane_id: "", title: title, pid: 0, active: false, zoomed: false)
    var scope = _smux_scope(session)
    if scope.session_id == "":
        if smux_create_session(session).id == "":
            return empty
        scope = _smux_scope(session)
    val pane_id = _smux_free_pane(scope)
    if pane_id == "":
        return empty
    # ponytail: a POSIX pty spawn execs ONE program with no argv, so a command
    # with arguments runs through `/bin/sh` and an `exec` line. Upgrade: an
    # argv-taking rt_pty_spawn.
    var line = windows_spawn_command_line(cmd, args)
    if not _is_windows():
        line = "/bin/sh"
    # The PTY is opened at the slot's geometry, so size the slot first.
    if cols > 0 and rows > 0:
        val _r = smux_resize(scope.session_id, scope.window_id, pane_id, cols, rows)
    val spawned = smux_pane_spawn_pty(scope.session_id, scope.window_id, pane_id, line)
    if spawned.is_err():
        return empty
    if not _is_windows():
        # The child is not inside tmux even when cs is; an inherited TMUX makes
        # CLIs (kimi) warn and fall back on keys. smux emulates xterm-256color.
        # The shell echoes the typed launch line; clear it first so a CLI that
        # draws on the main screen (kimi) starts on a blank pane.
        val _e = smux_send_command(scope.session_id, scope.window_id, pane_id,
            "printf '\\033[H\\033[2J'; " + posix_exec_line("env", ["-u", "TMUX", "-u", "TMUX_PANE",
                "TERM=xterm-256color", cmd] + args, stderr_path))
    _smux_info = _smux_info + [SmuxPaneInfo(pane_id: pane_id, title: title, pid: spawned.unwrap())]
    val _f = smux_focus_pane(scope.session_id, scope.window_id, pane_id)
    Pane(pane_id: pane_id, title: title, pid: spawned.unwrap(), active: true, zoomed: false)

# ---------------------------------------------------------------------------
# Public surface
# ---------------------------------------------------------------------------

fn pane_list(session: text) -> [Pane]:
    if not _use_tmux():
        return _smux_list(session)
    val result = sosix_run("tmux", pane_list_argv(session))
    if result.exit_code != 0:
        return []
    pane_parse_lines(result.stdout)

fn pane_select(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    if not _use_tmux():
        val scope = _smux_scope(session)
        return smux_focus_pane(scope.session_id, scope.window_id, pane_id)
    _tmux_ok(pane_select_argv(pane_id))

# Toggle maximize on the pane currently taking a command.
fn pane_zoom(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    if not _use_tmux():
        var known = false
        for p in _smux_list(session):
            if p.pane_id == pane_id:
                known = true
        if not known:
            return false
        _smux_zoomed = if _smux_zoomed == pane_id: "" else: pane_id
        return true
    _tmux_ok(pane_zoom_argv(pane_id))

fn pane_kill(session: text, pane_id: text) -> bool:
    if session == "" or pane_id == "":
        return false
    if not _use_tmux():
        val scope = _smux_scope(session)
        # Never remove the window's LAST pane: an empty window has nothing to
        # split, so every later spawn would fail. End its child instead and
        # keep the slot, which `_smux_free_pane` then reuses.
        if smux_list_panes(scope.session_id, scope.window_id).len() <= 1:
            if not smux_pane_close_pty(scope.session_id, scope.window_id, pane_id):
                return false
        elif not smux_close_pane(scope.session_id, scope.window_id, pane_id):
            return false
        var kept: [SmuxPaneInfo] = []
        for info in _smux_info:
            if info.pane_id != pane_id:
                kept = kept + [info]
        _smux_info = kept
        return true
    _tmux_ok(pane_kill_argv(pane_id))

# Sets a pane's terminal to `cols` x `rows`, so its child lays out for the
# region the dashboard actually shows.
fn pane_resize(session: text, pane_id: text, cols: i64, rows: i64) -> bool:
    if session == "" or pane_id == "" or cols <= 0 or rows <= 0:
        return false
    if not _use_tmux():
        val scope = _smux_scope(session)
        return smux_resize(scope.session_id, scope.window_id, pane_id, cols, rows).is_ok()
    _tmux_ok(["resize-pane", "-t", pane_id, "-x", cols.to_text(), "-y", rows.to_text()])

# Delivers `body` into a pane as if typed, then submits it. Returns false
# rather than half-sending: if the literal write fails, Enter is not sent, so a
# partial line is never submitted to an agent.
fn pane_send(session: text, pane_id: text, body: text) -> bool:
    if session == "" or pane_id == "" or body == "":
        return false
    if not _use_tmux():
        # Type, pause, then press Enter as its own keystroke. Text and "\r" in
        # one write reach a TUI as a single paste, and agent TUIs (codex, kimi)
        # keep a pasted newline in the composer instead of submitting.
        # Pasted (bracketed when the child enabled ?2004), so a CLI composer
        # takes the body as one paste rather than as typed keystrokes.
        val scope = _smux_scope(session)
        if smux_paste_text(scope.session_id, scope.window_id, pane_id, body).is_err():
            return false
        thread_sleep_ms(PANE_SUBMIT_DELAY_MS)
        return smux_send_text(scope.session_id, scope.window_id, pane_id, "\r").is_ok()
    if not _tmux_ok(pane_send_literal_argv(pane_id, body)):
        return false
    _tmux_ok(pane_send_enter_argv(pane_id))

# Named keys an agent's own dialogs need (accept, dismiss, move, interrupt),
# as the bytes a terminal sends and as tmux key names. Unknown name -> "".
fn pane_key_bytes(key: text) -> text:
    if key == "enter":
        return "\r"
    if key == "esc":
        return "\x1b"
    if key == "tab":
        return "\t"
    if key == "space":
        return " "
    if key == "up":
        return "\x1b[A"
    if key == "down":
        return "\x1b[B"
    if key == "ctrl-c":
        return "\x03"
    ""

fn pane_key_tmux_name(key: text) -> text:
    if key == "enter":
        return "Enter"
    if key == "esc":
        return "Escape"
    if key == "tab":
        return "Tab"
    if key == "space":
        return "Space"
    if key == "up":
        return "Up"
    if key == "down":
        return "Down"
    if key == "ctrl-c":
        return "C-c"
    ""

# Presses one named key in the pane, without typing any text.
fn pane_send_key(session: text, pane_id: text, key: text) -> bool:
    if session == "" or pane_id == "" or pane_key_bytes(key) == "":
        return false
    if not _use_tmux():
        val scope = _smux_scope(session)
        return smux_send_text(scope.session_id, scope.window_id, pane_id, pane_key_bytes(key)).is_ok()
    _tmux_ok(["send-keys", "-t", pane_id, pane_key_tmux_name(key)])

# The last `lines` lines the pane's child printed, oldest first. An unknown
# pane is an empty list, never invented text.
fn pane_capture(session: text, pane_id: text, lines: i64) -> [text]:
    _pane_capture(session, pane_id, lines, false)

# pane_capture with the child's colours and attributes kept as SGR runs, so the
# dashboard can show an agent's own TUI as it drew it.
fn pane_capture_styled(session: text, pane_id: text, lines: i64) -> [text]:
    _pane_capture(session, pane_id, lines, true)

fn _pane_capture(session: text, pane_id: text, lines: i64, styled: bool) -> [text]:
    var out: [text] = []
    if session == "" or pane_id == "":
        return out
    var raw = ""
    if not _use_tmux():
        val scope = _smux_scope(session)
        if styled:
            val cap = smux_capture_styled(scope.session_id, scope.window_id, pane_id, lines)
            if cap.is_err():
                return out
            raw = cap.unwrap()
        else:
            val cap = smux_capture(scope.session_id, scope.window_id, pane_id, lines)
            if cap.is_err():
                return out
            raw = cap.unwrap().content
    else:
        var argv = pane_capture_argv(pane_id, lines)
        if styled:
            argv = argv + ["-e"]
        val result = sosix_run("tmux", argv)
        if result.exit_code != 0:
            return out
        raw = result.stdout
    if raw == "":
        return out
    for line in raw.split("\n"):
        out = out + [line]
    out

# Returns a Pane with an empty pane_id when the backend cannot spawn - callers
# check `pane_id != ""`. Nothing fabricated.
fn pane_spawn(session: text, title: text, cmd: text, args: [text]) -> Pane:
    pane_spawn_at(session, title, cmd, args, 0, 0, "")

# pane_spawn with the child's terminal sized to `cols` x `rows` (0 = backend
# default) and, when `stderr_path` is non-empty, its stderr appended to that
# file. Windows children keep their stderr on the console.
fn pane_spawn_at(session: text, title: text, cmd: text, args: [text], cols: i64,
        rows: i64, stderr_path: text) -> Pane:
    val empty = Pane(pane_id: "", title: title, pid: 0, active: false, zoomed: false)
    if session == "" or cmd == "":
        return empty
    if not _use_tmux():
        return _smux_spawn(session, title, cmd, args, cols, rows, stderr_path)
    var argv: [text] = []
    if pane_list(session).len() == 0:
        argv = ["new-session", "-d", "-s", session, "-P", "-F", "#{{pane_id}}"]
    else:
        argv = ["split-window", "-d", "-t", session, "-P", "-F", "#{{pane_id}}"]
    if stderr_path != "":
        argv = argv + ["/bin/sh", "-c", posix_exec_line(cmd, args, stderr_path)]
    else:
        argv = argv + [cmd] + args
    val result = sosix_run("tmux", argv)
    if result.exit_code != 0:
        return empty
    val pane_id = result.stdout.trim()
    if not pane_id.starts_with("%"):
        return empty
    if title != "":
        sosix_run("tmux", ["select-pane", "-t", pane_id, "-T", title])
    if cols > 0 and rows > 0:
        val _r = pane_resize(session, pane_id, cols, rows)
    for pane in pane_list(session):
        if pane.pane_id == pane_id:
            return pane
    empty

export Pane, PANE_FORMAT
export pane_parse_line, pane_parse_lines
export pane_list_argv, pane_select_argv, pane_zoom_argv, pane_kill_argv, pane_capture_argv
export pane_send_literal_argv, pane_send_enter_argv
export windows_quote_arg, windows_command_line, windows_spawn_command_line
export posix_quote_arg, posix_command_line, posix_exec_line
export pane_backend_name
export pane_list, pane_select, pane_zoom, pane_spawn, pane_spawn_at, pane_resize
export pane_kill, pane_send, pane_capture, pane_capture_styled
export pane_send_key, pane_key_bytes, pane_key_tmux_name
