# LLM Caret - STARTTLS negotiation logic (SMTP RFC 3207, IMAP RFC 2595/3501)
#
# Pure protocol state machine, transport-free: the caller sends
# `state.next_command`, reads one complete server reply, and feeds it back
# with `starttls_feed`. When `state.ready` is true the TCP socket must be
# wrapped in TLS IN PLACE — which the runtime cannot do today (no
# rt_tls_client_from_fd; see
# doc/08_tracking/bug/tls_no_fd_upgrade_blocks_starttls_2026-08-25.md), so
# infra_mail refuses the 587/143-STARTTLS configuration before connecting and
# this module is exercised against scripted server transcripts only.
#
# Phases (SMTP): EHLO -> parse 250 multiline for "STARTTLS" -> STARTTLS -> 220
# Phases (IMAP): CAPABILITY -> "* CAPABILITY ... STARTTLS" + tagged OK -> STARTTLS -> tagged OK

use std.nogc_sync_mut.imap.{
    ImapTag, imap_tag_to_text, imap_build_capability, imap_build_starttls,
    imap_parse_capability_tokens, imap_parse_tagged_response, imap_status_is_ok
}
use std.nogc_sync_mut.smtp.connect.{smtp_command_ehlo}

val STARTTLS_SMTP = 0
val STARTTLS_IMAP = 1

val PHASE_CAPABILITY = 0     # waiting for EHLO / CAPABILITY reply
val PHASE_UPGRADE = 1        # waiting for STARTTLS reply
val PHASE_DONE = 2

val STARTTLS_MISSING_RUNTIME_SYMBOL = "rt_tls_client_from_fd"

struct StarttlsState:
    kind: i64
    phase: i64
    tag: text              # IMAP tag of the command in flight ("" for SMTP)
    next_command: text     # wire text to send now ("" when nothing to send)
    sent: [text]           # every command produced so far, in order
    advertised: bool       # server listed STARTTLS in its capabilities
    ready: bool            # server said go: upgrade the socket now
    error: text            # "" while healthy

fn _state(kind: i64, phase: i64, tag: text, cmd: text, sent: [text], adv: bool, ready: bool, err: text) -> StarttlsState:
    StarttlsState(kind: kind, phase: phase, tag: tag, next_command: cmd, sent: sent, advertised: adv, ready: ready, error: err)

fn _kind_name(kind: i64) -> text:
    if kind == STARTTLS_SMTP:
        return "smtp"
    "imap"

fn starttls_begin(kind: i64, client_name: text) -> StarttlsState:
    if kind == STARTTLS_SMTP:
        val cmd = smtp_command_ehlo(client_name)
        return _state(kind, PHASE_CAPABILITY, "", cmd, [cmd], false, false, "")
    val tag = ImapTag(seq: 1)
    val cmd = imap_build_capability(tag)
    _state(kind, PHASE_CAPABILITY, imap_tag_to_text(tag), cmd, [cmd], false, false, "")

# RFC 5321 reply lines are "250-TEXT" (more follow) or "250 TEXT" (last).
fn smtp_ehlo_advertises_starttls(lines: [text]) -> bool:
    for l in lines:
        if l.length() < 4:
            continue
        val code = l.substring(0, 3)
        if code != "250":
            continue
        val keyword = l.substring(4, l.length()).trim().to_upper()
        if keyword == "STARTTLS":
            return true
    false

fn _smtp_code(lines: [text]) -> i64:
    if lines.len() == 0:
        return 0
    val last = lines[lines.len() - 1]
    if last.length() < 3:
        return 0
    last.substring(0, 3).to_i64() ?? 0

fn imap_capability_advertises_starttls(lines: [text]) -> bool:
    for l in lines:
        var caps = ""
        if l.starts_with("* CAPABILITY "):
            caps = l.substring(13, l.length())
        else:
            # greeting-style response code: "* OK [CAPABILITY ...] ready"
            val open = l.index_of("[CAPABILITY ")
            if open >= 0:
                val rest = l.substring(open + 12, l.length())
                val close = rest.index_of("]")
                if close >= 0:
                    caps = rest.substring(0, close)
        if caps == "":
            continue
        for tok in imap_parse_capability_tokens(caps):
            if tok.to_upper() == "STARTTLS":
                return true
    false

fn _imap_tagged_ok(lines: [text], tag: text) -> bool:
    for l in lines:
        if l.starts_with(tag + " "):
            return imap_status_is_ok(imap_parse_tagged_response(l).status)
    false

fn _fail(st: StarttlsState, msg: text) -> StarttlsState:
    _state(st.kind, PHASE_DONE, st.tag, "", st.sent, st.advertised, false, _kind_name(st.kind) + " starttls: " + msg)

# Feed one complete server reply (lines without CRLF). Returns the next state.
fn starttls_feed(st: StarttlsState, reply: [text]) -> StarttlsState:
    if st.phase == PHASE_DONE:
        return st
    if st.kind == STARTTLS_SMTP:
        if st.phase == PHASE_CAPABILITY:
            val code = _smtp_code(reply)
            if code != 250:
                return _fail(st, "EHLO was not accepted (" + code.to_text() + ")")
            if not smtp_ehlo_advertises_starttls(reply):
                return _fail(st, "server does not advertise STARTTLS; refusing to send credentials in cleartext")
            var sent = st.sent
            sent.push("STARTTLS\r\n")
            return _state(st.kind, PHASE_UPGRADE, "", "STARTTLS\r\n", sent, true, false, "")
        val code = _smtp_code(reply)
        if code != 220:
            return _fail(st, "STARTTLS refused (" + code.to_text() + ")")
        return _state(st.kind, PHASE_DONE, "", "", st.sent, true, true, "")
    if st.phase == PHASE_CAPABILITY:
        if not _imap_tagged_ok(reply, st.tag):
            return _fail(st, "CAPABILITY was not accepted")
        if not imap_capability_advertises_starttls(reply):
            return _fail(st, "server does not advertise STARTTLS; refusing to send credentials in cleartext")
        val tag = ImapTag(seq: 2)
        val cmd = imap_build_starttls(tag)
        var sent = st.sent
        sent.push(cmd)
        return _state(st.kind, PHASE_UPGRADE, imap_tag_to_text(tag), cmd, sent, true, false, "")
    if not _imap_tagged_ok(reply, st.tag):
        return _fail(st, "STARTTLS refused")
    _state(st.kind, PHASE_DONE, st.tag, "", st.sent, true, true, "")

# Drives the state machine over a scripted transcript: one reply group per
# command the client sends. Used by specs and by the honest refusal path.
fn starttls_run_script(kind: i64, client_name: text, replies: [[text]]) -> StarttlsState:
    var st = starttls_begin(kind, client_name)
    var i = 0
    while st.phase != PHASE_DONE and i < replies.len():
        st = starttls_feed(st, replies[i])
        i = i + 1
    if st.phase != PHASE_DONE:
        return _fail(st, "transcript ended before the server answered '" + st.next_command.trim() + "'")
    st

# The message infra_mail returns when negotiation would succeed but the
# runtime cannot wrap the live fd.
fn starttls_runtime_gap_error(port: i64) -> text:
    "mail: port " + port.to_text() + " needs STARTTLS, and the runtime has no in-place TLS upgrade (missing " + STARTTLS_MISSING_RUNTIME_SYMBOL + "; see doc/08_tracking/bug/tls_no_fd_upgrade_blocks_starttls_2026-08-25.md); use 465/993 (implicit TLS) or a plaintext port"

export STARTTLS_SMTP, STARTTLS_IMAP, STARTTLS_MISSING_RUNTIME_SYMBOL
export StarttlsState, starttls_begin, starttls_feed, starttls_run_script
export smtp_ehlo_advertises_starttls, imap_capability_advertises_starttls, starttls_runtime_gap_error
