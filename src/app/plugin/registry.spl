# Plugin manifest registry helpers for SFFI dynamic plugins.

use app.io.mod.{env_get as app_env_get, home as app_home}
use std.common.sdn.parser.{parse as sdn_parse}
use std.common.sdn.schema.{SdnDecodeIssues, sdn_get_text, sdn_get_text_array}
use std.io_runtime.{
    file_exists, read_file_text as file_read, file_write, dir_create_all
}

fn env_get(key: text) -> text:
    app_env_get(key)

fn home() -> text:
    app_home()

struct PluginMethodEntry:
    name: text
    symbol: text
    params: [text]
    return_type: text

struct PluginClassEntry:
    name: text
    constructor_symbol: text
    destructor_symbol: text
    methods: [PluginMethodEntry]

struct PluginEntry:
    name: text
    library: text
    version: text
    functions: [text]
    classes: [PluginClassEntry]

fn plugin_entry_new(name: text, library: text, version: text, functions: [text]) -> PluginEntry:
    PluginEntry(name: name, library: library, version: version, functions: functions, classes: [])

fn plugin_entry_new_with_classes(name: text, library: text, version: text, functions: [text], classes: [PluginClassEntry]) -> PluginEntry:
    PluginEntry(name: name, library: library, version: version, functions: functions, classes: classes)

fn plugin_manifest_path() -> text:
    val override_path = env_get("SIMPLE_PLUGIN_MANIFEST") ?? ""
    if override_path != "":
        return override_path
    val home_dir = home() ?? ""
    if home_dir == "":
        return ".simple/plugins/manifest.sdn"
    home_dir + "/.simple/plugins/manifest.sdn"

# ---- SDN-backed manifest decoder -------------------------------------------
#
# On-disk shape is a "plugins:" block holding a bullet ("-") list of entries,
# e.g.:
#   plugins:
#       -
#           name: regex
#           library: /tmp/libsimple_regex_ffi.so
#           version: "0.1.0"
#           functions: [rt_regex_new, rt_regex_destroy]
#           classes:
#               Cls:
#                   constructor: rt_cls_new
#                   destructor: rt_cls_free
#                   methods:
#                       run:
#                           symbol: rt_cls_run
#                           params: [a, b]
#                           return: i64
#
# The bullet-list-of-blocks shape is not itself valid generic SDN (the parser
# in std.common.sdn.parser only turns `[a, b]`/`{k: v}` brackets into arrays;
# a bare "-" line has no `key:`/`key=` separator and is silently skipped, so
# feeding this text to `parse()` unmodified merges every entry's fields into
# one dict). Only that bullet-splitting step is bespoke here; every FIELD is
# decoded through the real SDN parser + schema.spl getters below, not by hand.

# Indentation (leading spaces) of a raw line.
fn _plugin_manifest_indent(raw_line: text) -> i64:
    raw_line.len() - raw_line.trim_start().len()

# Split manifest text into per-entry SDN block-mapping bodies: the dedented
# lines following each top-level "-" bullet. Each returned block is valid
# standalone SDN (`std.common.sdn.parser.parse`) block-mapping text.
fn _plugin_manifest_entry_blocks(content: text) -> [text]:
    val lines = content.split("\n")
    var bullet_indent: i64 = -1
    for raw_line in lines:
        if raw_line.trim() == "-":
            bullet_indent = _plugin_manifest_indent(raw_line)
    var blocks: [text] = []
    if bullet_indent < 0:
        return blocks
    var i = 0
    while i < lines.len():
        val raw_line = lines[i]
        if raw_line.trim() == "-" and _plugin_manifest_indent(raw_line) == bullet_indent:
            var body_lines: [text] = []
            i = i + 1
            while i < lines.len():
                val body_line = lines[i]
                if body_line.trim() == "":
                    body_lines.push("")
                    i = i + 1
                else:
                    if _plugin_manifest_indent(body_line) <= bullet_indent:
                        break
                    body_lines.push(body_line)
                    i = i + 1
            blocks.push(body_lines.join("\n"))
        else:
            i = i + 1
    blocks

# NOTE: classes/methods key order is NOT read from `SdnValue.Dict.keys()` --
# under this runtime Dict key iteration order is not guaranteed to match
# insertion order (see doc/07_guide/language/dict_native_pitfalls.md family of
# defects), and the on-disk manifest order must be preserved (existing
# consumers, e.g. multi-method/multi-class fixtures, assert positional
# order). So `classes:`/`methods:` are split from the SOURCE TEXT in file
# order (`_plugin_manifest_named_blocks`), and only the per-entity SCALAR
# fields (constructor/destructor/symbol/params/return) go through
# `sdn_parse` + schema.spl getters.

# Split an indented block of `key:\n  <nested lines>` entries (no "-" bullets)
# into (key, nested_body_text) pairs, preserving source order. Used for the
# "classes:" (class name -> body) and "methods:" (method name -> body)
# shapes.
fn _plugin_manifest_named_blocks(body: text) -> [(text, text)]:
    val lines = body.split("\n")
    var out: [(text, text)] = []
    var i = 0
    while i < lines.len() and lines[i].trim() == "":
        i = i + 1
    if i >= lines.len():
        return out
    val base_indent = _plugin_manifest_indent(lines[i])
    var running = true
    while running and i < lines.len():
        val line = lines[i]
        if line.trim() == "":
            i = i + 1
        else:
            val ind = _plugin_manifest_indent(line)
            if ind < base_indent:
                running = false
            elif ind == base_indent and line.trim().ends_with(":"):
                val key_line = line.trim()
                val name = key_line.substring(0, key_line.len() - 1).trim()
                var child_lines: [text] = []
                i = i + 1
                while i < lines.len():
                    val cline = lines[i]
                    if cline.trim() == "":
                        child_lines.push("")
                        i = i + 1
                    else:
                        if _plugin_manifest_indent(cline) <= base_indent:
                            break
                        child_lines.push(cline)
                        i = i + 1
                out.push((name, child_lines.join("\n")))
            else:
                i = i + 1
    out

# Locate a single top-level `<key>:` line's nested body within `body`, or ""
# when absent (no such key, or its value is empty/inline).
fn _plugin_manifest_extract_named_block(body: text, key: text) -> text:
    val target = key + ":"
    val lines = body.split("\n")
    var i = 0
    while i < lines.len() and lines[i].trim() == "":
        i = i + 1
    if i >= lines.len():
        return ""
    val base_indent = _plugin_manifest_indent(lines[i])
    var running = true
    while running and i < lines.len():
        val line = lines[i]
        if line.trim() == "":
            i = i + 1
        else:
            val ind = _plugin_manifest_indent(line)
            if ind < base_indent:
                running = false
            elif ind == base_indent and line.trim() == target:
                var child_lines: [text] = []
                i = i + 1
                while i < lines.len():
                    val cline = lines[i]
                    if cline.trim() == "":
                        child_lines.push("")
                        i = i + 1
                    else:
                        if _plugin_manifest_indent(cline) <= base_indent:
                            break
                        child_lines.push(cline)
                        i = i + 1
                return child_lines.join("\n")
            else:
                i = i + 1
    ""

fn _plugin_manifest_decode_method(method_name: text, body: text) -> PluginMethodEntry:
    val issues = SdnDecodeIssues.new()
    match sdn_parse(body):
        case Ok(v):
            val symbol = sdn_get_text(v, "symbol", issues) ?? ""
            val params = sdn_get_text_array(v, "params", issues) ?? []
            val return_type = sdn_get_text(v, "return", issues) ?? ""
            PluginMethodEntry(name: method_name, symbol: symbol, params: params, return_type: return_type)
        case Err(_):
            PluginMethodEntry(name: method_name, symbol: "", params: [], return_type: "")

fn _plugin_manifest_decode_methods(class_body: text) -> [PluginMethodEntry]:
    var methods: [PluginMethodEntry] = []
    val methods_block = _plugin_manifest_extract_named_block(class_body, "methods")
    if methods_block == "":
        return methods
    for pair in _plugin_manifest_named_blocks(methods_block):
        methods.push(_plugin_manifest_decode_method(pair.0, pair.1))
    methods

fn _plugin_manifest_decode_class(class_name: text, body: text) -> PluginClassEntry:
    val issues = SdnDecodeIssues.new()
    var constructor_symbol = ""
    var destructor_symbol = ""
    match sdn_parse(body):
        case Ok(v):
            constructor_symbol = sdn_get_text(v, "constructor", issues) ?? ""
            destructor_symbol = sdn_get_text(v, "destructor", issues) ?? ""
        case Err(_):
            true
    val methods = _plugin_manifest_decode_methods(body)
    PluginClassEntry(name: class_name, constructor_symbol: constructor_symbol, destructor_symbol: destructor_symbol, methods: methods)

fn _plugin_manifest_decode_classes(entry_body: text) -> [PluginClassEntry]:
    var classes: [PluginClassEntry] = []
    val classes_block = _plugin_manifest_extract_named_block(entry_body, "classes")
    if classes_block == "":
        return classes
    for pair in _plugin_manifest_named_blocks(classes_block):
        classes.push(_plugin_manifest_decode_class(pair.0, pair.1))
    classes

fn _plugin_manifest_decode_entry(body: text) -> PluginEntry:
    val issues = SdnDecodeIssues.new()
    match sdn_parse(body):
        case Ok(v):
            val name = sdn_get_text(v, "name", issues) ?? ""
            val library = sdn_get_text(v, "library", issues) ?? ""
            val version = sdn_get_text(v, "version", issues) ?? ""
            val functions = sdn_get_text_array(v, "functions", issues) ?? []
            val classes = _plugin_manifest_decode_classes(body)
            plugin_entry_new_with_classes(name: name, library: library, version: version, functions: functions, classes: classes)
        case Err(_):
            plugin_entry_new_with_classes(name: "", library: "", version: "", functions: [], classes: [])

fn parse_plugin_manifest_text(content: text) -> [PluginEntry]:
    if content.trim() == "":
        return []
    var entries: [PluginEntry] = []
    for block in _plugin_manifest_entry_blocks(content):
        val entry = _plugin_manifest_decode_entry(block)
        if entry.name != "":
            entries.push(entry)
    entries

fn load_plugin_manifest(path: text) -> [PluginEntry]:
    if not file_exists(path):
        return []
    val content = file_read(path: path) ?? ""
    parse_plugin_manifest_text(content)

fn functions_to_sdn(functions: [text]) -> text:
    if functions.len() == 0:
        return "[]"
    var rendered: [text] = []
    for function_name in functions:
        rendered.push(function_name)
    "[" + rendered.join(", ") + "]"

fn plugin_manifest_to_text(entries: [PluginEntry]) -> text:
    var lines: [text] = ["plugins:"]
    for entry in entries:
        lines.push("    -")
        lines.push("        name: " + entry.name)
        lines.push("        library: " + entry.library)
        if entry.version != "":
            lines.push("        version: \"" + entry.version + "\"")
        if entry.functions.len() > 0:
            lines.push("        functions: " + functions_to_sdn(entry.functions))
        if entry.classes.len() > 0:
            lines.push("        classes:")
            for cls in entry.classes:
                lines.push("            " + cls.name + ":")
                lines.push("                constructor: " + cls.constructor_symbol)
                lines.push("                destructor: " + cls.destructor_symbol)
                if cls.methods.len() > 0:
                    lines.push("                methods:")
                    for method in cls.methods:
                        lines.push("                    " + method.name + ":")
                        lines.push("                        symbol: " + method.symbol)
                        lines.push("                        params: " + functions_to_sdn(method.params))
                        lines.push("                        return: " + method.return_type)
    lines.join("\n") + "\n"

fn validate_unique_symbols(entries: [PluginEntry]) -> text:
    var seen: Dict<text, text> = {}
    for entry in entries:
        for function_name in entry.functions:
            if seen.contains(function_name):
                return "duplicate extern symbol '" + function_name + "' in plugins '" + seen[function_name] + "' and '" + entry.name + "'"
            seen[function_name] = entry.name
        for cls in entry.classes:
            if cls.constructor_symbol != "":
                if seen.contains(cls.constructor_symbol):
                    return "duplicate extern symbol '" + cls.constructor_symbol + "' in plugins '" + seen[cls.constructor_symbol] + "' and '" + entry.name + "'"
                seen[cls.constructor_symbol] = entry.name
            if cls.destructor_symbol != "":
                if seen.contains(cls.destructor_symbol):
                    return "duplicate extern symbol '" + cls.destructor_symbol + "' in plugins '" + seen[cls.destructor_symbol] + "' and '" + entry.name + "'"
                seen[cls.destructor_symbol] = entry.name
            for method in cls.methods:
                if method.symbol != "":
                    if seen.contains(method.symbol):
                        return "duplicate extern symbol '" + method.symbol + "' in plugins '" + seen[method.symbol] + "' and '" + entry.name + "'"
                    seen[method.symbol] = entry.name
    ""

fn save_plugin_manifest(path: text, entries: [PluginEntry]) -> bool:
    val duplicate_error = validate_unique_symbols(entries)
    if duplicate_error != "":
        print duplicate_error
        return false
    val last_slash = path.rfind("/")
    if last_slash > 0:
        val dir_path = path.substring(0, last_slash)
        if not dir_create_all(dir_path):
            return false
    file_write(path: path, content: plugin_manifest_to_text(entries))

fn merge_plugin_entries(existing: [PluginEntry], incoming: [PluginEntry]) -> [PluginEntry]:
    var merged = existing
    for new_entry in incoming:
        var replaced = false
        var i = 0
        while i < merged.len():
            if merged[i].name == new_entry.name:
                merged[i] = new_entry
                replaced = true
            i = i + 1
        if not replaced:
            merged.push(new_entry)
    merged

fn remove_plugin_entry(entries: [PluginEntry], name: text) -> [PluginEntry]:
    var filtered: [PluginEntry] = []
    for entry in entries:
        if entry.name != name:
            filtered.push(entry)
    filtered

fn find_plugin_entry(entries: [PluginEntry], name: text) -> PluginEntry?:
    for entry in entries:
        if entry.name == name:
            return entry
    nil
