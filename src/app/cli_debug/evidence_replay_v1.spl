# Semantic replay/reproduction for a verified Debug Evidence Bundle V1.
#
# This adapter reuses SemanticReplayBackend and the central service. It never
# executes source from a bundle and never represents replay as fixing the
# originating defect.

use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugRootOperationV1, DebugPerturbationV1,
    debug_policy_development_v1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_authorize,
    central_debug_service_v1_record_outcome, central_debug_service_v1_close,
}
use std.nogc_sync_mut.io_runtime.{file_exists, file_read, file_hash_sha256}
use app.cli_debug.evidence_inspect_v1.{decode_debug_evidence_manifest_summary_v1}
use app.debug.replay.semantic_backend.{SemanticReplayBackend}

pub struct DebugReplayArtifactV1:
    path: text
    digest: text
    media_type: text

pub struct DebugEvidenceReplayResultV1:
    mode: text
    session_id: DebugSessionId
    build_id: text
    trace_path: text
    event_count: i64
    deterministic: bool
    original_defect_fixed: bool
    receipt_id: text

fn _manifest_value_v1(line: text, prefix: text) -> text:
    if not line.starts_with(prefix): return ""
    val value = line.substring(prefix.len(), line.len()).trim()
    if value.len() >= 2 and value.starts_with("\"") and value.ends_with("\""):
        return value.substring(1, value.len() - 1)
    value

fn _safe_replay_path_v1(path: text) -> bool:
    if path.trim() == "" or path.starts_with("/") or path.contains("\\"):
        return false
    for part in path.split("/"):
        if part == "" or part == "." or part == "..": return false
    for ch in path:
        val ascii_alphanumeric = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9")
        if not (ascii_alphanumeric or ch == "/" or ch == "." or ch == "_" or ch == "-"):
            return false
    true

pub fn decode_semantic_replay_artifact_v1(source: text) -> Result<DebugReplayArtifactV1, text>:
    var path = ""
    var digest = ""
    var media_type = ""
    var matches = 0
    var candidate_path = ""
    var candidate_digest = ""
    var candidate_media = ""
    for raw in source.split("\n"):
        val line = raw.trim()
        if line.starts_with("- path:"):
            if candidate_path != "" and (candidate_media == "application/vnd.simple.semantic-trace" or candidate_path.ends_with(".sst")):
                path = candidate_path
                digest = candidate_digest
                media_type = candidate_media
                matches = matches + 1
            candidate_path = _manifest_value_v1(line, "- path:")
            candidate_digest = ""
            candidate_media = ""
        elif line.starts_with("digest:"):
            candidate_digest = _manifest_value_v1(line, "digest:")
        elif line.starts_with("media_type:"):
            candidate_media = _manifest_value_v1(line, "media_type:")
    if candidate_path != "" and (candidate_media == "application/vnd.simple.semantic-trace" or candidate_path.ends_with(".sst")):
        path = candidate_path
        digest = candidate_digest
        media_type = candidate_media
        matches = matches + 1
    if matches == 0: return Err("evidence bundle has no semantic replay trace")
    if matches != 1: return Err("evidence bundle must contain exactly one semantic replay trace")
    if not _safe_replay_path_v1(path): return Err("semantic replay trace path is unsafe")
    if not digest.starts_with("sha256:") or not sha256_lower_hex_valid(digest.substring(7, digest.len())):
        return Err("semantic replay trace lacks an exact digest")
    Ok(DebugReplayArtifactV1(path: path, digest: digest, media_type: media_type))

pub fn execute_debug_evidence_semantic_v1(bundle_root: text, mode: text) -> Result<DebugEvidenceReplayResultV1, text>:
    if mode != "replay" and mode != "reproduce": return Err("unsupported semantic evidence mode")
    val manifest_path = bundle_root + "/manifest.sdn"
    if not file_exists(manifest_path): return Err("evidence bundle manifest not found: " + manifest_path)
    val manifest_source = file_read(manifest_path)
    val summary = decode_debug_evidence_manifest_summary_v1(manifest_source)?
    val artifact = decode_semantic_replay_artifact_v1(manifest_source)?
    val trace_path = bundle_root + "/" + artifact.path
    if not file_exists(trace_path): return Err("semantic replay trace is unavailable")
    if "sha256:" + file_hash_sha256(trace_path) != artifact.digest:
        return Err("semantic replay trace digest mismatch")

    val session_id = central_debug_service_v1_open(summary.build_id, debug_policy_development_v1())?
    val authorization = central_debug_service_v1_authorize(
        session_id, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative,
        "cli.evidence." + mode,
    )
    if not authorization.allowed:
        central_debug_service_v1_close(session_id)
        return Err(authorization.reason)
    var backend = SemanticReplayBackend.create(trace_path)
    match backend.attach("", []):
        case Err(reason):
            central_debug_service_v1_record_outcome(session_id,
                DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative,
                "cli.evidence." + mode + ".outcome", false, false, reason)
            central_debug_service_v1_close(session_id)
            return Err(reason)
        case Ok(_): ()
    val event_count = backend.event_count()
    match backend.run():
        case Err(reason):
            backend.detach()
            central_debug_service_v1_record_outcome(session_id,
                DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative,
                "cli.evidence." + mode + ".outcome", false, false, reason)
            central_debug_service_v1_close(session_id)
            return Err(reason)
        case Ok(_): ()
    backend.detach()?
    val outcome = central_debug_service_v1_record_outcome(session_id,
        DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative,
        "cli.evidence." + mode + ".outcome", true, false,
        "semantic trace completed; original defect status unchanged")
    val result = DebugEvidenceReplayResultV1(
        mode: mode, session_id: session_id, build_id: summary.build_id,
        trace_path: artifact.path, event_count: event_count,
        deterministic: true, original_defect_fixed: false,
        receipt_id: outcome.receipt_id,
    )
    central_debug_service_v1_close(session_id)?
    Ok(result)
