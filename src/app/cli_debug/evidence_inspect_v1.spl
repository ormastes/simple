# Offline evidence inspection for the minimal debug CLI.
#
# The bundle supplies its exact build identity.  Inspection opens a central,
# observe-only DebugServiceV1 session and records the action there; callers do
# not invent a session identifier or claim that replay occurred.

use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugRootOperationV1, DebugPerturbationV1,
}
use std.common.debug.service_v1.{
    debug_policy_observe_only_v1,
    central_debug_service_v1_open, central_debug_service_v1_authorize,
    central_debug_service_v1_record, central_debug_service_v1_close,
}
use std.io_runtime.{file_exists, file_hash_sha256, file_read}

pub struct DebugEvidenceInspectionV1:
    bundle_root: text
    session_id: DebugSessionId
    captured_session_id: text
    build_id: text
    captured_at_ns: i64
    artifact_count: i64
    receipt_id: text

pub struct DebugEvidenceManifestSummaryV1:
    captured_session_id: text
    build_id: text
    captured_at_ns: i64
    artifact_count: i64

struct DebugEvidenceManifestIntegrityV1:
    artifact_paths: [text]
    artifact_digests: [text]
    receipts_digest: text

fn _quoted_manifest_value_v1(line: text, prefix: text) -> text:
    if not line.starts_with(prefix): return ""
    val value = line.substring(prefix.len(), line.len()).trim()
    if value.len() < 2 or not value.starts_with("\"") or not value.ends_with("\""):
        return ""
    value.substring(1, value.len() - 1)

fn _safe_artifact_path_v1(path: text) -> bool:
    if path == "" or path.starts_with("/") or path.starts_with("\\"):
        return false
    if path.contains("\\") or path.contains("//") or path.contains("\u0000"):
        return false
    for part in path.split("/"):
        if part == "" or part == "." or part == "..": return false
    true

fn _manifest_integrity_v1(source: text) -> Result<DebugEvidenceManifestIntegrityV1, text>:
    var paths: [text] = []
    var digests: [text] = []
    var receipts_digest = ""
    var awaiting_digest = false
    for raw_line in source.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("- path:"):
            if awaiting_digest: return Err("evidence artifact is missing an exact digest")
            val path = _quoted_manifest_value_v1(line, "- path:")
            if not _safe_artifact_path_v1(path): return Err("evidence artifact path is unsafe")
            for existing in paths:
                if existing == path: return Err("duplicate evidence artifact path")
            paths.push(path)
            awaiting_digest = true
        elif awaiting_digest and line.starts_with("digest:"):
            val digest = _quoted_manifest_value_v1(line, "digest:")
            if not digest.starts_with("sha256:") or not sha256_lower_hex_valid(digest.substring(7, digest.len())):
                return Err("evidence artifact is missing an exact digest")
            digests.push(digest.substring(7, digest.len()))
            awaiting_digest = false
        elif line.starts_with("receipts_digest:"):
            receipts_digest = _quoted_manifest_value_v1(line, "receipts_digest:")
    if awaiting_digest or paths.len() != digests.len():
        return Err("evidence artifact is missing an exact digest")
    if not receipts_digest.starts_with("sha256:") or not sha256_lower_hex_valid(receipts_digest.substring(7, receipts_digest.len())):
        return Err("evidence manifest is missing an exact receipts digest")
    Ok(DebugEvidenceManifestIntegrityV1(
        artifact_paths: paths,
        artifact_digests: digests,
        receipts_digest: receipts_digest.substring(7, receipts_digest.len()),
    ))

fn _verify_bundle_integrity_v1(bundle_root: text, source: text) -> Result<Nil, text>:
    val integrity = _manifest_integrity_v1(source)?
    var i = 0
    while i < integrity.artifact_paths.len():
        val artifact = bundle_root + "/" + integrity.artifact_paths[i]
        if not file_exists(artifact): return Err("evidence artifact is unavailable: " + integrity.artifact_paths[i])
        if file_hash_sha256(artifact) != integrity.artifact_digests[i]:
            return Err("evidence artifact digest mismatch: " + integrity.artifact_paths[i])
        i = i + 1
    val receipts = bundle_root + "/receipts.sdn"
    if not file_exists(receipts): return Err("evidence receipts are unavailable")
    if file_hash_sha256(receipts) != integrity.receipts_digest:
        return Err("evidence receipts digest mismatch")
    Ok(nil)

pub fn decode_debug_evidence_manifest_summary_v1(source: text) -> Result<DebugEvidenceManifestSummaryV1, text>:
    var schema = ""
    var captured_session_id = ""
    var build_id = ""
    var captured_at: Option<i64> = None
    var artifact_count = 0
    for raw_line in source.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("schema:"):
            schema = line.substring(7, line.len()).trim()
        elif line.starts_with("session_id:"):
            captured_session_id = _quoted_manifest_value_v1(line, "session_id:")
        elif line.starts_with("build_id:"):
            build_id = _quoted_manifest_value_v1(line, "build_id:")
        elif line.starts_with("captured_at_ns:"):
            captured_at = line.substring(15, line.len()).trim().to_i64()
        elif line.starts_with("- path:"):
            artifact_count = artifact_count + 1
    if schema != "debug-evidence-bundle-v1":
        return Err("unsupported or missing evidence bundle schema")
    if captured_session_id == "":
        return Err("evidence manifest is missing captured session identity")
    if not build_id.starts_with("sha256:") or not sha256_lower_hex_valid(build_id.substring(7, build_id.len())):
        return Err("evidence manifest is missing an exact build id")
    if captured_at == nil or (captured_at ?? -1) < 0:
        return Err("evidence manifest has an invalid capture time")
    Ok(DebugEvidenceManifestSummaryV1(
        captured_session_id: captured_session_id,
        build_id: build_id,
        captured_at_ns: captured_at ?? -1,
        artifact_count: artifact_count,
    ))

pub fn inspect_debug_evidence_bundle_v1(bundle_root: text) -> Result<DebugEvidenceInspectionV1, text>:
    if bundle_root.trim() == "": return Err("evidence bundle path is empty")
    val manifest_path = bundle_root + "/manifest.sdn"
    if not file_exists(manifest_path): return Err("evidence bundle manifest not found: " + manifest_path)
    val manifest = file_read(manifest_path) ?? ""
    val summary = decode_debug_evidence_manifest_summary_v1(manifest)?
    _verify_bundle_integrity_v1(bundle_root, manifest)?
    val session_id = central_debug_service_v1_open(summary.build_id, debug_policy_observe_only_v1())?
    val receipt = central_debug_service_v1_authorize(
        session_id, DebugRootOperationV1.Evidence, DebugPerturbationV1.Passive,
        "cli.evidence.inspect")
    if not receipt.allowed:
        central_debug_service_v1_close(session_id)
        return Err(receipt.reason)
    val outcome = central_debug_service_v1_record(
        session_id, DebugRootOperationV1.Evidence, DebugPerturbationV1.Passive,
        "cli.evidence.inspect.outcome", true, false, "")
    val inspection = DebugEvidenceInspectionV1(
        bundle_root: bundle_root,
        session_id: session_id,
        captured_session_id: summary.captured_session_id,
        build_id: summary.build_id,
        captured_at_ns: summary.captured_at_ns,
        artifact_count: summary.artifact_count,
        receipt_id: outcome.receipt_id,
    )
    central_debug_service_v1_close(session_id)?
    Ok(inspection)

export DebugEvidenceInspectionV1, DebugEvidenceManifestSummaryV1
export decode_debug_evidence_manifest_summary_v1, inspect_debug_evidence_bundle_v1
