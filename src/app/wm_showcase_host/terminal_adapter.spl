# Host adapter: Simple Terminal render adapter for wm_showcase's "terminal"
# window.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# app.terminal.render_adapter import below is legal here.
# render_terminal_html is a pure function over the shared app.ui.render.types
# contract (terminal chrome + subcommand reference; no I/O, no mutable
# state), so a facade re-export is the correct boundary, same as
# wm_compare_host's wave 2 facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use app.terminal.render_adapter.{render_terminal_html}
