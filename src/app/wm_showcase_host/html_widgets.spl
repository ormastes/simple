# Host adapter: HTML widget-tree renderer for wm_showcase's GUI window.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# app.ui.render.html_widgets import below is legal here. render_html_tree is
# a pure function (WidgetNode + UIState -> text; no I/O, no mutable state),
# so a facade re-export is the correct boundary, same as
# wm_compare_host/html_widgets.spl's identical re-export.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use app.ui.render.html_widgets.{render_html_tree}
