# Host adapter: shared ui.render contract type for wm_showcase's Simple
# Browser and Simple Terminal windows.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# app.ui.render.types import below is legal here. RenderConfig is a plain
# value type (no I/O, no mutable state) ~20 sibling apps already construct
# and pass to their render adapters, so a facade re-export is the correct
# boundary, same as wm_compare_host's wave 2 facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use app.ui.render.types.{RenderConfig}
