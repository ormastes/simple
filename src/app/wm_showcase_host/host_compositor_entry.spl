# Host adapter: HostCompositor constructor/session for wm_showcase's five
# real showcase windows.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.host_compositor_entry import below is legal here. wm_showcase
# owns the WM session itself (compositor + window lifecycle) by design (see
# the header comment in src/app/wm_showcase/session.spl) -- HostCompositor is
# the sanctioned WM session type, not an incidental host reach, so a facade
# re-export is the correct boundary, same as wm_compare_host's wave 2
# facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.compositor.host_compositor_entry.{HostCompositor}
