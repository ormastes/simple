use app.spec_to_spipe.verify.contracts.*

fn verify_no_silent_recovery(recoveries: [RecoveryRecord], strict: bool,
        approved_rule_ids: [text]) -> SpecVerificationResult:
    var rules: [text] = []
    var messages: [text] = []
    var index: i64 = 0
    for recovery in recoveries:
        if recovery.start_byte < 0 or recovery.end_byte <= recovery.start_byte:
            rules.push("SPEC-REC-001")
            messages.push("recovery {index} has an invalid raw source span")
        if recovery.raw_source.len() == 0:
            rules.push("SPEC-REC-002")
            messages.push("recovery {index} does not preserve raw source")
        if recovery.adapter_rule_id.trim().len() == 0:
            rules.push("SPEC-REC-003")
            messages.push("recovery {index} has no adapter rule ID")
        if not recovery.diagnostic_emitted:
            rules.push("SPEC-REC-004")
            messages.push("recovery {index} did not emit a diagnostic")
        if recovery.nested_error_count < 0:
            rules.push("SPEC-REC-005")
            messages.push("recovery {index} has an invalid nested error count")
        if strict:
            rules.push("SPEC-REC-006")
            messages.push("strict mode rejects recovery {index}")
        elif not approved_rule_ids.contains(recovery.adapter_rule_id):
            rules.push("SPEC-REC-007")
            messages.push("recovery {index} is not approved by the compatibility manifest")
        index = index + 1
    verification_result(rules, messages)
