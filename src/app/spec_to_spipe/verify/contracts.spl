# Provisional Phase 0 verifier inputs. These remain deliberately separate until
# A0 freezes ErrorNode and ledger adapters; Phase 0 is not complete before that
# integration, and adapters must not consume these records directly.

struct SourceDispositionSpan:
    start_byte: i64
    end_byte: i64
    disposition: text
    reason: text

struct RecoveryRecord:
    start_byte: i64
    end_byte: i64
    raw_source: text
    adapter_rule_id: text
    diagnostic_emitted: bool
    nested_error_count: i64

struct VerificationManifestIdentity:
    schema_version: text
    standard_family: text
    published_version: text
    edition: text
    source_uri: text
    source_revision: text
    source_sha256: text
    adapter_version: text
    preprocess_rule_set_version: text

struct SpecVerificationResult:
    accepted: bool
    rule_ids: [text]
    messages: [text]

fn verification_result(rule_ids: [text], messages: [text]) -> SpecVerificationResult:
    SpecVerificationResult(accepted: rule_ids.len() == 0,
        rule_ids: rule_ids, messages: messages)
