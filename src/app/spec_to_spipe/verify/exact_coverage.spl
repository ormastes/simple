use app.spec_to_spipe.verify.contracts.*
use app.spec_to_spipe.model.{SpecDisposition, SpecLedgerEntry}

fn _requires_reason(value: SpecDisposition) -> bool:
    match value:
        case SpecDisposition.Preprocessed: true
        case SpecDisposition.Skipped: true
        case SpecDisposition.Blocked: true
        case SpecDisposition.Unsupported: true
        case SpecDisposition.Ignored: true
        case SpecDisposition.Malformed: true
        case SpecDisposition.LicenseRestricted: true
        case _: false

# The input ledger is canonical source order. Rejecting out-of-order entries
# avoids an implicit sort that could hide overlaps or make diagnostics unstable.
fn verify_exact_coverage(total_bytes: i64, spans: [SpecLedgerEntry]) -> SpecVerificationResult:
    var rules: [text] = []
    var messages: [text] = []
    if total_bytes < 0:
        rules.push("SPEC-COV-001")
        messages.push("total source byte count must not be negative")
        return verification_result(rules, messages)

    var covered_until: i64 = 0
    var index: i64 = 0
    for span in spans:
        val start_byte = span.source_span.byte_start
        val end_byte = span.source_span.byte_end
        if start_byte < 0 or end_byte > total_bytes or end_byte <= start_byte:
            rules.push("SPEC-COV-002")
            messages.push("span {index} is outside the source or has zero width")
        elif start_byte < covered_until:
            rules.push("SPEC-COV-003")
            messages.push("span {index} overlaps or is out of source order")
        elif start_byte > covered_until:
            rules.push("SPEC-COV-004")
            messages.push("bytes {covered_until}..{start_byte} have no disposition")

        if _requires_reason(span.disposition) and span.reason.trim().len() == 0:
            rules.push("SPEC-COV-006")
            messages.push("span {index} has no reason for its exceptional disposition")

        if end_byte > covered_until:
            covered_until = end_byte
        index = index + 1

    if covered_until < total_bytes:
        rules.push("SPEC-COV-004")
        messages.push("bytes {covered_until}..{total_bytes} have no disposition")
    verification_result(rules, messages)
