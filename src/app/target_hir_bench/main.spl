# P7 TargetHIR fan-out bench workload (PERF-TH-01). Prints one counters line
# per fan-out width; scripts/bench/target_hir_bench.shs captures wall/RSS.
use compiler.hir.hir_types.{HirModule, SymbolTable}
use compiler.hir.target_hir.target_hir_counters.{target_hir_bench_fanout, target_hir_counters_text}

fn bench_module() -> HirModule:
    HirModule(name: "bench.target_hir", path: "bench.spl", imports: [], exports: [],
        domain_blocks: [], symbols: SymbolTable.new(), functions: {},
        gpu_function_targets: {}, gpu_function_backend_orders: {}, classes: {},
        structs: {}, enums: {}, bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [], arch_rules: [],
        mock_decls: [], types: [], extend_enums: [])

fn main() -> i64:
    val all = ["x86_64-unknown-linux-gnu", "aarch64-apple-darwin", "x86-unknown-linux-gnu",
        "riscv64-unknown-linux-gnu", "x86_64-pc-windows-msvc", "aarch64-unknown-linux-gnu",
        "x86-pc-windows-msvc", "riscv32-unknown-none-elf"]
    var rc = 0
    for n in [1, 2, 4, 8]:
        var ts: [text] = []
        var i = 0
        while i < n:
            ts.push(all[i])
            i = i + 1
        val c = target_hir_bench_fanout(bench_module(), ts, ["i64", "usize", "bool", "f64"])
        if c.is_err():
            print "TARGET_HIR_BENCH targets={n} ERROR {c.unwrap_err()}"
            rc = 1
        else:
            print "TARGET_HIR_BENCH targets={n} " + target_hir_counters_text(c.unwrap())
    rc
