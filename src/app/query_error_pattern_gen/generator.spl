use app.query_error_pattern_gen.patterns.{QueryErrorPatternSpec, query_error_pattern_specs}

# u64 bit masks as literals. The bootstrap seed interpreter mis-evaluates
# `1u64 << 63` and mis-formats `{:x}` for values with the top bit set, so
# generated tables take masks and hex text from constants/shifts that are
# correct on every runtime (identical output on the pure-Simple binary).
fn query_error_gen_bit_mask(bit: i64) -> u64:
    [
        0x0000000000000001u64, 0x0000000000000002u64,
        0x0000000000000004u64, 0x0000000000000008u64,
        0x0000000000000010u64, 0x0000000000000020u64,
        0x0000000000000040u64, 0x0000000000000080u64,
        0x0000000000000100u64, 0x0000000000000200u64,
        0x0000000000000400u64, 0x0000000000000800u64,
        0x0000000000001000u64, 0x0000000000002000u64,
        0x0000000000004000u64, 0x0000000000008000u64,
        0x0000000000010000u64, 0x0000000000020000u64,
        0x0000000000040000u64, 0x0000000000080000u64,
        0x0000000000100000u64, 0x0000000000200000u64,
        0x0000000000400000u64, 0x0000000000800000u64,
        0x0000000001000000u64, 0x0000000002000000u64,
        0x0000000004000000u64, 0x0000000008000000u64,
        0x0000000010000000u64, 0x0000000020000000u64,
        0x0000000040000000u64, 0x0000000080000000u64,
        0x0000000100000000u64, 0x0000000200000000u64,
        0x0000000400000000u64, 0x0000000800000000u64,
        0x0000001000000000u64, 0x0000002000000000u64,
        0x0000004000000000u64, 0x0000008000000000u64,
        0x0000010000000000u64, 0x0000020000000000u64,
        0x0000040000000000u64, 0x0000080000000000u64,
        0x0000100000000000u64, 0x0000200000000000u64,
        0x0000400000000000u64, 0x0000800000000000u64,
        0x0001000000000000u64, 0x0002000000000000u64,
        0x0004000000000000u64, 0x0008000000000000u64,
        0x0010000000000000u64, 0x0020000000000000u64,
        0x0040000000000000u64, 0x0080000000000000u64,
        0x0100000000000000u64, 0x0200000000000000u64,
        0x0400000000000000u64, 0x0800000000000000u64,
        0x1000000000000000u64, 0x2000000000000000u64,
        0x4000000000000000u64, 0x8000000000000000u64
    ][bit]

# Lowercase hex for a u64 without relying on `{:x}`. `width` <= 0 means
# minimal width (no leading zero nibbles); otherwise zero-pad to that many
# digits. Seed-safe: only shift-right, bitwise-and, and text concatenation.
fn query_error_gen_u64_hex(value: u64, width: i64) -> text:
    val digits = "0123456789abcdef"
    var top = 15
    if width > 0:
        top = width - 1
    else:
        while top > 0:
            if ((value >> (top * 4).to_u64()) & 0xFu64) != 0u64:
                break
            top = top - 1
    var out = ""
    var k = top
    while k >= 0:
        val nibble = ((value >> (k * 4).to_u64()) & 0xFu64).to_i64()
        out = out + digits.substring(nibble, nibble + 1)
        k = k - 1
    out

# Build-only limits. Runtime storage uses two u64 masks and u16 table indexes.
struct QueryErrorGeneratorLimits:
    max_patterns: i64
    max_states: i64
    max_edges: i64

fn query_error_generator_limits() -> QueryErrorGeneratorLimits:
    QueryErrorGeneratorLimits(max_patterns: 128, max_states: 65535, max_edges: 65535)

struct QueryErrorGeneratedModel:
    root_next: [i64]
    edge_start: [i64]
    edge_byte: [i64]
    edge_next: [i64]
    fail: [i64]
    output_index: [i64]
    output_lo: [u64]
    output_hi: [u64]

fn query_error_pattern_build_default() -> Result<QueryErrorGeneratedModel, text>:
    query_error_pattern_build(query_error_pattern_specs(), query_error_generator_limits())

# Build a deterministic sparse Aho-Corasick model without iterating Dict order.
# Complexity is O(pattern bytes + 128 * states + states * unique masks).
fn query_error_pattern_build(
    specs: [QueryErrorPatternSpec],
    limits: QueryErrorGeneratorLimits
) -> Result<QueryErrorGeneratedModel, text>:
    if specs.len() == 0:
        return Err("query error matcher requires at least one pattern")
    if specs.len() > limits.max_patterns or specs.len() > 128:
        return Err("query error matcher pattern limit exceeded")
    if limits.max_states < 1 or limits.max_states > 65535:
        return Err("query error matcher state limit is invalid")
    if limits.max_edges < 0 or limits.max_edges > 65535:
        return Err("query error matcher edge limit is invalid")

    var transitions: Dict<i64, i64> = {}
    var transition_count = 0
    var fail: [i64] = [0]
    var direct_lo: [u64] = [0u64]
    var direct_hi: [u64] = [0u64]

    var pattern_index = 0
    while pattern_index < specs.len():
        val spec = specs[pattern_index]
        if spec.id != pattern_index:
            return Err("query error matcher IDs must be contiguous and ordered")
        if spec.literal.len() == 0:
            return Err("query error matcher literals must not be empty")

        var state = 0
        var offset = 0
        while offset < spec.literal.len():
            val byte = spec.literal.byte_at(offset)
            if byte < 0 or byte >= 128:
                return Err("query error matcher literals must be ASCII")
            val key = state * 128 + byte
            if transitions.contains_key(key):
                state = transitions[key]
            else:
                val next_state = fail.len()
                if next_state >= limits.max_states:
                    return Err("query error matcher state limit exceeded")
                if transition_count >= limits.max_edges:
                    return Err("query error matcher edge limit exceeded")
                transitions[key] = next_state
                transition_count = transition_count + 1
                fail.push(0)
                direct_lo.push(0u64)
                direct_hi.push(0u64)
                state = next_state
            offset = offset + 1

        if spec.id < 64:
            direct_lo[state] = direct_lo[state] | query_error_gen_bit_mask(spec.id)
        else:
            direct_hi[state] = direct_hi[state] | query_error_gen_bit_mask(spec.id - 64)
        pattern_index = pattern_index + 1

    var root_next: [i64] = []
    var byte = 0
    while byte < 128:
        val key = byte
        if transitions.contains_key(key):
            root_next.push(transitions[key])
        else:
            root_next.push(0)
        byte = byte + 1

    var edge_start: [i64] = [0]
    var edge_byte: [i64] = []
    var edge_next: [i64] = []
    var state = 0
    while state < fail.len():
        byte = 0
        while byte < 128:
            val key = state * 128 + byte
            if transitions.contains_key(key):
                edge_byte.push(byte)
                edge_next.push(transitions[key])
            byte = byte + 1
        edge_start.push(edge_byte.len())
        state = state + 1

    var queue: [i64] = []
    byte = 0
    while byte < 128:
        val child = root_next[byte]
        if child != 0:
            queue.push(child)
        byte = byte + 1

    var cursor = 0
    while cursor < queue.len():
        state = queue[cursor]
        var edge = edge_start[state]
        while edge < edge_start[state + 1]:
            byte = edge_byte[edge]
            val child = edge_next[edge]
            var fallback = fail[state]
            var fallback_key = fallback * 128 + byte
            while fallback != 0 and not transitions.contains_key(fallback_key):
                fallback = fail[fallback]
                fallback_key = fallback * 128 + byte
            if transitions.contains_key(fallback_key):
                fail[child] = transitions[fallback_key]
            else:
                fail[child] = 0
            direct_lo[child] = direct_lo[child] | direct_lo[fail[child]]
            direct_hi[child] = direct_hi[child] | direct_hi[fail[child]]
            queue.push(child)
            edge = edge + 1
        cursor = cursor + 1

    var output_lo: [u64] = [0u64]
    var output_hi: [u64] = [0u64]
    var output_index: [i64] = []
    state = 0
    while state < fail.len():
        var found = -1
        var output = 0
        while output < output_lo.len() and found < 0:
            if output_lo[output] == direct_lo[state] and output_hi[output] == direct_hi[state]:
                found = output
            output = output + 1
        if found < 0:
            found = output_lo.len()
            output_lo.push(direct_lo[state])
            output_hi.push(direct_hi[state])
        output_index.push(found)
        state = state + 1

    Ok(QueryErrorGeneratedModel(
        root_next: root_next,
        edge_start: edge_start,
        edge_byte: edge_byte,
        edge_next: edge_next,
        fail: fail,
        output_index: output_index,
        output_lo: output_lo,
        output_hi: output_hi
    ))
