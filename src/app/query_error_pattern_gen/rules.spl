fn query_error_fallback_specs() -> [QueryErrorFallbackSpec]:
    [
        QueryErrorFallbackSpec(error_kind: "TypeError", error_code: "E1003"),
        QueryErrorFallbackSpec(error_kind: "ParseError", error_code: "E0001"),
        QueryErrorFallbackSpec(error_kind: "BlockError", error_code: "E1601"),
        QueryErrorFallbackSpec(error_kind: "ResolveError", error_code: "E1013"),
        QueryErrorFallbackSpec(error_kind: "BorrowError", error_code: "E1303"),
        QueryErrorFallbackSpec(error_kind: "CodegenError", error_code: "E2001"),
        QueryErrorFallbackSpec(error_kind: "RuntimeError", error_code: "E3001")
    ]

fn query_error_default_fallback_code() -> text:
    "E0000"
