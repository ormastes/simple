# Canonical ordered predicate manifest for query diagnostic error-code inference.
# Array order is runtime first-match priority; never sort or group these rows.

enum QueryErrorPredicateOp:
    Hit
    CallerCodegenPhrase
    Not
    And
    Or

struct QueryErrorPredicateToken:
    op: QueryErrorPredicateOp
    pattern_id: i64

struct QueryErrorRuleSpec:
    priority: i64
    heading: text
    predicate: [QueryErrorPredicateToken]
    error_code: text

struct QueryErrorFallbackSpec:
    error_kind: text
    error_code: text

fn _query_error_hit_token(pattern_id: i64) -> QueryErrorPredicateToken:
    QueryErrorPredicateToken(op: QueryErrorPredicateOp.Hit, pattern_id: pattern_id)

fn _query_error_op_token(op: QueryErrorPredicateOp) -> QueryErrorPredicateToken:
    QueryErrorPredicateToken(op: op, pattern_id: -1)

fn query_error_rule_specs() -> [QueryErrorRuleSpec]:
    [
        QueryErrorRuleSpec(priority: 0, heading: "Semantic errors (E10xx)", predicate: [_query_error_hit_token(0), _query_error_hit_token(1), _query_error_op_token(QueryErrorPredicateOp.Or), _query_error_hit_token(2), _query_error_op_token(QueryErrorPredicateOp.And)], error_code: "E1001"),
