# DebugServiceV1 bridge for mcpgdb's existing persisted sessions.
#
# The MCP server owns these bindings while the existing runner processes keep
# owning GDB/LLDB and FIFO transport.  This module never starts a debugger or
# creates a second command channel.

use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{
    DebugSessionId, DebugPolicyV1, DebugReceiptV1, DebugCapabilityV1,
    DebugVerificationV1, DebugPerturbationV1, DebugRootOperationV1,
    DebugTargetNodeV1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_open, central_debug_service_v1_add_target,
    central_debug_service_v1_authorize, central_debug_service_v1_record,
    central_debug_service_v1_close,
}

struct McpGdbDebugBindingV1:
    local_session_id: text
    resource_uri: text
    backend: text
    build_id: text
    debug_session_id: DebugSessionId

struct McpGdbDebugActionV1:
    managed: bool
    operation: DebugRootOperationV1
    perturbation: DebugPerturbationV1
    execution_changes_on_success: bool

fn mcpgdb_debug_action_v1(name: text, dangerous: bool) -> McpGdbDebugActionV1:
    mcpgdb_debug_action_for_rule_v1(name, dangerous, "read_only")

fn mcpgdb_debug_action_for_rule_v1(name: text, dangerous: bool, raw_rule_class: text) -> McpGdbDebugActionV1:
    # Inspection is passive even though the underlying debugger transport is
    # stateful.  Selecting a frame changes debugger context, not the debuggee.
    if name == "breakpoint_list" or name == "thread_list" or
            name == "frame_list" or name == "variable_list" or
            name == "register_read" or name == "memory_read":
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, false)
    if name == "frame_select":
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Inspect, DebugPerturbationV1.Cooperative, false)

    # Expression evaluation and target writes are potentially semantic.  Do
    # not infer purity from a successful debugger response.
    if name == "evaluate" or name == "register_write" or name == "memory_write":
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, true)
    if name == "debug_command_run":
        if dangerous:
            return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, true)
        if raw_rule_class == "read_only":
            return McpGdbDebugActionV1(true, DebugRootOperationV1.Inspect, DebugPerturbationV1.Passive, false)
        if raw_rule_class == "execution_control" or raw_rule_class == "session_topology":
            return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, true)
        if raw_rule_class == "target_mutation" or raw_rule_class == "shell_escape":
            return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, true)
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, false)

    if name == "breakpoint_set" or name == "breakpoint_remove":
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Cooperative, false)

    if name == "debug_launch" or name == "debug_attach" or
            name == "debug_connect_remote" or name == "debug_disconnect" or
            name == "debug_restart" or name == "debug_continue" or
            name == "debug_pause" or name == "debug_step_in" or
            name == "debug_step_over" or name == "debug_step_out" or
            name == "debug_session_close":
        return McpGdbDebugActionV1(true, DebugRootOperationV1.Control, DebugPerturbationV1.Stopping, true)

    McpGdbDebugActionV1(false, DebugRootOperationV1.Observe, DebugPerturbationV1.Passive, false)

var MCPGDB_DEBUG_BINDINGS_V1: [McpGdbDebugBindingV1] = []

fn mcpgdb_debug_binding_v1(local_session_id: text) -> Option<McpGdbDebugBindingV1>:
    for binding in MCPGDB_DEBUG_BINDINGS_V1:
        if binding.local_session_id == local_session_id:
            return Some(binding)
    None

fn mcpgdb_debug_bind_session_v1(local_session_id: text, backend: text, build_id: text, policy: DebugPolicyV1) -> Result<DebugSessionId, text>:
    if local_session_id.trim() == "":
        return Err("mcpgdb debug binding requires a local session ID")
    if build_id.trim() == "":
        return Err("mcpgdb debug binding requires a build identity")
    match mcpgdb_debug_binding_v1(local_session_id):
        case Some(existing):
            if existing.build_id == build_id:
                return Ok(existing.debug_session_id)
            central_debug_service_v1_close(existing.debug_session_id)?
            MCPGDB_DEBUG_BINDINGS_V1 = MCPGDB_DEBUG_BINDINGS_V1.filter(\item:
                item.local_session_id != local_session_id
            )
        case None: ()

    val debug_session_id = central_debug_service_v1_open(build_id, policy)?
    val resource_uri = "mcpgdb://session/" + local_session_id
    val target = DebugTargetNodeV1(
        target_id: resource_uri,
        parent_target_id: "",
        kind: "native." + backend,
        label: "mcpgdb " + local_session_id,
    )
    val capability = DebugCapabilityV1(
        target_id: resource_uri,
        support: CapLevel.Native,
        verification: DebugVerificationV1.Unverified,
        perturbation: DebugPerturbationV1.Stopping,
        reason: "bound to mcpgdb persisted session; live command outcome is receipted separately",
    )
    match central_debug_service_v1_add_target(debug_session_id, target, capability):
        case Err(reason):
            central_debug_service_v1_close(debug_session_id)
            return Err(reason)
        case Ok(_): ()
    MCPGDB_DEBUG_BINDINGS_V1.push(McpGdbDebugBindingV1(
        local_session_id: local_session_id,
        resource_uri: resource_uri,
        backend: backend,
        build_id: build_id,
        debug_session_id: debug_session_id,
    ))
    Ok(debug_session_id)

fn mcpgdb_debug_authorize_v1(local_session_id: text, action: text, perturbation: DebugPerturbationV1) -> Result<DebugReceiptV1, text>:
    mcpgdb_debug_authorize_operation_v1(local_session_id, DebugRootOperationV1.Control, action, perturbation)

fn mcpgdb_debug_authorize_operation_v1(local_session_id: text, operation: DebugRootOperationV1, action: text, perturbation: DebugPerturbationV1) -> Result<DebugReceiptV1, text>:
    match mcpgdb_debug_binding_v1(local_session_id):
        case None: Err("mcpgdb session is not bound to DebugServiceV1: " + local_session_id)
        case Some(binding):
            val receipt = central_debug_service_v1_authorize(
                binding.debug_session_id,
                operation,
                perturbation,
                "mcpgdb." + action,
            )
            if not receipt.allowed:
                return Err(receipt.reason)
            Ok(receipt)

fn mcpgdb_debug_record_outcome_v1(local_session_id: text, action: text, perturbation: DebugPerturbationV1, succeeded: bool, execution_changed: bool, reason: text) -> Result<DebugReceiptV1, text>:
    mcpgdb_debug_record_operation_outcome_v1(local_session_id, DebugRootOperationV1.Control, action, perturbation, succeeded, execution_changed, reason)

fn mcpgdb_debug_record_operation_outcome_v1(local_session_id: text, operation: DebugRootOperationV1, action: text, perturbation: DebugPerturbationV1, succeeded: bool, execution_changed: bool, reason: text) -> Result<DebugReceiptV1, text>:
    match mcpgdb_debug_binding_v1(local_session_id):
        case None: Err("mcpgdb session is not bound to DebugServiceV1: " + local_session_id)
        case Some(binding): Ok(central_debug_service_v1_record(
            binding.debug_session_id,
            operation,
            perturbation,
            "mcpgdb." + action + ".outcome",
            succeeded,
            execution_changed,
            reason,
        ))

fn mcpgdb_debug_unbind_session_v1(local_session_id: text) -> Result<Nil, text>:
    val binding = mcpgdb_debug_binding_v1(local_session_id)
    match binding:
        case None: return Err("mcpgdb debug binding not found: " + local_session_id)
        case Some(value): central_debug_service_v1_close(value.debug_session_id)?
    MCPGDB_DEBUG_BINDINGS_V1 = MCPGDB_DEBUG_BINDINGS_V1.filter(\item:
        item.local_session_id != local_session_id
    )
    Ok(nil)

fn mcpgdb_debug_reset_bindings_v1():
    MCPGDB_DEBUG_BINDINGS_V1 = []

export McpGdbDebugBindingV1, McpGdbDebugActionV1
export mcpgdb_debug_action_v1, mcpgdb_debug_action_for_rule_v1
export mcpgdb_debug_binding_v1, mcpgdb_debug_bind_session_v1
export mcpgdb_debug_authorize_v1, mcpgdb_debug_record_outcome_v1
export mcpgdb_debug_authorize_operation_v1, mcpgdb_debug_record_operation_outcome_v1
export mcpgdb_debug_unbind_session_v1, mcpgdb_debug_reset_bindings_v1
