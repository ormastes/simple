val DEBUG_RUNNER_SOURCE = "src/app/mcpgdb/debug_runner.spl"
val DEBUG_EXEC_RUNNER_SOURCE = "src/app/mcpgdb/debug_exec_runner.spl"
val DEBUG_SESSION_RUNNER_SOURCE = "src/app/mcpgdb/debug_session_runner.spl"
val DEBUG_STATE_RUNNER_SOURCE = "src/app/mcpgdb/debug_state_runner.spl"
val CLANGD_RUNNER_SOURCE = "src/app/mcpgdb/clangd_runner.spl"
val TOOL_NAME = "mcpgdb MCP Server"
val TOOL_VERSION = "0.1.0"

fn cleanup_all_sessions():
    load_persisted_state_safe()
    for session in MCPGDB_SESSIONS:
        stop_session_process(session)
    if MCPGDB_WORKSPACE.clangd_pid != "":
        stop_clangd_workspace()

# ---- Schema helpers ----

fn sp(name: text, description: text) -> text:
    jp(name, jo2(jp("type", js("string")), jp("description", js(description))))

fn ip(name: text, description: text) -> text:
    jp(name, jo2(jp("type", js("integer")), jp("description", js(description))))

fn bp(name: text, description: text) -> text:
    jp(name, jo2(jp("type", js("boolean")), jp("description", js(description))))

fn make_schema(props: text, required: text) -> text:
    LB()
        + jp("type", js("object"))
        + "," + jp("properties", LB() + props + RB())
        + "," + jp("required", required)
        + RB()

fn sid() -> text:
    sp("session_id", "Debug session ID; defaults to current session when omitted")

fn pos_props() -> text:
    sp("file", "Source file path")
        + "," + ip("line", "0-indexed line")
        + "," + ip("character", "0-indexed character offset")

# ---- Named schema builders (one per tool) ----

fn schema_workspace_open() -> text:
    make_schema(sp("root", "Workspace root; defaults to current working directory")
        + "," + sp("compile_commands_dir", "Directory containing compile_commands.json"), "[]")

fn schema_workspace_status() -> text:
    make_schema("", "[]")

fn schema_clangd_open() -> text:
    make_schema(sp("root", "Workspace root; defaults to current working directory")
        + "," + sp("compile_commands_dir", "Directory containing compile_commands.json"), "[]")

fn schema_debug_session_create() -> text:
    make_schema(sp("backend", "Backend kind: gdb, lldb, openocd_gdb, t32_gdb")
        + "," + sp("workspace_root", "Workspace root; defaults to current working directory"),
        "[\"backend\"]")

fn schema_debug_session_list() -> text:
    make_schema("", "[]")

fn schema_debug_session_select() -> text:
    make_schema(sid(), "[\"session_id\"]")

fn schema_debug_session_close() -> text:
    make_schema(sid(), "[\"session_id\"]")

fn schema_debug_launch() -> text:
    make_schema(sid()
        + "," + sp("program", "Path to executable")
        + "," + sp("args", "Optional command-line arguments")
        + "," + sp("build_id", "Exact build identity when known; omitted values remain explicitly unresolved"), "[\"program\"]")

fn schema_debug_attach() -> text:
    make_schema(sid() + "," + sp("pid", "PID to attach")
        + "," + sp("build_id", "Exact build identity when known; omitted values remain explicitly unresolved"), "[\"pid\"]")

fn schema_debug_connect_remote() -> text:
    make_schema(sid()
        + "," + sp("host", "Remote host")
        + "," + sp("port", "Remote port"), "[\"host\",\"port\"]")

fn schema_debug_disconnect() -> text:
    make_schema(sid(), "[]")

fn schema_debug_restart() -> text:
    make_schema(sid(), "[]")

fn schema_debug_continue() -> text:
    make_schema(sid(), "[]")

fn schema_debug_pause() -> text:
    make_schema(sid(), "[]")

fn schema_debug_step_in() -> text:
    make_schema(sid(), "[]")

fn schema_debug_step_over() -> text:
    make_schema(sid(), "[]")

fn schema_debug_step_out() -> text:
    make_schema(sid(), "[]")

fn schema_breakpoint_set() -> text:
    make_schema(sid()
        + "," + sp("file", "Source file")
        + "," + sp("line", "1-based source line")
        + "," + sp("symbol", "Function or symbol name"), "[]")

fn schema_breakpoint_remove() -> text:
    make_schema(sid() + "," + sp("breakpoint_id", "Debugger breakpoint id"),
        "[\"breakpoint_id\"]")

fn schema_breakpoint_list() -> text:
    make_schema(sid(), "[]")

fn schema_thread_list() -> text:
    make_schema(sid(), "[]")

fn schema_frame_list() -> text:
    make_schema(sid(), "[]")

fn schema_frame_select() -> text:
    make_schema(sid() + "," + sp("frame_id", "Frame id/index"), "[\"frame_id\"]")

fn schema_variable_list() -> text:
    make_schema(sid(), "[]")

fn schema_evaluate() -> text:
    make_schema(sid() + "," + sp("expression", "Expression to evaluate"), "[\"expression\"]")

fn schema_register_read() -> text:
    make_schema(sid() + "," + sp("name", "Register name; omit for all"), "[]")

fn schema_register_write() -> text:
    make_schema(sid()
        + "," + sp("name", "Register name")
        + "," + sp("value", "New value"), "[\"name\",\"value\"]")

fn schema_memory_read() -> text:
    make_schema(sid()
        + "," + sp("address", "Address expression")
        + "," + sp("count", "Element count; default 16")
        + "," + sp("format", "Display format; default x"), "[\"address\"]")

fn schema_memory_write() -> text:
    make_schema(sid()
        + "," + sp("address", "Address expression")
        + "," + sp("value", "New value"), "[\"address\",\"value\"]")

fn schema_debug_command_run() -> text:
    make_schema(sid()
        + "," + sp("command", "Debugger command text")
        + "," + bp("dangerous", "Set true to allow target mutation commands"), "[\"command\"]")

fn schema_pos() -> text:
    make_schema(pos_props(), "[\"file\",\"line\",\"character\"]")

fn schema_file_only() -> text:
    make_schema(sp("file", "Source file path"), "[\"file\"]")

# ---- Runner dispatch helpers ----

fn runner_source_for_name(name: text) -> text:
    if name == "debug_session_create" or name == "debug_session_close":
        return DEBUG_SESSION_RUNNER_SOURCE
    if name == "debug_command_run" or name == "debug_backend_probe":
        return DEBUG_EXEC_RUNNER_SOURCE
    if name == "workspace_open" or name == "workspace_status" or name == "debug_session_list" or name == "debug_session_select":
        return DEBUG_STATE_RUNNER_SOURCE
    if name == "clangd_open" or name == "clangd_definition" or name == "clangd_references" or name == "clangd_hover" or name == "clangd_completion" or name == "clangd_type_definition" or name == "clangd_symbols" or name == "clangd_diagnostics":
        return CLANGD_RUNNER_SOURCE
    DEBUG_RUNNER_SOURCE

fn mcpgdb_service_action_v1(name: text) -> bool:
    mcpgdb_debug_action_v1(name, false).managed

fn mcpgdb_service_action_detail_v1(name: text, args: text) -> McpGdbDebugActionV1:
    val dangerous_value = extract_nested(args, "dangerous").lower()
    val dangerous = dangerous_value == "true" or dangerous_value == "1" or dangerous_value == "yes"
    var raw_rule_class = "read_only"
    if name == "debug_command_run":
        var backend = "gdb"
        match current_or_named_session(extract_nested(args, "session_id")):
            case Some(active): backend = active.backend
            case None: ()
        raw_rule_class = classify_command(backend, extract_nested(args, "command"))
    mcpgdb_debug_action_for_rule_v1(name, dangerous, raw_rule_class)

fn mcpgdb_service_perturbation_v1(name: text, args: text) -> DebugPerturbationV1:
    mcpgdb_service_action_detail_v1(name, args).perturbation

fn mcpgdb_service_operation_v1(name: text, args: text) -> DebugRootOperationV1:
    mcpgdb_service_action_detail_v1(name, args).operation

fn mcpgdb_service_execution_changed_v1(name: text, args: text, succeeded: bool) -> bool:
    if not succeeded:
        return false
    mcpgdb_service_action_detail_v1(name, args).execution_changes_on_success

fn mcpgdb_service_prepare_v1(name: text, args: text) -> Result<text, text>:
    load_persisted_state_safe()
    val requested_id = extract_nested(args, "session_id")
    val session = current_or_named_session(requested_id)
    match session:
        case None: return Err("session not found")
        case Some(active):
            var build_id = "unresolved:mcpgdb-session:" + active.session_id
            val supplied_build_id = extract_nested(args, "build_id")
            if supplied_build_id != "":
                build_id = supplied_build_id
            elif name == "debug_launch":
                val program = extract_nested(args, "program")
                if program != "":
                    build_id = "unresolved:mcpgdb-program:" + program
            elif name == "debug_attach":
                val pid = extract_nested(args, "pid")
                if pid != "":
                    build_id = "unresolved:mcpgdb-attach-pid:" + pid
            elif active.process_pid != "":
                build_id = "unresolved:mcpgdb-process-pid:" + active.process_pid
            mcpgdb_debug_bind_session_v1(
                active.session_id, active.backend, build_id,
                debug_policy_development_v1(),
            )?
            mcpgdb_debug_authorize_operation_v1(
                active.session_id, mcpgdb_service_operation_v1(name, args), name,
                mcpgdb_service_perturbation_v1(name, args),
            )?
            Ok(active.session_id)

# Run a native tool and preserve its typed success/error outcome for MCP.
fn run_runner_content(name: text, args: text) -> Result<text, text>:
    match mcpgdb_bundle_validate_v1(false):
        Ok(_): pass
        Err(reason): return Err(reason)
    if is_windows_platform() and windows_gdb_handles_v1(name):
        val result = windows_gdb_dispatch_v1(name, args)?
        if name == "workspace_open": windows_clangd_workspace_v1(args)?
        return Ok(result)
    if is_windows_platform() and windows_clangd_handles_v1(name):
        return windows_clangd_dispatch_v1(name, args)
    if mcpgdb_windows_persistent_v1(name):
        return Err("resident Windows clangd provider is not implemented")
    var service_session_id = ""
    if mcpgdb_service_action_v1(name):
        match mcpgdb_service_prepare_v1(name, args):
            case Err(reason): return Err("DebugServiceV1 denied " + name + ": " + reason)
            case Ok(value): service_session_id = value
    val full_body = LB()
        + jp("jsonrpc", js("2.0"))
        + "," + jp("id", js("1"))
        + "," + jp("method", js("tools/call"))
        + "," + jp("params", LB()
            + jp("name", js(name))
            + "," + jp("arguments", args)
            + RB())
        + RB()
    val request_path = match mcpgdb_request_file_v1(full_body):
        Ok(value): value
        Err(reason): return Err(reason)
    val source = runner_source_for_name(name)
    var role = "runner_debug"
    if source == DEBUG_EXEC_RUNNER_SOURCE: role = "runner_exec"
    elif source == DEBUG_SESSION_RUNNER_SOURCE: role = "runner_session"
    elif source == DEBUG_STATE_RUNNER_SOURCE: role = "runner_state"
    elif source == CLANGD_RUNNER_SOURCE: role = "runner_clangd"
    val artifact = match mcpgdb_bundle_path_v1(role):
        Ok(value): value
        Err(reason):
            mcpgdb_request_cleanup_v1(request_path)
            return Err(reason)
    val (stdout, stderr, code) = mcpgdb_run_native_v1(artifact, request_path)
    mcpgdb_request_cleanup_v1(request_path)
    match mcpgdb_bundle_validate_v1(false):
        Ok(_): pass
        Err(reason): return Err(reason)
    if code != 0:
        var message = stderr.trim()
        if message == "":
            message = stdout.trim()
        if message == "":
            message = "tool runner failed"
        return Err("native runner exited with status " + str(code) + ": " + message)
    val envelope = stdout.trim()
    if envelope == "":
        return Err("tool runner returned empty response")
    val outcome = mcpgdb_runner_outcome_v1(envelope)
    val content = match outcome:
        Ok(value): value
        Err(reason): reason
    if service_session_id != "":
        val succeeded = match outcome:
            Ok(_): true
            Err(_): false
        val perturbation = mcpgdb_service_perturbation_v1(name, args)
        var reason = ""
        if not succeeded:
            reason = content
        mcpgdb_debug_record_operation_outcome_v1(
            service_session_id, mcpgdb_service_operation_v1(name, args), name, perturbation,
            succeeded, mcpgdb_service_execution_changed_v1(name, args, succeeded), reason,
        )
        if succeeded and name == "debug_session_close":
            mcpgdb_debug_unbind_session_v1(service_session_id)
    outcome

fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("mcpgdb", log_opts.error)
        return 1

    val args = mcpgdb_clean_log_args(raw_args)
    if args.len() > 0 and (args[0] == "--help" or args[0] == "-h" or args[0] == "help"):
        print_help_with_progress(log_opts.progress)
        return 0
    if args.len() > 0 and (args[0] == "--version" or args[0] == "-v"):
        if log_opts.log_mode == "json":
            print "{\"command\":\"mcpgdb\",\"status\":\"ok\",\"version\":\"{TOOL_VERSION}\"}"
        else:
            print "{TOOL_NAME} v{TOOL_VERSION}"
        return 0
    if args.len() > 0:
        val message = "Unknown mcpgdb option: {args[0]}"
        if log_opts.log_mode == "json":
            print "{\"command\":\"mcpgdb\",\"status\":\"error\",\"message\":\"{message}\"}"
        else:
            error("mcpgdb", message)
        return 1
    if raw_args.len() > 0 and log_opts.log_mode == "json":
        print "{\"command\":\"mcpgdb\",\"status\":\"ready\",\"tool\":\"{TOOL_NAME}\",\"version\":\"{TOOL_VERSION}\"}"
        return 0
    if raw_args.len() > 0 and log_opts.progress != "none":
        val progress = render_progress(log_opts.progress, 1, 1, "mcpgdb")
        if progress != "":
            print progress
        return 0

    match mcpgdb_bundle_validate_v1(false):
        Ok(_): pass
        Err(reason):
            error("mcpgdb", reason)
            return 1
    mcp_server_init("mcpgdb", TOOL_VERSION)
    mcp_server_tool_result("debug_backend_probe", "Run bounded real GDB MI2 version/configuration diagnostics without attaching or starting an inferior.",
        fn() -> text: make_schema("", "[]"), fn(a: text) -> Result<text, text>: run_runner_content("debug_backend_probe", a))

    mcp_server_tool_result("workspace_open", "Set the workspace root used by debug and clangd tools.",
        fn() -> text: schema_workspace_open(), fn(a: text) -> Result<text, text>: run_runner_content("workspace_open", a))
    mcp_server_tool_result("workspace_status", "Show current workspace and session status.",
        fn() -> text: schema_workspace_status(), fn(a: text) -> Result<text, text>: run_runner_content("workspace_status", a))
    mcp_server_tool_result("clangd_open", "Launch clangd for the current workspace.",
        fn() -> text: schema_clangd_open(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_open", a))
    mcp_server_tool_result("debug_session_create", "Create a new debugger session using gdb, lldb, openocd_gdb, or t32_gdb backend.",
        fn() -> text: schema_debug_session_create(), fn(a: text) -> Result<text, text>: run_runner_content("debug_session_create", a))
    mcp_server_tool_result("debug_session_list", "List active debugger sessions.",
        fn() -> text: schema_debug_session_list(), fn(a: text) -> Result<text, text>: run_runner_content("debug_session_list", a))
    mcp_server_tool_result("debug_session_select", "Select the current debugger session.",
        fn() -> text: schema_debug_session_select(), fn(a: text) -> Result<text, text>: run_runner_content("debug_session_select", a))
    mcp_server_tool_result("debug_session_close", "Close a debugger session and terminate its backend process.",
        fn() -> text: schema_debug_session_close(), fn(a: text) -> Result<text, text>: run_runner_content("debug_session_close", a))
    mcp_server_tool_result("debug_launch", "Load a program into the current debugger session and run it.",
        fn() -> text: schema_debug_launch(), fn(a: text) -> Result<text, text>: run_runner_content("debug_launch", a))
    mcp_server_tool_result("debug_attach", "Attach to a running process.",
        fn() -> text: schema_debug_attach(), fn(a: text) -> Result<text, text>: run_runner_content("debug_attach", a))
    mcp_server_tool_result("debug_connect_remote", "Connect the current debugger session to a remote GDB target.",
        fn() -> text: schema_debug_connect_remote(), fn(a: text) -> Result<text, text>: run_runner_content("debug_connect_remote", a))
    mcp_server_tool_result("debug_disconnect", "Disconnect from the current target.",
        fn() -> text: schema_debug_disconnect(), fn(a: text) -> Result<text, text>: run_runner_content("debug_disconnect", a))
    mcp_server_tool_result("debug_restart", "Restart program execution in the current session.",
        fn() -> text: schema_debug_restart(), fn(a: text) -> Result<text, text>: run_runner_content("debug_restart", a))
    mcp_server_tool_result("debug_continue", "Continue execution.",
        fn() -> text: schema_debug_continue(), fn(a: text) -> Result<text, text>: run_runner_content("debug_continue", a))
    mcp_server_tool_result("debug_pause", "Interrupt execution.",
        fn() -> text: schema_debug_pause(), fn(a: text) -> Result<text, text>: run_runner_content("debug_pause", a))
    mcp_server_tool_result("debug_step_in", "Step into the next statement.",
        fn() -> text: schema_debug_step_in(), fn(a: text) -> Result<text, text>: run_runner_content("debug_step_in", a))
    mcp_server_tool_result("debug_step_over", "Step over the next statement.",
        fn() -> text: schema_debug_step_over(), fn(a: text) -> Result<text, text>: run_runner_content("debug_step_over", a))
    mcp_server_tool_result("debug_step_out", "Step out of the current frame.",
        fn() -> text: schema_debug_step_out(), fn(a: text) -> Result<text, text>: run_runner_content("debug_step_out", a))
    mcp_server_tool_result("breakpoint_set", "Set a breakpoint by file/line or symbol.",
        fn() -> text: schema_breakpoint_set(), fn(a: text) -> Result<text, text>: run_runner_content("breakpoint_set", a))
    mcp_server_tool_result("breakpoint_remove", "Remove a breakpoint by debugger breakpoint id.",
        fn() -> text: schema_breakpoint_remove(), fn(a: text) -> Result<text, text>: run_runner_content("breakpoint_remove", a))
    mcp_server_tool_result("breakpoint_list", "List breakpoints.",
        fn() -> text: schema_breakpoint_list(), fn(a: text) -> Result<text, text>: run_runner_content("breakpoint_list", a))
    mcp_server_tool_result("thread_list", "List threads.",
        fn() -> text: schema_thread_list(), fn(a: text) -> Result<text, text>: run_runner_content("thread_list", a))
    mcp_server_tool_result("frame_list", "List frames.",
        fn() -> text: schema_frame_list(), fn(a: text) -> Result<text, text>: run_runner_content("frame_list", a))
    mcp_server_tool_result("frame_select", "Select a frame by frame id.",
        fn() -> text: schema_frame_select(), fn(a: text) -> Result<text, text>: run_runner_content("frame_select", a))
    mcp_server_tool_result("variable_list", "List variables in the current frame.",
        fn() -> text: schema_variable_list(), fn(a: text) -> Result<text, text>: run_runner_content("variable_list", a))
    mcp_server_tool_result("evaluate", "Evaluate an expression in the current frame.",
        fn() -> text: schema_evaluate(), fn(a: text) -> Result<text, text>: run_runner_content("evaluate", a))
    mcp_server_tool_result("register_read", "Read one register or all registers.",
        fn() -> text: schema_register_read(), fn(a: text) -> Result<text, text>: run_runner_content("register_read", a))
    mcp_server_tool_result("register_write", "Write a register value.",
        fn() -> text: schema_register_write(), fn(a: text) -> Result<text, text>: run_runner_content("register_write", a))
    mcp_server_tool_result("memory_read", "Read target memory.",
        fn() -> text: schema_memory_read(), fn(a: text) -> Result<text, text>: run_runner_content("memory_read", a))
    mcp_server_tool_result("memory_write", "Write target memory.",
        fn() -> text: schema_memory_write(), fn(a: text) -> Result<text, text>: run_runner_content("memory_write", a))
    mcp_server_tool_result("debug_command_run", "Run a gated raw backend command.",
        fn() -> text: schema_debug_command_run(), fn(a: text) -> Result<text, text>: run_runner_content("debug_command_run", a))
    mcp_server_tool_result("clangd_definition", "Resolve definition location via clangd.",
        fn() -> text: schema_pos(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_definition", a))
    mcp_server_tool_result("clangd_references", "Resolve references via clangd.",
        fn() -> text: schema_pos(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_references", a))
    mcp_server_tool_result("clangd_hover", "Get hover details via clangd.",
        fn() -> text: schema_pos(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_hover", a))
    mcp_server_tool_result("clangd_completion", "Get code completions via clangd.",
        fn() -> text: schema_pos(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_completion", a))
    mcp_server_tool_result("clangd_type_definition", "Resolve type definition via clangd.",
        fn() -> text: schema_pos(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_type_definition", a))
    mcp_server_tool_result("clangd_symbols", "List symbols in a source file via clangd.",
        fn() -> text: schema_file_only(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_symbols", a))
    mcp_server_tool_result("clangd_diagnostics", "Run clangd --check diagnostics for a source file.",
        fn() -> text: schema_file_only(), fn(a: text) -> Result<text, text>: run_runner_content("clangd_diagnostics", a))

    val t = StdioTransport.json_lines()
    mcp_serve(t)
    var cleanup_failed = false
    if is_windows_platform():
        match windows_gdb_shutdown_v1():
            Ok(_): pass
            Err(reason):
                error("mcpgdb", reason)
                cleanup_failed = true
        match windows_clangd_shutdown_v1():
            Ok(_): pass
            Err(reason):
                error("mcpgdb", reason)
                cleanup_failed = true
    match mcpgdb_bundle_validate_v1(true):
        Ok(_): if cleanup_failed: 1 else: 0
        Err(reason):
            error("mcpgdb", reason)
            1

fn print_help():
    print "{TOOL_NAME}"
    print ""
    print "Usage: simple mcpgdb [options]"
    print ""
    print "Runs the mcpgdb MCP JSON-RPC server on stdin/stdout."
    print ""
    print "Options:"
    print "  -h, --help          Show this help message"
    print "  -v, --version       Show version information"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"

fn print_help_with_progress(progress_mode: text):
    val progress = render_progress(progress_mode, 0, 1, "usage")
    if progress != "":
        print progress
    print_help()

fn mcpgdb_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--progress=")

fn mcpgdb_clean_log_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if mcpgdb_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned
