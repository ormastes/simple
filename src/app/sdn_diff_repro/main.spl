# Differential repro: SdnValue.Dict construction (seed codegen vs interpreter).
# FAILS natively (4x 'payload type mismatch at 0') with the sdn.parser import
# present; PASSES natively without it (flip = closure/symbol-order dependence).
# PASSES under the seed interpreter. See the bug doc for the full matrix.
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_untrusted}

fn build() -> SdnValue:
    var fields: Dict<text, SdnValue> = {}
    fields["k"] = SdnValue.Null
    SdnValue.Dict(fields)

fn main() -> i64:
    val v = build()
    0
