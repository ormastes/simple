"""Compiled PostgreSQL-mimic database command entrypoint.

The cached SMF/native artifact owns the database hot path. A network transport
can supervise this process or compose the same server capsule.
"""

use std.database.postgres_mimic.{PgResponseKind, postgres_mimic_open,
    postgres_mimic_startup, postgres_mimic_simple_query, postgres_mimic_close,
    postgres_mimic_join_text, postgres_mimic_row_tsv}

extern fn sys_get_args() -> [text]

fn pg_has_flag(args: [text], flag: text) -> bool:
    for arg in args:
        if arg == flag: return true
    false

fn pg_flag_value(args: [text], flag: text, fallback: text) -> text:
    var i = 0
    while i < args.len():
        if args[i] == flag and i + 1 < args.len(): return args[i + 1]
        val prefix = flag + "="
        if args[i].starts_with(prefix): return args[i].substring(prefix.len())
        i = i + 1
    fallback

fn print_help():
    print "Usage: postgres-mimic-server --db <path> --query <sql>"
    print "Run this entrypoint from its cached SMF or native artifact."

fn main() -> i64:
    val args = sys_get_args()
    if pg_has_flag(args, "--help") or pg_has_flag(args, "-h"):
        print_help()
        return 0
    val path = pg_flag_value(args, "--db", "build/database/default.pdb")
    val sql = pg_flag_value(args, "--query", "")
    if sql == "":
        print "error: --query is required"
        return 2
    var server = match postgres_mimic_open(path):
        Ok(value): value
        Err(reason):
            print "error: database open failed"
            return 1
    val session = match postgres_mimic_startup(server, "local", "default", "compiled-artifact"):
        Ok(value): value
        Err(reason):
            print "error: session startup failed: {reason}"
            return 1
    val response = postgres_mimic_simple_query(server, session, sql)
    if response.kind == PgResponseKind.ErrorResponse:
        print "ERROR {response.sqlstate} {response.message}"
        return 1
    if response.kind == PgResponseKind.RowSet:
        print postgres_mimic_join_text(response.columns, "\t")
        for row in response.rows:
            print postgres_mimic_row_tsv(row)
    else:
        print response.tag
    postgres_mimic_close(server)
    0
