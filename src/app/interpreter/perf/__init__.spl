# Performance Optimization Module
#
# Unified module integrating all Erlang-inspired performance optimizations.
#
# Components:
# - Symbol interning (Phase 1)
# - Persistent collections (Phase 2)
# - Actor heap isolation (Phase 3)
# - Reference-counted binaries (Phase 4)
# - Lazy evaluation (Phase 5)
#
# This module provides:
# - Unified configuration
# - Performance statistics
# - Benchmarking utilities
# - Integration helpers

use app.interpreter.core.{
    SymbolId,
    SymbolInterner,
    intern,
    resolve,
    GLOBAL_INTERNER
}

use app.interpreter.collections.{
    PersistentDict,
    PersistentVec,
    PersistentSymbolTable,
    PersistentScope,
    SymbolEntry,
    SymbolKind,
    ScopeKind
}

use app.interpreter.async_runtime.{
