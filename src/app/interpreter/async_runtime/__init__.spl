# Async Runtime
#
# Futures, actors, and generators with Erlang-inspired optimizations.
#
# Key components:
# - actors: Basic actor spawning/messaging
# - actor_heap: Per-actor heap isolation (Erlang-style GC)
# - mailbox: Off-heap message queues
# - actor_scheduler: Reductions-based fair scheduling

use app.interpreter.async_runtime.futures.{eval_async, eval_await, Future}
use app.interpreter.async_runtime.actors.{eval_spawn, eval_send, eval_receive, Actor}
use app.interpreter.async_runtime.generators.{eval_yield, eval_generator_next, Generator}

# Performance-optimized actor runtime
use app.interpreter.async_runtime.actor_heap.{
    ActorHeap,
    HeapConfig,
    HeapStats,
    HeapRegion,
    AllocationResult,
    HeapConfig__default,
    HeapConfig__small,
    HeapConfig__large,
    HeapConfig__no_gc,
    HeapStats__new,
    ActorHeap__new
}
use app.interpreter.async_runtime.mailbox.{
    Mailbox,
    MailboxConfig,
    MailboxStats,
    MessageRef,
    MessagePriority,
    SendResult
}
use app.interpreter.async_runtime.actor_scheduler.{
    ActorScheduler,
    SchedulerConfig,
    SchedulerStats,
    ActorContext,
    ActorPriority,
    ActorState,
    RunQueue,
    SchedulerConfig__default,
    SchedulerConfig__single_threaded,
    SchedulerConfig__low_latency,
    SchedulerConfig__high_throughput,
    ActorPriority__from_i64,
    RunQueue__new,
    SchedulerStats__new
}

export eval_async, eval_await, Future
export eval_spawn, eval_send, eval_receive, Actor
export eval_yield, eval_generator_next, Generator

# Actor heap isolation
export ActorHeap, HeapConfig, HeapStats, HeapRegion, AllocationResult
export HeapConfig__default, HeapConfig__small, HeapConfig__large, HeapConfig__no_gc
export HeapStats__new, ActorHeap__new

# Off-heap mailbox
export Mailbox, MailboxConfig, MailboxStats, MessageRef, MessagePriority, SendResult

# Reductions-based scheduler
export ActorScheduler, SchedulerConfig, SchedulerStats
export ActorContext, ActorPriority, ActorState, RunQueue
export SchedulerConfig__default, SchedulerConfig__single_threaded, SchedulerConfig__low_latency, SchedulerConfig__high_throughput
