# FFI Bridge
#
# Bridge between interpreter and compiled code: a typed registry of native
# functions with average O(1) name lookup (one Dict probe per call; no library
# or symbol lookup, signature parsing, or value copying on the call path).

use app.interpreter.core.{Value, InterpreterError}

export call_native, register_native, has_native, NativeFunction, NativeRegistry

# Native function signature
type NativeFunction = fn([Value]) -> Result<Value, InterpreterError>

struct NativeRegistry:
    functions: Dict<text, NativeFunction>

impl NativeRegistry:
    static fn new() -> NativeRegistry:
        NativeRegistry(functions: {})

    me register(name: text, func: NativeFunction):
        self.functions[name] = func

    fn has(name: text) -> bool:
        self.functions.contains_key(name)

# Process-wide native function registry
var NATIVE_REGISTRY: NativeRegistry = NativeRegistry.new()

fn register_native(name: text, func: NativeFunction):
    NATIVE_REGISTRY.register(name, func)

fn has_native(name: text) -> bool:
    NATIVE_REGISTRY.has(name)

fn call_native(name: text, args: [Value]) -> Result<Value, InterpreterError>:
    if not NATIVE_REGISTRY.has(name):
        return Err(InterpreterError.NameError("unknown native: {name}"))
    val func = NATIVE_REGISTRY.functions[name]
    func(args)
