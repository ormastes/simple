# Environment/Scope FFI Stubs
#
# Extern declarations for opaque-handle-based environment access.

@unsafe(reason: "interpreter-owned environment handle; nonpositive result is not a usable environment", capabilities: [ffi])
extern fn rt_env_new_handle() -> i64
@unsafe(reason: "interpreter-owned environment handle must be live", capabilities: [ffi])
extern fn rt_env_push_scope(env_handle: i64)
@unsafe(reason: "interpreter-owned environment handle must be live", capabilities: [ffi])
extern fn rt_env_pop_scope(env_handle: i64)
@unsafe(reason: "interpreter-owned environment handle/value ABI", capabilities: [ffi])
extern fn rt_env_define_var(env_handle: i64, name: text, value: auto)
@unsafe(reason: "interpreter-owned environment handle; nil is ordinary missing variable only", capabilities: [ffi])
extern fn rt_env_get_var(env_handle: i64, name: text) -> auto
@unsafe(reason: "interpreter-owned environment handle/value ABI; false does not distinguish invalid handle", capabilities: [ffi])
extern fn rt_env_set_var(env_handle: i64, name: text, value: auto) -> bool
@unsafe(reason: "interpreter-owned environment handle; false does not distinguish invalid handle", capabilities: [ffi])
extern fn rt_env_has_var(env_handle: i64, name: text) -> bool
@unsafe(reason: "interpreter-owned environment snapshot may allocate and must be released", capabilities: [ffi])
extern fn rt_env_snapshot(env_handle: i64) -> i64
@unsafe(reason: "interpreter-owned environment handle must be live", capabilities: [ffi])
extern fn rt_env_scope_depth(env_handle: i64) -> i64
@unsafe(reason: "interpreter-owned environment handle release invalidates the handle", capabilities: [ffi])
extern fn rt_env_free_handle(env_handle: i64)
@unsafe(reason: "interpreter-owned environment handle must be live", capabilities: [ffi])
extern fn rt_env_var_count(env_handle: i64) -> i64
@unsafe(reason: "interpreter-owned environment handle returns copied names", capabilities: [ffi])
extern fn rt_env_var_names(env_handle: i64) -> [text]

export rt_env_new_handle, rt_env_push_scope, rt_env_pop_scope
export rt_env_define_var, rt_env_get_var, rt_env_set_var, rt_env_has_var
export rt_env_snapshot, rt_env_scope_depth, rt_env_free_handle
export rt_env_var_count, rt_env_var_names
