# Runtime value formatting regressions.

use app.interpreter.core.value.{Value, ValueKind, RuntimeValue}

describe "Value enum formatting":
    it "formats an enum payload through its bound box value":
        val payload = Value { kind: ValueKind.Int, data: RuntimeValue.Int(42) }
        val value = Value {
            kind: ValueKind.Enum,
            data: RuntimeValue.Enum("Answer", Some(payload))
        }
        assert value.fmt() == "Answer(42)"

    it "formats an enum without a payload":
        val value = Value {
            kind: ValueKind.Enum,
            data: RuntimeValue.Enum("Empty", nil)
        }
        assert value.fmt() == "Empty"

    it "keeps debugger enum payload formatting aligned":
        val payload = Value { kind: ValueKind.String, data: RuntimeValue.String("ready") }
        val value = Value {
            kind: ValueKind.Enum,
            data: RuntimeValue.Enum("State", Some(payload))
        }
        assert value.to_debug_string() == "State(\"ready\")"
