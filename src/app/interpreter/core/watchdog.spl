# Watchdog Timer
#
# Wall-clock timeout detection. `std.common.fault_detection` holds a deadline
# on the monotonic clock that loop bodies poll; the host runtime's own timer
# (WatchdogManager) is armed alongside it.
#
# The runtime timer is owned by the WatchdogManager facade
# (backend-isolation Gap D); this module never declares the extern itself.

use std.common.fault_detection.{
    is_timeout_exceeded, reset_timeout, set_timeout_limit_secs
}
use std.nogc_async_mut_noalloc.execution.watchdog_manager.{WatchdogManager}

export start_watchdog, stop_watchdog, check_timeout

fn start_watchdog(timeout_secs: i64):
    """Start a watchdog timer. If execution exceeds timeout_secs, the
    timeout flag is set. Any existing watchdog is stopped first."""
    stop_watchdog()
    reset_timeout()
    set_timeout_limit_secs(timeout_secs)
    WatchdogManager.start(timeout_secs)

fn stop_watchdog():
    """Stop the watchdog timer if running."""
    set_timeout_limit_secs(0)
    WatchdogManager.stop()

fn check_timeout() -> Result<(), text>:
    """Check if the watchdog has fired. Returns Err if timed out."""
    if is_timeout_exceeded():
        Err("execution timed out")
    else:
        Ok(())
