# Production orchestration for the FV2 lanes accepted independently of Wave 4.
#
# This owner executes both replay checkers, invokes delivery collectors 0-3,
# 5-7, seals their ordered manifest, and verifies the caller-provided Ed25519
# signature.  It deliberately does not claim the frozen eight-gate release
# decision: SimpleOS Gate 4 remains a separately excluded vertical slice.

use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use compiler.common.assurance.replay_receipt.{IndependentReplayClosureV1,
    close_independent_replay_v1}
use compiler.common.assurance.formal_delivery_gates.{FormalDeliveryGateV1,
    FormalDeliveryGateStatusV1, FormalDeliveryGateEvidenceV1,
    FormalDeliveryReceiptFileV1, formal_delivery_manifest_hash_v1}
use compiler.common.assurance.verified_release_gate.{VerifiedReleaseEvidenceV1,
    SignedVerifiedReleaseBundleV1, SignedVerifiedReleaseBundleDecisionV1,
    ApprovedReleaseSignerV1, ReleaseSignatureVerificationV1}
use compiler.mir.verification_ir.{VerificationIrModuleV1,
    ResolvedVerificationIrModuleV2}
use compiler.common.assurance.formal_interfaces.{CompilerCertificateV1,
    WeaveManifestV1, AspectCertificateV1, HardwareProofReceiptV1}
use compiler.tools.verify.replay_runner.{ReplayRunnerConfigV1,
    run_fresh_leanchecker_v1, run_independent_replay_adapter_v1}
use compiler.tools.verify.formal_gate_collectors.{TruthfulnessProofEvidenceV1,
    ExecutedExactCoreCheckV1, VirConstructionEvidenceV1,
    CompilerCertificateValidationV1, ExecutedWeaveClosureV1,
    FormalGateCollectionV1, collect_verification_truthfulness_gate_v1,
    collect_exact_core_semantics_gate_v1, collect_exact_core_semantics_gate_v2,
    collect_vir_compiler_relation_gate_v1, collect_aop_macro_closure_gate_v1}
use compiler.tools.verify.formal_os_hardware_gate_collectors.{
    collect_generated_rv32i_end_to_end_gate_v1}
use compiler.tools.verify.formal_product_gate_collectors.{
    collect_verified_release_gate_v1}
use app.verify.release_signature.{verify_release_bundle_ed25519_v1}
use app.verify.rv64_product_evidence_runner.{Rv64ProductRunnerConfigV1,
    run_rv64_product_evidence_v1}

pub struct Fv2Wave6CollectorInputsV1:
    truthfulness: [TruthfulnessProofEvidenceV1]
    vir: VerificationIrModuleV1
    exact_checks: [ExecutedExactCoreCheckV1]
    construction: VirConstructionEvidenceV1
    compiler_certificates: [CompilerCertificateV1]
    certificate_validations: [CompilerCertificateValidationV1]
    artifact_hash: text
    weave_manifest: WeaveManifestV1
    aspect_certificates: [AspectCertificateV1]
    weave_execution: ExecutedWeaveClosureV1
    rv32_formal: HardwareProofReceiptV1
    rv32_equivalence: HardwareProofReceiptV1
    rv32_sail: HardwareProofReceiptV1
    rv32_hwir_to_rtl: CompilerCertificateV1
    rv32_external_material: [FormalDeliveryReceiptFileV1]
    rv64_runner_config: Rv64ProductRunnerConfigV1
    release_evidence: VerifiedReleaseEvidenceV1
    release_material: [FormalDeliveryReceiptFileV1]

# Additive resolved-VIR inputs for the V2 Wave 6 boundary. The frozen V1
# collector record remains unchanged.
pub struct Fv2Wave6VirCollectorInputsV2:
    resolved_vir: ResolvedVerificationIrModuleV2
    exact_checks: [ExecutedExactCoreCheckV1]
    construction: VirConstructionEvidenceV1
    compiler_certificates: [CompilerCertificateV1]
    certificate_validations: [CompilerCertificateValidationV1]
    artifact_hash: text
    weave_manifest: WeaveManifestV1
    aspect_certificates: [AspectCertificateV1]
    weave_execution: ExecutedWeaveClosureV1

pub struct Fv2Wave6CollectorInputsV2:
    truthfulness: [TruthfulnessProofEvidenceV1]
    vir: Fv2Wave6VirCollectorInputsV2
    rv32_formal: HardwareProofReceiptV1
    rv32_equivalence: HardwareProofReceiptV1
    rv32_sail: HardwareProofReceiptV1
    rv32_hwir_to_rtl: CompilerCertificateV1
    rv32_external_material: [FormalDeliveryReceiptFileV1]
    rv64_runner_config: Rv64ProductRunnerConfigV1
    release_evidence: VerifiedReleaseEvidenceV1
    release_material: [FormalDeliveryReceiptFileV1]

pub struct Fv2Wave6SigningInputsV1:
    signer: ApprovedReleaseSignerV1
    approved_signers: [ApprovedReleaseSignerV1]
    public_key: [u8]
    signature: [u8]

pub struct Fv2Wave6OrchestrationResultV1:
    accepted_non_wave4: bool
    diagnostic: text
    replay: IndependentReplayClosureV1
    gate_evidence: [FormalDeliveryGateEvidenceV1]
    receipt_files: [FormalDeliveryReceiptFileV1]
    signed_bundle: SignedVerifiedReleaseBundleV1?
    signed_decision: SignedVerifiedReleaseBundleDecisionV1?

struct Fv2Wave6VirCollectionsV2:
    exact: FormalGateCollectionV1
    relation: FormalGateCollectionV1
    aop: FormalGateCollectionV1

# Narrow semantic boundary used by V2 orchestration. Caller-created executed
# checks remain subject to the collector's fail-closed authority terminal.
pub fn collect_fv2_wave6_exact_core_v2(
    resolved: ResolvedVerificationIrModuleV2,
    checks: [ExecutedExactCoreCheckV1]
) -> FormalGateCollectionV1:
    collect_exact_core_semantics_gate_v2(resolved, checks)

fn fv2_wave6_collect_vir_v2(
    inputs: Fv2Wave6VirCollectorInputsV2,
    truthfulness_receipts: [FormalDeliveryReceiptFileV1]
) -> Fv2Wave6VirCollectionsV2:
    Fv2Wave6VirCollectionsV2(
        collect_fv2_wave6_exact_core_v2(inputs.resolved_vir,
            inputs.exact_checks),
        collect_vir_compiler_relation_gate_v1(inputs.resolved_vir.vir,
            inputs.construction, inputs.compiler_certificates,
            inputs.certificate_validations, inputs.artifact_hash),
        collect_aop_macro_closure_gate_v1(inputs.resolved_vir.vir,
            inputs.weave_manifest, inputs.aspect_certificates,
            truthfulness_receipts, inputs.weave_execution))

fn fv2_wave6_rejected_v1(
    diagnostic: text,
    replay: IndependentReplayClosureV1,
    gates: [FormalDeliveryGateEvidenceV1],
    receipts: [FormalDeliveryReceiptFileV1]
) -> Fv2Wave6OrchestrationResultV1:
    Fv2Wave6OrchestrationResultV1(false, diagnostic, replay, gates, receipts,
        nil, nil)

fn fv2_wave6_expected_gate_v1(index: i64) -> FormalDeliveryGateV1:
    match index:
        case 0: FormalDeliveryGateV1.VerificationTruthfulness
        case 1: FormalDeliveryGateV1.ExactCoreSemantics
        case 2: FormalDeliveryGateV1.VirCompilerRelation
        case 3: FormalDeliveryGateV1.AopMacroClosure
        case 4: FormalDeliveryGateV1.GeneratedRv32iEndToEnd
        case 5: FormalDeliveryGateV1.Rv64PrivilegeMmuLinux
        case _: FormalDeliveryGateV1.VerifiedRelease

pub fn fv2_wave6_collection_error_v1(
    collections: [FormalGateCollectionV1]
) -> text:
    if collections.len() != 7:
        return "FV2-E-WAVE6-GATE-COUNT: gates 0-3 and 5-7 are required exactly once"
    var receipt_hashes: [text] = []
    for index in 0..collections.len():
        val collection = collections[index]
        if collection.gate_evidence.gate != fv2_wave6_expected_gate_v1(index):
            return "FV2-E-WAVE6-GATE-ORDER: non-Wave-4 gates are missing reordered or substituted"
        if (collection.gate_evidence.status != FormalDeliveryGateStatusV1.Passed or
                collection.gate_evidence.diagnostic != ""):
            return "FV2-E-WAVE6-GATE-FAILED: " +
                collection.gate_evidence.diagnostic
        if collection.receipt_files.is_empty():
            return "FV2-E-WAVE6-GATE-MATERIAL: passed gate has no retained receipt bytes"
        if (not sha256_lower_hex_valid(collection.gate_evidence.evidence_hash) or
                collection.gate_evidence.receipt_hashes.len() !=
                    collection.receipt_files.len()):
            return "FV2-E-WAVE6-GATE-IDENTITY: gate summary does not bind its exact retained receipt set"
        for expected_hash in collection.gate_evidence.receipt_hashes:
            if not sha256_lower_hex_valid(expected_hash):
                return "FV2-E-WAVE6-GATE-IDENTITY: gate summary contains a malformed receipt identity"
            var summary_count = 0
            for candidate in collection.gate_evidence.receipt_hashes:
                if candidate == expected_hash: summary_count = summary_count + 1
            var file_count = 0
            for file in collection.receipt_files:
                if file.receipt_hash == expected_hash: file_count = file_count + 1
            if summary_count != 1 or file_count != 1:
                return "FV2-E-WAVE6-GATE-IDENTITY: gate summary and retained files must form an exact receipt bijection"
        for file in collection.receipt_files:
            if sha256_text(file.content) != file.receipt_hash:
                return "FV2-E-WAVE6-GATE-STALE: retained receipt bytes do not match their SHA-256 identity"
            if not collection.gate_evidence.receipt_hashes.contains(
                    file.receipt_hash):
                return "FV2-E-WAVE6-GATE-IDENTITY: gate summary does not bind its exact retained receipt set"
            # Gate 7 republishes closure material, so duplicates there are
            # expected.  Earlier collectors must remain disjoint owners.
            if index < 6 and receipt_hashes.contains(file.receipt_hash):
                return "FV2-E-WAVE6-GATE-DUPLICATE: predecessor receipt ownership is ambiguous"
            if not receipt_hashes.contains(file.receipt_hash):
                receipt_hashes.push(file.receipt_hash)
    ""

fn fv2_wave6_append_collection_v1(
    target: [FormalDeliveryReceiptFileV1],
    collection: FormalGateCollectionV1
) -> [FormalDeliveryReceiptFileV1]:
    var result = target
    for file in collection.receipt_files: result.push(file)
    result

fn fv2_wave6_frame_v1(value: text) -> text:
    value.len().to_string() + ":" + value

fn fv2_wave6_replay_material_v1(
    replay: IndependentReplayClosureV1
) -> FormalDeliveryReceiptFileV1:
    val content = "IndependentReplayClosureV1" +
        fv2_wave6_frame_v1(replay.schema) +
        fv2_wave6_frame_v1(replay.fresh_kernel_receipt_hash) +
        fv2_wave6_frame_v1(replay.independent_kernel_receipt_hash) +
        fv2_wave6_frame_v1(replay.artifact_hash)
    FormalDeliveryReceiptFileV1(replay.hash(), content)

fn fv2_wave6_required_release_hashes_v1(
    evidence: VerifiedReleaseEvidenceV1
) -> [text]:
    var result = evidence.proof_receipt_hashes
    for value in evidence.compiler_certificate_hashes: result.push(value)
    result.push(evidence.trust_manifest_hash)
    if evidence.bounded_tcb_manifest_hash != "":
        result.push(evidence.bounded_tcb_manifest_hash)
    result.push(evidence.independent_replay_hash)
    result.push(evidence.mutation_receipt_hash)
    result.push(evidence.non_vacuity_receipt_hash)
    result

const FV2_WAVE6_EXECUTION_AUTHORITY_ERROR =
    "FV2-E-WAVE6-EXECUTION-AUTHORITY: caller-supplied replay closure material cannot establish executed evidence"

struct Fv2Wave6AssemblyValidationV1:
    diagnostic: text
    gates: [FormalDeliveryGateEvidenceV1]
    release_files: [FormalDeliveryReceiptFileV1]

fn fv2_wave6_validate_assembly_v1(
    replay: IndependentReplayClosureV1,
    collections: [FormalGateCollectionV1],
    pre_manifest: VerifiedReleaseEvidenceV1
) -> Fv2Wave6AssemblyValidationV1:
    if replay.hash() == "":
        return Fv2Wave6AssemblyValidationV1(replay.diagnostic, [], [])
    if pre_manifest.delivery_gate_manifest_hash != "":
        return Fv2Wave6AssemblyValidationV1(
            "FV2-E-WAVE6-PRESEALED: release evidence must enter orchestration before manifest sealing",
            [], [])
    if pre_manifest.independent_replay_hash != replay.hash():
        return Fv2Wave6AssemblyValidationV1(
            "FV2-E-WAVE6-REPLAY-RELEASE: release evidence does not bind the freshly executed replay pair",
            [], [])
    val collection_error = fv2_wave6_collection_error_v1(collections)
    var gates: [FormalDeliveryGateEvidenceV1] = []
    for collection in collections: gates.push(collection.gate_evidence)
    val release_files = if collections.len() == 7:
        collections[6].receipt_files
    else:
        []
    Fv2Wave6AssemblyValidationV1(collection_error, gates, release_files)

# Compatibility assembly boundary for deterministic structural validation.
# A value-only replay closure has no execution provenance, so this entry point
# deliberately cannot admit a release. No accepting finalizer exists until the
# runner resolves checker, gate-producer, and signer authority independently
# of caller-owned values.
pub fn finalize_fv2_wave6_orchestration_v1(
    replay: IndependentReplayClosureV1,
    collections: [FormalGateCollectionV1],
    pre_manifest: VerifiedReleaseEvidenceV1,
    signer_id: text,
    signature_verification: ReleaseSignatureVerificationV1,
    approved_signers: [ApprovedReleaseSignerV1]
) -> Fv2Wave6OrchestrationResultV1:
    val validation = fv2_wave6_validate_assembly_v1(replay, collections,
        pre_manifest)
    if validation.diagnostic != "":
        return fv2_wave6_rejected_v1(validation.diagnostic, replay,
            validation.gates, validation.release_files)
    fv2_wave6_rejected_v1(FV2_WAVE6_EXECUTION_AUTHORITY_ERROR, replay,
        validation.gates, validation.release_files)

fn run_fv2_wave6_orchestration_common_v2(
    fresh_config: ReplayRunnerConfigV1,
    independent_config: ReplayRunnerConfigV1,
    inputs: Fv2Wave6CollectorInputsV1,
    signing: Fv2Wave6SigningInputsV1,
    resolved_vir_inputs: Fv2Wave6VirCollectorInputsV2?
) -> Fv2Wave6OrchestrationResultV1:
    val fresh = run_fresh_leanchecker_v1(fresh_config)
    val independent = run_independent_replay_adapter_v1(independent_config)
    val replay = close_independent_replay_v1(fresh, independent)
    if replay.hash() == "":
        return fv2_wave6_rejected_v1(replay.diagnostic, replay, [], [])
    for item in inputs.truthfulness:
        if item.replay.hash() != replay.hash():
            return fv2_wave6_rejected_v1(
                "FV2-E-WAVE6-REPLAY-BINDING: truthfulness evidence does not bind the freshly executed replay pair",
                replay, [], [])

    val truth = collect_verification_truthfulness_gate_v1(inputs.truthfulness)
    val vir_collections = match resolved_vir_inputs:
        case Some(resolved_inputs): fv2_wave6_collect_vir_v2(resolved_inputs,
            truth.receipt_files)
        case _: Fv2Wave6VirCollectionsV2(
            collect_exact_core_semantics_gate_v1(inputs.vir,
                inputs.exact_checks),
            collect_vir_compiler_relation_gate_v1(inputs.vir,
                inputs.construction, inputs.compiler_certificates,
                inputs.certificate_validations, inputs.artifact_hash),
            collect_aop_macro_closure_gate_v1(inputs.vir,
                inputs.weave_manifest, inputs.aspect_certificates,
                truth.receipt_files, inputs.weave_execution))
    val exact = vir_collections.exact
    val relation = vir_collections.relation
    val aop = vir_collections.aop
    val rv32 = collect_generated_rv32i_end_to_end_gate_v1(
        inputs.rv32_formal, inputs.rv32_equivalence, inputs.rv32_sail,
        inputs.rv32_hwir_to_rtl, inputs.rv32_external_material)
    # Gate 6 is owned by bounded execution.  Caller-authored parsed rows are
    # never accepted directly at the release boundary.
    val rv64_execution = run_rv64_product_evidence_v1(
        inputs.rv64_runner_config)
    if rv64_execution.diagnostic != "":
        return fv2_wave6_rejected_v1(
            "FV2-E-WAVE6-RV64-EXECUTION: " + rv64_execution.diagnostic,
            replay, [], [])
    val rv64 = rv64_execution.collection
    val predecessors = [truth, exact, relation, aop, rv32, rv64]
    var all_predecessor_files: [FormalDeliveryReceiptFileV1] = []
    for collection in predecessors:
        if collection.gate_evidence.status != FormalDeliveryGateStatusV1.Passed:
            return fv2_wave6_rejected_v1(
                "FV2-E-WAVE6-GATE-FAILED: " + collection.gate_evidence.diagnostic,
                replay, [], all_predecessor_files)
        all_predecessor_files = fv2_wave6_append_collection_v1(
            all_predecessor_files, collection)

    var pre_manifest = inputs.release_evidence
    if pre_manifest.delivery_gate_manifest_hash != "":
        return fv2_wave6_rejected_v1(
            "FV2-E-WAVE6-PRESEALED: release evidence must enter orchestration before manifest sealing",
            replay, [], all_predecessor_files)
    if pre_manifest.independent_replay_hash != replay.hash():
        return fv2_wave6_rejected_v1(
            "FV2-E-WAVE6-REPLAY-RELEASE: release evidence does not bind the freshly executed replay pair",
            replay, [], all_predecessor_files)

    # Gate 7 accepts every and only the identities named by release evidence.
    # Filter collector output rather than forwarding unrelated aggregate rows,
    # and always materialize the replay closure produced in this invocation.
    val required_hashes = fv2_wave6_required_release_hashes_v1(pre_manifest)
    var predecessor_files: [FormalDeliveryReceiptFileV1] = []
    for file in all_predecessor_files:
        if required_hashes.contains(file.receipt_hash):
            predecessor_files.push(file)
    var release_material = inputs.release_material
    release_material.push(fv2_wave6_replay_material_v1(replay))
    val release = collect_verified_release_gate_v1(pre_manifest,
        predecessor_files, release_material)
    val collections = [truth, exact, relation, aop, rv32, rv64, release]
    var gates: [FormalDeliveryGateEvidenceV1] = []
    for collection in collections: gates.push(collection.gate_evidence)
    var sealed_evidence = pre_manifest
    sealed_evidence.delivery_gate_manifest_hash =
        formal_delivery_manifest_hash_v1(gates)
    val verification = verify_release_bundle_ed25519_v1(sealed_evidence,
        signing.signer, signing.public_key, signing.signature)
    if not verification.accepted():
        return fv2_wave6_rejected_v1(
            "FV2-E-WAVE6-SIGNATURE: release signature verification failed",
            replay, gates, predecessor_files)
    # `signing.approved_signers` is supplied by the same caller as the signer,
    # so membership in that value cannot establish release authority.  Keep
    # the executed orchestrator closed until a repository-owned signer policy
    # is resolved independently of these inputs.
    fv2_wave6_rejected_v1(
        "FV2-E-WAVE6-SIGNER-AUTHORITY: canonical approved-signer policy is unavailable",
        replay, gates, predecessor_files)

pub fn run_fv2_wave6_orchestration_v1(
    fresh_config: ReplayRunnerConfigV1,
    independent_config: ReplayRunnerConfigV1,
    inputs: Fv2Wave6CollectorInputsV1,
    signing: Fv2Wave6SigningInputsV1
) -> Fv2Wave6OrchestrationResultV1:
    run_fv2_wave6_orchestration_common_v2(fresh_config, independent_config,
        inputs, signing, nil)

pub fn run_fv2_wave6_orchestration_v2(
    fresh_config: ReplayRunnerConfigV1,
    independent_config: ReplayRunnerConfigV1,
    inputs: Fv2Wave6CollectorInputsV2,
    signing: Fv2Wave6SigningInputsV1
) -> Fv2Wave6OrchestrationResultV1:
    val vir = inputs.vir
    val normalized = Fv2Wave6CollectorInputsV1(inputs.truthfulness,
        vir.resolved_vir.vir, vir.exact_checks, vir.construction,
        vir.compiler_certificates, vir.certificate_validations,
        vir.artifact_hash, vir.weave_manifest, vir.aspect_certificates,
        vir.weave_execution, inputs.rv32_formal, inputs.rv32_equivalence,
        inputs.rv32_sail, inputs.rv32_hwir_to_rtl,
        inputs.rv32_external_material, inputs.rv64_runner_config,
        inputs.release_evidence, inputs.release_material)
    run_fv2_wave6_orchestration_common_v2(fresh_config, independent_config,
        normalized, signing, Some(vir))
