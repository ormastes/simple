# WM Showcase Session — five real windows, a taskbar derived from them.
#
# MDSOC outer layer: this module owns the WM session (compositor + window
# lifecycle) and hands every business decision to the small pure helpers
# below. It adds no new WM/host seam — it consumes the ones that already
# exist:
#
#   * os.compositor.host_compositor_entry.HostCompositor  — the WM session
#     itself (headless lane), its `taskbar_model()` projection, and its
#     external-content-frame boundary.
#   * common.ui.wm_gui_content_frame                      — GUI + web producer
#     (see note on the "web" window's producer below)
#   * common.ui.pixel_surface_content_frame               — 2D producer
#   * std.gc_async_mut.gpu.browser_engine.simple_web_renderer — the Simple Web
#     HTML render path both the GUI and web windows go through
#   * common.ui.wm_full_stack_demo                        — the shared demo
#     widget tree and 2D scene, reused verbatim for two of the five windows.
#   * app.browser.render_adapter                          — Simple Browser
#     window's real HTML (browser chrome + Hello World home page)
#   * app.terminal.render_adapter                          — Simple Terminal
#     window's real HTML (terminal chrome + subcommand reference). Both
#     adapters use the shared app.ui.render.types contract ~20 sibling apps
#     already implement (see doc/00_llm_process/feature_expert/browser/skill.md).
#
# Web window producer note (2026-08-05): the WEB window's content is produced
# by the SAME `simple_web_render_html_to_readback_result_with_engine2d_backend`
# call the GUI window and the provenance probe already use, wrapped as a
# `WM_CONTENT_ORIGIN_GUI` frame via `wm_gui_content_frame_from_pixels` — NOT
# via `os.compositor.simple_web_window_renderer.simple_web_content_frame_cached`
# (the WM's themed content-frame path). That path is origin-gated by
# `wm_content_frame_web_provenance_valid`, which admits a frame only when its
# wrapper div's `backdrop-filter` parses as the EXACT two-term form
# `blur(Npx) saturate(M%)`. The wrapper `simple_web_content_render_request_with_
# theme` builds always applies class `widget-panel`, whose own backdrop-filter
# declaration (`glass_css_components.spl`) is `blur(var(--glass-blur-surface))`
# — one term, no saturate — so that path can never admit a frame regardless of
# body HTML. Filed as a concrete defect (not a TODO):
# doc/08_tracking/bug/wm_content_frame_web_provenance_unreachable_via_widget_panel.md.
# Rendering the web window through the same ungated HTML path the GUI window
# already uses keeps hard-bar rule #3 (depend on the rendering lane for all
# drawing) intact — it is the identical Simple Web renderer, same lane,
# disclosed by the same `wm_showcase_probe_provenance` receipt — without
# touching the shared renderer's theme/material plumbing, which is out of this
# showcase's scope and expensive to iterate on here (interpreted HTML renders
# cost 30-50 CPU-minutes each in this environment).
#
# The taskbar is NOT built here. `HostCompositor.taskbar_model()` projects it
# from `comp.windows`, so closing a window necessarily removes its entry and
# necessarily changes the composited frame. There is no list to fabricate.

use app.wm_showcase_host.host_compositor_entry.{HostCompositor}
use os.services.wm.wm_action.{WmAction}
use common.window_protocol.geometry.{Size}
use common.ui.taskbar_model.{TaskbarModel, WindowRef}
use common.ui.window_scene.{WmContentFrame}
use common.ui.window_scene_draw_ir.{shared_wm_browser_content_extra_height}
use common.ui.wm_gui_content_frame.{wm_gui_content_frame_from_pixels}
use common.ui.wm_chrome_theme.{active_wm_theme_id}
use nogc_sync_mut.ui.theme_package.{default_theme_id}
use common.ui.pixel_surface_content_frame.{pixel_surface_content_frame}
use common.ui.wm_full_stack_demo.{WmDemo2dState, wm_full_stack_demo_tree}
use common.ui.state.{init_state}
use app.wm_showcase_host.html_widgets.{render_html_tree}
use app.wm_showcase_host.render_types.{RenderConfig}
use app.wm_showcase_host.browser_adapter.{render_browser_html}
use app.wm_showcase_host.terminal_adapter.{render_terminal_html}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_resolved_engine2d_backend_name,
    simple_web_render_html_to_readback_result_with_engine2d_backend}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    simple_web_layout_set_render_budget_floor_ms,
    simple_web_layout_last_render_degrade_reason}

# The interpreter lane needs a budget wide enough that a real cascade finishes;
# the default trips at the first node and yields a blank page (see
# `_web_budget_expired_at` / doc 40c540fa850). 900_000 matches the sibling
# showcase suite.
val WM_SHOWCASE_RENDER_BUDGET_FLOOR_MS: i64 = 900000

# Desktop and window sizes are bounded by the CPU rasteriser, not by taste.
# The Simple Web layout renderer runs interpreted here and costs minutes at
# a few hundred pixels square, so all four HTML-backed windows are sized to
# the same 96x72 content the sibling web showcase suite uses. The 2D window
# is a pure pixel producer and can afford the full 240x90 demo scene.
val WM_SHOWCASE_DESKTOP_W: i32 = 480
# Tall enough that EVERY window's content rect clears the taskbar, which the
# compositor draws across the bottom `taskbar_height` (default 56) rows —
# `taskbar_y = height - taskbar_h`. The showcase reads content rects back
# byte-identically from the composite, so a window overlapping the taskbar is
# occluded and can never match.
#
# Lowest row is the 2D window at y=288 h=126, i.e. bottom edge 414, so the
# desktop must be at least 414 + 56 = 470. It was 430 (taskbar from y=374),
# which clipped the 2D window's bottom band: its rect happened to sit above
# y=374 and matched, while the surrounding field below y=374 did not.
# See doc/08_tracking/bug/wm_showcase_2d_window_refused_external_frame_slot_2026-08-06.md
val WM_SHOWCASE_DESKTOP_H: i32 = 480
val WM_SHOWCASE_HTML_CONTENT_W: i32 = 96
val WM_SHOWCASE_HTML_CONTENT_H: i32 = 72

val WM_SHOWCASE_KEY_GUI: text = "gui"
val WM_SHOWCASE_KEY_WEB: text = "web"
val WM_SHOWCASE_KEY_BROWSER: text = "browser"
val WM_SHOWCASE_KEY_TERMINAL: text = "terminal"
val WM_SHOWCASE_KEY_2D: text = "2d"

# Chrome geometry of a HostCompositor window, measured against the running
# compositor rather than assumed: content rect is
# (x + 4, y + 32, w - 8, h - 36 - browser_extra(app_id)).
val WM_SHOWCASE_CONTENT_INSET_X: i32 = 4
val WM_SHOWCASE_CONTENT_INSET_Y: i32 = 32

struct WmShowcaseWindowSpec:
    """One declared showcase window. `kind` selects the content producer."""
    key: text
    kind: text          # "gui" | "web" | "pixel"
    title: text
    app_id: text
    x: i32
    y: i32
    w: i32
    h: i32

fn wm_showcase_window_specs() -> [WmShowcaseWindowSpec]:
    """The five declared showcase windows. Laid out without overlap so each
    window's content rect can be read back unoccluded from the composite."""
    [
        WmShowcaseWindowSpec(
            key: WM_SHOWCASE_KEY_GUI, kind: "gui",
            title: "GUI Widget Showcase", app_id: "org.simple.showcase.gui",
            x: 16, y: 40,
            w: WM_SHOWCASE_HTML_CONTENT_W + 8,
            h: WM_SHOWCASE_HTML_CONTENT_H + 36
        ),
        WmShowcaseWindowSpec(
            key: WM_SHOWCASE_KEY_WEB, kind: "web",
            title: "Web Render Showcase", app_id: "org.simple.showcase.web",
            x: 136, y: 40,
            w: WM_SHOWCASE_HTML_CONTENT_W + 8,
            h: WM_SHOWCASE_HTML_CONTENT_H + 36
        ),
        WmShowcaseWindowSpec(
            key: WM_SHOWCASE_KEY_BROWSER, kind: "browser",
            title: "Simple Browser", app_id: "org.simple.showcase.browser",
            x: 16, y: 164,
            w: WM_SHOWCASE_HTML_CONTENT_W + 8,
            h: WM_SHOWCASE_HTML_CONTENT_H + 36
        ),
        WmShowcaseWindowSpec(
            key: WM_SHOWCASE_KEY_TERMINAL, kind: "terminal",
            title: "Simple Terminal", app_id: "org.simple.showcase.terminal",
            x: 136, y: 164,
            w: WM_SHOWCASE_HTML_CONTENT_W + 8,
            h: WM_SHOWCASE_HTML_CONTENT_H + 36
        ),
        WmShowcaseWindowSpec(
            key: WM_SHOWCASE_KEY_2D, kind: "pixel",
            title: "2D Surface Showcase", app_id: "org.simple.showcase.2d",
            x: 16, y: 288, w: 248, h: 126
        ),
    ]

# ---------------------------------------------------------------------------
# Content producers — one per window kind
# ---------------------------------------------------------------------------

# The full `generate_css(theme)` token sheet is several hundred rules. Cascade
# cost is rules x nodes, and against the demo widget tree that alone runs for
# tens of minutes interpreted — the render never reaches paint. This sheet is
# deliberately small while still being class/id-selector driven, so the page
# still routes through the genuine cascade + block-layout + paint path rather
# than any pinned hand-drawn stub.
#
# `{` and `}` must be escaped as `{{` / `}}`: an unescaped brace in a text
# literal is parsed as string interpolation, so a CSS block reads as a
# reference to a variable named after its first property.
fn _showcase_gui_css() -> text:
    ".widget-label{{color:#0b1f33;font-size:8px}}" +
        ".widget-button{{background:#0066cc;color:#ffffff}}" +
        ".widget-panel{{background:#f5f5f5}}" +
        "#showcase-gui-root{{background:#ffffff}}"

fn wm_showcase_gui_html() -> text:
    """The shared full-stack WM demo widget tree (labels, image, text field,
    button, scroll list, two render surfaces) as HTML. Reuses
    common.ui.wm_full_stack_demo verbatim; nothing showcase-specific is
    invented here."""
    val tree = wm_full_stack_demo_tree("Ready", "Run demo", "Simple123")
    val state = init_state(tree)
    val body = render_html_tree(state.tree.root_node(), state)
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n" +
        "<title>GUI Widget Showcase</title>\n<style>" +
        _showcase_gui_css() + "</style>\n" +
        "</head>\n<body>\n<div id=\"showcase-gui-root\">" + body +
        "</div>\n</body>\n</html>"

# `{` and `}` must be escaped as `{{` / `}}` — see the note on `_showcase_gui_css`.
fn _showcase_web_css() -> text:
    ".showcase-web-title{{color:#0b1f33;font-size:10px}}" +
        ".showcase-web-lede{{color:#33475b;font-size:8px}}" +
        ".showcase-web-page{{background:#eef3f9}}"

fn wm_showcase_web_body_html() -> text:
    """Body markup for the web-render window. Class selectors only, so the
    renderer routes it through the genuine cascade + block-layout + paint path
    rather than a pinned hand-drawn stub. Deliberately three elements and a
    four-rule sheet — the same size budget as the GUI window's own page — so
    the render finishes in minutes rather than tens of minutes interpreted."""
    "<div class=\"showcase-web-page\">" +
        "<h1 class=\"showcase-web-title\">Simple Web Showcase</h1>" +
        "<p class=\"showcase-web-lede\">Cascaded, laid out and painted.</p>" +
        "</div>"

fn wm_showcase_web_html() -> text:
    """Full document for the web-render window, mirroring `wm_showcase_gui_html`'s
    structure (own small stylesheet, own doctype/head/body) so both HTML-backed
    windows go through the identical genuine cascade + layout + paint path at
    the identical cost budget."""
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n" +
        "<title>Web Render Showcase</title>\n<style>" +
        _showcase_web_css() + "</style>\n</head>\n<body>" +
        wm_showcase_web_body_html() + "</body>\n</html>"

# `render_browser_html`/`render_terminal_html` already return a complete
# document (doctype/head/style/body) via `app.ui.render.html.html_page` — no
# extra wrapping needed, unlike the two hand-rolled pages above.
fn wm_showcase_browser_html() -> text:
    """Simple Browser's real render_adapter output at its default URL
    (`simple://home`, the Hello World page) — the SAME app.ui.render
    contract every sibling app (terminal, ide tools, ...) uses. Routed
    through the identical cascade + layout + paint path as the other
    HTML-backed windows; nothing about this window is a pixel shortcut."""
    render_browser_html(RenderConfig.html_export()).html_output

fn wm_showcase_terminal_html() -> text:
    """Simple Terminal's real render_adapter output — same contract,
    same rendering path as the browser window above."""
    render_terminal_html(RenderConfig.html_export()).html_output

val WM_SHOWCASE_2D_HOME_X: i32 = 24
val WM_SHOWCASE_2D_HOME_Y: i32 = 24

fn wm_showcase_2d_pixels_at(
    width: i32, height: i32, rect_x: i32, rect_y: i32
) -> [u32]:
    """The shared full-stack demo's 2D scene with its draggable rect at
    (rect_x, rect_y) in the scene's own 240x90 space."""
    val scene = WmDemo2dState(
        rect_x: rect_x, rect_y: rect_y, dragging: false,
        drag_offset_x: 0, drag_offset_y: 0
    )
    scene.pixels(width, height)

fn wm_showcase_2d_pixels(width: i32, height: i32) -> [u32]:
    """The 2D scene in its home position."""
    wm_showcase_2d_pixels_at(
        width, height, WM_SHOWCASE_2D_HOME_X, WM_SHOWCASE_2D_HOME_Y
    )

# ---------------------------------------------------------------------------
# Pure pixel helpers
# ---------------------------------------------------------------------------

fn wm_showcase_checksum(pixels: [u32]) -> i64:
    var sum: i64 = 0
    var i = 0
    val n = pixels.len()
    while i < n:
        sum = sum + (pixels[i] as i64) * ((i + 1) as i64)
        i = i + 1
    sum

fn wm_showcase_distinct_colors(pixels: [u32]) -> i32:
    var seen: Dict<text, bool> = {}
    var count = 0
    var i = 0
    val n = pixels.len()
    while i < n:
        val key = pixels[i].to_string()
        # Never infer membership from Dict.get() under native codegen.
        if not seen.contains_key(key):
            seen[key] = true
            count = count + 1
        i = i + 1
    count

fn wm_showcase_count_color(pixels: [u32], color: u32) -> i32:
    var count = 0
    var i = 0
    val n = pixels.len()
    while i < n:
        if pixels[i] == color:
            count = count + 1
        i = i + 1
    count

fn wm_showcase_rect_matches(
    frame: [u32], frame_w: i32, rect_x: i32, rect_y: i32,
    rect_w: i32, rect_h: i32, expected: [u32]
) -> bool:
    """True when `expected` appears byte-identical at (rect_x, rect_y) in the
    composited desktop. This is what proves a window RENDERED: nothing about
    it can be fabricated by a producer that never ran."""
    if rect_w <= 0 or rect_h <= 0:
        return false
    if expected.len() != rect_w * rect_h:
        return false
    var y = 0
    while y < rect_h:
        var x = 0
        while x < rect_w:
            val at = (rect_y + y) * frame_w + rect_x + x
            if at < 0 or at >= frame.len():
                return false
            if frame[at] != expected[y * rect_w + x]:
                return false
            x = x + 1
        y = y + 1
    true

# ---------------------------------------------------------------------------
# Provenance — a frame is device-produced only when the readback proves it
# ---------------------------------------------------------------------------

struct WmShowcaseProvenance:
    """Honest disclosure of which lane produced the showcase pixels.

    `resolved_backend` is only what the backend resolver SELECTED; it says
    nothing about what executed. `device_proven` mirrors the renderer's own
    `_web_gpu_readback_device_proven`: source == device_readback AND handle > 0
    AND identity > 0 AND pixel_count == frame pixels. Anything else is a CPU
    frame and must be reported as one."""
    resolved_backend: text
    readback_source: text
    backend_handle: i64
    device_identity: i64
    readback_pixel_count: i64
    expected_pixel_count: i64
    device_proven: bool
    render_degraded: bool
    degrade_reason: text
    lane: text          # "gpu-device" | "cpu"

fn wm_showcase_probe_provenance(width: i32, height: i32) -> WmShowcaseProvenance:
    """Render a small probe through the same renderer the web window uses and
    report what actually came back."""
    val resolved = simple_web_resolved_engine2d_backend_name(width, height, "auto")
    # Braces escaped as `{{` / `}}` — an unescaped brace in a text literal is
    # parsed as string interpolation, so a CSS block reads as a reference to a
    # variable named after its first property.
    val html = "<html><head><style>.p{{background:#2563eb;width:8px;" +
        "height:8px}}</style></head><body><div class=\"p\">p</div></body></html>"
    val result = simple_web_render_html_to_readback_result_with_engine2d_backend(
        html, width, height, "auto"
    )
    val expected = (width as i64) * (height as i64)
    val proven = (
        result.readback.source == "device_readback" and
        result.readback.backend_handle > 0 and
        result.readback.device_identity > 0 and
        result.readback.pixel_count == expected
    )
    WmShowcaseProvenance(
        resolved_backend: resolved,
        readback_source: result.readback.source,
        backend_handle: result.readback.backend_handle,
        device_identity: result.readback.device_identity,
        readback_pixel_count: result.readback.pixel_count,
        expected_pixel_count: expected,
        device_proven: proven,
        render_degraded: result.render_degraded,
        degrade_reason: simple_web_layout_last_render_degrade_reason(),
        lane: if proven: "gpu-device" else: "cpu"
    )

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

struct WmShowcaseOpenWindow:
    """A window the session actually opened, plus the exact content pixels it
    handed the compositor (kept so the capture can prove they landed)."""
    key: text
    window_id: i64
    title: text
    app_id: text
    content_x: i32
    content_y: i32
    content_w: i32
    content_h: i32
    content_pixels: [u32]
    frame_accepted: bool
    reject_reason: text

struct WmShowcaseCapture:
    """One composited desktop frame plus the receipts that make it checkable.

    Per-example receipts only: cross-example tallying via a module `var` or a
    class field reads back 0 immediately after the bump on this runtime."""
    width: i32
    height: i32
    pixels: [u32]
    checksum: i64
    distinct_colors: i32
    declared_windows: i32
    open_windows: i32
    rendered_windows: i32
    taskbar_entries: i32
    taskbar_titles: text

class WmShowcaseSession:
    comp: HostCompositor
    opened: [WmShowcaseOpenWindow]
    revision: i64
    # Session-scoped, deliberately NOT per-open. The web window issues a
    # byte-identical HTML render request on every open — same document, same
    # size — and the interpreted render costs whole minutes here (see
    # `wm_showcase_web_html`'s doc). A session-scoped memo turns the re-open
    # (the sabotage-restore arm) into a reuse of the FIRST open's own pixels
    # rather than a second full render. Nothing about the re-open is faked: it
    # is the same producer, the same request, and the cache is keyed on that
    # request's own dimensions never changing mid-session.
    web_pixels_cache: [u32]

impl WmShowcaseSession:
    static fn start(width: i32, height: i32) -> WmShowcaseSession:
        simple_web_layout_set_render_budget_floor_ms(
            WM_SHOWCASE_RENDER_BUDGET_FLOOR_MS
        )
        WmShowcaseSession(
            comp: HostCompositor.new_headless(
                Size(width: width as i64, height: height as i64)
            ),
            opened: [],
            revision: 0,
            web_pixels_cache: []
        )

    me open_all() -> i32:
        var count = 0
        for spec in wm_showcase_window_specs():
            # Per-window marker: each content producer runs interpreted and
            # costs minutes, so without this a slow open is indistinguishable
            # from a hang.
            print "wm_showcase_stage opening={spec.key}"
            if self.open_window(spec):
                count = count + 1
        count

    me open_window(spec: WmShowcaseWindowSpec) -> bool:
        self.comp.apply_wm_action(WmAction(
            kind: "create_window", window_id: 0, title: spec.title,
            x: spec.x, y: spec.y, width: spec.w, height: spec.h,
            content: "", process_id: 1000, app_id: spec.app_id,
            owner_port: 1, src_port: 1
        ))
        val index = self.comp.windows.len() - 1
        if index < 0:
            return false
        val window_id = self.comp.windows[index].id
        val content_w = spec.w - 8
        val content_h = spec.h - 36 -
            shared_wm_browser_content_extra_height(spec.app_id)
        if content_w <= 0 or content_h <= 0:
            return false
        self.revision = self.revision + 1
        val revision = self.revision
        if not self.comp.require_external_web_frame(window_id):
            self._record(spec, window_id, content_w, content_h, [], false,
                "external-frame-slot-refused")
            return false
        val produced = _produce_frame(
            spec, window_id, content_w, content_h, revision,
            self.web_pixels_cache
        )
        if spec.kind == "web" and produced.web_pixels.len() > 0:
            self.web_pixels_cache = produced.web_pixels
        # Producer-side theme stamp: the compositor's acceptance gate compares
        # frame.theme_id against its authoritative content theme resolution
        # (active theme, falling back to the registry default). Frames without
        # the stamp are rejected wholesale.
        var stamped = produced.frame
        stamped.theme_id = _wm_showcase_content_theme_id()
        val accepted = self.comp.set_external_web_frame(window_id, stamped)
        self._record(
            spec, window_id, content_w, content_h, produced.frame.pixels,
            accepted,
            if accepted: "" else: produced.reason
        )
        accepted

    me _record(
        spec: WmShowcaseWindowSpec, window_id: i64, content_w: i32,
        content_h: i32, pixels: [u32], accepted: bool, reason: text
    ):
        self.opened.push(WmShowcaseOpenWindow(
            key: spec.key,
            window_id: window_id,
            title: spec.title,
            app_id: spec.app_id,
            content_x: spec.x + WM_SHOWCASE_CONTENT_INSET_X,
            content_y: spec.y + WM_SHOWCASE_CONTENT_INSET_Y,
            content_w: content_w,
            content_h: content_h,
            content_pixels: pixels,
            frame_accepted: accepted,
            reject_reason: reason
        ))

    me close_window(key: text) -> bool:
        var found = false
        var kept: [WmShowcaseOpenWindow] = []
        for entry in self.opened:
            if entry.key == key:
                self.comp.destroy_window(entry.window_id)
                found = true
            else:
                kept.push(entry)
        self.opened = kept
        found

    me move_2d_scene(rect_x: i32, rect_y: i32) -> bool:
        """Re-render the 2D window's scene with its rect moved and hand the
        compositor the new frame. Used to prove capture mutation sensitivity:
        a changed scene must change the captured desktop."""
        var index = 0
        var found = -1
        while index < self.opened.len():
            if self.opened[index].key == WM_SHOWCASE_KEY_2D:
                found = index
            index = index + 1
        if found < 0:
            return false
        val entry = self.opened[found]
        self.revision = self.revision + 1
        val pixels = wm_showcase_2d_pixels_at(
            entry.content_w, entry.content_h, rect_x, rect_y
        )
        val frame = pixel_surface_content_frame(
            window_id: "{entry.window_id}", parent_window_id: "",
            offset_x: 0, offset_y: 0,
            width: entry.content_w, height: entry.content_h,
            pixels: pixels,
            scene_revision: self.revision, content_revision: self.revision
        )
        # Same producer-side theme stamp as open_window: unstamped frames are
        # rejected by the compositor's theme acceptance axis.
        var stamped_move = frame
        stamped_move.theme_id = _wm_showcase_content_theme_id()
        if not self.comp.set_external_web_frame(entry.window_id, stamped_move):
            return false
        var updated = entry
        updated.content_pixels = pixels
        self.opened[found] = updated
        true

    fn taskbar_model() -> TaskbarModel:
        """Derived, never fabricated: the compositor projects this from its
        live window list."""
        self.comp.taskbar_model()

    fn taskbar_titles() -> [text]:
        var out: [text] = []
        for entry in self.comp.taskbar_model().running:
            out.push(entry.title)
        out

    fn taskbar_has_title(title: text) -> bool:
        for entry in self.comp.taskbar_model().running:
            if entry.title == title:
                return true
        false

    me capture() -> WmShowcaseCapture:
        self.comp.render_frame()
        val pixels = self.comp.pure_simple_pixel_buffer()
        val width = self.comp.width
        var rendered = 0
        var titles = ""
        var unmatched = ""
        for entry in self.opened:
            if entry.frame_accepted and wm_showcase_rect_matches(
                pixels, width, entry.content_x, entry.content_y,
                entry.content_w, entry.content_h, entry.content_pixels
            ):
                rendered = rendered + 1
            elif entry.frame_accepted:
                # An accepted frame that does not read back byte-identically is
                # the interesting case: the window was admitted and composited
                # but its content rect is wrong (bad inset, occlusion, chrome
                # offset). Name it — a bare count cannot be acted on.
                val item = "{entry.key}@{entry.content_x},{entry.content_y}+{entry.content_w}x{entry.content_h}"
                unmatched = if unmatched == "": item else: unmatched + "|" + item
        if unmatched != "":
            print "wm_showcase_rect_unmatched {unmatched}"
        for title in self.taskbar_titles():
            titles = if titles == "": title else: titles + "|" + title
        WmShowcaseCapture(
            width: width,
            height: self.comp.height,
            pixels: pixels,
            checksum: wm_showcase_checksum(pixels),
            distinct_colors: wm_showcase_distinct_colors(pixels),
            declared_windows: wm_showcase_window_specs().len(),
            open_windows: self.comp.windows.len(),
            rendered_windows: rendered,
            taskbar_entries: self.comp.taskbar_model().running.len(),
            taskbar_titles: titles
        )

struct _ProducedFrame:
    frame: WmContentFrame
    reason: text
    # Only meaningful for kind=="web": the pixels used (fresh render or cache
    # reuse), so the caller can refresh the session-level memo. Empty for the
    # other two kinds.
    web_pixels: [u32]

fn _produce_frame(
    spec: WmShowcaseWindowSpec, window_id: i64, content_w: i32,
    content_h: i32, revision: i64, web_pixels_cache: [u32]
) -> _ProducedFrame:
    val window_key = "{window_id}"
    if spec.kind == "pixel":
        return _ProducedFrame(
            frame: pixel_surface_content_frame(
                window_id: window_key, parent_window_id: "",
                offset_x: 0, offset_y: 0,
                width: content_w, height: content_h,
                pixels: wm_showcase_2d_pixels(content_w, content_h),
                scene_revision: revision, content_revision: revision
            ),
            reason: "pixel-surface-frame-rejected",
            web_pixels: []
        )
    if spec.kind == "web":
        # Reuse the session's memoized pixels when they match this window's
        # own content size (see WmShowcaseSession.web_pixels_cache doc); only
        # a genuinely fresh dimension forces a re-render.
        val pixels = if web_pixels_cache.len() == content_w * content_h:
            web_pixels_cache
        else:
            simple_web_render_html_to_readback_result_with_engine2d_backend(
                wm_showcase_web_html(), content_w, content_h, "auto"
            ).readback.pixels
        return _ProducedFrame(
            frame: wm_gui_content_frame_from_pixels(
                window_key, "", 0, 0, content_w, content_h,
                pixels, revision, revision
            ),
            reason: "web-frame-rejected",
            web_pixels: pixels
        )
    if spec.kind == "browser":
        val result = simple_web_render_html_to_readback_result_with_engine2d_backend(
            wm_showcase_browser_html(), content_w, content_h, "auto"
        )
        return _ProducedFrame(
            frame: wm_gui_content_frame_from_pixels(
                window_key, "", 0, 0, content_w, content_h,
                result.readback.pixels, revision, revision
            ),
            reason: "browser-frame-rejected",
            web_pixels: []
        )
    if spec.kind == "terminal":
        val result = simple_web_render_html_to_readback_result_with_engine2d_backend(
            wm_showcase_terminal_html(), content_w, content_h, "auto"
        )
        return _ProducedFrame(
            frame: wm_gui_content_frame_from_pixels(
                window_key, "", 0, 0, content_w, content_h,
                result.readback.pixels, revision, revision
            ),
            reason: "terminal-frame-rejected",
            web_pixels: []
        )
    val result = simple_web_render_html_to_readback_result_with_engine2d_backend(
        wm_showcase_gui_html(), content_w, content_h, "auto"
    )
    _ProducedFrame(
        frame: wm_gui_content_frame_from_pixels(
            window_key, "", 0, 0, content_w, content_h,
            result.readback.pixels, revision, revision
        ),
        reason: "gui-frame-rejected",
        web_pixels: []
    )

fn _wm_showcase_content_theme_id() -> text:
    """Mirror the compositor's authoritative content-theme resolution
    (active theme id, or the registry default before any theme installs)."""
    val active = active_wm_theme_id()
    if active != "": active else: default_theme_id()
