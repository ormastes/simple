# WM Showcase CLI entry — run the scripted session and write the artifact.
#
#   bin/simple run src/app/wm_showcase/main.spl
#
# Prints the same receipt lines the system gate asserts over, then leaves a
# viewable PPM and a provenance sidecar under build/tmp/wm_showcase/.

use app.wm_showcase.run.{wm_showcase_run, wm_showcase_run_report}

fn main():
    print wm_showcase_run_report(wm_showcase_run())
