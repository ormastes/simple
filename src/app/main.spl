# App root placeholder entrypoint.
#
# Real CLI commands live under src/app/<command>/main.spl. This root module
# stays startup-light so direct source-run probes have deterministic behavior.

use std.cli.cli_util.{get_cli_args}
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use app.startup.dynsmf_autoload.{dynsmf_startup_summary,
    dynsmf_startup_artifact_status_lines,
    product_dynload_startup,
    product_dynload_startup_metrics_line
}

fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("app-root", log_opts.error)
        return 1
    # Startup ordering: decode the command FIRST. dynSMF (and any other
    # dynamic-library machinery) is initialized only by the command branch
    # that actually needs it, so no-op/--help/--version-class commands pay
    # nothing for it.
    val args = app_root_clean_log_args(raw_args)
    if args.len() == 0:
        if log_opts.log_mode == "json":
            print "{\"command\":\"app-root\",\"status\":\"ready\"}"
        return 0

    if app_root_startup_io_budget(args) == 1:
        # The product path has one checked-dynSMF lifecycle owner and admits
        # config through validated cached SMF artifacts. SIMPLE_ASPECT_PACKS
        # stays on its explicit CLI compatibility path so an unset raw-pack
        # knob cannot expand this source-run import closure.
        val startup = product_dynload_startup(raw_args, "app-root")
        val dynsmf_session = startup.session
        print dynsmf_startup_summary(dynsmf_session)
        var idx = 0
        val evidence_count = dynsmf_session.evidence.len()
        while idx < evidence_count:
            print dynsmf_session.evidence[idx].to_text()
            idx = idx + 1
        print "dynsmf artifact status:"
        val status_lines = dynsmf_startup_artifact_status_lines()
        var status_idx = 0
        val status_count = status_lines.len()
        while status_idx < status_count:
            print status_lines[status_idx]
            status_idx = status_idx + 1
        print product_dynload_startup_metrics_line(startup.metrics)
        val startup_exit = startup.exit_code
        val startup_error = startup.error
        val close_ok = startup.close()
        val final_exit = app_root_startup_exit_code(startup_exit, close_ok)
        if not close_ok:
            error("app-root", startup.error)
            return final_exit
        if final_exit != 0:
            error("app-root", startup_error)
        return final_exit

    if args[0] == "--help" or args[0] == "-h" or args[0] == "help":
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_app_root_help()
        return 0

    if log_opts.log_mode == "json":
        print "{\"command\":\"app-root\",\"status\":\"error\",\"error\":\"unknown option\"}"
        return 1
    print "error: unknown option: {args[0]}"
    print_app_root_help()
    1

fn print_app_root_help():
    print "Simple app root entrypoint"
    print ""
    print "USAGE:"
    print "  simple run src/app/main.spl [options]"
    print ""
    print "Real CLI commands live under src/app/<command>/main.spl."
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"
    print ""
    print "dynSMF startup options:"
    print "  --dynsmf-status"
    print "  --no-dynsmf"
    print "  --disable-dynsmf=<ids>"
    print "  --dynload-config=<path>       select startup extension config"
    print "  --dynload=<id>:<axis-spec>    override one extension setting (repeatable)"
    print "  SIMPLE_DYNLOAD_CONFIG=<path>  checked dynSMF config"
    print "  SIMPLE_ASPECT_PACKS=<paths>   raw APK compatibility path"

fn app_root_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn app_root_is_dynsmf_option(arg: text) -> bool:
    arg == "--no-dynsmf" or arg == "--disable-dynsmf" or arg.starts_with("--disable-dynsmf=")

fn app_root_is_dynload_value_option(arg: text) -> bool:
    arg == "--dynload-config" or arg == "--dynload"

fn app_root_is_dynload_option(arg: text) -> bool:
    app_root_is_dynload_value_option(arg) or
        arg.starts_with("--dynload-config=") or arg.starts_with("--dynload=")

fn app_root_is_entry_script(arg: text) -> bool:
    # In the `simple run <abs-path>/src/app/main.spl` form, argv retains the
    # entry-script path as the first argument. Drop it like the sibling app
    # roots (check/pkg/context/cli_debug) so options after it are parsed.
    arg.ends_with("/app/main.spl") or arg == "src/app/main.spl"

pub fn app_root_requires_product_dynload(args: [text]) -> bool:
    args.len() > 0 and args[0] == "--dynsmf-status"

pub fn app_root_startup_io_budget(args: [text]) -> i64:
    if app_root_requires_product_dynload(args): 1 else: 0

pub fn app_root_startup_exit_code(startup_exit: i64, close_ok: bool) -> i64:
    if not close_ok: 1 else: startup_exit

fn app_root_clean_log_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    val arg_count = args.len()
    while i < arg_count:
        val arg = args[i]
        if app_root_is_entry_script(arg):
            i = i + 1
            continue
        if app_root_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        elif app_root_is_dynsmf_option(arg):
            if arg == "--disable-dynsmf":
                i = i + 1
        elif app_root_is_dynload_option(arg):
            if app_root_is_dynload_value_option(arg):
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned
