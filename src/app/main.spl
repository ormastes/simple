# App root placeholder entrypoint.
#
# Real CLI commands live under src/app/<command>/main.spl. This root module
# stays startup-light so direct source-run probes have deterministic behavior.

use std.cli.cli_util.{get_cli_args}
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}
use os.smf.dynsmf_session.{dynsmf_default_manifest}
use os.smf.dynsmf_trust_registry.{
    dynsmf_admitted_registry_load,
    dynsmf_trust_registry_default_path
}
use app.startup.dynsmf_autoload.{
    dynsmf_startup_session_with_registry_dynload_config,
    dynsmf_dynload_config_default_path,
    dynsmf_startup_summary,
    dynsmf_startup_artifact_status_lines_for_manifest
}
use app.startup.option_router.{
    app_root_option_plan_v1,
    app_root_startup_option_help_lines_v1
}
use app.startup.component_dynsmf_wiring.{
    component_dynsmf_startup_from_registry_config_path,
    component_dynsmf_result_render
}

fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("app-root", log_opts.error)
        return 1
    # Startup ordering: decode the command FIRST. dynSMF (and any other
    # dynamic-library machinery) is initialized only by the command branch
    # that actually needs it, so no-op/--help/--version-class commands pay
    # nothing for it.
    val option_plan = app_root_option_plan_v1(raw_args)
    if not option_plan.ok:
        error("app-root", option_plan.error)
        return 1
    val args = option_plan.routed_args
    if args.len() == 0 and not option_plan.component_configured:
        if log_opts.log_mode == "json":
            print "{\"command\":\"app-root\",\"status\":\"ready\"}"
        return 0

    if app_root_startup_io_budget(args) == 1:
        # The product path has one checked-dynSMF lifecycle owner and admits
        # config through validated cached SMF artifacts. SIMPLE_ASPECT_PACKS
        # stays on its explicit CLI compatibility path so an unset raw-pack
        # knob cannot expand this source-run import closure.
        val startup = product_dynload_startup(raw_args, "app-root")
        val dynsmf_session = startup.session
        print dynsmf_startup_summary(dynsmf_session)
        var idx = 0
        while idx < dynsmf_session.evidence.len():
            print dynsmf_session.evidence[idx].to_text()
            idx = idx + 1
        print "dynsmf artifact status:"
        val status_lines = dynsmf_startup_artifact_status_lines()
        var status_idx = 0
        while status_idx < status_lines.len():
            print status_lines[status_idx]
            status_idx = status_idx + 1
        print product_dynload_startup_metrics_line(startup.metrics)
        val startup_exit = startup.exit_code
        val startup_error = startup.error
        val close_ok = startup.close()
        val final_exit = app_root_startup_exit_code(startup_exit, close_ok)
        if not close_ok:
            error("app-root", startup.error)
            return final_exit
        if final_exit != 0:
            error("app-root", startup_error)
        return final_exit

    if args[0] == "--help" or args[0] == "-h" or args[0] == "help":
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_app_root_help()
        return 0

    if command == "--version" or command == "-v" or command == "version":
        print "Simple app root entrypoint"
        return 0

    # Everything below is a real startup command. The OS trust owner reads its
    # exact config and each configured artifact once, retaining the admitted
    # byte images for both ordinary and component startup.
    val dynsmf_manifest = dynsmf_default_manifest()
    val dynsmf_registry = dynsmf_admitted_registry_load(
        dynsmf_manifest,
        dynsmf_trust_registry_default_path())
    val dynsmf_session = dynsmf_startup_session_with_registry_dynload_config(
        raw_args,
        "app-root",
        dynsmf_manifest,
        dynsmf_dynload_config_default_path(),
        dynsmf_registry)

    if command == "--dynsmf-status":
        if dynsmf_registry.ok:
            print "dynsmf admission=configured status=admitted artifacts=" + dynsmf_registry.artifacts.len().to_text()
        else:
            print "dynsmf admission=unconfigured status=fail_closed reason=" + dynsmf_registry.reason
        print dynsmf_startup_summary(dynsmf_session)
        var idx = 0
        while idx < dynsmf_session.evidence.len():
            print dynsmf_session.evidence[idx].to_text()
            idx = idx + 1
        print "dynsmf artifact status:"
        val status_lines = dynsmf_startup_artifact_status_lines_for_manifest(dynsmf_manifest)
        var status_idx = 0
        while status_idx < status_lines.len():
            print status_lines[status_idx]
            status_idx = status_idx + 1
        return 0

    if not option_plan.component_config_ok:
        print "component startup error:config_option_invalid:" + option_plan.component_config_error
        return 1

    if option_plan.component_configured:
        val component_result = component_dynsmf_startup_from_registry_config_path(
            dynsmf_session,
            dynsmf_manifest,
            option_plan.component_config_path,
            dynsmf_registry)
        print "component startup " + component_dynsmf_result_render(component_result)
        if component_result.ok:
            return 0
        return 1
    elif command == "--component-status":
        print "component startup error:config_file_not_configured"
        return 1

    if log_opts.log_mode == "json":
        print "{\"command\":\"app-root\",\"status\":\"error\",\"error\":\"unknown option\"}"
        return 1
    print "error: unknown option: {command}"
    print_app_root_help()
    1

fn print_app_root_help():
    print "Simple app root entrypoint"
    print ""
    print "USAGE:"
    print "  simple run src/app/main.spl [options]"
    print ""
    print "Real CLI commands live under src/app/<command>/main.spl."
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"
    print ""
    for line in app_root_startup_option_help_lines_v1():
        print line
