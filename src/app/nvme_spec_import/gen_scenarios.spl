"""
gen_scenarios — emit SSpec scenario scaffolding, one spec file per mandatory
NVMe feature, with one `it` block per test obligation (positive, negative,
reset, fault, persistence).

THE RULE THIS GENERATOR EXISTS TO OBEY: a generated scenario must never contain
an assertion that passes because it checks nothing. Each obligation cell is
emitted in exactly one of two shapes.

  COVERED — the cell has an evidence binding (`obligations.spl`). The block runs
  the bound program with `process_run` and asserts the bound verdict token. This
  is the house idiom of `nvme_emu_fault_recovery_spec.spl`, including its rule
  that the process exit code is never the signal, because `bin/simple run`
  returns garbage for `fn main() -> ()`.

  BLOCKED — the cell has no binding. The block is named `BLOCKED:` and asserts
  that `spec/nvme/coverage.sdn` still records this exact cell as pending with
  this exact blocker text. That is a real assertion with a real way to fail: it
  goes red the moment somebody edits the ledger without regenerating, and it
  keeps the blocker text from rotting. It deliberately does NOT assert anything
  about the device, because there is nothing about the device to assert - that
  is what blocked means.

A blocked block is therefore evidence of an ADMITTED GAP, not of a capability.
No generated file may be read as a conformance claim; each states so in its own
Claim Boundary section, which is copied into the file rather than referenced so
it cannot be separated from the scenario.
"""

use text_norm.*
use feature_map.*
use obligations.*
use clause_scan.*

struct GenFile:
    path:    text
    content: text

struct GenStats:
    files:    i64
    covered:  i64
    blocked:  i64

struct GenResult:
    files: [GenFile]
    stats: GenStats

# A literal brace cannot be written inside an interpolating string, so the two
# are held as values and concatenated where generated source needs them.
val LB: text = "{"
val RB: text = "}"

val GEN_DIR: text = "test/03_system/app/nvme_firmware/generated/"
val LEDGER: text = "spec/nvme/coverage.sdn"

"""Escape a value for embedding in generated Simple source as a literal."""
fn lit(s: text) -> text:
    "\"" + sdn_escape(s) + "\""

fn obligation_sentence(ob: text) -> text:
    if ob == OB_POSITIVE:
        return "issue the well-formed command and observe the spec-shaped completion and state effect"
    if ob == OB_NEGATIVE:
        return "issue the malformed variant and observe the correct error status with NO state change"
    if ob == OB_RESET:
        return "perform the operation, reset, and observe the spec's reset-survival rules"
    if ob == OB_FAULT:
        return "perform the operation under injected failure and observe an error status plus correct health accounting"
    "perform the operation, power-cycle, and observe that durable effects survive"

fn gen_one(f: NvmeFeature, clause_count: i64) -> GenFile:
    val obs = obligation_list()
    var grade: text = "host-equivalent transport (SQE in queue memory, doorbell, phase-tagged CQE poll)"
    if f.status == FEATURE_STATUS_DISPATCH:
        grade = "DISPATCH LEVEL ONLY - the controller entry point is called directly, which is NOT host-equivalent."
    elif f.status == FEATURE_STATUS_BLOCKED:
        grade = "NONE - this feature is blocked: " + f.blocker

    var s: text = "# GENERATED FILE - do not edit by hand.\n"
    s = s + "# Generated by: src/app/nvme_spec_import (bin/simple run src/app/nvme_spec_import/main.spl generate)\n"
    s = s + "# Regenerate after changing src/app/nvme_spec_import/obligations.spl or feature_map.spl.\n"
    s = s + "# Purpose and audience: executable specification evidence for the owning engineering team.\n"
    s = s + "# @req REQ-SSPEC-SYSTEM\n"
    s = s + "# @tag: system, nvme, generated, mandatory-feature\n"
    s = s + "\n\"\"\"\n"
    s = s + "Mandatory NVMe feature: " + f.title + " (class " + "{f.class_num}" + ").\n\n"
    s = s + "One block per test obligation. Evidence level available today:\n" + grade + "\n\n"
    s = s + "Extracted clause records mapped onto this feature: " + "{clause_count}" + "\n"
    s = s + "(see spec/nvme/clauses.sdn; the clause ledger carries identifiers and\n"
    s = s + "generated paraphrases only - no specification prose is in this repository).\n\n"
    s = s + "CLAIM BOUNDARY. This file does not prove NVMe conformance. It proves that\n"
    s = s + "the named in-tree programs ran and printed the named verdict tokens, on a\n"
    s = s + "host-model Simple run. It does not prove a linked firmware image, a QEMU or\n"
    s = s + "board execution, PCIe interoperability, byte-accurate Identify or log-page\n"
    s = s + "layouts, real 4 KiB payloads, or power-loss durability at media fidelity.\n"
    s = s + "Blocks named BLOCKED assert an admitted gap in the coverage ledger; they are\n"
    s = s + "not evidence that the feature works.\n"
    s = s + "\"\"\"\n\n"
    s = s + "use std.spec.step\n\nuse std.spec.*\n"
    s = s + "use std.io_runtime." + LB + "process_run" + RB + "\n"
    s = s + "use std.fs." + LB + "read_file" + RB + "\n\n"
    s = s + "fn _run(cmd: text) -> (text, text, i64):\n    process_run(\"/bin/sh\", [\"-c\", cmd])\n\n"
    s = s + "describe \"NVMe mandatory feature: " + sdn_escape(f.title) + "\":\n"

    var covered: i64 = 0
    var blocked: i64 = 0
    var o: i64 = 0
    while o < obs.len():
        val ob: text = obs[o]
        val b = binding_for(f.id, ob)
        if is_bound(b):
            covered = covered + 1
            s = s + "\n    # @manual scenario evidence\n"
            s = s + "    it \"should " + obligation_sentence(ob) + " (" + ob + ")\":\n"
            s = s + "        # @req REQ-SSPEC-SYSTEM\n"
            s = s + "        step(\"Obligation " + ob + " for " + sdn_escape(f.title) + "\")\n\n"
            s = s + "        step(\"Run the bound in-tree evidence program\")\n"
            s = s + "        val (out, err, rc) = _run(\"bin/simple run " + b.program + " 2>&1\")\n"
            s = s + "        val log: text = out + err\n\n"
            s = s + "        step(\"A silent exit is INCONCLUSIVE, not a pass: bin/simple run exit codes are\")\n"
            s = s + "        step(\"garbage for fn main() -> (), so the verdict token is the only sound signal\")\n"
            s = s + "        expect(log).to_contain(" + lit(b.token) + ")\n"
            if b.grade == "aggregate":
                s = s + "\n        # EVIDENCE GRADE: aggregate. This token is a whole-program verdict\n"
                s = s + "        # covering several features at once. It proves the path ran and the\n"
                s = s + "        # program's own expectations held; it does not isolate this feature.\n"
        else:
            blocked = blocked + 1
            val why: text = pending_reason(f, ob)
            s = s + "\n    # @manual scenario evidence\n"
            s = s + "    it \"BLOCKED: cannot yet " + obligation_sentence(ob) + " (" + ob + ")\":\n"
            s = s + "        # @req REQ-SSPEC-SYSTEM\n"
            s = s + "        step(\"Obligation " + ob + " for " + sdn_escape(f.title) + " has no in-tree evidence\")\n\n"
            s = s + "        step(\"Assert the coverage ledger still records this cell as pending, with this blocker\")\n"
            s = s + "        # Not a device assertion - there is no device behaviour to assert while\n"
            s = s + "        # this cell is blocked. This goes red if the ledger is edited without\n"
            s = s + "        # regenerating, which is what keeps the blocker text from rotting.\n"
            s = s + "        val ledger: text = read_file(" + lit(LEDGER) + ")\n"
            s = s + "        expect(ledger).to_contain(" + lit(f.id) + ")\n"
            s = s + "        expect(ledger).to_contain(" + lit(why) + ")\n"
        o = o + 1

    GenFile(path: GEN_DIR + "nvme_gen_" + f.id + "_spec.spl", content: s)

"""Emit the controller-INITIALISATION scenario: one file that walks the whole
NVMe bring-up in order, over the host-equivalent path.

This is not a per-feature file; it is the sequence a real host performs, which
only became testable once the register file, the admin doorbell transport and
PRP-over-the-wire all existed at once:

    read CAP -> write AQA/ASQ/ACQ -> set CC.EN -> wait for CSTS.RDY
      -> Identify over the admin queue -> create an I/O queue pair
      -> PRP-backed write and read

The stages live in THREE in-tree programs, and this file says so rather than
implying one program walks the whole thing. Each `it` block runs ONE program
once and asserts that program's stage tokens; the final block asserts all three
verdict lines together, so a stage cannot silently stop being exercised.

Every token asserted here was grepped out of a captured run of the named
program from the repo root. None is a whole-program verdict except in the last
block, where the whole-program verdict is exactly the point.
"""
fn gen_bringup() -> GenFile:
    var s: text = "# GENERATED FILE - do not edit by hand.\n"
    s = s + "# Generated by: src/app/nvme_spec_import (bin/simple run src/app/nvme_spec_import/main.spl generate)\n"
    s = s + "# Regenerate after changing src/app/nvme_spec_import/gen_scenarios.spl.\n"
    s = s + "# Purpose and audience: executable specification evidence for the owning engineering team.\n"
    s = s + "# @req REQ-SSPEC-SYSTEM\n"
    s = s + "# @tag: system, nvme, generated, bring-up, controller-initialization\n"
    s = s + "\n\"\"\"\n"
    s = s + "NVMe controller INITIALISATION, end to end, over the host-equivalent path.\n\n"
    s = s + "The sequence a real host performs, in order:\n"
    s = s + "  read CAP -> write AQA/ASQ/ACQ -> set CC.EN -> wait for CSTS.RDY\n"
    s = s + "  -> Identify over the admin queue -> create an I/O queue pair\n"
    s = s + "  -> PRP-backed write and read.\n\n"
    s = s + "SCOPE, STATED PLAINLY: the stages are exercised by THREE in-tree programs,\n"
    s = s + "not one. Each block below runs one program and asserts its stage tokens.\n"
    s = s + "This proves every stage of the sequence is exercised; it does NOT prove a\n"
    s = s + "single uninterrupted host session walks all of them.\n\n"
    s = s + "MUST RUN FROM THE REPO ROOT. fw/nvme_transport_config.spl holds a\n"
    s = s + "cwd-relative SDN path; from anywhere else the transport profile silently\n"
    s = s + "reads as zeroes and the run produces plausible-looking false failures.\n\n"
    s = s + "CLAIM BOUNDARY. This file does not prove NVMe conformance. It proves that\n"
    s = s + "the named in-tree programs ran and printed the named lines, on a host-model\n"
    s = s + "Simple run. It does not prove a linked firmware image, a QEMU or board\n"
    s = s + "execution, PCIe interoperability, or byte-accurate structure layouts.\n"
    s = s + "\"\"\"\n\n"
    s = s + "use std.spec.step\n\nuse std.spec.*\n"
    s = s + "use std.io_runtime." + LB + "process_run" + RB + "\n\n"
    s = s + "fn _run(cmd: text) -> (text, text, i64):\n    process_run(\"/bin/sh\", [\"-c\", cmd])\n\n"
    s = s + "describe \"NVMe controller initialisation sequence (host-equivalent path)\":\n"

    s = s + stage_block("stage 1-4: read CAP, program AQA/ASQ/ACQ, set CC.EN, wait for CSTS.RDY",
                        FW + "nvme_registers_check.spl",
                        ["CSTS.RDY is 0 at power-on",
                         "CAP.MQES is 0-based and agrees with the queue depth",
                         "CAP.DSTRD decodes to the profile's doorbell stride",
                         "AQA.ASQS reads back what the host wrote",
                         "ACQ base reads back what the host wrote",
                         "RDY is not instant: still 0 immediately after the CC write",
                         "CSTS.RDY is now 1 -- the controller is enabled",
                         "bringup() drives the whole sequence through the registers",
                         "NVME REGISTERS OK"])

    s = s + stage_block("stage 5-6: Identify over the admin queue, then create an I/O queue pair",
                        FW + "admin_transport_check.spl",
                        ["ASQ memory CDW0[7:0] holds the Identify opcode",
                         "device has NOT seen the admin command before the doorbell",
                         "device serviced the admin command only after the doorbell",
                         "ACQ slot 0 now carries phase 1",
                         "Identify produced a CONTROLLER structure",
                         "Create CQ + Create SQ for qid 1 succeeded over the doorbell path",
                         "ADMIN TRANSPORT OK"])

    s = s + stage_block("stage 7: a PRP-backed write and read on the I/O queue pair",
                        FW + "prp_wire_witness_check.spl",
                        ["controller is ready",
                         "the 64-byte SQE itself carries no payload words",
                         "PRP1 holds the ADDRESS of the host page buffer",
                         "WITNESS: the device stored the NEW word 0 (0xBB00), not the stale 0xAA00",
                         "the read-back completes",
                         "PRP WIRE WITNESS OK"])

    GenFile(path: GEN_DIR + "nvme_gen_controller_initialization_sequence_spec.spl", content: s)

"""One `it` block: run `prog` once, assert every stage token in `tokens`."""
fn stage_block(title: text, prog: text, tokens: [text]) -> text:
    var s: text = "\n    # @manual scenario evidence\n"
    s = s + "    it \"should complete " + title + "\":\n"
    s = s + "        # @req REQ-SSPEC-SYSTEM\n"
    s = s + "        step(" + lit(title) + ")\n\n"
    s = s + "        step(\"Run the in-tree evidence program ONCE from the repo root\")\n"
    s = s + "        val (out, err, rc) = _run(\"bin/simple run " + prog + " 2>&1\")\n"
    s = s + "        val log: text = out + err\n\n"
    s = s + "        step(\"A silent exit is INCONCLUSIVE, not a pass: bin/simple run exit codes are\")\n"
    s = s + "        step(\"garbage for fn main() -> (), so the printed lines are the only sound signal\")\n"
    var i: i64 = 0
    while i < tokens.len():
        s = s + "        expect(log).to_contain(" + lit(tokens[i]) + ")\n"
        i = i + 1
    s


fn generate(res: ScanResult) -> GenResult:
    val fs = nvme_features()
    val obs = obligation_list()
    var out: [GenFile] = []
    var st = GenStats(files: 0, covered: 0, blocked: 0)
    var i: i64 = 0
    while i < fs.len():
        val f = fs[i]
        var clauses: i64 = 0
        var c: i64 = 0
        while c < res.records.len():
            if res.records[c].feature == f.id:
                clauses = clauses + 1
            c = c + 1
        out.push(gen_one(f, clauses))
        st.files = st.files + 1
        var o: i64 = 0
        while o < obs.len():
            if is_bound(binding_for(f.id, obs[o])):
                st.covered = st.covered + 1
            else:
                st.blocked = st.blocked + 1
            o = o + 1
        i = i + 1
    out.push(gen_bringup())
    st.files = st.files + 1
    GenResult(files: out, stats: st)

export GenFile, GenStats, GenResult, generate, gen_one, gen_bringup, stage_block, GEN_DIR, LEDGER
