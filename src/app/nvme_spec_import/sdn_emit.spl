"""
sdn_emit — render extraction results as SDN documents.

SDN, never JSON or YAML (`.claude/rules/language.md`). Emission is the last
place spec prose could leak into the repo, so every scalar goes through
`sdn_escape` and nothing is written that the scanners did not already reduce to
identifiers, numbers, and this app's own generated paraphrases.
"""

use text_norm.*
use clause_scan.*
use field_scan.*
use feature_map.*
use obligations.*

fn q(s: text) -> text:
    "\"" + sdn_escape(s) + "\""

val LICENCE_BANNER: text = "# LICENSING: NVM Express specifications are freely downloadable but NOT\n# redistributable. This file contains NO specification prose. It carries clause\n# identifiers, section numbers, field names, short factual field data, and\n# paraphrases generated by src/app/nvme_spec_import from its own controlled\n# vocabulary. `source_line` points into a LOCAL copy of the extracted text that\n# is deliberately not in this repository.\n"

fn clause_sdn(res: ScanResult, source_path: text) -> text:
    var out: text = "# spec/nvme/clauses.sdn - generated by src/app/nvme_spec_import\n"
    out = out + LICENCE_BANNER
    out = out + "\nschema: \"simple.nvme.clause.v1\"\n"
    out = out + "provenance: " + q(PROVENANCE) + "\n"
    out = out + "source_text: " + q(source_path) + "\n"
    out = out + "clauses:\n"
    var i: i64 = 0
    while i < res.records.len():
        val r = res.records[i]
        out = out + "  - id: " + q(r.id) + "\n"
        out = out + "    section: " + q(r.section) + "\n"
        out = out + "    source_line: {r.source_line}\n"
        out = out + "    kind: " + q(r.kind) + "\n"
        out = out + "    feature: " + q(r.feature) + "\n"
        out = out + "    terms: " + q(r.terms) + "\n"
        out = out + "    paraphrase: " + q(r.paraphrase) + "\n"
        out = out + "    needs_human_review: {r.review}\n"
        if r.review:
            out = out + "    review_reason: " + q(r.review_why) + "\n"
        i = i + 1
    out

fn fields_sdn(fs: FieldScanResult) -> text:
    var out: text = "# spec/nvme/register_fields.sdn - generated by src/app/nvme_spec_import\n"
    out = out + LICENCE_BANNER
    out = out + "\nschema: \"simple.nvme.register_field.v1\"\n"
    out = out + "provenance: " + q(PROVENANCE) + "\n"
    out = out + "fields:\n"
    var i: i64 = 0
    while i < fs.rows.len():
        val r = fs.rows[i]
        out = out + "  - register: " + q(r.register) + "\n"
        out = out + "    field: " + q(r.field) + "\n"
        out = out + "    figure: " + q(r.figure) + "\n"
        out = out + "    bits: " + q(r.bits) + "\n"
        out = out + "    width_bits: {r.width_bits}\n"
        out = out + "    access: " + q(r.access) + "\n"
        out = out + "    reset: " + q(r.reset) + "\n"
        out = out + "    source_line: {r.source_line}\n"
        i = i + 1
    out = out + "needs_human_review:\n"
    var k: i64 = 0
    while k < fs.reviews.len():
        val v = fs.reviews[k]
        out = out + "  - figure: " + q(v.figure) + "\n"
        out = out + "    source_line: {v.source_line}\n"
        out = out + "    reason: " + q(v.why) + "\n"
        k = k + 1
    out

"""The coverage ledger: one row per mandatory feature per obligation.

This file is what `scripts/check/check-nvme-spec-coverage.shs` reads, and what
a generated blocked marker asserts against.
"""
fn coverage_sdn(res: ScanResult) -> text:
    var out: text = "# spec/nvme/coverage.sdn - generated by src/app/nvme_spec_import\n"
    out = out + LICENCE_BANNER
    out = out + "\nschema: \"simple.nvme.coverage.v1\"\n"
    out = out + "provenance: " + q(PROVENANCE) + "\n"
    out = out + "features:\n"
    val fs = nvme_features()
    val obs = obligation_list()
    var i: i64 = 0
    while i < fs.len():
        val f = fs[i]
        # Clause evidence: how many extracted clauses mapped onto this feature.
        var clauses: i64 = 0
        var c: i64 = 0
        while c < res.records.len():
            if res.records[c].feature == f.id:
                clauses = clauses + 1
            c = c + 1
        out = out + "  - id: " + q(f.id) + "\n"
        out = out + "    title: " + q(f.title) + "\n"
        out = out + "    class: {f.class_num}\n"
        out = out + "    status: " + q(f.status) + "\n"
        if f.blocker.len() > 0:
            out = out + "    blocker: " + q(f.blocker) + "\n"
        out = out + "    mapped_clauses: {clauses}\n"
        out = out + "    scenario: " + q("test/03_system/app/nvme_firmware/generated/nvme_gen_" + f.id + "_spec.spl") + "\n"
        out = out + "    obligations:\n"
        var o: i64 = 0
        while o < obs.len():
            val b = binding_for(f.id, obs[o])
            out = out + "      - kind: " + q(obs[o]) + "\n"
            if is_bound(b):
                out = out + "        state: \"covered\"\n"
                out = out + "        program: " + q(b.program) + "\n"
                out = out + "        token: " + q(b.token) + "\n"
                out = out + "        grade: " + q(b.grade) + "\n"
            else:
                out = out + "        state: \"pending\"\n"
                out = out + "        blocker: " + q(pending_reason(f, obs[o])) + "\n"
            o = o + 1
        i = i + 1
    out

"""Extraction honesty report - the numbers, and what they are numbers OF."""
fn report_sdn(res: ScanResult, fs: FieldScanResult, source_path: text) -> text:
    val st = res.stats
    val ts = fs.stats
    var out: text = "# spec/nvme/extraction_report.sdn - generated by src/app/nvme_spec_import\n"
    out = out + LICENCE_BANNER
    out = out + "\nschema: \"simple.nvme.extraction_report.v1\"\n"
    out = out + "provenance: " + q(PROVENANCE) + "\n"
    out = out + "source_text: " + q(source_path) + "\n"
    out = out + "clause_extraction:\n"
    out = out + "  lines_scanned: {st.lines}\n"
    out = out + "  paragraphs: {st.paragraphs}\n"
    out = out + "  headings_recognized: {st.headings}\n"
    out = out + "  toc_rows_with_a_section_number: {st.toc_entries}\n"
    out = out + "  shall_occurrences_total: {st.shall_occurrences}\n"
    out = out + "  shall_occurrences_inside_a_captured_paragraph: {st.shall_captured}\n"
    out = out + "  should_occurrences_total: {st.should_occurrences}\n"
    out = out + "  may_occurrences_total: {st.may_occurrences}\n"
    out = out + "  requirement_paragraphs: {st.req_paragraphs}\n"
    out = out + "  mapped_to_a_mandatory_feature: {st.mapped}\n"
    out = out + "  unmapped: {st.unmapped}\n"
    out = out + "  needs_human_review: {st.review}\n"
    out = out + "  emitted_records: {res.records.len()}\n"
    out = out + "table_extraction:\n"
    out = out + "  figure_captions_seen: {ts.figures_seen}\n"
    out = out + "  register_tables_attempted: {ts.register_tables}\n"
    out = out + "  register_tables_parsed: {ts.tables_parsed}\n"
    out = out + "  register_tables_needing_human_review: {ts.tables_review}\n"
    out = out + "  field_rows_emitted: {ts.rows}\n"
    out = out + "caveats:\n"
    out = out + "  - " + q("Section attribution is weak: the table of contents lost its section-number column in PDF extraction, so headings are recognized by shape alone and most clauses attribute to a distant ancestor heading. Records affected carry needs_human_review with the line distance.") + "\n"
    out = out + "  - " + q("Requirement detection is keyword-based over normalized paragraphs. A requirement whose keyword was hyphenated or shredded across a table cell is missed and is NOT counted as extracted.") + "\n"
    out = out + "  - " + q("Register field rows are recovered by ordinal pairing of column runs and are emitted only when all four runs agree in length. Tables that disagree emit a review record and NO field rows.") + "\n"
    out = out + "  - " + q("A 'parsed' table means its column runs agreed, NOT that every field of that register was recovered. A register figure continued across a page break is split by the intervening caption, so the rows emitted for any one register are a LOWER BOUND: CAP yielded 2 rows for a register that has far more fields. Field rows are trustworthy individually; the per-register field set is incomplete.") + "\n"
    out = out + "  - " + q("register_tables_attempted counts every caption of the shape 'Figure N: Offset ...', which includes table-of-contents caption rows and page-break continuations, so the attempted denominator is inflated relative to the number of distinct registers.") + "\n"
    out

export clause_sdn, fields_sdn, coverage_sdn, report_sdn
