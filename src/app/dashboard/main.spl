# Dashboard CLI entrypoint.
#
# Owns the `simple dashboard` option surface: the shared log-mode/progress
# options, help, and the usage/error reporting that the rest of the CLI family
# (app root, brief, bug-gen, cache, check) already provides.
#
# The dashboard data model (tables, cache, collectors) is still missing from
# this module — see doc/08_tracking/bug/dashboard_main_lost_table_model_2026-08-04.md.

use std.cli.cli_util.{get_cli_args}
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use std.log.{error}

fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        error("dashboard", log_opts.error)
        return 1

    val args = dashboard_clean_log_args(raw_args)
    val as_json = log_opts.log_mode == "json"

    if args.len() == 0:
        if as_json:
            print "{\"command\":\"dashboard\",\"status\":\"usage\"}"
            return 0
        print_dashboard_help()
        return 0

    if args[0] == "--help" or args[0] == "-h" or args[0] == "help":
        if as_json:
            print "{\"command\":\"dashboard\",\"status\":\"usage\"}"
            return 0
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print_dashboard_help()
        return 0

    if as_json:
        print "{\"command\":\"dashboard\",\"status\":\"error\",\"error\":\"unknown command\"}"
        return 1
    error("dashboard", "unknown command '{args[0]}'")
    print ""
    print_dashboard_help()
    1

fn print_dashboard_help():
    print "Simple Dashboard CLI"
    print ""
    print "USAGE:"
    print "  simple dashboard [options]"
    print ""
    print "Shared log options:"
    for line in log_options_help():
        print "  {line}"

fn dashboard_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn dashboard_is_entry_script(arg: text) -> bool:
    # In the `simple run <abs-path>/src/app/dashboard/main.spl` form, argv keeps
    # the entry-script path as the first argument. Drop it like the sibling app
    # roots so options after it are parsed.
    arg.ends_with("/app/dashboard/main.spl") or arg == "src/app/dashboard/main.spl"

fn dashboard_clean_log_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if dashboard_is_entry_script(arg):
            i = i + 1
            continue
        if dashboard_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned
