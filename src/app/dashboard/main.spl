val DASHBOARD_TABLE_DIR = "doc/10_metrics/dashboard/tables"
val DASHBOARD_HISTORY_DIR = "doc/10_metrics/dashboard/history"
val DASHBOARD_CACHE_PATH = "doc/10_metrics/dashboard/dashboard_db.cache.sdn"

