# Mirrors the MCP class pattern: fields + static factory + impl methods,
# used via static call, direct construction, method call, and as a field of
# another class.
enum Mode:
    Off
    On

class Caps:
    a: bool
    b: bool

    static fn create(a: bool, b: bool) -> Caps:
        Caps(a: a, b: b)

impl Caps:
    fn count() -> i64:
        var n = 0
        if self.a:
            n = n + 1
        if self.b:
            n = n + 1
        n

class Reg:
    name: text
    mode: Mode
    caps: Caps

impl Reg:
    fn label() -> text:
        self.name + "/" + str(self.caps.count())

fn build() -> Reg:
    Reg(name: "r1", mode: Mode.On, caps: Caps.create(true, false))

fn main() -> i32:
    val c = Caps.create(true, true)
    print("count=" + str(c.count()))
    val r = build()
    print("label=" + r.label())
    match r.mode:
        Off: print("m=off")
        On: print("m=on")
    print("END")
    0
