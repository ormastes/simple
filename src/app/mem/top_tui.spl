# simple mem top --tui (standalone) — live/post-mortem TUI viewer for a v1
# memory snapshot TSV. See doc/05_design/app/mem_cli/m8_simple_mem_cli_design.md
# section 5 (TUI) for the design this implements.
#
# Usage:
#   bin/simple run src/app/mem/top_tui.spl -- --profile <file> [--watch N] [--n N]
#
# `--watch N`: re-read `--profile` and re-render every N seconds. Exits on
# `q`/`Q`/Ctrl-C when stdin is a TTY (raw mode + non-blocking poll); without
# `--watch`, renders once and exits.
#
# Renders through the real `std.tui` widgets (Box + List, per the design
# doc's "no Table widget yet" workaround: fixed-width rows as List/Box
# content) when stdin is a TTY. Otherwise falls back to the same row
# formatting printed as plain aligned text — this is also the path spec
# tests exercise, since spec runs are never TTYs.
#
# NOTE: wiring `simple mem top --tui` into src/app/mem/main.spl's dispatcher
# is deferred; see the TODO in the design doc.

use std.io_runtime.{get_args, file_read, file_exists, thread_sleep}
use std.tui.terminal.{
    terminal_stdin_is_tty, terminal_get_size, terminal_enter_alt_screen, terminal_exit_alt_screen,
    terminal_enter_raw_mode, terminal_exit_raw_mode, terminal_hide_cursor, terminal_show_cursor,
    terminal_clear_screen, terminal_draw_at, terminal_flush
}
use std.tui.widget.{Rect, make_rect, pad_or_truncate}
use std.tui.style.{StyledLine, fg_style, COLOR_CYAN, make_plain_line, render_line}
use std.tui.widgets.box_widget.{make_box_widget_with_content, box_render}
use std.tui.layout.{split_vertical}

# Raw-mode non-blocking key poll (same primitives as app.ui.tui.input's
# poll_raw_input): rt_term_poll/rt_term_read_timeout operate on stdin and
# return immediately once the timeout elapses, unlike terminal_read_byte()
# which blocks indefinitely (VMIN=1/VTIME=0) and would stall the refresh loop.
extern fn rt_term_read_timeout(max_len: i64, timeout_ms: i64) -> text
extern fn rt_term_poll(timeout_ms: i64) -> bool

struct MemRow:
    tag: text
    name: text
    live: i64
    peak: i64
    allocs: i64

# Workaround: native codegen string == is broken (length-only comparison) --
# same idiom as src/app/mem/main.spl::str_eq.
fn str_eq(a: text, b: text) -> bool:
    a.len() == b.len() and a.starts_with(b)

fn min_i64(a: i64, b: i64) -> i64:
    if a < b:
        a
    else:
        b

# Deliberately avoids `parse_int() ?? -1` -- `??` on a raw i64 corrupts the
# value 3 (nil sentinel collision). Same idiom as main.spl::parse_dec.
fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            return n
        i = i + 1
    if found:
        return n
    -1

fn pad_right(s: text, width: i64) -> text:
    var out = s
    while out.len() < width:
        out = out + " "
    out

fn pad_left(s: text, width: i64) -> text:
    var out = s
    while out.len() < width:
        out = " " + out
    out

# Positional args after the interpreter/script prelude, same convention as
# main.spl::cli_positional_args. Also tolerates a leading literal "--"
# separator token (per `bin/simple run <file> -- <args>` usage), which
# `simple run` forwards verbatim rather than stripping.
fn cli_positional_args() -> [text]:
    val all = get_args()
    var rest: [text] = []
    var seen_script = false
    var i = 1
    while i < all.len():
        val a = all[i]
        if seen_script:
            rest = rest.push(a)
        elif a.ends_with(".spl"):
            seen_script = true
        i = i + 1
    if not seen_script:
        rest = []
        i = 1
        while i < all.len():
            rest = rest.push(all[i])
            i = i + 1
    if rest.len() > 0 and str_eq(rest[0], "--"):
        return rest[1:]
    rest

# Parses a v1 snapshot TSV into a flat list of OWNER/KIND rows (RSS and the
# header row are skipped), same format as main.spl::parse_snapshot.
fn parse_snapshot(path: text) -> [MemRow]:
    var rows: [MemRow] = []
    if not file_exists(path):
        return rows
    val content = file_read(path)
    for line in content.split("\n"):
        if line.trim() == "":
            continue
        val parts = line.split("\t")
        if parts.len() < 1:
            continue
        val tag = parts[0]
        if str_eq(tag, "OWNER") or str_eq(tag, "KIND"):
            if parts.len() < 5:
                continue
            rows = rows.push(MemRow(
                tag: tag,
                name: parts[1],
                live: parse_dec(parts[2]),
                peak: parse_dec(parts[3]),
                allocs: parse_dec(parts[4])
            ))
    rows

fn filter_tag(rows: [MemRow], tag: text) -> [MemRow]:
    var out: [MemRow] = []
    for r in rows:
        if str_eq(r.tag, tag):
            out = out.push(r)
    out

# In-place selection sort descending by live bytes -- row counts are small,
# so O(n^2) is fine (matches main.spl::sort_rows_desc).
fn sort_rows_desc(rows: [MemRow]) -> [MemRow]:
    var arr = rows
    val n = arr.len()
    var i = 0
    while i < n:
        var max_idx = i
        var j = i + 1
        while j < n:
            if arr[j].live > arr[max_idx].live:
                max_idx = j
            j = j + 1
        if max_idx != i:
            val tmp = arr[i]
            arr[i] = arr[max_idx]
            arr[max_idx] = tmp
        i = i + 1
    arr

fn header_line() -> text:
    pad_right("NAME", 32) + pad_left("LIVE", 12) + pad_left("PEAK", 12) + pad_left("ALLOCS", 8)

fn row_line(r: MemRow) -> text:
    pad_right(r.name, 32) + pad_left("{r.live}", 12) + pad_left("{r.peak}", 12) + pad_left("{r.allocs}", 8)

# Formats a title + header + row lines as plain text, matching the column
# layout of main.spl::print_rows_table.
fn build_table_lines(title: text, rows: [MemRow], top_n: i64) -> [text]:
    var lines: [text] = [title, header_line()]
    val limit = min_i64(top_n, rows.len())
    var i = 0
    while i < limit:
        lines = lines.push(row_line(rows[i]))
        i = i + 1
    lines

fn print_lines(lines: [text]):
    for l in lines:
        print l

fn render_plain(profile: text, owners: [MemRow], kinds: [MemRow], n: i64):
    print "Snapshot: {profile}"
    print ""
    print_lines(build_table_lines("Top owners by live bytes:", owners, n))
    print ""
    print_lines(build_table_lines("Kinds by live bytes:", kinds, n))

fn to_content_lines(lines: [text], width: i64) -> [StyledLine]:
    var out: [StyledLine] = []
    for l in lines:
        out = out.push(make_plain_line(pad_or_truncate(l, width)))
    out

fn render_tui(profile: text, owners: [MemRow], kinds: [MemRow], n: i64):
    val size = terminal_get_size()
    val full = make_rect(0, 0, size.cols, size.rows)
    val parts = split_vertical(full, [1, 1])
    val owner_area = parts[0]
    val kind_area = parts[1]

    val owner_lines = to_content_lines(build_table_lines("Top owners (live bytes)", owners, n), owner_area.width - 2)
    val kind_lines = to_content_lines(build_table_lines("Kinds (live bytes)", kinds, n), kind_area.width - 2)

    val owner_box = make_box_widget_with_content("mem top — {profile}", fg_style(COLOR_CYAN), owner_lines)
    val kind_box = make_box_widget_with_content("Kinds", fg_style(COLOR_CYAN), kind_lines)

    terminal_clear_screen()
    val owner_rendered = box_render(owner_box, owner_area)
    val kind_rendered = box_render(kind_box, kind_area)
    var row = 0
    while row < owner_rendered.len():
        terminal_draw_at(owner_area.y + row, owner_area.x, render_line(owner_rendered[row]))
        row = row + 1
    row = 0
    while row < kind_rendered.len():
        terminal_draw_at(kind_area.y + row, kind_area.x, render_line(kind_rendered[row]))
        row = row + 1
    terminal_flush()

# Reads `profile`, renders once (TUI or plain per `tty`). Returns false when
# the profile file does not exist (caller should stop the loop / exit 1).
fn render_once(profile: text, n: i64, tty: bool) -> bool:
    if not file_exists(profile):
        print "top_tui: profile not found: {profile}"
        return false
    val rows = parse_snapshot(profile)
    val owners = sort_rows_desc(filter_tag(rows, "OWNER"))
    val kinds = sort_rows_desc(filter_tag(rows, "KIND"))
    if tty:
        render_tui(profile, owners, kinds, n)
    else:
        render_plain(profile, owners, kinds, n)
    true

# Polls stdin (raw mode already entered) for up to `timeout_ms`. Returns
# true if the byte read is a quit key: 'q', 'Q', or Ctrl-C (0x03 -- raw mode
# disables ISIG, so Ctrl-C arrives as a byte here rather than as a signal).
fn is_quit_key(timeout_ms: i64) -> bool:
    if not rt_term_poll(timeout_ms):
        return false
    val data = rt_term_read_timeout(64, timeout_ms)
    if data == "" or data == nil:
        return false
    val first = data[0]
    first == "q" or first == "Q" or first == "\x03"

# Waits up to `total_ms`, polling for a quit key in short slices so a
# TTY watch loop stays responsive. Returns false if the user quit early.
fn wait_or_quit(total_ms: i64) -> bool:
    val step_ms = 200
    var waited = 0
    while waited < total_ms:
        if is_quit_key(step_ms):
            return false
        waited = waited + step_ms
    true

fn print_help():
    print "simple mem top_tui — TUI/plain-text viewer for a v1 memory snapshot"
    print ""
    print "Usage:"
    print "  bin/simple run src/app/mem/top_tui.spl -- --profile <file> [--watch N] [--n N]"

fn main() -> i64:
    val args = cli_positional_args()
    var profile = ""
    var watch_secs = -1
    var n = 20
    var i = 0
    while i < args.len():
        val a = args[i]
        if str_eq(a, "--profile") and i + 1 < args.len():
            profile = args[i + 1]
            i = i + 2
        elif a.starts_with("--profile="):
            profile = a.substring(10)
            i = i + 1
        elif str_eq(a, "--watch") and i + 1 < args.len():
            val parsed = parse_dec(args[i + 1])
            if parsed > 0:
                watch_secs = parsed
            i = i + 2
        elif a.starts_with("--watch="):
            val parsed = parse_dec(a.substring(8))
            if parsed > 0:
                watch_secs = parsed
            i = i + 1
        elif str_eq(a, "--n") and i + 1 < args.len():
            val parsed = parse_dec(args[i + 1])
            if parsed > 0:
                n = parsed
            i = i + 2
        elif a.starts_with("--n="):
            val parsed = parse_dec(a.substring(4))
            if parsed > 0:
                n = parsed
            i = i + 1
        else:
            i = i + 1

    if profile == "":
        print "top_tui: missing --profile <file>"
        print_help()
        return 1

    val tty = terminal_stdin_is_tty()

    if watch_secs <= 0:
        if render_once(profile, n, tty):
            return 0
        return 1

    if tty:
        terminal_enter_alt_screen()
        terminal_hide_cursor()
        terminal_enter_raw_mode()

    var keep_going = true
    var had_error = false
    while keep_going:
        if not render_once(profile, n, tty):
            had_error = true
            keep_going = false
        elif tty:
            keep_going = wait_or_quit(watch_secs * 1000)
        else:
            thread_sleep(watch_secs * 1000)

    if tty:
        terminal_show_cursor()
        terminal_exit_raw_mode()
        terminal_exit_alt_screen()

    if had_error:
        return 1
    0
