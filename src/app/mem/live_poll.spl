# simple mem live_poll (standalone) — trigger a live process's SIGUSR2
# memory-dump hook (src/lib/nogc_sync_mut/mem/dump.spl::install_mem_dump_on_usr2)
# and read back the refreshed v1 snapshot it writes.
#
# Usage:
#   bin/simple run src/app/mem/live_poll.spl -- --pid <P> --path <file> [--wait-ms N]
#
# Sends SIGUSR2 to <P> (`kill -USR2 P`), waits briefly for the target
# process's signal handler to write the snapshot, then prints the file's
# contents. Exits 1 if the signal could not be sent or no snapshot appears.
#
# See doc/05_design/app/mem_cli/m8_simple_mem_cli_design.md section 2
# (signal-triggered dump is the v1 live-process channel).

use std.io_runtime.{get_args, process_run, file_read, file_exists}
# thread_sleep is imported directly from nogc_sync_mut, not the std.io_runtime
# shim: under interpreter execution (bin/simple test) the shim's re-export
# list does not include thread_sleep, so `use std.io_runtime.{..., thread_sleep}`
# silently resolves to nothing and every wait becomes a no-op (confirmed via
# the `[use-warning] 'thread_sleep' is named ... but module ... does not
# provide it` diagnostic). This direct import resolves under both engines.
use std.nogc_sync_mut.io_runtime.{thread_sleep}

fn str_eq(a: text, b: text) -> bool:
    a.len() == b.len() and a.starts_with(b)

fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            return n
        i = i + 1
    if found:
        return n
    -1

fn cli_positional_args() -> [text]:
    val all = get_args()
    var rest: [text] = []
    var seen_script = false
    var i = 1
    while i < all.len():
        val a = all[i]
        if seen_script:
            rest = rest.push(a)
        elif a.ends_with(".spl"):
            seen_script = true
        i = i + 1
    if not seen_script:
        rest = []
        i = 1
        while i < all.len():
            rest = rest.push(all[i])
            i = i + 1
    if rest.len() > 0 and str_eq(rest[0], "--"):
        return rest[1:]
    rest

# Sends SIGUSR2 to `pid` via the `kill` binary (matches the process_run
# convention already used by src/app/mem/main.spl::cmd_gate). Returns true
# on a zero exit code from `kill`.
fn send_sigusr2(pid: i64) -> bool:
    val (_out, _err, code) = process_run("kill", ["-USR2", "{pid}"])
    code == 0

# Sends SIGUSR2 to `pid`, waits `wait_ms` for the target's SIGUSR2 handler
# (install_mem_dump_on_usr2) to write a fresh snapshot to `path`, then
# returns the file contents (empty text if the wait timed out or the
# signal could not be sent).
fn live_poll(pid: i64, path: text, wait_ms: i64) -> text:
    if not send_sigusr2(pid):
        return ""
    thread_sleep(wait_ms)
    if not file_exists(path):
        return ""
    file_read(path)

fn print_help():
    print "simple mem live_poll — trigger + read a live SIGUSR2 memory snapshot"
    print ""
    print "Usage:"
    print "  bin/simple run src/app/mem/live_poll.spl -- --pid <P> --path <file> [--wait-ms N]"

fn main() -> i64:
    val args = cli_positional_args()
    var pid: i64 = -1
    var path = ""
    var wait_ms: i64 = 200
    var i = 0
    while i < args.len():
        val a = args[i]
        if str_eq(a, "--pid") and i + 1 < args.len():
            pid = parse_dec(args[i + 1])
            i = i + 2
        elif a.starts_with("--pid="):
            pid = parse_dec(a.substring(6))
            i = i + 1
        elif str_eq(a, "--path") and i + 1 < args.len():
            path = args[i + 1]
            i = i + 2
        elif a.starts_with("--path="):
            path = a.substring(7)
            i = i + 1
        elif str_eq(a, "--wait-ms") and i + 1 < args.len():
            val parsed = parse_dec(args[i + 1])
            if parsed >= 0:
                wait_ms = parsed
            i = i + 2
        elif a.starts_with("--wait-ms="):
            val parsed = parse_dec(a.substring(10))
            if parsed >= 0:
                wait_ms = parsed
            i = i + 1
        else:
            i = i + 1

    if pid <= 0:
        print "live_poll: missing --pid <P>"
        print_help()
        return 1
    if path == "":
        print "live_poll: missing --path <file>"
        print_help()
        return 1

    val content = live_poll(pid, path, wait_ms)
    if content == "":
        print "live_poll: no snapshot at {path} after SIGUSR2 (pid {pid})"
        return 1

    print content
    0
