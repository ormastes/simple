"""Normalized evidence contract for Engine2D backend captures."""

use common.renderdoc.backend_render_receipt_wire.{
    BackendRenderReceiptWireParse,
    backend_render_receipt_v2_source_identity_hash,
    backend_render_receipt_v2_source_revision
}
use std.nogc_async_mut_noalloc.baremetal.common.backend_render_receipt.{
    BACKEND_RENDER_OPERATION_PRESENT,
    BACKEND_RENDER_OPERATION_INPUT_IRQ,
    BACKEND_RENDER_OPERATION_WM_APPLY,
    BACKEND_RENDER_OPERATION_DAMAGE_COMMIT
}

pub struct Backend2dEventReceipt:
    sequence: text
    count: i64
    backend: text
    injected: bool
    delivered: bool
    ordered: bool
    delivery_source: text
    schema_version: i64
    firmware_status_code: i64
    source_identity_hash: text
    source_revision: text
    boot_id: i64
    input_sequence: i64
    frame_id: i64
    rendered_revision: i64
    monotonic_event_us: i64
    operation_code: i64
    receipt_stage_sequence: text
    receipt_stage_count: i64

pub struct Backend2dExecutionReceipt:
    provenance: text
    identity: text
    cpu_fallback_used: bool
    simd_hits: i64
    simd_chunks: i64
    scalar_parity: bool

pub struct Backend2dCaptureEvidence:
    backend: text
    target: text
    scene_id: text
    width: i64
    height: i64
    dpi: i64
    pixel_sha256: text
    non_background_bounds: text
    events: Backend2dEventReceipt
    capture_path: text
    source_revision: text
    execution: Backend2dExecutionReceipt

pub struct Backend2dCaptureComparison:
    reference_backend: text
    candidate_backend: text
    reference_status: text
    candidate_status: text
    dimensions_match: bool
    metadata_match: bool
    events_match: bool
    revisions_match: bool
    pixels_exact: bool
    different_pixels: i64
    max_channel_diff: i64
    tolerance_profile: text
    pixels_within_tolerance: bool
    accepted: bool
    reason: text

const BACKEND_2D_EVENT_SEQUENCE = "focus,pointer_move,pointer_down,pointer_up,key_down,key_up"
const BACKEND_2D_RECEIPT_STAGE_SEQUENCE = "INPUT_IRQ,WM_APPLY,DAMAGE_COMMIT,PRESENT"

fn _backend_2d_known(name: text) -> bool:
    name == "metal" or name == "vulkan" or name == "cpu_simd" or
        name == "simpleos_x86_64_simd" or name == "simpleos_arm64_simd"

fn _backend_2d_hex_shape_valid(value: text, expected_len: i64) -> bool:
    if value.len().to_i64() != expected_len:
        return false
    var i = 0
    while i < value.len():
        val c = value[i]
        val digit = c >= '0' and c <= '9'
        val lower_hex = c >= 'a' and c <= 'f'
        if not digit and not lower_hex:
            return false
        i = i + 1
    true

fn _backend_2d_nonzero_hex_shape_valid(value: text, expected_len: i64) -> bool:
    if not _backend_2d_hex_shape_valid(value, expected_len):
        return false
    var i = 0
    while i < value.len():
        if value[i] != '0':
            return true
        i = i + 1
    false

fn _backend_2d_revision_valid(value: text) -> bool:
    _backend_2d_hex_shape_valid(value, 10) or
        _backend_2d_hex_shape_valid(value, 40)

fn _backend_2d_tolerance_profile_valid(value: text) -> bool:
    value == "strict" or value == "wm_default"

fn _backend_2d_unsigned_decimal(value: text) -> bool:
    if value == "":
        return false
    var i = 0
    while i < value.len():
        val c = value[i]
        if c < '0' or c > '9':
            return false
        i = i + 1
    true

fn _backend_2d_bounds_valid(value: text, width: i64, height: i64) -> bool:
    val parts = value.split(",")
    if parts.len() != 4:
        return false
    for part in parts:
        if not _backend_2d_unsigned_decimal(part):
            return false
    val x = parts[0].to_i64()
    val y = parts[1].to_i64()
    val w = parts[2].to_i64()
    val h = parts[3].to_i64()
    x >= 0 and y >= 0 and w > 0 and h > 0 and
        x + w <= width and y + h <= height

pub fn backend_2d_event_receipt(backend: text, injected: bool,
                                delivered: bool,
                                delivery_source: text) -> Backend2dEventReceipt:
    Backend2dEventReceipt(
        sequence: BACKEND_2D_EVENT_SEQUENCE,
        count: 6,
        backend: backend,
        injected: injected,
        delivered: delivered,
        ordered: injected and delivered,
        delivery_source: delivery_source,
        schema_version: 0,
        firmware_status_code: 0,
        source_identity_hash: "",
        source_revision: "",
        boot_id: 0,
        input_sequence: 0,
        frame_id: 0,
        rendered_revision: 0,
        monotonic_event_us: 0,
        operation_code: 0,
        receipt_stage_sequence: "",
        receipt_stage_count: 0
    )

pub fn backend_2d_event_receipt_from_brr2(
    parsed: BackendRenderReceiptWireParse,
    backend: text,
    delivery_source: text
) -> Result<Backend2dEventReceipt, text>:
    if not parsed.valid or parsed.wire_version != 2:
        return Err("invalid_brr2_receipt")
    if (backend != "simpleos_x86_64_simd" and
        backend != "simpleos_arm64_simd"):
        return Err("invalid_correlated_backend")
    if delivery_source == "" or delivery_source == "qmp":
        return Err("invalid_event_delivery_source")
    if parsed.events_v2.len() != 4 or parsed.trailer_v2 == nil:
        return Err("invalid_receipt_stage_count")
    val events = parsed.events_v2
    if (events[0].operation_code != BACKEND_RENDER_OPERATION_INPUT_IRQ or
        events[1].operation_code != BACKEND_RENDER_OPERATION_WM_APPLY or
        events[2].operation_code != BACKEND_RENDER_OPERATION_DAMAGE_COMMIT or
        events[3].operation_code != BACKEND_RENDER_OPERATION_PRESENT):
        return Err("invalid_receipt_stage_sequence")
    if val Some(header) = parsed.header_v2:
        if val Some(trailer) = parsed.trailer_v2:
            if not trailer.frame_complete:
                return Err("incomplete_correlated_frame")
            val source_identity =
                backend_render_receipt_v2_source_identity_hash(header)
            if not _backend_2d_nonzero_hex_shape_valid(source_identity, 64):
                return Err("invalid_source_identity")
            val present = events[3]
            val max_i64 = 0x7fffffffffffffffu64
            if (header.boot_id > max_i64 or
                present.input_sequence > max_i64 or
                present.frame_id > max_i64 or
                present.rendered_revision > max_i64 or
                present.monotonic_event_us > max_i64):
                return Err("event_correlation_overflow")
            return Ok(Backend2dEventReceipt(
                sequence: BACKEND_2D_EVENT_SEQUENCE,
                count: 6,
                backend: backend,
                injected: events[0].operation_code ==
                    BACKEND_RENDER_OPERATION_INPUT_IRQ,
                delivered: events[1].operation_code ==
                    BACKEND_RENDER_OPERATION_WM_APPLY,
                ordered: events[2].operation_code ==
                    BACKEND_RENDER_OPERATION_DAMAGE_COMMIT and
                    present.operation_code == BACKEND_RENDER_OPERATION_PRESENT,
                delivery_source: delivery_source,
                schema_version: header.version.to_i64(),
                firmware_status_code: header.firmware_status_code.to_i64(),
                source_identity_hash: source_identity,
                source_revision:
                    backend_render_receipt_v2_source_revision(header),
                boot_id: header.boot_id.to_i64(),
                input_sequence: present.input_sequence.to_i64(),
                frame_id: present.frame_id.to_i64(),
                rendered_revision: present.rendered_revision.to_i64(),
                monotonic_event_us: present.monotonic_event_us.to_i64(),
                operation_code: present.operation_code.to_i64(),
                receipt_stage_sequence: BACKEND_2D_RECEIPT_STAGE_SEQUENCE,
                receipt_stage_count: events.len().to_i64()
            ))
    Err("invalid_brr2_receipt")

pub fn backend_2d_validate_correlated_event_receipt(
    receipt: Backend2dEventReceipt
) -> text:
    if receipt.schema_version != 2:
        return "unknown_schema_version"
    if receipt.firmware_status_code != 1 and receipt.firmware_status_code != 2:
        return "unknown_firmware_status"
    if not _backend_2d_nonzero_hex_shape_valid(receipt.source_identity_hash, 64):
        return "invalid_source_identity"
    if not _backend_2d_revision_valid(receipt.source_revision):
        return "invalid_source_revision"
    if (receipt.boot_id <= 0 or receipt.input_sequence <= 0 or
        receipt.frame_id <= 0 or receipt.rendered_revision <= 0 or
        receipt.monotonic_event_us <= 0):
        return "missing_event_correlation"
    if receipt.operation_code != 1:
        return "unknown_operation"
    if (receipt.receipt_stage_sequence != BACKEND_2D_RECEIPT_STAGE_SEQUENCE or
        receipt.receipt_stage_count != 4):
        return "invalid_receipt_stage_sequence"
    if receipt.sequence != BACKEND_2D_EVENT_SEQUENCE or receipt.count != 6:
        return "invalid_event_sequence"
    if not receipt.injected:
        return "events_not_injected"
    if not receipt.delivered:
        return "events_not_delivered"
    if not receipt.ordered:
        return "events_not_ordered"
    if (receipt.backend != "simpleos_x86_64_simd" and
        receipt.backend != "simpleos_arm64_simd"):
        return "invalid_correlated_backend"
    if receipt.delivery_source == "" or receipt.delivery_source == "qmp":
        return "invalid_event_delivery_source"
    "pass"

pub fn backend_2d_execution_receipt(
    provenance: text, identity: text, cpu_fallback_used: bool,
    simd_hits: i64, simd_chunks: i64,
    scalar_parity: bool
) -> Backend2dExecutionReceipt:
    Backend2dExecutionReceipt(
        provenance: provenance,
        identity: identity,
        cpu_fallback_used: cpu_fallback_used,
        simd_hits: simd_hits,
        simd_chunks: simd_chunks,
        scalar_parity: scalar_parity
    )

pub fn backend_2d_capture_evidence(backend: text, target: text, scene_id: text,
                                   width: i64, height: i64, dpi: i64,
                                   pixel_sha256: text,
                                   non_background_bounds: text,
                                   events: Backend2dEventReceipt,
                                   capture_path: text,
                                   source_revision: text,
                                   execution: Backend2dExecutionReceipt) -> Backend2dCaptureEvidence:
    Backend2dCaptureEvidence(
        backend: backend,
        target: target,
        scene_id: scene_id,
        width: width,
        height: height,
        dpi: dpi,
        pixel_sha256: pixel_sha256,
        non_background_bounds: non_background_bounds,
        events: events,
        capture_path: capture_path,
        source_revision: source_revision,
        execution: execution
    )

pub fn backend_2d_validate_capture(evidence: Backend2dCaptureEvidence) -> text:
    if not _backend_2d_known(evidence.backend):
        return "unknown_backend"
    if evidence.target == "":
        return "missing_target"
    if evidence.scene_id == "":
        return "missing_scene_id"
    if evidence.width <= 0 or evidence.height <= 0:
        return "invalid_dimensions"
    if evidence.dpi <= 0:
        return "invalid_dpi"
    if not _backend_2d_hex_shape_valid(evidence.pixel_sha256, 64):
        return "invalid_pixel_sha256"
    if not _backend_2d_bounds_valid(
        evidence.non_background_bounds, evidence.width, evidence.height
    ):
        return "invalid_non_background_bounds"
    if evidence.events.backend != evidence.backend:
        return "event_backend_mismatch"
    val simpleos_backend = evidence.backend == "simpleos_x86_64_simd" or
        evidence.backend == "simpleos_arm64_simd"
    if simpleos_backend:
        val correlated_status =
            backend_2d_validate_correlated_event_receipt(evidence.events)
        if correlated_status != "pass":
            return correlated_status
        if evidence.source_revision != evidence.events.source_revision:
            return "event_source_revision_mismatch"
    if evidence.events.sequence != BACKEND_2D_EVENT_SEQUENCE or
       evidence.events.count != 6:
        return "invalid_event_sequence"
    if not evidence.events.injected:
        return "events_not_injected"
    if not evidence.events.delivered:
        return "events_not_delivered"
    if not evidence.events.ordered:
        return "events_not_ordered"
    if evidence.events.delivery_source == "" or
       evidence.events.delivery_source == "qmp":
        return "invalid_event_delivery_source"
    if not evidence.capture_path.ends_with(".ppm") and
       not evidence.capture_path.ends_with(".png"):
        return "invalid_capture_path"
    if not _backend_2d_revision_valid(evidence.source_revision):
        return "invalid_source_revision"
    if evidence.execution.cpu_fallback_used:
        return "cpu_fallback_used"
    val gpu_backend = evidence.backend == "metal" or evidence.backend == "vulkan"
    if gpu_backend and evidence.execution.provenance != "device_readback":
        return "missing_device_readback"
    if gpu_backend and evidence.execution.identity == "":
        return "missing_device_identity"
    if not gpu_backend and evidence.execution.provenance != "native_simd":
        return "missing_native_simd"
    if not gpu_backend and (evidence.execution.simd_hits <= 0 or
                            evidence.execution.simd_chunks <= 0):
        return "missing_simd_counters"
    if not gpu_backend and not evidence.execution.scalar_parity:
        return "scalar_parity_failed"
    "accepted"

pub fn backend_2d_compare_capture(reference: Backend2dCaptureEvidence,
                                  candidate: Backend2dCaptureEvidence,
                                  different_pixels: i64,
                                  max_channel_diff: i64,
                                  tolerance_profile: text,
                                  pixels_within_tolerance: bool) -> Backend2dCaptureComparison:
    val reference_status = backend_2d_validate_capture(reference)
    val candidate_status = backend_2d_validate_capture(candidate)
    val dimensions_match = reference.width == candidate.width and
        reference.height == candidate.height
    val metadata_match = reference.scene_id == candidate.scene_id and
        reference.dpi == candidate.dpi
    val events_match = reference.events.sequence == candidate.events.sequence and
        reference.events.count == candidate.events.count
    val revisions_match = reference.source_revision == candidate.source_revision
    val pixels_exact = reference.pixel_sha256 == candidate.pixel_sha256
    var reason = "accepted"
    if reference_status != "accepted":
        reason = "reference_" + reference_status
    elif candidate_status != "accepted":
        reason = "candidate_" + candidate_status
    elif not dimensions_match:
        reason = "dimension_mismatch"
    elif not metadata_match:
        reason = "metadata_mismatch"
    elif not events_match:
        reason = "event_mismatch"
    elif not revisions_match:
        reason = "revision_mismatch"
    elif different_pixels < 0 or max_channel_diff < 0 or
         max_channel_diff > 255 or
         not _backend_2d_tolerance_profile_valid(tolerance_profile):
        reason = "invalid_pixel_comparison"
    elif pixels_exact and (different_pixels != 0 or max_channel_diff != 0):
        reason = "inconsistent_exact_pixels"
    elif not pixels_exact and (different_pixels == 0 or max_channel_diff == 0):
        reason = "inconsistent_changed_pixels"
    elif pixels_within_tolerance and tolerance_profile == "strict":
        reason = "strict_tolerance_forbidden"
    elif not pixels_exact and not pixels_within_tolerance:
        reason = "pixel_mismatch"
    val accepted = reason == "accepted"
    Backend2dCaptureComparison(
        reference_backend: reference.backend,
        candidate_backend: candidate.backend,
        reference_status: reference_status,
        candidate_status: candidate_status,
        dimensions_match: dimensions_match,
        metadata_match: metadata_match,
        events_match: events_match,
        revisions_match: revisions_match,
        pixels_exact: pixels_exact,
        different_pixels: different_pixels,
        max_channel_diff: max_channel_diff,
        tolerance_profile: tolerance_profile,
        pixels_within_tolerance: pixels_within_tolerance,
        accepted: accepted,
        reason: reason
    )

export BACKEND_2D_EVENT_SEQUENCE
