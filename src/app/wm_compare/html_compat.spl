# HTML Compat — Phase 2 Chrome ↔ Simple HTML/CSS Pixel Equivalence
#
# Incrementally captures the same HTML fixture from two render sources:
#   A  checked-in Electron / Chromium golden PPMs
#   B  Simple Browser Engine (BrowserRenderer.render_html_to_pixels)
#
# Renders at 320x240. Iterates fixtures in order (00..03 + 10..17 layered on
# top of 02_block_boxes.html) and stops at the first divergent fixture.
#
# Output:
#   test/09_baselines/html_compat/<id>/chrome.ppm
#   test/09_baselines/html_compat/<id>/simple.ppm
#   test/09_baselines/html_compat/<id>/diff_chrome_vs_simple.ppm  (on mismatch)
#   test/09_baselines/html_compat/<id>/report.sdn
#
# Usage:
#   bin/simple run src/app/wm_compare/html_compat.spl
#   bin/simple run src/app/wm_compare/html_compat.spl --only=02_block_boxes
#   bin/simple run src/app/wm_compare/html_compat.spl --update-baseline
#   bin/simple run src/app/wm_compare/html_compat.spl --skip-simple

# Split from src/app/wm_compare/html_compat.spl to keep module cohesion under the 800-line source limit.
export use app.wm_compare._HtmlCompat.capture_and_compare.{CaptureResult, capture_error, ComparisonResult, PerceptualResult, ToleranceProfile, profile_strict, profile_text_tolerant, compare_exact, compare_perceptual, generate_diff_image, Fixture, build_catalog, HtmlCompatOpts, default_opts, parse_opts, print_help, load_combined_html, capture_chrome, chrome_capture_temp_ppm_path, load_chrome_golden, load_ppm_capture, capture_simple, baseline_dir, chrome_ppm_path, simple_ppm_path, diff_ppm_path, report_sdn_path, LocalPpm}
export use app.wm_compare._HtmlCompat.ppm_and_widget_pixels.{decode_ppm_local, write_ppm_local, PairResult}
export use app.wm_compare._HtmlCompat.report_and_fixture.{compare_pair, write_report, run_fixture, matches_only, html_compat_cli_main}

use app.wm_compare._HtmlCompat.report_and_fixture.{html_compat_cli_main}

fn main() -> i64:
    return html_compat_cli_main()
