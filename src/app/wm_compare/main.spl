# WM Compare — Unified Pixel Capture + Compare Orchestrator
#
# Captures a named scene from three render sources:
#   A  Electron baseline (via tools/electron-shell/screenshot.js)
#   B  live macOS host Simple Web WM (via tools/electron-shell/screenshot.js)
#   D  QEMU Simple OS self-rendering — via qemu_capture.capture_qemu_vm (QMP)
#
# Source C (in-guest webengine) is intentionally skipped — deferred to Phase 6.
#
# Compare strategy: memcmp-first (exact), fall through to YIQ perceptual,
# dump a PPM heat-map diff via export_comparison_ppm only on mismatch.
# Writes artifacts under test/09_baselines/wm_compare/<scene>/.
#
# Usage:
#   bin/simple run src/app/wm_compare/main.spl \
#       --source=A|B|D|all --scene=<name> [--update-baseline] \
#       [--tolerance=strict|text_tolerant|aa_aware] \
#       [--width=320 --height=240]

# Split from src/app/wm_compare/main.spl to keep module cohesion under the 800-line source limit.
use app.wm_compare_host.log_modes.{parse_log_options}
use app.wm_compare._WmCompareMain.run_modes.{main as wm_compare_run_modes_main}
export use app.wm_compare._WmCompareMain.capture_io.{CliOpts, default_opts, parse_opts, wm_compare_wm_mode_validation_error, print_help, resolve_tolerance, baseline_dir, baseline_ppm_path, diff_ppm_path, report_sdn_path, capture_source_a, capture_source_b, capture_source_d, write_baseline, read_baseline, CompareSummary, compare_pair, write_report, PpmHandle}
export use app.wm_compare._WmCompareMain.run_modes.{run_bit_compare_mode, abs_i32_local, run_live_bd_compare_mode, capture_one, run_capture_phase, sources_for_option, main, wm_compare_is_log_option, wm_compare_clean_args, print_wm_compare_shared_log_options}

fn main() -> i64:
    wm_compare_run_modes_main()
