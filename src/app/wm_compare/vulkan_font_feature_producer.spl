"""Pure-Simple half of the packed-font C Vulkan parity workload."""

use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.text_layout.font_renderer.{FontRenderBatch, FontRenderQuad}
use std.gc_async_mut.io.time_ops.{time_now_nanos}
use std.common.crypto.sha256.{sha256_text}

val WIDTH: i32 = 7680
val HEIGHT: i32 = 4320
val GLYPHS: i64 = 64
val SAMPLES: i64 = 31
val BG: u32 = 0xff101010u32
val INK: u32 = 0xffffffffu32
val WORKLOAD_MANIFEST: text = "font-packed-v1;7680x4320;atlas=16x16-opaque;glyphs=64;placement=20x20;params-upload=timed"

fn packed_font_batch() -> FontRenderBatch:
    var atlas: [u32] = []
    var pixel: i64 = 0
    while pixel < 16 * 16:
        atlas.push(INK)
        pixel = pixel + 1
    var quads: [FontRenderQuad] = []
    var glyph: i64 = 0
    while glyph < GLYPHS:
        quads.push(FontRenderQuad(
            codepoint: 65 + glyph.to_i32(), byte_offset: glyph,
            dst_x: (glyph % 256).to_i32() * 20,
            dst_y: (glyph / 256).to_i32() * 20,
            width: 16, height: 16, atlas_x: 0, atlas_y: 0, color: INK))
        glyph = glyph + 1
    FontRenderBatch(
        program_version: 1, font_identity: "synthetic-opaque-16x16",
        face_generation: 1, valid: true, atlas_width: 16, atlas_height: 16,
        atlas_pixels: atlas, quads: quads, atlas_generation: 1,
        dirty_rects: [], execution_target: "vulkan")

fn packed_font_batch_valid(batch: FontRenderBatch) -> bool:
    if (not batch.valid or batch.program_version != 1 or
        batch.font_identity != "synthetic-opaque-16x16" or
        batch.atlas_width != 16 or batch.atlas_height != 16 or
        batch.atlas_pixels.len() != 256 or batch.quads.len() != GLYPHS or
        batch.atlas_generation != 1 or batch.dirty_rects.len() != 0 or
        batch.execution_target != "vulkan"):
        return false
    for atlas_pixel in batch.atlas_pixels:
        if atlas_pixel != INK: return false
    var glyph: i64 = 0
    while glyph < batch.quads.len():
        val quad = batch.quads[glyph]
        if (quad.codepoint != 65 + glyph.to_i32() or quad.byte_offset != glyph or
            quad.dst_x != (glyph % 256).to_i32() * 20 or
            quad.dst_y != (glyph / 256).to_i32() * 20 or
            quad.width != 16 or quad.height != 16 or
            quad.atlas_x != 0 or quad.atlas_y != 0 or quad.color != INK):
            return false
        glyph = glyph + 1
    true

fn sorted_i64(values: [i64]) -> [i64]:
    var out = values
    var i: i64 = 0
    while i < out.len():
        var j = i + 1
        while j < out.len():
            if out[j] < out[i]:
                val temporary = out[i]
                out[i] = out[j]
                out[j] = temporary
            j = j + 1
        i = i + 1
    out

fn percentile(sorted: [i64], pct: i64) -> i64:
    var index = ((sorted.len() * pct + 99) / 100) - 1
    if index < 0: index = 0
    if index >= sorted.len(): index = sorted.len() - 1
    sorted[index]

fn framebuffer_result(pixels: [u32]) -> (i64, i64):
    var checksum: i64 = 1469598103934665603
    var mismatches: i64 = 0
    var index: i64 = 0
    while index < pixels.len():
        val x = index % WIDTH.to_i64()
        val y = index / WIDTH.to_i64()
        val gx = x / 20
        val gy = y / 20
        val ink = (gx < 256 and x % 20 < 16 and y % 20 < 16 and
            gy * 256 + gx < GLYPHS)
        val expected = if ink: INK else: BG
        if pixels[index] != expected: mismatches = mismatches + 1
        checksum = (checksum ^ pixels[index].to_i64()) * 1099511628211
        index = index + 1
    (checksum, mismatches)

fn main() -> i64:
    val created = Engine2D.create_with_backend_strict(WIDTH, HEIGHT, "vulkan")
    if not created.is_ok():
        print "simple_vulkan_font_status=blocked reason=strict-vulkan-unavailable"
        return 2
    var engine = created.unwrap()
    val batch = packed_font_batch()
    if not packed_font_batch_valid(batch):
        engine.shutdown()
        print "simple_vulkan_font_status=failed reason=workload-manifest-drift"
        return 1
    engine.clear(BG)
    if not engine.finalize_compute_frame_no_readback():
        engine.shutdown()
        print "simple_vulkan_font_status=failed reason=seed-finalize-failed"
        return 1
    if not engine._draw_font_batch(0, 0, batch) or
       not engine.finalize_compute_frame_no_readback():
        engine.shutdown()
        print "simple_vulkan_font_status=failed reason=warmup-failed"
        return 1
    var samples: [i64] = []
    var valid = true
    var sample: i64 = 0
    while sample < SAMPLES:
        val started = time_now_nanos()
        val drawn = engine._draw_font_batch(0, 0, batch)
        val finalized = if drawn: engine.finalize_compute_frame_no_readback() else: false
        val elapsed = time_now_nanos() - started
        val receipt = engine.latest_vulkan_frame_receipt()
        if (not finalized or elapsed <= 0 or receipt == nil or
            not receipt.?.completion_known or not receipt.?.no_readback or
            receipt.?.readback_bytes != 0 or receipt.?.cpu_fallback_used):
            valid = false
        samples.push(elapsed)
        sample = sample + 1
    val font_evidence = engine.vulkan_font_performance_evidence()
    val readback = engine.read_pixels_with_source()
    val (checksum, mismatches) = framebuffer_result(readback.pixels)
    val ordered = sorted_i64(samples)
    val device_hash = if font_evidence == nil: "" else:
        sha256_text(font_evidence.?.device_name + "|" + font_evidence.?.driver_identity)
    val accepted = (valid and font_evidence != nil and
        font_evidence.?.quad_count == GLYPHS and font_evidence.?.dispatch_count == 1 and
        font_evidence.?.status == "executed" and font_evidence.?.device_executed and
        font_evidence.?.submitted and font_evidence.?.completion_waited and
        font_evidence.?.submission_count == 1 and font_evidence.?.fence_count == 1 and
        font_evidence.?.fence_evidence_available and font_evidence.?.fence_destroyed and
        readback.source == "device_readback" and
        readback.pixels.len() == WIDTH.to_i64() * HEIGHT.to_i64() and
        readback.pixel_count == WIDTH.to_i64() * HEIGHT.to_i64() and
        readback.backend_handle > 0 and readback.device_identity > 0 and
        readback.checksum > 0 and mismatches == 0 and device_hash.len() == 64)
    engine.shutdown()
    if not accepted:
        print "simple_vulkan_font_status=failed reason=evidence-rejected"
        return 1
    print "schema=engine2d-vulkan-feature-perf-v1\n" +
        "implementation=simple\nbackend=vulkan\nfeature=font-atlas-packed\n" +
        "workload_hash=" + sha256_text(WORKLOAD_MANIFEST) + "\n" +
        "device_hash=" + device_hash + "\nwidth=7680\nheight=4320\n" +
        "warmup_count=1\nsample_count=31\n" +
        "timing_scope=params-upload-and-vulkan-submit-and-fence\n" +
        "p50_ns=" + percentile(ordered, 50).to_string() + "\n" +
        "p95_ns=" + percentile(ordered, 95).to_string() + "\n" +
        "timed_readback_bytes=0\nmismatch_count=0\n" +
        "checksum=" + checksum.to_string() + "\ncompletion=known\nfallback=none"
    0

export packed_font_batch, packed_font_batch_valid, framebuffer_result
