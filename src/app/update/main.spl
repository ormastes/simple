# Simple CLI - update command
# Updates dependencies in simple.sdn and simple.lock

use std.cli.cli_util (get_cli_args, find_manifest_path, parse_deps_section)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use app.io.mod (file_read, file_atomic_write, cwd)
use app.pkg.requires_range.{classify_manifest_interface_ranges, resolve_manifest_requires,
    generate_requires_lock, current_phase8_policy_receipt}
use std.log.{error}

fn print_help():
    print "Usage: simple update [package] [options]"
    print ""
    print "Update dependencies to their latest compatible versions."
    print "If no package is specified, updates all dependencies."
    print ""
    print "Options:"
    print "  --json       Output as JSON"
    print "  --dry-run    Show what would be updated without changes"
    for line in log_options_help():
        print "  {line}"
    print "  -h, --help   Show this help"

fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn _json_array(names: [text]) -> text:
    var parts: [text] = []
    var i = 0
    while i < names.len():
        parts.push("\"{names[i]}\"")
        i = i + 1
    "[" + parts.join(",") + "]"

fn run_update_command(args: [text]) -> i64:
    var dry_run = false
    var target_pkg = ""
    var as_json = false
    val log_opts = parse_log_options(args)
    if not log_opts.valid:
        error("update", log_opts.error)
        return 1

    var ai = 0
    while ai < args.len():
        val arg = args[ai]
        if arg == "-h" or arg == "--help":
            print_help()
            return 0
        elif arg == "--json" or arg == "--log-mode=json":
            as_json = true
        elif arg == "--dry-run":
            dry_run = true
        elif arg == "--log-mode" or arg == "--surface" or arg == "--progress":
            ai = ai + 1
        elif _is_log_option(arg):
            pass
        elif not arg.starts_with("-"):
            target_pkg = arg
        ai = ai + 1

    if log_opts.log_mode == "json":
        as_json = true

    val manifest_path = find_manifest_path()
    if manifest_path == "":
        print "update: no simple.sdn or simple.toml found in current directory"
        return 1
    val current_dir = cwd()
    val lockfile_path = "{current_dir}/simple.lock"
    val content = file_read(manifest_path)
    val classification = classify_manifest_interface_ranges(content, manifest_path)
    var uses_interface_ranges = false
    match classification:
        case Err(errors):
            print "update: manifest classification failed"
            for message in errors:
                print "  " + message
            return 1
        case Ok(value): uses_interface_ranges = value
    if not uses_interface_ranges:
        val deps = parse_deps_section(content, "dependencies")
        if deps.len() == 0:
            if as_json:
                print "{\"dry_run\":{dry_run},\"target\":\"{target_pkg}\",\"count\":0,\"dependencies\":[]}"
                return 0
            print "No dependencies found in manifest."
            return 0
        if target_pkg != "" and not deps.contains(target_pkg):
            print "update: dependency '{target_pkg}' not found in manifest"
            return 1
        val selected = if target_pkg == "" then deps else [target_pkg]
        if as_json:
            print "{\"dry_run\":{dry_run},\"target\":\"{target_pkg}\",\"count\":{selected.len()},\"dependencies\":" + _json_array(selected) + "}"
            return 0
        if log_opts.progress != "summary":
            val progress_line = render_progress(log_opts.progress, selected.len(), selected.len(), "update")
            if progress_line != "":
                print progress_line
        if dry_run:
            print "Would update {selected.len()} dependencies:"
            for name in selected:
                print "  {name}"
            return 0
        var legacy_lock = "lockfile_version: 1\ngenerated: simple update\npackages:\n"
        for name in deps:
            legacy_lock = legacy_lock + "  {name}: *\n"
        if not file_atomic_write(lockfile_path, legacy_lock):
            print "update: failed to write lockfile"
            return 1
        print "Updated simple.lock"
        return 0

    val resolved = resolve_manifest_requires(content, manifest_path, current_dir)
    val policy_receipt = current_phase8_policy_receipt()
    match resolved:
        case Err(errors):
            print "update: interface range resolution failed"
            for message in errors:
                print "  " + message
            return 1
        case Ok((pin, result)):
            var lock_content = ""
            match policy_receipt:
                case Err(errors):
                    print "update: policy receipt validation failed"
                    for message in errors:
                        print "  " + message
                    return 1
                case Ok(policy):
                    lock_content = generate_requires_lock(pin, result, policy)
            if target_pkg != "":
                var found = false
                for edge in pin.dependencies:
                    if edge.package_name == target_pkg or edge.project_path == target_pkg:
                        found = true
                if not found:
                    print "update: dependency '" + target_pkg + "' not found in manifest"
                    return 1
            if as_json:
                print "{\"dry_run\":{dry_run},\"target\":\"{target_pkg}\",\"resolutions\":{result.resolutions.len()}}"
                return 0
            if log_opts.progress != "summary":
                val progress_line = render_progress(log_opts.progress, result.resolutions.len(), result.resolutions.len(), "update")
                if progress_line != "":
                    print progress_line
            if dry_run:
                print "Would update simple.lock with {result.resolutions.len()} interface resolutions"
                return 0
            if not file_atomic_write(lockfile_path, lock_content):
                print "update: failed to write lockfile"
                return 1
            print "Updated simple.lock with {result.resolutions.len()} interface resolutions"

    0

fn main() -> i64:
    run_update_command(get_cli_args())

export run_update_command
