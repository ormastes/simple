# Mirrors the MCP module-global init pattern that broke the alloca lane:
# a text module global written from a branch-assigned local (env_get ?? ""),
# plus a read-back through a plain function.
use std.io_runtime.{env_get}

var _SR_MODE = "auto"

fn _sr_get_mode() -> text:
    _SR_MODE

fn _sr_init_mode(args: [text]):
    val env_set = env_get("SR_MODE") ?? ""
    if env_set == "auto" or env_set == "core" or env_set == "all":
        _SR_MODE = env_set
    elif env_set != "":
        _SR_MODE = "auto"
    var i: i32 = 0
    while i < args.len() as i32:
        val arg = args[i]
        if arg.starts_with("--mode="):
            val v = arg.replace("--mode=", "")
            if v == "auto" or v == "core" or v == "all":
                _SR_MODE = v
            else:
                _SR_MODE = "auto"
        i = i + 1

# Two types with SAME-NAMED static factories: both used to emit as bare
# `@mk` (invalid redefinition at llc, wrong dispatch even when unique).
class SrA:
    v: i64
    static fn mk(v: i64) -> SrA:
        SrA(v: v)

class SrB:
    w: i64
    static fn mk(w: i64) -> SrB:
        SrB(w: w)

var _SR_ITEMS: [text] = []

fn _sr_add(item: text):
    _SR_ITEMS.push(item)

fn _sr_count() -> i64:
    var n = 0
    for s in _SR_ITEMS:
        n = n + 1
    n

# Mirrors _parse_t32_connection: text param, `var p = param`, branch-reassign
# from an array index, read p after the branch. The var reused the PARAM's
# local id -> duplicate `%l0` def at llc (multiple definition of local value).
fn _sr_parse(program: text) -> (text, text):
    var p = program
    val slash_parts = p.split("//")
    if slash_parts.len() >= 2:
        p = slash_parts[1]
    val colon_parts = p.split(":")
    if colon_parts.len() >= 2:
        return (colon_parts[0], colon_parts[1])
    if p.len() > 0:
        return (p, "20000")
    ("localhost", "20000")

fn main() -> i32:
    val args: [text] = ["--mode=core"]
    _sr_init_mode(args)
    val (ph, pp) = _sr_parse("t32://h:1")
    print("parse=" + ph + ":" + pp)
    print("mode=" + _sr_get_mode())
    print("mk=" + str(SrA.mk(3).v + SrB.mk(4).w))
    _sr_add("a")
    _sr_add("b")
    print("n=" + str(_sr_count()))
    print("END")
    0
