# codex-impl
# Parent-owned process coordinator for rt(hal) provider workers.

use app.io.mod.{
    process_spawn_piped, process_write_stdin_some, process_read_stdout,
    process_is_piped_alive, process_close_piped, process_kill,
    rt_sleep_ms
}
use std.io_runtime.{time_now_monotonic_ms}
use std.common.structural.hal_provider.*

val HAL_PROCESS_PROTOCOL_V1: text = "HALRES1"
val HAL_PROCESS_RESPONSE_FIELDS_V1: i64 = 17
val HAL_PROCESS_MAX_RESPONSE_BYTES_V1: i64 = 512
val HAL_PROCESS_MAX_OUTPUT_BYTES_V1: i64 = 704
val HAL_PROCESS_MAX_REQUEST_BYTES_V1: i64 = 4096
val HAL_PROCESS_MAX_COMMAND_BYTES_V1: i64 = 512
val HAL_PROCESS_MAX_ARGUMENT_COUNT_V1: i64 = 32
val HAL_PROCESS_MAX_ARGUMENT_BYTES_V1: i64 = 4096
val HAL_PROCESS_MAX_DEADLINE_MS_V1: i64 = 600000
val HAL_PROCESS_I64_MIN_V1: i64 = -9223372036854775807 - 1
val HAL_ISOLATION_PROTOCOL_V1: text = "HALISO1"
val HAL_ISOLATION_FIELDS_V1: i64 = 8
val HAL_TRUSTED_LAUNCHER_V1: text =
    "/usr/libexec/simple/hal-provider-launcher-v1"
val HAL_TRUSTED_PURE_PROVIDER_V1: text =
    "/usr/libexec/simple/hal-provider-pure-v1"
val HAL_TRUSTED_C_PROVIDER_V1: text =
    "/usr/libexec/simple/hal-provider-c-v1"
val HAL_TRUSTED_RUST_PROVIDER_V1: text =
    "/usr/libexec/simple/hal-provider-rust-v1"

struct HalWorkerEndpointV1:
    provider: HalProviderKind
    command: text
    args: [text]
    trusted_launcher: bool

fn hal_worker_endpoint_v1(provider: HalProviderKind, command: text,
                          args: [text]) -> HalWorkerEndpointV1:
    HalWorkerEndpointV1(provider: provider, command: command, args: args,
                        trusted_launcher: false)

fn _hal_trusted_provider_path_v1(provider: HalProviderKind) -> text:
    match provider:
        case HalProviderKind.PureSimple: HAL_TRUSTED_PURE_PROVIDER_V1
        case HalProviderKind.C: HAL_TRUSTED_C_PROVIDER_V1
        case HalProviderKind.Rust: HAL_TRUSTED_RUST_PROVIDER_V1

fn hal_trusted_worker_endpoint_v1(provider: HalProviderKind,
                                  args: [text]) -> HalWorkerEndpointV1:
    # Only the repository-installed launcher is an isolation authority.  The
    # worker path is data to that launcher and must be absolute so PATH cannot
    # select a different image after the launcher clears the environment.
    HalWorkerEndpointV1(provider: provider,
                        command: _hal_trusted_provider_path_v1(provider),
                        args: args,
                        trusted_launcher: true)

struct HalProcessCoordinatorReceiptV1:
    comparison: HalOrchestrationReceiptV1
    launched_mask: i64
    completed_mask: i64
    cancelled_mask: i64
    reaped_mask: i64
    protocol_error_mask: i64
    output_overflow_mask: i64
    isolation_proven_mask: i64
    critical_ready: bool
    elapsed_ms: i64
    cleanup_overran_deadline: bool

class HalProcessLaneOwnerV1:
    endpoint: HalWorkerEndpointV1
    pid: i64
    request: text
    request_offset: i64
    output: text
    result: HalProviderResultV1
    result_valid: bool
    spawned: bool
    terminal: bool
    reaped: bool
    cancelled: bool
    protocol_error: bool
    output_overflow: bool
    isolation: HalIsolationReceiptV1
    isolation_valid: bool
    result_start: i64

fn _hal_invalid_result(provider: HalProviderKind,
                       invocation_id: i64) -> HalProviderResultV1:
    hal_provider_result_v1(provider, invocation_id,
        HalStatusV1.InvalidRequest, 1, 0, 0, 0, 0,
        0, 0, 0, 0, HalOverflowKindV1.None, -1, 0, 0)

fn _hal_unproven_isolation(provider: HalProviderKind, invocation_id: i64,
                           pid: i64) -> HalIsolationReceiptV1:
    # The generic piped-process facade does not prove handle/env/memory
    # isolation. Preserve the actual handle but make admission fail closed.
    hal_isolation_receipt_v1(
        provider, invocation_id, pid, 0, -1, -1, -1, true, false)

fn _hal_request_line(operation: HalOperationV1,
                     request: HalProviderRequestV1) -> text:
    "HALREQ1|{operation.contract_version}|{operation.operation_id}|{request.invocation_id}|{request.fixture_id}|{request.input_offset}|{request.input_length}|{request.input_capacity}|{request.trace_capacity}\n"

fn _hal_process_lane_owner(endpoint: HalWorkerEndpointV1,
                           request: text,
                           invocation_id: i64) -> HalProcessLaneOwnerV1:
    HalProcessLaneOwnerV1(
        endpoint: endpoint, pid: -1, request: request, request_offset: 0,
        output: "", result: _hal_invalid_result(endpoint.provider, invocation_id),
        result_valid: false, spawned: false, terminal: false, reaped: false,
        cancelled: false, protocol_error: false, output_overflow: false,
        isolation: _hal_unproven_isolation(
            endpoint.provider, invocation_id, -1),
        isolation_valid: false, result_start: 0)

fn _hal_prefix_at(value: text, start: i64, prefix: text) -> bool:
    if start < 0 or start + prefix.len() > value.len():
        return false
    var index = 0
    while index < prefix.len():
        if value.char_code_at(start + index) != prefix.char_code_at(index):
            return false
        index = index + 1
    true

fn _hal_parse_i64_field(value: text, start: i64,
                        end: i64) -> (bool, i64, i64):
    if start < 0 or start >= end or end > value.len():
        return (false, 0, start)
    var cursor = start
    var negative = false
    if value.char_code_at(cursor) == 45:
        negative = true
        cursor = cursor + 1
        if cursor >= end:
            return (false, 0, start)
    var parsed: i64 = 0
    var digits = 0
    while cursor < end and value.char_code_at(cursor) != 124:
        val code = value.char_code_at(cursor)
        if code < 48 or code > 57:
            return (false, 0, start)
        val digit = code - 48
        if negative:
            if parsed < (HAL_PROCESS_I64_MIN_V1 + digit) / 10:
                return (false, 0, start)
            parsed = parsed * 10 - digit
        else:
            if parsed > (9223372036854775807 - digit) / 10:
                return (false, 0, start)
            parsed = parsed * 10 + digit
        digits = digits + 1
        cursor = cursor + 1
    if digits == 0:
        return (false, 0, start)
    val next = if cursor < end: cursor + 1 else: cursor
    (true, parsed, next)

fn _hal_find_newline(value: text, start: i64) -> i64:
    var index = start
    while index < value.len():
        if value.char_code_at(index) == 10:
            return index
        index = index + 1
    -1

fn _hal_status_from_i64(value: i64) -> (bool, HalStatusV1):
    match value:
        case 0: (true, HalStatusV1.Ok)
        case 1: (true, HalStatusV1.UnsupportedCapability)
        case 2: (true, HalStatusV1.InvalidRequest)
        case 3: (true, HalStatusV1.ProviderError)
        case 4: (true, HalStatusV1.Timeout)
        case 5: (true, HalStatusV1.Overflow)
        case 6: (true, HalStatusV1.Diverged)
        case 7: (true, HalStatusV1.Cancelled)
        case _: (false, HalStatusV1.InvalidRequest)

fn _hal_overflow_from_i64(value: i64) -> (bool, HalOverflowKindV1):
    match value:
        case 0: (true, HalOverflowKindV1.None)
        case 1: (true, HalOverflowKindV1.Payload)
        case 2: (true, HalOverflowKindV1.Trace)
        case 3: (true, HalOverflowKindV1.DifferenceReport)
        case 4: (true, HalOverflowKindV1.Log)
        case _: (false, HalOverflowKindV1.None)

fn _hal_parse_result_range(provider: HalProviderKind, line: text,
                           start: i64, end: i64,
                           expected_invocation: i64) -> (bool, HalProviderResultV1):
    val invalid = _hal_invalid_result(provider, expected_invocation)
    if start < 0 or end <= start or end > line.len()
            or end - start > HAL_PROCESS_MAX_RESPONSE_BYTES_V1:
        return (false, invalid)
    if line.char_code_at(end - 1) == 124:
        return (false, invalid)
    if not _hal_prefix_at(line, start, "HALRES1|"):
        return (false, invalid)
    val f1 = _hal_parse_i64_field(line, start + 8, end)
    val f2 = _hal_parse_i64_field(line, f1.2, end)
    val f3 = _hal_parse_i64_field(line, f2.2, end)
    val f4 = _hal_parse_i64_field(line, f3.2, end)
    val f5 = _hal_parse_i64_field(line, f4.2, end)
    val f6 = _hal_parse_i64_field(line, f5.2, end)
    val f7 = _hal_parse_i64_field(line, f6.2, end)
    val f8 = _hal_parse_i64_field(line, f7.2, end)
    val f9 = _hal_parse_i64_field(line, f8.2, end)
    val f10 = _hal_parse_i64_field(line, f9.2, end)
    val f11 = _hal_parse_i64_field(line, f10.2, end)
    val f12 = _hal_parse_i64_field(line, f11.2, end)
    val f13 = _hal_parse_i64_field(line, f12.2, end)
    val f14 = _hal_parse_i64_field(line, f13.2, end)
    val f15 = _hal_parse_i64_field(line, f14.2, end)
    val f16 = _hal_parse_i64_field(line, f15.2, end)
    if (not f1.0 or not f2.0 or not f3.0 or not f4.0
            or not f5.0 or not f6.0 or not f7.0 or not f8.0
            or not f9.0 or not f10.0 or not f11.0 or not f12.0
            or not f13.0 or not f14.0 or not f15.0 or not f16.0
            or f16.2 != end):
        return (false, invalid)
    if f1.1 != hal_provider_kind_to_i64(provider):
        return (false, invalid)
    val invocation = f2.1
    if invocation != expected_invocation:
        return (false, invalid)
    val status_pair = _hal_status_from_i64(f3.1)
    val overflow_pair = _hal_overflow_from_i64(f13.1)
    if not status_pair.0 or not overflow_pair.0:
        return (false, invalid)
    val result = hal_provider_result_v1(
        provider, invocation, status_pair.1, f4.1,
        f5.1, f6.1, f7.1, f8.1, f9.1, f10.1, f11.1, f12.1,
        overflow_pair.1, f14.1, f15.1, f16.1)
    (hal_provider_result_v1_well_formed(result), result)

fn _hal_parse_isolation_range(provider: HalProviderKind, line: text,
                              start: i64, end: i64,
                              expected_invocation: i64) ->
        (bool, HalIsolationReceiptV1):
    val invalid = _hal_unproven_isolation(
        provider, expected_invocation, -1)
    if start < 0 or end <= start or end > line.len() or end - start > 192:
        return (false, invalid)
    if line.char_code_at(end - 1) == 124:
        return (false, invalid)
    if not _hal_prefix_at(line, start, "HALISO1|"):
        return (false, invalid)
    val f1 = _hal_parse_i64_field(line, start + 8, end)
    val f2 = _hal_parse_i64_field(line, f1.2, end)
    val f3 = _hal_parse_i64_field(line, f2.2, end)
    val f4 = _hal_parse_i64_field(line, f3.2, end)
    val f5 = _hal_parse_i64_field(line, f4.2, end)
    val f6 = _hal_parse_i64_field(line, f5.2, end)
    val f7 = _hal_parse_i64_field(line, f6.2, end)
    if (not f1.0 or not f2.0 or not f3.0 or not f4.0
            or not f5.0 or not f6.0 or not f7.0 or f7.2 != end):
        return (false, invalid)
    if f1.1 != expected_invocation:
        return (false, invalid)
    val receipt = hal_isolation_receipt_v1(
        provider, f1.1, f2.1, f2.1, f3.1, f4.1, f5.1,
        f6.1 == 1, f7.1 == 1)
    (f2.1 > 0 and f3.1 == 0 and f4.1 == 0 and f5.1 == 0
        and f6.1 == 1 and f7.1 == 1, receipt)

impl HalProcessLaneOwnerV1:
    me spawn(enabled: bool, preflight_valid: bool, deadline_ms: i64):
        if not enabled:
            return
        if not preflight_valid:
            self.protocol_error = true
            self.terminal = true
            return
        if self.endpoint.command == "":
            self.protocol_error = true
            self.terminal = true
            return
        if self.endpoint.trusted_launcher:
            if not self.endpoint.command.starts_with("/"):
                self.protocol_error = true
                self.terminal = true
                return
            val launcher_args = ["{deadline_ms}",
                "{HAL_PROCESS_MAX_RESPONSE_BYTES_V1}", self.endpoint.command]
                + self.endpoint.args
            self.pid = process_spawn_piped(
                HAL_TRUSTED_LAUNCHER_V1, launcher_args)
        else:
            self.pid = process_spawn_piped(
                self.endpoint.command, self.endpoint.args)
        self.spawned = self.pid > 0
        if not self.spawned:
            self.protocol_error = true
            self.terminal = true

    me advance_write():
        if not self.spawned or self.terminal:
            return
        if self.request_offset >= self.request.len():
            return
        val written = process_write_stdin_some(
            self.pid, self.request, self.request_offset,
            self.request.len() - self.request_offset)
        if written < 0:
            self.protocol_error = true
            self.cancel()
        else:
            self.request_offset = self.request_offset + written

    me advance_read(expected_invocation: i64):
        if not self.spawned or self.terminal:
            return
        val chunk = process_read_stdout(self.pid)
        if chunk.len() > 0:
            if self.output.len() + chunk.len() > HAL_PROCESS_MAX_OUTPUT_BYTES_V1:
                self.output = ""
                self.output_overflow = true
                self.cancel()
                return
            if self.output.len() == 0:
                self.output = chunk
            else:
                self.output = self.output + chunk
            var result_start = self.result_start
            var newline = _hal_find_newline(self.output, result_start)
            if (self.endpoint.trusted_launcher and not self.isolation_valid
                    and newline >= 0):
                val parsed_isolation = _hal_parse_isolation_range(
                    self.endpoint.provider, self.output, 0, newline,
                    expected_invocation)
                self.isolation_valid = parsed_isolation.0
                self.isolation = parsed_isolation.1
                if not parsed_isolation.0:
                    self.protocol_error = true
                    self.cancel()
                    return
                result_start = newline + 1
                self.result_start = result_start
                newline = _hal_find_newline(self.output, result_start)
            if newline >= 0:
                if newline != self.output.len() - 1:
                    self.protocol_error = true
                    self.cancel()
                    return
                val parsed = _hal_parse_result_range(
                    self.endpoint.provider, self.output,
                    result_start, newline, expected_invocation)
                self.result_valid = parsed.0
                self.result = parsed.1
                if not parsed.0:
                    self.protocol_error = true
        if not process_is_piped_alive(self.pid):
            self.terminal = true
            self.reaped = true

    me cancel():
        if self.terminal or not self.spawned:
            return
        self.cancelled = true
        # A response is not eligible if its provider misses the terminal
        # deadline after emitting it. Cancellation revokes child-owned output.
        self.result_valid = false
        self.result = _hal_invalid_result(
            self.endpoint.provider, self.result.invocation_id)
        if self.pid > 1:
            process_kill(self.pid)
            val alive_after_kill = process_is_piped_alive(self.pid)
            if not alive_after_kill:
                self.reaped = true
            else:
                self.reaped = process_close_piped(self.pid)
        self.terminal = true

    me close_after_result():
        if self.terminal:
            return
        if self.result_valid:
            if process_is_piped_alive(self.pid):
                return
            self.terminal = true
            self.reaped = true

    fn structural_lane(invocation_id: i64) -> HalProviderLaneV1:
        hal_provider_lane_v1(
            self.endpoint.provider, self.result_valid,
            self.terminal, self.reaped,
            self.request_offset == self.request.len(),
            self.isolation,
            self.result)

fn _hal_lane_enabled(operation: HalOperationV1, mode: HalRunMode,
                     provider: HalProviderKind) -> bool:
    (hal_execution_expected_mask(operation, mode)
        & hal_provider_kind_mask(provider)) != 0

fn _hal_all_terminal(expected_mask: i64,
                     pure_lane: HalProcessLaneOwnerV1,
                     c_lane: HalProcessLaneOwnerV1,
                     rust_lane: HalProcessLaneOwnerV1) -> bool:
    if (expected_mask & 1) != 0 and not pure_lane.terminal:
        return false
    if (expected_mask & 2) != 0 and not c_lane.terminal:
        return false
    if (expected_mask & 4) != 0 and not rust_lane.terminal:
        return false
    true

fn _hal_mask_if(value: bool, provider: HalProviderKind) -> i64:
    if value:
        return hal_provider_kind_mask(provider)
    0

fn _hal_endpoint_bounded(endpoint: HalWorkerEndpointV1,
                         slot_provider: HalProviderKind) -> bool:
    if endpoint.provider != slot_provider:
        return false
    if endpoint.command.len() <= 0
            or endpoint.command.len() > HAL_PROCESS_MAX_COMMAND_BYTES_V1:
        return false
    val reserved_args = if endpoint.trusted_launcher: 3 else: 0
    if endpoint.args.len() + reserved_args > HAL_PROCESS_MAX_ARGUMENT_COUNT_V1:
        return false
    var total = endpoint.command.len()
    if endpoint.trusted_launcher:
        # Decimal deadline/output-cap arguments plus separators are generated
        # after admission; reserve their maximum encoded budget up front.
        total = total + 64
        if total > HAL_PROCESS_MAX_ARGUMENT_BYTES_V1:
            return false
    for arg in endpoint.args:
        if arg.len() > HAL_PROCESS_MAX_ARGUMENT_BYTES_V1 - total:
            return false
        total = total + arg.len()
    total <= HAL_PROCESS_MAX_ARGUMENT_BYTES_V1

fn _hal_preflight_rejection(operation: HalOperationV1,
                            mode: HalRunMode, elapsed_ms: i64,
                            deadline_ms: i64) -> HalProcessCoordinatorReceiptV1:
    val expected = hal_execution_expected_mask(operation, mode)
    val comparison = HalOrchestrationReceiptV1(
        status: HalOrchestrationStatusV1.InvalidReceipt,
        expected_mask: expected, received_mask: 0, admitted_mask: 0,
        rejected_mask: 0, difference_pair_mask: 0,
        all_equivalent: false, preferred_result_ok: false,
        commit_allowed: false, selected_provider: operation.preferred_provider,
        selected_provider_valid: false)
    HalProcessCoordinatorReceiptV1(
        comparison: comparison, launched_mask: 0, completed_mask: 0,
        cancelled_mask: 0, reaped_mask: 0, protocol_error_mask: expected,
        output_overflow_mask: 0, isolation_proven_mask: 0,
        critical_ready: false, elapsed_ms: elapsed_ms,
        cleanup_overran_deadline: deadline_ms > 0 and elapsed_ms > deadline_ms)

fn hal_coordinate_provider_processes_v1(
        operation: HalOperationV1, request: HalProviderRequestV1,
        mode: HalRunMode, pure_endpoint: HalWorkerEndpointV1,
        c_endpoint: HalWorkerEndpointV1, rust_endpoint: HalWorkerEndpointV1,
        deadline_ms: i64) -> HalProcessCoordinatorReceiptV1:
    # Execution-deadline accounting begins before validation/request encoding,
    # owner setup, and spawn. The canonical spawn/close facade is synchronous
    # and has no deadline parameter; mandatory reap may extend past the
    # execution deadline and that cleanup overrun is reported in the receipt.
    val start_ms = time_now_monotonic_ms()
    val effective_deadline = if deadline_ms > 0:
        deadline_ms
    else:
        operation.capacity.deadline_ticks
    val pure_enabled = _hal_lane_enabled(
        operation, mode, HalProviderKind.PureSimple)
    val c_enabled = _hal_lane_enabled(operation, mode, HalProviderKind.C)
    val rust_enabled = _hal_lane_enabled(operation, mode, HalProviderKind.Rust)
    val preflight_valid = (hal_operation_v1_well_formed(operation)
        and hal_provider_request_v1_well_formed(request)
        and request.operation_id == operation.operation_id
        and hal_assurance_to_i64(operation.assurance_floor)
            < HAL_ASSURANCE_CRITICAL
        and operation.capacity.request_bytes <= HAL_PROCESS_MAX_REQUEST_BYTES_V1
        and effective_deadline > 0
        and effective_deadline <= HAL_PROCESS_MAX_DEADLINE_MS_V1
        and (not pure_enabled or _hal_endpoint_bounded(
            pure_endpoint, HalProviderKind.PureSimple))
        and (not c_enabled or _hal_endpoint_bounded(
            c_endpoint, HalProviderKind.C))
        and (not rust_enabled or _hal_endpoint_bounded(
            rust_endpoint, HalProviderKind.Rust)))
    if not preflight_valid:
        return _hal_preflight_rejection(
            operation, mode, time_now_monotonic_ms() - start_ms,
            effective_deadline)
    val request_line = _hal_request_line(operation, request)
    if request_line.len() > operation.capacity.request_bytes
            or request_line.len() > HAL_PROCESS_MAX_REQUEST_BYTES_V1:
        return _hal_preflight_rejection(
            operation, mode, time_now_monotonic_ms() - start_ms,
            effective_deadline)
    val pure_lane = _hal_process_lane_owner(
        pure_endpoint, request_line, request.invocation_id)
    val c_lane = _hal_process_lane_owner(
        c_endpoint, request_line, request.invocation_id)
    val rust_lane = _hal_process_lane_owner(
        rust_endpoint, request_line, request.invocation_id)
    # Spawn every requested lane before servicing any lane: provider work may
    # proceed concurrently while the parent remains the sole result owner.
    var remaining_ms = effective_deadline - (time_now_monotonic_ms() - start_ms)
    pure_lane.spawn(pure_enabled, remaining_ms > 0, remaining_ms)
    remaining_ms = effective_deadline - (time_now_monotonic_ms() - start_ms)
    c_lane.spawn(c_enabled, remaining_ms > 0, remaining_ms)
    remaining_ms = effective_deadline - (time_now_monotonic_ms() - start_ms)
    rust_lane.spawn(rust_enabled, remaining_ms > 0, remaining_ms)
    val expected = hal_execution_expected_mask(operation, mode)
    while not _hal_all_terminal(expected, pure_lane, c_lane, rust_lane):
        pure_lane.advance_write()
        c_lane.advance_write()
        rust_lane.advance_write()
        pure_lane.advance_read(request.invocation_id)
        c_lane.advance_read(request.invocation_id)
        rust_lane.advance_read(request.invocation_id)
        pure_lane.close_after_result()
        c_lane.close_after_result()
        rust_lane.close_after_result()
        if time_now_monotonic_ms() - start_ms >= effective_deadline:
            if pure_enabled:
                pure_lane.cancel()
            if c_enabled:
                c_lane.cancel()
            if rust_enabled:
                rust_lane.cancel()
        elif not _hal_all_terminal(expected, pure_lane, c_lane, rust_lane):
            rt_sleep_ms(1)
    val comparison = hal_orchestrate_provider_receipts_v1(
        operation, request, mode,
        pure_lane.structural_lane(request.invocation_id),
        c_lane.structural_lane(request.invocation_id),
        rust_lane.structural_lane(request.invocation_id))
    val elapsed_ms = time_now_monotonic_ms() - start_ms
    HalProcessCoordinatorReceiptV1(
        comparison: comparison,
        launched_mask: _hal_mask_if(pure_lane.spawned, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.spawned, HalProviderKind.C)
            | _hal_mask_if(rust_lane.spawned, HalProviderKind.Rust),
        completed_mask: _hal_mask_if(pure_lane.result_valid, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.result_valid, HalProviderKind.C)
            | _hal_mask_if(rust_lane.result_valid, HalProviderKind.Rust),
        cancelled_mask: _hal_mask_if(pure_lane.cancelled, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.cancelled, HalProviderKind.C)
            | _hal_mask_if(rust_lane.cancelled, HalProviderKind.Rust),
        reaped_mask: _hal_mask_if(pure_lane.reaped, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.reaped, HalProviderKind.C)
            | _hal_mask_if(rust_lane.reaped, HalProviderKind.Rust),
        protocol_error_mask: _hal_mask_if(pure_lane.protocol_error, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.protocol_error, HalProviderKind.C)
            | _hal_mask_if(rust_lane.protocol_error, HalProviderKind.Rust),
        output_overflow_mask: _hal_mask_if(pure_lane.output_overflow, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.output_overflow, HalProviderKind.C)
            | _hal_mask_if(rust_lane.output_overflow, HalProviderKind.Rust),
        isolation_proven_mask: _hal_mask_if(
            pure_lane.isolation_valid, HalProviderKind.PureSimple)
            | _hal_mask_if(c_lane.isolation_valid, HalProviderKind.C)
            | _hal_mask_if(rust_lane.isolation_valid, HalProviderKind.Rust),
        critical_ready: false, elapsed_ms: elapsed_ms,
        cleanup_overran_deadline: elapsed_ms > effective_deadline)

