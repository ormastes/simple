# Host adapter: Electron-backend screenshot capture for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.electron_capture import below is legal here. Every symbol
# here is a stateless free function (no meaningful abstract port), so a
# facade re-export is the correct boundary, same as wave 1's stateless
# facades -- Electron process-driving is an inherent host precondition of
# this specific capture backend, not something the WM lane itself needs.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.compositor.electron_capture.{
    CaptureResult, capture_electron, capture_electron_scene, capture_error
}
