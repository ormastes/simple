# Host adapter: CUDA device-buffer measurement primitives for wm_compare's
# GPU backend evidence capture.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# gc_async_mut.cuda import below is legal here. cuda_available/
# cuda_memcpy_dtoh/CUDA_SUCCESS are stateless free functions/constants (no
# meaningful abstract port), so a facade re-export is the correct boundary,
# same as wave 1's stateless facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use std.gc_async_mut.cuda.{cuda_available, cuda_memcpy_dtoh, CUDA_SUCCESS}
