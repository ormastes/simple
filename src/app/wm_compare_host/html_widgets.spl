# Host adapter: HTML widget-tree renderer for wm_compare's GUI web-renderer
# parity harness.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# app.ui.render.html_widgets import below is legal here. render_html_tree is
# a pure function (WidgetNode + UIState -> text; no I/O, no mutable state),
# so a facade re-export is the correct boundary, same as wave 1's stateless
# facades -- it is an application-shell (`app.*`) dependency by construction,
# which is exactly the composition wm_compare's GUI parity harness is
# measuring, not a lint dodge.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use app.ui.render.html_widgets.{render_html_tree}
