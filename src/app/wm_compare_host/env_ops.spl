# Host adapter: environment-variable read + cwd for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# nogc_sync_mut.io.env_ops import below is legal here.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2).
#
# W2 wave 2: widened from {env_get} to also cover cwd (html_compat
# capture_and_compare.spl imported it via the app.io.env_ops compat facade,
# which is itself just `export use std.nogc_sync_mut.io.env_ops.*` --
# same upstream module env_get already comes from).

export use std.nogc_sync_mut.io.env_ops.{env_get, cwd}
