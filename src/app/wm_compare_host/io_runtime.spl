# Host adapter: generic file-read/write/args/env/process primitives for
# wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# nogc_sync_mut.io_runtime import below is legal here. wm_compare (a host-side
# measurement harness, not the portable WM/GUI/web/2D lane) imports this
# facade instead of touching nogc_sync_mut.io_runtime directly.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2).
#
# W2 wave 2: widened from {file_read, file_write, get_args} to also cover
# file_read_bytes/file_exists/env_get (html_compat capture_and_compare.spl)
# and process_run (live_capture.spl) -- same upstream module
# (nogc_sync_mut.io_runtime), same stateless-free-function shape as the
# existing three, so this is an extension of the wave-1 facade, not a new
# abstraction.

export use nogc_sync_mut.io_runtime.{
    file_read, file_write, get_args, file_read_bytes, file_exists, env_get, process_run
}
