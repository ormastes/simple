# Host adapter: stb-backed font rasterizer (C sffi) for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# nogc_sync_mut.sffi.spl_fonts import below is legal here.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2).
#
# vector_font_raster_feature_producer.spl compares the pure-Simple outline
# rasterizer against the stb C reference; the reference side is inherently a
# host binding, so it is routed through this facade like the other wm_compare
# host capabilities.

export use std.nogc_sync_mut.sffi.spl_fonts.{FontRasterizer}
