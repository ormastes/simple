# Host adapter: wall-clock read for wm_compare feature producers.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# nogc_async_mut.io.time_ops import below is legal here.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2).
#
# The *_feature_producer.spl files measure how long raster/feature production
# takes for evidence output -- a clock is genuinely needed and is deliberately
# excluded from the portable lane, so it is routed through this facade like
# the other wm_compare host capabilities.

export use std.nogc_async_mut.io.time_ops.{time_now_nanos}
