# Host adapter: browser-compositor backend constructor for wm_compare's
# browser-shell pixel path.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.browser_compositor_backend import below is legal here.
