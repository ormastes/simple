# Host adapter: CLI-args primitive for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# std.cli.cli_util import below is legal here — the `cli` root is a
# tooling-CLI host precondition the portable lane may never carry, but
# wm_compare (a host-side CLI harness) legitimately needs real argv.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2).

export use std.cli.cli_util.{get_cli_args}
