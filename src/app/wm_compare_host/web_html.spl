# Host adapter: CSS generation for wm_compare's window/taskbar widget-shells
# GUI parity harness.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# app.ui.web.html import below is legal here. generate_css is a pure function
# (theme name -> text; no I/O, no mutable state), so a facade re-export is
# the correct boundary, same as wave 1's stateless facades -- it is the
# application-shell (`app.*`) composition wm_compare's GUI parity harness is
# measuring, not a lint dodge.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use app.ui.web.html.{generate_css}
