# In-process visibility query adapters for the MCP tool path.
#
# tools.spl used to answer lsp_hover / lsp_completion / lsp_symbols by spawning
# `simple query_visibility.spl ...`. That child route is broken in production:
# find_simple_binary() prefers the pure-Simple release binary
# (bin/release/aarch64-apple-darwin-macho/simple), whose core-C standalone
# runtime cannot host script execution at all — its rt_cli_run_file stub prints
# "simple: --fork requires hosted interpreter support" and exits 1
# (src/runtime/runtime_native.c:720, SIMPLE_CORE_C_STANDALONE lane).
#
# Everything query_visibility.spl does for these three subcommands is pure
# text/file work built on the helpers in app.cli._QueryVisibility.query_commands,
# so the server builds the exact same JSON in-process. Same contract as
# lsp_query_inproc.spl: no caching, every call re-reads the source, and an
# unreadable/unacceptable file declines so the caller can fall back to the
# bounded child route (which preserves prior behavior for those cases).

use app.cli._QueryVisibility.query_commands.{extract_symbol_at, resolve_symbol_file,
    declaration_line, visibility_json, visibility_display, visibility_reachable,
    boundary_module, boundary_kind, exported_by, parse_symbols_in_file,
    parse_imported_modules, resolve_module_path, matching_keywords,
    symbol_range_json, symbol_kind_number, json_text, requester_file_part}
use app.cli.query_sanitize.{sanitize_path}
use std.nogc_sync_mut.io.file_ops.{file_read_text}
use .lsp_query_inproc.{LspQueryInprocResultV1}

fn _v_declined(reason: text) -> LspQueryInprocResultV1:
    LspQueryInprocResultV1(handled: false, text: "", code: 0, reason: reason)

fn _v_answer(text: text, code: i64) -> LspQueryInprocResultV1:
    LspQueryInprocResultV1(handled: true, text: text, code: code, reason: "")

fn lsp_visibility_inproc_readable_v1(file: text) -> bool:
    if file == "":
        return false
    val content = file_read_text(file) ?? ""
    content != ""

# `line_num` and `col` are 1-based, matching the one-shot CLI's arguments.
# `requester_spec` is `path[:line]` or ""; "" means no requester, exactly like
# the child's `--requester ""`.
fn lsp_visibility_hover_inproc_v1(file: text, line_num: i64, col: i64, requester_spec: text) -> LspQueryInprocResultV1:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        return _v_answer("null", 1)
    if not lsp_visibility_inproc_readable_v1(clean_file):
        return _v_declined("file_not_readable")
    val symbol = extract_symbol_at(file: clean_file, line_num: line_num, col: col)
    if symbol == "":
        return _v_answer("null", 1)
    val resolved = resolve_symbol_file(current_file: clean_file, symbol: symbol)
    val hover = declaration_line(symbol: symbol, owner_file: resolved)
    var requester = requester_spec
    if requester != "":
        requester = requester_file_part(requester)
    val vis = visibility_json(symbol: symbol, owner_file: resolved, requester_file: sanitize_path(requester))
    var lines: [text] = []
    if hover != "":
        lines = lines.push(hover)
    lines = lines.push("")
    lines = lines.push("Visibility: **" + visibility_display(symbol: symbol, owner_file: resolved) + "**")
    val boundary = boundary_module(owner_file: resolved)
    if boundary != "":
        lines = lines.push("Boundary: `" + boundary + "` (" + boundary_kind(owner_file: resolved) + ")")
    val exported = exported_by(symbol: symbol, owner_file: resolved)
    if exported != "":
        lines = lines.push("Exported by: `" + exported + "`")
    _v_answer("{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_text(lines.join("\n")) + "},\"simpleVisibility\":" + vis + "}", 0)

fn lsp_visibility_completions_inproc_v1(file: text, line_num: i64, col: i64) -> LspQueryInprocResultV1:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        return _v_answer("[]", 1)
    if not lsp_visibility_inproc_readable_v1(clean_file):
        return _v_declined("file_not_readable")
    var items: [text] = []
    val prefix = extract_symbol_at(file: clean_file, line_num: line_num, col: col)
    val local_symbols = parse_symbols_in_file(file_path: clean_file)
    for sym in local_symbols:
        if prefix != "" and not sym.name.starts_with(prefix):
            continue
        val vis = visibility_json(symbol: sym.name, owner_file: clean_file, requester_file: clean_file)
        if not visibility_reachable(symbol: sym.name, owner_file: clean_file, requester_file: clean_file):
            continue
        val detail = "[" + visibility_display(symbol: sym.name, owner_file: clean_file) + "] " + sym.kind
        items = items.push("{\"label\":" + json_text(sym.name) + ",\"kind\":6,\"detail\":" + json_text(detail) + ",\"data\":{\"simpleVisibility\":" + vis + "}" + "}")
    val imports = parse_imported_modules(file_path: clean_file)
    for module_path in imports:
        val imported_file = resolve_module_path(mod_path: module_path)
        if imported_file == "":
            continue
        val imported_symbols = parse_symbols_in_file(file_path: imported_file)
        for sym in imported_symbols:
            if prefix != "" and not sym.name.starts_with(prefix):
                continue
            if not visibility_reachable(symbol: sym.name, owner_file: imported_file, requester_file: clean_file):
                continue
            val vis = visibility_json(symbol: sym.name, owner_file: imported_file, requester_file: clean_file)
            val detail = "[" + visibility_display(symbol: sym.name, owner_file: imported_file) + "] " + sym.kind
            items = items.push("{\"label\":" + json_text(sym.name) + ",\"kind\":6,\"detail\":" + json_text(detail) + ",\"data\":{\"simpleVisibility\":" + vis + "}" + "}")
    val keywords = matching_keywords(prefix)
    for kw in keywords:
        items = items.push("{\"label\":" + json_text(kw) + ",\"kind\":14,\"detail\":\"[public]\",\"data\":{\"simpleVisibility\":{\"display\":\"public\",\"reachable\":true,\"boundaryKind\":\"open\"}" + "}" + "}")
    _v_answer("[" + items.join(",") + "]", 0)

fn lsp_visibility_symbols_inproc_v1(file: text, requester_spec: text) -> LspQueryInprocResultV1:
    val clean_file = sanitize_path(file)
    if clean_file == "":
        return _v_answer("[]", 1)
    if not lsp_visibility_inproc_readable_v1(clean_file):
        return _v_declined("file_not_readable")
    var requester = ""
    if requester_spec != "":
        requester = sanitize_path(requester_file_part(requester_spec))
    var items: [text] = []
    val symbols = parse_symbols_in_file(file_path: clean_file)
    for parsed in symbols:
        val vis = visibility_json(symbol: parsed.name, owner_file: clean_file, requester_file: requester)
        val range = symbol_range_json(parsed)
        items = items.push("{\"name\":" + json_text(parsed.name) + ",\"kind\":" + str(symbol_kind_number(parsed.kind)) + ",\"detail\":" + json_text("[" + visibility_display(symbol: parsed.name, owner_file: clean_file) + "]") + ",\"range\":" + range + ",\"selectionRange\":" + range + ",\"simpleVisibility\":" + vis + "}")
    _v_answer("[" + items.join(",") + "]", 0)

export lsp_visibility_hover_inproc_v1, lsp_visibility_completions_inproc_v1, lsp_visibility_symbols_inproc_v1
export lsp_visibility_inproc_readable_v1
