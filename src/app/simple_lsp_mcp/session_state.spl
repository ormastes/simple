# Simple LSP MCP - per-server-session editor location
#
# The requester default for visibility queries is the LAST location the editor
# asked about through a position tool (lsp_hover / lsp_definition / ... carry
# file+line — "where the editor is"). File-only tools (lsp_symbols,
# lsp_visibility) never update it, so querying a file twice cannot make it its
# own requester. In-process only: never sourced from the cross-process
# /tmp editor-state file. Mutated only through the accessors in this module.

var _LSP_LAST_FILE: text = ""
var _LSP_LAST_LINE: i64 = 0

fn lsp_record_location(file: text, line0: i64):
    if file == "":
        return
    _LSP_LAST_FILE = file
    _LSP_LAST_LINE = if line0 >= 0: line0 + 1 else: 0

fn lsp_last_location() -> text:
    if _LSP_LAST_FILE == "":
        return ""
    if _LSP_LAST_LINE > 0:
        return _LSP_LAST_FILE + ":" + str(_LSP_LAST_LINE)
    _LSP_LAST_FILE

fn lsp_reset_location():
    _LSP_LAST_FILE = ""
    _LSP_LAST_LINE = 0

# (spec, source): explicit > last position-tool location > "" with source "none".
fn lsp_resolve_requester(explicit: text) -> (text, text):
    if explicit != "":
        return (explicit, "explicit")
    val last = lsp_last_location()
    if last != "":
        return (last, "last_read")
    ("", "none")

export lsp_record_location
export lsp_last_location
export lsp_reset_location
export lsp_resolve_requester
