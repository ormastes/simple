# Process-start accounting for the LSP MCP tool path.
#
# The defect this lane repairs is that every semantic query started a `simple`
# child. A counter is the only way a spec can PROVE the repair rather than
# assert it: `run_command_text` — the single bounded command owner in
# `tools.spl` — bumps this counter once per child, so a spec can run N queries
# and require the count to stay at zero.
#
# It is diagnostic only: nothing reads it to make a decision, and it never
# reaches MCP protocol stdout.

var _LSP_COMMAND_STARTS: i64 = 0

fn lsp_note_command_start():
    _LSP_COMMAND_STARTS = _LSP_COMMAND_STARTS + 1

fn lsp_command_starts_total() -> i64:
    _LSP_COMMAND_STARTS

fn lsp_reset_command_starts():
    _LSP_COMMAND_STARTS = 0

export lsp_note_command_start, lsp_command_starts_total, lsp_reset_command_starts
