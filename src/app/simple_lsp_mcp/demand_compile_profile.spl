use lib.compiler_artifact_service.profile.{
    ArtifactServiceProfileV1, artifact_service_profile_v1
}
use compiler.driver.action_graph.artifact_service_bridge.{
    DemandArtifactRouteV1, demand_artifact_route_v1
}
use compiler.driver.action_graph.demand_compile_integration.{DemandCompileExecutionV1}

fn lsp_demand_compile_profile_v1(compatibility_id: text) -> ArtifactServiceProfileV1:
    artifact_service_profile_v1(
        "lsp",
        compatibility_id,
        ["io", "parse", "semantic"],
        1000,
        true)

fn lsp_demand_compile_route_v1(
    execution: DemandCompileExecutionV1, compatibility_id: text,
    daemon_available: bool, owner_id: text, lease_generation: i64
) -> DemandArtifactRouteV1:
    demand_artifact_route_v1(
        execution, lsp_demand_compile_profile_v1(compatibility_id),
        daemon_available, owner_id, lease_generation)

export lsp_demand_compile_profile_v1, lsp_demand_compile_route_v1
