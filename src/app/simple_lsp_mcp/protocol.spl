# Simple LSP MCP Protocol - initialize, tools list, schemas
#
# Uses shared mcp_sdk for JSON building and JSON-RPC framing.

use .json_helpers.{LB, RB, Q, SB_L, SB_R, jp, js, jo1, jo2, jo3, escape_json, jsonrpc_result}

# NOTE: These caches used to live in main.spl but cross-module var
# references don't resolve correctly in native builds - the reference
# to main.spl's INIT_CACHE from protocol.spl was reading nil. Moving
# the caches into this module fixes it.
var _PROTOCOL_INIT_CACHE = ""
var _PROTOCOL_TOOLS_CACHE = ""
val _PROTOCOL_SERVER_NAME = "simple-lsp-mcp"
val _PROTOCOL_SERVER_VERSION = "0.9.8"

fn make_init_response(id: text) -> text:
    if _PROTOCOL_INIT_CACHE != "":
        return jsonrpc_result(id, _PROTOCOL_INIT_CACHE)

    val tools_cap = jo1(jp("listChanged", "false"))
    val resources_cap = jo1(jp("listChanged", "false"))
    val prompts_cap = jo1(jp("listChanged", "false"))
    val roots_cap = jo1(jp("listChanged", "false"))

    var caps = LB()
    caps = caps + jp("tools", tools_cap)
    caps = caps + "," + jp("resources", resources_cap)
    caps = caps + "," + jp("prompts", prompts_cap)
    caps = caps + "," + jp("logging", LB() + RB())
    caps = caps + "," + jp("roots", roots_cap)
    caps = caps + RB()

    val server_info = jo2(
        jp("name", js(_PROTOCOL_SERVER_NAME)),
        jp("version", js(_PROTOCOL_SERVER_VERSION))
    )

    var result = LB()
    result = result + jp("protocolVersion", js("2025-06-18"))
    result = result + "," + jp("capabilities", caps)
    result = result + "," + jp("instructions", js("Simple LSP MCP - backed by lsp_query.spl and simple check. Provides 13 LSP tools."))
    result = result + "," + jp("serverInfo", server_info)
    result = result + RB()

    _PROTOCOL_INIT_CACHE = result
    return jsonrpc_result(id, result)

fn make_tools_list(id: text) -> text:
    if _PROTOCOL_TOOLS_CACHE != "":
        return jsonrpc_result(id, _PROTOCOL_TOOLS_CACHE)

    var tools = SB_L()
    tools = tools + make_tool_schema("lsp_definition", "Find where a symbol is defined in a Simple source file.")
    tools = tools + "," + make_tool_schema("lsp_references", "Find symbol references in Simple source.")
    tools = tools + "," + make_tool_schema("lsp_hover", "Get hover information for a symbol in Simple source.")
    tools = tools + "," + make_tool_schema("lsp_symbols", "List symbols in a Simple source file.")
    tools = tools + "," + make_tool_schema("lsp_diagnostics", "Run lightweight diagnostics via simple check.")
    tools = tools + "," + make_tool_schema("lsp_completion", "Get code completions at a position in a Simple source file.")
    tools = tools + "," + make_tool_schema("lsp_type_at", "Get the inferred type of a symbol at a position.")
    tools = tools + "," + make_tool_schema("lsp_signature_help", "Get function signature information at a call site.")
    tools = tools + "," + make_tool_schema("lsp_implementation", "Go to implementation of a trait or interface.")
    tools = tools + "," + make_tool_schema("lsp_document_highlight", "Highlight all occurrences of a symbol in the same file.")
    tools = tools + "," + make_tool_schema("lsp_type_definition", "Navigate to the type definition of a symbol.")
    tools = tools + "," + make_tool_schema("lsp_incoming_calls", "Callers of the function at a position, with resolution labels.")
    tools = tools + "," + make_tool_schema("lsp_outgoing_calls", "Callees of the function at a position, with resolution labels.")
    tools = tools + "," + make_tool_schema("explain_diagnostic", "Explain a diagnostic with rule rationale, symbolic cost evidence, assumptions, and fix candidates.")
    tools = tools + "," + make_tool_schema("get_cost_summary", "Get the parameterized symbolic cost summary and input sizes for a symbol and semantic revision.")
    tools = tools + "," + make_tool_schema("get_cost_contributions", "Get the caller-to-callee cost provenance chain (C07) for a symbol and semantic revision.")
    tools = tools + "," + make_tool_schema("list_fix_candidates", "List ranked fix candidates (including disabled Unavailable PERF-FIX-001 entries) for a diagnostic or file.")
    tools = tools + "," + make_tool_schema("resolve_fix", "Revalidate document revision (I01) and semantic_fingerprint (I02) to resolve an edit plan without modifying source.")
    tools = tools + "," + make_tool_schema("preview_fix", "Preview minimal unified diff, cost delta claim, obligations, and resource tradeoff without modifying source.")
    tools = tools + "," + make_tool_schema("apply_fix", "Apply a VerifiedSafe fix (or authorized ReviewRequired fix) to a matching revisioned snapshot and return change_id.")
    tools = tools + "," + make_tool_schema("validate_fix", "Validate post-apply snapshot hash, obligations, and semantic_fingerprint currency for a change_id.")
    tools = tools + SB_R()
    val result = jo1(jp("tools", tools))
    _PROTOCOL_TOOLS_CACHE = result
    return jsonrpc_result(id, result)

fn make_tool_schema(name: text, description: text) -> text:
    var props = LB() + RB()
    var req = "[]"

    if name == "lsp_symbols":
        props = jo1(jp("file", jo2(jp("type", js("string")), jp("description", js("Path to the source file")))))
        req = SB_L() + js("file") + SB_R()
    elif name == "lsp_diagnostics":
        var dp = LB()
        dp = dp + jp("file", jo2(jp("type", js("string")), jp("description", js("Path to the source file"))))
        dp = dp + "," + jp("format", jo3(
            jp("type", js("string")),
            jp("enum", SB_L() + js("text") + "," + js("structured") + SB_R()),
            jp("description", js("Diagnostics output format: structured JSON envelope or text with explicit completeness status"))
        ))
        dp = dp + "," + jp("include_fixes", jo2(jp("type", js("boolean")), jp("description", js("Include preconditioned ranked fix candidates"))))
        dp = dp + "," + jp("task_handle", jo2(jp("type", js("string")), jp("description", js("Optional task handle from a timed_out or incomplete diagnostics response"))))
        dp = dp + "," + jp("operation", jo2(jp("type", js("string")), jp("description", js("Optional perf agent operation: explain_diagnostic, get_cost_summary, get_cost_contributions, list_fix_candidates, resolve_fix, preview_fix, apply_fix, validate_fix"))))
        dp = dp + RB()
        props = dp
        req = SB_L() + SB_R()
    elif name == "explain_diagnostic":
        props = jo1(jp("diagnostic_id", jo2(jp("type", js("string")), jp("description", js("Stable diagnostic ID or PERF-* rule code")))))
        req = SB_L() + js("diagnostic_id") + SB_R()
    elif name == "get_cost_summary" or name == "get_cost_contributions":
        props = jo2(
            jp("symbol", jo2(jp("type", js("string")), jp("description", js("Function or symbol identifier")))),
            jp("revision", jo2(jp("type", js("string")), jp("description", js("Optional semantic revision or snapshot hash"))))
        )
        req = SB_L() + js("symbol") + SB_R()
    elif name == "list_fix_candidates":
        props = jo2(
            jp("diagnostic_or_range", jo2(jp("type", js("string")), jp("description", js("Diagnostic ID, rule code, or file path")))),
            jp("file", jo2(jp("type", js("string")), jp("description", js("Optional fallback file path"))))
        )
        req = SB_L() + SB_R()
    elif name == "resolve_fix":
        props = jo2(
            jp("action_id", jo2(jp("type", js("string")), jp("description", js("Stable fix candidate action ID")))),
            jp("expected_revision", jo2(jp("type", js("string")), jp("description", js("Expected snapshot hash or document version"))))
        )
        req = SB_L() + js("action_id") + SB_R()
    elif name == "preview_fix":
        props = jo1(jp("action_id", jo2(jp("type", js("string")), jp("description", js("Stable fix candidate action ID")))))
        req = SB_L() + js("action_id") + SB_R()
    elif name == "apply_fix":
        props = jo3(
            jp("action_id", jo2(jp("type", js("string")), jp("description", js("Stable fix candidate action ID")))),
            jp("expected_revision", jo2(jp("type", js("string")), jp("description", js("Expected snapshot hash or document version")))),
            jp("allow_review_required", jo2(jp("type", js("boolean")), jp("description", js("Explicitly authorize applying a ReviewRequired change"))))
        )
        req = SB_L() + js("action_id") + SB_R()
    elif name == "validate_fix":
        props = jo1(jp("change_id", jo2(jp("type", js("string")), jp("description", js("Change receipt ID returned by apply_fix")))))
        req = SB_L() + js("change_id") + SB_R()
    else:
        # All position-based tools: definition, references, hover, completion, type_at, signature_help, implementation, document_highlight, type_definition
        var p = LB()
        p = p + jp("file", jo2(jp("type", js("string")), jp("description", js("Path to the source file"))))
        p = p + "," + jp("line", jo2(jp("type", js("integer")), jp("description", js("0-indexed line number"))))
        p = p + "," + jp("character", jo2(jp("type", js("integer")), jp("description", js("0-indexed character offset"))))
        p = p + RB()
        props = p
        req = SB_L() + js("file") + "," + js("line") + "," + js("character") + SB_R()

    var schema = LB()
    schema = schema + jp("type", js("object"))
    schema = schema + "," + jp("properties", props)
    schema = schema + "," + jp("required", req)
    schema = schema + RB()

    val is_mutating = name == "apply_fix"
    var annotations = LB()
    annotations = annotations + jp("readOnlyHint", if is_mutating: "false" else: "true")
    annotations = annotations + "," + jp("destructiveHint", "false")
    annotations = annotations + "," + jp("idempotentHint", if is_mutating: "false" else: "true")
    annotations = annotations + "," + jp("openWorldHint", "false")
    annotations = annotations + RB()

    var tool_obj = LB()
    tool_obj = tool_obj + jp("name", js(name))
    tool_obj = tool_obj + "," + jp("description", js(description))
    tool_obj = tool_obj + "," + jp("inputSchema", schema)
    tool_obj = tool_obj + "," + jp("annotations", annotations)
    tool_obj = tool_obj + RB()
    tool_obj

export make_init_response, make_tools_list, make_tool_schema
