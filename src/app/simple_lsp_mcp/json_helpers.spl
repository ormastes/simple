# Simple LSP MCP Server - JSON, protocol, and transport helpers
#
# Inlined implementations that work in interpreter mode.
# The std.mcp_sdk.* imports hang in interpreter mode because the
# std/common/lib module loader blocks on stdin during resolution.
# This file provides equivalent functions using only inline code
# and extern fn declarations.

use app.io.minimal_runtime_ops.{env_get, file_exists, process_run}
use app.protocol.framing.{frame_strip_line_end, frame_parse_decimal, frame_line_is_jsonl_payload}

extern fn stdin_read_char() -> text
use std.nogc_sync_mut.sffi.diag.{stdout_flush as sosix_stdout_flush}
use std.nogc_sync_mut.sffi.fs.{io_file_write_all}
use std.nogc_sync_mut.io.external_text_io.{io_text_encode, io_text_error_message}
use std.common.encoding.external_text.{utf8_format}
use std.nogc_async_mut.sosix.text_boundary.{sosix_text_check_size}

# MCP stdout is a byte-framed transport, including on Windows. The ordinary
# SOSIX console provider rejects Windows; the checked descriptor-write owner
# already supports its binary CRT descriptors without charset inference.
fn print_raw(value: text):
    match sosix_text_check_size(value):
        case Err(error): panic(io_text_error_message(error))
        case Ok(_): ()
    val bytes = match io_text_encode(value, utf8_format()):
        case Ok(encoded): encoded
        case Err(error): panic(io_text_error_message(error))
    if not io_file_write_all(1, bytes):
        panic("LSP MCP stdout transport write failed; output may be partial")

# --- JSON building helpers ---

fn Q() -> text:
    "\""

fn LB() -> text:
    "{"

fn RB() -> text:
    "}"

fn SB_L() -> text:
    "["

fn SB_R() -> text:
    "]"

val _JSON_HEX_DIGITS = "0123456789abcdef"

fn _escape_json_ctrl(code: i64) -> text:
    if code == 8:
        return "\\b"
    if code == 9:
        return "\\t"
    if code == 10:
        return "\\n"
    if code == 12:
        return "\\f"
    if code == 13:
        return "\\r"
    val hi = code / 16
    val lo = code % 16
    "\\u00" + _JSON_HEX_DIGITS.substring(hi, hi + 1) + _JSON_HEX_DIGITS.substring(lo, lo + 1)

fn escape_json(s: text) -> text:
    val n = s.byte_len()
    var i = 0
    while i < n:
        val b = s.byte_at(i) as i64
        if b < 32 or b == 34 or b == 92:
            break
        i = i + 1
    if i == n:
        return s
    var parts: [text] = []
    if i > 0:
        parts.push(s.substring(0, i))
    var span_start = i
    while i < n:
        val b = s.byte_at(i) as i64
        if b < 32 or b == 34 or b == 92:
            if i > span_start:
                parts.push(s.substring(span_start, i))
            if b == 34:
                parts.push("\\\"")
            elif b == 92:
                parts.push("\\\\")
            else:
                parts.push(_escape_json_ctrl(b))
            span_start = i + 1
        i = i + 1
    if span_start < n:
        parts.push(s.substring(span_start, n))
    parts.join("")

fn js(value: text) -> text:
    Q() + escape_json(value) + Q()

fn jp(key: text, value: text) -> text:
    Q() + key + Q() + ":" + value

fn jo1(p1: text) -> text:
    LB() + p1 + RB()

fn jo2(p1: text, p2: text) -> text:
    LB() + p1 + "," + p2 + RB()

fn jo3(p1: text, p2: text, p3: text) -> text:
    LB() + p1 + "," + p2 + "," + p3 + RB()

# --- JSON parsing helpers ---
#
# NOTE: These helpers use manual character scanning rather than
# `text.index_of()` + `match Some(i)`. There is a Cranelift codegen
# bug where `match idx_opt: Some(i): ... nil: ...` on the result of
# `index_of()` segfaults at runtime in native binaries. The manual
# scanner pattern below is the same one used successfully in
# examples/10_tooling/trace32_tools/t32_mcp/frontend_cold.spl.
# Do NOT re-introduce `match Some(i)` on `index_of` results here.

fn _slice_text(s: text, start: i64, end: i64) -> text:
    var out = ""
    var i = 0
    for ch in s:
        if i >= end:
            break
        if i >= start:
            out = out + ch
        i = i + 1
    out

fn _char_len(s: text) -> i64:
    # CHAR count (text.len() counts bytes); pairs with the char-indexed _slice_text.
    var n = 0
    for _ch in s:
        n = n + 1
    n

fn _char_at(s: text, i: i64) -> text:
    _slice_text(s, i, i + 1)

fn _is_ws(ch: text) -> bool:
    ch == " " or ch == "\n" or ch == "\r" or ch == "\t"

# Char-array view helpers retained for unit specs and callers that test them.
fn _json_chars(s: text) -> [text]:
    var out: [text] = []
    for ch in s:
        out.push(ch)
    out

# Same result as `_slice_text(s, start, end)` for the text `chars` was built from.
fn _json_chars_join(chars: [text], start: i64, end: i64) -> text:
    var parts: [text] = []
    var i = start
    while i < end and i < chars.len():
        if i >= 0:
            parts.push(chars[i])
        i = i + 1
    parts.join("")

fn _find_json_value_start_chars(chars: [text], key: text) -> i64:
    val search = _json_chars(Q() + key + Q())
    val search_n = search.len()
    val json_n = chars.len()
    var offset = 0
    while offset + search_n <= json_n:
        var matched = true
        var k = 0
        while k < search_n:
            if chars[offset + k] != search[k]:
                matched = false
                break
            k = k + 1
        if not matched:
            offset = offset + 1
            continue
        var value_start = offset + search_n
        while value_start < json_n and _is_ws(chars[value_start]):
            value_start = value_start + 1
        if value_start < json_n and chars[value_start] == ":":
            value_start = value_start + 1
            while value_start < json_n and _is_ws(chars[value_start]):
                value_start = value_start + 1
            return value_start
        offset = offset + search_n
    return -1

fn _is_ws_byte(b: i64) -> bool:
    b == 32 or b == 10 or b == 13 or b == 9

fn _skip_json_string_bytes(json: text, open_quote_idx: i64, json_n: i64) -> i64:
    var i = open_quote_idx + 1
    var escaped = false
    while i < json_n:
        val b = json.byte_at(i) as i64
        if escaped:
            escaped = false
        elif b == 92:
            escaped = true
        elif b == 34:
            return i + 1
        i = i + 1
    json_n

fn _scan_json_container_end(json: text, start: i64, open_b: i64, close_b: i64, json_n: i64) -> i64:
    var depth = 1
    var i = start + 1
    while i < json_n:
        val b = json.byte_at(i) as i64
        if b == 34:
            i = _skip_json_string_bytes(json, i, json_n)
            continue
        elif b == open_b:
            depth = depth + 1
        elif b == close_b:
            depth = depth - 1
            if depth == 0:
                return i + 1
        i = i + 1
    -1

fn _find_json_value_start(json: text, key: text) -> i64:
    val key_n = key.byte_len()
    val json_n = json.byte_len()
    var i = 0
    while i < json_n:
        val b = json.byte_at(i) as i64
        if b == 34:
            val end_q = _skip_json_string_bytes(json, i, json_n)
            var is_key_match = false
            if end_q <= json_n and end_q - i - 2 == key_n:
                var k = 0
                is_key_match = true
                while k < key_n:
                    if (json.byte_at(i + 1 + k) as i64) != (key.byte_at(k) as i64):
                        is_key_match = false
                        break
                    k = k + 1
            if is_key_match:
                var value_start = end_q
                while value_start < json_n and _is_ws_byte(json.byte_at(value_start) as i64):
                    value_start = value_start + 1
                if value_start < json_n and (json.byte_at(value_start) as i64) == 58:
                    value_start = value_start + 1
                    while value_start < json_n and _is_ws_byte(json.byte_at(value_start) as i64):
                        value_start = value_start + 1
                    return value_start
            i = end_q
            continue
        i = i + 1
    -1

fn extract_field(json: text, key: text) -> text:
    val json_n = json.byte_len()
    val start = _find_json_value_start(json, key)
    if start < 0 or start >= json_n:
        return ""
    val first = json.byte_at(start) as i64
    if first == 34:
        val end_q = _skip_json_string_bytes(json, start, json_n)
        if end_q <= json_n and end_q - 1 > start and (json.byte_at(end_q - 1) as i64) == 34:
            return json.substring(start + 1, end_q - 1)
        return ""
    elif first == 123:
        val end_obj = _scan_json_container_end(json, start, 123, 125, json_n)
        if end_obj > start:
            return json.substring(start, end_obj)
        return ""
    elif first == 91:
        val end_arr = _scan_json_container_end(json, start, 91, 93, json_n)
        if end_arr > start:
            return json.substring(start, end_arr)
        return ""
    var end = start
    while end < json_n:
        val b = json.byte_at(end) as i64
        if b == 44 or b == 125 or b == 93 or _is_ws_byte(b):
            break
        end = end + 1
    json.substring(start, end)

fn extract_id(json: text) -> text:
    val json_n = json.byte_len()
    val start = _find_json_value_start(json, "id")
    if start < 0 or start >= json_n:
        return "null"
    val first = json.byte_at(start) as i64
    if first == 34:
        val end_q = _skip_json_string_bytes(json, start, json_n)
        if end_q <= json_n and end_q - 1 > start and (json.byte_at(end_q - 1) as i64) == 34:
            return json.substring(start, end_q)
        return "null"
    var end = start
    while end < json_n:
        val b = json.byte_at(end) as i64
        if b == 44 or b == 125 or b == 93 or _is_ws_byte(b):
            break
        end = end + 1
    val raw = json.substring(start, end)
    if raw == "":
        return "null"
    raw

# --- JSON-RPC builders ---

fn jsonrpc_result(id: text, result: text) -> text:
    jo3(
        p1: jp(key: "jsonrpc", value: js("2.0")),
        p2: jp(key: "id", value: id),
        p3: jp(key: "result", value: result)
    )

fn jsonrpc_error(id: text, code: i64, message: text) -> text:
    val err = jo2(
        p1: jp(key: "code", value: code.to_string()),
        p2: jp(key: "message", value: js(message))
    )
    jo3(
        p1: jp(key: "jsonrpc", value: js("2.0")),
        p2: jp(key: "id", value: id),
        p3: jp(key: "error", value: err)
    )

# --- Tool result helpers ---

fn make_tool_result(id: text, content: text) -> text:
    val text_obj = jo2(
        p1: jp(key: "type", value: js("text")),
        p2: jp(key: "text", value: js(content))
    )
    val result = jo1(jp(key: "content", value: "[" + text_obj + "]"))
    jo3(
        p1: jp(key: "jsonrpc", value: js("2.0")),
        p2: jp(key: "id", value: id),
        p3: jp(key: "result", value: result)
    )

fn make_tool_error(id: text, message: text) -> text:
    val text_obj = jo2(
        p1: jp(key: "type", value: js("text")),
        p2: jp(key: "text", value: js(message))
    )
    var result = LB()
    result = result + jp(key: "content", value: "[" + text_obj + "]")
    result = result + "," + jp(key: "isError", value: "true")
    result = result + RB()
    jo3(
        p1: jp(key: "jsonrpc", value: js("2.0")),
        p2: jp(key: "id", value: id),
        p3: jp(key: "result", value: result)
    )

# --- Method detection ---

fn has_method(msg: text, name: text) -> bool:
    msg.contains(Q() + "method" + Q() + ":" + Q() + name + Q()) or msg.contains(Q() + "method" + Q() + ": " + Q() + name + Q())

# --- Shell helpers ---

fn lsp_query_path() -> text:
    "src/app/lsp/lsp_query.spl"

fn query_visibility_path() -> text:
    "src/app/cli/query_visibility.spl"

fn saml_cli_path() -> text:
    "src/app/saml/main.spl"

fn find_simple_binary() -> text:
    val env_val = env_get("SIMPLE_BINARY") ?? ""
    if env_val != "":
        return env_val
    # Repo-root discovery must not depend on the caller's cwd: when the server
    # runs with SIMPLE_LIB set (conventionally <repo>/src), derive the repo
    # binary from it before falling back to cwd-relative probes.
    val lib_dir = env_get("SIMPLE_LIB") ?? ""
    val os_env = env_get("OS") ?? ""
    if lib_dir != "":
        val repo_bin = lib_dir.substring(0, lib_dir.byte_len() - 4) + "/bin/simple"
        if file_exists(repo_bin):
            return repo_bin
        # Windows only: bin/simple.exe is TRACKED, so on POSIX it always exists
        # and exec'ing the PE file fails every tool call with EACCES.
        if os_env.contains("Windows") and file_exists(repo_bin + ".exe"):
            return repo_bin + ".exe"
    if os_env.contains("Windows"):
        if file_exists("bin/simple.exe"):
            return "bin/simple.exe"
        if file_exists("bin/release/x86_64-pc-windows-msvc/simple.exe"):
            return "bin/release/x86_64-pc-windows-msvc/simple.exe"
        if file_exists("bin/release/x86_64-pc-windows-gnu/simple.exe"):
            return "bin/release/x86_64-pc-windows-gnu/simple.exe"
        return "bin/simple.exe"
    if file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if file_exists("bin/release/x86_64-unknown-linux-gnu/simple"):
        return "bin/release/x86_64-unknown-linux-gnu/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    if file_exists("bin/release/simple"):
        return "bin/release/simple"
    if file_exists("bin/simple"):
        return "bin/simple"
    "bin/simple"

fn strip_ansi(s: text) -> text:
    val n = s.byte_len()
    var i = 0
    while i < n:
        if (s.byte_at(i) as i64) == 27:
            break
        i = i + 1
    if i == n:
        return s
    var parts: [text] = []
    if i > 0:
        parts.push(s.substring(0, i))
    var span_start = i
    var in_escape = false
    while i < n:
        val b = s.byte_at(i) as i64
        if in_escape:
            if b == 109:
                in_escape = false
                span_start = i + 1
        elif b == 27:
            if i > span_start:
                parts.push(s.substring(span_start, i))
            in_escape = true
        i = i + 1
    if not in_escape and span_start < n:
        parts.push(s.substring(span_start, n))
    parts.join("")

# Drop trailing newlines by byte (`\n` = 10 never occurs in a multibyte UTF-8
# sequence). Keeps index units consistent on both interpreter and compiled paths.
fn _trim_trailing_newlines(s: text) -> text:
    var end = s.byte_len()
    while end > 0 and (s.byte_at(end - 1) as i64) == 10:
        end = end - 1
    if end == s.byte_len():
        return s
    s.substring(0, end)

fn clean_command_output(stdout: text) -> text:
    val lines = stdout.split("\n")
    var kept: [text] = []
    var i = 0
    while i < lines.len():
        if not lines[i].starts_with("[DEBUG] "):
            kept.push(lines[i])
        i = i + 1
    _trim_trailing_newlines(kept.join("\n"))

# NOTE: no run_command_text here. tools.spl owns the bounded implementation
# (process_run_bounded); an earlier unbounded twin in this file violated the
# bounded command-owner contract (REQ-SSPEC-APP) and nothing imported it.


# --- Stdio transport ---

# Protocol auto-detection. Use a text sentinel rather than bool here because
# this path is exercised by native package binaries and must stay stable.
var _TRANSPORT_MODE = "framed"

fn _read_line() -> text:
    var parts: [text] = []
    while true:
        val ch = stdin_read_char()
        if ch.byte_len() == 0:
            if parts.len() == 0:
                return ""
            return parts.join("")
        parts.push(ch)
        if ch.starts_with("\n"):
            return parts.join("")

fn _read_chars(count: i64) -> text:
    var parts: [text] = []
    var i = 0
    while i < count:
        val ch = stdin_read_char()
        if ch.byte_len() == 0:
            break
        parts.push(ch)
        i = i + 1
    parts.join("")

# Delegates to the canonical framing primitives in app.protocol.framing.
# Behaviour is fixed by test/01_unit/app/protocol/jsonrpc_framing_spec.spl.
fn _strip_line_end(line: text) -> text:
    frame_strip_line_end(line)

fn _parse_decimal_raw(s: text) -> i64:
    frame_parse_decimal(s)

fn read_stdin_message() -> text:
    var content_length = 0
    while true:
        val raw_line = _read_line()
        if raw_line.len() == 0:
            return ""
        val line = _strip_line_end(raw_line)
        if line.trim().len() == 0:
            if content_length > 0:
                break
            continue
        if frame_line_is_jsonl_payload(line):
            _TRANSPORT_MODE = "jsonl"
            return line
        if line.starts_with("Content-Length:"):
            val len_str = line.replace("Content-Length:", "").trim()
            content_length = _parse_decimal_raw(len_str)
    _TRANSPORT_MODE = "framed"
    _read_chars(content_length)

# Content-Length framing header for a stdio (Content-Length framed) message
# body. The count MUST be the UTF-8 byte length: JSON bodies carrying
# multibyte text (tool lists, hover markdown) otherwise arrive truncated for
# standard MCP clients, which desync the stream (diagnosed 2026-11-16: char
# count under-counted 4 bytes and cut the body tail off `tools/list`).
pub fn content_length_header(body: text) -> text:
    val nl = "\n"
    "Content-Length: " + str(body.byte_len()) + "\r" + nl + "\r" + nl

fn write_stdout_message(body: text):
    if _TRANSPORT_MODE.len() == 5 and _TRANSPORT_MODE.starts_with("jsonl"):
        print_raw(body + "\n")
        sosix_stdout_flush()
        return
    print_raw(content_length_header(body))
    print_raw(body)
    sosix_stdout_flush()
