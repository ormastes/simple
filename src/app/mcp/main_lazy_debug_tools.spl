# MCP Debug Tool Handlers — DAP bridge admission boundary
#
# Session registration and bootstrap plans do not prove target attachment.
# Until a DebugWire response is available, target operations fail explicitly
# with central-service policy/outcome receipts and never fabricate observations.

use .dap_bridge.{DapSession, dap_create_session, dap_list_sessions, dap_close_session, dap_find_session}
use .main_lazy_json.{LB, RB, SB_L, SB_R, extract_field, jo2, jp, js, make_tool_error, make_tool_result, make_tool_result_status}
use std.io_runtime.{file_read}
use std.common.debug.contracts_v1.{DebugSessionId, DebugRootOperationV1, DebugPerturbationV1}
use std.common.debug.service_v1.{central_debug_service_v1_authorize, central_debug_service_v1_record_outcome}

val _DEBUG_NL = "\n"

fn bool_text(v: bool) -> text:
    if v:
        return "true"
    "false"

fn _debug_to_int_or(s: text, default_val: i64) -> i64:
    val t = s.trim()
    if t == "":
        return default_val
    var i = 0
    for ch in t:
        if ch >= "0" and ch <= "9":
            i = i + 1
            continue
        if i == 0 and ch == "-":
            i = i + 1
            continue
        return default_val
    if t == "-":
        return default_val
    int(t)

fn _json_text_array(values: [text]) -> text:
    var arr = SB_L()
    var first = true
    for value in values:
        if not first:
            arr = arr + ","
        first = false
        arr = arr + js(value)
    arr = arr + SB_R()
    arr

fn _session_json(session: DapSession) -> text:
    var obj = LB()
    obj = obj + jp("session_id", js(session.id))
    obj = obj + "," + jp("debug_session_id", js(session.debug_session_id))
    obj = obj + "," + jp("build_id", js(session.build_id))
    obj = obj + "," + jp("program", js(session.program))
    obj = obj + "," + jp("target_type", js(session.target_type))
    obj = obj + "," + jp("state", js(session.state))
    obj = obj + "," + jp("target_verification", js("unverified"))
    obj = obj + "," + jp("target_operations_available", "false")
    obj = obj + "," + jp("arch", js(session.arch))
    obj = obj + "," + jp("exec_mode", js(session.exec_mode))
    obj = obj + "," + jp("vendor", js(session.vendor))
    obj = obj + "," + jp("probe_kind", js(session.probe_kind))
    obj = obj + "," + jp("server_kind", js(session.server_kind))
    obj = obj + "," + jp("transport", js(session.transport))
    obj = obj + "," + jp("backend_id", js(session.backend_id))
    obj = obj + "," + jp("attach_semantics", js(session.attach_semantics))
    obj = obj + "," + jp("persistent_session", bool_text(session.persistent_session))
    obj = obj + "," + jp("capabilities", _json_text_array(session.capabilities))
    obj = obj + "," + jp("host", js(session.host))
    obj = obj + "," + jp("port", str(session.port))
    obj = obj + "," + jp("config_path", js(session.config_path))
    obj = obj + "," + jp("probe_serial", js(session.probe_serial))
    obj = obj + "," + jp("bitbang_host", js(session.bitbang_host))
    obj = obj + "," + jp("bitbang_port", str(session.bitbang_port))
    obj = obj + "," + jp("jtag_device", js(session.jtag_device))
    obj = obj + "," + jp("bootstrap_discovery_command", js(session.bootstrap_discovery_command))
    obj = obj + "," + jp("bootstrap_launch_command", js(session.bootstrap_launch_command))
    obj = obj + "," + jp("bootstrap_attach_target", js(session.bootstrap_attach_target))
    obj = obj + "," + jp("bootstrap_config", js(session.bootstrap_config))
    obj = obj + "," + jp("bootstrap_notes", _json_text_array(session.bootstrap_notes))
    obj = obj + RB()
    obj

# The central service owns policy and receipts, but does not itself transport
# commands. Authorization is not execution evidence. No target changes here.
fn _debug_unavailable(id: text, session: DapSession, action: text, mutation: bool) -> text:
    val operation = if mutation: DebugRootOperationV1.Control else: DebugRootOperationV1.Inspect
    val perturbation = if mutation: DebugPerturbationV1.Mutating else: DebugPerturbationV1.Passive
    val debug_id = DebugSessionId(value: session.debug_session_id)
    val authorization = central_debug_service_v1_authorize(debug_id, operation, perturbation, action)
    var status = "denied"
    var reason = authorization.reason
    var receipt_id = authorization.receipt_id
    if authorization.allowed:
        status = "unsupported"
        reason = "No admitted target request/response transport for this MCP operation; session registration is not target attachment"
        val outcome = central_debug_service_v1_record_outcome(debug_id, operation, perturbation, action, false, false, reason)
        receipt_id = outcome.receipt_id
    _debug_unavailable_response(id, session, action, status, reason, receipt_id)

fn _debug_unavailable_response(id: text, session: DapSession, action: text, status: text, reason: text, receipt_id: text) -> text:
    var result = LB()
    result = result + jp("status", js(status))
    result = result + "," + jp("operation", js(action))
    result = result + "," + jp("session_id", js(session.id))
    result = result + "," + jp("debug_session_id", js(session.debug_session_id))
    result = result + "," + jp("build_id", js(session.build_id))
    result = result + "," + jp("backend_id", js(session.backend_id))
    result = result + "," + jp("verification", js("unverified"))
    result = result + "," + jp("receipt_id", js(receipt_id))
    result = result + "," + jp("execution_changed", "false")
    result = result + "," + jp("reason", js(reason)) + RB()
    make_tool_result_status(id, result, true)

fn _hw_session_plan_result(id: text, session: DapSession, operation: text, payload_key: text, payload_value: text) -> text:
    val debug_id = DebugSessionId(value: session.debug_session_id)
    val authorization = central_debug_service_v1_authorize(debug_id, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, operation)
    if not authorization.allowed:
        return _debug_unavailable_response(id, session, operation, "denied", authorization.reason, authorization.receipt_id)
    val outcome = central_debug_service_v1_record_outcome(debug_id, DebugRootOperationV1.Control, DebugPerturbationV1.Mutating, operation, false, false, "Bootstrap plan only; no target operation was executed")
    var r = LB()
    r = r + jp("session_id", js(session.id))
    r = r + "," + jp("receipt_id", js(outcome.receipt_id))
    r = r + "," + jp("status", js("unsupported"))
    r = r + "," + jp("plan_only", "true")
    r = r + "," + jp("execution_changed", "false")
    r = r + "," + jp("reason", js("Bootstrap plan only; no target operation was executed"))
    r = r + "," + jp("operation", js(operation))
    r = r + "," + jp("backend_id", js(session.backend_id))
    r = r + "," + jp("transport", js(session.transport))
    r = r + "," + jp("state", js(session.state))
    r = r + "," + jp("capabilities", _json_text_array(session.capabilities))
    r = r + "," + jp("bootstrap_launch_command", js(session.bootstrap_launch_command))
    r = r + "," + jp("bootstrap_attach_target", js(session.bootstrap_attach_target))
    r = r + "," + jp("bootstrap_config", js(session.bootstrap_config))
    if payload_key != "":
        r = r + "," + jp(payload_key, js(payload_value))
    r = r + RB()
    make_tool_result_status(id, r, true)

# ============================================================================
# Session Management
# ============================================================================

fn handle_debug_create_session(id: text, body: text) -> text:
    val program = extract_field(body, "program")
    if program == "":
        return make_tool_error(id, -32602, "Missing required parameter: program")
    var target_type = extract_field(body, "target_type")
    if target_type == "":
        target_type = "interpreter"
    val session = dap_create_session(
        program,
        target_type,
        extract_field(body, "transport"),
        extract_field(body, "arch"),
        extract_field(body, "exec_mode"),
        extract_field(body, "vendor"),
        extract_field(body, "probe_kind"),
        extract_field(body, "server_kind"),
        extract_field(body, "host"),
        extract_field(body, "port"),
        extract_field(body, "config_path"),
        extract_field(body, "probe_serial"),
        extract_field(body, "bitbang_host"),
        extract_field(body, "bitbang_port"),
        extract_field(body, "jtag_device"),
        extract_field(body, "persistent_session")
    )
    make_tool_result_status(id, _session_json(session), session.state == "failed")

fn handle_debug_list_sessions(id: text) -> text:
    val sessions = dap_list_sessions()
    var arr = SB_L()
    var first = true
    for s in sessions:
        if not first:
            arr = arr + ","
        first = false
        arr = arr + _session_json(s)
    arr = arr + SB_R()
    make_tool_result(id, arr)

fn handle_debug_close_session(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    if session_id == "":
        return make_tool_error(id, -32602, "Missing required parameter: session_id")
    if not dap_close_session(session_id):
        return make_tool_error(id, -32602, "Session not found: " + session_id)
    make_tool_result(id, jo2(jp("closed", js(session_id)), jp("status", js("ok"))))

# ============================================================================
# Breakpoints
