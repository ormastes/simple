fn handle_debug_get_source(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    val path = extract_field(body, "file")
    if session_id == "" or path == "":
        return make_tool_error(id, -32602, "Missing required parameter: session_id/file")
    val session = dap_find_session(session_id)
    if session.id == "":
        return make_tool_error(id, -32602, "Session not found: " + session_id)
    val start_line_str = extract_field(body, "start_line")
    var start_line = 1
    if start_line_str != "":
        start_line = _debug_to_int_or(start_line_str, 1)
        if start_line < 1:
            start_line = 1
    var count = 20
    val count_str = extract_field(body, "count")
    if count_str != "":
        count = _debug_to_int_or(count_str, 20)
        if count < 1:
            count = 20
    val content = file_read(path)
    if content == "":
        return make_tool_error(id, -32602, "Could not read file: " + path)
    val lines = content.split(_DEBUG_NL)
    var end_line = start_line + count - 1
    if end_line > lines.len():
        end_line = lines.len()
    var out: [text] = []
    var i = start_line
    while i <= end_line:
        out.push(str(i) + " | " + lines[i - 1])
        i = i + 1
    var r = LB()
    r = r + jp("session_id", js(session_id))
    r = r + "," + jp("file", js(path))
    r = r + "," + jp("source_origin", js("current_disk"))
    r = r + "," + jp("target_source_verified", "false")
    r = r + "," + jp("start_line", str(start_line))
    r = r + "," + jp("source", js(out.join(_DEBUG_NL)))
    r = r + RB()
    make_tool_result(id, r)

# ============================================================================
# Watch & Data Breakpoints
# ============================================================================

fn handle_debug_watch(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    val action = extract_field(body, "action")
    if session_id == "" or action == "":
        return make_tool_error(id, -32602, "Missing required parameter: session_id/action")
    val session = dap_find_session(session_id)
    if session.id == "":
        return make_tool_error(id, -32602, "Session not found: " + session_id)
    if action != "add" and action != "remove" and action != "list":
        return make_tool_error(id, -32602, "Invalid action: " + action)
    if action != "list" and extract_field(body, "expression") == "":
        return make_tool_error(id, -32602, "Missing expression for " + action)
    _debug_unavailable(id, session, "debug_watch_" + action, action != "list")

fn handle_debug_set_variable(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    val name = extract_field(body, "name")
    val value = extract_field(body, "value")
    if session_id == "" or name == "" or value == "":
        return make_tool_error(id, -32602, "Missing required parameter: session_id/name/value")
    val session = dap_find_session(session_id)
    if session.id == "":
        return make_tool_error(id, -32602, "Session not found: " + session_id)
    _debug_unavailable(id, session, "debug_set_variable", true)

