        return make_tool_error(id, -32602, "Invalid step mode: " + mode)
    val session = dap_find_session(session_id)
    if session.id == "":
        return make_tool_error(id, -32602, "Session not found: " + session_id)
    _debug_unavailable(id, session, "debug_step", true)

