fn _require_hw_session(id: text, session_id: text, required_types: [text]) -> (text, text):
    """Returns (error_response, target_type). If error_response != "", return it."""
    if session_id == "":
        return (make_tool_error(id, -32602, "Missing required parameter: session_id"), "")
    val session = dap_find_session(session_id)
    if session.id == "":
        return (make_tool_error(id, -32602, "Session not found: " + session_id), "")
    var valid = false
    for t in required_types:
        if session.target_type == t:
            valid = true
            break
    if not valid:
        return (make_tool_error(id, -32602, "Requires " + required_types.join("/") + " session (current: " + session.target_type + ")"), "")
    ("", session.target_type)

fn handle_debug_trace_capture(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    val (err, _) = _require_hw_session(id, session_id, ["t32", "t32_gdb"])
    if err != "":
        return err
    val session = dap_find_session(session_id)
    var duration_str = extract_field(body, "duration_ms")
    var duration = 1000
    if duration_str != "":
        duration = _debug_to_int_or(duration_str, 1000)
        if duration < 1:
            duration = 1000
    _hw_session_plan_result(id, session, "debug_trace_capture", "duration_ms", str(duration))

fn handle_debug_coverage_collect(id: text, body: text) -> text:
    val session_id = extract_field(body, "session_id")
    val module = extract_field(body, "module")
    if module == "":
        return make_tool_error(id, -32602, "Missing required parameter: module")
    val (err, _) = _require_hw_session(id, session_id, ["t32", "t32_gdb"])
    if err != "":
        return err
    _hw_session_plan_result(id, dap_find_session(session_id), "debug_coverage_collect", "module", module)

