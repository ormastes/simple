# MCP Server - per-server-session "last file read" state
#
# Visibility queries (simple_visibility / simple_symbols / simple_context
# `requester`) default to the LAST file this server session read or opened
# through simple_read, editor.open_file or editor.read_buffer. In-process only:
# the cross-process /tmp editor-state file is never consulted, and a query's
# own target file never becomes its requester. Mutated only via these accessors.

var _MCP_LAST_READ_PATH: text = ""

fn mcp_record_last_read(path: text):
    if path != "":
        _MCP_LAST_READ_PATH = path

fn mcp_last_read_path() -> text:
    _MCP_LAST_READ_PATH

fn mcp_reset_last_read():
    _MCP_LAST_READ_PATH = ""

# (requester, source): explicit `path[:line]` > last read file > "" / "none".
fn mcp_resolve_requester(explicit: text) -> (text, text):
    if explicit != "":
        return (explicit, "explicit")
    if _MCP_LAST_READ_PATH != "":
        return (_MCP_LAST_READ_PATH, "last_read")
    ("", "none")
