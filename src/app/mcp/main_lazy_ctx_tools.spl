# MCP Context Tool Handlers — persistent BM25 index + sandboxed execution
#
# Repo-native replacement for the user-level "context-mode" plugin tools:
#
#   simple_ctx_index(content, source)                 -> chunk + index text
#   simple_ctx_search(queries[] | query, source?, limit?) -> ranked BM25 hits
#   simple_ctx_execute(language, code, timeout_ms?)   -> bounded run, stdout only
#   simple_ctx_execute_file(path, language, code)     -> same, file path in $1/argv
#   simple_ctx_batch_execute(commands[], queries[], source?) -> run+index+search
#   simple_ctx_fetch_and_index(url, source, max_bytes?) -> capped GET, tags stripped
#   simple_ctx_stats()                                -> counts + bytes saved
#   simple_ctx_doctor()                               -> self-check checklist
#   simple_ctx_upgrade()                              -> re-index/compact the store
#
# Store: `.simple/ctx/` (override: SIMPLE_CTX_DIR). Two SDN tables:
#   chunks.sdn  ctx_chunks | id, source, ts, bytes, text |   (text is escaped)
#   stats.sdn   ctx_stats  | key, value |
# chunks.sdn is append-only (one row per chunk, `file_append_text`); the row
# reader skips a torn trailing row, so a killed session never poisons the
# store. stats.sdn is small and rewritten atomically (tmp + rename). The index
# survives across server processes and sessions — it is a file, not a
# per-process temp DB. Search is BM25 (k1=1.2, b=0.75) over word tokens of
# each chunk, computed at query time from the stored chunks; no external
# search engine, no SQLite FTS5 dependency.
#
# Scale contract (2026-08-28, doc/08_tracking/bug/mcp_ctx_batch_execute_crash_hang_on_real_output_2026-08-28.md):
# every hot path over captured output or stored chunks is LINEAR and built
# from native string ops (`split`/`replace`/`contains`/`index_of`) — never a
# per-character `for ch in s` loop. Two reasons: (1) the interpreter's for-in
# has no arm for `Value::StrBytes` (a text carrying non-UTF-8 bytes, which is
# exactly what `git log`/`grep` over a real tree emit), so a per-char loop
# over captured output crashes the server with `cannot iterate over this
# type: StrBytes(...)`; (2) when this module runs interpreted (JIT fallback
# in main.spl) a per-char loop costs ~6.5 us/char — 4 MB of `git log --stat`
# is ~30 s per pass, and the old search tokenized every chunk once per query.
#
# Capture cap: each command's stdout/stderr is bounded at the reader
# (`max_output_bytes` of the resource scope, enforced in the runtime, so
# memory is bounded regardless of what the child prints). Default 8 MiB per
# command, `SIMPLE_CTX_CAPTURE_MAX_BYTES` env or `capture_bytes` param, hard
# max 64 MiB. A truncated capture is marked inline and counted in stats
# (`capture_truncations`). Unlike the plugin's 100 KB truncate-first cap, the
# whole capture (up to the cap) is indexed and searchable.
#
# Sandbox: every execution goes through std resource_scope
# (`run_in_execution_resource_scope`) which applies wall timeout, output cap,
# pid cap (`ulimit -u`) and memory cap. Only stdout is returned; stderr is
# summarized to one line so a noisy failure cannot flood the caller.

use .main_lazy_json.{extract_field, extract_field_raw, make_tool_error, make_tool_result}
use .main_lazy_node_tools.{require_external_tool}
use .main_lazy_telemetry.{tok_record, tok_rollup, tok_load_events, TOK_FEATURE_CTX}
use .main_lazy_log_opt.{log_opt_optimize, log_opt_optimize_recorded, log_opt_plugins_text, LOG_OPT_FEATURE}

use .ctx_index_cache.{CtxStorePath, CtxStoreLength, CtxStoreDigest, CtxGenerationKey, CtxCacheDecision, CtxCacheRebuildCount, ctx_generation_key_missing, ctx_generation_key_present, ctx_cache_decide, ctx_cache_rebuild_count_next}
use .ctx_postings.{CtxPostings, CtxTerm, CtxNormBodies, CtxBodyLengths, CtxAvgLength, CtxScoreBoard, CtxResultLimit, ctx_postings_build, ctx_postings_append, ctx_scores_by_scan, ctx_scores_by_postings, CtxGenerationHits, CtxPostingsBuildCount, CtxPostingsDecision, ctx_generation_hits_zero, ctx_generation_hits_next, ctx_postings_build_count_next, ctx_postings_decide}
use .ctx_append_observer.{ctx_append_observer_fire, ctx_purge_observer_fire}
use .ctx_redaction.{CtxRawContent, ctx_redact}
use .ctx_retention.{CtxChunkId, CtxSourceLabel, CtxUnixSecs, CtxAgeLimit, CtxByteCount, CtxRetentionRow, CtxRetentionPolicy, CtxPolicyCheck, CtxPurgeMode, CtxRetentionPlan, ctx_retention_row, ctx_retention_policy, ctx_retention_check, ctx_retention_decide, ctx_policy_check_label}
use std.io_runtime.{file_rename, env_get, file_read, file_write, file_append_text, file_exists, file_delete, dir_create, time_now_unix_micros, file_size_signed, file_hash_sha256_or_empty}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write, file_read_text_at}
use std.database.core.{parse_sdn_table}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass, execution_resource_scope, run_in_execution_resource_scope}
use std.nogc_sync_mut.io.process_ops.{resolve_shell_argv, is_posix_shell_argv}
use std.nogc_sync_mut.io.http_get_core.{http_get_raw}
use std.nogc_sync_mut.security.sanitize.{strip_html_tags}
use std.common.math.special.{ln_f64}
use std.common.perf.execution_metrics.{TerminationCause}

const _CTX_CHUNK_CHARS: i64 = 1200
const _CTX_DEFAULT_LIMIT: i64 = 5
const _CTX_MAX_LIMIT: i64 = 25
const _CTX_SNIPPET_CHARS: i64 = 320
const _CTX_DEFAULT_TIMEOUT_MS: i64 = 15000
const _CTX_MAX_TIMEOUT_MS: i64 = 120000
# Return cap for execute stdout (parity with context-mode's 100 KB smart
# truncation): above this, the head (60%) and tail (40%) are returned, the
# full output is indexed under `exec:<ts>` and the annotation names it.
const _CTX_RETURN_CAP_BYTES: i64 = 102400
const _CTX_CAPTURE_DEFAULT_MAX_BYTES: i64 = 8388608
const _CTX_CAPTURE_HARD_MAX_BYTES: i64 = 67108864
const _CTX_FETCH_DEFAULT_MAX_BYTES: i64 = 262144
const _CTX_FETCH_HARD_MAX_BYTES: i64 = 2097152
const _CTX_SCHEMA_VERSION: i64 = 1

# ---------------------------------------------------------------------------
# Store location + SDN cell escaping
# ---------------------------------------------------------------------------

pub fn ctx_store_dir() -> text:
    val override = env_get("SIMPLE_CTX_DIR") ?? ""
    if override != "":
        return override
    ".simple/ctx"

fn _ctx_chunks_path() -> text:
    ctx_store_dir() + "/chunks.sdn"

fn _ctx_stats_path() -> text:
    ctx_store_dir() + "/stats.sdn"

fn _ctx_ensure_dir() -> bool:
    val dir = ctx_store_dir()
    if file_exists(dir):
        return true
    dir_create(dir, true)

# One SDN cell must be a single line with no raw double quote (the SDN row
# splitter toggles quoting on `"`). Commas are fine: the writer quotes cells
# containing them and the parser strips the quotes back off.
pub fn ctx_escape_cell(s: text) -> text:
    var r = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\q")
    r = r.replace("\r", "\\r")
    r = r.replace("\n", "\\n")
    r = r.replace("\t", "\\t")
    r

# Segment-wise unescape: split on the backslash (native), then each segment
# after the first starts with its escape code. An EMPTY segment is an escaped
# backslash (`\\`), and the segment after it is plain text. Linear, no
# per-character loop (see the scale contract in the header).
fn _ctx_unescape_segments(s: text, json_codes: bool) -> text:
    if not s.contains("\\"):
        return s
    val segs = s.split("\\")
    var out: [text] = [segs[0]]
    var i = 1
    while i < segs.len():
        val seg = segs[i]
        if seg == "":
            out.push("\\")
            if i + 1 < segs.len():
                out.push(segs[i + 1])
            i = i + 2
            continue
        val code = seg.substring(0, 1)
        val rest = seg.substring(1)
        if code == "n":
            out.push("\n")
        elif code == "r":
            out.push("\r")
        elif code == "t":
            out.push("\t")
        elif code == "q":
            out.push("\"")
        elif json_codes and (code == "b" or code == "f"):
            pass
        elif json_codes and code == "u":
            out.push("\\u")
        else:
            out.push(code)
        out.push(rest)
        i = i + 1
    out.join("")

pub fn ctx_unescape_cell(s: text) -> text:
    _ctx_unescape_segments(s, false)

fn _ctx_cell(s: text) -> text:
    val e = ctx_escape_cell(s)
    if e.contains(","):
        return "\"" + e + "\""
    e

# Atomic write: tmp file + rename.
fn _ctx_write_atomic(path: text, content: text) -> bool:
    file_atomic_write(path, content)

# ---------------------------------------------------------------------------
# Chunk store
# ---------------------------------------------------------------------------

pub struct CtxChunk:
    id: CtxChunkId
    source: text
    ts: CtxUnixSecs
    bytes: CtxByteCount
    body: text

# One data row of chunks.sdn: `    id, source, ts, bytes, text`. A cell that
# carried a comma was written quoted (`"..."`); escaped cells never contain a
# raw double quote, so the closing quote is unambiguous. Returns nil for a
# header/comment line or a torn row (an append interrupted mid-line).
fn _ctx_parse_chunk_row(line: text) -> CtxChunk?:
    if not line.starts_with("    "):
        return None
    val rest = line.substring(4)
    val p1 = rest.index_of(", ") ?? -1
    if p1 < 0:
        return None
    val id = rest.substring(0, p1).to_int() ?? 0
    var r2 = rest.substring(p1 + 2)
    var source = ""
    if r2.starts_with("\""):
        val close = r2.index_of("\"", 1) ?? -1
        if close < 0:
            return None
        source = r2.substring(1, close)
        r2 = r2.substring(close + 1)
        if not r2.starts_with(", "):
            return None
        r2 = r2.substring(2)
    else:
        val p2 = r2.index_of(", ") ?? -1
        if p2 < 0:
            return None
        source = r2.substring(0, p2)
        r2 = r2.substring(p2 + 2)
    val p3 = r2.index_of(", ") ?? -1
    if p3 < 0:
        return None
    val ts = r2.substring(0, p3).to_int() ?? 0
    r2 = r2.substring(p3 + 2)
    val p4 = r2.index_of(", ") ?? -1
    if p4 < 0:
        return None
    val bytes = r2.substring(0, p4).to_int() ?? 0
    var cell = r2.substring(p4 + 2)
    if cell.len() >= 2 and cell.starts_with("\"") and cell.ends_with("\""):
        cell = cell.substring(1, cell.byte_len() - 1)
    Some(CtxChunk(id: CtxChunkId(value: id), source: source, ts: CtxUnixSecs(secs: ts), bytes: CtxByteCount(bytes: bytes), body: ctx_unescape_cell(cell)))

# Linear row reader: one native line split + a handful of `index_of` per
# row. Replaces the generic SDN table parser, which walked the whole file
# per character (minutes for a multi-MB store when interpreted).
fn _ctx_load_chunks() -> [CtxChunk]:
    var out: [CtxChunk] = []
    val path = _ctx_chunks_path()
    if not file_exists(path):
        return out
    for line in file_read(path).split("\n"):
        if val c = _ctx_parse_chunk_row(line):
            out.push(c)
    out

# Rows of the store that are fully written. An appender writes one block with
# O_APPEND, so a reader can see a final row cut short; a store that does not end
# in a newline has an unterminated last segment, which is dropped (it would
# parse as a truncated row). Used wherever rows are COPIED (purge snapshot and
# tail replay); read-only search keeps `_ctx_load_chunks`.
fn _ctx_load_complete_chunks() -> [CtxChunk]:
    var out: [CtxChunk] = []
    val path = _ctx_chunks_path()
    if not file_exists(path):
        return out
    val raw = file_read(path)
    var segs = raw.split("\n")
    if not raw.ends_with("\n") and segs.len() > 0:
        segs.pop()
    for line in segs:
        if val c = _ctx_parse_chunk_row(line):
            out.push(c)
    out

fn _ctx_chunk_line(c: CtxChunk) -> text:
    "    " + str(c.id.value) + ", " + _ctx_cell(c.source) + ", " + str(c.ts.secs) + ", " + str(c.bytes.bytes) + ", " + _ctx_cell(c.body) + "\n"

fn _ctx_store_header() -> text:
    "# ctx chunk store — written by simple_ctx_* MCP tools. Do not edit by hand.\n# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION) + "\nctx_chunks | id, source, ts, bytes, text |\n"

# Append-only: the store is never rewritten on index. The post-write presence
# check reads only the bytes this append (and racers) added, not the store.
fn _ctx_append_chunks(new_chunks: [CtxChunk]) -> bool:
    if not _ctx_ensure_dir():
        return false
    val path = _ctx_chunks_path()
    if not file_exists(path):
        if not file_write(path, _ctx_store_header()):
            return false
    var lines: [text] = []
    for c in new_chunks:
        lines.push(_ctx_chunk_line(c))
    file_append_text(path, lines.join(""))

# Attempts an append makes before reporting failure when a purge keeps
# replacing the store under it.
const _CTX_APPEND_MAX_ATTEMPTS: i64 = 4

# True when the store still contains `rows` (their last line implies the whole
# single-write block). `before` is the store size read before the write: when the
# store has not shrunk below it, our block lies in [before, size), so only that
# tail is read (O(new bytes)); the full store is read only if the tail misses
# (a replaced store, or a racer's partial row at the tail edge).
fn _ctx_rows_present(rows: [CtxChunk], before: i64) -> bool:
    if rows.len() == 0:
        return true
    val path = _ctx_chunks_path()
    val line = _ctx_chunk_line(rows[rows.len() - 1])
    val size = file_size_signed(path)
    if before >= 0 and size > before:
        match file_read_text_at(path, before, size - before):
            case Ok(tail):
                if tail.contains(line):
                    return true
            case Err(_): pass
    file_read(path).contains(line)

# Append and then verify the rows are in the store. A purge commits by renaming
# a rewritten file over the store (after replaying rows appended since its
# snapshot, see `ctx_purge_commit`); an append written to the replaced file
# AFTER the purge's last tail read but BEFORE its rename is lost with the old
# inode. After writing, the rows are checked by presence (their id-bearing last
# line), never by byte size: a size match is not proof, since a purge can
# replace the store with a file of the same length. If absent, re-apply to the
# new store (bounded, lock-free). The observer fires between the write and the
# check via `ctx_append_observer_fire` (no-op unless a spec registered a hook).
# Residual window: see `ctx_purge_commit`.
fn _ctx_append_chunks_settled(new_chunks: [CtxChunk]) -> bool:
    var attempt = 1
    while true:
        val before = file_size_signed(_ctx_chunks_path())
        if not _ctx_append_chunks(new_chunks):
            return false
        ctx_append_observer_fire()
        if _ctx_rows_present(new_chunks, before):
            return true
        if attempt >= _CTX_APPEND_MAX_ATTEMPTS:
            return false
        attempt = attempt + 1
    false

fn _ctx_next_id(existing: [CtxChunk]) -> i64:
    var mx: i64 = 0
    for c in existing:
        if c.id.value > mx:
            mx = c.id.value
    mx + 1

# Reserve `count` consecutive ids; the high-water mark lives in stats.sdn so
# indexing does not need to load the chunk store. A store without the key
# (pre-existing or externally rewritten) is scanned once to seed it.
fn _ctx_reserve_ids(count: i64) -> i64:
    var d = _ctx_load_stats()
    var next: i64 = 0
    if d.contains_key("next_id"):
        next = d["next_id"]
    if next <= 0:
        next = _ctx_next_id(_ctx_load_chunks())
    d["next_id"] = next + count
    _ctx_save_stats(d)
    next

# Chunk-count result of an index call (-1 = store write failed).
pub struct CtxChunkCount:
    count: i64

# Wall-clock budget of one bounded command, in milliseconds.
pub struct CtxTimeoutMs:
    ms: i64

# Schema version stamped in the chunk store header (0 = unstamped).
pub struct CtxSchemaVersion:
    version: i64

pub enum CtxUrlVerdict:
    Allowed
    Denied

pub struct CtxLineCount:
    count: i64

# Smart-truncation result; omitted_lines == 0 means nothing was cut.
pub struct CtxTruncation:
    body: text
    omitted_lines: CtxLineCount
    omitted_bytes: CtxByteCount

pub enum CtxCapVerdict:
    Whole
    Cut

pub struct CtxCapped:
    body: text
    verdict: CtxCapVerdict

# Result of rewriting the store under the current schema.
pub struct CtxUpgradeReport:
    before_count: CtxChunkCount
    after_count: CtxChunkCount
    before_version: CtxSchemaVersion

# Per-command capture cap (bytes of stdout, and separately stderr, retained).
pub fn ctx_capture_max_bytes() -> CtxByteCount:
    val raw = env_get("SIMPLE_CTX_CAPTURE_MAX_BYTES") ?? ""
    val n = raw.trim().parse_int() ?? 0
    if n <= 0:
        return CtxByteCount(bytes: _CTX_CAPTURE_DEFAULT_MAX_BYTES)
    if n > _CTX_CAPTURE_HARD_MAX_BYTES:
        return CtxByteCount(bytes: _CTX_CAPTURE_HARD_MAX_BYTES)
    CtxByteCount(bytes: n)

fn _ctx_now_secs() -> i64:
    time_now_unix_micros() / 1000000

# Split text into chunks of ~_CTX_CHUNK_CHARS, breaking on line boundaries.
pub fn ctx_chunk_text(content: text, budget: CtxByteCount) -> [text]:
    val chunk_chars = budget.bytes
    var chunks: [text] = []
    var cur: [text] = []
    var cur_len: i64 = 0
    for line in content.split("\n"):
        val ll = line.len() + 1
        if cur_len > 0 and cur_len + ll > chunk_chars:
            chunks.push(cur.join("\n"))
            cur = []
            cur_len = 0
        # A single line longer than the chunk budget is split by fixed width.
        if ll > chunk_chars:
            var start = 0
            val n = line.len()
            while start < n:
                var end = start + chunk_chars
                if end > n:
                    end = n
                chunks.push(line.substring(start, end))
                start = end
            continue
        cur.push(line)
        cur_len = cur_len + ll
    if cur_len > 0:
        val tail = cur.join("\n")
        if tail.trim() != "":
            chunks.push(tail)
    chunks

# Index `content` under `source`; returns number of chunks written.
pub fn ctx_index_text(raw_content: text, source: text) -> CtxChunkCount:
    # Secrets are masked BEFORE chunking: the raw value is never stored.
    val content = ctx_redact(CtxRawContent(body: raw_content)).body
    if content.trim() == "":
        return CtxChunkCount(count: 0)
    val pieces = ctx_chunk_text(content, CtxByteCount(bytes: _CTX_CHUNK_CHARS))
    if pieces.len() == 0:
        return CtxChunkCount(count: 0)
    var next = _ctx_reserve_ids(pieces.len())
    val now = _ctx_now_secs()
    var rows: [CtxChunk] = []
    for piece in pieces:
        rows.push(CtxChunk(id: CtxChunkId(value: next), source: source, ts: CtxUnixSecs(secs: now), bytes: CtxByteCount(bytes: piece.len()), body: piece))
        next = next + 1
    val pre_append = _ctx_cache_key_before_append()
    if not _ctx_append_chunks_settled(rows):
        return CtxChunkCount(count: -1)
    _ctx_cache_extend_after_append(pre_append, rows)
    _ctx_stats_bump("bytes_indexed", content.len())
    _ctx_stats_bump("index_calls", 1)
    CtxChunkCount(count: rows.len())

# ---------------------------------------------------------------------------
# Stats (key/value SDN)
# ---------------------------------------------------------------------------

fn _ctx_load_stats() -> Dict<text, i64>:
    var d: Dict<text, i64> = {}
    val path = _ctx_stats_path()
    if not file_exists(path):
        return d
    val table = parse_sdn_table(file_read(path))
    match table:
        Some(t):
            for row in t.rows:
                val k = row.get("key") ?? ""
                val v = (row.get("value") ?? "0").to_int() ?? 0
                if k != "":
                    d[k] = v
        None:
            pass
    d

fn _ctx_save_stats(d: Dict<text, i64>) -> bool:
    if not _ctx_ensure_dir():
        return false
    var lines: [text] = []
    lines.push("ctx_stats | key, value |\n")
    val keys = d.keys()
    for k in keys:
        lines.push("    " + k + ", " + str(d[k]) + "\n")
    _ctx_write_atomic(_ctx_stats_path(), lines.join(""))

fn _ctx_stats_bump(key: text, delta: i64):
    var d = _ctx_load_stats()
    if d.contains_key(key):
        d[key] = d[key] + delta
    else:
        d[key] = delta
    _ctx_save_stats(d)

# ---------------------------------------------------------------------------
# Tokenizer + BM25
# ---------------------------------------------------------------------------

# Every byte that is not a word character (a-z, 0-9, _) in typical program
# output. Each is replaced by TWO spaces so that a token is always framed by
# whitespace on both sides and two adjacent occurrences of ` term ` can never
# share a space — that is what makes `split(" term ").len() - 1` an exact
# occurrence count.
const _CTX_SEPARATORS: [text] = [" ", "\n", "\t", "\r", "/", ".", ":", "(", ")", "[", "]", "{", "}", ",", ";", "=", "+", "-", "*", "<", ">", "\"", "'", "`", "|", "&", "!", "?", "@", "#", "$", "%", "^", "~", "\\"]

# Lower-cased text with every separator widened to two spaces and a space at
# each end, so ` term ` matches exactly one whole-word occurrence. Built from
# native replace passes only — no per-character loop, so it costs the same
# whether this module is JIT-compiled or interpreted, and it never iterates
# a StrBytes value.
pub fn ctx_normalize(s: text) -> text:
    var n = s.lower()
    for sep in _CTX_SEPARATORS:
        n = n.replace(sep, "  ")
    " " + n + " "

pub fn ctx_tokenize(s: text) -> [text]:
    var toks: [text] = []
    for t in ctx_normalize(s).split(" "):
        if t.len() >= 2:
            toks.push(t)
    toks

# BM25 score (or substring occurrence count) of one hit.
pub struct CtxScore:
    points: f64

# Number of query terms a chunk matched (0 for substring fallback hits).
pub struct CtxMatchCount:
    count: i64

pub struct CtxHit:
    chunk: CtxChunk
    score: CtxScore
    matched: CtxMatchCount
    mode: text      # "bm25" | "substring"

# Query-side stopwords: common English function words only. Applied to query
# terms only, so document lengths and the store are untouched.
#
# 2026-09-24: dropped the dev-noise additions ("update", "fix", "test",
# "deps") that context-mode's original list carried alongside the English
# stopwords. In a dev-search index those are exactly the high-signal content
# words a query names — "fix", above all — and stripping them silently
# shrank the query to its remaining terms with no indication to the caller.
# Measured regression: `simple_ctx_search(queries: ["LLVM-C link fix"])`
# against the live 865-chunk store reduced the query to `llvm|link` (both
# "c" and "fix" gone — "c" is a legitimate single-char drop, "fix" was the
# stopword), so an unrelated `llvm-official-llvm-config` doc-page chunk
# (repeats "llvm" many times, never says "fix") outscored the actual
# "...LLVM-C link fix..." chunk (score 11.928 vs 10.663) purely because the
# one term that would have discriminated between them was discarded before
# scoring. See ctx_search_ranking_stopword_drops_fix_2026-09-24 regression.
const _CTX_STOPWORDS: [text] = ["the", "a", "an", "and", "or", "of", "to", "in", "is", "it", "for", "on", "with", "as", "at", "by", "be", "this", "that", "from", "are", "was", "not", "but", "if", "then", "so", "we", "you", "do", "does", "did", "has", "have", "had", "will", "can", "use", "using", "how", "what", "which", "where", "when", "all", "any", "each", "into", "than", "also", "just", "more", "some", "such", "only", "same", "other", "out", "up", "no", "yes", "its", "these", "those", "there", "here"]

fn _ctx_is_stopword(t: text) -> bool:
    for s in _CTX_STOPWORDS:
        if s == t:
            return true
    false

# Query terms with stopwords removed; a query made only of stopwords keeps
# its raw terms so it still answers rather than returning nothing.
pub fn ctx_query_terms(query: text) -> [text]:
    val raw = ctx_tokenize(query)
    var kept: [text] = []
    for t in raw:
        if not _ctx_is_stopword(t):
            kept.push(t)
    if kept.len() == 0:
        return raw
    kept

# Prepared search index: the filtered chunks plus their normalized bodies,
# built ONCE per handler call and shared by every query in that call.
pub struct CtxIndex:
    docs: [CtxChunk]
    norm: [text]
    avg_bytes: CtxAvgLength
    postings: CtxPostings?   # built once per cache generation; None for one-shot callers

# Raw substring needles for the zero-hit fallback: whitespace-separated
# pieces of the query (>= 3 chars), lowercased — keeps `_`, `.`, `-`, `(`
# so a partial identifier like `string_len` or `foo.bar` still matches.
fn _ctx_substring_needles(query: text) -> [text]:
    var out: [text] = []
    for piece in query.lower().split(" "):
        val p = piece.trim()
        if p.len() >= 3:
            out.push(p)
    out

# Top-k by repeated max selection (result sets are small).
fn _ctx_top_k(scored: [CtxHit], limit: i64) -> [CtxHit]:
    var out: [CtxHit] = []
    var taken: [bool] = []
    for h in scored:
        taken.push(false)
    var k = 0
    while k < limit and k < scored.len():
        var best = -1
        var j = 0
        while j < scored.len():
            if not taken[j]:
                if best < 0 or scored[j].score.points > scored[best].score.points:
                    best = j
            j = j + 1
        if best < 0:
            break
        taken[best] = true
        out.push(scored[best])
        k = k + 1
    out

# Chunk bodies are joined with this sentinel, normalized in one pass and
# split back apart, so a 5,000-chunk store costs one replace pass per
# separator instead of 5,000 x 35 native calls.
const _CTX_DOC_SENTINEL: text = "qzctxsepzq"

pub fn ctx_prepare_index(chunks: [CtxChunk], source_prefix: text) -> CtxIndex:
    var docs: [CtxChunk] = []
    var bodies: [text] = []
    var total_bytes: i64 = 0
    for c in chunks:
        if source_prefix == "" or c.source.starts_with(source_prefix):
            docs.push(c)
            bodies.push(c.body)
            total_bytes = total_bytes + c.body.len()
    if docs.len() == 0:
        return CtxIndex(docs: [], norm: [], avg_bytes: CtxAvgLength(bytes: 1.0), postings: None)
    var norm = ctx_normalize(bodies.join(" " + _CTX_DOC_SENTINEL + " ")).split(_CTX_DOC_SENTINEL)
    if norm.len() != docs.len():
        # A body contained the sentinel text itself; fall back to per-doc.
        norm = []
        for b in bodies:
            norm.push(ctx_normalize(b))
    var avg = total_bytes.to_float() / docs.len().to_float()
    if avg < 1.0:
        avg = 1.0
    CtxIndex(docs: docs, norm: norm, avg_bytes: CtxAvgLength(bytes: avg), postings: None)

# ---------------------------------------------------------------------------
# Per-process generation cache (see ctx_index_cache.spl)
# ---------------------------------------------------------------------------
# The parsed store and the last prepared index are reused while the store's
# generation key (path, presence, length, SHA-256) is unchanged; any append,
# delete or rename-replace changes the key and forces one re-read. The key is
# read BEFORE the store, so a concurrent append can only make the cached
# chunks newer than their key, which the next call then rebuilds.

var _CTX_CACHE_KEY: CtxGenerationKey? = None
var _CTX_CACHE_CHUNKS: [CtxChunk] = []
var _CTX_CACHE_INDEX: CtxIndex? = None
var _CTX_CACHE_PREFIX: text = ""
var _CTX_CACHE_REBUILDS: CtxCacheRebuildCount = CtxCacheRebuildCount(count: 0)
var _CTX_CACHE_HITS: CtxGenerationHits = ctx_generation_hits_zero()
var _CTX_POSTINGS_BUILDS: CtxPostingsBuildCount = CtxPostingsBuildCount(count: 0)

fn _ctx_store_generation_key() -> CtxGenerationKey:
    val path = _ctx_chunks_path()
    val store = CtxStorePath(value: path)
    if not file_exists(path):
        return ctx_generation_key_missing(store)
    val size = file_size_signed(path)
    if size < 0:
        return ctx_generation_key_missing(store)
    ctx_generation_key_present(store, CtxStoreLength(bytes: size), CtxStoreDigest(sha256: file_hash_sha256_or_empty(path)))

# Store re-reads performed by this process (spec / perf probe).
pub fn ctx_index_cache_rebuilds() -> CtxCacheRebuildCount:
    _CTX_CACHE_REBUILDS

# Postings are built only once the generation has served enough hits to repay
# the build (ctx_postings_decide); a fresh or short-lived generation scans.
fn _ctx_index_with_postings_when_due(idx: CtxIndex) -> CtxIndex:
    if idx.postings.?:
        return idx
    match ctx_postings_decide(_CTX_CACHE_HITS):
        case CtxPostingsDecision.UseScan:
            return idx
        case CtxPostingsDecision.BuildPostings:
            val built = CtxIndex(docs: idx.docs, norm: idx.norm, avg_bytes: idx.avg_bytes, postings: Some(ctx_postings_build(CtxNormBodies(bodies: idx.norm))))
            _CTX_CACHE_INDEX = Some(built)
            _CTX_POSTINGS_BUILDS = ctx_postings_build_count_next(_CTX_POSTINGS_BUILDS)
            built

# Postings builds performed by this process (spec / perf probe).
pub fn ctx_index_postings_builds() -> CtxPostingsBuildCount:
    _CTX_POSTINGS_BUILDS

# Incremental postings update on append. When this process holds a cached
# index WITH postings for the current generation, an append it performs itself
# is merged into that index (new chunks' terms added to the postings) and the
# cached generation key is advanced, so the next search neither re-reads the
# store nor rebuilds postings. Only a verified own append qualifies: the key
# before the append must equal the cached key, and the store must have grown by
# exactly the bytes written. Anything else (another process appended too, no
# postings yet, digest unavailable) leaves the cache alone and the next search
# rebuilds, as before.
var _CTX_POSTINGS_INCREMENTS: CtxPostingsBuildCount = CtxPostingsBuildCount(count: 0)

# Appends merged into live postings by this process (spec / perf probe).
pub fn ctx_index_postings_increments() -> CtxPostingsBuildCount:
    _CTX_POSTINGS_INCREMENTS

fn _ctx_cache_key_before_append() -> CtxGenerationKey?:
    if not _CTX_CACHE_KEY.?:
        return None
    if not _CTX_CACHE_INDEX.?:
        return None
    val idx = _CTX_CACHE_INDEX.unwrap()
    if not idx.postings.?:
        return None
    val key = _ctx_store_generation_key()
    match ctx_cache_decide(_CTX_CACHE_KEY, key):
        case CtxCacheDecision.Hit:
            Some(key)
        case _:
            None

fn _ctx_cache_extend_after_append(before: CtxGenerationKey?, rows: [CtxChunk]):
    if not before.?:
        return
    val old_key = before.unwrap()
    var added_bytes: i64 = 0
    for c in rows:
        added_bytes = added_bytes + _ctx_chunk_line(c).byte_len()
    val after = _ctx_store_generation_key()
    if after.length.bytes != old_key.length.bytes + added_bytes:
        return
    if after.digest.sha256.len() == 0:
        return
    val idx = _CTX_CACHE_INDEX.unwrap()
    var docs = idx.docs
    var norm = idx.norm
    var added_norm: [text] = []
    for c in rows:
        if _CTX_CACHE_PREFIX == "" or c.source.starts_with(_CTX_CACHE_PREFIX):
            docs.push(c)
            val nb = ctx_normalize(c.body)
            norm.push(nb)
            added_norm.push(nb)
    var total_bytes: i64 = 0
    for d in docs:
        total_bytes = total_bytes + d.body.len()
    var avg = 1.0
    if docs.len() > 0:
        avg = total_bytes.to_float() / docs.len().to_float()
    if avg < 1.0:
        avg = 1.0
    val grown = ctx_postings_append(idx.postings.unwrap(), CtxNormBodies(bodies: added_norm))
    var chunks = _CTX_CACHE_CHUNKS
    for c in rows:
        chunks.push(c)
    _CTX_CACHE_CHUNKS = chunks
    _CTX_CACHE_INDEX = Some(CtxIndex(docs: docs, norm: norm, avg_bytes: CtxAvgLength(bytes: avg), postings: Some(grown)))
    _CTX_CACHE_KEY = Some(after)
    _CTX_POSTINGS_INCREMENTS = ctx_postings_build_count_next(_CTX_POSTINGS_INCREMENTS)

fn _ctx_cached_index(source_prefix: text) -> CtxIndex:
    val key = _ctx_store_generation_key()
    match ctx_cache_decide(_CTX_CACHE_KEY, key):
        case CtxCacheDecision.Hit:
            _CTX_CACHE_HITS = ctx_generation_hits_next(_CTX_CACHE_HITS)
        case CtxCacheDecision.DigestUnavailable:
            # Unverifiable store: never cached, read fresh every time.
            _CTX_CACHE_KEY = None
            _CTX_CACHE_INDEX = None
            _CTX_CACHE_CHUNKS = []
            _CTX_CACHE_REBUILDS = ctx_cache_rebuild_count_next(_CTX_CACHE_REBUILDS)
            return ctx_prepare_index(_ctx_load_chunks(), source_prefix)
        case _:
            _CTX_CACHE_CHUNKS = _ctx_load_chunks()
            _CTX_CACHE_KEY = Some(key)
            _CTX_CACHE_INDEX = None
            _CTX_CACHE_REBUILDS = ctx_cache_rebuild_count_next(_CTX_CACHE_REBUILDS)
            _CTX_CACHE_HITS = ctx_generation_hits_zero()
    if val cached = _CTX_CACHE_INDEX:
        if _CTX_CACHE_PREFIX == source_prefix:
            return _ctx_index_with_postings_when_due(cached)
    val idx = ctx_prepare_index(_CTX_CACHE_CHUNKS, source_prefix)
    _CTX_CACHE_INDEX = Some(idx)
    _CTX_CACHE_PREFIX = source_prefix
    idx

fn _ctx_dedupe(terms: [text]) -> [text]:
    var seen: Dict<text, bool> = {}
    var out: [text] = []
    for t in terms:
        if not seen.contains_key(t):
            seen[t] = true
            out.push(t)
    out

# BM25 over a prepared index. Term frequency per document is an exact
# whole-word occurrence count over the normalized body, document length is the
# body's byte length. When the index carries postings (cached generation) only
# chunks containing a query term are scored; otherwise every body is scanned.
# Both scorers live in ctx_postings.spl and yield bit-equal scores.
fn _ctx_body_lengths(idx: CtxIndex) -> CtxBodyLengths:
    var lens: [i64] = []
    for d in idx.docs:
        lens.push(d.body.len())
    CtxBodyLengths(bytes: lens)

fn _ctx_score_board(idx: CtxIndex, lengths: CtxBodyLengths, terms: [CtxTerm], avg: CtxAvgLength, force_scan: bool) -> CtxScoreBoard:
    if not force_scan and idx.postings.?:
        return ctx_scores_by_postings(idx.postings.unwrap(), lengths, terms, avg)
    ctx_scores_by_scan(CtxNormBodies(bodies: idx.norm), lengths, terms, avg)

fn _ctx_search_index_with(idx: CtxIndex, query: text, limit: i64, force_scan: bool) -> [CtxHit]:
    val q_terms = _ctx_dedupe(ctx_query_terms(query))
    val n_docs = idx.docs.len()
    if q_terms.len() == 0 or n_docs == 0:
        return []
    var terms: [CtxTerm] = []
    for t in q_terms:
        terms.push(CtxTerm(word: t))
    val lengths = _ctx_body_lengths(idx)
    val avg = idx.avg_bytes
    val board = _ctx_score_board(idx, lengths, terms, avg, force_scan)
    var scored: [CtxHit] = []
    var i = 0
    while i < n_docs:
        if board.matched[i] > 0:
            scored.push(CtxHit(chunk: idx.docs[i], score: CtxScore(points: board.scores[i]), matched: CtxMatchCount(count: board.matched[i]), mode: "bm25"))
        i = i + 1
    if scored.len() > 0:
        return _ctx_top_k(scored, limit)
    # Zero-hit fallback: raw substring match over the un-normalized lowered
    # body, scored by occurrence count (the role of context-mode's trigram
    # table). Only reached when BM25 matched nothing, so the per-doc lower()
    # never runs on the hot path.
    val needles = _ctx_substring_needles(query)
    if needles.len() == 0:
        return []
    i = 0
    while i < n_docs:
        val low = idx.docs[i].body.lower()
        var hits: i64 = 0
        for nd in needles:
            if low.contains(nd):
                hits = hits + low.split(nd).len() - 1
        if hits > 0:
            scored.push(CtxHit(chunk: idx.docs[i], score: CtxScore(points: hits.to_float()), matched: CtxMatchCount(count: 0), mode: "substring"))
        i = i + 1
    _ctx_top_k(scored, limit)

pub fn ctx_bm25_search_index(idx: CtxIndex, query: text, limit: CtxResultLimit) -> [CtxHit]:
    _ctx_search_index_with(idx, query, limit.count, false)

# Full-scan reference path (parity oracle for the postings path).
pub fn ctx_bm25_search_index_scan(idx: CtxIndex, query: text, limit: CtxResultLimit) -> [CtxHit]:
    _ctx_search_index_with(idx, query, limit.count, true)

# One-query convenience over ctx_prepare_index + ctx_bm25_search_index.
pub fn ctx_bm25_search(chunks: [CtxChunk], query: text, source_prefix: text, limit: CtxResultLimit) -> [CtxHit]:
    ctx_bm25_search_index(ctx_prepare_index(chunks, source_prefix), query, limit)

fn _ctx_fmt_score(score: f64) -> text:
    # WORKAROUND(mcp-f64-to-int-20261012): native method lowering is unresolved.
    val milli = (score * 1000.0) as i64
    val whole = milli / 1000
    var frac = milli - whole * 1000
    if frac < 0:
        frac = 0 - frac
    var frac_s = str(frac)
    while frac_s.len() < 3:
        frac_s = "0" + frac_s
    str(whole) + "." + frac_s

# Snippet: window around the first query token hit, else the chunk head.
fn _ctx_snippet(body: text, query: text) -> text:
    val lower = body.lower()
    var pos = -1
    for qt in ctx_tokenize(query):
        val p = lower.index_of(qt)
        if p >= 0 and (pos < 0 or p < pos):
            pos = p
    var start = 0
    if pos > _CTX_SNIPPET_CHARS / 3:
        start = pos - _CTX_SNIPPET_CHARS / 3
    var end = start + _CTX_SNIPPET_CHARS
    if end > body.len():
        end = body.len()
    var s = body.substring(start, end)
    if start > 0:
        s = "…" + s
    if end < body.len():
        s = s + "…"
    s

fn ctx_format_hits(query: text, hits: [CtxHit]) -> text:
    var lines: [text] = []
    lines.push("## query: " + query + " (" + str(hits.len()) + " hit(s))")
    var rank = 1
    for h in hits:
        lines.push("[" + str(rank) + "] score=" + _ctx_fmt_score(h.score.points) + " match=" + h.mode + " source=" + h.chunk.source + " chunk=" + str(h.chunk.id.value) + " ts=" + str(h.chunk.ts.secs))
        lines.push(_ctx_snippet(h.chunk.body, query))
        lines.push("")
        rank = rank + 1
    lines.join("\n")

# ---------------------------------------------------------------------------
# Parameter helpers
# ---------------------------------------------------------------------------

# Decode independently scanned raw JSON array elements. extract_field already
# decodes string values, so its callers must not pass through this again.
pub fn ctx_unescape_json(s: text) -> text:
    _ctx_unescape_segments(s, true)

# Parse a JSON array of strings ("[\"a\", \"b\"]") into unescaped texts.
# A bare string is accepted as a one-element list. Built from native
# `index_of`/`substring` passes only (see the scale contract in the
# header): a per-character loop here would crash on a StrBytes request
# body, and request bodies can carry arbitrary bytes.
#
# The closing quote of an element is the next '"' preceded by an EVEN
# run of backslashes. Backslash parity is computed with a single backward
# `char_code_at` scan from the candidate quote (bounded by the run length
# itself, not by the element length) — NOT by re-slicing
# `t.substring(open + 1, cand)` and repeatedly stripping "\\" pairs off it,
# which re-copies and re-scans the WHOLE prefix on every candidate quote and
# is quadratic in the number of escaped quotes inside one element (each
# additional escaped quote adds another candidate, and each candidate's
# substring grows with the element so far).
fn _ctx_trailing_backslash_run(t: text, end_exclusive: i64, lower_bound: i64) -> i64:
    var i = end_exclusive - 1
    var count: i64 = 0
    while i >= lower_bound and t.char_code_at(i) == 92:
        count = count + 1
        i = i - 1
    count

pub fn ctx_parse_string_array(raw: text) -> [text]:
    var out: [text] = []
    val t = raw.trim()
    if t == "" or t == "null":
        return out
    if t.starts_with("\""):
        var inner = t.substring(1, t.byte_len())
        if inner.ends_with("\""):
            inner = inner.substring(0, inner.byte_len() - 1)
        out.push(ctx_unescape_json(inner))
        return out
    if not t.starts_with("["):
        return out
    var from: i64 = 1
    while from < t.byte_len():
        val open = t.index_of("\"", from) ?? -1
        if open < 0:
            break
        var close: i64 = -1
        var scan: i64 = open + 1
        while scan < t.byte_len():
            val cand = t.index_of("\"", scan) ?? -1
            if cand < 0:
                break
            val backslashes = _ctx_trailing_backslash_run(t, cand, open + 1)
            if backslashes % 2 == 0:
                close = cand
                break
            scan = cand + 1
        if close < 0:
            break
        out.push(ctx_unescape_json(t.substring(open + 1, close)))
        from = close + 1
    out

fn _ctx_int_param(body: text, key: text, default_value: i64, max_value: i64) -> i64:
    val raw = extract_field(body, key)
    if raw == "":
        return default_value
    val parsed = raw.parse_int() ?? default_value
    if parsed <= 0:
        return default_value
    if parsed > max_value:
        return max_value
    parsed

fn _ctx_queries(body: text) -> [text]:
    var qs = ctx_parse_string_array(extract_field_raw(body, "queries"))
    if qs.len() == 0:
        val single = extract_field(body, "query")
        if single != "":
            qs.push(single)
    qs

# ---------------------------------------------------------------------------
# Sandboxed execution
# ---------------------------------------------------------------------------

pub struct CtxExitCode:
    code: i64

# Wall-clock time one bounded command actually took, in milliseconds.
pub struct CtxWallMs:
    ms: i64

pub enum CtxWallBudget:
    WithinBudget
    TimedOut

pub enum CtxCaptureCut:
    Whole
    Capped

pub struct CtxExecResult:
    stdout: text
    stderr_summary: text
    exit_code: CtxExitCode
    timed_out: CtxWallBudget
    wall_ms: CtxWallMs
    raw_bytes: CtxByteCount   # stdout + stderr bytes retained (each stream bounded at capture_max)
    truncated: CtxCaptureCut  # stdout hit the per-command capture cap
    capture_max: CtxByteCount

fn _ctx_summarize_stderr(stderr: text, truncated: bool) -> text:
    val trimmed = stderr.trim()
    if trimmed == "":
        return "stderr: (empty)"
    val lines = trimmed.split("\n")
    var first = lines[0]
    if first.len() > 200:
        first = first.substring(0, 200) + "…"
    var s = "stderr: " + str(lines.len()) + " line(s), " + str(stderr.len()) + " byte(s); first: " + first
    if truncated:
        s = s + " [truncated]"
    s

# Whether a retained stream already carries the runtime's OWN inline
# truncation marker text, so the cosmetic note below is never appended
# twice. This is NOT how truncation is detected or counted (that is
# `p.stdout_truncated`/`p.stderr_truncated`, a structured receipt flag —
# see `_legacy_process_fallback` in `resource_scope.spl`, which now derives
# the flag from a length-vs-cap comparison rather than leaving it hardcoded
# false); it only decides which human-readable note to show. A loose
# `contains(A) and contains(B)` here would misfire on ordinary output that
# merely mentions both marker fragments unrelated to each other (e.g.
# grepping this repo's own runtime source, which spells
# `"[output truncated: "` and `" bytes omitted]"` as separate string
# literals on different lines,
# `src/compiler_rust/compiler/src/interpreter_extern/system.rs:66,109`), so
# this requires the exact contiguous shape — prefix, a decimal byte count,
# then suffix — with nothing else between.
fn _ctx_str_matches_at(s: text, at: i64, needle: text) -> bool:
    val n = needle.byte_len()
    if at < 0 or at + n > s.byte_len():
        return false
    var i = 0
    while i < n:
        if s.char_code_at(at + i) != needle.char_code_at(i):
            return false
        i = i + 1
    true

fn _ctx_has_rt_truncation_marker(s: text) -> bool:
    val prefix = "[output truncated: "
    val suffix = " bytes omitted]"
    val n = s.byte_len()
    var pos = 0
    while pos + prefix.len() <= n:
        if _ctx_str_matches_at(s, pos, prefix):
            var i = pos + prefix.len()
            var digits = 0
            while i < n and s.char_code_at(i) >= 48 and s.char_code_at(i) <= 57:
                i = i + 1
                digits = digits + 1
            if digits > 0 and _ctx_str_matches_at(s, i, suffix):
                return true
        pos = pos + 1
    false

# `capture_max` bounds each stream AT THE READER (runtime-enforced), so the
# server's memory is bounded by the cap regardless of what the child prints.
#
# Truncation is detected SOLELY from the structured receipt flags
# (`p.stdout_truncated`/`p.stderr_truncated`) — never by scanning the
# retained stream's text for a marker. Both the owned-observed provider (a
# real ABI flag) and the legacy bounded fallback (a length-vs-cap
# comparison, see `resource_scope.spl`) now report this flag honestly, so
# no output-text scan is needed to decide whether a capture was truncated.
# Cosmetic-only marker check bound: above this size, skip the exact-shape
# scan entirely and just append our own note (worst case, a capture that
# already carried the runtime's own marker shows both — harmless, still
# correct information, never wrong). This keeps the check O(1) regardless of
# `capture_max` (default 8 MiB) instead of an O(capture_max) scan on every
# truncated capture, which at the interpreter's ~6.5us/char per the module
# header would cost tens of seconds on a large truncated capture.
const _CTX_MARKER_SCAN_MAX_BYTES: i64 = 4096

pub fn ctx_run_bounded(cmd: text, args: [text], timeout: CtxTimeoutMs, capture: CtxByteCount) -> CtxExecResult:
    val timeout_ms = timeout.ms
    val capture_max = capture.bytes
    val scope = execution_resource_scope(ExecutionResourceClass.Large, timeout_ms, capture_max)
    val r = run_in_execution_resource_scope(scope, cmd, args)
    val p = r.process
    val exit_code = p.usage.exit_code
    val timed_out = p.usage.termination == TerminationCause.WallTimeout
    var out = p.stdout
    val truncated = p.stdout_truncated
    if truncated:
        # The stream may already carry the runtime's own truncation marker
        # text (the legacy fallback's bounded facade always leaves one on
        # truncation); only add ours when it does not, purely so a capture
        # is marked exactly once in the human-readable text. This lookup
        # affects formatting only — `truncated` and the stats count above
        # are already decided from the receipt flag, never from this check.
        val already_marked = out.len() <= _CTX_MARKER_SCAN_MAX_BYTES and _ctx_has_rt_truncation_marker(out)
        if not already_marked:
            out = out + "\n[capture truncated at " + str(capture_max) + " bytes]"
        _ctx_stats_bump("capture_truncations", 1)
    CtxExecResult(
        stdout: out,
        stderr_summary: _ctx_summarize_stderr(p.stderr, p.stderr_truncated),
        exit_code: CtxExitCode(code: exit_code),
        timed_out: if timed_out: CtxWallBudget.TimedOut else: CtxWallBudget.WithinBudget,
        wall_ms: CtxWallMs(ms: p.usage.wall_ms),
        raw_bytes: CtxByteCount(bytes: p.stdout.len() + p.stderr.len()),
        truncated: if truncated: CtxCaptureCut.Capped else: CtxCaptureCut.Whole,
        capture_max: capture
    )

fn _ctx_simple_binary() -> text:
    val env_bin = env_get("SIMPLE_BINARY") ?? ""
    if env_bin != "":
        return env_bin
    "bin/simple"

# Run `code` in `language`. `file_path` (may be "") is exposed to the code as
# `$1`/`$FILE` (shell), `process.argv[2]` (javascript) or the first CLI
# argument (simple). Returns nil + error text when the language is unknown.
pub fn ctx_execute_code(language: text, code: text, file_path: text, timeout: CtxTimeoutMs) -> (CtxExecResult?, text):
    val lang = language.lower().trim()
    val cap = ctx_capture_max_bytes()
    if lang == "shell" or lang == "sh" or lang == "bash" or lang == "":
        # `/bin/sh` does not exist as a literal path on Windows (this repo's
        # native Windows binary is not MSYS-path-translated), which made
        # every simple_ctx_execute(shell) spawn fail: process_run_observed_bounded
        # returns exit -1 / stderr "(empty)" when the executable itself is
        # missing. Resolve the shell the same way std.io.process_ops.shell()
        # does — SIMPLE_POSIX_SHELL override, then a PATH/install-location
        # scan for a real POSIX sh.exe (Git for Windows/MSYS/Cygwin) — and
        # only fail closed when none is found, rather than silently handing
        # POSIX-syntax code to cmd.exe.
        val cmd_text = "FILE=\"$1\"; export FILE; " + code
        val (sh_path, sh_prefix) = resolve_shell_argv(cmd_text)
        if not is_posix_shell_argv(sh_path):
            return (None, "no POSIX sh found for simple_ctx_execute(language: shell) on this host; " +
                "install Git for Windows (provides usr/bin/sh.exe) or set SIMPLE_POSIX_SHELL to a POSIX sh.exe path")
        var argv: [text] = sh_prefix
        argv.push("sh")
        if file_path != "":
            argv.push(file_path)
        return (Some(ctx_run_bounded(sh_path, argv, timeout, cap)), "")
    if lang == "javascript" or lang == "js" or lang == "node":
        if val missing = require_external_tool("simple_ctx_execute", "node", "Node.js"):
            return (None, missing)
        var argv: [text] = ["-e", code]
        if file_path != "":
            argv.push("--")
            argv.push(file_path)
        return (Some(ctx_run_bounded("node", argv, timeout, cap)), "")
    if lang == "simple" or lang == "spl":
        if not _ctx_ensure_dir():
            return (None, "cannot create " + ctx_store_dir())
        val tmp = ctx_store_dir() + "/exec_" + str(time_now_unix_micros()) + ".spl"
        if not file_write(tmp, code):
            return (None, "cannot write " + tmp)
        var argv: [text] = ["run", tmp]
        if file_path != "":
            argv.push(file_path)
        return (Some(ctx_run_bounded(_ctx_simple_binary(), argv, timeout, cap)), "")
    (None, "Unsupported language: " + language + " (use shell, javascript, or simple)")

# Smart truncation: keep whole lines from the head up to 60% of `cap` bytes
# and from the tail up to 40%, with `marker` as the line between them;
# returns a CtxTruncation (body, omitted_lines, omitted_bytes), omitted_lines == 0 when
# nothing was cut.
pub fn ctx_smart_truncate(stdout: text, limit: CtxByteCount, marker: text) -> CtxTruncation:
    val cap = limit.bytes
    if stdout.len() <= cap:
        return CtxTruncation(body: stdout, omitted_lines: CtxLineCount(count: 0), omitted_bytes: CtxByteCount(bytes: 0))
    val lines = stdout.split("\n")
    val n = lines.len()
    val head_budget = cap * 6 / 10
    val tail_budget = cap - head_budget
    var head_end = 0
    var used: i64 = 0
    while head_end < n and used + lines[head_end].len() + 1 <= head_budget:
        used = used + lines[head_end].len() + 1
        head_end = head_end + 1
    var tail_start = n
    used = 0
    while tail_start > head_end and used + lines[tail_start - 1].len() + 1 <= tail_budget:
        used = used + lines[tail_start - 1].len() + 1
        tail_start = tail_start - 1
    if tail_start <= head_end:
        return CtxTruncation(body: stdout, omitted_lines: CtxLineCount(count: 0), omitted_bytes: CtxByteCount(bytes: 0))
    var omitted_bytes: i64 = 0
    var i = head_end
    while i < tail_start:
        omitted_bytes = omitted_bytes + lines[i].len() + 1
        i = i + 1
    var out: [text] = []
    i = 0
    while i < head_end:
        out.push(lines[i])
        i = i + 1
    out.push(marker)
    i = tail_start
    while i < n:
        out.push(lines[i])
        i = i + 1
    CtxTruncation(body: out.join("\n"), omitted_lines: CtxLineCount(count: tail_start - head_end), omitted_bytes: CtxByteCount(bytes: omitted_bytes))

# Apply the return cap to an execute result: when the stdout exceeds
# `_CTX_RETURN_CAP_BYTES` the full text is indexed under `exec:<ts>` and the
# returned stdout is the head+tail with an annotation naming that source.
fn _ctx_with_stdout(r: CtxExecResult, stdout: text) -> CtxExecResult:
    CtxExecResult(stdout: stdout, stderr_summary: r.stderr_summary, exit_code: r.exit_code, timed_out: r.timed_out, wall_ms: r.wall_ms, raw_bytes: r.raw_bytes)

pub fn ctx_cap_exec_stdout(r: CtxExecResult) -> CtxExecResult:
    # A toolchain log optimizer runs BEFORE the size cap: dropping progress
    # noise routinely keeps the one real error INSIDE the cap instead of
    # leaving it past the truncation point. The raw text is what gets
    # indexed below, so a dropped line is still reachable by search.
    val raw = r.stdout
    val filtered = log_opt_optimize_recorded(raw)
    if filtered.len() <= _CTX_RETURN_CAP_BYTES:
        return _ctx_with_stdout(r, filtered)
    val source = "exec:" + str(time_now_unix_micros())
    val cut = ctx_smart_truncate(filtered, CtxByteCount(bytes: _CTX_RETURN_CAP_BYTES), "[...truncated: see below]")
    val kept = cut.body
    val omitted_lines = cut.omitted_lines.count
    val omitted_bytes = cut.omitted_bytes.bytes
    if omitted_lines == 0:
        return _ctx_with_stdout(r, filtered)
    val n = ctx_index_text(raw, source).count
    val note = "[...truncated — " + str(omitted_lines) + " line(s) / " + str(omitted_bytes) + " byte(s) omitted from the middle; full output indexed as " + str(n) + " chunk(s): simple_ctx_search(queries: [...], source: '" + source + "')]"
    _ctx_with_stdout(r, kept.replace("[...truncated: see below]", note))

fn ctx_format_exec(label: text, r: CtxExecResult) -> text:
    var head = "-- " + label + " (exit: " + str(r.exit_code.code) + ", " + str(r.wall_ms.ms) + "ms) --"
    if r.timed_out == CtxWallBudget.TimedOut:
        head = "TIMEOUT: " + label + " exceeded its wall budget (exit: " + str(r.exit_code.code) + ")"
    head + "\n" + r.stdout + "\n" + r.stderr_summary

# ---------------------------------------------------------------------------
# Tool handlers
# ---------------------------------------------------------------------------

pub fn handle_simple_ctx_index(id: text, body: text) -> text:
    val content = extract_field(body, "content")
    if content == "":
        return make_tool_error(id, -32602, "Missing required parameter: content")
    var source = extract_field(body, "source")
    if source == "":
        source = "manual:" + str(_ctx_now_secs())
    val n = ctx_index_text(content, source).count
    if n < 0:
        return make_tool_error(id, -32603, "simple_ctx_index: cannot write " + _ctx_chunks_path())
    val msg = "Indexed " + str(n) + " chunk(s) (" + str(content.len()) + " bytes) under source '" + source + "' in " + ctx_store_dir()
    tok_record(TOK_FEATURE_CTX, "simple_ctx_index", content.len(), msg.len(), false)
    make_tool_result(id, msg)

pub fn handle_simple_ctx_search(id: text, body: text) -> text:
    val queries = _ctx_queries(body)
    if queries.len() == 0:
        return make_tool_error(id, -32602, "Missing required parameter: queries (array) or query")
    val source = extract_field(body, "source")
    val limit = _ctx_int_param(body, "limit", _CTX_DEFAULT_LIMIT, _CTX_MAX_LIMIT)
    val index = _ctx_cached_index(source)
    var blocks: [text] = []
    for q in queries:
        blocks.push(ctx_format_hits(q, ctx_bm25_search_index(index, q, CtxResultLimit(count: limit))))
    val out = blocks.join("\n")
    _ctx_stats_bump("bytes_returned", out.len())
    _ctx_stats_bump("search_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_search", 0, out.len(), false)
    make_tool_result(id, out)

fn _ctx_exec_common(id: text, body: text, tool: text, file_path: text) -> text:
    val code = extract_field(body, "code")
    if code == "":
        return make_tool_error(id, -32602, "Missing required parameter: code")
    val language = extract_field(body, "language")
    val timeout_ms = _ctx_int_param(body, "timeout_ms", _CTX_DEFAULT_TIMEOUT_MS, _CTX_MAX_TIMEOUT_MS)
    val (result, err) = ctx_execute_code(language, code, file_path, CtxTimeoutMs(ms: timeout_ms))
    match result:
        Some(raw):
            val r = ctx_cap_exec_stdout(raw)
            _ctx_stats_bump("exec_calls", 1)
            _ctx_stats_bump("bytes_returned", r.stdout.len())
            val out = ctx_format_exec(tool, r)
            val tool_name = if tool.starts_with("simple_ctx_execute_file"): "simple_ctx_execute_file" else: "simple_ctx_execute"
            tok_record(TOK_FEATURE_CTX, tool_name, r.raw_bytes.bytes, out.len(), false)
            make_tool_result(id, out)
        None:
            make_tool_error(id, -32602, tool + ": " + err)

pub fn handle_simple_ctx_execute(id: text, body: text) -> text:
    _ctx_exec_common(id, body, "simple_ctx_execute", "")

pub fn handle_simple_ctx_execute_file(id: text, body: text) -> text:
    val path = extract_field(body, "path")
    if path == "":
        return make_tool_error(id, -32602, "Missing required parameter: path")
    if not file_exists(path):
        return make_tool_error(id, -32602, "simple_ctx_execute_file: no such file: " + path)
    _ctx_exec_common(id, body, "simple_ctx_execute_file " + path, path)

pub fn handle_simple_ctx_batch_execute(id: text, body: text) -> text:
    val commands = ctx_parse_string_array(extract_field_raw(body, "commands"))
    if commands.len() == 0:
        return make_tool_error(id, -32602, "Missing required parameter: commands (array)")
    val queries = _ctx_queries(body)
    var source = extract_field(body, "source")
    if source == "":
        source = "batch:" + str(_ctx_now_secs())
    val timeout_ms = _ctx_int_param(body, "timeout_ms", _CTX_DEFAULT_TIMEOUT_MS, _CTX_MAX_TIMEOUT_MS)
    val limit = _ctx_int_param(body, "limit", _CTX_DEFAULT_LIMIT, _CTX_MAX_LIMIT)
    val capture_max = _ctx_int_param(body, "capture_bytes", ctx_capture_max_bytes().bytes, _CTX_CAPTURE_HARD_MAX_BYTES)
    var lines: [text] = []
    lines.push("## batch: " + str(commands.len()) + " command(s) indexed under '" + source + "'")
    var idx = 0
    var total_bytes: i64 = 0
    for cmd in commands:
        val (sh_path, sh_args) = resolve_shell_argv(cmd)
        if not is_posix_shell_argv(sh_path):
            lines.push("[" + str(idx) + "] ERROR: no POSIX sh found for simple_ctx_batch_execute on this host; " +
                "install Git for Windows or set SIMPLE_POSIX_SHELL")
            idx = idx + 1
            continue
        val r = ctx_run_bounded(sh_path, sh_args, CtxTimeoutMs(ms: timeout_ms), CtxByteCount(bytes: capture_max))
        val label = source + "#" + str(idx)
        val text_out = "$ " + cmd + "\n" + r.stdout + "\n" + r.stderr_summary
        val n = ctx_index_text(text_out, label).count
        total_bytes = total_bytes + text_out.len()
        var status = "exit " + str(r.exit_code.code)
        if r.timed_out == CtxWallBudget.TimedOut:
            status = "TIMEOUT"
        var line = "[" + str(idx) + "] " + status + ", " + str(r.stdout.len()) + " stdout byte(s), " + str(n) + " chunk(s) -> source " + label
        if r.truncated == CtxCaptureCut.Capped:
            line = line + " [capture truncated at " + str(capture_max) + " bytes]"
        lines.push(line)
        idx = idx + 1
    lines.push("")
    if queries.len() == 0:
        lines.push("(no queries given — use simple_ctx_search with source '" + source + "')")
    else:
        # One store load + one normalization pass, shared by every query
        # (reused across calls while the store generation is unchanged).
        val index = _ctx_cached_index(source)
        for q in queries:
            lines.push(ctx_format_hits(q, ctx_bm25_search_index(index, q, CtxResultLimit(count: limit))))
    val out = lines.join("\n")
    _ctx_stats_bump("bytes_returned", out.len())
    _ctx_stats_bump("batch_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_batch_execute", total_bytes, out.len(), false)
    make_tool_result(id, out)

pub fn ctx_fetch_allowed_url(url: text) -> CtxUrlVerdict:
    if url.starts_with("http://") or url.starts_with("https://"):
        return CtxUrlVerdict.Allowed
    CtxUrlVerdict.Denied

# Plain-text extraction: strip tags, collapse blank runs. No script execution.
pub fn ctx_html_to_text(html: text) -> text:
    var stripped = strip_html_tags(html)
    stripped = stripped.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"")
    var out: [text] = []
    var blank_run = 0
    for line in stripped.split("\n"):
        val t = line.trim()
        if t == "":
            blank_run = blank_run + 1
            if blank_run > 1:
                continue
        else:
            blank_run = 0
        out.push(t)
    out.join("\n")

pub fn ctx_cap_bytes(s: text, limit: CtxByteCount) -> CtxCapped:
    val max_bytes = limit.bytes
    if s.len() <= max_bytes:
        return CtxCapped(body: s, verdict: CtxCapVerdict.Whole)
    CtxCapped(body: s.substring(0, max_bytes), verdict: CtxCapVerdict.Cut)

pub fn handle_simple_ctx_fetch_and_index(id: text, body: text) -> text:
    val url = extract_field(body, "url")
    if url == "":
        return make_tool_error(id, -32602, "Missing required parameter: url")
    if ctx_fetch_allowed_url(url) == CtxUrlVerdict.Denied:
        return make_tool_error(id, -32602, "simple_ctx_fetch_and_index: only http:// and https:// URLs are allowed")
    var source = extract_field(body, "source")
    if source == "":
        source = "web:" + url
    val max_bytes = _ctx_int_param(body, "max_bytes", _CTX_FETCH_DEFAULT_MAX_BYTES, _CTX_FETCH_HARD_MAX_BYTES)
    val (status_code, response_body, transport_error) = http_get_raw(url)
    if status_code < 0 or transport_error != "":
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: transport error: " + transport_error)
    if status_code < 200 or status_code >= 300:
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: HTTP " + str(status_code))
    val cap_result = ctx_cap_bytes(response_body, CtxByteCount(bytes: max_bytes))
    val raw = cap_result.body
    val capped = cap_result.verdict == CtxCapVerdict.Cut
    val plain = ctx_html_to_text(raw)
    val n = ctx_index_text(plain, source).count
    if n < 0:
        return make_tool_error(id, -32603, "simple_ctx_fetch_and_index: cannot write " + _ctx_chunks_path())
    var msg = "Fetched " + url + ": " + str(response_body.len()) + " byte(s)"
    if capped:
        msg = msg + " (capped to " + str(max_bytes) + ")"
    msg = msg + ", " + str(plain.len()) + " byte(s) of text, " + str(n) + " chunk(s) under source '" + source + "'"
    _ctx_stats_bump("fetch_calls", 1)
    tok_record(TOK_FEATURE_CTX, "simple_ctx_fetch_and_index", response_body.len(), msg.len(), false)
    make_tool_result(id, msg)

# ---------------------------------------------------------------------------
# Toolchain log optimizer (plugin engine lives in main_lazy_log_opt)
# ---------------------------------------------------------------------------

# With no `log` argument this lists the loaded plugin descriptors, so an
# operator can see what is installed without feeding it a build log.
pub fn handle_simple_log_optimize(id: text, body: text) -> text:
    val raw = extract_field(body, "log")
    if raw == "":
        return make_tool_result(id, log_opt_plugins_text())
    val (out, name, dropped) = log_opt_optimize(raw)
    if name == "":
        return make_tool_result(id, "[log-opt] no descriptor claimed this log; returned unchanged\n" + out)
    tok_record(LOG_OPT_FEATURE, "logopt:" + name, raw.len(), out.len(), false)
    make_tool_result(id, out)

fn _ctx_stat_get(d: Dict<text, i64>, k: text) -> i64:
    if d.contains_key(k):
        return d[k]
    0

pub fn ctx_stats_text() -> text:
    val chunks = _ctx_load_chunks()
    var sources: Dict<text, i64> = {}
    var stored_bytes: i64 = 0
    for c in chunks:
        stored_bytes = stored_bytes + c.bytes.bytes
        if sources.contains_key(c.source):
            sources[c.source] = sources[c.source] + 1
        else:
            sources[c.source] = 1
    val d = _ctx_load_stats()
    val indexed = _ctx_stat_get(d, "bytes_indexed")
    val returned = _ctx_stat_get(d, "bytes_returned")
    var saved = indexed - returned
    if saved < 0:
        saved = 0
    var lines: [text] = []
    lines.push("ctx store: " + ctx_store_dir())
    lines.push("chunks: " + str(chunks.len()))
    lines.push("sources: " + str(sources.len()))
    lines.push("stored_bytes: " + str(stored_bytes))
    lines.push("bytes_indexed: " + str(indexed))
    lines.push("bytes_returned: " + str(returned))
    lines.push("bytes_saved: " + str(saved))
    lines.push("capture_max_bytes: " + str(ctx_capture_max_bytes().bytes))
    lines.push("capture_truncations: " + str(_ctx_stat_get(d, "capture_truncations")))
    lines.push("calls: index=" + str(_ctx_stat_get(d, "index_calls")) + " search=" + str(_ctx_stat_get(d, "search_calls")) + " exec=" + str(_ctx_stat_get(d, "exec_calls")) + " batch=" + str(_ctx_stat_get(d, "batch_calls")) + " fetch=" + str(_ctx_stat_get(d, "fetch_calls")))
    # Token-savings telemetry (see simple_token_stats for the per-feature view).
    val tok = tok_rollup(tok_load_events(), TOK_FEATURE_CTX, _ctx_now_secs())
    lines.push("telemetry_calls: " + str(tok.calls))
    lines.push("telemetry_bytes_captured: " + str(tok.captured))
    lines.push("telemetry_bytes_returned: " + str(tok.returned))
    lines.push("telemetry_tokens_saved: " + str(tok.saved))
    lines.push("telemetry_tokens_saved_7d: " + str(tok.saved_7d))
    lines.join("\n")

pub fn handle_simple_ctx_stats(id: text, body: text) -> text:
    make_tool_result(id, ctx_stats_text())

# ---------------------------------------------------------------------------
# Doctor: self-check of the ctx store
# ---------------------------------------------------------------------------

const _CTX_HOOK_FILES: [text] = [
    ".claude/hooks/bash_net_blocker.shs",
    ".claude/hooks/bash_output_hint.shs",
    ".claude/hooks/webfetch_deny.shs",
    ".claude/hooks/read_analysis_hint.shs",
    ".claude/hooks/ctx_common.shs",
]

fn _ctx_check_line(ok: bool, label: text) -> text:
    if ok:
        return "[ok] " + label
    "[FAIL] " + label

# Chunks whose stored body is empty/whitespace-only — nothing a search can
# ever rank, left behind by an interrupted write or a since-fixed bug.
fn _ctx_count_orphans(chunks: [CtxChunk]) -> i64:
    var n: i64 = 0
    for c in chunks:
        if c.body.trim() == "":
            n = n + 1
    n

pub fn ctx_doctor_text() -> text:
    var lines: [text] = []
    val dir = ctx_store_dir()
    val dir_existed = file_exists(dir)
    val dir_ok = dir_existed or _ctx_ensure_dir()
    lines.push(_ctx_check_line(dir_ok, "store dir '" + dir + "' exists"))

    # Writable: round-trip a probe file through the atomic-write path, then
    # remove it — never leaves scratch state behind.
    val probe = dir + "/.doctor_probe"
    val write_ok = _ctx_write_atomic(probe, "probe")
    val read_ok = write_ok and file_exists(probe) and file_read(probe) == "probe"
    if file_exists(probe):
        file_delete(probe)
    lines.push(_ctx_check_line(read_ok, "store dir is writable (probe write+read+cleanup)"))

    val chunks = _ctx_load_chunks()
    lines.push("[ok] index row count: " + str(chunks.len()))

    val orphans = _ctx_count_orphans(chunks)
    lines.push(_ctx_check_line(orphans == 0, "orphan chunks (empty body): " + str(orphans)))

    val schema_ok = _ctx_detect_schema_version() == _CTX_SCHEMA_VERSION
    lines.push(_ctx_check_line(schema_ok, "chunk store schema is current (v" + str(_CTX_SCHEMA_VERSION) + "; run simple_ctx_upgrade if not)"))

    for hf in _CTX_HOOK_FILES:
        lines.push(_ctx_check_line(file_exists(hf), "hook file present: " + hf))

    lines.join("\n")

pub fn handle_simple_ctx_doctor(id: text, body: text) -> text:
    make_tool_result(id, ctx_doctor_text())

# ---------------------------------------------------------------------------
# Upgrade: re-index/compact the store
# ---------------------------------------------------------------------------

# The chunk file's schema is stamped in a header comment. A store written
# before this stamp existed (or by an older schema version) reads back as
# version 0 and gets rewritten below.
fn _ctx_detect_schema_version() -> i64:
    val path = _ctx_chunks_path()
    if not file_exists(path):
        return _CTX_SCHEMA_VERSION
    # The stamp lives in the header comment: read a bounded head, never the
    # whole (multi-MB) chunk store. A short file simply returns fewer bytes.
    # A 256-byte cut can land inside a multi-byte char (strict decode fails);
    # back off up to 3 bytes so a valid UTF-8 prefix is always found.
    var head = ""
    var got = false
    var n = 256
    while n >= 253:
        match file_read_text_at(path, 0, n):
            case Ok(t):
                head = t
                got = true
                n = 0
            case Err(_):
                n = n - 1
    if not got:
        # Positioned reads are unavailable on some hosts (native status -38,
        # ENOSYS): fall back to a whole-file read; the header check below is
        # unchanged, only the cost differs.
        head = file_read(path)
    val stamp = "# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION)
    var seen = 0
    for line in head.split("\n"):
        if seen >= 4:
            break
        if line.trim() == stamp:
            return _CTX_SCHEMA_VERSION
        seen = seen + 1
    0

# Public accessor for specs — mirrors _ctx_detect_schema_version.
pub fn ctx_schema_version() -> CtxSchemaVersion:
    CtxSchemaVersion(version: _ctx_detect_schema_version())

# Rewrites the chunk store under the current schema: drops orphan (empty-body)
# rows and re-stamps the schema header. Returns (before_count, after_count,
# before_version).
pub fn ctx_upgrade_store() -> CtxUpgradeReport:
    val before = _ctx_load_chunks()
    val before_version = _ctx_detect_schema_version()
    val before_count = before.len()
    var kept: [CtxChunk] = []
    for c in before:
        if c.body.trim() != "":
            kept.push(c)
    _ctx_ensure_dir()
    var lines: [text] = []
    lines.push("# ctx chunk store — written by simple_ctx_* MCP tools. Do not edit by hand.\n")
    lines.push("# ctx_schema_version: " + str(_CTX_SCHEMA_VERSION) + "\n")
    lines.push("ctx_chunks | id, source, ts, bytes, text |\n")
    for c in kept:
        lines.push(_ctx_chunk_line(c))
    _ctx_write_atomic(_ctx_chunks_path(), lines.join(""))
    CtxUpgradeReport(before_count: CtxChunkCount(count: before_count), after_count: CtxChunkCount(count: kept.len()), before_version: CtxSchemaVersion(version: before_version))

pub fn handle_simple_ctx_upgrade(id: text, body: text) -> text:
    val report = ctx_upgrade_store()
    val before_count = report.before_count.count
    val after_count = report.after_count.count
    val before_version = report.before_version.version
    var msg = "ctx upgrade: schema v" + str(before_version) + " -> v" + str(_CTX_SCHEMA_VERSION) + ", chunks " + str(before_count) + " -> " + str(after_count)
    if before_count != after_count:
        msg = msg + " (" + str(before_count - after_count) + " orphan/empty chunk(s) dropped)"
    _ctx_stats_bump("upgrade_calls", 1)
    make_tool_result(id, msg)

# ---------------------------------------------------------------------------
# Purge (retention) — explicit, dry-run by default, never implicit
# ---------------------------------------------------------------------------

# How one purge attempt ended. Contended: an append moved the store under every
# attempt and nothing was deleted. Unchanged: dry run, nothing to drop, or write failed.
pub enum CtxPurgeOutcome:
    Unchanged
    Rewritten
    Contended

struct CtxPurgeReport:
    check: CtxPolicyCheck
    mode: CtxPurgeMode
    plan: CtxRetentionPlan
    outcome: CtxPurgeOutcome

# Everything one purge attempt read: the chunks, the generation key they were
# read under, and the plan decided from them.
pub struct CtxPurgeSnapshot:
    chunks: [CtxChunk]
    key: CtxGenerationKey
    plan: CtxRetentionPlan
    check: CtxPolicyCheck

pub enum CtxPurgeCommit:
    Committed
    NothingToDrop
    StoreMoved       # the store changed since the snapshot; nothing written
    WriteFailed

# Attempts before a purge gives up and fails closed under sustained appends.
const _CTX_PURGE_MAX_ATTEMPTS: i64 = 4

# Tail-replay rounds one commit makes before reporting StoreMoved.
const _CTX_PURGE_REPLAY_MAX_ROUNDS: i64 = 8

fn _ctx_retention_rows(chunks: [CtxChunk]) -> [CtxRetentionRow]:
    var rows: [CtxRetentionRow] = []
    for c in chunks:
        rows.push(ctx_retention_row(c.id, CtxSourceLabel(value: c.source), c.ts, c.bytes))
    rows

# Apply `policy` to the store. `DryRun` never writes. `Apply` rewrites the
# store atomically with only the kept chunks; the next search sees a new
# generation key and rebuilds its index. Chunk ids are never reused (the
# next_id high-water mark lives in stats.sdn).
#
# Lock-free against concurrent appends: the purge is a compare-and-swap on the
# store generation key. It reads the key BEFORE the chunks (so a racing append
# can only make the chunks newer than the key), decides from that snapshot, and
# re-reads the key immediately before the atomic rename; only an unchanged key
# commits. A moved store is re-snapshotted (an append that completed before the
# commit is therefore always included in what is kept); after
# `_CTX_PURGE_MAX_ATTEMPTS` moved attempts the purge fails closed with nothing
# deleted. After writing the temp file the purge replays the tail: it re-reads
# the store, appends every complete row (by serialized line) it has not carried (appended since its
# snapshot; new rows are always kept) to the temp file, and repeats until a read
# finds nothing new and an unchanged size (bounded; else StoreMoved, nothing
# deleted). Appenders verify row presence after writing and re-apply if absent.
# Residual window (narrowed to a preemption gap, NOT closed): the rename in
# `ctx_purge_commit` follows the final stable read with no OS compare-and-rename
# (std.io_runtime exposes only unconditional `file_rename` and the create-only
# `file_hardlink`, neither can replace-if-unchanged). An append whose write AND
# presence check both land between that last read and the rename is lost.
# Unblock: an OS rename-if-unchanged primitive (or renameat2 RENAME_EXCHANGE
# plus a post-swap tail drain). See
# doc/08_tracking/bug/trace_plan_2026_11_14_remaining_gaps_2026-11-16.md.
pub fn ctx_purge_snapshot(policy: CtxRetentionPolicy) -> CtxPurgeSnapshot:
    val key = _ctx_store_generation_key()
    val chunks = _ctx_load_complete_chunks()
    val plan = ctx_retention_decide(_ctx_retention_rows(chunks), policy, CtxUnixSecs(secs: _ctx_now_secs()))
    CtxPurgeSnapshot(chunks: chunks, key: key, plan: plan, check: ctx_retention_check(policy))

# Commit a snapshot's plan iff the store is still exactly the generation the
# snapshot was read under.
pub fn ctx_purge_commit(snap: CtxPurgeSnapshot) -> CtxPurgeCommit:
    if snap.plan.drop.len() == 0:
        return CtxPurgeCommit.NothingToDrop
    match ctx_cache_decide(Some(snap.key), _ctx_store_generation_key()):
        case CtxCacheDecision.Hit:
            pass
        case _:
            return CtxPurgeCommit.StoreMoved
    var dropped_ids: Dict<i64, bool> = {}
    for d in snap.plan.drop:
        dropped_ids[d.value] = true
    # Replay dedupes on the full serialized row, not the id: ids come from an
    # unlocked read-modify-write of stats.sdn, so two processes can share one.
    var seen: Dict<text, bool> = {}
    var lines: [text] = [_ctx_store_header()]
    for c in snap.chunks:
        seen[_ctx_chunk_line(c)] = true
        if not dropped_ids.contains_key(c.id.value):
            lines.push(_ctx_chunk_line(c))
    val path = _ctx_chunks_path()
    val tmp = path + ".purge." + str(time_now_unix_micros()) + ".tmp"
    if not file_write(tmp, lines.join("")):
        return CtxPurgeCommit.WriteFailed
    var last_size: i64 = -1
    var round = 0
    while round < _CTX_PURGE_REPLAY_MAX_ROUNDS:
        ctx_purge_observer_fire()
        val size = file_size_signed(path)
        var tail: [text] = []
        for c in _ctx_load_complete_chunks():
            val line = _ctx_chunk_line(c)
            if not seen.contains_key(line):
                seen[line] = true
                tail.push(line)
        if tail.len() == 0 and size == last_size:
            if file_rename(tmp, path):
                return CtxPurgeCommit.Committed
            file_delete(tmp)
            return CtxPurgeCommit.WriteFailed
        if tail.len() > 0 and not file_append_text(tmp, tail.join("")):
            file_delete(tmp)
            return CtxPurgeCommit.WriteFailed
        last_size = size
        round = round + 1
    file_delete(tmp)
    CtxPurgeCommit.StoreMoved

pub fn ctx_purge_store(policy: CtxRetentionPolicy, mode: CtxPurgeMode) -> CtxPurgeReport:
    var snap = ctx_purge_snapshot(policy)
    match mode:
        case CtxPurgeMode.DryRun:
            return CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Unchanged)
        case CtxPurgeMode.Apply:
            var attempt = 1
            while true:
                match ctx_purge_commit(snap):
                    case CtxPurgeCommit.Committed:
                        return CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Rewritten)
                    case CtxPurgeCommit.NothingToDrop:
                        return CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Unchanged)
                    case CtxPurgeCommit.WriteFailed:
                        return CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Unchanged)
                    case CtxPurgeCommit.StoreMoved:
                        if attempt >= _CTX_PURGE_MAX_ATTEMPTS:
                            return CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Contended)
                        attempt = attempt + 1
                        snap = ctx_purge_snapshot(policy)
    CtxPurgeReport(check: snap.check, mode: mode, plan: snap.plan, outcome: CtxPurgeOutcome.Unchanged)

fn _ctx_opt_int(body: text, key: text) -> i64?:
    val raw = extract_field(body, key)
    if raw == "":
        return None
    val n = raw.trim().parse_int() ?? 0
    Some(n)

pub fn handle_simple_ctx_purge(id: text, body: text) -> text:
    var source: CtxSourceLabel? = None
    val src_raw = extract_field(body, "source")
    if src_raw != "":
        source = Some(CtxSourceLabel(value: src_raw))
    var age: CtxAgeLimit? = None
    val age_raw = _ctx_opt_int(body, "older_than_secs")
    if age_raw.?:
        age = Some(CtxAgeLimit(secs: age_raw.unwrap()))
    var cap: CtxByteCount? = None
    val cap_raw = _ctx_opt_int(body, "max_bytes")
    if cap_raw.?:
        cap = Some(CtxByteCount(bytes: cap_raw.unwrap()))
    val policy = ctx_retention_policy(source, age, cap)
    val check_label = ctx_policy_check_label(ctx_retention_check(policy))
    if check_label != "valid":
        return make_tool_error(id, -32602, "simple_ctx_purge: refused (" + check_label + "). Name what to purge: source (label prefix), older_than_secs (>0) and/or max_bytes (>0). Nothing was deleted.")
    var mode = CtxPurgeMode.DryRun
    if extract_field(body, "apply") == "true":
        mode = CtxPurgeMode.Apply
    val report = ctx_purge_store(policy, mode)
    val n_drop = report.plan.drop.len()
    var msg = ""
    match report.mode:
        case CtxPurgeMode.DryRun:
            msg = "ctx purge DRY RUN: would drop " + str(n_drop) + " chunk(s) (" + str(report.plan.dropped.bytes) + " bytes), keep " + str(report.plan.keep.len()) + ". Pass apply:true to delete."
        case CtxPurgeMode.Apply:
            if n_drop == 0:
                msg = "ctx purge: nothing matched; store unchanged (" + str(report.plan.keep.len()) + " chunk(s))"
            elif report.outcome == CtxPurgeOutcome.Rewritten:
                msg = "ctx purge: dropped " + str(n_drop) + " chunk(s) (" + str(report.plan.dropped.bytes) + " bytes), kept " + str(report.plan.keep.len())
                _ctx_stats_bump("purge_calls", 1)
            elif report.outcome == CtxPurgeOutcome.Contended:
                return make_tool_error(id, -32603, "simple_ctx_purge: the store kept changing under concurrent appends; nothing was deleted. Retry.")
            else:
                return make_tool_error(id, -32603, "simple_ctx_purge: cannot rewrite " + _ctx_chunks_path() + "; nothing was deleted")
    make_tool_result(id, msg)

