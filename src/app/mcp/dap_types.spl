    DebugBootstrapPlan,
    debug_arch_from_text,
    debug_exec_mode_from_text,
    debug_transport_from_text,
    debug_transport_from_target_type,
    debug_vendor_for_transport,
    debug_exec_mode_for_target_type,
    debug_probe_kind_default,
    debug_server_kind_default,
    debug_target_descriptor,
    debug_extension_registry_entries,
    debug_backend_catalog,
    debug_select_backend,
    debug_bootstrap_plan
