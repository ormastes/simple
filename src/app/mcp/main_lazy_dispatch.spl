use .main_lazy_json
# Lightweight lazy dispatch bridge for src/app/mcp/main.spl.
# Module scope imports only .main_lazy_json so CLI flags (--help/--version/--json)
# and initialize/ping/shutdown avoid parsing or loading main_dispatch,
# main_static_tools, tool_table, or main_lazy_protocol in interpreter startup.
# Every function-local `use` below uses an absolute `app.mcp.*` path.

pub fn mcp_lazy_dispatch_tool(id: text, tool_name: text, args_raw: text) -> text:
    use app.mcp.main_dispatch.{dispatch_tool}
    dispatch_tool(id, tool_name, args_raw)

pub fn mcp_lazy_static_tools_result_cached() -> text:
    use app.mcp.main_static_tools.{_mcp_static_tools_result_cached}
    _mcp_static_tools_result_cached()

pub fn mcp_lazy_tools_list_json_for_set(set_name: text) -> text:
    use app.mcp.main_static_tools.{_mcp_tools_list_json_for_set}
    _mcp_tools_list_json_for_set(set_name)

@allow(primitive_api)  # Probe boundary: forwards _mcp_probe_tool_count() integer tally
pub fn mcp_lazy_probe_tool_count() -> i64:
    use app.mcp.main_static_tools.{_mcp_probe_tool_count}
    _mcp_probe_tool_count()

pub fn mcp_lazy_handle_resources_list(id: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_resources_list(id)

pub fn mcp_lazy_handle_resource_templates_list(id: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_resource_templates_list(id)

pub fn mcp_lazy_handle_resources_read(id: text, uri: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_resources_read(id, uri)

pub fn mcp_lazy_handle_prompts_list(id: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_prompts_list(id)

pub fn mcp_lazy_handle_prompts_get(id: text, prompt_name: text, body: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_prompts_get(id, prompt_name, body)

pub fn mcp_lazy_handle_completion_req(id: text, body: text) -> text:
    use app.mcp.main_lazy_protocol
    handle_completion_req(id, body)

pub fn mcp_lazy_get_cwd() -> text:
    use app.mcp.main_lazy_protocol
    get_cwd()
