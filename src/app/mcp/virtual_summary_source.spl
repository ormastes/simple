# MCP registration seam. Protocol handlers receive this only from cache startup.

use compiler.common.cache_contract.virtual_source_store_v1.{SummaryAuthV1, VirtualSourceStoreV1}
use compiler.common.cache_contract.virtual_source_consumer_v1.{VirtualSourceConsumerAdapterV1, mcp_virtual_source_v1}

pub fn inject_mcp_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    mcp_virtual_source_v1(store, auth, snapshot)
