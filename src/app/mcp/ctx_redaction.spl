# Context capture redaction — pure secret masking applied BEFORE storage.
#
# Plan §3.4/§3.6: the ctx store keeps "metadata and bounded text chunks, not ...
# secrets" and credentials must be redacted before durable capture. This module
# masks secret-looking values in content about to be chunked and indexed; the
# raw text is never written. It masks:
#
#   * HTTP credential headers: Authorization / Proxy-Authorization (the scheme
#     word Bearer/Basic/... is kept), X-Api-Key, Cookie, Set-Cookie;
#   * `key=value`, `key: value` and JSON `"key": "value"` pairs whose key names
#     a password, secret, token or API/access/private key;
#   * well-known token shapes anywhere in a line: GitHub (`ghp_`, `gho_`,
#     `ghu_`, `ghs_`, `ghr_`, `github_pat_`), `sk-` API keys, AWS `AKIA` ids,
#     Slack `xox?-`, Google `AIza`, and JWTs (`eyJ` + two dots);
#   * `scheme://user:password@host` URL credentials;
#   * PEM private-key blocks (the whole block).
#
# NOT masked, by design: ordinary prose, identifiers such as `max_tokens` or
# `tokenizer`, and bare hex digests (SHA-256, git object ids) — a digest names
# content, it does not grant access, and masking them would break the store's
# own references. A bare high-entropy string with no key name or known prefix
# is likewise left alone; the rules are explicit rather than entropy-based so a
# false positive cannot silently corrupt captured evidence.
#
# Common path: content with none of the trigger words is returned untouched
# after a handful of native `contains` calls — no per-line work. Triggered
# lines use native `index_of`/`substring` only, with a bounded per-character
# check on token bodies. A line whose lowercase form changes byte length
# (non-ASCII case folding) cannot be sliced safely, so it is masked whole:
# redaction fails closed.
#
# No I/O.

# Raw content about to be stored.
struct CtxRawContent:
    body: text

# How many values/blocks were masked.
struct CtxMaskCount:
    count: i64

struct CtxRedacted:
    body: text
    masked: CtxMaskCount

const _CTX_MASK: text = "[REDACTED]"
const _CTX_MASK_LINE: text = "[REDACTED LINE]"
const _CTX_MASK_KEY_BLOCK: text = "[REDACTED PRIVATE KEY]"
const _CTX_TOKEN_MAX_SCAN: i64 = 512
const _CTX_B64URL: text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
const _CTX_WORDCHARS: text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
const _CTX_UPPER_DIGITS: text = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
const _CTX_VALUE_END: [text] = [" ", "\t", "\r", "\"", "'", ",", ";", "&", "}", ")", "<", ">", "`"]
const _CTX_TOKEN_END: [text] = [" ", "\t", "\r", "\"", "'", ",", ";", "&", "}", ")", "(", "<", ">", "`", "/", ":", "=", "\\"]

# key names whose value is masked; value must be at least this long
const _CTX_KV_KEYS: [text] = ["password", "passwd", "secret", "token", "api_key", "apikey", "api-key", "access_key", "private_key", "credential"]
const _CTX_KV_STRONG: [text] = ["password", "passwd", "secret"]
const _CTX_KV_MIN_STRONG: i64 = 1
const _CTX_KV_MIN_WEAK: i64 = 8

const _CTX_HEADERS: [text] = ["authorization", "proxy-authorization", "x-api-key", "cookie", "set-cookie"]
const _CTX_SCHEMES: [text] = ["bearer ", "basic ", "token ", "digest ", "negotiate "]

# (prefix, minimum total token length) — all prefixes are matched case-sensitively
const _CTX_PREFIXES: [text] = ["ghp_", "gho_", "ghu_", "ghs_", "ghr_", "github_pat_", "sk-", "xoxb-", "xoxa-", "xoxp-", "xoxr-", "xoxs-", "AIza"]
const _CTX_PREFIX_MIN: [i64] = [30, 30, 30, 30, 30, 40, 23, 15, 15, 15, 15, 15, 39]

pub fn ctx_raw_content(body: text) -> CtxRawContent:
    CtxRawContent(body: body)

pub fn ctx_mask_text() -> text:
    _CTX_MASK

fn _ctx_any_contains(hay: text, needles: [text]) -> bool:
    for n in needles:
        if hay.contains(n):
            return true
    false

fn _ctx_all_in(s: text, allowed: text) -> bool:
    var i = 0
    val n = s.byte_len()
    while i < n:
        if not allowed.contains(s.substring(i, i + 1)):
            return false
        i = i + 1
    true

# First index >= from of any terminator, or the line length.
fn _ctx_end_at(line: text, from: i64, terms: [text]) -> i64:
    var best = line.byte_len()
    for t in terms:
        val p = line.index_of(t, from) ?? -1
        if p >= 0 and p < best:
            best = p
    best

fn _ctx_prev_is_word(line: text, pos: i64) -> bool:
    if pos <= 0:
        return false
    _CTX_WORDCHARS.contains(line.substring(pos - 1, pos))

# ---- key=value --------------------------------------------------------------

# Start of the value after `key` ending at `after`, or -1 when no `=`/`:`
# separator follows. Allows a closing quote, spaces, the separator, spaces and
# an opening quote.
fn _ctx_value_start(line: text, after: i64) -> i64:
    var i = after
    val n = line.byte_len()
    if i < n and (line.substring(i, i + 1) == "\"" or line.substring(i, i + 1) == "'"):
        i = i + 1
    while i < n and line.substring(i, i + 1) == " ":
        i = i + 1
    if i >= n:
        return -1
    val sep = line.substring(i, i + 1)
    if sep != "=" and sep != ":":
        return -1
    i = i + 1
    while i < n and line.substring(i, i + 1) == " ":
        i = i + 1
    if i < n and (line.substring(i, i + 1) == "\"" or line.substring(i, i + 1) == "'"):
        i = i + 1
    i

fn _ctx_mask_kv_key(line0: text, key: text, min_len: i64) -> (text, i64):
    var line = line0
    var masked: i64 = 0
    var pos = 0
    while pos < line.byte_len():
        val low = line.lower()
        val p = low.index_of(key, pos) ?? -1
        if p < 0:
            break
        val after = p + key.byte_len()
        val v = _ctx_value_start(line, after)
        if v < 0:
            pos = after
            continue
        val e = _ctx_end_at(line, v, _CTX_VALUE_END)
        val value = line.substring(v, e)
        if value.byte_len() >= min_len and not value.starts_with("[REDACTED"):
            line = line.substring(0, v) + _CTX_MASK + line.substring(e)
            masked = masked + 1
            pos = v + _CTX_MASK.byte_len()
        else:
            pos = after
    (line, masked)

# ---- HTTP credential headers ------------------------------------------------

fn _ctx_mask_header(line: text, low: text, name: text) -> (text, i64):
    val p = low.index_of(name, 0) ?? -1
    if p < 0:
        return (line, 0)
    if _ctx_prev_is_word(line, p):
        return (line, 0)
    var i = p + name.byte_len()
    while i < line.byte_len() and line.substring(i, i + 1) == " ":
        i = i + 1
    if i >= line.byte_len() or line.substring(i, i + 1) != ":":
        return (line, 0)
    i = i + 1
    while i < line.byte_len() and line.substring(i, i + 1) == " ":
        i = i + 1
    if i >= line.byte_len():
        return (line, 0)
    var start = i
    val rest_low = low.substring(i)
    for sc in _CTX_SCHEMES:
        if rest_low.starts_with(sc):
            start = i + sc.byte_len()
    if start >= line.byte_len() or line.substring(start).starts_with("[REDACTED"):
        return (line, 0)
    (line.substring(0, start) + _CTX_MASK, 1)

# ---- token shapes ------------------------------------------------------------

fn _ctx_mask_prefixed(line0: text, prefix: text, min_len: i64) -> (text, i64):
    var line = line0
    var masked: i64 = 0
    var pos = 0
    while pos < line.byte_len():
        val p = line.index_of(prefix, pos) ?? -1
        if p < 0:
            break
        if _ctx_prev_is_word(line, p):
            pos = p + prefix.byte_len()
            continue
        var e = _ctx_end_at(line, p, _CTX_TOKEN_END)
        if e - p > _CTX_TOKEN_MAX_SCAN:
            e = p + _CTX_TOKEN_MAX_SCAN
        val tok = line.substring(p, e)
        if tok.byte_len() >= min_len and _ctx_all_in(tok, _CTX_B64URL):
            line = line.substring(0, p) + _CTX_MASK + line.substring(e)
            masked = masked + 1
            pos = p + _CTX_MASK.byte_len()
        else:
            pos = p + prefix.byte_len()
    (line, masked)

fn _ctx_mask_aws(line0: text) -> (text, i64):
    var line = line0
    var masked: i64 = 0
    var pos = 0
    while pos < line.byte_len():
        val p = line.index_of("AKIA", pos) ?? -1
        if p < 0:
            break
        val e = p + 20
        if e <= line.byte_len() and not _ctx_prev_is_word(line, p) and _ctx_all_in(line.substring(p, e), _CTX_UPPER_DIGITS) and (e == line.byte_len() or not _CTX_WORDCHARS.contains(line.substring(e, e + 1))):
            line = line.substring(0, p) + _CTX_MASK + line.substring(e)
            masked = masked + 1
            pos = p + _CTX_MASK.byte_len()
        else:
            pos = p + 4
    (line, masked)

fn _ctx_mask_jwt(line0: text) -> (text, i64):
    var line = line0
    var masked: i64 = 0
    var pos = 0
    while pos < line.byte_len():
        val p = line.index_of("eyJ", pos) ?? -1
        if p < 0:
            break
        if _ctx_prev_is_word(line, p):
            pos = p + 3
            continue
        var e = _ctx_end_at(line, p, _CTX_TOKEN_END)
        # a JWT's dots are not terminators: extend over `.`-joined segments
        while e < line.byte_len() and line.substring(e, e + 1) == ".":
            e = _ctx_end_at(line, e + 1, _CTX_TOKEN_END)
        if e - p > _CTX_TOKEN_MAX_SCAN:
            e = p + _CTX_TOKEN_MAX_SCAN
        val tok = line.substring(p, e)
        val dots = tok.split(".").len() - 1
        if tok.byte_len() >= 30 and dots == 2 and _ctx_all_in(tok.replace(".", "_"), _CTX_B64URL):
            line = line.substring(0, p) + _CTX_MASK + line.substring(e)
            masked = masked + 1
            pos = p + _CTX_MASK.byte_len()
        else:
            pos = p + 3
    (line, masked)

# scheme://user:password@host  ->  scheme://user:[REDACTED]@host
fn _ctx_mask_url_credentials(line0: text) -> (text, i64):
    var line = line0
    var masked: i64 = 0
    var pos = 0
    while pos < line.byte_len():
        val s = line.index_of("://", pos) ?? -1
        if s < 0:
            break
        val host_start = s + 3
        val at = line.index_of("@", host_start) ?? -1
        val stop = _ctx_end_at(line, host_start, ["/", " ", "\t", "\"", "'", "?"])
        if at >= 0 and at < stop:
            val userinfo = line.substring(host_start, at)
            val colon = userinfo.index_of(":", 0) ?? -1
            if colon > 0 and colon < userinfo.byte_len() - 1 and userinfo.substring(colon + 1) != _CTX_MASK:
                line = line.substring(0, host_start + colon + 1) + _CTX_MASK + line.substring(at)
                masked = masked + 1
        pos = host_start
    (line, masked)

# ---- driver -----------------------------------------------------------------

# Triggers present anywhere in the content (lowercased for key/header names,
# raw for the case-sensitive prefixes). Lines are only examined for these.
struct CtxActiveRules:
    kv: [text]
    headers: [text]
    prefixes: [i64]
    aws: bool
    jwt: bool
    url: bool
    pem: bool

fn _ctx_active(content: text, low: text) -> CtxActiveRules:
    var kv: [text] = []
    for k in _CTX_KV_KEYS:
        if low.contains(k):
            kv.push(k)
    var headers: [text] = []
    for h in _CTX_HEADERS:
        if low.contains(h):
            headers.push(h)
    var prefixes: [i64] = []
    var i = 0
    while i < _CTX_PREFIXES.len():
        if content.contains(_CTX_PREFIXES[i]):
            prefixes.push(i)
        i = i + 1
    CtxActiveRules(kv: kv, headers: headers, prefixes: prefixes, aws: content.contains("AKIA"), jwt: content.contains("eyJ"), url: content.contains("://") and content.contains("@"), pem: content.contains("-----BEGIN "))

# Cheap per-line gate: does this line contain any trigger that is active for
# the content? Most lines of a large capture contain none.
fn _ctx_line_triggers(line: text, low: text, act: CtxActiveRules) -> bool:
    if _ctx_any_contains(low, act.kv) or _ctx_any_contains(low, act.headers):
        return true
    for pi in act.prefixes:
        if line.contains(_CTX_PREFIXES[pi]):
            return true
    if act.aws and line.contains("AKIA"):
        return true
    if act.jwt and line.contains("eyJ"):
        return true
    act.url and line.contains("://") and line.contains("@")

fn _ctx_redact_line(line0: text, act: CtxActiveRules) -> (text, i64):
    var line = line0
    var n: i64 = 0
    val low0 = line.lower()
    if not _ctx_line_triggers(line, low0, act):
        return (line, 0)
    if low0.byte_len() != line.byte_len() and (_ctx_any_contains(low0, act.kv) or _ctx_any_contains(low0, act.headers)):
        # cannot slice by lowercase offsets safely: fail closed
        return (_CTX_MASK_LINE, 1)
    for h in act.headers:
        val r = _ctx_mask_header(line, line.lower(), h)
        line = r.0
        n = n + r.1
    for k in act.kv:
        var min_len = _CTX_KV_MIN_WEAK
        if _ctx_any_contains(k, _CTX_KV_STRONG):
            min_len = _CTX_KV_MIN_STRONG
        val r = _ctx_mask_kv_key(line, k, min_len)
        line = r.0
        n = n + r.1
    for pi in act.prefixes:
        val r = _ctx_mask_prefixed(line, _CTX_PREFIXES[pi], _CTX_PREFIX_MIN[pi])
        line = r.0
        n = n + r.1
    if act.aws:
        val r = _ctx_mask_aws(line)
        line = r.0
        n = n + r.1
    if act.jwt:
        val r = _ctx_mask_jwt(line)
        line = r.0
        n = n + r.1
    if act.url:
        val r = _ctx_mask_url_credentials(line)
        line = r.0
        n = n + r.1
    (line, n)

pub fn ctx_redact(raw: CtxRawContent) -> CtxRedacted:
    val content = raw.body
    val act = _ctx_active(content, content.lower())
    if act.kv.len() == 0 and act.headers.len() == 0 and act.prefixes.len() == 0 and not act.aws and not act.jwt and not act.url and not act.pem:
        return CtxRedacted(body: content, masked: CtxMaskCount(count: 0))
    var out: [text] = []
    var total: i64 = 0
    var in_pem = false
    for line in content.split("\n"):
        if in_pem:
            if line.contains("-----END "):
                in_pem = false
            continue
        if act.pem and line.contains("-----BEGIN ") and line.contains("PRIVATE KEY-----"):
            in_pem = not line.contains("-----END ")
            out.push(_CTX_MASK_KEY_BLOCK)
            total = total + 1
            continue
        val r = _ctx_redact_line(line, act)
        out.push(r.0)
        total = total + r.1
    CtxRedacted(body: out.join("\n"), masked: CtxMaskCount(count: total))
