use .main_lazy_json
use .main_session_state
use std.io_runtime.{file_read, file_write, dir_create_all}
use std.nogc_sync_mut.sffi.fs.{path_dirname}
use std.nogc_sync_mut.storage_roots.tooling_paths.{tooling_workspace_path}

fn editor_mcp_state_path() -> text:
    val path = tooling_workspace_path("mcp-editor", "shared", "active-buffer.txt")
    if path.is_err():
        return ""
    dir_create_all(path_dirname(path.unwrap().value))
    path.unwrap().value

# `body` is already the tools/call `arguments` object: main.spl extracts
# `params.arguments` before dispatch (main.spl:400-402), so the argument
# fields live at the top level of `body`, not under a nested `params` key.
fn editor_mcp_argument(body: text, name: text) -> text:
    extract_field(body, name)

fn handle_editor_mcp_open_file(id: text, body: text) -> text:
    val path = editor_mcp_argument(body, "path")
    if path == "":
        return make_tool_error(id, -32602, "missing path argument")
    val state_path = editor_mcp_state_path()
    if state_path == "":
        return make_tool_error(id, -32603, "centralized worktree storage is unavailable")
    val _ = file_write(state_path, path)
    mcp_record_last_read(path)
    make_tool_result(id, "opened " + path)

fn handle_editor_mcp_read_buffer(id: text, body: text) -> text:
    val state_path = editor_mcp_state_path()
    if state_path == "":
        return make_tool_error(id, -32603, "centralized worktree storage is unavailable")
    val path = file_read(state_path).trim()
    if path == "":
        return make_tool_error(id, -32602, "no active buffer")
    mcp_record_last_read(path)
    make_tool_result(id, file_read(path))

fn handle_editor_mcp_list_open_files(id: text, body: text) -> text:
    val state_path = editor_mcp_state_path()
    if state_path == "":
        return make_tool_error(id, -32603, "centralized worktree storage is unavailable")
    val path = file_read(state_path).trim()
    make_tool_result(id, path)
