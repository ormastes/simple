# Thin unbound MCP envelope adapter; loaded at the source request boundary.
use .main_lazy_json.{make_tool_result_status, make_error_response}
use std.common.string_core.{str_len}
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_object_from, json_value_serialize}
use std.common.source.service_contracts.{SourceOpenResultV1}
use app.source_view.service.{source_open_result_v1}
export use app.source_view.service.{source_relative_path_valid_v1, source_projection_payload_v1}

pub fn source_rpc_id_valid_v1(id: text) -> bool:
    # Admit the serialized wire scalar before parsing or echoing it.
    if str_len(id) > 128: return false
    match json_parse_value_strict(id):
        Ok(value):
            match value:
                JsonValue.Null: true
                JsonValue.Str(_): true
                JsonValue.Int(_): true
                JsonValue.Float(_): true
                _: false
        Err(_): false

fn source_rpc_id_error_v1() -> text:
    make_error_response("null", -32600, "Invalid or oversized source request id")

fn mcp_source_wrap_result_v1(id: text, result: SourceOpenResultV1) -> text:
    if not source_rpc_id_valid_v1(id): return source_rpc_id_error_v1()
    val response = make_tool_result_status(id, result.payload, result.is_error)
    if str_len(response) > 16384:
        val error = json_value_object_from([
            ("status", JsonValue.Str("error")),
            ("completeness", JsonValue.Str("not_evaluated")),
            ("reason", JsonValue.Str("serialized_response_exceeds_budget; reduce max_bytes or max_nodes"))])
        return make_tool_result_status(id, json_value_serialize(error), true)
    response

pub fn source_bounded_response_v1(id: text, payload: text) -> text:
    mcp_source_wrap_result_v1(id, SourceOpenResultV1(payload, false))

pub fn handle_source_open(id: text, body: text) -> text:
    if not source_rpc_id_valid_v1(id): return source_rpc_id_error_v1()
    mcp_source_wrap_result_v1(id, source_open_result_v1(body))
