# Observation point inside the ctx store append window.
#
# `main_lazy_ctx_tools` fires this between an append's write and its generation
# re-check. Nothing is registered in production, so firing is a no-op. A spec
# registers a callback to simulate a purge rename landing in that window,
# without any private symbol of the store module being imported.

var _AFTER_WRITE_ARMED: bool = false
var _AFTER_WRITE_HOOK: fn() = _ctx_append_observer_noop

fn _ctx_append_observer_noop():
    pass

pub fn ctx_append_observer_register(hook: fn()):
    _AFTER_WRITE_HOOK = hook
    _AFTER_WRITE_ARMED = true

pub fn ctx_append_observer_clear():
    _AFTER_WRITE_HOOK = _ctx_append_observer_noop
    _AFTER_WRITE_ARMED = false

pub fn ctx_append_observer_fire():
    if _AFTER_WRITE_ARMED:
        _AFTER_WRITE_HOOK()

# Second observation point: a purge fires this each round, after its temp file
# is written and before it re-reads the store for rows appended since its
# snapshot. A spec registers a callback to land an append in that window.
var _PURGE_ARMED: bool = false
var _PURGE_HOOK: fn() = _ctx_append_observer_noop

pub fn ctx_purge_observer_register(hook: fn()):
    _PURGE_HOOK = hook
    _PURGE_ARMED = true

pub fn ctx_purge_observer_clear():
    _PURGE_HOOK = _ctx_append_observer_noop
    _PURGE_ARMED = false

pub fn ctx_purge_observer_fire():
    if _PURGE_ARMED:
        _PURGE_HOOK()
