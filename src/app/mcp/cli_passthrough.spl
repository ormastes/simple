# MCP CLI Passthrough Handler
#
# Generic handler that executes a fixed bin/simple argv from a tool table entry.

use .tool_registry
use .main_lazy_json.{extract_field, make_tool_error, make_tool_result, mcp_run_argv}
use .main_lazy_diag_tools.{handle_simple_diagnostics, handle_simple_symbols}
use .main_lazy_query_tools.{_mcp_find_simple_binary}

const _MAX_CLI_TIMEOUT_S: i64 = 86400

fn handle_cli_passthrough(id: text, body: text, entry: McpToolEntry) -> text:
    handle_cli_passthrough_direct(id, body, entry.tool_name, entry.cli_command, entry.timeout_s)

fn handle_cli_passthrough_direct(id: text, body: text, name: text, cli_command: text, timeout_s: i64) -> text:
    if name == "simple_symbols":
        return handle_simple_symbols(id, body)
    if name == "simple_diagnostics":
        return handle_simple_diagnostics(id, body)

    val _bin = _mcp_find_simple_binary()

    val effective_timeout_s = _effective_cli_timeout_s(name, body, timeout_s)
    val positional_error = _cli_positional_error(body, name)
    if positional_error != "":
        return make_tool_error(id, -32602, positional_error)

    # cli_command is a fixed table value; request fields are appended as literal
    # argv elements so paths and queries never reach a shell.
    val args = _cli_args_for_name(cli_command, body, name)
    val (out, exit_code) = mcp_run_argv(_bin, args, effective_timeout_s * 1000, 1048576)

    var output = "-- " + name + " (exit: " + str(exit_code) + ") --\n" + out
    if exit_code == 124:
        output = "TIMEOUT: " + name + " timed out after " + str(effective_timeout_s) + "s\n" + out
    make_tool_result(id, output)

fn _effective_cli_timeout_s(name: text, body: text, default_timeout_s: i64) -> i64:
    if name != "simple_test":
        return default_timeout_s
    val requested_timeout_s = _parse_positive_int_or_zero(extract_field(body, "timeout"))
    if requested_timeout_s <= default_timeout_s:
        return default_timeout_s
    requested_timeout_s + 30

fn _append_cli_args_for_name(cli_command: text, body: text, name: text) -> [text]:
    # Compatibility alias retained for tests and older callers.
    _cli_args_for_name(cli_command, body, name)

fn _parse_positive_int_or_zero(value: text) -> i64:
    if value == "":
        return 0
    for ch in value:
        if ch < "0" or ch > "9":
            return 0
    val parsed = value.trim().to_int() ?? 0
    if parsed > 0 and parsed <= _MAX_CLI_TIMEOUT_S:
        return parsed
    0

fn _cli_positional_error(body: text, name: text) -> text:
    var fields: [text] = []
    if name == "simple_init":
        fields = ["name", "path"]
    elif name == "simple_ast_query" or name == "simple_sem_query":
        fields = ["query", "files"]
    elif name == "simple_add" or name == "simple_remove":
        fields = ["package"]
    elif name == "simple_query_schema":
        fields = ["kind"]
    elif name == "simple_cache" or name == "simple_i18n":
        fields = ["action"]
    elif name == "simple_sspec_maintain":
        fields = ["operation", "path"]
    elif name == "simple_sspec_scan":
        fields = ["path"]
    elif name == "task_status" or name == "task_cancel":
        fields = ["task_id"]
    else:
        fields = ["path"]
    for field in fields:
        val value = extract_field(body, field)
        if value.starts_with("-"):
            return "Invalid " + field + ": option-like values are not allowed"
    ""

fn _cli_args_for_name(cli_command: text, body: text, name: text) -> [text]:
    var result: [text] = []
    if cli_command != "":
        for part in cli_command.split(" "):
            if part != "":
                result.push(part)

    # Tool-specific argument mapping
    # Each tool maps its JSON params to CLI flags/positional args

    if name == "simple_sspec_scan":
        result.push("scan")
        val path = extract_field(body, "path")
        if path != "": result.push(path)
        for mapping in [["format", "--format"], ["min_score", "--min-score"],
                ["deny_severity", "--deny-severity"], ["baseline", "--baseline"],
                ["suppressions", "--suppressions"], ["rule", "--rule"],
                ["cache", "--cache"]]:
            val value = extract_field(body, mapping[0])
            if value != "":
                result.push(mapping[1])
                result.push(value)
        if _extract_bool_arg(body, "no_cache"): result.push("--no-cache")
        if _extract_bool_arg(body, "debug_timings"): result.push("--debug-timings")
        return result

    if name == "simple_sspec_maintain":
        val operation = extract_field(body, "operation")
        val path = extract_field(body, "path")
        val format_str = extract_field(body, "format")
        val min_score = extract_field(body, "min_score")
        val deny_severity = extract_field(body, "deny_severity")
        val output = extract_field(body, "output")
        val rollback = extract_field(body, "rollback")
        val baseline = extract_field(body, "baseline")
        val suppressions = extract_field(body, "suppressions")
        val rule = extract_field(body, "rule")
        val cache = extract_field(body, "cache")
        if operation != "":
            result.push(operation)
        if path != "":
            result.push(path)
        if format_str != "":
            result.push("--format")
            result.push(format_str)
        if min_score != "":
            result.push("--min-score")
            result.push(min_score)
        if deny_severity != "":
            result.push("--deny-severity")
            result.push(deny_severity)
        if output != "":
            result.push("--output")
            result.push(output)
        if rollback != "":
            result.push("--rollback")
            result.push(rollback)
        if baseline != "":
            result.push("--baseline")
            result.push(baseline)
        if suppressions != "":
            result.push("--suppressions")
            result.push(suppressions)
        if rule != "":
            result.push("--rule")
            result.push(rule)
        if cache != "":
            result.push("--cache")
            result.push(cache)
        if _extract_bool_arg(body, "apply"):
            result.push("--apply")
        if _extract_bool_arg(body, "preview"):
            result.push("--preview")
        if _extract_bool_arg(body, "overwrite"):
            result.push("--overwrite")
        if _extract_bool_arg(body, "no_cache"):
            result.push("--no-cache")
        if _extract_bool_arg(body, "debug_timings"):
            result.push("--debug-timings")
        return result

    # --- simple_check, simple_symbols, simple_run, simple_diagnostics, simple_desugar, simple_lex ---
    if name == "simple_check" or name == "simple_run" or name == "simple_desugar" or name == "simple_lex":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    if name == "simple_symbols":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    if name == "simple_diagnostics":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_test ---
    if name == "simple_test":
        val path = extract_field(body, "path")
        val filter_str = extract_field(body, "filter")
        val only_slow = extract_field(body, "only_slow")
        val list_flag = extract_field(body, "list")
        val timeout = extract_field(body, "timeout")
        if list_flag == "true":
            result.push("--list")
        elif path != "":
            result.push(path)
        if filter_str != "":
            result.push("--filter")
            result.push(filter_str)
        if only_slow == "true":
            result.push("--only-slow")
        val timeout_s = _parse_positive_int_or_zero(timeout)
        if timeout_s > 0:
            result.push("--timeout")
            result.push(str(timeout_s))
        else:
            result.push("--timeout")
            result.push("60")
        return result

    # --- simple_build ---
    if name == "simple_build":
        val release = extract_field(body, "release")
        val target = extract_field(body, "target")
        val warn_docs = extract_field(body, "warn_docs")
        if release == "true":
            result.push("--release")
        if target != "":
            result.push("--target")
            result.push(target)
        if warn_docs == "true":
            result.push("--warn-docs")
        return result

    # --- simple_format ---
    if name == "simple_format":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        if _extract_bool_arg(body, "check"):
            result.push("--check")
        return result

    # --- simple_lint ---
    if name == "simple_lint":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_fix ---
    if name == "simple_fix":
        val path = extract_field(body, "path")
        val dry_run = extract_field(body, "dry_run")
        if path != "":
            result.push(path)
        if dry_run == "true":
            result.push("--dry-run")
        return result

    # --- simple_doc_coverage ---
    if name == "simple_doc_coverage":
        val format_str = extract_field(body, "format")
        val missing = extract_field(body, "missing")
        if format_str != "":
            result.push("--format=" + format_str)
        if missing == "true":
            result.push("--missing")
        return result

    # --- query tools (ast-query, sem-query, query-schema) ---
    if name == "simple_ast_query" or name == "simple_sem_query":
        val query = extract_field(body, "query")
        val files = extract_field(body, "files")
        val format_str = extract_field(body, "format")
        if query != "":
            result.push(query)
        if files != "":
            result.push(files)
        if format_str != "":
            result.push("--format")
            result.push(format_str)
        return result

    if name == "simple_query_schema":
        val kind = extract_field(body, "kind")
        if kind != "":
            result.push(kind)
        return result

    # --- simple_add ---
    if name == "simple_add":
        val package = extract_field(body, "package")
        val version = extract_field(body, "version")
        val dev = extract_field(body, "dev")
        if package != "" and version != "":
            result.push(package + "@" + version)
        elif package != "":
            result.push(package)
        if dev == "true":
            result.push("--dev")
        return result

    # --- simple_remove ---
    if name == "simple_remove":
        val package = extract_field(body, "package")
        if package != "":
            result.push(package)
        return result

    # --- simple_stats ---
    if name == "simple_stats":
        val format_str = extract_field(body, "format")
        if format_str == "json":
            result.push("--json")
        return result

    # --- simple_duplicate_check ---
    if name == "simple_duplicate_check":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_check_arch ---
    if name == "simple_check_arch":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_info ---
    if name == "simple_info":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_init ---
    if name == "simple_init":
        val proj_name = extract_field(body, "name")
        val path = extract_field(body, "path")
        if proj_name != "":
            result.push(proj_name)
        if path != "":
            result.push(path)
        return result

    # --- simple_spec_coverage ---
    if name == "simple_spec_coverage":
        val missing = extract_field(body, "missing")
        if missing == "true":
            result.push("--missing")
        return result

    # --- Codegen tools with path param ---
    if (name == "simple_spec_gen" or name == "simple_sffi_gen" or name == "simple_wrapper_gen" or
        name == "simple_spipe_docgen" or name == "simple_gen_lean"):
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- simple_cache ---
    if name == "simple_cache":
        val action = extract_field(body, "action")
        if action != "":
            result.push(action)
        return result

    # --- simple_i18n ---
    if name == "simple_i18n":
        val action = extract_field(body, "action")
        if action != "":
            result.push(action)
        return result

    # --- task_status / task_cancel ---
    if name == "task_status" or name == "task_cancel":
        val task_id = extract_field(body, "task_id")
        if task_id != "":
            result.push(task_id)
        return result

    # --- test_daemon_run ---
    if name == "test_daemon_run":
        val path = extract_field(body, "path")
        val filter_str = extract_field(body, "filter")
        if path != "":
            result.push(path)
        if filter_str != "":
            result.push("--filter")
            result.push(filter_str)
        return result

    # --- test_daemon_clean ---
    if name == "test_daemon_clean":
        val path = extract_field(body, "path")
        if path != "":
            result.push(path)
        return result

    # --- debug_log_enable ---
    if name == "debug_log_enable":
        val pattern = extract_field(body, "pattern")
        if pattern != "":
            result.push("--pattern")
            result.push(pattern)
        return result

    # --- debug_log_query ---
    if name == "debug_log_query":
        val since_id = extract_field(body, "since_id")
        val entry_type = extract_field(body, "entry_type")
        val max_results = extract_field(body, "max_results")
        if since_id != "":
            result.push("--since-id")
            result.push(since_id)
        if entry_type != "":
            result.push("--type")
            result.push(entry_type)
        if max_results != "":
            result.push("--max")
            result.push(max_results)
        return result

    # --- debug_log_tree ---
    if name == "debug_log_tree":
        val format_str = extract_field(body, "format")
        if format_str != "":
            result.push("--format")
            result.push(format_str)
        return result

    # --- Default: no extra args (brief, todo_scan, todo_gen, env, log disable/clear/status, etc.) ---
    result

fn _extract_bool_arg(body: text, key: text) -> bool:
    val quoted = Q() + key + Q()
    body.contains(quoted + ":true") or body.contains(quoted + ": true") or
    body.contains(quoted + ":" + Q() + "true" + Q()) or
    body.contains(quoted + ": " + Q() + "true" + Q())
