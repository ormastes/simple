# Editor JSON Helpers
#
# Low-level JSON parsing utilities for editor LSP/code-action processing.

use app.editor.editor_path_text_helpers.*

fn _editor_escape_json(s: text) -> text:
    var result = ""
    var i = 0
    # Flush whole SPANS between specials, never single bytes: the
    # interpreter's strings are Rust Strings, so a mid-codepoint 1-byte
    # slice materializes as U+FFFD there (native keeps raw bytes) and
    # per-byte accumulation corrupted multi-byte text. Specials are ASCII,
    # so spans are whole codepoints.
    var run_start = 0
    while i < s.len():
        val ch = s[i:i + 1]
        if ch == "\"" or ch == "\\":
            result = result + s[run_start:i]
            if ch == "\"":
                result = result + "\\\""
            else:
                result = result + "\\\\"
            run_start = i + 1
        i = i + 1
    result + s[run_start:i]

fn _editor_json_number_field(json: text, field: text) -> i64:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(field):
            var j = i + field.len()
            while j < json.len() and (json[j:j + 1] == " " or json[j:j + 1] == ":"):
                j = j + 1
            var num = ""
            while j < json.len():
                val ch = json[j:j + 1]
                if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9":
                    num = num + ch
                else:
                    break
                j = j + 1
            if num != "":
                return num.to_i64() ?? -1
        i = i + 1
    -1

fn _editor_json_number_after(json: text, marker: text, field: text) -> i64:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(marker):
            return _editor_json_number_field(json.slice(i, json.len()), field)
        i = i + 1
    -1

fn _editor_json_string_field(json: text, field: text) -> text:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(field):
            var j = i + field.len()
            while j < json.len() and (json[j:j + 1] == " " or json[j:j + 1] == ":"):
                j = j + 1
            if j < json.len() and json[j:j + 1] == "\"":
                return _editor_unescape_json_string(json, j)
        i = i + 1
    ""

fn _editor_json_value_field(json: text, field: text) -> text:
    var i = 0
    while i < json.len():
        if json.slice(i, json.len()).starts_with(field):
            var j = i + field.len()
            while j < json.len() and (json[j:j + 1] == " " or json[j:j + 1] == ":"):
                j = j + 1
            if j >= json.len():
                return ""
            val ch = json[j:j + 1]
            if ch == "{" or ch == "[":
                return _editor_json_balanced(json, j, ch)
            if ch == "\"":
                return "\"" + _editor_escape_json(_editor_unescape_json_string(json, j)) + "\""
            # Whole-SPAN scalar extraction (per-byte appends corrupt
            # multi-byte values under the interpreter — see the escape
            # helper's run_start comment above).
            val run_start = j
            while j < json.len():
                val c = json[j:j + 1]
                if c == "," or c == "}":
                    return json[run_start:j].trim()
                j = j + 1
            return json[run_start:j].trim()
        i = i + 1
    ""

fn _editor_json_balanced(json: text, start: i64, open_ch: text) -> text:
    val close_ch = if open_ch == "{" then "}" else: "]"
    var depth = 0
    var i = start
    var in_str = false
    while i < json.len():
        val ch = json[i:i + 1]
        if in_str:
            if ch == "\\":
                i = i + 1
            elif ch == "\"":
                in_str = false
        else:
            if ch == "\"":
                in_str = true
            elif ch == open_ch:
                depth = depth + 1
            elif ch == close_ch:
                depth = depth - 1
                if depth == 0:
                    return json.slice(start, i + 1)
        i = i + 1
    ""

fn _editor_json_numbers_in_array_field(json: text, field: text) -> [i64]:
    var nums: [i64] = []
    val idx = _editor_find_text(json, field)
    if idx < 0:
        return nums
    var i = idx
    while i < json.len() and json[i:i + 1] != "[":
        i = i + 1
    if i >= json.len():
        return nums
    i = i + 1
    while i < json.len() and json[i:i + 1] != "]":
        while i < json.len() and (json[i:i + 1] == " " or json[i:i + 1] == "\n" or json[i:i + 1] == ","):
            i = i + 1
        var digits = ""
        while i < json.len() and json[i:i + 1] >= "0" and json[i:i + 1] <= "9":
            digits = digits + json[i:i + 1]
            i = i + 1
        if digits != "":
            nums.push(digits.to_i64() ?? 0)
        else:
            i = i + 1
    nums

fn _editor_unescape_json_string(json: text, start: i64) -> text:
    # Span-append between escapes (per-byte appends corrupt multi-byte
    # values under the interpreter — see the escape helper's run_start
    # comment above). The escaped character itself is ASCII.
    var result = ""
    var i = start + 1
    var run_start = i
    while i < json.len():
        val ch = json[i:i + 1]
        if ch == "\"":
            return result + json[run_start:i]
        if ch == "\\":
            result = result + json[run_start:i]
            i = i + 1
            if i < json.len():
                val esc = json[i:i + 1]
                if esc == "n":
                    result = result + "\n"
                elif esc == "t":
                    result = result + "\t"
                else:
                    result = result + esc
            run_start = i + 1
        i = i + 1
    result + json[run_start:i]
