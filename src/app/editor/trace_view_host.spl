# Editor view host: renders a registered extension view (schema v2 `views`)
# through its declared content provider. The trace explorer's provider
# `trace.explorer_provider` is rendered by app.traceability.ide_view_render.
# REQ-CARET-EXT-003, REQ-CARET-TRC-001.

use std.editor.extensions.host.{ExtensionHost}
use std.common.traceability.model.{TraceGraph, TraceQualification}
use std.common.traceability.query_nodes_v1.{TraceNodeQueryV1}
use std.common.traceability.query_refs_v1.{TraceReferenceQueryV1}
use app.traceability.ide_view_render.{trace_view_lines, refs_view_lines, view_state_lines, TraceViewState}
use app.traceability.query_options_v1.{TraceQueryOptionsV1}
use app.traceability.query_snapshot_v1.{trace_query_build_snapshot_v1}

# `snapshot` is the revision the user selected; `expected_generation` (when
# non-empty) is the graph generation the caller's delta stream expects;
# `source_present` is false when the pinned source blob could not be read.
struct TraceViewInput:
    graph: TraceGraph
    query: TraceNodeQueryV1
    quals: [TraceQualification]
    snapshot: text
    refs: TraceReferenceQueryV1? = None
    source_present: bool = true
    expected_generation: text = ""

fn _view_provider(host: ExtensionHost, view_id: text) -> text:
    for entry in host.view_registry:
        if entry.view.id == view_id:
            return entry.view.provider
    ""

# True when `view_id` is registered with the trace explorer provider, i.e. a
# snapshot is worth loading for it.
fn view_host_uses_trace(host: ExtensionHost, view_id: text) -> bool:
    host.view_registered(view_id) and _view_provider(host, view_id) == "trace.explorer_provider"

# Canonical snapshot build (same service the trace CLI list/show/refs uses),
# worktree preview, default list of requirements. No qualifications source is
# wired, so badges render as structural only.
fn view_host_load_input() -> Result<TraceViewInput, text>:
    val options = TraceQueryOptionsV1(operation: "list", kind: "requirements", snapshot: "worktree")
    val build = trace_query_build_snapshot_v1(options)?
    val snapshot = build.graph.subject.snapshot_id
    Ok(TraceViewInput(graph: build.graph,
        query: TraceNodeQueryV1(snapshot_id: snapshot, operation: "list", kind: "requirements", limit: 100),
        quals: [], snapshot: snapshot))

fn _input_guard(i: TraceViewInput) -> [text]:
    if not i.source_present:
        return view_state_lines(TraceViewState.SourceMissing)
    if i.expected_generation != "" and i.expected_generation != i.graph.generation_id:
        return view_state_lines(TraceViewState.DeltaMismatch)
    []

# `input` is None while no trace snapshot is loaded: the view then says so
# explicitly instead of rendering nothing.
fn view_host_render(host: ExtensionHost, view_id: text, input: TraceViewInput?) -> [text]:
    if not host.view_registered(view_id):
        return ["unavailable: view not registered: " + view_id]
    if not host.view_visible(view_id):
        return ["unavailable: view hidden by when clause: " + view_id]
    val provider = _view_provider(host, view_id)
    if provider != "trace.explorer_provider":
        return ["unavailable: no renderer for provider " + provider]
    if val i = input:
        val guard = _input_guard(i)
        if guard.len() > 0:
            return guard
        if val rq = i.refs:
            return refs_view_lines(i.graph, rq, i.quals, i.snapshot)
        return trace_view_lines(i.graph, i.query, i.quals, i.snapshot)
    view_state_lines(TraceViewState.SourceMissing)

export TraceViewInput, view_host_render, view_host_uses_trace, view_host_load_input
