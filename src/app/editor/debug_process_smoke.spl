# Editor DAP process transport smoke
#
# Native-only smoke entry for the process-backed DAP stdio transport.

use std.io.{
    process_spawn_piped, process_write_stdin, process_read_stdout_result,
    process_is_piped_alive_result, process_close_piped
}
use std.concurrent.thread.{thread_sleep}

fn main() -> i64:
    val pid = process_spawn_piped("bin/simple", ["run", "src/app/dap/simple_dap_main.spl"])
    if pid <= 0:
        print "STATUS: FAIL editor_dap_process_smoke start"
        return 1
    val frame = "Content-Length: 84\r\n\r\n{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"simple\"}}"
    if not process_write_stdin(pid, frame):
        process_close_piped(pid)
        print "STATUS: FAIL editor_dap_process_smoke write"
        return 1

    var attempts = 0
    var saw_response = false
    var raw = ""
    var polling = true
    while attempts < 100000 and not saw_response and polling:
        match process_read_stdout_result(pid):
            case Ok(Some(chunk)): raw = raw + chunk
            case Ok(nil):
                match process_is_piped_alive_result(pid):
                    case Ok(alive):
                        polling = alive
                        if alive: thread_sleep(1)
                    case Err(_): polling = false
                    case _("fail closed if Result gains another variant"): polling = false
            case Err(_): polling = false
            case _("fail closed if Result gains another variant"): polling = false
        if raw.contains("\"type\":\"response\"") and raw.contains("\"command\":\"initialize\""):
            saw_response = true
        attempts = attempts + 1
    process_close_piped(pid)

    if not saw_response:
        print "STATUS: FAIL editor_dap_process_smoke no_response"
        return 1

    print "STATUS: PASS editor_dap_process_smoke"
    0
