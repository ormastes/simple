# Native runtime helpers for process-backed editor debug adapters.

use std.nogc_sync_mut.io.process_ops.{process_spawn_piped, process_write_stdin}
use std.io_runtime.{file_exists}

fn editor_debug_process_find_simple_binary() -> text:
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    if file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    "bin/simple"

fn editor_debug_process_spawn_simple_adapter() -> i64:
    editor_debug_process_spawn_adapter("src/app/dap/simple_dap_main.spl")

fn editor_debug_process_spawn_adapter(adapter_program: text) -> i64:
    process_spawn_piped(editor_debug_process_find_simple_binary(), ["run", adapter_program])

fn editor_debug_process_write_frame(pid: i64, json: text) -> bool:
    # BUG-3 fix: guard against invalid pids (spawn failure returns 0 or -1).
    # Forwarding a bad pid to rt_process_write_stdin writes to an invalid fd
    # which can SIGSEGV in the kernel pipe handler.
    if pid <= 0:
        return false
    process_write_stdin(pid, "Content-Length: " + str(json.len()) + "\r\n\r\n" + json)

fn editor_debug_process_start_simple_adapter(pid: i64) -> bool:
    if pid <= 0:
        return false
    val init_json = "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{\"adapterID\":\"simple\"}}"
    val launch_json = "{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"src/app/dap/simple_dap_main.spl\",\"cwd\":\".\"}}"
    editor_debug_process_write_frame(pid, init_json) and editor_debug_process_write_frame(pid, launch_json)
