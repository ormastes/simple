# Profile activation plan shared by the GUI and TUI shells (REQ-CARET-EXT-003).
#
# "editor" (and an empty name) activates every builtin application ("event:*")
# plus the two always-on languages. "caret" is chat-first: it activates only
# the Simple language plus the builtin `caret.workbench` extension (view
# container + views), reached by the narrow `onProfile:caret` event, never the
# wildcard. Any other name is an explicit error with no steps.

use app.editor.editor_controller.{EditorController}
use app.llm_caret.workbench.key_resolver.{KeyFocus}
use app.llm_caret.workbench.session_source.{publish_live_focus, live_selected_provider}

struct ProfilePlan:
    ok: bool
    steps: [text]
    error: text

fn profile_activation_plan(profile: text) -> ProfilePlan:
    if profile == "caret":
        return ProfilePlan(ok: true, steps: ["language:simple", "event:onProfile:caret"], error: "")
    if profile == "editor" or profile == "":
        return ProfilePlan(ok: true, steps: ["event:*", "language:simple", "language:markdown"], error: "")
    ProfilePlan(ok: false, steps: [], error: "unknown profile '{profile}' (expected editor or caret)")

fn profile_apply(ctrl: EditorController, profile: text):
    val plan = profile_activation_plan(profile)
    if not plan.ok:
        ctrl.status_msg = plan.error
        return
    for step in plan.steps:
        if step.starts_with("event:"):
            ctrl.extension_host.activate_event(step.slice(6, step.byte_len()))
        elif step.starts_with("language:"):
            ctrl.extension_host.activate_language(step.slice(9, step.byte_len()))

# Context keys the caret profile exposes to `when` clauses: the focused pane
# kind plus (when a session is selected) its provider.
fn caret_context_keys(focus: KeyFocus, provider: text) -> [text]:
    var keys: [text] = []
    match focus:
        case KeyFocus.TerminalSurface: keys = ["caret.focus.terminal"]
        case KeyFocus.NativeView: keys = ["caret.focus.native"]
        case KeyFocus.Overlay: keys = ["caret.focus.overlay"]
    if provider != "":
        keys = keys + ["caret.session." + provider]
    keys

fn profile_sync_context_with(ctrl: EditorController, profile: text, focus: KeyFocus, provider: text):
    if profile != "caret":
        var kept: [text] = []
        for k in ctrl.extension_host.context_keys:
            if not k.starts_with("caret."):
                kept = kept + [k]
        if kept.len() != ctrl.extension_host.context_keys.len():
            ctrl.extension_host.set_context_keys(kept)
        return
    val keys = caret_context_keys(focus, provider)
    if ctrl.extension_host.context_keys == keys:
        return
    ctrl.extension_host.set_context_keys(keys)

# Focused pane kind of the IDE shell: an open palette is an overlay, the
# terminal panel is a raw CLI surface, everything else is a native view.
fn shell_key_focus(ctrl: EditorController) -> KeyFocus:
    if ctrl.palette_state != nil:
        return KeyFocus.Overlay
    if ctrl.focus_panel == "terminal":
        return KeyFocus.TerminalSurface
    KeyFocus.NativeView

# Production caller of ExtensionHost.set_context_keys: shells call this each
# frame so keybinding/view `when` clauses see the live focus and session kind.
# The shell's real focus is published first so live_focus() is accurate in an
# `ide --profile caret` process (no workbench key loop runs there).
fn profile_sync_context(ctrl: EditorController, profile: text):
    if profile != "caret":
        return
    val focus = shell_key_focus(ctrl)
    publish_live_focus(focus)
    profile_sync_context_with(ctrl, profile, focus, live_selected_provider())

# The one view list both shells render: contributed views whose `when` holds.
fn shell_view_ids(ctrl: EditorController) -> [text]:
    ctrl.extension_host.visible_view_ids()

export shell_key_focus, ProfilePlan,profile_activation_plan, profile_apply, shell_view_ids, caret_context_keys, profile_sync_context_with, profile_sync_context
