# Profile activation plan shared by the GUI and TUI shells (REQ-CARET-EXT-003).
#
# "editor" (and an empty name) activates every builtin application ("event:*")
# plus the two always-on languages. "caret" is chat-first: it activates only
# the Simple language. Any other name is an explicit error with no steps.

use app.editor.editor_controller.{EditorController}

struct ProfilePlan:
    ok: bool
    steps: [text]
    error: text

fn profile_activation_plan(profile: text) -> ProfilePlan:
    if profile == "caret":
        return ProfilePlan(ok: true, steps: ["language:simple"], error: "")
    if profile == "editor" or profile == "":
        return ProfilePlan(ok: true, steps: ["event:*", "language:simple", "language:markdown"], error: "")
    ProfilePlan(ok: false, steps: [], error: "unknown profile '{profile}' (expected editor or caret)")

fn profile_apply(ctrl: EditorController, profile: text):
    val plan = profile_activation_plan(profile)
    if not plan.ok:
        ctrl.status_msg = plan.error
        return
    for step in plan.steps:
        if step.starts_with("event:"):
            ctrl.extension_host.activate_event(step.slice(6, step.byte_len()))
        elif step.starts_with("language:"):
            ctrl.extension_host.activate_language(step.slice(9, step.byte_len()))

export ProfilePlan, profile_activation_plan, profile_apply
