# Local app.editor wrappers around public lib.editor data structs.
# Avoids calling module-private helpers in std.editor.* under strict JIT visibility checks.

use std.editor.services.command_palette.{PaletteEntry, PaletteState}
use std.editor.services.md_lsp_config.{MdLspState}
use std.editor.view.layout.{EditorGroup, EditorLayout, editor_layout_active_group_index}

fn app_editor_layout_with_group(layout: EditorLayout, index: i64, group: EditorGroup) -> EditorLayout:
    var groups = layout.groups
    groups[index] = group
    EditorLayout(
        panes: layout.panes,
        active_pane_id: layout.active_pane_id,
        sidebar: layout.sidebar,
        panel: layout.panel,
        orientation: layout.orientation,
        tree: layout.tree,
        groups: groups,
        active_group_id: layout.active_group_id,
        active_group_index: editor_layout_active_group_index(layout)
    )

fn app_md_lsp_change_active(state: MdLspState, path: text, content: text) -> MdLspState:
    if not state.running:
        return state
    var client = state.client
    val new_version = state.version + 1
    client.did_change(path, content, new_version)
    MdLspState(client: client, running: state.running, version: new_version)

fn app_palette_show(state: PaletteState) -> PaletteState:
    PaletteState(entries: state.entries, filtered: state.entries, query: "", selected_index: 0, visible: true)

fn app_palette_selected(state: PaletteState) -> PaletteEntry:
    if state.filtered.len() == 0:
        return PaletteEntry(description: "", name: "", command_name: "", command_payload: "")
    var idx = state.selected_index
    if idx < 0:
        idx = 0
    if idx >= state.filtered.len():
        idx = state.filtered.len() - 1
    state.filtered[idx]

fn app_palette_select_next(state: PaletteState) -> PaletteState:
    var idx = state.selected_index
    if state.filtered.len() > 0:
        idx = idx + 1
        if idx >= state.filtered.len():
            idx = state.filtered.len() - 1
    PaletteState(entries: state.entries, filtered: state.filtered, query: state.query, selected_index: idx, visible: state.visible)

fn app_palette_select_prev(state: PaletteState) -> PaletteState:
    var idx = state.selected_index - 1
    if idx < 0:
        idx = 0
    PaletteState(entries: state.entries, filtered: state.filtered, query: state.query, selected_index: idx, visible: state.visible)
