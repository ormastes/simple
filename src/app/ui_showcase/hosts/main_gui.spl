# Entry point for the GUI (real window) showcase target.

use std.io_runtime.{env_get}
use common.ui.wm_app_process_contract.{
    WIDGET_SHOWCASE_WINDOW_W, WIDGET_SHOWCASE_WINDOW_H, widget_showcase_window_title
}
use app.ui_showcase.showcase_core.{showcase_run}
use app.ui_showcase.hosts.host_gui.{ScreenGuiHost}

fn _env_i64(key: text, fallback: i64) -> i64:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    val parsed: i64? = raw.to_int()
    parsed ?? fallback

fn main():
    # 528x692 matches WIDGET_SHOWCASE_WINDOW_W/H so the existing WM launch
    # expectations for the widget showcase still hold.
    val frames = _env_i64("SIMPLE_SHOWCASE_FRAMES", 120)
    val opened = ScreenGuiHost.open(
        WIDGET_SHOWCASE_WINDOW_W, WIDGET_SHOWCASE_WINDOW_H,
        widget_showcase_window_title("gui")
    )
    match opened:
        case None:
            # Honest failure: no window, so no frames. GuiRenderer has already
            # printed why. Do NOT emit a frames>0 line here.
            print "showcase host=gui frames=0 clicks=0 drags=0 typed=\"\" left=0 right=0 free=0"
            print "showcase gui: no window (missing display or build/sffi/libspl_winit)"
        case Some(host):
            val r = showcase_run(host, "scgui", frames)
            host.shutdown()
            print "showcase host={r.host_name} frames={r.frames} clicks={r.clicks} " +
                "drags={r.drags} typed=\"{r.typed_text}\" left={r.left_offset} " +
                "right={r.right_offset} free={r.free_offset}"
