# Fail-closed semantic receipt shared by real GUI and web showcase runs.

use app.ui_showcase.showcase_core.{ShowcaseRunReport}

fn showcase_live_interaction_reason(report: ShowcaseRunReport) -> text:
    if report.frames <= 0:
        return "no-presented-frame"
    if report.clicks <= 0:
        return "internal-window-click-missing"
    if report.drags <= 0:
        return "scrollbar-drag-missing"
    if report.typed_text == "":
        return "text-input-missing"
    if report.left_offset <= 0:
        return "linked-panel-scroll-missing"
    if report.right_offset != report.left_offset:
        return "linked-panel-scroll-mismatch"
    if report.free_offset != 0:
        return "free-panel-negative-control-moved"
    ""

fn showcase_live_interaction_complete(report: ShowcaseRunReport) -> bool:
    showcase_live_interaction_reason(report) == ""

fn showcase_wm_live_reason(report: ShowcaseRunReport, frame_export: bool,
                           pixel_count: i64, checksum: i64, frame_seq: i64) -> text:
    val interaction_reason = showcase_live_interaction_reason(report)
    if interaction_reason != "":
        return interaction_reason
    if not frame_export:
        return "frame-export-disabled"
    if pixel_count <= 0:
        return "exported-pixels-missing"
    if checksum <= 0:
        return "exported-checksum-missing"
    if frame_seq <= 0:
        return "exported-frame-sequence-missing"
    ""

export showcase_live_interaction_reason, showcase_live_interaction_complete
export showcase_wm_live_reason
