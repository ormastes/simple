# Entry point for the GPU-backed 2D showcase capture (Metal or Vulkan).
#
# SIMPLE_GPU_BACKEND selects the backend ("metal" default, "vulkan" for the
# MoltenVK lane). Everything else is the same env contract as main_2d.spl /
# main_2d_vulkan.spl, and the loop is the shared showcase_run_gpu over
# Screen2dGpuHost.

use common.ui.draw_ir.{DRAW_IR_BACKEND_GPU}
use app.io.mod.{dir_create_all, env_get, file_write_bytes}
use app.ui_showcase.hosts.host_2d_gpu.{Screen2dGpuHost, showcase_run_gpu}
use app.ui_showcase.hosts.scene_raster.{raster_to_ppm_bytes}

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

fn _parent_dir(path: text) -> text:
    val index = path.last_index_of("/")
    if index <= 0:
        return ""
    path.substring(0, index)

fn _backend() -> text:
    val raw = env_get("SIMPLE_GPU_BACKEND").trim().lower()
    if raw == "":
        return "metal"
    raw

fn main():
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 20).to_i64()
    val script = env_get("SIMPLE_SHOWCASE_SCRIPT")
    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    val backend = _backend()

    if backend != "metal" and backend != "vulkan":
        print "showcase status=blocked renderer={backend} reason=unsupported-backend"
        return
    match Screen2dGpuHost.open(w, h, script, backend):
        case None:
            print "showcase status=blocked renderer={backend} reason={backend}-device-unavailable"
        case Some(host):
            val report = showcase_run_gpu(
                host, "sc2d_{backend}", frames, DRAW_IR_BACKEND_GPU)
            val pixels = host.pixels()
            val receipt = host.device_receipt()
            if (frames <= 0 or report.frames != frames or
                pixels.len() != w.to_i64() * h.to_i64() or receipt == ""):
                var reason = host.rejection_reason()
                if reason == "":
                    reason = "incomplete-device-frame-sequence"
                print "showcase status=fail renderer={backend} reason={reason}"
                host.shutdown()
                return
            if capture != "":
                val dir = _parent_dir(capture)
                if dir != "":
                    dir_create_all(dir)
                if not file_write_bytes(capture, raster_to_ppm_bytes(pixels, w, h)):
                    print "showcase status=fail renderer={backend} reason=capture-write"
                    host.shutdown()
                    return
            print (
                "showcase status=pass host={report.host_name} frames={report.frames} " +
                "clicks={report.clicks} drags={report.drags} typed=\"{report.typed_text}\" " +
                "left={report.left_offset} right={report.right_offset} " +
                "free={report.free_offset} capture={capture} {receipt}"
            )
            host.shutdown()
