# Exact-backend Engine2D showcase host for software, scalar CPU, CPU SIMD,
# and Metal. Unlike the raw software raster host, this consumes the original
# DrawIrComposition and rejects backend fallback.

use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, DRAW_IR_BACKEND_GPU, DrawIrComposition}
use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.host_input_event.{HostInputEvent}
use common.ui.screen_host.{ScreenHost}
use common.ui.widget.{UIState}
use gpu.engine2d.engine.{Engine2D}
use gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult, Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images
}
use std.nogc_sync_mut.gpu.engine2d.simd_native_rows.{engine2d_simd_native_hits}
use app.ui_showcase.hosts.host_2d.{screen_2d_parse_script}
use app.ui_showcase.showcase_core.{
    ShowcaseRunReport, showcase_apply, showcase_build, showcase_composition,
    showcase_report
}

fn showcase_engine_backend_supported(backend: text) -> bool:
    backend == "software" or backend == "cpu" or
        backend == "cpu_simd" or backend == "metal"

fn _composition_target(backend: text) -> text:
    if backend == "metal":
        return DRAW_IR_BACKEND_GPU
    DRAW_IR_BACKEND_CPU

fn _composition_has_resolved_font(composition: DrawIrComposition) -> bool:
    for batch in composition.batches:
        for command in batch.commands:
            for style in command.computed_style:
                if style.key == "font-identity" and style.value != "":
                    return true
    false

class Screen2dEngineHost:
    var w: i32
    var h: i32
    var requested_backend: text
    var engine: Engine2D
    var queue: [HostInputEvent]
    var cursor: i64
    var last_pixels: [u32]
    var last_receipt: text
    var last_rejection: text
    var host_valid: bool

    static fn open(w: i32, h: i32, script: text, backend: text) -> Screen2dEngineHost?:
        val requested = backend.trim().to_lower()
        if w <= 0 or h <= 0 or not showcase_engine_backend_supported(requested):
            return nil
        val engine = Engine2D.create_with_backend_fast(w, h, requested)
        if engine.backend_name() != requested:
            engine.shutdown()
            return nil
        Screen2dEngineHost(
            w: w, h: h, requested_backend: requested, engine: engine,
            queue: screen_2d_parse_script(script), cursor: 0,
            last_pixels: [], last_receipt: "", last_rejection: "not-rendered",
            host_valid: true
        )

    me _reject(reason: text) -> bool:
        self.last_pixels = []
        self.last_receipt = ""
        self.last_rejection = reason
        false

    me present_composition(composition: DrawIrComposition) -> bool:
        if not self.host_valid:
            return self._reject("engine-resize-rejected")
        val expected_target = _composition_target(self.requested_backend)
        if composition.backend_target != expected_target:
            return self._reject("composition-backend-target-mismatch")
        if self.engine.backend_name() != self.requested_backend:
            return self._reject("engine-backend-changed")
        val native_hits_before = engine2d_simd_native_hits()
        var images: [Engine2dResolvedDrawIrImage] = []
        val result: Engine2dDrawIrAdvResult =
            engine2d_draw_ir_adv_composition_with_images(
                self.engine, composition, self.requested_backend == "metal", images)
        val expected_pixels = self.w.to_i64() * self.h.to_i64()
        if (result.fallback_required or result.fallback_reason != "" or
            result.skipped_command_count != 0 or result.rendered_command_count <= 0 or
            result.pixels.len() != expected_pixels or result.readback_checksum <= 0):
            return self._reject("drawir-receipt-rejected")
        if self.requested_backend == "metal" and (
            result.readback_source != "device_readback" or
            result.backend_handle <= 0 or result.device_identity <= 0):
            return self._reject("metal-device-readback-required")
        if _composition_has_resolved_font(composition) and (
            result.font_identity == "" or result.font_execution_target == ""):
            return self._reject("resolved-font-execution-required")
        val native_hits_after = engine2d_simd_native_hits()
        if self.requested_backend == "cpu_simd" and native_hits_after <= native_hits_before:
            return self._reject("cpu-simd-native-execution-required")
        self.last_pixels = result.pixels
        self.last_receipt = (
            "renderer={self.requested_backend} source={result.readback_source} " +
            "backend_handle={result.backend_handle} device_identity={result.device_identity} " +
            "checksum={result.readback_checksum} rendered={result.rendered_command_count} " +
            "font_target={result.font_execution_target} font_identity={result.font_identity} " +
            "native_simd_hits={native_hits_after - native_hits_before} fallback=false"
        )
        self.last_rejection = ""
        true

    me pixels() -> [u32]: self.last_pixels
    fn backend_receipt() -> text: self.last_receipt
    fn rejection_reason() -> text: self.last_rejection

impl ScreenHost for Screen2dEngineHost:
    me host_name() -> text: "2d-{self.requested_backend}"
    me size() -> (i32, i32): (self.w, self.h)
    me present_scene(_scene: DrawIrV3Scene) -> bool:
        self._reject("engine-host-requires-original-composition")
    me poll_input() -> HostInputEvent?:
        if self.cursor >= self.queue.len().to_i64():
            return nil
        val event = self.queue[self.cursor]
        self.cursor = self.cursor + 1
        match event:
            HostInputEvent.Resize(resize_w, resize_h):
                if resize_w > 0 and resize_h > 0:
                    val replacement = Engine2D.create_with_backend_fast(
                        resize_w, resize_h, self.requested_backend)
                    if replacement.backend_name() != self.requested_backend:
                        replacement.shutdown()
                        self.host_valid = false
                    else:
                        self.engine.shutdown()
                        self.engine = replacement
                        self.w = resize_w
                        self.h = resize_h
                        self.last_pixels = []
                        self.last_receipt = ""
                        self.last_rejection = "not-rendered-after-resize"
            _:
                pass
        event
    me shutdown():
        self.cursor = self.queue.len().to_i64()
        self.engine.shutdown()

fn showcase_run_with_exact_engine_backend(
    host: Screen2dEngineHost, prefix: text, max_frames: i64
) -> ShowcaseRunReport:
    var state: UIState = showcase_build(prefix)
    var frames: i64 = 0
    while frames < max_frames:
        val (w, h) = host.size()
        val composition = showcase_composition(
            state, w, h, _composition_target(host.requested_backend))
        if not host.present_composition(composition):
            break
        frames = frames + 1
        var event = host.poll_input()
        while event != nil:
            val (event_w, event_h) = host.size()
            state = showcase_apply(state, event!, event_w, event_h)
            event = host.poll_input()
    showcase_report(state, host.host_name(), frames)

export Screen2dEngineHost, showcase_engine_backend_supported
export showcase_run_with_exact_engine_backend
