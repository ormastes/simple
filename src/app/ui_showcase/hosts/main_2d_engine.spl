# Entry point for exact Engine2D software/cpu/cpu_simd/metal showcase captures.

use app.io.mod.{dir_create_all, env_get, file_write_bytes}
use app.ui_showcase.hosts.host_2d_engine.{
    Screen2dEngineHost, showcase_run_with_exact_engine_backend
}
use app.ui_showcase.hosts.scene_raster.{raster_to_ppm_bytes}

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

fn _parent_dir(path: text) -> text:
    val index = path.last_index_of("/")
    if index <= 0:
        return ""
    path.substring(0, index)

fn main():
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 3).to_i64()
    val script = env_get("SIMPLE_SHOWCASE_SCRIPT")
    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    val backend = env_get("SIMPLE_SHOWCASE_BACKEND").trim().to_lower()

    match Screen2dEngineHost.open(w, h, script, backend):
        case None:
            print "showcase status=blocked renderer={backend} reason=exact-backend-unavailable"
        case Some(host):
            val report = showcase_run_with_exact_engine_backend(
                host, "sc2d_engine", frames)
            val pixels = host.pixels()
            val receipt = host.backend_receipt()
            if (frames <= 0 or report.frames != frames or
                pixels.len() != w.to_i64() * h.to_i64() or receipt == ""):
                var reason = host.rejection_reason()
                if reason == "":
                    reason = "incomplete-exact-backend-frame-sequence"
                print "showcase status=fail renderer={backend} reason={reason}"
                host.shutdown()
                return
            if capture != "":
                val dir = _parent_dir(capture)
                if dir != "":
                    dir_create_all(dir)
                if not file_write_bytes(capture, raster_to_ppm_bytes(pixels, w, h)):
                    print "showcase status=fail renderer={backend} reason=capture-write"
                    host.shutdown()
                    return
            print (
                "showcase status=pass host={report.host_name} frames={report.frames} " +
                "clicks={report.clicks} drags={report.drags} typed=\"{report.typed_text}\" " +
                "left={report.left_offset} right={report.right_offset} " +
                "free={report.free_offset} capture={capture} {receipt}"
            )
            host.shutdown()
