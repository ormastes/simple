# Entry point for the web showcase target.
#
# Publishes each frame as HTML at SIMPLE_SHOWCASE_WEB_DOC and drains posted
# input from SIMPLE_SHOWCASE_WEB_EVENTS. Serving that document over HTTP is
# NOT done here -- see host_web.spl's header for why (ui.web's server is
# UISession-shaped and lives outside this workstream's write set).

use std.io_runtime.{env_get, mkdir_p, exit}
use app.ui_showcase.showcase_core.{showcase_run}
use app.ui_showcase.hosts.host_web.{ScreenWebHost}
use app.ui_showcase.hosts.live_interaction_evidence.{showcase_live_interaction_reason}

fn _env_i64(key: text, fallback: i64) -> i64:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    val parsed: i64? = raw.to_int()
    parsed ?? fallback

fn _parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        return ""
    path.substring(0, idx)

fn main():
    val w = _env_i64("SIMPLE_SHOWCASE_W", 800) as i32
    val h = _env_i64("SIMPLE_SHOWCASE_H", 600) as i32
    val frames = _env_i64("SIMPLE_SHOWCASE_FRAMES", 3)
    val require_interaction = env_get("SIMPLE_SHOWCASE_REQUIRE_INTERACTION").trim() == "1"
    val doc = env_get("SIMPLE_SHOWCASE_WEB_DOC").trim()
    if doc != "":
        val dir = _parent_dir(doc)
        if dir != "":
            mkdir_p(dir)
    val opened = ScreenWebHost.open_from_env(w, h)
    match opened:
        case None:
            print "showcase host=web frames=0 clicks=0 drags=0 typed=\"\" left=0 right=0 free=0"
            print "showcase web: no document path (set SIMPLE_SHOWCASE_WEB_DOC)"
            if require_interaction:
                print "showcase_web_live_status=fail reason=no-document"
                exit(1)
        case Some(host):
            val r = showcase_run(host, "scweb", frames)
            host.shutdown()
            print "showcase host={r.host_name} frames={r.frames} clicks={r.clicks} " +
                "drags={r.drags} typed=\"{r.typed_text}\" left={r.left_offset} " +
                "right={r.right_offset} free={r.free_offset}"
            print "showcase web doc={doc} html_bytes={host.last_html_len}"
            if require_interaction:
                val reason = showcase_live_interaction_reason(r)
                if reason != "":
                    print "showcase_web_live_status=fail reason={reason}"
                    exit(1)
                print "showcase_web_live_status=pass reason=interaction-complete"
