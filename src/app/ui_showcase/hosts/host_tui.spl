# ScreenHost impl #3 of 4 -- char-grid TUI target, no window, no pixels.
#
# Presents by rasterizing the DrawIrV3 scene onto the app.ui.tui char-grid
# screen model (row-major 0-based cells, box-drawing charset -- the same
# frame model app.ui.tui.screen.Screen implements). Scene coordinates are
# consumed in CELL units: entries size their host at the grid size and build
# widget trees with cell-sized rows, so layout rects map 1:1 onto cells.
# Text is the exception: v3 glyph runs ride the shared 5x7 bitmap font
# (baseline = top + 7), so a glyph's cell is derived from its run: the first
# glyph's position is the run's cell origin (glyph.y - 7 is the cell top)
# and run INDEX is the cell column -- producers emit glyph runs in visual
# order, and shaped runs carry per-glyph kerned advances that make any
# x-quantization collide kerned pairs onto one cell (observed: "text" ->
# "tet" when dividing by an estimated uniform advance).
#
# Honesty contract (same shape as host_2d's):
# - present_scene returns false when zero commands left ink on the grid, so
#   the shared loop cannot spin frames over a blank buffer.
# - Every non-hidden command is accounted for in exactly one bucket:
#   painted  (ink: box border, thin-fill shade, or an in-bounds glyph),
#   fills    (large fill-only rects = backgrounds the char grid elides),
#   unsupported (command kinds with no char mapping: PATH/EDGE/IMAGE/PORT).
#   Entries must print all three counters; nothing is silently skipped.
#   Thin fills shade only still-blank cells (put_soft), so a background rect
#   emitted after a text run can never erase the text.
#
# ingress contract (same shape as host_2d's):
# - `script` is the SAME SIMPLE_SHOWCASE_SCRIPT grammar host_2d parses
#   (click/down/move/up/wheel/type/resize, `;`-separated) -- one ingress
#   contract across headless targets. Headless: no real keyboard exists, so
#   without a script the queue is simply empty. The parser is implemented
#   locally (a copy of host_2d.screen_2d_parse_script, which is exported
#   precisely so other hosts can share the grammar) rather than imported:
#   importing host_2d would drag in hosts/scene_raster.spl, whose closure is
#   currently broken under the bootstrap-seed compiler (undefined
#   _raster_path -- NOT this lane's file to fix).

use common.ui.draw_ir_v3.{
    DrawIrV3Scene, DrawIrV3Command,
    draw_ir_v3_geometry_at, draw_ir_v3_paint_at, draw_ir_v3_text_run_at,
    draw_ir_v3_glyph_at, draw_ir_v3_has_flag,
    draw_ir_v3_clip_at, draw_ir_v3_transform_at,
    DRAW_IR_V3_KIND_NONE, DRAW_IR_V3_KIND_RECT, DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_KIND_EDGE, DRAW_IR_V3_KIND_PATH, DRAW_IR_V3_KIND_IMAGE,
    DRAW_IR_V3_KIND_GROUP, DRAW_IR_V3_KIND_PORT,
    DRAW_IR_V3_FLAG_HIDDEN, DRAW_IR_V3_NO_ID
}
use common.ui.screen_host.{ScreenHost}
use common.ui.host_input_event.{
    HostInputEvent,
    host_pointer_down, host_pointer_up, host_pointer_move, host_pointer_wheel,
    host_key_down, host_resize
}
use common.ui.glyph_bitmap_5x7.{FONT_CHARSET}
use app.ui.tui.screen.{Screen, screen_render}

# 5x7 bitmap cell metrics (common.ui.glyph_bitmap_5x7). Glyph rows quantize
# by line height (8px); glyph columns are the run index (see text_run).
val TUI_GLYPH_H: i32 = 7
val TUI_LINE_H: i32 = 8

# --- script parsing (local copy of host_2d.screen_2d_parse_script) ----------

fn _stui_int(raw: text) -> i32:
    val t = raw.trim()
    if t == "":
        return 0
    t.to_int() ?? 0

fn _stui_pair(arg: text) -> (i32, i32):
    val parts = arg.split(",")
    if parts.len() < 2:
        return (_stui_int(arg), 0)
    (_stui_int(parts[0]), _stui_int(parts[1]))

fn _stui_step(step: text, out: [HostInputEvent]) -> [HostInputEvent]:
    var events = out
    val trimmed = step.trim()
    if trimmed == "":
        return events
    val sp = trimmed.index_of(" ")
    var verb = trimmed
    var arg = ""
    if sp >= 0:
        verb = trimmed.substring(0, sp)
        arg = trimmed.substring(sp + 1, trimmed.len()).trim()
    if verb == "click":
        val (x, y) = _stui_pair(arg)
        events.push(host_pointer_down(x, y, 1))
        events.push(host_pointer_up(x, y, 1))
    else if verb == "down":
        val (x, y) = _stui_pair(arg)
        events.push(host_pointer_down(x, y, 1))
    else if verb == "move":
        val (x, y) = _stui_pair(arg)
        events.push(host_pointer_move(x, y))
    else if verb == "up":
        val (x, y) = _stui_pair(arg)
        events.push(host_pointer_up(x, y, 1))
    else if verb == "wheel":
        val parts = arg.split(",")
        if parts.len() >= 3:
            events.push(host_pointer_wheel(_stui_int(parts[0]), _stui_int(parts[1]), _stui_int(parts[2])))
    else if verb == "type":
        for ch in arg.chars():
            events.push(host_key_down(0, ch, 0))
    else if verb == "resize":
        val (x, y) = _stui_pair(arg)
        events.push(host_resize(x, y))
    events

fn tui_parse_script(script: text) -> [HostInputEvent]:
    """`SIMPLE_SHOWCASE_SCRIPT` -> ingress queue. Grammar, one step per `;`:
      click X,Y | down X,Y | move X,Y | up X,Y | wheel X,Y,N | type TEXT | resize W,H
    `click` expands to a down+up pair; unknown verbs are dropped, not guessed.
    Identical output to host_2d.screen_2d_parse_script -- if the two parsers
    ever drift, that is a bug (kept local only to stay clear of the
    scene_raster compile defect, see the header)."""
    var out: [HostInputEvent] = []
    for step in script.split(";"):
        out = _stui_step(step, out)
    out

# =========================================================================
# Char-grid rasterizer
# =========================================================================

fn _tui_charset_chars() -> [text]:
    """FONT_CHARSET split into single characters, indexable by glyph id."""
    var out: [text] = []
    for ch in FONT_CHARSET.split(""):
        if ch != "":
            out.push(ch)
    out

class TuiRaster:
    var w: i32
    var h: i32
    var screen: Screen
    # Plain mirror of the grid, one exactly-w-char row per cell row, with no
    # ANSI. It exists for two honest-render rules the opaque Screen buffer
    # cannot answer: soft fills must not clobber ink already placed (scene
    # order is not guaranteed background-first), and the capture artifact is
    # plain greppable text, not escape sequences.
    var rows: [[text]]
    var has_clip: bool
    var clip_x: i32
    var clip_y: i32
    var clip_w: i32
    var clip_h: i32
    var painted: i64
    var fills: i64
    var unsupported: i64
    var chars: [text]

    static fn _blank_rows(w: i32, h: i32) -> [[text]]:
        var rows: [[text]] = []
        var y = 0
        while y < h:
            var row: [text] = []
            var x = 0
            while x < w:
                row.push(" ")
                x = x + 1
            rows.push(row)
            y = y + 1
        rows

    static fn open(w: i32, h: i32) -> TuiRaster:
        TuiRaster(
            w: w, h: h, screen: Screen.new(w, h), rows: TuiRaster._blank_rows(w, h),
            has_clip: false, clip_x: 0, clip_y: 0, clip_w: 0, clip_h: 0,
            painted: 0, fills: 0, unsupported: 0,
            chars: _tui_charset_chars()
        )

    me clear_clip():
        self.has_clip = false
        self.clip_x = 0
        self.clip_y = 0
        self.clip_w = 0
        self.clip_h = 0

    me set_clip(x: i32, y: i32, w: i32, h: i32):
        if w <= 0 or h <= 0:
            self.clear_clip()
            return
        self.has_clip = true
        self.clip_x = x
        self.clip_y = y
        self.clip_w = w
        self.clip_h = h

    me _in_bounds(x: i32, y: i32) -> bool:
        if x < 0 or y < 0 or x >= self.w or y >= self.h:
            return false
        if self.has_clip:
            if x < self.clip_x or y < self.clip_y or
                    x >= self.clip_x + self.clip_w or y >= self.clip_y + self.clip_h:
                return false
        true

    me put(x: i32, y: i32, ch: text):
        if not self._in_bounds(x, y):
            return
        self.screen = self.screen.put_text(y, x, ch)
        val row = self.rows[y]
        row[x] = ch
        self.rows[y] = row

    me put_soft(x: i32, y: i32, ch: text):
        """Write only into a still-blank cell. Background fills use this so a
        rect emitted after a text run cannot erase the text (scene command
        order is producer-defined, not z-ordered)."""
        if not self._in_bounds(x, y):
            return
        val row = self.rows[y]
        if row[x] != " ":
            return
        self.put(x, y, ch)

    me frame_rows() -> [text]:
        """The grid as plain text rows (no ANSI), for capture artifacts."""
        var out: [text] = []
        var y = 0
        while y < self.rows.len():
            val row = self.rows[y]
            var line = ""
            var x = 0
            while x < row.len():
                line = "{line}{row[x]}"
                x = x + 1
            out.push(line)
            y = y + 1
        out

    me box(x: i32, y: i32, w: i32, h: i32):
        """Single-line box-drawing border, same charset as Screen.draw_box."""
        if w < 2 or h < 2:
            return
        var top = "\u{250c}"
        var i = 0
        while i < w - 2:
            top = "{top}\u{2500}"
            i = i + 1
        top = "{top}\u{2510}"
        var bottom = "\u{2514}"
        i = 0
        while i < w - 2:
            bottom = "{bottom}\u{2500}"
            i = i + 1
        bottom = "{bottom}\u{2518}"
        self.put(x, y, top)
        self.put(x, y + h - 1, bottom)
        i = 1
        while i < h - 1:
            self.put(x, y + i, "\u{2502}")
            self.put(x + w - 1, y + i, "\u{2502}")
            i = i + 1

    me block_fill(x: i32, y: i32, w: i32, h: i32):
        """Thin fill-only rect (scrollbar thumb, rule line, a row-height widget
        background) as light-shade ink. Uses put_soft: fills shade blank
        cells but never erase text or borders already placed, regardless of
        scene command order."""
        var yy = y
        while yy < y + h:
            var xx = x
            while xx < x + w:
                self.put_soft(xx, yy, "\u{2591}")
                xx = xx + 1
            yy = yy + 1

    me rect(scene: DrawIrV3Scene, cmd: DrawIrV3Command, ox: i32, oy: i32):
        val geom = draw_ir_v3_geometry_at(scene.geometry, cmd.geometry_id)
        if not geom.present or geom.width <= 0 or geom.height <= 0:
            return
        val paint = draw_ir_v3_paint_at(scene.paint, cmd.paint_id)
        var stroke_px = 0
        if paint.present:
            stroke_px = paint.stroke_width_milli / 1000
        val x = geom.x + ox
        val y = geom.y + oy
        if stroke_px > 0:
            self.box(x, y, geom.width, geom.height)
            self.painted = self.painted + 1
            return
        if geom.width <= 2 or geom.height <= 2:
            # Scrollbar thumbs / rule lines / row-height backgrounds: a 1-2
            # cell sliver of pure background would be invisible, so thin
            # fills keep light-shade ink (never clobbering existing ink).
            self.block_fill(x, y, geom.width, geom.height)
            self.painted = self.painted + 1
            return
        # Large fill-only rect: a background panel. The char grid carries
        # structure (borders + text), not background color, so this is
        # accounted in `fills`, never drawn and never silently dropped.
        self.fills = self.fills + 1

    me text_run(scene: DrawIrV3Scene, cmd: DrawIrV3Command, ox: i32, oy: i32):
        val run = draw_ir_v3_text_run_at(scene.text_runs, cmd.text_run_id)
        if not run.present or run.glyph_count == 0u32:
            return
        val start = run.glyph_start.to_i64()
        val count = run.glyph_count.to_i64()
        val g0 = draw_ir_v3_glyph_at(scene.text_runs, start as u32)
        if not g0.present:
            return
        # Glyph placement is by RUN INDEX, not by re-quantizing each glyph's
        # x: shaped runs have per-glyph (kerned) advances, so dividing by an
        # estimated uniform advance collides kerned glyph pairs onto one cell
        # (observed: "text" -> "tet"). Every producer of v3 glyph runs in this
        # pipeline (widget_draw_ir._charset_glyph_run, showcase_core's
        # authored _charset_run, the shaper) emits glyphs in visual order, so
        # run index == cell column. Rows still derive from the baseline delta
        # (multi-line runs advance y by line height).
        val x0 = g0.x + ox
        val y0 = g0.y - TUI_GLYPH_H + oy
        var placed_any = false
        var i: i64 = 0
        while i < count:
            val glyph = draw_ir_v3_glyph_at(scene.text_runs, (start + i) as u32)
            if glyph.present:
                val gid = glyph.glyph_id.to_i64()
                var ch = "?"
                if gid >= 0 and gid < self.chars.len().to_i64():
                    ch = self.chars[gid]
                val col = i
                val row = (glyph.y - g0.y + TUI_LINE_H / 2) / TUI_LINE_H
                if col + x0 >= 0 and col + x0 < self.w and row + y0 >= 0 and row + y0 < self.h:
                    placed_any = true
                self.put((x0 + col) as i32, (y0 + row) as i32, ch)
            i = i + 1
        if placed_any:
            self.painted = self.painted + 1

fn raster_scene_tui(r: TuiRaster, scene: DrawIrV3Scene):
    """Walk `scene` top-down into the char grid. Same group contract as
    hosts/scene_raster.spl: a GROUP's transform dx/dy offsets its children
    (children are authored group-local) and a GROUP clip constrains them;
    children are the commands whose parent_id matches the GROUP's
    component_id, and groups never nest, so one open-group cursor suffices."""
    var i: i64 = 0
    val n = scene.commands.len().to_i64()
    var cur_group_id: u32 = DRAW_IR_V3_NO_ID
    var cur_off_x: i32 = 0
    var cur_off_y: i32 = 0
    while i < n:
        val cmd = scene.commands[i]
        if cmd.kind == DRAW_IR_V3_KIND_GROUP and not draw_ir_v3_has_flag(cmd, DRAW_IR_V3_FLAG_HIDDEN):
            cur_group_id = cmd.component_id
            var dx: i32 = 0
            var dy: i32 = 0
            if cmd.transform_id != DRAW_IR_V3_NO_ID:
                val transform = draw_ir_v3_transform_at(scene.transforms, cmd.transform_id)
                if transform.present:
                    dx = transform.dx
                    dy = transform.dy
            cur_off_x = dx
            cur_off_y = dy
            var clipped = false
            if cmd.clip_id != DRAW_IR_V3_NO_ID:
                val clip = draw_ir_v3_clip_at(scene.clips, cmd.clip_id)
                if clip.present and clip.width > 0 and clip.height > 0:
                    r.set_clip(dx + clip.x, dy + clip.y, clip.width, clip.height)
                    clipped = true
            if not clipped:
                r.clear_clip()
        else:
            if cmd.parent_id != cur_group_id:
                cur_group_id = DRAW_IR_V3_NO_ID
                cur_off_x = 0
                cur_off_y = 0
                r.clear_clip()
            if not draw_ir_v3_has_flag(cmd, DRAW_IR_V3_FLAG_HIDDEN):
                if cmd.kind == DRAW_IR_V3_KIND_RECT:
                    if cmd.geometry_id != DRAW_IR_V3_NO_ID:
                        r.rect(scene, cmd, cur_off_x, cur_off_y)
                else if cmd.kind == DRAW_IR_V3_KIND_TEXT:
                    if cmd.text_run_id != DRAW_IR_V3_NO_ID:
                        r.text_run(scene, cmd, cur_off_x, cur_off_y)
                else:
                    # PATH / EDGE / IMAGE / PORT / NONE: no honest char-grid
                    # mapping exists (paths would need line rasterization the
                    # cell grid cannot express without faking). Counted, so
                    # the status line can report unsupported=<n>.
                    r.unsupported = r.unsupported + 1
        i = i + 1
    r.clear_clip()

# =========================================================================
# The host
# =========================================================================

class ScreenTuiHost:
    var w: i32
    var h: i32
    var raster: TuiRaster
    var queue: [HostInputEvent]
    var cursor: i64
    var frames_painted: i64

    static fn open(w: i32, h: i32, script: text) -> ScreenTuiHost:
        """`script` is the SAME SIMPLE_SHOWCASE_SCRIPT grammar host_2d parses
        (click/down/move/up/wheel/type/resize, `;`-separated) -- one ingress
        contract across headless targets. Headless: no real keyboard exists,
        so without a script the queue is simply empty."""
        ScreenTuiHost(
            w: w, h: h, raster: TuiRaster.open(w, h),
            queue: tui_parse_script(script), cursor: 0, frames_painted: 0
        )

    me last_painted_commands() -> i64:
        self.raster.painted

    me last_fill_commands() -> i64:
        self.raster.fills

    me last_unsupported_commands() -> i64:
        self.raster.unsupported

    me frame_text() -> text:
        """The last presented frame as plain text rows joined by newlines --
        the SIMPLE_SHOWCASE_CAPTURE artifact. No ANSI escapes, so capture
        gates can grep for widget labels directly."""
        var out = ""
        val rows = self.raster.frame_rows()
        var i = 0
        while i < rows.len():
            if i > 0:
                out = "{out}\n"
            out = "{out}{rows[i]}"
            i = i + 1
        out

    me frame_ansi() -> text:
        """The same frame as an ANSI terminal dump (the bytes a live TUI
        would write), built on the app.ui.tui Screen buffer."""
        screen_render(self.raster.screen)

impl ScreenHost for ScreenTuiHost:
    me host_name() -> text:
        "tui"

    me size() -> (i32, i32):
        (self.w, self.h)

    me present_scene(scene: DrawIrV3Scene) -> bool:
        # Fresh raster per frame: content that disappears must not leave
        # stale cells behind (same reset contract as host_2d's surface).
        self.raster = TuiRaster.open(self.w, self.h)
        raster_scene_tui(self.raster, scene)
        if self.raster.painted <= 0:
            return false
        self.frames_painted = self.frames_painted + 1
        true

    me poll_input() -> HostInputEvent?:
        if self.cursor >= self.queue.len().to_i64():
            return nil
        val ev = self.queue[self.cursor]
        self.cursor = self.cursor + 1
        match ev:
            HostInputEvent.Resize(resize_w, resize_h):
                if resize_w > 0 and resize_h > 0:
                    self.w = resize_w
                    self.h = resize_h
                    self.raster = TuiRaster.open(resize_w, resize_h)
            _:
                pass
        ev

    me shutdown():
        self.cursor = self.queue.len().to_i64()

export ScreenTuiHost, raster_scene_tui, TuiRaster, tui_parse_script
