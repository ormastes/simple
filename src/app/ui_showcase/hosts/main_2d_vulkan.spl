# Entry point for the Vulkan-only 2D showcase capture.

use common.ui.draw_ir.{DRAW_IR_BACKEND_GPU}
use app.io.mod.{dir_create_all, env_get, file_write_bytes, file_write_text}
use app.ui_showcase.hosts.host_2d_vulkan.{
    Screen2dVulkanHost, showcase_run_with_backend
}
use app.ui_showcase.hosts.scene_raster.{raster_to_ppm_bytes}

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

fn _parent_dir(path: text) -> text:
    val index = path.last_index_of("/")
    if index <= 0:
        return ""
    path.substring(0, index)

fn main():
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 20).to_i64()
    val script = env_get("SIMPLE_SHOWCASE_SCRIPT")
    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    val cpu_capture = env_get("SIMPLE_SHOWCASE_CPU_CAPTURE").trim()
    val probe_dir = env_get("MCI_RENDERING_PROBE_DIR").trim()

    match Screen2dVulkanHost.open(w, h, script):
        case None:
            print "showcase status=blocked renderer=vulkan reason=vulkan-device-unavailable"
        case Some(host):
            val report = showcase_run_with_backend(
                host, "sc2d_vulkan", frames, DRAW_IR_BACKEND_GPU)
            val pixels = host.pixels()
            val receipt = host.device_receipt()
            if (frames <= 0 or report.frames != frames or
                pixels.len() != w.to_i64() * h.to_i64() or receipt == ""):
                var reason = host.rejection_reason()
                if reason == "":
                    reason = "incomplete-device-frame-sequence"
                print "showcase status=fail renderer=vulkan reason={reason}"
                host.shutdown()
                return
            if capture != "":
                val dir = _parent_dir(capture)
                if dir != "":
                    dir_create_all(dir)
                if not file_write_bytes(capture, raster_to_ppm_bytes(pixels, w, h)):
                    print "showcase status=fail renderer=vulkan reason=capture-write"
                    host.shutdown()
                    return
            if cpu_capture != "":
                val cpu_dir = _parent_dir(cpu_capture)
                if cpu_dir != "":
                    dir_create_all(cpu_dir)
                if not file_write_bytes(cpu_capture,
                        raster_to_ppm_bytes(host.cpu_pixels(), w, h)):
                    print "showcase status=fail renderer=vulkan reason=cpu-capture-write"
                    host.shutdown()
                    return
            if probe_dir != "":
                dir_create_all(probe_dir)
                val semantic = host.composition_sdn()
                file_write_text("{probe_dir}/composition.bin", semantic)
                file_write_text("{probe_dir}/gui.drawir", semantic)
                file_write_text("{probe_dir}/web.drawir", host.web_bytes())
                var packed = ""
                for _ in 0..host.command_count():
                    packed = packed + "command\n"
                for _ in 0..host.glyph_count():
                    packed = packed + "glyph\n"
                for _ in 0..host.image_count():
                    packed = packed + "image\n"
                file_write_text("{probe_dir}/packed.events", packed)
                file_write_text("{probe_dir}/interaction.events",
                    "focus\nkey_input\npointer_down\npointer_up\nclick\n")
                file_write_text("{probe_dir}/perf.samples",
                    host.latency_samples_ns())
                file_write_text("{probe_dir}/queue.env", host.queue_receipt())
                file_write_text("{probe_dir}/backend.env",
                    host.packed_frame_receipt())
                file_write_text("{probe_dir}/packed.identity",
                    host.packed_identity_artifact())
                file_write_text("{probe_dir}/fallback.events", host.fallback_events())
                file_write_text("{probe_dir}/drawir.entries", packed)
                file_write_text("{probe_dir}/transient-owner.env",
                    host.transient_inventory())
                file_write_text("{probe_dir}/allocation.events",
                    host.packed_capacity_events())
                file_write_text("{probe_dir}/queue.events",
                    host.packed_capacity_events())
                file_write_text("{probe_dir}/inflight.events",
                    host.packed_capacity_events())
                file_write_text("{probe_dir}/overflow.before",
                    host.packed_before_state())
                file_write_text("{probe_dir}/overflow.after",
                    host.packed_after_state())
            print (
                "showcase status=pass host={report.host_name} frames={report.frames} " +
                "clicks={report.clicks} drags={report.drags} typed=\"{report.typed_text}\" " +
                "left={report.left_offset} right={report.right_offset} " +
                "free={report.free_offset} capture={capture} {receipt}"
            )
            host.shutdown()
