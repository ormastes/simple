# ScreenHost impl #2 of 4 -- real OS window via GuiRenderer (SDL2/winit).
#
# Wraps the raw-pixel GuiRenderer exactly as src/app/browser/gui_window.spl
# does: `present_argb_u32(w, h, pixels)` out, `poll_event()` in. The only
# GUI-specific logic in this file is `gui_event_to_host`, which is module-level
# and exported precisely so it is unit-testable with no display, no SDL and no
# window -- it is the part that can actually be wrong.
#
# Requires build/sffi/libspl_winit.<so|dylib|dll> and a reachable display.
# `open` returns nil when GuiRenderer.create fails, so a headless run reports
# frames=0 instead of a plausible-looking transcript over no window.

use nogc_sync_mut.ui.gui_renderer.{
    GuiRenderer, GuiEvent,
    GUI_EVT_NONE, GUI_EVT_CLOSE, GUI_EVT_RESIZED,
    GUI_EVT_KEYBOARD, GUI_EVT_MOUSE_BUTTON, GUI_EVT_MOUSE_MOVED, GUI_EVT_MOUSE_WHEEL
}
use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.screen_host.{ScreenHost}
use common.ui.key_code.{
    winit_keycode_to_canon,
    CANON_A, CANON_Z, CANON_0, CANON_9, CANON_SPACE,
    CANON_SEMICOLON, CANON_EQUALS, CANON_COMMA, CANON_MINUS, CANON_PERIOD,
    CANON_SLASH, CANON_BACKTICK, CANON_LEFT_BRACKET, CANON_BACKSLASH,
    CANON_RIGHT_BRACKET, CANON_QUOTE
}
use common.ui.host_input_event.{
    HostInputEvent, HOST_BTN_LEFT, HOST_BTN_RIGHT, HOST_BTN_MIDDLE, HOST_BTN_NONE,
    host_pointer_down, host_pointer_up, host_pointer_move, host_pointer_wheel,
    host_key_down, host_key_up, host_resize
}
use app.ui_showcase.hosts.scene_raster.{raster_scene_argb}

fn gui_button_to_host(btn: i64) -> i64:
    """GuiRenderer button code -> HOST_BTN_*. winit/SDL both report
    left=0, right=1, middle=2. An unrecognised code becomes HOST_BTN_NONE
    rather than being guessed into a left click."""
    if btn == 0:
        return HOST_BTN_LEFT
    if btn == 1:
        return HOST_BTN_RIGHT
    if btn == 2:
        return HOST_BTN_MIDDLE
    HOST_BTN_NONE

fn gui_canon_to_ch(code: i64) -> text:
    """Unshifted printable glyph for a canonical key code, "" otherwise.

    The spl_winit FFI exposes typed text only as separate GUI_EVT_TEXT_INPUT
    records whose accessors need the native handle -- and poll_event frees
    that handle before returning -- so no character is available on the
    keyboard event itself. Like the SDL2 producer's unshifted table
    (hosted_input_sdl2.spl), letters map to lowercase and digits/punctuation
    to their unshifted glyphs; shift would arrive as a modifier bit, which
    GuiEvent does not carry."""
    if code >= CANON_A and code <= CANON_Z:
        val letters = "abcdefghijklmnopqrstuvwxyz"
        return letters[code - CANON_A:code - CANON_A + 1]
    if code >= CANON_0 and code <= CANON_9:
        val digits = "0123456789"
        return digits[code - CANON_0:code - CANON_0 + 1]
    if code == CANON_SPACE: return " "
    if code == CANON_SEMICOLON: return ";"
    if code == CANON_EQUALS: return "="
    if code == CANON_COMMA: return ","
    if code == CANON_MINUS: return "-"
    if code == CANON_PERIOD: return "."
    if code == CANON_SLASH: return "/"
    if code == CANON_BACKTICK: return "`"
    if code == CANON_LEFT_BRACKET: return "["
    if code == CANON_BACKSLASH: return "\\"
    if code == CANON_RIGHT_BRACKET: return "]"
    if code == CANON_QUOTE: return "'"
    ""

fn gui_event_to_host(ev: GuiEvent) -> HostInputEvent?:
    """The whole GUI->widget ingress translation, in one testable function.

    Returns nil for GUI_EVT_NONE (idle) and for GUI_EVT_CLOSE -- close is a
    lifecycle signal, not an input event, and the host turns it into a false
    from `present_scene` instead.

    Wheel events translate the RAW winit delta as-is (positive = scroll-UP)
    at position (0, 0): the winit wheel record carries no pointer position,
    so `ScreenGuiHost.poll_input` re-issues wheel events at the last tracked
    cursor position with the sign flipped to the canonical
    positive = content-scrolls-DOWN convention."""
    val x = ev.x.to_i64() as i32
    val y = ev.y.to_i64() as i32
    if ev.kind == GUI_EVT_MOUSE_BUTTON:
        val btn = gui_button_to_host(ev.btn)
        if ev.pressed:
            return host_pointer_down(x, y, btn)
        return host_pointer_up(x, y, btn)
    if ev.kind == GUI_EVT_MOUSE_MOVED:
        return host_pointer_move(x, y)
    if ev.kind == GUI_EVT_MOUSE_WHEEL:
        # Raw winit delta passthrough (see the docstring); poll_input owns
        # the position fill-in and the sign flip.
        return host_pointer_wheel(0, 0, y)
    if ev.kind == GUI_EVT_KEYBOARD:
        # Producer contract (host_input_event.spl): raw codes route through
        # the matching *_to_canon mapper; unmapped keys become CANON_UNKNOWN
        # (0), never a guess. ch carries the unshifted printable glyph.
        val code = winit_keycode_to_canon(ev.keycode)
        val ch = gui_canon_to_ch(code)
        if ev.pressed:
            return host_key_down(code, ch, 0)
        return host_key_up(code, ch, 0)
    if ev.kind == GUI_EVT_RESIZED:
        return host_resize(x, y)
    nil

class ScreenGuiHost:
    var g: GuiRenderer
    var w: i32
    var h: i32
    var closed: bool
    # Last known cursor position. winit wheel (and button) records carry no
    # pointer coordinates, so wheel events are re-issued at this position --
    # showcase_apply hit-tests scroll at the event position, and (0, 0) is
    # the menubar, which never scrolls a panel.
    var mouse_x: i32
    var mouse_y: i32

    static fn open(w: i32, h: i32, title: text) -> ScreenGuiHost?:
        """nil when no window could be created (no display, no libspl_winit).
        A caller that gets nil must report frames=0, not fabricate a run."""
        val created = GuiRenderer.create("auto", w, h, title)
        match created:
            case None:
                nil
            case Some(gui):
                ScreenGuiHost(g: gui, w: w, h: h, closed: false, mouse_x: 0, mouse_y: 0)

impl ScreenHost for ScreenGuiHost:
    me host_name() -> text:
        "gui"

    me size() -> (i32, i32):
        (self.w, self.h)

    me present_scene(scene: DrawIrV3Scene) -> bool:
        if self.closed:
            return false
        val px = raster_scene_argb(scene, self.w, self.h)
        self.g.present_argb_u32(self.w.to_i64(), self.h.to_i64(), px)

    me poll_input() -> HostInputEvent?:
        if self.closed:
            return nil
        val ev = self.g.poll_event()
        if ev.kind == GUI_EVT_CLOSE:
            self.closed = true
            return nil
        if ev.kind == GUI_EVT_NONE:
            return nil
        if ev.kind == GUI_EVT_MOUSE_MOVED:
            self.mouse_x = ev.x.to_i64() as i32
            self.mouse_y = ev.y.to_i64() as i32
        if ev.kind == GUI_EVT_MOUSE_WHEEL:
            # The winit wheel record carries deltas, not a position -- use the
            # last tracked cursor position. winit LineDelta.y is positive for
            # scroll-UP while the ingress contract (host_input_event.spl) is
            # positive = content scrolls DOWN, so flip once here -- the same
            # single negation the SDL2 producer documents in
            # sdl2_wheel_to_mouse_wheel.
            val notch = ev.y.to_i64() as i32
            return host_pointer_wheel(self.mouse_x, self.mouse_y, 0 - notch)
        val out = gui_event_to_host(ev)
        if out != nil:
            # Resize is a public layout update, not merely another input
            # record -- keep size() coherent for the next present_scene,
            # mirroring ScreenWmHost.poll_input.
            match out!:
                HostInputEvent.Resize(resize_w, resize_h):
                    if resize_w > 0 and resize_h > 0:
                        self.w = resize_w
                        self.h = resize_h
                _:
                    pass
        out

    me shutdown():
        if not self.closed:
            self.closed = true
            self.g.close()

export ScreenGuiHost, gui_event_to_host, gui_button_to_host, gui_canon_to_ch
