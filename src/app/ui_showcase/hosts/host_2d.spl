# ScreenHost impl #1 of 4 -- raw 2D framebuffer, no window manager.
#
# Presents by rasterizing the DrawIrV3 scene into a software ARGB surface
# (hosts/scene_raster.spl) and keeping the last frame for capture. Input is
# script-driven: there is no window to click, so `SIMPLE_SHOWCASE_SCRIPT`
# seeds a synthetic HostInputEvent queue. Real driver-origin input on this
# target is Workstream C's job; this host only owns the seam.
#
# Honesty contract: `present_scene` returns false when the scene painted zero
# commands. A host that unconditionally returns true would let the shared loop
# spin `max_frames` and print a plausible `frames=N` line over a blank buffer
# -- the exact vacuous-pass shape this repo has been bitten by.

use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.screen_host.{ScreenHost}
use common.ui.host_input_event.{
    HostInputEvent,
    host_pointer_down, host_pointer_up, host_pointer_move, host_pointer_wheel,
    host_key_down, host_resize
}
use app.ui_showcase.hosts.scene_raster.{RasterSurface, RASTER_BG, raster_scene_into}

# --- script parsing -------------------------------------------------------

fn _s2d_int(raw: text) -> i32:
    val t = raw.trim()
    if t == "":
        return 0
    t.to_int() ?? 0

fn _s2d_pair(arg: text) -> (i32, i32):
    val parts = arg.split(",")
    if parts.len() < 2:
        return (_s2d_int(arg), 0)
    (_s2d_int(parts[0]), _s2d_int(parts[1]))

fn _s2d_step(step: text, out: [HostInputEvent]) -> [HostInputEvent]:
    var events = out
    val trimmed = step.trim()
    if trimmed == "":
        return events
    val sp = trimmed.index_of(" ")
    var verb = trimmed
    var arg = ""
    if sp >= 0:
        verb = trimmed.substring(0, sp)
        arg = trimmed.substring(sp + 1, trimmed.len()).trim()
    if verb == "click":
        val (x, y) = _s2d_pair(arg)
        events.push(host_pointer_down(x, y, 1))
        events.push(host_pointer_up(x, y, 1))
    else if verb == "down":
        val (x, y) = _s2d_pair(arg)
        events.push(host_pointer_down(x, y, 1))
    else if verb == "move":
        val (x, y) = _s2d_pair(arg)
        events.push(host_pointer_move(x, y))
    else if verb == "up":
        val (x, y) = _s2d_pair(arg)
        events.push(host_pointer_up(x, y, 1))
    else if verb == "wheel":
        val parts = arg.split(",")
        if parts.len() >= 3:
            events.push(host_pointer_wheel(_s2d_int(parts[0]), _s2d_int(parts[1]), _s2d_int(parts[2])))
    else if verb == "type":
        for ch in arg.chars():
            events.push(host_key_down(0, ch, 0))
    else if verb == "resize":
        val (w, h) = _s2d_pair(arg)
        events.push(host_resize(w, h))
    events

fn screen_2d_parse_script(script: text) -> [HostInputEvent]:
    """`SIMPLE_SHOWCASE_SCRIPT` -> ingress queue.

    Grammar, one step per `;`:
      click X,Y | down X,Y | move X,Y | up X,Y | wheel X,Y,N | type TEXT | resize W,H
    `click` expands to a down+up pair so a scripted click is indistinguishable
    from a real one at the reducer. Unknown verbs are dropped, not guessed."""
    var out: [HostInputEvent] = []
    for step in script.split(";"):
        out = _s2d_step(step, out)
    out

# --- the host -------------------------------------------------------------

class Screen2dHost:
    var w: i32
    var h: i32
    var surface: RasterSurface
    var queue: [HostInputEvent]
    var cursor: i64
    var frames_painted: i64
    var last_painted_commands: i64

    static fn open(w: i32, h: i32, script: text) -> Screen2dHost:
        Screen2dHost(
            w: w, h: h,
            surface: RasterSurface.new(w, h, RASTER_BG),
            queue: screen_2d_parse_script(script),
            cursor: 0, frames_painted: 0, last_painted_commands: 0
        )

    me pixels() -> [u32]:
        self.surface.pixels

impl ScreenHost for Screen2dHost:
    me host_name() -> text:
        "2d"

    me size() -> (i32, i32):
        (self.w, self.h)

    me present_scene(scene: DrawIrV3Scene) -> bool:
        # The surface is allocated once, so it must be reset every frame --
        # raster_scene_argb gets the same effect by starting from a fresh
        # background each call. Without this, content that disappears leaves
        # stale pixels behind.
        self.surface.clear(RASTER_BG)
        val painted = raster_scene_into(self.surface, scene)
        self.last_painted_commands = painted
        if painted <= 0:
            return false
        self.frames_painted = self.frames_painted + 1
        true

    me poll_input() -> HostInputEvent?:
        if self.cursor >= self.queue.len().to_i64():
            return nil
        val ev = self.queue[self.cursor]
        self.cursor = self.cursor + 1
        ev

    me shutdown():
        self.cursor = self.queue.len().to_i64()

export Screen2dHost, screen_2d_parse_script
