# GPU-backed Screen2D showcase host (Metal or Vulkan, selected at open).
#
# Sibling of host_2d_vulkan.spl (the narrow strict-primitives lane): accepts
# the original DrawIrComposition, owns one persistent Engine2D surface on the
# chosen backend, and accepts a frame only after the executor returns real
# device readback with complete command coverage (no skipped commands, no
# fallback) — plus a backend font-execution receipt when the composition
# carries text. The strict_vulkan executor preflight rejects the glass-themed
# showcase content outright (it admits only opaque rects on one full-surface
# batch; the theme emits translucent rects across multiple batches), so the
# general executor is used here and the receipt checks live in this host.

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU, DRAW_IR_COMMAND_TEXT, DrawIrComposition
}
use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.host_input_event.{HostInputEvent}
use common.ui.screen_host.{ScreenHost}
use common.ui.widget.{UIState}
use gpu.engine2d.engine.{Engine2D}
use app.ui_showcase.hosts.scene_raster.{RASTER_BG}
use gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult, Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_with_images
}
use app.ui_showcase.hosts.host_2d.{screen_2d_parse_script}
use app.ui_showcase.showcase_core.{
    ShowcaseRunReport, showcase_apply, showcase_build, showcase_composition, showcase_report
}

fn _composition_has_text(composition: DrawIrComposition) -> bool:
    for batch in composition.batches:
        for command in batch.commands:
            if command.? != false and command.kind == DRAW_IR_COMMAND_TEXT:
                return true
    false

class Screen2dGpuHost:
    var w: i32
    var h: i32
    var backend: text
    var engine: Engine2D
    var queue: [HostInputEvent]
    var cursor: i64
    var last_pixels: [u32]
    var last_receipt: text
    var last_rejection: text

    static fn open(w: i32, h: i32, script: text, backend: text) -> Screen2dGpuHost?:
        if w <= 0 or h <= 0 or (backend != "metal" and backend != "vulkan"):
            return nil
        val engine = Engine2D.create_with_backend_fast(w, h, backend)
        if engine.backend_name() != backend:
            engine.shutdown()
            return nil
        Screen2dGpuHost(
            w: w, h: h, backend: backend, engine: engine,
            queue: screen_2d_parse_script(script), cursor: 0,
            last_pixels: [], last_receipt: "", last_rejection: "not-rendered"
        )

    me _reject(reason: text) -> bool:
        self.last_pixels = []
        self.last_receipt = ""
        self.last_rejection = reason
        false

    me _accept_result(composition: DrawIrComposition) -> bool:
        if composition.backend_target != DRAW_IR_BACKEND_GPU:
            return self._reject("metal-host-requires-gpu-composition")
        var images: [Engine2dResolvedDrawIrImage] = []
        val result: Engine2dDrawIrAdvResult =
            engine2d_draw_ir_adv_composition_with_images(
                self.engine, composition, true, images)
        val expected_pixels = self.w.to_i64() * self.h.to_i64()
        if (result.selected_backend != "gpu" or result.fallback_required or
            result.fallback_reason != "" or result.skipped_command_count != 0 or
            result.rendered_command_count <= 0 or
            result.readback_source != "device_readback" or
            result.backend_handle <= 0 or result.device_identity <= 0 or
            result.readback_checksum <= 0 or
            result.pixels.len() != expected_pixels):
            return self._reject("metal-drawir-receipt-rejected")
        # Font receipt: when the composition carries text it must have executed
        # through the Metal font target, not silently fallen to the CPU mirror.
        # The proof available per backend differs in shape: the strict Vulkan
        # host pins batch identity/oracle checksum/device_executed, which are
        # vulkan-batch-shaped fields; the Metal font composite does not
        # populate those — its execution proof is the attempt-loop winner being
        # "metal" (the CPU mirror never claims that name).
        if _composition_has_text(composition) and
            result.font_execution_target != self.backend:
            return self._reject("metal-font-receipt-rejected")
        self.last_pixels = result.pixels
        self.last_receipt = (
            "renderer={self.backend} source={result.readback_source} " +
            "backend_handle={result.backend_handle} device_identity={result.device_identity} " +
            "checksum={result.readback_checksum} rendered={result.rendered_command_count} " +
            "font_target={result.font_execution_target}"
        )
        self.last_rejection = ""
        true

    me present_composition(composition: DrawIrComposition) -> bool:
        self._accept_result(composition)

    me pixels() -> [u32]: self.last_pixels
    fn device_receipt() -> text: self.last_receipt
    fn rejection_reason() -> text: self.last_rejection

impl ScreenHost for Screen2dGpuHost:
    me host_name() -> text: "2d-gpu-" + self.backend
    me size() -> (i32, i32): (self.w, self.h)

    me present_scene(_scene: DrawIrV3Scene) -> bool:
        self._reject("metal-host-requires-original-composition")

    me poll_input() -> HostInputEvent?:
        if self.cursor >= self.queue.len().to_i64():
            return nil
        val event = self.queue[self.cursor]
        self.cursor = self.cursor + 1
        event

    me shutdown():
        self.cursor = self.queue.len().to_i64()
        self.engine.shutdown()

fn showcase_run_gpu(host: Screen2dGpuHost, prefix: text,
                      max_frames: i64, backend: text) -> ShowcaseRunReport:
    """Run the shared showcase reducer while preserving DrawIrComposition.
    Mirrors showcase_run_with_backend (host_2d_vulkan.spl) for the Metal host
    type — the loop is tiny and typed per concrete host on purpose."""
    var state: UIState = showcase_build(prefix)
    var frames: i64 = 0
    while frames < max_frames:
        val (w, h) = host.size()
        # Frame start on Metal = clear the device framebuffer, the same
        # per-frame contract the 2D software host applies (surface.clear);
        # without it, screen switches leave stale pixels showing through the
        # glass theme's translucent surfaces. Skipped on Vulkan: a failed
        # clear dispatch there flips completion_unknown and silently poisons
        # the rest of the frame's embedded composites (see
        # doc/08_tracking/bug/vulkan_engine2d_sequential_frames_flaky_moltenvk_2026-09-02.md).
        if backend == "metal":
            host.engine.clear(RASTER_BG)
        val composition = showcase_composition(state, w, h, backend)
        if not host.present_composition(composition):
            break
        frames = frames + 1
        var event = host.poll_input()
        while event != nil:
            state = showcase_apply(state, event!, w, h)
            event = host.poll_input()
    showcase_report(state, host.host_name(), frames)

export Screen2dGpuHost, showcase_run_gpu
