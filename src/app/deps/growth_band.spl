# Growth-band gate — src/app/deps/growth_band.spl
#
# Phase E of doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md
# promises "a spec [that] compares two committed snapshots and fails on
# unexplained growth beyond a configured band". This module owns that decision.
#
# It is a pure verdict function over two already-measured snapshot counts (the
# CLI-dir-aggregate closure size recorded in
# doc/10_metrics/startup/coupling_cohesion_baseline_2026-08-17.md); it does not
# itself measure anything, so a caller can never launder an unmeasured delta
# through it.
#
# Contract (fail-closed): a non-positive baseline, a negative current count, or
# a negative band never returns a passing verdict. Only a real, computed
# same-or-smaller count, or growth within the configured band, returns
# "within_band".

val GROWTH_BAND_WITHIN: text = "within_band"
val GROWTH_BAND_BEYOND: text = "growth_beyond_band"
val GROWTH_BAND_ERR_BASELINE: text = "error:invalid_baseline"
val GROWTH_BAND_ERR_CURRENT: text = "error:invalid_current"
val GROWTH_BAND_ERR_BAND: text = "error:invalid_band"

fn _growth_band_to_f64(n: i64) -> f64:
    n * 1.0

fn deps_growth_band_verdict(baseline_edges: i64, current_edges: i64, band_pct: f64) -> text:
    """Verdict for a before/after snapshot pair against a configured growth band.

    Returns "within_band" when the current count is at most the baseline, or
    when its relative growth is within `band_pct` (0.15 == 15%); otherwise
    "growth_beyond_band". Invalid inputs return an explicit "error:*" verdict
    and never a pass.
    """
    if baseline_edges <= 0:
        return GROWTH_BAND_ERR_BASELINE
    if current_edges < 0:
        return GROWTH_BAND_ERR_CURRENT
    if band_pct < 0.0:
        return GROWTH_BAND_ERR_BAND
    if current_edges <= baseline_edges:
        return GROWTH_BAND_WITHIN
    val grown = _growth_band_to_f64(current_edges - baseline_edges)
    val base = _growth_band_to_f64(baseline_edges)
    if grown / base <= band_pct:
        return GROWTH_BAND_WITHIN
    GROWTH_BAND_BEYOND
