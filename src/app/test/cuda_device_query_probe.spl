"""Native CUDA device-query probe: init, count, first device name and capability.

Launches nothing. Prints one CUDA_DEVICE_QUERY line per step so a native
binary's provider routing can be read from stdout, with or without a GPU.
Used by scripts/check/check-cuda-device-query-native.shs.
"""

extern fn rt_cuda_init() -> i64
extern fn rt_cuda_device_count() -> i64
extern fn rt_cuda_device_get(device_id: i64) -> i64
extern fn rt_cuda_device_name(device: i64) -> text
extern fn rt_cuda_device_compute_capability(device: i64) -> i64
extern fn rt_cuda_get_error_string(error_code: i64) -> text

fn main():
    val init_rc = rt_cuda_init()
    print "CUDA_DEVICE_QUERY init={init_rc}"
    val count = rt_cuda_device_count()
    print "CUDA_DEVICE_QUERY count={count}"
    val device = rt_cuda_device_get(0)
    print "CUDA_DEVICE_QUERY device={device} error={rt_cuda_get_error_string(device)}"
    val name = rt_cuda_device_name(device)
    val capability = rt_cuda_device_compute_capability(device)
    print "CUDA_DEVICE_QUERY name={name} capability={capability}"
    print "CUDA_DEVICE_QUERY done"
