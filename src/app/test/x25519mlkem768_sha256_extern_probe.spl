"""Isolate WHICH extern drops out under the JIT: rt_text_to_bytes or
rt_tls13_sha256. `sha256_text` returns "" under the JIT; this splits the two
calls so the empty one is named rather than inferred."""

extern fn rt_text_to_bytes(s: text) -> [u8]
extern fn rt_tls13_sha256(data: [u8]) -> [u8]

fn main():
    val bytes = rt_text_to_bytes("abc")
    print("PROBE text_to_bytes len=" + bytes.len().to_text())
    val digest = rt_tls13_sha256(bytes)
    print("PROBE tls13_sha256 len=" + digest.len().to_text())
    var first = 0
    if digest.len() > 0:
        first = digest[0] as i64
    print("PROBE tls13_sha256 first_byte=" + first.to_text())
    print("PROBE VERDICT: PASS")
