# Typed end-to-end final-evidence boundary for CUDA and Vulkan.
#
# It calls the real GPU dispatcher and consumes only the dispatcher's typed,
# same-run public observation.  Callers cannot pair a receipt with arbitrary
# A/B/C values or supply precomputed digest text.  Metal stays unavailable.

mod app.test.x25519mlkem768_gpu_final_evidence

use app.test.x25519mlkem768_gpu_dispatch.{
    X25519MlKem768GpuDispatchRequest, x25519_mlkem768_dispatch_gpu}
use app.test.x25519mlkem768_gpu_final_row.{
    x25519_mlkem768_compose_gpu_final_matrix_row}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{X25519MlKem768MatrixRow}

fn x25519_mlkem768_gpu_final_evidence_backend_reason(
        backend: X25519MlKem768EvidenceBackend) -> text:
    if backend == X25519MlKem768EvidenceBackend.Cuda or
            backend == X25519MlKem768EvidenceBackend.Vulkan:
        return ""
    "gpu-final-evidence-backend-not-admitted"

fn x25519_mlkem768_dispatch_and_compose_gpu_final_matrix_row(
        request: X25519MlKem768GpuDispatchRequest,
        host_os: text, host_arch: text
        ) -> Result<X25519MlKem768MatrixRow, text>:
    val backend_reason = x25519_mlkem768_gpu_final_evidence_backend_reason(
        request.evidence.backend)
    if backend_reason != "": return Err(backend_reason)
    val dispatch = x25519_mlkem768_dispatch_gpu(request)
    if dispatch.exit_code != 0:
        return Err("gpu-final-evidence-dispatch-" + dispatch.receipt.reason)
    val outputs = match dispatch.public_outputs:
        case Some(value): value
        case nil: return Err("gpu-final-evidence-public-outputs-unavailable")
    if dispatch.runner_artifact_sha256 == "":
        return Err("gpu-final-evidence-runner-identity-unavailable")
    x25519_mlkem768_compose_gpu_final_matrix_row(
        dispatch.receipt, outputs, dispatch.runner_artifact_sha256,
        dispatch.receipt.artifact_sha256, host_os, host_arch)

export x25519_mlkem768_gpu_final_evidence_backend_reason
export x25519_mlkem768_dispatch_and_compose_gpu_final_matrix_row
