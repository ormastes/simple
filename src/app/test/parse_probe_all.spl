use compiler.core.parser.{parse_module}
use app.io.mod.{env_get}
use std.io_runtime.{read_file_text_result}

fn main() -> i64:
    # PARSE_LIST overrides the list file — lets the driver run the set in
    # chunks (fresh process per chunk) to stay under the memory cap; the
    # seed interpreter accumulates ~30MB/file across parse_module calls.
    var list_path = env_get("PARSE_LIST")
    if list_path == "" or list_path == nil:
        list_path = "parse_set.txt"
    val list_text = match read_file_text_result(list_path):
        case Ok(value): value
        case Err(error):
            print "ERROR: could not read parse list {list_path}: {error}"
            return 1
    val files = list_text.split("\n")
    for f in files:
        val path = f.trim()
        if path.len() == 0:
            continue
        print "FILE {path}"
        val src = match read_file_text_result(path):
            case Ok(value): value
            case Err(error):
                print "ERROR: could not read source {path}: {error}"
                return 1
        parse_module(src, path)
    print "PROBE_DONE"
    return 0
