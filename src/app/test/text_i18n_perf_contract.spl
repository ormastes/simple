# codex-impl
# Typed performance and memory evidence contract for text/i18n/rendering.

val TEXT_I18N_PERF_SCHEMA = "text-i18n-perf-v1"
val TEXT_I18N_PERF_REQUIRED_ROW_COUNT: i64 = 18

struct TextI18nPerfRow:
    id: text
    operation_group: text
    backend: text
    evidence_class: text
    native_host: text

struct TextI18nPerfReceipt:
    schema: text
    row_id: text
    status: text
    reason: text
    source_revision: text
    baseline_source_revision: text
    source_sha256: text
    corpus_sha256: text
    config_sha256: text
    manifest_sha256: text
    machine_id: text
    toolchain_id: text
    hardware_id: text
    backend: text
    active_backend: text
    profile: text
    corpus: text
    samples: i64
    input_bytes: i64
    p50_ns: i64
    p95_ns: i64
    throughput_bytes_per_second: i64
    allocation_count: i64
    allocated_bytes: i64
    copied_bytes: i64
    transient_bytes: i64
    retained_bytes: i64
    builder_capacity_bytes: i64
    builder_waste_bytes: i64
    checkpoint_bytes: i64
    shaped_cache_bytes: i64
    steady_rss_bytes: i64
    peak_rss_bytes: i64
    linked_data_bytes: i64
    mapped_catalog_bytes: i64
    resident_catalog_bytes: i64
    atlas_bytes: i64
    atlas_waste_bytes: i64
    atlas_dirty_bytes: i64
    atlas_upload_bytes: i64
    transient_gpu_bytes: i64
    vram_high_water_bytes: i64
    noalloc_capacity_failures: i64
    draw_calls: i64
    queue_device_ns: i64
    fence_observation_ns: i64
    readback_ns: i64
    device_readback: bool
    checksum: text
    fallback: text

struct TextI18nPerfCheck:
    valid: bool
    errors: [text]

struct TextI18nPerfBudget:
    max_p50_growth_percent: i64
    max_p95_growth_percent: i64
    max_allocated_growth_percent: i64
    max_transient_growth_percent: i64
    max_retained_growth_percent: i64
    max_peak_rss_growth_percent: i64
    max_linked_data_growth_percent: i64
    max_atlas_growth_percent: i64
    max_vram_growth_percent: i64

fn text_i18n_required_perf_rows() -> [TextI18nPerfRow]:
    [
        TextI18nPerfRow(id: "utf8_scalar", operation_group: "text", backend: "scalar", evidence_class: "reference", native_host: "portable"),
        TextI18nPerfRow(id: "utf8_sse2", operation_group: "text", backend: "sse2", evidence_class: "forced-backend", native_host: "x86_64"),
        TextI18nPerfRow(id: "utf8_avx2", operation_group: "text", backend: "avx2", evidence_class: "forced-backend", native_host: "x86_64"),
        TextI18nPerfRow(id: "utf8_avx512", operation_group: "text", backend: "avx512", evidence_class: "forced-backend", native_host: "x86_64"),
        TextI18nPerfRow(id: "utf8_neon", operation_group: "text", backend: "neon", evidence_class: "forced-backend", native_host: "aarch64"),
        TextI18nPerfRow(id: "utf8_rvv", operation_group: "text", backend: "rvv", evidence_class: "forced-backend", native_host: "riscv64"),
        TextI18nPerfRow(id: "parser_ascii", operation_group: "parser", backend: "pure-simple", evidence_class: "native", native_host: "portable"),
        TextI18nPerfRow(id: "parser_multilingual", operation_group: "parser", backend: "pure-simple", evidence_class: "native", native_host: "portable"),
        TextI18nPerfRow(id: "message_default", operation_group: "i18n", backend: "pure-simple", evidence_class: "native", native_host: "portable"),
        TextI18nPerfRow(id: "message_multilocale", operation_group: "i18n", backend: "pure-simple", evidence_class: "native", native_host: "portable"),
        TextI18nPerfRow(id: "engine2d_cpu", operation_group: "render2d", backend: "cpu", evidence_class: "reference", native_host: "portable"),
        TextI18nPerfRow(id: "engine2d_vulkan", operation_group: "render2d", backend: "vulkan", evidence_class: "native-device", native_host: "vulkan"),
        TextI18nPerfRow(id: "engine2d_cuda", operation_group: "render2d", backend: "cuda", evidence_class: "native-device", native_host: "nvidia"),
        TextI18nPerfRow(id: "engine2d_metal", operation_group: "render2d", backend: "metal", evidence_class: "native-device", native_host: "macos"),
        TextI18nPerfRow(id: "engine3d_hud_cpu", operation_group: "render3d", backend: "cpu", evidence_class: "reference", native_host: "portable"),
        TextI18nPerfRow(id: "engine3d_world_cpu", operation_group: "render3d", backend: "cpu", evidence_class: "reference", native_host: "portable"),
        TextI18nPerfRow(id: "engine3d_hud_vulkan", operation_group: "render3d", backend: "vulkan", evidence_class: "native-device", native_host: "vulkan"),
        TextI18nPerfRow(id: "engine3d_world_vulkan", operation_group: "render3d", backend: "vulkan", evidence_class: "native-device", native_host: "vulkan")
    ]

fn text_i18n_perf_rows_valid(rows: [TextI18nPerfRow]) -> bool:
    if rows.len() != TEXT_I18N_PERF_REQUIRED_ROW_COUNT: return false
    var seen: Dict<text, bool> = {}
    for row in rows:
        if row.id == "" or seen.has(row.id) or row.operation_group == "" or
                row.backend == "" or row.native_host == "":
            return false
        if (row.evidence_class != "reference" and row.evidence_class != "native" and
                row.evidence_class != "forced-backend" and
                row.evidence_class != "native-device"):
            return false
        seen[row.id] = true
    true

fn text_i18n_sha256_valid(value: text) -> bool:
    if value.len() != 64: return false
    var i: i64 = 0
    while i < value.len():
        val digit = value[i:i + 1]
        if not ((digit >= "0" and digit <= "9") or
                (digit >= "a" and digit <= "f")):
            return false
        i = i + 1
    true

fn text_i18n_perf_check(
        receipt: TextI18nPerfReceipt, row: TextI18nPerfRow) -> TextI18nPerfCheck:
    var errors: [text] = []
    if receipt.schema != TEXT_I18N_PERF_SCHEMA: errors.push("schema")
    if receipt.row_id != row.id: errors.push("row_id")
    if receipt.status != "pass" or receipt.reason != "none": errors.push("status")
    if receipt.source_revision == "" or receipt.baseline_source_revision == "" or
            receipt.machine_id == "" or receipt.toolchain_id == "" or
            receipt.hardware_id == "" or
            not text_i18n_sha256_valid(receipt.source_sha256) or
            not text_i18n_sha256_valid(receipt.corpus_sha256) or
            not text_i18n_sha256_valid(receipt.config_sha256) or
            not text_i18n_sha256_valid(receipt.manifest_sha256):
        errors.push("provenance")
    if receipt.backend != row.backend or receipt.active_backend != row.backend:
        errors.push("backend")
    if receipt.profile == "" or receipt.corpus == "" or receipt.samples < 5 or
            receipt.input_bytes <= 0:
        errors.push("workload")
    if receipt.p50_ns <= 0 or receipt.p95_ns < receipt.p50_ns or
            receipt.throughput_bytes_per_second <= 0:
        errors.push("timing")
    if receipt.allocation_count < 0 or receipt.allocated_bytes < 0 or
            receipt.copied_bytes < 0 or receipt.transient_bytes < 0 or
            receipt.retained_bytes < 0 or receipt.builder_capacity_bytes < 0 or
            receipt.builder_waste_bytes < 0 or receipt.checkpoint_bytes < 0 or
            receipt.shaped_cache_bytes < 0 or
            receipt.steady_rss_bytes < 0 or receipt.peak_rss_bytes < receipt.steady_rss_bytes or
            receipt.linked_data_bytes < 0 or receipt.mapped_catalog_bytes < 0 or
            receipt.resident_catalog_bytes < 0 or
            receipt.resident_catalog_bytes > receipt.mapped_catalog_bytes or
            receipt.builder_waste_bytes > receipt.builder_capacity_bytes:
        errors.push("memory")
    if receipt.atlas_bytes < 0 or receipt.atlas_upload_bytes < 0 or
            receipt.atlas_waste_bytes < 0 or receipt.atlas_dirty_bytes < 0 or
            receipt.atlas_waste_bytes > receipt.atlas_bytes or
            receipt.atlas_dirty_bytes > receipt.atlas_bytes or
            receipt.transient_gpu_bytes < 0 or receipt.vram_high_water_bytes < 0 or
            receipt.noalloc_capacity_failures < 0 or
            receipt.draw_calls < 0 or receipt.queue_device_ns < 0 or
            receipt.fence_observation_ns < 0 or receipt.readback_ns < 0:
        errors.push("render_metrics")
    if row.evidence_class == "native-device" and
            (not receipt.device_readback or receipt.queue_device_ns <= 0 or
                receipt.readback_ns <= 0 or receipt.draw_calls <= 0):
        errors.push("device_evidence")
    if receipt.checksum == "" or receipt.fallback != "none": errors.push("result")
    TextI18nPerfCheck(valid: errors.len() == 0, errors: errors)

fn text_i18n_growth_within(after: i64, baseline: i64, percent: i64) -> bool:
    if after < 0 or baseline < 0 or percent < 0: return false
    if baseline == 0: return after == 0
    after * 100 <= baseline * (100 + percent)

fn text_i18n_perf_regression_check(
        baseline: TextI18nPerfReceipt, after: TextI18nPerfReceipt,
        row: TextI18nPerfRow, budget: TextI18nPerfBudget) -> TextI18nPerfCheck:
    var errors: [text] = []
    if not text_i18n_perf_check(baseline, row).valid or
            not text_i18n_perf_check(after, row).valid:
        errors.push("receipt")
    if after.baseline_source_revision != baseline.source_revision or
            after.machine_id != baseline.machine_id or
            after.toolchain_id != baseline.toolchain_id or
            after.hardware_id != baseline.hardware_id or
            after.profile != baseline.profile or after.corpus != baseline.corpus or
            after.corpus_sha256 != baseline.corpus_sha256 or
            after.config_sha256 != baseline.config_sha256 or
            after.manifest_sha256 != baseline.manifest_sha256 or
            after.input_bytes != baseline.input_bytes:
        errors.push("baseline_identity")
    if not text_i18n_growth_within(after.p50_ns, baseline.p50_ns,
            budget.max_p50_growth_percent) or
            not text_i18n_growth_within(after.p95_ns, baseline.p95_ns,
                budget.max_p95_growth_percent):
        errors.push("latency_regression")
    if not text_i18n_growth_within(after.allocated_bytes, baseline.allocated_bytes,
            budget.max_allocated_growth_percent) or
            not text_i18n_growth_within(after.transient_bytes, baseline.transient_bytes,
                budget.max_transient_growth_percent) or
            not text_i18n_growth_within(after.retained_bytes, baseline.retained_bytes,
                budget.max_retained_growth_percent) or
            not text_i18n_growth_within(after.peak_rss_bytes, baseline.peak_rss_bytes,
                budget.max_peak_rss_growth_percent) or
            not text_i18n_growth_within(after.linked_data_bytes, baseline.linked_data_bytes,
                budget.max_linked_data_growth_percent) or
            not text_i18n_growth_within(after.atlas_bytes, baseline.atlas_bytes,
                budget.max_atlas_growth_percent) or
            not text_i18n_growth_within(after.vram_high_water_bytes,
                baseline.vram_high_water_bytes, budget.max_vram_growth_percent):
        errors.push("memory_regression")
    TextI18nPerfCheck(valid: errors.len() == 0, errors: errors)

export TEXT_I18N_PERF_SCHEMA, TEXT_I18N_PERF_REQUIRED_ROW_COUNT
export TextI18nPerfRow, TextI18nPerfReceipt, TextI18nPerfCheck
export TextI18nPerfBudget
export text_i18n_required_perf_rows, text_i18n_perf_rows_valid
export text_i18n_sha256_valid, text_i18n_perf_check
export text_i18n_growth_within, text_i18n_perf_regression_check
