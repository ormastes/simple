"""Native CUDA device query through std.gc_async_mut.gpu_ops (launches nothing).

The std-level twin of cuda_device_query_probe.spl: the filed shape of
native_c_runtime_missing_cuda_provider_forwarders_2026-11-22.
"""

use std.gc_async_mut.gpu_ops.{gpu_init, gpu_device_count, gpu_device_name, gpu_device_compute_capability}

fn main():
    val init_ok = gpu_init().is_ok()
    val count = gpu_device_count()
    val cap = gpu_device_compute_capability(0)
    print "CUDA_STD_QUERY init_ok={init_ok} count={count} name={gpu_device_name(0)} capability={cap.0}.{cap.1}"
