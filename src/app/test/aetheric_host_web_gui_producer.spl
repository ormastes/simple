# Generates the Aetheric host Web/GUI surface from the production Simple
# HTML generator.  The evidence wrapper invokes this through the current
# self-hosted binary before it passes the resulting HTML through both the
# Simple WebIR/DrawIR Engine2D renderer and Chromium/Electron capture.

use app.ui.web.html.{write_wm_modern_preview_html}
use nogc_sync_mut.ui.theme_package.{load_theme_package}
use std.sffi.cli.{cli_get_args}

fn main() -> i64:
    val args = cli_get_args()
    if args.len() < 1 or args[0] == "":
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=missing-output-path"
        return 2

    # Resolve the folder package in the same process that emits the HTML.
    # The public generator appends pkg.snapshot.composed_css, so this does not
    # copy CSS or reproduce a lookalike DOM in the evidence lane.
    val pkg = load_theme_package("aetheric_dark")
    if pkg.id != "aetheric_dark":
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=theme-resolution-mismatch"
        return 2
    if not write_wm_modern_preview_html(args[0], pkg.id):
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=html-write-failed"
        return 2

    print "aetheric_host_web_gui_generation_status=pass"
    print "aetheric_host_web_gui_generation_theme_id={pkg.id}"
    print "aetheric_host_web_gui_generation_theme_manifest_sha256={pkg.snapshot.source_manifest_sha256}"
    print "aetheric_host_web_gui_generation_theme_material_sha256={pkg.snapshot.material_sha256}"
    print "aetheric_host_web_gui_generation_theme_fingerprint={pkg.fingerprint}"
    print "aetheric_host_web_gui_generation_html={args[0]}"
    0
