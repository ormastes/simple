# Immutable schema and owner contract for X25519MLKEM768 coverage receipts.

use std.test_runner.test_runner_coverage.{CoverageOwnerOutcomeSummary}

val X25519_MLKEM768_COVERAGE_SCHEMA = "x25519mlkem768-branch-coverage-v2"
val X25519_MLKEM768_RUN_MANIFEST_SCHEMA = "simple-native-coverage-run-v2"
val X25519_MLKEM768_COVERAGE_TARGET_BP: i64 = 9800
val X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH =
    "test/fixtures/crypto/x25519mlkem768/critical_branch_symbolic_v1.psv"
val X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256 =
    "2e8bbb4a23c844f561ebd594b29bd8d3b06b15e5c2f57913599a609b5ac8de8b"
val X25519_MLKEM768_COVERAGE_COMPOSER_PATH =
    "src/app/test/x25519mlkem768_coverage_receipt.spl"
val X25519_MLKEM768_COVERAGE_CONTRACT_PATH =
    "src/app/test/x25519mlkem768_coverage_contract.spl"

struct X25519MlKem768CoverageReceiptCli:
    raw_coverage: text
    run_manifest: text
    critical_inventory: text
    compiler_artifact: text
    runtime_artifact: text
    output_dir: text

struct X25519MlKem768CoverageRunManifest:
    raw_coverage_path: text
    raw_coverage_sha256: text
    compiler_artifact_path: text
    compiler_artifact_sha256: text
    compiler_provenance_path: text
    compiler_provenance_sha256: text
    compiler_source_revision: text
    compiler_version_path: text
    compiler_version_sha256: text
    compiler_version: text
    runtime_version: text
    execution_environment: text
    runtime_artifact_path: text
    runtime_artifact_sha256: text
    measurement_tool_version: text
    source_sha256: Dict<text, text>
    spec_sha256: Dict<text, text>
    spec_aot_path: Dict<text, text>
    spec_aot_sha256: Dict<text, text>

struct X25519MlKem768CoverageReceipt:
    cli: X25519MlKem768CoverageReceiptCli
    run_manifest_sha256: text
    raw_coverage_sha256: text
    compiler_artifact_sha256: text
    compiler_provenance_path: text
    compiler_provenance_sha256: text
    compiler_source_revision: text
    compiler_version_path: text
    compiler_version_sha256: text
    compiler_version: text
    runtime_version: text
    execution_environment: text
    runtime_artifact_sha256: text
    measurement_tool_version: text
    composer_source_sha256: text
    contract_source_sha256: text
    owners: [CoverageOwnerOutcomeSummary]
    owner_source_sha256: Dict<text, text>
    critical_outcome_total: i64
    decision_site_total: i64
    condition_site_total: i64
    branch_outcome_total: i64
    branch_outcome_covered: i64
    branch_coverage_basis_points: i64
    zero_outcome_rows: [text]
    critical_inventory_sha256: text

struct X25519MlKem768CoverageReceiptArtifacts:
    receipt_path: text
    zero_inventory_path: text
    source_manifest_path: text
    spec_manifest_path: text
    receipt_sha256: text
    branch_coverage_basis_points: i64

struct X25519MlKem768CoverageComposeError:
    code: text
    subject: text

fn x25519_mlkem768_coverage_error(
        code: text, subject: text = "") -> X25519MlKem768CoverageComposeError:
    X25519MlKem768CoverageComposeError(code: code, subject: subject)

