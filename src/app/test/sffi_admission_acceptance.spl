# Test-time SFFI v2 admission acceptance seam.
#
# This capsule invokes the audited evidence-admission script once per fixture.
# It is intentionally unreachable from provider loading or foreign-call paths;
# runtime admission retains only verifier-minted cached typed slots.

use app.io.mod.{process_run_bounded}

val SFFI_ADMISSION_ACCEPTANCE_TIMEOUT_MS: i64 = 30000
val SFFI_ADMISSION_ACCEPTANCE_MAX_OUTPUT_BYTES: i64 = 32768

fn _sffi_admission_category_valid(category: text) -> bool:
    category == "admitted" or category == "unsigned" or
    category == "artifact-mismatch" or category == "untrusted-signer" or
    category == "abi-mismatch" or category == "stale-receipt" or
    category == "null-contract"

# Runs one named fixture. Rejections return their typed category but retain a
# nonzero subprocess exit; a missing/malformed fixture is a Result error and
# can never be mistaken for an accepted category.
pub fn sffi_admission_acceptance_run(fixture_id: text) -> Result<text, text>:
    if fixture_id == "" or fixture_id.contains("/") or fixture_id.contains("\\"):
        return Err("blocked: SFFI admission fixture id is invalid")
    val (stdout, stderr, exit_code) = process_run_bounded(
        "sh",
        ["scripts/audit/sffi-admission-acceptance-runner.shs", fixture_id],
        SFFI_ADMISSION_ACCEPTANCE_TIMEOUT_MS,
        SFFI_ADMISSION_ACCEPTANCE_MAX_OUTPUT_BYTES,
    )
    val category = stdout.trim()
    if not _sffi_admission_category_valid(category):
        return Err("blocked: SFFI admission fixture emitted no recognized category: {stderr.trim()}")
    if category == "admitted":
        if exit_code != 0:
            return Err("SFFI admission accepted fixture exited nonzero: {stderr.trim()}")
        return Ok(category)
    if exit_code == 0:
        return Err("SFFI admission fixture failed to reject safely: {stderr.trim()}")
    Ok(category)

pub fn sffi_admission_acceptance_summary(result: text) -> text:
    result
