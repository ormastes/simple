# codex-impl
# Immutable all-owner contract for UTF-8, i18n, and text rendering coverage.

use app.io.mod.{file_exists}

val TEXT_I18N_COVERAGE_SCHEMA = "text-i18n-branch-coverage-v1"
val TEXT_I18N_COVERAGE_TARGET_BP: i64 = 10000
val TEXT_I18N_COVERAGE_OWNER_COUNT: i64 = 30
val TEXT_I18N_BACKEND_ROW_COUNT: i64 = 10

struct TextI18nCoverageOwner:
    id: text
    path: text
    language: text
    area: text

struct TextI18nBackendRow:
    id: text
    evidence_class: text
    required: bool

struct TextI18nCoverageContractCheck:
    valid: bool
    expected_owner_count: i64
    actual_owner_count: i64
    absent_paths: [text]
    duplicate_ids: [text]
    duplicate_paths: [text]
    invalid_rows: [text]

fn text_i18n_coverage_owners() -> [TextI18nCoverageOwner]:
    [
        TextI18nCoverageOwner(id: "string_core", path: "src/lib/common/string_core.spl", language: "simple", area: "text"),
        TextI18nCoverageOwner(id: "utf8", path: "src/lib/common/encoding/utf8.spl", language: "simple", area: "codec"),
        TextI18nCoverageOwner(id: "utf16", path: "src/lib/common/encoding/utf16.spl", language: "simple", area: "codec"),
        TextI18nCoverageOwner(id: "utf32", path: "src/lib/common/encoding/utf32.spl", language: "simple", area: "codec"),
        TextI18nCoverageOwner(id: "codec", path: "src/lib/common/encoding/codec.spl", language: "simple", area: "codec"),
        TextI18nCoverageOwner(id: "text_ops", path: "src/lib/common/encoding/text_ops.spl", language: "simple", area: "text"),
        TextI18nCoverageOwner(id: "width_index", path: "src/lib/common/encoding/width_index.spl", language: "simple", area: "text"),
        TextI18nCoverageOwner(id: "io_traits", path: "src/lib/common/io/traits.spl", language: "simple", area: "io"),
        TextI18nCoverageOwner(id: "lexer", path: "src/compiler_rust/parser/src/lexer/mod.rs", language: "rust", area: "parser"),
        TextI18nCoverageOwner(id: "lexer_strings", path: "src/compiler_rust/parser/src/lexer/strings.rs", language: "rust", area: "parser"),
        TextI18nCoverageOwner(id: "lexer_i18n", path: "src/compiler_rust/parser/src/lexer/i18n.rs", language: "rust", area: "parser"),
        TextI18nCoverageOwner(id: "lexer_identifiers", path: "src/compiler_rust/parser/src/lexer/identifiers.rs", language: "rust", area: "parser"),
        TextI18nCoverageOwner(id: "i18n_extractor", path: "src/compiler_rust/compiler/src/i18n/extractor.rs", language: "rust", area: "i18n"),
        TextI18nCoverageOwner(id: "i18n_locale", path: "src/compiler_rust/compiler/src/i18n/locale.rs", language: "rust", area: "i18n"),
        TextI18nCoverageOwner(id: "i18n_registry", path: "src/compiler_rust/compiler/src/i18n/registry.rs", language: "rust", area: "i18n"),
        TextI18nCoverageOwner(id: "i18n_interpreter", path: "src/compiler_rust/compiler/src/interpreter/expr/literals.rs", language: "rust", area: "i18n"),
        TextI18nCoverageOwner(id: "i18n_cli", path: "src/app/i18n/main.spl", language: "simple", area: "i18n"),
        TextI18nCoverageOwner(id: "draw_ir", path: "src/lib/common/ui/draw_ir.spl", language: "simple", area: "draw_ir"),
        TextI18nCoverageOwner(id: "widget_draw_ir", path: "src/lib/common/ui/widget_draw_ir.spl", language: "simple", area: "draw_ir"),
        TextI18nCoverageOwner(id: "window_scene_draw_ir", path: "src/lib/common/ui/window_scene_draw_ir.spl", language: "simple", area: "draw_ir"),
        TextI18nCoverageOwner(id: "web_draw_ir", path: "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl", language: "simple", area: "draw_ir"),
        TextI18nCoverageOwner(id: "engine2d_draw_ir", path: "src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl", language: "simple", area: "engine2d"),
        TextI18nCoverageOwner(id: "engine2d", path: "src/lib/gc_async_mut/gpu/engine2d/engine.spl", language: "simple", area: "engine2d"),
        TextI18nCoverageOwner(id: "font_types", path: "src/lib/nogc_sync_mut/text_layout/font_types.spl", language: "simple", area: "font"),
        TextI18nCoverageOwner(id: "font_renderer", path: "src/lib/nogc_sync_mut/text_layout/font_renderer.spl", language: "simple", area: "font"),
        TextI18nCoverageOwner(id: "engine3d", path: "src/lib/gc_async_mut/gpu/engine3d/engine.spl", language: "simple", area: "engine3d"),
        TextI18nCoverageOwner(id: "engine3d_material", path: "src/lib/gc_async_mut/gpu/engine3d/font_hud_material.spl", language: "simple", area: "engine3d"),
        TextI18nCoverageOwner(id: "engine3d_vulkan", path: "src/lib/gc_async_mut/gpu/engine3d/vulkan_font_adapter.spl", language: "simple", area: "engine3d"),
        TextI18nCoverageOwner(id: "runtime_simd_utf8", path: "src/runtime/runtime_simd_utf8.c", language: "c", area: "simd"),
        TextI18nCoverageOwner(id: "rust_utf8_kernels", path: "src/compiler_rust/runtime/src/value/utf8_kernels.rs", language: "rust", area: "simd")
    ]

fn text_i18n_backend_rows() -> [TextI18nBackendRow]:
    [
        TextI18nBackendRow(id: "scalar", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "sse2", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "avx2", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "avx512", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "neon", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "rvv", evidence_class: "forced-backend", required: true),
        TextI18nBackendRow(id: "cpu_render", evidence_class: "reference", required: true),
        TextI18nBackendRow(id: "vulkan", evidence_class: "native-device", required: true),
        TextI18nBackendRow(id: "cuda", evidence_class: "native-device", required: true),
        TextI18nBackendRow(id: "metal", evidence_class: "native-device", required: true)
    ]

fn text_i18n_coverage_contract_check(
        owners: [TextI18nCoverageOwner]) -> TextI18nCoverageContractCheck:
    var absent: [text] = []
    var duplicate_ids: [text] = []
    var duplicate_paths: [text] = []
    var invalid: [text] = []
    var seen_ids: Dict<text, bool> = {}
    var seen_paths: Dict<text, bool> = {}
    for owner in owners:
        if owner.id == "" or owner.path == "" or
                (owner.language != "simple" and owner.language != "rust" and owner.language != "c") or
                owner.area == "":
            invalid.push(owner.id + "|" + owner.path)
        if seen_ids.has(owner.id):
            duplicate_ids.push(owner.id)
        else:
            seen_ids[owner.id] = true
        if seen_paths.has(owner.path):
            duplicate_paths.push(owner.path)
        else:
            seen_paths[owner.path] = true
        if owner.path != "" and not file_exists(owner.path): absent.push(owner.path)
    val valid = owners.len() == TEXT_I18N_COVERAGE_OWNER_COUNT and
        absent.len() == 0 and duplicate_ids.len() == 0 and
        duplicate_paths.len() == 0 and invalid.len() == 0
    TextI18nCoverageContractCheck(
        valid: valid,
        expected_owner_count: TEXT_I18N_COVERAGE_OWNER_COUNT,
        actual_owner_count: owners.len(),
        absent_paths: absent,
        duplicate_ids: duplicate_ids,
        duplicate_paths: duplicate_paths,
        invalid_rows: invalid)

fn text_i18n_backend_contract_valid(rows: [TextI18nBackendRow]) -> bool:
    if rows.len() != TEXT_I18N_BACKEND_ROW_COUNT: return false
    var seen: Dict<text, bool> = {}
    for row in rows:
        if row.id == "" or seen.has(row.id) or not row.required: return false
        if (row.evidence_class != "reference" and
                row.evidence_class != "forced-backend" and
                row.evidence_class != "native-device"):
            return false
        seen[row.id] = true
    true

fn text_i18n_coverage_manifest_report() -> text:
    val check = text_i18n_coverage_contract_check(text_i18n_coverage_owners())
    val backends_valid = text_i18n_backend_contract_valid(text_i18n_backend_rows())
    val verdict = if check.valid and backends_valid: "PASS" else: "FAIL"
    "text-i18n-coverage-contract: {verdict} schema={TEXT_I18N_COVERAGE_SCHEMA}" +
        " owners={check.actual_owner_count}/{check.expected_owner_count}" +
        " absent={check.absent_paths.len()} duplicate_ids={check.duplicate_ids.len()}" +
        " duplicate_paths={check.duplicate_paths.len()} invalid={check.invalid_rows.len()}" +
        " backend_rows={text_i18n_backend_rows().len()}/{TEXT_I18N_BACKEND_ROW_COUNT}"

export TEXT_I18N_COVERAGE_SCHEMA, TEXT_I18N_COVERAGE_TARGET_BP
export TEXT_I18N_COVERAGE_OWNER_COUNT, TEXT_I18N_BACKEND_ROW_COUNT
export TextI18nCoverageOwner, TextI18nBackendRow, TextI18nCoverageContractCheck
export text_i18n_coverage_owners, text_i18n_backend_rows
export text_i18n_coverage_contract_check, text_i18n_backend_contract_valid
export text_i18n_coverage_manifest_report
