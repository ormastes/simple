# Final-matrix adapter for a public-only native CUDA or Vulkan observation.
#
# GPU dispatch intentionally emits a non-promotable raw receipt.  This is the
# sole app-level boundary that can pair that receipt with the retained pinned
# A/B/C public outputs and make one Executed matrix row.  It neither dispatches
# work nor accepts Metal or NTT-only evidence.

mod app.test.x25519mlkem768_gpu_final_row

use std.common.crypto.sha256.{sha256_text}
use app.test.x25519mlkem768_pinned_workload.{
    X25519MlKem768PinnedPublicOutputs,
    X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
    X25519_MLKEM768_PINNED_FIXTURE_ID,
    X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
    X25519_MLKEM768_PINNED_ORACLE_ID,
    X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES}
use lib.common.crypto.x25519_mlkem768.contract.{X25519MlKem768Backend}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.executed_row_composer.{
    x25519_mlkem768_compose_executed_matrix_row}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{X25519MlKem768MatrixRow}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{X25519MlKem768PinnedSet}

fn _gpu_final_backend_matches(execution: X25519MlKem768RunReceipt,
        outputs: X25519MlKem768PinnedPublicOutputs) -> bool:
    if execution.requested_backend == X25519MlKem768EvidenceBackend.Cuda:
        return outputs.requested_backend == X25519MlKem768Backend.Cuda and
            outputs.selected_backend == X25519MlKem768Backend.Cuda
    if execution.requested_backend == X25519MlKem768EvidenceBackend.Vulkan:
        return outputs.requested_backend == X25519MlKem768Backend.Vulkan and
            outputs.selected_backend == X25519MlKem768Backend.Vulkan
    false

fn _gpu_final_outputs_reason(execution: X25519MlKem768RunReceipt,
        outputs: X25519MlKem768PinnedPublicOutputs) -> text:
    if (execution.requested_backend != X25519MlKem768EvidenceBackend.Cuda and
            execution.requested_backend != X25519MlKem768EvidenceBackend.Vulkan):
        return "gpu-final-row-backend-not-admitted"
    if execution.scope != X25519MlKem768EvidenceScope.FullOperation or
            execution.mode != X25519MlKem768EvidenceMode.Native or
            execution.emulated or execution.batch_size != 1:
        return "gpu-final-row-requires-native-full-operation"
    if execution.status != X25519MlKem768EvidenceStatus.Pass or
            execution.promotion_eligible:
        return "gpu-final-row-requires-raw-pass-receipt"
    if outputs.schema != X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA or
            outputs.fixture_id != X25519_MLKEM768_PINNED_FIXTURE_ID or
            outputs.workload_sha256 != X25519_MLKEM768_PINNED_WORKLOAD_SHA256 or
            outputs.oracle_id != X25519_MLKEM768_PINNED_ORACLE_ID:
        return "gpu-final-row-pinned-workload-mismatch"
    if execution.fixture_id != outputs.fixture_id or
            execution.pinned_workload_sha256 != outputs.workload_sha256 or
            not _gpu_final_backend_matches(execution, outputs):
        return "gpu-final-row-receipt-output-binding-mismatch"
    if outputs.fallback_used or not outputs.candidate_oracle_match or
            outputs.accelerated_operation_count != 3 or
            not outputs.compiled or not outputs.submitted or
            not outputs.fence_completed or not outputs.device_readback or
            outputs.kernel_invocations < 3:
        return "gpu-final-row-device-proof-incomplete"
    if outputs.artifact_digest == "" or
            outputs.execution_proof_digest != outputs.artifact_digest or
            outputs.artifact_digest != execution.artifact_sha256:
        return "gpu-final-row-artifact-proof-mismatch"
    if (outputs.set_a.set_id != X25519MlKem768PinnedSet.MlKem or
            outputs.set_b.set_id != X25519MlKem768PinnedSet.X25519 or
            outputs.set_c.set_id != X25519MlKem768PinnedSet.Hybrid):
        return "gpu-final-row-public-set-identity-mismatch"
    if outputs.client_share_bytes != execution.client_share_bytes or
            outputs.server_share_bytes != execution.server_share_bytes or
            outputs.shared_secret_bytes != execution.shared_secret_bytes or
            outputs.public_wire_bytes != X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES or
            outputs.client_share_sha256 != outputs.set_c.first_output_sha256 or
            outputs.server_share_sha256 != outputs.set_c.second_output_sha256:
        return "gpu-final-row-public-output-mismatch"
    if (execution.keygen_output_digest != sha256_text(outputs.keygen_output_digest) or
            execution.encapsulate_output_digest !=
                sha256_text(outputs.encapsulate_output_digest) or
            execution.decapsulate_output_digest !=
                sha256_text(outputs.decapsulate_output_digest)):
        return "gpu-final-row-operation-output-mismatch"
    ""

# Composes exactly one Executed CUDA/Vulkan row from a batch-one raw GPU
# receipt and its retained public A/B/C outputs.  The shared composer remains
# the authority for row schema, public-oracle, host, and lifecycle validation.
fn x25519_mlkem768_compose_gpu_final_matrix_row(
        raw_execution: X25519MlKem768RunReceipt,
        outputs: X25519MlKem768PinnedPublicOutputs,
        runner_artifact_sha256: text, admitted_artifact_sha256: text,
        host_os: text, host_arch: text
        ) -> Result<X25519MlKem768MatrixRow, text>:
    val outputs_reason = _gpu_final_outputs_reason(raw_execution, outputs)
    if outputs_reason != "": return Err(outputs_reason)
    var execution = raw_execution
    execution.promotion_eligible = true
    x25519_mlkem768_compose_executed_matrix_row(execution,
        runner_artifact_sha256, admitted_artifact_sha256,
        host_os, host_arch, outputs.set_a, outputs.set_b, outputs.set_c,
        outputs.client_share_sha256, outputs.server_share_sha256)

export x25519_mlkem768_compose_gpu_final_matrix_row
