# codex-impl
# Hosted physical executor adapter. All process access stays behind app.io.

use app.io.{env_get, file_is_regular_no_follow, file_read_bytes, file_size,
            file_write_bytes,
            process_is_alive, process_kill, process_spawn_async,
            random_randint, time_now_unix_micros}
use std.common.structural.environment_instruction.*

val HOSTED_ENV_CAPTURE_MAX_BYTES_V1: i64 = 65536

class HostedProcessPollEnvExecutorV1:
    sealed: bool

class HostedPreparedEnvironmentGetExecutorV1:
    key_bytes: [u8]
    value_bytes: [u8]
    captured_from_host: bool
    sealed: bool

class HostedPreparedCaptureExecutorV1:
    opcode: EnvOpcodeV1
    argument_bytes: [u8]
    captured_bytes: [u8]
    captured_length: i64
    physical_effect: bool
    capture_valid: bool
    sealed: bool

class HostedPreparedFileWriteExecutorV1:
    path: text
    path_digest_hi: i64
    path_digest_lo: i64
    max_payload_bytes: i64
    capability_id: i64
    prepared_size: i64
    sealed: bool

class HostedFileWriteCursorV1:
    consumed: bool
    sealed: bool

class HostedFileWriteStepReceiptV1:
    receipt: EnvExecutionReceiptV1
    cursor: HostedFileWriteCursorV1

class HostedPreparedFileReadSessionV1:
    path_digest_hi: i64
    path_digest_lo: i64
    handle_token: i64
    capability_id: i64
    captured_bytes: [u8]
    captured_length: i64
    sealed: bool

class HostedFileReadSessionCursorV1:
    next_sequence: i64
    closed: bool
    sealed: bool

class HostedFileReadSessionStepReceiptV1:
    receipt: EnvExecutionReceiptV1
    cursor: HostedFileReadSessionCursorV1

class HostedPreparedStreamWriteExecutorV1:
    stream_id: i64
    capability_id: i64
    sink_capacity: i64
    sealed: bool

class HostedStreamWriteCursorV1:
    consumed: bool
    sealed: bool

class HostedStreamWriteStepReceiptV1:
    receipt: EnvExecutionReceiptV1
    cursor: HostedStreamWriteCursorV1

class HostedPreparedProcessExecutorV1:
    process_id: i64
    command_digest_hi: i64
    command_digest_lo: i64
    capability_id: i64
    sealed: bool

class HostedProcessCursorV1:
    next_sequence: i64
    terminated: bool
    sealed: bool

class HostedProcessStepReceiptV1:
    receipt: EnvExecutionReceiptV1
    cursor: HostedProcessCursorV1

fn _env_text_bytes(value: text) -> [u8]:
    var bytes: [u8] = [0u8; value.len()]
    var i = 0
    while i < value.len():
        bytes[i] = value.char_code_at(i) as u8
        i = i + 1
    bytes

fn _env_text_byte_safe(value: text) -> bool:
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 0 or code > 255:
            return false
        i = i + 1
    true

fn _env_path_safe_under_root(path: text, allowed_root: text) -> bool:
    if path.len() == 0 or allowed_root.len() == 0
            or not path.starts_with(allowed_root):
        return false
    if path.len() > allowed_root.len():
        val boundary = path.char_code_at(allowed_root.len())
        if boundary != 47 and boundary != 92:
            return false
    var i = 0
    while i < path.len():
        val code = path.char_code_at(i)
        if code <= 0 or code > 255:
            return false
        if code == 46 and i + 1 < path.len()
                and path.char_code_at(i + 1) == 46:
            val left_boundary = i == 0
                or path.char_code_at(i - 1) == 47
                or path.char_code_at(i - 1) == 92
            val right_index = i + 2
            val right_boundary = right_index == path.len()
                or path.char_code_at(right_index) == 47
                or path.char_code_at(right_index) == 92
            if left_boundary and right_boundary:
                return false
        i = i + 1
    true

fn _hosted_invalid_capture_v1(opcode: EnvOpcodeV1) -> HostedPreparedCaptureExecutorV1:
    HostedPreparedCaptureExecutorV1(opcode: opcode, argument_bytes: [],
        captured_bytes: [], captured_length: 0, physical_effect: false,
        capture_valid: false, sealed: true)

fn _hosted_capture_v1(opcode: EnvOpcodeV1, argument_bytes: [u8],
                      captured_bytes: [u8], captured_length: i64,
                      physical_effect: bool) -> HostedPreparedCaptureExecutorV1:
    val valid = captured_length >= 0
        and captured_length <= captured_bytes.len()
        and captured_length <= HOSTED_ENV_CAPTURE_MAX_BYTES_V1
    HostedPreparedCaptureExecutorV1(opcode: opcode,
        argument_bytes: argument_bytes, captured_bytes: captured_bytes,
        captured_length: captured_length, physical_effect: physical_effect,
        capture_valid: valid, sealed: true)

fn hosted_prepare_file_read_v1(path: text, allowed_root: text,
                               max_bytes: i64) -> HostedPreparedCaptureExecutorV1:
    if max_bytes < 0 or max_bytes > HOSTED_ENV_CAPTURE_MAX_BYTES_V1
            or not _env_path_safe_under_root(path, allowed_root)
            or not file_is_regular_no_follow(path):
        return _hosted_invalid_capture_v1(EnvOpcodeV1.FileRead)
    val size_before = file_size(path)
    if size_before < 0 or size_before > max_bytes:
        return _hosted_invalid_capture_v1(EnvOpcodeV1.FileRead)
    val bytes = file_read_bytes(path)
    val size_after = file_size(path)
    if size_after != size_before or bytes.len() != size_before
            or not file_is_regular_no_follow(path):
        return _hosted_invalid_capture_v1(EnvOpcodeV1.FileRead)
    _hosted_capture_v1(EnvOpcodeV1.FileRead, _env_text_bytes(path), bytes,
                       bytes.len(), true)

fn hosted_prepare_stream_read_v1(stream_id: i64, captured_bytes: [u8],
                                 captured_length: i64,
                                 max_bytes: i64) -> HostedPreparedCaptureExecutorV1:
    if stream_id < 0 or max_bytes < 0
            or max_bytes > HOSTED_ENV_CAPTURE_MAX_BYTES_V1
            or captured_length < 0 or captured_length > max_bytes
            or captured_length > captured_bytes.len():
        return _hosted_invalid_capture_v1(EnvOpcodeV1.StreamRead)
    var key: [u8] = [0u8; 8]
    var i = 0
    while i < 8:
        key[i] = ((stream_id >> (i * 8)) & 255) as u8
        i = i + 1
    _hosted_capture_v1(EnvOpcodeV1.StreamRead, key, captured_bytes,
                       captured_length, true)

fn hosted_prepare_clock_read_v1() -> HostedPreparedCaptureExecutorV1:
    val captured = time_now_unix_micros()
    if captured < 0:
        return _hosted_invalid_capture_v1(EnvOpcodeV1.ClockRead)
    var bytes: [u8] = [0u8; 8]
    var i = 0
    while i < 8:
        bytes[i] = ((captured >> (i * 8)) & 255) as u8
        i = i + 1
    _hosted_capture_v1(EnvOpcodeV1.ClockRead, [], bytes, 8, true)

fn hosted_prepare_random_fill_v1(length: i64) -> HostedPreparedCaptureExecutorV1:
    if length < 0 or length > HOSTED_ENV_CAPTURE_MAX_BYTES_V1:
        return _hosted_invalid_capture_v1(EnvOpcodeV1.RandomFill)
    var bytes: [u8] = [0u8; length]
    var i = 0
    while i < length:
        val value = random_randint(0, 255)
        if value < 0 or value > 255:
            return _hosted_invalid_capture_v1(EnvOpcodeV1.RandomFill)
        bytes[i] = value as u8
        i = i + 1
    _hosted_capture_v1(EnvOpcodeV1.RandomFill, [], bytes, length, true)

fn hosted_prepare_environment_get_v1(key: text) -> HostedPreparedEnvironmentGetExecutorV1:
    val value = env_get(key)
    HostedPreparedEnvironmentGetExecutorV1(
        key_bytes: _env_text_bytes(key), value_bytes: _env_text_bytes(value),
        captured_from_host: _env_text_byte_safe(key) and _env_text_byte_safe(value),
        sealed: true)

fn _env_read_i64_le(data: [u8], offset: i64) -> i64:
    var value = 0
    var i = 0
    while i < 8:
        value = value | ((data[offset + i] as i64) << (i * 8))
        i = i + 1
    value

fn _env_text_digest_v1(value: text, reverse: bool) -> i64:
    var digest = if reverse: 216613626 else: 146959810
    var i = 0
    while i < value.len():
        val index = if reverse: value.len() - 1 - i else: i
        digest = ((digest * 257 + value.char_code_at(index) + 17)
                  % 2147483629) + 1
        i = i + 1
    digest

fn _env_command_digest_v1(command: text, arguments: [text], reverse: bool) -> i64:
    var digest = _env_text_digest_v1(command, reverse)
    var i = 0
    while i < arguments.len():
        val index = if reverse: arguments.len() - 1 - i else: i
        digest = ((digest * 257 + _env_text_digest_v1(arguments[index], reverse)
                  + arguments[index].len() + 17) % 2147483629) + 1
        i = i + 1
    digest

fn _env_write_i64_le(data: [u8], offset: i64, value: i64):
    var i = 0
    while i < 8:
        data[offset + i] = ((value >> (i * 8)) & 255) as u8
        i = i + 1

fn hosted_prepare_file_write_v1(path: text, allowed_root: text,
                                capability_id: i64,
                                max_payload_bytes: i64) -> HostedPreparedFileWriteExecutorV1:
    val valid = capability_id > 0 and capability_id < 63
        and max_payload_bytes >= 0
        and max_payload_bytes <= HOSTED_ENV_CAPTURE_MAX_BYTES_V1
        and _env_text_byte_safe(path)
        and _env_path_safe_under_root(path, allowed_root)
        and file_is_regular_no_follow(path)
    HostedPreparedFileWriteExecutorV1(
        path: path,
        path_digest_hi: if valid: _env_text_digest_v1(path, false) else: 0,
        path_digest_lo: if valid: _env_text_digest_v1(path, true) else: 0,
        max_payload_bytes: if valid: max_payload_bytes else: 0,
        capability_id: if valid: capability_id else: 0,
        prepared_size: if valid: file_size(path) else: -1,
        sealed: valid)

fn hosted_file_write_cursor_v1() -> HostedFileWriteCursorV1:
    HostedFileWriteCursorV1(consumed: false, sealed: true)

fn _hosted_file_write_rejected_v1(
        instruction: EnvInstructionV1, cursor: HostedFileWriteCursorV1,
        status: EnvInstructionStatusV1) -> HostedFileWriteStepReceiptV1:
    HostedFileWriteStepReceiptV1(
        receipt: env_execution_rejected_v1(instruction, status), cursor: cursor)

fn hosted_file_write_execute_v1(
        executor: HostedPreparedFileWriteExecutorV1,
        cursor: HostedFileWriteCursorV1,
        policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
        payload_bytes: [u8], result_bytes: [u8]) -> HostedFileWriteStepReceiptV1:
    val validation = env_executor_validate_instruction(
        policy, instruction, payload_bytes, result_bytes)
    if env_instruction_status_to_i64(validation)
            != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
        return _hosted_file_write_rejected_v1(
            instruction, cursor, validation)
    if not executor.sealed or not cursor.sealed:
        return _hosted_file_write_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.InvalidInstruction)
    if cursor.consumed or instruction.sequence != 0
            or instruction.opcode != EnvOpcodeV1.FileWrite
            or instruction.capability_id != executor.capability_id:
        return _hosted_file_write_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Diverged)
    # The payload is the complete caller-owned argument region. No slice/copy is
    # formed on the commit path.
    if instruction.argument_offset != 0
            or instruction.argument_length != payload_bytes.len()
            or instruction.argument_capacity != payload_bytes.len()
            or instruction.argument_length > executor.max_payload_bytes:
        return _hosted_file_write_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Overflow)
    if instruction.result_capacity < 17:
        return _hosted_file_write_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Overflow)
    # Preparation admits an existing regular file. Recheck immediately around
    # the canonical facade call and fail closed on replacement or short write.
    if not file_is_regular_no_follow(executor.path)
            or not file_write_bytes(executor.path, payload_bytes)
            or not file_is_regular_no_follow(executor.path)
            or file_size(executor.path) != payload_bytes.len():
        return _hosted_file_write_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.InvalidInstruction)
    val offset = instruction.result_offset
    result_bytes[offset] = 1u8
    _env_write_i64_le(result_bytes, offset + 1, executor.path_digest_hi)
    _env_write_i64_le(result_bytes, offset + 9, executor.path_digest_lo)
    val receipt = env_execution_record_applied_v1(
        instruction, payload_bytes, result_bytes, 17, true, 0)
    HostedFileWriteStepReceiptV1(receipt: receipt,
        cursor: HostedFileWriteCursorV1(consumed: true, sealed: true))

fn hosted_prepare_file_read_session_v1(
        path: text, allowed_root: text, capability_id: i64,
        max_bytes: i64) -> HostedPreparedFileReadSessionV1:
    val valid = capability_id > 0 and capability_id < 63
        and max_bytes >= 0 and max_bytes <= HOSTED_ENV_CAPTURE_MAX_BYTES_V1
        and _env_path_safe_under_root(path, allowed_root)
        and file_is_regular_no_follow(path)
    val size_before = if valid: file_size(path) else: -1
    val bounded = valid and size_before >= 0 and size_before <= max_bytes
    val captured = if bounded: file_read_bytes(path) else: []
    val size_after = if bounded: file_size(path) else: -1
    val stable = bounded and file_is_regular_no_follow(path)
        and size_after == size_before and captured.len() == size_before
    val digest_hi = if stable: _env_text_digest_v1(path, false) else: 0
    val digest_lo = if stable: _env_text_digest_v1(path, true) else: 0
    val token = if stable:
        ((digest_hi * 257 + digest_lo + capability_id) % 2147483629) + 1
    else:
        0
    HostedPreparedFileReadSessionV1(
        path_digest_hi: digest_hi, path_digest_lo: digest_lo,
        handle_token: token, capability_id: if stable: capability_id else: 0,
        captured_bytes: captured,
        captured_length: if stable: captured.len() else: 0,
        sealed: stable)

fn hosted_file_read_session_cursor_v1() -> HostedFileReadSessionCursorV1:
    HostedFileReadSessionCursorV1(next_sequence: 0, closed: false, sealed: true)

fn _hosted_file_read_session_rejected_v1(
        instruction: EnvInstructionV1, cursor: HostedFileReadSessionCursorV1,
        status: EnvInstructionStatusV1) -> HostedFileReadSessionStepReceiptV1:
    HostedFileReadSessionStepReceiptV1(
        receipt: env_execution_rejected_v1(instruction, status), cursor: cursor)

fn hosted_file_read_session_execute_v1(
        executor: HostedPreparedFileReadSessionV1,
        cursor: HostedFileReadSessionCursorV1,
        policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
        argument_bytes: [u8], result_bytes: [u8])
        -> HostedFileReadSessionStepReceiptV1:
    val validation = env_executor_validate_instruction(
        policy, instruction, argument_bytes, result_bytes)
    if env_instruction_status_to_i64(validation)
            != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
        return _hosted_file_read_session_rejected_v1(
            instruction, cursor, validation)
    if not executor.sealed or not cursor.sealed or cursor.closed
            or instruction.capability_id != executor.capability_id
            or instruction.sequence != cursor.next_sequence:
        return _hosted_file_read_session_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Diverged)
    var result_length = 0
    var closed = false
    if cursor.next_sequence == 0 and instruction.opcode == EnvOpcodeV1.FileOpen:
        if instruction.argument_length != 16 or instruction.result_capacity < 8
                or _env_read_i64_le(argument_bytes, instruction.argument_offset)
                    != executor.path_digest_hi
                or _env_read_i64_le(argument_bytes,
                    instruction.argument_offset + 8) != executor.path_digest_lo:
            return _hosted_file_read_session_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.Diverged)
        _env_write_i64_le(result_bytes, instruction.result_offset,
                          executor.handle_token)
        result_length = 8
    else if cursor.next_sequence == 1
            and instruction.opcode == EnvOpcodeV1.FileRead:
        if instruction.argument_length != 8
                or _env_read_i64_le(argument_bytes, instruction.argument_offset)
                    != executor.handle_token
                or executor.captured_length > instruction.result_capacity:
            return _hosted_file_read_session_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.Diverged)
        var i = 0
        while i < executor.captured_length:
            result_bytes[instruction.result_offset + i] = executor.captured_bytes[i]
            i = i + 1
        result_length = executor.captured_length
    else if cursor.next_sequence == 2
            and instruction.opcode == EnvOpcodeV1.FileClose:
        if instruction.argument_length != 8 or instruction.result_capacity < 1
                or _env_read_i64_le(argument_bytes, instruction.argument_offset)
                    != executor.handle_token:
            return _hosted_file_read_session_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.Diverged)
        result_bytes[instruction.result_offset] = 1u8
        result_length = 1
        closed = true
    else:
        return _hosted_file_read_session_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Diverged)
    val receipt = env_execution_record_applied_v1(
        instruction, argument_bytes, result_bytes, result_length, true, 0)
    HostedFileReadSessionStepReceiptV1(receipt: receipt,
        cursor: HostedFileReadSessionCursorV1(
            next_sequence: cursor.next_sequence + 1,
            closed: closed, sealed: true))

fn hosted_prepare_stream_write_v1(
        stream_id: i64, capability_id: i64,
        sink_capacity: i64)
        -> HostedPreparedStreamWriteExecutorV1:
    val valid = stream_id >= 0 and capability_id > 0 and capability_id < 63
        and sink_capacity >= 0
        and sink_capacity <= HOSTED_ENV_CAPTURE_MAX_BYTES_V1
    HostedPreparedStreamWriteExecutorV1(
        stream_id: if valid: stream_id else: -1,
        capability_id: if valid: capability_id else: 0,
        sink_capacity: if valid: sink_capacity else: 0,
        sealed: valid)

fn hosted_stream_write_cursor_v1() -> HostedStreamWriteCursorV1:
    HostedStreamWriteCursorV1(consumed: false, sealed: true)

fn hosted_stream_write_execute_v1(
        executor: HostedPreparedStreamWriteExecutorV1,
        cursor: HostedStreamWriteCursorV1,
        policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
        argument_bytes: [u8], result_bytes: [u8], sink_bytes: [u8])
        -> HostedStreamWriteStepReceiptV1:
    val validation = env_executor_validate_instruction(
        policy, instruction, argument_bytes, result_bytes)
    if env_instruction_status_to_i64(validation)
            != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
        return HostedStreamWriteStepReceiptV1(
            receipt: env_execution_rejected_v1(instruction, validation),
            cursor: cursor)
    if not executor.sealed or not cursor.sealed or cursor.consumed
            or instruction.sequence != 0
            or instruction.opcode != EnvOpcodeV1.StreamWrite
            or instruction.capability_id != executor.capability_id
            or instruction.argument_offset != 0
            or instruction.argument_length < 8
            or instruction.argument_capacity != argument_bytes.len()
            or _env_read_i64_le(argument_bytes, 0) != executor.stream_id
            or instruction.argument_length - 8 > executor.sink_capacity
            or executor.sink_capacity > sink_bytes.len()
            or instruction.result_capacity < 8:
        return HostedStreamWriteStepReceiptV1(
            receipt: env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.Diverged), cursor: cursor)
    val payload_length = instruction.argument_length - 8
    var i = 0
    while i < payload_length:
        sink_bytes[i] = argument_bytes[8 + i]
        i = i + 1
    _env_write_i64_le(result_bytes, instruction.result_offset, payload_length)
    val receipt = env_execution_record_applied_v1(
        instruction, argument_bytes, result_bytes, 8, true, 0)
    HostedStreamWriteStepReceiptV1(receipt: receipt,
        cursor: HostedStreamWriteCursorV1(consumed: true, sealed: true))

fn hosted_prepare_process_v1(command: text, arguments: [text],
                             capability_id: i64) -> HostedPreparedProcessExecutorV1:
    # Process creation and command storage are preparation work. The sealed
    # lifecycle below retains only scalars and never constructs an argument.
    var valid = capability_id > 0 and capability_id < 63
        and command.len() > 0 and command.len() <= 1024
        and arguments.len() <= 32 and _env_text_byte_safe(command)
    var total_bytes = command.len()
    var i = 0
    while valid and i < arguments.len():
        total_bytes = total_bytes + arguments[i].len()
        valid = arguments[i].len() <= 1024
            and total_bytes <= 8192 and _env_text_byte_safe(arguments[i])
        i = i + 1
    val process_id = if valid: process_spawn_async(command, arguments) else: -1
    val ready = valid and process_id > 1 and process_is_alive(process_id)
    HostedPreparedProcessExecutorV1(
        process_id: if ready: process_id else: -1,
        command_digest_hi: if ready:
            _env_command_digest_v1(command, arguments, false)
        else: 0,
        command_digest_lo: if ready:
            _env_command_digest_v1(command, arguments, true)
        else: 0,
        capability_id: if ready: capability_id else: 0,
        sealed: ready)

fn hosted_process_cursor_v1() -> HostedProcessCursorV1:
    HostedProcessCursorV1(next_sequence: 0, terminated: false, sealed: true)

fn _hosted_process_rejected_v1(
        instruction: EnvInstructionV1, cursor: HostedProcessCursorV1,
        status: EnvInstructionStatusV1) -> HostedProcessStepReceiptV1:
    HostedProcessStepReceiptV1(
        receipt: env_execution_rejected_v1(instruction, status), cursor: cursor)

fn hosted_process_execute_v1(
        executor: HostedPreparedProcessExecutorV1,
        cursor: HostedProcessCursorV1,
        policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
        argument_bytes: [u8], result_bytes: [u8]) -> HostedProcessStepReceiptV1:
    val validation = env_executor_validate_instruction(
        policy, instruction, argument_bytes, result_bytes)
    if env_instruction_status_to_i64(validation)
            != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
        return _hosted_process_rejected_v1(instruction, cursor, validation)
    if not executor.sealed or not cursor.sealed or cursor.terminated
            or instruction.capability_id != executor.capability_id
            or instruction.sequence != cursor.next_sequence:
        return _hosted_process_rejected_v1(
            instruction, cursor, EnvInstructionStatusV1.Diverged)
    var result_length = 0
    var terminated = false
    if instruction.opcode == EnvOpcodeV1.ProcessSpawn:
        if cursor.next_sequence != 0 or instruction.argument_length != 16
                or instruction.result_capacity < 8:
            return _hosted_process_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.InvalidInstruction)
        val digest_hi = _env_read_i64_le(
            argument_bytes, instruction.argument_offset)
        val digest_lo = _env_read_i64_le(
            argument_bytes, instruction.argument_offset + 8)
        if digest_hi != executor.command_digest_hi
                or digest_lo != executor.command_digest_lo
                or not process_is_alive(executor.process_id):
            return _hosted_process_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.Diverged)
        _env_write_i64_le(result_bytes, instruction.result_offset,
                          executor.process_id)
        result_length = 8
    else:
        if instruction.argument_length != 8 or instruction.result_capacity < 1
                or _env_read_i64_le(argument_bytes, instruction.argument_offset)
                    != executor.process_id:
            return _hosted_process_rejected_v1(
                instruction, cursor, EnvInstructionStatusV1.Diverged)
        if instruction.opcode == EnvOpcodeV1.ProcessPoll:
            result_bytes[instruction.result_offset] =
                if process_is_alive(executor.process_id): 1u8 else: 0u8
            result_length = 1
        else:
            if instruction.opcode != EnvOpcodeV1.ProcessKill
                    or not process_kill(executor.process_id):
                return _hosted_process_rejected_v1(
                    instruction, cursor, EnvInstructionStatusV1.InvalidInstruction)
            result_bytes[instruction.result_offset] = 1u8
            result_length = 1
            terminated = true
    val receipt = env_execution_record_applied_v1(
        instruction, argument_bytes, result_bytes, result_length, true, 0)
    HostedProcessStepReceiptV1(receipt: receipt,
        cursor: HostedProcessCursorV1(
            next_sequence: cursor.next_sequence + 1,
            terminated: terminated, sealed: true))

impl EnvPhysicalExecutorPortV1 for HostedProcessPollEnvExecutorV1:
    fn execute(policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
               argument_bytes: [u8], result_bytes: [u8]) -> EnvExecutionReceiptV1:
        val validation = env_executor_validate_instruction(
            policy, instruction, argument_bytes, result_bytes)
        if env_instruction_status_to_i64(validation)
                != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
            return env_execution_rejected_v1(instruction, validation)
        if not self.sealed or instruction.opcode != EnvOpcodeV1.ProcessPoll:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.UnsupportedCapability)
        if instruction.argument_length != 8 or instruction.result_capacity < 1:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.InvalidInstruction)
        val process_id = _env_read_i64_le(
            argument_bytes, instruction.argument_offset)
        result_bytes[instruction.result_offset] =
            if process_is_alive(process_id): 1u8 else: 0u8
        env_execution_record_applied_v1(
            instruction, argument_bytes, result_bytes, 1, true, 0)

impl EnvPhysicalExecutorPortV1 for HostedPreparedEnvironmentGetExecutorV1:
    fn execute(policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
               argument_bytes: [u8], result_bytes: [u8]) -> EnvExecutionReceiptV1:
        val validation = env_executor_validate_instruction(
            policy, instruction, argument_bytes, result_bytes)
        if env_instruction_status_to_i64(validation)
                != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
            return env_execution_rejected_v1(instruction, validation)
        if not self.sealed or not self.captured_from_host
                or instruction.opcode != EnvOpcodeV1.EnvironmentGet:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.UnsupportedCapability)
        if instruction.argument_length != self.key_bytes.len()
                or self.value_bytes.len() > instruction.result_capacity:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.InvalidInstruction)
        var i = 0
        while i < self.key_bytes.len():
            if argument_bytes[instruction.argument_offset + i] != self.key_bytes[i]:
                return env_execution_rejected_v1(
                    instruction, EnvInstructionStatusV1.Diverged)
            i = i + 1
        i = 0
        while i < self.value_bytes.len():
            result_bytes[instruction.result_offset + i] = self.value_bytes[i]
            i = i + 1
        env_execution_record_applied_v1(
            instruction, argument_bytes, result_bytes,
            self.value_bytes.len(), true, 0)

impl EnvPhysicalExecutorPortV1 for HostedPreparedCaptureExecutorV1:
    fn execute(policy: EnvExecutorPolicyV1, instruction: EnvInstructionV1,
               argument_bytes: [u8], result_bytes: [u8]) -> EnvExecutionReceiptV1:
        val validation = env_executor_validate_instruction(
            policy, instruction, argument_bytes, result_bytes)
        if env_instruction_status_to_i64(validation)
                != env_instruction_status_to_i64(EnvInstructionStatusV1.Planned):
            return env_execution_rejected_v1(instruction, validation)
        if not self.sealed or not self.capture_valid
                or instruction.opcode != self.opcode:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.UnsupportedCapability)
        if instruction.argument_length != self.argument_bytes.len()
                or self.captured_length > instruction.result_capacity:
            return env_execution_rejected_v1(
                instruction, EnvInstructionStatusV1.Overflow)
        var i = 0
        while i < self.argument_bytes.len():
            if argument_bytes[instruction.argument_offset + i]
                    != self.argument_bytes[i]:
                return env_execution_rejected_v1(
                    instruction, EnvInstructionStatusV1.Diverged)
            i = i + 1
        i = 0
        while i < self.captured_length:
            result_bytes[instruction.result_offset + i] = self.captured_bytes[i]
            i = i + 1
        env_execution_record_applied_v1(
            instruction, argument_bytes, result_bytes,
            self.captured_length, self.physical_effect, 0)

