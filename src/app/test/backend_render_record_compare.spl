# Production parser/validator/comparator for serialized Simple RenderDoc evidence.
use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{file_read}
use common.renderdoc.backend_render_record.{
    BackendRenderOracle, parse_backend_render_record,
    verify_backend_render_equivalence
}

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 2:
        print("simple_renderdoc_record_compare_status=fail reason=expected-two-record-paths\n")
        return 2
    match parse_backend_render_record(file_read(args[0])):
        case Err(err):
            print("simple_renderdoc_capture_record_valid=0 reason=" + err.code + " path=" + err.path + "\n")
            print("simple_renderdoc_record_compare_status=fail reason=invalid-capture-record\n")
            return 1
        case Ok(capture):
            print("simple_renderdoc_capture_record_valid=1\n")
            match parse_backend_render_record(file_read(args[1])):
                case Err(err):
                    print("simple_renderdoc_translation_record_valid=0 reason=" + err.code + " path=" + err.path + "\n")
                    print("simple_renderdoc_record_compare_status=fail reason=invalid-translation-record\n")
                    return 1
                case Ok(translation):
                    print("simple_renderdoc_translation_record_valid=1\n")
                    val result = verify_backend_render_equivalence(capture, translation, BackendRenderOracle(oracle_mismatch_count: 0, pair_mismatch_count: 0, blur_or_tolerance: false))
                    print("simple_renderdoc_semantic_equal=" + result.record_diff.semantic_equal.to_text() + "\n")
                    if result.passed:
                        print("simple_renderdoc_record_compare_status=pass reason=pass\n")
                        return 0
                    print("simple_renderdoc_record_compare_status=fail reason=" + result.reason + "\n")
                    return 1
