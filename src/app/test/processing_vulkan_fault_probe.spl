"""Native Vulkan ProcessingIR success and fault-phase probe."""

use app.io.args_ops.{get_args}
use app.io.env_ops.{env_set}
use std.common.processing.processing_ir.{processing_ir_fill_u32}
use std.gc_async_mut.processing.fault_injection.{processing_ir_fault_injected}
use std.gc_async_mut.processing.vulkan_fill_u32.{
    processing_vulkan_device_identity, processing_ir_execute_vulkan
}

fn _phase_from_args(args: [text]) -> text:
    for arg in args:
        if arg == "--phase=none": return "none"
        if arg == "--phase=unavailable": return "unavailable"
        if arg == "--phase=init": return "init"
        if arg == "--phase=submit": return "submit"
        if arg == "--phase=readback": return "readback"
        if arg == "--phase=mismatch": return "mismatch"
        if arg == "--phase=dispatch-ineligible": return "dispatch-ineligible"
        if arg == "--recover=submit": return "recover-submit"
    ""

fn _expected_reason(phase: text) -> text:
    if phase == "unavailable": return "vulkan-unavailable"
    if phase == "init": return "vulkan-init-failed"
    if phase == "submit": return "vulkan-submit-failed"
    if phase == "readback": return "vulkan-readback-failed"
    if phase == "mismatch": return "checksum-mismatch"
    if phase == "dispatch-ineligible": return "vulkan-dispatch-ineligible"
    "ok"

fn _values_exact(values: [u32], expected_count: i64, expected_value: u32) -> bool:
    var exact = values.len() == expected_count
    for actual in values:
        exact = exact and actual == expected_value
    exact

fn _run_submit_recovery(value: u32) -> i64:
    val before = processing_ir_execute_vulkan(processing_ir_fill_u32(64, value))
    val before_exact = _values_exact(before.values, 64, value)
    val fault_armed = env_set("SIMPLE_GPU_FAULT_INJECT", "vulkan:submit")
    val failed = processing_ir_execute_vulkan(processing_ir_fill_u32(64, value))
    val fault_cleared = env_set("SIMPLE_GPU_FAULT_INJECT", "")
    val recovered = processing_ir_execute_vulkan(processing_ir_fill_u32(64, value))
    val recovered_exact = _values_exact(recovered.values, 64, value)
    val identity_stable =
        recovered.backend_handle == before.backend_handle and
        recovered.device_identity == before.device_identity
    val valid =
        before.completed and before.reason == "ok" and before_exact and
            before.backend_handle > 0 and before.device_identity > 0 and fault_armed and
        not failed.completed and failed.reason == "vulkan-submit-failed" and
        failed.values.len() == 0 and failed.backend_handle == 0 and
        failed.device_identity == 0 and fault_cleared and
        recovered.completed and recovered.reason == "ok" and recovered_exact and
        recovered.backend_handle > 0 and recovered.device_identity > 0 and
        identity_stable
    val status = if valid: "pass" else: "fail"
    print("VULKAN_FAULT_RECOVERY status={status} phase=submit before_exact={before_exact} before_handle={before.backend_handle} before_identity={before.device_identity} fault_armed={fault_armed} failed_reason={failed.reason} failed_handle={failed.backend_handle} failed_identity={failed.device_identity} fault_cleared={fault_cleared} recovered={recovered.completed} recovered_exact={recovered_exact} recovered_handle={recovered.backend_handle} recovered_identity={recovered.device_identity} identity_stable={identity_stable}\n")
    if valid: 0 else: 1

fn main() -> i64:
    val phase = _phase_from_args(get_args())
    if phase != "none" and phase != "unavailable" and phase != "init" and
       phase != "submit" and phase != "readback" and phase != "mismatch" and
       phase != "dispatch-ineligible" and phase != "recover-submit":
        print("VULKAN_FAULT_NATIVE status=fail reason=invalid-phase\n")
        return 2
    val value = 0x01020304u32
    if phase == "recover-submit":
        return _run_submit_recovery(value)
    val result = processing_ir_execute_vulkan(processing_ir_fill_u32(64, value))
    val fault_active = phase != "none" and processing_ir_fault_injected("vulkan", phase)
    val hash_sanity = processing_vulkan_device_identity("abc") == 96354
    val values_exact = _values_exact(result.values, 64, value)
    val valid = if phase == "none":
        result.completed and result.reason == "ok" and values_exact and
            result.backend_handle > 0 and result.device_identity > 0 and
            hash_sanity and not fault_active
    else:
        not result.completed and result.reason == _expected_reason(phase) and
            result.values.len() == 0 and result.backend_handle == 0 and
            result.device_identity == 0 and fault_active
    val status = if valid: "pass" else: "fail"
    print("VULKAN_FAULT_NATIVE status={status} phase={phase} fault_active={fault_active} completed={result.completed} reason={result.reason} values={result.values.len()} values_exact={values_exact} hash_sanity={hash_sanity} handle={result.backend_handle} identity={result.device_identity}\n")
    if valid: 0 else: 1
