# sys_get_args includes the executable at index zero. Only that position is
# ignored; unexpected positional arguments after it remain errors.
fn aggregate_task_verify_options_v1(args: [text]) -> Result<Dict<text, text>, text>:
    if args.len() == 0 or args[0] == "": return Err("native argv[0] missing")
    val allowed = ["stage", "backend", "identity-manifest", "identity-manifest-sha256",
        "inventory-manifest", "inventory-manifest-sha256", "report-root", "db-root", "threads"]
    var options: Dict<text, text> = {}
    for index in 1..args.len():
        val arg = args[index]
        if not arg.starts_with("--"): return Err("unexpected positional argument")
        val split = arg.index_of("=")
        if split < 3: return Err("expected --name=value")
        val name = arg[2:split]
        if not allowed.contains(name) or options.contains_key(name):
            return Err("unknown or duplicate option")
        options[name] = arg[split + 1:]
    for name in allowed:
        if not options.contains_key(name) or options[name] == "": return Err("missing verifier option")
    if options["threads"] != "80": return Err("expected admitted 80-worker policy")
    Ok(options)

export aggregate_task_verify_options_v1
