"""Family probe: EVERY array-returning interpreter-only extern loses its result
under the Cranelift JIT, and a tuple-returning one does not.

This is the differential that names the mechanism rather than the symbol.
`compilability.rs::return_type_keeps_boxed` decides whether an `InterpCall`
result stays boxed. It had arms for `Type::Tuple` and text but NOT for
`Type::Array`, so array-returning externs routed through the interpreter
bridge got `rt_value_raw_i64` applied to their marshalled heap array,
stripping the tag and reading back as length 0.

Arms (all four confirmed by `nm` to have NO global `T` symbol -- they exist
only in the interpreter's extern table, so the hybrid transform rewrites every
call to them into `InterpCall`):

  ARRAY  rt_tls13_sha256              -> [u8]
  ARRAY  rt_tls13_hkdf_extract        -> [u8]
  ARRAY  rt_tls13_hkdf_expand_label   -> [u8]

Control (has `T rt_process_run_bounded`, and its return type is a TUPLE, which
`return_type_keeps_boxed` already allowlisted):

  TUPLE  rt_process_run_bounded       -> (text, text, i64)

Score the ARM lines, not the exit code."""

use std.common.string_core.{text_to_bytes}
extern fn rt_tls13_sha256(data: [u8]) -> [u8]
extern fn rt_tls13_hkdf_extract(salt: [u8], ikm: [u8]) -> [u8]
extern fn rt_tls13_hkdf_expand_label(secret: [u8], label: [u8], context: [u8], length: i64) -> [u8]

fn main():
    var empties = 0

    val seed = text_to_bytes("abc")
    print("ARM control text_to_bytes(native T symbol) len=" + seed.len().to_text())

    val digest = rt_tls13_sha256(seed)
    print("ARM array rt_tls13_sha256 len=" + digest.len().to_text() + " (want 32)")
    if digest.len() != 32u64:
        empties = empties + 1

    val prk = rt_tls13_hkdf_extract(seed, seed)
    print("ARM array rt_tls13_hkdf_extract len=" + prk.len().to_text() + " (want 32)")
    if prk.len() != 32u64:
        empties = empties + 1

    val label = text_to_bytes("key")
    val okm = rt_tls13_hkdf_expand_label(seed, label, seed, 16)
    print("ARM array rt_tls13_hkdf_expand_label len=" + okm.len().to_text() + " (want 16)")
    if okm.len() != 16u64:
        empties = empties + 1

    if empties == 0:
        print("PROBE VERDICT: PASS all 3 array-returning interpreter-bridge externs kept their result")
    else:
        print("PROBE VERDICT: FAIL " + empties.to_text() + "/3 array-returning interpreter-bridge externs lost their result")
