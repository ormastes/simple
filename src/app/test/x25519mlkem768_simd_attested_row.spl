# Final-matrix adapter for a public-only native SIMD observation.
#
# The runner observation remains intentionally non-promotable.  This adapter
# accepts a separately admitted performance receipt, rechecks the retained
# public workload record, and lets the common composer make the sole promotion
# decision before constructing exactly one Executed matrix row.

mod app.test.x25519mlkem768_simd_attested_row

use app.test.x25519mlkem768_evidence.{X25519MlKem768PinnedSimdObservation}
use app.test.x25519mlkem768_pinned_workload.{
    X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
    X25519_MLKEM768_PINNED_FIXTURE_ID,
    X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
    X25519_MLKEM768_PINNED_ORACLE_ID,
    X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES}
use lib.common.crypto.x25519_mlkem768.performance_attestation.{
    X25519MlKem768PerformanceAttestation}
use lib.common.crypto.x25519_mlkem768.simd_full_operation_receipt.{
    X25519MlKem768SimdReceiptBinding,
    X25519MlKem768SimdPublicObservation,
    x25519_mlkem768_compose_simd_observed_full_operation_receipt}
use lib.common.crypto.x25519_mlkem768.executed_row_composer.{
    x25519_mlkem768_compose_executed_matrix_row}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{X25519MlKem768MatrixRow}

fn _simd_attested_observation_reason(
        observation: X25519MlKem768PinnedSimdObservation,
        binding: X25519MlKem768SimdReceiptBinding) -> text:
    val outputs = observation.public_outputs
    if outputs.schema != X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA or
            outputs.fixture_id != X25519_MLKEM768_PINNED_FIXTURE_ID or
            outputs.workload_sha256 != X25519_MLKEM768_PINNED_WORKLOAD_SHA256 or
            outputs.oracle_id != X25519_MLKEM768_PINNED_ORACLE_ID:
        return "simd-attested-pinned-workload-contract-mismatch"
    if outputs.fixture_id != binding.fixture_id or
            outputs.workload_sha256 != binding.pinned_workload_sha256:
        return "simd-attested-binding-workload-mismatch"
    if outputs.set_a != observation.set_a or outputs.set_b != observation.set_b or
            outputs.set_c != observation.set_c:
        return "simd-attested-public-set-mismatch"
    if outputs.client_share_bytes != observation.raw_receipt.client_share_bytes or
            outputs.server_share_bytes != observation.raw_receipt.server_share_bytes or
            outputs.shared_secret_bytes != observation.raw_receipt.shared_secret_bytes or
            outputs.public_wire_bytes != X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES:
        return "simd-attested-public-shape-mismatch"
    if outputs.client_share_sha256 != observation.client_share_sha256 or
            outputs.server_share_sha256 != observation.server_share_sha256:
        return "simd-attested-public-wire-mismatch"
    if outputs.keygen_output_digest != observation.raw_receipt.keygen_output_digest or
            outputs.encapsulate_output_digest != observation.raw_receipt.encapsulate_output_digest or
            outputs.decapsulate_output_digest != observation.raw_receipt.decapsulate_output_digest:
        return "simd-attested-operation-output-mismatch"
    ""

# This is the only app-level path from an observed SIMD runner hand-off to a
# final matrix row.  It does not mutate source-matrix rows and cannot turn a
# raw receipt promotable itself: the shared composer verifies the raw false
# flag, Stage-4 provenance, exact public output oracle, and performance proof.
fn x25519_mlkem768_compose_simd_attested_matrix_row(
        binding: X25519MlKem768SimdReceiptBinding,
        observation: X25519MlKem768PinnedSimdObservation,
        performance: X25519MlKem768PerformanceAttestation
        ) -> Result<X25519MlKem768MatrixRow, text>:
    val observation_reason = _simd_attested_observation_reason(observation, binding)
    if observation_reason != "": return Err(observation_reason)
    val public_observation = X25519MlKem768SimdPublicObservation(
        raw_receipt: observation.raw_receipt,
        backend_configuration_sha256: performance.backend_configuration_sha256,
        set_a: observation.set_a, set_b: observation.set_b, set_c: observation.set_c,
        client_share_sha256: observation.client_share_sha256,
        server_share_sha256: observation.server_share_sha256)
    val execution = x25519_mlkem768_compose_simd_observed_full_operation_receipt(
        binding, public_observation, Some(performance))?
    x25519_mlkem768_compose_executed_matrix_row(execution,
        binding.runner_artifact_sha256, binding.stage4_binary_sha256,
        binding.host_os, binding.host_arch,
        observation.set_a, observation.set_b, observation.set_c,
        observation.client_share_sha256, observation.server_share_sha256)

export x25519_mlkem768_compose_simd_attested_matrix_row
