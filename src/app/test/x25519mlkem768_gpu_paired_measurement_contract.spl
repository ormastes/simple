# Fail-closed count contract shared by the future scalar/GPU ABBA collector.
# This module performs no device I/O and accepts no caller-asserted identities.

mod app.test.x25519mlkem768_gpu_paired_measurement_contract

use os.crypto.x25519_mlkem768.gpu_lifecycle_snapshot.{
    X25519MlKem768GpuLifecycleDelta,
    x25519_mlkem768_gpu_lifecycle_delta_valid}

val X25519_MLKEM768_GPU_PAIRED_MINIMUM_SAMPLES: i64 = 30
val X25519_MLKEM768_GPU_PAIRED_MAXIMUM_SAMPLES: i64 = 1024
val X25519_MLKEM768_GPU_OPERATIONS_PER_EXCHANGE: i64 = 3

fn x25519_mlkem768_gpu_paired_count_reason(pair_count: i64) -> text:
    if pair_count < X25519_MLKEM768_GPU_PAIRED_MINIMUM_SAMPLES:
        return "gpu-paired-sample-count-too-small"
    if pair_count > X25519_MLKEM768_GPU_PAIRED_MAXIMUM_SAMPLES:
        return "gpu-paired-sample-count-too-large"
    if pair_count % 2 != 0:
        return "gpu-paired-sample-count-not-even"
    ""

fn x25519_mlkem768_gpu_timed_lifecycle_reason(
        delta: X25519MlKem768GpuLifecycleDelta,
        full_exchange_count: i64,
        operation_kernel_count: i64) -> text:
    if x25519_mlkem768_gpu_paired_count_reason(full_exchange_count) != "":
        return "gpu-timed-full-exchange-count-invalid"
    if not x25519_mlkem768_gpu_lifecycle_delta_valid(delta):
        return "gpu-timed-lifecycle-delta-invalid"
    if operation_kernel_count < 1:
        return "gpu-timed-operation-kernel-count-invalid"
    if delta.kernel_count != operation_kernel_count:
        return "gpu-timed-operation-kernel-count-mismatch"
    val hybrid_operation_count = full_exchange_count *
        X25519_MLKEM768_GPU_OPERATIONS_PER_EXCHANGE
    if delta.kernel_count < hybrid_operation_count:
        return "gpu-timed-kernel-count-too-small"
    ""

export X25519_MLKEM768_GPU_PAIRED_MINIMUM_SAMPLES
export X25519_MLKEM768_GPU_PAIRED_MAXIMUM_SAMPLES
export X25519_MLKEM768_GPU_OPERATIONS_PER_EXCHANGE
export x25519_mlkem768_gpu_paired_count_reason
export x25519_mlkem768_gpu_timed_lifecycle_reason
