# Requested jobs are configuration, not evidence of actual parallel execution.
pub fn aggregate_task_requested_jobs_v1(value: text) -> Result<i64, text>:
    if value == "" or value.len() > 19:
        return Err("expected a positive canonical worker count")
    var requested: i64 = 0
    for index in 0..value.len():
        val digit: i64 = "0123456789".index_of(value[index:index + 1])
        if digit < 0:
            return Err("expected a positive canonical worker count")
        if requested > 922337203685477580 or (requested == 922337203685477580 and digit > 7):
            return Err("worker count exceeds i64")
        requested = requested * 10 + digit
    if requested <= 0 or str(requested) != value:
        return Err("expected a positive canonical worker count")
    Ok(requested)

pub fn aggregate_task_concurrency_report_v1(value: text) -> Result<text, text>:
    val requested = aggregate_task_requested_jobs_v1(value)?
    # aggregate_task_run_v1 awaits each process before dispatching the next.
    # This is its configured execution bound, not a measured worker count.
    Ok("requested_jobs=" + str(requested) + "\nexecution_mode=serial\nexecution_worker_limit=1\n")
