"""Digest bit-identity probe for `sha256_text` across engines.

Prints one `PROBE DIGEST n=<n> len=<len> sha=<digest>` line per size, so an
interpret/jit A/B is a plain textual diff. Sizes are the ones the
qualified-timing campaign pins: n = 0,1,2,7,30,64,129,1025.
"""

use std.common.crypto.sha256.{sha256_text}

fn _blob(n: i64) -> text:
    var parts: [text] = []
    var i: i64 = 0
    while i < n:
        parts.push("{i}:sample_ns=abcdef0123456789;")
        i = i + 1
    parts.join("")

fn main():
    val sizes: [i64] = [0, 1, 2, 7, 30, 64, 129, 1025]
    var s: i64 = 0
    while s < sizes.len():
        val n = sizes[s]
        val material = _blob(n)
        val digest = sha256_text(material)
        val dlen = digest.len()
        print("PROBE DIGEST n=" + n.to_text() + " bytes=" + material.len().to_text() + " len=" + dlen.to_text() + " sha=" + digest)
        s = s + 1
    print("PROBE VERDICT: PASS")
