# Compiled parent entry for one independent aggregate product. The bootstrap
# DAG runs every product even when this entry returns nonzero. Input digest
# bindings are not a replacement for canonical bootstrap admission.
use std.sffi.cli_args.{cli_get_args}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.sffi.fs.{file_create_excl}
use std.nogc_sync_mut.fs.host_path.{host_path_is_absolute}
use std.nogc_sync_mut.io.resource_scope.{ExecutionResourceClass, execution_resource_scope}
use std.io_runtime.{file_hash_sha256_or_empty}
use std.common.crypto.sha256.{sha256_text}
use std.common.task_runner.journal.{task_runner_journal_open_v1, task_runner_journal_release_v1}
use std.common.task_runner.snapshot.{task_runner_snapshot_commit_v1}
use std.test_runner.aggregate_task_executor.{aggregate_test_enumerate_v1}
use std.test_runner.aggregate_task_driver.{aggregate_task_run_v1}
use std.test_runner.aggregate_task_manifest.{aggregate_task_manifest_read_v1, aggregate_task_manifest_identities_v1}

fn _task_field(fields: Dict<text, text>, key: text) -> Result<text, text>:
    if not fields.contains_key(key) or fields[key] == "": return Err("missing task field: " + key)
    Ok(fields[key])

fn _task_run(options: Dict<text, text>) -> Result<text, text>:
    if _task_field(options, "threads")? != "80": return Err("expected 80-worker diagnostic policy")
    val bound = aggregate_task_manifest_read_v1(_task_field(options, "identity-manifest")?,
        _task_field(options, "identity-manifest-sha256")?, _task_field(options, "inventory-manifest")?,
        _task_field(options, "inventory-manifest-sha256")?, _task_field(options, "stage")?,
        _task_field(options, "backend")?, _task_field(options, "report-root")?)?
    val template = bound.template
    val command = bound.command
    val stage = template.phase
    val backend = template.backend
    val subsystem = template.task_id
    val producer = template.producer_digest
    val source = template.source_digest
    val runtime = template.runtime_digest
    val toolchain = template.toolchain_digest
    val policy = template.policy_digest
    val execution = template.execution_digest
    val identity_digest = bound.identity_manifest_digest
    val inventory_digest = bound.inventory_manifest_digest
    val program_digest = command.program_digest
    val artifact_digest = command.artifact_digest
    val runtime_mode = command.runtime_mode
    val nonce = command.group_id
    # Work deadlines are explicitly disabled for this diagnostic entry. The
    # process owner still retains its finite collection and stream limits.
    val scope = execution_resource_scope(ExecutionResourceClass.Unbounded, 0, 134217728)
    val enumeration = aggregate_test_enumerate_v1(command, scope)?
    val identities = aggregate_task_manifest_identities_v1(bound, enumeration.inventory)?
    val owner = task_runner_journal_open_v1(_task_field(options, "db-root")?, nonce, source, identities)?
    val executed = aggregate_task_run_v1(owner, enumeration.inventory, command, scope, identities, 3)
    if executed.is_err():
        val _released = task_runner_journal_release_v1(owner)
        return Err(executed.unwrap_err())
    val run = executed.unwrap()
    val totals = run.totals
    val snapshot = task_runner_snapshot_commit_v1(run.journal, run.journal.revision)
    val released = task_runner_journal_release_v1(run.journal)
    var complete = run.infrastructure_error == "" and snapshot.is_ok() and released.is_ok()
    # A fully collected assertion failure is complete but unsuccessful. A
    # crash that later passes remains unsuccessful through transport_failed.
    val failed = not complete or run.transport_failed or totals.failed > 0 or
        totals.crashed > 0 or totals.exhausted > 0 or totals.aborted > 0 or
        totals.not_run > 0 or totals.pending > 0 or totals.passed == 0
    var summary = "format=SIMPLE-AGGREGATE-TASK-SUMMARY-1\n"
    summary = summary + "provenance_status=caller-bound-unadmitted\nstage=" + stage + "\nbackend=" + backend + "\nsubsystem=" + subsystem + "\nruntime_mode=" + runtime_mode + "\n"
    summary = summary + "identity_manifest_digest=" + identity_digest + "\ninventory_manifest_digest=" + inventory_digest + "\n"
    summary = summary + "producer_digest=" + producer + "\nsource_digest=" + source + "\nruntime_digest=" + runtime + "\ntoolchain_digest=" + toolchain + "\npolicy_digest=" + policy + "\nexecution_digest=" + execution + "\n"
    summary = summary + "artifact_digest=" + artifact_digest + "\nprogram_digest=" + program_digest + "\nenvironment_digest=" + command.environment_digest + "\n"
    summary = summary + "expected_inventory_digest=" + file_hash_sha256_or_empty(enumeration.ledger_path) + "\nexpected_count=" + str(totals.expected) + "\n"
    summary = summary + "pass=" + str(totals.passed) + "\nfail=" + str(totals.failed) + "\ncrash=" + str(totals.crashed) + "\nexhausted=" + str(totals.exhausted) + "\nskip=" + str(totals.skipped) + "\npending=" + str(totals.pending) + "\nabort=" + str(totals.aborted) + "\nnotrun=" + str(totals.not_run) + "\ncrash_attempts=" + str(totals.crash_attempts) + "\n"
    summary = summary + "task_db_revision=" + (if snapshot.is_ok(): snapshot.unwrap() else: "unavailable") + "\ntask_db_identity=" + run.journal.database_identity + "\n"
    summary = summary + "transport_failed=" + (if run.transport_failed: "1" else: "0") + "\n"
    summary = summary + "completion=" + (if complete: "1" else: "0") + "\naggregate_exit=" + (if failed: "1" else: "0") + "\n"
    if run.infrastructure_error != "": summary = summary + "error_digest=" + sha256_text(run.infrastructure_error) + "\n"
    Ok(summary)

fn main() -> i64:
    var options: Dict<text, text> = {}
    val allowed = ["stage", "backend", "identity-manifest", "identity-manifest-sha256",
        "inventory-manifest", "inventory-manifest-sha256", "report-root", "db-root", "threads"]
    for arg in cli_get_args():
        if not arg.starts_with("--"): continue
        val split = arg.index_of("=")
        if split < 3: return 2
        val name = arg[2:split]
        if not allowed.contains(name) or options.contains_key(name): return 2
        options[name] = arg[split + 1:]
    for name in allowed:
        if not options.contains_key(name) or options[name] == "": return 2
    for name in ["identity-manifest", "inventory-manifest", "report-root", "db-root"]:
        if not host_path_is_absolute(options[name]): return 2
    val summary_path = options["report-root"] + "/summary.env"
    if file_exists(summary_path): return 2
    var code: i64 = 2
    var summary = ""
    match _task_run(options):
        case Ok(value):
            summary = value
            code = if value.contains("\naggregate_exit=0\n"): 0 else: 1
        case Err(message):
            summary = "format=SIMPLE-AGGREGATE-TASK-SUMMARY-1\nprovenance_status=caller-bound-unadmitted\nstage=" + options["stage"] + "\nbackend=" + options["backend"] + "\ncompletion=0\nexpected_count=-1\naggregate_exit=2\nerror_digest=" + sha256_text(message) + "\n"
            print "aggregate task error: " + message
    if not file_create_excl(summary_path, summary): return 2
    code
