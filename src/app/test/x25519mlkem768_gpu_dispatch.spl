# Pure-Simple exact-binary GPU evidence dispatch for X25519MLKEM768.
#
# This companion owns GPU-only admission, executor construction, lifecycle
# checks, and receipt composition. It has no raw runtime imports, never falls
# back to CPU, and never emits a promotion claim.

mod app.test.x25519mlkem768_gpu_dispatch

use app.io.mod.{file_hash_sha256, file_is_regular_no_follow, file_read}
use std.common.crypto.sha256.{sha256_text}
use std.gc_async_mut.gpu_ops.{
    gpu_device_name, gpu_device_compute_capability}
use lib.common.provenance.stage4_compiler_provenance.{
    stage4_compiler_provenance_from_text,
    stage4_compiler_provenance_reason}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768VerificationPolicy,
    X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES,
    x25519_mlkem768_default_config}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceStatus, X25519MlKem768EvidenceCli,
    X25519MlKem768RunReceipt,
    X25519_MLKEM768_EVIDENCE_MAX_BATCH,
    x25519_mlkem768_evidence_backend_name}
use app.test.x25519mlkem768_pinned_workload.{
    X25519_MLKEM768_PINNED_FIXTURE_ID,
    x25519_mlkem768_run_pinned_cuda_workload,
    x25519_mlkem768_run_pinned_vulkan_workload}
use app.test.x25519mlkem768_gpu_binding.{
    X25519_MLKEM768_GPU_BINDING_SCHEMA,
    X25519MlKem768GpuCanonicalTuple,
    x25519_mlkem768_gpu_canonical_tuple_reason}
use lib.common.crypto.x25519_mlkem768.runner_artifact_provenance.{
    x25519_mlkem768_parse_runner_artifact_provenance,
    x25519_mlkem768_runner_artifact_provenance_reason}
use os.crypto.x25519_mlkem768.cuda_ntt_provider.{
    X25519MlKem768CudaNttExecutor}
use os.crypto.x25519_mlkem768.vulkan_ntt_provider.{
    X25519MlKem768VulkanNttExecutor}

val _GPU_EVIDENCE_SCHEMA = "x25519mlkem768-evidence-v1"
val _GPU_FIXTURE_ID = X25519_MLKEM768_PINNED_FIXTURE_ID

struct X25519MlKem768GpuDispatchRequest:
    evidence: X25519MlKem768EvidenceCli
    compiler_artifact: text
    compiler_provenance: text
    runner_artifact: text
    runner_source: text
    runner_provenance: text
    accelerator_binding: text
    accelerator_source: text
    accelerator_source_aux: text
    accelerator_binary: text
    accelerator_binary_aux: text
    fixture_manifest: text
    fixture_manifest_sha256: text
    fixture_source_sha256: text
    runner_source_sha256: text

struct X25519MlKem768GpuDispatchResult:
    receipt: X25519MlKem768RunReceipt
    exit_code: i64

struct X25519MlKem768GpuRunnerAdmission:
    binary_sha256: text
    binary_aux_sha256: text
    device_capability: text
    device_name: text

fn _gpu_empty_receipt(request: X25519MlKem768GpuDispatchRequest,
        status: X25519MlKem768EvidenceStatus,
        reason: text) -> X25519MlKem768RunReceipt:
    X25519MlKem768RunReceipt(
        schema: _GPU_EVIDENCE_SCHEMA, status: status, reason: reason,
        scope: request.evidence.scope,
        requested_backend: request.evidence.backend,
        selected_backend: nil, mode: request.evidence.mode,
        emulated: request.evidence.mode ==
            X25519MlKem768EvidenceMode.QemuCorrectness,
        promotion_eligible: false,
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        fixture_id: _GPU_FIXTURE_ID,
        fixture_manifest_sha256: request.fixture_manifest_sha256,
        fixture_source_sha256: request.fixture_source_sha256,
        runner_source_sha256: request.runner_source_sha256,
        batch_size: request.evidence.batch_size,
        client_share_bytes: 0, server_share_bytes: 0,
        shared_secret_bytes: 0, keygen_output_digest: "",
        encapsulate_output_digest: "", decapsulate_output_digest: "",
        scalar_roundtrip_match: false, fallback_used: false,
        absolute_oracle_match: false, simd_chunk_hits: 0,
        observed_rvv_vlen_bits: 0, kernel_invocations: 0,
        compiled: false, submitted: false, fence_completed: false,
        device_readback: false, artifact_sha256: "", device_identity: "")

fn _gpu_result(request: X25519MlKem768GpuDispatchRequest,
        status: X25519MlKem768EvidenceStatus, reason: text,
        exit_code: i64) -> X25519MlKem768GpuDispatchResult:
    X25519MlKem768GpuDispatchResult(
        receipt: _gpu_empty_receipt(request, status, reason),
        exit_code: exit_code)

fn _binding_field(encoded: text, key: text) -> Result<text, text>:
    val prefix = key + "="
    var value = ""
    for line in encoded.trim().split("\n"):
        if line.starts_with(prefix):
            if value != "": return Err("accelerator-binding-duplicate-" + key)
            value = line.substring(prefix.len(), line.len()).trim()
    if value == "": return Err("accelerator-binding-missing-" + key)
    Ok(value)

fn _gpu_admission(request: X25519MlKem768GpuDispatchRequest
) -> Result<X25519MlKem768GpuRunnerAdmission, text>:
    if (request.fixture_manifest_sha256.len() != 64 or
            request.fixture_source_sha256.len() != 64 or
            request.runner_source_sha256.len() != 64):
        return Err("gpu-request-identity-sha256-unavailable")
    if sha256_text(request.fixture_manifest) != request.fixture_manifest_sha256:
        return Err("gpu-fixture-manifest-content-sha256-mismatch")
    if request.compiler_artifact == "": return Err("missing-compiler-artifact")
    if request.compiler_provenance == "": return Err("missing-compiler-provenance")
    if request.runner_artifact == "": return Err("missing-runner-artifact")
    if request.runner_source == "": return Err("missing-runner-source")
    if request.runner_provenance == "": return Err("missing-runner-provenance")
    if request.accelerator_binding == "": return Err("missing-accelerator-binding")
    if request.accelerator_source == "": return Err("missing-accelerator-source")
    if request.accelerator_binary == "": return Err("missing-accelerator-binary")
    if request.compiler_provenance != request.compiler_artifact + ".provenance.env":
        return Err("compiler-provenance-not-adjacent")
    if request.runner_provenance != request.runner_artifact + ".provenance.env":
        return Err("runner-provenance-not-adjacent")
    val vulkan = request.evidence.backend == X25519MlKem768EvidenceBackend.Vulkan
    if vulkan and request.accelerator_source_aux == "":
        return Err("missing-vulkan-inverse-source")
    if vulkan and request.accelerator_binary_aux == "":
        return Err("missing-vulkan-inverse-binary")
    if (not vulkan and
            (request.accelerator_source_aux != "" or
             request.accelerator_binary_aux != "")):
        return Err("unexpected-auxiliary-accelerator-artifact")
    if (not file_is_regular_no_follow(request.compiler_artifact) or
            not file_is_regular_no_follow(request.compiler_provenance) or
            not file_is_regular_no_follow(request.runner_artifact) or
            not file_is_regular_no_follow(request.runner_source) or
            not file_is_regular_no_follow(request.runner_provenance) or
            not file_is_regular_no_follow(request.accelerator_binding) or
            not file_is_regular_no_follow(request.accelerator_source) or
            not file_is_regular_no_follow(request.accelerator_binary)):
        return Err("gpu-admission-input-not-regular-no-follow")
    if (vulkan and
            (not file_is_regular_no_follow(request.accelerator_source_aux) or
             not file_is_regular_no_follow(request.accelerator_binary_aux))):
        return Err("gpu-auxiliary-input-not-regular-no-follow")
    val compiler_sha256 = file_hash_sha256(request.compiler_artifact)
    val provenance_sha256 = file_hash_sha256(request.compiler_provenance)
    val runner_sha256 = file_hash_sha256(request.runner_artifact)
    val runner_source_sha256 = file_hash_sha256(request.runner_source)
    val runner_provenance_sha256 = file_hash_sha256(request.runner_provenance)
    val binding_sha256 = file_hash_sha256(request.accelerator_binding)
    val source_sha256 = file_hash_sha256(request.accelerator_source)
    val binary_sha256 = file_hash_sha256(request.accelerator_binary)
    val source_aux_sha256 = if vulkan:
        file_hash_sha256(request.accelerator_source_aux)
    else:
        ""
    val binary_aux_sha256 = if vulkan:
        file_hash_sha256(request.accelerator_binary_aux)
    else:
        ""
    if (compiler_sha256.len() != 64 or provenance_sha256.len() != 64 or
            runner_sha256.len() != 64 or runner_source_sha256.len() != 64 or
            runner_provenance_sha256.len() != 64 or binding_sha256.len() != 64 or
            source_sha256.len() != 64 or binary_sha256.len() != 64 or
            (vulkan and
             (source_aux_sha256.len() != 64 or binary_aux_sha256.len() != 64))):
        return Err("gpu-admission-sha256-unavailable")
    val provenance_text = file_read(request.compiler_provenance)
    val runner_provenance_text = file_read(request.runner_provenance)
    val binding_text = file_read(request.accelerator_binding)
    if (compiler_sha256 != file_hash_sha256(request.compiler_artifact) or
            provenance_sha256 != file_hash_sha256(request.compiler_provenance) or
            runner_sha256 != file_hash_sha256(request.runner_artifact) or
            runner_source_sha256 != file_hash_sha256(request.runner_source) or
            runner_provenance_sha256 != file_hash_sha256(request.runner_provenance) or
            binding_sha256 != file_hash_sha256(request.accelerator_binding) or
            source_sha256 != file_hash_sha256(request.accelerator_source) or
            binary_sha256 != file_hash_sha256(request.accelerator_binary) or
            (vulkan and
             (source_aux_sha256 != file_hash_sha256(request.accelerator_source_aux) or
              binary_aux_sha256 != file_hash_sha256(request.accelerator_binary_aux)))):
        return Err("gpu-admission-input-changed-during-read")
    val provenance = stage4_compiler_provenance_from_text(provenance_text)
    if stage4_compiler_provenance_reason(
            provenance, compiler_sha256, provenance_sha256) != "ready":
        return Err("gpu-compiler-stage4-provenance-invalid")
    val runner_provenance = x25519_mlkem768_parse_runner_artifact_provenance(
        runner_provenance_text)?
    val runner_reason = x25519_mlkem768_runner_artifact_provenance_reason(
        runner_provenance, request.evidence.backend, request.runner_artifact,
        runner_sha256, request.runner_source, runner_source_sha256,
        compiler_sha256, provenance_sha256)
    if runner_reason != "": return Err(runner_reason)
    val expected_fields: i64 = if vulkan: 12 else: 10
    if binding_text.trim().split("\n").len() != expected_fields:
        return Err("gpu-build-binding-field-count-invalid")
    if _binding_field(binding_text, "schema")? != X25519_MLKEM768_GPU_BINDING_SCHEMA:
        return Err("gpu-build-binding-schema-invalid")
    if _binding_field(binding_text, "backend")? !=
            x25519_mlkem768_evidence_backend_name(request.evidence.backend):
        return Err("gpu-build-binding-backend-mismatch")
    if _binding_field(binding_text, "compiler_artifact_sha256")? != compiler_sha256:
        return Err("gpu-build-binding-compiler-mismatch")
    if _binding_field(binding_text, "compiler_provenance_sha256")? != provenance_sha256:
        return Err("gpu-build-binding-provenance-mismatch")
    if _binding_field(binding_text, "runner_artifact_sha256")? != runner_sha256:
        return Err("gpu-build-binding-runner-mismatch")
    if _binding_field(binding_text, "accelerator_source_sha256")? != source_sha256:
        return Err("gpu-build-binding-source-mismatch")
    if _binding_field(binding_text, "accelerator_binary_sha256")? != binary_sha256:
        return Err("gpu-build-binding-binary-mismatch")
    if vulkan:
        if _binding_field(binding_text, "accelerator_source_aux_sha256")? !=
                source_aux_sha256:
            return Err("gpu-build-binding-source-aux-mismatch")
        if _binding_field(binding_text, "accelerator_binary_aux_sha256")? !=
                binary_aux_sha256:
            return Err("gpu-build-binding-binary-aux-mismatch")
    val build_toolchain = _binding_field(binding_text, "build_toolchain")?
    val device_capability = _binding_field(binding_text, "device_capability")?
    val device_name = _binding_field(binding_text, "device_name")?
    val manifest = request.fixture_manifest
    if not manifest.contains(
            "simple_source_sha256: \"" + request.fixture_source_sha256 + "\""):
        return Err("gpu-fixture-source-not-bound-by-manifest")
    if not manifest.contains(
            "runner_sha256: \"" + request.runner_source_sha256 + "\""):
        return Err("gpu-runner-source-not-bound-by-manifest")
    val tuple_reason = x25519_mlkem768_gpu_canonical_tuple_reason(
        X25519MlKem768GpuCanonicalTuple(
            backend: request.evidence.backend,
            fixture_manifest: manifest,
            accelerator_source: request.accelerator_source,
            accelerator_source_sha256: source_sha256,
            accelerator_binary: request.accelerator_binary,
            accelerator_binary_sha256: binary_sha256,
            accelerator_source_aux: request.accelerator_source_aux,
            accelerator_source_aux_sha256: source_aux_sha256,
            accelerator_binary_aux: request.accelerator_binary_aux,
            accelerator_binary_aux_sha256: binary_aux_sha256,
            build_toolchain: build_toolchain,
            device_capability: device_capability,
            device_name: device_name))
    if tuple_reason != "": return Err(tuple_reason)
    Ok(X25519MlKem768GpuRunnerAdmission(
        binary_sha256: binary_sha256, binary_aux_sha256: binary_aux_sha256,
        device_capability: device_capability, device_name: device_name))

fn _cuda_roundtrip(request: X25519MlKem768GpuDispatchRequest,
        admission: X25519MlKem768GpuRunnerAdmission,
        executor: X25519MlKem768CudaNttExecutor
) -> Result<X25519MlKem768RunReceipt, text>:
    if request.evidence.mode != X25519MlKem768EvidenceMode.Native:
        return Err("cuda-native-execution-required")
    if request.evidence.batch_size < 1:
        return Err("cuda-positive-batch-required")
    var client_share_sha256 = ""
    var server_share_sha256 = ""
    var keygen_digest_chain = ""
    var encapsulate_digest_chain = ""
    var decapsulate_digest_chain = ""
    var kernel_invocations: i64 = 0
    var executor_identity = ""
    var observed_artifact_sha256 = ""
    var compiled = true
    var submitted = true
    var fence_completed = true
    var device_readback = true
    var batch_index: i64 = 0
    while batch_index < request.evidence.batch_size:
        var config = x25519_mlkem768_default_config()
        config.requested_backend = X25519MlKem768Backend.Cuda
        config.selection_mode = X25519MlKem768SelectionMode.Require
        config.verification_policy =
            X25519MlKem768VerificationPolicy.AbsoluteAndScalar
        config.minimum_batch = 1
        config.batch_size = 1
        val outputs = match x25519_mlkem768_run_pinned_cuda_workload(
                config, executor):
            case Ok(value): value
            case Err(reason): return Err("cuda-pinned-workload-" + reason)
        # Ok contains three independently oracle-validated typed set receipts.
        if not outputs.candidate_oracle_match or outputs.fallback_used:
            return Err("cuda-pinned-workload-proof-incomplete")
        if (not outputs.compiled or not outputs.submitted or
                not outputs.fence_completed or not outputs.device_readback or
                outputs.accelerated_operation_count != 3):
            return Err("cuda-pinned-device-lifecycle-incomplete")
        if (outputs.artifact_digest != admission.binary_sha256 or
                outputs.execution_proof_digest != admission.binary_sha256):
            return Err("cuda-pinned-exact-binary-proof-mismatch")
        if executor_identity == "": executor_identity = outputs.executor_identity
        if outputs.executor_identity != executor_identity:
            return Err("cuda-executor-identity-changed")
        if observed_artifact_sha256 == "":
            observed_artifact_sha256 = outputs.artifact_digest
        elif outputs.artifact_digest != observed_artifact_sha256:
            return Err("cuda-executed-artifact-changed")
        if client_share_sha256 == "":
            client_share_sha256 = outputs.client_share_sha256
            server_share_sha256 = outputs.server_share_sha256
        elif (outputs.client_share_sha256 != client_share_sha256 or
                outputs.server_share_sha256 != server_share_sha256):
            return Err("cuda-pinned-public-output-changed")
        kernel_invocations = kernel_invocations + outputs.kernel_invocations
        keygen_digest_chain = keygen_digest_chain + outputs.keygen_output_digest
        encapsulate_digest_chain = encapsulate_digest_chain +
            outputs.encapsulate_output_digest
        decapsulate_digest_chain = decapsulate_digest_chain +
            outputs.decapsulate_output_digest
        compiled = compiled and outputs.compiled
        submitted = submitted and outputs.submitted
        fence_completed = fence_completed and outputs.fence_completed
        device_readback = device_readback and outputs.device_readback
        batch_index = batch_index + 1
    if kernel_invocations < request.evidence.batch_size * 3:
        return Err("cuda-total-kernel-invocation-count-too-small")
    var receipt = _gpu_empty_receipt(
        request, X25519MlKem768EvidenceStatus.Pass,
        "native-cuda-pinned-absolute-correctness-admitted")
    receipt.selected_backend = Some(X25519MlKem768EvidenceBackend.Cuda)
    receipt.client_share_bytes = X25519_MLKEM768_CLIENT_SHARE_BYTES
    receipt.server_share_bytes = X25519_MLKEM768_SERVER_SHARE_BYTES
    receipt.shared_secret_bytes = X25519_MLKEM768_SHARED_SECRET_BYTES
    receipt.keygen_output_digest = sha256_text(keygen_digest_chain)
    receipt.encapsulate_output_digest = sha256_text(encapsulate_digest_chain)
    receipt.decapsulate_output_digest = sha256_text(decapsulate_digest_chain)
    receipt.scalar_roundtrip_match = true
    receipt.absolute_oracle_match = true
    receipt.promotion_eligible = false
    receipt.kernel_invocations = kernel_invocations
    receipt.compiled = compiled
    receipt.submitted = submitted
    receipt.fence_completed = fence_completed
    receipt.device_readback = device_readback
    receipt.artifact_sha256 = observed_artifact_sha256
    receipt.device_identity = executor_identity
    Ok(receipt)

fn _cuda_runtime_capability_reason(
        admission: X25519MlKem768GpuRunnerAdmission) -> text:
    val (major, minor) = gpu_device_compute_capability(0)
    if major < 1 or minor < 0:
        return "cuda-runtime-device-capability-unavailable"
    val observed_capability = major.to_text() + "." + minor.to_text()
    if observed_capability != admission.device_capability:
        return "cuda-runtime-device-capability-mismatch"
    val observed_name = gpu_device_name(0)
    if observed_name == "": return "cuda-runtime-device-name-unavailable"
    if observed_name != admission.device_name:
        return "cuda-runtime-device-name-mismatch"
    ""

fn _vulkan_artifact_set_digest(
        admission: X25519MlKem768GpuRunnerAdmission) -> text:
    sha256_text("forward=" + admission.binary_sha256 +
        ";inverse=" + admission.binary_aux_sha256)

fn _vulkan_runtime_identity_reason(
        admission: X25519MlKem768GpuRunnerAdmission,
        executor: X25519MlKem768VulkanNttExecutor) -> text:
    if executor.session.device_name == "":
        return "vulkan-runtime-device-name-unavailable"
    if executor.session.device_name != admission.device_name:
        return "vulkan-runtime-device-name-mismatch"
    if executor.session.device_identity <= 0:
        return "vulkan-runtime-device-identity-tag-unavailable"
    val identity = executor.session.driver_identity
    if identity == "": return "vulkan-runtime-driver-identity-unavailable"
    if (not identity.starts_with(admission.device_name + "|") or
            not identity.contains("|vendor=") or
            not identity.contains("|device=") or
            not identity.contains("|driver=") or
            not identity.contains("|api=")):
        return "vulkan-runtime-driver-identity-invalid"
    val api_parts = identity.split("|api=")
    val api_admitted = api_parts.len() == 2 and (
        api_parts[1] == "00401000" or api_parts[1] == "00402000" or
        api_parts[1] == "00403000" or api_parts[1] == "00404000")
    if not api_admitted: return "vulkan-runtime-api-version-not-admitted"
    ""

fn _vulkan_roundtrip(request: X25519MlKem768GpuDispatchRequest,
        admission: X25519MlKem768GpuRunnerAdmission,
        executor: X25519MlKem768VulkanNttExecutor
) -> Result<X25519MlKem768RunReceipt, text>:
    if request.evidence.mode != X25519MlKem768EvidenceMode.Native:
        return Err("vulkan-native-execution-required")
    if request.evidence.batch_size < 1:
        return Err("vulkan-positive-batch-required")
    val artifact_set_digest = _vulkan_artifact_set_digest(admission)
    val session_identity_tag = executor.session.device_identity
    val session_device_name = executor.session.device_name
    val session_driver_identity = executor.session.driver_identity
    var client_share_sha256 = ""
    var server_share_sha256 = ""
    var keygen_digest_chain = ""
    var encapsulate_digest_chain = ""
    var decapsulate_digest_chain = ""
    var kernel_invocations: i64 = 0
    var executor_identity = ""
    var compiled = true
    var submitted = true
    var fence_completed = true
    var device_readback = true
    var batch_index: i64 = 0
    while batch_index < request.evidence.batch_size:
        var config = x25519_mlkem768_default_config()
        config.requested_backend = X25519MlKem768Backend.Vulkan
        config.selection_mode = X25519MlKem768SelectionMode.Require
        config.verification_policy =
            X25519MlKem768VerificationPolicy.AbsoluteAndScalar
        config.minimum_batch = 1
        config.batch_size = 1
        val outputs = match x25519_mlkem768_run_pinned_vulkan_workload(
                config, executor):
            case Ok(value): value
            case Err(reason): return Err("vulkan-pinned-workload-" + reason)
        if (executor.session.device_identity != session_identity_tag or
                executor.session.device_name != session_device_name or
                executor.session.driver_identity != session_driver_identity):
            return Err("vulkan-runtime-device-identity-changed")
        if not outputs.candidate_oracle_match or outputs.fallback_used:
            return Err("vulkan-pinned-workload-proof-incomplete")
        if (not outputs.compiled or not outputs.submitted or
                not outputs.fence_completed or not outputs.device_readback or
                outputs.accelerated_operation_count != 3 or
                outputs.kernel_invocations < 3):
            return Err("vulkan-pinned-device-lifecycle-incomplete")
        if (outputs.artifact_digest != artifact_set_digest or
                outputs.execution_proof_digest != artifact_set_digest):
            return Err("vulkan-pinned-exact-spirv-set-proof-mismatch")
        val identity_prefix = "vulkan-device:" +
            session_identity_tag.to_text() + ":spirv-set:" +
            artifact_set_digest + ":cache:"
        if (not outputs.executor_identity.starts_with(identity_prefix) or
                outputs.executor_identity.len() != identity_prefix.len() + 64):
            return Err("vulkan-full-executor-identity-invalid")
        if executor_identity == "": executor_identity = outputs.executor_identity
        if outputs.executor_identity != executor_identity:
            return Err("vulkan-executor-identity-changed")
        if client_share_sha256 == "":
            client_share_sha256 = outputs.client_share_sha256
            server_share_sha256 = outputs.server_share_sha256
        elif (outputs.client_share_sha256 != client_share_sha256 or
                outputs.server_share_sha256 != server_share_sha256):
            return Err("vulkan-pinned-public-output-changed")
        kernel_invocations = kernel_invocations + outputs.kernel_invocations
        keygen_digest_chain = keygen_digest_chain + outputs.keygen_output_digest
        encapsulate_digest_chain = encapsulate_digest_chain +
            outputs.encapsulate_output_digest
        decapsulate_digest_chain = decapsulate_digest_chain +
            outputs.decapsulate_output_digest
        compiled = compiled and outputs.compiled
        submitted = submitted and outputs.submitted
        fence_completed = fence_completed and outputs.fence_completed
        device_readback = device_readback and outputs.device_readback
        batch_index = batch_index + 1
    if kernel_invocations < request.evidence.batch_size * 3:
        return Err("vulkan-total-kernel-invocation-count-too-small")
    var receipt = _gpu_empty_receipt(
        request, X25519MlKem768EvidenceStatus.Pass,
        "native-vulkan-pinned-absolute-correctness-admitted")
    receipt.selected_backend = Some(X25519MlKem768EvidenceBackend.Vulkan)
    receipt.client_share_bytes = X25519_MLKEM768_CLIENT_SHARE_BYTES
    receipt.server_share_bytes = X25519_MLKEM768_SERVER_SHARE_BYTES
    receipt.shared_secret_bytes = X25519_MLKEM768_SHARED_SECRET_BYTES
    receipt.keygen_output_digest = sha256_text(keygen_digest_chain)
    receipt.encapsulate_output_digest = sha256_text(encapsulate_digest_chain)
    receipt.decapsulate_output_digest = sha256_text(decapsulate_digest_chain)
    receipt.scalar_roundtrip_match = true
    receipt.absolute_oracle_match = true
    receipt.promotion_eligible = false
    receipt.kernel_invocations = kernel_invocations
    receipt.compiled = compiled
    receipt.submitted = submitted
    receipt.fence_completed = fence_completed
    receipt.device_readback = device_readback
    receipt.artifact_sha256 = artifact_set_digest
    receipt.device_identity = executor_identity
    Ok(receipt)

fn x25519_mlkem768_dispatch_gpu(
        request: X25519MlKem768GpuDispatchRequest
) -> X25519MlKem768GpuDispatchResult:
    # These backends cannot currently establish a live, exact-device row.
    # Block before filesystem admission so callers cannot mistake malformed
    # local artifacts for the canonical platform-unavailable result.
    if (request.evidence.backend != X25519MlKem768EvidenceBackend.Cuda and
            request.evidence.backend != X25519MlKem768EvidenceBackend.Vulkan and
            request.evidence.backend != X25519MlKem768EvidenceBackend.Metal):
        return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
            "gpu-dispatch-backend-invalid", 1)
    if request.evidence.backend == X25519MlKem768EvidenceBackend.Metal:
        return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
            "metal-binary-digest-not-pinned-by-fixture-manifest", 1)
    if (request.evidence.batch_size < 1 or
            request.evidence.batch_size > X25519_MLKEM768_EVIDENCE_MAX_BATCH):
        return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
            "gpu-batch-size-must-be-in-1..1024", 1)
    val admission = match _gpu_admission(request):
        case Ok(value): value
        case Err(reason):
            return _gpu_result(
                request, X25519MlKem768EvidenceStatus.Blocked, reason, 1)
    if request.evidence.backend == X25519MlKem768EvidenceBackend.Vulkan:
        var executor = X25519MlKem768VulkanNttExecutor.create_binaries(
            request.accelerator_binary, admission.binary_sha256,
            request.accelerator_binary_aux, admission.binary_aux_sha256)
        if (executor.forward_artifact_digest != admission.binary_sha256 or
                executor.inverse_artifact_digest != admission.binary_aux_sha256):
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                "vulkan-exact-binary-snapshot-rejected", 1)
        val warmup_reason = executor.warmup()
        if warmup_reason != "":
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                "vulkan-executor-construction-" + warmup_reason, 1)
        val identity_reason = _vulkan_runtime_identity_reason(
            admission, executor)
        if identity_reason != "":
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                identity_reason, 1)
        val vulkan_result = _vulkan_roundtrip(request, admission, executor)
        executor.shutdown()
        return match vulkan_result:
            case Ok(receipt): X25519MlKem768GpuDispatchResult(
                receipt: receipt, exit_code: 0)
            case Err(reason): _gpu_result(
                request, X25519MlKem768EvidenceStatus.Fail, reason, 1)
    if request.evidence.backend == X25519MlKem768EvidenceBackend.Cuda:
        var executor = X25519MlKem768CudaNttExecutor.create_binary(
            request.accelerator_binary, admission.binary_sha256)
        if executor.artifact_digest != admission.binary_sha256:
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                "cuda-exact-binary-snapshot-rejected", 1)
        val warmup_reason = executor.warmup()
        if warmup_reason != "":
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                "cuda-executor-construction-" + warmup_reason, 1)
        val capability_reason = _cuda_runtime_capability_reason(admission)
        if capability_reason != "":
            executor.shutdown()
            return _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
                capability_reason, 1)
        val cuda_result = _cuda_roundtrip(request, admission, executor)
        executor.shutdown()
        return match cuda_result:
            case Ok(receipt): X25519MlKem768GpuDispatchResult(
                receipt: receipt, exit_code: 0)
            case Err(reason): _gpu_result(
                request, X25519MlKem768EvidenceStatus.Fail, reason, 1)
    _gpu_result(request, X25519MlKem768EvidenceStatus.Blocked,
        "gpu-dispatch-backend-invalid", 1)

export X25519MlKem768GpuDispatchRequest, X25519MlKem768GpuDispatchResult
export x25519_mlkem768_dispatch_gpu
