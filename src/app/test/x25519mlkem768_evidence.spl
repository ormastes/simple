# Pure-Simple full-operation evidence runner for X25519MLKEM768.
#
# Scalar and admitted SIMD candidates execute the same deterministic full
# hybrid round trip. GPU requests cross the typed exact-binary companion; CUDA
# may emit development correctness only after live lifecycle proof, while
# unprovable Vulkan/Metal states remain blocked. The runner never falls back or
# serializes private inputs, shared secrets, or secret-derived digests.

use std.cli.cli_util.{get_cli_args}
use app.io.mod.{file_hash_sha256, file_is_regular_no_follow, file_read}
use std.common.crypto.sha256.{sha256_text}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768VerificationPolicy, X25519MlKem768Config,
    X25519MlKem768Evidence, X25519MlKem768SimdAdmission,
    X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES,
    x25519_mlkem768_default_config}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceStatus, X25519MlKem768EvidenceCli,
    X25519MlKem768RunReceipt,
    x25519_mlkem768_parse_evidence_cli,
    x25519_mlkem768_evidence_backend_name,
    x25519_mlkem768_render_evidence_receipt,
    x25519_mlkem768_constant_time_list_equal,
    x25519_mlkem768_evidence_fixture_list32,
    x25519_mlkem768_evidence_fixture_bytes32}
use os.crypto.x25519_mlkem768.hybrid.{
    x25519_mlkem768_keygen, x25519_mlkem768_encapsulate,
    x25519_mlkem768_decapsulate,
    x25519_mlkem768_keygen_simd_candidate,
    x25519_mlkem768_encapsulate_simd_candidate,
    x25519_mlkem768_decapsulate_simd_candidate}
use app.test.x25519mlkem768_gpu_dispatch.{
    X25519MlKem768GpuDispatchRequest,
    x25519_mlkem768_dispatch_gpu}

val X25519_MLKEM768_EVIDENCE_SCHEMA = "x25519mlkem768-evidence-v1"
val X25519_MLKEM768_EVIDENCE_FIXTURE_ID = "x25519mlkem768-v1"
val X25519_MLKEM768_EVIDENCE_FIXTURE_SOURCE_SHA256 =
    "fd298615d64d43d751287e9e32e1483fd2f4504dc343e979985691f5e25a2585"
val X25519_MLKEM768_ACCELERATOR_BINDING_SCHEMA =
    "x25519mlkem768-runner-accelerator-binding-v1"

struct X25519MlKem768EvidenceRunnerCli:
    evidence: X25519MlKem768EvidenceCli
    compiler_artifact: text
    compiler_provenance: text
    runner_artifact: text
    runner_provenance: text
    accelerator_binding: text
    accelerator_source: text
    accelerator_source_aux: text
    accelerator_binary: text
    accelerator_binary_aux: text

struct X25519MlKem768SpecializedRunnerAdmission:
    simd: X25519MlKem768SimdAdmission
    runner_artifact_sha256: text

fn _parse_runner_cli(args: [text]) -> Result<X25519MlKem768EvidenceRunnerCli, text>:
    var evidence_args: [text] = []
    var compiler_artifact = ""
    var compiler_provenance = ""
    var runner_artifact = ""
    var runner_provenance = ""
    var accelerator_binding = ""
    var accelerator_source = ""
    var accelerator_source_aux = ""
    var accelerator_binary = ""
    var accelerator_binary_aux = ""
    var index: i64 = 0
    while index < args.len():
        val option = args[index]
        if index + 1 >= args.len():
            return Err("missing-value-for-" + option)
        val value = args[index + 1]
        if option == "--compiler-artifact":
            if compiler_artifact != "": return Err("duplicate-compiler-artifact")
            compiler_artifact = value
        elif option == "--compiler-provenance":
            if compiler_provenance != "": return Err("duplicate-compiler-provenance")
            compiler_provenance = value
        elif option == "--runner-artifact":
            if runner_artifact != "": return Err("duplicate-runner-artifact")
            runner_artifact = value
        elif option == "--runner-provenance":
            if runner_provenance != "": return Err("duplicate-runner-provenance")
            runner_provenance = value
        elif option == "--accelerator-binding":
            if accelerator_binding != "": return Err("duplicate-accelerator-binding")
            accelerator_binding = value
        elif option == "--accelerator-source":
            if accelerator_source != "": return Err("duplicate-accelerator-source")
            accelerator_source = value
        elif option == "--accelerator-source-aux":
            if accelerator_source_aux != "": return Err("duplicate-accelerator-source-aux")
            accelerator_source_aux = value
        elif option == "--accelerator-binary":
            if accelerator_binary != "": return Err("duplicate-accelerator-binary")
            accelerator_binary = value
        elif option == "--accelerator-binary-aux":
            if accelerator_binary_aux != "": return Err("duplicate-accelerator-binary-aux")
            accelerator_binary_aux = value
        else:
            evidence_args.push(option)
            evidence_args.push(value)
        index = index + 2
    val evidence = x25519_mlkem768_parse_evidence_cli(evidence_args)?
    if (evidence.backend == X25519MlKem768EvidenceBackend.ScalarCpu and
            (compiler_artifact != "" or compiler_provenance != "" or
             runner_artifact != "" or accelerator_binding != "" or
             runner_provenance != "" or
             accelerator_source != "" or accelerator_source_aux != "" or
             accelerator_binary != "" or accelerator_binary_aux != "")):
        return Err("scalar-specialized-admission-forbidden")
    Ok(X25519MlKem768EvidenceRunnerCli(
        evidence: evidence,
        compiler_artifact: compiler_artifact,
        compiler_provenance: compiler_provenance,
        runner_artifact: runner_artifact,
        runner_provenance: runner_provenance,
        accelerator_binding: accelerator_binding,
        accelerator_source: accelerator_source,
        accelerator_source_aux: accelerator_source_aux,
        accelerator_binary: accelerator_binary,
        accelerator_binary_aux: accelerator_binary_aux))

fn _binding_field(encoded: text, key: text) -> Result<text, text>:
    val prefix = key + "="
    var value = ""
    for line in encoded.trim().split("\n"):
        if line.starts_with(prefix):
            if value != "": return Err("accelerator-binding-duplicate-" + key)
            value = line.substring(prefix.len(), line.len()).trim()
    if value == "": return Err("accelerator-binding-missing-" + key)
    Ok(value)

fn _simd_backend(backend: X25519MlKem768EvidenceBackend
) -> Result<X25519MlKem768Backend, text>:
    if backend == X25519MlKem768EvidenceBackend.Avx2:
        return Ok(X25519MlKem768Backend.Avx2)
    if backend == X25519MlKem768EvidenceBackend.Neon:
        return Ok(X25519MlKem768Backend.Neon)
    if backend == X25519MlKem768EvidenceBackend.Rvv:
        return Ok(X25519MlKem768Backend.Rvv)
    Err("backend-is-not-simd")

fn _specialized_admission(
        cli: X25519MlKem768EvidenceRunnerCli
) -> Result<X25519MlKem768SpecializedRunnerAdmission, text>:
    if cli.compiler_artifact == "": return Err("missing-compiler-artifact")
    if cli.compiler_provenance == "": return Err("missing-compiler-provenance")
    if cli.runner_artifact == "": return Err("missing-runner-artifact")
    if cli.accelerator_binding == "": return Err("missing-accelerator-binding")
    if cli.compiler_provenance != cli.compiler_artifact + ".provenance.env":
        return Err("compiler-provenance-not-adjacent")
    if (not file_is_regular_no_follow(cli.compiler_artifact) or
            not file_is_regular_no_follow(cli.compiler_provenance) or
            not file_is_regular_no_follow(cli.runner_artifact) or
            not file_is_regular_no_follow(cli.accelerator_binding)):
        return Err("specialized-admission-input-not-regular-no-follow")
    val compiler_sha256 = file_hash_sha256(cli.compiler_artifact)
    val provenance_sha256 = file_hash_sha256(cli.compiler_provenance)
    val runner_artifact_sha256 = file_hash_sha256(cli.runner_artifact)
    val binding_sha256 = file_hash_sha256(cli.accelerator_binding)
    if (compiler_sha256.len() != 64 or provenance_sha256.len() != 64 or
            runner_artifact_sha256.len() != 64 or binding_sha256.len() != 64):
        return Err("specialized-admission-sha256-unavailable")
    val provenance = file_read(cli.compiler_provenance)
    val binding = file_read(cli.accelerator_binding)
    if (compiler_sha256 != file_hash_sha256(cli.compiler_artifact) or
            provenance_sha256 != file_hash_sha256(cli.compiler_provenance) or
            runner_artifact_sha256 != file_hash_sha256(cli.runner_artifact) or
            binding_sha256 != file_hash_sha256(cli.accelerator_binding)):
        return Err("specialized-admission-input-changed-during-read")
    if binding.trim().split("\n").len() != 5:
        return Err("accelerator-binding-field-count-invalid")
    if _binding_field(binding, "schema")? !=
            X25519_MLKEM768_ACCELERATOR_BINDING_SCHEMA:
        return Err("accelerator-binding-schema-invalid")
    if _binding_field(binding, "backend")? !=
            x25519_mlkem768_evidence_backend_name(cli.evidence.backend):
        return Err("accelerator-binding-backend-mismatch")
    if _binding_field(binding, "compiler_artifact_sha256")? != compiler_sha256:
        return Err("accelerator-binding-compiler-mismatch")
    if _binding_field(binding, "compiler_provenance_sha256")? != provenance_sha256:
        return Err("accelerator-binding-provenance-mismatch")
    if _binding_field(binding, "runner_artifact_sha256")? != runner_artifact_sha256:
        return Err("accelerator-binding-runner-mismatch")
    Ok(X25519MlKem768SpecializedRunnerAdmission(
        simd: X25519MlKem768SimdAdmission(
            encoded_provenance: provenance,
            actual_binary_sha256: compiler_sha256,
            actual_provenance_sha256: provenance_sha256),
        runner_artifact_sha256: runner_artifact_sha256))

fn _empty_receipt(cli: X25519MlKem768EvidenceCli,
        status: X25519MlKem768EvidenceStatus, reason: text,
        manifest_sha256: text, fixture_sha256: text,
        runner_sha256: text) -> X25519MlKem768RunReceipt:
    X25519MlKem768RunReceipt(
        schema: X25519_MLKEM768_EVIDENCE_SCHEMA,
        status: status,
        reason: reason,
        scope: cli.scope,
        requested_backend: cli.backend,
        selected_backend: nil,
        mode: cli.mode,
        emulated: cli.mode == X25519MlKem768EvidenceMode.QemuCorrectness,
        promotion_eligible: false,
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        fixture_id: X25519_MLKEM768_EVIDENCE_FIXTURE_ID,
        fixture_manifest_sha256: manifest_sha256,
        fixture_source_sha256: fixture_sha256,
        runner_source_sha256: runner_sha256,
        batch_size: cli.batch_size,
        client_share_bytes: 0,
        server_share_bytes: 0,
        shared_secret_bytes: 0,
        keygen_output_digest: "",
        encapsulate_output_digest: "",
        decapsulate_output_digest: "",
        scalar_roundtrip_match: false,
        fallback_used: false,
        absolute_oracle_match: false,
        simd_chunk_hits: 0,
        observed_rvv_vlen_bits: 0,
        kernel_invocations: 0,
        compiled: false,
        submitted: false,
        fence_completed: false,
        device_readback: false,
        artifact_sha256: "",
        device_identity: "")

fn _input_hashes(cli: X25519MlKem768EvidenceCli
) -> Result<(text, text, text, text), text>:
    if not file_is_regular_no_follow(cli.fixture_manifest):
        return Err("missing-fixture-manifest")
    if not file_is_regular_no_follow(cli.fixture_source):
        return Err("missing-fixture-source")
    if not file_is_regular_no_follow(cli.runner_source):
        return Err("missing-runner-source")
    val manifest_sha256 = file_hash_sha256(cli.fixture_manifest)
    val fixture_sha256 = file_hash_sha256(cli.fixture_source)
    val runner_sha256 = file_hash_sha256(cli.runner_source)
    if manifest_sha256.len() != 64 or fixture_sha256.len() != 64 or
            runner_sha256.len() != 64:
        return Err("input-sha256-unavailable")
    if fixture_sha256 != X25519_MLKEM768_EVIDENCE_FIXTURE_SOURCE_SHA256:
        return Err("fixture-source-sha256-mismatch")
    val manifest = file_read(cli.fixture_manifest)
    if (not file_is_regular_no_follow(cli.fixture_manifest) or
            not file_is_regular_no_follow(cli.fixture_source) or
            not file_is_regular_no_follow(cli.runner_source) or
            manifest_sha256 != file_hash_sha256(cli.fixture_manifest) or
            fixture_sha256 != file_hash_sha256(cli.fixture_source) or
            runner_sha256 != file_hash_sha256(cli.runner_source)):
        return Err("runner-input-changed-during-read")
    if not manifest.contains(
            "implementation_version: \"" +
            X25519_MLKEM768_IMPLEMENTATION_VERSION + "\""):
        return Err("manifest-implementation-version-mismatch")
    if not manifest.contains(
            "profile_version: \"" + X25519_MLKEM768_PROFILE_VERSION + "\""):
        return Err("manifest-profile-version-mismatch")
    if not manifest.contains(
            "simple_source_sha256: \"" + fixture_sha256 + "\""):
        return Err("manifest-fixture-source-binding-missing")
    if not manifest.contains("runner_sha256: \"" + runner_sha256 + "\""):
        return Err("manifest-runner-source-binding-missing")
    Ok((manifest_sha256, fixture_sha256, runner_sha256, manifest))

fn _scalar_observation_hex64(value: text) -> bool:
    if value.len() != 64:
        return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not ((code >= 48 and code <= 57) or
                (code >= 97 and code <= 102)):
            return false
        index = index + 1
    true

fn _scalar_evidence_reason(evidence: X25519MlKem768Evidence,
        expected_operation: text, config: X25519MlKem768Config,
        configuration_digest: text) -> text:
    if (evidence.requested_backend != X25519MlKem768Backend.ScalarCpu or
            evidence.selected_backend != X25519MlKem768Backend.ScalarCpu):
        return "scalar-observed-backend-mismatch"
    if evidence.operation != expected_operation:
        return "scalar-observed-operation-mismatch-" + expected_operation
    if evidence.executor_identity != "pure-simple-scalar":
        return "scalar-observed-executor-identity-mismatch"
    if evidence.fallback_used or evidence.fallback_reason != "":
        return "scalar-observed-fallback-forbidden"
    if (evidence.implementation_version != config.implementation_version or
            evidence.profile_version != config.profile_version or
            evidence.batch_size != config.batch_size):
        return "scalar-observed-configuration-mismatch"
    if (evidence.configuration_digest != configuration_digest or
            not _scalar_observation_hex64(evidence.configuration_digest)):
        return "scalar-observed-configuration-digest-mismatch"
    if (not _scalar_observation_hex64(evidence.input_fixture_digest) or
            not _scalar_observation_hex64(evidence.output_digest) or
            evidence.execution_proof_digest != evidence.output_digest):
        return "scalar-observed-operation-proof-mismatch-" + expected_operation
    if (evidence.source_digest != "" or evidence.artifact_digest != "" or
            evidence.kernel_invocations != 0 or evidence.simd_chunk_hits != 0 or
            evidence.observed_rvv_vlen_bits != 0 or evidence.compiled or
            evidence.submitted or evidence.fence_completed or
            evidence.device_readback):
        return "scalar-observed-accelerator-lifecycle-forbidden"
    ""

fn x25519_mlkem768_scalar_observation_reason(
        config: X25519MlKem768Config,
        keygen: X25519MlKem768Evidence,
        encapsulate: X25519MlKem768Evidence,
        decapsulate: X25519MlKem768Evidence) -> text:
    if (config.requested_backend != X25519MlKem768Backend.ScalarCpu or
            config.selection_mode != X25519MlKem768SelectionMode.Require):
        return "scalar-observation-requires-scalar-cpu"
    if (config.implementation_version != X25519_MLKEM768_IMPLEMENTATION_VERSION or
            config.profile_version != X25519_MLKEM768_PROFILE_VERSION or
            config.verification_policy !=
                X25519MlKem768VerificationPolicy.AbsoluteAndScalar or
            config.minimum_batch < 1 or config.batch_size < config.minimum_batch):
        return "scalar-observation-configuration-invalid"
    val configuration_digest = keygen.configuration_digest
    val keygen_reason = _scalar_evidence_reason(
        keygen, "keygen", config, configuration_digest)
    if keygen_reason != "":
        return keygen_reason
    val encapsulate_reason = _scalar_evidence_reason(
        encapsulate, "encapsulate", config, configuration_digest)
    if encapsulate_reason != "":
        return encapsulate_reason
    _scalar_evidence_reason(
        decapsulate, "decapsulate", config, configuration_digest)

fn _scalar_roundtrip(cli: X25519MlKem768EvidenceCli,
        manifest_sha256: text, fixture_sha256: text,
        runner_sha256: text) -> Result<X25519MlKem768RunReceipt, text>:
    if cli.mode != X25519MlKem768EvidenceMode.Native:
        return Err("scalar-qemu-execution-requires-wrapper-observation")
    var keygen_digest_chain = ""
    var encapsulate_digest_chain = ""
    var decapsulate_digest_chain = ""
    var batch_index: i64 = 0
    while batch_index < cli.batch_size:
        val offset = batch_index * 163
        var config = x25519_mlkem768_default_config()
        config.requested_backend = X25519MlKem768Backend.ScalarCpu
        config.selection_mode = X25519MlKem768SelectionMode.Require
        config.minimum_batch = 1
        config.batch_size = cli.batch_size
        val key_pair = match x25519_mlkem768_keygen(
                config,
                x25519_mlkem768_evidence_fixture_bytes32(1 + offset),
                x25519_mlkem768_evidence_fixture_list32(33 + offset),
                x25519_mlkem768_evidence_fixture_list32(65 + offset)):
            case Ok(value): value
            case Err(reason): return Err("scalar-keygen-" + reason)
        val encapsulation = match x25519_mlkem768_encapsulate(
                config, key_pair.client_key_share,
                x25519_mlkem768_evidence_fixture_bytes32(97 + offset),
                x25519_mlkem768_evidence_fixture_list32(129 + offset)):
            case Ok(value): value
            case Err(reason): return Err("scalar-encapsulate-" + reason)
        val decapsulation = match x25519_mlkem768_decapsulate(
                config, encapsulation.server_key_share,
                key_pair.x25519_private_key, key_pair.decapsulation_key):
            case Ok(value): value
            case Err(reason): return Err("scalar-decapsulate-" + reason)
        val observation_reason = x25519_mlkem768_scalar_observation_reason(
            config, key_pair.evidence, encapsulation.evidence,
            decapsulation.evidence)
        if observation_reason != "":
            return Err(observation_reason)
        if key_pair.client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
            return Err("scalar-client-share-size-mismatch")
        if encapsulation.server_key_share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES:
            return Err("scalar-server-share-size-mismatch")
        if encapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES or
                decapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES:
            return Err("scalar-shared-secret-size-mismatch")
        if not x25519_mlkem768_constant_time_list_equal(
                encapsulation.shared_secret, decapsulation.shared_secret):
            return Err("scalar-roundtrip-secret-mismatch")
        if key_pair.evidence.fallback_used or encapsulation.evidence.fallback_used or
                decapsulation.evidence.fallback_used:
            return Err("scalar-fallback-observed")
        keygen_digest_chain = keygen_digest_chain + key_pair.evidence.output_digest
        encapsulate_digest_chain = encapsulate_digest_chain + encapsulation.evidence.output_digest
        decapsulate_digest_chain = decapsulate_digest_chain + decapsulation.evidence.output_digest
        batch_index = batch_index + 1
    var receipt = _empty_receipt(
        cli, X25519MlKem768EvidenceStatus.Pass, "scalar-roundtrip-only",
        manifest_sha256, fixture_sha256, runner_sha256)
    receipt.selected_backend = Some(X25519MlKem768EvidenceBackend.ScalarCpu)
    receipt.client_share_bytes = X25519_MLKEM768_CLIENT_SHARE_BYTES
    receipt.server_share_bytes = X25519_MLKEM768_SERVER_SHARE_BYTES
    receipt.shared_secret_bytes = X25519_MLKEM768_SHARED_SECRET_BYTES
    receipt.keygen_output_digest = sha256_text(keygen_digest_chain)
    receipt.encapsulate_output_digest = sha256_text(encapsulate_digest_chain)
    receipt.decapsulate_output_digest = sha256_text(decapsulate_digest_chain)
    receipt.scalar_roundtrip_match = true
    # This deterministic local fixture is not the pinned three-oracle vector.
    receipt.absolute_oracle_match = false
    receipt.promotion_eligible = false
    Ok(receipt)

fn _simd_roundtrip(cli: X25519MlKem768EvidenceRunnerCli,
        admission: X25519MlKem768SpecializedRunnerAdmission,
        manifest_sha256: text, fixture_sha256: text,
        runner_sha256: text) -> Result<X25519MlKem768RunReceipt, text>:
    if cli.evidence.mode != X25519MlKem768EvidenceMode.Native:
        return Err("simd-qemu-execution-requires-wrapper-observation")
    val backend = _simd_backend(cli.evidence.backend)?
    var keygen_digest_chain = ""
    var encapsulate_digest_chain = ""
    var decapsulate_digest_chain = ""
    var simd_chunk_hits: i64 = 0
    var observed_rvv_vlen_bits: i64 = 0
    var batch_index: i64 = 0
    while batch_index < cli.evidence.batch_size:
        val offset = batch_index * 163
        var config = x25519_mlkem768_default_config()
        config.requested_backend = backend
        config.selection_mode = X25519MlKem768SelectionMode.Require
        config.minimum_batch = 1
        config.batch_size = cli.evidence.batch_size
        val key_pair = match x25519_mlkem768_keygen_simd_candidate(
                config, admission.simd,
                x25519_mlkem768_evidence_fixture_bytes32(1 + offset),
                x25519_mlkem768_evidence_fixture_list32(33 + offset),
                x25519_mlkem768_evidence_fixture_list32(65 + offset)):
            case Ok(value): value
            case Err(reason): return Err("simd-keygen-" + reason)
        val encapsulation = match x25519_mlkem768_encapsulate_simd_candidate(
                config, admission.simd, key_pair.client_key_share,
                x25519_mlkem768_evidence_fixture_bytes32(97 + offset),
                x25519_mlkem768_evidence_fixture_list32(129 + offset)):
            case Ok(value): value
            case Err(reason): return Err("simd-encapsulate-" + reason)
        val decapsulation = match x25519_mlkem768_decapsulate_simd_candidate(
                config, admission.simd, encapsulation.server_key_share,
                key_pair.x25519_private_key, key_pair.decapsulation_key):
            case Ok(value): value
            case Err(reason): return Err("simd-decapsulate-" + reason)
        if key_pair.client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
            return Err("simd-client-share-size-mismatch")
        if encapsulation.server_key_share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES:
            return Err("simd-server-share-size-mismatch")
        if (encapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES or
                decapsulation.shared_secret.len() != X25519_MLKEM768_SHARED_SECRET_BYTES):
            return Err("simd-shared-secret-size-mismatch")
        if not x25519_mlkem768_constant_time_list_equal(
                encapsulation.shared_secret, decapsulation.shared_secret):
            return Err("simd-roundtrip-secret-mismatch")
        if (key_pair.evidence.fallback_used or
                encapsulation.evidence.fallback_used or
                decapsulation.evidence.fallback_used):
            return Err("simd-fallback-observed")
        if (not key_pair.evidence.oracle_match or
                not encapsulation.evidence.oracle_match or
                not decapsulation.evidence.oracle_match):
            return Err("simd-scalar-verification-missing")
        simd_chunk_hits = simd_chunk_hits + key_pair.evidence.simd_chunk_hits +
            encapsulation.evidence.simd_chunk_hits +
            decapsulation.evidence.simd_chunk_hits
        val batch_rvv_vlen = key_pair.evidence.observed_rvv_vlen_bits
        if (encapsulation.evidence.observed_rvv_vlen_bits != batch_rvv_vlen or
                decapsulation.evidence.observed_rvv_vlen_bits != batch_rvv_vlen):
            return Err("simd-rvv-vlen-inconsistent")
        if batch_index > 0 and observed_rvv_vlen_bits != batch_rvv_vlen:
            return Err("simd-rvv-vlen-changed")
        observed_rvv_vlen_bits = batch_rvv_vlen
        keygen_digest_chain = keygen_digest_chain + key_pair.evidence.output_digest
        encapsulate_digest_chain = encapsulate_digest_chain +
            encapsulation.evidence.output_digest
        decapsulate_digest_chain = decapsulate_digest_chain +
            decapsulation.evidence.output_digest
        batch_index = batch_index + 1
    if simd_chunk_hits < cli.evidence.batch_size * 3:
        return Err("simd-observed-hit-count-too-small")
    var receipt = _empty_receipt(
        cli.evidence, X25519MlKem768EvidenceStatus.Pass,
        "native-simd-correctness-admitted",
        manifest_sha256, fixture_sha256, runner_sha256)
    receipt.selected_backend = Some(cli.evidence.backend)
    receipt.client_share_bytes = X25519_MLKEM768_CLIENT_SHARE_BYTES
    receipt.server_share_bytes = X25519_MLKEM768_SERVER_SHARE_BYTES
    receipt.shared_secret_bytes = X25519_MLKEM768_SHARED_SECRET_BYTES
    receipt.keygen_output_digest = sha256_text(keygen_digest_chain)
    receipt.encapsulate_output_digest = sha256_text(encapsulate_digest_chain)
    receipt.decapsulate_output_digest = sha256_text(decapsulate_digest_chain)
    receipt.scalar_roundtrip_match = true
    receipt.absolute_oracle_match = false
    receipt.promotion_eligible = false
    receipt.simd_chunk_hits = simd_chunk_hits
    receipt.observed_rvv_vlen_bits = observed_rvv_vlen_bits
    receipt.artifact_sha256 = admission.runner_artifact_sha256
    Ok(receipt)

fn _is_simd_backend(backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Avx2 or
    backend == X25519MlKem768EvidenceBackend.Neon or
    backend == X25519MlKem768EvidenceBackend.Rvv

fn _print_cli_failure(reason: text):
    print "schema={X25519_MLKEM768_EVIDENCE_SCHEMA}"
    print "status=fail"
    print "reason={reason}"

fn main() -> i64:
    val runner_cli = match _parse_runner_cli(get_cli_args()):
        case Ok(value): value
        case Err(reason):
            _print_cli_failure(reason)
            return 2
    val cli = runner_cli.evidence
    val hashes = match _input_hashes(cli):
        case Ok(value): value
        case Err(reason):
            _print_cli_failure(reason)
            return 2
    val (manifest_sha256, fixture_sha256, runner_sha256,
        fixture_manifest) = hashes
    if _is_simd_backend(cli.backend):
        val admission = match _specialized_admission(runner_cli):
            case Ok(value): value
            case Err(reason):
                val blocked = _empty_receipt(
                    cli, X25519MlKem768EvidenceStatus.Blocked, reason,
                    manifest_sha256, fixture_sha256, runner_sha256)
                print x25519_mlkem768_render_evidence_receipt(blocked)
                return 1
        val receipt = match _simd_roundtrip(
                runner_cli, admission,
                manifest_sha256, fixture_sha256, runner_sha256):
            case Ok(value): value
            case Err(reason):
                val failed = _empty_receipt(
                    cli, X25519MlKem768EvidenceStatus.Fail, reason,
                    manifest_sha256, fixture_sha256, runner_sha256)
                print x25519_mlkem768_render_evidence_receipt(failed)
                return 1
        print x25519_mlkem768_render_evidence_receipt(receipt)
        return 0
    if cli.backend != X25519MlKem768EvidenceBackend.ScalarCpu:
        val gpu_result = x25519_mlkem768_dispatch_gpu(
            X25519MlKem768GpuDispatchRequest(
                evidence: cli,
                compiler_artifact: runner_cli.compiler_artifact,
                compiler_provenance: runner_cli.compiler_provenance,
                runner_artifact: runner_cli.runner_artifact,
                runner_source: cli.runner_source,
                runner_provenance: runner_cli.runner_provenance,
                accelerator_binding: runner_cli.accelerator_binding,
                accelerator_source: runner_cli.accelerator_source,
                accelerator_source_aux: runner_cli.accelerator_source_aux,
                accelerator_binary: runner_cli.accelerator_binary,
                accelerator_binary_aux: runner_cli.accelerator_binary_aux,
                fixture_manifest: fixture_manifest,
                fixture_manifest_sha256: manifest_sha256,
                fixture_source_sha256: fixture_sha256,
                runner_source_sha256: runner_sha256))
        print x25519_mlkem768_render_evidence_receipt(gpu_result.receipt)
        return gpu_result.exit_code
    val receipt = match _scalar_roundtrip(
            cli, manifest_sha256, fixture_sha256, runner_sha256):
        case Ok(value): value
        case Err(reason):
            val failed = _empty_receipt(
                cli, X25519MlKem768EvidenceStatus.Fail, reason,
                manifest_sha256, fixture_sha256, runner_sha256)
            print x25519_mlkem768_render_evidence_receipt(failed)
            return 1
    print x25519_mlkem768_render_evidence_receipt(receipt)
    0

export x25519_mlkem768_scalar_observation_reason
