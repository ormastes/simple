"""Native direct-CUDA ProcessingIR FillU32 probe."""

use std.common.processing.processing_ir.{processing_ir_fill_u32}
use std.gc_async_mut.processing.cuda_fill_u32.{processing_ir_execute_cuda}

fn main() -> i64:
    val count: i64 = 64
    val value = 0x01020304u32
    val expected_checksum: u64 = 1082179840
    val result = processing_ir_execute_cuda(processing_ir_fill_u32(count, value))
    var checksum: u64 = 0
    var mismatches: i64 = 0
    var index: i64 = 0
    while index < result.values.len().to_i64():
        checksum = checksum + result.values[index].to_u64()
        if result.values[index] != value:
            mismatches = mismatches + 1
        index = index + 1
    val exact = result.values.len().to_i64() == count and
        checksum == expected_checksum and mismatches == 0
    val valid = result.completed and result.reason == "ok" and exact and
        result.backend_handle > 0 and result.device_identity > 0
    val status = if valid: "pass" else: "fail"
    print("PROCESSING_CUDA_NATIVE status={status} reason={result.reason} op=fill_u32 completed={result.completed} count={result.values.len()} value={value} expected_checksum={expected_checksum} actual_checksum={checksum} mismatch_count={mismatches} values_exact={exact} backend=cuda readback_source=device_readback handle={result.backend_handle} identity={result.device_identity} cpu_fallback=false\n")
    if valid: 0 else: 1
