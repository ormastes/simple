# Pure-Simple critical-branch inventory calibrator for X25519MLKEM768.
#
# Requirement-owned input names source anchors and logical condition ordinals,
# never compiler decision IDs.  This calibrator resolves those anchors against
# the exact twenty-three-source snapshot and derives concrete IDs only from the
# measured decision-condition coverage stream.

use std.cli.cli_util.{get_cli_args}
use app.io.mod.{file_create_exclusive, file_exists, file_hash_sha256,
    file_is_regular_no_follow, file_read}
use app.test.x25519mlkem768_coverage_receipt.{
    x25519_mlkem768_parse_coverage_run_manifest}

val X25519_MLKEM768_CRITICAL_SYMBOLIC_SCHEMA =
    "x25519mlkem768-critical-symbolic-v1"
val X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH =
    "test/fixtures/crypto/x25519mlkem768/critical_branch_symbolic_v1.psv"
val X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256 =
    "2e8bbb4a23c844f561ebd594b29bd8d3b06b15e5c2f57913599a609b5ac8de8b"

struct X25519MlKem768CriticalCondition:
    decision_id: text
    condition_id: text
    path: text
    line: text
    column: text
    true_count: i64
    false_count: i64

fn _critical_owner_ids() -> [text]:
    ["cache_identity", "artifact_snapshot", "accelerator_cache",
     "cuda_provider", "cuda_unsafe", "metal_provider", "vulkan_provider",
     "execution_policy", "hybrid", "hybrid_support", "gpu_operation_evidence",
     "simd_operation_evidence", "cuda_session", "metal_session",
     "vulkan_session", "simd_runtime", "browser_tls", "browser_h1",
     "server_config", "server_worker", "mlkem_core", "mlkem_kpke",
     "mlkem_ntt"]

fn _critical_owner_paths() -> [text]:
    ["src/os/crypto/x25519_mlkem768/cache_identity.spl",
     "src/os/crypto/x25519_mlkem768/artifact_snapshot_admission.spl",
     "src/os/crypto/x25519_mlkem768/accelerator_cache.spl",
     "src/os/crypto/x25519_mlkem768/cuda_ntt_provider.spl",
     "src/os/crypto/x25519_mlkem768/cuda_ntt_unsafe.spl",
     "src/os/crypto/x25519_mlkem768/metal_ntt_provider.spl",
     "src/os/crypto/x25519_mlkem768/vulkan_ntt_provider.spl",
     "src/os/crypto/x25519_mlkem768/execution_policy.spl",
     "src/os/crypto/x25519_mlkem768/hybrid.spl",
     "src/os/crypto/x25519_mlkem768/hybrid_support.spl",
     "src/os/crypto/x25519_mlkem768/gpu_operation_evidence.spl",
     "src/os/crypto/x25519_mlkem768/simd_operation_evidence.spl",
     "src/lib/gc_async_mut/crypto_accel/cuda_session.spl",
     "src/lib/gc_async_mut/crypto_accel/metal_session.spl",
     "src/lib/gc_async_mut/crypto_accel/vulkan_session.spl",
     "src/runtime/runtime_simd_dispatch.c",
     "src/lib/gc_async_mut/gpu/browser_engine/net/tls.spl",
     "src/lib/gc_async_mut/gpu/browser_engine/net/h1_client.spl",
     "src/lib/nogc_async_mut/http_server/server.spl",
     "src/lib/nogc_async_mut/http_server/worker.spl",
     "src/os/crypto/ml_kem.spl", "src/os/crypto/ml_kem_kpke.spl",
     "src/os/crypto/ml_kem_ntt.spl"]

fn _critical_uint(value: text, positive: bool = false) -> bool:
    if value == "" or value.len() > 10: return false
    if value.len() > 1 and value.starts_with("0"): return false
    var index: i64 = 0
    while index < value.len():
        val digit = value[index:index + 1]
        if digit < "0" or digit > "9": return false
        index = index + 1
    val parsed = value.parse_i64() ?? -1
    parsed >= (if positive: 1 else: 0) and parsed <= 1000000000

fn _critical_hex64(value: text) -> bool:
    if value.len() != 64: return false
    var index: i64 = 0
    while index < value.len():
        val digit = value[index:index + 1]
        if not ((digit >= "0" and digit <= "9") or
                (digit >= "a" and digit <= "f")):
            return false
        index = index + 1
    true

fn _critical_parse_raw(raw: text) -> Result<[X25519MlKem768CriticalCondition], text>:
    var section = ""
    var saw_version = false
    var saw_extension = false
    var decisions: Dict<text, bool> = {}
    var decision_ids: Dict<text, bool> = {}
    var conditions: [X25519MlKem768CriticalCondition] = []
    var condition_keys: Dict<text, bool> = {}
    for raw_line in raw.split("\n"):
        val line = raw_line.trim()
        if line == "" or line.starts_with("#"): continue
        if line == "version: 1.0":
            if saw_version or section != "": return Err("raw-version-stale")
            saw_version = true
            continue
        if line == "coverage_extension: decision-condition-v1":
            if saw_extension or section != "": return Err("raw-extension-stale")
            saw_extension = true
            continue
        if line == "decisions |id, file, line, column, true_count, false_count|":
            if section != "" or not saw_version or not saw_extension:
                return Err("raw-decision-header-stale")
            section = "decisions"
            continue
        if line == "conditions |decision_id, condition_id, file, line, column, true_count, false_count|":
            if section != "decisions": return Err("raw-condition-header-stale")
            section = "conditions"
            continue
        if line == "summary:":
            if section != "conditions": return Err("raw-summary-stale")
            section = "summary"
            continue
        if section == "summary":
            val separator = line.index_of(":")
            if separator <= 0 or not _critical_uint(line[separator + 1:].trim()):
                return Err("raw-summary-row-invalid")
            continue
        val fields = line.split(",")
        if section == "decisions":
            if fields.len() != 6: return Err("raw-decision-row-invalid")
            val id = fields[0].trim()
            val path = fields[1].trim()
            val source_line = fields[2].trim()
            val column = fields[3].trim()
            if (not _critical_uint(id, true) or path == "" or
                    not _critical_uint(source_line, true) or
                    not _critical_uint(column) or not _critical_uint(fields[4].trim()) or
                    not _critical_uint(fields[5].trim())):
                return Err("raw-decision-row-invalid")
            val key = id + "|" + path + "|" + source_line + "|" + column
            if decisions.has(key) or decision_ids.has(id):
                return Err("raw-decision-duplicate")
            decisions[key] = true
            decision_ids[id] = true
            continue
        if section == "conditions":
            if fields.len() != 7: return Err("raw-condition-row-invalid")
            val decision_id = fields[0].trim()
            val condition_id = fields[1].trim()
            val path = fields[2].trim()
            val source_line = fields[3].trim()
            val column = fields[4].trim()
            val true_text = fields[5].trim()
            val false_text = fields[6].trim()
            if (not _critical_uint(decision_id, true) or not _critical_uint(condition_id) or
                    path == "" or not _critical_uint(source_line, true) or
                    not _critical_uint(column) or not _critical_uint(true_text) or
                    not _critical_uint(false_text)):
                return Err("raw-condition-row-invalid")
            val decision_key = decision_id + "|" + path + "|" + source_line + "|" + column
            if not decisions.has(decision_key): return Err("raw-condition-decision-stale")
            val condition_key = decision_key + "|" + condition_id
            if condition_keys.has(condition_key): return Err("raw-condition-duplicate")
            condition_keys[condition_key] = true
            conditions.push(X25519MlKem768CriticalCondition(
                decision_id: decision_id, condition_id: condition_id,
                path: path, line: source_line, column: column,
                true_count: true_text.parse_i64() ?? 0,
                false_count: false_text.parse_i64() ?? 0))
            continue
        return Err("raw-section-stale")
    if section != "summary" or decisions.len() == 0 or conditions.len() == 0:
        return Err("raw-coverage-incomplete")
    Ok(conditions)

fn x25519_mlkem768_calibrate_critical_inventory_from_text(
        symbolic: text, raw: text,
        actual_source_sha256: Dict<text, text>,
        run_source_sha256: Dict<text, text>,
        source_text: Dict<text, text>) -> Result<text, text>:
    val conditions = _critical_parse_raw(raw)?
    val owner_ids = _critical_owner_ids()
    val owner_paths = _critical_owner_paths()
    var owner_seen: Dict<text, bool> = {}
    var rows: [text] = []
    var critical_owner_seen: Dict<text, bool> = {}
    var pair_true: Dict<text, bool> = {}
    var pair_false: Dict<text, bool> = {}
    var emitted: Dict<text, bool> = {}
    var saw_schema = false
    for raw_line in symbolic.split("\n"):
        val line = raw_line.trim()
        if line == "" or line.starts_with("#"): continue
        if not saw_schema:
            if line != "schema|" + X25519_MLKEM768_CRITICAL_SYMBOLIC_SCHEMA:
                return Err("symbolic-schema-stale")
            saw_schema = true
            continue
        val fields = line.split("|")
        if fields.len() == 4 and fields[0] == "owner":
            val owner = fields[1]
            val index = owner_ids.index_of(owner)
            if (index < 0 or fields[2] != owner_paths[index] or
                    not _critical_hex64(fields[3]) or owner_seen.has(owner)):
                return Err("symbolic-owner-stale")
            if ((actual_source_sha256[fields[2]] ?? "") != fields[3] or
                    (run_source_sha256[fields[2]] ?? "") != fields[3]):
                return Err("symbolic-owner-source-sha256-stale")
            owner_seen[owner] = true
            continue
        if fields.len() != 6 or fields[0] != "critical":
            return Err("symbolic-critical-row-invalid")
        val owner = fields[1]
        val owner_index = owner_ids.index_of(owner)
        val source_line = fields[2]
        val anchor = fields[3]
        val ordinal = fields[4]
        val outcome = fields[5]
        if (owner_index < 0 or not owner_seen.has(owner) or
                not _critical_uint(source_line, true) or anchor == "" or
                not _critical_uint(ordinal) or
                (outcome != "true" and outcome != "false")):
            return Err("symbolic-critical-row-invalid")
        val path = owner_paths[owner_index]
        val lines = (source_text[path] ?? "").split("\n")
        val line_index = (source_line.parse_i64() ?? 0) - 1
        if line_index < 0 or line_index >= lines.len().to_i64() or
                lines[line_index].trim() != anchor:
            return Err("symbolic-source-anchor-stale")
        var matched: X25519MlKem768CriticalCondition? = nil
        for condition in conditions:
            if (condition.path == path and condition.line == source_line and
                    condition.condition_id == ordinal):
                if matched != nil: return Err("symbolic-condition-ambiguous")
                matched = Some(condition)
        if matched == nil: return Err("symbolic-condition-stale")
        val concrete = matched.unwrap()
        val count = if outcome == "true": concrete.true_count else: concrete.false_count
        if count <= 0: return Err("symbolic-outcome-uncovered")
        val pair_key = owner + "|" + source_line + "|" + ordinal
        critical_owner_seen[owner] = true
        if outcome == "true":
            pair_true[pair_key] = true
        else:
            pair_false[pair_key] = true
        val output_row = owner + "|" + path + "|" + source_line + "|" +
            concrete.decision_id + "|" + concrete.condition_id + "|" + outcome
        if emitted.has(output_row): return Err("symbolic-critical-duplicate")
        emitted[output_row] = true
        rows.push(output_row)
    if not saw_schema or owner_seen.len() != owner_ids.len():
        return Err("symbolic-owner-set-incomplete")
    for owner in owner_ids:
        if not owner_seen.has(owner): return Err("symbolic-owner-set-incomplete")
        if not critical_owner_seen.has(owner):
            return Err("symbolic-critical-owner-incomplete")
    if rows.len() == 0: return Err("symbolic-critical-empty")
    for key in pair_true.keys():
        if not pair_false.has(key): return Err("symbolic-outcome-pair-incomplete")
    for key in pair_false.keys():
        if not pair_true.has(key): return Err("symbolic-outcome-pair-incomplete")
    rows = array_sort_by(rows, \a, b:
        if a < b: -1
        elif a > b: 1
        else: 0)
    Ok("owner|source_path|line|decision_id|condition_id|outcome\n" +
        rows.join("\n") + "\n")

fn _critical_safe_path(path: text) -> bool:
    path != "" and not path.starts_with("/") and not path.starts_with("\\") and
        not path.starts_with("../") and not path.contains("/../") and
        not path.contains("//") and not path.contains("\\")

fn _critical_cli(args: [text]) -> Result<Dict<text, text>, text>:
    var fields: Dict<text, text> = {}
    var index: i64 = 0
    while index < args.len():
        if index + 1 >= args.len() or not args[index].starts_with("--"):
            return Err("cli-invalid")
        val key = args[index][2:]
        if not ["raw-coverage", "run-manifest", "symbolic-spec", "output"].contains(key) or
                fields.has(key) or args[index + 1] == "":
            return Err("cli-invalid")
        fields[key] = args[index + 1]
        index = index + 2
    for key in ["raw-coverage", "run-manifest", "symbolic-spec", "output"]:
        if not fields.has(key) or not _critical_safe_path(fields[key] ?? ""):
            return Err("cli-invalid")
    Ok(fields)

fn main() -> i64:
    val cli = match _critical_cli(get_cli_args()):
        case Ok(value): value
        case Err(reason):
            print "status=fail\nreason=" + reason
            return 2
    val raw_path = cli["raw-coverage"] ?? ""
    val run_path = cli["run-manifest"] ?? ""
    val symbolic_path = cli["symbolic-spec"] ?? ""
    val output_path = cli["output"] ?? ""
    for path in [raw_path, run_path, symbolic_path]:
        if not file_is_regular_no_follow(path):
            print "status=fail\nreason=input-not-regular-no-follow"
            return 2
    if file_exists(output_path):
        print "status=fail\nreason=output-exists"
        return 2
    val raw_sha = file_hash_sha256(raw_path)
    val run_sha = file_hash_sha256(run_path)
    val symbolic_sha = file_hash_sha256(symbolic_path)
    if (symbolic_path != X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH or
            symbolic_sha != X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256):
        print "status=fail\nreason=symbolic-spec-not-canonical"
        return 2
    val manifest = match x25519_mlkem768_parse_coverage_run_manifest(file_read(run_path)):
        case Ok(value): value
        case Err(reason):
            print "status=fail\nreason=" + reason
            return 2
    if manifest.raw_coverage_path != raw_path or manifest.raw_coverage_sha256 != raw_sha:
        print "status=fail\nreason=raw-coverage-run-binding-stale"
        return 2
    var actual_hashes: Dict<text, text> = {}
    var source_texts: Dict<text, text> = {}
    for path in _critical_owner_paths():
        if not file_is_regular_no_follow(path):
            print "status=fail\nreason=owner-source-not-regular"
            return 2
        actual_hashes[path] = file_hash_sha256(path)
        source_texts[path] = file_read(path)
    val output = match x25519_mlkem768_calibrate_critical_inventory_from_text(
            file_read(symbolic_path), file_read(raw_path), actual_hashes,
            manifest.source_sha256, source_texts):
        case Ok(value): value
        case Err(reason):
            print "status=fail\nreason=" + reason
            return 1
    if (raw_sha != file_hash_sha256(raw_path) or run_sha != file_hash_sha256(run_path) or
            symbolic_sha != file_hash_sha256(symbolic_path)):
        print "status=fail\nreason=input-mutated-during-calibration"
        return 2
    for path in _critical_owner_paths():
        if (actual_hashes[path] ?? "") != file_hash_sha256(path):
            print "status=fail\nreason=owner-source-mutated-during-calibration"
            return 2
    if not file_create_exclusive(output_path, output):
        print "status=fail\nreason=output-exclusive-create-failed"
        return 2
    val output_sha = file_hash_sha256(output_path)
    if not _critical_hex64(output_sha):
        print "status=fail\nreason=output-sha256-unavailable"
        return 2
    print "status=pass"
    print "critical_inventory_path=" + output_path
    print "critical_inventory_sha256=" + output_sha
    0

export X25519MlKem768CriticalCondition
export X25519_MLKEM768_CRITICAL_SYMBOLIC_SCHEMA
export X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH
export X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256
export x25519_mlkem768_calibrate_critical_inventory_from_text
