# codex-impl
# Pure-Simple RenderDoc capture inspector. The existing RenderDoc CLI converts
# RDC to XML; Simple parses stable driver/chunk/action/resource markers.

use app.io.mod.{dir_create_all, file_delete, file_exists, file_read_text, file_size, process_run_timeout}
use app.io.args_ops.{get_args}
use std.common.crypto.sha256.{sha256_text}

struct RenderDocReplayInspection:
    status: text
    reason: text
    driver: text
    capture_path: text
    xml_path: text
    xml_hash: text
    xml_bytes: i64
    chunk_count: i64
    relevant_action_count: i64
    dispatch_count: i64
    draw_count: i64
    pipeline_count: i64
    shader_count: i64
    resource_count: i64
    convert_exit_code: i64
    convert_log: text

fn _count_marker(content: text, marker: text) -> i64:
    if marker == "": return 0
    var count: i64 = 0
    var offset = 0
    while offset < content.len():
        val relative = content[offset:content.len()].index_of(marker)
        if relative < 0: return count
        count = count + 1
        offset = offset + relative + marker.len()
    count

fn _renderdoc_header_driver(xml: text) -> text:
    val header_marker = "<header>"
    if _count_marker(xml, header_marker) != 1 or
       _count_marker(xml, "</header>") != 1:
        return "unknown"
    val header_start = xml.index_of(header_marker) + header_marker.len()
    val header_tail = xml[header_start:xml.len()]
    val header_length = header_tail.index_of("</header>")
    if header_length < 0:
        return "unknown"
    val header = header_tail[0:header_length]
    val driver_count = (
        _count_marker(header, "<driver ") + _count_marker(header, "<driver>")
    )
    if driver_count != 1 or _count_marker(header, "</driver>") != 1:
        return "unknown"
    val driver_start = header.index_of("<driver")
    val driver_tail = header[driver_start:header.len()]
    val value_offset = driver_tail.index_of(">")
    if value_offset < 0:
        return "unknown"
    val value_tail = driver_tail[value_offset + 1:driver_tail.len()]
    val value_length = value_tail.index_of("</driver>")
    if value_length < 0:
        return "unknown"
    val value = value_tail[0:value_length].trim()
    if value == "Vulkan":
        return "vulkan"
    if value == "D3D12":
        return "d3d12"
    if value == "D3D11":
        return "d3d11"
    "unknown"

fn _inspection_failure(reason: text, capture_path: text, xml_path: text, exit_code: i64, log: text) -> RenderDocReplayInspection:
    RenderDocReplayInspection(
        status: "fail", reason: reason, driver: "", capture_path: capture_path,
        xml_path: xml_path, xml_hash: "", xml_bytes: 0, chunk_count: 0,
        relevant_action_count: 0, dispatch_count: 0, draw_count: 0,
        pipeline_count: 0, shader_count: 0, resource_count: 0,
        convert_exit_code: exit_code, convert_log: log
    )

fn parse_renderdoc_capture_xml(xml: text, capture_path: text, xml_path: text, exit_code: i64, convert_log: text) -> RenderDocReplayInspection:
    """Parse RenderDoc's XML conversion without trusting file magic."""
    if exit_code != 0: return _inspection_failure("capture-open-failed", capture_path, xml_path, exit_code, convert_log)
    if not xml.contains("<rdc>") or not xml.contains("<chunks version="):
        return _inspection_failure("invalid-renderdoc-xml", capture_path, xml_path, exit_code, convert_log)
    val driver = _renderdoc_header_driver(xml)
    val chunks = _count_marker(xml, "<chunk ")
    val dispatches = _count_marker(xml, "<chunk name=\"vkCmdDispatch\"")
    val draws = _count_marker(xml, "<chunk name=\"vkCmdDraw")
    val pipelines = _count_marker(xml, "<chunk name=\"vkCreateComputePipelines\"") + _count_marker(xml, "<chunk name=\"vkCreateGraphicsPipelines\"")
    val shaders = _count_marker(xml, "<chunk name=\"vkCreateShaderModule\"")
    val resources = _count_marker(xml, "<chunk name=\"vkCreateBuffer\"") + _count_marker(xml, "<chunk name=\"vkCreateImage\"")
    val relevant = dispatches + draws
    var reason = "pass"
    if driver == "unknown": reason = "unsupported-capture-driver"
    else if chunks <= 0: reason = "empty-capture"
    else if relevant <= 0: reason = "missing-relevant-actions"
    else if pipelines <= 0: reason = "missing-pipeline-evidence"
    else if shaders <= 0: reason = "missing-shader-evidence"
    else if resources <= 0: reason = "missing-resource-evidence"
    val status = if reason == "pass": "pass" else "fail"
    RenderDocReplayInspection(
        status: status, reason: reason,
        driver: driver, capture_path: capture_path, xml_path: xml_path,
        xml_hash: sha256_text(xml), xml_bytes: xml.len().to_i64(),
        chunk_count: chunks, relevant_action_count: relevant,
        dispatch_count: dispatches, draw_count: draws, pipeline_count: pipelines,
        shader_count: shaders, resource_count: resources,
        convert_exit_code: exit_code, convert_log: convert_log
    )

fn inspect_renderdoc_capture(renderdoc_cmd: text, capture_path: text, output_dir: text, timeout_ms: i64) -> RenderDocReplayInspection:
    """Open an RDC by converting it to XML with the canonical RenderDoc CLI."""
    if not file_exists(renderdoc_cmd): return _inspection_failure("renderdoccmd-missing", capture_path, "", -1, "")
    if not file_exists(capture_path): return _inspection_failure("capture-missing", capture_path, "", -1, "")
    if file_size(capture_path) <= 4: return _inspection_failure("capture-too-small", capture_path, "", -1, "")
    dir_create_all(output_dir)
    val xml_path = output_dir + "/capture.xml"
    if file_exists(xml_path): file_delete(xml_path)
    val (stdout, stderr, exit_code) = process_run_timeout(renderdoc_cmd, ["convert", "-f", capture_path, "-o", xml_path, "-i", "rdc", "-c", "xml"], timeout_ms)
    val log = stdout + stderr
    if exit_code != 0 or not file_exists(xml_path):
        return _inspection_failure("capture-open-failed", capture_path, xml_path, exit_code, log)
    parse_renderdoc_capture_xml(file_read_text(xml_path), capture_path, xml_path, exit_code, log)

fn validate_renderdoc_owner_agreement(inspection: RenderDocReplayInspection, owner_api: text, owner_frame_id: text, capture_frame_id: text) -> text:
    """Correlate replay content with the production owner's frame receipt."""
    if inspection.status != "pass":
        return inspection.reason
    if owner_api == "" or owner_frame_id == "" or capture_frame_id == "":
        return "capture-record-mismatch"
    if inspection.driver != owner_api or owner_frame_id != capture_frame_id:
        return "capture-record-mismatch"
    if inspection.relevant_action_count <= 0:
        return "capture-record-mismatch"
    "pass"

fn renderdoc_replay_evidence_text(
    inspection: RenderDocReplayInspection,
    owner_api: text,
    owner_frame_id: text,
    capture_frame_id: text
) -> text:
    val agreement = validate_renderdoc_owner_agreement(
        inspection, owner_api, owner_frame_id, capture_frame_id)
    "rdoc_simple_replay_status={inspection.status}\n" +
        "rdoc_simple_replay_reason={inspection.reason}\n" +
        "rdoc_simple_replay_driver={inspection.driver}\n" +
        "rdoc_simple_replay_capture_path={inspection.capture_path}\n" +
        "rdoc_simple_replay_xml_path={inspection.xml_path}\n" +
        "rdoc_simple_replay_xml_hash={inspection.xml_hash}\n" +
        "rdoc_simple_replay_xml_bytes={inspection.xml_bytes}\n" +
        "rdoc_simple_replay_chunk_count={inspection.chunk_count}\n" +
        "rdoc_simple_replay_relevant_action_count={inspection.relevant_action_count}\n" +
        "rdoc_simple_replay_dispatch_count={inspection.dispatch_count}\n" +
        "rdoc_simple_replay_draw_count={inspection.draw_count}\n" +
        "rdoc_simple_replay_pipeline_count={inspection.pipeline_count}\n" +
        "rdoc_simple_replay_shader_count={inspection.shader_count}\n" +
        "rdoc_simple_replay_resource_count={inspection.resource_count}\n" +
        "rdoc_simple_replay_convert_exit_code={inspection.convert_exit_code}\n" +
        "rdoc_simple_owner_agreement_status={agreement}\n" +
        "rdoc_simple_owner_api={owner_api}\n" +
        "rdoc_simple_owner_frame_id={owner_frame_id}\n" +
        "rdoc_simple_capture_frame_id={capture_frame_id}\n"

fn main() -> i64:
    val args = get_args()
    if args.len() != 7:
        print("rdoc_simple_replay_status=fail\nrdoc_simple_replay_reason=invalid-arguments\n")
        return 2
    val inspection = inspect_renderdoc_capture(args[1], args[2], args[3], 120000)
    val evidence = renderdoc_replay_evidence_text(
        inspection, args[4], args[5], args[6])
    print evidence
    if inspection.status == "pass" and
       validate_renderdoc_owner_agreement(inspection, args[4], args[5], args[6]) == "pass":
        return 0
    1
