"""Native CUDA identity ABI probe."""

use std.gc_async_mut.gpu_ffi.{cuda_init, cuda_device_get, cuda_device_identity}

val MAX_TAGGED_I64: i64 = 1152921504606846975

fn main() -> i64:
    val initialized = cuda_init() == 0
    val device = if initialized: cuda_device_get(0) else: -1
    val identity = if device >= 0: cuda_device_identity(device) else: 0
    val valid = initialized and device >= 0 and identity > 0 and identity <= MAX_TAGGED_I64
    val status = if valid: "pass" else: "fail"
    print("CUDA_IDENTITY status={status} device={device} identity={identity} max={MAX_TAGGED_I64}\n")
    if valid: 0 else: 1
