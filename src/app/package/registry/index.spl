# Registry Index
# Parse and query the sparse package index.

use app.package.registry.types (PackageInfo, VersionEntry, VersionDependency, IndexEntry, SearchResult)
use app.package.registry.config (default_config, index_entry_url, listing_url, index_path_for, RegistryConfig)

pub fn fetch_index_entry(config: RegistryConfig, name: text) -> IndexEntry:
    # Network fetch not yet implemented; return empty entry
    val pkg = PackageInfo(name: name, description: "", homepage: "", license: "", repository: "")
    IndexEntry(package: pkg, versions: [], dependencies: [])

pub fn latest_version(entry: IndexEntry) -> text:
    var best = ""
    for ver in entry.versions:
        if not ver.yanked:
            best = ver.version
    best

pub fn deps_for_version(entry: IndexEntry, version: text) -> [VersionDependency]:
    var result: [VersionDependency] = []
    for dep in entry.dependencies:
        if dep.version == version:
            result.push(dep)
    result

pub fn find_version(entry: IndexEntry, version: text) -> VersionEntry:
    for ver in entry.versions:
        if ver.version == version:
            return ver
    VersionEntry(version: "", checksum: "", oci_ref: "", yanked: false, published_at: "")

pub fn search_packages(config: RegistryConfig, query: text) -> [SearchResult]:
    # Network search not yet implemented
    []

fn clear_cache(config: RegistryConfig) -> bool:
    # Cache clearing not yet implemented
    false
