# Separate Windows composition for the compiler-owned grouped parse protocol.
# This candidate does not replace the qualified generic task manager artifact.
use app.io.args_ops.{get_args}
use app.bootstrap_builder.grouped_run.{grouped_run_v1}
use compiler.driver.driver_build.managed_parse_run_contract.{managed_parse_run_decode_v1}
use std.common.build_manager.grouped_native_contract.{native_group_absolute_path_valid_v1}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.group_process_owner.{group_process_set_launcher_v1}
use std.nogc_sync_mut.io.windows_group_broker_launcher.{windows_group_broker_launch_v1}

fn main() -> i64:
    val args = get_args()
    if args.len() != 4 or args[1] != "grouped-run" or args[2] != "--manifest":
        print "usage: grouped-builder-windows grouped-run --manifest ABSOLUTE_FILE"
        return 2
    if not native_group_absolute_path_valid_v1(args[3]):
        print "grouped builder: manifest path must be absolute"
        return 2
    val payload = match file_read_regular_no_follow_bounded(args[3], 16777216):
        case Ok(value): value
        case Err(message):
            print "grouped builder: cannot read manifest: {message}"
            return 2
    val run = match managed_parse_run_decode_v1(payload):
        case Ok(value): value
        case Err(message):
            print "grouped builder: invalid manifest: {message}"
            return 2
    if not group_process_set_launcher_v1(windows_group_broker_launch_v1):
        print "grouped builder: process launcher already configured"
        return 2
    val result = grouped_run_v1(run)
    print "grouped builder: completed={result.completed_actions} cached={result.cached_actions} exit={result.exit_code} reason={result.reason}"
    result.exit_code
