# Separate Windows composition for the compiler-owned grouped parse protocol.
# This candidate does not replace the qualified generic task manager artifact.
use app.io.args_ops.{get_args}
use app.bootstrap_builder.grouped_run.{grouped_run_v1, grouped_run_v2}
use app.bootstrap_builder.grouped_run_cli_v2.{grouped_run_cli_pins_v2}
use compiler.driver.driver_build.managed_parse_run_contract.{managed_parse_run_decode_v1}
use std.common.build_manager.grouped_native_contract.{native_group_absolute_path_valid_v1}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.group_process_owner.{group_process_set_launcher_v1}
use std.nogc_sync_mut.io.windows_group_broker_launcher.{windows_group_broker_launch_v1}

fn main() -> i64:
    val args = get_args()
    var pins: [text] = []
    var manifest = ""
    if args.len() > 1 and args[1] == "grouped-run-v2":
        pins = match grouped_run_cli_pins_v2(args):
            Ok(value): value
            Err(message):
                print "grouped builder: {message}"
                return 2
        manifest = pins[0]
    elif args.len() == 4 and args[1] == "grouped-run" and args[2] == "--manifest":
        manifest = args[3]
    else:
        print "usage: grouped-builder-windows grouped-run --manifest FILE; grouped-run-v2 requires explicit independent qualification pins"
        return 2
    if not native_group_absolute_path_valid_v1(manifest):
        print "grouped builder: manifest path must be absolute"
        return 2
    val payload = match file_read_regular_no_follow_bounded(manifest, 16777216):
        case Ok(value): value
        case Err(message):
            print "grouped builder: cannot read manifest: {message}"
            return 2
    val run = match managed_parse_run_decode_v1(payload):
        case Ok(value): value
        case Err(message):
            print "grouped builder: invalid manifest: {message}"
            return 2
    if not group_process_set_launcher_v1(windows_group_broker_launch_v1, "windows"):
        print "grouped builder: process launcher already configured"
        return 2
    val result = if pins.len() == 0: grouped_run_v1(run) else:
        grouped_run_v2(run, pins[1], pins[2], pins[3], pins[4], pins[5], pins[6],
            pins[7], pins[8], pins[9], pins[10])
    print "grouped builder: completed={result.completed_actions} cached={result.cached_actions} exit={result.exit_code} reason={result.reason}"
    result.exit_code
