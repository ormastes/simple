# Provisional diagnostics: one full frozen source copy, one typed SCV snapshot,
# four producer-pinned index configs, and a separately pinned hello fixture.
use app.bootstrap_builder.native_group_index_contract.{
    native_group_index_absolute_v1, native_group_index_config_decode_v1
}
use app.bootstrap_builder.native_group_index_variant.{
    native_group_index_variant_profile_v1,
    native_group_index_variant_admit_v1
}
use app.bootstrap_builder.native_group_phase2_source_snapshot.{
    phase2_source_snapshot_publish_v1, phase2_source_authority_decode_v1,
    PHASE2_AUTHORITY_MAX_BYTES_V1
}
use app.bootstrap_builder.native_group_module_roles.{
    PHASE2_MODULE_ROLE_POLICY_PATH_V1, Phase2ModuleSourceV1,
    phase2_module_roles_select_v1
}
use app.bootstrap_builder.native_group_phase2_scv.{
    phase2_native_scv_publish_v1
}
use app.bootstrap_builder.native_group_phase2_index_config.{
    native_group_index_config_encode_for_producer_v1
}
use app.bootstrap_builder.native_group_provisional_contract.{
    PROVISIONAL_AUTHORITY_SCHEMA_V1,
    native_group_provisional_hello_open_v1,
    native_group_provisional_authority_encode_v1,
    native_group_provisional_authority_open_v1
}
use app.bootstrap_builder.native_group_provisional_runtime.{
    native_group_provisional_runtime_from_authority_v1,
    native_group_provisional_runtime_verify_v1
}
use app.bootstrap_builder.native_group_provisional_hello_command.{
    native_group_provisional_hello_command_decode_v1
}
use app.io.process_ops.{process_run_bounded}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use compiler.driver.driver_build.native_full_inventory_sources.{
    native_full_inventory_source_paths_v1
}
use std.common.build_manager.contracts.{builder_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_is_real_no_follow}
use std.nogc_sync_mut.io.file_ops.{
    file_create_exclusive, file_exists, file_hash_sha256,
    file_is_regular_no_follow, file_read_regular_no_follow_bounded
}
use std.nogc_sync_mut.io.snapshot_links.{
    snapshot_readonly_nofollow_v1, snapshot_symlink_match_nofollow_v1
}

struct NativeGroupProvisionalBuiltV1:
    receipt_path: text
    receipt_digest: text
    module_count: i64

fn _provisional_plain_absolute_v1(path: text) -> bool:
    native_group_index_absolute_v1(path) and
        not path.contains("\\") and not path.contains("//") and
        not path.contains("/./") and not path.ends_with("/.") and
        not path.contains("/../") and not path.ends_with("/..") and
        not path.ends_with("/")

fn _provisional_real_parent_v1(path: text) -> bool:
    if not _provisional_plain_absolute_v1(path): return false
    val parts = path.split("/")
    if parts.len() < 2: return false
    var current = if path.starts_with("/"): "/" else: parts[0] + "/"
    for index in 1..parts.len() - 1:
        if parts[index] == "": return false
        current = if current.ends_with("/"):
            current + parts[index]
        else:
            current + "/" + parts[index]
        if not dir_is_real_no_follow(current): return false
    dir_is_real_no_follow(current)

fn _provisional_artifact_v1(path: text, digest: text) -> bool:
    _provisional_plain_absolute_v1(path) and
        _provisional_real_parent_v1(path) and
        builder_digest_valid_v1(digest) and
        file_is_regular_no_follow(path) and
        file_hash_sha256(path) == digest

fn _provisional_publish_v1(path: text, payload: text) -> Result<text, text>:
    if not file_create_exclusive(path, payload):
        return Err("provisional output publication failed: " + path)
    val digest = sha256_text(payload)
    if not _provisional_artifact_v1(path, digest) or
            not snapshot_readonly_nofollow_v1(path, 1):
        return Err("provisional output readback failed: " + path)
    Ok(digest)

fn _provisional_hello_run_v1(
    hello: {text: text}, target: text
) -> Result<text, text>:
    val evidence_paths = ["producer_path", "hello_source_path",
        "hello_executable_path", "stdout_path", "stderr_path",
        "compile_command_path", "compile_log_path"]
    val evidence_digests = ["producer_digest", "hello_source_digest",
        "hello_executable_digest", "stdout_digest", "stderr_digest",
        "compile_command_digest", "compile_log_digest"]
    for index in 0..evidence_paths.len():
        if not _provisional_artifact_v1(
                hello[evidence_paths[index]],
                hello[evidence_digests[index]]):
            return Err("provisional hello evidence path changed")
    val command = file_read_regular_no_follow_bounded(
        hello["compile_command_path"], 16384)?
    val _cache_root = native_group_provisional_hello_command_decode_v1(
        command, hello, target)?
    val _compile_log = file_read_regular_no_follow_bounded(
        hello["compile_log_path"], 16 * 1024 * 1024)?
    if not hello["hello_source_path"].ends_with(
            "/test/04_smoke/windows_native_hello.spl"):
        return Err("provisional hello source is not the pinned fixture")
    val source = file_read_regular_no_follow_bounded(
        hello["hello_source_path"], 4096)?
    if source != "fn main() -> i64:\n    print(\"windows native hello\")\n    return 0\n" and
            source != "fn main() -> i64:\r\n    print(\"windows native hello\")\r\n    return 0\r\n":
        return Err("provisional hello fixture content differs")
    val expected_stdout = file_read_regular_no_follow_bounded(
        hello["stdout_path"], 4096)?
    val expected_stderr = file_read_regular_no_follow_bounded(
        hello["stderr_path"], 4096)?
    if (expected_stdout != "windows native hello\n" and
            expected_stdout != "windows native hello\r\n") or
            expected_stderr != "":
        return Err("provisional hello output is not the pinned fixture")
    val (stdout, stderr, code) = process_run_bounded(
        hello["hello_executable_path"], [], 30000, 4096)
    if code != 0 or stdout != expected_stdout or
            stderr != expected_stderr:
        return Err("provisional pinned hello execution differs")
    for index in 0..evidence_paths.len():
        if not _provisional_artifact_v1(
                hello[evidence_paths[index]],
                hello[evidence_digests[index]]):
            return Err("provisional hello evidence changed after run")
    Ok(sha256_text(stdout))

fn native_group_provisional_build_v1(
    producer_path: text, checkout_root: text,
    source_snapshot_path: text, source_snapshot_digest: text,
    hello_receipt_path: text, hello_receipt_digest: text,
    output_root: text, target: text, receipt_path: text
) -> Result<NativeGroupProvisionalBuiltV1, text>:
    if not _provisional_plain_absolute_v1(producer_path) or
            not _provisional_plain_absolute_v1(checkout_root) or
            not _provisional_real_parent_v1(checkout_root) or
            not dir_is_real_no_follow(checkout_root) or
            not _provisional_plain_absolute_v1(source_snapshot_path) or
            not _provisional_plain_absolute_v1(hello_receipt_path) or
            not _provisional_real_parent_v1(output_root) or
            receipt_path != output_root + "/provisional-authority.receipt" or
            output_root.starts_with(checkout_root + "/") or
            checkout_root.starts_with(output_root + "/") or
            file_exists(output_root):
        return Err("provisional paths, ownership, or new output root invalid")
    if not builder_digest_valid_v1(source_snapshot_digest) or
            not _provisional_artifact_v1(
                source_snapshot_path, source_snapshot_digest) or
            not file_is_regular_no_follow(producer_path):
        return Err("provisional producer or full source snapshot unavailable")
    val producer_digest = file_hash_sha256(producer_path)
    if not builder_digest_valid_v1(producer_digest):
        return Err("provisional producer SHA unavailable")
    if not _provisional_artifact_v1(producer_path, producer_digest):
        return Err("provisional producer path changed")
    if not _provisional_artifact_v1(
            hello_receipt_path, hello_receipt_digest):
        return Err("provisional hello receipt path changed")
    val hello = native_group_provisional_hello_open_v1(
        hello_receipt_path, hello_receipt_digest)?
    if hello["producer_path"] != producer_path or
            hello["producer_digest"] != producer_digest or
            hello["source_snapshot_digest"] != source_snapshot_digest:
        return Err("provisional hello pins differ from producer/source")
    val _hello_output_digest = _provisional_hello_run_v1(hello, target)?
    val _phase3_llvm = native_group_index_variant_profile_v1(
        "phase3", "llvm", target, "release", "simple-v1")?
    val _phase3_cranelift = native_group_index_variant_profile_v1(
        "phase3", "cranelift", target, "release", "simple-v1")?
    val _phase4_llvm = native_group_index_variant_profile_v1(
        "phase4", "llvm", target, "release", "simple-v1")?
    val _phase4_cranelift = native_group_index_variant_profile_v1(
        "phase4", "cranelift", target, "release", "simple-v1")?
    if not dir_create_all(output_root) or
            not dir_is_real_no_follow(output_root):
        return Err("provisional private output root unavailable")
    val authority_bytes = file_read_regular_no_follow_bounded(
        source_snapshot_path, PHASE2_AUTHORITY_MAX_BYTES_V1)?
    if sha256_text(authority_bytes) != source_snapshot_digest:
        return Err("provisional full source authority changed")
    val authority_copy_path = output_root + "/source-inputs-before.txt"
    val authority_copy_digest = _provisional_publish_v1(
        authority_copy_path, authority_bytes)?
    if authority_copy_digest != source_snapshot_digest:
        return Err("provisional copied source authority differs")
    val copied = phase2_source_snapshot_publish_v1(
        checkout_root, authority_copy_path, authority_copy_digest,
        output_root + "/source-root")?
    val runtime_source = native_group_provisional_runtime_from_authority_v1(
        authority_bytes)?
    val runtime_path = output_root + "/runtime.snapshot"
    val runtime_digest = _provisional_publish_v1(
        runtime_path, runtime_source.payload)?
    if runtime_digest != runtime_source.digest:
        return Err("provisional runtime source snapshot publication differs")
    val _runtime_checked = native_group_provisional_runtime_verify_v1(
        authority_bytes, copied.source_root, runtime_path,
        runtime_digest, runtime_source.count)?
    val scv = phase2_native_scv_publish_v1(copied)?
    val module_content =
        scv.full_sources.source_identities.join("\n") + "\n"
    val module_path = output_root + "/module.inventory"
    val module_digest = _provisional_publish_v1(
        module_path, module_content)?
    val excluded_path = output_root + "/excluded-modules.inventory"
    val excluded_digest = _provisional_publish_v1(
        excluded_path, scv.module_selection.excluded_ledger)?
    val llvm_path = output_root + "/index-config-llvm.sdn"
    val llvm_digest = _provisional_publish_v1(llvm_path,
        native_group_index_config_encode_for_producer_v1(
            producer_path, producer_digest, copied, scv,
            authority_copy_path, "phase4", "llvm", target)?)?
    val cranelift_path = output_root + "/index-config-cranelift.sdn"
    val cranelift_digest = _provisional_publish_v1(cranelift_path,
        native_group_index_config_encode_for_producer_v1(
            producer_path, producer_digest, copied, scv,
            authority_copy_path, "phase4", "cranelift", target)?)?
    val phase3_llvm_path = output_root + "/index-config-phase3-llvm.sdn"
    val phase3_llvm_digest = _provisional_publish_v1(phase3_llvm_path,
        native_group_index_config_encode_for_producer_v1(
            producer_path, producer_digest, copied, scv,
            authority_copy_path, "phase3", "llvm", target)?)?
    val phase3_cranelift_path =
        output_root + "/index-config-phase3-cranelift.sdn"
    val phase3_cranelift_digest = _provisional_publish_v1(
        phase3_cranelift_path,
        native_group_index_config_encode_for_producer_v1(
            producer_path, producer_digest, copied, scv,
            authority_copy_path, "phase3", "cranelift", target)?)?
    var fields: {text: text} = {}
    fields["schema"] = PROVISIONAL_AUTHORITY_SCHEMA_V1
    fields["diagnostic_only"] = "1"
    fields["producer_source_relation"] = "unproven"
    fields["hello_source_relation"] = "outside_snapshot"
    fields["output_root"] = output_root
    fields["source_root"] = copied.source_root
    fields["target"] = target
    fields["producer_path"] = producer_path
    fields["producer_digest"] = producer_digest
    fields["source_snapshot_path"] = source_snapshot_path
    fields["source_snapshot_digest"] = source_snapshot_digest
    fields["source_authority_path"] = authority_copy_path
    fields["source_authority_digest"] = authority_copy_digest
    fields["runtime_snapshot_path"] = runtime_path
    fields["runtime_snapshot_digest"] = runtime_digest
    fields["runtime_snapshot_count"] = str(runtime_source.count)
    fields["hello_receipt_path"] = hello_receipt_path
    fields["hello_receipt_digest"] = hello_receipt_digest
    fields["hello_source_path"] = hello["hello_source_path"]
    fields["hello_source_digest"] = hello["hello_source_digest"]
    fields["hello_executable_path"] = hello["hello_executable_path"]
    fields["hello_executable_digest"] = hello["hello_executable_digest"]
    fields["hello_stdout_path"] = hello["stdout_path"]
    fields["hello_stdout_digest"] = hello["stdout_digest"]
    fields["hello_stderr_path"] = hello["stderr_path"]
    fields["hello_stderr_digest"] = hello["stderr_digest"]
    fields["hello_compile_command_path"] = hello["compile_command_path"]
    fields["hello_compile_command_digest"] = hello["compile_command_digest"]
    fields["hello_compile_log_path"] = hello["compile_log_path"]
    fields["hello_compile_log_digest"] = hello["compile_log_digest"]
    fields["hello_launcher_relation"] = hello["launcher_relation"]
    fields["source_inventory_path"] = copied.source_inventory_path
    fields["source_inventory_digest"] = copied.source_inventory_digest
    fields["source_inventory_count"] = str(copied.source_count)
    fields["full_source_inventory_path"] = copied.full_source_inventory_path
    fields["full_source_inventory_digest"] = copied.full_source_inventory_digest
    fields["full_source_inventory_count"] = str(copied.full_source_count)
    fields["full_source_links_path"] = copied.full_source_links_path
    fields["full_source_links_digest"] = copied.full_source_links_digest
    fields["full_source_links_count"] = str(copied.link_count)
    fields["module_inventory_path"] = module_path
    fields["module_inventory_digest"] = module_digest
    fields["module_inventory_count"] = str(scv.full_sources.source_count)
    fields["excluded_inventory_path"] = excluded_path
    fields["excluded_inventory_digest"] = excluded_digest
    fields["excluded_inventory_count"] = str(scv.module_selection.excluded_count)
    fields["module_role_policy_path"] = copied.source_root +
        "/src/package_ownership/native_module_roles.sdn"
    fields["module_role_policy_digest"] = scv.module_role_policy_digest
    fields["scv_snapshot_root"] = scv.snapshot.snapshot_root
    fields["scv_receipt_path"] = scv.snapshot.receipt_path
    fields["scv_receipt_digest"] = scv.scv_receipt_digest
    fields["scv_revision_id"] = scv.snapshot.revision_id
    fields["scv_commit_id"] = scv.snapshot.commit_id
    fields["scv_tree_id"] = scv.snapshot.tree_id
    fields["scv_snapshot_inventory_digest"] = scv.snapshot.inventory_digest
    fields["scv_source_inventory_digest"] = scv.source_inventory_digest
    fields["scv_source_inventory_generation"] =
        str(scv.source_inventory_generation)
    fields["package_policy_digest"] = scv.package_policy_digest
    fields["llvm_index_config_path"] = llvm_path
    fields["llvm_index_config_digest"] = llvm_digest
    fields["cranelift_index_config_path"] = cranelift_path
    fields["cranelift_index_config_digest"] = cranelift_digest
    fields["phase3_llvm_index_config_path"] = phase3_llvm_path
    fields["phase3_llvm_index_config_digest"] = phase3_llvm_digest
    fields["phase3_cranelift_index_config_path"] = phase3_cranelift_path
    fields["phase3_cranelift_index_config_digest"] = phase3_cranelift_digest
    val payload = native_group_provisional_authority_encode_v1(fields)?
    val receipt_digest = _provisional_publish_v1(receipt_path, payload)?
    val checked = native_group_provisional_verify_v1(
        receipt_path, receipt_digest, source_snapshot_path,
        hello_receipt_path)?
    if checked["module_inventory_count"] !=
            str(scv.full_sources.source_count):
        return Err("provisional receipt readback count differs")
    Ok(NativeGroupProvisionalBuiltV1(receipt_path, receipt_digest,
        scv.full_sources.source_count))

fn _provisional_ancestors_v1(root: text, relative: text) -> bool:
    if not dir_is_real_no_follow(root): return false
    val parts = relative.split("/")
    var parent = root
    for index in 0..parts.len() - 1:
        parent = parent + "/" + parts[index]
        if not dir_is_real_no_follow(parent): return false
    true

fn native_group_provisional_verify_v1(
    receipt_path: text, expected_digest: text,
    source_snapshot_path: text, hello_receipt_path: text
) -> Result<{text: text}, text>:
    val fields = native_group_provisional_authority_open_v1(
        receipt_path, expected_digest)?
    if not _provisional_real_parent_v1(fields["output_root"]) or
            not dir_is_real_no_follow(fields["output_root"]) or
            not _provisional_real_parent_v1(fields["source_root"]) or
            not dir_is_real_no_follow(fields["source_root"]) or
            not _provisional_real_parent_v1(
                fields["scv_snapshot_root"]) or
            not dir_is_real_no_follow(fields["scv_snapshot_root"]):
        return Err("provisional root ancestor is not a real directory")
    if source_snapshot_path != fields["source_snapshot_path"] or
            hello_receipt_path != fields["hello_receipt_path"]:
        return Err("provisional independent input paths differ")
    val hello = native_group_provisional_hello_open_v1(
        hello_receipt_path, fields["hello_receipt_digest"])?
    if not _provisional_artifact_v1(
            hello_receipt_path, fields["hello_receipt_digest"]):
        return Err("provisional hello receipt path changed")
    if hello["producer_path"] != fields["producer_path"] or
            hello["producer_digest"] != fields["producer_digest"] or
            hello["source_snapshot_digest"] !=
                fields["source_snapshot_digest"] or
            hello["hello_source_path"] != fields["hello_source_path"] or
            hello["hello_source_digest"] != fields["hello_source_digest"] or
            hello["hello_executable_path"] !=
                fields["hello_executable_path"] or
            hello["hello_executable_digest"] !=
                fields["hello_executable_digest"] or
            hello["stdout_path"] != fields["hello_stdout_path"] or
            hello["stdout_digest"] != fields["hello_stdout_digest"] or
            hello["stderr_path"] != fields["hello_stderr_path"] or
            hello["stderr_digest"] != fields["hello_stderr_digest"] or
            hello["compile_command_path"] !=
                fields["hello_compile_command_path"] or
            hello["compile_command_digest"] !=
                fields["hello_compile_command_digest"] or
            hello["compile_log_path"] !=
                fields["hello_compile_log_path"] or
            hello["compile_log_digest"] !=
                fields["hello_compile_log_digest"] or
            hello["launcher_relation"] !=
                fields["hello_launcher_relation"]:
        return Err("provisional hello binding differs")
    val _hello_output_digest = _provisional_hello_run_v1(
        hello, fields["target"])?
    val artifact_stems = ["producer", "source_snapshot",
        "source_authority", "runtime_snapshot", "hello_receipt", "hello_source",
        "hello_executable", "hello_stdout", "hello_stderr",
        "hello_compile_command", "hello_compile_log",
        "source_inventory", "full_source_inventory", "full_source_links",
        "module_inventory", "excluded_inventory", "module_role_policy",
        "scv_receipt", "llvm_index_config", "cranelift_index_config",
        "phase3_llvm_index_config", "phase3_cranelift_index_config"]
    for stem in artifact_stems:
        if not _provisional_artifact_v1(
                fields[stem + "_path"], fields[stem + "_digest"]):
            return Err("provisional artifact changed: " + stem)
    if not _provisional_artifact_v1(
            fields["scv_snapshot_root"] +
                "/src/package_ownership/simple.sdn",
            fields["package_policy_digest"]):
        return Err("provisional SCV package policy changed")
    val authority_bytes = file_read_regular_no_follow_bounded(
        fields["source_authority_path"], PHASE2_AUTHORITY_MAX_BYTES_V1)?
    if sha256_text(authority_bytes) !=
            fields["source_snapshot_digest"]:
        return Err("provisional full source snapshot differs")
    val records = phase2_source_authority_decode_v1(authority_bytes)?
    val _runtime_checked = native_group_provisional_runtime_verify_v1(
        authority_bytes, fields["source_root"],
        fields["runtime_snapshot_path"],
        fields["runtime_snapshot_digest"],
        fields["runtime_snapshot_count"].to_i64() ?? -1)?
    var src_paths: [text] = []
    var full_paths: [text] = []
    var links: [text] = []
    var link_count = 0
    var module_sources: [Phase2ModuleSourceV1] = []
    var role_policy_digest = ""
    for line in authority_bytes.split("\n"):
        if line.starts_with("link-hex:") or
                line.starts_with("link-dir-hex:"):
            links = links.push(line)
    for record in records:
        if not _provisional_ancestors_v1(
                fields["source_root"], record.relative_path):
            return Err("provisional frozen source ancestor changed")
        val path = fields["source_root"] + "/" + record.relative_path
        if record.kind == "file-hex":
            if not _provisional_artifact_v1(path, record.digest):
                return Err("provisional frozen source file changed")
            full_paths = full_paths.push(record.relative_path)
            if record.relative_path.starts_with("src/"):
                src_paths = src_paths.push(record.relative_path)
            if record.relative_path == PHASE2_MODULE_ROLE_POLICY_PATH_V1:
                role_policy_digest = record.digest
            if record.relative_path.starts_with("src/") and
                    record.relative_path.ends_with(".spl"):
                module_sources = module_sources.push(Phase2ModuleSourceV1(
                    record.relative_path, record.digest))
        else:
            val kind = if record.kind == "link-dir-hex": 2 else: 1
            if not snapshot_symlink_match_nofollow_v1(
                    fields["source_root"], path,
                    record.link_target, kind):
                return Err("provisional frozen source link changed")
            val resolved = fields["source_root"] +
                "/" + record.resolved_path
            if record.kind == "link-hex":
                if not _provisional_artifact_v1(resolved, record.digest):
                    return Err("provisional frozen link target changed")
            elif not dir_is_real_no_follow(resolved):
                return Err("provisional frozen directory link target changed")
            link_count = link_count + 1
    val source_inventory = canonical_identity_sort_texts(
        src_paths).join("\n") + "\n"
    val full_inventory = canonical_identity_sort_texts(
        full_paths).join("\n") + "\n"
    val link_inventory = if links.len() == 0: "" else:
        links.join("\n") + "\n"
    if str(src_paths.len()) != fields["source_inventory_count"] or
            str(full_paths.len()) != fields["full_source_inventory_count"] or
            str(link_count) != fields["full_source_links_count"] or
            sha256_text(source_inventory) !=
                fields["source_inventory_digest"] or
            sha256_text(full_inventory) !=
                fields["full_source_inventory_digest"] or
            sha256_text(link_inventory) !=
                fields["full_source_links_digest"]:
        return Err("provisional frozen source inventory differs")
    if role_policy_digest == "" or
            role_policy_digest != fields["module_role_policy_digest"]:
        return Err("provisional role policy differs from full authority")
    val role_policy = file_read_regular_no_follow_bounded(
        fields["module_role_policy_path"], 65536)?
    val selection = phase2_module_roles_select_v1(
        role_policy, module_sources)?
    if str(selection.included_paths.len()) !=
            fields["module_inventory_count"] or
            str(selection.excluded_count) !=
                fields["excluded_inventory_count"] or
            selection.included_paths.len() + selection.excluded_count !=
                module_sources.len() or
            sha256_text(selection.excluded_ledger) !=
                fields["excluded_inventory_digest"]:
        return Err("provisional module-role partition differs")
    val scv_sources = native_full_inventory_source_paths_v1(
        fields["source_root"], fields["scv_snapshot_root"],
        fields["scv_revision_id"], fields["scv_commit_id"],
        fields["scv_tree_id"],
        fields["scv_snapshot_inventory_digest"],
        fields["scv_source_inventory_digest"],
        fields["scv_receipt_digest"],
        fields["module_inventory_count"].to_i64() ?? -1)?
    val module_inventory =
        scv_sources.source_identities.join("\n") + "\n"
    if str(scv_sources.source_count) != fields["module_inventory_count"] or
            sha256_text(module_inventory) !=
                fields["module_inventory_digest"]:
        return Err("provisional full SCV inventory differs")
    for index in 0..scv_sources.source_count:
        val source = scv_sources.source_identities[index]
        if source != selection.included_paths[index] or
                not _provisional_artifact_v1(
                fields["source_root"] + "/" + source,
                scv_sources.source_digests[index]):
            return Err("provisional SCV member changed")
    val config_stems = ["llvm_index_config", "cranelift_index_config",
        "phase3_llvm_index_config", "phase3_cranelift_index_config"]
    for stem in config_stems:
        val config = native_group_index_config_decode_v1(
            file_read_regular_no_follow_bounded(
                fields[stem + "_path"], 65536)?)?
        val profile = native_group_index_variant_admit_v1(config)?
        val phase = if stem.starts_with("phase3_"): "phase3" else: "phase4"
        val backend = if stem.contains("cranelift"): "cranelift" else: "llvm"
        if config.phase != phase or config.backend != backend or
                config.target != fields["target"] or
                config.producer_path != fields["producer_path"] or
                config.producer_digest != fields["producer_digest"] or
                config.source_root != fields["source_root"] or
                config.snapshot_root != fields["scv_snapshot_root"] or
                config.scv_revision_id != fields["scv_revision_id"] or
                config.scv_commit_id != fields["scv_commit_id"] or
                config.scv_tree_id != fields["scv_tree_id"] or
                config.scv_receipt_path != fields["scv_receipt_path"] or
                config.scv_receipt_digest != fields["scv_receipt_digest"] or
                config.snapshot_inventory_digest !=
                    fields["scv_snapshot_inventory_digest"] or
                config.source_inventory_digest !=
                    fields["scv_source_inventory_digest"] or
                str(config.source_inventory_generation) !=
                    fields["scv_source_inventory_generation"] or
                str(config.expected_spl_count) !=
                    fields["module_inventory_count"] or
                config.full_source_authority_path !=
                    fields["source_authority_path"] or
                config.full_source_authority_digest !=
                    fields["source_authority_digest"] or
                profile.digest != config.variant_digest:
            return Err("provisional index config binding differs")
    Ok(fields)

fn native_group_provisional_field_v1(
    receipt_path: text, expected_digest: text, field: text
) -> Result<text, text>:
    # Scalar extraction is intentionally cheap. The caller must run the full
    # verify command before querying fields and again before dispatch.
    val fields = native_group_provisional_authority_open_v1(
        receipt_path, expected_digest)?
    val allowed = ["diagnostic_only", "producer_source_relation",
        "hello_source_relation", "producer_path", "producer_digest",
        "source_root", "target", "source_snapshot_path",
        "source_snapshot_digest", "source_authority_path",
        "source_authority_digest", "hello_receipt_path",
        "hello_receipt_digest", "source_inventory_path",
        "source_inventory_digest", "source_inventory_count",
        "full_source_inventory_path",
        "runtime_snapshot_path", "runtime_snapshot_digest",
        "runtime_snapshot_count",
        "full_source_inventory_digest", "full_source_inventory_count",
        "full_source_links_path", "full_source_links_digest",
        "full_source_links_count", "module_inventory_path",
        "module_inventory_digest", "module_inventory_count",
        "excluded_inventory_path", "excluded_inventory_digest",
        "excluded_inventory_count", "module_role_policy_path",
        "module_role_policy_digest", "scv_snapshot_root",
        "scv_receipt_path", "scv_receipt_digest", "scv_revision_id",
        "scv_commit_id", "scv_tree_id",
        "scv_snapshot_inventory_digest",
        "scv_source_inventory_digest",
        "scv_source_inventory_generation", "llvm_index_config_path",
        "llvm_index_config_digest", "cranelift_index_config_path",
        "cranelift_index_config_digest", "phase3_llvm_index_config_path",
        "phase3_llvm_index_config_digest",
        "phase3_cranelift_index_config_path",
        "phase3_cranelift_index_config_digest"]
    if not allowed.contains(field):
        return Err("provisional field unsupported")
    Ok(fields[field])

export NativeGroupProvisionalBuiltV1
export native_group_provisional_build_v1
export native_group_provisional_verify_v1
export native_group_provisional_field_v1
