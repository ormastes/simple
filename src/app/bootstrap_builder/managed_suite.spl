# Executed inside a generic manager worker's owned process tree. This entry
# captures actual Phase 4 tests; the parent verifies source authority around it.
use app.io.env_ops.{cwd, env_set}
use app.io.file_ops.{file_is_regular_no_follow, file_hash_sha256, file_atomic_write}
use app.io.dir_ops.{dir_create_all}
use app.io.process_ops.{process_run_bounded}
use std.common.build_manager.contracts.{builder_digest_valid_v1}
use std.common.crypto.sha256.{sha256_text}
use app.bootstrap_builder.managed_suite_environment.{managed_suite_environment_prepare_v1,
    managed_suite_environment_revalidate_v1}

fn managed_suite_count_v1(value: text) -> i64:
    if value == "" or value.len() > 9: return -1
    for digit in value:
        if not "0123456789".contains(digit): return -1
    value.to_int() ?? -1

pub fn managed_suite_summary_v1(output: text) -> Result<(i64, i64), text>:
    var found = 0
    var total: i64 = 0
    var failed: i64 = 0
    for raw in output.split("\n"):
        val line = raw.replace("\r", "")
        if not line.starts_with("Results:"): continue
        found = found + 1
        val columns = line.split(", ")
        # Canonical std.test_runner output emits suffixes only for nonzero
        # skipped/pending/crashed/terminated/not-run/cached counts. Any suffix
        # therefore makes this exact three-scenario acceptance incomplete.
        if columns.len() != 3: return Err("incomplete or nonterminal test Results")
        val first = columns[0].split(" ")
        val second = columns[1].split(" ")
        val third = columns[2].split(" ")
        if first.len() != 3 or first[0] != "Results:" or first[2] != "total" or
                second.len() != 2 or second[1] != "passed" or
                third.len() != 2 or third[1] != "failed": return Err("invalid test Results grammar")
        total = managed_suite_count_v1(first[1])
        val passed = managed_suite_count_v1(second[0])
        failed = managed_suite_count_v1(third[0])
        if total <= 0 or passed < 0 or failed < 0 or total != passed + failed:
            return Err("vacuous or inconsistent test Results")
    if found != 1: return Err("exactly one actual test Results required")
    Ok((total, failed))

fn managed_suite_pin_v1(path: text, digest: text) -> bool:
    builder_digest_valid_v1(digest) and file_is_regular_no_follow(path) and
        file_hash_sha256(path) == digest

pub fn managed_suite_main_v1(args: [text]) -> i64:
    # --managed-suite SUITE BACKEND SOURCE CLI CLI_SHA INTERPRETER INTERPRETER_SHA
    # AUTHORITY AUTHORITY_SHA OUTPUT RUNTIME RUNTIME_SNAPSHOT RUNTIME_SHA TOOLS TOOLS_SHA.
    if args.len() != 16 or args[0] != "--managed-suite" or
            args[10] != "suite/result.env": return 2
    val suite = args[1]
    val backend = args[2]
    if suite != "compiler" and suite != "loader" and suite != "interpreter": return 2
    if backend != "llvm" and backend != "cranelift": return 2
    val source = args[3]
    val cli = args[4]
    val interpreter = args[6]
    if not managed_suite_pin_v1(cli, args[5]) or
            not managed_suite_pin_v1(interpreter, args[7]) or
            not managed_suite_pin_v1(args[8], args[9]) or
            not managed_suite_pin_v1(args[12], args[13]) or
            not managed_suite_pin_v1(args[14], args[15]): return 2
    val spec = source + "/test/03_system/app/bootstrap_builder/feature/phase4_" + suite + "_acceptance_spec.spl"
    if not file_is_regular_no_follow(spec): return 2
    val spec_sha = file_hash_sha256(spec)
    val evidence = cwd().replace("\\", "/") + "/suite"
    if not dir_create_all(evidence): return 2
    if not file_atomic_write(evidence + "/invocations.log", ""): return 2
    val environment = [
        ("SIMPLE_BINARY", cli), ("SIMPLE_LIB", source + "/src"),
        ("SIMPLE_NO_STUB_FALLBACK", "1"), ("NO_COLOR", "1"),
        ("SIMPLE_BOOTSTRAP", ""), ("SIMPLE_NATIVE_BUILD_RUST", "0"),
        ("SIMPLE_RUNTIME_PATH", args[11]), ("SIMPLE_NATIVE_RUNTIME_BUNDLE", "core-c-bootstrap"),
        ("SIMPLE_MANAGED_PHASE4_CLI", cli),
        ("SIMPLE_MANAGED_PHASE4_CLI_SHA256", args[5]),
        ("SIMPLE_MANAGED_PHASE4_INTERPRETER", interpreter),
        ("SIMPLE_MANAGED_PHASE4_INTERPRETER_SHA256", args[7]),
        ("SIMPLE_MANAGED_PHASE4_BACKEND", backend),
        ("SIMPLE_MANAGED_PHASE4_SOURCE_ROOT", source),
        ("SIMPLE_MANAGED_PHASE4_FIXTURE_ROOT", source + "/test/fixtures/bootstrap_builder/phase4_acceptance"),
        ("SIMPLE_MANAGED_PHASE4_EVIDENCE_ROOT", evidence),
        ("SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_PATH", args[8]),
        ("SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_SHA256", args[9])]
    for pair in environment:
        if not env_set(pair.0, pair.1): return 2
    val environment_binding = match managed_suite_environment_prepare_v1(
            backend, source, args[8], args[9], args[11], args[12], args[13], args[14], args[15]):
        Ok(binding): binding
        Err(reason):
            print "managed suite environment: {reason}"
            return 2
    val command = ["test", spec, "--mode=interpreter", "--sequential", "--no-cache"]
    val (stdout, stderr, code) = process_run_bounded(cli, command, 1800000, 8388608)
    if not file_atomic_write(evidence + "/stdout.log", stdout) or
            not file_atomic_write(evidence + "/stderr.log", stderr): return 2
    match managed_suite_environment_revalidate_v1(environment_binding):
        Ok(_): pass
        Err(reason):
            print "managed suite environment changed: {reason}"
            return 2
    if not managed_suite_pin_v1(cli, args[5]) or
            not managed_suite_pin_v1(interpreter, args[7]) or
            not managed_suite_pin_v1(args[8], args[9]) or
            not managed_suite_pin_v1(args[12], args[13]) or
            not managed_suite_pin_v1(args[14], args[15]) or
            not managed_suite_pin_v1(spec, spec_sha): return 2
    val (total, failed) = match managed_suite_summary_v1(stdout):
        Ok(counts): counts
        Err(reason):
            print "managed suite: {reason}"
            return 2
    # Each frozen acceptance spec contains exactly three required scenarios.
    if total != 3: return 2
    if (code == 0 and failed != 0) or (code == 1 and failed == 0) or
            (code != 0 and code != 1): return 2
    val receipt = "format=SIMPLE-MANAGED-PHASE4-SUITE-1\n" +
        "suite={suite}\nbackend={backend}\nstatus={if code == 0: "PASS" else: "FAIL"}\n" +
        "expected=3\ntotal={total}\npassed={total - failed}\nfailed={failed}\nexit_code={code}\n" +
        "cli_sha256={args[5]}\ninterpreter_sha256={args[7]}\nspec_sha256={spec_sha}\n" +
        "source_authority_sha256={args[9]}\nruntime_snapshot_sha256={args[13]}\n" +
        "tool_authority_sha256={args[15]}\n" +
        "environment_identity={environment_binding.identity}\n" +
        "stdout_sha256=" + sha256_text(stdout) + "\nstderr_sha256=" + sha256_text(stderr) + "\n" +
        "invocations_sha256=" + file_hash_sha256(evidence + "/invocations.log") + "\n"
    if not file_atomic_write(args[10], receipt): return 2
    code
