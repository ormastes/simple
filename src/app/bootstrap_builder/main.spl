# Compatibility entrypoint and exports for existing bootstrap receipts/callers.
use app.buildrunner.cli.{build_runner_cli_main_v1}
use app.bootstrap_builder.process_port.{builder_process_portable_v1}
export use app.buildrunner.cli.{build_runner_cli_main_v1 as builder_cli_main_v1,
    build_runner_verify_settled_v1 as builder_cli_verify_settled_v1}

fn main() -> i64:
    build_runner_cli_main_v1(builder_process_portable_v1())
