# Compatibility facade over the compiler-owned exact full-inventory profile.
# Existing callers retain names/result while semantic admission shares one owner.
use app.bootstrap_builder.native_group_index_contract.{NativeGroupIndexConfigV1}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.driver.cache.package_tldr_metadata.{ConfigVariantKeyV1}
use compiler.driver.cache.native_full_index_variant_v1.{
    native_full_index_variant_target_v1, native_full_index_target_build_mode_v1,
    native_full_index_variant_profile_v1, native_full_index_variant_admit_v1}

struct NativeGroupIndexVariantOptionsV1:
    options: CompileOptions
    variant: ConfigVariantKeyV1
    digest: text

fn native_group_index_variant_target_v1(target: text) -> bool:
    native_full_index_variant_target_v1(target)

fn native_group_target_build_mode_v1(phase: text) -> Result<text, text>:
    native_full_index_target_build_mode_v1(phase)

fn native_group_index_variant_profile_v1(phase: text, backend: text,
        target: text, build_mode: text, language_abi: text
        ) -> Result<NativeGroupIndexVariantOptionsV1, text>:
    val derived = native_full_index_variant_profile_v1(
        phase, backend, target, build_mode, language_abi)?
    Ok(NativeGroupIndexVariantOptionsV1(derived.options, derived.variant, derived.digest))

fn native_group_index_variant_admit_v1(config: NativeGroupIndexConfigV1
        ) -> Result<NativeGroupIndexVariantOptionsV1, text>:
    if config.backend != config.variant.backend or
            config.target != config.variant.target_triple:
        return Err("index supplied variant does not match typed CompileOptions")
    val derived = native_full_index_variant_admit_v1(config.phase, config.variant)?
    if config.variant_digest != derived.digest:
        return Err("index supplied variant does not match typed CompileOptions")
    Ok(NativeGroupIndexVariantOptionsV1(derived.options, derived.variant, derived.digest))

export NativeGroupIndexVariantOptionsV1
export native_group_index_variant_target_v1, native_group_index_variant_profile_v1
export native_group_index_variant_admit_v1
export native_group_target_build_mode_v1
