# Windows-only composition, deliberately absent from the portable entry closure.
use app.bootstrap_builder.process_port.{BuilderProcessPortV1}
use app.io.process_ops.{_resolve_process_cmd}
use app.io.file_ops.{file_hash_sha256, file_is_regular_no_follow}
use std.nogc_sync_mut.io.windows_worker_launcher.{windows_worker_spawn_v1, windows_worker_wait_v1, windows_worker_terminate_v1}
use std.nogc_sync_mut.io.windows_process_owner.{windows_process_directory_no_follow_v1}

fn builder_windows_spawn_v1(program: text, digest: text, args: [text], directory: text) -> Result<i64, text>:
    val resolved = _resolve_process_cmd(program)
    if not file_is_regular_no_follow(resolved): return Err("worker executable is not a regular file")
    var expected = digest
    # SSH client selection retains the existing trusted local PATH authority;
    # remote worker images separately require the manifest's worker_digest.
    if expected == "": expected = file_hash_sha256(resolved)
    windows_worker_spawn_v1(resolved, expected, args, directory)

fn builder_process_windows_v1() -> BuilderProcessPortV1:
    BuilderProcessPortV1(spawn_operation: builder_windows_spawn_v1, wait_operation: windows_worker_wait_v1, terminate_operation: windows_worker_terminate_v1, directory_no_follow_operation: windows_process_directory_no_follow_v1)

export builder_process_windows_v1
