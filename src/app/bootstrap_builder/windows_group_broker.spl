# Independent compiled broker retains the parser's JobObject across parent
# manager crashes. Only this process can publish post-collect tree evidence.
use app.io.args_ops.{get_args}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_lock, file_unlock, file_exists}
use app.io.time_ops.{sleep_ms, current_time_ms}
use std.common.build_manager.group_process_protocol.{GroupProcessLaunchV1, GroupProcessPollV1, group_process_launch_decode_v1, group_process_identity_v1, group_process_observation_encode_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.nogc_sync_mut.io.windows_process_owner.{WindowsProcessInputV1, WindowsProcessRequestV1, WindowsProcessLeaseV1, WindowsProcessPollV1, windows_process_start_with_memory_v1, windows_process_peak_memory_v1, windows_process_poll_v1, windows_process_cancel_v1, windows_process_collect_v1, windows_process_path_valid_v1, windows_process_file_digest_v1}

fn _group_broker_observation_v1(observed: WindowsProcessPollV1, peak: i64) -> GroupProcessPollV1:
    GroupProcessPollV1(observed.terminal, observed.leader_reaped, observed.tree_empty,
        observed.active_processes, observed.exit_code, observed.timed_out, observed.cancelled, peak)

fn _group_broker_control_v1(root: text, identity: text) -> text:
    val request = match file_read_regular_no_follow_bounded(root + "/broker.control.request", 4096):
        Ok(value): value
        Err(_message): return ""
    val parts = request.split("\n")
    if parts.len() != 3 or parts[0] != identity or not builder_identifier_valid_v1(parts[1]): return ""
    if parts[2] != "probe" and parts[2] != "cancel": return ""
    request

fn _group_broker_finish_v1(root: text, identity: text, lease: WindowsProcessLeaseV1, peak: i64) -> Result<bool, text>:
    val receipt = windows_process_collect_v1(lease)?
    if not receipt.terminal or not receipt.leader_reaped or not receipt.tree_empty: return Err("native group tree cleanup not proven")
    val payload = group_process_observation_encode_v1(identity, _group_broker_observation_v1(receipt, peak))
    # Atomic publication follows native collect; per-action success never enters
    # this path. A crash in this gap remains unknown and cannot authorize retry.
    if not file_atomic_write(root + "/broker.tree.sdn", payload): return Err("cannot persist group tree cleanup receipt")
    Ok(true)

fn _group_broker_drain_v1(root: text, identity: text, lease: WindowsProcessLeaseV1) -> Result<bool, text>:
    val _cancelled = windows_process_cancel_v1(lease)?
    val deadline = current_time_ms() + 30000
    while current_time_ms() < deadline:
        val observed = windows_process_poll_v1(lease)?
        if observed.terminal:
            val peak = windows_process_peak_memory_v1(lease)?
            return _group_broker_finish_v1(root, identity, lease, peak)
        sleep_ms(10)
    Err("group cancellation tree cleanup remains unproven")

fn _group_broker_run_v1(launch: GroupProcessLaunchV1, identity: text) -> Result<bool, text>:
    val request = launch.request
    if windows_process_file_digest_v1(request.broker_program) != request.broker_digest: return Err("broker image differs from configured digest")
    var inputs: [WindowsProcessInputV1] = []
    # Bind the startup envelope itself for the complete worker lifetime.
    inputs = inputs.push(WindowsProcessInputV1(launch.root + "/broker.request.sdn", identity))
    for input in request.inputs: inputs = inputs.push(WindowsProcessInputV1(input.path, input.digest))
    val native = WindowsProcessRequestV1(request.program, request.producer_digest, request.args,
        request.environment, request.directory, inputs, request.stdout_path, request.stderr_path, request.timeout_ms)
    val lease = windows_process_start_with_memory_v1(native, launch.memory_limit_bytes)?
    var last_control = ""
    var error = ""
    while error == "":
        val control = _group_broker_control_v1(launch.root, identity)
        if control != "" and control != last_control:
            if control.ends_with("\ncancel"):
                match windows_process_cancel_v1(lease):
                    Ok(_value): pass
                    Err(message):
                        error = message
                        break
        val observed = match windows_process_poll_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val peak = match windows_process_peak_memory_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        if observed.terminal: return _group_broker_finish_v1(launch.root, identity, lease, peak)
        if control != "" and control != last_control:
            val payload = group_process_observation_encode_v1(identity, _group_broker_observation_v1(observed, peak))
            if not file_atomic_write(launch.root + "/broker.control.response", control + "\n" + payload):
                error = "cannot publish fresh broker observation"
                break
            last_control = control
        sleep_ms(10)
    val cleanup = _group_broker_drain_v1(launch.root, identity, lease)
    match cleanup:
        Ok(_value): Err(error)
        Err(message): Err(error + "; " + message)

fn main() -> i64:
    val args = get_args()
    if args.len() != 5 or args[1] != "--broker-root" or args[3] != "--request-digest": return 2
    val root = args[2]
    val identity = args[4]
    if not windows_process_path_valid_v1(root) or not builder_digest_valid_v1(identity): return 2
    val payload = match file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216):
        Ok(value): value
        Err(_message): return 2
    val launch = match group_process_launch_decode_v1(payload):
        Ok(value): value
        Err(_message): return 2
    if launch.root != root or group_process_identity_v1(launch) != identity: return 2
    val lock = file_lock(root + "/broker.lock", 0)
    if lock < 0: return 3
    # Re-launching a crashed broker could create a second tree without proof of
    # the first one's cleanup. Only a new generation/root may start another.
    if file_exists(root + "/broker.started"):
        val _unlocked = file_unlock(lock)
        return 3
    if not file_atomic_write(root + "/broker.started", identity):
        val _unlocked = file_unlock(lock)
        return 3
    val result = _group_broker_run_v1(launch, identity)
    val _unlocked = file_unlock(lock)
    match result:
        Ok(_value): 0
        Err(message):
            val _written = file_atomic_write(root + "/broker.error", message)
            print "group broker: {message}"
            1
