# Exact compiler-owned marker; quoted parser traces and ordinary mentions are
# not authority failures. This keeps public CLI exit codes independent of the
# manager's distinction between source errors and owner/admission aborts.
pub fn builder_compiler_admission_diagnostic_v1(output: text) -> bool:
    for raw in output.split("\n"):
        var line = raw
        if line.ends_with("\r"):
            line = line.substring(0, line.len() - 1)
        if line.starts_with("error: "):
            line = line.substring(7)
        if line == "SCV-E-ADMISSION:" or line.starts_with("SCV-E-ADMISSION: ") or line.starts_with("SCV-E-ADMISSION:\t"):
            return true
    false
