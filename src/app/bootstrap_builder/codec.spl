@allow(star_import) # reason: pure shared wire owner plus app persistence adapter
export use std.common.build_manager.codec.*
use std.common.build_manager.contracts.{BuildTaskV1, BuildRunV1, BuildResultV1}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write}

fn builder_read_task_v1(path: text) -> Result<BuildTaskV1, text>:
    val payload = file_read_regular_no_follow_bounded(path, 16777216)?
    builder_decode_task_v1(payload)

fn builder_read_run_v1(path: text) -> Result<BuildRunV1, text>:
    val payload = file_read_regular_no_follow_bounded(path, 16777216)?
    builder_decode_run_v1(payload)

fn builder_read_result_v1(path: text) -> Result<BuildResultV1, text>:
    val payload = file_read_regular_no_follow_bounded(path, 16777216)?
    builder_decode_result_v1(payload)

fn builder_write_task_v1(path: text, task: BuildTaskV1) -> bool:
    val payload = builder_encode_task_v1(task)
    payload != "" and file_atomic_write(path, payload)

fn builder_write_run_v1(path: text, run: BuildRunV1) -> bool:
    val payload = builder_encode_run_v1(run)
    payload != "" and file_atomic_write(path, payload)

fn builder_write_result_v1(path: text, result: BuildResultV1) -> bool:
    val payload = builder_encode_result_v1(result)
    payload != "" and file_atomic_write(path, payload)
