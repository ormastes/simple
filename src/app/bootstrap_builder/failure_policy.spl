use std.common.task_runner.contracts.{task_runner_native_exception_v1}
# Exit 1 is a continuation signal only after a real compiler tree was reaped.
# Confirmed reaped crashes permit bounded recovery. Admission, cancellation,
# timeout and unknown exits remain distinct from an ordinary compiler failure.
pub fn builder_failure_class_v1(status: text, exit_code: i64,
        compiler_reaped: bool) -> text:
    if not compiler_reaped: return "infrastructure-abort"
    if status == "OK" and exit_code == 0: return "complete"
    if status == "ERROR" and exit_code == 1: return "compile-failure"
    if status == "CRASHED" and ((exit_code >= 129 and exit_code <= 192) or
            task_runner_native_exception_v1(exit_code)): return "compiler-crash"
    "infrastructure-abort"
