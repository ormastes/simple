# Narrow scalar projection for shell orchestration. No generic SDN reflection:
# every exported field is a pin needed to author the grouped prepare config.
use app.bootstrap_builder.native_group_index_handoff.{NativeGroupIndexHandoffV1,
    native_group_index_handoff_read_v1}

fn native_group_index_handoff_field_from_value_v1(
        handoff: NativeGroupIndexHandoffV1, field: text) -> Result<text, text>:
    match field:
        case "phase": Ok(handoff.phase)
        case "backend": Ok(handoff.backend)
        case "source_count": Ok(str(handoff.source_count))
        case "index_read_root": Ok(handoff.index_read_root)
        case "index_digest": Ok(handoff.index_digest)
        case "variant_receipt_path": Ok(handoff.variant_receipt_path)
        case "variant_receipt_digest": Ok(handoff.variant_receipt_digest)
        case "runtime_std_authority_path": Ok(handoff.runtime_std_authority_path)
        case "runtime_std_authority_digest": Ok(handoff.runtime_std_authority_digest)
        case _: Err("index handoff field is not exported")

fn native_group_index_handoff_field_v1(path: text, digest: text,
        field: text) -> Result<text, text>:
    val handoff = native_group_index_handoff_read_v1(path, digest)?
    native_group_index_handoff_field_from_value_v1(handoff, field)

export native_group_index_handoff_field_from_value_v1
export native_group_index_handoff_field_v1
