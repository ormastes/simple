# Separate image built by the admitted Phase2 compiler. The build command
# emits a provisional digest; verify requires fresh canonical Stage2 replay.
use app.io.args_ops.{get_args}
use app.bootstrap_builder.native_group_phase2_authority.{
    phase2_native_authority_build_v1
}
use app.bootstrap_builder.native_group_phase2_receipt.{
    phase2_native_authority_field_v1
}
use app.bootstrap_builder.native_group_phase2_verify.{
    phase2_native_authority_verify_v1
}
use std.nogc_sync_mut.io.process_ops.{eprint}

fn native_group_phase2_main_v1() -> i64:
    val args = get_args()
    if (args.len() == 12 or args.len() == 14) and
            args[1] == "phase2-native-authority" and
            args[2] == "--producer-receipt" and
            args[4] == "--source-checkout" and
            args[6] == "--output-root" and
            args[8] == "--target" and args[10] == "--receipt" and
            (args.len() == 12 or args[12] == "--canonical-snapshot"):
        val canonical = if args.len() == 14: args[13] else: ""
        match phase2_native_authority_build_v1(args[3], args[5], args[7],
                args[9], args[11], canonical):
            Ok(built):
                print built.receipt_digest
                return 0
            Err(reason):
                eprint("phase2 native authority: " + reason)
                return 2
    if args.len() == 8 and
            args[1] == "phase2-native-authority-verify" and
            args[2] == "--receipt" and args[4] == "--digest" and
            args[6] == "--canonical-snapshot":
        match phase2_native_authority_verify_v1(
                args[3], args[5], args[7]):
            Ok(_):
                print args[5]
                return 0
            Err(reason):
                eprint("phase2 native authority verify: " + reason)
                return 2
    if args.len() == 8 and
            args[1] == "phase2-native-authority-field" and
            args[2] == "--receipt" and args[4] == "--digest" and
            args[6] == "--field":
        match phase2_native_authority_field_v1(
                args[3], args[5], args[7]):
            Ok(value):
                print value
                return 0
            Err(reason):
                eprint("phase2 native authority field: " + reason)
                return 2
    eprint("usage: phase2-native-authority phase2-native-authority --producer-receipt ABS --source-checkout ABS --output-root ABS --target TRIPLE --receipt ABS [--canonical-snapshot ABS] | phase2-native-authority-verify --receipt ABS --digest SHA --canonical-snapshot ABS | phase2-native-authority-field --receipt ABS --digest SHA --field NAME")
    2

fn main() -> i64:
    native_group_phase2_main_v1()

export native_group_phase2_main_v1
