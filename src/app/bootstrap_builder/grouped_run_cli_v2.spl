# Closed production pin grammar. Values originate at the trusted invoking
# boundary; the manifest and qualification receipt cannot supply defaults.
use std.common.build_manager.grouped_native_contract.{native_group_absolute_path_valid_v1}
use std.common.build_manager.contracts.{builder_digest_valid_v1, builder_identifier_valid_v1}
use compiler.driver.driver_build.managed_parse_compatibility.{managed_parse_frontend_identity_decode_v2}

fn grouped_run_cli_pins_v2(args: [text]) -> Result<[text], text>:
    val names = ["--manifest", "--receipt", "--receipt-digest", "--issuer-digest", "--worker",
        "--worker-digest", "--frontend-identity", "--target", "--target-os", "--target-arch", "--target-cpu"]
    if args.len() != 24 or args[1] != "grouped-run-v2": return Err("V2 requires all eleven independent named arguments")
    var values: [text] = ["", "", "", "", "", "", "", "", "", "", ""]
    var cursor = 2
    while cursor < args.len():
        var matched = false
        for index in 0..names.len():
            if args[cursor] == names[index]:
                if values[index] != "" or args[cursor + 1] == "": return Err("duplicate or empty V2 argument")
                values[index] = args[cursor + 1]
                matched = true
        if not matched: return Err("unknown V2 argument")
        cursor = cursor + 2
    for value in values:
        if value == "": return Err("missing V2 argument")
    for index in [0, 1, 4]:
        if not native_group_absolute_path_valid_v1(values[index]): return Err("V2 path must be absolute")
    for index in [2, 3, 5]:
        if not builder_digest_valid_v1(values[index]): return Err("invalid independent V2 digest")
    for index in [7, 8, 9, 10]:
        if not builder_identifier_valid_v1(values[index]): return Err("invalid independent V2 target")
    val _identity = managed_parse_frontend_identity_decode_v2(values[6])?
    Ok(values)

export grouped_run_cli_pins_v2
