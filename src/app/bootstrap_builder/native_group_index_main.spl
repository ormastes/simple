use app.bootstrap_builder.native_diagnostic_worker.{native_diagnostic_build_managed_v1, native_diagnostic_verify_v1}
# Separate compiled index-builder image. A successful receipt is impossible
# until the compiler exposes a verified full-inventory V2 cold producer.
use app.io.args_ops.{get_args}
use app.bootstrap_builder.native_group_index_build.{native_group_index_build_managed_v1}
use app.bootstrap_builder.native_group_index_verify.{native_group_index_verify_v1}
use app.bootstrap_builder.native_group_index_handoff_field.{native_group_index_handoff_field_v1}
use std.nogc_sync_mut.io.process_ops.{eprint}

fn native_group_index_main_v1() -> i64:
    val args = get_args()
    if args.len() == 10 and args[1] == "native-groups-diagnostic-verify" and
            args[2] == "--config" and args[4] == "--receipt" and
            args[6] == "--partition" and args[8] == "--partitions":
        match native_diagnostic_verify_v1(args[3], args[5], args[7].to_i64() ?? -1, args[9].to_i64() ?? 0):
            Ok(receipt):
                print "diagnostic SMF attempted={receipt.attempted} compiled={receipt.compiled} failed={receipt.failed}; native package unqualified"
                return 0
            Err(reason):
                eprint("diagnostic SMF summary refused: {reason}")
                return 2
    if args.len() == 11 and args[1] == "native-groups-diagnostic-build" and
            args[2] == "--manager-work" and args[3] == "--config" and
            args[5] == "--partition" and args[7] == "--partitions" and args[9] == "--receipt":
        val partition = args[6].to_i64() ?? -1
        val partitions = args[8].to_i64() ?? 0
        if partition < 0 or partition >= partitions or partitions > 80: return 2
        match native_diagnostic_build_managed_v1(args[4], partition, partitions, args[10]):
            Ok(_):
                print "diagnostic SMF partition complete; not native-package qualification"
                return 0
            Err(reason):
                eprint("diagnostic SMF partition refused: {reason}")
                return 2
    if args.len() == 7 and args[1] == "native-groups-index-build" and
            args[2] == "--manager-work" and args[3] == "--config" and
            args[5] == "--receipt":
        match native_group_index_build_managed_v1(args[4], args[6]):
            Ok(receipt):
                print "native groups index: V2 modules={receipt.source_count} index={receipt.index_digest}"
                return 0
            Err(reason):
                print "native groups index: {reason}"
                return 2
    if args.len() == 8 and args[1] == "native-groups-index-verify" and
            args[2] == "--config" and args[4] == "--receipt" and
            args[6] == "--handoff":
        match native_group_index_verify_v1(args[3], args[5], args[7]):
            Ok(handoff):
                print "native groups index verified: V2 modules={handoff.source_count} index={handoff.index_digest}"
                return 0
            Err(reason):
                print "native groups index verify: {reason}"
                return 2
    if args.len() == 8 and args[1] == "native-groups-index-handoff-field" and
            args[2] == "--handoff" and args[4] == "--digest" and
            args[6] == "--field":
        match native_group_index_handoff_field_v1(args[3], args[5], args[7]):
            Ok(value):
                print value
                return 0
            Err(reason):
                eprint("native groups index handoff field: {reason}")
                return 2
    print "usage: grouped-native-index native-groups-index-build --manager-work --config RELATIVE --receipt @WORK@/RELATIVE | native-groups-index-verify --config ABS --receipt ABS --handoff ABS | native-groups-index-handoff-field --handoff ABS --digest SHA --field NAME"
    2

fn main() -> i64:
    native_group_index_main_v1()

export native_group_index_main_v1
