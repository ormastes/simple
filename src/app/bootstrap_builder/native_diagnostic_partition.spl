# Diagnostic coverage is distinct from index, native-package and loader success.
# A receipt names one actual in-process driver invocation in an owned epoch.
use std.common.crypto.sha256.{sha256_text}
use std.common.build_manager.contracts.{builder_digest_valid_v1,
    builder_relative_path_valid_v1}
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}

struct NativeDiagnosticEntryResultV1:
    epoch_digest: text
    source_identity: text
    source_digest: text
    status: text
    artifact_digest: text
    diagnostic_digest: text

fn native_diagnostic_partition_member_v1(index: i64, count: i64,
        partition: i64, partitions: i64) -> bool:
    count > 0 and count <= 20000 and index >= 0 and index < count and
        partitions > 0 and partitions <= 64 and partition >= 0 and
        partition < partitions and index % partitions == partition

fn native_diagnostic_epoch_digest_v1(config_digest: text, runtime_digest: text,
        tools_digest: text, backend: text, partition: i64, partitions: i64) -> text:
    if not builder_digest_valid_v1(config_digest) or
            not builder_digest_valid_v1(runtime_digest) or
            not builder_digest_valid_v1(tools_digest) or
            (backend != "llvm" and backend != "cranelift") or
            partitions < 1 or partitions > 64 or partition < 0 or partition >= partitions:
        return ""
    sha256_text("diagnostic-smf-v1|" + config_digest + "|" + runtime_digest +
        "|" + tools_digest + "|" + backend + "|" + str(partition) + "|" + str(partitions))

fn native_diagnostic_entry_encode_v1(value: NativeDiagnosticEntryResultV1) -> text:
    if not builder_digest_valid_v1(value.epoch_digest) or
            not builder_digest_valid_v1(value.source_digest) or
            not builder_relative_path_valid_v1(value.source_identity): return ""
    if value.status == "compiled":
        if not builder_digest_valid_v1(value.artifact_digest) or value.diagnostic_digest != "": return ""
    elif value.status == "compiler-failed":
        if value.artifact_digest != "" or not builder_digest_valid_v1(value.diagnostic_digest): return ""
    else: return ""
    var result = "SIMPLE-DIAGNOSTIC-SMF-ENTRY-1\n"
    for field in [value.epoch_digest, value.source_identity, value.source_digest,
            value.status, value.artifact_digest, value.diagnostic_digest]:
        result = result + builder_wire_line_v1(field)
    result

fn native_diagnostic_entry_decode_v1(payload: text) -> Result<NativeDiagnosticEntryResultV1, text>:
    if payload.len() < 1 or payload.len() > 16384: return Err("diagnostic entry size invalid")
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-DIAGNOSTIC-SMF-ENTRY-1": return Err("diagnostic entry schema invalid")
    val value = NativeDiagnosticEntryResultV1(reader.scalar(), reader.scalar(),
        reader.scalar(), reader.scalar(), reader.scalar(), reader.scalar())
    if reader.complete_error() != "" or native_diagnostic_entry_encode_v1(value) != payload:
        return Err("diagnostic entry framing invalid")
    Ok(value)

fn native_diagnostic_entry_matches_v1(value: NativeDiagnosticEntryResultV1,
        epoch: text, identity: text, digest: text) -> bool:
    native_diagnostic_entry_encode_v1(value) != "" and value.epoch_digest == epoch and
        value.source_identity == identity and value.source_digest == digest

export NativeDiagnosticEntryResultV1
export native_diagnostic_partition_member_v1, native_diagnostic_epoch_digest_v1
export native_diagnostic_entry_encode_v1, native_diagnostic_entry_decode_v1
export native_diagnostic_entry_matches_v1
struct NativeDiagnosticSummaryV1:
    config_digest: text
    request_digest: text
    epoch_digest: text
    inventory_digest: text
    phase: text
    backend: text
    partition: i64
    partitions: i64
    source_count: i64
    attempted: i64
    compiled: i64
    failed: i64
    expected_digest: text
    ledger_digest: text

fn native_diagnostic_summary_encode_v1(value: NativeDiagnosticSummaryV1) -> text:
    for digest in [value.config_digest, value.request_digest, value.epoch_digest,
            value.inventory_digest, value.expected_digest, value.ledger_digest]:
        if not builder_digest_valid_v1(digest): return ""
    if (value.phase != "phase3" and value.phase != "phase4") or
            (value.backend != "llvm" and value.backend != "cranelift") or
            value.source_count < 1 or value.source_count > 20000 or
            value.partitions < 1 or value.partitions > 64 or
            value.partition < 0 or value.partition >= value.partitions: return ""
    val expected = if value.partition >= value.source_count: 0 else:
        (value.source_count - 1 - value.partition) / value.partitions + 1
    if value.attempted != expected or value.compiled < 0 or value.failed < 0 or
            value.compiled + value.failed != value.attempted: return ""
    var payload = "SIMPLE-DIAGNOSTIC-SMF-PARTITION-1\n"
    for field in [value.config_digest, value.request_digest, value.epoch_digest,
            value.inventory_digest, value.phase, value.backend, str(value.partition),
            str(value.partitions), str(value.source_count), str(value.attempted),
            str(value.compiled), str(value.failed), value.expected_digest, value.ledger_digest]:
        payload = payload + builder_wire_line_v1(field)
    payload

fn native_diagnostic_summary_decode_v1(payload: text) -> Result<NativeDiagnosticSummaryV1, text>:
    if payload.len() < 1 or payload.len() > 16384: return Err("diagnostic summary size invalid")
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-DIAGNOSTIC-SMF-PARTITION-1": return Err("diagnostic summary schema invalid")
    val value = NativeDiagnosticSummaryV1(reader.scalar(), reader.scalar(), reader.scalar(),
        reader.scalar(), reader.scalar(), reader.scalar(), reader.number(63, false),
        reader.number(64, false), reader.number(20000, false), reader.number(20000, false),
        reader.number(20000, false), reader.number(20000, false), reader.scalar(), reader.scalar())
    if reader.complete_error() != "" or native_diagnostic_summary_encode_v1(value) != payload:
        return Err("diagnostic summary incomplete or noncanonical")
    Ok(value)

export NativeDiagnosticSummaryV1, native_diagnostic_summary_encode_v1
export native_diagnostic_summary_decode_v1