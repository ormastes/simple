# One compiled parent owns both phase reservations and real worker transports.
# This is not a second host policy: all physical/commit/disk/CPU arithmetic is
# delegated to the existing grouped-process policy. The shell bridge does not
# make authority decisions. Callers must bind these tasks/policy to the admitted
# producer/source/image receipts before opening this owner.
use app.bootstrap_builder.contracts.{BuildTaskV1, BuildHostV1, BuildResultV1, BuildInputV1,
    builder_validate_task_v1, builder_validate_host_v1, builder_task_identity_v1,
    builder_validate_result_v1, builder_digest_valid_v1}
use app.bootstrap_builder.transport.{BuilderAttemptV1, builder_transport_start_v1,
    builder_transport_poll_v1, builder_transport_collect_v1,
    builder_transport_cancel_v1, builder_transport_reaped_v1, builder_transport_recover_v1}
use app.bootstrap_builder.process_port.{BuilderProcessPortV1}
use app.bootstrap_builder.grouped_native_run.{NativeGroupedCapacityV1,
    NativeGroupedCapacitySampleV1}
use std.common.build_manager.grouped_native_process_policy.{NativeGroupActiveChargeV1,
    native_group_process_budget_v1, native_group_disk_budget_v1,
    native_group_disk_required_v1}
use app.io.file_ops.{file_lock, file_unlock, file_exists, file_atomic_write, path_absolute}
use app.io.dir_ops.{dir_create_all}
use app.bootstrap_builder.codec.{builder_read_run_v1, builder_encode_run_v1, builder_encode_result_v1,
    builder_read_result_v1}
use app.bootstrap_builder.manager.{builder_manager_output_error}
use app.bootstrap_builder.link_inputs.{builder_regular_input_parents_safe_v1, builder_link_inputs_match_v1}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use app.bootstrap_builder.failure_policy.{builder_failure_class_v1}
use std.common.build_manager.codec.{BuilderWireReaderV1, builder_wire_line_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_hash_sha256,
    file_is_regular_no_follow}
use app.io.time_ops.{current_time_ms, sleep_ms}
use app.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.sysinfo_ops.{cpu_count_checked}

struct ManagedPhaseResourceV1:
    memory_limit_bytes: i64
    source_bytes: i64
    estimated_disk_bytes: i64
    threads: i64

struct ManagedPhasePolicyV1:
    aggregate_limit_bytes: i64
    task_limit_bytes: i64
    owner_memory_bytes: i64
    host_reserve_bytes: i64
    disk_reserve_bytes: i64
    cpu_count: i64
    commit_required: bool

# Empty text means admitted; RESOURCE_WAIT is a pending state, never FAILED.
# Current RSS is deliberately not subtracted from any active hard-cap charge.
fn managed_phase_budget_v1(policy: ManagedPhasePolicyV1,
        candidate: ManagedPhaseResourceV1, active: [ManagedPhaseResourceV1],
        sample: NativeGroupedCapacitySampleV1) -> Result<text, text>:
    val maximum: i64 = 1125899906842624
    if policy.aggregate_limit_bytes < 1 or policy.aggregate_limit_bytes > maximum or
            policy.task_limit_bytes < 1 or policy.task_limit_bytes > maximum or
            policy.owner_memory_bytes < 1 or policy.owner_memory_bytes > maximum or
            policy.host_reserve_bytes < 0 or policy.host_reserve_bytes > maximum or
            policy.disk_reserve_bytes < 0 or active.len() > 1:
        return Err("invalid managed phase policy")
    if policy.commit_required and not sample.commit_measured:
        return Err("aggregate phase admission requires measured commit headroom")
    var charges: [NativeGroupActiveChargeV1] = []
    var aggregate = policy.owner_memory_bytes
    var disk_growth: i64 = 0
    for row in active:
        if row.memory_limit_bytes < 1 or row.memory_limit_bytes > policy.task_limit_bytes:
            return Err("invalid active phase limit")
        aggregate = aggregate + row.memory_limit_bytes
        charges = charges.push(NativeGroupActiveChargeV1(row.memory_limit_bytes, 0, row.threads))
        disk_growth = native_group_disk_required_v1(0, disk_growth,
            row.source_bytes, row.estimated_disk_bytes)?
    if candidate.memory_limit_bytes < 1 or candidate.memory_limit_bytes > policy.task_limit_bytes:
        return Err("invalid candidate phase limit")
    if candidate.memory_limit_bytes + policy.owner_memory_bytes > policy.aggregate_limit_bytes:
        return Err("phase cannot fit sealed aggregate envelope even when alone")
    aggregate = aggregate + candidate.memory_limit_bytes
    val memory = native_group_process_budget_v1(policy.cpu_count, candidate.threads,
        candidate.memory_limit_bytes, policy.host_reserve_bytes + policy.owner_memory_bytes,
        sample.available_memory_bytes, sample.available_commit_bytes,
        sample.commit_measured, charges)?
    val disk = native_group_disk_budget_v1(sample.available_disk_bytes,
        policy.disk_reserve_bytes, disk_growth, candidate.source_bytes,
        candidate.estimated_disk_bytes)?
    if aggregate > policy.aggregate_limit_bytes: return Ok("RESOURCE_WAIT: aggregate phase envelope")
    if not memory.admitted: return Ok("RESOURCE_WAIT: " + memory.reason)
    if not disk.admitted: return Ok("RESOURCE_WAIT: aggregate disk growth")
    Ok("")

class ManagedPhaseAdmissionV1:
    root: text
    source_root: text
    lock: i64
    policy: ManagedPhasePolicyV1
    tasks: [BuildTaskV1]
    resources: [ManagedPhaseResourceV1]
    host: BuildHostV1
    process: BuilderProcessPortV1
    capacity: NativeGroupedCapacityV1
    states: [text]
    attempts: [BuilderAttemptV1?]
    samples: [NativeGroupedCapacitySampleV1]
    authority_digest: text

impl ManagedPhaseAdmissionV1:
    fn snapshot() -> text:
        var payload = "SIMPLE-MANAGED-PHASE-RESERVATIONS-1\n"
        payload = payload + self.authority_digest + "\n"
        payload = payload + str(self.policy.aggregate_limit_bytes) + "\n"
        payload = payload + str(self.policy.task_limit_bytes) + "\n"
        payload = payload + str(self.policy.owner_memory_bytes) + "\n"
        payload = payload + str(self.policy.host_reserve_bytes) + "\n"
        payload = payload + str(self.policy.disk_reserve_bytes) + "\n"
        payload = payload + str(self.policy.cpu_count) + "\n"
        payload = payload + (if self.policy.commit_required: "1\n" else: "0\n")
        for i in 0..2:
            val row = self.resources[i]
            payload = payload + self.tasks[i].phase + "\n" + builder_task_identity_v1(self.tasks[i]) + "\n"
            payload = payload + self.states[i] + "\n" + str(row.memory_limit_bytes) + "\n"
            payload = payload + str(row.source_bytes) + "\n" + str(row.estimated_disk_bytes) + "\n" + str(row.threads) + "\n"
            val sample = self.samples[i]
            payload = payload + str(sample.available_memory_bytes) + "\n" + str(sample.available_commit_bytes) + "\n"
            payload = payload + str(sample.available_disk_bytes) + "\n" + (if sample.commit_measured: "1\n" else: "0\n")
        payload

    me persist() -> bool:
        file_atomic_write(self.root + "/phase-reservations.sdn", self.snapshot())

    me try_start(index: i64) -> Result<text, text>:
        if self.lock < 0 or index < 0 or index > 1: return Err("invalid phase owner/index")
        if self.states[index] != "PENDING" and self.states[index] != "RESOURCE_WAIT":
            return Err("phase is not pending")
        var active: [ManagedPhaseResourceV1] = []
        for i in 0..2:
            if self.states[i] == "OWNERSHIP_UNKNOWN" or self.states[i] == "ADMITTING":
                return Err("unresolved phase ownership blocks admission")
            if self.states[i] == "RUNNING" or self.states[i] == "COLLECTED":
                active = active.push(self.resources[i])
        if active.len() >= self.host.slots:
            self.states[index] = "RESOURCE_WAIT"
            if not self.persist(): return Err("cannot persist host-slot wait")
            return Ok("RESOURCE_WAIT: configured host slots")
        val sample = self.capacity.probe(self.root)?
        self.samples[index] = sample
        val reason = managed_phase_budget_v1(self.policy, self.resources[index], active, sample)?
        if reason != "":
            self.states[index] = "RESOURCE_WAIT"
            if not self.persist(): return Err("cannot persist pending phase")
            return Ok(reason)
        # Reserve BEFORE staging/launch, under the one lifetime owner lock.
        self.states[index] = "ADMITTING"
        if not self.persist(): return Err("cannot persist phase reservation")
        val phase_root = self.root + "/" + self.tasks[index].phase
        val attempt = builder_transport_start_v1(self.tasks[index], self.host,
            self.source_root, phase_root, self.process)
        self.attempts[index] = Some(attempt)
        if attempt.error != "":
            self.states[index] = "OWNERSHIP_UNKNOWN"
            val _retained = self.persist()
            return Err(attempt.error)
        self.states[index] = "RUNNING"
        if not self.persist():
            return Err(self.uncertain(index, "cannot persist started phase; reservation retained"))
        Ok("STARTED")

    me uncertain(index: i64, reason: text) -> text:
        self.states[index] = "OWNERSHIP_UNKNOWN"
        if not self.persist(): return reason + "; cannot persist uncertainty"
        reason

    me collect(index: i64) -> Result<BuildResultV1?, text>:
        if self.lock < 0 or index < 0 or index > 1: return Err("invalid phase owner/index")
        if (self.states[index] != "RUNNING" and self.states[index] != "COLLECTED") or self.attempts[index] == nil:
            return Err("phase is not running")
        val attempt = self.attempts[index]!
        val code = if self.states[index] == "COLLECTED": 0 else: builder_transport_poll_v1(attempt)
        if code == -2: return Ok(nil)
        if code == -1: return Err(self.uncertain(index, "phase observation unknown; reservation retained"))
        if not builder_transport_reaped_v1(attempt): return Err(self.uncertain(index, "phase tree reap unproven; reservation retained"))
        val result = match builder_transport_collect_v1(attempt):
            Ok(value): value
            Err(reason): return Err(self.uncertain(index, reason))
        val invalid = builder_validate_result_v1(self.tasks[index], result)
        if invalid != "": return Err(self.uncertain(index, invalid))
        # Result/output admission remains the existing manager's responsibility.
        # Keep the aggregate charge until the explicit release operation.
        self.states[index] = "COLLECTED"
        if not self.persist():
            return Err(self.uncertain(index, "cannot persist collected phase; reservation retained"))
        Ok(Some(result))

    me release(index: i64) -> bool:
        if self.lock < 0 or index < 0 or index > 1 or self.attempts[index] == nil: return false
        if self.states[index] != "COLLECTED" and self.states[index] != "REAPED": return false
        # Idempotent only for this exact owned task/attempt/host; never use a
        # caller's PID or an unrelated terminal process to discharge capacity.
        if not builder_transport_reaped_v1(self.attempts[index]!):
            val _reason = self.uncertain(index, "release lost exact phase reap proof")
            return false
        if self.states[index] == "REAPED": return true
        self.states[index] = "REAPED"
        if not self.persist():
            val _reason = self.uncertain(index, "cannot persist phase release")
            return false
        true

    me cancel_all() -> bool:
        var complete = true
        # Notify both local workers before waiting on either owned tree. A
        # slow first reap must not leave its sibling running without a stop.
        for i in 0..2:
            if self.states[i] == "RUNNING" or self.states[i] == "COLLECTED" or self.states[i] == "OWNERSHIP_UNKNOWN" or self.states[i] == "ADMITTING":
                if val attempt = self.attempts[i]:
                    if not file_atomic_write(attempt.local_root + "/cancel.request", "cancel\n"):
                        complete = false
        for i in 0..2:
            if self.states[i] == "RUNNING" or self.states[i] == "COLLECTED" or self.states[i] == "OWNERSHIP_UNKNOWN" or self.states[i] == "ADMITTING":
                if self.attempts[i] == nil:
                    complete = false
                    continue
                val attempt = self.attempts[i]!
                if builder_transport_cancel_v1(attempt) and builder_transport_reaped_v1(attempt):
                    self.states[i] = "COLLECTED"
                    if not self.release(i): complete = false
                else:
                    self.states[i] = "OWNERSHIP_UNKNOWN"
                    complete = false
        if not self.persist():
            for i in 0..2:
                if self.states[i] != "PENDING" and self.states[i] != "RESOURCE_WAIT":
                    self.states[i] = "OWNERSHIP_UNKNOWN"
            return false
        complete

    me close() -> bool:
        if self.lock < 0: return false
        for state in self.states:
            if state != "PENDING" and state != "RESOURCE_WAIT" and state != "REAPED": return false
        file_unlock(self.lock)
        self.lock = -1
        true

fn managed_phase_authority_valid_v1(root: text, source_root: text,
        policy: ManagedPhasePolicyV1, tasks: [BuildTaskV1],
        resources: [ManagedPhaseResourceV1], host: BuildHostV1,
        authority_digest: text) -> Result<bool, text>:
    if tasks.len() != 2 or resources.len() != 2 or host.transport != "local":
        return Err("exactly two local phase tasks required")
    if not builder_digest_valid_v1(authority_digest): return Err("invalid phase authority digest")
    if builder_validate_host_v1(host) != "": return Err("invalid phase host")
    if tasks[0].phase != "phase3" or tasks[1].phase != "phase4" or tasks[0].id == tasks[1].id or
            tasks[0].cache_key == tasks[1].cache_key:
        return Err("phase identities and writable caches must be distinct")
    for i in 0..2:
        if builder_validate_task_v1(tasks[i]) != "" or tasks[i].dependencies.len() != 0 or
                tasks[i].memory_limit_bytes != resources[i].memory_limit_bytes:
            return Err("phase task differs from admitted resource limit")
    val canonical = path_absolute(root).replace("\\", "/").lower()
    val source = path_absolute(source_root).replace("\\", "/").lower()
    if canonical == "" or source == "" or canonical == source or
            canonical.starts_with(source + "/") or source.starts_with(canonical + "/"):
        return Err("phase state overlaps source authority")
    Ok(true)

fn managed_phase_admission_open_v1(root: text, source_root: text,
        policy: ManagedPhasePolicyV1, tasks: [BuildTaskV1],
        resources: [ManagedPhaseResourceV1], host: BuildHostV1,
        process: BuilderProcessPortV1, capacity: NativeGroupedCapacityV1, authority_digest: text
        ) -> Result<ManagedPhaseAdmissionV1, text>:
    val _authority = managed_phase_authority_valid_v1(root, source_root,
        policy, tasks, resources, host, authority_digest)?
    val host_cpus = cpu_count_checked()?
    if policy.cpu_count < 1 or policy.cpu_count > host_cpus:
        return Err("sealed phase CPU ceiling exceeds measured host capacity")
    if not dir_create_all(root): return Err("phase state directory unavailable")
    val lock = file_lock(root + "/phase-owner.lock", 1)
    if lock < 0: return Err("another parent owns phase admission")
    var owner = ManagedPhaseAdmissionV1(root, source_root, lock, policy, tasks,
        resources, host, process, capacity, ["PENDING", "PENDING"], [nil, nil],
        [NativeGroupedCapacitySampleV1(0, 0, 0, false), NativeGroupedCapacitySampleV1(0, 0, 0, false)], authority_digest)
    val sample = match capacity.probe(root):
        Ok(value): value
        Err(reason):
            file_unlock(lock)
            return Err(reason)
    for resource in resources:
        match managed_phase_budget_v1(policy, resource, [], sample):
            Ok(_): pass
            Err(reason):
                file_unlock(lock)
                return Err(reason)
    if file_exists(root + "/phase-reservations.sdn"):
        match managed_phase_recover_v1(owner):
            Ok(_): return Ok(owner)
            Err(reason):
                file_unlock(lock)
                return Err(reason)
    if not owner.persist():
        file_unlock(lock)
        return Err("cannot establish durable phase owner")
    Ok(owner)

export ManagedPhaseResourceV1, ManagedPhasePolicyV1, ManagedPhaseAdmissionV1
export managed_phase_budget_v1, managed_phase_admission_open_v1

fn managed_phase_restore_journal_v1(owner: ManagedPhaseAdmissionV1, payload: text) -> Result<bool, text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PHASE-RESERVATIONS-1" or
            reader.scalar() != owner.authority_digest:
        return Err("phase recovery authority differs")
    val maximum: i64 = 1125899906842624
    for expected in [owner.policy.aggregate_limit_bytes, owner.policy.task_limit_bytes,
            owner.policy.owner_memory_bytes, owner.policy.host_reserve_bytes,
            owner.policy.disk_reserve_bytes, owner.policy.cpu_count,
            if owner.policy.commit_required: 1 else: 0]:
        if reader.number(maximum, false) != expected: return Err("phase recovery policy differs")
    var states: [text] = []
    var samples: [NativeGroupedCapacitySampleV1] = []
    for i in 0..2:
        if reader.scalar() != owner.tasks[i].phase or reader.scalar() != builder_task_identity_v1(owner.tasks[i]):
            return Err("phase recovery task identity differs")
        val state = reader.scalar()
        match state:
            case "PENDING" | "RESOURCE_WAIT" | "ADMITTING" | "RUNNING" | "COLLECTED" | "REAPED" | "OWNERSHIP_UNKNOWN": pass
            case _: return Err("invalid retained phase state")
        states = states.push(state)
        val row = owner.resources[i]
        for expected in [row.memory_limit_bytes, row.source_bytes, row.estimated_disk_bytes, row.threads]:
            if reader.number(maximum, false) != expected: return Err("phase recovery resources differ")
        val memory = reader.number(maximum, false)
        val commit = reader.number(maximum, false)
        val disk = reader.number(maximum, false)
        val measured = reader.number(1, false) == 1
        if not measured and commit != 0: return Err("invalid retained commit observation")
        samples = samples.push(NativeGroupedCapacitySampleV1(memory, disk, commit, measured))
    if reader.reason != "": return Err(reader.reason)
    if reader.index != reader.lines.len() - 1: return Err("trailing phase journal fields")
    owner.states = states
    owner.samples = samples
    Ok(true)

fn managed_phase_recover_v1(owner: ManagedPhaseAdmissionV1) -> Result<bool, text>:
    val payload = file_read_regular_no_follow_bounded(owner.root + "/phase-reservations.sdn", 8192)?
    val _restored = managed_phase_restore_journal_v1(owner, payload)?
    var unresolved = ""
    for i in 0..2:
        if owner.states[i] == "PENDING" or owner.states[i] == "RESOURCE_WAIT": continue
        val recovered = builder_transport_recover_v1(owner.tasks[i], owner.host,
            owner.root + "/" + owner.tasks[i].phase, owner.process)
        match recovered:
            Ok(attempt):
                owner.attempts[i] = Some(attempt)
                if owner.states[i] == "REAPED":
                    if not builder_transport_reaped_v1(attempt):
                        owner.states[i] = "OWNERSHIP_UNKNOWN"
                        unresolved = "retained reap lacks authoritative tree proof"
                else:
                    # Recovery observes the existing owner; it never spawns a
                    # replacement or invalidates a retained writable cache.
                    owner.states[i] = "RUNNING"
            Err(reason):
                owner.states[i] = "OWNERSHIP_UNKNOWN"
                unresolved = reason
    if not owner.persist(): return Err("cannot retain recovered phase authority")
    if unresolved != "": return Err(unresolved)
    Ok(true)

fn managed_phase_policy_encode_v1(policy: ManagedPhasePolicyV1,
        resources: [ManagedPhaseResourceV1]) -> text:
    var payload = "SIMPLE-MANAGED-PHASE-POLICY-1\n"
    for value in [policy.aggregate_limit_bytes, policy.task_limit_bytes,
            policy.owner_memory_bytes, policy.host_reserve_bytes,
            policy.disk_reserve_bytes, policy.cpu_count]:
        payload = payload + builder_wire_line_v1(str(value))
    payload = payload + (if policy.commit_required: "1\n" else: "0\n")
    for row in resources:
        for value in [row.memory_limit_bytes, row.source_bytes, row.estimated_disk_bytes, row.threads]:
            payload = payload + builder_wire_line_v1(str(value))
    payload

fn managed_phase_policy_decode_v1(payload: text
        ) -> Result<(ManagedPhasePolicyV1, [ManagedPhaseResourceV1]), text>:
    var reader = BuilderWireReaderV1.create(payload)
    if reader.scalar() != "SIMPLE-MANAGED-PHASE-POLICY-1": return Err("invalid phase policy header")
    val maximum: i64 = 1125899906842624
    val aggregate = reader.number(maximum, false)
    val task_limit = reader.number(maximum, false)
    val owner = reader.number(maximum, false)
    val reserve = reader.number(maximum, false)
    val disk = reader.number(maximum, false)
    val cpus = reader.number(1024, false)
    val commit = reader.number(1, false)
    val policy = ManagedPhasePolicyV1(aggregate, task_limit, owner, reserve, disk, cpus, commit == 1)
    var resources: [ManagedPhaseResourceV1] = []
    for i in 0..2:
        val memory = reader.number(maximum, false)
        val source = reader.number(maximum, false)
        val growth = reader.number(maximum, false)
        val threads = reader.number(1024, false)
        resources = resources.push(ManagedPhaseResourceV1(memory, source, growth, threads))
    if reader.reason != "": return Err(reader.reason)
    if managed_phase_policy_encode_v1(policy, resources) != payload:
        return Err("noncanonical phase policy")
    Ok((policy, resources))

fn managed_phase_cli_locked_v1(owner: ManagedPhaseAdmissionV1,
        poll_ms: i64, lifetime_ms: i64) -> Result<i64, text>:
    val deadline = current_time_ms() + lifetime_ms
    var failed = false
    for i in 0..2:
        if owner.states[i] == "REAPED":
            if owner.attempts[i] == nil: return Err("retained phase transport absent")
            val result = builder_transport_collect_v1(owner.attempts[i]!)?
            val invalid = builder_validate_result_v1(owner.tasks[i], result)
            if invalid != "": return Err(invalid)
            val classification = builder_failure_class_v1(result.status, result.exit_code, true)
            if classification == "infrastructure-abort": return Err("reaped aborted phase requires an admitted retry; completion is not proven")
            if classification == "compile-failure": failed = true
    while current_time_ms() < deadline:
        if managed_phase_stop_requested_v1(owner.root):
            return Err("managed phase owner stop requested")
        for i in 0..2:
            if owner.states[i] == "RUNNING":
                if val result = owner.collect(i)?:
                    val classification = builder_failure_class_v1(result.status, result.exit_code, true)
                    if classification == "infrastructure-abort":
                        return Err("managed phase infrastructure failure")
                    if classification == "compile-failure": failed = true
                    val receipt = owner.root + "/" + owner.tasks[i].phase + "/result.sdn"
                    if not file_atomic_write(receipt, builder_encode_result_v1(result)):
                        return Err(owner.uncertain(i, "cannot retain phase result"))
                    if not owner.release(i): return Err("phase reservation release failed")
        var pending = false
        var running = false
        for i in 0..2:
            if owner.states[i] == "PENDING" or owner.states[i] == "RESOURCE_WAIT":
                if managed_phase_stop_requested_v1(owner.root):
                    return Err("managed phase owner stop requested")
                val decision = owner.try_start(i)?
                if decision != "STARTED": pending = true
            if owner.states[i] == "RUNNING": running = true
        if not running:
            if not pending: return Ok(if failed: 1 else: 0)
            # Keep the live parent and its ownership lock while external host
            # pressure clears. Do not turn transient admission into failure or
            # repeatedly reopen its durable ownership ledger.
        sleep_ms(poll_ms)
    Err("managed phase bounded lifetime reached")

fn managed_phase_stop_requested_v1(root: text) -> bool:
    if file_exists(root + "/cancel.request"): return true
    for key in ["SIMPLE_MODULE_COLLECTION_STOP_REQUEST_FILE", "SIMPLE_MODULE_SYSTEMIC_STOP_FILE"]:
        val marker = env_get(key)
        if marker != "" and file_exists(marker): return true
    false

fn managed_phase_completion_result_error_v1(task: BuildTaskV1,
        result: BuildResultV1, published: BuildResultV1,
        observed: [BuildInputV1]) -> text:
    val invalid = builder_validate_result_v1(task, result)
    if invalid != "": return invalid
    if builder_failure_class_v1(result.status, result.exit_code, true) != "complete":
        return "aggregate completion requires two successful phase results"
    if builder_encode_result_v1(published) != builder_encode_result_v1(result):
        return "retained parent and transport phase results differ"
    builder_manager_output_error(task, result, observed)

# No recovery challenge, process poll, capacity probe or journal rewrite is
# permitted in this path. Construct an exact local receipt reader only after
# the retained journal proves both phases have reached REAPED.
fn managed_phase_verify_retained_v1(owner: ManagedPhaseAdmissionV1) -> Result<bool, text>:
    val payload = file_read_regular_no_follow_bounded(owner.root + "/phase-reservations.sdn", 8192)?
    val _restored = managed_phase_restore_journal_v1(owner, payload)?
    for state in owner.states:
        if state != "REAPED": return Err("aggregate phase is not durably reaped")
    if managed_phase_stop_requested_v1(owner.root): return Err("managed phase stop remains requested")
    for i in 0..2:
        val task = owner.tasks[i]
        val _policy = managed_phase_budget_v1(owner.policy, owner.resources[i], [], owner.samples[i])?
        if not builder_regular_input_parents_safe_v1(task, owner.source_root):
            return Err("phase source parent is unsafe")
        for input in task.inputs:
            val path = owner.source_root + "/" + input.path
            if not file_is_regular_no_follow(path) or file_hash_sha256(path) != input.digest:
                return Err("phase source input changed: " + input.path)
        val links = builder_link_inputs_match_v1(task, owner.source_root)
        if links != "": return Err(links)
        val program = if task.program.starts_with("/") or task.program.contains(":"):
            task.program
        else: owner.source_root + "/" + task.program
        if not file_is_regular_no_follow(program) or file_hash_sha256(program) != task.producer_digest:
            return Err("phase program differs from pinned producer")
        val phase_root = owner.root + "/" + task.phase
        val root = phase_root + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + owner.host.id
        if not dir_is_real_no_follow(root): return Err("phase attempt directory is unsafe")
        val attempt = BuilderAttemptV1(task.id, task.attempt, owner.host, 0,
            root, "", "", builder_task_identity_v1(task), owner.process)
        if not builder_transport_reaped_v1(attempt): return Err("phase exact tree reap is unproven")
        val result = builder_transport_collect_v1(attempt)?
        val published = builder_read_result_v1(phase_root + "/result.sdn")?
        var observed: [BuildInputV1] = []
        for output in task.outputs:
            var parent = root + "/work"
            if not dir_is_real_no_follow(parent): return Err("phase output root is unsafe")
            val parts = output.split("/")
            for index in 0..parts.len() - 1:
                parent = parent + "/" + parts[index]
                if not dir_is_real_no_follow(parent): return Err("phase output parent is unsafe")
            val path = root + "/work/" + output
            if not file_is_regular_no_follow(path): return Err("phase expected output is missing")
            observed = observed.push(BuildInputV1(output, file_hash_sha256(path)))
        val outputs = managed_phase_completion_result_error_v1(task, result, published, observed)
        if outputs != "": return Err(outputs)
    Ok(true)

fn managed_phase_verify_v1(root: text, source_root: text,
        policy: ManagedPhasePolicyV1, tasks: [BuildTaskV1],
        resources: [ManagedPhaseResourceV1], host: BuildHostV1,
        process: BuilderProcessPortV1, capacity: NativeGroupedCapacityV1,
        authority_digest: text) -> Result<bool, text>:
    val _authority = managed_phase_authority_valid_v1(root, source_root,
        policy, tasks, resources, host, authority_digest)?
    # Acquire only the existing ownership lock; never establish a fresh run.
    if not dir_is_real_no_follow(root) or not file_is_regular_no_follow(root + "/phase-owner.lock"):
        return Err("retained phase owner is absent")
    val lock = file_lock(root + "/phase-owner.lock", 1)
    if lock < 0: return Err("phase owner is still active")
    val owner = ManagedPhaseAdmissionV1(root, source_root, lock, policy, tasks,
        resources, host, process, capacity, ["PENDING", "PENDING"], [nil, nil],
        [NativeGroupedCapacitySampleV1(0, 0, 0, false), NativeGroupedCapacitySampleV1(0, 0, 0, false)], authority_digest)
    val result = managed_phase_verify_retained_v1(owner)
    if not file_unlock(lock): return Err("phase verification lock release failed")
    result

# args starts with managed-phases; common CLI owns dispatch and each platform
# passes its existing authoritative capacity probe, not a shell snapshot.
fn managed_phase_cli_v1(args: [text], process: BuilderProcessPortV1,
        capacity: NativeGroupedCapacityV1) -> i64:
    if args.len() != 21 or (args[0] != "managed-phases" and args[0] != "managed-phases-verify"): return 2
    var values: {text: text} = {}
    var i = 1
    while i < args.len():
        val key = args[i]
        if values.has(key): return 2
        match key:
            case "--phase3-manifest" | "--phase3-sha256" | "--phase4-manifest" | "--phase4-sha256" | "--policy" | "--policy-sha256" | "--source-root" | "--state" | "--poll-ms" | "--lifetime-ms":
                values[key] = args[i + 1]
            case _: return 2
        i = i + 2
    for key in ["--phase3-manifest", "--phase4-manifest", "--policy", "--source-root", "--state"]:
        val path = values[key]
        if path == "" or path.contains("\n") or path.contains("\0") or
                not (path.starts_with("/") or (path.len() > 2 and path[1:2] == ":")):
            return 2
    for pair in [("--phase3-manifest", "--phase3-sha256"),
            ("--phase4-manifest", "--phase4-sha256"), ("--policy", "--policy-sha256")]:
        if not file_is_regular_no_follow(values[pair.0]) or
                file_hash_sha256(values[pair.0]) != values[pair.1]: return 2
    val first = match builder_read_run_v1(values["--phase3-manifest"]):
        Ok(value): value
        Err(_): return 2
    val second = match builder_read_run_v1(values["--phase4-manifest"]):
        Ok(value): value
        Err(_): return 2
    # The decoder canonicalizes the exact task wire. Bind the bytes actually
    # read as well as the earlier no-follow file check, closing hash/read races.
    if sha256_text(builder_encode_run_v1(first)) != values["--phase3-sha256"] or
            sha256_text(builder_encode_run_v1(second)) != values["--phase4-sha256"]: return 2
    if first.tasks.len() != 1 or second.tasks.len() != 1 or
            first.hosts.len() != 1 or second.hosts.len() != 1: return 2
    val host = first.hosts[0]
    val other = second.hosts[0]
    if host.id != other.id or host.transport != other.transport or host.endpoint != other.endpoint or
            host.workspace != other.workspace or host.worker_program != other.worker_program or
            host.worker_digest != other.worker_digest or host.slots != other.slots: return 2
    val payload = match file_read_regular_no_follow_bounded(values["--policy"], 4096):
        Ok(value): value
        Err(_): return 2
    if sha256_text(payload) != values["--policy-sha256"]: return 2
    val decoded = match managed_phase_policy_decode_v1(payload):
        Ok(value): value
        Err(_): return 2
    if host_os() == "windows" and not decoded.0.commit_required: return 2
    var timing = BuilderWireReaderV1.create(values["--poll-ms"] + "\n" + values["--lifetime-ms"] + "\n")
    val poll_ms = timing.number(60000, false)
    val lifetime_ms = timing.number(604800000, false)
    if timing.reason != "" or poll_ms < 1 or lifetime_ms < poll_ms: return 2
    val authority = sha256_text(values["--phase3-sha256"] + "\n" + values["--phase4-sha256"] + "\n" +
        values["--policy-sha256"] + "\n" + path_absolute(values["--source-root"]))
    if args[0] == "managed-phases-verify":
        match managed_phase_verify_v1(values["--state"], values["--source-root"], decoded.0,
                [first.tasks[0], second.tasks[0]], decoded.1, host, process, capacity, authority):
            Ok(_): return 0
            Err(reason):
                print "managed phases verify: {reason}"
                return 2
    val owner = match managed_phase_admission_open_v1(values["--state"], values["--source-root"],
            decoded.0, [first.tasks[0], second.tasks[0]], decoded.1, host, process, capacity,
            authority):
        Ok(value): value
        Err(reason):
            print "managed phases admission: {reason}"
            return 2
    val outcome = managed_phase_cli_locked_v1(owner, poll_ms, lifetime_ms)
    if outcome.is_err():
        print "managed phases aborted: {outcome.unwrap_err()}"
        val cleaned = owner.cancel_all()
        if cleaned:
            val _closed = owner.close()
        return 2
    if not owner.close(): return 2
    outcome.unwrap()

export managed_phase_policy_encode_v1, managed_phase_policy_decode_v1, managed_phase_cli_v1
export managed_phase_restore_journal_v1
export managed_phase_verify_v1
export managed_phase_completion_result_error_v1
