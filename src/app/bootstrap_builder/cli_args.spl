# Deliberately strict argv parser shared by the native entrypoint and tests.
struct BuilderCliV1:
    command: text
    manifest: text
    state: text
    source_root: text
    output_root: text
    request: text
    attempt_root: text
    host: text
    error: text

fn builder_cli_parse_v1(args: [text]) -> BuilderCliV1:
    var config = BuilderCliV1(command: "", manifest: "", state: "", source_root: "",
        output_root: "", request: "", attempt_root: "", host: "", error: "")
    if args.len() == 0:
        config.error = "expected run, verify, worker, or check"
        return config
    config.command = args[0]
    if config.command == "--help" or config.command == "-h": return config
    if config.command != "run" and config.command != "verify" and
            config.command != "worker" and config.command != "check":
        config.error = "unknown builder command"
        return config
    var seen: [text] = []
    var i = 1
    while i < args.len():
        val name = args[i]
        for previous in seen:
            if name == previous:
                config.error = "duplicate option: " + name
                return config
        seen = seen.push(name)
        if i + 1 >= args.len() or args[i + 1] == "" or args[i + 1].starts_with("--"):
            config.error = "missing option value: " + name
            return config
        val value = args[i + 1]
        if name == "--manifest" and config.command != "worker": config.manifest = value
        elif name == "--state" and (config.command == "run" or config.command == "verify"):
            config.state = value
        elif name == "--source-root" and (config.command == "run" or config.command == "verify"):
            config.source_root = value
        elif name == "--output-root" and (config.command == "run" or config.command == "verify"):
            config.output_root = value
        elif name == "--request" and config.command == "worker": config.request = value
        elif name == "--attempt-root" and config.command == "worker": config.attempt_root = value
        elif name == "--host" and config.command == "worker": config.host = value
        else:
            config.error = "option is unknown or invalid for command: " + name
            return config
        i = i + 2
    if (config.command == "run" or config.command == "verify") and
            (config.manifest == "" or config.state == ""):
        config.error = config.command + " requires --manifest and --state"
    elif config.command == "check" and config.manifest == "":
        config.error = "check requires --manifest"
    elif config.command == "worker" and (config.request == "" or config.attempt_root == "" or config.host == ""):
        config.error = "worker requires --request, --attempt-root, and --host"
    config

export BuilderCliV1, builder_cli_parse_v1
