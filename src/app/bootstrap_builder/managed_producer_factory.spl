# A next-wave template has an explicit unbound producer slot, never a guessed
# future compiler digest. Only the retained managed owner calls this after
# exact process-tree reap, successful output validation and the sanity gate.
use app.bootstrap_builder.contracts.{BuildTaskV1, BuildResultV1, BuildInputV1,
    builder_validate_task_v1, builder_validate_result_v1, builder_task_identity_v1,
    builder_relative_path_valid_v1, builder_digest_valid_v1}
use app.bootstrap_builder.codec.{builder_encode_result_v1}
use app.bootstrap_builder.manager.{builder_manager_output_error}
use std.common.crypto.sha256.{sha256_text}

pub fn managed_producer_unbound_digest_v1() -> text:
    sha256_text("simple-managed-producer-slot-unbound-v1")

# The shell owner is already a real, hash-bound program. Only these two
# complete arguments are deferred; never replace substrings in arbitrary argv.
pub fn managed_producer_bind_hello_callback_v1(parent: BuildTaskV1, result: BuildResultV1,
        published: BuildResultV1, observed: [BuildInputV1], output: text,
        physical_output: text, template: BuildTaskV1) -> Result<BuildTaskV1, text>:
    if template.program == "managed-producer-unbound" or
            template.producer_digest == managed_producer_unbound_digest_v1():
        return Err("Hello callback requires an existing bound executable owner")
    val invalid = builder_validate_task_v1(template)
    if invalid != "": return Err(invalid)
    if not parent.id.ends_with("_build") or
            template.id != parent.id[0:parent.id.len() - 6] + "_sanity" or
            template.phase != "diagnostic-sanity":
        return Err("Hello callback must be the producer diagnostic sanity node")
    var path_slots = 0
    var digest_slots = 0
    for argument in template.args:
        if argument == "--producer=@managed-producer-path-v1@": path_slots = path_slots + 1
        elif argument == "--producer-digest=@managed-producer-digest-v1@": digest_slots = digest_slots + 1
        elif argument.starts_with("--producer=") or argument.starts_with("--producer-digest=") or
                argument.contains("@managed-producer-"):
            return Err("Hello callback contains an ambiguous producer argument")
    if path_slots != 1 or digest_slots != 1:
        return Err("Hello callback requires exactly one path and digest slot")
    var deferred = template
    deferred.program = "managed-producer-unbound"
    deferred.producer_digest = managed_producer_unbound_digest_v1()
    val bound = managed_producer_bind_task_v1(parent, result, published, observed,
        output, physical_output, deferred)?
    var callback = bound
    callback.program = template.program
    callback.producer_digest = template.producer_digest
    callback.args = []
    for argument in template.args:
        if argument == "--producer=@managed-producer-path-v1@":
            callback.args = callback.args.push("--producer=" + bound.program)
        elif argument == "--producer-digest=@managed-producer-digest-v1@":
            callback.args = callback.args.push("--producer-digest=" + bound.producer_digest)
        else:
            callback.args = callback.args.push(argument)
    val callback_error = builder_validate_task_v1(callback)
    if callback_error != "": return Err(callback_error)
    Ok(callback)

pub fn managed_producer_bind_task_v1(parent: BuildTaskV1, result: BuildResultV1,
        published: BuildResultV1, observed: [BuildInputV1], output: text,
        physical_output: text, template: BuildTaskV1) -> Result<BuildTaskV1, text>:
    val invalid = builder_validate_result_v1(parent, result)
    if invalid != "": return Err(invalid)
    if result.status != "OK" or result.exit_code != 0:
        return Err("next-wave producer requires successful parent output")
    if builder_encode_result_v1(result) != builder_encode_result_v1(published):
        return Err("parent transport and published result differ")
    val outputs_error = builder_manager_output_error(parent, result, observed)
    if outputs_error != "": return Err(outputs_error)
    if not builder_relative_path_valid_v1(output): return Err("invalid producer output path")
    if physical_output.contains("\n") or physical_output.contains("\r") or physical_output.contains("\0") or
            not (physical_output.starts_with("/") or
                (physical_output.len() > 3 and physical_output[1:3] == ":/")):
        return Err("producer output must be a physical absolute path")
    var digest = ""
    for item in observed:
        if item.path == output:
            if digest != "": return Err("ambiguous producer output")
            digest = item.digest
    if not builder_digest_valid_v1(digest): return Err("producer output was not declared and observed")
    if template.program != "managed-producer-unbound" or
            template.producer_digest != managed_producer_unbound_digest_v1():
        return Err("next-wave template must declare an unbound producer slot")
    if template.dependencies.len() != 0 or template.attempt != 1:
        return Err("next-wave template must be a fresh independent task")
    var child = template
    child.program = physical_output
    child.producer_digest = digest
    # Source/runtime authority is unchanged. Bind actual parent lineage in
    # execution/cache identity, without rewriting source inventory authority.
    val lineage = sha256_text("simple-managed-produced-compiler-v1\n" +
        builder_task_identity_v1(parent) + "\n" +
        sha256_text(builder_encode_result_v1(result)) + "\n" + output + "\n" + digest)
    child.toolchain_digest = sha256_text(template.toolchain_digest + lineage)
    child.cache_key = sha256_text(template.cache_key + lineage)
    val child_error = builder_validate_task_v1(child)
    if child_error != "": return Err(child_error)
    Ok(child)
