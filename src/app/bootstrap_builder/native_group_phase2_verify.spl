# Re-admit the full Stage2 tree and compiler SCV before manager work.
# The canonical snapshot argument is produced freshly by the tracked Stage2
# shell emitter, which independently verifies executable/link semantics.
use app.bootstrap_builder.native_group_phase2_admission.{
    phase2_stage2_admission_open_v1
}
use app.bootstrap_builder.native_group_phase2_receipt.{
    Phase2NativeAuthorityReceiptV1,
    phase2_native_authority_receipt_open_v1
}
use app.bootstrap_builder.native_group_phase2_source_snapshot.{
    phase2_source_authority_decode_v1
}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use compiler.driver.driver_build.native_full_inventory_sources.{
    native_full_inventory_source_paths_v1
}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.nogc_sync_mut.io.file_ops.{
    file_is_regular_no_follow, file_hash_sha256,
    file_read_regular_no_follow_bounded
}
use std.nogc_sync_mut.io.snapshot_links.{
    snapshot_symlink_match_nofollow_v1
}

fn _phase2_verified_ancestors_v1(root: text, relative: text) -> bool:
    if not dir_is_real_no_follow(root): return false
    val parts = relative.split("/")
    var parent = root
    for index in 0..parts.len() - 1:
        parent = "{parent}/{parts[index]}"
        if not dir_is_real_no_follow(parent): return false
    true

fn phase2_native_authority_verify_v1(
    receipt_path: text, receipt_digest: text,
    canonical_snapshot_path: text
) -> Result<Phase2NativeAuthorityReceiptV1, text>:
    val value = phase2_native_authority_receipt_open_v1(
        receipt_path, receipt_digest)?
    val stage2 = phase2_stage2_admission_open_v1(
        value.stage2_receipt.path)?
    if stage2.receipt_digest != value.stage2_receipt.digest or
            stage2.admission_identity != value.stage2_admission_identity or
            stage2.producer_path != value.producer.path or
            stage2.producer_digest != value.producer.digest or
            stage2.source_authority_digest != value.source_authority.digest:
        return Err("Phase2 Stage2 receipt binding differs")
    if canonical_snapshot_path == value.source_authority.path or
            not file_is_regular_no_follow(canonical_snapshot_path) or
            file_hash_sha256(canonical_snapshot_path) !=
                value.source_authority.digest:
        return Err("Phase2 freshly emitted canonical source snapshot differs")
    val authority = file_read_regular_no_follow_bounded(
        value.source_authority.path, 64 * 1024 * 1024)?
    if sha256_text(authority) != value.source_authority.digest:
        return Err("Phase2 retained Stage2 authority differs")
    val records = phase2_source_authority_decode_v1(authority)?
    var src_paths: [text] = []
    var full_paths: [text] = []
    var links: [text] = []
    var link_count = 0
    for line in authority.split("\n"):
        if line.starts_with("link-hex:") or
                line.starts_with("link-dir-hex:"):
            links = links.push(line)
    for record in records:
        if not _phase2_verified_ancestors_v1(
                value.source_root, record.relative_path):
            return Err("Phase2 source ancestor is not a real directory")
        val path = "{value.source_root}/{record.relative_path}"
        if record.kind == "file-hex":
            if not file_is_regular_no_follow(path) or
                    file_hash_sha256(path) != record.digest:
                return Err("Phase2 source regular file differs: " +
                    record.relative_path)
            full_paths = full_paths.push(record.relative_path)
            if record.relative_path.starts_with("src/"):
                src_paths = src_paths.push(record.relative_path)
        else:
            val kind = if record.kind == "link-dir-hex": 2 else: 1
            if not snapshot_symlink_match_nofollow_v1(
                    value.source_root, path, record.link_target, kind):
                return Err("Phase2 source link differs: " +
                    record.relative_path)
            if record.kind == "link-hex":
                val resolved = "{value.source_root}/{record.resolved_path}"
                if not file_is_regular_no_follow(resolved) or
                        file_hash_sha256(resolved) != record.digest:
                    return Err("Phase2 source link target differs")
            else:
                val resolved = "{value.source_root}/{record.resolved_path}"
                if not dir_is_real_no_follow(resolved):
                    return Err("Phase2 source directory link target differs")
            link_count = link_count + 1
    val src_inventory = canonical_identity_sort_texts(src_paths).join("\n") + "\n"
    val full_inventory = canonical_identity_sort_texts(full_paths).join("\n") + "\n"
    val link_inventory = if links.len() == 0: "" else: links.join("\n") + "\n"
    if src_paths.len() != value.source_inventory.count or
            full_paths.len() != value.full_source_inventory.count or
            link_count != value.full_source_links.count or
            sha256_text(src_inventory) != value.source_inventory.digest or
            sha256_text(full_inventory) != value.full_source_inventory.digest or
            sha256_text(link_inventory) != value.full_source_links.digest:
        return Err("Phase2 Stage2 source inventories differ")
    val scv_sources = native_full_inventory_source_paths_v1(
        value.source_root, value.scv.snapshot_root,
        value.scv.revision_id, value.scv.commit_id,
        value.scv.tree_id, value.scv.snapshot_inventory_digest,
        value.scv.source_inventory_digest, value.scv.receipt.digest,
        value.module_inventory.count)?
    val module_inventory = scv_sources.source_identities.join("\n") + "\n"
    if scv_sources.source_count != value.module_inventory.count or
            sha256_text(module_inventory) != value.module_inventory.digest:
        return Err("Phase2 full-SCV module inventory differs")
    Ok(value)

export phase2_native_authority_verify_v1
