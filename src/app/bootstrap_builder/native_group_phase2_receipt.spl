# Readback-checked Phase2 handoff: one source snapshot, one SCV generation,
# and separate Phase3/Phase4 backend-specific V2 index-builder configs.
use app.bootstrap_builder.native_group_index_contract.{
    native_group_index_absolute_v1, native_group_index_config_decode_v1
}
use app.bootstrap_builder.native_group_index_variant.{
    native_group_index_variant_admit_v1
}
use std.common.crypto.sha256.{sha256_text}
use std.common.build_manager.contracts.{builder_digest_valid_v1}
use std.nogc_sync_mut.io.file_ops.{
    file_create_exclusive, file_hash_sha256, file_is_regular_no_follow,
    file_read_regular_no_follow_bounded
}

struct Phase2ReceiptInventoryV1:
    path: text
    digest: text
    count: i64

struct Phase2ReceiptArtifactV1:
    path: text
    digest: text

struct Phase2ReceiptScvV1:
    snapshot_root: text
    receipt: Phase2ReceiptArtifactV1
    revision_id: text
    commit_id: text
    tree_id: text
    snapshot_inventory_digest: text
    source_inventory_digest: text
    source_inventory_generation: i64
    package_policy_digest: text

struct Phase2NativeAuthorityReceiptV1:
    output_root: text
    source_root: text
    target: text
    stage2_receipt: Phase2ReceiptArtifactV1
    stage2_admission_identity: text
    producer: Phase2ReceiptArtifactV1
    source_authority: Phase2ReceiptArtifactV1
    source_inventory: Phase2ReceiptInventoryV1
    full_source_inventory: Phase2ReceiptInventoryV1
    full_source_links: Phase2ReceiptInventoryV1
    module_inventory: Phase2ReceiptInventoryV1
    scv: Phase2ReceiptScvV1
    llvm_index_config: Phase2ReceiptArtifactV1
    cranelift_index_config: Phase2ReceiptArtifactV1
    phase3_llvm_index_config: Phase2ReceiptArtifactV1
    phase3_cranelift_index_config: Phase2ReceiptArtifactV1

fn phase2_native_authority_receipt_encode_v1(
    value: Phase2NativeAuthorityReceiptV1
) -> text:
    var rows = [
        "schema=SIMPLE-PHASE2-NATIVE-AUTHORITY-2",
        "output_root={value.output_root}",
        "source_root={value.source_root}",
        "target={value.target}",
        "stage2_receipt_path={value.stage2_receipt.path}",
        "stage2_receipt_digest={value.stage2_receipt.digest}",
        "stage2_admission_identity={value.stage2_admission_identity}",
        "producer_path={value.producer.path}",
        "producer_digest={value.producer.digest}",
        "source_authority_path={value.source_authority.path}",
        "source_authority_digest={value.source_authority.digest}",
        "source_inventory_path={value.source_inventory.path}",
        "source_inventory_digest={value.source_inventory.digest}",
        "source_inventory_count={value.source_inventory.count}",
        "full_source_inventory_path={value.full_source_inventory.path}",
        "full_source_inventory_digest={value.full_source_inventory.digest}",
        "full_source_inventory_count={value.full_source_inventory.count}",
        "full_source_links_path={value.full_source_links.path}",
        "full_source_links_digest={value.full_source_links.digest}",
        "full_source_links_count={value.full_source_links.count}",
        "module_inventory_path={value.module_inventory.path}",
        "module_inventory_digest={value.module_inventory.digest}",
        "module_inventory_count={value.module_inventory.count}",
        "scv_snapshot_root={value.scv.snapshot_root}",
        "scv_receipt_path={value.scv.receipt.path}",
        "scv_receipt_digest={value.scv.receipt.digest}",
        "scv_revision_id={value.scv.revision_id}",
        "scv_commit_id={value.scv.commit_id}",
        "scv_tree_id={value.scv.tree_id}",
        "scv_snapshot_inventory_digest={value.scv.snapshot_inventory_digest}",
        "scv_source_inventory_digest={value.scv.source_inventory_digest}",
        "scv_source_inventory_generation={value.scv.source_inventory_generation}",
        "package_policy_digest={value.scv.package_policy_digest}",
        "llvm_index_config_path={value.llvm_index_config.path}",
        "llvm_index_config_digest={value.llvm_index_config.digest}",
        "cranelift_index_config_path={value.cranelift_index_config.path}",
        "cranelift_index_config_digest={value.cranelift_index_config.digest}",
        "phase3_llvm_index_config_path={value.phase3_llvm_index_config.path}",
        "phase3_llvm_index_config_digest={value.phase3_llvm_index_config.digest}",
        "phase3_cranelift_index_config_path={value.phase3_cranelift_index_config.path}",
        "phase3_cranelift_index_config_digest={value.phase3_cranelift_index_config.digest}"
    ]
    rows.join("\n") + "\n"

fn _phase2_receipt_number_v1(raw: text, maximum: i64) -> i64:
    val number = raw.to_i64() ?? -1
    if number < 0 or number > maximum or str(number) != raw: -1 else: number

fn phase2_native_authority_receipt_decode_v1(
    payload: text
) -> Result<Phase2NativeAuthorityReceiptV1, text>:
    if payload == "" or payload.len() > 32768 or
            not payload.ends_with("\n") or payload.contains("\r") or
            payload.contains("\0"):
        return Err("Phase2 native authority receipt framing invalid")
    val keys = ["schema", "output_root", "source_root", "target",
        "stage2_receipt_path", "stage2_receipt_digest",
        "stage2_admission_identity", "producer_path", "producer_digest",
        "source_authority_path", "source_authority_digest",
        "source_inventory_path", "source_inventory_digest",
        "source_inventory_count", "full_source_inventory_path",
        "full_source_inventory_digest", "full_source_inventory_count",
        "full_source_links_path", "full_source_links_digest",
        "full_source_links_count", "module_inventory_path",
        "module_inventory_digest", "module_inventory_count",
        "scv_snapshot_root", "scv_receipt_path", "scv_receipt_digest",
        "scv_revision_id", "scv_commit_id", "scv_tree_id",
        "scv_snapshot_inventory_digest", "scv_source_inventory_digest",
        "scv_source_inventory_generation", "package_policy_digest",
        "llvm_index_config_path",
        "llvm_index_config_digest", "cranelift_index_config_path",
        "cranelift_index_config_digest",
        "phase3_llvm_index_config_path",
        "phase3_llvm_index_config_digest",
        "phase3_cranelift_index_config_path",
        "phase3_cranelift_index_config_digest"]
    val rows = payload.split("\n")
    if rows.len() != keys.len() + 1 or rows[rows.len() - 1] != "":
        return Err("Phase2 native authority receipt row count invalid")
    var fields: {text: text} = {}
    for index in 0..keys.len():
        val prefix = keys[index] + "="
        if not rows[index].starts_with(prefix):
            return Err("Phase2 native authority receipt row order invalid")
        val item = rows[index].substring(prefix.len())
        if item == "" or item.len() > 4096:
            return Err("Phase2 native authority receipt row invalid")
        fields[keys[index]] = item
    val source_count = _phase2_receipt_number_v1(
        fields["source_inventory_count"], 200000)
    val full_count = _phase2_receipt_number_v1(
        fields["full_source_inventory_count"], 200000)
    val link_count = _phase2_receipt_number_v1(
        fields["full_source_links_count"], 200000)
    val module_count = _phase2_receipt_number_v1(
        fields["module_inventory_count"], 20000)
    val generation = _phase2_receipt_number_v1(
        fields["scv_source_inventory_generation"], 1000000000)
    if fields["schema"] != "SIMPLE-PHASE2-NATIVE-AUTHORITY-2" or
            source_count < 1 or full_count < source_count or
            link_count < 0 or module_count < 1 or generation < 0:
        return Err("Phase2 native authority receipt count or schema invalid")
    for key in ["output_root", "source_root", "stage2_receipt_path",
            "producer_path", "source_authority_path",
            "source_inventory_path", "full_source_inventory_path",
            "full_source_links_path", "module_inventory_path",
            "scv_snapshot_root", "scv_receipt_path",
            "llvm_index_config_path", "cranelift_index_config_path",
            "phase3_llvm_index_config_path",
            "phase3_cranelift_index_config_path"]:
        if not native_group_index_absolute_v1(fields[key]):
            return Err("Phase2 native authority receipt path invalid: " + key)
    for key in ["stage2_receipt_digest", "stage2_admission_identity",
            "producer_digest", "source_authority_digest",
            "source_inventory_digest", "full_source_inventory_digest",
            "full_source_links_digest", "module_inventory_digest",
            "scv_receipt_digest", "scv_snapshot_inventory_digest",
            "scv_source_inventory_digest", "package_policy_digest",
            "llvm_index_config_digest",
            "cranelift_index_config_digest",
            "phase3_llvm_index_config_digest",
            "phase3_cranelift_index_config_digest"]:
        if not builder_digest_valid_v1(fields[key]):
            return Err("Phase2 native authority receipt digest invalid: " + key)
    val root = fields["output_root"]
    val source = fields["source_root"]
    if source != root + "/source-root" or
            fields["source_authority_path"] !=
                root + "/source-inputs-before.txt" or
            fields["source_inventory_path"] != source + "/source.inventory" or
            fields["full_source_inventory_path"] !=
                source + "/full-source.inventory" or
            fields["full_source_links_path"] !=
                source + "/full-source-links.inventory" or
            fields["module_inventory_path"] != root + "/module.inventory" or
            fields["llvm_index_config_path"] !=
                root + "/index-config-llvm.sdn" or
            fields["cranelift_index_config_path"] !=
                root + "/index-config-cranelift.sdn" or
            fields["phase3_llvm_index_config_path"] !=
                root + "/index-config-phase3-llvm.sdn" or
            fields["phase3_cranelift_index_config_path"] !=
                root + "/index-config-phase3-cranelift.sdn" or
            not fields["scv_snapshot_root"].starts_with(
                source + "/build/scv/snapshots/") or
            not fields["scv_receipt_path"].starts_with(
                source + "/build/scv/"):
        return Err("Phase2 native authority receipt ownership invalid")
    val receipt = Phase2NativeAuthorityReceiptV1(root, source,
        fields["target"],
        Phase2ReceiptArtifactV1(fields["stage2_receipt_path"],
            fields["stage2_receipt_digest"]),
        fields["stage2_admission_identity"],
        Phase2ReceiptArtifactV1(fields["producer_path"],
            fields["producer_digest"]),
        Phase2ReceiptArtifactV1(fields["source_authority_path"],
            fields["source_authority_digest"]),
        Phase2ReceiptInventoryV1(fields["source_inventory_path"],
            fields["source_inventory_digest"], source_count),
        Phase2ReceiptInventoryV1(fields["full_source_inventory_path"],
            fields["full_source_inventory_digest"], full_count),
        Phase2ReceiptInventoryV1(fields["full_source_links_path"],
            fields["full_source_links_digest"], link_count),
        Phase2ReceiptInventoryV1(fields["module_inventory_path"],
            fields["module_inventory_digest"], module_count),
        Phase2ReceiptScvV1(fields["scv_snapshot_root"],
            Phase2ReceiptArtifactV1(fields["scv_receipt_path"],
                fields["scv_receipt_digest"]),
            fields["scv_revision_id"], fields["scv_commit_id"],
            fields["scv_tree_id"],
            fields["scv_snapshot_inventory_digest"],
            fields["scv_source_inventory_digest"], generation,
            fields["package_policy_digest"]),
        Phase2ReceiptArtifactV1(fields["llvm_index_config_path"],
            fields["llvm_index_config_digest"]),
        Phase2ReceiptArtifactV1(fields["cranelift_index_config_path"],
            fields["cranelift_index_config_digest"]),
        Phase2ReceiptArtifactV1(fields["phase3_llvm_index_config_path"],
            fields["phase3_llvm_index_config_digest"]),
        Phase2ReceiptArtifactV1(fields["phase3_cranelift_index_config_path"],
            fields["phase3_cranelift_index_config_digest"]))
    if phase2_native_authority_receipt_encode_v1(receipt) != payload:
        return Err("Phase2 native authority receipt noncanonical")
    Ok(receipt)

fn _phase2_artifact_readback_v1(value: Phase2ReceiptArtifactV1) -> bool:
    file_is_regular_no_follow(value.path) and
        file_hash_sha256(value.path) == value.digest

fn phase2_native_authority_receipt_open_v1(
    receipt_path: text, expected_digest: text
) -> Result<Phase2NativeAuthorityReceiptV1, text>:
    if not builder_digest_valid_v1(expected_digest) or
            not native_group_index_absolute_v1(receipt_path) or
            not file_is_regular_no_follow(receipt_path):
        return Err("Phase2 native authority receipt unavailable")
    val payload = file_read_regular_no_follow_bounded(receipt_path, 32768)?
    if sha256_text(payload) != expected_digest or
            file_hash_sha256(receipt_path) != expected_digest:
        return Err("Phase2 native authority receipt digest differs")
    val value = phase2_native_authority_receipt_decode_v1(payload)?
    if receipt_path != value.output_root + "/authority.receipt" or
            not _phase2_artifact_readback_v1(value.stage2_receipt) or
            not _phase2_artifact_readback_v1(value.producer) or
            not _phase2_artifact_readback_v1(value.source_authority) or
            not _phase2_artifact_readback_v1(
                Phase2ReceiptArtifactV1(value.source_inventory.path,
                    value.source_inventory.digest)) or
            not _phase2_artifact_readback_v1(
                Phase2ReceiptArtifactV1(value.full_source_inventory.path,
                    value.full_source_inventory.digest)) or
            not _phase2_artifact_readback_v1(
                Phase2ReceiptArtifactV1(value.full_source_links.path,
                    value.full_source_links.digest)) or
            not _phase2_artifact_readback_v1(
                Phase2ReceiptArtifactV1(value.module_inventory.path,
                    value.module_inventory.digest)) or
            not _phase2_artifact_readback_v1(value.scv.receipt) or
            not file_is_regular_no_follow(value.scv.snapshot_root +
                "/src/package_ownership/simple.sdn") or
            file_hash_sha256(value.scv.snapshot_root +
                "/src/package_ownership/simple.sdn") !=
                    value.scv.package_policy_digest or
            not _phase2_artifact_readback_v1(value.llvm_index_config) or
            not _phase2_artifact_readback_v1(value.cranelift_index_config) or
            not _phase2_artifact_readback_v1(value.phase3_llvm_index_config) or
            not _phase2_artifact_readback_v1(
                value.phase3_cranelift_index_config):
        return Err("Phase2 native authority artifact digest differs")
    for artifact in [value.llvm_index_config,
            value.cranelift_index_config,
            value.phase3_llvm_index_config,
            value.phase3_cranelift_index_config]:
        val content = file_read_regular_no_follow_bounded(artifact.path, 65536)?
        val config = native_group_index_config_decode_v1(content)?
        val profile = native_group_index_variant_admit_v1(config)?
        val expected_backend = if artifact.path == value.llvm_index_config.path:
            "llvm"
        elif artifact.path == value.phase3_llvm_index_config.path:
            "llvm"
        else:
            "cranelift"
        val expected_phase = if artifact.path ==
                value.phase3_llvm_index_config.path or
                artifact.path == value.phase3_cranelift_index_config.path:
            "phase3"
        else:
            "phase4"
        if config.source_root != value.source_root or
                config.snapshot_root != value.scv.snapshot_root or
                config.scv_revision_id != value.scv.revision_id or
                config.scv_commit_id != value.scv.commit_id or
                config.scv_tree_id != value.scv.tree_id or
                config.scv_receipt_path != value.scv.receipt.path or
                config.scv_receipt_digest != value.scv.receipt.digest or
                config.snapshot_inventory_digest !=
                    value.scv.snapshot_inventory_digest or
                config.source_inventory_digest !=
                    value.scv.source_inventory_digest or
                config.source_inventory_generation !=
                    value.scv.source_inventory_generation or
                config.expected_spl_count != value.module_inventory.count or
                config.full_source_authority_path !=
                    value.source_authority.path or
                config.full_source_authority_digest !=
                    value.source_authority.digest or
                config.producer_path != value.producer.path or
                config.producer_digest != value.producer.digest or
                config.phase != expected_phase or
                config.backend != expected_backend or
                config.target != value.target or profile.digest !=
                    config.variant_digest:
            return Err("Phase2 native authority index config differs")
    Ok(value)

fn phase2_native_authority_receipt_publish_v1(
    receipt_path: text, value: Phase2NativeAuthorityReceiptV1
) -> Result<text, text>:
    val payload = phase2_native_authority_receipt_encode_v1(value)
    val decoded = phase2_native_authority_receipt_decode_v1(payload)?
    if receipt_path != decoded.output_root + "/authority.receipt" or
            not file_create_exclusive(receipt_path, payload):
        return Err("Phase2 native authority receipt publication failed")
    val digest = sha256_text(payload)
    val readback = phase2_native_authority_receipt_open_v1(
        receipt_path, digest)?
    if readback.module_inventory.count != value.module_inventory.count:
        return Err("Phase2 native authority receipt readback differs")
    Ok(digest)

fn phase2_native_authority_field_v1(
    receipt_path: text, expected_digest: text, field: text
) -> Result<text, text>:
    val value = phase2_native_authority_receipt_open_v1(
        receipt_path, expected_digest)?
    match field:
        case "source_root": Ok(value.source_root)
        case "scv_receipt_path": Ok(value.scv.receipt.path)
        case "source_inventory_path": Ok(value.source_inventory.path)
        case "module_inventory_path": Ok(value.module_inventory.path)
        case "full_source_inventory_path": Ok(value.full_source_inventory.path)
        case "full_source_links_path": Ok(value.full_source_links.path)
        case "llvm_index_config_path": Ok(value.llvm_index_config.path)
        case "cranelift_index_config_path": Ok(value.cranelift_index_config.path)
        case "phase3_llvm_index_config_path":
            Ok(value.phase3_llvm_index_config.path)
        case "phase3_cranelift_index_config_path":
            Ok(value.phase3_cranelift_index_config.path)
        case "producer_digest": Ok(value.producer.digest)
        case "target": Ok(value.target)
        case _: Err("Phase2 native authority field unsupported")

export Phase2ReceiptInventoryV1, Phase2ReceiptArtifactV1
export Phase2ReceiptScvV1, Phase2NativeAuthorityReceiptV1
export phase2_native_authority_receipt_encode_v1
export phase2_native_authority_receipt_decode_v1
export phase2_native_authority_receipt_open_v1
export phase2_native_authority_receipt_publish_v1
export phase2_native_authority_field_v1
