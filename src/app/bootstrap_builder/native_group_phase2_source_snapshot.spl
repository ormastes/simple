# Copy one Stage2 file-hex authority into a private full-source snapshot.
# Link rows are explicit; missing or escaping links fail closed.

use app.io.file_ops.{path_absolute}
use app.bootstrap_builder.native_group_phase2_source_contract.{
    Phase2SourceRecordV1
}
use app.bootstrap_builder.native_group_phase2_tree_admission.{
    phase2_checkout_tree_admit_v1
}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.utf8.{text_byte_len}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use std.common.build_manager.contracts.{
    builder_digest_valid_v1, builder_relative_path_valid_v1
}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.scv.compile_source_inventory_core.{
    CompileSourceInventoryEntryV1, compile_source_inventory_identity_cmp_v1,
    compile_source_inventory_path_valid_v1,
    compile_source_inventory_filesystem_event_v1
}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_is_real_no_follow}
use std.nogc_sync_mut.io.file_ops.{
    file_is_regular_no_follow, file_read_regular_no_follow_bounded,
    file_read_regular_no_follow_bounded_bytes, file_write_bytes,
    file_publish_noreplace, file_hash_sha256, file_create_exclusive,
    file_exists
}
use std.nogc_sync_mut.io.snapshot_links.{
    snapshot_symlink_create_nofollow_v1,
    snapshot_symlink_match_nofollow_v1,
    snapshot_readonly_nofollow_v1
}
use std.nogc_sync_mut.package_sffi.{set_permissions}

val PHASE2_AUTHORITY_MAX_BYTES_V1: i64 = 64 * 1024 * 1024
val PHASE2_AUTHORITY_MAX_FILES_V1: i64 = 200000
val PHASE2_AUTHORITY_MAX_FILE_BYTES_V1: i64 = 256 * 1024 * 1024

struct Phase2SourceSnapshotV1:
    source_root: text
    source_inventory_path: text
    source_inventory_digest: text
    source_count: i64
    authority_digest: text
    full_source_inventory_path: text
    full_source_inventory_digest: text
    full_source_count: i64
    full_source_links_path: text
    full_source_links_digest: text
    link_count: i64
    full_regular_paths: [text]
    link_records: [Phase2SourceRecordV1]
    source_entries: [CompileSourceInventoryEntryV1]

fn _phase2_hex_digit_v1(value: text) -> i64:
    val code = value.byte_at(0) as i64
    if code >= 48 and code <= 57: return code - 48
    if code >= 97 and code <= 102: return code - 87
    -1

fn _phase2_hex_text_v1(value: text) -> Result<text, text>:
    if value == "" or value.len() > 8192 or value.len() % 2 != 0:
        return Err("phase2 source authority hex bound invalid")
    var bytes: [u8] = []
    var index = 0
    while index < value.len():
        val hi = _phase2_hex_digit_v1(value[index:index + 1])
        val lo = _phase2_hex_digit_v1(value[index + 1:index + 2])
        if hi < 0 or lo < 0:
            return Err("phase2 source authority hex invalid")
        bytes = bytes.push((hi * 16 + lo).to_u8())
        index = index + 2
    validated_utf8_bytes_to_text_linear(bytes)

fn _phase2_relative_valid_v1(value: text) -> bool:
    if not builder_relative_path_valid_v1(value) or
            value == "" or value.len() > 4096 or
            value.starts_with("/") or value.ends_with("/") or
            value.contains("\\") or value.contains(":") or
            value.contains("\0") or value.contains("\r") or
            value.contains("\n") or value.contains("//"):
        return false
    for part in value.split("/"):
        if part == "" or part == "." or part == "..": return false
    value.starts_with("src/") or value.starts_with("examples/10_tooling/")

fn _phase2_link_target_valid_v1(value: text) -> bool:
    value != "" and value.len() <= 4096 and
        not value.starts_with("/") and not value.contains("\\") and
        not value.contains("\0") and not value.contains("\r") and
        not value.contains("\n") and not value.contains("\t") and
        not value.contains(":") and not value.contains("|") and
        not value.contains("//") and not value.ends_with("/")

fn phase2_source_authority_decode_v1(
    content: text
) -> Result<[Phase2SourceRecordV1], text>:
    if content == "" or content.len() > PHASE2_AUTHORITY_MAX_BYTES_V1 or
            not content.ends_with("\n") or content.contains("\r"):
        return Err("phase2 source authority framing invalid")
    val lines = content.split("\n")
    if lines.len() < 2 or lines.len() > PHASE2_AUTHORITY_MAX_FILES_V1 + 1:
        return Err("phase2 source authority count invalid")
    var records: [Phase2SourceRecordV1] = []
    var seen_paths: Dict<text, bool> = {}
    var seen_folded: Dict<text, bool> = {}
    var previous = ""
    var index = 0
    while index < lines.len() - 1:
        val line = lines[index]
        if line == "" or (previous != "" and
                compile_source_inventory_identity_cmp_v1(line, previous) <= 0):
            return Err("phase2 source authority order invalid")
        previous = line
        val fields = line.split(":")
        if fields.len() < 4:
            return Err("phase2 source authority row invalid")
        val kind = fields[0]
        if kind == "link-missing-hex":
            return Err("phase2 source authority missing link unsupported")
        if (kind == "file-hex" and fields.len() != 5) or
                (kind == "link-hex" and fields.len() != 5) or
                (kind == "link-dir-hex" and fields.len() != 4) or
                (kind != "file-hex" and kind != "link-hex" and
                    kind != "link-dir-hex"):
            return Err("phase2 source authority row invalid")
        val relative_hex = if kind == "file-hex": fields[2] else: fields[1]
        val relative = _phase2_hex_text_v1(relative_hex)?
        if not _phase2_relative_valid_v1(relative) or
                seen_paths.has(relative) or seen_folded.has(relative.lower()):
            return Err("phase2 source authority path invalid or duplicated")
        seen_paths[relative] = true
        seen_folded[relative.lower()] = true
        if kind == "file-hex":
            val declared_len = fields[1].to_i64() ?? -1
            if declared_len < 1 or str(declared_len) != fields[1] or
                    declared_len != text_byte_len(relative) or
                    (fields[3] != "0" and fields[3] != "1") or
                    not builder_digest_valid_v1(fields[4]):
                return Err("phase2 source authority file row invalid")
            records = records.push(Phase2SourceRecordV1(
                kind, relative, fields[4], fields[3] == "1", "", ""))
        else:
            val target = _phase2_hex_text_v1(fields[2])?
            val resolved = _phase2_hex_text_v1(fields[3])?
            if not _phase2_link_target_valid_v1(target) or
                    not _phase2_relative_valid_v1(resolved) or
                    (kind == "link-hex" and
                        not builder_digest_valid_v1(fields[4])):
                return Err("phase2 source authority link row invalid")
            records = records.push(Phase2SourceRecordV1(
                kind, relative, if kind == "link-hex": fields[4] else: "",
                false, target, resolved))
        index = index + 1
    if lines[lines.len() - 1] != "":
        return Err("phase2 source authority ending invalid")
    Ok(records)

fn _phase2_snapshot_ancestors_real_v1(root: text, relative: text) -> bool:
    if not dir_is_real_no_follow(root): return false
    val parts = relative.split("/")
    var current = root
    var index = 0
    while index < parts.len() - 1:
        current = "{current}/{parts[index]}"
        if not dir_is_real_no_follow(current): return false
        index = index + 1
    true

fn _phase2_snapshot_parent_create_v1(root: text, relative: text) -> bool:
    val parts = relative.split("/")
    var current = root
    var index = 0
    while index < parts.len() - 1:
        current = "{current}/{parts[index]}"
        if not dir_create_all(current) or not dir_is_real_no_follow(current):
            return false
        index = index + 1
    true

fn phase2_source_snapshot_publish_v1(
    checkout_root: text,
    authority_path: text,
    authority_digest: text,
    source_root: text
) -> Result<Phase2SourceSnapshotV1, text>:
    if checkout_root == "" or source_root == "" or
            not builder_digest_valid_v1(authority_digest) or
            not file_is_regular_no_follow(authority_path) or
            file_hash_sha256(authority_path) != authority_digest or
            (file_exists(source_root) or dir_is_real_no_follow(source_root)) or
            not dir_create_all(source_root) or
            not dir_is_real_no_follow(source_root):
        return Err("phase2 source snapshot authority or private root invalid")
    val content = file_read_regular_no_follow_bounded(
        authority_path, PHASE2_AUTHORITY_MAX_BYTES_V1)?
    if sha256_text(content) != authority_digest:
        return Err("phase2 source authority changed during read")
    val records = phase2_source_authority_decode_v1(content)?
    val _complete_checkout = phase2_checkout_tree_admit_v1(
        checkout_root, records)?
    var source_paths: [text] = []
    var full_regular_paths: [text] = []
    var link_records: [Phase2SourceRecordV1] = []
    var source_entries: [CompileSourceInventoryEntryV1] = []
    var src_files = 0
    var os_files = 0
    var runtime_files = 0
    var policy_files = 0
    var module_role_files = 0
    for record in records:
        if record.kind != "file-hex": continue
        full_regular_paths = full_regular_paths.push(record.relative_path)
        if not _phase2_snapshot_ancestors_real_v1(
                checkout_root, record.relative_path) or
                not _phase2_snapshot_parent_create_v1(
                    source_root, record.relative_path):
            return Err("phase2 source snapshot ancestor is not a real directory")
        val original = "{checkout_root}/{record.relative_path}"
        val destination = "{source_root}/{record.relative_path}"
        if not file_is_regular_no_follow(original) or
                file_hash_sha256(original) != record.digest or
                file_exists(destination):
            return Err("phase2 source snapshot original differs")
        val bytes = file_read_regular_no_follow_bounded_bytes(
            original, PHASE2_AUTHORITY_MAX_FILE_BYTES_V1)?
        if not file_write_bytes(destination + ".phase2-staging", bytes) or
                file_hash_sha256(destination + ".phase2-staging") !=
                    record.digest:
            return Err("phase2 source snapshot staging differs")
        val published = file_publish_noreplace(
            destination + ".phase2-staging", destination)
        if published.is_err() or not published.unwrap() or
                not file_is_regular_no_follow(destination) or
                file_hash_sha256(destination) != record.digest or
                file_hash_sha256(original) != record.digest or
                not set_permissions(destination,
                    if record.executable: 365 else: 292) or
                not snapshot_readonly_nofollow_v1(destination, 1):
            return Err("phase2 source snapshot publication differs")
        if record.relative_path.starts_with("src/") and
                compile_source_inventory_path_valid_v1(
                    record.relative_path):
            val source_text = validated_utf8_bytes_to_text_linear(bytes)?
            val event = compile_source_inventory_filesystem_event_v1(
                "add", record.relative_path, source_text)
            if event.content_digest != record.digest or
                    event.byte_count != bytes.len():
                return Err("phase2 compiler source facet differs")
            source_entries = source_entries.push(
                CompileSourceInventoryEntryV1(record.relative_path,
                    event.content_digest, event.semantic_digest,
                    event.export_digest, event.initializer_digest,
                    event.provider_digest, event.byte_count))
        if record.relative_path.starts_with("src/"):
            source_paths = source_paths.push(record.relative_path)
            src_files = src_files + 1
        if record.relative_path.starts_with("src/os/"):
            os_files = os_files + 1
        if record.relative_path.starts_with("src/runtime/"):
            runtime_files = runtime_files + 1
        if record.relative_path == "src/package_ownership/simple.sdn":
            policy_files = policy_files + 1
        if record.relative_path ==
                "src/package_ownership/native_module_roles.sdn":
            module_role_files = module_role_files + 1
    if src_files == 0 or os_files == 0 or runtime_files == 0 or
            policy_files != 1 or module_role_files != 1:
        return Err("phase2 source snapshot required roots absent")
    for record in records:
        if record.kind == "file-hex":
            continue
        link_records = link_records.push(record)
        if not _phase2_snapshot_ancestors_real_v1(
                checkout_root, record.relative_path) or
                not _phase2_snapshot_parent_create_v1(
                    source_root, record.relative_path):
            return Err("phase2 source snapshot link ancestor invalid")
        val target = "{source_root}/{record.resolved_path}"
        if record.kind == "link-hex" and
                (not file_is_regular_no_follow(target) or
                    file_hash_sha256(target) != record.digest):
            return Err("phase2 source snapshot link target differs")
        if record.kind == "link-dir-hex" and
                not dir_is_real_no_follow(target):
            return Err("phase2 source snapshot link directory absent")
        val destination = "{source_root}/{record.relative_path}"
        val original = "{checkout_root}/{record.relative_path}"
        val original_resolved = path_absolute(original).replace("\\", "/")
        val expected_original = path_absolute(
            "{checkout_root}/{record.resolved_path}").replace("\\", "/")
        if original_resolved == "" or expected_original == "" or
                original_resolved != expected_original or
                file_is_regular_no_follow(original) or
                dir_is_real_no_follow(original) or
                not snapshot_symlink_match_nofollow_v1(
                    checkout_root, original, record.link_target,
                    if record.kind == "link-dir-hex": 2 else: 1):
            return Err("phase2 source snapshot original link differs")
        val kind = if record.kind == "link-dir-hex": 2 else: 1
        if file_exists(destination) or
                not snapshot_symlink_create_nofollow_v1(
                    source_root, destination, record.link_target, kind) or
                not snapshot_symlink_match_nofollow_v1(
                    source_root, destination, record.link_target, kind):
            return Err("phase2 source snapshot link publication failed")
        val resolved = path_absolute(destination).replace("\\", "/")
        val expected = path_absolute(target).replace("\\", "/")
        if resolved == "" or expected == "" or resolved != expected:
            return Err("phase2 source snapshot link escaped or differed")
    val inventory = canonical_identity_sort_texts(source_paths).join("\n") + "\n"
    val inventory_path = "{source_root}/source.inventory"
    if not file_create_exclusive(inventory_path, inventory) or
            file_hash_sha256(inventory_path) != sha256_text(inventory) or
            not snapshot_readonly_nofollow_v1(inventory_path, 1):
        return Err("phase2 source snapshot inventory publication failed")
    val full_inventory = canonical_identity_sort_texts(
        full_regular_paths).join("\n") + "\n"
    val full_inventory_path = "{source_root}/full-source.inventory"
    if not file_create_exclusive(full_inventory_path, full_inventory) or
            file_hash_sha256(full_inventory_path) !=
                sha256_text(full_inventory) or
            not snapshot_readonly_nofollow_v1(full_inventory_path, 1):
        return Err("phase2 full source inventory publication failed")
    var link_lines: [text] = []
    for line in content.split("\n"):
        if line.starts_with("link-hex:") or
                line.starts_with("link-dir-hex:"):
            link_lines = link_lines.push(line)
    if link_lines.len() != link_records.len():
        return Err("phase2 source link inventory count differs")
    val links_inventory = if link_lines.len() == 0:
        ""
    else:
        link_lines.join("\n") + "\n"
    val links_path = "{source_root}/full-source-links.inventory"
    if not file_create_exclusive(links_path, links_inventory) or
            file_hash_sha256(links_path) != sha256_text(links_inventory) or
            not snapshot_readonly_nofollow_v1(links_path, 1):
        return Err("phase2 source link inventory publication failed")
    Ok(Phase2SourceSnapshotV1(source_root, inventory_path,
        sha256_text(inventory), src_files, authority_digest,
        full_inventory_path, sha256_text(full_inventory),
        full_regular_paths.len(), links_path,
        sha256_text(links_inventory), link_records.len(),
        canonical_identity_sort_texts(full_regular_paths), link_records,
        source_entries))

export PHASE2_AUTHORITY_MAX_BYTES_V1, PHASE2_AUTHORITY_MAX_FILES_V1
export Phase2SourceRecordV1, Phase2SourceSnapshotV1
export phase2_source_authority_decode_v1, phase2_source_snapshot_publish_v1
