# All remote authority comes from an explicitly supplied, validated host record.
# Source files are copied and checked before worker launch; workers never share
# writable cache/output directories. A timeout observing a worker is not death.
use app.bootstrap_builder.contracts.{BuildTaskV1, BuildHostV1, BuildResultV1, builder_validate_task_v1, builder_validate_host_v1, builder_validate_result_v1, builder_task_identity_v1, builder_relative_path_valid_v1}
use app.bootstrap_builder.codec.{builder_write_task_v1, builder_read_task_v1,
    builder_read_result_v1, builder_encode_result_v1}
use app.bootstrap_builder.process_port.{BuilderProcessPortV1}
use app.bootstrap_builder.link_inputs.{builder_link_inputs_stage_v1,
    builder_regular_input_parents_safe_v1, builder_link_inputs_match_v1}
use std.common.build_manager.no_child_started.{builder_no_child_started_decode_v1}
use std.common.build_manager.capacity_request.{BuilderCapacityRequestV1,
    builder_capacity_request_encode_v1, builder_linux_parent_receipt_decode_v1}
use app.io.file_ops.{file_exists, file_is_regular_no_follow, file_hash_sha256,
    file_copy, file_delete, file_create_exclusive, file_atomic_write,
    file_read_regular_no_follow_bounded, path_absolute}
use app.io.process_ops.{process_run_timeout}
use app.io.env_ops.{host_os}
use app.io.time_ops.{current_time_ms, sleep_ms}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.dir_ops.{
    dir_walk_native, dir_create_all, dir_is_real_no_follow
}

pub struct BuilderAttemptV1:
    task_id: text
    attempt: i64
    host: BuildHostV1
    pid: i64
    local_root: text
    remote_root: text
    error: text
    identity_digest: text
    process: BuilderProcessPortV1

struct BuilderTerminalObservationV1:
    root: text
    identity_digest: text
    exit_code: i64

var _builder_terminal_observations_v1: [BuilderTerminalObservationV1] = []

# A native wait can consume its process handle before the result/reap files can
# be transferred. Retain that observation independently; never reuse its token.
# Attempt directories are exclusive and identity binds every observation.
fn builder_transport_wait_v1(attempt: BuilderAttemptV1, timeout_ms: i64) -> i64:
    for observation in _builder_terminal_observations_v1:
        if observation.root == attempt.local_root and observation.identity_digest == attempt.identity_digest:
            return observation.exit_code
    val code = match attempt.process.wait_operation(attempt.pid, timeout_ms):
        Ok(value): value
        Err(_message): return -1
    if code >= 0:
        _builder_terminal_observations_v1 = _builder_terminal_observations_v1.push(BuilderTerminalObservationV1(
            root: attempt.local_root, identity_digest: attempt.identity_digest, exit_code: code))
    code

pub fn builder_transport_parent_v1(path: text) -> text:
    val parts = path.replace("\\", "/").split("/")
    var parent = ""
    var index = 0
    while index + 1 < parts.len():
        if index > 0: parent = parent + "/"
        parent = parent + parts[index]
        index = index + 1
    parent

pub fn builder_transport_shell_quote_v1(value: text) -> text:
    "'" + value.replace("'", "'\"'\"'") + "'"

# SCP's remote path is a second protocol boundary. Restrict it to a portable
# absolute path alphabet; do not rely on an implementation's legacy shell mode.
pub fn builder_transport_remote_path_valid_v1(path: text) -> bool:
    if not path.starts_with("/") or path.contains("//"): return false
    for part in path.split("/"):
        if part == "." or part == "..": return false
    var index = 0
    while index < path.len():
        val ch = path[index:index + 1]
        if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_-.".contains(ch): return false
        index = index + 1
    true

fn builder_transport_ssh_v1(host: BuildHostV1, command: text) -> (text, text, i32):
    process_run_timeout("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "--", host.endpoint, command], 30000)

fn builder_transport_copy_v1(source: text, destination: text, digest: text) -> text:
    if not file_is_regular_no_follow(source) or file_hash_sha256(source) != digest:
        return "source digest mismatch: " + source
    if not dir_create_all(builder_transport_parent_v1(destination)):
        return "cannot create staging directory"
    if not file_copy(source, destination): return "cannot stage: " + source
    if not file_is_regular_no_follow(destination) or file_hash_sha256(destination) != digest:
        return "staged digest mismatch: " + destination
    ""

# Cache reuse is a copy from a completed prior attempt, never a writable share.
# Include all task fields (except attempt) in compatibility and require the old
# worker's exact sealed tree-reaped receipt before even enumerating its cache.
fn builder_transport_retry_cache_v1(task: BuildTaskV1, host: BuildHostV1, run_root: text, target: text, process: BuilderProcessPortV1) -> text:
    if task.attempt <= 1: return ""
    val prior_root = run_root + "/attempts/" + task.id + "/" + str(task.attempt - 1) + "/" + host.id
    var previous = match builder_read_task_v1(prior_root + "/request.sdn"):
        Ok(value): value
        Err(_message): return ""
    val old_identity = builder_task_identity_v1(previous)
    previous.attempt = task.attempt
    if builder_task_identity_v1(previous) != builder_task_identity_v1(task): return ""
    val prior = BuilderAttemptV1(task_id: task.id, attempt: task.attempt - 1,
        host: host, pid: 0, local_root: prior_root,
        remote_root: host.workspace + "/attempts/" + task.id + "/" + str(task.attempt - 1) + "/" + host.id,
        error: "", identity_digest: old_identity, process: process)
    if not builder_transport_reaped_v1(prior): return ""
    if host.transport == "ssh":
        # This runs after the fresh remote workspace has been staged.
        val from_path = prior.remote_root + "/work/.builder-cache"
        val to_path = host.workspace + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id + "/work/.builder-cache"
        val command = "if test -d " + builder_transport_shell_quote_v1(from_path) + "; then cp -R -- " + builder_transport_shell_quote_v1(from_path) + " " + builder_transport_shell_quote_v1(to_path) + "; fi"
        if builder_transport_ssh_v1(host, command).2 != 0: return "cannot copy reaped remote attempt cache"
        return ""
    val cache_root = prior_root + "/work/.builder-cache/"
    val paths = dir_walk_native(cache_root)
    if paths.len() > 100000: return "retry cache snapshot exceeds file bound"
    for path in paths:
        val normalized = path.replace("\\", "/")
        if not normalized.starts_with(cache_root): return "cache walk escaped attempt directory"
        if file_is_regular_no_follow(normalized):
            val relative = normalized[cache_root.len():]
            val error = builder_transport_copy_v1(normalized, target + "/work/.builder-cache/" + relative, file_hash_sha256(normalized))
            if error != "": return error
    ""

pub fn builder_transport_start_v1(task: BuildTaskV1, host: BuildHostV1, source_root: text, run_root: text, process: BuilderProcessPortV1) -> BuilderAttemptV1:
    val root = run_root + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
    val remote = host.workspace + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
    var result = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
        host: host, pid: -1, local_root: root, remote_root: remote, error: "",
        identity_digest: builder_task_identity_v1(task), process: process)
    result.error = builder_validate_task_v1(task)
    if result.error == "": result.error = builder_validate_host_v1(host)
    if result.error != "": return result
    if host.transport != "local" and task.links.len() > 0:
        result.error = "typed links require local no-follow staging"
        return result
    if host.transport == "local":
        if not file_is_regular_no_follow(host.worker_program) or file_hash_sha256(host.worker_program) != host.worker_digest:
            result.error = "configured worker image digest mismatch"
            return result
    else:
        val quoted_worker = builder_transport_shell_quote_v1(host.worker_program)
        val measured = builder_transport_ssh_v1(host, "test -f " + quoted_worker + " && ! test -L " + quoted_worker + " && sha256sum -- " + quoted_worker)
        if measured.2 != 0 or measured.0.split(" ")[0] != host.worker_digest:
            result.error = "configured remote worker image digest mismatch"
            return result
    if host.transport == "ssh" and not builder_transport_remote_path_valid_v1(remote):
        result.error = "SSH workspace must use a portable absolute path"
        return result
    if not dir_create_all(root) or not file_create_exclusive(root + "/attempt.claim", "claimed\n"):
        result.error = "attempt directory already claimed or unavailable"
        return result
    if not dir_create_all(root + "/work"):
        result.error = "cannot create attempt workspace"
        return result
    if not builder_regular_input_parents_safe_v1(task, source_root):
        result.error = "source input parent is a symlink or reparse point"
        return result
    var program = task.program
    if not program.starts_with("/") and not program.contains(":"):
        program = source_root + "/" + program
    result.error = builder_transport_copy_v1(program, root + "/producer.exe", task.producer_digest)
    if result.error != "": return result
    for input in task.inputs:
        if file_exists(run_root + "/cancel.request"):
            result.error = "dispatch cancelled before worker launch"
            return result
        result.error = builder_transport_copy_v1(source_root + "/" + input.path, root + "/work/" + input.path, input.digest)
        if result.error != "": return result
    if not builder_regular_input_parents_safe_v1(task, root + "/work"):
        result.error = "staged input parent is a symlink or reparse point"
        return result
    result.error = builder_link_inputs_stage_v1(task, source_root, root + "/work")
    if result.error != "": return result
    for output in task.outputs:
        if not dir_create_all(builder_transport_parent_v1(root + "/work/" + output)):
            result.error = "cannot create output directory"
            return result
    if not builder_write_task_v1(root + "/request.sdn", task):
        result.error = "cannot persist task before launch"
        return result
    val capacity_request = builder_capacity_request_encode_v1(BuilderCapacityRequestV1(
        result.identity_digest, host.id, "owned-platform-boundary-v1"))
    if capacity_request == "" or not file_create_exclusive(root + "/capacity.request.sdn", capacity_request):
        result.error = "cannot persist owned capacity authority before launch"
        return result
    if host.transport == "local":
        result.error = builder_transport_retry_cache_v1(task, host, run_root, root, process)
        if result.error != "": return result
        if host_os() != "windows":
            val executable_mode = process_run_timeout("chmod", ["500", "--", root + "/producer.exe"], 10000)
            if executable_mode.2 != 0:
                result.error = "cannot make staged producer executable"
                return result
        if file_exists(run_root + "/cancel.request"):
            result.error = "dispatch cancelled before worker launch"
            return result
        match process.spawn_operation(host.worker_program, host.worker_digest, ["worker", "--request", root + "/request.sdn", "--attempt-root", root, "--host", host.id], root + "/work"):
            Ok(token): result.pid = token
            Err(message):
                result.error = message
                return result
    else:
        # mkdir without -p at the final component is the remote exclusive claim.
        val prepare = "mkdir -p -- " + builder_transport_shell_quote_v1(builder_transport_parent_v1(remote)) + " && mkdir -- " + builder_transport_shell_quote_v1(remote)
        if builder_transport_ssh_v1(host, prepare).2 != 0:
            result.error = "remote attempt already claimed or unavailable"
            return result
        val stage = process_run_timeout("scp", ["-q", "-r", "-o", "BatchMode=yes", "--", root + "/.", host.endpoint + ":" + remote + "/"], 300000)
        if stage.2 != 0:
            result.error = "remote immutable staging failed"
            return result
        result.error = builder_transport_retry_cache_v1(task, host, run_root, root, process)
        if result.error != "": return result
        val command = "chmod 500 -- " + builder_transport_shell_quote_v1(remote + "/producer.exe") + " && exec " + builder_transport_shell_quote_v1(host.worker_program) + " worker --request " + builder_transport_shell_quote_v1(remote + "/request.sdn") + " --attempt-root " + builder_transport_shell_quote_v1(remote) + " --host " + builder_transport_shell_quote_v1(host.id)
        match process.spawn_operation("ssh", "", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "--", host.endpoint, command], root + "/work"):
            Ok(token): result.pid = token
            Err(message):
                result.error = message
                return result
    if result.pid <= 0: result.error = "worker launch failed"
    result

# Terminal leader observation is retained while exact tree proof is pending.
pub fn builder_transport_poll_v1(attempt: BuilderAttemptV1) -> i64:
    if attempt.pid == 0:
        if builder_transport_terminal_v1(attempt):
            match builder_transport_collect_v1(attempt):
                Ok(result): return result.exit_code
                Err(_message): return -2
        val _live = builder_transport_control_v1(attempt, "probe")
        return -2
    if attempt.pid < 0: return -1
    val code = builder_transport_wait_v1(attempt, 1)
    if code == -2 or code == -1: return code
    if not builder_transport_terminal_v1(attempt): return -2
    code

pub fn builder_transport_collect_v1(attempt: BuilderAttemptV1) -> Result<BuildResultV1, text>:
    if attempt.error != "": return Err(attempt.error)
    if attempt.host.transport == "ssh":
        val copied = process_run_timeout("scp", ["-q", "-o", "BatchMode=yes", "--", attempt.host.endpoint + ":" + attempt.remote_root + "/result.sdn", attempt.local_root + "/result.sdn"], 30000)
        if copied.2 != 0: return Err("remote result unavailable; execution state remains unknown")
    val result = builder_read_result_v1(attempt.local_root + "/result.sdn")?
    if result.task_id != attempt.task_id or result.attempt != attempt.attempt or result.host_id != attempt.host.id:
        return Err("worker result identity does not match transport")
    if attempt.host.transport == "ssh":
        for output in result.outputs:
            val copied = process_run_timeout("scp", ["-q", "-o", "BatchMode=yes", "--", attempt.host.endpoint + ":" + attempt.remote_root + "/work/" + output.path, attempt.local_root + "/work/" + output.path], 300000)
            if copied.2 != 0: return Err("remote output unavailable: " + output.path)
    for output in result.outputs:
        val path = attempt.local_root + "/work/" + output.path
        if not file_is_regular_no_follow(path) or file_hash_sha256(path) != output.digest:
            return Err("transport output digest mismatch: " + output.path)
    Ok(result)

# Cancellation asks the worker, which owns the compiler tree, to kill+reap it.
# Never kill just the SSH client and mistake its exit for remote tree cleanup.
pub fn builder_transport_cancel_v1(attempt: BuilderAttemptV1) -> bool:
    if attempt.pid == 0:
        val _acknowledged = builder_transport_control_v1(attempt, "cancel")
        val deadline = current_time_ms() + 30000
        while current_time_ms() < deadline:
            if builder_transport_terminal_v1(attempt): return true
            sleep_ms(100)
        return false
    if attempt.pid < 0: return false
    if attempt.host.transport == "local":
        if not file_atomic_write(attempt.local_root + "/cancel.request", "cancel\n"): return false
    else:
        val command = "printf cancel > " + builder_transport_shell_quote_v1(attempt.remote_root + "/cancel.request")
        if builder_transport_ssh_v1(attempt.host, command).2 != 0: return false
    val code = builder_transport_wait_v1(attempt, 30000)
    if code == -2 or code == -1: return false
    builder_transport_terminal_v1(attempt)

fn builder_transport_read_control_v1(attempt: BuilderAttemptV1, name: text, limit: i64 = 4096) -> text:
    if attempt.host.transport == "ssh":
        val copied = process_run_timeout("scp", ["-q", "-o", "BatchMode=yes", "--", attempt.host.endpoint + ":" + attempt.remote_root + "/" + name, attempt.local_root + "/" + name], 10000)
        if copied.2 != 0: return ""
    match file_read_regular_no_follow_bounded(attempt.local_root + "/" + name, limit):
        Ok(value): value
        Err(_message): ""

pub fn builder_transport_reaped_v1(attempt: BuilderAttemptV1) -> bool:
    if builder_transport_read_control_v1(attempt, "compiler.reaped") != attempt.identity_digest + "\n" + attempt.host.id:
        return false
    builder_transport_capacity_released_v1(attempt)

fn builder_transport_capacity_released_v1(attempt: BuilderAttemptV1) -> bool:
    val acquired = builder_transport_read_control_v1(attempt, "capacity.receipt")
    # Windows owns a JobObject, and a rejected acquisition owns no Linux parent.
    if acquired == "": return true
    match builder_linux_parent_receipt_decode_v1(acquired, attempt.identity_digest, attempt.host.id):
        Ok(_): pass
        Err(_): return false
    builder_transport_read_control_v1(attempt, "capacity.released") == acquired

# A no-child certificate is NOT a tree-reap receipt. It is admissible only with
# the exact ERROR result and no accepted outputs for this same task attempt.
pub fn builder_transport_no_child_started_v1(attempt: BuilderAttemptV1) -> bool:
    val payload = builder_transport_read_control_v1(attempt, "compiler.not-started.sdn", 262144)
    val proof = match builder_no_child_started_decode_v1(payload):
        Ok(value): value
        Err(_message): return false
    if proof.identity_digest != attempt.identity_digest or proof.host_id != attempt.host.id: return false
    if not builder_transport_capacity_released_v1(attempt): return false
    val result = match builder_transport_collect_v1(attempt):
        Ok(value): value
        Err(_message): return false
    result.identity_digest == attempt.identity_digest and result.status == "ERROR" and result.exit_code != 0 and result.outputs.len() == 0

pub fn builder_transport_terminal_v1(attempt: BuilderAttemptV1) -> bool:
    builder_transport_reaped_v1(attempt) or builder_transport_no_child_started_v1(attempt)

fn builder_transport_input_parent_safe_v1(work: text, relative: text,
        process: BuilderProcessPortV1) -> bool:
    val parts = relative.split("/")
    if host_os() == "windows":
        var prefix = work
        for index in 0..parts.len() - 1:
            prefix = prefix + "/" + parts[index]
            if not process.directory_no_follow_operation(prefix): return false
        return true
    val canonical_work = path_absolute(work).replace("\\", "/")
    if canonical_work == "": return false
    var prefix = work
    for index in 0..parts.len() - 1:
        prefix = prefix + "/" + parts[index]
        val expected = canonical_work + prefix[work.len():]
        if path_absolute(prefix).replace("\\", "/") != expected: return false
    true

fn builder_transport_work_root_safe_v1(work: text,
        process: BuilderProcessPortV1) -> bool:
    if host_os() != "windows":
        return path_absolute(work).replace("\\", "/") == work.replace("\\", "/")
    val parts = work.replace("\\", "/").split("/")
    if parts.len() < 2: return false
    var prefix = parts[0] + "/"
    if not process.directory_no_follow_operation(prefix): return false
    for index in 1..parts.len():
        if parts[index] != "":
            prefix = prefix + parts[index]
            if not process.directory_no_follow_operation(prefix): return false
            prefix = prefix + "/"
    true

fn builder_transport_private_absolute_v1(path: text) -> bool:
    val normalized = path.replace("\\", "/")
    if normalized == "" or normalized.contains("//") or
            normalized.contains("\n") or normalized.contains("\r"):
        return false
    if normalized.ends_with("/") and normalized != "/" and
            not (normalized.len() == 3 and
                (normalized.byte_at(1) as i64) == 58):
        return false
    if host_os() == "windows":
        if normalized.len() < 4 or
                (normalized.byte_at(1) as i64) != 58 or
                (normalized.byte_at(2) as i64) != 47:
            return false
    elif not normalized.starts_with("/"):
        return false
    val parts = normalized.split("/")
    for part in parts:
        if part == "." or part == "..": return false
    true

fn builder_transport_physical_v1(path: text) -> text:
    var physical = path_absolute(path).replace("\\", "/")
    if physical.starts_with("//?/"):
        physical = physical.substring(4)
    if host_os() == "windows": physical = physical.lower()
    physical

fn builder_transport_prune_state_root_v1(
    task: BuildTaskV1, attempt: BuilderAttemptV1
) -> text:
    val root = attempt.local_root.replace("\\", "/")
    if not builder_transport_private_absolute_v1(root): return ""
    val attempt_dir = builder_transport_parent_v1(root)
    val task_dir = builder_transport_parent_v1(attempt_dir)
    val attempts_dir = builder_transport_parent_v1(task_dir)
    val state_root = builder_transport_parent_v1(attempts_dir)
    val expected = state_root + "/attempts/" + task.id + "/" +
        str(task.attempt) + "/" + attempt.host.id
    if not builder_transport_private_absolute_v1(state_root) or
            root != expected:
        return ""
    state_root

# Reclaim only immutable input copies after the exact worker tree has reaped,
# the successful result was admitted, and a separate published output exists.
# The request, producer, result, reap proof, and outputs remain available for
# recovery. Successful private cache files are disposable after publication;
# a partial delete can be safely retried.
pub fn builder_transport_prune_terminal_inputs_v1(task: BuildTaskV1,
        attempt: BuilderAttemptV1, admitted: BuildResultV1,
        output_root: text) -> Result<i64, text>:
    if attempt.host.transport != "local" or attempt.error != "" or
            attempt.task_id != task.id or attempt.attempt != task.attempt or
            attempt.identity_digest != builder_task_identity_v1(task):
        return Err("input prune requires exact local attempt ownership")
    if admitted.status != "OK" or builder_validate_result_v1(task, admitted) != "":
        return Err("input prune requires admitted successful result")
    if not builder_transport_reaped_v1(attempt):
        return Err("input prune requires exact tree-reap proof")
    val retained = builder_transport_collect_v1(attempt)?
    if builder_encode_result_v1(retained) != builder_encode_result_v1(admitted):
        return Err("input prune result differs from admitted receipt")
    val state_root = builder_transport_prune_state_root_v1(task, attempt)
    if state_root == "":
        return Err("input prune attempt is outside private manager state")
    val published_receipt = builder_read_result_v1(
        state_root + "/receipts/" + task.id + ".sdn")?
    if builder_encode_result_v1(published_receipt) !=
            builder_encode_result_v1(admitted):
        return Err("input prune published receipt differs from attempt")
    val work = attempt.local_root + "/work"
    val physical_attempt = builder_transport_physical_v1(attempt.local_root)
    val physical_work = builder_transport_physical_v1(work)
    val physical_output = builder_transport_physical_v1(output_root)
    val expected_attempt = if host_os() == "windows":
        attempt.local_root.replace("\\", "/").lower()
    else:
        attempt.local_root.replace("\\", "/")
    if not builder_transport_work_root_safe_v1(work, attempt.process) or
            physical_attempt == "" or physical_attempt != expected_attempt or
            physical_work != physical_attempt + "/work" or
            not builder_transport_private_absolute_v1(output_root) or
            physical_output == "" or
            physical_output == physical_attempt or
            physical_output.starts_with(physical_attempt + "/") or
            physical_attempt.starts_with(physical_output + "/"):
        return Err("input prune attempt root crosses a symlink or reparse directory")
    for output in admitted.outputs:
        val published = output_root + "/" + output.path
        if not file_is_regular_no_follow(published) or
                file_hash_sha256(published) != output.digest:
            return Err("input prune requires verified published output: " + output.path)
    # Preflight every existing copy before deleting any. Missing copies are
    # legal only for an interrupted earlier prune of this terminal attempt.
    for input in task.inputs:
        if input.path == ".builder-cache" or input.path.starts_with(".builder-cache/"):
            return Err("input prune cannot touch the worker cache")
        if not builder_transport_input_parent_safe_v1(work, input.path,
                attempt.process):
            return Err("input prune path crosses a symlink or reparse directory")
        val path = attempt.local_root + "/work/" + input.path
        if file_exists(path) and (not file_is_regular_no_follow(path) or
                file_hash_sha256(path) != input.digest):
            return Err("input prune copy differs: " + input.path)
    # A successful task will not retry, and its source authority remains in
    # the original source root. Reclaim the private cache's file bytes too;
    # failed attempts retain their cache for a bounded retry. The native walk
    # returns leaves only. Preflight all leaves before deleting any input.
    for output in task.outputs:
        if output == ".builder-cache" or
                output.starts_with(".builder-cache/"):
            return Err("input prune cannot remove a declared cache output")
    val cache_root = work + "/.builder-cache"
    var cache_paths: [text] = []
    if file_exists(cache_root):
        if not dir_is_real_no_follow(cache_root) or
                not builder_transport_input_parent_safe_v1(
                    work, ".builder-cache/placeholder", attempt.process):
            return Err("input prune cache root crosses a reparse directory")
        val found = dir_walk_native(cache_root)
        if found.len() > 100000:
            return Err("input prune cache exceeds file bound")
        val normalized_root = cache_root.replace("\\", "/")
        val comparable_root = if host_os() == "windows":
            normalized_root.lower()
        else:
            normalized_root
        for found_path in found:
            val normalized = found_path.replace("\\", "/")
            val comparable = if host_os() == "windows":
                normalized.lower()
            else:
                normalized
            if not comparable.starts_with(comparable_root + "/"):
                return Err("input prune cache walk escaped attempt")
            val relative = normalized[normalized_root.len() + 1:]
            if not builder_relative_path_valid_v1(relative) or
                    not builder_transport_input_parent_safe_v1(
                        work, ".builder-cache/" + relative, attempt.process) or
                    not file_is_regular_no_follow(found_path):
                return Err("input prune cache contains unsafe leaf")
            cache_paths.push(found_path)
    var deleted: i64 = 0
    for input in task.inputs:
        val path = attempt.local_root + "/work/" + input.path
        if file_exists(path):
            if not builder_transport_work_root_safe_v1(work, attempt.process) or
                    not builder_transport_input_parent_safe_v1(work, input.path,
                        attempt.process) or
                    not file_is_regular_no_follow(path) or
                    file_hash_sha256(path) != input.digest or not file_delete(path):
                return Err("input prune failed: " + input.path)
            deleted = deleted + 1
    for path in cache_paths:
        val normalized = path.replace("\\", "/")
        val relative = normalized[cache_root.replace("\\", "/").len() + 1:]
        if not builder_transport_work_root_safe_v1(work, attempt.process) or
                not builder_relative_path_valid_v1(relative) or
                not builder_transport_input_parent_safe_v1(
                    work, ".builder-cache/" + relative, attempt.process) or
                not file_is_regular_no_follow(path) or not file_delete(path):
            return Err("input prune cache deletion failed")
    Ok(deleted)

# A failed compiler may be retried from the immutable source root. Reclaim only
# its private source copies after the exact worker tree has reaped and the
# failure receipt is durable. Keep cache, logs, request, and partial outputs for
# failed-only retry and diagnosis. Missing copies permit an interrupted prune.
pub fn builder_transport_prune_failed_inputs_v1(task: BuildTaskV1,
        attempt: BuilderAttemptV1, admitted: BuildResultV1,
        source_root: text, output_root: text) -> Result<i64, text>:
    if attempt.host.transport != "local" or attempt.error != "" or
            attempt.task_id != task.id or attempt.attempt != task.attempt or
            attempt.identity_digest != builder_task_identity_v1(task) or
            (admitted.status != "ERROR" and admitted.status != "CRASHED" and
                admitted.status != "TIMEOUT") or
            builder_validate_result_v1(task, admitted) != "":
        return Err("failed input prune requires admitted local failure")
    if not builder_transport_reaped_v1(attempt):
        return Err("failed input prune requires exact tree-reap proof")
    val retained = builder_transport_collect_v1(attempt)?
    if builder_encode_result_v1(retained) != builder_encode_result_v1(admitted):
        return Err("failed input prune result differs from attempt")
    val state_root = builder_transport_prune_state_root_v1(task, attempt)
    if state_root == "": return Err("failed input prune attempt ownership invalid")
    val published = builder_read_result_v1(
        state_root + "/receipts/" + task.id + ".sdn")?
    if builder_encode_result_v1(published) != builder_encode_result_v1(admitted):
        return Err("failed input prune durable receipt differs")
    val work = attempt.local_root + "/work"
    val physical_attempt = builder_transport_physical_v1(attempt.local_root)
    val physical_work = builder_transport_physical_v1(work)
    val physical_source = builder_transport_physical_v1(source_root)
    val physical_output = builder_transport_physical_v1(output_root)
    val expected_attempt = if host_os() == "windows":
        attempt.local_root.replace("\\", "/").lower()
    else:
        attempt.local_root.replace("\\", "/")
    if not builder_transport_work_root_safe_v1(work, attempt.process) or
            not dir_is_real_no_follow(source_root) or
            not dir_is_real_no_follow(output_root) or
            physical_attempt == "" or physical_attempt != expected_attempt or
            physical_work != physical_attempt + "/work" or
            physical_source == "" or physical_output == "" or
            physical_source == physical_attempt or
            physical_source.starts_with(physical_attempt + "/") or
            physical_attempt.starts_with(physical_source + "/") or
            physical_output == physical_attempt or
            physical_output.starts_with(physical_attempt + "/") or
            physical_attempt.starts_with(physical_output + "/"):
        return Err("failed input prune crosses source/output or reparse root")
    for input in task.inputs:
        if input.path == ".builder-cache" or
                input.path.starts_with(".builder-cache/") or
                not builder_transport_input_parent_safe_v1(source_root,
                    input.path, attempt.process) or
                not builder_transport_input_parent_safe_v1(work, input.path,
                    attempt.process):
            return Err("failed input prune input parent is unsafe")
        val source = source_root + "/" + input.path
        val copied = work + "/" + input.path
        if not file_is_regular_no_follow(source) or
                file_hash_sha256(source) != input.digest or
                (file_exists(copied) and
                    (not file_is_regular_no_follow(copied) or
                        file_hash_sha256(copied) != input.digest)):
            return Err("failed input prune source/copy digest differs: " + input.path)
    # Only regular declared inputs are deleted. A previous partial prune may
    # leave a valid staged link whose target file was already removed, so the
    # work-tree link cannot be re-admitted here. Source links remain pinned.
    if builder_link_inputs_match_v1(task, source_root) != "":
        return Err("failed input prune source links changed")
    var deleted: i64 = 0
    for input in task.inputs:
        val copied = work + "/" + input.path
        if file_exists(copied):
            if not builder_transport_work_root_safe_v1(work, attempt.process) or
                    not builder_transport_input_parent_safe_v1(work,
                        input.path, attempt.process) or
                    not file_is_regular_no_follow(copied) or
                    file_hash_sha256(copied) != input.digest or
                    not file_delete(copied):
                return Err("failed input prune delete refused: " + input.path)
            deleted = deleted + 1
    Ok(deleted)

# Nonce freshness establishes that this exact worker still owns the compiler.
# Timeout is unknown state; it never licenses retry or PID-based termination.
fn builder_transport_control_v1(attempt: BuilderAttemptV1, action: text) -> bool:
    val nonce = "n" + str(getpid()) + "_" + str(current_time_ms())
    val request = attempt.identity_digest + "\n" + attempt.host.id + "\n" + nonce + "\n" + action
    if not file_atomic_write(attempt.local_root + "/control.request", request): return false
    if attempt.host.transport == "ssh":
        # Upload under a temporary name; rename is the remote publication point.
        val copied = process_run_timeout("scp", ["-q", "-o", "BatchMode=yes", "--", attempt.local_root + "/control.request", attempt.host.endpoint + ":" + attempt.remote_root + "/control.pending"], 10000)
        if copied.2 != 0: return false
        val renamed = builder_transport_ssh_v1(attempt.host, "mv -- " + builder_transport_shell_quote_v1(attempt.remote_root + "/control.pending") + " " + builder_transport_shell_quote_v1(attempt.remote_root + "/control.request"))
        if renamed.2 != 0: return false
    val deadline = current_time_ms() + 2000
    while current_time_ms() < deadline:
        if builder_transport_read_control_v1(attempt, "control.response") == request: return true
        sleep_ms(50)
    false

pub fn builder_transport_recover_v1(task: BuildTaskV1, host: BuildHostV1, run_root: text, process: BuilderProcessPortV1) -> Result<BuilderAttemptV1, text>:
    val task_error = builder_validate_task_v1(task)
    if task_error != "": return Err(task_error)
    val host_error = builder_validate_host_v1(host)
    if host_error != "": return Err(host_error)
    val root = run_root + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
    val remote = host.workspace + "/attempts/" + task.id + "/" + str(task.attempt) + "/" + host.id
    if host.transport == "ssh" and not builder_transport_remote_path_valid_v1(remote):
        return Err("invalid remote recovery path")
    val attempt = BuilderAttemptV1(task_id: task.id, attempt: task.attempt,
        host: host, pid: 0, local_root: root, remote_root: remote, error: "",
        identity_digest: builder_task_identity_v1(task), process: process)
    if builder_transport_terminal_v1(attempt):
        val result = builder_transport_collect_v1(attempt)?
        val error = builder_validate_result_v1(task, result)
        if error != "": return Err(error)
        return Ok(attempt)
    if builder_transport_control_v1(attempt, "probe"): return Ok(attempt)
    Err("worker ownership unknown: no exact final receipt or fresh challenge response; retry forbidden")

export BuilderAttemptV1, builder_transport_start_v1, builder_transport_poll_v1
export builder_transport_collect_v1, builder_transport_cancel_v1
export builder_transport_parent_v1, builder_transport_shell_quote_v1, builder_transport_remote_path_valid_v1
export builder_transport_recover_v1, builder_transport_reaped_v1
export builder_transport_no_child_started_v1, builder_transport_terminal_v1
export builder_transport_prune_terminal_inputs_v1
export builder_transport_prune_failed_inputs_v1
