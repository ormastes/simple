# A diagnostic runtime SOURCE snapshot, never a compiled runtime binary.
# Rows are verbatim file-hex/link-hex/link-dir-hex source-authority records.
use app.bootstrap_builder.native_group_phase2_source_snapshot.{
    phase2_source_authority_decode_v1, PHASE2_AUTHORITY_MAX_BYTES_V1
}
use app.bootstrap_builder.native_group_phase2_source_contract.{
    Phase2SourceRecordV1
}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.nogc_sync_mut.io.file_ops.{
    file_hash_sha256, file_is_regular_no_follow,
    file_read_regular_no_follow_bounded
}
use std.nogc_sync_mut.io.snapshot_links.{snapshot_symlink_match_nofollow_v1}

val PROVISIONAL_RUNTIME_SCHEMA_V1 = "SIMPLE-PROVISIONAL-RUNTIME-1"

struct NativeGroupProvisionalRuntimeV1:
    payload: text
    digest: text
    count: i64
    records: [Phase2SourceRecordV1]

fn native_group_provisional_runtime_from_authority_v1(
    authority: text
) -> Result<NativeGroupProvisionalRuntimeV1, text>:
    val records = phase2_source_authority_decode_v1(authority)?
    val lines = authority.split("\n")
    var runtime_lines: [text] = []
    var runtime_records: [Phase2SourceRecordV1] = []
    for index in 0..records.len():
        val record = records[index]
        if record.relative_path.starts_with("src/runtime/"):
            runtime_lines = runtime_lines.push(lines[index])
            runtime_records = runtime_records.push(record)
    if runtime_records.len() == 0:
        return Err("provisional runtime source authority has no runtime records")
    val payload = PROVISIONAL_RUNTIME_SCHEMA_V1 + "\ncount=" +
        str(runtime_records.len()) + "\n" + runtime_lines.join("\n") + "\n"
    Ok(NativeGroupProvisionalRuntimeV1(payload, sha256_text(payload),
        runtime_records.len(), runtime_records))

fn native_group_provisional_runtime_decode_v1(
    payload: text
) -> Result<NativeGroupProvisionalRuntimeV1, text>:
    if payload == "" or payload.len() > PHASE2_AUTHORITY_MAX_BYTES_V1 or
            not payload.ends_with("\n") or payload.contains("\r") or
            payload.contains("\0"):
        return Err("provisional runtime source snapshot framing invalid")
    val lines = payload.split("\n")
    if lines.len() < 4 or lines[0] != PROVISIONAL_RUNTIME_SCHEMA_V1 or
            not lines[1].starts_with("count=") or
            lines[lines.len() - 1] != "":
        return Err("provisional runtime source snapshot schema invalid")
    val count_raw = lines[1].substring(6)
    val count = count_raw.to_i64() ?? -1
    if count < 1 or count > 200000 or str(count) != count_raw or
            lines.len() != count + 3:
        return Err("provisional runtime source snapshot count invalid")
    var rows: [text] = []
    for index in 2..lines.len() - 1:
        rows = rows.push(lines[index])
    val records = phase2_source_authority_decode_v1(
        rows.join("\n") + "\n")?
    if records.len() != count:
        return Err("provisional runtime source snapshot records differ")
    for record in records:
        if not record.relative_path.starts_with("src/runtime/"):
            return Err("provisional runtime source snapshot escaped runtime")
    Ok(NativeGroupProvisionalRuntimeV1(payload, sha256_text(payload),
        count, records))

fn native_group_provisional_runtime_match_authority_v1(
    authority: text, payload: text
) -> Result<NativeGroupProvisionalRuntimeV1, text>:
    val expected = native_group_provisional_runtime_from_authority_v1(
        authority)?
    val decoded = native_group_provisional_runtime_decode_v1(payload)?
    if payload != expected.payload or decoded.digest != expected.digest or
            decoded.count != expected.count:
        return Err("provisional runtime source snapshot differs from authority")
    Ok(decoded)

fn _provisional_runtime_ancestors_v1(
    source_root: text, relative: text
) -> bool:
    if not dir_is_real_no_follow(source_root): return false
    val parts = relative.split("/")
    var parent = source_root
    for index in 0..parts.len() - 1:
        parent = parent + "/" + parts[index]
        if not dir_is_real_no_follow(parent): return false
    true

fn native_group_provisional_runtime_verify_v1(
    authority: text, source_root: text,
    snapshot_path: text, snapshot_digest: text,
    expected_count: i64
) -> Result<NativeGroupProvisionalRuntimeV1, text>:
    val expected = native_group_provisional_runtime_from_authority_v1(
        authority)?
    if snapshot_path == "" or expected_count != expected.count or
            snapshot_digest != expected.digest or
            not file_is_regular_no_follow(snapshot_path) or
            file_hash_sha256(snapshot_path) != snapshot_digest:
        return Err("provisional runtime source snapshot pin differs")
    val payload = file_read_regular_no_follow_bounded(
        snapshot_path, PHASE2_AUTHORITY_MAX_BYTES_V1)?
    val decoded = native_group_provisional_runtime_match_authority_v1(
        authority, payload)?
    for record in decoded.records:
        if not _provisional_runtime_ancestors_v1(
                source_root, record.relative_path):
            return Err("provisional runtime source ancestor changed")
        val path = source_root + "/" + record.relative_path
        if record.kind == "file-hex":
            if not file_is_regular_no_follow(path) or
                    file_hash_sha256(path) != record.digest:
                return Err("provisional runtime source file changed")
        else:
            val kind = if record.kind == "link-dir-hex": 2 else: 1
            if not snapshot_symlink_match_nofollow_v1(source_root,
                    path, record.link_target, kind):
                return Err("provisional runtime source link changed")
            if not _provisional_runtime_ancestors_v1(
                    source_root, record.resolved_path):
                return Err("provisional runtime link target ancestor changed")
            val resolved = source_root + "/" + record.resolved_path
            if record.kind == "link-hex":
                if not file_is_regular_no_follow(resolved) or
                        file_hash_sha256(resolved) != record.digest:
                    return Err("provisional runtime link target changed")
            elif not dir_is_real_no_follow(resolved):
                return Err("provisional runtime directory link target changed")
    Ok(decoded)

export PROVISIONAL_RUNTIME_SCHEMA_V1, NativeGroupProvisionalRuntimeV1
export native_group_provisional_runtime_from_authority_v1
export native_group_provisional_runtime_decode_v1
export native_group_provisional_runtime_match_authority_v1
export native_group_provisional_runtime_verify_v1
