# Compiled diagnostic-only authority entrypoint. No Stage2 admission command.
use app.io.args_ops.{get_args}
use app.bootstrap_builder.native_group_provisional_authority.{
    native_group_provisional_build_v1,
    native_group_provisional_verify_v1,
    native_group_provisional_field_v1
}
use std.nogc_sync_mut.io.process_ops.{eprint}

fn native_group_provisional_main_v1() -> i64:
    val args = get_args()
    if args.len() == 20 and
            args[1] == "native-groups-provisional-authority" and
            args[2] == "--producer" and
            args[4] == "--source-checkout" and
            args[6] == "--source-snapshot" and
            args[8] == "--source-snapshot-digest" and
            args[10] == "--hello-receipt" and
            args[12] == "--hello-receipt-digest" and
            args[14] == "--output-root" and
            args[16] == "--target" and args[18] == "--receipt":
        match native_group_provisional_build_v1(
                args[3], args[5], args[7], args[9], args[11],
                args[13], args[15], args[17], args[19]):
            Ok(built):
                print built.receipt_digest
                return 0
            Err(reason):
                eprint("provisional authority: " + reason)
                return 2
    if args.len() == 10 and
            args[1] == "native-groups-provisional-authority-verify" and
            args[2] == "--receipt" and args[4] == "--digest" and
            args[6] == "--source-snapshot" and
            args[8] == "--hello-receipt":
        match native_group_provisional_verify_v1(
                args[3], args[5], args[7], args[9]):
            Ok(_):
                print args[5]
                return 0
            Err(reason):
                eprint("provisional authority verify: " + reason)
                return 2
    if args.len() == 8 and
            args[1] == "native-groups-provisional-authority-field" and
            args[2] == "--receipt" and args[4] == "--digest" and
            args[6] == "--field":
        match native_group_provisional_field_v1(
                args[3], args[5], args[7]):
            Ok(value):
                print value
                return 0
            Err(reason):
                eprint("provisional authority field: " + reason)
                return 2
    eprint("usage: native-groups-provisional-authority --producer ABS --source-checkout ABS --source-snapshot ABS --source-snapshot-digest SHA --hello-receipt ABS --hello-receipt-digest SHA --output-root ABS --target TRIPLE --receipt ABS | native-groups-provisional-authority-verify --receipt ABS --digest SHA --source-snapshot ABS --hello-receipt ABS | native-groups-provisional-authority-field --receipt ABS --digest SHA --field NAME")
    2

fn main() -> i64:
    native_group_provisional_main_v1()

export native_group_provisional_main_v1
