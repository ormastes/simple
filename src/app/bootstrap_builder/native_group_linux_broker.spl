# Independent Linux broker. Its runtime owner holds a pidfd and a cgroup-v2
# scope across manager crashes; only post-collect evidence becomes terminal.
use app.io.args_ops.{get_args}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_lock, file_unlock, file_exists, file_is_regular_no_follow, file_hash_sha256}
use app.io.time_ops.{sleep_ms, current_time_ms}
use std.io_runtime.{time_now_monotonic_ms}
use std.common.build_manager.group_process_protocol.{GroupProcessLaunchV1, GroupProcessPollV1, group_process_launch_decode_v1, group_process_identity_v1, group_process_observation_encode_v1, group_process_memory_receipt_v1}
use std.common.build_manager.grouped_native_charge_evidence.{NativeGroupChargeSampleV1, NativeGroupChargeTraceV1, native_group_charge_trace_encode_v1}
use std.common.build_manager.memory_policy.{builder_memory_enforcement_bytes_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessInputV1, LinuxProcessRequestV1, LinuxProcessLeaseV1, LinuxProcessPollV1, linux_process_start_with_memory_v1, linux_process_poll_v1, linux_process_cancel_v1, linux_process_peak_memory_v1, linux_process_collect_v1}
use std.nogc_sync_mut.io.linux_process_owner.{linux_cgroup_parent_acquire_v1, linux_cgroup_parent_release_v1}
use std.common.build_manager.capacity_request.{BuilderLinuxParentReceiptV1, builder_linux_parent_receipt_encode_v1}

fn native_linux_group_observation_v1(observed: LinuxProcessPollV1, peak: i64) -> GroupProcessPollV1:
    val active_charge = if observed.terminal: 0 else: observed.memory_current_bytes
    GroupProcessPollV1(observed.terminal, observed.leader_reaped, observed.tree_empty,
        observed.active_processes, observed.exit_code, observed.timed_out,
        observed.cancelled, peak, active_charge, not observed.terminal)

fn native_linux_group_control_v1(root: text, identity: text) -> text:
    val request = match file_read_regular_no_follow_bounded(root + "/broker.control.request", 4096):
        Ok(value): value
        Err(_): return ""
    val parts = request.split("\n")
    if parts.len() != 3 or parts[0] != identity or not builder_identifier_valid_v1(parts[1]): return ""
    if parts[2] != "probe" and parts[2] != "cancel": return ""
    request

fn native_linux_group_finish_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    val receipt = linux_process_collect_v1(lease)?
    native_linux_group_publish_receipt_v1(root, identity, receipt, peak, snapshot_digest,
        memory_limit_bytes, memory_policy, samples, complete)

fn native_linux_group_publish_receipt_v1(root: text, identity: text,
        receipt: LinuxProcessPollV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    if not receipt.terminal or not receipt.leader_reaped or not receipt.tree_empty or
            receipt.active_processes != 0:
        return Err("Linux group process tree cleanup not proven")
    var final_samples = samples
    var full_trace = complete
    val terminal_ms = time_now_monotonic_ms()
    if terminal_ms < 0 or final_samples.len() == 0 or final_samples.len() >= 32768:
        full_trace = false
    if full_trace and terminal_ms < final_samples[final_samples.len() - 1].after_ms:
        full_trace = false
    if full_trace:
        final_samples = final_samples.push(NativeGroupChargeSampleV1(
            terminal_ms, terminal_ms, 0, peak, 0, true))
    val evidence = native_group_charge_trace_encode_v1(
        NativeGroupChargeTraceV1(snapshot_digest, full_trace, final_samples),
        memory_limit_bytes, memory_policy)
    if evidence != "" and not file_atomic_write(root + "/broker-charge.sdn", evidence):
        print "Linux group broker charge evidence unavailable reason=write-failed"
    val memory = group_process_memory_receipt_v1(identity, memory_policy, memory_limit_bytes, peak, "linux")?
    if not file_atomic_write(root + "/broker-memory.sdn", memory):
        return Err("cannot persist group memory policy receipt")
    val payload = group_process_observation_encode_v1(identity,
        native_linux_group_observation_v1(receipt, peak))
    # Terminal authority is published only after the outer owner removes the
    # acquired parent. The pending record cannot settle a manager attempt.
    if not file_atomic_write(root + "/broker.tree.pending.sdn", payload):
        return Err("cannot persist Linux group tree cleanup receipt")
    Ok(true)

fn native_linux_group_drain_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, stream: bool = false) -> Result<bool, text>:
    val _cancelled = linux_process_cancel_v1(lease)?
    val deadline = current_time_ms() + 30000
    while current_time_ms() < deadline:
        val observed = linux_process_poll_v1(lease)?
        if observed.terminal:
            val peak = linux_process_peak_memory_v1(lease)?
            if stream: return native_linux_group_finish_stream_v2(root, identity, lease, peak,
                snapshot_digest, memory_limit_bytes, memory_policy, [], false)
            return native_linux_group_finish_v1(root, identity, lease, peak,
                snapshot_digest, memory_limit_bytes, memory_policy, [], false)
        sleep_ms(10)
    Err("Linux group cancellation cleanup remains unproven")

fn native_linux_group_run_v1(launch: GroupProcessLaunchV1,
        identity: text) -> Result<bool, text>:
    # The sealed local GroupProcessLaunchV1 is the acquisition authority.
    val parent = linux_cgroup_parent_acquire_v1(launch.root, identity)?
    val acquired = builder_linux_parent_receipt_encode_v1(BuilderLinuxParentReceiptV1(
        identity, "linux-local", parent.path, parent.device, parent.inode))
    if acquired == "" or not file_atomic_write(launch.root + "/capacity.receipt", acquired):
        val _released = linux_cgroup_parent_release_v1(parent)?
        return Err("cannot persist Linux broker parent receipt")
    val outcome = native_linux_group_run_in_parent_v1(launch, identity)
    val _released = linux_cgroup_parent_release_v1(parent)?
    if not file_atomic_write(launch.root + "/capacity.released", acquired):
        return Err("cannot persist Linux broker parent cleanup")
    if file_exists(launch.root + "/broker.tree.pending.sdn"):
        val terminal = file_read_regular_no_follow_bounded(launch.root + "/broker.tree.pending.sdn", 4096)?
        if not file_atomic_write(launch.root + "/broker.tree.sdn", terminal):
            return Err("cannot publish Linux broker terminal cleanup receipt")
    outcome

fn native_linux_group_run_in_parent_v1(launch: GroupProcessLaunchV1,
        identity: text) -> Result<bool, text>:
    val request = launch.request
    if not file_is_regular_no_follow(request.broker_program) or
            _native_group_linux_broker_sha_mismatch(request.broker_program, request.broker_digest) or
            _native_group_linux_broker_sha_mismatch("/proc/self/exe", request.broker_digest):
        return Err("Linux broker image differs from configured digest")
    var inputs: [LinuxProcessInputV1] = []
    inputs = inputs.push(LinuxProcessInputV1(launch.root + "/broker.request.sdn", identity))
    for input in request.inputs: inputs = inputs.push(LinuxProcessInputV1(input.path, input.digest))
    val native = LinuxProcessRequestV1(request.program, request.producer_digest, request.args,
        request.environment, request.directory, inputs, request.stdout_path,
        request.stderr_path, request.timeout_ms)
    val enforced = builder_memory_enforcement_bytes_v1(launch.memory_policy, launch.memory_limit_bytes)?
    val lease = linux_process_start_with_memory_v1(native, enforced,
        launch.root, identity)?
    native_linux_group_monitor_lease_v1(launch.root, identity, lease,
        launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy)

fn native_linux_group_monitor_lease_v1(root: text, identity: text, lease: LinuxProcessLeaseV1,
        snapshot_digest: text, memory_limit_bytes: i64, memory_policy: text, stream: bool = false) -> Result<bool, text>:
    var last_control = ""
    var error = ""
    var charge_samples: [NativeGroupChargeSampleV1] = []
    var charge_complete = true
    while error == "":
        val control = native_linux_group_control_v1(root, identity)
        if control != "" and control != last_control and control.ends_with("\ncancel"):
            match linux_process_cancel_v1(lease):
                Ok(_): pass
                Err(message):
                    error = message
                    break
        val sample_before = time_now_monotonic_ms()
        val observed = match linux_process_poll_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val peak = match linux_process_peak_memory_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val sample_after = time_now_monotonic_ms()
        if not observed.terminal:
            if sample_before < 0 or sample_after < sample_before or
                    charge_samples.len() >= 32767:
                charge_complete = false
            elif charge_complete:
                charge_samples = charge_samples.push(NativeGroupChargeSampleV1(
                    sample_before, sample_after, observed.memory_current_bytes,
                    peak, observed.active_processes, false))
        if observed.terminal:
            if stream: return native_linux_group_finish_stream_v2(root, identity, lease, peak,
                snapshot_digest, memory_limit_bytes, memory_policy, charge_samples, charge_complete)
            return native_linux_group_finish_v1(root, identity, lease, peak,
                snapshot_digest, memory_limit_bytes, memory_policy,
                charge_samples, charge_complete)
        if control != "" and control != last_control:
            val payload = group_process_observation_encode_v1(identity,
                native_linux_group_observation_v1(observed, peak))
            if not file_atomic_write(root + "/broker.control.response", control + "\n" + payload):
                error = "cannot publish fresh Linux broker observation"
                break
            last_control = control
        sleep_ms(10)
    val cleanup = native_linux_group_drain_v1(root, identity, lease,
        snapshot_digest, memory_limit_bytes, memory_policy, stream)
    match cleanup:
        Ok(_): Err(error)
        Err(message): Err(error + "; " + message)

fn main() -> i64:
    val args = get_args()
    if args.len() != 5 or args[1] != "--broker-root" or
            args[3] != "--request-digest": return 2
    val root = args[2]
    val identity = args[4]
    if not root.starts_with("/") or not builder_digest_valid_v1(identity): return 2
    val payload = match file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216):
        Ok(value): value
        Err(_): return 2
    if payload.starts_with("SIMPLE-GROUP-STREAM-2\n"):
        return native_linux_group_stream_main_v2(root, identity, payload)
    val launch = match group_process_launch_decode_v1(payload):
        Ok(value): value
        Err(_): return 2
    if launch.root != root or group_process_identity_v1(launch) != identity: return 2
    val lock = file_lock(root + "/broker.lock", 0)
    if lock < 0: return 3
    if file_exists(root + "/broker.started"):
        val _unlocked = file_unlock(lock)
        return 3
    if not file_atomic_write(root + "/broker.started", identity):
        val _unlocked = file_unlock(lock)
        return 3
    val result = native_linux_group_run_v1(launch, identity)
    val _unlocked = file_unlock(lock)
    match result:
        Ok(_): 0
        Err(message):
            val _written = file_atomic_write(root + "/broker.error", message)
            print "Linux group broker: {message}"
            1

# Absent digest (missing/unreadable file) is a mismatch, never "".
fn _native_group_linux_broker_sha_mismatch(path: text, expected: text) -> bool:
    if val actual = file_hash_sha256(path):
        return actual != expected
    true

# Stream profile shares this broker and its actual cgroup/pidfd lifecycle owner.
use std.common.build_manager.group_process_stream_protocol_v2.{
    GroupProcessStreamLaunchV2, group_process_stream_launch_decode_v2,
    group_process_stream_identity_v2, group_process_stream_ready_encode_v2,
    group_process_stream_unlaunched_encode_v2
}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessStreamStartV2,
    linux_process_stream_start_v2, linux_cgroup_parent_acquire_at_v2}

fn native_linux_group_release_stream_parent_v2(parent: LinuxCgroupParentV1, root: text) -> bool:
    while true:
        match linux_cgroup_parent_release_v1(parent):
            case Ok(value):
                if value: return true
            case Err(reason):
                val _recorded = file_atomic_write(root + "/broker.error", reason)
        sleep_ms(100)
    false

fn native_linux_group_unlaunched_stream_v2(launch: GroupProcessStreamLaunchV2, identity: text,
        parent: LinuxCgroupParentV1, acquired: text, reason: text) -> Result<bool, text>:
    val _released = native_linux_group_release_stream_parent_v2(parent, launch.root)
    while not file_atomic_write(launch.root + "/capacity.released", acquired): sleep_ms(100)
    var endpoints_released = false
    while not endpoints_released:
        match linux_process_stream_release_inherited_v2():
            case Ok(_): endpoints_released = true
            case Err(error):
                val _recorded = file_atomic_write(launch.root + "/broker.error", error)
                sleep_ms(100)
    val proof = group_process_stream_unlaunched_encode_v2(identity, launch.transport_generation,
        launch.request.child_argv_digest)
    if proof == "": return Err("cannot encode known-unlaunched cleanup proof")
    while not file_atomic_write(launch.root + "/broker.stream.unlaunched.sdn", proof): sleep_ms(100)
    Err(reason)

fn native_linux_group_stream_run_v2(launch: GroupProcessStreamLaunchV2,
        identity: text) -> Result<bool, text>:
    if not file_is_regular_no_follow(launch.request.broker_program) or
            _native_group_linux_broker_sha_mismatch(launch.request.broker_program, launch.request.broker_digest) or
            _native_group_linux_broker_sha_mismatch("/proc/self/exe", launch.request.broker_digest):
        return Err("Linux stream broker image differs from configured digest")
    var admitted_parent: LinuxCgroupParentV1? = nil
    match linux_cgroup_parent_admit_at_v2(launch.delegated_cgroup_path, launch.root, identity):
        case LinuxCgroupParentAdmissionV1.Acquired(value): admitted_parent = Some(value)
        case LinuxCgroupParentAdmissionV1.CleanupPending(value, reason):
            val retained = builder_linux_parent_receipt_encode_v1(BuilderLinuxParentReceiptV1(
                identity, "linux-local", value.path, value.device, value.inode))
            return native_linux_group_unlaunched_stream_v2(launch, identity, value, retained, reason)
        case LinuxCgroupParentAdmissionV1.Rejected(reason):
            # Native typed rejection proves no parent and no child acquired.
            # Do not manufacture a released-parent receipt for an absent parent.
            var closed = false
            while not closed:
                match linux_process_stream_release_inherited_v2():
                    case Ok(_): closed = true
                    case Err(error):
                        val _recorded = file_atomic_write(launch.root + "/broker.error", error)
                        sleep_ms(100)
            val proof = group_process_stream_unlaunched_encode_v2(identity,
                launch.transport_generation, launch.request.child_argv_digest)
            if proof == "": return Err("cannot encode no-parent/no-child admission proof")
            while not file_atomic_write(launch.root + "/broker.stream.unlaunched.sdn", proof): sleep_ms(100)
            return Err(reason)
        case LinuxCgroupParentAdmissionV1.Unknown(reason):
            # No guessed token or replay. Retain the independent broker and its
            # native parent FDs; no workload has been launched on this branch.
            val _recorded = file_atomic_write(launch.root + "/broker.error", reason)
            while true: sleep_ms(1000)
            return Err(reason)
    val parent = admitted_parent.unwrap()
    val acquired = builder_linux_parent_receipt_encode_v1(BuilderLinuxParentReceiptV1(
        identity, "linux-local", parent.path, parent.device, parent.inode))
    if acquired == "" or not file_atomic_write(launch.root + "/capacity.receipt", acquired):
        return native_linux_group_unlaunched_stream_v2(launch, identity, parent, acquired,
            "cannot persist stream broker parent receipt")
    val enforced = builder_memory_enforcement_bytes_v1(launch.memory_policy, launch.memory_limit_bytes)?
    var started = linux_process_stream_start_v2(launch, identity, enforced)
    var receipt_unknown = true
    while receipt_unknown:
        match started:
            case LinuxProcessStreamStartV2.Unknown(reason):
                val _recorded = file_atomic_write(launch.root + "/broker.error", reason)
                sleep_ms(100)
                started = linux_process_stream_recover_lease_v2(launch.root, identity)
            case _: receipt_unknown = false
    var lease = LinuxProcessLeaseV1(0)
    var admission_error = ""
    match started:
        case LinuxProcessStreamStartV2.Unknown(reason):
            return Err(reason) # Loop above only exits after exact native recovery.
        case LinuxProcessStreamStartV2.Ready(value):
            lease = value
            val ready = group_process_stream_ready_encode_v2(identity, launch.transport_generation,
                launch.request.child_argv_digest)
            if ready == "" or not file_atomic_write(launch.root + "/broker.stream.ready.sdn", ready):
                admission_error = "cannot persist exact stream exec-ready receipt"
        case LinuxProcessStreamStartV2.NoChildCleanupRequired(_value, reason):
            var scope_cleaned = false
            while not scope_cleaned:
                match linux_process_stream_collect_no_child_v2(launch.root, identity):
                    case Ok(_): scope_cleaned = true
                    case Err(error):
                        val _recorded = file_atomic_write(launch.root + "/broker.error", error)
                        sleep_ms(100)
            return native_linux_group_unlaunched_stream_v2(launch, identity, parent, acquired, reason)
        case LinuxProcessStreamStartV2.CleanupRequired(value, reason):
            lease = value
            admission_error = reason
        case LinuxProcessStreamStartV2.Rejected(reason):
            return native_linux_group_unlaunched_stream_v2(launch, identity, parent, acquired, reason)
    if admission_error != "":
        val _recorded = file_atomic_write(launch.root + "/broker.error", admission_error)
        val _cancelled = linux_process_cancel_v1(lease)
    var outcome = if admission_error == "":
        native_linux_group_monitor_lease_v1(launch.root, identity, lease,
            launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy, true)
    else:
        native_linux_group_drain_v1(launch.root, identity, lease,
            launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy, true)
    # Never exit and discard a live native lease on a transient cleanup error.
    # This is the same broker: bounded drain turns retain authority, no relaunch.
    while not file_exists(launch.root + "/broker.tree.pending.sdn"):
        match outcome:
            case Err(reason):
                val _recorded = file_atomic_write(launch.root + "/broker.error", reason)
            case Ok(_): pass
        sleep_ms(100)
        outcome = native_linux_group_drain_v1(launch.root, identity, lease,
            launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy, true)
    val _released = native_linux_group_release_stream_parent_v2(parent, launch.root)
    while not file_atomic_write(launch.root + "/capacity.released", acquired): sleep_ms(100)
    val terminal = file_read_regular_no_follow_bounded(launch.root + "/broker.tree.pending.sdn", 4096)?
    while not file_atomic_write(launch.root + "/broker.tree.sdn", terminal): sleep_ms(100)
    if admission_error != "": return Err(admission_error)
    outcome

fn native_linux_group_stream_main_v2(root: text, identity: text, payload: text) -> i64:
    val launch = match group_process_stream_launch_decode_v2(payload):
        case Ok(value): value
        case Err(_): return 2
    if launch.root != root or launch.transport_generation <= 0 or group_process_stream_identity_v2(launch) != identity:
        return 2
    val lock = file_lock(root + "/broker.lock", 0)
    if lock < 0: return 3
    if file_exists(root + "/broker.started"):
        val _unlocked = file_unlock(lock)
        return 3
    if not file_atomic_write(root + "/broker.started", identity):
        val _unlocked = file_unlock(lock)
        return 3
    val result = native_linux_group_stream_run_v2(launch, identity)
    val _unlocked = file_unlock(lock)
    match result:
        case Ok(_): 0
        case Err(reason):
            val _recorded = file_atomic_write(root + "/broker.error", reason)
            1

# The real collected receipt remains a value here across publication failures.
# Projection recovery covers native cleanup followed by an allocation/ABI error.
use std.nogc_sync_mut.io.linux_process_owner.{linux_process_collected_stream_v2,
    linux_process_stream_release_inherited_v2, linux_process_stream_recover_lease_v2,
    LinuxCgroupParentV1, LinuxCgroupParentAdmissionV1, linux_cgroup_parent_admit_at_v2,
    linux_process_stream_collect_no_child_v2}

fn native_linux_group_finish_stream_v2(root: text, identity: text,
        lease: LinuxProcessLeaseV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    var retained: LinuxProcessPollV1? = nil
    while retained == nil:
        match linux_process_collected_stream_v2(lease):
            case Ok(receipt): retained = Some(receipt)
            case Err(_):
                match linux_process_collect_v1(lease):
                    case Ok(receipt): retained = Some(receipt)
                    case Err(reason):
                        val _recorded = file_atomic_write(root + "/broker.error", reason)
                        sleep_ms(100)
    val receipt = retained.unwrap()
    while true:
        match native_linux_group_publish_receipt_v1(root, identity, receipt, receipt.memory_peak_bytes,
                snapshot_digest, memory_limit_bytes, memory_policy, samples, complete):
            case Ok(value): return Ok(value)
            case Err(reason):
                val _recorded = file_atomic_write(root + "/broker.error", reason)
                sleep_ms(100)
    Err("unreachable stream publication state")
