# Independent Linux broker. Its runtime owner holds a pidfd and a cgroup-v2
# scope across manager crashes; only post-collect evidence becomes terminal.
use app.io.args_ops.{get_args}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_lock, file_unlock, file_exists, file_is_regular_no_follow, file_hash_sha256}
use app.io.time_ops.{sleep_ms, current_time_ms}
use std.io_runtime.{time_now_monotonic_ms}
use std.common.build_manager.group_process_protocol.{GroupProcessLaunchV1, GroupProcessPollV1, group_process_launch_decode_v1, group_process_identity_v1, group_process_observation_encode_v1}
use std.common.build_manager.grouped_native_charge_evidence.{NativeGroupChargeSampleV1, NativeGroupChargeTraceV1, native_group_charge_trace_encode_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessInputV1, LinuxProcessRequestV1, LinuxProcessLeaseV1, LinuxProcessPollV1, linux_process_start_with_memory_v1, linux_process_poll_v1, linux_process_cancel_v1, linux_process_peak_memory_v1, linux_process_collect_v1}

fn native_linux_group_observation_v1(observed: LinuxProcessPollV1, peak: i64) -> GroupProcessPollV1:
    val active_charge = if observed.terminal: 0 else: observed.memory_current_bytes
    GroupProcessPollV1(observed.terminal, observed.leader_reaped, observed.tree_empty,
        observed.active_processes, observed.exit_code, observed.timed_out,
        observed.cancelled, peak, active_charge, not observed.terminal)

fn native_linux_group_control_v1(root: text, identity: text) -> text:
    val request = match file_read_regular_no_follow_bounded(root + "/broker.control.request", 4096):
        Ok(value): value
        Err(_): return ""
    val parts = request.split("\n")
    if parts.len() != 3 or parts[0] != identity or not builder_identifier_valid_v1(parts[1]): return ""
    if parts[2] != "probe" and parts[2] != "cancel": return ""
    request

fn native_linux_group_finish_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    val receipt = linux_process_collect_v1(lease)?
    if not receipt.terminal or not receipt.leader_reaped or not receipt.tree_empty or
            receipt.active_processes != 0:
        return Err("Linux group process tree cleanup not proven")
    var final_samples = samples
    var full_trace = complete
    val terminal_ms = time_now_monotonic_ms()
    if terminal_ms < 0 or final_samples.len() == 0 or final_samples.len() >= 32768:
        full_trace = false
    if full_trace and terminal_ms < final_samples[final_samples.len() - 1].after_ms:
        full_trace = false
    if full_trace:
        final_samples = final_samples.push(NativeGroupChargeSampleV1(
            terminal_ms, terminal_ms, 0, peak, 0, true))
    val evidence = native_group_charge_trace_encode_v1(
        NativeGroupChargeTraceV1(snapshot_digest, full_trace, final_samples),
        memory_limit_bytes)
    if evidence != "" and not file_atomic_write(root + "/broker-charge.sdn", evidence):
        print "Linux group broker charge evidence unavailable reason=write-failed"
    val payload = group_process_observation_encode_v1(identity,
        native_linux_group_observation_v1(receipt, peak))
    if not file_atomic_write(root + "/broker.tree.sdn", payload):
        return Err("cannot persist Linux group tree cleanup receipt")
    Ok(true)

fn native_linux_group_drain_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, snapshot_digest: text,
        memory_limit_bytes: i64) -> Result<bool, text>:
    val _cancelled = linux_process_cancel_v1(lease)?
    val deadline = current_time_ms() + 30000
    while current_time_ms() < deadline:
        val observed = linux_process_poll_v1(lease)?
        if observed.terminal:
            val peak = linux_process_peak_memory_v1(lease)?
            return native_linux_group_finish_v1(root, identity, lease, peak,
                snapshot_digest, memory_limit_bytes, [], false)
        sleep_ms(10)
    Err("Linux group cancellation cleanup remains unproven")

fn native_linux_group_run_v1(launch: GroupProcessLaunchV1,
        identity: text) -> Result<bool, text>:
    val request = launch.request
    if not file_is_regular_no_follow(request.broker_program) or
            file_hash_sha256(request.broker_program) != request.broker_digest or
            file_hash_sha256("/proc/self/exe") != request.broker_digest:
        return Err("Linux broker image differs from configured digest")
    var inputs: [LinuxProcessInputV1] = []
    inputs = inputs.push(LinuxProcessInputV1(launch.root + "/broker.request.sdn", identity))
    for input in request.inputs: inputs = inputs.push(LinuxProcessInputV1(input.path, input.digest))
    val native = LinuxProcessRequestV1(request.program, request.producer_digest, request.args,
        request.environment, request.directory, inputs, request.stdout_path,
        request.stderr_path, request.timeout_ms)
    val lease = linux_process_start_with_memory_v1(native, launch.memory_limit_bytes,
        launch.root, identity)?
    var last_control = ""
    var error = ""
    var charge_samples: [NativeGroupChargeSampleV1] = []
    var charge_complete = true
    while error == "":
        val control = native_linux_group_control_v1(launch.root, identity)
        if control != "" and control != last_control and control.ends_with("\ncancel"):
            match linux_process_cancel_v1(lease):
                Ok(_): pass
                Err(message):
                    error = message
                    break
        val sample_before = time_now_monotonic_ms()
        val observed = match linux_process_poll_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val peak = match linux_process_peak_memory_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val sample_after = time_now_monotonic_ms()
        if not observed.terminal:
            if sample_before < 0 or sample_after < sample_before or
                    charge_samples.len() >= 32767:
                charge_complete = false
            elif charge_complete:
                charge_samples = charge_samples.push(NativeGroupChargeSampleV1(
                    sample_before, sample_after, observed.memory_current_bytes,
                    peak, observed.active_processes, false))
        if observed.terminal:
            return native_linux_group_finish_v1(launch.root, identity, lease, peak,
                launch.snapshot_digest, launch.memory_limit_bytes,
                charge_samples, charge_complete)
        if control != "" and control != last_control:
            val payload = group_process_observation_encode_v1(identity,
                native_linux_group_observation_v1(observed, peak))
            if not file_atomic_write(launch.root + "/broker.control.response", control + "\n" + payload):
                error = "cannot publish fresh Linux broker observation"
                break
            last_control = control
        sleep_ms(10)
    val cleanup = native_linux_group_drain_v1(launch.root, identity, lease,
        launch.snapshot_digest, launch.memory_limit_bytes)
    match cleanup:
        Ok(_): Err(error)
        Err(message): Err(error + "; " + message)

fn main() -> i64:
    val args = get_args()
    if args.len() != 5 or args[1] != "--broker-root" or
            args[3] != "--request-digest": return 2
    val root = args[2]
    val identity = args[4]
    if not root.starts_with("/") or not builder_digest_valid_v1(identity): return 2
    val payload = match file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216):
        Ok(value): value
        Err(_): return 2
    val launch = match group_process_launch_decode_v1(payload):
        Ok(value): value
        Err(_): return 2
    if launch.root != root or group_process_identity_v1(launch) != identity: return 2
    val lock = file_lock(root + "/broker.lock", 0)
    if lock < 0: return 3
    if file_exists(root + "/broker.started"):
        val _unlocked = file_unlock(lock)
        return 3
    if not file_atomic_write(root + "/broker.started", identity):
        val _unlocked = file_unlock(lock)
        return 3
    val result = native_linux_group_run_v1(launch, identity)
    val _unlocked = file_unlock(lock)
    match result:
        Ok(_): 0
        Err(message):
            val _written = file_atomic_write(root + "/broker.error", message)
            print "Linux group broker: {message}"
            1
