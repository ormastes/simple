# Independent Linux broker. Its runtime owner holds a pidfd and a cgroup-v2
# scope across manager crashes; only post-collect evidence becomes terminal.
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use app.io.args_ops.{get_args}
use app.io.file_ops.{file_read_regular_no_follow_bounded, file_atomic_write, file_lock, file_unlock, file_exists, file_is_regular_no_follow, file_hash_sha256}
use std.common.build_manager.group_process_child_identity_v1.{GroupProcessChildIdentityV1, group_process_child_identity_encode_v1}
use std.nogc_sync_mut.io.sysinfo_ops.{process_start_identity_checked}
use app.io.time_ops.{sleep_ms, current_time_ms}
use std.io_runtime.{time_now_monotonic_ms}
use std.common.build_manager.group_process_protocol.{GroupProcessLaunchV1, GroupProcessPollV1, group_process_launch_decode_v1, group_process_identity_v1, group_process_observation_encode_v1, group_process_memory_receipt_v1}
use std.common.build_manager.grouped_native_charge_evidence.{NativeGroupChargeSampleV1, NativeGroupChargeTraceV1, native_group_charge_trace_encode_v1}
use std.common.build_manager.memory_policy.{builder_memory_enforcement_bytes_v1}
use std.common.build_manager.contracts.{builder_identifier_valid_v1, builder_digest_valid_v1}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessInputV1, LinuxProcessRequestV1, LinuxProcessLeaseV1, LinuxProcessPollV1, linux_process_start_with_memory_v1, linux_process_poll_v1, linux_process_cancel_v1, linux_process_peak_memory_v1, LinuxProcessCollectAdmissionV2, linux_process_collect_retained_v2}
use std.nogc_sync_mut.io.linux_process_owner.{linux_cgroup_parent_acquire_v1, linux_cgroup_parent_release_v1, linux_process_child_pid_v1}
use std.common.build_manager.capacity_request.{BuilderLinuxParentReceiptV1, builder_linux_parent_receipt_encode_v1}

fn native_linux_group_observation_v1(observed: LinuxProcessPollV1, peak: i64) -> GroupProcessPollV1:
    val active_charge = if observed.terminal: 0 else: observed.memory_current_bytes
    GroupProcessPollV1(observed.terminal, observed.leader_reaped, observed.tree_empty,
        observed.active_processes, observed.exit_code, observed.timed_out,
        observed.cancelled, peak, active_charge, not observed.terminal)

fn native_linux_group_control_v1(root: text, identity: text) -> text:
    val request = match file_read_regular_no_follow_bounded(root + "/broker.control.request", 4096):
        Ok(value): value
        Err(_): return ""
    val parts = request.split("\n")
    if parts.len() != 3 or parts[0] != identity or not builder_identifier_valid_v1(parts[1]): return ""
    if parts[2] != "probe" and parts[2] != "cancel": return ""
    request

fn native_linux_group_finish_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    var last_control = ""
    var last_collect_error = ""
    while true:
        match linux_process_collect_retained_v2(lease):
            case LinuxProcessCollectAdmissionV2.Collected(receipt):
                # Consumed exactly once. Persistence owns this exact receipt;
                # no path returns to poll/collect of the consumed native token.
                val terminal_peak = if receipt.memory_peak_bytes > peak: receipt.memory_peak_bytes else: peak
                return native_linux_group_finish_receipt_v1(root, identity, receipt, terminal_peak,
                    snapshot_digest, memory_limit_bytes, memory_policy, samples, complete)
            case LinuxProcessCollectAdmissionV2.Retryable(reason):
                if reason != last_collect_error:
                    val _marked = native_linux_group_diagnostic_v1(root, identity,
                        "collect-pending", reason)
                    last_collect_error = reason
                val control = native_linux_group_control_v1(root, identity)
                if control != "" and control != last_control:
                    if control.ends_with("\ncancel"):
                        val _cancelled = linux_process_cancel_v1(lease)
                    val observed = linux_process_poll_v1(lease)
                    if observed.is_ok():
                        var frame = native_linux_group_observation_v1(observed.unwrap(), peak)
                        # Native tree-empty is not yet broker-terminal: the
                        # retained lease still needs successful collection.
                        frame.terminal = false
                        val payload = group_process_observation_encode_v1(identity, frame)
                        val _responded = file_atomic_write(root + "/broker.control.response", control + "\n" + payload)
                        last_control = control
                sleep_ms(100)
            case LinuxProcessCollectAdmissionV2.Unknown(reason):
                # Native success may already have consumed the token. Preserve
                # uncertainty and never issue another native operation on it.
                val _marked = native_linux_group_diagnostic_v1(root, identity, "collect-unknown", reason)
                while true:
                    sleep_ms(1000)

fn native_linux_group_finish_receipt_v1(root: text, identity: text,
        receipt: LinuxProcessPollV1, peak: i64, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text, samples: [NativeGroupChargeSampleV1],
        complete: bool) -> Result<bool, text>:
    var final_samples = samples
    var full_trace = complete
    val terminal_ms = time_now_monotonic_ms()
    if terminal_ms < 0 or final_samples.len() == 0 or final_samples.len() >= 32768:
        full_trace = false
    if full_trace and terminal_ms < final_samples[final_samples.len() - 1].after_ms:
        full_trace = false
    if full_trace:
        final_samples = final_samples.push(NativeGroupChargeSampleV1(
            terminal_ms, terminal_ms, 0, peak, 0, true))
    val evidence = native_group_charge_trace_encode_v1(
        NativeGroupChargeTraceV1(snapshot_digest, full_trace, final_samples),
        memory_limit_bytes, memory_policy)
    if evidence != "" and not file_atomic_write(root + "/broker-charge.sdn", evidence):
        print "Linux group broker charge evidence unavailable reason=write-failed"
    val memory = group_process_memory_receipt_v1(identity, memory_policy, memory_limit_bytes, peak, "linux")?
    while not file_atomic_write(root + "/broker-memory.sdn", memory):
        sleep_ms(100)
    val payload = group_process_observation_encode_v1(identity,
        native_linux_group_observation_v1(receipt, peak))
    # Terminal authority is published only after the outer owner removes the
    # acquired parent. The pending record cannot settle a manager attempt.
    while not file_atomic_write(root + "/broker.tree.pending.sdn", payload):
        sleep_ms(100)
    Ok(true)

fn native_linux_group_drain_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, snapshot_digest: text,
        memory_limit_bytes: i64, memory_policy: text) -> Result<bool, text>:
    val cancelled = linux_process_cancel_v1(lease)
    if cancelled.is_err():
        return native_linux_group_hold_unknown_v1(root, identity, lease, snapshot_digest,
            memory_limit_bytes, memory_policy, cancelled.unwrap_err())
    val deadline = time_now_monotonic_ms() + 30000
    while time_now_monotonic_ms() < deadline:
        val observed = linux_process_poll_v1(lease)
        if observed.is_err():
            return native_linux_group_hold_unknown_v1(root, identity, lease, snapshot_digest,
                memory_limit_bytes, memory_policy, observed.unwrap_err())
        if observed.unwrap().terminal:
            val peak = linux_process_peak_memory_v1(lease)
            if peak.is_err():
                return native_linux_group_hold_unknown_v1(root, identity, lease, snapshot_digest,
                    memory_limit_bytes, memory_policy, peak.unwrap_err())
            return native_linux_group_finish_v1(root, identity, lease, peak.unwrap(),
                snapshot_digest, memory_limit_bytes, memory_policy, [], false)
        sleep_ms(10)
    # The broker must keep the pidfd/cgroup lease when cleanup is unknown.
    # Returning here would destroy the only live process authority on exit.
    native_linux_group_hold_unknown_v1(root, identity, lease, snapshot_digest,
        memory_limit_bytes, memory_policy, "Linux group cancellation cleanup remains unproven")

fn native_linux_group_run_v1(launch: GroupProcessLaunchV1,
        identity: text) -> Result<bool, text>:
    # The sealed local GroupProcessLaunchV1 is the acquisition authority.
    val parent = linux_cgroup_parent_acquire_v1(launch.root, identity)?
    val acquired = builder_linux_parent_receipt_encode_v1(BuilderLinuxParentReceiptV1(
        identity, "linux-local", parent.path, parent.device, parent.inode))
    if acquired == "" or not file_atomic_write(launch.root + "/capacity.receipt", acquired):
        val _released = linux_cgroup_parent_release_v1(parent)?
        return Err("cannot persist Linux broker parent receipt")
    val outcome = native_linux_group_run_in_parent_v1(launch, identity)
    while true:
        val released = linux_cgroup_parent_release_v1(parent)
        if released.is_ok(): break
        sleep_ms(100)
    while not file_atomic_write(launch.root + "/capacity.released", acquired):
        sleep_ms(100)
    if file_exists(launch.root + "/broker.tree.pending.sdn"):
        var terminal: Result<text, text> = Err("terminal read pending")
        while terminal.is_err():
            terminal = file_read_regular_no_follow_bounded(launch.root + "/broker.tree.pending.sdn", 4096)
            if terminal.is_err(): sleep_ms(100)
        val retained = terminal.unwrap()
        while not file_atomic_write(launch.root + "/broker.tree.sdn", retained):
            sleep_ms(100)
    outcome

fn native_linux_group_run_in_parent_v1(launch: GroupProcessLaunchV1,
        identity: text) -> Result<bool, text>:
    val request = launch.request
    if not file_is_regular_no_follow(request.broker_program) or
            file_hash_sha256(request.broker_program) != request.broker_digest or
            file_hash_sha256("/proc/self/exe") != request.broker_digest:
        return Err("Linux broker image differs from configured digest")
    var inputs: [LinuxProcessInputV1] = []
    inputs = inputs.push(LinuxProcessInputV1(launch.root + "/broker.request.sdn", identity))
    for input in request.inputs: inputs = inputs.push(LinuxProcessInputV1(input.path, input.digest))
    val native = LinuxProcessRequestV1(request.program, request.producer_digest, request.args,
        request.environment, request.directory, inputs, request.stdout_path,
        request.stderr_path, request.timeout_ms)
    val enforced = builder_memory_enforcement_bytes_v1(launch.memory_policy, launch.memory_limit_bytes)?
    val lease = linux_process_start_with_memory_v1(native, enforced,
        launch.root, identity)?
    if request.mode == "native-worker-v1":
        val captured = native_linux_group_child_identity_publish_v1(launch, identity, lease)
        if captured.is_err():
            val drained = native_linux_group_drain_v1(launch.root, identity, lease,
                launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy)
            if drained.is_err(): return Err(captured.unwrap_err() + "; " + drained.unwrap_err())
            return Err(captured.unwrap_err())
    var last_control = ""
    var error = ""
    var charge_samples: [NativeGroupChargeSampleV1] = []
    var charge_complete = true
    while error == "":
        val control = native_linux_group_control_v1(launch.root, identity)
        if control != "" and control != last_control and control.ends_with("\ncancel"):
            match linux_process_cancel_v1(lease):
                Ok(_): pass
                Err(message):
                    error = message
                    break
        val sample_before = time_now_monotonic_ms()
        val observed = match linux_process_poll_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val peak = match linux_process_peak_memory_v1(lease):
            Ok(value): value
            Err(message):
                error = message
                break
        val sample_after = time_now_monotonic_ms()
        if not observed.terminal:
            if sample_before < 0 or sample_after < sample_before or
                    charge_samples.len() >= 32767:
                charge_complete = false
            elif charge_complete:
                charge_samples = charge_samples.push(NativeGroupChargeSampleV1(
                    sample_before, sample_after, observed.memory_current_bytes,
                    peak, observed.active_processes, false))
        if observed.terminal:
            return native_linux_group_finish_v1(launch.root, identity, lease, peak,
                launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy,
                charge_samples, charge_complete)
        if control != "" and control != last_control:
            val payload = group_process_observation_encode_v1(identity,
                native_linux_group_observation_v1(observed, peak))
            if not file_atomic_write(launch.root + "/broker.control.response", control + "\n" + payload):
                error = "cannot publish fresh Linux broker observation"
                break
            last_control = control
        sleep_ms(10)
    val cleanup = native_linux_group_drain_v1(launch.root, identity, lease,
        launch.snapshot_digest, launch.memory_limit_bytes, launch.memory_policy)
    match cleanup:
        Ok(_): Err(error)
        Err(message): Err(error + "; " + message)

fn main() -> i64:
    val args = get_args()
    if args.len() != 5 or args[1] != "--broker-root" or
            args[3] != "--request-digest": return 2
    val root = args[2]
    val identity = args[4]
    if not root.starts_with("/") or not builder_digest_valid_v1(identity): return 2
    val payload = match file_read_regular_no_follow_bounded(root + "/broker.request.sdn", 16777216):
        Ok(value): value
        Err(_): return 2
    val launch = match group_process_launch_decode_v1(payload):
        Ok(value): value
        Err(_): return 2
    if launch.root != root or group_process_identity_v1(launch) != identity: return 2
    val lock = file_lock(root + "/broker.lock", 0)
    if lock < 0: return 3
    if file_exists(root + "/broker.started"):
        val _unlocked = file_unlock(lock)
        return 3
    if not file_atomic_write(root + "/broker.started", identity):
        val _unlocked = file_unlock(lock)
        return 3
    val result = native_linux_group_run_v1(launch, identity)
    val _unlocked = file_unlock(lock)
    match result:
        Ok(_): 0
        Err(message):
            val _written = file_atomic_write(root + "/broker.error", message)
            print "Linux group broker: {message}"
            1

fn native_linux_group_child_identity_publish_v1(launch: GroupProcessLaunchV1,
        identity: text, lease: LinuxProcessLeaseV1) -> Result<bool, text>:
    # No poll or collect has run yet: the broker still owns the unreaped
    # leader and pidfd. The compiler cannot self-assert this PID or birth.
    val pid = linux_process_child_pid_v1(lease)?
    val birth = process_start_identity_checked(pid)?
    val observed = time_now_monotonic_ms()
    val child = GroupProcessChildIdentityV1(request_identity: identity,
        worker_id: launch.worker_id, producer_digest: launch.request.producer_digest,
        birth_identity: birth.to_text(), generation: launch.generation,
        pid: pid, observed_ms: observed)
    val encoded = group_process_child_identity_encode_v1(child)?
    if not file_atomic_write(launch.root + "/broker.child.sdn", encoded):
        return Err("cannot retain managed native child identity")
    val readback = file_read_regular_no_follow_bounded(launch.root + "/broker.child.sdn", 16384)?
    if readback != encoded: return Err("managed native child identity readback differs")
    Ok(true)

# Durable ownership service state, not a build retry. No new child is started;
# the retained lease survives until actual collect and tree-empty proof work.
fn native_linux_group_hold_unknown_v1(root: text, identity: text,
        lease: LinuxProcessLeaseV1, snapshot_digest: text, memory_limit_bytes: i64,
        memory_policy: text, reason: text) -> Result<bool, text>:
    val _marked = native_linux_group_diagnostic_v1(root, identity, "authority-unknown", reason)
    var last_cancel = ""
    while true:
        val control = native_linux_group_control_v1(root, identity)
        if control != "" and control != last_cancel and control.ends_with("\ncancel"):
            val _cancelled = linux_process_cancel_v1(lease)
            last_cancel = control
        val observed = linux_process_poll_v1(lease)
        if observed.is_ok() and observed.unwrap().terminal:
            val peak = linux_process_peak_memory_v1(lease)
            if peak.is_ok():
                return native_linux_group_finish_v1(root, identity, lease, peak.unwrap(),
                    snapshot_digest, memory_limit_bytes, memory_policy, [], false)
        sleep_ms(100)

fn native_linux_group_diagnostic_v1(root: text, identity: text,
        state: text, reason: text) -> bool:
    if reason.len() > 4096: return false
    var fields: Dict<text, SdnValue> = {}
    fields["schema"] = SdnValue.String("simple/group-owner-diagnostic/v1")
    fields["identity"] = SdnValue.String(identity)
    fields["state"] = SdnValue.String(state)
    fields["reason"] = SdnValue.String(reason)
    val blob = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
    if blob.len() > 16384: return false
    file_atomic_write(root + "/broker." + state + ".sdn", blob)
