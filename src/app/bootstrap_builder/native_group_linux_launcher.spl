# The C owner pins, hashes, and execs one detached broker image through the
# same descriptor. A manager crash cannot close a parent-owned broker lease.
use std.nogc_sync_mut.io.linux_process_owner.{linux_process_launch_broker_v1}

fn native_linux_group_broker_launch_v1(program: text, digest: text,
        args: [text], directory: text) -> Result<bool, text>:
    if not directory.starts_with("/") or directory.contains("\0"):
        return Err("Linux broker working directory must be absolute")
    linux_process_launch_broker_v1(program, digest, args)

export native_linux_group_broker_launch_v1
