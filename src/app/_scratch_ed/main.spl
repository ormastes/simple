use os.crypto.ed25519_ops.{ed_point_encode, ed_point_add, ed_point_double, ed_point_identity, _ed25519_base_point}

fn hexs(b: [u8]) -> text:
    var s = ""
    var i: u64 = 0
    while i < b.len():
        s = s + "{b[i]},"
        i = i + 1
    s

fn main() -> i64:
    val b = _ed25519_base_point()
    # RFC 8032: the base point encodes as 58 66 66 ... 66 (= 88,102,...,102)
    println("B       ={hexs(ed_point_encode(b))}")
    println("id      ={hexs(ed_point_encode(ed_point_identity()))}")
    # Unified add MUST satisfy identity + B == B
    println("id_add_B={hexs(ed_point_encode(ed_point_add(ed_point_identity(), b)))}")
    # double(B) two ways
    println("dbl_B   ={hexs(ed_point_encode(ed_point_double(b)))}")
    println("B_add_B ={hexs(ed_point_encode(ed_point_add(b, b)))}")
    0
