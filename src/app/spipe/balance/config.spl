# S1-C balance score engine configuration.
#
# DEVIATION: `config.sdn` beside this file is the recorded source of truth for
# these numbers (research §13.2/§13.4). `default_config()` hardcodes the same
# values rather than parsing the SDN file — SDN-parsing wiring is deferred to
# keep this package's dependency surface minimal; keep the two in sync by
# hand until a follow-up wires real parsing.

struct ShapeMetricThreshold:
    target_max: Int
    warn_max: Int

struct BalanceConfig:
    weight_cohesion: Int          # 43
    weight_trace_alignment: Int   # 21
    weight_shape: Int             # 21
    weight_axis_coverage: Int     # 15
    shape_depth: ShapeMetricThreshold
    shape_direct_docs: ShapeMetricThreshold
    shape_child_dirs: ShapeMetricThreshold
    shape_tiny_sibling_dirs: ShapeMetricThreshold

fn default_config() -> BalanceConfig:
    BalanceConfig(
        weight_cohesion: 43,
        weight_trace_alignment: 21,
        weight_shape: 21,
        weight_axis_coverage: 15,
        shape_depth: ShapeMetricThreshold(target_max: 3, warn_max: 4),
        shape_direct_docs: ShapeMetricThreshold(target_max: 24, warn_max: 32),
        shape_child_dirs: ShapeMetricThreshold(target_max: 12, warn_max: 16),
        shape_tiny_sibling_dirs: ShapeMetricThreshold(target_max: 0, warn_max: 1)
    )

export ShapeMetricThreshold, BalanceConfig, default_config
