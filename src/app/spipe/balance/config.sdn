# S1-C balance score engine configuration.
#
# Research source: doc/01_research/infra/spipe/spipe_project_local_knowledge_pair_expert_pr_balancing.md
# §13.2 (components), §13.4 (thresholds). Slice 1 keeps only Cohesion,
# TracePathAlignment, Shape, and AxisCoverage (SemanticPurity/Stability/
# Reachability deferred to slice 2 per the refined plan §4.1) and renormalizes
# their original weights (30/15/15/10, sum 70) onto 100:
#   43 = round(30 * 100 / 70), 21 = round(15 * 100 / 70) (x2), 15 = round(10 * 100 / 70)
#
# DEVIATION: this file is the recorded source of truth for the values below,
# but `balance/config.spl`'s `default_config()` currently hardcodes the same
# numbers rather than parsing this SDN file — SDN-parsing wiring is deferred
# (see that file's header comment). Keep both in sync by hand until then.

original_weights: {
  cohesion: 30
  trace_alignment: 15
  shape: 15
  semantic_purity: 15   # deferred to slice 2
  axis_coverage: 10
  stability: 10         # deferred to slice 2
  reachability: 5        # deferred to slice 2
}

renormalized_weights: {
  cohesion: 43
  trace_alignment: 21
  shape: 21
  axis_coverage: 15
}

shape_thresholds: {
  depth: { target_max: 3, warn_max: 4 }
  direct_docs: { target_max: 24, warn_max: 32 }
  child_dirs: { target_max: 12, warn_max: 16 }
  tiny_sibling_dirs: { target_max: 0, warn_max: 1 }
}

thresholds_tenths: {
  target: 850
  floor: 800
  deny: 700
  max_global_regression_tenths: 5
  max_scope_regression_tenths: 10
  legacy_required_improvement_tenths: 20
}
