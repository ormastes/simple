# Cohesion component (research §13.2, "Cohesion — 30%", renormalized to 43).
#
# Cohesion = 100 x (1 - weighted_cut / eligible_weight), expressed here as a
# per-mille raw score (0..1000). A scope with no eligible edges has nothing to
# cut, so it scores a perfect 1000 rather than being punished for having no
# measured edges (mirrors §13.2's caveat that intentionally-excluded edges
# never generate cut cost).

use app.spipe.balance.score_types.{ScopeInput, BalanceComponent}

fn cohesion_name() -> text:
    "cohesion"

fn cohesion_raw(input: ScopeInput) -> Int:
    if input.eligible_weight <= 0:
        return 1000
    val cut_permille = (input.cut_weight * 1000) / input.eligible_weight
    val raw = 1000 - cut_permille
    if raw < 0: return 0
    raw

impl BalanceComponent for cohesion:
    fn name() -> text: cohesion_name()
    fn raw(input: ScopeInput) -> Int: cohesion_raw(input)

export cohesion_name, cohesion_raw, cohesion_as_BalanceComponent
