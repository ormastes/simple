# Trace path alignment component (research §13.2, "Trace path alignment —
# 15%", renormalized to 21).
#
# Lifecycle roots (research/requirements/design/spec/...) are intentionally
# separate directories, so alignment is measured by taxonomy/classification
# consistency across a research->requirement->design->spec chain, not
# physical locality. S1-C is a pure function of pre-counted totals: how many
# expected trace-chain links exist below this scope, and how many of them are
# aligned. Producing those counts from real trace edges is S1-A/graph work,
# out of scope here.

use app.spipe.balance.score_types.{ScopeInput, BalanceComponent}

fn trace_alignment_name() -> text:
    "trace_alignment"

fn trace_alignment_raw(input: ScopeInput) -> Int:
    if input.trace_total <= 0:
        return 1000
    val raw = (input.trace_aligned * 1000) / input.trace_total
    if raw > 1000: return 1000
    raw

impl BalanceComponent for trace_alignment:
    fn name() -> text: trace_alignment_name()
    fn raw(input: ScopeInput) -> Int: trace_alignment_raw(input)

export trace_alignment_name, trace_alignment_raw, trace_alignment_as_BalanceComponent
