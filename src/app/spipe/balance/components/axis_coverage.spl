# Axis coverage component (research §13.2, "Axis coverage — 10%",
# renormalized to 15).
#
# For managed app artifacts: feature classification present, at least one
# layer/component present, owner mapping resolvable, required pair mapping
# present for cross-axis work. S1-C consumes pre-counted totals (how many of
# those checks apply, how many are satisfied); classifying artifacts is out
# of scope for this package.

use app.spipe.balance.score_types.{ScopeInput, BalanceComponent}

fn axis_coverage_name() -> text:
    "axis_coverage"

fn axis_coverage_raw(input: ScopeInput) -> Int:
    if input.axis_total <= 0:
        return 1000
    val raw = (input.axis_present * 1000) / input.axis_total
    if raw > 1000: return 1000
    raw

impl BalanceComponent for axis_coverage:
    fn name() -> text: axis_coverage_name()
    fn raw(input: ScopeInput) -> Int: axis_coverage_raw(input)

export axis_coverage_name, axis_coverage_raw, axis_coverage_as_BalanceComponent
