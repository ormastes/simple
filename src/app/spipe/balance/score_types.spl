# S1-C balance score engine — engine-internal value types.
#
# UPDATE: S1-E's `src/app/spipe/model/types.spl` has landed with the frozen
# §6.3 `ComponentScore` / `Deduction` / `ScoreReport` shapes (byte-compatible
# with what this package originally stubbed locally while S1-E was still in
# flight). `score.spl` now imports those directly instead of redeclaring them
# here — this file keeps only the two engine-internal shapes below, which are
# NOT part of §6 and are owned by S1-C alone.

use app.spipe.model.types.{ComponentScore, Deduction, ScoreReport}

# --- Engine-internal types (not part of the frozen §6 interfaces) ---------

# One scope's raw measurement inputs. A real S1-A/graph integration will
# populate this from `EdgeRecord`/reverse-index data; S1-C itself is a pure
# function of these counts (contract: "no filesystem, clock, or randomness").
struct ScopeInput:
    scope: text                # canonical scope path; "" for the global scope
    eligible_weight: Int       # sum of eligible-edge weights below this scope
    cut_weight: Int            # eligible-edge weight that crosses this scope's boundary
    trace_total: Int           # count of expected trace-chain links
    trace_aligned: Int         # count of those links whose taxonomy/classification aligns
    depth: Int                 # directory depth below the fixed root
    direct_docs: Int           # direct document count in this scope
    child_dirs: Int            # immediate child-directory fanout
    tiny_sibling_dirs: Int     # count of repeated one-doc sibling directories
    axis_total: Int            # axis-coverage checks applicable to this scope
    axis_present: Int          # axis-coverage checks satisfied
    children: [ScopeInput]     # nested scopes; any order — score_scope sorts them

trait BalanceComponent:
    fn name() -> text
    fn raw(input: ScopeInput) -> Int   # per-mille, 0..1000

export ComponentScore, Deduction, ScoreReport, ScopeInput, BalanceComponent
