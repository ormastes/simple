# Heading scanner — byte offsets + slugs + enclosing-section resolution
# (S1-A). Reuses `std.common.markdown.utilities` slug/heading-level logic
# (already line-oriented and ASCII-safe) instead of reimplementing slugify.
#
# BYTE OFFSETS ONLY (plan §3.5.1): heading start/end offsets are byte offsets
# into the raw source, computed by walking `text_to_bytes` line-by-line —
# never `text.len()`/char indexing.

use std.common.string_core.{text_to_bytes, bytes_to_text}
use std.common.markdown.utilities.{markdown_is_heading, markdown_heading_level,
    markdown_strip_heading_marker, markdown_slugify}

struct HeadingRecord:
    level: i64
    text: text
    slug: text
    start_offset: i64   # byte offset of the heading line's first byte
    end_offset: i64     # byte offset one past the heading line's last byte
                         # (exclusive of the trailing newline)

fn _line_text(bytes: [u8], start: i64, end: i64) -> text:
    var out: [u8] = []
    var i = start
    while i < end:
        out.push(bytes[i])
        i = i + 1
    bytes_to_text(out)

# Scans a document for ATX headings (`#`..`######`), returning byte-anchored
# `HeadingRecord`s in source order.
fn scan_headings(source: text) -> [HeadingRecord]:
    val bytes = text_to_bytes(source)
    val n = bytes.len()
    var out: [HeadingRecord] = []
    var i = 0
    var line_start = 0
    while i <= n:
        val at_end = i == n
        val is_nl = not at_end and (bytes[i] as i64) == 10
        if at_end or is_nl:
            val line_end = i
            val line = _line_text(bytes, line_start, line_end)
            if markdown_is_heading(line):
                val level = markdown_heading_level(line)
                val heading_text = markdown_strip_heading_marker(line)
                val slug = markdown_slugify(heading_text)
                out.push(HeadingRecord(level: level, text: heading_text,
                    slug: slug, start_offset: line_start,
                    end_offset: line_end))
            line_start = i + 1
        i = i + 1
    out

# Resolves the enclosing section heading for a byte offset: the last heading
# whose start_offset <= offset, or None if the offset precedes every heading
# (front-matter / preamble — caller falls back to the artifact UID per the
# plan's `from_uid` rule).
fn enclosing_heading(headings: [HeadingRecord], offset: i64) -> Option<HeadingRecord>:
    var best: Option<HeadingRecord> = None
    for h in headings:
        if h.start_offset <= offset:
            best = Some(h)
    best

# Resolves a heading by its slug (`#slug` link fragments), first match wins
# (duplicate slugs are a document authoring issue outside this scanner's
# scope).
fn heading_by_slug(headings: [HeadingRecord], slug: text) -> Option<HeadingRecord>:
    for h in headings:
        if h.slug == slug:
            return Some(h)
    None
