# Bounded deterministic adjustments applied on top of raw RRF (design §3.5).
#
# Only these named, versioned, capped adjustments are allowed:
#   - accepted-trace proximity boost
#   - same feature/component boost
#   - optional recency boost
#   - stale/deprecated penalty
#
# Total positive boost across all adjustments cannot exceed 25% of the
# maximum possible `rrf_raw` for the participating sources
# (`RRF_BOOST_CAP_PERMILLE = 250` from `fusion_types.spl`); total penalties
# cannot reduce the adjusted score below zero. An unnamed/unversioned
# adjustment is rejected outright (design §3.5: "Deployments ... cannot
# introduce unnamed boosts without incrementing the fusion contract
# version") — never silently applied.

use lib.common.search.fusion_types.{RRF_BOOST_CAP_PERMILLE}

pub val ADJUSTMENT_ACCEPTED_TRACE_PROXIMITY_BOOST: text = "accepted_trace_proximity_boost"
pub val ADJUSTMENT_SAME_FEATURE_COMPONENT_BOOST: text = "same_feature_component_boost"
pub val ADJUSTMENT_RECENCY_BOOST: text = "recency_boost"
pub val ADJUSTMENT_STALE_DEPRECATED_PENALTY: text = "stale_deprecated_penalty"

fn _known_adjustment_names() -> [text]:
    [ADJUSTMENT_ACCEPTED_TRACE_PROXIMITY_BOOST, ADJUSTMENT_SAME_FEATURE_COMPONENT_BOOST,
     ADJUSTMENT_RECENCY_BOOST, ADJUSTMENT_STALE_DEPRECATED_PENALTY]

pub enum AdjustmentErrorV1:
    UnknownAdjustmentName

pub struct AdjustmentV1:
    name: text
    delta_scaled: i64          # positive = boost, negative = penalty

pub struct AdjustmentResultV1:
    adjusted_scaled: i64
    applied_names: [text]
    applied_deltas_scaled: [i64]
    boost_cap_scaled: i64      # the 25%-of-max cap actually enforced

fn _is_known_name(name: text) -> bool:
    val known = _known_adjustment_names()
    var i = 0
    while i < known.len():
        if known[i] == name:
            return true
        i = i + 1
    false

# Applies `adjustments` on top of `raw_scaled`, given `max_raw_scaled` (the
# best-case `rrf_raw` across participating sources, from
# `rrf.max_possible_raw_scaled`). Positive deltas are summed and clamped so
# their TOTAL never exceeds `RRF_BOOST_CAP_PERMILLE` (250 == 25%) of
# `max_raw_scaled`; each accepted positive delta is scaled down
# proportionally if the raw sum of positive deltas would exceed the cap.
# Negative deltas (penalties) are applied in full but the final result is
# floored at zero.
fn apply_adjustments(raw_scaled: i64, adjustments: [AdjustmentV1], max_raw_scaled: i64) -> Result<AdjustmentResultV1, AdjustmentErrorV1>:
    var i = 0
    while i < adjustments.len():
        if not _is_known_name(adjustments[i].name):
            return Err(AdjustmentErrorV1.UnknownAdjustmentName)
        i = i + 1

    val boost_cap_scaled = (max_raw_scaled * RRF_BOOST_CAP_PERMILLE) / 1000

    var positive_sum = 0
    var j = 0
    while j < adjustments.len():
        if adjustments[j].delta_scaled > 0:
            positive_sum = positive_sum + adjustments[j].delta_scaled
        j = j + 1

    val scale_positive = positive_sum > boost_cap_scaled and positive_sum > 0

    # Proportional clamp done via a parts-per-million intermediate ratio
    # (`PPM = 1_000_000`) rather than `delta * boost_cap_scaled / positive_sum`
    # directly: both operands here can be ~1e10-1e12 (RRF_SCALE-derived), so a
    # direct product can exceed i64 (hazard #1 rework — fixed point, but must
    # stay OVERFLOW-SAFE fixed point). `delta * PPM` and `boost_cap_scaled *
    # ratio_ppm` both stay well under i64 range for this contract's bounds
    # (RRF_SCALE = 1e12, <=3 sources, source_k <= 1000).
    val ppm = 1000000
    var applied_names: [text] = []
    var applied_deltas: [i64] = []
    var total = raw_scaled
    var k = 0
    while k < adjustments.len():
        val adj = adjustments[k]
        var delta = adj.delta_scaled
        if delta > 0 and scale_positive:
            val ratio_ppm = (delta * ppm) / positive_sum
            delta = (boost_cap_scaled * ratio_ppm) / ppm
        applied_names.push(adj.name)
        applied_deltas.push(delta)
        total = total + delta
        k = k + 1

    if total < 0:
        total = 0

    Ok(AdjustmentResultV1(
        adjusted_scaled: total,
        applied_names: applied_names,
        applied_deltas_scaled: applied_deltas,
        boost_cap_scaled: boost_cap_scaled,
    ))
