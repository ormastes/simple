# Deterministic Reciprocal Rank Fusion — `rrf-fixed-v1` (plan §3.5 / §5.5).
#
# RRF consumes already-ordered candidate lists and NEVER normalizes or
# compares raw scores (hazard: providers return source-local rankings only).
# Fixed-point only — never f64 (hazard #1). Ported from
# `examples/05_stdlib/spipe/src/index/fusion.js` (`fuseRankings`).
#
#   rrf_raw(document) = sum over present sources of RRF_SCALE / (k + source_rank)
#
# using truncating integer division per source contribution (matches the JS
# reference's `RRF_SCALE / BigInt(k + index + 1)`), then an exact integer sum.
# `RRF_SCALE = 1_000_000_000_000` (1e12) fits well inside i64 headroom for the
# sums this contract computes (<= 3 sources, <= 3000-candidate pool).

use lib.common.search.fusion_types.{FusionSourceV1, SourceCandidateV1, SourceRankingV1, MatchTierV1, FusedHitV1, RRF_MIN_K, RRF_MAX_K, RRF_MAX_SOURCE_K, RRF_MAX_POOL}
use std.common.encoding.utf8.{text_codepoints}

pub val RRF_SCALE: i64 = 1000000000000

pub enum FusionErrorV1:
    InvalidK
    InvalidSourceK
    DuplicateSource
    DuplicateDocumentId
    TooManyResults

# Unsigned-byte-order (== codepoint order) comparator, matching the frozen
# `unsigned_utf8_less` contract shape (P4 does not import P1's private helper;
# this is the same algorithm applied to the tie-break field only).
fn _document_id_less(left: text, right: text) -> bool:
    val lcps = text_codepoints(left)
    val rcps = text_codepoints(right)
    var i = 0
    while i < lcps.len() and i < rcps.len():
        if lcps[i] != rcps[i]:
            return lcps[i] < rcps[i]
        i = i + 1
    lcps.len() < rcps.len()

pub struct RawFusionRow:
    document_id: text
    raw_scaled: i64
    source_ranks: {text: i64}

fn _source_key(source: FusionSourceV1) -> text:
    if source == FusionSourceV1.Lexical:
        "lexical"
    elif source == FusionSourceV1.Graph:
        "graph"
    else:
        "semantic"

# Validates request-level bounds shared by every RRF call (design §3.5: "k in
# [1, 10000]"; source_k default/max 1000).
fn _validate_bounds(k: i64, source_k: i64) -> Result<bool, FusionErrorV1>:
    if k < RRF_MIN_K or k > RRF_MAX_K:
        return Err(FusionErrorV1.InvalidK)
    if source_k < 1 or source_k > RRF_MAX_SOURCE_K:
        return Err(FusionErrorV1.InvalidSourceK)
    Ok(true)

# Core fusion: consumes already-ordered `SourceRankingV1` lists (one per
# source, duplicate `FusionSourceV1` values rejected) and produces
# `RawFusionRow`s carrying the exact fixed-point `raw_scaled` sum and each
# source's contributing rank, sorted by the frozen tie-break
# (raw desc, then document ID ascending). No `final_rank`/`match_tier` is
# assigned here — that is the caller's job (plain fusion starts at rank 1;
# identity-dominance fusion starts at rank 2), keeping this function usable
# by both `fuse` below and `identity_dominance_spec.spl`.
fn fuse_raw(source_rankings: [SourceRankingV1], k: i64, source_k: i64) -> Result<[RawFusionRow], FusionErrorV1>:
    match _validate_bounds(k, source_k):
        Err(e):
            return Err(e)
        Ok(_):
            ()

    var seen_sources: {text: bool} = {}
    var raw_by_id: {text: i64} = {}
    var ranks_by_id: {text: {text: i64}} = {}
    var order: [text] = []

    var s = 0
    while s < source_rankings.len():
        val ranking = source_rankings[s]
        val skey = _source_key(ranking.source)
        if seen_sources.has(skey):
            return Err(FusionErrorV1.DuplicateSource)
        seen_sources[skey] = true

        val limit = if ranking.candidates.len() < source_k: ranking.candidates.len() else: source_k
        var seen_ids: {text: bool} = {}
        var i = 0
        while i < limit:
            val candidate = ranking.candidates[i]
            if seen_ids.has(candidate.document_id):
                return Err(FusionErrorV1.DuplicateDocumentId)
            seen_ids[candidate.document_id] = true

            val contribution = RRF_SCALE / (k + candidate.source_rank)
            if raw_by_id.has(candidate.document_id):
                raw_by_id[candidate.document_id] = raw_by_id[candidate.document_id] + contribution
                ranks_by_id[candidate.document_id][skey] = candidate.source_rank
            else:
                raw_by_id[candidate.document_id] = contribution
                ranks_by_id[candidate.document_id] = {skey: candidate.source_rank}
                order.push(candidate.document_id)
            i = i + 1
        s = s + 1

    if order.len() > RRF_MAX_POOL:
        return Err(FusionErrorV1.TooManyResults)

    var result: [RawFusionRow] = []
    var j = 0
    while j < order.len():
        val doc_id = order[j]
        result.push(RawFusionRow(document_id: doc_id, raw_scaled: raw_by_id[doc_id], source_ranks: ranks_by_id[doc_id]))
        j = j + 1
    Ok(_sort_rows(result))

# Insertion sort by (raw_scaled desc, document_id asc) — the pool is bounded
# to `RRF_MAX_POOL` (3000), so O(n^2) is acceptable and keeps this file free
# of a general-purpose sort dependency.
fn _sort_rows(rows: [RawFusionRow]) -> [RawFusionRow]:
    var out: [RawFusionRow] = []
    var i = 0
    while i < rows.len():
        out.push(rows[i])
        i = i + 1
    var a = 1
    while a < out.len():
        var b = a
        while b > 0 and _row_less(out[b], out[b - 1]):
            val tmp = out[b]
            out[b] = out[b - 1]
            out[b - 1] = tmp
            b = b - 1
        a = a + 1
    out

fn _row_less(left: RawFusionRow, right: RawFusionRow) -> bool:
    if left.raw_scaled != right.raw_scaled:
        return left.raw_scaled > right.raw_scaled
    _document_id_less(left.document_id, right.document_id)

# Plain fusion (no identity dominance): produces `FusedHitV1`s ranked from
# `start_rank` (1 for a pure fusion query, 2 when an exact-identity match was
# pinned ahead of it — design §3.5).
fn fuse(source_rankings: [SourceRankingV1], k: i64, source_k: i64, start_rank: i64) -> Result<[FusedHitV1], FusionErrorV1>:
    match fuse_raw(source_rankings, k, source_k):
        Err(e):
            return Err(e)
        Ok(rows):
            var hits: [FusedHitV1] = []
            var i = 0
            while i < rows.len():
                hits.push(FusedHitV1(
                    document_id: rows[i].document_id,
                    match_tier: MatchTierV1.Fused,
                    final_rank: start_rank + i,
                    rrf_raw_scaled: rows[i].raw_scaled,
                    rrf_adjusted_scaled: rows[i].raw_scaled,
                ))
                i = i + 1
            return Ok(hits)

# Removes `document_id` from every source's candidate list without
# renumbering the remaining ranks (design §3.5: identity dominance "removes
# its ID from every source list" before RRF runs over what remains).
fn remove_document_from_sources(source_rankings: [SourceRankingV1], document_id: text) -> [SourceRankingV1]:
    var out: [SourceRankingV1] = []
    var s = 0
    while s < source_rankings.len():
        val ranking = source_rankings[s]
        var kept: [SourceCandidateV1] = []
        var i = 0
        while i < ranking.candidates.len():
            if ranking.candidates[i].document_id != document_id:
                kept.push(ranking.candidates[i])
            i = i + 1
        out.push(SourceRankingV1(
            source: ranking.source,
            source_contract: ranking.source_contract,
            snapshot_id: ranking.snapshot_id,
            scope_digest: ranking.scope_digest,
            candidates: kept,
            complete: ranking.complete,
            source_digest: ranking.source_digest,
        ))
        s = s + 1
    out

# The maximum possible `rrf_raw` for `num_sources` present sources — every
# source contributing its best possible rank-1 term (`source_rank == 1`).
# Used by `adjustments.spl` to compute the 25%-of-max boost cap (design §3.5).
fn max_possible_raw_scaled(k: i64, num_sources: i64) -> i64:
    (RRF_SCALE / (k + 1)) * num_sources
