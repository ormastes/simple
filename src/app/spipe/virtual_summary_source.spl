# SPipe registration seam for generated/untrusted public summaries.

use compiler.common.cache_contract.virtual_source_store_v1.{SummaryAuthV1, VirtualSourceStoreV1}
use compiler.common.cache_contract.virtual_source_consumer_v1.{VirtualSourceConsumerAdapterV1, spipe_virtual_source_v1}

pub fn inject_spipe_virtual_source_v1(store: VirtualSourceStoreV1, auth: SummaryAuthV1, snapshot: text) -> VirtualSourceConsumerAdapterV1:
    spipe_virtual_source_v1(store, auth, snapshot)
