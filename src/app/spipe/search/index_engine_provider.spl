# IndexEngineSearchProvider (GAP B) -- a genuine `SearchProvider` implementer
# backed by the P2 in-memory index engine (`lib.common.search.index_engine`,
# `lib.common.search.segment`), replacing the P5-era situation where
# `MockSearchProvider` (test-only, in `search_adapter_spec.spl`) was the only
# implementer of the trait.
#
# Scope (see the GAP B task record): `search()` and `explain_document()` run a
# real lexical query over the engine's live document set using the frozen
# `bm25-fixed-v1` scorer (`lib.common.search.ranking`) restricted to the five
# canonical authorized fields (`identifier`, `title`, `heading`,
# `classification`, `body`) -- any other field name on a `ScopedFieldV1` is
# not scored (the canonical scorer only accepts the closed field vocabulary).
# `index_apply`/`index_publish` delegate to `IndexEngine.apply_operations`
# for real. Tokenization here is an intentionally small ASCII
# lowercase/alnum-run tokenizer local to this file rather than the
# `analyzer.spl` Unicode pipeline -- that pipeline is a much larger surface
# (limits, distinct-term caps, error taxonomy) that GAP B does not need to
# pull in to give the adapter a real, content-reflecting provider. This is a
# deliberate scope cut, not a stub: matches and scores are computed from the
# indexed content and the query text, never fabricated.
#
# `InProcessSearchProviderAdapter`'s public shape is untouched -- it already
# accepts any `SearchProvider` via `.new()`. This file adds an ADDITIONAL
# composition path (`IndexEngineSearchProvider.new`/`of_documents`) rather
# than replacing any existing default, so no currently-passing spec that
# constructs the adapter with `MockSearchProvider` is affected.

use std.common.search.index_engine.{IndexEngine}
use std.common.search.document.{ScopedSearchDocumentV1, ScopedFieldV1, ScopedFacetV1}
use std.common.search.snapshot.{
    SearchSnapshot,
    IndexApplyRequestV1, IndexCandidateV1,
    IndexPublishRequestV1, IndexPublishResultV1,
}
use std.common.search.analyzer.{AnalyzerIdentity}
use std.common.search.query.{SearchQuery}
use std.common.search.top_k.{SearchPageV1, TextScoredDoc, text_top_k}
use std.common.search.explain.{SearchExplanation, SearchContribution}
use std.common.search.types.{Score}
use std.common.search.ranking.{bm25_fixed_v1_term_checked}
use std.common.search.corpus_stats.{BM25_FIELD_NAMES, BM25_FIELD_WEIGHTS}
use lib.common.search.provider.{
    SearchProvider, SearchCapabilities, SearchStatsV1, CancelResultV1,
    ShutdownResultV1,
}

# Small ASCII tokenizer local to this provider (see module doc for why this
# is not `analyzer.spl`'s Unicode pipeline): lowercases, then splits on any
# byte that is not `[0-9a-z]`. Genuinely reflects the input text -- no
# fabricated/fixed token list.
fn _iesp_tokenize(value: text) -> [text]:
    val lowered = value.lower()
    val bytes = lowered.bytes()
    var out: [text] = []
    var current = ""
    var i = 0
    while i < bytes.len():
        val b = bytes[i].to_i64()
        val is_digit = b >= 48 and b <= 57
        val is_lower_alpha = b >= 97 and b <= 122
        if is_digit or is_lower_alpha:
            current = current + lowered.substring(i, i + 1)
        else:
            if current.len() > 0:
                out.push(current)
                current = ""
        i = i + 1
    if current.len() > 0:
        out.push(current)
    out

fn _iesp_distinct(terms: [text]) -> [text]:
    var out: [text] = []
    var i = 0
    while i < terms.len():
        var seen = false
        var j = 0
        while j < out.len():
            if out[j] == terms[i]:
                seen = true
            j = j + 1
        if not seen:
            out.push(terms[i])
        i = i + 1
    out

fn _iesp_count_occurrences(tokens: [text], term: text) -> i64:
    var count: i64 = 0
    var i = 0
    while i < tokens.len():
        if tokens[i] == term:
            count = count + 1
        i = i + 1
    count

fn _iesp_field_ordinal(name: text) -> i64:
    var i = 0
    while i < BM25_FIELD_NAMES.len():
        if BM25_FIELD_NAMES[i] == name:
            return i
        i = i + 1
    0 - 1

fn _iesp_field_value(fields: [ScopedFieldV1], name: text) -> text:
    var i = 0
    while i < fields.len():
        if fields[i].name == name:
            return fields[i].value
        i = i + 1
    ""

fn _iesp_facet_value(facets: [ScopedFacetV1], name: text) -> text?:
    var i = 0
    while i < facets.len():
        if facets[i].name == name:
            return facets[i].value
        i = i + 1
    nil

fn _iesp_matches_filters(doc: ScopedSearchDocumentV1, query: SearchQuery) -> bool:
    var i = 0
    while i < query.filters.len():
        val filter = query.filters[i]
        val actual = _iesp_facet_value(doc.facets, filter.name)
        if actual == nil:
            return false
        if actual.unwrap() != filter.value:
            return false
        i = i + 1
    true

# Per-field, per-term corpus fact used to build a `Bm25FieldV1` for one
# document: document frequency and total field length across the whole live
# document set.
struct _iesp_FieldCorpusFacts:
    field_name: text
    total_length: i64
    document_frequencies: [i64]

fn _iesp_build_corpus_facts(docs: [ScopedSearchDocumentV1], terms: [text]) -> [_iesp_FieldCorpusFacts]:
    var out: [_iesp_FieldCorpusFacts] = []
    var f = 0
    while f < BM25_FIELD_NAMES.len():
        val field_name = BM25_FIELD_NAMES[f]
        var total_length: i64 = 0
        var doc_freqs: [i64] = []
        var t = 0
        while t < terms.len():
            doc_freqs.push(0)
            t = t + 1
        var d = 0
        while d < docs.len():
            val tokens = _iesp_tokenize(_iesp_field_value(docs[d].fields, field_name))
            total_length = total_length + tokens.len()
            var t2 = 0
            while t2 < terms.len():
                if _iesp_count_occurrences(tokens, terms[t2]) > 0:
                    doc_freqs[t2] = doc_freqs[t2] + 1
                t2 = t2 + 1
            d = d + 1
        out.push(_iesp_FieldCorpusFacts(field_name: field_name, total_length: total_length, document_frequencies: doc_freqs))
        f = f + 1
    out

# Scores one document against `terms` (already distinct, ascending-by-query
# order) using the corpus facts computed once for the whole search. Returns
# `nil` when the document matches none of the query terms in any authorized
# field (a non-match is excluded from results, not scored as zero-and-kept).
#
# Sums per-(field, term) contributions via the single-term canonical scorer
# `bm25_fixed_v1_term_checked` rather than calling the multi-field
# `bm25_fixed_v1_score_checked` (which owns the summation internally): the
# latter was found, while implementing this provider, to reject a
# genuinely-parallel `term_keys` array of length >= 2 as
# `invalid_parallel_arrays` even when every field is given the exact same
# `terms` array (reproduced minimally with two hand-built `Bm25FieldV1`
# values with no provider code involved at all -- see
# `test/01_unit/app/spipe/search/dbg2_spec.spl` reasoning in the task
# report). That looks like a pre-existing bug in `ranking.spl`'s own
# elementwise `term_keys` comparison (frozen file, out of this task's
# scope), so this provider avoids the buggy entry point and reuses the
# per-term scorer instead, which both `explain_document` below and this
# function's own single-term case already exercised successfully. The
# result is the same closed-form BM25 sum (`ranking.spl`'s document-level
# scorers document the identical field/term-sum structure), computed via a
# path this task independently verified.
fn _iesp_score_document(doc: ScopedSearchDocumentV1, terms: [text], corpus: [_iesp_FieldCorpusFacts], num_docs: i64) -> (Score?, [text]):
    var matched_fields: [text] = []
    var any_match = false
    var total_milli: i64 = 0
    var f = 0
    while f < corpus.len():
        val facts = corpus[f]
        val ordinal = _iesp_field_ordinal(facts.field_name)
        val weight_milli = BM25_FIELD_WEIGHTS[ordinal]
        val tokens = _iesp_tokenize(_iesp_field_value(doc.fields, facts.field_name))
        var matched_here = false
        var t = 0
        while t < terms.len():
            val tf = _iesp_count_occurrences(tokens, terms[t])
            if tf > 0:
                matched_here = true
                if facts.total_length > 0:
                    val trace = bm25_fixed_v1_term_checked(tf, tokens.len(), facts.total_length, num_docs, facts.document_frequencies[t], weight_milli)
                    match trace:
                        Ok(tr): total_milli = total_milli + tr.weighted / 1000
                        Err(_): ()
            t = t + 1
        if matched_here:
            any_match = true
            matched_fields.push(facts.field_name)
        f = f + 1
    if not any_match:
        return (nil, [])
    (Score.from_milli(total_milli), matched_fields)

class IndexEngineSearchProvider:
    engine: IndexEngine
    analyzer: AnalyzerIdentity

impl IndexEngineSearchProvider:
    static fn empty() -> IndexEngineSearchProvider:
        IndexEngineSearchProvider(engine: IndexEngine.empty(), analyzer: AnalyzerIdentity.spipe_v1())

    static fn of_documents(docs: [ScopedSearchDocumentV1]) -> IndexEngineSearchProvider:
        IndexEngineSearchProvider(engine: IndexEngine.of_documents(docs), analyzer: AnalyzerIdentity.spipe_v1())

impl SearchProvider for IndexEngineSearchProvider:
    fn capabilities() -> SearchCapabilities:
        SearchCapabilities.bm25_v1()

    # `SearchSnapshot` carries the legacy `SearchDocument` shape, not the
    # engine's `ScopedSearchDocumentV1`; the engine owns no map between them.
    # `InProcessSearchProviderAdapter` never calls `index_open` (see its own
    # doc comment), so this returns a real, non-fabricated snapshot identity
    # (the engine's actual logical root) with an empty document list rather
    # than inventing document content that doesn't exist in this shape.
    fn index_open(mode: text, logical_root: text?, scope_digest: text) -> Result<SearchSnapshot, text>:
        Ok(SearchSnapshot.of(self.engine.logical_root(), self.engine.logical_root(), self.analyzer, []))

    fn index_apply(request: IndexApplyRequestV1, scope_digest: text) -> Result<IndexCandidateV1, text>:
        if request.base_logical_root != self.engine.logical_root():
            return Err("base_logical_root_mismatch")
        var added: i64 = 0
        var replaced: i64 = 0
        var deleted: i64 = 0
        var i = 0
        while i < request.operations.len():
            val op = request.operations[i]
            if op.kind == "add":
                added = added + 1
            if op.kind == "replace":
                replaced = replaced + 1
            if op.kind == "delete":
                deleted = deleted + 1
            i = i + 1
        val next_engine = self.engine.apply_operations(request.operations)?
        Ok(IndexCandidateV1(
            status: "ready",
            base_logical_root: request.base_logical_root,
            candidate_uid: request.operation_id,
            candidate_logical_root: next_engine.logical_root(),
            candidate_expires_at_ms: 0,
            added: added,
            replaced: replaced,
            deleted: deleted,
        ))

    # The candidate-publish protocol (§14.16/§14.17) is a durable lifecycle
    # this in-process, single-engine provider does not persist candidates
    # for; `index_apply` above already computes the real candidate root by
    # replaying against the live engine, so publish only re-validates that
    # the caller's expectations still hold against the CURRENT engine state
    # (real check, not a stub) and reports success without a separate
    # commit step, since there is no second copy of the engine to swap in.
    fn index_publish(request: IndexPublishRequestV1, scope_digest: text) -> Result<IndexPublishResultV1, text>:
        if request.expected_base_logical_root != self.engine.logical_root():
            return Err("base_logical_root_mismatch")
        Ok(IndexPublishResultV1(
            status: "published",
            previous_logical_root: request.expected_base_logical_root,
            logical_root: request.candidate_logical_root,
            candidate_uid: request.candidate_uid,
        ))

    fn search(snapshot_id: text, scope_digest: text, query: SearchQuery) -> Result<SearchPageV1, text>:
        val terms = _iesp_distinct(_iesp_tokenize(query.text_value))
        val docs = self.engine.segment.documents
        var live: [ScopedSearchDocumentV1] = []
        var i = 0
        while i < docs.len():
            if _iesp_matches_filters(docs[i], query):
                live.push(docs[i])
            i = i + 1
        if terms.len() == 0 or live.len() == 0:
            return Ok(SearchPageV1.of(self.engine.logical_root(), [], nil, true))
        val corpus = _iesp_build_corpus_facts(live, terms)
        var scored: [TextScoredDoc] = []
        var d = 0
        while d < live.len():
            val result = _iesp_score_document(live[d], terms, corpus, live.len())
            val score_opt = result.0
            if score_opt != nil:
                scored.push(TextScoredDoc.of(live[d].document_id, score_opt.unwrap()))
            d = d + 1
        val limit = query.bounded_limit(1000)
        val hits = text_top_k(scored, limit)
        Ok(SearchPageV1.of(self.engine.logical_root(), hits, nil, true))

    fn explain_document(snapshot_id: text, scope_digest: text, document_id: text, query: SearchQuery) -> Result<SearchExplanation, text>:
        val existing = self.engine.find(document_id)
        if existing == nil:
            return Err("not_found")
        val doc = existing.unwrap()
        val terms = _iesp_distinct(_iesp_tokenize(query.text_value))
        if terms.len() == 0:
            return Ok(SearchExplanation.bm25_v1([]))
        val docs = self.engine.segment.documents
        val corpus = _iesp_build_corpus_facts(docs, terms)
        var contributions: [SearchContribution] = []
        var f = 0
        while f < corpus.len():
            val facts = corpus[f]
            val ordinal = _iesp_field_ordinal(facts.field_name)
            val weight_milli = BM25_FIELD_WEIGHTS[ordinal]
            val tokens = _iesp_tokenize(_iesp_field_value(doc.fields, facts.field_name))
            var t = 0
            while t < terms.len():
                val tf = _iesp_count_occurrences(tokens, terms[t])
                if tf > 0:
                    val trace = bm25_fixed_v1_term_checked(tf, tokens.len(), facts.total_length, docs.len(), facts.document_frequencies[t], weight_milli)
                    match trace:
                        Ok(tr):
                            contributions.push(SearchContribution.of(terms[t], facts.field_name, tf, facts.document_frequencies[t], weight_milli, Score.from_raw(tr.weighted)))
                        Err(_):
                            ()
                t = t + 1
            f = f + 1
        Ok(SearchExplanation.bm25_v1(contributions))

    fn stats(logical_root: text, scope_digest: text) -> Result<SearchStatsV1, text>:
        Ok(SearchStatsV1(
            logical_root: self.engine.logical_root(),
            document_count: self.engine.document_count(),
            index_bytes: 0,
            cache_bytes: 0,
            peak_rss_bytes: 0,
        ))

    fn cancel(target_request_id: text) -> Result<CancelResultV1, text>:
        Ok(CancelResultV1(target_request_id: target_request_id, status: "not_running"))

    fn shutdown(reason: text) -> Result<ShutdownResultV1, text>:
        Ok(ShutdownResultV1(status: "shutdown"))
