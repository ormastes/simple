# Full search cache key (P5, plan §5.1): workspace + snapshot + scope +
# score contract + analyzer contract + query receipt digest. Two requests
# that differ on ANY of these axes must never collide, and two requests
# identical on all of them must produce the identical key (determinism is the
# whole point of a cache key).
#
# `query_receipt_digest` is a caller-supplied opaque digest (P0's
# `QueryReceiptV1`, once bound, hashes to one) -- this module does not
# recompute it, only folds it in positionally so its contribution cannot be
# silently dropped.

use lib.common.search.contract_ids.{ANALYZER_CONTRACT_ID, SCORE_CONTRACT_ID}

pub struct CacheKeyPartsV1:
    workspace: text
    snapshot: text
    scope_digest: text
    query_receipt_digest: text

impl CacheKeyPartsV1:
    static fn of(workspace: text, snapshot: text, scope_digest: text, query_receipt_digest: text) -> CacheKeyPartsV1:
        CacheKeyPartsV1(workspace: workspace, snapshot: snapshot, scope_digest: scope_digest, query_receipt_digest: query_receipt_digest)

# `|`-delimited positional join. Every field is validated non-empty so an
# absent field cannot silently collapse two distinct keys onto the same
# string (e.g. workspace="" + snapshot="a|b" colliding with workspace="a" +
# snapshot="b" -- guarded by rejecting the `|` delimiter inside any field).
fn reject_delimiter(field: text, value: text) -> Result<bool, text>:
    var i = 0
    while i < value.len():
        if value[i] == "|":
            return Err("cache_key_field_contains_delimiter:" + field)
        i = i + 1
    Ok(true)

pub fn compute_cache_key(parts: CacheKeyPartsV1) -> Result<text, text>:
    if parts.workspace.len() == 0:
        return Err("cache_key_empty_workspace")
    if parts.snapshot.len() == 0:
        return Err("cache_key_empty_snapshot")
    if parts.scope_digest.len() == 0:
        return Err("cache_key_empty_scope_digest")
    if parts.query_receipt_digest.len() == 0:
        return Err("cache_key_empty_query_receipt_digest")
    reject_delimiter("workspace", parts.workspace)?
    reject_delimiter("snapshot", parts.snapshot)?
    reject_delimiter("scope_digest", parts.scope_digest)?
    reject_delimiter("query_receipt_digest", parts.query_receipt_digest)?
    Ok(SCORE_CONTRACT_ID + "|" + ANALYZER_CONTRACT_ID + "|" + parts.workspace + "|" + parts.snapshot + "|" + parts.scope_digest + "|" + parts.query_receipt_digest)
