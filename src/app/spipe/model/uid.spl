# SPipe Slice-1 canonical UID derivation (S1-E).
#
# Ported from the JS oracle (examples/05_stdlib/spipe/src/model/identity.js:
# `crockfordDigestPayload`, `deriveCanonicalUid`). Byte-for-byte parity with
# that implementation is the contract -- vectors generated once from the JS
# code are checked into test/fixture/spipe/uid_vectors.sdn and asserted in
# model_identity_spec.spl.
#
# Algorithm: SHA-256 the domain-separated payload, then Crockford-base32
# encode the first 130 digest bits (26 chars @ 5 bits), MSB-first, zero
# padding the final 2 bits. Reuses `std.common.crypto.sha256.sha256_u8_hex`
# (project rule: no new hashing) -- the raw digest bytes are recovered by
# parsing that hex string back to bytes, which is bit-identical to the raw
# digest since hex is just a byte encoding.

use std.common.crypto.sha256.{sha256_u8_hex}

val CROCKFORD_ALPHABET: text = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

# UID_PREFIXES from the JS oracle. "W" (Workspace) is deliberately excluded
# from derive_canonical_uid, matching JS `deriveCanonicalUid`'s guard.
val UID_PREFIXES: [text] = [
    "A", "S", "SS", "SY", "E", "P", "W", "WS", "WT", "R", "RQ", "NFR",
    "T", "F", "C", "L", "TG", "AL", "M", "K", "V", "D"
]

fn _hex_nibble(c: text) -> i64:
    if c == "0": return 0
    elif c == "1": return 1
    elif c == "2": return 2
    elif c == "3": return 3
    elif c == "4": return 4
    elif c == "5": return 5
    elif c == "6": return 6
    elif c == "7": return 7
    elif c == "8": return 8
    elif c == "9": return 9
    elif c == "a": return 10
    elif c == "b": return 11
    elif c == "c": return 12
    elif c == "d": return 13
    elif c == "e": return 14
    elif c == "f": return 15
    0

# Parse a lowercase hex string into its raw byte values. Inverse of the hex
# encoding done by `sha256_u8_hex`; byte-identical to the raw digest.
fn _hex_to_bytes(hex: text) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i + 1 < hex.len():
        val hi = _hex_nibble(hex.substring(i, i + 1))
        val lo = _hex_nibble(hex.substring(i + 1, i + 2))
        out.push(hi * 16 + lo)
        i = i + 2
    out

# Crockford-base32 encode the first 130 bits of sha256(payload) MSB-first,
# zero-padding the final 2 bits to fill the 26th 5-bit group. `payload` is
# the exact byte sequence to hash, already domain-separated by the caller.
pub fn crockford_digest_payload(payload: [u8]) -> text:
    val hex = sha256_u8_hex(payload)
    val digest = _hex_to_bytes(hex)
    var bits = 0
    var bit_count = 0
    var output = ""
    var di = 0
    while di < digest.len() and output.len() < 26:
        bits = (bits << 8) | digest[di]
        bit_count = bit_count + 8
        while bit_count >= 5 and output.len() < 26:
            bit_count = bit_count - 5
            val idx = (bits >> bit_count) & 31
            output = output + CROCKFORD_ALPHABET.substring(idx, idx + 1)
            bits = bits & ((1 << bit_count) - 1)
        di = di + 1
    if output.len() < 26:
        val idx = (bits << (5 - bit_count)) & 31
        output = output + CROCKFORD_ALPHABET.substring(idx, idx + 1)
    output

fn _contains_text(values: [text], target: text) -> bool:
    var i = 0
    while i < values.len():
        if values[i] == target: return true
        i = i + 1
    false

# `bytes = domain + "\0" + value`, then crockford_digest_payload, prefixed.
# Matches JS `deriveCanonicalUid(prefix, domain, value)` for text `value`
# (JS canonicalizes `value` via `JSON.stringify` before hashing when it is a
# plain string -- callers here must pass an already-canonical-JSON-encoded
# `value` string, e.g. via model/canonical.spl, to stay byte-compatible).
pub fn derive_canonical_uid(prefix: text, domain: text, value: text) -> Result<text, text>:
    if not _contains_text(UID_PREFIXES, prefix) or prefix == "W":
        return Err("SPK005: unsupported derived UID prefix: " + prefix)
    var payload: [u8] = []
    val domain_bytes = domain.bytes()
    var i = 0
    while i < domain_bytes.len():
        payload.push(domain_bytes[i])
        i = i + 1
    payload.push(0u8)
    val value_bytes = value.bytes()
    var j = 0
    while j < value_bytes.len():
        payload.push(value_bytes[j])
        j = j + 1
    Ok(prefix + "-" + crockford_digest_payload(payload))
