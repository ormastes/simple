# SPipe Slice-1 edge construction, sort, and endpoint validation (S1-E).
#
# EdgeType itself lives in model/types.spl (frozen §6.2). This module only
# adds behavior: name<->enum mapping, constructor validation, sort key, and
# duplicate-endpoint-pair detection when assembling an edge set.

use app.spipe.model.types.{EdgeRecord, EdgeType, EdgeOrigin, EdgeStatus, SourceRange}

pub fn edge_type_to_text(t: EdgeType) -> text:
    match t:
        EdgeType.Contains: "contains"
        EdgeType.Classifies: "classifies"
        EdgeType.EvidenceFor: "evidence_for"
        EdgeType.Derives: "derives"
        EdgeType.Satisfies: "satisfies"
        EdgeType.Realizes: "realizes"
        EdgeType.Schedules: "schedules"
        EdgeType.Specifies: "specifies"
        EdgeType.Implements: "implements"
        EdgeType.Verifies: "verifies"
        EdgeType.Covers: "covers"
        EdgeType.Produces: "produces"
        EdgeType.LinksTo: "links_to"
        EdgeType.Aliases: "aliases"
        EdgeType.Supersedes: "supersedes"
        EdgeType.Extends: "extends"
        EdgeType.PromotedFrom: "promoted_from"
        EdgeType.DependsOn: "depends_on"
        EdgeType.MountedAs: "mounted_as"

pub fn edge_type_from_text(name: text) -> Result<EdgeType, text>:
    if name == "contains": return Ok(EdgeType.Contains)
    elif name == "classifies": return Ok(EdgeType.Classifies)
    elif name == "evidence_for": return Ok(EdgeType.EvidenceFor)
    elif name == "derives": return Ok(EdgeType.Derives)
    elif name == "satisfies": return Ok(EdgeType.Satisfies)
    elif name == "realizes": return Ok(EdgeType.Realizes)
    elif name == "schedules": return Ok(EdgeType.Schedules)
    elif name == "specifies": return Ok(EdgeType.Specifies)
    elif name == "implements": return Ok(EdgeType.Implements)
    elif name == "verifies": return Ok(EdgeType.Verifies)
    elif name == "covers": return Ok(EdgeType.Covers)
    elif name == "produces": return Ok(EdgeType.Produces)
    elif name == "links_to": return Ok(EdgeType.LinksTo)
    elif name == "aliases": return Ok(EdgeType.Aliases)
    elif name == "supersedes": return Ok(EdgeType.Supersedes)
    elif name == "extends": return Ok(EdgeType.Extends)
    elif name == "promoted_from": return Ok(EdgeType.PromotedFrom)
    elif name == "depends_on": return Ok(EdgeType.DependsOn)
    elif name == "mounted_as": return Ok(EdgeType.MountedAs)
    Err("SPK004: unknown edge_type: " + name)

# Constructor validation. Bad-endpoint rule ported from JS `validateCommon`:
# an edge cannot connect a node to itself, except `links_to` (a document can
# link to its own heading/section).
pub fn create_edge_record(uid: text, edge_type: EdgeType, from_uid: text,
        to_uid: text, origin: EdgeOrigin, status: EdgeStatus,
        source_range: Option<SourceRange>) -> Result<EdgeRecord, text>:
    if uid.len() == 0: return Err("SPK001: uid must be a non-empty string")
    if from_uid.len() == 0: return Err("SPK001: from_uid must be a non-empty string")
    if to_uid.len() == 0: return Err("SPK001: to_uid must be a non-empty string")
    if from_uid == to_uid and edge_type != EdgeType.LinksTo:
        return Err("SPK008: an edge cannot connect a node to itself")
    if edge_type == EdgeType.LinksTo and source_range.is_none():
        return Err("SPK009: links_to edges require a source_range")
    Ok(EdgeRecord(uid: uid, edge_type: edge_type, from_uid: from_uid,
        to_uid: to_uid, origin: origin, status: status,
        source_range: source_range))

# Sort key: (from_uid, edge_type, to_uid, uid) lexical, matching JS
# `edgeSortKey`. NUL is used as the field separator since it cannot appear in
# a validated uid or edge-type name.
pub fn edge_sort_key(e: EdgeRecord) -> text:
    e.from_uid + "\x00" + edge_type_to_text(e.edge_type) + "\x00" + e.to_uid + "\x00" + e.uid

fn _insert_sorted(sorted: [EdgeRecord], keys: [text], e: EdgeRecord, key: text) -> ([EdgeRecord], [text]):
    var out: [EdgeRecord] = []
    var out_keys: [text] = []
    var inserted = false
    var i = 0
    while i < sorted.len():
        if not inserted and key < keys[i]:
            out.push(e)
            out_keys.push(key)
            inserted = true
        out.push(sorted[i])
        out_keys.push(keys[i])
        i = i + 1
    if not inserted:
        out.push(e)
        out_keys.push(key)
    (out, out_keys)

pub fn sort_edges(edges: [EdgeRecord]) -> [EdgeRecord]:
    var sorted: [EdgeRecord] = []
    var keys: [text] = []
    var i = 0
    while i < edges.len():
        val key = edge_sort_key(edges[i])
        val result = _insert_sorted(sorted, keys, edges[i], key)
        sorted = result.0
        keys = result.1
        i = i + 1
    sorted

# Rejects an edge set carrying two records for the identical
# (from_uid, edge_type, to_uid) triple -- a duplicate edge-type construction
# between the same endpoint pair. Distinct source spans producing distinct
# `links_to` occurrences must therefore carry distinct (from_uid, to_uid) or
# be merged by the caller before reaching this check.
pub fn validate_no_duplicate_edge_types(edges: [EdgeRecord]) -> Result<[EdgeRecord], text>:
    var seen: [text] = []
    var i = 0
    while i < edges.len():
        val key = edges[i].from_uid + "\x00" + edge_type_to_text(edges[i].edge_type) + "\x00" + edges[i].to_uid
        var j = 0
        var dup = false
        while j < seen.len():
            if seen[j] == key: dup = true
            j = j + 1
        if dup:
            return Err("SPK010: duplicate edge_type between the same endpoints: " + key)
        seen.push(key)
        i = i + 1
    Ok(edges)
