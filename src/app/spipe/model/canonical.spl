# SPipe Slice-1 canonical bytes (S1-E).
#
# DEVIATION FROM THE PLAN, recorded per instructions: §6's porting note says
# "delegate to spipe_knowledge_provider canonical JSON emitter or SDN
# canonical form; pick one, document it, use it everywhere." Both existing
# candidates (`canonical_json_emitter.spl`'s cursor-based streaming byte
# generator, and full SDN canonicalization) are designed for bounded
# streaming wire responses / whole-document round-trips, not one-shot hashing
# of small values. This module instead implements a minimal canonical-JSON
# text encoder directly, matching the JS oracle's `canonicalValue`
# (examples/05_stdlib/spipe/src/model/identity.js:164-170) byte-for-byte for
# the value shapes Slice 1 needs: strings, integers, arrays, and objects.
#
# Sorted-key dict support (CDict) was added when the score engine needed it:
# S1-C had shipped a second, local "canonical bytes" encoder in
# balance/score.spl because this module had no object shape. Two definitions
# of canonical bytes is how cross-platform determinism silently diverges, so
# score.spl now delegates here and this module is the ONE encoder. Add new
# shapes here rather than starting a third. Revisit this choice if a one-shot
# ("give me the bytes now") helper is added to the provider emitter.
#
# Used everywhere Slice 1 needs canonical bytes: UID derivation
# (model/uid.spl) and ScoreReport/canonical-serialization callers.

pub enum CanonicalValue:
    CText(text)
    CInt(i64)
    CList([CanonicalValue])
    CDict([CanonicalField])

# One object field. Keys are sorted by BYTE order at emission time, so the
# construction order of a CDict never affects the output.
pub struct CanonicalField:
    key: text
    value: CanonicalValue

pub fn cfield(key: text, value: CanonicalValue) -> CanonicalField:
    CanonicalField { key: key, value: value }

# Byte-lexical key comparison. Deliberately NOT `<` on text: text comparison
# is char-oriented, and canonical output must be stable in byte terms for the
# same reason every offset in Slice 1 is a byte offset.
fn _key_less(a: text, b: text) -> bool:
    val ab = a.bytes()
    val bb = b.bytes()
    var i = 0
    while i < ab.len() and i < bb.len():
        if ab[i] != bb[i]:
            return ab[i] < bb[i]
        i = i + 1
    ab.len() < bb.len()

# Insertion sort on a small field list; stable and allocation-light. Mutates
# through the single owner -- no `val t = fields` alias copy.
fn _sort_fields(fields: [CanonicalField]) -> [CanonicalField]:
    var out = fields
    var i = 1
    while i < out.len():
        var j = i
        while j > 0 and _key_less(out[j].key, out[j - 1].key):
            val tmp = out[j - 1]
            out[j - 1] = out[j]
            out[j] = tmp
            j = j - 1
        i = i + 1
    out

fn _json_escape(s: text) -> text:
    var out = "\""
    var i = 0
    while i < s.len():
        val c = s.substring(i, i + 1)
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\r":
            out = out + "\\r"
        elif c == "\t":
            out = out + "\\t"
        else:
            out = out + c
        i = i + 1
    out + "\""

# Canonical JSON text for a CanonicalValue: arrays render as `[a,b,c]` with no
# spaces; strings are JSON-quoted. Matches JS `canonicalValue` for these
# shapes exactly (JS `JSON.stringify` of a plain integer is just its decimal
# text, same as ours).
pub fn canonical_json(value: CanonicalValue) -> text:
    match value:
        CanonicalValue.CText(s): _json_escape(s)
        CanonicalValue.CInt(n): "{n}"
        CanonicalValue.CList(items):
            var out = "["
            var i = 0
            while i < items.len():
                if i > 0: out = out + ","
                out = out + canonical_json(items[i])
                i = i + 1
            out + "]"
        CanonicalValue.CDict(fields):
            val sorted = _sort_fields(fields)
            var out = "{"
            var i = 0
            while i < sorted.len():
                if i > 0: out = out + ","
                out = out + _json_escape(sorted[i].key) + ":" + canonical_json(sorted[i].value)
                i = i + 1
            out + "}"

pub fn canonical_bytes(value: CanonicalValue) -> [u8]:
    canonical_json(value).bytes()
