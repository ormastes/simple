# SPipe knowledge-compiler CLI entrypoint (S1-D owns this file).
#
# Slice 1 surface only: `registry` and `admit`. `graph`/`links`/`score`
# depend on S1-A/S1-C, which do not exist yet in this package -- they are
# NOT wired here (see plan §4.2/§7 debt #7: this stays a `bin/simple run`
# entrypoint, not a `bin/simple` built-in subcommand, in slice 1).
#
# Usage:
#   bin/simple run src/app/spipe/main.spl -- registry check
#   bin/simple run src/app/spipe/main.spl -- admit --score <tenths> [--hard <n>] [--prev <tenths>]

use std.cli.cli_util.{get_cli_args}
use app.spipe.diagnostics.registry.{
    load_registry, validate_registry, find_unregistered_used_codes,
}
use app.spipe.admission.verdict.{
    compute_admission_verdict, default_thresholds, admission_diagnostic_codes,
}
use app.spipe.model.types.{ScoreReport, Verdict}

val REGISTRY_PATH = "src/app/spipe/diagnostics/registry.sdn"

fn _print_help():
    print "Usage: spipe <command> [options]"
    print ""
    print "Commands:"
    print "  registry check           validate the diagnostics registry"
    print "  registry list            print every registered diagnostic code"
    print "  admit --score N [--hard N] [--prev N]"
    print "                            compute an admission verdict for a score"
    print "                            (score/prev are int tenths, e.g. 824 = 82.4)"

fn _verdict_text(v: Verdict) -> text:
    match v:
        case Accept:
            "accept"
        case AcceptWithDebt:
            "accept_with_debt"
        case Reject:
            "reject"

fn cmd_registry_check() -> i64:
    match load_registry(REGISTRY_PATH):
        case Ok(rows):
            val problems = validate_registry(rows)
            val used = admission_diagnostic_codes()
            var all_problems = problems
            for code in find_unregistered_used_codes(rows, used):
                all_problems.push("used but unregistered: " + code)
            if all_problems.len() == 0:
                print "registry OK: {rows.len()} rows checked, 0 problems"
                return 0
            print "registry FAIL: {all_problems.len()} problem(s)"
            for p in all_problems:
                print "  - " + p
            return 1
        case Err(msg):
            print "registry FAIL: " + msg
            return 1

fn cmd_registry_list() -> i64:
    match load_registry(REGISTRY_PATH):
        case Ok(rows):
            for row in rows:
                print row.code + " " + row.severity + " " + row.message_key
            return 0
        case Err(msg):
            print "registry FAIL: " + msg
            return 1

fn _parse_int_flag(args: [text], name: text, default_val: i64) -> i64:
    var i = 0
    while i < args.len():
        if args[i] == name and i + 1 < args.len():
            return args[i + 1].to_int()
        i = i + 1
    default_val

fn _has_flag(args: [text], name: text) -> bool:
    for a in args:
        if a == name:
            return true
    false

fn cmd_admit(args: [text]) -> i64:
    val score = _parse_int_flag(args, "--score", -1)
    if score < 0:
        print "admit: --score <tenths> is required"
        return 1
    val hard = _parse_int_flag(args, "--hard", 0)
    val has_prev = _has_flag(args, "--prev")
    val prev_val = _parse_int_flag(args, "--prev", 0)
    val previous: Option<i64> = if has_prev: Some(prev_val) else: None

    val report = ScoreReport(
        schema: "spipe-balance/1",
        scope: "",
        score_tenths: score,
        components: [],
        deductions: [],
        scopes: [],
    )
    val v = compute_admission_verdict(report, hard, previous, default_thresholds())
    print "verdict: " + _verdict_text(v.verdict)
    print "score_tenths: {v.thresholds.deny}..{v.thresholds.target} target, got {score}"
    for r in v.reasons:
        print "  reason: " + r.code + " " + r.message_key
    match v.verdict:
        case Reject:
            return 1
        case _:
            return 0

fn main() -> i64:
    val all_args = get_cli_args()
    if all_args.len() == 0:
        _print_help()
        return 1

    val cmd = all_args[0]
    val rest = all_args[1:all_args.len()]

    match cmd:
        case "registry":
            if rest.len() > 0 and rest[0] == "list":
                return cmd_registry_list()
            return cmd_registry_check()
        case "admit":
            return cmd_admit(rest)
        case "--help":
            _print_help()
            return 0
        case "-h":
            _print_help()
            return 0
        case _:
            print "Unknown command: " + cmd
            _print_help()
            return 1
