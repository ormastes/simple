# S1-B — byte-range rewrite core.
#
# Rewrites ONLY the `[target_start, target_end)` byte range of a link target
# inside a file's content; every other byte is preserved verbatim. Offsets are
# BYTE offsets (never char indices — text.len() is bytes, s[i] indexes chars,
# see .claude/rules/code-style.md hazard #1 / plan §3.5.1). All fallible steps
# return Result; there is no try/catch in Simple.
#
# `RewriteEdit` mirrors the rewritable-target slice of the frozen `SourceRange`
# shape (plan §6.1, owned by S1-E's `model/types.spl`, not yet on disk at the
# time this package was written). Once `model/types.spl` lands, callers may
# construct `RewriteEdit` from a `SourceRange`'s `target_start`/`target_end`/
# `raw_target`-derived replacement — this module never depended on the rest of
# that struct (`path`, `link_form`, `fragment`, …), so no change is needed here.

use std.common.base_encoding.utilities.{base_encoding_text_to_bytes, base_encoding_bytes_to_text}

struct RewriteEdit:
    target_start: i64   # byte offset, inclusive
    target_end: i64      # byte offset, exclusive
    replacement: text    # verbatim replacement bytes (UTF-8 text)

fn byte_slice(bytes: [u8], start: i64, end: i64) -> [u8]:
    var result: [u8] = []
    var i = start
    while i < end:
        result = result.push(bytes[i])
        i = i + 1
    result

# Insertion-sort by target_start DESCENDING. Edit counts per file are small
# (link occurrences in one document), so O(n^2) insertion sort is fine and
# keeps this free of any COW-alias hazard (no owner mutated through a temp
# alias — every step rebinds a fresh local `var`).
fn edits_sorted_descending(edits: [RewriteEdit]) -> [RewriteEdit]:
    var sorted: [RewriteEdit] = []
    for e in edits:
        var out: [RewriteEdit] = []
        var placed = false
        for existing in sorted:
            if not placed and e.target_start > existing.target_start:
                out = out.push(e)
                placed = true
            out = out.push(existing)
        if not placed:
            out = out.push(e)
        sorted = out
    sorted

fn validate_edit_ranges(content_len: i64, edits: [RewriteEdit]) -> Result<(), text>:
    var i = 0
    while i < edits.len():
        val e = edits[i]
        if e.target_start < 0 or e.target_end > content_len or e.target_start > e.target_end:
            return Err("invalid_edit_range")
        i = i + 1
    Ok(())

fn validate_no_overlap(sorted_desc: [RewriteEdit]) -> Result<(), text>:
    var i = 0
    while i + 1 < sorted_desc.len():
        # descending order: sorted_desc[i] starts at or after sorted_desc[i+1].
        # No overlap requires the earlier (lower-offset) edit to fully end
        # before the later (higher-offset) edit begins.
        if sorted_desc[i].target_start < sorted_desc[i + 1].target_end:
            return Err("overlapping_edits")
        i = i + 1
    Ok(())

# Pure function: apply `edits` to `content`, returning the rewritten text.
# Every byte outside every edit's `[target_start, target_end)` is preserved
# byte-identically, including multibyte (non-ASCII) sequences, because all
# slicing happens on the raw byte array, never on char-indexed text.
fn apply_edits_to_text(content: text, edits: [RewriteEdit]) -> Result<text, text>:
    val bytes = base_encoding_text_to_bytes(content)
    val n = bytes.len()
    validate_edit_ranges(n, edits)?
    val sorted_desc = edits_sorted_descending(edits)
    validate_no_overlap(sorted_desc)?
    var current: [u8] = bytes
    for e in sorted_desc:
        val prefix = byte_slice(current, 0, e.target_start)
        val suffix = byte_slice(current, e.target_end, current.len())
        val repl_bytes = base_encoding_text_to_bytes(e.replacement)
        var merged: [u8] = prefix
        for b in repl_bytes:
            merged = merged.push(b)
        for b in suffix:
            merged = merged.push(b)
        current = merged
    Ok(base_encoding_bytes_to_text(current))

export RewriteEdit
export apply_edits_to_text, byte_slice, edits_sorted_descending
export validate_edit_ranges, validate_no_overlap
