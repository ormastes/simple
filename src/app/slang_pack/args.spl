# Both native processes and canonical source dispatch publish their entry path
# as argv[0]. Operands are opaque: a .spl suffix never identifies a launcher.
fn slang_pack_process_args(raw: [text]) -> [text]:
    var operands: [text] = []
    var index = 1
    while index < raw.len():
        operands.push(raw[index])
        index = index + 1
    operands
