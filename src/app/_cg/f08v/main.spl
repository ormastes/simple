fn main() -> void:
    var a: [i64] = [1, 2, 3]
    var s = 0
    for x in a:
        s = s + x
    print("forin={s}")
    var t = 0
    var i = 0
    while i < a.len():
        t = t + a[i]
        i = i + 1
    print("while={t}")
    var v = 0
    for x in a:
        v += x
    print("aug={v}")
    val b: [i64] = [4, 5]
    var c: [i64] = [1, 2]
    c = c + b
    print("mergelen={c.len()} last={c[3]}")
    var d: [i64] = [9]
    d += b
    print("augmergelen={d.len()}")
    var txt = "a"
    val more = "bc"
    txt = txt + more
    print("str={txt}")
    var f = 1.5
    val g = 2.25
    f = f + g
    print("float={f}")
