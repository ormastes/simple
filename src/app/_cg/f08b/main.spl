fn main() -> void:
    var a: [i64] = [1, 2, 3]
    var s = 0
    for x in a:
        s = s + x
    print("forin={s}")
    var t = 0
    var i = 0
    while i < a.len():
        t = t + a[i]
        i = i + 1
    print("while={t}")
    var u = 0
    for j in 0..3:
        u = u + 1
    print("range={u}")
    var v = 0
    for x in a:
        v += x
    print("augassign={v}")
    var w = 0
    for x in a:
        print("body sees x={x}")
        w = w + x
    print("withprint={w}")
