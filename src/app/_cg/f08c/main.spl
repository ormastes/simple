fn main() -> void:
    var a: [i64] = [1, 2, 3]
    var s = 0
    s = s + a[0]
    print("noloop={s}")
    val e = a[1]
    print("elem={e}")
    var t = 0
    t = t + e
    print("viaval={t}")
    var u = 0
    u = a[0] + a[1]
    print("sumdirect={u}")
    var p = a[0]
    print("copy={p}")
    var q = 0
    q = q + 5
    print("const={q}")
    var r = 0
    for x in a:
        val y = x
        r = r + y
    print("loopval={r}")
