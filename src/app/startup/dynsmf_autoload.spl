use os.smf.dynsmf_session.{
    DynSmfSession,
    DynSmfEvidenceRow,
    DynSmfManifestEntry,
    dynsmf_default_manifest,
    dynsmf_policy_from_args_env,
    dynsmf_session_autoload_checked,
    dynsmf_session_new,
    dynsmf_session_queue_missing_background_compiles,
    DynSmfDynloadSetting,
    dynsmf_session_load_checked,
    dynsmf_session_add_evidence,
    dynsmf_srchash_path,
    dynsmf_source_hash_current,
    dynsmf_manifest_source_path,
    dynsmf_background_compile_action,
    dynsmf_abi_path,
    dynsmf_ifacehash_path,
    dynsmf_interface_hash_current,
    dynsmf_artifact_status,
    dynsmf_dynload_setting_parse
}
use os.smf.dynsmf_lifecycle.{dynsmf_session_close}
use app.startup.dynsmf_component_bridge.{dynsmf_component_startup_plan}
use app.io.mod.{env_get, process_spawn_async, file_exists, file_read_text,
    read_file_text_result, time_now_micros}

fn dynsmf_dispatch_background_compiles(session: DynSmfSession, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    var out = session
    var idx = 0
    while idx < out.evidence.len():
        val row = out.evidence[idx]
        if (row.action == dynsmf_background_compile_action() and row.status == "queued"):
            var found_source = ""
            var found_path = ""
            var found_abi = ""
            var mid = 0
            while mid < manifest.len():
                if manifest[mid].id == row.library_id:
                    found_source = dynsmf_manifest_source_path(manifest[mid])
                    found_path = manifest[mid].path
                    found_abi = manifest[mid].abi_version
                mid = mid + 1
            if found_source != "" and found_path != "":
                val current_hash = dynsmf_source_hash_current(found_source)
                val current_iface_hash = dynsmf_interface_hash_current(found_source)
                val srchash_sidecar = dynsmf_srchash_path(found_path)
                val ifacehash_sidecar = dynsmf_ifacehash_path(found_path)
                val abi_sidecar = dynsmf_abi_path(found_path)
                # Sidecars are written only after a successful compile so a
                # failed/partial compile never leaves a fresh-looking status.
                val shell_cmd = "bin/simple compile " + found_source + " -o " + found_path +
                    " && printf %s " + current_hash.to_text() + " > " + srchash_sidecar +
                    " && printf %s " + current_iface_hash.to_text() + " > " + ifacehash_sidecar +
                    " && printf %s " + found_abi + " > " + abi_sidecar
                val pid = process_spawn_async("sh", ["-c", shell_cmd])
                if pid > 0:
                    out.evidence.push(DynSmfEvidenceRow(library_id: row.library_id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "dispatched", handle: pid, generation: out.generation, reason: "spawned_pid:" + pid.to_text()))
                else:
                    out.evidence.push(DynSmfEvidenceRow(library_id: row.library_id, action: dynsmf_background_compile_action(), policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: "spawn_failed"))
        idx = idx + 1
    out

export dynsmf_dispatch_background_compiles

pub fn dynsmf_startup_session_for_manifest_from_values(args: [text], env_dynsmf: text, env_disable: text, session_id: text, manifest: [DynSmfManifestEntry]) -> DynSmfSession:
    # Startup must never spawn a shell/compiler child. Missing autoload
    # artifacts are only QUEUED here (evidence status "queued"); an explicit
    # caller (or a later warm service) runs dynsmf_dispatch_background_compiles.
    if (env_get("SIMPLE_DYNSMF_TRACE") ?? "") == "1":
        print "dynsmf-trace: startup_session_init session=" + session_id
    val policy = dynsmf_policy_from_args_env(args, env_dynsmf, env_disable)
    val queued = dynsmf_session_queue_missing_background_compiles(dynsmf_session_new(session_id, policy), manifest)
    dynsmf_session_autoload_checked(queued, manifest)

pub fn dynsmf_startup_session_from_values(args: [text], env_dynsmf: text, env_disable: text, session_id: text) -> DynSmfSession:
    dynsmf_startup_session_for_manifest_from_values(args, env_dynsmf, env_disable, session_id, dynsmf_default_manifest())

pub fn dynsmf_startup_session(args: [text], session_id: text) -> DynSmfSession:
    dynsmf_startup_session_from_values(
        args,
        env_get("SIMPLE_DYNSMF") ?? "",
        env_get("SIMPLE_DYNSMF_DISABLE") ?? "",
        session_id
    )

# Phase B: settings-aware startup. The canonical component planner
# (presence/placement/activation overlay plus generated static-table facts)
# decides which entries startup touches:
# - presence=off entries contribute ZERO plan rows and are never loaded;
# - only activation=startup rows are loaded here, via the CHECKED path, so
#   the fail-closed artifact validation (SMF\0 magic, stub floor, abi/hash
#   sidecars) still gates every actual load;
# - resolution/load errors are recorded and any previously opened handles are
#   closed immediately in reverse order — fail closed, no partial publication;
# Non-startup activations (command/first_use/manual) load later through their
# own callers. No background compile, source scan, or shell-out occurs here;
# startup consumes only already-compiled checked artifacts.
pub fn dynsmf_startup_session_with_dynload_settings(args: [text], env_dynsmf: text, env_disable: text, session_id: text, manifest: [DynSmfManifestEntry], settings: [DynSmfDynloadSetting]) -> DynSmfSession:
    val policy = dynsmf_policy_from_args_env(args, env_dynsmf, env_disable)
    var out = dynsmf_session_new(session_id, policy)
    val requested: [text] = []
    val plan = dynsmf_component_startup_plan(
        session_id, requested, manifest, settings)
    if not plan.ok:
        return dynsmf_session_add_evidence(out, DynSmfEvidenceRow(
            library_id: "*", action: "component_resolve",
            policy_source: out.policy.source, status: "failed", handle: 0,
            generation: out.generation, reason: plan.reason))
    var idx = 0
    while idx < plan.steps.len():
        val step = plan.steps[idx]
        if step.mode == "dynamic":
            val evidence_before = out.evidence.len()
            out = dynsmf_session_load_checked(out, manifest, step.id)
            if out.evidence.len() > evidence_before:
                val latest = out.evidence[out.evidence.len() - 1]
                if latest.status == "failed":
                    # Transactional startup publication: a later component
                    # failure immediately closes every earlier checked handle
                    # in reverse order. The caller never receives a partially
                    # live component set and need not remember to roll it back.
                    return dynsmf_session_close(out)
        elif step.mode != "static" and step.mode != "absent":
            out = dynsmf_session_add_evidence(out, DynSmfEvidenceRow(
                library_id: step.id, action: "component_resolve",
                policy_source: out.policy.source, status: "failed", handle: 0,
                generation: out.generation, reason: "unknown_mode:" + step.mode))
            return dynsmf_session_close(out)
        idx = idx + 1
    out

pub fn dynsmf_startup_summary(session: DynSmfSession) -> text:
    var loaded = 0
    var skipped = 0
    var failed = 0
    var idx = 0
    while idx < session.evidence.len():
        val row = session.evidence[idx]
        if row.status == "loaded":
            loaded = loaded + 1
        elif row.status == "skipped":
            skipped = skipped + 1
        elif row.status == "failed":
            failed = failed + 1
        idx = idx + 1
    "dynsmf session=" + session.session_id +
        " policy=" + session.policy.source +
        " loaded=" + loaded.to_text() +
        " skipped=" + skipped.to_text() +
        " failed=" + failed.to_text() +
        " evidence=" + session.evidence.len().to_text()

# Per-entry artifact status lines (fresh / stale_impl / stale_interface /
# stale_source / abi_mismatch / missing_file / invalid_magic / ...), additive
# to the existing session-evidence log so --dynsmf-status can distinguish
# "module-only rebuild is sufficient" (stale_impl) from "dependents need a
# rebuild too" (stale_interface) instead of one generic staleness reason.
pub fn dynsmf_startup_artifact_status_lines_for_manifest(manifest: [DynSmfManifestEntry]) -> [text]:
    var rows: [text] = []
    var idx = 0
    while idx < manifest.len():
        val status = dynsmf_artifact_status(manifest[idx])
        rows.push(status.library_id + ":" + status.reason + ":ready=" + status.ready.to_text())
        idx = idx + 1
    rows

pub fn dynsmf_startup_artifact_status_lines() -> [text]:
    dynsmf_startup_artifact_status_lines_for_manifest(dynsmf_default_manifest())

# --- WP-B config consumption: dynload settings from SDN file + env override ---
#
# Config surface (fail-closed everywhere — a malformed line is an explicit
# error, never a silent default):
#
# 1. SDN file (default path: simple_dynload.sdn), subset grammar:
#        dynload:
#          <library_id>: "presence=auto,placement=static,activation=startup"
#    Only the `dynload:` section is read; other top-level sections are ignored.
#    A malformed line INSIDE the dynload section is a hard config error.
#
# 2. Env override SIMPLE_DYNLOAD: `<library_id>:<spec>[;<library_id>:<spec>...]`
#    where <spec> is the same comma key=value axis grammar. Env wins per
#    library id over the file entry for the same id.
#
# Unknown library ids (not in the manifest) and axis parse failures surface as
# DynSmfDynloadConfig(ok: false, reason: ...).

class DynSmfDynloadConfig:
    ok: bool
    reason: text
    settings: [DynSmfDynloadSetting]

fn dynsmf_dynload_strip_quotes(v: text) -> text:
    val parts = v.split("\"")
    if parts.len() == 3 and parts[0] == "" and parts[2] == "":
        return parts[1]
    v

# Extract (ids, specs) pairs from SDN text. Returns reason "" on success.
fn dynsmf_dynload_pairs_from_sdn(sdn_text: text, ids: [text], specs: [text]) -> text:
    val lines = sdn_text.split("\n")
    var in_section = false
    var li = 0
    while li < lines.len():
        val raw = lines[li]
        val line = raw.trim()
        if line != "" and not line.starts_with("#"):
            val indented = raw.starts_with(" ") or raw.starts_with("\t")
            if not indented:
                in_section = line == "dynload:"
                if in_section == false and not line.ends_with(":") and line.split(":").len() < 2:
                    return "malformed_sdn_top_level:" + line
            elif in_section:
                val kv = line.split(":")
                if kv.len() != 2:
                    return "malformed_dynload_line:" + line
                val id = kv[0].trim()
                val spec = dynsmf_dynload_strip_quotes(kv[1].trim())
                if id == "":
                    return "malformed_dynload_line:" + line
                ids.push(id)
                specs.push(spec)
        li = li + 1
    ""

# Extract pairs from the SIMPLE_DYNLOAD env grammar. Returns reason "" on success.
fn dynsmf_dynload_pairs_from_env(env_text: text, ids: [text], specs: [text]) -> text:
    val trimmed = env_text.trim()
    if trimmed == "":
        return ""
    val entries = trimmed.split(";")
    var ei = 0
    while ei < entries.len():
        val entry = entries[ei].trim()
        if entry != "":
            val kv = entry.split(":")
            if kv.len() != 2 or kv[0].trim() == "":
                return "malformed_env_entry:" + entry
            ids.push(kv[0].trim())
            specs.push(kv[1].trim())
        ei = ei + 1
    ""

fn dynsmf_dynload_manifest_find(manifest: [DynSmfManifestEntry], id: text) -> i64:
    var mi = 0
    while mi < manifest.len():
        if manifest[mi].id == id:
            return mi
        mi = mi + 1
    -1

pub fn dynsmf_dynload_settings_from_values(manifest: [DynSmfManifestEntry], sdn_text: text, env_text: text) -> DynSmfDynloadConfig:
    val empty: [DynSmfDynloadSetting] = []
    var file_ids: [text] = []
    var file_specs: [text] = []
    val file_err = dynsmf_dynload_pairs_from_sdn(sdn_text, file_ids, file_specs)
    if file_err != "":
        return DynSmfDynloadConfig(ok: false, reason: file_err, settings: empty)
    var env_ids: [text] = []
    var env_specs: [text] = []
    val env_err = dynsmf_dynload_pairs_from_env(env_text, env_ids, env_specs)
    if env_err != "":
        return DynSmfDynloadConfig(ok: false, reason: env_err, settings: empty)
    # env wins per library id: replace matching file entry, else append
    var oi = 0
    while oi < env_ids.len():
        var replaced = false
        var fi = 0
        while fi < file_ids.len():
            if file_ids[fi] == env_ids[oi]:
                file_specs[fi] = env_specs[oi]
                replaced = true
            fi = fi + 1
        if not replaced:
            file_ids.push(env_ids[oi])
            file_specs.push(env_specs[oi])
        oi = oi + 1
    var settings: [DynSmfDynloadSetting] = []
    var pi = 0
    while pi < file_ids.len():
        val mi = dynsmf_dynload_manifest_find(manifest, file_ids[pi])
        if mi < 0:
            return DynSmfDynloadConfig(ok: false, reason: "unknown_library:" + file_ids[pi], settings: empty)
        val parsed = dynsmf_dynload_setting_parse(manifest[mi], file_specs[pi])
        if not parsed.ok:
            return DynSmfDynloadConfig(ok: false, reason: file_ids[pi] + ":" + parsed.reason, settings: empty)
        settings.push(parsed.setting)
        pi = pi + 1
    DynSmfDynloadConfig(ok: true, reason: "loaded", settings: settings)

pub fn dynsmf_dynload_config_default_path() -> text:
    "simple_dynload.sdn"

pub fn dynsmf_dynload_settings_load(manifest: [DynSmfManifestEntry], config_path: text) -> DynSmfDynloadConfig:
    var sdn_text = ""
    if config_path != "" and file_exists(config_path):
        sdn_text = file_read_text(config_path)
    dynsmf_dynload_settings_from_values(manifest, sdn_text, env_get("SIMPLE_DYNLOAD") ?? "")

# Config-driven startup entry: loads settings from SDN file + SIMPLE_DYNLOAD
# env, then runs the settings-aware startup session. A config error fails
# closed: NO entries are loaded; a single failed "dynload_config" evidence row
# records the reason.
pub fn dynsmf_startup_session_with_dynload_config_values(args: [text], env_dynsmf: text, env_disable: text, session_id: text, manifest: [DynSmfManifestEntry], sdn_text: text, env_dynload: text) -> DynSmfSession:
    val config = dynsmf_dynload_settings_from_values(manifest, sdn_text, env_dynload)
    if not config.ok:
        val policy = dynsmf_policy_from_args_env(args, env_dynsmf, env_disable)
        var out = dynsmf_session_new(session_id, policy)
        out = dynsmf_session_add_evidence(out, DynSmfEvidenceRow(library_id: "*", action: "dynload_config", policy_source: out.policy.source, status: "failed", handle: 0, generation: out.generation, reason: config.reason))
        return out
    dynsmf_startup_session_with_dynload_settings(args, env_dynsmf, env_disable, session_id, manifest, config.settings)

pub fn dynsmf_startup_session_with_dynload_config(args: [text], session_id: text, manifest: [DynSmfManifestEntry], config_path: text) -> DynSmfSession:
    var sdn_text = ""
    if config_path != "" and file_exists(config_path):
        sdn_text = file_read_text(config_path)
    dynsmf_startup_session_with_dynload_config_values(
        args,
        env_get("SIMPLE_DYNSMF") ?? "",
        env_get("SIMPLE_DYNSMF_DISABLE") ?? "",
        session_id,
        manifest,
        sdn_text,
        env_get("SIMPLE_DYNLOAD") ?? ""
    )

# Product checked-dynSMF startup owner. SIMPLE_ASPECT_PACKS remains a separate
# compatibility path owned by app.cli.startup_aspect_packs, keeping its graph
# out of app-root when the operator knob is absent.
val PRODUCT_DYNLOAD_CONFIG_ENV: text = "SIMPLE_DYNLOAD_CONFIG"

# Platform-neutral startup extension selection. Applications only provide
# argv/env values; host-specific discovery remains behind the dynSMF loader.
# Precedence is CLI > env > the default path. Repeated --dynload entries retain
# argv order, and the existing settings merger makes the last value for an id
# win deterministically.
class DynSmfStartupOptions:
    ok: bool
    reason: text
    config_path: text
    settings_text: text
    explicit_config: bool

pub fn dynsmf_startup_options_from_values(args: [text], env_config: text,
        env_settings: text) -> DynSmfStartupOptions:
    var config_path = if env_config != "": env_config else: dynsmf_dynload_config_default_path()
    var explicit_config = env_config != ""
    var cli_settings: [text] = []
    var terminated = false
    var idx = 0
    while idx < args.len():
        val arg = args[idx]
        if terminated:
            idx = idx + 1
            continue
        if arg == "--":
            terminated = true
        elif arg == "--dynload-config":
            if idx + 1 >= args.len() or args[idx + 1] == "":
                return DynSmfStartupOptions(ok: false, reason: "missing_dynload_config_path", config_path: "", settings_text: "", explicit_config: true)
            config_path = args[idx + 1]
            explicit_config = true
            idx = idx + 1
        elif arg.starts_with("--dynload-config="):
            val value = arg.slice("--dynload-config=".len(), arg.len())
            if value == "":
                return DynSmfStartupOptions(ok: false, reason: "missing_dynload_config_path", config_path: "", settings_text: "", explicit_config: true)
            config_path = value
            explicit_config = true
        elif arg == "--dynload":
            if idx + 1 >= args.len() or args[idx + 1] == "":
                return DynSmfStartupOptions(ok: false, reason: "missing_dynload_setting", config_path: config_path, settings_text: "", explicit_config: explicit_config)
            cli_settings.push(args[idx + 1])
            idx = idx + 1
        elif arg.starts_with("--dynload="):
            val value = arg.slice("--dynload=".len(), arg.len())
            if value == "":
                return DynSmfStartupOptions(ok: false, reason: "missing_dynload_setting", config_path: config_path, settings_text: "", explicit_config: explicit_config)
            cli_settings.push(value)
        idx = idx + 1
    var settings_text = env_settings
    for setting in cli_settings:
        if settings_text != "":
            settings_text = settings_text + ";"
        settings_text = settings_text + setting
    DynSmfStartupOptions(ok: true, reason: "loaded", config_path: config_path,
        settings_text: settings_text, explicit_config: explicit_config)

struct ProductDynloadStartupMetrics:
    elapsed_us: i64
    config_file_reads: i64
    raw_pack_file_reads: i64
    full_tree_scans: i64
    child_processes: i64
    latency_target_us: i64
    latency_target_configured: bool
    latency_target_source: text
    measured_max_rss_kib: i64
    rss_target_kib: i64
    rss_target_configured: bool
    rss_evidence_source: text
    raw_apk_counter_state: text
    raw_apk_compat_path: text

class ProductDynloadStartup:
    session: DynSmfSession
    metrics: ProductDynloadStartupMetrics
    config_ok: bool
    exit_code: i64
    error: text
    closed: bool

    # One O(libraries) reverse close. Raw APK compatibility has its own CLI
    # owner and never shares this lifecycle.
    me close() -> bool:
        if self.closed:
            return true
        self.session = dynsmf_session_close(self.session)
        for loaded in self.session.loaded:
            if loaded.status == "loaded":
                self.exit_code = 1
                self.error = "dynSMF close refused: " + loaded.id
                return false
        self.closed = true
        true

fn product_dynload_config_failed(session: DynSmfSession) -> bool:
    for row in session.evidence:
        if row.action == "dynload_config" and row.status == "failed":
            return true
    false

fn product_dynload_failure_reason(session: DynSmfSession) -> text:
    for row in session.evidence:
        if row.status == "failed":
            return row.action + ":" + row.reason
    ""

fn product_dynload_metrics(elapsed_us: i64, config_reads: i64) -> ProductDynloadStartupMetrics:
    ProductDynloadStartupMetrics(
        elapsed_us: if elapsed_us >= 0: elapsed_us else: 0,
        config_file_reads: config_reads,
        raw_pack_file_reads: -1,
        full_tree_scans: 0,
        child_processes: 0,
        latency_target_us: 0,
        latency_target_configured: false,
        latency_target_source: "outer-harness-required",
        measured_max_rss_kib: 0,
        rss_target_kib: 0,
        rss_target_configured: false,
        rss_evidence_source: "outer-harness-required",
        raw_apk_counter_state: "not-owned-deferred",
        raw_apk_compat_path: "app.cli.startup_aspect_packs")

fn product_dynload_startup_from_values(args: [text], env_dynsmf: text,
        env_disable: text, session_id: text, manifest: [DynSmfManifestEntry],
        sdn_text: text, env_dynload: text,
        elapsed_us: i64, config_file_reads: i64) -> ProductDynloadStartup:
    val session = dynsmf_startup_session_with_dynload_config_values(
        args, env_dynsmf, env_disable, session_id, manifest, sdn_text,
        env_dynload)
    val config_failed = product_dynload_config_failed(session)
    val failure = product_dynload_failure_reason(session)
    ProductDynloadStartup(
        session: session,
        metrics: product_dynload_metrics(elapsed_us, config_file_reads),
        config_ok: not config_failed,
        exit_code: if failure == "": 0 else: 1,
        error: if failure == "": "" elif config_failed:
            "dynload config rejected: " + failure
        else:
            "dynload startup rejected: " + failure,
        closed: false)

fn product_dynload_startup(args: [text], session_id: text) -> ProductDynloadStartup:
    val started_us = time_now_micros()
    if (env_get("SIMPLE_DYNSMF_TRACE") ?? "") == "1":
        print "dynsmf-trace: startup_session_init session=" + session_id
    val options = dynsmf_startup_options_from_values(
        args,
        env_get(PRODUCT_DYNLOAD_CONFIG_ENV) ?? "",
        env_get("SIMPLE_DYNLOAD") ?? "")
    val config_path = options.config_path
    val explicit_config = options.explicit_config
    var sdn_text = ""
    var config_reads = 0
    if not options.ok:
        sdn_text = "invalid_dynload_cli:" + options.reason
    elif config_path != "" and file_exists(config_path):
        config_reads = 1
        match read_file_text_result(config_path):
            Ok(content): sdn_text = content
            Err(_): sdn_text = "unreadable_explicit_dynload_config"
    elif explicit_config:
        sdn_text = "missing_explicit_dynload_config"
    val owner = product_dynload_startup_from_values(
        args,
        env_get("SIMPLE_DYNSMF") ?? "",
        env_get("SIMPLE_DYNSMF_DISABLE") ?? "",
        session_id,
        dynsmf_default_manifest(),
        sdn_text,
        options.settings_text,
        0,
        config_reads)
    val finished_us = time_now_micros()
    owner.metrics = product_dynload_metrics(
        if finished_us >= started_us: finished_us - started_us else: 0,
        owner.metrics.config_file_reads)
    owner

fn product_dynload_startup_metrics_line(metrics: ProductDynloadStartupMetrics) -> text:
    "dynload_startup elapsed_us=" + metrics.elapsed_us.to_text() +
        " latency_target_us=" + metrics.latency_target_us.to_text() +
        " latency_target_configured=" + metrics.latency_target_configured.to_text() +
        " latency_target_source=" + metrics.latency_target_source +
        " config_file_reads=" + metrics.config_file_reads.to_text() +
        " raw_pack_file_reads=" + metrics.raw_pack_file_reads.to_text() +
        " full_tree_scans=" + metrics.full_tree_scans.to_text() +
        " child_processes=" + metrics.child_processes.to_text() +
        " measured_max_rss_kib=" + metrics.measured_max_rss_kib.to_text() +
        " rss_target_kib=" + metrics.rss_target_kib.to_text() +
        " rss_target_configured=" + metrics.rss_target_configured.to_text() +
        " rss_evidence_source=" + metrics.rss_evidence_source +
        " raw_apk_counter_state=" + metrics.raw_apk_counter_state +
        " raw_apk_compat_path=" + metrics.raw_apk_compat_path
