# Launch metadata checker.

use std.cli.cli_util (get_cli_args)
use app.startup.launch_metadata.{
    LaunchMetadata,
    launch_metadata_for_path,
    launch_metadata_for_simpleos_path,
    launch_metadata_for_simpleos_baremetal_path,
    launch_metadata_sidecar_path,
    has_native_launch_metadata_trailer,
    parse_launch_metadata_from_native_bytes,
    parse_launch_metadata_sidecar,
    startup_detect_launch_kind,
    startup_plan_from_metadata,
    startup_feature_summary
}
# WP-19: real SimpleArtifactManifest content-hash verification, wired into
# THIS host-runnable CLI check rather than the SimpleOS ring-3 loader — the
# ring-3 loader path is gated behind the VMM PML4 ring-3-spawn blocker (see
# doc/08_tracking/bug/simpleos_vmm_pml4_reads_zero_blocks_ring3_spawn* and
# `cap_exec_gate.spl`'s NOT-YET-WIRED note: every production ring-3 call site
# still passes `caller = 0`, a separate WP-21 stub this WP does not touch).
# `simple launch-meta check` is real, already-shipped, build-invoked CLI code
# (not a spec harness) that already reads an artifact's actual bytes off disk
# via `rt_file_read_bytes` — the natural first caller for a real hash check.
use os.kernel.loader.artifact_manifest.{
    manifest_for_kind, manifest_kind_native_simple, manifest_with_entrypoint,
    manifest_verify_content_hash
}

use std.io_runtime.{file_exists}
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_read_bytes(path: text) -> [u8]?

fn _print_help():
    print "Usage: simple launch-meta check [--simpleos-host|--simpleos-baremetal] [--metadata <path>] [--verify-hash <hex>] <path>"
    print ""
    print "Checks Simple startup metadata policy and sidecars for native, script, SMF, and SimpleOS launch paths."
    print "--verify-hash <hex>: reject unless the artifact's real SHA-256 (SimpleArtifactManifest content-hash"
    print "  verification, WP-19) matches <hex>. Fail closed: a mismatch or corrupted artifact is rejected."

fn _strip_entry_arg(args: [text]) -> [text]:
    if args.len() > 0 and args[0].ends_with("launch_meta_check.spl"):
        return args[1:]
    args

fn _is_simpleos_virtual_path(path: text) -> bool:
    path.starts_with("/sys/apps/") or path.starts_with("/sys/lib/")

fn _dependency_is_concrete_path(dep: text) -> bool:
    dep.starts_with("/") or dep.starts_with("./") or dep.starts_with("../")

fn _check_host_dependency_files(deps: [text], kind: text) -> i64:
    var missing = 0
    for dep in deps:
        if _dependency_is_concrete_path(dep) and not file_exists(dep):
            print "launch-meta: missing {kind} dependency: {dep}"
            missing = missing + 1
    missing

fn _metadata_for_check(path: text, target: text, metadata_path: text) -> LaunchMetadata:
    val simpleos_baremetal = target == "simpleos-baremetal"
    val fallback_kind = startup_detect_launch_kind(path)
    if metadata_path != "":
        val content = rt_file_read_text(metadata_path)
        return parse_launch_metadata_sidecar(content, fallback_kind)
    if not simpleos_baremetal and fallback_kind == "native":
        val bytes = rt_file_read_bytes(path) ?? []
        if has_native_launch_metadata_trailer(bytes):
            return parse_launch_metadata_from_native_bytes(bytes, fallback_kind)
    val default_sidecar = launch_metadata_sidecar_path(path)
    if not simpleos_baremetal and file_exists(default_sidecar):
        return parse_launch_metadata_sidecar(rt_file_read_text(default_sidecar), fallback_kind)
    if simpleos_baremetal:
        return launch_metadata_for_simpleos_baremetal_path(path)
    if target == "simpleos-host":
        return launch_metadata_for_simpleos_path(path)
    launch_metadata_for_path(path)

fn _verify_content_hash(path: text, expect_hash_hex: text) -> i64:
    """WP-19 real production caller: build a minimal SimpleArtifactManifest
    carrying the caller-declared expected hash, read the artifact's ACTUAL
    bytes off disk, and run `manifest_verify_content_hash` for real — not a
    presence check, an actual SHA-256 comparison against real bytes. Fail
    closed on a read failure, a missing declared hash, or a digest mismatch."""
    val bytes = rt_file_read_bytes(path) ?? []
    if bytes.len() == 0u64:
        print "launch-meta: content-hash verify: could not read {path}"
        return 2
    val manifest = manifest_with_entrypoint(
        manifest_for_kind(manifest_kind_native_simple()),
        path
    )
    var declared = manifest
    declared.content_hashes = [expect_hash_hex]
    val outcome = manifest_verify_content_hash(declared, bytes)
    if not outcome.ok:
        print "launch-meta: content-hash verify FAILED path={path} reason={outcome.reason}"
        return 2
    print "launch-meta: content-hash verify ok path={path} reason={outcome.reason}"
    0

fn _check_path(path: text, target: text, metadata_path: text, expect_hash_hex: text) -> i64:
    if path == "":
        print "launch-meta: missing path"
        return 2
    val simpleos_target = target == "simpleos-host" or target == "simpleos-baremetal"
    val simpleos_baremetal = target == "simpleos-baremetal"
    if not simpleos_baremetal and not file_exists(path):
        print "launch-meta: path not found: {path}"
        return 2
    if metadata_path != "" and not file_exists(metadata_path):
        print "launch-meta: metadata path not found: {metadata_path}"
        return 2
    if simpleos_baremetal and not _is_simpleos_virtual_path(path):
        print "launch-meta: SimpleOS paths must be under /sys/apps or /sys/lib: {path}"
        return 2
    if expect_hash_hex != "" and not simpleos_baremetal:
        val hash_rc = _verify_content_hash(path, expect_hash_hex)
        if hash_rc != 0:
            return hash_rc
    val metadata = _metadata_for_check(path, target, metadata_path)
    if simpleos_target and metadata.target_os != "simpleos":
        print "launch-meta: metadata target_os must be simpleos for --simpleos"
        return 2
    if not simpleos_target:
        val missing_native = _check_host_dependency_files(metadata.required_native_dynlibs, "native dynlib")
        val missing_smf = _check_host_dependency_files(metadata.required_smf_dynlibs, "SMF dynlib")
        if missing_native + missing_smf > 0:
            return 2
    val plan = startup_plan_from_metadata(path, [], metadata, not simpleos_baremetal, simpleos_baremetal)
    print "launch-meta: ok {path}"
    print startup_feature_summary(plan)
    0

fn main() -> i64:
    val args = _strip_entry_arg(get_cli_args())
    if args.len() == 0:
        _print_help()
        return 1
    if args[0] == "-h" or args[0] == "--help":
        _print_help()
        return 0
    if args[0] != "check":
        print "launch-meta: unknown command: {args[0]}"
        _print_help()
        return 1
    var target = "host"
    var metadata_path = ""
    var artifact_path = ""
    var expect_hash_hex = ""
    var i = 1
    while i < args.len():
        val arg = args[i]
        if arg == "--simpleos" or arg == "--simpleos-baremetal":
            target = "simpleos-baremetal"
        elif arg == "--simpleos-host":
            target = "simpleos-host"
        elif arg == "--metadata":
            if i + 1 >= args.len():
                print "launch-meta: --metadata requires a path"
                return 2
            i = i + 1
            metadata_path = args[i]
        elif arg.starts_with("--metadata="):
            metadata_path = arg.slice("--metadata=".len(), arg.len())
        elif arg == "--verify-hash":
            if i + 1 >= args.len():
                print "launch-meta: --verify-hash requires a hex digest"
                return 2
            i = i + 1
            expect_hash_hex = args[i]
        elif arg.starts_with("--verify-hash="):
            expect_hash_hex = arg.slice("--verify-hash=".len(), arg.len())
        elif arg.starts_with("-"):
            print "launch-meta: unknown check option: {arg}"
            return 2
        else:
            artifact_path = arg
        i = i + 1
    if artifact_path == "":
        print "launch-meta: check requires a path"
        return 2
    _check_path(artifact_path, target, metadata_path, expect_hash_hex)
