# Canonical bridge from the checked dynSMF manifest/config overlay to the
# pure component startup planner.
#
# This is deliberately a data-only adapter: it performs no file, environment,
# directory, or process access. The resulting dynamic steps are admitted from
# already-compiled SMF artifacts by dynsmf_autoload; the bridge never compiles
# a source module or fabricates an implementation digest.

use os.smf.dynsmf_session.{
    DynSmfManifestEntry,
    DynSmfDynloadSetting,
    dynsmf_dynload_setting_default,
    dynsmf_dynload_setting_find
}
use std.common.structural.component.descriptor.{
    ComponentDescriptorV1,
    component_descriptor_default,
    component_descriptor_v1
}
use app.startup.startup_planner.{
    StartupLoadPlan,
    planner_request_default,
    plan_startup
}

fn dynsmf_component_catalog(manifest: [DynSmfManifestEntry],
        settings: [DynSmfDynloadSetting]) -> [ComponentDescriptorV1]:
    var catalog: [ComponentDescriptorV1] = []
    var idx = 0
    while idx < manifest.len():
        val entry = manifest[idx]
        var setting = dynsmf_dynload_setting_default(entry)
        val configured = dynsmf_dynload_setting_find(settings, entry.id)
        if configured.?:
            setting = configured!
        var descriptor = component_descriptor_default(entry.id, entry.abi_version)
        descriptor.presence = setting.presence
        descriptor.placement = setting.placement
        descriptor.activation = setting.activation
        descriptor.provides = entry.exports
        catalog.push(component_descriptor_v1(descriptor))
        idx = idx + 1
    catalog

# Production startup currently has no generated embedded-component table, so
# the authoritative table is known-empty. `placement=auto` therefore selects
# the checked dynamic artifact; `placement=static` fails closed. The explicit
# static-table inputs keep the same bridge usable once the generator emits a
# real table, without changing the startup or CLI API then.
fn dynsmf_component_startup_plan_with_static_table(command: text,
        requested: [text], manifest: [DynSmfManifestEntry],
        settings: [DynSmfDynloadSetting], static_ids: [text],
        digest_ids: [text], embedded_hashes: [text],
        configured_hashes: [text]) -> StartupLoadPlan:
    var request = planner_request_default(command)
    request.requested = requested
    request.digest_ids = digest_ids
    request.embedded_hashes = embedded_hashes
    request.configured_hashes = configured_hashes
    request.static_table_known = true
    request.static_ids = static_ids
    plan_startup(request, dynsmf_component_catalog(manifest, settings))

fn dynsmf_component_startup_plan(command: text, requested: [text],
        manifest: [DynSmfManifestEntry],
        settings: [DynSmfDynloadSetting]) -> StartupLoadPlan:
    val none: [text] = []
    dynsmf_component_startup_plan_with_static_table(
        command, requested, manifest, settings, none, none, none, none)
