# Stable compiler ABI for prepared-advice dispatch.
#
# This leaf depends on the application runtime owner. The runtime does not
# import this compiler-facing adapter, preserving the ABI -> runtime direction.

use app.startup.aspect_application_runtime.{AspectExecutionContext}

# Backend bridges pass the typed context reference explicitly; no
# global/current-context lookup exists.
fn prepared_advice_dispatch_context_invoke(
    context: AspectExecutionContext,
    slot_id: text,
    form: text
) -> Result<[i64], text>:
    context.invoke_prepared_advice(slot_id, form)

# Fail-stop ABI for compiler-injected prepared advice. The Result-returning
# operation synchronously writes the released-token lifecycle state before an
# error reaches this wrapper, so panic cannot strand an acquired generation.
fn prepared_advice_dispatch_context_invoke_or_panic(
    context: AspectExecutionContext,
    slot_id: text,
    form: text
) -> ():
    val dispatched = prepared_advice_dispatch_context_invoke(
        context, slot_id, form)
    if dispatched.is_err():
        panic(dispatched.unwrap_err())

export prepared_advice_dispatch_context_invoke
export prepared_advice_dispatch_context_invoke_or_panic
