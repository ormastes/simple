# Pure startup component graph resolver.
#
# The app layer owns dependency traversal and startup request projection.  It
# imports only common structural policy and performs no host I/O.  Dynamic
# artifact admission remains an os.smf responsibility.

use std.common.structural.component.descriptor.{
    ComponentDescriptor,
    ComponentDescriptorV1,
    component_catalog_validate
}
use std.common.structural.component.resolver.{
    ComponentResolverCatalog,
    ComponentResolveRequest,
    component_resolve_request,
    component_resolve
}

struct StartupComponentGraphRequest:
    roots: [text]
    component_ids: [text]
    interface_names: [text]
    required_capability_bits: [i64]
    target: text
    profile: text

struct StartupResolvedComponent:
    component_id: text
    interface_name: text
    implementation_id: text
    version: text
    impl_digest: text
    capability_bits: i64
    mode: text
    source_kind: text
    locator: text

struct StartupComponentGraphPlan:
    ok: bool
    reason: text
    ordered: [StartupResolvedComponent]

fn startup_component_graph_request(target: text, profile: text) -> StartupComponentGraphRequest:
    val roots: [text] = []
    val ids: [text] = []
    val interfaces: [text] = []
    val capabilities: [i64] = []
    StartupComponentGraphRequest(roots: roots, component_ids: ids, interface_names: interfaces, required_capability_bits: capabilities, target: target, profile: profile)

fn _startup_component_graph_error(reason: text) -> StartupComponentGraphPlan:
    val ordered: [StartupResolvedComponent] = []
    StartupComponentGraphPlan(ok: false, reason: reason, ordered: ordered)

fn _startup_descriptor_index(catalog: [ComponentDescriptorV1], id: text) -> i64:
    var idx = 0
    while idx < catalog.len():
        if catalog[idx].body.id == id:
            return idx
        idx = idx + 1
    -1

fn _startup_policy_index(req: StartupComponentGraphRequest, id: text) -> i64:
    var idx = 0
    while idx < req.component_ids.len():
        if req.component_ids[idx] == id:
            return idx
        idx = idx + 1
    -1

fn _startup_graph_request_valid(req: StartupComponentGraphRequest) -> bool:
    req.target != "" and req.profile != "" and req.component_ids.len() == req.interface_names.len() and req.component_ids.len() == req.required_capability_bits.len()

fn _startup_catalog_validation(catalog: [ComponentDescriptorV1]) -> text:
    var bodies: [ComponentDescriptor] = []
    var idx = 0
    while idx < catalog.len():
        if catalog[idx].schema_version != 1:
            return "unsupported_descriptor_schema:" + catalog[idx].schema_version.to_text()
        bodies.push(catalog[idx].body)
        idx = idx + 1
    val validation = component_catalog_validate(bodies)
    if not validation.ok:
        return "malformed_component_graph:" + validation.errors[0]
    ""

# Depth-first dependency resolution using explicit stacks and tri-colour
# state: 0=white, 1=active/grey, 2=complete/black.  Encountering grey is a
# cycle; nodes are emitted on blackening, producing dependency-first order.
fn resolve_startup_component_graph(req: StartupComponentGraphRequest, descriptors: [ComponentDescriptorV1], implementations: ComponentResolverCatalog) -> StartupComponentGraphPlan:
    if not _startup_graph_request_valid(req):
        return _startup_component_graph_error("invalid_graph_request")
    val catalog_error = _startup_catalog_validation(descriptors)
    if catalog_error != "":
        return _startup_component_graph_error(catalog_error)
    var colors: [i64] = []
    var idx = 0
    while idx < descriptors.len():
        colors.push(0)
        idx = idx + 1
    var ordered: [StartupResolvedComponent] = []
    var root_idx = 0
    while root_idx < req.roots.len():
        val root_id = req.roots[root_idx]
        root_idx = root_idx + 1
        val root = _startup_descriptor_index(descriptors, root_id)
        if root < 0:
            return _startup_component_graph_error("unknown_component:" + root_id)
        if colors[root] == 2:
            continue
        var stack: [i64] = []
        var next_dependency: [i64] = []
        colors[root] = 1
        stack.push(root)
        next_dependency.push(0)
        while stack.len() > 0:
            val top = stack.len() - 1
            val descriptor_idx = stack[top]
            val body = descriptors[descriptor_idx].body
            val dep_cursor = next_dependency[top]
            if dep_cursor < body.dependencies.len():
                val dependency_id = body.dependencies[dep_cursor]
                next_dependency[top] = dep_cursor + 1
                val dependency_idx = _startup_descriptor_index(descriptors, dependency_id)
                if dependency_idx < 0:
                    return _startup_component_graph_error("unknown_dependency:" + body.id + ":" + dependency_id)
                if colors[dependency_idx] == 1:
                    return _startup_component_graph_error("dependency_cycle:" + dependency_id)
                if colors[dependency_idx] == 0:
                    colors[dependency_idx] = 1
                    stack.push(dependency_idx)
                    next_dependency.push(0)
            else:
                stack.pop()
                next_dependency.pop()
                colors[descriptor_idx] = 2
                val policy_idx = _startup_policy_index(req, body.id)
                if policy_idx < 0:
                    return _startup_component_graph_error("missing_component_policy:" + body.id)
                val resolve_req = component_resolve_request(body.id, req.interface_names[policy_idx], req.required_capability_bits[policy_idx], req.target, req.profile)
                match component_resolve(implementations, resolve_req):
                    Ok(value):
                        ordered.push(StartupResolvedComponent(component_id: value.component_id, interface_name: value.interface_name, implementation_id: value.implementation_id, version: value.version, impl_digest: value.impl_digest, capability_bits: value.capability_bits, mode: value.mode, source_kind: value.source_kind, locator: value.locator))
                    Err(error):
                        return _startup_component_graph_error(error.code + ":" + body.id)
    StartupComponentGraphPlan(ok: true, reason: "resolved", ordered: ordered)

fn startup_component_graph_render(plan: StartupComponentGraphPlan) -> text:
    var out = if plan.ok: "ok:" else: "err:"
    out = out + plan.reason
    var idx = 0
    while idx < plan.ordered.len():
        val item = plan.ordered[idx]
        out = out + "|" + item.component_id + ":" + item.interface_name + ":" + item.mode + ":" + item.implementation_id
        idx = idx + 1
    out

export StartupComponentGraphRequest, StartupResolvedComponent, StartupComponentGraphPlan
export startup_component_graph_request, resolve_startup_component_graph
export startup_component_graph_render
