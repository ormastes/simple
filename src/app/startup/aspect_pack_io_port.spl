# Application-owned exact-route aspect-pack input port.
#
# The execution context derives every request from its validated AspectCatalog.
# Adapters may bind an application image root and signature store, but this
# contract accepts no search roots, fallback paths, or caller-selected files.
# The callback is a Result-only boundary and must not panic: lazy activation
# invokes it outside the single-flight lock, and every returned Err is shared
# with followers after the owner clears its reservation and wakes them.
# It also must not synchronously re-enter lazy acquisition on the same context;
# such a call is a follower of itself and therefore cannot make progress.

use compiler.loader.loader.aspect_pack_provider.{AspectPackProviderKey}

struct AspectPackIoRequest:
    aspect_id: text
    pack_path: text
    provider_key: AspectPackProviderKey

struct AspectPackIoPayload:
    pack_bytes: [u8]
    signature: [u8]

struct AspectPackIoPort:
    name: text
    load_exact_route_fn: fn(AspectPackIoRequest) -> Result<AspectPackIoPayload, text>

impl AspectPackIoPort:
    fn load_exact_route(request: AspectPackIoRequest) -> Result<AspectPackIoPayload, text>:
        self.load_exact_route_fn(request)

fn aspect_pack_io_unavailable_load(
    request: AspectPackIoRequest
) -> Result<AspectPackIoPayload, text>:
    Err("E-APACK008 no application aspect-pack I/O owner is installed for {request.aspect_id}")

fn aspect_pack_io_port_unavailable() -> AspectPackIoPort:
    AspectPackIoPort(
        name: "unavailable-aspect-pack-io",
        load_exact_route_fn: aspect_pack_io_unavailable_load)

fn aspect_pack_io_port_for_embedding(
    owner_id: text,
    load_exact_route_fn: fn(AspectPackIoRequest) -> Result<AspectPackIoPayload, text>
) -> Result<AspectPackIoPort, text>:
    """Bind the embedding application's exact-route pack/signature owner.

    The callback receives only the catalog-derived route. Path interpretation,
    deployed-image access, and detached-signature storage remain entirely with
    the embedding owner; this adapter adds no sidecar or search convention.
    """
    if owner_id == "":
        return Err("E-APACK008 embedding aspect-pack I/O owner identity is empty")
    Ok(AspectPackIoPort(
        name: owner_id,
        load_exact_route_fn: load_exact_route_fn))

export AspectPackIoRequest, AspectPackIoPayload, AspectPackIoPort
export aspect_pack_io_port_unavailable
export aspect_pack_io_port_for_embedding
