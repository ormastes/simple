use std.log.{error}
use app.startup.dynsmf_autoload.{dynsmf_startup_summary,
    dynsmf_startup_artifact_status_lines, product_dynload_startup,
    product_dynload_startup_metrics_line}

pub fn run_product_dynsmf_status(raw_args: [text], session_id: text) -> i64:
    val startup = product_dynload_startup(raw_args, session_id)
    val dynsmf_session = startup.session
    print dynsmf_startup_summary(dynsmf_session)
    var idx = 0
    val evidence_count = dynsmf_session.evidence.len()
    while idx < evidence_count:
        print dynsmf_session.evidence[idx].to_text()
        idx = idx + 1
    print "dynsmf artifact status:"
    val status_lines = dynsmf_startup_artifact_status_lines()
    var status_idx = 0
    val status_count = status_lines.len()
    while status_idx < status_count:
        print status_lines[status_idx]
        status_idx = status_idx + 1
    print product_dynload_startup_metrics_line(startup.metrics)
    val startup_exit = startup.exit_code
    val startup_error = startup.error
    val close_ok = startup.close()
    val final_exit = if close_ok: startup_exit else: 1
    if not close_ok:
        error("app-root", startup.error)
        return final_exit
    if final_exit != 0:
        error("app-root", startup_error)
    final_exit
