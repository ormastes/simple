# Reference capture boxes for lifecycle-mutex callbacks.
#
# Native mutex callbacks capture reference objects safely. Value aggregates and
# arrays cross that boundary only through these application-private boxes.

use compiler.loader.loader.aspect_pack_provider.{AspectPackProviderKey}
use compiler.loader.loader.aspect_activation.{AspectActivationRequest}
use os.smf.smf_generation.{GenerationToken}
use std.aop.facet.{FacetGenerationLease}
use app.startup.aspect_facet_runtime_contract.{PublishedFacetDescriptorLease}

class AspectGenerationTokenBox:
    value: GenerationToken

class AspectFacetGenerationLeaseBox:
    value: FacetGenerationLease

class AspectFacetQueryBox:
    concrete_type_id: text
    implemented_business_interfaces: [text]
    facet_interface_id: text

class AspectFacetMethodQueryBox:
    query: AspectFacetQueryBox
    method_name: text

class AspectFacetDescriptorBox:
    value: PublishedFacetDescriptorLease

class AspectFacetContractQueryBox:
    acquired: PublishedFacetDescriptorLease
    expected_facet_interface_id: text
    expected_abi_hash: text
    expected_method_names: [text]

class AspectActivationInputBox:
    provider_key: AspectPackProviderKey
    pack_bytes: [u8]
    signature: [u8]
    request: AspectActivationRequest

export AspectGenerationTokenBox, AspectFacetGenerationLeaseBox
export AspectFacetQueryBox, AspectFacetMethodQueryBox
export AspectFacetDescriptorBox, AspectFacetContractQueryBox
export AspectActivationInputBox
