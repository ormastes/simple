# Lifecycle mutex identity for one application execution context.
#
# Simple has no evidenced peer-only field visibility, so `mutex` is exported by
# representation but is owner-only by contract: AspectExecutionContext calls
# the canonical mutex helper directly. Keeping the application closure out of
# this module avoids the documented two-hop cross-module closure deadlock.

use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new}

class AspectLifecycleGate:
    mutex: Mutex

impl AspectLifecycleGate:
    static fn create() -> AspectLifecycleGate:
        AspectLifecycleGate(mutex: mutex_new(0))

export AspectLifecycleGate
