# Scoped lifecycle-state exclusion for one application execution context.
#
# This gate deliberately exposes no manual lock, unlock, guard, or ticket. The
# body must contain only callback-free canonical-state work. Application I/O
# and advice callbacks belong between separate scoped calls.

use std.nogc_sync_mut.concurrent.mutex.{
    Mutex, mutex_new, mutex_with_lock_keeping
}

class AspectLifecycleGate:
    mutex: Mutex

impl AspectLifecycleGate:
    static fn create() -> AspectLifecycleGate:
        AspectLifecycleGate(mutex: mutex_new(0))

    fn with_lock_keeping<T>(operation: text, body: fn() -> T) -> T:
        if operation == "":
            panic("E-APACK009 lifecycle operation identity is empty")
        mutex_with_lock_keeping(self.mutex, 0, body)

export AspectLifecycleGate
