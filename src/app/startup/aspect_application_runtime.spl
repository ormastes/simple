# Application-owned facade for catalogued aspect-pack activation.
#
# The application retains policy and cache state, while executable mapping,
# relocation, publication, and resource lifetime stay with their established
# loader/dynSMF owners.  This leaf performs no environment reads, filesystem
# access, process launch, pack decoding shortcut, or parallel lifecycle work.

use compiler.loader.loader.aspect_catalog.{AspectCatalog}
use compiler.loader.loader.aspect_pack_provider.{
    AspectPackProviderKey,
    AspectPackProvider,
    AspectPackTrustPolicy,
    AspectPackProviderCache
}
use compiler.loader.loader.aspect_activation.{
    AspectActivationRequest,
    AspectActivationCoordinator,
    AspectActivationResult
}
use compiler.loader.loader.module_loader.{
    ModuleLoader, moduleloader_with_defaults, moduleloader_unload
}
use compiler.loader.loader.facet_binding_registry.{
    FacetBindingRecord, facet_lookup, facet_unbind_generation,
    facet_witness_method_entry
}
use compiler.common.structural_contracts.facet_artifact.{
    FACET_WITNESS_DESCRIPTOR_VERSION, FacetWitnessMethodEntry
}
use compiler.loader.loader.advice_binding_registry.{
    AdviceBindingRecord, AdviceBindingCounters, AdviceDisabledPathFootprint,
    advice_lookup_slot, advice_unbind_generation,
    advice_disabled_path_footprint, advice_dispatch_projection_invalidate,
    advice_dispatch_projection as loader_advice_dispatch_projection
}
use os.smf.dynsmf_session.{DynSmfSession, dynsmf_id_disabled}
use os.smf.smf_generation.{GenerationToken, LifecycleManager}
use std.aop.facet.{FacetGenerationLease, FacetAcquireError}
use app.startup.aspect_pack_io_port.{
    AspectPackIoRequest, AspectPackIoPort, aspect_pack_io_port_unavailable
}
use app.startup.aspect_facet_runtime_contract.{
    AspectApplicationPhase, AspectApplicationOperation,
    PublishedFacetDescriptorLease,
    aspect_application_is_mission, aspect_application_is_operational,
    aspect_application_mission_catalog_valid,
    aspect_published_facet_descriptor_validate,
    aspect_facet_acquire_error_from_runtime_text,
    aspect_facet_acquire_error_required_absent,
    aspect_facet_acquire_error_activation_denied,
    aspect_application_provider_key, aspect_application_lazy_facet_route
}

# Stable application-owned reference capsule. The coordinator is the canonical
# aggregate owner of lifecycle and facet/advice publication state; the loader
# used to validate and invoke those publications lives beside it in this same
# reference identity.
class AspectExecutionContext:
    catalog: AspectCatalog
    trust_policy: AspectPackTrustPolicy
    provider_cache: AspectPackProviderCache
    coordinator: AspectActivationCoordinator
    loader: ModuleLoader
    pack_io: AspectPackIoPort
    next_lazy_request_id: i64
    phase: AspectApplicationPhase

# Compatibility facade: existing constructors, methods, and public fields keep
# the AspectApplicationRuntime spelling while sharing the stable context.
type AspectApplicationRuntime = AspectExecutionContext

fn aspect_application_startup_complete(runtime: AspectApplicationRuntime) -> Result<(), text>:
    for entry in runtime.catalog.entries:
        if entry.activation_policy == "startup":
            if not runtime.coordinator.published.has(entry.aspect_id) or
                runtime.coordinator.published[entry.aspect_id].state != "active":
                return Err("E-APACK008 mission operational transition requires active startup aspect: {entry.aspect_id}")
    Ok(())

impl AspectExecutionContext:
    static fn create(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        if aspect_application_is_mission(trust_policy):
            aspect_application_mission_catalog_valid(catalog)?
        val cache = AspectPackProviderCache.create(index_capacity, chunk_capacity, negative_capacity)?
        val coordinator = AspectActivationCoordinator.create(catalog, dynsmf_session, lifecycle)?
        Ok(AspectExecutionContext(
            catalog: catalog,
            trust_policy: trust_policy,
            provider_cache: cache,
            coordinator: coordinator,
            loader: moduleloader_with_defaults(),
            pack_io: aspect_pack_io_port_unavailable(),
            next_lazy_request_id: 1,
            phase: AspectApplicationPhase.Startup
        ))

    static fn create_with_loader(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        loader: ModuleLoader,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        val context = AspectExecutionContext.create(
            catalog, dynsmf_session, lifecycle, trust_policy,
            index_capacity, chunk_capacity, negative_capacity)?
        context.loader = loader
        Ok(context)

    static fn create_with_pack_io(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        pack_io: AspectPackIoPort,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        if pack_io.name == "":
            return Err("E-APACK008 aspect-pack I/O port identity is empty")
        val context = AspectExecutionContext.create(
            catalog, dynsmf_session, lifecycle, trust_policy,
            index_capacity, chunk_capacity, negative_capacity)?
        context.pack_io = pack_io
        Ok(context)

    static fn create_with_loader_and_pack_io(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        loader: ModuleLoader,
        pack_io: AspectPackIoPort,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        val context = AspectExecutionContext.create_with_pack_io(
            catalog, dynsmf_session, lifecycle, trust_policy, pack_io,
            index_capacity, chunk_capacity, negative_capacity)?
        context.loader = loader
        Ok(context)

    fn authorize(operation: AspectApplicationOperation) -> Result<(), text>:
        if not aspect_application_is_mission(self.trust_policy):
            return Ok(())
        match operation:
            case AspectApplicationOperation.LazyIo:
                if aspect_application_is_operational(self.phase):
                    return Err("E-APACK008 mission operational state denies lazy aspect-pack I/O")
            case AspectApplicationOperation.DynamicAttach:
                return Err("E-APACK008 mission profile denies dynamic aspect attachment")
            case AspectApplicationOperation.Unload:
                return Err("E-APACK008 mission profile denies aspect unload")
            case AspectApplicationOperation.Patch:
                return Err("E-APACK008 mission profile denies runtime advice patching")
        Ok(())

    # The application I/O owner opens exactly this deployed-image-relative
    # path. No search roots or fallback directories are exposed here.
    fn pack_path_for(aspect_id: text) -> Result<text, text>:
        val entry = self.catalog.find(aspect_id)?
        Ok(entry.pack_path)

    # The embedding application supplies bytes through its canonical I/O
    # facade.  Admission always executes the retained trust policy, including
    # ordinary unsigned mode; this API never calls the unsigned constructor.
    me fn activate_pack_bytes(
        provider_key: AspectPackProviderKey,
        pack_bytes: [u8],
        signature: [u8],
        request: AspectActivationRequest,
        loader: ModuleLoader
    ) -> AspectActivationResult:
        val entry_result = self.catalog.find(request.aspect_id)
        if entry_result.is_err():
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: entry_result.unwrap_err(),
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        if self.coordinator.published.has(request.aspect_id) and
            self.coordinator.published[request.aspect_id].state != "active":
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: "E-AF004 aspect generation is quiescing",
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        val authorization = self.authorize(AspectApplicationOperation.LazyIo)
        if authorization.is_err():
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: authorization.unwrap_err(),
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        val entry = entry_result.unwrap()
        if entry.advice_summaries.len() > 0:
            val patch_authorization = self.authorize(AspectApplicationOperation.Patch)
            if patch_authorization.is_err():
                return AspectActivationResult(
                    coordinator: self.coordinator,
                    status: "failed",
                    reason: patch_authorization.unwrap_err(),
                    generation: self.catalog.generation,
                    staged_count: 0,
                    counters: self.coordinator.counters)
        if aspect_application_is_mission(self.trust_policy) and entry.activation_policy != "startup":
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: "E-APACK008 mission profile permits activation only during startup",
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        if provider_key.pack_id != entry.pack_id or
            provider_key.pack_digest != entry.pack_digest or
            provider_key.catalog_generation != self.catalog.generation or
            provider_key.target != entry.target or
            provider_key.variant_fingerprint != entry.variant_fingerprint or
            provider_key.runtime_abi != entry.runtime_abi or
            provider_key.core_public_abi_hash != entry.core_public_abi_hash or
            provider_key.core_layout_abi_hash != entry.core_layout_abi_hash:
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: "E-APACK003 provider identity does not match the exact application catalog route",
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        val provider_result = AspectPackProvider.from_trusted_bytes(
            provider_key,
            pack_bytes,
            self.trust_policy,
            signature
        )
        if provider_result.is_err():
            return AspectActivationResult(
                coordinator: self.coordinator,
                status: "failed",
                reason: provider_result.unwrap_err(),
                generation: self.catalog.generation,
                staged_count: 0,
                counters: self.coordinator.counters
            )
        val provider = provider_result.unwrap()
        val activation = self.coordinator.activate_with_loader(
            provider, request, loader, self.provider_cache)
        self.coordinator = activation.coordinator
        self.loader = loader
        activation

    me fn cancel_lazy_activation_request(request_id: text):
        var in_flight = self.coordinator.in_flight
        for key in self.coordinator.in_flight.keys():
            if self.coordinator.in_flight[key] == request_id:
                in_flight = in_flight.remove(key)
        self.coordinator.in_flight = in_flight

    # Canonical lazy-facet path. Route identity comes only from AspectCatalog;
    # the injected application owner supplies bytes/signature for that exact
    # deployed-image-relative route. The coordinator reservation is claimed
    # before I/O so a serialized/reentrant follower performs no duplicate read.
    me fn acquire_or_activate_facet_descriptor(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text,
        facet_contract_abi_hash: text
    ) -> Result<PublishedFacetDescriptorLease?, FacetAcquireError>:
        val existing = self.acquire_published_facet_descriptor(
            concrete_type_id, implemented_business_interfaces,
            facet_interface_id)
        if existing.is_err():
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, existing.unwrap_err()))
        if existing.unwrap() != nil:
            return Ok(existing.unwrap())

        val route = aspect_application_lazy_facet_route(
            self.catalog, concrete_type_id, implemented_business_interfaces,
            facet_interface_id, facet_contract_abi_hash)
        if route.is_err():
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, route.unwrap_err()))
        if route.unwrap() == nil:
            return Ok(nil)
        val entry = route.unwrap().unwrap()

        val authorization = self.authorize(AspectApplicationOperation.LazyIo)
        if authorization.is_err():
            return Err(aspect_facet_acquire_error_activation_denied(
                facet_interface_id, authorization.unwrap_err()))
        if dynsmf_id_disabled(self.coordinator.dynsmf_session.policy, entry.aspect_id):
            return Err(aspect_facet_acquire_error_activation_denied(
                facet_interface_id,
                "E-APACK008 dynSMF policy disabled aspect activation"))

        val request_id = "lazy-facet:{self.catalog.generation}:{self.next_lazy_request_id}"
        self.next_lazy_request_id = self.next_lazy_request_id + 1
        val request = AspectActivationRequest(
            aspect_id: entry.aspect_id,
            request_id: request_id,
            catalog_generation: self.catalog.generation)
        val reservation = self.coordinator.reserve(request)
        if reservation.is_err():
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, reservation.unwrap_err()))
        self.coordinator = reservation.unwrap()
        var owns_reservation = false
        for key in self.coordinator.in_flight.keys():
            if self.coordinator.in_flight[key] == request_id:
                owns_reservation = true
        if not owns_reservation:
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id,
                "E-APACK009 lazy facet activation is already in flight; retry after owner completion"))

        val provider_key = aspect_application_provider_key(
            entry, self.catalog.generation)
        val payload = self.pack_io.load_exact_route(AspectPackIoRequest(
            aspect_id: entry.aspect_id,
            pack_path: entry.pack_path,
            provider_key: provider_key))
        if payload.is_err():
            self.cancel_lazy_activation_request(request_id)
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, payload.unwrap_err()))

        val loaded = payload.unwrap()
        val activation = self.activate_pack_bytes(
            provider_key, loaded.pack_bytes, loaded.signature,
            request, self.loader)
        if activation.status != "published" and activation.status != "coalesced_active":
            self.cancel_lazy_activation_request(request_id)
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, activation.reason))

        val acquired = self.acquire_published_facet_descriptor(
            concrete_type_id, implemented_business_interfaces,
            facet_interface_id)
        if acquired.is_err():
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id, acquired.unwrap_err()))
        if acquired.unwrap() == nil:
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id,
                "E-AF002 activated aspect did not publish the requested facet binding"))
        Ok(acquired.unwrap())

    # Mission publication is explicit and irreversible for this process
    # state.  Every startup aspect must already be atomically published.
    me fn enter_operational() -> Result<(), text>:
        if aspect_application_is_operational(self.phase):
            return Ok(())
        if aspect_application_is_mission(self.trust_policy):
            aspect_application_startup_complete(self)?
        self.phase = AspectApplicationPhase.Operational
        Ok(())

    # FacetRef integration pins the exact published generation before it
    # dereferences a witness. The opaque token rejects replay and forgery.
    me fn acquire_published_generation(aspect_id: text) -> Result<GenerationToken, text>:
        if not self.coordinator.published.has(aspect_id):
            return Err("E-AF004 aspect has no published generation: {aspect_id}")
        if self.coordinator.published[aspect_id].state != "active":
            return Err("E-AF004 aspect generation is quiescing: {aspect_id}")
        val activation = self.coordinator.published[aspect_id]
        val generation = activation.generation
        val acquired = self.coordinator.lifecycle.acquire_generation_token_for(
            activation.activation_key, generation)?
        self.coordinator.lifecycle = acquired.0
        Ok(acquired.1)

    # Release accepts only a generation represented by this application's
    # publication table, preventing arbitrary lifecycle-owner manipulation.
    me fn release_published_generation(token: GenerationToken) -> Result<(), text>:
        var published = false
        for aspect_id in self.coordinator.published.keys():
            val activation = self.coordinator.published[aspect_id]
            if activation.activation_key == token.owner_key and activation.generation == token.generation_id:
                published = true
        if not published:
            return Err("E-AF004 generation is not published by this application: {token.generation_id}")
        val lifecycle = self.coordinator.lifecycle.release_generation_token(token)?
        self.coordinator.lifecycle = lifecycle
        Ok(())

    fn published_generation_pin_count(aspect_id: text) -> Result<i64, text>:
        if not self.coordinator.published.has(aspect_id):
            return Err("E-AF004 aspect has no published generation: {aspect_id}")
        val activation = self.coordinator.published[aspect_id]
        Ok(self.coordinator.lifecycle.generation_pin_count_for(
            activation.activation_key, activation.generation) as i64)

    # Lookup is pure registry access. The returned record identifies the exact
    # aspect whose canonical lifecycle lease must be acquired before invoking
    # its witness symbol.
    fn lookup_published_facet(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<FacetBindingRecord?, text>:
        facet_lookup(
            self.coordinator.facet_bindings,
            concrete_type_id,
            implemented_business_interfaces,
            facet_interface_id)

    # Prepared join-point dispatch seam. This performs no pointcut matching;
    # it returns the preordered visible chain and records exact harness
    # counters for both enabled and disabled slots.
    me fn lookup_published_advice(slot_id: text) -> Result<[AdviceBindingRecord], text>:
        val lookup = advice_lookup_slot(self.coordinator.advice_bindings, slot_id)?
        self.coordinator.advice_bindings = lookup.registry
        Ok(lookup.chain)

    fn advice_binding_counters() -> AdviceBindingCounters:
        self.coordinator.advice_bindings.counters

    fn advice_disabled_footprint() -> AdviceDisabledPathFootprint:
        advice_disabled_path_footprint()

    # Synchronous prepared-slot execution boundary. The loader-owned projection
    # pins every exact generation until its phase callback completes, so unload
    # may remove visibility but cannot reclaim an in-flight witness.
    me fn advice_dispatch_slot(
        loader: ModuleLoader,
        slot_id: text,
        form: text
    ) -> Result<[i64], text>:
        self.loader = loader
        self.invoke_prepared_advice(slot_id, form)

    # Intrinsic-facing operation. It can reach dispatch state only through this
    # reference capsule and always writes the returned canonical lifecycle and
    # registry values back before exposing success or failure.
    me fn invoke_prepared_advice(slot_id: text, form: text) -> Result<[i64], text>:
        val outcome = loader_advice_dispatch_projection(
            self.coordinator.advice_projection,
            self.coordinator.advice_bindings,
            self.coordinator.lifecycle,
            self.loader, slot_id, form)
        self.coordinator.advice_bindings = outcome.registry
        self.coordinator.lifecycle = outcome.lifecycle
        if outcome.status != "dispatched":
            return Err(outcome.reason)
        Ok(outcome.return_values)

    # First-use boundary: resolve the visible witness and pin that record's
    # exact published generation as one application-runtime operation.
    me fn acquire_published_facet(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<(FacetBindingRecord, FacetGenerationLease)?, text>:
        val binding = self.lookup_published_facet(
            concrete_type_id, implemented_business_interfaces,
            facet_interface_id)?
        if binding == nil:
            return Ok(nil)
        val record = binding.unwrap()
        val lease = self.acquire_facet_generation_lease(record.aspect_id)?
        Ok(Some((record, lease)))

    # Acquires the generation lease and the exact resolved ordinary-SMF method
    # entry as one operation suitable for MIR CallIndirect lowering.
    me fn acquire_published_facet_method(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text,
        method_name: text
    ) -> Result<(FacetWitnessMethodEntry, FacetGenerationLease)?, text>:
        val acquired = self.acquire_published_facet(
            concrete_type_id, implemented_business_interfaces,
            facet_interface_id)?
        if acquired == nil:
            return Ok(nil)
        val pair = acquired.unwrap()
        val method = facet_witness_method_entry(pair.0, method_name)
        if method.is_err():
            self.release_facet_generation_lease(pair.1)?
            return Err(method.unwrap_err())
        Ok(Some((method.unwrap(), pair.1)))

    # Compiler-facing whole-descriptor acquisition. Method selection remains a
    # compile-time ordinal operation over this descriptor; this boundary never
    # accepts or constructs an erased/caller-provided facet view.
    me fn acquire_published_facet_descriptor(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<PublishedFacetDescriptorLease?, text>:
        val acquired = self.acquire_published_facet(
            concrete_type_id, implemented_business_interfaces,
            facet_interface_id)?
        if acquired == nil:
            return Ok(nil)
        val pair = acquired.unwrap()
        val record = pair.0
        val descriptor = record.witness_descriptor
        val validation = aspect_published_facet_descriptor_validate(record)
        if validation.is_err():
            self.release_facet_generation_lease(pair.1)?
            return Err(validation.unwrap_err())
        Ok(Some(PublishedFacetDescriptorLease(
            aspect_id: record.aspect_id,
            binding_id: record.binding_id,
            facet_interface_id: record.facet_interface_id,
            facet_contract_abi_hash: record.facet_contract_abi_hash,
            witness_descriptor: descriptor,
            generation_lease: pair.1)))

    me fn release_published_facet_descriptor(
        acquired: PublishedFacetDescriptorLease
    ) -> Result<(), text>:
        if acquired.aspect_id != acquired.generation_lease.aspect_id:
            # The compiler-generated wrapper is private, but a corrupted
            # handle still must not strand its canonical generation token.
            self.release_facet_generation_lease(acquired.generation_lease)?
            return Err("E-AF004 facet descriptor lease aspect identity is inconsistent")
        self.release_facet_generation_lease(acquired.generation_lease)

    fn published_facet_descriptor_handle_validate(
        acquired: PublishedFacetDescriptorLease
    ) -> Result<(), text>:
        if acquired.aspect_id != acquired.generation_lease.aspect_id:
            return Err("E-AF004 facet descriptor lease aspect identity is inconsistent")
        if not self.coordinator.published.has(acquired.aspect_id):
            return Err("E-AF004 facet descriptor generation is no longer published")
        val activation = self.coordinator.published[acquired.aspect_id]
        if activation.generation != acquired.generation_lease.generation_id:
            return Err("E-AF004 facet descriptor generation identity is inconsistent")
        if not activation.owners.contains(acquired.witness_descriptor.owner_id):
            return Err("E-AF002 facet descriptor owner is not retained by its generation")
        Ok(())

    # The descriptor lease is an opaque reference at the compiler ABI. This
    # operation performs whole-contract validation before the compiler creates
    # its private typed-base adapter; generated code never decodes descriptor
    # arrays or relies on their aggregate layout.
    fn validate_published_facet_descriptor_contract(
        acquired: PublishedFacetDescriptorLease,
        expected_facet_interface_id: text,
        expected_abi_hash: text,
        expected_method_names: [text]
    ) -> Result<(), text>:
        self.published_facet_descriptor_handle_validate(acquired)?
        if expected_facet_interface_id == "" or expected_abi_hash == "":
            return Err("E-AF002 facet contract identity is incomplete")
        if acquired.facet_interface_id != expected_facet_interface_id:
            return Err("E-AF002 facet descriptor interface does not match the contract")
        if (acquired.facet_contract_abi_hash != expected_abi_hash or
            acquired.witness_descriptor.facet_contract_abi_hash != expected_abi_hash):
            return Err("E-AF002 facet descriptor ABI hash does not match the contract")
        if acquired.witness_descriptor.descriptor_version != FACET_WITNESS_DESCRIPTOR_VERSION:
            return Err("E-AF002 facet descriptor version is unsupported")
        if acquired.witness_descriptor.method_entries.len() != expected_method_names.len():
            return Err("E-AF002 facet descriptor method count does not match the contract")
        var ordinal = 0
        while ordinal < expected_method_names.len():
            val expected_name = expected_method_names[ordinal]
            val method = acquired.witness_descriptor.method_entries[ordinal]
            if expected_name == "" or method.method_name != expected_name:
                return Err("E-AF002 facet descriptor method order/name does not match the contract")
            if method.method_symbol == "" or method.resolved_address <= 0:
                return Err("E-AF002 facet descriptor contains an unresolved method: {expected_name}")
            ordinal = ordinal + 1
        Ok(())

    # Runtime-owned ordinal lookup keeps descriptor layout and array decoding
    # out of compiler-generated code. The retained handle remains usable while
    # its exact generation is quiescing, until the compiler releases the lease.
    fn published_facet_descriptor_method_address(
        acquired: PublishedFacetDescriptorLease,
        ordinal: i64,
        expected_name: text
    ) -> Result<i64, text>:
        self.published_facet_descriptor_handle_validate(acquired)?
        if expected_name == "":
            return Err("E-AF005 facet contract method name is empty")
        if ordinal < 0 or ordinal >= acquired.witness_descriptor.method_entries.len():
            return Err("E-AF005 facet contract method ordinal is out of bounds: {ordinal}")
        val method = acquired.witness_descriptor.method_entries[ordinal]
        if method.method_name != expected_name:
            return Err("E-AF002 facet descriptor method order/name does not match the contract")
        if method.method_symbol == "" or method.resolved_address <= 0:
            return Err("E-AF002 facet descriptor contains an unresolved method: {expected_name}")
        Ok(method.resolved_address)

    # Ownership-neutral std.aop lease adapter. The lease carries no app/os
    # object; this boundary reconstructs the canonical lifecycle token.
    me fn acquire_facet_generation_lease(aspect_id: text) -> Result<FacetGenerationLease, text>:
        val token = self.acquire_published_generation(aspect_id)?
        Ok(FacetGenerationLease(
            aspect_id: aspect_id,
            generation_id: token.generation_id,
            token_id: token.token_id
        ))

    me fn release_facet_generation_lease(lease: FacetGenerationLease) -> Result<(), text>:
        if not self.coordinator.published.has(lease.aspect_id):
            return Err("E-AF004 facet lease aspect is not published: {lease.aspect_id}")
        val activation = self.coordinator.published[lease.aspect_id]
        if activation.generation != lease.generation_id:
            return Err("E-AF004 facet lease generation does not match publication")
        self.release_published_generation(GenerationToken(
            owner_key: activation.activation_key,
            generation_id: lease.generation_id,
            token_id: lease.token_id
        ))

    # Ordinary-profile unload is a retryable two-step operation. The first
    # call quiesces acquisition and removes visible bindings. If tokens remain,
    # callers release them and retry; no wait loop or forced lease release is
    # hidden here.
    me fn unload_published_aspect(aspect_id: text, loader: ModuleLoader) -> Result<text, text>:
        self.loader = loader
        self.authorize(AspectApplicationOperation.Unload)?
        if not self.coordinator.published.has(aspect_id):
            return Err("E-AF004 aspect has no published generation: {aspect_id}")
        var activation = self.coordinator.published[aspect_id]
        val generation = activation.generation
        # Compute the complete retirement transition before mutating the
        # runtime. A quiesce error therefore preserves the active publication;
        # successful installation removes visibility together with closing
        # acquisition, before the first drain check.
        val facet_bindings = facet_unbind_generation(
            self.coordinator.facet_bindings,
            activation.activation_key,
            generation)
        val advice_bindings = advice_unbind_generation(
            self.coordinator.advice_bindings,
            activation.activation_key,
            generation)
        val advice_projection = advice_dispatch_projection_invalidate(
            self.coordinator.advice_projection,
            activation.activation_key,
            generation)
        val quiesced = self.coordinator.lifecycle.quiesce_generation_for(
            activation.activation_key, generation)?
        activation.bindings = []
        activation.advices = []
        activation.state = "quiescing"
        self.coordinator.facet_bindings = facet_bindings
        self.coordinator.advice_bindings = advice_bindings
        self.coordinator.advice_projection = advice_projection
        self.coordinator.lifecycle = quiesced
        self.coordinator.published[aspect_id] = activation
        if not self.coordinator.lifecycle.generation_is_drained_for(
            activation.activation_key, generation):
            return Ok("quiescing")

        # Validate every cache pin before changing executable state so the
        # cleanup sequence cannot discover a missing resource halfway through.
        for module_key in activation.module_keys:
            if self.provider_cache.module_ref_count(
                module_key, self.loader.lifecycle.smf_cache_mgr) <= 0:
                return Err("E-APACK003 published aspect module has no cache pin: {module_key.module_id}")

        for owner_id in activation.owners:
            moduleloader_unload(self.loader, owner_id)
        for module_key in activation.module_keys:
            self.provider_cache.release_module(
                module_key, self.loader.lifecycle.smf_cache_mgr)?
        for module_key in activation.module_keys:
            _ = self.provider_cache.invalidate_provider(
                module_key.provider, self.loader.lifecycle.smf_cache_mgr)

        val completed = self.coordinator.lifecycle.complete_generation_unload_for(
            activation.activation_key, generation)?
        self.coordinator.lifecycle = completed
        self.coordinator.published = self.coordinator.published.remove(aspect_id)
        Ok("unloaded")

# Canonical prepared-advice ABI owner. Backend bridges must pass this typed
# context reference explicitly; no global/current-context lookup exists.
fn prepared_advice_dispatch_context_invoke(
    context: AspectExecutionContext,
    slot_id: text,
    form: text
) -> Result<[i64], text>:
    context.invoke_prepared_advice(slot_id, form)

# Fail-stop ABI for compiler-injected prepared advice. The Result-returning
# operation synchronously writes the released-token lifecycle state before an
# error reaches this wrapper, so panic cannot strand an acquired generation.
fn prepared_advice_dispatch_context_invoke_or_panic(
    context: AspectExecutionContext,
    slot_id: text,
    form: text
) -> ():
    val dispatched = prepared_advice_dispatch_context_invoke(
        context, slot_id, form)
    if dispatched.is_err():
        panic(dispatched.unwrap_err())

fn aspect_execution_context_acquire_facet_descriptor(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text
) -> Result<PublishedFacetDescriptorLease?, text>:
    context.acquire_published_facet_descriptor(
        concrete_type_id, implemented_business_interfaces,
        facet_interface_id)

fn aspect_execution_context_acquire_or_activate_facet_descriptor(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text,
    facet_contract_abi_hash: text
) -> Result<PublishedFacetDescriptorLease?, FacetAcquireError>:
    context.acquire_or_activate_facet_descriptor(
        concrete_type_id, implemented_business_interfaces,
        facet_interface_id, facet_contract_abi_hash)

fn aspect_execution_context_release_facet_descriptor(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease
) -> Result<(), text>:
    context.release_published_facet_descriptor(acquired)

fn aspect_execution_context_facet_method_address(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease,
    ordinal: i64,
    expected_name: text
) -> Result<i64, text>:
    context.published_facet_descriptor_method_address(
        acquired, ordinal, expected_name)

fn aspect_execution_context_validate_facet_descriptor_contract(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease,
    expected_facet_interface_id: text,
    expected_abi_hash: text,
    expected_method_names: [text]
) -> Result<(), text>:
    context.validate_published_facet_descriptor_contract(
        acquired, expected_facet_interface_id, expected_abi_hash,
        expected_method_names)

# Unit-returning cleanup ABI for compiler-generated typed facet adapters.
# Cleanup may be inserted into a function with any declared return type, so a
# release error cannot be returned through the enclosing function. Fail stop
# instead of silently discarding an invalid, forged, or replayed lease.
fn aspect_execution_context_release_facet_descriptor_or_panic(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease
) -> ():
    val released = aspect_execution_context_release_facet_descriptor(
        context, acquired)
    if released.is_err():
        panic(released.unwrap_err())

