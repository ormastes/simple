# Application-owned facade for catalogued aspect-pack activation.
#
# The application retains policy and cache state, while executable mapping,
# relocation, publication, and resource lifetime stay with their established
# loader/dynSMF owners.  This leaf performs no environment reads, filesystem
# access, process launch, pack decoding shortcut, or parallel lifecycle work.

use compiler.loader.loader.aspect_catalog.{AspectCatalog}
use compiler.loader.loader.aspect_pack_provider.{
    AspectPackProviderKey,
    AspectPackTrustPolicy,
    AspectPackProviderCache
}
use compiler.loader.loader.aspect_activation.{
    AspectActivationRequest,
    AspectActivationCoordinator,
    AspectActivationResult
}
use compiler.loader.loader.module_loader.{
    ModuleLoader, moduleloader_with_defaults
}
use compiler.loader.loader.facet_binding_registry.{
    FacetBindingRecord
}
use compiler.common.structural_contracts.facet_artifact.{
    FacetWitnessMethodEntry
}
use compiler.loader.loader.advice_binding_registry.{
    AdviceBindingRecord, AdviceBindingCounters, AdviceDisabledPathFootprint,
    advice_disabled_path_footprint, advice_dispatch_permit_invoke_native
}
use os.smf.dynsmf_session.{DynSmfSession, dynsmf_id_disabled}
use os.smf.smf_generation.{GenerationToken, LifecycleManager}
use std.aop.facet.{FacetGenerationLease, FacetAcquireError}
use std.nogc_sync_mut.concurrent.mutex.{mutex_with_lock_keeping}
use app.startup.aspect_pack_io_port.{
    AspectPackIoPayload, AspectPackIoPort,
    aspect_pack_io_port_unavailable
}
use app.startup.aspect_lazy_singleflight.{
    AspectLazyFlightRole, AspectLazySingleFlight
}
use app.startup.aspect_lifecycle_gate.{AspectLifecycleGate}
use app.startup.aspect_advice_dispatch_ledger.{
    AspectAdviceDispatchLedger, AspectPreparedAdviceInvocation
}
use app.startup.aspect_lifecycle_capture_contract.{
    AspectGenerationTokenBox, AspectFacetGenerationLeaseBox,
    AspectFacetQueryBox, AspectFacetMethodQueryBox,
    AspectFacetDescriptorBox, AspectFacetContractQueryBox,
    AspectActivationInputBox
}
use app.startup.aspect_pack_activation_transition.{
    aspect_pack_activation_transition
}
use app.startup.aspect_lazy_activation_transition.{
    AspectLazyActivationCapsule, AspectLazyPreflightOutcome,
    AspectLazyCommitBox, aspect_lazy_complete_failure,
    aspect_lazy_flight_identity, aspect_lazy_cancel_reservation,
    aspect_lazy_reservation_prepare, aspect_lazy_commit_validate
}
use app.startup.aspect_prepared_advice_transition.{
    AspectPreparedAdviceState, AspectPreparedAdviceTransitionInvocation,
    aspect_prepared_advice_prepare,
    aspect_prepared_advice_finish
}
use app.startup.aspect_facet_lifecycle_transition.{
    aspect_generation_acquire, aspect_generation_release,
    aspect_generation_pin_count, aspect_published_facet_lookup,
    aspect_published_advice_lookup, aspect_facet_lease_acquire,
    aspect_facet_lease_release, aspect_published_facet_acquire,
    aspect_published_facet_method_acquire,
    aspect_published_facet_descriptor_acquire,
    aspect_published_facet_descriptor_release,
    aspect_published_facet_handle_validate,
    aspect_published_facet_contract_validate,
    aspect_published_facet_method_address
}
use app.startup.aspect_unload_transition.{aspect_unload_transition}
use app.startup.aspect_facet_runtime_contract.{
    AspectApplicationPhase, AspectApplicationOperation,
    PublishedFacetDescriptorLease,
    aspect_application_is_mission, aspect_application_is_operational,
    aspect_application_mission_catalog_valid,
    aspect_facet_acquire_error_from_runtime_text,
    aspect_facet_acquire_error_required_absent,
    aspect_application_lazy_facet_route
}

# Stable application-owned reference capsule. The coordinator is the canonical
# aggregate owner of lifecycle and facet/advice publication state; the loader
# used to validate and invoke those publications lives beside it in this same
# reference identity.
class AspectExecutionContext:
    catalog: AspectCatalog
    trust_policy: AspectPackTrustPolicy
    provider_cache: AspectPackProviderCache
    coordinator: AspectActivationCoordinator
    loader: ModuleLoader
    pack_io: AspectPackIoPort
    lazy_singleflight: AspectLazySingleFlight
    lifecycle_gate: AspectLifecycleGate
    advice_dispatch_ledger: AspectAdviceDispatchLedger
    phase: AspectApplicationPhase

# Compatibility facade: existing constructors, methods, and public fields keep
# the AspectApplicationRuntime spelling while sharing the stable context.
type AspectApplicationRuntime = AspectExecutionContext

fn aspect_application_startup_complete(runtime: AspectApplicationRuntime) -> Result<(), text>:
    for entry in runtime.catalog.entries:
        if entry.activation_policy == "startup":
            if not runtime.coordinator.published.has(entry.aspect_id) or
                runtime.coordinator.published[entry.aspect_id].state != "active":
                return Err("E-APACK008 mission operational transition requires active startup aspect: {entry.aspect_id}")
    Ok(())

impl AspectExecutionContext:
    static fn create(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        if aspect_application_is_mission(trust_policy):
            aspect_application_mission_catalog_valid(catalog)?
        val cache = AspectPackProviderCache.create(index_capacity, chunk_capacity, negative_capacity)?
        val coordinator = AspectActivationCoordinator.create(catalog, dynsmf_session, lifecycle)?
        Ok(AspectExecutionContext(
            catalog: catalog,
            trust_policy: trust_policy,
            provider_cache: cache,
            coordinator: coordinator,
            loader: moduleloader_with_defaults(),
            pack_io: aspect_pack_io_port_unavailable(),
            lazy_singleflight: AspectLazySingleFlight.create(),
            lifecycle_gate: AspectLifecycleGate.create(),
            advice_dispatch_ledger: AspectAdviceDispatchLedger.create(),
            phase: AspectApplicationPhase.Startup
        ))

    static fn create_with_loader(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        loader: ModuleLoader,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        val context = AspectExecutionContext.create(
            catalog, dynsmf_session, lifecycle, trust_policy,
            index_capacity, chunk_capacity, negative_capacity)?
        context.loader = loader
        Ok(context)

    static fn create_with_pack_io(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        pack_io: AspectPackIoPort,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        if pack_io.name == "":
            return Err("E-APACK008 aspect-pack I/O port identity is empty")
        val context = AspectExecutionContext.create(
            catalog, dynsmf_session, lifecycle, trust_policy,
            index_capacity, chunk_capacity, negative_capacity)?
        context.pack_io = pack_io
        Ok(context)

    static fn create_with_loader_and_pack_io(
        catalog: AspectCatalog,
        dynsmf_session: DynSmfSession,
        lifecycle: LifecycleManager,
        trust_policy: AspectPackTrustPolicy,
        loader: ModuleLoader,
        pack_io: AspectPackIoPort,
        index_capacity: i64,
        chunk_capacity: i64,
        negative_capacity: i64
    ) -> Result<AspectExecutionContext, text>:
        val context = AspectExecutionContext.create_with_pack_io(
            catalog, dynsmf_session, lifecycle, trust_policy, pack_io,
            index_capacity, chunk_capacity, negative_capacity)?
        context.loader = loader
        Ok(context)

    fn authorize(operation: AspectApplicationOperation) -> Result<(), text>:
        if not aspect_application_is_mission(self.trust_policy):
            return Ok(())
        match operation:
            case AspectApplicationOperation.LazyIo:
                if aspect_application_is_operational(self.phase):
                    return Err("E-APACK008 mission operational state denies lazy aspect-pack I/O")
            case AspectApplicationOperation.DynamicAttach:
                return Err("E-APACK008 mission profile denies dynamic aspect attachment")
            case AspectApplicationOperation.Unload:
                return Err("E-APACK008 mission profile denies aspect unload")
            case AspectApplicationOperation.Patch:
                return Err("E-APACK008 mission profile denies runtime advice patching")
        Ok(())

    # The application I/O owner opens exactly this deployed-image-relative
    # path. No search roots or fallback directories are exposed here.
    fn pack_path_for(aspect_id: text) -> Result<text, text>:
        val entry = self.catalog.find(aspect_id)?
        Ok(entry.pack_path)

    # The embedding application supplies bytes through its canonical I/O
    # facade.  Admission always executes the retained trust policy, including
    # ordinary unsigned mode; this API never calls the unsigned constructor.
    me fn activate_pack_bytes(
        provider_key: AspectPackProviderKey,
        pack_bytes: [u8],
        signature: [u8],
        request: AspectActivationRequest,
        loader: ModuleLoader
    ) -> AspectActivationResult:
        # Compatibility loader snapshot only; the context retains the one
        # canonical mapping/lifecycle owner for every gated activation.
        _ = loader
        val boxed = AspectActivationInputBox(
            provider_key: provider_key,
            pack_bytes: pack_bytes,
            signature: signature,
            request: request)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_activate_pack_bytes_locked(
                    self, boxed.provider_key, boxed.pack_bytes,
                    boxed.signature, boxed.request))

fn aspect_execution_context_activate_pack_bytes_locked(
    context: AspectExecutionContext,
    provider_key: AspectPackProviderKey,
    pack_bytes: [u8],
    signature: [u8],
    request: AspectActivationRequest
) -> AspectActivationResult:
    val activation = aspect_pack_activation_transition(
        context.catalog, context.trust_policy, context.phase,
        context.coordinator, context.loader, context.provider_cache,
        provider_key, pack_bytes, signature, request)
    context.coordinator = activation.coordinator
    activation

impl AspectExecutionContext:

    # The application single-flight currently serializes all lazy routes. An
    # exact-route follower shares completion; a different route waits and then
    # retries. The I/O callback must not synchronously re-enter this same
    # context/route because it would become a follower of itself.
    me fn acquire_or_activate_facet_descriptor(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text,
        facet_contract_abi_hash: text
    ) -> Result<PublishedFacetDescriptorLease?, FacetAcquireError>:
        val query = AspectFacetQueryBox(
            concrete_type_id: concrete_type_id,
            implemented_business_interfaces: implemented_business_interfaces,
            facet_interface_id: facet_interface_id)
        while true:
            val identity = mutex_with_lock_keeping(
                self.lifecycle_gate.mutex, 0, \:
                    aspect_lazy_flight_identity(
                        self.catalog.generation, query,
                        facet_contract_abi_hash))
            val ticket_result = self.lazy_singleflight.begin(
                identity.route_key, identity.request_prefix)
            if ticket_result.is_err():
                return Err(aspect_facet_acquire_error_from_runtime_text(
                    facet_interface_id, ticket_result.unwrap_err()))
            val ticket = ticket_result.unwrap()
            if ticket.role != AspectLazyFlightRole.Owner:
                val completion = self.lazy_singleflight.wait(ticket)
                if completion.is_err():
                    return Err(aspect_facet_acquire_error_from_runtime_text(
                        facet_interface_id, completion.unwrap_err()))
                if val shared_error = completion.unwrap().error:
                    return Err(shared_error)
                continue

            val request_id = ticket.flight.request_id
            val preflight = mutex_with_lock_keeping(
                self.lifecycle_gate.mutex, 0, \:
                    aspect_execution_context_lazy_preflight_locked(
                        self, query, facet_contract_abi_hash,
                        request_id))
            if preflight.is_err():
                val failure = preflight.unwrap_err()
                return Err(aspect_lazy_complete_failure(
                    self.lazy_singleflight, ticket, failure))
            val prepared = preflight.unwrap()
            if prepared.kind == "existing":
                val acquired = prepared.existing.unwrap()
                val completed = self.lazy_singleflight.complete_success(ticket)
                if completed.is_err():
                    return self.lazy_completion_release_failure(
                        acquired, facet_interface_id, completed.unwrap_err())
                return Ok(Some(acquired))
            if prepared.kind == "absent":
                val completed = self.lazy_singleflight.complete_success(ticket)
                if completed.is_err():
                    return Err(aspect_facet_acquire_error_from_runtime_text(
                        facet_interface_id, completed.unwrap_err()))
                return Ok(nil)

            val capsule = prepared.capsule.unwrap()
            val payload = capsule.pack_io.load_exact_route(capsule.io_request)
            if payload.is_err():
                mutex_with_lock_keeping(
                    self.lifecycle_gate.mutex, 0, \:
                        self.coordinator = aspect_lazy_cancel_reservation(
                            self.coordinator, capsule.activation_key,
                            capsule.request))
                val failure = aspect_facet_acquire_error_from_runtime_text(
                    facet_interface_id, payload.unwrap_err())
                return Err(aspect_lazy_complete_failure(
                    self.lazy_singleflight, ticket, failure))

            val commit = AspectLazyCommitBox(
                capsule: capsule, payload: payload.unwrap())
            val acquired = mutex_with_lock_keeping(
                self.lifecycle_gate.mutex, 0, \:
                    aspect_execution_context_lazy_commit_and_acquire_locked(
                        self, commit.capsule, commit.payload))
            if acquired.is_err():
                val failure = acquired.unwrap_err()
                return Err(aspect_lazy_complete_failure(
                    self.lazy_singleflight, ticket, failure))
            val lease = acquired.unwrap()
            val completed = self.lazy_singleflight.complete_success(ticket)
            if completed.is_err():
                return self.lazy_completion_release_failure(
                    lease, facet_interface_id, completed.unwrap_err())
            return Ok(Some(lease))

    me fn lazy_completion_release_failure(
        acquired: PublishedFacetDescriptorLease,
        facet_interface_id: text,
        completion_error: text
    ) -> Result<PublishedFacetDescriptorLease?, FacetAcquireError>:
        val released = self.release_published_facet_descriptor(acquired)
        if released.is_err():
            return Err(aspect_facet_acquire_error_from_runtime_text(
                facet_interface_id,
                "{completion_error}; {released.unwrap_err()}"))
        Err(aspect_facet_acquire_error_from_runtime_text(
            facet_interface_id, completion_error))

fn aspect_execution_context_lazy_preflight_locked(
    context: AspectExecutionContext,
    query: AspectFacetQueryBox,
    facet_contract_abi_hash: text,
    request_id: text
) -> Result<AspectLazyPreflightOutcome, FacetAcquireError>:
    val existing = aspect_execution_context_acquire_published_facet_descriptor_locked(
        context, query.concrete_type_id,
        query.implemented_business_interfaces, query.facet_interface_id)
    if existing.is_err():
        return Err(aspect_facet_acquire_error_from_runtime_text(
            query.facet_interface_id, existing.unwrap_err()))
    if existing.unwrap() != nil:
        return Ok(AspectLazyPreflightOutcome(
            kind: "existing", coordinator: context.coordinator, existing: existing.unwrap(), capsule: nil))
    val route = aspect_application_lazy_facet_route(
        context.catalog, query.concrete_type_id,
        query.implemented_business_interfaces, query.facet_interface_id,
        facet_contract_abi_hash)
    var activation_disabled = false
    if route.is_ok() and route.unwrap() != nil:
        activation_disabled = dynsmf_id_disabled(
            context.coordinator.dynsmf_session.policy,
            route.unwrap().unwrap().aspect_id)
    val prepared = aspect_lazy_reservation_prepare(
        context.catalog, context.coordinator, query,
        facet_contract_abi_hash, request_id, context.pack_io,
        context.authorize(AspectApplicationOperation.LazyIo),
        activation_disabled)?
    context.coordinator = prepared.coordinator
    Ok(prepared)

fn aspect_execution_context_lazy_commit_and_acquire_locked(
    context: AspectExecutionContext,
    capsule: AspectLazyActivationCapsule,
    payload: AspectPackIoPayload
) -> Result<PublishedFacetDescriptorLease, FacetAcquireError>:
    val validation = aspect_lazy_commit_validate(
        context.catalog, context.coordinator, capsule,
        context.authorize(AspectApplicationOperation.LazyIo),
        dynsmf_id_disabled(
            context.coordinator.dynsmf_session.policy,
            capsule.request.aspect_id))
    context.coordinator = validation.coordinator
    if not validation.accepted:
        return Err(validation.error.unwrap())
    val activation = aspect_execution_context_activate_pack_bytes_locked(
        context, capsule.provider_key, payload.pack_bytes,
        payload.signature, capsule.request)
    if activation.status != "published" and activation.status != "coalesced_active":
        context.coordinator = aspect_lazy_cancel_reservation(
            context.coordinator, capsule.activation_key, capsule.request)
        return Err(aspect_facet_acquire_error_from_runtime_text(
            capsule.query.facet_interface_id, activation.reason))
    val acquired = aspect_execution_context_acquire_published_facet_descriptor_locked(
        context, capsule.query.concrete_type_id,
        capsule.query.implemented_business_interfaces,
        capsule.query.facet_interface_id)
    if acquired.is_err():
        return Err(aspect_facet_acquire_error_from_runtime_text(
            capsule.query.facet_interface_id, acquired.unwrap_err()))
    if acquired.unwrap() == nil:
        return Err(aspect_facet_acquire_error_from_runtime_text(
            capsule.query.facet_interface_id,
            "E-AF002 activated aspect did not publish the requested facet binding"))
    Ok(acquired.unwrap().unwrap())

impl AspectExecutionContext:

    # Mission publication is explicit and irreversible for this process
    # state.  Every startup aspect must already be atomically published.
    me fn enter_operational() -> Result<(), text>:
        if aspect_application_is_operational(self.phase):
            return Ok(())
        if aspect_application_is_mission(self.trust_policy):
            aspect_application_startup_complete(self)?
        self.phase = AspectApplicationPhase.Operational
        Ok(())

    # FacetRef integration pins the exact published generation before it
    # dereferences a witness. The opaque token rejects replay and forgery.
    me fn acquire_published_generation(aspect_id: text) -> Result<GenerationToken, text>:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_acquire_published_generation_locked(
                    self, aspect_id))

impl AspectExecutionContext:
    # Release accepts only a generation represented by this application's
    # publication table, preventing arbitrary lifecycle-owner manipulation.
    me fn release_published_generation(token: GenerationToken) -> Result<(), text>:
        val boxed = AspectGenerationTokenBox(value: token)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_release_published_generation_locked(
                    self, boxed.value))

    fn published_generation_pin_count(aspect_id: text) -> Result<i64, text>:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_published_generation_pin_count_locked(
                    self, aspect_id))

fn aspect_execution_context_acquire_published_generation_locked(
    context: AspectExecutionContext, aspect_id: text
) -> Result<GenerationToken, text>:
    val transitioned = aspect_generation_acquire(context.coordinator, aspect_id)?
    context.coordinator = transitioned.coordinator
    Ok(transitioned.token)

fn aspect_execution_context_release_published_generation_locked(
    context: AspectExecutionContext, token: GenerationToken
) -> Result<(), text>:
    val transitioned = aspect_generation_release(context.coordinator, token)?
    context.coordinator = transitioned.coordinator
    Ok(())

fn aspect_execution_context_published_generation_pin_count_locked(
    context: AspectExecutionContext, aspect_id: text
) -> Result<i64, text>:
    aspect_generation_pin_count(context.coordinator, aspect_id)

impl AspectExecutionContext:

    # Lookup is pure registry access. The returned record identifies the exact
    # aspect whose canonical lifecycle lease must be acquired before invoking
    # its witness symbol.
    fn lookup_published_facet(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<FacetBindingRecord?, text>:
        val query = AspectFacetQueryBox(
            concrete_type_id: concrete_type_id,
            implemented_business_interfaces: implemented_business_interfaces,
            facet_interface_id: facet_interface_id)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_lookup_published_facet_locked(
                    self, query.concrete_type_id,
                    query.implemented_business_interfaces,
                    query.facet_interface_id))

fn aspect_execution_context_lookup_published_facet_locked(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text
) -> Result<FacetBindingRecord?, text>:
    aspect_published_facet_lookup(
        context.coordinator, concrete_type_id,
        implemented_business_interfaces, facet_interface_id)

impl AspectExecutionContext:

    # Prepared join-point dispatch seam. This performs no pointcut matching;
    # it returns the preordered visible chain and records exact harness
    # counters for both enabled and disabled slots.
    me fn lookup_published_advice(slot_id: text) -> Result<[AdviceBindingRecord], text>:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_lookup_published_advice_locked(
                    self, slot_id))

fn aspect_execution_context_lookup_published_advice_locked(
    context: AspectExecutionContext, slot_id: text
) -> Result<[AdviceBindingRecord], text>:
    val transitioned = aspect_published_advice_lookup(
        context.coordinator, slot_id)?
    context.coordinator = transitioned.coordinator
    Ok(transitioned.chain)

impl AspectExecutionContext:

    fn advice_binding_counters() -> AdviceBindingCounters:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                self.coordinator.advice_bindings.counters)

    fn advice_disabled_footprint() -> AdviceDisabledPathFootprint:
        advice_disabled_path_footprint()

    # Synchronous prepared-slot execution boundary. The loader-owned projection
    # pins every exact generation until its phase callback completes, so unload
    # may remove visibility but cannot reclaim an in-flight witness.
    me fn advice_dispatch_slot(
        loader: ModuleLoader,
        slot_id: text,
        form: text
    ) -> Result<[i64], text>:
        # Compatibility parameter only. Dispatch never installs a caller
        # snapshot; prepare validates the context's canonical loader owner.
        _ = loader
        self.invoke_prepared_advice(slot_id, form)

    # Intrinsic-facing split dispatch. Canonical pin state is installed before
    # unlock; native callbacks run without lifecycle ownership; finalization
    # starts from then-current state and always installs its returned state.
    me fn invoke_prepared_advice(slot_id: text, form: text) -> Result<[i64], text>:
        val prepared = mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                val transitioned = aspect_prepared_advice_prepare(
                    self.coordinator.advice_projection,
                    AspectPreparedAdviceState(
                        registry: self.coordinator.advice_bindings,
                        lifecycle: self.coordinator.lifecycle),
                    self.loader, self.advice_dispatch_ledger, slot_id, form)
                self.coordinator.advice_bindings = transitioned.state.registry
                self.coordinator.lifecycle = transitioned.state.lifecycle
                if transitioned.status != "prepared" or transitioned.invocation == nil:
                    Err(transitioned.reason)
                else:
                    val invocation = transitioned.invocation.unwrap()
                    Ok(AspectPreparedAdviceInvocation(
                        claim_id: invocation.claim_id,
                        permit: invocation.permit,
                        receipt: nil))
        )
        if prepared.is_err():
            return Err(prepared.unwrap_err())
        val invocation = prepared.unwrap()
        invocation.receipt = Some(
            advice_dispatch_permit_invoke_native(invocation.permit))
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                val transitioned = aspect_prepared_advice_finish(
                    AspectPreparedAdviceState(
                        registry: self.coordinator.advice_bindings,
                        lifecycle: self.coordinator.lifecycle),
                    self.advice_dispatch_ledger,
                    AspectPreparedAdviceTransitionInvocation(
                        claim_id: invocation.claim_id,
                        permit: invocation.permit),
                    invocation.receipt.unwrap())
                self.coordinator.advice_bindings = transitioned.state.registry
                self.coordinator.lifecycle = transitioned.state.lifecycle
                if transitioned.status != "dispatched":
                    Err(transitioned.reason)
                else:
                    Ok(transitioned.return_values))

    fn advice_dispatch_in_flight_count() -> i64:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                self.advice_dispatch_ledger.in_flight_count())

    # First-use boundary: resolve the visible witness and pin that record's
    # exact published generation as one application-runtime operation.
    me fn acquire_published_facet(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<(FacetBindingRecord, FacetGenerationLease)?, text>:
        val query = AspectFacetQueryBox(
            concrete_type_id: concrete_type_id,
            implemented_business_interfaces: implemented_business_interfaces,
            facet_interface_id: facet_interface_id)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_acquire_published_facet_locked(
                    self, query.concrete_type_id,
                    query.implemented_business_interfaces,
                    query.facet_interface_id))

fn aspect_execution_context_acquire_published_facet_locked(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text
) -> Result<(FacetBindingRecord, FacetGenerationLease)?, text>:
    val transitioned = aspect_published_facet_acquire(
        context.coordinator, concrete_type_id,
        implemented_business_interfaces, facet_interface_id)?
    context.coordinator = transitioned.coordinator
    Ok(transitioned.acquired)

impl AspectExecutionContext:

    # Acquires the generation lease and the exact resolved ordinary-SMF method
    # entry as one operation suitable for MIR CallIndirect lowering.
    me fn acquire_published_facet_method(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text,
        method_name: text
    ) -> Result<(FacetWitnessMethodEntry, FacetGenerationLease)?, text>:
        val query = AspectFacetMethodQueryBox(
            query: AspectFacetQueryBox(
                concrete_type_id: concrete_type_id,
                implemented_business_interfaces: implemented_business_interfaces,
                facet_interface_id: facet_interface_id),
            method_name: method_name)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_acquire_published_facet_method_locked(
                    self, query.query.concrete_type_id,
                    query.query.implemented_business_interfaces,
                    query.query.facet_interface_id, query.method_name))

fn aspect_execution_context_acquire_published_facet_method_locked(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text,
    method_name: text
) -> Result<(FacetWitnessMethodEntry, FacetGenerationLease)?, text>:
    val transitioned = aspect_published_facet_method_acquire(
        context.coordinator, concrete_type_id,
        implemented_business_interfaces, facet_interface_id, method_name)
    context.coordinator = transitioned.coordinator
    if val reason = transitioned.error:
        return Err(reason)
    Ok(transitioned.acquired)

impl AspectExecutionContext:

    # Compiler-facing whole-descriptor acquisition. Method selection remains a
    # compile-time ordinal operation over this descriptor; this boundary never
    # accepts or constructs an erased/caller-provided facet view.
    me fn acquire_published_facet_descriptor(
        concrete_type_id: text,
        implemented_business_interfaces: [text],
        facet_interface_id: text
    ) -> Result<PublishedFacetDescriptorLease?, text>:
        val query = AspectFacetQueryBox(
            concrete_type_id: concrete_type_id,
            implemented_business_interfaces: implemented_business_interfaces,
            facet_interface_id: facet_interface_id)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_acquire_published_facet_descriptor_locked(
                    self, query.concrete_type_id,
                    query.implemented_business_interfaces,
                    query.facet_interface_id))

fn aspect_execution_context_acquire_published_facet_descriptor_locked(
    context: AspectExecutionContext,
    concrete_type_id: text,
    implemented_business_interfaces: [text],
    facet_interface_id: text
) -> Result<PublishedFacetDescriptorLease?, text>:
    val transitioned = aspect_published_facet_descriptor_acquire(
        context.coordinator, concrete_type_id,
        implemented_business_interfaces, facet_interface_id)
    context.coordinator = transitioned.coordinator
    if val reason = transitioned.error:
        return Err(reason)
    Ok(transitioned.acquired)

impl AspectExecutionContext:

    me fn release_published_facet_descriptor(
        acquired: PublishedFacetDescriptorLease
    ) -> Result<(), text>:
        val boxed = AspectFacetDescriptorBox(value: acquired)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_release_published_facet_descriptor_locked(
                    self, boxed.value))

fn aspect_execution_context_release_published_facet_descriptor_locked(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease
) -> Result<(), text>:
    val transitioned = aspect_published_facet_descriptor_release(
        context.coordinator, acquired)
    context.coordinator = transitioned.coordinator
    if val reason = transitioned.error:
        return Err(reason)
    Ok(())

fn aspect_execution_context_published_facet_descriptor_handle_validate_locked(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease
) -> Result<(), text>:
    aspect_published_facet_handle_validate(context.coordinator, acquired)

impl AspectExecutionContext:

    # The descriptor lease is an opaque reference at the compiler ABI. This
    # operation performs whole-contract validation before the compiler creates
    # its private typed-base adapter; generated code never decodes descriptor
    # arrays or relies on their aggregate layout.
    fn validate_published_facet_descriptor_contract(
        acquired: PublishedFacetDescriptorLease,
        expected_facet_interface_id: text,
        expected_abi_hash: text,
        expected_method_names: [text]
    ) -> Result<(), text>:
        val query = AspectFacetContractQueryBox(
            acquired: acquired,
            expected_facet_interface_id: expected_facet_interface_id,
            expected_abi_hash: expected_abi_hash,
            expected_method_names: expected_method_names)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_validate_published_facet_descriptor_contract_locked(
                    self, query.acquired, query.expected_facet_interface_id,
                    query.expected_abi_hash, query.expected_method_names))

fn aspect_execution_context_validate_published_facet_descriptor_contract_locked(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease,
    expected_facet_interface_id: text,
    expected_abi_hash: text,
    expected_method_names: [text]
) -> Result<(), text>:
    aspect_published_facet_contract_validate(
        context.coordinator, acquired, expected_facet_interface_id,
        expected_abi_hash, expected_method_names)

impl AspectExecutionContext:

    # Runtime-owned ordinal lookup keeps descriptor layout and array decoding
    # out of compiler-generated code. The retained handle remains usable while
    # its exact generation is quiescing, until the compiler releases the lease.
    fn published_facet_descriptor_method_address(
        acquired: PublishedFacetDescriptorLease,
        ordinal: i64,
        expected_name: text
    ) -> Result<i64, text>:
        val boxed = AspectFacetDescriptorBox(value: acquired)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_published_facet_descriptor_method_address_locked(
                    self, boxed.value, ordinal, expected_name))

fn aspect_execution_context_published_facet_descriptor_method_address_locked(
    context: AspectExecutionContext,
    acquired: PublishedFacetDescriptorLease,
    ordinal: i64,
    expected_name: text
) -> Result<i64, text>:
    aspect_published_facet_method_address(
        context.coordinator, acquired, ordinal, expected_name)

impl AspectExecutionContext:

    # Ownership-neutral std.aop lease adapter. The lease carries no app/os
    # object; this boundary reconstructs the canonical lifecycle token.
    me fn acquire_facet_generation_lease(aspect_id: text) -> Result<FacetGenerationLease, text>:
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_acquire_facet_generation_lease_locked(
                    self, aspect_id))

fn aspect_execution_context_acquire_facet_generation_lease_locked(
    context: AspectExecutionContext, aspect_id: text
) -> Result<FacetGenerationLease, text>:
    val transitioned = aspect_facet_lease_acquire(
        context.coordinator, aspect_id)?
    context.coordinator = transitioned.0
    Ok(transitioned.1)

impl AspectExecutionContext:

    me fn release_facet_generation_lease(lease: FacetGenerationLease) -> Result<(), text>:
        val boxed = AspectFacetGenerationLeaseBox(value: lease)
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_release_facet_generation_lease_locked(
                    self, boxed.value))

fn aspect_execution_context_release_facet_generation_lease_locked(
    context: AspectExecutionContext, lease: FacetGenerationLease
) -> Result<(), text>:
    val transitioned = aspect_facet_lease_release(
        context.coordinator, lease)?
    context.coordinator = transitioned.coordinator
    Ok(())

impl AspectExecutionContext:

    # Ordinary-profile unload is a retryable two-step operation. The first
    # call quiesces acquisition and removes visible bindings. If tokens remain,
    # callers release them and retry; no wait loop or forced lease release is
    # hidden here.
    me fn unload_published_aspect(aspect_id: text, loader: ModuleLoader) -> Result<text, text>:
        # Compatibility parameter only; never replace the canonical loader.
        _ = loader
        mutex_with_lock_keeping(
            self.lifecycle_gate.mutex, 0, \:
                aspect_execution_context_unload_published_aspect_locked(
                    self, aspect_id))

fn aspect_execution_context_unload_published_aspect_locked(
    context: AspectExecutionContext, aspect_id: text
) -> Result<text, text>:
    val transitioned = aspect_unload_transition(
        context.authorize(AspectApplicationOperation.Unload),
        context.coordinator, context.loader, context.provider_cache, aspect_id)
    context.coordinator = transitioned.coordinator
    if transitioned.status == "failed":
        return Err(transitioned.reason)
    Ok(transitioned.status)


