# Browser Engine Event Bridge
#
# Maps raw system input events (keyboard, mouse, touch) to the
# platform-independent UIEvent enum used by the UI state machine.

use common.ui.widget.{UIEvent}
use common.layout.box_model.{BlockLayoutBox}

# =========================================================================
# Key Event Translation
# =========================================================================

fn translate_key_event(key: i32, modifiers: i32) -> UIEvent?:
    """Translate a raw key code + modifier bitmask into a UIEvent.

    Modifier bits:
      0x01 = Shift
      0x02 = Ctrl
      0x04 = Alt
      0x08 = Meta/Super
    """
    val has_ctrl = (modifiers / 2) % 2 == 1

    # Ctrl+Q or Ctrl+C -> Quit
    if has_ctrl and (key == 113 or key == 99):
        return UIEvent.Quit

    # Escape (27) -> NormalMode
    if key == 27:
        return UIEvent.NormalMode

    # Tab (9) -> FocusNext, Shift+Tab -> FocusPrev
    if key == 9:
        val has_shift = modifiers % 2 == 1
        if has_shift:
            return UIEvent.FocusPrev
        return UIEvent.FocusNext

    # Enter (13) -> Action("enter")
    if key == 13:
        return UIEvent.Action(name: "enter")

    # Colon (58) -> CommandMode
    if key == 58:
        return UIEvent.CommandMode

    # 'i' (105) -> InsertMode
    if key == 105:
        return UIEvent.InsertMode

    # Arrow keys: map to key names
    if key == 37:
        return UIEvent.KeyPress(key: "left")
    if key == 38:
        return UIEvent.KeyPress(key: "up")
    if key == 39:
        return UIEvent.KeyPress(key: "right")
    if key == 40:
        return UIEvent.KeyPress(key: "down")

    # Printable ASCII range
    if key >= 32 and key <= 126:
        val ch = char_from_code(key)
        return UIEvent.KeyPress(key: ch)

    return nil

fn translate_browser_key_event(keycode: i32, scancode: i32, modifiers: i32, text_input_focused: bool) -> UIEvent?:
    """Translate raw winit/host keyboard input into a browser UIEvent.

    Handles macOS/winit uppercase keycodes (65..90), DOM punctuation codes
    (186..222), Backspace/Delete/Enter/Tab/Escape/Space/PageUp/PageDown/Arrows,
    and suppresses Normal/Command/Insert mode hotkeys while a text field has focus.
    """
    val has_shift = (modifiers % 2) == 1
    val has_ctrl = ((modifiers / 2) % 2) == 1

    # Ctrl+Q / Ctrl+C -> Quit
    if has_ctrl and (keycode == 113 or keycode == 81 or keycode == 99 or keycode == 67):
        return UIEvent.Quit

    # Escape (27) or macOS Escape scancode (53 when not Digit5 keycode=53)
    if keycode == 27 or (keycode != 53 and scancode == 53):
        return UIEvent.NormalMode

    # Tab (9) or macOS Tab scancode (48 when not Digit0 keycode=48)
    if keycode == 9 or (keycode != 48 and scancode == 48):
        if has_shift:
            return UIEvent.FocusPrev
        return UIEvent.FocusNext

    # Forward Delete (macOS scancode 117 when not F6 keycode=117)
    if keycode != 117 and scancode == 117:
        return UIEvent.KeyPress(key: "delete")

    # Backspace (8, 127, or macOS scancode 51 when not Digit3 keycode=51)
    if keycode == 8 or keycode == 127 or (keycode != 51 and scancode == 51):
        return UIEvent.KeyPress(key: "backspace")

    # Enter (13, or macOS Return scancode 36 when not Home keycode=36)
    if keycode == 13 or (keycode != 36 and scancode == 36):
        if text_input_focused:
            return UIEvent.KeyPress(key: "enter")
        return UIEvent.Action(name: "enter")

    # PageUp / PageDown (33/34, or macOS scancodes 116/121 when not F5/F10)
    if keycode == 33 or (keycode != 116 and scancode == 116):
        return UIEvent.KeyPress(key: "page_up")
    if keycode == 34 or (keycode != 121 and scancode == 121):
        return UIEvent.KeyPress(key: "page_down")

    # Arrow keys (37..40, or macOS scancodes 123..126 when not F12)
    if keycode == 37 or (keycode != 123 and scancode == 123):
        return UIEvent.KeyPress(key: "left")
    if keycode == 38 or (keycode != 126 and scancode == 126):
        return UIEvent.KeyPress(key: "up")
    if keycode == 39 or (keycode != 124 and scancode == 124):
        return UIEvent.KeyPress(key: "right")
    if keycode == 40 or (keycode != 125 and scancode == 125):
        return UIEvent.KeyPress(key: "down")

    # Space (32, or macOS Space scancode 49 when not Digit1 keycode=49)
    if keycode == 32 or (keycode != 49 and scancode == 49):
        return UIEvent.KeyPress(key: " ")

    val ch = _browser_printable_char(keycode, has_shift)
    if ch != "":
        if not text_input_focused:
            if ch == ":":
                return UIEvent.CommandMode
            if ch == "i":
                return UIEvent.InsertMode
        return UIEvent.KeyPress(key: ch)

    return None

fn _browser_printable_char(keycode: i32, has_shift: bool) -> text:
    if keycode >= 65 and keycode <= 90:
        if has_shift:
            return char_from_code(keycode)
        return char_from_code(keycode + 32)
    if keycode >= 48 and keycode <= 57 and has_shift:
        match keycode:
            48 => return ")"
            49 => return "!"
            50 => return "@"
            51 => return "#"
            52 => return "$"
            53 => return "%"
            54 => return "^"
            55 => return "&"
            56 => return "*"
            57 => return "("
            _ => pass_dn
    match keycode:
        186 => return if has_shift: ":" else: ";"
        187 => return if has_shift: "+" else: "="
        188 => return if has_shift: "<" else: ","
        189 => return if has_shift: "_" else: "-"
        190 => return if has_shift: ">" else: "."
        191 => return if has_shift: "?" else: "/"
        192 => return if has_shift: "~" else: "`"
        219 => return if has_shift: "{" else: "["
        220 => return if has_shift: "|" else: "\\"
        221 => return if has_shift: "}" else: "]"
        222 => return if has_shift: "\"" else: "'"
        _ => pass_dn
    if keycode >= 32 and keycode <= 126:
        return char_from_code(keycode)
    ""

# =========================================================================
# Mouse Event Translation
# =========================================================================

fn translate_mouse_event(x: i32, y: i32, button: i32, action: text) -> UIEvent?:
    """Translate a raw mouse event into a UIEvent.

    action: "press", "release", "move"
    button: 0 = left, 1 = middle, 2 = right
    """
    match action:
        "press" =>
            if button == 0:
                return UIEvent.TouchPress(x: x, y: y)
            return nil
        "release" =>
            if button == 0:
                return UIEvent.TouchRelease(x: x, y: y)
            return nil
        "move" =>
            return UIEvent.TouchMove(x: x, y: y)
        _ =>
            return nil

# =========================================================================
# Hit Testing
# =========================================================================

fn hit_test(layout: BlockLayoutBox, x: i32, y: i32) -> text?:
    """Find the widget id at pixel (x, y) by walking the layout tree.

    Returns the deepest (most specific) widget id that contains the point,
    or nil if no widget is hit.
    """
    val fx: f64 = x.to_f64()
    val fy: f64 = y.to_f64()
    return hit_test_recursive(layout, fx, fy)

fn hit_test_recursive(box: BlockLayoutBox, fx: f64, fy: f64) -> text?:
    """Recursive hit test — returns deepest matching node id."""
    # Check if point is inside this box
    val inside = (fx >= box.x and fx < box.x + box.width
        and fy >= box.y and fy < box.y + box.height)

    if not inside:
        return nil

    # Check children in reverse order (last drawn = topmost = checked first)
    val child_list = box.children
    var i = child_list.len() - 1
    while i >= 0:
        val child = child_list[i]
        val child_hit = hit_test_recursive(child, fx, fy)
        if child_hit.is_some():
            return child_hit
        i = i - 1

    # No child hit — this box is the target
    return "{box.node_id}"

# =========================================================================
# Helpers
# =========================================================================

fn char_from_code(code: i32) -> text:
    """Convert an ASCII code to a single-character text value."""
    # Common printable characters
    if code == 32: return " "
    if code == 33: return "!"
    if code == 34: return "\""
    if code == 35: return "#"
    if code == 36: return "$"
    if code == 37: return "%"
    if code == 38: return "&"
    if code == 39: return "'"
    if code == 40: return "("
    if code == 41: return ")"
    if code == 42: return "*"
    if code == 43: return "+"
    if code == 44: return ","
    if code == 45: return "-"
    if code == 46: return "."
    if code == 47: return "/"

    # Digits 0-9
    if code >= 48 and code <= 57:
        val digit = code - 48
        return "{digit}"

    if code == 58: return ":"
    if code == 59: return ";"
    if code == 60: return "<"
    if code == 61: return "="
    if code == 62: return ">"
    if code == 63: return "?"
    if code == 64: return "@"

    # Uppercase A-Z
    if code >= 65 and code <= 90:
        match code:
            65 => return "A"
            66 => return "B"
            67 => return "C"
            68 => return "D"
            69 => return "E"
            70 => return "F"
            71 => return "G"
            72 => return "H"
            73 => return "I"
            74 => return "J"
            75 => return "K"
            76 => return "L"
            77 => return "M"
            78 => return "N"
            79 => return "O"
            80 => return "P"
            81 => return "Q"
            82 => return "R"
            83 => return "S"
            84 => return "T"
            85 => return "U"
            86 => return "V"
            87 => return "W"
            88 => return "X"
            89 => return "Y"
            90 => return "Z"
            _ => return "?"

    if code == 91: return "["
    if code == 92: return "\\"
    if code == 93: return "]"
    if code == 94: return "^"
    if code == 95: return "_"
    if code == 96: return "`"

    # Lowercase a-z
    if code >= 97 and code <= 122:
        match code:
            97 => return "a"
            98 => return "b"
            99 => return "c"
            100 => return "d"
            101 => return "e"
            102 => return "f"
            103 => return "g"
            104 => return "h"
            105 => return "i"
            106 => return "j"
            107 => return "k"
            108 => return "l"
            109 => return "m"
            110 => return "n"
            111 => return "o"
            112 => return "p"
            113 => return "q"
            114 => return "r"
            115 => return "s"
            116 => return "t"
            117 => return "u"
            118 => return "v"
            119 => return "w"
            120 => return "x"
            121 => return "y"
            122 => return "z"
            _ => return "?"

    if code == 123: return "{"
    if code == 124: return "|"
    if code == 125: return "}"
    if code == 126: return "~"

    return "?"
