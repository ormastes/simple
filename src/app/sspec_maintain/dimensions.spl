# Data-driven scoring dimension catalog. Extension seam for score.spl:
# add a dimension by adding one row here (plus the matching field on
# SspecDocumentizationScore in model.spl, since the report shape is stable
# public API). Weights must sum to 100 — enforced by a regression spec.

struct SspecDimensionWeight:
    dimension: text
    weight: i64

fn sspec_dimension_weights() -> [SspecDimensionWeight]:
    [
        SspecDimensionWeight(dimension: "narrative", weight: 15),
        SspecDimensionWeight(dimension: "structure", weight: 15),
        SspecDimensionWeight(dimension: "oracle", weight: 20),
        SspecDimensionWeight(dimension: "traceability", weight: 15),
        SspecDimensionWeight(dimension: "evidence", weight: 15),
        SspecDimensionWeight(dimension: "coverage", weight: 10),
        SspecDimensionWeight(dimension: "maintainability", weight: 10)
    ]

fn sspec_blocker_cap() -> i64:
    """Effective aggregate is clamped to this value whenever any blocker fires."""
    49

fn sspec_release_target() -> i64:
    """Documented release-readiness target for the effective aggregate score."""
    90
