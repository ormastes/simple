# One-pass structural fact extraction. O(source bytes + scenarios).
use app.sspec_maintain.model.*
use std.crypto.sha256.{sha256_text}

fn _quoted_name(line: text) -> text:
    val parts = line.split("\"")
    if parts.len() > 1:
        return parts[1].trim()
    line.trim()

fn _is_standalone_assertion(line: text) -> bool:
    val lower = line.lower()
    lower.contains("assert_equal(") or lower.contains("assert_not_equal(") or
        lower.contains("assert_true(") or lower.contains("assert_false(") or
        lower.contains("assert_contains(") or lower.contains("assert_nil(")

fn _is_real_assertion(line: text) -> bool:
    val lower = line.lower()
    val assertion = lower.contains("expect(") or lower.contains("assert(") or
        lower.contains("expect_compile") or lower.contains("assert_compile") or
        _is_standalone_assertion(line)
    if not assertion:
        return false
    if lower.contains("assert(true)") or lower.contains("assert(false)") or
            lower.contains("assert_true(true)") or lower.contains("assert_false(false)"):
        return false
    val expect_start = lower.index_of("expect(")
    val equal_start = lower.index_of(").to_equal(")
    if expect_start >= 0 and equal_start > expect_start:
        val actual = lower.substring(expect_start + 7, equal_start).trim()
        var expected = lower.substring(equal_start + 11).trim()
        if expected.ends_with(")"):
            expected = expected[:-1].trim()
        if actual == expected:
            return false
    true

fn _is_pending(line: text) -> bool:
    val lower = line.lower()
    lower.contains("pass_todo") or lower.contains("fail(\"todo:") or
        lower.contains("skip(") or lower.contains("pending")

fn _contains_requirement(line: text) -> bool:
    line.contains("REQ-") or line.contains("@req")

fn _requirement_ids(line: text) -> [text]:
    var normalized = line
    for separator in ["\"", "'", "(", ")", "[", "]", "{", "}", ":", ",", ";", "#"]:
        normalized = normalized.replace(separator, " ")
    var ids: [text] = []
    for token in normalized.split():
        if token.starts_with("REQ-") and not ids.contains(token):
            ids.push(token)
    ids

fn _assertion_parts(line: text) -> (text, text):
    val lower = line.lower()
    val actual_start = lower.index_of("expect(")
    val separator = lower.index_of(").to_equal(")
    if actual_start < 0 or separator <= actual_start:
        return ("", "")
    val actual = line.substring(actual_start + 7, separator).trim()
    var expected = line.substring(separator + 11).trim()
    while expected.ends_with(")"):
        expected = expected[:-1].trim()
    (actual, expected)

fn _is_numeric_literal(value: text) -> bool:
    val candidate = value.trim().replace("_", "")
    if candidate == "": return false
    var digit_count: i64 = 0
    for ch in candidate:
        if ch >= "0" and ch <= "9":
            digit_count = digit_count + 1
        elif ch != "-" and ch != "+" and ch != ".":
            return false
    digit_count > 0

fn _assignment(line: text) -> (text, text):
    val trimmed = line.trim()
    # Only immutable `val` bindings feed the tautology heuristic: a `var`
    # initialized to a literal is typically a flag mutated inside a loop
    # (`var found = false` ... `expect(found).to_equal(false)`), where the
    # binding's initial text says nothing about the asserted value.
    if not trimmed.starts_with("val ") or not trimmed.contains("="):
        return ("", "")
    val pieces = trimmed.split("=")
    if pieces.len() < 2: return ("", "")
    val names = pieces[0].trim().split()
    if names.len() < 2: return ("", "")
    (names[names.len() - 1], pieces[1].trim())

fn _is_adverse_name(name: text) -> bool:
    val lower = name.lower()
    lower.contains("negative") or lower.contains("boundary") or
        lower.contains("reject") or lower.contains("invalid") or
        lower.contains("recover") or lower.contains("unsupported") or
        lower.contains("ambigu") or lower.contains("error")

fn _indent_width(raw: text) -> i64:
    raw.len() - raw.trim_start().len()

fn _finish_scenario(name: text, start_line: i64, end_line: i64,
        steps: i64, assertions: i64, real_assertions: i64, captures: i64,
        requirements: i64, pending: bool, source_only: bool,
        local_arithmetic: bool, magic_expected: i64) -> SspecScenarioFacts:
    SspecScenarioFacts(name: name, line: start_line, end_line: end_line,
        step_count: steps, assertion_count: assertions,
        real_assertion_count: real_assertions, capture_count: captures,
        requirement_count: requirements, pending: pending,
        source_only_oracle: source_only,
        local_arithmetic_oracle: local_arithmetic,
        magic_expected_count: magic_expected)

fn extract_sspec_source_facts(path: text, source: text) -> SspecSourceFacts:
    val lines = source.split("\n")
    val lower = source.lower()
    var scenarios: [SspecScenarioFacts] = []
    var current_name = ""
    var current_line: i64 = 0
    var current_indent: i64 = 0
    var scenario_steps: i64 = 0
    var scenario_assertions: i64 = 0
    var scenario_real: i64 = 0
    var scenario_captures: i64 = 0
    var scenario_requirements: i64 = 0
    var scenario_pending = false
    var scenario_source_only = false
    var scenario_local_arithmetic = false
    var scenario_magic_expected: i64 = 0
    var scenario_bindings: Dict<text, text> = {}
    var scenario_requirement_ids: [text] = []
    var bound_requirement_ids: [text] = []
    var all_requirement_ids: [text] = []
    var planned_requirement_ids: [text] = []
    var assertions: i64 = 0
    var real_assertions: i64 = 0
    var steps: i64 = 0
    var captures: i64 = 0
    var requirements: i64 = 0
    var line_number: i64 = 0
    var has_bare_step = false
    for raw in lines:
        line_number = line_number + 1
        val line = raw.trim()
        val line_lower = line.lower()
        val indent = _indent_width(raw)
        if current_line > 0 and line != "" and indent <= current_indent:
            scenarios.push(_finish_scenario(current_name, current_line,
                line_number - 1, scenario_steps, scenario_assertions,
                scenario_real, scenario_captures, scenario_requirements,
                scenario_pending, scenario_source_only,
                scenario_local_arithmetic, scenario_magic_expected))
            current_line = 0
            current_name = ""
        if line.starts_with("@step "): has_bare_step = true
        if line.starts_with("it \""):
            if current_line > 0:
                scenarios.push(_finish_scenario(current_name, current_line,
                    line_number - 1, scenario_steps, scenario_assertions,
                    scenario_real, scenario_captures, scenario_requirements,
                    scenario_pending, scenario_source_only,
                    scenario_local_arithmetic, scenario_magic_expected))
            current_name = _quoted_name(line)
            current_line = line_number
            current_indent = indent
            scenario_steps = 0
            scenario_assertions = 0
            scenario_real = 0
            scenario_captures = 0
            scenario_requirements = 0
            scenario_pending = false
            scenario_source_only = false
            scenario_local_arithmetic = false
            scenario_magic_expected = 0
            scenario_bindings = {}
            scenario_requirement_ids = []
        val (assigned_name, assigned_value) = _assignment(line)
        if current_line > 0 and assigned_name != "":
            scenario_bindings[assigned_name] = assigned_value
        if current_line > 0 and line_lower.contains("step(\""):
            steps = steps + 1
            scenario_steps = scenario_steps + 1
        if current_line > 0 and (line_lower.contains("expect(") or line_lower.contains("assert(") or
                line_lower.contains("expect_compile") or line_lower.contains("assert_compile") or
                _is_standalone_assertion(line)):
            assertions = assertions + 1
            if current_line > 0: scenario_assertions = scenario_assertions + 1
            val (actual, expected) = _assertion_parts(line)
            val local_arithmetic = actual != "" and (_is_numeric_literal(actual) or
                (scenario_bindings.has(actual) and scenario_bindings[actual] == expected))
            if local_arithmetic: scenario_local_arithmetic = true
            if expected != "" and _is_numeric_literal(expected) and
                    not line_lower.contains("# explained:") and
                    not line_lower.contains("# oracle:"):
                scenario_magic_expected = scenario_magic_expected + 1
            if _is_real_assertion(line) and not local_arithmetic:
                real_assertions = real_assertions + 1
                if current_line > 0: scenario_real = scenario_real + 1
        # Typed-evidence surface: the modern stack captures via
        # compare_evidence(...)/evidence_manifest(...)/render_manual(...) and
        # per-kind modules (terminal_grid, gui_image/action_trace,
        # binary_layout/bit_table) or a `<spec>.evidence.sdn` sidecar — none of
        # which contain the literal `capture_`/`evidence(` substrings.
        if current_line > 0 and (line_lower.contains("capture_") or
                line_lower.contains("@capture") or line_lower.contains("evidence(") or
                line_lower.contains("evidence_manifest(") or
                line_lower.contains("render_manual(") or
                line_lower.contains("terminal_grid") or line_lower.contains("tui_grid") or
                line_lower.contains("gui_image") or line_lower.contains("action_trace") or
                line_lower.contains("bit_table") or line_lower.contains("binary_layout") or
                line_lower.contains(".evidence.sdn")):
            captures = captures + 1
            scenario_captures = scenario_captures + 1
        if _contains_requirement(line):
            for requirement_id in _requirement_ids(line):
                if not all_requirement_ids.contains(requirement_id):
                    all_requirement_ids.push(requirement_id)
                if current_line > 0 and not scenario_requirement_ids.contains(requirement_id):
                    scenario_requirement_ids.push(requirement_id)
                    if not bound_requirement_ids.contains(requirement_id):
                        bound_requirement_ids.push(requirement_id)
                if (line_lower.contains("planned") or line_lower.contains("selected")) and
                        not planned_requirement_ids.contains(requirement_id):
                    planned_requirement_ids.push(requirement_id)
            requirements = all_requirement_ids.len()
            scenario_requirements = scenario_requirement_ids.len()
        if current_line > 0 and _is_pending(line): scenario_pending = true
        if current_line > 0 and (line_lower.contains("expect(file_read(") or
                line_lower.contains("expect(source.contains(") or
                line_lower.contains("assert(file_read(") or
                line_lower.contains("assert(source.contains(") or
                line_lower.contains("source text oracle")):
            scenario_source_only = true
    if current_line > 0:
        scenarios.push(_finish_scenario(current_name, current_line, lines.len(),
            scenario_steps, scenario_assertions, scenario_real, scenario_captures,
            scenario_requirements, scenario_pending, scenario_source_only,
            scenario_local_arithmetic, scenario_magic_expected))
    var dangling_requirements: i64 = 0
    for requirement_id in all_requirement_ids:
        if not bound_requirement_ids.contains(requirement_id) and
                not planned_requirement_ids.contains(requirement_id):
            dangling_requirements = dangling_requirements + 1
    var unresolved_planned_requirements: i64 = 0
    for requirement_id in planned_requirement_ids:
        if not bound_requirement_ids.contains(requirement_id):
            unresolved_planned_requirements = unresolved_planned_requirements + 1
    var adverse_scenarios: i64 = 0
    for scenario in scenarios:
        if _is_adverse_name(scenario.name): adverse_scenarios = adverse_scenarios + 1
    val coverage_required = lower.contains("must reject") or lower.contains("shall reject") or
        lower.contains("invalid input") or lower.contains("boundary behavior") or
        lower.contains("recovery behavior") or lower.contains("unsupported behavior") or
        lower.contains("ambiguity behavior")
    var lifecycle_paths: [text] = []
    for raw in lines:
        for token in raw.replace("`", " ").replace("\"", " ").split():
            if (token.starts_with("doc/01_research/") or
                    token.starts_with("doc/03_plan/") or
                    token.starts_with("doc/04_architecture/") or
                    token.starts_with("doc/05_design/")) and
                    not lifecycle_paths.contains(token):
                lifecycle_paths.push(token)
    lifecycle_paths.sort()
    SspecSourceFacts(path: path, source_hash: sha256_text(source),
        line_count: lines.len(),
        has_purpose: lower.contains("purpose and audience") or lower.contains("## purpose"),
        has_placeholder_narrative: lower.contains("todo: describe") or
            lower.contains("todo: author") or
            lower.contains("description of this block") or lower.contains("lorem ipsum"),
        has_manual_sections: lower.contains("## operator workflow") or
            lower.contains("## scenario narratives") or lower.contains("@manual"),
        has_folding: lower.contains("@fold") or lower.contains("@manual"),
        has_troubleshooting: lower.contains("troubleshoot") or lower.contains("verification guidance"),
        has_internal_reader_tags: lower.contains("@internal") or lower.contains("@qa-only") or
            lower.contains("@execution-only"),
        has_bare_step_annotation: has_bare_step,
        has_repeated_setup: lower.contains("before_each") and lower.contains("setup") and
            not lower.contains("fn setup"),
        has_coverage_case: adverse_scenarios > 0,
        scenario_count: scenarios.len(), assertion_count: assertions,
        real_assertion_count: real_assertions, step_count: steps,
        capture_count: captures, requirement_count: requirements,
        planned_requirement_count: unresolved_planned_requirements,
        dangling_requirement_count: dangling_requirements,
        coverage_required: coverage_required,
        coverage_scenario_count: adverse_scenarios,
        lifecycle_paths: lifecycle_paths,
        scenarios: scenarios)

fn extract_sspec_manual_facts(path: text, content: text) -> SspecManualFacts:
    val lines = content.split("\n")
    val lower = content.lower()
    var headings: i64 = 0
    var visible_steps: i64 = 0
    var evidence_blocks: i64 = 0
    var trace_links: i64 = 0
    for raw in lines:
        val line = raw.trim()
        val folded = line.lower()
        if line.starts_with("#"): headings = headings + 1
        if (
            folded.starts_with("step ") or
            folded.starts_with("1. ") or
            folded.contains("data-step=")
        ): visible_steps = visible_steps + 1
        # Matches what manual_render.spl actually emits: terminal_grid renders
        # as a ```text fence (not ```textgrid), unknown kinds as
        # ```unknown-block:, plus ## Provenance and markdown images. The old
        # ```textgrid/```protocol fences are kept for manuals generated by
        # older tooling.
        if (
            folded.contains("evidence") or
            folded.contains("```text") or
            folded.contains("```textgrid") or
            folded.contains("```protocol") or
            folded.contains("```unknown-block") or
            folded.contains("## provenance") or
            folded.contains("![")
        ): evidence_blocks = evidence_blocks + 1
        if _contains_requirement(line): trace_links = trace_links + 1
    var missing_sections: [text] = []
    if not lower.contains("purpose"): missing_sections.push("purpose")
    if not lower.contains("audience"): missing_sections.push("audience")
    if not lower.contains("scope"): missing_sections.push("scope")
    if not (lower.contains("assumption") or lower.contains("precondition")):
        missing_sections.push("assumptions/preconditions")
    if not (lower.contains("workflow") or lower.contains("primary flow")):
        missing_sections.push("primary workflow")
    if not lower.contains("requirement"): missing_sections.push("traceability")
    if not (lower.contains("evidence") or lower.contains("capture")):
        missing_sections.push("evidence")
    if not (lower.contains("unsupported") or lower.contains("limitation")):
        missing_sections.push("unsupported/limitations")
    if not (lower.contains("troubleshoot") or lower.contains("recovery")):
        missing_sections.push("recovery/troubleshooting")
    if not (lower.contains("generated") or lower.contains("generation history")):
        missing_sections.push("generation history")
    SspecManualFacts(path: path, content_hash: sha256_text(content),
        line_count: lines.len(), heading_count: headings,
        visible_step_count: visible_steps, evidence_block_count: evidence_blocks,
        trace_link_count: trace_links,
        has_primary_flow: lower.contains("workflow") or lower.contains("primary flow"),
        has_verification: lower.contains("verification") or lower.contains("expected outcome"),
        has_troubleshooting: lower.contains("troubleshoot") or lower.contains("recovery"),
        has_source_identity: lower.contains("sha-256") or lower.contains("source hash"),
        has_internal_tags: lower.contains("@internal") or lower.contains("@qa-only"),
        missing_professional_sections: missing_sections)
