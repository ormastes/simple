# Stable public model for SSpec maintenance reports.

struct SspecDocumentizationFinding:
    rule_id: text
    dimension: text
    severity: text
    confidence: text
    path: text
    line: i64
    evidence: text
    rationale: text
    remediation: text
    fingerprint: text
    blocker: bool
    fixable: bool

struct SspecDocumentizationScore:
    narrative: i64
    structure: i64
    oracle: i64
    traceability: i64
    evidence: i64
    coverage: i64
    maintainability: i64
    aggregate: i64
    blockers: i64

struct SspecDocumentizationReport:
    schema_version: text
    tool_version: text
    source_path: text
    source_hash: text
    mirror_path: text
    mirror_state: text
    score: SspecDocumentizationScore
    findings: [SspecDocumentizationFinding]

struct SspecImprovement:
    content: text
    changed: bool
    rollback_content: text

fn empty_score() -> SspecDocumentizationScore:
    SspecDocumentizationScore(narrative: 100, structure: 100, oracle: 100,
        traceability: 100, evidence: 100, coverage: 100, maintainability: 100,
        aggregate: 100, blockers: 0)
