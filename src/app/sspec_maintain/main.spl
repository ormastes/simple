# REQ-001, REQ-005, REQ-010: command surface, policy, and compatibility.
use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read, file_atomic_write, file_exists, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_walk, is_dir, dir_create_all, dir_remove}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use app.io.cli_ops.{_cli_eprint}
use app.sspec_maintain.model.{SspecDocumentizationFinding,
    SspecDocumentizationReport, SspecImprovement}
use app.sspec_maintain.analyzer.{analyze_sspec_pair_text, derive_manual_path}
use app.sspec_maintain.score.{score_sspec_findings}
use app.sspec_maintain.report.{render_human_report, render_json_report,
    render_json_report_fragments, render_sarif_results_fragment,
    render_sarif_result_fragments}
use app.sspec_maintain.scaffold.{scaffold_reference_text}
use app.spipe_docgen.spipe_docgen.main.{run_spipe_docgen}
use app.spipe_docgen.spipe_docgen.parser.{parse_spipe_file}
use app.sspec_maintain.improve.{preview_sspec_text_result, safe_sspec_easyfixes,
    render_sspec_improvement_preview}
use std.tooling.easy_fix.types.{easyfix_id}
use std.crypto.sha256.{sha256_text}
use std.common.text_advanced.{escape_json}
use app.sspec_maintain.cache.{SspecCacheRecord, encode_sspec_cache_record,
    decode_sspec_cache_record, parse_sspec_baseline, SspecPairCacheKey,
    build_sspec_pair_cache_key, sspec_pair_cache_path,
    sspec_pair_cache_reusable, sspec_cache_configuration_identity}
use app.sspec_maintain.suppression.{parse_sspec_suppressions,
    apply_sspec_suppressions}
use app.sspec_maintain.documentize.{compose_sspec_documentized_manual}
use app.sspec_maintain.lifecycle.{inspect_sspec_lifecycle_links}

fn _usage():
    print "SSpec documentization maintenance"
    print "Usage: simple sspec-maintain <scan|improve|scaffold|documentize> <path> [options]"
    print "  scan <spec|dir> [--format human|json|sarif] [--min-score N] [--deny-severity LEVEL]"
    print "       [--baseline <fingerprints>] [--suppressions <reviewed-file>]"
    print "       [--rule <SSDOC-ID,...>] [--cache <dir>|--no-cache] [--debug-timings]"
    print "  improve <spec|dir> [--apply] [--rollback <path-for-single-spec>]"
    print "  scaffold <reference.md> [--output <spec.spl>] [--apply --overwrite]"
    print "  documentize <spec> [--output <manual.md>] [--no-scorecard]"
    print "Scan and improve preview are read-only; writes require explicit --apply."
    print "Use lint for correctness, fix for compiler EasyFixes, duplicate-check for duplication,"
    print "spipe-docgen for canonical manuals, and sspec-maintain for documentation quality."
    print "spec-gen is legacy; reference scaffolding belongs to sspec-maintain/spec-to-spipe."

fn _option(args: [text], name: text, fallback: text) -> text:
    var i = 0
    while i + 1 < args.len():
        if args[i] == name:
            return args[i + 1]
        i = i + 1
    fallback

fn _sspec_maintain_has_arg(args: [text], name: text) -> bool:
    args.contains(name)

fn _emit_error(format: text, message: text, status: i64) -> i64:
    if format == "json":
        print "{\"schema_version\":\"sspec-maintain-error/v1\",\"error\":{\"message\":\"{escape_json(message)}\",\"status\":{status}}}"
    elif format == "sarif":
        print "{\"version\":\"2.1.0\",\"runs\":[{\"tool\":{\"driver\":{\"name\":\"simple sspec-maintain\"}},\"invocations\":[{\"executionSuccessful\":false,\"exitCode\":{status},\"toolExecutionNotifications\":[{\"level\":\"error\",\"message\":{\"text\":\"{escape_json(message)}\"}}]}]}]}"
    else:
        _cli_eprint("sspec-maintain: {message}")
    status

fn _severity_rank(value: text) -> i64:
    if value == "advice": return 1
    if value == "warning": return 2
    if value == "error": return 3
    if value == "blocker": return 4
    0

fn _maximum_severity_rank(report: SspecDocumentizationReport) -> i64:
    var maximum: i64 = 0
    for finding in report.findings:
        if finding.suppressed: continue
        val rank = _severity_rank(finding.severity)
        if rank > maximum: maximum = rank
    maximum

fn _rule_filters(args: [text]) -> [text]:
    val raw = _option(args, "--rule", "")
    if raw == "": return []
    var filters: [text] = []
    for rule_id in raw.split(","):
        val normalized = rule_id.trim()
        if normalized != "" and not filters.contains(normalized): filters.push(normalized)
    filters.sort()
    filters

fn _filter_report(report: SspecDocumentizationReport,
        filters: [text]) -> SspecDocumentizationReport:
    if filters.len() == 0: return report
    var updated = report
    var findings: [SspecDocumentizationFinding] = []
    for finding in report.findings:
        if filters.contains(finding.rule_id): findings.push(finding)
    updated.findings = findings
    updated.score = score_sspec_findings(findings)
    updated

fn _apply_baseline(report: SspecDocumentizationReport,
        previous: [text]) -> SspecDocumentizationReport:
    var updated = report
    var active: [text] = []
    var findings = updated.findings
    var index: i64 = 0
    while index < findings.len():
        active.push(findings[index].fingerprint)
        findings[index].baseline_state = if previous.contains(
            findings[index].fingerprint): "unchanged" else: "new"
        index = index + 1
    var resolved: [text] = []
    for fingerprint in previous:
        if not active.contains(fingerprint): resolved.push(fingerprint)
    resolved.sort()
    updated.findings = findings
    updated.resolved_fingerprints = resolved
    updated

fn _render_scan_fragments(human_items: [text], json_items: [text],
        sarif_items: [text], format: text) -> text:
    if format == "json": return render_json_report_fragments(json_items)
    if format == "sarif": return render_sarif_result_fragments(sarif_items)
    human_items.join("\n\n")

fn _read(path: text) -> Result<text, text>:
    if not file_exists(path):
        return Err("file does not exist: {path}")
    val value = file_read(path)
    match value:
        case Some(content): Ok(content)
        case None: Err("cannot read: {path}")

fn _scan_paths(scope: text) -> [text]:
    if not is_dir(scope):
        return [scope]
    var paths: [text] = []
    for path in dir_walk(scope):
        if path.ends_with("_spec.spl"):
            paths.push(path)
    paths.sort()
    paths

fn _rollback_original_source(path: text) -> Result<text, text>:
    val content = match _read(path):
        case Err(message): return Err(message)
        case Ok(value): value
    val marker = "--- original source ---\n"
    val marker_offset = content.find(marker)
    if marker_offset < 0:
        return Err("rollback material lacks original-source marker: {path}")
    Ok(content[marker_offset + marker.len():])

fn _run_scan(path: text, args: [text]) -> i64:
    val scan_started = time_now_unix_micros()
    val format = _option(args, "--format", "human")
    if format != "human" and format != "json" and format != "sarif":
        return _emit_error("human", "invalid format '{format}'", 2)
    val min_score_text = _option(args, "--min-score", "-1")
    val min_score = min_score_text.to_i64() ?? -2
    val deny = _option(args, "--deny-severity", "off")
    if min_score < -1 or min_score > 100:
        return _emit_error(format, "--min-score must be between 0 and 100", 2)
    if deny != "off" and _severity_rank(deny) == 0:
        return _emit_error(format, "invalid --deny-severity '{deny}'", 2)
    val baseline_path = _option(args, "--baseline", "")
    if baseline_path != "" and not file_exists(baseline_path):
        return _emit_error(format, "baseline does not exist: {baseline_path}", 3)
    val baseline_content = if baseline_path == "": "" else:
        file_read(baseline_path) ?? ""
    val baseline = parse_sspec_baseline(baseline_content)
    val suppressions_path = _option(args, "--suppressions", "")
    if suppressions_path != "" and not file_exists(suppressions_path):
        return _emit_error(format, "suppressions file does not exist: {suppressions_path}", 3)
    val suppressions_content = if suppressions_path == "": "" else:
        file_read(suppressions_path) ?? ""
    val suppressions = match parse_sspec_suppressions(suppressions_content):
        case Err(message): return _emit_error(format, message, 2)
        case Ok(value): value
    val filters = _rule_filters(args)
    val configuration_hash = sspec_cache_configuration_identity(
        baseline_content, suppressions_content, filters)
    val cache_dir = _option(args, "--cache", ".simple/cache/sspec-maintain")
    val cache_enabled = not _sspec_maintain_has_arg(args, "--no-cache")
    var paths: [text] = []
    var sources: [text] = []
    var mirrors: [Option<text>] = []
    var cache_keys: [SspecPairCacheKey] = []
    var parse_elapsed: i64 = 0
    var mirror_elapsed: i64 = 0
    for spec_path in _scan_paths(path):
        if not file_exists(spec_path):
            return _emit_error(format, "file does not exist: {spec_path}", 3)
        val pair_parse_started = time_now_unix_micros()
        match parse_spipe_file(spec_path):
            case Err(message):
                return _emit_error(format, "cannot parse {spec_path}: {message}", 3)
            case Ok(document):
                parse_elapsed = parse_elapsed +
                    (time_now_unix_micros() - pair_parse_started)
                val source = document.raw_content
                val mirror_started = time_now_unix_micros()
                val mirror = file_read(derive_manual_path(spec_path))
                mirror_elapsed = mirror_elapsed +
                    (time_now_unix_micros() - mirror_started)
                paths.push(spec_path)
                sources.push(source)
                mirrors.push(mirror)
                cache_keys.push(build_sspec_pair_cache_key(spec_path,
                    Some(source), derive_manual_path(spec_path), mirror,
                    "ssdoc-rules/1", configuration_hash, "sspec-maintain/1"))
    if paths.len() == 0:
        return _emit_error(format, "scope contains no *_spec.spl files", 3)
    var human_items: [text] = []
    var json_items: [text] = []
    var sarif_items: [text] = []
    var scores: [i64] = []
    var severities: [i64] = []
    var index: i64 = 0
    var hit_count: i64 = 0
    var miss_count: i64 = 0
    val analysis_started = time_now_unix_micros()
    while index < paths.len():
        val key = cache_keys[index]
        val pair_cache_path = sspec_pair_cache_path(cache_dir, key)
        var cache_hit = false
        var cached_record = SspecCacheRecord(
            schema_version: "", identity: "", effective_score: 0,
            maximum_severity_rank: 0, human_report: "", json_report: "",
            sarif_report: "")
        if cache_enabled and file_exists(pair_cache_path):
            match decode_sspec_cache_record(file_read(pair_cache_path) ?? ""):
                case Ok(record):
                    if sspec_pair_cache_reusable(record, key):
                        cached_record = record
                        cache_hit = true
                case Err(_): ()
        if cache_hit:
            human_items.push(cached_record.human_report)
            json_items.push(cached_record.json_report)
            sarif_items.push(cached_record.sarif_report)
            scores.push(cached_record.effective_score)
            severities.push(cached_record.maximum_severity_rank)
            hit_count = hit_count + 1
        else:
            var report = analyze_sspec_pair_text(paths[index], sources[index],
                mirrors[index])
            report = inspect_sspec_lifecycle_links(report, sources[index])
            report = _filter_report(report, filters)
            report = _apply_baseline(report, baseline)
            match apply_sspec_suppressions(report, suppressions):
                case Err(message): return _emit_error(format, message, 2)
                case Ok(value): report = value
            report.cache_disposition = if cache_enabled: "miss" else: "bypass"
            human_items.push(render_human_report(report))
            json_items.push(render_json_report(report))
            sarif_items.push(render_sarif_results_fragment(report))
            val severity = _maximum_severity_rank(report)
            scores.push(report.score.effective_aggregate)
            severities.push(severity)
            miss_count = miss_count + 1
            if cache_enabled:
                var hit_report = report
                hit_report.cache_disposition = "hit"
                val record = SspecCacheRecord(
                    schema_version: "sspec-maintain-cache/v1",
                    identity: key.identity,
                    effective_score: hit_report.score.effective_aggregate,
                    maximum_severity_rank: severity,
                    human_report: render_human_report(hit_report),
                    json_report: render_json_report(hit_report),
                    sarif_report: render_sarif_results_fragment(hit_report))
                if dir_create_all(cache_dir):
                    val _ = file_atomic_write(pair_cache_path,
                        encode_sspec_cache_record(record))
        index = index + 1
    val analysis_elapsed = time_now_unix_micros() - analysis_started
    val render_started = time_now_unix_micros()
    val rendered_output = _render_scan_fragments(human_items, json_items,
        sarif_items, format)
    val render_elapsed = time_now_unix_micros() - render_started
    print rendered_output
    if _sspec_maintain_has_arg(args, "--debug-timings"):
        var cache_disposition = "partial"
        if not cache_enabled: cache_disposition = "bypass"
        elif miss_count == 0: cache_disposition = "hit"
        elif hit_count == 0: cache_disposition = "miss"
        _cli_eprint("sspec-maintain timings cache={cache_disposition} hits={hit_count} misses={miss_count} parse_us={parse_elapsed} mirror_lookup_us={mirror_elapsed} rules_score_us={analysis_elapsed} render_us={render_elapsed} total_us={time_now_unix_micros() - scan_started} files={paths.len()}")
    index = 0
    while index < scores.len():
        if (min_score >= 0 and scores[index] < min_score) or
                (_severity_rank(deny) > 0 and severities[index] >= _severity_rank(deny)):
            return 1
        index = index + 1
    0

fn _run_improve(path: text, args: [text]) -> i64:
    val improve_started = time_now_unix_micros()
    val preview_started = time_now_unix_micros()
    val paths = _scan_paths(path)
    if paths.len() == 0:
        _cli_eprint("sspec-maintain: scope contains no *_spec.spl files")
        return 3
    if paths.len() > 1 and _option(args, "--rollback", "") != "":
        _cli_eprint("sspec-maintain: --rollback names one file and cannot be used for a directory scope")
        return 2
    var preview_hashes: [text] = []
    var changed_flags: [bool] = []
    var previews: [text] = []
    for spec_path in paths:
        val source = match _read(spec_path):
            case Err(message):
                _cli_eprint("sspec-maintain: {message}")
                return 3
            case Ok(value): value
        val change = match preview_sspec_text_result(spec_path, source):
            case Err(message):
                _cli_eprint("sspec-maintain: EasyFix conflict in {spec_path}: {message}")
                return 4
            case Ok(value): value
        preview_hashes.push(sha256_text(source))
        changed_flags.push(change.changed)
        previews.push("=== {spec_path} ===\n" +
            render_sspec_improvement_preview(spec_path, source, change,
                safe_sspec_easyfixes(spec_path, source)))
    val preview_elapsed = time_now_unix_micros() - preview_started
    if not _sspec_maintain_has_arg(args, "--apply"):
        print previews.join("\n\n")
        if _sspec_maintain_has_arg(args, "--debug-timings"):
            _cli_eprint("sspec-maintain improve timings mode=preview files={paths.len()} preview_us={preview_elapsed} conflict_stale_us=0 reparse_us=0 rollback_write_us=0 total_us={time_now_unix_micros() - improve_started}")
        return 0
    val conflict_started = time_now_unix_micros()
    var index: i64 = 0
    while index < paths.len():
        val current = match _read(paths[index]):
            case Err(message):
                _cli_eprint("sspec-maintain: {message}")
                return 3
            case Ok(value): value
        val preview_hash = preview_hashes[index]
        val current_hash = sha256_text(current)
        if preview_hash != current_hash:
            _cli_eprint("sspec-maintain: source changed after preview; refusing stale edits: {paths[index]} preview_sha256={preview_hash} current_sha256={current_hash}")
            return 4
        index = index + 1
    val conflict_elapsed = time_now_unix_micros() - conflict_started
    val reparse_started = time_now_unix_micros()
    index = 0
    while index < paths.len():
        val validation_source = match _read(paths[index]):
            case Err(message):
                _cli_eprint("sspec-maintain: {message}")
                return 3
            case Ok(value): value
        val validation_change = match preview_sspec_text_result(paths[index],
                validation_source):
            case Err(message):
                _cli_eprint("sspec-maintain: EasyFix conflict in {paths[index]}: {message}")
                return 4
            case Ok(value): value
        if validation_change.changed:
            val validation_path = paths[index] + ".sspec-maintain.validate.spl"
            if not file_atomic_write(validation_path, validation_change.content):
                _cli_eprint("sspec-maintain: cannot write isolated validation input")
                return 3
            val validation = parse_spipe_file(validation_path)
            val validation_removed = file_delete(validation_path)
            if not validation_removed:
                _cli_eprint("sspec-maintain: warning: cannot remove {validation_path}")
            match validation:
                case Err(message):
                    _cli_eprint("sspec-maintain: proposed SSpec failed canonical reparse for {paths[index]}: {message}")
                    return 4
                case Ok(_): ()
        index = index + 1
    val reparse_elapsed = time_now_unix_micros() - reparse_started
    val write_started = time_now_unix_micros()
    var changed_count: i64 = 0
    var rollback_paths: [text] = []
    index = 0
    while index < paths.len():
        val original = match _read(paths[index]):
            case Err(message):
                _cli_eprint("sspec-maintain: {message}")
                return 3
            case Ok(value): value
        val rollback_change = match preview_sspec_text_result(paths[index], original):
            case Err(message):
                _cli_eprint("sspec-maintain: EasyFix conflict in {paths[index]}: {message}")
                return 4
            case Ok(value): value
        if rollback_change.changed:
            val rollback = if paths.len() == 1:
                _option(args, "--rollback", paths[index] + ".sspec-maintain.rollback")
            else:
                paths[index] + ".sspec-maintain.rollback"
            var fix_ids: [text] = []
            for fix in safe_sspec_easyfixes(paths[index],
                    original):
                fix_ids.push(easyfix_id(fix))
            val rollback_material = "sspec-maintain-rollback/v1\npath: {paths[index]}\nbefore_sha256: {sha256_text(original)}\nafter_sha256: {sha256_text(rollback_change.content)}\nrules: {fix_ids.join(",")}\n--- original source ---\n{original}"
            if not file_atomic_write(rollback, rollback_material):
                _cli_eprint("sspec-maintain: cannot write rollback material: {rollback}")
                return 3
            rollback_paths.push(rollback)
        else:
            rollback_paths.push("")
        index = index + 1
    index = 0
    while index < paths.len():
        val write_source = match _read(paths[index]):
            case Err(message):
                _cli_eprint("sspec-maintain: {message}")
                return 3
            case Ok(value): value
        val write_change = match preview_sspec_text_result(paths[index], write_source):
            case Err(message):
                _cli_eprint("sspec-maintain: EasyFix conflict in {paths[index]}: {message}")
                return 4
            case Ok(value): value
        if write_change.changed:
            if not file_atomic_write(paths[index], write_change.content):
                var restore_index: i64 = 0
                var restored = true
                while restore_index < index:
                    if changed_flags[restore_index]:
                        val restore_source = match _rollback_original_source(
                                rollback_paths[restore_index]):
                            case Err(_):
                                restored = false
                                ""
                            case Ok(value): value
                        if restore_source == "":
                            restored = false
                        elif not file_atomic_write(paths[restore_index],
                                restore_source):
                            restored = false
                    restore_index = restore_index + 1
                if restored:
                    _cli_eprint("sspec-maintain: cannot apply atomic change: {paths[index]}; earlier sources restored")
                else:
                    _cli_eprint("sspec-maintain: cannot apply atomic change: {paths[index]}; rollback artifacts retained for manual recovery")
                return 3
            _cli_eprint("sspec-maintain: applied safe changes to {paths[index]}; rollback: {rollback_paths[index]}")
            changed_count = changed_count + 1
        index = index + 1
    if changed_count == 0:
        _cli_eprint("sspec-maintain: no safe changes")
    val write_elapsed = time_now_unix_micros() - write_started
    if _sspec_maintain_has_arg(args, "--debug-timings"):
        _cli_eprint("sspec-maintain improve timings mode=apply files={paths.len()} changed={changed_count} preview_us={preview_elapsed} conflict_stale_us={conflict_elapsed} reparse_us={reparse_elapsed} rollback_write_us={write_elapsed} total_us={time_now_unix_micros() - improve_started}")
    0

fn _run_scaffold(path: text, args: [text]) -> i64:
    match _read(path):
        case Err(message):
            _cli_eprint("sspec-maintain: {message}")
            3
        case Ok(reference):
            val output = _option(args, "--output", "")
            val content = scaffold_reference_text(path, reference)
            if not _sspec_maintain_has_arg(args, "--apply") or _sspec_maintain_has_arg(args, "--preview"):
                print content
                return 0
            if output == "":
                _cli_eprint("sspec-maintain: scaffold --apply requires --output")
                return 2
            if file_exists(output) and not _sspec_maintain_has_arg(args, "--overwrite"):
                _cli_eprint("sspec-maintain: output exists; use --apply --overwrite")
                return 3
            if file_atomic_write(output, content): 0 else: 3

fn _manual_relative_path(path: text) -> text:
    val canonical = derive_manual_path(path)
    val prefix = "doc/06_spec/"
    if canonical.starts_with(prefix): canonical[prefix.len():] else: canonical

fn _run_documentize(path: text, args: [text]) -> i64:
    match _read(path):
        case Err(message):
            _cli_eprint("sspec-maintain: {message}")
            3
        case Ok(source):
            val output = _option(args, "--output", derive_manual_path(path))
            val staging_root = "build/sspec-maintain/documentize/" +
                sha256_text(path + "\n" + source)
            dir_remove(staging_root, true)
            val generated = run_spipe_docgen([path, "--output", staging_root,
                "--no-index"])
            if generated != 0:
                dir_remove(staging_root, true)
                _cli_eprint("sspec-maintain: SPipe manual generation failed")
                return 3
            val staged_path = staging_root + "/" + _manual_relative_path(path)
            val spipe_manual = file_read(staged_path) ?? ""
            if spipe_manual == "":
                dir_remove(staging_root, true)
                _cli_eprint("sspec-maintain: canonical SPipe manual was not produced at {staged_path}")
                return 3
            dir_remove(staging_root, true)
            val result = compose_sspec_documentized_manual(path, source,
                spipe_manual, not _sspec_maintain_has_arg(args, "--no-scorecard"))
            val content = result.content
            val wrote = file_atomic_write(output, content)
            if wrote:
                _cli_eprint("sspec-maintain: wrote {output}")
                0
            else:
                _cli_eprint("sspec-maintain: cannot write {output}")
                3

fn run_sspec_maintain(args: [text]) -> i64:
    if args.len() == 0 or _sspec_maintain_has_arg(args, "--help") or _sspec_maintain_has_arg(args, "-h"):
        _usage()
        return 0
    if args.len() < 2:
        _cli_eprint("sspec-maintain: operation and path are required")
        return 2
    val operation = args[0]
    val path = args[1]
    if operation == "scan": return _run_scan(path, args)
    if operation == "improve": return _run_improve(path, args)
    if operation == "scaffold": return _run_scaffold(path, args)
    if operation == "documentize": return _run_documentize(path, args)
    _cli_eprint("sspec-maintain: unknown operation '{operation}'")
    2

fn main() -> i64:
    run_sspec_maintain(get_cli_args())
