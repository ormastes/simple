# REQ-007: preview-first confirmed improvement using EasyFix metadata.
use app.sspec_maintain.model.{SspecImprovement}
use std.tooling.easy_fix.types.{EasyFix, Replacement, FixConfidence}

fn _professional_header() -> text:
    "\"\"\"\n## Purpose and audience\n\nTODO: describe the operator and intended outcome.\n\n## Preconditions\n\nTODO: describe required setup.\n\n## Evidence and provenance\n\nEvidence is produced by the executable scenarios below.\n\n## Compatibility and limitations\n\nTODO: record supported surfaces and known limits.\n\"\"\"\n"

fn professional_header_easyfix(path: text) -> EasyFix:
    var fix = EasyFix.create("SSDOC-SAFE-001",
        "Insert the missing professional manual section skeleton", FixConfidence.Certain)
    fix.add_replacement(Replacement.create(path, 0, 0, 1, 1, _professional_header()))
    fix

fn preview_sspec_text(path: text, source: text) -> SspecImprovement:
    if source.contains("## Purpose and audience"):
        return SspecImprovement(content: source, changed: false, rollback_content: source)
    val _ = professional_header_easyfix(path)
    SspecImprovement(content: _professional_header() + source, changed: true,
        rollback_content: source)

fn apply_sspec_text(path: text, source: text) -> SspecImprovement:
    preview_sspec_text(path, source)
