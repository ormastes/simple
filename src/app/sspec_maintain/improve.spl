# REQ-SSDOC-007: preview-first confirmed improvement through canonical EasyFix.
use app.sspec_maintain.model.{SspecImprovement}
use std.tooling.easy_fix.{EasyFix, Replacement, FixConfidence, FixApplicator}
use std.tooling.easy_fix.rules_helpers.{line_start_offset, line_end_offset}
use std.crypto.sha256.{sha256_text}

fn _professional_header() -> text:
    "\"\"\"\n## Purpose and audience\n\nTODO: author purpose and audience.\n\n## Preconditions\n\nTODO: author required setup.\n\n## Evidence and provenance\n\nTODO: identify executable evidence.\n\n## Compatibility and limitations\n\nTODO: state supported surfaces and limits.\n\"\"\"\n"

# Narrative creation is exposed only as an uncertain suggestion. It is never
# included in the mechanical safe-fix set and never raises a score by itself.
fn professional_header_easyfix(path: text) -> EasyFix:
    var fix = EasyFix.create("SSDOC-SUGGEST-001",
        "Draft professional manual sections for author review",
        FixConfidence.Uncertain)
    fix.add_replacement(Replacement.create(path, 0, 0, 1, 1,
        _professional_header()))
    fix

fn _step_fix(path: text, source: text, line: text, line_number: i64) -> EasyFix:
    val trimmed = line.trim()
    val indent = line[:line.len() - trimmed.len()]
    val label = trimmed[7:trimmed.len() - 1]
    var fix = EasyFix.create("SSDOC-MNT-003",
        "Convert invalid bare @step syntax to supported folded metadata",
        FixConfidence.Certain)
    fix.add_replacement(Replacement.create(path,
        line_start_offset(source, line_number),
        line_end_offset(source, line_number), line_number, 1,
        indent + "# @step: " + label))
    fix

fn _import_fix(path: text, source: text, line: text, line_number: i64) -> EasyFix:
    val trimmed = line.trim()
    val indent = line[:line.len() - trimmed.len()]
    var fix = EasyFix.create("SSDOC-MNT-006",
        "Use the canonical SSpec import", FixConfidence.Certain)
    fix.add_replacement(Replacement.create(path,
        line_start_offset(source, line_number),
        line_end_offset(source, line_number), line_number, 1,
        indent + "use std.spec.*"))
    fix

fn safe_sspec_easyfixes(path: text, source: text) -> [EasyFix]:
    """Return only deterministic mechanical fixes; O(lines)."""
    var fixes: [EasyFix] = []
    var line_number: i64 = 0
    for line in source.split("\n"):
        line_number = line_number + 1
        val trimmed = line.trim()
        if trimmed.starts_with("@step \"") and trimmed.ends_with("\"") and
                trimmed.len() > 8:
            fixes.push(_step_fix(path, source, line, line_number))
        elif trimmed == "use std.spipe":
            fixes.push(_import_fix(path, source, line, line_number))
    fixes

fn apply_sspec_easyfixes_result(path: text, source: text,
        fixes: [EasyFix]) -> Result<text, text>:
    if fixes.len() == 0:
        return Ok(source)
    var sources: Dict<text, text> = {}
    sources[path] = source
    match FixApplicator.apply(fixes, sources):
        case Err(message): Err(message)
        case Ok(updated):
            if not updated.has(path):
                return Err("EasyFix did not return the requested source")
            Ok(updated[path])

fn sspec_source_is_stale(original: text, current: text) -> bool:
    original != current

fn preview_sspec_text_result(path: text, source: text) -> Result<SspecImprovement, text>:
    val fixes = safe_sspec_easyfixes(path, source)
    match apply_sspec_easyfixes_result(path, source, fixes):
        case Err(message): Err(message)
        case Ok(content): Ok(SspecImprovement(content: content,
            changed: content != source, rollback_content: source))

fn render_sspec_improvement_preview(path: text, source: text,
        change: SspecImprovement, fixes: [EasyFix]) -> text:
    """Render deterministic reviewed replacements and resulting content; O(fixes+bytes)."""
    var lines = ["SSpec maintenance preview", "path: {path}",
        "before_sha256: {sha256_text(source)}",
        "after_sha256: {sha256_text(change.content)}",
        "changed: {change.changed}"]
    for fix in fixes:
        lines.push("fix {fix.id} [{fix.confidence_str()}]: {fix.description}")
        for replacement in fix.replacements:
            lines.push("  line {replacement.line}, bytes {replacement.start}..{replacement.end} -> {replacement.new_text}")
    lines.push("--- proposed source ---")
    lines.push(change.content)
    lines.join("\n")

fn preview_sspec_text(path: text, source: text) -> SspecImprovement:
    match preview_sspec_text_result(path, source):
        case Ok(change): change
        case Err(_): SspecImprovement(content: source, changed: false,
            rollback_content: source)

fn apply_sspec_text_result(path: text, source: text) -> Result<SspecImprovement, text>:
    preview_sspec_text_result(path, source)

fn apply_sspec_text(path: text, source: text) -> SspecImprovement:
    preview_sspec_text(path, source)
