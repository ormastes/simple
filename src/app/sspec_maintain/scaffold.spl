# REQ-SSDOC-008: source-preserving Markdown requirement scaffold.
use std.crypto.sha256.{sha256_text}

struct ReferenceRequirement:
    requirement_id: text
    title: text
    source_line: i64
    preconditions: [text]
    actions: [text]
    outcomes: [text]
    examples: [text]
    capture_named: bool

fn _simple_literal(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"")

fn _clean_requirement_id(word: text) -> text:
    var value = word.trim()
    while value.len() > 0 and ":,.;)]}".contains(value[-1:]):
        value = value[:-1]
    if value.starts_with("REQ-"):
        return value
    ""

fn _heading_requirement_id(line: text) -> text:
    if not line.trim().starts_with("#"):
        return ""
    for word in line.replace("#", " ").split():
        val requirement_id = _clean_requirement_id(word)
        if requirement_id != "":
            return requirement_id
    ""

fn _heading_title(line: text, requirement_id: text) -> text:
    var title = line.replace("#", " ").trim()
    title = title.replace(requirement_id, "").trim()
    while title.starts_with(":") or title.starts_with("-"):
        title = title[1:].trim()
    if title == "": requirement_id + " behavior" else: title

fn _after_label(line: text) -> text:
    val colon = line.find(":")
    if colon < 0:
        return ""
    line[colon + 1:].trim()

fn _names_capture(line: text) -> bool:
    val lower = line.lower()
    lower.contains("screenshot") or lower.contains("image") or
        lower.contains("visible") or lower.contains("protocol") or
        lower.contains("packet") or lower.contains("log") or
        lower.contains("trace")

fn _extract_reference_requirements(reference: text) -> [ReferenceRequirement]:
    var requirements: [ReferenceRequirement] = []
    var active_id = ""
    var active_title = ""
    var active_line: i64 = 0
    var preconditions: [text] = []
    var actions: [text] = []
    var outcomes: [text] = []
    var examples: [text] = []
    var capture_named = false
    var line_number: i64 = 0

    for line in reference.split("\n"):
        line_number = line_number + 1
        val requirement_id = _heading_requirement_id(line)
        if requirement_id != "":
            if active_id != "":
                requirements.push(ReferenceRequirement(requirement_id: active_id,
                    title: active_title, source_line: active_line,
                    preconditions: preconditions, actions: actions,
                    outcomes: outcomes, examples: examples,
                    capture_named: capture_named))
            active_id = requirement_id
            active_title = _heading_title(line, requirement_id)
            active_line = line_number
            preconditions = []
            actions = []
            outcomes = []
            examples = []
            capture_named = false
        elif active_id != "":
            val trimmed = line.trim()
            val lower = trimmed.lower()
            if lower.starts_with("precondition:") or lower.starts_with("given:"):
                val value = _after_label(trimmed)
                if value != "": preconditions.push(value)
            elif lower.starts_with("action:") or lower.starts_with("when:"):
                val value = _after_label(trimmed)
                if value != "": actions.push(value)
            elif lower.starts_with("expected:") or lower.starts_with("outcome:") or
                    lower.starts_with("then:"):
                val value = _after_label(trimmed)
                if value != "": outcomes.push(value)
            elif lower.starts_with("example:"):
                val value = _after_label(trimmed)
                if value != "": examples.push(value)
            elif lower.contains(" shall ") or lower.contains(" must ") or
                    lower.starts_with("shall ") or lower.starts_with("must "):
                outcomes.push(trimmed)
            elif trimmed.starts_with("|") and trimmed.ends_with("|") and
                    not trimmed.contains("---"):
                val cells = trimmed[1:-1].split("|")
                if cells.len() > 1:
                    val label = cells[0].trim().lower()
                    val value = cells[1].trim()
                    if (label == "given" or label == "precondition") and value != "":
                        preconditions.push(value)
                    elif (label == "when" or label == "action") and value != "":
                        actions.push(value)
                    elif (label == "then" or label == "expected" or label == "outcome") and value != "":
                        outcomes.push(value)
                    elif label == "example" and value != "":
                        examples.push(value)
            if _names_capture(trimmed): capture_named = true

    if active_id != "":
        requirements.push(ReferenceRequirement(requirement_id: active_id,
            title: active_title, source_line: active_line,
            preconditions: preconditions, actions: actions, outcomes: outcomes,
            examples: examples, capture_named: capture_named))
    requirements

fn _render_requirement_scenario(requirement: ReferenceRequirement) -> text:
    var lines: [text] = []
    lines.push("    it \"{_simple_literal(requirement.title)}\":")
    lines.push("        # @req: {requirement.requirement_id}")
    lines.push("        # @source-line: {requirement.source_line}")
    for precondition in requirement.preconditions:
        lines.push("        step(\"Given {_simple_literal(precondition)}\")")
    for action in requirement.actions:
        lines.push("        step(\"{_simple_literal(action)}\")")
    if requirement.preconditions.len() == 0 and requirement.actions.len() == 0:
        lines.push("        step(\"Review unresolved action for {requirement.requirement_id}\")")
    for example in requirement.examples:
        lines.push("        # Example: {_simple_literal(example)}")
    for outcome in requirement.outcomes:
        lines.push("        # Expected: {_simple_literal(outcome)}")
    if requirement.capture_named:
        lines.push("        # @capture: TODO source-named visible evidence")
    lines.push("        fail(\"TODO: replace generated placeholder with an executable assertion\")")
    lines.join("\n")

fn scaffold_reference_text(path: text, reference: text) -> text:
    val requirements = _extract_reference_requirements(reference)
    val source_hash = sha256_text(reference)
    var lines = [
        "# Generated from {path}",
        "# Reference SHA-256: {source_hash}",
        "# Deterministic review scaffold; unresolved bindings fail closed.",
        "\"\"\"",
        "## Purpose and audience",
        "",
        "Review and bind executable behavior to the referenced specification.",
        "",
        "## Preconditions",
        "",
        "The pinned reference and source mapping below are available for review.",
        "",
        "## Operator workflow",
        "",
        "Review each source-mapped scenario, implement its production action and oracle, then remove the failing placeholder.",
        "",
        "## Scenario narratives",
        "",
        "Each generated scenario preserves only explicit reference facts; no behavior is inferred.",
        "",
        "## Evidence and provenance",
        "",
        "Source: `{path}`; SHA-256: `{source_hash}`.",
        "",
        "## Compatibility and limitations",
        "",
        "Generated cases fail until an explicit production oracle is implemented.",
        "",
        "## Recovery and troubleshooting",
        "",
        "If extraction is incomplete, retain the source hash and edit the scaffold only after reviewing the cited source line.",
        "\"\"\"",
        "use std.spec.*",
        "",
        "describe \"reference specification\":"
    ]
    if requirements.len() == 0:
        lines.push("    it \"requires requirement mapping review\":")
        lines.push("        step(\"Identify stable requirement headings in the reference\")")
        lines.push("        fail(\"TODO: replace generated placeholder with an executable assertion\")")
    else:
        for requirement in requirements:
            lines.push(_render_requirement_scenario(requirement))
            lines.push("")
    lines.push("# Source-to-scenario mapping summary")
    for requirement in requirements:
        lines.push("# {requirement.requirement_id} <- {path}:{requirement.source_line}")
    lines.join("\n").trim() + "\n"
