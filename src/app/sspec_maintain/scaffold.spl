# REQ-008: reference Markdown to traceable fail-fast modern SSpec.
use std.crypto.sha256.{sha256_text}

fn _reference_ids(reference: text) -> [text]:
    var ids: [text] = []
    for word in reference.replace("#", " ").replace(":", " ").split():
        if word.starts_with("REQ-") and not ids.contains(word):
            ids.push(word)
    ids

fn scaffold_reference_text(path: text, reference: text) -> text:
    val ids = _reference_ids(reference)
    var body = "# Generated from {path}\n# Reference SHA-256: {sha256_text(reference)}\nuse std.spec.*\n\ndescribe \"reference specification\":\n"
    if ids.len() == 0:
        body = body + "    it \"TODO unresolved reference behavior\":\n        fail(\"TODO: replace generated placeholder with an executable assertion\")\n"
    else:
        for req_id in ids:
            body = body + "    # {req_id}\n    it \"{req_id} behavior\":\n        step(\"Exercise {req_id}\")\n        fail(\"TODO: replace generated placeholder with an executable assertion\")\n"
    body
