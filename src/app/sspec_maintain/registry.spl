# Combined detector-registry coverage accessor. Kept in its own file (rather
# than analyzer.spl or lifecycle.spl) because analyzer.spl's registry and
# lifecycle.spl's filesystem-backed detector are independent modules and
# lifecycle.spl already imports analyzer.spl — importing analyzer.spl from
# lifecycle.spl the other way round would be circular.
use app.sspec_maintain.analyzer.{sspec_own_detector_rule_ids}
use app.sspec_maintain.lifecycle.{sspec_lifecycle_detector_rule_ids}

fn sspec_detector_rule_ids() -> [text]:
    """Union of every registered detector's rule_id across both the
    source/manual registry (analyzer.spl) and the repo-backed lifecycle
    detector (lifecycle.spl), deduplicated. Coverage parity against
    sspec_rule_definitions() is asserted by
    test/01_unit/app/sspec_maintain/detector_registry_coverage_spec.spl."""
    var ids: [text] = []
    for rule_id in sspec_own_detector_rule_ids():
        if not ids.contains(rule_id): ids.push(rule_id)
    for rule_id in sspec_lifecycle_detector_rule_ids():
        if not ids.contains(rule_id): ids.push(rule_id)
    ids
