use std.crypto.sha256.{sha256_text}

fn sspec_cache_identity(path: text, source: text, mirror_identity: text,
        rules_identity: text, config_identity: text, tool_identity: text) -> text:
    sha256_text(path + "\n" + sha256_text(source) + "\n" + mirror_identity +
        "\n" + rules_identity + "\n" + config_identity + "\n" + tool_identity)

fn sspec_finding_baseline_state(fingerprint: text, previous: [text]) -> text:
    if previous.contains(fingerprint): "unchanged" else: "new"

fn sspec_resolved_fingerprints(active: [text], previous: [text]) -> [text]:
    var resolved: [text] = []
    for fingerprint in previous:
        if not active.contains(fingerprint):
            resolved.push(fingerprint)
    resolved
