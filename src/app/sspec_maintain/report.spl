# Deterministic human, JSON, and SARIF renderers over one report model.
use app.sspec_maintain.model.*
use app.sspec_maintain.rules.{sspec_rule_definitions}
use std.common.text_advanced.{escape_json}

fn _json_bool(value: bool) -> text:
    if value: "true" else: "false"

fn _sarif_level(severity: text) -> text:
    if severity == "blocker" or severity == "error": return "error"
    if severity == "warning": return "warning"
    "note"

fn _json_fix(finding: SspecDocumentizationFinding) -> text:
    match finding.easy_fix:
        case Some(fix):
            var replacements: [text] = []
            for replacement in fix.replacements:
                replacements.push("{\"path\":\"{escape_json(replacement.file)}\",\"start\":{replacement.start},\"end\":{replacement.end},\"line\":{replacement.line},\"column\":{replacement.column},\"new_text\":\"{escape_json(replacement.new_text)}\"}")
            "{\"id\":\"{escape_json(fix.id)}\",\"description\":\"{escape_json(fix.description)}\",\"confidence\":\"{fix.confidence_str()}\",\"replacements\":[{replacements.join(",")}]}"
        case None:
            "null"

fn _json_finding(finding: SspecDocumentizationFinding) -> text:
    "{\"rule_id\":\"{escape_json(finding.rule_id)}\",\"dimension\":\"{escape_json(finding.dimension)}\",\"severity\":\"{escape_json(finding.severity)}\",\"confidence\":\"{escape_json(finding.confidence)}\",\"location\":{\"path\":\"{escape_json(finding.path)}\",\"line\":{finding.line},\"column\":{finding.column},\"end_line\":{finding.end_line},\"end_column\":{finding.end_column}},\"evidence\":\"{escape_json(finding.evidence)}\",\"rationale\":\"{escape_json(finding.rationale)}\",\"remediation\":\"{escape_json(finding.remediation)}\",\"fingerprint\":\"{finding.fingerprint}\",\"baseline_state\":\"{finding.baseline_state}\",\"score_deduction\":{finding.score_deduction},\"blocker\":{_json_bool(finding.blocker)},\"fixable\":{_json_bool(finding.fixable)},\"safe_fix_id\":\"{escape_json(finding.safe_fix_id)}\",\"suppressed\":{_json_bool(finding.suppressed)},\"suppression_owner\":\"{escape_json(finding.suppression_owner)}\",\"suppression_reason\":\"{escape_json(finding.suppression_reason)}\",\"fix\":{_json_fix(finding)}}"

fn _json_score(score: SspecDocumentizationScore) -> text:
    "{\"dimensions\":{\"narrative\":{score.narrative},\"structure\":{score.structure},\"oracle\":{score.oracle},\"traceability\":{score.traceability},\"evidence\":{score.evidence},\"coverage\":{score.coverage},\"maintainability\":{score.maintainability}},\"weights\":{\"narrative\":15,\"structure\":15,\"oracle\":20,\"traceability\":15,\"evidence\":15,\"coverage\":10,\"maintainability\":10},\"raw_aggregate\":{score.raw_aggregate},\"effective_aggregate\":{score.effective_aggregate},\"blocker_count\":{score.blocker_count},\"release_ready\":{_json_bool(score.release_ready)}}"

fn render_human_report(report: SspecDocumentizationReport) -> text:
    var lines = ["SSpec documentization score: {report.score.effective_aggregate}/100",
        "source: {report.source_path}",
        "mirror: {report.mirror_path} ({report.mirror_state})",
        "findings: {report.findings.len()} blockers: {report.score.blocker_count}"]
    lines.push("  narrative={report.score.narrative} structure={report.score.structure} oracle={report.score.oracle}")
    lines.push("  traceability={report.score.traceability} evidence={report.score.evidence} coverage={report.score.coverage} maintainability={report.score.maintainability}")
    lines.push("  cache={report.cache_disposition} suppressed={report.suppressed_count}")
    lines.push("  lint-owned related rules={report.referenced_lint_rule_ids.join(",")}")
    if report.score.raw_aggregate != report.score.effective_aggregate:
        lines.push("  raw={report.score.raw_aggregate}; blocker cap makes effective={report.score.effective_aggregate}")
    for finding in report.findings:
        lines.push("{finding.path}:{finding.line}:{finding.column}: {finding.severity} {finding.rule_id} [{finding.dimension}] (-{finding.score_deduction}): {finding.evidence}")
        lines.push("  why: {finding.rationale}")
        lines.push("  improve: {finding.remediation}")
        if finding.fixable: lines.push("  safe fix: {finding.safe_fix_id}")
        if finding.suppressed:
            lines.push("  suppressed by {finding.suppression_owner}: {finding.suppression_reason}")
    lines.join("\n")

fn render_json_report(report: SspecDocumentizationReport) -> text:
    var findings: [text] = []
    for finding in report.findings: findings.push(_json_finding(finding))
    var resolved: [text] = []
    for fingerprint in report.resolved_fingerprints:
        resolved.push("\"{escape_json(fingerprint)}\"")
    var lint_refs: [text] = []
    for rule_id in report.referenced_lint_rule_ids:
        lint_refs.push("\"{escape_json(rule_id)}\"")
    "{\"schema_version\":\"{report.schema_version}\",\"rule_version\":\"{report.rule_version}\",\"tool_version\":\"{report.tool_version}\",\"source\":{\"path\":\"{escape_json(report.source_path)}\",\"sha256\":\"{report.source_hash}\"},\"manual\":{\"path\":\"{escape_json(report.mirror_path)}\",\"sha256\":\"{report.mirror_hash}\",\"state\":\"{report.mirror_state}\"},\"cache_disposition\":\"{report.cache_disposition}\",\"suppressed_count\":{report.suppressed_count},\"related_lint_rule_ids\":[{lint_refs.join(",")}],\"counts\":{\"scenarios\":{report.scenario_count},\"assertions\":{report.assertion_count},\"real_assertions\":{report.real_assertion_count},\"steps\":{report.step_count},\"captures\":{report.capture_count},\"requirements\":{report.requirement_count}},\"score\":{_json_score(report.score)},\"findings\":[{findings.join(",")}],\"resolved_fingerprints\":[{resolved.join(",")}]}"

fn _sarif_rule(rule: SspecRuleDefinition) -> text:
    "{\"id\":\"{rule.rule_id}\",\"name\":\"{escape_json(rule.title)}\",\"shortDescription\":{\"text\":\"{escape_json(rule.detection)}\"},\"fullDescription\":{\"text\":\"{escape_json(rule.rationale)}\"},\"help\":{\"text\":\"False-positive limits: {escape_json(rule.false_positive_limits)} Suppression: {escape_json(rule.suppression_policy)}\"},\"properties\":{\"dimension\":\"{rule.dimension}\",\"deduction\":{rule.deduction},\"blocker\":{_json_bool(rule.blocker)},\"safeEdit\":{_json_bool(rule.safe_edit)}}}"

fn _sarif_fix(finding: SspecDocumentizationFinding) -> text:
    match finding.easy_fix:
        case Some(fix):
            var changes: [text] = []
            for replacement in fix.replacements:
                changes.push("{\"artifactLocation\":{\"uri\":\"{escape_json(replacement.file)}\"},\"replacements\":[{\"deletedRegion\":{\"startLine\":{replacement.line},\"startColumn\":{replacement.column},\"endLine\":{replacement.line},\"endColumn\":{replacement.column + replacement.end - replacement.start}},\"insertedContent\":{\"text\":\"{escape_json(replacement.new_text)}\"}}]}")
            ",\"fixes\":[{\"description\":{\"text\":\"{escape_json(fix.description)}\"},\"artifactChanges\":[{changes.join(",")}]}]"
        case None:
            ""

fn _sarif_result(finding: SspecDocumentizationFinding) -> text:
    "{\"ruleId\":\"{finding.rule_id}\",\"level\":\"{_sarif_level(finding.severity)}\",\"message\":{\"text\":\"{escape_json(finding.evidence)} — {escape_json(finding.remediation)}\"},\"locations\":[{\"physicalLocation\":{\"artifactLocation\":{\"uri\":\"{escape_json(finding.path)}\"},\"region\":{\"startLine\":{finding.line},\"startColumn\":{finding.column},\"endLine\":{finding.end_line},\"endColumn\":{finding.end_column}}}}],\"partialFingerprints\":{\"ssdocFingerprint\":\"{finding.fingerprint}\"},\"baselineState\":\"{finding.baseline_state}\",\"properties\":{\"dimension\":\"{finding.dimension}\",\"scoreDeduction\":{finding.score_deduction},\"blocker\":{_json_bool(finding.blocker)},\"safeFixId\":\"{escape_json(finding.safe_fix_id)}\",\"suppressed\":{_json_bool(finding.suppressed)},\"suppressionOwner\":\"{escape_json(finding.suppression_owner)}\",\"suppressionReason\":\"{escape_json(finding.suppression_reason)}\"}{_sarif_fix(finding)}}"

fn _sarif_from_reports(reports: [SspecDocumentizationReport]) -> text:
    var rules: [text] = []
    for rule in sspec_rule_definitions(): rules.push(_sarif_rule(rule))
    var results: [text] = []
    for report in reports:
        for finding in report.findings: results.push(_sarif_result(finding))
    "{\"version\":\"2.1.0\",\"$schema\":\"https://json.schemastore.org/sarif-2.1.0.json\",\"runs\":[{\"tool\":{\"driver\":{\"name\":\"simple sspec-maintain\",\"version\":\"1\",\"properties\":{\"relatedLintRuleIds\":[\"SPIPE001\",\"SPIPE002\",\"SPIPE003\",\"SPIPE004\",\"SPIPE005\",\"SPIPE006\",\"SPIPE007\"]},\"rules\":[{rules.join(",")}] }},\"results\":[{results.join(",")}] }]}"

fn render_sarif_report(report: SspecDocumentizationReport) -> text:
    _sarif_from_reports([report])

fn render_professional_manual(report: SspecDocumentizationReport) -> text:
    "## Documentization scorecard\n\nRaw: **{report.score.raw_aggregate}/100**; effective: **{report.score.effective_aggregate}/100**; blockers: **{report.score.blocker_count}**.\n\n{render_human_report(report)}\n"

fn render_json_reports(reports: [SspecDocumentizationReport]) -> text:
    var items: [text] = []
    for report in reports: items.push(render_json_report(report))
    "{\"schema_version\":\"sspec-maintain-scope/v1\",\"reports\":[{items.join(",")}]}"

fn render_sarif_reports(reports: [SspecDocumentizationReport]) -> text:
    _sarif_from_reports(reports)
