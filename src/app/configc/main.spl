use std.cli.cli_util.{get_cli_args}
use app.configc.compiler.{compile_composition_file_v1}

fn _configc_help():
    print "Usage: simple-configc <composition.sdn> -o <output.sci>"

fn main() -> i64:
    val args = get_cli_args()
    if args.len() == 0:
        _configc_help()
        return 2
    if args[0] == "help" or args[0] == "--help" or args[0] == "-h":
        _configc_help()
        return 0
    var output = ""
    var i = 1
    while i < args.len():
        if args[i] == "-o" and i + 1 < args.len():
            output = args[i + 1]
            i = i + 1
        elif args[i].starts_with("--output="):
            output = args[i].slice(9, args[i].len())
        i = i + 1
    val result = compile_composition_file_v1(args[0], output)
    if not result.ok:
        print result.code + ": " + result.message
        return 2
    print "configc: wrote " + result.output_path + " (" + result.byte_count.to_text() + " bytes, " + result.composition_digest + ")"
    0
