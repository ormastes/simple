use std.cli.cli_util.{get_cli_args}
use app.configc.compiler.{compile_composition_file_v1,
    compile_composition_extensions_file_v1}

fn _configc_help():
    print "Usage: simple-configc <composition.sdn> [-x <extensions.sdn>] [-g <generation>] -o <output.sci>"

fn main() -> i64:
    val args = get_cli_args()
    if args.len() == 0:
        _configc_help()
        return 2
    if args[0] == "help" or args[0] == "--help" or args[0] == "-h":
        _configc_help()
        return 0
    var output = ""
    var extensions = ""
    var generation = 1
    var i = 1
    while i < args.len():
        if args[i] == "-o" and i + 1 < args.len():
            output = args[i + 1]
            i = i + 1
        elif args[i].starts_with("--output="):
            output = args[i].slice(9, args[i].len())
        elif args[i] == "-x" and i + 1 < args.len():
            extensions = args[i + 1]
            i = i + 1
        elif args[i].starts_with("--extensions="):
            extensions = args[i].slice(13, args[i].len())
        elif args[i] == "-g" and i + 1 < args.len():
            generation = args[i + 1].to_int() ?? 0
            i = i + 1
        i = i + 1
    if extensions != "":
        val extended = compile_composition_extensions_file_v1(
            args[0], extensions, generation, output)
        if not extended.ok:
            print extended.code + ": " + extended.message
            return 2
        print "configc: wrote " + extended.output_path + " (" + extended.byte_count.to_text() + " bytes, config_sha256=" + extended.config_sha256 + ", artifact_sha256=" + extended.artifact_sha256 + ")"
        return 0
    val result = compile_composition_file_v1(args[0], output)
    if not result.ok:
        print result.code + ": " + result.message
        return 2
    print "configc: wrote " + result.output_path + " (" + result.byte_count.to_text() + " bytes, " + result.composition_digest + ")"
    0
