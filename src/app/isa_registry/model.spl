# Registry declarations are not observations of instruction execution.
pub struct IsaAuthority:
    isa: text
    spec_version: text
    snapshot_sha256: text
    operation_ids: [text]

pub struct IsaLimits:
    max_source_bytes: i64
    max_depth: i64
    max_operations: i64
    max_text_bytes: i64
    max_list_items: i64

pub struct IsaOperation:
    id: text
    spec_version: text
    semantic_op: text
    element: text
    shape: text
    required_features: [text]
    lowering: text
    encoder: text
    decoder: text
    fallback: text
    verification: [text]
    reason: text

pub struct IsaRegistry:
    schema: text
    isa: text
    spec_version: text
    source_sha256: text
    operations: [IsaOperation]

pub struct RegistryError:
    code: text
    path: text

pub struct VerificationObligation:
    operation_id: text
    evidence_kind: text
