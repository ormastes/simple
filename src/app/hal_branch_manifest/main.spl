use app.io.mod.{dir_create_all, file_write, get_args}
use app.test_audit.hal_branch_manifest.{
    HAL_BRANCH_SOURCE_MANIFEST_PATH,
    hal_discover_source_inventory,
    hal_render_source_manifest
}

fn main() -> i64:
    val args = get_args()
    var output = HAL_BRANCH_SOURCE_MANIFEST_PATH
    if args.len() > 1:
        val candidate = args[args.len() - 1]
        if candidate != "--":
            output = candidate
    val slash = output.last_index_of("/")
    if slash > 0:
        dir_create_all(output[0:slash])
    val rows = match hal_discover_source_inventory():
        case Err(error):
            print "hal-branch-manifest-error: {error}"
            return 1
        case Ok(value): value
    val manifest = match hal_render_source_manifest(rows):
        case Err(error):
            print "hal-branch-manifest-error: {error}"
            return 1
        case Ok(value): value
    if not file_write(output, manifest):
        print "hal-branch-manifest-error: write-failed:{output}"
        return 1
    print "hal-branch-source-manifest={output}"
    0
