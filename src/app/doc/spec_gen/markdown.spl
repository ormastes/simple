# Spec Generator - Markdown Generation Module
# Generates formatted markdown documentation from parsed specs

use app.io
use app.utils.markdown.{MarkdownBuilder}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use app.doc.spec_gen.types.{SpecFile, TestCase}
use app.doc.spec_gen.semantic_links.{semantic_doc_symbol_map_v1, semantic_doc_symbol_map_from_file_v1}
use compiler.semantics.symbol_id.semantic_link_source.{SemanticLinkDocumentV1, semantic_link_read_revision_v1}
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkErrorV1}


fn generate_markdown(spec: SpecFile, output_path: text) -> bool:
    """Generate Markdown with the existing unbound symbol presentation."""
    generate_markdown_with_symbol_links_v1(spec, output_path, {})

fn generate_markdown_semantic_v1(spec: SpecFile, output_path: text, document: SemanticLinkDocumentV1, revision: text) -> Result<bool, SemanticLinkErrorV1>:
    """Verify explicit spl: symbols as a batch before writing the document.

    The caller owns package/module configuration and an exact source revision;
    heuristic symbol names remain plain text and never acquire guessed targets.
    """
    val links = semantic_doc_symbol_map_v1(spec, document, revision)?
    write_semantic_markdown_v1(spec, output_path, links, document.file, revision)

fn generate_markdown_semantic_from_file_v1(spec: SpecFile, output_path: text, package: text, module_path: text, file: text, revision: text) -> Result<bool, SemanticLinkErrorV1>:
    val links = semantic_doc_symbol_map_from_file_v1(spec, package, module_path, file, revision)?
    write_semantic_markdown_v1(spec, output_path, links, file, revision)

fn write_semantic_markdown_v1(spec: SpecFile, output_path: text, links: Dict<text, text>, source_file: text, revision: text) -> Result<bool, SemanticLinkErrorV1>:
    val content = render_markdown_with_symbol_links_v1(spec, links)
    publish_semantic_markdown_content_v1(content, output_path, source_file, revision)

pub fn publish_semantic_markdown_content_v1(content: text, output_path: text, source_file: text, revision: text) -> Result<bool, SemanticLinkErrorV1>:
    """Publish rendered bytes for an explicit source revision snapshot.

    Recheck after rendering, adjacent to atomic output replacement. This is
    not a cross-file transaction or a lock on arbitrary external source writers;
    the artifact records the exact revision it represents. Callers must resolve
    semantic links before rendering. A later source edit makes that receipt stale.
    """
    if output_path.len() == 0:
        return Ok(false)
    # Existing provider owns same-filesystem staging, complete write/flush,
    # mode preservation, rename, and failed-staging cleanup. Never unlink the
    # previous document before a new verified document can be published.
    val snapshot_content = "<!-- semantic-source-revision-sha256: " + revision + " -->\n" + content
    semantic_link_read_revision_v1(source_file, revision)?
    val written = file_atomic_write(output_path, snapshot_content)
    if written:
        print "✅ Generated: {output_path}"
    Ok(written)

fn generate_markdown_with_symbol_links_v1(spec: SpecFile, output_path: text, links: Dict<text, text>) -> bool:
    val content = render_markdown_with_symbol_links_v1(spec, links)
    if output_path.len() > 0:
        if file_write(output_path, content):
            print "✅ Generated: {output_path}"
            return true
    false

fn render_markdown_with_symbol_links_v1(spec: SpecFile, links: Dict<text, text>) -> text:
    """Render the existing document using a caller-validated symbol map."""
    var md = MarkdownBuilder(content: "")

    # Header
    val title = spec.title()
    md.h1(title)
    md.append("\n")

    # Warning banner
    md.append("> **⚠️ GENERATED FILE** - Do not edit directly!\n")
    md.append("> **Source:** `{spec.path}`\n")
    md.append("> **Generated:** {current_timestamp()}\n")
    md.append(">\n")
    md.append("> To update this file, edit the source _spec.spl file and run:\n")
    md.append("> ```bash\n")
    md.append("> simple doc/spec_gen {spec.path}\n")
    md.append("> ```\n")
    md.append("\n")

    # Metadata
    if spec.metadata.len() > 0:
        for meta in spec.metadata:
            val key = meta.0
            val value = meta.1
            # Skip internal metadata
            if key != "Migrated From" and key != "Source" and key != "Type":
                md.append("**{key}:** {value}\n")
        md.append("\n")

    # Quick navigation TOC
    md.append(generate_quick_toc(spec))

    # Overview from header
    if spec.header_docstring.contains("## Overview"):
        md.h2("Overview")
        md.append("\n")
        val overview = extract_section(spec.header_docstring, "Overview")
        md.append(overview)
        md.append("\n")

    # Related specifications
    if spec.header_docstring.contains("## Related Specifications"):
        md.h2("Related Specifications")
        md.append("\n")
        val related = extract_section(spec.header_docstring, "Related Specifications")
        md.append(related)
        md.append("\n")

    md.append("---\n\n")

    # Symbol table
    val symbol_table = generate_symbol_table_with_links_v1(spec, links)
    if symbol_table.len() > 0:
        md.append(symbol_table)
        md.append("---\n\n")

    # Test cases summary
    if spec.test_cases.len() > 0:
        md.h2("Test Cases ({spec.test_cases.len()} total)")
        md.append("\n")
        md.append("| # | Test | Section | Symbols |\n")
        md.append("|---|------|---------|---------||\n")

        var i = 1
        for tc in spec.test_cases:
            val desc = tc.short_description()
            val symbols_str = format_symbols_with_links_v1(tc.symbols, 3, links)
            md.append("| {i} | [{tc.name}](#{tc.name}) | {tc.section} | {symbols_str} |\n")
            i = i + 1

        md.append("\n")
        md.append("---\n\n")

    # Detailed test cases
    var test_num = 1
    for tc in spec.test_cases:
        md.h3("Test {test_num}: {tc.section} {{#{tc.name}}}")
        md.append("\n")

        if tc.line_number > 0:
            md.append("*Source line: ~{tc.line_number}*\n\n")

        md.append("**Test name:** `{tc.name}`\n\n")

        if tc.docstring.len() > 0:
            md.append("**Description:**\n\n")
            md.append(tc.docstring)
            md.append("\n\n")

        # Linked symbols
        if tc.symbols.len() > 0:
            md.append("**Linked Symbols:**\n")
            val limit = if tc.symbols.len() > 10: 10 else: tc.symbols.len()
            for j in 0..limit:
                md.append("- " + markdown_symbol_v1(tc.symbols[j], links) + "\n")
            if tc.symbols.len() > 10:
                val more = tc.symbols.len() - 10
                md.append("- ... and {more} more\n")
            md.append("\n")

        # Related tests
        if tc.related_tests.len() > 0:
            md.append("**Related Tests:**\n")
            for related in tc.related_tests:
                md.append("- [{related}](#{related})\n")
            md.append("\n")

        # Code
        md.append("**Code:**\n\n")
        md.code_block(tc.code, "simple")
        md.append("\n")

        test_num = test_num + 1

    # Source code section
    md.append("---\n\n")
    md.h2("Source Code")
    md.append("\n")
    md.append("**View full specification:** [{extract_filename(spec.path)}]({spec.path})\n\n")

    # Footer
    md.append("---\n\n")
    md.append("*This file was auto-generated from the executable specification.*\n")
    md.append("*Source: `{spec.path}`*\n\n")

    md.to_string()

fn generate_quick_toc(spec: SpecFile) -> text:
    """Generate quick navigation TOC"""
    if spec.test_cases.len() == 0:
        return ""

    var toc_parts: [text] = []
    toc_parts.push("## Quick Navigation\n\n")

    var i = 1
    for tc in spec.test_cases:
        toc_parts.push("{i}. [{tc.section}](#{tc.name})\n")
        i = i + 1

    toc_parts.push("\n")
    toc_parts.join("")

fn generate_symbol_table(spec: SpecFile) -> text:
    generate_symbol_table_with_links_v1(spec, {})

fn generate_symbol_table_with_links_v1(spec: SpecFile, links: Dict<text, text>) -> text:
    """Generate symbol index table showing which tests use which symbols"""
    # Build symbol -> tests mapping using parallel arrays
    var sym_names = []
    var sym_tests = []

    for tc in spec.test_cases:
        for symbol in tc.symbols:
            # Check if symbol already in map
            var found = false
            var found_idx = 0
            var si = 0
            while si < sym_names.len():
                if sym_names[si] == symbol:
                    found = true
                    found_idx = si
                    si = sym_names.len()
                si = si + 1

            if found:
                sym_tests[found_idx] = sym_tests[found_idx] + [tc.name]
            else:
                sym_names.push(symbol)
                sym_tests.push([tc.name])

    if sym_names.len() == 0:
        return ""

    var table_parts: [text] = []
    table_parts.push("## Symbol Index\n\n")
    table_parts.push("| Symbol | Used in Tests |\n")
    table_parts.push("|--------|---------------|\n")

    var ei = 0
    while ei < sym_names.len():
        val symbol = sym_names[ei]
        val tests = sym_tests[ei]
        val test_links = format_test_links(tests)
        val symbol_text = markdown_symbol_v1(symbol, links)
        table_parts.push("| {symbol_text} | {test_links} |\n")
        ei = ei + 1

    table_parts.push("\n")
    table_parts.join("")

fn extract_section(docstring: text, section_name: text) -> text:
    """Extract content of a section from docstring"""
    val marker = "## {section_name}"
    val start = docstring.find(marker)
    if start < 0:
        return ""

    val after_marker = docstring.substring(start + marker.len(), docstring.len())

    # Find next ## or end of string
    val next_section = after_marker.find("\n##")
    if next_section > 0:
        return after_marker.substring(0, next_section).trim()

    after_marker.trim()

fn markdown_symbol_v1(symbol: text, links: Dict<text, text>) -> text:
    if links.contains_key(symbol):
        return links[symbol]
    "`{symbol}`"

fn format_symbols(symbols: [text], limit: i64) -> text:
    format_symbols_with_links_v1(symbols, limit, {})

fn format_symbols_with_links_v1(symbols: [text], limit: i64, links: Dict<text, text>) -> text:
    """Format symbol list with limit"""
    if symbols.len() == 0:
        return ""

    var parts: [text] = []
    val actual_limit = if symbols.len() < limit: symbols.len() else: limit

    for i in 0..actual_limit:
        parts.push(markdown_symbol_v1(symbols[i], links))

    var result = parts.join(", ")

    if symbols.len() > limit:
        val more = symbols.len() - limit
        result = result + " +{more}"

    result

fn format_test_links(tests: [text]) -> text:
    """Format test names as links"""
    if tests.len() == 0:
        return ""

    var parts: [text] = []
    for i in 0..tests.len():
        parts.push("[{tests[i]}](#{tests[i]})")

    parts.join(", ")

fn extract_filename(path: text) -> text:
    """Extract filename from path"""
    val parts = path.split("/")
    if parts.len() > 0:
        return parts[parts.len() - 1]
    path

fn current_timestamp() -> text:
    """Get current timestamp"""
    val year = timestamp_year()
    val month = timestamp_month()
    val day = timestamp_day()
    val hour = timestamp_hour()
    val minute = timestamp_minute()
    val second = timestamp_second()

    "{year}-{month}-{day} {hour}:{minute}:{second}"
