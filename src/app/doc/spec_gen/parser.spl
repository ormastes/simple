# Spec Generator - Parser Module
# Parses _spec.spl files and extracts test cases

use app.io
use app.doc.spec_gen.types (SpecFile, TestCase)
use app.doc.spec_gen.symbols.{extract_symbols_from_docstring}
use compiler.frontend.core.source_facts.{simple_string_continuation_lines, simple_string_byte_ranges}
use app.spipe_docgen.parser.{count_leading_indent, find_scenario_body_end}
use app.spipe_docgen.common.{spec_kw_line}


fn parse_spec_file(filepath: text, semantic_links: bool = false) -> SpecFile:
    """Parse a _spec.spl file and extract documentation"""
    if not file_exists(filepath):
        return SpecFile(
            path: filepath,
            header_docstring: "",
            metadata: [],
            test_cases: []
        )

    val content = file_read(filepath)

    # Extract header docstring (first """ ... """)
    val header = extract_header_docstring(content)
    val metadata = parse_metadata(header)

    # Extract test cases
    val test_cases = extract_test_cases(content, semantic_links)

    SpecFile(
        path: filepath,
        header_docstring: header,
        metadata: metadata,
        test_cases: test_cases
    )

fn extract_header_docstring(content: text) -> text:
    """Extract first triple-quoted docstring"""
    val start = content.find("\"\"\"")
    if start < 0:
        return ""

    val after_start = content.substring(start + 3, content.len())
    val end = after_start.find("\"\"\"")
    if end < 0:
        return ""

    after_start.substring(0, end).trim()

fn extract_imports(content: text) -> [text]:
    """Extract import statements to identify local symbols"""
    var imports = []
    val lines = content.split("\n")

    for line in lines:
        val trimmed = line.trim()

        # Pattern: import Symbol from module
        if trimmed.starts_with("import ") and trimmed.contains(" from "):
            val parts = trimmed.split(" from ")
            if parts.len() > 0:
                val import_part = parts[0].replace("import ", "").trim()
                if import_part.len() > 0:
                    imports = imports + [import_part]

        # Pattern: from module import Symbol
        if trimmed.starts_with("from ") and trimmed.contains(" import "):
            val parts = trimmed.split(" import ")
            if parts.len() > 1:
                val import_part = parts[1].trim()
                if import_part.len() > 0:
                    imports = imports + [import_part]

    imports

fn parse_metadata(docstring: text) -> [(text, text)]:
    """Parse metadata from docstring header"""
    var metadata = []
    val lines = docstring.split("\n")

    for line in lines:
        # Pattern: **Key:** value
        if line.contains("**") and line.contains(":**"):
            val parts = line.split(":**")
            if parts.len() >= 2:
                val key = parts[0].replace("**", "").trim()
                val value = parts[1].replace("**", "").trim()
                if key.len() > 0:
                    metadata = metadata + [(key, value)]

    metadata

fn extract_modern_semantic_test_cases_v1(lines: [text], continuation: [bool], string_ranges: [[i64]]) -> [TestCase]:
    """Read actual markerless it/test bodies with lexer-owned string boundaries.

    A quoted fixture containing an apparent scenario is not a declaration. Use
    the existing SPipe body-boundary owner, including dedented string payloads.
    Only a leading scenario docstring supplies explicit Links metadata.
    """
    var cases: [TestCase] = []
    var position = 0
    while position < lines.len():
        val trimmed = lines[position].trim()
        if not continuation[position] and (spec_kw_line(trimmed, "it") or spec_kw_line(trimmed, "test")):
            val end = find_scenario_body_end(lines, continuation, position + 1, count_leading_indent(lines[position]))
            var body: [text] = []
            for row in position + 1..end:
                body.push(lines[row])
            var code = body.join("\n")
            var first = position + 1
            while first < end and (lines[first].trim() == "" or lines[first].trim().starts_with("#")):
                first = first + 1
            var docstring = ""
            if first < end and lines[first].trim().starts_with("\"\"\""):
                # `first` is the actual located opener. Quote examples in
                # skipped comments must never open/close metadata. Reuse the
                # lexer's byte ranges, including escaped quotes and comments
                # after a real closing delimiter, rather than searching code.
                var pieces: [text] = []
                var row = first
                var closed = false
                var valid = true
                while row < end:
                    val ranges = string_ranges[row]
                    val expected_start = if row == first: count_leading_indent(lines[row]) else: 0
                    if ranges.len() < 2 or ranges[0] != expected_start:
                        valid = false
                        break
                    val token_end = ranges[1]
                    closed = token_end < lines[row].len() or row + 1 >= lines.len() or not continuation[row + 1]
                    val begin = expected_start + (if row == first: 3 else: 0)
                    val finish = token_end - (if closed: 3 else: 0)
                    if begin < 0 or finish < begin or finish > lines[row].len():
                        valid = false
                        break
                    pieces.push(lines[row].substring(begin, finish))
                    if closed:
                        break
                    row = row + 1
                if valid and closed:
                    docstring = pieces.join("\n").trim()
                else:
                    # Keep the discovered case but refuse its unproven body at
                    # the existing semantic CLI extraction gate. No empty URI
                    # batch may turn a missing token receipt into success.
                    code = ""
            cases.push(TestCase(name: extract_test_name(lines[position]), section: "Scenario", line_number: position + 1,
                docstring: docstring, code: code, symbols: extract_symbols_from_docstring(docstring), related_tests: []))
            position = end
        else:
            position = position + 1
    cases

fn extract_test_cases(content: text, semantic_links: bool = false) -> [TestCase]:
    """Extract all test cases from the file"""
    var cases = []
    val lines = content.split("\n")
    val continuation: [bool] = if semantic_links: simple_string_continuation_lines(content) else: []
    val string_ranges: [[i64]] = if semantic_links: simple_string_byte_ranges(content) else: []
    val modern: [TestCase] = if semantic_links: extract_modern_semantic_test_cases_v1(lines, continuation, string_ranges) else: []

    var i = 0
    while i < lines.len():
        val line = lines[i]

        # Look for ## Test: markers
        if line.trim().starts_with("## Test:") and (not semantic_links or not continuation[i]):
            val section = line.trim().substring(8, line.trim().len()).trim()

            # Extract line number if present
            var line_num = 0
            var clean_section = section
            if section.contains("(Line"):
                # Try to extract number
                val parts = section.split("(Line")
                if parts.len() > 1:
                    val num_part = parts[1].split(")")[0].trim().replace("~", "")
                    line_num = num_part.parse_int().unwrap_or(0)
                    clean_section = parts[0].trim()

            # Look ahead for docstring and code
            var j = i + 1
            var test_docstring = ""
            var test_name = ""
            var test_code_lines = []

            # Skip blank lines, extract docstring
            while j < lines.len():
                val stripped = lines[j].trim()

                if stripped.starts_with("\"\"\""):
                    # Extract multi-line docstring
                    j = j + 1
                    while j < lines.len() and not lines[j].trim().starts_with("\"\"\""):
                        test_docstring = test_docstring + lines[j] + "\n"
                        j = j + 1
                    test_docstring = test_docstring.trim()
                    j = j + 1  # Skip closing """
                    continue

                # Look for test or function definition
                if (not semantic_links or not continuation[j]) and (stripped.starts_with("test \"") or stripped.starts_with("fn ") or (semantic_links and stripped.starts_with("it \""))):
                    test_name = extract_test_name(lines[j])
                    if semantic_links:
                        line_num = j + 1

                    # Extract code until next ## Test: or end
                    val code_start = j
                    j = j + 1
                    while j < lines.len() and (not lines[j].trim().starts_with("## Test:") or (semantic_links and continuation[j])):
                        test_code_lines = test_code_lines + [lines[j]]
                        j = j + 1

                    break

                if stripped == "":
                    j = j + 1
                else:
                    j = j + 1
                    if (j - i) > 20:  # Don't search too far
                        break

            # Create test case if we found code
            if test_name.len() > 0 and test_code_lines.len() > 0:
                val code = test_code_lines.join("\n").trim()
                val tc = TestCase(
                    name: test_name,
                    section: clean_section,
                    line_number: line_num,
                    docstring: test_docstring,
                    code: code,
                    symbols: if semantic_links: extract_symbols_from_docstring(test_docstring) else: [],
                    related_tests: []
                )
                cases = cases + [tc]
                i = j - 1

        i = i + 1

    if semantic_links:
        return merge_semantic_test_cases_v1(cases, modern)
    cases

fn merge_semantic_test_cases_v1(legacy: [TestCase], modern: [TestCase]) -> [TestCase]:
    # Both producers walk source order. Merge by actual declaration line,
    # retaining legacy metadata and modern leading-docstring Links together.
    # No name-only de-duplication can hide a second same-named scenario.
    var merged: [TestCase] = []
    var left = 0
    var right = 0
    while left < legacy.len() or right < modern.len():
        if left < legacy.len() and right < modern.len() and legacy[left].line_number == modern[right].line_number:
            val old = legacy[left]
            val current = modern[right]
            merged.push(TestCase(name: current.name, section: old.section, line_number: current.line_number,
                docstring: old.docstring + "\n" + current.docstring, code: if current.code == "": "" else: old.code,
                symbols: old.symbols.merge(current.symbols), related_tests: old.related_tests))
            left = left + 1
            right = right + 1
        elif right >= modern.len() or (left < legacy.len() and legacy[left].line_number < modern[right].line_number):
            merged.push(legacy[left])
            left = left + 1
        else:
            merged.push(modern[right])
            right = right + 1
    merged

fn extract_test_name(line: text) -> text:
    """Extract test name from test or function definition"""
    val trimmed = line.trim()

    # test "name":
    if trimmed.starts_with("test \"") or trimmed.starts_with("it \""):
        val start = trimmed.find("\"")
        val after = trimmed.substring(start + 1, trimmed.len())
        val end = after.find("\"")
        if end > 0:
            return after.substring(0, end)

    # fn name():
    if trimmed.starts_with("fn "):
        val after_fn = trimmed.substring(3, trimmed.len())
        val paren = after_fn.find("(")
        if paren > 0:
            return after_fn.substring(0, paren).trim()

    "unnamed_test"
