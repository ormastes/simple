# Feature Documentation Generator - Usage Index
#
# Generates INDEX.md for usage (language feature) documentation,
# grouped by category.

use app.io.mod (file_write, dir_create)
use app.feature_doc.types.*

fn generate_usage_index(infos: [FeatureFileInfo], output_dir: text) -> text:
    """Generate INDEX.md for usage docs, grouped by category.

    Returns the output path.
    """
    var fragments: [text] = []
    fragments.push("# Usage Feature Documentation Index\n\n")
    fragments.push("Language feature tests with Cucumber-style documentation.\n\n")

    # Group by category
    var category_to_bucket: {text: i64} = {}
    var category_names: [text] = []
    var category_buckets: [[FeatureFileInfo]] = []
    for info in infos:
        var cat = info.metadata.category
        if cat == "":
            cat = "Uncategorized"
        if category_to_bucket.has(cat):
            val bucket = category_to_bucket[cat]
            category_buckets[bucket].push(info)
        else:
            val bucket = category_buckets.len()
            category_to_bucket[cat] = bucket
            category_names.push(cat)
            category_buckets.push([info])

    # Summary
    fragments.push("**Total features:** {infos.len()}\n\n")
    fragments.push("---\n\n")

    # Generate sections by category
    var category_index = 0
    while category_index < category_names.len():
        val cat_name = category_names[category_index]
        val entries = category_buckets[category_index]
        fragments.push("## {cat_name} ({entries.len()} features)\n\n")
        fragments.push("| Feature | Status | Feature IDs | Details |\n")
        fragments.push("|---------|--------|-------------|---------|\n")

        for info in entries:
            val filename = extract_index_filename(info.file_path)
            val status = if info.metadata.status != "": info.metadata.status else: "N/A"
            val fids = if info.metadata.feature_ids != "": info.metadata.feature_ids else: "-"
            val desc_count = info.describes.len()
            var it_count = 0
            for desc in info.describes:
                for ctx in desc.contexts:
                    it_count = it_count + ctx.its.len()
            fragments.push("| [{info.title}]({filename}.md) | {status} | {fids} | {desc_count} describes, {it_count} tests |\n")

        fragments.push("\n")
        category_index = category_index + 1

    # Write
    val output_path = "{output_dir}/INDEX.md"
    dir_create(output_dir, true)
    file_write(output_path, fragments.join(""))
    output_path

fn extract_index_filename(file_path: text) -> text:
    """Get filename stem from path."""
    val slash = file_path.last_index_of("/")
    val filename = if slash >= 0: file_path.slice(slash + 1) else: file_path
    if filename.ends_with("_spec.spl"):
        return filename[:-9]
    if filename.ends_with(".spl"):
        return filename[:-4]
    filename
