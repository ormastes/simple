# Simple CI orchestration runner — applies the orchestration model to CI.
#
# A `Pipeline` expands into ordinary `Job`s (see
# `std.common.contracts.orchestration.ci_v1`) and this runner executes them in
# dependency order through a runtime provider, producing one receipt per job and
# one per run. There is no second scheduler: the Job path is the only execution
# path (research §12.1).
#
# Honest isolation policy (research §4.1, §4.5, ORCH-006):
# a `native-container` job runs ONLY when the host's container lane probes
# available. When it does not, the job is recorded BLOCKED with the probe's
# reason — it is never silently downgraded to a host process.
#
# Engine preference is podman, then docker, then a bare OCI runtime. Podman is
# the default because it is the only one of the three whose normal mode is
# ROOTLESS, so a CI node does not have to hand a daemon root to run a build.
#
# Two platform facts the engine order must not paper over:
#
#   * Podman on Windows is a Linux VM (`podman machine` -> WSL2/Hyper-V). It has
#     no Windows-container backend and cannot produce a process-isolated Windows
#     container. On Windows the native lane is containerd+runhcs or Docker's
#     Windows-containers backend, and `podman` there is a `virtual-machine`
#     class engine, never `native-container`.
#   * "Rootless" is a Linux property. Windows process isolation requires
#     Administrator, and a FreeBSD jail requires root; neither has a rootless
#     equivalent. `ProbeV1.privilege` records which one this host would use so a
#     receipt never implies an unprivileged container where none exists.

use app.io.mod.{process_run_timeout, file_read, host_os}
use std.common.contracts.orchestration.resource_v1.{RejectionV1, PodSpecV1}
use std.common.contracts.orchestration.ci_v1.{JobV1, PipelineV1, OrderedJobV1,
    expand_pipeline, RUN_POLICY_ALWAYS}
use std.common.contracts.container.runtime_v1.{RuntimeOperationV1,
    RUNTIME_STATUS_OK, RUNTIME_STATUS_BLOCKED, RUNTIME_STATUS_REJECTED,
    runtime_command_empty, runtime_state_empty}
use std.nogc_async_mut.container.providers.linux.oci_runtime_v1.{LinuxOciRuntimeProviderV1,
    LinuxOciRequestV1}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.io_runtime.{dir_remove_all}

pub const VERDICT_PASS = "PASS"
pub const VERDICT_FAIL = "FAIL"
pub const VERDICT_NOT_RUN = "NOT_RUN"
pub const VERDICT_BLOCKED = "BLOCKED"

# Default per-job wall clock bound. A job that outlives it is FAIL, never PASS.
pub const DEFAULT_JOB_TIMEOUT_MS = 60000

# Engine candidates for the native-container lane, in preference order.
pub const ENGINE_PODMAN = "podman"
pub const ENGINE_DOCKER = "docker"
pub const ENGINE_RUNC = "runc"

# How the lane would run, once available. Never inferred from the engine name:
# rootless podman and root-daemon docker are both "podman"/"docker".
pub const PRIVILEGE_ROOTLESS = "rootless"
pub const PRIVILEGE_ROOT = "root"
pub const PRIVILEGE_UNKNOWN = "unknown"

pub struct ProbeV1:
    available: bool
    # "" when no engine qualified.
    engine: text
    privilege: text
    reason: text

pub struct JobReceiptV1:
    job_name: text
    attempt: i64
    runtime_class: text
    verdict: text
    reason: text
    exit_code: i64
    stdout: text
    node_boot_id: text
    native_id: text
    provider_generation: i64
    operation_id: text
    runtime_state_dir: text

pub struct RunReceiptV1:
    run_id: text
    pipeline: text
    verdict: text
    jobs: [JobReceiptV1]

# Node identity, so a receipt can be tied to the boot instance that produced it
# (research §11.3). Empty when the host does not publish one.
pub fn node_boot_id() -> text:
    val raw = file_read("/proc/sys/kernel/random/boot_id") ?? ""
    raw.trim()

fn engine_present(engine: text) -> bool:
    process_run_timeout(engine, ["--version"], 5000).2.to_i64() == 0

# True when this host permits the namespace work a rootless container needs.
#
# This is a POSITIVE probe, not a capability list read: it nests a mount
# namespace inside a user namespace, which is exactly what rootless podman's
# and runc's nsexec do, and exactly what fails where unprivileged user
# namespaces are restricted. Checking `--version` alone reports available on a
# host where every launch fails.
fn userns_nesting() -> (bool, text):
    val ns = process_run_timeout("unshare", ["--user", "--mount", "true"], 5000)
    if ns.2.to_i64() != 0:
        return (false, ns.1.trim())
    (true, "")

# True when a rootless engine can map a range of subordinate ids. Without
# `newuidmap`/`newgidmap` a rootless container is confined to a single id, which
# most images cannot run under.
fn subid_mapping() -> bool:
    engine_present("newuidmap")

# Probe the native-container lane, preferring podman.
#
# Reports the engine it would use AND whether that lane would be rootless or
# root, because those are independent: an available engine says nothing about
# the privilege the launch requires. Windows is refused outright for podman —
# podman there is a Linux VM, not a Windows container (see the module header).
pub fn probe_container_lane() -> ProbeV1:
    val os = host_os()

    if engine_present(ENGINE_PODMAN):
        if os == "windows":
            # Deliberately not "available with a caveat": a VM-backed engine
            # cannot satisfy a native-container request.
            return ProbeV1(available: false, engine: "", privilege: PRIVILEGE_UNKNOWN,
                reason: "podman-on-windows-is-a-vm: podman machine runs a Linux guest and has no " +
                        "Windows-container backend; use containerd+runhcs or docker's Windows backend")
        val nest = userns_nesting()
        if nest.0 and subid_mapping():
            return ProbeV1(available: true, engine: ENGINE_PODMAN, privilege: PRIVILEGE_ROOTLESS,
                reason: "podman present, user+mount namespace nesting permitted, subordinate id mapping available")
        var why = ""
        if not nest.0:
            why = "userns-nesting-denied (" + nest.1 + ")"
        else:
            why = "subordinate-id-mapping-absent (newuidmap/newgidmap missing)"
        return ProbeV1(available: false, engine: "", privilege: PRIVILEGE_UNKNOWN,
            reason: "podman-rootless-unavailable: " + why)

    if engine_present(ENGINE_DOCKER):
        # Docker's engine runs as root and the client needs socket access; a
        # successful `--version` is the CLIENT only, so reach the daemon.
        val info = process_run_timeout(ENGINE_DOCKER, ["info", "--format", "ok"], 15000)
        if info.2.to_i64() != 0:
            return ProbeV1(available: false, engine: "", privilege: PRIVILEGE_UNKNOWN,
                reason: "docker-daemon-unreachable: " + info.1.trim())
        return ProbeV1(available: true, engine: ENGINE_DOCKER, privilege: PRIVILEGE_ROOT,
            reason: "docker daemon reachable; this lane is root-privileged")

    ProbeV1(available: false, engine: "", privilege: PRIVILEGE_UNKNOWN,
        reason: "no-qualified-container-engine: podman or docker did not answer a positive probe")

# "" when this runner can execute the job shape, else why not.
fn job_shape_error(spec: PodSpecV1) -> text:
    if spec.containers.len() != 1:
        return "this runner executes single-container jobs; found " + spec.containers.len().to_text()
    ""

# Execute one job's single container on the host process lane.
fn run_process_job(name: text, spec: PodSpecV1, boot: text) -> JobReceiptV1:
    val c = spec.containers[0]
    var argv: [text] = []
    var i = 1
    while i < c.command.len():
        argv.push(c.command[i])
        i = i + 1
    for a in c.args:
        argv.push(a)
    val res = process_run_timeout(c.command[0], argv, DEFAULT_JOB_TIMEOUT_MS)
    val rc = res.2.to_i64()
    var verdict = VERDICT_FAIL
    var reason = "exit status " + rc.to_text()
    if rc == 0:
        verdict = VERDICT_PASS
        reason = "exited 0"
    JobReceiptV1(job_name: name, attempt: 1, runtime_class: spec.runtime_class,
                 verdict: verdict, reason: reason, exit_code: rc,
                 stdout: res.0, node_boot_id: boot, native_id: "",
                 provider_generation: 0, operation_id: "", runtime_state_dir: "")

fn blocked_receipt(name: text, spec: PodSpecV1, reason: text, boot: text) -> JobReceiptV1:
    JobReceiptV1(job_name: name, attempt: 0, runtime_class: spec.runtime_class,
                 verdict: VERDICT_BLOCKED, reason: reason, exit_code: 0,
                 stdout: "", node_boot_id: boot, native_id: "",
                 provider_generation: 0, operation_id: "", runtime_state_dir: "")

fn not_run_receipt(name: text, spec: PodSpecV1, reason: text, boot: text) -> JobReceiptV1:
    JobReceiptV1(job_name: name, attempt: 0, runtime_class: spec.runtime_class,
                 verdict: VERDICT_NOT_RUN, reason: reason, exit_code: 0,
                 stdout: "", node_boot_id: boot, native_id: "",
                 provider_generation: 0, operation_id: "", runtime_state_dir: "")

fn container_operation_receipt(name: text, spec: PodSpecV1,
        result: RuntimeOperationV1, boot: text, attempt: i64,
        state_dir: text) -> JobReceiptV1:
    val blocked = result.status == RUNTIME_STATUS_BLOCKED
    val verdict = if blocked then VERDICT_BLOCKED else VERDICT_FAIL
    JobReceiptV1(job_name: name, attempt: attempt, runtime_class: spec.runtime_class,
        verdict: verdict, reason: result.reason, exit_code: result.exit_code,
        stdout: result.stdout, node_boot_id: boot,
        native_id: result.state.identity.native_id,
        provider_generation: result.state.identity.provider_generation,
        operation_id: result.state.identity.operation_id,
        runtime_state_dir: state_dir)

fn merge_container_cleanup(primary: RuntimeOperationV1,
        cleanup: RuntimeOperationV1) -> RuntimeOperationV1:
    if cleanup.status == RUNTIME_STATUS_OK: return primary
    var merged = cleanup
    merged.reason = primary.reason + "; cleanup: " + cleanup.reason
    if cleanup.status != RUNTIME_STATUS_BLOCKED:
        merged.status = RUNTIME_STATUS_REJECTED
    merged

fn canonical_runtime_token(value: text) -> text:
    val allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    var out = ""
    var index = 0
    while index < value.len():
        val c = value.substring(index, index + 1)
        if allowed.contains(c): out = out + c
        else: out = out + "-"
        index = index + 1
    if out == "": "run"
    else: out

# Real native-container execution is wired through LinuxOciRuntimeProviderV1. The
# caller has already completed the positive host probe; any provider failure
# remains a receipt failure/block and is never downgraded to native-process.
fn run_container_job(name: text, spec: PodSpecV1, boot: text,
        probe: ProbeV1, run_id: text) -> JobReceiptV1:
    val c = spec.containers[0]
    val journal_root = match secure_temp_dir("/tmp", "simpleorch-"):
        case Ok(path): path
        case Err(_): return blocked_receipt(name, spec,
            "secure-runtime-state-directory-unavailable", boot)
    val provider = LinuxOciRuntimeProviderV1.new("linux", probe.engine, journal_root,
        boot, 1, true, DEFAULT_JOB_TIMEOUT_MS)
    val provider_probe = provider.probe()
    if not provider_probe.launch_capable:
        val unavailable = RuntimeOperationV1(status: RUNTIME_STATUS_BLOCKED,
            operation: "probe", command: runtime_command_empty(),
            state: runtime_state_empty(), exit_code: -1, stdout: "", stderr: "",
            reason: provider_probe.reason)
        return container_operation_receipt(name, spec, unavailable, boot, 0, journal_root)
    val request = LinuxOciRequestV1(pod_uid: "run-" + canonical_runtime_token(run_id) +
        "-" + canonical_runtime_token(name),
        attempt: 1, operation_id: "", image: c.image, bundle_path: "",
        command: c.command, args: c.args, timeout_ms: DEFAULT_JOB_TIMEOUT_MS)
    val prepared = provider.prepare_pod(request)
    if prepared.status != RUNTIME_STATUS_OK:
        return container_operation_receipt(name, spec, prepared, boot, 0, journal_root)
    val created = provider.create(request)
    if created.status != RUNTIME_STATUS_OK:
        if created.state.identity.native_id != "":
            val cleanup = provider.destroy(request, true)
            return container_operation_receipt(name, spec,
                merge_container_cleanup(created, cleanup), boot, 1, journal_root)
        return container_operation_receipt(name, spec, created, boot, 1, journal_root)
    val started = provider.start(request)
    if started.status != RUNTIME_STATUS_OK:
        val cleanup = provider.destroy(request, true)
        return container_operation_receipt(name, spec,
            merge_container_cleanup(started, cleanup), boot, 1, journal_root)
    val waited = provider.wait(request)
    if waited.status != RUNTIME_STATUS_OK:
        val stopped = provider.stop(request)
        val cleanup = provider.destroy(request, true)
        return container_operation_receipt(name, spec,
            merge_container_cleanup(merge_container_cleanup(waited, stopped), cleanup), boot, 1, journal_root)
    val logs = provider.logs(request)
    if logs.status != RUNTIME_STATUS_OK:
        val cleanup = provider.destroy(request, true)
        return container_operation_receipt(name, spec,
            merge_container_cleanup(logs, cleanup), boot, 1, journal_root)
    val destroyed = provider.destroy(request, false)
    if destroyed.status != RUNTIME_STATUS_OK:
        return container_operation_receipt(name, spec, destroyed, boot, 1, journal_root)
    if not dir_remove_all(journal_root):
        var cleanup_failure = destroyed
        cleanup_failure.status = RUNTIME_STATUS_REJECTED
        cleanup_failure.reason = "destroyed; runtime-state-cleanup-failed"
        return container_operation_receipt(name, spec, cleanup_failure, boot, 1, journal_root)
    JobReceiptV1(job_name: name, attempt: 1, runtime_class: spec.runtime_class,
        verdict: if waited.state.exit_code == 0 then VERDICT_PASS else VERDICT_FAIL,
        reason: if waited.state.exit_code == 0 then "exited 0; destroyed" else "exit status " + waited.state.exit_code.to_text() + "; destroyed",
        exit_code: waited.state.exit_code, stdout: logs.stdout, node_boot_id: boot,
        native_id: waited.state.identity.native_id,
        provider_generation: waited.state.identity.provider_generation,
        operation_id: waited.state.identity.operation_id,
        runtime_state_dir: journal_root)

fn verdict_of(name: text, receipts: [JobReceiptV1]) -> text:
    for r in receipts:
        if r.job_name == name:
            return r.verdict
    VERDICT_NOT_RUN

# Run a pipeline end to end. Returns a rejection when the pipeline itself is
# invalid (unresolved reference, cycle); an executed run always returns a
# receipt, including when every job was blocked.
pub fn run_pipeline(p: PipelineV1, templates: Dict<text, JobV1>, run_id: text) -> Result<RunReceiptV1, RejectionV1>:
    var ordered: [OrderedJobV1] = []
    match expand_pipeline(p, templates):
        case Err(r): return Err(r)
        case Ok(o): ordered = o

    val boot = node_boot_id()
    val probe = probe_container_lane()
    var receipts: [JobReceiptV1] = []

    for entry in ordered:
        val name = entry.node.name
        val spec = entry.job.template

        # An upstream failure blocks dependents, while independent jobs continue
        # (research §12.2). `runPolicy: always` runs anyway, for diagnostics.
        var upstream_bad = ""
        for dep in entry.node.run_after:
            val dv = verdict_of(dep, receipts)
            if dv != VERDICT_PASS and upstream_bad == "":
                upstream_bad = dep + " -> " + dv
        if upstream_bad != "" and entry.node.run_policy != RUN_POLICY_ALWAYS:
            receipts.push(not_run_receipt(name, spec, "upstream " + upstream_bad, boot))
            continue

        val shape = job_shape_error(spec)
        if shape != "":
            receipts.push(blocked_receipt(name, spec, "unsupported-job-shape: " + shape, boot))
            continue

        if spec.runtime_class == "native-container":
            if not probe.available:
                receipts.push(blocked_receipt(name, spec, probe.reason, boot))
                continue
            receipts.push(run_container_job(name, spec, boot, probe, run_id))
            continue

        receipts.push(run_process_job(name, spec, boot))

    var run_verdict = VERDICT_PASS
    var any_blocked = false
    for r in receipts:
        if r.verdict == VERDICT_FAIL:
            run_verdict = VERDICT_FAIL
        if r.verdict == VERDICT_BLOCKED:
            any_blocked = true
    if run_verdict != VERDICT_FAIL and any_blocked:
        run_verdict = VERDICT_BLOCKED

    Ok(RunReceiptV1(run_id: run_id, pipeline: p.meta.name,
                    verdict: run_verdict, jobs: receipts))
