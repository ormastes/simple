# codex-impl
# Repository-backed release version authority.  This module reads and plans;
# callers must apply plans through an isolated, approval-gated mutation layer.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_atomic_write, file_hash_sha256}
use app.io.mod.{process_run_bounded}
use app.devhub.version_manifest.{VersionManifest, parse_version_manifest, render_version_manifest}
use app.release.policy.{ReleaseVersion, ReleaseSession, parse_release_version, check_version_channel}
use app.release.session_authority.{begin_release_session_mutation, end_release_session_mutation}

struct CompatibilitySnapshot:
    public_api_major: i64
    compiler_abi: i64
    bootstrap_protocol: i64
    package_format: i64
    scv_store_schema: i64
    scv_wire_protocol: i64
    devhub_provider_api: i64
    spipe_skill_api: i64
    release_manifest_schema: i64
    bootstrap_receipt_schema: i64

struct VersionProjectionEdit:
    path: text
    original_sha256: text
    observed_version: text
    target_version: text
    rendered_content: text
    changed: bool
    valid: bool
    error: text

struct RepositoryVersionReport:
    manifest: VersionManifest
    valid: bool
    reason: text
    projection_paths: [text]
    observed_versions: [text]
    drift: [text]

struct VersionBumpPlan:
    valid: bool
    reason: text
    current_version: text
    target_version: text
    requested_bump: text
    minimum_bump: text
    manifest_content: text
    projection_edits: [VersionProjectionEdit]

struct VersionApplyResult:
    valid: bool
    reason: text
    applied_version: text
    applied_files: [text]
    recovery_required: bool

fn _empty_manifest(reason: text) -> VersionManifest:
    VersionManifest(schema: "", product: "", semver: "", line: "", channel: "", public_api_major: -1, compiler_abi: -1, bootstrap_protocol: -1, package_format: -1, scv_store_schema: -1, scv_wire_protocol: -1, devhub_provider_api: -1, spipe_skill_api: -1, release_manifest_schema: -1, bootstrap_receipt_schema: -1, projections: [], valid: false, error: reason)

fn _root_path(root: text, relative: text) -> text:
    if root == "" or root == ".":
        return relative
    if root.ends_with("/"):
        return root + relative
    root + "/" + relative

fn _projection_path_valid(path: text) -> bool:
    if path == "" or path.starts_with("/") or path.starts_with("../") or path.contains("/../") or path.contains("//") or path.contains("\\"):
        return false
    var i = 0
    while i < path.len():
        val code = path.char_code_at(i)
        if code < 32 or code == 127:
            return false
        i = i + 1
    true

fn version_projection_path_valid(path: text) -> bool:
    _projection_path_valid(path)

fn _required_projection_paths() -> [text]:
    [
        "VERSION", "src/app/simple.sdn", "src/lib/simple.sdn",
        "src/compiler/simple.sdn", "src/compiler/00.common/simple.sdn",
        "src/compiler_rust/simple.sdn", "src/compiler_rust/Cargo.toml",
        "src/compiler_rust/Cargo.lock",
        "src/app/cli/bootstrap_identity.spl",
        "src/app/cli/cli_helpers.spl",
        "src/app/cli/_CliMain/args_and_os_commands.spl",
        "src/app/simple_core/main.spl", "src/app/simpleos_tool/main.spl",
        "tools/mcp-registry/package.json", "tools/mcp-registry/server.json",
        "tools/lsp-mcp-registry/package.json", "tools/lsp-mcp-registry/server.json"
    ]

fn compatibility_snapshot(manifest: VersionManifest) -> CompatibilitySnapshot:
    CompatibilitySnapshot(
        public_api_major: manifest.public_api_major,
        compiler_abi: manifest.compiler_abi,
        bootstrap_protocol: manifest.bootstrap_protocol,
        package_format: manifest.package_format,
        scv_store_schema: manifest.scv_store_schema,
        scv_wire_protocol: manifest.scv_wire_protocol,
        devhub_provider_api: manifest.devhub_provider_api,
        spipe_skill_api: manifest.spipe_skill_api,
        release_manifest_schema: manifest.release_manifest_schema,
        bootstrap_receipt_schema: manifest.bootstrap_receipt_schema
    )

fn load_repository_version(root: text) -> VersionManifest:
    val path = _root_path(root, "release/version.sdn")
    if not file_exists(path):
        return _empty_manifest("canonical release version manifest is missing: " + path)
    parse_version_manifest(file_read(path))

fn _value_after_colon(line: text) -> text:
    val index = line.index_of(":")
    if index < 0:
        return ""
    line[index + 1:].trim().replace("\"", "")

fn _projection_version(path: text, payload: text) -> text:
    if path == "VERSION":
        return payload.trim()
    if path.ends_with(".sdn"):
        for raw in payload.split("\n"):
            val line = raw.trim()
            if line.starts_with("version:"):
                return _value_after_colon(line)
        return ""
    if path.ends_with(".json"):
        var json_version = ""
        for raw in payload.split("\n"):
            val line = raw.trim()
            if line.starts_with("\"version\":") or line.starts_with("\"runtimeVersion\":"):
                val value = _value_after_colon(line).replace(",", "").trim()
                val parsed = parse_release_version(value)
                if parsed.channel == "invalid":
                    return ""
                if json_version != "" and json_version != parsed.canonical:
                    return "<ambiguous>"
                json_version = parsed.canonical
        return json_version
    if path == "src/compiler_rust/Cargo.toml":
        var in_workspace_package = false
        var cargo_version = ""
        for raw in payload.split("\n"):
            val line = raw.trim()
            if line.starts_with("[") and line.ends_with("]"):
                in_workspace_package = line == "[workspace.package]"
            elif in_workspace_package and line.starts_with("version = "):
                val value = line.replace("version = ", "").replace("\"", "").trim()
                val parsed = parse_release_version(value)
                if parsed.channel == "invalid" or cargo_version != "":
                    return "<ambiguous>"
                cargo_version = parsed.canonical
        return cargo_version
    if path == "src/compiler_rust/Cargo.lock":
        val product_packages = [
            "simple-compiler", "simple-compiler-backfill",
            "simple-dependency-tracker", "simple-driver",
            "simple-native-all", "simple-parser", "simple-runtime-abi",
            "simple-sdn", "simple-simd", "simple-wasm-runtime", "spl_fonts"
        ]
        var package_name = ""
        var lock_version = ""
        var observed_packages: [text] = []
        for raw in payload.split("\n"):
            val line = raw.trim()
            if line.starts_with("name = \""):
                package_name = line.replace("name = \"", "").replace("\"", "")
            elif line.starts_with("version = \"") and product_packages.contains(package_name):
                val value = line.replace("version = \"", "").replace("\"", "")
                val parsed = parse_release_version(value)
                if parsed.channel == "invalid" or observed_packages.contains(package_name):
                    return "<ambiguous>"
                if lock_version != "" and lock_version != parsed.canonical:
                    return "<ambiguous>"
                lock_version = parsed.canonical
                observed_packages.push(package_name)
        if observed_packages.len() != product_packages.len():
            return "<ambiguous>"
        return lock_version
    var found = ""
    for raw in payload.split("\n"):
        val line = raw.trim()
        var candidate = ""
        if (path == "src/app/cli/bootstrap_identity.spl" or path == "src/app/cli/cli_helpers.spl" or path == "src/app/cli/_CliMain/args_and_os_commands.spl") and line.starts_with("\"") and line.ends_with("\""):
            candidate = line[1:line.len() - 1]
        elif path == "src/app/simple_core/main.spl" and line.starts_with("val SIMPLE_CORE_VERSION_V1 = \""):
            candidate = line.replace("val SIMPLE_CORE_VERSION_V1 = \"", "").replace("\"", "")
        elif path == "src/app/simpleos_tool/main.spl" and line.starts_with("print \"Simple v"):
            candidate = line.replace("print \"Simple v", "").replace("\"", "")
        if candidate != "":
            val parsed = parse_release_version(candidate)
            if parsed.channel != "invalid":
                if found != "" and found != parsed.canonical:
                    return "<ambiguous>"
                found = parsed.canonical
    found

fn _sorted(values: [text]) -> [text]:
    var result: [text] = []
    for value in values:
        var inserted = false
        var next: [text] = []
        for existing in result:
            if not inserted and value < existing:
                next.push(value)
                inserted = true
            next.push(existing)
        if not inserted:
            next.push(value)
        result = next
    result

fn _repository_root_valid(root: text) -> bool:
    if root == "" or root == ".." or root.contains("/../") or root.contains("\\"):
        return false
    var i = 0
    while i < root.len():
        val code = root.char_code_at(i)
        if code < 32 or code == 127:
            return false
        i = i + 1
    true

fn _unexpected_version_consumers(root: text, manifest: VersionManifest) -> (bool, [text]):
    # One bounded indexed ripgrep scan replaces six recursive filesystem walks.
    # It checks tracked and untracked worktree content while explicit globs keep
    # ignored build/vendor trees outside the authority.
    # JSON is intentionally included: package and server manifests are product
    # version consumers and an undeclared one must fail closed.
    if not _repository_root_valid(root):
        return (false, [])
    var unexpected: [text] = []
    # Extension-specific globs keep the scan below the 250 ms warm NFR on the
    # current tree and exclude the large vendored Rust dependency graph before
    # content matching.
    val roots = ["src/app", "src/lib", "src/compiler", "src/compiler_rust", "tools/mcp-registry", "tools/lsp-mcp-registry"]
    var argv = ["-l", "-F", "--glob", "*.spl", "--glob", "*.sdn", "--glob", "*.json", "--glob", "*.toml", "--glob", "Cargo.lock", "--glob", "!src/compiler_rust/vendor/**", "--", manifest.semver]
    for source_root in roots:
        argv.push(_root_path(root, source_root))
    val (stdout, stderr, code) = process_run_bounded("rg", argv, 1000, 4194304)
    # ripgrep returns 1 when there are no matches; every other nonzero status
    # means discovery was incomplete and therefore cannot authorize a release.
    if code != 0 and code != 1:
        return (false, [])
    if code == 1:
        return (true, [])
    for raw in stdout.trim().split("\n"):
        var path = raw.trim()
        if path.starts_with("./"):
            path = path[2:]
        elif root != "" and root != ".":
            val prefix = if root.ends_with("/"): root else: root + "/"
            if not path.starts_with(prefix):
                return (false, [])
            path = path[prefix.len():]
        if path == "" or path.contains("/vendor/") or path.contains("/build/"):
            continue
        if not path.ends_with(".spl") and not path.ends_with(".sdn") and not path.ends_with(".json") and not path.ends_with(".toml") and not path.ends_with("Cargo.lock"):
            continue
        if not manifest.projections.contains(path):
            unexpected.push(path)
    (true, _sorted(unexpected))

fn check_repository_version(root: text) -> RepositoryVersionReport:
    val manifest = load_repository_version(root)
    if not manifest.valid:
        return RepositoryVersionReport(manifest: manifest, valid: false, reason: manifest.error, projection_paths: [], observed_versions: [], drift: [])
    var observed_versions: [text] = []
    var drift: [text] = []
    val required = _required_projection_paths()
    if manifest.projections.len() != required.len():
        return RepositoryVersionReport(manifest: manifest, valid: false, reason: "declared projection registry does not cover the complete product-version consumer policy", projection_paths: manifest.projections, observed_versions: [], drift: ["projection-registry"])
    for expected in required:
        if not manifest.projections.contains(expected):
            return RepositoryVersionReport(manifest: manifest, valid: false, reason: "declared projection registry is missing a required product-version consumer", projection_paths: manifest.projections, observed_versions: [], drift: [expected + ":undeclared"])
    val (discovery_complete, unexpected) = _unexpected_version_consumers(root, manifest)
    if not discovery_complete:
        return RepositoryVersionReport(manifest: manifest, valid: false, reason: "product-version consumer discovery did not complete", projection_paths: manifest.projections, observed_versions: [], drift: ["consumer-discovery-incomplete"])
    if unexpected.len() > 0:
        return RepositoryVersionReport(manifest: manifest, valid: false, reason: "undeclared product-version consumers were discovered", projection_paths: manifest.projections, observed_versions: [], drift: unexpected)
    for projection in manifest.projections:
        if not _projection_path_valid(projection):
            observed_versions.push("")
            drift.push(projection + ":unsafe-path")
            continue
        val path = _root_path(root, projection)
        if not file_exists(path):
            observed_versions.push("")
            drift.push(projection + ":missing")
        else:
            val observed = _projection_version(projection, file_read(path))
            observed_versions.push(observed)
            if observed == "<ambiguous>":
                drift.push(projection + ":ambiguous")
            elif observed != manifest.semver:
                drift.push(projection)
    if drift.len() > 0:
        return RepositoryVersionReport(manifest: manifest, valid: false, reason: "declared release version projections are missing, ambiguous, or stale", projection_paths: manifest.projections, observed_versions: observed_versions, drift: drift)
    RepositoryVersionReport(manifest: manifest, valid: true, reason: "", projection_paths: manifest.projections, observed_versions: observed_versions, drift: [])

fn _same_compatibility(left: CompatibilitySnapshot, right: CompatibilitySnapshot) -> bool:
    (left.public_api_major == right.public_api_major and
    left.compiler_abi == right.compiler_abi and
    left.bootstrap_protocol == right.bootstrap_protocol and
    left.package_format == right.package_format and
    left.scv_store_schema == right.scv_store_schema and
    left.scv_wire_protocol == right.scv_wire_protocol and
    left.devhub_provider_api == right.devhub_provider_api and
    left.spipe_skill_api == right.spipe_skill_api and
    left.release_manifest_schema == right.release_manifest_schema and
    left.bootstrap_receipt_schema == right.bootstrap_receipt_schema)

fn _compatibility_decreased(left: CompatibilitySnapshot, right: CompatibilitySnapshot) -> bool:
    (right.public_api_major < left.public_api_major or
    right.compiler_abi < left.compiler_abi or
    right.bootstrap_protocol < left.bootstrap_protocol or
    right.package_format < left.package_format or
    right.scv_store_schema < left.scv_store_schema or
    right.scv_wire_protocol < left.scv_wire_protocol or
    right.devhub_provider_api < left.devhub_provider_api or
    right.spipe_skill_api < left.spipe_skill_api or
    right.release_manifest_schema < left.release_manifest_schema or
    right.bootstrap_receipt_schema < left.bootstrap_receipt_schema)

fn _core_parts(version: ReleaseVersion) -> [i64]:
    val core = version.canonical.split("-")[0].split(".")
    [core[0].to_int() ?? -1, core[1].to_int() ?? -1, core[2].to_int() ?? -1]

fn _channel_rank(channel: text) -> i64:
    if channel == "alpha":
        return 0
    if channel == "beta":
        return 1
    if channel == "rc":
        return 2
    if channel == "stable":
        return 3
    -1

fn _requested_bump(current: ReleaseVersion, target: ReleaseVersion) -> text:
    val before = _core_parts(current)
    val after = _core_parts(target)
    if after[0] > before[0]:
        return "major"
    if after[0] < before[0]:
        return "invalid"
    if after[1] > before[1]:
        return "minor"
    if after[1] < before[1]:
        return "invalid"
    if after[2] > before[2]:
        return "patch"
    if after[2] < before[2] or current.canonical == target.canonical:
        return "invalid"
    val current_rank = _channel_rank(current.channel)
    val target_rank = _channel_rank(target.channel)
    if target_rank > current_rank:
        return "prerelease"
    if target_rank == current_rank and target.sequence > current.sequence:
        return "prerelease"
    "invalid"

fn _bump_rank(kind: text) -> i64:
    if kind == "prerelease":
        return 0
    if kind == "patch":
        return 1
    if kind == "minor":
        return 2
    if kind == "major":
        return 3
    -1

fn _higher_bump(left: text, right: text) -> text:
    if _bump_rank(right) > _bump_rank(left):
        return right
    left

fn _required_compatibility_bump(current: CompatibilitySnapshot, proposed: CompatibilitySnapshot) -> text:
    # Each dimension has an explicit product SemVer policy.  Versioned Spipe
    # skill additions are allowed in a product minor; binary/wire/storage and
    # evidence-schema identity changes are release-line breaking.
    var required = "prerelease"
    if proposed.public_api_major != current.public_api_major:
        required = _higher_bump(required, "major")
    if proposed.compiler_abi != current.compiler_abi:
        required = _higher_bump(required, "major")
    if proposed.bootstrap_protocol != current.bootstrap_protocol:
        required = _higher_bump(required, "major")
    if proposed.package_format != current.package_format:
        required = _higher_bump(required, "major")
    if proposed.scv_store_schema != current.scv_store_schema:
        required = _higher_bump(required, "major")
    if proposed.scv_wire_protocol != current.scv_wire_protocol:
        required = _higher_bump(required, "major")
    if proposed.devhub_provider_api != current.devhub_provider_api:
        required = _higher_bump(required, "major")
    if proposed.spipe_skill_api != current.spipe_skill_api:
        required = _higher_bump(required, "minor")
    if proposed.release_manifest_schema != current.release_manifest_schema:
        required = _higher_bump(required, "major")
    if proposed.bootstrap_receipt_schema != current.bootstrap_receipt_schema:
        required = _higher_bump(required, "major")
    required

fn _invalid_bump(current: text, target: text, requested: text, minimum: text, reason: text) -> VersionBumpPlan:
    VersionBumpPlan(valid: false, reason: reason, current_version: current, target_version: target, requested_bump: requested, minimum_bump: minimum, manifest_content: "", projection_edits: [])

fn _target_manifest(current: VersionManifest, target: ReleaseVersion, channel: text, compatibility: CompatibilitySnapshot) -> VersionManifest:
    VersionManifest(
        schema: current.schema, product: current.product, semver: target.canonical,
        line: target.line, channel: channel,
        public_api_major: compatibility.public_api_major,
        compiler_abi: compatibility.compiler_abi,
        bootstrap_protocol: compatibility.bootstrap_protocol,
        package_format: compatibility.package_format,
        scv_store_schema: compatibility.scv_store_schema,
        scv_wire_protocol: compatibility.scv_wire_protocol,
        devhub_provider_api: compatibility.devhub_provider_api,
        spipe_skill_api: compatibility.spipe_skill_api,
        release_manifest_schema: compatibility.release_manifest_schema,
        bootstrap_receipt_schema: compatibility.bootstrap_receipt_schema,
        projections: current.projections, valid: true, error: ""
    )

fn _projection_edits(root: text, current: VersionManifest, target: text) -> [VersionProjectionEdit]:
    var edits: [VersionProjectionEdit] = []
    for projection in current.projections:
        val path = _root_path(root, projection)
        if not file_exists(path):
            edits.push(VersionProjectionEdit(path: projection, original_sha256: "", observed_version: "", target_version: target, rendered_content: "", changed: false, valid: false, error: "declared projection is missing"))
        else:
            val payload = file_read(path)
            val observed = _projection_version(projection, payload)
            if observed != current.semver:
                edits.push(VersionProjectionEdit(path: projection, original_sha256: file_hash_sha256(path), observed_version: observed, target_version: target, rendered_content: "", changed: false, valid: false, error: "projection is stale or ambiguous"))
            else:
                var rendered_lines: [text] = []
                var replacements = 0
                var expected_replacements = 1
                if projection == "VERSION":
                    rendered_lines.push(target)
                    replacements = 1
                elif projection.ends_with(".sdn"):
                    for raw in payload.split("\n"):
                        if raw.trim().starts_with("version:") and _value_after_colon(raw.trim()) == current.semver:
                            rendered_lines.push(raw.replace(current.semver, target))
                            replacements = replacements + 1
                        else:
                            rendered_lines.push(raw)
                elif projection.ends_with(".json"):
                    expected_replacements = 0
                    for raw in payload.split("\n"):
                        val line = raw.trim()
                        if line.starts_with("\"version\":") or line.starts_with("\"runtimeVersion\":"):
                            val observed_field = _value_after_colon(line).replace(",", "").trim()
                            if observed_field == current.semver:
                                rendered_lines.push(raw.replace(current.semver, target))
                                replacements = replacements + 1
                                expected_replacements = expected_replacements + 1
                            else:
                                rendered_lines.push(raw)
                        else:
                            rendered_lines.push(raw)
                elif projection == "src/compiler_rust/Cargo.toml":
                    var in_workspace_package = false
                    for raw in payload.split("\n"):
                        val line = raw.trim()
                        if line.starts_with("[") and line.ends_with("]"):
                            in_workspace_package = line == "[workspace.package]"
                        if in_workspace_package and line == "version = \"" + current.semver + "\"":
                            rendered_lines.push(raw.replace(current.semver, target))
                            replacements = replacements + 1
                        else:
                            rendered_lines.push(raw)
                elif projection == "src/compiler_rust/Cargo.lock":
                    val product_packages = [
                        "simple-compiler", "simple-compiler-backfill",
                        "simple-dependency-tracker", "simple-driver",
                        "simple-native-all", "simple-parser", "simple-runtime-abi",
                        "simple-sdn", "simple-simd", "simple-wasm-runtime", "spl_fonts"
                    ]
                    expected_replacements = product_packages.len()
                    var package_name = ""
                    for raw in payload.split("\n"):
                        val line = raw.trim()
                        if line.starts_with("name = \""):
                            package_name = line.replace("name = \"", "").replace("\"", "")
                        if product_packages.contains(package_name) and line == "version = \"" + current.semver + "\"":
                            rendered_lines.push(raw.replace(current.semver, target))
                            replacements = replacements + 1
                        else:
                            rendered_lines.push(raw)
                else:
                    for raw in payload.split("\n"):
                        val line = raw.trim()
                        var selected = false
                        if (projection == "src/app/cli/bootstrap_identity.spl" or projection == "src/app/cli/cli_helpers.spl" or projection == "src/app/cli/_CliMain/args_and_os_commands.spl") and line == "\"" + current.semver + "\"":
                            selected = true
                        elif projection == "src/app/simple_core/main.spl" and line == "val SIMPLE_CORE_VERSION_V1 = \"" + current.semver + "\"":
                            selected = true
                        elif projection == "src/app/simpleos_tool/main.spl" and line.starts_with("print \"Simple v" + current.semver + "\""):
                            selected = true
                        if selected:
                            rendered_lines.push(raw.replace(current.semver, target))
                            replacements = replacements + 1
                        else:
                            rendered_lines.push(raw)
                val rendered = rendered_lines.join("\n")
                val roundtrip_version = _projection_version(projection, rendered)
                val valid_render = expected_replacements > 0 and replacements == expected_replacements and roundtrip_version == target
                edits.push(VersionProjectionEdit(path: projection, original_sha256: file_hash_sha256(path), observed_version: observed, target_version: target, rendered_content: rendered, changed: rendered != payload, valid: valid_render, error: if valid_render: "" else: "projection renderer did not update exactly one authoritative field"))
    edits

fn _plan_repository_version_bump_from_report(root: text, report: RepositoryVersionReport, target_version: text, target_channel: text, proposed_compatibility: CompatibilitySnapshot) -> VersionBumpPlan:
    if not report.valid:
        return _invalid_bump(report.manifest.semver, target_version, "invalid", "unknown", report.reason)
    val current = parse_release_version(report.manifest.semver)
    val target = parse_release_version(target_version)
    val channel_check = check_version_channel(target, target_channel)
    if not channel_check.valid:
        return _invalid_bump(current.canonical, target_version, "invalid", "unknown", channel_check.reason)
    val requested = _requested_bump(current, target)
    if requested == "invalid":
        return _invalid_bump(current.canonical, target.canonical, requested, "unknown", "target release version must advance monotonically")
    val existing_compatibility = compatibility_snapshot(report.manifest)
    if _compatibility_decreased(existing_compatibility, proposed_compatibility):
        return _invalid_bump(current.canonical, target.canonical, requested, "major", "compatibility dimensions are monotonic and cannot decrease")
    if proposed_compatibility.public_api_major != _core_parts(target)[0]:
        return _invalid_bump(current.canonical, target.canonical, requested, "major", "public API major must equal the target SemVer major")
    val minimum = _required_compatibility_bump(existing_compatibility, proposed_compatibility)
    if _bump_rank(requested) < _bump_rank(minimum):
        return _invalid_bump(current.canonical, target.canonical, requested, minimum, "version bump is smaller than the declared compatibility change requires")
    val target_manifest = _target_manifest(report.manifest, target, target_channel, proposed_compatibility)
    val edits = _projection_edits(root, report.manifest, target.canonical)
    for edit in edits:
        if not edit.valid:
            return _invalid_bump(current.canonical, target.canonical, requested, minimum, "cannot render a missing, stale, or ambiguous projection: " + edit.path)
    VersionBumpPlan(valid: true, reason: "", current_version: current.canonical, target_version: target.canonical, requested_bump: requested, minimum_bump: minimum, manifest_content: render_version_manifest(target_manifest), projection_edits: edits)

fn plan_repository_version_bump(root: text, target_version: text, target_channel: text, proposed_compatibility: CompatibilitySnapshot) -> VersionBumpPlan:
    val report = check_repository_version(root)
    _plan_repository_version_bump_from_report(root, report, target_version, target_channel, proposed_compatibility)

fn plan_repository_version_render(root: text, target_version: text, target_channel: text) -> VersionBumpPlan:
    val manifest = load_repository_version(root)
    if not manifest.valid:
        return _invalid_bump(manifest.semver, target_version, "invalid", "unknown", manifest.error)
    plan_repository_version_bump(root, target_version, target_channel, compatibility_snapshot(manifest))

fn _sha256_valid(value: text) -> bool:
    if value.len() != 64:
        return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        val digit = code >= 48 and code <= 57
        val lower_hex = code >= 97 and code <= 102
        if not digit and not lower_hex:
            return false
        i = i + 1
    true

fn _apply_fail(reason: text) -> VersionApplyResult:
    VersionApplyResult(valid: false, reason: reason, applied_version: "", applied_files: [], recovery_required: false)

fn _rollback_projection_writes(root: text, paths: [text], contents: [text], count: i64) -> bool:
    var restored = true
    var index = count - 1
    while index >= 0:
        val path = _root_path(root, paths[index])
        if not file_atomic_write(path, contents[index]) or file_read(path) != contents[index]:
            restored = false
        index = index - 1
    restored

fn _apply_recovery(reason: text, applied_files: [text]) -> VersionApplyResult:
    VersionApplyResult(valid: false, reason: reason, applied_version: "", applied_files: applied_files, recovery_required: true)

fn _verify_applied_version(root: text, target_manifest: VersionManifest) -> bool:
    # Consumer discovery belongs to the trusted pre-write snapshot.  Post-write
    # verification directly checks that exact manifest and every declared
    # projection, avoiding another full repository scan while still proving
    # every mutated authority field round-trips to the requested version.
    val observed_manifest = load_repository_version(root)
    if not observed_manifest.valid or observed_manifest.semver != target_manifest.semver or observed_manifest.projections != target_manifest.projections:
        return false
    for projection in target_manifest.projections:
        if not _projection_path_valid(projection):
            return false
        val path = _root_path(root, projection)
        if not file_exists(path) or _projection_version(projection, file_read(path)) != target_manifest.semver:
            return false
    true

fn _apply_repository_version_plan_locked(trusted_root: text, expected_manifest_sha256: text, target_version: text, target_channel: text, proposed_compatibility: CompatibilitySnapshot) -> VersionApplyResult:
    # This is the only mutation boundary in the version capsule.  It requires
    # an isolated session and an exact manifest CAS identity, and rolls back
    # every already-written projection if any atomic write or final check fails.
    if not _sha256_valid(expected_manifest_sha256):
        return _apply_fail("version apply requires an exact lowercase SHA-256 manifest identity")
    val manifest_path = _root_path(trusted_root, "release/version.sdn")
    if not file_exists(manifest_path) or file_hash_sha256(manifest_path) != expected_manifest_sha256:
        return _apply_fail("canonical version manifest changed after planning")
    # Capture one complete, trusted repository snapshot after session
    # verification and manifest CAS.  The plan is derived internally from that
    # snapshot; no caller-rendered content crosses the mutation boundary.
    val report = check_repository_version(trusted_root)
    if not report.valid:
        return _apply_fail(report.reason)
    val plan = _plan_repository_version_bump_from_report(trusted_root, report, target_version, target_channel, proposed_compatibility)
    if not plan.valid:
        return _apply_fail(plan.reason)
    if plan.projection_edits.len() != report.manifest.projections.len():
        return _apply_fail("version plan does not cover every declared projection")
    val rendered_manifest = parse_version_manifest(plan.manifest_content)
    if not rendered_manifest.valid or rendered_manifest.semver != plan.target_version:
        return _apply_fail("rendered canonical manifest does not round-trip to the target version")
    var original_paths: [text] = []
    var original_contents: [text] = []
    var applied_paths: [text] = []
    var written = 0
    for edit in plan.projection_edits:
        if not edit.valid or not report.manifest.projections.contains(edit.path) or not _projection_path_valid(edit.path):
            if not _rollback_projection_writes(trusted_root, original_paths, original_contents, written):
                return _apply_recovery("rollback failed after an invalid projection edit", applied_paths)
            return _apply_fail("version plan contains an invalid or undeclared projection edit")
        val path = _root_path(trusted_root, edit.path)
        val current_content = file_read(path)
        if file_hash_sha256(path) != edit.original_sha256 or _projection_version(edit.path, current_content) != plan.current_version or _projection_version(edit.path, edit.rendered_content) != plan.target_version:
            if not _rollback_projection_writes(trusted_root, original_paths, original_contents, written):
                return _apply_recovery("rollback failed after a stale projection was detected", applied_paths)
            return _apply_fail("projection content changed after planning: " + edit.path)
        original_paths.push(edit.path)
        original_contents.push(current_content)
        if not file_atomic_write(path, edit.rendered_content):
            if not _rollback_projection_writes(trusted_root, original_paths, original_contents, written):
                return _apply_recovery("rollback failed after an atomic projection write failed", applied_paths)
            return _apply_fail("atomic projection write failed: " + edit.path)
        written = written + 1
        applied_paths.push(edit.path)
    val original_manifest = file_read(manifest_path)
    if not file_atomic_write(manifest_path, plan.manifest_content):
        if not _rollback_projection_writes(trusted_root, original_paths, original_contents, written):
            return _apply_recovery("rollback failed after the canonical manifest write failed", applied_paths)
        return _apply_fail("atomic canonical manifest write failed")
    if not _verify_applied_version(trusted_root, rendered_manifest):
        val manifest_restored = file_atomic_write(manifest_path, original_manifest) and file_read(manifest_path) == original_manifest
        val projections_restored = _rollback_projection_writes(trusted_root, original_paths, original_contents, written)
        if not manifest_restored or not projections_restored:
            return _apply_recovery("post-apply verification and rollback failed; manual recovery is required", applied_paths)
        return _apply_fail("post-apply repository version verification failed; writes were rolled back")
    applied_paths.push("release/version.sdn")
    VersionApplyResult(valid: true, reason: "", applied_version: plan.target_version, applied_files: applied_paths, recovery_required: false)

fn apply_repository_version_bump(root: text, expected_manifest_sha256: text, session: ReleaseSession, target_version: text, target_channel: text, proposed_compatibility: CompatibilitySnapshot) -> VersionApplyResult:
    # Hold the per-session lease for the entire CAS/write/rollback transaction;
    # cleanup or another mutation cannot race this operation.
    val mutation_lease = begin_release_session_mutation(root, session)
    if not mutation_lease.valid:
        return _apply_fail(mutation_lease.reason)
    val result = _apply_repository_version_plan_locked(
        mutation_lease.verification.canonical_root, expected_manifest_sha256,
        target_version, target_channel, proposed_compatibility
    )
    if not end_release_session_mutation(mutation_lease):
        return _apply_recovery("version mutation completed but its session lease could not be released", result.applied_files)
    result

export CompatibilitySnapshot, VersionProjectionEdit, RepositoryVersionReport, VersionBumpPlan, VersionApplyResult
export compatibility_snapshot, load_repository_version, check_repository_version
export plan_repository_version_render, plan_repository_version_bump
export version_projection_path_valid
export apply_repository_version_bump
