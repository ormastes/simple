# codex-impl
# Pure release policy: validates plans before any VCS, build, signing, or hosting adapter runs.

use std.nogc_sync_mut.io.crypto_sffi.{hash_sha256}

struct ReleaseCheck:
    valid: bool
    reason: text

struct ReleaseVersion:
    canonical: text
    line: text
    channel: text
    sequence: i64

struct ReleaseSession:
    session_id: text
    workspace_path: text
    main_workspace_path: text
    work_branch: text
    target_ref: text
    base_sha: text
    expected_target_sha: text
    policy_sha256: text

struct BackportRequest:
    direction: text
    source_ref: text
    source_commit_sha: text
    change_id: text
    work_id: text
    change_kind: text
    review_receipt_sha256: text
    reviewed_source_commit_sha: text
    reviewed_change_id: text
    target_line: text
    expected_target_sha: text
    adaptation_reason: text
    evidence_sha256: text
    evidence_result_commit_sha: text
    evidence_target_sha: text
    result_commit_sha: text
    forward_port_target_ref: text
    forward_port_receipt_sha256: text

struct CandidateManifest:
    version: text
    attempt: i64
    candidate_ref: text
    commit_sha: text
    source_tree_sha256: text
    policy_sha256: text
    version_manifest_sha256: text
    toolchain_manifest_sha256: text
    support_manifest_sha256: text
    build_graph_sha256: text
    creator_identity: text
    evidence_manifest_sha256: text

struct QualificationReceipt:
    candidate_identity: text
    candidate_commit_sha: text
    build_graph_sha256: text
    artifact_manifest_sha256: text
    evidence_manifest_sha256: text
    required_support_sha256: text
    required_support_passed: bool

struct ReleaseAdmission:
    candidate_version: text
    candidate_attempt: i64
    candidate_ref: text
    candidate_identity: text
    candidate_commit_sha: text
    source_tree_sha256: text
    policy_sha256: text
    version_manifest_sha256: text
    toolchain_manifest_sha256: text
    support_manifest_sha256: text
    build_graph_sha256: text
    creator_identity: text
    artifact_manifest_sha256: text
    evidence_manifest_sha256: text
    qualification_receipt_sha256: text
    admission_receipt_schema: text
    admission_receipt_sha256: text

struct PromotionPlan:
    candidate_identity: text
    tag: text
    target_commit_sha: text
    candidate_commit_sha: text
    artifact_manifest_sha256: text
    admitted_artifact_manifest_sha256: text
    signed_tag: bool
    annotated_tag: bool
    exact_tag_push: bool
    rebuild: bool
    fallback_artifact: bool

fn release_pass() -> ReleaseCheck:
    ReleaseCheck(valid: true, reason: "")

fn release_fail(reason: text) -> ReleaseCheck:
    ReleaseCheck(valid: false, reason: reason)

fn _hex_identity_valid(value: text, expected_len: i64) -> bool:
    if value.len() != expected_len:
        return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        val decimal = code >= 48 and code <= 57
        val lowercase_hex = code >= 97 and code <= 102
        if not decimal and not lowercase_hex:
            return false
        i = i + 1
    true

fn _commit_sha_valid(value: text) -> bool:
    _hex_identity_valid(value, 40) or _hex_identity_valid(value, 64)

fn _sha256_valid(value: text) -> bool:
    _hex_identity_valid(value, 64)

fn _safe_ref_component(value: text) -> bool:
    if value == "" or value.starts_with(".") or value.ends_with("."):
        return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        val lowercase = code >= 97 and code <= 122
        val decimal = code >= 48 and code <= 57
        if not lowercase and not decimal and code != 45 and code != 46:
            return false
        i = i + 1
    true

fn _work_branch_valid(value: text) -> bool:
    val parts = value.split("/")
    if parts.len() != 3 or parts[0] != "work":
        return false
    val kind = parts[1]
    val known_kind = (
        kind == "feat" or kind == "fix" or kind == "refactor" or
        kind == "perf" or kind == "test" or kind == "docs" or
        kind == "build" or kind == "chore" or kind == "patch" or
        kind == "hotfix" or kind == "backport" or kind == "release" or
        kind == "recovery"
    )
    known_kind and _safe_ref_component(parts[2])

fn _release_line_valid(value: text) -> bool:
    if not value.starts_with("release/"):
        return false
    val components = value[8:].split(".")
    (components.len() == 2 and
        _decimal_identifier_valid(components[0], true) and
        _decimal_identifier_valid(components[1], true))

fn _absolute_workspace_path_valid(value: text) -> bool:
    (value.starts_with("/") and value != "/" and
        not value.contains("/../") and not value.contains("/./") and
        not value.ends_with("/..") and not value.ends_with("/."))

fn _decimal_identifier_valid(value: text, allow_zero: bool) -> bool:
    if value == "":
        return false
    if value.len() > 1 and value.starts_with("0"):
        return false
    var i = 0
    while i < value.len():
        val code = value.char_code_at(i)
        if code < 48 or code > 57:
            return false
        i = i + 1
    val number = value.to_int() ?? -1
    number >= 0 and (allow_zero or number > 0)

fn parse_release_version(value: text) -> ReleaseVersion:
    val canonical = value.trim()
    # Product/version manifests use bare SemVer.  Only release tag refs add `v`.
    if canonical.starts_with("v"):
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    val dash_parts = canonical.split("-")
    if dash_parts.len() > 2:
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    val core = dash_parts[0].split(".")
    if core.len() != 3:
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    for part in core:
        if not _decimal_identifier_valid(part, true):
            return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    val line = core[0] + "." + core[1]
    if dash_parts.len() == 1:
        return ReleaseVersion(canonical: canonical, line: line, channel: "stable", sequence: 0)
    val prerelease = dash_parts[1].split(".")
    if prerelease.len() != 2:
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    val channel = prerelease[0]
    if channel != "alpha" and channel != "beta" and channel != "rc":
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    if not _decimal_identifier_valid(prerelease[1], false):
        return ReleaseVersion(canonical: "", line: "", channel: "invalid", sequence: -1)
    ReleaseVersion(canonical: canonical, line: line, channel: channel, sequence: prerelease[1].to_int() ?? -1)

fn check_version_channel(version: ReleaseVersion, channel: text) -> ReleaseCheck:
    if version.channel == "invalid":
        return release_fail("release version must use stable SemVer or lowercase numbered alpha, beta, or rc")
    if version.channel != channel:
        return release_fail("release version channel does not match the declared channel")
    release_pass()

fn check_version_projection(expected: text, projection_name: text, observed: text) -> ReleaseCheck:
    val version = parse_release_version(expected)
    if version.channel == "invalid":
        return release_fail("canonical release version is invalid")
    if projection_name == "":
        return release_fail("version projection name is required")
    if observed != version.canonical:
        return release_fail("version projection is stale: " + projection_name)
    release_pass()

fn validate_release_session(session: ReleaseSession) -> ReleaseCheck:
    if not _safe_ref_component(session.session_id) or not _absolute_workspace_path_valid(session.workspace_path):
        return release_fail("release mutation requires a session id and workspace")
    if not _absolute_workspace_path_valid(session.main_workspace_path) or session.workspace_path == session.main_workspace_path:
        return release_fail("release mutation is forbidden in the main worktree")
    if not _work_branch_valid(session.work_branch):
        return release_fail("release session must own a work branch")
    if session.target_ref != "main" and not _release_line_valid(session.target_ref):
        return release_fail("release session target must be main or a release line")
    if not _commit_sha_valid(session.base_sha) or not _commit_sha_valid(session.expected_target_sha) or not _sha256_valid(session.policy_sha256):
        return release_fail("release session requires exact base, target, and policy identities")
    release_pass()

fn check_beta_preparation(version: ReleaseVersion, session: ReleaseSession) -> ReleaseCheck:
    val session_check = validate_release_session(session)
    if not session_check.valid:
        return session_check
    if version.channel != "beta":
        return release_fail("beta preparation requires a numbered beta version")
    if session.target_ref != "release/" + version.line:
        return release_fail("beta target release line does not match the version")
    release_pass()

fn check_backport_admission(request: BackportRequest) -> ReleaseCheck:
    if not _commit_sha_valid(request.source_commit_sha) or not _commit_sha_valid(request.result_commit_sha):
        return release_fail("backport requires exact source and result commits")
    if request.change_id == "" or request.work_id == "":
        return release_fail("backport requires stable change and work identities")
    if request.change_kind != "fix":
        return release_fail("beta backports accept reviewed bug fixes only")
    if request.direction == "main_to_beta":
        if request.source_ref != "main":
            return release_fail("main-to-beta backport source must be main")
        if request.forward_port_target_ref != "" or request.forward_port_receipt_sha256 != "":
            return release_fail("main-to-beta backport must not claim a forward port")
    elif request.direction == "beta_to_main":
        if request.source_ref != request.target_line:
            return release_fail("release-first emergency fix source must match the beta release line")
        if request.forward_port_target_ref != "main" or not _sha256_valid(request.forward_port_receipt_sha256):
            return release_fail("release-first emergency fix requires an exact forward-port receipt to main")
    else:
        return release_fail("backport direction must be main_to_beta or beta_to_main")
    if not _sha256_valid(request.review_receipt_sha256):
        return release_fail("backport requires a review receipt")
    if request.reviewed_source_commit_sha != request.source_commit_sha or request.reviewed_change_id != request.change_id:
        return release_fail("backport review receipt binding does not match the requested change")
    if not _release_line_valid(request.target_line):
        return release_fail("backport target must be a release line")
    if not _commit_sha_valid(request.expected_target_sha):
        return release_fail("backport requires the exact expected target revision")
    if request.adaptation_reason == "":
        return release_fail("backport adaptation reason must be none or an explanation")
    if not _sha256_valid(request.evidence_sha256):
        return release_fail("backport requires renewed focused evidence")
    if request.evidence_result_commit_sha != request.result_commit_sha or request.evidence_target_sha != request.expected_target_sha:
        return release_fail("backport evidence does not bind the result and target revisions")
    if request.result_commit_sha == request.expected_target_sha:
        return release_fail("backport evidence must bind the post-application revision")
    release_pass()

fn expected_candidate_ref(version: text, attempt: i64) -> text:
    var suffix = attempt.to_text()
    if attempt > 0 and attempt < 10:
        suffix = "00" + suffix
    elif attempt < 100:
        suffix = "0" + suffix
    "candidate/v" + version + "/a" + suffix

fn check_candidate_manifest(candidate: CandidateManifest) -> ReleaseCheck:
    val version = parse_release_version(candidate.version)
    if version.channel == "invalid":
        return release_fail("candidate version is invalid")
    if candidate.attempt <= 0:
        return release_fail("candidate attempt must be positive")
    if candidate.candidate_ref != expected_candidate_ref(version.canonical, candidate.attempt):
        return release_fail("candidate ref does not match version and attempt")
    if not _commit_sha_valid(candidate.commit_sha) or not _sha256_valid(candidate.source_tree_sha256):
        return release_fail("candidate requires exact commit and source identities")
    if not _sha256_valid(candidate.policy_sha256) or not _sha256_valid(candidate.version_manifest_sha256):
        return release_fail("candidate requires policy and version manifest identities")
    if not _sha256_valid(candidate.toolchain_manifest_sha256) or not _sha256_valid(candidate.support_manifest_sha256):
        return release_fail("candidate requires toolchain and support manifest identities")
    if not _sha256_valid(candidate.build_graph_sha256):
        return release_fail("candidate requires an exact build graph identity")
    if candidate.creator_identity == "" or candidate.creator_identity.contains("\n") or candidate.creator_identity.contains("\r"):
        return release_fail("candidate requires one safe creator identity")
    if not _sha256_valid(candidate.evidence_manifest_sha256):
        return release_fail("candidate requires an evidence manifest identity")
    release_pass()

fn candidate_identity(candidate: CandidateManifest) -> text:
    # Length prefixes keep distinct manifests distinct even when a field contains
    # the separator.  The outer release facade hashes this canonical text.
    val fields = [
        candidate.version, candidate.attempt.to_text(), candidate.candidate_ref,
        candidate.commit_sha, candidate.source_tree_sha256, candidate.policy_sha256,
        candidate.version_manifest_sha256, candidate.toolchain_manifest_sha256,
        candidate.support_manifest_sha256, candidate.build_graph_sha256,
        candidate.creator_identity, candidate.evidence_manifest_sha256
    ]
    var identity = ""
    for field in fields:
        identity = identity + field.len().to_text() + ":" + field
    hash_sha256(identity)

fn check_qualification_receipt(candidate: CandidateManifest, receipt: QualificationReceipt) -> ReleaseCheck:
    val manifest_check = check_candidate_manifest(candidate)
    if not manifest_check.valid:
        return manifest_check
    if receipt.candidate_identity != candidate_identity(candidate):
        return release_fail("qualification receipt does not bind the canonical candidate identity")
    if receipt.candidate_commit_sha != candidate.commit_sha:
        return release_fail("qualification receipt does not bind the candidate commit")
    if receipt.build_graph_sha256 != candidate.build_graph_sha256:
        return release_fail("qualification receipt does not bind the admitted build graph")
    if not _sha256_valid(receipt.artifact_manifest_sha256) or not _sha256_valid(receipt.evidence_manifest_sha256):
        return release_fail("qualification receipt requires artifact and evidence identities")
    if not _sha256_valid(receipt.required_support_sha256) or not receipt.required_support_passed:
        return release_fail("qualification receipt does not prove all policy-required support")
    release_pass()

fn check_candidate_create_once(existing_identity: text, candidate: CandidateManifest) -> ReleaseCheck:
    val candidate_check = check_candidate_manifest(candidate)
    if not candidate_check.valid:
        return candidate_check
    if existing_identity != "" and existing_identity != candidate_identity(candidate):
        return release_fail("candidate identity is create-once and cannot be mutated")
    release_pass()

fn check_candidate_authority_binding(session: ReleaseSession, candidate: CandidateManifest, observed_head: text) -> ReleaseCheck:
    val candidate_check = check_candidate_manifest(candidate)
    if not candidate_check.valid:
        return candidate_check
    if session.target_ref != "main" and not _release_line_valid(session.target_ref):
        return release_fail("candidate creation target must be protected main or a release line")
    if candidate.commit_sha != observed_head:
        return release_fail("candidate commit must equal the registered session HEAD")
    if candidate.policy_sha256 != session.policy_sha256:
        return release_fail("candidate policy identity must equal the registered session policy")
    if candidate.creator_identity != session.session_id:
        return release_fail("candidate creator identity must equal the registered session owner")
    release_pass()

fn check_promotion_plan(admission: ReleaseAdmission, plan: PromotionPlan) -> ReleaseCheck:
    if admission.admission_receipt_schema != "spipe-review-admission/1":
        return release_fail("release candidate requires spipe-review-admission/1; self-review decisions cannot authorize candidate promotion")
    val admitted_version = parse_release_version(admission.candidate_version)
    if admitted_version.channel == "invalid":
        return release_fail("release admission candidate version is invalid")
    if admission.candidate_attempt <= 0 or admission.candidate_ref != expected_candidate_ref(admitted_version.canonical, admission.candidate_attempt):
        return release_fail("release admission candidate ref or attempt is invalid")
    if not _commit_sha_valid(admission.candidate_commit_sha) or not _sha256_valid(admission.candidate_identity):
        return release_fail("release admission identity is incomplete")
    if not _sha256_valid(admission.source_tree_sha256) or not _sha256_valid(admission.policy_sha256) or not _sha256_valid(admission.version_manifest_sha256):
        return release_fail("release admission source, policy, or version identity is incomplete")
    if not _sha256_valid(admission.toolchain_manifest_sha256) or not _sha256_valid(admission.support_manifest_sha256) or not _sha256_valid(admission.build_graph_sha256):
        return release_fail("release admission toolchain, support, or build graph identity is incomplete")
    if admission.creator_identity == "" or admission.creator_identity.contains("\n") or admission.creator_identity.contains("\r"):
        return release_fail("release admission creator identity is incomplete")
    val admitted_candidate = CandidateManifest(
        version: admission.candidate_version,
        attempt: admission.candidate_attempt,
        candidate_ref: admission.candidate_ref,
        commit_sha: admission.candidate_commit_sha,
        source_tree_sha256: admission.source_tree_sha256,
        policy_sha256: admission.policy_sha256,
        version_manifest_sha256: admission.version_manifest_sha256,
        toolchain_manifest_sha256: admission.toolchain_manifest_sha256,
        support_manifest_sha256: admission.support_manifest_sha256,
        build_graph_sha256: admission.build_graph_sha256,
        creator_identity: admission.creator_identity,
        evidence_manifest_sha256: admission.evidence_manifest_sha256
    )
    val candidate_check = check_candidate_manifest(admitted_candidate)
    if not candidate_check.valid:
        return candidate_check
    if admission.candidate_identity != candidate_identity(admitted_candidate):
        return release_fail("release admission does not bind the canonical candidate identity")
    if not _sha256_valid(admission.artifact_manifest_sha256) or not _sha256_valid(admission.evidence_manifest_sha256):
        return release_fail("release admission evidence identity is incomplete")
    if not _sha256_valid(admission.qualification_receipt_sha256) or not _sha256_valid(admission.admission_receipt_sha256):
        return release_fail("release candidate requires qualification and admission receipts")
    if plan.candidate_identity != admission.candidate_identity:
        return release_fail("promotion candidate identity does not match release admission")
    if plan.target_commit_sha != admission.candidate_commit_sha or plan.candidate_commit_sha != admission.candidate_commit_sha:
        return release_fail("promotion target does not match the admitted candidate commit")
    if not _sha256_valid(plan.artifact_manifest_sha256) or plan.artifact_manifest_sha256 != admission.artifact_manifest_sha256:
        return release_fail("promotion artifacts do not match the admitted manifest")
    if plan.admitted_artifact_manifest_sha256 != admission.artifact_manifest_sha256:
        return release_fail("promotion admission binding is stale")
    if not plan.tag.starts_with("v"):
        return release_fail("promotion requires one canonical SemVer release tag")
    val tag_version = parse_release_version(plan.tag[1:])
    if tag_version.channel == "invalid" or plan.tag != "v" + tag_version.canonical:
        return release_fail("promotion requires one canonical SemVer release tag")
    if tag_version.canonical != admitted_version.canonical:
        return release_fail("promotion tag version does not match the admitted candidate version")
    if not plan.signed_tag or not plan.annotated_tag:
        return release_fail("promotion tag must be signed and annotated")
    if not plan.exact_tag_push:
        return release_fail("promotion must push exactly one tag ref")
    if plan.rebuild:
        return release_fail("promotion must not rebuild admitted artifacts")
    if plan.fallback_artifact:
        return release_fail("promotion must not use fallback artifacts")
    release_pass()

fn check_withdrawal_plan(delete_tag: bool, move_tag: bool, reuse_version: bool, redeploy_version: text) -> ReleaseCheck:
    if delete_tag or move_tag or reuse_version:
        return release_fail("withdrawal must preserve published release identity")
    if redeploy_version != "" and parse_release_version(redeploy_version).channel == "invalid":
        return release_fail("rollback redeploy version is invalid")
    release_pass()

export ReleaseCheck, ReleaseVersion, ReleaseSession, BackportRequest
export CandidateManifest, QualificationReceipt, ReleaseAdmission, PromotionPlan
export parse_release_version, check_version_channel, check_version_projection
export validate_release_session, check_beta_preparation, check_backport_admission
export expected_candidate_ref, check_candidate_manifest, candidate_identity
export check_candidate_create_once, check_qualification_receipt
export check_candidate_authority_binding
export check_promotion_plan, check_withdrawal_plan
