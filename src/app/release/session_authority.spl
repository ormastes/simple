# codex-impl
# Trusted release-session observation. Caller-supplied session fields are only
# claims until this boundary binds them to canonical Git/worktree state.

use std.nogc_sync_mut.io.file_ops.{file_exists, file_hash_sha256, file_read}
use app.io.mod.{
    process_run_bounded, dir_create_all, file_atomic_write, file_lock,
    file_unlock, time_now_unix_micros, getpid
}
use app.release.policy.{ReleaseCheck, ReleaseSession, validate_release_session}

struct ReleaseSessionVerification:
    valid: bool
    reason: text
    canonical_root: text
    current_head: text
    target_head: text
    current_branch: text
    main_workspace_path: text

struct ReleaseSessionRegistration:
    valid: bool
    reason: text
    registry_path: text
    output_root: text
    cache_root: text
    registry_sha256: text

struct ReleaseMutationLease:
    valid: bool
    reason: text
    verification: ReleaseSessionVerification
    lock_handle: i64

fn _rejected(reason: text) -> ReleaseSessionVerification:
    ReleaseSessionVerification(
        valid: false, reason: reason, canonical_root: "", current_head: "",
        target_head: "", current_branch: "", main_workspace_path: ""
    )

fn _registration_rejected(reason: text) -> ReleaseSessionRegistration:
    ReleaseSessionRegistration(
        valid: false, reason: reason, registry_path: "", output_root: "",
        cache_root: "", registry_sha256: ""
    )

fn _run(command: text, arguments: [text]) -> (text, text, i64):
    process_run_bounded(command, arguments, 5000, 262144)

fn _realpath(path: text) -> text:
    val (stdout, _stderr, code) = _run("realpath", [path])
    if code != 0:
        return ""
    stdout.trim()

fn _lexical_absolute_path(path: text) -> text:
    # `-s` makes symlink aliases observable while still normalizing relative
    # paths and dot segments. It is passed as argv, never through a shell.
    val (stdout, _stderr, code) = _run("realpath", ["-s", path])
    if code != 0:
        return ""
    stdout.trim()

fn _git(root: text, arguments: [text]) -> (text, text, i64):
    _run("git", ["-C", root] + arguments)

fn _git_value(root: text, arguments: [text]) -> text:
    val (stdout, _stderr, code) = _git(root, arguments)
    if code != 0:
        return ""
    stdout.trim()

fn _trim_trailing_slashes(path: text) -> text:
    var result = path
    while result.len() > 1 and result.ends_with("/"):
        result = result[0:result.len() - 1]
    result

fn _protected_branch(branch: text) -> bool:
    branch == "main" or branch.starts_with("release/") or branch.starts_with("candidate/")

fn _worktree_paths(root: text) -> [text]:
    val (stdout, _stderr, code) = _git(root, ["worktree", "list", "--porcelain"])
    if code != 0:
        return []
    var paths: [text] = []
    for raw in stdout.split("\n"):
        if raw.starts_with("worktree "):
            val canonical = _realpath(raw[9:].trim())
            if canonical == "":
                return []
            paths.push(canonical)
    paths

fn _target_head(root: text, target_ref: text) -> text:
    val remote = _git_value(root, ["rev-parse", "--verify", "refs/remotes/origin/" + target_ref])
    if remote != "":
        return remote
    _git_value(root, ["rev-parse", "--verify", "refs/heads/" + target_ref])

fn _registry_root(root: text) -> text:
    _git_value(root, ["rev-parse", "--path-format=absolute", "--git-common-dir"]) + "/simple-release"

fn _registry_path(root: text) -> text:
    _registry_root(root) + "/sessions.v2"

fn _registry_field_valid(value: text) -> bool:
    value != "" and not value.contains("|") and not value.contains("\n") and not value.contains("\r")

fn _private_output_root(root: text, session_id: text) -> text:
    root + "/build/session/" + session_id + "/output"

fn _private_cache_root(root: text, session_id: text) -> text:
    root + "/build/session/" + session_id + "/cache-overlay"

fn _session_record(session: ReleaseSession, root: text, output_root: text, cache_root: text) -> text:
    [
        "active", session.session_id, root, session.main_workspace_path,
        session.work_branch, session.target_ref, session.base_sha,
        session.base_sha, session.expected_target_sha, session.policy_sha256,
        output_root, cache_root, time_now_unix_micros().to_text(), getpid().to_text()
    ].join("|")

fn _active_record_matches(line: text, session: ReleaseSession, root: text, output_root: text, cache_root: text) -> bool:
    val fields = line.split("|")
    fields.len() == 14 and fields[0] == "active" and
        fields[1] == session.session_id and fields[2] == root and
        fields[3] == session.main_workspace_path and fields[4] == session.work_branch and
        fields[5] == session.target_ref and fields[6] == session.base_sha and
        fields[8] == session.expected_target_sha and fields[9] == session.policy_sha256 and
        fields[10] == output_root and fields[11] == cache_root

fn _registry_conflict(registry: text, session: ReleaseSession, root: text) -> text:
    for line in registry.split("\n"):
        if line == "" or not line.starts_with("active|"):
            continue
        val fields = line.split("|")
        if fields.len() != 14:
            return "release session registry is malformed"
        if fields[1] == session.session_id:
            val same_immutable_owner = fields[2] == root and
                fields[3] == session.main_workspace_path and
                fields[4] == session.work_branch and fields[5] == session.target_ref and
                fields[6] == session.base_sha and
                fields[8] == session.expected_target_sha and
                fields[9] == session.policy_sha256 and
                fields[10] == _private_output_root(root, session.session_id) and
                fields[11] == _private_cache_root(root, session.session_id)
            if not same_immutable_owner:
                return "release session id is already bound to a different immutable owner"
        if fields[2] == root and fields[1] != session.session_id:
            return "release workspace is already owned by another session"
        if fields[4] == session.work_branch and fields[1] != session.session_id:
            return "release branch is already owned by another session"
    ""

fn _observe_release_session(root: text, claimed: ReleaseSession, require_base_head: bool) -> ReleaseSessionVerification:
    # Keep the pure shape validation as the first, cheap rejection layer.
    val shape = validate_release_session(claimed)
    if not shape.valid:
        return _rejected(shape.reason)

    val canonical_root = _realpath(root)
    if canonical_root == "":
        return _rejected("release workspace root does not exist or cannot be canonicalized")
    val lexical_root = _lexical_absolute_path(root)
    if lexical_root == "" or _trim_trailing_slashes(lexical_root) != canonical_root:
        return _rejected("release workspace root must not be a symlink alias")

    val repository_root = _git_value(canonical_root, ["rev-parse", "--show-toplevel"])
    if repository_root == "" or _realpath(repository_root) != canonical_root:
        return _rejected("release workspace root must be the root of its Git repository")
    if claimed.workspace_path != canonical_root:
        return _rejected("release session workspace does not match the canonical repository root")

    val worktrees = _worktree_paths(canonical_root)
    if worktrees.len() == 0 or not worktrees.contains(canonical_root):
        return _rejected("release workspace is not a registered Git worktree")
    val main_workspace = worktrees[0]
    if canonical_root == main_workspace:
        return _rejected("release mutation is forbidden in the main worktree")
    if claimed.main_workspace_path != main_workspace:
        return _rejected("release session main-worktree claim does not match Git state")

    val branch = _git_value(canonical_root, ["symbolic-ref", "--quiet", "--short", "HEAD"])
    if branch == "":
        return _rejected("release mutation is forbidden from detached HEAD")
    if _protected_branch(branch):
        return _rejected("release mutation is forbidden on a protected branch")
    if branch != claimed.work_branch:
        return _rejected("release session branch claim does not match Git state")

    val head = _git_value(canonical_root, ["rev-parse", "--verify", "HEAD"])
    if head == "" or (require_base_head and head != claimed.base_sha):
        return _rejected("release session base identity does not match current HEAD")
    val target_head = _target_head(canonical_root, claimed.target_ref)
    if target_head == "" or target_head != claimed.expected_target_sha:
        return _rejected("release target identity does not match fetched Git state")

    val policy_path = canonical_root + "/.spipe/policy/vcs.sdn"
    if not file_exists(policy_path) or file_hash_sha256(policy_path) != claimed.policy_sha256:
        return _rejected("release policy identity does not match the workspace policy")

    ReleaseSessionVerification(
        valid: true, reason: "", canonical_root: canonical_root,
        current_head: head, target_head: target_head, current_branch: branch,
        main_workspace_path: main_workspace
    )

fn verify_release_session(root: text, claimed: ReleaseSession) -> ReleaseSessionVerification:
    # Initial admission is anchored to the immutable base.  Once registered,
    # the durable registry owns the independently advancing current-head CAS.
    _observe_release_session(root, claimed, true)

fn register_release_session(root: text, claimed: ReleaseSession) -> ReleaseSessionRegistration:
    # Registration is the durable ownership boundary.  A repository-wide lock
    # serializes uniqueness checks across every linked worktree.
    val observed = verify_release_session(root, claimed)
    if not observed.valid:
        return _registration_rejected(observed.reason)
    for field in [claimed.session_id, observed.canonical_root, claimed.main_workspace_path, claimed.work_branch]:
        if not _registry_field_valid(field):
            return _registration_rejected("release session identity contains an unsafe registry field")

    val registry_root = _registry_root(observed.canonical_root)
    if registry_root == "/simple-release" or not dir_create_all(registry_root):
        return _registration_rejected("release session registry root cannot be created")
    val registry_path = registry_root + "/sessions.v2"
    val output_root = _private_output_root(observed.canonical_root, claimed.session_id)
    val cache_root = _private_cache_root(observed.canonical_root, claimed.session_id)
    # Prepare private namespaces before publishing ownership.  A provider
    # failure therefore cannot leave an active but unusable registry record.
    if not dir_create_all(output_root) or not dir_create_all(cache_root):
        return _registration_rejected("release session private output/cache roots cannot be created")
    val canonical_output = _realpath(output_root)
    val canonical_cache = _realpath(cache_root)
    if canonical_output != output_root or canonical_cache != cache_root:
        return _registration_rejected("release session private roots must not be symlink aliases")
    val lock = file_lock(registry_path + ".lock", 10)
    if lock < 0:
        return _registration_rejected("release session registry lock is unavailable")

    val current = if file_exists(registry_path): file_read(registry_path) else: ""
    val conflict = _registry_conflict(current, claimed, observed.canonical_root)
    var reason = conflict
    if reason == "":
        var already_registered = false
        for line in current.split("\n"):
            if _active_record_matches(line, claimed, observed.canonical_root, output_root, cache_root):
                already_registered = true
                break
        if not already_registered:
            val record = _session_record(claimed, observed.canonical_root, output_root, cache_root)
            if not file_atomic_write(registry_path, current + record + "\n"):
                reason = "release session registry write failed"
    if not file_unlock(lock):
        return _registration_rejected("release session registry lock release failed")
    if reason != "":
        return _registration_rejected(reason)

    # These roots are private because registry uniqueness binds the containing
    # workspace and session id to exactly one active owner.
    ReleaseSessionRegistration(
        valid: true, reason: "", registry_path: registry_path,
        output_root: output_root, cache_root: cache_root,
        registry_sha256: file_hash_sha256(registry_path)
    )

fn verify_registered_release_session(root: text, claimed: ReleaseSession) -> ReleaseSessionRegistration:
    val observed = _observe_release_session(root, claimed, false)
    if not observed.valid:
        return _registration_rejected(observed.reason)
    val registry_path = _registry_path(observed.canonical_root)
    if not file_exists(registry_path):
        return _registration_rejected("release mutation requires a registered session")
    val output_root = _private_output_root(observed.canonical_root, claimed.session_id)
    val cache_root = _private_cache_root(observed.canonical_root, claimed.session_id)
    val registry = file_read(registry_path)
    val conflict = _registry_conflict(registry, claimed, observed.canonical_root)
    if conflict != "":
        return _registration_rejected(conflict)
    var found = false
    for line in registry.split("\n"):
        if _active_record_matches(line, claimed, observed.canonical_root, output_root, cache_root):
            val fields = line.split("|")
            if fields[7] != observed.current_head:
                return _registration_rejected("release session current HEAD is foreign or stale")
            found = true
            break
    if not found:
        return _registration_rejected("release session is not the active registered owner")
    if _realpath(output_root) != output_root or _realpath(cache_root) != cache_root:
        return _registration_rejected("release session private roots are missing or aliased")
    ReleaseSessionRegistration(
        valid: true, reason: "", registry_path: registry_path,
        output_root: output_root, cache_root: cache_root,
        registry_sha256: file_hash_sha256(registry_path)
    )

fn begin_release_session_mutation(root: text, claimed: ReleaseSession) -> ReleaseMutationLease:
    val observed = _observe_release_session(root, claimed, false)
    if not observed.valid:
        return ReleaseMutationLease(valid: false, reason: observed.reason, verification: observed, lock_handle: -1)
    val lock = file_lock(_registry_path(observed.canonical_root) + ".mutation." + claimed.session_id + ".lock", 10)
    if lock < 0:
        return ReleaseMutationLease(valid: false, reason: "release session mutation lease is unavailable", verification: observed, lock_handle: -1)
    val registered = verify_registered_release_session(observed.canonical_root, claimed)
    if not registered.valid:
        val _ = file_unlock(lock)
        return ReleaseMutationLease(valid: false, reason: registered.reason, verification: observed, lock_handle: -1)
    ReleaseMutationLease(valid: true, reason: "", verification: observed, lock_handle: lock)

fn advance_release_session_head(
    lease: ReleaseMutationLease,
    claimed: ReleaseSession,
    expected_registry_sha256: text,
    expected_previous_head: text
) -> ReleaseSessionRegistration:
    # The caller must hold the lease continuously across its mutation/commit.
    # That makes a branch advance attributable to this registered session.  A
    # registry digest and previous-head CAS prevent stale or foreign writers.
    if not lease.valid or lease.lock_handle < 0:
        return _registration_rejected("release session head advance requires an active mutation lease")
    val root = lease.verification.canonical_root
    val observed = _observe_release_session(root, claimed, false)
    if not observed.valid:
        return _registration_rejected(observed.reason)
    if expected_previous_head != lease.verification.current_head:
        return _registration_rejected("release session previous HEAD does not match the mutation lease")
    if observed.current_head == expected_previous_head:
        return _registration_rejected("release session mutation did not advance HEAD")
    val (_ancestor_out, _ancestor_err, ancestor_code) = _git(
        root, ["merge-base", "--is-ancestor", expected_previous_head, observed.current_head]
    )
    if ancestor_code != 0:
        return _registration_rejected("release session HEAD advance is not a descendant of its registered head")

    val registry_path = _registry_path(root)
    if expected_registry_sha256.len() != 64 or file_hash_sha256(registry_path) != expected_registry_sha256:
        return _registration_rejected("release session registry changed before HEAD advance")
    val registry_lock = file_lock(registry_path + ".lock", 10)
    if registry_lock < 0:
        return _registration_rejected("release session registry lock is unavailable")
    var reason = ""
    val current = file_read(registry_path)
    if file_hash_sha256(registry_path) != expected_registry_sha256:
        reason = "release session registry changed during HEAD advance"
    else:
        val output_root = _private_output_root(root, claimed.session_id)
        val cache_root = _private_cache_root(root, claimed.session_id)
        var active_line = ""
        for line in current.split("\n"):
            if _active_record_matches(line, claimed, root, output_root, cache_root):
                val fields = line.split("|")
                if fields[7] != expected_previous_head:
                    reason = "release session registered HEAD changed before CAS"
                else:
                    active_line = line
                break
        if reason == "" and active_line == "":
            reason = "release session active registry record is missing"
        elif reason == "":
            val fields = active_line.split("|")
            fields[7] = observed.current_head
            val next = current.replace(active_line + "\n", fields.join("|") + "\n")
            if not file_atomic_write(registry_path, next):
                reason = "release session HEAD registry write failed"
    if not file_unlock(registry_lock):
        return _registration_rejected("release session registry lock release failed")
    if reason != "":
        return _registration_rejected(reason)
    ReleaseSessionRegistration(
        valid: true, reason: "", registry_path: registry_path,
        output_root: _private_output_root(root, claimed.session_id),
        cache_root: _private_cache_root(root, claimed.session_id),
        registry_sha256: file_hash_sha256(registry_path)
    )

fn end_release_session_mutation(lease: ReleaseMutationLease) -> bool:
    lease.valid and lease.lock_handle >= 0 and file_unlock(lease.lock_handle)

fn check_release_session_cleanup(root: text, claimed: ReleaseSession) -> ReleaseCheck:
    # Cleanup is deliberately advisory and non-destructive.  Stale sessions are
    # never auto-deleted; an owner must first prove clean Git state and absence
    # of a live mutation lease through the registry authority.
    val registered = verify_registered_release_session(root, claimed)
    if not registered.valid:
        return ReleaseCheck(valid: false, reason: registered.reason)
    val dirty = _git_value(root, ["status", "--porcelain"])
    if dirty != "":
        return ReleaseCheck(valid: false, reason: "release session cleanup is forbidden while the worktree is dirty")
    val lease = file_lock(registered.registry_path + ".mutation." + claimed.session_id + ".lock", 0)
    if lease < 0:
        return ReleaseCheck(valid: false, reason: "release session cleanup is forbidden while a mutation is active")
    if not file_unlock(lease):
        return ReleaseCheck(valid: false, reason: "release session cleanup lease release failed")
    ReleaseCheck(valid: true, reason: "")

fn close_release_session(root: text, claimed: ReleaseSession, expected_registry_sha256: text) -> ReleaseCheck:
    # Close is append-preserving: it changes only the exact active record to a
    # closed record.  Outputs, caches, receipts, branch, and worktree remain for
    # an explicit later archival/removal authority; stale age alone never
    # authorizes deletion.
    val mutation = begin_release_session_mutation(root, claimed)
    if not mutation.valid:
        return ReleaseCheck(valid: false, reason: mutation.reason)
    val trusted_root = mutation.verification.canonical_root
    val registry_path = _registry_path(trusted_root)
    var result = ReleaseCheck(valid: true, reason: "")
    if expected_registry_sha256.len() != 64 or file_hash_sha256(registry_path) != expected_registry_sha256:
        result = ReleaseCheck(valid: false, reason: "release session registry changed after cleanup planning")
    elif _git_value(trusted_root, ["status", "--porcelain"]) != "":
        result = ReleaseCheck(valid: false, reason: "release session close is forbidden while the worktree is dirty")
    else:
        val registry_lock = file_lock(registry_path + ".lock", 10)
        if registry_lock < 0:
            result = ReleaseCheck(valid: false, reason: "release session registry lock is unavailable")
        else:
            val current = file_read(registry_path)
            if file_hash_sha256(registry_path) != expected_registry_sha256:
                result = ReleaseCheck(valid: false, reason: "release session registry changed during close")
            else:
                val output_root = _private_output_root(trusted_root, claimed.session_id)
                val cache_root = _private_cache_root(trusted_root, claimed.session_id)
                var active_line = ""
                for line in current.split("\n"):
                    if _active_record_matches(line, claimed, trusted_root, output_root, cache_root):
                        active_line = line
                        break
                if active_line == "":
                    result = ReleaseCheck(valid: false, reason: "release session active registry record is missing")
                else:
                    val closed_line = "closed|" + active_line.slice("active|".len(), active_line.len())
                    val next = current.replace(active_line + "\n", closed_line + "\n")
                    if not file_atomic_write(registry_path, next):
                        result = ReleaseCheck(valid: false, reason: "release session close registry write failed")
            if not file_unlock(registry_lock):
                result = ReleaseCheck(valid: false, reason: "release session registry lock release failed")
    if not end_release_session_mutation(mutation):
        return ReleaseCheck(valid: false, reason: "release session close lease release failed")
    result

export ReleaseSessionVerification, ReleaseSessionRegistration, ReleaseMutationLease
export verify_release_session, register_release_session, verify_registered_release_session
export begin_release_session_mutation, end_release_session_mutation
export advance_release_session_head
export check_release_session_cleanup, close_release_session
