# Simple CLI - bug-gen command
# Regenerates doc/08_tracking/bug/recent_bugs.md from bug_db.sdn

use std.cli.cli_util (get_cli_args, parse_csv_fields)
use std.cli.log_modes.{parse_log_options, log_options_help, render_progress}
use app.io.mod (file_exists, file_read, file_write)
use std.log.{error}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.time_utils.{timestamp_get_year, timestamp_get_month, timestamp_get_day}

val BUG_DB_PATH = "doc/08_tracking/bug/bug_db.sdn"
val BUG_MD_PATH = "doc/08_tracking/bug/recent_bugs.md"

fn print_help():
    print "Usage: simple bug-gen [options]"
    print ""
    print "Regenerate recent_bugs.md from bug_db.sdn."
    print ""
    print "Options:"
    print "  --db PATH    Read the bug database from PATH"
    print "  -o DIR       Write the generated index into DIR"
    print "  --json       Output summary as JSON"
    for line in log_options_help():
        print "  {line}"
    print "  -h, --help   Show this help"

fn _is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn _json_escape(value: text) -> text:
    val slashes = value.replace("\\", "\\\\")
    val quotes = slashes.replace("\"", "\\\"")
    quotes.replace("\n", "\\n")

struct BugItem:
    id: text
    severity: text
    status: text
    title: text
    file: text
    line: text
    reproducible_by: text
    created_at: text
    updated_at: text
    valid: bool

struct BugLoad:
    bugs: [BugItem]
    # 1-based source line numbers of rows inside the `bugs` table that are
    # present but did NOT fully parse. bug-gen must never regenerate an index
    # from a partial parse: a dropped row silently deletes a real bug from
    # recent_bugs.md, which is the same lossy-regenerate defect class as
    # clobbering a record file. Fail closed instead.
    unparsed_lines: [i64]

fn load_bugs(db_path: text) -> BugLoad:
    if not file_exists(db_path):
        return BugLoad(bugs: [], unparsed_lines: [])

    val content = file_read(db_path)
    val lines = content.split("\n")
    var bugs: [BugItem] = []
    var unparsed: [i64] = []
    var in_table = false
    var line_no = 0

    for line in lines:
        line_no = line_no + 1
        val trimmed = line.trim()
        if trimmed.starts_with("bugs |"):
            in_table = true
            continue
        # End of the `bugs` table: the next unindented, non-empty, non-comment
        # line starts a different table. The previous form of this test asked
        # `trimmed != ""` inside a branch that already required `trimmed == ""`,
        # so it was dead: `in_table` never went back to false and every row of
        # the *following* tables (`bug_investigation_logs`, `bug_fix_strategies`)
        # was fed to the row parser. That was harmless only because unparseable
        # rows were silently dropped; once the parse fails closed it must be
        # correct, or bug-gen refuses to run on a perfectly valid database.
        if in_table and trimmed != "" and not trimmed.starts_with("#") and not line.starts_with(" ") and not line.starts_with("\t"):
            in_table = false
        if not in_table or trimmed == "" or trimmed.starts_with("#"):
            continue

        val fields = parse_csv_fields(trimmed)
        if fields.len() >= 10:
            val valid_str = fields[9]
            bugs.push(BugItem(
                id: fields[0],
                severity: fields[1],
                status: fields[2],
                title: fields[3],
                file: fields[4],
                line: fields[5],
                reproducible_by: fields[6],
                created_at: fields[7],
                updated_at: fields[8],
                valid: valid_str == "true"
            ))
        else:
            unparsed.push(line_no)

    BugLoad(bugs: bugs, unparsed_lines: unparsed)

fn is_open(status: text) -> bool:
    status == "Open" or status == "Investigating" or status == "Confirmed" or status == "open"

fn is_closed(status: text) -> bool:
    status == "Fixed" or status == "Closed" or status == "Wontfix" or
    status == "fixed" or status == "closed" or status == "cannot_reproduce" or
    status == "invalid"

fn _generated_date() -> text:
    # Real current date via the runtime clock (was previously a permanently
    # hardcoded "2026-04-14" stamped into every regenerated bug doc).
    val micros = time_now_unix_micros()
    val year = timestamp_get_year(micros)
    val month = timestamp_get_month(micros)
    val day = timestamp_get_day(micros)
    val month_text = if month < 10: "0" + month.to_string() else: month.to_string()
    val day_text = if day < 10: "0" + day.to_string() else: day.to_string()
    year.to_string() + "-" + month_text + "-" + day_text

fn generate_md(bugs: [BugItem]) -> text:
    var open_bugs: [BugItem] = []
    var closed_bugs: [BugItem] = []

    for b in bugs:
        if not b.valid:
            continue
        if is_open(b.status):
            open_bugs.push(b)
        elif is_closed(b.status):
            closed_bugs.push(b)

    var lines: [text] = []
    lines.push("# Recent Bugs")
    lines.push("")
    lines.push("**Generated:** {_generated_date()}")
    lines.push("**Database:** `{BUG_DB_PATH}`")
    lines.push("**Open:** {open_bugs.len()} | **Closed:** {closed_bugs.len()}")
    lines.push("")
    lines.push("## Open Bugs")
    lines.push("")

    if open_bugs.len() == 0:
        lines.push("No open bugs.")
    else:
        lines.push("| ID | Severity | Status | Title | File |")
        lines.push("|----|----------|--------|-------|------|")
        for b in open_bugs:
            lines.push("| {b.id} | {b.severity} | {b.status} | {b.title} | `{b.file}:{b.line}` |")

    lines.push("")
    lines.push("## Closed Bugs")
    lines.push("")

    if closed_bugs.len() == 0:
        lines.push("No closed bugs.")
    else:
        lines.push("| ID | Severity | Status | Title | Updated |")
        lines.push("|----|----------|--------|-------|---------|")
        for b in closed_bugs:
            lines.push("| {b.id} | {b.severity} | {b.status} | {b.title} | {b.updated_at} |")

    lines.push("")
    lines.join("\n")

fn main() -> i64:
    val args = get_cli_args()
    val log_opts = parse_log_options(args)
    if not log_opts.valid:
        error("bug-gen", log_opts.error)
        return 1

    var as_json = log_opts.log_mode == "json"
    var db_path = BUG_DB_PATH
    var md_path = BUG_MD_PATH
    var ai = 0
    while ai < args.len():
        val arg = args[ai]
        if arg == "-h" or arg == "--help":
            print_help()
            return 0
        elif arg == "--json" or arg == "--log-mode=json":
            as_json = true
        elif arg == "--db":
            if ai + 1 < args.len():
                db_path = args[ai + 1]
            ai = ai + 1
        elif arg.starts_with("--db="):
            db_path = arg.substring(5, arg.len())
        elif arg == "-o" or arg == "--out":
            # -o names a DIRECTORY. bug-gen only ever writes its own generated
            # index inside it — never a per-bug record file, and never a delete.
            if ai + 1 < args.len():
                md_path = args[ai + 1] + "/recent_bugs.md"
            ai = ai + 1
        elif arg == "--log-mode" or arg == "--surface" or arg == "--progress":
            ai = ai + 1
        elif _is_log_option(arg):
            pass
        ai = ai + 1

    val loaded = load_bugs(db_path)
    if loaded.unparsed_lines.len() > 0:
        # Fail closed: leave every existing file exactly as it was.
        var refs: [text] = []
        for n in loaded.unparsed_lines:
            refs.push(db_path + ":" + n.to_string())
        val msg = "refusing to regenerate from a partial parse: " +
            loaded.unparsed_lines.len().to_string() +
            " row(s) in the `bugs` table did not fully parse (" +
            refs.join(", ") + "); nothing was written"
        print "error[bug-gen]: {msg}"
        error("bug-gen", msg)
        return 1

    val bugs = loaded.bugs
    val md = generate_md(bugs)
    file_write(md_path, md)
    if log_opts.progress != "summary":
        val progress_line = render_progress(log_opts.progress, bugs.len(), bugs.len(), "bug-gen")
        if progress_line != "":
            print progress_line
    if as_json:
        val md_json = _json_escape(md_path)
        print "{\"command\":\"bug-gen\",\"status\":\"ok\",\"bugs\":{bugs.len()},\"output\":\"{md_json}\"}"
    else:
        print "Generated {md_path} ({bugs.len()} bugs)"
    0
