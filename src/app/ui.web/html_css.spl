    parts.push(".wm-privacy-action { min-height: 36px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); color: {fg}; background: rgba(255,255,255,0.08); font-size: 12px; font-weight: 750; }\n")
    parts.push(".wm-privacy-action:hover, .wm-privacy-action.active { background: rgba({accent_rgb},0.18); border-color: rgba({accent_rgb},0.62); }\n")
    parts.push(".wm-window-overview { position: fixed; inset: 0; z-index: 11000; display: grid; align-content: center; gap: 16px; padding: min(8vw, 72px); background: rgba(3,6,18,0.42); backdrop-filter: blur(22px) saturate(165%); -webkit-backdrop-filter: blur(22px) saturate(165%); animation: wm-overview-in 180ms cubic-bezier(0.22, 0.8, 0.2, 1) both; }\n")
    parts.push(".wm-window-overview[hidden] { display: none; }\n")
    parts.push(".wm-overview-title { color: {fg}; font: 700 18px var(--ui-font-display); text-align: center; }\n")
    parts.push(".wm-overview-search { width: min(420px, calc(100vw - 36px)); justify-self: center; height: 42px; border-radius: 18px; border: 1px solid rgba(255,255,255,0.16); padding: 0 14px; color: {fg}; background: linear-gradient(180deg, rgba(255,255,255,0.15), rgba(255,255,255,0.07)), {panel_bg}; outline: none; }\n")
    parts.push(".wm-overview-search:focus { border-color: rgba({accent_rgb},0.58); box-shadow: 0 0 0 3px rgba({accent_rgb},0.16); }\n")
    parts.push(".wm-overview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 260px)); justify-content: center; gap: 14px; }\n")
    parts.push(".wm-overview-card { min-height: 138px; display: grid; grid-template-columns: 38px minmax(0, 1fr); grid-template-areas: 'icon title' 'icon meta'; align-content: center; gap: 4px 12px; padding: 18px; border-radius: 22px; border: 1px solid rgba(255,255,255,0.18); color: {fg}; background: linear-gradient(180deg, rgba(255,255,255,0.16), rgba(255,255,255,0.07)), {panel_bg}; box-shadow: 0 24px 70px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.16); backdrop-filter: blur(26px) saturate(170%); -webkit-backdrop-filter: blur(26px) saturate(170%); text-align: left; transition: transform 150ms ease, border-color 150ms ease, background 150ms ease; }\n")
    parts.push(".wm-overview-card:hover, .wm-overview-card.active { transform: translateY(-4px) scale(1.025); border-color: rgba({accent_rgb},0.68); background: linear-gradient(180deg, rgba({accent_rgb},0.18), rgba(255,255,255,0.08)), {panel_bg}; }\n")
    parts.push(".wm-window-overview.action-feedback { filter: saturate(1.08); }\n")
    parts.push(".wm-overview-card.action-feedback, .wm-window-overview[data-overview-feedback='activate'] .wm-overview-card[data-overview-feedback='activate'] { animation: wm-overview-card-activate 540ms var(--ui-motion-spring) both; border-color: rgba({accent_rgb},0.82); background: linear-gradient(180deg, rgba({accent_rgb},0.24), rgba(255,255,255,0.09)), {panel_bg}; }\n")
    parts.push(":root[data-wm-motion=off] .wm-overview-card.action-feedback { animation: none !important; transform: none !important; filter: none !important; }\n")
    parts.push(".wm-overview-card.minimized { opacity: 0.62; }\n")
    parts.push(".wm-overview-icon { grid-area: icon; width: 38px; height: 38px; display: inline-grid; place-items: center; }\n")
    parts.push(".wm-overview-card-title { grid-area: title; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }\n")
    parts.push(".wm-overview-card-meta { grid-area: meta; color: {dim_fg}; font-size: 12px; }\n")
    parts.push(".wm-overview-empty { min-height: 96px; display: grid; place-items: center; color: {dim_fg}; border-radius: 18px; border: 1px dashed rgba(255,255,255,0.18); }\n")
    parts.push(".wm-title-context { justify-self: end; min-width: 80px; max-width: 220px; height: 22px; border-radius: 999px; padding: 0 10px; display: flex; align-items: center; color: {dim_fg}; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.10); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n")
    parts.push(".wm-traffic-lights { display: flex; gap: 40px; }\n")
    parts.push(".wm-traffic-lights button { position: relative; width: 46px; height: 46px; margin: -17px; border-radius: 999px; border: none; cursor: pointer; padding: 0; color: transparent; background: transparent; box-shadow: none; transition: transform 120ms ease, filter 120ms ease; }\n")
    parts.push(".wm-traffic-lights button::before { content: ''; position: absolute; inset: 17px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.16), 0 1px 4px rgba(0,0,0,0.22); }\n")
    parts.push(".wm-traffic-lights button::after { content: ''; position: absolute; inset: 19px; display: grid; place-items: center; color: rgba(20,20,24,0.72); font: 900 8px/1 var(--ui-font-label); opacity: 0; transform: scale(0.82); transition: opacity 120ms ease, transform 120ms ease; }\n")
    parts.push(".wm-traffic-lights:hover button::after, .wm-traffic-lights button:focus-visible::after { opacity: 1; transform: scale(1); }\n")
    parts.push(".wm-traffic-lights button:focus-visible, .wm-taskbar-item:focus-visible, .wm-command-item:focus-visible, .wm-effect-control:focus-visible, .wm-title-input:focus-visible, .wm-command-palette-input:focus-visible { outline: 2px solid rgba({accent_rgb},0.82); outline-offset: 3px; }\n")
    parts.push(".wm-traffic-lights button:hover { transform: scale(1.08); filter: brightness(1.06); }\n")
    parts.push(".wm-traffic-lights button.commanding { animation: wm-traffic-command 300ms var(--ui-motion-spring) both; filter: brightness(1.12) saturate(1.12); }\n")
    parts.push(".wm-traffic-lights button.commanding::before { animation: wm-traffic-command-ring 300ms var(--ui-motion-spring) both; box-shadow: 0 0 0 0 rgba({accent_rgb},0.36); }\n")
    parts.push(".wm-btn-close::before { background: {wm_close}; }\n")
    parts.push(".wm-btn-minimize::before { background: {wm_min}; }\n")
    parts.push(".wm-btn-maximize::before { background: {wm_max}; }\n")
    parts.push(".wm-btn-close::after { content: 'x'; }\n")
    parts.push(".wm-btn-minimize::after { content: '-'; }\n")
    parts.push(".wm-btn-maximize::after { content: '+'; }\n")
    parts.push(".wm-btn-close:hover::before { background: {wm_close_hover}; }\n")
    parts.push(".wm-btn-minimize:hover::before { background: {wm_min_hover}; }\n")
    parts.push(".wm-btn-maximize:hover::before { background: {wm_max_hover}; }\n")
    parts.push("@keyframes wm-traffic-command { 0% { transform: scale(1); } 46% { transform: scale(0.82); } 100% { transform: scale(1.08); } }\n")
    parts.push("@keyframes wm-traffic-command-ring { 0% { opacity: 0.72; transform: scale(0.72); box-shadow: 0 0 0 0 rgba({accent_rgb},0.30); } 100% { opacity: 0; transform: scale(1.9); box-shadow: 0 0 0 8px rgba({accent_rgb},0); } }\n")
    parts.push("@keyframes wm-title-command-submit { 0% { transform: scale(1); filter: saturate(1); } 45% { transform: scale(1.018); filter: saturate(1.16); } 100% { transform: scale(1); filter: saturate(1); } }\n")
    parts.push("@keyframes wm-command-query-feedback { 0% { transform: scale(1); filter: saturate(1); } 45% { transform: scale(1.006); filter: saturate(1.14); } 100% { transform: scale(1); filter: saturate(1.02); } }\n")
    parts.push("@keyframes wm-command-query-status-feedback { 0% { transform: translateY(1px); opacity: 0.74; } 45% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(0); opacity: 0.92; } }\n")
    parts.push("@keyframes wm-command-match-feedback { 0% { transform: scale(1); filter: saturate(1); } 45% { transform: scale(1.035); filter: saturate(1.18); } 100% { transform: scale(1); filter: saturate(1.04); } }\n")
    parts.push("@keyframes wm-command-selection-feedback { 0% { transform: translateX(0) scale(1); filter: saturate(1); } 45% { transform: translateX(3px) scale(1.006); filter: saturate(1.12); } 100% { transform: translateX(0) scale(1); filter: saturate(1.02); } }\n")
    parts.push("@keyframes wm-command-selection-part-feedback { 0% { transform: scale(1); filter: saturate(1); } 45% { transform: scale(1.08); filter: saturate(1.16); } 100% { transform: scale(1); filter: saturate(1.02); } }\n")
    parts.push("@keyframes wm-command-item-feedback { 0% { transform: translateY(0) scale(1); filter: saturate(1); } 44% { transform: translateY(-2px) scale(1.012); filter: saturate(1.18); } 100% { transform: translateY(0) scale(1); filter: saturate(1.04); } }\n")
    parts.push("@keyframes wm-command-item-part-feedback { 0% { transform: scale(1); filter: saturate(1); } 44% { transform: scale(1.12); filter: saturate(1.24); } 100% { transform: scale(1); filter: saturate(1.04); } }\n")
    parts.push("@keyframes wm-command-recent-feedback { 0% { transform: translateY(0) scale(1); filter: saturate(1); } 44% { transform: translateY(-4px) scale(1.035); filter: saturate(1.2); } 100% { transform: translateY(0) scale(1); filter: saturate(1.04); } }\n")
    parts.push("@keyframes wm-command-recent-icon-feedback { 0% { transform: scale(1); filter: saturate(1); } 44% { transform: scale(1.16); filter: saturate(1.26); } 100% { transform: scale(1); filter: saturate(1.04); } }\n")
    parts.push("@keyframes wm-title-suggestion-accept { 0% { transform: translateX(2px) scale(1); filter: saturate(1); } 45% { transform: translateX(4px) scale(1.018); filter: saturate(1.18); } 100% { transform: translateX(2px) scale(1); filter: saturate(1); } }\n")
    # WM app body classes — consumed by ws_handler._build_wm_app_html().
    # These replace the previous inline styles so the Web WM stays in sync
    # with the rest of the glass theme.
    parts.push(".wm-app-container { display: flex; flex-direction: column; height: 100%; padding: 0; margin: 0; }\n")
    parts.push(".wm-app-titlebar { padding: 12px 16px; font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: {accent}; font-weight: 650; border-bottom: 1px solid {border_color}; background: linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.03)); }\n")
    parts.push(".wm-app-content { flex: 1; padding: 16px; overflow: auto; white-space: pre-wrap; font-family: 'Fira Code', 'Cascadia Code', 'SF Mono', monospace; font-size: 13px; line-height: 1.6; color: {fg}; }\n")
    parts.push(".wm-body, .wm-content { flex: 1; overflow: auto; position: relative; padding: 0; background: rgba(255,255,255,0.025); }\n")
    parts.push(".wm-content #app { min-height: auto; padding: 16px 18px; }\n")
    parts.push(".wm-resize-handle { position: absolute; z-index: 4; border: 0; padding: 0; background: transparent; color: transparent; }\n")
    parts.push(".wm-resize-handle::before { content: ''; position: absolute; inset: -10px; border-radius: 999px; }\n")
    parts.push(".wm-resize-handle::after { content: ''; position: absolute; opacity: 0; transition: opacity 120ms ease, transform 120ms ease, box-shadow 120ms ease; }\n")
    parts.push(".wm-window:hover .wm-resize-handle::after, .wm-resize-handle:focus-visible::after, .wm-window[data-resize-active='true'] .wm-resize-handle::after { opacity: 1; }\n")
    parts.push(".wm-window[data-resize-active='true'][data-resize-direction='se'] .wm-resize-se::after, .wm-window[data-resize-active='true'][data-resize-direction='sw'] .wm-resize-sw::after, .wm-window[data-resize-active='true'][data-resize-direction='ne'] .wm-resize-ne::after, .wm-window[data-resize-active='true'][data-resize-direction='nw'] .wm-resize-nw::after, .wm-window[data-resize-active='true'][data-resize-direction='e'] .wm-resize-e::after, .wm-window[data-resize-active='true'][data-resize-direction='w'] .wm-resize-w::after, .wm-window[data-resize-active='true'][data-resize-direction='n'] .wm-resize-n::after, .wm-window[data-resize-active='true'][data-resize-direction='s'] .wm-resize-s::after { opacity: 1; transform: scale(1.22); animation: wm-resize-edge-pulse 900ms ease-in-out infinite; background: rgba({accent_rgb},0.82); box-shadow: 0 0 0 1px rgba(255,255,255,0.34) inset, 0 0 22px rgba({accent_rgb},0.46); }\n")
    parts.push(".wm-ghost.resize-active { border-color: rgba({accent_rgb},0.70); box-shadow: 0 0 0 2px rgba({accent_rgb},0.24), 0 24px 68px rgba(0,0,0,0.36); }\n")
    parts.push(".wm-resize-se { right: 0; bottom: 0; width: 16px; height: 16px; cursor: se-resize; }\n")
    parts.push(".wm-resize-se::after { right: 3px; bottom: 3px; width: 10px; height: 10px; border-radius: 999px; background: rgba({accent_rgb},0.58); box-shadow: 0 0 0 1px rgba(255,255,255,0.28) inset, 0 0 18px rgba({accent_rgb},0.24); }\n")
    parts.push(".wm-resize-e { right: 0; top: 32px; width: 4px; bottom: 0; cursor: e-resize; }\n")
    parts.push(".wm-resize-e::after, .wm-resize-w::after { top: 12px; bottom: 12px; width: 2px; border-radius: 999px; background: rgba({accent_rgb},0.38); }\n")
    parts.push(".wm-resize-e::after { right: 1px; }\n")
    parts.push(".wm-resize-s { left: 0; bottom: 0; right: 0; height: 4px; cursor: s-resize; }\n")
    parts.push(".wm-resize-s::after, .wm-resize-n::after { left: 18px; right: 18px; height: 2px; border-radius: 999px; background: rgba({accent_rgb},0.34); }\n")
    parts.push(".wm-resize-s::after { bottom: 1px; }\n")
    parts.push(".wm-resize-sw { left: 0; bottom: 0; width: 16px; height: 16px; cursor: sw-resize; }\n")
    parts.push(".wm-resize-sw::after { left: 3px; bottom: 3px; width: 10px; height: 10px; border-radius: 999px; background: rgba({accent_rgb},0.42); box-shadow: 0 0 0 1px rgba(255,255,255,0.22) inset; }\n")
    parts.push(".wm-resize-w { left: 0; top: 32px; width: 4px; bottom: 0; cursor: w-resize; }\n")
    parts.push(".wm-resize-w::after { left: 1px; }\n")
    parts.push(".wm-resize-n { left: 0; top: 0; right: 0; height: 4px; cursor: n-resize; }\n")
    parts.push(".wm-resize-n::after { top: 1px; }\n")
    parts.push(".wm-resize-nw { left: 0; top: 0; width: 16px; height: 16px; cursor: nw-resize; }\n")
    parts.push(".wm-resize-nw::after { left: 3px; top: 3px; width: 10px; height: 10px; border-radius: 999px; background: rgba({accent_rgb},0.30); }\n")
    parts.push(".wm-resize-ne { right: 0; top: 0; width: 16px; height: 16px; cursor: ne-resize; }\n")
    parts.push(".wm-resize-ne::after { right: 3px; top: 3px; width: 10px; height: 10px; border-radius: 999px; background: rgba({accent_rgb},0.30); }\n")
    parts.push("#wm-taskbar { position: fixed; bottom: max(10px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 7px 12px; background: linear-gradient(180deg, rgba(255,255,255,0.14), rgba(255,255,255,0.06)), {panel_bg}; border: 1px solid rgba(255,255,255,0.18); border-radius: var(--ui-corner-taskbar-radius); backdrop-filter: blur(28px) saturate(175%); -webkit-backdrop-filter: blur(28px) saturate(175%); box-shadow: 0 18px 48px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.16); z-index: 10000; transition: transform 180ms var(--ui-motion-spring), opacity 160ms ease, filter 160ms ease; }\n")
    parts.push(":root[data-wm-dock-visibility=auto] #wm-taskbar { transform: translateX(-50%) translateY(calc(var(--ui-dock-offset-y-px) * 1px)); opacity: 0.42; filter: saturate(0.82); }\n")
    parts.push(":root[data-wm-dock-visibility=auto] #wm-taskbar:hover, :root[data-wm-dock-visibility=auto] #wm-taskbar:focus-within { transform: translateX(-50%) translateY(0); opacity: 1; filter: saturate(1); }\n")
    parts.push(":root[data-wm-dock-visibility=hidden] #wm-taskbar { transform: translateX(-50%) translateY(calc(var(--ui-dock-offset-y-px) * 1px)); opacity: 0.18; filter: saturate(0.7); }\n")
    parts.push(":root[data-wm-dock-visibility=hidden] #wm-taskbar:hover, :root[data-wm-dock-visibility=hidden] #wm-taskbar:focus-within { transform: translateX(-50%) translateY(0); opacity: 1; filter: saturate(1); }\n")
    parts.push(".wm-taskbar-section { display: flex; align-items: center; gap: 6px; }\n")
    parts.push(".wm-taskbar-item { position: relative; overflow: visible; min-width: 44px; min-height: 44px; padding: 4px 12px 4px 7px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 550; color: {dim_fg}; white-space: nowrap; border: 1px solid transparent; transition: background 150ms ease, color 150ms ease, transform 150ms ease, border-color 150ms ease; }\n")
    parts.push(".wm-taskbar-item:hover { background: {hover_bg}; transform: translateY(-3px) scale(1.04); }\n")
    parts.push(".wm-taskbar-item.active { background: rgba({accent_rgb},0.15); color: {accent}; font-weight: 600; }\n")
    parts.push(".wm-taskbar-item.attention { border-color: rgba({accent_rgb},0.54); animation: wm-taskbar-attention 900ms cubic-bezier(0.22,0.8,0.2,1) both; }\n")
    parts.push(".wm-taskbar-item.launching { color: {fg}; border-color: rgba({accent_rgb},0.72); background: rgba({accent_rgb},0.18); animation: wm-launch-feedback 760ms cubic-bezier(0.18,0.86,0.28,1) both; }\n")
    parts.push(".wm-taskbar-item.launching .wm-taskbar-icon { animation: wm-launch-icon-pop 760ms cubic-bezier(0.18,0.86,0.28,1) both; }\n")
    parts.push(".wm-taskbar-item.minimized { opacity: 0.5; }\n")
    parts.push(".wm-taskbar-icon { width: 26px; height: 26px; min-width: 26px; border-radius: 999px; display: inline-grid; place-items: center; overflow: hidden; background: linear-gradient(135deg, rgba({accent_rgb},0.72), rgba(255,255,255,0.18)); color: {fg}; font-size: 11px; font-weight: 750; box-shadow: inset 0 1px 0 rgba(255,255,255,0.20), 0 3px 10px rgba(0,0,0,0.24); }\n")
    parts.push(".wm-taskbar-label { max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n")
    parts.push(".wm-taskbar-badge { position: absolute; top: -5px; right: -4px; min-width: 16px; height: 16px; padding: 0 4px; display: inline-grid; place-items: center; border-radius: 999px; color: #fff; background: #ef4444; font-size: 9px; font-weight: 850; line-height: 1; box-shadow: 0 6px 16px rgba(0,0,0,0.28), 0 0 0 2px rgba(12,12,18,0.82); animation: wm-taskbar-badge-pulse 1400ms ease-in-out infinite; }\n")
    parts.push(".wm-taskbar-tray { height: 28px; min-width: 28px; border-radius: 999px; padding: 0 8px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.07); color: {dim_fg}; font-size: 11px; }\n")
    parts.push(".wm-taskbar-preview { position: fixed; z-index: 11800; width: min(320px, calc(100vw - 24px)); min-height: 104px; display: grid; grid-template-columns: 42px minmax(0, 1fr); align-items: center; gap: 12px; padding: 14px; border-radius: 22px; border: 1px solid rgba(255,255,255,0.18); color: {fg}; background: linear-gradient(180deg, rgba(255,255,255,0.17), rgba(255,255,255,0.07)), {panel_bg}; box-shadow: 0 24px 72px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.18); backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%); animation: wm-taskbar-preview-in 150ms cubic-bezier(0.22, 0.8, 0.2, 1) both; pointer-events: auto; }\n")
    parts.push(".wm-taskbar-preview[hidden] { display: none; }\n")
    parts.push(".wm-taskbar-preview-icon { width: 42px; height: 42px; display: inline-grid; place-items: center; }\n")
    parts.push(".wm-taskbar-preview-body { min-width: 0; display: grid; gap: 3px; }\n")
    parts.push(".wm-taskbar-preview-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 700 14px var(--ui-font-display); }\n")
    parts.push(".wm-taskbar-preview-meta { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: {dim_fg}; font-size: 12px; }\n")
    parts.push(".wm-taskbar-preview-status { color: {accent}; font-size: 11px; font-weight: 700; }\n")
    parts.push(".wm-taskbar-preview-actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 8px; }\n")
    parts.push(".wm-taskbar-preview-action { width: 30px; height: 30px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); background: rgba(255,255,255,0.08); color: {fg}; font-size: 11px; font-weight: 850; display: inline-grid; place-items: center; cursor: pointer; transition: transform 140ms ease, background 140ms ease, border-color 140ms ease; }\n")
    parts.push(".wm-taskbar-preview-action:hover { transform: translateY(-2px) scale(1.05); background: rgba({accent_rgb},0.18); border-color: rgba({accent_rgb},0.46); }\n")
    parts.push(".wm-tooltip { position: fixed; z-index: 13000; max-width: min(280px, calc(100vw - 24px)); transform: translate(-50%, -100%); padding: 7px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.18); color: {fg}; background: linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08)), {panel_bg}; box-shadow: 0 16px 44px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.18); backdrop-filter: blur(22px) saturate(170%); -webkit-backdrop-filter: blur(22px) saturate(170%); font-size: 11px; font-weight: 760; pointer-events: none; white-space: nowrap; animation: wm-tooltip-in 110ms cubic-bezier(0.22,0.8,0.2,1) both; }\n")
    parts.push(".wm-tooltip[hidden] { display: none; }\n")
    parts.push(":root[data-wm-motion=reduced] .wm-tooltip { animation: none !important; transition-duration: 80ms !important; filter: none !important; }\n")
    parts.push(":root[data-wm-motion=off] .wm-tooltip { animation: none !important; transition: none !important; transform: translate(-50%, -100%) !important; filter: none !important; }\n")
    parts.push(":root[data-wm-motion=reduced] .wm-taskbar-item.launching, :root[data-wm-motion=reduced] .wm-app-launcher-tile.launching { animation: none !important; }\n")
    parts.push(":root[data-wm-motion=off] .wm-taskbar-item.launching, :root[data-wm-motion=off] .wm-app-launcher-tile.launching { animation: none !important; transform: none !important; }\n")
    parts.push("@media (prefers-reduced-motion: reduce) { .wm-tooltip { animation: none !important; transition: none !important; filter: none !important; } }\n")
    parts.push("@keyframes wm-window-open { 0% { opacity: 0; transform: translate3d(0,18px,0) scale(0.94); filter: blur(5px) saturate(0.86); box-shadow: 0 4px 20px rgba(0,0,0,0.20); } 62% { opacity: 1; transform: translate3d(0,-2px,0) scale(1.012); filter: blur(0) saturate(1.02); } 100% { opacity: 1; transform: translate3d(0,0,0) scale(1); filter: blur(0) saturate(1); } }\n")
