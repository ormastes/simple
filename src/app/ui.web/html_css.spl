        result = "{result}{ios_css}"

    # Apply theme colors — interpolation doesn't work inside .push() calls,
    # so we replace template placeholders with actual color values here.
    val p_bg = "{" + "bg" + "}"
    val p_fg = "{" + "fg" + "}"
    val p_border = "{" + "border_color" + "}"
    val p_accent = "{" + "accent" + "}"
    val p_accent_rgb = "{" + "accent_rgb" + "}"
    val p_panel = "{" + "panel_bg" + "}"
    val p_hover = "{" + "hover_bg" + "}"
    val p_success = "{" + "success" + "}"
    val p_error = "{" + "error" + "}"
    val p_warning = "{" + "warning" + "}"
    val p_dim = "{" + "dim_fg" + "}"
    val p_surface = "{" + "surface_bg" + "}"
    val p_body_background = "{" + "body_background" + "}"
    val p_font_sans = "{" + "ui_font_sans" + "}"
    val p_font_display = "{" + "ui_font_display" + "}"
    val p_font_body = "{" + "ui_font_body" + "}"
    val p_font_label = "{" + "ui_font_label" + "}"
    val p_wm_window_radius = "{" + "wm_window_radius" + "}"
    result = result.replace(p_bg, bg)
    result = result.replace(p_fg, fg)
    result = result.replace(p_border, border_color)
    result = result.replace(p_accent, accent)
    result = result.replace(p_accent_rgb, accent_rgb)
    result = result.replace(p_panel, panel_bg)
    result = result.replace(p_hover, hover_bg)
    result = result.replace(p_success, success)
    result = result.replace(p_error, error)
    result = result.replace(p_warning, warning)
    result = result.replace(p_dim, dim_fg)
    result = result.replace(p_surface, surface_bg)
    result = result.replace(p_body_background, body_background)
    result = result.replace(p_bg, bg)
    result = result.replace(p_surface, surface_bg)
    result = result.replace(p_accent_rgb, accent_rgb)
    result = result.replace(p_font_sans, ui_font_sans)
    result = result.replace(p_font_display, ui_font_display)
    result = result.replace(p_font_body, ui_font_body)
    result = result.replace(p_font_label, ui_font_label)
    result = result.replace(p_wm_window_radius, wm_window_radius)
    if is_glass and package_css == "":
        result = "{result}\n/* Glass theme touch-up */\n"
        result = "{result}.widget-panel, .widget-menubar, .widget-statusbar, .widget-dialog, .widget-list, .widget-tabs { backdrop-filter: blur(28px) saturate(175%); -webkit-backdrop-filter: blur(28px) saturate(175%); }\n"
        result = "{result}.widget-button { background-image: linear-gradient(180deg, rgba(255,255,255,0.20), rgba(255,255,255,0.08)); }\n"
        result = "{result}.widget-input, .widget-textfield, .widget-textarea, .widget-dropdown { box-shadow: inset 0 1px 0 rgba(255,255,255,0.08); }\n"
        result = "{result}#app { padding-top: calc(16px + env(safe-area-inset-top)); }\n"
        result = "{result}.widget-menubar { position: sticky; top: calc(6px + env(safe-area-inset-top)); z-index: 120; padding-left: 56px; }\n"
        result = "{result}.widget-menubar { position: relative; padding-left: 70px; }\n"
        result = "{result}.widget-menubar::before { content: ''; position: absolute; left: 16px; top: 50%; transform: translateY(-50%); width: 44px; height: 12px; pointer-events: none; background: radial-gradient(circle at 6px 6px, {wm_close} 5px, transparent 5px), radial-gradient(circle at 22px 6px, {wm_min} 5px, transparent 5px), radial-gradient(circle at 38px 6px, {wm_max} 5px, transparent 5px); }\n"
        result = "{result}@keyframes glass-appear { 0% { opacity: 1; transform: translateY(10px) scale(0.985); } 100% { opacity: 1; transform: translateY(0) scale(1); } }\n"
        result = "{result}.widget-panel { animation: glass-appear 420ms cubic-bezier(0.22, 0.8, 0.2, 1) both; transform-origin: 50% 12%; }\n"
        result = "{result}.widget-panel:nth-of-type(2) { animation-delay: 40ms; }\n"
        result = "{result}.widget-panel:nth-of-type(3) { animation-delay: 80ms; }\n"
        result = "{result}.widget-panel:hover { box-shadow: 0 26px 66px rgba(0,0,0,0.26), 0 0 0 1px rgba(255,255,255,0.12), inset 0 1px 0 rgba(255,255,255,0.14); }\n"
        result = "{result}@media (prefers-reduced-motion: reduce) { .widget-panel { animation: none; } }\n"

    # Responsive / multi-profile layout. Breakpoints imported from
    # common/ui/profile.spl (single source of truth). The webview knows its real
    # device width, so CSS @media selects the size class client-side — combined
    # with the device-width viewport meta this makes the phone (compact) layout
    # readable instead of a shrunk-down desktop page.
    result = "{result}{responsive_css(default_breakpoints())}"

    result = result.replace("{" + "wm_close" + "}", WM_TRAFFIC_CLOSE)
    result = result.replace("{" + "wm_min" + "}", WM_TRAFFIC_MIN)
    result = result.replace("{" + "wm_max" + "}", WM_TRAFFIC_MAX)
    result = result.replace("{" + "wm_close_hover" + "}", WM_TRAFFIC_CLOSE_HOVER)
    result = result.replace("{" + "wm_min_hover" + "}", WM_TRAFFIC_MIN_HOVER)
    result = result.replace("{" + "wm_max_hover" + "}", WM_TRAFFIC_MAX_HOVER)

    # The resolved folder package is the final visual authority. This adapter's
    # preceding CSS supplies shared structure and compatibility fallbacks only.
    # Keep identity beside the CSS so renderer evidence can bind the submitted
    # stylesheet to the same content-addressed package used by WM chrome.
    if package_css != "":
        result = result + "\n/* Folder theme package theme=" + canonical_theme +
            " fingerprint=" + resolved_fingerprint + " */\n"
        result = result + package_css

    return result

fn build_modern_theme_css(theme: text) -> text:
    """Build the modern WM theme CSS through the canonical generator."""
    return generate_css(theme)

fn _wm_css(theme: text) -> text:
    """Compatibility alias for WM CSS generation."""
    return build_modern_theme_css(theme)

fn generate_package_authoritative_css(
    canonical_theme: text,
    resolved_fingerprint: text,
    package_css: text
) -> text:
    """Emit the full Web DOM adapter while a folder package owns appearance.

    This is deliberately a structural sheet: it owns selector shape, layout,
    hit targets, focus routing, visibility and motion policy. Values that paint
    pixels (fills, borders, shadows, opacity and material filters) are package
    variables. Keep the marker on its own CSS line so package rules begin at a
    valid boundary in every renderer.
    """
    val parts = StringBuilder.new()
    parts.push("/* Canonical package-only Web WM adapter: structural rules only. */\n")
    parts.push("*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n")
    parts.push("html, body, #app, #wm-desktop { min-height: 100%; }\n")
    parts.push("html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\n")
    parts.push("body { min-height: 100vh; overflow: auto; line-height: var(--ui-line-height); font-family: var(--font-main); font-size: var(--font-size-base); color: var(--ui-fg); background: var(--ui-body-background); }\n")
    parts.push("body::before, body::after { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: var(--ui-backdrop-z-index); }\n")
    parts.push("body::before { background: var(--ui-body-overlay-before); opacity: var(--ui-body-overlay-before-opacity); }\n")
    parts.push("body::after { background: var(--ui-body-overlay-after); mix-blend-mode: var(--ui-body-overlay-after-blend-mode); }\n")
    parts.push("button, input, select, textarea { font: inherit; } button { cursor: pointer; } button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: var(--ui-focus-outline); outline-offset: var(--ui-focus-outline-offset); }\n")
    # Images keep intrinsic size inside flex panels (align-items:stretch would
    # otherwise blow them up to full row width); max-width still caps overflow.
    parts.push(".widget-image { align-self: flex-start; max-width: 100%; height: auto; object-fit: contain; }\n")
    parts.push("#app { position: relative; z-index: var(--ui-app-z-index); display: flex; flex-direction: column; min-height: 100vh; padding: var(--ui-app-padding); gap: var(--ui-layout-panel-gap); } #app > * { position: relative; z-index: var(--ui-content-z-index); }\n")
    parts.push(".layout-vbox { display: flex; flex-direction: column; } .layout-hbox { display: flex; flex-direction: row; } .layout-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--ui-layout-grid-min), 1fr)); gap: var(--ui-layout-grid-gap); }\n")
    parts.push(".widget-panel, .widget-dialog, .widget-menubar, .widget-statusbar, .widget-tab-bar, .widget-list, .widget-table, .widget-card, .wm-top-menu-bar, .wm-window, .wm-command-palette, .wm-command-bar, .wm-snap-preview, .wm-ghost, .wm-snap-layout-palette, .wm-window-arrange-palette, .wm-control-center, .wm-window-overview, .wm-stage-rail, .wm-window-switcher, .wm-workspace-switcher, .wm-clipboard-history, .wm-screen-capture-overlay, .wm-quick-settings, .wm-notification-center, .wm-live-activity, .wm-app-launcher, .wm-dock-stack, .wm-accent-palette, .wm-wallpaper-picker, .wm-shortcut-overlay, .wm-window-context-menu, .wm-title-suggestions, .wm-widget-gallery, .wm-resize-hud, .wm-gesture-hints, .wm-system-hud, .wm-privacy-indicator { color: var(--ui-surface-text); background: var(--ui-surface-background); border: var(--ui-surface-border-width) solid var(--ui-surface-border); border-radius: var(--ui-surface-radius); box-shadow: var(--ui-surface-shadow); backdrop-filter: var(--ui-surface-backdrop-filter); -webkit-backdrop-filter: var(--ui-surface-backdrop-filter); opacity: var(--ui-surface-opacity); }\n")
    parts.push(".widget-panel, .widget-dialog, .widget-card { display: flex; flex-direction: column; overflow: hidden; } .panel-title { padding: var(--ui-panel-title-padding); color: var(--ui-panel-title-text); background: var(--ui-panel-title-background); border-bottom: var(--ui-panel-title-border-width) solid var(--ui-panel-title-border); font: var(--ui-panel-title-font); } .panel-content { flex: 1; overflow: auto; padding: var(--ui-panel-content-padding); display: flex; flex-direction: column; gap: var(--ui-panel-content-gap); }\n")
    parts.push(".widget-panel.focused, .widget-dialog.focused, .widget-card.focused, .wm-window.focused, .wm-window.focus-acquired { border-color: var(--ui-focus-border); box-shadow: var(--ui-focus-shadow); } .widget-panel:hover, .widget-card:hover { transform: var(--ui-surface-hover-transform); transition: var(--ui-interaction-transition); }\n")
    # Preserve the established package-authority selector contract used by
    # existing Web theme consumers while keeping the recipe package-owned.
    parts.push(".widget-panel.focused, .wm-window.focused { border-color: var(--ui-focus-border); box-shadow: var(--ui-focus-shadow); }\n")
    parts.push(".widget-button, .widget-checkbox, .widget-radio, .widget-switch, .widget-dropdown, .widget-tab, .menu-item, .tab-bar-item, .tab-item, .wm-command-item, .wm-snap-layout-choice, .wm-control-button, .wm-taskbar-item, .wm-title-suggestion-item { min-height: var(--ui-control-min-height); padding: var(--ui-control-padding); color: var(--ui-control-text); background: var(--ui-control-background); border: var(--ui-control-border-width) solid var(--ui-control-border); border-radius: var(--ui-control-radius); box-shadow: var(--ui-control-shadow); transition: var(--ui-interaction-transition); }\n")
    parts.push(".widget-button:hover, .widget-checkbox:hover, .widget-radio:hover, .widget-switch:hover, .widget-dropdown:hover, .widget-tab:hover, .menu-item:hover, .tab-bar-item:hover, .tab-item:hover, .wm-command-item:hover, .wm-snap-layout-choice:hover, .wm-control-button:hover, .wm-taskbar-item:hover, .wm-title-suggestion-item:hover { color: var(--ui-control-hover-text); background: var(--ui-control-hover-background); border-color: var(--ui-control-hover-border); box-shadow: var(--ui-control-hover-shadow); }\n")
    parts.push(".widget-button.active, .widget-button.selected, .widget-tab.active, .tab-bar-item-active, .tab-item.active, .wm-command-item.selected, .wm-snap-layout-choice.selected, .wm-control-button.active, .wm-taskbar-item.active { color: var(--ui-selection-text); background: var(--ui-selection-background); border-color: var(--ui-selection-border); box-shadow: var(--ui-selection-shadow); }\n")
    parts.push(".widget-input, .widget-textfield, .widget-textarea, .widget-dropdown, .table-filter, .wm-title-input, .wm-command-palette-input, .wm-overview-search { min-height: var(--ui-input-min-height); padding: var(--ui-input-padding); color: var(--ui-input-text); background: var(--ui-input-background); border: var(--ui-input-border-width) solid var(--ui-input-border); border-radius: var(--ui-input-radius); box-shadow: var(--ui-input-shadow); backdrop-filter: var(--ui-input-backdrop-filter); -webkit-backdrop-filter: var(--ui-input-backdrop-filter); }\n")
    parts.push(".widget-input:focus, .widget-textfield:focus, .widget-textarea:focus, .widget-dropdown:focus, .table-filter:focus, .wm-title-input:focus, .wm-command-palette-input:focus, .wm-overview-search:focus { border-color: var(--ui-focus-border); box-shadow: var(--ui-focus-shadow); outline: var(--ui-focus-outline); }\n")
    parts.push(".widget-button:disabled, .widget-button[disabled], .widget-checkbox.disabled, .widget-checkbox:disabled, .widget-radio:disabled, .widget-switch:disabled, .widget-input:disabled, .widget-input[disabled], .widget-textfield:disabled, .widget-textfield[disabled], .widget-textarea:disabled, .widget-textarea[disabled], .widget-dropdown:disabled, .widget-dropdown[disabled] { color: var(--ui-disabled-text); background: var(--ui-disabled-background); border-color: var(--ui-disabled-border); box-shadow: var(--ui-disabled-shadow); opacity: var(--ui-disabled-opacity); cursor: not-allowed; transform: none; }\n")
    parts.push(".widget-input[readonly], .widget-textfield[readonly], .widget-textarea[readonly] { color: var(--ui-readonly-text); background: var(--ui-readonly-background); border-color: var(--ui-readonly-border); cursor: default; } .widget-input.error, .widget-textfield.error, .widget-textarea.error, .widget-dropdown.error, [aria-invalid='true'] { color: var(--ui-error-text); background: var(--ui-error-background); border-color: var(--ui-error-border); box-shadow: var(--ui-error-shadow); }\n")
    parts.push(".widget-menubar, .widget-statusbar, .widget-tab-bar { display: flex; align-items: center; gap: var(--ui-toolbar-gap); padding: var(--ui-toolbar-padding); } .widget-statusbar { justify-content: space-between; } .widget-tab-bar { justify-content: center; } .widget-list, .widget-table { overflow: auto; } .widget-table table { width: 100%; border-collapse: collapse; } .widget-table th, .widget-table td { padding: var(--ui-table-cell-padding); border-bottom: var(--ui-table-border-width) solid var(--ui-table-border); }\n")
    parts.push(".widget-progress, .progress-track, .wm-live-activity-progress { overflow: hidden; border-radius: var(--ui-progress-radius); background: var(--ui-progress-track-background); border: var(--ui-progress-track-border-width) solid var(--ui-progress-track-border); } .progress-bar, .widget-progress .progress-bar, .wm-live-activity-bar { display: block; height: 100%; background: var(--ui-progress-bar-background); box-shadow: var(--ui-progress-bar-shadow); } .tab-bar-badge, .wm-taskbar-badge { color: var(--ui-badge-text); background: var(--ui-badge-background); border-radius: var(--ui-badge-radius); box-shadow: var(--ui-badge-shadow); }\n")
    parts.push(".widget-dialog-overlay { position: fixed; inset: 0; z-index: var(--ui-dialog-overlay-z-index); background: var(--ui-dialog-overlay-background); backdrop-filter: var(--ui-dialog-overlay-backdrop-filter); -webkit-backdrop-filter: var(--ui-dialog-overlay-backdrop-filter); } .widget-dialog { position: fixed; top: 50%; left: 50%; z-index: var(--ui-dialog-z-index); min-width: var(--ui-dialog-min-width); max-width: var(--ui-dialog-max-width); transform: translate(-50%, -50%); }\n")
    parts.push(".widget-tooltip { position: relative; display: inline-block; } .tooltip-content { display: none; position: absolute; bottom: 100%; left: 50%; z-index: var(--ui-tooltip-z-index); min-width: var(--ui-tooltip-min-width); margin-bottom: var(--ui-tooltip-margin-bottom); transform: translateX(-50%); pointer-events: none; } .widget-tooltip:hover .tooltip-content, .widget-tooltip:focus-within .tooltip-content { display: block; }\n")
    parts.push(".widget-tree { padding: var(--ui-tree-padding); } .tree-root { list-style: none; padding-left: 0; } .tree-node { padding: var(--ui-tree-node-padding); } .tree-node ul { list-style: none; padding-left: var(--ui-tree-indent); } .tree-toggle { cursor: pointer; display: inline-block; width: var(--ui-tree-toggle-width); color: var(--ui-tree-toggle-color); user-select: none; } .tree-toggle:hover, .tree-toggle:focus-visible { color: var(--ui-tree-toggle-hover-color); } .tree-label { cursor: pointer; padding: var(--ui-tree-label-padding); border-radius: var(--ui-tree-label-radius); } .tree-label:hover { background: var(--ui-tree-label-hover-background); } .tree-node.leaf .tree-label { padding-left: var(--ui-tree-leaf-label-indent); } .tree-node.collapsed > ul { display: none; } .tree-node.expanded > ul { display: block; }\n")
    parts.push("#wm-desktop { position: relative; isolation: isolate; min-height: 100vh; background: var(--ui-desktop-background); } #wm-desktop::before, #wm-desktop::after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: var(--ui-desktop-backdrop-z-index); } #wm-desktop::before { background: var(--ui-desktop-backdrop-before); } #wm-desktop::after { background: var(--ui-desktop-backdrop-after); opacity: var(--ui-desktop-backdrop-opacity); }\n")
    parts.push(".wm-top-menu-bar { position: fixed; left: var(--ui-top-menu-left); right: var(--ui-top-menu-right); top: var(--ui-top-menu-top); z-index: var(--ui-top-menu-z-index); min-height: var(--ui-top-menu-min-height); display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--ui-top-menu-gap); padding: var(--ui-top-menu-padding); } .wm-top-menu-left, .wm-top-menu-right { min-width: 0; display: flex; align-items: center; gap: var(--ui-top-menu-item-gap); overflow: hidden; } .wm-top-menu-right { justify-content: end; }\n")
    parts.push(".wm-window { --wm-minimize-target-x: var(--ui-window-minimize-target-x); --wm-minimize-target-y: var(--ui-window-minimize-target-y); position: absolute; z-index: var(--ui-window-z-index); min-width: var(--ui-window-min-width); min-height: var(--ui-window-min-height); display: flex; flex-direction: column; overflow: hidden; transform-origin: var(--ui-window-transform-origin); transition: var(--ui-window-transition); } .wm-window.opening, .wm-window.restoring, .wm-window.closing, .wm-window.minimizing, .wm-window.snap-committed { animation: var(--ui-window-state-animation); } .wm-window.minimized { display: none; } .wm-window.maximized { left: 0 !important; top: 0 !important; width: 100vw !important; height: calc(100vh - var(--ui-taskbar-reserved-height)) !important; border-radius: 0; }\n")
    parts.push(".wm-titlebar { display: grid; grid-template-columns: auto auto minmax(var(--ui-title-context-min-width), var(--ui-title-context-track)) minmax(var(--ui-title-text-min-width), 1fr) auto; align-items: center; gap: var(--ui-titlebar-gap); min-height: var(--ui-titlebar-height); padding: var(--ui-titlebar-padding); color: var(--ui-titlebar-text); background: var(--ui-titlebar-background); border-bottom: var(--ui-titlebar-border-width) solid var(--ui-titlebar-border); box-shadow: var(--ui-titlebar-shadow); backdrop-filter: var(--ui-titlebar-backdrop-filter); -webkit-backdrop-filter: var(--ui-titlebar-backdrop-filter); cursor: grab; user-select: none; flex-shrink: 0; } .wm-titlebar:active { cursor: grabbing; } .wm-window.focused .wm-titlebar, .wm-window.focus-acquired .wm-titlebar { color: var(--ui-titlebar-focus-text); background: var(--ui-titlebar-focus-background); border-color: var(--ui-titlebar-focus-border); box-shadow: var(--ui-titlebar-focus-shadow); }\n")
    parts.push(".wm-titlebar-icon, .wm-title-icon { width: var(--ui-title-icon-size); height: var(--ui-title-icon-size); display: inline-grid; place-items: center; overflow: hidden; } .wm-titlebar-icon img, .wm-title-icon img, .wm-taskbar-icon img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; display: block; } .wm-title-context, .wm-title, .wm-title-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .wm-title-context { justify-self: end; } .wm-title-controls, .wm-title-actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--ui-title-action-gap); }\n")
    parts.push(".wm-traffic-lights { display: flex; align-items: center; order: var(--ui-traffic-order); gap: var(--ui-traffic-gap); } .wm-traffic-lights button { position: relative; width: var(--ui-traffic-hit-size); height: var(--ui-traffic-hit-size); margin: var(--ui-traffic-hit-margin); padding: 0; border: var(--ui-traffic-border-width) solid var(--ui-traffic-border); border-radius: var(--ui-traffic-hit-radius); color: var(--ui-traffic-hit-color); background: var(--ui-traffic-button-background); box-shadow: var(--ui-traffic-button-shadow); transition: var(--ui-traffic-transition); }\n")
    parts.push(".wm-traffic-lights button::before { content: ''; position: absolute; inset: var(--ui-traffic-dot-inset); display: block; border-radius: var(--ui-traffic-radius); box-shadow: var(--ui-traffic-dot-shadow); } .wm-traffic-lights button::after { content: ''; position: absolute; inset: var(--ui-traffic-glyph-inset); display: grid; place-items: center; color: var(--ui-traffic-glyph-color); font: var(--ui-traffic-glyph-font); opacity: var(--ui-traffic-glyph-opacity); transform: var(--ui-traffic-glyph-transform); transition: var(--ui-traffic-glyph-transition); }\n")
    parts.push(".wm-traffic-lights:hover button::after, .wm-traffic-lights button:focus-visible::after { opacity: var(--ui-traffic-glyph-hover-opacity); transform: var(--ui-traffic-glyph-hover-transform); } .wm-traffic-lights button:hover { transform: var(--ui-traffic-hover-transform); filter: var(--ui-traffic-hover-filter); } .wm-traffic-lights button.commanding { animation: var(--ui-traffic-command-animation); filter: var(--ui-traffic-command-filter); } .wm-traffic-lights button.commanding::before { animation: var(--ui-traffic-command-ring-animation); box-shadow: var(--ui-traffic-command-ring-shadow); }\n")
    parts.push(".wm-btn-close::before { background: var(--ui-traffic-close); } .wm-btn-minimize::before { background: var(--ui-traffic-minimize); } .wm-btn-maximize::before { background: var(--ui-traffic-maximize); } .wm-btn-close::after { content: var(--ui-traffic-close-glyph); } .wm-btn-minimize::after { content: var(--ui-traffic-minimize-glyph); } .wm-btn-maximize::after { content: var(--ui-traffic-maximize-glyph); } .wm-btn-close:hover::before { background: var(--ui-traffic-close-hover); } .wm-btn-minimize:hover::before { background: var(--ui-traffic-minimize-hover); } .wm-btn-maximize:hover::before { background: var(--ui-traffic-maximize-hover); }\n")
    parts.push("#wm-taskbar { position: fixed; left: var(--ui-taskbar-left); bottom: var(--ui-taskbar-bottom); z-index: var(--ui-taskbar-z-index); display: flex; align-items: center; gap: var(--ui-taskbar-gap); padding: var(--ui-taskbar-padding); transform: var(--ui-taskbar-transform); } .wm-taskbar-section { display: flex; align-items: center; gap: var(--ui-taskbar-section-gap); } .wm-taskbar-item { position: relative; overflow: visible; display: inline-flex; align-items: center; gap: var(--ui-taskbar-item-gap); min-width: var(--ui-taskbar-item-size); min-height: var(--ui-taskbar-item-size); white-space: nowrap; } .wm-taskbar-icon { width: var(--ui-taskbar-icon-size); height: var(--ui-taskbar-icon-size); min-width: var(--ui-taskbar-icon-size); display: inline-grid; place-items: center; overflow: hidden; } .wm-taskbar-label { max-width: var(--ui-taskbar-label-max-width); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .wm-taskbar-badge { position: absolute; top: var(--ui-taskbar-badge-top); right: var(--ui-taskbar-badge-right); display: inline-grid; place-items: center; } .wm-taskbar-tray { display: inline-flex; align-items: center; justify-content: center; } .wm-taskbar-preview, .wm-taskbar-context-menu { position: fixed; z-index: var(--ui-taskbar-popup-z-index); }\n")
    parts.push(".wm-taskbar-preview { width: var(--ui-taskbar-preview-width); min-height: var(--ui-taskbar-preview-min-height); display: grid; grid-template-columns: var(--ui-taskbar-preview-columns); align-items: center; gap: var(--ui-taskbar-preview-gap); padding: var(--ui-taskbar-preview-padding); pointer-events: auto; } .wm-taskbar-preview-icon { width: var(--ui-taskbar-preview-icon-size); height: var(--ui-taskbar-preview-icon-size); display: inline-grid; place-items: center; } .wm-taskbar-preview-body { min-width: 0; display: grid; gap: var(--ui-taskbar-preview-body-gap); } .wm-taskbar-preview-title, .wm-taskbar-preview-meta { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .wm-taskbar-preview-title { font: var(--ui-taskbar-preview-title-font); } .wm-taskbar-preview-meta { color: var(--ui-taskbar-preview-meta-color); font-size: var(--ui-taskbar-preview-meta-font-size); } .wm-taskbar-preview-status { color: var(--ui-taskbar-preview-status-color); font-size: var(--ui-taskbar-preview-status-font-size); font-weight: var(--ui-taskbar-preview-status-font-weight); } .wm-taskbar-preview-actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: var(--ui-taskbar-preview-action-gap); } .wm-taskbar-preview-action { width: var(--ui-taskbar-preview-action-size); height: var(--ui-taskbar-preview-action-size); display: inline-grid; place-items: center; cursor: pointer; color: var(--ui-taskbar-preview-action-color); background: var(--ui-taskbar-preview-action-background); border: var(--ui-taskbar-preview-action-border-width) solid var(--ui-taskbar-preview-action-border); border-radius: var(--ui-taskbar-preview-action-radius); transition: var(--ui-taskbar-preview-action-transition); } .wm-taskbar-preview-action:hover { color: var(--ui-taskbar-preview-action-hover-color); background: var(--ui-taskbar-preview-action-hover-background); border-color: var(--ui-taskbar-preview-action-hover-border); transform: var(--ui-taskbar-preview-action-hover-transform); }\n")
    parts.push(".wm-desktop-widgets, .wm-desktop-items { position: absolute; z-index: var(--ui-desktop-item-z-index); display: grid; gap: var(--ui-desktop-item-gap); } .wm-desktop-widgets { top: var(--ui-desktop-widget-top); right: var(--ui-desktop-widget-right); width: var(--ui-desktop-widget-width); } .wm-desktop-item, .wm-desktop-drop-target, .wm-desktop-widget { min-width: 0; } .wm-desktop-widgets.collapsed, .wm-desktop-item[hidden], .wm-desktop-drop-target[hidden] { display: none; }\n")
    parts.push(".wm-snap-preview, .wm-ghost, .wm-desktop-widget, .wm-desktop-item, .wm-desktop-drop-target { background: var(--ui-overlay-background); border: var(--ui-overlay-border-width) solid var(--ui-overlay-border); box-shadow: var(--ui-overlay-shadow); backdrop-filter: var(--ui-overlay-backdrop-filter); -webkit-backdrop-filter: var(--ui-overlay-backdrop-filter); opacity: var(--ui-overlay-opacity); } .wm-ghost.dragging, .wm-snap-preview.active, .wm-desktop-drop-target.active { background: var(--ui-overlay-active-background); border-color: var(--ui-overlay-active-border); box-shadow: var(--ui-overlay-active-shadow); opacity: var(--ui-overlay-active-opacity); }\n")
    parts.push(".wm-command-palette, .wm-command-bar, .wm-window-context-menu, .wm-title-suggestions, .wm-snap-layout-palette, .wm-window-arrange-palette, .wm-control-center, .wm-window-overview, .wm-stage-rail, .wm-window-switcher, .wm-workspace-switcher, .wm-clipboard-history, .wm-screen-capture-overlay, .wm-quick-settings, .wm-notification-center, .wm-live-activity, .wm-app-launcher, .wm-dock-stack, .wm-accent-palette, .wm-wallpaper-picker, .wm-shortcut-overlay, .wm-widget-gallery { position: fixed; z-index: var(--ui-command-z-index); } .wm-command-item:hover, .wm-command-item.selected, .wm-command-match, .wm-title-suggestion-item:hover { color: var(--ui-command-selection-text); background: var(--ui-command-selection-background); border-color: var(--ui-command-selection-border); box-shadow: var(--ui-command-selection-shadow); }\n")
    parts.push(".wm-window-context-menu { width: var(--ui-window-context-width); display: grid; gap: var(--ui-window-context-gap); padding: var(--ui-window-context-padding); } .wm-window-context-header { min-width: 0; display: grid; grid-template-columns: var(--ui-window-context-header-columns); align-items: center; gap: var(--ui-window-context-header-gap); padding: var(--ui-window-context-header-padding); } .wm-window-context-icon { width: var(--ui-window-context-icon-size); height: var(--ui-window-context-icon-size); } .wm-window-context-heading { min-width: 0; display: grid; gap: var(--ui-window-context-heading-gap); } .wm-window-context-title, .wm-window-context-status, .wm-window-context-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .wm-window-context-group { display: grid; gap: var(--ui-window-context-group-gap); padding: var(--ui-window-context-group-padding); border-top: var(--ui-window-context-group-border-width) solid var(--ui-window-context-group-border); } .wm-window-context-group:first-of-type { border-top: 0; } .wm-window-context-item { min-height: var(--ui-window-context-item-min-height); display: grid; grid-template-columns: var(--ui-window-context-item-columns); align-items: center; gap: var(--ui-window-context-item-gap); padding: var(--ui-window-context-item-padding); text-align: left; } .wm-window-context-item[data-context-workspace-id] { padding-left: var(--ui-window-context-workspace-indent); } .wm-window-context-glyph { width: var(--ui-window-context-glyph-size); height: var(--ui-window-context-glyph-size); display: inline-grid; place-items: center; } .wm-window-context-shortcut { justify-self: end; }\n")
    parts.push(".wm-resize-handle { position: absolute; z-index: var(--ui-resize-handle-z-index); border: 0; padding: 0; color: var(--ui-resize-handle-color); background: var(--ui-resize-handle-background); } .wm-resize-handle::before { content: ''; position: absolute; inset: var(--ui-resize-hit-inset); } .wm-resize-handle::after { content: ''; position: absolute; opacity: var(--ui-resize-handle-opacity); background: var(--ui-resize-indicator-background); box-shadow: var(--ui-resize-indicator-shadow); transition: var(--ui-resize-indicator-transition); }\n")
    parts.push(".wm-resize-n { left: 0; top: 0; right: 0; height: var(--ui-resize-edge-size); cursor: n-resize; } .wm-resize-s { left: 0; bottom: 0; right: 0; height: var(--ui-resize-edge-size); cursor: s-resize; } .wm-resize-e { right: 0; top: var(--ui-resize-edge-title-offset); bottom: 0; width: var(--ui-resize-edge-size); cursor: e-resize; } .wm-resize-w { left: 0; top: var(--ui-resize-edge-title-offset); bottom: 0; width: var(--ui-resize-edge-size); cursor: w-resize; }\n")
    parts.push(".wm-resize-ne { right: 0; top: 0; width: var(--ui-resize-corner-size); height: var(--ui-resize-corner-size); cursor: ne-resize; } .wm-resize-nw { left: 0; top: 0; width: var(--ui-resize-corner-size); height: var(--ui-resize-corner-size); cursor: nw-resize; } .wm-resize-se { right: 0; bottom: 0; width: var(--ui-resize-corner-size); height: var(--ui-resize-corner-size); cursor: se-resize; } .wm-resize-sw { left: 0; bottom: 0; width: var(--ui-resize-corner-size); height: var(--ui-resize-corner-size); cursor: sw-resize; }\n")
    parts.push(".wm-resize-e::after, .wm-resize-w::after { top: var(--ui-resize-edge-indicator-inset); bottom: var(--ui-resize-edge-indicator-inset); width: var(--ui-resize-indicator-thickness); } .wm-resize-n::after, .wm-resize-s::after { left: var(--ui-resize-edge-indicator-inset); right: var(--ui-resize-edge-indicator-inset); height: var(--ui-resize-indicator-thickness); } .wm-resize-ne::after, .wm-resize-nw::after, .wm-resize-se::after, .wm-resize-sw::after { inset: var(--ui-resize-corner-indicator-inset); }\n")
    parts.push(".wm-window:hover .wm-resize-handle::after, .wm-resize-handle:focus-visible::after, .wm-window[data-resize-active='true'] .wm-resize-handle::after { opacity: var(--ui-resize-indicator-active-opacity); } .wm-window[data-resize-active='true'][data-resize-direction='n'] .wm-resize-n::after, .wm-window[data-resize-active='true'][data-resize-direction='s'] .wm-resize-s::after, .wm-window[data-resize-active='true'][data-resize-direction='e'] .wm-resize-e::after, .wm-window[data-resize-active='true'][data-resize-direction='w'] .wm-resize-w::after, .wm-window[data-resize-active='true'][data-resize-direction='ne'] .wm-resize-ne::after, .wm-window[data-resize-active='true'][data-resize-direction='nw'] .wm-resize-nw::after, .wm-window[data-resize-active='true'][data-resize-direction='se'] .wm-resize-se::after, .wm-window[data-resize-active='true'][data-resize-direction='sw'] .wm-resize-sw::after { opacity: var(--ui-resize-indicator-active-opacity); transform: var(--ui-resize-active-transform); }\n")
    parts.push(".wm-hot-corners { position: fixed; inset: 0; z-index: var(--ui-hot-corners-z-index); pointer-events: none; } .wm-hot-corner-zone { position: fixed; width: var(--ui-hot-corner-size); height: var(--ui-hot-corner-size); pointer-events: auto; } .wm-hot-corner-overview { left: max(var(--ui-hot-corner-offset), env(safe-area-inset-left)); top: max(var(--ui-hot-corner-offset), env(safe-area-inset-top)); } .wm-hot-corner-launcher { right: max(var(--ui-hot-corner-offset), env(safe-area-inset-right)); top: max(var(--ui-hot-corner-offset), env(safe-area-inset-top)); } .wm-hot-corner-desktop { left: max(var(--ui-hot-corner-offset), env(safe-area-inset-left)); bottom: max(var(--ui-hot-corner-offset), env(safe-area-inset-bottom)); } .wm-hot-corner-control-center { right: max(var(--ui-hot-corner-offset), env(safe-area-inset-right)); bottom: max(var(--ui-hot-corner-offset), env(safe-area-inset-bottom)); }\n")
    parts.push("[hidden], .wm-window-overview[hidden], .wm-command-palette[hidden], .wm-notification-center[hidden], .wm-quick-settings[hidden], .wm-screen-capture-overlay[hidden] { display: none; } .wm-window.dragging, .wm-window[data-resize-active='true'], .wm-ghost.resize-active { user-select: none; }\n")
    parts.push(":root[data-wm-motion=off] *, :root[data-wm-motion=reduced] * { animation: var(--ui-reduced-motion-animation) !important; transition: var(--ui-reduced-motion-transition) !important; } @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: var(--ui-reduced-motion-animation) !important; transition: var(--ui-reduced-motion-transition) !important; } }\n")
    val adapter_css = parts.to_text()
    val responsive = responsive_css(default_breakpoints())
    return adapter_css + responsive + "\n/* Folder theme package theme=" + canonical_theme +
        " fingerprint=" + resolved_fingerprint + " */\n" + package_css

fn responsive_css(bp: Breakpoints) -> text:
    """Responsive layout rules derived from the LayoutProfile breakpoints imported
    from common/ui/profile.spl (single source of truth — no hardcoded pixel values).

    Boundary parity with classify(): dimension < compact_max → Compact;
    dimension < regular_max → Regular; else Expanded.
    CSS maps this exactly: Compact = max-width (compact_max-1)px;
    Regular = min-width compact_max px .. max-width (regular_max-1)px.

    Compact (phone): single column, full-bleed panels, 16px base font (also
    stops iOS from zooming on input focus), 44px minimum touch targets, stacked
    rows. Regular (tablet) keeps a roomier single/again-flowing layout. Expanded
    (desktop) keeps the default multi-column layout."""
    var r = ""
    val lb = "\u{007b}"
    val rb = "\u{007d}"
    val compact_edge = bp.compact_max - 1
    val compact_min = bp.compact_max
    val regular_edge = bp.regular_max - 1
    # --- Compact: phones (< compact_max) ---
    r = r + "@media (max-width: " +
        ui_native_i64_text(compact_edge as i64) + "px) " + lb + " "
    r = r + "html { font-size: 16px; } "
    r = r + "#app { padding: 14px 12px; gap: 12px; } "
    r = r + ".layout-hbox { flex-direction: column; align-items: stretch; } "
    r = r + ".layout-grid { grid-template-columns: 1fr; } "
    r = r + ".widget-panel, .widget-card { width: 100%; border-radius: 16px; } "
    r = r + ".widget-navigation-bar { font-size: 17px; padding: 10px 14px; } "
    r = r + ".widget-heading, h1, h2 { font-size: 22px; line-height: 1.25; } "
    r = r + ".widget-button, .widget-checkbox, .widget-radio, .widget-radio-option, .widget-switch, .widget-dropdown, .widget-tab, input, select, textarea { min-height: 44px; font-size: 16px; } "
    r = r + ".widget-button { padding: 12px 16px; width: 100%; } "
    r = r + ".widget-input, .widget-textfield, input[type=\"text\"], input[type=\"search\"] { width: 100%; font-size: 16px; } "
    r = r + ".widget-list .list-item, .widget-table td { padding: 12px 10px; } "
    r = r + ".widget-statusbar { font-size: 13px; } "
    r = r + ".widget-sidebar { display: none; } "
    r = r + rb + "\n"
    # --- Regular: small tablets / split view (compact_max .. regular_max-1 px) ---
    r = r + "@media (min-width: " +
        ui_native_i64_text(compact_min as i64) + "px) and (max-width: " +
        ui_native_i64_text(regular_edge as i64) + "px) " + lb + " "
    r = r + ".layout-grid { grid-template-columns: repeat(2, 1fr); } "
    r = r + ".widget-button, input, select, textarea { min-height: 40px; } "
    r = r + rb + "\n"
    return r
