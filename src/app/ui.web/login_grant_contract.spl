# Login-grant contracts recovered from 88aac2ffe28 parent, without policy changes.
use common.crypto.constant_time.{constant_time_compare}

fn ui_web_login_grant_status(provided: text, expected: text) -> text:
    if expected.len() != 64:
        return "forbidden"
    for ch in expected:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return "forbidden"
    if not constant_time_compare(provided, expected):
        return "forbidden"
    return "ok"

fn ui_web_static_script_security_headers(content_type: text) -> text:
    if content_type != "application/javascript":
        return ""
    return "Cache-Control: no-store\r\nPragma: no-cache\r\nX-Content-Type-Options: nosniff\r\n"

fn ui_web_with_login_grant(html: text, grant: text) -> text:
    if grant.len() != 64:
        return html
    for ch in grant:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return html
    val head = "<head>\n"
    if not html.contains(head):
        return html
    val meta = "<head>\n  <meta name=\"simple-ui-login-grant\" content=\"{grant}\">\n"
    return html.replace(head, meta)

export ui_web_login_grant_status, ui_web_static_script_security_headers, ui_web_with_login_grant
