# HTML Page Generation
#
# Generates complete HTML pages for the web UI renderer,
# including CSS styles and JavaScript for WebSocket communication.

use common.ui.widget.{UIState}
use app.ui.render.html_widgets.{render_html_tree}
use common.ui.profile.{Breakpoints}
use nogc_sync_mut.ui.theme_package.{resolve_theme_alias}
use std.io_runtime.{read_file, file_exists}
use app.ui.web.html_css.{
    generate_css as css_generate_css,
    responsive_css as css_responsive_css,
    build_modern_theme_css as css_build_modern_theme_css,
    _wm_css as css_wm_css,
}
use app.ui.web.html_modern_preview.{
    wm_root_data_attrs as preview_wm_root_data_attrs,
    generate_wm_modern_preview_html as preview_generate_html,
    write_wm_modern_preview_html as preview_write_html,
    wm_modern_preview_evidence_report as preview_evidence_report,
    wm_modern_preview_browser_audit_command as preview_browser_audit_command,
}

# =========================================================================
# Full HTML Page
# =========================================================================

fn generate_html_page(state: UIState, ws_port: i32) -> text:
    """Generate a complete HTML page for the UI."""
    val body_html = render_html_tree(state.tree.root_node(), state)
    val theme = resolve_theme_alias(state.tree.theme_name())
    val css = generate_css(state.tree.theme_name())
    val js = generate_js(ws_port)
    val title = state.tree.title_text()

    var html = "<!DOCTYPE html>\n"
    html = "{html}<html lang=\"en\" {wm_root_data_attrs(theme)}>\n"
    html = "{html}<head>\n"
    html = "{html}  <meta charset=\"UTF-8\">\n"
    html = "{html}  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
    html = "{html}  <title>{title}</title>\n"
    html = "{html}  <style>{css}</style>\n"
    html = "{html}</head>\n"
    html = "{html}<body>\n"
    html = "{html}  <div id=\"app\">{body_html}</div>\n"
    html = "{html}  <script>{js}</script>\n"
    html = "{html}</body>\n"
    html = "{html}</html>"
    return html

fn wm_root_data_attrs(theme: text) -> text:
    preview_wm_root_data_attrs(theme)

fn generate_wm_html_page(theme: text, title: text, ws_port: i32) -> text:
    """Generate a WM desktop HTML page with wm.js embedded inline.
    Windows are created dynamically via WebSocket openWindow messages."""
    val canonical_theme = resolve_theme_alias(theme)
    val css = build_modern_theme_css(canonical_theme)
    val boot_js = generate_wm_js(ws_port)
    # Embed wm.js inline to avoid extra HTTP request
    var wm_js = ""
    if file_exists("src/app/ui.web/wm.js"):
        wm_js = read_file("src/app/ui.web/wm.js")

    var html = "<!DOCTYPE html>\n"
    html = html + "<html lang=\"en\" " + wm_root_data_attrs(canonical_theme) + ">\n"
    html = html + "<head>\n"
    html = html + "  <meta charset=\"UTF-8\">\n"
    html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
    html = html + "  <title>" + title + "</title>\n"
    html = html + "  <style>" + css + "</style>\n"
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "  <div id=\"wm-desktop\"></div>\n"
    html = html + "  <div id=\"wm-taskbar\"></div>\n"
    html = html + "  <script>" + wm_js + "</script>\n"
    html = html + "  <script>" + boot_js + "</script>\n"
    html = html + "</body>\n"
    html = html + "</html>"
    return html

fn ui_web_with_login_grant(html: text, grant: text) -> text:
    if grant.len() != 64:
        return html
    for ch in grant:
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return html
    val head = "<head>\n"
    if not html.contains(head):
        return html
    val meta = "<head>\n  <meta name=\"simple-ui-login-grant\" content=\"{grant}\">\n"
    return html.replace(head, meta)

fn generate_css(theme: text) -> text:
    css_generate_css(theme)

fn build_modern_theme_css(theme: text) -> text:
    css_build_modern_theme_css(theme)

fn _wm_css(theme: text) -> text:
    css_wm_css(theme)

fn responsive_css(bp: Breakpoints) -> text:
    css_responsive_css(bp)

fn generate_wm_modern_preview_html(theme: text) -> text:
    preview_generate_html(theme)

fn write_wm_modern_preview_html(path: text, theme: text) -> bool:
    preview_write_html(path, theme)

fn wm_modern_preview_evidence_report(path: text, theme: text) -> text:
    preview_evidence_report(path, theme)

fn wm_modern_preview_browser_audit_command(html_path: text, output_path: text, width: i64, height: i64) -> text:
    preview_browser_audit_command(html_path, output_path, width, height)

fn generate_wm_js(ws_port: i32) -> text:
    """Generate the WM boot script that connects WebSocket to SimpleWindowManager."""
    val lb = "\u{007b}"
    val rb = "\u{007d}"
    var js = "let ws = null;\n"
    js = js + "let authToken = null;\n"
    js = js + "let reconnectTimer = null;\n"
    js = js + "let connectDeadline = null;\n"
    js = js + "const wsProto = location.protocol === 'https:' ? 'wss' : 'ws';\n"
    js = js + "const wsHost = location.host ? location.host : ('localhost:' + " + str(ws_port) + ");\n"
    js = js + "function sendEvent(msg) " + lb + " if (ws && ws.readyState === 1) ws.send(JSON.stringify(msg)); " + rb + "\n"
    js = js + "function clearConnectDeadline() " + lb + "\n"
    js = js + "  if (connectDeadline !== null) " + lb + " clearTimeout(connectDeadline); connectDeadline = null; " + rb + "\n"
    js = js + rb + "\n"
    js = js + "function scheduleReconnect() " + lb + "\n"
    js = js + "  if (reconnectTimer !== null) return;\n"
    js = js + "  reconnectTimer = setTimeout(function() " + lb + " reconnectTimer = null; connectWS(); " + rb + ", 1000);\n"
    js = js + rb + "\n"
    js = js + "function loginGrant() " + lb + " const meta = document.querySelector('meta[name=\"simple-ui-login-grant\"]'); return meta ? meta.content : ''; " + rb + "\n"
    js = js + "function authenticateThenConnect() " + lb + "\n"
    js = js + "  fetch('/ui/login', " + lb + " method: 'POST', headers: " + lb + " 'Content-Type': 'application/json' " + rb + ", body: JSON.stringify(" + lb + " capability_grant: loginGrant() " + rb + ") " + rb + ")\n"
    js = js + "    .then(function(resp) " + lb + " if (!resp.ok) throw new Error('login failed: ' + resp.status); return resp.json(); " + rb + ")\n"
    js = js + "    .then(function(data) " + lb + " authToken = data.token; connectWS(); " + rb + ")\n"
    js = js + "    .catch(function(err) " + lb + " console.error('WM auth error', err); scheduleReconnect(); " + rb + ");\n"
    js = js + rb + "\n"
    js = js + "function connectWS() " + lb + "\n"
    js = js + "  if (ws && (ws.readyState === 0 || ws.readyState === 1)) return;\n"
    js = js + "  if (!authToken) " + lb + " authenticateThenConnect(); return; " + rb + "\n"
    js = js + "  clearConnectDeadline();\n"
    js = js + "  ws = new WebSocket(wsProto + '://' + wsHost + '/ui/ws', ['simple-ui', 'bearer.' + encodeURIComponent(authToken)]);\n"
    js = js + "  connectDeadline = setTimeout(function() " + lb + "\n"
    js = js + "    if (ws && ws.readyState === 0) " + lb + "\n"
    js = js + "      console.warn('WM WebSocket still connecting after startup grace period');\n"
    js = js + "    " + rb + "\n"
    js = js + "  " + rb + ", 5000);\n"
    js = js + "  ws.onopen = function() " + lb + " clearConnectDeadline(); console.log('WM WebSocket connected'); " + rb + ";\n"
    js = js + "  ws.onmessage = function(e) " + lb + "\n"
    js = js + "    try " + lb + "\n"
    js = js + "      var data = JSON.parse(e.data);\n"
    js = js + "      if (simpleWM) simpleWM.handleMessage(data);\n"
    js = js + "    " + rb + " catch(err) " + lb + " console.error('WM parse error', err); " + rb + "\n"
    js = js + "  " + rb + ";\n"
    js = js + "  ws.onerror = function(err) " + lb + " clearConnectDeadline(); console.error('WM socket error', err); try " + lb + " if (ws && ws.readyState !== 1) ws.close(); " + rb + " catch(closeErr) " + lb + " console.error('WM close error', closeErr); " + rb + " scheduleReconnect(); " + rb + ";\n"
    js = js + "  ws.onclose = function() " + lb + " clearConnectDeadline(); ws = null; scheduleReconnect(); " + rb + ";\n"
    js = js + rb + "\n"
    js = js + "function bootWM() " + lb + "\n"
    js = js + "  if (!simpleWM) simpleWM = new SimpleWindowManager();\n"
    js = js + "  authenticateThenConnect();\n"
    js = js + rb + "\n"
    js = js + "function bootWMAfterLoad() " + lb + " setTimeout(bootWM, 150); " + rb + "\n"
    js = js + "if (document.readyState === 'complete') " + lb + "\n"
    js = js + "  bootWMAfterLoad();\n"
    js = js + rb + " else " + lb + "\n"
    js = js + "  window.addEventListener('load', bootWMAfterLoad, { once: true });\n"
    js = js + rb + "\n"
    return js

# =========================================================================
# CSS Styles
# =========================================================================

fn generate_js(ws_port: i32) -> text:
    """Generate JavaScript for WebSocket communication and interactive widget events.
    Handles keyboard, mouse clicks, focus, and widget-specific interactions
    consistently across Web, Electron, and Tauri backends."""
    # Use lb/rb for JS object literal braces to avoid Simple interpolation
    val lb = "\u{007b}"
    val rb = "\u{007d}"
    var js = "const wsProto = location.protocol === 'https:' ? 'wss' : 'ws';\n"
    js = "{js}const wsHost = location.host ? location.host : ('localhost:' + {ws_port} + '');\n"
    js = "{js}let authToken = null;\n"
    js = "{js}function browserWsUrl() {lb} return wsProto + '://' + wsHost + '/ui/ws'; {rb}\n"
    js = "{js}let ws = null;\n"
    js = "{js}let currentFocusId = '';\n"
    js = "{js}function loginGrant() {lb} const meta = document.querySelector('meta[name=\"simple-ui-login-grant\"]'); return meta ? meta.content : ''; {rb}\n"
    js = "{js}function authenticateAndConnect() {lb}\n"
    js = "{js}  fetch('/ui/login', {lb} method: 'POST', headers: {lb} 'Content-Type': 'application/json' {rb}, body: JSON.stringify({lb} capability_grant: loginGrant() {rb}) {rb})\n"
    js = "{js}    .then(function(resp) {lb} if (!resp.ok) throw new Error('login failed: ' + resp.status); return resp.json(); {rb})\n"
    js = "{js}    .then(function(data) {lb} authToken = data.token; connect(); {rb})\n"
    js = "{js}    .catch(function() {lb} setTimeout(authenticateAndConnect, 2000); {rb});\n"
    js = "{js}{rb}\n"

    # WebSocket connection with auto-reconnect
    js = "{js}function connect() {lb}\n"
    js = "{js}  if (!authToken) {lb} authenticateAndConnect(); return; {rb}\n"
    js = "{js}  ws = new WebSocket(browserWsUrl(), ['simple-ui', 'bearer.' + encodeURIComponent(authToken)]);\n"
    js = "{js}  ws.onmessage = function(e) {lb}\n"
    js = "{js}    const data = JSON.parse(e.data);\n"
    js = "{js}    if (data.type === 'render') {lb}\n"
    js = "{js}      document.getElementById('app').innerHTML = data.html;\n"
    js = "{js}      restoreFocus();\n"
    js = "{js}    {rb}\n"
    js = "{js}  {rb};\n"
    js = "{js}  ws.onclose = function() {lb}\n"
    js = "{js}    setTimeout(connect, 2000);\n"
    js = "{js}  {rb};\n"
    js = "{js}{rb}\n"
    js = "{js}connect();\n"

    # Helper: send event to backend
    js = "{js}function sendEvent(evt) {lb}\n"
    js = "{js}  if (ws && ws.readyState === WebSocket.OPEN) {lb}\n"
    js = "{js}    ws.send(JSON.stringify(evt));\n"
    js = "{js}  {rb}\n"
    js = "{js}{rb}\n"

    # Restore focus after re-render
    js = "{js}function restoreFocus() {lb}\n"
    js = "{js}  if (currentFocusId) {lb}\n"
    js = "{js}    var el = document.getElementById(currentFocusId);\n"
    js = "{js}    if (el) el.setAttribute('data-focused', 'true');\n"
    js = "{js}  {rb}\n"
    js = "{js}{rb}\n"

    # Keyboard event forwarding (unchanged behavior, handles TUI-like navigation)
    js = "{js}document.addEventListener('keydown', function(e) {lb}\n"
    js = "{js}  var tag = e.target.tagName.toLowerCase();\n"
    js = "{js}  if (tag === 'input' || tag === 'textarea' || tag === 'select') return;\n"
    js = "{js}  sendEvent({lb}type: 'key', key: e.key{rb});\n"
    js = "{js}  if (['j','k','Tab','Escape',':','i'].indexOf(e.key) >= 0) e.preventDefault();\n"
    js = "{js}{rb});\n"

    # Click event delegation for interactive widgets
    js = "{js}document.addEventListener('click', function(e) {lb}\n"
    js = "{js}  var el = e.target;\n"
    # Button clicks
    js = "{js}  var btn = el.closest('.widget-button');\n"
    js = "{js}  if (btn) {lb}\n"
    js = "{js}    var action = btn.getAttribute('data-action');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action{rb});\n"
    js = "{js}    currentFocusId = btn.id;\n"
    js = "{js}    sendEvent({lb}type: 'focus', id: btn.id{rb});\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Checkbox toggle (div-based custom checkbox)
    js = "{js}  var cb = el.closest('.widget-checkbox');\n"
    js = "{js}  if (cb) {lb}\n"
    js = "{js}    var action = cb.getAttribute('data-action');\n"
    js = "{js}    var isChecked = cb.classList.contains('checked');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action, value: isChecked ? 'false' : 'true'{rb});\n"
    js = "{js}    currentFocusId = cb.id;\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # List item selection
    js = "{js}  var li = el.closest('.list-item');\n"
    js = "{js}  if (li) {lb}\n"
    js = "{js}    var list = li.closest('.widget-list');\n"
    js = "{js}    if (list) {lb}\n"
    js = "{js}      var items = list.querySelectorAll('.list-item');\n"
    js = "{js}      for (var i = 0; i < items.length; i++) {lb}\n"
    js = "{js}        if (items[i] === li) {lb}\n"
    js = "{js}          sendEvent({lb}type: 'action', name: 'select_' + list.id + '_' + i{rb});\n"
    js = "{js}          break;\n"
    js = "{js}        {rb}\n"
    js = "{js}      {rb}\n"
    js = "{js}      currentFocusId = list.id;\n"
    js = "{js}    {rb}\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Tab switching
    js = "{js}  var tab = el.closest('.tab-item');\n"
    js = "{js}  if (tab) {lb}\n"
    js = "{js}    var tabs = tab.parentElement;\n"
    js = "{js}    if (tabs) {lb}\n"
    js = "{js}      var items = tabs.querySelectorAll('.tab-item');\n"
    js = "{js}      for (var i = 0; i < items.length; i++) {lb}\n"
    js = "{js}        items[i].classList.remove('active');\n"
    js = "{js}        if (items[i] === tab) {lb}\n"
    js = "{js}          tab.classList.add('active');\n"
    js = "{js}          sendEvent({lb}type: 'action', name: 'tab_' + tabs.id + '_' + i{rb});\n"
    js = "{js}        {rb}\n"
    js = "{js}      {rb}\n"
    js = "{js}      currentFocusId = tabs.id;\n"
    js = "{js}    {rb}\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Tree node toggle
    js = "{js}  var toggle = el.closest('.tree-toggle');\n"
    js = "{js}  if (toggle) {lb}\n"
    js = "{js}    var action = toggle.getAttribute('data-action');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action{rb});\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Table header sort
    js = "{js}  var th = el.closest('th[data-action]');\n"
    js = "{js}  if (th) {lb}\n"
    js = "{js}    var action = th.getAttribute('data-action');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action{rb});\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Submenu item clicks
    js = "{js}  var sub = el.closest('.submenu-item');\n"
    js = "{js}  if (sub) {lb}\n"
    js = "{js}    var action = sub.getAttribute('data-action');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action{rb});\n"
    js = "{js}    return;\n"
    js = "{js}  {rb}\n"
    # Generic widget focus on click
    js = "{js}  var widget = el.closest('[id]');\n"
    js = "{js}  if (widget && widget.id) {lb}\n"
    js = "{js}    currentFocusId = widget.id;\n"
    js = "{js}    sendEvent({lb}type: 'focus', id: widget.id{rb});\n"
    js = "{js}  {rb}\n"
    js = "{js}{rb});\n"

    # Table filter input handler
    js = "{js}document.addEventListener('input', function(e) {lb}\n"
    js = "{js}  if (e.target.classList.contains('table-filter')) {lb}\n"
    js = "{js}    var action = e.target.getAttribute('data-action');\n"
    js = "{js}    if (action) sendEvent({lb}type: 'action', name: action, value: e.target.value{rb});\n"
    js = "{js}  {rb}\n"
    js = "{js}{rb});\n"

    # Dropdown change handler
    js = "{js}document.addEventListener('change', function(e) {lb}\n"
    js = "{js}  var dd = e.target.closest('.widget-dropdown');\n"
    js = "{js}  if (dd) {lb}\n"
    js = "{js}    sendEvent({lb}type: 'action', name: 'select_' + dd.id + '_' + e.target.selectedIndex{rb});\n"
    js = "{js}  {rb}\n"
    js = "{js}{rb});\n"

    # Input, textfield, textarea value change handlers
    js = "{js}document.addEventListener('change', function(e) {lb}\n"
    js = "{js}  var inp = e.target.closest('.widget-input, .widget-textfield');\n"
    js = "{js}  if (inp && inp.id) sendEvent({lb}type: 'action', name: 'change_' + inp.id, value: e.target.value{rb});\n"
    js = "{js}  var ta = e.target.closest('.widget-textarea');\n"
    js = "{js}  if (ta && ta.id) sendEvent({lb}type: 'action', name: 'change_' + ta.id, value: e.target.value{rb});\n"
    js = "{js}{rb});\n"

    return js
