# Host Taskbar Runtime — authoritative taskbar + launch/runtime state
#
# Supports host shell modes:
#   * embedded:        taskbar + in-shell SimpleWeb surfaces
#   * native:          taskbar shell + native Electron BrowserWindows
#   * hidden_taskbar:  native Electron BrowserWindows with Simple taskbar hidden
#   * headless:        no local shell window; remote UI still gets taskbar state
#
# Legacy names `desktop_embedded` and `taskbar_only` remain accepted.

# Split from src/app/ui.web/taskbar_runtime.spl to keep module cohesion under the 800-line source limit.
export use app.ui.web._HostTaskbarRuntime.host_taskbar_runtime.{HostTaskbarApp, HostTaskbarAdapterCapabilities, HostShellMode, HostTaskbarRuntime, host_taskbar_runtime_reset, host_taskbar_runtime_save_layout, host_taskbar_runtime_clear_persisted_layout, host_taskbar_runtime_mark_persisted_layout_corrupt_for_test, host_taskbar_runtime_enable, host_taskbar_runtime_is_enabled, host_taskbar_runtime_mode_name, host_taskbar_runtime_hides_desktop, host_taskbar_runtime_hides_taskbar, host_taskbar_runtime_adapter_capabilities, host_taskbar_runtime_taskbar_frame, host_taskbar_runtime_taskbar_model, host_taskbar_runtime_pin_app, host_taskbar_runtime_unpin_app, host_taskbar_runtime_pinned_apps, host_taskbar_runtime_try_pin_app, host_taskbar_runtime_try_unpin_app, host_taskbar_runtime_pinned_app_count, host_taskbar_runtime_pinned_app_id, host_taskbar_runtime_pinned_app_display_name, host_taskbar_runtime_pinned_app_icon, host_taskbar_runtime_take_client_frames, host_taskbar_runtime_native_window_html, host_taskbar_runtime_catalog, host_taskbar_runtime_launch, host_taskbar_runtime_focus, host_taskbar_runtime_sync_focus, host_taskbar_runtime_minimize, host_taskbar_runtime_sync_minimize, host_taskbar_runtime_restore, host_taskbar_runtime_sync_restore, host_taskbar_runtime_close, host_taskbar_runtime_sync_close, host_taskbar_runtime_move, host_taskbar_runtime_sync_move, host_taskbar_runtime_resize, host_taskbar_runtime_sync_resize, host_taskbar_runtime_maximize, host_taskbar_runtime_sync_maximize, host_taskbar_runtime_unmaximize, host_taskbar_runtime_sync_unmaximize, host_taskbar_runtime_set_title, host_taskbar_runtime_sync_set_title}
export use app.ui.web._HostTaskbarRuntime.mode_and_layout_helpers.*
