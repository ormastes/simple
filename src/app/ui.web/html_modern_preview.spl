    html = html + "    <aside id=\"wm-window-arrange-palette\" class=\"wm-window-arrange-palette action-feedback\" role=\"dialog\" aria-label=\"Window arrangement\" data-arrange-source=\"workspace\" data-arrange-active-index=\"0\" data-arrange-feedback=\"tile_grid\" aria-activedescendant=\"wm-arrange-mode-0\"><div class=\"wm-arrange-title\">Arrange windows</div><div id=\"wm-arrange-grid\" class=\"wm-arrange-grid\" role=\"listbox\" aria-label=\"Available window arrangements\" aria-activedescendant=\"wm-arrange-mode-0\"><button id=\"wm-arrange-mode-0\" class=\"wm-arrange-mode active action-feedback\" role=\"option\" aria-selected=\"true\" tabindex=\"0\" data-arrange-mode=\"tile_grid\" data-arrange-index=\"0\" data-arrange-feedback=\"tile_grid\"><span class=\"wm-arrange-preview\" data-arrange-preview=\"tile_grid\"><span class=\"wm-arrange-cell a\"></span><span class=\"wm-arrange-cell b\"></span><span class=\"wm-arrange-cell c\"></span></span><span class=\"wm-arrange-body\"><strong class=\"wm-arrange-label\">Tile grid</strong><span class=\"wm-arrange-meta\">Fit visible windows</span></span></button><button id=\"wm-arrange-mode-1\" class=\"wm-arrange-mode\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-arrange-mode=\"cascade\" data-arrange-index=\"1\"><span class=\"wm-arrange-preview\" data-arrange-preview=\"cascade\"><span class=\"wm-arrange-cell a\"></span><span class=\"wm-arrange-cell b\"></span><span class=\"wm-arrange-cell c\"></span></span><span class=\"wm-arrange-body\"><strong class=\"wm-arrange-label\">Cascade</strong><span class=\"wm-arrange-meta\">Stack with offsets</span></span></button><button id=\"wm-arrange-mode-2\" class=\"wm-arrange-mode\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-arrange-mode=\"focus_left\" data-arrange-index=\"2\"><span class=\"wm-arrange-preview\" data-arrange-preview=\"focus_left\"><span class=\"wm-arrange-cell a\"></span><span class=\"wm-arrange-cell b\"></span><span class=\"wm-arrange-cell c\"></span></span><span class=\"wm-arrange-body\"><strong class=\"wm-arrange-label\">Focus left</strong><span class=\"wm-arrange-meta\">Active plus rail</span></span></button><button id=\"wm-arrange-mode-3\" class=\"wm-arrange-mode\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-arrange-mode=\"center_stage\" data-arrange-index=\"3\"><span class=\"wm-arrange-preview\" data-arrange-preview=\"center_stage\"><span class=\"wm-arrange-cell a\"></span><span class=\"wm-arrange-cell b\"></span><span class=\"wm-arrange-cell c\"></span></span><span class=\"wm-arrange-body\"><strong class=\"wm-arrange-label\">Center stage</strong><span class=\"wm-arrange-meta\">Front and centered</span></span></button></div></aside>\n"
    html = html + "  </div>\n"
    html = html + "  <div id=\"wm-taskbar\" role=\"navigation\" aria-label=\"Window taskbar\"><div class=\"wm-taskbar-section running\"><div class=\"wm-taskbar-item active launching\" role=\"button\" tabindex=\"0\" aria-label=\"Focus Simple IDE\" data-app-id=\"simple.ide\" data-launch-feedback=\"active\" aria-busy=\"true\" data-taskbar-attention=\"false\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">I</span></span><span class=\"wm-taskbar-label\">Simple IDE</span></div><div class=\"wm-taskbar-item attention\" role=\"button\" tabindex=\"0\" aria-label=\"Focus Browser, 3 notifications\" data-taskbar-attention=\"true\"><span class=\"wm-taskbar-icon wm-round-icon wm-icon-normalized-square\"><img class=\"wm-icon-image\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" alt=\"Browser icon\"></span><span class=\"wm-taskbar-label\">Browser</span><span class=\"wm-taskbar-badge\" data-taskbar-badge=\"3\" aria-hidden=\"true\">3</span></div></div><div class=\"wm-taskbar-section tray\"><div class=\"wm-taskbar-tray\">std</div><div class=\"wm-taskbar-tray\">off</div></div></div>\n"
    html = html + "  <aside class=\"wm-taskbar-preview\" role=\"tooltip\" aria-label=\"Taskbar window preview\" data-window-id=\"simple.ide\" data-preview-title=\"Simple IDE\" data-preview-status=\"Active\" style=\"left:180px;bottom:72px;\"><span class=\"wm-taskbar-preview-icon wm-round-icon\"><span class=\"wm-icon-glyph\">I</span></span><div class=\"wm-taskbar-preview-body\"><span class=\"wm-taskbar-preview-title\">Simple IDE</span><span class=\"wm-taskbar-preview-meta\">src/app/ui.web/html.spl</span><span class=\"wm-taskbar-preview-status\">Active</span></div><div class=\"wm-taskbar-preview-actions\" aria-label=\"Taskbar preview actions\"><button class=\"wm-taskbar-preview-action\" data-preview-action=\"focus\" aria-label=\"Focus window\">F</button><button class=\"wm-taskbar-preview-action\" data-preview-action=\"minimize\" aria-label=\"Minimize window\">-</button><button class=\"wm-taskbar-preview-action\" data-preview-action=\"close\" aria-label=\"Close window\">X</button></div></aside>\n"
    html = html + "</body>\n"
    html = html + "</html>"
    html

fn write_wm_modern_preview_html(path: text, theme: text) -> bool:
    """Write a standalone modern WM preview artifact for browser review."""
    write_file(path, generate_wm_modern_preview_html(theme))

fn wm_modern_preview_evidence_report(path: text, theme: text) -> text:
    val html = generate_wm_modern_preview_html(theme)
    "wm_modern_preview path={path} theme={theme} bytes={html.len()} windows=2 command_palette=true control_center=true window_overview=true taskbar=true desktop_widgets=true normalized_icons=true motion=standard browser_audit=true screenshot_ready=true audit_json=build/simple_wm_modern_preview_audit.json audit_pass_required=true audit_exit_nonzero=true failure_reasons_field=true selectors=#wm-desktop,.wm-window,.wm-titlebar,.wm-command-palette,.wm-effect-controls,.wm-quality-inspector,.wm-traffic-lights button,.wm-command-palette-input,.wm-command-item,.wm-taskbar-item,.wm-effect-control contrast_min_x100=450 touch_min_px=44 titlebar_height_px=46 taskbar_icon_px=26 overlap_policy=fail-on-intersection overflow_policy=fail-on-text-clipping computed_style_required=true reduced_motion_required=true reduced_transparency_required=true media_features=prefers-contrast=more,prefers-reduced-motion=reduce os_contrast_required=true os_reduced_motion_required=true"

fn wm_modern_preview_browser_audit_command(html_path: text, output_path: text, width: i64, height: i64) -> text:
    """Return the repo-native Chromium capture command for WM preview audit."""
    "ELECTRON_CAPTURE_HTML=\"{html_path}\" ELECTRON_CAPTURE_WIDTH={width} ELECTRON_CAPTURE_HEIGHT={height} ELECTRON_CAPTURE_OUTPUT=\"{output_path}\" ELECTRON_CAPTURE_AUDIT_SELECTORS=\"#wm-desktop,.wm-window,.wm-titlebar,.wm-command-palette,.wm-effect-controls,.wm-quality-inspector,.wm-traffic-lights button,.wm-command-palette-input,.wm-command-item,.wm-taskbar-item,.wm-effect-control\" ELECTRON_CAPTURE_AUDIT_OUTPUT=\"build/simple_wm_modern_preview_audit.json\" ELECTRON_CAPTURE_CONTRAST_MIN_X100=450 ELECTRON_CAPTURE_TOUCH_MIN_PX=44 ELECTRON_CAPTURE_MEDIA_FEATURES=\"prefers-contrast=more,prefers-reduced-motion=reduce\" ELECTRON_CAPTURE_FAIL_ON_AUDIT=1 ELECTRON_CAPTURE_SETTLE_MS=1500 ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum npx electron --no-sandbox --disable-gpu tools/electron-live-bitmap/capture_html_argb.js"

fn _wm_preview_titlebar(icon: text, title: text, command: text, context: text) -> text:
    var html = "      <header class=\"wm-titlebar\">\n"
    html = html + "        <div class=\"wm-traffic-lights\"><button class=\"wm-btn-close\" aria-label=\"Close window\"></button><button class=\"wm-btn-minimize commanding\" aria-label=\"Minimize window\" data-window-command-feedback=\"minimize\"></button><button class=\"wm-btn-maximize\" aria-label=\"Maximize window\"></button></div>\n"
    if icon.starts_with("/") or icon.starts_with("data:") or icon.starts_with("http://") or icon.starts_with("https://"):
        html = html + "        <span class=\"wm-titlebar-icon wm-title-icon wm-round-icon wm-icon-normalized-square\" data-titlebar-slot=\"icon\"><img class=\"wm-icon-image\" src=\"" + icon + "\" alt=\"\"></span>\n"
    else:
        html = html + "        <span class=\"wm-titlebar-icon wm-title-icon wm-round-icon\" data-titlebar-slot=\"icon\"><span class=\"wm-icon-glyph\">" + icon + "</span></span>\n"
    html = html + "        <div class=\"wm-title wm-title-text\" data-titlebar-slot=\"title\">" + title + "</div>\n"
    html = html + "        <input class=\"wm-title-input wm-command-bar command-submitted\" value=\"" + command + "\" aria-label=\"Window command\" data-command-feedback=\"submitted\" data-command-kind=\"path\">\n"
    html = html + "        <div class=\"wm-title-context\">" + context + "</div>\n"
    html = html + "      </header>\n"
    html

fn _wm_preview_resize_handles() -> text:
    "      <div class=\"wm-resize-handle wm-resize-n\" data-direction=\"n\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-s\" data-direction=\"s\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-e\" data-direction=\"e\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-w\" data-direction=\"w\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-ne\" data-direction=\"ne\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-nw\" data-direction=\"nw\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-se\" data-direction=\"se\" aria-hidden=\"true\"></div><div class=\"wm-resize-handle wm-resize-sw\" data-direction=\"sw\" aria-hidden=\"true\"></div>\n"
