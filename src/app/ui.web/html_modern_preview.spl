# Standalone modern WM preview generation.

use nogc_sync_mut.ui.theme_package.{resolve_theme_alias}
use std.io_runtime.{write_file}
use app.ui.web.html_css.{build_modern_theme_css}

fn wm_root_data_attrs(theme: text) -> text:
    """Root attributes required by the generated WM CSS token selectors."""
    val canonical_theme = resolve_theme_alias(theme)
    "data-wm-theme=\"{canonical_theme}\" data-wm-motion=\"standard\" data-wm-animation-style=\"spring\" data-wm-transparency=\"standard\" data-wm-energy=\"standard\" data-wm-feedback=\"standard\" data-wm-contrast=\"comfortable\" data-wm-density=\"comfortable\" data-wm-wallpaper=\"aurora\" data-wm-backdrop-motion=\"ambient\" data-wm-backdrop-intensity=\"balanced\" data-wm-dock-magnification=\"standard\" data-wm-dock-visibility=\"shown\" data-wm-surface-depth=\"layered\" data-wm-traffic-side=\"left\" data-wm-chrome-verbosity=\"full\" data-wm-window-transition=\"mac\" data-wm-accent=\"blue\" data-wm-focus-mode=\"off\" data-wm-quiet-mode=\"off\" data-wm-icon-mask=\"circle\" data-wm-corner-radius=\"round\""

fn generate_wm_modern_preview_html(theme: text) -> text:
    """Generate a standalone WM visual preview fixture for GUI quality review.
    The preview is static on purpose: it exercises the same generated CSS
    contracts without depending on WebSocket state."""
    val canonical_theme = resolve_theme_alias(theme)
    val css = build_modern_theme_css(canonical_theme)
    var html = "<!DOCTYPE html>\n"
    html = html + "<html lang=\"en\" " + wm_root_data_attrs(canonical_theme) + ">\n"
    html = html + "<head>\n"
    html = html + "  <meta charset=\"UTF-8\">\n"
    html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
    html = html + "  <title>Simple WM Modern Preview</title>\n"
    html = html + "  <style>" + css + "</style>\n"
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "  <header class=\"wm-top-menu-bar action-feedback\" role=\"menubar\" aria-label=\"Simple desktop menu bar\" data-menu-feedback=\"activate\" data-menu-feedback-action=\"launcher\"><nav class=\"wm-top-menu-left\" aria-label=\"Application menu\"><button class=\"wm-top-menu-item primary action-feedback\" role=\"menuitem\" data-menu-action=\"launcher\" data-menu-feedback=\"activate\">Simple</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"command_palette\">Simple IDE</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"widgets\">Widgets</button></nav><nav class=\"wm-top-menu-right\" aria-label=\"System menu\"><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"quick_settings\">Wi-Fi</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"quick_settings\">Battery 96%</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"focus_mode\">Focus off</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"notifications\">Notifications</button><button class=\"wm-top-menu-item\" role=\"menuitem\" data-menu-action=\"control_center\">09:41</button></nav></header>\n"
    html = html + "  <div id=\"wm-desktop\" data-preview=\"modern-wm\" data-desktop-peek=\"false\" data-wm-drag-state=\"active\" data-wm-snap-target=\"right\" data-wm-workspace=\"main\" data-wm-workspace-transition=\"enter\" data-wm-workspace-direction=\"forward\">\n"
    html = html + "    <section class=\"wm-desktop-widgets\" aria-label=\"Desktop widgets\"><article class=\"wm-desktop-widget wm-widget-clock action-feedback pinned\" data-widget-feedback=\"pin\" role=\"group\" aria-label=\"Local widget\"><span class=\"wm-desktop-widget-label\">Local</span><strong class=\"wm-desktop-widget-value\">09:41</strong><span class=\"wm-desktop-widget-meta\">Clock</span><span class=\"wm-widget-controls\" role=\"group\" aria-label=\"Widget controls\"><button class=\"wm-widget-control\" data-widget-control=\"pin\" aria-label=\"Pin widget\">P</button><button class=\"wm-widget-control\" data-widget-control=\"remove\" aria-label=\"Remove widget\">X</button></span></article><article class=\"wm-desktop-widget wm-widget-system\" role=\"group\" aria-label=\"Motion widget\"><span class=\"wm-desktop-widget-label\">Motion</span><strong class=\"wm-desktop-widget-value\">standard</strong><span class=\"wm-desktop-widget-meta\">Settings</span><span class=\"wm-widget-controls\" role=\"group\" aria-label=\"Widget controls\"><button class=\"wm-widget-control\" data-widget-control=\"pin\" aria-label=\"Pin widget\">P</button><button class=\"wm-widget-control\" data-widget-control=\"remove\" aria-label=\"Remove widget\">X</button></span></article><article class=\"wm-desktop-widget wm-widget-workspace\" role=\"group\" aria-label=\"Workspace widget\"><span class=\"wm-desktop-widget-label\">Workspace</span><strong class=\"wm-desktop-widget-value\">Simple WM</strong><span class=\"wm-desktop-widget-meta\">Active</span><span class=\"wm-widget-controls\" role=\"group\" aria-label=\"Widget controls\"><button class=\"wm-widget-control\" data-widget-control=\"pin\" aria-label=\"Pin widget\">P</button><button class=\"wm-widget-control\" data-widget-control=\"remove\" aria-label=\"Remove widget\">X</button></span></article></section>\n"
    html = html + "    <section class=\"wm-desktop-items action-feedback\" aria-label=\"Desktop items\" data-desktop-feedback=\"open\" data-desktop-feedback-id=\"report\"><button class=\"wm-desktop-item action-feedback\" data-desktop-item=\"report\" data-desktop-feedback=\"open\" aria-label=\"Quality report, Markdown\"><span class=\"wm-desktop-item-icon wm-round-icon action-feedback\"><span class=\"wm-icon-glyph\">R</span></span><span class=\"wm-desktop-item-label\">Quality report</span><span class=\"wm-desktop-item-meta\">Markdown</span></button><button class=\"wm-desktop-item\" data-desktop-item=\"screenshot\" aria-label=\"Screenshot, PNG image\"><span class=\"wm-desktop-item-icon wm-round-icon\"><span class=\"wm-icon-glyph\">S</span></span><span class=\"wm-desktop-item-label\">Screenshot</span><span class=\"wm-desktop-item-meta\">PNG image</span></button><div class=\"wm-desktop-drop-target\" role=\"button\" aria-label=\"Drop files on desktop\" data-drop-target=\"desktop\" tabindex=\"0\"><span class=\"wm-desktop-drop-icon wm-round-icon\"><span class=\"wm-icon-glyph\">+</span></span><span class=\"wm-desktop-drop-label\">Drop files</span></div></section>\n"
    html = html + "    <aside class=\"wm-command-palette action-feedback query-feedback\" role=\"dialog\" aria-label=\"Simple command palette\" style=\"left: calc(50% - 200px);\" data-command-recent-feedback=\"activate\" data-command-recent-index=\"0\" data-command-item-feedback=\"activate\" data-command-item-index=\"0\" data-command-selection-feedback=\"keyboard\" data-command-selection-index=\"0\" data-command-query-state=\"filtered\" data-command-query-feedback=\"filtered\" data-command-result-count=\"15\">\n"
    html = html + "      <input class=\"wm-command-palette-input query-feedback\" value=\"Open Simple IDE\" aria-label=\"Global command\" aria-controls=\"wm-command-palette-list\" aria-activedescendant=\"wm-command-item-0\">\n"
    html = html + "      <div class=\"wm-command-query-status action-feedback\" role=\"status\" aria-live=\"polite\" data-command-query-state=\"filtered\" data-command-query-feedback=\"filtered\" data-command-result-count=\"15\">15 commands matching Open Simple IDE</div>\n"
    html = html + "      <div class=\"wm-command-recents\" aria-label=\"Recent commands\"><button class=\"wm-command-recent action-feedback\" data-command-index=\"0\" data-command-category=\"Apps\" data-command-feedback=\"recent\" aria-label=\"Open Simple IDE, activated\"><span class=\"wm-command-recent-icon wm-round-icon action-feedback\"><span class=\"wm-icon-glyph\">I</span></span><span>Open Simple IDE</span></button><button class=\"wm-command-recent\" data-command-index=\"3\" data-command-category=\"System\" aria-label=\"Open control center\"><span class=\"wm-command-recent-icon wm-round-icon\"><span class=\"wm-icon-glyph\">C</span></span><span>Open control center</span></button><button class=\"wm-command-recent\" data-command-index=\"19\" data-command-category=\"Quality\" aria-label=\"Open quality inspector\"><span class=\"wm-command-recent-icon wm-round-icon\"><span class=\"wm-icon-glyph\">Q</span></span><span>Open quality inspector</span></button></div>\n"
    html = html + "      <div class=\"wm-command-section\">Apps</div><div class=\"wm-command-section\">System</div>\n"
    html = html + "      <div id=\"wm-command-palette-list\" class=\"wm-command-palette-list\" role=\"listbox\" aria-label=\"Available commands\" aria-activedescendant=\"wm-command-item-0\" data-command-query-state=\"filtered\" data-command-result-count=\"15\"><button id=\"wm-command-item-0\" class=\"wm-command-item active action-feedback selection-feedback\" role=\"option\" aria-selected=\"true\" tabindex=\"0\" data-command-index=\"0\" data-command-feedback=\"activate\" data-command-selection-feedback=\"select\"><span class=\"wm-taskbar-icon wm-round-icon action-feedback selection-feedback\"><span class=\"wm-icon-glyph\">I</span></span><span class=\"wm-command-label\"><span class=\"wm-command-match\" data-command-match=\"query\">Open Simple IDE</span></span><span class=\"wm-command-meta\"><span class=\"wm-command-category-badge\" data-command-category=\"Apps\">Apps</span><span class=\"wm-command-shortcut action-feedback selection-feedback\">Enter</span></span></button><button id=\"wm-command-item-1\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"1\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">C</span></span><span>Open control center</span><span class=\"wm-command-shortcut\">Cmd ,</span></button><button id=\"wm-command-item-2\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"2\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">H</span></span><span>Show system HUD</span><span class=\"wm-command-shortcut\">Cmd Shift H</span></button><button id=\"wm-command-item-3\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"3\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">P</span></span><span>Show privacy status</span><span class=\"wm-command-shortcut\">Cmd Shift P</span></button><button id=\"wm-command-item-4\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"4\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">O</span></span><span>Show window overview</span><span class=\"wm-command-shortcut\">Cmd O</span></button><button id=\"wm-command-item-5\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"5\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">R</span></span><span>Show stage rail</span><span class=\"wm-command-shortcut\">Cmd Shift O</span></button><button id=\"wm-command-item-6\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"6\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">S</span></span><span>Switch workspace</span><span class=\"wm-command-shortcut\">Cmd Shift W</span></button><button id=\"wm-command-item-7\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"7\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">V</span></span><span>Show clipboard history</span><span class=\"wm-command-shortcut\">Cmd Shift V</span></button><button id=\"wm-command-item-8\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"8\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">C</span></span><span>Open screen capture</span><span class=\"wm-command-shortcut\">Cmd Shift S</span></button><button id=\"wm-command-item-9\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"9\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">Q</span></span><span>Open quick settings</span><span class=\"wm-command-shortcut\">Cmd Shift Q</span></button><button id=\"wm-command-item-10\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"10\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">N</span></span><span>Show notification center</span><span class=\"wm-command-shortcut\">Cmd Shift N</span></button><button id=\"wm-command-item-11\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"11\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">B</span></span><span>Switch to Browser</span><span class=\"wm-command-shortcut\">Cmd 2</span></button><button id=\"wm-command-item-12\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"12\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">M</span></span><span>Set motion: reduced</span><span class=\"wm-command-shortcut\">Cmd 2</span></button><button id=\"wm-command-item-13\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"13\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">A</span></span><span>Set wallpaper: aurora</span><span class=\"wm-command-shortcut\">Cmd 7</span></button><button id=\"wm-command-item-14\" class=\"wm-command-item\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" data-command-index=\"14\"><span class=\"wm-taskbar-icon wm-round-icon\"><span class=\"wm-icon-glyph\">W</span></span><span>Open widget gallery</span><span class=\"wm-command-shortcut\">Cmd G</span></button></div>\n"
    html = html + "    </aside>\n"
    html = html + "    <section class=\"wm-browser-audit-evidence\" aria-label=\"Browser quality audit\" data-quality-evidence-source=\"browser\" data-browser-audit=\"required\" data-browser-audit-selectors=\"#wm-desktop,.wm-window,.wm-titlebar,.wm-command-palette,.wm-effect-controls,.wm-quality-inspector,.wm-traffic-lights button,.wm-command-palette-input,.wm-command-item,.wm-taskbar-item,.wm-effect-control\" data-browser-audit-contrast-min-x100=\"450\" data-browser-audit-touch-min-px=\"44\" data-browser-audit-overlap-policy=\"fail-on-intersection\" data-browser-audit-overflow-policy=\"fail-on-text-clipping\"><span class=\"wm-browser-audit-item\" data-browser-audit-check=\"computed-style\">computed style</span><span class=\"wm-browser-audit-item\" data-browser-audit-check=\"overlap\">overlap</span><span class=\"wm-browser-audit-item\" data-browser-audit-check=\"screenshot\">screenshot</span></section>\n"
    html = html + "    <section class=\"wm-effect-controls action-feedback\" aria-label=\"Effect controls\" style=\"top: 650px; left: calc(50% - 200px);\" data-effect-panel=\"visible\" data-effect-feedback=\"motion\"><div class=\"wm-effect-control-group\" role=\"group\" aria-label=\"Motion control\"><button class=\"wm-effect-control active action-feedback\" data-effect-control=\"motion\" data-effect-value=\"standard\" aria-pressed=\"true\">Motion standard</button><button class=\"wm-effect-control\" data-effect-control=\"motion\" data-effect-value=\"reduced\" aria-pressed=\"false\">Motion reduced</button><button class=\"wm-effect-control\" data-effect-control=\"motion\" data-effect-value=\"off\" aria-pressed=\"false\">Motion off</button></div><div class=\"wm-effect-control-group\" role=\"group\" aria-label=\"Transparency control\"><button class=\"wm-effect-control active\" data-effect-control=\"transparency\" data-effect-value=\"standard\" aria-pressed=\"true\">Glass standard</button><button class=\"wm-effect-control\" data-effect-control=\"transparency\" data-effect-value=\"reduced\" aria-pressed=\"false\">Glass reduced</button><button class=\"wm-effect-control\" data-effect-control=\"transparency\" data-effect-value=\"off\" aria-pressed=\"false\">Glass off</button></div><div class=\"wm-effect-control-group\" role=\"group\" aria-label=\"Feedback control\"><button class=\"wm-effect-control active\" data-effect-control=\"feedback\" data-effect-value=\"standard\" aria-pressed=\"true\">Feedback standard</button><button class=\"wm-effect-control\" data-effect-control=\"feedback\" data-effect-value=\"subtle\" aria-pressed=\"false\">Feedback subtle</button><button class=\"wm-effect-control\" data-effect-control=\"feedback\" data-effect-value=\"off\" aria-pressed=\"false\">Feedback off</button></div></section>\n"
    html = html + "    <aside class=\"wm-control-center action-feedback\" role=\"dialog\" aria-label=\"WM control center\" data-control-feedback=\"standard_motion\" aria-busy=\"true\"><div class=\"wm-control-title\">Control center</div><div class=\"wm-control-group\" aria-label=\"Motion\"><button class=\"wm-control-button active action-feedback\" data-control-action=\"standard_motion\" data-control-feedback=\"standard_motion\" aria-pressed=\"true\" aria-busy=\"true\">Standard motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Reduced motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Motion off</button></div><div class=\"wm-control-group\" aria-label=\"Quiet mode\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Quiet mode off</button><button class=\"wm-control-button\" aria-pressed=\"false\">Quiet mode on</button></div><div class=\"wm-control-group\" aria-label=\"Animation style\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Spring motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Calm motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Snappy motion</button></div><div class=\"wm-control-group\" aria-label=\"Dock magnification\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Standard dock</button><button class=\"wm-control-button\" aria-pressed=\"false\">Subtle dock</button><button class=\"wm-control-button\" aria-pressed=\"false\">Dock magnification off</button></div><div class=\"wm-control-group\" aria-label=\"Dock visibility\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Dock shown</button><button class=\"wm-control-button\" aria-pressed=\"false\">Dock auto-hide</button><button class=\"wm-control-button\" aria-pressed=\"false\">Dock hidden</button></div><div class=\"wm-control-group\" aria-label=\"Surface depth\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Layered depth</button><button class=\"wm-control-button\" aria-pressed=\"false\">Subtle depth</button><button class=\"wm-control-button\" aria-pressed=\"false\">Flat depth</button></div><div class=\"wm-control-group\" aria-label=\"Traffic controls\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Left traffic</button><button class=\"wm-control-button\" aria-pressed=\"false\">Right traffic</button></div><div class=\"wm-control-group\" aria-label=\"Chrome verbosity\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Full chrome</button><button class=\"wm-control-button\" aria-pressed=\"false\">Compact chrome</button><button class=\"wm-control-button\" aria-pressed=\"false\">Minimal chrome</button></div><div class=\"wm-control-group\" aria-label=\"Window motion\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Mac motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Fade motion</button><button class=\"wm-control-button\" aria-pressed=\"false\">Motion none</button></div><div class=\"wm-control-group\" aria-label=\"Energy policy\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Standard energy</button><button class=\"wm-control-button\" aria-pressed=\"false\">Low power</button><button class=\"wm-control-button\" aria-pressed=\"false\">Critical saver</button></div><div class=\"wm-control-group\" aria-label=\"Feedback policy\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Standard feedback</button><button class=\"wm-control-button\" aria-pressed=\"false\">Subtle feedback</button><button class=\"wm-control-button\" aria-pressed=\"false\">Feedback off</button></div><div class=\"wm-control-group\" aria-label=\"Focus mode\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Focus off</button><button class=\"wm-control-button\" aria-pressed=\"false\">Work focus</button><button class=\"wm-control-button\" aria-pressed=\"false\">Deep focus</button></div><div class=\"wm-control-group\" aria-label=\"Material transparency\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Standard glass</button><button class=\"wm-control-button\" aria-pressed=\"false\">Reduced glass</button><button class=\"wm-control-button\" aria-pressed=\"false\">Solid surfaces</button></div><div class=\"wm-control-group\" aria-label=\"Accent color\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Blue accent</button><button class=\"wm-control-button\" aria-pressed=\"false\">Green accent</button><button class=\"wm-control-button\" aria-pressed=\"false\">Rose accent</button><button class=\"wm-control-button\" aria-pressed=\"false\">Amber accent</button><button class=\"wm-control-button\" aria-pressed=\"false\">Violet accent</button></div><div class=\"wm-control-group\" aria-label=\"Readability contrast\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Comfortable contrast</button><button class=\"wm-control-button\" aria-pressed=\"false\">High contrast</button></div><div class=\"wm-control-group\" aria-label=\"Layout density\"><button class=\"wm-control-button\" aria-pressed=\"false\">Compact density</button><button class=\"wm-control-button active\" aria-pressed=\"true\">Comfortable density</button><button class=\"wm-control-button\" aria-pressed=\"false\">Spacious density</button></div><div class=\"wm-control-group\" aria-label=\"Corner radius\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Round corners</button><button class=\"wm-control-button\" aria-pressed=\"false\">Soft corners</button><button class=\"wm-control-button\" aria-pressed=\"false\">Square corners</button></div><div class=\"wm-control-group\" aria-label=\"Workspace tools\"><button class=\"wm-control-button active\" aria-pressed=\"true\">Desktop widgets</button><button class=\"wm-control-button\" aria-pressed=\"false\">Window overview</button><button class=\"wm-control-button\" aria-pressed=\"false\">Widget gallery</button><button class=\"wm-con