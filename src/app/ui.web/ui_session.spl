# Hosted UI session protocol for src/app/ui.web (wave 3).
#
# Wire contract for a browser-hosted Simple UI session over the existing
# /ui/ws WebSocket. Deliberately tiny and versioned:
#
#   server -> client : hello | snapshot | diff | error
#   client -> server : input | resume
#
# Every frame is a single JSON object with `v` (protocol version) and `t`
# (message type). Node payloads are NOT re-encoded here: `snapshot` embeds
# `ui_access_snapshot_to_json` and `diff` embeds the query-result encoder
# from common.ui.access, so the hosted wire format cannot drift from the
# semantic access snapshot format used by the headless/TUI/GUI drivers.
#
# Revision correlation: every server frame carries `rev`, the
# `snapshot_revision` of the snapshot it describes. A `diff` also carries
# `from` (the revision the client must already hold). A client that holds a
# different revision must not apply the diff; it sends `resume` and the host
# replies with a full `snapshot`.

use common.ui.access.{
    UiAccessNode,
    UiAccessSnapshot,
    ui_access_query_result,
    ui_access_query_to_json,
    ui_access_snapshot_to_json
}
use common.json.{json_escape_string}
use app.ui.web.auth_params.{ui_web_auth_json_field}

pub val UI_WS_PROTOCOL_VERSION: i32 = 1

# Maximum bytes accepted for one client frame before it is rejected outright.
pub val UI_WS_MAX_CLIENT_FRAME_BYTES: i64 = 65536

# Message type tags.
pub val UI_WS_MSG_HELLO: text = "hello"
pub val UI_WS_MSG_SNAPSHOT: text = "snapshot"
pub val UI_WS_MSG_DIFF: text = "diff"
pub val UI_WS_MSG_ERROR: text = "error"
pub val UI_WS_MSG_INPUT: text = "input"
pub val UI_WS_MSG_RESUME: text = "resume"

# =========================================================================
# Diff model
# =========================================================================

struct UiWsDiff:
    """Semantic access-snapshot delta between two revisions of one session.

    `changed` holds nodes that are new or whose serialized form differs.
    `removed` holds canonical ids present in the old revision and absent in
    the new one. `full` is true when the host decided a diff is not
    applicable (no baseline, or a revision gap) and a full snapshot must be
    sent instead."""
    from_revision: i64
    to_revision: i64
    changed: [UiAccessNode]
    removed: [text]
    active_surface: text
    full: bool

fn _ui_ws_node_json(node: UiAccessNode) -> text:
    """Canonical serialization of a single node.

    Reuses the access query-result encoder rather than introducing a second
    node encoding, so a node's diff fingerprint is byte-identical to what
    the client receives."""
    ui_access_query_to_json(ui_access_query_result([node]))

fn _ui_ws_find_node(nodes: [UiAccessNode], canonical_id: text) -> UiAccessNode?:
    var i = 0
    while i < nodes.len():
        if nodes[i].canonical_id == canonical_id:
            return nodes[i]
        i = i + 1
    return nil

fn ui_ws_diff(prev: UiAccessSnapshot, next: UiAccessSnapshot) -> UiWsDiff:
    """Compute the delta from `prev` to `next` by canonical id."""
    var changed: [UiAccessNode] = []
    var removed: [text] = []
    var i = 0
    while i < next.nodes.len():
        val node = next.nodes[i]
        val before = _ui_ws_find_node(prev.nodes, node.canonical_id)
        if before == nil:
            changed = changed.push(node)
        elif _ui_ws_node_json(before) != _ui_ws_node_json(node):
            changed = changed.push(node)
        i = i + 1
    var j = 0
    while j < prev.nodes.len():
        val old_node = prev.nodes[j]
        if _ui_ws_find_node(next.nodes, old_node.canonical_id) == nil:
            removed = removed.push(old_node.canonical_id)
        j = j + 1
    UiWsDiff(
        from_revision: prev.snapshot_revision,
        to_revision: next.snapshot_revision,
        changed: changed,
        removed: removed,
        active_surface: next.active_surface,
        full: false
    )

# =========================================================================
# Server -> client encoders
# =========================================================================

fn _ui_ws_str(value: text) -> text:
    val escaped = json_escape_string(value)
    "\"{escaped}\""

fn _ui_ws_text_array(values: [text]) -> text:
    var parts: [text] = []
    var i = 0
    while i < values.len():
        parts = parts.push(_ui_ws_str(values[i]))
        i = i + 1
    val joined = parts.join(",")
    "[{joined}]"

fn _ui_ws_envelope(kind: text, session_id: text, body: text) -> text:
    val v = UI_WS_PROTOCOL_VERSION
    val t = _ui_ws_str(kind)
    val sid = _ui_ws_str(session_id)
    var parts: [text] = [
        "{",
        "\"v\":{v},\"t\":{t},\"sid\":{sid},{body}",
        "}"
    ]
    parts.join("")

fn ui_ws_encode_hello(session_id: text, resume_token: text, revision: i64) -> text:
    """First server frame after upgrade: session identity + resume token."""
    val rt = _ui_ws_str(resume_token)
    # Field is `resume_token`, not `resume`: the bounded JSON field reader is
    # a substring scan, so a key that is also a message-type value ("resume")
    # matches the `"t":"resume"` value first and silently reads nothing.
    _ui_ws_envelope(UI_WS_MSG_HELLO, session_id, "\"rev\":{revision},\"resume_token\":{rt}")

fn ui_ws_encode_snapshot(session_id: text, snapshot: UiAccessSnapshot) -> text:
    """Full semantic access snapshot, revision-tagged."""
    val rev = snapshot.snapshot_revision
    val payload = ui_access_snapshot_to_json(snapshot)
    _ui_ws_envelope(UI_WS_MSG_SNAPSHOT, session_id, "\"rev\":{rev},\"snapshot\":{payload}")

fn ui_ws_encode_diff(session_id: text, diff: UiWsDiff) -> text:
    """Revision-correlated delta. `from` is the revision the client must hold."""
    val from_rev = diff.from_revision
    val to_rev = diff.to_revision
    val surface = _ui_ws_str(diff.active_surface)
    val changed = ui_access_query_to_json(ui_access_query_result(diff.changed))
    val removed = _ui_ws_text_array(diff.removed)
    var body = "\"rev\":{to_rev},\"from\":{from_rev},\"active_surface\":{surface},"
    body = "{body}\"changed\":{changed},\"removed\":{removed}"
    _ui_ws_envelope(UI_WS_MSG_DIFF, session_id, body)

fn ui_ws_encode_error(session_id: text, code: text, detail: text) -> text:
    """Machine-readable failure. `code` is a stable token, never prose."""
    val c = _ui_ws_str(code)
    val d = _ui_ws_str(detail)
    _ui_ws_envelope(UI_WS_MSG_ERROR, session_id, "\"code\":{c},\"detail\":{d}")

# =========================================================================
# Client -> server decoding
# =========================================================================

struct UiWsClientMessage:
    """Decoded client frame. `ok` is false for anything malformed; the host
    fails closed and answers with an `error` frame rather than guessing."""
    ok: bool
    error: text
    kind: text
    canonical_id: text
    action: text
    value: text
    client_seq: i64
    since_revision: i64
    resume_token: text

fn _ui_ws_bad(error: text) -> UiWsClientMessage:
    UiWsClientMessage(
        ok: false,
        error: error,
        kind: "",
        canonical_id: "",
        action: "",
        value: "",
        client_seq: 0,
        since_revision: 0,
        resume_token: ""
    )

fn _ui_ws_int_field(json: text, field: text) -> i64:
    val raw = ui_web_auth_json_field(json, field)
    if raw == "":
        return 0
    var i = 0
    var acc = 0
    var neg = false
    if raw.slice(0, 1) == "-":
        neg = true
        i = 1
    if i >= raw.len():
        return 0
    while i < raw.len():
        val ch = raw.slice(i, i + 1)
        if ch < "0" or ch > "9":
            return 0
        acc = acc * 10 + _ui_ws_digit(ch)
        i = i + 1
    if neg:
        return 0 - acc
    return acc

fn _ui_ws_digit(ch: text) -> i64:
    var d = 0
    while d < 10:
        if ch == "{d}":
            return d.to_i64()
        d = d + 1
    return 0

fn ui_ws_decode_client(frame: text) -> UiWsClientMessage:
    """Parse one client frame. Only `input` and `resume` exist; anything
    else, any other protocol version, and any oversized frame is rejected."""
    if frame.len() > UI_WS_MAX_CLIENT_FRAME_BYTES:
        return _ui_ws_bad("frame_too_large")
    val version = _ui_ws_int_field(frame, "v")
    if version != UI_WS_PROTOCOL_VERSION.to_i64():
        return _ui_ws_bad("unsupported_protocol_version")
    val kind = ui_web_auth_json_field(frame, "t")
    if kind == UI_WS_MSG_RESUME:
        val token = ui_web_auth_json_field(frame, "resume_token")
        if token == "":
            return _ui_ws_bad("missing_resume_token")
        return UiWsClientMessage(
            ok: true,
            error: "",
            kind: UI_WS_MSG_RESUME,
            canonical_id: "",
            action: "",
            value: "",
            client_seq: 0,
            since_revision: _ui_ws_int_field(frame, "rev"),
            resume_token: token
        )
    if kind != UI_WS_MSG_INPUT:
        return _ui_ws_bad("unsupported_message_type")
    val canonical_id = ui_web_auth_json_field(frame, "id")
    if canonical_id == "":
        return _ui_ws_bad("missing_target")
    val action = ui_web_auth_json_field(frame, "action")
    if action == "":
        return _ui_ws_bad("missing_action")
    UiWsClientMessage(
        ok: true,
        error: "",
        kind: UI_WS_MSG_INPUT,
        canonical_id: canonical_id,
        action: action,
        value: ui_web_auth_json_field(frame, "value"),
        client_seq: _ui_ws_int_field(frame, "seq"),
        since_revision: _ui_ws_int_field(frame, "rev"),
        resume_token: ""
    )

# =========================================================================
# Per-session host state
# =========================================================================

struct UiWebSession:
    """Transport/auth/revision state for ONE hosted connection.

    NOT full session isolation: widget identity is still process-global (see
    src/lib/common/ui/widget_store_ops.spl:38). What is per-session here is
    the transport: session id, granted capability, bound origin, resume
    token, last acknowledged revision, and the baseline node set used to
    compute that session's next diff."""
    session_id: text
    grant_id: text
    origin: text
    resume_token: text
    revision: i64
    baseline: [UiAccessNode]
    active_surface: text
    closed: bool

fn ui_ws_session_open(session_id: text, grant_id: text, origin: text, resume_token: text) -> UiWebSession:
    UiWebSession(
        session_id: session_id,
        grant_id: grant_id,
        origin: origin,
        resume_token: resume_token,
        revision: -1,
        baseline: [],
        active_surface: "",
        closed: false
    )

fn ui_ws_session_advance(session: UiWebSession, snapshot: UiAccessSnapshot) -> (UiWebSession, text):
    """Fold a new snapshot into a session and produce the frame to send.

    Sends a full `snapshot` when the session has no baseline (first frame or
    after a resume); a `diff` otherwise. Returns the updated session so two
    concurrent sessions never share revision or baseline state."""
    val had_baseline = session.revision >= 0
    val updated = UiWebSession(
        session_id: session.session_id,
        grant_id: session.grant_id,
        origin: session.origin,
        resume_token: session.resume_token,
        revision: snapshot.snapshot_revision,
        baseline: snapshot.nodes,
        active_surface: snapshot.active_surface,
        closed: session.closed
    )
    if not had_baseline:
        return (updated, ui_ws_encode_snapshot(session.session_id, snapshot))
    val prev = UiAccessSnapshot(
        protocol_version: snapshot.protocol_version,
        snapshot_revision: session.revision,
        mode: snapshot.mode,
        active_surface: session.active_surface,
        surfaces: [],
        nodes: session.baseline,
        recent_events: []
    )
    (updated, ui_ws_encode_diff(session.session_id, ui_ws_diff(prev, snapshot)))

fn ui_ws_session_resume(session: UiWebSession, presented_token: text, presented_origin: text) -> (bool, text):
    """Validate a resume attempt against this session's own token+origin.

    Returns (accepted, code). A resume never crosses sessions: the token is
    per-session, and the origin must match the origin the token was bound to
    at upgrade time."""
    if session.closed:
        return (false, "session_closed")
    if session.resume_token == "" or presented_token != session.resume_token:
        return (false, "invalid_resume_token")
    if presented_origin != session.origin:
        return (false, "origin_mismatch")
    (true, "")

fn ui_ws_session_reset_baseline(session: UiWebSession) -> UiWebSession:
    """Drop the diff baseline so the next advance sends a full snapshot."""
    UiWebSession(
        session_id: session.session_id,
        grant_id: session.grant_id,
        origin: session.origin,
        resume_token: session.resume_token,
        revision: -1,
        baseline: [],
        active_surface: "",
        closed: session.closed
    )

fn ui_ws_session_find(sessions: [UiWebSession], session_id: text) -> UiWebSession?:
    var i = 0
    while i < sessions.len():
        if sessions[i].session_id == session_id:
            return sessions[i]
        i = i + 1
    return nil

fn ui_ws_session_put(sessions: [UiWebSession], session: UiWebSession) -> [UiWebSession]:
    """Insert or replace a session by id. Ids are unique per store, so two
    live connections can never alias one another's transport state."""
    var out: [UiWebSession] = []
    var replaced = false
    var i = 0
    while i < sessions.len():
        if sessions[i].session_id == session.session_id:
            out = out.push(session)
            replaced = true
        else:
            out = out.push(sessions[i])
        i = i + 1
    if not replaced:
        out = out.push(session)
    out

fn ui_ws_session_close(sessions: [UiWebSession], session_id: text) -> [UiWebSession]:
    var out: [UiWebSession] = []
    var i = 0
    while i < sessions.len():
        if sessions[i].session_id != session_id:
            out = out.push(sessions[i])
        i = i + 1
    out

export UI_WS_PROTOCOL_VERSION, UI_WS_MAX_CLIENT_FRAME_BYTES
export UI_WS_MSG_HELLO, UI_WS_MSG_SNAPSHOT, UI_WS_MSG_DIFF, UI_WS_MSG_ERROR
export UI_WS_MSG_INPUT, UI_WS_MSG_RESUME
export UiWsDiff, UiWsClientMessage, UiWebSession
export ui_ws_diff, ui_ws_encode_hello, ui_ws_encode_snapshot, ui_ws_encode_diff, ui_ws_encode_error
export ui_ws_decode_client
export ui_ws_session_open, ui_ws_session_advance, ui_ws_session_resume, ui_ws_session_reset_baseline
export ui_ws_session_find, ui_ws_session_put, ui_ws_session_close
