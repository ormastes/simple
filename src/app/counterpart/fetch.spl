@allow(primitive_api)
# `simple counterpart fetch` — the ONLY network phase in the framework.
#
# It refuses to run without an explicit pinned lock revision. "latest" and
# "HEAD" are rejected by name, and so is a missing revision, because a
# conformance verdict that depends on whatever upstream published today is not
# a verdict. Everything else in the framework reads the local verified cache.

use std.io_runtime.{mkdir_p, process_run}
use std.nogc_sync_mut.spec.evidence.counterpart.package_registry.{
    COUNTERPART_LOCK_PATH,
    LockRecord,
    ProviderDescriptor,
    fetch_rejections,
    load_lock_file,
    lock_record_for,
    provider_needs_fetch
}
use app.counterpart.inspect.{descriptors_for}

pub val COUNTERPART_FETCH_ROOT: text = "build/counterparts/_sources"

fn fetch_one(descriptor: ProviderDescriptor, record: LockRecord) -> i64:
    val failures = fetch_rejections(record)
    if failures.len() > 0:
        print "counterpart fetch: REFUSED for '{descriptor.provider_id}'"
        for failure in failures:
            print "  {failure}"
        return 1
    val dest = COUNTERPART_FETCH_ROOT + "/" + descriptor.provider_id + "/" + record.upstream_revision
    mkdir_p(dest)
    print "counterpart fetch: {descriptor.provider_id} {record.upstream_url}@{record.upstream_revision} -> {dest}"
    val (_stdout, stderr, code) = process_run("/bin/sh", ["-c",
        "cd '{dest}' && git init -q . && git fetch -q --depth 1 '{record.upstream_url}' '{record.upstream_revision}' && git checkout -q FETCH_HEAD"])
    if code != 0:
        print "counterpart fetch: download failed rc={code}"
        print stderr
        return 1
    # The lock's source hash is the acceptance test for the download; a fetch
    # that cannot be checked against it is not a fetch this command performs
    # (fetch_rejections already refused an unhashed record above).
    print "counterpart fetch: fetched; verify with `simple counterpart verify {descriptor.provider_id}`"
    0

pub fn run_fetch(provider_id: text, allow_network: bool) -> i64:
    if not allow_network:
        print "counterpart fetch: refusing to reach the network without --allow-network"
        return 2
    if provider_id == "":
        print "counterpart fetch: name a provider; fetch never runs across every descriptor implicitly"
        return 2
    val descriptors = descriptors_for(provider_id)
    if descriptors.len() == 0:
        print "counterpart fetch: no descriptor for '{provider_id}'"
        return 1
    val records = load_lock_file(COUNTERPART_LOCK_PATH)
    var worst: i64 = 0
    for descriptor in descriptors:
        if not provider_needs_fetch(descriptor):
            print "counterpart fetch: {descriptor.provider_id} declares no upstream; nothing to fetch"
            continue
        if val record = lock_record_for(records, descriptor.provider_id):
            val code = fetch_one(descriptor, record)
            if code != 0:
                worst = code
        else:
            print "counterpart fetch: '{descriptor.provider_id}' has no lock record; refusing to fetch an unpinned provider"
            worst = 1
    worst
