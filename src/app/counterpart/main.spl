@allow(primitive_api)
# `simple counterpart {inspect,fetch,build,verify,list-components,run}`.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §4
#
# NOTE for the coordinator: this entrypoint is NOT wired into the shared CLI
# dispatcher. To expose the subcommand, add one branch to
# src/app/cli/_CliMain/main_and_help.spl next to the other file delegations.

use std.io_runtime.{get_args}
use app.counterpart.build.{run_build}
use app.counterpart.fetch.{run_fetch}
use app.counterpart.inspect.{run_inspect, run_list_components}
use app.counterpart.run.{run_run}
use app.counterpart.verify.{run_verify}

fn print_usage():
    print "usage: simple counterpart <command> [provider-id] [flags]"
    print ""
    print "  inspect [provider]          resolve every descriptor and print why each is or is not usable"
    print "  list-components [provider]  list declared components and their counterpart boundary ids"
    print "  fetch <provider> --allow-network"
    print "                              the ONLY network phase; refuses any unpinned or floating revision"
    print "  build [provider]            compile the adapter into build/counterparts/<target>/<digest>/"
    print "  verify [provider]           re-hash the cached artifact and compare it with the lockfile"
    print "  run [provider]              resolution gate: refuse to start unless providers verify"
    print ""
    print "A provider that is missing, mismatched or still locked to a 'pending'"
    print "placeholder is UNAVAILABLE. It is never a pass."

fn first_positional(args: [text]) -> text:
    for arg in args:
        if not arg.starts_with("-"):
            return arg
    ""

fn has_flag(args: [text], flag: text) -> bool:
    for arg in args:
        if arg == flag:
            return true
    false

pub fn counterpart_main(args: [text]) -> i64:
    if args.len() == 0:
        print_usage()
        return 2
    val command = args[0]
    var rest: [text] = []
    var index: i64 = 1
    while index < args.len():
        rest.push(args[index])
        index = index + 1
    val provider = first_positional(rest)

    if command == "inspect":
        return run_inspect(provider)
    if command == "list-components":
        return run_list_components(provider)
    if command == "fetch":
        return run_fetch(provider, has_flag(rest, "--allow-network"))
    if command == "build":
        return run_build(provider)
    if command == "verify":
        return run_verify(provider)
    if command == "run":
        return run_run(provider)
    if command == "--help" or command == "-h" or command == "help":
        print_usage()
        return 0
    print "counterpart: unknown command '{command}'"
    print_usage()
    2

pub fn main() -> i64:
    val argv = get_args()
    var args: [text] = []
    var index: i64 = 1
    while index < argv.len():
        args.push(argv[index])
        index = index + 1
    counterpart_main(args)
