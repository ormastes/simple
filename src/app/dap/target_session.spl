# Target-neutral DAP session (P9, design §8)
#
# ONE DAP session that drives ANY `DebugTarget`: the host by default, a GPU
# lane when the launch config asks for one. The launch config selects the
# target exactly as the design specifies —
#
#   {"type":"simple","program":"cell.spl"}                     -> host
#   {"type":"simple","program":"cell.spl","gpu":true}          -> config-resolved GPU
#   {"type":"simple","program":"...","gpuModeSpec":"interpreter(remote(cuda(sm80)))"}
#                                                              -> explicit, verbatim
#
# plus the two custom requests `simple/profileBegin` / `simple/profileEnd`,
# whose response body is a `ProfileReport` rendered as JSON.
#
# ADDITIVE ONLY. Nothing in the existing DAP files is modified, moved, or
# restructured; this module imports `HostDebugTarget` (P3) and drives it, and
# owns its own small JSON helpers rather than reaching into
# `simple_dap_main.spl`'s private `_dap_*` scanners. `simple_dap_main.spl`
# ends with a bare top-level `simple_dap_server_main()` call, so the import
# below is deliberately SELECTIVE and via P3's adapter, which does not start
# the stdio server.
#
# ALIASING NOTE (load-bearing). A capability handle stops aliasing its target
# unless the acquisition is a function's TAIL expression
# (`ref_debug_profiler_handle_stops_aliasing_unless_tail_expression_2026-08-09.md`),
# which would silently discard `set_breakpoint` / `profile_begin`. This module
# therefore uses the shape P3 proved safe: it holds the CLASS-TYPED
# `HostDebugTarget` / `HostProfileTarget` values DIRECTLY as fields and calls
# their methods through `self.target.` / `self.profiler.`. It never binds a
# trait-typed capability handle to a local. The spec guards this by asserting
# a breakpoint set through the session is visible through the session
# afterwards, and that a profile window measured through the session is
# non-absent.
#
# Design: doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md §8

use app.dap.host_debug_target.{HostDebugTarget}
use std.common.debug.capability.{CapLevel, cap_level_name}
use std.common.debug.debug_target.{DebugState}
use std.common.debug.host_profile_target.{HostProfileTarget}
use std.common.debug.profile_target.{ProfileReport, profile_report_unavailable}
use std.common.debug.session_core.{AttachOpts, attach_opts_default}
use std.notebook.gpu_config.{GpuConfig, default_gpu_config}
use std.notebook.gpu_mode_resolver.{GpuBackendProbe, resolve_gpu_mode_spec}

# ============================================================================
# Small JSON helpers
#
# Deliberately local: the equivalents in `simple_dap_main.spl` are private
# `_dap_*` functions, and exporting them would mean editing that file, which
# P9 must not do (P3 achieved a purely additive diff; this matches it).
# ============================================================================

fn json_escape(s: text) -> text:
    var out = ""
    var i = 0
    # slice() is byte-indexed; stay in byte space throughout so multi-byte
    # characters are copied through unchanged rather than split.
    while i < s.len():
        val ch = s.slice(i, i + 1)
        if ch == "\"":
            out = out + "\\\""
        elif ch == "\\":
            out = out + "\\\\"
        elif ch == "\n":
            out = out + "\\n"
        elif ch == "\r":
            out = out + "\\r"
        elif ch == "\t":
            out = out + "\\t"
        else:
            out = out + ch
        i = i + 1
    out

fn find_from(haystack: text, needle: text, start: i64) -> i64:
    """Byte index of `needle` at or after `start`, or -1."""
    if needle.len() == 0:
        return -1
    var i = start
    while i + needle.len() <= haystack.len():
        if haystack.slice(i, i + needle.len()) == needle:
            return i
        i = i + 1
    -1

fn json_string_field(json: text, key: text) -> text:
    """Value of a top-level-ish `"key":"value"` pair, "" when absent.
    Unescapes only the escapes `json_escape` produces, which is every escape
    a DAP client sends for these fields in practice."""
    val marker = "\"" + key + "\""
    val at = find_from(json, marker, 0)
    if at < 0:
        return ""
    var i = at + marker.len()
    # skip whitespace and the colon
    while i < json.len() and (json.slice(i, i + 1) == " " or json.slice(i, i + 1) == ":"):
        i = i + 1
    if i >= json.len() or json.slice(i, i + 1) != "\"":
        return ""
    i = i + 1
    var out = ""
    while i < json.len():
        val ch = json.slice(i, i + 1)
        if ch == "\\" and i + 1 < json.len():
            val nxt = json.slice(i + 1, i + 2)
            if nxt == "n":
                out = out + "\n"
            elif nxt == "t":
                out = out + "\t"
            elif nxt == "r":
                out = out + "\r"
            else:
                out = out + nxt
            i = i + 2
        elif ch == "\"":
            return out
        else:
            out = out + ch
            i = i + 1
    out

fn json_bool_field(json: text, key: text) -> bool:
    """True only for a literal `true`; a missing key, `false`, or anything
    else is false. Fail-CLOSED: an unparseable `gpu` value must never route a
    session onto a GPU the user did not ask for."""
    val marker = "\"" + key + "\""
    val at = find_from(json, marker, 0)
    if at < 0:
        return false
    var i = at + marker.len()
    while i < json.len() and (json.slice(i, i + 1) == " " or json.slice(i, i + 1) == ":"):
        i = i + 1
    if i + 4 > json.len():
        return false
    json.slice(i, i + 4) == "true"

fn json_int_field(json: text, key: text) -> i64:
    """Value of `"key":<int>`, or -1 when absent/unparseable."""
    val marker = "\"" + key + "\""
    val at = find_from(json, marker, 0)
    if at < 0:
        return -1
    var i = at + marker.len()
    while i < json.len() and (json.slice(i, i + 1) == " " or json.slice(i, i + 1) == ":"):
        i = i + 1
    var negative = false
    if i < json.len() and json.slice(i, i + 1) == "-":
        negative = true
        i = i + 1
    var digits = ""
    while i < json.len():
        val ch = json.slice(i, i + 1)
        if ch >= "0" and ch <= "9":
            digits = digits + ch
            i = i + 1
        else:
            break
    if digits == "":
        return -1
    val value = digits.to_i64()
    if negative:
        return 0 - value
    value

fn json_all_int_fields(json: text, key: text) -> [i64]:
    """Every `"key":<int>` occurrence, in document order. Used for the
    `setBreakpoints` `{"breakpoints":[{"line":N},...]}` array without needing
    a general JSON parser."""
    val marker = "\"" + key + "\""
    var out: [i64] = []
    var at = find_from(json, marker, 0)
    while at >= 0:
        var i = at + marker.len()
        while i < json.len() and (json.slice(i, i + 1) == " " or json.slice(i, i + 1) == ":"):
            i = i + 1
        var digits = ""
        while i < json.len():
            val ch = json.slice(i, i + 1)
            if ch >= "0" and ch <= "9":
                digits = digits + ch
                i = i + 1
            else:
                break
        if digits != "":
            out = out.push(digits.to_i64())
        at = find_from(json, marker, at + marker.len())
    out

fn int_array_json(values: [i64]) -> text:
    var out = "["
    var i = 0
    while i < values.len():
        if i > 0:
            out = out + ","
        out = out + "{values[i]}"
        i = i + 1
    out + "]"

# ============================================================================
# ProfileReport -> DAP response body
#
# Absent quantities are emitted as the literal PROFILE_ABSENT (-1), NOT as
# null and NOT as 0: the whole point of the tiered-honesty contract is that a
# consumer can never mistake "not measured" for "measured zero". `level` uses
# the stable lowercase wire name.
# ============================================================================

pub fn profile_report_json(report: ProfileReport) -> text:
    "{\"level\":\"" + cap_level_name(report.level) + "\"" +
    ",\"wallNs\":{report.wall_ns}" +
    ",\"deviceNs\":{report.device_ns}" +
    ",\"steps\":{report.steps}" +
    ",\"detail\":\"" + json_escape(report.detail) + "\"}"

# ============================================================================
# The session
# ============================================================================

val TARGET_HOST: text = "host"

pub class TargetDapSession:
    # Class-typed capability values held DIRECTLY (see ALIASING NOTE above).
    target: HostDebugTarget
    profiler: HostProfileTarget
    program: text
    # "" for the host lane; the canonical composite spec for a GPU lane.
    mode_spec: text
    # "host" | "cuda" | "vulkan" | "metal"
    target_kind: text
    # "" when the session is usable; otherwise a complete, honest diagnostic.
    error: text
    launched: bool

impl TargetDapSession:
    static fn idle() -> TargetDapSession:
        """A session before `launch`: every capability disarmed, so a stray
        profile request answers Unavailable instead of a fabricated zero."""
        TargetDapSession(
            target: HostDebugTarget.over(_idle_host_session()),
            profiler: HostProfileTarget.disarmed_target(),
            program: "",
            mode_spec: "",
            target_kind: TARGET_HOST,
            error: "",
            launched: false,
        )

    fn is_host() -> bool:
        self.target_kind == TARGET_HOST and self.mode_spec == ""

    fn is_usable() -> bool:
        self.launched and self.error == "" and self.is_host()

    # --- routing ----------------------------------------------------------
    #
    # `gpuModeSpec` wins over `gpu:true` (an explicit spec is a deliberate
    # power-user choice and is passed to the resolver verbatim); `gpu:true`
    # expands from config; neither means host. The tag strings are exactly
    # the spellings `is_bare_gpu_tag` / `is_host_tag` accept.
    me route(launch_json: text, config: GpuConfig, probe: GpuBackendProbe):
        val explicit = json_string_field(launch_json, "gpuModeSpec")
        val tag = if explicit != "": explicit
                  elif json_bool_field(launch_json, "gpu"): "gpu"
                  else: ""
        val resolved = resolve_gpu_mode_spec(tag, config, probe)
        self.mode_spec = resolved.spec
        self.target_kind = resolved.target
        self.error = resolved.error

    me launch_with(launch_json: text, config: GpuConfig, probe: GpuBackendProbe, opts: AttachOpts):
        self.program = json_string_field(launch_json, "program")
        self.route(launch_json, config, probe)
        if self.error != "":
            self.launched = false
            return
        if not self.is_host():
            # The resolver named a GPU lane. Routing is complete and correct,
            # but there is no attach path from a `.spl` program path to a GPU
            # `DebugTarget`: the GPU sessions
            # (src/lib/gc_async_mut/gpu_lane/{cuda,vulkan}_debug_session.spl)
            # attach SVM-G assembly plus a kernel artifact, and no `.spl` ->
            # SVM-G lowering exists. Report that verbatim rather than falling
            # back to the host, which would silently debug the WRONG thing.
            # TODO(P9-gpu-attach): wire the GPU DebugTarget once a `.spl` ->
            # SVM-G lowering exists; until then this path is honest, not done.
            self.error = "gpu target resolved to '{self.target_kind}' " +
                "(mode spec '{self.mode_spec}') but no DAP attach path exists " +
                "for a GPU target: the GPU debug sessions attach SVM-G source " +
                "plus a kernel artifact, and no .spl -> SVM-G lowering exists"
            self.launched = false
            return
        if self.program == "":
            self.error = "launch: no 'program' in the launch configuration"
            self.launched = false
            return
        self.target = HostDebugTarget.launch(self.program)
        self.profiler = HostProfileTarget.new(opts)
        self.launched = true

    # --- DAP request handling ---------------------------------------------

    me handle(request_json: text) -> text:
        """One DAP request JSON in, one response JSON out. Unknown commands
        get a DAP error response, never a silent success."""
        val seq = json_int_field(request_json, "seq")
        val command = json_string_field(request_json, "command")
        if command == "":
            return error_response(seq, "", "malformed request: no 'command'")
        if command == "initialize":
            return success_response(seq, command, self.initialize_body())
        if command == "simple/profileBegin":
            return success_response(seq, command, self.profile_begin_body())
        if command == "simple/profileEnd":
            return success_response(seq, command, profile_report_json(self.profile_end()))
        if command == "disconnect" or command == "terminate":
            val detached = self.detach()
            return success_response(seq, command, "{\"detached\":\"" + json_escape(detached) + "\"}")
        if not self.launched:
            return error_response(seq, command, self.not_ready_reason())
        if command == "setBreakpoints":
            return success_response(seq, command, self.set_breakpoints_body(request_json))
        if command == "threads":
            return success_response(seq, command, "{\"threads\":[{\"id\":1,\"name\":\"main\"}]}")
        if command == "stackTrace":
            return success_response(seq, command, self.state_body())
        if command == "next" or command == "stepIn" or command == "stepOut":
            val stepped = self.target.step()
            return success_response(seq, command, self.state_body_of(stepped))
        if command == "continue":
            val resumed = self.target.resume()
            return success_response(seq, command, self.state_body_of(resumed))
        error_response(seq, command, "unsupported request '{command}'")

    fn not_ready_reason() -> text:
        if self.error != "":
            return self.error
        "session not launched"

    fn initialize_body() -> text:
        """Advertises the two custom requests by name, so a client can
        discover them instead of probing blindly."""
        "{\"supportsConfigurationDoneRequest\":true" +
        ",\"supportsCustomRequests\":true" +
        ",\"simpleCustomRequests\":[\"simple/profileBegin\",\"simple/profileEnd\"]}"

    # `pc_kind` is reported on every state body: it is the ONE unit-of-location
    # subtlety in the shared contract, and a renderer that ignores it will
    # mislabel GPU program counters as source lines.
    fn state_body() -> text:
        self.state_body_of(self.target.state())

    # The body is rendered from the state the ADVANCING call returned, not
    # from a fresh `state()` read: `state()` is a pure read and always reports
    # `running`, so re-reading it would erase the `step` / `breakpoint` /
    # `halt` stop reason the client needs.
    fn state_body_of(s: DebugState) -> text:
        "{\"target\":\"" + json_escape(self.target_kind) + "\"" +
        ",\"modeSpec\":\"" + json_escape(self.mode_spec) + "\"" +
        ",\"pc\":{s.pc}" +
        ",\"pcKind\":\"" + json_escape(s.pc_kind) + "\"" +
        ",\"sp\":{s.sp}" +
        ",\"stopReason\":\"" + json_escape(s.stop_reason) + "\"" +
        ",\"callStack\":" + int_array_json(s.call_stack) + "}"

    me set_breakpoints_body(request_json: text) -> text:
        """Replaces the breakpoint set, DAP `setBreakpoints` semantics.
        `verified` is per requested line and reports what the TARGET actually
        accepted -- a line the target rejected comes back verified:false
        rather than being silently reported as set."""
        val requested = json_all_int_fields(request_json, "line")
        var existing = self.target.breakpoints()
        var i = 0
        while i < existing.len():
            self.target.clear_breakpoint(existing[i])
            i = i + 1
        var body = "{\"breakpoints\":["
        var j = 0
        while j < requested.len():
            if j > 0:
                body = body + ","
            val line = requested[j]
            val added = self.target.set_breakpoint(line)
            body = body + "{\"verified\":" + (if added: "true" else: "false") + ",\"line\":{line}}"
            j = j + 1
        body + "]}"

    # --- profiling --------------------------------------------------------

    me profile_begin_body() -> text:
        if not self.launched:
            return "{\"armed\":false,\"reason\":\"" + json_escape(self.not_ready_reason()) + "\"}"
        self.profiler.profile_begin()
        "{\"armed\":" + (if cap_level_name(self.profiler.profile_level()) == "unavailable": "false" else: "true") +
        ",\"level\":\"" + cap_level_name(self.profiler.profile_level()) + "\"}"

    me profile_end() -> ProfileReport:
        if not self.launched:
            return profile_report_unavailable(
                "target=dap; profileEnd on a session that is not launched: " + self.not_ready_reason())
        self.profiler.profile_end()

    me detach() -> text:
        if not self.launched:
            return ""
        self.launched = false
        self.target.detach()

# ============================================================================
# Response framing
# ============================================================================

pub fn success_response(seq: i64, command: text, body: text) -> text:
    "{\"type\":\"response\",\"request_seq\":{seq},\"success\":true,\"command\":\"" +
    json_escape(command) + "\",\"body\":" + body + "}"

pub fn error_response(seq: i64, command: text, message: text) -> text:
    "{\"type\":\"response\",\"request_seq\":{seq},\"success\":false,\"command\":\"" +
    json_escape(command) + "\",\"message\":\"" + json_escape(message) + "\"}"

# ============================================================================
# Entry points
# ============================================================================

fn _idle_host_session() -> HostDebugTarget:
    """An unattached host target: every method answers (terminal state / empty
    reads) instead of panicking, per the `DebugTarget` contract."""
    var t = HostDebugTarget.launch("")
    t.detach()
    t

pub fn target_dap_session_launch(launch_json: text, config: GpuConfig, probe: GpuBackendProbe) -> TargetDapSession:
    """The testable entry point: caller supplies the config and the probe, so
    the GPU routing matrix is exercisable with no hardware present."""
    var session = TargetDapSession.idle()
    session.launch_with(launch_json, config, probe, attach_opts_default())
    session

pub fn target_dap_session_launch_with_opts(launch_json: text, config: GpuConfig, probe: GpuBackendProbe, opts: AttachOpts) -> TargetDapSession:
    var session = TargetDapSession.idle()
    session.launch_with(launch_json, config, probe, opts)
    session

pub fn target_dap_session_host(program: text) -> TargetDapSession:
    """Shorthand for the default (host) lane, no config or probe needed --
    the resolver returns the host resolution for an absent tag without
    consulting the probe at all."""
    target_dap_session_launch("{\"program\":\"" + json_escape(program) + "\"}", default_gpu_config(), _never_probe())

class NeverProbe:
    calls: i64

impl GpuBackendProbe for NeverProbe:
    me probe_backend(backend: text) -> text:
        # Reached only if a host-tagged launch ever probed, which would be a
        # routing bug; say so rather than returning a plausible skip.
        self.calls = self.calls + 1
        "skip:host-lane-must-not-probe-{backend}"

fn _never_probe() -> NeverProbe:
    NeverProbe(calls: 0)

export TargetDapSession, target_dap_session_launch, target_dap_session_launch_with_opts
export target_dap_session_host, profile_report_json, success_response, error_response
