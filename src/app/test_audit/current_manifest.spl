# Deterministic, receipt-aware test manifest audit.
#
# The audit is intentionally data-driven: callers provide bounded source and
# receipt rows.  It does not walk the repository or run tests.  A receipt can
# become a current pass/fail only when every compiler, mode, host, path, and
# date field matches the declared current identity.

val CURRENT_TEST_MANIFEST_SCHEMA = "simple.current-test-manifest.v2"

struct TestAuditIdentity:
    compiler_path: text
    compiler_sha256: text
    compiler_stage: text
    mode: text
    host: text
    receipt_path: text
    receipt_date: text

struct TestAuditRow:
    schema: text
    source_path: text
    case_id: text
    mirror_of: text
    kind: text
    current_status: text
    compiler_path: text
    compiler_sha256: text
    compiler_stage: text
    mode: text
    host: text
    receipt_path: text
    receipt_date: text
    declared: i64
    executed: i64
    passed: i64
    failed: i64
    dropped: i64
    reason: text

fn test_audit_identity(
    compiler_path: text,
    compiler_sha256: text,
    compiler_stage: text,
    mode: text,
    host: text,
    receipt_path: text,
    receipt_date: text
) -> TestAuditIdentity:
    TestAuditIdentity(
        compiler_path: compiler_path,
        compiler_sha256: compiler_sha256,
        compiler_stage: compiler_stage,
        mode: mode,
        host: host,
        receipt_path: receipt_path,
        receipt_date: receipt_date
    )

fn test_audit_row(
    source_path: text,
    case_id: text,
    mirror_of: text,
    kind: text,
    identity: TestAuditIdentity,
    declared: i64,
    executed: i64,
    passed: i64,
    failed: i64,
    dropped: i64,
    reason: text
) -> TestAuditRow:
    TestAuditRow(
        schema: CURRENT_TEST_MANIFEST_SCHEMA,
        source_path: source_path,
        case_id: case_id,
        mirror_of: mirror_of,
        kind: kind,
        current_status: "not_run",
        compiler_path: identity.compiler_path,
        compiler_sha256: identity.compiler_sha256,
        compiler_stage: identity.compiler_stage,
        mode: identity.mode,
        host: identity.host,
        receipt_path: identity.receipt_path,
        receipt_date: identity.receipt_date,
        declared: declared,
        executed: executed,
        passed: passed,
        failed: failed,
        dropped: dropped,
        reason: reason
    )

fn _test_audit_kind_valid(kind: text) -> bool:
    (kind == "executable" or kind == "mirror" or kind == "pending" or
        kind == "ignored" or kind == "unavailable" or kind == "comment" or
        kind == "fixture")

fn _test_audit_status_valid(status: text) -> bool:
    (status == "pass" or status == "fail" or status == "dropped" or
        status == "not_run" or status == "historical_only")

fn test_audit_row_rejections(row: TestAuditRow) -> [text]:
    var out: [text] = []
    if row.schema != CURRENT_TEST_MANIFEST_SCHEMA:
        out.push("wrong-schema")
    if row.source_path == "":
        out.push("missing-source-path")
    if row.case_id == "":
        out.push("missing-case-id")
    if not _test_audit_kind_valid(row.kind):
        out.push("unknown-kind:" + row.kind)
    if not _test_audit_status_valid(row.current_status):
        out.push("unknown-current-status:" + row.current_status)
    if (row.declared < 0 or row.executed < 0 or row.passed < 0 or
            row.failed < 0 or row.dropped < 0):
        out.push("negative-count")
    if row.passed + row.failed > row.executed:
        out.push("terminal-count-exceeds-executed")
    if row.kind == "mirror" and row.mirror_of == "":
        out.push("mirror-without-owner")
    if row.kind != "mirror" and row.mirror_of != "":
        out.push("non-mirror-with-owner")
    out

fn test_audit_receipt_matches_current(
    row: TestAuditRow,
    current: TestAuditIdentity
) -> bool:
    (row.receipt_path != "" and row.receipt_date != "" and
        row.compiler_path == current.compiler_path and
        row.compiler_sha256 == current.compiler_sha256 and
        row.compiler_stage == current.compiler_stage and
        row.mode == current.mode and row.host == current.host and
        row.receipt_path == current.receipt_path and
        row.receipt_date == current.receipt_date)

fn _test_audit_with_status(row: TestAuditRow, status: text) -> TestAuditRow:
    TestAuditRow(
        schema: row.schema,
        source_path: row.source_path,
        case_id: row.case_id,
        mirror_of: row.mirror_of,
        kind: row.kind,
        current_status: status,
        compiler_path: row.compiler_path,
        compiler_sha256: row.compiler_sha256,
        compiler_stage: row.compiler_stage,
        mode: row.mode,
        host: row.host,
        receipt_path: row.receipt_path,
        receipt_date: row.receipt_date,
        declared: row.declared,
        executed: row.executed,
        passed: row.passed,
        failed: row.failed,
        dropped: row.dropped,
        reason: row.reason
    )

fn test_audit_reconcile_row(
    row: TestAuditRow,
    current: TestAuditIdentity
) -> TestAuditRow:
    if row.receipt_path != "" and not test_audit_receipt_matches_current(row, current):
        return _test_audit_with_status(row, "historical_only")
    if row.receipt_path == "" and row.executed > 0:
        return _test_audit_with_status(row, "historical_only")
    if row.kind == "mirror" or row.kind == "ignored":
        return _test_audit_with_status(row, "dropped")
    if row.kind != "executable":
        return _test_audit_with_status(row, "not_run")
    if row.failed > 0:
        return _test_audit_with_status(row, "fail")
    if row.executed > 0 and row.passed == row.executed:
        return _test_audit_with_status(row, "pass")
    if row.executed == 0 and row.dropped > 0:
        return _test_audit_with_status(row, "dropped")
    _test_audit_with_status(row, "not_run")

fn _test_audit_row_key(row: TestAuditRow) -> text:
    (row.source_path + "\u{1f}" + row.case_id + "\u{1f}" + row.mirror_of +
        "\u{1f}" + row.kind + "\u{1f}" + row.compiler_path + "\u{1f}" +
        row.compiler_sha256 + "\u{1f}" + row.compiler_stage + "\u{1f}" +
        row.mode + "\u{1f}" + row.host)

fn _test_audit_receipt_rank(row: TestAuditRow, current: TestAuditIdentity) -> i64:
    if test_audit_receipt_matches_current(row, current):
        return 3
    if row.receipt_path != "":
        return 2
    1

fn _test_audit_escape(value: text) -> text:
    value.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r")

fn _test_audit_compact(row: TestAuditRow) -> text:
    (_test_audit_row_key(row) + "\u{1f}" + row.receipt_date + "\u{1f}" +
        row.receipt_path + "\u{1f}" + row.current_status + "\u{1f}" +
        row.executed.to_text() + "\u{1f}" + row.passed.to_text() + "\u{1f}" +
        row.failed.to_text() + "\u{1f}" + row.dropped.to_text() + "\u{1f}" +
        row.reason)

fn _test_audit_prefer(
    candidate: TestAuditRow,
    present: TestAuditRow,
    current: TestAuditIdentity
) -> bool:
    val candidate_rank = _test_audit_receipt_rank(candidate, current)
    val present_rank = _test_audit_receipt_rank(present, current)
    if candidate_rank != present_rank:
        return candidate_rank > present_rank
    if candidate.receipt_date != present.receipt_date:
        return candidate.receipt_date > present.receipt_date
    if candidate.executed != present.executed:
        return candidate.executed > present.executed
    _test_audit_compact(candidate) < _test_audit_compact(present)

fn _test_audit_sorted(rows: [TestAuditRow]) -> [TestAuditRow]:
    var out: [TestAuditRow] = []
    for row in rows:
        var inserted = false
        var next: [TestAuditRow] = []
        for present in out:
            if not inserted and _test_audit_row_key(row) < _test_audit_row_key(present):
                next.push(row)
                inserted = true
            next.push(present)
        if not inserted:
            next.push(row)
        out = next
    out

fn test_audit_deduplicate(
    rows: [TestAuditRow],
    current: TestAuditIdentity
) -> [TestAuditRow]:
    var unique: [TestAuditRow] = []
    for raw in rows:
        val row = test_audit_reconcile_row(raw, current)
        val key = _test_audit_row_key(row)
        var found = -1
        var index = 0
        while index < unique.len():
            if _test_audit_row_key(unique[index]) == key:
                found = index
            index = index + 1
        if found < 0:
            unique.push(row)
        elif _test_audit_prefer(row, unique[found], current):
            unique[found] = row
    _test_audit_sorted(unique)

fn _test_audit_count(rows: [TestAuditRow], field: text, value: text) -> i64:
    var count = 0
    for row in rows:
        if field == "kind" and row.kind == value:
            count = count + 1
        elif field == "status" and row.current_status == value:
            count = count + 1
    count

fn _test_audit_current_case_count(rows: [TestAuditRow], field: text) -> i64:
    var count = 0
    for row in rows:
        if row.current_status == "pass" or row.current_status == "fail":
            if field == "executed":
                count = count + row.executed
            elif field == "passed":
                count = count + row.passed
            elif field == "failed":
                count = count + row.failed
    count

fn _test_audit_blocker_count(rows: [TestAuditRow]) -> i64:
    var count = 0
    for row in rows:
        if (row.current_status == "fail" or row.kind == "pending" or
                row.kind == "unavailable"):
            count = count + 1
    count

fn _test_audit_render_row(row: TestAuditRow) -> text:
    "row:\n" +
    "  schema: " + _test_audit_escape(row.schema) + "\n" +
    "  source_path: " + _test_audit_escape(row.source_path) + "\n" +
    "  case_id: " + _test_audit_escape(row.case_id) + "\n" +
    "  mirror_of: " + _test_audit_escape(row.mirror_of) + "\n" +
    "  kind: " + row.kind + "\n" +
    "  current_status: " + row.current_status + "\n" +
    "  compiler_path: " + _test_audit_escape(row.compiler_path) + "\n" +
    "  compiler_sha256: " + row.compiler_sha256 + "\n" +
    "  compiler_stage: " + _test_audit_escape(row.compiler_stage) + "\n" +
    "  mode: " + _test_audit_escape(row.mode) + "\n" +
    "  host: " + _test_audit_escape(row.host) + "\n" +
    "  receipt_path: " + _test_audit_escape(row.receipt_path) + "\n" +
    "  receipt_date: " + row.receipt_date + "\n" +
    "  declared: " + row.declared.to_text() + "\n" +
    "  executed: " + row.executed.to_text() + "\n" +
    "  passed: " + row.passed.to_text() + "\n" +
    "  failed: " + row.failed.to_text() + "\n" +
    "  dropped: " + row.dropped.to_text() + "\n" +
    "  reason: " + _test_audit_escape(row.reason) + "\n"

fn test_audit_render_manifest(
    raw_rows: [TestAuditRow],
    current: TestAuditIdentity
) -> Result<text, text>:
    val rows = test_audit_deduplicate(raw_rows, current)
    var errors: [text] = []
    for row in rows:
        for rejection in test_audit_row_rejections(row):
            errors.push(row.source_path + "#" + row.case_id + ":" + rejection)
    if errors.len() > 0:
        return Err(errors.join(";"))
    val blocker_count = _test_audit_blocker_count(rows)
    var out = "schema: " + CURRENT_TEST_MANIFEST_SCHEMA + "\n"
    out = out + "audit_scope: bounded-input-only\n"
    out = out + "repo_wide: false\n"
    out = out + "overall_status: " + (if blocker_count > 0: "fail" else: "pass") + "\n"
    out = out + "blocker_rows: " + blocker_count.to_text() + "\n"
    out = out + "row_count: " + rows.len().to_text() + "\n"
    for kind in ["executable", "mirror", "pending", "ignored", "unavailable", "comment", "fixture"]:
        out = out + "kind_" + kind + ": " + _test_audit_count(rows, "kind", kind).to_text() + "\n"
    for status in ["pass", "fail", "dropped", "not_run", "historical_only"]:
        out = out + "status_" + status + ": " + _test_audit_count(rows, "status", status).to_text() + "\n"
    out = out + "current_executed_cases: " + _test_audit_current_case_count(rows, "executed").to_text() + "\n"
    out = out + "current_passed_cases: " + _test_audit_current_case_count(rows, "passed").to_text() + "\n"
    out = out + "current_failed_cases: " + _test_audit_current_case_count(rows, "failed").to_text() + "\n"
    out = out + "\n"
    for row in rows:
        out = out + _test_audit_render_row(row)
    Ok(out)
