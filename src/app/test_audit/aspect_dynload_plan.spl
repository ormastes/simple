use app.test_audit.current_manifest.{
    TestAuditIdentity, TestAuditRow, test_audit_identity, test_audit_row,
    test_audit_render_manifest}

val ASPECT_DYNLOAD_CURRENT_MANIFEST_PATH =
    "doc/10_metrics/test/current_test_manifest_2026-08-19.sdn"

val _AD_COMPILER =
    "/mnt/data/worktrees/simple-main/bin/release/x86_64-unknown-linux-gnu/simple"
val _AD_CURRENT_SHA =
    "d3d54fab80199cddb962e07ca1ab655c0cfb8be3594ad4aa615084948116af54"
val _AD_HOST = "x86_64-unknown-linux-gnu"
val _AD_CURRENT_RECEIPT =
    "doc/09_report/aspect_dynload_hal_runtime_status_2026-08-19.md"
val _AD_PLAN_RECEIPT =
    "doc/03_plan/compiler/aspect_dynload/aspect_dynload_lane_plan_2026-08-19.md"
val _AD_HISTORICAL_RECEIPT =
    "doc/03_plan/compiler/aspect_dynload/lane_resume_plan_2026-08-18.md"

fn _ad_source_identity() -> TestAuditIdentity:
    test_audit_identity(
        _AD_COMPILER, _AD_CURRENT_SHA, "unrecorded", "interpreter", _AD_HOST,
        "", "")

fn _ad_current_identity() -> TestAuditIdentity:
    test_audit_identity(
        _AD_COMPILER, _AD_CURRENT_SHA, "unrecorded", "interpreter", _AD_HOST,
        _AD_CURRENT_RECEIPT, "2026-08-19")

fn _ad_historical_identity() -> TestAuditIdentity:
    test_audit_identity(
        _AD_COMPILER, "unrecorded", "unrecorded", "interpreter", _AD_HOST,
        _AD_HISTORICAL_RECEIPT, "2026-08-18")

fn _ad_declared(path: text, count: i64) -> TestAuditRow:
    test_audit_row(
        path, "@spec", "", "executable", _ad_source_identity(),
        count, 0, 0, 0, 0,
        "current source declaration count; no matching retained receipt")

fn _ad_current_pass(path: text, count: i64, reason: text) -> TestAuditRow:
    test_audit_row(
        path, "@spec", "", "executable", _ad_current_identity(),
        count, count, count, 0, 0, reason)

fn _ad_current_failure(
    path: text,
    count: i64,
    passed: i64,
    failed: i64,
    reason: text
) -> TestAuditRow:
    test_audit_row(
        path, "@spec", "", "executable", _ad_current_identity(),
        count, count, passed, failed, 0, reason)

fn _ad_historical(
    path: text,
    executed: i64,
    passed: i64,
    failed: i64,
    reason: text
) -> TestAuditRow:
    test_audit_row(
        path, "@spec", "", "executable", _ad_historical_identity(),
        executed, executed, passed, failed, 0, reason)

fn _ad_pending(case_id: text, reason: text) -> TestAuditRow:
    test_audit_row(
        "test/01_unit/lib/aspect_pack_acceptance_pending_spec.spl",
        case_id, "", "pending", _ad_source_identity(),
        1, 0, 0, 0, 0, reason)

fn aspect_dynload_plan_rows() -> [TestAuditRow]:
    var rows: [TestAuditRow] = []

    # Current source inventory: 17 spec files, 133 executable cases and seven
    # native pending declarations.  Counts come from the current checkout;
    # absent a matching receipt they remain not_run.
    rows.push(_ad_declared("test/01_unit/compiler/driver/sif_discrimination_spec.spl", 7))
    rows.push(_ad_declared("test/01_unit/compiler/driver/sif_roundtrip_spec.spl", 4))
    rows.push(_ad_declared("test/01_unit/compiler/loader/aspect_pack_declared_size_bound_defect_class_spec.spl", 5))
    rows.push(_ad_declared("test/01_unit/compiler/loader/aspect_pack_io_spec.spl", 6))
    rows.push(_ad_declared("test/01_unit/compiler/loader/aspect_pack_smf_section_wiring_spec.spl", 7))
    rows.push(_ad_declared("test/01_unit/compiler/loader/exec_memory_bulk_write_spec.spl", 4))
    rows.push(_ad_declared("test/01_unit/compiler/loader/joinpoint_patchpoint_execution_spec.spl", 1))
    rows.push(_ad_declared("test/01_unit/compiler/loader/joinpoint_patchpoint_spec.spl", 9))
    rows.push(_ad_declared("test/01_unit/compiler/loader/object_mapper_no_fabrication_spec.spl", 2))
    rows.push(_ad_declared("test/01_unit/compiler/loader/segment_mapping_count_spec.spl", 6))
    rows.push(_ad_declared("test/01_unit/compiler/loader/segment_symbol_resolution_spec.spl", 8))
    rows.push(_ad_declared("test/01_unit/compiler/semantics/forbidden_io_checker_spec.spl", 13))
    rows.push(_ad_declared("test/01_unit/lib/aspect_pack_acceptance_pending_spec.spl", 1))
    rows.push(_ad_declared("test/01_unit/lib/aspect_pack_defect_class_spec.spl", 25))
    rows.push(_ad_declared("test/01_unit/lib/aspect_pack_forbidden_io_temporal_spec.spl", 7))
    rows.push(_ad_declared("test/01_unit/lib/aspect_pack_signature_verification_spec.spl", 8))
    rows.push(_ad_declared("test/01_unit/lib/aspect_pack_spec.spl", 20))

    # Exact current claims consolidated in the 2026-08-19 status report.
    # Broad prose snapshots are not expanded into invented per-file passes.
    rows.push(_ad_current_pass(
        "test/01_unit/compiler/driver/sif_discrimination_spec.spl", 7,
        "current plan explicitly records discrimination spec green"))
    rows.push(_ad_current_pass(
        "test/01_unit/compiler/driver/sif_roundtrip_spec.spl", 4,
        "current plan explicitly records roundtrip spec green"))
    rows.push(_ad_current_pass(
        "test/01_unit/compiler/loader/object_mapper_no_fabrication_spec.spl", 2,
        "current plan records the real exported mapper at 2/2"))
    rows.push(_ad_current_pass(
        "test/01_unit/compiler/loader/segment_symbol_resolution_spec.spl", 8,
        "current plan records 8/8 and real mapped returns 11/22/33"))

    # Focused current receipts executed with the same compiler identity.  Each
    # row names one exact source file and case count; these are not repo-wide
    # coverage and the older anonymous 23-pass snapshot is excluded.
    rows.push(_ad_current_pass(
        "test/01_unit/app/cli/help_surface_inventory_spec.spl", 4,
        "focused CLI help inventory receipt 4/4"))
    rows.push(_ad_current_pass(
        "test/01_unit/app/cli/help_surface_report_spec.spl", 3,
        "focused CLI help report receipt 3/3"))
    rows.push(_ad_current_pass(
        "test/01_unit/app/cli_help_alignment_spec.spl", 9,
        "focused CLI help alignment receipt 9/9"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/gpu/engine2d/backend_qualcomm_spec.spl", 6,
        "focused GPU Qualcomm backend receipt 6/6"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/gpu/engine2d/device_detect_spec.spl", 4,
        "focused GPU device detection receipt 4/4"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/gpu/engine2d/ffi_intel_spec.spl", 3,
        "focused GPU Intel FFI receipt 3/3"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/gpu/engine2d/ffi_rocm_spec.spl", 5,
        "focused GPU ROCm FFI receipt 5/5"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/gpu/engine2d/engine_platform_spec.spl", 20,
        "focused GPU engine platform receipt 20/20"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/structural/component_resolver_kernel_spec.spl", 7,
        "focused component resolver kernel receipt 7/7"))
    rows.push(_ad_current_pass(
        "test/01_unit/app/startup/component_resolver_spec.spl", 5,
        "focused startup component resolver receipt 5/5"))
    rows.push(_ad_current_pass(
        "test/01_unit/os/smf/component_admission_spec.spl", 4,
        "focused SMF component admission receipt 4/4"))
    rows.push(_ad_current_pass(
        "test/01_unit/app/startup/dynsmf_config_loading_spec.spl", 9,
        "focused startup dynSMF config receipt 9/9"))
    rows.push(_ad_current_pass(
        "test/02_integration/app/simple/dynsmf_autoload_policy_spec.spl", 7,
        "focused startup autoload receipt 7/7"))
    rows.push(_ad_current_pass(
        "test/01_unit/compiler/loader/runtime_surface_spec.spl", 3,
        "focused loader startup fast-path surface receipt 3/3"))
    rows.push(_ad_current_pass(
        "test/01_unit/os/kernel/arch/hal_coverage_parity_contract_spec.spl", 6,
        "focused HAL coverage/parity contract receipt 6/6"))
    rows.push(_ad_current_pass(
        "test/02_integration/log_facade_back_compat_spec.spl", 6,
        "focused log facade compatibility receipt 6/6"))
    rows.push(_ad_current_pass(
        "test/01_unit/lib/log_export_spec.spl", 10,
        "focused log export receipt 10/10"))
    rows.push(_ad_current_pass(
        "test/02_integration/compiler/native_mmap_read_link_spec.spl", 1,
        "focused native mmap link reproducer receipt 1/1"))

    rows.push(_ad_current_failure(
        "test/01_unit/os/smf/aspect_pack_directory_spec.spl", 13, 12, 1,
        "final focused receipt 12/13; admitted-load lookup returned None"))
    rows.push(_ad_current_failure(
        "test/01_unit/compiler/semantics/facet_static_binding_spec.spl", 5, 2, 3,
        "final executed receipt before reset patch was 2/5; patch is unverified"))
    rows.push(test_audit_row(
        "test/perf/io_parity/run_io_parity_benchmarks.shs", "io-parity-benchmark",
        "", "unavailable", _ad_source_identity(), 1, 0, 0, 0, 0,
        "full I/O parity benchmark blocked; mmap link repair passed 1/1 but no benchmark PASS receipt exists"))

    # Older receipt evidence is retained under its incomplete compiler
    # identity.  Reconciliation therefore labels every row historical_only.
    rows.push(_ad_historical(
        "test/01_unit/lib/aspect_pack_spec.spl", 0, 0, 0,
        "historical file exit 0; receipt omitted case count and compiler sha256"))
    rows.push(_ad_historical(
        "test/01_unit/lib/aspect_pack_defect_class_spec.spl", 0, 0, 0,
        "historical file exit 0; receipt omitted case count and compiler sha256"))
    rows.push(_ad_historical(
        "test/01_unit/compiler/loader/segment_mapping_count_spec.spl", 0, 0, 0,
        "historical file exit 0; receipt omitted case count and compiler sha256"))
    rows.push(_ad_historical(
        "test/01_unit/compiler/loader/segment_symbol_resolution_spec.spl", 8, 7, 1,
        "historical 7/8 failure; superseded by the matching current 8/8 receipt"))
    rows.push(_ad_historical(
        "test/01_unit/compiler/driver/sif_roundtrip_spec.spl", 0, 0, 0,
        "historical file exit 0; receipt omitted case count and compiler sha256"))
    rows.push(_ad_historical(
        "test/01_unit/compiler/driver/sif_discrimination_spec.spl", 0, 0, 0,
        "historical file exit 0; receipt omitted case count and compiler sha256"))
    rows.push(test_audit_row(
        "test/01_unit/compiler/loader/segment_symbol_resolution_spec.spl",
        "calls each symbol and gets that symbol's own value back", "", "executable",
        _ad_historical_identity(), 1, 1, 0, 1, 0,
        "historical expected 33 got 0; current spec-level receipt is 8/8"))

    rows.push(_ad_pending("REQ-APK-P01", "zstd writer has no dictionary-id frame support"))
    rows.push(_ad_pending("REQ-APK-P02", "no real aspect-pack signing trust-root custody"))
    rows.push(_ad_pending("REQ-APK-P03", "binding_plan_id record shape is unspecified"))
    rows.push(_ad_pending("REQ-APK-P04", "facet<T>() parser/resolver/lowering surface absent"))
    rows.push(_ad_pending("REQ-APK-P05", "late states have no runtime loader driver"))
    rows.push(_ad_pending("REQ-APK-P06b", "activation future has no runtime loader driver"))
    rows.push(_ad_pending("REQ-APK-P07", "design section 20 has no numeric target"))

    rows.push(test_audit_row(
        _AD_PLAN_RECEIPT, "prose-only-broad-green-claim", "", "comment",
        _ad_source_identity(), 0, 0, 0, 0, 0,
        "70+ examples green is not a per-source executable receipt"))
    rows

fn aspect_dynload_plan_manifest() -> Result<text, text>:
    test_audit_render_manifest(aspect_dynload_plan_rows(), _ad_current_identity())
