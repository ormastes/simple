use app.test_audit.aspect_dynload_plan.{
    ASPECT_DYNLOAD_CURRENT_MANIFEST_PATH, aspect_dynload_plan_manifest}
use app.io.mod.{dir_create_all, file_write, get_args}

fn main() -> i64:
    val args = get_args()
    var output = ASPECT_DYNLOAD_CURRENT_MANIFEST_PATH
    if args.len() > 1:
        val candidate = args[args.len() - 1]
        if candidate != "--":
            output = candidate
    val slash = output.last_index_of("/")
    if slash > 0:
        dir_create_all(output[0:slash])
    match aspect_dynload_plan_manifest():
        case Err(error):
            print "test-audit-error: {error}"
            1
        case Ok(manifest):
            if not file_write(output, manifest):
                print "test-audit-error: write-failed:{output}"
                return 1
            print "test-audit-output={output}"
            0
