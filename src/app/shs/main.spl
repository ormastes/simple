"""Hosted Simple shell (shs): the SimpleOS shell on a host's stdin/stdout.

Runs the same `ShellApp` SimpleOS boots, so a PTY pane gets one command
language (echo, pwd, cd, cat, expr, ...) on Windows, macOS, Linux, BSD and
SimpleOS. Line-oriented: the host PTY owns echo and line editing.

    simple src/app/shs/main.spl          # interactive
    echo 'echo hi' | simple src/app/shs/main.spl

Design: doc/05_design/pty_shell_kinds_shs_default.md
"""
use os.apps.shell.shell_app.{ShellApp}
use std.sosix.stdio.{sosix_print_raw, sosix_stdout_flush}
use std.nogc_sync_mut.io.pipe.{stdin_read_line}

fn main() -> i64:
    var shell = ShellApp.new()
    shell.show_prompt()
    sosix_print_raw(shell.take_remote_output())
    sosix_stdout_flush()
    var running = true
    while running:
        if val line = stdin_read_line():
            running = shell.feed_remote_input(line.trim_end() + "\n")
            sosix_print_raw(shell.take_remote_output())
            sosix_stdout_flush()
        else:
            running = false
    0
