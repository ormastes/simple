"""Process entrypoint for the per-user semantic cache daemon."""

use std.env.platform.{get_cache_location}
use common.cache_daemon_host_authority_v1.{cache_daemon_serve_v1}

fn main() -> i64:
    val root = get_cache_location("simple/cache-manager")
    if root == "":
        return 2i64
    cache_daemon_serve_v1(root)
