# `simple saml <sub> <file.saml>` — CLI front end for the SAML analysis slice.
#
# Subcommands:
#   check <file.saml>
#       Parse + analyze. Print every parser diagnostic and every analysis
#       warning as `path:line: severity: message`. Exit 1 when the module has
#       any error-severity diagnostic, 0 otherwise (warnings do not fail).
#   analyze <file.saml>
#       Print `emit_analysis_report(analysis)` — the one renderer shared by the
#       LSP hover, the IDE panel, and agent callers.
#   generate --target baml|markdown|sdn <file.saml> [--out PATH]
#       Print (or write with --out) the requested projection.
#   doc <file.saml> [--out PATH]
#       Alias for `generate --target markdown`.
#
# Exit codes: 0 success, 1 failure (unreadable input, SAML errors, write
# failure), 2 usage error.
#
# The analysis library is pure and lives in src/lib/common/saml/; this file
# only does argument handling, file IO, and exit-code policy.

use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{file_exists, read_file, write_file, dir_walk, dir_exists}
use std.common.saml.parser.{parse_saml}
use std.common.saml.analysis.{analyze_module, analyze_module_with_specs}
use std.common.saml.emit.{emit_analysis_report, emit_baml, emit_markdown_manual, emit_sdn_manifest}

# Walk `dir` for `*_spec.spl` files and return their (paths, sources) as
# parallel arrays, ready for `analyze_module_with_specs`. Filesystem access
# belongs here (app tier), not in the pure `common/saml` analysis library.
fn discover_spec_files(dir: text) -> ([text], [text]):
    var paths: [text] = []
    var sources: [text] = []
    if dir == "" or not dir_exists(dir):
        return (paths, sources)
    for path in dir_walk(dir):
        if path.ends_with("_spec.spl"):
            paths.push(path)
            sources.push(read_file(path))
    (paths, sources)

fn print_usage() -> None:
    print "Usage: simple saml <subcommand> <file.saml>"
    print ""
    print "Subcommands:"
    print "  check <file.saml> [--specs DIR]         diagnostics; exit 1 on errors"
    print "  analyze <file.saml> [--specs DIR]       print the analysis report"
    print "                                           --specs defaults to test/;"
    print "                                           scans *_spec.spl for external coverage"
    print "  generate --target baml|markdown|sdn <file.saml> [--out PATH]"
    print "  doc <file.saml> [--out PATH]            generated markdown manual"
    print ""
    print "Exit codes: 0 ok, 1 failure, 2 usage error"

fn read_source(path: text) -> text:
    if not file_exists(path):
        return ""
    read_file(path)

fn emit_output(body: text, out_path: text) -> i64:
    if out_path == "":
        print body
        return 0
    if not write_file(out_path, body):
        print "error: cannot write {out_path}"
        return 1
    print "wrote {out_path}"
    0

fn cmd_check(path: text, specs_dir: text) -> i64:
    val source = read_source(path)
    if source == "":
        print "error: cannot read {path}"
        return 1
    val module = parse_saml(source, path)
    val (spec_paths, spec_sources) = discover_spec_files(specs_dir)
    val analysis = analyze_module_with_specs(module, spec_paths, spec_sources)
    var errors: i64 = 0
    for d in module.diagnostics:
        print path + ":" + d.line.to_text() + ": " + d.severity + ": " + d.code + ": " + d.message
        if d.severity == "error":
            errors = errors + 1
    for a in analysis.functions:
        for w in a.warnings:
            print path + ":" + a.line.to_text() + ": warning: " + w
    for w in analysis.module_warnings:
        print path + ":1: warning: " + w
    print "check: " + path + " errors=" + errors.to_text() + " warnings=" + analysis.warning_count.to_text()
    if errors > 0:
        return 1
    0

fn cmd_analyze(path: text, specs_dir: text) -> i64:
    val source = read_source(path)
    if source == "":
        print "error: cannot read {path}"
        return 1
    val module = parse_saml(source, path)
    val (spec_paths, spec_sources) = discover_spec_files(specs_dir)
    print emit_analysis_report(analyze_module_with_specs(module, spec_paths, spec_sources))
    0

fn cmd_generate(target: text, path: text, out_path: text) -> i64:
    val source = read_source(path)
    if source == "":
        print "error: cannot read {path}"
        return 1
    val module = parse_saml(source, path)
    val analysis = analyze_module(module)
    if target == "baml":
        return emit_output(emit_baml(module), out_path)
    if target == "markdown" or target == "md":
        return emit_output(emit_markdown_manual(module, analysis), out_path)
    if target == "sdn":
        return emit_output(emit_sdn_manifest(module, analysis), out_path)
    print "error: unknown --target: {target} (expected baml|markdown|sdn)"
    2

fn main() -> i64:
    var args = get_cli_args()
    # Dispatch may or may not keep the command name in front of the args.
    if args.len() > 0 and args[0] == "saml":
        var shifted: [text] = []
        var k: i64 = 1
        while k < args.len():
            shifted.push(args[k])
            k = k + 1
        args = shifted
    if args.len() < 1:
        print_usage()
        return 2
    val sub = args[0]
    if (sub == "--help" or sub == "-h" or sub == "help"):
        print_usage()
        return 0

    var target = ""
    var out_path = ""
    var file_path = ""
    var specs_dir = "test/"
    var i: i64 = 1
    while i < args.len():
        val arg = args[i]
        if arg == "--target" and i + 1 < args.len():
            target = args[i + 1]
            i = i + 1
        elif arg.starts_with("--target="):
            target = arg.slice(9, arg.len())
        elif arg == "--out" and i + 1 < args.len():
            out_path = args[i + 1]
            i = i + 1
        elif arg.starts_with("--out="):
            out_path = arg.slice(6, arg.len())
        elif arg == "--specs" and i + 1 < args.len():
            specs_dir = args[i + 1]
            i = i + 1
        elif arg.starts_with("--specs="):
            specs_dir = arg.slice(8, arg.len())
        elif file_path == "":
            file_path = arg
        i = i + 1

    if file_path == "":
        print "error: missing <file.saml>"
        print_usage()
        return 2

    if sub == "check":
        return cmd_check(file_path, specs_dir)
    if sub == "analyze":
        return cmd_analyze(file_path, specs_dir)
    if sub == "doc":
        return cmd_generate("markdown", file_path, out_path)
    if sub == "generate":
        if target == "":
            print "error: generate requires --target baml|markdown|sdn"
            return 2
        return cmd_generate(target, file_path, out_path)

    print "error: unknown subcommand: {sub}"
    print_usage()
    2
