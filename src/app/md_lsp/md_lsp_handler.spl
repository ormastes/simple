# Request handler/dispatcher for the Simple language markdown LSP server.
#
# Dispatches LSP requests and builds JSON responses using hand-built JSON
# (same pattern as json_helpers.spl / lsp_transport.spl).

use std.common.markdown
use std.common.json.tokenizer.{json_unescape_string}
use app.md_lsp.md_lsp_markdown.{split_lines, parse_blocks_with_ranges, compute_folding_ranges}
use .md_lsp_workspace.{MdWorkspace, MdDocument}
use std.editor.services.md_diagnostics.{md_diagnose_batch}
use std.common.diagnostics.{DiagnosticBatchV1, DiagnosticV1, LineStartTable, span_to_range, FixConfidence, FixCandidate, DiagnosticActionIndex, ranked_candidates_for, EditTransaction, DocumentSnapshot}
use std.common.string_core.{string_to_byte_array, string_from_byte_array}

# One outbound `textDocument/publishDiagnostics` notification, ready to frame.
pub struct MdLspPublish:
    uri: text
    json: text

# ---------------------------------------------------------------------------
# JSON building helpers (inline, identical pattern to json_helpers.spl)
# ---------------------------------------------------------------------------

fn _q() -> text:
    "\""

fn _md_lsp_json_escape(s: text) -> text:
    var result = ""
    var i = 0
    while i < s.len():
        val ch = s.char_at(i)
        if ch == "\"":
            result = result + "\\\""
        elif ch == "\\":
            result = result + "\\\\"
        elif ch == "\n":
            result = result + "\\n"
        elif ch == "\r":
            result = result + "\\r"
        elif ch == "\t":
            result = result + "\\t"
        else:
            result = result + ch
        i = i + 1
    result

fn _js(value: text) -> text:
    _q() + _md_lsp_json_escape(value) + _q()

fn _jp(key: text, value: text) -> text:
    _q() + key + _q() + ":" + value

# ---------------------------------------------------------------------------
# JSON field extraction helpers
# (mirrors _lsp_find_field / _lsp_extract_* from lsp_transport.spl)
# ---------------------------------------------------------------------------

fn _mh_char_at(s: text, i: i64) -> text:
    s.char_at(i)

fn _mh_is_ws(ch: text) -> bool:
    ch == " " or ch == "\n" or ch == "\r" or ch == "\t"

fn _lsp_find_field(json: text, field: text) -> i64:
    var i = 0
    while i < json.byte_len():
        if json.slice(i, json.byte_len()).starts_with(field):
            var j = i + field.len()
            while j < json.byte_len() and (_mh_char_at(json, j) == " " or _mh_char_at(json, j) == ":"):
                j = j + 1
            return j
        i = i + 1
    -1

fn _lsp_extract_number(json: text, start: i64) -> i64:
    var value: i64 = 0
    var i = start
    while i < json.byte_len():
        val digit = json.byte_at(i) - 48
        if digit < 0 or digit > 9:
            break
        if value > 922337203685477580 or (value == 922337203685477580 and digit > 7):
            return -1
        value = value * 10 + digit
        i = i + 1
    if i == start: -1 else: value

fn _lsp_extract_string(json: text, start: i64) -> text:
    if start >= json.byte_len() or json.byte_at(start) != 34:
        return ""
    var i = start + 1
    while i < json.byte_len():
        val byte = json.byte_at(i)
        if byte == 34:
            return json_unescape_string(json.slice(start + 1, i))
        if byte == 92:
            i = i + 1
        i = i + 1
    ""

# Internal text is valid UTF-8; LSP's default position unit is UTF-16.
fn md_lsp_utf16_length(value: text) -> i64:
    var units: i64 = 0
    var i = 0
    while i < value.byte_len():
        val byte = value.byte_at(i)
        if byte < 128:
            i = i + 1
        elif byte < 224:
            i = i + 2
        elif byte < 240:
            i = i + 3
        else:
            i = i + 4
            units = units + 1
        units = units + 1
    units

fn md_lsp_utf16_byte_offset(value: text, character: i64) -> i64:
    var units: i64 = 0
    var i = 0
    while i < value.byte_len() and units < character:
        val byte = value.byte_at(i)
        val width = if byte < 128: 1 elif byte < 224: 2 elif byte < 240: 3 else: 4
        val step_units = if width == 4: 2 else: 1
        if units + step_units > character:
            break
        i = i + width
        units = units + step_units
    i

fn _lsp_extract_balanced(json: text, start: i64, open_ch: text) -> text:
    val close_ch = if open_ch == "{" then "}" else "]"
    var depth = 0
    var i = start
    var in_str = false
    while i < json.len():
        val ch = _mh_char_at(json, i)
        if in_str:
            if ch == "\\":
                i = i + 1
            elif ch == "\"":
                in_str = false
        else:
            if ch == "\"":
                in_str = true
            elif ch == open_ch:
                depth = depth + 1
            elif ch == close_ch:
                depth = depth - 1
                if depth == 0:
                    return json.slice(start, i + 1)
        i = i + 1
    json.slice(start, json.byte_len())

fn _lsp_extract_value(json: text, start: i64) -> text:
    if start >= json.len():
        return ""
    val ch = _mh_char_at(json, start)
    if ch == "{" or ch == "[":
        return _lsp_extract_balanced(json, start, ch)
    if ch == "\"":
        return "\"" + _lsp_extract_string(json, start) + "\""
    var result = ""
    var i = start
    while i < json.len():
        val c = _mh_char_at(json, i)
        if c == "," or c == "}" or c == "]":
            return result.trim()
        result = result + c
        i = i + 1
    result.trim()

fn lsp_uri_to_path(uri: text) -> text:
    if uri.starts_with("file://"):
        return uri.slice(7, uri.byte_len())
    uri

# ---------------------------------------------------------------------------
# Response builders
# ---------------------------------------------------------------------------

fn _md_lsp_ok_response(req_id: text, result_json: text) -> text:
    "{" + _jp("jsonrpc", _js("2.0")) + "," + _jp("id", req_id) + "," + _jp("result", result_json) + "}"

fn _md_lsp_error_response(req_id: text, code: i64, message: text) -> text:
    val err = "{" + _jp("code", str(code)) + "," + _jp("message", _js(message)) + "}"
    "{" + _jp("jsonrpc", _js("2.0")) + "," + _jp("id", req_id) + "," + _jp("error", err) + "}"

# ---------------------------------------------------------------------------
# Params extraction helpers
# ---------------------------------------------------------------------------

fn _md_lsp_extract_uri(params_json: text) -> text:
    # Try textDocument.uri
    val td_start = _lsp_find_field(params_json, "\"textDocument\"")
    if td_start >= 0:
        val td_obj = _lsp_extract_value(params_json, td_start)
        val uri_start = _lsp_find_field(td_obj, "\"uri\"")
        if uri_start >= 0:
            return _lsp_extract_string(td_obj, uri_start)
    # Fallback: direct "uri"
    val uri_start2 = _lsp_find_field(params_json, "\"uri\"")
    if uri_start2 >= 0:
        return _lsp_extract_string(params_json, uri_start2)
    ""

fn _md_lsp_extract_position(params_json: text) -> (i64, i64):
    val pos_start = _lsp_find_field(params_json, "\"position\"")
    if pos_start < 0:
        return (0, 0)
    val pos_obj = _lsp_extract_value(params_json, pos_start)
    val line_start = _lsp_find_field(pos_obj, "\"line\"")
    val char_start = _lsp_find_field(pos_obj, "\"character\"")
    val line_num = if line_start >= 0 then _lsp_extract_number(pos_obj, line_start) else 0
    val char_num = if char_start >= 0 then _lsp_extract_number(pos_obj, char_start) else 0
    (line_num, char_num)

fn _md_lsp_extract_version(params_json: text) -> i64:
    val td_start = _lsp_find_field(params_json, "\"textDocument\"")
    if td_start >= 0:
        val td_obj = _lsp_extract_value(params_json, td_start)
        val v_start = _lsp_find_field(td_obj, "\"version\"")
        if v_start >= 0:
            return _lsp_extract_number(td_obj, v_start)
    val v_start2 = _lsp_find_field(params_json, "\"version\"")
    if v_start2 >= 0:
        return _lsp_extract_number(params_json, v_start2)
    0

fn _md_lsp_extract_content(params_json: text) -> text:
    # didOpen: textDocument.text
    val td_start = _lsp_find_field(params_json, "\"textDocument\"")
    if td_start >= 0:
        val td_obj = _lsp_extract_value(params_json, td_start)
        val text_start = _lsp_find_field(td_obj, "\"text\"")
        if text_start >= 0:
            return _lsp_extract_string(td_obj, text_start)
    # didChange: contentChanges[0].text
    val cc_start = _lsp_find_field(params_json, "\"contentChanges\"")
    if cc_start >= 0:
        val cc_arr = _lsp_extract_value(params_json, cc_start)
        val text_start2 = _lsp_find_field(cc_arr, "\"text\"")
        if text_start2 >= 0:
            return _lsp_extract_string(cc_arr, text_start2)
    ""

# ---------------------------------------------------------------------------
# Line utility
# ---------------------------------------------------------------------------

fn _md_lsp_get_line(content: text, line_num: i64) -> text:
    val lines = split_lines(content)
    if line_num < 0 or line_num >= lines.length():
        return ""
    lines[line_num]

fn _md_lsp_line_is_code(doc: MdDocument, line_num: i64) -> bool:
    for block in doc.ast:
        if block.kind == "code" and line_num >= block.from_line and line_num <= block.to_line:
            return true
    false

# ---------------------------------------------------------------------------
# Capability response
# ---------------------------------------------------------------------------

fn md_lsp_initialize_raw(req_id: text) -> text:
    val trigger_chars = "[" + _js("[") + "," + _js("#") + "," + _js("(") + "]"
    val completion_provider = "{" + _jp("triggerCharacters", trigger_chars) + "}"
    var caps = "{"
    caps = caps + _jp("completionProvider", completion_provider)
    caps = caps + "," + _jp("hoverProvider", "true")
    caps = caps + "," + _jp("definitionProvider", "true")
    caps = caps + "," + _jp("documentSymbolProvider", "true")
    caps = caps + "," + _jp("foldingRangeProvider", "true")
    caps = caps + "," + _jp("codeActionProvider", "true")
    caps = caps + "," + _jp("textDocumentSync", "1")
    caps = caps + "}"
    val result = "{" + _jp("capabilities", caps) + "}"
    _md_lsp_ok_response(req_id, result)

# ---------------------------------------------------------------------------
# Completion
# ---------------------------------------------------------------------------

fn md_lsp_completion_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val pos = _md_lsp_extract_position(params_json)
    val line_num = pos.0
    val char_num = pos.1
    val doc = workspace.get_document(uri)
    val current_line = _md_lsp_get_line(doc.content, line_num)
    val prefix = current_line.slice(0, md_lsp_utf16_byte_offset(current_line, char_num))

    var items = "["
    var first = true

    if prefix.contains("#"):
        # Heading reference completion
        val headings = doc.headings
        var i = 0
        val count = headings.length()
        while i < count:
            val heading = headings[i]
            val heading_text = heading.1
            val slug = markdown_slugify(heading_text)
            val label = "#" + slug
            val item = "{" + _jp("label", _js(label)) + "," + _jp("kind", "15") + "," + _jp("detail", _js(heading_text)) + "}"
            if not first:
                items = items + ","
            items = items + item
            first = false
            i = i + 1
    elif prefix.contains("[["):
        # Wikilink completion — list open document URIs
        val all_uris = workspace.all_uris()
        var i = 0
        val count = all_uris.length()
        while i < count:
            val doc_uri = all_uris[i]
            val label = lsp_uri_to_path(doc_uri)
            val item = "{" + _jp("label", _js(label)) + "," + _jp("kind", "17") + "}"
            if not first:
                items = items + ","
            items = items + item
            first = false
            i = i + 1
    elif prefix.contains("]("):
        # Link anchor completion — heading slugs
        val headings = doc.headings
        var i = 0
        val count = headings.length()
        while i < count:
            val heading = headings[i]
            val heading_text = heading.1
            val anchor = "#" + markdown_slugify(heading_text)
            val item = "{" + _jp("label", _js(anchor)) + "," + _jp("kind", "15") + "," + _jp("detail", _js(heading_text)) + "}"
            if not first:
                items = items + ","
            items = items + item
            first = false
            i = i + 1

    items = items + "]"
    val result = "{" + _jp("items", items) + "}"
    _md_lsp_ok_response(req_id, result)

# ---------------------------------------------------------------------------
# Hover
# ---------------------------------------------------------------------------

fn md_lsp_hover_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val pos = _md_lsp_extract_position(params_json)
    val line_num = pos.0
    val doc = workspace.get_document(uri)
    if _md_lsp_line_is_code(doc, line_num):
        return _md_lsp_ok_response(req_id, "null")
    val line = _md_lsp_get_line(doc.content, line_num)

    var hover_text = ""

    if line.starts_with("#"):
        # Heading line: report level
        var level = 0
        var i = 0
        while i < line.len() and line.char_at(i) == "#":
            level = level + 1
            i = i + 1
        hover_text = "Heading level " + str(level)
    elif line.contains("]("):
        # Link: extract URL from [text](url)
        val paren_idx = line.index_of("](") ?? -1
        if paren_idx >= 0:
            var url_start = paren_idx + 2
            var url_end = url_start
            while url_end < line.len() and line.char_at(url_end) != ")":
                url_end = url_end + 1
            hover_text = line.substring(url_start, url_end)

    if hover_text == "":
        return _md_lsp_ok_response(req_id, "null")

    val contents = "{" + _jp("kind", _js("plaintext")) + "," + _jp("value", _js(hover_text)) + "}"
    val result = "{" + _jp("contents", contents) + "}"
    _md_lsp_ok_response(req_id, result)

# ---------------------------------------------------------------------------
# Definition
# ---------------------------------------------------------------------------

fn md_lsp_definition_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val pos = _md_lsp_extract_position(params_json)
    val line_num = pos.0
    val doc = workspace.get_document(uri)
    if _md_lsp_line_is_code(doc, line_num):
        return _md_lsp_ok_response(req_id, "null")
    val line = _md_lsp_get_line(doc.content, line_num)

    # Only handle [text](#anchor) links
    if not line.contains("](#"):
        return _md_lsp_ok_response(req_id, "null")

    val hash_pos = line.index_of("](#") ?? -1
    if hash_pos < 0:
        return _md_lsp_ok_response(req_id, "null")

    var anchor_start = hash_pos + 3
    var anchor_end = anchor_start
    while anchor_end < line.len() and line.char_at(anchor_end) != ")":
        anchor_end = anchor_end + 1
    val anchor = line.substring(anchor_start, anchor_end)

    # Find the line number of the heading whose slug matches
    val heading_blocks = doc.ast
    var found_line: i64 = -1
    var j = 0
    val line_count = heading_blocks.length()
    while j < line_count:
        val block = heading_blocks[j]
        val l = block.content
        if block.kind == "heading":
            var k = 0
            while k < l.len() and l.char_at(k) == "#":
                k = k + 1
            while k < l.len() and l.char_at(k) == " ":
                k = k + 1
            val heading_text = l.substring(k, l.byte_len())
            if markdown_slugify(heading_text) == anchor:
                found_line = block.from_line
                j = line_count
        j = j + 1

    if found_line < 0:
        return _md_lsp_ok_response(req_id, "null")

    val start_pos = "{" + _jp("line", str(found_line)) + "," + _jp("character", "0") + "}"
    val end_pos = "{" + _jp("line", str(found_line)) + "," + _jp("character", "0") + "}"
    val range = "{" + _jp("start", start_pos) + "," + _jp("end", end_pos) + "}"
    val location = "{" + _jp("uri", _js(uri)) + "," + _jp("range", range) + "}"
    _md_lsp_ok_response(req_id, location)

# ---------------------------------------------------------------------------
# Document Symbol
# ---------------------------------------------------------------------------

fn md_lsp_document_symbol_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val doc = workspace.get_document(uri)
    val heading_blocks = doc.ast

    var symbols = "["
    var first = true
    var j = 0
    val line_count = heading_blocks.length()
    while j < line_count:
        val block = heading_blocks[j]
        val l = block.content
        if block.kind == "heading":
            var k = 0
            while k < l.len() and l.char_at(k) == "#":
                k = k + 1
            while k < l.len() and l.char_at(k) == " ":
                k = k + 1
            val heading_text = l.substring(k, l.byte_len())
            val start_pos = "{" + _jp("line", str(block.from_line)) + "," + _jp("character", "0") + "}"
            val end_pos = "{" + _jp("line", str(block.from_line)) + "," + _jp("character", str(md_lsp_utf16_length(l))) + "}"
            val range = "{" + _jp("start", start_pos) + "," + _jp("end", end_pos) + "}"
            val location = "{" + _jp("uri", _js(uri)) + "," + _jp("range", range) + "}"
            # LSP SymbolKind 25 = "key" — used for headings/sections per spec
            val symbol = "{" + _jp("name", _js(heading_text)) + "," + _jp("kind", "25") + "," + _jp("location", location) + "}"
            if not first:
                symbols = symbols + ","
            symbols = symbols + symbol
            first = false
        j = j + 1

    symbols = symbols + "]"
    _md_lsp_ok_response(req_id, symbols)

# ---------------------------------------------------------------------------
# Folding Range
# ---------------------------------------------------------------------------

fn md_lsp_folding_range_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val doc = workspace.get_document(uri)
    val lines = split_lines(doc.content)
    val ranged_ast = parse_blocks_with_ranges(lines)
    val fold_ranges = compute_folding_ranges(ranged_ast)

    var items = "["
    var first = true
    var i = 0
    val count = fold_ranges.length()
    while i < count:
        val fr = fold_ranges[i]
        var item = "{" + _jp("startLine", str(fr.from_line)) + "," + _jp("endLine", str(fr.to_line))
        if fr.kind != "":
            item = item + "," + _jp("kind", _js(fr.kind))
        item = item + "}"
        if not first:
            items = items + ","
        items = items + item
        first = false
        i = i + 1
    items = items + "]"
    _md_lsp_ok_response(req_id, items)

# ---------------------------------------------------------------------------
# Code Actions
# ---------------------------------------------------------------------------

fn md_lsp_code_action_raw(params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    val uri = _md_lsp_extract_uri(params_json)
    val pos = _md_lsp_extract_position_from_range(params_json)
    val line_num = pos.0
    val doc = workspace.get_document(uri)
    if _md_lsp_line_is_code(doc, line_num):
        return _md_lsp_ok_response(req_id, "[]")
    val batch = md_diagnose_batch(doc.content, doc.path, doc.version, workspace.link_context(uri))
    val table = LineStartTable.build(doc.content)
    # Candidates are keyed by stable diagnostic id (MD1103 trailing space /
    # list marker, MD1105 heading space, MD1106 empty link).
    var index = DiagnosticActionIndex.new()
    var ids: [text] = []
    for bd in batch.diagnostics:
        val d = bd.diagnostic
        if d.fix.? and d.span.? and d.span.unwrap().line - 1 == line_num:
            val fix = d.fix.unwrap()
            var c = FixCandidate.new(fix.id, fix.description, d.message, fix.confidence, doc.version)
            for r in fix.replacements:
                c = c.with_replacement(r.file, r.span, r.new_text, _md_lsp_byte_slice(doc.content, r.span.start, r.span.end))
            index = index.add(bd.id, c)
            if not ids.contains(bd.id):
                ids.push(bd.id)
    # Only advertise candidates the shared transaction would actually apply.
    val tx = EditTransaction.new(".", batch.source_hash).with_document(DocumentSnapshot.new(_md_lsp_tx_file(doc.path), doc.version, batch.source_hash, doc.content))
    var actions: [text] = []
    for id in ids:
        for c in ranked_candidates_for(index, id):
            if tx.apply(_md_lsp_tx_candidate(c, doc.path)).applied():
                actions.push(_md_lsp_build_candidate_action(uri, doc.content, table, c))
    _md_lsp_ok_response(req_id, "[" + actions.join(",") + "]")

# EditTransaction confines edits to its root; the document's workspace-relative
# path is presented under "./" for that check only.
fn _md_lsp_tx_file(path: text) -> text:
    "./" + path

fn _md_lsp_tx_candidate(c: FixCandidate, path: text) -> FixCandidate:
    var out = FixCandidate.new(c.id, c.title, c.explanation, c.confidence, c.required_document_version)
    var i = 0
    while i < c.replacements.len():
        val r = c.replacements[i]
        val f = if r.file == path then _md_lsp_tx_file(path) else: r.file
        out = out.with_replacement(f, r.span, r.new_text, c.preconditions[i].expected_text)
        i = i + 1
    out

fn _md_lsp_build_candidate_action(uri: text, content: text, table: LineStartTable, c: FixCandidate) -> text:
    var edits: [text] = []
    for r in c.replacements:
        val mapped = span_to_range(content, table, r.span.start, r.span.end)
        if mapped.?:
            val m = mapped.unwrap()
            val start_pos = "{" + _jp("line", str(m.start.line)) + "," + _jp("character", str(m.start.character)) + "}"
            val end_pos = "{" + _jp("line", str(m.end.line)) + "," + _jp("character", str(m.end.character)) + "}"
            edits.push("{" + _jp("range", "{" + _jp("start", start_pos) + "," + _jp("end", end_pos) + "}") + "," + _jp("newText", _js(r.new_text)) + "}")
    val changes = "{" + _jp(uri, "[" + edits.join(",") + "]") + "}"
    val preferred = if c.confidence.name() == "safe" then "true" else: "false"
    "{" + _jp("title", _js(c.title)) + "," + _jp("kind", _js("quickfix")) + "," + _jp("isPreferred", preferred) + "," + _jp("edit", "{" + _jp("changes", changes) + "}") + "}"

fn _md_lsp_extract_position_from_range(params_json: text) -> (i64, i64):
    val range_start = _lsp_find_field(params_json, "\"range\"")
    if range_start < 0:
        return _md_lsp_extract_position(params_json)
    val range_obj = _lsp_extract_value(params_json, range_start)
    val start_start = _lsp_find_field(range_obj, "\"start\"")
    if start_start < 0:
        return (0, 0)
    val start_obj = _lsp_extract_value(range_obj, start_start)
    val line_start = _lsp_find_field(start_obj, "\"line\"")
    val char_start = _lsp_find_field(start_obj, "\"character\"")
    val line_num = if line_start >= 0 then _lsp_extract_number(start_obj, line_start) else 0
    val char_num = if char_start >= 0 then _lsp_extract_number(start_obj, char_start) else 0
    (line_num, char_num)

# ---------------------------------------------------------------------------
# Notification handler (no response)
# ---------------------------------------------------------------------------

fn _md_lsp_severity_code(d: DiagnosticV1) -> text:
    val name = d.severity.name()
    if name == "error":
        return "1"
    if name == "warning":
        return "2"
    if name == "help":
        return "4"
    "3"

# Renders one shared DiagnosticV1 as an LSP Diagnostic. Byte span -> UTF-16
# range through the snapshot's LineStartTable; a span that cannot be mapped
# (should not happen for producer-made spans) collapses to the line start.
fn _md_lsp_diagnostic_json(content: text, table: LineStartTable, d: DiagnosticV1, id: text) -> text:
    var range_json = "{" + _jp("start", "{" + _jp("line", "0") + "," + _jp("character", "0") + "}") + "," + _jp("end", "{" + _jp("line", "0") + "," + _jp("character", "0") + "}") + "}"
    if d.span.is_some():
        val sp = d.span.unwrap()
        val mapped = span_to_range(content, table, sp.start, sp.end)
        if mapped.is_some():
            val r = mapped.unwrap()
            val start_pos = "{" + _jp("line", str(r.start.line)) + "," + _jp("character", str(r.start.character)) + "}"
            val end_pos = "{" + _jp("line", str(r.end.line)) + "," + _jp("character", str(r.end.character)) + "}"
            range_json = "{" + _jp("start", start_pos) + "," + _jp("end", end_pos) + "}"
    "{" + _jp("range", range_json) + "," + _jp("severity", _md_lsp_severity_code(d)) + "," + _jp("code", _js(d.code)) + "," + _jp("source", _js("markdown")) + "," + _jp("message", _js(d.message)) + "," + _jp("data", "{" + _jp("id", _js(id)) + "}") + "}"

fn _md_lsp_publish_notification(uri: text, version: i64, status: text, diagnostics_json: text) -> text:
    val params = "{" + _jp("uri", _js(uri)) + "," + _jp("version", str(version)) + "," + _jp("diagnostics", diagnostics_json) + "," + _jp("status", _js(status)) + "}"
    "{" + _jp("jsonrpc", _js("2.0")) + "," + _jp("method", _js("textDocument/publishDiagnostics")) + "," + _jp("params", params) + "}"

# Diagnoses the open document at `uri` against the workspace graph and renders
# the publishDiagnostics notification for it.
pub fn md_lsp_publish_json(uri: text, workspace: MdWorkspace) -> text:
    val doc = workspace.get_document(uri)
    val batch = md_diagnose_batch(doc.content, doc.path, doc.version, workspace.link_context(uri))
    val table = LineStartTable.build(doc.content)
    var items: [text] = []
    for bd in batch.diagnostics:
        items.push(_md_lsp_diagnostic_json(doc.content, table, bd.diagnostic, bd.id))
    _md_lsp_publish_notification(uri, doc.version, batch.status.name(), "[" + items.join(",") + "]")

fn _md_lsp_publish_set(primary: text, dependents: [text], workspace: MdWorkspace) -> [MdLspPublish]:
    var out: [MdLspPublish] = []
    if workspace.has_document(primary):
        out.push(MdLspPublish(uri: primary, json: md_lsp_publish_json(primary, workspace)))
    var seen: [text] = [primary]
    for dep in dependents:
        if not seen.contains(dep) and workspace.has_document(dep):
            seen.push(dep)
            out.push(MdLspPublish(uri: dep, json: md_lsp_publish_json(dep, workspace)))
    out

fn _md_lsp_union(a: [text], b: [text]) -> [text]:
    var out = a
    for t in b:
        if not out.contains(t):
            out.push(t)
    out

# Applies a notification to the workspace and returns the publishDiagnostics
# notifications it implies: the edited document plus exactly the open
# documents whose inbound edges changed (targets before and after the edit).
pub fn md_lsp_handle_notification_publishing(method: text, params_json: text, workspace: MdWorkspace) -> [MdLspPublish]:
    if method == "textDocument/didOpen" or method == "textDocument/didChange":
        val uri = _md_lsp_extract_uri(params_json)
        val content = _md_lsp_extract_content(params_json)
        val version = _md_lsp_extract_version(params_json)
        val before = workspace.get_document(uri).targets
        workspace.open_document(uri, content, version)
        val after = workspace.get_document(uri).targets
        return _md_lsp_publish_set(uri, workspace.dependents(_md_lsp_union(before, after), uri), workspace)
    if method == "textDocument/didClose":
        val uri = _md_lsp_extract_uri(params_json)
        val doc = workspace.get_document(uri)
        workspace.close_document(uri)
        var out: [MdLspPublish] = [MdLspPublish(uri: uri, json: _md_lsp_publish_notification(uri, doc.version, "complete", "[]"))]
        for p in _md_lsp_publish_set("", workspace.dependents(doc.targets, uri), workspace):
            out.push(p)
        return out
    # "initialized", "exit" and all other notifications: nothing to publish
    []

fn md_lsp_handle_notification(method: text, params_json: text, workspace: MdWorkspace):
    md_lsp_handle_notification_publishing(method, params_json, workspace)

# ---------------------------------------------------------------------------
# Main request dispatcher
# ---------------------------------------------------------------------------

fn md_lsp_handle_request_raw(method: text, params_json: text, req_id: text, workspace: MdWorkspace) -> text:
    if method == "initialize":
        val root_start = _lsp_find_field(params_json, "\"rootUri\"")
        if root_start >= 0:
            workspace.set_root(lsp_uri_to_path(_lsp_extract_string(params_json, root_start)))
        return md_lsp_initialize_raw(req_id)
    if method == "textDocument/completion":
        return md_lsp_completion_raw(params_json, req_id, workspace)
    if method == "textDocument/hover":
        return md_lsp_hover_raw(params_json, req_id, workspace)
    if method == "textDocument/definition":
        return md_lsp_definition_raw(params_json, req_id, workspace)
    if method == "textDocument/documentSymbol":
        return md_lsp_document_symbol_raw(params_json, req_id, workspace)
    if method == "textDocument/foldingRange":
        return md_lsp_folding_range_raw(params_json, req_id, workspace)
    if method == "textDocument/codeAction":
        return md_lsp_code_action_raw(params_json, req_id, workspace)
    if method == "shutdown":
        return _md_lsp_ok_response(req_id, "null")
    _md_lsp_error_response(req_id, -32601, "Method not found: " + method)

# Integer adapters preserve existing in-process callers; wire IDs stay lexical.
fn md_lsp_initialize(req_id: i64) -> text:
    md_lsp_initialize_raw(str(req_id))

fn md_lsp_completion(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_completion_raw(params_json, str(req_id), workspace)

fn md_lsp_hover(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_hover_raw(params_json, str(req_id), workspace)

fn md_lsp_definition(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_definition_raw(params_json, str(req_id), workspace)

fn md_lsp_document_symbol(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_document_symbol_raw(params_json, str(req_id), workspace)

fn md_lsp_folding_range(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_folding_range_raw(params_json, str(req_id), workspace)

fn md_lsp_code_action(params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_code_action_raw(params_json, str(req_id), workspace)

fn md_lsp_handle_request(method: text, params_json: text, req_id: i64, workspace: MdWorkspace) -> text:
    md_lsp_handle_request_raw(method, params_json, str(req_id), workspace)

# Spans are BYTE offsets; text.substring indexes code points, so slice bytes
# (matches EditTransaction's byte-sliced precondition check).
fn _md_lsp_byte_slice(s: text, start: i64, end: i64) -> text:
    val bytes = string_to_byte_array(s)
    var out: [u8] = []
    var i = start
    while i < end:
        out.push(bytes[i])
        i = i + 1
    string_from_byte_array(out)
