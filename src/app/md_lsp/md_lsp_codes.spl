# Markdown LSP diagnostic codes (MD1001..MD1104).
#
# Registers the Markdown namespace in the shared compiler ErrorRegistry so
# `simple explain MD1001` and the LSP `codeDescription` share one source.
# Registration refuses (returns -1) when any MD code is already present, so
# a reassigned or doubly-registered code is a visible failure, not a silent
# overwrite.

use compiler.common.error_explanations.{ErrorRegistry, ErrorExplanation}

pub struct MdLspCode:
    code: text
    title: text
    description: text
    fix: text

pub fn md_lsp_codes() -> [MdLspCode]:
    [
        MdLspCode(code: "MD1001", title: "Broken Local Link", description: "A [text](path) link points at a file that does not exist in the workspace.", fix: "Fix the path or create the target file."),
        MdLspCode(code: "MD1002", title: "Unknown Anchor", description: "A #anchor link does not match any heading slug in the document.", fix: "Use the slug of an existing heading."),
        MdLspCode(code: "MD1003", title: "Unresolved Wiki Link", description: "A [[target]] link or ![[target]] embed names a note that is not in the vault index.", fix: "Create the note or correct the target."),
        MdLspCode(code: "MD1004", title: "Duplicate Heading", description: "Two headings at the same level share the same text, so their anchors collide.", fix: "Rename one heading."),
        MdLspCode(code: "MD1005", title: "Unclosed Code Fence", description: "A ``` fence is opened and never closed; everything after it is treated as code.", fix: "Add the closing fence."),
        MdLspCode(code: "MD1006", title: "Invalid Frontmatter Property", description: "A frontmatter property is duplicated, empty, or outside its allowed values.", fix: "Remove the duplicate or supply a valid value."),
        MdLspCode(code: "MD1101", title: "Missing Image Alt Text", description: "An image has an empty alt text.", fix: "Describe the image inside the brackets."),
        MdLspCode(code: "MD1102", title: "Orphan Document", description: "No other document in the completed workspace graph links to this document.", fix: "Link to it from an index or related note."),
        MdLspCode(code: "MD1103", title: "Inconsistent Structure", description: "A heading level is skipped, list markers are mixed, or a line ends with a single trailing space.", fix: "Apply the offered one-token fix; two-space hard breaks are left alone."),
        MdLspCode(code: "MD1104", title: "Unsafe Link Path", description: "A link target is absolute or climbs above the workspace root.", fix: "Use a path inside the workspace.")
    ]

# Outcome of one registration attempt. `collision` true means an MD code was
# already present and NOTHING was registered (`registered` is then 0).
pub struct MdLspRegistration:
    registered: i64
    collision: bool

# Registers every MD code, or refuses atomically on a collision.
pub fn md_lsp_register_codes(reg: ErrorRegistry) -> MdLspRegistration:
    val codes = md_lsp_codes()
    for c in codes:
        if reg.get(c.code).is_some():
            return MdLspRegistration(registered: 0, collision: true)
    for c in codes:
        var exp = ErrorExplanation.create(c.code, c.title)
        exp.description = c.description
        exp.fixes = [c.fix]
        reg.register(exp)
    MdLspRegistration(registered: codes.len(), collision: false)
