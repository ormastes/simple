# Markdown LSP Server — stdio entry point
#
# Reads Content-Length framed JSON-RPC messages from stdin,
# dispatches to md_lsp_handler, and writes framed responses to stdout.
#
# Protocol:
#   Content-Length: N\r\n
#   \r\n
#   <N bytes of JSON body>

extern fn rt_stdin_read_line_text() -> text
extern fn rt_stdin_read_chars_text(n: i64) -> text
extern fn rt_stdout_write_text(s: text)
extern fn rt_stdout_flush()
extern fn rt_eprintln(s: text)

use app.md_lsp.md_lsp_workspace
use app.md_lsp.md_lsp_handler
use app.md_lsp.md_lsp_transport.{md_lsp_frame_header, md_lsp_frame}
use app.protocol.mcp_request_envelope.{mcp_parse_request_envelope_v1}

fn _md_lsp_log(message: text):
    rt_eprintln("[md-lsp] " + message)

fn _md_lsp_emit(json: text):
    rt_stdout_write_text(md_lsp_frame(json))
    rt_stdout_flush()

# ---------------------------------------------------------------------------
# Main server loop (stdio only; framing lives in md_lsp_transport)
# ---------------------------------------------------------------------------

fn md_lsp_server_main():
    var workspace = MdWorkspace.new()
    var running = true

    _md_lsp_log("md-lsp server starting")

    for _iter in range(0, 999999):
        if not running:
            return

        # Consume the entire header block before reading exactly the body.
        var header_lines: [text] = []
        var ended_headers = false
        for _hiter in range(0, 100):
            val header_line = rt_stdin_read_line_text()
            if header_line == "":
                return
            if header_line.trim() == "":
                ended_headers = true
                break
            header_lines.push(header_line)
        val header = md_lsp_frame_header(header_lines)
        if not ended_headers or not header.valid:
            _md_lsp_log("invalid message headers")
            return

        # Read exactly content_length bytes of JSON body
        val json = rt_stdin_read_chars_text(header.content_length)
        if json == "":
            continue

        # The root envelope owns correlation; do not coerce string or large IDs.
        val envelope = mcp_parse_request_envelope_v1(json)
        if not envelope.valid:
            val reason = if envelope.error_code == -32700: "Parse error" else: "Invalid Request"
            _md_lsp_emit(_md_lsp_error_response(envelope.request_id_raw, envelope.error_code, reason))
            continue
        val method = envelope.method
        val params_json = envelope.params_raw

        if method == "exit":
            running = false
        elif envelope.has_id:
            val response = md_lsp_handle_request_raw(method, params_json, envelope.request_id_raw, workspace)
            if response != "":
                _md_lsp_emit(response)
        else:
            for publish in md_lsp_handle_notification_publishing(method, params_json, workspace):
                _md_lsp_emit(publish.json)

    _md_lsp_log("md-lsp server stopped")

# Entry point
md_lsp_server_main()
