use app.scv.db.local_store.{db_store_read, db_store_commit}
use app.scv.db.settlement_queue_codec.*
use std.scv.db_admission.{DbAdmissionPolicy, db_authorize_patch, db_require_unreserved_entity_kinds}
use std.scv.db_patch.{DbPatch}
use std.scv.db_patch_codec.{db_patch_encode}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.time_ops.{time_sample_unix_micros_or_failure}

fn db_settlement_queue_open(root: text, admission: DbAdmissionPolicy) -> Result<DbSettlementQueueView, text>:
    val stored = db_store_read(root, "settlement-work")
    val context = db_settlement_queue_context(admission)?
    if stored.code == "empty": return Ok(DbSettlementQueueView(head: "", queue: DbSettlementQueue(context_digest: context, items: [])))
    if stored.code != "ok": return Err(stored.code)
    val queue = db_settlement_queue_decode(stored.state)?
    if queue.context_digest != context or stored.transaction_id != sha256_text(stored.state): return Err("SCVDB_QUEUE_CONTEXT")
    Ok(DbSettlementQueueView(head: stored.head, queue: queue))

# Internal effect-owner primitive: not a producer authorization entrypoint.
# Checkpoint installation must gate this channel in the shared local_store SJ
# boundary; a separate preflight read cannot provide that atomic interlock.
fn db_settlement_queue_commit(root: text, expected_head: text, queue: DbSettlementQueue) -> Result<DbSettlementQueueView, text>:
    val encoded = db_settlement_queue_encode(queue)?
    val stored = db_store_read(root, "settlement-work")
    if stored.code != "empty" and stored.code != "ok": return Err(stored.code)
    if stored.head != expected_head: return Err("SCVDB_STORE_HEAD_ADVANCED")
    val parent = if stored.code == "ok" and stored.state == encoded: stored.parent else: expected_head
    val committed = db_store_commit(root, parent, sha256_text(encoded), encoded, "settlement-work")
    if committed.code != "ok": return Err(committed.code)
    Ok(DbSettlementQueueView(head: committed.head, queue: queue))

fn db_settlement_enqueue(root: text, expected_head: text, patch: DbPatch, admission: DbAdmissionPolicy) -> Result<DbSettlementQueueView, text>:
    val wire = db_patch_encode(patch)?
    if wire.len() > 1048576: return Err("SCVDB_QUEUE_PATCH_QUOTA")
    db_require_unreserved_entity_kinds(patch)?
    if patch.provenance.starts_with("SCVDB-CONFLICT-RESOLUTION-v1:"): return Err("SCVDB_RESOLUTION_OWNER_REQUIRED")
    val sample = time_sample_unix_micros_or_failure()
    if sample < 0: return Err("SCVDB_COMMAND_CLOCK")
    # Authentication only at ingress; signed dependency names are NOT evidence
    # of existence. Canonical dependency membership is checked during planning.
    val authenticated = db_authorize_patch(patch, admission, patch.causal_dependencies, (sample / 1000000) as u64)?
    var view = db_settlement_queue_open(root, admission)?
    if view.head != expected_head: return Err("SCVDB_STORE_HEAD_ADVANCED")
    for item in view.queue.items:
        if item.patch.batch_id == patch.batch_id:
            if db_patch_encode(item.patch)? != wire: return Err("SCVDB_BATCH_IDENTITY_COLLISION")
            return db_settlement_queue_commit(root, view.head, view.queue)
    if view.queue.items.len() >= 64: return Err("SCVDB_QUEUE_BACKPRESSURE")
    view.queue.items.push(DbSettlementWorkItem(patch: patch, phase: "queued", attempts: 0, journal: nil, paged_journal: nil, candidate_commit: "", observed_index_head: "", last_error: "", preparation_structure: ""))
    db_settlement_queue_commit(root, view.head, view.queue)

export db_settlement_queue_open, db_settlement_enqueue, db_settlement_queue_commit
