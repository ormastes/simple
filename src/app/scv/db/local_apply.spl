# Producer-facing semantic publication. Provider bindings/common-state rows may
# only be written by their effect owner after durable ACK and scoped readback.
# Provenance strings, valid signatures and metadata review do not bypass this.
use app.scv.db.local_transition.{DbLocalImage, DbLocalView, DbApplyResult, db_read_local, db_read_local_image, db_read_local_view, db_apply_local_transition, db_resolve_local_transition}
use std.scv.db_admission.{DbAdmissionPolicy, db_require_unreserved_entity_kinds}
use std.scv.db_reducer.{MergePolicy}
use std.scv.db_patch.{DbPatch}
use std.scv.db_conflict_resolution.{DbConflictDecision}

fn db_apply_local(root: text, expected_head: text, patch: DbPatch, merge: MergePolicy, admission: DbAdmissionPolicy, now: u64) -> Result<DbApplyResult, text>:
    db_require_unreserved_entity_kinds(patch)?
    db_apply_local_transition(root, expected_head, patch, merge, admission, now)

fn db_resolve_local(root: text, expected_head: text, decision: DbConflictDecision, patch: DbPatch, merge: MergePolicy, admission: DbAdmissionPolicy, now: u64) -> Result<DbApplyResult, text>:
    db_require_unreserved_entity_kinds(patch)?
    db_resolve_local_transition(root, expected_head, decision, patch, merge, admission, now)

export DbLocalImage, DbLocalView, DbApplyResult
export db_apply_local, db_resolve_local, db_read_local, db_read_local_image, db_read_local_view
