# Generic producer facade. Internal transition infrastructure is not exported.
use app.scv.db.paged_transition.{DbPagedView, DbPagedApplyResult, db_paged_initialize, db_paged_open, db_paged_lookup, db_paged_current_row, db_paged_apply_transition}
use std.scv.db_admission.{db_require_unreserved_entity_kinds}
use std.scv.db_patch.{DbPatch}
use std.scv.db_paged_model.{DbPagedPolicy}

fn db_paged_apply(root: text, expected_head: text, patch: DbPatch, policy: DbPagedPolicy) -> Result<DbPagedApplyResult, text>:
    db_require_unreserved_entity_kinds(patch)?
    db_paged_apply_transition(root, expected_head, patch, policy)

export DbPagedView, DbPagedApplyResult, db_paged_initialize, db_paged_open, db_paged_apply
export db_paged_lookup, db_paged_current_row
