# Actual SCVE1 reads, bounded by a single 1MiB content chunk. Metadata includes
# at most max_dependencies (65536) digests. No byte array contains the bundle.
# This verifies ciphertext identity but never grants decrypt/key authorization.
use app.io.retained_file_ops.*
use app.io.mod.{directory_fsync, dir_remove_all}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_publish_noreplace}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.nogc_sync_mut.io.path_identity.{path_final_existing, path_identity_same, path_identity_contains}
use app.scv.db.evidence_store.{DbEvidenceStoreQuota, db_evidence_external_scope}
use std.scv.db_evidence_stream.{db_evidence_stream_start, db_evidence_stream_finish}

struct DbEvidenceFileInfo:
    digest: text
    content_bytes: u64
    dependencies: [text]
    restricted: bool

struct DbHydratedEvidence:
    digest: text
    content_bytes: u64
    private_directory: text
    content_path: text

fn _hydrate_digest(value: text) -> bool:
    if value.len() != 64: return false
    for byte in value.bytes():
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)): return false
    true

fn _hydrate_quota(quota: DbEvidenceStoreQuota) -> Result<bool, text>:
    if quota.max_content_bytes < 0 or quota.max_content_bytes > 1073741824 or quota.max_envelope_bytes < 21 or quota.max_envelope_bytes > 2147483647 or quota.max_dependencies < 0 or quota.max_dependencies > 65536:
        return Err("SCVDB_EVIDENCE_QUOTA")
    Ok(true)

fn _hydrate_u64(bytes: [u8], offset: i64) -> u64:
    var value = 0u64
    for index in 0..8: value = (value << 8) | (bytes[offset + index] as u64)
    value

class _DbEvidenceHydrationReader:
    var input: RetainedFile
    var output: RetainedFile?

    me exact(count: i64) -> Result<[u8], text>:
        val result = self.input.read_exact(count)
        if result.is_err() and result.unwrap_err() == "SCVDB_FILE_TRUNCATED":
            return Err("SCVDB_EVIDENCE_TRUNCATED")
        result

    me read(digest: text, quota: DbEvidenceStoreQuota) -> Result<DbEvidenceFileInfo, text>:
        val header = self.exact(21)?
        if header[0:5] != [83u8,67u8,86u8,69u8,1u8]: return Err("SCVDB_EVIDENCE_FORMAT")
        val count = _hydrate_u64(header, 5)
        val size = _hydrate_u64(header, 13)
        if count > (quota.max_dependencies as u64) or size > (quota.max_content_bytes as u64): return Err("SCVDB_EVIDENCE_QUOTA")
        val envelope_size = 21u64 + count * 64u64 + size
        if envelope_size != self.input.size or envelope_size > (quota.max_envelope_bytes as u64): return Err("SCVDB_EVIDENCE_FORMAT")
        var dependencies: [text] = []
        val hex = "0123456789abcdef"
        for index in 0..(count as i64):
            val bytes = self.exact(64)?
            var dependency = ""
            for byte in bytes:
                var digit = -1
                if byte >= 48u8 and byte <= 57u8: digit = (byte - 48u8) as i64
                elif byte >= 97u8 and byte <= 102u8: digit = (byte - 97u8 + 10u8) as i64
                if digit < 0: return Err("SCVDB_EVIDENCE_DEPENDENCY")
                dependency = dependency + hex[digit:digit + 1]
            if dependencies.len() > 0 and dependency <= dependencies[dependencies.len() - 1]: return Err("SCVDB_EVIDENCE_DEPENDENCY")
            dependencies.push(dependency)
        var stream = db_evidence_stream_start(size)?
        var remaining = size
        var restricted = false
        var first = true
        while remaining > 0:
            val count = if remaining > 1048576u64: 1048576 else: remaining as i64
            val bytes = self.exact(count)?
            if first:
                restricted = bytes.len() >= 5 and bytes[0:5] == [83u8,67u8,82u8,69u8,1u8]
                first = false
            if not stream.update(bytes): return Err("SCVDB_EVIDENCE_HASH")
            if self.output != nil:
                if not restricted:
                    var target = self.output.unwrap()
                    val written = target.write(bytes)
                    self.output = Some(target)
                    written?
            remaining = remaining - (count as u64)
        if self.input.read(1)?.len() != 0: return Err("SCVDB_EVIDENCE_TRAILING")
        retained_file_unchanged(self.input)?
        if db_evidence_stream_finish(stream, dependencies)? != digest: return Err("SCVDB_EVIDENCE_DIGEST")
        if self.output != nil and restricted: return Err("SCVDB_EVIDENCE_RESTRICTED")
        Ok(DbEvidenceFileInfo(digest: digest, content_bytes: size, dependencies: dependencies, restricted: restricted))


# Entry point verifies actual final handle bytes. No manifest-only Exact result.
fn db_evidence_inspect_file(checkout: text, parent: text, digest: text, quota: DbEvidenceStoreQuota) -> Result<DbEvidenceFileInfo, text>:
    _hydrate_quota(quota)?
    if not _hydrate_digest(digest): return Err("SCVDB_EVIDENCE_DIGEST")
    val root = db_evidence_external_scope(checkout, parent, "scv-evidence-v1")?
    db_evidence_inspect_at(root, digest, quota)

# Internal actual-content reader for a captured CAS directory. No authorization
# claim; reusable by closure after one repository/scope check, not per object.
fn db_evidence_inspect_at(root: text, digest: text, quota: DbEvidenceStoreQuota) -> Result<DbEvidenceFileInfo, text>:
    _hydrate_quota(quota)?
    if not _hydrate_digest(digest): return Err("SCVDB_EVIDENCE_DIGEST")
    if not dir_is_real_no_follow(root) or path_final_existing(root)?.path != root: return Err("SCVDB_STORE_SCOPE")
    val input = retained_file_open("{root}/{digest}.scve", quota.max_envelope_bytes as u64)?
    var reader = _DbEvidenceHydrationReader(input: input, output: nil)
    val result = reader.read(digest, quota)
    if not reader.input.close(): return Err("SCVDB_EVIDENCE_CLOSE")
    result

fn _hydrate_copy(source: text, digest: text, stage: text, quota: DbEvidenceStoreQuota) -> Result<DbHydratedEvidence, text>:
    var input = retained_file_open(source, quota.max_envelope_bytes as u64)?
    val output_result = retained_file_open("{stage}/unverified", quota.max_content_bytes as u64, true)
    val opened_output = match output_result:
        Ok(file): file
        Err(error):
            val closed = input.close()
            return Err(error)
    var reader = _DbEvidenceHydrationReader(input: input, output: Some(opened_output))
    val result = reader.read(digest, quota)
    val input_closed = reader.input.close()
    # Transfer the output owner out before closing it; never close an unwrap copy
    # while retaining an apparently live owner in the hydration reader.
    var output = reader.output.unwrap()
    reader.output = nil
    # Close both on every outcome; only a verified digest permits sync/publish.
    var synced = false
    match result:
        Ok(info): synced = retained_file_sync(output)
        Err(_): synced = false
    val output_closed = output.close()
    if not input_closed or not output_closed: return Err("SCVDB_EVIDENCE_CLOSE")
    val info = result?
    if not synced or not directory_fsync(stage): return Err("SCVDB_EVIDENCE_DURABILITY_UNCERTAIN")
    if not file_publish_noreplace("{stage}/unverified", "{stage}/content")?: return Err("SCVDB_EVIDENCE_COLLISION")
    if not directory_fsync(stage): return Err("SCVDB_EVIDENCE_DURABILITY_UNCERTAIN")
    Ok(DbHydratedEvidence(digest: digest, content_bytes: info.content_bytes, private_directory: stage, content_path: "{stage}/content"))

fn db_evidence_hydrate_file(checkout: text, parent: text, digest: text, target_parent: text, quota: DbEvidenceStoreQuota) -> Result<DbHydratedEvidence, text>:
    _hydrate_quota(quota)?
    if not _hydrate_digest(digest): return Err("SCVDB_EVIDENCE_DIGEST")
    val root = db_evidence_external_scope(checkout, parent, "scv-evidence-v1")?
    # Hydrated bytes remain outside the checkout/common Git directory too.
    val target_scope = db_evidence_external_scope(checkout, target_parent, "scv-evidence-v1")?
    if not dir_is_real_no_follow(target_parent): return Err("SCVDB_STORE_SCOPE")
    val target = path_final_existing(target_parent)?
    if target.path != target_parent: return Err("SCVDB_STORE_SCOPE")
    val stage = secure_temp_dir(target_parent, "scv-hydrate-")?
    val identity = path_final_existing(stage)?
    if not dir_is_real_no_follow(stage) or identity.path != stage or not path_identity_contains(target, identity): return Err("SCVDB_STORE_SCOPE")
    val copied = _hydrate_copy("{root}/{digest}.scve", digest, stage, quota)
    # A parent sync failure is also an owner failure: the caller has not yet
    # received this private path. Route it through identical checked cleanup.
    val result = match copied:
        Ok(info):
            if directory_fsync(target_parent): Ok(info)
            else: Err("SCVDB_EVIDENCE_DURABILITY_UNCERTAIN")
        Err(error): Err(error)
    match result:
        Ok(info): Ok(info)
        Err(error):
            if not dir_is_real_no_follow(stage) or not path_identity_same(identity, path_final_existing(stage)?) or not path_identity_same(target, path_final_existing(target_parent)?) or not dir_remove_all(stage): return Err("SCVDB_EVIDENCE_CLEANUP")
            Err(error)

export DbEvidenceFileInfo, DbHydratedEvidence, db_evidence_inspect_file, db_evidence_hydrate_file
export db_evidence_inspect_at
