# Exact candidate projection; file contents are UTF-8 bytes, never NFC rewritten.
use app.scv.db.git_candidate.{DbGitCandidateFile}
use std.scv.db_receipt.{DbSettlementReceipt}
use std.scv.db_receipt_codec.{db_receipt_encode, db_receipt_decode}
use std.scv.db_canonical.*
use std.scv.db_snapshot.{db_snapshot_hex, db_snapshot_unhex}
use std.common.base_encoding.utilities.{base_encoding_text_to_bytes, validated_utf8_bytes_to_text_linear}
use std.common.crypto.sha256.{sha256_u8_hex}

enum DbSettlementPhase:
    Prepared
    PublishedAwaitingIndex

struct DbSettlementJournal:
    receipt: DbSettlementReceipt
    files: [DbGitCandidateFile]
    projection_digest: text
    phase: DbSettlementPhase

fn db_settlement_files_bytes(files: [DbGitCandidateFile]) -> Result<[u8], text>:
    if files.len() == 0 or files.len() > 1024: return Err("SCVDB_JOURNAL_FILES_QUOTA")
    var entries: [DbCanonicalEntry] = []
    var paths: [text] = []
    var total = 0
    for file in files:
        if file.path == "" or file.path.len() > 512 or file.path.starts_with("/"): return Err("SCVDB_JOURNAL_PATH")
        for part in file.path.split("/"):
            if part == "" or part == "." or part == ".." or part.to_lower() == ".git": return Err("SCVDB_JOURNAL_PATH")
        for index in 0..file.path.len():
            val code = file.path.char_code_at(index)
            if not ((code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 45 or code == 46 or code == 47 or code == 95): return Err("SCVDB_JOURNAL_PATH")
        val path = file.path.to_lower()
        for previous in paths:
            if path == previous or path.starts_with(previous + "/") or previous.starts_with(path + "/"): return Err("SCVDB_JOURNAL_PATH_COLLISION")
        paths.push(path)
        val bytes = base_encoding_text_to_bytes(file.content)
        total = total + bytes.len()
        if total > 4194304: return Err("SCVDB_JOURNAL_BYTES_QUOTA")
        entries.push(DbCanonicalEntry(key: db_canonical_text(file.path)?, value: db_frame(4u8, bytes)))
    db_canonical_map(entries)

fn db_settlement_projection_digest(files: [DbGitCandidateFile]) -> Result<text, text>:
    Ok(sha256_u8_hex(db_domain_bytes("settlement-projection", db_settlement_files_bytes(files)?)?))

fn db_settlement_journal_encode(journal: DbSettlementJournal) -> Result<text, text>:
    if db_settlement_projection_digest(journal.files)? != journal.projection_digest: return Err("SCVDB_JOURNAL_PROJECTION_DIGEST")
    val phase = match journal.phase:
        Prepared: 0u64
        PublishedAwaitingIndex: 1u64
    val payload = db_canonical_text(db_receipt_encode(journal.receipt)?)? + db_settlement_files_bytes(journal.files)? + db_canonical_text(journal.projection_digest)? + db_frame(2u8, db_u64_bytes(phase))
    val encoded = "SCVDB-SETTLEMENT-JOURNAL-v1\n" + db_snapshot_hex(db_domain_bytes("settlement-journal", db_frame(98u8, payload))?) + "\n"
    if encoded.len() > 12582912: return Err("SCVDB_JOURNAL_BYTES_QUOTA")
    Ok(encoded)

fn db_settlement_journal_decode(encoded: text) -> Result<DbSettlementJournal, text>:
    val prefix = "SCVDB-SETTLEMENT-JOURNAL-v1\n"
    if encoded.len() > 12582912: return Err("SCVDB_JOURNAL_BYTES_QUOTA")
    if not encoded.starts_with(prefix) or not encoded.ends_with("\n") or encoded.len() <= prefix.len(): return Err("SCVDB_JOURNAL_VERSION")
    val bytes = db_snapshot_unhex(encoded[prefix.len():encoded.len() - 1])?
    val domain = db_domain_bytes("settlement-journal", [])?
    if bytes.len() <= domain.len(): return Err("SCVDB_JOURNAL_ENCODING")
    for index in 0..domain.len():
        if bytes[index] != domain[index]: return Err("SCVDB_JOURNAL_DOMAIN")
    val root = db_read_frame(bytes, domain.len())?
    if root.tag != 98u8 or root.next_offset != bytes.len(): return Err("SCVDB_JOURNAL_ENCODING")
    val fields = db_read_children(root.payload)?
    if fields.len() != 4 or fields[1].tag != 8u8: return Err("SCVDB_JOURNAL_ENCODING")
    val entries = db_read_children(fields[1].payload)?
    if entries.len() % 2 != 0 or entries.len() > 2048: return Err("SCVDB_JOURNAL_FILES_QUOTA")
    var files: [DbGitCandidateFile] = []
    var index = 0
    while index < entries.len():
        if entries[index + 1].tag != 4u8: return Err("SCVDB_JOURNAL_ENCODING")
        files.push(DbGitCandidateFile(path: db_read_text(entries[index])?, content: validated_utf8_bytes_to_text_linear(entries[index + 1].payload)?))
        index = index + 2
    val phase_number = db_read_unsigned(fields[3])?
    if phase_number > 1: return Err("SCVDB_JOURNAL_PHASE")
    val phase = if phase_number == 0: DbSettlementPhase.Prepared else: DbSettlementPhase.PublishedAwaitingIndex
    val journal = DbSettlementJournal(receipt: db_receipt_decode(db_read_text(fields[0])?)?, files: files, projection_digest: db_read_text(fields[2])?, phase: phase)
    if db_settlement_journal_encode(journal)? != encoded: return Err("SCVDB_JOURNAL_NONCANONICAL")
    Ok(journal)

export DbSettlementPhase, DbSettlementJournal, db_settlement_files_bytes, db_settlement_projection_digest
export db_settlement_journal_encode, db_settlement_journal_decode
