# Durable discovery owner. Structural evidence receipts are built only after
# signed settlement, real accepted Git bytes, and actual CAS closure read-back.
# Network/CAS checks precede the short SJ commit lease; HEAD CAS detects races.
use app.scv.db.local_store.{DbStoreView, db_store_read, db_store_commit}
use app.scv.db.ci_state_codec.*
use app.scv.db.ci_readback.{db_ci_git_manifest_readback, db_ci_git_receipt_readback}
use app.scv.db.evidence_store.{DbEvidenceStoreQuota, db_evidence_store_get}
use std.scv.db_ci_ingest.{DbCiCursor, DbDiscoveryPage, DbEvidenceReceipt, db_ci_advance}
use std.scv.db_evidence.{db_evidence_same_ref, db_evidence_digest_valid}
use std.scv.db_receipt.*
use std.scv.db_patch.{db_ref_context}
use std.common.crypto.sha256.{sha256_text}

struct DbCiStoreView:
    head: text
    state: DbCiState

fn _ci_read(root: text, instance: text, project: text) -> Result<(DbStoreView, DbCiState), text>:
    val stored = db_store_read(root, "ci")
    if stored.code == "empty":
        if instance == "" or project == "": return Err("SCVDB_CI_SCOPE")
        val cursor = DbCiCursor(provider_instance: instance, project: project, opaque_position: "", high_water_seconds: 0, overlap_from_seconds: 0)
        return Ok((stored, DbCiState(cursor: cursor, tracked_run_ids: [], manifests: [], last_receipt: nil)))
    if stored.code != "ok": return Err(stored.code)
    val state = db_ci_state_decode(stored.state)?
    if state.cursor.provider_instance != instance or state.cursor.project != project: return Err("SCVDB_CI_SCOPE")
    Ok((stored, state))

fn db_ci_store_read(root: text, instance: text, project: text) -> Result<DbCiStoreView, text>:
    val (stored, state) = _ci_read(root, instance, project)?
    Ok(DbCiStoreView(head: stored.head, state: state))

fn _ci_commit(root: text, current: DbStoreView, state: DbCiState) -> Result<DbCiStoreView, text>:
    val encoded = db_ci_state_encode(state)?
    var published = current
    if encoded == current.state:
        # Same generation retry resynchronizes the original immutable image.
        published = db_store_commit(root, current.parent, current.transaction_id, current.state, "ci")
    else:
        published = db_store_commit(root, current.head, sha256_text(encoded), encoded, "ci")
    if published.code != "ok": return Err(published.code)
    Ok(DbCiStoreView(head: published.head, state: state))

fn db_ci_discover(root: text, expected_head: text, manifest: DbCiDurableManifest) -> Result<DbCiStoreView, text>:
    """Return only after immutable discovery and run tracking are durable; cursor stays put."""
    val encoded = db_ci_manifest_encode(manifest)?
    val (stored, loaded) = _ci_read(root, manifest.provider_instance, manifest.project)?
    var state = loaded
    for previous in state.manifests:
        if db_evidence_same_ref(previous.manifest, manifest.manifest):
            if db_ci_manifest_encode(previous)? != encoded: return Err("SCVDB_CI_MANIFEST_COLLISION")
            return _ci_commit(root, stored, state)
    if expected_head != stored.head: return Err("SCVDB_STORE_HEAD_ADVANCED")
    if state.manifests.len() >= 10000 or state.tracked_run_ids.len() >= 10000: return Err("SCVDB_CI_BACKPRESSURE")
    state.manifests.push(manifest)
    if not state.tracked_run_ids.contains(manifest.run_id): state.tracked_run_ids.push(manifest.run_id)
    _ci_commit(root, stored, state)

fn _ci_verify_cas(root: text, external_parent: text, digest: text, quota: DbEvidenceStoreQuota) -> Result<text, text>:
    if not db_evidence_digest_valid(digest): return Err("SCVDB_CI_BUNDLE_DIGEST")
    # Semantic references declare algorithm/version; physical CAS keys are raw
    # SHA-256 hex. Conversion occurs only after validating that exact protocol.
    var pending: [text] = [digest[10:]]
    var verified: [text] = []
    var index = 0
    while index < pending.len():
        val id = pending[index]
        index = index + 1
        if not verified.contains(id):
            if verified.len() >= 10000: return Err("SCVDB_CI_EVIDENCE_CLOSURE_QUOTA")
            val node = db_evidence_store_get(root, external_parent, id, 0, quota)?
            if node.digest != id or node.availability != "available": return Err("SCVDB_CI_EVIDENCE_READBACK")
            verified.push(id)
            for dependency in node.dependencies:
                if not verified.contains(dependency) and not pending.contains(dependency):
                    if pending.len() >= 10000: return Err("SCVDB_CI_EVIDENCE_CLOSURE_QUOTA")
                    pending.push(dependency)
    Ok("read-back")

fn _ci_verify_chain(state: DbCiState, chain: [DbSettlementReceipt], authority: DbReceiptAuthority) -> Result<[DbSettlementReceipt], text>:
    if chain.len() > 64: return Err("SCVDB_CI_RECEIPT_CHAIN_QUOTA")
    var verified: [DbSettlementReceipt] = []
    if val anchor = state.last_receipt:
        val authenticated = db_receipt_authenticate(anchor, authority)?
        verified.push(anchor)
    for receipt in chain:
        if verified.len() == 0:
            val genesis = db_receipt_genesis(receipt, authority)?
            verified.push(receipt)
        else:
            val previous = verified[verified.len() - 1]
            val authenticated = db_receipt_authenticate(receipt, authority)?
            if authenticated != db_receipt_digest(previous)?:
                val successor = db_receipt_successor(previous, receipt, authority)?
                verified.push(receipt)
    if verified.len() == 0: return Err("SCVDB_CI_RECEIPT_REQUIRED")
    Ok(verified)

fn db_ci_advance_durable(root: text, scratch_parent: text, evidence_parent: text, expected_head: text, page: DbDiscoveryPage, chain: [DbSettlementReceipt], authority: DbReceiptAuthority, overlap_seconds: u64, quota: DbEvidenceStoreQuota) -> Result<DbCiStoreView, text>:
    """Reverify every proof at the effect boundary; caller receipt-shaped values grant nothing."""
    val (stored, loaded) = _ci_read(root, page.provider_instance, page.project)?
    if stored.head != expected_head: return Err("SCVDB_STORE_HEAD_ADVANCED")
    if page.items.len() > 128: return Err("SCVDB_CI_PAGE_QUOTA")
    val receipts = _ci_verify_chain(loaded, chain, authority)?
    for receipt in receipts:
        val accepted = db_ci_git_receipt_readback(root, scratch_parent, receipt)?
    var verified: [DbEvidenceReceipt] = []
    for item in page.items:
        var manifest: DbCiDurableManifest? = nil
        for candidate in loaded.manifests:
            if db_evidence_same_ref(candidate.manifest, item.manifest): manifest = Some(candidate)
        if val durable = manifest:
            if not db_ref_context(durable.manifest.entity, authority.namespace, authority.epoch): return Err("SCVDB_CI_MANIFEST_AUTHORITY")
            if durable.bundle_digest != item.bundle_digest: return Err("SCVDB_CI_MANIFEST_COLLISION")
            var acceptance: DbSettlementReceipt? = nil
            for receipt in receipts:
                if receipt.batch_digests.contains(durable.accepted_batch_digest): acceptance = Some(receipt)
            if val accepted = acceptance:
                val encoded = db_ci_manifest_encode(durable)?
                val actual = db_ci_git_manifest_readback(root, scratch_parent, accepted, sha256_text(encoded))?
                if actual != encoded: return Err("SCVDB_CI_CANONICAL_MANIFEST_MISMATCH")
                val cas_read = _ci_verify_cas(root, evidence_parent, durable.bundle_digest, quota)?
                verified.push(DbEvidenceReceipt(provider_instance: page.provider_instance, project: page.project, manifest: durable.manifest, bundle_digest: durable.bundle_digest, durable_object_digest: durable.bundle_digest, accepted_manifest: durable.manifest, accepted_head: accepted.accepted_head, accepted_object_format: accepted.object_format, settlement_receipt_digest: "sha256:v1:" + db_receipt_digest(accepted)?))
            else: return Err("SCVDB_CI_BATCH_NOT_ACCEPTED")
        else: return Err("SCVDB_CI_DURABLE_DISCOVERY_REQUIRED")
    var next = loaded
    next.cursor = db_ci_advance(loaded.cursor, page, verified, overlap_seconds)?
    next.last_receipt = Some(receipts[receipts.len() - 1])
    _ci_commit(root, stored, next)

export DbCiStoreView, db_ci_store_read, db_ci_discover, db_ci_advance_durable
