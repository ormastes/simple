# Canonical follow-up after durable GitHub delivery acknowledgement. Preview is
# not authority: apply reopens delivery/semantic state and obtains fresh GETs.
# Policies, signed patch and transport capability come from independent owners.
use app.io.mod.{process_run_bounded}
use app.scv.db.bridge_store.{db_bridge_store_load}
use app.scv.db.local_transition.{DbApplyResult, DbLocalView, db_read_local_view, db_apply_local_transition}
use app.scv.db.github_issue_bridge.{DbGithubBridgeRequest, db_github_bridge_payload, db_github_bridge_external_id, db_github_bridge_readback}
use app.scv.db.github_provider.{DbGithubTransport, DbGithubProcessReply}
use std.scv.db_admission.{DbAdmissionPolicy, db_admission_policy_digest, db_authorize_patch}
use std.scv.db_bridge.{DbBridgeDelivery, db_bridge_intent_digest}
use std.scv.db_patch.*
use std.scv.db_reducer.{MergePolicy, DbRow, db_field_value}
use std.scv.distributed_identity.{EntityRef, entity_ref_canonical}
use std.scv.db_canonical.{db_domain_bytes}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.scv.sj_capsule.{scv_sj_lease_is_held}

use app.scv.db.github_binding_core.*

fn _binding_reference_live(field: DbField, view: DbLocalView, admission: DbAdmissionPolicy, revision: text) -> Result<bool, text>:
    match field.value:
        Reference(ref):
            if not db_ref_context(ref, admission.namespace, admission.epoch): return Err("SCVDB_BINDING_INTENT_CONTEXT_MISSING")
            if revision != "" and db_ref_kind(ref) != "bridge_policy": return Err("SCVDB_BINDING_AUTHORITY_KIND")
            for row in view.image.state.rows:
                if row.entity == entity_ref_canonical(ref) and not row.tombstoned:
                    if revision != "" and row.kind != "bridge_policy": return Err("SCVDB_BINDING_AUTHORITY_KIND")
                    if revision != "" and db_field_value(row.fields, "revision") != DbValue.Text(revision): return Err("SCVDB_BINDING_AUTHORITY_REVISION")
                    return Ok(true)
        _: ()
    Err("SCVDB_BINDING_INTENT_CONTEXT_MISSING")

fn _binding_context(root: text, admission: DbAdmissionPolicy, request: DbGithubBridgeRequest, target: DbGithubBindingTarget, original: DbPatch? = nil) -> Result<DbGithubBindingContext, text>:
    val scoped = db_binding_delivery(root, admission, request, target)?
    val delivery = scoped.delivery
    val view = db_read_local_view(root, admission)?
    var intent_fields: [DbField] = []
    if val accepted = original:
        intent_fields = db_binding_original_fields(accepted)?
    else:
        var intent_rows = 0
        for row in view.image.state.rows:
            if row.kind == "bridge_intent" and not row.tombstoned and db_field_value(row.fields, "intent_revision") == DbValue.Text(delivery.intent.revision):
                intent_rows = intent_rows + 1
                intent_fields = row.fields
        if intent_rows != 1: return Err("SCVDB_BINDING_INTENT_NOT_COMMITTED")
    if original == nil:
        _binding_reference_live(db_binding_required(intent_fields, "local_entity", true)?, view, admission, "")?
        _binding_reference_live(db_binding_required(intent_fields, "authority_policy", true)?, view, admission, scoped.policy.revision)?
    db_binding_context_make(view.head, view.image.state.revision, view.image.state.rows, admission, scoped, target, intent_fields)
fn db_github_binding_plan(root: text, admission: DbAdmissionPolicy, request: DbGithubBridgeRequest, target: DbGithubBindingTarget, execute: fn([text], i64, i64) -> DbGithubProcessReply) -> Result<DbGithubBindingPlan, text>:
    val context = _binding_context(root, admission, request, target)?
    val operations = db_binding_operations(context, target)?
    db_binding_readback(root, context, execute)?
    Ok(DbGithubBindingPlan(head: context.head, base_revision: context.revision, intent_revision: context.delivery.intent.revision, provenance: db_binding_provenance(context.delivery.intent.revision), operations: operations))

fn db_github_binding_apply(root: text, expected_head: text, admission: DbAdmissionPolicy, merge: MergePolicy, request: DbGithubBridgeRequest, target: DbGithubBindingTarget, patch: DbPatch, now: u64, execute: fn([text], i64, i64) -> DbGithubProcessReply) -> Result<DbApplyResult, text>:
    val current = db_read_local_view(root, admission)?
    val digest = db_patch_validate(patch)?
    for batch in current.image.state.accepted:
        if batch.batch_id == patch.batch_id:
            var accepted_ids: [text] = []
            for prior in current.image.state.accepted: accepted_ids.push(prior.batch_id)
            db_authorize_patch(patch, admission, accepted_ids, now)?
            val context = _binding_context(root, admission, request, target, Some(patch))?
            if patch.provenance != db_binding_provenance(context.delivery.intent.revision): return Err("SCVDB_BINDING_PROVENANCE")
            if batch.canonical_digest != digest or not db_binding_replay_matches(context, target, patch)?: return Err("SCVDB_BINDING_REPLAY_MISMATCH")
            return db_apply_local_transition(root, expected_head, patch, merge, admission, now)
    val context = _binding_context(root, admission, request, target)?
    if patch.provenance != db_binding_provenance(context.delivery.intent.revision): return Err("SCVDB_BINDING_PROVENANCE")
    if context.head != expected_head or patch.base_revision != context.revision: return Err("SCVDB_STORE_HEAD_ADVANCED")
    val operations = db_binding_operations(context, target)?
    if patch.operations.len() != operations.len(): return Err("SCVDB_BINDING_PATCH_MISMATCH")
    for index in 0..operations.len():
        if db_operation_bytes(patch.operations[index])? != db_operation_bytes(operations[index])?: return Err("SCVDB_BINDING_PATCH_MISMATCH")
    var accepted_ids: [text] = []
    for prior in current.image.state.accepted: accepted_ids.push(prior.batch_id)
    db_authorize_patch(patch, admission, accepted_ids, now)?
    db_binding_readback(root, context, execute)?
    # Fresh network work has ended. The semantic writer owns the only CAS/lease.
    db_apply_local_transition(root, expected_head, patch, merge, admission, now)

fn _binding_live_execute(args: [text], timeout: i64, maximum_bytes: i64) -> DbGithubProcessReply:
    val (stdout, stderr, code) = process_run_bounded("gh", args, timeout, maximum_bytes)
    DbGithubProcessReply(stdout: stdout, stderr: stderr, exit_code: code)

fn db_github_binding_apply_live(root: text, expected_head: text, admission: DbAdmissionPolicy, merge: MergePolicy, request: DbGithubBridgeRequest, target: DbGithubBindingTarget, patch: DbPatch, now: u64) -> Result<DbApplyResult, text>:
    db_github_binding_apply(root, expected_head, admission, merge, request, target, patch, now, _binding_live_execute)

export DbGithubBindingTarget, DbGithubBindingPlan
export db_github_binding_plan, db_github_binding_apply, db_github_binding_apply_live
