# One cross-platform command owner. Policy files are explicitly supplied and
# independently digest-pinned; incoming patches never choose their own policy.
# These local commands do not claim protected remote settlement or scale gates.
use app.io.mod (file_read_regular_no_follow_bounded, file_is_regular_no_follow)
use app.scv.db.local_store.{db_local_existing_canonical, db_store_read}
use app.scv.db.local_apply.{db_read_local_view, db_apply_local}
use std.scv.db_policy_codec.{DbPolicyConfig, db_policy_decode}
use std.scv.db_patch_codec.{db_patch_decode}
use std.nogc_sync_mut.io.path_identity.{path_final_existing}
use std.nogc_sync_mut.io.time_ops.{time_sample_unix_micros_or_failure}
use std.nogc_sync_mut.fs.host_path.{host_path_canonical}
use app.scv.db.quarantine_store.{DbQuarantineQuota, db_quarantine_import, db_quarantine_read}
use std.scv.db_paged_model.{db_paged_policy_decode}
use app.scv.db.paged_store.{db_paged_initialize, db_paged_open, db_paged_apply}

fn db_command_help() -> text:
    "scv db status <policy-file> <policy-digest>\nscv db apply <policy-file> <policy-digest> <patch-file> <expected-head|empty>\nscv db paged-init <paged-policy-file> <policy-digest>\nscv db paged-status <paged-policy-file> <policy-digest>\nscv db paged-apply <paged-policy-file> <policy-digest> <patch-file> <expected-head>\nscv db paged-quarantine-apply <paged-policy-file> <policy-digest> <external-store> <digest> <batch-id> <expected-head>\nscv db inspect-patch <patch-file>\nscv db quarantine-import <external-store> <bundle-file>\nscv db quarantine-inspect <external-store> <digest>\nscv db quarantine-apply <policy-file> <policy-digest> <external-store> <digest> <batch-id> <expected-head|empty>\nPolicy digests must come from the independently reviewed configuration. Apply is local; it does not settle a remote authority. Paged commands require a paged policy; existing reference stores require explicit migration. Quarantine inspection verifies storage and parsing only."

fn _db_command_now() -> Result<u64, text>:
    val sample = time_sample_unix_micros_or_failure()
    if sample < 0: return Err("SCVDB_COMMAND_CLOCK")
    Ok((sample / 1000000) as u64)

fn _db_command_quarantine_quota() -> DbQuarantineQuota:
    DbQuarantineQuota(max_bundle_bytes: 16777216, max_patch_bytes: 1048576, max_patches: 256)

fn _db_command_input(path: text, limit: i64) -> Result<text, text>:
    # Absolute, OS-resolved paths prevent an alias from silently selecting a
    # different policy/patch. Relative paths are resolved explicitly by caller.
    if not file_is_regular_no_follow(path) or not db_local_existing_canonical(path): return Err("SCVDB_COMMAND_INPUT_SCOPE")
    file_read_regular_no_follow_bounded(path, limit)

fn _db_command_policy(path: text, digest: text) -> Result<DbPolicyConfig, text>:
    db_policy_decode(_db_command_input(path, 33554560)?, digest)

fn _db_command_path(root: text, path: text) -> text:
    val logical = host_path_canonical(path)
    if logical.starts_with("/") or (logical.len() >= 3 and logical[1:3] == ":/"): return logical
    "{root}/{logical}"

fn _db_command_run(root: text, args: [text]) -> Result<text, text>:
    if args.len() == 0: return Ok(db_command_help())
    if args.len() == 1 and args[0] == "help": return Ok(db_command_help())
    val observed = path_final_existing(root)?
    if ["paged-init", "paged-status", "paged-apply", "paged-quarantine-apply"].contains(args[0]):
        var required = 3
        if args[0] == "paged-apply": required = 5
        if args[0] == "paged-quarantine-apply": required = 7
        if args.len() != required: return Err("SCVDB_COMMAND_USAGE")
        val policy = db_paged_policy_decode(_db_command_input(_db_command_path(observed.path, args[1]), 33554560)?, args[2])?
        if args[0] == "paged-init":
            val view = db_paged_initialize(observed.path, policy)?
            return Ok("OK paged head={view.head} revision={view.manifest.revision}")
        if args[0] == "paged-status":
            val view = db_paged_open(observed.path, policy)?
            return Ok("OK paged head={view.head} revision={view.manifest.revision}")
        if args[0] == "paged-quarantine-apply":
            val patches = db_quarantine_read(observed.path, _db_command_path(observed.path, args[3]), args[4], _db_command_quarantine_quota())?
            for patch in patches:
                if patch.batch_id == args[5]:
                    val result = db_paged_apply(observed.path, args[6], patch, policy)?
                    return Ok("OK paged head={result.head} revision={result.revision} replay={result.replay}")
            return Err("SCVDB_QUARANTINE_PATCH_MISSING")
        val patch = db_patch_decode(_db_command_input(_db_command_path(observed.path, args[3]), 33554560)?)?
        val result = db_paged_apply(observed.path, args[4], patch, policy)?
        return Ok("OK paged head={result.head} revision={result.revision} replay={result.replay}")
    if args[0] == "quarantine-import":
        if args.len() != 3: return Err("SCVDB_COMMAND_USAGE")
        val stored = db_quarantine_import(observed.path, _db_command_path(observed.path, args[1]), _db_command_path(observed.path, args[2]), "scv-patch-bundle-v1", _db_command_now()? / 86400, _db_command_quarantine_quota())?
        return Ok("OK quarantined-unverified digest={stored.digest} patches={stored.patch_count}")
    if args[0] == "quarantine-inspect":
        if args.len() != 3: return Err("SCVDB_COMMAND_USAGE")
        val patches = db_quarantine_read(observed.path, _db_command_path(observed.path, args[1]), args[2], _db_command_quarantine_quota())?
        return Ok("OK quarantined-unverified digest={args[2]} patches={patches.len()}")
    if args[0] == "quarantine-apply":
        if args.len() != 7: return Err("SCVDB_COMMAND_USAGE")
        val config = _db_command_policy(_db_command_path(observed.path, args[1]), args[2])?
        val patches = db_quarantine_read(observed.path, _db_command_path(observed.path, args[3]), args[4], _db_command_quarantine_quota())?
        val expected = if args[6] == "empty": "" else: args[6]
        for patch in patches:
            if patch.batch_id == args[5]:
                # Reopening a bundle is not a capability: the normal producer
                # owner reauthenticates current policy, dependencies and CAS.
                val result = db_apply_local(observed.path, expected, patch, config.merge, config.admission, _db_command_now()?)?
                if result.code != "ok": return Err("SCVDB_COMMAND_CONFLICT")
                return Ok("OK local head={result.head} revision={result.revision} replay={result.replay}")
        return Err("SCVDB_QUARANTINE_PATCH_MISSING")
    if args[0] == "inspect-patch":
        if args.len() != 2: return Err("SCVDB_COMMAND_USAGE")
        val patch = db_patch_decode(_db_command_input(_db_command_path(observed.path, args[1]), 33554560)?)?
        # No raw metadata or source path is echoed. Parsing is not signature
        # authorization: that requires an independently reviewed policy.
        return Ok("OK parsed-unverified digest={patch.payload_digest} operations={patch.operations.len()}")
    if args[0] != "status" and args[0] != "apply": return Err("SCVDB_COMMAND_USAGE")
    val expected_count = if args[0] == "status": 3 else: 5
    if args.len() != expected_count: return Err("SCVDB_COMMAND_USAGE")
    val config = _db_command_policy(_db_command_path(observed.path, args[1]), args[2])?
    if args[0] == "status":
        val paged = db_store_read(observed.path, "paged")
        if paged.code == "ok": return Err("SCVDB_PAGED_MIGRATION_REQUIRED")
        if paged.code != "empty": return Err(paged.code)
        val current = db_read_local_view(observed.path, config.admission)?
        val head = if current.head == "": "empty" else: current.head
        return Ok("OK local head={head} revision={current.image.state.revision} rows={current.image.state.rows.len()} accepted={current.image.state.accepted.len()} conflicts={current.image.catalog.records.len()} resolutions={current.image.catalog.resolutions.len()}")
    val patch = db_patch_decode(_db_command_input(_db_command_path(observed.path, args[3]), 33554560)?)?
    val expected = if args[4] == "empty": "" else: args[4]
    val result = db_apply_local(observed.path, expected, patch, config.merge, config.admission, _db_command_now()?)?
    if result.code != "ok": return Err("SCVDB_COMMAND_CONFLICT")
    Ok("OK local head={result.head} revision={result.revision} replay={result.replay}")

fn db_command(root: text, args: [text]) -> text:
    match _db_command_run(root, args):
        Ok(result): result
        Err(error): "ERROR {error}"

export db_command, db_command_help
