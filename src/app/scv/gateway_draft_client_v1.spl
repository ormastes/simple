"""Native client for the bounded authenticated SCV local draft transfer route."""
use std.scv.gateway_draft_protocol_v1.{ScvGatewayDraftRequestV1, ScvGatewayDraftResponseV1,
    SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1, SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1, SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1,
    scv_gateway_draft_request_encode_v1, scv_gateway_draft_response_decode_v1}
use std.nogc_sync_mut.http_client.bounded_endpoint_v1.{BoundedHttpTargetV1,
    bounded_http_target_v1, bounded_http_bearer_valid_v1}
use std.nogc_sync_mut.http_client.bounded_transport_v1.{bounded_http_post_with_request_limit_v1}
use std.common.crypto.sha256.{sha256_u8_hex}

pub struct ScvGatewayDraftClientConfigV1:
    endpoint: text
    repository: text
    principal_id: text
    allow_loopback_http: bool
    timeout_ms: i64
    tls_address: text

fn _draft_client_subject_id_valid_v1(value: text) -> bool:
    if value.len() <= 0 or value.len() > 128 or value == "." or value == "..": return false
    for byte in value.bytes():
        val ch = byte.to_i64()
        if not ((ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
            (ch >= 97 and ch <= 122) or ch == 45 or ch == 46 or ch == 95): return false
    true

pub fn scv_gateway_draft_client_target_v1(config: ScvGatewayDraftClientConfigV1) -> Result<BoundedHttpTargetV1, text>:
    if config.timeout_ms < 1 or config.timeout_ms > 60000: return Err("draft_timeout_invalid")
    if not _draft_client_subject_id_valid_v1(config.repository) or
        not _draft_client_subject_id_valid_v1(config.principal_id): return Err("draft_subject_invalid")
    val target = bounded_http_target_v1(config.endpoint, config.tls_address, config.allow_loopback_http)?
    if target.path != "/scv/draft/v1": return Err("draft_path_invalid")
    Ok(target)

pub fn scv_gateway_draft_client_call_v1(config: ScvGatewayDraftClientConfigV1,
        request: ScvGatewayDraftRequestV1,
        credentials: fn() -> Result<text, text>) -> Result<ScvGatewayDraftResponseV1, text>:
    val target = scv_gateway_draft_client_target_v1(config)?
    val wire = match scv_gateway_draft_request_encode_v1(request, config.repository):
        case Ok(value): value
        case Err(_): return Err("draft_request_invalid")
    # Acquire only after endpoint, repository, digest and payload bounds pass.
    val token = match credentials():
        case Ok(value): value
        case Err(_): return Err("draft_credentials_unavailable")
    if not bounded_http_bearer_valid_v1(token): return Err("draft_credentials_invalid")
    val source = match bounded_http_post_with_request_limit_v1(target, token, wire,
            config.timeout_ms, SCV_GATEWAY_DRAFT_MAX_RESPONSE_BYTES_V1,
            SCV_GATEWAY_DRAFT_MAX_REQUEST_BYTES_V1):
        case Ok(value): value
        case Err(_): return Err("draft_transport_failed")
    val response = match scv_gateway_draft_response_decode_v1(source, request,
            config.repository, config.principal_id):
        case Ok(value): value
        case Err(_): return Err("draft_response_invalid")
    if response.status != "ok": return Err("draft_operation_rejected")
    Ok(response)

pub fn scv_gateway_draft_client_put_v1(config: ScvGatewayDraftClientConfigV1,
        request_id: text, id: text, bytes: [u8],
        credentials: fn() -> Result<text, text>) -> Result<ScvGatewayDraftResponseV1, text>:
    if bytes.len() as i64 > SCV_GATEWAY_DRAFT_MAX_BLOB_BYTES_V1: return Err("draft_payload_limit")
    val request = ScvGatewayDraftRequestV1(version: 1, id: id, repository: config.repository,
        method: "put", request_id: request_id, content_sha256: sha256_u8_hex(bytes), bytes: bytes)
    scv_gateway_draft_client_call_v1(config, request, credentials)

pub fn scv_gateway_draft_client_get_v1(config: ScvGatewayDraftClientConfigV1,
        request_id: text, id: text, content_sha256: text,
        credentials: fn() -> Result<text, text>) -> Result<ScvGatewayDraftResponseV1, text>:
    val request = ScvGatewayDraftRequestV1(version: 1, id: id, repository: config.repository,
        method: "get", request_id: request_id, content_sha256: content_sha256, bytes: [])
    scv_gateway_draft_client_call_v1(config, request, credentials)

export ScvGatewayDraftClientConfigV1, scv_gateway_draft_client_target_v1
export scv_gateway_draft_client_call_v1, scv_gateway_draft_client_put_v1, scv_gateway_draft_client_get_v1
