use std.scv.shadow_write.{scv_shadow_write_enable, scv_shadow_write_sync, scv_shadow_write_status}

# `rt_stdout_write([u8])` is NOT registered by the seed interpreter (only
# `rt_stdout_write_text` is, and only that one is defined in the C runtime),
# so calling it made `pack-read-object` abort with
# "unknown extern function: rt_stdout_write". Write via the registered
# text entry point instead; it appends no newline, so exact-byte roundtrip
# holds. Limitation: this goes through scv's byte->text conversion and is
# therefore not binary-safe for non-UTF8 object payloads.
extern fn rt_stdout_write_text(s: text) -> i64

fn scv_help() -> text:
    var lines: [text] = []
    lines.push("Usage: scv <init|snapshot|auto-snapshot|watch|status|log|op-log|restore-op|diff|parse-gate|parse-index|compile-gate|test-gate|mark-state|public-ready|stats|fsck|export-tree|export-manifest|import-manifest|export-git-fast-import|import-git-fast-import|db-index|pack-status|pack-write|pack-verify|pack-import|private-sync|private-sync-verify|private-sync-import|public-export|public-export-verify|public-push|public-push-verify|public-pull|network-push|network-push-verify|network-push-cas|network-pull|network-config|gc-dry-run|gc-prune|merge-commits|conflicts|resolve-conflict|bookmarks|bookmark-set|parsers|parser-install|parser-verify|langmap|langmap-set|new-change|close-change|checkpoint|doctor|verify-backends|backend|rebuild-db|promote-verify|shadow-sync|gc|recover|file-history|commit-policy|event-record|event-commit|event-replay|events>")
    lines.push("Wave-3 D-01: scv cst-store <path>   # store the file CST in the P-05 root store (revision+ContentId)")
    lines.push("Wave-4 I-06: scv identity <link|unlink|split|merge|trace> ...   # logged identity corrections")
    lines.push("Wave-5 B-06: scv pack-write-v2r | pack-verify-v2r | pack-fuzz-v2 <seed> <cases> | pack-soak-v2 <iterations>   # reachability-aware pack v2, delta fuzz, GC soak")
    lines.push("Wave-4 B-05: scv shadow-write <enable --dest <dir> [--git <dir>]|sync|status>   # continuous native shadow write")
    lines.push("")
    lines.push("Shared log options:")
    for line in log_options_help():
        lines.push("  {line}")
    lines.join("\n") + "\n"

fn scv_is_log_option(arg: text) -> bool:
    arg == "--human" or arg == "--llm" or arg == "--json" or
        arg == "--tui" or arg == "--stdout" or arg == "--quiet" or
        arg == "--verbose" or arg == "--dots" or arg == "--count" or
        arg == "--no-progress" or arg == "--log-mode" or arg == "--surface" or
        arg == "--progress" or arg.starts_with("--log-mode=") or
        arg.starts_with("--surface=") or arg.starts_with("--progress=")

fn scv_clean_args(args: [text]) -> [text]:
    var cleaned: [text] = []
    var i = 0
    while i < args.len():
        val arg = args[i]
        if scv_is_log_option(arg):
            if arg == "--log-mode" or arg == "--surface" or arg == "--progress":
                i = i + 1
        else:
            cleaned.push(arg)
        i = i + 1
    cleaned

fn scv_cli_result(result: text) -> i64:
    print result
    if result.starts_with("ERROR"):
        1
    else:
        0

# Three-way verdict mapping for doctor/verify tools: the verdict is the LAST
# non-empty line — PASS/OK -> 0, FAIL/ERROR-detail -> 1,
# "ERROR — nothing was checked" -> 2 (fail-closed, never a vacuous pass).
fn scv_cli_verdict(result: text) -> i64:
    print result
    var verdict = ""
    for line in result.split("\n"):
        if line.trim() != "":
            verdict = line.trim()
    if result.starts_with("ERROR — nothing was checked"):
        2
    elif verdict.starts_with("PASS") or verdict.starts_with("OK"):
        0
    else:
        1

fn scv_cli_watch(root: text, args: [text]) -> i64:
    var iterations = 0
    var poll_ms = 1000
    var i = 1
    while i < args.len():
        val arg = args[i]
        if arg == "--once":
            iterations = 1
        elif arg == "--iterations":
            if i + 1 >= args.len():
                print "ERROR watch --iterations requires a number"
                return 1
            iterations = args[i + 1].to_i64() ?? -1
            i = i + 1
        elif arg == "--poll-ms":
            if i + 1 >= args.len():
                print "ERROR watch --poll-ms requires a number"
                return 1
            poll_ms = args[i + 1].to_i64() ?? -1
            i = i + 1
        else:
            print "ERROR unknown watch option: {arg}"
            return 1
        i = i + 1
    scv_cli_result(scv_watch(root, iterations, poll_ms))

fn main() -> i64:
    val raw_args = get_cli_args()
    val log_opts = parse_log_options(raw_args)
    if not log_opts.valid:
        print "ERROR scv {log_opts.error}"
        return 1
    val args = scv_clean_args(raw_args)
    val root = cwd()
    if args.len() == 0:
        if log_opts.log_mode == "json":
            print "{\"command\":\"scv\",\"status\":\"usage\"}"
            return 0
        val progress = render_progress(log_opts.progress, 0, 1, "usage")
        if progress != "":
            print progress
        print scv_help()
        return 0
    val cmd = args[0]
    match cmd:
        case "init":
            return scv_cli_result(scv_init_repo(root))
        case "snapshot":
            # I-02: FileEntityId resolved on every implicit snapshot;
            # optional editor-txn rename hints: --rename <old> <new>
            var snap_hints: [text] = []
            var snap_i = 1
            while snap_i < args.len():
                if args[snap_i] == "--rename":
                    if snap_i + 2 >= args.len():
                        print "ERROR snapshot --rename requires <old> <new>"
                        return 1
                    snap_hints.push("{args[snap_i + 1]}|{args[snap_i + 2]}")
                    snap_i = snap_i + 2
                snap_i = snap_i + 1
            return scv_cli_result(scv_snapshot_with_identity(root, snap_hints))
        case "auto-snapshot":
            return scv_cli_result(scv_auto_snapshot(root))
        case "watch":
            return scv_cli_watch(root, args)
        case "status", "st":
            return scv_cli_result(scv_status(root))
        case "log":
            val log_branch = if args.len() >= 2: args[1] else: ""
            if log_branch == "":
                return scv_cli_result(scv_log(root))
            else:
                return scv_cli_result(scv_log_branch(root, log_branch))
        case "op-log":
            return scv_cli_result(scv_op_log(root))
        case "restore-op":
            if args.len() < 2:
                print "ERROR restore-op requires an operation id"
                return 1
            return scv_cli_result(scv_restore_op(root, args[1]))
        case "diff":
            # D-02: `scv diff --view raw|syntax|entity|semantic|all [--git-patch]`
            var diff_view = ""
            var diff_git_patch = false
            var diff_i = 1
            while diff_i < args.len():
                if args[diff_i] == "--view":
                    if diff_i + 1 >= args.len():
                        print "ERROR diff --view requires a view name"
                        return 1
                    diff_view = args[diff_i + 1]
                    diff_i = diff_i + 1
                elif args[diff_i] == "--git-patch":
                    diff_git_patch = true
                diff_i = diff_i + 1
            if diff_view != "" or diff_git_patch:
                val view = if diff_view != "": diff_view else: "raw"
                return scv_cli_result(scv_diff_views(root, view, diff_git_patch))
            val mode = if args.len() >= 2: args[1] else: "--raw"
            return scv_cli_result(scv_diff(root, mode))
        case "file-history":
            if args.len() < 2:
                print "ERROR file-history requires a path or file id"
                return 1
            return scv_cli_result(scv_file_history(root, args[1]))
        case "commit-policy":
            if args.len() < 2:
                print "ERROR commit-policy requires a path"
                return 1
            var cp_force = false
            var cp_reason = ""
            var cp_i = 2
            while cp_i < args.len():
                if args[cp_i] == "--force-unparsed":
                    cp_force = true
                elif args[cp_i] == "--reason" and cp_i + 1 < args.len():
                    cp_reason = args[cp_i + 1]
                    cp_i = cp_i + 1
                cp_i = cp_i + 1
            if cp_force:
                return scv_cli_result(scv_commit_parse_policy_forced(root, args[1], cp_reason))
            return scv_cli_result(scv_commit_parse_policy(root, args[1]))
        case "parse-gate":
            if args.len() < 2:
                print "ERROR parse-gate requires a path"
                return 1
            return scv_cli_result(scv_parse_gate(root, args[1]))
        case "parsers":
            return scv_cli_result(scv_parsers(root))
        case "parser-install":
            if args.len() < 5:
                print "ERROR parser-install requires language, grammar, version, and wasm path"
                return 1
            val abi = if args.len() >= 6: args[5] else: "wasm32"
            return scv_cli_result(scv_parser_install(root, args[1], args[2], args[3], args[4], abi))
        case "parser-verify":
            return scv_cli_result(scv_parser_verify(root))
        case "parse-index":
            return scv_cli_result(scv_parse_index(root))
        case "langmap":
            return scv_cli_result(scv_langmap(root))
        case "langmap-set":
            if args.len() < 5:
                print "ERROR langmap-set requires extension, language, grammar, and version"
                return 1
            return scv_cli_result(scv_langmap_set(root, args[1], args[2], args[3], args[4]))
        case "compile-gate":
            if args.len() < 2:
                print "ERROR compile-gate requires a command"
                return 1
            return scv_cli_result(scv_compile_gate(root, args[1]))
        case "test-gate":
            if args.len() < 2:
                print "ERROR test-gate requires a command"
                return 1
            return scv_cli_result(scv_test_gate(root, args[1]))
        case "mark-state":
            if args.len() < 2:
                print "ERROR mark-state requires a state"
                return 1
            return scv_cli_result(scv_mark_current_state(root, args[1]))
        case "public-ready":
            return scv_cli_result(scv_public_ready(root))
        case "stats":
            return scv_cli_result(scv_stats(root))
        case "fsck":
            return scv_cli_result(scv_fsck(root))
        case "export-tree":
            if args.len() < 2:
                print "ERROR export-tree requires an output directory"
                return 1
            return scv_cli_result(scv_export_tree(root, args[1]))
        case "export-manifest":
            if args.len() < 2:
                print "ERROR export-manifest requires an output path"
                return 1
            return scv_cli_result(scv_export_manifest(root, args[1]))
        case "import-manifest":
            if args.len() < 3:
                print "ERROR import-manifest requires a manifest path and source directory"
                return 1
            return scv_cli_result(scv_import_manifest(root, args[1], args[2]))
        case "export-git-fast-import":
            if args.len() < 2:
                print "ERROR export-git-fast-import requires an output path"
                return 1
            var export_branch = "main"
            var export_since = ""
            var export_i = 2
            while export_i < args.len():
                val export_arg = args[export_i]
                if export_arg == "--since":
                    if export_i + 1 >= args.len():
                        print "ERROR --since requires a commit id"
                        return 1
                    export_since = args[export_i + 1]
                    export_i = export_i + 1
                elif not export_arg.starts_with("--"):
                    export_branch = export_arg
                export_i = export_i + 1
            return scv_cli_result(scv_export_git_fast_import(root, args[1], export_branch, export_since))
        case "import-git-fast-import":
            if args.len() < 2:
                print "ERROR import-git-fast-import requires an input path"
                return 1
            return scv_cli_result(scv_import_git_fast_import(root, args[1]))
        case "db-index":
            return scv_cli_result(scv_rebuild_object_index(root))
        case "pack-status":
            return scv_cli_result(scv_pack_status(root))
        case "pack-write":
            return scv_cli_result(scv_pack_write(root))
        case "pack-verify":
            val pack_id = if args.len() >= 2: args[1] else: ""
            return scv_cli_result(scv_pack_verify(root, pack_id))
        case "pack-import":
            if args.len() < 2:
                print "ERROR pack-import requires a pack directory"
                return 1
            val pack_id = if args.len() >= 3: args[2] else: ""
            return scv_cli_result(scv_pack_import(root, args[1], pack_id))
        case "pack-write-v2":
            return scv_cli_result(scv_pack_write_v2(root))
        case "pack-verify-v2":
            val pack_id_v2 = if args.len() >= 2: args[1] else: ""
            return scv_cli_result(scv_pack_verify_v2(root, pack_id_v2))
        case "pack-write-v2r":
            return scv_cli_result(scv_pack_write_v2_reachable(root))
        case "pack-verify-v2r":
            val pack_id_v2r = if args.len() >= 2: args[1] else: ""
            return scv_cli_result(scv_pack_verify_v2_reachable(root, pack_id_v2r))
        case "pack-fuzz-v2":
            val fuzz_seed = if args.len() >= 2: (args[1].to_i64() ?? 1) else: 1
            val fuzz_cases = if args.len() >= 3: (args[2].to_i64() ?? 32) else: 32
            return scv_cli_result(scv_pack_v2_fuzz(root, fuzz_seed, fuzz_cases))
        case "pack-soak-v2":
            val soak_iters = if args.len() >= 2: (args[1].to_i64() ?? 50) else: 50
            return scv_cli_result(scv_pack_v2_soak(root, soak_iters))
        case "pack-read-object":
            if args.len() < 3:
                print "ERROR pack-read-object requires kind and object-id"
                return 1
            val kind = args[1]
            val object_id = args[2]
            val pack_filter = if args.len() >= 4: args[3] else: ""
            val data = scv_pack_read_object(root, pack_filter, object_id)
            if data.len() == 0:
                print "ERROR pack-read-object not found: {object_id}"
                return 1
            rt_stdout_write_text(scv_pack_bytes_to_text(data))
            return 0
        case "private-sync":
            if args.len() < 2:
                print "ERROR private-sync requires an output directory"
                return 1
            return scv_cli_result(scv_private_sync(root, args[1]))
        case "private-sync-verify":
            if args.len() < 2:
                print "ERROR private-sync-verify requires an output directory"
                return 1
            return scv_cli_result(scv_private_sync_verify(args[1]))
        case "private-sync-import":
            if args.len() < 2:
                print "ERROR private-sync-import requires an output directory"
                return 1
            return scv_cli_result(scv_private_sync_import(root, args[1]))
        case "public-export":
            if args.len() < 2:
                print "ERROR public-export requires an output directory"
                return 1
            val branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_public_export(root, args[1], branch))
        case "public-export-verify":
            if args.len() < 2:
                print "ERROR public-export-verify requires an output directory"
                return 1
            return scv_cli_result(scv_public_export_verify(args[1]))
        case "public-push":
            if args.len() < 2:
                print "ERROR public-push requires a remote directory"
                return 1
            val branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_public_push(root, args[1], branch))
        case "public-push-verify":
            if args.len() < 2:
                print "ERROR public-push-verify requires a remote directory"
                return 1
            val branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_public_push_verify(args[1], branch))
        case "public-pull":
            if args.len() < 2:
                print "ERROR public-pull requires a remote directory"
                return 1
            val branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_public_pull(root, args[1], branch))
        case "gc-dry-run":
            return scv_cli_result(scv_gc_dry_run(root))
        case "gc-prune":
            return scv_cli_result(scv_gc_prune(root))
        case "gc":
            # MIG-21: dry run by default; --prune --checkpoint <id> to quarantine
            return scv_cli_verdict(scv_gc_command(root, args))
        case "recover":
            # MIG-22: staged recovery levels 0..5
            return scv_cli_verdict(scv_recover(root, args))
        case "merge-commits":
            if args.len() < 4:
                print "ERROR merge-commits requires base, left, and right commits"
                return 1
            return scv_cli_result(scv_merge_commits(root, args[1], args[2], args[3]))
        case "conflicts":
            return scv_cli_result(scv_conflicts(root))
        case "resolve-conflict":
            if args.len() < 2:
                print "ERROR resolve-conflict requires a conflict id"
                return 1
            return scv_cli_result(scv_resolve_conflict(root, args[1]))
        case "bookmarks":
            return scv_cli_result(scv_bookmarks(root))
        case "bookmark-set":
            if args.len() < 2:
                print "ERROR bookmark-set requires a name"
                return 1
            val commit = if args.len() >= 3: args[2] else: ""
            return scv_cli_result(scv_bookmark_set(root, args[1], commit))
        case "network-push":
            if args.len() < 3:
                print "ERROR network-push requires a base URL and remote directory"
                return 1
            var net_push_branch = "main"
            var net_push_chunk = 0
            var net_push_i = 3
            while net_push_i < args.len():
                val net_push_arg = args[net_push_i]
                if net_push_arg.starts_with("--chunk-bytes="):
                    net_push_chunk = net_push_arg[14:].to_i64() ?? 0
                elif not net_push_arg.starts_with("--"):
                    net_push_branch = net_push_arg
                net_push_i = net_push_i + 1
            if net_push_chunk > 0:
                return scv_cli_result(scv_network_push_chunked(args[1], args[2], net_push_branch, net_push_chunk))
            return scv_cli_result(scv_network_push(args[1], args[2], net_push_branch))
        case "network-push-verify":
            if args.len() < 2:
                print "ERROR network-push-verify requires a remote directory"
                return 1
            val branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_network_push_verify(args[1], branch))
        case "network-push-cas":
            if args.len() < 5:
                print "ERROR network-push-cas requires base URL, remote directory, branch, and old-etag"
                return 1
            return scv_cli_result(scv_network_push_cas(args[1], args[2], args[3], args[4]))
        case "network-pull":
            if args.len() < 3:
                print "ERROR network-pull requires a base URL and remote directory"
                return 1
            val branch = if args.len() >= 4: args[3] else: "main"
            return scv_cli_result(scv_network_pull(args[1], args[2], branch))
        case "network-pull-simulate-interrupt":
            if args.len() < 3:
                print "ERROR network-pull-simulate-interrupt requires a base URL and remote directory"
                return 1
            val nps_branch = if args.len() >= 4: args[3] else: "main"
            return scv_cli_result(scv_network_pull_simulate_interrupt(args[1], args[2], nps_branch))
        case "network-pull-discard":
            if args.len() < 2:
                print "ERROR network-pull-discard requires a remote directory"
                return 1
            val npd_branch = if args.len() >= 3: args[2] else: "main"
            return scv_cli_result(scv_network_pull_discard(args[1], npd_branch))
        case "network-config":
            if args.len() < 2:
                print "ERROR network-config requires a subcommand"
                return 1
            if args[1] == "set-auth":
                if args.len() < 3:
                    print "ERROR network-config set-auth requires an auth kind"
                    return 1
                val kind = args[2]
                if kind == "token":
                    var header_name = "Authorization"
                    var token_val = ""
                    var nc_i = 3
                    while nc_i < args.len():
                        val nc_arg = args[nc_i]
                        if nc_arg.starts_with("--header="):
                            header_name = nc_arg[9:]
                        elif nc_arg.starts_with("--token="):
                            token_val = nc_arg[8:]
                        nc_i = nc_i + 1
                    return scv_cli_result(scv_network_config_set_auth(kind, header_name, token_val))
                print "ERROR network-config set-auth unknown kind: {kind}"
                return 1
            if args[1] == "set-tls-no-verify":
                var base_url_nc = ""
                var nc2_i = 2
                while nc2_i < args.len():
                    val nc2_arg = args[nc2_i]
                    if nc2_arg.starts_with("--base-url="):
                        base_url_nc = nc2_arg[11:]
                    nc2_i = nc2_i + 1
                if base_url_nc == "":
                    print "ERROR network-config set-tls-no-verify requires --base-url="
                    return 1
                return scv_cli_result(scv_network_config_set_tls_no_verify(base_url_nc))
            print "ERROR network-config unknown subcommand: {args[1]}"
            return 1
        case "new-change":
            return scv_cli_result(scv_new_change(root))
        case "close-change":
            return scv_cli_result(scv_close_change(root))
        case "checkpoint":
            if args.len() >= 2 and args[1] == "verify":
                if args.len() < 3:
                    print "ERROR checkpoint verify requires a checkpoint id"
                    return 1
                return scv_cli_verdict(scv_checkpoint_verify(root, args[2]))
            if args.len() >= 2 and args[1] == "list":
                return scv_cli_result(scv_checkpoint_list(root))
            return scv_cli_result(scv_checkpoint(root))
        case "doctor":
            return scv_cli_verdict(scv_doctor(root))
        case "rebuild-db":
            return scv_cli_verdict(scv_rebuild_db(root))
        case "verify-backends":
            var vb_git = ""
            var vb_rev = "HEAD"
            var vb_i = 1
            while vb_i < args.len():
                if args[vb_i] == "--git" and vb_i + 1 < args.len():
                    vb_git = args[vb_i + 1]
                    vb_i = vb_i + 2
                elif args[vb_i] == "--rev" and vb_i + 1 < args.len():
                    vb_rev = args[vb_i + 1]
                    vb_i = vb_i + 2
                else:
                    vb_i = vb_i + 1
            if vb_git == "":
                print "ERROR verify-backends requires --git <path>"
                return 1
            return scv_cli_verdict(scv_verify_backends_git(root, vb_git, vb_rev))
        case "tag-list":
            return scv_cli_result(scv_tag_list(root))
        case "tag-set":
            if args.len() < 3:
                print "ERROR tag-set requires a name and commit"
                return 1
            return scv_cli_result(scv_tag_set(root, args[1], args[2]))
        case "backend":
            if args.len() < 2:
                print "ERROR backend requires a subcommand: status|map|verify"
                return 1
            var be_git = ""
            var be_rev = "HEAD"
            var be_i = 2
            while be_i < args.len():
                if args[be_i] == "--git" and be_i + 1 < args.len():
                    be_git = args[be_i + 1]
                    be_i = be_i + 2
                elif args[be_i] == "--rev" and be_i + 1 < args.len():
                    be_rev = args[be_i + 1]
                    be_i = be_i + 2
                else:
                    be_i = be_i + 1
            if be_git == "":
                print "ERROR backend {args[1]} requires --git <path>"
                return 1
            if args[1] == "status":
                return scv_cli_verdict(scv_backend_status(root, be_git))
            if args[1] == "map":
                return scv_cli_verdict(scv_backend_map(root, be_git, be_rev))
            if args[1] == "verify":
                return scv_cli_verdict(scv_backend_verify(root, be_git, be_rev))
            print "ERROR backend requires a subcommand: status|map|verify"
            return 1
        case "promote-verify":
            var pv_git = ""
            var pv_rev = "HEAD"
            var pv_i = 1
            while pv_i < args.len():
                if args[pv_i] == "--git" and pv_i + 1 < args.len():
                    pv_git = args[pv_i + 1]
                    pv_i = pv_i + 2
                elif args[pv_i] == "--rev" and pv_i + 1 < args.len():
                    pv_rev = args[pv_i + 1]
                    pv_i = pv_i + 2
                else:
                    pv_i = pv_i + 1
            if pv_git == "":
                print "ERROR promote-verify requires --git <path>"
                return 1
            return scv_cli_verdict(scv_promote_verify(root, pv_git, pv_rev))
        case "shadow-sync":
            var ss_dest = ""
            var ss_i = 1
            while ss_i < args.len():
                if args[ss_i] == "--dest" and ss_i + 1 < args.len():
                    ss_dest = args[ss_i + 1]
                    ss_i = ss_i + 2
                else:
                    ss_i = ss_i + 1
            if ss_dest == "":
                print "ERROR shadow-sync requires --dest <dir>"
                return 1
            return scv_cli_verdict(scv_shadow_sync(root, ss_dest))
        case "event-record":
            if args.len() < 4:
                print "ERROR event-record requires batch id, kind, and path"
                return 1
            val ev_related = if args.len() >= 5: args[4] else: ""
            if scv_event_batch_record(root, args[1], args[2], args[3], ev_related):
                print "recorded batch={args[1]}"
                return 0
            print "ERROR event-record failed for batch {args[1]}"
            return 1
        case "event-commit":
            if args.len() < 2:
                print "ERROR event-commit requires a batch id"
                return 1
            if scv_event_batch_commit(root, args[1]):
                print "committed batch={args[1]}"
                return 0
            print "ERROR event-commit failed for batch {args[1]} (no pending batch)"
            return 1
        case "event-replay":
            print "replayed {scv_event_batch_replay(root)}"
            return 0
        case "events":
            return scv_cli_result(scv_event_log(root))
        case "cst-store":
            # SCV-IMPL-D-01 completion: store the working-copy file's CST in
            # the P-05 root store keyed by (current revision, ContentId).
            if args.len() < 2:
                print "ERROR cst-store requires a path"
                return 1
            return scv_cli_result(scv_cst_store_file(root, args[1]))
        case "identity":
            # SCV-IMPL-I-06: identity corrections as logged operations.
            if args.len() < 2:
                print "ERROR identity requires a subcommand: link|unlink|split|merge|trace"
                return 1
            if args[1] == "link":
                if args.len() < 4:
                    print "ERROR identity link requires <file_id> <path>"
                    return 1
                return scv_cli_verdict(scv_identity_correct_link(root, args[2], args[3], if args.len() >= 5: args[4] else: ""))
            if args[1] == "unlink":
                if args.len() < 3:
                    print "ERROR identity unlink requires <path>"
                    return 1
                return scv_cli_verdict(scv_identity_correct_unlink(root, args[2], if args.len() >= 4: args[3] else: ""))
            if args[1] == "split":
                if args.len() < 5:
                    print "ERROR identity split requires <file_id> <path_a> <path_b>"
                    return 1
                return scv_cli_verdict(scv_identity_correct_split(root, args[2], args[3], args[4], if args.len() >= 6: args[5] else: ""))
            if args[1] == "merge":
                if args.len() < 4:
                    print "ERROR identity merge requires <id_keep> <id_lose>"
                    return 1
                return scv_cli_verdict(scv_identity_correct_merge(root, args[2], args[3], if args.len() >= 5: args[4] else: ""))
            if args[1] == "trace":
                if args.len() < 3:
                    print "ERROR identity trace requires <file_id>"
                    return 1
                return scv_cli_verdict(scv_identity_correct_trace(root, args[2]))
            print "ERROR identity unknown subcommand: {args[1]}"
            return 1
        case "shadow-write":
            # SCV-IMPL-B-05: continuous native shadow write on the commit path.
            if args.len() < 2:
                print "ERROR shadow-write requires a subcommand: enable|sync|status"
                return 1
            if args[1] == "enable":
                var sw_dest = ""
                var sw_git = ""
                var sw_i = 2
                while sw_i < args.len():
                    if args[sw_i] == "--dest" and sw_i + 1 < args.len():
                        sw_dest = args[sw_i + 1]
                        sw_i = sw_i + 2
                    elif args[sw_i] == "--git" and sw_i + 1 < args.len():
                        sw_git = args[sw_i + 1]
                        sw_i = sw_i + 2
                    else:
                        sw_i = sw_i + 1
                return scv_cli_verdict(scv_shadow_write_enable(root, sw_dest, sw_git))
            if args[1] == "sync":
                return scv_cli_verdict(scv_shadow_write_sync(root))
            if args[1] == "status":
                return scv_cli_verdict(scv_shadow_write_status(root))
            print "ERROR shadow-write unknown subcommand: {args[1]}"
            return 1
        case _:
            print scv_help()
            return 1
