# User-facing SCV host-capture command adapter. Mutating operations remain
# fail-closed until the filesystem owner exposes descriptor-relative writes.

use std.scv.verified_host_operations_v1.{
    ScvHostOperationReceiptV1, scv_host_capture_read_v1,
    scv_host_copy_v1, scv_host_move_v1, scv_host_delete_v1
}

fn _scv_host_output_escape_v1(value: text) -> text:
    value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", "\\r").replace("\t", "\\t").replace("\n", "\\n")

fn _scv_host_receipt_text_v1(receipt: ScvHostOperationReceiptV1) -> text:
    "status: \"{_scv_host_output_escape_v1(receipt.status)}\"\noperation: \"{_scv_host_output_escape_v1(receipt.op_id)}\"\nkind: \"{_scv_host_output_escape_v1(receipt.kind)}\"\nsource: \"{_scv_host_output_escape_v1(receipt.source)}\"\ndestination: \"{_scv_host_output_escape_v1(receipt.destination)}\"\nobject_id: \"{_scv_host_output_escape_v1(receipt.object_id)}\"\nbefore_sha256: \"{_scv_host_output_escape_v1(receipt.before_sha256)}\"\nafter_sha256: \"{_scv_host_output_escape_v1(receipt.after_sha256)}\"\nbytes: {receipt.byte_count}\narchive: \"{_scv_host_output_escape_v1(receipt.archive_path)}\"\ndetail: \"{_scv_host_output_escape_v1(receipt.detail)}\"\ndurability_claim: false\njournal_claim: false\n"

fn _scv_host_usage_v1() -> text:
    "status: \"failed\"\nusage: \"host-capture <path-relative-to-workspace> | host-copy <op-id> <source-relative-path> <destination-relative-path> | host-move <op-id> <source-relative-path> <destination-relative-path> | host-delete <op-id> <path-relative-to-workspace>\"\n"

fn scv_host_capture_command_v1(root: text, args: [text]) -> text:
    if args.len() == 2 and args[0] == "host-capture":
        return _scv_host_receipt_text_v1(scv_host_capture_read_v1(root, args[1]))
    if args.len() == 4 and args[0] == "host-copy":
        return _scv_host_receipt_text_v1(scv_host_copy_v1(root, args[1], args[2], args[3]))
    if args.len() == 4 and args[0] == "host-move":
        return _scv_host_receipt_text_v1(scv_host_move_v1(root, args[1], args[2], args[3]))
    if args.len() == 3 and args[0] == "host-delete":
        return _scv_host_receipt_text_v1(scv_host_delete_v1(root, args[1], args[2]))
    _scv_host_usage_v1()

export scv_host_capture_command_v1
