# Read-only presentation of evaluator-owned qualifications.
use std.common.traceability.evidence_model.{TraceQualification}
use std.common.traceability.obligations.{trace_qualification_status_name, trace_test_kind_name}

fn slop_evidence_text(qualification: TraceQualification, selected_id: text) -> text:
    var result = "Run: " + qualification.run_id + "; snapshot: " + qualification.subject_id
    val completion = if qualification.complete: "; obligations complete" else: "; obligations incomplete"
    result = result + completion
    var found = false
    for obligation in qualification.results:
        if obligation.requirement_id == selected_id or obligation.criterion_id == selected_id:
            found = true
            result = result + "\n" + obligation.obligation_id + " [" + trace_test_kind_name(obligation.test_kind) + "]: " + trace_qualification_status_name(obligation.status)
            for reason in obligation.reasons:
                result = result + "\n  " + reason
            for observation_id in obligation.selected_observation_ids:
                result = result + "\n  Observation: " + observation_id
    if not found:
        result = result + "\nNo obligation result is mapped to this selection; navigate to a requirement or criterion"
    result
