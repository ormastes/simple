# Native widget layout and actual typed edges share framebuffer coordinates.
use app.slop.session.{SlopSession}
use common.ui.widget.{WidgetNode}
use common.ui.layout.{compute_layout, find_rect}
use common.ui.widget_draw_ir.{widget_tree_to_draw_ir_cpu}
use common.ui.draw_ir.{DrawIrComposition, DrawIrCommand, DrawEdge, DrawIrPoint, DrawIrStyleProp,
    draw_ir_batch, draw_ir_embedding_config, draw_ir_edge_command, draw_ir_text}
use std.common.traceability.model.{relation_name}

fn slop_native_composition(session: SlopSession, width: i32, height: i32) -> DrawIrComposition:
    val root = WidgetNode(id: session.prefix)
    var composition = widget_tree_to_draw_ir_cpu(root, width, height)
    val rectangles = compute_layout(root, 0, 0, width, height)
    var commands: [DrawIrCommand] = []
    for edge_index in 0..session.page.edges.len():
        val edge = session.page.edges[edge_index]
        var from_widget = ""
        var to_widget = ""
        for index in 0..session.page.nodes.len():
            val node = session.page.nodes[index]
            if node.id == edge.from_id:
                from_widget = "{session.prefix}.graph.{index}"
            if node.id == edge.to_id:
                to_widget = "{session.prefix}.graph.{index}"
        if val from_rect = find_rect(rectangles, from_widget):
            if val to_rect = find_rect(rectangles, to_widget):
                val source_x = from_rect.x + from_rect.w
                val source_y = from_rect.y + from_rect.h / 2
                val target_x = to_rect.x
                val target_y = to_rect.y + to_rect.h / 2
                val middle_x = (source_x + target_x) / 2
                val draw_edge = DrawEdge(id: "{session.prefix}.edge.{edge_index}",
                    source: from_widget, target: to_widget, routing: "orthogonal",
                    points: [DrawIrPoint(x: source_x, y: source_y),
                        DrawIrPoint(x: middle_x, y: source_y),
                        DrawIrPoint(x: middle_x, y: target_y),
                        DrawIrPoint(x: target_x, y: target_y)],
                    style: [DrawIrStyleProp(key: "stroke", value: "#79b8ff"),
                        DrawIrStyleProp(key: "stroke-width", value: "2")])
                commands.push(draw_ir_edge_command(draw_edge))
                commands.push(draw_ir_text("{session.prefix}.edge-label.{edge_index}",
                    middle_x, (source_y + target_y) / 2, relation_name(edge.relation), 4286167295u32))
    val embedding = draw_ir_embedding_config("main", session.prefix + ".edge-layer", 0, 0,
        width, height, 1, 1000, true)
    composition.batches.push(draw_ir_batch(session.prefix + ".edges", "cpu", embedding, commands))
    composition
