# Native host seam. CLI registration is owned by the central dispatch lane.
use std.common.traceability.model.{TraceGraph}
use app.slop.session.{SlopSession}

fn create_slop_viewer(graph: TraceGraph, session_id: text) -> Result<SlopSession, text>:
    if session_id == "":
        return Err("Slop requires a unique native session ID")
    if graph.subject.snapshot_id == "" or graph.generation_id == "":
        return Err("Slop requires a pinned graph snapshot and generation")
    Ok(SlopSession.new(graph, "slop." + session_id))
