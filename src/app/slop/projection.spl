# Native view projections. Semantic facts remain owned by traceability.
use std.common.traceability.model.{TraceNodeKind, TraceRelation, TraceQueryResult, node_kind_name, relation_name}
use common.ui.draw_ir.{DrawEdge, DrawIrPoint, DrawIrStyleProp}

struct SlopAlias:
    widget_id: text
    canonical_id: text
    parent_id: text
    label: text

struct SlopPosition:
    canonical_id: text
    phase: i64
    row_index: i64

fn slop_phase(kind: TraceNodeKind) -> i64:
    match kind:
        case TraceNodeKind.Feature: 0
        case TraceNodeKind.Requirement: 1
        case TraceNodeKind.AcceptanceCriterion: 2
        case TraceNodeKind.TestSuite: 3
        case TraceNodeKind.TestCase: 3
        case TraceNodeKind.ParameterizedCase: 3
        case TraceNodeKind.SourceFile: 4
        case TraceNodeKind.Symbol: 4
        case _: 5

fn slop_aliases(page: TraceQueryResult, prefix: text) -> [SlopAlias]:
    var aliases: [SlopAlias] = []
    var index: i64 = 0
    for node in page.nodes:
        aliases.push(SlopAlias(widget_id: "{prefix}.node.{index}", canonical_id: node.id,
            parent_id: "", label: node.title + " [" + node_kind_name(node.kind) + "]"))
        index = index + 1
    # Repeated appearances are aliases, never duplicate semantic nodes.
    for edge in page.edges:
        var parent = ""
        var child = ""
        if edge.relation == TraceRelation.Contains:
            parent = edge.from_id
            child = edge.to_id
        if edge.relation == TraceRelation.BelongsTo:
            parent = edge.to_id
            child = edge.from_id
        if parent != "" and child != parent:
            var parent_widget = ""
            for alias in aliases:
                if alias.canonical_id == parent and alias.parent_id == "":
                    parent_widget = alias.widget_id
            for node in page.nodes:
                if node.id == child and parent_widget != "":
                    aliases.push(SlopAlias(widget_id: "{prefix}.alias.{index}", canonical_id: node.id,
                        parent_id: parent_widget, label: node.title))
                    index = index + 1
    aliases

fn slop_positions(page: TraceQueryResult) -> [SlopPosition]:
    var positions: [SlopPosition] = []
    # Query owner provides stable ID order; retain it within each phase.
    for node in page.nodes:
        val phase = slop_phase(node.kind)
        var row_index: i64 = 0
        for position in positions:
            if position.phase == phase:
                row_index = row_index + 1
        positions.push(SlopPosition(canonical_id: node.id, phase: phase, row_index: row_index))
    positions

fn slop_draw_edges(page: TraceQueryResult) -> [DrawEdge]:
    val positions = slop_positions(page)
    var edges: [DrawEdge] = []
    for edge in page.edges:
        var source: SlopPosition? = nil
        var target: SlopPosition? = nil
        for position in positions:
            if position.canonical_id == edge.from_id:
                source = position
            if position.canonical_id == edge.to_id:
                target = position
        if val origin_position = source:
            if val dest = target:
                edges.push(DrawEdge(id: edge.id, source: edge.from_id, target: edge.to_id,
                    routing: "orthogonal", points: [
                        DrawIrPoint(x: (origin_position.phase * 200 + 180) as i32, y: (origin_position.row_index * 64 + 32) as i32),
                        DrawIrPoint(x: (dest.phase * 200) as i32, y: (dest.row_index * 64 + 32) as i32)],
                    style: [DrawIrStyleProp(key: "label", value: relation_name(edge.relation))]))
    edges

fn slop_scope_label(page: TraceQueryResult, graph_complete: bool) -> text:
    val page_state = if page.complete: "final page" else: "partial page"
    val graph_state = if graph_complete: "complete input" else: "INCOMPLETE INPUT"
    "Showing {page.nodes.len()} / {page.total_count}; {page_state}; {graph_state}"
