use std.common.traceability.model.{TraceGraph, TraceQueryResult, SourceSlice, relation_name, origin_kind_name}
use std.common.traceability.obligations.{trace_test_kind_name}
use app.slop.projection.{SlopAlias, slop_phase, slop_scope_label}
use common.ui.builder.{row, column, panel, text_widget, button, tree_widget, tree_node, scroll}
use common.ui.widget.{UITree, WidgetNode}

fn slop_alias_expanded(collapsed: [text], widget_id: text) -> bool:
    for item in collapsed:
        if item == widget_id:
            return false
    true

fn slop_tree_rows(aliases: [SlopAlias], collapsed: [text], parent_id: text, selected_id: text, focused_alias: text) -> [WidgetNode]:
    var rows: [WidgetNode] = []
    for alias in aliases:
        if alias.parent_id == parent_id:
            var children: [WidgetNode] = []
            if slop_alias_expanded(collapsed, alias.widget_id):
                children = slop_tree_rows(aliases, collapsed, alias.widget_id, selected_id, focused_alias)
            val focus_mark = if alias.widget_id == focused_alias: "[focus] " else: ""
            val selection_mark = if alias.canonical_id == selected_id: "[selected] " else: ""
            var node = tree_node(alias.widget_id, focus_mark + selection_mark + alias.label, children)
            node = node.set_prop("action", "slop.select:" + alias.widget_id)
            node = node.set_prop("canonical_id", alias.canonical_id)
            node = node.set_prop("selected", if alias.canonical_id == selected_id: "true" else: "false")
            node = node.set_prop("expanded", if slop_alias_expanded(collapsed, alias.widget_id): "true" else: "false")
            rows.push(node)
    rows

fn slop_build_tree(prefix: text, graph: TraceGraph, page: TraceQueryResult,
                   aliases: [SlopAlias], collapsed: [text], selected_id: text,
                   source: SourceSlice?, source_status: text, evidence_status: text,
                   focused_alias: text = "", event_status: text = "") -> UITree:
    var phases: [WidgetNode] = []
    val labels = ["Feature", "Requirement", "Acceptance criterion", "Test", "Implementation", "Supporting"]
    for phase in 0..6:
        var nodes: [WidgetNode] = []
        for index in 0..page.nodes.len():
            val item = page.nodes[index]
            if slop_phase(item.kind) == phase:
                var title = item.title
                for definition in graph.test_definitions:
                    if definition.node_id == item.id:
                        title = title + " [" + trace_test_kind_name(definition.kind) + ": " + definition.definition_id + "]"
                var node = button("{prefix}.graph.{index}", title, "slop.select:{prefix}.node.{index}")
                node = node.set_prop("canonical_id", item.id)
                node = node.set_prop("selected", if item.id == selected_id: "true" else: "false")
                nodes.push(node)
        phases.push(panel("{prefix}.phase.{phase}", labels[phase], nodes))
    var relations: [WidgetNode] = []
    for index in 0..page.edges.len():
        val edge = page.edges[index]
        relations.push(text_widget("{prefix}.relation.{index}", edge.from_id + " --" + relation_name(edge.relation) + "--> " + edge.to_id))
        for edge_origin in graph.edge_origins:
            if edge_origin.edge_id == edge.id:
                for origin in graph.origins:
                    if origin.id == edge_origin.origin_id:
                        relations.push(text_widget("{prefix}.origin.{index}.{relations.len()}",
                            origin_kind_name(origin.kind) + ": " + origin.owner_path + " " + origin.locator + " rule " + origin.rule_version))
    var details: [WidgetNode] = [
        text_widget(prefix + ".identity", "Selected: " + selected_id),
        text_widget(prefix + ".revision", "Snapshot: " + graph.subject.snapshot_id + " revision: " + graph.subject.revision_id),
        text_widget(prefix + ".evidence", evidence_status),
        text_widget(prefix + ".event.status", event_status),
        text_widget(prefix + ".source.status", source_status)]
    if val slice = source:
        details.push(text_widget(prefix + ".source.identity", "{slice.path}:{slice.start_line}-{slice.end_line} blob {slice.blob_id} snapshot {slice.snapshot_id}"))
        details.push(text_widget(prefix + ".source.content", slice.content))
    for index in 0..page.diagnostics.len():
        val diagnostic = page.diagnostics[index]
        details.push(text_widget("{prefix}.diagnostic.{index}", diagnostic.code + ": " + diagnostic.message))
    val navigation = tree_widget(prefix + ".tree", slop_tree_rows(aliases, collapsed, "", selected_id, focused_alias))
    val controls = row(prefix + ".controls", [button(prefix + ".forward", "Forward trace", "slop.forward"),
        button(prefix + ".reverse", "Reverse impact", "slop.reverse"),
        button(prefix + ".all", "All nodes", "slop.all"),
        button(prefix + ".next", "Next page", "slop.next")]).set_prop("height", "32")
    val graph_panel = panel(prefix + ".graph", "Trace layers", [controls, row(prefix + ".phases", phases).set_prop("flex", "70"),
        text_widget(prefix + ".canvas.status", "Edges show declared relations; phase adjacency is not a relation"),
        panel(prefix + ".relations", "Typed relations", relations).set_prop("flex", "25")]).set_prop("flex", "60")
    var root = column(prefix, [row(prefix + ".workspace", [scroll(prefix + ".navigation", 640, [navigation]).set_prop("flex", "22"),
        column(prefix + ".right", [graph_panel, panel(prefix + ".inspector", "Details and pinned source", details).set_prop("flex", "40")]).set_prop("flex", "78")]),
        text_widget(prefix + ".scope", slop_scope_label(page, graph.complete)).set_prop("height", "28")])
    root = root.set_prop("ui_tree_title", "Slop viewer")
    UITree.new(root)
