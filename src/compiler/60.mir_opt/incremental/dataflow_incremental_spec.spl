# Differential spec: incremental red/green dataflow == full from-scratch
# fixed point, on every mutated CFG (C5, semantic incremental build v2).
#
# THE invariant: a false miss is acceptable; a false hit is a miscompile. So
# every case runs BOTH solvers on the post-edit CFG and compares complete
# in/out state tables keyed by BlockKey digest.
#
# Problem used: forward "reaching labels" (union of block labels along paths)
# and backward "reachable labels" — both real monotone set lattices with
# canonical sorted-text states.
#
# Run: bin/simple test src/compiler/60.mir_opt/incremental/dataflow_incremental_spec.spl
# (bin/simple test = tree-walk interpreter engine)

use compiler.mir.mir_instructions.{
    MirBlock, MirTerminator, BlockId, MirOperand, MirOperandKind
}
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind}
use compiler.mir.incremental.block_key.{compute_block_keys, block_key_digest_for}
use compiler.mir_opt.incremental.dataflow.{
    DataflowProblem, DataflowResult, dataflow_solve, dataflow_solve_incremental
}

fn _op() -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), MirType(kind: MirTypeKind.I64)))

fn _blk(id: i64, label: text?, t: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId(id: id), label: label, instructions: [], terminator: t)

# ---- sorted-set-of-labels lattice over canonical text ("a,b,c") ----

fn set_join(a: text, b: text) -> text:
    var toks: [text] = []
    for t in a.split(","):
        if t != "" and (not toks.contains(t)):
            toks.push(t)
    for t in b.split(","):
        if t != "" and (not toks.contains(t)):
            toks.push(t)
    toks.sort()
    var out = ""
    var first = true
    for t in toks:
        if first:
            out = t
            first = false
        else:
            out = "{out},{t}"
    out

var _transfer_calls = 0

fn label_transfer(b: MirBlock, input: text) -> text:
    _transfer_calls = _transfer_calls + 1
    val l = b.label ?? ""
    if l == "":
        input
    else:
        set_join(input, l)

fn fwd_problem() -> DataflowProblem:
    DataflowProblem(name: "reaching_labels", forward: true, bottom: "",
                    boundary: "", join: set_join, transfer: label_transfer)

fn bwd_problem() -> DataflowProblem:
    DataflowProblem(name: "reachable_labels", forward: false, bottom: "",
                    boundary: "", join: set_join, transfer: label_transfer)

# ---- differential harness ----

fn results_equal(a: DataflowResult, b: DataflowResult) -> bool:
    """Full table equality keyed by BlockKey digest (order-independent)."""
    if a.key_digests.len() != b.key_digests.len():
        return false
    var i = 0
    while i < a.key_digests.len():
        var j = -1
        var k = 0
        while k < b.key_digests.len():
            if b.key_digests[k] == a.key_digests[i]:
                j = k
            k = k + 1
        if j < 0:
            return false
        if a.in_states[i] != b.in_states[j]:
            return false
        if a.out_states[i] != b.out_states[j]:
            return false
        i = i + 1
    true

fn check_differential(old_blocks: [MirBlock], old_entry: i64,
                      new_blocks: [MirBlock], new_entry: i64,
                      changed_ids: [i64], forward: bool) -> bool:
    var p = fwd_problem()
    if not forward:
        p = bwd_problem()
    val old_res = dataflow_solve(old_blocks, BlockId(id: old_entry), "m.f", p)
    # content-changed blocks are named by their NEW BlockKey digest
    val nkm = compute_block_keys("m.f", new_blocks, BlockId(id: new_entry))
    var changed_digests: [text] = []
    for cid in changed_ids:
        changed_digests.push(block_key_digest_for(nkm, cid))
    val full = dataflow_solve(new_blocks, BlockId(id: new_entry), "m.f", p)
    val incr = dataflow_solve_incremental(new_blocks, BlockId(id: new_entry),
                                          "m.f", p, old_res, changed_digests)
    results_equal(full, incr)

# base CFG: entry(0,"a") -> if -> then(1,"b") / else(2,"c") -> exit(3,"d"),
# plus a loop: exit -> if(4,"e") -> back to then(1) or ret(5,"z")
fn base_cfg() -> [MirBlock]:
    [
        _blk(0, "a", MirTerminator.If(cond: _op(), then_: BlockId(id: 1), else_: BlockId(id: 2))),
        _blk(1, "b", MirTerminator.Goto(target: BlockId(id: 3))),
        _blk(2, "c", MirTerminator.Goto(target: BlockId(id: 3))),
        _blk(3, "d", MirTerminator.If(cond: _op(), then_: BlockId(id: 4), else_: BlockId(id: 5))),
        _blk(4, "e", MirTerminator.Goto(target: BlockId(id: 1))),   # back edge
        _blk(5, "z", MirTerminator.Ret(value: nil))
    ]

describe "incremental dataflow == full fixed point (differential)":
    it "no-change edit that only renumbers BlockIds is all-green and equal":
        val old = base_cfg()
        # same CFG, every id shifted by 100
        val new = [
            _blk(100, "a", MirTerminator.If(cond: _op(), then_: BlockId(id: 101), else_: BlockId(id: 102))),
            _blk(101, "b", MirTerminator.Goto(target: BlockId(id: 103))),
            _blk(102, "c", MirTerminator.Goto(target: BlockId(id: 103))),
            _blk(103, "d", MirTerminator.If(cond: _op(), then_: BlockId(id: 104), else_: BlockId(id: 105))),
            _blk(104, "e", MirTerminator.Goto(target: BlockId(id: 101))),
            _blk(105, "z", MirTerminator.Ret(value: nil))
        ]
        assert_true(check_differential(old, 0, new, 100, [], true))
        assert_true(check_differential(old, 0, new, 100, [], false))

    it "label change inside the loop body (content change in an SCC)":
        var new = base_cfg()
        new[4] = _blk(4, "E2", MirTerminator.Goto(target: BlockId(id: 1)))
        assert_true(check_differential(base_cfg(), 0, new, 0, [4], true))
        assert_true(check_differential(base_cfg(), 0, new, 0, [4], false))

    it "label change on a linear block (downstream propagation)":
        var new = base_cfg()
        new[2] = _blk(2, "C2", MirTerminator.Goto(target: BlockId(id: 3)))
        assert_true(check_differential(base_cfg(), 0, new, 0, [2], true))
        assert_true(check_differential(base_cfg(), 0, new, 0, [2], false))

    it "edge retarget (succ contract change, no label change)":
        var new = base_cfg()
        # else arm now skips straight to the ret block
        new[2] = _blk(2, "c", MirTerminator.Goto(target: BlockId(id: 5)))
        assert_true(check_differential(base_cfg(), 0, new, 0, [], true))
        assert_true(check_differential(base_cfg(), 0, new, 0, [], false))

    it "block added on a path":
        var new = base_cfg()
        new[1] = _blk(1, "b", MirTerminator.Goto(target: BlockId(id: 6)))
        new.push(_blk(6, "w", MirTerminator.Goto(target: BlockId(id: 3))))
        assert_true(check_differential(base_cfg(), 0, new, 0, [], true))
        assert_true(check_differential(base_cfg(), 0, new, 0, [], false))

    it "block deleted (loop broken)":
        val new = [
            _blk(0, "a", MirTerminator.If(cond: _op(), then_: BlockId(id: 1), else_: BlockId(id: 2))),
            _blk(1, "b", MirTerminator.Goto(target: BlockId(id: 3))),
            _blk(2, "c", MirTerminator.Goto(target: BlockId(id: 3))),
            _blk(3, "d", MirTerminator.Goto(target: BlockId(id: 5))),
            _blk(5, "z", MirTerminator.Ret(value: nil))
        ]
        assert_true(check_differential(base_cfg(), 0, new, 0, [], true))
        assert_true(check_differential(base_cfg(), 0, new, 0, [], false))

    it "ambiguous correspondence (dangling edge) falls back and still equals full":
        var new = base_cfg()
        new[4] = _blk(4, "e", MirTerminator.Goto(target: BlockId(id: 42)))  # 42 missing
        val km = compute_block_keys("m.f", new, BlockId(id: 0))
        assert_true(km.ambiguous)
        assert_true(check_differential(base_cfg(), 0, new, 0, [], true))

    it "green cut: unchanged upstream states are reused verbatim":
        # change only the ret block's label; upstream blocks must restore old
        # states (verified indirectly: incremental == full, and full differs
        # from old only at/below the change)
        var new = base_cfg()
        new[5] = _blk(5, "Z2", MirTerminator.Ret(value: nil))
        val p = fwd_problem()
        val old_res = dataflow_solve(base_cfg(), BlockId(id: 0), "m.f", p)
        val nkm = compute_block_keys("m.f", new, BlockId(id: 0))
        val incr = dataflow_solve_incremental(new, BlockId(id: 0), "m.f", p,
            old_res, [block_key_digest_for(nkm, 5)])
        val full = dataflow_solve(new, BlockId(id: 0), "m.f", p)
        assert_true(results_equal(full, incr))
        # entry's out must be byte-identical to the OLD entry out (green reuse)
        # green must actually SKIP work: count transfer evaluations
        _transfer_calls = 0
        val full2 = dataflow_solve(new, BlockId(id: 0), "m.f", p)
        val full_calls = _transfer_calls
        _transfer_calls = 0
        val incr2 = dataflow_solve_incremental(new, BlockId(id: 0), "m.f", p,
            old_res, [block_key_digest_for(nkm, 5)])
        val incr_calls = _transfer_calls
        assert_true(incr_calls < full_calls)
        assert_true(results_equal(full2, incr2))
        val ed = block_key_digest_for(nkm, 0)
        var i = 0
        while i < old_res.key_digests.len():
            if old_res.key_digests[i] == ed:
                var j = 0
                while j < incr.key_digests.len():
                    if incr.key_digests[j] == ed:
                        assert_equal(incr.out_states[j], old_res.out_states[i])
                    j = j + 1
            i = i + 1
