# Bounds Check Elimination Skeleton
#
# Canonical dispatch classifies BCE as Disabled. No callable compatibility
# surface may remove a safety check until a dominance-scoped range proof owns
# operand versions, mutation invalidation, zero-trip behavior, and exceptions.

use compiler.mir.mir_instructions.{MirFunction, MirBlock}

class LoopBoundsProof:
    index_var_id: i64
    arr_local_id: i64
    proof_key: text

class ExplicitRangeProof:
    var_id: i64
    lower_bound: i64
    upper_bound: i64
    proof_key: text

class ConstantIndexProof:
    index_const: i64
    arr_local_id: i64
    proof_key: text

class BoundsCheckElimination:
    removed_checks: i64
    observed_checks: i64
    observed_geps: i64
    loop_proofs: [LoopBoundsProof]

impl BoundsCheckElimination:
    static fn new() -> BoundsCheckElimination:
        BoundsCheckElimination(
            removed_checks: 0,
            observed_checks: 0,
            observed_geps: 0,
            loop_proofs: []
        )

    fn name() -> text:
        "bounds_check_elimination"

    fn description() -> text:
        "BCE skeleton; requires dominance-scoped range and mutation proofs"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        ["loop_invariant_motion"]

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    me eliminate_in_block(block: MirBlock) -> MirBlock:
        # Compatibility entrypoint must not bypass Disabled status.
        block

    fn stats_summary() -> text:
        "BoundsCheckElim: removed {self.removed_checks} checks, observed {self.observed_checks} checks and {self.observed_geps} GEPs"

fn create_bounds_check_elim_pass() -> BoundsCheckElimination:
    BoundsCheckElimination.new()

fn bounds_check_elim_run_on_function(
    bce_pass: BoundsCheckElimination, func: MirFunction
) -> MirFunction:
    func
