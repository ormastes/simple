use compiler.mir.mir_instructions.{MirBlock, MirInst, MirInstKind, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_types.{LocalId, MirConstValue, MirType}
use compiler.interp.execution.tiered_jit.{
    JitVarOptimizationFacts,
    jit_var_optimization_fact_list,
    jit_var_optimization_facts
}

struct VarReassignAnalysis:
    has_var_reassignment: bool
    reassignment_count: i64
    ssa_transform_safe: bool
    escape_analyzed: bool
    no_escape: bool
    borrow_reassign_safe: bool
    reason: text

fn local_list_contains(locals: [i64], local_id: i64) -> bool:
    var i = 0
    while i < locals.len():
        if locals[i] == local_id:
            return true
        i = i + 1
    false

fn local_list_push_unique(locals: [i64], local_id: i64) -> [i64]:
    if local_list_contains(locals, local_id):
        locals
    else:
        locals.push(local_id)

fn local_count_index(local_ids: [i64], local_id: i64) -> i64:
    var i = 0
    while i < local_ids.len():
        if local_ids[i] == local_id:
            return i
        i = i + 1
    -1

fn var_reassign_local_id_value(local: LocalId) -> i64:
    match local:
        case LocalId(raw_id): raw_id
        case _: 0

fn local_count_increment(local_ids: [i64], counts: [i64], local_id: i64) -> ([i64], [i64]):
    val idx = local_count_index(local_ids, local_id)
    if idx < 0:
        (local_ids.push(local_id), counts.push(1))
    else:
        # Index-assign, never a push-rebuild loop: `.push()` clones the whole
        # array on every call (no uniqueness fast path), so rebuilding N
        # elements costs O(N^2) for ONE update. `arr[i] = v` does have that
        # fast path, making this O(N) worst case and O(1) when unshared.
        var updated = counts
        updated[idx] = counts[idx] + 1
        (local_ids, updated)

fn local_count_value(local_ids: [i64], counts: [i64], local_id: i64) -> i64:
    val idx = local_count_index(local_ids, local_id)
    if idx < 0:
        0
    else:
        counts[idx]

fn local_alias_root(aliases: Dict<i64, i64>, local_id: i64) -> i64:
    var root = local_id
    var guard = 0
    while guard < 64:
        if not aliases.contains_key(root):
            return root
        val next: i64 = aliases[root]
        if next == root:
            return root
        root = next
        guard = guard + 1
    root

fn local_alias_set(mut aliases: Dict<i64, i64>, local_id: i64, root_id: i64):
    aliases[local_id] = root_id

fn local_alias_reset(mut aliases: Dict<i64, i64>, local_id: i64):
    local_alias_set(aliases, local_id, local_id)

fn var_reassign_operand_local(operand: MirOperand) -> i64?:
    match operand.kind:
        case Copy(local):
            Some(var_reassign_local_id_value(local))
        case Move(local):
            Some(var_reassign_local_id_value(local))
        case Const(_, _):
            nil

fn var_reassign_collect_escape_operand_with_aliases(
    mut escaped: Dict<i64, bool>, operand: MirOperand,
    aliases: Dict<i64, i64>
):
    # Explicit match preserves local id 0; optional truthiness would lose it.
    match var_reassign_operand_local(operand):
        case Some(local_id):
            escaped[local_alias_root(aliases, local_id)] = true
        case nil:
            pass_do_nothing

fn var_reassign_written_local(inst: MirInst) -> i64?:
    match inst.kind:
        case Const(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case Copy(dest, _):
            Some(var_reassign_local_id_value(dest))
        case Move(dest, _):
            Some(var_reassign_local_id_value(dest))
        case BinOp(dest, _, _, _):
            Some(var_reassign_local_id_value(dest))
        case UnaryOp(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case CheckedBinOp(dest, _, _, _):
            Some(var_reassign_local_id_value(dest))
        case Alloc(dest, _):
            Some(var_reassign_local_id_value(dest))
        case Load(dest, _):
            Some(var_reassign_local_id_value(dest))
        case GetElementPtr(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case Aggregate(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case GetField(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case Cast(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case Bitcast(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case Call(dest, _, _):
            if dest.?:
                val call_dest = dest
                Some(var_reassign_local_id_value(call_dest))
            else:
                nil
        case CallIndirect(dest, _, _, _):
            if dest.?:
                val indirect_dest = dest
                Some(var_reassign_local_id_value(indirect_dest))
            else:
                nil
        case Intrinsic(dest, _, _):
            if dest.?:
                val intrinsic_dest = dest
                Some(var_reassign_local_id_value(intrinsic_dest))
            else:
                nil
        case Ref(dest, _, _):
            Some(var_reassign_local_id_value(dest))
        case _:
            nil

fn var_reassign_collect_inst_escapes_with_aliases(
    mut escaped: Dict<i64, bool>, inst: MirInst, aliases: Dict<i64, i64>
):
    match inst.kind:
        case Store(ptr, value):
            var_reassign_collect_escape_operand_with_aliases(escaped, ptr, aliases)
            var_reassign_collect_escape_operand_with_aliases(escaped, value, aliases)
        case SetField(base, _, value):
            var_reassign_collect_escape_operand_with_aliases(escaped, base, aliases)
            var_reassign_collect_escape_operand_with_aliases(escaped, value, aliases)
        case Call(_, func, args):
            var_reassign_collect_escape_operand_with_aliases(escaped, func, aliases)
            for arg in args:
                var_reassign_collect_escape_operand_with_aliases(escaped, arg, aliases)
        case CallIndirect(_, ptr, args, _):
            var_reassign_collect_escape_operand_with_aliases(escaped, ptr, aliases)
            for arg in args:
                var_reassign_collect_escape_operand_with_aliases(escaped, arg, aliases)
        case Intrinsic(_, _, args):
            for arg in args:
                var_reassign_collect_escape_operand_with_aliases(escaped, arg, aliases)
        case _:
            pass_do_nothing

fn var_reassign_collect_term_escapes_with_aliases(
    mut escaped: Dict<i64, bool>, term: MirTerminator,
    aliases: Dict<i64, i64>
):
    match term:
        case Ret(value):
            if value.?:
                val ret_value = value
                var_reassign_collect_escape_operand_with_aliases(escaped, ret_value, aliases)
        case If(cond, _, _):
            var_reassign_collect_escape_operand_with_aliases(escaped, cond, aliases)
        case Switch(value, _, _):
            var_reassign_collect_escape_operand_with_aliases(escaped, value, aliases)
        case CallTerminator(dest, func, args, _, _):
            if dest.?:
                val term_dest = dest
                escaped[local_alias_root(aliases, var_reassign_local_id_value(term_dest))] = true
            var_reassign_collect_escape_operand_with_aliases(escaped, func, aliases)
            for arg in args:
                var_reassign_collect_escape_operand_with_aliases(escaped, arg, aliases)
        case _:
            pass_do_nothing

fn var_reassign_update_aliases_for_inst(
    inst: MirInst, mut aliases: Dict<i64, i64>
):
    match inst.kind:
        case Copy(dest, src):
            local_alias_set(
                aliases, var_reassign_local_id_value(dest),
                local_alias_root(aliases, var_reassign_local_id_value(src)))
        case Move(dest, src):
            local_alias_set(
                aliases, var_reassign_local_id_value(dest),
                local_alias_root(aliases, var_reassign_local_id_value(src)))
        case Ref(dest, _, place):
            local_alias_set(
                aliases, var_reassign_local_id_value(dest),
                local_alias_root(aliases, var_reassign_local_id_value(place.local)))
        case _:
            # NOTE: explicit match, not `if written.?:` -- local id 0
            # landmine, see var_reassign_collect_escape_operand above.
            match var_reassign_written_local(inst):
                case Some(written_id):
                    local_alias_reset(aliases, written_id)
                case nil:
                    pass_do_nothing

fn analyze_var_reassign_blocks(blocks: [MirBlock]) -> VarReassignAnalysis:
    var counts: Dict<i64, i64> = {}
    var borrowed: Dict<i64, bool> = {}
    var escaped: Dict<i64, bool> = {}
    var borrow_safe = true
    var aliases: Dict<i64, i64> = {}

    for block in blocks:
        for inst in block.instructions:
            # NOTE: explicit match, not `if written.?:` -- local id 0
            # landmine, see var_reassign_collect_escape_operand above. This
            # is the core reassignment-count / borrow-safety scan: missing
            # local 0 here would silently under-count its reassignments and
            # could report ssa_transform_safe=true for an unsafe transform.
            match var_reassign_written_local(inst):
                case Some(local_id):
                    val local_root = local_alias_root(aliases, local_id)
                    var prior_count: i64 = 0
                    if counts.contains_key(local_id):
                        prior_count = counts[local_id]
                    if prior_count > 0 and (
                        borrowed.contains_key(local_id) or
                        borrowed.contains_key(local_root)
                    ):
                        borrow_safe = false
                    counts[local_id] = prior_count + 1
                case nil:
                    pass_do_nothing
            match inst.kind:
                case Ref(_, _, place):
                    val borrowed_root = local_alias_root(
                        aliases, var_reassign_local_id_value(place.local))
                    borrowed[borrowed_root] = true
                case _:
                    pass_do_nothing
            var_reassign_collect_inst_escapes_with_aliases(escaped, inst, aliases)
            var_reassign_update_aliases_for_inst(inst, aliases)
        var_reassign_collect_term_escapes_with_aliases(escaped, block.terminator, aliases)

    var reassignment_count = 0
    var no_escape = true
    for local_id in counts.keys():
        val count: i64 = counts[local_id]
        if count > 1:
            reassignment_count = reassignment_count + (count - 1)
            if escaped.contains_key(local_id):
                no_escape = false

    val has_reassignment = reassignment_count > 0
    val ssa_safe = (not has_reassignment) or (borrow_safe and no_escape)
    val reason = if not borrow_safe:
        "borrow.reassign_unsafe"
    elif not no_escape:
        "escape.reassigned_storage"
    else:
        "ready"
    VarReassignAnalysis(
        has_var_reassignment: has_reassignment,
        reassignment_count: reassignment_count,
        ssa_transform_safe: ssa_safe,
        escape_analyzed: true,
        no_escape: no_escape,
        borrow_reassign_safe: borrow_safe,
        reason: reason
    )

fn var_reassign_analysis_to_jit_facts(analysis: VarReassignAnalysis) -> JitVarOptimizationFacts:
    jit_var_optimization_facts(
        analysis.has_var_reassignment,
        analysis.reassignment_count,
        analysis.ssa_transform_safe,
        analysis.escape_analyzed,
        analysis.no_escape,
        analysis.borrow_reassign_safe
    )

fn var_reassign_analysis_hotspot_facts(base_facts: [text], analysis: VarReassignAnalysis) -> [text]:
    var facts = base_facts
    val jit_facts = var_reassign_analysis_to_jit_facts(analysis)
    for fact in jit_var_optimization_fact_list(jit_facts):
        if not facts.contains(fact):
            facts = facts.push(fact)
    facts
