# Copy Propagation Skeleton
#
# Canonical dispatch classifies copy propagation as Skeleton. Rewriting uses
# requires complete operand coverage, dominance/redefinition facts, and exact
# ownership semantics distinguishing Copy from consuming Move. Keep every
# callable transform surface inert until those proofs and differential
# witnesses exist.

use compiler.mir.mir_data.{LocalId}
use compiler.mir.mir_instructions.{MirFunction}

class CopyChain:
    # Compatibility state only. A Skeleton never populates or follows it.
    copy_map: Dict<i64, LocalId>

class CopyPropagation:
    copy_chain: CopyChain
    propagated_uses: i64
    eliminated_copies: i64

fn create_copy_prop_pass() -> CopyPropagation:
    CopyPropagation(
        copy_chain: CopyChain(copy_map: {}),
        propagated_uses: 0,
        eliminated_copies: 0)

fn copypropagation_run_on_function(
    copy_pass: CopyPropagation, func: MirFunction
) -> MirFunction:
    func
