# Loop-Invariant Code Motion Skeleton
#
# LICM is Disabled. A future transform requires a canonical preheader,
# dominance, memory/effect versions, speculatability, and zero-trip safety.

use compiler.mir.mir_instructions.{MirFunction, MirBlock}
use compiler.mir_opt.mir_opt.loop_detect.{LoopInfo}

class LoopInvariantMotion:
    hoisted_count: i64

impl LoopInvariantMotion:
    static fn new() -> LoopInvariantMotion:
        LoopInvariantMotion(hoisted_count: 0)

    me optimize_function(func: MirFunction) -> MirFunction:
        func

    me hoist_invariants(
        blocks: [MirBlock], the_loop: LoopInfo
    ) -> [MirBlock]:
        # Compatibility entrypoint must not bypass Disabled status.
        blocks

    fn stats_summary() -> text:
        "LICM: hoisted {self.hoisted_count} instructions"
