# Global Value Numbering Skeleton
#
# Canonical dispatch classifies GVN as Skeleton. Cross-block reuse requires a
# real dominator traversal plus memory versions, alias/effect invalidation, and
# trapping-expression semantics. MIR storage order is never a dominance proof.

use compiler.mir.mir_instructions.{MirFunction}

class GlobalValueNumbering:
    eliminated_expressions: i64
    analyzed_functions: i64

impl GlobalValueNumbering:
    static fn new() -> GlobalValueNumbering:
        GlobalValueNumbering(
            eliminated_expressions: 0,
            analyzed_functions: 0
        )

    fn name() -> text:
        "global_value_numbering"

    fn description() -> text:
        "GVN skeleton; requires dominance and memory-version proofs"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        ["constant_folding"]

    me run_on_function(func: MirFunction) -> MirFunction:
        # Compatibility entrypoint must not bypass structural Skeleton status.
        func

    fn stats_summary() -> text:
        "GVN: eliminated {self.eliminated_expressions} redundant expressions in {self.analyzed_functions} functions"

fn create_gvn_pass() -> GlobalValueNumbering:
    GlobalValueNumbering.new()

fn gvn_run_on_function(
    gvn_pass: GlobalValueNumbering, func: MirFunction
) -> MirFunction:
    func
