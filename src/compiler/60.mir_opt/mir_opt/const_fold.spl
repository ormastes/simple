# Constant Folding Skeleton
#
# Folding is inactive until a typed evaluator proves exact width, signedness,
# overflow, division/remainder, shift, floating-point, and trap semantics.
# Every callable compatibility surface fails closed while registry status is
# Skeleton; direct methods must not bypass pass admission or verification.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction, MirBlock}

class ConstantEvaluator:
    evaluations: i64

impl ConstantEvaluator:
    static fn new() -> ConstantEvaluator:
        ConstantEvaluator(evaluations: 0)

    me try_fold_binop(
        op: MirBinOp, left: MirConstValue, right: MirConstValue
    ) -> MirConstValue?:
        nil

    me try_fold_unaryop(
        op: MirUnaryOp, operand: MirConstValue
    ) -> MirConstValue?:
        nil

class AlgebraicSimplifier:
    simplifications: i64

impl AlgebraicSimplifier:
    static fn new() -> AlgebraicSimplifier:
        AlgebraicSimplifier(simplifications: 0)

    me try_simplify_binop(
        op: MirBinOp, left: MirOperand, right: MirOperand
    ) -> MirOperand?:
        nil

class ConstantFolding:
    evaluator: ConstantEvaluator
    simplifier: AlgebraicSimplifier
    folded_instructions: i64
    folded_branches: i64

impl ConstantFolding:
    static fn new() -> ConstantFolding:
        ConstantFolding(
            evaluator: ConstantEvaluator.new(),
            simplifier: AlgebraicSimplifier.new(),
            folded_instructions: 0,
            folded_branches: 0)

    fn name() -> text:
        "constant_folding"

    fn description() -> text:
        "Typed constant folding transformation skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        []

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    me fold_block(block: MirBlock) -> MirBlock:
        block

    me try_fold_instruction(inst: MirInst) -> MirInst:
        inst

    me try_fold_terminator(term: MirTerminator) -> MirTerminator:
        term

    fn stats_summary() -> text:
        "ConstFold: folded {self.folded_instructions} instructions, {self.folded_branches} branches"

fn create_const_fold_pass() -> ConstantFolding:
    ConstantFolding.new()

fn cf_run_on_function(
    fold_pass: ConstantFolding, func: MirFunction
) -> MirFunction:
    func
