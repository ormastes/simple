# Common Subexpression Elimination Skeleton
#
# Canonical dispatch classifies local CSE as Skeleton. Reuse needs exact value
# semantics, ownership-safe Copy/Move handling, definition kills, trap rules,
# and memory versions for loads, fields, stores, and calls. Keep all callable
# pass surfaces inert until those proofs and differential witnesses exist.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction}

enum Expression:
    # Compatibility representation only. It does not authorize rewriting.
    BinOp(op: MirBinOp, left: LocalId, right: LocalId)
    UnaryOp(op: MirUnaryOp, operand: LocalId)
    Load(ptr: LocalId)
    GetField(base: LocalId, field: i64)
    ConstInt(value: i64)
    ConstFloat(value: f64)
    ConstBool(value: bool)

impl Expression:
    fn to_key() -> text:
        match self:
            case BinOp(op, left, right): "binop_{op}_{left.id}_{right.id}"
            case UnaryOp(op, operand): "unary_{op}_{operand.id}"
            case Load(ptr): "load_{ptr.id}"
            case GetField(base, field): "getfield_{base.id}_{field}"
            case ConstInt(value): "const_int_{value}"
            case ConstFloat(value): "const_float_{value}"
            case ConstBool(value): "const_bool_{value}"

    fn is_pure() -> bool:
        # Fail closed: purity is a typed effect/trap fact, not an enum guess.
        false

class ExpressionTable:
    table: Dict<text, LocalId>
    eliminated: i64

impl ExpressionTable:
    static fn new() -> ExpressionTable:
        ExpressionTable(table: {}, eliminated: 0)

    fn lookup(expr: Expression) -> LocalId?:
        # Compatibility-only surface. A Skeleton cannot supply reuse leaders.
        nil

    me insert(expr: Expression, local: LocalId):
        pass_do_nothing

    me clear():
        self.table = {}

    fn size() -> i64:
        0

class CommonSubexprElimination:
    expr_table: ExpressionTable
    eliminated_count: i64
    reused_count: i64

impl CommonSubexprElimination:
    static fn new() -> CommonSubexprElimination:
        CommonSubexprElimination(
            expr_table: ExpressionTable.new(),
            eliminated_count: 0,
            reused_count: 0)

    fn name() -> text:
        "common_subexpr_elim"

    fn description() -> text:
        "Common subexpression elimination skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        ["copy_propagation"]

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    fn stats_summary() -> text:
        "CSE: eliminated {self.eliminated_count} redundant computations, reused {self.reused_count} values"

fn create_cse_pass() -> CommonSubexprElimination:
    CommonSubexprElimination.new()

fn cse_run_on_function(
    cse_pass: CommonSubexprElimination, func: MirFunction
) -> MirFunction:
    func
