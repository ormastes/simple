# Generator State-Machine Analysis Skeleton
#
# Yield discovery remains available as analysis. State-machine rewriting is a
# Skeleton until liveness, frame layout, ownership, suspension, unwind, ABI,
# and runtime protocol semantics are fully proved.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction}

struct YieldPoint:
    id: i64
    block_id: BlockId
    inst_index: i64
    yielded_operand: MirOperand?
    live_locals: [LocalId]

struct YieldAnalysis:
    yield_points: [YieldPoint]
    total_states: i64
    all_live_locals: [LocalId]

fn analyze_yields(func: MirFunction) -> YieldAnalysis:
    """Collect conservative storage-order yield facts in one definition walk.

    This is analysis scaffolding, not transformation authority. Named variables
    and arguments defined before a yield are conservatively retained.
    """
    var defined: Dict<i64, bool> = {}
    for local in func.locals:
        match local.kind:
            case Arg(_): defined[local.id.id] = true
            case _: pass_do_nothing

    var points: [YieldPoint] = []
    var all_live_set: Dict<i64, bool> = {}
    var next_id = 0
    for block in func.blocks:
        var inst_index = 0
        for inst in block.instructions:
            match inst.kind:
                case Yield(value):
                    var live: [LocalId] = []
                    for local in func.locals:
                        if defined.contains_key(local.id.id)
                            and generator_local_is_frame_candidate(local):
                            live.push(local.id)
                            all_live_set[local.id.id] = true
                    points.push(YieldPoint(
                        id: next_id, block_id: block.id,
                        inst_index: inst_index, yielded_operand: value,
                        live_locals: live))
                    next_id = next_id + 1
                case _:
                    val dest = generator_inst_dest(inst)
                    match dest:
                        case Some(local): defined[local.id] = true
                        case nil: pass_do_nothing
            inst_index = inst_index + 1

    if points.len() == 0:
        return YieldAnalysis(
            yield_points: [], total_states: 0, all_live_locals: [])

    var all_live: [LocalId] = []
    for local in func.locals:
        if all_live_set.contains_key(local.id.id): all_live.push(local.id)
    YieldAnalysis(
        yield_points: points,
        total_states: points.len() + 2,
        all_live_locals: all_live)

fn generator_local_is_frame_candidate(local: MirLocal) -> bool:
    match local.kind:
        case Arg(_): true
        case Var: true
        case _: local.name.?

fn generator_inst_dest(inst: MirInst) -> LocalId?:
    match inst.kind:
        case Const(dest, _, _): Some(dest)
        case Copy(dest, _): Some(dest)
        case Move(dest, _): Some(dest)
        case BinOp(dest, _, _, _): Some(dest)
        case UnaryOp(dest, _, _): Some(dest)
        case Alloc(dest, _): Some(dest)
        case Load(dest, _): Some(dest)
        case GetField(dest, _, _): Some(dest)
        case Aggregate(dest, _, _): Some(dest)
        case Cast(dest, _, _): Some(dest)
        case Call(dest, _, _): dest
        case _: nil

fn has_yields(func: MirFunction) -> bool:
    for block in func.blocks:
        for inst in block.instructions:
            match inst.kind:
                case Yield(_): return true
                case _: pass_do_nothing
    false

class GeneratorStateMachine:
    generators_transformed: i64
    yield_points_total: i64
    locals_saved: i64

impl GeneratorStateMachine:
    static fn new() -> GeneratorStateMachine:
        GeneratorStateMachine(
            generators_transformed: 0,
            yield_points_total: 0,
            locals_saved: 0)

    fn name() -> text:
        "generator_state_machine"

    fn description() -> text:
        "Generator state-machine transformation skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        []

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    me build_state_machine(
        func: MirFunction, analysis: YieldAnalysis
    ) -> MirFunction:
        func

    fn stats_summary() -> text:
        "GeneratorSM: {self.generators_transformed} generators transformed, {self.yield_points_total} yield points, {self.locals_saved} locals saved"

fn create_generator_sm_pass() -> GeneratorStateMachine:
    GeneratorStateMachine.new()

fn generator_sm_run_on_function(
    generator_pass: GeneratorStateMachine, func: MirFunction
) -> MirFunction:
    func
