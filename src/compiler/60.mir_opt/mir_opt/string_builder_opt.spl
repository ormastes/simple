# String Builder Rewrite (bug c_runtime_string_concat_quadratic_2026-08-22)
#
# `rt_strcat_tagged` copies both operands on every call, so a loop that
# accumulates `s = s + x` / `s += x` is O(n^2). MIR lowers both source forms
# to the same pair:
#
#   tmp = call rt_strcat_tagged(s, x)
#   s   = copy tmp
#
# When it is provably safe, this pass rewrites the loop to the runtime
# builder (`std.common.string_builder.RtStringBuilder`'s externs):
#
#   preheader:  sb = call rt_string_builder_new()
#               call rt_string_builder_push(sb, s)      # keep s's prior value
#   loop:       call rt_string_builder_push(sb, x)      # per append
#   each exit:  s = call rt_string_builder_finish(sb)   # consumes the handle
#
# Safety conditions (any failure leaves the function unchanged):
#   1. Inside the loop, `s` is referenced ONLY as the first argument of the
#      concat and as the destination of its copy-back -- no other read,
#      write or alias (including the loop condition and `s = s + s`).
#   2. The concat temp is referenced nowhere else in the function.
#   3. The loop header has exactly one predecessor outside the loop, and it
#      ends in `goto header` (a dedicated preheader).
#   4. Every exit block has only loop predecessors, and every loop block ends
#      in goto/if/switch/unreachable/abort (no return, throw or call
#      terminator escapes with the handle live).
#   5. Any instruction kind this pass does not model counts as a use of `s`.
#
# Opt-in (SIMPLE_MIR_STRING_BUILDER_OPT=1) until the rewrite is verified on
# the native lane; see the bug record.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions (MirModule, MirFunction, MirBlock)
use compiler.mir_opt.loop_detect (LoopInfo, LoopDetector)
use std.io_runtime.{env_get_opt}

val SB_CONCAT_FN: text = "rt_strcat_tagged"
val SB_NEW_FN: text = "rt_string_builder_new"
val SB_PUSH_FN: text = "rt_string_builder_push"
val SB_FINISH_FN: text = "rt_string_builder_finish"

class StringBuilderOpt:
    detector: LoopDetector
    transforms_applied: i64

impl StringBuilderOpt:
    static fn new() -> StringBuilderOpt:
        StringBuilderOpt(detector: LoopDetector.new(), transforms_applied: 0)

    me optimize_function(func: MirFunction) -> MirFunction:
        self.detector.detect_loops(func)
        var current = func
        for loop_info in self.detector.loops:
            current = self.try_transform_loop(current, loop_info)
        current

    me try_transform_loop(func: MirFunction, loop_info: LoopInfo) -> MirFunction:
        var loop_set: Dict<i64, bool> = {}
        loop_set[loop_info.header.id] = true
        for bid in loop_info.body:
            loop_set[bid.id] = true

        val candidate = self.find_candidate(func, loop_set)
        if val c = candidate:
            if not self.loop_is_safe(func, loop_set, c):
                return func
            val preheader = self.unique_preheader(func, loop_set, loop_info.header)
            if preheader < 0:
                return func
            val exits = self.exit_blocks(func, loop_set)
            if exits.len() == 0:
                return func
            self.transforms_applied = self.transforms_applied + 1
            return self.apply(func, loop_set, c, preheader, exits)
        func

    # First `tmp = rt_strcat_tagged(Copy(s), x); s = tmp` pair in the loop on a
    # str-typed `s`.
    fn find_candidate(func: MirFunction, loop_set: Dict<i64, bool>) -> SbCandidate?:
        for block in func.blocks:
            if not loop_set.has(block.id.id):
                continue
            val insts = block.instructions
            var i = 0
            while i + 1 < insts.len():
                val pair = sb_match_concat_pair(insts[i], insts[i + 1])
                if val p = pair:
                    if sb_local_is_str(func, p.s_id):
                        return Some(p)
                i = i + 1
        None

    fn loop_is_safe(func: MirFunction, loop_set: Dict<i64, bool>, c: SbCandidate) -> bool:
        for block in func.blocks:
            val in_loop = loop_set.has(block.id.id)
            val insts = block.instructions
            var i = 0
            while i < insts.len():
                # A concat pair for s in the loop is the sanctioned use.
                if in_loop and i + 1 < insts.len():
                    val pair = sb_match_concat_pair(insts[i], insts[i + 1])
                    if val p = pair:
                        if p.s_id == c.s_id:
                            if sb_operand_mentions(p.suffix, c.s_id):
                                return false
                            if not self.temp_is_private(func, p.tmp_id, block.id.id, i):
                                return false
                            i = i + 2
                            continue
                if in_loop and sb_inst_mentions(insts[i], c.s_id):
                    return false
                i = i + 1
            if in_loop:
                if not sb_terminator_safe_in_loop(block.terminator):
                    return false
                if sb_terminator_mentions(block.terminator, c.s_id):
                    return false
        true

    # The concat temp is defined by the pair at (block_id, index) and read only
    # by its copy-back; nothing else in the function may reference it.
    fn temp_is_private(func: MirFunction, tmp_id: i64, block_id: i64, index: i64) -> bool:
        for block in func.blocks:
            var i = 0
            for inst in block.instructions:
                val is_pair = block.id.id == block_id and (i == index or i == index + 1)
                if not is_pair and sb_inst_mentions(inst, tmp_id):
                    return false
                i = i + 1
            if sb_terminator_mentions(block.terminator, tmp_id):
                return false
        true

    fn unique_preheader(func: MirFunction, loop_set: Dict<i64, bool>, header: BlockId) -> i64:
        var found = -1
        for block in func.blocks:
            if loop_set.has(block.id.id):
                continue
            for succ in sb_successors(block.terminator):
                if succ == header.id:
                    if found >= 0:
                        return -1
                    found = block.id.id
        if found < 0:
            return -1
        for block in func.blocks:
            if block.id.id == found:
                match block.terminator:
                    case Goto(_): return found
                    case _: return -1
        -1

    fn exit_blocks(func: MirFunction, loop_set: Dict<i64, bool>) -> [i64]:
        var exits: [i64] = []
        for block in func.blocks:
            if not loop_set.has(block.id.id):
                continue
            for succ in sb_successors(block.terminator):
                if not loop_set.has(succ) and not exits.contains(succ):
                    exits.push(succ)
        # Every exit must be entered only from inside the loop.
        for block in func.blocks:
            if loop_set.has(block.id.id):
                continue
            for succ in sb_successors(block.terminator):
                if exits.contains(succ):
                    return []
        if func.entry_block.id >= 0 and exits.contains(func.entry_block.id):
            return []
        exits

    me apply(func: MirFunction, loop_set: Dict<i64, bool>, c: SbCandidate, preheader: i64, exits: [i64]) -> MirFunction:
        var max_id = 0
        for loc in func.locals:
            if loc.id.id > max_id:
                max_id = loc.id.id
        val sb_id = LocalId(id: max_id + 1)
        var locals = func.locals
        locals.push(MirLocal(id: sb_id, name: Some("__sb_{c.s_id}"), type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false))

        val sb_op = MirOperand(kind: MirOperandKind.Copy(sb_id))
        val s_local = LocalId(id: c.s_id)
        var blocks: [MirBlock] = []
        for block in func.blocks:
            var insts: [MirInst] = []
            val bid = block.id.id
            if exits.contains(bid):
                insts.push(MirInst(kind: MirInstKind.Call(Some(s_local), sb_fn_operand(SB_FINISH_FN, sb_str_type()), [sb_op]), span: None))
            val src = block.instructions
            var i = 0
            while i < src.len():
                if loop_set.has(bid) and i + 1 < src.len():
                    val pair = sb_match_concat_pair(src[i], src[i + 1])
                    if val p = pair:
                        if p.s_id == c.s_id:
                            # WORKAROUND(stage2-optmerge-void): Bug A: stage2 mis-types inline None as nil in LocalId? payload slot; remove when stage2 rebuilt with fix
                            val no_dest: LocalId? = None
                            insts.push(MirInst(kind: MirInstKind.Call(no_dest, sb_fn_operand(SB_PUSH_FN, MirType.i64()), [sb_op, p.suffix]), span: src[i].span))
                            i = i + 2
                            continue
                insts.push(src[i])
                i = i + 1
            if bid == preheader:
                insts.push(MirInst(kind: MirInstKind.Call(Some(sb_id), sb_fn_operand(SB_NEW_FN, MirType.i64()), []), span: None))
                # WORKAROUND(stage2-optmerge-void): Bug A: stage2 mis-types inline None as nil in LocalId? payload slot; remove when stage2 rebuilt with fix
                val no_dest_push: LocalId? = None
                insts.push(MirInst(kind: MirInstKind.Call(no_dest_push, sb_fn_operand(SB_PUSH_FN, MirType.i64()), [sb_op, MirOperand(kind: MirOperandKind.Copy(s_local))]), span: None))
            blocks.push(MirBlock(id: block.id, label: block.label, instructions: insts, terminator: block.terminator))
        MirFunction(..func, locals: locals, blocks: blocks)

    fn stats_summary() -> text:
        "StringBuilderOpt: {self.transforms_applied} loops transformed"

struct SbCandidate:
    s_id: i64
    tmp_id: i64
    suffix: MirOperand

# ============================================================================
# Helpers (free functions so the safety proof is testable in isolation)
# ============================================================================

fn sb_str_type() -> MirType:
    MirType(kind: MirTypeKind.Opaque("str"))

fn sb_fn_operand(name: text, ret: MirType) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: ret, is_variadic: false)))))

fn sb_callee_name(op: MirOperand) -> text:
    match op.kind:
        case Const(value, _):
            match value:
                case Str(name): name
                case _: ""
        case _: ""

fn sb_operand_local(op: MirOperand) -> i64:
    match op.kind:
        case Copy(local): local.id
        case Move(local): local.id
        case _: -1

fn sb_match_concat_pair(first: MirInst, second: MirInst) -> SbCandidate?:
    match first.kind:
        case Call(dest, func, args):
            if sb_callee_name(func) != SB_CONCAT_FN or args.len() != 2:
                return None
            if val tmp = dest:
                val s_id = sb_operand_local(args[0])
                if s_id < 0 or s_id == tmp.id:
                    return None
                match second.kind:
                    case Copy(cd, cs):
                        if cd.id == s_id and cs.id == tmp.id:
                            return Some(SbCandidate(s_id: s_id, tmp_id: tmp.id, suffix: args[1]))
                    case Move(md, ms):
                        if md.id == s_id and ms.id == tmp.id:
                            return Some(SbCandidate(s_id: s_id, tmp_id: tmp.id, suffix: args[1]))
                    case _: return None
            return None
        case _: return None
    None

fn sb_local_is_str(func: MirFunction, id: i64) -> bool:
    for loc in func.locals:
        if loc.id.id == id:
            match loc.type_.kind:
                case Opaque(name): return name == "str"
                case _: return false
    false

fn sb_operand_mentions(op: MirOperand, id: i64) -> bool:
    sb_operand_local(op) == id

fn sb_any_mentions(ops: [MirOperand], id: i64) -> bool:
    for op in ops:
        if sb_operand_mentions(op, id):
            return true
    false

fn sb_opt_dest_is(dest: LocalId?, id: i64) -> bool:
    if val d = dest:
        return d.id == id
    false

# Conservative: an instruction kind not modelled here counts as a use.
fn sb_inst_mentions(inst: MirInst, id: i64) -> bool:
    match inst.kind:
        case Const(dest, _, _): dest.id == id
        case Copy(dest, src): dest.id == id or src.id == id
        case Move(dest, src): dest.id == id or src.id == id
        case BinOp(dest, _, l, r): dest.id == id or sb_operand_mentions(l, id) or sb_operand_mentions(r, id)
        case CheckedBinOp(dest, _, l, r): dest.id == id or sb_operand_mentions(l, id) or sb_operand_mentions(r, id)
        case UnaryOp(dest, _, o): dest.id == id or sb_operand_mentions(o, id)
        case Cast(dest, o, _): dest.id == id or sb_operand_mentions(o, id)
        case Bitcast(dest, o, _): dest.id == id or sb_operand_mentions(o, id)
        case Load(dest, p): dest.id == id or sb_operand_mentions(p, id)
        case Store(p, v): sb_operand_mentions(p, id) or sb_operand_mentions(v, id)
        case GetField(dest, b, _): dest.id == id or sb_operand_mentions(b, id)
        case SetField(b, _, v): sb_operand_mentions(b, id) or sb_operand_mentions(v, id)
        case Aggregate(dest, _, ops): dest.id == id or sb_any_mentions(ops, id)
        case GetElementPtr(dest, b, idx): dest.id == id or sb_operand_mentions(b, id) or sb_any_mentions(idx, id)
        case Call(dest, f, args): sb_opt_dest_is(dest, id) or sb_operand_mentions(f, id) or sb_any_mentions(args, id)
        case CallIndirect(dest, p, args, _): sb_opt_dest_is(dest, id) or sb_operand_mentions(p, id) or sb_any_mentions(args, id)
        case Intrinsic(dest, _, args): sb_opt_dest_is(dest, id) or sb_any_mentions(args, id)
        case Drop(local): local.id == id
        case DebugValue(local, _): local.id == id
        case _: true

fn sb_terminator_mentions(term: MirTerminator, id: i64) -> bool:
    match term:
        case Goto(_): false
        case Unreachable: false
        case Abort(_): false
        case If(cond, _, _): sb_operand_mentions(cond, id)
        case Switch(value, _, _): sb_operand_mentions(value, id)
        case Ret(value):
            if val v = value:
                return sb_operand_mentions(v, id)
            false
        case _: true

# Loop blocks must not leave the function with the builder handle live.
fn sb_terminator_safe_in_loop(term: MirTerminator) -> bool:
    match term:
        case Goto(_): true
        case If(_, _, _): true
        case Switch(_, _, _): true
        case Unreachable: true
        case Abort(_): true
        case _: false

fn sb_successors(term: MirTerminator) -> [i64]:
    match term:
        case Goto(t): [t.id]
        case If(_, a, b): [a.id, b.id]
        case Switch(_, cases, d):
            var out: [i64] = []
            for sc in cases:
                out.push(sc.target.id)
            out.push(d.id)
            out
        case _: []

fn string_builder_opt_enabled_for(raw: text) -> bool:
    raw == "1"

fn string_builder_opt_enabled() -> bool:
    string_builder_opt_enabled_for(env_get_opt("SIMPLE_MIR_STRING_BUILDER_OPT") ?? "")

# ============================================================================
# Factory Functions
# ============================================================================

fn create_string_builder_opt_pass() -> StringBuilderOpt:
    StringBuilderOpt.new()

fn string_builder_opt_run_on_function(sb_pass: StringBuilderOpt, func: MirFunction) -> MirFunction:
    if not string_builder_opt_enabled():
        return func
    var p = sb_pass
    p.optimize_function(func)
