# codex-impl
# Shared, immutable performance-analysis facts built once per MIR function.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction}

enum PerfFactKind:
    Cfg
    Dominators
    DefUse

struct PerfFactPreservation:
    cfg: bool
    dominators: bool
    def_use: bool

struct MirDefUseSite:
    block: BlockId
    instruction_index: i64
    local: LocalId
    is_terminator: bool

struct MirInstructionAccess:
    defs: [LocalId]
    uses: [LocalId]
    covered: bool

impl MirInstructionAccess:
    me define(local: LocalId):
        self.defs.push(local)

    me use_operand(operand: MirOperand):
        match operand.kind:
            case Copy(local) | Move(local): self.uses.push(local)
            case Const(_, _): pass_dn

    me use_local(local: LocalId):
        self.uses.push(local)

struct PerfFacts:
    """Revision-local CFG facts shared by loop and optimization analyses.

    Later fact families extend this owner; they must declare invalidation rather
    than rebuilding private CFG maps in individual passes.
    """
    successors: Dict<i64, [BlockId]>
    predecessors: Dict<i64, [i64]>
    block_index: Dict<i64, i64>
    block_count: i64
    reverse_postorder: [BlockId]
    rpo_index: Dict<i64, i64>
    immediate_dominator: Dict<i64, i64>
    locals: [LocalId]
    local_index: Dict<i64, i64>
    definition_buckets: [[MirDefUseSite]]
    use_buckets: [[MirDefUseSite]]
    def_use_complete: bool
    uncovered_instruction_count: i64
    invalid_local_reference_count: i64

fn perf_fact_preservation_all() -> PerfFactPreservation:
    PerfFactPreservation(true, true, true)

fn perf_fact_preservation_none() -> PerfFactPreservation:
    PerfFactPreservation(false, false, false)

fn perf_fact_preservation_cfg_only() -> PerfFactPreservation:
    PerfFactPreservation(true, true, false)

fn perf_fact_preservation_integrity_errors(preservation: PerfFactPreservation) -> [text]:
    var errors: [text] = []
    if preservation.dominators and not preservation.cfg:
        errors.push("dominator preservation requires CFG preservation")
    errors

fn perf_facts_invalidated(preservation: PerfFactPreservation) -> [PerfFactKind]:
    var invalidated: [PerfFactKind] = []
    if not preservation.cfg: invalidated.push(PerfFactKind.Cfg)
    if not preservation.dominators: invalidated.push(PerfFactKind.Dominators)
    if not preservation.def_use: invalidated.push(PerfFactKind.DefUse)
    invalidated

fn perf_instruction_access(inst: MirInst) -> MirInstructionAccess:
    var access = MirInstructionAccess([], [], true)
    match inst.kind:
        case Const(dest, _, _) | Alloc(dest, _) | LoadGlobal(dest, _):
            access.define(dest)
        case Copy(dest, source) | Move(dest, source):
            access.define(dest)
            access.use_local(source)
        case BinOp(dest, _, left, right) | CheckedBinOp(dest, _, left, right):
            access.define(dest)
            access.use_operand(left)
            access.use_operand(right)
        case UnaryOp(dest, _, operand) | Cast(dest, operand, _) | Bitcast(dest, operand, _):
            access.define(dest)
            access.use_operand(operand)
        case Load(dest, pointer):
            access.define(dest)
            access.use_operand(pointer)
        case Store(pointer, value):
            access.use_operand(pointer)
            access.use_operand(value)
        case GetElementPtr(dest, base, indices):
            access.define(dest)
            access.use_operand(base)
            for index in indices: access.use_operand(index)
        case StoreGlobal(_, value):
            access.use_operand(value)
        case Aggregate(dest, _, operands):
            access.define(dest)
            for operand in operands: access.use_operand(operand)
        case GetField(dest, base, _):
            access.define(dest)
            access.use_operand(base)
        case SetField(base, _, value):
            access.use_operand(base)
            access.use_operand(value)
        case Call(dest, function, args):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(function)
            for arg in args: access.use_operand(arg)
        case CallIndirect(dest, pointer, args, _):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(pointer)
            for arg in args: access.use_operand(arg)
        case Intrinsic(dest, _, args):
            if dest.?: access.define(dest.unwrap())
            for arg in args: access.use_operand(arg)
        case DebugValue(local, _): access.use_local(local)
        case Nop: pass_dn
        case _: return MirInstructionAccess([], [], false)
    access

fn perf_terminator_access(terminator: MirTerminator) -> MirInstructionAccess:
    var access = MirInstructionAccess([], [], true)
    match terminator:
        case Ret(value):
            if value.?: access.use_operand(value.unwrap())
        case If(condition, _, _): access.use_operand(condition)
        case Switch(value, _, _): access.use_operand(value)
        case CallTerminator(dest, function, args, _, _):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(function)
            for arg in args: access.use_operand(arg)
        case Goto(_) | Unreachable | Abort(_): pass_dn
    access

fn perf_facts_reverse_postorder(entry: BlockId, successors: Dict<i64, [BlockId]>) -> [BlockId]:
    # Iterative DFS with explicit frames avoids recursion depth and array-slice
    # popping. `top` owns the live prefix of both reusable stacks.
    var visited: Dict<i64, bool> = {}
    var block_stack: [BlockId] = [entry]
    var successor_index_stack: [i64] = [0]
    var top = 1
    var postorder: [BlockId] = []
    visited[entry.id] = true

    while top > 0:
        val frame_index = top - 1
        val block = block_stack[frame_index]
        val block_successors = successors[block.id] ?? []
        val successor_index = successor_index_stack[frame_index]
        if successor_index < block_successors.len():
            successor_index_stack[frame_index] = successor_index + 1
            val successor = block_successors[successor_index]
            if not visited.has(successor.id):
                visited[successor.id] = true
                if top < block_stack.len():
                    block_stack[top] = successor
                    successor_index_stack[top] = 0
                else:
                    block_stack.push(successor)
                    successor_index_stack.push(0)
                top = top + 1
        else:
            postorder.push(block)
            top = top - 1

    var result: [BlockId] = []
    var index = postorder.len()
    while index > 0:
        index = index - 1
        result.push(postorder[index])
    result

fn perf_facts_intersect_idom(first: i64, second: i64, idom: Dict<i64, i64>, rpo_index: Dict<i64, i64>) -> i64:
    var left = first
    var right = second
    while left != right:
        while (rpo_index[left] ?? -1) > (rpo_index[right] ?? -1):
            left = idom[left]
        while (rpo_index[right] ?? -1) > (rpo_index[left] ?? -1):
            right = idom[right]
    left

fn perf_facts_immediate_dominators(entry: BlockId, rpo: [BlockId], rpo_index: Dict<i64, i64>, predecessors: Dict<i64, [i64]>) -> Dict<i64, i64>:
    var idom: Dict<i64, i64> = {}
    idom[entry.id] = entry.id
    var changed = true
    var iteration = 0
    val iteration_limit = rpo.len() * rpo.len() + 1
    while changed and iteration < iteration_limit:
        iteration = iteration + 1
        changed = false
        var index = 1
        while index < rpo.len():
            val block_id = rpo[index].id
            var candidate = -1
            for predecessor in (predecessors[block_id] ?? []):
                if idom.has(predecessor):
                    if candidate < 0:
                        candidate = predecessor
                    else:
                        candidate = perf_facts_intersect_idom(predecessor, candidate, idom, rpo_index)
            if candidate >= 0 and (not idom.has(block_id) or idom[block_id] != candidate):
                idom[block_id] = candidate
                changed = true
            index = index + 1
    if changed:
        # Malformed/non-converging fact construction authorizes no dominance
        # dependent transformation.
        return {}
    idom

fn perf_facts_terminator_successors(term: MirTerminator) -> [BlockId]:
    val empty: [BlockId] = []
    match term:
        case Ret(_) | Unreachable | Abort(_): empty
        case Goto(target): [target]
        case If(_, then_, else_): [then_, else_]
        case Switch(_, targets, default):
            var result: [BlockId] = []
            for target_case in targets:
                result.push(target_case.target)
            result.push(default)
            result
        case CallTerminator(_, _, _, normal, unwind):
            match unwind:
                case Some(unwind_target): [normal, unwind_target]
                case nil: [normal]

fn perf_facts_build(func: MirFunction) -> PerfFacts:
    var successors: Dict<i64, [BlockId]> = {}
    var predecessors: Dict<i64, [i64]> = {}
    var block_index: Dict<i64, i64> = {}
    var local_index: Dict<i64, i64> = {}
    var definition_buckets: [[MirDefUseSite]] = []
    var use_buckets: [[MirDefUseSite]] = []
    var def_use_complete = true
    var uncovered_instruction_count = 0
    var invalid_local_reference_count = 0
    var index = 0

    var local_position = 0
    var declared_locals: [LocalId] = []
    for local in func.locals:
        if local_index.has(local.id.id):
            def_use_complete = false
            invalid_local_reference_count = invalid_local_reference_count + 1
        else:
            local_index[local.id.id] = local_position
            declared_locals.push(local.id)
            definition_buckets.push([])
            use_buckets.push([])
            local_position = local_position + 1

    for block in func.blocks:
        block_index[block.id.id] = index
        index = index + 1
        val block_successors = perf_facts_terminator_successors(block.terminator)
        successors[block.id.id] = block_successors
        for successor in block_successors:
            var incoming = predecessors[successor.id] ?? []
            incoming.push(block.id.id)
            predecessors[successor.id] = incoming
        var instruction_index = 0
        for instruction in block.instructions:
            val access = perf_instruction_access(instruction)
            if not access.covered:
                def_use_complete = false
                uncovered_instruction_count = uncovered_instruction_count + 1
            for local in access.defs:
                if local_index.has(local.id):
                    definition_buckets[local_index[local.id]].push(MirDefUseSite(block.id, instruction_index, local, false))
                else:
                    def_use_complete = false
                    invalid_local_reference_count = invalid_local_reference_count + 1
            for local in access.uses:
                if local_index.has(local.id):
                    use_buckets[local_index[local.id]].push(MirDefUseSite(block.id, instruction_index, local, false))
                else:
                    def_use_complete = false
                    invalid_local_reference_count = invalid_local_reference_count + 1
            instruction_index = instruction_index + 1
        val terminator_access = perf_terminator_access(block.terminator)
        for local in terminator_access.defs:
            if local_index.has(local.id):
                definition_buckets[local_index[local.id]].push(MirDefUseSite(block.id, -1, local, true))
            else:
                def_use_complete = false
                invalid_local_reference_count = invalid_local_reference_count + 1
        for local in terminator_access.uses:
            if local_index.has(local.id):
                use_buckets[local_index[local.id]].push(MirDefUseSite(block.id, -1, local, true))
            else:
                def_use_complete = false
                invalid_local_reference_count = invalid_local_reference_count + 1

    val rpo = perf_facts_reverse_postorder(func.entry_block, successors)
    var rpo_index: Dict<i64, i64> = {}
    var rpo_position = 0
    for block in rpo:
        rpo_index[block.id] = rpo_position
        rpo_position = rpo_position + 1
    val idom = perf_facts_immediate_dominators(func.entry_block, rpo, rpo_index, predecessors)

    PerfFacts(
        successors: successors,
        predecessors: predecessors,
        block_index: block_index,
        block_count: func.blocks.len(),
        reverse_postorder: rpo,
        rpo_index: rpo_index,
        immediate_dominator: idom,
        locals: declared_locals,
        local_index: local_index,
        definition_buckets: definition_buckets,
        use_buckets: use_buckets,
        def_use_complete: def_use_complete,
        uncovered_instruction_count: uncovered_instruction_count,
        invalid_local_reference_count: invalid_local_reference_count
    )

fn perf_facts_successors(facts: PerfFacts, block: BlockId) -> [BlockId]:
    facts.successors[block.id] ?? []

fn perf_facts_predecessors(facts: PerfFacts, block: BlockId) -> [i64]:
    facts.predecessors[block.id] ?? []

fn perf_facts_dominates(facts: PerfFacts, dominator: BlockId, block: BlockId) -> bool:
    if not facts.immediate_dominator.has(block.id) or not facts.immediate_dominator.has(dominator.id):
        return false
    var current = block.id
    while true:
        if current == dominator.id:
            return true
        val parent = facts.immediate_dominator[current]
        if parent == current:
            return false
        current = parent

fn perf_facts_definitions(facts: PerfFacts, local: LocalId) -> [MirDefUseSite]:
    if not facts.local_index.has(local.id): return []
    facts.definition_buckets[facts.local_index[local.id]]

fn perf_facts_uses(facts: PerfFacts, local: LocalId) -> [MirDefUseSite]:
    if not facts.local_index.has(local.id): return []
    facts.use_buckets[facts.local_index[local.id]]

export PerfFactKind, PerfFactPreservation, MirDefUseSite, MirInstructionAccess, PerfFacts
export perf_fact_preservation_all, perf_fact_preservation_none, perf_fact_preservation_cfg_only
export perf_fact_preservation_integrity_errors, perf_facts_invalidated
export perf_facts_build, perf_facts_terminator_successors
export perf_facts_successors, perf_facts_predecessors
export perf_facts_dominates, perf_facts_definitions, perf_facts_uses
