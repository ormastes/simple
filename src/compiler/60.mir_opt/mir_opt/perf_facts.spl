# codex-impl
# Shared, immutable performance-analysis facts built once per MIR function.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction}

enum PerfFactKind:
    Cfg
    Dominators
    DefUse
    Liveness

struct PerfFactPreservation:
    cfg: bool
    dominators: bool
    def_use: bool
    liveness: bool

struct MirDefUseSite:
    block: BlockId
    instruction_index: i64
    local: LocalId
    is_terminator: bool

struct MirInstructionAccess:
    defs: [LocalId]
    uses: [LocalId]
    covered: bool

struct PerfLivenessBuild:
    live_in_bits: [bool]
    live_out_bits: [bool]
    complete: bool
    worklist_visits: i64
    budget_exhausted: bool

impl MirInstructionAccess:
    me define(local: LocalId):
        self.defs.push(local)

    me use_operand(operand: MirOperand):
        match operand.kind:
            case Copy(local) | Move(local): self.uses.push(local)
            case Const(_, _): pass_dn

    me use_local(local: LocalId):
        self.uses.push(local)

    me use_operands(operands: [MirOperand]):
        for operand in operands: self.use_operand(operand)

    me use_place(place: MirPlace):
        self.use_local(place.local)
        for projection in place.projection:
            match projection:
                case Index(local): self.use_local(local)
                case Deref | Field(_) | Downcast(_): pass_dn

    me define_operand(operand: MirOperand):
        match operand.kind:
            case Copy(local) | Move(local): self.define(local)
            case Const(_, _): self.covered = false

struct PerfFacts:
    """Revision-local CFG facts shared by loop and optimization analyses.

    Later fact families extend this owner; they must declare invalidation rather
    than rebuilding private CFG maps in individual passes.
    """
    successors: Dict<i64, [BlockId]>
    predecessors: Dict<i64, [i64]>
    block_index: Dict<i64, i64>
    block_count: i64
    cfg_complete: bool
    duplicate_block_identity_count: i64
    invalid_block_reference_count: i64
    reverse_postorder: [BlockId]
    rpo_index: Dict<i64, i64>
    immediate_dominator: Dict<i64, i64>
    locals: [LocalId]
    local_index: Dict<i64, i64>
    definition_buckets: [[MirDefUseSite]]
    use_buckets: [[MirDefUseSite]]
    def_use_complete: bool
    uncovered_instruction_count: i64
    invalid_local_reference_count: i64
    block_definition_bits: [bool]
    block_use_before_definition_bits: [bool]
    live_in_bits: [bool]
    live_out_bits: [bool]
    liveness_complete: bool
    liveness_worklist_visits: i64
    liveness_budget_exhausted: bool

fn perf_fact_preservation_all() -> PerfFactPreservation:
    PerfFactPreservation(true, true, true, true)

fn perf_fact_preservation_none() -> PerfFactPreservation:
    PerfFactPreservation(false, false, false, false)

fn perf_fact_preservation_cfg_only() -> PerfFactPreservation:
    PerfFactPreservation(true, true, false, false)

fn perf_fact_preservation_integrity_errors(preservation: PerfFactPreservation) -> [text]:
    var errors: [text] = []
    if preservation.dominators and not preservation.cfg:
        errors.push("dominator preservation requires CFG preservation")
    if preservation.liveness and (not preservation.cfg or not preservation.def_use):
        errors.push("liveness preservation requires CFG and def-use preservation")
    errors

fn perf_facts_invalidated(preservation: PerfFactPreservation) -> [PerfFactKind]:
    var invalidated: [PerfFactKind] = []
    if not preservation.cfg: invalidated.push(PerfFactKind.Cfg)
    if not preservation.dominators: invalidated.push(PerfFactKind.Dominators)
    if not preservation.def_use: invalidated.push(PerfFactKind.DefUse)
    if not preservation.liveness: invalidated.push(PerfFactKind.Liveness)
    invalidated

fn perf_instruction_access(inst: MirInst) -> MirInstructionAccess:
    var access = MirInstructionAccess([], [], true)
    match inst.kind:
        case Const(dest, _, _) | Alloc(dest, _) | LoadGlobal(dest, _):
            access.define(dest)
        case Copy(dest, source) | Move(dest, source):
            access.define(dest)
            access.use_local(source)
        case TransferOut(dest, source, _, _, _, _):
            access.define(dest)
            access.use_local(source)
        case TransferIn(dest, _, _, _): access.define(dest)
        case FreezeRegion(local) | Drop(local): access.use_local(local)
        case AcquireSnapshot(dest, source):
            access.define(dest)
            access.use_local(source)
        case CommitUpdates(dest, base, updates):
            if dest.?: access.define(dest.unwrap())
            access.use_local(base)
            access.use_local(updates)
        case BinOp(dest, _, left, right) | CheckedBinOp(dest, _, left, right):
            access.define(dest)
            access.use_operand(left)
            access.use_operand(right)
        case UnaryOp(dest, _, operand) | Cast(dest, operand, _) | Bitcast(dest, operand, _):
            access.define(dest)
            access.use_operand(operand)
        case Load(dest, pointer):
            access.define(dest)
            access.use_operand(pointer)
        case Store(pointer, value):
            access.use_operand(pointer)
            access.use_operand(value)
        case GetElementPtr(dest, base, indices):
            access.define(dest)
            access.use_operand(base)
            for index in indices: access.use_operand(index)
        case StoreGlobal(_, value):
            access.use_operand(value)
        case Aggregate(dest, _, operands):
            access.define(dest)
            for operand in operands: access.use_operand(operand)
        case GetField(dest, base, _):
            access.define(dest)
            access.use_operand(base)
        case SetField(base, _, value):
            access.use_operand(base)
            access.use_operand(value)
        case ResultMatchSemantic(scrutinee, destination, _, _, _, ok_payload, err_payload):
            # Ghost payload roles are not yet specified as runtime defs/uses.
            return MirInstructionAccess([], [], false)
        case Call(dest, function, args):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(function)
            for arg in args: access.use_operand(arg)
        case CallIndirect(dest, pointer, args, _):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(pointer)
            for arg in args: access.use_operand(arg)
        case Intrinsic(dest, _, args):
            if dest.?: access.define(dest.unwrap())
            access.use_operands(args)
        case DecisionProbe(_, _, result, _, _, _) | ConditionProbe(_, _, _, _, result, _, _, _):
            access.use_operand(result)
        case SimdAddF32x4(dest, a, b) | SimdSubF32x4(dest, a, b) |
             SimdMulF32x4(dest, a, b) | SimdDivF32x4(dest, a, b) |
             SimdAddF32x8(dest, a, b) | SimdSubF32x8(dest, a, b) |
             SimdMulF32x8(dest, a, b) | SimdDivF32x8(dest, a, b) |
             SimdAddF64x4(dest, a, b) | SimdSubF64x4(dest, a, b) |
             SimdMulF64x4(dest, a, b) | SimdDivF64x4(dest, a, b) |
             SimdAddI32x4(dest, a, b) | SimdSubI32x4(dest, a, b) |
             SimdMulI32x4(dest, a, b) | SimdXorI32x4(dest, a, b) |
             SimdAndI32x4(dest, a, b) | SimdOrI32x4(dest, a, b) |
             SimdShlI32x4(dest, a, b) | SimdShrI32x4(dest, a, b) |
             SimdAddI32x8(dest, a, b) | SimdSubI32x8(dest, a, b) |
             SimdMulI32x8(dest, a, b) | SimdXorI32x8(dest, a, b) |
             SimdAndI32x8(dest, a, b) | SimdOrI32x8(dest, a, b) |
             SimdShlI32x8(dest, a, b) | SimdShrI32x8(dest, a, b):
            access.define(dest)
            access.use_operand(a)
            access.use_operand(b)
        case SimdFmaF32x4(dest, a, b, c) | SimdFmaF32x8(dest, a, b, c) |
             SimdFmaF64x4(dest, a, b, c):
            access.define(dest)
            access.use_operand(a)
            access.use_operand(b)
            access.use_operand(c)
        case SimdHaddF32x4(dest, a) | SimdHmaxF32x4(dest, a) | SimdHminF32x4(dest, a):
            access.define(dest)
            access.use_operand(a)
        case InlineAsm(_, _, inputs, outputs, _, _, _):
            for input in inputs: access.use_operand(input.operand)
            for output in outputs:
                access.define_operand(output.operand)
                # InOut operands are represented in both lists by lowering.
        case PipeForward(dest, value, function):
            access.define(dest)
            access.use_operand(value)
            access.use_operand(function)
        case Compose(dest, f, g, _):
            access.define(dest)
            access.use_operand(f)
            access.use_operand(g)
        case Parallel(dest, functions):
            access.define(dest)
            access.use_operands(functions)
        case LayerConnect(dest, layer1, layer2):
            access.define(dest)
            access.use_operand(layer1)
            access.use_operand(layer2)
        case DebugValue(local, _): access.use_local(local)
        case Nop: pass_dn
        case CreatePromise(dest, body, _):
            access.define(dest)
            access.use_local(body)
        case Await(dest, promise):
            access.define(dest)
            access.use_operand(promise)
        case Yield(value):
            if value.?: access.use_operand(value.unwrap())
        case Spawn(dest, handler, args):
            access.define(dest)
            access.use_operand(handler)
            access.use_operands(args)
        case Send(dest, target, message):
            access.define(dest)
            access.use_operand(target)
            access.use_operand(message)
        case Receive(dest, timeout):
            access.define(dest)
            if timeout.?: access.use_operand(timeout.unwrap())
        case Ref(dest, _, place):
            access.define(dest)
            access.use_place(place)
        case GpuKernelDef(_) | GpuBarrier(_) | GpuMemFence(_) |
             HostGpuLaneEnd(_) | ScalableVecFence(_): pass_dn
        case GpuLaunch(_) | VhdlProcess(_, _):
            # Launch arguments are still encoded as text, while VHDL process
            # bodies are hidden CFG edges. Neither can authorize liveness.
            return MirInstructionAccess([], [], false)
        case GpuGlobalId(dest, _) | GpuLocalId(dest, _) | GpuBlockId(dest, _) |
             GpuBlockDim(dest, _) | GpuGridDim(dest, _) | GpuSharedAlloc(dest, _, _) |
             MirWarpActivesMask(dest): access.define(dest)
        case GpuAtomicOp(dest, _, pointer, value):
            access.define(dest)
            access.use_operand(pointer)
            access.use_operand(value)
        case GpuAtomicCas(dest, pointer, expected, desired):
            access.define(dest)
            access.use_operand(pointer)
            access.use_operand(expected)
            access.use_operand(desired)
        case HostGpuLaneBegin(_, max_packet_bytes):
            if max_packet_bytes.?: access.use_operand(max_packet_bytes.unwrap())
        case VhdlSignalAssign(target, value, _) | VhdlVarAssign(target, value):
            access.use_operand(target)
            access.use_operand(value)
        case VhdlPortMap(_, _, connections):
            for connection in connections: access.use_operand(connection.1)
        case VhdlResize(dest, operand, _, _) | VhdlSlice(dest, operand, _, _):
            access.define(dest)
            access.use_operand(operand)
        case VhdlConcat(dest, parts):
            access.define(dest)
            access.use_operands(parts)
        case MirSimdSplat(dest, value, _) | MirSimdLoad(dest, value, _, _) |
             MirSimdUnop(dest, value, _) | MirSimdReduce(dest, value, _):
            access.define(dest)
            access.use_operand(value)
        case MirSimdStore(value, pointer, _):
            access.use_operand(value)
            access.use_operand(pointer)
        case MirSimdGather(dest, base, indices, _):
            access.define(dest)
            access.use_operand(base)
            access.use_operand(indices)
        case MirSimdScatter(value, base, indices):
            access.use_operand(value)
            access.use_operand(base)
            access.use_operand(indices)
        case MirSimdBinop(dest, lhs, rhs, _) | MirSimdShuffle(dest, lhs, rhs, _) |
             MirSimdCmp(dest, lhs, rhs, _) | MirSimdMaskOp(dest, lhs, rhs, _) |
             MaskFromCmp(dest, _, lhs, rhs):
            access.define(dest)
            access.use_operand(lhs)
            access.use_operand(rhs)
        case MirSimdTernop(dest, a, b, c, _):
            access.define(dest)
            access.use_operand(a)
            access.use_operand(b)
            access.use_operand(c)
        case MirSimdPermute(dest, source, control):
            access.define(dest)
            access.use_operand(source)
            access.use_operand(control)
        case MirSimdSelect(dest, mask, t, f):
            access.define(dest)
            access.use_operand(mask)
            access.use_operand(t)
            access.use_operand(f)
        case MirSimdScalableVsetvl(dest, requested, _):
            access.define(dest)
            access.use_operand(requested)
        case MaskedAdd(dest, mask, a, b) | MaskedMul(dest, mask, a, b):
            access.define(dest)
            access.use_operand(mask)
            access.use_operand(a)
            access.use_operand(b)
        case MaskedFma(dest, mask, a, b, c):
            access.define(dest)
            access.use_operand(mask)
            access.use_operand(a)
            access.use_operand(b)
            access.use_operand(c)
        case PredicatedAdd(dest, _, cmp_a, cmp_b, a, b) |
             PredicatedMul(dest, _, cmp_a, cmp_b, a, b):
            access.define(dest)
            access.use_operand(cmp_a)
            access.use_operand(cmp_b)
            access.use_operand(a)
            access.use_operand(b)
        case PredicatedFma(dest, _, cmp_a, cmp_b, a, b, c):
            access.define(dest)
            access.use_operand(cmp_a)
            access.use_operand(cmp_b)
            access.use_operand(a)
            access.use_operand(b)
            access.use_operand(c)
        case MirWarpShfl(dest, source, delta, mask, _):
            access.define(dest)
            access.use_operand(source)
            access.use_operand(delta)
            access.use_operand(mask)
        case MirWarpReduce(dest, source, mask, _) | MirWarpBallot(dest, source, mask):
            access.define(dest)
            access.use_operand(source)
            access.use_operand(mask)
        case MirWarpSync(mask): access.use_operand(mask)
    access

fn perf_terminator_access(terminator: MirTerminator) -> MirInstructionAccess:
    var access = MirInstructionAccess([], [], true)
    match terminator:
        case Ret(value):
            if value.?: access.use_operand(value.unwrap())
        case If(condition, _, _): access.use_operand(condition)
        case Switch(value, _, _): access.use_operand(value)
        case CallTerminator(dest, function, args, _, _):
            if dest.?: access.define(dest.unwrap())
            access.use_operand(function)
            for arg in args: access.use_operand(arg)
        case Goto(_) | Unreachable | Abort(_): pass_dn
    access

fn perf_facts_build_liveness(
    func: MirFunction,
    successors: Dict<i64, [BlockId]>,
    predecessors: Dict<i64, [i64]>,
    block_index: Dict<i64, i64>,
    local_count: i64,
    block_definition_bits: [bool],
    block_use_bits: [bool],
    inputs_complete: bool
) -> PerfLivenessBuild:
    val block_count = func.blocks.len()
    val cell_count = block_count * local_count
    var live_in: [bool] = []
    var live_out: [bool] = []
    # Reject before allocating dense matrices; the caller likewise omits its
    # USE/DEF matrices when this cap is exceeded.
    if cell_count > 4000000:
        return PerfLivenessBuild(live_in, live_out, false, 0, true)
    var cell = 0
    while cell < cell_count:
        live_in.push(false)
        live_out.push(false)
        cell = cell + 1
    if not inputs_complete:
        return PerfLivenessBuild(live_in, live_out, false, 0, false)
    if block_count == 0 or local_count == 0:
        return PerfLivenessBuild(live_in, live_out, true, 0, false)

    # Predecessor worklist. `top` reuses the fixed live prefix instead of
    # slicing or growing a queue on every propagation step.
    var worklist: [i64] = []
    var queued: [bool] = []
    var block_pos = 0
    while block_pos < block_count:
        worklist.push(block_pos)
        queued.push(true)
        block_pos = block_pos + 1
    var top = block_count
    var visits = 0
    val visit_budget = block_count * block_count * (local_count + 1) + block_count + 1

    while top > 0:
        if visits >= visit_budget:
            return PerfLivenessBuild(live_in, live_out, false, visits, true)
        top = top - 1
        val current_index = worklist[top]
        queued[current_index] = false
        visits = visits + 1
        val current_block = func.blocks[current_index]
        var in_changed = false
        var local_pos = 0
        while local_pos < local_count:
            val bit = current_index * local_count + local_pos
            var new_out = live_out[bit]
            for successor in (successors[current_block.id.id] ?? []):
                val successor_index = block_index[successor.id]
                if live_in[successor_index * local_count + local_pos]:
                    new_out = true
            if new_out and not live_out[bit]:
                live_out[bit] = true
            val new_in = block_use_bits[bit] or (new_out and not block_definition_bits[bit])
            if new_in and not live_in[bit]:
                live_in[bit] = true
                in_changed = true
            local_pos = local_pos + 1
        if in_changed:
            for predecessor in (predecessors[current_block.id.id] ?? []):
                val predecessor_index = block_index[predecessor]
                if not queued[predecessor_index]:
                    if top < worklist.len():
                        worklist[top] = predecessor_index
                    else:
                        worklist.push(predecessor_index)
                    queued[predecessor_index] = true
                    top = top + 1
    PerfLivenessBuild(live_in, live_out, true, visits, false)

fn perf_facts_reverse_postorder(entry: BlockId, successors: Dict<i64, [BlockId]>) -> [BlockId]:
    # Iterative DFS with explicit frames avoids recursion depth and array-slice
    # popping. `top` owns the live prefix of both reusable stacks.
    var visited: Dict<i64, bool> = {}
    var block_stack: [BlockId] = [entry]
    var successor_index_stack: [i64] = [0]
    var top = 1
    var postorder: [BlockId] = []
    visited[entry.id] = true

    while top > 0:
        val frame_index = top - 1
        val block = block_stack[frame_index]
        val block_successors = successors[block.id] ?? []
        val successor_index = successor_index_stack[frame_index]
        if successor_index < block_successors.len():
            successor_index_stack[frame_index] = successor_index + 1
            val successor = block_successors[successor_index]
            if not visited.has(successor.id):
                visited[successor.id] = true
                if top < block_stack.len():
                    block_stack[top] = successor
                    successor_index_stack[top] = 0
                else:
                    block_stack.push(successor)
                    successor_index_stack.push(0)
                top = top + 1
        else:
            postorder.push(block)
            top = top - 1

    var result: [BlockId] = []
    var index = postorder.len()
    while index > 0:
        index = index - 1
        result.push(postorder[index])
    result

fn perf_facts_intersect_idom(first: i64, second: i64, idom: Dict<i64, i64>, rpo_index: Dict<i64, i64>) -> i64:
    var left = first
    var right = second
    while left != right:
        while (rpo_index[left] ?? -1) > (rpo_index[right] ?? -1):
            left = idom[left]
        while (rpo_index[right] ?? -1) > (rpo_index[left] ?? -1):
            right = idom[right]
    left

fn perf_facts_immediate_dominators(entry: BlockId, rpo: [BlockId], rpo_index: Dict<i64, i64>, predecessors: Dict<i64, [i64]>) -> Dict<i64, i64>:
    var idom: Dict<i64, i64> = {}
    idom[entry.id] = entry.id
    var changed = true
    var iteration = 0
    val iteration_limit = rpo.len() * rpo.len() + 1
    while changed and iteration < iteration_limit:
        iteration = iteration + 1
        changed = false
        var index = 1
        while index < rpo.len():
            val block_id = rpo[index].id
            var candidate = -1
            for predecessor in (predecessors[block_id] ?? []):
                if idom.has(predecessor):
                    if candidate < 0:
                        candidate = predecessor
                    else:
                        candidate = perf_facts_intersect_idom(predecessor, candidate, idom, rpo_index)
            if candidate >= 0 and (not idom.has(block_id) or idom[block_id] != candidate):
                idom[block_id] = candidate
                changed = true
            index = index + 1
    if changed:
        # Malformed/non-converging fact construction authorizes no dominance
        # dependent transformation.
        return {}
    idom

fn perf_facts_terminator_successors(term: MirTerminator) -> [BlockId]:
    val empty: [BlockId] = []
    match term:
        case Ret(_) | Unreachable | Abort(_): empty
        case Goto(target): [target]
        case If(_, then_, else_): [then_, else_]
        case Switch(_, targets, default):
            var result: [BlockId] = []
            for target_case in targets:
                result.push(target_case.target)
            result.push(default)
            result
        case CallTerminator(_, _, _, normal, unwind):
            match unwind:
                case Some(unwind_target): [normal, unwind_target]
                case nil: [normal]

fn perf_facts_build_internal(func: MirFunction, include_liveness: bool) -> PerfFacts:
    var successors: Dict<i64, [BlockId]> = {}
    var predecessors: Dict<i64, [i64]> = {}
    var block_index: Dict<i64, i64> = {}
    var local_index: Dict<i64, i64> = {}
    var definition_buckets: [[MirDefUseSite]] = []
    var use_buckets: [[MirDefUseSite]] = []
    var def_use_complete = true
    var uncovered_instruction_count = 0
    var invalid_local_reference_count = 0
    var duplicate_block_identity_count = 0
    var invalid_block_reference_count = 0
    var index = 0

    var local_position = 0
    var declared_locals: [LocalId] = []
    for local in func.locals:
        if local_index.has(local.id.id):
            def_use_complete = false
            invalid_local_reference_count = invalid_local_reference_count + 1
        else:
            local_index[local.id.id] = local_position
            declared_locals.push(local.id)
            definition_buckets.push([])
            use_buckets.push([])
            local_position = local_position + 1

    val local_count = declared_locals.len()
    val fact_cell_count = func.blocks.len() * local_count
    val liveness_cells_admitted = include_liveness and fact_cell_count <= 4000000
    var block_definition_bits: [bool] = []
    var block_use_bits: [bool] = []
    var fact_cell = 0
    while liveness_cells_admitted and fact_cell < fact_cell_count:
        block_definition_bits.push(false)
        block_use_bits.push(false)
        fact_cell = fact_cell + 1

    for block in func.blocks:
        if block_index.has(block.id.id):
            duplicate_block_identity_count = duplicate_block_identity_count + 1
        else:
            block_index[block.id.id] = index
        index = index + 1
        val block_successors = perf_facts_terminator_successors(block.terminator)
        successors[block.id.id] = block_successors
        for successor in block_successors:
            var incoming = predecessors[successor.id] ?? []
            incoming.push(block.id.id)
            predecessors[successor.id] = incoming
        var instruction_index = 0
        for instruction in block.instructions:
            val access = perf_instruction_access(instruction)
            if not access.covered:
                def_use_complete = false
                uncovered_instruction_count = uncovered_instruction_count + 1
            for local in access.uses:
                if local_index.has(local.id):
                    val position = local_index[local.id]
                    use_buckets[position].push(MirDefUseSite(block.id, instruction_index, local, false))
                    if liveness_cells_admitted:
                        val bit = (index - 1) * local_count + position
                        if not block_definition_bits[bit]:
                            block_use_bits[bit] = true
                else:
                    def_use_complete = false
                    invalid_local_reference_count = invalid_local_reference_count + 1
            for local in access.defs:
                if local_index.has(local.id):
                    val position = local_index[local.id]
                    definition_buckets[position].push(MirDefUseSite(block.id, instruction_index, local, false))
                    if liveness_cells_admitted:
                        block_definition_bits[(index - 1) * local_count + position] = true
                else:
                    def_use_complete = false
                    invalid_local_reference_count = invalid_local_reference_count + 1
            instruction_index = instruction_index + 1
        val terminator_access = perf_terminator_access(block.terminator)
        for local in terminator_access.uses:
            if local_index.has(local.id):
                val position = local_index[local.id]
                use_buckets[position].push(MirDefUseSite(block.id, -1, local, true))
                if liveness_cells_admitted:
                    val bit = (index - 1) * local_count + position
                    if not block_definition_bits[bit]:
                        block_use_bits[bit] = true
            else:
                def_use_complete = false
                invalid_local_reference_count = invalid_local_reference_count + 1
        var unwind_edge_definition = -1
        match block.terminator:
            case CallTerminator(dest, _, _, _, unwind):
                if dest.? and unwind.?: unwind_edge_definition = dest.unwrap().id
            case _: pass_dn
        for local in terminator_access.defs:
            if local_index.has(local.id):
                val position = local_index[local.id]
                definition_buckets[position].push(MirDefUseSite(block.id, -1, local, true))
                # A call result exists on the normal edge only. With an unwind
                # edge, a block-level kill would be unsound for the unwind path;
                # omit it until edge-specific liveness is represented.
                if liveness_cells_admitted and local.id != unwind_edge_definition:
                    block_definition_bits[(index - 1) * local_count + position] = true
            else:
                def_use_complete = false
                invalid_local_reference_count = invalid_local_reference_count + 1

    var cfg_complete = duplicate_block_identity_count == 0
    if not block_index.has(func.entry_block.id):
        cfg_complete = false
        invalid_block_reference_count = invalid_block_reference_count + 1
    for block in func.blocks:
        for successor in (successors[block.id.id] ?? []):
            if not block_index.has(successor.id):
                cfg_complete = false
                invalid_block_reference_count = invalid_block_reference_count + 1

    val rpo = if cfg_complete:
        perf_facts_reverse_postorder(func.entry_block, successors)
    else:
        []
    var rpo_index: Dict<i64, i64> = {}
    var rpo_position = 0
    for block in rpo:
        rpo_index[block.id] = rpo_position
        rpo_position = rpo_position + 1
    val idom = if cfg_complete:
        perf_facts_immediate_dominators(func.entry_block, rpo, rpo_index, predecessors)
    else:
        {}
    val liveness = if include_liveness:
        perf_facts_build_liveness(
            func, successors, predecessors, block_index, local_count,
            block_definition_bits, block_use_bits,
            cfg_complete and def_use_complete and liveness_cells_admitted)
    else:
        PerfLivenessBuild([], [], false, 0, false)

    PerfFacts(
        successors: successors,
        predecessors: predecessors,
        block_index: block_index,
        block_count: func.blocks.len(),
        cfg_complete: cfg_complete,
        duplicate_block_identity_count: duplicate_block_identity_count,
        invalid_block_reference_count: invalid_block_reference_count,
        reverse_postorder: rpo,
        rpo_index: rpo_index,
        immediate_dominator: idom,
        locals: declared_locals,
        local_index: local_index,
        definition_buckets: definition_buckets,
        use_buckets: use_buckets,
        def_use_complete: def_use_complete,
        uncovered_instruction_count: uncovered_instruction_count,
        invalid_local_reference_count: invalid_local_reference_count,
        block_definition_bits: block_definition_bits,
        block_use_before_definition_bits: block_use_bits,
        live_in_bits: liveness.live_in_bits,
        live_out_bits: liveness.live_out_bits,
        liveness_complete: liveness.complete,
        liveness_worklist_visits: liveness.worklist_visits,
        liveness_budget_exhausted: liveness.budget_exhausted
    )

fn perf_facts_build(func: MirFunction) -> PerfFacts:
    perf_facts_build_internal(func, true)

fn perf_facts_build_for_verification(func: MirFunction) -> PerfFacts:
    """Build CFG, dominance, and def-use without dense liveness matrices."""
    perf_facts_build_internal(func, false)

fn perf_facts_successors(facts: PerfFacts, block: BlockId) -> [BlockId]:
    facts.successors[block.id] ?? []

fn perf_facts_predecessors(facts: PerfFacts, block: BlockId) -> [i64]:
    facts.predecessors[block.id] ?? []

fn perf_facts_dominates(facts: PerfFacts, dominator: BlockId, block: BlockId) -> bool:
    if not facts.immediate_dominator.has(block.id) or not facts.immediate_dominator.has(dominator.id):
        return false
    var current = block.id
    while true:
        if current == dominator.id:
            return true
        val parent = facts.immediate_dominator[current]
        if parent == current:
            return false
        current = parent

fn perf_facts_definitions(facts: PerfFacts, local: LocalId) -> [MirDefUseSite]:
    if not facts.local_index.has(local.id): return []
    facts.definition_buckets[facts.local_index[local.id]]

fn perf_facts_uses(facts: PerfFacts, local: LocalId) -> [MirDefUseSite]:
    if not facts.local_index.has(local.id): return []
    facts.use_buckets[facts.local_index[local.id]]

fn perf_facts_is_live_in(facts: PerfFacts, block: BlockId, local: LocalId) -> bool:
    if not facts.liveness_complete:
        return false
    if not facts.block_index.has(block.id) or not facts.local_index.has(local.id):
        return false
    val local_count = facts.locals.len()
    facts.live_in_bits[facts.block_index[block.id] * local_count + facts.local_index[local.id]]

fn perf_facts_is_live_out(facts: PerfFacts, block: BlockId, local: LocalId) -> bool:
    if not facts.liveness_complete:
        return false
    if not facts.block_index.has(block.id) or not facts.local_index.has(local.id):
        return false
    val local_count = facts.locals.len()
    facts.live_out_bits[facts.block_index[block.id] * local_count + facts.local_index[local.id]]

export PerfFactKind, PerfFactPreservation, MirDefUseSite, MirInstructionAccess, PerfFacts
export perf_instruction_access, perf_terminator_access
export perf_fact_preservation_all, perf_fact_preservation_none, perf_fact_preservation_cfg_only
export perf_fact_preservation_integrity_errors, perf_facts_invalidated
export perf_facts_build, perf_facts_build_for_verification, perf_facts_terminator_successors
export perf_facts_successors, perf_facts_predecessors
export perf_facts_dominates, perf_facts_definitions, perf_facts_uses
export perf_facts_is_live_in, perf_facts_is_live_out
