# Automatic canonical-MIR producer for compiler-owned typed storage views.
#
# Input MIR is still ordinary fixed-record pointer projection.  Only an
# admitted declaration may authorize replacing the exact
# GEP -> Load(record) -> GetField(address) chain with PROJECT_FIELD.

use compiler.mir.mir_data.*
use compiler.mir.intrinsics.{MIR_STORAGE_ALLOC_OWNED_RAW_V1}
use compiler.mir_opt.mir_opt.perf_facts.{PerfFacts, perf_facts_build_without_liveness, perf_facts_uses}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{
    MIR_STORAGE_PROJECT_FIELD_V1, MirStorageViewSiteBindingV1,
    mir_storage_address_recipe_v1
}
use compiler.mir_opt.mir_opt.storage_access_analysis.{
    analyze_mir_storage_access_summary, mir_storage_region_binding_v1
}
use compiler.mir_opt.mir_opt.typed_storage_view_declaration.{
    MirTypedStorageViewDeclarationV1, admit_mir_typed_storage_view_v1
}

struct MirTypedStorageViewEvidenceV1:
    site: MirStorageViewSiteBindingV1
    allocation_identity: text
    allocation_provenance: text
    source_revision: text
    producer_contract_version: i64
    producer_pattern: text
    bounds_proof_kind: text
    produced_projection_count: i64

struct MirTypedStorageViewProducerResultV1:
    ok: bool
    module: MirModule
    sites: [MirStorageViewSiteBindingV1]
    evidence: [MirTypedStorageViewEvidenceV1]
    produced_count: i64
    reason: text

fn mir_typed_storage_view_producer_failure(
    module: MirModule, reason: text
) -> MirTypedStorageViewProducerResultV1:
    MirTypedStorageViewProducerResultV1(ok: false, module: module, sites: [], evidence: [],
        produced_count: 0, reason: reason)

fn mir_typed_storage_operand_local_v1(operand: MirOperand) -> i64:
    match operand.kind:
        case Copy(local) | Move(local): local.id
        case _: -1

fn mir_typed_storage_instruction_use_count(facts: PerfFacts,
                                            local_id: i64) -> i64:
    if not facts.def_use_complete: return -1
    perf_facts_uses(facts, LocalId(id: local_id)).len()

fn mir_typed_storage_declaration_index(
    declarations: [MirTypedStorageViewDeclarationV1], function_symbol_id: i64,
    base_local_id: i64
) -> (i64, i64):
    var selected = -1
    var count = 0
    var index = 0
    while index < declarations.len():
        val declaration = declarations[index]
        if declaration.function_symbol_id == function_symbol_id
            and declaration.base_local_id == base_local_id:
            selected = index
            count = count + 1
        index = index + 1
    (selected, count)

fn mir_typed_storage_const_before_v1(block: MirBlock, before: i64,
                                     operand: MirOperand) -> (bool, i64):
    match operand.kind:
        case Const(MirConstValue.Int(value), _): return (true, value)
        case Copy(local) | Move(local):
            var index = 0
            while index < before:
                match block.instructions[index].kind:
                    case Const(dest, MirConstValue.Int(value), _):
                        if dest.id == local.id: return (true, value)
                    case _: pass
                index = index + 1
        case _: pass
    (false, 0)

fn mir_typed_storage_const_text_v1(operand: MirOperand) -> text:
    match operand.kind:
        case Const(MirConstValue.Str(value), _): value
        case _: ""

fn mir_typed_storage_has_owned_base_allocation_v1(
    block: MirBlock, before: i64, declaration: MirTypedStorageViewDeclarationV1
) -> bool:
    var index = 0
    while index < before:
        match block.instructions[index].kind:
            case Intrinsic(dest, name, args):
                if name == MIR_STORAGE_ALLOC_OWNED_RAW_V1:
                    if dest.?:
                        if dest.unwrap().id == declaration.base_local_id:
                            if args.len() == 5:
                                val bytes = mir_typed_storage_const_before_v1(
                                    block, index, args[0])
                                val logical_type = mir_typed_storage_const_before_v1(
                                    block, index, args[1])
                                val revision = mir_typed_storage_const_before_v1(
                                    block, index, args[2])
                                val count = mir_typed_storage_const_before_v1(
                                    block, index, args[3])
                                val identity = mir_typed_storage_const_text_v1(args[4])
                                if bytes[0]:
                                    if bytes[1] == declaration.allocation_byte_len:
                                        if logical_type[0]:
                                            if logical_type[1] == declaration.logical_type_id:
                                                if revision[0]:
                                                    if revision[1] == declaration.revision:
                                                        if count[0]:
                                                            if count[1] == declaration.element_count:
                                                                return identity == declaration.allocation_identity
            case _: pass
        index = index + 1
    false

fn produce_mir_typed_storage_views_v1(
    module: MirModule, declarations: [MirTypedStorageViewDeclarationV1]
) -> MirTypedStorageViewProducerResultV1:
    var sites: [MirStorageViewSiteBindingV1] = []
    var evidence: [MirTypedStorageViewEvidenceV1] = []
    var declaration_index = 0
    for declaration in declarations:
        for function_symbol in module.functions.keys():
            if function_symbol.id == declaration.function_symbol_id:
                val summary = analyze_mir_storage_access_summary(
                    module.functions[function_symbol], [
                        mir_storage_region_binding_v1(
                            declaration.base_local_id, declaration_index + 2)
                    ])
                if summary.address_observed:
                    return mir_typed_storage_view_producer_failure(
                        module, "storage-view-address-observed")
                if summary.unknown_access:
                    return mir_typed_storage_view_producer_failure(
                        module, "storage-view-access-unclassified")
        val admitted = admit_mir_typed_storage_view_v1(declaration)
        if not admitted.ok:
            return mir_typed_storage_view_producer_failure(module,
                "typed-storage-declaration:{admitted.reason}")
        sites.push(admitted.site.unwrap())
        evidence.push(MirTypedStorageViewEvidenceV1(site: admitted.site.unwrap(),
            allocation_identity: declaration.allocation_identity,
            allocation_provenance: admitted.allocation_provenance,
            source_revision: admitted.source_revision, producer_contract_version: 1,
            producer_pattern: "same-block-gep-load-getfield-v1",
            bounds_proof_kind: "constant-index-range-v1",
            produced_projection_count: 0))
        declaration_index = declaration_index + 1

    var produced_count = 0
    var declaration_hits: [i64] = []
    for _ in declarations: declaration_hits.push(0)
    var rewritten_functions: Dict<SymbolId, MirFunction> = {}
    for symbol in module.functions.keys():
        val function = module.functions[symbol]
        val perf_facts = perf_facts_build_without_liveness(function)
        if not perf_facts.def_use_complete:
            return mir_typed_storage_view_producer_failure(
                module, "storage-view-def-use-incomplete")
        var blocks: [MirBlock] = []
        for block in function.blocks:
            var instructions: [MirInst] = []
            var index = 0
            while index < block.instructions.len():
                var consumed = false
                if index + 2 < block.instructions.len():
                    val first = block.instructions[index]
                    val second = block.instructions[index + 1]
                    val third = block.instructions[index + 2]
                    match first.kind:
                        case GetElementPtr(gep_dest, base, indices):
                            val base_local_id = mir_typed_storage_operand_local_v1(base)
                            val selected = mir_typed_storage_declaration_index(
                                declarations, symbol.id, base_local_id)
                            if selected[1] > 1:
                                return mir_typed_storage_view_producer_failure(module,
                                    "duplicate-typed-storage-declaration")
                            if selected[0] >= 0 and indices.len() == 1:
                                val declaration = declarations[selected[0]]
                                if not mir_typed_storage_has_owned_base_allocation_v1(
                                    block, index, declaration):
                                    return mir_typed_storage_view_producer_failure(module,
                                        "storage-view-owned-raw-allocation-missing")
                                val proven_index = mir_typed_storage_const_before_v1(
                                    block, index, indices[0])
                                if not proven_index[0] or proven_index[1] < 0
                                    or proven_index[1] >= declaration.element_count:
                                    return mir_typed_storage_view_producer_failure(module,
                                        "storage-view-index-bounds-unproven")
                                match second.kind:
                                    case Load(record_dest, record_ptr):
                                        if mir_typed_storage_operand_local_v1(record_ptr) == gep_dest.id:
                                            match third.kind:
                                                case GetField(field_dest, record, field_id):
                                                    if mir_typed_storage_operand_local_v1(record) == record_dest.id:
                                                        if mir_typed_storage_instruction_use_count(
                                                            perf_facts, gep_dest.id) != 1
                                                            or mir_typed_storage_instruction_use_count(
                                                                perf_facts, record_dest.id) != 1:
                                                            return mir_typed_storage_view_producer_failure(
                                                                module, "storage-projection-temporary-escapes")
                                                        val admitted = admit_mir_typed_storage_view_v1(declaration)
                                                        val recipe = mir_storage_address_recipe_v1(
                                                            admitted.site.unwrap().binding, field_id)
                                                        if not recipe.ok:
                                                            return mir_typed_storage_view_producer_failure(
                                                                module, "typed-storage-field:{recipe.reason}")
                                                        instructions.push(MirInst(
                                                            kind: MirInstKind.Intrinsic(
                                                                Some(gep_dest),
                                                                MIR_STORAGE_PROJECT_FIELD_V1,
                                                                [base, indices[0],
                                                                 MirOperand.const_int(field_id)]),
                                                            span: third.span))
                                                        instructions.push(MirInst(
                                                            kind: MirInstKind.Load(field_dest,
                                                                MirOperand.copy(gep_dest)),
                                                            span: third.span))
                                                        declaration_hits[selected[0]] =
                                                            declaration_hits[selected[0]] + 1
                                                        produced_count = produced_count + 1
                                                        index = index + 3
                                                        consumed = true
                                                case _: pass
                                    case _: pass
                        case _: pass
                if not consumed:
                    var keep = true
                    match block.instructions[index].kind:
                        case Intrinsic(dest, name, args):
                            if name == MIR_STORAGE_ALLOC_OWNED_RAW_V1:
                                # Materialize the admitted owner operation as
                                # the ordinary runtime allocator call. The
                                # compiler-private intrinsic never reaches a
                                # backend.
                                if not dest.? or args.len() != 5:
                                    return mir_typed_storage_view_producer_failure(
                                        module, "invalid-owned-raw-allocation")
                                val alloc_sig = MirSignature(params: [MirType.i64()],
                                    return_type: MirType.i64(), is_variadic: false)
                                val alloc_fn = MirOperand(kind: MirOperandKind.Const(
                                    MirConstValue.Str("rt_alloc"),
                                    MirType(kind: MirTypeKind.FuncPtr(alloc_sig))))
                                instructions.push(MirInst(kind: MirInstKind.Call(
                                    dest, alloc_fn, [args[0]]),
                                    span: block.instructions[index].span))
                                keep = false
                        case _: pass
                    if keep: instructions.push(block.instructions[index])
                    index = index + 1
            blocks.push(MirBlock(id: block.id, label: block.label,
                instructions: instructions, terminator: block.terminator))
        rewritten_functions[symbol] = MirFunction(..function, blocks: blocks)

    declaration_index = 0
    while declaration_index < declaration_hits.len():
        if declaration_hits[declaration_index] == 0:
            return mir_typed_storage_view_producer_failure(module,
                "stale-typed-storage-declaration")
        declaration_index = declaration_index + 1
    var evidence_index = 0
    while evidence_index < evidence.len():
        evidence[evidence_index] = MirTypedStorageViewEvidenceV1(
            ..evidence[evidence_index],
            produced_projection_count: declaration_hits[evidence_index])
        evidence_index = evidence_index + 1
    val rewritten = MirModule(name: module.name, functions: rewritten_functions,
        statics: module.statics, constants: module.constants, types: module.types)
    MirTypedStorageViewProducerResultV1(ok: true, module: rewritten,
        sites: sites, evidence: evidence, produced_count: produced_count, reason: "ok")
