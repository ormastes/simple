# Advisory bridge from typed WP-20 access facts to the frozen layout planner.
#
# This adapter never parses descriptive projection text and never emits alias
# metadata. GPU intent and ABI pinning remain explicit hard inputs.

use compiler.mir_opt.mir_opt.storage_access_analysis.{
    MIR_STORAGE_UNKNOWN_REGION_ID, MirStorageAccessSummaryV1
}
use compiler.common.parallel_policy.policy_schema.{ResolvedMemoryPolicyV1}
use std.common.crypto.sha256.{sha256_text}
use std.common.structural.parallel_commit.access_contracts.{
    parallel_access_mode_to_u8
}
use std.common.structural.storage_layout.planner.{
    StorageLayoutRequestV1, storage_layout_request_v1
}

struct StorageLayoutAccessAdvisoryV1:
    request: StorageLayoutRequestV1
    complete: bool
    independent_field_access: bool
    identity: text

struct StorageLayoutFieldIntervalV1:
    region_id: i64
    start: i64
    end: i64
    field_id: i64

fn storage_layout_interval_less(
    left: StorageLayoutFieldIntervalV1,
    right: StorageLayoutFieldIntervalV1
) -> bool:
    if left.region_id != right.region_id:
        return left.region_id < right.region_id
    if left.start != right.start:
        return left.start < right.start
    if left.end != right.end:
        return left.end < right.end
    left.field_id < right.field_id

fn storage_layout_sort_intervals(
    values: [StorageLayoutFieldIntervalV1]
) -> [StorageLayoutFieldIntervalV1]:
    var result = values
    val count = result.len()
    if count <= 1:
        return result
    var scratch = values
    var width = 1
    while width < count:
        var run_start = 0
        while run_start < count:
            var middle = run_start + width
            if middle > count:
                middle = count
            var run_end = middle + width
            if run_end > count:
                run_end = count
            var left = run_start
            var right = middle
            var output = run_start
            while output < run_end:
                if right < run_end and (left >= middle or
                    storage_layout_interval_less(result[right], result[left])):
                    scratch[output] = result[right]
                    right = right + 1
                else:
                    scratch[output] = result[left]
                    left = left + 1
                output = output + 1
            run_start = run_end
        var copy_index = 0
        while copy_index < count:
            result[copy_index] = scratch[copy_index]
            copy_index = copy_index + 1
        if width > count / 2:
            width = count
        else:
            width = width * 2
    result

fn storage_layout_intervals_overlap(
    left: StorageLayoutFieldIntervalV1,
    right: StorageLayoutFieldIntervalV1
) -> bool:
    left.field_id != right.field_id
        and left.region_id == right.region_id
        and left.start < right.end
        and right.start < left.end

fn storage_layout_has_cross_field_overlap(
    values: [StorageLayoutFieldIntervalV1]
) -> bool:
    val intervals = storage_layout_sort_intervals(values)
    var region_start = 0
    while region_start < intervals.len():
        val region_id = intervals[region_start].region_id
        var index = region_start
        var primary_field = 0
        var primary_end = 0
        var primary_present = false
        var secondary_field = 0
        var secondary_end = 0
        var secondary_present = false
        while index < intervals.len() and intervals[index].region_id == region_id:
            val current = intervals[index]
            if current.end <= current.start:
                # The producer emits proper half-open ranges. Preserve the v1
                # predicate exactly for externally constructed malformed facts.
                var prior = region_start
                while prior < index:
                    if storage_layout_intervals_overlap(intervals[prior], current):
                        return true
                    prior = prior + 1
            elif ((primary_present and primary_field != current.field_id
                    and primary_end > current.start)
                or (primary_present and primary_field == current.field_id
                    and secondary_present and secondary_end > current.start)):
                return true

            if primary_present and primary_field == current.field_id:
                if current.end > primary_end:
                    primary_end = current.end
            elif secondary_present and secondary_field == current.field_id:
                if current.end > secondary_end:
                    secondary_end = current.end
                if secondary_end > primary_end:
                    val old_primary_field = primary_field
                    val old_primary_end = primary_end
                    primary_field = secondary_field
                    primary_end = secondary_end
                    secondary_field = old_primary_field
                    secondary_end = old_primary_end
            elif not primary_present or current.end > primary_end:
                if primary_present:
                    secondary_field = primary_field
                    secondary_end = primary_end
                    secondary_present = true
                primary_field = current.field_id
                primary_end = current.end
                primary_present = true
            elif not secondary_present or current.end > secondary_end:
                secondary_field = current.field_id
                secondary_end = current.end
                secondary_present = true
            index = index + 1
        region_start = index
    false

fn storage_layout_access_advisory_v1(
    summary: MirStorageAccessSummaryV1,
    logical_type_id: i64, schema_field_count: i64,
    element_count: i64, alignment: i64,
    simd_width: i64, gpu_bulk_fields: bool, abi_pinned: bool,
    policy_hash: text
) -> StorageLayoutAccessAdvisoryV1:
    var complete = summary.complete and summary.typed_facts.len() > 0
        and not summary.address_observed and not summary.unknown_access
    var field_id_set: Dict<i64, bool> = {}
    var field_count = 0
    var identity_rows: [text] = []
    for fact in summary.typed_facts:
        if fact.path.region_id == MIR_STORAGE_UNKNOWN_REGION_ID:
            complete = false
        if fact.has_field:
            if fact.field_id < 0 or not fact.path.known_range:
                complete = false
            if not field_id_set.contains_key(fact.field_id):
                field_id_set[fact.field_id] = true
                field_count = field_count + 1
            identity_rows.push("{fact.field_id}|{fact.path.region_id}|{fact.path.start}|{fact.path.end}|{parallel_access_mode_to_u8(fact.path.mode)}")
        elif not fact.structural_record_load:
            complete = false
    if field_count < 2 or schema_field_count <= field_count:
        complete = false

    # Fields consumed together from an overlapping logical element range are
    # co-access, not evidence for physical separation. Invalid evidence already
    # failed closed above, so allocate interval work only for a viable advisory.
    if complete:
        var intervals: [StorageLayoutFieldIntervalV1] = []
        for fact in summary.typed_facts:
            if fact.has_field and fact.path.known_range:
                intervals.push(StorageLayoutFieldIntervalV1(
                    region_id: fact.path.region_id,
                    start: fact.path.start,
                    end: fact.path.end,
                    field_id: fact.field_id))
        if storage_layout_has_cross_field_overlap(intervals):
            complete = false

    identity_rows.sort()

    val independent = complete and field_count >= 2
    val request = storage_layout_request_v1(logical_type_id, element_count,
        alignment, simd_width, gpu_bulk_fields, independent, abi_pinned,
        policy_hash)
    val rows_identity = identity_rows.join(";")
    StorageLayoutAccessAdvisoryV1(request: request, complete: complete,
        independent_field_access: independent,
        identity: "access-advisory-v1|{logical_type_id}|{schema_field_count}|{element_count}|{alignment}|{simd_width}|{gpu_bulk_fields}|{abi_pinned}|{policy_hash.len()}:{policy_hash}|{complete}|{summary.address_observed}|{summary.unknown_access}|{independent}|{rows_identity}")

fn storage_layout_access_advisory_with_memory_policy_v1(
    summary: MirStorageAccessSummaryV1,
    logical_type_id: i64, schema_field_count: i64,
    element_count: i64, alignment: i64,
    simd_width: i64, gpu_bulk_fields: bool, abi_pinned: bool,
    policy_hash: text, memory_policy: ResolvedMemoryPolicyV1
) -> StorageLayoutAccessAdvisoryV1:
    """Apply fail-closed memory constraints before physical selection.

    The policy cannot select a layout. It can only pin address-observed/ABI
    storage or suppress automatic representation conversion. Its canonical
    material is hashed into the planner policy identity so a changed memory
    constraint cannot reuse an incompatible layout receipt/cache entry.
    """
    val effective_abi_pinned = abi_pinned
        or (memory_policy.pin_address_observed_layout and summary.address_observed)
        or (memory_policy.pin_external_abi_layout and abi_pinned)
    val transforms_allowed = not memory_policy.deny_implicit_layout_conversion
        and not effective_abi_pinned
    val effective_simd_width = if transforms_allowed: simd_width else: 1
    val effective_gpu_bulk_fields = if transforms_allowed: gpu_bulk_fields else: false
    val effective_policy_hash = sha256_text(
        "storage-layout-memory-policy-v1|{policy_hash.len()}:{policy_hash}|{memory_policy.canonical_text()}")
    val base = storage_layout_access_advisory_v1(
        summary, logical_type_id, schema_field_count, element_count, alignment,
        effective_simd_width, effective_gpu_bulk_fields, effective_abi_pinned,
        effective_policy_hash)
    if transforms_allowed:
        return base
    val request = storage_layout_request_v1(
        logical_type_id, element_count, alignment, 1, false, false,
        effective_abi_pinned, effective_policy_hash)
    StorageLayoutAccessAdvisoryV1(
        request: request,
        complete: base.complete,
        independent_field_access: false,
        identity: base.identity + "|memory-policy-transform=denied")
