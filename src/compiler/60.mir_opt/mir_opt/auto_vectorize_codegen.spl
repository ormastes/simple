# Auto-Vectorization Pass - Phase 4: Vector Code Generation
#
# Transforms scalar loop bodies into SIMD equivalents.
# Generates prologue (alignment), vector body, and epilogue (remainder).

use compiler.mir.mir_data.{MirInst, MirInstKind, MirTerminator, MirOperand, MirOperandKind, MirBinOp, LocalId, BlockId}
use compiler.mir.mir_instructions.{MirBlock}
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind, MirLocal, LocalKind}
use compiler.mir_opt.mir_opt.auto_vectorize_types.{VectorLoopInfo}
use compiler.mir_opt.mir_opt.simd_opt_metadata.{plugin_hook_vectorize_event}
# `Span` is used in DECLARATION position here (`span: Span?` parameter at
# :307/:424/:436) with NO import of it at all, so the origin walk reports
# `unresolved type: Span` against this module.
use compiler.common.diagnostics.span.{Span}   # declared: src/compiler/00.common/diagnostics/span.spl:7

# ============================================================================
# Vectorization Context and Structures
# ============================================================================

struct VectorizeContext:
    """Context for vectorization transformation."""
    vector_width: i64     # 4 for SSE, 8 for AVX2
    element_type: text    # "f32", "f64", "i32"
    next_local: i64

struct VectorizedLoop:
    """Complete vectorized loop structure."""
    prologue_blocks: [MirBlock]
    vector_blocks: [MirBlock]
    epilogue_blocks: [MirBlock]
    original_loop: VectorLoopInfo

# ============================================================================
# Main Code Generation
# ============================================================================

fn create_vector_loop(
    ctx: VectorizeContext,
    loop_info: VectorLoopInfo,
    body_blocks: [MirBlock]
) -> VectorizedLoop:
    """
    Transform scalar loop to vector + remainder loops.
    Returns complete vectorized loop structure with prologue, body, and epilogue.
    """
    # Generate prologue (alignment and peeling)
    val prologue = generate_prologue(ctx, loop_info)

    # Generate vectorized body
    val vector_body = generate_vector_body(ctx, loop_info, body_blocks)

    # Emit optimization plugin metadata event.
    # kernel_id uses the loop header block id as a stable identifier.
    # changed = true because create_vector_loop is only called when vectorization
    # was decided (cost model approved it in auto_vectorize_cost.spl).
    val kernel_id = "loop_bb{loop_info.header_block.id}"
    plugin_hook_vectorize_event(kernel_id, true)

    # Generate epilogue (remainder loop)
    val epilogue = generate_epilogue(ctx, loop_info, body_blocks)

    VectorizedLoop(
        prologue_blocks: prologue,
        vector_blocks: vector_body,
        epilogue_blocks: epilogue,
        original_loop: loop_info
    )

# ============================================================================
# Prologue Generation
# ============================================================================

fn generate_prologue(ctx: VectorizeContext, loop_info: VectorLoopInfo) -> [MirBlock]:
    """
    Generate prologue code:
    - Alignment checks
    - Loop peeling for alignment
    - Setup for vector loop

    Note: body_blocks are not in scope here; passes empty list to create_peeling_block.
    Callers that have scalar body blocks should call create_peeling_block directly.
    """
    var blocks: [MirBlock] = []

    # Create alignment check block
    val align_block = create_alignment_check_block(ctx, loop_info)
    blocks.push(align_block)

    # Create peeling iterations block (if needed); no body clone available here.
    val peel_block = create_peeling_block(ctx, loop_info, [])
    blocks.push(peel_block)

    blocks


# MirOperandKind.Const is Const(value: MirConstValue, type_: MirType).
#
# Every constant this file emitted was built as `Const("i64", "{n}")` — both
# arguments the wrong TYPE and in the wrong ORDER, so the value was the text
# "i64" and the type was the text "{n}". That is malformed MIR, and it is
# strong evidence the pass has never been exercised end to end: the same
# mistake sat in the unit-test fixture until 2026-09-13, which is exactly what
# you would expect when nothing downstream ever consumed the output.
#
# This helper is the single correct constructor; nothing in this file should
# build a Const any other way.
fn _i64_const(value: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Int(value),
        MirType(kind: MirTypeKind.I64)))

fn create_alignment_check_block(
    ctx: VectorizeContext,
    loop_info: VectorLoopInfo,
    bound_op: MirOperand,
    index_local: LocalId,
    remainder_block_id: i64
) -> MirBlock:
    """
    Loop preheader: start the index, and take the vector path only if at least
    one whole vector fits.

      BB_align_check:
        %i    = start                       # seed the shared induction variable
        %lim  = bound - chunk_width
        %fits = %i <= %lim
        If(%fits, BB_vec_loop, BB_remainder)

    This used to compute `(end - start) % VF` from CONSTANTS and branch to a
    "peel" block, which is why it could not serve a loop whose length is only
    known at runtime. The remainder is no longer a special block — it is the
    scalar clone — so the only question left here is whether the vector loop
    should be entered at all. For a bound smaller than one vector the answer
    is no and control goes straight to the scalar loop, which is also the
    correct behaviour for an empty loop.

    Seeding `%i` matters: the vector loop and the scalar remainder share this
    one induction variable, and that sharing is what lets the remainder resume
    from exactly where the vector loop stopped.

    Block IDs:
      ctx.next_local + 0 = this block
      ctx.next_local + 2 = vector loop entry
    """
    val block_id = BlockId.new(ctx.next_local)
    val vec_id   = BlockId.new(ctx.next_local + 2)

    val vf_op = _i64_const(ctx.vector_width)
    val lim_dest  = LocalId(id: ctx.next_local + 207)
    val fits_dest = LocalId(id: ctx.next_local + 208)

    val seed_inst = MirInst(
        kind: MirInstKind.Const(index_local,
            MirConstValue.Int(loop_info.start_value),
            MirType(kind: MirTypeKind.I64)),
        span: nil
    )
    val lim_inst = MirInst(
        kind: MirInstKind.BinOp(lim_dest, MirBinOp.Sub, bound_op, vf_op),
        span: nil
    )
    val fits_inst = MirInst(
        kind: MirInstKind.BinOp(fits_dest, MirBinOp.Le,
            MirOperand(kind: MirOperandKind.Copy(index_local)),
            MirOperand(kind: MirOperandKind.Copy(lim_dest))),
        span: nil
    )

    MirBlock(
        id:           block_id,
        label:        Some("align_check"),
        instructions: [seed_inst, lim_inst, fits_inst],
        terminator:   MirTerminator.If(
            cond:  MirOperand(kind: MirOperandKind.Copy(fits_dest)),
            then_: vec_id,
            else_: BlockId.new(remainder_block_id)))


# ============================================================================
# Runtime alias guard (loop versioning)
# ============================================================================

fn element_size_bytes(element_type: text) -> i64:
    """Byte width of one lane element; 0 for an unrecognised type."""
    if element_type == "f32" or element_type == "i32" or element_type == "u32":
        return 4
    if element_type == "f64" or element_type == "i64" or element_type == "u64":
        return 8
    if element_type == "i16" or element_type == "u16":
        return 2
    if element_type == "i8" or element_type == "u8":
        return 1
    0

fn create_alias_guard_block(
    block_id: i64,
    out_base: LocalId,
    input_bases: [LocalId],
    span_bytes: i64,
    safe_target: i64,
    scalar_target: i64,
    first_temp: i64
) -> MirBlock:
    """
    Emit the runtime range check the alias oracle asks for, as the loop
    versioning entry block.

    For each input base this computes

        diff_k  = out_base - in_base_k
        safe_k  = (diff_k == 0) | (diff_k >= span) | (diff_k <= -span)

    and branches to `safe_target` (the vector path) only when every safe_k
    holds, otherwise to `scalar_target` (an unmodified clone of the original
    loop). That is exactly `alias_guard_safe_at_runtime` in
    auto_vectorize_alias.spl, which is unit-tested against this predicate --
    the pure function exists so this block can be checked against something
    other than itself.

    The `diff == 0` disjunct is what admits an exact alias: with every access
    at the induction index, identical bases touch the same element in the same
    iteration, so vector order equals scalar order.
    """
    var insts: [MirInst] = []
    var temp = first_temp
    var acc_local = LocalId(id: -1)

    for in_base in input_bases:
        val diff = LocalId(id: temp)
        val is_eq = LocalId(id: temp + 1)
        val is_hi = LocalId(id: temp + 2)
        val is_lo = LocalId(id: temp + 3)
        val or1   = LocalId(id: temp + 4)
        val safe_k = LocalId(id: temp + 5)

        insts.push(MirInst(kind: MirInstKind.BinOp(diff, MirBinOp.Sub,
            MirOperand(kind: MirOperandKind.Copy(out_base)),
            MirOperand(kind: MirOperandKind.Copy(in_base))), span: nil))
        insts.push(MirInst(kind: MirInstKind.BinOp(is_eq, MirBinOp.Eq,
            MirOperand(kind: MirOperandKind.Copy(diff)), _i64_const(0)), span: nil))
        insts.push(MirInst(kind: MirInstKind.BinOp(is_hi, MirBinOp.Ge,
            MirOperand(kind: MirOperandKind.Copy(diff)), _i64_const(span_bytes)), span: nil))
        insts.push(MirInst(kind: MirInstKind.BinOp(is_lo, MirBinOp.Le,
            MirOperand(kind: MirOperandKind.Copy(diff)), _i64_const(0 - span_bytes)), span: nil))
        insts.push(MirInst(kind: MirInstKind.BinOp(or1, MirBinOp.BitOr,
            MirOperand(kind: MirOperandKind.Copy(is_eq)),
            MirOperand(kind: MirOperandKind.Copy(is_hi))), span: nil))
        insts.push(MirInst(kind: MirInstKind.BinOp(safe_k, MirBinOp.BitOr,
            MirOperand(kind: MirOperandKind.Copy(or1)),
            MirOperand(kind: MirOperandKind.Copy(is_lo))), span: nil))

        if acc_local.id < 0:
            acc_local = safe_k
        else:
            val combined = LocalId(id: temp + 6)
            insts.push(MirInst(kind: MirInstKind.BinOp(combined, MirBinOp.BitAnd,
                MirOperand(kind: MirOperandKind.Copy(acc_local)),
                MirOperand(kind: MirOperandKind.Copy(safe_k))), span: nil))
            acc_local = combined
        temp = temp + 8

    MirBlock(
        id:           BlockId.new(block_id),
        label:        Some("alias_check"),
        instructions: insts,
        terminator:   MirTerminator.If(
            cond:  MirOperand(kind: MirOperandKind.Copy(acc_local)),
            then_: BlockId.new(safe_target),
            else_: BlockId.new(scalar_target)))

fn create_scalar_version_block(original: MirBlock, new_id: i64) -> MirBlock:
    """
    The unmodified loop, kept as the versioning fallback.

    `create_peeling_block` covers only the REMAINDER after the vector loop, so
    it cannot serve as the alias fallback -- a loop that may alias must run
    entirely scalar, not partly. This is the original body verbatim with its
    self-loop retargeted to its new id; every other branch target, including
    the loop exit, is preserved.
    """
    val retargeted = _retarget_self_loop(original.terminator, original.id.id, new_id)
    MirBlock(
        id:           BlockId.new(new_id),
        label:        Some("scalar_version"),
        instructions: original.instructions,
        terminator:   retargeted)

fn _retarget_self_loop(t: MirTerminator, old_id: i64, new_id: i64) -> MirTerminator:
    """Point a back-edge at the clone instead of the block it was copied from."""
    match t:
        case Goto(target):
            if target.id == old_id:
                MirTerminator.Goto(target: BlockId.new(new_id))
            else:
                t
        case If(cond, then_, else_):
            MirTerminator.If(
                cond: cond,
                then_: if then_.id == old_id: BlockId.new(new_id) else: then_,
                else_: if else_.id == old_id: BlockId.new(new_id) else: else_)
        case _:
            t

fn create_peeling_block(ctx: VectorizeContext, loop_info: VectorLoopInfo, body_blocks: [MirBlock]) -> MirBlock:
    """
    Create scalar-fixup peeling block that runs the loop body for the misaligned
    suffix (remainder iterations after the vector loop).

    When body_blocks is non-empty and mismatch > 0 (static trip count with
    trip_count % VF != 0), clones the scalar body instructions from body_blocks[0]
    for the remainder iterations.  Terminates with Goto(BB_vector_exit).

    When body_blocks is empty or mismatch == 0 (divisible trip count or dynamic
    sentinel end_value=0), emits zero instructions and falls through to the
    vector loop entry (BB_vector).  This covers the dynamic-n case where trip
    count is unknown at compile time.

    MIR shape produced (mismatch > 0, body_blocks non-empty):
      BB_peel:
        # Clone of scalar body instructions for one iteration per remainder step.
        # Inline unrolled for mismatch iterations; control flow: Goto(BB_vec_exit).
        Goto(BB_exit)

    MIR shape produced (mismatch == 0 or body_blocks empty):
      BB_peel:
        Goto(BB_vector)   # fall-through: no remainder work needed

    Block IDs:
      ctx.next_local+1 = this peel block
      ctx.next_local+2 = vector loop entry (falls through when no peel needed)
    """
    val block_id = BlockId.new(ctx.next_local + 1)
    val vec_id   = BlockId.new(ctx.next_local + 2)

    # Compute static mismatch: how many scalar iterations remain after vector loop.
    # mismatch > 0 only when loop.end_value > 0 and end_value % vector_width != 0.
    val mismatch = if loop_info.end_value > 0: loop_info.end_value % ctx.vector_width else: 0

    val has_body = body_blocks.len() > 0

    if (mismatch > 0) and has_body:
        # Clone the scalar body instructions from the first body block.
        # Conservative approximation: emit one pass of the scalar body
        # (handles 1 remainder iteration).  Full SCEV-based unrolling of
        # mismatch iterations is deferred to a follow-up wave.
        val first_block = body_blocks[0]
        val source_insts = first_block.instructions
        var peel_insts: [MirInst] = []
        for inst in source_insts:
            peel_insts.push(inst)

        # Terminate: jump to continuation (the block after the three new blocks).
        val exit_id = BlockId.new(ctx.next_local + 3)
        val terminator = MirTerminator.Goto(exit_id)

        MirBlock(
            id:           block_id,
            label:        Some("peel_loop"),
            instructions: peel_insts,
            terminator:   terminator
        )
    else:
        # No remainder work: fall through to vector loop entry (or exit).
        val terminator = MirTerminator.Goto(vec_id)

        MirBlock(
            id:           block_id,
            label:        Some("peel_loop"),
            instructions: [],
            terminator:   terminator
        )

# ============================================================================
# Vector Body Generation
# ============================================================================

fn generate_vector_body(ctx: VectorizeContext, loop_info: VectorLoopInfo, body_blocks: [MirBlock]) -> [MirBlock]:
    """
    Generate vectorized loop body.
    Replaces scalar operations with SIMD equivalents.
    """
    var new_blocks: [MirBlock] = []

    # For each block in original loop
    for orig_block in body_blocks:
        var vector_insts: [MirInst] = []

        # Transform each instruction
        for inst in orig_block.instructions:
            val vectorized = vectorize_instruction(ctx, inst)
            if vectorized.?:
                vector_insts.push(vectorized.unwrap())

        # Create new block with vectorized instructions
        val new_block = MirBlock(
            id: orig_block.id,
            label: orig_block.label,
            instructions: vector_insts,
            terminator: orig_block.terminator
        )
        new_blocks.push(new_block)

    new_blocks

# ============================================================================
# Epilogue Generation
# ============================================================================

fn generate_epilogue(ctx: VectorizeContext, loop_info: VectorLoopInfo, body_blocks: [MirBlock]) -> [MirBlock]:
    """
    Generate epilogue (remainder loop).
    Handles last few iterations when trip count not multiple of vector width.
    Uses original scalar code.
    """
    var epilogue_blocks: [MirBlock] = []

    # Create remainder loop with scalar code
    for orig_block in body_blocks:
        # Keep original scalar instructions
        val remainder_block = MirBlock(
            id: BlockId.new(orig_block.id.id + 1000),  # Offset IDs
            label: Some("remainder_{orig_block.id.id}"),
            instructions: orig_block.instructions,
            terminator: orig_block.terminator
        )
        epilogue_blocks.push(remainder_block)

    epilogue_blocks

# ============================================================================
# Instruction Vectorization
# ============================================================================

fn vectorize_instruction(ctx: VectorizeContext, inst: MirInst) -> MirInst?:
    """
    Transform a scalar instruction to its SIMD equivalent.
    Returns nil if instruction cannot be vectorized.
    """
    match inst.kind:
        case BinOp(dest, op, left, right):
            vectorize_binop(ctx, dest, op, left, right, inst.span)

        case Load(dest, ptr):
            # Convert to vector load
            vectorize_load(ctx, dest, ptr, inst.span)

        case Store(ptr, value):
            # Convert to vector store
            vectorize_store(ctx, ptr, value, inst.span)

        case GetElementPtr(dest, base, indices):
            # Keep GEP but adjust for vector width
            Some(inst)

        case _:
            # Other instructions keep as-is
            Some(inst)

fn vectorize_binop(ctx: VectorizeContext, dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand, span: Span?) -> MirInst?:
    """Vectorize binary operation."""
    match op:
        case Add:
            if ctx.element_type == "f32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdAddF32x4(dest, left, right), span: span))
            elif ctx.element_type == "f32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdAddF32x8(dest, left, right), span: span))
            elif ctx.element_type == "f64" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdAddF64x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdAddI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdAddI32x8(dest, left, right), span: span))
            else:
                nil

        case Sub:
            if ctx.element_type == "f32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdSubF32x4(dest, left, right), span: span))
            elif ctx.element_type == "f32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdSubF32x8(dest, left, right), span: span))
            elif ctx.element_type == "f64" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdSubF64x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdSubI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdSubI32x8(dest, left, right), span: span))
            else:
                nil

        case Mul:
            if ctx.element_type == "f32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdMulF32x4(dest, left, right), span: span))
            elif ctx.element_type == "f32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdMulF32x8(dest, left, right), span: span))
            elif ctx.element_type == "f64" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdMulF64x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdMulI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdMulI32x8(dest, left, right), span: span))
            else:
                nil

        case Div:
            if ctx.element_type == "f32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdDivF32x4(dest, left, right), span: span))
            elif ctx.element_type == "f32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdDivF32x8(dest, left, right), span: span))
            elif ctx.element_type == "f64" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdDivF64x4(dest, left, right), span: span))
            else:
                nil

        case BitAnd:
            if ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdAndI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdAndI32x8(dest, left, right), span: span))
            else:
                val name = "simd_and_{ctx.element_type}x{ctx.vector_width}"
                Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case BitOr:
            if ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdOrI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdOrI32x8(dest, left, right), span: span))
            else:
                val name = "simd_or_{ctx.element_type}x{ctx.vector_width}"
                Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case BitXor:
            if ctx.element_type == "i32" and ctx.vector_width == 4:
                Some(MirInst(kind: MirInstKind.SimdXorI32x4(dest, left, right), span: span))
            elif ctx.element_type == "i32" and ctx.vector_width == 8:
                Some(MirInst(kind: MirInstKind.SimdXorI32x8(dest, left, right), span: span))
            else:
                val name = "simd_xor_{ctx.element_type}x{ctx.vector_width}"
                Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Lt:
            val name = "simd_cmp_lt_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Gt:
            val name = "simd_cmp_gt_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Eq:
            val name = "simd_cmp_eq_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Ne:
            val name = "simd_cmp_ne_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Le:
            val name = "simd_cmp_le_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Ge:
            val name = "simd_cmp_ge_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Shl:
            val name = "simd_shl_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case Shr:
            val name = "simd_shr_{ctx.element_type}x{ctx.vector_width}"
            Some(MirInst(kind: MirInstKind.Intrinsic(Some(dest), name, [left, right]), span: span))

        case _:
            nil

fn vectorize_load(ctx: VectorizeContext, dest: LocalId, ptr: MirOperand, span: Span?) -> MirInst?:
    """
    Vectorize load instruction.
    Converts scalar load to vector load.
    """
    # Create vector load intrinsic
    val load_name = "simd_load_{ctx.element_type}x{ctx.vector_width}"
    Some(MirInst(
        kind: MirInstKind.Intrinsic(Some(dest), load_name, [ptr]),
        span: span
    ))

fn vectorize_store(ctx: VectorizeContext, ptr: MirOperand, value: MirOperand, span: Span?) -> MirInst?:
    """
    Vectorize store instruction.
    Converts scalar store to vector store.
    """
    # Create vector store intrinsic
    val store_name = "simd_store_{ctx.element_type}x{ctx.vector_width}"
    Some(MirInst(
        kind: MirInstKind.Intrinsic(nil, store_name, [ptr, value]),
        span: span
    ))

# ============================================================================
# Vector Load/Store Helpers
# ============================================================================

# ============================================================================
# Vector memory and arithmetic — REAL MIR SIMD instructions
#
# These used to emit `MirInstKind.Intrinsic` addressed by STRING NAME
# ("simd_load_f32x16", "simd_add_i32x4", ...). Nothing in the tree implements
# those names: `simd_lowering.spl` knows exactly three (simd_add/mul/sub_f32x4
# — no load, no store, no other width), and the MIR interpreter has no case
# for them at all. So the vector loop this file produced could never run or be
# lowered, which is why four rounds of structural tests passed over a loop body
# no backend could consume.
#
# `MirSimdLoad` / `MirSimdBinop` / `MirSimdStore` are real instruction kinds
# the MIR interpreter already executes (mir_interpreter.spl:702-727, backed by
# the Vec16f/Vec8d/Vec16i lane model in mir_simd_interpreter.spl). Emitting
# those makes the output executable, which is the precondition for any
# differential test of the rewrite.
# ============================================================================

fn vector_mir_type(element_type: text, lanes: i64) -> MirType?:
    """Map (element, lane count) to the vector MirType the interpreter models.

    Returns nil for a combination it does not model — the caller must decline
    rather than emit a vector type nothing can shape.
    """
    if element_type == "f32":
        if lanes == 4: return Some(MirType(kind: MirTypeKind.Vec4f))
        if lanes == 8: return Some(MirType(kind: MirTypeKind.Vec8f))
        if lanes == 16: return Some(MirType(kind: MirTypeKind.Vec16f))
        return nil
    if element_type == "f64":
        if lanes == 4: return Some(MirType(kind: MirTypeKind.Vec4d))
        if lanes == 8: return Some(MirType(kind: MirTypeKind.Vec8d))
        return nil
    if element_type == "i32":
        if lanes == 4: return Some(MirType(kind: MirTypeKind.Vec4i))
        if lanes == 8: return Some(MirType(kind: MirTypeKind.Vec8i))
        if lanes == 16: return Some(MirType(kind: MirTypeKind.Vec16i))
        return nil
    nil

fn simd_binop_name(op_name: text) -> text?:
    """Map the recipe op name to the interpreter's SimdBinop spelling."""
    if op_name.contains("add"): Some("Add")
    elif op_name.contains("sub"): Some("Sub")
    elif op_name.contains("mul"): Some("Mul")
    elif op_name.contains("xor"): Some("Xor")
    else: nil

fn create_vector_addr(dest: LocalId, base: LocalId, offset: LocalId) -> MirInst:
    """Address of the vector slice: base + offset, as a real GEP."""
    MirInst(
        kind: MirInstKind.GetElementPtr(dest, MirOperand.copy(base), [MirOperand.copy(offset)]),
        span: nil
    )

fn create_vector_load_typed(dest: LocalId, addr: LocalId, vec_type: MirType) -> MirInst:
    MirInst(
        kind: MirInstKind.MirSimdLoad(dest, MirOperand.copy(addr), false, vec_type),
        span: nil
    )

fn create_vector_store_typed(value: LocalId, addr: LocalId) -> MirInst:
    MirInst(
        kind: MirInstKind.MirSimdStore(MirOperand.copy(value), MirOperand.copy(addr), false),
        span: nil
    )

fn create_vector_binop(dest: LocalId, lhs: LocalId, rhs: LocalId, op: text) -> MirInst:
    MirInst(
        kind: MirInstKind.MirSimdBinop(dest, MirOperand.copy(lhs), MirOperand.copy(rhs), op),
        span: nil
    )

# ============================================================================
# N1 Wave — Vector Loop Block (elementwise-add)
# ============================================================================


fn _vec_block_instructions(body: [MirInst], inc_inst: MirInst, guard_inst: MirInst) -> [MirInst]:
    """Vector body followed by the index bump and exit guard.

    `body` is EMPTY when the element/lane combination has no vector MirType or
    the op has no SimdBinop spelling. That is deliberate: emitting a loop with
    no vector work, rather than one full of instructions nothing implements,
    keeps the failure visible to the caller instead of deferring it to a
    backend that will reject the whole function.
    """
    var out: [MirInst] = []
    for i in body:
        out.push(i)
    out.push(inc_inst)
    out.push(guard_inst)
    out

fn vector_loop_locals(ctx: VectorizeContext, base_block_id: i64) -> [MirLocal]:
    """Declare every local `create_vector_loop_block` writes, WITH its type.

    This is not bookkeeping. `x86_plan_avx512_fixed`
    (x86_64_avx512_isel.spl:53-59) derives every vector shape from
    `func.locals` declared types and from nothing else — inference only
    propagates across copies and mask ops, and `MirSimdLoad` carries its
    vector type but is CHECKED against the shape rather than seeding it. So a
    vector temporary that is absent from `func.locals` has no shape, and the
    AVX-512 selector rejects the whole function with
    `avx512-load-splat-gather-shape-mismatch`.

    Measured before this existed: the rewrite emitted 4 SIMD instructions and
    declared 0 vector locals, so the pass produced NO AVX-512 on the native
    path however correct its MIR was. Every check in place at the time stopped
    at the MIR and could not see it.

    Returns an empty list when the element/lane combination has no vector
    MirType — the vector body is empty in that case, so there is nothing to
    declare.
    """
    val vt_opt = vector_mir_type(ctx.element_type, ctx.vector_width)
    if not vt_opt.?:
        return []
    val vt = vt_opt.unwrap()
    var out: [MirLocal] = []
    # The three vector values: the two loaded slices and the result.
    for id in [base_block_id + 201, base_block_id + 202, base_block_id + 203]:
        out.push(MirLocal(id: LocalId(id: id), name: nil, type_: vt,
            kind: LocalKind.Temp, is_ghost: false))
    # Induction index, exit-guard flag, and the three slice addresses are
    # scalar. They are declared for the same reason: an undeclared local has
    # no type entry for any consumer, not just the AVX-512 planner.
    for id in [base_block_id + 205, base_block_id + 206,
               base_block_id + 207, base_block_id + 208,
               base_block_id + 210, base_block_id + 211, base_block_id + 212]:
        out.push(MirLocal(id: LocalId(id: id), name: nil,
            type_: MirType(kind: MirTypeKind.I64),
            kind: LocalKind.Temp, is_ghost: false))
    out

fn create_vector_loop_block(
    ctx: VectorizeContext,
    base_block_id: i64,
    input_bases: [LocalId],
    output_base: LocalId,
    op_name: text,
    bound_op: MirOperand,
    index_local: LocalId,
    remainder_block_id: i64
) -> MirBlock:
    """
    Create the SIMD vector-loop block for a supported elementwise pattern.

    Emits (for chunk_width=4, element_type=i32, index local %i):

      BB_vec_loop:
        %addr_a = GEP(a_base, %i)      %va   = MirSimdLoad(%addr_a, Vec4i)
        %addr_b = GEP(b_base, %i)      %vb   = MirSimdLoad(%addr_b, Vec4i)
        %vres   = MirSimdBinop(%va, %vb, "Add")
        %addr_o = GEP(out_base, %i)    MirSimdStore(%vres, %addr_o)
        %i      = %i + chunk_width               # advance by a whole vector
        %lim    = bound - chunk_width            # last index a full chunk fits
        %cond   = %i <= %lim
        If(%cond, BB_vec_loop, BB_remainder)

    Two things here are load-bearing and were not true before.

    **The index is the loop's own induction variable**, not a private counter.
    That is what lets the vector loop hand control to an unmodified clone of the
    scalar body for whatever is left: the clone re-tests its own `i < n` and
    finishes the tail from exactly where the vector loop stopped. A private
    counter cannot do that, which is why the old code needed a "peel" block —
    and that peel ran ONE iteration and branched to a block that did not exist
    (D7), so remainder trip counts had to be refused outright.

    **The bound is an OPERAND, not a constant.** A constant bound can only come
    from a loop whose length is known at compile time. Real code — a request
    body, a row set, a framebuffer sized at runtime — has a bound that is a
    local, and passing `Copy(n)` here is the whole reason such loops can now be
    vectorized at all. `%i <= bound - VF` is the standard "does another full
    vector fit" test and is correct for both: for a constant bound it folds.

    Block IDs allocated:
      base_block_id + 2 = this vector-loop block (matches vec_id in alignment_check)

    bound_op: the loop's upper bound. `_i64_const(n)` for a static trip count,
              `Copy(local)` for a runtime one.
    index_local: the loop induction variable, shared with the scalar remainder.
    remainder_block_id: the scalar clone that finishes the tail.
    """
    val block_id = BlockId.new(base_block_id + 2)

    # The induction variable IS the vector index — see the note above.
    val vi_local  = index_local
    val va_local  = LocalId(id: base_block_id + 201)  # loaded vector a
    val vb_local  = LocalId(id: base_block_id + 202)  # loaded vector b
    val vres_local = LocalId(id: base_block_id + 203) # result vector

    # Choose base arrays (default to sentinel locals if input_bases is short)
    val a_base = if input_bases.len() > 0: input_bases[0] else: LocalId(id: 0)
    val b_base = if input_bases.len() > 1: input_bases[1] else: LocalId(id: 1)

    # Real SIMD MIR, not string-named intrinsics. See the note above
    # vector_mir_type: the old `simd_load_f32x16`-style names had no
    # implementation anywhere, so this loop could never run or be lowered.
    val vt_opt = vector_mir_type(ctx.element_type, ctx.vector_width)
    val op_opt = simd_binop_name(op_name)
    # Address locals for the three slices.
    val addr_a = LocalId(id: base_block_id + 210)
    val addr_b = LocalId(id: base_block_id + 211)
    val addr_o = LocalId(id: base_block_id + 212)

    var body: [MirInst] = []
    if vt_opt.? and op_opt.?:
        val vt = vt_opt.unwrap()
        body.push(create_vector_addr(addr_a, a_base, vi_local))
        body.push(create_vector_load_typed(va_local, addr_a, vt))
        body.push(create_vector_addr(addr_b, b_base, vi_local))
        body.push(create_vector_load_typed(vb_local, addr_b, vt))
        body.push(create_vector_binop(vres_local, va_local, vb_local, op_opt.unwrap()))
        body.push(create_vector_addr(addr_o, output_base, vi_local))
        body.push(create_vector_store_typed(vres_local, addr_o))

    # %vi = vi + chunk_width
    #
    # This writes back into the induction local itself. It previously wrote a
    # SEPARATE local (`vi1`) and left `vi` untouched, so the back-edge below
    # re-entered with the same index every time: an infinite loop, which is
    # exactly what the execution-level differential test reported the first
    # time this function was actually run.
    val vf_op = _i64_const(ctx.vector_width)
    val inc_inst = MirInst(
        kind: MirInstKind.BinOp(
            vi_local,
            MirBinOp.Add,
            MirOperand(kind: MirOperandKind.Copy(vi_local)),
            vf_op
        ),
        span: nil
    )

    # %lim = bound - chunk_width; %cond = %i <= %lim.
    #
    # "Does another WHOLE vector fit" — not "are there iterations left". The
    # difference is the entire correctness argument for a runtime bound: a
    # `%i < n` test would enter the body with fewer than VF elements remaining
    # and read past the end of all three arrays.
    val vlim_local  = LocalId(id: base_block_id + 206)
    val vcond_local = LocalId(id: base_block_id + 205)
    val lim_inst = MirInst(
        kind: MirInstKind.BinOp(vlim_local, MirBinOp.Sub, bound_op, vf_op),
        span: nil
    )
    val guard_inst = MirInst(
        kind: MirInstKind.BinOp(
            vcond_local,
            MirBinOp.Le,
            MirOperand(kind: MirOperandKind.Copy(vi_local)),
            MirOperand(kind: MirOperandKind.Copy(vlim_local))
        ),
        span: nil
    )

    # Back-edge while another full vector fits; otherwise the scalar clone
    # finishes the tail from the index this loop stopped at.
    val terminator = MirTerminator.If(
        cond:  MirOperand(kind: MirOperandKind.Copy(vcond_local)),
        then_: block_id,
        else_: BlockId.new(remainder_block_id)
    )

    var insts: [MirInst] = []
    for i in body:
        insts.push(i)
    insts.push(inc_inst)
    insts.push(lim_inst)
    insts.push(guard_inst)

    MirBlock(
        id:           block_id,
        label:        Some("vec_loop"),
        instructions: insts,
        terminator:   terminator
    )

fn _elementwise_op_stem(op_name: text) -> text:
    """Map recipe operation names to the vector intrinsic stem."""
    if op_name == "sub_elementwise":
        return "sub"
    if op_name == "mul_elementwise":
        return "mul"
    if op_name == "xor_elementwise":
        return "xor"
    "add"

