# Conservative logical storage-access facts for layout planning.
#
# This pass does not choose a physical layout and does not emit alias metadata.
# Region identities come from an ownership-analysis binding supplied by the
# caller. Unbound locals collapse into region 1 so missing evidence can only
# add conflicts, never manufacture disjointness.

use compiler.mir.mir_data.*
use compiler.mir_opt.mir_opt.perf_facts.{perf_facts_build_without_liveness, perf_facts_uses}
use std.common.structural.parallel_commit.access_contracts.{
    ParallelAccessMode,
    ParallelAccessPathV1,
    parallel_access_path_v1
}

val MIR_STORAGE_UNKNOWN_REGION_ID: i64 = 1

struct MirStorageRegionBindingV1:
    local_id: i64
    region_id: i64

struct MirStorageProjectionV1:
    region_id: i64
    start: i64
    end: i64
    known_range: bool
    projection: text

struct MirStorageAccessFactV1:
    path: ParallelAccessPathV1
    has_field: bool
    field_id: i64
    structural_record_load: bool

struct MirStorageAccessSummaryV1:
    accesses: [ParallelAccessPathV1]
    typed_facts: [MirStorageAccessFactV1]
    address_observed: bool
    unknown_access: bool
    complete: bool

fn mir_storage_region_binding_v1(local_id: i64, region_id: i64) -> MirStorageRegionBindingV1:
    MirStorageRegionBindingV1(local_id: local_id, region_id: region_id)

fn mir_storage_bindings_well_formed(bindings: [MirStorageRegionBindingV1]) -> bool:
    var i = 0
    while i < bindings.len():
        if bindings[i].local_id < 0 or bindings[i].region_id <= MIR_STORAGE_UNKNOWN_REGION_ID:
            return false
        var j = i + 1
        while j < bindings.len():
            if bindings[i].local_id == bindings[j].local_id:
                return false
            j = j + 1
        i = i + 1
    true

fn mir_storage_binding_region(bindings: [MirStorageRegionBindingV1], local_id: i64) -> i64:
    for binding in bindings:
        if binding.local_id == local_id and binding.region_id > MIR_STORAGE_UNKNOWN_REGION_ID:
            return binding.region_id
    MIR_STORAGE_UNKNOWN_REGION_ID

fn mir_storage_operand_local(operand: MirOperand) -> i64:
    match operand.kind:
        case Copy(local): local.id
        case Move(local): local.id
        case _: -1

fn mir_storage_projection_for_operand(
    operand: MirOperand,
    projections: {i64: MirStorageProjectionV1},
    bindings: [MirStorageRegionBindingV1]
) -> MirStorageProjectionV1:
    val local_id = mir_storage_operand_local(operand)
    if local_id >= 0 and projections.has(local_id):
        return projections[local_id]
    MirStorageProjectionV1(
        region_id: mir_storage_binding_region(bindings, local_id),
        start: 0, end: 0, known_range: false, projection: "whole")

fn mir_storage_index_projection(
    base: MirStorageProjectionV1,
    indices: [MirOperand]
) -> MirStorageProjectionV1:
    if base.projection == "whole" and indices.len() == 1:
        match indices[0].kind:
            case Const(MirConstValue.Int(index), _):
                if index >= 0 and index < 9223372036854775807:
                    return MirStorageProjectionV1(
                        region_id: base.region_id, start: index, end: index + 1,
                        known_range: true, projection: "index:{index}")
            case _:
                pass
    MirStorageProjectionV1(
        region_id: base.region_id, start: 0, end: 0,
        known_range: false, projection: "index:*")

fn mir_storage_field_projection(base: MirStorageProjectionV1, field: i64) -> MirStorageProjectionV1:
    val prefix = if base.projection == "whole": "" else: "{base.projection}."
    MirStorageProjectionV1(
        region_id: base.region_id, start: base.start, end: base.end,
        known_range: base.known_range,
        projection: "{prefix}field:{field}")

fn mir_storage_operand_has_address(
    operand: MirOperand, address_locals: {i64: bool},
    bindings: [MirStorageRegionBindingV1]
) -> bool:
    val local_id = mir_storage_operand_local(operand)
    if local_id < 0: return false
    if address_locals.has(local_id): return address_locals[local_id]
    mir_storage_binding_region(bindings, local_id) != MIR_STORAGE_UNKNOWN_REGION_ID

fn mir_storage_call_name(operand: MirOperand) -> text:
    match operand.kind:
        case Const(MirConstValue.Str(value), _): value
        case _: ""

fn mir_storage_is_owner_finalizer_call(
    function_operand: MirOperand, args: [MirOperand],
    bindings: [MirStorageRegionBindingV1]
) -> bool:
    if mir_storage_call_name(function_operand) != "rt_free" or args.len() != 1:
        return false
    val local_id = mir_storage_operand_local(args[0])
    mir_storage_binding_region(bindings, local_id) != MIR_STORAGE_UNKNOWN_REGION_ID

fn mir_storage_access_fact(
    projection: MirStorageProjectionV1,
    mode: ParallelAccessMode
) -> ParallelAccessPathV1:
    parallel_access_path_v1(
        projection.region_id, projection.start, projection.end,
        projection.known_range, projection.projection, mode)

fn analyze_mir_storage_accesses(
    function: MirFunction,
    bindings: [MirStorageRegionBindingV1]
) -> [ParallelAccessPathV1]:
    analyze_mir_storage_access_summary(function, bindings).accesses

fn analyze_mir_storage_access_summary(
    function: MirFunction,
    bindings: [MirStorageRegionBindingV1]
) -> MirStorageAccessSummaryV1:
    if not mir_storage_bindings_well_formed(bindings):
        return MirStorageAccessSummaryV1(
            accesses: [], typed_facts: [], address_observed: false,
            unknown_access: true, complete: false)
    var projections: {i64: MirStorageProjectionV1} = {}
    var address_locals: {i64: bool} = {}
    var load_fact_by_local: {i64: i64} = {}
    var load_total_uses: {i64: i64} = {}
    var load_field_uses: {i64: i64} = {}
    var accesses: [ParallelAccessPathV1] = []
    var typed_facts: [MirStorageAccessFactV1] = []
    var address_observed = false
    var unknown_access = false
    val perf_facts = perf_facts_build_without_liveness(function)
    if not perf_facts.def_use_complete:
        unknown_access = true

    for binding in bindings:
        address_locals[binding.local_id] = true

    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case GetElementPtr(dest, base, indices):
                    val base_projection = mir_storage_projection_for_operand(base, projections, bindings)
                    projections[dest.id] = mir_storage_index_projection(base_projection, indices)
                    address_locals[dest.id] = true
                case GetField(dest, base, field):
                    val base_projection = mir_storage_projection_for_operand(base, projections, bindings)
                    val field_projection = mir_storage_field_projection(base_projection, field)
                    projections[dest.id] = field_projection
                    val path = mir_storage_access_fact(
                        field_projection, ParallelAccessMode.Read)
                    accesses.push(path)
                    typed_facts.push(MirStorageAccessFactV1(
                        path: path, has_field: true, field_id: field,
                        structural_record_load: false))
                    val base_local_id = mir_storage_operand_local(base)
                    if load_fact_by_local.has(base_local_id):
                        if not load_field_uses.has(base_local_id):
                            load_field_uses[base_local_id] = 0
                        load_field_uses[base_local_id] =
                            load_field_uses[base_local_id] + 1
                case SetField(base, field, value):
                    val base_projection = mir_storage_projection_for_operand(base, projections, bindings)
                    val field_projection = mir_storage_field_projection(
                        base_projection, field)
                    val path = mir_storage_access_fact(
                        field_projection, ParallelAccessMode.Write)
                    accesses.push(path)
                    typed_facts.push(MirStorageAccessFactV1(
                        path: path, has_field: true, field_id: field,
                        structural_record_load: false))
                    if mir_storage_operand_has_address(value, address_locals, bindings):
                        address_observed = true
                        unknown_access = true
                case Load(dest, pointer):
                    val loaded_projection = mir_storage_projection_for_operand(
                        pointer, projections, bindings)
                    val path = mir_storage_access_fact(
                        loaded_projection, ParallelAccessMode.Read)
                    accesses.push(path)
                    typed_facts.push(MirStorageAccessFactV1(
                        path: path, has_field: false, field_id: -1,
                        structural_record_load: false))
                    load_fact_by_local[dest.id] = typed_facts.len() - 1
                    load_total_uses[dest.id] = perf_facts_uses(perf_facts, dest).len()
                    load_field_uses[dest.id] = 0
                    # Preserve record provenance through GEP -> Load -> GetField.
                    # The loaded value is not itself an address capability.
                    projections[dest.id] = loaded_projection
                case Store(pointer, value):
                    val stored_projection = mir_storage_projection_for_operand(
                        pointer, projections, bindings)
                    val path = mir_storage_access_fact(
                        stored_projection, ParallelAccessMode.Write)
                    accesses.push(path)
                    typed_facts.push(MirStorageAccessFactV1(
                        path: path, has_field: false, field_id: -1,
                        structural_record_load: false))
                    if mir_storage_operand_has_address(
                        value, address_locals, bindings):
                        address_observed = true
                        unknown_access = true
                case Copy(dest, source):
                    if projections.has(source.id):
                        projections[dest.id] = projections[source.id]
                    if address_locals.has(source.id) and address_locals[source.id]:
                        address_locals[dest.id] = true
                case Move(dest, source):
                    if projections.has(source.id):
                        projections[dest.id] = projections[source.id]
                    if address_locals.has(source.id) and address_locals[source.id]:
                        address_locals[dest.id] = true
                case Cast(dest, operand, _) | Bitcast(dest, operand, _):
                    if mir_storage_operand_has_address(operand, address_locals, bindings):
                        address_observed = true
                        unknown_access = true
                        address_locals[dest.id] = true
                case Call(_, function_operand, args):
                    val owner_finalizer = mir_storage_is_owner_finalizer_call(
                        function_operand, args, bindings)
                    for arg in args:
                        if mir_storage_operand_has_address(arg, address_locals, bindings)
                            and not owner_finalizer:
                            address_observed = true
                            unknown_access = true
                case CallIndirect(_, pointer, args, _):
                    var relevant = false
                    if mir_storage_operand_has_address(pointer, address_locals, bindings):
                        address_observed = true
                        relevant = true
                    for arg in args:
                        if mir_storage_operand_has_address(arg, address_locals, bindings):
                            address_observed = true
                            relevant = true
                    if relevant: unknown_access = true
                case Aggregate(_, _, operands):
                    for operand in operands:
                        if mir_storage_operand_has_address(operand, address_locals, bindings):
                            address_observed = true
                            unknown_access = true
                case _:
                    pass
        match block.terminator:
            case Ret(value):
                if value.? and mir_storage_operand_has_address(
                    value.unwrap(), address_locals, bindings):
                    address_observed = true
                    unknown_access = true
            case If(_, _, _) | Switch(_, _, _): pass
            case CallTerminator(_, function_operand, args, _, _):
                val owner_finalizer = mir_storage_is_owner_finalizer_call(
                    function_operand, args, bindings)
                for arg in args:
                    if mir_storage_operand_has_address(arg, address_locals, bindings)
                        and not owner_finalizer:
                        address_observed = true
                        unknown_access = true
            case _: pass
    for loaded_local in load_fact_by_local.keys():
        if perf_facts.def_use_complete
            and load_field_uses[loaded_local] > 0
            and load_total_uses[loaded_local] == load_field_uses[loaded_local]:
            val fact_index = load_fact_by_local[loaded_local]
            typed_facts[fact_index] = MirStorageAccessFactV1(
                ..typed_facts[fact_index], structural_record_load: true)
    var complete = accesses.len() > 0 and not address_observed and not unknown_access
    for fact in typed_facts:
        if fact.path.region_id == MIR_STORAGE_UNKNOWN_REGION_ID:
            complete = false
        if fact.has_field and not fact.path.known_range:
            complete = false
        if not fact.has_field and not fact.structural_record_load:
            complete = false
    MirStorageAccessSummaryV1(accesses: accesses, typed_facts: typed_facts,
        address_observed: address_observed, unknown_access: unknown_access,
        complete: complete)
