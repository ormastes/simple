# Dead Code Elimination Skeleton
#
# DCE is inactive until every MIR opcode has complete DEF/USE, observability,
# trap, ownership/destruction, unwind, volatile/atomic/device, and debug-probe
# semantics. All callable transform surfaces fail closed while registry status
# is Skeleton; dense liveness and MIR rebuilding must not run through bypasses.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirFunction}

fn dce_instruction_is_mandatory_observation(inst: MirInst) -> bool:
    # Compatibility fact used by coverage-probe admission. This is not
    # transformation authority.
    match inst.kind:
        case DecisionProbe(_, _, _, _, _, _): true
        case ConditionProbe(_, _, _, _, _, _, _, _): true
        case _: false

class DeadCodeElimination:
    removed_instructions: i64
    removed_blocks: i64
    iterations: i64

impl DeadCodeElimination:
    static fn new() -> DeadCodeElimination:
        DeadCodeElimination(
            removed_instructions: 0, removed_blocks: 0, iterations: 0)

    fn name() -> text:
        "dead_code_elimination"

    fn description() -> text:
        "Dead code elimination transformation skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        []

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    fn instruction_has_side_effects(inst: MirInst) -> bool:
        # Fail closed: without an exhaustive opcode contract, every
        # instruction is potentially observable or trapping.
        true

    fn is_pure_intrinsic(name: text) -> bool:
        # Purity belongs to verified effect summaries, not a string allowlist.
        false

    fn stats_summary() -> text:
        "DCE: removed {self.removed_instructions} instructions, {self.removed_blocks} blocks ({self.iterations} runs)"

fn create_dce_pass() -> DeadCodeElimination:
    DeadCodeElimination.new()

fn dce_run_on_function(
    dce_pass: DeadCodeElimination, func: MirFunction
) -> MirFunction:
    func
