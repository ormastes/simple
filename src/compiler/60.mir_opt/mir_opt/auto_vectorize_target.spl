# Auto-Vectorization Target Level Resolution
#
# `get_simd_width` used to hardcode the `x86_64-v3` planning profile, which
# pins every auto-vectorized loop to AVX2 (8 x f32) even on a host that admits
# AVX-512. The comment there said the real target triple was "not plumbed yet";
# this module plumbs it.
#
# Admission discipline mirrors `backend_helpers.spl:target_opt_context_from`:
# a CPU name is a *request*, never proof about the execution domain. AVX-512
# widening is admitted only from a capability receipt that carries both the
# CPUID feature bits and the OS XCR0 opmask/ZMM state, and only when the output
# actually targets the host. Anything short of that resolves to the previous
# v3 default, so this is a widening, never a regression.

use compiler.types.simd_capabilities.{SimdFeatureSet, detect_capabilities}

# ============================================================================
# Pure resolution — testable without touching CPUID
# ============================================================================

val AUTO_VECTORIZE_BASELINE_LEVEL: text = "x86_64-v3"

fn auto_vectorize_x86_level(features: SimdFeatureSet, output_target_is_host: bool) -> text:
    """
    Resolve the x86_64 micro-arch planning level for auto-vectorization.

    Returns "x86_64-v4" only when every condition holds:
      - the output targets the host (a cross-target request proves nothing),
      - AVX-512F, VL and BW are all present (VL is required because the
        rewriter still emits 128/256-bit forms for short trip counts, and BW
        because byte/word lanes are otherwise unencodable),
      - the OS has enabled opmask + ZMM state in XCR0.

    Everything else returns the BASELINE level, which is the `x86_64-v3` this
    pass hardcoded before. That is deliberate and is what makes the change
    widen-only: this ladder is x86-specific, so on an aarch64 or riscv64 host
    every x86 bit is false, and degrading to v2/v1 there would drop the planned
    width from 8 f32 lanes to 4 — a REGRESSION on hosts that never had an x86
    receipt to consult in the first place. Narrowing must come from a real
    target decision, never from the absence of an x86 CPUID answer.
    """
    if output_target_is_host and features.has_avx512f and features.has_avx512vl and features.has_avx512bw and features.xcr0_opmask_zmm:
        return "x86_64-v4"
    AUTO_VECTORIZE_BASELINE_LEVEL

fn auto_vectorize_avx512_admitted(features: SimdFeatureSet, output_target_is_host: bool) -> bool:
    """True when the resolved level is the AVX-512 one. Used by the provider
    metadata and by the `@must(simd)` receipt so both agree with the width."""
    auto_vectorize_x86_level(features, output_target_is_host) == "x86_64-v4"

# ============================================================================
# Host-resolving wrapper
# ============================================================================

var _cached_level: text = ""

fn auto_vectorize_target_level() -> text:
    """Resolve the planning level for the current compilation host, once.

    Auto-vectorization runs on MIR before backend target selection, so the
    host receipt is the only evidence available here. Cross-compiled output
    must not be widened from it; `auto_vectorize_x86_level` is called with
    output_target_is_host = true only because MIR auto-vectorization is
    currently host-lane only. When a cross-target receipt is plumbed, pass
    that decision in rather than widening this.

    The result is memoised because `detect_capabilities()` is an uncached full
    CPUID/XGETBV probe that rebuilds its SimdFeatureSet ~31 times per call, and
    this is reached once per matched loop AND once per function — without the
    memo that is a CPUID storm proportional to module size.
    """
    if _cached_level == "":
        _cached_level = auto_vectorize_x86_level(detect_capabilities(), true)
    _cached_level

export auto_vectorize_x86_level
export auto_vectorize_avx512_admitted
export auto_vectorize_target_level
export AUTO_VECTORIZE_BASELINE_LEVEL
