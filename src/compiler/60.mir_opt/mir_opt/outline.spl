# Body Outlining Skeleton
#
# Canonical dispatch classifies body outlining as Skeleton. Extracting cold
# regions changes CFG, call ABI, ownership/destruction timing, unwind behavior,
# and debug locations. Keep every callable compatibility surface inert until a
# canonical cold-region proof, complete live-in/live-out analysis, module symbol
# construction, and semantic differential witnesses exist.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}

class ColdBlockAnalysis:
    cold_blocks: Dict<i64, bool>
    block_preds: Dict<i64, [i64]>

impl ColdBlockAnalysis:
    static fn new() -> ColdBlockAnalysis:
        ColdBlockAnalysis(cold_blocks: {}, block_preds: {})

    me analyze(func: MirFunction):
        # Compatibility-only analysis surface. Heuristic coldness must not
        # authorize a transformation while the pass is a Skeleton.
        pass_do_nothing

    fn is_cold(block_id: BlockId) -> bool:
        false

class OutlineLiveVars:
    live_in: [LocalId]
    defined_inside: Dict<i64, bool>

impl OutlineLiveVars:
    static fn new() -> OutlineLiveVars:
        OutlineLiveVars(live_in: [], defined_inside: {})

    me compute(cold_blocks: [MirBlock], all_blocks: [MirBlock]):
        # Compatibility-only surface. Incomplete liveness is never a proof.
        pass_do_nothing

class BodyOutlining:
    outlined_blocks: i64
    outlined_functions: i64
    captures_total: i64
    min_cold_instructions: i64
    generated_functions: [MirFunction]

impl BodyOutlining:
    static fn new() -> BodyOutlining:
        BodyOutlining(
            outlined_blocks: 0,
            outlined_functions: 0,
            captures_total: 0,
            min_cold_instructions: 4,
            generated_functions: [])

    fn name() -> text:
        "body_outlining"

    fn description() -> text:
        "Body outlining transformation skeleton"

    fn is_analysis_pass() -> bool:
        false

    fn dependencies() -> [text]:
        ["dead_code_elimination"]

    me run_on_function(func: MirFunction) -> MirFunction:
        func

    fn stats_summary() -> text:
        "BodyOutlining: {self.outlined_functions} functions, {self.outlined_blocks} blocks, {self.captures_total} captures"

fn create_outline_pass() -> BodyOutlining:
    BodyOutlining.new()

fn outline_run_on_function(
    outline_pass: BodyOutlining, func: MirFunction
) -> MirFunction:
    func

fn outline_run_on_module(
    outline_pass: BodyOutlining, module: MirModule
) -> MirModule:
    module
