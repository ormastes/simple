"""Classify absence at concrete SSA record-carrier boundaries.

These declarations view the existing runtime classifier ABI through the exact
record carrier supplied by MIR. They deliberately avoid an Any or
RuntimeValuePtr wrapper: boxing/converting a record would classify the new
wrapper instead of the original nil/raw-zero transport value. Keep the two
concrete Simple functions; a generic Simple forwarding helper is not qualified
on the admitted bootstrap producer.
"""

use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_instruction_support.{MirOperand}

@unsafe(reason: "tagged runtime-value classifier accepts concrete runtime carriers without reboxing", capabilities: [ffi])
extern fn rt_value_is_nil<T>(value: T) -> bool
@unsafe(reason: "tagged runtime-value classifier accepts concrete runtime carriers without reboxing", capabilities: [ffi])
extern fn rt_value_is_int<T>(value: T) -> bool
@unsafe(reason: "projects an integer carrier after the matching runtime type check", capabilities: [ffi])
extern fn rt_value_as_int<T>(value: T) -> i64

pub fn ssa_local_carrier_absent(value: LocalId) -> bool:
    val is_nil = unsafe(capabilities: [ffi]):
        rt_value_is_nil(value)
    if is_nil: return true
    val is_int = unsafe(capabilities: [ffi]):
        rt_value_is_int(value)
    if is_int:
        val number = unsafe(capabilities: [ffi]):
            rt_value_as_int(value)
        return number == 0
    false

pub fn ssa_operand_carrier_absent(value: MirOperand) -> bool:
    val is_nil = unsafe(capabilities: [ffi]):
        rt_value_is_nil(value)
    if is_nil: return true
    val is_int = unsafe(capabilities: [ffi]):
        rt_value_is_int(value)
    if is_int:
        val number = unsafe(capabilities: [ffi]):
            rt_value_as_int(value)
        return number == 0
    false
