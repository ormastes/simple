# Human-readable, stable explanation of one guarded physical collection choice.
# This renderer consumes the decision actually returned by collection_plan_select;
# it does not infer a plan from source text or authorize a rewrite.

use compiler.mir_opt.mir_opt.collection_plan_selection.{
    CollectionPlanAlgorithm, CollectionPlanFacts, CollectionPlanDecision
}

fn collection_plan_algorithm_name(algorithm: CollectionPlanAlgorithm) -> text:
    match algorithm:
        case CollectionPlanAlgorithm.Original: "original"
        case CollectionPlanAlgorithm.Linear: "linear"
        case CollectionPlanAlgorithm.Hash: "hash"
        case CollectionPlanAlgorithm.Ordered: "ordered"

fn collection_plan_explain(
    site_id: text, target_profile_id: text,
    facts: CollectionPlanFacts, decision: CollectionPlanDecision
) -> text:
    """Render only supplied, proved selection evidence for one collection site."""
    val profile_status = if facts.profile_admitted: "admitted" else: "not-admitted"
    val profile_size = if facts.profile_admitted: "{facts.profile_size_p95}" else: "unknown"
    val profile_lookups = if facts.profile_admitted: "{facts.profile_lookups_p95}" else: "unknown"
    val profile_hash_probes = if facts.profile_admitted and facts.profile_hash_probes_p95 >= 0:
        "{facts.profile_hash_probes_p95}"
    else:
        "unknown"
    val profile_hash_collisions = if facts.profile_admitted and facts.profile_hash_collisions_p95 >= 0:
        "{facts.profile_hash_collisions_p95}"
    else:
        "unknown"
    val linear_rejection = if decision.linear_rejection == "": "none" else: decision.linear_rejection
    val hash_rejection = if decision.hash_rejection == "": "none" else: decision.hash_rejection
    val ordered_rejection = if decision.ordered_rejection == "": "none" else: decision.ordered_rejection
    val extra_memory = if decision.selected == CollectionPlanAlgorithm.Original: "0" else: "unproven"
    val fallback = if decision.selected == CollectionPlanAlgorithm.Original:
        "original-on-rejection"
    else:
        "none-after-selection"
    val lines = [
        "collection-plan-v1",
        "site={site_id}",
        "target={target_profile_id}",
        "kind={facts.collection_kind}",
        "selected={collection_plan_algorithm_name(decision.selected)}",
        "evidence={decision.evidence}",
        "reason={decision.reason}",
        "attribute={facts.attribute}",
        "policy={facts.policy}",
        "static.size={facts.static_size}",
        "static.lookups={facts.static_lookups}",
        "static.hard_size_bound={facts.hard_size_bound}",
        "profile.status={profile_status}",
        "profile.size_p95={profile_size}",
        "profile.lookups_p95={profile_lookups}",
        "profile.hash_probes_p95={profile_hash_probes}",
        "profile.hash_collisions_p95={profile_hash_collisions}",
        "guard.p0_correctness={facts.p0_correctness_ready}",
        "guard.equality_pure={facts.equality_pure}",
        "guard.duplicates_preserved={facts.duplicate_semantics_preserved}",
        "guard.order_insensitive={facts.order_insensitive}",
        "guard.mutation_epoch_stable={facts.mutation_epoch_stable}",
        "guard.key_hashable={facts.key_hashable}",
        "guard.key_orderable={facts.key_orderable}",
        "guard.target_has_hash={facts.target_has_hash}",
        "guard.target_has_ordered={facts.target_has_ordered}",
        "guard.ordered_update_bound={facts.ordered_update_bound_proven}",
        "guard.linear_size_limit={facts.linear_size_limit}",
        "guard.lookup_promotion_count={facts.lookup_promotion_count}",
        "rejected.linear={linear_rejection}",
        "rejected.hash={hash_rejection}",
        "rejected.ordered={ordered_rejection}",
        "extra_memory_bytes={extra_memory}",
        "memory_budget=not-modeled",
        "fallback={fallback}"
    ]
    lines.join("\n") + "\n"

export collection_plan_algorithm_name, collection_plan_explain
