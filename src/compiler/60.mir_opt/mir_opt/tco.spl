# Tail Call Optimization (TCO)
#
# Transforms self-recursive tail calls into loops to prevent stack overflow
# and improve performance for recursive algorithms.
#
# Detects pattern:
#   block:
#       %result = Call(self_function, args...)
#       Return(%result)
#
# Transforms into:
#   entry_block:
#       %param0 = arg0, %param1 = arg1, ...  (original params)
#       Goto(body)
#   body (original entry):
#       ... (original code)
#   tail_call_block:
#       %param0 = new_arg0, %param1 = new_arg1, ...  (reassign params)
#       Goto(body)                                     (loop back)
#
# This eliminates stack frame allocation for tail-recursive functions,
# turning O(n) stack usage into O(1).

use compiler.mir.mir_data.*
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}

fn tco_parameter_local_id_v1(func: MirFunction, argument_index: i64) -> i64:
    # Signature params are TYPES. Argument storage belongs to MirLocal.Arg.
    var found = -1
    var index = 0
    while index < func.locals.len():
        val local: MirLocal = func.locals[index]
        match local.kind:
            case LocalKind.Arg(actual_index):
                if actual_index == argument_index:
                    if found >= 0 or local.id.id < 0: return -1
                    found = local.id.id
            case _: ()
        index = index + 1
    found

# ============================================================================
# Tail Call Optimization Pass
# ============================================================================

class TailCallOptimization:
    """
    TCO pass — converts self-recursive tail calls into loops.

    Only handles direct self-recursion (not mutual recursion).
    Safe: only transforms calls in tail position (last instruction before Return).
    """
    optimized_calls: i64
    analyzed_functions: i64

impl TailCallOptimization:
    static fn new() -> TailCallOptimization:
        TailCallOptimization(
            optimized_calls: 0,
            analyzed_functions: 0
        )

    fn name() -> text:
        "tail_call_optimization"

    fn description() -> text:
        "Converts self-recursive tail calls into loops"

    fn is_analysis_pass() -> bool:
        val _ = self.name()
        false

    fn dependencies() -> [text]:
        val _ = self.description()
        []

    me run_on_function(func: MirFunction) -> MirFunction:
        """
        Run TCO on a function.

        Algorithm:
        1. Get function's own symbol for self-call detection
        2. Scan all blocks for tail call pattern:
           - Last instruction is Call to same function
           - Terminator is Return of that call's result
        3. Replace tail calls with parameter reassignment + Goto(entry)
        """
        self.analyzed_functions = self.analyzed_functions + 1

        # Get function symbol for self-call detection
        val func_name = func.name

        # Find tail call blocks
        var has_tail_calls = false
        for block in func.blocks:
            if self.is_tail_call_block(block, func_name):
                has_tail_calls = true

        if not has_tail_calls:
            return func

        # Transform: replace tail call blocks
        var new_blocks: [MirBlock] = []
        for block in func.blocks:
            if self.is_tail_call_block(block, func_name):
                val transformed = self.transform_tail_call(block, func)
                new_blocks = new_blocks.push(transformed)
                match transformed.terminator:
                    case MirTerminator.Goto(_):
                        self.optimized_calls = self.optimized_calls + 1
                    case _: ()
            else:
                new_blocks = new_blocks.push(block)

        MirFunction(..func, blocks: new_blocks)

    fn is_tail_call_block(block: MirBlock, func_name: text) -> bool:
        """Check if block ends with a self-recursive tail call + return."""
        val insts = block.instructions
        if insts.len() == 0:
            return false

        # Last instruction must be a Call
        # @workaround bug=mir_tco_parameter_local_identity_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=retain indexed instruction declaration before enum dispatch
        val last_inst: MirInst = insts[insts.len() - 1]
        match last_inst.kind:
            case MirInstKind.Call(dest, func_op, args):
                # Check if call target is self (by function name match)
                if not self.is_self_call(func_op, func_name):
                    return false
                # Terminator must be Return of call result
                match block.terminator:
                    case MirTerminator.Ret(ret_op):
                        if val returned = ret_op:
                            if val destination = dest:
                                return self.operand_refers_to(returned, destination)
                        false
                    case _:
                        false
            case _:
                false

    fn is_self_call(func_op: MirOperand, func_name: text) -> bool:
        """Check if function operand references the current function."""
        # NOTE: this matched `Constant(...)` / `FunctionRef(...)`, neither of
        # which is a real variant (MirOperandKind is Copy/Move/Const;
        # MirConstValue carries the callee symbol in Str). Both matches fell
        # through to `false`, so is_self_call ALWAYS returned false and tail
        # call optimization was silently dead for every function.
        match func_op.kind:
            case Const(const_value, _):
                # Check if constant is a function reference to self
                match const_value:
                    case Str(name):
                        name == func_name
                    case _:
                        false
            case _:
                false

    fn operand_refers_to(operand: MirOperand, local: LocalId) -> bool:
        """Check if operand references a specific local."""
        match operand.kind:
            case Copy(src): src.id == local.id
            case Move(src): src.id == local.id
            case _: false

    fn operand_to_local(operand: MirOperand) -> LocalId?:
        match operand.kind:
            case Copy(src): Some(src)
            case Move(src): Some(src)
            case _: nil

    me transform_tail_call(block: MirBlock, func: MirFunction) -> MirBlock:
        """
        Transform a tail call block into parameter reassignment + Goto(entry).

        Replaces:  %r = Call(self, a1, a2) ; Return(%r)
        With:      %p0 = a1 ; %p1 = a2 ; Goto(entry_block)
        """
        if not self.is_tail_call_block(block, func.name): return block
        val insts = block.instructions
        # @workaround bug=mir_tco_parameter_local_identity_2026_10_16 recover=1986eb71e4ad1d334d795a4706c2bd06e7a0722b reason=retain indexed instruction declaration before enum dispatch
        val last_inst: MirInst = insts[insts.len() - 1]

        var targets: [i64] = []
        var sources: [i64] = []
        match last_inst.kind:
            case MirInstKind.Call(_, _, args):
                if args.len() != func.signature.params.len(): return block
                var argument_index = 0
                while argument_index < args.len():
                    val target = tco_parameter_local_id_v1(func, argument_index)
                    if target < 0: return block
                    val argument: MirOperand = args[argument_index]
                    match argument.kind:
                        case MirOperandKind.Copy(source):
                            targets.push(target)
                            sources.push(source.id)
                        # Preserve calls whose move/constant semantics require
                        # a different instruction or parallel-copy lowering.
                        case _: return block
                    argument_index = argument_index + 1
            case _: return block

        # Sequential assignments cannot implement a parameter permutation.
        # Leave those calls intact until a parallel-copy pass supplies temps.
        var source_index = 0
        while source_index < sources.len():
            var target_index = 0
            while target_index < targets.len():
                if source_index != target_index and sources[source_index] == targets[target_index]:
                    return block
                target_index = target_index + 1
            source_index = source_index + 1

        # Build new instructions: keep all except the last Call
        var new_insts: [MirInst] = []
        var i = 0
        while i < insts.len() - 1:
            new_insts = new_insts.push(insts[i])
            i = i + 1

        var param_idx = 0
        while param_idx < targets.len():
            val assign_inst = MirInst(
                kind: MirInstKind.Copy(LocalId(id: targets[param_idx]), LocalId(id: sources[param_idx])),
                span: last_inst.span
            )
            new_insts = new_insts.push(assign_inst)
            param_idx = param_idx + 1

        # Replace terminator: Return -> Goto(entry)
        MirBlock(
            id: block.id,
            label: block.label,
            instructions: new_insts,
            terminator: MirTerminator.Goto(func.entry_block)
        )

    fn stats_summary() -> text:
        "TCO: optimized {self.optimized_calls} tail calls in {self.analyzed_functions} functions"

# ============================================================================
# Factory Function
# ============================================================================

fn create_tco_pass() -> TailCallOptimization:
    TailCallOptimization.new()

fn tco_run_on_function(tco_pass: TailCallOptimization, func: MirFunction) -> MirFunction:
    func
