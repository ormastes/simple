# WS3: Explicit re-exports — no sibling preloading needed.
# Refactored 2026-03-29 as part of Driver API Heavy Path Stabilization.

# Re-exported from blocks/mod.spl
export use compiler.blocks.mod.{
    enable_block, disable_block, list_blocks, block_info,
    BlockInfo, init_blocks, reset_blocks
}

# Re-exported from blocks/registry.spl
export use compiler.blocks.registry.{BlockRegistry, block_registry, init_blocks}

# Re-exported from blocks/definition.spl
export use compiler.blocks.definition.{BlockDefinition}

# Re-exported from blocks/modes.spl
export use compiler.blocks.modes.{
    LexerMode, LexerConfig, SyntaxFeatures,
    PreLexInfo, BlockSkipPolicy, BlockOutlineInfo, BlockToken
}

# Re-exported from blocks/context.spl
export use compiler.blocks.context.{BlockContext, BlockError, BlockErrorKind, Diagnostic}

# Re-exported from blocks/value.spl
export use compiler.blocks.value.{BlockValue, ResolvedBlock}

# Route the compatibility surface to declaration owners. These names are also
# advertised by blocks.spl; bare export lists there do not supply an owner to
# the frozen HIR facade resolver.
export use compiler.blocks.resolver.{BlockResolver, ResolvedModule, resolve_blocks}
export use compiler.blocks.builtin_blocks_math.{MathBlockDef, LossBlockDef, NogradBlockDef}
export use compiler.blocks.builtin_blocks_shell.{ShellBlockDef, MarkdownBlockDef}
export use compiler.blocks.builtin_blocks_data.{SqlBlockDef, RegexBlockDef, JsonBlockDef}
export use compiler.blocks.registry.{register_builtin_blocks}
export use compiler.blocks.easy.{define_block, define_const_block}
