use compiler.blocks.unicode_classification_v17.{block_text_is_alphanumeric_v17}
use compiler.blocks.definition.{Completion, HoverInfo, SignatureHelp, BlockType, block_default_lex_v1, block_default_skip_policy_v1, block_default_highlight_v1, block_default_completions_v1, block_default_hover_v1, block_default_signature_help_v1, block_default_validate_v1, block_default_eval_const_v1, block_default_result_type_v1, block_default_outline_kind_v1, block_default_examples_v1}
# Builtin Shell & Markdown Block Definitions
#
# Raw-mode block types with simple payloads:
# - Shell blocks (sh{...}): Shell command execution
# - Markdown blocks (md{...}): Markdown content

use compiler.blocks.definition.{BlockDefinition}
use compiler.blocks.value.{BlockValue, ShellCommand}
use compiler.frontend.block_types.{LexerMode, SyntaxFeatures, PreLexInfo, BlockSkipPolicy, BlockOutlineInfo, BlockToken, BlockTokenKind, TextSpan}
use compiler.blocks.context.{BlockContext, BlockError}
use compiler.blocks.definition.{ConstValue}
# Explicit named imports: these are used in declaration position (method
# return/param types and constructor calls) but were reachable only
# through `BlockDefinition`'s own module surface, which the cross-module
# dependency-materialization walk does not follow. The miss surfaced as
# `[hir-callable-dep-origin-unresolved] owner=compiler.blocks.builtin_blocks_shell`
# and then as hard `unresolved type:`/`unresolved name:` errors against
# importing modules (Stage 3 log, 2026-08-24).
use compiler.blocks.definition.{BlockExample, HighlightToken, HighlightKind}
use compiler.blocks.builtin_blocks_helpers.{parse_shell_commands}

# ============================================================================
# Shell Block (sh{})
# ============================================================================

struct ShellBlockDef:
    r"""Shell command block: execute shell commands.

    Features:
    - Raw text capture (no tokenization)
    - Supports pipes, redirects, variables
    - Returns command output as text

    Example:
        val files = sh\{ ls -la }
        val result = sh\{ cat file.txt | grep pattern }
    """

pub fn shell_block_def_new() -> ShellBlockDef:
    ShellBlockDef()

fn shell_command_is_dangerous(cmd: ShellCommand) -> bool:
    cmd.program == "rm" and "-rf" in cmd.args

impl ShellBlockDef:
    static fn new() -> ShellBlockDef:
        ShellBlockDef()

impl BlockDefinition for ShellBlockDef:
    fn kind() -> text:
        "sh"

    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        val trimmed = payload.trim()
        if trimmed.is_empty():
            return Err(BlockError.parse("Empty shell command"))

        # Parse shell commands
        val commands = parse_shell_commands(trimmed)
        Ok(BlockValue.Shell(commands))

    fn lexer_mode() -> LexerMode:
        LexerMode.Raw

    fn syntax_features() -> SyntaxFeatures:
        SyntaxFeatures.default()

    fn description() -> text:
        "Shell command execution"

    fn examples() -> [BlockExample]:
        [
            BlockExample(
                code: "sh{{ ls -la }}",
                description: "List files",
                has_output: false,
                output: ""
            ),
            BlockExample(
                code: "sh{{ cat file.txt | grep pattern | wc -l }}",
                description: "Pipeline with pipes",
                has_output: false,
                output: ""
            ),
            BlockExample(
                code: "sh{{ echo \"hello\" > output.txt }}",
                description: "Redirect to file",
                has_output: false,
                output: ""
            )
        ]

    fn validate(value: BlockValue, ctx: BlockContext) -> [BlockError]:
        # Check for dangerous commands
        match value:
            case Shell(commands):
                var errors: [BlockError] = []
                var idx = 0
                while idx < commands.commands.len():
                    if shell_command_is_dangerous(commands.commands[idx]):
                        errors = errors.push(
                            BlockError.validation("Potentially dangerous: rm -rf")
                                .with_suggestion("Consider using 'rm -i' for interactive deletion")
                        )
                    idx = idx + 1
                errors
            case _:
                []

    fn highlight(payload: text) -> [HighlightToken]:
        var tokens: [HighlightToken] = []
        var i = 0
        var in_string = false
        var string_char = '"'

        while i < payload.len():
            val c = payload[i]

            # String handling
            if c == '"' or c == '\'':
                if not in_string:
                    in_string = true
                    string_char = c
                    val start = i
                    i = i + 1
                    while i < payload.len() and payload[i] != string_char:
                        i = i + 1
                    tokens = tokens.push(HighlightToken(
                        start: start,
                        end: i + 1,
                        kind: HighlightKind.String
                    ))
                    in_string = false
                i = i + 1
                continue

            # Operators
            if c == '|' or c == '>' or c == '<' or c == '&':
                tokens = tokens.push(HighlightToken(
                    start: i,
                    end: i + 1,
                    kind: HighlightKind.Operator
                ))
                i = i + 1
                continue

            # Variable
            if c == '$':
                val start = i
                i = i + 1
                while i < payload.len() and (block_text_is_alphanumeric_v17(payload[i]) or payload[i] == '_'):
                    i = i + 1
                tokens = tokens.push(HighlightToken(
                    start: start,
                    end: i,
                    kind: HighlightKind.Variable
                ))
                continue

            i = i + 1

        tokens


    # @workaround bug=outline_block_native_prerequisites_2026_10_16 recover=8642b544daf854e3254bd3c3aaaea36a3f16b0f3 reason=baked native producer omits trait default slots
    fn lex(payload: text, pre_lex: PreLexInfo, ctx: BlockContext) -> Result<[BlockToken], BlockError>:
        block_default_lex_v1(payload, pre_lex, ctx)

    fn treesitter_outline(payload: text, pre_lex: PreLexInfo) -> BlockOutlineInfo:
        block_default_outline_kind_v1(self.kind())

    fn parse_full(payload: text, pre_lex: PreLexInfo, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        self.parse_payload(payload, ctx)

    fn skip_policy() -> BlockSkipPolicy:
        block_default_skip_policy_v1()

    fn completions(payload: text, cursor: i64) -> [Completion]:
        block_default_completions_v1(payload, cursor)

    fn hover(payload: text, cursor: i64) -> HoverInfo?:
        block_default_hover_v1(payload, cursor)

    fn signature_help(payload: text, cursor: i64) -> SignatureHelp?:
        block_default_signature_help_v1(payload, cursor)

    fn eval_const(value: BlockValue) -> ConstValue?:
        block_default_eval_const_v1(value)

    fn result_type(value: BlockValue) -> BlockType?:
        block_default_result_type_v1(value)

# ============================================================================
# Markdown Block (md{})
# ============================================================================

struct MarkdownBlockDef:
    r"""Markdown block: embed markdown text.

    Features:
    - Raw text capture
    - Markdown syntax highlighting
    - Can be rendered to HTML

    Example:
        val readme = md{
            # My Project

            A **simple** project with _markdown_ support.

            - Item 1
            - Item 2
        }
    """

pub fn markdown_block_def_new() -> MarkdownBlockDef:
    MarkdownBlockDef()

impl MarkdownBlockDef:
    static fn new() -> MarkdownBlockDef:
        MarkdownBlockDef()

impl BlockDefinition for MarkdownBlockDef:
    fn kind() -> text:
        "md"

    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        # Markdown is captured as raw text
        Ok(BlockValue.Raw(payload))

    fn lexer_mode() -> LexerMode:
        LexerMode.Raw

    fn syntax_features() -> SyntaxFeatures:
        SyntaxFeatures.default()

    fn description() -> text:
        "Markdown text"

    fn examples() -> [BlockExample]:
        [
            BlockExample(
                code: "md\{ # Heading }",
                description: "Markdown heading",
                has_output: false,
                output: ""
            )
        ]

    # @workaround bug=outline_block_native_prerequisites_2026_10_16 recover=8642b544daf854e3254bd3c3aaaea36a3f16b0f3 reason=baked native producer omits trait default slots
    fn lex(payload: text, pre_lex: PreLexInfo, ctx: BlockContext) -> Result<[BlockToken], BlockError>:
        block_default_lex_v1(payload, pre_lex, ctx)

    fn treesitter_outline(payload: text, pre_lex: PreLexInfo) -> BlockOutlineInfo:
        block_default_outline_kind_v1(self.kind())

    fn parse_full(payload: text, pre_lex: PreLexInfo, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        self.parse_payload(payload, ctx)

    fn skip_policy() -> BlockSkipPolicy:
        block_default_skip_policy_v1()

    fn highlight(payload: text) -> [HighlightToken]:
        block_default_highlight_v1(payload)

    fn completions(payload: text, cursor: i64) -> [Completion]:
        block_default_completions_v1(payload, cursor)

    fn hover(payload: text, cursor: i64) -> HoverInfo?:
        block_default_hover_v1(payload, cursor)

    fn signature_help(payload: text, cursor: i64) -> SignatureHelp?:
        block_default_signature_help_v1(payload, cursor)

    fn validate(value: BlockValue, ctx: BlockContext) -> [BlockError]:
        block_default_validate_v1(value, ctx)

    fn eval_const(value: BlockValue) -> ConstValue?:
        block_default_eval_const_v1(value)

    fn result_type(value: BlockValue) -> BlockType?:
        block_default_result_type_v1(value)
