# Builtin Blocks - Built-in Block Type Registry
#
# This module re-exports builtin block components from split modules.
# The implementation has been split into:
# - builtin_blocks_defs.spl: Block type definitions (754 lines)
# - builtin_blocks_helpers.spl: Helper functions and registration (414 lines)
# - builtin_blocks_math.spl / builtin_blocks_data.spl / builtin_blocks_shell.spl:
#   math, data, and shell block definitions (C7 shard-path inventory)

export use compiler.blocks.builtin_blocks_defs.*
export use compiler.blocks.builtin_blocks_helpers.*
export use compiler.blocks.builtin_blocks_math.*
export use compiler.blocks.builtin_blocks_data.*
export use compiler.blocks.builtin_blocks_shell.*
