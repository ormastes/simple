# Numeric is General_Category Nd|Nl|No; White_Space is PropList White_Space.

use std.common.encoding.utf8.{text_codepoints, text_is_valid_utf8}
use std.common.search.generated.unicode_17_0_0.{unicode_is_alphabetic}

use compiler.blocks.unicode_properties_v17.{block_unicode_numeric_v17, block_unicode_whitespace_v17}

fn block_text_is_alphabetic_v17(value: text) -> bool:
    if value.len() == 0 or not text_is_valid_utf8(value): return false
    val scalars = text_codepoints(value)
    if scalars.len() == 0: return false
    for cp in scalars:
        if not (unicode_is_alphabetic(cp)): return false
    true

fn block_text_is_alphanumeric_v17(value: text) -> bool:
    if value.len() == 0 or not text_is_valid_utf8(value): return false
    val scalars = text_codepoints(value)
    if scalars.len() == 0: return false
    for cp in scalars:
        if not (unicode_is_alphabetic(cp) or block_unicode_numeric_v17(cp)): return false
    true

fn block_text_is_whitespace_v17(value: text) -> bool:
    if value.len() == 0 or not text_is_valid_utf8(value): return false
    val scalars = text_codepoints(value)
    if scalars.len() == 0: return false
    for cp in scalars:
        if not (block_unicode_whitespace_v17(cp)): return false
    true

fn block_text_is_digit_v17(value: text) -> bool:
    if value.len() == 0 or not text_is_valid_utf8(value): return false
    val scalars = text_codepoints(value)
    if scalars.len() == 0: return false
    for cp in scalars:
        if not (cp >= 48 and cp <= 57): return false
    true

export block_text_is_alphabetic_v17, block_text_is_alphanumeric_v17, block_text_is_whitespace_v17, block_text_is_digit_v17
