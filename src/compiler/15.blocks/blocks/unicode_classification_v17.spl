# UnicodeData SHA256 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c
# PropList SHA256 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd
