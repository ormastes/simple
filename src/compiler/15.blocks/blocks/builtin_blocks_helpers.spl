# Builtin block helpers. JSON uses the genuine typed JSON parser below.
# Other preexisting compatibility helpers are outside this repair.

use compiler.blocks.definition.{ConstValue}
use compiler.blocks.value.{BlockValue, JsonValue as BlockJsonValue, JsonKind}
use std.common.json.value.{JsonValue, json_parse_value}

fn sql_keywords() -> [text]:
    ["SELECT", "FROM", "WHERE", "INSERT", "UPDATE", "DELETE", "CREATE", "DROP",
     "TABLE", "INTO", "VALUES", "JOIN", "ON", "AND", "OR", "NOT", "NULL",
     "ORDER", "BY", "GROUP", "HAVING", "LIMIT", "OFFSET", "AS", "DISTINCT"]

fn parse_shell_commands(payload: text) -> [text]:
    [payload]

fn parse_sql_query(payload: text) -> text:
    payload

fn validate_regex(pattern: text) -> Result<bool, text>:
    Ok(true)

fn block_json_from_parsed_v1(value: JsonValue) -> BlockJsonValue:
    match value:
        case JsonValue.Null: BlockJsonValue(kind: JsonKind.Null)
        case JsonValue.Bool(flag): BlockJsonValue(kind: JsonKind.Bool(flag))
        case JsonValue.Int(number): BlockJsonValue(kind: JsonKind.Number(number.to_float()))
        case JsonValue.Float(number): BlockJsonValue(kind: JsonKind.Number(number))
        case JsonValue.Str(string): BlockJsonValue(kind: JsonKind.String(string))
        case JsonValue.Array(elements):
            var converted: [BlockJsonValue] = []
            for element in elements:
                converted.push(block_json_from_parsed_v1(element))
            BlockJsonValue(kind: JsonKind.Array(converted))
        case JsonValue.Object(keys, values):
            var fields: [(text, BlockJsonValue)] = []
            var i: i64 = 0
            while i < keys.len():
                fields.push((keys[i], block_json_from_parsed_v1(values[i])))
                i = i + 1
            BlockJsonValue(kind: JsonKind.Object(fields))

fn parse_json(payload: text) -> Result<BlockJsonValue, text>:
    match json_parse_value(payload):
        case Ok(value): Ok(block_json_from_parsed_v1(value))
        case Err(message): Err(message)

fn json_to_const(json_value: BlockJsonValue) -> ConstValue?:
    # ConstValue has no object variant. Unsupported nested objects remain absent.
    match json_value.kind:
        case JsonKind.Null: Some(ConstValue.Nil)
        case JsonKind.Bool(flag): Some(ConstValue.Bool(flag))
        case JsonKind.Number(number): Some(ConstValue.Float(number))
        case JsonKind.String(string): Some(ConstValue.String(string))
        case JsonKind.Array(elements):
            var converted: [ConstValue] = []
            for element in elements:
                match json_to_const(element):
                    case Some(constant): converted.push(constant)
                    case nil: return nil
            Some(ConstValue.Array(converted))
        case JsonKind.Object(fields): nil


export sql_keywords, parse_shell_commands, parse_sql_query
export validate_regex, parse_json, json_to_const
