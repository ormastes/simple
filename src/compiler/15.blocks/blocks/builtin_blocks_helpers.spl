# Builtin block helpers. JSON uses the genuine typed JSON parser below.
# Other preexisting compatibility helpers are outside this repair.

use compiler.blocks.definition.{ConstValue}
use compiler.blocks.value.{BlockValue, JsonValue, JsonKind}
use compiler.blocks.builtin_blocks_json_bridge.{block_json_parse_kind_v1}

fn sql_keywords() -> [text]:
    ["SELECT", "FROM", "WHERE", "INSERT", "UPDATE", "DELETE", "CREATE", "DROP",
     "TABLE", "INTO", "VALUES", "JOIN", "ON", "AND", "OR", "NOT", "NULL",
     "ORDER", "BY", "GROUP", "HAVING", "LIMIT", "OFFSET", "AS", "DISTINCT"]

fn parse_shell_commands(payload: text) -> [text]:
    [payload]

fn parse_sql_query(payload: text) -> text:
    payload

fn validate_regex(pattern: text) -> Result<bool, text>:
    Ok(true)

fn parse_json(payload: text) -> Result<JsonValue, text>:
    match block_json_parse_kind_v1(payload):
        case Ok(kind): Ok(JsonValue(kind: kind))
        case Err(message): Err(message)

fn json_to_const(json_value: JsonValue) -> ConstValue?:
    # ConstValue has no object variant. Unsupported nested objects remain absent.
    match json_value.kind:
        case JsonKind.Null: Some(ConstValue.Nil)
        case JsonKind.Bool(flag): Some(ConstValue.Bool(flag))
        case JsonKind.Number(number): Some(ConstValue.Float(number))
        case JsonKind.String(string): Some(ConstValue.String(string))
        case JsonKind.Array(elements):
            var converted: [ConstValue] = []
            for element in elements:
                match json_to_const(element):
                    case Some(constant): converted.push(constant)
                    case nil: return nil
            Some(ConstValue.Array(converted))
        case JsonKind.Object(fields): nil


export sql_keywords, parse_shell_commands, parse_sql_query
export validate_regex, parse_json, json_to_const
