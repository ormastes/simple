# Constructors for the blocks JSON value, for modules that also name the
# std JSON value (builtin_blocks_json_bridge.spl) and so cannot import this
# one by its bare name without an import alias.
use compiler.blocks.value.{JsonValue, JsonKind}

fn block_json_value_v1(kind: JsonKind) -> JsonValue:
    JsonValue(kind: kind)

fn block_json_empty_elements_v1() -> [JsonValue]:
    []

fn block_json_empty_fields_v1() -> [(text, JsonValue)]:
    []

export block_json_value_v1, block_json_empty_elements_v1, block_json_empty_fields_v1
