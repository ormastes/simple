# Converts the genuine typed std JSON parse result into the blocks JSON kind.
# Kept apart from builtin_blocks_helpers.spl so neither module needs an import
# alias to tell the two `JsonValue` types apart: deployed Rust seeds leak a
# dependency's `use ... as Alias` into every transitive importer as an
# undefined `<importer>__Alias` link symbol.
use compiler.blocks.value.{JsonKind}
use compiler.blocks.builtin_blocks_json_ctor.{block_json_value_v1, block_json_empty_elements_v1, block_json_empty_fields_v1}
use std.common.json.value.{JsonValue, json_parse_value}

fn block_json_kind_from_parsed_v1(value: JsonValue) -> JsonKind:
    match value:
        case JsonValue.Null: JsonKind.Null
        case JsonValue.Bool(flag): JsonKind.Bool(flag)
        case JsonValue.Int(number): JsonKind.Number(number.to_float())
        case JsonValue.Float(number): JsonKind.Number(number)
        case JsonValue.Str(string): JsonKind.String(string)
        case JsonValue.Array(elements):
            var converted = block_json_empty_elements_v1()
            for element in elements:
                converted.push(block_json_value_v1(block_json_kind_from_parsed_v1(element)))
            JsonKind.Array(converted)
        case JsonValue.Object(keys, values):
            var fields = block_json_empty_fields_v1()
            var i: i64 = 0
            while i < keys.len():
                fields.push((keys[i], block_json_value_v1(block_json_kind_from_parsed_v1(values[i]))))
                i = i + 1
            JsonKind.Object(fields)

fn block_json_parse_kind_v1(payload: text) -> Result<JsonKind, text>:
    match json_parse_value(payload):
        case Ok(value): Ok(block_json_kind_from_parsed_v1(value))
        case Err(message): Err(message)

export block_json_parse_kind_v1
