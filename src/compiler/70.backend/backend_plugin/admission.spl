# Single 70.backend admission boundary for built-in and future dynamic providers.
#
# The common contract owns the ABI checks so every provider path validates the
# same descriptor_size, abi_version, provider_version, mir_abi_digest,
# supported_roles, supported_targets, capabilities, and operation table.

use compiler.common.backend_plugin.model.{BackendPluginRequestV1, BackendPluginDescriptorV1}
use compiler.common.backend_plugin.receipt.{
    BackendPluginError, BackendProviderReceipt, admit_backend_plugin_descriptor
}

fn admit_backend_plugin(
    request: BackendPluginRequestV1,
    descriptor: BackendPluginDescriptorV1
) -> Result<BackendProviderReceipt, BackendPluginError>:
    admit_backend_plugin_descriptor(request, descriptor)
