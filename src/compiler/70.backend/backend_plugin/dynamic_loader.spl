# Negotiated dynamic backend provider lease.

use std.sffi.dynamic_versioned.{VersionedDynLib, SffiPluginLoadError}
use common.plugin.negotiation.{HostOfferV1}

val DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1 = "spl_plugin_entry_v1"

enum DynamicBackendPluginLoadError:
    LoadFailed(detail: text)
    MissingSymbol(detail: text)
    Unsupported(detail: text)
    NegotiationRefused(code: text, detail: text)

impl DynamicBackendPluginLoadError:
    fn code() -> text:
        match self:
            case LoadFailed(_): "PLUG-E-OPEN"
            case MissingSymbol(_): "PLUG-E-ENTRY"
            case Unsupported(_): "PLUG-E-ENTRY"
            case NegotiationRefused(code, _): code

    fn diagnostic() -> text:
        match self:
            case LoadFailed(detail): detail
            case MissingSymbol(detail): detail
            case Unsupported(detail): detail
            case NegotiationRefused(_, detail): detail

class DynamicBackendPluginLease:
    """Negotiated provider pinned before any backend symbol invocation."""
    library: VersionedDynLib
    provider_path: text
    entry_symbol_address: i64
    closed: bool

impl DynamicBackendPluginLease:
    fn symbol_name() -> text:
        DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1

    fn is_open() -> bool:
        not self.closed and self.entry_symbol_address > 0

    fn admitted_handle() -> i64:
        """Return only the retained handle admitted by negotiation."""
        if not self.is_open():
            return 0
        self.library.lib.handle

    me close() -> bool:
        if self.closed:
            return true
        unsafe(capabilities: [ffi]):
            self.library.lib.close()
        self.entry_symbol_address = 0
        self.closed = true
        true

fn _backend_dynamic_load_error(error: SffiPluginLoadError) -> DynamicBackendPluginLoadError:
    match error:
        case SffiPluginLoadError.OpenFailed(detail):
            DynamicBackendPluginLoadError.LoadFailed("PLUG-E-OPEN: " + detail)
        case SffiPluginLoadError.EntryMissing(detail):
            DynamicBackendPluginLoadError.MissingSymbol("PLUG-E-ENTRY: " + detail)
        case SffiPluginLoadError.EntryCorrupt(detail):
            DynamicBackendPluginLoadError.Unsupported("PLUG-E-ENTRY: " + detail)
        case SffiPluginLoadError.NegotiationRefused(code):
            DynamicBackendPluginLoadError.NegotiationRefused(code, code + ": provider negotiation refused")

@unsafe(reason: "loads and negotiates a backend provider before retaining its entry", capabilities: [ffi, raw_ptr])
fn load_dynamic_backend_plugin_lease(
    provider_path: text,
    provider_name: text,
    host: HostOfferV1
) -> Result<DynamicBackendPluginLease, DynamicBackendPluginLoadError>:
    if provider_path == "":
        return Err(DynamicBackendPluginLoadError.LoadFailed(
            "PLUG-E-OPEN: dynamic backend provider path is required"))
    var library = match VersionedDynLib.load_plugin_path(provider_path, provider_name, host):
        case Ok(value): value
        case Err(error): return Err(_backend_dynamic_load_error(error))
    val resolved = unsafe(capabilities: [ffi, raw_ptr]):
        library.lib.sym_checked(DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1)
    val entry_symbol = match resolved:
        case Ok(value): value
        case Err(detail):
            unsafe(capabilities: [ffi]):
                library.lib.close()
            return Err(DynamicBackendPluginLoadError.MissingSymbol(
                "PLUG-E-ENTRY: missing " + DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1
                    + " in " + provider_path + ": " + detail))
    Ok(DynamicBackendPluginLease(library, provider_path, entry_symbol, false))

fn dynamic_backend_plugin_admission_status(
    lease: DynamicBackendPluginLease
) -> Result<bool, DynamicBackendPluginLoadError>:
    if not lease.is_open():
        return Err(DynamicBackendPluginLoadError.LoadFailed(
            "PLUG-E-OPEN: dynamic backend provider lease is closed"))
    Ok(true)

export DYNAMIC_BACKEND_PLUGIN_ENTRY_SYMBOL_V1
export DynamicBackendPluginLoadError, DynamicBackendPluginLease
export load_dynamic_backend_plugin_lease, dynamic_backend_plugin_admission_status
