# Deterministic built-in provider registry.

use compiler.common.backend_plugin.model.{
    BACKEND_PLUGIN_ABI_VERSION_V1, BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1,
    BackendRole, BackendCapability, BackendPluginRequestV1,
    BackendPluginDescriptorV1, backend_plugin_vtable_v1_all_operations
}
use compiler.common.backend_plugin.receipt.{BackendPluginError}

val BUILTIN_MIR_ABI_DIGEST_V1 = "simple-mir-v1"
val BUILTIN_SESSION_HANDLE: i64 = 1

fn default_backend_name(role: BackendRole) -> text:
    match role:
        case BackendRole.InterpreterJit: "cranelift"
        case BackendRole.CompilerAot: "llvm"

fn backend_request_with_default_name(request: BackendPluginRequestV1) -> BackendPluginRequestV1:
    val backend_name = if request.backend_name == "": default_backend_name(request.role) else: request.backend_name
    BackendPluginRequestV1(
        request.role, backend_name, request.target, request.cpu,
        request.features, request.optimization, request.mir_abi_digest,
        request.required_capabilities, request.plugin_path,
        request.has_plugin_path)

fn _llvm_capabilities() -> [BackendCapability]:
    [
        BackendCapability.JitExecute,
        BackendCapability.ObjectEmit,
        BackendCapability.DebugInfo,
        BackendCapability.Optimization,
        BackendCapability.CrossTarget
    ]

fn _cranelift_capabilities() -> [BackendCapability]:
    [
        BackendCapability.JitExecute,
        BackendCapability.ObjectEmit,
        BackendCapability.DebugInfo,
        BackendCapability.Optimization
    ]

fn llvm_builtin_descriptor() -> BackendPluginDescriptorV1:
    BackendPluginDescriptorV1(
        BACKEND_PLUGIN_ABI_VERSION_V1, BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1,
        "llvm", "builtin-v1", "simple-llvm-builtin-v1",
        BUILTIN_MIR_ABI_DIGEST_V1,
        [BackendRole.InterpreterJit, BackendRole.CompilerAot],
        ["host", "native", "x86_64", "aarch64", "riscv64", "x86", "arm", "riscv32"],
        _llvm_capabilities(), backend_plugin_vtable_v1_all_operations())

fn cranelift_builtin_descriptor() -> BackendPluginDescriptorV1:
    BackendPluginDescriptorV1(
        BACKEND_PLUGIN_ABI_VERSION_V1, BACKEND_PLUGIN_DESCRIPTOR_MIN_SIZE_V1,
        "cranelift", "builtin-v1", "simple-cranelift-builtin-v1",
        BUILTIN_MIR_ABI_DIGEST_V1,
        [BackendRole.InterpreterJit, BackendRole.CompilerAot],
        ["host", "native", "x86_64", "aarch64", "riscv64"],
        _cranelift_capabilities(), backend_plugin_vtable_v1_all_operations())

fn resolve_builtin_backend(
    request: BackendPluginRequestV1
) -> Result<BackendPluginDescriptorV1, BackendPluginError>:
    if request.backend_name == "llvm":
        return Ok(llvm_builtin_descriptor())
    if request.backend_name == "cranelift":
        return Ok(cranelift_builtin_descriptor())
    Err(BackendPluginError.NotFound(
        "built-in backend provider not found: " + request.backend_name
    ))
