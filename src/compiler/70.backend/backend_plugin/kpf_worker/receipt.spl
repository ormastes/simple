# Exact worker-placement provenance for one retained backend session.

use std.common.crypto.sha256.sha256_text
use compiler.common.backend_plugin.receipt.BackendProviderReceipt

pub struct BackendKpfWorkerReceiptV1:
    provider: BackendProviderReceipt
    generation: i64
    session_epoch: i64
    toolchain_digest: text
    placement: text

impl BackendKpfWorkerReceiptV1:
    pub fn canonical_text() -> text:
        ("BackendKpfWorkerReceiptV1"
            + self.provider.hash()
            + ":" + self.generation.to_string()
            + ":" + self.session_epoch.to_string()
            + ":" + self.toolchain_digest.len.to_string()
            + ":" + self.toolchain_digest
            + ":" + self.placement)

    pub fn hash() -> text: sha256_text(self.canonical_text())

pub fn backend_kpf_worker_receipt_v1(
        provider: BackendProviderReceipt, generation: i64, session_epoch: i64,
        expected_toolchain_digest: text, actual_toolchain_digest: text,
        placement: text) -> Result<BackendKpfWorkerReceiptV1, text>:
    if generation <= 0: return Err("backend worker generation must be positive")
    if session_epoch <= 0: return Err("backend worker session epoch must be positive")
    if expected_toolchain_digest == "":
        return Err("backend worker expected toolchain digest is required")
    if actual_toolchain_digest != expected_toolchain_digest:
        return Err("backend worker toolchain digest mismatch")
    if placement != "worker" and placement != "real-worker" and placement != "shared-memory":
        return Err("backend worker placement is unsupported")
    Ok(BackendKpfWorkerReceiptV1(provider, generation, session_epoch,
        actual_toolchain_digest, placement))
