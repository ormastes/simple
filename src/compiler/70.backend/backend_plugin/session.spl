# Versioned backend plugin session ownership.
#
# The session is deliberately independent of dynamic-library ownership in the
# built-in milestone.  A later dynamic loader may retain its library lease next
# to the provider handle without changing callers of this type.

use compiler.common.backend_plugin.model.{BackendPluginDescriptorV1, BackendPluginRequestV1}
use compiler.common.backend_plugin.receipt.{BackendProviderReceipt}
use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.backend.backend_types.{
    BackendKind, CompiledModule, CompileError,
    compileerror_backend_error
}
use compiler.backend.codegen_types.{CodegenOutput}
use compiler.backend.backend_plugin.builtin_adapter.{BuiltinBackendCompileAdapter}
use compiler.backend.backend_plugin.dynamic_adapter.{DynamicBackendAdapter}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{MirStorageViewSiteBindingV1}
use compiler.backend.backend.aot_path_diagnostic.{backend_aot_write_diagnostic}

class BackendSession:
    """An admitted backend provider session and its stable provenance."""
    descriptor: BackendPluginDescriptorV1
    request: BackendPluginRequestV1
    receipt: BackendProviderReceipt
    adapter: BuiltinBackendCompileAdapter?
    dynamic_adapter: DynamicBackendAdapter?
    handle: i64
    closed: bool
    close_count: i64

    static fn admitted(
        descriptor: BackendPluginDescriptorV1,
        request: BackendPluginRequestV1,
        receipt: BackendProviderReceipt,
        adapter: BuiltinBackendCompileAdapter,
        handle: i64
    ) -> BackendSession:
        BackendSession(descriptor, request, receipt, Some(adapter), nil,
            handle, false, 0)

    static fn dynamic_admitted(
        descriptor: BackendPluginDescriptorV1,
        request: BackendPluginRequestV1,
        receipt: BackendProviderReceipt,
        adapter: DynamicBackendAdapter,
        handle: i64
    ) -> BackendSession:
        BackendSession(descriptor, request, receipt, nil, Some(adapter),
            handle, false, 0)

    fn provider_name() -> text:
        self.descriptor.provider_identity

    fn provider_version() -> text:
        self.descriptor.provider_version

    fn provider_build_id() -> text:
        self.descriptor.build_id

    fn is_open() -> bool:
        not self.closed

    fn compile_module(module: MirModule) -> Result<CodegenOutput, CompileError>:
        """Compile through the retained admitted provider, never a fallback."""
        if self.closed:
            return Err(compileerror_backend_error(
                self.adapter.kind,
                "backend session is closed"
            ))
        if val dynamic = self.dynamic_adapter:
            return dynamic.compile_module(module)
        if val builtin = self.adapter:
            return builtin.compile_module(module)
        Err(compileerror_backend_error(
            BackendKind.Compiler,
            "backend session has no compile adapter"))

    fn compile_aot_module(
        module: MirModule,
        is_release: bool,
        opt_level: i64,
        target_cpu: text,
        storage_bindings: [MirStorageViewSiteBindingV1]
    ) -> Result<CompiledModule, CompileError>:
        """Compile one prepared AOT input through this admitted provider."""
        if self.closed:
            return Err(compileerror_backend_error(
                self.adapter.kind,
                "backend session is closed"
            ))
        if val dynamic = self.dynamic_adapter:
            return dynamic.compile_aot_module(
                module, is_release, opt_level, target_cpu, storage_bindings)
        if val builtin = self.adapter:
            return builtin.compile_aot_module(
                module, is_release, opt_level, target_cpu, storage_bindings)
        Err(compileerror_backend_error(
            BackendKind.Compiler,
            "backend session has no AOT adapter"))

    fn compile_aot_into_path(
        module: MirModule, is_release: bool, opt_level: i64, target_cpu: text,
        storage_bindings: [MirStorageViewSiteBindingV1], object_path: text,
        diagnostic_path: text
    ) -> i64:
        if self.closed:
            backend_aot_write_diagnostic(diagnostic_path, "backend session is closed")
            return 1
        if val dynamic = self.dynamic_adapter:
            return dynamic.compile_aot_into_path(
                module, is_release, opt_level, target_cpu, storage_bindings,
                object_path, diagnostic_path)
        if val builtin = self.adapter:
            return builtin.compile_aot_into_path(
                module, is_release, opt_level, target_cpu, storage_bindings,
                object_path, diagnostic_path)
        backend_aot_write_diagnostic(diagnostic_path, "backend session has no AOT adapter")
        1

    me close() -> bool:
        """Close once; subsequent calls remain successful without teardown."""
        if self.closed:
            return true
        var teardown_ok = true
        if val dynamic = self.dynamic_adapter:
            var retained_dynamic = dynamic
            teardown_ok = retained_dynamic.close()
            self.dynamic_adapter = Some(retained_dynamic)
        self.closed = true
        self.handle = 0
        self.close_count = self.close_count + 1
        teardown_ok
