# Backend Types - Backend Trait and Value Definitions
#
# This module contains backend type definitions:
# - BackendKind, BackendResult, BackendError: Backend interface types
# - CompiledUnit, CompiledSymbol: Compilation output types
# - BackendSdnValue: SDN (data-only) value representation
# - Value: Runtime value representation
# - Environment: Execution environment for values
#
# Backend implementations are in backend.spl

use compiler.hir.hir.*
use compiler.mir.mir.*
use compiler.common.diagnostics.span.{Span}

# SINGLE TERMINAL DECLARATION (2026-08-04).
# This module already re-exports ALL of compiler.backend.backend.backend_types
# (`export use ...backend.backend_types.*` at the bottom). It ALSO used to
# DECLARE its own `BackendKind`, `CompiledSymbol` and `CompiledSymbolKind`, so a
# single `use compiler.backend.backend_types.*` delivered each of those three
# names from TWO different terminal modules at once. That is what broke Stage 3
# self-host:
#   HIR lowering error in src/compiler/backend/backend/interpreter.spl:
#   enum payload dependency `CompiledSymbolKind` conflicts:
#     `compiler.backend.backend_types::CompiledSymbolKind::enum` vs
#     `compiler.backend.backend.backend_types::CompiledSymbolKind::enum`
# (same for `BackendKind`). The `src/compiler/backend -> 70.backend` symlink is
# NOT involved -- both module paths are derived from real, distinct files.
#
# The duplicates were also genuinely DIVERGENT, not just redundant, which is a
# latent miscompile independent of Stage 3: same-named enums collapse in the
# global enum registry, so whichever registers first fixes the discriminants for
# EVERY importer. The local `BackendKind` ordered `Byl` at index 13 while the
# sibling orders it at index 6, and the local `CompiledSymbol` ordered its fields
# name/address/size/kind against the sibling's name/kind/address/size. The
# dropped `Custom(name: text)` variant had ZERO uses anywhere in the tree.
#
# Importing the three names here keeps every existing user of this module
# working while leaving exactly ONE terminal declaration per name.
use compiler.backend.backend.backend_types.{BackendKind, CompiledSymbol, CompiledSymbolKind}

# ============================================================================
# Backend Results and Errors
# ============================================================================

"""Result of backend processing."""
enum BackendResult:
    Value(value: Value)
    CompiledUnit(unit: CompiledUnit)
    SdnData(data: BackendSdnValue)
    Unit

struct BackendError:
    """Error during backend processing."""
    message: text
    span: Span?
    kind: BackendErrorKind

"""Backend error kind."""
enum BackendErrorKind:
    NotAllowed          # Operation not allowed (SDN mode)
    TypeError           # Type mismatch
    RuntimeError        # Runtime error
    CompileError        # Compilation error
    NotImplemented      # Feature not implemented
    Internal            # Internal error

impl BackendError:
    static fn not_allowed(message: text, span: Span?) -> BackendError:
        BackendError(message: message, span: span, kind: BackendErrorKind.NotAllowed)

    static fn type_error(message: text, span: Span?) -> BackendError:
        BackendError(message: message, span: span, kind: BackendErrorKind.TypeError)

    static fn runtime_error(message: text, span: Span?) -> BackendError:
        BackendError(message: message, span: span, kind: BackendErrorKind.RuntimeError)

    static fn compile_error(message: text, span: Span?) -> BackendError:
        BackendError(message: message, span: span, kind: BackendErrorKind.CompileError)

    static fn not_implemented(message: text) -> BackendError:
        BackendError(message: message, span: nil, kind: BackendErrorKind.NotImplemented)

    static fn internal(message: text) -> BackendError:
        BackendError(message: message, span: nil, kind: BackendErrorKind.Internal)

# ============================================================================
# Compiled Unit (for Compiler Backend)
# ============================================================================

struct CompiledUnit:
    """Result of compilation."""
    name: text
    code: [u8]
    symbols: Dict<text, CompiledSymbol>
    entry_point: text?
    relocations: [Relocation]

# `CompiledSymbol` / `CompiledSymbolKind` are imported at the top of this file
# from compiler.backend.backend.backend_types -- see the note there. The third
# copy in compiler/10.frontend/core/backend_types.spl is a separate module that
# no importer here shares a scope with; it is tracked in
# doc/08_tracking/bug/duplicate_backend_types_terminal_declarations.md.

struct Relocation:
    """Relocation entry."""
    offset: i64
    symbol: text
    kind: RelocKind

enum RelocKind:
    Absolute
    Relative
    PltRelative

# ============================================================================
# SDN Value (for SDN Backend)
# ============================================================================

struct BackendSdnValue:
    """Data-only value from SDN parsing."""
    kind: SdnValueKind

"""SDN value kind."""
enum SdnValueKind:
    Nil
    Bool(value: bool)
    Int(value: i64)
    Float(value: f64)
    String(value: text)
    Array(elements: [BackendSdnValue])
    Dict(entries: Dict<text, BackendSdnValue>)
    Table(headers: [text], rows: [[BackendSdnValue]])

impl BackendSdnValue:
    static fn make_nil() -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Nil)

    static fn bool(value: bool) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Bool(value))

    static fn int(value: i64) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Int(value))

    static fn float(value: f64) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Float(value))

    static fn string(value: text) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.String(value))

    static fn array(elements: [BackendSdnValue]) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Array(elements))

    static fn dict(entries: Dict<text, BackendSdnValue>) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Dict(entries))

    static fn table(headers: [text], rows: [[BackendSdnValue]]) -> BackendSdnValue:
        BackendSdnValue(kind: SdnValueKind.Table(headers, rows))

# ============================================================================
# Runtime Value (for Interpreter Backend)
# ============================================================================

"""Runtime value for interpreter."""
enum Value:
    Nil
    Unit
    Bool(value: bool)
    Int(value: i64)
    Float(value: f64)
    Char(value: char)
    String(value: text)
    Array(elements: [Value])
    Tuple(elements: [Value])
    Dict(entries: Dict<text, Value>)
    Struct(type_: text, fields: Dict<text, Value>)
    Enum(type_: text, variant: text, payload: EnumPayloadValue?)
    Function(fn_: FunctionValue)
    Closure(closure: ClosureValue)
    Object(obj: ObjectValue)
    Ref(target: Value, mutable: bool)
    Option(value: Value?)
    Result(ok: Value?, err: Value?)
    TraitType(trait_name: text)
    # NEW: SFFI-backed RuntimeValue pointer
    RuntimeValue(ptr: i64)  # Opaque pointer to Rust RuntimeValue

enum EnumPayloadValue:
    Tuple(values: [Value])
    Struct(fields: Dict<text, Value>)

struct FunctionValue:
    """Function value."""
    symbol: SymbolId
    name: text

type ValueCaptureMap = {text: Value}

struct ClosureValue:
    """Closure value with captured environment."""
    params: [HirParam]
    body: HirExpr
    captures: ValueCaptureMap

struct ObjectValue:
    """Class instance handle (Task #112 class reference model).

    Carries only the class name plus an integer HANDLE into the interpreter's
    shared ObjectStore (see objects.spl / env.spl). The instance's fields live
    in the store, NOT inline here, so copying a `Value.Object(ObjectValue)`
    copies the handle and all copies share one record -> reference semantics."""
    class_name: text
    handle: i64

impl Value:
    static fn make_nil() -> Value:
        Value.Nil

    static fn bool(value: bool) -> Value:
        Value.Bool(value)

    static fn int(value: i64) -> Value:
        Value.Int(value)

    static fn float(value: f64) -> Value:
        Value.Float(value)

    static fn string(value: text) -> Value:
        Value.String(value)

    static fn some(value: Value) -> Value:
        Value.Option(Some(value))

    static fn none() -> Value:
        Value.Option(nil)

    static fn ok(value: Value) -> Value:
        Value.Result(Some(value), nil)

    static fn err(value: Value) -> Value:
        Value.Result(nil, Some(value))

    fn is_truthy() -> bool:
        match self:
            case Nil: false
            case Bool(b): b
            case Int(i): i != 0
            case Float(f): f != 0.0
            case String(s): not s.is_empty()
            case Array(a): not a.is_empty()
            case Option(v): v.?
            case _: true

    fn type_name() -> text:
        match self:
            case Nil: "nil"
            case Unit: "unit"
            case Bool(_): "bool"
            case Int(_): "i64"
            case Float(_): "f64"
            case Char(_): "char"
            case String(_): "text"
            case Array(_): "array"
            case Tuple(_): "tuple"
            case Dict(_): "dict"
            case Struct(t, _): t
            case Enum(t, _, _): t
            case Function(_): "function"
            case Closure(_): "closure"
            case Object(o): "object"
            case Ref(_, _): "ref"
            case Option(_): "option"
            case Result(_, _): "result"
            case TraitType(_): "trait_type"
            case RuntimeValue(_): "runtime_value"
            case _: "unknown"

    # Type checking methods
    fn is_nil() -> bool:
        match self:
            case Nil: true
            case _: false

    fn is_bool() -> bool:
        match self:
            case Bool(_): true
            case _: false

    fn is_int() -> bool:
        match self:
            case Int(_): true
            case _: false

    fn is_float() -> bool:
        match self:
            case Float(_): true
            case _: false

    fn is_char() -> bool:
        match self:
            case Char(_): true
            case _: false

    fn is_string() -> bool:
        match self:
            case String(_): true
            case _: false

    fn is_array() -> bool:
        match self:
            case Array(_): true
            case _: false

    fn is_tuple() -> bool:
        match self:
            case Tuple(_): true
            case _: false

    fn is_dict() -> bool:
        match self:
            case Dict(_): true
            case _: false

    # Accessor methods. Wrong-type access returns a neutral default in the
    # bootstrap-safe path; checked callers should match on Value first.
    fn as_bool() -> bool:
        match self:
            case Bool(b): b
            case _: false

    fn as_int() -> i64:
        match self:
            case Int(i): i
            case _: 0

    fn as_float() -> f64:
        match self:
            case Float(f): f
            case _: 0.0

    fn as_char() -> char:
        match self:
            case Char(c): c
            case _: '\0'

    fn as_string() -> text:
        match self:
            case String(s): s
            case _: ""

    fn as_array() -> [Value]:
        match self:
            case Array(a): a
            case _: []

    fn as_tuple() -> [Value]:
        match self:
            case Tuple(t): t
            case _: []

    fn as_dict() -> Dict<text, Value>:
        match self:
            case Dict(d): d
            case _: {}

    fn get_type() -> MirType?:
        # For now, return nil - full type tracking not implemented
        match self:
            case Int(_): Some(MirType.i64())
            case Float(_): Some(MirType.f64())
            case Bool(_): Some(MirType.bool())
            case String(_): Some(MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.I8), false)))
            case Array(_): Some(MirType(kind: MirTypeKind.Array(MirType.unit(), 0)))
            case Tuple(_): Some(MirType(kind: MirTypeKind.Tuple([])))
            case Dict(_): Some(MirType(kind: MirTypeKind.Opaque("dict")))
            case Unit: Some(MirType.unit())
            case Nil: nil

# ============================================================================
# Evaluation Context
# ============================================================================

# ============================================================================
# Exports
# ============================================================================

export use compiler.backend.backend.backend_types.*
use compiler.mir.mir_types.{MirType}

# BackendKind / CompiledSymbol / CompiledSymbolKind are NOT listed here: they
# are no longer declared by this module and already reach every importer through
# the `export use compiler.backend.backend.backend_types.*` line above. Naming
# them again would re-introduce the two-terminal collision described at the top.
export BackendResult, BackendError, BackendErrorKind
export CompiledUnit, Relocation, RelocKind
export BackendSdnValue, SdnValueKind
export Value, EnumPayloadValue, FunctionValue, ClosureValue, ObjectValue
