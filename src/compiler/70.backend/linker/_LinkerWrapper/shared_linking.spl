use compiler.backend.linker.linker_wrapper_helpers.{build_trailer, fnv1a_hash_i64}
use compiler.backend.linker.linker_wrapper_helpers.{write_bytes_to_file, write_elf_bytes_to_file}

# ============================================================================
# Configuration Structs
# ============================================================================

fn _link_native_mingw(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link using MinGW gcc driver.

    Invoked as a direct argv process, NOT through shell(): shell() hardcodes
    "/bin/sh -c", which can never spawn on native Windows (CreateProcess has
    no /bin/sh), so every link died with exit -1 and no output. Direct argv
    also removes shell-quoting hazards in object paths."""
    val cc = if config.target_triple.ends_with("-pc-windows-gnu"):
        "x86_64-w64-mingw32-gcc"
    else:
        "gcc"
    var args: [text] = []
    for flag in native_retained_symbol_cc_args(config.retained_symbols, "windows-mingw"):
        args = args.push(flag)
    for obj in object_files:
        args = args.push(obj)

    # Library paths
    for lp in config.library_paths:
        args = args.push("-L{lp}")

    # Auto-detect runtime library
    var runtime_dir = config.runtime_path
    var support_inputs = object_files
    if runtime_dir == "":
        runtime_dir = find_runtime_lib_dir()
    if runtime_dir != "" and runtime_dir != "none":
        val runtime_archives = native_runtime_archive_inputs(runtime_dir, config.runtime_bundle)
        for arg in native_runtime_archive_link_args(
                runtime_dir, config.runtime_bundle, runtime_archives, true, true, false):
            args = args.push(arg)
            support_inputs.push(arg)

    # Windows system libraries (MinGW names)
    val mingw_libs = ["kernel32", "ws2_32", "bcrypt", "userenv", "ntdll", "ole32", "synchronization", "d3d11", "dxgi", "SDL2"]
    for lib in mingw_libs:
        args = args.push("-l{lib}")
    for flag in native_all_gnu_support_args(support_inputs, "windows-mingw", ""):
        args = args.push(flag)

    # Libraries from config
    for lib in config.libraries:
        args = args.push("-l{lib}")

    # Dead code elimination and strip (size reduction)
    args = args.push("-Wl,--gc-sections")
    args = args.push("-Wl,-s")

    # Same duplicate-definition tolerance the Linux/FreeBSD cc path gets from
    # unresolved_symbol_flags_for_cc: runtime.o and runtime_native.o
    # intentionally both carry a handful of rt_* fallback copies.
    args = args.push("-Wl,--allow-multiple-definition")

    # Extra flags
    for flag in config.extra_flags:
        args = args.push(flag)

    args = args.push("-o")
    args = args.push(output)

    val cmd_text = cc + " " + args.join(" ")
    if config.verbose:
        print "[linker-wrapper] MinGW command: {cmd_text}"

    val (link_out, link_err, link_code) = process_run(cc, args)
    if link_code == 0:
        Ok(output)
    else:
        # Always name the exit code and command on failure: a silent nonzero
        # exit (crashed/unspawnable linker) with a bare "Unknown linking
        # error" hides everything a fixer needs.
        var err_msg = "{link_err}{link_out}"
        if err_msg.trim() == "":
            err_msg = "(no linker output; exit code {link_code})"
        Err("MinGW linking failed: {err_msg}\ncommand: {cmd_text}")

# ============================================================================
# Shared Library Linking
# ============================================================================

fn link_to_shared(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link object files into a shared library (.so/.dylib/.dll).

    Uses platform-appropriate flags:
    - Linux: -shared -fPIC -> .so
    - macOS: -dynamiclib -> .dylib
    - Windows MSVC: /DLL -> .dll + .lib
    - Windows MinGW: -shared -> .dll
    """
    print "[LINKER] link_to_shared: {object_files.len()} files, output={output}"
    if object_files.len() == 0:
        return Err("No object files to link into shared library")

    val os = host_os()

    # Shared/DLL links obey the same named runtime authority as executables.
    # Validate before platform dispatch so MSVC, MinGW, and Unix cannot silently
    # omit or replace an explicit provider bundle.
    val msvc_runtime = os == "windows" and not _is_mingw_env()
    val provider_error = native_runtime_provider_selection_error_for_config_platform(
        config, msvc_runtime)
    if provider_error != "":
        return Err(provider_error)

    if os == "windows":
        return _link_shared_windows(object_files, output, config)

    # Unix-like: Linux, macOS, FreeBSD
    _link_shared_unix(object_files, output, config)

fn _link_shared_unix(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link a shared library on Unix-like systems using cc."""
    val os = host_os()
    val sb = StringBuilder(parts: [])
    sb.push("cc")

    # Position-independent code (required for shared libs)
    sb.push(" -fPIC")

    # Shared library flag
    if os == "macos" or os == "darwin":
        sb.push(" -dynamiclib")
    else:
        sb.push(" -shared")

    # Define SPL_SHARED_LIBRARY macro
    sb.push(" -DSPL_SHARED_LIBRARY")

    # Object files
    for obj in object_files:
        sb.push(" ")
        sb.push(obj)

    # Library paths from config
    for lp in config.library_paths:
        sb.push(" -L")
        sb.push(lp)

    # Auto-detect runtime library
    var runtime_dir = config.runtime_path
    var support_inputs = object_files
    if runtime_dir == "":
        runtime_dir = find_runtime_lib_dir()
    if runtime_dir != "" and runtime_dir != "none":
        val runtime_archives = native_runtime_archive_inputs(
            runtime_dir, config.runtime_bundle)
        for arg in native_runtime_archive_link_args(
                runtime_dir, config.runtime_bundle, runtime_archives, true, true, true):
            sb.push(" ")
            sb.push(arg)
            support_inputs.push(arg)

    # Standard libraries
    if os == "linux":
        sb.push(" -lc -lpthread -ldl -lm")
    elif os == "macos" or os == "darwin":
        sb.push(" -lc -lpthread -lm -lSystem")
    elif os == "freebsd":
        sb.push(" -lc -lpthread -lm")
    val brew_prefix = macos_homebrew_prefix(env_get("HOMEBREW_PREFIX") ?? "", host_arch())
    for flag in native_all_gnu_support_args(support_inputs, os, brew_prefix):
        sb.push(" ")
        sb.push(flag)

    # Libraries from config
    for lib in config.libraries:
        sb.push(" -l")
        sb.push(lib)

    # NOTE: No -dead_strip / --gc-sections for shared libraries.
    # Exported ABI symbols may not be referenced internally but must survive
    # for consumers. Dead-stripping would remove them.

    # Extra flags
    for flag in config.extra_flags:
        sb.push(" ")
        sb.push(flag)

    sb.push(" -o ")
    sb.push(output)
    val cmd = sb.to_text()

    if config.verbose:
        print "[linker-wrapper] shared library command: {cmd}"

    val link = shell(cmd)
    if link.exit_code == 0:
        if config.verbose:
            val size = linker_file_size(output)
            print "[linker-wrapper] Shared library: {output} ({size} bytes)"
        Ok(output)
    else:
        val err_msg = if link.stderr != "": link.stderr else: "Unknown linking error"
        Err("Shared library linking failed: {err_msg}")

fn _link_shared_windows(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link a shared library on Windows."""
    if _is_mingw_env():
        return _link_shared_mingw(object_files, output, config)
    _link_shared_msvc(object_files, output, config)

fn _link_shared_msvc(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link a DLL using MSVC toolchain."""
    var msvc_config: MsvcConfig = MsvcConfig.default()
    msvc_config.debug = config.debug

    # Add /DLL flag
    msvc_config.extra_args.push("/DLL")
    msvc_config.extra_args.push("/DSPL_SHARED_LIBRARY")

    # CRT library paths
    val crt_paths = _find_msvc_lib_paths()
    for p in crt_paths:
        msvc_config.lib_paths.push(p)

    # User library paths
    for lp in config.library_paths:
        msvc_config.lib_paths.push(lp)

    # User libraries share native-link suffix normalization and basename dedup.
    msvc_config.libs = native_msvc_configured_libraries(
        msvc_config.libs, config.libraries)

    # Windows system libraries
    val win_libs = ["kernel32.lib", "ws2_32.lib", "bcrypt.lib", "userenv.lib", "ntdll.lib", "advapi32.lib"]
    for wlib in win_libs:
        if not msvc_config.libs.contains(wlib):
            msvc_config.libs.push(wlib)
    for wlib in native_all_msvc_support_libraries(object_files):
        if not msvc_config.libs.contains(wlib):
            msvc_config.libs.push(wlib)

    # Runtime library
    var runtime_dir = config.runtime_path
    if runtime_dir == "":
        runtime_dir = find_runtime_lib_dir()
    if runtime_dir != "" and runtime_dir != "none":
        val runtime_archives = native_runtime_archive_inputs_for_platform(
            runtime_dir, config.runtime_bundle, true)
        msvc_config.lib_paths.push(runtime_dir)
        val selected_runtime_libs = native_msvc_runtime_selection(
            config.runtime_bundle, runtime_archives)
        msvc_config.libs = native_msvc_runtime_libraries(
            msvc_config.libs, selected_runtime_libs)
        for wlib in native_all_msvc_support_libraries(msvc_config.libs):
            if not msvc_config.libs.contains(wlib):
                msvc_config.libs.push(wlib)

    # Extra flags
    for flag in config.extra_flags:
        msvc_config.extra_args.push(flag)

    # Size optimization: remove unreferenced data + fold identical COMDATs
    if not config.debug:
        msvc_config.extra_args.push("/OPT:REF,ICF")

    if config.verbose:
        print "[linker-wrapper] MSVC DLL linking: {object_files.len()} objects -> {output}"

    val linker = MsvcLinker.new(msvc_config)
    val result = linker.link(output, object_files)
    match result:
        case Ok(_):
            Ok(output)
        case Err(e):
            Err("Windows MSVC DLL linking failed: {e.message}")

fn _link_shared_mingw(object_files: [text], output: text, config: NativeLinkConfig) -> Result:
    """Link a DLL using MinGW gcc."""
    val sb = StringBuilder(parts: [])
    sb.push("gcc -shared -DSPL_SHARED_LIBRARY")

    for obj in object_files:
        sb.push(" ")
        sb.push(obj)

    # Library paths
    for lp in config.library_paths:
        sb.push(" -L")
        sb.push(lp)

    # Runtime library
    var runtime_dir = config.runtime_path
    var support_inputs = object_files
    if runtime_dir == "":
        runtime_dir = find_runtime_lib_dir()
    if runtime_dir != "" and runtime_dir != "none":
        val runtime_archives = native_runtime_archive_inputs(
            runtime_dir, config.runtime_bundle)
        for arg in native_runtime_archive_link_args(
                runtime_dir, config.runtime_bundle, runtime_archives, true, true, false):
            sb.push(" ")
            sb.push(arg)
            support_inputs.push(arg)

    # Windows system libraries
    val mingw_libs = ["kernel32", "ws2_32", "bcrypt", "userenv", "ntdll"]
    for lib in mingw_libs:
        sb.push(" -l{lib}")
    for flag in native_all_gnu_support_args(support_inputs, "windows-mingw", ""):
        sb.push(" ")
        sb.push(flag)

    # User libraries
    for lib in config.libraries:
        sb.push(" -l{lib}")

    # Dead code elimination and strip (size reduction)
    sb.push(" -Wl,--gc-sections -Wl,-s")

    # Extra flags
    for flag in config.extra_flags:
        sb.push(" ")
        sb.push(flag)

    sb.push(" -o ")
    sb.push(output)
    val cmd = sb.to_text()

    if config.verbose:
        print "[linker-wrapper] MinGW DLL command: {cmd}"

    val link = shell(cmd)
    if link.exit_code == 0:
        Ok(output)
    else:
        val err_msg = if link.stderr != "": link.stderr else: "Unknown linking error"
        Err("MinGW DLL linking failed: {err_msg}")

