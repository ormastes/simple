# Explicit roots and dynamic exports for members that must survive ordinary
# static-archive extraction and remain discoverable through runtime lookup.
#
# Keep this policy in the linker owner instead of force-loading optional
# provider archives. A named root retains only the member that owns the
# requested symbol; paired platform export visibility lets the core runtime
# find that member through runtime lookup. ELF and MSVC can export only the
# requested symbol; Darwin requires executable-wide dynamic export visibility.
# MinGW currently has no equivalent runtime lookup owner, so it retains the
# archive member without sending ELF-only export flags to the PE linker.

fn native_retained_symbol_direct_args(symbols: [text], os: text) -> [text]:
    var args: [text] = []
    var needs_darwin_export_dynamic = false
    for symbol in symbols:
        if symbol == "":
            continue
        if os == "macos" or os == "darwin":
            val linker_symbol = if symbol.starts_with("_"): symbol else: "_" + symbol
            args = args.push("-u")
            args = args.push(linker_symbol)
            needs_darwin_export_dynamic = true
        else:
            args = args.push("--undefined=" + symbol)
            args = args.push("--export-dynamic-symbol=" + symbol)
    if needs_darwin_export_dynamic:
        args = args.push("-export_dynamic")
    args

fn native_retained_symbol_cc_args(symbols: [text], os: text) -> [text]:
    var args: [text] = []
    var needs_darwin_export_dynamic = false
    for symbol in symbols:
        if symbol == "":
            continue
        if os == "macos" or os == "darwin":
            val linker_symbol = if symbol.starts_with("_"): symbol else: "_" + symbol
            args = args.push("-Wl,-u," + linker_symbol)
            needs_darwin_export_dynamic = true
        elif os == "windows-mingw":
            args = args.push("-Wl,-u," + symbol)
        else:
            args = args.push("-Wl,--undefined=" + symbol)
            args = args.push("-Wl,--export-dynamic-symbol=" + symbol)
    if needs_darwin_export_dynamic:
        args = args.push("-Wl,-export_dynamic")
    args

fn native_retained_symbol_msvc_args(symbols: [text]) -> [text]:
    var args: [text] = []
    for symbol in symbols:
        if symbol != "":
            args = args.push("/INCLUDE:" + symbol)
            args = args.push("/EXPORT:" + symbol)
    args
