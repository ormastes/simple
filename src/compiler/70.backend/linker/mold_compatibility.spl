use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}

val MOLD_COMPLETION_RECEIPT_PATH: text = "build/linker/mold_completion_receipt.v2"

enum MoldCompatibilityRole:
    LinkerDetection
    LinkerExecution
    UserOverride
    BundledBinaryDiscovery
    CrtDiscovery
    RuntimeLinking
    PureSimpleLinker

enum MoldLinkPlatform:
    Linux
    Windows
    SimpleOs

struct MoldCompletionEvidence:
    linux_x86_64_internal: bool
    linux_aarch64_internal: bool
    windows_x86_64_internal: bool
    windows_arm64_internal: bool
    full_compiler_corpus: bool
    fast_bounded_digest_parity: bool
    simpleos_x86_64_boot: bool
    simpleos_arm64_boot: bool
    platform_receipts: bool
    performance_gate: bool

impl MoldCompatibilityRole:
    fn to_string() -> text:
        match self:
            case LinkerDetection: "linker-detection"
            case LinkerExecution: "linker-execution"
            case UserOverride: "user-override"
            case BundledBinaryDiscovery: "bundled-binary-discovery"
            case CrtDiscovery: "crt-discovery"
            case RuntimeLinking: "runtime-linking"
            case PureSimpleLinker: "pure-simple-linker"

struct MoldCompatibilityFeature:
    """Documented mold compatibility feature exposed to tests and docs."""
    role: MoldCompatibilityRole
    artifact: text
    status: text
    note: text

fn mold_default_linker_order() -> [text]:
    """Return the default host linker preference order."""
    ["mold", "lld", "ld"]

fn mold_supported_override_aliases() -> [text]:
    """Return SIMPLE_LINKER aliases accepted by the mold linker wrapper."""
    ["mold", "lld", "ld.lld", "lld-link", "ld", "gnu", "bfd"]

fn mold_bundled_search_suffixes() -> [text]:
    """Return repo-relative bundled mold paths checked before PATH."""
    [
        "bin/mold/mold",
        "bin/mold/mold-linux-x86_64",
        "bin/mold/mold-linux-aarch64",
        "bin/mold/mold-macos-x86_64",
        "bin/mold/mold-macos-aarch64",
        "bin/mold/mold-freebsd-x86_64",
        "bin/mold/mold-freebsd-aarch64",
        "bin/mold-linux-x86_64",
        "bin/mold-linux-aarch64",
        "bin/mold-macos-x86_64",
        "bin/mold-macos-aarch64",
        "bin/mold-freebsd-x86_64",
        "bin/mold-freebsd-aarch64",
        "bin/mold",
        "lib/simple/mold",
        "lib/simple/mold-linux-x86_64",
        "lib/simple/mold-linux-aarch64",
        "lib/simple/mold-macos-x86_64",
        "lib/simple/mold-macos-aarch64",
        "lib/simple/mold-freebsd-x86_64",
        "lib/simple/mold-freebsd-aarch64"
    ]

fn mold_compatibility_features() -> [MoldCompatibilityFeature]:
    """Return the current mold role/feature compatibility surface."""
    [
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.LinkerDetection,
            artifact: "find_mold_path/find_lld_path/find_ld_path/find_linker",
            status: "implemented",
            note: "Detects bundled mold first, then system mold, ld.lld/lld, then ld."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.UserOverride,
            artifact: "SIMPLE_LINKER/find_requested_linker",
            status: "implemented",
            note: "Supports mold, lld, ld.lld, lld-link, ld, gnu, and bfd aliases."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.BundledBinaryDiscovery,
            artifact: "mold_bundled_search_suffixes",
            status: "implemented",
            note: "Covers repo bin and lib/simple bundled binary layouts."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.CrtDiscovery,
            artifact: "mold_find_crt_files/mold_find_dynamic_linker",
            status: "implemented",
            note: "Discovers host CRT objects and dynamic linker for direct ELF linking."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.LinkerExecution,
            artifact: "MoldBackend.link",
            status: "wrapper",
            note: "Builds direct linker arguments and executes mold/lld/ld as an external process."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.RuntimeLinking,
            artifact: "MoldBackend.link_with_runtime",
            status: "partial",
            note: "Routes through the same external linker path; runtime object integration is still constrained by object representation."
        ),
        MoldCompatibilityFeature(
            role: MoldCompatibilityRole.PureSimpleLinker,
            artifact: "ELF/Mach-O/COFF linker implementation",
            status: "partial",
            note: "internal:elf links Linux x86_64/aarch64 objects plus admitted runtime/user libraries; internal:coff links Windows AMD64/ARM64 objects and runtime archives with architecture-specific PE imports/IAT thunks; BootLayoutPlan emits SimpleOS images. Hosted execution, complete boot receipts, and performance gates remain open."
        )
    ]

fn mold_platform_status(platform: MoldLinkPlatform) -> text:
    """Return the fail-closed internal-linker certification state by platform."""
    match platform:
        case Linux: "implemented-not-certified"
        case Windows: "implemented-hosted-partial-not-certified"
        case SimpleOs: "implemented-boot-evidence-pending"

fn mold_completion_from_evidence(evidence: MoldCompletionEvidence) -> bool:
    """Evaluate the plan's completion gate from explicit real-run receipts."""
    (evidence.linux_x86_64_internal and evidence.linux_aarch64_internal and
        evidence.windows_x86_64_internal and
        evidence.windows_arm64_internal and
        evidence.full_compiler_corpus and evidence.fast_bounded_digest_parity and
        evidence.simpleos_x86_64_boot and evidence.simpleos_arm64_boot and
        evidence.platform_receipts and evidence.performance_gate)

fn mold_completion_receipt_row_valid(row: text, key: text) -> bool:
    val prefix = key + "=sha256:"
    if not row.starts_with(prefix):
        return false
    val digest = row.substring(prefix.len())
    if digest.len() != 64:
        return false
    var i: i64 = 0
    while i < digest.len():
        val ch = digest[i:i + 1]
        if not ((ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f")):
            return false
        i = i + 1
    true

fn mold_completion_evidence_from_receipt(content: text) -> Result<MoldCompletionEvidence, text>:
    """Parse the canonical aggregate of verified real-run receipt digests.

    Rows are fixed-order and lowercase SHA-256 only. The producer/verifier owns
    checking each referenced platform artifact before publishing this aggregate;
    this consumer rejects partial, reordered, duplicated, or hand-wavy `pass`
    values rather than silently treating them as evidence.
    """
    val rows = content.trim().split("\n")
    if rows.len() != 11:
        return Err("mold completion receipt must contain schema plus ten evidence rows")
    if rows[0].trim() != "schema=mold-linker-completion-v2":
        return Err("mold completion receipt has unsupported schema")
    val keys = [
        "linux_x86_64_internal",
        "linux_aarch64_internal",
        "windows_x86_64_internal",
        "windows_arm64_internal",
        "full_compiler_corpus",
        "fast_bounded_digest_parity",
        "simpleos_x86_64_boot",
        "simpleos_arm64_boot",
        "platform_receipts",
        "performance_gate"
    ]
    var i: i64 = 0
    while i < keys.len():
        if not mold_completion_receipt_row_valid(rows[i + 1].trim(), keys[i]):
            return Err("mold completion receipt row '{keys[i]}' is missing or invalid")
        i = i + 1
    Ok(MoldCompletionEvidence(
        linux_x86_64_internal: true,
        linux_aarch64_internal: true,
        windows_x86_64_internal: true,
        windows_arm64_internal: true,
        full_compiler_corpus: true,
        fast_bounded_digest_parity: true,
        simpleos_x86_64_boot: true,
        simpleos_arm64_boot: true,
        platform_receipts: true,
        performance_gate: true
    ))

fn mold_is_pure_simple_linker_complete() -> bool:
    """Return whether this module is a complete in-process mold reimplementation."""
    val content = file_read_regular_no_follow_bounded(
        MOLD_COMPLETION_RECEIPT_PATH, 4096)
    if content.is_err():
        return false
    val parsed = mold_completion_evidence_from_receipt(
        content.unwrap())
    if parsed.is_err():
        return false
    mold_completion_from_evidence(parsed.unwrap())

export MoldCompatibilityRole
export MoldCompatibilityFeature
export MoldLinkPlatform
export MoldCompletionEvidence
export MOLD_COMPLETION_RECEIPT_PATH
export mold_default_linker_order
export mold_supported_override_aliases
export mold_bundled_search_suffixes
export mold_compatibility_features
export mold_platform_status
export mold_completion_from_evidence
export mold_completion_evidence_from_receipt
export mold_is_pure_simple_linker_complete
