# Strict UTF-8 decoding for linker symbol/section NAMES.
#
# Owner decision 2026-11-23 (doc/08_tracking/bug/bytes_to_text_rejects_invalid_utf8_2026-11-23.md):
# invalid UTF-8 bytes are rejected, never replaced with U+FFFD or carried raw.
# An undecodable name is a link error. Payloads (section contents, archive
# member data) stay [u8] and never pass through here.

use std.common.encoding.external_text.{bytes_to_text_checked}

"""Decode a name byte slice as strict UTF-8; `role` names the file/field for the error."""
pub fn linker_name_text(bytes: [u8], role: text) -> Result<text, text>:
    match bytes_to_text_checked(bytes):
        case Ok(value): Ok(value)
        case Err(e): Err("{role}: invalid UTF-8 in name at byte offset {e.byte_offset}: {e.reason}")

export linker_name_text
