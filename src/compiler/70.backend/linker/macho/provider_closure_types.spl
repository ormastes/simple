struct MachOProviderSourceV1:
    path: text
    bytes: [u8]

struct MachOProviderSearchV1:
    sdk_root: text
    library_paths: [text]
    output_path: text

struct MachOProviderRunPathV1:
    path: text
    owner_path: text

struct MachOProviderResolveRequestV2:
    install_name: text
    requester_path: text
    runpaths: [MachOProviderRunPathV1]

struct MachOProviderClientV1:
    output_install_name: text
    client_name: Option<text>
    parent_umbrella: Option<text>

struct MachOProviderClosureLimitsV1:
    max_sources: i64
    max_total_bytes: i64
    max_edges: i64
    max_symbols: i64
    max_work: i64
    max_depth: i64

struct MachOProviderBindingV1:
    root_ordinal: i64
    name: text
    flags: i64

fn macho_provider_closure_default_limits_v1() -> MachOProviderClosureLimitsV1:
    """Structural closure limits; callback allocation and process RSS are separate."""
    MachOProviderClosureLimitsV1(max_sources: 4096, max_total_bytes: 67108864,
        max_edges: 65536, max_symbols: 1000000, max_work: 10000000, max_depth: 64)

export MachOProviderSourceV1, MachOProviderSearchV1, MachOProviderClientV1,
    MachOProviderClosureLimitsV1, MachOProviderBindingV1, macho_provider_closure_default_limits_v1,
    MachOProviderRunPathV1, MachOProviderResolveRequestV2
