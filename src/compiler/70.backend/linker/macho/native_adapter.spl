# Explicit hosted Mach-O file adapter. Byte construction is not loader admission.
use compiler.backend.linker.native_config.{NativeLinkConfig}
use compiler.backend.linker.macho.hosted_link.{MachOHostedRequest, macho_hosted_link_with_closure}
use compiler.backend.linker.macho.tbd_types.{MachOTbdTargetV1}
use compiler.backend.linker.macho.provider_closure_types.{MachOProviderSourceV1, MachOProviderSearchV1, MachOProviderClientV1, macho_provider_closure_default_limits_v1}
use compiler.backend.linker.macho.provider_closure.{macho_provider_closure_v2}
use compiler.backend.linker.macho.native_provider_search.{native_macho_load_provider_v2, macho_provider_path_v1}
use compiler.backend.linker.native_image_publish.{native_image_publish}
use compiler.backend.linker.reloc_engine.{RelocArch}
use std.io_runtime.{file_exists, file_read_bytes_result}
use std.log.{debug}

struct MachONativePlanV1:
    request: MachOHostedRequest
    libraries: [text]
    library_paths: [text]
    runtime_path: text
    runtime_bundle: text
    verbose: bool
    sdk_root: text = ""
    client_name: Option<text> = nil

fn _native_macho_decimal(value: text, maximum: i64) -> Result<i64, text>:
    if value == "": return Err("internal engine: invalid Mach-O empty number")
    var result = 0
    for index in 0..value.len():
        val digit = value.byte_at(index) as i64 - 48
        if digit < 0 or digit > 9 or result > (maximum - digit) / 10:
            return Err("internal engine: invalid Mach-O numeric value '{value}'")
        result = result * 10 + digit
    if result > maximum: return Err("internal engine: invalid Mach-O number exceeds bound")
    Ok(result)

fn _native_macho_version(value: text) -> Result<i64, text>:
    val parts = value.split(".")
    if parts.len() < 1 or parts.len() > 3: return Err("internal engine: invalid Mach-O version '{value}'")
    var values: [i64] = [0, 0, 0]
    for index in 0..parts.len(): values[index] = _native_macho_decimal(parts[index], 255)?
    Ok(values[0] * 65536 + values[1] * 256 + values[2])

fn _native_macho_ascii(value: text) -> bool:
    if value == "" or value.len() > 4096 or value.contains("\0"): return false
    for index in 0..value.len():
        if value.byte_at(index) > 127: return false
    true

fn native_macho_plan_v1(arch: text, config: NativeLinkConfig, output: text) -> Result<MachONativePlanV1, text>:
    val arm = arch == "aarch64" or arch == "arm64"
    if not arm and arch != "x86_64" and arch != "amd64": return Err("internal engine: unsupported Mach-O architecture '{arch}'")
    val canonical = if arm: "aarch64" else: "x86_64"
    if config.target_triple != "" and config.target_triple != canonical + "-apple-darwin":
        return Err("internal engine: invalid Mach-O target triple")
    if config.linker_abi != "" and config.linker_abi != "darwin": return Err("internal engine: invalid Mach-O linker ABI")
    if output == "" or output.contains("\0"): return Err("internal engine: invalid Mach-O output path")
    if not config.pie: return Err("internal engine: unsupported Mach-O config field 'pie=false'")
    if config.debug: return Err("internal engine: unsupported Mach-O config field 'debug'")
    if config.strip_output: return Err("internal engine: unsupported Mach-O config field 'strip_output'")
    if config.prefer_size_linker: return Err("internal engine: unsupported Mach-O config field 'prefer_size_linker'")
    if config.retained_symbols.len() != 0: return Err("internal engine: unsupported Mach-O config field 'retained_symbols'")
    if config.runtime_path.contains("\0") or config.runtime_bundle.contains("\0"):
        return Err("internal engine: invalid Mach-O runtime selection")
    if config.runtime_path == "none" and config.runtime_bundle != "" and config.runtime_bundle != "auto":
        return Err("internal engine: invalid Mach-O runtime bundle with runtime path none")
    for path in config.libraries + config.library_paths:
        if path == "" or path.contains("\0"): return Err("internal engine: invalid Mach-O library path/name")
    var entry = "_main"
    var identifier = ""
    var minimum = 0
    var sdk = 0
    var limit = 0x7fffffff
    var rpaths: [text] = []
    var sdk_root = ""
    var client_name: Option<text> = nil
    var seen: {text: bool} = {}
    var index = 0
    while index < config.extra_flags.len():
        val flag = config.extra_flags[index]
        if flag.contains("\0"): return Err("internal engine: invalid Mach-O flag NUL")
        if flag != "-platform_version" and flag != "-e" and flag != "-rpath" and
                flag != "--macho-signing-identifier" and flag != "--macho-max-image-bytes" and flag != "-syslibroot" and flag != "-client_name":
            return Err("internal engine: unsupported Mach-O flag '{flag}'")
        if flag != "-rpath" and seen.has(flag): return Err("internal engine: invalid Mach-O duplicate flag '{flag}'")
        seen[flag] = true
        val operands = if flag == "-platform_version": 3 else: 1
        if config.extra_flags.len() - index - 1 < operands: return Err("internal engine: invalid Mach-O missing flag operand '{flag}'")
        for offset in 1..(operands + 1):
            if config.extra_flags[index + offset].contains("\0"): return Err("internal engine: invalid Mach-O flag operand NUL")
        val value = config.extra_flags[index + 1]
        if flag == "-platform_version":
            if value != "macos": return Err("internal engine: unsupported Mach-O platform '{value}'")
            minimum = _native_macho_version(config.extra_flags[index + 2])?
            sdk = _native_macho_version(config.extra_flags[index + 3])?
        elif flag == "-e":
            if value == "": return Err("internal engine: invalid Mach-O empty entry")
            entry = value
        elif flag == "--macho-signing-identifier":
            if not _native_macho_ascii(value): return Err("internal engine: invalid Mach-O signing identifier")
            identifier = value
        elif flag == "--macho-max-image-bytes":
            limit = _native_macho_decimal(value, 0x7fffffff)?
        elif flag == "-syslibroot":
            sdk_root = macho_provider_path_v1(value)?
        elif flag == "-client_name":
            if not _native_macho_ascii(value): return Err("internal engine: invalid Mach-O client name")
            client_name = Some(value)
        else:
            if not _native_macho_ascii(value) or rpaths.contains(value) or rpaths.len() >= 128:
                return Err("internal engine: invalid Mach-O rpath")
            rpaths.push(value)
        index = index + operands + 1
    if minimum < 0xb0000 or sdk < minimum: return Err("internal engine: invalid Mach-O explicit macOS 11+ minimum/SDK versions required")
    if identifier == "": return Err("internal engine: invalid Mach-O explicit signing identifier required")
    if limit < 32768: return Err("internal engine: invalid Mach-O image byte budget")
    # allow_cc_fallback cannot override this explicit internal route.
    Ok(MachONativePlanV1(request: MachOHostedRequest(target: if arm: RelocArch.AArch64 else: RelocArch.X86_64,
        entry: entry, minimum_os: minimum, sdk: sdk, max_image_bytes: limit,
        identifier: identifier, rpaths: rpaths, allow_duplicate_definitions: config.allow_duplicate_definitions), libraries: config.libraries,
        library_paths: config.library_paths, runtime_path: config.runtime_path,
        runtime_bundle: config.runtime_bundle, verbose: config.verbose, sdk_root: sdk_root, client_name: client_name))

fn _native_macho_library(library: text, paths: [text]) -> Result<text, text>:
    if library == "" or library.contains("\0"): return Err("internal engine: invalid Mach-O library name")
    if library.contains("/") or library.contains("\\") or library.ends_with(".a") or library.ends_with(".dylib") or library.ends_with(".tbd"):
        return Ok(library)
    for directory in paths:
        if directory == "" or directory.contains("\0"): return Err("internal engine: invalid Mach-O library search path")
        # Preserve directory order. A selected provider's parse/link error must
        # not silently change selection to a later archive or directory.
        for suffix in [".dylib", ".tbd", ".a"]:
            val candidate = directory + "/lib" + library + suffix
            if file_exists(candidate): return Ok(candidate)
    Err("internal engine: Mach-O library cannot be read: {library}")

fn _native_macho_read(path: text) -> Result<[u8], text>:
    if path == "" or path.contains("\0"): return Err("internal engine: invalid Mach-O input path")
    val bytes = file_read_bytes_result(path)
    if bytes.is_err(): return Err("internal engine: Mach-O input cannot be read: {path}: {bytes.unwrap_err()}")
    bytes

fn _native_macho_kind(bytes: [u8]) -> Result<i64, text>:
    if bytes.len() >= 8 and bytes[0] == 33u8 and bytes[1] == 60u8 and bytes[2] == 97u8 and
            bytes[3] == 114u8 and bytes[4] == 99u8 and bytes[5] == 104u8 and bytes[6] == 62u8 and bytes[7] == 10u8: return Ok(1)
    if bytes.len() >= 4:
        if (bytes[0] == 202u8 and bytes[1] == 254u8) or (bytes[2] == 254u8 and bytes[3] == 202u8):
            return Err("internal engine: unsupported Mach-O fat provider/input")
        if bytes[0] == 100u8 and bytes[1] == 121u8 and bytes[2] == 108u8 and bytes[3] == 100u8:
            return Err("internal engine: unsupported Mach-O dyld shared-cache input")
    if bytes.len() < 32 or bytes[0] != 207u8 or bytes[1] != 250u8 or bytes[2] != 237u8 or bytes[3] != 254u8:
        return Err("internal engine: unsupported Mach-O input format")
    val kind = bytes[12] as i64 | ((bytes[13] as i64) << 8) | ((bytes[14] as i64) << 16) | ((bytes[15] as i64) << 24)
    if kind == 1: return Ok(0)
    if kind == 6: return Ok(2)
    Err("internal engine: unsupported Mach-O file type {kind}")

fn native_macho_link_files_v1(plan: MachONativePlanV1, object_files: [text],
        runtime_archives: [text], output: text) -> Result<text, text>:
    if output == "" or output.contains("\0"): return Err("internal engine: invalid Mach-O output path")
    if object_files.len() == 0: return Err("No object files to link")
    if plan.runtime_path == "none" and runtime_archives.len() != 0:
        return Err("internal engine: invalid Mach-O runtime archives with runtime path none")
    if plan.runtime_path != "none" and runtime_archives.len() == 0:
        return Err("internal engine: Mach-O runtime archives were not resolved")
    var objects: [[u8]] = []
    var archives: [[u8]] = []
    var providers: [MachOProviderSourceV1] = []
    for path in object_files:
        val bytes = _native_macho_read(path)?
        if path.ends_with(".tbd"):
            providers.push(MachOProviderSourceV1(path: macho_provider_path_v1(path)?, bytes: bytes))
        else:
            val kind = _native_macho_kind(bytes)?
            if kind == 0: objects.push(bytes)
            elif kind == 1: archives.push(bytes)
            else: providers.push(MachOProviderSourceV1(path: macho_provider_path_v1(path)?, bytes: bytes))
    for path in runtime_archives:
        if path.ends_with(".tbd"): return Err("internal engine: unsupported TBD runtime archive")
        val bytes = _native_macho_read(path)?
        if _native_macho_kind(bytes)? != 1: return Err("internal engine: unsupported non-archive Mach-O runtime provider")
        archives.push(bytes)
    for library in plan.libraries:
        val path = _native_macho_library(library, plan.library_paths)?
        val bytes = _native_macho_read(path)?
        if path.ends_with(".tbd"):
            providers.push(MachOProviderSourceV1(path: macho_provider_path_v1(path)?, bytes: bytes))
        else:
            val kind = _native_macho_kind(bytes)?
            if kind == 1: archives.push(bytes)
            elif kind == 2: providers.push(MachOProviderSourceV1(path: macho_provider_path_v1(path)?, bytes: bytes))
            else: return Err("internal engine: unsupported object in Mach-O libraries")
    if plan.verbose: debug("native-macho", "linking {objects.len()} objects, {archives.len()} archives, {providers.len()} dylibs")
    val target = MachOTbdTargetV1(arch: plan.request.target, platform: 1)
    # Preserve the actual output spelling, including './', for the client rule.
    # Directory separators adapt to Windows; filesystem normalization is separate.
    val client = MachOProviderClientV1(output_install_name: output.replace("\\", "/"), client_name: plan.client_name, parent_umbrella: nil)
    val search = MachOProviderSearchV1(sdk_root: plan.sdk_root, library_paths: plan.library_paths, output_path: output)
    val closure = macho_provider_closure_v2(providers, target, client, search, native_macho_load_provider_v2, macho_provider_closure_default_limits_v1())
    if closure.is_err(): return Err("internal engine: invalid Mach-O provider closure: {closure.unwrap_err()}")
    val linked = macho_hosted_link_with_closure(objects, archives, closure.unwrap(), plan.request)
    if linked.is_err(): return Err("internal engine: {linked.unwrap_err()}")
    if not native_image_publish(output, linked.unwrap(), true): return Err("internal engine: could not publish Mach-O executable {output}")
    Ok(output)

export MachONativePlanV1, native_macho_plan_v1, native_macho_link_files_v1
