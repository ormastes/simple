# Strict schema helpers shared by both text encodings.
use compiler.backend.linker.macho.tbd_types.{MachOTbdLimitsV1, MachOTbdTargetV1}
use compiler.backend.linker.reloc_engine.{RelocArch}

fn tbd_object(value: any) -> Result<{text: any}, text>:
    if value == nil or value.0 != "object": return Err("TBD expected object")
    Ok(value.1)

fn tbd_array(value: any) -> Result<[any], text>:
    if value == nil or value.0 != "array": return Err("TBD expected array")
    Ok(value.1)

fn tbd_text(value: any, limits: MachOTbdLimitsV1) -> Result<text, text>:
    if value == nil or value.0 != "string": return Err("TBD expected string")
    val name: text = value.1
    if name == "" or name.len() > limits.max_name_bytes or name.contains("\0"):
        return Err("TBD invalid or oversized name")
    for index in 0..name.len():
        if name.byte_at(index) > 127: return Err("TBD unsupported non-ASCII name")
    Ok(name)

fn tbd_keys(fields: {text: any}, allowed: [text]) -> Result<bool, text>:
    for key in fields.keys():
        if not allowed.contains(key): return Err("TBD unsupported field {key}")
    Ok(true)

fn tbd_required(fields: {text: any}, key: text) -> Result<any, text>:
    if not fields.has(key): return Err("TBD missing field {key}")
    Ok(fields[key])

fn tbd_names(value: any, limits: MachOTbdLimitsV1) -> Result<[text], text>:
    val values = tbd_array(value)?
    var names: [text] = []
    var seen: {text: bool} = {}
    for item in values:
        val name = tbd_text(item, limits)?
        if seen.has(name): return Err("TBD duplicate name {name}")
        seen[name] = true
        names = names.push(name)
    Ok(names)

fn tbd_decimal(value: text, maximum: i64) -> Result<i64, text>:
    if value == "": return Err("TBD empty decimal")
    var number: i64 = 0
    for index in 0..value.len():
        val digit = value.byte_at(index) as i64 - 48
        if digit < 0 or digit > 9 or number > (maximum - digit) / 10 or digit > maximum:
            return Err("TBD invalid or overflowing decimal")
        number = number * 10 + digit
    Ok(number)

fn tbd_version(value: any, limits: MachOTbdLimitsV1) -> Result<i64, text>:
    val version = tbd_text(value, limits)?
    val parts = version.split(".")
    if parts.len() < 1 or parts.len() > 3: return Err("TBD invalid packed version")
    val major = tbd_decimal(parts[0], 65535)?
    var minor: i64 = 0
    var patch: i64 = 0
    if parts.len() > 1: minor = tbd_decimal(parts[1], 255)?
    if parts.len() > 2: patch = tbd_decimal(parts[2], 255)?
    Ok((major << 16) | (minor << 8) | patch)

fn tbd_integer(value: any, maximum: i64, yaml: bool, limits: MachOTbdLimitsV1) -> Result<i64, text>:
    if yaml: return tbd_decimal(tbd_text(value, limits)?, maximum)
    if value == nil or value.0 != "number": return Err("TBD expected integer")
    val number: f64 = value.1
    if number < 0.0 or number > maximum as f64: return Err("TBD integer outside bounds")
    val integer = number as i64
    if integer as f64 != number: return Err("TBD expected integral number")
    Ok(integer)

fn tbd_target_name(target: MachOTbdTargetV1) -> Result<text, text>:
    if target.platform != 1: return Err("TBD unsupported target platform")
    match target.arch:
        case RelocArch.X86_64: Ok("x86_64-macos")
        case RelocArch.AArch64: Ok("arm64-macos")
        case _: Err("TBD unsupported target architecture")

fn tbd_declared_target(value: text) -> Result<bool, text>:
    val parts = value.split("-")
    if parts.len() < 2 or parts.len() > 3: return Err("TBD invalid declared target")
    if not ["i386", "x86_64", "x86_64h", "armv7", "armv7s", "armv7k", "arm64", "arm64e", "arm64_32"].contains(parts[0]):
        return Err("TBD unsupported declared target architecture")
    if not ["macos", "ios", "tvos", "watchos", "bridgeos", "maccatalyst", "driverkit", "xros"].contains(parts[1]):
        return Err("TBD unsupported declared target platform")
    if parts.len() == 3:
        if parts[2] != "simulator" or not ["ios", "tvos", "watchos", "xros"].contains(parts[1]):
            return Err("TBD invalid declared simulator target")
    Ok(true)

fn tbd_scope(fields: {text: any}, declared: [text], required: bool, limits: MachOTbdLimitsV1) -> Result<[text], text>:
    if not fields.has("targets"):
        if required: return Err("TBD missing scoped targets")
        return Ok(declared)
    val targets = tbd_names(fields["targets"], limits)?
    if targets.len() == 0: return Err("TBD empty scoped targets")
    for target in targets:
        if not declared.contains(target): return Err("TBD scoped target not declared")
    Ok(targets)

export tbd_object, tbd_array, tbd_text, tbd_keys, tbd_required, tbd_names,
    tbd_decimal, tbd_version, tbd_integer, tbd_target_name, tbd_declared_target, tbd_scope
