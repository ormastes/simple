use compiler.backend.linker.reloc_engine.{RelocArch}

struct MachOTbdTargetV1:
    arch: RelocArch
    platform: i64

struct MachOTbdLimitsV1:
    max_bytes: i64
    max_tokens: i64
    max_depth: i64
    max_libraries: i64
    max_symbols: i64
    max_name_bytes: i64

struct MachOTbdInstallNameV1:
    targets: [text]
    name: text

struct MachOTbdSymbolV1:
    name: text
    encoding: text
    role: text
    segment: text
    weak_defined: bool
    weak_referenced: bool
    thread_local: bool

struct MachOTbdLibraryV1:
    declared_targets: [text]
    selected: bool
    install_names: [MachOTbdInstallNameV1]
    install_name: Option<text>
    current_version: i64
    compatibility_version: i64
    minimum_os: Option<i64>
    flags: [text]
    swift_abi: Option<i64>
    allowable_clients: [text]
    parent_umbrella: Option<text>
    rpaths: [text]
    reexported_libraries: [text]
    symbols: [MachOTbdSymbolV1]

struct MachOTbdDocumentV1:
    format_version: i64
    target: MachOTbdTargetV1
    main: MachOTbdLibraryV1
    libraries: [MachOTbdLibraryV1]
    parsed_symbol_count: i64 = 0

fn macho_tbd_default_limits_v1() -> MachOTbdLimitsV1:
    """Structural parser quotas, not a whole-job memory or RSS certificate."""
    MachOTbdLimitsV1(max_bytes: 16777216, max_tokens: 1000000, max_depth: 64,
        max_libraries: 4096, max_symbols: 1000000, max_name_bytes: 4096)

export MachOTbdTargetV1, MachOTbdLimitsV1, MachOTbdInstallNameV1, MachOTbdSymbolV1,
    MachOTbdLibraryV1, MachOTbdDocumentV1, macho_tbd_default_limits_v1
