# Managed suite linking currently needs only its generated origin rpath.
# Keep this closed vocabulary: response files and driver config/forwarding
# options can hide executable or runtime-provider substitutions.
pub fn managed_native_extra_args_error_v1(args: [text]) -> text:
    var index = 0
    while index < args.len():
        # macOS hosted links carry their origin rpath as @loader_path
        # (llvm_native_link_stage4_projection emits `-rpath @loader_path` on
        # darwin) -- the same origin-rpath semantics as $ORIGIN, which mach-o
        # does not spell. The provider directories that follow are repeated
        # `-rpath <dir>` pairs pointing into the admitted runtime authority;
        # a directory value is admitted under the same hygiene bar the input
        # checker applies (absolute, no indirect/option/hostile characters).
        # This is what lets the stage2 phase-C rows (managed tools + runtime
        # authority on a darwin host) reach the link at all; the row never
        # got this far before the source-authority fallback because the
        # authority error fired first.
        if args[index] == "-rpath" and index + 1 < args.len() and
                (args[index + 1] == "$ORIGIN" or args[index + 1] == "@loader_path" or
                    managed_native_rpath_dir_admitted_v1(args[index + 1])):
            index = index + 2
        elif args[index] == "-Wl,-rpath,$ORIGIN" or args[index] == "-Wl,-rpath,@loader_path":
            index = index + 1
        else:
            return "managed native extra flag is not admitted: " + args[index]
    ""

fn managed_native_rpath_dir_admitted_v1(dir: text) -> bool:
    dir.starts_with("/") and not dir.contains("\0") and not dir.contains("\r") and
        not dir.contains("\n") and not dir.contains("|") and not dir.starts_with("//") and
        not dir.contains("/../") and not dir.ends_with("/..")

pub fn managed_native_input_args_error_v1(inputs: [text]) -> text:
    for input in inputs:
        if input.starts_with("@") or input.starts_with("-") or
                (input.starts_with("/") and input.contains(":")) or
                input.contains("\0") or input.contains("\r") or input.contains("\n"):
            return "managed native input is an indirect argument or option: " + input
    ""
