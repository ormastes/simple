# Windows COFF response-file encoding. This is argv encoding, not shell quoting.
# LLD's Windows tokenizer follows the CRT backslash-before-quote rules.
pub fn msvc_response_quote(arg: text) -> text:
    var encoded = "\""
    var slashes = ""
    for ch in arg:
        if ch == "\\":
            slashes = slashes + "\\"
        elif ch == "\"":
            encoded = encoded + slashes + slashes + "\\\""
            slashes = ""
        else:
            encoded = encoded + slashes + ch
            slashes = ""
    # Double trailing slashes so they do not escape the closing quote.
    encoded + slashes + slashes + "\""

pub fn msvc_response_body(args: [text]) -> text:
    var lines: [text] = []
    for arg in args:
        lines.push(msvc_response_quote(arg))
    lines.join("\n") + "\n"
