# Relocation Engine
#
# Applies ELF relocation formulas to section bytes. Pure computation —
# caller owns the output buffer. x86_64 S+A / S+A-P formulas delegate to
# smf_reloc_compute (gpu_smf/smf_reloc_formulas.spl), the single value
# oracle — out-of-width results REJECT, never mask. aarch64 covers ABS64/
# ABS32/CALL26 plus the ADRP+ADD/LDR page-relative pair
# (ADR_PREL_PG_HI21/ADD_ABS_LO12_NC/LDST64_ABS_LO12_NC); RISC-V hi/lo
# pairing (%pcrel_hi/%pcrel_lo cross-referencing another relocation's
# address) is NOT implemented — it needs a second relocation entry as
# input, unlike every other formula here, so it stays scaffolded with
# HI20/LO12_I (immediate-only, no pairing) until a caller needs it.

use compiler.backend.linker.elf_parser.{ElfRelocation, elf_reloc_sym, elf_reloc_type}
use compiler.backend.linker.smf_writer.{RelocationType}
use compiler.backend.linker.gpu_smf.smf_reloc_formulas.{
    smf_reloc_compute, smf_reloc_compute_rel64, smf_reloc_compute_abs32s,
    smf_reloc_compute_rel_signed, smf_reloc_compute_abs_unsigned
}

# ============================================================================
# x86_64 Relocation Types (elf.h R_X86_64_*)
# ============================================================================

val R_X86_64_NONE: i64       = 0
val R_X86_64_64: i64         = 1   # S + A
val R_X86_64_PC32: i64       = 2   # S + A - P
val R_X86_64_PC64: i64       = 24  # S + A - P
val R_X86_64_GOTPC32: i64    = 26  # GOT + A - P (S is the synthesized GOT base)
val R_X86_64_GOT32: i64      = 3
val R_X86_64_PLT32: i64      = 4   # L + A - P (treated as S + A - P for static)
val R_X86_64_32: i64         = 10  # S + A (truncated u32)
val R_X86_64_32S: i64        = 11  # S + A (checked signed 32-bit)
val R_X86_64_16: i64         = 12  # S + A (checked unsigned 16-bit)
val R_X86_64_PC16: i64       = 13  # S + A - P (checked signed 16-bit)
val R_X86_64_8: i64          = 14  # S + A (checked unsigned 8-bit)
val R_X86_64_PC8: i64        = 15  # S + A - P (checked signed 8-bit)
val R_X86_64_GOTPCREL: i64   = 9   # G + GOT + A - P
val R_X86_64_GOTPCRELX: i64  = 41  # G + GOT + A - P (relaxable; linker may rewrite to PC32)
val R_X86_64_REX_GOTPCRELX: i64 = 42  # G + GOT + A - P (relaxable, REX-prefixed)

# ============================================================================
# AArch64 Relocation Types (subset)
# ============================================================================

val R_AARCH64_NONE: i64      = 0
val R_AARCH64_ABS64: i64     = 257  # S + A
val R_AARCH64_ABS32: i64     = 258  # S + A (checked signed-or-unsigned 32-bit)
val R_AARCH64_ABS16: i64     = 259  # S + A (checked signed-or-unsigned 16-bit)
val R_AARCH64_LDST8_ABS_LO12_NC: i64 = 278   # (S+A) & 0xfff, into imm12 (byte, unscaled)
val R_AARCH64_TSTBR14: i64      = 279  # S + A - P, TBZ/TBNZ imm14
val R_AARCH64_CONDBR19: i64     = 280  # S + A - P, conditional branch imm19
val R_AARCH64_JUMP26: i64    = 282  # S + A - P (bits 27:2), B — same formula as CALL26
val R_AARCH64_CALL26: i64    = 283  # S + A - P (bits 27:2), BL
val R_AARCH64_LDST16_ABS_LO12_NC: i64 = 284  # ((S+A) & 0xfff) >> 1, into imm12 (2-byte scaled)
val R_AARCH64_LDST32_ABS_LO12_NC: i64 = 285  # ((S+A) & 0xfff) >> 2, into imm12 (4-byte scaled)
val R_AARCH64_LD_PREL_LO19: i64 = 273  # S + A - P, literal-load imm19
val R_AARCH64_ADR_PREL_LO21: i64 = 274  # S + A - P, split immlo[1:0]/immhi[20:2]
val R_AARCH64_ADR_PREL_PG_HI21: i64 = 275  # (Page(S+A) - Page(P)) >> 12, split immlo[1:0]/immhi[20:2]
val R_AARCH64_ADR_PREL_PG_HI21_NC: i64 = 276
val R_AARCH64_ADD_ABS_LO12_NC: i64 = 277   # (S+A) & 0xfff, into imm12
val R_AARCH64_LDST64_ABS_LO12_NC: i64 = 286  # ((S+A) & 0xfff) >> 3, into imm12 (8-byte scaled)
val R_AARCH64_MOVW_PREL_G0: i64 = 287
val R_AARCH64_MOVW_PREL_G0_NC: i64 = 288
val R_AARCH64_MOVW_PREL_G1: i64 = 289
val R_AARCH64_MOVW_PREL_G1_NC: i64 = 290
val R_AARCH64_MOVW_PREL_G2: i64 = 291
val R_AARCH64_MOVW_PREL_G2_NC: i64 = 292
val R_AARCH64_MOVW_PREL_G3: i64 = 293
val R_AARCH64_LDST128_ABS_LO12_NC: i64 = 299 # ((S+A) & 0xfff) >> 4, into imm12 (16-byte scaled)
val R_AARCH64_PREL64: i64    = 260  # S + A - P (64-bit data)
val R_AARCH64_PREL32: i64    = 261  # S + A - P (32-bit data, e.g. .eh_frame)
val R_AARCH64_PREL16: i64    = 262  # S + A - P (checked signed 16-bit)
val R_AARCH64_MOVW_UABS_G0: i64 = 263
val R_AARCH64_MOVW_UABS_G0_NC: i64 = 264
val R_AARCH64_MOVW_UABS_G1: i64 = 265
val R_AARCH64_MOVW_UABS_G1_NC: i64 = 266
val R_AARCH64_MOVW_UABS_G2: i64 = 267
val R_AARCH64_MOVW_UABS_G2_NC: i64 = 268
val R_AARCH64_MOVW_UABS_G3: i64 = 269
val R_AARCH64_MOVW_SABS_G0: i64 = 270
val R_AARCH64_MOVW_SABS_G1: i64 = 271
val R_AARCH64_MOVW_SABS_G2: i64 = 272
val R_AARCH64_GOT_LD_PREL19: i64 = 309  # G(GDAT(S+A)) - P, literal-load imm19
val R_AARCH64_ADR_GOT_PAGE: i64 = 311      # Page(G(GDAT(S+A))) - Page(P), ADRP encoding
val R_AARCH64_LD64_GOT_LO12_NC: i64 = 312  # G(GDAT(S+A)) & 0xff8, LDR imm12 (8-byte scaled)
val R_AARCH64_LD64_GOTPAGE_LO15: i64 = 313 # G(GDAT(S+A)) - Page(GOT), LDR imm12
val R_AARCH64_PLT32: i64       = 314  # L + A - P (checked signed 32-bit data)
val R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21: i64 = 541
val R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC: i64 = 542
val R_AARCH64_TLSIE_LD_GOTTPREL_PREL19: i64 = 543
val R_AARCH64_TLSLE_MOVW_TPREL_G2: i64 = 544
val R_AARCH64_TLSLE_MOVW_TPREL_G1: i64 = 545
val R_AARCH64_TLSLE_MOVW_TPREL_G1_NC: i64 = 546
val R_AARCH64_TLSLE_MOVW_TPREL_G0: i64 = 547
val R_AARCH64_TLSLE_MOVW_TPREL_G0_NC: i64 = 548
val R_AARCH64_TLSLE_ADD_TPREL_HI12: i64 = 549
val R_AARCH64_TLSLE_ADD_TPREL_LO12: i64 = 550
val R_AARCH64_TLSLE_ADD_TPREL_LO12_NC: i64 = 551
val R_AARCH64_TLSLE_LDST8_TPREL_LO12: i64 = 552
val R_AARCH64_TLSLE_LDST8_TPREL_LO12_NC: i64 = 553
val R_AARCH64_TLSLE_LDST16_TPREL_LO12: i64 = 554
val R_AARCH64_TLSLE_LDST16_TPREL_LO12_NC: i64 = 555
val R_AARCH64_TLSLE_LDST32_TPREL_LO12: i64 = 556
val R_AARCH64_TLSLE_LDST32_TPREL_LO12_NC: i64 = 557
val R_AARCH64_TLSLE_LDST64_TPREL_LO12: i64 = 558
val R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC: i64 = 559
val R_AARCH64_TLSLE_LDST128_TPREL_LO12: i64 = 570
val R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC: i64 = 571

# ============================================================================
# RISC-V Relocation Types (subset)
# ============================================================================

val R_RISCV_NONE: i64        = 0
val R_RISCV_32: i64          = 1   # S + A (u32)
val R_RISCV_64: i64          = 2   # S + A
val R_RISCV_CALL: i64        = 18  # S + A - P (auipc+jalr pair)
val R_RISCV_PCREL_HI20: i64  = 23  # S + A - P (bits 31:12)
val R_RISCV_PCREL_LO12_I: i64 = 24 # S - referenced HI20 base
val R_RISCV_HI20: i64        = 26  # S + A (bits 31:12)
val R_RISCV_LO12_I: i64      = 27  # S + A (bits 11:0)

# ============================================================================
# Architecture Enum
# ============================================================================

enum RelocArch:
    X86_64
    AArch64
    Riscv32
    Riscv64

# ============================================================================
# Relocation Target
# ============================================================================

struct RelocTarget:
    address: i64
    addend: i64

struct RelocResult:
    success: bool
    offset: i64
    value: i64
    error: text

# ============================================================================
# Byte patch helpers (little-endian)
# ============================================================================

fn patch_u32_le(bytes: [i64], offset: i64, value: i64) -> [i64]:
    val b0 = value & 0xff
    val b1 = (value >> 8) & 0xff
    val b2 = (value >> 16) & 0xff
    val b3 = (value >> 24) & 0xff
    var result: [i64] = []
    var i = 0
    while i < bytes.len():
        if i == offset:
            result = result.push(b0)
        else if i == offset + 1:
            result = result.push(b1)
        else if i == offset + 2:
            result = result.push(b2)
        else if i == offset + 3:
            result = result.push(b3)
        else:
            result = result.push(bytes[i])
        i = i + 1
    result

fn patch_u16_le(bytes: [i64], offset: i64, value: i64) -> [i64]:
    var result: [i64] = []
    var i = 0
    while i < bytes.len():
        if i == offset:
            result = result.push(value & 0xff)
        else if i == offset + 1:
            result = result.push((value >> 8) & 0xff)
        else:
            result = result.push(bytes[i])
        i = i + 1
    result

fn patch_u8(bytes: [i64], offset: i64, value: i64) -> [i64]:
    var result: [i64] = []
    var i = 0
    while i < bytes.len():
        if i == offset:
            result = result.push(value & 0xff)
        else:
            result = result.push(bytes[i])
        i = i + 1
    result

fn patch_u64_le(bytes: [i64], offset: i64, value: i64) -> [i64]:
    val b0 = value & 0xff
    val b1 = (value >> 8) & 0xff
    val b2 = (value >> 16) & 0xff
    val b3 = (value >> 24) & 0xff
    val b4 = (value >> 32) & 0xff
    val b5 = (value >> 40) & 0xff
    val b6 = (value >> 48) & 0xff
    val b7 = (value >> 56) & 0xff
    var result: [i64] = []
    var i = 0
    while i < bytes.len():
        if i == offset:
            result = result.push(b0)
        else if i == offset + 1:
            result = result.push(b1)
        else if i == offset + 2:
            result = result.push(b2)
        else if i == offset + 3:
            result = result.push(b3)
        else if i == offset + 4:
            result = result.push(b4)
        else if i == offset + 5:
            result = result.push(b5)
        else if i == offset + 6:
            result = result.push(b6)
        else if i == offset + 7:
            result = result.push(b7)
        else:
            result = result.push(bytes[i])
        i = i + 1
    result

fn read_u32_le(bytes: [i64], offset: i64) -> i64:
    bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)

# ============================================================================
# x86_64 Relocation Application
# ============================================================================

# reason: positional linker reloc_engine API
#
# S+A and S+A-P formulas route through smf_reloc_compute (gpu_smf/smf_reloc_formulas.spl),
# the single value oracle shared with the SMF L8 relocation stage — never a local
# reimplementation. Out-of-width results REJECT (success: false) rather than the
# masking this function used to do (`v & 0xffffffff` on R_X86_64_32); see
# doc/08_tracking/bug/smf_gotrel32_applied_as_symbol_value_2026-09-18.md and
# design §4 for why silent truncation is the defect class the oracle exists to catch.
fn reloc_apply_x86_64(bytes: [i64], offset: i64, rtype: i64, s: i64, a: i64, p: i64) -> RelocResult:
    if rtype == R_X86_64_NONE:
        return RelocResult(success: true, offset: offset, value: 0, error: "")

    if rtype == R_X86_64_64:
        val r = smf_reloc_compute(RelocationType.Abs64, s, a, p)
        return RelocResult(success: r.ok, offset: offset, value: r.value, error: "")

    if rtype == R_X86_64_PC32 or rtype == R_X86_64_GOTPC32:
        val r = smf_reloc_compute(RelocationType.Rel32, s, a, p)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        var name = "R_X86_64_PC32"
        if rtype == R_X86_64_GOTPC32:
            name = "R_X86_64_GOTPC32"
        return RelocResult(success: false, offset: offset, value: 0, error: "{name} out of signed 32-bit range (S + A - P)")

    if rtype == R_X86_64_PC64:
        val r = smf_reloc_compute_rel64(s, a, p)
        return RelocResult(success: r.ok, offset: offset, value: r.value, error: "")

    if rtype == R_X86_64_PC16:
        val r = smf_reloc_compute_rel_signed(s, a, p, -32768, 32767)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_PC16 out of signed 16-bit range (S + A - P)")

    if rtype == R_X86_64_PC8:
        val r = smf_reloc_compute_rel_signed(s, a, p, -128, 127)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_PC8 out of signed 8-bit range (S + A - P)")

    if rtype == R_X86_64_PLT32:
        val r = smf_reloc_compute(RelocationType.PltRel32, s, a, p)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_PLT32 out of signed 32-bit range (S + A - P)")

    if rtype == R_X86_64_32:
        val r = smf_reloc_compute(RelocationType.Abs32, s, a, p)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_32 out of unsigned 32-bit range (S + A)")

    if rtype == R_X86_64_32S:
        val r = smf_reloc_compute_abs32s(s, a)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_32S out of signed 32-bit range (S + A)")

    if rtype == R_X86_64_16:
        val r = smf_reloc_compute_abs_unsigned(s, a, 65535)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_16 out of unsigned 16-bit range (S + A)")

    if rtype == R_X86_64_8:
        val r = smf_reloc_compute_abs_unsigned(s, a, 255)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_8 out of unsigned 8-bit range (S + A)")

    if rtype == R_X86_64_GOTPCREL or rtype == R_X86_64_GOTPCRELX or rtype == R_X86_64_REX_GOTPCRELX:
        # GOTPCRELX / REX_GOTPCRELX share GOTPCREL's formula; relaxation to
        # PC32 (mov -> lea) is the linker's decision, made before this call.
        # Wire-4 rule (design §4): S here must be the GOT-entry address (S == G),
        # never the symbol's own address — see the bug doc above.
        val r = smf_reloc_compute(RelocationType.GotRel32, s, a, p)
        if r.ok:
            return RelocResult(success: true, offset: offset, value: r.value, error: "")
        return RelocResult(success: false, offset: offset, value: 0, error: "R_X86_64_GOTPCREL[X] out of signed 32-bit range (G + A - P)")

    RelocResult(success: false, offset: offset, value: 0, error: "unsupported x86_64 reloc type {rtype}")

# ============================================================================
# AArch64 Relocation Application (scaffold)
# ============================================================================

# reason: positional linker reloc_engine API
fn reloc_apply_aarch64(bytes: [i64], offset: i64, rtype: i64, s: i64, a: i64, p: i64) -> RelocResult:
    if rtype == R_AARCH64_NONE:
        return RelocResult(success: true, offset: offset, value: 0, error: "")

    if rtype == R_AARCH64_ABS64:
        val v = s + a
        return RelocResult(success: true, offset: offset, value: v, error: "")

    if rtype == R_AARCH64_ABS32:
        val v = s + a
        if v < -2147483648 or v >= 4294967296:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_ABS32 out of range: (S + A) must be in [-2^31, 2^32)")
        return RelocResult(success: true, offset: offset, value: v & 0xffffffff, error: "")

    if rtype == R_AARCH64_ABS16:
        val v = s + a
        if v < -32768 or v >= 65536:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_ABS16 out of range: (S + A) must be in [-2^15, 2^16)")
        return RelocResult(success: true, offset: offset, value: v & 0xffff, error: "")

    if rtype == R_AARCH64_CALL26 or rtype == R_AARCH64_JUMP26:
        # AAELF64: BL (CALL26) and B (JUMP26) share the formula and imm26
        # encoding. (S+A-P) must be 4-byte aligned and the raw byte offset
        # must fit the signed-26-bit-x4-scaled field, i.e. lie in
        # [-2^27, 2^27). Reject rather than silently masking an
        # out-of-range or truncating a misaligned target.
        val v = s + a - p
        if v & 0x3 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_CALL26/JUMP26 branch target not 4-byte aligned: (S + A - P) & 0x3 != 0")
        if v < -134217728 or v >= 134217728:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_CALL26/JUMP26 branch offset out of range: (S + A - P) must be in [-2^27, 2^27)")
        return RelocResult(success: true, offset: offset, value: (v >> 2) & 0x3ffffff, error: "")

    if rtype == R_AARCH64_TSTBR14 or rtype == R_AARCH64_CONDBR19:
        val v = s + a - p
        if v & 0x3 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TSTBR14/CONDBR19 target not 4-byte aligned")
        if rtype == R_AARCH64_TSTBR14 and (v < -32768 or v >= 32768):
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TSTBR14 branch offset out of range [-2^15, 2^15)")
        if rtype == R_AARCH64_CONDBR19 and (v < -1048576 or v >= 1048576):
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_CONDBR19 branch offset out of range [-2^20, 2^20)")
        return RelocResult(success: true, offset: offset, value: v >> 2, error: "")

    if rtype == R_AARCH64_PREL32:
        # AAELF64 PREL32: -2^31 <= S + A - P < 2^31; reject rather than mask.
        val v = s + a - p
        if v < -2147483648 or v >= 2147483648:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_PREL32 out of range: (S + A - P) must be in [-2^31, 2^31)")
        return RelocResult(success: true, offset: offset, value: v & 0xffffffff, error: "")

    if rtype == R_AARCH64_PLT32:
        val v = s + a - p
        if v < -2147483648 or v >= 2147483648:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_PLT32 out of signed 32-bit range (L + A - P)")
        return RelocResult(success: true, offset: offset, value: v & 0xffffffff, error: "")

    if rtype == R_AARCH64_PREL16:
        val v = s + a - p
        if v < -32768 or v >= 32768:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_PREL16 out of signed 16-bit range (S + A - P)")
        return RelocResult(success: true, offset: offset, value: v & 0xffff, error: "")

    if rtype == R_AARCH64_PREL64:
        return RelocResult(success: true, offset: offset, value: s + a - p, error: "")

    if rtype >= R_AARCH64_MOVW_UABS_G0 and rtype <= R_AARCH64_MOVW_UABS_G3:
        val v = s + a
        var shift = 0
        if rtype == R_AARCH64_MOVW_UABS_G1 or rtype == R_AARCH64_MOVW_UABS_G1_NC: shift = 16
        elif rtype == R_AARCH64_MOVW_UABS_G2 or rtype == R_AARCH64_MOVW_UABS_G2_NC: shift = 32
        elif rtype == R_AARCH64_MOVW_UABS_G3: shift = 48
        val checked = rtype == R_AARCH64_MOVW_UABS_G0 or
            rtype == R_AARCH64_MOVW_UABS_G1 or
            rtype == R_AARCH64_MOVW_UABS_G2 or
            rtype == R_AARCH64_MOVW_UABS_G3
        if checked and (v < 0 or (shift < 48 and (v >> (shift + 16)) != 0)):
            return RelocResult(success: false, offset: offset, value: 0,
                error: "R_AARCH64_MOVW_UABS_G{shift / 16} overflow")
        return RelocResult(success: true, offset: offset,
            value: (v >> shift) & 0xffff, error: "")

    if rtype >= R_AARCH64_MOVW_SABS_G0 and rtype <= R_AARCH64_MOVW_SABS_G2:
        val v = s + a
        val shift = (rtype - R_AARCH64_MOVW_SABS_G0) * 16
        val limit = 1 << (shift + 16)
        if v < 0 - limit or v >= limit:
            return RelocResult(success: false, offset: offset, value: 0,
                error: "R_AARCH64_MOVW_SABS_G{shift / 16} overflow")
        val selected = if v < 0: ((~v) >> shift) & 0xffff else: (v >> shift) & 0xffff
        return RelocResult(success: true, offset: offset, value: selected, error: "")

    if rtype >= R_AARCH64_MOVW_PREL_G0 and rtype <= R_AARCH64_MOVW_PREL_G3:
        val v = s + a - p
        var shift = 0
        if rtype == R_AARCH64_MOVW_PREL_G1 or rtype == R_AARCH64_MOVW_PREL_G1_NC: shift = 16
        elif rtype == R_AARCH64_MOVW_PREL_G2 or rtype == R_AARCH64_MOVW_PREL_G2_NC: shift = 32
        elif rtype == R_AARCH64_MOVW_PREL_G3: shift = 48
        val checked = rtype == R_AARCH64_MOVW_PREL_G0 or
            rtype == R_AARCH64_MOVW_PREL_G1 or
            rtype == R_AARCH64_MOVW_PREL_G2 or
            rtype == R_AARCH64_MOVW_PREL_G3
        if checked and shift < 48:
            val limit = 1 << (shift + 16)
            if v < 0 - limit or v >= limit:
                return RelocResult(success: false, offset: offset, value: 0,
                    error: "R_AARCH64_MOVW_PREL_G{shift / 16} overflow")
        val selected = if checked and v < 0:
            ((~v) >> shift) & 0xffff
        else:
            (v >> shift) & 0xffff
        return RelocResult(success: true, offset: offset, value: selected, error: "")

    if rtype == R_AARCH64_LD_PREL_LO19 or rtype == R_AARCH64_GOT_LD_PREL19 or
            rtype == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19:
        var literal_name = "R_AARCH64_LD_PREL_LO19"
        if rtype == R_AARCH64_GOT_LD_PREL19: literal_name = "R_AARCH64_GOT_LD_PREL19"
        elif rtype == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19: literal_name = "R_AARCH64_TLSIE_LD_GOTTPREL_PREL19"
        val delta = s + a - p
        if delta & 0x3 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "{literal_name} target not 4-byte aligned")
        if delta < -1048576 or delta >= 1048576:
            return RelocResult(success: false, offset: offset, value: 0, error: "{literal_name} delta out of range [-2^20, 2^20)")
        return RelocResult(success: true, offset: offset, value: delta >> 2, error: "")

    if rtype == R_AARCH64_ADR_PREL_LO21:
        val delta = s + a - p
        if delta < -1048576 or delta >= 1048576:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_ADR_PREL_LO21 delta out of signed 21-bit range (S + A - P)")
        return RelocResult(success: true, offset: offset, value: delta, error: "")

    if rtype == R_AARCH64_ADR_PREL_PG_HI21 or rtype == R_AARCH64_ADR_PREL_PG_HI21_NC or rtype == R_AARCH64_ADR_GOT_PAGE or
            rtype == R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21:
        # ADR_GOT_PAGE: the caller passes S = the GOT-entry address (G) and
        # A = 0, so the ADRP page formula below is shared verbatim.
        # Page(S+A) - Page(P), right-shifted 12 to a signed 21-bit page count.
        # Page(x) = x with the low 12 bits cleared (x - (x & 0xfff) avoids
        # needing a 64-bit-wide bitwise-not literal).
        val target_page = (s + a) - ((s + a) & 0xfff)
        val place_page = p - (p & 0xfff)
        val page_delta_pages = (target_page - place_page) >> 12
        # AAELF64: the field is a signed 21-bit page count (raw byte delta
        # Page(S+A)-Page(P) in [-2^32, 2^32)). Reject rather than silently
        # mask immlo/immhi on overflow.
        if rtype != R_AARCH64_ADR_PREL_PG_HI21_NC and
                (page_delta_pages < -1048576 or page_delta_pages > 1048575):
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_ADR_PREL_PG_HI21 page delta out of signed 21-bit range (Page(S+A) - Page(P)) >> 12")
        return RelocResult(success: true, offset: offset, value: page_delta_pages, error: "")

    if rtype == R_AARCH64_ADD_ABS_LO12_NC:
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12, error: "")

    if rtype == R_AARCH64_TLSLE_ADD_TPREL_HI12:
        if s < 0 or s >= 0x1000000:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_ADD_TPREL_HI12 TPREL out of unsigned 24-bit range")
        return RelocResult(success: true, offset: offset, value: (s >> 12) & 0xfff, error: "")

    if rtype >= R_AARCH64_TLSLE_MOVW_TPREL_G2 and rtype <= R_AARCH64_TLSLE_MOVW_TPREL_G0_NC:
        if s < 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_MOVW_TPREL_G* requires a non-negative TPREL")
        var shift: i64 = 0
        var checked_limit: i64 = 0x10000
        if rtype == R_AARCH64_TLSLE_MOVW_TPREL_G2:
            shift = 32
            checked_limit = 0x1000000000000
        elif rtype == R_AARCH64_TLSLE_MOVW_TPREL_G1 or rtype == R_AARCH64_TLSLE_MOVW_TPREL_G1_NC:
            shift = 16
            checked_limit = 0x100000000
        val checked = rtype == R_AARCH64_TLSLE_MOVW_TPREL_G2 or
            rtype == R_AARCH64_TLSLE_MOVW_TPREL_G1 or
            rtype == R_AARCH64_TLSLE_MOVW_TPREL_G0
        if checked and s >= checked_limit:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_MOVW_TPREL_G* value exceeds checked group range")
        return RelocResult(success: true, offset: offset, value: (s >> shift) & 0xffff, error: "")

    if rtype == R_AARCH64_TLSLE_ADD_TPREL_LO12 or rtype == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC:
        if rtype == R_AARCH64_TLSLE_ADD_TPREL_LO12 and (s < 0 or s >= 0x1000000):
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_ADD_TPREL_LO12 TPREL out of unsigned 24-bit range")
        return RelocResult(success: true, offset: offset, value: s & 0xfff, error: "")

    if rtype >= R_AARCH64_TLSLE_LDST8_TPREL_LO12 and rtype <= R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC or
            rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC:
        val checked = rtype == R_AARCH64_TLSLE_LDST8_TPREL_LO12 or
            rtype == R_AARCH64_TLSLE_LDST16_TPREL_LO12 or
            rtype == R_AARCH64_TLSLE_LDST32_TPREL_LO12 or
            rtype == R_AARCH64_TLSLE_LDST64_TPREL_LO12 or
            rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12
        if checked and (s < 0 or s >= 0x1000000):
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_LDST*_TPREL_LO12 TPREL out of unsigned 24-bit range")
        var shift: i64 = 0
        if rtype == R_AARCH64_TLSLE_LDST16_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST16_TPREL_LO12_NC: shift = 1
        elif rtype == R_AARCH64_TLSLE_LDST32_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST32_TPREL_LO12_NC: shift = 2
        elif rtype == R_AARCH64_TLSLE_LDST64_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC: shift = 3
        elif rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC: shift = 4
        val alignment = 1 << shift
        if s & (alignment - 1) != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_TLSLE_LDST*_TPREL_LO12 target is not naturally aligned")
        return RelocResult(success: true, offset: offset, value: (s & 0xfff) >> shift, error: "")

    if rtype == R_AARCH64_LDST64_ABS_LO12_NC or rtype == R_AARCH64_LD64_GOT_LO12_NC or
            rtype == R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC:
        # LD64_GOT_LO12_NC: S = GOT-entry address (G), A = 0 — same encoding.
        # 64-bit LDR/STR (unsigned offset) requires 8-byte alignment; the
        # AAELF64 relocation is only valid when (S+A) is 8-byte aligned.
        if (s + a) & 0x7 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_LDST64_ABS_LO12_NC target not 8-byte aligned: (S + A) & 0x7 != 0")
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12 >> 3, error: "")

    if rtype == R_AARCH64_LDST8_ABS_LO12_NC:
        # Byte access: scale 1, no alignment constraint — every byte offset
        # is valid, so this is the one LDST*_ABS_LO12_NC variant with no
        # reject path on the target itself.
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12, error: "")

    if rtype == R_AARCH64_LDST16_ABS_LO12_NC:
        if (s + a) & 0x1 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_LDST16_ABS_LO12_NC target not 2-byte aligned: (S + A) & 0x1 != 0")
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12 >> 1, error: "")

    if rtype == R_AARCH64_LDST32_ABS_LO12_NC:
        if (s + a) & 0x3 != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_LDST32_ABS_LO12_NC target not 4-byte aligned: (S + A) & 0x3 != 0")
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12 >> 2, error: "")

    if rtype == R_AARCH64_LDST128_ABS_LO12_NC:
        if (s + a) & 0xf != 0:
            return RelocResult(success: false, offset: offset, value: 0, error: "R_AARCH64_LDST128_ABS_LO12_NC target not 16-byte aligned: (S + A) & 0xf != 0")
        val lo12 = (s + a) & 0xfff
        return RelocResult(success: true, offset: offset, value: lo12 >> 4, error: "")

    if rtype == R_AARCH64_LD64_GOTPAGE_LO15:
        val got_page_offset = s + a - p
        if got_page_offset < 0 or got_page_offset > 32767:
            return RelocResult(success: false, offset: offset, value: 0,
                error: "R_AARCH64_LD64_GOTPAGE_LO15 offset from Page(GOT) exceeds unsigned 15-bit range")
        if got_page_offset & 0x7 != 0:
            return RelocResult(success: false, offset: offset, value: 0,
                error: "R_AARCH64_LD64_GOTPAGE_LO15 GOT entry is not 8-byte aligned")
        return RelocResult(success: true, offset: offset, value: got_page_offset >> 3, error: "")

    RelocResult(success: false, offset: offset, value: 0, error: "unsupported aarch64 reloc type {rtype}")

# ============================================================================
# RISC-V Relocation Application (scaffold)
# ============================================================================

# reason: positional linker reloc_engine API
fn reloc_apply_riscv(bytes: [i64], offset: i64, rtype: i64, s: i64, a: i64, p: i64) -> RelocResult:
    if rtype == R_RISCV_NONE:
        return RelocResult(success: true, offset: offset, value: 0, error: "")

    if rtype == R_RISCV_32:
        val v = s + a
        return RelocResult(success: true, offset: offset, value: v & 0xffffffff, error: "")

    if rtype == R_RISCV_64:
        val v = s + a
        return RelocResult(success: true, offset: offset, value: v, error: "")

    if rtype == R_RISCV_HI20:
        val v = s + a
        return RelocResult(success: true, offset: offset, value: (v + 0x800) >> 12, error: "")

    if rtype == R_RISCV_LO12_I:
        val v = s + a
        return RelocResult(success: true, offset: offset, value: v & 0xfff, error: "")

    RelocResult(success: false, offset: offset, value: 0, error: "unsupported riscv reloc type {rtype}")

# ============================================================================
# Unified dispatch
# ============================================================================

# reason: positional linker reloc_engine API
fn reloc_apply(arch: RelocArch, bytes: [i64], offset: i64, rtype: i64, s: i64, a: i64, p: i64) -> RelocResult:
    match arch:
        case X86_64:
            reloc_apply_x86_64(bytes, offset, rtype, s, a, p)
        case AArch64:
            reloc_apply_aarch64(bytes, offset, rtype, s, a, p)
        case Riscv32:
            reloc_apply_riscv(bytes, offset, rtype, s, a, p)
        case Riscv64:
            reloc_apply_riscv(bytes, offset, rtype, s, a, p)

# reason: positional linker reloc_engine API
fn reloc_patch_bytes(arch: RelocArch, bytes: [i64], offset: i64, rtype: i64, s: i64, a: i64, p: i64) -> [i64]:
    val result = reloc_apply(arch, bytes, offset, rtype, s, a, p)
    if not result.success:
        return bytes

    match arch:
        case X86_64:
            if rtype == R_X86_64_64 or rtype == R_X86_64_PC64:
                patch_u64_le(bytes, offset, result.value)
            else if rtype == R_X86_64_16 or rtype == R_X86_64_PC16:
                patch_u16_le(bytes, offset, result.value)
            else if rtype == R_X86_64_8 or rtype == R_X86_64_PC8:
                patch_u8(bytes, offset, result.value)
            else:
                patch_u32_le(bytes, offset, result.value)
        case AArch64:
            if rtype == R_AARCH64_ABS64 or rtype == R_AARCH64_PREL64:
                patch_u64_le(bytes, offset, result.value)
            else if rtype >= R_AARCH64_MOVW_SABS_G0 and rtype <= R_AARCH64_MOVW_SABS_G2:
                val insn = read_u32_le(bytes, offset)
                val opcode = if s + a < 0: 0 else: 0x40000000
                patch_u32_le(bytes, offset,
                    (insn & 0x9fe0001f) | opcode | ((result.value & 0xffff) << 5))
            else if rtype >= R_AARCH64_MOVW_UABS_G0 and rtype <= R_AARCH64_MOVW_UABS_G3:
                val insn = read_u32_le(bytes, offset)
                val checked = rtype == R_AARCH64_MOVW_UABS_G0 or
                    rtype == R_AARCH64_MOVW_UABS_G1 or
                    rtype == R_AARCH64_MOVW_UABS_G2 or
                    rtype == R_AARCH64_MOVW_UABS_G3
                val keep = if checked: 0x9fe0001f else: 0xffe0001f
                val opcode = if checked: 0x40000000 else: 0
                patch_u32_le(bytes, offset,
                    (insn & keep) | opcode | ((result.value & 0xffff) << 5))
            else if rtype >= R_AARCH64_MOVW_PREL_G0 and rtype <= R_AARCH64_MOVW_PREL_G3:
                val insn = read_u32_le(bytes, offset)
                val checked = rtype == R_AARCH64_MOVW_PREL_G0 or
                    rtype == R_AARCH64_MOVW_PREL_G1 or
                    rtype == R_AARCH64_MOVW_PREL_G2 or
                    rtype == R_AARCH64_MOVW_PREL_G3
                val keep = if checked: 0x9fe0001f else: 0xffe0001f
                val opcode = if checked and s + a - p >= 0: 0x40000000 else: 0
                patch_u32_le(bytes, offset,
                    (insn & keep) | opcode | ((result.value & 0xffff) << 5))
            else if rtype >= R_AARCH64_TLSLE_MOVW_TPREL_G2 and rtype <= R_AARCH64_TLSLE_MOVW_TPREL_G0_NC:
                val insn = read_u32_le(bytes, offset)
                val checked = rtype == R_AARCH64_TLSLE_MOVW_TPREL_G2 or
                    rtype == R_AARCH64_TLSLE_MOVW_TPREL_G1 or
                    rtype == R_AARCH64_TLSLE_MOVW_TPREL_G0
                val keep = if checked: 0x9fe0001f else: 0xffe0001f
                val opcode = if checked and s + a >= 0: 0x40000000 else: 0
                patch_u32_le(bytes, offset,
                    (insn & keep) | opcode | ((result.value & 0xffff) << 5))
            else if rtype == R_AARCH64_ABS16 or rtype == R_AARCH64_PREL16:
                patch_u16_le(bytes, offset, result.value)
            else if rtype == R_AARCH64_CALL26 or rtype == R_AARCH64_JUMP26:
                val insn = read_u32_le(bytes, offset)
                val patched = (insn & 0xfc000000) | (result.value & 0x3ffffff)
                patch_u32_le(bytes, offset, patched)
            else if rtype == R_AARCH64_TSTBR14:
                val insn = read_u32_le(bytes, offset)
                val patched = (insn & 0xfff8001f) | ((result.value & 0x3fff) << 5)
                patch_u32_le(bytes, offset, patched)
            else if rtype == R_AARCH64_CONDBR19 or rtype == R_AARCH64_LD_PREL_LO19 or
                    rtype == R_AARCH64_GOT_LD_PREL19 or rtype == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19:
                val insn = read_u32_le(bytes, offset)
                val patched = (insn & 0xff00001f) | ((result.value & 0x7ffff) << 5)
                patch_u32_le(bytes, offset, patched)
            else if rtype == R_AARCH64_ADR_PREL_LO21 or rtype == R_AARCH64_ADR_PREL_PG_HI21 or rtype == R_AARCH64_ADR_PREL_PG_HI21_NC or rtype == R_AARCH64_ADR_GOT_PAGE or rtype == R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21:
                # immlo (2 bits) -> insn[30:29], immhi (19 bits) -> insn[23:5].
                # Keep-mask 0x9f00001f preserves op(31), fixed bits(28:24), Rd(4:0).
                val insn = read_u32_le(bytes, offset)
                val immlo = result.value & 0x3
                val immhi = (result.value >> 2) & 0x7ffff
                val patched = (insn & 0x9f00001f) | (immlo << 29) | (immhi << 5)
                patch_u32_le(bytes, offset, patched)
            else if rtype == R_AARCH64_ADD_ABS_LO12_NC or rtype == R_AARCH64_TLSLE_ADD_TPREL_HI12 or rtype == R_AARCH64_TLSLE_ADD_TPREL_LO12 or rtype == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC or (rtype >= R_AARCH64_TLSLE_LDST8_TPREL_LO12 and rtype <= R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC) or rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12 or rtype == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC or rtype == R_AARCH64_LDST64_ABS_LO12_NC or rtype == R_AARCH64_LDST8_ABS_LO12_NC or rtype == R_AARCH64_LDST16_ABS_LO12_NC or rtype == R_AARCH64_LDST32_ABS_LO12_NC or rtype == R_AARCH64_LDST128_ABS_LO12_NC or rtype == R_AARCH64_LD64_GOT_LO12_NC or rtype == R_AARCH64_LD64_GOTPAGE_LO15 or rtype == R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC:
                # imm12 -> insn[21:10]; keep-mask 0xffc003ff clears exactly that field.
                val insn = read_u32_le(bytes, offset)
                val patched = (insn & 0xffc003ff) | ((result.value & 0xfff) << 10)
                patch_u32_le(bytes, offset, patched)
            else:
                patch_u32_le(bytes, offset, result.value)
        case Riscv32:
            patch_u32_le(bytes, offset, result.value)
        case Riscv64:
            if rtype == R_RISCV_64:
                patch_u64_le(bytes, offset, result.value)
            else:
                patch_u32_le(bytes, offset, result.value)

fn reloc_arch_from_machine(machine: i64) -> RelocArch:
    if machine == 62:
        RelocArch.X86_64
    else if machine == 183:
        RelocArch.AArch64
    else if machine == 243:
        RelocArch.Riscv64
    else:
        RelocArch.X86_64

# ============================================================================
# Exports
# ============================================================================

export RelocArch, RelocTarget, RelocResult
export reloc_apply, reloc_apply_x86_64, reloc_apply_aarch64, reloc_apply_riscv
export reloc_patch_bytes, reloc_arch_from_machine
export patch_u8, patch_u16_le, patch_u32_le, patch_u64_le, read_u32_le
export R_X86_64_NONE, R_X86_64_64, R_X86_64_PC32, R_X86_64_PC64, R_X86_64_GOTPC32
export R_X86_64_16, R_X86_64_PC16, R_X86_64_8, R_X86_64_PC8, R_X86_64_GOT32
