"""Output `.comment` (SHT_PROGBITS, SHF_MERGE|SHF_STRINGS, entsize 1), as ld.lld writes it:
a leading empty string, every input `.comment` string once, then the linker's own identity."""

use compiler.backend.linker.elf_parser.{ElfObject, elf_section_name}

# The Simple linker names itself rather than copying lld's "Linker: LLD x.y":
# .comment records who produced the file, and claiming lld would be false.
val ELF_COMMENT_LINKER_IDENT: text = "Linker: Simple ELF linker"
val SHF_MERGE_STRINGS: i64 = 0x30

fn elf_merge_comment_strings(payloads: [[i64]]) -> [i64]:
    """Merge NUL-terminated strings, deduplicated in first-seen order."""
    var seen: {text: bool} = {}
    var out: [i64] = [0]
    var pieces: [[i64]] = []
    for p in payloads: pieces.push(p)
    var ident: [i64] = []
    for c in ELF_COMMENT_LINKER_IDENT.bytes(): ident.push(c as i64)
    ident.push(0)
    pieces.push(ident)
    for p in pieces:
        var cur: [i64] = []
        var key = ""
        var terminated: [i64] = []
        for c in p: terminated.push(c)
        # An unterminated last string is kept, NUL-terminated.
        if terminated.len() > 0 and terminated[terminated.len() - 1] != 0: terminated.push(0)
        for c in terminated:
            if c == 0:
                if cur.len() > 0 and not seen.has(key):
                    seen[key] = true
                    for x in cur: out.push(x)
                    out.push(0)
                cur = []
                key = ""
            else:
                cur.push(c)
                # Byte-exact key: decimal per byte, so 0x80+ bytes stay one-to-one.
                key = key + "{c},"
    out

fn elf_collect_comment_sections(objects: [ElfObject]) -> [[i64]]:
    """Raw bytes of every input PROGBITS .comment, in input order."""
    var out: [[i64]] = []
    for obj in objects:
        var si: i64 = 0
        while si < obj.sections.len():
            val sec = obj.sections[si]
            if sec.sh_type == 1 and sec.sh_size > 0 and elf_section_name(obj, si) == ".comment":
                # sections[si].sh_addr is the FILE offset (elf_parser convention)
                var bytes: [i64] = []
                for c in obj.raw[sec.sh_addr:sec.sh_addr + sec.sh_size]: bytes.push(c as i64)
                out.push(bytes)
            si = si + 1
    out

export ELF_COMMENT_LINKER_IDENT, SHF_MERGE_STRINGS, elf_merge_comment_strings, elf_collect_comment_sections
