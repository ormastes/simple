# x86_64 TLS model relaxations performed before symbol resolution and GC.

use compiler.backend.linker.elf_parser.{
    ElfObject, ElfRelocation, elf_reloc_sym, elf_reloc_type
}
use compiler.backend.linker.reloc_engine.{RelocArch}

val R_X86_64_PLT32_TLS: i64 = 4
val R_X86_64_TLSGD_TLS: i64 = 19
val R_X86_64_GOTTPOFF_TLS: i64 = 22

fn _tls_gd_pair(obj: ElfObject, reloc: ElfRelocation) -> i64:
    var i: i64 = 0
    while i < obj.relocations.len():
        val next = obj.relocations[i]
        if next.target_section_idx == reloc.target_section_idx and
                next.r_offset == reloc.r_offset + 8 and elf_reloc_type(next) == R_X86_64_PLT32_TLS:
            val sym = elf_reloc_sym(next)
            if sym > 0 and sym < obj.symbols.len() and obj.symbols[sym].name == "__tls_get_addr":
                return i
        i = i + 1
    -1

fn _tls_is_pair(obj: ElfObject, index: i64) -> bool:
    val candidate = obj.relocations[index]
    if elf_reloc_type(candidate) != R_X86_64_PLT32_TLS:
        return false
    var i: i64 = 0
    while i < obj.relocations.len():
        val r = obj.relocations[i]
        if elf_reloc_type(r) == R_X86_64_TLSGD_TLS and _tls_gd_pair(obj, r) == index:
            return true
        i = i + 1
    false

fn _tls_relax_object(obj: ElfObject) -> Result<ElfObject, text>:
    var raw = obj.raw
    var relocs: [ElfRelocation] = []
    var i: i64 = 0
    while i < obj.relocations.len():
        val r = obj.relocations[i]
        if elf_reloc_type(r) == R_X86_64_TLSGD_TLS:
            if _tls_gd_pair(obj, r) < 0:
                return Err("UnsupportedFeature: R_X86_64_TLSGD is not followed by the canonical __tls_get_addr call")
            val si = r.target_section_idx
            if si <= 0 or si >= obj.sections.len() or r.r_offset < 4:
                return Err("malformed R_X86_64_TLSGD target")
            val at = obj.sections[si].sh_addr + r.r_offset - 4
            if at < 0 or at + 16 > raw.len():
                return Err("truncated R_X86_64_TLSGD instruction sequence")
            if raw[at] != 0x66 or raw[at + 1] != 0x48 or raw[at + 2] != 0x8d or raw[at + 3] != 0x3d or
                    raw[at + 8] != 0x66 or raw[at + 9] != 0x66 or raw[at + 10] != 0x48 or raw[at + 11] != 0xe8:
                return Err("UnsupportedFeature: non-canonical x86_64 TLSGD instruction sequence")
            val replacement: [i64] = [
                0x64, 0x48, 0x8b, 0x04, 0x25, 0, 0, 0, 0,
                0x48, 0x03, 0x05, 0, 0, 0, 0
            ]
            var bi: i64 = 0
            while bi < replacement.len():
                raw[at + bi] = replacement[bi] as u8
                bi = bi + 1
            val info = (elf_reloc_sym(r) << 32) | R_X86_64_GOTTPOFF_TLS
            relocs = relocs.push(ElfRelocation(r_offset: r.r_offset + 8, r_info: info,
                r_addend: r.r_addend, section_idx: r.section_idx,
                target_section_idx: r.target_section_idx))
        else if not _tls_is_pair(obj, i):
            relocs = relocs.push(r)
        i = i + 1
    Ok(ElfObject(header: obj.header, sections: obj.sections, symbols: obj.symbols,
        relocations: relocs, strtab: obj.strtab, shstrtab: obj.shstrtab, raw: raw))

fn elf_relax_tls(objects: [ElfObject], target: RelocArch) -> Result<[ElfObject], text>:
    match target:
        case X86_64:
            var out: [ElfObject] = []
            for obj in objects:
                out = out.push(_tls_relax_object(obj)?)
            Ok(out)
        case _:
            Ok(objects)

export elf_relax_tls
