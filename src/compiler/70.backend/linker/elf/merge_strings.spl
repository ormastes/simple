# Exact deduplication for allocatable ELF SHF_MERGE|SHF_STRINGS sections.
# Input fragments are NUL-terminated strings with sh_entsize == 1. The plan
# owns pooled output bytes and maps every original fragment byte to its pooled
# offset, so section-symbol plus addend relocations remain exact.

use compiler.backend.linker.elf_parser.{
    ElfObject, elf_section_entsize, elf_section_name
}

val SHF_ALLOC_MERGE: i64 = 0x2
val SHF_MERGE_MERGE: i64 = 0x10
val SHF_STRINGS_MERGE: i64 = 0x20

struct ElfMergeStringEntry:
    obj_idx: i64
    section_idx: i64
    input_offset: i64
    size: i64
    output_offset: i64

struct ElfMergeStringPlan:
    data: [i64]
    entries: [ElfMergeStringEntry]
    has_sections: bool

fn _same_bytes(pool: [i64], at: i64, value: [i64]) -> bool:
    if at < 0 or at + value.len() > pool.len():
        return false
    var i: i64 = 0
    while i < value.len():
        if pool[at + i] != value[i]:
            return false
        i = i + 1
    true

fn _fragment_hash(value: [i64]) -> i64:
    var hash: i64 = 5381
    for byte in value:
        hash = (hash * 33 + byte) & 0xffffffff
    hash

fn _find_fragment(pool: [i64], starts: [i64], value: [i64]) -> i64:
    for at in starts:
        if _same_bytes(pool, at, value):
            return at
    -1

fn elf_merge_string_section(obj: ElfObject, section_idx: i64) -> bool:
    val flags = obj.sections[section_idx].sh_flags
    flags & SHF_ALLOC_MERGE != 0 and flags & SHF_MERGE_MERGE != 0 and
        flags & SHF_STRINGS_MERGE != 0

fn elf_merge_strings(objects: [ElfObject], live: [[bool]]) -> Result<ElfMergeStringPlan, text>:
    """Pool identical NUL-terminated strings in deterministic object/section order."""
    var data: [i64] = []
    var buckets: {i64: [i64]} = {}
    var entries: [ElfMergeStringEntry] = []
    var has_sections = false
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var si: i64 = 0
        while si < obj.sections.len():
            if live[oi][si] and elf_merge_string_section(obj, si):
                has_sections = true
                if elf_section_entsize(obj, si) != 1:
                    return Err("object {oi}: merge-string section {elf_section_name(obj, si)} has unsupported sh_entsize {elf_section_entsize(obj, si)}")
                val sec = obj.sections[si]
                var begin: i64 = 0
                var cursor: i64 = 0
                while cursor < sec.sh_size:
                    if obj.raw[sec.sh_addr + cursor] == 0:
                        var value: [i64] = []
                        var p = begin
                        while p <= cursor:
                            value = value.push(obj.raw[sec.sh_addr + p] as i64)
                            p = p + 1
                        val hash = _fragment_hash(value)
                        var candidates: [i64] = []
                        if buckets.has(hash):
                            candidates = buckets[hash]
                        var output = _find_fragment(data, candidates, value)
                        if output < 0:
                            output = data.len()
                            buckets[hash] = candidates.push(output)
                            for byte in value:
                                data = data.push(byte)
                        entries = entries.push(ElfMergeStringEntry(obj_idx: oi, section_idx: si,
                            input_offset: begin, size: cursor - begin + 1, output_offset: output))
                        begin = cursor + 1
                    cursor = cursor + 1
                if begin != sec.sh_size:
                    return Err("object {oi}: merge-string section {elf_section_name(obj, si)} is not NUL terminated")
            si = si + 1
        oi = oi + 1
    Ok(ElfMergeStringPlan(data: data, entries: entries, has_sections: has_sections))

fn elf_merge_offset(plan: ElfMergeStringPlan, obj_idx: i64, section_idx: i64,
        input_offset: i64) -> Result<i64, text>:
    for entry in plan.entries:
        if entry.obj_idx == obj_idx and entry.section_idx == section_idx and
                input_offset >= entry.input_offset and input_offset < entry.input_offset + entry.size:
            return Ok(entry.output_offset + input_offset - entry.input_offset)
    Err("merge-string offset {input_offset} is outside a fragment in object {obj_idx} section {section_idx}")

export ElfMergeStringEntry, ElfMergeStringPlan
export elf_merge_string_section, elf_merge_strings, elf_merge_offset
