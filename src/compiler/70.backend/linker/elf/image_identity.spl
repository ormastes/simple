"""The 20-byte GNU build-id of a linked image, and resealing it after
target-specific header changes.

The payload is the first 20 bytes of SHA-256 over the image with the payload
zeroed. SHA-256 runs through the runtime digest, so a multi-megabyte image
costs milliseconds; the pure-Simple SHA-1 used before took hours at full-CLI
size under the interpreter. The note keeps the 20-byte NT_GNU_BUILD_ID shape
that `--build-id=sha1` produces, so readers that expect 20 bytes still work."""
use compiler.backend.linker.elf_parser.{elf_parse_object, elf_section_name, elf_read_u32_le}
use std.common.crypto.sha256.{sha256_u8_fast_hex}
use std.common.text_bytes.{text_to_bytes}

fn _elf_hex_nibble(code: i64) -> i64:
    if code >= 48 and code <= 57: return code - 48
    if code >= 97 and code <= 102: return code - 87
    code - 55

fn elf_build_id_digest(image: [u8]) -> [u8]:
    """First 20 bytes of SHA-256(image), the build-id payload."""
    val hex = text_to_bytes(sha256_u8_fast_hex(image))
    var digest: [u8] = []
    var index: i64 = 0
    while index < 20:
        val high = _elf_hex_nibble(hex[index * 2] as i64)
        val low = _elf_hex_nibble(hex[index * 2 + 1] as i64)
        digest.push(((high << 4) | low) as u8)
        index = index + 1
    digest

fn elf_reseal_build_id(image: [u8]) -> Result<[u8], text>:
    val object = elf_parse_object(image)?
    if image.len() < 64 or image[4] != 2 or image[5] != 1:
        return Err("ELF identity requires little-endian ELF64")
    if object.header.e_type != 2 and object.header.e_type != 3:
        return Err("ELF identity requires an executable or shared image")
    var offset: i64 = -1
    var index: i64 = 0
    while index < object.sections.len():
        if elf_section_name(object, index) == ".note.gnu.build-id":
            if offset != -1: return Err("ELF identity has duplicate build-id notes")
            val section = object.sections[index]
            if section.sh_type != 7 or section.sh_size != 36:
                return Err("ELF identity requires the canonical 20-byte build-id note")
            offset = section.sh_addr
        index = index + 1
    if offset < 0 or offset > image.len() or 36 > image.len() - offset:
        return Err("ELF identity build-id note is missing or truncated")
    if elf_read_u32_le(image, offset) != 4 or elf_read_u32_le(image, offset + 4) != 20 or
            elf_read_u32_le(image, offset + 8) != 3 or
            image[offset + 12] != 71 or image[offset + 13] != 78 or
            image[offset + 14] != 85 or image[offset + 15] != 0:
        return Err("ELF identity build-id payload is not a GNU build-id")
    var sealed = image
    index = 0
    while index < 20:
        sealed[offset + 16 + index] = 0u8
        index = index + 1
    val digest = elf_build_id_digest(sealed)
    index = 0
    while index < 20:
        sealed[offset + 16 + index] = digest[index]
        index = index + 1
    Ok(sealed)

export elf_build_id_digest, elf_reseal_build_id
