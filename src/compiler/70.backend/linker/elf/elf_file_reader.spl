"""Retained ELF64 little-endian relocatable metadata and bounded section reads.

No raw object or section table array is retained: section headers are decoded on
demand. metadata_table_byte_limit caps serialized index size admitted for work,
not RSS; max_window_bytes bounds section payload allocation. Fixed metadata IO
is 64 bytes regardless of payload window. Extended ELF numbering is rejected.
This reader is a building block, not complete bounded link-engine admission.
The object and its retained handle have one sequential owner.
"""
use std.nogc_sync_mut.io.retained_file.{
    RetainedFile, retained_file_open, retained_file_read_at,
    retained_file_identity_unchanged, retained_file_close
}

pub class ElfFileObjectV1:
    file: RetainedFile
    machine: i64
    flags: u64
    section_table_offset: u64
    section_count: i64
    section_names_index: i64
    metadata_table_bytes: u64
    max_window_bytes: i64

pub struct ElfFileSectionV1:
    name_offset: u64
    section_type: u64
    flags: u64
    address: u64
    file_offset: u64
    size: u64
    link: i64
    info: i64
    alignment: u64
    entry_size: u64

fn _elf_file_field(bytes: [u8], offset: i64, width: i64) -> u64:
    var value: u64 = 0
    for index in 0..width:
        value = value | ((bytes[offset + index] as u64) << (index * 8))
    value

fn _elf_file_exact(file: RetainedFile, offset: u64, count: i64) -> Result<[u8], text>:
    if count < 1 or count > 1048576: return Err("ELF file window invalid")
    if offset > file.size or count as u64 > file.size - offset:
        return Err("ELF file window bounds")
    var bytes: [u8] = []
    while bytes.len() < count:
        val part = retained_file_read_at(file, offset + bytes.len() as u64, count - bytes.len())?
        if part.len() == 0: return Err("ELF file short read")
        for byte in part: bytes.push(byte)
    Ok(bytes)

pub fn elf_file_section_v1(object: ElfFileObjectV1, index: i64) -> Result<ElfFileSectionV1, text>:
    if index < 0 or index >= object.section_count: return Err("ELF section index bounds")
    val bytes = _elf_file_exact(object.file, object.section_table_offset + index as u64 * 64u64, 64)?
    val section = ElfFileSectionV1(
        name_offset: _elf_file_field(bytes, 0, 4), section_type: _elf_file_field(bytes, 4, 4),
        flags: _elf_file_field(bytes, 8, 8), address: _elf_file_field(bytes, 16, 8),
        file_offset: _elf_file_field(bytes, 24, 8), size: _elf_file_field(bytes, 32, 8),
        link: _elf_file_field(bytes, 40, 4) as i64, info: _elf_file_field(bytes, 44, 4) as i64,
        alignment: _elf_file_field(bytes, 48, 8), entry_size: _elf_file_field(bytes, 56, 8))
    if section.section_type != 0u64 and section.section_type != 8u64:
        if section.file_offset > object.file.size or section.size > object.file.size - section.file_offset:
            return Err("ELF file-backed section bounds")
    if section.alignment != 0u64 and (section.alignment & (section.alignment - 1u64)) != 0u64:
        return Err("ELF section alignment invalid")
    Ok(section)

fn _elf_file_decode(file: RetainedFile, metadata_table_byte_limit: u64, max_window_bytes: i64) -> Result<ElfFileObjectV1, text>:
    val bytes = _elf_file_exact(file, 0u64, 64)?
    if bytes[0] != 127u8 or bytes[1] != 69u8 or bytes[2] != 76u8 or bytes[3] != 70u8:
        return Err("ELF file magic invalid")
    if bytes[4] != 2u8 or bytes[5] != 1u8 or bytes[6] != 1u8:
        return Err("ELF file requires ELF64 little-endian version 1")
    if _elf_file_field(bytes, 16, 2) != 1u64 or _elf_file_field(bytes, 20, 4) != 1u64:
        return Err("ELF file requires version 1 relocatable object")
    if _elf_file_field(bytes, 52, 2) != 64u64 or _elf_file_field(bytes, 58, 2) != 64u64:
        return Err("ELF file header sizes unsupported")
    if _elf_file_field(bytes, 56, 2) != 0u64:
        return Err("ELF relocatable program headers unsupported")
    val offset = _elf_file_field(bytes, 40, 8)
    val count = _elf_file_field(bytes, 60, 2) as i64
    val names = _elf_file_field(bytes, 62, 2) as i64
    if count == 0 or names == 65535: return Err("ELF extended section numbering unsupported")
    if names >= count: return Err("ELF section names index bounds")
    val table_bytes = count as u64 * 64u64
    if offset < 64u64 or offset > file.size or table_bytes > file.size - offset:
        return Err("ELF section table bounds")
    if table_bytes > metadata_table_byte_limit: return Err("ELF metadata budget exceeded")
    val object = ElfFileObjectV1(file: file, machine: _elf_file_field(bytes, 18, 2) as i64,
        flags: _elf_file_field(bytes, 48, 4), section_table_offset: offset,
        section_count: count, section_names_index: names,
        metadata_table_bytes: table_bytes, max_window_bytes: max_window_bytes)
    for index in 0..count:
        val section = elf_file_section_v1(object, index)?
        if index == 0 and section.section_type != 0u64: return Err("ELF section zero must be NULL")
    if names != 0:
        val strings = elf_file_section_v1(object, names)?
        if strings.section_type != 3u64: return Err("ELF section names require STRTAB")
    retained_file_identity_unchanged(file)?
    Ok(object)

pub fn elf_file_open_v1(path: text, metadata_table_byte_limit: u64, max_window_bytes: i64) -> Result<ElfFileObjectV1, text>:
    if max_window_bytes < 1 or max_window_bytes > 1048576: return Err("ELF payload window invalid")
    val file = retained_file_open(path, 1099511627776u64)?
    val decoded = _elf_file_decode(file, metadata_table_byte_limit, max_window_bytes)
    if decoded.is_err():
        if not retained_file_close(file): return Err("ELF input close failed after: {decoded.unwrap_err()}")
    decoded

pub fn elf_file_section_window_v1(object: ElfFileObjectV1, index: i64,
        offset: u64, length: i64) -> Result<[u8], text>:
    if length < 1 or length > object.max_window_bytes: return Err("ELF payload window invalid")
    val section = elf_file_section_v1(object, index)?
    if section.section_type == 0u64: return Err("ELF NULL section has no payload")
    if offset > section.size or length as u64 > section.size - offset:
        return Err("ELF section window bounds")
    if section.section_type == 8u64:
        var zeros: [u8] = []
        for index in 0..length: zeros.push(0u8)
        return Ok(zeros)
    _elf_file_exact(object.file, section.file_offset + offset, length)

pub fn elf_file_close_v1(object: ElfFileObjectV1) -> bool:
    retained_file_close(object.file)

export ElfFileObjectV1, ElfFileSectionV1
export elf_file_open_v1, elf_file_section_v1, elf_file_section_window_v1, elf_file_close_v1
