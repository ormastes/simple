# Relocation-graph section garbage collection for internal ELF executable links.

use compiler.backend.linker.elf_parser.{
    ElfObject, ElfRelocation, elf_section_name, elf_reloc_sym, elf_symbol_binding,
    SHN_UNDEF, STB_LOCAL, STB_GLOBAL
}
use compiler.backend.linker.sym_resolver.{SymResolution}

val SHN_COMMON_GC: i64 = 0xfff2
val SHF_ALLOC_GC: i64 = 0x2
val SHF_GNU_RETAIN_GC: i64 = 0x200000
val SHT_NOTE_GC: i64 = 7

struct ElfSectionGc:
    live: [[bool]]
    common_live: {text: bool}

class _GcState:
    """Mark state updated in place. Threading live/worklist values through
    helpers copied the worklist and the mark table on every mark."""
    # workaround: doc/08_tracking/bug/native_array_copy_leaks_2026-10-20.md (flat table; fields avoid
    # the names `flat`/`base`, which fail to parse in native builds)
    var marks: [bool]       # all objects' sections, object-major (flat: a nested
    var bases: [i64]        # row write copied the row per mark in native builds)
    var counts: [i64]
    var work_obj: [i64]
    var work_sec: [i64]
    var commons: {text: bool}

    me mark(oi: i64, si: i64):
        if oi < 0 or oi >= self.bases.len() or si <= 0 or si >= self.counts[oi] or self.marks[self.bases[oi] + si]:
            return
        self.marks[self.bases[oi] + si] = true
        self.work_obj.push(oi)
        self.work_sec.push(si)

    me mark_name(res: SymResolution, name: text):
        if name == "" or not res.defined.has(name):
            return
        val e = res.defined[name]
        if e.section_idx == SHN_COMMON_GC:
            self.commons[name] = true
            return
        self.mark(e.obj_idx, e.section_idx)

    me mark_reloc_target(obj: ElfObject, oi: i64, reloc: ElfRelocation, res: SymResolution):
        val sym_idx = elf_reloc_sym(reloc)
        if sym_idx <= 0 or sym_idx >= obj.symbols.len():
            return
        val sym = obj.symbols[sym_idx]
        if elf_symbol_binding(sym) == STB_LOCAL:
            if sym.st_shndx != SHN_UNDEF and sym.st_shndx != SHN_COMMON_GC:
                self.mark(oi, sym.st_shndx)
            return
        self.mark_name(res, sym.name)

    me mark_eh_frame(obj: ElfObject, oi: i64, res: SymResolution):
        """Follow .eh_frame edges like lld: an FDE whose pc_begin target is live
        keeps its other targets (the LSDA) and its CIE's (the personality)."""
        var eh_si: i64 = -1
        var si: i64 = 1
        while si < obj.sections.len():
            if elf_section_name(obj, si) == ".eh_frame":
                eh_si = si
            si = si + 1
        if eh_si < 0 or not self.marks[self.bases[oi] + eh_si]:
            return
        val sec = obj.sections[eh_si]
        var offsets: [i64] = []
        var ends: [i64] = []
        var cie_offsets: [i64] = []
        var off: i64 = 0
        while off + 4 <= sec.sh_size:
            val length = _gc_u32(obj.raw, sec.sh_addr + off)
            if length == 0:
                off = off + 4
                continue
            if length == 0xffffffff or length < 4 or off + 4 + length > sec.sh_size:
                break  # the strict .eh_frame_hdr builder reports malformed records
            val id = _gc_u32(obj.raw, sec.sh_addr + off + 4)
            offsets = offsets.push(off)
            ends = ends.push(off + 4 + length)
            cie_offsets = cie_offsets.push(if id == 0: -1 else: off + 4 - id)
            off = off + 4 + length
        var record_at: {i64: i64} = {}
        var keep: [bool] = []
        var ri: i64 = 0
        while ri < offsets.len():
            record_at[offsets[ri]] = ri
            keep = keep.push(false)
            ri = ri + 1
        for reloc in obj.relocations:
            if reloc.target_section_idx != eh_si:
                continue
            val fi = _gc_eh_record(offsets, ends, reloc.r_offset)
            if fi >= 0 and cie_offsets[fi] >= 0 and reloc.r_offset == offsets[fi] + 8 and
                    self.target_live(obj, oi, reloc, res):
                keep[fi] = true
                if record_at.has(cie_offsets[fi]):
                    keep[record_at[cie_offsets[fi]]] = true
        for reloc in obj.relocations:
            if reloc.target_section_idx != eh_si:
                continue
            val ki = _gc_eh_record(offsets, ends, reloc.r_offset)
            if ki < 0 or not keep[ki]:
                continue
            if cie_offsets[ki] >= 0 and reloc.r_offset == offsets[ki] + 8:
                continue  # pc_begin: the function itself is not kept by its FDE
            self.mark_reloc_target(obj, oi, reloc, res)

    me target_live(obj: ElfObject, oi: i64, reloc: ElfRelocation, res: SymResolution) -> bool:
        val sym_idx = elf_reloc_sym(reloc)
        if sym_idx <= 0 or sym_idx >= obj.symbols.len():
            return false
        val sym = obj.symbols[sym_idx]
        var target_obj = oi
        var target_sec = sym.st_shndx
        if elf_symbol_binding(sym) != STB_LOCAL and sym.name != "" and res.defined.has(sym.name):
            val e = res.defined[sym.name]
            target_obj = e.obj_idx
            target_sec = e.section_idx
        if target_sec == SHN_UNDEF or target_sec == SHN_COMMON_GC:
            return false
        target_obj >= 0 and target_obj < self.bases.len() and target_sec > 0 and
            target_sec < self.counts[target_obj] and self.marks[self.bases[target_obj] + target_sec]


    me rows() -> [[bool]]:
        var live: [[bool]] = []
        var oi: i64 = 0
        while oi < self.bases.len():
            live.push(self.marks[self.bases[oi]:self.bases[oi] + self.counts[oi]])
            oi = oi + 1
        live

fn _gc_u32(raw: [u8], off: i64) -> i64:
    (raw[off] as i64) | ((raw[off + 1] as i64) << 8) |
        ((raw[off + 2] as i64) << 16) | ((raw[off + 3] as i64) << 24)

fn _gc_eh_record(offsets: [i64], ends: [i64], at: i64) -> i64:
    """Index of the ascending .eh_frame record containing byte at, or -1."""
    var lo: i64 = 0
    var hi: i64 = offsets.len() - 1
    while lo <= hi:
        val mid = (lo + hi) / 2
        if at < offsets[mid]:
            hi = mid - 1
        elif at >= ends[mid]:
            lo = mid + 1
        else:
            return mid
    -1

fn _gc_glob(pat: text, value: text) -> bool:
    var pi: i64 = 0
    var vi: i64 = 0
    var star: i64 = -1
    var mark: i64 = 0
    while vi < value.len():
        if pi < pat.len() and (pat[pi:pi + 1] == "?" or pat[pi:pi + 1] == value[vi:vi + 1]):
            pi = pi + 1
            vi = vi + 1
        elif pi < pat.len() and pat[pi:pi + 1] == "*":
            star = pi
            mark = vi
            pi = pi + 1
        elif star >= 0:
            pi = star + 1
            mark = mark + 1
            vi = mark
        else:
            return false
    while pi < pat.len() and pat[pi:pi + 1] == "*": pi = pi + 1
    pi == pat.len()

fn _gc_reloc_ranges(obj: ElfObject) -> [i64]:
    """Per target section: [start, end) into obj.relocations, flattened as
    2*si/2*si+1, or -2 in slot 0 when a section's relocations are not
    contiguous (then callers scan). Relocations come from one RELA section
    per target, so they are contiguous in practice."""
    var ranges: [i64] = []
    for _ in obj.sections:
        ranges.push(-1)
        ranges.push(-1)
    var i: i64 = 0
    var previous: i64 = -1
    while i < obj.relocations.len():
        val t = obj.relocations[i].target_section_idx
        if t >= 0 and t < obj.sections.len():
            if t != previous:
                if ranges[t * 2] >= 0:
                    ranges[0] = -2
                    return ranges
                ranges[t * 2] = i
            ranges[t * 2 + 1] = i + 1
        previous = t
        i = i + 1
    ranges

fn elf_section_gc(objects: [ElfObject], res: SymResolution, entry: text,
        retained: [text], root_patterns: [text]) -> ElfSectionGc:
    var marks: [bool] = []
    var bases: [i64] = []
    var counts: [i64] = []
    for obj in objects:
        bases.push(marks.len())
        counts.push(obj.sections.len())
        for _ in obj.sections:
            marks.push(false)
    var state = _GcState(marks: marks, bases: bases, counts: counts, work_obj: [], work_sec: [], commons: {})

    state.mark_name(res, entry)
    for name in retained:
        state.mark_name(res, name)

    if root_patterns.contains("COMMON"):
        for name in res.defined.keys():
            if res.defined[name].section_idx == SHN_COMMON_GC:
                state.commons[name] = true

    var ranges: [[i64]] = []
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        ranges.push(_gc_reloc_ranges(obj))
        var si: i64 = 1
        while si < obj.sections.len():
            val sec = obj.sections[si]
            val name = elf_section_name(obj, si)
            var pattern_root = false
            for pattern in root_patterns:
                if _gc_glob(pattern, name): pattern_root = true
            if sec.sh_flags & SHF_ALLOC_GC != 0 and
                    (sec.sh_type == SHT_NOTE_GC or
                     sec.sh_flags & SHF_GNU_RETAIN_GC != 0 or name == ".init" or name == ".fini" or
                     name.starts_with(".init_array") or name.starts_with(".fini_array") or
                     name.starts_with(".preinit_array") or name == ".eh_frame" or pattern_root):
                state.mark(oi, si)
            si = si + 1
        oi = oi + 1

    var wi: i64 = 0
    var scanning = true
    while scanning:
        while wi < state.work_obj.len():
            oi = state.work_obj[wi]
            val si = state.work_sec[wi]
            val obj = objects[oi]
            if elf_section_name(obj, si) == ".eh_frame":
                wi = wi + 1
                continue
            # workaround: doc/08_tracking/bug/native_array_copy_leaks_2026-10-20.md
            # Index ranges[oi] directly: binding the row to a val copies it.
            if ranges[oi][0] == -2:
                for reloc in obj.relocations:
                    if reloc.target_section_idx == si:
                        state.mark_reloc_target(obj, oi, reloc, res)
            elif ranges[oi][si * 2] >= 0:
                var ri = ranges[oi][si * 2]
                val stop = ranges[oi][si * 2 + 1]
                while ri < stop:
                    state.mark_reloc_target(obj, oi, obj.relocations[ri], res)
                    ri = ri + 1
            wi = wi + 1
        # .eh_frame is a root whose edges are conditional on the FDE's
        # function being live; newly kept LSDAs/personalities can reach more.
        val before = state.work_obj.len()
        oi = 0
        while oi < objects.len():
            state.mark_eh_frame(objects[oi], oi, res)
            oi = oi + 1
        scanning = state.work_obj.len() > before
    ElfSectionGc(live: state.rows(), common_live: state.commons)

fn elf_section_keep_all(objects: [ElfObject], res: SymResolution) -> ElfSectionGc:
    """No-GC policy: retain every allocatable input section and COMMON."""
    var live: [[bool]] = []
    for obj in objects:
        var row: [bool] = []
        for section in obj.sections:
            row = row.push(section.sh_flags & SHF_ALLOC_GC != 0)
        live = live.push(row)
    var commons: {text: bool} = {}
    for name in res.defined.keys():
        if res.defined[name].section_idx == SHN_COMMON_GC:
            commons[name] = true
    ElfSectionGc(live: live, common_live: commons)

fn elf_gc_undefined(objects: [ElfObject], live: [[bool]], res: SymResolution) -> [text]:
    var out: [text] = []
    var seen: {text: bool} = {}
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        for reloc in obj.relocations:
            val si = reloc.target_section_idx
            if si < 0 or si >= live[oi].len() or not live[oi][si]:
                continue
            val sym_idx = elf_reloc_sym(reloc)
            if sym_idx <= 0 or sym_idx >= obj.symbols.len():
                continue
            val sym = obj.symbols[sym_idx]
            if sym.st_shndx == SHN_UNDEF and elf_symbol_binding(sym) == STB_GLOBAL and sym.name != "" and
                    not res.defined.has(sym.name) and not seen.has(sym.name):
                seen[sym.name] = true
                out = out.push(sym.name)
        oi = oi + 1
    out

export ElfSectionGc, elf_section_gc, elf_section_keep_all, elf_gc_undefined
