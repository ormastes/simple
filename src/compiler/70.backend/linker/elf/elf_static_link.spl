    elf_plt_size, elf_plt0_size, elf_plt_entry_size, elf_gotplt_size, elf_build_plt_a64, elf_build_gotplt,
    elf_build_plt_x64, elf_build_gotplt_x64,
    elf_build_dynamic, elf_build_interp, elf_build_gnu_build_id,
    elf_dyn_rel_entry, elf_build_dynsym_class, elf_gnu_hash_size_class, elf_build_gnu_hash_class,
    elf_build_dynamic_class, elf_gotplt_size_class, elf_build_plt_i386, elf_build_gotplt_i386,
    elf_arm_plt_fits, elf_build_plt_arm, elf_build_gotplt_arm,
    elf_gotplt_reserved, elf_build_plt_riscv, elf_build_gotplt_riscv,
    DT_NEEDED, DT_PLTRELSZ, DT_PLTGOT, DT_HASH, DT_STRTAB, DT_SYMTAB, DT_RELA, DT_RELASZ,
    DT_RELAENT, DT_STRSZ, DT_SYMENT, DT_INIT, DT_FINI, DT_PLTREL, DT_DEBUG, DT_JMPREL,
    DT_INIT_ARRAY, DT_FINI_ARRAY, DT_INIT_ARRAYSZ, DT_FINI_ARRAYSZ, DT_RUNPATH,
    DT_PREINIT_ARRAY, DT_PREINIT_ARRAYSZ, DT_GNU_HASH, DT_RELACOUNT, DT_FLAGS,
    DT_FLAGS_1, DT_BIND_NOW, DT_VERSYM, DT_VERNEED, DT_VERNEEDNUM,
    DF_BIND_NOW, DF_1_NOW, DF_1_PIE,
    SHT_RELA_S, SHT_HASH_S, SHT_GNU_HASH_S, SHT_GNU_VERNEED_S, SHT_GNU_VERSYM_S,
    SHT_DYNAMIC_S, SHT_DYNSYM_S, SHF_INFO_LINK_S,
