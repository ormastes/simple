# Internal ELF linker driver — lane A7 slices 1 and 2.
#
# elf_link: ET_REL objects (+ ar archives, + shared objects) -> ELF image bytes
# in one of four modes (reloc_scan ELF_LINK_*):
#   STATIC_EXEC  ET_EXEC at 0x400000, no .dynamic                  (slice 1)
#   STATIC_PIE   ET_DYN at 0, PT_DYNAMIC, no PT_INTERP; code must need no
#                dynamic relocation (there is no self-relocating startup)
#   DYNAMIC_EXEC ET_EXEC + PT_INTERP + DT_NEEDED, PLT/GOT against shared libs
#   DYNAMIC_PIE  ET_DYN  + PT_INTERP + DT_NEEDED + R_*_RELATIVE
# elf_static_link(objects, archives, entry, target) keeps the slice-1 API.
#
# Phases (design §5, mold order): parse (elf_parser, elf/shared_object) ->
# archive closure fixpoint (elf/archive_closure) -> resolve (sym_resolver:
# strong duplicate = error; shared-library exports bind what objects leave
# undefined) -> undefined check -> place input sections into named output
# sections (gc_sections: elf/gc_sections marks live sections first) -> scan
# relocations (elf/reloc_scan: GOT/PLT/dynamic relocs) ->
# size synthetic sections (elf/synthetic_sections) -> layout
# (elf/elf_exec_writer) -> relocate (reloc_engine encoders; any reject = error)
# -> build synthetic contents -> write.
#
# Limits (reported as errors, never silently degraded):
#   - targets: x86_64 and aarch64 (dynamic glibc exec + PIE run on both:
#     aarch64 natively, x86_64 under qemu-x86_64 -L <glibc sysroot>)
#   - no TLS, no COMMON, no copy relocations / canonical PLTs, no text relocs,
#     no COMDAT dedup, no locally defined IFUNC (no IRELATIVE),
#     no property-note merge (they are dropped when the FEATURE_1_AND is 0,
#     which is ld.lld's own result, and rejected otherwise)
#   - SHF_MERGE string merging IS supported and on by default (ld.lld -O1;
#     ElfLinkRequest.string_merge = false is -O0), and section GC IS supported
#     opt-in through ElfLinkRequest.gc_sections (ld.lld --gc-sections)
#   - symbol versioning is emitted for what imports NEED (.gnu.version +
#     .gnu.version_r); this linker defines no versions of its own
#   - single-threaded; no StageReceipts yet

use compiler.backend.linker.elf_parser.{
    ElfObject, ElfSymbol, elf_parse_object, elf_symbol_binding, elf_symbol_type,
    elf_reloc_sym, elf_reloc_type, elf_section_addralign, elf_section_name,
    SHN_UNDEF, STB_LOCAL, STB_GLOBAL, STB_WEAK, STT_SECTION, SHT_NOBITS, SHT_NOTE
}
use compiler.backend.linker.elf_inspect.{ET_REL, EM_X86_64, EM_AARCH64, SHT_PROGBITS}
use compiler.backend.linker.sym_resolver.{SymResolution, SymEntry, sym_resolve_objects}
use compiler.backend.linker.reloc_engine.{RelocArch, reloc_apply, reloc_patch_width, reloc_patch_word}
use compiler.backend.linker.elf.archive_closure.{elf_archive_closure}
use compiler.backend.linker.elf.gc_sections.{elf_gc_live, elf_gc_all_live}
use compiler.backend.linker.elf.merge_sections.{ElfMergeSet, elf_merge_empty, elf_merge_build, elf_merge_piece_off}
use compiler.backend.linker.elf.shared_object.{ElfSharedLib, elf_parse_shared}
use compiler.backend.linker.elf.reloc_scan.{
    ElfScanRef, ElfScan, elf_reloc_scan, elf_reloc_class, elf_x86_can_relax,
    elf_mode_pie, elf_mode_dynamic, elf_target_is_a64,
    ELF_LINK_STATIC_EXEC, ELF_LINK_STATIC_PIE, ELF_LINK_DYNAMIC_EXEC, ELF_LINK_DYNAMIC_PIE,
    SYMREF_DEFINED, SYMREF_IMPORT, SYMREF_WEAK_ZERO, SYMREF_ABS,
    RC_NONE, RC_ABS64, RC_BRANCH, RC_GOT, RC_GOT_RELAX
}
use compiler.backend.linker.elf.synthetic_sections.{
    ElfDynStr, elf_dyn_relative, elf_dyn_glob_dat, elf_dyn_jump_slot, elf_dyn_abs64,
    elf_rela_entry, elf_sym_entry, elf_build_dynstr, elf_build_dynsym, elf_hash_size, elf_build_hash,
    elf_gnu_hash_size, elf_build_gnu_hash,
    elf_versym_size, elf_build_versym, elf_verneed_size, elf_build_verneed,
    elf_plt_size, elf_plt0_size, elf_plt_entry_size, elf_gotplt_size, elf_build_plt_a64, elf_build_gotplt,
    elf_build_plt_x64, elf_build_gotplt_x64,
    elf_build_dynamic, elf_build_interp,
    DT_NEEDED, DT_PLTRELSZ, DT_PLTGOT, DT_HASH, DT_STRTAB, DT_SYMTAB, DT_RELA, DT_RELASZ,
    DT_RELAENT, DT_STRSZ, DT_SYMENT, DT_INIT, DT_FINI, DT_PLTREL, DT_DEBUG, DT_JMPREL,
    DT_INIT_ARRAY, DT_FINI_ARRAY, DT_INIT_ARRAYSZ, DT_FINI_ARRAYSZ,
    DT_PREINIT_ARRAY, DT_PREINIT_ARRAYSZ, DT_GNU_HASH, DT_RELACOUNT, DT_FLAGS_1, DF_1_PIE,
    DT_VERSYM, DT_VERNEED, DT_VERNEEDNUM,
    SHT_RELA_S, SHT_HASH_S, SHT_GNU_HASH_S, SHT_DYNAMIC_S, SHT_DYNSYM_S, SHF_INFO_LINK_S,
    SHT_GNU_VERSYM_S, SHT_GNU_VERNEED_S,
    GOTPLT_RESERVED
}
use compiler.backend.linker.elf.elf_exec_writer.{
    ElfOutSec, ElfExecPlan, elf_out_sec, elf_exec_plan, elf_exec_find, elf_write_image,
    ELF_SEG_R, ELF_SEG_RX, ELF_SEG_RW, ELF_RELRO_PADDING,
    SHF_WRITE, SHF_ALLOC, SHF_EXECINSTR, SHT_PROGBITS_E, SHT_STRTAB_E, SHT_NOBITS_E
}
use std.common.algorithm_utils.{stable_order_by_key}
use compiler.backend.linker.elf_writer.{align_up, write_u32_le, write_u64_le}

val ELF_STATIC_BASE: i64 = 0x400000
val SHN_ABS: i64 = 0xfff1
val SHN_COMMON: i64 = 0xfff2
val SHN_LORESERVE: i64 = 0xff00
val SHF_TLS: i64 = 0x400
val SHT_INIT_ARRAY: i64 = 14
val SHT_FINI_ARRAY: i64 = 15
val SHT_PREINIT_ARRAY: i64 = 16
val SHT_X86_64_UNWIND: i64 = 0x70000001
val ET_EXEC_T: i64 = 2
val ET_DYN_T: i64 = 3
val SHT_SYMTAB_L: i64 = 2
val SHF_MERGE_L: i64 = 0x10
val SHF_STRINGS_L: i64 = 0x20
val VER_NDX_GLOBAL: i64 = 1      # gABI: an import with no version of its own
val VER_FLG_WEAK: i64 = 2        # vna_flags: the DSO defined this version weak
val PROPERTY_NOTE: text = ".note.gnu.property"
val GNU_PROPERTY_AARCH64_FEATURE_1_AND: i64 = 0xc0000000
val GNU_PROPERTY_X86_FEATURE_1_AND: i64 = 0xc0000002

# ============================================================================
# Types
# ============================================================================

struct ElfLinkRequest:
    objects: [[u8]]       # ET_REL bytes, in command-line order (packed: file_read_bytes)
    archives: [[i64]]     # ar archives (fixpoint closure)
    shared: [[u8]]        # ET_DYN shared objects (dynamic modes only)
    entry: text
    target: RelocArch
    mode: i64             # ELF_LINK_*
    interp: text          # PT_INTERP path (dynamic modes only)
    string_merge: bool = true   # ld.lld -O1: dedupe SHF_MERGE pieces (-O0 = false)
    gc_sections: bool = false   # ld.lld --gc-sections: drop sections unreachable from the roots

struct ElfStaticInputs:
    """Every selected input object with per-section placement."""
    objects: [ElfObject]
    sec_out: [[i64]]      # [obj][sec] -> index into outs, -1 = not placed
    sec_off: [[i64]]      # [obj][sec] -> offset inside that output section
    outs: [ElfOutSec]     # input-backed output sections, first-appearance order

struct ElfLinkCtx:
    inputs: ElfStaticInputs
    merged: ElfMergeSet
    res: SymResolution
    libs: [ElfSharedLib]
    target: RelocArch
    mode: i64

# ============================================================================
# Target
# ============================================================================

fn elf_static_machine(target: RelocArch) -> Result<i64, text>:
    match target:
        case X86_64:
            Ok(EM_X86_64)
        case AArch64:
            Ok(EM_AARCH64)
        case _:
            Err("elf_static_link: slice 1 supports only x86_64 and aarch64 targets")

fn elf_static_page(target: RelocArch) -> i64:
    # ld.lld's default max-page-size: 64 KiB on aarch64 (64K-page kernels), 4 KiB on x86_64.
    match target:
        case AArch64:
            0x10000
        case _:
            0x1000

# ============================================================================
# Input classification and placement
# ============================================================================

fn elf_out_name(name: text, sh_type: i64, sh_flags: i64) -> Result<text, text>:
    """Output section an allocatable input section goes to (ld.lld's default rules)."""
    if sh_flags & SHF_TLS != 0:
        return Err("section {name}: TLS (SHF_TLS) is unsupported")
    if sh_type == SHT_NOTE:
        return Ok(name)
    if sh_type == SHT_INIT_ARRAY:
        return Ok(".init_array")
    if sh_type == SHT_FINI_ARRAY:
        return Ok(".fini_array")
    if sh_type == SHT_PREINIT_ARRAY:
        return Ok(".preinit_array")
    if sh_type == SHT_X86_64_UNWIND:
        return Ok(".eh_frame")
    if sh_type != SHT_PROGBITS and sh_type != SHT_NOBITS:
        return Err("section {name}: unsupported allocatable section type {sh_type}")
    if sh_flags & SHF_EXECINSTR != 0:
        if name == ".init" or name == ".fini":
            return Ok(name)
        return Ok(".text")
    if sh_flags & SHF_WRITE != 0:
        if sh_type == SHT_NOBITS:
            return Ok(".bss")
        if name.starts_with(".data.rel.ro"):
            return Ok(".data.rel.ro")
        return Ok(".data")
    if name == ".eh_frame":
        return Ok(".eh_frame")
    Ok(".rodata")

fn elf_seg_of(sh_flags: i64) -> i64:
    if sh_flags & SHF_EXECINSTR != 0:
        return ELF_SEG_RX
    if sh_flags & SHF_WRITE != 0:
        return ELF_SEG_RW
    ELF_SEG_R

fn elf_find_out(outs: [ElfOutSec], name: text) -> i64:
    var i: i64 = 0
    while i < outs.len():
        if outs[i].name == name:
            return i
        i = i + 1
    -1

fn elf_out_names(objects: [ElfObject]) -> Result<[[text]], text>:
    """Output section name per allocatable input section ("" when not placed)."""
    var out: [[text]] = []
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var row: [text] = []
        var si: i64 = 0
        while si < obj.sections.len():
            val sec = obj.sections[si]
            if sec.sh_flags & SHF_ALLOC == 0:
                row = row.push("")
            else:
                val n = elf_out_name(elf_section_name(obj, si), sec.sh_type, sec.sh_flags)
                if n.is_err():
                    return Err("object {oi}: {n.unwrap_err()}")
                row = row.push(n.unwrap())
            si = si + 1
        out = out.push(row)
        oi = oi + 1
    Ok(out)

fn elf_rd_u32(raw: [u8], o: i64) -> i64:
    (raw[o] as i64) | ((raw[o + 1] as i64) << 8) | ((raw[o + 2] as i64) << 16) | ((raw[o + 3] as i64) << 24)

fn elf_object_property_and(obj: ElfObject) -> i64:
    """`GNU_PROPERTY_*_FEATURE_1_AND` of this object's `.note.gnu.property`, or 0.

    0 is also the honest answer for an object that has no such note, which is
    exactly what makes the AND below collapse."""
    var si: i64 = 0
    while si < obj.sections.len():
        if elf_section_name(obj, si) == PROPERTY_NOTE and obj.sections[si].sh_type == SHT_NOTE:
            val sec = obj.sections[si]
            var o = sec.sh_addr
            val end = sec.sh_addr + sec.sh_size
            var acc: i64 = 0
            while o + 12 <= end:
                val namesz = elf_rd_u32(obj.raw, o)
                val descsz = elf_rd_u32(obj.raw, o + 4)
                var d = o + 12 + align_up(namesz, 4)
                val dend = d + descsz
                while d + 8 <= dend and d + 8 <= end:
                    val pr_type = elf_rd_u32(obj.raw, d)
                    val pr_size = elf_rd_u32(obj.raw, d + 4)
                    if (pr_type == GNU_PROPERTY_AARCH64_FEATURE_1_AND or pr_type == GNU_PROPERTY_X86_FEATURE_1_AND) and pr_size >= 4:
                        acc = acc | elf_rd_u32(obj.raw, d + 8)
                    d = d + 8 + align_up(pr_size, 8)
                o = dend
            return acc
        si = si + 1
    0

fn elf_property_policy(objects: [ElfObject]) -> Result<(), text>:
    """Ok when the `.note.gnu.property` inputs may be dropped, Err naming why not.


    ld.lld ANDs `FEATURE_1_AND` across all inputs, so one object without the
    note clears the feature bits and the section disappears. This linker does
    not merge notes or emit `PT_GNU_PROPERTY`, so concatenating the inputs
    would claim IBT/SHSTK for code never built for it. Drop when the AND is 0
    (the ld.lld-identical result); reject by name when it is not, rather than
    emit a note that says something untrue."""
    var acc: i64 = -1
    var any: bool = false
    for obj in objects:
        val v = elf_object_property_and(obj)
        if v != 0:
            any = true
        if acc < 0:
            acc = v
        else:
            acc = acc & v
    if not any:
        return Ok(())
    if acc != 0:
        return Err("UnsupportedFeature: .note.gnu.property FEATURE_1_AND is {acc} across all inputs; this linker neither merges property notes nor emits PT_GNU_PROPERTY")
    Ok(())

# reason: positional placement inputs (objects, liveness, merged-section set)
fn elf_static_place(objects: [ElfObject], live: [[bool]], merged: ElfMergeSet) -> Result<ElfStaticInputs, text>:
    """Assign every live allocatable input section to a named output section + offset.

    live[oi][si] is false only for sections the gc pass dropped; with
    gc_sections off every allocatable section is live (elf_gc_all_live).
    A merged section reserves space only for the first input of its group
    (ld.lld's MergeSyntheticSection, placed where that input would have gone);
    the others record the same offset and contribute no bytes, so an offset
    inside them is resolved through elf_merge_piece_off.

    `.note.gnu.property` inputs are never placed: the only link that reaches
    here is one elf_property_policy admitted, and it admits exactly the links
    whose notes must be dropped."""
    var outs: [ElfOutSec] = []
    var sec_out: [[i64]] = []
    var sec_off: [[i64]] = []
    var ent_seen: [bool] = []
    var grp_at: [i64] = []
    var grp_out: [i64] = []
    var g: i64 = 0
    while g < merged.grp_name.len():
        grp_at = grp_at.push(-1)
        grp_out = grp_out.push(-1)
        g = g + 1
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var idxs: [i64] = []
        var offs: [i64] = []
        var si: i64 = 0
        while si < obj.sections.len():
            val sec = obj.sections[si]
            if sec.sh_flags & SHF_ALLOC == 0 or not live[oi][si] or (sec.sh_type == SHT_NOTE and elf_section_name(obj, si) == PROPERTY_NOTE):
                idxs = idxs.push(-1)
                offs = offs.push(0)
            else if merged.sec_grp[oi][si] >= 0 and grp_at[merged.sec_grp[oi][si]] >= 0:
                # a later input of an already-placed merge group: no space of its own
                val gi = merged.sec_grp[oi][si]
                idxs = idxs.push(grp_out[gi])
                offs = offs.push(grp_at[gi])
            else:
                val oname = elf_out_name(elf_section_name(obj, si), sec.sh_type, sec.sh_flags)
                if oname.is_err():
                    return Err("object {oi}: {oname.unwrap_err()}")
                val name = oname.unwrap()
                var al = elf_section_addralign(obj, si)
                if al < 1:
                    al = 1
                var size = sec.sh_size
                val gi = merged.sec_grp[oi][si]
                if gi >= 0:
                    al = merged.grp_align[gi]
                    size = merged.grp_data[gi].len()
                var k = elf_find_out(outs, name)
                if k < 0:
                    var st = sec.sh_type
                    if st == SHT_X86_64_UNWIND:
                        st = SHT_PROGBITS_E
                    outs = outs.push(elf_out_sec(name, st, sec.sh_flags & (SHF_WRITE | SHF_ALLOC | SHF_EXECINSTR),
                        1, 0, elf_seg_of(sec.sh_flags)))
                    ent_seen = ent_seen.push(false)
                    k = outs.len() - 1
                val o = outs[k]
                val at = align_up(o.size, al)
                var nal = o.align
                if al > nal:
                    nal = al
                # ld.lld commitSection ORs the input flags into the output section, so
                # SHF_MERGE|SHF_STRINGS shows up even when the section is not merged
                var flags = o.sh_flags | (sec.sh_flags & (SHF_MERGE_L | SHF_STRINGS_L))
                # ld.lld OutputSections.cpp commitSection: the output sh_entsize is the
                # inputs' common entsize and 0 as soon as two of them disagree
                var ent_in = elf_section_entsize(obj, si)
                if gi >= 0:
                    ent_in = merged.grp_entsize[gi]
                    grp_at[gi] = at
                    grp_out[gi] = k
                var entsize = ent_in
                if ent_seen[k]:
                    if o.entsize != ent_in:
                        entsize = 0
                    else:
                        entsize = o.entsize
                ent_seen[k] = true
                outs[k] = ElfOutSec(name: o.name, sh_type: o.sh_type, sh_flags: flags, align: nal,
                    size: at + size, entsize: entsize, link: o.link, info: o.info, seg: o.seg)
                idxs = idxs.push(k)
                offs = offs.push(at)
            si = si + 1
        sec_out = sec_out.push(idxs)
        sec_off = sec_off.push(offs)
        oi = oi + 1
    Ok(ElfStaticInputs(objects: objects, sec_out: sec_out, sec_off: sec_off, outs: outs))

fn elf_static_contents(inputs: ElfStaticInputs, merged: ElfMergeSet) -> [[i64]]:
    """Concatenate input section bytes per input-backed output section.

    A merge group contributes its merged blob once, at the offset its first
    input section was placed at; the group's other inputs contribute nothing."""
    var out: [[i64]] = []
    var done: [bool] = []
    var g: i64 = 0
    while g < merged.grp_name.len():
        done = done.push(false)
        g = g + 1
    var k: i64 = 0
    while k < inputs.outs.len():
        var buf: [i64] = []
        if inputs.outs[k].sh_type != SHT_NOBITS_E:
            var oi: i64 = 0
            while oi < inputs.objects.len():
                val obj = inputs.objects[oi]
                var si: i64 = 0
                while si < obj.sections.len():
                    if inputs.sec_out[oi][si] == k:
                        val sec = obj.sections[si]
                        # inline padding and appends: write_zeros / write_bytes
                        # would copy the whole section buffer on every input
                        # section (lane C4), while the merge-group branch (lane
                        # C1) still emits a group's blob exactly once
                        val gi = merged.sec_grp[oi][si]
                        if gi >= 0:
                            if not done[gi]:
                                done[gi] = true
                                while buf.len() < inputs.sec_off[oi][si]:
                                    buf = buf.push(0)
                                val blob = merged.grp_data[gi]
                                var mi: i64 = 0
                                while mi < blob.len():
                                    buf = buf.push(blob[mi])
                                    mi = mi + 1
                        else:
                            while buf.len() < inputs.sec_off[oi][si]:
                                buf = buf.push(0)
                            # sections[si].sh_addr is the FILE offset (elf_parser convention)
                            var bi: i64 = 0
                            while bi < sec.sh_size:
                                buf = buf.push(obj.raw[sec.sh_addr + bi] as i64)
                                bi = bi + 1
                    si = si + 1
                oi = oi + 1
            while buf.len() < inputs.outs[k].size:
                buf = buf.push(0)
        out = out.push(buf)
        k = k + 1
    out

# ============================================================================
# Output section order
# ============================================================================

fn elf_out_rank(s: ElfOutSec) -> i64:
    val n = s.name
    if s.seg == ELF_SEG_R:
        if n == ".interp":
            return 0
        if s.sh_type == 7:
            return 1
        if n == ".dynsym":
            return 2
        if n == ".gnu.version":
            return 3
        if n == ".gnu.version_r":
            return 4
        if n == ".gnu.hash":
            return 5
        if n == ".hash":
            return 5
        if n == ".dynstr":
            return 6
        if n == ".rela.dyn":
            return 7
        if n == ".rela.plt":
            return 8
        if n == ".rodata":
            return 9
        if n == ".eh_frame":
            return 10
        return 11
    if s.seg == ELF_SEG_RX:
        if n == ".text":
            return 20
        if n == ".init":
            return 21
        if n == ".fini":
            return 22
        if n == ".plt":
            return 23
        return 24
    if s.sh_type == SHT_NOBITS_E:
        return 40
    # ld.lld: the non-synthetic RELRO sections share one rank (input order),
    # then .dynamic, then .got; the non-RELRO sections follow
    if elf_is_relro_input(n):
        return 30
    if n == ".dynamic":
        return 34
    if n == ".got":
        return 35
    if n == ".data":
        return 36
    if n == ".got.plt":
        return 37
    38

fn elf_is_relro_input(name: text) -> bool:
    name == ".preinit_array" or name == ".init_array" or name == ".fini_array" or name == ".data.rel.ro"

fn elf_is_relro(s: ElfOutSec) -> bool:
    """PT_GNU_RELRO member (ld.lld -z relro with lazy binding: .got.plt stays writable)."""
    s.seg == ELF_SEG_RW and (elf_is_relro_input(s.name) or s.name == ".dynamic" or s.name == ".got")

fn elf_add_relro_padding(secs: [ElfOutSec]) -> [ElfOutSec]:
    """Insert ELF_RELRO_PADDING after the last RELRO section of sorted secs (none: unchanged)."""
    var last: i64 = -1
    var i: i64 = 0
    while i < secs.len():
        if elf_is_relro(secs[i]):
            last = i
        i = i + 1
    if last < 0:
        return secs
    var out: [ElfOutSec] = []
    i = 0
    while i < secs.len():
        out = out.push(secs[i])
        if i == last:
            out = out.push(elf_out_sec(ELF_RELRO_PADDING, SHT_NOBITS_E, SHF_ALLOC | SHF_WRITE, 1, 0, ELF_SEG_RW))
        i = i + 1
    out

fn elf_sort_outs(secs: [ElfOutSec]) -> [ElfOutSec]:
    """Stable sort by elf_out_rank, via the shared std.common.algorithm_utils
    permutation (one implementation; this used to be a hand-rolled insertion
    sort duplicated here, in coff_layout and in pe_exec_writer)."""
    var keys: [i64] = []
    for s in secs:
        keys = keys.push(elf_out_rank(s))
    var out: [ElfOutSec] = []
    for idx in stable_order_by_key(keys):
        out = out.push(secs[idx])
    out

# ============================================================================
# Symbols
# ============================================================================

fn elf_is_synth(name: text) -> bool:
    name == "_DYNAMIC" or name == "_GLOBAL_OFFSET_TABLE_" or name == "__ehdr_start" or name == "__executable_start" or
        name == "__init_array_start" or name == "__init_array_end" or
        name == "__fini_array_start" or name == "__fini_array_end" or
        name == "__preinit_array_start" or name == "__preinit_array_end"

fn elf_got_base(plan: ElfExecPlan, target: RelocArch) -> i64:
    """Plan index of the section _GLOBAL_OFFSET_TABLE_ points at, or -1.
    ld.lld: .got.plt on x86_64 (gotBaseSymInGotPlt), .got on aarch64."""
    if elf_target_is_a64(target):
        val g = elf_exec_find(plan, ".got")
        if g >= 0:
            return g
        return elf_exec_find(plan, ".got.plt")
    val gp = elf_exec_find(plan, ".got.plt")
    if gp >= 0:
        return gp
    elf_exec_find(plan, ".got")

fn elf_synth_addr(plan: ElfExecPlan, base: i64, name: text, target: RelocArch) -> Result<i64, text>:
    if name == "__ehdr_start" or name == "__executable_start":
        return Ok(base)
    if name == "_DYNAMIC":
        val d = elf_exec_find(plan, ".dynamic")
        if d < 0:
            return Err("undefined symbol: _DYNAMIC (output has no .dynamic)")
        return Ok(plan.vaddrs[d])
    if name == "_GLOBAL_OFFSET_TABLE_":
        # ld.lld (x86_64 and aarch64): the start of .got.plt, else .got
        val g = elf_got_base(plan, target)
        if g < 0:
            return Err("undefined symbol: _GLOBAL_OFFSET_TABLE_ (output has no .got.plt or .got)")
        return Ok(plan.vaddrs[g])
    var sec = ".init_array"
    if name.starts_with("__fini_array"):
        sec = ".fini_array"
    else if name.starts_with("__preinit_array"):
        sec = ".preinit_array"
    val k = elf_exec_find(plan, sec)
    if k < 0:
        return Ok(0)
    if name.ends_with("_end"):
        return Ok(plan.vaddrs[k] + plan.secs[k].size)
    Ok(plan.vaddrs[k])

fn elf_lib_export(libs: [ElfSharedLib], name: text) -> i64:
    """STT_* type of the first shared library exporting name, or -1."""
    for l in libs:
        if l.exports.has(name):
            return l.exports[name]
    -1

struct ElfVerPlan:
    """`.gnu.version` / `.gnu.version_r` contents, by import index."""
    versym: [i64]        # per import: version index (0 = unversioned)
    files: [text]        # needed files that supply at least one version
    names: [[text]]      # per file: version names, in index order
    idxs: [[i64]]        # per file: the index assigned to each of those names
    flags: [[i64]]       # per file: vna_flags (VER_FLG_WEAK when the DSO marked it weak)
    n_aux: i64           # total vernaux entries

fn elf_ver_plan(libs: [ElfSharedLib], imports: [text]) -> ElfVerPlan:
    """Assign a version index (>=2) to every (file, version) an import needs.

    An import from a library with no versions gets VER_NDX_GLOBAL (1), which
    is the gABI value and what ld.lld writes (measured: `add_val` from an
    unversioned DSO is `1 (*global*)` in an output that also needs versioned
    glibc symbols). Index 0 is VER_NDX_LOCAL and belongs to symbols that are
    not imports at all.

    Indices are assigned in first-use order and are self-consistent, not a
    copy of ld.lld's: on aarch64 ours are 2=GLIBC_2.34, 3=GLIBC_2.17 where
    ld.lld's are reversed. Nothing reads them but this file and ld.so, which
    follows DT_VERSYM into DT_VERNEED.

    Leaving the section out entirely is what is fatal: ld.so then resolves a
    versionless reference to the library's version index 2, which on
    glibc/x86_64 is the GLIBC_2.2.5 compat set, silently binding `realpath`,
    `memcpy`, `pthread_cond_*` and the rest to their OLD implementations."""
    var versym: [i64] = []
    var files: [text] = []
    var names: [[text]] = []
    var idxs: [[i64]] = []
    var flags: [[i64]] = []
    var key_idx: {text: i64} = {}
    var file_pos: {text: i64} = {}
    var next_idx: i64 = 2
    var n_aux: i64 = 0
    for n in imports:
        var file = ""
        var ver = ""
        var weak: i64 = 0
        for l in libs:
            if file == "" and l.exports.has(n):
                file = l.soname
                ver = l.versions[n]
                if ver != "" and l.version_weak.has(ver) and l.version_weak[ver]:
                    weak = VER_FLG_WEAK
        if ver == "":
            versym = versym.push(VER_NDX_GLOBAL)
        else:
            val key = "{file}\n{ver}"
            if not key_idx.has(key):
                key_idx[key] = next_idx
                next_idx = next_idx + 1
                n_aux = n_aux + 1
                if not file_pos.has(file):
                    file_pos[file] = files.len()
                    files = files.push(file)
                    names = names.push([])
                    idxs = idxs.push([])
                    flags = flags.push([])
                val fi = file_pos[file]
                names[fi] = names[fi].push(ver)
                idxs[fi] = idxs[fi].push(key_idx[key])
                flags[fi] = flags[fi].push(weak)
            versym = versym.push(key_idx[key])
    ElfVerPlan(versym: versym, files: files, names: names, idxs: idxs, flags: flags, n_aux: n_aux)

fn elf_symref(ctx: ElfLinkCtx, oi: i64, sym_idx: i64) -> Result<ElfScanRef, text>:
    """Resolve relocation symbol (oi, sym_idx) to its SYMREF_* kind (placement fields zero)."""
    if sym_idx == 0:
        return Ok(elf_ref(oi, 0, SYMREF_ABS, "", "", 0, false))
    val obj = ctx.inputs.objects[oi]
    if sym_idx >= obj.symbols.len():
        return Err("object {oi}: relocation symbol index {sym_idx} out of range")
    val sym = obj.symbols[sym_idx]
    val bind = elf_symbol_binding(sym)
    if sym.st_shndx == SHN_COMMON:
        return Err("symbol {sym.name}: SHN_COMMON is unsupported (compile with -fno-common)")
    if bind != STB_LOCAL and sym.name != "":
        val weak = bind == STB_WEAK
        if ctx.res.defined.has(sym.name):
            if ctx.res.defined[sym.name].section_idx == SHN_ABS:
                return Ok(elf_ref(oi, sym_idx, SYMREF_ABS, sym.name, sym.name, 0, weak))
            return Ok(elf_ref(oi, sym_idx, SYMREF_DEFINED, sym.name, sym.name, 0, weak))
        if elf_is_synth(sym.name):
            return Ok(elf_ref(oi, sym_idx, SYMREF_DEFINED, sym.name, sym.name, 0, weak))
        val t = elf_lib_export(ctx.libs, sym.name)
        if t >= 0:
            return Ok(elf_ref(oi, sym_idx, SYMREF_IMPORT, sym.name, sym.name, t, weak))
        if weak:
            # POLICY — an undefined weak symbol is NEVER made dynamic here.
            # It is resolved statically to 0: a GOT slot holds a constant 0
            # with no dynamic relocation, and an aarch64 branch to it targets
            # the next instruction. ld.lld instead puts it in .dynsym with an
            # R_*_GLOB_DAT, so a library loaded later can still supply it.
            # The difference is observable: `__gmon_start__` (crti.o) is in
            # ld.lld's .dynsym and absent from ours. It is SAFE for the glibc
            # startup only because crt1/crti guard the call on the slot being
            # non-zero, which a constant 0 satisfies. It is NOT safe in
            # general — any weak symbol a later-loaded object is expected to
            # define will silently stay 0. Making it dynamic needs the import
            # to be emitted without a definition and with no version, which
            # the versioning plan above already supports (versym 0).
            return Ok(elf_ref(oi, sym_idx, SYMREF_WEAK_ZERO, sym.name, sym.name, 0, weak))
        return Err("undefined symbol: {sym.name}")
    if sym.st_shndx == SHN_ABS or sym.st_shndx == SHN_UNDEF:
        return Ok(elf_ref(oi, sym_idx, SYMREF_ABS, sym.name, "{oi}#{sym_idx}", 0, false))
    if sym.st_shndx >= SHN_LORESERVE:
        return Err("symbol {sym.name}: reserved section index {sym.st_shndx} unsupported")
    Ok(elf_ref(oi, sym_idx, SYMREF_DEFINED, sym.name, "{oi}#{sym_idx}", 0, false))

# reason: positional ElfScanRef seed (placement fields are filled by the caller)
fn elf_ref(oi: i64, sym_idx: i64, kind: i64, name: text, key: text, stype: i64, weak: bool) -> ElfScanRef:
    ElfScanRef(oi: oi, sym_idx: sym_idx, out_sec: -1, out_off: 0, writable: false, rtype: 0,
        rclass: RC_NONE, kind: kind, key: key, name: name, stype: stype, weak: weak, addend: 0, relax: false)

struct ElfLayout:
    plan: ElfExecPlan
    in_to_plan: [i64]     # input-backed output index -> plan index
    base: i64

fn elf_in_vaddr(ctx: ElfLinkCtx, lay: ElfLayout, oi: i64, si: i64) -> i64:
    """Output vaddr of input section (oi, si), or -1 when it was not placed.

    For a merged section this is the start of the group's blob, not of that
    input's bytes — add an offset through elf_sec_addr, never directly."""
    if si < 0 or si >= ctx.inputs.sec_out[oi].len():
        return -1
    val k = ctx.inputs.sec_out[oi][si]
    if k < 0:
        return -1
    lay.plan.vaddrs[lay.in_to_plan[k]] + ctx.inputs.sec_off[oi][si]

# reason: positional address lookup (context, layout, input section, offset in it)
fn elf_sec_addr(ctx: ElfLinkCtx, lay: ElfLayout, oi: i64, si: i64, off: i64) -> Result<i64, text>:
    """Output vaddr of byte off of input section (oi, si), through the merge map."""
    val base = elf_in_vaddr(ctx, lay, oi, si)
    if base < 0:
        return Err("object {oi}: section {si} is not in the output")
    if ctx.merged.sec_grp[oi][si] < 0:
        return Ok(base + off)
    Ok(base + elf_merge_piece_off(ctx.merged, oi, si, off)?)

struct ElfRefDef:
    """Defining (object, section, offset) of a reference; obj < 0 = none."""
    obj: i64
    sec: i64
    off: i64

fn elf_ref_def(ctx: ElfLinkCtx, r: ElfScanRef) -> ElfRefDef:
    val none = ElfRefDef(obj: -1, sec: -1, off: 0)
    if r.kind == SYMREF_IMPORT or r.kind == SYMREF_WEAK_ZERO or r.sym_idx == 0:
        return none
    val sym = ctx.inputs.objects[r.oi].symbols[r.sym_idx]
    if elf_symbol_binding(sym) != STB_LOCAL and sym.name != "":
        if not ctx.res.defined.has(sym.name):
            return none
        val e = ctx.res.defined[sym.name]
        if e.section_idx == SHN_ABS or e.section_idx >= SHN_LORESERVE or e.section_idx < 0:
            return none
        return ElfRefDef(obj: e.obj_idx, sec: e.section_idx, off: e.offset)
    if sym.st_shndx == SHN_ABS or sym.st_shndx == SHN_UNDEF or sym.st_shndx >= SHN_LORESERVE:
        return none
    ElfRefDef(obj: r.oi, sec: sym.st_shndx, off: sym.st_value)

fn elf_ref_merged(ctx: ElfLinkCtx, r: ElfScanRef) -> bool:
    """True when r's symbol is a SECTION symbol landing in a merged section, so
    elf_ref_addr already folded the addend in (the caller must not add it twice).

    ld.lld Symbols.cpp getSymVA folds the addend into the piece lookup
    (`offset += addend` ... `va -= addend`) only under `d.isSection()`. A NAMED
    symbol is anchored at its own st_value and the addend is applied after the
    lookup — x86_64 `R_X86_64_PC32 .L.str - 4` against a 13-byte merged string
    is exactly that case, and folding -4 in would leave the section."""
    if r.sym_idx == 0 or r.oi < 0:
        return false
    if elf_symbol_type(ctx.inputs.objects[r.oi].symbols[r.sym_idx]) != STT_SECTION:
        return false
    val d = elf_ref_def(ctx, r)
    if d.obj < 0 or d.sec < 0 or d.sec >= ctx.merged.sec_grp[d.obj].len():
        return false
    ctx.merged.sec_grp[d.obj][d.sec] >= 0

fn elf_entry_addr(ctx: ElfLinkCtx, lay: ElfLayout, e: SymEntry) -> Result<i64, text>:
    if e.section_idx == SHN_ABS:
        return Ok(e.offset)
    val base = elf_in_vaddr(ctx, lay, e.obj_idx, e.section_idx)
    if base < 0:
        return Err("symbol {e.name} is defined in a non-allocatable section")
    elf_sec_addr(ctx, lay, e.obj_idx, e.section_idx, e.offset)

fn elf_ref_addr(ctx: ElfLinkCtx, lay: ElfLayout, r: ElfScanRef) -> Result<i64, text>:
    """Link-time value S of a DEFINED / ABS / WEAK_ZERO reference (imports: 0).

    For a SECTION symbol in a merged section the addend is part of the piece
    lookup (ld.lld's `MergeInputSection::getOffset`), so S already covers S + A
    and elf_ref_merged tells the caller to drop A. A named symbol in a merged
    section is anchored on its own piece and keeps its addend."""
    if r.kind == SYMREF_IMPORT or r.kind == SYMREF_WEAK_ZERO or r.sym_idx == 0:
        return Ok(0)
    if elf_ref_merged(ctx, r):
        val d = elf_ref_def(ctx, r)
        return elf_sec_addr(ctx, lay, d.obj, d.sec, d.off + r.addend)
    val sym = ctx.inputs.objects[r.oi].symbols[r.sym_idx]
    if elf_symbol_binding(sym) != STB_LOCAL and sym.name != "":
        if ctx.res.defined.has(sym.name):
            return elf_entry_addr(ctx, lay, ctx.res.defined[sym.name])
        return elf_synth_addr(lay.plan, lay.base, sym.name, ctx.target)
    if sym.st_shndx == SHN_ABS:
        return Ok(sym.st_value)
    if sym.st_shndx == SHN_UNDEF:
        return Ok(0)
    val base = elf_in_vaddr(ctx, lay, r.oi, sym.st_shndx)
    if base < 0:
        return Err("local symbol '{sym.name}' refers to a non-allocatable section {sym.st_shndx}")
    # a LOCAL named symbol can still sit in a merged section (clang's .L.str):
    # anchor it on its own piece, the caller adds the addend (see elf_ref_merged)
    elf_sec_addr(ctx, lay, r.oi, sym.st_shndx, sym.st_value)

# ============================================================================
# Checks
# ============================================================================

fn elf_static_undefined(objects: [ElfObject], res: SymResolution, libs: [ElfSharedLib]) -> [text]:
    """Strong (STB_GLOBAL) undefined references with no definition anywhere."""
    var out: [text] = []
    var seen: {text: bool} = {}
    for obj in objects:
        for sym in obj.symbols:
            if sym.name != "" and sym.st_shndx == SHN_UNDEF and elf_symbol_binding(sym) == STB_GLOBAL:
                if not res.defined.has(sym.name) and not elf_is_synth(sym.name) and elf_lib_export(libs, sym.name) < 0 and not seen.has(sym.name):
                    seen[sym.name] = true
                    out = out.push(sym.name)
    out

fn elf_local_ifunc(objects: [ElfObject]) -> [text]:
    """Names of STT_GNU_IFUNC symbols DEFINED in this link.

    A defined IFUNC is not a function address: ld.lld gives it a PLT entry
    whose .got.plt slot carries R_*_IRELATIVE, so ld.so calls the resolver at
    startup and stores what it returns. This linker emits no IRELATIVE, so
    taking the symbol's address would yield the resolver instead — the call
    would return the resolver's own value (measured rc=192, not 42). An
    IMPORTED IFUNC is fine: it is a plain JUMP_SLOT, and the library's own
    ld.so resolves it."""
    var out: [text] = []
    var seen: {text: bool} = {}
    for obj in objects:
        for sym in obj.symbols:
            if sym.name != "" and sym.st_shndx != SHN_UNDEF and elf_symbol_type(sym) == 10 and not seen.has(sym.name):
                seen[sym.name] = true
                out = out.push(sym.name)
    out

fn elf_static_join(items: [text]) -> text:
    var s = ""
    var i: i64 = 0
    while i < items.len():
        if i > 0:
            s = s + "; "
        s = s + items[i]
        i = i + 1
    s

# ============================================================================
# Relocation refs
# ============================================================================

fn elf_collect_refs(ctx: ElfLinkCtx, contents: [[i64]]) -> Result<[ElfScanRef], text>:
    """Resolve every relocation that lands in an allocatable section."""
    val inputs = ctx.inputs
    var refs: [ElfScanRef] = []
    var oi: i64 = 0
    while oi < inputs.objects.len():
        val obj = inputs.objects[oi]
        for r in obj.relocations:
            val tsec = r.target_section_idx
            if tsec < 0 or tsec >= inputs.sec_out[oi].len():
                return Err("object {oi}: relocation targets section index {tsec} out of range (malformed sh_info)")
            val k = inputs.sec_out[oi][tsec]
            if k < 0:
                # relocation against a non-allocatable section (e.g. debug info): not emitted
                continue
            val o = inputs.outs[k]
            val rtype = elf_reloc_type(r)
            if o.sh_type == SHT_NOBITS_E:
                return Err("object {oi}: relocation type {rtype} targets a NOBITS section")
            if ctx.merged.sec_grp[oi][tsec] >= 0:
                # elf_merge_demote keeps every relocation target unmerged, so this
                # is an internal invariant, not an input the linker rejects
                return Err("internal: object {oi} relocation type {rtype} targets merged section {tsec}")
            val seed = elf_symref(ctx, oi, elf_reloc_sym(r))?
            val place = inputs.sec_off[oi][tsec] + r.r_offset
            val rclass = elf_reloc_class(ctx.target, rtype)
            # only a symbol DEFINED in this link may relax: undefined-weak and SHN_ABS keep
            # their constant GOT slot (a relaxed lea would yield load base in a PIE)
            val relax = rclass == RC_GOT_RELAX and seed.kind == SYMREF_DEFINED and r.r_offset >= 2 and elf_x86_can_relax(contents[k], place)
            refs = refs.push(ElfScanRef(oi: oi, sym_idx: seed.sym_idx, out_sec: k, out_off: place,
                writable: o.sh_flags & SHF_WRITE != 0, rtype: rtype, rclass: rclass, kind: seed.kind,
                key: seed.key, name: seed.name, stype: seed.stype, weak: seed.weak,
                addend: r.r_addend, relax: relax))
        oi = oi + 1
    Ok(refs)

# ============================================================================
# Synthetic section list
# ============================================================================

fn elf_has_def(ctx: ElfLinkCtx, name: text) -> bool:
    ctx.res.defined.has(name)

struct ElfDynAddrs:
    """Addresses the .dynamic tag list refers to (all 0 while only sizing)."""
    dynsym: i64
    dynstr: i64
    hash: i64
    gnu_hash: i64
    rela_dyn: i64
    rela_plt: i64
    gotplt: i64
    versym: i64
    verneed: i64
    verneednum: i64
    init: i64
    fini: i64
    init_array: i64
    fini_array: i64
    preinit_array: i64

# reason: positional .dynamic inputs (context, scan, sizes, addresses)
fn elf_dynamic_tags(ctx: ElfLinkCtx, sc: ElfScan, dynstr: ElfDynStr, n_rela: [i64], a: ElfDynAddrs, arrays: [i64]) -> [[i64]]:
    """n_rela = [.rela.dyn entries, of which RELATIVE];
    arrays = [init_array size, fini_array size, preinit_array size] (-1 = absent)."""
    val n_rela_dyn = n_rela[0]
    var t: [[i64]] = []
    val dynamic = elf_mode_dynamic(ctx.mode)
    if dynamic:
        for l in ctx.libs:
            t = t.push([DT_NEEDED, dynstr.offsets[l.soname]])
        t = t.push([DT_DEBUG, 0])
        if elf_has_def(ctx, "_init"):
            t = t.push([DT_INIT, a.init])
        if elf_has_def(ctx, "_fini"):
            t = t.push([DT_FINI, a.fini])
    if arrays[2] >= 0:
        t = t.push([DT_PREINIT_ARRAY, a.preinit_array])
        t = t.push([DT_PREINIT_ARRAYSZ, arrays[2]])
    if arrays[0] >= 0:
        t = t.push([DT_INIT_ARRAY, a.init_array])
        t = t.push([DT_INIT_ARRAYSZ, arrays[0]])
    if arrays[1] >= 0:
        t = t.push([DT_FINI_ARRAY, a.fini_array])
        t = t.push([DT_FINI_ARRAYSZ, arrays[1]])
    if dynamic:
        t = t.push([DT_GNU_HASH, a.gnu_hash])
        t = t.push([DT_HASH, a.hash])
        t = t.push([DT_STRTAB, a.dynstr])
        t = t.push([DT_SYMTAB, a.dynsym])
        t = t.push([DT_STRSZ, dynstr.data.len()])
        t = t.push([DT_SYMENT, 24])
        if a.verneednum > 0:
            t = t.push([DT_VERSYM, a.versym])
            t = t.push([DT_VERNEED, a.verneed])
            t = t.push([DT_VERNEEDNUM, a.verneednum])
    if n_rela_dyn > 0:
        t = t.push([DT_RELA, a.rela_dyn])
        t = t.push([DT_RELASZ, n_rela_dyn * 24])
        t = t.push([DT_RELAENT, 24])
        if n_rela[1] > 0:
            t = t.push([DT_RELACOUNT, n_rela[1]])
    if sc.plt_names.len() > 0:
        t = t.push([DT_JMPREL, a.rela_plt])
        t = t.push([DT_PLTRELSZ, sc.plt_names.len() * 24])
        t = t.push([DT_PLTGOT, a.gotplt])
        t = t.push([DT_PLTREL, DT_RELA])
    if elf_mode_pie(ctx.mode):
        t = t.push([DT_FLAGS_1, DF_1_PIE])
    t

fn elf_plan_addr(plan: ElfExecPlan, name: text) -> i64:
    val k = elf_exec_find(plan, name)
    if k < 0:
        return 0
    plan.vaddrs[k]

fn elf_array_size(ins: [ElfOutSec], name: text) -> i64:
    val k = elf_find_out(ins, name)
    if k < 0:
        return -1
    ins[k].size

fn elf_sec_with(s: ElfOutSec, entsize: i64, link: text, info: i64) -> ElfOutSec:
    ElfOutSec(name: s.name, sh_type: s.sh_type, sh_flags: s.sh_flags, align: s.align, size: s.size,
        entsize: entsize, link: link, info: info, seg: s.seg)

# ============================================================================
# .symtab / .strtab
# ============================================================================

struct ElfSymtabOut:
    symtab: [i64]
    strtab: [i64]
    first_global: i64

struct ElfSymRows:
    """Parallel Elf64_Sym columns, in output order."""
    names: [text]
    info: [i64]
    other: [i64]
    shndx: [i64]
    value: [i64]
    size: [i64]

# reason: positional Elf64_Sym columns
fn elf_sym_row(rows: ElfSymRows, name: text, info: i64, other: i64, shndx: i64, value: i64, size: i64) -> ElfSymRows:
    ElfSymRows(names: rows.names.push(name), info: rows.info.push(info), other: rows.other.push(other),
        shndx: rows.shndx.push(shndx), value: rows.value.push(value), size: rows.size.push(size))

fn elf_out_shndx(ctx: ElfLinkCtx, lay: ElfLayout, oi: i64, si: i64) -> i64:
    """Output section header index holding input section (oi, si), or -1."""
    if si < 0 or si >= ctx.inputs.sec_out[oi].len():
        return -1
    val k = ctx.inputs.sec_out[oi][si]
    if k < 0:
        return -1
    lay.in_to_plan[k] + 1

fn elf_sym_hidden(sym: ElfSymbol) -> bool:
    val v = sym.st_other & 3
    v == 1 or v == 2   # STV_INTERNAL / STV_HIDDEN: ld.lld demotes these to STB_LOCAL

fn elf_is_definer(ctx: ElfLinkCtx, oi: i64, sym: ElfSymbol) -> bool:
    sym.st_shndx != SHN_UNDEF and ctx.res.defined.has(sym.name) and ctx.res.defined[sym.name].obj_idx == oi

fn elf_synth_shndx(plan: ElfExecPlan, name: text, target: RelocArch) -> i64:
    """Header index of the section a linker-defined symbol points into, or -1."""
    if name == "__ehdr_start" or name == "__executable_start":
        return 1
    var sec = ".init_array"
    if name == "_GLOBAL_OFFSET_TABLE_":
        val g = elf_got_base(plan, target)
        if g < 0:
            return -1
        return g + 1
    if name == "_DYNAMIC":
        sec = ".dynamic"
    else if name.starts_with("__fini_array"):
        sec = ".fini_array"
    else if name.starts_with("__preinit_array"):
        sec = ".preinit_array"
    val k = elf_exec_find(plan, sec)
    if k < 0:
        return -1
    k + 1

fn elf_build_symtab(ctx: ElfLinkCtx, lay: ElfLayout) -> Result<ElfSymtabOut, text>:
    """ld.lld's .symtab shape: null, then per input file its locals (STT_SECTION
    dropped; symbols in non-allocated sections dropped — they have no output
    section here) followed by the hidden globals it defines (demoted to LOCAL),
    then referenced linker-defined symbols (LOCAL, hidden), then every other
    global in first-reference order (imports and unresolved weak refs as UND)."""
    val objs = ctx.inputs.objects
    var rows = ElfSymRows(names: [""], info: [0], other: [0], shndx: [0], value: [0], size: [0])
    var order: [text] = []
    var seen: {text: bool} = {}
    var all_weak: {text: bool} = {}
    var ref_type: {text: i64} = {}
    var demoted: {text: bool} = {}
    var oi: i64 = 0
    while oi < objs.len():
        val obj = objs[oi]
        var si: i64 = 1
        while si < obj.symbols.len():
            val sym = obj.symbols[si]
            val bind = elf_symbol_binding(sym)
            val typ = elf_symbol_type(sym)
            if bind == STB_LOCAL:
                if typ != STT_SECTION and sym.name != "":
                    if sym.st_shndx == SHN_ABS:
                        rows = elf_sym_row(rows, sym.name, typ, sym.st_other, SHN_ABS, sym.st_value, sym.st_size)
                    else if sym.st_shndx != SHN_UNDEF and sym.st_shndx < SHN_LORESERVE:
                        val sh = elf_out_shndx(ctx, lay, oi, sym.st_shndx)
                        if sh > 0:
                            rows = elf_sym_row(rows, sym.name, typ, sym.st_other, sh,
                                elf_sec_addr(ctx, lay, oi, sym.st_shndx, sym.st_value)?, sym.st_size)
            else if sym.name != "":
                if not seen.has(sym.name):
                    seen[sym.name] = true
                    order = order.push(sym.name)
                    all_weak[sym.name] = true
                    ref_type[sym.name] = typ
                if bind != STB_WEAK:
                    all_weak[sym.name] = false
                if elf_sym_hidden(sym) and elf_is_definer(ctx, oi, sym):
                    val sh = elf_out_shndx(ctx, lay, oi, sym.st_shndx)
                    if sh > 0 or sym.st_shndx == SHN_ABS:
                        demoted[sym.name] = true
                        val v = elf_entry_addr(ctx, lay, ctx.res.defined[sym.name])?
                        var shn = sh
                        if sym.st_shndx == SHN_ABS:
                            shn = SHN_ABS
                        rows = elf_sym_row(rows, sym.name, typ, sym.st_other, shn, v, sym.st_size)
            si = si + 1
        oi = oi + 1
    for n in order:
        if elf_is_synth(n) and not ctx.res.defined.has(n):
            val sh = elf_synth_shndx(lay.plan, n, ctx.target)
            if sh > 0:
                rows = elf_sym_row(rows, n, 0, 2, sh, elf_synth_addr(lay.plan, lay.base, n, ctx.target)?, 0)
                demoted[n] = true
    # ld.lld defines _DYNAMIC (hidden) whenever there is a .dynamic, referenced or not
    val dyn = elf_exec_find(lay.plan, ".dynamic")
    if dyn >= 0 and not demoted.has("_DYNAMIC") and not ctx.res.defined.has("_DYNAMIC"):
        rows = elf_sym_row(rows, "_DYNAMIC", 0, 2, dyn + 1, lay.plan.vaddrs[dyn], 0)
    val first_global = rows.names.len()
    for n in order:
        if demoted.has(n) or elf_is_synth(n):
            continue
        if ctx.res.defined.has(n):
            val e = ctx.res.defined[n]
            var def_sym = objs[e.obj_idx].symbols[0]
            for s in objs[e.obj_idx].symbols:
                if s.name == n and s.st_shndx != SHN_UNDEF and elf_symbol_binding(s) != STB_LOCAL:
                    def_sym = s
            var sh = SHN_ABS
            if e.section_idx != SHN_ABS:
                sh = elf_out_shndx(ctx, lay, e.obj_idx, e.section_idx)
            if sh > 0:
                val info = (elf_symbol_binding(def_sym) << 4) | elf_symbol_type(def_sym)
                rows = elf_sym_row(rows, n, info, def_sym.st_other, sh, elf_entry_addr(ctx, lay, e)?, def_sym.st_size)
        else:
            var bind = STB_GLOBAL
            if all_weak[n]:
                bind = STB_WEAK
            var typ = elf_lib_export(ctx.libs, n)
            if typ == 10:
                typ = 2  # STT_GNU_IFUNC is referenced as a plain STT_FUNC
            if typ < 0:
                typ = ref_type[n]
            rows = elf_sym_row(rows, n, (bind << 4) | typ, 0, SHN_UNDEF, 0, 0)
    val strtab = elf_build_dynstr(rows.names)
    var b: [i64] = []
    var i: i64 = 0
    while i < rows.names.len():
        var name_off: i64 = 0
        if rows.names[i] != "":
            name_off = strtab.offsets[rows.names[i]]
        # elf_sym_entry on an EMPTY buffer returns just this 24-byte entry; it is
        # appended inline, because handing it the growing table copies that table
        # on every symbol (quadratic in symbol count under the interpreter).
        for x in elf_sym_entry([], name_off, rows.info[i], rows.other[i], rows.shndx[i], rows.value[i], rows.size[i]):
            b = b.push(x)
        i = i + 1
    Ok(ElfSymtabOut(symtab: b, strtab: strtab.data, first_global: first_global))

fn elf_rd_le(b: [i64], o: i64, n: i64) -> i64:
    var v: i64 = 0
    var i = n - 1
    while i >= 0:
        v = (v << 8) | (b[o + i] & 0xff)
        i = i - 1
    v

fn elf_put_le(b: [i64], o: i64, n: i64, v: i64) -> [i64]:
    var out = b
    var i: i64 = 0
    while i < n:
        out[o + i] = (v >> (i * 8)) & 0xff
        i = i + 1
    out

fn elf_append_symtab(image: [i64], st: ElfSymtabOut) -> Result<[i64], text>:
    """Append non-allocated .symtab + .strtab to a written image.

    Interim until elf_exec_writer has a non-allocated section kind (lane B1
    owns the writer): elf_exec_plan loads every section it is given, so the
    tables are added after serialization instead. Every existing section
    header is kept byte-for-byte (their sh_name offsets stay valid: the new
    .shstrtab is the old one plus two names); the old .shstrtab bytes, which
    are the last file data, are replaced by .symtab, .strtab, .shstrtab and
    the header table grows by two entries (e_shstrndx is unchanged)."""
    val shoff = elf_rd_le(image, 0x28, 8)
    val shnum = elf_rd_le(image, 0x3c, 2)
    val shstrndx = elf_rd_le(image, 0x3e, 2)
    val ssh = shoff + shstrndx * 64
    val old_off = elf_rd_le(image, ssh + 24, 8)
    val old_size = elf_rd_le(image, ssh + 32, 8)
    var i: i64 = 1
    while i < shnum:
        val h = shoff + i * 64
        if i != shstrndx and elf_rd_le(image, h + 4, 4) != SHT_NOBITS_E and elf_rd_le(image, h + 24, 8) + elf_rd_le(image, h + 32, 8) > old_off:
            return Err("internal: section header {i} has file data after .shstrtab; cannot append .symtab")
        i = i + 1
    var b: [i64] = []
    i = 0
    while i < old_off:
        b = b.push(image[i])
        i = i + 1
    val sym_off = align_up(b.len(), 8)
    # Appends stay inline: write_zeros / write_bytes / write_u*_le take the
    # whole image and return it, which copies it on every call.
    while b.len() < sym_off:
        b = b.push(0)
    for x in st.symtab:
        b = b.push(x & 0xff)
    val str_off = b.len()
    for x in st.strtab:
        b = b.push(x & 0xff)
    val shstr_off = b.len()
    i = 0
    while i < old_size:
        b = b.push(image[old_off + i])
        i = i + 1
    for ch in ".symtab".bytes():
        b = b.push(ch as i64)
    b = b.push(0)
    for ch in ".strtab".bytes():
        b = b.push(ch as i64)
    b = b.push(0)
    val new_shoff = align_up(b.len(), 8)
    while b.len() < new_shoff:
        b = b.push(0)
    i = 0
    while i < shnum * 64:
        b = b.push(image[shoff + i])
        i = i + 1
    val nssh = new_shoff + shstrndx * 64
    b = elf_put_le(b, nssh + 24, 8, shstr_off)
    b = elf_put_le(b, nssh + 32, 8, old_size + 16)
    # The two new 64-byte section headers are built on their own small buffer
    # and appended inline, for the same reason as the image body above.
    # .symtab: sh_link = .strtab (index shnum + 1), sh_info = first global
    var sh: [i64] = []
    sh = write_u32_le(sh, old_size)
    sh = write_u32_le(sh, SHT_SYMTAB_L)
    sh = write_u64_le(sh, 0)
    sh = write_u64_le(sh, 0)
    sh = write_u64_le(sh, sym_off)
    sh = write_u64_le(sh, st.symtab.len())
    sh = write_u32_le(sh, shnum + 1)
    sh = write_u32_le(sh, st.first_global)
    sh = write_u64_le(sh, 8)
    sh = write_u64_le(sh, 24)
    # .strtab
    sh = write_u32_le(sh, old_size + 8)
    sh = write_u32_le(sh, SHT_STRTAB_E)
    sh = write_u64_le(sh, 0)
    sh = write_u64_le(sh, 0)
    sh = write_u64_le(sh, str_off)
    sh = write_u64_le(sh, st.strtab.len())
    sh = write_u32_le(sh, 0)
    sh = write_u32_le(sh, 0)
    sh = write_u64_le(sh, 1)
    sh = write_u64_le(sh, 0)
    for x in sh:
        b = b.push(x)
    b = elf_put_le(b, 0x28, 8, new_shoff)
    Ok(elf_put_le(b, 0x3c, 2, shnum + 2))

# ============================================================================
# Entry points
# ============================================================================

fn elf_static_link(objects: [[u8]], archives: [[i64]], entry: text, target: RelocArch) -> Result<[i64], text>:
    """Link ET_REL objects (+ archives) into a static ET_EXEC; Err on any link error."""
    elf_link(ElfLinkRequest(objects: objects, archives: archives, shared: [], entry: entry,
        target: target, mode: ELF_LINK_STATIC_EXEC, interp: ""))

fn elf_link(req: ElfLinkRequest) -> Result<[i64], text>:
    """Link per req.mode; Err on any link error (never a partial image)."""
    val target = req.target
    val machine = elf_static_machine(target)?
    val mode = req.mode
    val dynamic = elf_mode_dynamic(mode)
    val pie = elf_mode_pie(mode)
    if not dynamic and req.shared.len() > 0:
        return Err("shared objects given to a static link")
    if dynamic and req.interp == "":
        return Err("dynamic link needs an interpreter path (PT_INTERP)")

    var roots: [ElfObject] = []
    var i: i64 = 0
    while i < req.objects.len():
        val parsed = elf_parse_object(req.objects[i])
        if parsed.is_err():
            return Err("object {i}: {parsed.unwrap_err()}")
        val obj = parsed.unwrap()
        if obj.header.e_type != ET_REL:
            return Err("object {i}: not a relocatable object (e_type {obj.header.e_type})")
        if obj.header.e_machine != machine:
            return Err("object {i}: e_machine {obj.header.e_machine} does not match target {machine}")
        roots = roots.push(obj)
        i = i + 1

    var libs: [ElfSharedLib] = []
    i = 0
    while i < req.shared.len():
        val lib = elf_parse_shared(req.shared[i])
        if lib.is_err():
            return Err("shared object {i}: {lib.unwrap_err()}")
        val l = lib.unwrap()
        if l.machine != machine:
            return Err("shared object {l.soname}: e_machine {l.machine} does not match target {machine}")
        libs = libs.push(l)
        i = i + 1

    val closure = elf_archive_closure(roots, req.archives)?
    var all = roots
    for m in closure.members:
        if m.obj.header.e_machine != machine:
            return Err("archive member {m.name}: e_machine {m.obj.header.e_machine} does not match target {machine}")
        all = all.push(m.obj)

    val res = sym_resolve_objects(all)
    if res.errors.len() > 0:
        return Err(elf_static_join(res.errors))
    val undef = elf_static_undefined(all, res, libs)
    if undef.len() > 0:
        # A `name@VERSION` reference comes from `.symver name, name@VERSION`.
        # The symbol DOES exist under that version, so "undefined symbol" is a
        # true refusal with a false reason: what is missing is the explicit
        # symver form, not the symbol. This linker binds every reference to its
        # library's DEFAULT version (see elf_ver_plan).
        var symver: [text] = []
        for n in undef:
            if n.contains("@"):
                symver = symver.push(n)
        if symver.len() > 0:
            return Err("UnsupportedFeature: explicit symbol versions (.symver name, name@VERSION) are unsupported; this linker binds references to each library's default version: " + elf_static_join(symver))
        return Err("undefined symbol: " + elf_static_join(undef))
    if not res.defined.has(req.entry):
        return Err("entry symbol not defined: {req.entry}")
    val ifuncs = elf_local_ifunc(all)
    if ifuncs.len() > 0:
        return Err("UnsupportedFeature: locally defined STT_GNU_IFUNC needs an R_*_IRELATIVE relocation, which this linker does not emit: " + elf_static_join(ifuncs))

    elf_property_policy(all)?
    var live = elf_gc_all_live(all)
    if req.gc_sections:
        live = elf_gc_live(all, res, req.entry)?
    var merged = elf_merge_empty(all)
    if req.string_merge:
        merged = elf_merge_build(all, live, elf_out_names(all)?)?
    val inputs = elf_static_place(all, live, merged)?
    val ctx = ElfLinkCtx(inputs: inputs, merged: merged, res: res, libs: libs, target: target, mode: mode)
    var contents = elf_static_contents(inputs, merged)
    val refs = elf_collect_refs(ctx, contents)?
    val sc = elf_reloc_scan(refs, target, mode)?

    # --- synthetic section sizes (content comes after layout) ---
    val a64 = elf_target_is_a64(target)
    val nplt = sc.plt_names.len()
    var n_got_rel: i64 = 0      # GOT slots needing RELATIVE (PIE, defined)
    var n_got_glob: i64 = 0     # GOT slots needing GLOB_DAT (imports)
    for j in sc.got_ref:
        if refs[j].kind == SYMREF_IMPORT:
            n_got_glob = n_got_glob + 1
        else if pie and refs[j].kind == SYMREF_DEFINED:
            n_got_rel = n_got_rel + 1
    val n_rela_dyn = sc.relative.len() + n_got_rel + n_got_glob + sc.sym_abs.len()
    val n_rela = [n_rela_dyn, sc.relative.len() + n_got_rel]
    val ver = elf_ver_plan(libs, sc.imports)
    var strnames: [text] = []
    for l in libs:
        strnames = strnames.push(l.soname)
    for n in sc.imports:
        strnames = strnames.push(n)
    for vn in ver.names:
        for v in vn:
            strnames = strnames.push(v)
    val dynstr0 = elf_build_dynstr(strnames)
    val arrays = [elf_array_size(inputs.outs, ".init_array"), elf_array_size(inputs.outs, ".fini_array"),
        elf_array_size(inputs.outs, ".preinit_array")]
    val zero = ElfDynAddrs(dynsym: 0, dynstr: 0, hash: 0, gnu_hash: 0, rela_dyn: 0, rela_plt: 0, gotplt: 0,
        versym: 0, verneed: 0, verneednum: ver.files.len(), init: 0, fini: 0, init_array: 0, fini_array: 0,
        preinit_array: 0)
    val ntags = elf_dynamic_tags(ctx, sc, dynstr0, n_rela, zero, arrays).len() + 1

    var secs: [ElfOutSec] = []
    for o in inputs.outs:
        secs = secs.push(o)
    if dynamic:
        secs = secs.push(elf_out_sec(".interp", SHT_PROGBITS_E, SHF_ALLOC, 1, req.interp.len() + 1, ELF_SEG_R))
        secs = secs.push(elf_sec_with(elf_out_sec(".dynsym", SHT_DYNSYM_S, SHF_ALLOC, 8, (sc.imports.len() + 1) * 24, ELF_SEG_R), 24, ".dynstr", 1))
        if ver.files.len() > 0:
            secs = secs.push(elf_sec_with(elf_out_sec(".gnu.version", SHT_GNU_VERSYM_S, SHF_ALLOC, 2, elf_versym_size(sc.imports.len()), ELF_SEG_R), 2, ".dynsym", 0))
            secs = secs.push(elf_sec_with(elf_out_sec(".gnu.version_r", SHT_GNU_VERNEED_S, SHF_ALLOC, 4, elf_verneed_size(ver.files.len(), ver.n_aux), ELF_SEG_R), 0, ".dynstr", ver.files.len()))
        secs = secs.push(elf_sec_with(elf_out_sec(".gnu.hash", SHT_GNU_HASH_S, SHF_ALLOC, 8, elf_gnu_hash_size(0), ELF_SEG_R), 0, ".dynsym", 0))
        secs = secs.push(elf_sec_with(elf_out_sec(".hash", SHT_HASH_S, SHF_ALLOC, 4, elf_hash_size(sc.imports.len() + 1), ELF_SEG_R), 4, ".dynsym", 0))
        secs = secs.push(elf_out_sec(".dynstr", SHT_STRTAB_E, SHF_ALLOC, 1, dynstr0.data.len(), ELF_SEG_R))
    if n_rela_dyn > 0:
        var link = ""
        if dynamic:
            link = ".dynsym"
        secs = secs.push(elf_sec_with(elf_out_sec(".rela.dyn", SHT_RELA_S, SHF_ALLOC, 8, n_rela_dyn * 24, ELF_SEG_R), 24, link, 0))
    if nplt > 0:
        secs = secs.push(elf_sec_with(elf_out_sec(".rela.plt", SHT_RELA_S, SHF_ALLOC | SHF_INFO_LINK_S, 8, nplt * 24, ELF_SEG_R), 24, ".dynsym", 0))
        secs = secs.push(elf_out_sec(".plt", SHT_PROGBITS_E, SHF_ALLOC | SHF_EXECINSTR, 16, elf_plt_size(target, nplt), ELF_SEG_RX))
        secs = secs.push(elf_out_sec(".got.plt", SHT_PROGBITS_E, SHF_ALLOC | SHF_WRITE, 8, elf_gotplt_size(nplt), ELF_SEG_RW))
    if sc.got_keys.len() > 0:
        secs = secs.push(elf_out_sec(".got", SHT_PROGBITS_E, SHF_ALLOC | SHF_WRITE, 8, sc.got_keys.len() * 8, ELF_SEG_RW))
    if pie or dynamic:
        var dlink = ""
        if dynamic:
            dlink = ".dynstr"
        secs = secs.push(elf_sec_with(elf_out_sec(".dynamic", SHT_DYNAMIC_S, SHF_ALLOC | SHF_WRITE, 8, ntags * 16, ELF_SEG_RW), 16, dlink, 0))
    secs = elf_add_relro_padding(elf_sort_outs(secs))
    # .rela.plt's sh_info names .got.plt (section header index = position + 1)
    var si: i64 = 0
    while si < secs.len():
        if secs[si].name == ".rela.plt":
            secs[si] = elf_sec_with(secs[si], 24, ".dynsym", elf_find_out(secs, ".got.plt") + 1)
        si = si + 1

    # --- layout ---
    var base = ELF_STATIC_BASE
    var e_type = ET_EXEC_T
    if pie:
        base = 0
        e_type = ET_DYN_T
    val plan = elf_exec_plan(secs, base, elf_static_page(target))?
    var in_to_plan: [i64] = []
    for o in inputs.outs:
        in_to_plan = in_to_plan.push(elf_exec_find(plan, o.name))
    val lay = ElfLayout(plan: plan, in_to_plan: in_to_plan, base: base)

    val got_v = elf_plan_addr(plan, ".got")
    val plt_v = elf_plan_addr(plan, ".plt")
    val gotplt_v = elf_plan_addr(plan, ".got.plt")

    # --- relocate input sections ---
    # Section-outer, relocation-inner: each output section's buffer is taken
    # out of `contents` once and written in place. The old shape handed the
    # whole buffer to a patch helper and stored its return value per
    # relocation, which copies the section every time under the interpreter and
    # made the engine quadratic in (section bytes x relocations). The relocated
    # value and the instruction-field merge still come from the reloc_engine
    # oracle (reloc_apply / reloc_patch_word), never from a local formula.
    var ck: i64 = 0
    while ck < contents.len():
        var buf = contents[ck]
        var j: i64 = 0
        while j < refs.len():
            val r = refs[j]
            if r.rclass == RC_NONE or r.out_sec != ck:
                j = j + 1
                continue
            val p = plan.vaddrs[in_to_plan[ck]] + r.out_off
            var rtype = r.rtype
            var s = elf_ref_addr(ctx, lay, r)?
            var a = r.addend
            if elf_ref_merged(ctx, r):
                a = 0   # the addend was folded into S by the piece lookup
            if (r.rclass == RC_GOT or r.rclass == RC_GOT_RELAX) and not r.relax:
                s = got_v + sc.got_idx[r.key] * 8
                if a64:
                    a = 0
            else if r.relax:
                buf[r.out_off - 2] = 0x8d
                rtype = 2  # R_X86_64_PC32: lea foo(%rip)
            else if r.rclass == RC_BRANCH and r.kind == SYMREF_IMPORT:
                s = plt_v + elf_plt0_size(target) + sc.plt_idx[r.name] * elf_plt_entry_size(target)
            else if r.rclass == RC_BRANCH and r.kind == SYMREF_WEAK_ZERO and a64:
                # ld.lld: a branch to an undefined weak symbol targets the next instruction
                s = p + 4 - a
            val applied = reloc_apply(target, buf, r.out_off, rtype, s, a, p)
            if not applied.success:
                return Err("object {r.oi}: relocation type {r.rtype} against '{r.name}' at {p}: {applied.error}")
            val width = reloc_patch_width(target, rtype)
            if r.out_off >= 0 and r.out_off + width <= buf.len():
                var word = applied.value
                if width == 4:
                    word = reloc_patch_word(target, rtype, elf_rd_le(buf, r.out_off, 4), applied.value)
                var wi: i64 = 0
                while wi < width:
                    buf[r.out_off + wi] = (word >> (wi * 8)) & 0xff
                    wi = wi + 1
            j = j + 1
        contents[ck] = buf
        ck = ck + 1

    # --- synthetic contents ---
    # Every table below is grown by inline pushes; the entry encoders are called
    # on an EMPTY buffer so each returns only its own entry (a growing table
    # handed to an encoder is copied on every entry under the interpreter).
    var got: [i64] = []
    var rela_rel: [i64] = []
    var rela_sym: [i64] = []
    var gi: i64 = 0
    while gi < sc.got_keys.len():
        val r = refs[sc.got_ref[gi]]
        val slot = got_v + gi * 8
        if r.kind == SYMREF_IMPORT:
            for x in write_u64_le([], 0):
                got = got.push(x)
            for x in elf_rela_entry([], slot, sc.import_idx[r.name], elf_dyn_glob_dat(target), 0):
                rela_sym = rela_sym.push(x)
        else:
            val v = elf_ref_addr(ctx, lay, r)?
            for x in write_u64_le([], v):
                got = got.push(x)
            if pie and r.kind == SYMREF_DEFINED:
                for x in elf_rela_entry([], slot, 0, elf_dyn_relative(target), v):
                    rela_rel = rela_rel.push(x)
        gi = gi + 1
    for jr in sc.relative:
        val r = refs[jr]
        val v = elf_ref_addr(ctx, lay, r)?
        var ra = r.addend
        if elf_ref_merged(ctx, r):
            ra = 0
        for x in elf_rela_entry([], plan.vaddrs[in_to_plan[r.out_sec]] + r.out_off, 0, elf_dyn_relative(target), v + ra):
            rela_rel = rela_rel.push(x)
    for js in sc.sym_abs:
        val r = refs[js]
        for x in elf_rela_entry([], plan.vaddrs[in_to_plan[r.out_sec]] + r.out_off, sc.import_idx[r.name], elf_dyn_abs64(target), r.addend):
            rela_sym = rela_sym.push(x)
    var rela_dyn = rela_rel
    for x in rela_sym:
        rela_dyn = rela_dyn.push(x)
    var rela_plt: [i64] = []
    var pi: i64 = 0
    while pi < nplt:
        for x in elf_rela_entry([], gotplt_v + (GOTPLT_RESERVED + pi) * 8, sc.import_idx[sc.plt_names[pi]], elf_dyn_jump_slot(target), 0):
            rela_plt = rela_plt.push(x)
        pi = pi + 1

    var init_v: i64 = 0
    var fini_v: i64 = 0
    if elf_has_def(ctx, "_init"):
        init_v = elf_entry_addr(ctx, lay, res.defined["_init"])?
    if elf_has_def(ctx, "_fini"):
        fini_v = elf_entry_addr(ctx, lay, res.defined["_fini"])?
    val addrs = ElfDynAddrs(dynsym: elf_plan_addr(plan, ".dynsym"), dynstr: elf_plan_addr(plan, ".dynstr"), hash: elf_plan_addr(plan, ".hash"), gnu_hash: elf_plan_addr(plan, ".gnu.hash"),
        rela_dyn: elf_plan_addr(plan, ".rela.dyn"), rela_plt: elf_plan_addr(plan, ".rela.plt"), gotplt: gotplt_v,
        versym: elf_plan_addr(plan, ".gnu.version"), verneed: elf_plan_addr(plan, ".gnu.version_r"),
        verneednum: ver.files.len(),
        init: init_v, fini: fini_v, init_array: elf_plan_addr(plan, ".init_array"), fini_array: elf_plan_addr(plan, ".fini_array"),
        preinit_array: elf_plan_addr(plan, ".preinit_array"))

    var out: [[i64]] = []
    var pk: i64 = 0
    while pk < plan.secs.len():
        val n = plan.secs[pk].name
        val ik = elf_find_out(inputs.outs, n)
        if ik >= 0:
            out = out.push(contents[ik])
        else if n == ".interp":
            out = out.push(elf_build_interp(req.interp))
        else if n == ".dynsym":
            out = out.push(elf_build_dynsym(sc.imports, sc.import_weak, sc.import_type, dynstr0))
        else if n == ".gnu.hash":
            # every .dynsym entry is an import (UND), so nothing is hashed: symoffset = .dynsym count
            out = out.push(elf_build_gnu_hash([], sc.imports.len() + 1))
        else if n == ".hash":
            out = out.push(elf_build_hash(sc.imports))
        else if n == ".gnu.version":
            out = out.push(elf_build_versym(ver.versym))
        else if n == ".gnu.version_r":
            out = out.push(elf_build_verneed(ver.files, ver.names, ver.idxs, ver.flags, dynstr0))
        else if n == ".dynstr":
            out = out.push(dynstr0.data)
        else if n == ".rela.dyn":
            out = out.push(rela_dyn)
        else if n == ".rela.plt":
            out = out.push(rela_plt)
        else if n == ".plt":
            if a64:
                out = out.push(elf_build_plt_a64(plt_v, gotplt_v, nplt))
            else:
                out = out.push(elf_build_plt_x64(plt_v, gotplt_v, nplt))
        else if n == ".got.plt":
            if a64:
                out = out.push(elf_build_gotplt(nplt, plt_v))
            else:
                out = out.push(elf_build_gotplt_x64(nplt, plt_v, elf_plan_addr(plan, ".dynamic")))
        else if n == ".got":
            out = out.push(got)
        else if n == ELF_RELRO_PADDING:
            out = out.push([])
        else if n == ".dynamic":
            out = out.push(elf_build_dynamic(elf_dynamic_tags(ctx, sc, dynstr0, n_rela, addrs, arrays)))
        else:
            return Err("internal: no content for output section {n}")
        pk = pk + 1

    val entry_addr = elf_entry_addr(ctx, lay, res.defined[req.entry])?
    val image = elf_write_image(e_type, machine, entry_addr, plan, out)
    elf_append_symtab(image, elf_build_symtab(ctx, lay)?)

# ============================================================================
# Exports
# ============================================================================

export ElfStaticInputs, ElfLinkRequest
export elf_static_link, elf_link
export ElfVerPlan, elf_ver_plan, elf_local_ifunc, elf_property_policy, elf_object_property_and
export ELF_STATIC_BASE
export ELF_LINK_STATIC_EXEC, ELF_LINK_STATIC_PIE, ELF_LINK_DYNAMIC_EXEC, ELF_LINK_DYNAMIC_PIE
