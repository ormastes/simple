# Phase trace for the internal ELF linker (SIMPLE_ELF_LINK_TRACE=1, default off).
#
# Prints one line per phase to stdout: wall-clock milliseconds, a label and
# the peak RSS so far (KiB).
# Used to measure where a large link spends its time; it never changes output.
use std.io_runtime.{env_get, time_now_unix_micros}
use std.nogc_sync_mut.sffi.process.{process_hwm_kib}

fn elf_link_trace_enabled() -> bool:
    (env_get("SIMPLE_ELF_LINK_TRACE") ?? "") == "1"

fn elf_link_trace(label: text):
    if not elf_link_trace_enabled(): return
    print "[elf-link] {time_now_unix_micros() / 1000} ms {label} hwm_kib={process_hwm_kib()}"

export elf_link_trace, elf_link_trace_enabled
