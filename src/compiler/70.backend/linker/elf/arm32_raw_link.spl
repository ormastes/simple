# ARM32 relocatable-object linker for remote and bare-metal raw images.
#
# This capsule deliberately emits a flat byte image rather than an ELF
# executable.  It lays out SHF_ALLOC sections in input order, resolves the
# ELF symbol table, and delegates ARM relocation encoding to reloc_engine.

use compiler.backend.linker.elf_parser.{
    ElfObject, ElfSymbol, elf_parse_object, elf_symbol_binding,
    elf_reloc_sym, elf_reloc_type, elf_section_addralign,
    SHN_UNDEF, STB_LOCAL, STB_WEAK, SHT_NOBITS
}
use compiler.backend.linker.elf_inspect.{ET_REL, EM_ARM, SHT_PROGBITS}
use compiler.backend.linker.reloc_engine.{
    RelocArch, reloc_apply, reloc_patch_bytes, R_ARM_NONE
}

val ARM32_RAW_SHF_ALLOC: i64 = 2
val ARM32_RAW_SHN_ABS: i64 = 0xfff1
val ARM32_RAW_SHN_COMMON: i64 = 0xfff2

struct Arm32RawImage:
    bytes: [i64]
    base_addr: i64
    entry_addr: i64

struct Arm32RawLayout:
    offsets: [[i64]]
    size: i64

fn arm32_raw_align(value: i64, alignment: i64) -> i64:
    if alignment <= 1:
        return value
    ((value + alignment - 1) / alignment) * alignment

fn arm32_raw_layout(objects: [ElfObject]) -> Result<Arm32RawLayout, text>:
    var offsets: [[i64]] = []
    var cursor: i64 = 0
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var object_offsets: [i64] = []
        var si: i64 = 0
        while si < obj.sections.len():
            val section = obj.sections[si]
            if section.sh_flags & ARM32_RAW_SHF_ALLOC == 0:
                object_offsets = object_offsets.push(-1)
            else:
                if section.sh_type != SHT_PROGBITS and section.sh_type != SHT_NOBITS:
                    return Err("ARM32 raw link: object {oi} section {si} has unsupported allocatable type {section.sh_type}")
                var alignment = elf_section_addralign(obj, si)
                if alignment < 1:
                    alignment = 1
                cursor = arm32_raw_align(cursor, alignment)
                object_offsets = object_offsets.push(cursor)
                cursor = cursor + section.sh_size
            si = si + 1
        offsets = offsets.push(object_offsets)
        oi = oi + 1
    Ok(Arm32RawLayout(offsets: offsets, size: cursor))

fn arm32_raw_symbol_addr(sym: ElfSymbol, oi: i64, layout: Arm32RawLayout,
        base_addr: i64) -> Result<i64, text>:
    if sym.st_shndx == ARM32_RAW_SHN_ABS:
        return Ok(sym.st_value)
    if sym.st_shndx == ARM32_RAW_SHN_COMMON:
        return Err("ARM32 raw link: common symbol '{sym.name}' is unsupported")
    if sym.st_shndx == SHN_UNDEF:
        return Err("ARM32 raw link: symbol '{sym.name}' is undefined")
    if sym.st_shndx < 0 or sym.st_shndx >= layout.offsets[oi].len():
        return Err("ARM32 raw link: symbol '{sym.name}' has invalid section {sym.st_shndx}")
    val section_offset = layout.offsets[oi][sym.st_shndx]
    if section_offset < 0:
        return Err("ARM32 raw link: symbol '{sym.name}' names a non-allocatable section")
    Ok(base_addr + section_offset + sym.st_value)

fn arm32_raw_globals(objects: [ElfObject], layout: Arm32RawLayout,
        base_addr: i64) -> Result<({text: i64}, {text: bool}), text>:
    var addresses: {text: i64} = {}
    var weak: {text: bool} = {}
    var oi: i64 = 0
    while oi < objects.len():
        for sym in objects[oi].symbols:
            val binding = elf_symbol_binding(sym)
            if sym.name == "" or binding == STB_LOCAL or sym.st_shndx == SHN_UNDEF:
                continue
            val address = arm32_raw_symbol_addr(sym, oi, layout, base_addr)?
            val is_weak = binding == STB_WEAK
            if addresses.has(sym.name):
                if not weak[sym.name] and not is_weak:
                    return Err("ARM32 raw link: duplicate strong symbol '{sym.name}'")
                if weak[sym.name] and not is_weak:
                    addresses[sym.name] = address
                    weak[sym.name] = false
            else:
                addresses[sym.name] = address
                weak[sym.name] = is_weak
        oi = oi + 1
    Ok((addresses, weak))

fn arm32_raw_reloc_symbol(obj: ElfObject, oi: i64, symbol_index: i64,
        layout: Arm32RawLayout, base_addr: i64, globals: {text: i64}) -> Result<i64, text>:
    if symbol_index < 0 or symbol_index >= obj.symbols.len():
        return Err("ARM32 raw link: relocation has invalid symbol index {symbol_index}")
    val sym = obj.symbols[symbol_index]
    if elf_symbol_binding(sym) == STB_LOCAL:
        return arm32_raw_symbol_addr(sym, oi, layout, base_addr)
    if sym.st_shndx != SHN_UNDEF:
        if globals.has(sym.name):
            return Ok(globals[sym.name])
        return arm32_raw_symbol_addr(sym, oi, layout, base_addr)
    if globals.has(sym.name):
        return Ok(globals[sym.name])
    if elf_symbol_binding(sym) == STB_WEAK:
        return Ok(0)
    Err("ARM32 raw link: undefined symbol '{sym.name}'")

fn elf_arm32_link_parsed(objects: [ElfObject], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    if base_addr < 0 or base_addr & 3 != 0:
        return Err("ARM32 raw link: base address must be non-negative and 4-byte aligned")
    if entry == "":
        return Err("ARM32 raw link: entry symbol is required")
    if objects.len() == 0:
        return Err("ARM32 raw link: at least one object is required")

    for obj in objects:
        if obj.header.e_type != ET_REL or obj.header.e_machine != EM_ARM:
            return Err("ARM32 raw link: input must be an ELF32 EM_ARM relocatable object")
        if obj.raw.len() < 5 or obj.raw[4] != 1:
            return Err("ARM32 raw link: input must use ELFCLASS32")

    val layout = arm32_raw_layout(objects)?
    val (globals, global_weak) = arm32_raw_globals(objects, layout, base_addr)?
    # Keep the binding table part of the resolution receipt even though only
    # addresses are needed after duplicate selection.
    val resolved_global_count = global_weak.keys().len()
    if resolved_global_count != globals.keys().len():
        return Err("ARM32 raw link: inconsistent global symbol resolution")
    if not globals.has(entry):
        return Err("ARM32 raw link: entry symbol '{entry}' is undefined")

    var image: [i64] = []
    var zi: i64 = 0
    while zi < layout.size:
        image = image.push(0)
        zi = zi + 1

    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var si: i64 = 0
        while si < obj.sections.len():
            val section_offset = layout.offsets[oi][si]
            val section = obj.sections[si]
            if section_offset >= 0 and section.sh_type != SHT_NOBITS:
                if section.sh_addr < 0 or section.sh_addr + section.sh_size > obj.raw.len():
                    return Err("ARM32 raw link: object {oi} section {si} data is out of bounds")
                var bi: i64 = 0
                while bi < section.sh_size:
                    image[section_offset + bi] = obj.raw[section.sh_addr + bi] as i64
                    bi = bi + 1
            si = si + 1

        for reloc in obj.relocations:
            val target = reloc.target_section_idx
            if target < 0 or target >= obj.sections.len() or layout.offsets[oi][target] < 0:
                return Err("ARM32 raw link: relocation targets an invalid or non-allocatable section")
            val section = obj.sections[target]
            if reloc.r_offset < 0 or reloc.r_offset + 4 > section.sh_size:
                return Err("ARM32 raw link: relocation offset {reloc.r_offset} is out of bounds")
            val patch_offset = layout.offsets[oi][target] + reloc.r_offset
            val place = base_addr + patch_offset
            val rtype = elf_reloc_type(reloc)
            if rtype == R_ARM_NONE:
                continue
            val symbol = arm32_raw_reloc_symbol(obj, oi, elf_reloc_sym(reloc),
                layout, base_addr, globals)?
            val applied = reloc_apply(RelocArch.Arm32, image, patch_offset,
                rtype, symbol, reloc.r_addend, place)
            if not applied.success:
                return Err("ARM32 raw link: relocation type {rtype} at {place}: {applied.error}")
            image = reloc_patch_bytes(RelocArch.Arm32, image, patch_offset,
                rtype, symbol, reloc.r_addend, place)
        oi = oi + 1

    Ok(Arm32RawImage(bytes: image, base_addr: base_addr, entry_addr: globals[entry]))

fn elf_arm32_link_raw(objects: [[i64]], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    var parsed: [ElfObject] = []
    var oi: i64 = 0
    while oi < objects.len():
        val obj = elf_parse_object(objects[oi])?
        parsed = parsed.push(obj)
        oi = oi + 1
    elf_arm32_link_parsed(parsed, base_addr, entry)
