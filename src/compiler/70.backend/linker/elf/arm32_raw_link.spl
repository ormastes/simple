# ARM32 relocatable-object linker for remote and bare-metal raw images.
#
# This capsule deliberately emits a flat byte image rather than an ELF
# executable.  It lays out SHF_ALLOC sections in input order, resolves the
# ELF symbol table, and delegates ARM relocation encoding to reloc_engine.

use compiler.backend.linker.elf_parser.{
    ElfObject, ElfSymbol, elf_parse_object, elf_symbol_binding,
    elf_reloc_sym, elf_reloc_type, elf_section_addralign, elf_section_name,
    SHN_UNDEF, STB_LOCAL, STB_WEAK, SHT_NOBITS
}
use compiler.backend.linker.elf_inspect.{ET_REL, EM_ARM, EM_386, EM_RISCV, SHT_PROGBITS}
use compiler.backend.linker.riscv_reloc.{riscv_is_pcrel_hi, riscv_is_pcrel_lo, riscv_hi_key,
    riscv_pcrel_lo_value, riscv_pcrel_lo_as_absolute}
use compiler.backend.linker.reloc_engine.{
    RelocArch, reloc_apply, reloc_patch_bytes, reloc_patch_width, R_ARM_NONE,
    R_ARM_ABS8, R_ARM_ABS16, R_ARM_THM_PC8, R_ARM_THM_JUMP11, R_ARM_THM_JUMP8,
    R_386_NONE, R_386_32, R_386_PC32, R_386_PLT32, R_386_16, R_386_PC16,
    R_386_8, R_386_PC8, R_386_GOTPC, R_386_GOTOFF
}

# i386 raw images have no GOT slots: direct absolute/PC-relative forms link,
# plus GOTPC/GOTOFF, which only need a GOT anchor (the image base).
fn i386_raw_reloc_supported(rtype: i64) -> bool:
    rtype == R_386_32 or rtype == R_386_PC32 or rtype == R_386_PLT32 or
        rtype == R_386_16 or rtype == R_386_PC16 or rtype == R_386_8 or
        rtype == R_386_PC8 or rtype == R_386_GOTPC or rtype == R_386_GOTOFF

val ARM32_RAW_SHF_ALLOC: i64 = 2
val ARM32_RAW_SHN_ABS: i64 = 0xfff1
val ARM32_RAW_SHN_COMMON: i64 = 0xfff2

fn arm32_raw_reloc_width(rtype: i64) -> i64:
    if rtype == R_ARM_ABS8: return 1
    if rtype == R_ARM_ABS16 or rtype == R_ARM_THM_PC8 or
            rtype == R_ARM_THM_JUMP11 or rtype == R_ARM_THM_JUMP8:
        return 2
    4
val ARM32_RAW_SHT_EXIDX: i64 = 0x70000001

struct Arm32RawImage:
    bytes: [i64]
    base_addr: i64
    entry_addr: i64

struct Arm32RawLayout:
    offsets: [[i64]]
    common_offsets: {text: i64}
    size: i64

fn arm32_raw_align(value: i64, alignment: i64) -> i64:
    if alignment <= 1:
        return value
    ((value + alignment - 1) / alignment) * alignment

fn arm32_raw_layout(objects: [ElfObject]) -> Result<Arm32RawLayout, text>:
    var offsets: [[i64]] = []
    for obj in objects:
        var row: [i64] = []
        for _s in obj.sections:
            row = row.push(-1)
        offsets = offsets.push(row)
    var cursor: i64 = 0
    # Pass 0 places `.text.boot` (the entry stub) first, like the lld scripts'
    # `*(.text.boot) *(.text*)`; pass 1 places everything else in input order.
    var pass_no: i64 = 0
    while pass_no < 2:
        var oi: i64 = 0
        while oi < objects.len():
            val obj = objects[oi]
            var row = offsets[oi]
            var si: i64 = 0
            while si < obj.sections.len():
                val section = obj.sections[si]
                if section.sh_flags & ARM32_RAW_SHF_ALLOC != 0:
                    if section.sh_type != SHT_PROGBITS and section.sh_type != SHT_NOBITS and
                            section.sh_type != ARM32_RAW_SHT_EXIDX:
                        return Err("ELF32 raw link: object {oi} section {si} has unsupported allocatable type {section.sh_type}")
                    val is_boot = elf_section_name(obj, si) == ".text.boot"
                    if is_boot == (pass_no == 0):
                        var alignment = elf_section_addralign(obj, si)
                        if alignment < 1:
                            alignment = 1
                        cursor = arm32_raw_align(cursor, alignment)
                        row[si] = cursor
                        cursor = cursor + section.sh_size
                si = si + 1
            offsets[oi] = row
            oi = oi + 1
        pass_no = pass_no + 1
    var strong_regular: {text: bool} = {}
    for object in objects:
        for sym in object.symbols:
            val binding = elf_symbol_binding(sym)
            if (sym.name != "" and binding != STB_LOCAL and binding != STB_WEAK and
                    sym.st_shndx != SHN_UNDEF and
                    sym.st_shndx != ARM32_RAW_SHN_COMMON):
                strong_regular[sym.name] = true
    var common_sizes: {text: i64} = {}
    var common_alignments: {text: i64} = {}
    var common_names: [text] = []
    for object in objects:
        for sym in object.symbols:
            if (sym.name == "" or elf_symbol_binding(sym) == STB_LOCAL or
                    sym.st_shndx != ARM32_RAW_SHN_COMMON or
                    strong_regular.has(sym.name)):
                continue
            var alignment = sym.st_value
            if alignment <= 0: alignment = 1
            if (alignment & (alignment - 1)) != 0:
                return Err("ELF32 raw link: common symbol '{sym.name}' has non-power-of-two alignment {alignment}")
            if alignment > 0x80000000:
                return Err("ELF32 raw link: common symbol '{sym.name}' alignment exceeds the ELF32 address space")
            if sym.st_size < 0 or sym.st_size > 0xffffffff:
                return Err("ELF32 raw link: common symbol '{sym.name}' size is outside ELF32 range")
            if not common_sizes.has(sym.name):
                common_names = common_names.push(sym.name)
                common_sizes[sym.name] = sym.st_size
                common_alignments[sym.name] = alignment
            else:
                if sym.st_size > common_sizes[sym.name]:
                    common_sizes[sym.name] = sym.st_size
                if alignment > common_alignments[sym.name]:
                    common_alignments[sym.name] = alignment
    var common_offsets: {text: i64} = {}
    for name in common_names:
        cursor = arm32_raw_align(cursor, common_alignments[name])
        if cursor > 0xffffffff - common_sizes[name]:
            return Err("ELF32 raw link: common symbol '{name}' exceeds the ELF32 image range")
        common_offsets[name] = cursor
        cursor = cursor + common_sizes[name]
    Ok(Arm32RawLayout(
        offsets: offsets, common_offsets: common_offsets, size: cursor))

fn arm32_raw_symbol_addr(sym: ElfSymbol, oi: i64, layout: Arm32RawLayout,
        base_addr: i64) -> Result<i64, text>:
    if sym.st_shndx == ARM32_RAW_SHN_ABS:
        return Ok(sym.st_value)
    if sym.st_shndx == ARM32_RAW_SHN_COMMON:
        if not layout.common_offsets.has(sym.name):
            return Err("ELF32 raw link: common symbol '{sym.name}' has no allocation")
        return Ok(base_addr + layout.common_offsets[sym.name])
    if sym.st_shndx == SHN_UNDEF:
        return Err("ELF32 raw link: symbol '{sym.name}' is undefined")
    if sym.st_shndx < 0 or sym.st_shndx >= layout.offsets[oi].len():
        return Err("ELF32 raw link: symbol '{sym.name}' has invalid section {sym.st_shndx}")
    val section_offset = layout.offsets[oi][sym.st_shndx]
    if section_offset < 0:
        return Err("ELF32 raw link: symbol '{sym.name}' names a non-allocatable section")
    Ok(base_addr + section_offset + sym.st_value)

fn arm32_raw_globals(objects: [ElfObject], layout: Arm32RawLayout,
        base_addr: i64) -> Result<({text: i64}, {text: bool}), text>:
    var addresses: {text: i64} = {}
    var weak: {text: bool} = {}
    var oi: i64 = 0
    while oi < objects.len():
        for sym in objects[oi].symbols:
            val binding = elf_symbol_binding(sym)
            if sym.name == "" or binding == STB_LOCAL or sym.st_shndx == SHN_UNDEF or
                    sym.st_shndx == ARM32_RAW_SHN_COMMON:
                continue
            val address = arm32_raw_symbol_addr(sym, oi, layout, base_addr)?
            val is_weak = binding == STB_WEAK
            if addresses.has(sym.name):
                if not weak[sym.name] and not is_weak:
                    return Err("ELF32 raw link: duplicate strong symbol '{sym.name}'")
                if weak[sym.name] and not is_weak:
                    addresses[sym.name] = address
                    weak[sym.name] = false
            else:
                addresses[sym.name] = address
                weak[sym.name] = is_weak
        oi = oi + 1
    oi = 0
    while oi < objects.len():
        for sym in objects[oi].symbols:
            val binding = elf_symbol_binding(sym)
            if (sym.name == "" or binding == STB_LOCAL or
                    sym.st_shndx != ARM32_RAW_SHN_COMMON or
                    not layout.common_offsets.has(sym.name)):
                continue
            val address = base_addr + layout.common_offsets[sym.name]
            val is_weak = binding == STB_WEAK
            if not addresses.has(sym.name) or (weak[sym.name] and not is_weak):
                addresses[sym.name] = address
                weak[sym.name] = is_weak
        oi = oi + 1
    Ok((addresses, weak))

fn arm32_raw_reloc_symbol(obj: ElfObject, oi: i64, symbol_index: i64,
        layout: Arm32RawLayout, base_addr: i64, globals: {text: i64}) -> Result<i64, text>:
    if symbol_index < 0 or symbol_index >= obj.symbols.len():
        return Err("ELF32 raw link: relocation has invalid symbol index {symbol_index}")
    val sym = obj.symbols[symbol_index]
    if elf_symbol_binding(sym) == STB_LOCAL:
        return arm32_raw_symbol_addr(sym, oi, layout, base_addr)
    if sym.st_shndx != SHN_UNDEF:
        if globals.has(sym.name):
            return Ok(globals[sym.name])
        return arm32_raw_symbol_addr(sym, oi, layout, base_addr)
    if globals.has(sym.name):
        return Ok(globals[sym.name])
    if elf_symbol_binding(sym) == STB_WEAK:
        return Ok(0)
    Err("ELF32 raw link: undefined symbol '{sym.name}'")

fn elf_arm32_link_parsed(objects: [ElfObject], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    elf32_raw_link_parsed(objects, base_addr, entry, RelocArch.Arm32)

fn elf_i386_link_parsed(objects: [ElfObject], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    elf32_raw_link_parsed(objects, base_addr, entry, RelocArch.I386)

fn elf_riscv32_link_parsed(objects: [ElfObject], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    elf32_raw_link_parsed(objects, base_addr, entry, RelocArch.Riscv32)

fn elf32_raw_is_386(arch: RelocArch) -> bool:
    match arch:
        case I386:
            true
        case _:
            false

fn elf32_raw_is_rv32(arch: RelocArch) -> bool:
    match arch:
        case Riscv32:
            true
        case _:
            false

fn elf32_raw_link_parsed(objects: [ElfObject], base_addr: i64,
        entry: text, arch: RelocArch) -> Result<Arm32RawImage, text>:
    val is_386 = elf32_raw_is_386(arch)
    val is_rv = elf32_raw_is_rv32(arch)
    val machine = if is_386: EM_386 else: (if is_rv: EM_RISCV else: EM_ARM)
    val machine_name = if is_386: "EM_386" else: (if is_rv: "EM_RISCV" else: "EM_ARM")
    if base_addr < 0 or base_addr & 3 != 0:
        return Err("ELF32 raw link: base address must be non-negative and 4-byte aligned")
    if entry == "":
        return Err("ELF32 raw link: entry symbol is required")
    if objects.len() == 0:
        return Err("ELF32 raw link: at least one object is required")

    for obj in objects:
        if obj.header.e_type != ET_REL or obj.header.e_machine != machine:
            return Err("ELF32 raw link: input must be an ELF32 {machine_name} relocatable object")
        if obj.raw.len() < 5 or obj.raw[4] != 1:
            return Err("ELF32 raw link: input must use ELFCLASS32")

    val layout = arm32_raw_layout(objects)?
    val (globals, global_weak) = arm32_raw_globals(objects, layout, base_addr)?
    # Keep the binding table part of the resolution receipt even though only
    # addresses are needed after duplicate selection.
    val resolved_global_count = global_weak.keys().len()
    if resolved_global_count != globals.keys().len():
        return Err("ELF32 raw link: inconsistent global symbol resolution")
    if not globals.has(entry):
        return Err("ELF32 raw link: entry symbol '{entry}' is undefined")

    # RISC-V PCREL_LO12 pairing (shared riscv_reloc module): HI20 sites record
    # S + A - P by riscv_hi_key; LO12 relocations are applied once all HI20s are known.
    var rv_hi: {text: i64} = {}
    var lo_off: [i64] = []
    var lo_place: [i64] = []
    var lo_type: [i64] = []
    var lo_key: [text] = []
    var image: [i64] = []
    var zi: i64 = 0
    while zi < layout.size:
        image = image.push(0)
        zi = zi + 1

    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var si: i64 = 0
        while si < obj.sections.len():
            val section_offset = layout.offsets[oi][si]
            val section = obj.sections[si]
            if section_offset >= 0 and section.sh_type != SHT_NOBITS:
                if section.sh_addr < 0 or section.sh_addr + section.sh_size > obj.raw.len():
                    return Err("ELF32 raw link: object {oi} section {si} data is out of bounds")
                var bi: i64 = 0
                while bi < section.sh_size:
                    image[section_offset + bi] = obj.raw[section.sh_addr + bi] as i64
                    bi = bi + 1
            si = si + 1

        for reloc in obj.relocations:
            val target = reloc.target_section_idx
            if target < 0 or target >= obj.sections.len() or layout.offsets[oi][target] < 0:
                return Err("ELF32 raw link: relocation targets an invalid or non-allocatable section")
            val section = obj.sections[target]
            if reloc.r_offset < 0 or
                    reloc.r_offset + elf32_raw_reloc_width(arch, elf_reloc_type(reloc)) > section.sh_size:
                return Err("ELF32 raw link: relocation offset {reloc.r_offset} is out of bounds")
            val patch_offset = layout.offsets[oi][target] + reloc.r_offset
            val place = base_addr + patch_offset
            val rtype = elf_reloc_type(reloc)
            if is_rv:
                # R_RISCV_NONE / RELAX are markers; ALIGN padding cannot be shrunk here.
                if rtype == 0 or rtype == 51: continue
                if rtype == 43:
                    return Err("ELF32 raw link: R_RISCV_ALIGN is unsupported in a raw image (assemble with -mno-relax)")
            elif (not is_386 and rtype == R_ARM_NONE) or (is_386 and rtype == R_386_NONE):
                continue
            if is_386 and not i386_raw_reloc_supported(rtype):
                return Err("ELF32 raw link: R_386 type {rtype} needs a GOT, which a raw image does not have")
            # GOT anchor = image base: GOTPC takes S = GOT (its symbol is
            # _GLOBAL_OFFSET_TABLE_), GOTOFF takes P = GOT (reloc_engine contract).
            val got_pc = is_386 and rtype == R_386_GOTPC
            val got_off = is_386 and rtype == R_386_GOTOFF
            val symbol = if got_pc: base_addr else: arm32_raw_reloc_symbol(obj, oi,
                elf_reloc_sym(reloc), layout, base_addr, globals)?
            val p = if got_off: base_addr else: place
            if is_rv and riscv_is_pcrel_lo(rtype):
                if reloc.r_addend != 0:
                    return Err("ELF32 raw link: RISC-V PCREL_LO12 addend must be zero")
                val lsym = obj.symbols[elf_reloc_sym(reloc)]
                if lsym.st_shndx == SHN_UNDEF or lsym.st_shndx >= 0xff00:
                    return Err("ELF32 raw link: RISC-V PCREL_LO12 label '{lsym.name}' is not a section label")
                lo_off = lo_off.push(patch_offset)
                lo_place = lo_place.push(place)
                lo_type = lo_type.push(rtype)
                lo_key = lo_key.push(riscv_hi_key(oi, lsym.st_shndx, lsym.st_value))
                continue
            if is_rv and riscv_is_pcrel_hi(rtype):
                val hk = riscv_hi_key(oi, target, reloc.r_offset)
                if rv_hi.has(hk):
                    return Err("ELF32 raw link: RISC-V duplicate HI20 relocation at {place}")
                rv_hi[hk] = riscv_pcrel_lo_value(symbol, reloc.r_addend, p)?
            val applied = reloc_apply(arch, image, patch_offset,
                rtype, symbol, reloc.r_addend, p)
            if not applied.success:
                return Err("ELF32 raw link: relocation type {rtype} at {place}: {applied.error}")
            image = reloc_patch_bytes(arch, image, patch_offset,
                rtype, symbol, reloc.r_addend, p)
        oi = oi + 1

    var li: i64 = 0
    while li < lo_off.len():
        if not rv_hi.has(lo_key[li]):
            return Err("ELF32 raw link: RISC-V PCREL_LO12 at {lo_place[li]} has no matching HI20")
        val lt = riscv_pcrel_lo_as_absolute(lo_type[li])
        val lv = rv_hi[lo_key[li]]
        val lo_applied = reloc_apply(arch, image, lo_off[li], lt, lv, 0, 0)
        if not lo_applied.success:
            return Err("ELF32 raw link: RISC-V PCREL_LO12 at {lo_place[li]}: {lo_applied.error}")
        image = reloc_patch_bytes(arch, image, lo_off[li], lt, lv, 0, 0)
        li = li + 1

    Ok(Arm32RawImage(bytes: image, base_addr: base_addr, entry_addr: globals[entry]))

fn elf_arm32_link_raw(objects: [[i64]], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    var parsed: [ElfObject] = []
    var oi: i64 = 0
    while oi < objects.len():
        val obj = elf_parse_object(objects[oi])?
        parsed = parsed.push(obj)
        oi = oi + 1
    elf_arm32_link_parsed(parsed, base_addr, entry)

fn elf32_raw_reloc_width(arch: RelocArch, rtype: i64) -> i64:
    if elf32_raw_is_386(arch): return reloc_patch_width(RelocArch.I386, rtype)
    if elf32_raw_is_rv32(arch): return reloc_patch_width(RelocArch.Riscv32, rtype)
    arm32_raw_reloc_width(rtype)

fn elf_i386_link_raw(objects: [[i64]], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    var parsed: [ElfObject] = []
    for bytes in objects:
        parsed = parsed.push(elf_parse_object(bytes)?)
    elf_i386_link_parsed(parsed, base_addr, entry)

fn elf_riscv32_link_raw(objects: [[i64]], base_addr: i64,
        entry: text) -> Result<Arm32RawImage, text>:
    var parsed: [ElfObject] = []
    for bytes in objects:
        parsed = parsed.push(elf_parse_object(bytes)?)
    elf_riscv32_link_parsed(parsed, base_addr, entry)

export Arm32RawImage
export elf_arm32_link_parsed, elf_arm32_link_raw, elf_i386_link_parsed, elf_i386_link_raw
export elf_riscv32_link_parsed, elf_riscv32_link_raw
