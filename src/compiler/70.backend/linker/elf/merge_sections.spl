# SHF_MERGE section merging — ld.lld's -O1 duplicate elimination (lane C1).
#
# Splits every mergeable input section into pieces (NUL-terminated strings for
# SHF_STRINGS, sh_entsize-sized chunks otherwise), drops duplicates, and
# records, per input section, where each piece landed in the merged blob so
# that elf_static_link can retarget relocations into it — including the usual
# `section symbol + addend` form clang emits for string literals.
#
# Grouping follows ld.lld (OutputSections.cpp `finalizeInputSections`): one
# merged blob per (output section, sh_flags, sh_entsize, and sh_addralign for
# SHF_STRINGS), placed at the position of the first input section it replaces.
#
# Kept whole (unmerged) rather than split, which is always safe and is what
# ld.lld does for anything it declines to merge: sh_size 0 and sh_entsize 0
# (InputFiles.cpp `shouldMerge`), and any section a relocation points INTO
# (elf_merge_demote). Wide literals are NOT in that list: SHF_STRINGS with
# sh_entsize 2 or 4 splits on entsize-sized NUL units and merges like ld.lld.
#
# Errors, exactly and only where ld.lld errors too:
#   - sh_size not a multiple of sh_entsize
#   - a writable SHF_MERGE section
#   - a SHF_STRINGS section whose last entsize bytes are not NUL
#
# More permissive than ld.lld in one recorded place: ld.lld runs `shouldMerge`,
# and therefore those two errors, BEFORE it decides to demote, so it errors even
# on a section it would then keep whole; we check them only on sections we
# actually split. See
# doc/08_tracking/bug/elf_relro_gc_parity_advisories_2026-09-19.md
#
# Known divergence from ld.lld, recorded rather than papered over: ld.lld
# orders the unique pieces by the top bits of an XXH3-64 hash of each piece
# (32 `StringTableBuilder` shards, SyntheticSections.cpp
# `MergeNoTailSection::finalizeContents`), so its merged blob is a permutation
# of ours — we emit first-appearance order. Sizes, membership and every
# resolved address agree; the byte order does not. See
# doc/08_tracking/bug/elf_merge_string_order_not_lld_shard_order_2026-09-19.md

use compiler.backend.linker.elf_parser.{
    ElfObject, elf_section_name, elf_section_addralign, elf_section_entsize
}

val SHF_ALLOC_M: i64 = 0x2
val SHF_WRITE_M: i64 = 0x1
val SHF_MERGE_M: i64 = 0x10
val SHF_STRINGS_M: i64 = 0x20

struct ElfMergeSet:
    """Merged blobs plus the per-input-section piece maps."""
    sec_grp: [[i64]]      # [obj][sec] -> group index, -1 = not merged
    sec_row: [[i64]]      # [obj][sec] -> row in starts/outs, -1 = not merged
    starts: [[i64]]       # row -> piece offsets inside the input section
    row_size: [i64]       # row -> size of that input section (bounds check)
    outs: [[i64]]         # row -> piece offsets inside the merged blob
    grp_name: [text]      # group -> output section name
    grp_flags: [i64]
    grp_entsize: [i64]
    grp_align: [i64]
    grp_type: [i64]
    grp_data: [[i64]]     # group -> merged bytes

fn elf_merge_empty(objects: [ElfObject]) -> ElfMergeSet:
    """A set that merges nothing (string_merge off, ld.lld -O0)."""
    var g: [[i64]] = []
    for obj in objects:
        var row: [i64] = []
        var si: i64 = 0
        while si < obj.sections.len():
            row = row.push(-1)
            si = si + 1
        g = g.push(row)
    ElfMergeSet(sec_grp: g, sec_row: g, starts: [], row_size: [], outs: [], grp_name: [], grp_flags: [],
        grp_entsize: [], grp_align: [], grp_type: [], grp_data: [])

fn elf_merge_candidate(obj: ElfObject, si: i64) -> bool:
    """ld.lld `shouldMerge`, minus the error cases (elf_merge_reject names those)."""
    val sec = obj.sections[si]
    sec.sh_flags & SHF_ALLOC_M != 0 and sec.sh_flags & SHF_MERGE_M != 0 and
        sec.sh_size > 0 and elf_section_entsize(obj, si) > 0

fn elf_merge_reject(obj: ElfObject, si: i64, oi: i64) -> text:
    """"" when section (oi, si) can be merged as modelled, else the reason.

    Only the two cases ld.lld itself errors on are errors here; everything we
    do not model is demoted to an ordinary unmerged section instead
    (elf_merge_demote), which is what ld.lld does for anything it declines to
    merge."""
    val sec = obj.sections[si]
    val name = elf_section_name(obj, si)
    val entsize = elf_section_entsize(obj, si)
    if sec.sh_size % entsize != 0:
        return "object {oi}: SHF_MERGE section {name} size {sec.sh_size} is not a multiple of sh_entsize {entsize}"
    if sec.sh_flags & SHF_WRITE_M != 0:
        return "object {oi}: writable SHF_MERGE section {name} is unsupported"
    ""

fn elf_merge_demote(reloc_target: bool) -> bool:
    """True when a mergeable section is kept whole (unmerged) rather than split.

    One case, which ld.lld links without complaint (wide literals are NOT one:
    elf_merge_split scans entsize-sized NUL units, so they merge like ld.lld):
      - a section a relocation points INTO (e.g. `.rodata.cst8` holding
        `.quad target`): ld.lld demotes such a section to a regular input
        section, since a piece's bytes are not relocatable once shared
    Keeping the section whole is always safe: it just forgoes the dedup."""
    reloc_target

fn elf_merge_bytes(obj: ElfObject, si: i64) -> [i64]:
    """Raw contents of input section si (sh_addr is the file offset here)."""
    val sec = obj.sections[si]
    var out: [i64] = []
    var i: i64 = 0
    while i < sec.sh_size:
        out = out.push(obj.raw[sec.sh_addr + i] as i64)
        i = i + 1
    out

fn elf_merge_zero_unit(data: [i64], at: i64, entsize: i64) -> bool:
    """True when the entsize bytes at `at` are all zero (ld.lld `findNull`)."""
    var j: i64 = 0
    while j < entsize:
        if data[at + j] != 0:
            return false
        j = j + 1
    true

fn elf_merge_split(data: [i64], entsize: i64, strings: bool) -> Result<[i64], text>:
    """Piece start offsets: strings end at the first all-zero entsize-sized unit
    (ld.lld `splitStrings` + `findNull`, so L"..." with sh_entsize 2 or 4 splits
    exactly like a byte string); otherwise fixed entsize chunks."""
    var starts: [i64] = []
    if not strings:
        var i: i64 = 0
        while i < data.len():
            starts = starts.push(i)
            i = i + entsize
        return Ok(starts)
    var begin: i64 = 0
    var i: i64 = 0
    while i + entsize <= data.len():
        if elf_merge_zero_unit(data, i, entsize):
            starts = starts.push(begin)
            begin = i + entsize
        i = i + entsize
    if begin != data.len():
        return Err("SHF_STRINGS section does not end with a NUL unit")
    Ok(starts)

fn elf_merge_piece_end(data: [i64], start: i64, entsize: i64, strings: bool) -> i64:
    """End offset (exclusive, terminator included) of the piece starting at start."""
    if not strings:
        return start + entsize
    var e = start
    while not elf_merge_zero_unit(data, e, entsize):
        e = e + entsize
    e + entsize

fn elf_merge_key(data: [i64], start: i64, end: i64) -> text:
    """Content key for a piece (hex, so any byte value is representable)."""
    val digits = "0123456789abcdef"
    var s = ""
    var i = start
    while i < end:
        val b = data[i] & 0xff
        s = s + digits[b >> 4] + digits[b & 0xf]
        i = i + 1
    s

fn elf_merge_align_up(v: i64, a: i64) -> i64:
    if a < 2:
        return v
    ((v + a - 1) / a) * a

# reason: positional group key (ld.lld: flags, entsize, and alignment for SHF_STRINGS)
fn elf_merge_find_group(set: ElfMergeSet, name: text, flags: i64, entsize: i64, align: i64) -> i64:
    var g: i64 = 0
    while g < set.grp_name.len():
        if set.grp_name[g] == name and set.grp_flags[g] == flags and set.grp_entsize[g] == entsize:
            if flags & SHF_STRINGS_M == 0 or set.grp_align[g] == align:
                return g
        g = g + 1
    -1

fn elf_merge_reloc_targets(objects: [ElfObject]) -> [[bool]]:
    """[obj][sec] -> true when some relocation points INTO that section."""
    var out: [[bool]] = []
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var row: [bool] = []
        var si: i64 = 0
        while si < obj.sections.len():
            row = row.push(false)
            si = si + 1
        for r in obj.relocations:
            if r.target_section_idx >= 0 and r.target_section_idx < row.len():
                row[r.target_section_idx] = true
        out = out.push(row)
        oi = oi + 1
    out

# reason: positional inputs (objects, liveness, and the output-section namer)
fn elf_merge_build(objects: [ElfObject], live: [[bool]], out_names: [[text]]) -> Result<ElfMergeSet, text>:
    """Merge every mergeable live section; out_names[oi][si] is its output section."""
    var set = elf_merge_empty(objects)
    var keys: [{text: i64}] = []
    val targets = elf_merge_reloc_targets(objects)
    var oi: i64 = 0
    while oi < objects.len():
        val obj = objects[oi]
        var si: i64 = 0
        while si < obj.sections.len():
            if live[oi][si] and elf_merge_candidate(obj, si) and not elf_merge_demote(targets[oi][si]):
                val reject = elf_merge_reject(obj, si, oi)
                if reject != "":
                    return Err(reject)
                val sec = obj.sections[si]
                val entsize = elf_section_entsize(obj, si)
                val strings = sec.sh_flags & SHF_STRINGS_M != 0
                var align = elf_section_addralign(obj, si)
                if align < 1:
                    align = 1
                val name = out_names[oi][si]
                var g = elf_merge_find_group(set, name, sec.sh_flags, entsize, align)
                if g < 0:
                    set.grp_name = set.grp_name.push(name)
                    set.grp_flags = set.grp_flags.push(sec.sh_flags)
                    set.grp_entsize = set.grp_entsize.push(entsize)
                    set.grp_align = set.grp_align.push(align)
                    set.grp_type = set.grp_type.push(sec.sh_type)
                    set.grp_data = set.grp_data.push([])
                    keys = keys.push({})
                    g = set.grp_name.len() - 1
                else if align > set.grp_align[g]:
                    set.grp_align[g] = align
                val data = elf_merge_bytes(obj, si)
                val split = elf_merge_split(data, entsize, strings)
                if split.is_err():
                    return Err("object {oi}: section {name}: {split.unwrap_err()}")
                val starts = split.unwrap()
                var outs: [i64] = []
                var blob = set.grp_data[g]
                var seen = keys[g]
                var p: i64 = 0
                while p < starts.len():
                    val end = elf_merge_piece_end(data, starts[p], entsize, strings)
                    val key = elf_merge_key(data, starts[p], end)
                    if seen.has(key):
                        outs = outs.push(seen[key])
                    else:
                        val at = elf_merge_align_up(blob.len(), align)
                        var q = blob.len()
                        while q < at:
                            blob = blob.push(0)
                            q = q + 1
                        seen[key] = at
                        outs = outs.push(at)
                        var b = starts[p]
                        while b < end:
                            blob = blob.push(data[b])
                            b = b + 1
                    p = p + 1
                set.grp_data[g] = blob
                keys[g] = seen
                set.starts = set.starts.push(starts)
                set.row_size = set.row_size.push(sec.sh_size)
                set.outs = set.outs.push(outs)
                set.sec_grp[oi][si] = g
                set.sec_row[oi][si] = set.starts.len() - 1
            si = si + 1
        oi = oi + 1
    Ok(set)

fn elf_merge_piece_off(set: ElfMergeSet, oi: i64, si: i64, off: i64) -> Result<i64, text>:
    """Offset inside the merged blob for input-section offset off (ld.lld
    `getOffset`: the piece containing off, plus the distance into it).

    The bound is `off > size`. ld.lld has TWO paths here and they differ:
    Symbols.cpp getSymVA errors on `offset > size` only under `d.isSection()`,
    i.e. for a SECTION symbol plus addend (and returns 0, not an address, at
    exactly `offset == size`); for a NAMED Defined symbol,
    SyntheticSections.cpp `splitSections` anchors any `v >= size` on the LAST
    piece with no diagnostic. We accept `off == size` like both paths, and
    error beyond it, which is stricter than ld.lld for a named symbol — see §5
    of doc/08_tracking/bug/elf_relro_gc_parity_advisories_2026-09-19.md."""
    val row = set.sec_row[oi][si]
    if row < 0:
        return Err("internal: section {si} of object {oi} was not merged")
    val starts = set.starts[row]
    if starts.len() == 0 or off < 0 or off > set.row_size[row]:
        return Err("object {oi}: offset {off} is outside merged section {si} (size {set.row_size[row]})")
    var i = starts.len() - 1
    while i > 0 and starts[i] > off:
        i = i - 1
    Ok(set.outs[row][i] + (off - starts[i]))

export ElfMergeSet
export elf_merge_empty, elf_merge_build, elf_merge_piece_off, elf_merge_candidate
export elf_merge_split, elf_merge_reject, elf_merge_key
