# Deterministic scan-based layout. Only three segment summaries are resident.
use compiler.backend.linker.elf.stream_types.{ElfStreamInputsV1, ElfStreamLayoutV1}
use compiler.backend.linker.elf.stream_inputs.{elf_stream_name_v1, elf_stream_symbol_count_v1, elf_stream_got_anchor_v1}
use compiler.backend.linker.elf.stream_got.*
use compiler.backend.linker.elf.elf_file_reader.{ElfFileSymbolV1, ElfFileSectionV1, elf_file_section_v1}

val ELF_STREAM_BASE_V1: u64 = 4194304u64

pub fn elf_stream_group_v1(section: ElfFileSectionV1) -> Result<i64, text>:
    if (section.flags & 2u64) == 0u64: return Ok(-1)
    if section.section_type != 1u64 and section.section_type != 8u64:
        return Err("stream allocated section type unsupported")
    if (section.flags & 5u64) == 5u64: return Err("stream writable executable section unsupported")
    if (section.flags & 4u64) != 0u64: return Ok(0)
    if (section.flags & 1u64) != 0u64: return Ok(2)
    Ok(1)

pub fn elf_stream_align_v1(offset: u64, alignment: u64, limit: u64) -> Result<u64, text>:
    if offset > limit: return Err("stream output budget exceeded")
    val align = if alignment == 0u64: 1u64 else: alignment
    if (align & (align - 1u64)) != 0u64: return Err("stream alignment invalid")
    val remainder = offset % align
    val padding = if remainder == 0u64: 0u64 else: align - remainder
    if padding > limit - offset: return Err("stream alignment exceeds output budget")
    Ok(offset + padding)

pub fn elf_stream_section_align_v1(offset: u64, alignment: u64, limit: u64) -> Result<u64, text>:
    # Section alignment applies to runtime addresses, including the load base.
    if limit > 1099511627776u64 or offset > limit: return Err("stream section alignment budget")
    val address = elf_stream_align_v1(ELF_STREAM_BASE_V1 + offset, alignment, ELF_STREAM_BASE_V1 + limit)?
    Ok(address - ELF_STREAM_BASE_V1)

export ELF_STREAM_BASE_V1, elf_stream_group_v1, elf_stream_align_v1
export elf_stream_section_align_v1

impl ElfStreamInputsV1:
    me elf_stream_got_base_v1(cancelled: fn() -> bool) -> Result<u64, text>:
        # Independent of GOT slot counting and payload resolution: anchor slots
        # and references to the anchor cannot recurse into layout.
        val ordinary = self.elf_stream_regular_end_v1(cancelled)?
        val common = self.elf_stream_common_layout_v1(ordinary, [], cancelled)?
        elf_stream_align_v1(common.0, 8u64, self.limits.output_bytes)

    me elf_stream_regular_end_v1(cancelled: fn() -> bool) -> Result<u64, text>:
        var cursor = 4096u64
        for group in 0..3:
            cursor = elf_stream_align_v1(cursor, 4096u64, self.limits.output_bytes)?
            for object in self.objects:
                for index in 1..object.section_count:
                    self.elf_stream_charge_v1(cancelled)?
                    val section = elf_file_section_v1(object, index)?
                    if elf_stream_group_v1(section)? != group: continue
                    cursor = elf_stream_section_align_v1(cursor, section.alignment, self.limits.output_bytes)?
                    if section.size > self.limits.output_bytes - cursor: return Err("stream section exceeds output budget")
                    cursor = cursor + section.size
        Ok(cursor)

    me elf_stream_common_layout_v1(start: u64, wanted: [u8],
            cancelled: fn() -> bool) -> Result<(u64, Option<u64>), text>:
        # Rescan rather than retain a symbol-sized allocation map. All record
        # reads spend the shared scan quota; the tradeoff is additional scans.
        if start > self.limits.output_bytes: return Err("stream common storage exceeds output budget")
        var cursor = start
        var address: Option<u64> = None
        var owner = 0
        for object in self.objects:
            for table in 0..object.section_count:
                self.elf_stream_charge_v1(cancelled)?
                val count = elf_stream_symbol_count_v1(object, table)?
                var ordinal = 0u64
                while ordinal < count:
                    val symbol = self.elf_stream_read_symbol_v1(object, table, ordinal, cancelled)?
                    if symbol.section_index == 65522:
                        val found = self.elf_stream_lookup_v1(symbol.name_bytes, cancelled)?
                        if found.is_none(): return Err("stream common definition disappeared")
                        val selected = found.unwrap()
                        if selected.symbol.section_index == 65522 and selected.owner == owner and
                                selected.table == table and selected.ordinal == ordinal:
                            cursor = elf_stream_section_align_v1(cursor, selected.symbol.value, self.limits.output_bytes)?
                            if selected.symbol.size > self.limits.output_bytes - cursor:
                                return Err("stream common storage exceeds output budget")
                            if selected.symbol.name_bytes == wanted: address = Some(cursor)
                            cursor = cursor + selected.symbol.size
                    ordinal = ordinal + 1u64
            owner = owner + 1
        Ok((cursor, address))

    me elf_stream_section_offset_v1(owner: i64, index: i64,
            cancelled: fn() -> bool) -> Result<u64, text>:
        var cursor: u64 = 4096u64
        for group in 0..3:
            cursor = elf_stream_align_v1(cursor, 4096u64, self.limits.output_bytes)?
            var candidate_owner = 0
            for object in self.objects:
                for candidate_index in 1..object.section_count:
                    self.elf_stream_charge_v1(cancelled)?
                    val section = elf_file_section_v1(object, candidate_index)?
                    if elf_stream_group_v1(section)? == group:
                        cursor = elf_stream_section_align_v1(cursor, section.alignment, self.limits.output_bytes)?
                        if section.size > self.limits.output_bytes - cursor: return Err("stream section exceeds output budget")
                        if candidate_owner == owner and candidate_index == index: return Ok(cursor)
                        cursor = cursor + section.size
                candidate_owner = candidate_owner + 1
        Err("stream symbol references nonallocated or missing section")

    me elf_stream_symbol_address_v1(owner: i64, symbol: ElfFileSymbolV1,
            cancelled: fn() -> bool) -> Result<u64, text>:
        if elf_stream_got_anchor_v1(symbol):
            if symbol.section_index != 0: return Err("stream reserved GOT anchor definition")
            val base = self.elf_stream_got_base_v1(cancelled)?
            return Ok(ELF_STREAM_BASE_V1 + base)
        var definition = symbol
        var defining_owner = owner
        if symbol.binding == 1 or symbol.binding == 2:
            val binding = self.elf_stream_lookup_v1(symbol.name_bytes, cancelled)?
            if binding.is_none():
                if symbol.binding == 2 and symbol.section_index == 0: return Ok(0u64)
                return Err("undefined symbol {elf_stream_name_v1(symbol.name_bytes)}")
            definition = binding.unwrap().symbol
            defining_owner = binding.unwrap().owner
        if definition.section_index == 65521:
            if definition.value > 0x7fffffffffffffffu64: return Err("stream absolute address exceeds relocation representation")
            return Ok(definition.value)
        if definition.section_index == 0 and definition.binding == 0 and definition.name_bytes.len() == 0:
            return Ok(0u64)
        if definition.section_index == 65522:
            val start = self.elf_stream_regular_end_v1(cancelled)?
            val common = self.elf_stream_common_layout_v1(start, definition.name_bytes, cancelled)?
            if common.1.is_none(): return Err("stream common allocation disappeared")
            return Ok(ELF_STREAM_BASE_V1 + common.1.unwrap())
        if defining_owner < 0 or defining_owner >= self.objects.len(): return Err("stream symbol owner bounds")
        val section = elf_file_section_v1(self.objects[defining_owner], definition.section_index)?
        if definition.value > section.size: return Err("stream symbol value exceeds section")
        val offset = self.elf_stream_section_offset_v1(defining_owner, definition.section_index, cancelled)?
        Ok(ELF_STREAM_BASE_V1 + offset + definition.value)

    me elf_stream_layout_v1(entry: [u8], cancelled: fn() -> bool) -> Result<ElfStreamLayoutV1, text>:
        var starts: [u64] = []
        var sizes: [u64] = []
        var cursor: u64 = 4096u64
        for group in 0..3:
            cursor = elf_stream_align_v1(cursor, 4096u64, self.limits.output_bytes)?
            val start = cursor
            starts.push(start)
            for object in self.objects:
                for index in 1..object.section_count:
                    self.elf_stream_charge_v1(cancelled)?
                    val section = elf_file_section_v1(object, index)?
                    if elf_stream_group_v1(section)? == group:
                        cursor = elf_stream_section_align_v1(cursor, section.alignment, self.limits.output_bytes)?
                        if section.size > self.limits.output_bytes - cursor: return Err("stream section exceeds output budget")
                        cursor = cursor + section.size
            if group == 2:
                val common = self.elf_stream_common_layout_v1(cursor, [], cancelled)?
                val got = self.elf_stream_got_layout_v1(common.0, None, cancelled)?
                cursor = got.end
            sizes.push(cursor - start)
        val binding = self.elf_stream_lookup_v1(entry, cancelled)?
        if binding.is_none(): return Err("stream entry disappeared")
        val selected = binding.unwrap()
        val section = elf_file_section_v1(self.objects[selected.owner], selected.symbol.section_index)?
        if elf_stream_group_v1(section)? != 0 or selected.symbol.value >= section.size:
            return Err("stream entry is not within executable section bytes")
        val address = self.elf_stream_symbol_address_v1(selected.owner, selected.symbol, cancelled)?
        Ok(ElfStreamLayoutV1(group_offsets: starts, group_sizes: sizes, file_bytes: cursor, entry_address: address))
