# Synthetic sections for the internal ELF linker — lane A7 slice 2.
#
# Byte builders for the linker-created sections (design §5, mold phase
# "synthetic sections"): .got, .plt / .got.plt (aarch64, x86_64 lazy), .dynsym, .dynstr,
# SysV .hash + .gnu.hash, .rela.dyn / .rela.plt, .dynamic and .interp. Sizes are known
# from the relocation scan before layout; contents are built after layout,
# once every address is final. Pure: every function returns [i64] bytes.
#
# Not produced (reported, not faked): x86_64 IBT/CET PLT and instruction-form
# TLS models beyond admitted relaxation/IE paths. Raw imported DTPMOD64,
# DTPREL64, and TPOFF64/TPREL64 words are emitted through .rela.dyn.

use compiler.backend.linker.reloc_engine.{
    RelocArch, reloc_patch_bytes,
    R_AARCH64_ADR_PREL_PG_HI21, R_AARCH64_LDST64_ABS_LO12_NC, R_AARCH64_ADD_ABS_LO12_NC
}
use compiler.backend.linker.elf_writer.{write_u16_le, write_u32_le, write_u64_le, write_zeros, write_bytes}

# ============================================================================
# Constants
# ============================================================================

# Dynamic relocation types (applied by ld.so, never by this linker).
val R_AARCH64_GLOB_DAT: i64 = 1025
val R_AARCH64_JUMP_SLOT: i64 = 1026
val R_AARCH64_RELATIVE: i64 = 1027
val R_X86_64_GLOB_DAT: i64 = 6
val R_X86_64_JUMP_SLOT: i64 = 7
val R_X86_64_RELATIVE: i64 = 8
val R_X86_64_TPOFF64: i64 = 18

# Dynamic tags.
val DT_NULL: i64 = 0
val DT_NEEDED: i64 = 1
val DT_PLTRELSZ: i64 = 2
val DT_PLTGOT: i64 = 3
val DT_HASH: i64 = 4
val DT_STRTAB: i64 = 5
val DT_SYMTAB: i64 = 6
val DT_RELA: i64 = 7
val DT_RELASZ: i64 = 8
val DT_RELAENT: i64 = 9
val DT_STRSZ: i64 = 10
val DT_SYMENT: i64 = 11
val DT_INIT: i64 = 12
val DT_FINI: i64 = 13
val DT_PLTREL: i64 = 20
val DT_DEBUG: i64 = 21
val DT_JMPREL: i64 = 23
val DT_BIND_NOW: i64 = 24
val DT_INIT_ARRAY: i64 = 25
val DT_FINI_ARRAY: i64 = 26
val DT_INIT_ARRAYSZ: i64 = 27
val DT_FINI_ARRAYSZ: i64 = 28
val DT_RUNPATH: i64 = 29
val DT_FLAGS: i64 = 30
val DT_PREINIT_ARRAY: i64 = 32
val DT_PREINIT_ARRAYSZ: i64 = 33
val DT_GNU_HASH: i64 = 0x6ffffef5
val DT_RELACOUNT: i64 = 0x6ffffff9
val DT_FLAGS_1: i64 = 0x6ffffffb
val DT_VERSYM: i64 = 0x6ffffff0
val DT_VERNEED: i64 = 0x6ffffffe
val DT_VERNEEDNUM: i64 = 0x6fffffff
val DF_1_PIE: i64 = 0x08000000
val DF_BIND_NOW: i64 = 0x8
val DF_1_NOW: i64 = 0x1

# Section types / flags of synthetic sections.
val SHT_RELA_S: i64 = 4
val SHT_HASH_S: i64 = 5
val SHT_DYNAMIC_S: i64 = 6
val SHT_DYNSYM_S: i64 = 11
val SHT_GNU_HASH_S: i64 = 0x6ffffff6
val SHT_GNU_VERNEED_S: i64 = 0x6ffffffe
val SHT_GNU_VERSYM_S: i64 = 0x6fffffff
val SHF_INFO_LINK_S: i64 = 0x40

val A64_PLT0_SIZE: i64 = 32
val A64_PLT_ENTRY_SIZE: i64 = 16
val X64_PLT0_SIZE: i64 = 16
val X64_PLT_ENTRY_SIZE: i64 = 16
val GOTPLT_RESERVED: i64 = 3
val ARM_PLT0_SIZE: i64 = 32
val RV_PLT0_SIZE: i64 = 32
val RV_PLT_ENTRY_SIZE: i64 = 16
val ARM_PLT_ENTRY_SIZE: i64 = 16

# ============================================================================
# Dynamic relocation type by target
# ============================================================================

fn elf_dyn_relative(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            3
        case Riscv32:
            3
        case I386:
            8
        case Arm32:
            23
        case AArch64:
            R_AARCH64_RELATIVE
        case _:
            R_X86_64_RELATIVE

fn elf_dyn_glob_dat(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            2
        case Riscv32:
            1
        case I386:
            6
        case Arm32:
            21
        case AArch64:
            R_AARCH64_GLOB_DAT
        case _:
            R_X86_64_GLOB_DAT

fn elf_dyn_jump_slot(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            5
        case Riscv32:
            5
        case I386:
            7
        case Arm32:
            22
        case AArch64:
            R_AARCH64_JUMP_SLOT
        case _:
            R_X86_64_JUMP_SLOT

fn elf_dyn_abs64(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            2
        case Riscv32:
            1
        case I386:
            1
        case Arm32:
            2
        case AArch64:
            257
        case _:
            1

fn elf_dyn_copy(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            4
        case Riscv32:
            4
        case I386:
            5
        case Arm32:
            20
        case AArch64:
            1024
        case _:
            5

fn elf_dyn_tpoff64(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            11
        case Riscv32:
            10
        case AArch64:
            1030  # R_AARCH64_TLS_TPREL64
        case X86_64:
            R_X86_64_TPOFF64
        case I386:
            14    # R_386_TLS_TPOFF
        case Arm32:
            19    # R_ARM_TLS_TPOFF32
        case _:
            0

fn elf_build_gnu_build_id(digest: [i64]) -> [i64]:
    """GNU ABI build-id note: namesz=4, descsz=20, NT_GNU_BUILD_ID=3."""
    var out: [i64] = []
    out = write_u32_le(out, 4)
    out = write_u32_le(out, 20)
    out = write_u32_le(out, 3)
    out = write_bytes(out, [0x47, 0x4e, 0x55, 0])
    var i: i64 = 0
    while i < 20:
        var value: i64 = 0
        if i < digest.len():
            value = digest[i]
        out = out.push(value)
        i = i + 1
    out

# ============================================================================
# Builders
# ============================================================================

fn elf_rela_entry(r_offset: i64, sym: i64, rtype: i64, addend: i64) -> [i64]:
    """One Elf64_Rela (24 bytes). Workaround:
    doc/08_tracking/bug/native_array_copy_leaks_2026-10-20.md. Callers `extend` their table with it: an
    accumulator passed through a helper is copied per call (and never freed
    in native builds), which made large tables quadratic."""
    var b = write_u64_le([], r_offset)
    b = write_u64_le(b, (sym << 32) | rtype)
    write_u64_le(b, addend)

fn elf_rel_entry32(r_offset: i64, sym: i64, rtype: i64) -> [i64]:
    """One Elf32_Rel (8 bytes): the addend is implicit in the relocated word."""
    write_u32_le(write_u32_le([], r_offset), (sym << 8) | rtype)

fn elf_dyn_rel_entry(w32: bool, r_offset: i64, sym: i64, rtype: i64, addend: i64) -> [i64]:
    """ELF32 targets (i386, armv7) use REL, so the caller must have written
    the addend into the relocated word; ELF64 targets use RELA."""
    if w32: elf_rel_entry32(r_offset, sym, rtype) else: elf_rela_entry(r_offset, sym, rtype, addend)

fn elf_sysv_hash(name: text) -> i64:
    var h: i64 = 0
    for ch in name.bytes():
        h = ((h << 4) + (ch as i64)) & 0xffffffff
        val g = h & 0xf0000000
        if g != 0:
            h = h ^ (g >> 24)
        h = h & 0x0fffffff
    h

struct ElfDynStr:
    data: [i64]
    offsets: {text: i64}

fn elf_dynsym_name(name: text) -> text:
    val at = name.find("@")
    if at > 0:
        return name.substring(0, at)
    name

fn elf_dynsym_version(name: text) -> text:
    val at = name.find("@")
    if at > 0 and at + 1 < name.len():
        return name.substring(at + 1)
    ""

fn elf_build_dynstr(names: [text]) -> ElfDynStr:
    """NUL-led string table; each distinct name stored once."""
    var data: [i64] = [0]
    var offsets: {text: i64} = {}
    for n in names:
        if not offsets.has(n):
            offsets[n] = data.len()
            for ch in n.bytes():
                data = data.push(ch as i64)
            data = data.push(0)
    ElfDynStr(data: data, offsets: offsets)

fn elf_dynstr_size(names: [text]) -> i64:
    elf_build_dynstr(names).data.len()

# reason: positional dynsym inputs (imports, binding flags, types, string table)
fn elf_build_dynsym(imports: [text], weak: [bool], types: [i64], dynstr: ElfDynStr,
        shndx: [i64], values: [i64], sizes: [i64]) -> [i64]:
    elf_build_dynsym_class(imports, weak, types, dynstr, shndx, values, sizes, false)

# reason: positional dynsym inputs plus the ELF class
fn elf_build_dynsym_class(imports: [text], weak: [bool], types: [i64], dynstr: ElfDynStr,
        shndx: [i64], values: [i64], sizes: [i64], w32: bool) -> [i64]:
    """Null symbol + imported UND entries or executable-defined COPY entries.
    Elf32_Sym orders name, value, size, info, other, shndx (16 bytes)."""
    var b = write_zeros([], if w32: 16 else: 24)
    var i: i64 = 0
    while i < imports.len():
        var sym_bind: i64 = 1
        if weak[i]:
            sym_bind = 2
        var typ = types[i]
        if typ == 10:
            typ = 2  # STT_GNU_IFUNC is imported as a plain STT_FUNC
        b = write_u32_le(b, dynstr.offsets[elf_dynsym_name(imports[i])])
        if w32:
            b = write_u32_le(b, values[i])
            b = write_u32_le(b, sizes[i])
        b = b.push((sym_bind << 4) | typ)
        b = b.push(0)
        b = b.push(shndx[i] & 0xff)
        b = b.push((shndx[i] >> 8) & 0xff)
        if not w32:
            b = write_u64_le(b, values[i])
            b = write_u64_le(b, sizes[i])
        i = i + 1
    b

# reason: positional Elf64_Sym fields in on-disk order
fn elf_sym_entry(name_off: i64, info: i64, other: i64, shndx: i64, value: i64, size: i64) -> [i64]:
    """One Elf64_Sym (24 bytes) for .symtab; callers `extend` with it."""
    var b = write_u32_le([], name_off)
    b = b.push(info)
    b = b.push(other)
    b = b.push(shndx & 0xff)
    b = b.push((shndx >> 8) & 0xff)
    b = write_u64_le(b, value)
    write_u64_le(b, size)

fn elf_hash_size(nsyms: i64) -> i64:
    (2 + nsyms + nsyms) * 4

fn elf_build_hash(imports: [text]) -> [i64]:
    """SysV .hash over [null] + imports: nbucket = nchain = symbol count."""
    val n = imports.len() + 1
    var bucket: [i64] = []
    var chain: [i64] = []
    var i: i64 = 0
    while i < n:
        bucket = bucket.push(0)
        chain = chain.push(0)
        i = i + 1
    i = 1
    while i < n:
        val h = elf_sysv_hash(elf_dynsym_name(imports[i - 1])) % n
        chain[i] = bucket[h]
        bucket[h] = i
        i = i + 1
    var b = write_u32_le([], n)
    b = write_u32_le(b, n)
    for x in bucket:
        b = write_u32_le(b, x)
    for x in chain:
        b = write_u32_le(b, x)
    b

fn elf_build_versym(import_versions: [i64]) -> [i64]:
    """One version index per dynamic symbol: local null, global/unversioned 1,
    or the matching .gnu.version_r auxiliary index (2+)."""
    var b = write_u16_le([], 0)
    for version in import_versions:
        b = write_u16_le(b, version)
    b

fn elf_build_verneed(libraries: [text], versions: [text], dynstr: ElfDynStr) -> [i64]:
    """One single-auxiliary Elf64_Verneed record per distinct library/version
    requirement. Repeating a library is valid and keeps construction bounded."""
    var b: [i64] = []
    var i: i64 = 0
    while i < versions.len():
        b = write_u16_le(b, 1)
        b = write_u16_le(b, 1)
        b = write_u32_le(b, dynstr.offsets[libraries[i]])
        b = write_u32_le(b, 16)
        if i + 1 < versions.len():
            b = write_u32_le(b, 32)
        else:
            b = write_u32_le(b, 0)
        b = write_u32_le(b, elf_sysv_hash(versions[i]))
        b = write_u16_le(b, 0)
        b = write_u16_le(b, i + 2)
        b = write_u32_le(b, dynstr.offsets[versions[i]])
        b = write_u32_le(b, 0)
        i = i + 1
    b

fn elf_gnu_hash(name: text) -> i64:
    """GNU (DJB) hash: h = h * 33 + c, truncated to u32."""
    var h: i64 = 5381
    for ch in elf_dynsym_name(name).bytes():
        h = (h * 33 + (ch as i64)) & 0xffffffff
    h

fn elf_gnu_hash_nbuckets(n: i64) -> i64:
    # ld.lld: max(symbols / 4, 1)
    if n / 4 > 1:
        return n / 4
    1

fn elf_gnu_hash_maskwords(n: i64) -> i64:
    elf_gnu_hash_maskwords_w(n, 64)

fn elf_gnu_hash_maskwords_w(n: i64, bits: i64) -> i64:
    """ld.lld: NextPowerOf2(n * 12 bits / word bits) — the next power of two strictly above."""
    val x = (n * 12) / bits
    var p: i64 = 1
    while p <= x:
        p = p * 2
    p

fn elf_gnu_hash_size(n: i64) -> i64:
    elf_gnu_hash_size_class(n, false)

fn elf_gnu_hash_size_class(n: i64, w32: bool) -> i64:
    val wb: i64 = if w32: 4 else: 8
    16 + elf_gnu_hash_maskwords_w(n, wb * 8) * wb + elf_gnu_hash_nbuckets(n) * 4 + n * 4

fn elf_gnu_hash_sort(names: [text]) -> [text]:
    """Stable order by bucket: .gnu.hash requires each bucket's symbols to be
    contiguous at the tail of .dynsym, in bucket order."""
    val nb = elf_gnu_hash_nbuckets(names.len())
    var out: [text] = []
    var b: i64 = 0
    while b < nb:
        for n in names:
            if elf_gnu_hash(n) % nb == b:
                out = out.push(n)
        b = b + 1
    out

fn elf_build_gnu_hash(names: [text], symoffset: i64) -> [i64]:
    elf_build_gnu_hash_class(names, symoffset, false)

fn elf_build_gnu_hash_class(names: [text], symoffset: i64, w32: bool) -> [i64]:
    """.gnu.hash over the hashed .dynsym tail names (already elf_gnu_hash_sort-ed),
    which starts at .dynsym index symoffset. Layout ld.lld writes: header
    [nbuckets, symoffset, maskwords, shift2=26], 64-bit bloom words, buckets
    (first .dynsym index per bucket, 0 = empty), chain values (hash & ~1, bit 0
    set on a bucket's last symbol). ELF32 bloom words are 32 bits."""
    val n = names.len()
    val wbits: i64 = if w32: 32 else: 64
    val nb = elf_gnu_hash_nbuckets(n)
    val mw = elf_gnu_hash_maskwords_w(n, wbits)
    var bloom: [i64] = []
    var i: i64 = 0
    while i < mw:
        bloom = bloom.push(0)
        i = i + 1
    var buckets: [i64] = []
    i = 0
    while i < nb:
        buckets = buckets.push(0)
        i = i + 1
    var hashes: [i64] = []
    for s in names:
        hashes = hashes.push(elf_gnu_hash(s))
    var chain: [i64] = []
    i = 0
    while i < n:
        val h = hashes[i]
        val w = (h / wbits) % mw
        bloom[w] = bloom[w] | (1 << (h % wbits)) | (1 << ((h >> 26) % wbits))
        val bk = h % nb
        if buckets[bk] == 0:
            buckets[bk] = symoffset + i
        var v = h & 0xfffffffe
        if i + 1 == n or hashes[i + 1] % nb != bk:
            v = v | 1
        chain = chain.push(v)
        i = i + 1
    var b = write_u32_le([], nb)
    b = write_u32_le(b, symoffset)
    b = write_u32_le(b, mw)
    b = write_u32_le(b, 26)
    for x in bloom:
        if w32:
            b = write_u32_le(b, x)
        else:
            b = write_u64_le(b, x)
    for x in buckets:
        b = write_u32_le(b, x)
    for x in chain:
        b = write_u32_le(b, x)
    b

fn elf_gotplt_size(n: i64) -> i64:
    if n == 0:
        return 0
    (GOTPLT_RESERVED + n) * 8

fn elf_a64_adrp_ldr_add(buf: [i64], at: i64, pc: i64, slot: i64) -> [i64]:
    """adrp x16, slot ; ldr x17, [x16, :lo12:slot] ; add x16, x16, :lo12:slot ; br x17"""
    var b = write_u32_le(buf, 0x90000010)
    b = write_u32_le(b, 0xf9400211)
    b = write_u32_le(b, 0x91000210)
    b = write_u32_le(b, 0xd61f0220)
    b = reloc_patch_bytes(RelocArch.AArch64, b, at, R_AARCH64_ADR_PREL_PG_HI21, slot, 0, pc)
    b = reloc_patch_bytes(RelocArch.AArch64, b, at + 4, R_AARCH64_LDST64_ABS_LO12_NC, slot, 0, pc + 4)
    reloc_patch_bytes(RelocArch.AArch64, b, at + 8, R_AARCH64_ADD_ABS_LO12_NC, slot, 0, pc + 8)

fn elf_build_plt_a64(plt_addr: i64, gotplt_addr: i64, n: i64) -> [i64]:
    """ld.lld's aarch64 PLT: PLT0 (stp x16,x30 + lazy-resolver jump through
    .got.plt[2], 3 nops) followed by one 16-byte stub per .got.plt slot."""
    if n == 0:
        return []
    var b = write_u32_le([], 0xa9bf7bf0)
    b = elf_a64_adrp_ldr_add(b, 4, plt_addr + 4, gotplt_addr + 16)
    b = write_u32_le(b, 0xd503201f)
    b = write_u32_le(b, 0xd503201f)
    b = write_u32_le(b, 0xd503201f)
    var i: i64 = 0
    while i < n:
        val at = A64_PLT0_SIZE + i * A64_PLT_ENTRY_SIZE
        b = elf_a64_adrp_ldr_add(b, at, plt_addr + at, gotplt_addr + (GOTPLT_RESERVED + i) * 8)
        i = i + 1
    b

fn elf_build_gotplt(n: i64, plt0_addr: i64) -> [i64]:
    """3 reserved zero words (ld.so fills [1]/[2]) + one word per PLT entry,
    initialised to PLT0 for lazy binding (ld.lld's aarch64 layout)."""
    if n == 0:
        return []
    var b = write_zeros([], GOTPLT_RESERVED * 8)
    var i: i64 = 0
    while i < n:
        b = write_u64_le(b, plt0_addr)
        i = i + 1
    b

fn elf_gotplt_size_class(n: i64, ws: i64) -> i64:
    if n == 0:
        return 0
    (GOTPLT_RESERVED + n) * ws

fn elf_build_plt_i386(plt_addr: i64, gotplt_addr: i64, n: i64, pic: bool) -> [i64]:
    """ld.lld's i386 lazy PLT. ET_EXEC: PLT0 = pushl GOTPLT+4; jmp *GOTPLT+8;
    PLTn = jmp *slot. PIE (%ebx = .got.plt): pushl 4(%ebx); jmp *8(%ebx);
    PLTn = jmp *slot-GOTPLT(%ebx). PLTn continues pushl $<.rel.plt byte
    offset>; jmp PLT0. 16 bytes each, slot n = .got.plt[3 + n]."""
    if n == 0:
        return []
    var b: [i64] = [0xff, 0x35]
    if pic: b = [0xff, 0xb3]
    b = write_u32_le(b, if pic: 4 else: gotplt_addr + 4)
    b = b.push(0xff)
    b = b.push(if pic: 0xa3 else: 0x25)
    b = write_u32_le(b, if pic: 8 else: gotplt_addr + 8)
    b = write_u32_le(b, 0x90909090)
    var i: i64 = 0
    while i < n:
        val e = plt_addr + X64_PLT0_SIZE + i * X64_PLT_ENTRY_SIZE
        val slot = (GOTPLT_RESERVED + i) * 4
        b = b.push(0xff)
        b = b.push(if pic: 0xa3 else: 0x25)
        b = write_u32_le(b, if pic: slot else: gotplt_addr + slot)
        b = b.push(0x68)
        b = write_u32_le(b, i * 8)
        b = b.push(0xe9)
        b = write_u32_le(b, (plt_addr - (e + 16)) & 0xffffffff)
        i = i + 1
    b

fn elf_build_gotplt_i386(n: i64, plt_addr: i64, dynamic_addr: i64) -> [i64]:
    """i386 .got.plt: [0] = _DYNAMIC, [1]/[2] for ld.so, then one word per PLT
    entry initialised to that entry's `pushl` (PLTn + 6) for lazy binding."""
    if n == 0:
        return []
    var b = write_u32_le([], dynamic_addr)
    b = write_zeros(b, 8)
    var i: i64 = 0
    while i < n:
        b = write_u32_le(b, plt_addr + X64_PLT0_SIZE + i * X64_PLT_ENTRY_SIZE + 6)
        i = i + 1
    b

fn elf_arm_plt_fits(plt_addr: i64, gotplt_addr: i64, n: i64) -> bool:
    """ld.lld's short ARM PLT reaches .got.plt with 27-bit (PLT0) / 28-bit
    (PLTn) positive offsets; the long form is not implemented."""
    if gotplt_addr - plt_addr - 4 < 0 or gotplt_addr - plt_addr - 4 >= (1 << 27):
        return false
    val last = gotplt_addr + (GOTPLT_RESERVED + n) * 4 - (plt_addr + ARM_PLT0_SIZE) - 8
    last >= 0 and last < (1 << 28)

fn elf_build_plt_arm(plt_addr: i64, gotplt_addr: i64, n: i64) -> [i64]:
    """ld.lld's ARM lazy PLT (short form). PLT0: str lr,[sp,#-4]!; add lr,pc,#hi;
    add lr,lr,#mid; ldr pc,[lr,#lo]! (lr = &.got.plt[2]) + 4 trap words.
    PLTn: add ip,pc,#hi; add ip,ip,#mid; ldr pc,[ip,#lo]! + 1 trap word."""
    if n == 0:
        return []
    val h = gotplt_addr - plt_addr - 4
    var b = write_u32_le([], 0xe52de004)
    b = write_u32_le(b, 0xe28fe600 | ((h >> 20) & 0xff))
    b = write_u32_le(b, 0xe28eea00 | ((h >> 12) & 0xff))
    b = write_u32_le(b, 0xe5bef000 | (h & 0xfff))
    var t: i64 = 0
    while t < 4:
        b = write_u32_le(b, 0xd4d4d4d4)
        t = t + 1
    var i: i64 = 0
    while i < n:
        val e = plt_addr + ARM_PLT0_SIZE + i * ARM_PLT_ENTRY_SIZE
        val off = gotplt_addr + (GOTPLT_RESERVED + i) * 4 - e - 8
        b = write_u32_le(b, 0xe28fc600 | ((off >> 20) & 0xff))
        b = write_u32_le(b, 0xe28cca00 | ((off >> 12) & 0xff))
        b = write_u32_le(b, 0xe5bcf000 | (off & 0xfff))
        b = write_u32_le(b, 0xd4d4d4d4)
        i = i + 1
    b

fn elf_build_gotplt_arm(n: i64, plt_addr: i64) -> [i64]:
    """ARM .got.plt: 3 reserved zero words (ld.so fills [1]/[2]), then one word
    per PLT entry initialised to PLT0 for lazy binding (ld.lld)."""
    if n == 0:
        return []
    var b = write_zeros([], GOTPLT_RESERVED * 4)
    var i: i64 = 0
    while i < n:
        b = write_u32_le(b, plt_addr)
        i = i + 1
    b

fn elf_gotplt_reserved(target: RelocArch) -> i64:
    """Header words of .got.plt: two on RISC-V (ld.so fills them), else three."""
    if target == RelocArch.Riscv64 or target == RelocArch.Riscv32: 2 else: GOTPLT_RESERVED

fn _rv_hi20(x: i64) -> i64:
    ((x + 0x800) >> 12) & 0xfffff

fn _rv_lo12(x: i64) -> i64:
    (x - (((x + 0x800) >> 12) << 12)) & 0xfff

fn elf_build_plt_riscv(plt_addr: i64, gotplt_addr: i64, n: i64, rv64: bool) -> [i64]:
    """ld.lld's RISC-V lazy PLT. PLT0 (32 B): auipc t2,hi(.got.plt); sub t1,t1,t3;
    l[wd] t3,lo(t2); addi t1,t1,-44; addi t0,t2,lo; srli t1,t1,(2|1);
    l[wd] t0,ws(t0); jr t3. PLTn (16 B): auipc t3,hi(slot); l[wd] t3,lo(t3);
    jalr t1,t3; nop."""
    if n == 0:
        return []
    val ws: i64 = if rv64: 8 else: 4
    val ld3: i64 = if rv64: 0x3000 else: 0x2000
    val d = gotplt_addr - plt_addr
    var b = write_u32_le([], 0x397 | (_rv_hi20(d) << 12))
    b = write_u32_le(b, 0x41c30333)
    b = write_u32_le(b, 0x38e03 | ld3 | (_rv_lo12(d) << 20))
    b = write_u32_le(b, 0x30313 | (((0 - RV_PLT0_SIZE - 12) & 0xfff) << 20))
    b = write_u32_le(b, 0x38293 | (_rv_lo12(d) << 20))
    b = write_u32_le(b, 0x35313 | ((if rv64: 1 else: 2) << 20))
    b = write_u32_le(b, 0x28283 | ld3 | (ws << 20))
    b = write_u32_le(b, 0x000e0067)
    var i: i64 = 0
    while i < n:
        val e = plt_addr + RV_PLT0_SIZE + i * RV_PLT_ENTRY_SIZE
        val off = gotplt_addr + (2 + i) * ws - e
        b = write_u32_le(b, 0xe17 | (_rv_hi20(off) << 12))
        b = write_u32_le(b, 0xe0e03 | ld3 | (_rv_lo12(off) << 20))
        b = write_u32_le(b, 0x000e0367)
        b = write_u32_le(b, 0x13)
        i = i + 1
    b

fn elf_build_gotplt_riscv(n: i64, plt_addr: i64, rv64: bool) -> [i64]:
    """RISC-V .got.plt: two zero header words, then one word per PLT entry
    initialised to PLT0 for lazy binding (ld.lld)."""
    if n == 0:
        return []
    val ws: i64 = if rv64: 8 else: 4
    var b = write_zeros([], 2 * ws)
    var i: i64 = 0
    while i < n:
        b = if rv64: write_u64_le(b, plt_addr) else: write_u32_le(b, plt_addr)
        i = i + 1
    b

fn elf_plt0_size(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            RV_PLT0_SIZE
        case Riscv32:
            RV_PLT0_SIZE
        case Arm32:
            ARM_PLT0_SIZE
        case AArch64:
            A64_PLT0_SIZE
        case _:
            X64_PLT0_SIZE

fn elf_plt_entry_size(target: RelocArch) -> i64:
    match target:
        case Riscv64:
            RV_PLT_ENTRY_SIZE
        case Riscv32:
            RV_PLT_ENTRY_SIZE
        case Arm32:
            ARM_PLT_ENTRY_SIZE
        case AArch64:
            A64_PLT_ENTRY_SIZE
        case _:
            X64_PLT_ENTRY_SIZE

fn elf_plt_size(target: RelocArch, n: i64) -> i64:
    if n == 0:
        return 0
    elf_plt0_size(target) + n * elf_plt_entry_size(target)

fn elf_x64_rip32(buf: [i64], disp: i64) -> [i64]:
    write_u32_le(buf, disp & 0xffffffff)

fn elf_build_plt_x64(plt_addr: i64, gotplt_addr: i64, n: i64) -> [i64]:
    """ld.lld's x86_64 lazy PLT (no IBT): PLT0 = pushq GOTPLT+8(%rip);
    jmpq *GOTPLT+16(%rip); nopl 0(%rax). PLTn = jmpq *slot(%rip); pushq $n;
    jmp PLT0 — 16 bytes each, slot n = .got.plt[3 + n]."""
    if n == 0:
        return []
    var b = [0xff, 0x35]
    b = elf_x64_rip32(b, gotplt_addr + 8 - (plt_addr + 6))
    b = b.push(0xff)
    b = b.push(0x25)
    b = elf_x64_rip32(b, gotplt_addr + 16 - (plt_addr + 12))
    b = write_u32_le(b, 0x00401f0f)
    var i: i64 = 0
    while i < n:
        val e = plt_addr + X64_PLT0_SIZE + i * X64_PLT_ENTRY_SIZE
        b = b.push(0xff)
        b = b.push(0x25)
        b = elf_x64_rip32(b, gotplt_addr + (GOTPLT_RESERVED + i) * 8 - (e + 6))
        b = b.push(0x68)
        b = write_u32_le(b, i)
        b = b.push(0xe9)
        b = elf_x64_rip32(b, plt_addr - (e + 16))
        i = i + 1
    b

fn elf_build_gotplt_x64(n: i64, plt_addr: i64, dynamic_addr: i64) -> [i64]:
    """x86_64 .got.plt: [0] = _DYNAMIC, [1]/[2] for ld.so, then one word per
    PLT entry initialised to that entry's `pushq` (PLTn + 6) for lazy binding."""
    if n == 0:
        return []
    var b = write_u64_le([], dynamic_addr)
    b = write_zeros(b, 16)
    var i: i64 = 0
    while i < n:
        b = write_u64_le(b, plt_addr + X64_PLT0_SIZE + i * X64_PLT_ENTRY_SIZE + 6)
        i = i + 1
    b

fn elf_build_dynamic(tags: [[i64]]) -> [i64]:
    elf_build_dynamic_class(tags, false)

fn elf_build_dynamic_class(tags: [[i64]], w32: bool) -> [i64]:
    """tags = [[d_tag, d_val], ...]; DT_NULL is appended. Elf32_Dyn is 8 bytes."""
    var b: [i64] = []
    for t in tags:
        if w32:
            b = write_u32_le(b, t[0])
            b = write_u32_le(b, t[1] & 0xffffffff)
        else:
            b = write_u64_le(b, t[0])
            b = write_u64_le(b, t[1])
    if w32:
        return write_zeros(b, 8)
    b = write_u64_le(b, DT_NULL)
    write_u64_le(b, 0)

fn elf_build_interp(path: text) -> [i64]:
    var b: [i64] = []
    for ch in path.bytes():
        b = b.push(ch as i64)
    b.push(0)

