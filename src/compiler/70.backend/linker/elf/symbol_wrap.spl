# GNU --wrap symbol projection shared by archive selection and final ELF links.

use compiler.backend.linker.elf_parser.{ElfObject, ElfSymbol, SHN_UNDEF}

fn elf_wrap_symbol_name(name: text, wraps: [text]) -> text:
    """Rewrite one undefined-symbol name according to GNU --wrap policy."""
    for target in wraps:
        if name == target:
            return "__wrap_" + target
        if name == "__real_" + target:
            return target
    name

fn elf_wrap_object(obj: ElfObject, wraps: [text]) -> ElfObject:
    """Rewrite only undefined references; definitions retain their real names."""
    if wraps.len() == 0: return obj
    var symbols: [ElfSymbol] = []
    for sym in obj.symbols:
        val name = if sym.st_shndx == SHN_UNDEF:
            elf_wrap_symbol_name(sym.name, wraps)
        else:
            sym.name
        symbols = symbols.push(ElfSymbol(
            st_name: sym.st_name, st_info: sym.st_info, st_other: sym.st_other,
            st_shndx: sym.st_shndx, st_value: sym.st_value, st_size: sym.st_size,
            name: name))
    ElfObject(header: obj.header, sections: obj.sections, symbols: symbols,
        relocations: obj.relocations, strtab: obj.strtab, shstrtab: obj.shstrtab,
        raw: obj.raw)

export elf_wrap_symbol_name, elf_wrap_object
