# Logical admission limits. These do not describe allocator overhead or RSS.
use compiler.backend.linker.elf.elf_file_reader.{ElfFileObjectV1, ElfFileSymbolV1}
use compiler.backend.linker.elf.archive_file.{ArchiveFileV1}

pub struct ElfStreamLimitsV1:
    input_limit: i64
    archive_member_limit: u64
    metadata_bytes: u64
    read_window_bytes: i64
    emit_window_bytes: i64
    name_bytes: i64
    output_bytes: u64
    scratch_bytes: u64
    scan_record_limit: u64

pub class ElfStreamInputsV1:
    var objects: [ElfFileObjectV1]
    var archives: [ArchiveFileV1]
    limits: ElfStreamLimitsV1
    var metadata_used: u64
    var records_left: u64
    var closed: bool

pub struct ElfStreamBindingV1:
    owner: i64
    table: i64
    ordinal: u64
    symbol: ElfFileSymbolV1

pub struct ElfStreamLayoutV1:
    group_offsets: [u64]
    group_sizes: [u64]
    file_bytes: u64
    entry_address: u64

export ElfStreamLimitsV1, ElfStreamInputsV1, ElfStreamBindingV1
export ElfStreamLayoutV1
