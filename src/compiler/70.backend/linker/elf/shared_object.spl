# ELF shared-object reader for the internal linker — lane A7 slice 2.
#
# Reads only what a link against a DSO needs: DT_SONAME (for DT_NEEDED), the
# defined, default-version .dynsym exports (name -> st_type) and the version
# each of those exports carries (name -> `.gnu.version_d` version, "" when the
# library has no versions). Works on a stripped library (no .symtab);
# non-default (hidden, `@` not `@@`) versions are not linkable, exactly as
# ld.lld treats them.
#
# The version matters: a reference that names no version binds, in ld.so, to
# version index 2 of the library, which for glibc/x86_64 is the ANCIENT
# GLIBC_2.2.5 compat set. `realpath` is the demonstrator — the 2.2.5
# implementation returns NULL. So the linker must record the default version
# of every import and emit .gnu.version / .gnu.version_r for it.

use compiler.backend.linker.elf_inspect.{
    ElfSectionHeader, elf_parse_header, elf_read_u16_le, elf_read_u32_le, elf_read_u64_le,
    ET_DYN, ELF64_SHDR_SIZE
}
use compiler.backend.linker.elf_parser.{ElfStringTable, elf_strtab_get, elf_parse_string_table}

val SHT_DYNSYM_SO: i64 = 11
val SHT_DYNAMIC_SO: i64 = 6
val SHT_GNU_VERSYM: i64 = 0x6fffffff
val SHT_GNU_VERDEF: i64 = 0x6ffffffd
val DT_SONAME_SO: i64 = 14
val VERSYM_HIDDEN: i64 = 0x8000
val VER_FLG_BASE: i64 = 1
val VER_FLG_WEAK: i64 = 2

struct ElfSharedLib:
    soname: text
    machine: i64
    exports: {text: i64}   # defined default-version symbol -> STT_* type
    versions: {text: text}      # export -> its default version name ("" = unversioned)
    version_weak: {text: bool}  # version name -> VER_FLG_WEAK was set on its verdef

fn elf_so_shdr(bytes: [u8], shoff: i64, i: i64) -> ElfSectionHeader:
    """Section header i with sh_addr repurposed as the FILE offset (elf_parser convention)."""
    val h = shoff + i * ELF64_SHDR_SIZE
    ElfSectionHeader(sh_name: elf_read_u32_le(bytes, h), sh_type: elf_read_u32_le(bytes, h + 4),
        sh_flags: elf_read_u64_le(bytes, h + 8), sh_addr: elf_read_u64_le(bytes, h + 24),
        sh_size: elf_read_u64_le(bytes, h + 32), sh_info: elf_read_u32_le(bytes, h + 44))

fn elf_so_link(bytes: [u8], shoff: i64, i: i64) -> i64:
    elf_read_u32_le(bytes, shoff + i * ELF64_SHDR_SIZE + 40)

struct ElfVerdefs:
    """What a DSO's `.gnu.version_d` says about each version index."""
    names: {i64: text}
    weak: {text: bool}      # by version NAME, which is what a verneed aux carries

fn elf_verdef_names(bytes: [u8], sec: ElfSectionHeader, strtab: ElfStringTable, count: i64) -> ElfVerdefs:
    """`.gnu.version_d` version index -> version name + VER_FLG_WEAK (Elf64_Verdef chain)."""
    var out: {i64: text} = {}
    var weak: {text: bool} = {}
    var off = sec.sh_addr
    var seen: i64 = 0
    while seen < count and off + 20 <= bytes.len():
        val flags = elf_read_u16_le(bytes, off + 2)
        val base = flags & VER_FLG_BASE   # the file's own name, not a version
        val ndx = elf_read_u16_le(bytes, off + 4) & 0x7fff
        val aux = elf_read_u32_le(bytes, off + 12)
        if base == 0 and off + aux + 4 <= bytes.len():
            val vname = elf_strtab_get(strtab, elf_read_u32_le(bytes, off + aux))
            out[ndx] = vname
            weak[vname] = flags & VER_FLG_WEAK != 0
        val next = elf_read_u32_le(bytes, off + 16)
        if next == 0:
            seen = count
        else:
            off = off + next
            seen = seen + 1
    ElfVerdefs(names: out, weak: weak)

fn elf_parse_shared(bytes: [u8]) -> Result<ElfSharedLib, text>:
    """Parse an ET_DYN shared object's SONAME and dynamic exports."""
    val header = elf_parse_header(bytes)?
    if header.e_type != ET_DYN:
        return Err("not a shared object (e_type {header.e_type})")
    val shoff = header.e_shoff
    val shnum = header.e_shnum
    if shoff <= 0 or shoff + shnum * ELF64_SHDR_SIZE > bytes.len():
        return Err("shared object has no usable section header table")

    var dynsym_i: i64 = -1
    var dynamic_i: i64 = -1
    var versym_i: i64 = -1
    var verdef_i: i64 = -1
    var i: i64 = 0
    while i < shnum:
        val t = elf_read_u32_le(bytes, shoff + i * ELF64_SHDR_SIZE + 4)
        if t == SHT_DYNSYM_SO:
            dynsym_i = i
        else if t == SHT_DYNAMIC_SO:
            dynamic_i = i
        else if t == SHT_GNU_VERSYM:
            versym_i = i
        else if t == SHT_GNU_VERDEF:
            verdef_i = i
        i = i + 1
    if dynsym_i < 0:
        return Err("shared object has no .dynsym")

    val symsec = elf_so_shdr(bytes, shoff, dynsym_i)
    val strtab = elf_parse_string_table(bytes, elf_so_shdr(bytes, shoff, elf_so_link(bytes, shoff, dynsym_i)))
    var versym_off: i64 = -1
    if versym_i >= 0:
        versym_off = elf_so_shdr(bytes, shoff, versym_i).sh_addr

    var verdef = ElfVerdefs(names: {}, weak: {})
    if verdef_i >= 0:
        val vsec = elf_so_shdr(bytes, shoff, verdef_i)
        verdef = elf_verdef_names(bytes, vsec,
            elf_parse_string_table(bytes, elf_so_shdr(bytes, shoff, elf_so_link(bytes, shoff, verdef_i))),
            vsec.sh_info)

    var exports: {text: i64} = {}
    var versions: {text: text} = {}
    val count = symsec.sh_size / 24
    var k: i64 = 1
    while k < count:
        val e = symsec.sh_addr + k * 24
        val info = bytes[e + 4] as i64
        val shndx = elf_read_u16_le(bytes, e + 6)
        val bind = info >> 4
        var linkable = shndx != 0 and (bind == 1 or bind == 2)
        var ver = ""
        if linkable and versym_off >= 0:
            val vs = elf_read_u16_le(bytes, versym_off + k * 2)
            if vs & VERSYM_HIDDEN != 0:
                linkable = false
            else if verdef.names.has(vs & 0x7fff):
                ver = verdef.names[vs & 0x7fff]
        if linkable:
            val name = elf_strtab_get(strtab, elf_read_u32_le(bytes, e))
            exports[name] = info & 0xf
            versions[name] = ver
        k = k + 1

    var soname = ""
    if dynamic_i >= 0:
        val dsec = elf_so_shdr(bytes, shoff, dynamic_i)
        val dstr = elf_parse_string_table(bytes, elf_so_shdr(bytes, shoff, elf_so_link(bytes, shoff, dynamic_i)))
        var d: i64 = 0
        while d + 16 <= dsec.sh_size:
            val tag = elf_read_u64_le(bytes, dsec.sh_addr + d)
            if tag == 0:
                d = dsec.sh_size
            else:
                if tag == DT_SONAME_SO:
                    soname = elf_strtab_get(dstr, elf_read_u64_le(bytes, dsec.sh_addr + d + 8))
                d = d + 16
    if soname == "":
        return Err("shared object has no DT_SONAME (needed for DT_NEEDED)")
    Ok(ElfSharedLib(soname: soname, machine: header.e_machine, exports: exports, versions: versions,
        version_weak: verdef.weak))

export ElfSharedLib, ElfVerdefs, elf_parse_shared
