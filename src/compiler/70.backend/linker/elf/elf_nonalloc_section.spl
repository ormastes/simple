"""Append metadata without changing existing section indices or load segments."""
use compiler.backend.linker.elf_parser.{elf_parse_object, elf_section_name}
use compiler.backend.linker.elf.byte_buffers.{elf_u8_zeros}

fn elf_append_nonalloc_section(image: [i64], name: text, kind: i64, payload: [i64]) -> Result<[i64], text>:
    """`[i64]` form of `elf_append_nonalloc_section_bytes`."""
    var raw: [u8] = []
    for byte in image:
        if byte < 0 or byte > 255: return Err("ELF metadata image contains a non-byte value")
        raw.push(byte as u8)
    val out = elf_append_nonalloc_section_bytes(raw, name, kind, payload)?
    var result: [i64] = []
    for byte in out: result.push(byte as i64)
    Ok(result)

fn elf_append_nonalloc_section_bytes(image: [u8], name: text, kind: i64, payload: [i64]) -> Result<[u8], text>:
    """Append a non-allocated section to a packed image. The result is
    allocated once at its final size and filled with native `write_span`."""
    if name == "" or name.contains("\0"): return Err("ELF metadata section name is invalid")
    if kind < 0 or kind > 4294967295: return Err("ELF metadata section type exceeds 32 bits")
    var payload_bytes: [u8] = []
    for byte in payload:
        if byte < 0 or byte > 255: return Err("ELF metadata payload contains a non-byte value")
        payload_bytes.push(byte as u8)
    val object = elf_parse_object(image)?
    if image.len() < 64 or image[4] != 2u8 or image[5] != 1u8:
        return Err("ELF metadata append requires little-endian ELF64")
    val count = object.sections.len()
    val strings_index = object.header.e_shstrndx
    if count >= 65279 or strings_index <= 0 or strings_index >= count:
        return Err("ELF metadata section table cannot be extended")
    var i: i64 = 0
    while i < count:
        if elf_section_name(object, i) == name: return Err("duplicate ELF metadata section {name}")
        i = i + 1
    val strings = object.sections[strings_index]
    if strings.sh_type != 3 or strings.sh_addr < 0 or strings.sh_addr > image.len() or strings.sh_size < 1 or strings.sh_size > image.len() - strings.sh_addr:
        return Err("ELF metadata section-name table is invalid")
    val name_bytes = name.bytes()
    val payload_offset = image.len()
    val strings_offset = payload_offset + payload_bytes.len()
    var headers_offset = strings_offset + strings.sh_size + name_bytes.len() + 1
    while headers_offset % 8 != 0: headers_offset = headers_offset + 1
    val new_header = headers_offset + count * 64
    var result: [u8] = elf_u8_zeros(new_header + 64)
    result.write_span(image, 0, 0, image.len())
    if payload_bytes.len() > 0: result.write_span(payload_bytes, payload_offset, 0, payload_bytes.len())
    result.write_span(image, strings_offset, strings.sh_addr, strings.sh_size)
    i = 0
    while i < name_bytes.len():
        result[strings_offset + strings.sh_size + i] = name_bytes[i] as u8
        i = i + 1
    result.write_span(image, headers_offset, object.header.e_shoff, count * 64)
    val put_at = [headers_offset + strings_index * 64 + 24, headers_offset + strings_index * 64 + 32,
        new_header, new_header + 4, new_header + 24, new_header + 32, new_header + 48, 40, 60]
    val put_width = [8, 8, 4, 4, 8, 8, 8, 8, 2]
    val put_value = [strings_offset, strings.sh_size + name_bytes.len() + 1, strings.sh_size, kind,
        payload_offset, payload_bytes.len(), 1, headers_offset, count + 1]
    var pi: i64 = 0
    while pi < put_at.len():
        var b: i64 = 0
        while b < put_width[pi]:
            result[put_at[pi] + b] = ((put_value[pi] >> (b * 8)) & 255) as u8
            b = b + 1
        pi = pi + 1
    Ok(result)

export elf_append_nonalloc_section, elf_append_nonalloc_section_bytes
