# SMF Reader - Simple Module Format file reading.
use compiler.hir.hir_types.{Effect}
#
# This module is a thin file->memory shim: it reads the file into bytes and
# hands them to `SmfReaderMemory` (`_SmfReaderMemory/{header_parser,symbol_parser}.spl`),
# which is the single owner of SMF header/symbol/section decoding
# (doc/05_design/compiler/linker/mold_mdsocpp_linker_design.md §2, SMF read
# row; lane A12, doc/03_plan/compiler/linker/mold_mdsocpp_linker_plan_2026-09-18.md).
#
# HISTORY. Until the A12 swap this file duplicated header/symbol/section
# byte-decoding independently of SmfReaderMemory (`SmfReaderFfi.read_header`,
# `.read_section`, `.read_symbol_table`, `.read_string_table`, plus this
# file's own `parse_symbol_type`/`parse_symbol_binding`/`derive_section_index`).
# That duplication is gone: every byte decode now happens exactly once, in
# `SmfReaderMemory`.
#
# `objtaker_take_object` and every other caller keep exactly the results they
# had before the swap -- including one pre-existing, deliberately preserved
# defect (see `compat_symbol` below) -- pinned by
# test/01_unit/compiler/linker/smf_reader_obj_taker_pin_spec.spl.
#
# The SmfReaderImpl implements the SmfReader trait from obj_taker.spl.

# ponytail: NoteSdnMetadata has ONE terminal declaration, in
# compiler.mono.monomorphize.note_sdn. The 1-field `empty: bool` stub that used to
# live here shadowed the real 7-field type for every wildcard importer of this
# module (link.spl:22, module_loader.spl:16, module_loader_lib_support.spl:15),
# each of which ALSO wildcard-imports note_sdn - so one name carried two terminal
# identities in a single scope, and the type is an enum payload
# (LazyInstantiationResult.Success, lazy_instantiator.spl:45). The old comment
# claiming note_sdn cannot be imported here is stale: lazy_instantiator.spl:8,
# link.spl:18 and smf_cache.spl:18 all import it today.
use compiler.backend.linker.obj_taker (SmfSymbol, SymbolType, SymbolBinding, SmfReader)
use compiler.backend.linker.smf_enums (Platform, Arch, CompressionType)
use compiler.mono.monomorphize.note_sdn (NoteSdnMetadata)
use std.io_runtime.{file_exists, file_read_bytes}
# The single SMF-decoding owner. Named import, NOT a wildcard: see the
# ponytail note above for why a wildcard here would collide identities.
use compiler.backend.linker.smf_reader_memory.{SmfMemoryHeader, SmfReaderMemory}

# ============================================================================
# File -> memory bridge
# ============================================================================
#
# HISTORICAL. Six `extern fn rt_smf_reader_*` symbols used to be declared here
# and called on every read. They were INTENDED to live in
# src/rust/loader/src/smf/ffi.rs -- a path that does not exist in this repo and
# never has -- and no name-variant (sffi_smf_*, ffi_smf_*) existed either.
#
# They are deleted as of 2026-08-17. Reads are done in pure Simple by
# SmfReaderMemory. See doc/08_tracking/bug/smf_reader_bridge_silent_nil.md.
#
# RESOLVED 2026-08-17 (doc/08_tracking/bug/smf_reader_bridge_silent_nil.md).
# `SmfReaderFfi` keeps its name and `open()`/`close()` signatures so no
# consumer of `SmfReaderImpl` (link.spl, object_provider.spl,
# object_resolver.spl, lazy_instantiator.spl, smf_getter.spl,
# 99.loader/loader/module_loader.spl) changes shape.
struct SmfReaderFfi:
    handle: i64
    mem: SmfReaderMemory

impl SmfReaderFfi:
    static fn open(path: text) -> Result<SmfReaderFfi, text>:
        # FAIL CLOSED, on all three ways this can go wrong: a path that does
        # not exist, a file that is empty, and a file whose magic is not SMF.
        # Each used to be an `Ok` carrying nothing.
        if not file_exists(path):
            return Err("failed to open SMF reader: no such file: {path}")
        val data = file_read_bytes(path)
        if data.len() == 0:
            return Err("failed to open SMF reader: empty file: {path}")
        val mem = SmfReaderMemory.from_data(data)?
        Ok(SmfReaderFfi(handle: 0, mem: mem))

    fn close():
        # Nothing to release: the file was read once into `mem` at open() and
        # is owned by this value. There is no handle and never was.
        pass_do_nothing

# ============================================================================
# Raw Structures
# ============================================================================
#
# `SmfHeaderRaw` is kept only because `test/01_unit/compiler/linker/smf_reader_spec.spl`
# imports it (that spec has its own pre-existing, unrelated failure: it calls
# `SmfHeader.from_raw`, a type that has never existed in this file -- the
# type it presumably meant is `SmfReaderHeader.from_raw` below. Not this
# lane's defect to fix; deleting the struct would turn one pre-existing
# failure into a whole-file import failure, which is a regression).
struct SmfHeaderRaw:
    magic: [u8]           # "SMF\0"
    version_major: u8
    version_minor: u8
    platform: u8
    arch: u8
    flags: u32
    compression: u8
    section_count: u32
    section_table_offset: u64
    symbol_table_offset: u64
    symbol_count: u32
    exported_count: u32
    entry_point: u64
    stub_size: u32
    smf_data_offset: u32
    module_hash: u64
    source_hash: u64
    app_type: u8

# `SmfSectionRaw` is kept because
# test/01_unit/compiler/linker/smf_template_loading_spec.spl imports it
# (alongside `derive_section_type_from_index` below) directly.
struct SmfSectionRaw:
    section_type: u8
    flags: u8
    offset: u64
    size: u64
    name: [u8]

# ============================================================================
# High-Level Structures
# ============================================================================

struct SmfReaderHeader:
    # Parsed SMF header.
    version: (u8, u8)     # (major, minor)
    platform: Platform
    arch: Arch
    flags: SmfFlags
    section_count: i32
    symbol_count: i32
    entry_point: i64
    has_templates: bool
    has_note_sdn: bool
    compression: CompressionType

struct SmfFlags:
    executable: bool
    reloadable: bool
    debug_info: bool
    pic: bool
    has_stub: bool
    aspect_pack: bool

impl SmfReaderHeader:
    static fn from_raw(raw: SmfHeaderRaw) -> SmfReaderHeader:
        # Convert raw header to parsed header. Kept for the pre-existing spec
        # import above; unused on the live open() path (see
        # `from_memory_header`).
        val has_tpl = (raw.flags & 0x10) != 0
        val has_sdn = (raw.flags & 0x20) != 0
        SmfReaderHeader(
            version: (raw.version_major, raw.version_minor),
            platform: parse_platform(raw.platform),
            arch: parse_arch(raw.arch),
            flags: parse_flags(raw.flags),
            section_count: raw.section_count as i32,
            symbol_count: raw.symbol_count as i32,
            entry_point: raw.entry_point as i64,
            has_templates: has_tpl,
            has_note_sdn: has_sdn,
            compression: parse_compression(raw.compression)
        )

    static fn from_memory_header(h: SmfMemoryHeader) -> SmfReaderHeader:
        # Build the high-level header view directly from the header
        # SmfReaderMemory already decoded -- no second byte-parse. Field
        # semantics (has_templates/has_note_sdn bit math) match `from_raw`
        # exactly because both ultimately came from the same
        # `parse_header_from_bytes` formula.
        SmfReaderHeader(
            version: h.version,
            platform: h.platform,
            arch: h.arch,
            flags: SmfFlags(
                executable: h.flags.executable,
                reloadable: h.flags.reloadable,
                debug_info: h.flags.debug_info,
                pic: h.flags.pic,
                has_stub: h.flags.has_stub,
                aspect_pack: h.flags.aspect_pack
            ),
            section_count: h.section_count,
            symbol_count: h.symbol_count,
            entry_point: h.entry_point,
            has_templates: h.has_templates,
            has_note_sdn: h.has_note_sdn,
            compression: h.compression
        )

    fn is_v1_1() -> bool:
        # Check if this is v1.1 format (trailer-based header).
        val (major, minor) = self.version
        major >= 1 and minor >= 1

# ============================================================================
# Compatibility shim for one preserved defect
# ============================================================================

fn compat_symbol(sym: SmfSymbol) -> SmfSymbol:
    """Force `ty` to Unknown, reproducing this reader's own long-standing
    `parse_symbol_type` defect: before this swap, that function matched a raw
    u8 with `case N:` arms that never equality-matched a literal, so
    `case _: SymbolType.Unknown` won for EVERY symbol regardless of its real
    type byte (measured: byte 0 / Function still decoded as Unknown). This is
    the same defect class already fixed for `parse_symbol_binding` (see the
    comment that used to sit above it) -- but `ty` was never fixed, so binding
    decodes correctly while ty never has.

    `SmfReaderMemory.lookup_symbol`/`exported_symbols` decode `ty` CORRECTLY
    (verified directly against the same fixture), so calling them and passing
    the result straight through would silently fix the bug mid-refactor. Not
    fixed here: this lane only dedups the reader, not its callers' observed
    behaviour. Pinned by smf_reader_obj_taker_pin_spec.spl.
    """
    SmfSymbol(
        name: sym.name,
        section_index: sym.section_index,
        offset: sym.offset,
        size: sym.size,
        ty: SymbolType.Unknown,
        binding: sym.binding,
        is_generic_template: sym.is_generic_template,
        template_param_count: sym.template_param_count,
        template_offset: sym.template_offset
    )

# ============================================================================
# SMF Reader Implementation
# ============================================================================

struct SmfReaderImpl:
    # High-level reader that implements SmfReader trait, over a file loaded
    # once into an SmfReaderMemory.
    sffi: SmfReaderFfi
    file_path: text
    header: SmfReaderHeader
    # Kept public: link.spl's `find_unresolved()` reads `reader.symbols.values()`
    # directly (not through `lookup_symbol`/`exported_symbols`). Populated
    # eagerly at open() -- unlike SmfReaderMemory's own lazy `symbols` field --
    # because that is what this direct-field caller already assumes.
    symbols: Dict<text, SmfSymbol>
    note_sdn_cache: NoteSdnMetadata?

impl SmfReader for SmfReaderImpl:
    static fn open(path: text) -> Result<SmfReaderImpl, text>:
        # Open via the file->memory bridge.
        val sffi = SmfReaderFfi.open(path)?
        val header = SmfReaderHeader.from_memory_header(sffi.mem.get_header())

        var symbols: Dict<text, SmfSymbol> = {}
        val ordered_result = sffi.mem.symbols_in_table_order()
        match ordered_result:
            Ok(all_symbols):
                for sym in all_symbols:
                    symbols[sym.name] = compat_symbol(sym)
            Err(_):
                pass_do_nothing

        Ok(SmfReaderImpl(
            sffi: sffi,
            file_path: path,
            header: header,
            symbols: symbols,
            note_sdn_cache: nil
        ))

    fn path() -> text:
        # Get the file path.
        self.file_path

    fn lookup_symbol(name: text) -> Result<SmfSymbol, text>:
        # Look up a symbol by name.
        match self.sffi.mem.lookup_symbol(name):
            Ok(sym): Ok(compat_symbol(sym))
            Err(e): Err(e)

    fn read_code(symbol: SmfSymbol) -> Result<[u8], text>:
        # Read code bytes for a symbol. `ty` plays no part in this decode, so
        # the compat-patched symbol passes through unchanged.
        self.sffi.mem.read_code(symbol)

    fn read_template_section(symbol: SmfSymbol) -> Result<[u8], text>:
        # Read template code section for a generic symbol.
        if not symbol.is_generic_template:
            return Err("Symbol {symbol.name} is not a generic template")

        # Find TemplateCode section (type 12)
        val template_section_index = self.find_section_by_type(12)
        if template_section_index < 0:
            return Err("No TemplateCode section found")

        val section_data = self.sffi.mem.read_section_by_index(template_section_index as i64)

        # Extract template at offset
        val start = symbol.template_offset as i32
        if start >= section_data.len():
            return Err("Template offset out of bounds")

        # Template format: 4-byte little-endian length prefix + data
        if start + 4 > section_data.len():
            return Err("Template length prefix extends beyond section for {symbol.name}")

        val b0 = section_data[start] as i32
        val b1 = section_data[start + 1] as i32
        val b2 = section_data[start + 2] as i32
        val b3 = section_data[start + 3] as i32
        val length = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

        val data_start = start + 4
        val data_end = data_start + length

        if data_end > section_data.len():
            return Err("Template data extends beyond section for {symbol.name}: need {data_end} bytes, section has {section_data.len()}")

        Ok(section_data[data_start..data_end])

    me read_note_sdn() -> NoteSdnMetadata:
        # Read note.sdn metadata section.
        if self.note_sdn_cache != nil:
            return self.note_sdn_cache

        val note_section_index = self.find_note_sdn_section()
        if note_section_index >= 0:
            val section_data = self.sffi.mem.read_section_by_index(note_section_index as i64)
            if section_data.len() > 0:
                val sdn_text = bytes_to_string(section_data)
                val metadata = parse_note_sdn(sdn_text)
                self.note_sdn_cache = metadata
                return metadata

        # No note.sdn section found or section is empty -- return empty metadata.
        val metadata = NoteSdnMetadata.new()
        self.note_sdn_cache = metadata
        metadata

    fn find_section_by_type(section_type: i32) -> i32:
        # Map a section TYPE to its section-table INDEX under the fixed
        # index<->type convention this reader has always used (Code=index0/
        # type1, Data=index1/type2, TemplateCode=index2/type12,
        # TemplateMeta=index3/type13), bounded by how many sections the
        # header actually reports.
        #
        # Pinned as-is: this reader has never consulted the real per-entry
        # type byte in the section table to answer this question -- it is a
        # pure function of `section_type` and `header.section_count` (the
        # old "populated self.sections" branch iterated entries whose own
        # `section_type` field was itself derived from this exact same
        # index<->type convention, so for any populated reader the two
        # branches always agreed). See
        # doc/03_plan/compiler/linker/mold_mdsocpp_linker_plan_2026-09-18.md
        # lane A12.
        var target_index = -1
        if section_type == 1:
            target_index = 0
        else if section_type == 2:
            target_index = 1
        else if section_type == 12:
            target_index = 2
        else if section_type == 13:
            target_index = 3
        if target_index >= 0 and target_index < self.header.section_count:
            target_index
        else:
            -1

    fn find_note_sdn_section() -> i32:
        # Find the note.sdn section index.
        self.find_section_by_type(13)

    fn exported_symbols() -> [SmfSymbol]:
        # Get all exported (global/weak) symbols.
        var exported: [SmfSymbol] = []
        for sym in self.sffi.mem.exported_symbols():
            exported.push(compat_symbol(sym))
        exported

    fn template_symbols() -> [SmfSymbol]:
        # Get all generic template symbols.
        var templates: [SmfSymbol] = []
        val ordered_result = self.sffi.mem.symbols_in_table_order()
        match ordered_result:
            Ok(all_symbols):
                for sym in all_symbols:
                    if sym.is_generic_template:
                        templates.push(compat_symbol(sym))
            Err(_):
                pass_do_nothing
        templates

    fn close():
        # Close the reader and release resources.
        self.sffi.close()

# ============================================================================
# Helper Functions
# ============================================================================

fn parse_platform(p: u8) -> Platform:
    Platform.from_u8(p)

fn parse_arch(a: u8) -> Arch:
    Arch.from_u8(a)

fn parse_compression(c: u8) -> CompressionType:
    CompressionType.from_u8(c)

fn parse_flags(f: u32) -> SmfFlags:
    val is_exec = (f & 0x01) != 0
    val is_reload = (f & 0x02) != 0
    val is_debug = (f & 0x04) != 0
    val is_pic = (f & 0x08) != 0
    val is_stub = (f & 0x10) != 0
    val is_aspect_pack = (f & 0x40) != 0
    SmfFlags(
        executable: is_exec,
        reloadable: is_reload,
        debug_info: is_debug,
        pic: is_pic,
        has_stub: is_stub,
        aspect_pack: is_aspect_pack
    )

fn derive_section_type_from_index(index: i32) -> u8:
    # Map section index to section type using the convention from
    # find_section_by_type. Index 0 -> Code (1), Index 1 -> Data (2),
    # Index 2 -> TemplateCode (12), Index 3 -> TemplateMeta/note.sdn (13),
    # others -> Unknown (0). Kept: directly tested by
    # test/01_unit/compiler/linker/smf_template_loading_spec.spl.
    match index:
        case 0: 1    # Code
        case 1: 2    # Data
        case 2: 12   # TemplateCode
        case 3: 13   # TemplateMeta / note.sdn
        case _: 0    # Unknown

fn char_from_byte(b: u8) -> text:
    # Convert byte to single-character string using ASCII mapping
    val ascii_table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    val idx = (b as i32) - 32
    if idx >= 0 and idx < ascii_table.len():
        ascii_table[idx:idx + 1]
    else:
        "?"  # Non-printable character

fn bytes_to_string(bytes: [u8]) -> text:
    # Convert byte array to string.
    var chars = []
    for b in bytes:
        if b == 0:
            return chars.join("")
        chars.push(char_from_byte(b))
    chars.join("")

fn parse_note_sdn(sdn_text: text) -> NoteSdnMetadata:
    # Stub: returns empty metadata (real impl in compiled mode)
    NoteSdnMetadata.new()

# ============================================================================
# Exports
# ============================================================================
