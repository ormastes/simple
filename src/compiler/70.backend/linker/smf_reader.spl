# SMF Reader - Simple Module Format file reading.
#
# This module provides SMF file reading capabilities using:
# - Rust SFFI for binary parsing (performance-critical)
# - Simple for high-level logic and metadata interpretation
#
# The SmfReader implements the SmfReader trait from obj_taker.spl.

# ponytail: NoteSdnMetadata has ONE terminal declaration, in
# compiler.mono.monomorphize.note_sdn. The 1-field `empty: bool` stub that used to
# live here shadowed the real 7-field type for every wildcard importer of this
# module (link.spl:22, module_loader.spl:16, module_loader_lib_support.spl:15),
# each of which ALSO wildcard-imports note_sdn - so one name carried two terminal
# identities in a single scope, and the type is an enum payload
# (LazyInstantiationResult.Success, lazy_instantiator.spl:45). The old comment
# claiming note_sdn cannot be imported here is stale: lazy_instantiator.spl:8,
# link.spl:18 and smf_cache.spl:18 all import it today.
use compiler.backend.linker.obj_taker (SmfSymbol, SymbolType, SymbolBinding)
use compiler.backend.linker.smf_enums (Platform, Arch, CompressionType)
use compiler.mono.monomorphize.note_sdn (NoteSdnMetadata)
use std.io_runtime.{file_exists, file_read_bytes}
# The extern-free pure-Simple SMF decoders. Named imports, NOT a wildcard:
# smf_reader_memory re-exports its own `SmfFlags`, `derive_section_index` and
# `char_from_byte`, all of which this module also defines. A wildcard here would
# make one name carry two terminal identities in a single scope -- exactly the
# hazard called out in the ponytail note above.
use compiler.backend.linker.smf_reader_memory.{
    SmfMemoryHeader,
    parse_header_from_bytes,
    extract_string_table,
    smf_payload_file_offset,
    bytes_to_u32,
    bytes_to_u64
}

# ============================================================================
# Rust SFFI Declarations
# ============================================================================
#
# HISTORICAL. Six `extern fn rt_smf_reader_*` symbols used to be declared here
# and called on every read. They were INTENDED to live in
# src/rust/loader/src/smf/ffi.rs -- a path that does not exist in this repo and
# never has -- and no name-variant (sffi_smf_*, ffi_smf_*) existed either.
#
# They are deleted as of 2026-08-17. Reads are now done in pure Simple by the
# same decoders SmfReaderMemory uses. See the RESOLVED block below and
# doc/08_tracking/bug/smf_reader_bridge_silent_nil.md.

# RESOLVED 2026-08-17 (doc/08_tracking/bug/smf_reader_bridge_silent_nil.md).
#
# The six `rt_smf_reader_*` externs are GONE. They were never implemented, and
# an unregistered extern does not fail to link -- it yields 0/nil -- so this
# type reported `Ok` for every input and then handed back a hardcoded all-zero
# header, an empty symbol table, an empty string table and empty section data.
# That is the silent-wrong-answer shape: no crash, no log, exit 0, and a caller
# with no way to tell an empty module from one that was never read.
#
# The reads below are now real, and are the SAME decoders `SmfReaderMemory`
# uses (`parse_header_from_bytes`, `extract_string_table`, and the 56-byte
# symbol-entry layout from `_SmfReaderMemory/symbol_parser.spl`). Routing both
# readers through one set of decoders is the point: it makes the two agree by
# construction, which is what
# `test/01_unit/compiler/linker/smf_reader_bridge_parity_class_spec.spl`
# pins. `SmfReaderFfi` keeps its name and method signatures so no consumer
# (link.spl, object_provider.spl, object_resolver.spl, lazy_instantiator.spl,
# smf_getter.spl, module_loader.spl) changes shape.
#
# `handle` is retained as a field only because `SmfHeaderRaw`/`SmfSymbolRaw` are
# re-exported from linker/__init__.spl and callers may construct this type; it
# is always 0 and nothing reads it.
struct SmfReaderFfi:
    handle: i64
    data: [u8]
    mem_header: SmfMemoryHeader

impl SmfReaderFfi:
    static fn open(path: text) -> Result<SmfReaderFfi, text>:
        # FAIL CLOSED, on all three ways this can go wrong: a path that does not
        # exist, a file that is empty, and a file whose magic is not SMF. Each
        # used to be an `Ok` carrying nothing.
        if not file_exists(path):
            return Err("failed to open SMF reader: no such file: {path}")
        val data = file_read_bytes(path)
        if data.len() == 0:
            return Err("failed to open SMF reader: empty file: {path}")
        val mem_header = parse_header_from_bytes(data)?
        Ok(SmfReaderFfi(handle: 0, data: data, mem_header: mem_header))

    fn read_header() -> SmfHeaderRaw:
        # Decoded from the bytes at the header's real location. `header_offset`
        # is 0 for a legacy leading-header file and EOF-128 for a v1.1 trailer;
        # parse_header_from_bytes has already resolved which.
        val data = self.data
        val off = self.mem_header.header_offset
        SmfHeaderRaw(
            magic: [data[off], data[off + 1], data[off + 2], data[off + 3]],
            version_major: data[off + 4],
            version_minor: data[off + 5],
            platform: data[off + 6],
            arch: data[off + 7],
            flags: bytes_to_u32(data, off + 8),
            compression: data[off + 12],
            section_count: bytes_to_u32(data, off + 16),
            section_table_offset: bytes_to_u64(data, off + 20),
            symbol_table_offset: bytes_to_u64(data, off + 28),
            symbol_count: bytes_to_u32(data, off + 36),
            exported_count: bytes_to_u32(data, off + 40),
            entry_point: bytes_to_u64(data, off + 44),
            stub_size: bytes_to_u32(data, off + 52),
            smf_data_offset: bytes_to_u32(data, off + 56),
            module_hash: bytes_to_u64(data, off + 60),
            source_hash: bytes_to_u64(data, off + 68),
            app_type: data[off + 76]
        )

    fn read_section(index: i32) -> [u8]:
        # Section table entry is 64 bytes: type(1) pad(3) flags(4) offset(8)
        # size(8) virtual_size(8) alignment(8) name(16). Same layout
        # SmfReaderMemory.read_code decodes.
        val entry_size: i64 = 64
        val entry_off = self.mem_header.section_table_offset + (index as i64) * entry_size
        if index < 0 or entry_off < 0 or entry_off + entry_size > self.data.len():
            return []
        val raw_offset = bytes_to_u64(self.data, entry_off + 8) as i64
        val sec_offset = smf_payload_file_offset(self.mem_header, raw_offset)
        val sec_size = bytes_to_u64(self.data, entry_off + 16) as i64
        val sec_end = sec_offset + sec_size
        if sec_offset < 0 or sec_size < 0 or sec_end > self.data.len():
            return []
        var out: [u8] = []
        var i = sec_offset
        while i < sec_end:
            out.push(self.data[i])
            i = i + 1
        out

    fn read_symbol_table() -> [SmfSymbolRaw]:
        # 56-byte symbol entry, layout documented in
        # _SmfReaderMemory/symbol_parser.spl (Rust #[repr(C)] SmfSymbol with
        # natural alignment: 4-byte pad at 12, 4-byte pad at 44).
        val entry_size: i64 = 56
        val base = self.mem_header.symbol_table_offset
        val count = self.mem_header.symbol_count as i64
        var out: [SmfSymbolRaw] = []
        var i: i64 = 0
        while i < count:
            val e = base + i * entry_size
            # Truncated table: return what was actually readable rather than
            # fabricating entries. Short is honest; zeros are not.
            if e < 0 or e + entry_size > self.data.len():
                return out
            out.push(SmfSymbolRaw(
                name_offset: bytes_to_u32(self.data, e),
                name_hash: bytes_to_u32(self.data, e + 4),
                sym_type: self.data[e + 8],
                binding: self.data[e + 9],
                visibility: self.data[e + 10],
                flags: self.data[e + 11],
                value: bytes_to_u64(self.data, e + 16),
                size: bytes_to_u64(self.data, e + 24),
                type_id: bytes_to_u32(self.data, e + 32),
                version: bytes_to_u32(self.data, e + 36),
                template_param_count: self.data[e + 40],
                template_offset: bytes_to_u64(self.data, e + 48)
            ))
            i = i + 1
        out

    fn read_string_table() -> [u8]:
        match extract_string_table(self.data, self.mem_header):
            Ok(table): table
            Err(_): []

    fn close():
        # Nothing to release: the file was read once into `data` at open() and
        # is owned by this value. There is no handle and never was.
        pass_do_nothing

# ============================================================================
# Raw Structures (from SFFI)
# ============================================================================

struct SmfHeaderRaw:
    # Raw SMF header as returned from Rust SFFI.
    magic: [u8]           # "SMF\0"
    version_major: u8
    version_minor: u8
    platform: u8
    arch: u8
    flags: u32
    compression: u8
    section_count: u32
    section_table_offset: u64
    symbol_table_offset: u64
    symbol_count: u32
    exported_count: u32
    entry_point: u64
    stub_size: u32
    smf_data_offset: u32
    module_hash: u64
    source_hash: u64
    app_type: u8

struct SmfSymbolRaw:
    # Raw symbol as returned from Rust SFFI.
    name_offset: u32
    name_hash: u32
    sym_type: u8
    binding: u8
    visibility: u8
    flags: u8
    value: u64
    size: u64
    type_id: u32
    version: u32
    template_param_count: u8
    template_offset: u64

struct SmfSectionRaw:
    # Raw section as returned from Rust SFFI.
    section_type: u8
    flags: u8
    offset: u64
    size: u64
    name: [u8]

# ============================================================================
# High-Level Structures
# ============================================================================

struct SmfReaderHeader:
    # Parsed SMF header.
    version: (u8, u8)     # (major, minor)
    platform: Platform
    arch: Arch
    flags: SmfFlags
    section_count: i32
    symbol_count: i32
    entry_point: i64
    has_templates: bool
    has_note_sdn: bool
    compression: CompressionType

struct SmfFlags:
    executable: bool
    reloadable: bool
    debug_info: bool
    pic: bool
    has_stub: bool

impl SmfReaderHeader:
    static fn from_raw(raw: SmfHeaderRaw) -> SmfReaderHeader:
        # Convert raw header to parsed header.
        val has_tpl = (raw.flags & 0x10) != 0
        val has_sdn = (raw.flags & 0x20) != 0
        SmfReaderHeader(
            version: (raw.version_major, raw.version_minor),
            platform: parse_platform(raw.platform),
            arch: parse_arch(raw.arch),
            flags: parse_flags(raw.flags),
            section_count: raw.section_count as i32,
            symbol_count: raw.symbol_count as i32,
            entry_point: raw.entry_point as i64,
            has_templates: has_tpl,
            has_note_sdn: has_sdn,
            compression: parse_compression(raw.compression)
        )

    fn is_v1_1() -> bool:
        # Check if this is v1.1 format (trailer-based header).
        val (major, minor) = self.version
        major >= 1 and minor >= 1

# ============================================================================
# SMF Reader Implementation
# ============================================================================

struct SmfReaderImpl:
    # High-level SMF reader that implements SmfReader trait.
    sffi: SmfReaderFfi
    file_path: text
    header: SmfReaderHeader
    symbols: Dict<text, SmfSymbol>
    string_table: [u8]
    sections: [SmfSectionRaw]
    note_sdn_cache: NoteSdnMetadata?

impl SmfReaderImpl:
    static fn open(path: text) -> Result<SmfReaderImpl, text>:
        # Open an SMF file and parse headers.
        # Open via Rust SFFI
        val sffi = SmfReaderFfi.open(path)?

        # Read header
        val raw_header = sffi.read_header()
        val header = SmfReaderHeader.from_raw(raw_header)

        # Read string table for symbol name resolution
        val string_table = sffi.read_string_table()

        # Read and parse symbol table
        val raw_symbols = sffi.read_symbol_table()
        var symbols: Dict<text, SmfSymbol> = {}

        for raw in raw_symbols:
            val name = read_string_from_table(string_table, raw.name_offset)
            val is_gen = (raw.flags & 0x10) != 0
            val symbol = SmfSymbol(
                name: name,
                section_index: derive_section_index(raw.sym_type),
                offset: raw.value as i64,
                size: raw.size as i64,
                ty: parse_symbol_type(raw.sym_type),
                binding: parse_symbol_binding(raw.binding),
                is_generic_template: is_gen,
                template_param_count: raw.template_param_count as i32,
                template_offset: raw.template_offset as i64
            )
            symbols[name] = symbol

        # Populate sections by reading each section's data via SFFI and
        # constructing SmfSectionRaw entries.  The existing rt_smf_reader_read_section
        # SFFI returns section data bytes; section metadata (type, flags, name) is
        # derived from the section index convention plus data inspection.
        var sections: [SmfSectionRaw] = []
        var sec_idx = 0
        while sec_idx < header.section_count:
            val sec_data = sffi.read_section(sec_idx)
            val sec_type = derive_section_type_from_index(sec_idx)
            val sec_flags: u8 = 0
            sections = sections.push(SmfSectionRaw(
                section_type: sec_type,
                flags: sec_flags,
                offset: 0,
                size: sec_data.len() as u64,
                name: []
            ))
            sec_idx = sec_idx + 1

        Ok(SmfReaderImpl(
            sffi: sffi,
            file_path: path,
            header: header,
            symbols: symbols,
            string_table: string_table,
            sections: sections,
            note_sdn_cache: nil
        ))

    fn path() -> text:
        # Get the file path.
        self.file_path

    fn lookup_symbol(name: text) -> Result<SmfSymbol, text>:
        # Look up a symbol by name.
        if self.symbols.has(name):
            Ok(self.symbols[name])
        else:
            Err("Symbol not found: {name}")

    fn read_code(symbol: SmfSymbol) -> Result<[u8], text>:
        # Read code bytes for a symbol.
        # Find the code section
        val section_data = self.sffi.read_section(symbol.section_index)

        # Extract symbol's code
        val start = symbol.offset as i32
        val end = start + symbol.size as i32

        if end > section_data.len():
            return Err("Symbol {symbol.name} extends beyond section")

        Ok(section_data[start..end])

    fn read_template_section(symbol: SmfSymbol) -> Result<[u8], text>:
        # Read template code section for a generic symbol.
        if not symbol.is_generic_template:
            return Err("Symbol {symbol.name} is not a generic template")

        # Find TemplateCode section (type 12)
        val template_section_index = self.find_section_by_type(12)
        if template_section_index < 0:
            return Err("No TemplateCode section found")

        val section_data = self.sffi.read_section(template_section_index)

        # Extract template at offset
        val start = symbol.template_offset as i32
        if start >= section_data.len():
            return Err("Template offset out of bounds")

        # Template format: 4-byte little-endian length prefix + data
        if start + 4 > section_data.len():
            return Err("Template length prefix extends beyond section for {symbol.name}")

        val b0 = section_data[start] as i32
        val b1 = section_data[start + 1] as i32
        val b2 = section_data[start + 2] as i32
        val b3 = section_data[start + 3] as i32
        val length = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

        val data_start = start + 4
        val data_end = data_start + length

        if data_end > section_data.len():
            return Err("Template data extends beyond section for {symbol.name}: need {data_end} bytes, section has {section_data.len()}")

        Ok(section_data[data_start..data_end])

    me read_note_sdn() -> NoteSdnMetadata:
        # Read note.sdn metadata section.
        if self.note_sdn_cache != nil:
            return self.note_sdn_cache

        # Try to read note.sdn from section table (type 13)
        val note_section_index = self.find_note_sdn_section()
        if note_section_index >= 0:
            val section_data = self.sffi.read_section(note_section_index)
            if section_data.len() > 0:
                val sdn_text = bytes_to_string(section_data)
                val metadata = parse_note_sdn(sdn_text)
                self.note_sdn_cache = metadata
                return metadata

        # Fallback: sections may be populated now (STUB-007 resolved).
        # Try reading type-13 section data directly via SFFI as a second attempt.
        val fallback_idx = self.find_section_by_type(13)
        if fallback_idx >= 0:
            val raw_bytes = self.sffi.read_section(fallback_idx)
            if raw_bytes.len() > 0:
                val raw_text = bytes_to_string(raw_bytes)
                if raw_text.len() > 0:
                    val fb_metadata = parse_note_sdn(raw_text)
                    self.note_sdn_cache = fb_metadata
                    return fb_metadata

        # No note.sdn section found or section is empty -- return empty metadata.
        val metadata = NoteSdnMetadata.new()
        self.note_sdn_cache = metadata
        metadata

    fn find_section_by_type(section_type: i32) -> i32:
        # Find section index by type.
        # Iterate self.sections and match on section_type field.
        # Falls back to convention-based index mapping if sections are not populated.
        if self.sections.len() > 0:
            var idx = 0
            for sec in self.sections:
                if sec.section_type as i32 == section_type:
                    return idx
                idx = idx + 1
            return -1

        # Fallback: sections not populated (STUB-007 not yet resolved)
        match section_type:
            case 1: 0   # Code
            case 2: 1   # Data
            case 12: 2  # TemplateCode
            case 13: 3  # TemplateMeta/note.sdn
            case _: -1

    fn find_note_sdn_section() -> i32:
        # Find the note.sdn section index.
        self.find_section_by_type(13)

    fn exported_symbols() -> [SmfSymbol]:
        # Get all exported (global/weak) symbols.
        #
        # This used to call `s.is_exported()`, a method that does not exist on
        # `SmfSymbol` (obj_taker.spl:39 — the struct has `binding`, no such
        # method). It was never a compile error and never fired at runtime for
        # one reason only: `self.symbols` was ALWAYS EMPTY, because every read
        # went through an unimplemented extern, so the loop body was dead code.
        # Fixing the reads (see the RESOLVED block above) made this reachable
        # for the first time and it failed with
        # `semantic: method is_exported not found on type SmfSymbol`.
        #
        # A dead branch hiding a hard error behind a silent empty answer is the
        # same defect class as the extern bridge itself, so it is fixed here
        # rather than filed. The predicate matches SmfReaderMemory's
        # exported_symbols (header_parser.spl): Global or Weak is exported.
        #
        # Iteration is keys()-based, NOT `.values()`. Measured 2026-08-17 with a
        # one-Global-symbol fixture: `lookup_symbol("hello")` returned the
        # symbol while `for s in self.symbols.values()` yielded nothing, so this
        # returned [] for a module that demonstrably had an exported symbol —
        # another silent empty answer. `SmfReaderMemory.exported_symbols`
        # (header_parser.spl:156) already iterates `self.symbols.keys()` for the
        # same reason, with a BUG-001 note. Matching it keeps the two readers in
        # parity, which is what the class spec asserts.
        var exported: [SmfSymbol] = []
        for name in self.symbols.keys():
            val s = self.symbols[name]
            if s.binding == SymbolBinding.Global or s.binding == SymbolBinding.Weak:
                exported = exported.push(s)
        exported

    fn template_symbols() -> [SmfSymbol]:
        # Get all generic template symbols.
        # keys()-based for the same reason as exported_symbols above: `.values()`
        # yields nothing here, so this silently reported "no templates" for
        # every module.
        var templates: [SmfSymbol] = []
        for name in self.symbols.keys():
            val s = self.symbols[name]
            if s.is_generic_template:
                templates = templates.push(s)
        templates

    fn close():
        # Close the reader and release resources.
        self.sffi.close()

# ============================================================================
# Helper Functions
# ============================================================================

fn parse_platform(p: u8) -> Platform:
    Platform.from_u8(p)

fn parse_arch(a: u8) -> Arch:
    Arch.from_u8(a)

fn parse_compression(c: u8) -> CompressionType:
    CompressionType.from_u8(c)

fn parse_flags(f: u32) -> SmfFlags:
    val is_exec = (f & 0x01) != 0
    val is_reload = (f & 0x02) != 0
    val is_debug = (f & 0x04) != 0
    val is_pic = (f & 0x08) != 0
    val is_stub = (f & 0x10) != 0
    SmfFlags(
        executable: is_exec,
        reloadable: is_reload,
        debug_info: is_debug,
        pic: is_pic,
        has_stub: is_stub
    )

fn derive_section_type_from_index(index: i32) -> u8:
    # Map section index to section type using the convention from find_section_by_type.
    # Index 0 -> Code (1), Index 1 -> Data (2), Index 2 -> TemplateCode (12),
    # Index 3 -> TemplateMeta/note.sdn (13), others -> Unknown (0).
    match index:
        case 0: 1    # Code
        case 1: 2    # Data
        case 2: 12   # TemplateCode
        case 3: 13   # TemplateMeta / note.sdn
        case _: 0    # Unknown

fn derive_section_index(sym_type: u8) -> i32:
    # Derive section index from symbol type.
    # Functions go in code section (0), data/constants in data section (1).
    match sym_type:
        case 0: 0  # Function -> code section
        case 1: 1  # Data -> data section
        case 5: 1  # Constant -> data section
        case _: 0  # Default to code section

fn parse_symbol_type(t: u8) -> SymbolType:
    match t:
        case 0: SymbolType.Function
        case 1: SymbolType.Data
        case 2: SymbolType.Type
        case 3: SymbolType.Trait
        case 4: SymbolType.ActorSymbol
        case 5: SymbolType.Constant
        case _: SymbolType.Unknown

fn parse_symbol_binding(b: u8) -> SymbolBinding:
    # Widened to i64 before comparison, deliberately.
    #
    # Measured 2026-08-17: with `match b:` on the raw `u8`, a symbol whose
    # binding byte is literally 1 decoded as `Local`, not `Global` — every arm
    # missed and `case _` won. That made `exported_symbols()` return [] for a
    # module that plainly had a global symbol: another silent wrong answer, and
    # one that was invisible until the reader started producing real symbols at
    # all (see the RESOLVED block at the top of this file).
    #
    # Proof it is the u8 match and not the data: the same fixture byte read at
    # the same offset yields `binding_is_local=true`, and widening to i64 with
    # explicit comparisons yields Global. `if`/`else` rather than `match` so the
    # comparison is unambiguously integer-to-integer.
    val v = b as i64
    if v == 1:
        SymbolBinding.Global
    else if v == 2:
        SymbolBinding.Weak
    else:
        SymbolBinding.Local

fn read_string_from_table(table: [u8], offset: u32) -> text:
    # Read null-terminated string from string table.
    var chars = []
    for i in (offset as i32)..table.len():
        if table[i] == 0:
            return chars.join("")
        chars.push(char_from_byte(table[i]))
    chars.join("")

fn char_from_byte(b: u8) -> text:
    # Convert byte to single-character string using ASCII mapping
    val ascii_table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    val idx = (b as i32) - 32
    if idx >= 0 and idx < ascii_table.len():
        ascii_table[idx:idx + 1]
    else:
        "?"  # Non-printable character

fn bytes_to_string(bytes: [u8]) -> text:
    # Convert byte array to string.
    var chars = []
    for b in bytes:
        if b == 0:
            return chars.join("")
        chars.push(char_from_byte(b))
    chars.join("")

fn parse_note_sdn(sdn_text: text) -> NoteSdnMetadata:
    # Stub: returns empty metadata (real impl in compiled mode)
    NoteSdnMetadata.new()

# ============================================================================
# Exports
# ============================================================================
