# Shared native-link configuration. Kept independent of execution adapters.
use compiler.backend.linker.source_region_link_types_v1.{SourceRegionObjectSealV1}
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1}
struct NativeLinkConfig:
    libraries: [text]
    library_paths: [text]
    runtime_path: text       # Path to libsimple_compiler (empty = auto-detect)
    target_triple: text = ""
    linker_abi: text = ""
    pie: bool
    debug: bool
    strip_output: bool = false
    prefer_size_linker: bool = false
    verbose: bool
    allow_duplicate_definitions: bool
    allow_cc_fallback: bool
    retained_symbols: [text]
    extra_flags: [text]
    runtime_bundle: text = "" # Named runtime authority selected by the bootstrap owner
    source_region_objects_v1: [SourceRegionObjectSealV1] = []
    source_region_account_v1: MirLoopResourceAccountV1? = nil

impl NativeLinkConfig:
    static fn default() -> NativeLinkConfig:
        NativeLinkConfig(
            libraries: [], library_paths: [], runtime_path: "", pie: true,
            debug: false, strip_output: false, prefer_size_linker: false,
            verbose: false, allow_duplicate_definitions: true,
            allow_cc_fallback: true, retained_symbols: [], extra_flags: [],
            target_triple: "", linker_abi: "", runtime_bundle: "")

export NativeLinkConfig
