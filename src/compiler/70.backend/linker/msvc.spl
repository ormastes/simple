# MSVC Linker Support (Windows)
#
# Integrates with Microsoft Visual C++ linker (link.exe) for Windows builds.
# Auto-detects Visual Studio installation via vswhere.exe.

use std.platform (is_windows, normalize_path, join_path)
use std.io_runtime.{process_run, file_exists, env_get_opt, file_write}
use compiler.backend.linker.link (LinkConfig, LinkError, LinkErrorKind, Linker)

struct MsvcShellResult:
    stdout: text
    stderr: text
    exit_code: i64

# Windows shell command execution (cmd.exe). Named distinctly from other
# `shell` helpers in the standard library (e.g. std.io_runtime.shell) to
# avoid colliding with them in the interpreter's process-wide function
# table, where identically-named top-level fns silently overwrite each
# other on load ("last write wins") and previously also caused a bogus
# `extern fn shell` declared here to shadow ANY same-named local function
# in ANY module, anywhere in the program (see msvc_shell_naming bug).
#
# WARNING -- the `cmd` string passed here MUST NOT CONTAIN A DOUBLE QUOTE.
# The runtime's Windows argv builder (win_cmd_build_line,
# src/runtime/platform/windows_command_line_private.h) applies
# CommandLineToArgvW quoting, escaping every embedded `"` as `\"`. cmd.exe
# parses its own command line and does not honour `\"`, so such a string is
# mangled: cmd prints "The filename, directory name, or volume label syntax
# is incorrect" and exits 1 without running anything. Measured 2026-09-02
# with a standalone CreateProcessA harness over the real win_cmd_build_line.
# Only quote-free probes (`where <tool> 2>nul`) are safe on this helper;
# anything needing a quoted path must use msvc_run_argv below.
fn msvc_shell(cmd: text) -> MsvcShellResult:
    val (stdout, stderr, code) = process_run("cmd", ["/C", cmd])
    MsvcShellResult(stdout: stdout, stderr: stderr, exit_code: code)

# Direct argv invocation of a native tool -- no shell, so no cmd.exe parsing
# and no quoting ambiguity. CommandLineToArgvW quoting is exactly what
# link.exe / lld-link (ordinary CRT programs) parse, so this is the correct
# route for any path that may contain spaces.
fn msvc_run_argv(exe: text, args: [text]) -> MsvcShellResult:
    val (stdout, stderr, code) = process_run(exe, args)
    MsvcShellResult(stdout: stdout, stderr: stderr, exit_code: code)

# ===========================================================================
# Windows Library Names
# ===========================================================================

fn default_windows_libs_with_suffix() -> [text]:
    ["kernel32.lib", "user32.lib", "ws2_32.lib", "bcrypt.lib", "advapi32.lib", "userenv.lib", "ntdll.lib", "msvcrt.lib"]

# ===========================================================================
# MSVC Linker Configuration
# ===========================================================================

class MsvcConfig:
    link_exe: text              # Path to link.exe
    lib_paths: [text]           # Library search paths
    libs: [text]                # Libraries to link
    entry_point: text           # Entry point (e.g., "mainCRTStartup")
    subsystem: text             # Subsystem (console, windows)
    machine: text               # Target machine (X64, ARM64)
    debug: bool                 # Include debug info
    extra_args: [text]          # Additional linker flags

impl MsvcConfig:
    static fn default() -> MsvcConfig:
        MsvcConfig(
            link_exe: "",
            lib_paths: find_msvc_crt_paths(),
            libs: default_windows_libs_with_suffix(),
            entry_point: "mainCRTStartup",
            subsystem: "console",
            machine: "X64",
            debug: false,
            extra_args: []
        )

    fn build_args(output: text, object_files: [text]) -> [text]:
        var args: [text] = []

        # Output file
        args.push("/OUT:{output}")

        # Object files
        for obj in object_files:
            args.push(obj)

        # Libraries
        for lib in self.libs:
            args.push(lib)

        # Library paths
        for path in self.lib_paths:
            args.push("/LIBPATH:{path}")

        # Entry point
        if self.entry_point != "":
            args.push("/ENTRY:{self.entry_point}")

        # Subsystem
        args.push("/SUBSYSTEM:{self.subsystem}")

        # Machine type
        args.push("/MACHINE:{self.machine}")

        # Debug info
        if self.debug:
            args.push("/DEBUG")
        else:
            args.push("/DEBUG:NONE")
            # Remove unreferenced functions/data and fold identical COMDATs
            args.push("/OPT:REF,ICF")

        # No logo
        args.push("/NOLOGO")

        # Extra arguments
        for arg in self.extra_args:
            args.push(arg)

        args

# ===========================================================================
# MSVC Linker
# ===========================================================================

class MsvcLinker:
    config: MsvcConfig

impl MsvcLinker:
    static fn new(config: MsvcConfig) -> MsvcLinker:
        MsvcLinker(config: config)

    # Link objects into executable
    fn link(output: text, object_files: [text]) -> Result<(), LinkError>:
        # Find link.exe if not specified
        var link_exe = self.config.link_exe
        if link_exe == "":
            val found = find_link_exe()
            match found:
                case Some(path):
                    link_exe = path
                case nil:
                    return Err(LinkError(kind: LinkErrorKind.InternalError, message: "MSVC link.exe not found", symbol: nil, location: nil))

        # Build arguments
        val args = self.config.build_args(output, object_files)

        # Invoke link.exe DIRECTLY through process_run -- never through
        # cmd.exe. MEASURED 2026-09-02 (standalone CreateProcessA harness over
        # the real win_cmd_build_line): the runtime's argv builder applies
        # CommandLineToArgvW quoting, so a shell string containing quotes came
        # out as
        #   cmd /C "\"C:\Program Files\...\link.exe\" ... > \"D:\...\log\" 2>&1"
        # and cmd.exe does NOT honour backslash-escaped quotes. cmd printed
        # "The filename, directory name, or volume label syntax is incorrect",
        # exited 1 WITHOUT running the linker, and never created the log --
        # which is exactly the `[msvc-link] FAILED exit=1` plus
        # `<link log unreadable>` this lane kept reporting. The previous
        # comment here blamed corrupted captured handles; that was a
        # misdiagnosis of the `{e}`-interpolates-a-struct defect, and process
        # capture is demonstrably fine (see _cc_verify_compiles' stderr dump
        # and the C-runtime compile path, both of which capture normally).
        # CommandLineToArgvW quoting is precisely what link.exe/lld-link parse,
        # so passing argv directly is the correct route, not a workaround; it
        # also removes the unquoted args.join(" ") hazard for any object path
        # containing a space. Windows-only module; Unix is unaffected.
        val result = msvc_run_argv(link_exe, args)
        val cmd = "\"{link_exe}\" {args.join(' ')}"

        if result.exit_code != 0:
            # link.exe / lld-link report LNK errors on STDOUT, not stderr, so
            # reporting stderr alone throws half the diagnosis away: merge
            # both. Persist them next to the output as well, so a failure is
            # still diagnosable after the build log is rotated.
            val log_body = "{result.stdout}{result.stderr}"
            val link_log = "{output}.link.log"
            file_write(link_log, log_body)
            print "[msvc-link] FAILED exit={result.exit_code}"
            print "[msvc-link] command: {cmd}"
            print "[msvc-link] log: {link_log}"
            print "[msvc-link] output-begin"
            print log_body
            print "[msvc-link] output-end"
            val diag = "linker exited {result.exit_code} | command: {cmd} | log: {link_log} | output: {log_body}"
            return Err(LinkError(kind: LinkErrorKind.OutputFailed, message: diag, symbol: nil, location: nil))

        Ok(())

    # Link from LinkConfig
    static fn link_from_config(config: LinkConfig, object_files: [text]) -> Result<(), LinkError>:
        var msvc_config = MsvcConfig.default()

        # Detect machine type from target flags
        var machine = "X64"  # Default to X64
        for flag in config.target_flags:
            if flag.contains("x86_64") or flag.contains("x86-64"):
                machine = "X64"
            elif flag.contains("aarch64") or flag.contains("arm64"):
                machine = "ARM64"
            elif flag.contains("i386") or flag.contains("i686"):
                machine = "X86"
        msvc_config.machine = machine

        # Set debug mode
        msvc_config.debug = config.debug

        # Add library paths
        msvc_config.lib_paths = config.library_paths

        # Add libraries
        for lib in config.libraries:
            # Convert .a to .lib extension
            val lib_name = if lib.ends_with(".a"):
                lib.substring(0, lib.len() - 2) + ".lib"
            else:
                lib
            msvc_config.libs.push(lib_name)

        # Add extra linker flags
        if config.linker_flags.len() > 0:
            msvc_config.extra_args = config.linker_flags

        # Create linker and link
        val linker = MsvcLinker.new(msvc_config)
        linker.link(config.output_path, object_files)

# ===========================================================================
# Visual Studio Detection
# ===========================================================================

# Find Visual Studio installation using vswhere.exe
fn find_visual_studio() -> text?:
    # vswhere.exe location
    val fixed_vswhere = "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
    var vswhere = if file_exists(fixed_vswhere): fixed_vswhere else: ""
    if vswhere == "":
        if val program_files = env_get_opt("ProgramFiles(x86)"):
            val derived_vswhere = "{program_files}/Microsoft Visual Studio/Installer/vswhere.exe"
            if file_exists(derived_vswhere):
                vswhere = derived_vswhere

    if vswhere == "":
        return nil

    # Query for latest Visual Studio installation
    val cmd = "\"{vswhere}\" -latest -property installationPath"
    val result = msvc_shell(cmd)

    if result.exit_code != 0 or result.stdout.trim() == "":
        return nil

    Some(result.stdout.trim())

# Find link.exe in Visual Studio installation
fn is_msvc_linker_candidate(path: text) -> bool:
    val normalized = path.trim().replace("\\", "/").lower()
    if not normalized.ends_with("link.exe"):
        return false
    # Git-for-Windows and MSYS ship GNU coreutils `link.exe`.  It creates hard
    # links and accepts Unix operands, not MSVC `/OUT:` arguments.  `where`
    # commonly exposes it before the real linker in bootstrap shells.
    not normalized.ends_with("/usr/bin/link.exe") and
        not normalized.contains("/mingw32/bin/link.exe") and
        not normalized.contains("/mingw64/bin/link.exe")

fn find_link_exe() -> text?:
    # Try to find Visual Studio
    val vs_path_opt = find_visual_studio()
    match vs_path_opt:
        case Some(vs_path):
            # Search for link.exe under VC/Tools/MSVC/<ver>/bin/Hostx64/x64/.
            # Forward slashes: the lexer drops embedded `\\` from string
            # literals, so a backslash path here becomes an unopenable string.
            val result = msvc_shell("dir /b /s \"{vs_path}/VC/Tools/MSVC\" 2>nul | findstr link.exe")

            if result.exit_code == 0:
                val lines = result.stdout.split("\n")
                for line in lines:
                    val trimmed = line.trim()
                    if is_msvc_linker_candidate(trimmed) and file_exists(trimmed):
                        return Some(trimmed)

        case nil:
            pass

    # Try to find in PATH.
    #
    # `where` prints ONE LINE PER MATCH and there are routinely several:
    # measured 2026-09-02 in the MSVC bootstrap lane, `where link.exe` returned
    # 3 lines -- MSVC's linker first, then Git-for-Windows' coreutils `link.exe`
    # twice. Trimming the whole multi-line blob and calling file_exists on it
    # therefore ALWAYS failed, and this function returned nil with the linker
    # sitting first on PATH. That produced "MSVC link.exe not found", which was
    # the Stage 2 receiver gate's real (previously unprintable) error.
    # Iterate the lines and take the first that is an existing file, exactly as
    # the Visual Studio branch above already does.
    val path_result = msvc_shell("where link.exe 2>nul")
    if path_result.exit_code == 0:
        for path_line in path_result.stdout.split("\n"):
            val candidate = path_line.trim()
            if is_msvc_linker_candidate(candidate) and file_exists(candidate):
                return Some(candidate)

    # lld-link implements the MSVC command-line and COFF ABI accepted by this
    # linker wrapper.  Prefer it to accidentally accepting a Unix `link.exe`
    # when Visual Studio discovery is unavailable in a bootstrap environment.
    val lld_result = msvc_shell("where lld-link.exe 2>nul")
    if lld_result.exit_code == 0:
        for lld_line in lld_result.stdout.split("\n"):
            val candidate = lld_line.trim()
            if candidate.ends_with("lld-link.exe") and file_exists(candidate):
                return Some(candidate)

    nil

# ===========================================================================
# MSVC CRT Library Path Discovery
# ===========================================================================

fn find_msvc_crt_paths() -> [text]:
    """Discover MSVC CRT, UCRT, and Windows SDK library paths for x64."""
    var paths: [text] = []

    # 1. MSVC CRT: VC\Tools\MSVC\<ver>\lib\x64
    val vs_opt = find_visual_studio()
    match vs_opt:
        case Some(vs_path):
            val msvc_base = "{vs_path}/VC/Tools/MSVC"
            val result = msvc_shell("dir /b \"{msvc_base}\" 2>nul")
            if result.exit_code == 0:
                val versions = result.stdout.trim().split("\n")
                if versions.len() > 0:
                    # Use the latest version (last in sorted list)
                    val ver = versions[versions.len() - 1].trim()
                    if ver != "":
                        val lib_dir = "{msvc_base}/{ver}/lib/x64"
                        if file_exists(lib_dir):
                            paths.push(lib_dir)
        case nil:
            pass

    # 2. Windows SDK: Windows Kits\10\Lib\<ver>\ucrt\x64 and um\x64
    val sdk_base = "C:/Program Files (x86)/Windows Kits/10/Lib"
    val sdk_result = msvc_shell("dir /b \"{sdk_base}\" 2>nul")
    if sdk_result.exit_code == 0:
        val sdk_versions = sdk_result.stdout.trim().split("\n")
        if sdk_versions.len() > 0:
            val sdk_ver = sdk_versions[sdk_versions.len() - 1].trim()
            if sdk_ver != "":
                val ucrt_dir = "{sdk_base}/{sdk_ver}/ucrt/x64"
                if file_exists(ucrt_dir):
                    paths.push(ucrt_dir)
                val um_dir = "{sdk_base}/{sdk_ver}/um/x64"
                if file_exists(um_dir):
                    paths.push(um_dir)

    paths

# Check if MSVC linker is available
fn is_msvc_available() -> bool:
    match find_link_exe():
        case Some(_): true
        case nil: false

# ===========================================================================
# LLD-Link Support (LLVM's MSVC-compatible linker)
# ===========================================================================

class LldLinkLinker:
    config: MsvcConfig

impl LldLinkLinker:
    static fn new(config: MsvcConfig) -> LldLinkLinker:
        LldLinkLinker(config: config)

    fn link(output: text, object_files: [text]) -> Result<(), LinkError>:
        # Find lld-link
        val lld_result = msvc_shell("where lld-link 2>nul")
        if lld_result.exit_code != 0:
            return Err(LinkError(kind: LinkErrorKind.InternalError, message: "lld-link not found", symbol: nil, location: nil))

        val lld_link = lld_result.stdout.trim()

        # Build arguments (same as MSVC)
        val args = self.config.build_args(output, object_files)

        # Direct argv invocation, same rationale as MsvcLinker.link above:
        # routing a quoted command string through cmd.exe was mangled by the
        # runtime's CommandLineToArgvW quoting and never ran the linker.
        # Windows-only module; Unix is unaffected.
        val result = msvc_run_argv(lld_link, args)
        val cmd = "\"{lld_link}\" {args.join(' ')}"

        if result.exit_code != 0:
            # link.exe / lld-link report LNK errors on STDOUT, not stderr, so
            # reporting stderr alone throws half the diagnosis away: merge
            # both, and persist them next to the output so a failure stays
            # diagnosable after the build log is rotated.
            val log_body = "{result.stdout}{result.stderr}"
            val link_log = "{output}.link.log"
            file_write(link_log, log_body)
            print "[msvc-link] FAILED exit={result.exit_code}"
            print "[msvc-link] command: {cmd}"
            print "[msvc-link] log: {link_log}"
            print "[msvc-link] output-begin"
            print log_body
            print "[msvc-link] output-end"
            val diag = "linker exited {result.exit_code} | command: {cmd} | log: {link_log} | output: {log_body}"
            return Err(LinkError(kind: LinkErrorKind.OutputFailed, message: diag, symbol: nil, location: nil))

        Ok(())

# Check if lld-link is available
fn is_lld_link_available() -> bool:
    val result = msvc_shell("where lld-link 2>nul")
    result.exit_code == 0

# ===========================================================================
# Linker Auto-Detection (Windows)
# ===========================================================================

# ===========================================================================
# Linker Type (Windows)
# ===========================================================================

enum WindowsLinkerType:
    Msvc        # MSVC link.exe
    LldLink     # lld-link (LLVM's MSVC-compatible linker)
    Lld         # Regular lld

impl WindowsLinkerType:
    fn to_string() -> text:
        match self:
            case WindowsLinkerType.Msvc: "MSVC link.exe"
            case WindowsLinkerType.LldLink: "lld-link (LLVM)"
            case WindowsLinkerType.Lld: "lld"

# Auto-detect best available linker for Windows
fn auto_detect_windows_linker() -> WindowsLinkerType:
    # Prefer lld-link (faster, better error messages)
    if is_lld_link_available():
        return WindowsLinkerType.LldLink

    # Fall back to MSVC link.exe
    if is_msvc_available():
        return WindowsLinkerType.Msvc

    # Default to LLD (may fail if not installed)
    WindowsLinkerType.Lld

# Get linker name for display
fn get_linker_name(linker: WindowsLinkerType) -> text:
    linker.to_string()

# ===========================================================================
# Helper Functions
# ===========================================================================

# Convert Unix-style library name to Windows
fn convert_library_name(lib: text) -> text:
    # -lfoo → foo.lib
    if lib.starts_with("-l"):
        return lib.substring(2) + ".lib"

    # libfoo.a → foo.lib
    if lib.starts_with("lib") and lib.ends_with(".a"):
        val name = lib.substring(3, lib.len() - 2)
        return "{name}.lib"

    # foo.a → foo.lib
    if lib.ends_with(".a"):
        return lib.substring(0, lib.len() - 2) + ".lib"

    # Already .lib or other
    lib

