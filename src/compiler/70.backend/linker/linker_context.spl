# Linker Compilation Context
#
# CompilationContext implementation for link-time lazy instantiation.
# Templates come from input SMF object files.

use compiler.common.compilation_context.{CompilationContext, InstantiationMode, ContractMode, GenericTemplate, TemplateConcreteType, TypeRegistry, TemplateCompiledUnit, InstantiationRecord}
use compiler.common.di.DiContainer
use compiler.tools.aop.AopWeaver
use compiler.driver.pipeline_fn.compile_specialized_template_default

# ============================================================================
# LinkerCompilationContext
# ============================================================================

# The class-header spelling `class LinkerCompilationContext(CompilationContext):`
# registered no trait implementation, so lazy_instantiator's
# `TemplateInstantiator(linker_ctx, ...)` could not form the trait object
# ("missing native trait implementation: CompilationContext for
# LinkerCompilationContext"), and its methods had drifted from the trait's
# signatures. The data lives in the class; the trait is implemented below.
class LinkerCompilationContext:
    """Linker loads templates from input SMF object files."""
    object_templates: Dict<text, GenericTemplate>
    project_di: DiContainer
    project_aop: AopWeaver
    type_reg: TypeRegistry
    recorded: [InstantiationRecord]

impl CompilationContext for LinkerCompilationContext:
    fn load_template(name: text) -> GenericTemplate?:
        if self.object_templates.has(name):
            Some(self.object_templates[name])
        else:
            nil

    fn has_template(name: text) -> bool:
        self.object_templates.has(name)

    fn type_registry() -> TypeRegistry:
        self.type_reg

    fn contract_mode() -> ContractMode:
        # Linker applies all contracts
        ContractMode.All

    fn di_container() -> DiContainer?:
        Some(self.project_di)

    fn aop_weaver() -> AopWeaver?:
        Some(self.project_aop)

    fn coverage_enabled() -> bool:
        false

    fn compile_template(tmpl: GenericTemplate, type_args: [TemplateConcreteType]) -> Result<TemplateCompiledUnit, text>:
        val code = compile_specialized_template_default(
            tmpl, type_args,
            ContractMode.All,
            self.project_di,
            self.project_aop,
            false
        )
        Ok(TemplateCompiledUnit(name: tmpl.name, symbols: [], code: Some(code),
            effects: [], instantiation_mode: InstantiationMode.LinkTime))

    fn instantiation_mode() -> InstantiationMode:
        InstantiationMode.LinkTime

    me record_instantiation(entry: InstantiationRecord):
        self.recorded = self.recorded.push(entry)

    fn instantiation_count() -> i64:
        self.recorded.len()

# ============================================================================
# Exports
# ============================================================================
