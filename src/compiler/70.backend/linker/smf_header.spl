# SMF Header - 96-byte header structure for SMF format (v1.3 wire layout)
use compiler.hir.hir_types.{Effect}
#
# This module defines the SmfHeader struct used by Simple Module Format (SMF).
#
# Since v1.3 the wire layout is byte-identical to the Rust seed's #[repr(C)]
# `SmfHeader` (src/compiler_rust/common/src/smf/header.rs): exactly 96 bytes,
# written as a trailer at EOF-96. Normative schema: src/spec/artifact/smf_v1_2.sdn.
#
# Layout (96 bytes total, little-endian):
# - Identification (8): magic, version, platform, arch
# - Flags (8): flags, compression, compression_level, reserved_compression[2]
# - section_count u32 @16, 4 alignment padding bytes @20..24
# - section_table_offset u64 @24, symbol_table_offset u64 @32,
#   symbol_count u32 @40, exported_count u32 @44
# - entry_point u64 @48, stub_size u32 @56, smf_data_offset u32 @60
# - module_hash u64 @64, source_hash u64 @72
# - app_type u8 @80, (pad @81), window_width u16 @82, window_height u16 @84,
#   prefetch_hint u8 @86, prefetch_file_count u8 @87, reserved_hints[5] @88
# - 3 tail padding bytes @93..96
#
# The header is never extended: metadata that does not fit lives in the
# `.simple_meta` section (compiler.backend.linker.smf_meta). Versions 1.0-1.2
# used a packed 128-byte layout (trailer at EOF-128) whose bytes 88..104 held
# the compile-options hash; readers still accept it for one release.
# TODO(smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10): remove the
# packed 128-byte read path (SMF_PACKED_HEADER_SIZE, to_packed_bytes,
# smf_header_seed_shaped_at's heuristic branch) after one release.

use compiler.backend.linker.smf_enums (Platform, Arch, CompressionType, SmfAppType)

# ============================================================================
# Constants
# ============================================================================

val SMF_MAGIC: [u8] = [83, 77, 70, 0]  # "SMF\0"
pub val SMF_VERSION_MAJOR: u8 = 1
pub val SMF_VERSION_MINOR: u8 = 3      # v1.3: 96-byte repr(C) wire layout
pub val SMF_HEADER_SIZE: i64 = 96
# Legacy v1.0-v1.2 packed layout, accepted on read only.
pub val SMF_PACKED_HEADER_SIZE: i64 = 128

# Flag constants
val SMF_FLAG_EXECUTABLE: u32 = 0x0001
val SMF_FLAG_RELOADABLE: u32 = 0x0002
val SMF_FLAG_DEBUG_INFO: u32 = 0x0004
val SMF_FLAG_PIC: u32 = 0x0008
val SMF_FLAG_HAS_STUB: u32 = 0x0010  # v1.1: File has executable stub
# Aspect-facet dynload design §12.1: the file carries an aspect-pack directory
# and must be handled by an aspect-pack provider, not as an ordinary module.
# Bit 5 (0x20) is already the v1.1 note.sdn feature bit used by both driver and
# reader, so aspect packs use the next version-compatible extension bit.
pub val SMF_FLAG_ASPECT_PACK: u32 = 0x0040
# v1.3: relocation entries carry the 0xA2 source-section marker (the v1.2
# entry form). Replaces the v1.2 "version_minor = 2" stamp, since the minor
# now names the header layout.
pub val SMF_FLAG_SOURCE_RELOCS: u32 = 0x0080

# ============================================================================
# SmfHeader Struct
# ============================================================================

"""Complete SMF header structure (96 bytes on the wire).

The header is written at EOF-96 as a trailer, allowing executable stubs to
be prepended to SMF files. Field order matches the Rust seed struct; the
serializers in this impl add the repr(C) alignment padding.
"""
struct SmfHeader:
    # Identification (8 bytes)
    magic: [u8]              # Magic number "SMF\0" (4 bytes)
    version_major: u8        # Major version (1)
    version_minor: u8        # Minor version (1)
    platform: u8             # Platform identifier
    arch: u8                 # Architecture identifier

    # Flags and counts (20 bytes) - v1.1 adds compression
    flags: u32               # Feature flags
    compression: u8          # v1.1: 0=none, 1=zstd, 2=lz4
    compression_level: u8    # v1.1: 0=default, 1-22=level
    reserved_compression: [u8]  # v1.1: 2 bytes reserved
    section_count: u32       # Number of sections
    section_table_offset: u64  # Offset to section table

    # Symbol table (16 bytes)
    symbol_table_offset: u64  # Offset to symbol table
    symbol_count: u32         # Number of symbols
    exported_count: u32       # Number of exported symbols

    # Execution (16 bytes) - v1.1 adds stub fields
    entry_point: u64          # Entry point address
    stub_size: u32            # v1.1: Size of executable stub (0=pure SMF)
    smf_data_offset: u32      # v1.1: Offset where SMF data begins

    # Hashing (16 bytes)
    module_hash: u64          # Hash of module content
    source_hash: u64          # Hash of source files

    # Startup optimization hints (12 bytes)
    app_type: u8              # Application type (0=cli, 1=tui, 2=gui, 3=service, 4=repl)
    window_width: u16         # Window width hint (GUI apps)
    window_height: u16        # Window height hint (GUI apps)
    prefetch_hint: u8         # Prefetch hint: 0=no, 1=yes
    prefetch_file_count: u8   # Expected number of files to prefetch
    reserved_hints: [u8]      # 5 bytes reserved (Rust: reserved[5])

impl SmfHeader:
    # ========================================================================
    # Constructors
    # ========================================================================

    """Create a header stamped with the current format version (1.3)."""
    static fn new_v1_3(platform: Platform, arch: Arch) -> SmfHeader:
        var h = SmfHeader.new_v1_1(platform, arch)
        h.version_minor = SMF_VERSION_MINOR
        h

    """Create a header stamped v1.1 (legacy fixtures and the Rust seed's stamp).

    Args:
        platform: Target platform
        arch: Target architecture

    Returns:
        New SmfHeader with v1.1 defaults
    """
    static fn new_v1_1(platform: Platform, arch: Arch) -> SmfHeader:
        SmfHeader(
            magic: SMF_MAGIC,
            version_major: SMF_VERSION_MAJOR,
            version_minor: 1,
            platform: platform.to_u8(),
            arch: arch.to_u8(),
            flags: 0,
            compression: 0,
            compression_level: 0,
            reserved_compression: [0, 0],
            section_count: 0,
            section_table_offset: 0,
            symbol_table_offset: 0,
            symbol_count: 0,
            exported_count: 0,
            entry_point: 0,
            stub_size: 0,
            smf_data_offset: 0,
            module_hash: 0,
            source_hash: 0,
            app_type: 0,
            window_width: 1280,
            window_height: 720,
            prefetch_hint: 0,
            prefetch_file_count: 0,
            reserved_hints: [0, 0, 0, 0, 0]
        )

    # ========================================================================
    # Version Methods
    # ========================================================================

    """Get the version as (major, minor) tuple."""
    fn version() -> (u8, u8):
        (self.version_major, self.version_minor)

    """Check if this is a v1.0 header."""
    fn is_v1_0() -> bool:
        self.version_major == 1 and self.version_minor == 0

    """Check if this is a v1.1 header."""
    fn is_v1_1() -> bool:
        self.version_major == 1 and self.version_minor == 1

    # ========================================================================
    # Platform and Architecture Methods
    # ========================================================================

    """Get the platform from the header."""
    fn get_platform() -> Platform:
        Platform.from_u8(self.platform)

    """Set the platform in the header."""
    me set_platform(platform: Platform):
        self.platform = platform.to_u8()

    """Get the architecture from the header."""
    fn get_arch() -> Arch:
        Arch.from_u8(self.arch)

    """Set the architecture in the header."""
    me set_arch(arch: Arch):
        self.arch = arch.to_u8()

    # ========================================================================
    # Flag Methods
    # ========================================================================

    """Check if the SMF is executable."""
    fn is_executable() -> bool:
        (self.flags & SMF_FLAG_EXECUTABLE) != 0

    """Set the executable flag."""
    me set_executable(executable: bool):
        if executable:
            self.flags = self.flags | SMF_FLAG_EXECUTABLE
        else:
            self.flags = self.flags & (~SMF_FLAG_EXECUTABLE)

    """Check if the SMF is reloadable (hot-reload support)."""
    fn is_reloadable() -> bool:
        (self.flags & SMF_FLAG_RELOADABLE) != 0

    """Set the reloadable flag."""
    me set_reloadable(reloadable: bool):
        if reloadable:
            self.flags = self.flags | SMF_FLAG_RELOADABLE
        else:
            self.flags = self.flags & (~SMF_FLAG_RELOADABLE)

    """Check if the SMF has debug info."""
    fn has_debug_info() -> bool:
        (self.flags & SMF_FLAG_DEBUG_INFO) != 0

    """Set the debug info flag."""
    me set_debug_info(has_debug: bool):
        if has_debug:
            self.flags = self.flags | SMF_FLAG_DEBUG_INFO
        else:
            self.flags = self.flags & (~SMF_FLAG_DEBUG_INFO)

    """Check if the SMF is position-independent code (PIC)."""
    fn is_pic() -> bool:
        (self.flags & SMF_FLAG_PIC) != 0

    """Set the PIC flag."""
    me set_pic(pic: bool):
        if pic:
            self.flags = self.flags | SMF_FLAG_PIC
        else:
            self.flags = self.flags & (~SMF_FLAG_PIC)

    """Mark this image as an aspect-pack SMF."""
    """Check if the file carries an aspect-pack directory (provider container)."""
    fn is_aspect_pack() -> bool:
        (self.flags & SMF_FLAG_ASPECT_PACK) != 0

    """Check if relocation entries carry the 0xA2 source-section marker (v1.3)."""
    fn has_source_relocs() -> bool:
        (self.flags & SMF_FLAG_SOURCE_RELOCS) != 0

    me set_source_relocs(value: bool):
        if value:
            self.flags = self.flags | SMF_FLAG_SOURCE_RELOCS
        else:
            self.flags = self.flags & (~SMF_FLAG_SOURCE_RELOCS)

    me set_aspect_pack(value: bool):
        if value:
            self.flags = self.flags | SMF_FLAG_ASPECT_PACK
        else:
            self.flags = self.flags & (~SMF_FLAG_ASPECT_PACK)

    """Check if the file has an executable stub (v1.1+)."""
    fn has_stub() -> bool:
        (self.flags & SMF_FLAG_HAS_STUB) != 0

    # ========================================================================
    # Compression Methods (v1.1+)
    # ========================================================================

    """Check if sections are compressed (v1.1+)."""
    fn is_compressed() -> bool:
        self.compression != 0

    """Get the compression algorithm (v1.1+)."""
    fn get_compression() -> CompressionType:
        CompressionType.from_u8(self.compression)

    """Set compression settings (v1.1+).

    Args:
        compression: Compression algorithm
        level: Compression level (0=default, 1-22=specific level)
    """
    me set_compression(compression: CompressionType, level: u8):
        self.compression = compression.to_u8()
        self.compression_level = level

    # ========================================================================
    # Stub Methods (v1.1+)
    # ========================================================================

    """Get the stub size (v1.1+)."""
    fn get_stub_size() -> u32:
        self.stub_size

    """Get the SMF data offset (v1.1+)."""
    fn get_smf_data_offset() -> u32:
        self.smf_data_offset

    """Set stub information (v1.1+).

    Automatically sets the HAS_STUB flag if stub_size > 0.

    Args:
        stub_size: Size of the executable stub in bytes (0=pure SMF)
        smf_data_offset: Offset where SMF data begins
    """
    me set_stub_info(stub_size: u32, smf_data_offset: u32):
        self.stub_size = stub_size
        self.smf_data_offset = smf_data_offset
        if stub_size > 0:
            self.flags = self.flags | SMF_FLAG_HAS_STUB

    # ========================================================================
    # App Type and Hints Methods
    # ========================================================================

    """Get the application type from the header."""
    fn get_app_type() -> SmfAppType:
        SmfAppType.from_u8(self.app_type)

    """Set the application type in the header."""
    me set_app_type(app_type: SmfAppType):
        self.app_type = app_type.to_u8()

    """Set window hints for GUI applications.

    Args:
        width: Window width in pixels
        height: Window height in pixels
    """
    me set_window_hints(width: u16, height: u16):
        self.window_width = width
        self.window_height = height

    """Check if prefetching is recommended."""
    fn should_prefetch() -> bool:
        self.prefetch_hint != 0

    """Enable prefetching and set expected file count.

    Args:
        enabled: Whether prefetching is enabled
        file_count: Expected number of files to prefetch
    """
    me set_prefetch_hint(enabled: bool, file_count: u8):
        self.prefetch_hint = if enabled: 1 else: 0
        self.prefetch_file_count = file_count

    """Get the expected number of files to prefetch."""
    fn expected_prefetch_count() -> i64:
        self.prefetch_file_count as i64

    # ========================================================================
    # Serialization Methods
    # ========================================================================

    """Serialize the header in the v1.3 wire layout (exactly 96 bytes).

    Byte-identical to the Rust seed's #[repr(C)] struct: 4 zero padding bytes
    follow section_count (section_table_offset at 24), the hint block is
    re-aligned (app_type@80, window_width@82, window_height@84,
    prefetch_hint@86, prefetch_file_count@87, reserved_hints[5]@88) and the
    struct is zero padded to 96.
    """
    fn to_bytes() -> [u8]:
        var bytes: [u8] = self.leading_bytes()
        bytes = bytes + ([0, 0, 0, 0])
        bytes = bytes + (self.offset_bytes())
        bytes.push(self.app_type)
        bytes.push(0)
        bytes = bytes + (self.hint_bytes())
        while bytes.len() < SMF_HEADER_SIZE:
            bytes.push(0)
        bytes

    """Serialize in the legacy v1.0-v1.2 packed layout (exactly 128 bytes).

    Read-only fixtures for the packed reader; no writer emits this layout.
    Bytes 88..128 (the old reserved area, including the compile-options
    slot at 88..104) are zero. TODO(smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10):
    delete with the packed reader after one release.
    """
    fn to_packed_bytes() -> [u8]:
        var bytes: [u8] = self.leading_bytes()
        bytes = bytes + (self.offset_bytes())
        bytes.push(self.app_type)
        bytes = bytes + (self.hint_bytes())
        while bytes.len() < SMF_PACKED_HEADER_SIZE:
            bytes.push(0)
        bytes

    # Bytes 0..20: layout-independent prefix.
    fn leading_bytes() -> [u8]:
        var bytes: [u8] = []
        bytes = bytes + (self.magic)
        bytes.push(self.version_major)
        bytes.push(self.version_minor)
        bytes.push(self.platform)
        bytes.push(self.arch)
        bytes = bytes + (u32_to_bytes(self.flags))
        bytes.push(self.compression)
        bytes.push(self.compression_level)
        bytes = bytes + (self.reserved_compression)
        bytes + (u32_to_bytes(self.section_count))

    # section_table_offset .. source_hash (56 bytes, same order in both layouts).
    fn offset_bytes() -> [u8]:
        var bytes: [u8] = []
        bytes = bytes + (u64_to_bytes(self.section_table_offset))
        bytes = bytes + (u64_to_bytes(self.symbol_table_offset))
        bytes = bytes + (u32_to_bytes(self.symbol_count))
        bytes = bytes + (u32_to_bytes(self.exported_count))
        bytes = bytes + (u64_to_bytes(self.entry_point))
        bytes = bytes + (u32_to_bytes(self.stub_size))
        bytes = bytes + (u32_to_bytes(self.smf_data_offset))
        bytes = bytes + (u64_to_bytes(self.module_hash))
        bytes + (u64_to_bytes(self.source_hash))

    # window_width .. reserved_hints (11 bytes, follows app_type).
    fn hint_bytes() -> [u8]:
        var bytes: [u8] = []
        bytes = bytes + (u16_to_bytes(self.window_width))
        bytes = bytes + (u16_to_bytes(self.window_height))
        bytes.push(self.prefetch_hint)
        bytes.push(self.prefetch_file_count)
        bytes + (self.reserved_hints)

# ============================================================================
# Helper Functions
# ============================================================================

"""Convert u16 to bytes (little-endian)."""
fn u16_to_bytes(value: u16) -> [u8]:
    val b0 = (value & 0xFF) as u8
    val b1 = ((value >> 8) & 0xFF) as u8
    [b0, b1]

"""Convert u32 to bytes (little-endian)."""
fn u32_to_bytes(value: u32) -> [u8]:
    val b0 = (value & 0xFF) as u8
    val b1 = ((value >> 8) & 0xFF) as u8
    val b2 = ((value >> 16) & 0xFF) as u8
    val b3 = ((value >> 24) & 0xFF) as u8
    [b0, b1, b2, b3]

"""Convert u64 to bytes (little-endian)."""
fn u64_to_bytes(value: u64) -> [u8]:
    val b0 = (value & 0xFF) as u8
    val b1 = ((value >> 8) & 0xFF) as u8
    val b2 = ((value >> 16) & 0xFF) as u8
    val b3 = ((value >> 24) & 0xFF) as u8
    val b4 = ((value >> 32) & 0xFF) as u8
    val b5 = ((value >> 40) & 0xFF) as u8
    val b6 = ((value >> 48) & 0xFF) as u8
    val b7 = ((value >> 56) & 0xFF) as u8
    [b0, b1, b2, b3, b4, b5, b6, b7]

fn smf_header_has_magic_at(bytes: [u8], start: i64) -> bool:
    start >= 0 and bytes.len() >= start + 4 and bytes[start] == 83 and bytes[start + 1] == 77 and bytes[start + 2] == 70 and bytes[start + 3] == 0

"""Size of the 96-byte repr(C) layout; alias of SMF_HEADER_SIZE kept for the
readers converged in #6907/#6928 (src/compiler_rust/common/src/smf/header.rs)."""
pub val SMF_SEED_HEADER_SIZE: i64 = SMF_HEADER_SIZE

"""True when the header at `start` uses the 96-byte repr(C) layout.

A v1.3 (or later) stamp is authoritative: no packed-layout file ever carried
version_minor >= 3. Rust-seed-written files are stamped 1.1 and are told apart
from legacy packed files by shape: the seed's 20..24 is alignment padding
(zero) with section_table_offset (>= header size) at 24, while the packed
layout puts section_table_offset's low word at 20.
"""
fn smf_header_seed_shaped_at(bytes: [u8], start: i64) -> bool:
    if not smf_header_has_magic_at(bytes, start) or bytes.len() < start + SMF_HEADER_SIZE:
        return false
    if (bytes[start + 4] as i64) == (SMF_VERSION_MAJOR as i64) and (bytes[start + 5] as i64) >= (SMF_VERSION_MINOR as i64):
        return true
    # TODO(smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10): the rest
    # of this function is the packed-vs-seed heuristic; delete it with the
    # packed reader after one release (keep only the version stamp).
    # A header whose packed 128-byte extent ends exactly at EOF is the packed
    # trailer; a seed trailer sits at EOF-96. Without this, a packed header whose
    # section_table_offset is 0 (padding word 0) is mistaken for a seed header.
    if start + SMF_PACKED_HEADER_SIZE == bytes.len():
        return false
    val section_count = bytes_to_u32_le_header(bytes, start + 16)
    val padding = bytes_to_u32_le_header(bytes, start + 20)
    val seed_section_table = bytes_to_u64_le_header(bytes, start + 24)
    section_count > 0 and padding == 0 and seed_section_table != 0

"""Field shift of the header at `start`: 4 for the 96-byte repr(C) layout, 0 for legacy packed."""
pub fn smf_header_field_shift(bytes: [u8], start: i64) -> i64:
    if smf_header_seed_shaped_at(bytes, start):
        return 4
    0

"""Header byte size of the header at `start`: 96 for the repr(C) layout, 128 for legacy packed."""
pub fn smf_header_size_at(bytes: [u8], start: i64) -> i64:
    if smf_header_seed_shaped_at(bytes, start):
        return SMF_HEADER_SIZE
    SMF_PACKED_HEADER_SIZE

"""Start of a 96-byte-layout trailer header at EOF-96, or -1 (no precedence)."""
pub fn smf_header_seed_trailer_offset(bytes: [u8]) -> i64:
    if bytes.len() < SMF_HEADER_SIZE:
        return -1
    val start = bytes.len() - SMF_HEADER_SIZE
    if smf_header_seed_shaped_at(bytes, start):
        return start
    -1

"""Start of the trailer header, or -1. One precedence for every reader:

1. a v1.3-stamped header at EOF-96 (unambiguous: the current writers' layout);
2. legacy packed magic at EOF-128;
3. a seed-shaped (Rust-written 1.1) header at EOF-96.

Readers add `smf_header_field_shift(bytes, start)` to every field offset >= 20
and use `smf_header_size_at` for header-overlap checks.
"""
pub fn smf_header_trailer_offset(bytes: [u8]) -> i64:
    if bytes.len() < SMF_HEADER_SIZE:
        return -1
    val seed = bytes.len() - SMF_HEADER_SIZE
    if smf_header_has_magic_at(bytes, seed) and (bytes[seed + 4] as i64) == (SMF_VERSION_MAJOR as i64) and (bytes[seed + 5] as i64) >= (SMF_VERSION_MINOR as i64):
        return seed
    if bytes.len() >= SMF_PACKED_HEADER_SIZE and smf_header_has_magic_at(bytes, bytes.len() - SMF_PACKED_HEADER_SIZE):
        return bytes.len() - SMF_PACKED_HEADER_SIZE
    smf_header_seed_trailer_offset(bytes)

"""Start of the header: a leading header at 0, else the trailer; -1 when none."""
pub fn smf_header_locate(bytes: [u8]) -> i64:
    if bytes.len() < SMF_HEADER_SIZE:
        return -1
    if smf_header_has_magic_at(bytes, 0):
        if bytes.len() >= SMF_PACKED_HEADER_SIZE or smf_header_seed_shaped_at(bytes, 0):
            return 0
        return -1
    smf_header_trailer_offset(bytes)

fn smf_header_offset(bytes: [u8]) -> Result<i64, text>:
    if bytes.len() < SMF_HEADER_SIZE:
        return Err("Not enough data for SMF header")
    val start = smf_header_locate(bytes)
    if start < 0:
        if smf_header_has_magic_at(bytes, 0):
            return Err("Not enough data for SMF header")
        return Err("Invalid SMF magic: expected 'SMF\0'")
    Ok(start)

fn bytes_to_u16_le(bytes: [u8], start: i64) -> u16:
    ((bytes[start] as u16) | ((bytes[start + 1] as u16) << 8))

fn bytes_to_u32_le_header(bytes: [u8], start: i64) -> u32:
    ((bytes[start] as u32) |
        ((bytes[start + 1] as u32) << 8) |
        ((bytes[start + 2] as u32) << 16) |
        ((bytes[start + 3] as u32) << 24))

fn bytes_to_u64_le_header(bytes: [u8], start: i64) -> u64:
    ((bytes[start] as u64) |
        ((bytes[start + 1] as u64) << 8) |
        ((bytes[start + 2] as u64) << 16) |
        ((bytes[start + 3] as u64) << 24) |
        ((bytes[start + 4] as u64) << 32) |
        ((bytes[start + 5] as u64) << 40) |
        ((bytes[start + 6] as u64) << 48) |
        ((bytes[start + 7] as u64) << 56))

fn smf_header_from_bytes(bytes: [u8]) -> Result<SmfHeader, text>:
    val offset = smf_header_offset(bytes)?
    val shift = smf_header_field_shift(bytes, offset)
    val o = offset + shift
    # Hint block: legacy packed app_type@76 ww@77 wh@79 ph@81 pfc@82 hints[5]@83;
    # repr(C) app_type@80 ww@82 wh@84 ph@86 pfc@87 reserved[5]@88.
    val h_app = if shift == 0: offset + 76 else: offset + 80
    val h_ww = if shift == 0: offset + 77 else: offset + 82
    val h_wh = if shift == 0: offset + 79 else: offset + 84
    val h_ph = if shift == 0: offset + 81 else: offset + 86
    val h_pfc = if shift == 0: offset + 82 else: offset + 87
    val h_res = if shift == 0: offset + 83 else: offset + 88
    Ok(SmfHeader(
        magic: [bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]],
        version_major: bytes[offset + 4],
        version_minor: bytes[offset + 5],
        platform: bytes[offset + 6],
        arch: bytes[offset + 7],
        flags: bytes_to_u32_le_header(bytes, offset + 8),
        compression: bytes[offset + 12],
        compression_level: bytes[offset + 13],
        reserved_compression: [bytes[offset + 14], bytes[offset + 15]],
        section_count: bytes_to_u32_le_header(bytes, offset + 16),
        section_table_offset: bytes_to_u64_le_header(bytes, o + 20),
        symbol_table_offset: bytes_to_u64_le_header(bytes, o + 28),
        symbol_count: bytes_to_u32_le_header(bytes, o + 36),
        exported_count: bytes_to_u32_le_header(bytes, o + 40),
        entry_point: bytes_to_u64_le_header(bytes, o + 44),
        stub_size: bytes_to_u32_le_header(bytes, o + 52),
        smf_data_offset: bytes_to_u32_le_header(bytes, o + 56),
        module_hash: bytes_to_u64_le_header(bytes, o + 60),
        source_hash: bytes_to_u64_le_header(bytes, o + 68),
        app_type: bytes[h_app],
        window_width: bytes_to_u16_le(bytes, h_ww),
        window_height: bytes_to_u16_le(bytes, h_wh),
        prefetch_hint: bytes[h_ph],
        prefetch_file_count: bytes[h_pfc],
        reserved_hints: [bytes[h_res], bytes[h_res + 1], bytes[h_res + 2], bytes[h_res + 3], bytes[h_res + 4]]
    ))

export SMF_MAGIC, SMF_HEADER_SIZE, SMF_PACKED_HEADER_SIZE, SMF_SEED_HEADER_SIZE, SMF_VERSION_MAJOR, SMF_VERSION_MINOR
export SMF_FLAG_EXECUTABLE, SMF_FLAG_RELOADABLE, SMF_FLAG_DEBUG_INFO, SMF_FLAG_PIC, SMF_FLAG_HAS_STUB, SMF_FLAG_ASPECT_PACK, SMF_FLAG_SOURCE_RELOCS
export u16_to_bytes, u32_to_bytes, u64_to_bytes, smf_header_from_bytes, smf_header_field_shift, smf_header_size_at, smf_header_seed_trailer_offset, smf_header_trailer_offset, smf_header_locate
