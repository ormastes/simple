"""Fail-closed classification of linker memory-accounting evidence."""

use std.common.linker.link_receipt_v1.{LinkAccountingClassV1}
use std.common.perf.execution_metrics.{ResourceUsage, ResourceEvidenceQuality}

pub struct LinkAccountingObservationV1:
    accounting_class: LinkAccountingClassV1
    measured_peak_bytes: u64
    admitted_limit_bytes: u64
    certified_under_limit: bool

pub fn link_accounting_observation_v1(usage: ResourceUsage, admitted_limit_bytes: u64) -> LinkAccountingObservationV1:
    if usage.peak_tree_charge_bytes < 0 or usage.evidence_quality == ResourceEvidenceQuality.Unavailable:
        return LinkAccountingObservationV1(
            accounting_class: LinkAccountingClassV1.NotCertified,
            measured_peak_bytes: 0,
            admitted_limit_bytes: admitted_limit_bytes,
            certified_under_limit: false,
        )

    val peak = usage.peak_tree_charge_bytes.to_u64()
    if usage.evidence_quality == ResourceEvidenceQuality.ExactTree and admitted_limit_bytes > 0:
        return LinkAccountingObservationV1(
            accounting_class: LinkAccountingClassV1.QualifiedJobScope,
            measured_peak_bytes: peak,
            admitted_limit_bytes: admitted_limit_bytes,
            certified_under_limit: peak < admitted_limit_bytes,
        )

    LinkAccountingObservationV1(
        accounting_class: LinkAccountingClassV1.MeasuredOnly,
        measured_peak_bytes: peak,
        admitted_limit_bytes: admitted_limit_bytes,
        certified_under_limit: false,
    )
