# Native-link success identity travels with the completed execution result.
# No environment reads, engine probes, or mutable last-engine state.
use compiler.backend.linker.source_region_link_types_v1.{SourceRegionFinalLinkSealV1, SourceRegionLinkExecutionV1}

struct NativeLinkSuccessV1:
    output: text
    # cc identifies the C-driver execution route (including Clang/MinGW),
    # not a claim about the driver's downstream linker or certification.
    engine_id: text
    source_region_seal_v1: SourceRegionFinalLinkSealV1? = nil
    source_region_execution_v1: SourceRegionLinkExecutionV1? = nil

fn native_link_attach_source_seal_v1(result: NativeLinkSuccessV1, seal: SourceRegionFinalLinkSealV1) -> NativeLinkSuccessV1:
    NativeLinkSuccessV1(output: result.output, engine_id: result.engine_id,
        source_region_seal_v1: Some(seal), source_region_execution_v1: result.source_region_execution_v1)

fn native_link_attach_source_execution_v1(result: NativeLinkSuccessV1, execution: SourceRegionLinkExecutionV1) -> NativeLinkSuccessV1:
    NativeLinkSuccessV1(output: result.output, engine_id: result.engine_id,
        source_region_execution_v1: Some(execution))

fn native_link_source_output_v1(result: NativeLinkSuccessV1, output: text) -> NativeLinkSuccessV1:
    NativeLinkSuccessV1(output: output, engine_id: result.engine_id,
        source_region_seal_v1: result.source_region_seal_v1,
        source_region_execution_v1: result.source_region_execution_v1)

fn native_link_success_v1(result: Result<text, text>, engine_id: text) -> Result<NativeLinkSuccessV1, text>:
    """Attach the identity known by the route that actually completed.

    Failed execution stays an error; it cannot manufacture success evidence.
    """
    if result.is_err(): return Err(result.unwrap_err())
    Ok(NativeLinkSuccessV1(output: result.unwrap(), engine_id: engine_id))

fn native_link_output_v1(result: Result<NativeLinkSuccessV1, text>) -> Result<text, text>:
    """Preserve the historical output-path-or-error linking API."""
    if result.is_err(): return Err(result.unwrap_err())
    if val seal = result.unwrap().source_region_seal_v1:
        val _closed = seal.file.close()
        return Err("SOURCE-LINK-SEAL: path-only API cannot discard retained final-link authority")
    Ok(result.unwrap().output)

fn native_link_engine_id_for_path_v1(path: text) -> text:
    """Name a known executed tool; preserve unknown paths without guessing."""
    val parts = path.replace("\\", "/").split("/")
    val basename = parts[parts.len() - 1].lower()
    if basename == "mold" or basename == "mold.exe": return "mold"
    if basename == "ld.lld" or basename == "ld.lld.exe": return "ld.lld"
    if basename == "lld-link" or basename == "lld-link.exe": return "lld-link"
    if basename == "link.exe": return "link.exe"
    if basename == "ld" or basename == "ld.exe": return "ld"
    path

export NativeLinkSuccessV1
export native_link_success_v1, native_link_output_v1, native_link_engine_id_for_path_v1
