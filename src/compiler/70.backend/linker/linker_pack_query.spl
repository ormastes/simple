"""Pure provider query contract, separate from exported native ABI symbols."""
use std.nogc_sync_mut.composition.provider_contract.{
    SimpleProviderQueryV1, SimpleProviderQueryResultV1, SIMPLE_PROVIDER_OK, SIMPLE_PROVIDER_DESCRIPTOR_TOO_SHORT,
    SIMPLE_PROVIDER_NOT_PROCESS_CALLABLE, SIMPLE_PROVIDER_INTERFACE_UNKNOWN,
    SIMPLE_PROVIDER_MAJOR_UNSUPPORTED, SIMPLE_PROVIDER_MINOR_UNSUPPORTED,
    SIMPLE_CLI_COMMAND_V1_INTERFACE, SIMPLE_CLI_COMMAND_V1_MAJOR, SIMPLE_CLI_COMMAND_V1_MINOR,
    simple_provider_query_error_v1, simple_provider_digest_from_hex_v1
}

pub const LINKER_PACK_ABI_DIGEST: text = "f0d207492d516366fbc3a6e609a971f7812d1c17ac833a104d8f8d05ef0e3684"
pub const LINKER_PACK_INTERFACE: u64 = 1279872587
pub const LINKER_PACK_CONTEXT: u64 = 1

pub fn linker_pack_query_result(query: SimpleProviderQueryV1) -> SimpleProviderQueryResultV1:
    var status = SIMPLE_PROVIDER_OK
    if query.descriptor_size < 44: status = SIMPLE_PROVIDER_DESCRIPTOR_TOO_SHORT
    elif query.interface_id != SIMPLE_CLI_COMMAND_V1_INTERFACE: status = SIMPLE_PROVIDER_INTERFACE_UNKNOWN
    elif query.minimum_major != SIMPLE_CLI_COMMAND_V1_MAJOR: status = SIMPLE_PROVIDER_MAJOR_UNSUPPORTED
    elif query.minimum_minor > SIMPLE_CLI_COMMAND_V1_MINOR: status = SIMPLE_PROVIDER_MINOR_UNSUPPORTED
    elif query.host_abi != 1 or query.target_offset != 0 or query.target_length != 0:
        status = SIMPLE_PROVIDER_NOT_PROCESS_CALLABLE
    if status != SIMPLE_PROVIDER_OK: return simple_provider_query_error_v1(status)
    SimpleProviderQueryResultV1(status: status, provided_major: SIMPLE_CLI_COMMAND_V1_MAJOR,
        provided_minor: SIMPLE_CLI_COMMAND_V1_MINOR, descriptor_size: 28,
        interface_handle: LINKER_PACK_INTERFACE, provider_context: LINKER_PACK_CONTEXT,
        provider_identity_digest: 0, implementation_digest: 0,
        abi_digest: simple_provider_digest_from_hex_v1(LINKER_PACK_ABI_DIGEST))

export LINKER_PACK_ABI_DIGEST, LINKER_PACK_INTERFACE, LINKER_PACK_CONTEXT, linker_pack_query_result
