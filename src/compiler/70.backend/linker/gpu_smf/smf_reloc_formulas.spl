# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_reloc_formulas.spl — L8 relocation
# CPU oracle: pure i64 formula functions (link_manager wave 7, Lane RELOC)
#
# Pure value computation ONLY — no memory writes, no byte patching. These are
# the CPU-oracle formulas the GPU L8 relocation stage will be verified
# against (.spipe/link_manager/hybrid_batch_notes.md, L8 groundwork).
#
# Variant -> formula table (frozen; one row per RelocationType variant,
# src/compiler/70.backend/linker/smf_writer.spl:106-111, wire byte values
# smf_writer.spl:113-121 and _SmfReaderMemory/header_parser.spl:336):
#
#   Variant   | Wire | Formula   | Width check          | Source
#   ----------+------+-----------+----------------------+---------------------
#   Abs64     |  1   | S + A     | none (full i64)      | SysV x86-64 psABI
#             |      |           |                      | R_X86_64_64 "S + A";
#             |      |           |                      | reloc_engine.spl:14,
#             |      |           |                      | :140-141 (DEAD code,
#             |      |           |                      | reference only)
#   Rel32     |  2   | S + A - P | signed 32-bit        | psABI R_X86_64_PC32
#             |      |           | [-2^31, 2^31 - 1]    | "S + A - P";
#             |      |           |                      | reloc_engine.spl:15,
#             |      |           |                      | :144-145 (DEAD)
#   PltRel32  |  3   | S + A - P | signed 32-bit        | psABI R_X86_64_PLT32
#             |      |           | [-2^31, 2^31 - 1]    | "L + A - P"; L == S
#             |      |           |                      | for static SMF links
#             |      |           |                      | (reloc_engine.spl:17
#             |      |           |                      | note, :144-145, DEAD)
#   GotRel32  |  4   | G + A - P | signed 32-bit        | psABI R_X86_64_
#             |      | (S == G,  | [-2^31, 2^31 - 1]    | GOTPCREL "G + GOT +
#             |      | the GOT-  |                      | A - P"; caller MUST
#             |      | entry     |                      | pass s = GOT-entry
#             |      | address,  |                      | address, never the
#             |      | never the |                      | symbol's own address
#             |      | symbol's  |                      | — reloc_engine.spl's
#             |      | address)  |                      | R_X86_64_GOTPCREL case
#             |      |           |                      | now routes here (live)
#
#   PINNED WIRE-4 RULE (design §4, doc/08_tracking/bug/
#   smf_gotrel32_applied_as_symbol_value_2026-09-18.md): `80.driver/
#   smf_elf_parser.spl:246` maps LLVM R_X86_64_GOTPCREL to this wire value.
#   A GOTPCREL site loads *through* a GOT slot, so `s` in the formula above
#   is the address of that slot (S == G), not the symbol's address — the two
#   are architecturally distinct memory locations. Both live loaders
#   (`99.loader/module_loader_compat.spl:1324-1370`,
#   `os/smf/smf_dynlib.spl:759`) currently pass the symbol's own address
#   instead, which is the open defect the bug doc and
#   `T/compiler/loader/loader_reloc_wire4_spec.spl` (lane A4a, in-development
#   until A4b) pin. This oracle's `s` parameter contract does not change —
#   only callers must be fixed to supply the right address.
#   Abs32     |  5   | S + A     | unsigned 32-bit      | psABI R_X86_64_32
#             |      |           | [0, 2^32 - 1]        | "S + A" zero-extended;
#             |      |           |                      | reloc_engine.spl:18
#             |      |           |                      | comments "truncated
#             |      |           |                      | u32" (DEAD)
#
# reloc_engine.spl (dead code — no caller wires it into a live link path yet,
# see lane A4a) now calls smf_reloc_compute directly for its S+A / S+A-P
# formulas and adopted reject semantics: it used to silently mask
# (`v & 0xffffffff`) on R_X86_64_32 overflow; it now rejects (ok: false) via
# this oracle instead, matching the rule below — silent truncation is
# exactly the class of defect the GPU/CPU L8 comparison must surface, so the
# oracle must never hide it. smf_writer.spl still only records
# SmfRelocation entries (smf_writer.spl:148-152, :215-216); it does not
# apply them.
# ============================================================================

use compiler.backend.linker.smf_writer.{RelocationType}

# ----------------------------------------------------------------------------
# Result record
# ----------------------------------------------------------------------------

struct SmfRelocValue:
    ok: bool
    value: i64

# ----------------------------------------------------------------------------
# Width bounds
# ----------------------------------------------------------------------------

val SMF_RELOC_I32_MIN: i64 = -2147483648
val SMF_RELOC_I32_MAX: i64 = 2147483647
val SMF_RELOC_U32_MAX: i64 = 4294967295

fn smf_reloc_fits_i32(v: i64) -> bool:
    (v >= SMF_RELOC_I32_MIN) and (v <= SMF_RELOC_I32_MAX)

fn smf_reloc_fits_u32(v: i64) -> bool:
    (v >= 0) and (v <= SMF_RELOC_U32_MAX)

fn smf_reloc_checked_i32(v: i64) -> SmfRelocValue:
    """Accept v only if it fits a signed 32-bit field; never truncate."""
    if smf_reloc_fits_i32(v):
        SmfRelocValue(ok: true, value: v)
    else:
        SmfRelocValue(ok: false, value: 0)

fn smf_reloc_checked_u32(v: i64) -> SmfRelocValue:
    """Accept v only if it fits an unsigned 32-bit field; never truncate."""
    if smf_reloc_fits_u32(v):
        SmfRelocValue(ok: true, value: v)
    else:
        SmfRelocValue(ok: false, value: 0)

# ----------------------------------------------------------------------------
# Per-variant formula computation (total over RelocationType)
# ----------------------------------------------------------------------------

fn smf_reloc_compute(reloc_type: RelocationType, s: i64, a: i64, p: i64) -> SmfRelocValue:
    """Compute the relocation value for one SmfRelocation.

    s = resolved symbol address (for GotRel32: the GOT-entry address),
    a = addend, p = address of the relocated field (place). Pure value
    computation; the caller owns any byte patching. Out-of-width results
    reject with ok: false — never silently truncated."""
    match reloc_type:
        case Abs64:
            SmfRelocValue(ok: true, value: s + a)
        case Rel32:
            smf_reloc_checked_i32(s + a - p)
        case PltRel32:
            smf_reloc_checked_i32(s + a - p)
        case GotRel32:
            smf_reloc_checked_i32(s + a - p)
        case Abs32:
            smf_reloc_checked_u32(s + a)

# ----------------------------------------------------------------------------
# Wire-code entry point (rejects unknown/invalid codes)
# ----------------------------------------------------------------------------

fn smf_reloc_compute_wire(wire: i64, s: i64, a: i64, p: i64) -> SmfRelocValue:
    """As smf_reloc_compute but keyed by the SMF wire byte value
    (smf_writer.spl:113-121). Unknown or invalid wire codes reject with
    ok: false rather than defaulting to any formula."""
    if wire == 1:
        smf_reloc_compute(RelocationType.Abs64, s, a, p)
    elif wire == 2:
        smf_reloc_compute(RelocationType.Rel32, s, a, p)
    elif wire == 3:
        smf_reloc_compute(RelocationType.PltRel32, s, a, p)
    elif wire == 4:
        smf_reloc_compute(RelocationType.GotRel32, s, a, p)
    elif wire == 5:
        smf_reloc_compute(RelocationType.Abs32, s, a, p)
    else:
        SmfRelocValue(ok: false, value: 0)

# ============================================================================
# COFF / PE x86_64 value oracle (lane E1)
# ============================================================================
# Same contract as smf_reloc_compute above: pure value computation, reject
# never mask, total over the type space (design D4). Sources: PE/COFF
# specification section 5.2.2 "Type Indicators" (x64 processors) and the
# `IMAGE_REL_AMD64_*` names in winnt.h.
#
# The one COFF fact that makes these NOT reusable as the ELF/SMF rows above:
# a COFF relocation carries no explicit addend. `a` is the value already
# stored in the relocated field, and for the RIP-relative family the
# instruction-length bias is NOT pre-baked into it — x64 RIP addressing is
# relative to the END of the instruction, so the formula must subtract the
# 4-byte displacement itself plus the N trailing immediate bytes:
#
#   Type      | Code | Formula                | Field | Width check
#   ----------+------+------------------------+-------+---------------
#   ABSOLUTE  | 0x00 | (no write)             |  0    | none
#   ADDR64    | 0x01 | S + A                  |  8    | none (full i64)
#   ADDR32    | 0x02 | S + A (32-bit VA)      |  4    | REJECTED by name
#   ADDR32NB  | 0x03 | S + A - ImageBase      |  4    | unsigned 32-bit
#   REL32     | 0x04 | S + A - P - 4          |  4    | signed 32-bit
#   REL32_1   | 0x05 | S + A - P - 5          |  4    | signed 32-bit
#   REL32_2   | 0x06 | S + A - P - 6          |  4    | signed 32-bit
#   REL32_3   | 0x07 | S + A - P - 7          |  4    | signed 32-bit
#   REL32_4   | 0x08 | S + A - P - 8          |  4    | signed 32-bit
#   REL32_5   | 0x09 | S + A - P - 9          |  4    | signed 32-bit
#   SECTION   | 0x0a | 1-based out sec index  |  2    | unsigned 16-bit
#   SECREL    | 0x0b | S + A - SectionVA      |  4    | unsigned 32-bit
#   SECREL7   | 0x0c | —                      |  —    | REJECTED by name
#   TOKEN     | 0x0d | —                      |  —    | REJECTED by name
#   SREL32    | 0x0e | —                      |  —    | REJECTED by name
#   PAIR      | 0x0f | —                      |  —    | REJECTED by name
#   SSPAN32   | 0x10 | —                      |  —    | REJECTED by name
#
# S and P are full virtual addresses (ImageBase + RVA), matching the ELF
# convention above, so a caller never mixes RVA and VA in one formula.
#
# ADDR32 is rejected rather than implemented: it stores an absolute 32-bit VA,
# which cannot represent the default x64 image base 0x140000000. lld-link only
# accepts it under /highentropyva:no with a sub-4 GiB base, a mode this lane
# does not model — so it is a named Err, not a silent success (design D4).

val IMAGE_REL_AMD64_ABSOLUTE: i64 = 0x0000
val IMAGE_REL_AMD64_ADDR64: i64   = 0x0001
val IMAGE_REL_AMD64_ADDR32: i64   = 0x0002
val IMAGE_REL_AMD64_ADDR32NB: i64 = 0x0003
val IMAGE_REL_AMD64_REL32: i64    = 0x0004
val IMAGE_REL_AMD64_REL32_1: i64  = 0x0005
val IMAGE_REL_AMD64_REL32_2: i64  = 0x0006
val IMAGE_REL_AMD64_REL32_3: i64  = 0x0007
val IMAGE_REL_AMD64_REL32_4: i64  = 0x0008
val IMAGE_REL_AMD64_REL32_5: i64  = 0x0009
val IMAGE_REL_AMD64_SECTION: i64  = 0x000a
val IMAGE_REL_AMD64_SECREL: i64   = 0x000b
val IMAGE_REL_AMD64_SECREL7: i64  = 0x000c
val IMAGE_REL_AMD64_TOKEN: i64    = 0x000d
val IMAGE_REL_AMD64_SREL32: i64   = 0x000e
val IMAGE_REL_AMD64_PAIR: i64     = 0x000f
val IMAGE_REL_AMD64_SSPAN32: i64  = 0x0010

val COFF_RELOC_U16_MAX: i64 = 65535

struct CoffRelocValue:
    """ok = the value may be written; value = what to write; width = how many
    bytes (0 = write nothing); err = the type name when ok is false."""
    ok: bool
    value: i64
    width: i64
    err: text

fn coff_reloc_type_name(rtype: i64) -> text:
    if rtype == IMAGE_REL_AMD64_ABSOLUTE:
        "IMAGE_REL_AMD64_ABSOLUTE"
    elif rtype == IMAGE_REL_AMD64_ADDR64:
        "IMAGE_REL_AMD64_ADDR64"
    elif rtype == IMAGE_REL_AMD64_ADDR32:
        "IMAGE_REL_AMD64_ADDR32"
    elif rtype == IMAGE_REL_AMD64_ADDR32NB:
        "IMAGE_REL_AMD64_ADDR32NB"
    elif rtype == IMAGE_REL_AMD64_REL32:
        "IMAGE_REL_AMD64_REL32"
    elif rtype == IMAGE_REL_AMD64_REL32_1:
        "IMAGE_REL_AMD64_REL32_1"
    elif rtype == IMAGE_REL_AMD64_REL32_2:
        "IMAGE_REL_AMD64_REL32_2"
    elif rtype == IMAGE_REL_AMD64_REL32_3:
        "IMAGE_REL_AMD64_REL32_3"
    elif rtype == IMAGE_REL_AMD64_REL32_4:
        "IMAGE_REL_AMD64_REL32_4"
    elif rtype == IMAGE_REL_AMD64_REL32_5:
        "IMAGE_REL_AMD64_REL32_5"
    elif rtype == IMAGE_REL_AMD64_SECTION:
        "IMAGE_REL_AMD64_SECTION"
    elif rtype == IMAGE_REL_AMD64_SECREL:
        "IMAGE_REL_AMD64_SECREL"
    elif rtype == IMAGE_REL_AMD64_SECREL7:
        "IMAGE_REL_AMD64_SECREL7"
    elif rtype == IMAGE_REL_AMD64_TOKEN:
        "IMAGE_REL_AMD64_TOKEN"
    elif rtype == IMAGE_REL_AMD64_SREL32:
        "IMAGE_REL_AMD64_SREL32"
    elif rtype == IMAGE_REL_AMD64_PAIR:
        "IMAGE_REL_AMD64_PAIR"
    elif rtype == IMAGE_REL_AMD64_SSPAN32:
        "IMAGE_REL_AMD64_SSPAN32"
    else:
        "IMAGE_REL_AMD64_UNKNOWN_{rtype}"

fn coff_reloc_reject(rtype: i64) -> CoffRelocValue:
    CoffRelocValue(ok: false, value: 0, width: 0, err: coff_reloc_type_name(rtype))

fn coff_reloc_rel32(rtype: i64, s: i64, a: i64, p: i64, bias: i64) -> CoffRelocValue:
    """S + A - P - bias, checked against a signed 32-bit field."""
    val r = smf_reloc_checked_i32(s + a - p - bias)
    if r.ok:
        CoffRelocValue(ok: true, value: r.value, width: 4, err: "")
    else:
        CoffRelocValue(ok: false, value: 0, width: 4, err: coff_reloc_type_name(rtype))

fn coff_reloc_compute(rtype: i64, s: i64, a: i64, p: i64, image_base: i64, sec_va: i64, sec_index: i64) -> CoffRelocValue:
    """Compute one IMAGE_REL_AMD64_* relocation value.

    s = resolved symbol virtual address, a = the value already in the field
    (COFF carries no explicit addend), p = virtual address of the field,
    image_base = the output image base, sec_va = virtual address of the
    output section the TARGET symbol lands in, sec_index = that section's
    1-based index in the output section table. Out-of-width or unmodelled
    results reject with ok: false and a named err — never truncated, never
    silently defaulted to another formula."""
    if rtype == IMAGE_REL_AMD64_ABSOLUTE:
        return CoffRelocValue(ok: true, value: 0, width: 0, err: "")
    if rtype == IMAGE_REL_AMD64_ADDR64:
        return CoffRelocValue(ok: true, value: s + a, width: 8, err: "")
    if rtype == IMAGE_REL_AMD64_ADDR32NB:
        val nb = smf_reloc_checked_u32(s + a - image_base)
        if nb.ok:
            return CoffRelocValue(ok: true, value: nb.value, width: 4, err: "")
        return CoffRelocValue(ok: false, value: 0, width: 4, err: coff_reloc_type_name(rtype))
    if rtype == IMAGE_REL_AMD64_REL32:
        return coff_reloc_rel32(rtype, s, a, p, 4)
    if rtype == IMAGE_REL_AMD64_REL32_1:
        return coff_reloc_rel32(rtype, s, a, p, 5)
    if rtype == IMAGE_REL_AMD64_REL32_2:
        return coff_reloc_rel32(rtype, s, a, p, 6)
    if rtype == IMAGE_REL_AMD64_REL32_3:
        return coff_reloc_rel32(rtype, s, a, p, 7)
    if rtype == IMAGE_REL_AMD64_REL32_4:
        return coff_reloc_rel32(rtype, s, a, p, 8)
    if rtype == IMAGE_REL_AMD64_REL32_5:
        return coff_reloc_rel32(rtype, s, a, p, 9)
    if rtype == IMAGE_REL_AMD64_SECREL:
        val sr = smf_reloc_checked_u32(s + a - sec_va)
        if sr.ok:
            return CoffRelocValue(ok: true, value: sr.value, width: 4, err: "")
        return CoffRelocValue(ok: false, value: 0, width: 4, err: coff_reloc_type_name(rtype))
    if rtype == IMAGE_REL_AMD64_SECTION:
        if sec_index >= 1 and sec_index <= COFF_RELOC_U16_MAX:
            return CoffRelocValue(ok: true, value: sec_index, width: 2, err: "")
        return CoffRelocValue(ok: false, value: 0, width: 2, err: coff_reloc_type_name(rtype))
    coff_reloc_reject(rtype)

fn coff_reloc_needs_base_reloc(rtype: i64) -> bool:
    """True when the patched field holds an absolute VA and therefore needs a
    .reloc entry so the loader can rebase it. Only ADDR64 qualifies in the
    modelled set: ADDR32NB and SECREL are image-relative, the REL32 family is
    PC-relative, and SECTION is an index.

    NOTE: this is necessary but not sufficient. The TARGET must also live in
    the image — an ADDR64 to an ABSOLUTE symbol is a constant, and lld skips
    it (DefinedAbsolute is not walked in addBaserels). Rebasing it would add
    the image delta to that constant, so the caller must also check
    `CoffTarget.is_absolute`."""
    rtype == IMAGE_REL_AMD64_ADDR64

fn coff_reloc_width(rtype: i64) -> i64:
    """Field width in bytes for a modelled type, 0 for ABSOLUTE, and -1 for
    an unmodelled one. Callers need this BEFORE reading the implicit addend:
    COFF reads its addend out of the field, so a bounds check that happens
    after the read is not a bounds check at all."""
    if rtype == IMAGE_REL_AMD64_ABSOLUTE:
        return 0
    if rtype == IMAGE_REL_AMD64_ADDR64:
        return 8
    if rtype == IMAGE_REL_AMD64_SECTION:
        return 2
    if rtype == IMAGE_REL_AMD64_ADDR32NB or rtype == IMAGE_REL_AMD64_SECREL:
        return 4
    if rtype >= IMAGE_REL_AMD64_REL32 and rtype <= IMAGE_REL_AMD64_REL32_5:
        return 4
    -1

fn coff_reloc_is_section_relative(rtype: i64) -> bool:
    """True for the types whose value is an OFFSET INSIDE the target's own
    output section, which is meaningless for an absolute symbol (it belongs to
    no section, so there is no base to subtract). lld-link refuses exactly
    these: `SECREL relocation cannot be applied to absolute symbols`.

    IMAGE_REL_AMD64_SECTION is deliberately NOT in this set, although it is
    also section-derived. Measured, not assumed: lld links it with rc=0 and
    writes `numOutputSections + 1` (COFF/Chunks.cpp applySecIdx, commented
    "required for compatibility with MSVC") — 0x0003 for a 2-section image and
    0x0004 when a synthesized `.reloc` brings the total to 3. Callers implement
    that instead of rejecting it; see coff_static_link.coff_abs_section_index."""
    rtype == IMAGE_REL_AMD64_SECREL or rtype == IMAGE_REL_AMD64_SECREL7
