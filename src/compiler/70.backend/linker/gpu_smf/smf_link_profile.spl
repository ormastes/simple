# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_link_profile.spl — SmfLinkProfile CPU
# reference (L2–L4 slice)
#
# Architecture Part VII §19 (SMF link pipeline L0–L12, linker tags). Contract
# document:
# doc/05_design/platform/structural_compute/link_manager_contract_v1.md
#
# This is the CPU-reference L2 (arenas as plain arrays) – L3 (intern/sort) –
# L4 (select) slice of the SmfLinkProfile pipeline, built directly on
# GraphResolveCore (resolve_core.spl) over the frozen ResolveProfile record
# shapes (resolve_types.spl). L0 discover, L1 decode, L5 archive fixpoint,
# L6 reachability, L7 address layout, L8 relocation, L9 output assembly, L10
# provenance, L11 SSD write and L12 manifest commit are NOT implemented here
# (the SmfLinkProfile attributes bit layout is frozen in
# smf_link_attributes.spl, schema v1 — contract §6 as amended;
# smf_linker_map.md maps the still-existing owners of the other stages
# today).
#
# L1 decode is intentionally NOT re-parsed here. The existing SMF reader
# (`SmfReaderImpl`, src/compiler/70.backend/linker/smf_reader.spl:186) is the
# live L1 decode owner (smf_linker_map.md §3), but its symbol table can only
# be read through a real SFFI handle opened on an on-disk `.smf` file
# (`rt_smf_reader_read_symbol_table`) — there is no in-process constructor
# that hands back `SmfReaderImpl.symbols: Dict<text, SmfSymbol>` from an
# in-memory/test-only source. `smf_collect_records` below therefore takes a
# caller-supplied, already-decoded symbol list (`SmfLinkInputs`) instead of
# an `SmfReaderImpl`/SFFI handle directly; the thin adapter from a live
# `SmfReaderImpl.symbols` dict (or `exported_symbols()`) to
# `[SmfSymbolInput]` is left to the L1-decode integration wave that wires a
# real driver context.
#
# Composition only, no inheritance (repo rule): plain value structs, free
# functions, same discipline as resolve_core.spl / resolve_frontier.spl.
# ============================================================================

use std.common.structural.identity.entity_id.{EntityRef, entity_ref}
use std.common.structural.resolve.resolve_types.{
    DefinitionRecord,
    ReferenceRecord,
    ResolutionRecord,
    definition_record,
    reference_record,
    resolution_record,
    resolve_key
}
use std.common.structural.resolve.resolve_core.{
    group_sorted,
    intern_name,
    reduce_group,
    sort_definitions_stable,
    sort_references_stable
}
use compiler.backend.linker.gpu_smf.smf_link_attributes.{
    SmfLinkAttrFields,
    smf_link_attributes_encode
}

# ----------------------------------------------------------------------------
# ResolveKey space discriminants for the SmfLinkProfile (contract §3
# `ResolveKey.space u32`). The `SmfLinkProfile` `attributes` bit layout is
# frozen in smf_link_attributes.spl (schema v1, contract §6 as amended);
# these two space ids are the minimum needed so a symbol-name key can
# never cross-resolve against a future section-name key sharing the same
# name hash. Only `SMF_SPACE_SYMBOL` is produced by `smf_collect_records`
# below — `SMF_SPACE_SECTION` is reserved for a future section-name collect
# step over `link.section.*` tags, not exercised in this L2–L4 slice.
# ----------------------------------------------------------------------------

val SMF_SPACE_SYMBOL: u32 = 0
val SMF_SPACE_SECTION: u32 = 1

# ----------------------------------------------------------------------------
# SmfLinkInputs — one already-loaded SMF module's decoded symbol list, ready
# for resolve-record collection (§18 collect step). See header note: this is
# the caller-supplied stand-in for reading `SmfReaderImpl.symbols` directly.
# ----------------------------------------------------------------------------

struct SmfSymbolInput:
    """One decoded SMF symbol (name + defined/undefined) — the shape
    `SmfReaderImpl.symbols: Dict<text, SmfSymbol>` (smf_reader.spl:191)
    already carries per entry. `defined` is true for a symbol this module
    provides a body for (becomes a `DefinitionRecord`), false for a symbol
    this module only references (becomes a `ReferenceRecord`) —
    `obj_taker.spl`'s `SmfSymbol` has no separate defined/undefined field
    today, so the L1-decode adapter must derive this from whatever the
    reader considers "has code" (e.g. `size > 0` / a valid `section_index`)
    when it is wired up.

    The remaining fields are the schema-v1 attribute inputs
    (smf_link_attributes.spl): `binding`/`sym_type`/`layout_phase` hold the
    SMF_LINK_* u32 codes (u32/bool in-memory scalars, never u8), populated
    from `SmfWriterSymbol` by smf_reader_adapter.spl.

    `section_index` is the symbol's home section, carried through unchanged
    from `SmfWriterSymbol.section_index` (i64, negative = no section) by the
    adapter. It replaces the parallel `section_indices` array
    `smf_unreachable_symbol_indices` (smf_reachability.spl) used to take
    before this field existed.
    """
    name: text
    defined: bool
    binding: u32
    sym_type: u32
    layout_phase: u32
    is_event_loop_anchor: bool
    layout_pinned: bool
    section_index: i64

struct SmfLinkInputs:
    """One module's collected symbol table plus the module identity used to
    build stable `EntityRef` owners (`object_slot = module_index`,
    `local_index = symbol_index`, the symbol's position in `symbols`)."""
    module_index: u32
    symbols: [SmfSymbolInput]

# ----------------------------------------------------------------------------
# smf_collect_records — §18 collect step (L2 arenas as plain arrays, L3
# intern via GraphResolveCore's `intern_name`).
# ----------------------------------------------------------------------------

fn smf_collect_records(inputs: SmfLinkInputs) -> ([DefinitionRecord], [ReferenceRecord]):
    """Decode one module's symbol list into DefinitionRecord/ReferenceRecord
    arrays (§18 collect step, unsorted — order is input order, `smf_resolve`
    does the sort).

    `key.space` is always `SMF_SPACE_SYMBOL`: this collect step only reads
    the SMF symbol table. `owner` is `entity_ref(inputs.module_index,
    symbol_index)` where `symbol_index` is the symbol's position in
    `inputs.symbols`. `order` is that same running input-order counter,
    widened to u64, so `reduce_group`'s lowest-order-wins reduction is
    deterministic by input position. `attributes` is the schema-v1
    `smf_link_attributes_encode` packing of the symbol's attribute fields
    (smf_link_attributes.spl — frozen bit layout, contract §6 as amended).
    """
    var defs: [DefinitionRecord] = []
    var refs: [ReferenceRecord] = []
    var i = 0
    val n = inputs.symbols.len()
    while i < n:
        val sym = inputs.symbols[i]
        val key = resolve_key(intern_name(sym.name), SMF_SPACE_SYMBOL)
        val owner = entity_ref(inputs.module_index, i as u32)
        val order = i as u64
        val attributes = smf_link_attributes_encode(SmfLinkAttrFields(
            defined: sym.defined,
            binding: sym.binding,
            sym_type: sym.sym_type,
            layout_phase: sym.layout_phase,
            is_event_loop_anchor: sym.is_event_loop_anchor,
            layout_pinned: sym.layout_pinned))
        if sym.defined:
            defs.push(definition_record(key, owner, attributes, order))
        else:
            refs.push(reference_record(key, owner, attributes, order))
        i = i + 1
    (defs, refs)

# ----------------------------------------------------------------------------
# smf_resolve — §18 resolve step (L3 sort/group, L4 select) assembled into
# one ResolutionRecord per reference.
# ----------------------------------------------------------------------------

fn smf_resolve(defs: [DefinitionRecord], refs: [ReferenceRecord]) -> [ResolutionRecord]:
    """Sort, group, and reduce `defs`/`refs` with GraphResolveCore's stable
    sorts/`group_sorted`/`reduce_group`, then assemble one `ResolutionRecord`
    per reference (§18): the winning group's `ResolveGroupResult`
    selected/status/reason are copied onto every reference in that group. A
    reference whose key has zero definitions still gets a group
    (`group_sorted` creates one for every key present in either array), so
    it comes back Unresolved/MissingDefinition rather than being dropped —
    every reference passed in appears exactly once in the result.
    """
    val sorted_defs = sort_definitions_stable(defs)
    val sorted_refs = sort_references_stable(refs)
    val views = group_sorted(sorted_defs, sorted_refs)
    var results: [ResolutionRecord] = []
    var vi = 0
    val vn = views.len()
    while vi < vn:
        val view = views[vi]
        val group = reduce_group(view, sorted_defs)
        var ri = view.references_offset as i64
        val r_end = ri + (view.references_count as i64)
        while ri < r_end:
            val reference = sorted_refs[ri]
            results.push(resolution_record(reference.owner, group.selected, group.status, group.reason))
            ri = ri + 1
        vi = vi + 1
    results
