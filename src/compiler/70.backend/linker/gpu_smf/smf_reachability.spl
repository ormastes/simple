# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_reachability.spl — L6 reachability
# wiring over section edges (LINK lane, Lane REACH)
#
# Architecture Part VII §19 (SMF link pipeline stage L6_REACHABILITY,
# `link.reachable`). Contract document:
# doc/05_design/platform/structural_compute/link_manager_contract_v1.md §6
# keeps the reachability batch layouts deferred — this module is deliberately
# NOT a wire format and defines no new batch shapes. It only wires the frozen
# CPU reference algorithm (`reachable_mark`, resolve_frontier.spl) over
# caller-supplied section edges, plus the symbol-side dead-strip projection.
#
# `ResolveEdge` / `ReachableResult` are REUSED from
# src/lib/common/structural/resolve/resolve_frontier.spl — never redefined
# here. Node arena = sections indexed 0..section_count; an edge
# `from_index -> to_index` means "if section from_index is kept, section
# to_index must be kept" (e.g. a relocation from one section into another).
#
# Composition only, no inheritance (repo rule): free functions over the
# existing structs, same discipline as smf_link_profile.spl.
# ============================================================================

use std.common.structural.resolve.resolve_frontier.{
    ResolveEdge,
    ReachableResult,
    reachable_mark
}
use compiler.backend.linker.gpu_smf.smf_link_profile.{SmfSymbolInput}

# ----------------------------------------------------------------------------
# smf_reachable_sections — stage L6 over the section graph.
# ----------------------------------------------------------------------------

fn smf_reachable_sections(section_count: i64, edges: [ResolveEdge], roots: [u32]) -> ReachableResult:
    """Mark the sections reachable from `roots` over `edges` (stage L6,
    `link.reachable`). Thin, bounds-rejecting wrapper over the frozen CPU
    reference `reachable_mark`: a negative `section_count`, any edge
    endpoint `>= section_count`, or any root `>= section_count` yields
    `ok: false` — never a trap, never a silently-skipped record. On success
    `values[i]` is true exactly when section `i` is reachable, roots
    processed in input order and each node's outgoing edges scanned in
    input order (deterministic; a diamond marks its join exactly once)."""
    reachable_mark(section_count, edges, roots)

# ----------------------------------------------------------------------------
# smf_unreachable_symbol_indices — symbol-side dead-strip projection.
# ----------------------------------------------------------------------------

fn smf_unreachable_symbol_indices(inputs: [SmfSymbolInput], section_indices: [i64], marks: [bool]) -> [u32]:
    """Indices (positions in `inputs`, widened to u32) of DEFINED symbols
    whose home section is unmarked in `marks` — the dead-strip candidate
    list, in stable input order.

    `section_indices` is positionally parallel to `inputs` (entry `i` is the
    home section of `inputs[i]`), carrying the adapter-side
    `SmfWriterSymbol.section_index` shape (`i64`, negative = no section).
    It is a separate argument only because `SmfSymbolInput` does not carry a
    `section_index` field at this base — the concurrent attributes lane owns
    extending that struct, and this module must not touch
    smf_link_profile.spl; fold the parallel array into the struct once that
    extension lands.

    Never listed: undefined symbols (reference records are not
    dead-stripped — an unresolved one becomes MissingDefinition later), and
    symbols whose section index is out of range for `marks` (negative = no
    section, or `>= marks.len()`). A length mismatch between `inputs` and
    `section_indices` returns the empty list — an explicit
    "no candidates" contract, never a partial scan."""
    var out: [u32] = []
    if inputs.len() != section_indices.len():
        return out
    val section_count = marks.len()
    var i = 0
    val n = inputs.len()
    while i < n:
        if inputs[i].defined:
            val sec = section_indices[i]
            if sec >= 0 and sec < section_count:
                if not marks[sec]:
                    out.push(i as u32)
        i = i + 1
    out
