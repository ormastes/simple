# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_section_layout.spl — L7 section
# address layout scan primitive (link_manager wave 8, Lane LAYOUT)
#
# The L7 scan CPU oracle flagged missing in
# .spipe/link_manager/hybrid_batch_notes.md: a sequential aligned prefix-sum
# assigning each section its output offset. Contract §6
# (doc/05_design/platform/structural_compute/link_manager_contract_v1.md)
# keeps the scan BATCH layouts deferred — this module defines no wire format
# and no batch shape; it is the deterministic CPU reference a future GPU
# scan must byte-match.
#
# UNIFIED 2026-09-19 (lane F2). The prefix-sum, the align_up helper, the
# power-of-two validity predicate and the overflow guard used to be
# implemented here and separately in five other places (the ELF writer, the
# boot layout planner, the loader's bytecode section writer and the two
# mirrored remote target code allocators). They now all call ONE oracle,
# `std.common.placement` — see src/lib/common/placement.spl for the
# divergence table. The names below are kept as thin aliases because
# smf_link_driver.spl, smf_link_receipts.spl and the L7 specs import them,
# and because `SmfLayoutResult` is part of the L7 CPU-reference contract a
# future GPU scan must byte-match.
#
# Semantics are UNCHANGED: offset[i] = align_up(cursor, alignments[i]);
# cursor = offset[i] + sizes[i]; input order preserved. Every i64 overflow
# is checked BEFORE the add that could wrap.
#
# Composition only, no inheritance (repo rule): one result struct + free
# functions, same discipline as the sibling gpu_smf modules.
# ============================================================================

use std.common.placement.{
    PLACEMENT_I64_MAX,
    placement_align_up,
    placement_pack
}

# i64 max (2^63 - 1). Re-exported under the L7 name; the value lives in the
# shared oracle so the two can never drift.
val SMF_LAYOUT_I64_MAX: i64 = PLACEMENT_I64_MAX

# ----------------------------------------------------------------------------
# SmfLayoutResult — outcome of one layout pass.
# ----------------------------------------------------------------------------

struct SmfLayoutResult:
    """Result of `smf_layout_sections`. On success `ok` is true,
    `offsets[i]` is the absolute address assigned to section i (input
    order), and `total_size` is the span from `base_addr` to the end of the
    last section (final cursor - base_addr). On any reject `ok` is false,
    `offsets` is empty, and `total_size` is 0 — a rejected layout never
    leaks partial addresses."""
    ok: bool
    offsets: [i64]
    total_size: i64

fn smf_layout_reject() -> SmfLayoutResult:
    """The single reject value: ok false, no offsets, zero size."""
    SmfLayoutResult(ok: false, offsets: [], total_size: 0)

# ----------------------------------------------------------------------------
# align_up helper + its overflow guard — aliases of the shared oracle.
# ----------------------------------------------------------------------------

fn smf_align_up(value: i64, alignment: i64) -> i64:
    """Smallest multiple of `alignment` that is >= `value`. Alias of
    `placement_align_up`. Preconditions (now enforced inside
    `placement_pack`, which `smf_layout_sections` delegates to): value >= 0
    and alignment a positive power of two.

    The former siblings `smf_layout_alignment_valid` and
    `smf_align_up_overflows` are GONE, not aliased: once the layout pass
    delegated, nothing called them (verified — zero references in src/ and
    test/ outside their own definitions), and an alias with no caller is
    unused code. `placement_alignment_is_power_of_two` and
    `placement_align_up_overflows` are their surviving form."""
    placement_align_up(value, alignment)

# ----------------------------------------------------------------------------
# smf_layout_sections — stage L7 sequential aligned prefix-sum.
# ----------------------------------------------------------------------------

fn smf_layout_sections(base_addr: i64, sizes: [i64], alignments: [i64]) -> SmfLayoutResult:
    """Assign each section its output address by a sequential aligned
    prefix-sum starting at `base_addr`, preserving input order. `sizes[i]`
    and `alignments[i]` are positionally paired.

    Delegates to `placement_pack` (src/lib/common/placement.spl), the one
    placement oracle the ELF writer, the boot layout planner, the loader's
    section writer and the remote target allocator also use, and re-wraps
    its result in the L7 `SmfLayoutResult` contract type.

    Rejects (ok false, empty offsets, total_size 0):
      - sizes/alignments length mismatch,
      - negative base_addr or any negative size,
      - any alignment <= 0 or not a power of two,
      - i64 overflow at ANY step — both the align_up round-up and the
        offset + size advance are guarded BEFORE the add; the cursor can
        never wrap.

    On success `total_size` is the final cursor minus `base_addr`.
    Zero-size sections occupy no bytes but are still aligned (the next
    section may land on the same address).

    NOTE, and it is a real divergence rather than an oversight: this pass
    accepts ANY power-of-two alignment, including one stronger than a page.
    The loader's segment mapper cannot map such a section — see
    src/compiler/99.loader/segment_mapper.spl, which refuses an alignment
    above `PLACEMENT_PAGE_SIZE`. The cap is a property of the consumer, so
    it is asked for explicitly with `placement_align_within` rather than
    baked in here."""
    val packed = placement_pack(base_addr, sizes, alignments)
    if not packed.ok:
        return smf_layout_reject()
    SmfLayoutResult(ok: true, offsets: packed.offsets, total_size: packed.total_size)
