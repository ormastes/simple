# ============================================================================
# compiler/70.backend/linker/gpu_smf/smf_section_layout.spl — L7 section
# address layout scan primitive (link_manager wave 8, Lane LAYOUT)
#
# The L7 scan CPU oracle flagged missing in
# .spipe/link_manager/hybrid_batch_notes.md: a sequential aligned prefix-sum
# assigning each section its output offset. Contract §6
# (doc/05_design/platform/structural_compute/link_manager_contract_v1.md)
# keeps the scan BATCH layouts deferred — this module defines no wire format
# and no batch shape; it is the deterministic CPU reference a future GPU
# scan must byte-match.
#
# Semantics: offset[i] = align_up(cursor, alignments[i]); cursor = offset[i]
# + sizes[i]; input order preserved (no reordering this wave — ordering is a
# profile decision). Every i64 overflow is checked BEFORE the add that could
# wrap — the cursor never wraps, a too-large layout is `ok: false`, never a
# garbage address.
#
# Composition only, no inheritance (repo rule): one result struct + free
# functions, same discipline as the sibling gpu_smf modules.
# ============================================================================

# i64 max (2^63 - 1), spelled out. Overflow guards compare against this
# BEFORE any add so no intermediate value can wrap.
val SMF_LAYOUT_I64_MAX: i64 = 9223372036854775807

# ----------------------------------------------------------------------------
# SmfLayoutResult — outcome of one layout pass.
# ----------------------------------------------------------------------------

struct SmfLayoutResult:
    """Result of `smf_layout_sections`. On success `ok` is true,
    `offsets[i]` is the absolute address assigned to section i (input
    order), and `total_size` is the span from `base_addr` to the end of the
    last section (final cursor - base_addr). On any reject `ok` is false,
    `offsets` is empty, and `total_size` is 0 — a rejected layout never
    leaks partial addresses."""
    ok: bool
    offsets: [i64]
    total_size: i64

fn smf_layout_reject() -> SmfLayoutResult:
    """The single reject value: ok false, no offsets, zero size."""
    SmfLayoutResult(ok: false, offsets: [], total_size: 0)

# ----------------------------------------------------------------------------
# align_up helper + its overflow guard.
# ----------------------------------------------------------------------------

fn smf_layout_alignment_valid(alignment: i64) -> bool:
    """True when `alignment` is usable: strictly positive and a power of
    two (`n & (n - 1) == 0` trick, same as layout_attrs.is_power_of_two)."""
    alignment > 0 and (alignment & (alignment - 1)) == 0

fn smf_align_up_overflows(value: i64, alignment: i64) -> bool:
    """True when `smf_align_up(value, alignment)` would exceed i64 —
    checked BEFORE the add inside align_up so nothing ever wraps. For a
    power-of-two alignment this guard is exact: the add
    `value + (alignment - 1)` stays in range iff the rounded-up multiple
    itself stays in range (largest representable multiple of `alignment`
    is 2^63 - alignment == SMF_LAYOUT_I64_MAX - (alignment - 1))."""
    value > SMF_LAYOUT_I64_MAX - (alignment - 1)

fn smf_align_up(value: i64, alignment: i64) -> i64:
    """Smallest multiple of `alignment` that is >= `value`. Preconditions
    (caller-enforced, see smf_layout_sections): value >= 0, alignment a
    positive power of two, and `smf_align_up_overflows(value, alignment)`
    is false."""
    ((value + (alignment - 1)) / alignment) * alignment

# ----------------------------------------------------------------------------
# smf_layout_sections — stage L7 sequential aligned prefix-sum.
# ----------------------------------------------------------------------------

fn smf_layout_sections(base_addr: i64, sizes: [i64], alignments: [i64]) -> SmfLayoutResult:
    """Assign each section its output address by a sequential aligned
    prefix-sum starting at `base_addr`, preserving input order. `sizes[i]`
    and `alignments[i]` are positionally paired.

    Rejects (ok false, empty offsets, total_size 0):
      - sizes/alignments length mismatch,
      - negative base_addr or any negative size,
      - any alignment <= 0 or not a power of two,
      - i64 overflow at ANY step — both the align_up round-up and the
        offset + size advance are guarded BEFORE the add; the cursor can
        never wrap.

    On success `total_size` is the final cursor minus `base_addr`.
    Zero-size sections occupy no bytes but are still aligned (the next
    section may land on the same address)."""
    if sizes.len() != alignments.len():
        return smf_layout_reject()
    if base_addr < 0:
        return smf_layout_reject()
    var offsets: [i64] = []
    var cursor = base_addr
    var i = 0
    val n = sizes.len()
    while i < n:
        val size = sizes[i]
        val alignment = alignments[i]
        if size < 0:
            return smf_layout_reject()
        if not smf_layout_alignment_valid(alignment):
            return smf_layout_reject()
        if smf_align_up_overflows(cursor, alignment):
            return smf_layout_reject()
        val offset = smf_align_up(cursor, alignment)
        if offset > SMF_LAYOUT_I64_MAX - size:
            return smf_layout_reject()
        offsets.push(offset)
        cursor = offset + size
        i = i + 1
    SmfLayoutResult(ok: true, offsets: offsets, total_size: cursor - base_addr)
