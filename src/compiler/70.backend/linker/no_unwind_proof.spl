use std.common.crypto.sha256.{sha256_text}

enum NoUnwindProofErrorV1:
    profile_not_release_small
    authority_incomplete
    exception_required
    foreign_unwind_required
    cleanup_landing_pad_required
    stack_unwind_required
    rtti_required
    personality_required

struct NoUnwindClosureFactsV1:
    profile: text
    target_triple: text
    closure_digest: text
    toolchain_digest: text
    all_objects_classified: bool
    all_foreign_boundaries_classified: bool
    throws_or_catches: bool
    foreign_unwind_boundary: bool
    cleanup_landing_pads: bool
    stack_unwind_backtrace: bool
    rtti_or_dynamic_cast: bool
    exception_personality: bool

struct NoUnwindProofV1:
    schema: text
    target_triple: text
    closure_digest: text
    toolchain_digest: text
    proof_digest: text
    exceptions_absent: bool
    foreign_unwind_absent: bool
    cleanup_landing_pads_absent: bool
    stack_unwind_absent: bool
    rtti_absent: bool
    personality_absent: bool

fn no_unwind_proof_v1(
    facts: NoUnwindClosureFactsV1
) -> Result[NoUnwindProofV1, NoUnwindProofErrorV1]:
    if facts.profile != "release-small":
        return Err(NoUnwindProofErrorV1.profile_not_release_small)
    if (facts.target_triple == "" or facts.closure_digest == "" or
            facts.toolchain_digest == "" or not facts.all_objects_classified or
            not facts.all_foreign_boundaries_classified):
        return Err(NoUnwindProofErrorV1.authority_incomplete)
    if facts.throws_or_catches:
        return Err(NoUnwindProofErrorV1.exception_required)
    if facts.foreign_unwind_boundary:
        return Err(NoUnwindProofErrorV1.foreign_unwind_required)
    if facts.cleanup_landing_pads:
        return Err(NoUnwindProofErrorV1.cleanup_landing_pad_required)
    if facts.stack_unwind_backtrace:
        return Err(NoUnwindProofErrorV1.stack_unwind_required)
    if facts.rtti_or_dynamic_cast:
        return Err(NoUnwindProofErrorV1.rtti_required)
    if facts.exception_personality:
        return Err(NoUnwindProofErrorV1.personality_required)
    val digest = sha256_text(
        "simple/no-unwind-proof/v1" +
        "|target={facts.target_triple}" +
        "|closure={facts.closure_digest}" +
        "|toolchain={facts.toolchain_digest}" +
        "|exceptions=absent|foreign-unwind=absent" +
        "|cleanup=absent|stack-unwind=absent" +
        "|rtti=absent|personality=absent")
    Ok(NoUnwindProofV1(
        "simple/no-unwind-proof/v1", facts.target_triple,
        facts.closure_digest, facts.toolchain_digest, digest,
        true, true, true, true, true, true))

export NoUnwindProofErrorV1, NoUnwindClosureFactsV1, NoUnwindProofV1
export no_unwind_proof_v1
