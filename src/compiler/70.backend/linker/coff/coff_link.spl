fn _coff_i386_default_policy() -> PeImagePolicy:
    """PE32 default: lld-style flags (no HIGH_ENTROPY_VA, no LARGE_ADDRESS_AWARE)."""
    var policy = PeImagePolicy.default()
    policy.high_entropy_va = false
    policy.large_address_aware = false
    policy

fn coff_link_i386_default_libraries(request: CoffLinkRequest,
        retained_symbols: [text]) -> Result<[text], text>:
    """Return i386 `/DEFAULTLIB` rows from roots plus selected members."""
    val prepared = _coff_prepare_link_machine(
        request, retained_symbols, COFF_MACHINE_I386, "i386")
    if prepared.is_err(): return Err(prepared.unwrap_err())
    Ok(prepared.unwrap().default_libraries)

fn coff_link_i386(request: CoffLinkRequest) -> Result<[u8], text>:
    """Link i386 COFF objects and libraries into a PE32 console executable."""
    coff_link_i386_retained(request, [])

fn coff_link_i386_retained(request: CoffLinkRequest,
        retained_symbols: [text]) -> Result<[u8], text>:
    """Link i386 with `/INCLUDE`-style archive roots."""
    coff_link_i386_retained_policy(
        request, retained_symbols, _coff_i386_default_policy())

fn coff_link_i386_retained_policy(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy) -> Result<[u8], text>:
    """Link i386 COFF with typed PE optional-header policy."""
    coff_link_i386_retained_image_policy(
        request, retained_symbols, policy, PE_I386_IMAGE_BASE)

fn coff_link_i386_retained_image_policy(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy,
        image_base: i64) -> Result<[u8], text>:
    """Link i386 COFF with typed PE policy and image base."""
    coff_link_i386_retained_image_policy_gc(
        request, retained_symbols, policy, image_base, false)

fn coff_link_i386_retained_image_policy_gc(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy,
        image_base: i64, gc_sections: bool) -> Result<[u8], text>:
    """Link i386 COFF with optional relocation-graph COMDAT elimination."""
    coff_link_i386_retained_image_policy_opt(
        request, retained_symbols, policy, image_base, gc_sections, false)

fn coff_link_i386_retained_image_policy_opt(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy,
        image_base: i64, gc_sections: bool,
        icf_sections: bool) -> Result<[u8], text>:
    """Link i386 COFF with typed REF and safe ICF policy."""
    coff_link_i386_retained_image_policy_options(
        request, retained_symbols, policy, image_base, gc_sections,
        icf_sections, false)

fn coff_link_i386_retained_image_policy_options(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy,
        image_base: i64, gc_sections: bool, icf_sections: bool,
        allow_multiple_definitions: bool) -> Result<[u8], text>:
    """Link i386 COFF with REF, ICF, and `/FORCE:MULTIPLE` policy."""
    coff_link_i386_retained_image_policy_full(
        request, retained_symbols, policy, image_base, gc_sections,
        icf_sections, allow_multiple_definitions, [])

fn coff_link_i386_retained_image_policy_full(request: CoffLinkRequest,
        retained_symbols: [text], policy: PeImagePolicy,
        image_base: i64, gc_sections: bool, icf_sections: bool,
        allow_multiple_definitions: bool,
        command_exports: [CoffExportDirective]) -> Result<[u8], text>:
    """Link i386 COFF with complete typed command-line policy."""
    _coff_link_retained(
        request, retained_symbols, COFF_MACHINE_I386, policy, image_base,
        gc_sections, icf_sections, allow_multiple_definitions, command_exports)

fn _coff_decorate(machine: i64, name: text) -> text:
    """i386 C symbols carry one extra leading underscore (`_main`, `__ImageBase`)."""
    if machine == COFF_MACHINE_I386: "_" + name else: name

fn _coff_machine_name(machine: i64) -> text:
    if machine == COFF_MACHINE_ARM64: "ARM64"
    elif machine == COFF_MACHINE_I386: "i386"
    else: "AMD64"

fn _coff_synthetic_absolutes(objects: [CoffObject], machine: i64) -> CoffObject:
    """Absolute zero symbols lld-link always defines so the MSVC CRT load-config
    and enclave tables link without /guard:cf (Driver.cpp addAbsolute rows)."""
    var symbols: [CoffSymbol] = []
    var table_index: i64 = 0
    for base_name in ["__guard_fids_count", "__guard_fids_table", "__guard_flags",
            "__guard_iat_count", "__guard_iat_table", "__guard_longjmp_count",
            "__guard_longjmp_table", "__enclave_config", "__guard_eh_cont_count",
            "__guard_eh_cont_table"]:
        val name = _coff_decorate(machine, base_name)
        var defined = false
        for object in objects:
            for symbol in object.symbols:
                if symbol.name == name and symbol.is_external() and
                        (symbol.is_defined() or symbol.is_absolute()):
                    defined = true
        if defined: continue
        symbols = symbols.push(CoffSymbol(name: name, value: 0, section_number: -1,
            symbol_type: 0, storage_class: COFF_STORAGE_CLASS_EXTERNAL,
            auxiliary_count: 0, table_index: table_index, weak_default_index: -1,
            weak_characteristics: 0))
        table_index = table_index + 1
    CoffObject(machine: machine, timestamp: 0, characteristics: 0, sections: [],
        symbols: symbols, symbol_table_offset: 0, symbol_table_count: table_index)

fn _coff_symbol_referenced_undefined(objects: [CoffObject], name: text) -> bool:
    var referenced = false
    for object in objects:
        for symbol in object.symbols:
            if symbol.name == name and symbol.is_external():
                if symbol.is_defined() or symbol.is_absolute(): return false
                referenced = true
    referenced

fn _coff_synthetic_section(name: text, data: [u8], characteristics: i64) -> CoffSection:
    CoffSection(name: name, virtual_size: 0, raw_size: data.len(), raw_pointer: 0,
        relocation_pointer: 0, relocation_count: 0, characteristics: characteristics,
        comdat_selection: 0, associative_section: 0, comdat_checksum: 0,
        comdat_key: "", data: data, relocations: [])

fn _coff_synthetic_mingw_lists(objects: [CoffObject], machine: i64) -> CoffObject:
    """Symbols the GNU/mingw linker defines (lld `MinGW` driver rows):
    `__CTOR_LIST__`/`__DTOR_LIST__` head a `-1 ... 0` pointer table built
    from `.ctors`/`.dtors` input, and `__RUNTIME_PSEUDO_RELOC_LIST__`/`_END__`
    bracket the (empty — no auto-import) pseudo-relocation list."""
    var sections: [CoffSection] = []
    var symbols: [CoffSymbol] = []
    # IMAGE_SCN_CNT_INITIALIZED_DATA | MEM_READ | MEM_WRITE | ALIGN_8BYTES
    # (ALIGN_4BYTES with 4-byte pointer slots on i386).
    val i386 = machine == COFF_MACHINE_I386
    val table_flags = if i386: 0xc0300040 else: 0xc0400040
    val pointer_size: i64 = if i386: 4 else: 8
    for table in [".ctors", ".dtors"]:
        val list_name = _coff_decorate(machine,
            if table == ".ctors": "__CTOR_LIST__" else: "__DTOR_LIST__")
        if not _coff_symbol_referenced_undefined(objects, list_name): continue
        var head: [u8] = []
        for _ in 0..pointer_size: head = head.push(0xff)
        sections = sections.push(_coff_synthetic_section("{table}$A", head, table_flags))
        symbols = symbols.push(CoffSymbol(name: list_name, value: 0,
            section_number: sections.len(), symbol_type: 0,
            storage_class: COFF_STORAGE_CLASS_EXTERNAL, auxiliary_count: 0,
            table_index: symbols.len(), weak_default_index: -1, weak_characteristics: 0))
        sections = sections.push(_coff_synthetic_section("{table}$z", elf_u8_zeros(pointer_size), table_flags))
    var pseudo_needed = false
    val pseudo_names: [text] = [_coff_decorate(machine, "__RUNTIME_PSEUDO_RELOC_LIST__"),
        _coff_decorate(machine, "__RUNTIME_PSEUDO_RELOC_LIST_END__")]
    for name in pseudo_names:
        if _coff_symbol_referenced_undefined(objects, name): pseudo_needed = true
    if pseudo_needed:
        # IMAGE_SCN_CNT_INITIALIZED_DATA | MEM_READ | ALIGN_4BYTES, one 4-byte
        # anchor so the empty list has a real RVA inside `.rdata`.
        sections = sections.push(_coff_synthetic_section(".rdata$zzpr", elf_u8_zeros(4), 0x40300040))
        for name in pseudo_names:
            symbols = symbols.push(CoffSymbol(name: name, value: 0,
                section_number: sections.len(), symbol_type: 0,
                storage_class: COFF_STORAGE_CLASS_EXTERNAL, auxiliary_count: 0,
                table_index: symbols.len(), weak_default_index: -1, weak_characteristics: 0))
    CoffObject(machine: machine, timestamp: 0, characteristics: 0, sections: sections,
        symbols: symbols, symbol_table_offset: 0, symbol_table_count: symbols.len())

fn _coff_link_retained(request: CoffLinkRequest,
        retained_symbols: [text], machine: i64,
        policy: PeImagePolicy, image_base: i64,
        gc_sections: bool, icf_sections: bool,
        allow_multiple_definitions: bool,
        command_exports: [CoffExportDirective]) -> Result<[u8], text>:
    val valid_policy = pe_validate_policy(policy)
    if valid_policy.is_err(): return Err(valid_policy.unwrap_err())
    val machine_name = _coff_machine_name(machine)
    var effective_roots = retained_symbols
    for exported in command_exports:
        if not effective_roots.contains(exported.internal_name):
            effective_roots = effective_roots.push(exported.internal_name)
    val prepared_result = _coff_prepare_link_machine(
        request, effective_roots, machine, machine_name)
    if prepared_result.is_err(): return Err(prepared_result.unwrap_err())
    val prepared = prepared_result.unwrap()
    val input_objects = if allow_multiple_definitions:
        _coff_first_definition_objects(prepared.objects)
    else:
        prepared.objects
    var objects = input_objects
    objects.push(_coff_synthetic_absolutes(input_objects, machine))
    val mingw_lists = _coff_synthetic_mingw_lists(input_objects, machine)
    if mingw_lists.sections.len() > 0: objects.push(mingw_lists)
    val selected = prepared.selected
    val closure_roots = prepared.closure_roots
    val aliases = prepared.aliases
    val exports_result = _coff_merge_exports(prepared.exports, command_exports)
    if exports_result.is_err(): return Err(exports_result.unwrap_err())
    val exports = exports_result.unwrap()
    for name in closure_roots:
        if name == "": continue
        var found = false
        for object in objects:
            for symbol in object.symbols:
                if symbol.name == name and symbol.is_external() and
                        (symbol.is_defined() or symbol.is_absolute() or
                         (symbol.section_number == 0 and symbol.value > 0)):
                    found = true
        for import_object in selected.imports:
            if import_object.public_name == name or import_object.iat_symbol() == name:
                found = true
        if not found:
            val alternate = coff_resolve_alternate_name(name, aliases)
            if alternate.is_err(): return Err(alternate.unwrap_err())
            val target = alternate.unwrap()
            for object in objects:
                for symbol in object.symbols:
                    if symbol.name == target and symbol.is_external() and
                            (symbol.is_defined() or symbol.is_absolute() or
                             (symbol.section_number == 0 and symbol.value > 0)):
                        found = true
            for import_object in selected.imports:
                if import_object.public_name == target or import_object.iat_symbol() == target:
                    found = true
        if not found: return Err("retained COFF symbol not found: {name}")

    var gc_roots = closure_roots
    if request.entry == "auto":
        var auto_root = ""
        for candidate in ["mainCRTStartup", "_start", "main"]:
            if auto_root != "": continue
            for object in objects:
                for symbol in object.symbols:
                    if symbol.name == candidate and symbol.is_external() and
                            symbol.is_defined():
                        auto_root = candidate
        if auto_root != "" and not gc_roots.contains(auto_root):
            gc_roots = gc_roots.push(auto_root)
    elif not gc_roots.contains(request.entry):
        gc_roots = gc_roots.push(request.entry)
    var import_code_count: i64 = 0
    for import_object in selected.imports:
        if import_object.is_code(): import_code_count = import_code_count + 1
    val layout_result = _coff_layout_sections(
        objects, policy.section_alignment, gc_sections, icf_sections,
        gc_roots, aliases, machine, import_code_count)
    if layout_result.is_err(): return Err(layout_result.unwrap_err())
    val layout = layout_result.unwrap()
    val rvas = layout.rvas
    val common_layout = layout.common_layout
    val import_base_rva = layout.next_rva
    val import_thunk_rva = layout.import_thunk_rva
    val import_idata_rva = import_base_rva
    val import_result = if machine == COFF_MACHINE_ARM64:
        pe_build_arm64_imports(selected.imports, import_thunk_rva, import_idata_rva)
    elif machine == COFF_MACHINE_I386:
        pe_build_i386_imports(selected.imports, import_thunk_rva, import_idata_rva, image_base)
    else:
        pe_build_amd64_imports(selected.imports, import_thunk_rva, import_idata_rva)
    if import_result.is_err(): return Err(import_result.unwrap_err())
    val import_image = import_result.unwrap()
    val symbols_valid = _coff_validate_symbols(objects, rvas,
        import_image.symbol_rvas, common_layout.symbol_rvas, aliases,
        gc_sections)
    if symbols_valid.is_err(): return Err(symbols_valid.unwrap_err())
    val export_base_rva = if import_image.idata_data.len() > 0:
        import_idata_rva + pe_align_up(import_image.idata_data.len(), policy.section_alignment)
    else:
        import_base_rva
    val export_symbols = _coff_export_symbol_rvas(exports, objects, rvas,
        import_image.symbol_rvas, common_layout.symbol_rvas, aliases,
        image_base)
    if export_symbols.is_err(): return Err(export_symbols.unwrap_err())
    val export_image = pe_build_amd64_exports(
        exports, export_symbols.unwrap(), export_base_rva, "simple.exe")
    if export_image.is_err(): return Err(export_image.unwrap_err())
    val entry = _coff_entry_rva(objects, rvas, request.entry)
    if entry.is_err(): return Err(entry.unwrap_err())
    var output_sections: [PeImageSection] = []
    var base_relocation_rvas: [i64] = []
    var oi: i64 = 0
    while oi < objects.len():
        var si: i64 = 0
        while si < objects[oi].sections.len():
            val section = objects[oi].sections[si]
            if (section.characteristics & COFF_SECTION_LNK_REMOVE) != 0:
                si = si + 1
                continue
            if rvas[oi][si] == 0:
                si = si + 1
                continue
            var patched = section.data
            var section_base_relocations: [i64] = []
            for relocation in section.relocations:
                if relocation.relocation_type == COFF_REL_AMD64_ABSOLUTE: continue
                val symbol_result = coff_symbol_at_table_index(objects[oi], relocation.symbol_index)
                if symbol_result.is_err(): return Err(symbol_result.unwrap_err())
                val relocation_symbol = symbol_result.unwrap()
                if machine == COFF_MACHINE_ARM64 and
                        (relocation.relocation_type == COFF_REL_ARM64_SECTION or
                         relocation.relocation_type == COFF_REL_ARM64_SECREL or
                         relocation.relocation_type == COFF_REL_ARM64_SECREL_LOW12A or
                         relocation.relocation_type == COFF_REL_ARM64_SECREL_HIGH12A or
                         relocation.relocation_type == COFF_REL_ARM64_SECREL_LOW12L):
                    if relocation_symbol.is_absolute():
                        return Err("section-relative relocation cannot target absolute COFF symbol '{relocation_symbol.name}'")
                    val location = _coff_symbol_location(
                        objects, rvas, oi, relocation_symbol, aliases)
                    if location.is_err(): return Err(location.unwrap_err())
                    val target = location.unwrap()
                    val target_section_rva = _coff_output_section_base(objects, layout, target)
                    if target_section_rva.is_err(): return Err(target_section_rva.unwrap_err())
                    val addend = if relocation.relocation_type == COFF_REL_ARM64_SECTION:
                        _coff_read_u16(patched, relocation.virtual_address)
                    else:
                        _coff_read_u32(patched, relocation.virtual_address)
                    if addend.is_err(): return Err(addend.unwrap_err())
                    val section_index = _coff_output_section_index(objects, layout, target)
                    if section_index.is_err(): return Err(section_index.unwrap_err())
                    val value = coff_apply_arm64_section_relocation(
                        relocation.relocation_type, addend.unwrap(),
                        target.rva - target_section_rva.unwrap(), section_index.unwrap())
                    if not value.success: return Err(value.error)
                    val result = _coff_patch(
                        patched, relocation.virtual_address, value.width, value.value)
                    if result.is_err(): return Err(result.unwrap_err())
                    patched = result.unwrap()
                    continue
                if relocation_symbol.is_absolute() and
                        machine != COFF_MACHINE_ARM64 and
                        (relocation.relocation_type == COFF_REL_AMD64_SECTION or
                         relocation.relocation_type == COFF_REL_AMD64_SECREL or
                         (machine == COFF_MACHINE_AMD64 and
                          relocation.relocation_type == COFF_REL_AMD64_SECREL7)):
                    return Err("section-relative relocation cannot target absolute COFF symbol '{relocation_symbol.name}'")
                if machine != COFF_MACHINE_ARM64 and
                        relocation.relocation_type == COFF_REL_AMD64_SECTION:
                    val location = _coff_symbol_location(objects, rvas, oi, relocation_symbol, aliases)
                    if location.is_err(): return Err(location.unwrap_err())
                    val section_index = _coff_output_section_index(objects, layout, location.unwrap())
                    if section_index.is_err(): return Err(section_index.unwrap_err())
                    val addend = _coff_read_u16(patched, relocation.virtual_address)
                    if addend.is_err(): return Err(addend.unwrap_err())
                    val value = section_index.unwrap() + addend.unwrap()
                    if value > 65535: return Err("IMAGE_REL_AMD64_SECTION out of range")
                    val result = _coff_patch(patched, relocation.virtual_address, 2, value)
                    if result.is_err(): return Err(result.unwrap_err())
                    patched = result.unwrap()
                    continue
                if machine != COFF_MACHINE_ARM64 and
                        relocation.relocation_type == COFF_REL_AMD64_SECREL:
                    val location = _coff_symbol_location(objects, rvas, oi, relocation_symbol, aliases)
                    if location.is_err(): return Err(location.unwrap_err())
                    val target = location.unwrap()
                    val target_section_rva = _coff_output_section_base(objects, layout, target)
                    if target_section_rva.is_err(): return Err(target_section_rva.unwrap_err())
                    val addend = _coff_read_u32(patched, relocation.virtual_address)
                    if addend.is_err(): return Err(addend.unwrap_err())
                    val value = target.rva - target_section_rva.unwrap() + addend.unwrap()
                    if value < 0 or value >= 4294967296:
                        return Err("IMAGE_REL_AMD64_SECREL out of range")
                    val result = _coff_patch(patched, relocation.virtual_address, 4, value)
                    if result.is_err(): return Err(result.unwrap_err())
                    patched = result.unwrap()
                    continue
                if machine == COFF_MACHINE_AMD64 and
                        relocation.relocation_type == COFF_REL_AMD64_SECREL7:
                    val location = _coff_symbol_location(objects, rvas, oi, relocation_symbol, aliases)
                    if location.is_err(): return Err(location.unwrap_err())
                    val target = location.unwrap()
                    val target_section_rva = _coff_output_section_base(objects, layout, target)
                    if target_section_rva.is_err(): return Err(target_section_rva.unwrap_err())
                    val addend = _coff_read_u8(patched, relocation.virtual_address)
                    if addend.is_err(): return Err(addend.unwrap_err())
                    val preserved = addend.unwrap() & 0x80
                    val value = target.rva - target_section_rva.unwrap() + (addend.unwrap() & 0x7f)
                    if value < 0 or value > 127:
                        return Err("IMAGE_REL_AMD64_SECREL7 out of 7-bit range")
                    val result = _coff_patch(patched, relocation.virtual_address, 1,
                        preserved | value)
                    if result.is_err(): return Err(result.unwrap_err())
                    patched = result.unwrap()
                    continue
                val symbol_address_result = _coff_relocation_symbol_address(
                    objects, rvas, oi, relocation_symbol,
                    import_image.symbol_rvas, common_layout.symbol_rvas, aliases,
                    image_base)
                if symbol_address_result.is_err(): return Err(symbol_address_result.unwrap_err())
                val resolved_address = symbol_address_result.unwrap()
                val addend_result = if machine == COFF_MACHINE_I386 and
                        relocation.relocation_type == COFF_REL_I386_REL32:
                    _coff_read_i32(patched, relocation.virtual_address)
                elif machine == COFF_MACHINE_I386:
                    _coff_read_u32(patched, relocation.virtual_address)
                elif machine == COFF_MACHINE_ARM64 and
                        relocation.relocation_type == COFF_REL_ARM64_ADDR64:
                    _coff_read_u64(patched, relocation.virtual_address)
                elif machine == COFF_MACHINE_ARM64 and
                        relocation.relocation_type == COFF_REL_ARM64_REL32:
                    _coff_read_i32(patched, relocation.virtual_address)
                elif machine == COFF_MACHINE_ARM64:
                    _coff_read_u32(patched, relocation.virtual_address)
                elif relocation.relocation_type == COFF_REL_AMD64_ADDR64:
                    _coff_read_u64(patched, relocation.virtual_address)
                elif relocation.relocation_type >= COFF_REL_AMD64_REL32 and
                        relocation.relocation_type <= COFF_REL_AMD64_REL32_5:
                    _coff_read_i32(patched, relocation.virtual_address)
                else:
                    _coff_read_u32(patched, relocation.virtual_address)
                if addend_result.is_err(): return Err(addend_result.unwrap_err())
                val place = image_base + rvas[oi][si] + relocation.virtual_address
                val value = if machine == COFF_MACHINE_ARM64:
                    coff_apply_arm64_relocation(relocation.relocation_type,
                        resolved_address.address, addend_result.unwrap(), place, image_base)
                elif machine == COFF_MACHINE_I386:
                    coff_apply_i386_relocation(relocation.relocation_type,
                        resolved_address.address, addend_result.unwrap(), place, image_base)
                else:
                    coff_apply_amd64_relocation(relocation.relocation_type,
                        resolved_address.address, addend_result.unwrap(), place, image_base)
                if not value.success: return Err(value.error)
                val patched_result = _coff_patch(patched, relocation.virtual_address, value.width, value.value)
                if patched_result.is_err(): return Err(patched_result.unwrap_err())
                patched = patched_result.unwrap()
                if machine == COFF_MACHINE_AMD64 and
                        relocation.relocation_type == COFF_REL_AMD64_ADDR64 and
                        not resolved_address.absolute:
                    section_base_relocations = section_base_relocations.push(
                        rvas[oi][si] + relocation.virtual_address)
                if machine == COFF_MACHINE_ARM64 and
                        relocation.relocation_type == COFF_REL_ARM64_ADDR64 and
                        not resolved_address.absolute:
                    section_base_relocations = section_base_relocations.push(
                        rvas[oi][si] + relocation.virtual_address)
                if machine == COFF_MACHINE_I386 and
                        relocation.relocation_type == COFF_REL_I386_DIR32 and
                        not resolved_address.absolute:
                    section_base_relocations = section_base_relocations.push(
                        rvas[oi][si] + relocation.virtual_address)
            val logical_size = if section.virtual_size > patched.len(): section.virtual_size else: patched.len()
            val output_name = _coff_output_section_name(section.name)
            if output_name.is_err(): return Err(output_name.unwrap_err())
            var folded_duplicate = false
            if (icf_sections and
                    (section.characteristics & COFF_SECTION_LNK_COMDAT) != 0):
                for emitted in output_sections:
                    if (emitted.virtual_address == rvas[oi][si] and
                            emitted.name == output_name.unwrap()):
                        if (emitted.virtual_size != logical_size or
                                emitted.data != patched or
                                emitted.characteristics != section.characteristics):
                            return Err("COFF ICF produced non-identical folded sections")
                        folded_duplicate = true
            if folded_duplicate:
                si = si + 1
                continue
            for relocation_rva in section_base_relocations:
                base_relocation_rvas = base_relocation_rvas.push(relocation_rva)
            output_sections = output_sections.push(PeImageSection(name: output_name.unwrap(),
                virtual_address: rvas[oi][si], virtual_size: logical_size,
                data: patched, characteristics: section.characteristics))
            si = si + 1
        oi = oi + 1
    if common_layout.size > 0:
        output_sections = output_sections.push(PeImageSection(name: ".bss",
            virtual_address: common_layout.virtual_address,
            virtual_size: common_layout.size, data: [], characteristics: 0xc0000080))
    if import_image.thunk_data.len() > 0:
        output_sections = output_sections.push(PeImageSection(name: ".text",
            virtual_address: import_thunk_rva, virtual_size: import_image.thunk_data.len(),
            data: import_image.thunk_data, characteristics: 0x60000020))
    output_sections = _coff_merge_object_sections(output_sections)
    if export_image.unwrap().len() > 0:
        for section in output_sections:
            if section.name == ".edata":
                return Err("COFF /EXPORT directives conflict with an input .edata section")
    val resources_valid = coff_validate_resource_sections(output_sections)
    if resources_valid.is_err(): return Err(resources_valid.unwrap_err())
    val sorted_exception_table = if machine == COFF_MACHINE_ARM64:
        coff_sort_arm64_exception_table(output_sections)
    elif machine == COFF_MACHINE_I386:
        Ok(output_sections)
    else:
        coff_sort_amd64_exception_table(output_sections)
    if sorted_exception_table.is_err(): return Err(sorted_exception_table.unwrap_err())
    output_sections = sorted_exception_table.unwrap()
    var has_tls_data = false
    for section in output_sections:
        if section.name == ".tls": has_tls_data = true
    val tls_name = _coff_decorate(machine, "_tls_used")
    val tls_directory = _coff_global_symbol_rva(objects, rvas, tls_name)
    if tls_directory.is_ok():
        val attached = coff_attach_tls_directory_sized(
            output_sections, tls_directory.unwrap(),
            if machine == COFF_MACHINE_I386: 24 else: 40)
        if attached.is_err(): return Err(attached.unwrap_err())
        output_sections = attached.unwrap()
    elif has_tls_data:
        return Err("COFF TLS data requires a defined {tls_name} directory symbol")
    val load_config = _coff_global_symbol_rva(objects, rvas, _coff_decorate(machine, "_load_config_used"))
    if load_config.is_ok():
        val attached = coff_attach_amd64_load_config(
            output_sections, load_config.unwrap())
        if attached.is_err(): return Err(attached.unwrap_err())
        output_sections = attached.unwrap()
    if import_image.idata_data.len() > 0:
        output_sections = output_sections.push(PeImageSection(name: ".idata",
            virtual_address: import_idata_rva, virtual_size: import_image.idata_data.len(),
            data: import_image.idata_data, characteristics: 0xc0000040,
            import_directory_size: import_image.descriptor_size,
            iat_offset: import_image.iat_offset, iat_size: import_image.iat_size))
    if export_image.unwrap().len() > 0:
        output_sections = output_sections.push(PeImageSection(name: ".edata",
            virtual_address: export_base_rva,
            virtual_size: export_image.unwrap().len(),
            data: export_image.unwrap(), characteristics: 0x40000040))
    val exports_valid = coff_validate_export_sections(output_sections)
    if exports_valid.is_err(): return Err(exports_valid.unwrap_err())
    if machine == COFF_MACHINE_I386:
        for fixup in import_image.thunk_fixups:
            base_relocation_rvas = base_relocation_rvas.push(fixup)
    val base_relocations = if machine == COFF_MACHINE_I386:
        pe_build_base_relocations(base_relocation_rvas, PE_BASE_RELOCATION_HIGHLOW)
    else:
        pe_build_amd64_base_relocations(base_relocation_rvas)
    if base_relocations.is_err(): return Err(base_relocations.unwrap_err())
    if base_relocations.unwrap().len() > 0 and not policy.fixed_image:
        val relocation_rva = if export_image.unwrap().len() > 0:
            export_base_rva + pe_align_up(export_image.unwrap().len(), policy.section_alignment)
        else:
            export_base_rva
        output_sections = output_sections.push(PeImageSection(name: ".reloc",
            virtual_address: relocation_rva,
            virtual_size: base_relocations.unwrap().len(),
            data: base_relocations.unwrap(), characteristics: 0x42000040))
    val pe_machine = if machine == COFF_MACHINE_ARM64:
        PE_MACHINE_ARM64
    elif machine == COFF_MACHINE_I386:
        PE_MACHINE_I386
    else:
        PE_MACHINE_AMD64
    pe_write_image_policy(output_sections, entry.unwrap(), pe_machine, image_base, policy)

