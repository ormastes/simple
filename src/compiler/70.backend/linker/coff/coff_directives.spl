# Parser for MSVC/LLVM `.drectve` section payloads.
# Unknown directives remain outside this resolution-focused contract; malformed
# forms of the directives we own fail closed rather than being partly applied.

use compiler.backend.linker.coff.coff_object.{CoffObject, COFF_SECTION_LNK_INFO}

struct CoffAlternateName:
    weak_name: text
    default_name: text

struct CoffDirectives:
    default_libraries: [text]
    excluded_default_libraries: [text]
    exclude_all_default_libraries: bool
    fail_if_mismatch: {text: text}
    includes: [text]
    alternate_names: [CoffAlternateName]

fn _coff_directive_tokens(content: text) -> Result<[text], text>:
    var result: [text] = []
    var token = ""
    var quoted = false
    var index: i64 = 0
    while index < content.len():
        val ch = content[index:index + 1]
        if ch == "\"":
            quoted = not quoted
        elif (ch == " " or ch == "\t" or ch == "\r" or ch == "\n") and not quoted:
            if token != "":
                result = result.push(token)
                token = ""
        else:
            token = token + ch
        index = index + 1
    if quoted: return Err("unterminated quote in COFF .drectve section")
    if token != "": result = result.push(token)
    Ok(result)

fn _coff_directive_add_unique(values: [text], value: text) -> [text]:
    if values.contains(value): return values
    values.push(value)

fn coff_parse_directives(content: text) -> Result<CoffDirectives, text>:
    val tokens = _coff_directive_tokens(content)?
    var defaults: [text] = []
    var excluded_defaults: [text] = []
    var exclude_all_defaults = false
    var mismatch: {text: text} = {}
    var includes: [text] = []
    var alternates: [CoffAlternateName] = []
    for token in tokens:
        val lower = token.lower()
        if lower.starts_with("/defaultlib:") or lower.starts_with("-defaultlib:"):
            val value = token.substring("/defaultlib:".len())
            if value == "": return Err("COFF /DEFAULTLIB requires a library name")
            defaults = _coff_directive_add_unique(defaults, value)
        elif lower == "/nodefaultlib" or lower == "-nodefaultlib":
            exclude_all_defaults = true
        elif lower.starts_with("/nodefaultlib:") or lower.starts_with("-nodefaultlib:"):
            val value = token.substring("/nodefaultlib:".len())
            if value == "": return Err("COFF /NODEFAULTLIB requires a library name")
            excluded_defaults = _coff_directive_add_unique(excluded_defaults, value)
        elif lower.starts_with("/include:") or lower.starts_with("-include:"):
            val value = token.substring("/include:".len())
            if value == "": return Err("COFF /INCLUDE requires a symbol name")
            includes = _coff_directive_add_unique(includes, value)
        elif lower.starts_with("/alternatename:") or lower.starts_with("-alternatename:"):
            val value = token.substring("/alternatename:".len())
            val parts = value.split("=")
            if parts.len() != 2 or parts[0] == "" or parts[1] == "":
                return Err("COFF /ALTERNATENAME requires weak=default names")
            var duplicate = false
            for alternate in alternates:
                if alternate.weak_name == parts[0]:
                    if alternate.default_name != parts[1]:
                        return Err("conflicting COFF /ALTERNATENAME for '{parts[0]}'")
                    duplicate = true
            if not duplicate:
                alternates = alternates.push(CoffAlternateName(
                    weak_name: parts[0], default_name: parts[1]))
        elif lower.starts_with("/failifmismatch:") or lower.starts_with("-failifmismatch:"):
            val value = token.substring("/failifmismatch:".len())
            val parts = value.split("=")
            if parts.len() != 2 or parts[0] == "" or parts[1] == "":
                return Err("COFF /FAILIFMISMATCH requires key=value")
            if mismatch.has(parts[0]) and mismatch[parts[0]] != parts[1]:
                return Err("COFF /FAILIFMISMATCH '{parts[0]}' conflicts: " +
                    "'{mismatch[parts[0]]}' versus '{parts[1]}'")
            mismatch[parts[0]] = parts[1]
        elif lower.starts_with("/defaultlib") or lower.starts_with("-defaultlib"):
            return Err("malformed COFF /DEFAULTLIB directive")
        elif lower.starts_with("/nodefaultlib") or lower.starts_with("-nodefaultlib"):
            return Err("malformed COFF /NODEFAULTLIB directive")
        elif lower.starts_with("/include") or lower.starts_with("-include"):
            return Err("malformed COFF /INCLUDE directive")
        elif lower.starts_with("/alternatename") or lower.starts_with("-alternatename"):
            return Err("malformed COFF /ALTERNATENAME directive")
        elif lower.starts_with("/failifmismatch") or lower.starts_with("-failifmismatch"):
            return Err("malformed COFF /FAILIFMISMATCH directive")
    Ok(CoffDirectives(default_libraries: defaults,
        excluded_default_libraries: excluded_defaults,
        exclude_all_default_libraries: exclude_all_defaults,
        fail_if_mismatch: mismatch,
        includes: includes, alternate_names: alternates))

fn coff_collect_directives(objects: [CoffObject]) -> Result<CoffDirectives, text>:
    var defaults: [text] = []
    var excluded_defaults: [text] = []
    var exclude_all_defaults = false
    var mismatch: {text: text} = {}
    var includes: [text] = []
    var alternates: [CoffAlternateName] = []
    for object in objects:
        for section in object.sections:
            if section.name != ".drectve": continue
            if (section.characteristics & COFF_SECTION_LNK_INFO) == 0:
                return Err("COFF .drectve section is missing LNK_INFO")
            var content = ""
            for byte in section.data:
                if byte != 0: content = content + text.from_char_code(byte)
            val parsed = coff_parse_directives(content)?
            for value in parsed.default_libraries:
                defaults = _coff_directive_add_unique(defaults, value)
            for value in parsed.excluded_default_libraries:
                excluded_defaults = _coff_directive_add_unique(excluded_defaults, value)
            if parsed.exclude_all_default_libraries: exclude_all_defaults = true
            for key in parsed.fail_if_mismatch.keys():
                val value = parsed.fail_if_mismatch[key]
                if mismatch.has(key) and mismatch[key] != value:
                    return Err("COFF /FAILIFMISMATCH '{key}' conflicts: " +
                        "'{mismatch[key]}' versus '{value}'")
                mismatch[key] = value
            for value in parsed.includes:
                includes = _coff_directive_add_unique(includes, value)
            for alternate in parsed.alternate_names:
                var duplicate = false
                for existing in alternates:
                    if existing.weak_name == alternate.weak_name:
                        if existing.default_name != alternate.default_name:
                            return Err("conflicting COFF /ALTERNATENAME for '{alternate.weak_name}'")
                        duplicate = true
                if not duplicate: alternates = alternates.push(alternate)
    Ok(CoffDirectives(default_libraries: defaults,
        excluded_default_libraries: excluded_defaults,
        exclude_all_default_libraries: exclude_all_defaults,
        fail_if_mismatch: mismatch,
        includes: includes, alternate_names: alternates))

fn _coff_library_key(name: text) -> text:
    var key = name.trim().lower().replace("\\", "/")
    val parts = key.split("/")
    if parts.len() > 0: key = parts[parts.len() - 1]
    if key.ends_with(".lib"): key = key.substring(0, key.len() - 4)
    key

fn coff_effective_default_libraries(directives: CoffDirectives) -> [text]:
    if directives.exclude_all_default_libraries: return []
    var excluded: [text] = []
    for name in directives.excluded_default_libraries:
        val key = _coff_library_key(name)
        if not excluded.contains(key): excluded = excluded.push(key)
    var result: [text] = []
    for name in directives.default_libraries:
        if not excluded.contains(_coff_library_key(name)):
            result = _coff_directive_add_unique(result, name)
    result

fn coff_resolve_alternate_name(name: text, aliases: {text: text}) -> Result<text, text>:
    var current = name
    var visited: {text: bool} = {}
    while aliases.has(current):
        if visited.has(current):
            return Err("COFF /ALTERNATENAME cycle reaches '{current}'")
        visited[current] = true
        current = aliases[current]
    Ok(current)

fn coff_alternate_name_map(directives: CoffDirectives) -> Result<{text: text}, text>:
    var aliases: {text: text} = {}
    for alternate in directives.alternate_names:
        if aliases.has(alternate.weak_name) and
                aliases[alternate.weak_name] != alternate.default_name:
            return Err("conflicting COFF /ALTERNATENAME for '{alternate.weak_name}'")
        aliases[alternate.weak_name] = alternate.default_name
    for alternate in directives.alternate_names:
        val resolved = coff_resolve_alternate_name(alternate.weak_name, aliases)
        if resolved.is_err(): return Err(resolved.unwrap_err())
    Ok(aliases)

export CoffAlternateName, CoffDirectives
export coff_parse_directives, coff_collect_directives
export coff_resolve_alternate_name, coff_alternate_name_map
export coff_effective_default_libraries
