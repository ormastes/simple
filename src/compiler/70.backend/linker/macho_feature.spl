# Mach-O build tag.
#
# Mach-O object emission and linking are compiled into the compiler only when
# the build target OS is macOS or the `macho` feature tag is requested
# (SIMPLE_FEATURES=macho, e.g. for a cross compiler on Linux/Windows). Every
# Mach-O dispatch point gates on the same condition and reports
# MACHO_NOT_BUILT_ERROR otherwise, so the Mach-O writer/linker modules stay out
# of non-macOS compiler closures.

pub val MACHO_NOT_BUILT_ERROR: text = "Mach-O support not built in this compiler (rebuild with feature macho: SIMPLE_FEATURES=macho)"

pub fn macho_support_built() -> bool:
    @when(os = "macos" or feature = "macho"):
    true
    @else:
    false
    @end

export MACHO_NOT_BUILT_ERROR, macho_support_built
