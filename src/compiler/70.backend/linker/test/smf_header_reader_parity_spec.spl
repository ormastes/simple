# Prevention for bug smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10:
# every standalone SMF header reader must agree on the SAME image in all three
# accepted header forms: the v1.3 96-byte default, the Rust seed's 1.1 stamp of
# that layout, and the legacy packed 128-byte trailer. A reader that hardcodes
# offsets diverges here.
use std.spec.{describe, it, expect}
use compiler.backend.linker.smf_header.{SMF_HEADER_SIZE, SMF_PACKED_HEADER_SIZE, smf_header_from_bytes}
use compiler.backend.linker.smf_reader_memory.{SmfReaderMemory}
use compiler.backend.linker.smf_writer.{SmfWriter, SmfWriterSymbol, SmfWriterSymbolBinding, SmfWriterSymbolType}
use compiler.driver.cache.cache_validator.{SmfValidationSnapshot}
use os.smf.smf_dynlib.{smf_artifact_has_export}
use os.smf.host_target.{smf_host_arch_id}
use app.startup.launch_metadata.{retained_smf_launch_metadata_v1}

fn v13_image() -> [u8]:
    var writer = SmfWriter.create()
    val code: [i64] = [195]
    writer.add_code_section("code", code)
    writer.add_symbol(SmfWriterSymbol(
        name: "parity_probe_v1",
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: code.len(),
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false
    ))
    val built = writer.write()
    if built.is_err():
        return []
    var out: [u8] = []
    for word in built.unwrap():
        out.push(word as u8)
    val hs = out.len() - SMF_HEADER_SIZE
    out[hs + 6] = 0
    out[hs + 7] = smf_host_arch_id()
    # source_hash at repr(C) offset 72
    var i = 0
    while i < 8:
        out[hs + 72 + i] = (0x21 + i) as u8
        i = i + 1
    out

fn body_of(image: [u8]) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < image.len() - SMF_HEADER_SIZE:
        out.push(image[i])
        i = i + 1
    out

# The Rust seed stamps 1.1 on the same 96-byte layout.
fn to_seed_stamp(image: [u8]) -> [u8]:
    var out = image
    out[out.len() - SMF_HEADER_SIZE + 5] = 1
    out

# Legacy packed 128-byte trailer (v1.1) built from the same header fields.
fn to_packed_trailer(image: [u8]) -> [u8]:
    var header = smf_header_from_bytes(image).unwrap()
    header.version_minor = 1
    val packed = header.to_packed_bytes()
    var out = body_of(image)
    var i = 0
    while i < SMF_PACKED_HEADER_SIZE:
        out.push(packed[i])
        i = i + 1
    out

fn check_image(bytes: [u8], label: text):
    val parsed = smf_header_from_bytes(bytes).unwrap()
    val reader = SmfReaderMemory.from_data(bytes).unwrap()
    expect(reader.header.section_count).to_equal(parsed.section_count)
    expect(reader.header.symbol_count).to_equal(parsed.symbol_count)
    expect(reader.sections_offset).to_equal(parsed.section_table_offset)
    # Cache validator agrees on the header position and source hash.
    val snap = SmfValidationSnapshot(data: bytes)
    expect(snap.valid_header()).to_equal(true)
    expect(snap.source_hash()).to_equal(0x2827262524232221)
    # Dynlib preflight accepts the image and finds the export.
    expect(smf_artifact_has_export(bytes, "parity_probe_v1")).to_equal(true)
    # Launch metadata reaches section-table validation (no header/offset error).
    val launch = retained_smf_launch_metadata_v1(bytes, "smf")
    expect(launch.reason == "smf_magic_invalid" or launch.reason == "smf_header_missing").to_equal(false)
    expect(launch.reason == "launch_metadata_section_table_invalid").to_equal(false)
    expect(launch.reason == "smf_data_offset_invalid").to_equal(false)

describe "SMF standalone header readers agree across layouts":
    it "agree on the v1.3 96-byte default image":
        check_image(v13_image(), "v1.3")

    it "agree on the legacy packed 128-byte image":
        check_image(to_packed_trailer(v13_image()), "packed")

    it "agree on the Rust seed 96-byte repr(C) image":
        check_image(to_seed_stamp(v13_image()), "seed")

    it "decoders see identical table geometry for all layouts":
        val v13 = smf_header_from_bytes(v13_image()).unwrap()
        val packed = smf_header_from_bytes(to_packed_trailer(v13_image())).unwrap()
        val seed = smf_header_from_bytes(to_seed_stamp(v13_image())).unwrap()
        expect(seed.section_count).to_equal(v13.section_count)
        expect(packed.section_count).to_equal(v13.section_count)
        expect(seed.symbol_count).to_equal(v13.symbol_count)
        expect(packed.symbol_count).to_equal(v13.symbol_count)
        expect(seed.section_table_offset).to_equal(v13.section_table_offset)
        expect(packed.section_table_offset).to_equal(v13.section_table_offset)
        expect(seed.symbol_table_offset).to_equal(v13.symbol_table_offset)
        expect(packed.symbol_table_offset).to_equal(v13.symbol_table_offset)
