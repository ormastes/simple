# Internal compiler/link-owner transport. These records alone never authorize
# SOURCE: every consumption revalidates the retained emitted bytes and identity.
use std.nogc_sync_mut.io.retained_file.{RetainedFile}
use std.nogc_sync_mut.io.native_tool_authority_v1.{NativeToolAdmissionReceiptV1}
use std.nogc_sync_mut.io.native_runtime_authority_v1.{NativeRuntimeAdmissionReceiptV1}

struct SourceRegionLinkExecutionV1:
    tool: NativeToolAdmissionReceiptV1
    runtime: NativeRuntimeAdmissionReceiptV1
    argument_digest: text
    input_digest: text
    policy: text

struct SourceRegionDescriptorObjectV1:
    binding: text
    table_binding: text
    header_section: i64
    header_offset: u64
    table_section: i64
    table_offset: u64
    allocation_bytes: u64
    slot_count: i64
    table_bytes: u64
    table_digest: text

struct SourceRegionEmissionSealV1:
    instrumentation_abi: i64
    closure_digest: text
    object_digest: text
    descriptors: [SourceRegionDescriptorObjectV1]

class SourceRegionObjectSealV1:
    path: text
    file: RetainedFile
    emission: SourceRegionEmissionSealV1
    identity_digest: text

struct SourceRegionAdmittedObjectV1:
    path: text
    seal: SourceRegionObjectSealV1

class SourceRegionFinalLinkSealV1:
    output: text
    file: RetainedFile
    instrumentation_abi: i64
    closure_digest: text
    input_digest: text
    content_digest: text
    descriptor_count: i64
    native_page_size: u64
    execution: SourceRegionLinkExecutionV1
