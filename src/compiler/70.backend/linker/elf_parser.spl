# ELF Full Object Parser - Pure-Simple ELF32/ELF64 parser with relocations, symbols, string tables.
#
# Extends the read-only elf_inspect.spl inspector into a complete ELF object parser.
# Supports symbol tables (SHT_SYMTAB), string tables (SHT_STRTAB), and RELA sections.
# No file I/O — caller supplies the raw bytes (e.g. from file_read_bytes).

use compiler.backend.linker.elf_inspect.{
    ElfHeader, ElfSectionHeader, ElfInspector,
    elf_parse_header, elf_parse_sections,
    elf_read_u16_le, elf_read_u32_le, elf_read_u64_le,
    ELF32_HEADER_SIZE, ELF32_SHDR_SIZE, ELF64_HEADER_SIZE, ELF64_SHDR_SIZE,
    SHT_NULL, SHT_PROGBITS, SHT_SYMTAB, SHT_STRTAB,
    ET_NONE, ET_REL, ET_EXEC, ET_DYN,
    EM_X86_64, EM_ARM, EM_AARCH64, EM_RISCV
}
use std.string_core.{char_from_code}

# ============================================================================
# Additional ELF Constants
# ============================================================================

# Additional sh_type values
val SHT_RELA: i64 = 4
val SHT_HASH: i64 = 5
val SHT_DYNAMIC: i64 = 6
val SHT_NOTE: i64 = 7
val SHT_NOBITS: i64 = 8
val SHT_REL: i64 = 9

# Special section indices
val SHN_UNDEF: i64 = 0

# Symbol binding (high nibble of st_info)
val STB_LOCAL: i64 = 0
val STB_GLOBAL: i64 = 1
val STB_WEAK: i64 = 2

# Symbol type (low nibble of st_info)
val STT_NOTYPE: i64 = 0
val STT_OBJECT: i64 = 1
val STT_FUNC: i64 = 2
val STT_SECTION: i64 = 3

# ELF64 symbol entry size
val ELF64_SYM_SIZE: i64 = 24

# ELF64 RELA entry size
val ELF64_RELA_SIZE: i64 = 24
val ELF32_SYM_SIZE: i64 = 16
val ELF32_REL_SIZE: i64 = 8
val ELF32_RELA_SIZE: i64 = 12

# ============================================================================
# Structs
# ============================================================================

struct ElfSymbol:
    """Parsed ELF64 symbol table entry."""
    st_name: i64       # index into string table
    st_info: i64       # type (low 4) + binding (high 4)
    st_other: i64
    st_shndx: i64      # section index (SHN_UNDEF=0 means undefined)
    st_value: i64      # symbol value/address
    st_size: i64       # symbol size
    name: text         # resolved name from strtab

struct ElfRelocation:
    """Parsed ELF64 RELA relocation entry."""
    r_offset: i64      # location to apply relocation
    r_info: i64        # symbol index + relocation type (packed)
    r_addend: i64      # addend for RELA
    section_idx: i64   # index (in ElfObject.sections) of the RELA section this came from
    target_section_idx: i64  # sh_info of that RELA section: the section these relocs APPLY TO

struct ElfStringTable:
    """Raw string table data and file offset."""
    data: [u8]         # raw bytes of string table section
    offset: i64        # offset of this section in the file

struct ElfObject:
    """Complete parsed ELF object file."""
    header: ElfHeader
    sections: [ElfSectionHeader]
    symbols: [ElfSymbol]
    relocations: [ElfRelocation]
    strtab: ElfStringTable
    shstrtab: ElfStringTable
    raw: [u8]          # full file bytes

# ============================================================================
# String Table Helpers
# ============================================================================

fn elf_make_empty_strtab() -> ElfStringTable:
    """Return an empty string table sentinel."""
    val empty: [u8] = []
    ElfStringTable(data: empty, offset: 0)

fn elf_parse_string_table(bytes: [u8], section: ElfSectionHeader) -> ElfStringTable:
    """Extract string table bytes from a section.

    Slices the raw section data out of the file byte array.
    Returns an empty table if the section is out of bounds.
    """
    val sh_offset = section.sh_addr   # NOTE: sh_offset is at field sh_addr in ElfSectionHeader
    val sh_size = section.sh_size
    val end = sh_offset + sh_size

    if sh_offset < 0 or end > bytes.len() or sh_size <= 0:
        val empty_data: [u8] = []
        return ElfStringTable(data: empty_data, offset: sh_offset)

    var data: [u8] = []
    var i: i64 = sh_offset
    while i < end:
        data = data.push(bytes[i])
        i = i + 1

    ElfStringTable(data: data, offset: sh_offset)

fn elf_strtab_get(strtab: ElfStringTable, index: i64) -> text:
    """Look up a NUL-terminated string at byte index in the string table.

    Returns empty string if index is out of range or table is empty.
    """
    if index < 0 or index >= strtab.data.len():
        return ""

    var result: text = ""
    var i: i64 = index
    val len = strtab.data.len()
    while i < len:
        val b = strtab.data[i]
        if b == 0:
            return result
        result = result + char_from_code(b as i64)
        i = i + 1

    result

# ============================================================================
# Symbol Helpers
# ============================================================================

fn elf_symbol_binding(sym: ElfSymbol) -> i64:
    """Extract binding from st_info: STB_LOCAL=0, STB_GLOBAL=1, STB_WEAK=2."""
    (sym.st_info >> 4) & 0xf

fn elf_symbol_type(sym: ElfSymbol) -> i64:
    """Extract type from st_info: STT_NOTYPE=0, STT_OBJECT=1, STT_FUNC=2, STT_SECTION=3."""
    sym.st_info & 0xf

# ============================================================================
# Relocation Helpers
# ============================================================================

fn elf_reloc_sym(reloc: ElfRelocation) -> i64:
    """Extract symbol index from r_info (high 32 bits for ELF64)."""
    (reloc.r_info >> 32) & 0xffffffff

fn elf_reloc_type(reloc: ElfRelocation) -> i64:
    """Extract relocation type from r_info (low 32 bits for ELF64)."""
    reloc.r_info & 0xffffffff

fn elf_is_32(bytes: [u8]) -> bool:
    bytes.len() > 4 and bytes[4] == 1

fn elf_signed_u32(value: i64) -> i64:
    if value >= 2147483648: value - 4294967296 else: value

fn elf_sign_extend(value: i64, bits: i64) -> i64:
    val sign = 1 << (bits - 1)
    val modulus = 1 << bits
    if value & sign != 0: value - modulus else: value

fn elf_arm_rel_addend(bytes: [u8], target: ElfSectionHeader,
    reloc: ElfRelocation) -> Result<i64, text>:
    val at = target.sh_addr + reloc.r_offset
    val rtype = elf_reloc_type(reloc)
    var width: i64 = 4
    if rtype == 5 or rtype == 102 or rtype == 103: width = 2
    elif rtype == 8: width = 1
    if reloc.r_offset < 0 or reloc.r_offset + width > target.sh_size or
            at < 0 or at + width > bytes.len():
        return Err("ARM REL relocation field extends beyond its target section")

    if rtype == 0:
        return Ok(0)
    if rtype == 102 or rtype == 103:
        val half = elf_read_u16_le(bytes, at)
        if rtype == 102:
            return Ok(elf_sign_extend((half & 0x7ff) << 1, 12))
        return Ok(elf_sign_extend((half & 0xff) << 1, 9))
    val word = elf_read_u32_le(bytes, at)
    if rtype == 2 or rtype == 3 or rtype == 38:
        return Ok(elf_signed_u32(word))
    if rtype == 5:
        return Ok(elf_sign_extend(elf_read_u16_le(bytes, at), 16))
    if rtype == 8:
        return Ok(elf_sign_extend(bytes[at].to_i64(), 8))
    if rtype == 1 or rtype == 28 or rtype == 29:
        return Ok(elf_sign_extend((word & 0xffffff) << 2, 26))
    if rtype == 10 or rtype == 30:
        val high = elf_read_u16_le(bytes, at)
        val low = elf_read_u16_le(bytes, at + 2)
        val sign = (high >> 10) & 1
        val i1 = 1 - (((low >> 13) & 1) ^ sign)
        val i2 = 1 - (((low >> 11) & 1) ^ sign)
        val encoded = (sign << 24) | (i1 << 23) | (i2 << 22) |
            ((high & 0x3ff) << 12) | ((low & 0x7ff) << 1)
        return Ok(elf_sign_extend(encoded, 25))
    if rtype == 40:
        return Ok(0)
    if rtype == 42:
        return Ok(elf_sign_extend(word & 0x7fffffff, 31))
    if rtype >= 43 and rtype <= 46:
        val immediate = (((word >> 16) & 0xf) << 12) | (word & 0xfff)
        if rtype == 44 or rtype == 46:
            return Ok(immediate << 16)
        return Ok(immediate)
    if rtype >= 47 and rtype <= 50:
        val high = elf_read_u16_le(bytes, at)
        val low = elf_read_u16_le(bytes, at + 2)
        val immediate = ((high & 0xf) << 12) | (((high >> 10) & 1) << 11) |
            (((low >> 12) & 0x7) << 8) | (low & 0xff)
        if rtype == 48 or rtype == 50:
            return Ok(immediate << 16)
        return Ok(immediate)
    Err("unsupported ARM REL implicit-addend relocation type {rtype}")

# ============================================================================
# Section Lookup
# ============================================================================

fn elf_find_section_by_type(obj: ElfObject, sh_type: i64) -> ElfSectionHeader?:
    """Return the first section with the given sh_type, or nil."""
    for sec in obj.sections:
        if sec.sh_type == sh_type:
            return sec
    nil

# ============================================================================
# Symbol Table Parser
# ============================================================================

fn elf_parse_symbols(bytes: [u8], symtab_section: ElfSectionHeader, strtab: ElfStringTable) -> [ElfSymbol]:
    """Parse all ELF64 symbol table entries from a SHT_SYMTAB section.

    ELF64 Sym entry layout (24 bytes):
      offset 0:  st_name  (4 bytes, u32)
      offset 4:  st_info  (1 byte)
      offset 5:  st_other (1 byte)
      offset 6:  st_shndx (2 bytes, u16)
      offset 8:  st_value (8 bytes, u64)
      offset 16: st_size  (8 bytes, u64)
    """
    var symbols: [ElfSymbol] = []

    val sec_offset = symtab_section.sh_addr
    val sec_size = symtab_section.sh_size

    if sec_size <= 0 or sec_offset < 0:
        return symbols

    val end = sec_offset + sec_size
    if end > bytes.len():
        return symbols

    val entry_size = if elf_is_32(bytes): ELF32_SYM_SIZE else: ELF64_SYM_SIZE
    val count = sec_size / entry_size
    var i: i64 = 0
    while i < count:
        val base = sec_offset + i * entry_size

        val st_name = elf_read_u32_le(bytes, base)
        val st_info = if entry_size == ELF32_SYM_SIZE: bytes[base + 12] as i64 else: bytes[base + 4] as i64
        val st_other = if entry_size == ELF32_SYM_SIZE: bytes[base + 13] as i64 else: bytes[base + 5] as i64
        val st_shndx = if entry_size == ELF32_SYM_SIZE: elf_read_u16_le(bytes, base + 14) else: elf_read_u16_le(bytes, base + 6)
        val st_value = if entry_size == ELF32_SYM_SIZE: elf_read_u32_le(bytes, base + 4) else: elf_read_u64_le(bytes, base + 8)
        val st_size = if entry_size == ELF32_SYM_SIZE: elf_read_u32_le(bytes, base + 8) else: elf_read_u64_le(bytes, base + 16)

        val name = elf_strtab_get(strtab, st_name)

        symbols = symbols.push(ElfSymbol(
            st_name: st_name,
            st_info: st_info,
            st_other: st_other,
            st_shndx: st_shndx,
            st_value: st_value,
            st_size: st_size,
            name: name
        ))
        i = i + 1

    symbols

# ============================================================================
# Relocation Table Parser
# ============================================================================

fn elf_parse_relocations(bytes: [u8], rela_section: ElfSectionHeader, section_idx: i64) -> [ElfRelocation]:
    """Parse ELF32/ELF64 REL or RELA entries into canonical ELF64-style r_info.

    ELF64 Rela entry layout (24 bytes):
      offset 0:  r_offset (8 bytes)
      offset 8:  r_info   (8 bytes)
      offset 16: r_addend (8 bytes, signed)
    """
    var relocs: [ElfRelocation] = []

    val sec_offset = rela_section.sh_addr
    val sec_size = rela_section.sh_size

    if sec_size <= 0 or sec_offset < 0:
        return relocs

    val end = sec_offset + sec_size
    if end > bytes.len():
        return relocs

    val elf32 = elf_is_32(bytes)
    val has_addend = rela_section.sh_type == SHT_RELA
    val entry_size = if elf32:
        if has_addend: ELF32_RELA_SIZE else: ELF32_REL_SIZE
    else:
        if has_addend: ELF64_RELA_SIZE else: 16
    val count = sec_size / entry_size
    var i: i64 = 0
    while i < count:
        val base = sec_offset + i * entry_size

        val r_offset = if elf32: elf_read_u32_le(bytes, base) else: elf_read_u64_le(bytes, base)
        val wire_info = if elf32: elf_read_u32_le(bytes, base + 4) else: elf_read_u64_le(bytes, base + 8)
        val r_info = if elf32:
            ((wire_info >> 8) << 32) | (wire_info & 0xff)
        else:
            wire_info
        val r_addend = if not has_addend:
            0
        elif elf32:
            elf_signed_u32(elf_read_u32_le(bytes, base + 8))
        else:
            elf_read_u64_le(bytes, base + 16)

        relocs = relocs.push(ElfRelocation(
            r_offset: r_offset,
            r_info: r_info,
            r_addend: r_addend,
            section_idx: section_idx,
            target_section_idx: rela_section.sh_info
        ))
        i = i + 1

    relocs

# ============================================================================
# Symbol Filter Helpers
# ============================================================================

fn elf_defined_symbols(obj: ElfObject) -> [ElfSymbol]:
    """Return symbols where st_shndx != SHN_UNDEF (defined symbols)."""
    var result: [ElfSymbol] = []
    for sym in obj.symbols:
        if sym.st_shndx != SHN_UNDEF:
            result = result.push(sym)
    result

fn elf_undefined_symbols(obj: ElfObject) -> [ElfSymbol]:
    """Return symbols where st_shndx == SHN_UNDEF (undefined/external references)."""
    var result: [ElfSymbol] = []
    for sym in obj.symbols:
        if sym.st_shndx == SHN_UNDEF:
            result = result.push(sym)
    result

# ============================================================================
# ElfSectionHeader sh_offset accessor
# ============================================================================
#
# NOTE: ElfSectionHeader in elf_inspect.spl stores only:
#   sh_name, sh_type, sh_flags, sh_addr, sh_size
# It does NOT store sh_offset (section file offset).
# We re-parse sh_offset from raw bytes when needed.

fn elf_shdr_offset(bytes: [u8], section_index: i64, shoff: i64) -> i64:
    """Read sh_offset from raw bytes for a section by index."""
    val elf32 = elf_is_32(bytes)
    val size = if elf32: ELF32_SHDR_SIZE else: ELF64_SHDR_SIZE
    val base = shoff + section_index * size
    if elf32: elf_read_u32_le(bytes, base + 16) else: elf_read_u64_le(bytes, base + 24)

fn elf_section_addralign(obj: ElfObject, section_index: i64) -> i64:
    """Read sh_addralign (not carried by ElfSectionHeader) from the raw bytes."""
    val elf32 = elf_is_32(obj.raw)
    val size = if elf32: ELF32_SHDR_SIZE else: ELF64_SHDR_SIZE
    val base = obj.header.e_shoff + section_index * size
    if elf32: elf_read_u32_le(obj.raw, base + 32) else: elf_read_u64_le(obj.raw, base + 48)

fn elf_section_entsize(obj: ElfObject, section_index: i64) -> i64:
    """Read sh_entsize (not carried by ElfSectionHeader) from the raw bytes."""
    val elf32 = elf_is_32(obj.raw)
    val size = if elf32: ELF32_SHDR_SIZE else: ELF64_SHDR_SIZE
    val base = obj.header.e_shoff + section_index * size
    if elf32: elf_read_u32_le(obj.raw, base + 36) else: elf_read_u64_le(obj.raw, base + 56)

fn elf_section_name(obj: ElfObject, section_index: i64) -> text:
    """Resolve a section's name through .shstrtab."""
    elf_strtab_get(obj.shstrtab, obj.sections[section_index].sh_name)

# ============================================================================
# Top-Level Parser
# ============================================================================

fn elf_parse_object(bytes: [u8]) -> Result<ElfObject, text>:
    """Parse a complete ELF32 or ELF64 object file into an ElfObject.

    Parses header, all sections, symbol table, string table, and RELA relocations.
    Returns Err on bad magic, too-short input, or invalid structure.
    """
    val header = elf_parse_header(bytes)?

    # Parse section headers — but ElfSectionHeader only has sh_addr not sh_offset.
    # We need sh_offset for sections, so we build a richer picture from raw bytes.
    val shoff = header.e_shoff
    val shnum = header.e_shnum

    if shoff < 0 or shnum < 0:
        return Err("Invalid section header table offset or count")

    val elf32 = elf_is_32(bytes)
    val shdr_size = if elf32: ELF32_SHDR_SIZE else: ELF64_SHDR_SIZE
    val table_end = shoff + shnum * shdr_size
    if table_end > bytes.len():
        return Err("Section header table extends beyond file end")

    # Collect full section metadata (including sh_offset) directly from raw bytes
    var sections: [ElfSectionHeader] = []
    var i: i64 = 0
    while i < shnum:
        val base = shoff + i * shdr_size

        val sh_name  = elf_read_u32_le(bytes, base + 0)
        val sh_type  = elf_read_u32_le(bytes, base + 4)
        val sh_flags = if elf32: elf_read_u32_le(bytes, base + 8) else: elf_read_u64_le(bytes, base + 8)
        # sh_addr at offset 16 (virtual address) — not what we need for data location
        val sh_off = if elf32: elf_read_u32_le(bytes, base + 16) else: elf_read_u64_le(bytes, base + 24)
        val sh_size = if elf32: elf_read_u32_le(bytes, base + 20) else: elf_read_u64_le(bytes, base + 32)
        val sh_info = if elf32: elf_read_u32_le(bytes, base + 28) else: elf_read_u32_le(bytes, base + 44)

        # We store sh_off in the sh_addr field since ElfSectionHeader has no sh_offset field.
        # All callers in elf_parser use sh_addr as the file offset for data sections.
        sections = sections.push(ElfSectionHeader(
            sh_name: sh_name,
            sh_type: sh_type,
            sh_flags: sh_flags,
            sh_addr: sh_off,   # repurposed: file offset for elf_parser purposes
            sh_size: sh_size,
            sh_info: sh_info
        ))
        i = i + 1

    # Find string tables
    val empty_strtab = elf_make_empty_strtab()

    # .strtab: first SHT_STRTAB section (not shstrtab)
    var strtab = empty_strtab
    var shstrtab = empty_strtab

    val shstrndx = header.e_shstrndx
    if shstrndx >= 0 and shstrndx < sections.len():
        shstrtab = elf_parse_string_table(bytes, sections[shstrndx])

    # Symbol names live in the string table named by the symtab's sh_link.
    # LLVM emits ONE combined .strtab that is also e_shstrndx, so "first
    # STRTAB that is not shstrtab" finds nothing there; honour sh_link first.
    var strtab_found = false
    var t: i64 = 0
    while t < sections.len():
        if sections[t].sh_type == SHT_SYMTAB:
            val link_offset = if elf32: 24 else: 40
            val link = elf_read_u32_le(bytes, shoff + t * shdr_size + link_offset)
            if link > 0 and link < sections.len() and sections[link].sh_type == SHT_STRTAB:
                strtab = elf_parse_string_table(bytes, sections[link])
                strtab_found = true
            t = sections.len()
        t = t + 1

    # Fallback: first SHT_STRTAB section that is not shstrtab
    var j: i64 = 0
    while j < sections.len() and not strtab_found:
        if j != shstrndx and sections[j].sh_type == SHT_STRTAB:
            strtab = elf_parse_string_table(bytes, sections[j])
            strtab_found = true
        j = j + 1

    # Find and parse symbol table
    var symbols: [ElfSymbol] = []
    for sec in sections:
        if sec.sh_type == SHT_SYMTAB:
            symbols = elf_parse_symbols(bytes, sec, strtab)

    # Find and parse all RELA sections, tagging each relocation with the
    # section index it came from (section_idx) so callers can attribute
    # relocations back to their target section instead of losing that
    # information by merging blindly.
    var relocations: [ElfRelocation] = []
    var sec_i: i64 = 0
    while sec_i < sections.len():
        if sections[sec_i].sh_type == SHT_RELA or sections[sec_i].sh_type == SHT_REL:
            val rela_relocs = elf_parse_relocations(bytes, sections[sec_i], sec_i)
            var k: i64 = 0
            while k < rela_relocs.len():
                var reloc = rela_relocs[k]
                if elf32 and header.e_machine == EM_ARM and sections[sec_i].sh_type == SHT_REL:
                    if reloc.target_section_idx < 0 or reloc.target_section_idx >= sections.len():
                        return Err("ARM REL relocation names an invalid target section")
                    val addend = elf_arm_rel_addend(
                        bytes, sections[reloc.target_section_idx], reloc)?
                    reloc = ElfRelocation(
                        r_offset: reloc.r_offset,
                        r_info: reloc.r_info,
                        r_addend: addend,
                        section_idx: reloc.section_idx,
                        target_section_idx: reloc.target_section_idx)
                relocations = relocations.push(reloc)
                k = k + 1
        sec_i = sec_i + 1

    Ok(ElfObject(
        header: header,
        sections: sections,
        symbols: symbols,
        relocations: relocations,
        strtab: strtab,
        shstrtab: shstrtab,
        raw: bytes
    ))

