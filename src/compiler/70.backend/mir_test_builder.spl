"""
# MIR Test Builder — Backend Capability Check (thin, real wrapper)

Lane MTB1, 2026-07-30
(doc/08_tracking/bug/backend_capability_spec_fictional_test_builder_api_2026-07-30.md).

Answers `MirTestCase.is_supported(BackendTarget)` / `.instruction_count()` for
`test/01_unit/compiler/backend/backend_capability_spec.spl`'s previously-commented
"Backend Capability Detection" / "Backend Selection Logic" / "Backend Fallback
Behavior" groups.

This is a THIN wrapper: it records what the caller asked for as a small
op list, then `is_supported()` replays those ops against the REAL backend
entry points (`MirToLlvm.translate_binop`/`translate_simd_horizontal`,
`VulkanCodegenBackend.compile_kernel`, `cranelift_compile_module_direct`) and reports
whether that backend genuinely accepts them — it never consults a hand-written
per-instruction boolean table (that was lane CAP1's complaint about the
original design; see `capability_tracker.spl`'s `create_default_tracker()`
for what a hardcoded, unverified table looks like).

`BackendTarget.Interpreter` is the one case answered without invoking a
translator: the tree-walk interpreter has no separate "lowering" a caller can
query — it is the universal fallback every other backend's unsupported-op
panic message names as the alternative (see `c_backend_stubs.spl` /
`_MirToLlvm/aggregate_intrinsics.spl` "... use the interpreter" style
messages). Treating that architectural fact as `true` is not the same kind of
per-instruction guess the removed table made.

`BackendTarget.Cranelift` has no lighter single-instruction entry point the
way MirToC/MirToLlvm do (Cranelift lowers by emitting real machine code via
SFFI, not text) -- verifying it means going through real AOT object emission
(`cranelift_compile_module_direct`). That path is exercised here for basic
arithmetic only, since that's the only Cranelift claim the spec makes.
"""

use compiler.backend.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.backend.vulkan_backend.{VulkanCodegenBackend}
use compiler.backend.backend.cranelift_codegen_adapter.{cranelift_compile_module_direct}
use compiler.backend.backend.backend_types.{CodegenTarget, compileoptions_default_options}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_types.{LocalId}  # explicit: a glob is not an import-origin for surface projection

# Backend targets a capability check can be asked about.
enum BackendTarget:
    Cranelift
    LLVM
    Vulkan
    Interpreter

# A recorded MIR-shaped operation. Honest bookkeeping only -- no
# support/unsupported claim is attached here; `is_supported()` derives that
# by actually asking a real backend.
enum TbOp:
    ConstInt(i64, i64)
    ConstFloat(i64, f64)
    Add(i64, i64, i64)
    Mul(i64, i64, i64)
    Ret(i64)
    RetVoid
    VecLit(i64, [i64])
    VecSum(i64, i64)
    GpuGlobalId(i64, i64)
    GpuBarrier
    GpuAtomicAdd(i64, i64, i64)
    ActorSpawn(i64, i64)

class MirTestBuilder:
    ops: [TbOp]

    static fn new() -> MirTestBuilder:
        MirTestBuilder(ops: [])

    me vreg(id: i64) -> i64:
        id

    me block(id: i64) -> i64:
        id

    me const_int(dest: i64, value: i64):
        self.ops.push(TbOp.ConstInt(dest, value))

    me const_float(dest: i64, value: f64):
        self.ops.push(TbOp.ConstFloat(dest, value))

    me add(dest: i64, left: i64, right: i64):
        self.ops.push(TbOp.Add(dest, left, right))

    me mul(dest: i64, left: i64, right: i64):
        self.ops.push(TbOp.Mul(dest, left, right))

    me ret(v: i64):
        self.ops.push(TbOp.Ret(v))

    me ret_void():
        self.ops.push(TbOp.RetVoid)

    me vec_lit(dest: i64, elems: [i64]):
        self.ops.push(TbOp.VecLit(dest, elems))

    me vec_sum(dest: i64, vec_id: i64):
        self.ops.push(TbOp.VecSum(dest, vec_id))

    me gpu_global_id(dest: i64, dim: i64):
        self.ops.push(TbOp.GpuGlobalId(dest, dim))

    me gpu_barrier():
        self.ops.push(TbOp.GpuBarrier)

    me gpu_atomic_add(dest: i64, ptr: i64, value: i64):
        self.ops.push(TbOp.GpuAtomicAdd(dest, ptr, value))

    me actor_spawn(dest: i64, body: i64):
        self.ops.push(TbOp.ActorSpawn(dest, body))

    fn build() -> MirTestCase:
        MirTestCase(ops: self.ops)

class MirTestCase:
    ops: [TbOp]

    fn instruction_count() -> i64:
        self.ops.len()

    fn is_supported(target: BackendTarget) -> bool:
        match target:
            case Interpreter:
                true
            case LLVM:
                mtb1_llvm_supports(self.ops)
            case Vulkan:
                mtb1_vulkan_supports(self.ops)
            case Cranelift:
                mtb1_cranelift_supports(self.ops)

# ============================================================================
# Real LLVM check -- drives MirToLlvm.translate_binop/translate_simd_horizontal
# and reports whether the emitted text contains the backend's real
# "does not support" panic marker (same marker the 6 already-passing tests
# in backend_capability_spec.spl assert on for MatMul/Transpose).
# ============================================================================

fn mtb1_llvm_supports(ops: [TbOp]) -> bool:
    val translator = MirToLlvm.create("mtb1.capability_probe", CodegenTarget.X86_64, nil)
    for op in ops:
        match op:
            case ConstInt(dest, _value):
                translator.local_types[dest] = "i64"
            case ConstFloat(dest, _value):
                translator.local_types[dest] = "f64"
            case Add(dest, left, right):
                translator.local_types[dest] = "i64"
                translator.local_types[left] = "i64"
                translator.local_types[right] = "i64"
                translator.translate_binop(
                    LocalId(id: dest),
                    MirBinOp.Add,
                    mir_operand_copy(LocalId(id: left)),
                    mir_operand_copy(LocalId(id: right))
                )
            case Mul(dest, left, right):
                translator.local_types[dest] = "i64"
                translator.local_types[left] = "i64"
                translator.local_types[right] = "i64"
                translator.translate_binop(
                    LocalId(id: dest),
                    MirBinOp.Mul,
                    mir_operand_copy(LocalId(id: left)),
                    mir_operand_copy(LocalId(id: right))
                )
            case VecSum(dest, vec_id):
                translator.local_types[dest] = "i64"
                translator.local_types[vec_id] = "ptr"
                translator.translate_simd_horizontal(
                    LocalId(id: dest),
                    mir_operand_copy(LocalId(id: vec_id)),
                    "vec_sum"
                )
            case _:
                ()
    val output = translator.builder.build() + "\n" + translator.string_global_text
    not output.contains("does not support")

# ============================================================================
# Real Vulkan check -- drives VulkanCodegenBackend.compile_kernel with a real MirBody
# built from the recorded ops (same construction pattern proven by
# test/01_unit/compiler/backend/vulkan_backend_intensive_spec.spl). A
# GpuAtomicAdd op is expanded into the real prerequisite sequence Vulkan
# requires (GpuSharedAlloc + GetElementPtr) since the thin builder API only
# takes (dest, ptr, value) -- the shared-memory setup those calls skip is not
# optional in the real backend.
# ============================================================================

fn mtb1_vulkan_supports(ops: [TbOp]) -> bool:
    val u32_ty = MirType(kind: MirTypeKind.U32)
    val i64_ty = MirType.i64()
    val ptr_u32_ty = MirType.ptr(u32_ty, true)
    var locals: [MirLocal] = []
    var instructions: [MirInst] = []
    var declared: Dict<i64, bool> = {}
    for op in ops:
        match op:
            case ConstInt(dest, value):
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: u32_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.Const(LocalId(id: dest), MirConstValue.Int(value), u32_ty), span: nil))
            case GpuGlobalId(dest, dim):
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: i64_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: dest), dim), span: nil))
            case GpuBarrier:
                instructions = instructions.push(MirInst(kind: MirInstKind.GpuBarrier(GpuBarrierScope.Workgroup), span: nil))
            case GpuAtomicAdd(dest, ptr, value):
                if not declared.has(ptr):
                    locals = locals.push(MirLocal(id: LocalId(id: ptr), name: nil, type_: ptr_u32_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[ptr] = true
                val gep_id = dest + 500000
                if not declared.has(gep_id):
                    locals = locals.push(MirLocal(id: LocalId(id: gep_id), name: nil, type_: ptr_u32_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[gep_id] = true
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: u32_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.GpuSharedAlloc(LocalId(id: ptr), u32_ty, 4), span: nil))
                instructions = instructions.push(MirInst(kind: MirInstKind.GetElementPtr(LocalId(id: gep_id), mir_operand_copy(LocalId(id: ptr)), [MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), u32_ty))]), span: nil))
                instructions = instructions.push(MirInst(kind: MirInstKind.GpuAtomicOp(LocalId(id: dest), GpuAtomicOpKind.Add, mir_operand_copy(LocalId(id: gep_id)), mir_operand_copy(LocalId(id: value))), span: nil))
            case _:
                ()
    val body = MirBody(
        name: "mtb1_vulkan_probe",
        blocks: [MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: instructions, terminator: MirTerminator.Ret(nil))],
        locals: locals,
        arg_count: 0,
        return_ty: MirType.unit()
    )
    val backend = VulkanCodegenBackend.create_with_options([1, 3], compileoptions_default_options())
    val result = backend.compile_kernel("mtb1_vulkan_probe", body)
    result.is_ok()

# ============================================================================
# Real Cranelift check -- drives an actual AOT object-file compile via
# `cranelift_compile_module_direct`. There is no lighter single-instruction
# Cranelift entry point (its `cl_translate_*` helpers need a live builder
# context that only a real module compile creates), so this is the honest
# floor for verifying Cranelift support rather than a table lookup.
# ============================================================================

fn mtb1_cranelift_supports(ops: [TbOp]) -> bool:
    val i64_ty = MirType.i64()
    var locals: [MirLocal] = []
    var instructions: [MirInst] = []
    var declared: Dict<i64, bool> = {}
    var ret_local: i64 = -1
    for op in ops:
        match op:
            case ConstInt(dest, value):
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: i64_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.Const(LocalId(id: dest), MirConstValue.Int(value), i64_ty), span: nil))
            case Add(dest, left, right):
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: i64_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.BinOp(LocalId(id: dest), MirBinOp.Add, mir_operand_copy(LocalId(id: left)), mir_operand_copy(LocalId(id: right))), span: nil))
            case Mul(dest, left, right):
                if not declared.has(dest):
                    locals = locals.push(MirLocal(id: LocalId(id: dest), name: nil, type_: i64_ty, kind: LocalKind.Temp, is_ghost: false))
                    declared[dest] = true
                instructions = instructions.push(MirInst(kind: MirInstKind.BinOp(LocalId(id: dest), MirBinOp.Mul, mir_operand_copy(LocalId(id: left)), mir_operand_copy(LocalId(id: right))), span: nil))
            case Ret(v):
                ret_local = v
            case _:
                ()
    val return_type = if ret_local >= 0: i64_ty else: MirType.unit()
    val terminator = if ret_local >= 0: MirTerminator.Ret(Some(mir_operand_copy(LocalId(id: ret_local)))) else: MirTerminator.Ret(nil)
    val func = MirFunction(
        symbol: SymbolId(id: 1), name: "mtb1_cranelift_probe",
        signature: MirSignature(params: [], return_type: return_type, is_variadic: false),
        locals: locals,
        blocks: [MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: instructions, terminator: terminator)],
        entry_block: BlockId.entry(), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: nil,
        type_bindings: {}, layout_phase: nil, is_kernel: false,
        gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[func.symbol] = func
    val module = MirModule(name: "mtb1_cranelift_probe_mod", functions: functions, statics: {}, constants: {}, types: {})
    val result = cranelift_compile_module_direct(compileoptions_default_options(), module)
    result.is_ok()
