use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_control_projection.{strict_riscv_scalar_control_projection_hwir}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult, render_strict_hwir_vhdl}

pub fn compile_strict_riscv_scalar_control_projection_product(module_name: text,
    config: CoreConfig, instruction: u32) -> HwirStrictVhdlResult:
    val module = strict_riscv_scalar_control_projection_hwir(module_name, config, instruction)
    if module.is_err(): return HwirStrictVhdlResult.rejected(module.err().unwrap())
    val rendered = render_strict_hwir_vhdl(module.ok().unwrap())
    if not rendered.is_success(): return rendered
    HwirStrictVhdlResult.emitted(module.ok().unwrap(), rendered.vhdl,
        "hwir-gen2-scalar-control-projection-v1")
