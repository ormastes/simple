# Integer SSA values use I64 storage even when their MIR type is narrow.
use std.nogc_sync_mut.sffi.codegen.{cranelift_iconst, cranelift_isub, cranelift_ireduce, cranelift_sextend}

fn cranelift_negate_integer_i64(ctx: i64, value: i64, signed_narrow_type: i64) -> i64:
    """Negate uniform-I64 storage and restore a narrow signed result.

    signed_narrow_type is the Cranelift I8/I16/I32 code (1/2/3), or zero
    for other integer types. Unsigned normalization remains with the caller.
    """
    val zero = cranelift_iconst(ctx, 4, 0)
    val negated = cranelift_isub(ctx, zero, value)
    if signed_narrow_type >= 1 and signed_narrow_type <= 3:
        val reduced = cranelift_ireduce(ctx, signed_narrow_type, negated)
        return cranelift_sextend(ctx, 4, reduced)
    negated
