# Runtime-symbol owner switch for hosted native links (--runtime-owner).
#
#   c       (default) the C runtime owns every rt_* name it defines. With
#           simple_native_all on COFF the duplicate-free core-C composition is
#           compiled and the Rust archive is ceded to Rust-only symbols
#           (compiler.backend.linker.coff.coff_runtime_owner).
#   rust    the Rust seed runtime owns the overlap; the C handle family is
#           renamed private (runtime_thread_rust_owner_v1). Kept for A/B.
#   simple  fails closed: no pure-Simple owner set exists for the hosted
#           runtime symbol classes yet.
# The CLI flag `native-build --runtime-owner=<owner>` sets SIMPLE_RUNTIME_OWNER.

use compiler.backend.linker.coff.coff_runtime_owner.{runtime_owner_select_v1, runtime_owner_object_definitions_v1, runtime_owner_cede_archive_file_v1, runtime_owner_write_bytes_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{env_get, file_copy, file_exists, file_hash_sha256, file_read_bytes, dir_create_all}
use std.nogc_sync_mut.io.native_tool_authority_v1.{native_tool_strict_requested_v1}

pub fn llvm_runtime_owner_v1() -> Result<text, text>:
    runtime_owner_select_v1("", env_get("SIMPLE_RUNTIME_OWNER") ?? "")

pub fn llvm_runtime_owner_compile_bundle_v1(owner: text, runtime_bundle: text,
        native_all: text, coff: bool) -> text:
    """owner=c with a COFF native-all link compiles the duplicate-free core-C
    composition: the ordinary one also carries runtime.c, whose ~50 names
    runtime_native.c already defines, which a strict link cannot accept."""
    if owner == "c" and native_all != "" and coff: return "core-c"
    runtime_bundle

fn _runtime_owner_dir_of(path: text) -> text:
    val normalized: text = path.replace("\\", "/")
    val parts = normalized.split("/")
    var dir = ""
    var i: i64 = 0
    while i < parts.len() - 1:
        dir = if i == 0: parts[i] else: dir + "/" + parts[i]
        i = i + 1
    dir

pub fn llvm_runtime_owner_c_archive_v1(native_all: text, c_objects: [text],
        cache_root: text) -> Result<text, text>:
    """The native_all archive to link under owner=c.

    Every external name the C runtime objects define is ceded by the Rust
    archive, so the C copy is the only definition and no /FORCE:MULTIPLE is
    needed. The derived archive is cached by the content of every input and
    sealed beside a copy of the producer's LLVM-C.lib, which the MSVC link
    takes from the archive's own directory. An archive that is already
    single-owner (for example one prepared by
    scripts/bootstrap/prepare-runtime-owner.shs) is linked unchanged."""
    var identity = "runtime-owner-c-v1;" + file_hash_sha256(native_all)
    for object in c_objects:
        identity = identity + ";" + file_hash_sha256(object)
    val key = sha256_text(identity).substring(0, 24)
    val dir = cache_root + "/runtime_owner_c/" + key
    val derived = dir + "/simple_native_all.lib"
    val sealed = dir + "/LLVM-C.lib"
    if file_exists(derived) and file_exists(sealed):
        return Ok(derived)
    var objects: [[u8]] = []
    for object in c_objects:
        val bytes = file_read_bytes(object)
        if bytes.len() == 0: return Err("runtime owner c: cannot read C runtime object {object}")
        objects.push(bytes)
    val owned = runtime_owner_object_definitions_v1(objects)
    val ceded = match runtime_owner_cede_archive_file_v1(native_all, owned):
        case Ok(result): result
        case Err(reason): return Err(reason)
    if ceded.undefined == 0:
        return Ok(native_all)
    if native_tool_strict_requested_v1():
        return Err("runtime owner c: {native_all} still defines {ceded.undefined} C-owned symbols; a managed link admits only a pre-ceded archive (scripts/bootstrap/prepare-runtime-owner.shs)")
    val producer_llvm = _runtime_owner_dir_of(native_all) + "/LLVM-C.lib"
    if not file_exists(producer_llvm):
        return Err("runtime owner c: producer runtime authority is missing LLVM-C.lib beside {native_all}")
    if not dir_create_all(dir): return Err("runtime owner c: cannot create {dir}")
    if not runtime_owner_write_bytes_v1(derived, ceded.bytes):
        return Err("runtime owner c: cannot write {derived}")
    if not file_copy(producer_llvm, sealed):
        return Err("runtime owner c: cannot seal LLVM-C.lib into {dir}")
    print "[runtime-owner] c: ceded {ceded.undefined} Rust definitions in {ceded.members} members ({ceded.demoted} COMDATs demoted) -> {derived}"
    Ok(derived)

export llvm_runtime_owner_v1, llvm_runtime_owner_compile_bundle_v1
export llvm_runtime_owner_c_archive_v1
