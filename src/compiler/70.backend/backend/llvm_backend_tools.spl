# SFFI for reading files (object code + optimized IR)
extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_env_get(key: text) -> text
extern fn rt_file_write_text_at(path: text, offset: i64, data: text) -> i64
extern fn rt_secure_temp_dir(parent: text, prefix: text) -> text
extern fn rt_file_publish_noreplace(staged_path: text, destination: text) -> i64

fn llvm_bootstrap_last_object_path() -> text:
    "{_get_temp_dir()}/simple_llvm_{getpid()}.o"

pub fn llvm_debug_artifact_paths() -> (text, text, text):
    """Current process's textual IR, bitcode, and object artifact paths."""
    val prefix = "{_get_temp_dir()}/simple_llvm_{getpid()}"
    ("{prefix}.ll", "{prefix}.bc", "{prefix}.o")

# ============================================================================
# LLVM IR → Object Code Compilation (via llc CLI)
# ============================================================================

pub struct LlvmObjectCode:
    """Object code bytes with extracted symbol information."""
    bytes: [u8]
    symbols: [CompiledSymbol]

pub fn llvm_object_code_bytes(obj: LlvmObjectCode) -> [u8]:
    obj.bytes

pub fn llvm_object_code_symbols(obj: LlvmObjectCode) -> [CompiledSymbol]:
    obj.symbols

fn extract_symbols_nm(obj_path: text) -> [CompiledSymbol]:
    """Extract defined symbols from an object file using nm.

    Parses nm output to identify function, data, and constant symbols.
    Skips undefined (U) and weak (W/w) symbols.
    """
    val (nm_out, nm_err, nm_code) = backend_shell_tuple("nm '{obj_path}' 2>/dev/null")
    if nm_code != 0:
        return []

    var symbols: [CompiledSymbol] = []
    val lines = nm_out.split("\n")
    for line in lines:
        if line == "":
            continue
        # Filter empty parts from consecutive spaces
        val raw_parts = line.split(" ")
        var parts: [text] = []
        for p in raw_parts:
            if p != "":
                parts.push(p)
        val plen = parts.len()
        if plen < 2:
            continue

        # nm output: "address TYPE name" (3+ parts) or "TYPE name" (2 parts)
        var type_code = ""
        var sym_name = ""
        if plen >= 3:
            type_code = parts[plen - 2]
            sym_name = parts[plen - 1]
        else:
            type_code = parts[0]
            sym_name = parts[1]

        if sym_name == "":
            continue

        # Skip undefined and weak symbols
        if type_code == "U" or type_code == "u":
            continue
        if type_code == "W" or type_code == "w":
            continue
        if type_code == "V" or type_code == "v":
            continue

        # Map type code to CompiledSymbolKind
        var kind = CompiledSymbolKind.Function
        if type_code == "T" or type_code == "t":
            kind = CompiledSymbolKind.Function
        elif type_code == "D" or type_code == "d":
            kind = CompiledSymbolKind.Data
        elif type_code == "B" or type_code == "b":
            kind = CompiledSymbolKind.Data
        elif type_code == "R" or type_code == "r":
            kind = CompiledSymbolKind.Const
        else:
            continue

        val sym = CompiledSymbol(name: sym_name, kind: kind, address: 0, size: 0)
        symbols.push(sym)

    symbols

pub fn compile_ir_to_object(llvm_ir: text, config: LlvmTargetConfig, opt_level: OptimizationLevel) -> Result<LlvmObjectCode, text>:
    """Compile LLVM IR text to object code bytes via llc CLI.

    Writes IR to a temp file, invokes llc, reads back the object bytes.
    Requires llc to be installed (apt install llvm / brew install llvm).

    Tries llc-18, llc-17, llc-16, llc in order (newer versions preferred).
    """
    # Find llc binary
    val llc = find_llc()
    if llc == "":
        var probed = ""
        for path in tool_probe_locations("llc"):
            probed = probed + "  Checked: {path}\n"
        return Err(
            "llc not found. Please install LLVM:\n" +
            "  Ubuntu/Debian: apt install llvm\n" +
            "  macOS: brew install llvm\n" +
            "  Arch: pacman -S llvm\n" +
            "  Windows: choco install llvm\n" +
            probed
        )
    val (ir_path, bitcode_path, obj_path) = llvm_debug_artifact_paths()
    if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
        print "[llvm-tools] ir {ir_path}"
        print "[llvm-tools] obj {obj_path}"

    # Write IR to temp file
    val bootstrap_io = (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
    var wrote_ir = false
    if bootstrap_io:
        print "[llvm-tools] write-at:start"
        rt_file_write_text_at(ir_path, 0, llvm_ir)
        print "[llvm-tools] write-at:done"
        wrote_ir = file_exists(ir_path)
    else:
        wrote_ir = file_write(ir_path, llvm_ir)
    if not wrote_ir:
        if bootstrap_io:
            print "[llvm-tools] write-failed"
        return Err("Failed to write LLVM IR to {ir_path}")

    # Optional pure-Simple diagnostic pipeline:
    # MIR -> textual .ll -> llvm-as .bc -> opt verify -> llc object.
    # This isolates malformed text, invalid bitcode, and target-codegen errors.
    val bitcode_debug = (rt_env_get("SIMPLE_LLVM_BITCODE_DEBUG") ?? "") == "1"
    var compile_input_path = ir_path
    if bitcode_debug:
        val llvm_as = find_llvm_as()
        if llvm_as == "":
            return Err("SIMPLE_LLVM_BITCODE_DEBUG requires llvm-as; textual IR preserved at {ir_path}")
        val (as_out, as_err, as_code) = process_run(llvm_as, [ir_path, "-o", bitcode_path])
        if as_code != 0:
            return Err("llvm-as failed (exit {as_code}); textual IR preserved at {ir_path}:\n{as_out}{as_err}")

        val opt_tool = find_opt()
        if opt_tool == "":
            return Err("SIMPLE_LLVM_BITCODE_DEBUG requires opt; IR={ir_path} bitcode={bitcode_path}")
        val (verify_out, verify_err, verify_code) = process_run(
            opt_tool, ["-passes=verify", "-disable-output", bitcode_path]
        )
        if verify_code != 0:
            return Err("LLVM bitcode verify failed (exit {verify_code}); IR={ir_path} bitcode={bitcode_path}:\n{verify_out}{verify_err}")
        compile_input_path = bitcode_path
        print "[llvm-bitcode-debug] ir {ir_path}"
        print "[llvm-bitcode-debug] bitcode {bitcode_path}"

    # Determine optimization flag
    var opt_flag = "-O0"
    if opt_level == OptimizationLevel.Size:
        opt_flag = "-Oz"
    elif opt_level == OptimizationLevel.Speed:
        opt_flag = "-O2"
    elif opt_level == OptimizationLevel.Aggressive:
        opt_flag = "-O3"
    elif opt_level == OptimizationLevel.Debug:
        opt_flag = "-O0"

    # Build llc command
    val triple = config.triple.to_text()
    var cpu = config.to_cpu_string()
    if cpu == "x86-64-v1":
        cpu = "x86-64"
    val target_flags = llvm_target_flags(config)
    val cmd = if bootstrap_io:
        "{llc} --filetype=obj --relocation-model=pic --function-sections --data-sections -o {obj_path} {compile_input_path} 2>&1"
    else:
        "{llc} --filetype=obj --relocation-model=pic --function-sections --data-sections -mtriple={triple} -mcpu={cpu}{target_flags} {opt_flag} -o {obj_path} {compile_input_path} 2>&1"
    var llc_out = ""
    var llc_err = ""
    var llc_code = 0
    val target = rt_env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    if target.ends_with("-simpleos"):
        var llc_args: [text] = [
            "--filetype=obj", "--relocation-model=pic", "--function-sections", "--data-sections",
            "-mtriple={triple}", "-mcpu={cpu}", opt_flag, "-o", obj_path, compile_input_path
        ]
        if config.features.len() > 0:
            llc_args.push("-mattr={config.to_feature_string()}")
        match config.abi:
            case Some(abi): llc_args.push("-target-abi={abi}")
            case nil: ()
        val (direct_out, direct_err, direct_code) = process_run(llc, llc_args)
        llc_out = direct_out
        llc_err = direct_err
        llc_code = direct_code
    else:
        val (shell_out, shell_err, shell_code) = backend_shell_tuple(cmd)
        llc_out = shell_out
        llc_err = shell_err
        llc_code = shell_code
    if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
        print "[llvm-tools] llc-done"

    if llc_code != 0:
        file_delete(obj_path)
        if bootstrap_io:
            print "[llvm-direct] failed-ir {ir_path}"
            return Err("llc failed during bootstrap; preserved LLVM IR path printed above")
        return Err("llc failed (exit {llc_code}):\n{llc_out}{llc_err}\n\nCommand: {cmd}")
    elif bootstrap_io and file_exists(obj_path):
        print "[llvm-tools] llc-object"

    # Clean up IR file only after successful llc. On failure, preserve it so
    # native-build diagnostics can point at the malformed IR.
    # SIMPLE_KEEP_LLVM_IR=1 preserves the .ll even on success for debugging.
    if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") != "1" and (rt_env_get("SIMPLE_KEEP_LLVM_IR") ?? "") != "1" and not bitcode_debug:
        file_delete(ir_path)
        if file_exists(bitcode_path):
            file_delete(bitcode_path)

    # Extract symbols before deleting the object file
    val symbols = extract_symbols_nm(obj_path)

    # Read object bytes
    val bytes = rt_file_read_bytes(obj_path)
    if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
        print "[llvm-tools] read-bytes"
    if not bootstrap_io:
        file_delete(obj_path)

    if bytes == nil:
        if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
            print "[llvm-tools] bytes-nil"
        return Err("Failed to read compiled object file: {obj_path}")

    # Unwrap: under the seed interpreter rt_file_read_bytes returns an
    # Option-wrapped array (same extern convention as rt_env_get ?? "").
    # Without this, the Some-wrapped value flows into CodegenOutput.object's
    # `[u8]` param, constructor_overload_score rejects it, and the build dies
    # with the misleading "unknown static method object on class CodegenOutput"
    # (interpreter_method/special/objects.rs:49 scores Some(_) vs Array as
    # no-match). Native builds return the bare array; ?? [] is identity there.
    val byte_arr: [u8] = bytes ?? []
    Ok(LlvmObjectCode(bytes: byte_arr, symbols: symbols))

fn llvm_object_stage_fail(
    stage_dir: text, diagnostic_path: text,
    message: text, status: i64
) -> i64:
    var final_message = message
    if not dir_remove(stage_dir, true):
        final_message = "{message}; private staging cleanup failed"
    backend_aot_write_diagnostic(diagnostic_path, final_message)
    if status == 0: 1 else: status

pub fn compile_ir_to_object_path(
    llvm_ir: text, config: LlvmTargetConfig, opt_level: OptimizationLevel,
    obj_path: text, diagnostic_path: text
) -> i64:
    """Compile directly into caller-owned storage and return scalar status."""
    # Keep the rendered triple owned by this frame.  Returning the interpolated
    # text from LlvmTargetTriple.to_text() leaves the self-hosted caller holding
    # the callee's temporary payload; later process/file calls can then turn it
    # into `<invalid-heap:...>` before llc consumes argv.
    var frozen_target_triple = (
        "{config.triple.arch}-{config.triple.vendor}-{config.triple.os}")
    match config.triple.env:
        case Some(target_env):
            frozen_target_triple = "{frozen_target_triple}-{target_env}"
        case nil: ()
    val parent = dirname(obj_path)
    val stage_dir = rt_secure_temp_dir(parent, "simple-llvm-aot")
    if stage_dir == "":
        backend_aot_write_diagnostic(
            diagnostic_path, "secure temporary directory creation failed")
        return 1
    val ir_path = stage_dir + "/module.ll"
    val bitcode_path = stage_dir + "/module.bc"
    val staged_obj_path = stage_dir + "/module.o"
    val llc = find_llc()
    if llc == "":
        return llvm_object_stage_fail(
            stage_dir, diagnostic_path, "llc not found", 1)
    val bootstrap_io = (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"
    val wrote_ir = if bootstrap_io:
        rt_file_write_text_at(ir_path, 0, llvm_ir)
        file_exists(ir_path)
    else:
        file_write(ir_path, llvm_ir)
    if not wrote_ir:
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "Failed to write LLVM IR to private staging", 1)
    var compile_input_path = ir_path
    val bitcode_debug = (rt_env_get("SIMPLE_LLVM_BITCODE_DEBUG") ?? "") == "1"
    if bitcode_debug:
        val llvm_as = find_llvm_as()
        if llvm_as == "":
            return llvm_object_stage_fail(stage_dir, diagnostic_path,
                "SIMPLE_LLVM_BITCODE_DEBUG requires llvm-as", 1)
        val (as_out, as_err, as_code) = process_run(
            llvm_as, [ir_path, "-o", bitcode_path])
        if as_code != 0:
            return llvm_object_stage_fail(stage_dir, diagnostic_path,
                "llvm-as failed (exit {as_code}):\n{as_out}{as_err}",
                1)
        val opt_tool = find_opt()
        if opt_tool == "":
            return llvm_object_stage_fail(stage_dir, diagnostic_path,
                "SIMPLE_LLVM_BITCODE_DEBUG requires opt", 1)
        val (verify_out, verify_err, verify_code) = process_run(
            opt_tool, ["-passes=verify", "-disable-output", bitcode_path])
        if verify_code != 0:
            return llvm_object_stage_fail(stage_dir, diagnostic_path,
                "LLVM bitcode verify failed (exit {verify_code}):\n{verify_out}{verify_err}",
                1)
        compile_input_path = bitcode_path
    var opt_flag = "-O0"
    if opt_level == OptimizationLevel.Size:
        opt_flag = "-Oz"
    elif opt_level == OptimizationLevel.Speed:
        opt_flag = "-O2"
    elif opt_level == OptimizationLevel.Aggressive:
        opt_flag = "-O3"
    var cpu = config.to_cpu_string()
    if cpu == "x86-64-v1":
        cpu = "x86-64"
    var args = ["--filetype=obj", "--relocation-model=pic",
        "--function-sections", "--data-sections"]
    if not bootstrap_io:
        args.push("-mtriple={frozen_target_triple}")
        args.push("-mcpu={cpu}")
        if config.features.len() > 0:
            args.push("-mattr={config.to_feature_string()}")
        match config.abi:
            case Some(abi): args.push("-target-abi={abi}")
            case nil: ()
        args.push(opt_flag)
    args.push("-o")
    args.push(staged_obj_path)
    args.push(compile_input_path)
    val (llc_out, llc_err, llc_code) = process_run(llc, args)
    if llc_code != 0:
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "llc failed (exit {llc_code}):\n{llc_out}{llc_err}",
            1)
    if (not file_exists(staged_obj_path)
        or not file_is_regular_no_follow(staged_obj_path)
        or file_size_raw(staged_obj_path) <= 0):
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "llc produced invalid private staged object", 1)
    val produced_bytes = rt_file_read_bytes(staged_obj_path) ?? []
    if produced_bytes.len() < 4:
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "llc produced object without recognized magic", 1)
    val b0 = produced_bytes[0].to_i64()
    val b1 = produced_bytes[1].to_i64()
    val b2 = produced_bytes[2].to_i64()
    val b3 = produced_bytes[3].to_i64()
    val elf_magic = b0 == 0x7F and b1 == 0x45 and b2 == 0x4C and b3 == 0x46
    val macho_magic = (
        (b0 == 0xCF and b1 == 0xFA and b2 == 0xED and b3 == 0xFE) or
        (b0 == 0xFE and b1 == 0xED and b2 == 0xFA and b3 == 0xCF) or
        (b0 == 0xCE and b1 == 0xFA and b2 == 0xED and b3 == 0xFE) or
        (b0 == 0xFE and b1 == 0xED and b2 == 0xFA and b3 == 0xCE))
    val coff_magic = (
        (b0 == 0x64 and b1 == 0x86) or (b0 == 0x4C and b1 == 0x01) or
        (b0 == 0x64 and b1 == 0xAA))
    if not elf_magic and not macho_magic and not coff_magic:
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "llc produced object without recognized magic", 1)
    val publish_status = rt_file_publish_noreplace(staged_obj_path, obj_path)
    if publish_status == 1:
        # Publication is the commit point. Once the canonical destination is
        # visible and valid, cleanup cannot turn success into failure.
        if not dir_remove(stage_dir, true):
            backend_aot_write_diagnostic(diagnostic_path,
                "warning: published object; private staging cleanup failed")
        return 0
    if publish_status == 0:
        return llvm_object_stage_fail(stage_dir, diagnostic_path,
            "AOT object destination already exists", 1)
    llvm_object_stage_fail(stage_dir, diagnostic_path,
        "AOT object publication failed", 1)

fn llvm_target_flags(config: LlvmTargetConfig) -> text:
    var flags = ""
    if config.features.len() > 0:
        flags = flags + " -mattr={config.to_feature_string()}"
    match config.abi:
        Some(abi):
            flags = flags + " -target-abi={abi}"
        nil:
            ()
    flags

# ============================================================================
# WASM Runtime Declarations
# ============================================================================

fn generate_wasm_runtime_declarations(target: CodegenTarget) -> text:
    """
    Generate LLVM IR declarations for WASM/WASI runtime functions.

    WASM uses i32 pointers and i32 size types. Runtime functions are
    imported from the host environment (WASI or JavaScript).
    """
    val ptr_ty = if target == CodegenTarget.Wasm32: "i32" else: "i64"
    val size_ty = if target == CodegenTarget.Wasm32: "i32" else: "i64"
    var decls = "; WASM Runtime function declarations\n"

    # Memory operations (provided by WASM runtime)
    decls = decls + "declare ptr @rt_alloc({size_ty})\n"
    decls = decls + "declare ptr @rt_realloc(ptr, {size_ty})\n"
    decls = decls + "declare void @rt_free(ptr)\n"

    # String operations
    decls = decls + "declare {size_ty} @rt_strlen(ptr)\n"
    decls = decls + "declare ptr @rt_strcat(ptr, ptr)\n"
    decls = decls + "declare ptr @rt_substr(ptr, {size_ty}, {size_ty})\n"
    decls = decls + "declare {size_ty} @rt_strfind(ptr, ptr)\n"
    decls = decls + "declare ptr @rt_strreplace(ptr, ptr, ptr)\n"
    decls = decls + "declare ptr @rt_strsplit(ptr, ptr)\n"
    decls = decls + "declare {size_ty} @rt_strcmp(ptr, ptr)\n"

    # Array/Collection operations
    decls = decls + "declare ptr @rt_array_new({size_ty})\n"
    decls = decls + "declare {size_ty} @rt_array_len(ptr)\n"
    decls = decls + "declare ptr @rt_array_get(ptr, {size_ty})\n"
    decls = decls + "declare i64 @rt_bytes_u8_at(ptr, {size_ty})\n"
    decls = decls + "declare void @rt_array_set(ptr, {size_ty}, ptr)\n"
    decls = decls + "declare ptr @rt_array_push(ptr, ptr)\n"
    decls = decls + "declare ptr @rt_array_pop(ptr)\n"
    decls = decls + "declare ptr @rt_array_write_span(ptr, ptr, i64, i64, i64)\n"
    decls = decls + "declare i8 @rt_array_extend_i64(ptr, ptr, i64)\n"

    # Dict/Map operations
    decls = decls + "declare ptr @rt_dict_new(i64)\n"
    decls = decls + "declare ptr @rt_dict_get(ptr, ptr)\n"
    decls = decls + "declare void @rt_dict_set(ptr, ptr, ptr)\n"
    decls = decls + "declare i1 @rt_dict_contains(ptr, ptr)\n"
    decls = decls + "declare {size_ty} @rt_dict_len(ptr)\n"

    # I/O operations
    decls = decls + "declare void @rt_print(ptr)\n"
    decls = decls + "declare void @rt_println(ptr)\n"
    decls = decls + "declare void @rt_eprintln(ptr)\n"
    decls = decls + "declare ptr @rt_readline()\n"
    decls = decls + "declare void @rt_eprint(ptr)\n"
    decls = decls + "declare void @rt_eprintln(ptr)\n"

    # Args
    decls = decls + "declare ptr @rt_get_args()\n"
    decls = decls + "declare {size_ty} @rt_get_argc()\n"

    # Error handling
    decls = decls + "declare void @rt_panic(ptr, i64)\n"

    # Math operations
    decls = decls + "declare double @rt_sin(double)\n"
    decls = decls + "declare double @rt_cos(double)\n"
    decls = decls + "declare double @rt_sqrt(double)\n"
    decls = decls + "declare double @rt_pow(double, double)\n"

    # LLVM intrinsics (i32 size type for wasm32)
    decls = decls + "declare void @llvm.memcpy.p0.p0.{size_ty}(ptr, ptr, {size_ty}, i1)\n"
    decls = decls + "declare void @llvm.memset.p0.{size_ty}(ptr, i8, {size_ty}, i1)\n"

    decls

# ============================================================================
# LLVM IR -> WASM Compilation (via llc + wasm-ld)
# ============================================================================

fn compile_ir_to_wasm(llvm_ir: text, config: LlvmTargetConfig, opt_level: OptimizationLevel, output_path: text) -> Result<text, text>:
    """Compile LLVM IR to a .wasm file via llc + wasm-ld.

    Pipeline:
    1. Write IR to temp .ll file
    2. Run llc to produce .o (wasm object)
    3. Run wasm-ld to produce .wasm
    4. Optionally run wasm-opt for optimization
    5. Return path to .wasm file
    """
    # Find required tools
    val llc = find_llc()
    if llc == "":
        return Err("llc not found. Install LLVM for WASM compilation.")

    val wasm_ld_cmd = find_wasm_ld()
    if wasm_ld_cmd == "":
        return Err("wasm-ld not found. Install lld: apt install lld (Ubuntu) or brew install llvm (macOS)")
    val pid = getpid()
    val ts = time_now_unix_micros()
    val tmp_dir = _get_temp_dir()
    val ir_path = "{tmp_dir}/simple_wasm_{pid}_{ts}.ll"
    val obj_path = "{tmp_dir}/simple_wasm_{pid}_{ts}.o"

    # Step 1: Write IR to temp file
    if not file_write(ir_path, llvm_ir):
        return Err("Failed to write LLVM IR to {ir_path}")

    # Step 2: Compile IR to wasm object via llc
    var opt_flag = "-O0"
    if opt_level == OptimizationLevel.Size:
        opt_flag = "-Oz"
    elif opt_level == OptimizationLevel.Speed:
        opt_flag = "-O2"
    elif opt_level == OptimizationLevel.Aggressive:
        opt_flag = "-O3"

    val triple = config.triple.to_text()
    val llc_cmd_str = "{llc} -mtriple={triple} -filetype=obj --function-sections --data-sections {opt_flag} -o {obj_path} {ir_path} 2>&1"
    val (wasm_llc_out, wasm_llc_err, wasm_llc_code) = backend_shell_tuple(llc_cmd_str)

    file_delete(ir_path)

    if wasm_llc_code != 0:
        file_delete(obj_path)
        return Err("llc WASM compilation failed:\n{wasm_llc_out}")

    # Step 3: Link with wasm-ld
    var ld_args = "{wasm_ld_cmd}"
    if triple.starts_with("wasm64"):
        ld_args = ld_args + " -mwasm64"
    ld_args = ld_args + " --export=_start --stack-first"
    ld_args = ld_args + " --gc-sections"
    ld_args = ld_args + " -z stack-size=1048576"
    ld_args = ld_args + " --initial-memory=4194304"

    # Check for WASI sysroot
    val sysroot = find_wasi_sysroot()
    if sysroot != "":
        val wasi_lib_dir = if triple.starts_with("wasm64") and file_exists("{sysroot}/lib/wasm64-wasi"):
            "{sysroot}/lib/wasm64-wasi"
        else:
            "{sysroot}/lib/wasm32-wasi"
        ld_args = ld_args + " -L{wasi_lib_dir} -lc"
        ld_args = ld_args + " {wasi_lib_dir}/crt1.o"
    else:
        # Standalone mode without libc
        ld_args = ld_args + " --no-entry --export-all"

    ld_args = ld_args + " -o {output_path} {obj_path} 2>&1"

    val (ld_out, ld_err, ld_code) = backend_shell_tuple(ld_args)
    file_delete(obj_path)

    if ld_code != 0:
        return Err("wasm-ld linking failed:\n{ld_out}")

    # Step 4: Optionally optimize with wasm-opt
    val wasm_opt_cmd = find_wasm_opt()
    if wasm_opt_cmd != "" and opt_level != OptimizationLevel.Debug:
        val wasm_opt_flag = if opt_level == OptimizationLevel.Size: "-Oz" else: "-O3"
        val opt_output = "{output_path}.opt"
        val (wopt_out, wopt_err, wopt_code) = backend_shell_tuple("{wasm_opt_cmd} {wasm_opt_flag} {output_path} -o {opt_output} 2>&1")
        if wopt_code == 0:
            # Replace original with optimized version
            file_delete(output_path)
            backend_shell_tuple("mv {opt_output} {output_path}")
        else:
            # Optimization failed, keep unoptimized version
            file_delete(opt_output)

    Ok(output_path)

# ============================================================================
# Optimization Level Mapping
# ============================================================================

fn to_mir_opt_level(level: OptimizationLevel) -> OptLevel:
    """Convert backend OptimizationLevel to MIR OptLevel for pass dispatch."""
    match level:
        case Debug: OptLevel.NoOpt
        case Size: OptLevel.Size
        case Speed: OptLevel.Speed
        case Aggressive: OptLevel.Aggressive
        case _: OptLevel.NoOpt

