# LLVM Codegen Adapter
#
# Wraps MirToLlvm translator to implement the Codegen trait.
# Delegates to existing LLVM IR generation and llc compilation pipeline.

use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget,
    BackendCompileOptions, CompileError, CompiledModule,
    compileerror_backend_error}
use compiler.backend.backend.codegen_types.{Codegen, CodegenOutput, CodegenOutputKind}
use compiler.backend.mir_to_llvm.{MirToLlvm}
use compiler.backend.llvm_target.{LlvmTargetConfig}
use compiler.backend.backend.llvm_backend_tools.{LlvmObjectCode,
    compile_ir_to_object, compile_ir_to_object_path}
use compiler.backend.llvm_ir_builder.{LlvmIRBuilder, llvm_ir_builder_set_simpleos_header}
use compiler.common.mir_target_context.{mir_target_context_os_from}
use std.nogc_sync_mut.io_runtime.{env_get_opt}

fn llvm_codegen_trace_enabled() -> bool:
    (env_get_opt("SIMPLE_COMPILER_TRACE") ?? "") == "1"

pub fn llvm_codegen_bare_metal_requested() -> bool:
    val requested_target = env_get_opt("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    mir_target_context_os_from(requested_target, "") == "baremetal"

fn llvm_codegen_target_config_for(options: BackendCompileOptions, bare_metal: bool) -> LlvmTargetConfig:
    if bare_metal:
        return LlvmTargetConfig.for_target_portable_numeric_baremetal(options.target, nil)
    LlvmTargetConfig.for_target_portable_numeric(options.target, nil)

fn llvm_codegen_translator_for(module_name: text, target: CodegenTarget, bare_metal: bool) -> MirToLlvm:
    if bare_metal:
        return MirToLlvm.create_baremetal(module_name, target, nil)
    MirToLlvm.create(module_name, target, nil)

fn llvm_codegen_retained_translator_for(
    module_name: text, target: CodegenTarget, config: LlvmTargetConfig,
    bare_metal: bool
) -> MirToLlvm:
    # Preserve non-target codegen policy; the retained header never rereads
    # SIMPLE_NATIVE_BUILD_TARGET or the legacy global header override.
    val builder = LlvmIRBuilder.create_with_header_policy(module_name, config.triple, false)
    MirToLlvm.create_with_builder(target, builder,
        config.triple.arch, config.triple.os, bare_metal, true,
        if bare_metal: "baremetal" else: "hosted")

# ============================================================================
# LLVM Codegen Adapter
# ============================================================================

class LlvmCodegenAdapter:
    """Adapts MirToLlvm translator to the Codegen trait interface."""
    options: BackendCompileOptions

fn llvm_translate_module_direct_ir_for(options: BackendCompileOptions, module: MirModule, bare_metal: bool,
    retained_config: LlvmTargetConfig? = nil) -> text:
    val simpleos_header = match options.target:
        case CodegenTarget.SimpleOS_X86_64: true
        case _: false
    if retained_config == nil:
        llvm_ir_builder_set_simpleos_header(simpleos_header)
    var translator = if val config = retained_config:
        llvm_codegen_retained_translator_for(module.name, options.target, config, bare_metal)
    else:
        llvm_codegen_translator_for(module.name, options.target, bare_metal)
    if options.debug_info:
        translator.enable_debug_info()
    val ir = translator.translate_module(module)
    if retained_config == nil:
        llvm_ir_builder_set_simpleos_header(false)
    ir

pub fn llvm_translate_module_direct_ir(options: BackendCompileOptions, module: MirModule,
    retained_config: LlvmTargetConfig? = nil) -> text:
    val bare_metal = if val config = retained_config:
        config.triple.os == "none" or config.triple.os == "simpleos"
    else:
        llvm_codegen_bare_metal_requested()
    llvm_translate_module_direct_ir_for(
        options, module, bare_metal, retained_config)

# The grouped compiler gives each worker its own frozen MIR module and target
# config. This path never reads or resets the legacy process-global bootstrap
# string accumulator or the ambient SimpleOS header flag.
pub fn llvm_group_translate_module_ir_v1(
    options: BackendCompileOptions, module: MirModule,
    config: LlvmTargetConfig, is_entry: bool
) -> text:
    val bare_metal = config.triple.os == "none" or config.triple.os == "simpleos"
    var target_env = ""
    var target_has_env = false
    match config.triple.env:
        Some(value):
            target_env = value
            target_has_env = value != ""
        nil: ()
    var translator = MirToLlvm.create_explicit_target(
        module.name, options.target,
        config.triple.arch, config.triple.vendor, config.triple.os,
        target_env, target_has_env, config.triple.datalayout(), bare_metal)
    if options.debug_info:
        translator.enable_debug_info()
    translator.translate_module_with_entry(module, is_entry)

pub fn llvm_compile_module_direct(options: BackendCompileOptions, module: MirModule,
    retained_config: LlvmTargetConfig? = nil) -> Result<CodegenOutput, CompileError>:
    val trace_enabled = llvm_codegen_trace_enabled()
    val bare_metal = if val config = retained_config:
        config.triple.os == "none" or config.triple.os == "simpleos"
    else:
        llvm_codegen_bare_metal_requested()
    if trace_enabled:
        print "[llvm-direct] start"
        print "[llvm-direct] module-name {module.name}"
        print "[llvm-direct] function-count {module.functions.len()}"
        for fn_ in module.functions.values():
            print "[llvm-direct] function-name {fn_.name}"
    # Translate MIR to LLVM IR
    if trace_enabled:
        print "[llvm-direct] config"
    val config = retained_config ?? llvm_codegen_target_config_for(options, bare_metal)
    if trace_enabled:
        print "[llvm-direct] translator"
    if trace_enabled:
        print "[llvm-direct] translate"
    val llvm_ir = llvm_translate_module_direct_ir_for(options, module, bare_metal, retained_config)

    # Compile IR to object code via llc
    if trace_enabled:
        print "[llvm-direct] llc"
    val result = compile_ir_to_object(llvm_ir, config, options.opt_level, retained_config != nil)
    if trace_enabled:
        print "[llvm-direct] result"
    match result:
        Ok(object_code):
            if trace_enabled:
                print "[llvm-direct] bytes"
            val bytes = object_code.bytes
            if trace_enabled:
                print "[llvm-direct] done"
            Ok(CodegenOutput.object(module.name, bytes))
        Err(err_msg):
            Err(compileerror_backend_error(BackendKind.Llvm, err_msg))

pub fn llvm_compile_module_direct_to_path(
    options: BackendCompileOptions, module: MirModule, object_path: text,
    diagnostic_path: text, retained_config: LlvmTargetConfig? = nil
) -> i64:
    val bare_metal = if val config = retained_config:
        config.triple.os == "none" or config.triple.os == "simpleos"
    else:
        llvm_codegen_bare_metal_requested()
    val config = retained_config ?? llvm_codegen_target_config_for(options, bare_metal)
    val llvm_ir = llvm_translate_module_direct_ir_for(
        options, module, bare_metal, retained_config)
    compile_ir_to_object_path(
        llvm_ir, config, options.opt_level, object_path, diagnostic_path, retained_config != nil)

pub fn llvm_compile_module_direct_compiled(options: BackendCompileOptions, module: MirModule,
    retained_config: LlvmTargetConfig? = nil) -> Result<CompiledModule, CompileError>:
    val trace_enabled = llvm_codegen_trace_enabled()
    val bare_metal = if val config = retained_config:
        config.triple.os == "none" or config.triple.os == "simpleos"
    else:
        llvm_codegen_bare_metal_requested()
    if trace_enabled:
        print "[llvm-direct] compiled:start"
    val config = retained_config ?? llvm_codegen_target_config_for(options, bare_metal)
    var translator = if val retained = retained_config:
        llvm_codegen_retained_translator_for(
            "app.cli.bootstrap_main", options.target, retained, bare_metal)
    else:
        llvm_codegen_translator_for("app.cli.bootstrap_main", options.target, bare_metal)
    if options.debug_info:
        translator.enable_debug_info()
    val llvm_ir = translator.translate_module(module)
    val result = compile_ir_to_object(llvm_ir, config, options.opt_level, retained_config != nil)
    match result:
        Ok(object_code):
            if trace_enabled:
                print "[llvm-direct] compiled:bytes"
            val compiled_module: CompiledModule = CompiledModule(
                name: "app.cli.bootstrap_main",
                object_code: object_code.bytes,
                has_assembly: false,
                assembly: "",
                has_llvm_ir: false,
                llvm_ir: "",
                symbols: [],
                compile_time_ms: 0
            )
            Ok(compiled_module)
        Err(err_msg):
            Err(compileerror_backend_error(BackendKind.Llvm, err_msg))

impl Codegen for LlvmCodegenAdapter:
    fn backend_kind() -> BackendKind: BackendKind.Llvm
    fn backend_name() -> text: "llvm"
    fn supports_target(target: CodegenTarget) -> bool:
        # `Arm32`, `C`, `Metal` and `OpenCL` are NOT CodegenTarget variants, so
        # the real 32-bit enum variant is `CodegenTarget.Arm`.
        # `case Arm32:` was an irrefutable BINDING that made every arm below it
        # unreachable — this returned true for Wasm32/Wasm64/CudaPtx/
        # VulkanSpirv/Avr/I8086 despite each being written `false`.
        # See doc/08_tracking/bug/case_bare_ident_is_irrefutable_binding_2026-08-01.md
        match target:
            case X86_64 | SimpleOS_X86_64: true
            case AArch64: true
            case AArch64_MacOS | X86_64_MacOS: true
            case Riscv64: true
            case X86: true
            case Arm: true
            case Riscv32: true
            case Native | Host: true
            case Wasm32: false
            case Wasm64: false
            case CudaPtx: false
            case HipHsaco: false
            case OpenClC | OpenClSpirv: false
            case VulkanSpirv: false
            case Avr: false
            case I8086: false
    fn output_kind() -> CodegenOutputKind: CodegenOutputKind.ObjectCode

    fn compile_module(module: MirModule) -> Result<CodegenOutput, CompileError>:
        llvm_compile_module_direct(self.options, module)

