# Internal Cranelift object ABI v1. Only the provider defines storage; consumers
# import a zero-argument function returning its address. Existing MIR provider
# initialization calls must precede imported reads, writes, and address taking.
use std.nogc_sync_mut.sffi.codegen.*

pub struct CraneliftGlobalBinding:
    data_handle: i64
    accessor_handle: i64

pub fn cranelift_global_accessor_name_v1(storage_name: text) -> text:
    # '$' cannot occur in a source identifier. Include the canonical complete
    # storage link identity, not a consumer-local SymbolId or a truncated hash.
    "__simple$global_address$v1$" + storage_name

fn global_address_signature_v1() -> i64:
    val signature = cranelift_new_signature(-1)
    cranelift_sig_set_return(signature, 8)  # CL_TYPE_PTR: target pointer width
    signature

pub fn cranelift_import_global_accessor_v1(module: i64, storage_name: text) -> i64:
    cranelift_declare_function(module, cranelift_global_accessor_name_v1(storage_name),
        global_address_signature_v1(), 1)  # CL_LINKAGE_IMPORT

pub fn cranelift_define_global_accessor_v1(module: i64, storage_name: text,
        data_handle: i64, linkage: i64) -> bool:
    # AOT definition redeclares functions with Export linkage. Reject every
    # non-public request before native calls rather than leaking its address.
    if linkage != 0: return false  # CL_LINKAGE_EXPORT only
    val signature = global_address_signature_v1()
    val handle = cranelift_declare_function(module,
        cranelift_global_accessor_name_v1(storage_name), signature, linkage)
    if handle == 0: return false
    val context = cranelift_begin_declared_function(module, handle, signature)
    if context == 0: return false
    val entry = cranelift_create_block(context)
    cranelift_switch_to_block(context, entry)
    val address = cranelift_data_addr_in_func(context, data_handle)
    if address == 0: return false
    cranelift_return(context, address)
    cranelift_seal_all_blocks(context)
    val function = cranelift_end_function(context)
    if function == 0: return false
    cranelift_aot_define_function(module, function)

pub fn cranelift_bound_global_address_v1(context: i64, binding: CraneliftGlobalBinding) -> i64:
    if binding.data_handle > 0 and binding.accessor_handle == 0:
        return cranelift_data_addr_in_func(context, binding.data_handle)
    if binding.accessor_handle > 0 and binding.data_handle == 0:
        val function = cranelift_import_function(context, binding.accessor_handle)
        if function == 0: return 0
        return cranelift_call(context, function, [])
    0
