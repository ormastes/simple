# Vulkan Backend - Vulkan/SPIR-V Code Generation
#
# Compiles MIR to SPIR-V assembly code for Vulkan compute shaders.
# SPIR-V can be assembled to binary using spirv-as or validated with spirv-val.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}
use compiler.backend.backend.backend_types.{BackendCompileOptions, CodegenTarget, CompileError}
use compiler.backend.backend.backend_types.{BackendKind, compileerror_backend_error, compileoptions_default_options}
use compiler.backend.codegen_types.{Codegen, CodegenOutput, CodegenOutputKind}
use compiler.backend.gpu_codegen_types.{GpuCodegen, GpuBarrierScope as CodegenBarrierScope}
use compiler.backend.gpu_backend_metadata.{gpu_backend_accepts_kernel, gpu_backend_supports_target}
use compiler.backend.vulkan_type_mapper.*
use compiler.backend.vulkan.spirv_builder.{SpirvBuilder}
use compiler.hir.hir_types.{MemorySpace, SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}

extern fn rt_enum_discriminant(value: Any) -> i64

fn vulkan_arg_index(kind: LocalKind) -> i64:
    if rt_enum_discriminant(kind) != rt_enum_discriminant(LocalKind.Arg(0)):
        return -1
    match kind:
        case LocalKind.Arg(index): index
        case _: -1

fn vulkan_is_arg_local(kind: LocalKind) -> bool:
    rt_enum_discriminant(kind) == rt_enum_discriminant(LocalKind.Arg(0))

fn vulkan_is_return_local(kind: LocalKind) -> bool:
    rt_enum_discriminant(kind) == rt_enum_discriminant(LocalKind.Return)

fn vulkan_validate_entry_arguments(signature: MirSignature, locals: [MirLocal]) -> Result<(), CompileError>:
    # A shader interface is positional: every signature parameter must have
    # exactly one Arg local with the same index and MIR type.
    var seen: Dict<i64, bool> = {}
    for local in locals:
        if not vulkan_is_arg_local(local.kind):
            continue
        val index = vulkan_arg_index(local.kind)
        if index < 0:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument local index cannot be negative"
            ))
        if index >= signature.params.len():
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument local index is outside its signature"
            ))
        if seen.has(index):
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument local index is duplicated"
            ))
        if local.type_.kind != signature.params[index].kind:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument local type does not match its signature parameter"
            ))
        seen[index] = true
    var index = 0
    while index < signature.params.len():
        if not seen.has(index):
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument local is missing from its signature"
            ))
        index = index + 1
    Ok(())

fn vulkan_block_successor_ids(term: MirTerminator) -> [i64]:
    match term:
        case Goto(target):
            [target.id]
        case If(_, true_target, false_target):
            [true_target.id, false_target.id]
        case _:
            []

fn vulkan_block_emission_order(func: MirFunction) -> [MirBlock]:
    """Reverse post-order (true branch first) over the block graph.

    MIR lowering may place the merge/return block BEFORE the branch targets in
    `func.blocks` (observed: entry, ret, then, else). SPIR-V structured control
    flow is emitted in array order here, so that layout misreads a plain
    if-without-else as a back-edge/else-form and gets rejected. RPO restores a
    forward layout for acyclic control flow without changing block contents;
    genuinely cyclic graphs still surface their back-edges and are rejected by
    compile_terminator exactly as before. Unreachable blocks keep their
    original relative order at the tail."""
    if func.blocks.len() == 0:
        return func.blocks
    var index_of: Dict<i64, i64> = {}
    var i = 0
    while i < func.blocks.len():
        index_of[func.blocks[i].id.id] = i
        i = i + 1
    var visited: Dict<i64, bool> = {}
    var post: [i64] = []
    var stack_block: [i64] = [0]
    var stack_cursor: [i64] = [0]
    visited[0] = true
    while stack_block.len() > 0:
        val top = stack_block.len() - 1
        val bi = stack_block[top]
        val cursor = stack_cursor[top]
        val succs = vulkan_block_successor_ids(func.blocks[bi].terminator)
        if cursor < succs.len():
            stack_cursor[top] = cursor + 1
            # Visit successors last-to-first so the FIRST successor (the true
            # branch) lands earliest in the reversed post-order.
            val succ_id = succs[succs.len() - 1 - cursor]
            if index_of.has(succ_id):
                val si = index_of[succ_id]
                if not visited.has(si):
                    visited[si] = true
                    stack_block.push(si)
                    stack_cursor.push(0)
        else:
            stack_block.pop()
            stack_cursor.pop()
            post.push(bi)
    var ordered: [MirBlock] = []
    var pi = post.len() - 1
    while pi >= 0:
        ordered.push(func.blocks[post[pi]])
        pi = pi - 1
    i = 0
    while i < func.blocks.len():
        if not visited.has(i):
            ordered.push(func.blocks[i])
        i = i + 1
    ordered

# ============================================================================
# Vulkan Backend
# ============================================================================

class VulkanCodegenBackend:
    """
    Vulkan backend for GPU code generation.

    Compiles MIR modules to SPIR-V assembly code for Vulkan compute shaders.
    SPIR-V is a binary intermediate representation that gets executed
    by Vulkan-compatible GPU drivers.

    Supported subset:
    - Compute entry-point generation
    - Global, local, and workgroup invocation IDs
    - U32/I64 constants, copies, moves, addition, subtraction, and multiplication
    - Workgroup and subgroup control barriers
    - Workgroup and device memory barriers
    - Void return and unreachable terminators

    All other MIR operations fail with a typed Vulkan backend error. This is
    intentionally narrower than emitting SPIR-V comments or unresolved IDs
    that an assembler could mistake for a usable shader.

    Usage:
        val _tup_0 = [1, 3]
        val backend = VulkanCodegenBackend.create(_tup_0)  # Vulkan 1.3
        val result = backend.compile(mir_module)
    """

    type_mapper: VulkanTypeMapper
    vulkan_version: [i64]
    options: BackendCompileOptions

    static fn create(vk_version: [i64]) -> VulkanCodegenBackend:
        """Create Vulkan backend for specific Vulkan version."""
        VulkanCodegenBackend(
            type_mapper: VulkanTypeMapper.create_version(vk_version[0], vk_version[1], 1, 6),
            vulkan_version: vk_version,
            options: compileoptions_default_options()
        )

    static fn create_with_options(vk_version: [i64], opts: BackendCompileOptions) -> VulkanCodegenBackend:
        """Create Vulkan backend with custom options."""
        VulkanCodegenBackend(
            type_mapper: VulkanTypeMapper.create_version(vk_version[0], vk_version[1], 1, 6),
            vulkan_version: vk_version,
            options: opts
        )

    static fn for_target(target: CodegenTarget) -> Result<VulkanCodegenBackend, CompileError>:
        """Create Vulkan backend from target."""
        if target == CodegenTarget.VulkanSpirv:
            return Ok(VulkanCodegenBackend.create([1, 3]))
        Err(compileerror_backend_error(
            BackendKind.Vulkan,
            "Target is not a Vulkan target"
        ))

    fn compile(module: MirModule) -> text:
        """Compile MIR module to SPIR-V."""
        val builder = SpirvBuilder.create(self.vulkan_version)
        for func in module.functions.values():
            if self.is_compute_shader(func) and self.function_uses_i64(func):
                builder.add_capability("Int64")

        # Emit module header
        builder.emit_header()
        builder.emit_capabilities()
        builder.emit_extensions()
        builder.emit_memory_model()

        # Collect shaders
        var shaders: [VulkanComputeShader] = []

        for func in module.functions.values():
            if self.is_compute_shader(func):
                if shaders.len() > 0:
                    return Err(compileerror_backend_error(
                        BackendKind.Vulkan,
                        "Vulkan SPIR-V currently supports one compute entry point per module"
                    ))
                val result = self.compile_compute_shader(builder, func)
                match result:
                    case Ok(shader):
                        shaders = shaders.push(shader)
                    case Err(e):
                        return Err(e)

        val spirv_assembly = builder.build()

        Ok(VulkanCompiledModule(
            name: module.name,
            spirv_assembly: spirv_assembly,
            shaders: shaders,
            vulkan_version: self.vulkan_version
        ))

    fn is_compute_shader(func: MirFunction) -> bool:
        """Check if function should be compiled as a compute shader."""
        if func.is_kernel:
            return gpu_backend_accepts_kernel(BackendKind.Vulkan, func)
        # Functions with GPU instructions are compute shaders
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case GpuGlobalId(_, _) | GpuLocalId(_, _) | GpuBlockId(_, _) | GpuBlockDim(_, _) | GpuGridDim(_, _) | GpuBarrier(_) | GpuMemFence(_) | GpuSharedAlloc(_, _, _) | GpuAtomicOp(_, _, _, _) | GpuAtomicCas(_, _, _, _):
                        return true
                    case _:
                        ()
        false

    fn compile_compute_shader(builder: SpirvBuilder, func: MirFunction) -> text:
        """Compile a compute shader."""

        if func.signature.is_variadic:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry parameters cannot be variadic"
            ))
        if func.signature.return_type.kind != MirTypeKind.Unit:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry points must return Unit"
            ))
        val argument_validation = vulkan_validate_entry_arguments(func.signature, func.locals)
        match argument_validation:
            case Err(e): return Err(e)
            case Ok(_): ()
        val dummy_type = MirType(kind: MirTypeKind.U32)
        val u32_type_tag = rt_enum_discriminant(MirTypeKind.U32)
        val ptr_type_tag = rt_enum_discriminant(MirTypeKind.Ptr(dummy_type, false))
        val ref_type_tag = rt_enum_discriminant(MirTypeKind.Ref(dummy_type, false))
        for local in func.locals:
            val index = vulkan_arg_index(local.kind)
            if index >= 0:
                if index >= func.signature.params.len():
                    return Err(compileerror_backend_error(
                        BackendKind.Vulkan,
                        "Vulkan compute entry argument local index is outside its signature"
                    ))
                val local_type_tag = rt_enum_discriminant(local.type_.kind)
                if local_type_tag == ptr_type_tag or local_type_tag == ref_type_tag:
                    var pointee_is_u32 = false
                    if local_type_tag == ptr_type_tag:
                        match local.type_.kind:
                            case MirTypeKind.Ptr(pointee, _):
                                pointee_is_u32 = rt_enum_discriminant(pointee.kind) == u32_type_tag
                            case _: ()
                    else:
                        match local.type_.kind:
                            case MirTypeKind.Ref(pointee, _):
                                pointee_is_u32 = rt_enum_discriminant(pointee.kind) == u32_type_tag
                            case _: ()
                    if not pointee_is_u32:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan StorageBuffer arguments currently require U32 pointers"
                        ))
                elif local_type_tag != u32_type_tag:
                    return Err(compileerror_backend_error(
                        BackendKind.Vulkan,
                        "Vulkan compute entry argument {index} local {local.id.id} requires a U32 pointer or U32 length (local type tag {rt_enum_discriminant(local.type_.kind)}, signature type tag {rt_enum_discriminant(func.signature.params[index].kind)}, expected Ptr {ptr_type_tag}, Ref {ref_type_tag}, U32 {u32_type_tag})"
                    ))
            elif vulkan_is_return_local(local.kind):
                return Err(compileerror_backend_error(
                    BackendKind.Vulkan,
                    "Vulkan Unit compute entry points cannot have a return local"
                ))
        if func.blocks.len() == 0 or func.blocks[0].id.id != 0:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan SPIR-V requires an entry block with id 0"
            ))

        var storage_arg_bindings: Dict<i64, i64> = {}
        var push_arg_locals: Dict<i64, i64> = {}
        for local in func.locals:
            val index = vulkan_arg_index(local.kind)
            if index >= 0:
                val local_type_tag = rt_enum_discriminant(local.type_.kind)
                if local_type_tag == ptr_type_tag or local_type_tag == ref_type_tag:
                    var binding = 0
                    var prior_index = 0
                    while prior_index < index:
                        val prior_tag = rt_enum_discriminant(func.signature.params[prior_index].kind)
                        if prior_tag == ptr_type_tag or prior_tag == ref_type_tag:
                            binding = binding + 1
                        prior_index = prior_index + 1
                    storage_arg_bindings[local.id.id] = binding
                elif local_type_tag == u32_type_tag:
                    if push_arg_locals.keys().len() > 0:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan compute entry supports one U32 length push constant"
                        ))
                    push_arg_locals[local.id.id] = index
        val uses_storage_buffers = storage_arg_bindings.keys().len() > 0
        val uses_push_constant = push_arg_locals.keys().len() > 0
        val uses_bool = self.function_uses_bool(func)

        # Allocate IDs first so the module can follow SPIR-V logical layout:
        # entry points and annotations must precede types and global variables.
        val void_type = builder.alloc_id()
        val u32_type = builder.alloc_id()
        val uses_i64 = self.function_uses_i64(func)
        val i64_type = if uses_i64: builder.alloc_id() else: 0
        val bool_type = if uses_bool: builder.alloc_id() else: u32_type
        val storage_runtime_array_type = if uses_storage_buffers: builder.alloc_id() else: 0
        val storage_struct_type = if uses_storage_buffers: builder.alloc_id() else: 0
        val storage_struct_ptr_type = if uses_storage_buffers: builder.alloc_id() else: 0
        val storage_elem_ptr_type = if uses_storage_buffers: builder.alloc_id() else: 0
        val push_struct_type = if uses_push_constant: builder.alloc_id() else: 0
        val push_struct_ptr_type = if uses_push_constant: builder.alloc_id() else: 0
        val push_value_ptr_type = if uses_push_constant: builder.alloc_id() else: 0
        # Scalar lowering remains intentionally narrow: only the real Bool
        # type needed by bounds checks is emitted.
        val i32_type = u32_type
        val f32_type = u32_type
        val uvec3_type = builder.alloc_id()
        val uvec3_input_ptr = builder.alloc_id()
        val func_type = builder.alloc_id()
        val global_invocation_id = builder.alloc_id()
        val local_invocation_id = builder.alloc_id()
        val workgroup_id = builder.alloc_id()
        val uses_grid_dim = self.function_uses_grid_dim(func)
        val num_workgroups = if uses_grid_dim: builder.alloc_id() else: 0
        var storage_variable_ids: Dict<i64, i64> = {}
        for local in func.locals:
            if storage_arg_bindings.has(local.id.id):
                storage_variable_ids[local.id.id] = builder.alloc_id()
        val push_variable_id = if uses_push_constant: builder.alloc_id() else: 0
        val uses_shared_memory = self.function_uses_shared_memory(func)
        var shared_array_ids: Dict<i64, i64> = {}
        if uses_shared_memory:
            for block in func.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case GpuSharedAlloc(dest, _, _):
                            if shared_array_ids.has(dest.id):
                                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan shared allocation destination may only be declared once"))
                            shared_array_ids[dest.id] = builder.alloc_id()
                        case _:
                            ()
        val func_id = builder.alloc_id()

        var interface_ids = [global_invocation_id, local_invocation_id, workgroup_id]
        if uses_grid_dim:
            interface_ids = interface_ids.push(num_workgroups)
        if uses_shared_memory:
            for block in func.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case GpuSharedAlloc(dest, _, _):
                            interface_ids = interface_ids.push(shared_array_ids[dest.id])
                        case _:
                            ()
        for local in func.locals:
            if storage_variable_ids.has(local.id.id):
                interface_ids = interface_ids.push(storage_variable_ids[local.id.id])
        if uses_push_constant:
            interface_ids = interface_ids.push(push_variable_id)
        builder.emit_entry_point(func.name, func_id, interface_ids)

        # Default workgroup size (can be overridden)
        val workgroup_size = [256, 1, 1]
        builder.emit_execution_mode(func_id, workgroup_size)

        builder.emit_decorate_builtin(global_invocation_id, SpirvBuiltin.GlobalInvocationId)
        builder.emit_decorate_builtin(local_invocation_id, SpirvBuiltin.LocalInvocationId)
        builder.emit_decorate_builtin(workgroup_id, SpirvBuiltin.WorkgroupId)
        if uses_grid_dim:
            builder.emit_decorate_builtin(num_workgroups, SpirvBuiltin.NumWorkgroups)
        if uses_storage_buffers:
            builder.emit_decorate(storage_struct_type, "Block")
            builder.emit_decorate_array_stride(storage_runtime_array_type, 4)
            builder.emit_member_decorate(storage_struct_type, 0, "Offset 0")
            for local in func.locals:
                if storage_variable_ids.has(local.id.id):
                    builder.emit_decorate_binding(storage_variable_ids[local.id.id], 0, storage_arg_bindings[local.id.id])
        if uses_push_constant:
            builder.emit_decorate(push_struct_type, "Block")
            builder.emit_member_decorate(push_struct_type, 0, "Offset 0")

        # Decorations section complete
        builder.emit_comment("--- End Decorations ---")
        builder.emit("")

        builder.emit("{builder.id_str(void_type)} = OpTypeVoid")
        builder.emit("{builder.id_str(u32_type)} = OpTypeInt 32 0")
        if uses_bool:
            builder.emit("{builder.id_str(bool_type)} = OpTypeBool")
        if uses_i64:
            # Add/Sub/Mul are sign-agnostic; an unsigned carrier also permits
            # zero-extending Vulkan's U32 invocation IDs.
            builder.emit("{builder.id_str(i64_type)} = OpTypeInt 64 0")
        builder.emit("{builder.id_str(uvec3_type)} = OpTypeVector {builder.id_str(u32_type)} 3")
        builder.emit("{builder.id_str(uvec3_input_ptr)} = OpTypePointer Input {builder.id_str(uvec3_type)}")
        builder.emit("{builder.id_str(func_type)} = OpTypeFunction {builder.id_str(void_type)}")
        if uses_storage_buffers:
            builder.emit("{builder.id_str(storage_runtime_array_type)} = OpTypeRuntimeArray {builder.id_str(u32_type)}")
            builder.emit("{builder.id_str(storage_struct_type)} = OpTypeStruct {builder.id_str(storage_runtime_array_type)}")
            builder.emit("{builder.id_str(storage_struct_ptr_type)} = OpTypePointer StorageBuffer {builder.id_str(storage_struct_type)}")
            builder.emit("{builder.id_str(storage_elem_ptr_type)} = OpTypePointer StorageBuffer {builder.id_str(u32_type)}")
        if uses_push_constant:
            builder.emit("{builder.id_str(push_struct_type)} = OpTypeStruct {builder.id_str(u32_type)}")
            builder.emit("{builder.id_str(push_struct_ptr_type)} = OpTypePointer PushConstant {builder.id_str(push_struct_type)}")
            builder.emit("{builder.id_str(push_value_ptr_type)} = OpTypePointer PushConstant {builder.id_str(u32_type)}")
        val scope_workgroup = builder.emit_const_int(u32_type, 2)
        val scope_subgroup = builder.emit_const_int(u32_type, 3)
        val scope_device = builder.emit_const_int(u32_type, 1)
        val semantics_workgroup = builder.emit_const_int(u32_type, 264)
        val semantics_device = builder.emit_const_int(u32_type, 2376)
        val storage_zero_index = if uses_storage_buffers or uses_push_constant: builder.emit_const_int(u32_type, 0) else: 0
        val uses_atomic_cas = self.function_uses_atomic_cas(func)
        val semantics_workgroup_unequal = if uses_atomic_cas: builder.emit_const_int(u32_type, 258) else: 0
        var value_ids: Dict<i64, i64> = {}
        var storage_buffer_ids: Dict<i64, i64> = {}
        for local in func.locals:
            if storage_variable_ids.has(local.id.id):
                storage_buffer_ids[local.id.id] = storage_variable_ids[local.id.id]
        var pointer_ids: Dict<i64, i64> = {}
        var live_shared_array_ids: Dict<i64, i64> = {}
        var shared_array_sizes: Dict<i64, i64> = {}
        var index_upper_bounds: Dict<i64, i64> = {}
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case Const(_, Int(value), ty):
                        val type_id = self.int_type_id(ty, u32_type, i64_type)
                        if type_id != 0 and self.int_constant_in_range(value, ty):
                            self.emit_int_constant(builder, type_id, value, i64_type)
                    case BinOp(_, _, left, right):
                        self.predeclare_operand_constant(builder, left, u32_type, i64_type)
                        self.predeclare_operand_constant(builder, right, u32_type, i64_type)
                    case GetElementPtr(_, _, indices):
                        for index in indices:
                            self.predeclare_operand_constant(builder, index, u32_type, i64_type)
                    case Store(_, value):
                        self.predeclare_operand_constant(builder, value, u32_type, i64_type)
                    case GpuAtomicOp(_, _, _, value):
                        self.predeclare_operand_constant(builder, value, u32_type, i64_type)
                    case GpuAtomicCas(_, _, expected, desired):
                        self.predeclare_operand_constant(builder, expected, u32_type, i64_type)
                        self.predeclare_operand_constant(builder, desired, u32_type, i64_type)
                    case GpuBlockDim(dest, dim):
                        if dim >= 0 and dim <= 2:
                            val type_id = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                            if type_id != 0:
                                self.emit_int_constant(builder, type_id, workgroup_size[dim], i64_type)
                    case GpuSharedAlloc(_, ty, size):
                        if ty.kind == MirTypeKind.U32 and size > 0 and size <= 4294967295:
                            builder.emit_const_int(u32_type, size)
                    case _:
                        ()
            match block.terminator:
                case If(cond, _, _):
                    match cond.kind:
                        case Const(Bool(value), ty):
                            if ty.kind == MirTypeKind.Bool:
                                if value:
                                    builder.emit_const_true(bool_type)
                                else:
                                    builder.emit_const_false(bool_type)
                        case _:
                            ()
                case _:
                    ()
        val shared_elem_ptr_type = if uses_shared_memory: builder.emit_type_pointer("Workgroup", u32_type) else: 0
        var shared_array_ptr_types: Dict<i64, i64> = {}
        if uses_shared_memory:
            for block in func.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case GpuSharedAlloc(dest, ty, size):
                            if ty.kind != MirTypeKind.U32:
                                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan shared allocation element type must be U32"))
                            if size <= 0 or size > 4294967295:
                                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan shared allocation size must be between 1 and 4294967295 elements"))
                            if not self.local_is_u32_ptr(func, dest.id):
                                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan shared allocation destination must be a U32 pointer with mutable access"))
                            val length_id = builder.emit_const_int(u32_type, size)
                            val array_type = builder.emit_type_array(u32_type, length_id)
                            shared_array_ptr_types[dest.id] = builder.emit_type_pointer("Workgroup", array_type)
                            shared_array_sizes[dest.id] = size
                        case _:
                            ()
            for block in func.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case GpuSharedAlloc(dest, _, _):
                            builder.emit("{builder.id_str(shared_array_ids[dest.id])} = OpVariable {builder.id_str(shared_array_ptr_types[dest.id])} Workgroup")
                        case _:
                            ()
        if uses_storage_buffers:
            for local in func.locals:
                if storage_variable_ids.has(local.id.id):
                    builder.emit("{builder.id_str(storage_variable_ids[local.id.id])} = OpVariable {builder.id_str(storage_struct_ptr_type)} StorageBuffer")
        if uses_push_constant:
            builder.emit("{builder.id_str(push_variable_id)} = OpVariable {builder.id_str(push_struct_ptr_type)} PushConstant")
        builder.emit("{builder.id_str(global_invocation_id)} = OpVariable {builder.id_str(uvec3_input_ptr)} Input")
        builder.emit("{builder.id_str(local_invocation_id)} = OpVariable {builder.id_str(uvec3_input_ptr)} Input")
        builder.emit("{builder.id_str(workgroup_id)} = OpVariable {builder.id_str(uvec3_input_ptr)} Input")
        if uses_grid_dim:
            builder.emit("{builder.id_str(num_workgroups)} = OpVariable {builder.id_str(uvec3_input_ptr)} Input")
        builder.emit("")

        var block_labels: Dict<i64, i64> = {}
        var block_positions: Dict<i64, i64> = {}
        var block_position = 0
        val ordered_blocks = vulkan_block_emission_order(func)
        for block in ordered_blocks:
            if block_labels.has(block.id.id):
                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V block ids must be unique"))
            block_labels[block.id.id] = builder.alloc_id()
            block_positions[block.id.id] = block_position
            block_position = block_position + 1

        # Emit function
        builder.emit("{builder.id_str(func_id)} = OpFunction {builder.id_str(void_type)} None {builder.id_str(func_type)}")

        # Emit entry block. Labels are allocated before emission so forward
        # branches can reference their targets without accepting back-edges.
        builder.emit("{builder.id_str(block_labels[ordered_blocks[0].id.id])} = OpLabel")
        if uses_push_constant:
            for local in func.locals:
                if push_arg_locals.has(local.id.id):
                    val push_ptr = builder.emit_access_chain(push_value_ptr_type, push_variable_id, [storage_zero_index])
                    value_ids[local.id.id] = builder.emit_load(u32_type, push_ptr)

        # Compile function body
        var emitted_block_position = 0
        for block in ordered_blocks:
            if emitted_block_position > 0:
                builder.emit("{builder.id_str(block_labels[block.id.id])} = OpLabel")

            for inst in block.instructions:
                val result = self.compile_instruction(builder, inst, (i32_type, u32_type, i64_type, f32_type, bool_type, uvec3_type, global_invocation_id, local_invocation_id, workgroup_id, num_workgroups, scope_workgroup, scope_subgroup, scope_device, semantics_workgroup, semantics_device, semantics_workgroup_unequal), value_ids, shared_array_ids, live_shared_array_ids, shared_array_sizes, pointer_ids, storage_buffer_ids, index_upper_bounds, func, workgroup_size, shared_elem_ptr_type, storage_elem_ptr_type, storage_zero_index)
                match result:
                    case Ok(_):
                        ()
                    case Err(e):
                        return Err(e)

            val terminator_result = self.compile_terminator(builder, block.terminator, emitted_block_position, block_positions, block_labels, value_ids, func, bool_type)
            if terminator_result.is_err():
                return Err(terminator_result.unwrap_err())
            emitted_block_position = emitted_block_position + 1

        builder.emit_function_end()

        Ok(VulkanComputeShader(
            name: func.name,
            entry_point: func.name,
            workgroup_size: workgroup_size
        ))

    fn compile_instruction(
        builder: SpirvBuilder,
        inst: MirInst,
        types: (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64),  # scalar/vector types, builtin variables, barrier constants
        mut value_ids: Dict<i64, i64>,
        mut shared_array_ids: Dict<i64, i64>,
        mut live_shared_array_ids: Dict<i64, i64>,
        shared_array_sizes: Dict<i64, i64>,
        mut pointer_ids: Dict<i64, i64>,
        storage_buffer_ids: Dict<i64, i64>,
        mut index_upper_bounds: Dict<i64, i64>,
        func: MirFunction,
        workgroup_size: [i64],
        shared_elem_ptr_type: i64,
        storage_elem_ptr_type: i64,
        storage_zero_index: i64
    ) -> Result<(), CompileError>:
        """Compile a single MIR instruction to SPIR-V."""
        val _destruct_1 = types
        val i32_type = _destruct_1[0]
        val u32_type = _destruct_1[1]
        val i64_type = _destruct_1[2]
        val f32_type = _destruct_1[3]
        val bool_type = _destruct_1[4]
        val uvec3_type = _destruct_1[5]
        val global_id_var = _destruct_1[6]
        val local_id_var = _destruct_1[7]
        val workgroup_id_var = _destruct_1[8]
        val num_workgroups_var = _destruct_1[9]
        val scope_workgroup = _destruct_1[10]
        val scope_subgroup = _destruct_1[11]
        val scope_device = _destruct_1[12]
        val semantics_workgroup = _destruct_1[13]
        val semantics_device = _destruct_1[14]
        val semantics_workgroup_unequal = _destruct_1[15]

        match inst.kind:
            case Const(dest, Int(value), ty):
                index_upper_bounds.remove(dest.id)
                val type_id = self.int_type_id(ty, u32_type, i64_type)
                if type_id == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V constants currently require U32 or I64"))
                if not self.int_constant_in_range(value, ty):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan integer constant is out of range"))
                if self.local_int_type_id(func, dest.id, u32_type, i64_type) != type_id:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan integer constant destination type does not match"))
                value_ids[dest.id] = self.emit_int_constant(builder, type_id, value, i64_type)
            case Const(_, _, _):
                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V constants currently require U32 or I64 integer values"))

            case Copy(dest, src):
                index_upper_bounds.remove(dest.id)
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0 or self.local_int_type_id(func, src.id, u32_type, i64_type) != dest_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V copy requires matching U32 or I64 locals"))
                if not value_ids.has(src.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V copy source _l{src.id} has no value"))
                value_ids[dest.id] = value_ids[src.id]
                if index_upper_bounds.has(src.id):
                    index_upper_bounds[dest.id] = index_upper_bounds[src.id]

            case Move(dest, src):
                index_upper_bounds.remove(dest.id)
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0 or self.local_int_type_id(func, src.id, u32_type, i64_type) != dest_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V move requires matching U32 or I64 locals"))
                if not value_ids.has(src.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V move source _l{src.id} has no value"))
                value_ids[dest.id] = value_ids[src.id]
                if index_upper_bounds.has(src.id):
                    index_upper_bounds[dest.id] = index_upper_bounds[src.id]

            case Cast(dest, operand, target):
                index_upper_bounds.remove(dest.id)
                val target_type = self.int_type_id(target, u32_type, i64_type)
                val source_type = self.operand_int_type_id(func, operand, u32_type, i64_type)
                if target_type == 0 or source_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan integer casts require U32 or I64 operands"))
                if self.local_int_type_id(func, dest.id, u32_type, i64_type) != target_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan integer cast destination type does not match"))
                val source = self.resolve_int_operand(builder, operand, source_type, value_ids, func, u32_type, i64_type)
                if source.is_err():
                    return Err(source.unwrap_err())
                value_ids[dest.id] = if source_type == target_type:
                    source.unwrap()
                else:
                    builder.emit_uconvert(target_type, source.unwrap())

            case BinOp(dest, op, left, right):
                index_upper_bounds.remove(dest.id)
                if self.local_is_bool(func, dest.id):
                    val left_type = self.operand_int_type_id(func, left, u32_type, i64_type)
                    val right_type = self.operand_int_type_id(func, right, u32_type, i64_type)
                    if left_type != u32_type or right_type != u32_type:
                        return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 comparison operands must be U32"))
                    val left_result = self.resolve_int_operand(builder, left, u32_type, value_ids, func, u32_type, i64_type)
                    if left_result.is_err():
                        return Err(left_result.unwrap_err())
                    val right_result = self.resolve_int_operand(builder, right, u32_type, value_ids, func, u32_type, i64_type)
                    if right_result.is_err():
                        return Err(right_result.unwrap_err())
                    val left_id = left_result.unwrap()
                    val right_id = right_result.unwrap()
                    match op:
                        case Eq:
                            value_ids[dest.id] = builder.emit_iequal(bool_type, left_id, right_id)
                        case Ne:
                            value_ids[dest.id] = builder.emit_inotequal(bool_type, left_id, right_id)
                        case Lt:
                            value_ids[dest.id] = builder.emit_uless_than(bool_type, left_id, right_id)
                        case _:
                            return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 comparison is not implemented: {op}"))
                    return Ok(())
                val type_id = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if type_id == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V binary operation destination must be U32 or I64"))
                val left_result = self.resolve_int_operand(builder, left, type_id, value_ids, func, u32_type, i64_type)
                if left_result.is_err():
                    return Err(left_result.unwrap_err())
                val right_result = self.resolve_int_operand(builder, right, type_id, value_ids, func, u32_type, i64_type)
                if right_result.is_err():
                    return Err(right_result.unwrap_err())
                val left_id = left_result.unwrap()
                val right_id = right_result.unwrap()
                match op:
                    case Add:
                        value_ids[dest.id] = builder.emit_iadd(type_id, left_id, right_id)
                    case Sub:
                        value_ids[dest.id] = builder.emit_isub(type_id, left_id, right_id)
                    case Mul:
                        value_ids[dest.id] = builder.emit_imul(type_id, left_id, right_id)
                    case _:
                        return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V integer binary operation is not implemented: {op}"))

            case UnaryOp(dest, op, operand):
                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V unary operation lowering is not implemented: {op}"))

            case Load(dest, ptr):
                index_upper_bounds.remove(dest.id)
                val ptr_id = self.shared_pointer_operand_id(ptr, pointer_ids)
                if ptr_id == 0 or self.local_int_type_id(func, dest.id, u32_type, i64_type) != u32_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V load currently requires a lowered U32 storage pointer or shared U32 element pointer and U32 destination"))
                value_ids[dest.id] = builder.emit_load(u32_type, ptr_id)

            case Store(ptr, value):
                val ptr_id = self.shared_pointer_operand_id(ptr, pointer_ids)
                if ptr_id == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V store currently requires a lowered U32 storage pointer"))
                if not self.operand_is_mutable_u32_pointer(func, ptr):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V store requires a mutable U32 storage pointer"))
                val value_result = self.resolve_int_operand(builder, value, u32_type, value_ids, func, u32_type, i64_type)
                if value_result.is_err():
                    return Err(value_result.unwrap_err())
                builder.emit_store(ptr_id, value_result.unwrap())

            case GetElementPtr(dest, base, indices):
                if indices.len() != 1:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 storage GEP requires exactly one index"))
                if not self.local_is_u32_pointer(func, dest.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 storage GEP destination must be a U32 pointer"))
                val base_id = self.shared_array_operand_id(base, live_shared_array_ids)
                val storage_base_id = self.storage_buffer_operand_id(base, storage_buffer_ids)
                if base_id == 0 and storage_base_id == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 storage GEP base must come from a StorageBuffer argument or GpuSharedAlloc"))
                if storage_base_id != 0 and self.local_is_u32_ptr(func, dest.id) and not self.operand_is_mutable_u32_pointer(func, base):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan immutable StorageBuffer base cannot produce a mutable GEP destination"))
                val index_type = self.operand_int_type_id(func, indices[0], u32_type, i64_type)
                # i64_type is 0 when the module never declares OpTypeInt 64, so an
                # unsupported index kind (also 0) must be rejected explicitly first.
                if index_type == 0 or (index_type != u32_type and index_type != i64_type):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan U32 storage GEP index must be U32 or I64"))
                # Prove the shared-memory bound BEFORE materializing the index value, so an
                # unproven index reports the bound failure instead of an incidental
                # "operand has no value" from constant resolution.
                var allocation_size = 0
                if storage_base_id == 0:
                    allocation_size = self.shared_array_operand_size(base, shared_array_sizes)
                    if not self.shared_index_is_proven_in_bounds(indices[0], allocation_size, index_upper_bounds):
                        return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan shared-memory GEP index is not proven within the allocation"))
                val index_result = self.resolve_int_operand(builder, indices[0], index_type, value_ids, func, u32_type, i64_type)
                if index_result.is_err():
                    return Err(index_result.unwrap_err())
                if storage_base_id != 0:
                    pointer_ids[dest.id] = builder.emit_access_chain(storage_elem_ptr_type, storage_base_id, [storage_zero_index, index_result.unwrap()])
                else:
                    pointer_ids[dest.id] = builder.emit_access_chain(shared_elem_ptr_type, base_id, [index_result.unwrap()])

            # GPU-specific instructions
            case GpuGlobalId(dest, dim):
                index_upper_bounds.remove(dest.id)
                if dim < 0 or dim > 2:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan invocation ID dimension must be 0, 1, or 2"))
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan global invocation ID destination must be U32 or I64"))
                # Load from GlobalInvocationId and extract component
                val loaded = builder.emit_load(uvec3_type, global_id_var)
                val component = builder.emit_composite_extract(u32_type, loaded, [dim])
                value_ids[dest.id] = if dest_type == u32_type: component else: builder.emit_uconvert(i64_type, component)

            case GpuLocalId(dest, dim):
                index_upper_bounds.remove(dest.id)
                if dim < 0 or dim > 2:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan invocation ID dimension must be 0, 1, or 2"))
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan local invocation ID destination must be U32 or I64"))
                val loaded = builder.emit_load(uvec3_type, local_id_var)
                val component = builder.emit_composite_extract(u32_type, loaded, [dim])
                value_ids[dest.id] = if dest_type == u32_type: component else: builder.emit_uconvert(i64_type, component)
                index_upper_bounds[dest.id] = workgroup_size[dim]

            case GpuBlockId(dest, dim):
                index_upper_bounds.remove(dest.id)
                if dim < 0 or dim > 2:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan invocation ID dimension must be 0, 1, or 2"))
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan workgroup ID destination must be U32 or I64"))
                val loaded = builder.emit_load(uvec3_type, workgroup_id_var)
                val component = builder.emit_composite_extract(u32_type, loaded, [dim])
                value_ids[dest.id] = if dest_type == u32_type: component else: builder.emit_uconvert(i64_type, component)

            case GpuBlockDim(dest, dim):
                index_upper_bounds.remove(dest.id)
                if dim < 0 or dim > 2:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan block dimension must be 0, 1, or 2"))
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan block dimension destination must be U32 or I64"))
                value_ids[dest.id] = self.emit_int_constant(builder, dest_type, workgroup_size[dim], i64_type)

            case GpuGridDim(dest, dim):
                index_upper_bounds.remove(dest.id)
                if dim < 0 or dim > 2:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan grid dimension must be 0, 1, or 2"))
                val dest_type = self.local_int_type_id(func, dest.id, u32_type, i64_type)
                if dest_type == 0:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan grid dimension destination must be U32 or I64"))
                val loaded = builder.emit_load(uvec3_type, num_workgroups_var)
                val component = builder.emit_composite_extract(u32_type, loaded, [dim])
                value_ids[dest.id] = if dest_type == u32_type: component else: builder.emit_uconvert(i64_type, component)

            case GpuBarrier(scope):
                match scope:
                    case Workgroup:
                        builder.emit_control_barrier(
                            builder.id_str(scope_workgroup),
                            builder.id_str(scope_workgroup),
                            builder.id_str(semantics_workgroup)
                        )
                    case Subgroup:
                        builder.emit_control_barrier(
                            builder.id_str(scope_subgroup),
                            builder.id_str(scope_subgroup),
                            builder.id_str(semantics_device)
                        )
                    case Device:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan cannot synchronize all workgroups inside one dispatch"
                        ))

            case GpuMemFence(scope):
                match scope:
                    case Workgroup:
                        builder.emit_memory_barrier(
                            builder.id_str(scope_workgroup),
                            builder.id_str(semantics_workgroup)
                        )
                    case Device:
                        builder.emit_memory_barrier(
                            builder.id_str(scope_device),
                            builder.id_str(semantics_device)
                        )
                    case QueueFamily:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan QueueFamily memory scope requires the Vulkan memory model"
                        ))
                    case All:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan does not support CrossDevice shader memory scope"
                        ))

            case GpuSharedAlloc(dest, ty, size):
                if not shared_array_ids.has(dest.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V shared allocation was not declared"))
                live_shared_array_ids[dest.id] = shared_array_ids[dest.id]

            case GpuAtomicOp(dest, op, ptr, value):
                index_upper_bounds.remove(dest.id)
                if op == GpuAtomicOpKind.CompareExchange:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan compare-exchange requires GpuAtomicCas"))
                val ptr_id = self.shared_pointer_operand_id(ptr, pointer_ids)
                if ptr_id == 0 or self.local_int_type_id(func, dest.id, u32_type, i64_type) != u32_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan atomic operation requires a lowered shared U32 pointer and U32 destination"))
                val value_result = self.resolve_int_operand(builder, value, u32_type, value_ids, func, u32_type, i64_type)
                if value_result.is_err():
                    return Err(value_result.unwrap_err())
                val value_id = value_result.unwrap()
                match op:
                    case Add:
                        value_ids[dest.id] = builder.emit_atomic_iadd(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Sub:
                        value_ids[dest.id] = builder.emit_atomic_isub(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case And:
                        value_ids[dest.id] = builder.emit_atomic_and(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Or:
                        value_ids[dest.id] = builder.emit_atomic_or(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Xor:
                        value_ids[dest.id] = builder.emit_atomic_xor(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Min:
                        value_ids[dest.id] = builder.emit_atomic_umin(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Max:
                        value_ids[dest.id] = builder.emit_atomic_umax(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case Exchange:
                        value_ids[dest.id] = builder.emit_atomic_exchange(u32_type, ptr_id, scope_workgroup, semantics_workgroup, value_id)
                    case _:
                        return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan atomic operation is not implemented: {op}"))

            case GpuAtomicCas(dest, ptr, expected, desired):
                index_upper_bounds.remove(dest.id)
                val ptr_id = self.shared_pointer_operand_id(ptr, pointer_ids)
                if ptr_id == 0 or self.local_int_type_id(func, dest.id, u32_type, i64_type) != u32_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan atomic compare-exchange requires a lowered shared U32 pointer and U32 destination"))
                val expected_result = self.resolve_int_operand(builder, expected, u32_type, value_ids, func, u32_type, i64_type)
                if expected_result.is_err():
                    return Err(expected_result.unwrap_err())
                val desired_result = self.resolve_int_operand(builder, desired, u32_type, value_ids, func, u32_type, i64_type)
                if desired_result.is_err():
                    return Err(desired_result.unwrap_err())
                value_ids[dest.id] = builder.emit_atomic_compare_exchange(
                    u32_type, ptr_id, scope_workgroup, semantics_workgroup,
                    semantics_workgroup_unequal, desired_result.unwrap(), expected_result.unwrap()
                )

            case Nop:
                ()

            case _:
                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan backend does not support instruction: {inst.kind}"))

        Ok(())

    fn function_uses_i64(func: MirFunction) -> bool:
        for local in func.locals:
            match local.type_.kind:
                case I64:
                    return true
                case _:
                    ()
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case GetElementPtr(_, _, indices):
                        for index in indices:
                            match index.kind:
                                case Const(_, ty):
                                    if ty.kind == MirTypeKind.I64:
                                        return true
                                case _:
                                    ()
                    case _:
                        ()
        false

    fn function_uses_grid_dim(func: MirFunction) -> bool:
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case GpuGridDim(_, _):
                        return true
                    case _:
                        ()
        false

    fn function_uses_shared_memory(func: MirFunction) -> bool:
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case GpuSharedAlloc(_, _, _):
                        return true
                    case _:
                        ()
        false

    fn function_uses_atomic_cas(func: MirFunction) -> bool:
        for block in func.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case GpuAtomicCas(_, _, _, _):
                        return true
                    case _:
                        ()
        false

    fn function_uses_bool(func: MirFunction) -> bool:
        for local in func.locals:
            if local.type_.kind == MirTypeKind.Bool:
                return true
        for block in func.blocks:
            match block.terminator:
                case If(_, _, _):
                    return true
                case _:
                    ()
            for inst in block.instructions:
                match inst.kind:
                    case BinOp(_, Eq, _, _) | BinOp(_, Ne, _, _) | BinOp(_, Lt, _, _) | BinOp(_, Le, _, _) | BinOp(_, Gt, _, _) | BinOp(_, Ge, _, _):
                        return true
                    case _:
                        ()
        false

    fn int_type_id(ty: MirType, u32_type: i64, i64_type: i64) -> i64:
        match ty.kind:
            case U32:
                u32_type
            case I64:
                i64_type
            case _:
                0

    fn local_int_type_id(func: MirFunction, local_id: i64, u32_type: i64, i64_type: i64) -> i64:
        for local in func.locals:
            if local.id.id == local_id:
                return self.int_type_id(local.type_, u32_type, i64_type)
        0

    fn local_is_bool(func: MirFunction, local_id: i64) -> bool:
        for local in func.locals:
            if local.id.id == local_id:
                return local.type_.kind == MirTypeKind.Bool
        false

    fn operand_int_type_id(func: MirFunction, operand: MirOperand, u32_type: i64, i64_type: i64) -> i64:
        match operand.kind:
            case Copy(local) | Move(local):
                self.local_int_type_id(func, local.id, u32_type, i64_type)
            case Const(_, ty):
                self.int_type_id(ty, u32_type, i64_type)

    fn local_is_u32_ptr(func: MirFunction, local_id: i64) -> bool:
        for local in func.locals:
            if local.id.id == local_id:
                match local.type_.kind:
                    case Ptr(pointee, is_mutable):
                        return pointee.kind == MirTypeKind.U32 and is_mutable
                    case _:
                        return false
        false

    fn local_is_u32_pointer(func: MirFunction, local_id: i64) -> bool:
        for local in func.locals:
            if local.id.id == local_id:
                match local.type_.kind:
                    case Ptr(pointee, _) | Ref(pointee, _):
                        return pointee.kind == MirTypeKind.U32
                    case _:
                        return false
        false

    fn operand_is_mutable_u32_pointer(func: MirFunction, operand: MirOperand) -> bool:
        match operand.kind:
            case Copy(local) | Move(local):
                for candidate in func.locals:
                    if candidate.id.id == local.id:
                        match candidate.type_.kind:
                            case Ptr(pointee, mutable) | Ref(pointee, mutable):
                                return pointee.kind == MirTypeKind.U32 and mutable
                            case _:
                                return false
                false
            case _:
                false

    fn shared_array_operand_id(operand: MirOperand, shared_array_ids: Dict<i64, i64>) -> i64:
        match operand.kind:
            case Copy(local) | Move(local):
                if shared_array_ids.has(local.id):
                    return shared_array_ids[local.id]
                return 0
            case _:
                0

    fn shared_array_operand_size(operand: MirOperand, shared_array_sizes: Dict<i64, i64>) -> i64:
        match operand.kind:
            case Copy(local) | Move(local):
                if shared_array_sizes.has(local.id):
                    return shared_array_sizes[local.id]
                return 0
            case _:
                0

    fn shared_index_is_proven_in_bounds(operand: MirOperand, allocation_size: i64, index_upper_bounds: Dict<i64, i64>) -> bool:
        match operand.kind:
            case Const(Int(value), _):
                value >= 0 and value < allocation_size
            case Copy(local) | Move(local):
                index_upper_bounds.has(local.id) and index_upper_bounds[local.id] <= allocation_size
            case _:
                false

    fn shared_pointer_operand_id(operand: MirOperand, pointer_ids: Dict<i64, i64>) -> i64:
        match operand.kind:
            case Copy(local) | Move(local):
                if pointer_ids.has(local.id):
                    return pointer_ids[local.id]
                return 0
            case _:
                0

    fn storage_buffer_operand_id(operand: MirOperand, storage_buffer_ids: Dict<i64, i64>) -> i64:
        match operand.kind:
            case Copy(local) | Move(local):
                if storage_buffer_ids.has(local.id):
                    return storage_buffer_ids[local.id]
                return 0
            case _:
                0

    fn int_constant_in_range(value: i64, ty: MirType) -> bool:
        match ty.kind:
            case U32:
                value >= 0 and value <= 4294967295
            case I64:
                true
            case _:
                false

    fn emit_int_constant(builder: SpirvBuilder, type_id: i64, value: i64, i64_type: i64) -> i64:
        if type_id == i64_type and value < 0:
            return builder.emit_const_int_bits(type_id, value)
        builder.emit_const_int(type_id, value)

    fn predeclare_operand_constant(builder: SpirvBuilder, operand: MirOperand, u32_type: i64, i64_type: i64):
        match operand.kind:
            case Const(Int(value), ty):
                val type_id = self.int_type_id(ty, u32_type, i64_type)
                if type_id != 0 and self.int_constant_in_range(value, ty):
                    self.emit_int_constant(builder, type_id, value, i64_type)
            case _:
                ()

    fn resolve_int_operand(
        builder: SpirvBuilder,
        operand: MirOperand,
        expected_type: i64,
        value_ids: Dict<i64, i64>,
        func: MirFunction,
        u32_type: i64,
        i64_type: i64
    ) -> Result<i64, CompileError>:
        match operand.kind:
            case Copy(local) | Move(local):
                if self.local_int_type_id(func, local.id, u32_type, i64_type) != expected_type:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V operand type does not match binary result"))
                if value_ids.has(local.id):
                    return Ok(value_ids[local.id])
                Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V operand _l{local.id} has no value"))
            case Const(Int(value), ty):
                val type_id = self.int_type_id(ty, u32_type, i64_type)
                if type_id != expected_type or not self.int_constant_in_range(value, ty):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V inline integer constant type or range does not match"))
                Ok(self.emit_int_constant(builder, type_id, value, i64_type))
            case Const(_, _):
                Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V inline operands currently require U32 or I64 integer constants"))

    fn compile_terminator(
        builder: SpirvBuilder,
        term: MirTerminator,
        current_position: i64,
        block_positions: Dict<i64, i64>,
        block_labels: Dict<i64, i64>,
        value_ids: Dict<i64, i64>,
        func: MirFunction,
        bool_type: i64
    ) -> Result<(), CompileError>:
        """Compile block terminator."""
        match term:
            case Ret(value):
                if value.?:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan compute entry points cannot return a value"))
                builder.emit_return()
            case Goto(target):
                if not block_positions.has(target.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V goto target does not exist"))
                if block_positions[target.id] <= current_position:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V loop back-edges are not supported"))
                builder.emit_branch(block_labels[target.id])
            case If(cond, true_target, false_target):
                val cond_id = self.resolve_bool_operand(builder, cond, value_ids, func, bool_type)
                if cond_id.is_err():
                    return Err(cond_id.unwrap_err())
                val true_target_id = true_target.id
                val false_target_id = false_target.id
                if not block_positions.has(true_target_id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V branch target does not exist"))
                if not block_positions.has(false_target_id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V branch target does not exist"))
                if block_positions[true_target_id] <= current_position or block_positions[false_target_id] <= current_position:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V loop back-edges are not supported"))
                if block_positions[true_target_id] >= block_positions[false_target_id]:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V currently supports only if-without-else control flow"))
                var true_exit = -1
                var false_exit = -1
                var false_is_empty = false
                for block in func.blocks:
                    if block.id.id == true_target_id:
                        match block.terminator:
                            case Goto(target):
                                true_exit = target.id
                            case _:
                                ()
                    elif block.id.id == false_target_id:
                        false_is_empty = block.instructions.len() == 0
                        match block.terminator:
                            case Goto(target):
                                false_exit = target.id
                            case _:
                                ()
                var merge_target = false_target_id
                if true_exit != false_target_id:
                    if not false_is_empty or true_exit < 0 or true_exit != false_exit:
                        return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V currently supports only if-without-else control flow"))
                    merge_target = true_exit
                if not block_positions.has(merge_target):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V currently supports only if-without-else control flow"))
                if merge_target != false_target_id and block_positions[merge_target] <= block_positions[false_target_id]:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan SPIR-V currently supports only if-without-else control flow"))
                builder.emit("OpSelectionMerge {builder.id_str(block_labels[merge_target])} None")
                builder.emit_branch_conditional(cond_id.unwrap(), block_labels[true_target_id], block_labels[false_target_id])
            case Unreachable:
                builder.emit("OpUnreachable")
            case _:
                return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan backend does not support terminator: {term}"))
        Ok(())

    fn resolve_bool_operand(
        builder: SpirvBuilder,
        operand: MirOperand,
        value_ids: Dict<i64, i64>,
        func: MirFunction,
        bool_type: i64
    ) -> Result<i64, CompileError>:
        match operand.kind:
            case Copy(local) | Move(local):
                if not self.local_is_bool(func, local.id):
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan branch condition must be Bool"))
                if value_ids.has(local.id):
                    return Ok(value_ids[local.id])
                Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan branch condition has no value"))
            case Const(Bool(value), ty):
                if ty.kind != MirTypeKind.Bool:
                    return Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan branch condition must be Bool"))
                if value: Ok(builder.emit_const_true(bool_type)) else: Ok(builder.emit_const_false(bool_type))
            case _:
                Err(compileerror_backend_error(BackendKind.Vulkan, "Vulkan branch condition must be Bool"))

# ============================================================================
# Vulkan Compilation Results
# ============================================================================

struct VulkanCompiledModule:
    """Result of Vulkan compilation."""
    name: text
    spirv_assembly: text
    shaders: [VulkanComputeShader]
    vulkan_version: [i64]

struct VulkanComputeShader:
    """Compiled Vulkan compute shader."""
    name: text
    entry_point: text
    workgroup_size: [i64]

pub fn vulkan_compile_module_direct(module: MirModule) -> Result<CodegenOutput, CompileError>:
    VulkanCodegenBackend.create_with_options([1, 3], compileoptions_default_options()).compile_module(module)

# ============================================================================
# Codegen Trait Implementation
# ============================================================================

impl Codegen for VulkanCodegenBackend:
    fn backend_kind() -> BackendKind: BackendKind.Vulkan
    fn backend_name() -> text: "vulkan"
    fn supports_target(target: CodegenTarget) -> bool:
        gpu_backend_supports_target(BackendKind.Vulkan, target)
    fn output_kind() -> CodegenOutputKind: CodegenOutputKind.GpuCode

    fn compile_module(module: MirModule) -> Result<CodegenOutput, CompileError>:
        val result = self.compile(module)
        match result:
            case Ok(vk_module):
                Ok(CodegenOutput.gpu_output(module.name, vk_module.spirv_assembly))
            case Err(e):
                Err(e)

# ============================================================================
# GpuCodegen Trait Implementation
# ============================================================================

impl GpuCodegen for VulkanCodegenBackend:
    fn compile_kernel(func_name: text, body: MirBody) -> Result<text, CompileError>:
        val mir_body: MirBody = body
        if mir_body.arg_count < 0:
            return Err(compileerror_backend_error(
                BackendKind.Vulkan,
                "Vulkan compute entry argument count cannot be negative"
            ))
        var params: [MirType] = []
        var arg_index = 0
        for local in mir_body.locals:
            if vulkan_is_arg_local(local.kind):
                val index = vulkan_arg_index(local.kind)
                if index < 0:
                    return Err(compileerror_backend_error(
                        BackendKind.Vulkan,
                        "Vulkan compute entry argument local index cannot be negative"
                    ))
                if index >= mir_body.arg_count:
                    return Err(compileerror_backend_error(
                        BackendKind.Vulkan,
                        "Vulkan compute entry argument local index is outside its signature"
                    ))
        while arg_index < mir_body.arg_count:
            var found = false
            for local in mir_body.locals:
                if vulkan_is_arg_local(local.kind) and vulkan_arg_index(local.kind) == arg_index:
                    if found:
                        return Err(compileerror_backend_error(
                            BackendKind.Vulkan,
                            "Vulkan compute entry argument local index is duplicated"
                        ))
                    params = params.push(local.type_)
                    found = true
            if not found:
                return Err(compileerror_backend_error(
                    BackendKind.Vulkan,
                    "Vulkan compute entry argument local is missing from its signature"
                ))
            arg_index = arg_index + 1
        val vk_sig = MirSignature(params: params, return_type: mir_body.return_ty, is_variadic: false)
        val func = MirFunction(
            symbol: SymbolId(id: 0), name: func_name, signature: vk_sig,
            locals: mir_body.locals, blocks: mir_body.blocks, entry_block: BlockId.entry(), span: Span.empty(),
            generic_params: [], is_generic_template: false, specialization_of: nil,
            type_bindings: {}, layout_phase: nil, is_kernel: true,
            gpu_target: "vulkan", gpu_backend_order: "vulkan", is_export_c: false,
            export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
            has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false
        )
        val builder = SpirvBuilder.create(self.vulkan_version)
        if self.function_uses_i64(func):
            builder.add_capability("Int64")
        builder.emit_header()
        builder.emit_capabilities()
        builder.emit_extensions()
        builder.emit_memory_model()
        val result = self.compile_compute_shader(builder, func)
        match result:
            case Ok(_):
                Ok(builder.build())
            case Err(e):
                Err(e)

    fn compile_device_function(func_name: text, body: MirBody) -> Result<text, CompileError>:
        Err(compileerror_backend_error(
            BackendKind.Vulkan,
            "Vulkan does not support device functions; use compute shaders instead"
        ))

    fn compile_gpu_instruction(inst: MirInst) -> text:
        panic("Vulkan compile_gpu_instruction cannot propagate CompileError; use compile_kernel")

    fn compile_barrier(scope: CodegenBarrierScope) -> text:
        panic("Vulkan compile_barrier cannot propagate CompileError; use compile_kernel")

    fn compile_atomic(op: GpuAtomicOpKind, dest: LocalId, ptr: MirOperand, value: MirOperand) -> text:
        panic("Vulkan compile_atomic cannot propagate CompileError; use compile_kernel")

    fn gpu_memory_model() -> text:
        "SPIR-V GLSL450"

    fn is_kernel_function(body: MirBody) -> bool:
        val _ = body
        false

# ============================================================================
# Export
# ============================================================================
