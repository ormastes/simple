# WAT Code Generation - MIR to WebAssembly Text Format
#
# Translates MIR instructions to WAT (WebAssembly Text Format).
# Following the MirToLlvm pattern from llvm_ir_builder.spl.
#
# Each MIR LocalId maps to a WASM local variable ($lN).
# MIR basic blocks are translated to WASM structured control flow.
#
# Usage:
#   var codegen = MirToWat.create("my_module")
#   val wat = codegen.translate_module(mir_module)

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction}
use compiler.backend.wasm_backend.{WatBuilder, WasmType, WasmTarget}
use compiler.backend.wasm_type_mapper.{WasmTypeMapper}
use compiler.backend.wasm.wasm_memory.{WasmMemoryManager}
use compiler.backend.wasm.wasm_runtime.{emit_all_wasm_imports}
use compiler.backend.wasm.wasm_control_flow.{WasmControlFlow}

# ============================================================================
# MIR to WAT Translator
# ============================================================================

class MirToWat:
    """Translates MIR modules to WAT (WebAssembly Text Format).

    Handles:
    - Function translation with local variable mapping
    - Instruction translation for all MIR instruction categories
    - String constant collection and data segment emission
    - Control flow structuring
    """
    module_name: text
    type_mapper: WasmTypeMapper
    memory: WasmMemoryManager
    control_flow: WasmControlFlow
    use_wasi: bool
    local_counter: i64

    static fn create(module_name: text) -> MirToWat:
        """Create translator for wasm32-wasi target."""
        MirToWat(
            module_name: module_name,
            type_mapper: WasmTypeMapper.create_wasm32(),
            memory: WasmMemoryManager.create(),
            control_flow: WasmControlFlow.create(),
            use_wasi: true,
            local_counter: 0
        )

    static fn create_standalone(module_name: text) -> MirToWat:
        """Create translator for standalone wasm32 (no WASI)."""
        MirToWat(
            module_name: module_name,
            type_mapper: WasmTypeMapper.create_wasm32(),
            memory: WasmMemoryManager.create(),
            control_flow: WasmControlFlow.create(),
            use_wasi: false,
            local_counter: 0
        )

    me translate_module(module: MirModule) -> text:
        """Translate a complete MIR module to WAT text."""
        var builder = WatBuilder.create()
        builder.begin_module(self.module_name)

        # Emit imports
        emit_all_wasm_imports(builder, self.use_wasi)

        # First pass: collect string constants from all functions
        for func in module.functions:
            self.collect_strings(func)

        # Finalize memory layout
        self.memory.finalize()

        # Emit memory and globals
        self.memory.emit_memory_declaration(builder)
        self.memory.emit_globals(builder)

        # Emit data sections (string constants)
        self.memory.emit_data_sections(builder)

        # Emit bump allocator helper
        self.memory.emit_bump_alloc(builder)

        # Translate functions
        for func in module.functions:
            if not func.is_extern:
                self.translate_function(builder, func)

        # Export _start if present
        for func in module.functions:
            if func.name == "_start" or func.name == "__simple_main":
                builder.emit("(export \"{func.name}\" (func ${func.name}))")

        builder.end_module()
        builder.build()

    me collect_strings(func: MirFunction):
        """Collect string constants from a function for data segments."""
        for block in func.body.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case Const(dest, value, type_):
                        match value:
                            case Str(s):
                                self.memory.add_string(s)
                            case _:
                                ()
                    case _:
                        ()

    me translate_function(builder: WatBuilder, func: MirFunction):
        """Translate a single MIR function to WAT."""
        # Build parameter and result types
        var param_types: [WasmType] = []
        var param_names: [text] = []
        for local in func.body.locals:
            if local.kind == MirLocalKind.Arg:
                val wasm_ty = self.mir_type_to_wasm_type(local.ty)
                param_types.push(wasm_ty)
                param_names.push(local.name)

        var result_types: [WasmType] = []
        if func.body.return_ty.kind != MirTypeKind.Unit:
            result_types.push(self.mir_type_to_wasm_type(func.body.return_ty))

        # Emit function header
        var param_parts: [text] = []
        for i in 0..param_types.len():
            val name = param_names[i]
            val ty = param_types[i]
            param_parts.push(" (param ${name} {ty.to_text()})")
        val param_str = param_parts.join("")

        var result_parts: [text] = []
        for ty in result_types:
            result_parts.push(" (result {ty.to_text()})")
        val result_str = result_parts.join("")

        builder.emit("(func ${func.name}{param_str}{result_str}")
        builder.indent_level = builder.indent_level + 1

        # Emit local variables (non-arg locals)
        for local in func.body.locals:
            if local.kind != MirLocalKind.Arg:
                val wasm_ty = self.mir_type_to_wasm_type(local.ty)
                builder.emit("(local ${local.name} {wasm_ty.to_text()})")

        # Translate basic blocks
        for block in func.body.blocks:
            self.translate_block(builder, block)

        builder.indent_level = builder.indent_level - 1
        builder.emit(")")

    me translate_block(builder: WatBuilder, block: MirBlock):
        """Translate a basic block's instructions."""
        # Emit block label as comment
        if block.label.?:
            builder.emit(";; block: {block.label.unwrap()}")

        # Translate instructions
        for inst in block.instructions:
            self.translate_instruction(builder, inst)

        # Translate terminator
        self.translate_terminator(builder, block.terminator)

    me translate_instruction(builder: WatBuilder, inst: MirInst):
        """Translate a single MIR instruction to WAT."""
        match inst.kind:
            # Constants
            case Const(dest, value, type_):
                self.translate_const(builder, dest, value, type_)

            # Moves and copies
            case Copy(dest, src):
                builder.emit_local_named_get("_l{src.id}")
                builder.emit_local_named_set("_l{dest.id}")

            case Move(dest, src):
                builder.emit_local_named_get("_l{src.id}")
                builder.emit_local_named_set("_l{dest.id}")

            # Binary operations
            case BinOp(dest, op, left, right):
                self.translate_binop(builder, dest, op, left, right)

            # Unary operations
            case UnaryOp(dest, op, operand):
                self.translate_unaryop(builder, dest, op, operand)

            # Function calls
            case Call(dest, func_op, args):
                self.translate_call(builder, dest, func_op, args)

            # Memory operations
            case Alloc(dest, type_):
                val size = self.type_mapper.size_of(type_)
                builder.emit("i32.const {size}")
                builder.emit("call $__wasm_alloc")
                builder.emit_local_named_set("_l{dest.id}")

            case Load(dest, ptr):
                self.emit_operand(builder, ptr)
                builder.emit("i32.load offset=0 align=4")
                builder.emit_local_named_set("_l{dest.id}")

            case Store(ptr, value):
                self.emit_operand(builder, ptr)
                self.emit_operand(builder, value)
                builder.emit("i32.store offset=0 align=4")

            # Debug/Nop
            case Nop:
                builder.emit_nop()

            case DebugValue(local, name):
                builder.emit(";; debug: {name} = _l{local.id}")

            # Aggregate operations
            case Aggregate(dest, kind, operands):
                builder.emit(";; aggregate construct")
                var offset = 0
                for operand in operands:
                    builder.emit_local_named_get("_l{dest.id}")
                    builder.emit("i32.const {offset}")
                    builder.emit("i32.add")
                    self.emit_operand(builder, operand)
                    builder.emit("i64.store offset=0 align=4")
                    offset = offset + 8

            case GetField(dest, base, field):
                self.emit_operand(builder, base)
                val offset = field * 8
                builder.emit("i32.const {offset}")
                builder.emit("i32.add")
                builder.emit("i64.load offset=0 align=4")
                builder.emit_local_named_set("_l{dest.id}")

            case SetField(base, field, value):
                self.emit_operand(builder, base)
                val offset = field * 8
                builder.emit("i32.const {offset}")
                builder.emit("i32.add")
                self.emit_operand(builder, value)
                builder.emit("i64.store offset=0 align=4")

            case GetElementPtr(dest, base_op, indices):
                self.emit_operand(builder, base_op)
                for idx_op in indices:
                    self.emit_operand(builder, idx_op)
                    builder.emit("i64.const 8")
                    builder.emit("i64.mul")
                    builder.emit("i64.add")
                builder.emit_local_named_set("_l{dest.id}")

            case Cast(dest, operand, target_type):
                self.emit_operand(builder, operand)
                match target_type.kind:
                    case I32:
                        builder.emit("i32.wrap_i64")
                    case I64:
                        builder.emit("i64.extend_i32_s")
                    case F64:
                        builder.emit("f64.convert_i64_s")
                    case F32:
                        builder.emit("f32.convert_i64_s")
                    case _:
                        builder.emit(";; cast to unsupported type")
                builder.emit_local_named_set("_l{dest.id}")

            case Intrinsic(dest, name, args):
                match name:
                    case "sqrt":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.sqrt")
                    case "abs":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.abs")
                    case "ceil":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.ceil")
                    case "floor":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.floor")
                    case "trunc":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.trunc")
                    case "nearest":
                        self.emit_operand(builder, args[0])
                        builder.emit("f64.nearest")
                    case "min":
                        self.emit_operand(builder, args[0])
                        self.emit_operand(builder, args[1])
                        builder.emit("f64.min")
                    case "max":
                        self.emit_operand(builder, args[0])
                        self.emit_operand(builder, args[1])
                        builder.emit("f64.max")
                    case _:
                        builder.emit(";; unsupported intrinsic: {name}")
                if dest.?:
                    builder.emit_local_named_set("_l{dest.unwrap().id}")

            case CallIndirect(dest, ptr_op, args, sig):
                for arg in args:
                    self.emit_operand(builder, arg)
                self.emit_operand(builder, ptr_op)
                var param_parts: [text] = []
                for arg in args:
                    param_parts.push("i64")
                val param_str = param_parts.join(" ")
                val result_str = if dest.?: "result i64" else: ""
                builder.emit("call_indirect (type (func (param {param_str}) ({result_str})))")
                if dest.?:
                    builder.emit_local_named_set("_l{dest.unwrap().id}")

            case CheckedBinOp(dest, op, left, right):
                self.translate_binop(builder, dest, op, left, right)

            case _:
                builder.emit(";; unhandled instruction")

    me translate_const(builder: WatBuilder, dest: LocalId, value: MirConstValue, type_: MirType):
        """Translate a constant value."""
        match value:
            case Int(n):
                match type_.kind:
                    case I32:
                        builder.emit("i32.const {n}")
                    case _:
                        builder.emit("i64.const {n}")
                builder.emit_local_named_set("_l{dest.id}")

            case Float(f):
                builder.emit("f64.const {f}")
                builder.emit_local_named_set("_l{dest.id}")

            case Bool(b):
                val val_int = if b: 1 else: 0
                builder.emit("i32.const {val_int}")
                builder.emit_local_named_set("_l{dest.id}")

            case Str(s):
                val offset = self.memory.add_string(s)
                builder.emit("i32.const {offset}")
                builder.emit_local_named_set("_l{dest.id}")

            # MirConstValue is Int/Float/Bool/Str/Array/Tuple/Struct/Zero
            # (mir_types.spl:65). `Unit` and `Nil` were NOT variants, so both
            # arms were dead, and the real `Zero` variant fell to `case _:`
            # -- which emitted a comment and never ran emit_local_named_set,
            # leaving the destination local unwritten for every zero-init.
            case Zero:
                # A real lowering, not a guess: zero-initialize the local at
                # its own width. Aggregate zero-init needs a memory clear that
                # this backend has no lowering for, so it traps below instead.
                match type_.kind:
                    case I8: builder.emit("i32.const 0")
                    case I16: builder.emit("i32.const 0")
                    case I32: builder.emit("i32.const 0")
                    case U8: builder.emit("i32.const 0")
                    case U16: builder.emit("i32.const 0")
                    case U32: builder.emit("i32.const 0")
                    case Bool: builder.emit("i32.const 0")
                    case Char: builder.emit("i32.const 0")
                    case I64: builder.emit("i64.const 0")
                    case U64: builder.emit("i64.const 0")
                    case Ptr(_, _): builder.emit("i32.const 0")
                    case Ref(_, _): builder.emit("i32.const 0")
                    case F32: builder.emit("f32.const 0")
                    case F64: builder.emit("f64.const 0")
                    case _:
                        # Aggregate/vector/unit zero-init has no scalar push.
                        # Emitting i64.const 0 here would be a plausible value
                        # for a destination that is not a scalar at all.
                        builder.emit(";; UNSUPPORTED: zero-init of non-scalar type")
                        builder.emit("unreachable")
                builder.emit_local_named_set("_l{dest.id}")

            case _:
                # Array/Tuple/Struct aggregate constants. The previous Array
                # and Struct arms emitted `i64.const {elem}` / `i64.const
                # {field}` -- interpolating a MirConstValue (and, for Struct,
                # a Dict KEY, i.e. a text) into a numeric WAT operand, which
                # is not valid WAT. Neither had ever been exercised. There is
                # no correct aggregate-constant lowering in this backend yet,
                # so trap explicitly rather than emit malformed instructions
                # or leave the destination local unwritten.
                builder.emit(";; UNSUPPORTED: aggregate constant initializer")
                builder.emit("unreachable")

    me translate_binop(builder: WatBuilder, dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand):
        """Translate a binary operation."""
        self.emit_operand(builder, left)
        self.emit_operand(builder, right)

        # MirBinOp (mir_instruction_support.spl:178) has exactly these variants:
        #   Add Sub Mul Div Rem Pow MatMul BitAnd BitOr BitXor Shl Shr
        #   Eq Ne Lt Le Gt Ge
        #   BroadcastAdd BroadcastSub BroadcastMul BroadcastDiv BroadcastPow
        #   Offset
        # There are NO `And`/`Or`/`Xor`/`Mod` variants and NO `F*` float
        # variants. `case And:` was therefore an irrefutable BINDING pattern,
        # not a comparison, so it matched EVERY value that reached it and every
        # arm below it was dead -- including `case _:`. Measured before this
        # fix: Pow, MatMul, BitAnd, BitOr, BitXor, Shl, Shr, BroadcastAdd,
        # BroadcastSub, BroadcastMul, BroadcastDiv, BroadcastPow and Offset ALL
        # emitted `i32.and`. Seven of those had a correct lowering written
        # directly below the swallowing arm and it never ran.
        match op:
            case Add: builder.emit("i64.add")
            case Sub: builder.emit("i64.sub")
            case Mul: builder.emit("i64.mul")
            case Div: builder.emit("i64.div_s")
            case Rem: builder.emit("i64.rem_s")
            case Eq: builder.emit("i64.eq")
            case Ne: builder.emit("i64.ne")
            case Lt: builder.emit("i64.lt_s")
            case Le: builder.emit("i64.le_s")
            case Gt: builder.emit("i64.gt_s")
            case Ge: builder.emit("i64.ge_s")
            case Shl: builder.emit("i64.shl")
            case Shr: builder.emit("i64.shr_s")
            case BitAnd: builder.emit("i64.and")
            case BitOr: builder.emit("i64.or")
            case BitXor: builder.emit("i64.xor")

            case Offset:
                # Pointer arithmetic: base + byte offset, unscaled -- the same
                # lowering GetElementPtr already uses for pointer math in this
                # backend (i64.add), and what the LLVM backend emits as
                # `getelementptr i8` (core_codegen.spl:1261).
                builder.emit("i64.add")

            case Pow:
                # The old arm re-pushed BOTH operands (they are already on the
                # stack from the top of this function), converted them, and then
                # emitted only a comment -- leaving four values on the value
                # stack and never producing a result. WASM has no native pow and
                # wasm_runtime.spl imports no pow helper, so there is nothing to
                # call. Trap instead of emitting invalid WAT.
                builder.emit(";; UNSUPPORTED: wasm backend has no pow lowering")
                builder.emit("unreachable")

            case MatMul:
                builder.emit(";; UNSUPPORTED: wasm backend has no MatMul lowering")
                builder.emit("unreachable")
            case BroadcastAdd:
                builder.emit(";; UNSUPPORTED: wasm backend has no BroadcastAdd lowering")
                builder.emit("unreachable")
            case BroadcastSub:
                builder.emit(";; UNSUPPORTED: wasm backend has no BroadcastSub lowering")
                builder.emit("unreachable")
            case BroadcastMul:
                builder.emit(";; UNSUPPORTED: wasm backend has no BroadcastMul lowering")
                builder.emit("unreachable")
            case BroadcastDiv:
                builder.emit(";; UNSUPPORTED: wasm backend has no BroadcastDiv lowering")
                builder.emit("unreachable")
            case BroadcastPow:
                builder.emit(";; UNSUPPORTED: wasm backend has no BroadcastPow lowering")
                builder.emit("unreachable")

            case _:
                # Defensive: every MirBinOp variant is enumerated above, so this
                # only fires if the enum grows. Fail loudly rather than emit a
                # plausible instruction for an operation we cannot lower.
                builder.emit(";; UNSUPPORTED: unknown MirBinOp variant")
                builder.emit("unreachable")

        builder.emit_local_named_set("_l{dest.id}")

    me translate_unaryop(builder: WatBuilder, dest: LocalId, op: MirUnaryOp, operand: MirOperand):
        """Translate a unary operation."""
        # MirUnaryOp (mir_instruction_support.spl:198) has exactly four
        # variants: Neg, Not, BitNot, Transpose. `FNeg`, `Abs`, `Truncate`,
        # `Extend` and `SignExtend` are not variants, so `case FNeg:` was an
        # irrefutable BINDING that swallowed everything below it. Measured
        # before this fix: the real `BitNot` and `Transpose` variants both
        # emitted `f64.neg`, i.e. bitwise-not lowered to float negation.
        # Width conversion is reached through Cast, not UnaryOp.
        match op:
            case Neg:
                builder.emit("i64.const 0")
                self.emit_operand(builder, operand)
                builder.emit("i64.sub")
            case Not:
                self.emit_operand(builder, operand)
                builder.emit("i32.eqz")
            case BitNot:
                self.emit_operand(builder, operand)
                builder.emit("i64.const -1")
                builder.emit("i64.xor")
            case Transpose:
                builder.emit(";; UNSUPPORTED: wasm backend has no Transpose lowering")
                builder.emit("unreachable")
            case _:
                builder.emit(";; UNSUPPORTED: unknown MirUnaryOp variant")
                builder.emit("unreachable")

        builder.emit_local_named_set("_l{dest.id}")

    me translate_call(builder: WatBuilder, dest: LocalId?, func_op: MirOperand, args: [MirOperand]):
        """Translate a function call."""
        # Push arguments
        for arg in args:
            self.emit_operand(builder, arg)

        # Emit call
        # NOTE: this used to `match func_op:` (the MirOperand STRUCT, not its
        # kind) against `Constant`/`Use`, neither of which is a MirOperandKind
        # variant. With no `case _:` the match fell through for every real
        # callee, so translate_call emitted the argument pushes and then NO
        # call at all. Match `func_op.kind` against the real variants
        # (Copy/Move/Const), and destructure the constant in a SECOND match --
        # a nested enum sub-pattern in a payload position always matches and
        # never binds on the native/JIT lanes.
        match func_op.kind:
            case Const(value, _):
                match value:
                    case Str(name):
                        builder.emit("call ${name}")
                    case _:
                        # No WAT lowering exists for a non-symbol constant
                        # callee. Emitting a plausible call target here would
                        # silently call the wrong function, so trap instead.
                        builder.emit(";; UNSUPPORTED: non-symbol constant callee")
                        builder.emit("unreachable")
            case Copy(local_id):
                builder.emit_local_named_get("_l{local_id.id}")
                builder.emit("call_indirect")
            case Move(local_id):
                builder.emit_local_named_get("_l{local_id.id}")
                builder.emit("call_indirect")

        # Store result if dest exists
        if dest.?:
            builder.emit_local_named_set("_l{dest.unwrap().id}")

    me translate_terminator(builder: WatBuilder, term: MirTerminator):
        """Translate a block terminator."""
        match term.kind:
            case Ret(value):
                if value.?:
                    self.emit_operand(builder, value.unwrap())
                builder.emit_return()

            case Goto(target):
                builder.emit(";; goto block {target}")

            case CondBranch(cond, then_target, else_target):
                self.emit_operand(builder, cond)
                builder.emit(";; br_if then={then_target} else={else_target}")

            case Unreachable:
                builder.emit_unreachable()

            case Switch(cond, targets, default_target):
                self.emit_operand(builder, cond)
                # Emit br_table with targets
                var target_labels: [text] = []
                for target in targets:
                    target_labels.push("{target}")
                val labels_str = target_labels.join(" ")
                builder.emit("br_table {labels_str} {default_target}")

            case _:
                builder.emit(";; unhandled terminator")

    me emit_operand(builder: WatBuilder, operand: MirOperand):
        """Emit a MIR operand (push value onto stack)."""
        # Same defect as translate_call: this matched the MirOperand STRUCT
        # against `Use`/`Constant` (not MirOperandKind variants), so even the
        # `Move` arm never fired and every operand fell to the comment-only
        # default -- pushing NOTHING onto the WASM value stack while callers
        # (binop/call/store) assume a push happened.
        match operand.kind:
            case Copy(local_id):
                builder.emit_local_named_get("_l{local_id.id}")
            case Move(local_id):
                builder.emit_local_named_get("_l{local_id.id}")
            case Const(value, type_):
                match value:
                    case Int(n):
                        match type_.kind:
                            case I32:
                                builder.emit("i32.const {n}")
                            case _:
                                builder.emit("i64.const {n}")
                    case Float(f):
                        builder.emit("f64.const {f}")
                    case Bool(b):
                        val bool_int = if b: 1 else: 0
                        builder.emit("i32.const {bool_int}")
                    case Str(s):
                        val offset = self.memory.add_string(s)
                        builder.emit("i32.const {offset}")
                    case _:
                        # Array/Tuple/Struct/Zero constants have no direct
                        # push lowering. Trapping is mandatory: silently
                        # pushing nothing leaves the value stack short, which
                        # mis-binds every later operand instead of failing.
                        builder.emit(";; UNSUPPORTED: aggregate constant operand")
                        builder.emit("unreachable")

    fn mir_type_to_wasm_type(ty: MirType) -> WasmType:
        """Map MIR type to WASM type."""
        val type_str = self.type_mapper.map_type(ty)
        match type_str:
            case "i64": WasmType.I64
            case "i32": WasmType.I32
            case "f64": WasmType.F64
            case "f32": WasmType.F32
            case _: WasmType.I32

# ============================================================================
# Exports
# ============================================================================

