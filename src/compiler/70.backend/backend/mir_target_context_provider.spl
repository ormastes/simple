# Backend boundary for immutable MIR target state.

use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from, mir_target_context_normalize_arch}
use compiler.backend.backend.llvm_capability.{LlvmCapabilityReport, get_llvm_capabilities}
# Was: std.platform.{host_arch, host_os} (nogc_sync_mut.platform), whose
# host_os() delegates to std.nogc_sync_mut.env.platform.detect_os() -- the
# same detector already shown (by a live trace in the win-native-link-cc fix)
# to answer "not Windows" inside this exact Stage 2 bootstrap sanity harness,
# on a real Windows host, while std.io_runtime.host_os() answers "windows"
# correctly in the same process. Here that misdetection was worse than a
# wrong linker-flag branch: backend_mir_target_context() feeds host_os()
# straight into the MIR target context llc is invoked with, so a false
# non-Windows reading made llc emit an ELF object (its own default target is
# genuinely x86_64-pc-windows-msvc; only an explicit wrong triple overrides
# it) that MSVC's link.exe then rejected as corrupt (LNK1107, "cannot read
# at 0x3E8" -- 0x3E8 = 1000 = the exact byte length of that truncated ELF
# .o). Use std.io_runtime.host_arch/host_os instead.
use std.io_runtime.{env_get_opt, host_arch, host_os}

fn backend_aot_simpleos_target_triple(target: text) -> text:
    val value = target.trim().lower()
    if value == "simpleos" or value.starts_with("simpleos-x86_64"):
        return "x86_64-unknown-none-elf"
    if not value.contains("simpleos"):
        return ""
    match mir_target_context_normalize_arch(value.split("-")[0]):
        case "x86_64": "x86_64-unknown-none-elf"
        case "aarch64": "aarch64-unknown-none-elf"
        case "riscv64": "riscv64gc-unknown-none-elf"
        case _: ""

fn backend_normalize_requested_aot_target(target: text) -> text:
    val value = target.trim().lower()
    val simpleos_target = backend_aot_simpleos_target_triple(value)
    if simpleos_target != "":
        return simpleos_target
    if value == "host" or value == "native": "" else: value

fn backend_requested_target_triple() -> text:
    val value = (env_get_opt("SIMPLE_NATIVE_BUILD_TARGET") ?? "").trim().lower()
    if value == "host" or value == "native": "" else: value

fn backend_requested_aot_target_triple(target_arch: text) -> text:
    val configured = (env_get_opt("SIMPLE_NATIVE_BUILD_TARGET") ?? "").trim().lower()
    if configured != "":
        return backend_normalize_requested_aot_target(configured)
    val simpleos_target = backend_aot_simpleos_target_triple(target_arch)
    if simpleos_target != "":
        return simpleos_target
    val arch = mir_target_context_normalize_arch(target_arch)
    if arch == "" or arch == "host" or arch == "native" or arch == mir_target_context_normalize_arch(host_arch()):
        return ""
    match arch:
        case "x86_64": "x86_64-unknown-linux-gnu"
        case "aarch64": "aarch64-unknown-linux-gnu"
        case "riscv64": "riscv64gc-unknown-linux-gnu"
        case _: ""

fn backend_mir_target_context(backend: text) -> MirTargetContext:
    var version = -1
    if backend == "llvm":
        val capabilities: LlvmCapabilityReport = get_llvm_capabilities()
        version = capabilities.llc.version.major
    elif backend == "llvm-lib" or backend == "llvmlib":
        val capabilities: LlvmCapabilityReport = get_llvm_capabilities()
        version = capabilities.libllvm.version.major

    val known_version = if version > 0: version else: -1
    mir_target_context_from(
        backend_requested_target_triple(),
        host_arch(),
        host_os(),
        backend,
        known_version
    )
