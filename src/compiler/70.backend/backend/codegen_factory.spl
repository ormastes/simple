# Codegen Factory - Creates Codegen Trait Implementations
#
# Centralizes creation of Codegen trait objects from BackendKind.
# Used by Backend.for_target_and_mode() and other constructors.

use compiler.backend.backend.backend_types.{BackendKind, CodegenTarget, BackendCompileOptions, compileoptions_default_options}
use compiler.backend.codegen_types.{Codegen}
use std.log.{debug}
use compiler.backend.backend.static_backend_registry.{active_static_backend_table_v1, select_static_backend_v1, static_backend_codegen_v1}

# ============================================================================
# Codegen Factory
# ============================================================================

class CodegenFactory:
    """Creates Codegen trait objects for any BackendKind."""

    static fn create(kind: BackendKind, options: BackendCompileOptions) -> Codegen:
        """Create a Codegen implementation for the given backend kind."""
        # Exactly one table negotiation per compile-session construction. The
        # selected adapter retains direct MIR traversal; no registry dispatch
        # occurs per MIR node.
        # The bootstrap producer only materializes constant argument defaults;
        # pass the current table explicitly across this native call boundary.
        # Tracked in stage2_backend_selector_missing_table_argument_2026-09-09.md.
        val table = active_static_backend_table_v1()
        val selected = match select_static_backend_v1(kind.to_text(), table):
            case Ok(entry): entry
            case Err(selection_error): error("{selection_error.code()}: backend={kind.to_text()}")
        debug("codegen", "Creating codegen adapter for backend={selected.kind}")
        static_backend_codegen_v1(selected, options)

# ============================================================================
# Exports
# ============================================================================
