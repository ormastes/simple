# PTX Builder - CUDA PTX Assembly Code Generation
#
# Generates PTX (Parallel Thread Execution) assembly code from MIR.
# PTX is NVIDIA's virtual GPU instruction set.

use compiler.backend.common.type_mapper.{PrimitiveType}
use compiler.mir.mir_data.*
use compiler.backend.cuda_type_mapper.{CudaTypeMapper, cuda_type_mapper_create_sm}
use compiler.hir.hir_types.MemorySpace
use std.common.binary_io.{f32_to_bits, f64_to_bits}
use std.common.format.{format_hex_upper, format_zero_pad}

# PTX ISA version emitted in every module header (single definition).
# The builder emits sm_70+ era features (shfl.sync / vote.sync.ballot,
# bar.warp.sync, membar.*, atom.*, vector ld/st.global.v2/v4) — all present
# well before ISA 8.0 — and backends default to sm_86 with sm_89/sm_90
# possible. ISA 8.0 (CUDA 12.0) is the conservative floor: it covers those
# targets and every CUDA 12+ driver JIT accepts it, while the previous 7.8
# was stale relative to sm_89/sm_90 support.
val PTX_ISA_VERSION: text = "8.0"

fn ptx_f32_hex(value: f64) -> text:
    format_zero_pad(format_hex_upper(f32_to_bits(value as f32) as i64), 8)

fn ptx_f64_hex(value: f64) -> text:
    val bits = f64_to_bits(value)
    val high = ((bits >> 32) & 0xFFFFFFFFu64) as i64
    val low = (bits & 0xFFFFFFFFu64) as i64
    format_zero_pad(format_hex_upper(high), 8) + format_zero_pad(format_hex_upper(low), 8)

# ============================================================================
# PTX Builder
# ============================================================================

class PtxBuilder:
    """
    Generates PTX assembly code for CUDA.

    PTX is an intermediate representation that NVIDIA's driver
    compiles to native GPU machine code (SASS) at load time.

    Features:
    - Virtual registers (unlimited)
    - Typed operations
    - Memory space qualifiers
    - Predicated execution
    - Synchronization barriers
    """

    type_mapper: CudaTypeMapper
    compute_capability: (i64, i64)
    output: [text]
    next_reg: i64
    next_label: i64
    next_call: i64
    indent_level: i64

    static fn create(compute_cap: (i64, i64)) -> PtxBuilder:
        """Create PTX builder for specific compute capability."""
        PtxBuilder(
            type_mapper: cuda_type_mapper_create_sm(compute_cap.0, compute_cap.1),
            compute_capability: compute_cap,
            output: [],
            next_reg: 0,
            next_label: 0,
            next_call: 0,
            indent_level: 0
        )

    # === Module Structure ===

    me emit_module_header(name: text):
        """Emit PTX module header."""
        val major = self.compute_capability.0
        val minor = self.compute_capability.1
        self.emit_line(".version {PTX_ISA_VERSION}")
        self.emit_line(".target sm_{major}{minor}")
        self.emit_line(".address_size 64")
        self.emit_line("")
        self.emit_line("// Module: {name}")
        self.emit_line("")

    me emit_kernel_entry(name: text, params: [MirLocal]):
        """Emit kernel entry point declaration."""
        self.emit_line(".visible .entry {name}(")
        self.indent_level = self.indent_level + 1

        var args: [MirLocal] = []
        for param in params:
            match param.kind:
                case Arg(_): args = args.push(param)
                case _: ()
        val params_len = args.len()
        for item in args.enumerate():
            val i = item.0
            val param = item.1
            val tm = self.type_mapper
            val ty = match param.type_.kind:
                case MirTypeKind.Bool: ".u8"
                case Ptr(_, _) | Ref(_, _) | FuncPtr(_): ".u64"
                case _: tm.ptx_type(param.type_.kind)
            val comma = if i < params_len - 1: "," else: ""
            self.emit_line(".param {ty} param_{i}{comma}")

        self.indent_level = self.indent_level - 1
        self.emit_line(")")
        self.emit_line("{")
        self.indent_level = self.indent_level + 1

    me emit_kernel_end():
        """Emit kernel end."""
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("")

    me emit_function_end():
        """Emit function end (same as kernel end)."""
        self.indent_level = self.indent_level - 1
        self.emit_line("}")
        self.emit_line("")

    me emit_device_function(name: text, params: [MirLocal], ret_type: MirType):
        """Emit device function declaration."""
        val tm = self.type_mapper
        val ret = match ret_type.kind:
            case Ptr(_, _) | Ref(_, _) | FuncPtr(_): ".u64"
            case _: tm.ptx_type(ret_type.kind)
        if ret_type.kind == MirTypeKind.Unit:
            self.emit_line(".visible .func {name}(")
        else:
            self.emit_line(".visible .func (.param {ret} retval) {name}(")
        self.indent_level = self.indent_level + 1

        var args: [MirLocal] = []
        for param in params:
            match param.kind:
                case Arg(_): args = args.push(param)
                case _: ()
        val params_len = args.len()
        for item in args.enumerate():
            val i = item.0
            val param = item.1
            val tm2 = self.type_mapper
            val ty = match param.type_.kind:
                case MirTypeKind.Bool: ".u8"
                case Ptr(_, _) | Ref(_, _) | FuncPtr(_): ".u64"
                case _: tm2.ptx_type(param.type_.kind)
            val comma = if i < params_len - 1: "," else: ""
            self.emit_line(".param {ty} param_{i}{comma}")

        self.indent_level = self.indent_level - 1
        self.emit_line(")")
        self.emit_line("{")
        self.indent_level = self.indent_level + 1

    # === Register Allocation ===

    me alloc_reg(ty: PrimitiveType) -> text:
        """Allocate a virtual register."""
        val reg_num = self.next_reg
        self.next_reg = self.next_reg + 1
        "%r{reg_num}"

    me reserve_reg_id(id: i64):
        """Keep generated temporaries above fixed MIR-local register IDs."""
        if self.next_reg <= id:
            self.next_reg = id + 1

    me alloc_pred_reg() -> text:
        """Allocate a predicate register."""
        val reg_num = self.next_reg
        self.next_reg = self.next_reg + 1
        "%p{reg_num}"

    me emit_reg_decl(reg: text, ty: PrimitiveType):
        """Emit register declaration."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line(".reg {ptx_ty} {reg};")

    me emit_pred_decl(reg: text):
        """Emit predicate register declaration."""
        self.emit_line(".reg .pred {reg};")

    # === Special Registers (Thread/Block IDs) ===

    me emit_get_thread_id(dest: text, dim: i64):
        """Emit instruction to get thread ID within block."""
        val dim_name = match dim:
            case 0: "x"
            case 1: "y"
            case 2: "z"
            case _: panic("Invalid dimension: {dim}")
        self.emit_line("mov.u32 {dest}, %tid.{dim_name};")

    me emit_get_block_id(dest: text, dim: i64):
        """Emit instruction to get block ID."""
        val dim_name = match dim:
            case 0: "x"
            case 1: "y"
            case 2: "z"
            case _: panic("Invalid dimension: {dim}")
        self.emit_line("mov.u32 {dest}, %ctaid.{dim_name};")

    me emit_get_block_dim(dest: text, dim: i64):
        """Emit instruction to get block dimensions."""
        val dim_name = match dim:
            case 0: "x"
            case 1: "y"
            case 2: "z"
            case _: panic("Invalid dimension: {dim}")
        self.emit_line("mov.u32 {dest}, %ntid.{dim_name};")

    me emit_get_grid_dim(dest: text, dim: i64):
        """Emit instruction to get grid dimensions."""
        val dim_name = match dim:
            case 0: "x"
            case 1: "y"
            case 2: "z"
            case _: panic("Invalid dimension: {dim}")
        self.emit_line("mov.u32 {dest}, %nctaid.{dim_name};")

    me emit_compute_global_id(dest: text, dim: i64):
        """Emit instructions to compute global thread ID."""
        val tid = self.alloc_reg(PrimitiveType.U32)
        val bid = self.alloc_reg(PrimitiveType.U32)
        val bdim = self.alloc_reg(PrimitiveType.U32)
        val tmp = self.alloc_reg(PrimitiveType.U32)

        self.emit_reg_decl(tid, PrimitiveType.U32)
        self.emit_reg_decl(bid, PrimitiveType.U32)
        self.emit_reg_decl(bdim, PrimitiveType.U32)
        self.emit_reg_decl(tmp, PrimitiveType.U32)

        self.emit_get_thread_id(tid, dim)
        self.emit_get_block_id(bid, dim)
        self.emit_get_block_dim(bdim, dim)
        self.emit_line("mul.lo.u32 {tmp}, {bid}, {bdim};")
        self.emit_line("add.u32 {dest}, {tmp}, {tid};")

    # === Arithmetic Operations ===

    me emit_add(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit add instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        match ty:
            case F32:
                self.emit_line("add{ptx_ty} {dest}, {a}, {b};")
            case F64:
                self.emit_line("add{ptx_ty} {dest}, {a}, {b};")
            case _:
                self.emit_line("add{ptx_ty} {dest}, {a}, {b};")

    me emit_sub(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit subtract instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("sub{ptx_ty} {dest}, {a}, {b};")

    me emit_mul(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit multiply instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        match ty:
            case F32:
                self.emit_line("mul{ptx_ty} {dest}, {a}, {b};")
            case F64:
                self.emit_line("mul{ptx_ty} {dest}, {a}, {b};")
            case _:
                self.emit_line("mul.lo{ptx_ty} {dest}, {a}, {b};")

    me emit_div(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit divide instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        match ty:
            case F32:
                self.emit_line("div.approx{ptx_ty} {dest}, {a}, {b};")
            case F64:
                self.emit_line("div.rn{ptx_ty} {dest}, {a}, {b};")
            case _:
                self.emit_line("div{ptx_ty} {dest}, {a}, {b};")

    me emit_neg(dest: text, ty: PrimitiveType, src: text):
        """Emit negate instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        match ty:
            case U16 | U32 | U64:
                self.emit_line("sub{ptx_ty} {dest}, 0, {src};")
            case _:
                self.emit_line("neg{ptx_ty} {dest}, {src};")

    me emit_bitnot(dest: text, ty: PrimitiveType, src: text):
        """Emit integer one's complement after CUDA unary type validation."""
        val width = match ty:
            case I16 | U16: 16
            case I32 | U32: 32
            case _: 64
        self.emit_line("not.b{width} {dest}, {src};")

    # === Memory Operations ===

    me emit_load(dest: text, ty: PrimitiveType, addr: text, space: MemorySpace):
        """Emit load instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val space_str = tm.ptx_state_space(space)
        self.emit_line("ld{space_str}{ptx_ty} {dest}, [{addr}];")

    me emit_store(ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit store instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val space_str = tm.ptx_state_space(space)
        self.emit_line("st{space_str}{ptx_ty} [{addr}], {value};")

    me emit_shared_memory(name: text, ty: PrimitiveType, count: i64):
        """Emit shared memory allocation."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line(".shared {ptx_ty} {name}[{count}];")

    me emit_shared_address(dest: text, name: text):
        """Materialize a generic address for statically allocated shared storage."""
        self.emit_line("cvta.shared.u64 {dest}, {name};")

    me emit_param_load(dest: text, ty: PrimitiveType, index: i64):
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("ld.param{ptx_ty} {dest}, [param_{index}];")

    me emit_bool_param_load(dest: text, index: i64):
        val tmp = self.alloc_reg(PrimitiveType.U16)
        self.emit_reg_decl(tmp, PrimitiveType.U16)
        self.emit_line("ld.param.u8 {tmp}, [param_{index}];")
        self.emit_line("setp.ne.u16 {dest}, {tmp}, 0;")

    me emit_local_alloc(name: text, ty: PrimitiveType, count: i64):
        """Emit local memory allocation."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line(".local {ptx_ty} {name}[{count}];")

    # === Comparison and Branching ===

    me emit_compare(dest: text, op: text, ty: PrimitiveType, a: text, b: text):
        """Emit comparison instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("setp.{op}{ptx_ty} {dest}, {a}, {b};")

    me emit_branch(label: text):
        """Emit unconditional branch."""
        self.emit_line("bra {label};")

    me emit_branch_if(pred: text, label: text):
        """Emit conditional branch."""
        self.emit_line("@{pred} bra {label};")

    me emit_branch_if_not(pred: text, label: text):
        """Emit conditional branch (negated)."""
        self.emit_line("@!{pred} bra {label};")

    me emit_label(label: text):
        """Emit label."""
        self.output = self.output.push("{label}:")

    me alloc_label() -> text:
        """Allocate a new label."""
        val label_num = self.next_label
        self.next_label = self.next_label + 1
        "L{label_num}"

    # === Synchronization ===

    me emit_barrier():
        """Emit thread barrier (block-level)."""
        self.emit_line("bar.sync 0;")

    me emit_membar_cta():
        """Emit memory barrier (CTA/block level)."""
        self.emit_line("membar.cta;")

    me emit_membar_gl():
        """Emit memory barrier (global level)."""
        self.emit_line("membar.gl;")

    me emit_membar_sys():
        """Emit memory barrier (system level)."""
        self.emit_line("membar.sys;")

    # === Atomic Operations ===

    me emit_atomic_add(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic add instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val atomic_ty = if ty == PrimitiveType.I64: ".u64" else: ptx_ty
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.add{atomic_ty} {dest}, [{addr}], {value};")

    me emit_atomic_min(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic min instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.min{ptx_ty} {dest}, [{addr}], {value};")

    me emit_atomic_max(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic max instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.max{ptx_ty} {dest}, [{addr}], {value};")

    me emit_atomic_sub(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic subtract (via neg + add) instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val atomic_ty = if ty == PrimitiveType.I64: ".u64" else: ptx_ty
        val neg_ty = match ty:
            case U32: ".s32"
            case U64: ".s64"
            case _: ptx_ty
        val space_str = tm.ptx_state_space(space)
        # PTX has no atom.sub; negate value then atomic add
        val neg_tmp = self.alloc_reg(ty)
        self.emit_reg_decl(neg_tmp, ty)
        self.emit_line("neg{neg_ty} {neg_tmp}, {value};")
        self.emit_line("atom{space_str}.add{atomic_ty} {dest}, [{addr}], {neg_tmp};")

    me emit_atomic_and(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic bitwise AND instruction."""
        val tm = self.type_mapper
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.and{self.atomic_bit_type(ty)} {dest}, [{addr}], {value};")

    me emit_atomic_or(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic bitwise OR instruction."""
        val tm = self.type_mapper
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.or{self.atomic_bit_type(ty)} {dest}, [{addr}], {value};")

    me emit_atomic_xor(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic bitwise XOR instruction."""
        val tm = self.type_mapper
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.xor{self.atomic_bit_type(ty)} {dest}, [{addr}], {value};")

    me emit_atomic_exch(dest: text, ty: PrimitiveType, addr: text, value: text, space: MemorySpace):
        """Emit atomic exchange instruction."""
        val tm = self.type_mapper
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.exch{self.atomic_bit_type(ty)} {dest}, [{addr}], {value};")

    me emit_atomic_cas(dest: text, ty: PrimitiveType, addr: text, compare: text, value: text, space: MemorySpace):
        """Emit atomic compare-and-swap instruction."""
        val tm = self.type_mapper
        val space_str = tm.ptx_state_space(space)
        self.emit_line("atom{space_str}.cas{self.atomic_bit_type(ty)} {dest}, [{addr}], {compare}, {value};")

    fn atomic_bit_type(ty: PrimitiveType) -> text:
        match ty:
            case I64 | U64 | F64:
                ".b64"
            case _:
                ".b32"

    # === Function Calls ===

    me emit_call(dest: text, ty: PrimitiveType, func_name: text, args: [text], arg_types: [PrimitiveType]):
        """Emit an ABI-compliant PTX function call with return value."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        val call_id = self.next_call
        self.next_call = self.next_call + 1
        var params: [text] = []
        for i in 0..args.len():
            val param = "__call_{call_id}_arg_{i}"
            val arg_ty = tm.ptx_type(arg_types[i])
            self.emit_line(".param {arg_ty} {param};")
            self.emit_line("st.param{arg_ty} [{param}], {args[i]};")
            params = params.push(param)
        val retval = "__call_{call_id}_retval"
        self.emit_line(".param {ptx_ty} {retval};")
        self.emit_line("call ({retval}), {func_name}, ({params.join(", ")});")
        self.emit_line("ld.param{ptx_ty} {dest}, [{retval}];")

    me emit_call_void(func_name: text, args: [text], arg_types: [PrimitiveType]):
        """Emit an ABI-compliant PTX void function call."""
        val call_id = self.next_call
        self.next_call = self.next_call + 1
        var params: [text] = []
        for i in 0..args.len():
            val param = "__call_{call_id}_arg_{i}"
            val arg_ty = self.type_mapper.ptx_type(arg_types[i])
            self.emit_line(".param {arg_ty} {param};")
            self.emit_line("st.param{arg_ty} [{param}], {args[i]};")
            params = params.push(param)
        self.emit_line("call {func_name}, ({params.join(", ")});")

    # === Conversion ===

    me emit_convert(dest: text, dest_ty: PrimitiveType, src: text, src_ty: PrimitiveType):
        """Emit type conversion instruction."""
        val tm = self.type_mapper
        val dest_ptx = tm.ptx_type(dest_ty)
        val src_ptx = tm.ptx_type(src_ty)

        # Float to float
        if ((dest_ty == PrimitiveType.F32 or dest_ty == PrimitiveType.F64) and
           (src_ty == PrimitiveType.F32 or src_ty == PrimitiveType.F64)):
            self.emit_line("cvt.rn{dest_ptx}{src_ptx} {dest}, {src};")
        # Int to float
        elif dest_ty == PrimitiveType.F32 or dest_ty == PrimitiveType.F64:
            self.emit_line("cvt.rn{dest_ptx}{src_ptx} {dest}, {src};")
        # Float to int
        elif src_ty == PrimitiveType.F32 or src_ty == PrimitiveType.F64:
            self.emit_line("cvt.rzi{dest_ptx}{src_ptx} {dest}, {src};")
        # Int to int
        else:
            self.emit_line("cvt{dest_ptx}{src_ptx} {dest}, {src};")

    # === Constants ===

    me emit_const_int(dest: text, ty: PrimitiveType, value: i64):
        """Emit integer constant load."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("mov{ptx_ty} {dest}, {value};")

    me emit_const_float(dest: text, ty: PrimitiveType, value: f64):
        """Emit float constant load."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        # PTX uses 0F/0D prefix for float/double literals
        match ty:
            case F32:
                self.emit_line("mov{ptx_ty} {dest}, 0F{ptx_f32_hex(value)};")
            case F64:
                self.emit_line("mov{ptx_ty} {dest}, 0D{ptx_f64_hex(value)};")
            case _:
                panic("Invalid float type: {ty}")

    # === Intrinsics ===

    me emit_intrinsic_sin(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX sin approximation instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("sin.approx{ptx_ty} {dest}, {src};")

    me emit_intrinsic_cos(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX cos approximation instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("cos.approx{ptx_ty} {dest}, {src};")

    me emit_intrinsic_sqrt(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX sqrt instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("sqrt.approx{ptx_ty} {dest}, {src};")

    me emit_intrinsic_abs(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX abs instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("abs{ptx_ty} {dest}, {src};")

    me emit_intrinsic_min(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit PTX min instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("min{ptx_ty} {dest}, {a}, {b};")

    me emit_intrinsic_max(dest: text, ty: PrimitiveType, a: text, b: text):
        """Emit PTX max instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("max{ptx_ty} {dest}, {a}, {b};")

    me emit_intrinsic_fma(dest: text, ty: PrimitiveType, a: text, b: text, c: text):
        """Emit PTX fused multiply-add instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("fma.rn{ptx_ty} {dest}, {a}, {b}, {c};")

    me emit_intrinsic_ex2(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX exp2 (2^x) approximation instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("ex2.approx{ptx_ty} {dest}, {src};")

    me emit_intrinsic_lg2(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX log2 approximation instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("lg2.approx{ptx_ty} {dest}, {src};")

    me emit_intrinsic_rcp(dest: text, ty: PrimitiveType, src: text):
        """Emit PTX reciprocal approximation instruction."""
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("rcp.approx{ptx_ty} {dest}, {src};")

    # === Return ===

    me emit_ret():
        """Emit return instruction."""
        self.emit_line("ret;")

    me emit_return_value(ty: PrimitiveType, src: text):
        val tm = self.type_mapper
        val ptx_ty = tm.ptx_type(ty)
        self.emit_line("st.param{ptx_ty} [retval], {src};")

    me emit_exit():
        """Emit kernel exit instruction."""
        self.emit_line("exit;")

    # === Output ===

    me emit_line(line: text):
        """Emit a line of PTX code with proper indentation."""
        val indent = "    ".repeat(self.indent_level)
        self.output = self.output.push("{indent}{line}")

    me emit_comment(comment: text):
        """Emit a comment."""
        self.emit_line("// {comment}")

    fn build() -> text:
        """Build final PTX code."""
        self.output.join("\n")

    fn get_output() -> [text]:
        """Get output lines."""
        self.output

# ============================================================================
# Export
# ============================================================================
