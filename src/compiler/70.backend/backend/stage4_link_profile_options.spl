# Canonical Stage4 link options that affect the produced image.

fn stage4_link_profile_options_v1(
    debug: bool, pie: bool, bare_metal: bool, opt_level: i64,
    strip_output: bool
) -> text:
    "debug={debug},pie={pie},bare_metal={bare_metal},opt_level={opt_level},strip_output={strip_output},duplicate_definitions=false,cc_fallback=false"

export stage4_link_profile_options_v1
