# Narrow adapters for canonical runtime externs used by source run capture.
use compiler.backend.backend_types.{BackendError, Value}
use std.nogc_sync_mut.sffi.collection_capture.{
    collection_capture_note_size, collection_capture_note_lookup,
    collection_capture_note_materialization, collection_capture_note_hash_probe,
    collection_capture_note_filter, collection_capture_note_loop
}

use std.nogc_sync_mut.sffi.fs.{io_file_open}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.common.hash.xxh3.{xxh3_128_hex}
use std.common.text_bytes.{text_to_utf8_bytes, bytes_to_text}

# Interpreted text has no stable machine address, so `rt_string_data` hands the
# interpreted `rt_io_file_open_*(ptr, len)` twins an opaque handle (base + index)
# into this table; the twin resolves it back to the text and opens it through
# the compiled io_file_open, whose own pointer ABI is real.
var interp_text_handles: [text] = []
val INTERP_TEXT_HANDLE_BASE: i64 = 1048576

fn interp_text_handle(s: text) -> i64:
    var i = 0
    while i < interp_text_handles.len():
        if interp_text_handles[i] == s: return INTERP_TEXT_HANDLE_BASE + i
        i = i + 1
    interp_text_handles.push(s)
    INTERP_TEXT_HANDLE_BASE + interp_text_handles.len() - 1

fn interpreter_io_abi(name: text, args: [Value]) -> Result<Value, BackendError>?:
    if name == "rt_string_data":
        if args.len() != 1: return Some(Err(BackendError.runtime_error("rt_string_data takes one argument", nil)))
        match args[0]:
            case Value.String(s): return Some(Ok(Value.Int(interp_text_handle(s))))
            case _: return nil
    if name == "rt_string_len":
        if args.len() != 1: return Some(Err(BackendError.runtime_error("rt_string_len takes one argument", nil)))
        match args[0]:
            case Value.String(s): return Some(Ok(Value.Int(s.len())))
            case _: return nil
    var mode = -1
    if name == "rt_io_file_open_read": mode = 0
    elif name == "rt_io_file_open_write": mode = 1
    elif name == "rt_io_file_open_append": mode = 3
    else: return nil
    if args.len() != 2:
        return Some(Err(BackendError.runtime_error("{name} takes (path_ptr, path_len)", nil)))
    var ptr: i64 = 0
    var len: i64 = 0
    match args[0]:
        case Value.Int(v): ptr = v
        case _: return Some(Err(BackendError.type_error("{name} path_ptr must be integer", nil)))
    match args[1]:
        case Value.Int(v): len = v
        case _: return Some(Err(BackendError.type_error("{name} path_len must be integer", nil)))
    val index = ptr - INTERP_TEXT_HANDLE_BASE
    if index < 0 or index >= interp_text_handles.len(): return Some(Ok(Value.Int(-1)))
    val path = interp_text_handles[index]
    if len != path.len(): return Some(Ok(Value.Int(-1)))
    Some(Ok(Value.Int(io_file_open(path, mode))))

fn interpreter_bytes_value(s: text) -> Value:
    var out: [Value] = []
    for b in s.bytes(): out.push(Value.Int(b))
    Value.Array(out)

# Interpreted rt_process_run_bounded_bytes(cmd, args, timeout_ms, max_bytes):
# the AOT `_tuple` facade takes cmd split into (ptr, len); the interpreter has
# no such split, so the four declared arguments run the compiled text capture
# and the captured text is returned as the declared ([u8], [u8], i64) tuple.
fn interpreter_process_abi(name: text, args: [Value]) -> Result<Value, BackendError>?:
    if name != "rt_process_run_bounded_bytes": return nil
    if args.len() != 4:
        return Some(Err(BackendError.runtime_error("rt_process_run_bounded_bytes takes (cmd, args, timeout_ms, max_output_bytes)", nil)))
    var cmd = ""
    match args[0]:
        case Value.String(v): cmd = v
        case _: return Some(Err(BackendError.type_error("rt_process_run_bounded_bytes cmd must be text", nil)))
    var argv: [text] = []
    match args[1]:
        case Value.Array(items):
            for item in items:
                match item:
                    case Value.String(v): argv.push(v)
                    case _: return Some(Err(BackendError.type_error("rt_process_run_bounded_bytes args must be [text]", nil)))
        case _: return Some(Err(BackendError.type_error("rt_process_run_bounded_bytes args must be [text]", nil)))
    var timeout_ms: i64 = 0
    var max_bytes: i64 = 0
    match args[2]:
        case Value.Int(v): timeout_ms = v
        case _: return Some(Err(BackendError.type_error("rt_process_run_bounded_bytes timeout_ms must be integer", nil)))
    match args[3]:
        case Value.Int(v): max_bytes = v
        case _: return Some(Err(BackendError.type_error("rt_process_run_bounded_bytes max_output_bytes must be integer", nil)))
    val captured = process_run_bounded(cmd, argv, timeout_ms, max_bytes)
    Some(Ok(Value.Tuple([interpreter_bytes_value(captured.0), interpreter_bytes_value(captured.1), Value.Int(captured.2)])))

fn interpreter_run_abi(name: text, owner: text, external: bool, args: [Value], program_args: [text]) -> Result<Value, BackendError>?:
    if not external: return nil
    # rt_xxh3_128_text has no interpreter binding; without this it returned nil
    # (unregistered_extern_silent_nil class). Back it with the pure-Simple oracle.
    if name == "rt_xxh3_128_text":
        if args.len() != 1: return Some(Err(BackendError.runtime_error("rt_xxh3_128_text takes one argument", None)))
        match args[0]:
            case Value.String(s): return Some(Ok(Value.String(xxh3_128_hex(text_to_utf8_bytes(s)))))
            case _: return Some(Err(BackendError.type_error("rt_xxh3_128_text argument must be text", None)))
    # Same class: the text<->[u8] boundary (std.common.text_bytes). [u8] is an
    # array of Int values in the interpreter.
    if name == "rt_text_to_bytes":
        if args.len() != 1: return Some(Err(BackendError.runtime_error("rt_text_to_bytes takes one argument", None)))
        match args[0]:
            case Value.String(s): return Some(Ok(interpreter_bytes_value(s)))
            case _: return Some(Err(BackendError.type_error("rt_text_to_bytes argument must be text", None)))
    if name == "rt_bytes_to_text":
        if args.len() != 1: return Some(Err(BackendError.runtime_error("rt_bytes_to_text takes one argument", None)))
        match args[0]:
            case Value.Array(items):
                var raw: [u8] = []
                for item in items:
                    match item:
                        case Value.Int(b): raw.push(b as u8)
                        case _: return Some(Err(BackendError.type_error("rt_bytes_to_text argument must be [u8]", None)))
                return Some(Ok(Value.String(bytes_to_text(raw))))
            case _: return Some(Err(BackendError.type_error("rt_bytes_to_text argument must be [u8]", None)))
    val module_name = if owner.starts_with("std."): "lib." + owner.substring(4) else: owner
    if name == "rt_process_run_bounded_bytes" or name == "rt_io_file_open_read" or name == "rt_io_file_open_write" or name == "rt_io_file_open_append":
        if val r = interpreter_process_abi(name, args): return Some(r)
        return interpreter_io_abi(name, args)
    if name == "rt_string_data" or name == "rt_string_len":
        if module_name == "lib.nogc_sync_mut.sffi.fs": return interpreter_io_abi(name, args)
    if name == "rt_get_args" and (module_name == "lib.nogc_sync_mut.sffi.system" or module_name == "lib.nogc_sync_mut.sffi.host" or module_name == "lib.nogc_sync_mut.src.config"):
        if args.len() != 0:
            return Some(Err(BackendError.runtime_error("rt_get_args takes no arguments", nil)))
        var values: [Value] = []
        for arg in program_args: values.push(Value.String(arg))
        return Some(Ok(Value.Array(values)))
    if module_name != "lib.nogc_sync_mut.sffi.collection_capture": return nil
    var expected = 0
    if name == "spl_collection_capture_note_materialization": expected = 2
    elif name == "spl_collection_capture_note_size" or name == "spl_collection_capture_note_lookup": expected = 3
    elif name == "spl_collection_capture_note_hash_probe": expected = 4
    elif name == "spl_collection_capture_note_filter": expected = 4
    elif name == "spl_collection_capture_note_loop": expected = 3
    else: return nil
    if args.len() != expected:
        return Some(Err(BackendError.runtime_error("invalid collection capture ABI arity", nil)))
    var site = ""
    var target = ""
    match args[0]:
        case Value.String(value): site = value
        case _: return Some(Err(BackendError.type_error("collection capture site must be text", nil)))
    match args[1]:
        case Value.String(value): target = value
        case _: return Some(Err(BackendError.type_error("collection capture target must be text", nil)))
    var first: i64 = 0
    var second: i64 = 0
    if expected >= 3:
        match args[2]:
            case Value.Int(value): first = value
            case _: return Some(Err(BackendError.type_error("collection capture count must be integer", nil)))
    if expected == 4:
        match args[3]:
            case Value.Int(value): second = value
            case _: return Some(Err(BackendError.type_error("collection capture second count must be integer", nil)))
    if name == "spl_collection_capture_note_lookup" and first != 0 and first != 1:
        return Some(Err(BackendError.runtime_error("collection capture hit must be zero or one", nil)))
    val accepted = if expected == 2:
        collection_capture_note_materialization(site, target)
    elif expected == 4:
        if name == "spl_collection_capture_note_filter":
            collection_capture_note_filter(site, target, first, second)
        else:
            collection_capture_note_hash_probe(site, target, first, second)
    elif name == "spl_collection_capture_note_size":
        collection_capture_note_size(site, target, first)
    elif name == "spl_collection_capture_note_loop":
        collection_capture_note_loop(site, target, first)
    else:
        collection_capture_note_lookup(site, target, first == 1)
    Some(Ok(Value.Int(if accepted: 1 else: 0)))

export interpreter_run_abi
