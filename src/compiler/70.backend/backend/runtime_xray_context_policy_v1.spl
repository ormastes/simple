# Optional resident main-image thread hooks. This is runtime object policy,
# not public observer capability admission.
pub fn runtime_xray_context_validate_v1(enabled: bool, target: text, host: text,
        owner: text, core_c: bool, stage4: bool) -> Result<bool, text>:
    if not enabled: return Ok(false)
    if host != "linux" or owner != "c" or not core_c or stage4:
        return Err("XRAY-E-CONTEXT-RUNTIME: thread hooks require source-built Linux core-C runtime")
    if target != "aarch64-unknown-linux-gnu" and target != "x86_64-unknown-linux-gnu":
        return Err("XRAY-E-CONTEXT-TARGET: thread hooks require an exact Linux GNU target")
    Ok(true)

pub fn runtime_xray_context_cache_suffix_v1(enabled: bool) -> text:
    if enabled: ";xray_thread_context_v1=1;startup-owned-spawn-v1=1" else: ""

pub fn runtime_xray_context_flags_v1(enabled: bool, source: text) -> [text]:
    if enabled and (source == "runtime_thread" or source == "runtime_native" or source == "runtime_simd_dispatch"):
        return ["-DSIMPLE_XRAY_CONTEXT_HOOKS_V1=1"]
    []

# The admitted runtime_core_c_sources_v1 list excludes runtime_pool.c. Its
# separate thread pool is not covered or admitted by this source policy.
