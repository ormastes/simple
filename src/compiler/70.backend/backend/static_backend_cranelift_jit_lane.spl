# Cranelift JIT lane: the only kernel-facing owner of CodegenPipeline.
#
# Imported solely by a composition root that links Cranelift
# (src/compositions/kernel_llvm_cranelift). The kernel reaches these bodies
# through the StaticJitLaneV1 slot (static_jit_lane.spl) and never names
# compiler.backend.codegen or std.sffi.codegen itself, so a composition that
# omits this module (kernel_llvm, the core-c-bootstrap lane) links with no
# rt_cranelift_* / spl_cranelift_* reference at all.

use compiler.backend.static_jit_lane.{StaticJitLaneV1}
use compiler.backend.codegen.{CodegenPipeline}
use compiler.backend.cranelift_codegen_adapter.{cranelift_jit_run_main}
use compiler.backend.jit_extern_resolution.{jit_module_extern_errors}
use compiler.backend.compiler.{CompilerBackendImpl}
use compiler.mir.mir_instructions.{MirModule}
use compiler.hir.hir_types.{HirModule}
use compiler.backend.backend_types.{BackendResult, BackendError}
use compiler.common.driver_core_types.{CompileResult}

fn _cranelift_jit_run(modules: [MirModule]) -> CompileResult:
    if modules.len() == 0:
        return CompileResult.RuntimeError("No modules compiled")

    # Each module is its own JIT module and `main` of the last one is the
    # entry. Refuse the whole run when any module names a callee that cannot be
    # bound before codegen (undefined Source, unknown origin, imported static).
    # Runtime and Foreign imports are admitted by the provider at declaration,
    # which happens only for the entry module: earlier modules are not compiled.
    for module in modules:
        val refusals = jit_module_extern_errors(module)
        if refusals.len() > 0:
            return CompileResult.CodegenError(
                "JIT compile error in {module.name}: {refusals.join("; ")}")

    val entry_module = modules[modules.len() - 1]
    match cranelift_jit_run_main(entry_module):
        case Ok(result):
            # Success carries `text?`; the JIT entry returns i64.
            val result_text: text = "{result}"
            CompileResult.Success(result_text)
        case Err(message):
            CompileResult.CodegenError("JIT compile error in {entry_module.name}: {message}")

fn _cranelift_execute_smf(smf_path: text) -> CompileResult:
    var pipeline = CodegenPipeline.jit()
    match pipeline.load_smf_and_execute(smf_path):
        case Ok(result):
            # Success carries `text?`; SMF execution returns i64.
            val result_text: text = "{result}"
            CompileResult.Success(result_text)
        case Err(e):
            CompileResult.RuntimeError("SMF execution failed: {e}")

fn _cranelift_hir_jit(module: HirModule) -> Result<BackendResult, BackendError>:
    CompilerBackendImpl.jit().process_module(module)

fn _cranelift_hir_aot(module: HirModule, output: text) -> Result<BackendResult, BackendError>:
    CompilerBackendImpl.aot(output).process_module(module)

pub fn cranelift_jit_lane_v1() -> StaticJitLaneV1:
    StaticJitLaneV1("cranelift", _cranelift_jit_run, _cranelift_execute_smf,
        _cranelift_hir_jit, _cranelift_hir_aot)
