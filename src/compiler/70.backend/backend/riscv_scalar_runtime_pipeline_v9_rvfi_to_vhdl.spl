# RVFI projection for the canonical V9 IM+Zicsr+Zifencei scalar pipeline.
#
# The wrapper is intentionally a retirement observer: it admits only the two
# sealed V9 product profiles and leaves interrupt delivery out of scope.  It
# captures decode-time operand evidence on the pipeline's accepted input, then
# projects the committed completion record as one RVFI retirement event.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, hwir_hash_fields}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v9_flat}

fn pipeline_v9_rvfi_route() -> text: "hwir-gen2-scalar-runtime-pipeline-v9-rvfi-v1"
fn pipeline_v9_rvfi_profile_supported(config: CoreConfig) -> bool:
    config.profile == "rv32im_zicsr_zifencei" or config.profile == "rv64im_zicsr_zifencei"
fn pipeline_v9_rvfi_xlen(config: CoreConfig) -> text:
    if config.xlen == 32: return "01"
    "10"
fn pipeline_v9_rvfi_rejected(diagnostic: text) -> HwirStrictVhdlResult:
    HwirStrictVhdlResult.rejected(diagnostic)

pub fn scalar_runtime_pipeline_v9_rvfi_contract_sha256(base: HwirStrictVhdlResult) -> text:
    sha256_text(hwir_hash_fields([
        "simple-riscv-rvfi-projection/v2",
        "scope=rv32im_zicsr_zifencei|rv64im_zicsr_zifencei;interrupts=excluded",
        "accept=in_valid_and_internal_ready;metadata=single_inflight_until_retirement",
        "valid=completion_valid;order=sequential_retirement_counter",
        "trap=completion_execute_trap_valid_or_completion_memory_trap_valid",
        "intr=constant_zero;rd=completion_rd_and_completion_rd_value",
        "hwir=" + base.hwir_graph_sha256,
        "xlen=" + base.config_xlen.to_text(), "profile=" + base.config_profile]))

fn pipeline_v9_rvfi_wrapper(entity: text, pipeline_entity: text, config: CoreConfig,
    contract: text) -> text:
    val x = config.xlen.to_text(); val xlen = pipeline_v9_rvfi_xlen(config)
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\n" +
    "-- simple-rvfi contract=" + contract + " scope=V9-IM-Zicsr-Zifencei; interrupts=excluded\n" +
    "entity " + entity + " is port(\n" +
    "  clk : in std_logic; rst : in std_logic; in_valid : in std_logic; rvfi_input_ready : out std_logic; instruction : in std_logic_vector(31 downto 0);\n" +
    "  instruction_length_bytes : in std_logic_vector(2 downto 0); rs1_value : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rs2_value : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  pc_before : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); fallthrough_pc : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); privilege : in std_logic_vector(1 downto 0);\n" +
    "  provider_event_id : in std_logic_vector(63 downto 0); decode_event_id : in std_logic_vector(63 downto 0);\n" +
    "  bus_request_ready : in std_logic; bus_response_valid : in std_logic; bus_response_id : in std_logic_vector(63 downto 0); bus_response_data : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  bus_response_fault : in std_logic; bus_response_cause : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); bus_response_tval : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); fence_effect_ready : in std_logic;\n" +
    "  csr_present : in std_logic; csr_read_value : in std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  rvfi_valid : out std_logic; rvfi_order : out std_logic_vector(63 downto 0); rvfi_insn : out std_logic_vector(31 downto 0); rvfi_trap : out std_logic; rvfi_halt : out std_logic; rvfi_intr : out std_logic;\n" +
    "  rvfi_mode : out std_logic_vector(1 downto 0); rvfi_ixl : out std_logic_vector(1 downto 0); rvfi_rs1_addr : out std_logic_vector(4 downto 0); rvfi_rs2_addr : out std_logic_vector(4 downto 0);\n" +
    "  rvfi_rs1_rdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rvfi_rs2_rdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rvfi_rd_addr : out std_logic_vector(4 downto 0); rvfi_rd_wdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  rvfi_pc_rdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rvfi_pc_wdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rvfi_mem_addr : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  rvfi_mem_rmask : out std_logic_vector(31 downto 0); rvfi_mem_wmask : out std_logic_vector(31 downto 0); rvfi_mem_rdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); rvfi_mem_wdata : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  v9_runtime_protocol_fault : out std_logic; v9_csr_commit_valid : out std_logic; v9_csr_commit_address : out std_logic_vector(11 downto 0); v9_csr_commit_value : out std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0); v9_fence_effect_valid : out std_logic\n" +
    "); end entity;\narchitecture rtl of " + entity + " is\n" +
    "  signal in_ready_i, pipeline_in_valid_i, completion_valid_i, metadata_inflight_reg : std_logic := '0'; signal completion_privilege_i : std_logic_vector(1 downto 0); signal completion_insn_i : std_logic_vector(31 downto 0);\n" +
    "  signal completion_pc_before_i, completion_pc_after_i, completion_rd_value_i, completion_mem_addr_i, completion_mem_rdata_i, completion_mem_wdata_i : std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  signal completion_rd_i : std_logic_vector(4 downto 0); signal completion_mem_rmask_i, completion_mem_wmask_i : std_logic_vector(31 downto 0); signal completion_execute_trap_i, completion_memory_trap_i, runtime_protocol_fault_i, csr_commit_valid_i, fence_effect_valid_i : std_logic; signal csr_commit_address_i : std_logic_vector(11 downto 0); signal csr_commit_value_i : std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0);\n" +
    "  signal rs1_reg, rs2_reg : std_logic_vector(" + (config.xlen - 1).to_text() + " downto 0) := (others=>'0'); signal rs1_addr_reg, rs2_addr_reg : std_logic_vector(4 downto 0) := (others=>'0'); signal rvfi_order_reg : unsigned(63 downto 0) := (others=>'0');\n" +
    "begin\n" +
    "  rvfi_input_ready <= in_ready_i and not metadata_inflight_reg; pipeline_in_valid_i <= in_valid and in_ready_i and not metadata_inflight_reg;\n" +
    "  pipeline: entity work." + pipeline_entity + " port map(clk=>clk,rst=>rst,in_valid=>pipeline_in_valid_i,instruction=>instruction,instruction_length_bytes=>instruction_length_bytes,rs1_value=>rs1_value,rs2_value=>rs2_value,pc_before=>pc_before,fallthrough_pc=>fallthrough_pc,privilege=>privilege,provider_event_id=>provider_event_id,decode_event_id=>decode_event_id,completion_ready=>'1',bus_request_ready=>bus_request_ready,bus_response_valid=>bus_response_valid,bus_response_id=>bus_response_id,bus_response_data=>bus_response_data,bus_response_fault=>bus_response_fault,bus_response_cause=>bus_response_cause,bus_response_tval=>bus_response_tval,fence_effect_ready=>fence_effect_ready,csr_present=>csr_present,csr_read_value=>csr_read_value,in_ready=>in_ready_i,completion_valid=>completion_valid_i,completion_privilege=>completion_privilege_i,completion_original_instruction=>completion_insn_i,completion_canonical_instruction=>open,completion_instruction_length_bytes=>open,completion_pc_before=>completion_pc_before_i,completion_pc_after=>completion_pc_after_i,completion_rd=>completion_rd_i,completion_rd_write=>open,completion_rd_value=>completion_rd_value_i,completion_memory_address=>completion_mem_addr_i,completion_memory_read_mask=>completion_mem_rmask_i,completion_memory_write_mask=>completion_mem_wmask_i,completion_memory_read_data=>completion_mem_rdata_i,completion_memory_write_data=>completion_mem_wdata_i,completion_execute_trap_valid=>completion_execute_trap_i,completion_execute_trap_cause=>open,completion_execute_trap_tval=>open,completion_memory_trap_valid=>completion_memory_trap_i,completion_memory_trap_cause=>open,completion_memory_trap_tval=>open,completion_redirect_valid=>open,completion_redirect_target=>open,completion_provider_event_id=>open,completion_decode_event_id=>open,completion_illegal_valid=>open,runtime_protocol_fault=>runtime_protocol_fault_i,bus_request_valid=>open,bus_request_id=>open,bus_request_address=>open,bus_request_write=>open,bus_request_byte_mask=>open,bus_request_write_data=>open,bus_response_ready=>open,fence_effect_valid=>fence_effect_valid_i,fence_effect_kind=>open,fence_effect_fm=>open,fence_effect_pred=>open,fence_effect_succ=>open,csr_lookup_valid=>open,csr_lookup_read_enable=>open,csr_lookup_address=>open,csr_commit_valid=>csr_commit_valid_i,csr_commit_address=>csr_commit_address_i,csr_commit_value=>csr_commit_value_i);\n" +
    "  rvfi_valid <= completion_valid_i; rvfi_order <= std_logic_vector(rvfi_order_reg); rvfi_insn <= completion_insn_i; rvfi_trap <= completion_execute_trap_i or completion_memory_trap_i; rvfi_halt <= '0'; rvfi_intr <= '0'; rvfi_mode <= completion_privilege_i; rvfi_ixl <= \"" + xlen + "\"; v9_runtime_protocol_fault <= runtime_protocol_fault_i; v9_csr_commit_valid <= csr_commit_valid_i; v9_csr_commit_address <= csr_commit_address_i; v9_csr_commit_value <= csr_commit_value_i; v9_fence_effect_valid <= fence_effect_valid_i;\n" +
    "  rvfi_rs1_addr <= rs1_addr_reg; rvfi_rs2_addr <= rs2_addr_reg; rvfi_rs1_rdata <= rs1_reg; rvfi_rs2_rdata <= rs2_reg; rvfi_rd_addr <= completion_rd_i; rvfi_rd_wdata <= completion_rd_value_i; rvfi_pc_rdata <= completion_pc_before_i; rvfi_pc_wdata <= completion_pc_after_i; rvfi_mem_addr <= completion_mem_addr_i; rvfi_mem_rmask <= completion_mem_rmask_i; rvfi_mem_wmask <= completion_mem_wmask_i; rvfi_mem_rdata <= completion_mem_rdata_i; rvfi_mem_wdata <= completion_mem_wdata_i;\n" +
    "  process(clk) begin if rising_edge(clk) then if rst='1' then rs1_reg <= (others=>'0'); rs2_reg <= (others=>'0'); rs1_addr_reg <= (others=>'0'); rs2_addr_reg <= (others=>'0'); rvfi_order_reg <= (others=>'0'); metadata_inflight_reg <= '0'; else if completion_valid_i='1' then metadata_inflight_reg <= '0'; rvfi_order_reg <= rvfi_order_reg + 1; else if pipeline_in_valid_i='1' and in_ready_i='1' then metadata_inflight_reg <= '1'; rs1_addr_reg <= instruction(19 downto 15); rs2_addr_reg <= instruction(24 downto 20); if instruction(19 downto 15)=\"00000\" then rs1_reg <= (others=>'0'); else rs1_reg <= rs1_value; end if; if instruction(24 downto 20)=\"00000\" then rs2_reg <= (others=>'0'); else rs2_reg <= rs2_value; end if; end if; end if; end if; end process;\nend architecture rtl;\n"

pub fn compile_strict_riscv_scalar_runtime_pipeline_v9_rvfi(module_name: text, config: CoreConfig, bus: LsuConfig) -> HwirStrictVhdlResult:
    if not pipeline_v9_rvfi_profile_supported(config): return pipeline_v9_rvfi_rejected("HWIR-E-RISCV-RUNTIME-PIPELINE-V9-RVFI-SCOPE: RVFI wrapper admits exact rv32im_zicsr_zifencei or rv64im_zicsr_zifencei profiles")
    val base = compile_strict_riscv_scalar_runtime_pipeline_v9_flat(module_name, config, bus)
    if not base.is_success(): return base
    val contract = scalar_runtime_pipeline_v9_rvfi_contract_sha256(base)
    val vhdl = base.vhdl + "\n" + pipeline_v9_rvfi_wrapper(module_name + "_rvfi", module_name, config, contract)
    HwirStrictVhdlResult(success: true, vhdl: vhdl, diagnostic: "", route: pipeline_v9_rvfi_route(), module_node_id: base.module_node_id, config_xlen: base.config_xlen, config_profile: base.config_profile, hwir_graph_sha256: base.hwir_graph_sha256)
