# Environment and Scoping Utilities
#
# Shared environment operations for backend implementations.
# This module provides variable scoping and environment management
# used by the interpreter and other backends.

use compiler.hir.hir.*
use compiler.backend.backend_types.*
use compiler.backend.backend.objects.*


# ============================================================================
# Environment and Scoping
# ============================================================================

type SymbolNameMap = {i64: text}

struct ResolvedCallable:
    """A callable together with the module state needed to execute it."""
    function: HirFunction
    owner: HirModule
    names: SymbolNameMap

fn callable_identity_module_key(module_name: text, symbol_id: SymbolId) -> text:
    "{module_name}#{symbol_id.id}"

fn function_callable_identity(module: HirModule, fn_: HirFunction) -> text:
    """Derive a stable identity from the declaration symbol when available."""
    var owner_name = module.name
    var declared_name = fn_.name
    for symbol_ in module.symbols.symbols.values():
        val symbol: Symbol = symbol_
        if symbol.id.id == fn_.symbol.id:
            if val defining_module = symbol.defining_module:
                owner_name = defining_module
            declared_name = symbol.name
            break
    canonical_callable_name(owner_name, declared_name)

fn callable_identities_for_module(module: HirModule) -> Dict<i64, text>:
    """Build module-local SymbolId -> canonical callable identity once."""
    var result: Dict<i64, text> = {}
    for symbol_ in module.symbols.symbols.values():
        val symbol: Symbol = symbol_
        val owner_name = symbol.defining_module ?? module.name
        result[symbol.id.id] = canonical_callable_name(owner_name, symbol.name)
    result

fn symbol_names_for_module(module: HirModule) -> SymbolNameMap:
    """Build the SymbolId-to-name map for exactly one HIR module.

    SymbolId values are allocated per module.  A registry-wide map therefore
    lets an imported module overwrite an entry-module binding with the same
    numeric id.  Keep ownership explicit by constructing this map from the
    module whose function is currently executing.
    """
    var result: SymbolNameMap = {}
    for symbol_ in module.symbols.symbols.values():
        val symbol: Symbol = symbol_
        result[symbol.id.id] = symbol.name
    result

struct EvalContext:
    """Context for expression evaluation."""
    env: Environment
    module: HirModule
    backend: Backend
    # id -> name map built once from module.symbols (bug doc iteration 21,
    # target (a)). The environment is keyed by variable NAME because the
    # seed's `Dict<text,SymbolId>.get` in SymbolTable.lookup returns a
    # shared/corrupt SymbolId handle on stage4 (iteration 19): a `Var`/
    # `NamedVar`'s `symbol.id` is unreadable, but its `name` (raw text) is
    # reliable and a `Let`'s define-fresh `symbol.id` IS readable — so this
    # map resolves a define-side SymbolId to the stable name key.
    names: SymbolNameMap
    # name -> HirFunction index built ONCE from module.functions (perf).
    # The interpreter's Call fast-path and call_function previously did a
    # linear, no-early-break scan over module.functions.values() on EVERY
    # named call. For a self-host native-build the module holds ~5.8k
    # functions, making each of the millions of interpreted calls O(#fns) —
    # an O(calls * fns) blowup that dominated the ~39min interpreted worker.
    # This dict makes the resolve O(1). Last-writer-wins on duplicate names,
    # which reproduces the old no-break loop's semantics exactly. Only the
    # real interpreter entry (process_module) populates it; other EvalContext
    # constructors leave it empty and the callers fall back to the scan.
    fn_by_name: Dict<text, HirFunction>
    # Function name -> owning HIR module for registered multi-module programs.
    # Imported function bodies must execute with their own module metadata
    # (types, AOP declarations, and symbol table), not the entry module's.
    module_by_function: Dict<text, HirModule>
    # Compatibility spelling (`module.member`) -> canonical identity. Built
    # once with collision tracking; never select by Dict iteration order.
    dotted_fn_alias: Dict<text, text>
    ambiguous_dotted_fn_alias: Dict<text, bool>
    # Names present in more than one registered module.  Such names must not
    # fall through to either indexed or synthetic-global last-writer dispatch.
    ambiguous_fn_names: Dict<text, bool>
    # True only when fn_by_name has been populated (process_module). Other
    # EvalContext constructors omit it (defaults false) so their callers take
    # the linear-scan fallback. A boolean flag is used instead of a
    # `fn_by_name`-emptiness test because `Dict.len()` is unreliable in the
    # interpreter (returns -1).
    has_fn_index: bool
    has_module_index: bool
    # M5 pure-Simple parity for the Rust seed's SIMPLE_STRICT_MEM (see
    # src/compiler_rust/compiler/src/value.rs strict_mem_enabled()). Read ONCE
    # via rt_env_get at process_module() entry and cached here (mirrors
    # MirInterpreter.strict_mode's "read once at creation" idiom,
    # 95.interp/mir_interpreter.spl) -- every check thereafter is a single
    # cached-bool field read, no per-check env lookup. Default false (omitted
    # field) for every EvalContext constructor that does not opt in, so
    # non-strict behavior is byte-for-byte unchanged.
    strict_mem: bool

struct Environment:
    """Variable environment for evaluation.

    Keyed by variable NAME (text). Struct-keyed `Dict<SymbolId, Value>` failed
    on stage4 (shared/corrupt looked-up SymbolId handles compare unequal /
    nil-deref their `.id`, bug doc iterations 19/21). Text-keyed dicts are
    proven-good on stage4.

    """
    scopes: [Dict<text, Value>]
    globals: Dict<text, Value>
    # Task #112: shared registry backing CLASS instances (reference semantics).
    # A Value.Object holds a handle into this store; all EvalContext copies that
    # share this (reference-typed) Environment share this one store.
    store: ObjectStore
    # M5 strict-mem (SIMPLE_STRICT_MEM) parity: names currently marked
    # "bound but not really initialized". Only ever populated when
    # EvalContext.strict_mem is true (see mark_uninit/is_uninit/clear_uninit
    # below); on the default-off path this dict stays empty and every lookup
    # against it is skipped entirely by the `ctx.strict_mem` guard at the call
    # site, so off-mode behavior and cost are unchanged. Mirrors the Rust
    # seed's `CowEnv.uninit_names` (value.rs).
    uninit: Dict<text, bool>

fn empty_env_scope() -> Dict<text, Value>:
    """Create an empty scope dict (typed for bootstrap inference)."""
    var result: Dict<text, Value> = {}
    result

impl Environment:
    static fn new() -> Environment:
        Environment(scopes: [empty_env_scope()], globals: empty_env_scope(), store: ObjectStore.new(), uninit: {})

    # ---- Strict-mem (SIMPLE_STRICT_MEM) uninitialized-binding tracking ----
    # Only meaningful/called when the caller has already checked
    # `ctx.strict_mem` (see interpreter.spl); kept as plain unconditional
    # dict ops here so the gate lives in exactly one place per call site.

    me mark_uninit(name: text):
        """Mark `name` as bound-but-not-yet-really-initialized. A subsequent
        strict-mode read of `name` (before any real write) traps instead of
        silently returning the placeholder value the env-gated `Let` stored."""
        self.uninit[name] = true

    fn is_uninit(name: text) -> bool:
        """True if `name` was `mark_uninit`-ed and has not since been
        `clear_uninit`-ed by a first real write."""
        if self.uninit.has(name):
            self.uninit[name]
        else:
            false

    me clear_uninit(name: text):
        """First real assignment to a strict-mem uninit name clears its trap
        (mirrors CowEnv's insert/assign clearing `uninit_names`, value.rs)."""
        if self.uninit.has(name):
            self.uninit[name] = false

    me push_scope():
        self.scopes = self.scopes.push(empty_env_scope())

    me pop_scope():
        if self.scopes.len() > 1:
            self.scopes.pop()

    me define(name: text, value: Value):
        val last_idx = self.scopes.len() - 1
        self.scopes[last_idx][name] = value

    me assign(name: text, value: Value) -> bool:
        # Search from innermost scope
        for i in (self.scopes.len() - 1)..=0:
            if self.scopes[i].has(name):
                self.scopes[i][name] = value
                return true

        # Check globals
        if self.globals.has(name):
            self.globals[name] = value
            return true

        false

    fn lookup(name: text) -> Value?:
        # Search from innermost scope. `scope[name]` indexes a Value out of a
        # Dict<text, Value> that is itself an ANY-erased array element
        # (self.scopes[i]); on stage4 the seed erases both the array element and
        # the dict value type to ANY, so the retrieved struct Value must be bound
        # to a TYPED local before use or its fields resolve at the wrong offset
        # (most-fields-wins) and a later `match` on it faults (bug doc iter 9/18).
        for i in (self.scopes.len() - 1)..=0:
            val scope: Dict<text, Value> = self.scopes[i]
            if scope.has(name):
                val v: Value = scope[name]
                return Some(v)

        # Check globals
        if self.globals.has(name):
            val gv: Value = self.globals[name]
            return Some(gv)
        nil

    fn snapshot_locals() -> Dict<text, Value>:
        """Copy visible locals for a by-value closure capture."""
        var captured: Dict<text, Value> = {}
        for scope in self.scopes:
            val scope_t: Dict<text, Value> = scope
            for name in scope_t.keys():
                captured[name] = scope_t[name]
        captured

    me define_global(name: text, value: Value):
        self.globals[name] = value

# ============================================================================
# HIR Visitor
# ============================================================================

struct HirVisitor:
    """Visitor that walks HIR and calls backend methods."""
    backend: Backend
    ctx: EvalContext

impl HirVisitor:
    static fn new(backend: Backend, module: HirModule) -> HirVisitor:
        HirVisitor(
            backend: backend,
            ctx: EvalContext(
                env: Environment.new(),
                module: module,
                backend: backend,
                names: {}
            )
        )

    me visit_module() -> Result<BackendResult, BackendError>:
        """Visit entire module."""
        self.backend.process_module(self.ctx.module)

    me visit_function(fn_: HirFunction) -> Result<BackendResult, BackendError>:
        """Visit function definition."""
        self.backend.process_function(fn_)

    me visit_expr(expr: HirExpr) -> Result<Value, BackendError>:
        """Visit expression."""
        # Check if allowed
        if not self.backend.is_allowed(expr):
            return Err(BackendError.not_allowed(
                "expression not allowed in {self.backend.name()} mode",
                Some(expr.span)
            ))

        self.backend.eval_expr(expr, self.ctx)

    me visit_stmt(stmt: HirStmt) -> Result<(), BackendError>:
        """Visit statement."""
        if not self.backend.is_allowed_stmt(stmt):
            return Err(BackendError.not_allowed(
                "statement not allowed in {self.backend.name()} mode",
                Some(stmt.span)
            ))

        self.backend.exec_stmt(stmt, self.ctx)

    me visit_block(block: HirBlock) -> Result<Value, BackendError>:
        """Visit block."""
        self.ctx.env.push_scope()

        for stmt in block.stmts:
            self.visit_stmt(stmt)?

        val result = if block.value.?:
            self.visit_expr(block.value.unwrap())?
        else:
            Value.make_nil()

        self.ctx.env.pop_scope()
        Ok(result)

# ============================================================================
# Exports
# ============================================================================
