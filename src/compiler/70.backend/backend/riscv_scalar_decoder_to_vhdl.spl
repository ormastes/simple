# Compiler-owned fixed-XLEN scalar decoder product emission.

use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_decoder.{strict_riscv_scalar_decoder_hwir}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult,
    render_strict_hwir_vhdl}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan}

fn scalar_decoder_rejected(diagnostic: text) -> HwirStrictVhdlResult:
    HwirStrictVhdlResult(success: false, vhdl: "", diagnostic: diagnostic,
        route: "hwir-gen2-scalar-decoder-v1", module_node_id: "",
        config_xlen: 0, config_profile: "", hwir_graph_sha256: "")

pub fn compile_strict_riscv_scalar_decoder_product(module_name: text,
    config: CoreConfig) -> HwirStrictVhdlResult:
    val plan = riscv_scalar_decoder_plan(config.isa_profile)
    if plan.is_err(): return scalar_decoder_rejected(plan.err().unwrap())
    val module = strict_riscv_scalar_decoder_hwir(
        module_name, config, plan.ok().unwrap())
    if module.is_err(): return scalar_decoder_rejected(module.err().unwrap())
    val typed = module.ok().unwrap()
    val rendered = render_strict_hwir_vhdl(typed)
    if not rendered.is_success(): return scalar_decoder_rejected(rendered.diagnostic)
    HwirStrictVhdlResult.emitted(typed,
        rendered.vhdl.replace("route=hwir-strict",
            "route=hwir-gen2-scalar-decoder-v1"),
        "hwir-gen2-scalar-decoder-v1")
