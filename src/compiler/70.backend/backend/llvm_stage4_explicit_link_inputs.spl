# Stage4 link inputs are sealed before candidate archive projection.

fn llvm_stage4_explicit_link_inputs_reason(
    libraries: [text], library_paths: [text], linker_flags: [text]
) -> text:
    # Caller inputs would enter after the exact archive closure is profiled.
    if libraries.len() > 0:
        return "Stage4 strict profile rejects explicit libraries outside its verified runtime closure"
    if library_paths.len() > 0:
        return "Stage4 strict profile rejects explicit library paths outside its verified runtime closure"
    if linker_flags.len() > 0:
        return "Stage4 strict profile rejects explicit linker flags outside its verified runtime closure"
    ""

export llvm_stage4_explicit_link_inputs_reason
