use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock, MirInst}
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.common.module_path_naming.{module_logical_name_from_path}
use compiler.mir.mir_lowering.{bootstrap_mir_function_count, bootstrap_mir_function_at, bootstrap_mir_function_name_at,
    bootstrap_mir_function_module_at, bootstrap_mir_function_return_type_tag_at,
    bootstrap_mir_function_return_unsigned_at, bootstrap_mir_function_param_count_at,
    bootstrap_mir_function_param_type_tag_at,
    bootstrap_mir_static_count, bootstrap_mir_static_module_at, bootstrap_mir_static_symbol_id_at,
    bootstrap_mir_static_name_at, bootstrap_mir_static_type_tag_at,
    bootstrap_mir_static_init_kind_at, bootstrap_mir_static_init_payload_at}
use compiler.mir_opt.{ssa_var_transform_blocks, ssa_alloca_transform_blocks}
use compiler.backend.backend_api.*
use compiler.backend.backend.llvm_target.{LlvmTargetTriple, LlvmTargetConfig}
use compiler.backend.llvm_type_mapper.LlvmTypeMapper
use compiler.backend.llvm_ir_builder.{LlvmIRBuilder, natural_alignment, is_integer_type, is_signed_int_type, is_float_type,
    llvm_ir_builder_build}
use compiler.backend.common.mir_text_codegen.MirTextCodegen
use compiler.mir.mir_call_ownership.{mir_runtime_owned_call_name}
use compiler.mir.mir_coverage_probe_admission.{
    mir_coverage_probe_admission_diagnostic_module_v1
}
use compiler.mir.mir_types.{LocalId}  # explicit: a glob is not an import-origin for surface projection

extern fn rt_string_builder_len(handle: i64) -> i64
extern fn rt_string_builder_push(handle: i64, value: text)

# DS3 debug-info path split: NOT std.nogc_sync_mut.path.{basename, dirname} --
# empirically, that dirname()'s rfind()-based fast path throws ("match
# expression exhausted ... for i64 value -1") under this engine when the
# path has no "/": rfind() returns a raw sentinel i64 here instead of the
# Option<i64> its own `match ... case Some(idx) / nil` expects. Split
# manually with .split("/") instead (the same pattern compile_opt_and_driver.spl
# already uses safely for source_file).
fn debug_info_split_path(path: text) -> (text, text):
    if not path.contains("/"):
        return (path, ".")
    val parts = path.split("/")
    val filename = parts[parts.len() - 1]
    var directory = ""
    var i = 0
    while i < parts.len() - 1:
        if i > 0:
            directory = directory + "/"
        directory = directory + parts[i]
        i = i + 1
    if directory == "":
        directory = "/"
    (filename, directory)

extern fn rt_env_get(key: text) -> text
extern fn rt_enum_discriminant(value: Any) -> i64
extern fn rt_enum_payload(value: Any) -> i64
extern fn rt_tuple_get(tuple: i64, index: i64) -> i64
extern fn rt_value_as_int(value: i64) -> i64
extern fn rt_string_len(value: text) -> i64

fn llvm_bootstrap_ssa_function(fn_: MirFunction) -> MirFunction:
    # A single-block function is NOT skippable: a straight-line reassignment
    # (e.g. a fixed-width `c = c + 1` twice, #171) lowers to multiple defs of
    # one local inside ONE block, which the textual `%lN` emitter would emit as
    # a duplicate SSA def -> llc "multiple definition of local value". The
    # alloca transform below slots such single-block multi-def locals (its own
    # `slotted.len() == 0` check keeps a single-def single-block function a
    # byte-for-byte no-op), so only a truly empty function is skipped here.
    if fn_.blocks.len() == 0:
        return fn_
    # SIMPLE_BOOTSTRAP-only: replace the hand-built SSA-phi mechanism (which
    # cannot correctly resolve each phi's incoming-value-per-predecessor for
    # real control flow -- short-circuit `and`, nested if-EXPRESSIONS) with
    # an alloca-per-reassigned-local transform. An entry-block alloca
    # dominates every use by construction, so this cannot produce the
    # `undef` phi operands the join-predecessor phi materialization could.
    # Gated on the same SIMPLE_BOOTSTRAP condition the rest of this LLVM
    # text-codegen path uses -- the normal (non-bootstrap) build never sets
    # this env var, so it is byte-for-byte unchanged.
    # Replace the hand-built SSA-phi mechanism (which cannot correctly resolve
    # each phi's incoming-value-per-predecessor for real control flow -- short-
    # circuit `and`, nested if-EXPRESSIONS, and especially loop back-edges,
    # where a multi-def loop-carried local like `i = i + 1` otherwise produces
    # an llc "multiple definition of local value" SSA violation) with an
    # alloca-per-reassigned-local transform. An entry-block alloca dominates
    # every use by construction, so it cannot produce the `undef`/wrong phi
    # operands the join-predecessor phi materialization could. Applied on BOTH
    # the normal and SIMPLE_BOOTSTRAP paths; ssa_var_transform_blocks remains
    # the fallback only when the alloca transform reports it did not apply
    # (single-def functions -- byte-for-byte unchanged there).
    val alloca_rewritten = ssa_alloca_transform_blocks(fn_.blocks, fn_.locals, fn_.entry_block)
    if alloca_rewritten.applied:
        return MirFunction.with_blocks(fn_, alloca_rewritten.blocks)
    if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
        return fn_
    val rewritten = ssa_var_transform_blocks(fn_.blocks)
    if rewritten.applied:
        return MirFunction.with_blocks(fn_, rewritten.blocks)
    fn_

# Lane C7: render a MIR instruction's source span for a loud backend
# diagnostic, or a stable placeholder when the instruction carries none.
fn llvm_format_span(span: Span?) -> text:
    if span.?:
        val sp = span.unwrap()
        "{sp.file}:{sp.line}:{sp.col}"
    else:
        "unknown location"

fn llvm_module_name_from_entry_path(path: text) -> text:
    # Delegates to the single shared derivation in 00.common — see
    # module_path_naming.spl for history (this used to be one of four
    # hand-duplicated copies; a 70a29867bc2 drift between copies broke the
    # whole native-smoke-matrix 0/19).
    module_logical_name_from_path(path)

fn llvm_module_is_native_entry(module_name: text) -> bool:
    val native_entry = rt_env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    if native_entry == "":
        return true
    module_name == llvm_module_name_from_entry_path(native_entry)

# ============================================================================
# MIR to LLVM IR Translation
# ============================================================================

impl MirTextCodegen for MirToLlvm:

    me global_static_key(symbol_id: i64) -> text:
        if self.current_bootstrap_module >= 0:
            return "{self.current_bootstrap_module}:{symbol_id}"
        "{symbol_id}"

    # === Required: top-level translation ===

    me translate_module(module: MirModule) -> text:
        """Translate MIR module to LLVM IR."""
        val coverage_probe_diagnostic =
            mir_coverage_probe_admission_diagnostic_module_v1(module)
        if coverage_probe_diagnostic != "":
            panic("compile error: {coverage_probe_diagnostic}")
        self.entry_main_symbol = llvm_module_is_native_entry(module.name)
        if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
            llvm_bootstrap_string_globals_reset()
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[llvm-translate] header"
        self.builder.emit_module_header()
        if bootstrap_debug:
            print "[llvm-translate] runtime"
        self.emit_runtime_declarations()

        # DS3: line-table debug info. Emit the DWARF compile-unit header once,
        # up front, keyed off the first function whose MIR span carries a
        # real source file (begin_function's caller passes fn_.span for
        # ordinary functions -- see mir_data.spl:62 / function_lowering.spl:123).
        # Falls back to a synthetic "<module>.spl" name for the rare synthetic
        # functions (module init, generic specializations) built with a nil/
        # empty span. Per-function DISubprogram + !dbg attachment happens in
        # translate_function.
        if self.debug_info:
            var dbg_source_file = ""
            for fn_dbg in module.functions.values():
                match fn_dbg.span:
                    nil: ()
                    _:
                        if fn_dbg.span.file != "":
                            dbg_source_file = fn_dbg.span.file
                            break
            if dbg_source_file == "":
                dbg_source_file = "{module.name}.spl"
            val (dbg_filename, dbg_directory) = debug_info_split_path(dbg_source_file)
            self.builder.emit_debug_info_header(dbg_filename, dbg_directory)

        # Origin discriminator (see mir_call_ownership.spl): record which
        # runtime-owned names this module ALSO defines a local function
        # for, BEFORE any function is emitted. llvm_function_symbol_name
        # consults this to mangle only a colliding local definition's own
        # symbol -- ordinary named calls to any other function are
        # unaffected.
        for fn_owner in module.functions.values():
            if mir_runtime_owned_call_name(fn_owner.name):
                self.owned_name_has_local[fn_owner.name] = true
            # `@export("C", name: "...")`: record the requested ABI symbol so
            # llvm_function_symbol_name can honour it in BOTH mangling modes.
            # Must run BEFORE any function is emitted, since a call site may
            # be translated before the callee's own definition.
            if fn_owner.export_name != "":
                self.export_symbol_names[fn_owner.name] = fn_owner.export_name

        # mutglobal lane (module-level `var` mutation storage, see
        # scratchpad/mutglobal_plan.md): emit real LLVM `@name = global ...`
        # storage for every MirModule.statics entry (module-level mutable
        # bindings) BEFORE any function body is translated, so
        # LoadGlobal/StoreGlobal instructions in those bodies can resolve
        # global_static_names/global_static_types. `module.statics` has no
        # producer yet on the normal HIR/MIR frontend path (see the
        # gap-analysis doc) other than this lane's own
        # `_MirLowering/module_lowering.spl:lower_static` addition, so this
        # loop is a no-op (empty dict) for every existing native-build
        # program today -- purely additive, cannot regress anything that
        # currently compiles.
        if module.statics.keys().len() > 0:
            self.builder.emit("")
            self.builder.emit("; Module-level mutable globals")
            for static_ in module.statics.values():
                val g_ty = self.valid_llvm_type(self.llvm_type_text(static_.type_))
                val g_name = "@g_{static_.name}"
                val g_key = self.global_static_key(static_.symbol.id)
                self.global_static_names[g_key] = g_name
                self.global_static_types[g_key] = g_ty
                var g_init = "zeroinitializer"
                if static_.init.?:
                    val init_const: MirConstant = static_.init.unwrap()
                    g_init = self.translate_const_value(init_const.value)
                    # A Str initializer renders as a `getelementptr` PTR
                    # constant expression while the global's storage type is
                    # the i64 word lane -- llc rejects the mismatch
                    # ("constant expression type mismatch: got 'ptr' but
                    # expected 'i64'", W107). Wrap in a constant ptrtoint so
                    # the raw char* address is stored as the i64 word,
                    # matching how a raw string literal flows everywhere else.
                    match init_const.value:
                        case Str(_):
                            if g_ty == "i64":
                                g_init = "ptrtoint (ptr {g_init} to i64)"
                        case _: ()
                self.builder.emit("{g_name} = global {g_ty} {g_init}")

        if bootstrap_debug:
            print "[llvm-translate] keys"
        if bootstrap_debug:
            print "[llvm-translate] loop"
        if bootstrap_debug:
            val real_bootstrap = (rt_env_get("SIMPLE_BOOTSTRAP_REAL_LLVM") ?? "") == "1"
            val bootstrap_function_count = bootstrap_mir_function_count()
            if real_bootstrap:
                var bootstrap_return_i = 0
                while bootstrap_return_i < bootstrap_function_count:
                    val name = bootstrap_mir_function_name_at(bootstrap_return_i)
                    val fn_name = self.llvm_function_symbol_name(name)
                    val bootstrap_fn = bootstrap_mir_function_at(bootstrap_return_i)
                    val body = MirBody.from_function(bootstrap_fn)
                    val body_return_ty = body.bootstrap_return_type()
                    val ret_ty = self.llvm_type_text(body_return_ty)
                    self.remember_function_return_type(name, ret_ty)
                    self.remember_function_return_type(fn_name, ret_ty)
                    val ret_unsigned = self.is_unsigned_mir_kind(body_return_ty.kind)
                    self.remember_function_return_unsigned(name, ret_unsigned)
                    self.remember_function_return_unsigned(fn_name, ret_unsigned)
                    self.remember_function_param_types_from_signature(name, bootstrap_fn.signature)
                    self.remember_function_param_types_from_signature(fn_name, bootstrap_fn.signature)
                    bootstrap_return_i = bootstrap_return_i + 1
            var bootstrap_fni = 0
            while bootstrap_fni < bootstrap_function_count:
                print "[llvm-translate] body"
                val name = bootstrap_mir_function_name_at(bootstrap_fni)
                print "[llvm-translate] function"
                if real_bootstrap:
                    val bootstrap_fn = bootstrap_mir_function_at(bootstrap_fni)
                    val body = MirBody.from_function(bootstrap_fn)
                    self.translate_function(self.llvm_function_symbol_name(name), body, bootstrap_fn.span)
                else:
                    val fn_name = self.llvm_function_symbol_name(name)
                    self.builder.emit("define i64 @{fn_name}() {")
                    self.builder.emit("entry:")
                    self.builder.emit("  ret i64 0")
                    self.builder.emit("}")
                print "[llvm-translate] function-done"
                bootstrap_fni = bootstrap_fni + 1
        else:
            for fn_ in module.functions.values():
                val body = MirBody.from_function(llvm_bootstrap_ssa_function(fn_))
                val fn_name = self.llvm_function_symbol_name(fn_.name)
                val body_return_ty = body.bootstrap_return_type()
                val ret_ty = self.llvm_type_text(body_return_ty)
                self.remember_function_return_type(fn_.name, ret_ty)
                self.remember_function_return_type(fn_name, ret_ty)
                val ret_unsigned = self.is_unsigned_mir_kind(body_return_ty.kind)
                self.remember_function_return_unsigned(fn_.name, ret_unsigned)
                self.remember_function_return_unsigned(fn_name, ret_unsigned)
                self.remember_function_param_types_from_signature(fn_.name, fn_.signature)
                self.remember_function_param_types_from_signature(fn_name, fn_.signature)
            for fn_ in module.functions.values():
                val body = MirBody.from_function(llvm_bootstrap_ssa_function(fn_))
                val fn_name = self.llvm_function_symbol_name(fn_.name)
                self.translate_function(fn_name, body, fn_.span)

        if self.unknown_func_decls.keys().len() > 0:
            self.builder.emit("")
            self.builder.emit("; External call declarations")
            for unknown_name in self.unknown_func_decls.keys():
                # rt_* runtime builtins covered by the static runtime-declares
                # block are registered in defined_func_names; skip those so we
                # never emit a wrong-signature llc redefinition. Any other
                # extern (including user-declared rt_* names missing from the
                # static block) gets the normal auto-declare.
                if not self.defined_func_names.has(unknown_name):
                    self.builder.emit("declare i64 @{unknown_name}(...)")

        val bootstrap_string_globals = if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
            llvm_bootstrap_string_globals_text()
        else:
            ""
        if bootstrap_string_globals != "":
            self.builder.emit("")
            self.builder.emit("; String constants")
            self.builder.emit(bootstrap_string_globals)
        elif self.string_global_text.len() > 0:
            self.builder.emit("")
            self.builder.emit("; String constants")
            self.builder.emit(self.string_global_text)
        elif self.string_globals.len() > 0:
            self.builder.emit("")
            self.builder.emit("; String constants")
            for global_decl in self.string_globals:
                self.builder.emit(global_decl)

        if not bootstrap_debug:
            self.builder.emit_tbaa_hierarchy()
        return llvm_ir_builder_build(self.builder)

    me register_bootstrap_signatures():
        var index = 0
        while index < bootstrap_mir_function_count():
            val name = bootstrap_mir_function_name_at(index)
            val emitted_name = if name == "main": "__simple_main" else: name
            val return_type = bootstrap_llvm_static_type_text(bootstrap_mir_function_return_type_tag_at(index), self.native_int_type)
            self.remember_function_return_type(name, return_type)
            self.remember_function_return_type(emitted_name, return_type)
            val return_unsigned = bootstrap_mir_function_return_unsigned_at(index)
            self.remember_function_return_unsigned(name, return_unsigned)
            self.remember_function_return_unsigned(emitted_name, return_unsigned)
            var param_types: [text] = []
            var param_index = 0
            while param_index < bootstrap_mir_function_param_count_at(index):
                param_types = param_types.push(bootstrap_llvm_static_type_text(bootstrap_mir_function_param_type_tag_at(index, param_index), self.native_int_type))
                param_index = param_index + 1
            self.remember_function_param_types(name, param_types)
            self.remember_function_param_types(emitted_name, param_types)
            index = index + 1

    me emit_bootstrap_statics(ir_handle: i64):
        val static_count = bootstrap_mir_static_count()
        print "[bootstrap-real-llvm] statics {static_count}"
        var emitted_names: Dict<text, bool> = {}
        var index = 0
        while index < static_count:
            val g_name = "@g_{bootstrap_mir_static_name_at(index)}"
            val g_ty = bootstrap_llvm_static_type_text(bootstrap_mir_static_type_tag_at(index), self.native_int_type)
            var g_init = "zeroinitializer"
            val init_kind = bootstrap_mir_static_init_kind_at(index)
            val init_payload = bootstrap_mir_static_init_payload_at(index)
            if init_kind == 1:
                g_init = init_payload
            elif init_kind == 2:
                g_init = self.translate_const_value(MirConstValue.Str(init_payload))
                if g_ty == "i64":
                    g_init = "ptrtoint (ptr {g_init} to i64)"
            if not emitted_names.contains(g_name):
                val line = "{g_name} = global {g_ty} {g_init}"
                val newline = "\n"
                rt_string_builder_push(ir_handle, newline)
                rt_string_builder_push(ir_handle, line)
                emitted_names[g_name] = true
            index = index + 1

    me translate_bootstrap_function_at(index: i64, ir_handle: i64):
        val name = bootstrap_mir_function_name_at(index)
        val emitted_name = if name == "main": "__simple_main" else: name
        val fn_ = bootstrap_mir_function_at(index)
        val body = MirBody.from_bootstrap_parts(
            name: name,
            blocks: fn_.blocks,
            locals: fn_.locals,
            arg_count: bootstrap_mir_function_param_count_at(index)
        )
        val return_type = bootstrap_llvm_static_type_text(bootstrap_mir_function_return_type_tag_at(index), self.native_int_type)
        self.select_bootstrap_return_abi(return_type, bootstrap_mir_function_return_unsigned_at(index))
        self.translate_function_with_ir_handle(emitted_name, body, Span.empty(), bootstrap_mir_function_module_at(index), ir_handle)

    me translate_function(name: text, body: MirBody, span: Span):
        self.translate_function_with_ir_handle(name, body, span, -1, -1)

    me translate_function_with_ir_handle(name: text, body: MirBody, span: Span, module_index: i64, ir_handle: i64):
        """Translate a MIR function with optimization attributes.

        Renames 'main' to '__simple_main' so the entry point wrapper
        (entry_point.spl) can call it with proper runtime init/shutdown.

        `span` is the function-level MIR span (begin_function's caller
        passes the real HIR function span for ordinary functions; synthetic
        functions may pass an empty/nil-derived span -- see the DS3 debug-
        info note on `debug_info` in class_def.spl). Used only when
        self.debug_info is true, to attach a per-function !DISubprogram
        (file+line scope) via !dbg. Per-instruction line locations are NOT
        emitted here -- most MIR instruction spans are still nil pending a
        separate MIR-span-propagation fix (DS5); this is line-table-level
        (function granularity) debug info, not full DWARF.
        """
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] function:start {name}"
        self.begin_function_translation(name)
        # Local ids are reused across functions (see the resets above), so
        # unsigned_locals/alloca_elem_unsigned must reset per-function too --
        # otherwise a u8 local id N in one function could leak its unsigned
        # flag onto an unrelated i32 local id N in the next function.
        var local_i = 0
        var return_slot_id = -1
        while local_i < body.locals.len():
            val local: MirLocal = body.locals[local_i]
            val llvm_ty: text = self.llvm_type_text(local.type_)
            val local_id = self.local_id_value(local.id)
            self.local_types[local_id] = llvm_ty
            # Prime every local's unsigned bit upfront from its MIR-declared
            # type (U8/U16/U32/U64) -- this is what makes an unsigned
            # function PARAMETER (an Arg-kind local, never Alloc'd) visible
            # to get_operand_unsigned; without it, print(some_u8_param)
            # sign-extends the param instead of zero-extending it.
            self.unsigned_locals[local_id] = self.is_unsigned_mir_kind(local.type_.kind)
            match local.type_.kind:
                case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, _) | MirTypeKind.FuncPtr(_) | MirTypeKind.Function(_, _) | MirTypeKind.Opaque(_):
                    self.ptr_locals[local_id] = true
                case MirTypeKind.Struct(_) | MirTypeKind.Enum(_) | MirTypeKind.Tuple(_) | MirTypeKind.Array(_, _) | MirTypeKind.Slice(_) | MirTypeKind.Union(_):
                    self.ptr_locals[local_id] = true
                case MirTypeKind.Promise(_) | MirTypeKind.Generator(_, _) | MirTypeKind.ActorType(_):
                    self.ptr_locals[local_id] = true
                case MirTypeKind.Bool:
                    self.bool_locals[local_id] = true
                case _:
                    ()
            match local.kind:
                case Return:
                    self.return_locals[local_id] = true
                    return_slot_id = local_id
                case _:
                    ()
            local_i = local_i + 1
        if bootstrap_debug:
            print "[mir-to-llvm] function:locals {name}"

        var params: [text] = []
        var param_types: [text] = []
        var arg_i = 0
        while arg_i < body.arg_count:
            var param_local_i = 0
            while param_local_i < body.locals.len():
                val local: MirLocal = body.locals[param_local_i]
                match local.kind:
                    case Arg(index):
                        if index == arg_i:
                            val local_id = self.local_id_value(local.id)
                            val maybe_param_ty = self.get_local_type(local_id)
                            val param_ty = self.valid_llvm_type(maybe_param_ty)
                            self.defined_locals[local_id] = true
                            param_types = param_types.push(param_ty)
                            params = params.push("{param_ty} {self.get_local(local_id)}")
                    case _:
                        ()
                param_local_i = param_local_i + 1
            arg_i = arg_i + 1
        if bootstrap_debug:
            print "[mir-to-llvm] function:params {name}"

        var ret_ty: text = ""
        var ret_unsigned = false
        if self.bootstrap_return_abi_active:
            ret_ty = self.bootstrap_return_abi_text
            ret_unsigned = self.bootstrap_return_abi_unsigned
            self.bootstrap_return_abi_text = ""
            self.bootstrap_return_abi_unsigned = false
            self.bootstrap_return_abi_active = false
        else:
            val body_return_ty = body.bootstrap_return_type()
            ret_ty = self.llvm_type_text(body_return_ty)
            ret_unsigned = self.is_unsigned_mir_kind(body_return_ty.kind)
        self.set_function_return_type(ret_ty)
        if bootstrap_debug:
            print "[mir-to-llvm] function:return {name}"

        var has_store = false
        var has_call = false
        var inst_count = 0
        var scan_block_i = 0
        while scan_block_i < body.blocks.len():
            val block = body.blocks[scan_block_i]
            var scan_inst_i = 0
            while scan_inst_i < block.instructions.len():
                val inst = block.instructions[scan_inst_i]
                inst_count = inst_count + 1
                match inst.kind:
                    case Store(_, _): has_store = true
                    case SetField(_, _, _): has_store = true
                    case Call(_, _, _): has_call = true
                    case CallIndirect(_, _, _, _): has_call = true
                    case Intrinsic(_, _, _): has_call = true
                    case Send(_, _): has_store = true
                    case _: ()
                scan_inst_i = scan_inst_i + 1
            scan_block_i = scan_block_i + 1
        if bootstrap_debug:
            print "[mir-to-llvm] function:scan {name}"

        val is_readonly = not has_store and not has_call
        val is_small = inst_count < 10

        # Rename only the requested entry module's main to __simple_main.
        val fn_name = self.llvm_function_symbol_name(name)
        self.defined_func_names[fn_name] = true

        # entry_point.spl hardcodes `declare i64 @__simple_main()` and reads
        # the i64 result as the process exit code. A user `fn main():` with
        # no declared return type lowers body.return_ty to void here, which
        # would emit `define void @__simple_main()` / `ret void` against that
        # i64-typed caller -- the call site then truncates whatever garbage
        # happened to be sitting in the return register as the exit code
        # (nondeterministic). Force the true entry symbol's LLVM return type
        # to i64 so a bare `return` / fall-off-the-end emits `ret i64 0`
        # instead, matching the documented "no return type => exit 0"
        # contract. Only the exact global entry symbol is affected --
        # per-module mains (`__simple_main_<mod>`, not called by
        # entry_point.spl) keep their real signature.
        val effective_ret_ty = if fn_name == "__simple_main" and ret_ty == "void":
            "i64"
        else:
            ret_ty
        self.set_function_return_type(effective_ret_ty)

        self.remember_function_return_type(name, effective_ret_ty)
        self.remember_function_return_type(fn_name, effective_ret_ty)
        self.remember_function_return_unsigned(name, ret_unsigned)
        self.remember_function_return_unsigned(fn_name, ret_unsigned)
        self.remember_function_param_types(name, param_types)
        self.remember_function_param_types(fn_name, param_types)

        var dbg_id: i64? = nil
        if self.debug_info:
            val sub_id = self.builder.next_debug_id()
            # Synthetic functions (module init, generic specialization
            # templates -- see module_lowering.spl's `begin_function(..., nil)`
            # call sites) build their MirFunction with a nil span; matching
            # against nil first avoids crashing on `.line` for those.
            val dbg_line = match span:
                nil: 1
                _: if span.line > 0: span.line else: 1
            self.builder.emit_di_subprogram(sub_id, name, dbg_line)
            dbg_id = Some(sub_id)

        if ir_handle >= 0:
            val param_str = params.join(", ")
            var attrs = " nounwind"
            if is_readonly:
                attrs = attrs + " readonly"
            if is_small:
                attrs = attrs + " alwaysinline"
            var dbg_suffix = ""
            match dbg_id:
                Some(id): dbg_suffix = " !dbg !{id}"
                nil: ()
            val opening = "define {effective_ret_ty} @{fn_name}({param_str}){attrs}{dbg_suffix} {{"
            if rt_string_builder_len(ir_handle) > 0:
                val newline = "\n"
                rt_string_builder_push(ir_handle, newline)
            rt_string_builder_push(ir_handle, opening)
        else:
            self.builder.start_function_opt(fn_name, params, effective_ret_ty, is_readonly, is_small, dbg_id)
        if bootstrap_debug:
            print "[mir-to-llvm] function:started {name}"

        val is_start = name == "_start"
        var block_i = 0
        while block_i < body.blocks.len():
            self.translate_block_at(body.blocks, block_i, effective_ret_ty, is_start, return_slot_id, module_index, ir_handle)
            block_i = block_i + 1

        if ir_handle >= 0:
            val closing = "\n}\n"
            rt_string_builder_push(ir_handle, closing)
        else:
            self.builder.end_function()
        if bootstrap_debug:
            print "[mir-to-llvm] function:done {name}"

    me translate_block_at(blocks: [MirBlock], block_index: i64, return_type_text: text, is_start: bool, return_slot_id: i64, module_index: i64, ir_handle: i64):
        """Translate a MIR basic block."""
        val block = blocks[block_index]
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] block:label-before"
        val bootstrap_block_id = block.bootstrap_block_id_value()
        self.builder.emit_label("bb{bootstrap_block_id}")
        if bootstrap_debug:
            print "[mir-to-llvm] block:label-after bb{bootstrap_block_id}"
        val bootstrap_instructions = block.instructions
        var bootstrap_inst_i = 0
        while bootstrap_inst_i < bootstrap_instructions.len():
            if bootstrap_debug:
                print "[mir-to-llvm] block:instruction-before bb{bootstrap_block_id} index={bootstrap_inst_i}"
            self.translate_instruction_at(bootstrap_instructions, bootstrap_inst_i, module_index, ir_handle)
            if bootstrap_debug:
                print "[mir-to-llvm] block:instruction-after bb{bootstrap_block_id} index={bootstrap_inst_i}"
            bootstrap_inst_i = bootstrap_inst_i + 1
        if bootstrap_debug:
            print "[mir-to-llvm] block:terminator-before bb{bootstrap_block_id}"
        self.translate_terminator_at(blocks, block_index, return_type_text, is_start, return_slot_id)
        if bootstrap_debug:
            print "[mir-to-llvm] block:terminator-after bb{bootstrap_block_id}"

    me translate_instruction_at(instructions: [MirInst], index: i64, module_index: i64, ir_handle: i64):
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:entry index={index}"
        val inst: MirInst = instructions[index]
        val inst_kind = inst.kind
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:kind index={index}"
        val const_disc = rt_enum_discriminant(MirInstKind.Const(LocalId(id: 0), MirConstValue.Zero, MirType.i64()))
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:const-discriminant index={index}"
        if rt_enum_discriminant(inst_kind) == const_disc:
            val payload = rt_enum_payload(inst_kind)
            val dest: LocalId = rt_tuple_get(payload, 0)
            val value: MirConstValue = rt_tuple_get(payload, 1)
            val ty: MirType = rt_tuple_get(payload, 2)
            self.translate_const(dest, value, ty)
            # Fast paths must perform the SAME trailing bookkeeping the
            # fall-through dispatch does. Skipping this call is exactly how the
            # Copy fast path below silently dropped every Copy destination from
            # `defined_locals` and made `translate_terminator` emit `ret <ty> 0`
            # (2026-08-01). Idempotent, so it is safe alongside the callee's own
            # self-marking; keep it so a future fast path cannot re-open the hole.
            self.mark_instruction_dest_defined_at(instructions, index)
            return

        val copy_disc = rt_enum_discriminant(MirInstKind.Copy(LocalId(id: 0), LocalId(id: 0)))
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:copy-discriminant index={index}"
        if rt_enum_discriminant(inst_kind) == copy_disc:
            val payload = rt_enum_payload(inst_kind)
            val dest: LocalId = rt_tuple_get(payload, 0)
            val src: LocalId = rt_tuple_get(payload, 1)
            self.translate_copy_move(dest, src, false)
            # Same invariant as the Const fast path above: mirror the trailing
            # bookkeeping of the fall-through dispatch before returning.
            self.mark_instruction_dest_defined_at(instructions, index)
            return

        val store_global_disc = rt_enum_discriminant(MirInstKind.StoreGlobal(SymbolId(id: 0), mir_operand_const_int(0)))
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:store-global-discriminant index={index}"
        if rt_enum_discriminant(inst_kind) == store_global_disc:
            self.translate_store_global_at(instructions, index, module_index, ir_handle)
            return

        val load_global_disc = rt_enum_discriminant(MirInstKind.LoadGlobal(LocalId(id: 0), SymbolId(id: 0)))
        if bootstrap_debug:
            print "[mir-to-llvm] instruction:load-global-discriminant index={index}"
        if rt_enum_discriminant(inst_kind) == load_global_disc:
            val load_payload = rt_enum_payload(inst_kind)
            if bootstrap_debug:
                print "[mir-to-llvm] load-global:payload index={index}"
            val load_dest: LocalId = rt_tuple_get(load_payload, 0)
            if bootstrap_debug:
                print "[mir-to-llvm] load-global:dest-slot index={index}"
            val load_dest_id = load_dest.id
            if bootstrap_debug:
                print "[mir-to-llvm] load-global:dest-id index={index} dest={load_dest_id}"
            # SymbolId is a one-field struct and can decay to its raw i64 when
            # crossing the staged enum-payload ABI. Keep the tuple slot raw;
            # re-wrapping it as SymbolId and reading `.id` dereferences the
            # scalar as an object in Phase 2 native compilers.
            val load_symbol_slot: i64 = rt_tuple_get(load_payload, 1)
            val load_symbol_id = rt_value_as_int(load_symbol_slot >> 32)
            if bootstrap_debug:
                print "[mir-to-llvm] load-global:symbol-decoded index={index} slot={load_symbol_slot} symbol={load_symbol_id}"
            self.translate_load_global_ids(load_dest_id, load_symbol_id, module_index, ir_handle)
            return

        match inst_kind:
            case Move(dest, src): self.translate_copy_move(dest, src, true)
            case BinOp(dest, op, left, right): self.translate_binop(dest, op, left, right)
            case CheckedBinOp(dest, op, left, right): self.translate_binop(dest, op, left, right)
            case UnaryOp(dest, op, operand): self.translate_unaryop(dest, op, operand)
            case Alloc(dest, ty): self.translate_alloc(dest, ty)
            case Load(dest, ptr): self.translate_load(dest, ptr)
            case Store(ptr, value): self.translate_store(ptr, value)
            # Indexed scalar fast paths above own LoadGlobal and StoreGlobal.
            case LoadGlobal(_, _) | StoreGlobal(_, _): ()
            case GetElementPtr(dest, base, indices): self.translate_gep(dest, base, indices)
            case Aggregate(dest, kind, operands): self.translate_aggregate(dest, kind, operands)
            case GetField(dest, base, field): self.translate_get_field(dest, base, field)
            case SetField(base, field, value): self.translate_set_field(base, field, value)
            case Cast(dest, operand, target): self.translate_cast_dispatch(dest, operand, target)
            case Bitcast(dest, operand, target): self.translate_bitcast(dest, operand, target)
            case Call(_, _, _):
                if bootstrap_debug:
                    print "[mir-to-llvm] instruction:call index={index}"
                self.translate_call_at(instructions, index, ir_handle)
            case CallIndirect(dest, ptr, args, sig): self.translate_call_indirect(dest, ptr, args, sig)
            case Intrinsic(dest, name, args): self.translate_intrinsic(dest, name, args)
            case InlineAsm(asm_template, is_volatile, inputs, outputs, clobbers, clobber_abis, options):
                self.translate_inline_asm(asm_template, is_volatile, inputs, outputs, clobbers, clobber_abis, options)
            case PipeForward(dest, value, func): self.translate_pipe_forward(dest, value, func)
            case Compose(dest, f, g, forward): self.translate_compose(dest, f, g, forward)
            case Parallel(dest, funcs): self.translate_parallel(dest, funcs)
            case LayerConnect(dest, l1, l2): self.translate_layer_connect(dest, l1, l2)
            case Ref(dest, kind, place): self.translate_ref(dest, kind, place)
            case TransferOut(_, _, _, _, _, _): self.emit_unsupported_panic("LLVM runtime transfer-envelope lowering is not implemented")
            case TransferIn(_, _, _, _): self.emit_unsupported_panic("LLVM runtime transfer receipt lowering is not implemented")
            case FreezeRegion(_): self.emit_unsupported_panic("LLVM frozen-region lowering is not implemented")
            case AcquireSnapshot(_, _): self.emit_unsupported_panic("LLVM snapshot lowering is not implemented")
            case CommitUpdates(_, _, _): self.emit_unsupported_panic("LLVM parent-commit lowering is not implemented")
            case CreatePromise(dest, body, result_type): self.translate_create_promise(dest, body, result_type)
            case Await(dest, promise): self.translate_await(dest, promise)
            case Yield(value): self.translate_yield(value)
            case Spawn(dest, handler, args): self.translate_spawn(dest, handler, args)
            case Send(target, message): self.translate_send(target, message)
            case Receive(dest, timeout): self.translate_receive(dest, timeout)
            case GpuKernelDef(name): self.translate_gpu_kernel_def(name)
            case GpuLaunch(args): self.translate_gpu_launch(args)
            case GpuGlobalId(dest, dim): self.translate_gpu_global_id(dest, dim)
            case GpuLocalId(dest, dim): self.translate_gpu_local_id(dest, dim)
            case GpuBlockId(dest, dim): self.translate_gpu_block_id(dest, dim)
            case GpuBlockDim(dest, dim): self.translate_gpu_block_dim(dest, dim)
            case GpuGridDim(dest, dim): self.translate_gpu_grid_dim(dest, dim)
            case GpuBarrier(scope): self.translate_gpu_barrier(scope)
            case GpuMemFence(scope): self.translate_gpu_mem_fence(scope)
            case GpuSharedAlloc(dest, type_, size): self.translate_gpu_shared_alloc(dest, type_, size)
            case GpuAtomicOp(dest, op, ptr, value): self.translate_gpu_atomic_op(dest, op, ptr, value)
            case GpuAtomicCas(dest, ptr, expected, desired): self.translate_gpu_atomic_cas(dest, ptr, expected, desired)
            case VhdlProcess(kind, body_block): self.translate_vhdl_process(kind, body_block)
            case VhdlSignalAssign(target, value, delay_ns): self.translate_vhdl_signal_assign(target, value, delay_ns)
            case VhdlVarAssign(target, value): self.translate_vhdl_var_assign(target, value)
            case VhdlPortMap(entity, instance, connections): self.translate_vhdl_port_map(entity, instance, connections)
            case VhdlResize(dest, operand, new_width, signed): self.translate_vhdl_resize(dest, operand, new_width, signed)
            case VhdlSlice(dest, signal, hi, lo): self.translate_vhdl_slice(dest, signal, hi, lo)
            case VhdlConcat(dest, parts): self.translate_vhdl_concat(dest, parts)
            case SimdAddF32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "add_f32x4")
            case SimdSubF32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "sub_f32x4")
            case SimdMulF32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "mul_f32x4")
            case SimdDivF32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "div_f32x4")
            case SimdFmaF32x4(dest, a, b, c): self.translate_simd_fma(dest, a, b, c, "fma_f32x4")
            case SimdAddF32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "add_f32x8")
            case SimdSubF32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "sub_f32x8")
            case SimdMulF32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "mul_f32x8")
            case SimdDivF32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "div_f32x8")
            case SimdFmaF32x8(dest, a, b, c): self.translate_simd_fma(dest, a, b, c, "fma_f32x8")
            case SimdAddF64x4(dest, a, b): self.translate_simd_binop(dest, a, b, "add_f64x4")
            case SimdSubF64x4(dest, a, b): self.translate_simd_binop(dest, a, b, "sub_f64x4")
            case SimdMulF64x4(dest, a, b): self.translate_simd_binop(dest, a, b, "mul_f64x4")
            case SimdDivF64x4(dest, a, b): self.translate_simd_binop(dest, a, b, "div_f64x4")
            case SimdFmaF64x4(dest, a, b, c): self.translate_simd_fma(dest, a, b, c, "fma_f64x4")
            case SimdAddI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "add_i32x4")
            case SimdSubI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "sub_i32x4")
            case SimdMulI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "mul_i32x4")
            case SimdXorI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "xor_i32x4")
            case SimdAndI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "and_i32x4")
            case SimdOrI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "or_i32x4")
            case SimdShlI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "shl_i32x4")
            case SimdShrI32x4(dest, a, b): self.translate_simd_binop(dest, a, b, "shr_i32x4")
            case SimdAddI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "add_i32x8")
            case SimdSubI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "sub_i32x8")
            case SimdMulI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "mul_i32x8")
            case SimdXorI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "xor_i32x8")
            case SimdAndI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "and_i32x8")
            case SimdOrI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "or_i32x8")
            case SimdShlI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "shl_i32x8")
            case SimdShrI32x8(dest, a, b): self.translate_simd_binop(dest, a, b, "shr_i32x8")
            case SimdHaddF32x4(dest, a): self.translate_simd_horizontal(dest, a, "hadd_f32x4")
            case SimdHmaxF32x4(dest, a): self.translate_simd_horizontal(dest, a, "hmax_f32x4")
            case SimdHminF32x4(dest, a): self.translate_simd_horizontal(dest, a, "hmin_f32x4")
            case DebugValue(_, _): ()
            case Nop: ()
            case DecisionProbe(_, semantic_id, _, _, _, _):
                panic("compile error: unlowered DecisionProbe '{semantic_id}' reached LLVM instruction translation")
            case ConditionProbe(_, semantic_id, _, _, _, _, _, _):
                panic("compile error: unlowered ConditionProbe '{semantic_id}' reached LLVM instruction translation")
            # ----------------------------------------------------------------
            # Lane C7 (backend coverage, hardening plan 2026-08-21 sections
            # 11.3-11.6). EXPLICIT arms for the 32 MirInstKind variants that
            # used to reach the terminal `case _: ()` below and were SILENTLY
            # DROPPED -- the emitted LLVM module simply came out missing the
            # instruction, with no diagnostic anywhere. Each now raises a
            # stable, spanned E-BACKEND-LLVM-INST-<Variant>.
            # Universe: spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn
            # Table:    spec/compiler_schema/transitions/mir_inst_to_llvm.sdn
            # ----------------------------------------------------------------
            case Drop(_):
                # Deliberate no-op: Drop is a MIR-level marker with no LLVM
                # code-generation effect. Recorded `implemented` in the table.
                ()
            case HostGpuLaneBegin(_, _):
                self._unsupported_llvm_inst("HostGpuLaneBegin", inst.span)
            case HostGpuLaneEnd(_):
                self._unsupported_llvm_inst("HostGpuLaneEnd", inst.span)
            case MaskFromCmp(_, _, _, _):
                self._unsupported_llvm_inst("MaskFromCmp", inst.span)
            case MaskedAdd(_, _, _, _):
                self._unsupported_llvm_inst("MaskedAdd", inst.span)
            case MaskedFma(_, _, _, _, _):
                self._unsupported_llvm_inst("MaskedFma", inst.span)
            case MaskedMul(_, _, _, _):
                self._unsupported_llvm_inst("MaskedMul", inst.span)
            case MirSimdBinop(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdBinop", inst.span)
            case MirSimdCmp(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdCmp", inst.span)
            case MirSimdGather(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdGather", inst.span)
            case MirSimdLoad(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdLoad", inst.span)
            case MirSimdMaskOp(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdMaskOp", inst.span)
            case MirSimdPermute(_, _, _):
                self._unsupported_llvm_inst("MirSimdPermute", inst.span)
            case MirSimdReduce(_, _, _):
                self._unsupported_llvm_inst("MirSimdReduce", inst.span)
            case MirSimdScalableVsetvl(_, _, _):
                self._unsupported_llvm_inst("MirSimdScalableVsetvl", inst.span)
            case MirSimdScatter(_, _, _):
                self._unsupported_llvm_inst("MirSimdScatter", inst.span)
            case MirSimdSelect(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdSelect", inst.span)
            case MirSimdShuffle(_, _, _, _):
                self._unsupported_llvm_inst("MirSimdShuffle", inst.span)
            case MirSimdSplat(_, _, _):
                self._unsupported_llvm_inst("MirSimdSplat", inst.span)
            case MirSimdStore(_, _, _):
                self._unsupported_llvm_inst("MirSimdStore", inst.span)
            case MirSimdTernop(_, _, _, _, _):
                self._unsupported_llvm_inst("MirSimdTernop", inst.span)
            case MirSimdUnop(_, _, _):
                self._unsupported_llvm_inst("MirSimdUnop", inst.span)
            case MirWarpActivesMask(_):
                self._unsupported_llvm_inst("MirWarpActivesMask", inst.span)
            case MirWarpBallot(_, _, _):
                self._unsupported_llvm_inst("MirWarpBallot", inst.span)
            case MirWarpReduce(_, _, _, _):
                self._unsupported_llvm_inst("MirWarpReduce", inst.span)
            case MirWarpShfl(_, _, _, _, _):
                self._unsupported_llvm_inst("MirWarpShfl", inst.span)
            case MirWarpSync(_):
                self._unsupported_llvm_inst("MirWarpSync", inst.span)
            case PredicatedAdd(_, _, _, _, _, _):
                self._unsupported_llvm_inst("PredicatedAdd", inst.span)
            case PredicatedFma(_, _, _, _, _, _, _):
                self._unsupported_llvm_inst("PredicatedFma", inst.span)
            case PredicatedMul(_, _, _, _, _, _):
                self._unsupported_llvm_inst("PredicatedMul", inst.span)
            case ResultMatchSemantic(_, _, _, _, _, _, _):
                self._unsupported_llvm_inst("ResultMatchSemantic", inst.span)
            case ScalableVecFence(_):
                self._unsupported_llvm_inst("ScalableVecFence", inst.span)
            case _:
                # Not a variant: every MirInstKind now has an arm above, so this
                # is reachable only by a NEW upstream variant with no arm here,
                # or by a mis-decoded enum handle. It used to be a silent `()`.
                val unknown_llvm_inst_disc = rt_enum_discriminant(inst_kind)
                eprint("[mir-to-llvm] E-BACKEND-LLVM-INST-Unknown disc={unknown_llvm_inst_disc} at={llvm_format_span(inst.span)}")
                self.emit_unsupported_panic("E-BACKEND-LLVM-INST-Unknown: no LLVM backend arm for MIR instruction kind (discriminant {unknown_llvm_inst_disc}) at {llvm_format_span(inst.span)}")
        self.mark_instruction_dest_defined_at(instructions, index)

    me _unsupported_llvm_inst(variant: text, span: Span?):
        """NAMED, spanned diagnostic for a MirInstKind variant the LLVM text
        backend does not lower (lane C7). `E-BACKEND-LLVM-INST-<Variant>` is
        stable and greppable; before C7 these variants were silently dropped by
        a shared `case _: ()`."""
        val code = "E-BACKEND-LLVM-INST-{variant}"
        eprint("[mir-to-llvm] {code} at={llvm_format_span(span)}")
        self.emit_unsupported_panic("{code}: LLVM backend does not lower {variant} at {llvm_format_span(span)}")

    me mark_instruction_dest_defined_at(instructions: [MirInst], index: i64):
        val inst: MirInst = instructions[index]
        match inst.kind:
            case Copy(dest, _) | Move(dest, _) | BinOp(dest, _, _, _) | CheckedBinOp(dest, _, _, _) | UnaryOp(dest, _, _) | Alloc(dest, _) | Load(dest, _) | LoadGlobal(dest, _) | GetElementPtr(dest, _, _) | Aggregate(dest, _, _) | GetField(dest, _, _) | Cast(dest, _, _) | Bitcast(dest, _, _) | PipeForward(dest, _, _) | Compose(dest, _, _, _) | Parallel(dest, _) | LayerConnect(dest, _, _) | Ref(dest, _, _) | CreatePromise(dest, _, _) | Await(dest, _) | Spawn(dest, _, _) | Receive(dest, _) | GpuGlobalId(dest, _) | GpuLocalId(dest, _) | GpuBlockId(dest, _) | GpuBlockDim(dest, _) | GpuGridDim(dest, _) | GpuSharedAlloc(dest, _, _) | GpuAtomicOp(dest, _, _, _) | GpuAtomicCas(dest, _, _, _) | VhdlResize(dest, _, _, _) | VhdlSlice(dest, _, _, _) | VhdlConcat(dest, _) | SimdAddF32x4(dest, _, _) | SimdSubF32x4(dest, _, _) | SimdMulF32x4(dest, _, _) | SimdDivF32x4(dest, _, _) | SimdFmaF32x4(dest, _, _, _) | SimdAddF32x8(dest, _, _) | SimdSubF32x8(dest, _, _) | SimdMulF32x8(dest, _, _) | SimdDivF32x8(dest, _, _) | SimdFmaF32x8(dest, _, _, _) | SimdAddF64x4(dest, _, _) | SimdSubF64x4(dest, _, _) | SimdMulF64x4(dest, _, _) | SimdDivF64x4(dest, _, _) | SimdFmaF64x4(dest, _, _, _) | SimdAddI32x4(dest, _, _) | SimdSubI32x4(dest, _, _) | SimdMulI32x4(dest, _, _) | SimdXorI32x4(dest, _, _) | SimdAndI32x4(dest, _, _) | SimdOrI32x4(dest, _, _) | SimdShlI32x4(dest, _, _) | SimdShrI32x4(dest, _, _) | SimdAddI32x8(dest, _, _) | SimdSubI32x8(dest, _, _) | SimdMulI32x8(dest, _, _) | SimdXorI32x8(dest, _, _) | SimdAndI32x8(dest, _, _) | SimdOrI32x8(dest, _, _) | SimdShlI32x8(dest, _, _) | SimdShrI32x8(dest, _, _) | SimdHaddF32x4(dest, _) | SimdHmaxF32x4(dest, _) | SimdHminF32x4(dest, _):
                self.defined_locals[self.local_id_value(dest)] = true
            case Call(dest, _, _) | CallIndirect(dest, _, _, _) | Intrinsic(dest, _, _):
                if dest.?:
                    val dest_local: LocalId = dest.unwrap()
                    self.defined_locals[self.local_id_value(dest_local)] = true
            case _:
                ()

    fn ret_value_for_type(ret_ty: text, value: text) -> text:
        if ret_ty.len() == 3 and ret_ty.starts_with("ptr") and value.len() == 1 and value.starts_with("0"):
            return "null"
        value

    fn normalize_call_callee(callee: text) -> text:
        if callee == "0":
            return "null"
        if callee.starts_with("@") or callee.starts_with("%") or callee == "undef" or callee == "null":
            return callee
        "@{callee}"

    me emit_value_type_conversion(value: text, src_ty: text, dst_ty: text, src_unsigned: bool) -> text:
        """Emit a verified scalar conversion for value_as_type callers."""
        if src_ty == "i1" and dst_ty == "ptr":
            # LLVM cannot bitcast i1 to ptr. Preserve the boolean through the
            # target's native integer width before converting to a pointer.
            val native_ty = self.native_int()
            val widened = self.builder.fresh_local()
            val converted = self.builder.fresh_local()
            self.builder.emit("  {widened} = zext i1 {value} to {native_ty}")
            self.builder.emit("  {converted} = inttoptr {native_ty} {widened} to ptr")
            return converted
        if src_ty == "ptr" and dst_ty == "i1":
            # Pointer-to-bool is truthiness, not a lossy pointer bitcast.
            val converted = self.builder.fresh_local()
            self.builder.emit("  {converted} = icmp ne ptr {value}, null")
            return converted

        var cast_inst = self.select_cast_instruction(src_ty, dst_ty)
        if src_unsigned and cast_inst == "sext":
            cast_inst = "zext"
        if src_unsigned and cast_inst == "sitofp":
            cast_inst = "uitofp"
        if cast_inst.len() == 0:
            panic("compile error: unsupported LLVM value conversion from {src_ty} to {dst_ty}")
            return value
        val tmp = self.builder.fresh_local()
        self.builder.emit("  {tmp} = {cast_inst} {src_ty} {value} to {dst_ty}")
        tmp

    me value_as_type_signed(value: text, from_ty: text, to_ty: text, src_unsigned: bool) -> text:
        """Same as value_as_type, but widening picks zext when src_unsigned
        is set (MIR-level U8/U16/U32 source) instead of always sext'ing.
        See select_widen_instruction / is_unsigned_mir_kind."""
        var src_ty = self.valid_llvm_type(from_ty)
        # contains_key + index read, never `.get()`: a native `Dict.get()` HIT
        # does not round-trip. See doc/07_guide/language/dict_native_pitfalls.md
        if self.value_types.contains_key(value):
            src_ty = self.valid_llvm_type(self.value_types[value])
        val dst_ty = self.valid_llvm_type(to_ty)
        if src_ty == dst_ty:
            return self.ret_value_for_type(dst_ty, value)
        if value == "0":
            return self.ret_value_for_type(dst_ty, "0")
        # Unsigned MIR-level sources (U8/U16/U32) widening to a bigger int
        # must zext, not sext -- select_cast_instruction has no signedness
        # input and always sext's i8/i16/i32 widening (only correct for
        # signed sources). See is_unsigned_mir_kind.
        self.emit_value_type_conversion(value, src_ty, dst_ty, src_unsigned)

    me get_operand_unsigned(operand: MirOperand) -> bool:
        """Best-effort MIR-level signedness for an operand: true for a Const
        of an unsigned MirType, or a Copy/Move of a local whose declared
        type was recorded as unsigned (see translate_alloc/translate_load).
        Defaults to false (signed) when unknown -- matches the prior
        behavior of always-sext widening, so this is only ever additive."""
        match operand.kind:
            case Copy(local):
                if self.unsigned_locals.contains_key(self.local_id_value(local)): self.unsigned_locals[self.local_id_value(local)] else: false
            case Move(local):
                if self.unsigned_locals.contains_key(self.local_id_value(local)): self.unsigned_locals[self.local_id_value(local)] else: false
            case Const(value, type_):
                self.is_unsigned_mir_kind(type_.kind)
            case _:
                false

    me value_as_type(value: text, from_ty: text, to_ty: text) -> text:
        var src_ty = self.valid_llvm_type(from_ty)
        # POSITIVE `.?` form only (see get_local_type): Option-match on
        # Dict.get mis-dispatches under the seed interpreter.
        # contains_key + index read, never `.get()`: a native `Dict.get()` HIT
        # does not round-trip. See doc/07_guide/language/dict_native_pitfalls.md
        if self.value_types.contains_key(value):
            src_ty = self.valid_llvm_type(self.value_types[value])
        val dst_ty = self.valid_llvm_type(to_ty)
        if src_ty == dst_ty:
            return self.ret_value_for_type(dst_ty, value)
        if value == "0":
            return self.ret_value_for_type(dst_ty, "0")
        self.emit_value_type_conversion(value, src_ty, dst_ty, false)

    # floatedge lane (-0.0 sign-loss fix): translate_cast's shared body
    # (aggregate_intrinsics.spl -- out of scope for this lane, see
    # CONFLICT-FLAG below) finalizes EVERY Cast MIR instruction's result
    # with a value-defining identity op: `fadd target_ty, 0.0` for a float
    # target. That is IEEE754 value-preserving for any finite/nonzero
    # operand, but NOT for a genuine `-0.0` -- `-0.0 + 0.0 == +0.0` under
    # the default round-to-nearest rule for opposite-signed zero addition
    # -- so it silently flips the sign of any negative-zero float that
    # passes through an `as`-cast, or through the redundant same-type Cast
    # MIR lowering inserts for a type-annotated `val a: f64 = -0.0`
    # declaration (confirmed via SIMPLE_KEEP_LLVM_IR=1 dump: the `fneg`
    # correctly produces -0.0, then the very next `; cast` fadd flips it
    # back to +0.0 before it ever reaches rt_raw_f64_to_string in
    # runtime_native.c -- the runtime cannot recover a sign the codegen
    # already destroyed). `x + (-0.0) == x` for every finite x AND for
    # both zero signs (same-sign zero addition keeps its sign), so ending
    # with `-0.0` instead of `0.0` is a strictly safer, universally
    # correct identity -- not a special case carved out for the literal
    # -0.0 probe. Only the float-targeted case is intercepted here; every
    # other Cast (int/ptr) is unaffected and still routes to the existing
    # translate_cast.
    #
    # CONFLICT-FLAG: this duplicates (with one changed constant) the tail
    # of aggregate_intrinsics.spl's translate_cast, which is out of scope
    # for this lane's ownership boundary. The canonical fix belongs there
    # (swap both `fadd {target_ty} {casted}, 0.0  ; cast` occurrences to
    # `-0.0`) -- once that file is back in scope this shim + the dispatch
    # override above should be deleted and Cast routed straight back to
    # self.translate_cast.
    me translate_cast_dispatch(dest: LocalId, operand: MirOperand, target: MirType):
        val cast_target_ty = self.valid_llvm_type(self.llvm_type_text(target))
        if is_float_type(cast_target_ty):
            self.translate_cast_float_signsafe(dest, operand, target)
        else:
            self.translate_cast(dest, operand, target)

    me translate_cast_float_signsafe(dest: LocalId, operand: MirOperand, target: MirType):
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val operand_val = self.translate_operand(operand)
        val src_ty = self.valid_llvm_type(self.get_operand_type(operand))
        val target_ty = self.valid_llvm_type(self.llvm_type_text(target))
        self.local_types[dest_id] = target_ty
        self.value_types[dest_name] = target_ty
        self.unsigned_locals[dest_id] = self.is_unsigned_mir_kind(target.kind)
        val casted = self.value_as_type_signed(operand_val, src_ty, target_ty, self.get_operand_unsigned(operand))
        self.builder.emit("  {dest_name} = fadd {target_ty} {casted}, -0.0  ; cast (sign-safe)")

    me remember_function_return_type(name: text, ret_ty: text):
        self.function_return_types[name] = ret_ty

    me remember_function_return_unsigned(name: text, unsigned: bool):
        self.function_return_unsigned[name] = unsigned

    me lookup_function_return_unsigned(func_name: text) -> bool:
        """Same lookup pattern as lookup_function_return_type (direct name,
        then bare name with the leading '@' stripped)."""
        val direct = self.function_return_unsigned.get(func_name)
        if direct.?:
            return direct.unwrap()
        if not func_name.starts_with("@"):
            return false
        val bare = func_name[1:]
        # `.has()` + index, not `.get() ?? false` — under native codegen a
        # Dict<_, bool> hit storing `true` collapses to false via `?? false`
        # (dict_native_pitfalls.md), silently marking unsigned returns as signed.
        if self.function_return_unsigned.has(bare): self.function_return_unsigned[bare] else: false

    me remember_function_param_types(name: text, param_tys: [text]):
        if name == "":
            return
        self.function_param_types[name] = param_tys

    me remember_function_param_types_from_signature(name: text, sig: MirSignature):
        var param_tys: [text] = []
        for param in sig.params:
            param_tys = param_tys.push(self.valid_llvm_type(self.llvm_type_text(param)))
        self.remember_function_param_types(name, param_tys)

    me translate_terminator_at(blocks: [MirBlock], block_index: i64, return_type_text: text, is_start: bool, return_slot_id: i64):
        """Translate a block terminator through its indexed MirBlock owner."""
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] terminator:entry index={block_index}"
        val block = blocks[block_index]
        val term = block.terminator
        if bootstrap_debug:
            print "[mir-to-llvm] terminator:kind index={block_index}"
        match term:
            case Ret(_):
                val ret_kind = blocks[block_index].bootstrap_ret_kind()
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:ret-scalar-kind index={block_index} kind={ret_kind}"
                    print "[mir-to-llvm] terminator:ret-threaded-type index={block_index} type={return_type_text}"
                    print "[mir-to-llvm] terminator:ret-threaded-status index={block_index} start={is_start} return_slot={return_slot_id}"
                if ret_kind == 0:
                    if return_type_text == "void":
                        self.builder.emit_ret_void()
                    else:
                        self.builder.emit_ret(return_type_text, self.ret_value_for_type(return_type_text, "0"))
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-nil"
                elif ret_kind == 1 or ret_kind == 2:
                    val packed_return_local = blocks[block_index].bootstrap_ret_local_id()
                    val return_local_id = if packed_return_local > 0xFFFFFFFF:
                        rt_value_as_int(packed_return_local & 0xFFFFFFFF)
                    else:
                        packed_return_local
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:ret-scalar-local index={block_index} raw={packed_return_local} local={return_local_id}"
                    val requires_fallback = return_local_id == return_slot_id or not self.local_types.has(return_local_id) or not self.defined_locals.has(return_local_id)
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:ret-threaded-fallback index={block_index} required={requires_fallback}"
                    if is_start:
                        self.builder.emit("  unreachable")
                        if bootstrap_debug:
                            print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-start"
                    elif requires_fallback:
                        self.builder.emit_ret(return_type_text, self.ret_value_for_type(return_type_text, "0"))
                        if bootstrap_debug:
                            print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-fallback"
                    else:
                        val val_str = "%l{return_local_id}"
                        if bootstrap_debug:
                            print "[mir-to-llvm] terminator:ret-threaded-value index={block_index} value={val_str}"
                        # The function ABI is authoritative at Ret -- but
                        # nothing upstream actually materializes the cast this
                        # edge assumed, so emit it here. Without it a returned
                        # local whose LLVM type differs from the ABI type is
                        # spliced in raw and llc rejects the module
                        # ("'%lN' defined with type 'i1' but expected 'i64'").
                        # value_as_type re-reads the value's registered type
                        # from value_types (translate_load registers it), so
                        # it sees the load's ACTUAL type, not the stale
                        # declared one, and is a no-op when they agree.
                        val ret_ty = self.valid_llvm_type(return_type_text)
                        val ret_src_ty = self.get_local_type(return_local_id)
                        val ret_src_unsigned = if self.unsigned_locals.contains_key(return_local_id): self.unsigned_locals[return_local_id] else: false
                        if bootstrap_debug:
                            print "[mir-to-llvm] terminator:ret-threaded-abi index={block_index} type={ret_ty} value={val_str} src={ret_src_ty}"
                        val ret_val = self.value_as_type_signed(val_str, ret_src_ty, ret_ty, ret_src_unsigned)
                        self.builder.emit_ret(ret_ty, ret_val)
                        if bootstrap_debug:
                            print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-local"
                elif ret_kind == 3:
                    val const_kind = blocks[block_index].bootstrap_ret_const_kind()
                    val const_text = blocks[block_index].bootstrap_ret_const_scalar_text()
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:ret-scalar-const index={block_index} kind={const_kind}"
                    var const_value_text = const_text
                    if const_kind == 4:
                        val global_name = self.add_string_global(const_text)
                        val str_len = const_text.len() + 1
                        val nit = self.native_int()
                        const_value_text = "getelementptr inbounds ([{str_len} x i8], ptr {global_name}, {nit} 0, {nit} 0)"
                    val ret_ty = self.valid_llvm_type(return_type_text)
                    self.builder.emit_ret(ret_ty, self.ret_value_for_type(ret_ty, const_value_text))
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-const"
                else:
                    self.builder.emit("  unreachable")
                    if bootstrap_debug:
                        print "[mir-to-llvm] terminator:emit index={block_index} variant=ret-invalid"

            case Goto(target):
                val target_id = target.bootstrap_value()
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:goto index={block_index} target={target_id}"
                self.builder.emit_br("bb{target_id}")
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=goto"

            case If(cond, then_, else_):
                val cond_operands: [MirOperand] = [cond]
                val then_id = then_.bootstrap_value()
                val else_id = else_.bootstrap_value()
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:if index={block_index} then={then_id} else={else_id}"
                val cond_val = self.translate_operand_at(cond_operands, 0)
                # The EMITTED value's registered type wins over the MIR-declared
                # one: once loads carry their alloca slot's element type, a cond
                # whose MIR type still says `ptr` can already be an `i1` value,
                # and the ptr arm below then emits `icmp ne ptr %lN, null`
                # against an i1 -- rejected by llc. Same contains_key + index
                # read idiom value_as_type uses against value_types.
                var cond_ty = self.valid_llvm_type(self.get_operand_type_at(cond_operands, 0))
                if self.value_types.contains_key(cond_val):
                    cond_ty = self.valid_llvm_type(self.value_types[cond_val])
                if cond_ty == "i1":
                    # Already boolean, use directly
                    self.builder.emit_cond_br(cond_val, "bb{then_id}", "bb{else_id}")
                elif cond_ty == "ptr":
                    val i1_cond = self.builder.fresh_local()
                    self.builder.emit("  {i1_cond} = icmp ne ptr {cond_val}, null")
                    self.builder.emit_cond_br(i1_cond, "bb{then_id}", "bb{else_id}")
                else:
                    val i1_cond = self.builder.fresh_local()
                    self.builder.emit("  {i1_cond} = icmp ne {cond_ty} {cond_val}, 0")
                    self.builder.emit_cond_br(i1_cond, "bb{then_id}", "bb{else_id}")
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=if"

            case Switch(value, targets, default):
                val value_operands: [MirOperand] = [value]
                val discr_raw = self.translate_operand_at(value_operands, 0)
                val nit = self.native_int()
                # emit_switch always types the discriminant as the native int,
                # so coerce rather than assume: a discriminant loaded from an
                # i1/i8 slot now carries that narrower type and would make
                # `switch {nit} %lN` ill-typed. value_as_type re-reads the
                # value's registered type and is a no-op when it already
                # matches.
                val discr_val = self.value_as_type(discr_raw, self.get_operand_type_at(value_operands, 0), nit)
                val default_id = default.bootstrap_value()
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:switch index={block_index} default={default_id} cases={targets.len()}"
                var cases: [(text, text)] = []
                var target_i = 0
                while target_i < targets.len():
                    val switch_case = targets[target_i]
                    val case_value = "{switch_case.bootstrap_value()}"
                    val case_label = "bb{switch_case.bootstrap_target_value()}"
                    cases = cases.push((case_value, case_label))
                    target_i = target_i + 1
                self.builder.emit_switch(discr_val, nit, "bb{default_id}", cases)
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=switch"

            case Unreachable:
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:unreachable index={block_index}"
                self.builder.emit("  unreachable")
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=unreachable"

            case Abort(message):
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:abort index={block_index}"
                self.emit_unsupported_panic(message)
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=abort"

            case CallTerminator(dest, func, args, normal, unwind):
                val func_operands: [MirOperand] = [func]
                val normal_id = normal.bootstrap_value()
                val has_unwind = unwind != nil
                val unwind_id = if has_unwind: (unwind ?? BlockId(id: 0)).bootstrap_value() else: 0
                val has_dest = dest != nil
                val dest_id = if has_dest: (dest ?? LocalId(id: 0)).id else: 0
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:call index={block_index} dest={has_dest} normal={normal_id} unwind={has_unwind}"
                var func_val = self.translate_operand_at(func_operands, 0)
                match func.kind:
                    case Copy(local) | Move(local):
                        func_val = self.value_as_type(func_val, self.get_operand_type_at(func_operands, 0), "ptr")
                    case _:
                        ()
                val call_func_val = self.normalize_call_callee(func_val)
                var arg_vals: [text] = []
                var arg_i = 0
                var arg_index = 0
                while arg_index < args.len():
                    var arg_val = self.translate_operand_at(args, arg_index)
                    var arg_ty = self.valid_llvm_type(self.get_operand_type_at(args, arg_index))
                    val param_ty = self.lookup_function_param_type(call_func_val, arg_i)
                    if param_ty != "" and param_ty != nil:
                        # See translate_call: print()'s raw-format runtime
                        # helpers need signedness-aware widening.
                        val is_print_raw_fmt = call_func_val == "@rt_raw_i64_to_string" or call_func_val == "@rt_raw_u64_to_string" or call_func_val == "@rt_raw_bool_to_string"
                        if is_print_raw_fmt:
                            arg_val = self.value_as_type_signed(arg_val, arg_ty, param_ty, self.get_operand_unsigned_at(args, arg_index))
                        else:
                            arg_val = self.value_as_type(arg_val, arg_ty, param_ty)
                        arg_ty = self.valid_llvm_type(param_ty)
                    elif arg_val == "0":
                        arg_val = self.ret_value_for_type(arg_ty, "0")
                    arg_vals = arg_vals.push("{arg_ty} {arg_val}")
                    arg_i = arg_i + 1
                    arg_index = arg_index + 1
                val args_str = arg_vals.join(", ")
                if has_dest:
                    val dest_name = self.get_local(dest_id)
                    val ret_ty = self.valid_llvm_type(self.get_local_type(dest_id))
                    if has_unwind:
                        self.builder.emit("  {dest_name} = invoke {ret_ty} {call_func_val}({args_str}) to label %bb{normal_id} unwind label %bb{unwind_id}")
                    else:
                        self.builder.emit("  {dest_name} = call {ret_ty} {call_func_val}({args_str})")
                        self.builder.emit_br("bb{normal_id}")
                else:
                    if has_unwind:
                        self.builder.emit("  invoke void {call_func_val}({args_str}) to label %bb{normal_id} unwind label %bb{unwind_id}")
                    else:
                        self.builder.emit("  call void {call_func_val}({args_str})")
                        self.builder.emit_br("bb{normal_id}")
                if bootstrap_debug:
                    print "[mir-to-llvm] terminator:emit index={block_index} variant=call"

    # === Required: per-category instruction methods ===

    me translate_const(dest: LocalId, value: MirConstValue, ty: MirType):
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        # SSA rewrites create fresh destinations that have no MirLocal entry.
        # For those, get_local_type falls back to native int and can poison a
        # pointer constant before its Store into an alloca slot.  The Const
        # instruction's own type is authoritative until a local is registered.
        val llvm_ty = if self.local_types.has(dest_id):
            self.valid_llvm_type(self.get_local_type(dest_id))
        else:
            self.valid_llvm_type(self.llvm_type_text(ty))
        self.local_types[dest_id] = llvm_ty
        self.value_types[dest_name] = llvm_ty
        self.defined_locals[dest_id] = true

        match value:
            case Int(v):
                self.builder.emit("  {dest_name} = add {llvm_ty} {v}, 0  ; const int")
            case Float(v):
                # -0.0 sign fix: `fadd fv, 0.0` flips a literal -0.0 to
                # +0.0 (opposite-signed zero addition rounds to +0.0);
                # `fadd fv, -0.0` is value-identical for every other float
                # (nonzero finite/inf/nan unaffected by adding either
                # signed zero) and additionally preserves -0.0's sign.
                val fv = ensure_float_literal("{v}")
                self.builder.emit("  {dest_name} = fadd {llvm_ty} {fv}, -0.0  ; const float")
            case Bool(v):
                val bval = if v: "1" else: "0"
                # Only register as an i1 bool-local when the emitted value IS
                # i1: an i64-typed Bool const (module-`val` inline) otherwise
                # gets branched as bare `br i1 %lN` while its value was
                # emitted as i64 (llc "'%lN' defined with type 'i64' but
                # expected 'i1'", native_module_val_globals 2026-07-23).
                if llvm_ty == "i1":
                    self.bool_locals[dest_id] = true
                self.builder.emit("  {dest_name} = add {llvm_ty} {bval}, 0  ; const bool")
            case Str(v):
                # A `Const(Str(name), FuncPtr(..))` INSTRUCTION is a function
                # reference (a top-level fn named as a value: struct-literal
                # field `Op(f: double)`, `val g = double`), the same shape the
                # operand renderer below already maps to `@name`. Emitting it
                # as a string literal stored the address of "double\0" and the
                # later indirect call jumped into .rodata (SIGSEGV). Bug
                # stage1_lexer_hir_fatals_eprint_and_generic_len_helper_2026-08-22.
                val is_fn_ref = match ty.kind:
                    case FuncPtr(_): true
                    case Function(_, _): true
                    case _: false
                if is_fn_ref:
                    val fn_operand = MirOperand(kind: MirOperandKind.Const(value, ty))
                    val fn_ref = self.translate_operand(fn_operand)
                    val nit_fn = self.native_int()
                    self.mark_ptr_local(dest_id)
                    self.builder.emit("  {dest_name} = getelementptr i8, ptr {fn_ref}, {nit_fn} 0  ; fn ref")
                else:
                    val global_name = self.add_string_global(v)
                    val str_len = escaped_string_byte_len(v) + 1
                    val nit = self.native_int()
                    self.mark_ptr_local(dest_id)
                    self.builder.emit("  {dest_name} = getelementptr inbounds [{str_len} x i8], ptr {global_name}, {nit} 0, {nit} 0  ; string const")
            case Zero:
                if is_float_type(llvm_ty):
                    self.builder.emit("  {dest_name} = fadd {llvm_ty} 0.0, 0.0  ; const zero")
                elif llvm_ty == "ptr":
                    self.mark_ptr_local(dest_id)
                    val nit = self.native_int()
                    self.builder.emit("  {dest_name} = inttoptr {nit} 0 to ptr  ; const null")
                elif llvm_ty == "void":
                    ()
                else:
                    self.builder.emit("  {dest_name} = add {llvm_ty} 0, 0  ; const zero")
            case Array(elements):
                val tmp = self.builder.fresh_local()
                self.builder.emit_alloca(tmp, llvm_ty)
                self.builder.emit_store(llvm_ty, "zeroinitializer", tmp)
                self.builder.emit_load(dest_name, llvm_ty, tmp)
            case Tuple(elements):
                val tmp = self.builder.fresh_local()
                self.builder.emit_alloca(tmp, llvm_ty)
                self.builder.emit_store(llvm_ty, "zeroinitializer", tmp)
                self.builder.emit_load(dest_name, llvm_ty, tmp)
            case Struct(fields):
                val tmp = self.builder.fresh_local()
                self.builder.emit_alloca(tmp, llvm_ty)
                self.builder.emit_store(llvm_ty, "zeroinitializer", tmp)
                self.builder.emit_load(dest_name, llvm_ty, tmp)

    me translate_copy_move(dest: LocalId, src: LocalId, is_move: bool):
        val dest_id = self.local_id_value(dest)
        val src_id = self.local_id_value(src)
        # The Copy fast path in translate_instruction_at (disc-guarded
        # pre-dispatch) `return`s before the trailing
        # `mark_instruction_dest_defined_at(...)` call ever runs, so a Copy
        # destination was never recorded in `defined_locals`. Returning such a
        # local (`val y = a + 1` then `return y` / bare tail `y`) then tripped
        # translate_terminator's not-defined zero fallback and emitted
        # `ret <ty> 0`. Mark it here, at the value-defining site, so both the
        # fast path and the Move arm agree.
        self.defined_locals[dest_id] = true
        val dest_name = self.get_local(dest_id)
        val src_name = self.local_value_text(src_id)
        # Bug #149: `get_local_type` checks the STICKY `ptr_locals`/
        # `bool_locals` flags before `local_types`. Those flags are set once,
        # upfront, from every local's MIR-DECLARED type (translate_function's
        # priming loop) and are never cleared -- but `translate_call` can
        # later overwrite `local_types[id]` alone (without clearing a stale
        # ptr_locals[id]) when the callee's REGISTERED return type disagrees
        # with the priming guess. This happens for `rt_array_repeat`
        # (`[value; count]` fill literals): its MIR-declared destination type
        # is Array (-> "ptr" priming), but the function itself has no static
        # extern override and falls back to the generic `i64 @name(...)`
        # auto-declare, so the actual call is emitted as `i64` -- leaving
        # ptr_locals[id]=true while local_types[id]=="i64". Re-deriving `ty`
        # via `get_local_type` here then trusted the stale "ptr" flag and
        # emitted `getelementptr i8, ptr %lN, ...` against an i64-defined
        # %lN -- invalid IR, llc rejection ("defined with type 'i64' but
        # expected 'ptr'") on any `[""; N]` / `[0; N]` fill-literal use.
        #
        # `local_types[src_id]` is the freshest type actually assigned at
        # the source's definition site (every value-defining instruction,
        # including translate_call's override, writes it), so prefer it when
        # present; only fall back to the sticky flags via `get_local_type`
        # when local_types has no entry to consult.
        # contains_key + index read, never `.get()`.
        # See doc/07_guide/language/dict_native_pitfalls.md
        val has_recorded_src_ty = self.local_types.contains_key(src_id)
        var ty = if has_recorded_src_ty and self.local_types[src_id] != nil and self.local_types[src_id] != "nil" and self.local_types[src_id] != "":
            self.valid_llvm_type(self.local_types[src_id])
        else:
            self.valid_llvm_type(self.get_local_type(src_id))
        # Bug (nested-array/dict handle unbox): a destination local PRIMED
        # ptr-classified at function entry (its MIR-declared type is an
        # aggregate -- Array/Dict/Struct/etc -- e.g. decode_runtime_value's
        # `b.new_temp(result_type)` for a nested array/dict element read off
        # an ANY-boxed outer array, `m[i]` where `m` is `[[i64]]`) can receive
        # a Copy whose SOURCE is a raw i64 (the untyped tagged-handle return
        # of rt_array_get/rt_dict_get). The scalar-copy path below emits a
        # plain `add i64 src, 0`, defining the destination as i64 in the LLVM
        # text -- but `get_local_type` (below) trusts the STICKY `ptr_locals`
        # priming flag (never cleared here) and reports "ptr" to every OTHER
        # consumer, e.g. a later `rt_array_len(m[i])` bounds-check callsite.
        # That produced an invalid "%lN defined with type 'i64' but expected
        # 'ptr'" llc rejection on any nested array-of-arrays/dict-of-arrays
        # read or write (`m[0][1]`, 2D array literals). Since the destination
        # IS semantically a pointer (an array/dict/struct handle unboxed from
        # its i64 ANY slot), bridge with a genuine `inttoptr` reinterpretation
        # instead of i64 arithmetic, so the SSA definition's real LLVM type
        # matches what ptr_locals promises downstream.
        if ty != "ptr" and is_integer_type(ty) and self.ptr_locals.has(dest_id):
            self.local_types[dest_id] = "ptr"
            self.value_types[dest_name] = "ptr"
            self.builder.emit("  {dest_name} = inttoptr {ty} {src_name} to ptr  ; {if is_move: \"move\" else: \"copy\"} (handle unbox)")
            return
        if ty == "ptr":
            self.local_types[dest_id] = "ptr"
            self.ptr_locals[dest_id] = true
        if ty == "i1":
            self.local_types[dest_id] = "i1"
            self.bool_locals[dest_id] = true
        val comment = if is_move: "move" else: "copy"
        self.value_types[dest_name] = ty
        # Register by id too: copy dests created by the var_reassign_ssa pass
        # have no MirLocal entry, so a later get_local_type/get_operand_type on
        # them would fall back to i64 (e.g. typing an f64 Store as i64).
        self.local_types[dest_id] = ty
        # Propagate the unsigned bit too (see is_unsigned_mir_kind /
        # get_operand_unsigned): `val x: u32 = <cast/binop>` lowers to the
        # producing instruction writing a temp, then a Copy/Move of that
        # temp into x's named local. Without this, x's own unsigned_locals
        # entry stays unset (default false/signed) even though its source
        # temp was correctly marked unsigned, and a later print(x) would
        # sign-extend a high-bit-set unsigned value incorrectly.
        if not self.unsigned_locals.has(dest_id):
            if self.unsigned_locals.has(src_id):
                self.unsigned_locals[dest_id] = self.unsigned_locals[src_id]

        if is_float_type(ty):
            # -0.0 sign fix: see translate_cast_float_signsafe above for
            # the full rationale -- `fadd x, -0.0` is the bit-preserving
            # identity for every float value including negative zero,
            # whereas `fadd x, 0.0` silently rounds -0.0 to +0.0.
            self.builder.emit("  {dest_name} = fadd {ty} {src_name}, -0.0  ; {comment}")
        elif ty == "ptr":
            val nit = self.native_int()
            self.builder.emit("  {dest_name} = getelementptr i8, ptr {src_name}, {nit} 0  ; {comment}")
        elif ty == "void":
            ()
        elif is_integer_type(ty) or ty == "i1":
            self.builder.emit("  {dest_name} = add {ty} {src_name}, 0  ; {comment}")
        else:
            # Aggregate types: alloca + store + load
            val tmp = self.builder.fresh_local()
            self.builder.emit_alloca(tmp, ty)
            self.builder.emit_store(ty, src_name, tmp)
            self.builder.emit_load(dest_name, ty, tmp)

    me translate_binop(dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand):
        """Translate binary operation. Uses nsw for signed int arithmetic."""
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val left_raw = self.translate_operand(left)
        val right_raw = self.translate_operand(right)
        val ty = self.valid_llvm_type(self.get_local_type(dest_id))
        self.value_types[dest_name] = ty
        # When `ty` (the result's tracked width, e.g. i64 for an untyped
        # temp) is wider than an unsigned narrow operand's own width
        # (U8/U16/U32), the operand must zext into `ty`, not sext -- e.g.
        # 4294967289u32 (bit pattern of i32 -7) sign-extended to i64 gives
        # -7, and an unsigned 64-bit div by 2 of THAT then produces a huge
        # ~2^63 garbage result instead of the correct 2147483644. See
        # value_as_type_signed / is_unsigned_mir_kind.
        val bin_unsigned = self.get_operand_unsigned(left) or self.get_operand_unsigned(right)

        match op:
            case Add:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    self.builder.emit_fadd(dest_name, ty, left_val, right_val)
                elif is_signed_int_type(ty):
                    self.builder.emit_add_nsw(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_add(dest_name, ty, left_val, right_val)
            case Sub:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    self.builder.emit_fsub(dest_name, ty, left_val, right_val)
                elif is_signed_int_type(ty):
                    self.builder.emit_sub_nsw(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_sub(dest_name, ty, left_val, right_val)
            case Mul:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    self.builder.emit_fmul(dest_name, ty, left_val, right_val)
                elif is_signed_int_type(ty):
                    self.builder.emit_mul_nsw(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_mul(dest_name, ty, left_val, right_val)
            case Div:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    self.builder.emit_fdiv(dest_name, ty, left_val, right_val)
                elif self.get_operand_unsigned(left) or self.get_operand_unsigned(right):
                    # MIR-level U8/U16/U32/U64 operand: unsigned division
                    # (udiv), not sdiv -- e.g. 4294967289u32 / 2u32 must give
                    # 2147483644, not the sdiv result of treating the bit
                    # pattern as the negative i32 -7 (-7/2 == -3).
                    self.builder.emit_udiv(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_div(dest_name, ty, left_val, right_val)
            case Rem:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    self.builder.emit_frem(dest_name, ty, left_val, right_val)
                elif self.get_operand_unsigned(left) or self.get_operand_unsigned(right):
                    self.builder.emit_urem(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_rem(dest_name, ty, left_val, right_val)
            case Pow:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                if is_float_type(ty):
                    val fsuffix = if ty == "double": "f64" else: "f32"
                    self.builder.emit("  {dest_name} = call {ty} @llvm.pow.{fsuffix}({ty} {left_val}, {ty} {right_val})")
                else:
                    val nit = self.native_int()
                    self.builder.emit("  {dest_name} = call {nit} @__simple_pow({nit} {left_val}, {nit} {right_val})")
            case BitAnd:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                self.builder.emit_and(dest_name, ty, left_val, right_val)
            case BitOr:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                self.builder.emit_or(dest_name, ty, left_val, right_val)
            case BitXor:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                self.builder.emit_xor(dest_name, ty, left_val, right_val)
            case Shl:
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, bin_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, bin_unsigned)
                self.builder.emit_shl(dest_name, ty, left_val, right_val)
            case Shr:
                val left_unsigned = self.get_operand_unsigned(left)
                val right_unsigned = self.get_operand_unsigned(right)
                val left_val = self.value_as_type_signed(left_raw, self.get_operand_type(left), ty, left_unsigned)
                val right_val = self.value_as_type_signed(right_raw, self.get_operand_type(right), ty, right_unsigned)
                if left_unsigned:
                    self.builder.emit_lshr(dest_name, ty, left_val, right_val)
                else:
                    self.builder.emit_ashr(dest_name, ty, left_val, right_val)
            case Eq:
                val eq_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val eq_pred = if is_float_type(eq_cmp_ty): "oeq" else: "eq"
                val eq_left = self.value_as_type(left_raw, self.get_operand_type(left), eq_cmp_ty)
                val eq_right = self.value_as_type(right_raw, self.get_operand_type(right), eq_cmp_ty)
                self.emit_comparison(dest_name, ty, eq_pred, eq_cmp_ty, eq_left, eq_right)
            case Ne:
                val ne_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val ne_pred = if is_float_type(ne_cmp_ty): "one" else: "ne"
                val ne_left = self.value_as_type(left_raw, self.get_operand_type(left), ne_cmp_ty)
                val ne_right = self.value_as_type(right_raw, self.get_operand_type(right), ne_cmp_ty)
                self.emit_comparison(dest_name, ty, ne_pred, ne_cmp_ty, ne_left, ne_right)
            case Lt:
                val lt_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val lt_unsigned = self.get_operand_unsigned(left) or self.get_operand_unsigned(right)
                val lt_pred = if is_float_type(lt_cmp_ty): "olt" elif lt_unsigned: "ult" else: "slt"
                val lt_left = self.value_as_type(left_raw, self.get_operand_type(left), lt_cmp_ty)
                val lt_right = self.value_as_type(right_raw, self.get_operand_type(right), lt_cmp_ty)
                self.emit_comparison(dest_name, ty, lt_pred, lt_cmp_ty, lt_left, lt_right)
            case Le:
                val le_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val le_unsigned = self.get_operand_unsigned(left) or self.get_operand_unsigned(right)
                val le_pred = if is_float_type(le_cmp_ty): "ole" elif le_unsigned: "ule" else: "sle"
                val le_left = self.value_as_type(left_raw, self.get_operand_type(left), le_cmp_ty)
                val le_right = self.value_as_type(right_raw, self.get_operand_type(right), le_cmp_ty)
                self.emit_comparison(dest_name, ty, le_pred, le_cmp_ty, le_left, le_right)
            case Gt:
                val gt_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val gt_unsigned = self.get_operand_unsigned(left) or self.get_operand_unsigned(right)
                val gt_pred = if is_float_type(gt_cmp_ty): "ogt" elif gt_unsigned: "ugt" else: "sgt"
                val gt_left = self.value_as_type(left_raw, self.get_operand_type(left), gt_cmp_ty)
                val gt_right = self.value_as_type(right_raw, self.get_operand_type(right), gt_cmp_ty)
                self.emit_comparison(dest_name, ty, gt_pred, gt_cmp_ty, gt_left, gt_right)
            case Ge:
                val ge_cmp_ty = self.valid_llvm_type(self.get_operand_type(left))
                val ge_unsigned = self.get_operand_unsigned(left) or self.get_operand_unsigned(right)
                val ge_pred = if is_float_type(ge_cmp_ty): "oge" elif ge_unsigned: "uge" else: "sge"
                val ge_left = self.value_as_type(left_raw, self.get_operand_type(left), ge_cmp_ty)
                val ge_right = self.value_as_type(right_raw, self.get_operand_type(right), ge_cmp_ty)
                self.emit_comparison(dest_name, ty, ge_pred, ge_cmp_ty, ge_left, ge_right)
            case MatMul:
                self.emit_unsupported_panic("LLVM backend does not support MatMul lowering")
            case BroadcastAdd:
                self.emit_unsupported_panic("LLVM backend does not support BroadcastAdd lowering")
            case BroadcastSub:
                self.emit_unsupported_panic("LLVM backend does not support BroadcastSub lowering")
            case BroadcastMul:
                self.emit_unsupported_panic("LLVM backend does not support BroadcastMul lowering")
            case BroadcastDiv:
                self.emit_unsupported_panic("LLVM backend does not support BroadcastDiv lowering")
            case BroadcastPow:
                self.emit_unsupported_panic("LLVM backend does not support BroadcastPow lowering")
            case Offset:
                val nit = self.native_int()
                val left_val = self.value_as_type(left_raw, self.get_operand_type(left), "ptr")
                val right_val = self.value_as_type(right_raw, self.get_operand_type(right), nit)
                self.builder.emit("  {dest_name} = getelementptr i8, ptr {left_val}, {nit} {right_val}")

    me translate_unaryop(dest: LocalId, op: MirUnaryOp, operand: MirOperand):
        """Translate unary operation."""
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val operand_val = self.translate_operand(operand)
        val ty = self.valid_llvm_type(self.get_local_type(dest_id))

        match op:
            case Neg:
                val cast_operand = self.value_as_type(operand_val, self.get_operand_type(operand), ty)
                if is_float_type(ty):
                    self.builder.emit_fneg(dest_name, ty, cast_operand)
                else:
                    self.builder.emit_neg(dest_name, ty, cast_operand)
            case Not:
                # #148: emit_icmp_eq alone always produces an i1 SSA value
                # (LLVM `icmp` results are always i1), but `dest` here was
                # requested with MIR type i64 (expr_dispatch's Unary lowering
                # always asks for MirType.i64()) and nothing downstream
                # widened it -- so a later consumer referencing dest_name as
                # i64 (e.g. the `and`/`or` combiner, or an `if` condition's
                # `!= 0` check) hit a genuine LLVM type mismatch ("defined
                # with type 'i1' but expected 'i64'"). Route through
                # emit_comparison (same helper translate_binop's Eq/Ne cases
                # use) so the i1 compare result is zext'd up to `ty` whenever
                # dest isn't itself i1.
                val cmp_ty = self.valid_llvm_type(self.get_operand_type(operand))
                val cmp_operand = self.value_as_type(operand_val, self.get_operand_type(operand), cmp_ty)
                val rhs = if cmp_ty == "ptr": "null" else: "0"
                self.emit_comparison(dest_name, ty, "eq", cmp_ty, cmp_operand, rhs)
            case BitNot:
                val cast_operand = self.value_as_type(operand_val, self.get_operand_type(operand), ty)
                self.builder.emit_not(dest_name, ty, cast_operand)
            case Transpose:
                self.emit_unsupported_panic("LLVM backend does not support Transpose lowering")

    me translate_call_at(instructions: [MirInst], index: i64, ir_handle: i64):
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] call:entry index={index}"
        val inst: MirInst = instructions[index]
        var dest: LocalId? = nil
        var func = mir_operand_const_int(0)
        var args: [MirOperand] = []
        match inst.kind:
            case Call(found_dest, found_func, found_args):
                dest = found_dest
                func = found_func
                args = found_args
            case _:
                return
        if bootstrap_debug:
            print "[mir-to-llvm] call:matched index={index}"
        # Decay-safe optional access (NOT `match dest: case Some/nil`): the
        # seed's cross-module optional payloads can DECAY to the bare object
        # (LocalId, not Some(LocalId)) — a match then exhausts without
        # matching any arm ("invalid pattern ... object value LocalId").
        # `!= nil` and `??` handle both the wrapped and decayed shapes.
        val has_dest = dest != nil
        val dest_id = if has_dest: (dest ?? LocalId(id: 0)).id else: 0
        val dest_name = if has_dest: self.get_local(dest_id) else: ""
        if bootstrap_debug:
            print "[mir-to-llvm] call:dest index={index} present={has_dest}"
        val callee_operands: [MirOperand] = [func]
        var func_name = self.translate_operand_at(callee_operands, 0)
        if bootstrap_debug:
            print "[mir-to-llvm] call:callee index={index}"
        match func.kind:
            case Copy(local) | Move(local):
                func_name = self.value_as_type(func_name, self.get_operand_type_at(callee_operands, 0), "ptr")
            case _:
                ()
        val bare_name_for_call = if func_name.starts_with("@"): func_name[1:] else: func_name
        # Process-run externs: the .spl extern shape
        # (cmd as one text value, tuple-of-3 result) does not match the C
        # owners' seed ABI (cmd as ptr+len, SplArray* result with a tagged
        # int in slot 2) -- calling the seed symbol directly from generated
        # code misaligns every arg after cmd and misreads the result
        # (parity case process_run_timeout: SIGSEGV). Route to the
        # runtime_native.c *_tuple facades, which accept the tagged-or-raw
        # cmd text value and return the rt_alloc'd 3-word tuple block the
        # Tuple destructure loads expect (declares registered in
        # emit_runtime_declarations, asm_constraints_helpers.spl).
        var call_func_name = if bare_name_for_call == "get_args" or bare_name_for_call == "get_cli_args" or bare_name_for_call == "sys_get_args": "@rt_get_args" elif bare_name_for_call == "env_get": "@rt_env_get" elif bare_name_for_call == "rt_env_get" and args.len() == 1: "@rt_env_get_value" elif bare_name_for_call == "eprint": "@rt_eprint" elif bare_name_for_call == "rt_dict_insert": "@rt_dict_set" elif bare_name_for_call == "rt_process_run": "@rt_process_run_tuple" elif bare_name_for_call == "rt_process_run_bounded": "@rt_process_run_bounded_tuple" elif bare_name_for_call == "rt_process_run_inherit": "@rt_process_run_inherit_value" elif bare_name_for_call == "rt_process_spawn_guarded": "@rt_process_spawn_guarded_value" elif bare_name_for_call == "rt_process_run_timeout": "@rt_process_run_timeout_tuple" else: func_name
        call_func_name = self.normalize_call_callee(call_func_name)
        var arg_parts: [text] = []
        var arg_tys: [text] = []
        var arg_i = 0
        while arg_i < args.len():
            if bootstrap_debug:
                print "[mir-to-llvm] call:arg-before index={index} arg={arg_i}"
            val arg = args[arg_i]
            var arg_val = self.translate_operand_at(args, arg_i)
            val maybe_arg_ty = self.get_operand_type_at(args, arg_i)
            var arg_ty = self.valid_llvm_type(maybe_arg_ty)
            match arg.kind:
                case Copy(local) | Move(local):
                    if self.bool_locals.has(local.id):
                        arg_ty = "i1"
                    if self.ptr_locals.has(local.id):
                        arg_ty = "ptr"
                case _:
                    ()
            val param_ty = self.lookup_function_param_type(call_func_name, arg_i)
            if param_ty != "" and param_ty != nil:
                # print()'s raw-format runtime helpers (lower_bootstrap_print_call
                # in switch_operators_calls.spl) route every numeric type --
                # signed AND unsigned -- through the same i64-formatting
                # callee. A narrower-than-i64 arg must widen with the
                # *source's* signedness (sext for i8/i16/i32, zext for
                # u8/u16/u32), not the callee's, or a negative signed value
                # prints as its unsigned bit pattern (i32 -5 -> 4294967291).
                val is_print_raw_fmt = call_func_name == "@rt_raw_i64_to_string" or call_func_name == "@rt_raw_u64_to_string" or call_func_name == "@rt_raw_bool_to_string"
                if call_func_name == "@rt_enum_new" and arg_i == 2 and arg_ty == "double":
                    arg_val = self.store_field_bits(arg_val, arg_ty, param_ty)
                elif is_print_raw_fmt:
                    arg_val = self.value_as_type_signed(arg_val, arg_ty, param_ty, self.get_operand_unsigned_at(args, arg_i))
                else:
                    arg_val = self.value_as_type(arg_val, arg_ty, param_ty)
                arg_ty = self.valid_llvm_type(param_ty)
            elif arg_val == "0":
                arg_val = self.ret_value_for_type(arg_ty, "0")
            arg_parts = arg_parts.push("{arg_ty} {arg_val}")
            arg_tys = arg_tys.push(arg_ty)
            if bootstrap_debug:
                print "[mir-to-llvm] call:arg-after index={index} arg={arg_i} type={arg_ty}"
            arg_i = arg_i + 1
        val args_str = arg_parts.join(", ")
        # Reconcile arg count with the callee's declared parameter count. If a
        # method/short-form call reaches the backend with an argument count that
        # differs from the callee's `declare`d params, a bare `call @f(args)` is
        # rejected by llc ("Incorrect number of arguments passed to called
        # function"). Emitting an EXPLICIT function-type signature —
        # `call RET (argtys) @f(args)` — keeps the call well-formed regardless
        # (the callee is treated as a typed pointer): the IR-text equivalent of
        # the seed backend's indirect-call reconciliation. Only engages on a
        # KNOWN mismatch, so every matching call is emitted exactly as before.
        var call_sig = ""
        val declared_param_count = self.lookup_function_param_count(call_func_name)
        if declared_param_count >= 0 and declared_param_count != args.len():
            call_sig = "({arg_tys.join(\", \")}) "
        if has_dest:
                val name = dest_name
                var ret_ty = self.valid_llvm_type(self.get_local_type(dest_id))
                var known_ret_ty = self.lookup_function_return_type(call_func_name)
                if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    val bare_func_name = if call_func_name.starts_with("@"): call_func_name[1:] else: call_func_name
                    if bare_func_name == "get_args" or bare_func_name == "get_cli_args" or bare_func_name == "bootstrap_version" or bare_func_name == "bootstrap_output_from_args":
                        known_ret_ty = "ptr"
                    elif bare_func_name == "rt_get_args":
                        known_ret_ty = "ptr"
                    elif bare_func_name == "rt_array_get":
                        # Bootstrap array element accessor returns a tagged handle
                        # (ptr), matching `declare ptr @rt_array_get(ptr, i64)`.
                        known_ret_ty = "ptr"
                    elif bare_func_name == "env_get" or bare_func_name == "rt_env_get":
                        known_ret_ty = "ptr"
                    elif bare_func_name == "eprint":
                        known_ret_ty = "void"
                if known_ret_ty != "" and known_ret_ty != "nil" and known_ret_ty != "void":
                    ret_ty = known_ret_ty
                    self.local_types[dest_id] = ret_ty
                    if ret_ty == "ptr":
                        self.ptr_locals[dest_id] = true
                    if ret_ty == "i1":
                        self.bool_locals[dest_id] = true
                ret_ty = self.valid_llvm_type(ret_ty)
                self.value_types[name] = ret_ty
                # A narrower-than-i64 unsigned return (e.g. `fn f() -> u8`)
                # must be tracked so a later print(f()) zext's instead of
                # sext's. See is_unsigned_mir_kind / lookup_function_return_unsigned.
                self.unsigned_locals[dest_id] = self.lookup_function_return_unsigned(call_func_name)
                val call_line = "  {name} = call {ret_ty} {call_sig}{call_func_name}({args_str})"
                if ir_handle >= 0:
                    val emitted_call = "\n{call_line}"
                    rt_string_builder_push(ir_handle, emitted_call)
                else:
                    self.builder.emit(call_line)
        else:
            val call_line = "  call void {call_sig}{call_func_name}({args_str})"
            if ir_handle >= 0:
                val emitted_call = "\n{call_line}"
                rt_string_builder_push(ir_handle, emitted_call)
            else:
                self.builder.emit(call_line)
        if bootstrap_debug:
            print "[mir-to-llvm] call:emit index={index} present={has_dest}"

    # === Required: helpers ===

    me llvm_type_text_at(types: [MirType], index: i64) -> text:
        val ty = types[index]
        match ty.kind:
            case MirTypeKind.I64 | MirTypeKind.U64: "i64"
            case MirTypeKind.I32 | MirTypeKind.U32 | MirTypeKind.Char: "i32"
            case MirTypeKind.I16 | MirTypeKind.U16: "i16"
            case MirTypeKind.I8 | MirTypeKind.U8: "i8"
            case MirTypeKind.F64: "double"
            case MirTypeKind.F32: "float"
            case MirTypeKind.Bool: "i1"
            case MirTypeKind.Unit | MirTypeKind.Never: "void"
            case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, _) | MirTypeKind.FuncPtr(_) | MirTypeKind.Function(_, _) | MirTypeKind.Opaque(_): "ptr"
            case MirTypeKind.Struct(_) | MirTypeKind.Enum(_) | MirTypeKind.Tuple(_) | MirTypeKind.Array(_, _) | MirTypeKind.Dict(_, _) | MirTypeKind.Slice(_) | MirTypeKind.Union(_): "ptr"
            case MirTypeKind.Promise(_) | MirTypeKind.Generator(_, _) | MirTypeKind.ActorType(_): "ptr"
            case _: self.native_int_type

    me translate_operand_at(operands: [MirOperand], index: i64) -> text:
        val operand = operands[index]
        match operand.kind:
            case Copy(local) | Move(local):
                self.local_value_text(local.id)
            case Const(const_val, const_ty):
                match const_ty.kind:
                    case FuncPtr(signature):
                        match const_val:
                            case Str(name):
                                val resolved = self.llvm_function_symbol_name(name)
                                val return_types: [MirType] = [signature.return_type]
                                self.remember_function_return_type(resolved, self.llvm_type_text_at(return_types, 0))
                                self.unknown_func_decls[resolved] = true
                                "@{resolved}"
                            case _: self.translate_const_operand_at(operands, index)
                    case Function(_, ret):
                        match const_val:
                            case Str(name):
                                val resolved = self.llvm_function_symbol_name(name)
                                val return_types: [MirType] = [ret]
                                self.remember_function_return_type(resolved, self.llvm_type_text_at(return_types, 0))
                                self.unknown_func_decls[resolved] = true
                                "@{resolved}"
                            case _: self.translate_const_operand_at(operands, index)
                    case _: self.translate_const_operand_at(operands, index)

    me translate_const_operand_at(operands: [MirOperand], index: i64) -> text:
        val operand = operands[index]
        match operand.kind:
            case Const(value, _):
                match value:
                    case Int(v): "{v}"
                    case Float(v): "{v}"
                    case Bool(v): if v: "1" else: "0"
                    case Str(v):
                        val global_name = self.add_string_global(v)
                        val str_len = v.len() + 1
                        val nit = self.native_int()
                        "getelementptr inbounds ([{str_len} x i8], ptr {global_name}, {nit} 0, {nit} 0)"
                    case Zero: "0"
                    case Array(elements): "zeroinitializer  ; array ({elements.len()} elements)"
                    case Tuple(elements): "zeroinitializer  ; tuple ({elements.len()} elements)"
                    case Struct(_): "zeroinitializer  ; struct"
            case _: "0"

    me get_operand_type_at(operands: [MirOperand], index: i64) -> text:
        val operand = operands[index]
        match operand.kind:
            case Copy(local) | Move(local): self.get_local_type(local.id)
            case Const(_, const_ty):
                val types: [MirType] = [const_ty]
                self.llvm_type_text_at(types, 0)
            case _: self.native_int()

    me get_operand_unsigned_at(operands: [MirOperand], index: i64) -> bool:
        val operand = operands[index]
        match operand.kind:
            case Copy(local) | Move(local):
                if self.unsigned_locals.contains_key(local.id): self.unsigned_locals[local.id] else: false
            case Const(_, type_):
                match type_.kind:
                    case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: true
                    case _: false
            case _: false

    me translate_operand(operand: MirOperand) -> text:
        """Translate MIR operand to LLVM value."""
        match operand.kind:
            case Copy(local):
                val local_id = self.local_id_value(local)
                self.local_value_text(local_id)
            case Move(local):
                val local_id = self.local_id_value(local)
                self.local_value_text(local_id)
            case Const(const_val, const_ty):
                # For function references, return @name directly. An
                # ordinary named call (this path) must resolve to a
                # colliding LOCAL definition's mangled symbol, not the bare
                # runtime name a compiler-generated hardcoded call owns --
                # see mir_call_ownership.spl / llvm_function_symbol_name.
                match const_ty.kind:
                    case FuncPtr(signature):
                        match const_val:
                            case Str(name):
                                val resolved = self.llvm_function_symbol_name(name)
                                if signature.return_type != nil:
                                    self.remember_function_return_type(resolved, self.llvm_type_text(signature.return_type))
                                self.unknown_func_decls[resolved] = true
                                "@{resolved}"
                            case _: self.translate_const_value(const_val)
                    case Function(_, ret):
                        match const_val:
                            case Str(name):
                                val resolved = self.llvm_function_symbol_name(name)
                                if ret != nil:
                                    self.remember_function_return_type(resolved, self.llvm_type_text(ret))
                                self.unknown_func_decls[resolved] = true
                                "@{resolved}"
                            case _: self.translate_const_value(const_val)
                    case _:
                        self.translate_const_value(const_val)

    me translate_const_value(value: MirConstValue) -> text:
        """Translate MIR constant value to LLVM constant."""
        match value:
            case Int(v): "{v}"
            case Float(v): "{v}"
            case Bool(v): if v: "1" else: "0"
            case Str(v):
                val global_name = self.add_string_global(v)
                val str_len = v.len() + 1
                val nit = self.native_int()
                "getelementptr inbounds ([{str_len} x i8], ptr {global_name}, {nit} 0, {nit} 0)"
            case Zero: "0"
            case Array(elements):
                val count = elements.len()
                "zeroinitializer  ; array ({count} elements)"
            case Tuple(elements):
                val count = elements.len()
                "zeroinitializer  ; tuple ({count} elements)"
            case Struct(fields):
                "zeroinitializer  ; struct"

    fn get_local(id: i64) -> text:
        """Get LLVM local name for MIR local."""
        "%l{id}"

    me local_value_text(id: i64) -> text:
        """Return a (possibly forward-referenced) LLVM local name, or `undef`
        only for locals that were never declared at all.

        `self.local_types`/`ptr_locals`/`bool_locals` are populated up-front
        from `body.locals` in `translate_function`, independent of the order
        blocks are textually emitted in. A local can therefore be a real,
        typed MIR local that simply hasn't been *textually* emitted yet
        (e.g. it's defined in a block that comes later in `body.blocks` but
        is a CFG predecessor of the block using it, as happens with
        SSA-phi-materialized merge values). LLVM's .ll parser resolves such
        forward references by CFG dominance, not textual order, so emitting
        the real `%lN` name here is valid -- unlike emitting `undef`, which
        silently produces wrong branch/arithmetic results (bug #135).
        Only a local with NO declared type at all (truly malformed MIR)
        still falls back to `undef` so LLVM stays valid.
        """
        # contains_key, never `.get(...).?`.
        # See doc/07_guide/language/dict_native_pitfalls.md
        if self.defined_locals.contains_key(id):
            return self.get_local(id)
        if self.ptr_locals.contains_key(id) or self.bool_locals.contains_key(id) or self.local_types.contains_key(id):
            return self.get_local(id)
        # ponytail: malformed MIR (no declared local at all) lowers to
        # `undef` so LLVM stays valid.
        "undef"

    me get_local_type(id: i64) -> text:
        """Get LLVM type for a local variable, falling back to native int type."""
        if self.ptr_locals.contains_key(id):
            return "ptr"
        if self.bool_locals.contains_key(id):
            return "i1"
        # contains_key + index read, never `.get()`: `match dict.get():` and
        # `.get(k).unwrap()` both mis-dispatch -- the seed interpreter returns
        # literal nil for locals whose type IS tracked, and native codegen
        # returns a non-round-tripping payload on a hit. Every caller then fell
        # back to native_int, which is the root of the "backend does not track
        # local types" #135 symptom family (typed copies emitted as `add i64`,
        # double operands fed to `mul nsw i64`, call args typed nil).
        # See doc/07_guide/language/dict_native_pitfalls.md
        if self.local_types.contains_key(id):
            val ty = self.local_types[id]
            if ty == nil or ty == "nil":
                self.native_int()
            else:
                ty
        else:
            self.native_int()

    me lookup_function_return_type(func_name: text) -> text:
        # ponytail: flattened (no nested match-as-expression) -- a nested
        # `match X.get(y):` inside an outer match arm was observed to silently
        # skip its `case Some(...)` body under the bootstrap seed's codegen
        # even when `.has(y)` was true, which fed a raw `nil` into emitted
        # LLVM IR text (bug #134). Explicit early-returns avoid the nested
        # match-value-propagation path entirely.
        val direct = self.function_return_types.get(func_name)
        if direct.?:
            val ty = direct.unwrap()
            if ty == nil or ty == "nil":
                return ""
            return ty
        if not func_name.starts_with("@"):
            return ""
        val bare = func_name[1:]
        val bare_hit = self.function_return_types.get(bare)
        if bare_hit.?:
            val bare_ty = bare_hit.unwrap()
            if bare_ty == nil or bare_ty == "nil":
                return ""
            return bare_ty
        ""

    me lookup_function_param_type(func_name: text, index: i64) -> text:
        # ponytail: flattened for the same reason as lookup_function_return_type.
        val direct = self.function_param_types.get(func_name)
        if direct.?:
            val param_tys = direct.unwrap()
            if index < param_tys.len():
                return param_tys[index]
            return ""
        if not func_name.starts_with("@"):
            return ""
        val bare = func_name[1:]
        val bare_hit = self.function_param_types.get(bare)
        if bare_hit.?:
            val bare_param_tys = bare_hit.unwrap()
            if index < bare_param_tys.len():
                return bare_param_tys[index]
            return ""
        ""

    me lookup_function_param_count(func_name: text) -> i64:
        """Declared parameter count for `func_name`, or -1 when unknown (extern,
        indirect callee, or a signature not yet remembered). Mirrors
        lookup_function_param_type's name resolution: direct key first, then the
        bare `@`-stripped key."""
        val direct = self.function_param_types.get(func_name)
        if direct.?:
            return direct.unwrap().len()
        if not func_name.starts_with("@"):
            return -1
        val bare = func_name[1:]
        val bare_hit = self.function_param_types.get(bare)
        if bare_hit.?:
            return bare_hit.unwrap().len()
        -1

    me mark_ptr_local(id: i64):
        self.local_types[id] = "ptr"
        self.ptr_locals[id] = true

    me valid_llvm_type(ty: text) -> text:
        if ty == "" or ty == "nil":
            self.native_int()
        else:
            ty

    me get_operand_type(operand: MirOperand) -> text:
        """Get the LLVM type string for an operand."""
        match operand.kind:
            case Copy(local):
                self.get_local_type(self.local_id_value(local))
            case Move(local):
                self.get_local_type(self.local_id_value(local))
            case Const(const_val, const_ty):
                self.llvm_type_text(const_ty)
            case _:
                self.native_int()

    fn local_id_value(local: LocalId) -> i64:
        local.id

    fn block_id_value(block: BlockId) -> i64:
        block.id

    # === Overrides: memory ===

    me translate_alloc(dest: LocalId, ty: MirType):
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val raw_ty = self.valid_llvm_type(self.llvm_type_text(ty))
        # A void-typed spill slot is emitted by the var_reassign_ssa alloca
        # transform when it slots a local whose value is unit -- e.g. the
        # discarded result temp of a `match`/`if` used as a statement. `alloca
        # void`/`load void` are rejected by llc ("void type only allowed for
        # function results"). The slot is dead (never stored, its load result
        # unused), so back it with the universal i64 word: valid IR, and the
        # garbage load value is never observed.
        val llvm_ty = if raw_ty == "void": "i64" else: raw_ty
        self.mark_ptr_local(dest_id)
        # Record the slot's element type so Load/Store through this slot use
        # it. The var_reassign_ssa spill temps have no MirLocal entry, so
        # typing loads/stores off those temps falls back to i64 and an f64
        # slot value round-trips through fptosi (10.0 -> 10, data loss).
        self.alloca_elem_types[dest_id] = llvm_ty
        # Same fact, keyed by the emitted name -- the lookup that actually
        # round-trips. See alloca_elem_type_for_value.
        self.alloca_elem_types_by_name[dest_name] = llvm_ty
        self.alloca_elem_unsigned[dest_id] = self.is_unsigned_mir_kind(ty.kind)
        self.builder.emit_alloca(dest_name, llvm_ty)

    me operand_alloca_elem_type(ptr: MirOperand) -> text:
        """Element type of the alloca slot behind `ptr`, or "" if unknown."""
        # MEASURED 2026-08-06: this local-id-keyed lookup is UNRELIABLE under
        # the native-built stage2 -- it returns "" for slots alloca'd earlier
        # in the SAME function. Converting it to the usual `contains_key` +
        # index read made it strictly worse (module-wide `load ptr` 1016->708,
        # `load i1` 1699->86), so the `.get()` form is kept here deliberately;
        # do NOT "harden" it again without re-measuring those counts. The
        # reliable path is alloca_elem_type_for_value(), keyed by the emitted
        # value NAME (text keys, as value_types uses); this stays only as a
        # fallback. See doc/07_guide/language/dict_native_pitfalls.md
        match ptr.kind:
            case Copy(local) | Move(local):
                self.alloca_elem_types.get(self.local_id_value(local)) ?? ""
            case _:
                ""

    me alloca_elem_type_for_value(ptr_val: text) -> text:
        """Element type of the alloca slot emitted as `ptr_val` (e.g. "%l112"),
        or "" if unknown.

        Keyed by the EMITTED NAME rather than the MIR local id. This is the
        access pattern value_as_type already relies on against value_types
        (text keys, contains_key + index read), and it is the only one that
        reliably round-trips here -- see operand_alloca_elem_type for the
        measurements that forced this. It also sidesteps the MirOperand-kind
        question entirely: the name is whatever translate_operand resolved,
        so a ptr operand that is neither Copy nor Move still matches."""
        if self.alloca_elem_types_by_name.contains_key(ptr_val):
            self.alloca_elem_types_by_name[ptr_val]
        else:
            ""

    me operand_alloca_elem_unsigned(ptr: MirOperand) -> bool:
        """Unsigned bit of the alloca slot behind `ptr` (see translate_alloc).
        Defaults to false (signed) when the slot is unknown."""
        match ptr.kind:
            case Copy(local) | Move(local):
                if self.alloca_elem_unsigned.contains_key(self.local_id_value(local)): self.alloca_elem_unsigned[self.local_id_value(local)] else: false
            case _:
                false

    me translate_load(dest: LocalId, ptr: MirOperand):
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val raw_ptr_val = self.translate_operand(ptr)
        val ptr_val = self.value_as_type(raw_ptr_val, self.get_operand_type(ptr), "ptr")
        # Prefer the alloca slot's element type: the dest is often an SSA-pass
        # temp with no tracked type (defaults i64), which would read an f64
        # slot's bits as an integer.
        # Name-keyed first (reliable), local-id-keyed second (unreliable but
        # kept as a fallback), dest's declared type last.
        val named_elem = self.alloca_elem_type_for_value(ptr_val)
        val slot_elem = if named_elem != "": named_elem else: self.operand_alloca_elem_type(ptr)
        val load_ty_raw = if slot_elem != "": slot_elem else: self.valid_llvm_type(self.get_local_type(dest_id))
        # See translate_alloc: void spill slots are materialized as i64.
        val load_ty = if load_ty_raw == "void": "i64" else: load_ty_raw
        if load_ty == "ptr":
            self.mark_ptr_local(dest_id)
        # Register the load result's type. Locals materialized after the
        # up-front local_types population (e.g. the alloca transform's
        # load-before-use temps) are otherwise untracked, which makes the Ret
        # path treat `return <loaded local>` as untyped and zero it
        # (`ret i64 0`). Mirrors translate_const's dest-type registration.
        self.local_types[dest_id] = load_ty
        self.value_types[dest_name] = load_ty
        self.unsigned_locals[dest_id] = self.operand_alloca_elem_unsigned(ptr)
        self.builder.emit_load(dest_name, load_ty, ptr_val)

    me translate_store(ptr: MirOperand, value: MirOperand):
        val raw_ptr_val = self.translate_operand(ptr)
        val ptr_val = self.value_as_type(raw_ptr_val, self.get_operand_type(ptr), "ptr")
        val raw_value_val = self.translate_operand(value)
        # Prefer the alloca slot's element type (see translate_load). Stores
        # MUST use the same resolution order as loads -- fixing only loads
        # would leave `store i64` writing into a `ptr` slot that is then read
        # back as `ptr`, which links and corrupts at runtime.
        val named_elem = self.alloca_elem_type_for_value(ptr_val)
        val slot_elem = if named_elem != "": named_elem else: self.operand_alloca_elem_type(ptr)
        val store_ty_raw = if slot_elem != "": slot_elem else: self.valid_llvm_type(self.get_operand_type(value))
        # See translate_alloc: void spill slots are materialized as i64.
        val store_ty = if store_ty_raw == "void": "i64" else: store_ty_raw
        val value_val = self.value_as_type(raw_value_val, self.get_operand_type(value), store_ty)
        self.builder.emit_store(store_ty, value_val, ptr_val)

    # mutglobal lane (module-level `var` mutation storage, see
    # scratchpad/mutglobal_plan.md): LoadGlobal/StoreGlobal reference a
    # MirModule.statics slot directly by SymbolId rather than through a
    # pointer-value MirOperand (there is no "address of a global" operand
    # kind, so unlike Load/Store there is no alloca/GEP producing the
    # address first) -- translate_module's static-declaration pass records
    # the real `@name` LLVM global text and its element type per SymbolId in
    # global_static_names/global_static_types before any function body is
    # translated, so these two lookups always resolve for any symbol that
    # module.statics actually carries.
    me translate_load_global(dest: LocalId, symbol: SymbolId):
        val dest_id = self.local_id_value(dest)
        val dest_name = self.get_local(dest_id)
        val g_key = self.global_static_key(symbol.id)
        val g_name = self.global_static_names.get(g_key) ?? "@g_undeclared_{symbol.id}"
        val g_ty = self.global_static_types.get(g_key) ?? self.native_int_type
        self.local_types[dest_id] = g_ty
        self.value_types[dest_name] = g_ty
        if g_ty == "ptr":
            self.mark_ptr_local(dest_id)
        self.builder.emit_load(dest_name, g_ty, g_name)

    me translate_load_global_ids(dest_id: i64, symbol_id: i64, module_index: i64, ir_handle: i64):
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] load-global:scalar dest={dest_id} symbol={symbol_id}"
        var g_name = "@g_undeclared_{symbol_id}"
        var g_ty = self.native_int_type
        val static_index = bootstrap_llvm_static_index(module_index, symbol_id)
        if static_index >= 0:
            g_name = "@g_{bootstrap_mir_static_name_at(static_index)}"
            g_ty = bootstrap_llvm_static_type_text(bootstrap_mir_static_type_tag_at(static_index), self.native_int_type)
        else:
            val g_key = self.global_static_key(symbol_id)
            if self.global_static_names.has(g_key):
                val recorded_name = self.global_static_names[g_key]
                if recorded_name != nil and recorded_name != "":
                    g_name = recorded_name
            if self.global_static_types.has(g_key):
                val recorded_type = self.global_static_types[g_key]
                if recorded_type != nil and recorded_type != "" and recorded_type != "nil":
                    g_ty = recorded_type
        val dest_name = "%l{dest_id}"
        self.local_types[dest_id] = g_ty
        self.value_types[dest_name] = g_ty
        self.defined_locals[dest_id] = true
        if g_ty == "ptr":
            self.ptr_locals[dest_id] = true
        if ir_handle >= 0:
            val load_line = "\n  {dest_name} = load {g_ty}, ptr {g_name}, align 8"
            rt_string_builder_push(ir_handle, load_line)
        else:
            self.builder.emit_load(dest_name, g_ty, g_name)
        if bootstrap_debug:
            print "[mir-to-llvm] load-global:emit dest={dest_id} type={g_ty}"

    me translate_store_global(symbol: SymbolId, value: MirOperand):
        val g_key = self.global_static_key(symbol.id)
        val g_name = self.global_static_names.get(g_key) ?? "@g_undeclared_{symbol.id}"
        val g_ty = self.global_static_types.get(g_key) ?? self.native_int_type
        val raw_value_val = self.translate_operand(value)
        val value_val = self.value_as_type(raw_value_val, self.get_operand_type(value), g_ty)
        self.builder.emit_store(g_ty, value_val, g_name)

    me translate_store_global_at(instructions: [MirInst], index: i64, module_index: i64, ir_handle: i64):
        val bootstrap_debug = (rt_env_get("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1"
        if bootstrap_debug:
            print "[mir-to-llvm] store-global:entry index={index}"
        val inst = instructions[index]
        val symbol_id = inst.bootstrap_store_global_symbol_id()
        val value_kind = inst.bootstrap_store_global_value_kind()
        if bootstrap_debug:
            print "[mir-to-llvm] store-global:scalar index={index} symbol={symbol_id} kind={value_kind}"
        var g_name = "@g_undeclared_{symbol_id}"
        var g_ty = self.native_int_type
        val static_index = bootstrap_llvm_static_index(module_index, symbol_id)
        if static_index >= 0:
            g_name = "@g_{bootstrap_mir_static_name_at(static_index)}"
            g_ty = bootstrap_llvm_static_type_text(bootstrap_mir_static_type_tag_at(static_index), self.native_int_type)
        else:
            val g_key = self.global_static_key(symbol_id)
            if self.global_static_names.has(g_key):
                val recorded_name = self.global_static_names[g_key]
                if recorded_name != nil and recorded_name != "":
                    g_name = recorded_name
            if self.global_static_types.has(g_key):
                val recorded_type = self.global_static_types[g_key]
                if recorded_type != nil and recorded_type != "" and recorded_type != "nil":
                    g_ty = recorded_type
        var value_text = "0"
        if value_kind == 1 or value_kind == 2:
            val local_id = inst.bootstrap_store_global_value_local_id()
            value_text = "%l{local_id}"
        elif value_kind == 3:
            val const_kind = inst.bootstrap_store_global_const_kind()
            val const_text = inst.bootstrap_store_global_const_scalar_text()
            value_text = const_text
            if const_kind == 4:
                val global_name = self.add_string_global(const_text)
                val str_len = const_text.len() + 1
                val nit = self.native_int_type
                value_text = "getelementptr inbounds ([{str_len} x i8], ptr {global_name}, {nit} 0, {nit} 0)"
        if bootstrap_debug:
            print "[mir-to-llvm] store-global:value index={index} type={g_ty} value={value_text}"
        if ir_handle >= 0:
            val store_line = "\n  store {g_ty} {value_text}, ptr {g_name}, align 8"
            rt_string_builder_push(ir_handle, store_line)
        else:
            self.builder.emit_store(g_ty, value_text, g_name)
        if bootstrap_debug:
            print "[mir-to-llvm] store-global:emit index={index} type={g_ty}"

fn bootstrap_llvm_static_index(module_index: i64, symbol_id: i64) -> i64:
    if module_index < 0:
        return -1
    var index = 0
    while index < bootstrap_mir_static_count():
        if bootstrap_mir_static_module_at(index) == module_index and bootstrap_mir_static_symbol_id_at(index) == symbol_id:
            return index
        index = index + 1
    -1

fn bootstrap_llvm_static_type_text(type_tag: i64, fallback: text) -> text:
    match type_tag:
        case 1: "i64"
        case 2: "i32"
        case 3: "i16"
        case 4: "i8"
        case 5: "double"
        case 6: "float"
        case 7: "i1"
        case 8: "void"
        case 9: "ptr"
        case _: fallback
