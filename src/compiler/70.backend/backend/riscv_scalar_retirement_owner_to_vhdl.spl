use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_retirement_owner.{strict_riscv_scalar_retirement_owner}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult, render_strict_sequential_hwir}

pub fn compile_strict_riscv_scalar_retirement_owner(module_name: text,
    config: CoreConfig) -> HwirStrictVhdlResult:
    val module = strict_riscv_scalar_retirement_owner(module_name, config)
    if module.is_err(): return HwirStrictVhdlResult.rejected(module.err().unwrap())
    render_strict_sequential_hwir(module.ok().unwrap(),
        "hwir-gen2-scalar-retirement-owner-v1")
