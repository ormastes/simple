# Fail-closed MIR declaration admission shared by emitting backends.
use compiler.mir.mir_instructions.{MirModule}
use compiler.mir.mir_types.{MirDeclarationShard}

fn backend_declaration_shard_preflight(shard: MirDeclarationShard,
        backend_name: text) -> text:
    for static_ in shard.statics.values():
        if static_.is_volatile:
            return "{backend_name} backend does not support volatile MIR static '{static_.name}'"
        if static_.has_fixed_address:
            return "{backend_name} backend does not support fixed-address MIR static '{static_.name}'"
        if static_.has_runtime_init:
            return "{backend_name} backend does not support runtime-initialized MIR static '{static_.name}'"
    if shard.actors.len() > 0:
        return "{backend_name} backend does not support MIR actor declarations"
    if shard.bitfields.len() > 0:
        return "{backend_name} backend does not support MIR bitfield declarations"
    for type_def in shard.types.values():
        if type_def.is_complete_open or type_def.is_dynamic_open:
            return "{backend_name} backend does not support open MIR enum declaration '{type_def.name}'"
        for field in type_def.declaration_fields:
            if field.is_volatile or field.has_fixed_address:
                return "{backend_name} backend does not support storage-qualified MIR field '{type_def.name}.{field.name}'"
    if shard.enum_extensions.len() > 0:
        return "{backend_name} backend does not support MIR open-enum extension declarations"
    ""

pub fn backend_declaration_preflight(module: MirModule, backend_name: text) -> text:
    for static_ in module.statics.values():
        if static_.is_volatile:
            return "{backend_name} backend does not support volatile MIR static '{static_.name}'"
        if static_.has_fixed_address:
            return "{backend_name} backend does not support fixed-address MIR static '{static_.name}'"
        if static_.has_runtime_init:
            return "{backend_name} backend does not support runtime-initialized MIR static '{static_.name}'"
    if module.actors.len() > 0:
        return "{backend_name} backend does not support MIR actor declarations"
    if module.bitfields.len() > 0:
        return "{backend_name} backend does not support MIR bitfield declarations"
    for type_def in module.types.values():
        if type_def.is_complete_open or type_def.is_dynamic_open:
            return "{backend_name} backend does not support open MIR enum declaration '{type_def.name}'"
        for field in type_def.declaration_fields:
            if field.is_volatile or field.has_fixed_address:
                return "{backend_name} backend does not support storage-qualified MIR field '{type_def.name}.{field.name}'"
    if module.enum_extensions.len() > 0:
        return "{backend_name} backend does not support MIR open-enum extension declarations"
    for shard in module.declaration_shards:
        val shard_error = backend_declaration_shard_preflight(shard, backend_name)
        if shard_error != "":
            return "module '" + shard.defining_module_name + "': " + shard_error
    # Extern rows are linker declarations already represented by calls. Rich
    # metadata is descriptive and intentionally has no emission side effect.
    ""
