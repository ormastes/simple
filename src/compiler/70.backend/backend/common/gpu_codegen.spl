# GpuCodegen Trait - GPU Kernel Compilation Interface
#
# Implemented by CUDA and Vulkan backends.
# Provides GPU-specific compilation capabilities including
# kernel compilation, barrier synchronization, and atomic operations.

# ponytail: GpuBarrierScope and GpuAtomicOpKind have ONE terminal declaration,
# in compiler.mir.mir_instruction_support (re-exported by mir_instructions).
# The tag-only copies that used to live here declared GpuAtomicOpKind in a
# DIFFERENT VARIANT ORDER than the MIR original: Min/Max sat at 2/3 here but at
# 5/6 there, and And/Or/Xor at 4/5/6 here but 2/3/4 there. The discriminant is a
# cross-crate ABI, so a value encoded by one copy and decoded by the other is a
# DIFFERENT operation - an atomic min silently becoming an atomic and, with no
# crash and no diagnostic. Every construction and match site happens to import
# the MIR copy today, so the scramble was latent rather than live, but nothing
# in the repo detects a duplicate terminal declaration and one `use` of the
# wrong copy would have made it real.
use compiler.mir.mir_data.{MirBody, MirInst, MirOperand, LocalId}
export use compiler.mir.mir_instructions.{GpuBarrierScope, GpuAtomicOpKind}
use compiler.backend.backend.backend_types.{CompileError}

# ============================================================================
# GpuCodegen Trait
# ============================================================================

trait GpuCodegen:
    """Interface for GPU code generation backends."""
    fn compile_kernel(func_name: text, body: MirBody) -> Result<text, CompileError>
    fn compile_device_function(func_name: text, body: MirBody) -> Result<text, CompileError>
    fn compile_gpu_instruction(inst: MirInst) -> text
    fn compile_barrier(scope: GpuBarrierScope) -> text
    fn compile_atomic(op: GpuAtomicOpKind, dest: LocalId, ptr: MirOperand, value: MirOperand) -> text
    fn gpu_memory_model() -> text
    fn is_kernel_function(body: MirBody) -> bool

# ============================================================================
# Exports
# ============================================================================
