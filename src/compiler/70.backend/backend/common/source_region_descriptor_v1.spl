# Private compiler emission of the native C4 descriptor. Inputs must originate
# from exact MIR layout classification, never from source-language arguments.
# A missing classification is an error, not a scalar slot.

use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind}
use compiler.mir.mir_types.{MirConstValue, MirTypeKind}
use compiler.mir.source_region_descriptor_input_v1.{source_region_ordinary_struct_representation_v1, source_region_ordinary_dictionary_representation_v1}
use compiler.common.source_region_descriptor_schema_v1.{source_region_descriptor_schema_header_v1, source_region_descriptor_schema_row_v1}

enum SourceRegionDescriptorErrorV1:
    UnsupportedWordWidth
    InvalidExtent
    UnclassifiedSlot
    InvalidRepresentation
    MalformedOperand
    InvalidTypeRecipe

struct SourceRegionSlotV1:
    kind: i64
    representation: i64

fn source_region_resolve_struct_slots_v1(slots: [SourceRegionSlotV1], actual_representation: i64) -> Result<[SourceRegionSlotV1], SourceRegionDescriptorErrorV1>:
    if actual_representation != 1 and actual_representation != 2:
        return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
    var resolved: [SourceRegionSlotV1] = []
    for slot in slots:
        if slot.representation == source_region_ordinary_dictionary_representation_v1() or slot.representation == 4:
            return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        if slot.representation == source_region_ordinary_struct_representation_v1():
            if slot.kind != 2:
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
            resolved = resolved.push(SourceRegionSlotV1(kind: 2, representation: actual_representation))
        else:
            resolved = resolved.push(slot)
    Ok(resolved)

fn source_region_descriptor_extent_v1(slot_count: i64) -> Result<i64, SourceRegionDescriptorErrorV1>:
    if slot_count <= 0 or slot_count > 1152921504606846975:
        return Err(SourceRegionDescriptorErrorV1.InvalidExtent)
    Ok(slot_count * 8)

fn source_region_descriptor_slot_words_v1(slots: [SourceRegionSlotV1]) -> Result<[i64], SourceRegionDescriptorErrorV1>:
    match source_region_descriptor_extent_v1(slots.len()):
        case Err(error): return Err(error)
        case Ok(_): ()
    var words: [i64] = []
    var index = 0
    for slot in slots:
        if slot.kind < 1 or slot.kind > 3:
            return Err(SourceRegionDescriptorErrorV1.UnclassifiedSlot)
        if slot.kind == 1:
            if slot.representation != 0:
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        elif slot.kind == 2 and slot.representation == 4:
            ()
        else:
            if slot.representation != 1 and slot.representation != 2:
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        words = words.push(index * 8)
        words = words.push(8)
        words = words.push(slot.kind)
        words = words.push(slot.representation)
        index = index + 1
    Ok(words)

fn source_region_descriptor_slots_v1(args: [MirOperand]) -> Result<[SourceRegionSlotV1], SourceRegionDescriptorErrorV1>:
    if args.len() % 2 != 0:
        return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
    var slots: [SourceRegionSlotV1] = []
    var index = 0
    while index < args.len():
        var kind = -1
        var representation = -1
        match args[index].kind:
            case Const(Int(value), _): kind = value
            case _: return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
        match args[index + 1].kind:
            case Const(Int(value), _): representation = value
            case _: return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
        slots = slots.push(SourceRegionSlotV1(kind: kind, representation: representation))
        index = index + 2
    Ok(slots)

fn source_region_llvm_descriptor_v1(name: text, word_width: i64,
    byte_extent: i64, slots: [SourceRegionSlotV1]) -> Result<text, SourceRegionDescriptorErrorV1>:
    # The private ABI currently admits the 64-bit native struct subset only.
    if word_width != 8:
        return Err(SourceRegionDescriptorErrorV1.UnsupportedWordWidth)
    if byte_extent <= 0 or byte_extent % word_width != 0:
        return Err(SourceRegionDescriptorErrorV1.InvalidExtent)
    if byte_extent / word_width != slots.len():
        return Err(SourceRegionDescriptorErrorV1.InvalidExtent)
    var rows = ""
    var index = 0
    for slot in slots:
        if slot.kind < 1 or slot.kind > 3:
            return Err(SourceRegionDescriptorErrorV1.UnclassifiedSlot)
        if slot.kind == 1:
            if slot.representation != 0:
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        elif slot.kind == 2 and slot.representation == 4:
            ()
        else:
            if slot.representation != 1 and slot.representation != 2:
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        if index != 0: rows = rows + ", "
        val offset = index * word_width
        rows = rows + "[4 x i64] [i64 {offset}, i64 {word_width}, i64 {slot.kind}, i64 {slot.representation}]"
        index = index + 1
    # Internal linkage retains local symbol identities through final-link proof.
    # Private linkage permits temporary assembler labels with no retained map.
    val table = "@{name}.slots = internal constant [{slots.len()} x [4 x i64]] [{rows}], align 8"
    val header = "@{name} = internal constant [6 x i64] [i64 1, i64 1, i64 {byte_extent}, i64 {slots.len()}, i64 ptrtoint (ptr @{name}.slots to i64), i64 1], align 8"
    Ok(table + "\n" + header)

fn source_region_dictionary_descriptor_slots_v1(args: [MirOperand], physical_struct_representation: i64) -> Result<[SourceRegionSlotV1], SourceRegionDescriptorErrorV1>:
    if args.len() != 1: return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
    match args[0].kind:
        case Const(Int(token), type_):
            if type_.kind != MirTypeKind.I64: return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
            if token != source_region_ordinary_struct_representation_v1():
                return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
        case _: return Err(SourceRegionDescriptorErrorV1.MalformedOperand)
    if physical_struct_representation != 1 and physical_struct_representation != 2:
        return Err(SourceRegionDescriptorErrorV1.InvalidRepresentation)
    Ok([SourceRegionSlotV1(kind: 1, representation: 0),
        SourceRegionSlotV1(kind: 2, representation: physical_struct_representation)])

fn source_region_llvm_dictionary_descriptor_v1(name: text, slots: [SourceRegionSlotV1]) -> Result<text, SourceRegionDescriptorErrorV1>:
    if not source_region_descriptor_schema_header_v1(4, 64u64, slots.len()):
        return Err(SourceRegionDescriptorErrorV1.InvalidExtent)
    for index in 0..slots.len():
        val slot = slots[index]
        if not source_region_descriptor_schema_row_v1(4, 64u64, 2, index, index as u64 * 8u64, 8u64, slot.kind as u64, slot.representation as u64):
            return Err(SourceRegionDescriptorErrorV1.UnclassifiedSlot)
    val value_representation = slots[1].representation
    val table = "@{name}.slots = internal constant [2 x [4 x i64]] [[4 x i64] [i64 0, i64 8, i64 1, i64 0], [4 x i64] [i64 8, i64 8, i64 2, i64 {value_representation}]], align 8"
    val header = "@{name} = internal constant [6 x i64] [i64 1, i64 4, i64 64, i64 2, i64 ptrtoint (ptr @{name}.slots to i64), i64 1], align 8"
    Ok(table + "\n" + header)
