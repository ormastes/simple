"""MirInstKind -> variant name, for NAMED backend diagnostics.

Policy (2026-08-23): an unimplemented backend path must fail loudly or be
explicitly disabled with a TODO — never silently emit something plausible.
The five text/JIT backends previously ended their `match inst_kind:` in a
catch-all that dropped the instruction (two emitted nothing at all, three
left an inert comment or an unnamed warning) and the build reported
success. Naming the construct in the error is what makes those paths
actionable, and every backend needs the same name, so the table lives here
once instead of being re-hand-written per backend.

Generated from spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn
(126 variants). Kept in sync by scripts/check/check-mir-backend-coverage.shs,
which fails when a MirInstKind variant has no arm here.
"""
use compiler.mir.mir_instructions.{MirInstKind}

fn mir_instkind_variant_name(kind: MirInstKind) -> text:
    """Stable, greppable variant name for `E-BACKEND-<NAME>-INST-<Variant>`."""
    match kind:
        case AcquireSnapshot(_, _): "AcquireSnapshot"
        case Aggregate(_, _, _): "Aggregate"
        case Alloc(_, _): "Alloc"
        case Await(_, _): "Await"
        case BinOp(_, _, _, _): "BinOp"
        case Bitcast(_, _, _): "Bitcast"
        case Call(_, _, _): "Call"
        case CallIndirect(_, _, _, _): "CallIndirect"
        case Cast(_, _, _): "Cast"
        case CheckedBinOp(_, _, _, _): "CheckedBinOp"
        case CommitUpdates(_, _, _): "CommitUpdates"
        case Compose(_, _, _, _): "Compose"
        case ConditionProbe(_, _, _, _, _, _, _, _): "ConditionProbe"
        case Const(_, _, _): "Const"
        case Copy(_, _): "Copy"
        case CreatePromise(_, _, _): "CreatePromise"
        case DebugValue(_, _): "DebugValue"
        case DecisionProbe(_, _, _, _, _, _): "DecisionProbe"
        case Drop(_): "Drop"
        case FreezeRegion(_): "FreezeRegion"
        case GetElementPtr(_, _, _): "GetElementPtr"
        case GetField(_, _, _): "GetField"
        case GpuAtomicCas(_, _, _, _): "GpuAtomicCas"
        case GpuAtomicOp(_, _, _, _): "GpuAtomicOp"
        case GpuBarrier(_): "GpuBarrier"
        case GpuBlockDim(_, _): "GpuBlockDim"
        case GpuBlockId(_, _): "GpuBlockId"
        case GpuGlobalId(_, _): "GpuGlobalId"
        case GpuGridDim(_, _): "GpuGridDim"
        case GpuKernelDef(_): "GpuKernelDef"
        case GpuLaunch(_): "GpuLaunch"
        case GpuLocalId(_, _): "GpuLocalId"
        case GpuMemFence(_): "GpuMemFence"
        case GpuSharedAlloc(_, _, _): "GpuSharedAlloc"
        case HostGpuLaneBegin(_, _): "HostGpuLaneBegin"
        case HostGpuLaneEnd(_): "HostGpuLaneEnd"
        case InlineAsm(_, _, _, _, _, _, _): "InlineAsm"
        case Intrinsic(_, _, _): "Intrinsic"
        case LayerConnect(_, _, _): "LayerConnect"
        case Load(_, _): "Load"
        case LoadGlobal(_, _): "LoadGlobal"
        case MaskFromCmp(_, _, _, _): "MaskFromCmp"
        case MaskedAdd(_, _, _, _): "MaskedAdd"
        case MaskedFma(_, _, _, _, _): "MaskedFma"
        case MaskedMul(_, _, _, _): "MaskedMul"
        case MirSimdBinop(_, _, _, _): "MirSimdBinop"
        case MirSimdCmp(_, _, _, _): "MirSimdCmp"
        case MirSimdGather(_, _, _, _): "MirSimdGather"
        case MirSimdLoad(_, _, _, _): "MirSimdLoad"
        case MirSimdMaskOp(_, _, _, _): "MirSimdMaskOp"
        case MirSimdPermute(_, _, _): "MirSimdPermute"
        case MirSimdReduce(_, _, _): "MirSimdReduce"
        case MirSimdScalableVsetvl(_, _, _): "MirSimdScalableVsetvl"
        case MirSimdScatter(_, _, _): "MirSimdScatter"
        case MirSimdSelect(_, _, _, _): "MirSimdSelect"
        case MirSimdShuffle(_, _, _, _): "MirSimdShuffle"
        case MirSimdSplat(_, _, _): "MirSimdSplat"
        case MirSimdStore(_, _, _): "MirSimdStore"
        case MirSimdTernop(_, _, _, _, _): "MirSimdTernop"
        case MirSimdUnop(_, _, _): "MirSimdUnop"
        case MirWarpActivesMask(_): "MirWarpActivesMask"
        case MirWarpBallot(_, _, _): "MirWarpBallot"
        case MirWarpReduce(_, _, _, _): "MirWarpReduce"
        case MirWarpShfl(_, _, _, _, _): "MirWarpShfl"
        case MirWarpSync(_): "MirWarpSync"
        case Move(_, _): "Move"
        case Nop: "Nop"
        case Parallel(_, _): "Parallel"
        case PipeForward(_, _, _): "PipeForward"
        case PredicatedAdd(_, _, _, _, _, _): "PredicatedAdd"
        case PredicatedFma(_, _, _, _, _, _, _): "PredicatedFma"
        case PredicatedMul(_, _, _, _, _, _): "PredicatedMul"
        case Receive(_, _): "Receive"
        case Ref(_, _, _): "Ref"
        case ResultMatchSemantic(_, _, _, _, _, _, _): "ResultMatchSemantic"
        case ScalableVecFence(_): "ScalableVecFence"
        case Send(_, _, _): "Send"
        case SetField(_, _, _): "SetField"
        case SimdAddF32x4(_, _, _): "SimdAddF32x4"
        case SimdAddF32x8(_, _, _): "SimdAddF32x8"
        case SimdAddF64x4(_, _, _): "SimdAddF64x4"
        case SimdAddI32x4(_, _, _): "SimdAddI32x4"
        case SimdAddI32x8(_, _, _): "SimdAddI32x8"
        case SimdAndI32x4(_, _, _): "SimdAndI32x4"
        case SimdAndI32x8(_, _, _): "SimdAndI32x8"
        case SimdDivF32x4(_, _, _): "SimdDivF32x4"
        case SimdDivF32x8(_, _, _): "SimdDivF32x8"
        case SimdDivF64x4(_, _, _): "SimdDivF64x4"
        case SimdFmaF32x4(_, _, _, _): "SimdFmaF32x4"
        case SimdFmaF32x8(_, _, _, _): "SimdFmaF32x8"
        case SimdFmaF64x4(_, _, _, _): "SimdFmaF64x4"
        case SimdHaddF32x4(_, _): "SimdHaddF32x4"
        case SimdHmaxF32x4(_, _): "SimdHmaxF32x4"
        case SimdHminF32x4(_, _): "SimdHminF32x4"
        case SimdMulF32x4(_, _, _): "SimdMulF32x4"
        case SimdMulF32x8(_, _, _): "SimdMulF32x8"
        case SimdMulF64x4(_, _, _): "SimdMulF64x4"
        case SimdMulI32x4(_, _, _): "SimdMulI32x4"
        case SimdMulI32x8(_, _, _): "SimdMulI32x8"
        case SimdOrI32x4(_, _, _): "SimdOrI32x4"
        case SimdOrI32x8(_, _, _): "SimdOrI32x8"
        case SimdShlI32x4(_, _, _): "SimdShlI32x4"
        case SimdShlI32x8(_, _, _): "SimdShlI32x8"
        case SimdShrI32x4(_, _, _): "SimdShrI32x4"
        case SimdShrI32x8(_, _, _): "SimdShrI32x8"
        case SimdSubF32x4(_, _, _): "SimdSubF32x4"
        case SimdSubF32x8(_, _, _): "SimdSubF32x8"
        case SimdSubF64x4(_, _, _): "SimdSubF64x4"
        case SimdSubI32x4(_, _, _): "SimdSubI32x4"
        case SimdSubI32x8(_, _, _): "SimdSubI32x8"
        case SimdXorI32x4(_, _, _): "SimdXorI32x4"
        case SimdXorI32x8(_, _, _): "SimdXorI32x8"
        case Spawn(_, _, _): "Spawn"
        case Store(_, _): "Store"
        case StoreGlobal(_, _): "StoreGlobal"
        case TransferIn(_, _, _, _): "TransferIn"
        case TransferOut(_, _, _, _, _, _): "TransferOut"
        case UnaryOp(_, _, _): "UnaryOp"
        case VhdlConcat(_, _): "VhdlConcat"
        case VhdlPortMap(_, _, _): "VhdlPortMap"
        case VhdlProcess(_, _): "VhdlProcess"
        case VhdlResize(_, _, _, _): "VhdlResize"
        case VhdlSignalAssign(_, _, _): "VhdlSignalAssign"
        case VhdlSlice(_, _, _, _): "VhdlSlice"
        case VhdlVarAssign(_, _): "VhdlVarAssign"
        case Yield(_): "Yield"
        case _("a NEW MirInstKind variant with no arm here; the name is unknown by construction, so callers report the discriminant instead"): "Unknown"

export mir_instkind_variant_name
