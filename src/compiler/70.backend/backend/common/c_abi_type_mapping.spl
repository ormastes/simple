# Shared C representation entrypoint for headers and the C backend plugin.
# Keep the canonical mapper's named-type handling and unsupported-type refusals.
use compiler.backend.backend.c_type_mapper.{CTypeMapper as CanonicalCTypeMapper}
use compiler.mir.mir_types.{MirType}

fn c_abi_map_type(ty: MirType, type_names: Dict<i64, text> = {}) -> text:
    """Map a MIR type using the canonical C backend representation policy."""
    val mapper = CanonicalCTypeMapper(target_bits: 64, type_names: type_names)
    mapper.map_type(ty)
