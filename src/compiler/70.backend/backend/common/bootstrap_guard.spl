# Bootstrap guards for optional backend pieces
const BOOTSTRAP_NO_C: bool = sys_env_bool("BOOTSTRAP_NO_C")
const BOOTSTRAP_NO_GPU: bool = sys_env_bool("BOOTSTRAP_NO_GPU")
const BOOTSTRAP_NO_EVAL: bool = sys_env_bool("BOOTSTRAP_NO_EVAL")
# Skip heavy backend wiring during bootstrap (guards factory/aggregators)
const BOOTSTRAP_MINIMAL: bool = sys_env_bool("BOOTSTRAP_MINIMAL")

export BOOTSTRAP_NO_C, BOOTSTRAP_NO_GPU, BOOTSTRAP_NO_EVAL, BOOTSTRAP_MINIMAL
