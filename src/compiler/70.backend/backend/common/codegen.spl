# Codegen Trait - Universal Backend Interface
#
# Re-exports the single canonical Codegen, CodegenOutput, and CodegenOutputKind
# definitions from `compiler.backend.codegen_types` so co-loading
# `compiler.backend.common.*` and `compiler.backend.codegen_types` never creates
# duplicate `CodegenOutput` class definitions in the interpreter.

export use compiler.backend.codegen_types.{Codegen, CodegenOutput, CodegenOutputKind}
