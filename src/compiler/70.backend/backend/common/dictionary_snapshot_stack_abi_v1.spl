# C-private stack ABI, not Simple-record layout or request authority.
# Native owner asserts these offsets against sizeof/offsetof on native64.
fn dictionary_snapshot_observation_bytes_v1() -> i64: 64
fn dictionary_snapshot_witness_bytes_v1() -> i64: 40
fn dictionary_snapshot_stack_alignment_v1() -> i64: 8

fn dictionary_snapshot_llvm_stack_v1(observation: text, witness: text) -> [text]:
    ["  {observation} = alloca [64 x i8], align 8",
     "  {witness} = alloca [40 x i8], align 8"]

fn dictionary_snapshot_llvm_observe_v1(result: text, dictionary: text, work: text, observation: text) -> text:
    "  {result} = call i64 @rt_dict_snapshot_observe_v1(i64 {dictionary}, i64 {work}, ptr {observation})"

fn dictionary_snapshot_llvm_new_v1(result: text, length: text, work: text, fields: text, bytes: text, witness: text) -> text:
    "  {result} = call i64 @rt_array_snapshot_new_v1(i64 {length}, i64 {work}, i64 {fields}, i64 {bytes}, ptr {witness})"

fn dictionary_snapshot_llvm_fill_publish_v1(result: text, dictionary: text, observation: text, witness: text, work: text) -> text:
    "  {result} = call i64 @rt_dict_snapshot_fill_publish_v1(i64 {dictionary}, ptr {observation}, ptr {witness}, i64 {work})"

fn dictionary_snapshot_llvm_dispose_v1(result: text, witness: text, work: text) -> text:
    "  {result} = call i64 @rt_array_snapshot_dispose_v1(ptr {witness}, i64 {work})"

# Neither consumed=1 nor a nonzero array field authorizes publication: dispose
# also consumes. Only the positive actual fill_publish return is the carrier.
fn dictionary_snapshot_fill_publish_succeeded_v1(result: i64) -> bool:
    result > 0
