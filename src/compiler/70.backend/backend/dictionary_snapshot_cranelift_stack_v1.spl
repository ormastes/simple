# Physical private backend operations ONLY. Caller must own the lexical
# transaction and checked same-account CFG; these handles are not MIR locals.
use std.nogc_sync_mut.sffi.codegen.*
use compiler.backend.cranelift_runtime_imports.{translate_runtime_import_call_i64}

struct DictionarySnapshotCraneliftStackV1:
    observation_address: i64
    witness_address: i64

fn dictionary_snapshot_cranelift_stack_v1(ctx: i64) -> DictionarySnapshotCraneliftStackV1:
    val observation = cranelift_stack_slot(ctx, 64, 8)
    val witness = cranelift_stack_slot(ctx, 40, 8)
    DictionarySnapshotCraneliftStackV1(
        observation_address: cranelift_stack_addr(ctx, observation, 0),
        witness_address: cranelift_stack_addr(ctx, witness, 0))

fn dictionary_snapshot_cranelift_observe_v1(ctx: i64, module: i64,
    stack: DictionarySnapshotCraneliftStackV1, dictionary: i64, work: i64) -> i64:
    translate_runtime_import_call_i64(ctx, module, "rt_dict_snapshot_observe_v1",
        [dictionary, work, stack.observation_address])

fn dictionary_snapshot_cranelift_new_v1(ctx: i64, module: i64,
    stack: DictionarySnapshotCraneliftStackV1, length: i64, work: i64, fields: i64, bytes: i64) -> i64:
    translate_runtime_import_call_i64(ctx, module, "rt_array_snapshot_new_v1",
        [length, work, fields, bytes, stack.witness_address])

fn dictionary_snapshot_cranelift_fill_publish_v1(ctx: i64, module: i64,
    stack: DictionarySnapshotCraneliftStackV1, dictionary: i64, work: i64) -> i64:
    translate_runtime_import_call_i64(ctx, module, "rt_dict_snapshot_fill_publish_v1",
        [dictionary, stack.observation_address, stack.witness_address, work])

fn dictionary_snapshot_cranelift_dispose_v1(ctx: i64, module: i64,
    stack: DictionarySnapshotCraneliftStackV1, work: i64) -> i64:
    translate_runtime_import_call_i64(ctx, module, "rt_array_snapshot_dispose_v1",
        [stack.witness_address, work])
