# Dedicated strict VHDL backend for the canonical mixed runtime LSU composition.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwPort, hwir_vhdl_identifier}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_composition.{
    HwScalarRuntimeLsuComposition, HwScalarRuntimeLsuCompositionBinding,
    strict_riscv_scalar_runtime_lsu_composition}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult,
    render_strict_hwir_vhdl, render_strict_sequential_hwir}

fn runtime_lsu_route() -> text: "hwir-gen2-scalar-runtime-lsu-composition-v1"

fn runtime_lsu_config_hash(config: CoreConfig) -> text:
    sha256_text([config.xlen.to_text(), config.physical_address_bits.to_text(),
        config.register_count.to_text(), config.profile, config.isa_profile,
        config.compressed_decode_profile].join("|"))

fn runtime_lsu_rejected(diagnostic: text) -> HwirStrictVhdlResult:
    HwirStrictVhdlResult(success: false, vhdl: "", diagnostic: diagnostic,
        route: runtime_lsu_route(), module_node_id: "", config_xlen: 0,
        config_profile: "", hwir_graph_sha256: "")

fn runtime_lsu_type(width: i32) -> text:
    if width == 1: return "std_logic"
    "std_logic_vector(" + (width - 1).to_text() + " downto 0)"

fn runtime_lsu_wire(binding: HwScalarRuntimeLsuCompositionBinding) -> text:
    "wire_o" + binding.destination_owner.len().to_text() + "_" +
        binding.destination_owner + "_p" + binding.destination_port.len().to_text() +
        "_" + binding.destination_port

fn runtime_lsu_source(owner: text, port: text) -> text:
    "source_o" + owner.len().to_text() + "_" + owner + "_p" +
        port.len().to_text() + "_" + port

fn runtime_lsu_input_actual(composition: HwScalarRuntimeLsuComposition,
    owner: text, port: HwPort) -> text:
    for binding in composition.bindings:
        if binding.destination_owner == owner and binding.destination_port == port.name:
            return runtime_lsu_wire(binding)
    port.name

fn runtime_lsu_output_actual(composition: HwScalarRuntimeLsuComposition,
    owner: text, port: HwPort) -> text:
    for binding in composition.bindings:
        if binding.source_owner == owner and binding.source_port == port.name:
            return runtime_lsu_source(owner, port.name)
    "open"

fn runtime_lsu_child_map(composition: HwScalarRuntimeLsuComposition,
    owner: text, ports: [HwPort]) -> text:
    var result = ""; var index = 0
    for port in ports:
        if index > 0: result = result + ","
        result = result + port.name + "=>" +
            (if port.direction == "in": runtime_lsu_input_actual(composition, owner, port)
            else: runtime_lsu_output_actual(composition, owner, port))
        index = index + 1
    result

fn runtime_lsu_ports(ports: [HwPort]) -> text:
    var result = ""; var index = 0
    for port in ports:
        result = result + "        " + port.name + " : " + port.direction + " " +
            runtime_lsu_type(port.bit_width)
        if index + 1 < ports.len(): result = result + ";"
        result = result + "\n"; index = index + 1
    result

fn runtime_lsu_signals(composition: HwScalarRuntimeLsuComposition) -> text:
    var result = ""; var sources: [text] = []
    for binding in composition.bindings:
        if binding.destination_owner != "composition":
            result = result + "    signal " + runtime_lsu_wire(binding) + " : " +
                runtime_lsu_type(binding.bit_width) + ";\n"
        if binding.source_owner != "composition":
            val source = runtime_lsu_source(binding.source_owner, binding.source_port)
            if not sources.contains(source.lower()):
                result = result + "    signal " + source + " : " +
                    runtime_lsu_type(binding.bit_width) + ";\n"
                sources.push(source.lower())
    result

fn runtime_lsu_assignments(composition: HwScalarRuntimeLsuComposition) -> text:
    var result = ""
    for binding in composition.bindings:
        val destination = if binding.destination_owner == "composition":
            binding.destination_port else: runtime_lsu_wire(binding)
        val source = if binding.source_owner == "composition": binding.source_port
            else: runtime_lsu_source(binding.source_owner, binding.source_port)
        result = result + "    " + destination + " <= " + source + ";\n"
    result

pub fn scalar_runtime_lsu_vhdl_closure_diagnostic(
    composition: HwScalarRuntimeLsuComposition) -> text:
    if composition.config.xlen != 32 and composition.config.xlen != 64:
        return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-XLEN: backend supports exact RV32 or RV64 widths"
    if composition.bus.bus_data_bits != composition.config.xlen or
        composition.bus.byte_mask_bits != composition.config.xlen / 8:
        return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-BUS: backend requires one XLEN-wide RV32 or RV64 bus beat"
    var destinations: [text] = []; var source_widths: [text] = []
    var source_names: [text] = []; var source_endpoints: [text] = []
    var emitted_names: [text] = []
    for port in composition.top_ports:
        val name = port.name.lower()
        if emitted_names.contains(name):
            return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
        emitted_names.push(name)
    for binding in composition.bindings:
        val destination = if binding.destination_owner == "composition":
            binding.destination_port else: runtime_lsu_wire(binding)
        if destinations.contains(destination.lower()):
            return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-DRIVER: every destination requires exactly one driver"
        destinations.push(destination.lower())
        if binding.source_owner != "composition":
            val source = runtime_lsu_source(binding.source_owner, binding.source_port).lower()
            val endpoint = binding.source_owner + "|" + binding.source_port
            if source_names.contains(source):
                var source_index = 0
                while source_names[source_index] != source: source_index = source_index + 1
                if source_endpoints[source_index] != endpoint:
                    return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-NAME: distinct source endpoints require case-insensitive unique emitted names"
            elif emitted_names.contains(source):
                return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
            else:
                source_names.push(source); source_endpoints.push(endpoint)
                emitted_names.push(source)
            val width = source + "|" + binding.bit_width.to_text()
            for known in source_widths:
                if known.starts_with(source + "|") and known != width:
                    return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-SOURCE: fanout requires one width-consistent source signal"
            if not source_widths.contains(width): source_widths.push(width)
        if binding.destination_owner != "composition":
            val wire = destination.lower()
            if emitted_names.contains(wire):
                return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
            emitted_names.push(wire)
    for port in composition.top_ports:
        if port.direction == "out" and not destinations.contains(port.name.lower()):
            return "HWIR-E-RISCV-RUNTIME-LSU-VHDL-TOP: every top output requires one driver"
    ""

pub fn render_strict_riscv_scalar_runtime_lsu_vhdl(
    composition: HwScalarRuntimeLsuComposition, route: text) -> HwirStrictVhdlResult:
    if route != runtime_lsu_route():
        return runtime_lsu_rejected(
            "HWIR-E-RISCV-RUNTIME-LSU-VHDL-ROUTE: runtime LSU requires its dedicated strict route")
    val diagnostic = composition.diagnostic()
    if diagnostic != "": return runtime_lsu_rejected(diagnostic)
    val closure = scalar_runtime_lsu_vhdl_closure_diagnostic(composition)
    if closure != "": return runtime_lsu_rejected(closure)
    if not hwir_vhdl_identifier(composition.module_name):
        return runtime_lsu_rejected(
            "HWIR-E-RISCV-RUNTIME-LSU-VHDL-ENTITY: composition requires a legal VHDL entity name")
    val decoder = render_strict_hwir_vhdl(composition.decoder)
    val pending = render_strict_sequential_hwir(composition.pending,
        "hwir-gen2-scalar-pending-provider-owner-v1")
    val projection = render_strict_hwir_vhdl(composition.projection)
    val lsu = render_strict_sequential_hwir(composition.lsu,
        "hwir-gen2-scalar-runtime-lsu-owner-v1")
    val idle = render_strict_hwir_vhdl(composition.idle)
    val route_child = render_strict_hwir_vhdl(composition.route)
    for child in [decoder, pending, projection, lsu, idle, route_child]:
        if not child.is_success(): return runtime_lsu_rejected(child.diagnostic)
    val graph = composition.structural_sha256()
    val bus_hash = sha256_text(composition.bus.bus_data_bits.to_text() + "|" +
        composition.bus.byte_mask_bits.to_text())
    val top = "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\n" +
        "-- simple-hwir route=" + runtime_lsu_route() + "\n" +
        "-- simple-hwir top=" + graph + "\n" +
        "-- simple-hwir config=" + runtime_lsu_config_hash(composition.config) + "\n" +
        "-- simple-hwir bus=" + bus_hash + "\n" +
        "-- simple-hwir plan=" + composition.plan.structural_sha256() + "\n" +
        "-- simple-hwir schema=" + composition.decoded.structural_sha256() + "\n" +
        "-- simple-hwir protocol=" + composition.protocol.structural_sha256() + "\n" +
        "-- simple-hwir child-decoder=" + decoder.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-pending=" + pending.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-projection=" + projection.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-lsu=" + lsu.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-idle=" + idle.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-route=" + route_child.hwir_graph_sha256 + "\n" +
        "entity " + composition.module_name + " is port(\n" +
        runtime_lsu_ports(composition.top_ports) + "    ); end entity;\n" +
        "architecture rtl of " + composition.module_name + " is\n" +
        runtime_lsu_signals(composition) + "begin\n" + runtime_lsu_assignments(composition) +
        "    pending: entity work." + composition.pending.entity_name + " port map(" +
            runtime_lsu_child_map(composition, "pending", composition.pending.ports) + ");\n" +
        "    projection: entity work." + composition.projection.summary.name + " port map(" +
            runtime_lsu_child_map(composition, "projection", composition.projection.ports) + ");\n" +
        "    lsu: entity work." + composition.lsu.entity_name + " port map(" +
            runtime_lsu_child_map(composition, "lsu", composition.lsu.ports) + ");\n" +
        "    idle: entity work." + composition.idle.summary.name + " port map(" +
            runtime_lsu_child_map(composition, "idle", composition.idle.ports) + ");\n" +
        "    route_owner: entity work." + composition.route.summary.name + " port map(" +
            runtime_lsu_child_map(composition, "route", composition.route.ports) + ");\n" +
        "end architecture rtl;\n"
    HwirStrictVhdlResult(success: true,
        vhdl: decoder.vhdl + "\n" + pending.vhdl + "\n" + projection.vhdl + "\n" +
            lsu.vhdl + "\n" + idle.vhdl + "\n" + route_child.vhdl + "\n" + top,
        diagnostic: "", route: runtime_lsu_route(),
        module_node_id: composition.node_id.value, config_xlen: composition.config.xlen,
        config_profile: composition.config.profile, hwir_graph_sha256: graph)

pub fn compile_strict_riscv_scalar_runtime_lsu_vhdl(module_name: text,
    config: CoreConfig, bus: LsuConfig) -> HwirStrictVhdlResult:
    val rebuilt = strict_riscv_scalar_runtime_lsu_composition(module_name, config, bus)
    if rebuilt.is_err(): return runtime_lsu_rejected(rebuilt.err().unwrap())
    render_strict_riscv_scalar_runtime_lsu_vhdl(rebuilt.ok().unwrap(), runtime_lsu_route())
