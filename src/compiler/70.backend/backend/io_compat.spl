use std.nogc_sync_mut.io.process_ops.{process_run}
use std.io_runtime.{host_os}

# Was: read the `OS` env var directly and default to "not Windows" when unset
# -- fail-open under a stripped bootstrap environment (its captured command
# transcript carries no `OS` entry at all). Also traced NOT reachable via
# std.nogc_sync_mut.env.platform.is_windows(): live inside the Stage 2
# bootstrap sanity harness, that resolver answered false while host_os() (used
# below) answered "windows" correctly in the very same process -- two
# disagreeing OS detectors. Compare host_os() directly, matching every other
# current call site in this compiler that already relies on it (e.g.
# runtime_compiler.spl's _is_windows). POSIX (`/bin/sh -c`) branch unchanged.
fn backend_shell_tuple(command: text) -> (text, text, i64):
    if host_os() == "windows":
        return process_run("cmd.exe", ["/c", command])
    process_run("/bin/sh", ["-c", command])
