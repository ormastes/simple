# x86_64 Instruction Encoder
#
# Encodes MachInst to raw bytes for x86_64 architecture.
# x86_64 is variable-length (1-15 bytes per instruction).
#
# Encoding format:
#   [REX prefix] [Opcode 1-3 bytes] [ModRM] [SIB] [Displacement] [Immediate]
#
# REX prefix: 0x40 | W(3) | R(2) | X(1) | B(0)
#   W = 1 for 64-bit operand size
#   R = extends ModRM reg field
#   X = extends SIB index field
#   B = extends ModRM r/m or SIB base field

use compiler.backend.native.mach_inst.{MachReg, MachRegKind, physical_reg, reg_id, Operand, OperandKind, MachInst, MachBlock, MachFunction, MachModule, EncodedReloc, EncodedFunction, new_encoded_function}
use compiler.backend.native.mach_inst.{X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI, X86_R8, X86_R9, X86_R10, X86_R11, X86_R12, X86_R13, X86_R14, X86_R15, X86_YMM0}
use compiler.backend.native.mach_inst.{X86_OP_MOV_REG_REG, X86_OP_MOV_REG_IMM, X86_OP_MOV_REG_MEM, X86_OP_MOV_MEM_REG, X86_OP_ADD, X86_OP_SUB, X86_OP_IMUL, X86_OP_IDIV, X86_OP_AND, X86_OP_OR, X86_OP_XOR, X86_OP_SHL, X86_OP_SAR, X86_OP_SHR, X86_OP_NEG, X86_OP_NOT, X86_OP_BSWAP, X86_OP_POPCNT, X86_OP_CMP, X86_OP_TEST, X86_OP_SETE, X86_OP_SETNE, X86_OP_SETL, X86_OP_SETLE, X86_OP_SETG, X86_OP_SETGE, X86_OP_SETB, X86_OP_SETBE, X86_OP_SETA, X86_OP_SETAE, X86_OP_JMP, X86_OP_JE, X86_OP_JNE, X86_OP_JNZ, X86_OP_JZ, X86_OP_CALL, X86_OP_RET, X86_OP_PUSH, X86_OP_POP, X86_OP_LEA, X86_OP_MOVZX, X86_OP_CQO, X86_OP_NOP, X86_OP_INT3, X86_OP_SYSCALL, X86_OP_ADD_IMM, X86_OP_SUB_IMM, X86_OP_CMP_IMM, X86_OP_MOV_REG_IMM32, X86_OP_CALL_INDIRECT}
use compiler.backend.native.mach_inst.{X86_OP_MOVZX_REG_MEM8, X86_OP_MOVZX_REG_MEM16, X86_OP_MOV_REG_MEM32, X86_OP_MOV_MEM8_REG, X86_OP_MOV_MEM16_REG, X86_OP_MOV_MEM32_REG}
use compiler.backend.native.mach_inst.{X86_OP_MOVSX_REG_MEM8, X86_OP_MOVSX_REG_MEM16, X86_OP_MOVSX_REG_MEM32}
use compiler.backend.native.mach_inst.{X86_OP_VMOVAPS_LOAD_YMM, X86_OP_VMOVAPS_STORE_YMM, X86_OP_VADDPS_YMM, X86_OP_VSUBPS_YMM, X86_OP_VMULPS_YMM, X86_OP_VDIVPS_YMM}
use compiler.backend.native.mach_inst.{X86_OP_VMOVAPS_LOAD_ZMM, X86_OP_VMOVAPS_STORE_ZMM, X86_OP_VADDPS_ZMM, X86_OP_VSUBPS_ZMM, X86_OP_VMULPS_ZMM, X86_OP_VDIVPS_ZMM, X86_OP_VADDPD_ZMM, X86_OP_VSUBPD_ZMM, X86_OP_VMULPD_ZMM, X86_OP_VDIVPD_ZMM, X86_OP_VPADDD_ZMM, X86_OP_VPSUBD_ZMM, X86_OP_VPMULLD_ZMM, X86_OP_VPANDD_ZMM, X86_OP_VPORD_ZMM, X86_OP_VPXORD_ZMM}
use compiler.backend.native.x86_64_simd.{encode_vaddps_ymm, encode_vsubps_ymm, encode_vmulps_ymm, encode_vdivps_ymm, ymm_to_index}
use compiler.backend.native.x86_64_avx512.{X86_ZMM0, X86_K0, encode_avx512_load_zmm, encode_avx512_store_zmm, encode_avx512_add_f32x16, encode_avx512_sub_f32x16, encode_avx512_mul_f32x16, encode_avx512_div_f32x16, encode_avx512_add_f64x8, encode_avx512_sub_f64x8, encode_avx512_mul_f64x8, encode_avx512_div_f64x8, encode_avx512_add_i32x16, encode_avx512_sub_i32x16, encode_avx512_mul_i32x16, encode_avx512_and_i32x16, encode_avx512_or_i32x16, encode_avx512_xor_i32x16}
use compiler.backend.native.x86_64_avx512.{emit_avx512_vpermps_zmm, emit_avx512_vpermq, emit_avx512_vpermd, emit_avx512_vpermi2d, emit_avx512_vpermi2q, emit_avx512_vpmovsxdq_zmm_from_ymm, emit_avx512_vgatherdps_zmm, emit_avx512_vgatherdpd_zmm, emit_avx512_vpgatherdd_zmm}
use compiler.backend.native.x86_64_avx512.{encode_avx512_loadu_zmm, encode_avx512_storeu_zmm, encode_avx512_loadu_ymm, encode_avx512_storeu_ymm, evex_encode_3op_zmm}
use compiler.backend.native.x86_64_avx512_ops.{X86_OP_AVX512_LOADU, X86_OP_AVX512_STOREU, X86_OP_AVX512_BINARY, X86_OP_AVX512_TERNARY, X86_OP_AVX512_UNARY, X86_OP_AVX512_COMPARE, X86_OP_AVX512_KLOAD, X86_OP_AVX512_KSTORE, X86_OP_AVX512_MASK, X86_OP_AVX512_SELECT, X86_OP_AVX512_SPLAT, X86_OP_AVX512_REDUCE, X86_OP_AVX512_COPY_LANE, X86_OP_AVX512_BOUNDS, X86_OP_AVX512_INDEXED, X86_OP_AVX512_BROADCAST_LANE, X86_OP_AVX512_MASK_CANONICAL, X86_OP_AVX512_PERMUTE, X86_OP_AVX512_GATHER, X86_OP_AVX512_SHUFFLE, X86_OP_AVX512_EXTRACT_I32}
use compiler.backend.native.x86_64_avx512_ops.{avx512_binop_bytes, avx512_fma_bytes, avx512_unop_bytes, avx512_cmp_bytes, avx512_kmem_bytes, avx512_kop_bytes, avx512_kall_bytes, avx512_splat_bytes, avx512_reduce_bytes, avx512_scalar_mem, avx512_extract_i32_bytes, avx512_bound_bytes, avx512_indexed_bytes, avx512_broadcast_lane_bytes}
use compiler.backend.native.encode_common.{encode_module_with}
use compiler.backend.native.elf_writer.{ByteBuffer, new_byte_buffer, buf_len, buf_write_u8, buf_write_u32_le, buf_write_u64_le, buf_write_bytes}
use compiler.backend.native.operand_utils.{get_phys_reg_id, get_mem_base_id, get_mem_offset, get_imm_value, get_label_id, get_sym_name}

# ============================================================================
# Encoding Helpers
# ============================================================================

fn reg_low3(reg_id: i64) -> i64:
    reg_id % 8

fn reg_needs_rex_b(reg_id: i64) -> bool:
    reg_id >= 8

fn rex_w() -> i64:
    0x48

fn rex_wr(reg: i64) -> i64:
    var rx = 0x48
    if reg >= 8:
        rx = rx + 4  # REX.R
    rx

fn rex_wrb(reg: i64, rm: i64) -> i64:
    var rx = 0x48  # REX.W
    if reg >= 8:
        rx = rx + 4  # REX.R
    if rm >= 8:
        rx = rx + 1  # REX.B
    rx

fn rex_wb(rm: i64) -> i64:
    var rx = 0x48  # REX.W
    if rm >= 8:
        rx = rx + 1  # REX.B
    rx

fn rex_rb32(reg: i64, rm: i64) -> i64:
    var rx = 0x40
    if reg >= 8: rx = rx + 4
    if rm >= 8: rx = rx + 1
    rx

fn modrm(md: i64, reg: i64, rm: i64) -> i64:
    ((md % 4) * 64) + ((reg_low3(reg)) * 8) + reg_low3(rm)

fn modrm_direct(reg: i64, rm: i64) -> i64:
    modrm(3, reg, rm)

fn modrm_indirect(reg: i64, rm: i64) -> i64:
    modrm(0, reg, rm)

fn modrm_disp8(reg: i64, rm: i64) -> i64:
    modrm(1, reg, rm)

fn modrm_disp32(reg: i64, rm: i64) -> i64:
    modrm(2, reg, rm)

fn sib_byte(scale: i64, index: i64, base: i64) -> i64:
    ((scale % 4) * 64) + ((reg_low3(index)) * 8) + reg_low3(base)

# Convert signed i64 to bytes
fn i32_byte0(v: i64) -> i64:
    var masked = v
    if masked < 0:
        masked = masked + 4294967296
    masked % 256

fn i32_byte1(v: i64) -> i64:
    var masked = v
    if masked < 0:
        masked = masked + 4294967296
    (masked / 256) % 256

fn i32_byte2(v: i64) -> i64:
    var masked = v
    if masked < 0:
        masked = masked + 4294967296
    (masked / 65536) % 256

fn i32_byte3(v: i64) -> i64:
    var masked = v
    if masked < 0:
        masked = masked + 4294967296
    (masked / 16777216) % 256

fn emit_i32(buf: [i64], value: i64) -> [i64]:
    var result = buf
    result.push(i32_byte0(value))
    result.push(i32_byte1(value))
    result.push(i32_byte2(value))
    result.push(i32_byte3(value))
    result

fn emit_i64_bytes(buf: [i64], value: i64) -> [i64]:
    var result = emit_i32(buf, value % 4294967296)
    result = emit_i32(result, value / 4294967296)
    result

fn fits_in_i8(value: i64) -> bool:
    value >= -128 and value <= 127

fn fits_in_i32(value: i64) -> bool:
    value >= -2147483648 and value <= 2147483647

# ============================================================================
# Instruction Encoding
# ============================================================================

struct EncodeContext:
    code: [i64]
    relocations: [EncodedReloc]
    block_offsets: Dict<i64, i64>
    pending_jumps: [PendingJump]

struct PendingJump:
    code_offset: i64
    target_block: i64
    is_conditional: bool

fn new_encode_context() -> EncodeContext:
    EncodeContext(code: [], relocations: [], block_offsets: {}, pending_jumps: [])

fn encode_function(func: MachFunction) -> EncodedFunction:
    var ectx = new_encode_context()

    # First pass: encode all instructions, record block offsets and pending jumps
    for block in func.blocks:
        # Record block offset
        var offsets = ectx.block_offsets
        offsets[block.block_id] = ectx.code.len()
        ectx = EncodeContext(code: ectx.code, relocations: ectx.relocations, block_offsets: offsets, pending_jumps: ectx.pending_jumps)

        for inst in block.insts:
            ectx = encode_inst(ectx, inst)

    # Second pass: patch jump targets
    for pending in ectx.pending_jumps:
        val target_block = pending.target_block
        if ectx.block_offsets.contains(target_block):
            val target_offset = ectx.block_offsets[target_block]
            val jump_end = pending.code_offset + 4
            val rel32 = target_offset - jump_end
            # Patch the 4-byte displacement at code_offset
            var patched_code = ectx.code
            patched_code[pending.code_offset] = i32_byte0(rel32)
            patched_code[pending.code_offset + 1] = i32_byte1(rel32)
            patched_code[pending.code_offset + 2] = i32_byte2(rel32)
            patched_code[pending.code_offset + 3] = i32_byte3(rel32)
            ectx = EncodeContext(code: patched_code, relocations: ectx.relocations, block_offsets: ectx.block_offsets, pending_jumps: ectx.pending_jumps)

    EncodedFunction(name: func.name, code: ectx.code, relocations: ectx.relocations)

fn encode_inst(ectx: EncodeContext, inst: MachInst) -> EncodeContext:
    var code = ectx.code
    var relocs = ectx.relocations
    var pending = ectx.pending_jumps

    if inst.opcode >= X86_OP_AVX512_LOADU and inst.opcode <= X86_OP_AVX512_EXTRACT_I32:
        var encoded: [i64] = []
        if inst.opcode == X86_OP_AVX512_LOADU:
            val width = get_imm_value(inst.operands[2])
            if width == 64: encoded = encode_avx512_loadu_zmm(get_phys_reg_id(inst.operands[0]), get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]), X86_K0, false)
            elif width == 32: encoded = encode_avx512_loadu_ymm(X86_YMM0 + get_phys_reg_id(inst.operands[0]) - X86_ZMM0, get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]))
            else: panic("AVX-512 LOADU requires a 32- or 64-byte fixed vector")
        elif inst.opcode == X86_OP_AVX512_STOREU:
            val width = get_imm_value(inst.operands[2])
            if width == 64: encoded = encode_avx512_storeu_zmm(get_phys_reg_id(inst.operands[1]), get_mem_base_id(inst.operands[0]), get_mem_offset(inst.operands[0]), X86_K0)
            elif width == 32: encoded = encode_avx512_storeu_ymm(X86_YMM0 + get_phys_reg_id(inst.operands[1]) - X86_ZMM0, get_mem_base_id(inst.operands[0]), get_mem_offset(inst.operands[0]))
            else: panic("AVX-512 STOREU requires a 32- or 64-byte fixed vector")
        elif inst.opcode == X86_OP_AVX512_BINARY:
            encoded = avx512_binop_bytes(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]))
        elif inst.opcode == X86_OP_AVX512_TERNARY:
            encoded = avx512_fma_bytes(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]) != 0)
        elif inst.opcode == X86_OP_AVX512_UNARY:
            encoded = avx512_unop_bytes(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]))
        elif inst.opcode == X86_OP_AVX512_COMPARE:
            encoded = avx512_cmp_bytes(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]))
        elif inst.opcode == X86_OP_AVX512_KLOAD:
            encoded = avx512_kmem_bytes(get_imm_value(inst.operands[0]), get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]), false)
        elif inst.opcode == X86_OP_AVX512_KSTORE:
            encoded = avx512_kmem_bytes(get_imm_value(inst.operands[1]), get_mem_base_id(inst.operands[0]), get_mem_offset(inst.operands[0]), true)
        elif inst.opcode == X86_OP_AVX512_MASK:
            encoded = avx512_kop_bytes(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]))
        elif inst.opcode == X86_OP_AVX512_SELECT:
            val shape = get_imm_value(inst.operands[3])
            encoded = evex_encode_3op_zmm(get_imm_value(inst.operands[0]), get_imm_value(inst.operands[0]), get_imm_value(inst.operands[1]), get_imm_value(inst.operands[2]), false, 3, if shape == 2: 1 else: 0, 1, 0x64)
        elif inst.opcode == X86_OP_AVX512_SPLAT:
            encoded = avx512_splat_bytes(get_imm_value(inst.operands[0]), get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]), get_imm_value(inst.operands[2]))
        elif inst.opcode == X86_OP_AVX512_REDUCE:
            encoded = avx512_reduce_bytes(get_phys_reg_id(inst.operands[0]), get_phys_reg_id(inst.operands[1]), get_mem_base_id(inst.operands[2]), get_mem_offset(inst.operands[2]), get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]))
        elif inst.opcode == X86_OP_AVX512_COPY_LANE:
            val scratch = get_phys_reg_id(inst.operands[0])
            val width = get_imm_value(inst.operands[3])
            encoded = avx512_scalar_mem(scratch, get_mem_base_id(inst.operands[2]), get_mem_offset(inst.operands[2]), width, false) + avx512_scalar_mem(scratch, get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]), width, true)
        elif inst.opcode == X86_OP_AVX512_BOUNDS:
            encoded = avx512_bound_bytes(get_phys_reg_id(inst.operands[0]), get_mem_base_id(inst.operands[1]), get_mem_offset(inst.operands[1]), get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]))
        elif inst.opcode == X86_OP_AVX512_INDEXED:
            encoded = avx512_indexed_bytes(get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]), get_phys_reg_id(inst.operands[2]), get_imm_value(inst.operands[5]), get_imm_value(inst.operands[6]), get_phys_reg_id(inst.operands[0]), get_phys_reg_id(inst.operands[1]), get_imm_value(inst.operands[7]) != 0)
        elif inst.opcode == X86_OP_AVX512_BROADCAST_LANE:
            encoded = avx512_broadcast_lane_bytes(get_imm_value(inst.operands[2]), get_imm_value(inst.operands[3]), get_imm_value(inst.operands[4]), get_phys_reg_id(inst.operands[0]), get_phys_reg_id(inst.operands[1]))
        elif inst.opcode == X86_OP_AVX512_PERMUTE:
            val dest = get_imm_value(inst.operands[0])
            val index = get_imm_value(inst.operands[1])
            val source = get_imm_value(inst.operands[2])
            val shape = get_imm_value(inst.operands[3])
            if shape == 1: encoded = emit_avx512_vpermps_zmm(X86_ZMM0 + dest, X86_ZMM0 + index, X86_ZMM0 + source)
            elif shape == 2: encoded = emit_avx512_vpmovsxdq_zmm_from_ymm(X86_ZMM0 + index, X86_YMM0 + index) + emit_avx512_vpermq(X86_ZMM0 + dest, X86_ZMM0 + index, X86_ZMM0 + source)
            elif shape == 3: encoded = emit_avx512_vpermd(X86_ZMM0 + dest, X86_ZMM0 + index, X86_ZMM0 + source)
            else: panic("unsupported AVX-512 permute shape")
        elif inst.opcode == X86_OP_AVX512_GATHER:
            val dest = get_imm_value(inst.operands[0])
            val index = get_imm_value(inst.operands[1])
            val base = get_phys_reg_id(inst.operands[2])
            val shape = get_imm_value(inst.operands[3])
            encoded = avx512_kall_bytes(1)
            if shape == 1: encoded = encoded + emit_avx512_vgatherdps_zmm(X86_ZMM0 + dest, X86_K0 + 1, X86_ZMM0 + index, base, 4, 0)
            elif shape == 2: encoded = encoded + emit_avx512_vgatherdpd_zmm(X86_ZMM0 + dest, X86_K0 + 1, X86_YMM0 + index, base, 8, 0)
            elif shape == 3: encoded = encoded + emit_avx512_vpgatherdd_zmm(X86_ZMM0 + dest, X86_K0 + 1, X86_ZMM0 + index, base, 4, 0)
            else: panic("unsupported AVX-512 gather shape")
        elif inst.opcode == X86_OP_AVX512_SHUFFLE:
            val control = get_imm_value(inst.operands[0])
            val lhs = get_imm_value(inst.operands[1])
            val rhs = get_imm_value(inst.operands[2])
            val shape = get_imm_value(inst.operands[3])
            if shape == 1 or shape == 3: encoded = emit_avx512_vpermi2d(X86_ZMM0 + control, X86_ZMM0 + lhs, X86_ZMM0 + rhs)
            elif shape == 2: encoded = emit_avx512_vpmovsxdq_zmm_from_ymm(X86_ZMM0 + control, X86_YMM0 + control) + emit_avx512_vpermi2q(X86_ZMM0 + control, X86_ZMM0 + lhs, X86_ZMM0 + rhs)
            else: panic("unsupported AVX-512 shuffle shape")
        elif inst.opcode == X86_OP_AVX512_EXTRACT_I32:
            encoded = avx512_extract_i32_bytes(get_phys_reg_id(inst.operands[0]), get_imm_value(inst.operands[1]))
        else:
            panic("unsupported AVX-512 mask canonicalization reached x86 encoder")
        if encoded.len() == 0: panic("AVX-512 pseudo instruction encoded no bytes")
        for byte in encoded: code.push(byte)

    elif inst.opcode == X86_OP_VMOVAPS_LOAD_ZMM:
        val dest = get_phys_reg_id(inst.operands[0])
        val base = get_mem_base_id(inst.operands[1])
        val offset = get_mem_offset(inst.operands[1])
        val encoded = encode_avx512_load_zmm(dest, base, offset, X86_K0, false)
        if encoded.len() == 0: panic("invalid physical ZMM load operand reached x86 encoder")
        for byte in encoded: code.push(byte)

    elif inst.opcode == X86_OP_VMOVAPS_STORE_ZMM:
        val base = get_mem_base_id(inst.operands[0])
        val offset = get_mem_offset(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        val encoded = encode_avx512_store_zmm(src, base, offset, X86_K0)
        if encoded.len() == 0: panic("invalid physical ZMM store operand reached x86 encoder")
        for byte in encoded: code.push(byte)

    elif inst.opcode >= X86_OP_VADDPS_ZMM and inst.opcode <= X86_OP_VPXORD_ZMM:
        val dest = get_phys_reg_id(inst.operands[0])
        val left = get_phys_reg_id(inst.operands[1])
        val right = get_phys_reg_id(inst.operands[2])
        var encoded: [i64] = []
        if inst.opcode == X86_OP_VADDPS_ZMM: encoded = encode_avx512_add_f32x16(dest, left, right, X86_K0, false)
        elif inst.opcode == X86_OP_VSUBPS_ZMM: encoded = encode_avx512_sub_f32x16(dest, left, right, X86_K0, false)
        elif inst.opcode == X86_OP_VMULPS_ZMM: encoded = encode_avx512_mul_f32x16(dest, left, right, X86_K0, false)
        elif inst.opcode == X86_OP_VDIVPS_ZMM: encoded = encode_avx512_div_f32x16(dest, left, right, X86_K0, false)
        elif inst.opcode == X86_OP_VADDPD_ZMM: encoded = encode_avx512_add_f64x8(dest, left, right)
        elif inst.opcode == X86_OP_VSUBPD_ZMM: encoded = encode_avx512_sub_f64x8(dest, left, right)
        elif inst.opcode == X86_OP_VMULPD_ZMM: encoded = encode_avx512_mul_f64x8(dest, left, right)
        elif inst.opcode == X86_OP_VDIVPD_ZMM: encoded = encode_avx512_div_f64x8(dest, left, right)
        elif inst.opcode == X86_OP_VPADDD_ZMM: encoded = encode_avx512_add_i32x16(dest, left, right)
        elif inst.opcode == X86_OP_VPSUBD_ZMM: encoded = encode_avx512_sub_i32x16(dest, left, right)
        elif inst.opcode == X86_OP_VPMULLD_ZMM: encoded = encode_avx512_mul_i32x16(dest, left, right)
        elif inst.opcode == X86_OP_VPANDD_ZMM: encoded = encode_avx512_and_i32x16(dest, left, right)
        elif inst.opcode == X86_OP_VPORD_ZMM: encoded = encode_avx512_or_i32x16(dest, left, right)
        else: encoded = encode_avx512_xor_i32x16(dest, left, right)
        if encoded.len() == 0: panic("invalid physical ZMM binop operand reached x86 encoder")
        for byte in encoded: code.push(byte)

    elif inst.opcode == X86_OP_VMOVAPS_LOAD_YMM:
        val dest = get_phys_reg_id(inst.operands[0])
        val base = get_mem_base_id(inst.operands[1])
        val offset = get_mem_offset(inst.operands[1])
        code = encode_avx2_aligned_mem(code, 0x28, dest, base, offset)

    elif inst.opcode == X86_OP_VMOVAPS_STORE_YMM:
        val base = get_mem_base_id(inst.operands[0])
        val offset = get_mem_offset(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code = encode_avx2_aligned_mem(code, 0x29, src, base, offset)

    elif inst.opcode == X86_OP_VADDPS_YMM or inst.opcode == X86_OP_VSUBPS_YMM or inst.opcode == X86_OP_VMULPS_YMM or inst.opcode == X86_OP_VDIVPS_YMM:
        val dest = get_phys_reg_id(inst.operands[0])
        val left = get_phys_reg_id(inst.operands[1])
        val right = get_phys_reg_id(inst.operands[2])
        var encoded: [i64] = []
        if inst.opcode == X86_OP_VADDPS_YMM: encoded = encode_vaddps_ymm(dest, left, right)
        elif inst.opcode == X86_OP_VSUBPS_YMM: encoded = encode_vsubps_ymm(dest, left, right)
        elif inst.opcode == X86_OP_VMULPS_YMM: encoded = encode_vmulps_ymm(dest, left, right)
        else: encoded = encode_vdivps_ymm(dest, left, right)
        if encoded.len() == 0:
            panic("invalid physical YMM operand reached x86 encoder")
        for byte in encoded: code.push(byte)

    elif inst.opcode == X86_OP_NOP:
        code.push(0x90)

    elif inst.opcode == X86_OP_INT3:
        code.push(0xcc)

    elif inst.opcode == X86_OP_RET:
        code.push(0xc3)

    elif inst.opcode == X86_OP_CQO:
        # REX.W + 99
        code.push(0x48)
        code.push(0x99)

    elif inst.opcode == X86_OP_SYSCALL:
        code.push(0x0f)
        code.push(0x05)

    elif inst.opcode == X86_OP_BSWAP:
        val dst = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(dst))
        code.push(0x0f)
        code.push(0xc8 + reg_low3(dst))

    elif inst.opcode == X86_OP_POPCNT:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(0xf3)
        code.push(rex_wrb(dst, src))
        code.push(0x0f)
        code.push(0xb8)
        code.push(modrm_direct(dst, src))

    elif inst.opcode == X86_OP_MOV_REG_REG:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x89)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_MOV_REG_IMM:
        val dst = get_phys_reg_id(inst.operands[0])
        val imm = get_imm_value(inst.operands[1])
        # REX.W + B8+rd + imm64
        code.push(rex_wb(dst))
        code.push(0xb8 + reg_low3(dst))
        code = emit_i64_bytes(code, imm)

    elif inst.opcode == X86_OP_MOV_REG_IMM32:
        val dst = get_phys_reg_id(inst.operands[0])
        val imm = get_imm_value(inst.operands[1])
        if dst >= 8:
            code.push(0x41)
        code.push(0xb8 + reg_low3(dst))
        code = emit_i32(code, imm)

    elif inst.opcode == X86_OP_MOV_REG_MEM:
        val dst = get_phys_reg_id(inst.operands[0])
        match inst.operands[1].kind:
            case Sym(name):
                code.push(rex_wr(dst))
                code.push(0x8b)
                code.push(modrm(0, dst, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[1])
                val offset = get_mem_offset(inst.operands[1])
                code.push(rex_wrb(dst, base))
                code.push(0x8b)
                code = encode_mem_operand(code, dst, base, offset)

    elif inst.opcode == X86_OP_MOV_MEM_REG:
        val src = get_phys_reg_id(inst.operands[1])
        match inst.operands[0].kind:
            case Sym(name):
                code.push(rex_wr(src))
                code.push(0x89)
                code.push(modrm(0, src, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[0])
                val offset = get_mem_offset(inst.operands[0])
                code.push(rex_wrb(src, base))
                code.push(0x89)
                code = encode_mem_operand(code, src, base, offset)

    elif inst.opcode == X86_OP_MOVZX_REG_MEM8 or inst.opcode == X86_OP_MOVZX_REG_MEM16:
        val dst = get_phys_reg_id(inst.operands[0])
        match inst.operands[1].kind:
            case Sym(name):
                code.push(rex_wr(dst))
                code.push(0x0f)
                if inst.opcode == X86_OP_MOVZX_REG_MEM8: code.push(0xb6)
                else: code.push(0xb7)
                code.push(modrm(0, dst, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[1])
                val offset = get_mem_offset(inst.operands[1])
                code.push(rex_wrb(dst, base))
                code.push(0x0f)
                if inst.opcode == X86_OP_MOVZX_REG_MEM8: code.push(0xb6)
                else: code.push(0xb7)
                code = encode_mem_operand(code, dst, base, offset)

    elif inst.opcode == X86_OP_MOV_REG_MEM32:
        val dst = get_phys_reg_id(inst.operands[0])
        match inst.operands[1].kind:
            case Sym(name):
                code.push(rex_rb32(dst, 5))
                code.push(0x8b)
                code.push(modrm(0, dst, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[1])
                val offset = get_mem_offset(inst.operands[1])
                code.push(rex_rb32(dst, base))
                code.push(0x8b)
                code = encode_mem_operand(code, dst, base, offset)

    elif inst.opcode == X86_OP_MOVSX_REG_MEM8 or inst.opcode == X86_OP_MOVSX_REG_MEM16 or inst.opcode == X86_OP_MOVSX_REG_MEM32:
        val dst = get_phys_reg_id(inst.operands[0])
        match inst.operands[1].kind:
            case Sym(name):
                code.push(rex_wr(dst))
                if inst.opcode == X86_OP_MOVSX_REG_MEM32: code.push(0x63)
                else:
                    code.push(0x0f)
                    if inst.opcode == X86_OP_MOVSX_REG_MEM8: code.push(0xbe)
                    else: code.push(0xbf)
                code.push(modrm(0, dst, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[1])
                val offset = get_mem_offset(inst.operands[1])
                code.push(rex_wrb(dst, base))
                if inst.opcode == X86_OP_MOVSX_REG_MEM32: code.push(0x63)
                else:
                    code.push(0x0f)
                    if inst.opcode == X86_OP_MOVSX_REG_MEM8: code.push(0xbe)
                    else: code.push(0xbf)
                code = encode_mem_operand(code, dst, base, offset)

    elif inst.opcode == X86_OP_MOV_MEM8_REG or inst.opcode == X86_OP_MOV_MEM16_REG or inst.opcode == X86_OP_MOV_MEM32_REG:
        val src = get_phys_reg_id(inst.operands[1])
        match inst.operands[0].kind:
            case Sym(name):
                if inst.opcode == X86_OP_MOV_MEM16_REG: code.push(0x66)
                code.push(rex_rb32(src, 5))
                if inst.opcode == X86_OP_MOV_MEM8_REG: code.push(0x88)
                else: code.push(0x89)
                code.push(modrm(0, src, 5))
                relocs.push(EncodedReloc(offset: code.len(), symbol_name: name, reloc_type: 2, addend: -4))
                code = emit_i32(code, 0)
            case _:
                val base = get_mem_base_id(inst.operands[0])
                val offset = get_mem_offset(inst.operands[0])
                if inst.opcode == X86_OP_MOV_MEM16_REG: code.push(0x66)
                code.push(rex_rb32(src, base))
                if inst.opcode == X86_OP_MOV_MEM8_REG: code.push(0x88)
                else: code.push(0x89)
                code = encode_mem_operand(code, src, base, offset)

    elif inst.opcode == X86_OP_ADD:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x01)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_ADD_IMM:
        val dst = get_phys_reg_id(inst.operands[0])
        val imm = get_imm_value(inst.operands[1])
        code.push(rex_wb(dst))
        code.push(0x81)
        code.push(modrm_direct(0, dst))
        code = emit_i32(code, imm)

    elif inst.opcode == X86_OP_SUB:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x29)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_SUB_IMM:
        val dst = get_phys_reg_id(inst.operands[0])
        val imm = get_imm_value(inst.operands[1])
        if imm == 0:
            # No-op for sub rsp, 0
            code.push(0x90)
        else:
            code.push(rex_wb(dst))
            code.push(0x81)
            code.push(modrm_direct(5, dst))  # /5 = sub
            code = emit_i32(code, imm)

    elif inst.opcode == X86_OP_IMUL:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(dst, src))
        code.push(0x0f)
        code.push(0xaf)
        code.push(modrm_direct(dst, src))

    elif inst.opcode == X86_OP_IDIV:
        val src = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(src))
        code.push(0xf7)
        code.push(modrm_direct(7, src))  # /7 = idiv

    elif inst.opcode == X86_OP_AND:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x21)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_OR:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x09)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_XOR:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(src, dst))
        code.push(0x31)
        code.push(modrm_direct(src, dst))

    elif inst.opcode == X86_OP_SHL:
        val dst = get_phys_reg_id(inst.operands[0])
        # SHL r/m64, cl (D3 /4)
        code.push(rex_wb(dst))
        code.push(0xd3)
        code.push(modrm_direct(4, dst))

    elif inst.opcode == X86_OP_SAR:
        val dst = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(dst))
        code.push(0xd3)
        code.push(modrm_direct(7, dst))

    elif inst.opcode == X86_OP_SHR:
        val dst = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(dst))
        code.push(0xd3)
        code.push(modrm_direct(5, dst))

    elif inst.opcode == X86_OP_NEG:
        val dst = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(dst))
        code.push(0xf7)
        code.push(modrm_direct(3, dst))

    elif inst.opcode == X86_OP_NOT:
        val dst = get_phys_reg_id(inst.operands[0])
        code.push(rex_wb(dst))
        code.push(0xf7)
        code.push(modrm_direct(2, dst))

    elif inst.opcode == X86_OP_CMP:
        val left = get_phys_reg_id(inst.operands[0])
        val right = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(right, left))
        code.push(0x39)
        code.push(modrm_direct(right, left))

    elif inst.opcode == X86_OP_CMP_IMM:
        val dst = get_phys_reg_id(inst.operands[0])
        val imm = get_imm_value(inst.operands[1])
        code.push(rex_wb(dst))
        code.push(0x81)
        code.push(modrm_direct(7, dst))  # /7 = cmp
        code = emit_i32(code, imm)

    elif inst.opcode == X86_OP_TEST:
        val left = get_phys_reg_id(inst.operands[0])
        val right = get_phys_reg_id(inst.operands[1])
        code.push(rex_wrb(right, left))
        code.push(0x85)
        code.push(modrm_direct(right, left))

    elif inst.opcode == X86_OP_SETE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x94, dst)

    elif inst.opcode == X86_OP_SETNE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x95, dst)

    elif inst.opcode == X86_OP_SETL:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x9c, dst)

    elif inst.opcode == X86_OP_SETLE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x9e, dst)

    elif inst.opcode == X86_OP_SETG:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x9f, dst)

    elif inst.opcode == X86_OP_SETGE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x9d, dst)

    elif inst.opcode == X86_OP_SETB:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x92, dst)

    elif inst.opcode == X86_OP_SETBE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x96, dst)

    elif inst.opcode == X86_OP_SETA:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x97, dst)

    elif inst.opcode == X86_OP_SETAE:
        val dst = get_phys_reg_id(inst.operands[0])
        code = encode_setcc(code, 0x93, dst)

    elif inst.opcode == X86_OP_MOVZX:
        val dst = get_phys_reg_id(inst.operands[0])
        val src = get_phys_reg_id(inst.operands[1])
        # movzx r64, r8 -> REX.W + 0F B6 /r
        code.push(rex_wrb(dst, src))
        code.push(0x0f)
        code.push(0xb6)
        code.push(modrm_direct(dst, src))

    elif inst.opcode == X86_OP_LEA:
        val dst = get_phys_reg_id(inst.operands[0])
        # Check if second operand is a symbol or memory
        match inst.operands[1].kind:
            case Sym(name):
                # LEA with RIP-relative addressing for symbol
                code.push(rex_wr(dst))
                code.push(0x8d)
                code.push(modrm(0, dst, 5))  # [rip+disp32]
                # Record relocation
                val reloc = EncodedReloc(
                    offset: code.len(),
                    symbol_name: name,
                    reloc_type: 2,  # R_X86_64_PC32
                    addend: -4
                )
                relocs.push(reloc)
                code = emit_i32(code, 0)  # Placeholder
            case Mem(base, offset):
                val base_id = reg_id(base)
                code.push(rex_wrb(dst, base_id))
                code.push(0x8d)
                code = encode_mem_operand(code, dst, base_id, offset)
            case _:
                code.push(0x90)  # NOP fallback

    elif inst.opcode == X86_OP_PUSH:
        val src = get_phys_reg_id(inst.operands[0])
        if src >= 8:
            code.push(0x41)  # REX.B
        code.push(0x50 + reg_low3(src))

    elif inst.opcode == X86_OP_POP:
        val dst = get_phys_reg_id(inst.operands[0])
        if dst >= 8:
            code.push(0x41)  # REX.B
        code.push(0x58 + reg_low3(dst))

    elif inst.opcode == X86_OP_JMP:
        match inst.operands[0].kind:
            case Label(block_id):
                code.push(0xe9)  # JMP rel32
                val jump_offset = code.len()
                code = emit_i32(code, 0)  # Placeholder
                pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: false))
            case _:
                code.push(0x90)

    elif inst.opcode == X86_OP_JE:
        val block_id = get_label_id(inst.operands[0])
        code.push(0x0f)
        code.push(0x84)  # JE rel32
        val jump_offset = code.len()
        code = emit_i32(code, 0)
        pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: true))

    elif inst.opcode == X86_OP_JNE:
        val block_id = get_label_id(inst.operands[0])
        code.push(0x0f)
        code.push(0x85)  # JNE rel32
        val jump_offset = code.len()
        code = emit_i32(code, 0)
        pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: true))

    elif inst.opcode == X86_OP_JNZ:
        val block_id = get_label_id(inst.operands[0])
        code.push(0x0f)
        code.push(0x85)  # JNZ = JNE rel32
        val jump_offset = code.len()
        code = emit_i32(code, 0)
        pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: true))

    elif inst.opcode == X86_OP_JZ:
        val block_id = get_label_id(inst.operands[0])
        code.push(0x0f)
        code.push(0x84)  # JZ = JE rel32
        val jump_offset = code.len()
        code = emit_i32(code, 0)
        pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: true))

    elif inst.opcode == X86_OP_CALL:
        match inst.operands[0].kind:
            case Sym(name):
                code.push(0xe8)  # CALL rel32
                val reloc = EncodedReloc(
                    offset: code.len(),
                    symbol_name: name,
                    reloc_type: 4,  # R_X86_64_PLT32
                    addend: -4
                )
                relocs.push(reloc)
                code = emit_i32(code, 0)  # Placeholder
            case Label(block_id):
                code.push(0xe8)
                val jump_offset = code.len()
                code = emit_i32(code, 0)
                pending.push(PendingJump(code_offset: jump_offset, target_block: block_id, is_conditional: false))
            case _:
                code.push(0x90)

    elif inst.opcode == X86_OP_CALL_INDIRECT:
        val src = get_phys_reg_id(inst.operands[0])
        # call *reg: FF /2
        code.push(rex_wb(src))
        code.push(0xff)
        code.push(modrm_direct(2, src))

    else:
        # Unknown opcode - emit NOP
        code.push(0x90)

    EncodeContext(code: code, relocations: relocs, block_offsets: ectx.block_offsets, pending_jumps: pending)

fn encode_avx2_aligned_mem(code: [i64], opcode: i64, ymm: i64, base: i64, offset: i64) -> [i64]:
    val ymm_idx = ymm_to_index(ymm)
    if ymm_idx < 0 or ymm_idx >= 8 or base < 0 or base > 15:
        panic("invalid VMOVAPS operand reached x86 encoder")
    if offset < -2147483648 or offset > 2147483647:
        panic("VMOVAPS displacement exceeds signed i32")
    var result = code
    val inverted_b = if base < 8: 32 else: 0
    result.push(0xC4)
    result.push(0xC1 + inverted_b)
    result.push(0x7C)
    result.push(opcode)
    val base_low = base % 8
    if base_low == 4:
        result.push(modrm_disp32(ymm_idx, 4))
        result.push(sib_byte(0, 4, base_low))
    else:
        result.push(modrm_disp32(ymm_idx, base_low))
    emit_i32(result, offset)

# ============================================================================
# Memory Operand Encoding Helper
# ============================================================================

fn encode_mem_operand(code: [i64], reg: i64, base: i64, offset: i64) -> [i64]:
    var result = code
    val base_low = reg_low3(base)

    if base_low == 4:
        # RSP/R12 needs SIB byte
        if offset == 0:
            result.push(modrm_indirect(reg, base))
            result.push(sib_byte(0, 4, base))  # SIB: no index, RSP base
        elif fits_in_i8(offset):
            result.push(modrm_disp8(reg, base))
            result.push(sib_byte(0, 4, base))
            result.push(i32_byte0(offset))
        else:
            result.push(modrm_disp32(reg, base))
            result.push(sib_byte(0, 4, base))
            result = emit_i32(result, offset)
    elif base_low == 5:
        if offset == 0:
            # RBP/R13 with disp=0 needs explicit disp8(0)
            result.push(modrm_disp8(reg, base))
            result.push(0)
    else:
        if offset == 0:
            result.push(modrm_indirect(reg, base))
        elif fits_in_i8(offset):
            result.push(modrm_disp8(reg, base))
            result.push(i32_byte0(offset))
        else:
            result.push(modrm_disp32(reg, base))
            result = emit_i32(result, offset)

    result

# ============================================================================
# SetCC Encoding Helper
# ============================================================================

fn encode_setcc(code: [i64], cc_opcode: i64, dst: i64) -> [i64]:
    var result = code
    # setCC uses 8-bit register, need REX if dst >= 4 (spl, bpl, sil, dil)
    if dst >= 8:
        result.push(0x41)  # REX.B
    elif dst >= 4:
        result.push(0x40)  # REX (for spl etc.)
    result.push(0x0f)
    result.push(cc_opcode)
    result.push(modrm_direct(0, dst))
    result

# ============================================================================
# Module Encoding
# ============================================================================

fn encode_module(module: MachModule) -> [EncodedFunction]:
    encode_module_with(module, encode_function)

