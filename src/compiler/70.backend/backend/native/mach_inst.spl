# ============================================================================
# Machine Instruction Operands
# ============================================================================

enum OperandKind:
    Reg(reg: MachReg)
    Imm(value: i64)
    Mem(base: MachReg, offset: i64)
    Label(block_id: i64)
    Sym(name: text)

struct Operand:
    kind: OperandKind

fn op_reg(reg: MachReg) -> Operand:
    Operand(kind: OperandKind.Reg(reg))

fn op_phys(id: i64) -> Operand:
    Operand(kind: OperandKind.Reg(physical_reg(id)))

fn op_virt(id: i64) -> Operand:
    Operand(kind: OperandKind.Reg(virtual_reg(id)))

fn op_imm(value: i64) -> Operand:
    Operand(kind: OperandKind.Imm(value))

fn op_mem(base: MachReg, offset: i64) -> Operand:
    Operand(kind: OperandKind.Mem(base, offset))

fn op_label(block_id: i64) -> Operand:
    Operand(kind: OperandKind.Label(block_id))

fn op_sym(name: text) -> Operand:
    Operand(kind: OperandKind.Sym(name))

fn operand_is_reg(op: Operand) -> bool:
    match op.kind:
        case Reg(_): true
        case _: false

fn operand_get_reg(op: Operand) -> MachReg:
    match op.kind:
        case Reg(r): r
        case _: virtual_reg(0)

