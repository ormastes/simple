val X86_XMM10: i64 = 74
val X86_XMM11: i64 = 75
val X86_XMM12: i64 = 76
val X86_XMM13: i64 = 77
val X86_XMM14: i64 = 78
val X86_XMM15: i64 = 79
val X86_YMM0: i64 = 96
val X86_YMM1: i64 = 97
val X86_YMM2: i64 = 98
val X86_YMM3: i64 = 99
val X86_YMM4: i64 = 100
val X86_YMM5: i64 = 101
val X86_YMM6: i64 = 102
val X86_YMM7: i64 = 103
val X86_YMM8: i64 = 104
val X86_YMM9: i64 = 105
val X86_YMM10: i64 = 106
val X86_YMM11: i64 = 107
val X86_YMM12: i64 = 108
val X86_YMM13: i64 = 109
val X86_YMM14: i64 = 110
val X86_YMM15: i64 = 111

val X86_XMM_ALLOCATABLE = [
    X86_XMM0, X86_XMM1, X86_XMM2, X86_XMM3,
    X86_XMM4, X86_XMM5, X86_XMM6, X86_XMM7
]
val X86_YMM_ALLOCATABLE = [
    X86_YMM0, X86_YMM1, X86_YMM2, X86_YMM3,
    X86_YMM4, X86_YMM5, X86_YMM6, X86_YMM7
]

fn x86_reg_name(id: i64) -> text:
    if id == X86_RAX: "rax"
    elif id == X86_RCX: "rcx"
    elif id == X86_RDX: "rdx"
    elif id == X86_RBX: "rbx"
    elif id == X86_RSP: "rsp"
    elif id == X86_RBP: "rbp"
    elif id == X86_RSI: "rsi"
    elif id == X86_RDI: "rdi"
    elif id == X86_R8: "r8"
    elif id == X86_R9: "r9"
    elif id == X86_R10: "r10"
    elif id == X86_R11: "r11"
    elif id == X86_R12: "r12"
    elif id == X86_R13: "r13"
    elif id == X86_R14: "r14"
    elif id == X86_R15: "r15"
    else: "r?"

