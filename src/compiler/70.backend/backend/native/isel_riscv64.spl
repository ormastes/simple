# RISC-V 64-bit Instruction Selection
#
# Translates MIR instructions to RISC-V 64-bit (RV64I+M) MachInst sequences.
# Pattern-matches on MirInstKind to produce low-level machine instructions.
# Follows the RISC-V LP64 calling convention for function calls.
#
# RISC-V 64-bit conventions:
# - x0 = zero (hardwired zero), x1 = ra (return address), x2 = sp
# - x3 = gp, x4 = tp, x5-x7 = t0-t2 (temporaries)
# - x8 = s0/fp (frame pointer), x9 = s1
# - x10-x17 = a0-a7 (arguments, a0-a1 = return values)
# - x18-x27 = s2-s11 (callee-saved)
# - x28-x31 = t3-t6 (temporaries)
# - All instructions are 32-bit fixed width (RV64I base + M extension)
#
# Pipeline: MIR -> ISel (this module) -> RegAlloc -> Encode -> ELF

use compiler.mir.mir_data.{MirModule, MirFunction, MirBlock, MirInst, MirInstKind, MirBinOp, MirUnaryOp, MirOperand, MirOperandKind, MirConstValue, MirTerminator, MirType, MirTypeKind, MirStatic, LocalId, LocalKind, BlockId, SwitchCase}
use compiler.backend.native.mach_inst.{MachReg, virtual_reg, physical_reg, reg_id, Operand, OperandKind, op_reg, op_phys, op_virt, op_imm, op_mem, op_label, op_sym, operand_get_reg, MachInst, new_mach_inst, MachBlock, new_mach_block, mach_block_add_inst, MachFunction, new_mach_function, mach_func_add_block, mach_func_set_frame_size, MachModule, DataEntry, new_mach_module, mach_module_add_func, mach_module_add_data, mach_module_add_extern}
use compiler.backend.common.isel_common.{LoweredOperand, ISelFuncResult, ISelBlockResult, ISelInstResult, local_to_vreg, local_vreg_op, isel_fresh_dest, isel_emit_one}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.backend.riscv_target.{RiscvTargetContract, riscv_linux_target_contract}
use compiler.mir.intrinsics.{BIT_ROTATE_LEFT, BIT_ROTATE_RIGHT, BIT_CLZ, BIT_CTZ, BIT_BSWAP}
use compiler.backend.native.mach_inst.{RV_X0, RV_X1, RV_X2, RV_X3, RV_X4, RV_X5, RV_X6, RV_X7, RV_X8, RV_X9, RV_X10, RV_X11, RV_X12, RV_X13, RV_X14, RV_X15, RV_X16, RV_X17, RV_X18, RV_X19, RV_X20, RV_X21, RV_X22, RV_X23, RV_X24, RV_X25, RV_X26, RV_X27, RV_X28, RV_X29, RV_X30, RV_X31}
use compiler.backend.native.mach_inst.{RV_ARG_REGS, RV_CALLEE_SAVED}
use compiler.backend.native.mach_inst.{RV_OP_ADD, RV_OP_SUB, RV_OP_MUL, RV_OP_DIV, RV_OP_REM, RV_OP_AND, RV_OP_OR, RV_OP_XOR, RV_OP_SLL, RV_OP_SRA, RV_OP_SRL, RV_OP_SLT, RV_OP_SLTU, RV_OP_ADDI, RV_OP_LUI, RV_OP_AUIPC, RV_OP_JAL, RV_OP_JALR, RV_OP_BEQ, RV_OP_BNE, RV_OP_BLT, RV_OP_BGE, RV_OP_LD, RV_OP_SD, RV_OP_LW, RV_OP_LWU, RV_OP_SW, RV_OP_MV, RV_OP_LI, RV_OP_NOP, RV_OP_EBREAK, RV_OP_RET, RV_OP_CALL, RV_OP_NEG, RV_OP_NOT, RV_OP_SEQZ, RV_OP_SNEZ, RV_OP_ROL, RV_OP_ROR, RV_OP_CLZ, RV_OP_CTZ, RV_OP_REV8}
use compiler.backend.common.isel_context.{ISelContext, new_isel_context, isel_alloc_vreg, isel_get_vreg, isel_alloc_frame_slot, isel_frame_offset, isel_add_extern, isel_add_string_data, isel_last_string_label}
use compiler.backend.common.ascii_utils.{char_to_ascii}

fn rv64_linux_contract() -> RiscvTargetContract:
    riscv_linux_target_contract(CodegenTarget.Riscv64)

val RV64_WORD_SIZE: i64 = rv64_linux_contract().pointer_bits / 8

fn rv64_imm12_fits(value: i64) -> bool:
    value >= -2048 and value <= 2047

fn rv64_adjust_sp(delta: i64) -> [MachInst]:
    if rv64_imm12_fits(delta):
        [new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(delta)])]
    else:
        [
            new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(delta)]),
            new_mach_inst(RV_OP_ADD, [op_phys(RV_X2), op_phys(RV_X2), op_phys(RV_X31)])
        ]

fn rv64_set_fp(frame_size: i64) -> [MachInst]:
    if rv64_imm12_fits(frame_size):
        [new_mach_inst(RV_OP_ADDI, [op_phys(RV_X8), op_phys(RV_X2), op_imm(frame_size)])]
    else:
        [
            new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(frame_size)]),
            new_mach_inst(RV_OP_ADD, [op_phys(RV_X8), op_phys(RV_X2), op_phys(RV_X31)])
        ]

fn rv64_store_stack(reg: i64, offset: i64) -> [MachInst]:
    if rv64_imm12_fits(offset):
        [new_mach_inst(RV_OP_SD, [op_phys(reg), op_mem(physical_reg(RV_X2), offset)])]
    else:
        [
            new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(offset)]),
            new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]),
            new_mach_inst(RV_OP_SD, [op_phys(reg), op_mem(physical_reg(RV_X31), 0)])
        ]

fn rv64_load_stack(reg: i64, offset: i64) -> [MachInst]:
    if rv64_imm12_fits(offset):
        [new_mach_inst(RV_OP_LD, [op_phys(reg), op_mem(physical_reg(RV_X2), offset)])]
    else:
        [
            new_mach_inst(RV_OP_LI, [op_phys(RV_X31), op_imm(offset)]),
            new_mach_inst(RV_OP_ADD, [op_phys(RV_X31), op_phys(RV_X2), op_phys(RV_X31)]),
            new_mach_inst(RV_OP_LD, [op_phys(reg), op_mem(physical_reg(RV_X31), 0)])
        ]

fn rv64_patch_prologue(block: MachBlock, frame_size: i64) -> MachBlock:
    var insts: [MachInst] = []
    for inst in rv64_adjust_sp(0 - frame_size):
        insts.push(inst)
    for inst in rv64_store_stack(RV_X1, frame_size - RV64_WORD_SIZE):
        insts.push(inst)
    for inst in rv64_store_stack(RV_X8, frame_size - (RV64_WORD_SIZE * 2)):
        insts.push(inst)
    for inst in rv64_set_fp(frame_size):
        insts.push(inst)
    for i in 4..block.insts.len():
        insts.push(block.insts[i])
    MachBlock(label: block.label, insts: insts, block_id: block.block_id, offset: block.offset)

fn rv64_patch_epilogue(block: MachBlock, frame_size: i64) -> MachBlock:
    if block.insts.len() < 4:
        return block
    val tail = block.insts.len() - 4
    if block.insts[tail + 3].opcode != RV_OP_RET:
        return block
    var insts: [MachInst] = []
    for i in 0..tail:
        insts.push(block.insts[i])
    for inst in rv64_load_stack(RV_X1, frame_size - RV64_WORD_SIZE):
        insts.push(inst)
    for inst in rv64_load_stack(RV_X8, frame_size - (RV64_WORD_SIZE * 2)):
        insts.push(inst)
    for inst in rv64_adjust_sp(frame_size):
        insts.push(inst)
    insts.push(new_mach_inst(RV_OP_RET, []))
    MachBlock(label: block.label, insts: insts, block_id: block.block_id, offset: block.offset)

fn rv64_patch_frame(func: MachFunction, frame_size: i64, outgoing_arg_size: i64) -> MachFunction:
    var blocks: [MachBlock] = []
    for i in 0..func.blocks.len():
        if i == 0:
            blocks.push(rv64_patch_prologue(func.blocks[i], frame_size))
        else:
            blocks.push(rv64_patch_epilogue(func.blocks[i], frame_size))
    MachFunction(name: func.name, blocks: blocks, frame_size: frame_size,
        num_virtual_regs: func.num_virtual_regs, used_callee_saved: func.used_callee_saved,
        outgoing_arg_size: outgoing_arg_size)

fn rv64_call_stack_arg_size(argument_count: i64) -> i64:
    if argument_count <= RV_ARG_REGS.len(): return 0
    (argument_count - RV_ARG_REGS.len()) * RV64_WORD_SIZE

fn rv64_function_outgoing_arg_size(func: MirFunction) -> i64:
    var size = 0
    for block in func.blocks:
        for inst in block.instructions:
            val candidate = match inst.kind:
                case Call(_, _, args): rv64_call_stack_arg_size(args.len())
                case CallIndirect(_, _, args, _): rv64_call_stack_arg_size(args.len())
                case _: 0
            if candidate > size: size = candidate
        match block.terminator:
            case CallTerminator(_, _, args, _, _, _, _):
                val candidate = rv64_call_stack_arg_size(args.len())
                if candidate > size: size = candidate
            case _: ()
    size

# ============================================================================
# Operand Lowering
# ============================================================================

fn rv_lower_operand(ctx: ISelContext, operand: MirOperand) -> LoweredOperand:
    match operand.kind:
        case Copy(local):
            LoweredOperand(insts: [], result: local_vreg_op(local.id), ctx: ctx)
        case Move(local):
            LoweredOperand(insts: [], result: local_vreg_op(local.id), ctx: ctx)
        case Const(const_value, const_type):
            rv_lower_const(ctx, const_value, const_type)

fn rv_lower_const(ctx: ISelContext, value: MirConstValue, type_: MirType) -> LoweredOperand:
    match value:
        case Int(v):
            rv_lower_const_int(ctx, v)
        case Bool(v):
            val imm_val = if v: 1 else: 0
            isel_emit_one(ctx, RV_OP_LI, [op_imm(imm_val)])
        case Str(s):
            var new_ctx = isel_add_string_data(ctx, s, char_to_ascii)
            val label = isel_last_string_label(new_ctx)
            val low = isel_fresh_dest(new_ctx)
            val auipc_inst = new_mach_inst(RV_OP_AUIPC, [low.result, op_sym(label)])
            val addi_inst = new_mach_inst(RV_OP_ADDI, [low.result, low.result, op_sym(label)])
            LoweredOperand(insts: [auipc_inst, addi_inst], result: low.result, ctx: low.ctx)
        case Zero:
            isel_emit_one(ctx, RV_OP_LI, [op_imm(0)])
        case _:
            rv_lower_const_unsupported(ctx, "constant kind")

fn rv_lower_const_int(ctx: ISelContext, v: i64) -> LoweredOperand:
    # RISC-V LI is a pseudo-instruction that the assembler/encoder expands
    # to LUI + ADDI (or longer sequences) as needed. At ISel level we emit
    # a single LI pseudo and let the encoder handle materialization.
    isel_emit_one(ctx, RV_OP_LI, [op_imm(v)])

fn rv_isel_unsupported(ctx: ISelContext, message: text) -> ISelInstResult:
    print("RV64 ISel unsupported: {message}")
    ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)

fn rv_lower_const_unsupported(ctx: ISelContext, message: text) -> LoweredOperand:
    print("RV64 ISel unsupported: {message}")
    val low = isel_fresh_dest(ctx)
    LoweredOperand(insts: [new_mach_inst(RV_OP_NOP, [])], result: low.result, ctx: low.ctx)

# ============================================================================
# Instruction Selection - Core Entry Point
# ============================================================================

fn rv_module_has_scalable_vec(module: MirModule) -> bool:
    """Return true if any function local has ScalableVec type (deferred lowering guard)."""
    val func_keys = module.functions.keys()
    for key in func_keys:
        val func = module.functions[key]
        for local in func.locals:
            match local.type_.kind:
                case ScalableVec(_, _): return true
                case _: ()
    false

fn isel_module_riscv64(module: MirModule) -> MachModule:
    # Deferred diagnostic: ScalableVec lowering not yet implemented for RV64.
    # NativeCodegenAdapter intercepts scalable MIR before reaching ISel;
    # this guard is a safety net if ISel is called directly.
    if rv_module_has_scalable_vec(module):
        print("riscv_v_native_lowering_deferred")
    var mach_module = new_mach_module(module.name)
    var ctx = new_isel_context()

    var static_ids: [i64] = []
    var static_by_id: Dict<i64, MirStatic> = {}
    for symbol in module.statics.keys():
        static_ids.push(symbol.id)
        static_by_id[symbol.id] = module.statics[symbol]
    static_ids.sort()
    var names: Dict<i64, text> = {}
    var sizes: Dict<i64, i64> = {}
    var mutability: Dict<i64, bool> = {}
    var signedness: Dict<i64, bool> = {}
    var entries: [DataEntry] = []
    for symbol_id in static_ids:
        val static_ = static_by_id[symbol_id]
        val size = rv64_static_size(static_)
        val natural = static_.type_.alignment()
        val align = if static_.alignment > 0: static_.alignment else: natural
        if not rv64_static_alignment_valid(natural, static_.alignment):
            panic("riscv64 native static '{static_.name}' alignment {align} is invalid for natural alignment {natural}")
        entries.push(DataEntry(name: static_.name, data: rv64_static_initializer_bytes(static_, size), is_readonly: not static_.is_mutable, alignment: align, is_global: static_.visibility.is_public()))
        names[symbol_id] = static_.name
        sizes[symbol_id] = size
        mutability[symbol_id] = static_.is_mutable
        signedness[symbol_id] = match static_.type_.kind:
            case I32: true
            case _: false
    ctx = ISelContext(next_vreg: 0, frame_slots: {}, next_frame_offset: 0,
        extern_symbols: [], data_entries: entries, string_counter: 0,
        global_names: names, global_sizes: sizes, global_signed: signedness, global_mutable: mutability)

    val func_keys = module.functions.keys()
    for key in func_keys:
        val func = module.functions[key]
        var result = rv_isel_function(ctx, func)
        ctx = result.ctx
        mach_module = mach_module_add_func(mach_module, result.func)

    # Add data entries from string constants
    for entry in ctx.data_entries:
        mach_module = mach_module_add_data(mach_module, entry)

    # Add extern symbols
    for sym in ctx.extern_symbols:
        mach_module = mach_module_add_extern(mach_module, sym)

    mach_module

fn rv64_static_size(static_: MirStatic) -> i64:
    match static_.type_.kind:
        case I32 | U32: 4
        case Ptr(_, _) | Ref(_, _) | FuncPtr(_): 8
        case _: panic("riscv64 native static '{static_.name}' has unsupported non-u32/pointer object type")

fn rv64_static_type_supported(type_: MirType) -> bool:
    match type_.kind:
        case I32 | U32 | Ptr(_, _) | Ref(_, _) | FuncPtr(_): true
        case _: false

fn rv64_is_power_of_two(value: i64) -> bool:
    if value <= 0: return false
    var remaining = value
    while remaining > 1:
        if remaining % 2 != 0: return false
        remaining = remaining / 2
    true

fn rv64_static_alignment_valid(natural: i64, explicit_alignment: i64) -> bool:
    if explicit_alignment < 0: return false
    val effective = if explicit_alignment > 0: explicit_alignment else: natural
    rv64_is_power_of_two(effective) and effective >= natural

fn rv64_static_write_admitted(is_mutable: bool, requests_write: bool) -> bool:
    not requests_write or is_mutable

fn rv64_static_integer_bytes(value: i64, size: i64) -> [i64]:
    var bytes: [i64] = []
    var remaining = value
    for _ in 0..size:
        var byte = remaining % 256
        if byte < 0: byte = byte + 256
        bytes.push(byte)
        remaining = (remaining - byte) / 256
    bytes

fn rv64_static_initializer_bytes(static_: MirStatic, size: i64) -> [i64]:
    if static_.init == nil: return rv64_static_integer_bytes(0, size)
    if not rv64_static_initializer_supported(static_.init.unwrap().value):
        panic("riscv64 native static '{static_.name}' initializer is not an integer/zero constant")
    match static_.init.unwrap().value:
        case Int(value): rv64_static_integer_bytes(value, size)
        case Zero: rv64_static_integer_bytes(0, size)
        case _: rv64_static_integer_bytes(0, size)

fn rv64_static_initializer_supported(value: MirConstValue) -> bool:
    match value:
        case Int(_) | Zero: true
        case _: false

fn rv_isel_function(ctx: ISelContext, func: MirFunction) -> ISelFuncResult:
    var mach_func = new_mach_function(func.name)

    # Reset vreg counter - use local IDs directly, start high for temps
    var local_ctx = ISelContext(
        next_vreg: func.locals.len() + 100,
        frame_slots: ctx.frame_slots,
        next_frame_offset: 0,
        extern_symbols: ctx.extern_symbols,
        data_entries: ctx.data_entries,
        string_counter: ctx.string_counter,
        global_names: ctx.global_names, global_sizes: ctx.global_sizes,
        global_signed: ctx.global_signed, global_mutable: ctx.global_mutable
    )

    # Allocate frame slots for locals that need stack space
    for local in func.locals:
        val size = local.type_.size_bytes()
        local_ctx = isel_alloc_frame_slot(local_ctx, local.id.id, size)

    # Generate prologue block
    # RISC-V prologue:
    #   ADDI sp, sp, -framesize
    #   SD   ra, framesize-8(sp)
    #   SD   s0, framesize-16(sp)
    #   ADDI s0, sp, framesize
    var prologue_block = new_mach_block("prologue", -1)

    # ADDI sp, sp, -framesize (placeholder, will be patched after frame size is known)
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(0)]))
    # SD ra, offset(sp) - save return address
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(RV_OP_SD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), 0)]))
    # SD s0, offset(sp) - save frame pointer
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(RV_OP_SD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), 0)]))
    # ADDI s0, sp, framesize (set frame pointer, placeholder)
    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(RV_OP_ADDI, [op_phys(RV_X8), op_phys(RV_X2), op_imm(0)]))

    # Move arguments from ABI registers (a0-a7) to virtual registers
    for local in func.locals:
        match local.kind:
            case Arg(index):
                if index < RV_ARG_REGS.len():
                    val arg_reg = RV_ARG_REGS[index]
                    prologue_block = mach_block_add_inst(prologue_block, new_mach_inst(RV_OP_MV, [local_vreg_op(local.id.id), op_phys(arg_reg)]))
            case _: ()

    mach_func = mach_func_add_block(mach_func, prologue_block)

    var next_trampoline_id = 0
    for block in func.blocks:
        if block.id.id >= next_trampoline_id: next_trampoline_id = block.id.id + 1
    # Translate each MIR block
    for block in func.blocks:
        var trampoline_id = -1
        var trampoline_tag_dest = -1
        var trampoline_target = -1
        match block.terminator:
            case CallTerminator(_, _, _, _, Some(unwind), _, Some(tag_dest)):
                trampoline_id = next_trampoline_id
                next_trampoline_id = next_trampoline_id + 1
                trampoline_tag_dest = tag_dest.id
                trampoline_target = unwind.id
            case _: ()
        var result = rv_isel_block(local_ctx, block, trampoline_id)
        local_ctx = result.ctx
        mach_func = mach_func_add_block(mach_func, result.block)
        if trampoline_id >= 0:
            var trampoline = new_mach_block("exc.tag.{block.id.id}", trampoline_id)
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_caught_type_tag")]))
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(RV_OP_MV, [local_vreg_op(trampoline_tag_dest), op_phys(RV_X10)]))
            trampoline = mach_block_add_inst(trampoline, new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(trampoline_target)]))
            mach_func = mach_func_add_block(mach_func, trampoline)

    # Set frame size using the shared Linux ABI stack alignment contract.
    var frame_size = local_ctx.next_frame_offset
    # Add space for ra and s0 using the shared RV64 pointer-size contract.
    frame_size = frame_size + (RV64_WORD_SIZE * 2)
    val stack_align = rv64_linux_contract().stack_align_bytes
    if frame_size % stack_align != 0:
        frame_size = frame_size + (stack_align - (frame_size % stack_align))
    mach_func = rv64_patch_frame(mach_func, frame_size, rv64_function_outgoing_arg_size(func))

    # Propagate context back
    val out_ctx = ISelContext(
        next_vreg: ctx.next_vreg,
        frame_slots: ctx.frame_slots,
        next_frame_offset: ctx.next_frame_offset,
        extern_symbols: local_ctx.extern_symbols,
        data_entries: local_ctx.data_entries,
        string_counter: local_ctx.string_counter,
        global_names: local_ctx.global_names, global_sizes: local_ctx.global_sizes,
        global_signed: local_ctx.global_signed, global_mutable: local_ctx.global_mutable
    )

    ISelFuncResult(func: mach_func, ctx: out_ctx)

fn rv_isel_block(ctx: ISelContext, block: MirBlock, unwind_trampoline_id: i64) -> ISelBlockResult:
    val label = match block.label:
        case Some(lbl): lbl
        case None: "bb{block.id.id}"
    var mach_block = new_mach_block(label, block.id.id)
    var current_ctx = ctx

    # Lower instructions
    for inst in block.instructions:
        var result = rv_isel_inst(current_ctx, inst)
        current_ctx = result.ctx
        for mi in result.insts:
            mach_block = mach_block_add_inst(mach_block, mi)

    # Lower terminator
    var term_result = rv_isel_terminator(current_ctx, block.terminator, unwind_trampoline_id)
    current_ctx = term_result.ctx
    for mi in term_result.insts:
        mach_block = mach_block_add_inst(mach_block, mi)

    ISelBlockResult(block: mach_block, ctx: current_ctx)

# ============================================================================
# Instruction Selection - Instructions
# ============================================================================

fn rv_isel_inst(ctx: ISelContext, inst: MirInst) -> ISelInstResult:
    match inst.kind:
        case Const(dest, value, type_):
            rv_isel_const(ctx, dest, value, type_)
        case Copy(dest, src):
            rv_isel_copy(ctx, dest, src)
        case Move(dest, src):
            rv_isel_copy(ctx, dest, src)
        case BinOp(dest, op, left, right):
            rv_isel_binop(ctx, dest, op, left, right)
        case UnaryOp(dest, op, operand):
            rv_isel_unaryop(ctx, dest, op, operand)
        case Load(dest, ptr):
            rv_isel_load(ctx, dest, ptr)
        case Store(ptr, value):
            rv_isel_store(ctx, ptr, value)
        case GetElementPtr(dest, base, indices):
            rv_isel_get_element_ptr(ctx, dest, base, indices)
        case Intrinsic(dest, name, args):
            rv_isel_intrinsic(ctx, dest, name, args)
        case Call(dest, func_op, args):
            rv_isel_call(ctx, dest, func_op, args)
        case CallIndirect(dest, ptr, args, _):
            rv_isel_call(ctx, dest, ptr, args)
        case GetField(dest, base, field):
            rv_isel_get_field(ctx, dest, base, field)
        case SetField(base, field, value):
            rv_isel_set_field(ctx, base, field, value)
        case Alloc(dest, type_):
            rv_isel_alloc(ctx, dest, type_)
        case Cast(dest, operand, target):
            rv_isel_cast(ctx, dest, operand, target)
        case DecisionProbe(_, semantic_id, _, _, _, _):
            panic("riscv64 isel: unlowered DecisionProbe '{semantic_id}' reached instruction selection")
        case ConditionProbe(_, semantic_id, _, _, _, _, _, _):
            panic("riscv64 isel: unlowered ConditionProbe '{semantic_id}' reached instruction selection")
        case LoadGlobal(dest, symbol):
            rv64_isel_load_global(ctx, dest, symbol.id)
        case StoreGlobal(symbol, value):
            rv64_isel_store_global(ctx, symbol.id, value)
        case GlobalAddr(dest, symbol, mutable):
            rv64_isel_global_addr(ctx, dest, symbol.id, mutable)
        case Nop:
            ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)
        case _:
            rv_isel_unsupported(ctx, "instruction")

fn rv_isel_const(ctx: ISelContext, dest: LocalId, value: MirConstValue, type_: MirType) -> ISelInstResult:
    val lowered = rv_lower_const(ctx, value, type_)
    val dest_op = local_vreg_op(dest.id)
    # Move the const result to the destination vreg
    var insts = lowered.insts
    if insts.len() == 1 and insts[0].opcode == RV_OP_NOP:
        return ISelInstResult(insts: insts, ctx: lowered.ctx)
    insts.push(new_mach_inst(RV_OP_MV, [dest_op, lowered.result]))
    ISelInstResult(insts: insts, ctx: lowered.ctx)

fn rv_isel_copy(ctx: ISelContext, dest: LocalId, src: LocalId) -> ISelInstResult:
    # MV rd, rs (pseudo: ADDI rd, rs, 0)
    val inst = new_mach_inst(RV_OP_MV, [local_vreg_op(dest.id), local_vreg_op(src.id)])
    ISelInstResult(insts: [inst], ctx: ctx)

fn rv64_global_name(ctx: ISelContext, symbol_id: i64) -> text:
    if not rv64_global_metadata_present(ctx, symbol_id): panic("riscv64 native global references unknown MIR symbol {symbol_id}")
    ctx.global_names[symbol_id]

fn rv64_global_size(ctx: ISelContext, symbol_id: i64) -> i64:
    if not ctx.global_sizes.contains(symbol_id): panic("riscv64 native global has no storage width for MIR symbol {symbol_id}")
    ctx.global_sizes[symbol_id]

fn rv64_global_metadata_present(ctx: ISelContext, symbol_id: i64) -> bool:
    ctx.global_names.contains(symbol_id) and ctx.global_sizes.contains(symbol_id) and ctx.global_mutable.contains(symbol_id)

fn rv64_global_address(ctx: ISelContext, dest: Operand, symbol_id: i64) -> [MachInst]:
    val name = rv64_global_name(ctx, symbol_id)
    [new_mach_inst(RV_OP_AUIPC, [dest, op_sym(name)]), new_mach_inst(RV_OP_ADDI, [dest, dest, op_sym(name)])]

fn rv64_isel_global_addr(ctx: ISelContext, dest: LocalId, symbol_id: i64, mutable: bool) -> ISelInstResult:
    val is_mutable = ctx.global_mutable.contains(symbol_id) and ctx.global_mutable[symbol_id]
    if not rv64_static_write_admitted(is_mutable, mutable): panic("riscv64 native mutable address requested for immutable global '{rv64_global_name(ctx, symbol_id)}'")
    ISelInstResult(insts: rv64_global_address(ctx, local_vreg_op(dest.id), symbol_id), ctx: ctx)

fn rv64_isel_load_global(ctx: ISelContext, dest: LocalId, symbol_id: i64) -> ISelInstResult:
    val addr = isel_fresh_dest(ctx)
    var insts = rv64_global_address(ctx, addr.result, symbol_id)
    val signed = ctx.global_signed.contains(symbol_id) and ctx.global_signed[symbol_id]
    val opcode = if rv64_global_size(ctx, symbol_id) == 8: RV_OP_LD elif signed: RV_OP_LW else: RV_OP_LWU
    insts.push(new_mach_inst(opcode, [local_vreg_op(dest.id), op_mem(operand_get_reg(addr.result), 0)]))
    ISelInstResult(insts: insts, ctx: addr.ctx)

fn rv64_isel_store_global(ctx: ISelContext, symbol_id: i64, value: MirOperand) -> ISelInstResult:
    val is_mutable = ctx.global_mutable.contains(symbol_id) and ctx.global_mutable[symbol_id]
    if not rv64_static_write_admitted(is_mutable, true):
        panic("riscv64 native store rejected for immutable global '{rv64_global_name(ctx, symbol_id)}'")
    val lowered = rv_lower_operand(ctx, value)
    val addr = isel_fresh_dest(lowered.ctx)
    var insts = lowered.insts
    for address_inst in rv64_global_address(addr.ctx, addr.result, symbol_id): insts.push(address_inst)
    val opcode = if rv64_global_size(ctx, symbol_id) == 4: RV_OP_SW else: RV_OP_SD
    insts.push(new_mach_inst(opcode, [lowered.result, op_mem(operand_get_reg(addr.result), 0)]))
    ISelInstResult(insts: insts, ctx: addr.ctx)

fn rv_select_scalar_bitmanip(ctx: ISelContext, dest: Operand, name: text, args: [Operand]) -> ISelInstResult:
    if name == BIT_ROTATE_LEFT:
        if args.len() != 2:
            return ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)
        return ISelInstResult(insts: [new_mach_inst(RV_OP_ROL, [dest, args[0], args[1]])], ctx: ctx)

    if name == BIT_ROTATE_RIGHT:
        if args.len() != 2:
            return ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)
        return ISelInstResult(insts: [new_mach_inst(RV_OP_ROR, [dest, args[0], args[1]])], ctx: ctx)

    if args.len() != 1:
        return ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)

    if name == BIT_CLZ:
        return ISelInstResult(insts: [new_mach_inst(RV_OP_CLZ, [dest, args[0]])], ctx: ctx)
    if name == BIT_CTZ:
        return ISelInstResult(insts: [new_mach_inst(RV_OP_CTZ, [dest, args[0]])], ctx: ctx)
    if name == BIT_BSWAP:
        return ISelInstResult(insts: [new_mach_inst(RV_OP_REV8, [dest, args[0]])], ctx: ctx)

    ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)

fn rv_isel_intrinsic(ctx: ISelContext, dest: LocalId?, name: text, args: [MirOperand]) -> ISelInstResult:
    match dest:
        case Some(dest_local):
            var insts: [MachInst] = []
            var current_ctx = ctx
            var lowered_args: [Operand] = []
            for arg in args:
                val low = rv_lower_operand(current_ctx, arg)
                current_ctx = low.ctx
                for inst in low.insts:
                    insts.push(inst)
                lowered_args.push(low.result)

            val selected = rv_select_scalar_bitmanip(current_ctx, local_vreg_op(dest_local.id), name, lowered_args)
            for inst in selected.insts:
                insts.push(inst)
            ISelInstResult(insts: insts, ctx: selected.ctx)
        case None:
            ISelInstResult(insts: [], ctx: ctx)

# ============================================================================
# Binary Operations
# ============================================================================

fn rv_isel_binop(ctx: ISelContext, dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand) -> ISelInstResult:
    val left_low = rv_lower_operand(ctx, left)
    val right_low = rv_lower_operand(left_low.ctx, right)
    var current_ctx = right_low.ctx
    val dest_op = local_vreg_op(dest.id)
    var insts: [MachInst] = []
    for ai in left_low.insts:
        insts.push(ai)
    for ai in right_low.insts:
        insts.push(ai)

    match op:
        case Add:
            insts.push(new_mach_inst(RV_OP_ADD, [dest_op, left_low.result, right_low.result]))
        case Sub:
            insts.push(new_mach_inst(RV_OP_SUB, [dest_op, left_low.result, right_low.result]))
        case Mul:
            # RV64M extension: MUL rd, rs1, rs2
            insts.push(new_mach_inst(RV_OP_MUL, [dest_op, left_low.result, right_low.result]))
        case Div:
            # RV64M extension: DIV rd, rs1, rs2 (signed)
            insts.push(new_mach_inst(RV_OP_DIV, [dest_op, left_low.result, right_low.result]))
        case Rem:
            # RV64M extension: REM rd, rs1, rs2 (signed remainder)
            insts.push(new_mach_inst(RV_OP_REM, [dest_op, left_low.result, right_low.result]))
        case BitAnd:
            insts.push(new_mach_inst(RV_OP_AND, [dest_op, left_low.result, right_low.result]))
        case BitOr:
            insts.push(new_mach_inst(RV_OP_OR, [dest_op, left_low.result, right_low.result]))
        case BitXor:
            insts.push(new_mach_inst(RV_OP_XOR, [dest_op, left_low.result, right_low.result]))
        case Shl:
            insts.push(new_mach_inst(RV_OP_SLL, [dest_op, left_low.result, right_low.result]))
        case Shr:
            # Arithmetic shift right (sign-extending)
            insts.push(new_mach_inst(RV_OP_SRA, [dest_op, left_low.result, right_low.result]))
        case Eq:
            for ai in rv_isel_cmp_eq(dest_op, left_low.result, right_low.result, current_ctx):
                insts.push(ai)
        case Ne:
            for ai in rv_isel_cmp_ne(dest_op, left_low.result, right_low.result, current_ctx):
                insts.push(ai)
        case Lt:
            # SLT rd, rs1, rs2 (rd = 1 if rs1 < rs2, signed)
            insts.push(new_mach_inst(RV_OP_SLT, [dest_op, left_low.result, right_low.result]))
        case Le:
            # LE: NOT (rs2 < rs1) => SLT tmp, rs2, rs1; SEQZ dest, tmp
            for ai in rv_isel_cmp_le(dest_op, left_low.result, right_low.result, current_ctx):
                insts.push(ai)
        case Gt:
            # GT: SLT rd, rs2, rs1 (swap operands)
            insts.push(new_mach_inst(RV_OP_SLT, [dest_op, right_low.result, left_low.result]))
        case Ge:
            # GE: NOT (rs1 < rs2) => SLT tmp, rs1, rs2; SEQZ dest, tmp
            for ai in rv_isel_cmp_ge(dest_op, left_low.result, right_low.result, current_ctx):
                insts.push(ai)
        case _:
            val unsupported = rv_isel_unsupported(current_ctx, "binary operation")
            current_ctx = unsupported.ctx
            for ai in unsupported.insts:
                insts.push(ai)

    ISelInstResult(insts: insts, ctx: current_ctx)

# RISC-V comparison helpers using SLT/SEQZ/SNEZ/SUB + XOR patterns.
# RISC-V has no flags register; comparisons are done via SLT and branches.

fn rv_isel_cmp_eq(dest: Operand, left: Operand, right: Operand, ctx: ISelContext) -> [MachInst]:
    # EQ: SUB tmp, rs1, rs2; SEQZ dest, tmp
    val low = isel_fresh_dest(ctx)
    var insts: [MachInst] = []
    insts.push(new_mach_inst(RV_OP_SUB, [low.result, left, right]))
    insts.push(new_mach_inst(RV_OP_SEQZ, [dest, low.result]))
    insts

fn rv_isel_cmp_ne(dest: Operand, left: Operand, right: Operand, ctx: ISelContext) -> [MachInst]:
    # NE: SUB tmp, rs1, rs2; SNEZ dest, tmp
    val low = isel_fresh_dest(ctx)
    var insts: [MachInst] = []
    insts.push(new_mach_inst(RV_OP_SUB, [low.result, left, right]))
    insts.push(new_mach_inst(RV_OP_SNEZ, [dest, low.result]))
    insts

fn rv_isel_cmp_le(dest: Operand, left: Operand, right: Operand, ctx: ISelContext) -> [MachInst]:
    # LE: NOT (right < left) => SLT tmp, right, left; SEQZ dest, tmp
    val low = isel_fresh_dest(ctx)
    var insts: [MachInst] = []
    insts.push(new_mach_inst(RV_OP_SLT, [low.result, right, left]))
    insts.push(new_mach_inst(RV_OP_SEQZ, [dest, low.result]))
    insts

fn rv_isel_cmp_ge(dest: Operand, left: Operand, right: Operand, ctx: ISelContext) -> [MachInst]:
    # GE: NOT (left < right) => SLT tmp, left, right; SEQZ dest, tmp
    val low = isel_fresh_dest(ctx)
    var insts: [MachInst] = []
    insts.push(new_mach_inst(RV_OP_SLT, [low.result, left, right]))
    insts.push(new_mach_inst(RV_OP_SEQZ, [dest, low.result]))
    insts

# ============================================================================
# Unary Operations
# ============================================================================

fn rv_isel_unaryop(ctx: ISelContext, dest: LocalId, op: MirUnaryOp, operand: MirOperand) -> ISelInstResult:
    val low = rv_lower_operand(ctx, operand)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts

    match op:
        case Neg:
            # NEG rd, rs (pseudo: SUB rd, x0, rs)
            insts.push(new_mach_inst(RV_OP_NEG, [dest_op, low.result]))
        case Not:
            # NOT rd, rs (pseudo: XORI rd, rs, -1)
            insts.push(new_mach_inst(RV_OP_NOT, [dest_op, low.result]))
        case BitNot:
            # Same as Not for integers: XORI rd, rs, -1
            insts.push(new_mach_inst(RV_OP_NOT, [dest_op, low.result]))
        case _:
            val unsupported = rv_isel_unsupported(low.ctx, "unary operation")
            for ai in unsupported.insts:
                insts.push(ai)
            return ISelInstResult(insts: insts, ctx: unsupported.ctx)

    ISelInstResult(insts: insts, ctx: low.ctx)

# ============================================================================
# Memory Operations
# ============================================================================

fn rv_isel_load(ctx: ISelContext, dest: LocalId, ptr: MirOperand) -> ISelInstResult:
    val low = rv_lower_operand(ctx, ptr)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts
    # LD dest, 0(base) - load doubleword (64-bit)
    insts.push(new_mach_inst(RV_OP_LD, [dest_op, op_mem(operand_get_reg(low.result), 0)]))
    ISelInstResult(insts: insts, ctx: low.ctx)

fn rv_isel_store(ctx: ISelContext, ptr: MirOperand, value: MirOperand) -> ISelInstResult:
    val ptr_low = rv_lower_operand(ctx, ptr)
    val val_low = rv_lower_operand(ptr_low.ctx, value)
    var insts = ptr_low.insts
    for ai in val_low.insts:
        insts.push(ai)
    # SD value, 0(base) - store doubleword (64-bit)
    insts.push(new_mach_inst(RV_OP_SD, [val_low.result, op_mem(operand_get_reg(ptr_low.result), 0)]))
    ISelInstResult(insts: insts, ctx: val_low.ctx)

fn rv_isel_get_field(ctx: ISelContext, dest: LocalId, base: MirOperand, field: i64) -> ISelInstResult:
    val base_low = rv_lower_operand(ctx, base)
    val dest_op = local_vreg_op(dest.id)
    val offset = field * RV64_WORD_SIZE
    var insts = base_low.insts
    var current_ctx = base_low.ctx
    # LD dest, offset(base)
    if rv64_imm12_fits(offset):
        insts.push(new_mach_inst(RV_OP_LD, [dest_op, op_mem(operand_get_reg(base_low.result), offset)]))
    else:
        current_ctx = isel_alloc_vreg(current_ctx)
        val addr = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
        insts.push(new_mach_inst(RV_OP_LI, [addr, op_imm(offset)]))
        insts.push(new_mach_inst(RV_OP_ADD, [addr, base_low.result, addr]))
        insts.push(new_mach_inst(RV_OP_LD, [dest_op, op_mem(operand_get_reg(addr), 0)]))
    ISelInstResult(insts: insts, ctx: current_ctx)

fn rv_isel_set_field(ctx: ISelContext, base: MirOperand, field: i64, value: MirOperand) -> ISelInstResult:
    val base_low = rv_lower_operand(ctx, base)
    val val_low = rv_lower_operand(base_low.ctx, value)
    val offset = field * RV64_WORD_SIZE
    var insts = base_low.insts
    for ai in val_low.insts:
        insts.push(ai)
    var current_ctx = val_low.ctx
    # SD value, offset(base)
    if rv64_imm12_fits(offset):
        insts.push(new_mach_inst(RV_OP_SD, [val_low.result, op_mem(operand_get_reg(base_low.result), offset)]))
    else:
        current_ctx = isel_alloc_vreg(current_ctx)
        val addr = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
        insts.push(new_mach_inst(RV_OP_LI, [addr, op_imm(offset)]))
        insts.push(new_mach_inst(RV_OP_ADD, [addr, base_low.result, addr]))
        insts.push(new_mach_inst(RV_OP_SD, [val_low.result, op_mem(operand_get_reg(addr), 0)]))
    ISelInstResult(insts: insts, ctx: current_ctx)

fn rv_isel_get_element_ptr(ctx: ISelContext, dest: LocalId, base: MirOperand, indices: [MirOperand]) -> ISelInstResult:
    var insts: [MachInst] = []
    var current_ctx = ctx
    val base_low = rv_lower_operand(current_ctx, base)
    current_ctx = base_low.ctx
    for ai in base_low.insts:
        insts.push(ai)
    val dest_op = local_vreg_op(dest.id)
    if indices.len() > 0:
        val idx_low = rv_lower_operand(current_ctx, indices[0])
        current_ctx = idx_low.ctx
        for ai in idx_low.insts:
            insts.push(ai)
        current_ctx = isel_alloc_vreg(current_ctx)
        val tmp_op = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
        insts.push(new_mach_inst(RV_OP_LI, [tmp_op, op_imm(RV64_WORD_SIZE)]))
        insts.push(new_mach_inst(RV_OP_MUL, [tmp_op, tmp_op, idx_low.result]))
        insts.push(new_mach_inst(RV_OP_ADD, [dest_op, base_low.result, tmp_op]))
    else:
        insts.push(new_mach_inst(RV_OP_MV, [dest_op, base_low.result]))
    ISelInstResult(insts: insts, ctx: current_ctx)

fn rv_isel_alloc(ctx: ISelContext, dest: LocalId, type_: MirType) -> ISelInstResult:
    val size = type_.size_bytes()
    val aligned = if size < 16: 16 else: size
    # Round up to multiple of 16
    var alloc_size = aligned
    if alloc_size % 16 != 0:
        alloc_size = alloc_size + (16 - (alloc_size % 16))
    val dest_op = local_vreg_op(dest.id)
    var insts: [MachInst] = []
    # ADDI sp, sp, -size (decrement stack)
    val neg_size = 0 - alloc_size
    var current_ctx = ctx
    if neg_size >= -2048:
        insts.push(new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(neg_size)]))
    else:
        current_ctx = isel_alloc_vreg(current_ctx)
        val amount = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
        insts.push(new_mach_inst(RV_OP_LI, [amount, op_imm(neg_size)]))
        insts.push(new_mach_inst(RV_OP_ADD, [op_phys(RV_X2), op_phys(RV_X2), amount]))
    # MV dest, sp (capture the address)
    insts.push(new_mach_inst(RV_OP_MV, [dest_op, op_phys(RV_X2)]))
    ISelInstResult(insts: insts, ctx: current_ctx)

fn rv_isel_cast(ctx: ISelContext, dest: LocalId, operand: MirOperand, target: MirType) -> ISelInstResult:
    val low = rv_lower_operand(ctx, operand)
    val dest_op = local_vreg_op(dest.id)
    var insts = low.insts
    # Simple move - truncation/extension handled by encoder based on type
    insts.push(new_mach_inst(RV_OP_MV, [dest_op, low.result]))
    ISelInstResult(insts: insts, ctx: low.ctx)

# ============================================================================
# Function Calls
# ============================================================================

fn rv_isel_call(ctx: ISelContext, dest: LocalId?, func_op: MirOperand, args: [MirOperand]) -> ISelInstResult:
    var insts: [MachInst] = []
    var current_ctx = ctx
    var did_emit_call = false

    # Lower arguments into ABI registers (a0-a7 = x10-x17)
    for i in 0..args.len():
        val arg_low = rv_lower_operand(current_ctx, args[i])
        current_ctx = arg_low.ctx
        for ai in arg_low.insts:
            insts.push(ai)
        if i < RV_ARG_REGS.len():
            val arg_reg = RV_ARG_REGS[i]
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(arg_reg), arg_low.result]))
        else:
            # Stack argument: SD value, offset(sp)
            val stack_offset = (i - RV_ARG_REGS.len()) * 8
            if stack_offset <= 2047:
                insts.push(new_mach_inst(RV_OP_SD, [arg_low.result, op_mem(physical_reg(RV_X2), stack_offset)]))
            else:
                current_ctx = isel_alloc_vreg(current_ctx)
                val addr = op_reg(virtual_reg(isel_get_vreg(current_ctx)))
                insts.push(new_mach_inst(RV_OP_LI, [addr, op_imm(stack_offset)]))
                insts.push(new_mach_inst(RV_OP_ADD, [addr, op_phys(RV_X2), addr]))
                insts.push(new_mach_inst(RV_OP_SD, [arg_low.result, op_mem(operand_get_reg(addr), 0)]))

    # Emit call
    match func_op.kind:
        case Const(Str(name), _):
            # Direct call to named function: CALL symbol (pseudo: AUIPC ra + JALR ra)
            current_ctx = isel_add_extern(current_ctx, name)
            insts.push(new_mach_inst(RV_OP_CALL, [op_sym(name)]))
            did_emit_call = true
        case Copy(local):
            # Indirect call through register: JALR ra, 0(rs)
            insts.push(new_mach_inst(RV_OP_JALR, [op_phys(RV_X1), local_vreg_op(local.id), op_imm(0)]))
            did_emit_call = true
        case Move(local):
            insts.push(new_mach_inst(RV_OP_JALR, [op_phys(RV_X1), local_vreg_op(local.id), op_imm(0)]))
            did_emit_call = true
        case _:
            val unsupported = rv_isel_unsupported(current_ctx, "call target")
            current_ctx = unsupported.ctx
            for ai in unsupported.insts:
                insts.push(ai)

    # Move return value from a0 (x10)
    if did_emit_call:
        match dest:
            case Some(d):
                insts.push(new_mach_inst(RV_OP_MV, [local_vreg_op(d.id), op_phys(RV_X10)]))
            case None: ()

    ISelInstResult(insts: insts, ctx: current_ctx)

# ============================================================================
# Instruction Selection - Terminators
# ============================================================================

fn rv_isel_terminator(ctx: ISelContext, term: MirTerminator, unwind_trampoline_id: i64) -> ISelInstResult:
    match term:
        case Goto(target):
            # JAL x0, target_label (unconditional jump, discard return address)
            val inst = new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(target.id)])
            ISelInstResult(insts: [inst], ctx: ctx)
        case Ret(value):
            rv_isel_return(ctx, value)
        case If(cond, then_, else_):
            rv_isel_if(ctx, cond, then_, else_)
        case Switch(value, targets, default_target):
            rv_isel_switch(ctx, value, targets, default_target)
        case Unreachable:
            ISelInstResult(insts: [new_mach_inst(RV_OP_NOP, [])], ctx: ctx)
        case Abort(message):
            # Abort must HALT. It previously fell through to the `case _:` arm
            # below, which printed a diagnostic and then emitted a NOP -- control
            # ran straight on into whatever block was laid out next, with exactly
            # the corrupt state the abort existed to stop. EBREAK traps.
            ISelInstResult(insts: [new_mach_inst(RV_OP_EBREAK, [])], ctx: ctx)
        case Throw(payload, type_tag):
            val payload_low = rv_lower_operand(ctx, payload)
            val tag_low = rv_lower_operand(payload_low.ctx, type_tag)
            var throw_ctx = isel_add_extern(tag_low.ctx, "rt_exception_throw")
            var insts = payload_low.insts
            for tag_inst in tag_low.insts:
                insts.push(tag_inst)
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X10), payload_low.result]))
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X11), tag_low.result]))
            insts.push(new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_throw")]))
            insts.push(new_mach_inst(RV_OP_EBREAK, []))
            ISelInstResult(insts: insts, ctx: throw_ctx)
        case Resume(payload, type_tag):
            val payload_low = rv_lower_operand(ctx, payload)
            val tag_low = rv_lower_operand(payload_low.ctx, type_tag)
            var resume_ctx = isel_add_extern(tag_low.ctx, "rt_exception_resume")
            var insts = payload_low.insts
            for tag_inst in tag_low.insts:
                insts.push(tag_inst)
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X10), payload_low.result]))
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X11), tag_low.result]))
            insts.push(new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_resume")]))
            insts.push(new_mach_inst(RV_OP_EBREAK, []))
            ISelInstResult(insts: insts, ctx: resume_ctx)
        case CallTerminator(dest, func, args, normal, unwind, unwind_payload_dest, unwind_type_tag_dest):
            # Contract (mir_interpreter.spl `case CallTerminator`): perform the
            # call, bind the return value into `dest` when present, then
            # transfer to `normal`. The NOP this used to emit dropped both the
            # call and the edge.
            if unwind.?:
                var unwind_ctx = isel_add_extern(ctx, "rt_exception_frame_push")
                unwind_ctx = isel_add_extern(unwind_ctx, "_setjmp")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_frame_capture")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_caught_type_tag")
                unwind_ctx = isel_add_extern(unwind_ctx, "rt_exception_frame_pop")
                unwind_ctx = isel_alloc_vreg(unwind_ctx)
                val frame = op_reg(virtual_reg(isel_get_vreg(unwind_ctx)))
                unwind_ctx = isel_alloc_vreg(unwind_ctx)
                val capture_status = op_reg(virtual_reg(isel_get_vreg(unwind_ctx)))
                var insts: [MachInst] = []
                insts.push(new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_frame_push")]))
                insts.push(new_mach_inst(RV_OP_MV, [frame, op_phys(RV_X10)]))
                insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X10), frame]))
                insts.push(new_mach_inst(RV_OP_CALL, [op_sym("_setjmp")]))
                insts.push(new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_frame_capture")]))
                match unwind_payload_dest:
                    case Some(d): insts.push(new_mach_inst(RV_OP_MV, [local_vreg_op(d.id), op_phys(RV_X10)]))
                    case None: ()
                insts.push(new_mach_inst(RV_OP_MV, [capture_status, op_phys(RV_X11)]))
                val exceptional_target = if unwind_trampoline_id >= 0: unwind_trampoline_id else: unwind.unwrap().id
                insts.push(new_mach_inst(RV_OP_BNE, [capture_status, op_phys(RV_X0), op_label(exceptional_target)]))
                val call_res = rv_isel_call(unwind_ctx, dest, func, args)
                for call_inst in call_res.insts:
                    insts.push(call_inst)
                insts.push(new_mach_inst(RV_OP_CALL, [op_sym("rt_exception_frame_pop")]))
                insts.push(new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(normal.id)]))
                return ISelInstResult(insts: insts, ctx: call_res.ctx)
            val call_res = rv_isel_call(ctx, dest, func, args)
            var insts = call_res.insts
            insts.push(new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(normal.id)]))
            ISelInstResult(insts: insts, ctx: call_res.ctx)
        case _:
            # All nine MirTerminator variants are handled above. Returning a
            # NOP here would silently delete a terminator; fail loudly instead.
            panic("riscv64 isel: unhandled MirTerminator variant -- terminator lowered to nothing")

fn rv_isel_return(ctx: ISelContext, value: MirOperand?) -> ISelInstResult:
    var insts: [MachInst] = []
    match value:
        case Some(v):
            val low = rv_lower_operand(ctx, v)
            for ai in low.insts:
                insts.push(ai)
            # MV a0, result (move return value to a0 = x10)
            insts.push(new_mach_inst(RV_OP_MV, [op_phys(RV_X10), low.result]))
        case None: ()
    # Epilogue: restore ra, s0, adjust sp, return
    # LD ra, offset(sp)
    insts.push(new_mach_inst(RV_OP_LD, [op_phys(RV_X1), op_mem(physical_reg(RV_X2), 0)]))
    # LD s0, offset(sp)
    insts.push(new_mach_inst(RV_OP_LD, [op_phys(RV_X8), op_mem(physical_reg(RV_X2), 0)]))
    # ADDI sp, sp, framesize (restore stack, placeholder)
    insts.push(new_mach_inst(RV_OP_ADDI, [op_phys(RV_X2), op_phys(RV_X2), op_imm(0)]))
    # RET (pseudo: JALR x0, 0(ra))
    insts.push(new_mach_inst(RV_OP_RET, []))
    ISelInstResult(insts: insts, ctx: ctx)

fn rv_isel_if(ctx: ISelContext, cond: MirOperand, then_: BlockId, else_: BlockId) -> ISelInstResult:
    val cond_low = rv_lower_operand(ctx, cond)
    var insts = cond_low.insts
    # BNE cond, x0, then_label (branch if cond != 0, i.e. true)
    insts.push(new_mach_inst(RV_OP_BNE, [cond_low.result, op_phys(RV_X0), op_label(then_.id)]))
    # JAL x0, else_label (unconditional jump to else block)
    insts.push(new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(else_.id)]))
    ISelInstResult(insts: insts, ctx: cond_low.ctx)

fn rv_isel_switch(ctx: ISelContext, value: MirOperand, targets: [SwitchCase], default_target: BlockId) -> ISelInstResult:
    val val_low = rv_lower_operand(ctx, value)
    var insts = val_low.insts
    var current_ctx = val_low.ctx

    # Generate LI + BEQ chain for each case
    for i in 0..targets.len():
        val target = targets[i]
        # Load case value into temp vreg
        val case_low = isel_fresh_dest(current_ctx)
        current_ctx = case_low.ctx
        val case_op = case_low.result
        insts.push(new_mach_inst(RV_OP_LI, [case_op, op_imm(target.value)]))
        # BEQ value, case_value, target_label
        insts.push(new_mach_inst(RV_OP_BEQ, [val_low.result, case_op, op_label(target.target.id)]))

    # JAL x0, default_label (fall through to default)
    insts.push(new_mach_inst(RV_OP_JAL, [op_phys(RV_X0), op_label(default_target.id)]))
    ISelInstResult(insts: insts, ctx: current_ctx)

