# Explicit AVX-512 capability receipt for custom x86 instruction selection.
# The receipt binds target policy to CPU and OS-state admission. A target name
# alone never permits ZMM emission.

struct NativeAvx512CapabilityV1:
    contract_version: i64
    target_triple: text
    capability_source: text
    capability_hash: text
    avx512f_admitted: bool
    avx512bw_admitted: bool
    os_state_ready: bool
    reason: text

fn native_avx512_capability_v1(
    target_triple: text,
    capability_source: text,
    capability_hash: text,
    cpu_avx512f: bool,
    cpu_avx512bw: bool,
    os_state_ready: bool
) -> NativeAvx512CapabilityV1:
    val identity_ready = target_triple != "" and capability_source != "" and capability_hash != ""
    val base_ready = identity_ready and cpu_avx512f and os_state_ready
    var reason = "avx512f-capability-admitted"
    if target_triple == "": reason = "missing-target-triple"
    elif capability_source == "": reason = "missing-capability-source"
    elif capability_hash == "": reason = "missing-capability-hash"
    elif not cpu_avx512f: reason = "avx512f-not-admitted"
    elif not os_state_ready: reason = "avx512-os-state-not-admitted"
    NativeAvx512CapabilityV1(
        contract_version: 1,
        target_triple: target_triple,
        capability_source: capability_source,
        capability_hash: capability_hash,
        avx512f_admitted: base_ready,
        avx512bw_admitted: base_ready and cpu_avx512bw,
        os_state_ready: os_state_ready,
        reason: reason
    )

fn native_avx512_denied_v1() -> NativeAvx512CapabilityV1:
    native_avx512_capability_v1(
        "x86_64-unknown", "missing-native-policy", "none", false, false, false)

fn native_avx512_receipt_key(capability: NativeAvx512CapabilityV1) -> text:
    "native-avx512/v1|target={capability.target_triple}|source={capability.capability_source}|hash={capability.capability_hash}|avx512f={capability.avx512f_admitted}|avx512bw={capability.avx512bw_admitted}|os={capability.os_state_ready}|reason={capability.reason}"
