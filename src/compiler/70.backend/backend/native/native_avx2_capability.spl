# Explicit capability and receipt carried into custom x86 AVX2 selection.
# A target request alone is never evidence that the execution domain supports
# AVX2. Cross-target tools may inject an admitted target contract; host tools
# must derive one from the canonical runtime CPUID/XGETBV detector.

struct NativeAvx2CapabilityV1:
    contract_version: i64
    target_triple: text
    capability_source: text
    capability_hash: text
    avx2_admitted: bool
    reason: text

fn native_avx2_capability_v1(
    target_triple: text,
    capability_source: text,
    capability_hash: text,
    avx2_admitted: bool
) -> NativeAvx2CapabilityV1:
    var reason = "avx2-capability-admitted"
    if target_triple == "": reason = "missing-target-triple"
    elif capability_source == "": reason = "missing-capability-source"
    elif capability_hash == "": reason = "missing-capability-hash"
    elif not avx2_admitted: reason = "avx2-not-admitted"
    NativeAvx2CapabilityV1(
        contract_version: 1,
        target_triple: target_triple,
        capability_source: capability_source,
        capability_hash: capability_hash,
        avx2_admitted: avx2_admitted and target_triple != ""
            and capability_source != "" and capability_hash != "",
        reason: reason)

fn native_avx2_denied_v1() -> NativeAvx2CapabilityV1:
    native_avx2_capability_v1(
        "x86_64-unknown", "missing-native-policy", "none", false)

fn native_avx2_receipt_key(capability: NativeAvx2CapabilityV1) -> text:
    "native-avx2/v1|target={capability.target_triple}|source={capability.capability_source}|hash={capability.capability_hash}|admitted={capability.avx2_admitted}|reason={capability.reason}"
