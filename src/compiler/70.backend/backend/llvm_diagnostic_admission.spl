# LLVM tool-result admission. Source authority:
# https://llvm.org/docs/doxygen/SourceMgr_8cpp_source.html (SMDiagnostic::print)
# https://llvm.org/docs/doxygen/LLVMContext_8cpp_source.html (diagnose)
# https://llvm.org/docs/doxygen/DiagnosticPrinter_8cpp_source.html (operator<<)
# Textual diagnostics are parsed only in the producing tool/input context.

fn llvm_diagnostic_kind(body: text) -> text:
    for kind in ["error", "warning", "note", "remark"]:
        if body.starts_with(kind + ": "):
            return kind
    ""

fn llvm_diagnostic_decimal(value: text) -> bool:
    if value == "": return false
    for ch in value:
        if ch < '0' or ch > '9': return false
    true

fn llvm_diagnostic_header(line: text, tool_path: text, input_path: text) -> (text, bool):
    # SMDiagnostic: [ProgName: ][Filename[:Line[:Column]]: ]Kind: Message.
    # Exact known origins preserve drive-letter/path colons and spaces.
    var body = line
    val tool_parts = tool_path.replace("\\", "/").split("/")
    val tool_name = tool_parts[tool_parts.len() - 1]
    for tool in [tool_path, tool_name]:
        if tool != "" and body.starts_with(tool + ": "):
            body = body.substring(tool.len() + 2, body.len())
            break
    if body.starts_with("LLVM ERROR: "): return ("error", false)
    # LLVMContext::diagnose may prefix the embedded SMDiagnostic with Kind.
    val outer_kind = llvm_diagnostic_kind(body)
    if outer_kind != "":
        body = body.substring(outer_kind.len() + 2, body.len())
    for filename in [input_path, "<inline asm>", "<instantiation>", "<stdin>"]:
        if filename == "": continue
        if body.starts_with(filename + ": "):
            val tail = body.substring(filename.len() + 2, body.len())
            val kind = llvm_diagnostic_kind(tail)
            if kind != "":
                return (if outer_kind != "": outer_kind else: kind, false)
        if not body.starts_with(filename + ":"): continue
        val location = body.substring(filename.len() + 1, body.len())
        val fields = location.split(":")
        if fields.len() < 2 or not llvm_diagnostic_decimal(fields[0]): continue
        val has_column = llvm_diagnostic_decimal(fields[1])
        val message_index = if has_column: 2 else: 1
        if fields.len() <= message_index: continue
        # The complete numeric location ends with exactly ': '. Parsing the
        # message never determines whether SourceMgr prints a source line.
        if not fields[message_index].starts_with(" "): continue
        if outer_kind != "":
            # DiagnosticPrinter suppresses the embedded Kind label because
            # LLVMContext already emitted it. Preserve that outer severity.
            # SourceMgr prints one raw source line iff line AND column exist;
            # a blank/non-ASCII source still counts, and a caret is optional.
            return (outer_kind, has_column)
        if fields.len() <= message_index + 1: continue
        # Direct SMDiagnostic printing includes its own Kind label.
        for kind in ["error", "warning", "note", "remark"]:
            if fields[message_index] == " " + kind:
                return (kind, has_column)
    (outer_kind, false)

pub fn llvm_llc_error_diagnostic(
    exit_code: i64, stdout: text, stderr: text, tool_path: text, input_path: text
) -> text:
    """Find a real LLVM error record before admitting a possibly partial object.

    Captured pipes use LLVM's normal uncolored diagnostic format. A located
    SMDiagnostic with a column prints its raw source line next, even when the
    line starts with `error:` or includes quoted diagnostic-looking text.
    """
    if exit_code != 0:
        return "llc exited with status {exit_code}"
    for output in [stdout, stderr]:
        var source_line_next = false
        for line in output.split("\n"):
            if source_line_next:
                source_line_next = false
                continue
            val (kind, has_source_line) = llvm_diagnostic_header(line, tool_path, input_path)
            if kind == "error": return line
            source_line_next = has_source_line
    ""
