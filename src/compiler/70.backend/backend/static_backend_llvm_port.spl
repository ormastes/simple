use compiler.backend.backend_port.{BackendDescV1, BackendPortV1, CodegenParamsV1, backend_port_header, backend_port_host_iface}
use common.plugin.iface_id.{ParamHeader}
use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.codegen_types.{CodegenOutput}
use compiler.backend.backend.backend_types.{CompileError}
use compiler.backend.llvm_codegen_adapter.{LlvmCodegenAdapter}

fn _llvm_desc() -> BackendDescV1:
    BackendDescV1(ParamHeader("simple.codegen.BackendDescV1", 1, 0, 0),
        "llvm", ["*"], ["emit-object"], "llvm", [])

fn _llvm_run(params: CodegenParamsV1,
        module: MirModule) -> Result<CodegenOutput, CompileError>:
    LlvmCodegenAdapter(options: params.options).compile_module(module)

fn _llvm_supports(capability: text) -> bool:
    capability == "emit-object"

pub fn llvm_backend_port_v1() -> BackendPortV1:
    BackendPortV1(backend_port_header(), backend_port_host_iface(),
        _llvm_desc, _llvm_run, _llvm_supports, [])
