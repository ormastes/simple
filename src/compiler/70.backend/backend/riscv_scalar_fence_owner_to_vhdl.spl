use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_scalar_fence_owner.{strict_riscv_scalar_fence_owner}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult,
    render_strict_sequential_hwir}

pub fn compile_strict_riscv_scalar_fence_owner(name: text, config: CoreConfig,
    instruction: u32) -> HwirStrictVhdlResult:
    val owner = strict_riscv_scalar_fence_owner(name, config, instruction)
    if owner.is_err(): return HwirStrictVhdlResult.rejected(owner.err().unwrap())
    render_strict_sequential_hwir(owner.ok().unwrap(),
        "hwir-gen2-scalar-fence-owner-v1")
