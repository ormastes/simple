# Backend-local admission for native group worker threads. The compiler owner
# supplies a qualification receipt from two real LLVM emissions in one process.
# The receipt is evidence, not a scheduler: the owner still owns worker launch,
# join, artifact validation, and deterministic commit.

use compiler.mir.mir_instructions.{MirModule}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{MirStorageViewSiteBindingV1}
use compiler.backend.backend.backend_types.{BackendCompileOptions}
use compiler.backend.backend.llvm_target.{LlvmTargetConfig}
use compiler.backend.backend.llvm_codegen_adapter.{
    llvm_group_translate_module_ir_v1, llvm_compile_module_direct_to_path}
use compiler.backend.backend.llvm_backend_tools.{compile_ir_to_object_path}
use std.nogc_sync_mut.concurrent.thread.{thread_spawn_with_i64_args_id, thread_join_by_id}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_text, file_write, file_is_regular_no_follow}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.io.thread.{thread_native_current_id}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_sync_mut.io_runtime.{env_get_opt}

extern fn rt_file_read_bytes(path: text) -> [u8]

pub struct GroupNativeThreadQualificationV1:
    backend: text
    module_a: text
    module_b: text
    process_id_a: i64
    process_id_b: i64
    thread_id_a: i64
    thread_id_b: i64
    llvm_start_us_a: i64
    llvm_end_us_a: i64
    llvm_start_us_b: i64
    llvm_end_us_b: i64
    baseline_object_sha256_a: text
    baseline_object_sha256_b: text
    threaded_object_sha256_a: text
    threaded_object_sha256_b: text

pub struct GroupNativeThreadCapabilityV1:
    requested_threads: i64
    effective_threads: i64
    reason: text
    overlap_qualified: bool
    object_parity_qualified: bool

pub struct GroupNativeLlvmJobV1:
    # The owner must freeze these values and make a distinct MIR copy per slot.
    module: MirModule
    storage_bindings: [MirStorageViewSiteBindingV1]
    options: BackendCompileOptions
    target: LlvmTargetConfig
    is_entry: bool
    bootstrap_mode: bool
    baseline_object_path: text
    baseline_diagnostic_path: text
    object_path: text
    diagnostic_path: text
    receipt_path: text

pub struct GroupNativeLlvmWorkerReceiptV1:
    process_id: i64
    thread_id: i64
    llvm_start_us: i64
    llvm_end_us: i64
    status: i64
    object_sha256: text

pub struct GroupNativeThreadExecutionV1:
    module_a: text
    module_b: text
    process_id_a: i64
    process_id_b: i64
    thread_id_a: i64
    thread_id_b: i64
    llvm_start_us_a: i64
    llvm_end_us_a: i64
    llvm_start_us_b: i64
    llvm_end_us_b: i64
    object_sha256_a: text
    object_sha256_b: text

pub struct GroupNativeLlvmPairResultV1:
    accepted: bool
    reason: text
    baseline_status_a: i64
    baseline_status_b: i64
    threaded_status_a: i64
    threaded_status_b: i64
    qualification: GroupNativeThreadQualificationV1?
    execution: GroupNativeThreadExecutionV1?

# One group-process owner installs the two immutable slots before spawning.
# Workers receive only (slot, generation), never a heap address. The atomic
# gate excludes another owner while the registry is installed. Workers read
# distinct MIR/storage slots, produce distinct file results, and the owner
# clears the registry only after joining every spawned thread.
var _group_native_llvm_gate_v1: AtomicI64 = atomic_i64_new(0)
var _group_native_llvm_jobs_v1: [GroupNativeLlvmJobV1] = []
var _group_native_llvm_generation_v1: i64 = 0
var _group_native_llvm_last_generation_v1: i64 = 0
var _group_native_llvm_qualified_proof_hash_v1: text = ""
var _group_native_llvm_calibration_key_v1: text = ""
var _group_native_llvm_calibration_policy_v1: text = ""
var _group_native_llvm_calibration_pid_v1: i64 = 0
var _group_native_llvm_calibration_proof_v1: GroupNativeThreadQualificationV1? = nil

fn _group_native_proof_hash_v1(proof: GroupNativeThreadQualificationV1) -> text:
    sha256_text("{proof.backend}|{proof.module_a}|{proof.module_b}|{proof.process_id_a}|{proof.process_id_b}|{proof.thread_id_a}|{proof.thread_id_b}|{proof.llvm_start_us_a}|{proof.llvm_end_us_a}|{proof.llvm_start_us_b}|{proof.llvm_end_us_b}|{proof.baseline_object_sha256_a}|{proof.baseline_object_sha256_b}|{proof.threaded_object_sha256_a}|{proof.threaded_object_sha256_b}")

fn _group_native_sha256_file_v1(path: text) -> text:
    if not file_is_regular_no_follow(path):
        return ""
    val bytes = rt_file_read_bytes(path) ?? []
    if bytes.len() <= 0:
        return ""
    sha256_u8_hex(bytes)

fn _group_native_unique_job_paths_v1(a: GroupNativeLlvmJobV1, b: GroupNativeLlvmJobV1) -> bool:
    val paths = [a.baseline_object_path, a.baseline_diagnostic_path,
        a.object_path, a.diagnostic_path, a.receipt_path,
        b.baseline_object_path, b.baseline_diagnostic_path,
        b.object_path, b.diagnostic_path, b.receipt_path]
    for i in 0..paths.len():
        if paths[i] == "" or file_exists(paths[i]):
            return false
        for j in (i + 1)..paths.len():
            if paths[i] == paths[j]:
                return false
    true

fn _group_native_same_policy_v1(a: GroupNativeLlvmJobV1, b: GroupNativeLlvmJobV1) -> bool:
    a.options.target == b.options.target and
        a.options.opt_level == b.options.opt_level and
        a.options.debug_info == b.options.debug_info and
        a.bootstrap_mode == b.bootstrap_mode and
        a.target.triple.arch == b.target.triple.arch and
        a.target.triple.vendor == b.target.triple.vendor and
        a.target.triple.os == b.target.triple.os and
        a.target.triple.env == b.target.triple.env and
        a.target.to_cpu_string() == b.target.to_cpu_string() and
        a.target.to_feature_string() == b.target.to_feature_string()

fn _group_native_policy_fingerprint_v1(a: GroupNativeLlvmJobV1,
    b: GroupNativeLlvmJobV1) -> text:
    sha256_text("{a.options.target}|{a.options.opt_level}|" +
        "{a.options.debug_info}|{a.target.triple.arch}|" +
        "{a.target.triple.vendor}|{a.target.triple.os}|" +
        "{a.target.triple.env}|{a.target.to_cpu_string()}|" +
        "{a.target.to_feature_string()}|{a.bootstrap_mode}|" +
        "{a.is_entry}|{b.is_entry}")

fn _group_native_emit_v1(job: GroupNativeLlvmJobV1, object_path: text,
    diagnostic_path: text, receipt_path: text) -> i64:
    val process_id = getpid()
    val thread_id = thread_native_current_id()
    val start_us = time_now_unix_micros()
    val ir = llvm_group_translate_module_ir_v1(
        job.options, job.module, job.target, job.is_entry,
        job.bootstrap_mode)
    val end_us = time_now_unix_micros()
    val status = compile_ir_to_object_path(
        ir, job.target, job.options.opt_level,
        object_path, diagnostic_path, true)
    if receipt_path != "":
        val digest = if status == 0: _group_native_sha256_file_v1(object_path) else: ""
        val receipt = "{process_id}|{thread_id}|{start_us}|{end_us}|{status}|{digest}"
        if not file_write(receipt_path, receipt):
            return 3
    status

fn _group_native_llvm_slot_worker_v1(slot_arg: Any, generation_arg: Any) -> i64:
    val slot: i64 = slot_arg
    val generation: i64 = generation_arg
    if generation <= 0 or generation != _group_native_llvm_generation_v1:
        return 4
    if slot < 0 or slot >= _group_native_llvm_jobs_v1.len():
        return 4
    val job = _group_native_llvm_jobs_v1[slot]
    if job.storage_bindings.len() != 0:
        return 4
    _group_native_emit_v1(job, job.object_path, job.diagnostic_path, job.receipt_path)

fn _group_native_receipt_v1(path: text) -> GroupNativeLlvmWorkerReceiptV1:
    if not file_is_regular_no_follow(path):
        return GroupNativeLlvmWorkerReceiptV1(0, 0, 0, 0, 4, "")
    val parts = file_read_text(path).split("|")
    if parts.len() != 6:
        return GroupNativeLlvmWorkerReceiptV1(0, 0, 0, 0, 4, "")
    GroupNativeLlvmWorkerReceiptV1(
        parts[0].parse_int() ?? 0, parts[1].parse_int() ?? 0,
        parts[2].parse_int() ?? 0, parts[3].parse_int() ?? 0,
        parts[4].parse_int() ?? 4, parts[5])

fn _group_native_llvm_pair_failure_v1(reason: text, baseline_a: i64,
    baseline_b: i64, threaded_a: i64, threaded_b: i64) -> GroupNativeLlvmPairResultV1:
    GroupNativeLlvmPairResultV1(false, reason, baseline_a, baseline_b,
        threaded_a, threaded_b, nil, nil)

fn _group_native_execution_v1(a: GroupNativeLlvmJobV1, b: GroupNativeLlvmJobV1,
    receipt_a: GroupNativeLlvmWorkerReceiptV1,
    receipt_b: GroupNativeLlvmWorkerReceiptV1) -> GroupNativeThreadExecutionV1:
    GroupNativeThreadExecutionV1(a.module.name, b.module.name,
        receipt_a.process_id, receipt_b.process_id,
        receipt_a.thread_id, receipt_b.thread_id,
        receipt_a.llvm_start_us, receipt_a.llvm_end_us,
        receipt_b.llvm_start_us, receipt_b.llvm_end_us,
        receipt_a.object_sha256, receipt_b.object_sha256)

fn _group_native_execution_valid_v1(execution: GroupNativeThreadExecutionV1) -> bool:
    execution.module_a != "" and execution.module_b != "" and
        execution.module_a != execution.module_b and
        execution.process_id_a == getpid() and
        execution.process_id_a == execution.process_id_b and
        execution.thread_id_a > 0 and execution.thread_id_b > 0 and
        execution.thread_id_a != execution.thread_id_b and
        execution.llvm_start_us_a > 0 and execution.llvm_start_us_b > 0 and
        execution.llvm_end_us_a > execution.llvm_start_us_a and
        execution.llvm_end_us_b > execution.llvm_start_us_b and
        execution.llvm_start_us_a < execution.llvm_end_us_b and
        execution.llvm_start_us_b < execution.llvm_end_us_a and
        execution.object_sha256_a.len() == 64 and
        execution.object_sha256_b.len() == 64

fn _group_native_llvm_calibration_matches_unlocked_v1(key: text) -> bool:
    if key == "" or _group_native_llvm_calibration_pid_v1 != getpid() or
        _group_native_llvm_calibration_key_v1 != key:
        return false
    match _group_native_llvm_calibration_proof_v1:
        Some(proof):
            _group_native_llvm_qualified_proof_hash_v1 != "" and
                _group_native_llvm_qualified_proof_hash_v1 == _group_native_proof_hash_v1(proof)
        nil: false

pub fn group_native_llvm_has_calibration_v1(key: text) -> bool:
    if not _group_native_llvm_gate_v1.compare_exchange(
        0, 2, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        return false
    val matched = _group_native_llvm_calibration_matches_unlocked_v1(key)
    _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
    matched

pub fn group_native_llvm_qualify_pair_v1(
    job_a: GroupNativeLlvmJobV1, job_b: GroupNativeLlvmJobV1,
    generation: i64, calibration_key: text
) -> GroupNativeLlvmPairResultV1:
    if not _group_native_llvm_gate_v1.compare_exchange(
        0, 1, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        return _group_native_llvm_pair_failure_v1(
            "another LLVM group owns the slot registry", 4, 4, 4, 4)
    if generation <= 0 or generation <= _group_native_llvm_last_generation_v1:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "stale group generation", 4, 4, 4, 4)
    if calibration_key == "" or job_a.module.name == "" or job_b.module.name == "" or
        job_a.module.name == job_b.module.name or
        job_a.storage_bindings.len() != 0 or job_b.storage_bindings.len() != 0 or
        not _group_native_same_policy_v1(job_a, job_b) or
        not _group_native_unique_job_paths_v1(job_a, job_b):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "invalid or shared worker inputs or output paths", 4, 4, 4, 4)
    if (env_get_opt("SIMPLE_NATIVE_BUILD_NO_MANGLE") ?? "") == "1":
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "explicit LLVM route does not admit ambient no-mangle policy", 4, 4, 4, 4)
    if ((env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1") != job_a.bootstrap_mode:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "frozen bootstrap policy differs from process policy", 4, 4, 4, 4)
    if (env_get_opt("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1":
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "bootstrap debug translation is not private", 4, 4, 4, 4)
    _group_native_llvm_last_generation_v1 = generation
    _group_native_llvm_qualified_proof_hash_v1 = ""
    _group_native_llvm_calibration_key_v1 = ""
    _group_native_llvm_calibration_policy_v1 = ""
    _group_native_llvm_calibration_pid_v1 = 0
    _group_native_llvm_calibration_proof_v1 = nil

    # Produce the serial baseline through the ordinary builtin-session LLVM
    # path, retaining its admitted target config and llc argument policy. It runs
    # before either worker starts, so its legacy globals are owner-private in
    # time. Equal digests then prove worker objects match production emission,
    # not merely another run of the worker-only translator.
    val base_a = llvm_compile_module_direct_to_path(
        job_a.options, job_a.module, job_a.baseline_object_path,
        job_a.baseline_diagnostic_path, Some(job_a.target))
    val base_b = llvm_compile_module_direct_to_path(
        job_b.options, job_b.module, job_b.baseline_object_path,
        job_b.baseline_diagnostic_path, Some(job_b.target))
    if base_a != 0 or base_b != 0:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "serial LLVM baseline failed", base_a, base_b, 4, 4)
    val baseline_sha_a = _group_native_sha256_file_v1(job_a.baseline_object_path)
    val baseline_sha_b = _group_native_sha256_file_v1(job_b.baseline_object_path)
    if baseline_sha_a.len() != 64 or baseline_sha_b.len() != 64:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "serial LLVM baseline object is absent", base_a, base_b, 4, 4)

    _group_native_llvm_jobs_v1 = [job_a, job_b]
    _group_native_llvm_generation_v1 = generation
    val handle_a = thread_spawn_with_i64_args_id(0, generation, _group_native_llvm_slot_worker_v1)
    val handle_b = thread_spawn_with_i64_args_id(1, generation, _group_native_llvm_slot_worker_v1)
    var threaded_a: i64 = 4
    var threaded_b: i64 = 4
    if handle_a > 0:
        threaded_a = thread_join_by_id(handle_a) ?? 4
    if handle_b > 0:
        threaded_b = thread_join_by_id(handle_b) ?? 4
    # Both worker lifetimes ended before the owner clears shared slots.
    _group_native_llvm_jobs_v1 = []
    _group_native_llvm_generation_v1 = 0
    if handle_a <= 0 or handle_b <= 0 or threaded_a != 0 or threaded_b != 0:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "LLVM worker spawn or object emission failed", base_a, base_b,
            threaded_a, threaded_b)
    val receipt_a = _group_native_receipt_v1(job_a.receipt_path)
    val receipt_b = _group_native_receipt_v1(job_b.receipt_path)
    if receipt_a.status != 0 or receipt_b.status != 0:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "LLVM worker receipt missing or invalid", base_a, base_b,
            threaded_a, threaded_b)
    if receipt_a.object_sha256 != _group_native_sha256_file_v1(job_a.object_path) or
        receipt_b.object_sha256 != _group_native_sha256_file_v1(job_b.object_path):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "LLVM worker artifact changed after its receipt", base_a, base_b,
            threaded_a, threaded_b)
    val execution = _group_native_execution_v1(job_a, job_b, receipt_a, receipt_b)
    if not _group_native_execution_valid_v1(execution):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "LLVM worker lifecycle or overlap invalid", base_a, base_b,
            threaded_a, threaded_b)
    val proof = GroupNativeThreadQualificationV1(
        "llvm", job_a.module.name, job_b.module.name,
        receipt_a.process_id, receipt_b.process_id,
        receipt_a.thread_id, receipt_b.thread_id,
        receipt_a.llvm_start_us, receipt_a.llvm_end_us,
        receipt_b.llvm_start_us, receipt_b.llvm_end_us,
        baseline_sha_a, baseline_sha_b,
        receipt_a.object_sha256, receipt_b.object_sha256)
    if not _group_native_llvm_overlap_v1(proof) or not _group_native_object_parity_v1(proof):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "LLVM worker overlap or object parity unqualified", base_a, base_b,
            threaded_a, threaded_b)
    _group_native_llvm_qualified_proof_hash_v1 = _group_native_proof_hash_v1(proof)
    _group_native_llvm_calibration_key_v1 = calibration_key
    _group_native_llvm_calibration_policy_v1 =
        _group_native_policy_fingerprint_v1(job_a, job_b)
    _group_native_llvm_calibration_pid_v1 = getpid()
    _group_native_llvm_calibration_proof_v1 = Some(proof)
    _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
    GroupNativeLlvmPairResultV1(true, "qualified", base_a, base_b,
        threaded_a, threaded_b, Some(proof), Some(execution))

# A later pair may skip serial baselines only under the exact calibration key
# issued in this process. Its own native threads, receipts, SHA-256 artifacts,
# and overlapping LLVM translation intervals are still checked before return.
pub fn group_native_llvm_emit_calibrated_pair_v1(
    job_a: GroupNativeLlvmJobV1, job_b: GroupNativeLlvmJobV1,
    generation: i64, calibration_key: text
) -> GroupNativeLlvmPairResultV1:
    if not _group_native_llvm_gate_v1.compare_exchange(
        0, 1, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
        return _group_native_llvm_pair_failure_v1(
            "another LLVM group owns the slot registry", 4, 4, 4, 4)
    if not _group_native_llvm_calibration_matches_unlocked_v1(calibration_key) or
        _group_native_llvm_calibration_policy_v1 !=
            _group_native_policy_fingerprint_v1(job_a, job_b) or
        generation <= 0 or generation <= _group_native_llvm_last_generation_v1 or
        job_a.module.name == "" or job_b.module.name == "" or
        job_a.module.name == job_b.module.name or
        job_a.storage_bindings.len() != 0 or job_b.storage_bindings.len() != 0 or
        not _group_native_same_policy_v1(job_a, job_b) or
        not _group_native_unique_job_paths_v1(job_a, job_b):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "calibration, generation, or frozen worker input invalid", 4, 4, 4, 4)
    if (env_get_opt("SIMPLE_NATIVE_BUILD_NO_MANGLE") ?? "") == "1" or
        (env_get_opt("SIMPLE_BOOTSTRAP_DEBUG") ?? "") == "1" or
        ((env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1") != job_a.bootstrap_mode:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "ambient LLVM policy drifted after calibration", 4, 4, 4, 4)
    _group_native_llvm_last_generation_v1 = generation
    _group_native_llvm_jobs_v1 = [job_a, job_b]
    _group_native_llvm_generation_v1 = generation
    val handle_a = thread_spawn_with_i64_args_id(0, generation, _group_native_llvm_slot_worker_v1)
    val handle_b = thread_spawn_with_i64_args_id(1, generation, _group_native_llvm_slot_worker_v1)
    var threaded_a: i64 = 4
    var threaded_b: i64 = 4
    if handle_a > 0:
        threaded_a = thread_join_by_id(handle_a) ?? 4
    if handle_b > 0:
        threaded_b = thread_join_by_id(handle_b) ?? 4
    _group_native_llvm_jobs_v1 = []
    _group_native_llvm_generation_v1 = 0
    if handle_a <= 0 or handle_b <= 0 or threaded_a != 0 or threaded_b != 0:
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "calibrated LLVM worker spawn or emission failed", 4, 4,
            threaded_a, threaded_b)
    val receipt_a = _group_native_receipt_v1(job_a.receipt_path)
    val receipt_b = _group_native_receipt_v1(job_b.receipt_path)
    if receipt_a.status != 0 or receipt_b.status != 0 or
        receipt_a.object_sha256 != _group_native_sha256_file_v1(job_a.object_path) or
        receipt_b.object_sha256 != _group_native_sha256_file_v1(job_b.object_path):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "calibrated LLVM receipt or object hash invalid", 4, 4,
            threaded_a, threaded_b)
    val execution = _group_native_execution_v1(job_a, job_b, receipt_a, receipt_b)
    if not _group_native_execution_valid_v1(execution):
        _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
        return _group_native_llvm_pair_failure_v1(
            "calibrated LLVM thread overlap invalid", 4, 4,
            threaded_a, threaded_b)
    val proof = _group_native_llvm_calibration_proof_v1
    _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
    GroupNativeLlvmPairResultV1(true, "calibrated", -1, -1,
        threaded_a, threaded_b, proof, Some(execution))

fn _group_native_llvm_overlap_v1(proof: GroupNativeThreadQualificationV1) -> bool:
    if proof.backend != "llvm" or proof.module_a == "" or proof.module_b == "":
        return false
    if proof.module_a == proof.module_b:
        return false
    if proof.process_id_a <= 0 or proof.process_id_a != proof.process_id_b:
        return false
    if proof.thread_id_a <= 0 or proof.thread_id_b <= 0 or proof.thread_id_a == proof.thread_id_b:
        return false
    if proof.llvm_start_us_a <= 0 or proof.llvm_start_us_b <= 0:
        return false
    if proof.llvm_end_us_a <= proof.llvm_start_us_a or proof.llvm_end_us_b <= proof.llvm_start_us_b:
        return false
    proof.llvm_start_us_a < proof.llvm_end_us_b and proof.llvm_start_us_b < proof.llvm_end_us_a

fn _group_native_object_parity_v1(proof: GroupNativeThreadQualificationV1) -> bool:
    # SHA-256 digests are bound to exact object bytes by the worker/owner
    # receipt contract. A missing or malformed digest cannot qualify threads.
    if proof.baseline_object_sha256_a.len() != 64 or proof.baseline_object_sha256_b.len() != 64:
        return false
    if proof.threaded_object_sha256_a.len() != 64 or proof.threaded_object_sha256_b.len() != 64:
        return false
    proof.baseline_object_sha256_a == proof.threaded_object_sha256_a and
        proof.baseline_object_sha256_b == proof.threaded_object_sha256_b

pub fn group_native_thread_capability_v1(
    backend: text,
    requested_threads: i64,
    member_count: i64,
    host_cpus: i64,
    available_bytes: i64,
    reserve_bytes: i64,
    measured_per_thread_bytes: i64,
    qualification: GroupNativeThreadQualificationV1?
) -> GroupNativeThreadCapabilityV1:
    if requested_threads <= 0 or member_count <= 0 or host_cpus <= 0:
        return GroupNativeThreadCapabilityV1(requested_threads, 0,
            "invalid worker request or empty group", false, false)
    if available_bytes <= 0 or reserve_bytes < 0 or measured_per_thread_bytes <= 0:
        return GroupNativeThreadCapabilityV1(requested_threads, 0,
            "memory capacity is unmeasured", false, false)
    if reserve_bytes >= available_bytes:
        return GroupNativeThreadCapabilityV1(requested_threads, 0,
            "memory reserve consumes available capacity", false, false)
    val memory_workers = (available_bytes - reserve_bytes) / measured_per_thread_bytes
    if memory_workers <= 0:
        return GroupNativeThreadCapabilityV1(requested_threads, 0,
            "memory budget below one worker", false, false)
    var bounded = requested_threads
    if bounded > member_count:
        bounded = member_count
    if bounded > host_cpus:
        bounded = host_cpus
    if bounded > memory_workers:
        bounded = memory_workers
    if bounded <= 1:
        return GroupNativeThreadCapabilityV1(requested_threads, 1,
            "bounded group capacity is one worker", false, false)
    if backend != "llvm":
        return GroupNativeThreadCapabilityV1(requested_threads, 1,
            "backend lacks inner-thread qualification", false, false)
    match qualification:
        Some(proof):
            if not _group_native_llvm_gate_v1.compare_exchange(
                0, 2, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst):
                return GroupNativeThreadCapabilityV1(requested_threads, 1,
                    "LLVM qualification registry is busy", false, false)
            val overlap = _group_native_llvm_overlap_v1(proof)
            val parity = _group_native_object_parity_v1(proof)
            val issued = _group_native_llvm_qualified_proof_hash_v1 != "" and
                _group_native_llvm_qualified_proof_hash_v1 == _group_native_proof_hash_v1(proof)
            _group_native_llvm_gate_v1.store(0, MemoryOrdering.SeqCst)
            if overlap and parity and issued:
                return GroupNativeThreadCapabilityV1(requested_threads, bounded,
                    "same-process LLVM emission overlap and object parity qualified",
                    true, true)
            GroupNativeThreadCapabilityV1(requested_threads, 1,
                "LLVM inner-thread qualification failed or was not issued", overlap, parity)
        nil:
            GroupNativeThreadCapabilityV1(requested_threads, 1,
                "LLVM inner-thread qualification absent", false, false)

