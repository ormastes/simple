use common.plugin.iface_id.{IfaceId}
use compiler.backend.backend.backend_types.{BackendKind, BackendCompileOptions, CodegenTarget, CompileError}
use compiler.backend.codegen_types.{Codegen, CodegenOutput, CodegenOutputKind}
use compiler.common.driver_compile_options.{CompileOptions}
use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.backend_port.{
    BACKEND_PORT_ERROR_MAJOR, BACKEND_PORT_IFACE_DIGEST, BackendDescV1,
    BackendPortV1, BackendPlugin, StaticBackendPluginV1, CodegenParamsV1,
    backend_port_host_iface, backend_plugin_from_port_v1, codegen_params_v1,
    codegen_params_from_backend_options_v1,
    codegen_params_from_compile_options_v1,
    backend_target_list_supports_v1}
use std.io_runtime.{env_get_opt}
export use compiler.backend.static_backend_types.{BackendLinkClass, StaticBackendEntryV1}

pub enum StaticBackendSelectionError:
    NotFound(text)
    MajorMismatch(text, i64, i64)
    DigestMismatch(text)
    InvalidTable(text)

# reason: optional_static_backends_installed records the boolean installation state required by the v1 composition receipt contract
@allow(primitive_api)
pub struct BackendCompositionReceiptV1:
    composition_mode: text
    k1_policy: text
    optional_static_backends_installed: bool

var _k1_static_backend_table_v1: [StaticBackendEntryV1] = []
var _k1_static_backend_policy_v1: text = ""
var _k1_static_backend_table_installed_v1: bool = false
var _full_static_backend_table_v1: [StaticBackendEntryV1] = []
var _full_static_backend_table_installed_v1: bool = false
var _installed_backend_composition_mode_v1: text = ""

impl StaticBackendSelectionError:
    fn code() -> text:
        match self:
            case NotFound(_): "PLUG-E-NOTFOUND"
            case MajorMismatch(_, _, _): BACKEND_PORT_ERROR_MAJOR
            case DigestMismatch(_): "PLUG-E-DIGEST"
            case InvalidTable(_): "PLUG-E-TABLE"

pub fn static_backend_entry_v1(kind: BackendKind, link_class: BackendLinkClass,
        port: BackendPortV1, output_kind: CodegenOutputKind) -> StaticBackendEntryV1:
    StaticBackendEntryV1(kind, link_class, backend_plugin_from_port_v1(port), output_kind)

pub fn static_backend_table_v1() -> [StaticBackendEntryV1]:
    _k1_static_backend_table_v1

pub fn static_backend_name_precedes_v1(previous: text, name: text) -> bool:
    # Native bootstrap text relational operators compare tagged addresses.
    # Compare character values explicitly so table admission depends only on
    # names, including equality/prefix cases, never allocation order. See
    # stage2_backend_composition_admission_failed_2026-09-09.md.
    var index = 0
    while index < previous.byte_len() and index < name.byte_len():
        val previous_code = previous.char_code_at(index)
        val name_code = name.char_code_at(index)
        if previous_code != name_code:
            return previous_code < name_code
        index = index + 1
    previous.byte_len() < name.byte_len()

fn _table_is_sorted_v1(table: [StaticBackendEntryV1]) -> bool:
    var previous = ""
    for entry in table:
        val name = entry.plugin.describe().name
        if name == "" or not static_backend_name_precedes_v1(previous, name) or name != entry.kind.to_text():
            return false
        previous = name
    true

pub fn validate_k1_static_backend_table_v1(policy: text,
        table: [StaticBackendEntryV1]) -> bool:
    if not _table_is_sorted_v1(table):
        return false
    if policy == "llvm-cranelift":
        return table.len() == 3 and
            table[0].kind == BackendKind.Cranelift and
            table[0].link_class == BackendLinkClass.KernelLinked and
            table[1].kind == BackendKind.Interpreter and
            table[1].link_class == BackendLinkClass.KernelLinked and
            table[2].kind == BackendKind.Llvm and
            table[2].link_class == BackendLinkClass.KernelLinked
    # LLVM-only kernel (src/compositions/kernel_llvm): the lane whose runtime
    # bundle has no Cranelift at all (core-c-bootstrap links only the C core
    # runtime, and every rt_cranelift_*/spl_cranelift_* symbol is Rust-only).
    # Its table carries no Cranelift entry, so the kernel's Cranelift requests
    # resolve to PLUG-E-NOTFOUND and k1_backend_unavailable_message_v1 instead
    # of an undefined symbol at link time or a trap at run time.
    if policy == "llvm":
        return table.len() == 2 and
            table[0].kind == BackendKind.Interpreter and
            table[0].link_class == BackendLinkClass.KernelLinked and
            table[1].kind == BackendKind.Llvm and
            table[1].link_class == BackendLinkClass.KernelLinked
    false

# Diagnostic for a backend the kernel can name but the installed K1
# composition does not link. Shared by every kernel-side request site so the
# refusal is one sentence everywhere (backend_helpers, builtin_adapter, the
# JIT lane) and never a nil stub or an unresolved extern.
pub fn k1_backend_unavailable_message_v1(backend_name: text) -> text:
    val policy = if _k1_static_backend_table_installed_v1:
        _k1_static_backend_policy_v1
    else:
        "unselected"
    "{backend_name} backend not available in this build (K1 policy '{policy}'): " +
        "select a kernel composition that links it " +
        "(SIMPLE_KERNEL_K1_POLICY=llvm-cranelift) or load it with --backend-plugin <path>"

pub fn install_k1_static_backend_table_v1(policy: text,
        table: [StaticBackendEntryV1]) -> bool:
    if not validate_k1_static_backend_table_v1(policy, table):
        return false
    if _k1_static_backend_table_installed_v1:
        return _k1_static_backend_policy_v1 == policy
    _k1_static_backend_table_v1 = table
    _k1_static_backend_policy_v1 = policy
    _k1_static_backend_table_installed_v1 = true
    true

pub fn installed_k1_static_backend_policy_v1() -> text:
    _k1_static_backend_policy_v1

pub fn installed_k1_static_backend_table_v1() -> [StaticBackendEntryV1]:
    _k1_static_backend_table_v1

pub fn install_full_static_backend_table_v1(policy: text,
        table: [StaticBackendEntryV1]) -> bool:
    if _installed_backend_composition_mode_v1 == "host-only":
        return false
    if _full_static_backend_table_installed_v1:
        return _k1_static_backend_policy_v1 == policy
    if not _k1_static_backend_table_installed_v1 or
            _k1_static_backend_policy_v1 != policy or
            not _table_is_sorted_v1(table):
        return false
    for required in _k1_static_backend_table_v1:
        var found = false
        for entry in table:
            if entry.kind == required.kind and
                    entry.link_class == BackendLinkClass.KernelLinked:
                found = true
        if not found:
            return false
    for entry in table:
        if entry.link_class == BackendLinkClass.KernelLinked:
            var authorized = false
            for required in _k1_static_backend_table_v1:
                if entry.kind == required.kind:
                    authorized = true
            if not authorized:
                return false
    _full_static_backend_table_v1 = table
    _full_static_backend_table_installed_v1 = true
    _installed_backend_composition_mode_v1 = "full"
    true

pub fn resolve_backend_composition_mode_v1(
    configured_mode: text, stage3_marker: text
) -> text:
    val normalized = configured_mode.trim().lower()
    if normalized == "host-only":
        return "host-only"
    if normalized == "full":
        return "full"
    if normalized != "":
        return ""
    if stage3_marker.trim() == "1":
        return "host-only"
    "full"

pub fn selected_backend_composition_mode_v1() -> text:
    resolve_backend_composition_mode_v1(
        env_get_opt("SIMPLE_BACKEND_COMPOSITION") ?? "",
        env_get_opt("SIMPLE_BOOTSTRAP_STAGE3") ?? "")

pub fn installed_backend_composition_mode_v1() -> text:
    _installed_backend_composition_mode_v1

# reason: boolean installation verdict matches install_k1_static_backend_table_v1 and install_full_static_backend_table_v1
@allow(primitive_api)
pub fn install_host_only_static_backend_composition_v1(policy: text) -> bool:
    if _full_static_backend_table_installed_v1:
        return false
    if not _k1_static_backend_table_installed_v1 or _k1_static_backend_policy_v1 != policy:
        return false
    if not validate_k1_static_backend_table_v1(policy, _k1_static_backend_table_v1):
        return false
    _installed_backend_composition_mode_v1 = "host-only"
    true

# reason: optional_static_backends_installed mirrors the boolean installation flag in BackendCompositionReceiptV1
@allow(primitive_api)
pub fn backend_composition_receipt_v1(
    composition_mode: text,
    k1_policy: text,
    optional_static_backends_installed: bool
) -> BackendCompositionReceiptV1:
    BackendCompositionReceiptV1(
        composition_mode: composition_mode,
        k1_policy: k1_policy,
        optional_static_backends_installed: optional_static_backends_installed)

pub fn format_backend_composition_receipt_v1(
    receipt: BackendCompositionReceiptV1
) -> text:
    val optional_flag = if receipt.optional_static_backends_installed: "true" else: "false"
    "schema: simple.backend_composition_receipt/1\n" +
        "composition_mode: {receipt.composition_mode}\n" +
        "k1_policy: {receipt.k1_policy}\n" +
        "optional_static_backends_installed: {optional_flag}\n"

impl BackendCompositionReceiptV1:
    fn to_sdn() -> text:
        format_backend_composition_receipt_v1(self)

    fn to_text() -> text:
        format_backend_composition_receipt_v1(self)

pub fn active_backend_composition_receipt_v1() -> BackendCompositionReceiptV1:
    val mode = if _installed_backend_composition_mode_v1 != "":
        _installed_backend_composition_mode_v1
    elif _full_static_backend_table_installed_v1:
        "full"
    else:
        selected_backend_composition_mode_v1()
    val k1_policy = if _k1_static_backend_table_installed_v1:
        _k1_static_backend_policy_v1
    else:
        "unselected"
    BackendCompositionReceiptV1(
        composition_mode: mode,
        k1_policy: k1_policy,
        optional_static_backends_installed: _full_static_backend_table_installed_v1)

pub fn full_static_backend_table_installed_v1() -> bool:
    _full_static_backend_table_installed_v1

pub fn active_static_backend_table_v1() -> [StaticBackendEntryV1]:
    if _full_static_backend_table_installed_v1:
        return _full_static_backend_table_v1
    _k1_static_backend_table_v1

fn _entry_name(entry: StaticBackendEntryV1) -> text:
    entry.plugin.describe().name

pub fn negotiate_static_backend_entry_v1(host_iface: IfaceId, entry: StaticBackendEntryV1) -> Result<StaticBackendEntryV1, StaticBackendSelectionError>:
    val name = _entry_name(entry)
    val iface = entry.plugin.iface()
    if iface.name != host_iface.name:
        return Err(StaticBackendSelectionError.NotFound(name))
    if iface.major != host_iface.major:
        return Err(StaticBackendSelectionError.MajorMismatch(name, host_iface.major, iface.major))
    if iface.abi_digest != host_iface.abi_digest or iface.abi_digest != BACKEND_PORT_IFACE_DIGEST:
        return Err(StaticBackendSelectionError.DigestMismatch(name))
    Ok(entry)

pub fn select_static_backend_v1(name: text, table: [StaticBackendEntryV1] = active_static_backend_table_v1()) -> Result<StaticBackendEntryV1, StaticBackendSelectionError>:
    var previous = ""
    for entry in table:
        val entry_name = _entry_name(entry)
        if entry_name == "" or not static_backend_name_precedes_v1(previous, entry_name) or entry_name != entry.kind.to_text():
            return Err(StaticBackendSelectionError.InvalidTable(entry_name))
        previous = entry_name
        if entry_name == name:
            return negotiate_static_backend_entry_v1(backend_port_host_iface(), entry)
    Err(StaticBackendSelectionError.NotFound(name))

pub class StaticBackendCodegenV1:
    entry: StaticBackendEntryV1
    params: CodegenParamsV1

impl Codegen for StaticBackendCodegenV1:
    fn backend_kind() -> BackendKind: self.entry.kind
    fn backend_name() -> text: _entry_name(self.entry)
    fn compile_module(module: MirModule) -> Result<CodegenOutput, CompileError>: self.entry.plugin.run(self.params, module)
    # reason: Codegen.supports_target trait contract returns bool
    #[allow(primitive_api)]
    fn supports_target(target: CodegenTarget) -> bool:
        backend_target_list_supports_v1(self.entry.plugin.describe().targets, target.to_text())
    fn output_kind() -> CodegenOutputKind: self.entry.output_kind

impl StaticBackendCodegenV1:
    # reason: target-name admission predicate mirrors BackendSession.supports_target
    #[allow(primitive_api)]
    fn supports_target_name(target_name: text) -> bool:
        backend_target_list_supports_v1(self.entry.plugin.describe().targets, target_name)

pub fn static_backend_codegen_instance_v1(
    entry: StaticBackendEntryV1,
    options: BackendCompileOptions,
    explicit_cpu: text = ""
) -> StaticBackendCodegenV1:
    StaticBackendCodegenV1(
        entry,
        codegen_params_from_backend_options_v1(options, explicit_cpu))

pub fn static_backend_codegen_for_compile_options_v1(
    entry: StaticBackendEntryV1,
    driver_options: CompileOptions,
    backend_options: BackendCompileOptions,
    explicit_cpu: text = ""
) -> StaticBackendCodegenV1:
    StaticBackendCodegenV1(
        entry,
        codegen_params_from_compile_options_v1(driver_options, backend_options, explicit_cpu))

pub fn static_backend_codegen_v1(entry: StaticBackendEntryV1, options: BackendCompileOptions) -> Codegen:
    static_backend_codegen_instance_v1(entry, options)

# Error-path diagnostic for site 16/18
# (stage2_sanity_positional_route_k1_composition_admission_failed_2026-09-13.md):
# validate_k1_static_backend_table_v1 answered false inside a compiled Stage-2
# capsule on a table the same source accepts on the seed, and the verdict
# discarded WHICH sub-check failed. This reports every sub-check by name so one
# lane run localises the miscompile. Never called on the success path; changes
# no verdict.
pub fn k1_static_backend_table_diagnostic_v1(policy: text,
        table: [StaticBackendEntryV1]) -> text:
    var out = "policy='{policy}' len={table.len()} len_eq_3={table.len() == 3} sorted={_table_is_sorted_v1(table)}"
    var index = 0
    for entry in table:
        val name = entry.plugin.describe().name
        val kind_text = entry.kind.to_text()
        out = out + " [{index}] name='{name}' kind_text='{kind_text}' name_eq_kind={name == kind_text}"
        out = out + " kind_is_cranelift={entry.kind == BackendKind.Cranelift}"
        out = out + " kind_is_interpreter={entry.kind == BackendKind.Interpreter}"
        out = out + " kind_is_llvm={entry.kind == BackendKind.Llvm}"
        out = out + " link_is_kernel={entry.link_class == BackendLinkClass.KernelLinked}"
        index = index + 1
    out
