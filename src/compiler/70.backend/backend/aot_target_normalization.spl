# Pure AOT target spelling shared by target providers and backend adapters.
# Keep host discovery, environment reads and toolchain probing in providers.

pub fn backend_aot_simpleos_target_triple(target: text) -> text:
    val value = target.trim().lower()
    match value:
        case "simpleos" | "simpleos-x86_64" |
             "x86_64-simpleos" | "x86_64-unknown-simpleos" |
             "x86_64-unknown-simpleos-elf":
            "x86_64-unknown-none-elf"
        case "aarch64-simpleos" | "aarch64-unknown-simpleos" |
             "aarch64-unknown-simpleos-elf":
            "aarch64-unknown-none-elf"
        case "i686-simpleos" | "i686-unknown-simpleos" | "i686-unknown-simpleos-elf" |
             "i386-simpleos" | "i386-unknown-simpleos" | "i386-unknown-simpleos-elf":
            "i686-unknown-none-elf"
        case "armv7-simpleos" | "armv7-unknown-simpleos" | "armv7-unknown-simpleos-elf" |
             "armv7a-unknown-simpleos" | "armv7a-unknown-simpleos-eabi":
            "armv7a-none-eabi"
        case "riscv32-simpleos" | "riscv32-unknown-simpleos" | "riscv32-unknown-simpleos-elf" |
             "riscv32imac-simpleos" | "riscv32imac-unknown-simpleos" | "riscv32imac-unknown-simpleos-elf":
            "riscv32imac-unknown-none-elf"
        case "riscv64-simpleos" | "riscv64gc-simpleos" |
             "riscv64-unknown-simpleos" | "riscv64gc-unknown-simpleos" |
             "riscv64-unknown-simpleos-elf" |
             "riscv64gc-unknown-simpleos-elf":
            "riscv64gc-unknown-none-elf"
        case _: ""

# Recognized 32-bit user triples use the sysroot route. Unknown spellings still
# fail closed rather than entering hosted linking or the RV32 kernel lane.
pub fn backend_aot_simpleos_32bit_user_target_error(target: text) -> text:
    val value = target.trim().lower()
    if not value.contains("-simpleos"):
        return ""
    if not (value.starts_with("i686-") or value.starts_with("i386-") or value.starts_with("armv7") or value.starts_with("riscv32")):
        return ""
    if backend_aot_simpleos_target_triple(value) != "":
        return ""
    "SimpleOS 32-bit userland target {target} has an unsupported triple spelling"

pub fn backend_normalize_requested_aot_target(target: text) -> text:
    val value = target.trim().lower()
    val simpleos_target = backend_aot_simpleos_target_triple(value)
    if simpleos_target != "":
        return simpleos_target
    # The bare-metal LLVM triple is "<arch>-unknown-none" with no env. Cranelift's
    # target-lexicon parses that with BinaryFormat::Unknown and ObjectBuilder
    # rejects it, so name the freestanding ELF object format explicitly.
    # Bug: cranelift_bare_metal_none_triple_unknown_binary_format_2026-11-15.
    if value.ends_with("-unknown-none") and value.split("-").len() == 3:
        return "{value}-elf"
    if value == "host" or value == "native": "" else: value
