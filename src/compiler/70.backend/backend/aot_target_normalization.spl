# Pure AOT target spelling shared by target providers and backend adapters.
# Keep host discovery, environment reads and toolchain probing in providers.

pub fn backend_aot_simpleos_target_triple(target: text) -> text:
    val value = target.trim().lower()
    match value:
        case "simpleos" | "simpleos-x86_64" |
             "x86_64-simpleos" | "x86_64-unknown-simpleos" |
             "x86_64-unknown-simpleos-elf":
            "x86_64-unknown-none-elf"
        case "aarch64-simpleos" | "aarch64-unknown-simpleos" |
             "aarch64-unknown-simpleos-elf":
            "aarch64-unknown-none-elf"
        case "riscv64-simpleos" | "riscv64gc-simpleos" |
             "riscv64-unknown-simpleos" | "riscv64gc-unknown-simpleos" |
             "riscv64-unknown-simpleos-elf" |
             "riscv64gc-unknown-simpleos-elf":
            "riscv64gc-unknown-none-elf"
        case _: ""

pub fn backend_normalize_requested_aot_target(target: text) -> text:
    val value = target.trim().lower()
    val simpleos_target = backend_aot_simpleos_target_triple(value)
    if simpleos_target != "":
        return simpleos_target
    if value == "host" or value == "native": "" else: value
