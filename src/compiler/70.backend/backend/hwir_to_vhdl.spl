# Strict HWIR to VHDL-2008 emission.
#
# This is intentionally a fail-closed serializer.  It accepts only the typed
# combinational graph forms represented by HwModuleDef and never delegates a
# rejected graph to the legacy textual VHDL path.

use compiler.mir.hwir.types.{CoreConfig, HwCombOp, HwConstant, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, hwir_hash_fields, hwir_safe_profile_name}
use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}
use compiler.mir.hwir.mir_to_hwir.{lower_strict_mir_function_to_hwir}
use compiler.mir.mir_data.{MirFunction, MirModule}
use compiler.mir.hwir.frontend.{strict_zca_control_predecode_hwir, strict_zca_migrating_predecode_hwir, strict_zca_rv32_cjal_migrating_predecode_hwir, strict_zca_rv64_addiw_migrating_predecode_hwir}
use compiler.mir.hwir.trap_frontend.{strict_zca_trap_migrating_predecode_hwir, strict_zca_target_trap_migrating_predecode_hwir}
use compiler.mir.hwir.stateful_frontend.{HwParcelFrontendDef, HwTrapParcelFrontendDef, strict_parcel_frontend_decoder_entity, strict_zca_single_outstanding_frontend_hwir, strict_zca_trap_single_outstanding_frontend_hwir}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard, HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef, HwSequentialPlan, HwStateRegister}
use compiler.mir.hwir.retirement_composition.{HwParcelRetirementComposition, HwRetireCompositionBinding}
use std.common.crypto.sha256.{sha256_text}

class HwirVhdlBridgeResult:
    used_hwir: bool
    module_name: text
    vhdl: text
    fallback_function: text
    diagnostic: text

    me uses_existing_path() -> bool:
        return not self.used_hwir

    static fn fallback(module: HwModule, diagnostic: text) -> HwirVhdlBridgeResult:
        HwirVhdlBridgeResult(used_hwir: false, module_name: module.name, vhdl: "", fallback_function: module.fallback_function, diagnostic: diagnostic)

    static fn emitted(module: HwModule, vhdl: text) -> HwirVhdlBridgeResult:
        HwirVhdlBridgeResult(used_hwir: true, module_name: module.name, vhdl: vhdl, fallback_function: module.fallback_function, diagnostic: "")

pub class HwirStrictVhdlResult:
    success: bool
    vhdl: text
    diagnostic: text
    route: text
    module_node_id: text
    config_xlen: i32
    config_profile: text
    hwir_graph_sha256: text

    me is_success() -> bool:
        self.success

    me uses_legacy_fallback() -> bool:
        false

    pub static fn rejected(diagnostic: text) -> HwirStrictVhdlResult:
        HwirStrictVhdlResult(success: false, vhdl: "", diagnostic: diagnostic,
            route: "hwir-strict", module_node_id: "", config_xlen: 0, config_profile: "", hwir_graph_sha256: "")

    pub static fn emitted(module: HwModuleDef, vhdl: text, route: text) -> HwirStrictVhdlResult:
        HwirStrictVhdlResult(success: true, vhdl: vhdl, diagnostic: "", route: route,
            module_node_id: module.node_id.value, config_xlen: module.config.xlen,
            config_profile: module.config.profile, hwir_graph_sha256: module.structural_sha256())

pub fn strict_hwir_port_schema_sha256(ports: [HwPort]) -> text:
    """Hash the exact ordered child component interface used by strict VHDL.

    A child graph digest binds its implementation graph, while this separate
    digest makes the port-level component boundary independently auditable.
    The closed retirement renderer requires both markers from every child.
    """
    var fields: [text] = ["simple-hwir-port-schema/v1", ports.len().to_text()]
    for port in ports:
        fields.push("port")
        fields.push(port.name)
        fields.push(port.direction)
        fields.push(port.type_name)
        fields.push(port.bit_width.to_text())
        fields.push(port.clock_domain)
    sha256_text(hwir_hash_fields(fields))

fn strict_vhdl_profile_comment(profile: text) -> Result<text, text>:
    """Return one safe opaque token for a strict VHDL provenance comment.

    CoreConfig validation is the primary boundary.  This serializer-side
    guard deliberately repeats it so future strict emitters cannot turn a
    newly introduced configuration path into raw VHDL comment text.
    """
    if not hwir_safe_profile_name(profile):
        return Err("HWIR-E-EMIT-PROFILE: strict VHDL provenance requires a safe profile token")
    Ok(profile)

fn hwir_bridge_preserve_existing_vhdl(module: HwModule) -> HwirVhdlBridgeResult:
    HwirVhdlBridgeResult.fallback(module, "HWIR bridge not selected; preserve existing VHDL compile path")

fn render_hwir_port(port: HwPort) -> text:
    "        " + port.name + " : " + port.direction + " " + strict_vhdl_type(port.bit_width)

fn render_empty_hwir_entity(module: HwModule) -> HwirVhdlBridgeResult:
    val vhdl = "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity " + module.name + " is\nend entity " + module.name + ";\n\narchitecture rtl of " + module.name + " is\nbegin\nend architecture rtl;\n"
    HwirVhdlBridgeResult.emitted(module, vhdl)

fn strict_vhdl_type(width: i32) -> text:
    if width == 1:
        return "std_logic"
    "std_logic_vector(" + (width - 1).to_text() + " downto 0)"

fn strict_vhdl_unsigned(value: text, width: i32) -> text:
    if width == 1:
        return "unsigned'(0 => " + value + ")"
    "unsigned(" + value + ")"

fn strict_vhdl_signed(value: text, width: i32) -> text:
    if width == 1:
        return "signed'(0 => " + value + ")"
    "signed(" + value + ")"

fn strict_vhdl_bit_literal(value: i64, width: i32) -> text:
    """Serialize the low `width` bits without passing through VHDL INTEGER."""
    var bits = ""
    var index = width - 1
    while index >= 0:
        bits = bits + (if ((value >> index) & 1) == 1: "1" else: "0")
        index = index - 1
    "\"" + bits + "\""

fn strict_vhdl_constant(constant: HwConstant) -> Result<text, text>:
    if constant.bit_width == 1:
        if constant.value == 0:
            return Ok("    constant " + constant.name + " : std_logic := '0';\n")
        if constant.value == 1:
            return Ok("    constant " + constant.name + " : std_logic := '1';\n")
        return Err("HWIR-E-CONSTANT-VALUE: one-bit constants must be zero or one")
    Ok("    constant " + constant.name + " : " + strict_vhdl_type(constant.bit_width) +
        " := " + strict_vhdl_bit_literal(constant.value, constant.bit_width) + ";\n")

fn strict_vhdl_bit_vector_constant(constant: HwBitVectorConstant) -> text:
    val literal = if constant.bit_width == 1:
        "'" + constant.canonical_bits + "'"
    else:
        "\"" + constant.canonical_bits + "\""
    "    constant " + constant.name + " : " + strict_vhdl_type(constant.bit_width) +
        " := " + literal + ";\n"

fn shift_index_high(width: i32) -> i32:
    var bits = 0
    var capacity = 1
    while capacity < width:
        capacity = capacity * 2
        bits = bits + 1
    bits - 1

fn strict_vhdl_comb(op: HwCombOp, lhs_width: i32) -> Result<text, text>:
    # The graph validator resolves signals/constants too; emitter-specific
    # width checks use the operation declaration as the serializer contract.
    if op.op == "and" or op.op == "or" or op.op == "xor":
        return Ok("    " + op.result + " <= " + op.lhs + " " + op.op + " " + op.rhs + ";\n")
    if op.op == "add":
        if op.bit_width == 1:
            return Ok("    " + op.result + " <= " + op.lhs + " xor " + op.rhs + ";\n")
        return Ok("    " + op.result + " <= std_logic_vector(" + strict_vhdl_unsigned(op.lhs, op.bit_width) +
            " + " + strict_vhdl_unsigned(op.rhs, op.bit_width) + ");\n")
    if op.op == "sub":
        return Ok("    " + op.result + " <= std_logic_vector(" + strict_vhdl_unsigned(op.lhs, op.bit_width) +
            " - " + strict_vhdl_unsigned(op.rhs, op.bit_width) + ");\n")
    if op.op == "eq" or op.op == "ne":
        val relation = if op.op == "eq": " = " else: " /= "
        return Ok("    " + op.result + " <= '1' when " + op.lhs + relation + op.rhs + " else '0';\n")
    if op.op == "slt" or op.op == "sge":
        val relation = if op.op == "slt": " < " else: " >= "
        return Ok("    " + op.result + " <= '1' when signed(" + op.lhs + ")" + relation + "signed(" + op.rhs + ") else '0';\n")
    if op.op == "ult" or op.op == "uge":
        val relation = if op.op == "ult": " < " else: " >= "
        return Ok("    " + op.result + " <= '1' when unsigned(" + op.lhs + ")" + relation + "unsigned(" + op.rhs + ") else '0';\n")
    if op.op == "shl":
        if op.bit_width == 1:
            return Ok("    " + op.result + " <= " + op.lhs + ";\n")
        return Ok("    " + op.result + " <= (others => '0') when unsigned(" + op.rhs +
            ") >= to_unsigned(" + op.bit_width.to_text() + ", " + op.bit_width.to_text() +
            ") else std_logic_vector(shift_left(" + strict_vhdl_unsigned(op.lhs, op.bit_width) +
            ", to_integer(unsigned(" + op.rhs + "(" + shift_index_high(op.bit_width).to_text() + " downto 0)))));\n")
    if op.op == "shr":
        if op.bit_width == 1:
            return Ok("    " + op.result + " <= " + op.lhs + ";\n")
        return Ok("    " + op.result + " <= (others => '0') when unsigned(" + op.rhs +
            ") >= to_unsigned(" + op.bit_width.to_text() + ", " + op.bit_width.to_text() +
            ") else std_logic_vector(shift_right(" + strict_vhdl_unsigned(op.lhs, op.bit_width) +
            ", to_integer(unsigned(" + op.rhs + "(" + shift_index_high(op.bit_width).to_text() + " downto 0)))));\n")
    if op.op == "sar":
        if op.bit_width == 1: return Ok("    " + op.result + " <= " + op.lhs + ";\n")
        return Ok("    " + op.result + " <= (others => " + op.lhs + "(" +
            (op.bit_width - 1).to_text() + ")) when unsigned(" + op.rhs +
            ") >= to_unsigned(" + op.bit_width.to_text() + ", " + op.bit_width.to_text() +
            ") else std_logic_vector(shift_right(signed(" + op.lhs + "), to_integer(unsigned(" +
            op.rhs + "(" + shift_index_high(op.bit_width).to_text() + " downto 0)))));\n")
    if op.op == "passthrough":
        return Ok("    " + op.result + " <= " + op.lhs + ";\n")
    if op.op == "zext" or op.op == "trunc":
        if op.bit_width == 1:
            return Ok("    " + op.result + " <= " + op.lhs + ";\n")
        return Ok("    " + op.result + " <= std_logic_vector(resize(" + strict_vhdl_unsigned(op.lhs, lhs_width) +
            ", " + op.bit_width.to_text() + "));\n")
    if op.op == "sext":
        if op.bit_width == 1:
            return Ok("    " + op.result + " <= " + op.lhs + ";\n")
        return Ok("    " + op.result + " <= std_logic_vector(resize(" + strict_vhdl_signed(op.lhs, lhs_width) +
            ", " + op.bit_width.to_text() + "));\n")
    Err("HWIR-E-EMIT-OP: unsupported strict combinational operation " + op.op)

pub fn render_strict_hwir_vhdl(module: HwModuleDef) -> HwirStrictVhdlResult:
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return HwirStrictVhdlResult.rejected(diagnostic)
    val profile = strict_vhdl_profile_comment(module.config.profile)
    if profile.is_err():
        return HwirStrictVhdlResult.rejected(profile.err().unwrap())
    var ports = ""
    var port_index = 0
    for port in module.ports:
        ports = ports + render_hwir_port(port)
        if port_index + 1 < module.ports.len():
            ports = ports + ";"
        ports = ports + "\n"
        port_index = port_index + 1
    var declarations = ""
    for constant in module.constants:
        val rendered = strict_vhdl_constant(constant)
        if rendered.is_err():
            return HwirStrictVhdlResult.rejected(rendered.err().unwrap())
        declarations = declarations + rendered.ok().unwrap()
    for signal in module.signals:
        declarations = declarations + "    signal " + signal.name + " : " + strict_vhdl_type(signal.bit_width) + ";\n"
    var body = ""
    for op in module.comb_ops:
        val rendered = strict_vhdl_comb(op, module.value_width(op.lhs))
        if rendered.is_err():
            return HwirStrictVhdlResult.rejected(rendered.err().unwrap())
        body = body + rendered.ok().unwrap()
    for op in module.compare_ops:
        body = body + "    " + op.result + " <= '1' when " + op.lhs + " = " + op.rhs + " else '0';\n"
    for op in module.select_ops:
        body = body + "    " + op.result + " <= " + op.when_true + " when " + op.condition + " = '1' else " + op.when_false + ";\n"
    val vhdl = "-- simple-hwir route=hwir-strict node=" + module.node_id.value + " profile=" + profile.ok().unwrap() + " graph=" + module.structural_sha256() + "\n" +
        "-- simple-hwir port-schema=" + strict_hwir_port_schema_sha256(module.ports) + "\n" +
        "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity " + module.summary.name + " is\n" +
        "    port(\n" + ports + "    );\nend entity " + module.summary.name + ";\n\narchitecture rtl of " + module.summary.name + " is\n" + declarations +
        "begin\n" + body + "end architecture rtl;\n"
    HwirStrictVhdlResult.emitted(module, vhdl, "hwir-strict")

pub fn compile_strict_hwir_module(mir: MirModule, config: CoreConfig) -> HwirStrictVhdlResult:
    """Compile exactly one real MIR hardware function through strict HWIR.

    This public route is deliberately separate from the legacy catalog backend.
    A caller that selects it gets either typed VHDL or one stable HWIR error;
    it never receives a textual-VHDL fallback.
    """
    if mir.functions.len() != 1:
        return HwirStrictVhdlResult.rejected("HWIR-E-MIR-MODULE: strict HWIR compilation requires exactly one MIR function")
    var function_found = false
    var selected: MirFunction? = nil
    for function in mir.functions.values():
        selected = Some(function)
        function_found = true
    if not function_found:
        return HwirStrictVhdlResult.rejected("HWIR-E-MIR-MODULE: strict HWIR compilation requires exactly one MIR function")
    val lowered = lower_strict_mir_function_to_hwir(selected.unwrap(), config)
    if not lowered.is_success():
        return HwirStrictVhdlResult.rejected(lowered.diagnostic)
    if lowered.module == nil:
        return HwirStrictVhdlResult.rejected("HWIR-E-MIR-LOWER: strict lowering returned no module")
    render_strict_hwir_vhdl(lowered.module.unwrap())

fn strict_product_result(module: HwModuleDef, route: text) -> HwirStrictVhdlResult:
    val rendered = render_strict_hwir_vhdl(module)
    if not rendered.is_success():
        return rendered
    HwirStrictVhdlResult.emitted(module, rendered.vhdl.replace("route=hwir-strict", "route=" + route), route)

pub fn compile_strict_zca_control_predecode_product(config: CoreConfig) -> HwirStrictVhdlResult:
    val name = if config.xlen == 32: "riscv_gen2_zca_control_predecode_rv32" else: "riscv_gen2_zca_control_predecode_rv64"
    val module = strict_zca_control_predecode_hwir(name, config)
    if module.is_err():
        return HwirStrictVhdlResult.rejected(module.err().unwrap())
    strict_product_result(module.ok().unwrap(), "hwir-gen2-product")

pub fn compile_strict_zca_migrating_predecode_product(config: CoreConfig) -> HwirStrictVhdlResult:
    val name = if config.xlen == 32: "riscv_gen2_zca_migrating_predecode_rv32" else: "riscv_gen2_zca_migrating_predecode_rv64"
    val module = strict_zca_migrating_predecode_hwir(name, config)
    if module.is_err():
        return HwirStrictVhdlResult.rejected(module.err().unwrap())
    strict_product_result(module.ok().unwrap(), "hwir-gen2-product")

pub fn compile_strict_zca_rv32_cjal_migrating_predecode_product(config: CoreConfig) -> HwirStrictVhdlResult:
    """Emit the RV32-only C.JAL extension of the typed migrating decoder."""
    val module = strict_zca_rv32_cjal_migrating_predecode_hwir(
        "riscv_gen2_zca_rv32_cjal_migrating_predecode", config)
    if module.is_err():
        return HwirStrictVhdlResult.rejected(module.err().unwrap())
    strict_product_result(module.ok().unwrap(), "hwir-gen2-product")

pub fn compile_strict_zca_rv64_addiw_migrating_predecode_product(config: CoreConfig) -> HwirStrictVhdlResult:
    """Emit the RV64-only C.ADDIW extension of the typed migrating decoder."""
    val module = strict_zca_rv64_addiw_migrating_predecode_hwir(
        "riscv_gen2_zca_rv64_addiw_migrating_predecode", config)
    if module.is_err():
        return HwirStrictVhdlResult.rejected(module.err().unwrap())
    strict_product_result(module.ok().unwrap(), "hwir-gen2-product")

fn strict_stateful_ports(ports: [HwPort]) -> text:
    var result = ""
    var index = 0
    for port in ports:
        result = result + render_hwir_port(port)
        if index + 1 < ports.len():
            result = result + ";"
        result = result + "\n"
        index = index + 1
    result

fn strict_seq_zero(width: i32) -> text:
    if width == 1: "'0'" else: "(others=>'0')"

fn strict_seq_reset(register: HwStateRegister) -> text:
    if register.reset_value == 0:
        return strict_seq_zero(register.bit_width)
    if register.bit_width == 1:
        return "'1'"
    "std_logic_vector(to_unsigned(" + register.reset_value.to_text() + ", " + register.bit_width.to_text() + "))"

fn strict_seq_guard(guard: HwSeqGuard) -> Result<text, text>:
    if guard.kind == "high": return Ok(guard.lhs + "='1'")
    if guard.kind == "low": return Ok(guard.lhs + "='0'")
    if guard.kind == "equal": return Ok(guard.lhs + "=" + guard.rhs)
    if guard.kind == "all_ones": return Ok(guard.lhs + "=(others=>'1')")
    Err("HWIR-E-EMIT-SEQUENTIAL-GUARD: unsupported typed sequential guard " + guard.kind)

fn strict_seq_guards(guards: [HwSeqGuard]) -> Result<text, text>:
    if guards.len() == 0:
        return Err("HWIR-E-EMIT-SEQUENTIAL-GUARD: typed sequential condition cannot be empty")
    var result = ""
    var index = 0
    for guard in guards:
        if index > 0: result = result + " and "
        val rendered_guard = strict_seq_guard(guard)?
        result = result + rendered_guard
        index = index + 1
    Ok(result)

fn strict_seq_value(value: HwSeqValue) -> Result<text, text>:
    if value.kind == "zero": return Ok(strict_seq_zero(value.bit_width))
    if value.kind == "copy": return Ok(value.value)
    if value.kind == "invert": return Ok("not " + value.value)
    if value.kind == "increment": return Ok("std_logic_vector(unsigned(" + value.value + ") + 1)")
    Err("HWIR-E-EMIT-SEQUENTIAL-VALUE: unsupported typed sequential value " + value.kind)

fn strict_seq_assignments(assignments: [HwSeqAssignment]) -> Result<text, text>:
    if assignments.len() == 0:
        return Err("HWIR-E-EMIT-SEQUENTIAL-ASSIGNMENT: typed sequential rule cannot be empty")
    var result = ""
    for assignment in assignments:
        val rendered_value = strict_seq_value(assignment.value)?
        result = result + " " + assignment.destination + " <= " + rendered_value + ";"
    Ok(result)

fn strict_seq_plan_declarations(plan: HwSequentialPlan) -> text:
    var result = ""
    for register in plan.registers:
        result = result + " -- simple-hwir node=" + plan.register_node_id(register).value + "\n signal " + register.name + ": " + strict_vhdl_type(register.bit_width) + " := " + strict_seq_reset(register) + ";"
    for pin in plan.decoder_pins:
        if pin.direction == "out":
            result = result + " -- simple-hwir node=" + plan.decoder_pin_node_id(pin).value + "\n signal " + pin.signal_name + ": " + strict_vhdl_type(pin.bit_width) + ";"
    result

fn strict_seq_declarations(module: HwSequentialModuleDef) -> Result<text, text>:
    var result = strict_seq_plan_declarations(module.plan)
    for constant in module.datapath_constants:
        val rendered = strict_vhdl_constant(constant)?
        result = result + rendered
    for constant in module.datapath_bit_vector_constants:
        result = result + strict_vhdl_bit_vector_constant(constant)
    for signal in module.datapath_signals:
        result = result + "    signal " + signal.name + " : " + strict_vhdl_type(signal.bit_width) + ";\n"
    Ok(result)

fn strict_seq_datapath(module: HwSequentialModuleDef) -> Result<text, text>:
    var result = ""
    for op in module.datapath_comb_ops:
        result = result + strict_vhdl_comb(op, module.datapath_width(op.lhs))?
    for op in module.datapath_compare_ops:
        result = result + "    " + op.result + " <= '1' when " + op.lhs + " = " + op.rhs + " else '0';\n"
    for op in module.datapath_select_ops:
        result = result + "    " + op.result + " <= " + op.when_true + " when " + op.condition + " = '1' else " + op.when_false + ";\n"
    for op in module.datapath_bit_extract_ops:
        result = result + "    " + op.result + " <= " + op.source + "(" + op.bit_index.to_text() + ");\n"
    for op in module.datapath_fixed_slice_ops:
        result = result + "    " + op.result + " <= " + op.source + "(" + op.high_bit.to_text() +
            " downto " + op.low_bit.to_text() + ");\n"
    Ok(result)

fn strict_seq_decoder_map(plan: HwSequentialPlan) -> text:
    var result = ""
    var index = 0
    for pin in plan.decoder_pins:
        if index > 0: result = result + ","
        result = result + pin.port_name + "=>" + pin.signal_name
        index = index + 1
    result

fn strict_seq_outputs(plan: HwSequentialPlan) -> Result<text, text>:
    var result = ""
    for output in plan.outputs:
        result = result + " -- simple-hwir node=" + plan.output_node_id(output).value + "\n"
        if output.kind == "direct":
            result = result + " " + output.result + " <= " + output.source + ";"
        elif output.kind == "all":
            val guards = strict_seq_guards(output.guards)?
            result = result + " " + output.result + " <= '1' when " + guards + " else '0';"
        elif output.kind == "guarded":
            val guards = strict_seq_guards(output.guards)?
            result = result + " " + output.result + " <= " + output.source + " when " + guards + " else " + strict_seq_zero(output.bit_width) + ";"
        else:
            return Err("HWIR-E-EMIT-SEQUENTIAL-OUTPUT: unsupported typed sequential output " + output.kind)
    Ok(result)

fn strict_seq_process(plan: HwSequentialPlan) -> Result<text, text>:
    var resets = ""
    for register in plan.registers:
        resets = resets + " " + register.name + " <= " + strict_seq_reset(register) + ";"
    var rules = ""
    for rule in plan.rules:
        val rendered_guards = strict_seq_guards(rule.guards)?
        val rendered_assignments = strict_seq_assignments(rule.assignments)?
        rules = rules + " -- simple-hwir node=" + plan.rule_node_id(rule).value + "\n elsif " + rendered_guards + " then" + rendered_assignments
    Ok(" process(clk) begin if rising_edge(clk) then if rst='1' then" + resets + rules + " end if; end if; end process;\n")

pub fn render_strict_sequential_hwir(module: HwSequentialModuleDef,
    route: text) -> HwirStrictVhdlResult:
    """Serialize a typed sequential module with zero or one typed child.

    Clients construct HWIR only.  Standalone modules leave child identity and
    pins empty; child-bound modules retain the same pin mapping primitives as
    the existing frontend products.
    """
    val diagnostic = module.diagnostic()
    if diagnostic != "": return HwirStrictVhdlResult.rejected(diagnostic)
    if not hwir_safe_profile_name(route):
        return HwirStrictVhdlResult.rejected("HWIR-E-SEQUENTIAL-ROUTE: strict sequential route must be an explicit safe label")
    val profile = strict_vhdl_profile_comment(module.config.profile)
    if profile.is_err(): return HwirStrictVhdlResult.rejected(profile.err().unwrap())
    val outputs = strict_seq_outputs(module.plan)
    if outputs.is_err(): return HwirStrictVhdlResult.rejected(outputs.err().unwrap())
    val process_vhdl = strict_seq_process(module.plan)
    if process_vhdl.is_err(): return HwirStrictVhdlResult.rejected(process_vhdl.err().unwrap())
    val declarations = strict_seq_declarations(module)
    if declarations.is_err(): return HwirStrictVhdlResult.rejected(declarations.err().unwrap())
    val datapath = strict_seq_datapath(module)
    if datapath.is_err(): return HwirStrictVhdlResult.rejected(datapath.err().unwrap())
    var child = ""
    if module.child_entity != "":
        child = " child: entity work." + module.child_entity +
            " port map(" + strict_seq_decoder_map(module.plan) + ");\n"
    val graph_sha256 = module.structural_sha256()
    val vhdl = "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\n" +
        "-- simple-hwir route=" + route + " profile=" + profile.ok().unwrap() +
        " graph=" + graph_sha256 + "\n" +
        "-- simple-hwir port-schema=" + strict_hwir_port_schema_sha256(module.ports) + "\n" +
        "entity " + module.entity_name + " is port(\n" + strict_stateful_ports(module.ports) +
        "    ); end entity;\narchitecture rtl of " + module.entity_name + " is\n" +
        declarations.ok().unwrap() + "\nbegin\n" + child + datapath.ok().unwrap() + outputs.ok().unwrap() +
        "\n" + process_vhdl.ok().unwrap() + "end architecture rtl;\n"
    HwirStrictVhdlResult(success: true, vhdl: vhdl, diagnostic: "", route: route,
        module_node_id: module.node_id.value, config_xlen: module.config.xlen,
        config_profile: module.config.profile, hwir_graph_sha256: graph_sha256)

fn strict_stateful_sequential_module(node_id: HwNodeId, entity_name: text,
    config: CoreConfig, origins: [HwOrigin], ports: [HwPort],
    plan: HwSequentialPlan, child_entity: text,
    child_graph_sha256: text) -> HwSequentialModuleDef:
    HwSequentialModuleDef(
        node_id: node_id, entity_name: entity_name, config: config,
        origins: origins, ports: ports, datapath_signals: [],
        datapath_constants: [], datapath_bit_vector_constants: [],
        datapath_comb_ops: [], datapath_compare_ops: [], datapath_select_ops: [],
        datapath_bit_extract_ops: [], datapath_fixed_slice_ops: [], plan: plan,
        child_entity: child_entity, child_graph_sha256: child_graph_sha256)

pub fn strict_stateful_graph_sha(node_id: text, config: CoreConfig,
    origins: [HwOrigin], ports: [HwPort], decoder_entity: text,
    plan: HwSequentialPlan, decoder_graph_sha: text) -> text:
    """Compatibility entrypoint backed by the canonical sequential graph.

    Drivers and provenance readers use this helper to recompute a product hash
    without rendering VHDL.  Keeping the public name avoids a flag-day API
    change while eliminating the former private stateful hash schema.
    """
    val module_suffix = ":module"
    val entity_name = if node_id.ends_with(module_suffix):
        node_id[0:node_id.len() - module_suffix.len()]
    else:
        node_id
    val module = strict_stateful_sequential_module(HwNodeId(value: node_id),
        entity_name, config, origins, ports, plan, decoder_entity,
        decoder_graph_sha)
    module.structural_sha256()

fn strict_stateful_result(frontend: HwParcelFrontendDef, route: text) -> HwirStrictVhdlResult:
    val error = frontend.shape_diagnostic()
    if error != "":
        return HwirStrictVhdlResult.rejected(error)
    val decoder = if frontend.decoder_entity == "riscv_gen2_zca_rv32_cjal_migrating_predecode":
        compile_strict_zca_rv32_cjal_migrating_predecode_product(frontend.config)
    elif frontend.decoder_entity == "riscv_gen2_zca_rv64_addiw_migrating_predecode":
        compile_strict_zca_rv64_addiw_migrating_predecode_product(frontend.config)
    else:
        compile_strict_zca_migrating_predecode_product(frontend.config)
    if not decoder.is_success():
        return decoder
    val expected_decoder = strict_parcel_frontend_decoder_entity(frontend.config)
    if expected_decoder.is_err() or frontend.decoder_entity != expected_decoder.ok().unwrap():
        return HwirStrictVhdlResult.rejected("HWIR-E-SEQUENTIAL-DECODER: stateful frontend decoder does not match its selected concrete product")
    if decoder.module_node_id != HwNodeId.module_root(frontend.decoder_entity).value:
        return HwirStrictVhdlResult.rejected("HWIR-E-SEQUENTIAL-DECODER: emitted decoder node identity does not match the bound decoder entity")
    val module = strict_stateful_sequential_module(frontend.node_id,
        frontend.summary_name, frontend.config, frontend.origins,
        frontend.frontend_contract.ports(), frontend.sequential,
        frontend.decoder_entity, decoder.hwir_graph_sha256)
    val rendered = render_strict_sequential_hwir(module, route)
    if not rendered.is_success(): return rendered
    HwirStrictVhdlResult(success: true, vhdl: decoder.vhdl + "\n" + rendered.vhdl,
        diagnostic: "", route: rendered.route, module_node_id: rendered.module_node_id,
        config_xlen: rendered.config_xlen, config_profile: rendered.config_profile,
        hwir_graph_sha256: rendered.hwir_graph_sha256)

fn strict_trap_stateful_result(frontend: HwTrapParcelFrontendDef) -> HwirStrictVhdlResult:
    val error = frontend.shape_diagnostic()
    if error != "":
        return HwirStrictVhdlResult.rejected(error)
    val specialized = (frontend.config.profile == "riscv-gen2-rv32-zca-cjal-critical" or
        frontend.config.profile == "riscv-gen2-rv64-zca-addiw-critical")
    val decoder_name = if frontend.config.profile == "riscv-gen2-rv32-zca-cjal-critical":
        "riscv_gen2_zca_rv32_cjal_trap_migrating_predecode"
    elif frontend.config.profile == "riscv-gen2-rv64-zca-addiw-critical":
        "riscv_gen2_zca_rv64_addiw_trap_migrating_predecode"
    elif frontend.config.xlen == 32:
        "riscv_gen2_zca_trap_migrating_predecode_rv32"
    else:
        "riscv_gen2_zca_trap_migrating_predecode_rv64"
    val decoder_module = if specialized:
        strict_zca_target_trap_migrating_predecode_hwir(decoder_name, frontend.config)
    else:
        strict_zca_trap_migrating_predecode_hwir(decoder_name, frontend.config)
    if decoder_module.is_err():
        return HwirStrictVhdlResult.rejected(decoder_module.err().unwrap())
    val decoder = strict_product_result(decoder_module.ok().unwrap(), "hwir-gen2-product")
    if not decoder.is_success():
        return decoder
    if frontend.decoder_entity != decoder_name:
        return HwirStrictVhdlResult.rejected("HWIR-E-SEQUENTIAL-DECODER: trap frontend decoder does not match its selected concrete product")
    if decoder.module_node_id != HwNodeId.module_root(frontend.decoder_entity).value:
        return HwirStrictVhdlResult.rejected("HWIR-E-SEQUENTIAL-DECODER: emitted trap decoder node identity does not match the bound decoder entity")
    val module = strict_stateful_sequential_module(frontend.node_id,
        frontend.summary_name, frontend.config, frontend.origins,
        frontend.frontend_contract.ports(), frontend.sequential,
        frontend.decoder_entity, decoder.hwir_graph_sha256)
    val rendered = render_strict_sequential_hwir(module, "hwir-gen2-trap-stateful-product-v3")
    if not rendered.is_success(): return rendered
    HwirStrictVhdlResult(success: true, vhdl: decoder.vhdl + "\n" + rendered.vhdl,
        diagnostic: "", route: rendered.route, module_node_id: rendered.module_node_id,
        config_xlen: rendered.config_xlen, config_profile: rendered.config_profile,
        hwir_graph_sha256: rendered.hwir_graph_sha256)

pub fn compile_strict_zca_single_outstanding_frontend_product(config: CoreConfig) -> HwirStrictVhdlResult:
    val name = if config.profile == "riscv-gen2-rv32-zca-cjal-critical":
        "riscv_gen2_zca_rv32_cjal_single_outstanding_frontend"
    elif config.profile == "riscv-gen2-rv64-zca-addiw-critical":
        "riscv_gen2_zca_rv64_addiw_single_outstanding_frontend"
    elif config.xlen == 32: "riscv_gen2_zca_single_outstanding_frontend_rv32"
    else: "riscv_gen2_zca_single_outstanding_frontend_rv64"
    val frontend = strict_zca_single_outstanding_frontend_hwir(name, config)
    if frontend.is_err():
        return HwirStrictVhdlResult.rejected(frontend.err().unwrap())
    strict_stateful_result(frontend.ok().unwrap(), "hwir-gen2-stateful-product-v2")

pub fn compile_strict_zca_trap_single_outstanding_frontend_product(config: CoreConfig) -> HwirStrictVhdlResult:
    val name = if config.profile == "riscv-gen2-rv32-zca-cjal-critical":
        "riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend"
    elif config.profile == "riscv-gen2-rv64-zca-addiw-critical":
        "riscv_gen2_zca_rv64_addiw_trap_single_outstanding_frontend"
    elif config.xlen == 32:
        "riscv_gen2_zca_trap_single_outstanding_frontend_rv32"
    else:
        "riscv_gen2_zca_trap_single_outstanding_frontend_rv64"
    val frontend = strict_zca_trap_single_outstanding_frontend_hwir(name, config)
    if frontend.is_err():
        return HwirStrictVhdlResult.rejected(frontend.err().unwrap())
    strict_trap_stateful_result(frontend.ok().unwrap())

fn strict_hwir_sha256_text(digest: text) -> bool:
    if digest.len() != 64:
        return false
    val hex = "0123456789abcdef"
    var index = 0
    while index < digest.len():
        if not hex.contains(digest[index:index + 1]):
            return false
        index = index + 1
    true

fn strict_retirement_child_diagnostic(role: text, child: HwirStrictVhdlResult,
    entity: text, route: text, config: CoreConfig, ports: [HwPort]) -> text:
    """Admit only a child result whose typed metadata and VHDL markers agree.

    This validates serialization provenance, not architectural effects.  In
    particular, a receipt-producer child must still be supplied by a later
    architectural owner; this renderer never creates one.
    """
    if not child.is_success():
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-RESULT: " + role + " child must be a successful strict HWIR result"
    if child.route != route:
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-ROUTE: " + role + " child route does not match the closed composition schema"
    if child.config_xlen != config.xlen or child.config_profile != config.profile:
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-CONFIG: " + role + " child configuration does not match the closed composition"
    if child.module_node_id != entity + ":module":
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-NODE: " + role + " child node does not match the closed component entity"
    if not strict_hwir_sha256_text(child.hwir_graph_sha256) or
        not child.vhdl.contains("graph=" + child.hwir_graph_sha256):
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-DIGEST: " + role + " child graph digest does not match its serialized VHDL provenance"
    val schema = strict_hwir_port_schema_sha256(ports)
    if not child.vhdl.contains("port-schema=" + schema):
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-SCHEMA: " + role + " child port schema does not match the closed component contract"
    for port in ports:
        if not child.vhdl.contains(port.name + " : " + port.direction + " " + strict_vhdl_type(port.bit_width)):
            return "HWIR-E-RETIRE-COMPOSITION-CHILD-SCHEMA: " + role + " child VHDL port text does not match the closed component contract"
    if not child.vhdl.contains("route=" + route) or not child.vhdl.contains("profile=" + config.profile) or
        not child.vhdl.contains("entity " + entity + " is"):
        return "HWIR-E-RETIRE-COMPOSITION-CHILD-TEXT: " + role + " child VHDL does not carry its admitted strict component identity"
    ""

fn strict_retirement_component_entity(composition: HwParcelRetirementComposition) -> Result<text, text>:
    val suffix = ":module"
    if not composition.node_id.value.ends_with(suffix):
        return Err("HWIR-E-RETIRE-COMPOSITION-ID: retirement composition node must be a module root")
    val entity = composition.node_id.value[0:composition.node_id.value.len() - suffix.len()]
    if entity == "":
        return Err("HWIR-E-RETIRE-COMPOSITION-ID: retirement composition requires a concrete VHDL entity name")
    Ok(entity)

fn strict_retirement_binding_signal(binding: HwRetireCompositionBinding) -> text:
    "retire_composition_" + binding.kind + "_" + binding.source_port

fn strict_retirement_public_ports(composition: HwParcelRetirementComposition) -> [HwPort]:
    var ports: [HwPort] = []
    for port in composition.frontend.ports():
        var internal = false
        for binding in composition.bindings:
            if binding.kind == "frontend_to_producer" and binding.source_port == port.name:
                internal = true
            if binding.kind == "producer_to_frontend" and binding.destination_port == port.name:
                internal = true
        if not internal:
            ports.push(port)
    ports

fn strict_retirement_frontend_port_map(composition: HwParcelRetirementComposition, port: HwPort) -> text:
    for binding in composition.bindings:
        if binding.destination_owner == "frontend" and binding.destination_port == port.name:
            if binding.kind == "shared_input":
                return binding.source_port
            return strict_retirement_binding_signal(binding)
        if binding.source_owner == "frontend" and binding.source_port == port.name:
            return strict_retirement_binding_signal(binding)
    port.name

fn strict_retirement_producer_port_map(composition: HwParcelRetirementComposition, port: HwPort) -> text:
    for binding in composition.bindings:
        if binding.destination_owner == "producer" and binding.destination_port == port.name:
            if binding.kind == "shared_input":
                return binding.source_port
            return strict_retirement_binding_signal(binding)
        if binding.source_owner == "producer" and binding.source_port == port.name:
            return strict_retirement_binding_signal(binding)
    port.name

fn strict_retirement_child_map(composition: HwParcelRetirementComposition, frontend: bool) -> text:
    val ports = if frontend: composition.frontend.ports() else: composition.producer.ports()
    var result = ""
    var index = 0
    for port in ports:
        if index > 0:
            result = result + ","
        val signal = if frontend:
            strict_retirement_frontend_port_map(composition, port)
        else:
            strict_retirement_producer_port_map(composition, port)
        result = result + port.name + "=>" + signal
        index = index + 1
    result

fn strict_retirement_composition_graph_sha(composition: HwParcelRetirementComposition,
    frontend: HwirStrictVhdlResult, producer: HwirStrictVhdlResult) -> text:
    var fields: [text] = ["simple-hwir-retirement-composition/v1", composition.node_id.value,
        composition.config.xlen.to_text(), composition.config.physical_address_bits.to_text(),
        composition.config.register_count.to_text(), composition.config.profile,
        composition.config.isa_profile, composition.config.compressed_decode_profile,
        "frontend", frontend.route, frontend.module_node_id, frontend.config_xlen.to_text(),
        frontend.config_profile, frontend.hwir_graph_sha256,
        strict_hwir_port_schema_sha256(composition.frontend.ports()),
        "producer", producer.route, producer.module_node_id, producer.config_xlen.to_text(),
        producer.config_profile, producer.hwir_graph_sha256,
        strict_hwir_port_schema_sha256(composition.producer.ports())]
    for binding in composition.bindings:
        fields.push("binding")
        fields.push(binding.kind)
        fields.push(binding.source_owner)
        fields.push(binding.source_port)
        fields.push(binding.destination_owner)
        fields.push(binding.destination_port)
        fields.push(binding.bit_width.to_text())
    sha256_text(hwir_hash_fields(fields))

pub fn render_strict_retirement_composition_vhdl(composition: HwParcelRetirementComposition,
    frontend: HwirStrictVhdlResult, producer: HwirStrictVhdlResult) -> HwirStrictVhdlResult:
    """Fail closed until a typed architectural producer has a sealed emission path.

    The receipt contract is a real elaboration boundary, but an arbitrary
    `HwirStrictVhdlResult` is mutable metadata plus text.  Concatenating that
    text would make a forged child look like a typed hardware implementation.
    A later sequential-HWIR producer must supply an opaque verified emission
    receipt before this composition can become an emitter or a product route.
    """
    HwirStrictVhdlResult.rejected(
        "HWIR-E-RETIRE-COMPOSITION-UNSUPPORTED: closed retirement composition requires a typed architectural producer emission receipt")
