# Dedicated strict VHDL renderer for the fully-closed direct scalar runtime v5.
#
# V5 owns a mixed graph: the control child is a nested combinational
# composition, while pending/LSU/FENCE/skids/fault owner are sequential.  This
# renderer deliberately consumes only the canonical direct construction.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwPort, hwir_hash_fields, hwir_vhdl_identifier}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v5.{
    HwScalarRuntimePipelineV5Direct, HwScalarRuntimePipelineV5Binding,
    strict_riscv_scalar_runtime_pipeline_v5_direct}
use compiler.backend.backend.hwir_to_vhdl.{HwirStrictVhdlResult,
    render_strict_hwir_vhdl, render_strict_sequential_hwir}
use compiler.backend.backend.combinational_composition_to_vhdl.{
    render_strict_comb_composition_vhdl}

fn pipeline_v5_route() -> text: "hwir-gen2-scalar-runtime-pipeline-v5-direct"

fn pipeline_v5_rejected(diagnostic: text) -> HwirStrictVhdlResult:
    HwirStrictVhdlResult(success: false, vhdl: "", diagnostic: diagnostic,
        route: pipeline_v5_route(), module_node_id: "", config_xlen: 0,
        config_profile: "", hwir_graph_sha256: "")

fn pipeline_v5_type(width: i32) -> text:
    if width == 1: return "std_logic"
    "std_logic_vector(" + (width - 1).to_text() + " downto 0)"

# The length tags make owner/port concatenation injective even where names
# contain underscores or a future owner has a shared prefix.
fn pipeline_v5_wire(binding: HwScalarRuntimePipelineV5Binding) -> text:
    "wire_o" + binding.destination_owner.len().to_text() + "_" +
        binding.destination_owner + "_p" + binding.destination_port.len().to_text() +
        "_" + binding.destination_port

fn pipeline_v5_source(owner: text, port: text) -> text:
    "source_o" + owner.len().to_text() + "_" + owner + "_p" +
        port.len().to_text() + "_" + port

fn pipeline_v5_input_actual(pipeline: HwScalarRuntimePipelineV5Direct,
    owner: text, port: HwPort) -> text:
    for binding in pipeline.bindings:
        if binding.destination_owner == owner and binding.destination_port == port.name:
            return pipeline_v5_wire(binding)
    port.name

fn pipeline_v5_output_actual(pipeline: HwScalarRuntimePipelineV5Direct,
    owner: text, port: HwPort) -> text:
    for binding in pipeline.bindings:
        if binding.source_owner == owner and binding.source_port == port.name:
            return pipeline_v5_source(owner, port.name)
    "open"

fn pipeline_v5_child_map(pipeline: HwScalarRuntimePipelineV5Direct,
    owner: text, ports: [HwPort]) -> text:
    var result = ""; var index = 0
    for port in ports:
        if index > 0: result = result + ","
        result = result + port.name + "=>" +
            (if port.direction == "in": pipeline_v5_input_actual(pipeline, owner, port)
            else: pipeline_v5_output_actual(pipeline, owner, port))
        index = index + 1
    result

fn pipeline_v5_ports(ports: [HwPort]) -> text:
    var result = ""; var index = 0
    for port in ports:
        result = result + "        " + port.name + " : " + port.direction + " " +
            pipeline_v5_type(port.bit_width)
        if index + 1 < ports.len(): result = result + ";"
        result = result + "\n"; index = index + 1
    result

fn pipeline_v5_signals(pipeline: HwScalarRuntimePipelineV5Direct) -> text:
    var result = ""; var source_names: [text] = []
    for binding in pipeline.bindings:
        if binding.destination_owner != "composition":
            result = result + "    signal " + pipeline_v5_wire(binding) + " : " +
                pipeline_v5_type(binding.bit_width) + ";\n"
        if binding.source_owner != "composition":
            val source = pipeline_v5_source(binding.source_owner, binding.source_port)
            if not source_names.contains(source.lower()):
                result = result + "    signal " + source + " : " +
                    pipeline_v5_type(binding.bit_width) + ";\n"
                source_names.push(source.lower())
    result

fn pipeline_v5_assignments(pipeline: HwScalarRuntimePipelineV5Direct) -> text:
    var result = ""
    for binding in pipeline.bindings:
        val destination = if binding.destination_owner == "composition": binding.destination_port
            else: pipeline_v5_wire(binding)
        val source = if binding.source_owner == "composition": binding.source_port
            else: pipeline_v5_source(binding.source_owner, binding.source_port)
        result = result + "    " + destination + " <= " + source + ";\n"
    result

pub fn scalar_runtime_pipeline_v5_driver_closure_diagnostic(
    pipeline: HwScalarRuntimePipelineV5Direct) -> text:
    val diagnostic = pipeline.diagnostic()
    if diagnostic != "": return diagnostic
    var destinations: [text] = []; var emitted: [text] = []
    var source_names: [text] = []; var source_endpoints: [text] = []
    var source_widths: [text] = []
    for port in pipeline.top_ports:
        if emitted.contains(port.name.lower()):
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
        emitted.push(port.name.lower())
    for binding in pipeline.bindings:
        val destination = if binding.destination_owner == "composition": binding.destination_port
            else: pipeline_v5_wire(binding)
        if destinations.contains(destination.lower()):
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-DRIVER: every destination requires exactly one driver"
        destinations.push(destination.lower())
        if binding.destination_owner != "composition":
            if emitted.contains(destination.lower()):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
            emitted.push(destination.lower())
        if binding.source_owner != "composition":
            val source = pipeline_v5_source(binding.source_owner, binding.source_port).lower()
            val endpoint = binding.source_owner + "|" + binding.source_port
            if source_names.contains(source):
                var index = 0
                while source_names[index] != source: index = index + 1
                if source_endpoints[index] != endpoint:
                    return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-NAME: distinct source endpoints require case-insensitive unique emitted names"
            elif emitted.contains(source):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-NAME: top ports and internal signals require case-insensitive unique emitted names"
            else:
                source_names.push(source); source_endpoints.push(endpoint); emitted.push(source)
            val width = source + "|" + binding.bit_width.to_text()
            for known in source_widths:
                if known.starts_with(source + "|") and known != width:
                    return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-SOURCE: fanout requires one width-consistent source signal"
            if not source_widths.contains(width): source_widths.push(width)
    for port in pipeline.top_ports:
        if port.direction == "out" and not destinations.contains(port.name.lower()):
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-TOP: every top output requires one driver"
    ""

# The top-level renderer concatenates VHDL for every direct child.  VHDL entity
# names are case-insensitive, so a name is only reusable when it denotes the
# exact same HWIR graph.  Keep this check at the aggregate boundary rather than
# relying on individual leaf renderers, which cannot see their siblings.
pub fn scalar_runtime_pipeline_v5_aggregate_child_entity_diagnostic(
    entity_names: [text], graph_hashes: [text]) -> text:
    if entity_names.len() != graph_hashes.len():
        return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-ENTITY-COLLISION: aggregate child identity records require matched names and graphs"
    var names: [text] = []; var graphs: [text] = []
    var index = 0
    while index < entity_names.len():
        val name = entity_names[index].lower()
        val graph = graph_hashes[index]
        if name == "" or graph == "":
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-ENTITY-COLLISION: aggregate child identity requires a name and graph"
        if names.contains(name):
            var prior = 0
            while names[prior] != name: prior = prior + 1
            if graphs[prior] != graph:
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-ENTITY-COLLISION: one case-insensitive child entity name requires one exact graph"
        else:
            names.push(name); graphs.push(graph)
        index = index + 1
    ""

pub fn scalar_runtime_pipeline_v5_route_receipt(
    pipeline: HwScalarRuntimePipelineV5Direct) -> text:
    sha256_text(hwir_hash_fields(["hwir-gen2-scalar-runtime-pipeline-v5-direct-receipt",
        pipeline.structural_sha256(), pipeline.binding_list_sha256(),
        pipeline.decoder.structural_sha256(), pipeline.uop_skid.structural_sha256(),
        pipeline.alu.structural_sha256(), pipeline.control.structural_sha256(),
        pipeline.system.structural_sha256(), pipeline.illegal_provider.structural_sha256(),
        pipeline.router.structural_sha256(), pipeline.immediate_adapter.structural_sha256(),
        pipeline.pending.structural_sha256(), pipeline.projection.structural_sha256(),
        pipeline.lsu.structural_sha256(), pipeline.fence.structural_sha256(),
        pipeline.selector.structural_sha256(), pipeline.completion_merge.structural_sha256(),
        pipeline.completion_skid.structural_sha256(), pipeline.global_fault_gate.structural_sha256(),
        pipeline.fault_owner.structural_sha256(), pipeline.defaults.structural_sha256(),
        pipeline.zero_defaults.structural_sha256()]))

fn render_pipeline_v5(pipeline: HwScalarRuntimePipelineV5Direct) -> HwirStrictVhdlResult:
    val closure = scalar_runtime_pipeline_v5_driver_closure_diagnostic(pipeline)
    if closure != "": return pipeline_v5_rejected(closure)
    if not hwir_vhdl_identifier(pipeline.module_name):
        return pipeline_v5_rejected("HWIR-E-RISCV-RUNTIME-PIPELINE-V5-VHDL-ENTITY: pipeline requires a legal VHDL entity name")
    val decoder = render_strict_hwir_vhdl(pipeline.decoder)
    val uop = render_strict_sequential_hwir(pipeline.uop_skid, "hwir-gen2-scalar-decoded-uop-skid-v1")
    val alu = render_strict_hwir_vhdl(pipeline.alu)
    val control = render_strict_comb_composition_vhdl(pipeline.control)
    val system = render_strict_hwir_vhdl(pipeline.system)
    val illegal = render_strict_hwir_vhdl(pipeline.illegal_provider)
    val router = render_strict_hwir_vhdl(pipeline.router)
    val adapter = render_strict_hwir_vhdl(pipeline.immediate_adapter)
    val pending = render_strict_sequential_hwir(pipeline.pending, "hwir-gen2-scalar-pending-provider-owner-v1")
    val projection = render_strict_hwir_vhdl(pipeline.projection)
    val lsu = render_strict_sequential_hwir(pipeline.lsu, "hwir-gen2-scalar-runtime-lsu-owner-v1")
    val fence = render_strict_sequential_hwir(pipeline.fence, "hwir-gen2-scalar-runtime-fence-provider-v1")
    val selector = render_strict_hwir_vhdl(pipeline.selector)
    val merge = render_strict_hwir_vhdl(pipeline.completion_merge)
    val skid = render_strict_sequential_hwir(pipeline.completion_skid, "hwir-gen2-scalar-completion-skid-v1")
    val gate = render_strict_hwir_vhdl(pipeline.global_fault_gate)
    val fault = render_strict_sequential_hwir(pipeline.fault_owner, "hwir-gen2-scalar-runtime-fault-owner-v1")
    val defaults = render_strict_hwir_vhdl(pipeline.defaults)
    val zero_defaults = render_strict_hwir_vhdl(pipeline.zero_defaults)
    for child in [decoder, uop, alu, control, system, illegal, router, adapter, pending,
            projection, lsu, fence, selector, merge, skid, gate, fault, defaults, zero_defaults]:
        if not child.is_success(): return pipeline_v5_rejected(child.diagnostic)
    val entity_collision = scalar_runtime_pipeline_v5_aggregate_child_entity_diagnostic(
        [pipeline.decoder.summary.name, pipeline.uop_skid.entity_name,
            pipeline.alu.summary.name, pipeline.control.entity_name,
            pipeline.system.summary.name, pipeline.illegal_provider.summary.name,
            pipeline.router.summary.name, pipeline.immediate_adapter.summary.name,
            pipeline.pending.entity_name, pipeline.projection.summary.name,
            pipeline.lsu.entity_name, pipeline.fence.entity_name,
            pipeline.selector.summary.name, pipeline.completion_merge.summary.name,
            pipeline.completion_skid.entity_name, pipeline.global_fault_gate.summary.name,
            pipeline.fault_owner.entity_name, pipeline.defaults.summary.name,
            pipeline.zero_defaults.summary.name],
        [decoder.hwir_graph_sha256, uop.hwir_graph_sha256, alu.hwir_graph_sha256,
            control.hwir_graph_sha256, system.hwir_graph_sha256, illegal.hwir_graph_sha256,
            router.hwir_graph_sha256, adapter.hwir_graph_sha256, pending.hwir_graph_sha256,
            projection.hwir_graph_sha256, lsu.hwir_graph_sha256, fence.hwir_graph_sha256,
            selector.hwir_graph_sha256, merge.hwir_graph_sha256, skid.hwir_graph_sha256,
            gate.hwir_graph_sha256, fault.hwir_graph_sha256, defaults.hwir_graph_sha256,
            zero_defaults.hwir_graph_sha256])
    if entity_collision != "": return pipeline_v5_rejected(entity_collision)
    val graph = pipeline.structural_sha256()
    val receipt = scalar_runtime_pipeline_v5_route_receipt(pipeline)
    val top = "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\n" +
        "-- simple-hwir route=" + pipeline_v5_route() + " graph=" + graph + "\n" +
        "-- simple-hwir v5-route-receipt=" + receipt + "\n" +
        "-- simple-hwir child-decoder=" + decoder.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-uop-skid=" + uop.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-alu=" + alu.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-control=" + control.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-system=" + system.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-illegal-provider=" + illegal.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-router=" + router.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-immediate-adapter=" + adapter.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-pending=" + pending.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-projection=" + projection.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-lsu=" + lsu.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-fence=" + fence.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-selector=" + selector.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-completion-merge=" + merge.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-completion-skid=" + skid.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-global-fault-gate=" + gate.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-fault-owner=" + fault.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-defaults=" + defaults.hwir_graph_sha256 + "\n" +
        "-- simple-hwir child-zero-defaults=" + zero_defaults.hwir_graph_sha256 + "\n" +
        "entity " + pipeline.module_name + " is port(\n" + pipeline_v5_ports(pipeline.top_ports) +
        "    ); end entity;\narchitecture rtl of " + pipeline.module_name + " is\n" +
        pipeline_v5_signals(pipeline) + "begin\n" + pipeline_v5_assignments(pipeline)
    val children = [("decoder", pipeline.decoder.summary.name, pipeline.decoder.ports),
        ("uop_skid", pipeline.uop_skid.entity_name, pipeline.uop_skid.ports),
        ("alu", pipeline.alu.summary.name, pipeline.alu.ports),
        ("control", pipeline.control.entity_name, pipeline.control.top_ports),
        ("system", pipeline.system.summary.name, pipeline.system.ports),
        ("illegal_provider", pipeline.illegal_provider.summary.name, pipeline.illegal_provider.ports),
        ("router", pipeline.router.summary.name, pipeline.router.ports),
        ("immediate_adapter", pipeline.immediate_adapter.summary.name, pipeline.immediate_adapter.ports),
        ("pending", pipeline.pending.entity_name, pipeline.pending.ports),
        ("projection", pipeline.projection.summary.name, pipeline.projection.ports),
        ("lsu", pipeline.lsu.entity_name, pipeline.lsu.ports), ("fence", pipeline.fence.entity_name, pipeline.fence.ports),
        ("selector", pipeline.selector.summary.name, pipeline.selector.ports),
        ("completion_merge", pipeline.completion_merge.summary.name, pipeline.completion_merge.ports),
        ("completion_skid", pipeline.completion_skid.entity_name, pipeline.completion_skid.ports),
        ("global_fault_gate", pipeline.global_fault_gate.summary.name, pipeline.global_fault_gate.ports),
        ("fault_owner", pipeline.fault_owner.entity_name, pipeline.fault_owner.ports),
        ("defaults", pipeline.defaults.summary.name, pipeline.defaults.ports),
        ("zero_defaults", pipeline.zero_defaults.summary.name, pipeline.zero_defaults.ports)]
    var instances = ""
    for child in children:
        instances = instances + "    " + child[0] + ": entity work." + child[1] + " port map(" +
            pipeline_v5_child_map(pipeline, child[0], child[2]) + ");\n"
    HwirStrictVhdlResult(success: true,
        vhdl: decoder.vhdl + "\n" + uop.vhdl + "\n" + alu.vhdl + "\n" + control.vhdl + "\n" +
            system.vhdl + "\n" + illegal.vhdl + "\n" + router.vhdl + "\n" + adapter.vhdl + "\n" +
            pending.vhdl + "\n" + projection.vhdl + "\n" + lsu.vhdl + "\n" + fence.vhdl + "\n" +
            selector.vhdl + "\n" + merge.vhdl + "\n" + skid.vhdl + "\n" + gate.vhdl + "\n" +
            fault.vhdl + "\n" + defaults.vhdl + "\n" + zero_defaults.vhdl + "\n" + top + instances + "end architecture rtl;\n",
        diagnostic: "", route: pipeline_v5_route(), module_node_id: pipeline.node_id.value,
        config_xlen: pipeline.config.xlen, config_profile: pipeline.config.profile,
        hwir_graph_sha256: graph)

pub fn compile_strict_riscv_scalar_runtime_pipeline_v5(module_name: text,
    config: CoreConfig, bus: LsuConfig) -> HwirStrictVhdlResult:
    val rebuilt = strict_riscv_scalar_runtime_pipeline_v5_direct(module_name, config, bus)
    if rebuilt.is_err(): return pipeline_v5_rejected(rebuilt.err().unwrap())
    render_pipeline_v5(rebuilt.ok().unwrap())
