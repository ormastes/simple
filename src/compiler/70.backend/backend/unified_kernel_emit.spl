# Unified multi-backend kernel emission (plan W3 headline exit criterion)
#
# doc/03_plan/language/gpu_fpga/sycl_parity_unified_kernel_plan_2026-06-13.md
# states the W3 headline as: the SAME `vector_add` kernel emits PTX, OpenCL C
# and synthesizable VHDL. This module is that single entry point.
#
# There is exactly ONE MirFunction here. It is built once, wrapped in one
# MirModule, and handed unchanged to the three real sibling backends:
#
#   PTX    -> compiler.backend.cuda_backend.CudaBackend.compile(...).ptx
#   OpenCL -> compiler.backend.opencl_backend.OpenClBackend.compile_module_to_opencl_source(...)
#   VHDL   -> compiler.backend.vhdl.vhdl_kernel_entity.emit_vhdl_kernel_entity(...)
#
# Nothing here templates, patches or fabricates backend text: every leg is the
# backend's own output, and a leg whose backend returns an error is left EMPTY
# with the backend's diagnostic recorded, never filled with a placeholder.
#
# The shared function carries `gpu_target: "auto"` with
# `gpu_backend_order: "cuda,opencl,vhdl"` so all three backends accept the one
# function (see gpu_backend_accepts_kernel in gpu_backend_metadata.spl) — no
# per-target clone is made.

use compiler.mir.mir_data.{MirFunction, MirModule, MirSignature, BlockId, LocalId}
use compiler.mir.mir_instructions.{MirBlock, MirInst, MirInstKind, MirTerminator, MirOperand, MirBinOp}
use compiler.mir.mir_types.{MirLocal, MirType, MirTypeKind, LocalKind}
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.backend.cuda_backend.{CudaBackend}
use compiler.backend.opencl_backend.{OpenClBackend}
use compiler.backend.vhdl.vhdl_kernel_entity.{emit_vhdl_kernel_entity, vhdl_kernel_accepts}

val UNIFIED_KERNEL_BACKEND_ORDER: text = "cuda,opencl,vhdl"

struct UnifiedKernelEmission:
    """
    The three backend artifacts produced from one shared MIR kernel.

    An empty leg means that backend refused the kernel; its `*_diagnostic`
    carries the backend's own message. Empty is never padded.
    """
    kernel_name: text
    mir_available: bool
    ptx: text
    opencl: text
    vhdl: text
    ptx_diagnostic: text
    opencl_diagnostic: text
    vhdl_diagnostic: text

fn unified_kernel_u32() -> MirType:
    MirType(kind: MirTypeKind.U32)

fn unified_kernel_global_u32_ptr() -> MirType:
    MirType.ptr(unified_kernel_u32(), true)

fn unified_kernel_arg_local(id: i64, index: i64, name: text, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: Some(name), type_: type_, kind: LocalKind.Arg(index), is_ghost: false)

fn unified_kernel_temp_local(id: i64, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: LocalKind.Temp, is_ghost: false)

fn unified_vector_add_block() -> MirBlock:
    """
    The vector_add body: c[gid] = a[gid] + b[gid], with gid from the 1D global
    thread id (dim 0 — the only dimension the v1 VHDL kernel lane accepts).
    """
    MirBlock(
        id: BlockId.entry(),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.GpuGlobalId(LocalId(id: 3), 0), span: nil),
            MirInst(kind: MirInstKind.GetElementPtr(LocalId(id: 4), MirOperand.copy(LocalId(id: 0)), [MirOperand.copy(LocalId(id: 3))]), span: nil),
            MirInst(kind: MirInstKind.GetElementPtr(LocalId(id: 5), MirOperand.copy(LocalId(id: 1)), [MirOperand.copy(LocalId(id: 3))]), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 7), MirOperand.copy(LocalId(id: 4))), span: nil),
            MirInst(kind: MirInstKind.Load(LocalId(id: 8), MirOperand.copy(LocalId(id: 5))), span: nil),
            MirInst(kind: MirInstKind.BinOp(LocalId(id: 9), MirBinOp.Add, MirOperand.copy(LocalId(id: 7)), MirOperand.copy(LocalId(id: 8))), span: nil),
            MirInst(kind: MirInstKind.GetElementPtr(LocalId(id: 6), MirOperand.copy(LocalId(id: 2)), [MirOperand.copy(LocalId(id: 3))]), span: nil),
            MirInst(kind: MirInstKind.Store(MirOperand.copy(LocalId(id: 6)), MirOperand.copy(LocalId(id: 9))), span: nil)
        ],
        terminator: MirTerminator.Ret(nil)
    )

fn unified_vector_add_function() -> MirFunction:
    """The single shared `vector_add` MIR kernel, targeted at all three backends."""
    val ptr_type = unified_kernel_global_u32_ptr()
    val u32_type = unified_kernel_u32()
    MirFunction(
        symbol: SymbolId(id: 1),
        name: "vector_add",
        signature: MirSignature(params: [ptr_type, ptr_type, ptr_type], return_type: MirType.unit(), is_variadic: false),
        locals: [
            unified_kernel_arg_local(0, 0, "a", ptr_type),
            unified_kernel_arg_local(1, 1, "b", ptr_type),
            unified_kernel_arg_local(2, 2, "c", ptr_type),
            unified_kernel_temp_local(3, u32_type),
            unified_kernel_temp_local(4, ptr_type),
            unified_kernel_temp_local(5, ptr_type),
            unified_kernel_temp_local(6, ptr_type),
            unified_kernel_temp_local(7, u32_type),
            unified_kernel_temp_local(8, u32_type),
            unified_kernel_temp_local(9, u32_type)
        ],
        blocks: [unified_vector_add_block()],
        entry_block: BlockId.entry(),
        span: Span.empty(),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {},
        layout_phase: nil,
        is_kernel: true,
        gpu_target: "auto",
        gpu_backend_order: UNIFIED_KERNEL_BACKEND_ORDER,
        is_export_c: false,
        export_name: "",
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(),
        has_fast_math: false
    )

fn unified_kernel_module(func: MirFunction) -> MirModule:
    """Wrap the one shared kernel in the one shared MIR module."""
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[func.symbol] = func
    MirModule(name: "unified_kernel_emit", functions: functions, statics: {}, constants: {}, types: {})

fn unified_kernel_has_mir(kernel_name: text) -> bool:
    """
    True when this module can build shared MIR for `kernel_name`.

    Only `vector_add` — the plan's named headline kernel — has a MIR builder
    here. Any other name emits nothing at all: no backend is invoked and every
    leg stays empty, so a caller never receives fabricated output.

    TODO(W3-headline): source this MIR from the real compiled program instead of
    a builder, once the descriptive-kernel frontend slice (W2.1) lowers
    `parallel fn` all the way to MIR.
    """
    kernel_name == "vector_add"

fn emit_kernel_all_backends(kernel_name: text) -> UnifiedKernelEmission:
    """
    Emit PTX, OpenCL C and VHDL for `kernel_name` from ONE shared MIR kernel.

    Each leg is the corresponding backend's own output. A backend that returns
    an error leaves its leg empty and its diagnostic populated.
    """
    if not unified_kernel_has_mir(kernel_name):
        val absent = "no shared MIR builder for kernel `" + kernel_name + "`"
        return UnifiedKernelEmission(
            kernel_name: kernel_name,
            mir_available: false,
            ptx: "",
            opencl: "",
            vhdl: "",
            ptx_diagnostic: absent,
            opencl_diagnostic: absent,
            vhdl_diagnostic: absent
        )

    val func = unified_vector_add_function()
    val module = unified_kernel_module(func)

    var ptx_out = ""
    var ptx_diag = ""
    val ptx_result = CudaBackend.create((8, 6)).compile(module)
    if ptx_result.is_ok():
        ptx_out = ptx_result.unwrap().ptx
    else:
        ptx_diag = ptx_result.unwrap_err().message

    var opencl_out = ""
    var opencl_diag = ""
    val opencl_result = OpenClBackend.compile_module_to_opencl_source(module)
    if opencl_result.is_ok():
        opencl_out = opencl_result.unwrap()
    else:
        opencl_diag = opencl_result.unwrap_err().message

    var vhdl_out = ""
    var vhdl_diag = ""
    if not vhdl_kernel_accepts(func):
        vhdl_diag = "VHDL backend does not accept kernel `" + kernel_name + "` (gpu_target/gpu_backend_order mismatch or not a kernel)"
    else:
        val vhdl_result = emit_vhdl_kernel_entity(func)
        if vhdl_result.is_ok():
            vhdl_out = vhdl_result.unwrap()
        else:
            vhdl_diag = vhdl_result.unwrap_err().message

    UnifiedKernelEmission(
        kernel_name: kernel_name,
        mir_available: true,
        ptx: ptx_out,
        opencl: opencl_out,
        vhdl: vhdl_out,
        ptx_diagnostic: ptx_diag,
        opencl_diagnostic: opencl_diag,
        vhdl_diagnostic: vhdl_diag
    )

export UnifiedKernelEmission
export emit_kernel_all_backends
