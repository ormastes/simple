# Actual selected core-C object admission for the tagged callback primitives.
use std.io_runtime.{file_hash_sha256_or_empty, process_run}
use std.nogc_sync_mut.io.native_tool_authority_v1.{native_tool_strict_requested_v1, native_tool_strict_resolve_v1}
use compiler.backend.llvm_capability.{find_nm_portable}

pub fn runtime_tagged_callback_owner_v1(source: text, object_path: text) -> Result<bool, text>:
    # The caller supplies the source/object pair from compile_runtime_objects'
    # closed core-C inventory. Existing cache admission keys retain the actual
    # source/header/tool bytes; inspect the materialized output too.
    if file_hash_sha256_or_empty(source) == "" or file_hash_sha256_or_empty(object_path) == "":
        return Err("tagged callback runtime owner has missing source/object identity")
    val nm = if native_tool_strict_requested_v1():
        native_tool_strict_resolve_v1("nm")?
    else:
        find_nm_portable()
    if nm == "": return Err("tagged callback runtime owner has no symbol inspection tool")
    val (stdout, stderr, code) = process_run(nm, [object_path])
    if code != 0:
        return Err("tagged callback runtime owner symbol inspection failed: " + stderr)
    var required: {text: bool} = {
        "rt_tagged_add": false,
        "rt_value_int_wide": false,
        "rt_value_float": false,
        "rt_value_as_float": false,
        "rt_closure_new": false,
        "rt_closure_func_ptr": false,
        "rt_closure_get_capture": false,
        "rt_closure_set_capture": false,
        "rt_transient_array_scope_begin": false,
        "rt_transient_array_scope_pause": false,
        "rt_transient_array_scope_end": false,
        "rt_transient_array_scope_state_v1": false
    }
    for line in stdout.split("\n"):
        var parts: [text] = []
        for part in line.trim().split(" "):
            if part != "": parts = parts.push(part)
        if parts.len() >= 2:
            val kind = parts[parts.len() - 2]
            var name = parts[parts.len() - 1]
            # Mach-O prepends a leading underscore to every C symbol
            # (`_rt_tagged_add`); ELF/GNU nm prints the plain spelling. Strip
            # the prefix so the required-name table matches both formats —
            # without this the admission can never pass on Darwin (the first
            # macOS run of this gate, candidate_frontend_smoke p2_add, failed
            # with 'lacks defined function rt_transient_array_scope_state_v1'
            # even though nm listed the symbol as defined text).
            if name.starts_with("_"):
                name = name.substring(1)
            if kind == "T" and required.has(name): required[name] = true
    for name in required.keys():
        if not required[name]:
            return Err("selected core-C tagged callback owner lacks defined function " + name)
    Ok(true)
