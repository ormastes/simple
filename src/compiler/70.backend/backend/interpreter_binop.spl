use compiler.backend.backend_types.{backend_value_array_v1, backend_value_bool_v1, backend_value_float_v1, backend_value_int_v1, backend_value_string_v1}
# Interpreter Backend - binary operator evaluation extension
#
# Split from interpreter.spl to bound the largest physical parser surface.

use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.backend.backend_types.*
use compiler.backend.interpreter.{
    InterpreterBackendImpl,
    interp_int_to_f64,
    itrace
}
use compiler.backend.interpreter_calls.{interp_binop_disc}

impl InterpreterBackendImpl:
    fn eval_binop(op: HirBinOp, left: Value, right: Value, span: Span, left_unsigned: bool, right_unsigned: bool) -> Result<Value, BackendError>:
        itrace("[EBO] eval_binop enter")
        var op_t: HirBinOp = op
        if op_t == nil:
            return Err(BackendError(
                message: "internal: missing HIR binary operator",
                span: Some(span),
                kind: BackendErrorKind.Internal,
                ctl_value: None
            ))
        itrace("[EBO] op non-nil path disc={interp_binop_disc(op_t)}")
        match op_t:
            case HirBinOp.Add:
                itrace("[EBO] Add arm")
                match left:
                    case Value.Int(l):
                        itrace("[EBO] Add left=Int {l}")
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_int_v1(l + r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(interp_int_to_f64(l, left_unsigned) + r))
                            case _:
                                Err(BackendError.type_error("invalid operands for +", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l + r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l + interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for +", Some(span)))
                    case Value.String(l):
                        match right:
                            case Value.String(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_string_v1(l + r))
                            case _:
                                Err(BackendError.type_error("invalid operands for +", Some(span)))
                    case Value.Array(l):
                        # `xs + [x]` list concatenation (registry/list-builder idiom).
                        match right:
                            case Value.Array(r):
                                Ok(backend_value_array_v1(l + r))
                            case _:
                                Err(BackendError.type_error("invalid operands for +", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for +", Some(span)))

            case HirBinOp.Sub:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_int_v1(l - r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(interp_int_to_f64(l, left_unsigned) - r))
                            case _:
                                Err(BackendError.type_error("invalid operands for -", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l - r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l - interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for -", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for -", Some(span)))

            case HirBinOp.Mul:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_int_v1(l * r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(interp_int_to_f64(l, left_unsigned) * r))
                            case _:
                                Err(BackendError.type_error("invalid operands for *", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l * r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l * interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for *", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for *", Some(span)))

            case HirBinOp.Div:
                if left.is_int() or left.is_float():
                    match right:
                        case Value.Int(r):
                            if r == 0:
                                return Err(BackendError.runtime_error("division by zero", Some(span)))
                        case Value.Float(r):
                            if r == 0.0:
                                return Err(BackendError.runtime_error("division by zero", Some(span)))
                        case _: ()
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_int_v1(l / r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(interp_int_to_f64(l, left_unsigned) / r))
                            case _:
                                Err(BackendError.type_error("invalid operands for /", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l / r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_float_v1(l / interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for /", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for /", Some(span)))

            case HirBinOp.Mod:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                if r == 0:
                                    Err(BackendError.runtime_error("modulo by zero", Some(span)))
                                else:
                                    # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                    Ok(backend_value_int_v1(l % r))
                            case _:
                                Err(BackendError.type_error("invalid operands for %", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for %", Some(span)))

            case HirBinOp.Eq:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l == r))
                            case _:
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(self.values_equal(left, right)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l == r))
                            case _:
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(self.values_equal(left, right)))
                    case _:
                        # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                        Ok(backend_value_bool_v1(self.values_equal(left, right)))

            case HirBinOp.NotEq:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l != r))
                            case _:
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(not self.values_equal(left, right)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l != r))
                            case _:
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(not self.values_equal(left, right)))
                    case _:
                        # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                        Ok(backend_value_bool_v1(not self.values_equal(left, right)))

            case HirBinOp.Lt:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l < r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(interp_int_to_f64(l, left_unsigned) < r))
                            case _:
                                Err(BackendError.type_error("invalid operands for <", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l < r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l < interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for <", Some(span)))
                    case Value.String(l):
                        match right:
                            case Value.String(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l < r))
                            case _:
                                Err(BackendError.type_error("invalid operands for <", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for <", Some(span)))

            case HirBinOp.LtEq:
                match left:
                    case Value.Int(l):
                        match right:
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l <= r))
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(interp_int_to_f64(l, left_unsigned) <= r))
                            case _:
                                Err(BackendError.type_error("invalid operands for <=", Some(span)))
                    case Value.Float(l):
                        match right:
                            case Value.Float(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l <= r))
                            case Value.Int(r):
                                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                                Ok(backend_value_bool_v1(l <= interp_int_to_f64(r, right_unsigned)))
                            case _:
                                Err(BackendError.type_error("invalid operands for <=", Some(span)))
                    case Value.String(l):
                        match right:
                            case Value.String(r):
                                Ok(backend_value_bool_v1(l <= r))
                            case _:
                                Err(BackendError.type_error("invalid operands for <=", Some(span)))
                    case _:
                        Err(BackendError.type_error("invalid operands for <=", Some(span)))

            case HirBinOp.Gt:
                self.eval_gt(left, right, span, left_unsigned, right_unsigned)
            case HirBinOp.GtEq:
                self.eval_gteq(left, right, span, left_unsigned, right_unsigned)

            case HirBinOp.And:
                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                Ok(backend_value_bool_v1(left.is_truthy() and right.is_truthy()))

            case HirBinOp.Or:
                # @workaround bug=imported_value_constructor_static_receiver_native_2026_10_16 recover=67ba74d9acbaa998d5efcb3c162bf61a63f839d0 reason=baked producer lowers imported enum receiver as runtime value
                Ok(backend_value_bool_v1(left.is_truthy() or right.is_truthy()))

            case HirBinOp.BitAnd | HirBinOp.BitOr | HirBinOp.BitXor | HirBinOp.Shl | HirBinOp.Shr:
                self.eval_int_bitwise(interp_binop_disc(op_t), left, right, left_unsigned, span)

            case HirBinOp.In:
                match self.eval_membership(left, right, span):
                    case Ok(found): Ok(backend_value_bool_v1(found))
                    case Err(e): Err(e)
            case HirBinOp.NotIn:
                match self.eval_membership(left, right, span):
                    case Ok(found): Ok(backend_value_bool_v1(not found))
                    case Err(e): Err(e)

            case _:
                Err(BackendError.not_implemented("binary operator not implemented: op={interp_binop_disc(op_t)} left={left.type_name()} right={right.type_name()} at {span.file}:{span.line}:{span.col}"))

    # disc is interp_binop_disc: 15 &, 16 |, 17 ^, 18 <<, 19 >>.
    # Shift counts are taken mod 64, as the compiled lanes and the seed do. `>>` is
    # arithmetic for a signed left operand and logical for an unsigned one.
    fn eval_int_bitwise(disc: i64, left: Value, right: Value, left_unsigned: bool, span: Span) -> Result<Value, BackendError>:
        match left:
            case Value.Int(l):
                match right:
                    case Value.Int(r):
                        val count = r & 63
                        var out: i64 = 0
                        if disc == 15: out = l & r
                        elif disc == 16: out = l | r
                        elif disc == 17: out = l ^ r
                        elif disc == 18: out = l << count
                        elif disc == 19:
                            out = l >> count
                            if left_unsigned and count > 0:
                                out = out & (0x7FFFFFFFFFFFFFFF >> (count - 1))
                        Ok(backend_value_int_v1(out))
                    case _:
                        Err(BackendError.type_error("invalid operands for bitwise op={disc}: left={left.type_name()} right={right.type_name()}", Some(span)))
            case _:
                Err(BackendError.type_error("invalid operands for bitwise op={disc}: left={left.type_name()} right={right.type_name()}", Some(span)))

    fn eval_membership(needle: Value, haystack: Value, span: Span) -> Result<bool, BackendError>:
        match haystack:
            case Value.String(h):
                match needle:
                    case Value.String(n): Ok(h.contains(n))
                    case _: Err(BackendError.type_error("invalid operands for in: left={needle.type_name()} right=text", Some(span)))
            case Value.Array(items):
                for item in items:
                    if self.values_equal(needle, item): return Ok(true)
                Ok(false)
            case Value.Dict(entries):
                match needle:
                    case Value.String(k): Ok(entries.contains_key(k))
                    case _: Err(BackendError.type_error("invalid operands for in: left={needle.type_name()} right=dict", Some(span)))
            case _:
                Err(BackendError.type_error("invalid operands for in: left={needle.type_name()} right={haystack.type_name()}", Some(span)))


