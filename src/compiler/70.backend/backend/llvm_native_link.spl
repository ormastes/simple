fn llvm_stage4_build_memtrack_provider_archive(runtime_objects: [text], target_os_name: text, msvc_objects: bool, msvc_linker: bool, pid: i64) -> Result<text, text>:
    val object_ext = if msvc_objects: ".obj" else: ".o"
    val archive_file = match stage4_memtrack_provider_archive_file(target_os_name, msvc_linker):
        case Ok(name): name
        case Err(err): return Err(err)
    val object_format = match stage4_memtrack_provider_object_format(target_os_name, msvc_objects):
        case Ok(format): format
        case Err(err): return Err(err)
    val archive_path = match llvm_stage4_build_single_object_provider_archive(runtime_objects, "runtime_memtrack", "memtrack", archive_file, object_ext, target_os_name == "windows", pid):
        case Ok(path): path
        case Err(err): return Err(err)
    val scans = match llvm_stage4_candidate_archive_inventory(["runtime_memtrack"], [archive_path]):
        case Ok(outputs): outputs
        case Err(err):
            file_delete(archive_path)
            return Err(err)
    match stage4_validate_memtrack_provider_symbol_contract(scans[0], object_format):
        case Err(err):
            file_delete(archive_path)
            return Err(err)
        case Ok(()): ()
    Ok(archive_path)

fn llvm_stage4_build_time_provider_archive(runtime_objects: [text], target_os_name: text, msvc_objects: bool, msvc_linker: bool, pid: i64) -> Result<text, text>:
    val object_ext = if msvc_objects: ".obj" else: ".o"
    val archive_file = match stage4_time_provider_archive_file(target_os_name, msvc_linker):
        case Ok(name): name
        case Err(err): return Err(err)
    val object_format = match stage4_time_provider_object_format(target_os_name, msvc_objects):
        case Ok(format): format
        case Err(err): return Err(err)
    val archive_path = match llvm_stage4_build_single_object_provider_archive(runtime_objects, "runtime_timestamp", "time", archive_file, object_ext, target_os_name == "windows", pid):
        case Ok(path): path
        case Err(err): return Err(err)
    val scans = match llvm_stage4_candidate_archive_inventory(["runtime_timestamp"], [archive_path]):
        case Ok(outputs): outputs
        case Err(err):
            file_delete(archive_path)
            return Err(err)
    match stage4_validate_time_provider_symbol_contract(scans[0], object_format):
        case Err(err):
            file_delete(archive_path)
            return Err(err)
        case Ok(()): ()
    Ok(archive_path)

fn llvm_stage4_build_fork_provider_archive(runtime_objects: [text], target_os_name: text, msvc_objects: bool, msvc_linker: bool, pid: i64) -> Result<text, text>:
    val object_ext = if msvc_objects: ".obj" else: ".o"
    val archive_file = match stage4_fork_provider_archive_file(target_os_name, msvc_linker):
        case Ok(name): name
        case Err(err): return Err(err)
    val object_format = match stage4_fork_provider_object_format(target_os_name, msvc_objects):
        case Ok(format): format
        case Err(err): return Err(err)
    val archive_path = match llvm_stage4_build_single_object_provider_archive(runtime_objects, "runtime_fork", "fork", archive_file, object_ext, target_os_name == "windows", pid):
        case Ok(path): path
        case Err(err): return Err(err)
    val scans = match llvm_stage4_candidate_archive_inventory(["runtime_fork"], [archive_path]):
        case Ok(outputs): outputs
        case Err(err):
            file_delete(archive_path)
            return Err(err)
    match stage4_validate_fork_provider_symbol_contract(scans[0], object_format):
        case Err(err):
            file_delete(archive_path)
            return Err(err)
        case Ok(()): ()
    Ok(archive_path)

# ============================================================================
# Configuration
# ============================================================================

struct NativeLinkOptions:
    """Options for LLVM native linking."""
    debug: bool
    verbose: bool
    pie: bool
    bare_metal: bool
    opt_level: i64
    stage4_backend: text
    stage4_compiler_hash: text

impl NativeLinkOptions:
    static fn default() -> NativeLinkOptions:
        NativeLinkOptions(
            debug: false,
            verbose: false,
            pie: true,
            bare_metal: false,
            opt_level: 3,
            stage4_backend: "llvm",
            stage4_compiler_hash: ""
        )

fn hosted_c_target_matches_host(target: text, host_os_name: text, host_arch_name: text) -> bool:
    """Whether host-compiled C runtime and entry objects match an explicit target."""
    if target == "" or target == "host" or target == "native":
        return true

    val target_arch_text = if target.contains("-"): target.split("-")[0] else: target
    val target_arch = mir_target_context_normalize_arch(target_arch_text)
    val host_arch_normalized = mir_target_context_normalize_arch(host_arch_name)
    val hosted_riscv64_arch = target_arch_text == "riscv64" or target_arch_text == "riscv64gc" or target_arch_text == "rv64" or target_arch_text == "rv64gc"
    val is_x86_64 = target_arch == "x86_64" and host_arch_normalized == "x86_64"
    val is_aarch64 = target_arch == "aarch64" and host_arch_normalized == "aarch64"
    val is_riscv64 = hosted_riscv64_arch and host_arch_normalized == "riscv64"
    if not is_x86_64 and not is_aarch64 and not is_riscv64:
        return false

    # Architecture-only x86-64/AArch64 targets inherit the host OS. The
    # current explicit RISC-V target contract is Linux-only.
    if not target.contains("-"):
        return not is_riscv64 or host_os_name == "linux"

    val canonical_suffix = match host_os_name:
        case "linux": "-unknown-linux-gnu"
        case "macos" | "darwin": "-apple-darwin"
        case "windows": "-pc-windows-msvc"
        case "freebsd": if is_riscv64: "" else: "-unknown-freebsd"
        case _: ""
    if canonical_suffix == "":
        return false
    target.substring(target_arch_text.len()) == canonical_suffix

# ============================================================================
# C-Based Entry Point Compiler (no llc needed)
# ============================================================================

fn compile_entry_point_c(user_objects: [text], pid: i64, verbose: bool, opt_level: i64, compiler: text = "") -> Result<text, text>:
    """Compile entry point as C source (no llc needed)."""
    val cc = if compiler != "": compiler else: find_c_compiler()
    if cc == "":
        return Err("No C compiler found")
    val tmp_dir = _get_temp_dir()
    val ext = _obj_ext()
    # Deterministic entry-shim basename for reproducible builds: the C compiler
    # embeds the source basename (STT_FILE) into the object, so a PID in the
    # filename would leak into the binary and break bootstrap determinism. Keep
    # the PID in the directory (concurrency-safe) and use a fixed basename.
    val entry_dir = "{tmp_dir}/simple_entry_{pid}"
    dir_create_all(entry_dir)
    val entry_c = "{entry_dir}/simple_entry.c"
    val entry_o = "{entry_dir}/simple_entry{ext}"
    val init_names = simpleos_module_init_symbols(user_objects)
    var c_source = "extern void spl_init_args(int argc, char** argv);\n"
    # The startup owner is optional until a native artifact carries a decoded
    # manifest.  Keeping this a weak ABI lets ordinary native binaries retain
    # their existing entry closure while a manifest-aware generated module can
    # bind the exact same pre-main slot.  The call deliberately precedes
    # runtime/module initialization: declared argv and file preloads must be
    # admitted before user code can observe process state.
    c_source = c_source + "#if !defined(_MSC_VER)\n"
    c_source = c_source + "extern int __simple_startup_before_main(int argc, char** argv) __attribute__((weak));\n"
    c_source = c_source + "#endif\n"
    c_source = c_source + "extern void __simple_runtime_init(void);\n"
    c_source = c_source + "extern long long __simple_main(void);\n"
    c_source = c_source + "extern void __simple_runtime_shutdown(void);\n"
    for name in init_names:
        c_source = c_source + "extern void {name}(void);\n"
    c_source = c_source + "int main(int argc, char** argv) {\n"
    c_source = c_source + "    spl_init_args(argc, argv);\n"
    c_source = c_source + "#if !defined(_MSC_VER)\n"
    c_source = c_source + "    if (__simple_startup_before_main && __simple_startup_before_main(argc, argv) != 0) return 125;\n"
    c_source = c_source + "#endif\n"
    c_source = c_source + "    __simple_runtime_init();\n"
    for name in init_names:
        c_source = c_source + "    {name}();\n"
    c_source = c_source + "    long long result = __simple_main();\n"
    c_source = c_source + "    __simple_runtime_shutdown();\n"
    c_source = c_source + "    return (int)result;\n"
    c_source = c_source + "}\n"
    file_write(entry_c, c_source)

    val use_msvc = _is_msvc_cc(cc)
    var comp_args: [text] = []
    if use_msvc:
        var msvc_opt = "/Ox"
        if opt_level <= 0:
            msvc_opt = "/Od"
        elif opt_level == 1:
            msvc_opt = "/O1"
        elif opt_level == 2:
            msvc_opt = "/O2"
        comp_args = ["/c", msvc_opt, "/Gy", "/Fo{entry_o}", entry_c]
    else:
        comp_args = ["-c"]
        if not _is_windows():
            comp_args.push("-fPIC")
        var cc_opt = "-O3"
        if opt_level <= 0:
            cc_opt = "-O0"
        elif opt_level == 1:
            cc_opt = "-Oz"
        elif opt_level == 2:
            cc_opt = "-O2"
        comp_args.push(cc_opt)
        comp_args.push("-ffunction-sections")
        comp_args.push("-fdata-sections")
        comp_args.push("-o")
        comp_args.push(entry_o)
        comp_args.push(entry_c)

    val (ep_out, ep_err, ep_code) = process_run(cc, comp_args)
    file_delete(entry_c)
    if ep_code != 0:
        return Err("Entry point compilation failed: {ep_out}{ep_err}")
    Ok(entry_o)

# Narrow core runtime lanes must never acquire the Rust hosted archive merely
# because SIMPLE_RUNTIME_PATH points at the bootstrap directory.
fn native_all_allowed_for_runtime_bundle(bundle: text) -> bool:
    match bundle:
        case "simple-core": false
        case "simple_core": false
        case "core-c-bootstrap": false
        case "core_c_bootstrap": false
        case "runtime": false
        case "core": false
        case "core-c": false
        case "core_c": false
        case _: true

# ============================================================================
# Main Orchestrator
# ============================================================================

fn link_llvm_native(user_objects: [text], output: text, options: NativeLinkOptions) -> Result<text, text>:
    """Link LLVM-compiled user objects with C runtime into a native executable.

    Pipeline:
    1. Compile C runtime (runtime.c, runtime_native.c, etc.) to .o files
    2. Generate and compile entry point IR to .o (via llc, or C fallback)
    3. Combine all objects and link with system linker

    Returns Ok(output_path) on success, Err(message) on failure.
    """
    val trace = llvm_link_trace_enabled()
    if trace:
        print "[LLVM-LINK] enter link_llvm_native"
    val verbose = options.verbose
    if trace:
        print "[LLVM-LINK] verbose={verbose}"
    val pid = getpid()
    if trace:
        print "[LLVM-LINK] pid={pid}"

    val stage4_requested = (env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "") == "1"
    val stage4_entry = env_get("SIMPLE_NATIVE_BUILD_ENTRY") ?? ""
    val stage4_entry_closure = env_get("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE") ?? ""
    val stage4_entry_allowed = (
        stage4_entry == "src/app/cli/main.spl" or
        stage4_entry == "src/app/os/main.spl"
    )
    if stage4_requested and (not stage4_entry_allowed or stage4_entry_closure != "1"):
        return Err("Stage4 strict profile requires an authorized compiler entry with entry closure")

    if is_simpleos_x86_64_link(user_objects, output):
        if stage4_requested:
            return Err("Stage4 strict profile does not support SimpleOS link routes")
        return link_simpleos_x86_64(user_objects, output, verbose, options.opt_level)

    if is_simpleos_arm64_link(output):
        if stage4_requested:
            return Err("Stage4 strict profile does not support SimpleOS link routes")
        return link_simpleos_arm64(user_objects, output, verbose, options.opt_level)

    if is_simpleos_riscv64_link(user_objects, output):
        if stage4_requested:
            return Err("Stage4 strict profile does not support SimpleOS link routes")
        return link_simpleos_riscv64(user_objects, output, verbose)

    if is_simpleos_riscv32_link(user_objects, output):
        if stage4_requested:
            return Err("Stage4 strict profile does not support SimpleOS link routes")
        return link_simpleos_riscv32(user_objects, output, verbose)

    val hosted_target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    val hosted_os = host_os()
    val hosted_arch = host_arch()
    val hosted_plan = hosted_c_compiler_plan(hosted_target, hosted_os, hosted_arch)
    if not hosted_plan.supported:
        return Err("host C runtime/entry compilation unsupported: target '{hosted_target}' on host '{hosted_arch}-{hosted_os}'")
    if not hosted_native_link_arch_supported(hosted_os, hosted_arch):
        return Err(hosted_native_link_unsupported_arch_error(hosted_os, hosted_arch))
    if stage4_requested and hosted_plan.requires_cross:
        return Err("Stage4 strict profile requires a native host target; cross-target compiler capsules are unavailable")
    val hosted_cc = find_c_compiler()
    if hosted_cc == "":
        return Err("No C compiler found. Install clang or gcc.")

    var stage4_msvc_linker = false
    var stage4_msvc_objects = false
    if stage4_requested:
        stage4_msvc_linker = hosted_os == "windows" and not _is_mingw()
        match stage4_windows_c_object_uses_msvc_abi(hosted_os, hosted_target, hosted_cc, stage4_msvc_linker):
            case Ok(msvc): stage4_msvc_objects = msvc
            case Err(err): return Err(err)

    # Outside strict Stage4, link the Rust native_all archive whenever
    # SIMPLE_RUNTIME_PATH points at one. The normal path needs it for
    # modules calling seed-owned externs (e.g. bootstrap_main's
    # rt_native_build), which the C runtime objects do not define; without it
    # the link dies with "undefined symbol: rt_native_build" (#146/#79).
    var bootstrap_native_all = ""
    val runtime_path = env_get("SIMPLE_RUNTIME_PATH") ?? ""
    val runtime_bundle = env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE") ?? ""
    if not stage4_requested and runtime_path != "" and not hosted_plan.requires_cross:
        if native_all_allowed_for_runtime_bundle(runtime_bundle):
            val native_all_name = if hosted_os == "windows" and not _is_mingw(): "simple_native_all.lib" else: "libsimple_native_all.a"
            val native_all = runtime_path + "/" + native_all_name
            if file_exists(native_all):
                bootstrap_native_all = native_all

    # Step 1: Always compile the FRESH C runtime to object files, even when the
    # native_all archive is linked (including under SIMPLE_BOOTSTRAP=1). ld
    # pulls archive members only for still-undefined symbols, so native_all just
    # backfills seed-owned externs (rt_native_build) while the fresh C runtime
    # keeps owning rt_interp_cstr/rt_strcat/rt_text_eq_any/
    # __simple_intrinsic_bounds_check/etc. The old SIMPLE_BOOTSTRAP=1 branch
    # REPLACED the C runtime with the archive's bundled (and stale) runtime
    # snapshot, so any runtime symbol added after the archive was built (e.g.
    # rt_text_eq_any from #148) linked as "undefined symbol" and broke the
    # stage2 redeploy compile of bootstrap_main. Never replace.
    #
    # This used to be gated on a constant-false "archive replaces the C runtime"
    # flag, with `runtime_objects` bound by an if-EXPRESSION whose dead branch
    # was a bare `[]`. On the Stage 3 self-host link that binding lost the list:
    # all 23 runtime objects were compiled (and were still deleted by the
    # cleanup below, so the value was intact there), yet the object-collection
    # loop saw zero of them and the link line carried only the user object and
    # the entry shim. ld.lld then reported exactly spl_init_args /
    # __simple_runtime_init / __simple_runtime_shutdown undefined -- every other
    # runtime reference sat in --gc-sections-dead code, which lld does not
    # report, so the failure looked like three missing entry shims rather than a
    # missing runtime. The C runtime is never replaced, so bind it
    # unconditionally, straight-line, with an explicit element type.
    if trace:
        print "[LLVM-LINK] step 1: compile_runtime_objects..."
    # native_all already owns spl_dl* in Rust; otherwise the pure hosted
    # runtime supplies the C owner for both LLVM and Cranelift.
    val rt_result = compile_runtime_objects(verbose, options.opt_level, bootstrap_native_all == "", hosted_cc, stage4_requested)
    if trace:
        print "[LLVM-LINK] compile_runtime_objects returned"
    val runtime_objects: [text] = match rt_result:
        case Ok(paths):
            paths
        case Err(err):
            return Err("Runtime compilation failed: {err}")
    if trace:
        print "[LLVM-LINK] got {runtime_objects.len()} runtime objects"

    # No bootstrap-only C ABI support object is ever synthesized: the fresh C
    # runtime above owns spl_init_args/__simple_runtime_init/
    # __simple_runtime_shutdown. Kept as a value so the Stage4 cleanup helpers
    # below keep their parameter shape.
    val bootstrap_support_obj = ""

    # Step 2: Generate and compile entry point
    if trace:
        print "[LLVM-LINK] step 2: compile entry point..."
    val c_result = compile_entry_point_c(user_objects, pid, verbose, options.opt_level, hosted_cc)
    if trace:
        print "[LLVM-LINK] entry point compiled"
    val entry_obj_path = match c_result:
        case Ok(path):
            path
        case Err(err):
            cleanup_runtime_objects(runtime_objects)
            if bootstrap_support_obj != "":
                file_delete(bootstrap_support_obj)
            return Err("Entry point compilation failed: {err}")

    var stage4_requested_symbols: [text] = []
    var stage4_projection_capsule = ""
    var stage4_projection_dir = ""
    var stage4_profile_input = ""
    var stage4_profile_hash = ""
    var stage4_profile_dir = ""
    var stage4_profile_receipt_path = ""
    if stage4_requested:
        if bootstrap_native_all != "":
            cleanup_runtime_objects(runtime_objects)
            file_delete(entry_obj_path)
            if bootstrap_support_obj != "":
                file_delete(bootstrap_support_obj)
            return Err("Stage4 strict profile rejects libsimple_native_all.a")
        var final_simple_objects: [text] = []
        for object in user_objects:
            final_simple_objects = final_simple_objects.push(object)
        final_simple_objects = final_simple_objects.push(entry_obj_path)
        match llvm_stage4_final_requested_symbols(final_simple_objects):
            case Ok(symbols):
                stage4_requested_symbols = symbols
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return Err(err)
        if trace:
            print "[LLVM-LINK] Stage4 requested runtime symbols: {stage4_requested_symbols.len()}"
        val compiler_backfill_capsule = match llvm_stage4_build_compiler_backfill_capsule(runtime_path, hosted_os, hosted_cc, pid, output):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return Err("Stage4 compiler backfill capsule failed: " + err)
        val compiler_backfill_stage_dir = "{_get_temp_dir()}/simple_stage4_compiler_backfill_{pid}_{output.hash()}"
        val runtime_native_archive = match llvm_stage4_build_runtime_native_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 runtime-native core failed: " + err)
        val process_provider_archive = match llvm_stage4_build_process_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 process provider failed: " + err)
        val dynload_provider_archive = match llvm_stage4_build_dynload_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(process_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 dynamic-loader provider failed: " + err)
        val font_provider_archive = match llvm_stage4_build_font_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 font provider failed: " + err)
        val memtrack_provider_archive = match llvm_stage4_build_memtrack_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 memtrack provider failed: " + err)
        val time_provider_archive = match llvm_stage4_build_time_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 time provider failed: " + err)
        var fork_provider_archive = ""
        if hosted_os != "windows":
            match llvm_stage4_build_fork_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
                case Ok(path): fork_provider_archive = path
                case Err(err):
                    cleanup_runtime_objects(runtime_objects)
                    file_delete(entry_obj_path)
                    file_delete(runtime_native_archive)
                    file_delete(process_provider_archive)
                    file_delete(dynload_provider_archive)
                    file_delete(font_provider_archive)
                    file_delete(memtrack_provider_archive)
                    file_delete(time_provider_archive)
                    if bootstrap_support_obj != "":
                        file_delete(bootstrap_support_obj)
                    return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 fork provider failed: " + err)
        val runtime_legacy_compat_archive = match llvm_stage4_build_runtime_legacy_compat_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 runtime legacy compatibility failed: " + err)
        val contracts_provider_archive = match llvm_stage4_build_contracts_provider_archive(runtime_objects, hosted_os, stage4_msvc_objects, stage4_msvc_linker, pid):
            case Ok(path): path
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                for path in [runtime_native_archive, runtime_legacy_compat_archive, process_provider_archive, dynload_provider_archive, font_provider_archive, memtrack_provider_archive, time_provider_archive]:
                    file_delete(path)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 contract provider failed: " + err)
        var candidate_labels = ["compiler_backfill", "runtime_native", "runtime_contracts", "runtime_legacy_compat", "runtime_process", "runtime_dynload", "runtime_font", "runtime_memtrack", "runtime_timestamp"]
        var candidate_paths = [compiler_backfill_capsule, runtime_native_archive, contracts_provider_archive, runtime_legacy_compat_archive, process_provider_archive, dynload_provider_archive, font_provider_archive, memtrack_provider_archive, time_provider_archive]
        if fork_provider_archive != "":
            candidate_labels = candidate_labels.push("runtime_fork")
            candidate_paths = candidate_paths.push(fork_provider_archive)
        val candidate_scans = match llvm_stage4_candidate_archive_inventory(candidate_labels, candidate_paths):
            case Ok(scans): scans
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(contracts_provider_archive)
                file_delete(runtime_legacy_compat_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 combined candidate inventory failed: " + err)
        val compiler_backfill_object_format = match stage4_compiler_backfill_object_format(hosted_os):
            case Ok(format): format
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(contracts_provider_archive)
                file_delete(runtime_legacy_compat_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, err)
        match stage4_validate_compiler_backfill_provider_disjoint(candidate_scans[0], candidate_labels[1:], candidate_scans[1:], compiler_backfill_object_format):
            case Ok(()): ()
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(contracts_provider_archive)
                file_delete(runtime_legacy_compat_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, err)
        val (selected_archive_indices, owner_rows) = match stage4_resolve_requested_archive_owners(stage4_requested_symbols, candidate_labels, candidate_scans, hosted_os == "macos"):
            case Ok(resolution): resolution
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(contracts_provider_archive)
                file_delete(runtime_legacy_compat_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 requested-owner resolution failed: " + err)
        if trace:
            print "[LLVM-LINK] Stage4 selected archives: {selected_archive_indices.len()}, owners: {owner_rows.len()}"
        val source_hash_rows = match llvm_stage4_file_hash_rows(final_simple_objects):
            case Ok(rows): rows
            case Err(err): return llvm_stage4_profile_failure(runtime_objects, entry_obj_path, candidate_paths, compiler_backfill_stage_dir, bootstrap_support_obj, err)
        val archive_hash_rows = match llvm_stage4_selected_archive_hash_rows(candidate_labels, candidate_paths, selected_archive_indices):
            case Ok(rows): rows
            case Err(err): return llvm_stage4_profile_failure(runtime_objects, entry_obj_path, candidate_paths, compiler_backfill_stage_dir, bootstrap_support_obj, err)
        val stage4_target = if hosted_target == "": "{hosted_arch}-{hosted_os}" else: hosted_target
        val stage4_backend = if options.stage4_backend == "": "llvm" else: options.stage4_backend
        val stage4_link_options = "debug={options.debug},pie={options.pie},bare_metal={options.bare_metal},opt_level={options.opt_level},duplicate_definitions=false,cc_fallback=false"
        stage4_profile_input = match stage4_link_profile_fingerprint_input(stage4_target, stage4_backend, stage4_link_options, options.stage4_compiler_hash, source_hash_rows, archive_hash_rows, owner_rows):
            case Ok(input): input
            case Err(err): return llvm_stage4_profile_failure(runtime_objects, entry_obj_path, candidate_paths, compiler_backfill_stage_dir, bootstrap_support_obj, err)
        stage4_profile_hash = sha256_u8_hex(stage4_profile_input.bytes())
        val configured_cache_root = env_get("SIMPLE_NATIVE_BUILD_CACHE_DIR") ?? ""
        val stage4_cache_root = if configured_cache_root == "": "build/native_cache" else: configured_cache_root
        stage4_profile_dir = stage4_cache_root + "/stage4-link-profiles/" + stage4_profile_hash
        stage4_profile_receipt_path = stage4_profile_dir + "/receipt"
        val (projected_capsule, projected_dir) = match llvm_stage4_project_selected_archives(candidate_labels, candidate_paths, selected_archive_indices, stage4_requested_symbols, hosted_os, hosted_cc, pid, output):
            case Ok(value): value
            case Err(err):
                cleanup_runtime_objects(runtime_objects)
                file_delete(entry_obj_path)
                file_delete(runtime_native_archive)
                file_delete(contracts_provider_archive)
                file_delete(runtime_legacy_compat_archive)
                file_delete(process_provider_archive)
                file_delete(dynload_provider_archive)
                file_delete(font_provider_archive)
                file_delete(memtrack_provider_archive)
                file_delete(time_provider_archive)
                if fork_provider_archive != "":
                    file_delete(fork_provider_archive)
                if bootstrap_support_obj != "":
                    file_delete(bootstrap_support_obj)
                return llvm_stage4_compiler_backfill_failure(compiler_backfill_stage_dir, compiler_backfill_capsule, "Stage4 selected-archive projection failed: " + err)
        stage4_projection_capsule = projected_capsule
        stage4_projection_dir = projected_dir
        cleanup_runtime_objects(runtime_objects)
        val candidate_cleanup_ok = llvm_stage4_cleanup_candidate_inputs(candidate_paths, compiler_backfill_stage_dir, bootstrap_support_obj)
        if not candidate_cleanup_ok:
            dir_remove_all(stage4_projection_dir)
            file_delete(entry_obj_path)
            return Err("Stage4 selected-archive candidate cleanup failed")

    # Step 3: Combine all objects and link
    if trace:
        print "[LLVM-LINK] step 3: combining objects..."
    var all_objects: [text] = []
    var user_object_i = 0
    while user_object_i < user_objects.len():
        val user_object: text = user_objects[user_object_i]
        all_objects = all_objects.push(user_object)
        user_object_i = user_object_i + 1
    if stage4_requested:
        all_objects = all_objects.push(entry_obj_path)
        all_objects = all_objects.push(stage4_projection_capsule)
    else:
        var runtime_object_i = 0
        while runtime_object_i < runtime_objects.len():
            val runtime_object: text = runtime_objects[runtime_object_i]
            all_objects = all_objects.push(runtime_object)
            runtime_object_i = runtime_object_i + 1
        if bootstrap_support_obj != "":
            all_objects = all_objects.push(bootstrap_support_obj)
        if bootstrap_native_all != "":
            all_objects = all_objects.push(bootstrap_native_all)
        all_objects = all_objects.push(entry_obj_path)
    # External providers are intentionally not temporary runtime objects: do
    # not pass them to cleanup_runtime_objects or delete them after linking.
    # They remain caller-owned; dynamic providers stay in the dependency table
    # while static providers contribute only extracted members.
    val external_providers = match llvm_configured_external_link_objects():
        case Ok(paths): paths
        case Err(err):
            cleanup_runtime_objects(runtime_objects)
            if bootstrap_support_obj != "":
                file_delete(bootstrap_support_obj)
            if stage4_requested:
                remove_file_if_exists(entry_obj_path)
            else:
                file_delete(entry_obj_path)
            return Err(err)
    for provider in external_providers:
        all_objects = all_objects.push(provider)
    val retained_symbols = match llvm_external_provider_retained_symbols(external_providers):
        case Ok(symbols): symbols
        case Err(err):
            cleanup_runtime_objects(runtime_objects)
            if bootstrap_support_obj != "":
                file_delete(bootstrap_support_obj)
            if stage4_requested:
                remove_file_if_exists(entry_obj_path)
            else:
                file_delete(entry_obj_path)
            return Err(err)
    if trace:
        print "[LLVM-LINK] total objects: {all_objects.len()}"

    if trace:
        print "[LLVM-LINK] creating NativeLinkConfig..."
    var link_config = NativeLinkConfig(
        libraries: [],
        library_paths: [],
        runtime_path: "none",
        pie: options.pie,
        debug: options.debug,
        verbose: options.verbose,
        allow_duplicate_definitions: not stage4_requested,
        allow_cc_fallback: not stage4_requested,
        retained_symbols: retained_symbols,
        extra_flags: llvm_external_provider_rpath_flags(external_providers)
    )
    if trace:
        print "[LLVM-LINK] calling link_to_native..."

    val link_result = link_to_native(all_objects, output, link_config)
    if trace:
        print "[LLVM-LINK] link_to_native returned"

    # Cleanup temp files
    cleanup_runtime_objects(runtime_objects)
    if bootstrap_support_obj != "":
        file_delete(bootstrap_support_obj)
    var stage4_cleanup_ok = true
    if stage4_requested:
        if not remove_file_if_exists(entry_obj_path):
            stage4_cleanup_ok = false
    else:
        file_delete(entry_obj_path)
    if stage4_projection_dir != "":
        if not dir_remove_all(stage4_projection_dir):
            stage4_cleanup_ok = false

    match link_result:
        case Ok(path):
            if not stage4_cleanup_ok:
                if not remove_file_if_exists(path):
                    return Err("Stage4 selected-archive projection cleanup failed after linking; output cleanup also failed")
                return Err("Stage4 selected-archive projection cleanup failed after linking")
            if stage4_requested:
                val output_hash = file_hash_sha256(path)
                if output_hash.len() != 64:
                    return llvm_stage4_receipt_failure(path, "", "", false, false, "Stage4 link-profile output hash failed")
                val receipt = "stage4-link-profile-receipt-v1\nprofile=" + stage4_profile_hash + "\noutput=" + output_hash + "\n"
                val profile_input_path = stage4_profile_dir + "/profile.input"
                val profile_dir_existed = dir_exists(stage4_profile_dir)
                if stage4_profile_dir == "" or stage4_profile_receipt_path == "" or not dir_create_all(stage4_profile_dir):
                    return llvm_stage4_receipt_failure(path, stage4_profile_dir, stage4_profile_receipt_path, not profile_dir_existed, false, "Stage4 link-profile receipt directory creation failed")
                if profile_dir_existed and not file_exists(profile_input_path):
                    return llvm_stage4_receipt_failure(path, stage4_profile_dir, stage4_profile_receipt_path, true, true, "Stage4 link-profile namespace is incomplete")
                if file_exists(profile_input_path) and file_read(profile_input_path) != stage4_profile_input:
                    return llvm_stage4_receipt_failure(path, stage4_profile_dir, stage4_profile_receipt_path, false, false, "Stage4 link-profile hash collision")
                if not file_exists(profile_input_path) and not file_write(profile_input_path, stage4_profile_input):
                    return llvm_stage4_receipt_failure(path, stage4_profile_dir, stage4_profile_receipt_path, not profile_dir_existed, false, "Stage4 link-profile input write failed")
                if not file_write(stage4_profile_receipt_path, receipt):
                    return llvm_stage4_receipt_failure(path, stage4_profile_dir, stage4_profile_receipt_path, not profile_dir_existed, true, "Stage4 link-profile receipt write failed")
            if verbose:
                print "[llvm-link] Native executable: {path}"
            Ok(path)
        case Err(e):
            if stage4_requested:
                if not remove_file_if_exists(output):
                    stage4_cleanup_ok = false
            if not stage4_cleanup_ok:
                return Err("Linking failed: {e}; Stage4 strict cleanup also failed")
            Err("Linking failed: {e}")

fn is_simpleos_riscv64_link(user_objects: [text], output: text) -> bool:
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    if is_simpleos_riscv64_target(target):
        return true
    if output.contains("simpleos_riscv64"):
        return true
    for obj in user_objects:
        if obj.contains("simpleos_riscv64"):
            return true
    false

fn is_simpleos_riscv64_target(target: text) -> bool:
    target == "riscv64gc-simpleos" or target == "riscv64gc-unknown-simpleos" or target == "riscv64gc-unknown-simpleos-elf" or target == "riscv64gc-unknown-none" or target == "riscv64gc-unknown-none-elf" or target == "riscv64-simpleos" or target == "riscv64-unknown-simpleos" or target == "riscv64-unknown-simpleos-elf" or target == "riscv64-unknown-none" or target == "riscv64-unknown-none-elf"

fn is_simpleos_arm64_link(output: text) -> bool:
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    is_simpleos_arm64_target(target) or output.contains("simpleos_arm64")

fn is_simpleos_arm64_target(target: text) -> bool:
    target == "aarch64-simpleos" or target == "aarch64-unknown-simpleos" or target == "aarch64-unknown-simpleos-elf" or target == "aarch64-unknown-none" or target == "aarch64-unknown-none-elf"

fn is_simpleos_x86_64_link(user_objects: [text], output: text) -> bool:
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    if is_simpleos_x86_64_target(target):
        return true
    if output.contains("simpleos_wm_simple_web_check") or output.contains("simpleos_x86_64"):
        return true
    false

fn is_simpleos_x86_64_target(target: text) -> bool:
    target == "simpleos" or target == "simpleos-x86_64" or target == "x86_64-simpleos" or target == "x86_64-unknown-simpleos" or target == "x86_64-unknown-simpleos-elf" or target == "x86_64-unknown-none" or target == "x86_64-unknown-none-elf"

fn simpleos_x86_64_sysroot() -> text:
    val configured = env_get("SIMPLE_SYSROOT") ?? ""
    if configured != "":
        return configured
    val legacy = env_get("SIMPLEOS_SYSROOT") ?? ""
    if legacy != "":
        return legacy
    "build/os/sysroot"

fn simpleos_x86_64_user_link_inputs(sysroot: text) -> [text]:
    val configured_crt0 = env_get("SIMPLE_CRT0_PATH") ?? ""
    val configured_libc = env_get("SIMPLE_LIBC_PATH") ?? ""
    val configured_runtime = env_get("SIMPLE_SIMPLE_CORE_PATH") ?? ""
    val target_runtime = "build/os/simple-core-simpleos/libsimple_runtime.a"
    val runtime = if configured_runtime != "":
        configured_runtime
    elif file_exists(target_runtime):
        target_runtime
    else:
        "{sysroot}/lib/libsimple_runtime.a"
    val inputs: [text] = [
        if configured_crt0 != "": configured_crt0 else: "{sysroot}/lib/crt0.o",
        runtime,
        if configured_libc != "": configured_libc else: "{sysroot}/lib/libsimpleos_c.a"
    ]
    inputs

fn is_simpleos_riscv32_link(user_objects: [text], output: text) -> bool:
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    is_simpleos_riscv32_link_for_target(target, user_objects, output)

fn is_simpleos_riscv32_link_for_target(target: text, user_objects: [text], output: text) -> bool:
    if is_simpleos_riscv32_target(target):
        return true
    if target != "":
        return false
    if output.contains("riscv32") or output.contains("rv32"):
        return true
    for obj in user_objects:
        if obj.contains("riscv32") or obj.contains("rv32"):
            return true
    false

fn is_simpleos_riscv32_target(target: text) -> bool:
    target == "riscv32imac-simpleos" or target == "riscv32imac-unknown-simpleos" or target == "riscv32imac-unknown-simpleos-elf" or target == "riscv32imac-unknown-none" or target == "riscv32imac-unknown-none-elf" or target == "riscv32-unknown-none" or target == "riscv32-unknown-none-elf"

fn compile_simpleos_x86_64_c(src: text, obj: text, opt_level: i64) -> Result<text, text>:
    var opt = "-O2"
    if opt_level <= 0:
        opt = "-O0"
    elif opt_level == 1:
        opt = "-Os"
    val (_out, err, code) = process_run("cc", [
        "-c", "-m64", "-ffreestanding", "-fno-pic", "-fno-pie", "-mno-red-zone",
        "-ffunction-sections", "-fdata-sections", opt,
        "-I", "examples/09_embedded/simple_os/arch/x86_64/boot",
        "-o", obj, src
    ])
    if code != 0:
        return Err("SimpleOS x86_64 C compile failed for {src}: {err}")
    Ok(obj)

fn compile_simpleos_arm64(src: text, obj: text, opt_level: i64) -> Result<text, text>:
    var opt = "-O2"
    if opt_level <= 0:
        opt = "-O0"
    elif opt_level == 1:
        opt = "-Os"
    val (_out, err, code) = process_run("clang", [
        "-target", "aarch64-unknown-none-elf", "-c", "-ffreestanding", "-nostdlib",
        "-fno-pie", "-ffunction-sections", "-fdata-sections", opt,
        "-I", "examples/09_embedded/simple_os/arch/arm64/boot",
        "-o", obj, src
    ])
    if code != 0:
        return Err("SimpleOS ARM64 boot compile failed for {src}: {err}")
    Ok(obj)

fn simpleos_spl_start_symbol(user_objects: [text]) -> text:
    for obj in user_objects:
        for symbol in extract_symbols_nm(obj):
            if symbol.name.ends_with("__spl_start"):
                return symbol.name
    ""

fn simpleos_rt_symbol_is_optional_backend(name: text) -> bool:
    """Freestanding-optional families -- the `RT_KEEP` counterpart from the
    Rust seed's guard (linker/native_binary/stubs.rs:129).

    These are hardware-accelerator / host-service backends that genuinely have
    no baremetal implementation, and every caller is written to treat the nil
    result as "backend unavailable", so auto_stubs.c's weak zero-returning stub
    is the INTENDED answer. Every other `rt_*` reaching that stub is a
    silent-corruption bug, so keep this list short and audited.

    NOT a prefix here on purpose: `rt_simd_`. That family is dominated by
    ARITHMETIC kernels (`rt_simd_add_f32x4`, `rt_simd_fma_f32x8`, ...) where nil
    is silent numeric corruption, not "unavailable" -- a `rt_simd_` prefix would
    have swallowed exactly the bug class this guard exists to catch. Only the
    capability-probe / diagnostic-counter members are allowlisted, by exact
    name. Same reasoning keeps `rt_engine2d_simd_*` (real span blitters, whose
    nil answer is a blank framebuffer) off this list entirely.

    NOT a prefix here either, for the same reason: `rt_arm_virtio_`. It was one
    until 2026-07-28, and that swept an entire block-STORAGE READ path into the
    "nil means unavailable" bucket
    (doc/08_tracking/bug/rt_arm_virtio_blk_prefix_allowlist_defeats_fabrication_guard_2026-07-28.md).
    `virtio_blk_arm_read_sector_bytes`
    (src/os/drivers/virtio/_VirtioBlk/driver_class.spl) reads the status word as
    `0xFFFFFFFF` -> fail, non-zero -> fail, **zero -> success**, so a weak
    zero-returning stub reports SUCCESS with an empty buffer and FAT32 metadata
    mis-parses silently -- nil is corruption here, not "unavailable", exactly
    the `rt_simd_` criterion above. Only the six MMIO transport / capability
    probes are admitted, by exact name; they are also precisely the six carried
    by `allow_arm_virtio()` in
    test/03_system/check/simpleos_kernel_fabricated_rt_symbol_guard_spec.spl,
    and the two lists must stay identical.

    Deliberately NOT admitted (sector data path -- a missing definition must
    fail the link, never link a nil stub): `rt_arm_virtio_blk_dma_base` (base of
    the buffer that HOLDS the payload), `_prepare_read`, `_read_sector_direct`,
    `_sector_bytes`, `_status_u8`, `_wait_completion`, `_read_prefix`,
    `_read_hello_smf`. arm32/arm64 supply real bodies for all of them; any other
    arch that starts linking this driver is meant to fail closed here."""
    if (name.starts_with("rt_vulkan_") or name.starts_with("rt_metal_") or
            name.starts_with("rt_cuda_") or name.starts_with("rt_rocm_") or
            name.starts_with("rt_oneapi_") or name.starts_with("rt_opencl_") or
            name.starts_with("rt_directx_") or
            name.starts_with("rt_host_gpu_queue_")):
        return true
    if (name == "rt_arm_virtio_blk_configure_queue" or
            name == "rt_arm_virtio_blk_mmio_read_u32" or
            name == "rt_arm_virtio_blk_mmio_read_u64" or
            name == "rt_arm_virtio_blk_mmio_write_u32" or
            name == "rt_arm_virtio_blk_queue_base" or
            name == "rt_arm_virtio_blk_set_mmio_base"):
        return true
    (name == "rt_simd_detect_profile" or
        name == "rt_simd_engine2d_neon_hits" or
        name == "rt_simd_engine2d_neon_reset")

fn simpleos_undefined_rt_symbols(objects: [text]) -> [text]:
    """Undefined `rt_*` references across the user's objects, deduped.

    `extract_symbols_nm` deliberately drops undefined and weak entries, so the
    reference side needs its own `nm -u` pass."""
    var seen: {text: bool} = {}
    var names: [text] = []
    for obj in objects:
        val (nm_out, _nm_err, nm_code) = process_run("nm", ["-u", obj])
        if nm_code != 0:
            continue
        for line in nm_out.split("\n"):
            for part in line.split(" "):
                if part.starts_with("rt_") and not seen.has(part):
                    seen[part] = true
                    names.push(part)
    names

fn simpleos_undefined_simple_module_symbols(objects: [text]) -> [text]:
    """Undefined pure-Simple (`lib__*` / `os__*`) references across the closure.

    The OTHER half of the fabrication fail-open. The `rt_*` channel was built
    after a nil-returning `rt_array_copy` shredded every array copy in the
    guest, but the stub generator fabricates a weak nil body for ANY name left
    undefined in the link set -- and `lib__*` / `os__*` were never filtered, so
    a dropped pure-Simple body has been silently replaced by
    `xor %eax,%eax; ret` since this guard was written.

    Proven instance (2026-07-28): the WM kernel bound
    `lib__gc_async_mut__gpu__browser_engine__simple_web_html_layout_renderer_layout__skip_wrap_spaces`
    to an 8-byte nil stub from 3 call sites inside
    `..._style__parse_font_shorthand_family`, because a cached object compiled
    BEFORE that function moved to `..._foundation.spl` was reused and still
    referenced the pre-move mangled name. The real body was in the same ELF
    under the foundation prefix; nothing failed the link.

    Uses its own `nm -u` pass for the same reason
    `simpleos_undefined_rt_symbols` does: `extract_symbols_nm` drops undefined
    entries."""
    var seen: {text: bool} = {}
    var names: [text] = []
    for obj in objects:
        val (nm_out, _nm_err, nm_code) = process_run("nm", ["-u", obj])
        if nm_code != 0:
            continue
        for line in nm_out.split("\n"):
            for part in line.split(" "):
                if not (part.starts_with("lib__") or part.starts_with("os__")):
                    continue
                if not seen.has(part):
                    seen[part] = true
                    names.push(part)
    names

fn simpleos_defined_symbols_any_binding(objects: [text]) -> [text]:
    """Every DEFINED symbol in `objects`, deduped -- weak definitions included.

    Deliberately NOT `extract_symbols_nm`: that helper drops `W/w/V/v` as well
    as `U/u` (llvm_backend_tools.spl:42), which is right for its own callers
    (it feeds codegen symbol tables and `__module_init` discovery) but is
    catastrophic here. Weak linkage does NOT imply fabricated:
    `baremetal_stubs.c` declares real implementations `__attribute__((weak))`
    -- `rt_memcpy`, `rt_memset`, `rt_dma_alloc`, `rt_dma_phys_of`,
    `rt_dma_virt_of`, `rt_file_read_bytes` all have genuine bodies. Reusing the
    weak-dropping helper made every one of them permanently unclassifiable as
    real, so the guard accused six real implementations and refused the link on
    the very entry point its own baseline was measured from
    (doc/08_tracking/bug/simpleos_fabricated_rt_guard_weak_real_false_positive_2026-07-28.md).

    Binding is not the classifier and neither is the name; only the
    disassembled BODY is (`simpleos_trivial_body_rt_symbols`). This function
    answers "is it defined here at all", and the caller then subtracts the ones
    whose bodies are constant-return fakes. Only `U`/`u` are skipped, because an
    undefined reference is by definition not a definition.

    Changing `extract_symbols_nm` itself was rejected: it is exported
    (backend/__init__.spl:174,182) and its weak-dropping is load-bearing for
    `llvm_backend.spl`'s object symbol tables, so widening it there would change
    codegen behaviour to fix a link-guard bug."""
    var seen: {text: bool} = {}
    var names: [text] = []
    for obj in objects:
        val (nm_out, _nm_err, nm_code) = process_run("nm", [obj])
        if nm_code != 0:
            continue
        for line in nm_out.split("\n"):
            var parts: [text] = []
            for p in line.split(" "):
                if p != "":
                    parts.push(p)
            val plen = parts.len()
            if plen < 2:
                continue
            var type_code = ""
            var sym_name = ""
            if plen >= 3:
                type_code = parts[1]
                sym_name = parts[2]
            else:
                type_code = parts[0]
                sym_name = parts[1]
            if type_code == "U" or type_code == "u":
                continue
            if sym_name == "" or seen.has(sym_name):
                continue
            seen[sym_name] = true
            names.push(sym_name)
    names

fn simpleos_objdump_symbol_name(line: text) -> text:
    """`0000000000000000 <rt_foo>:` -> `rt_foo`."""
    val open_parts = line.split("<")
    if open_parts.len() < 2:
        return ""
    val close_parts = open_parts[open_parts.len() - 1].split(">")
    close_parts[0]

fn simpleos_objdump_normalized_insn(line: text) -> text:
    """`4:<tab>xor    %eax,%eax` -> `xor %eax,%eax`; "" when not an instruction.

    Operand text after a stray `:` (an x86 segment override) is dropped, which
    can only make an instruction look LESS trivial -- the safe direction."""
    if line.starts_with("Disassembly") or line.contains("file format"):
        return ""
    val colon_parts = line.split(":")
    if colon_parts.len() < 2:
        return ""
    var flat = ""
    for chunk in colon_parts[1].split("\t"):
        flat = flat + " " + chunk
    var toks: [text] = []
    for tok in flat.split(" "):
        if tok != "":
            toks.push(tok)
    toks.join(" ")

fn simpleos_riscv_operands(insn: text) -> [text]:
    """Comma-split operand list for one RISC-V instruction, spelling-agnostic.

    The two disassemblers disagree on whitespace: llvm-objdump prints
    `li a0, 0x0` (space after the comma) while GNU objdump prints `li a0,0`.
    Token-position matching -- what the x86/aarch64 branches above do -- would
    therefore work under one tool and silently fail under the other, and a
    silent classifier failure is exactly the fail-open shape this guard exists
    to remove. Rejoining and splitting on `,` makes both spellings yield the
    same list.

    A trailing GNU comment (`addi a0,a0,-1 # fff <sym+0xfc7>`) is dropped, but
    only from a token that is EXACTLY `#` -- aarch64 writes its immediates as
    an attached `#0`, and those must survive untouched."""
    var toks: [text] = []
    for tok in insn.split(" "):
        if tok != "":
            toks.push(tok)
    var rest = ""
    var i = 1
    while i < toks.len():
        if toks[i] == "#":
            break
        rest = rest + toks[i]
        i = i + 1
    var ops: [text] = []
    for op in rest.split(","):
        val t = op.trim()
        if t != "":
            ops.push(t)
    ops

fn simpleos_riscv_is_zero_reg(reg: text) -> bool:
    """`zero` (ABI name) and `x0` (numeric name) are the same hardwired zero."""
    reg == "zero" or reg == "x0"

fn simpleos_riscv_canon_reg(reg: text) -> text:
    """RISC-V ABI register spelling, normalized.

    ABI names ONLY -- `x0`/`x10`/`x2` are deliberately NOT mapped to
    `zero`/`a0`/`sp`. Both disassemblers print ABI names unless `-M numeric` is
    passed, and this guard never passes it, so the numeric aliases bought
    nothing; what they cost was measured and severe. aarch64 also has registers
    spelled `x0`/`x1`, so mapping `x0 -> zero` made this analyzer read an
    aarch64 `add x0, x0, #7` (`return arg + 7` -- real work) as "add zero to
    zero", conclude the return register was never touched, and report the
    function as fabricated. That is the false-positive direction, the one that
    blocks legitimate links and got the first version of this guard rejected.

    With ABI names only, no aarch64 or x86-64 body can ever make `a0` constant,
    so this analyzer is structurally incapable of accepting a non-RISC-V body
    -- without having to sniff the architecture. A genuine RISC-V body printed
    with `-M numeric` simply goes undetected, which is the safe direction."""
    if reg == "fp":
        return "s0"
    reg

fn simpleos_riscv_mem_base(operand: text) -> text:
    """`0x8(sp)` -> `sp`; `""` when the operand is not a base+displacement."""
    val open_parts = operand.split("(")
    if open_parts.len() < 2:
        return ""
    val close_parts = open_parts[1].split(")")
    simpleos_riscv_canon_reg(close_parts[0].trim())

fn simpleos_riscv_is_frame_base(reg: text) -> bool:
    """Stack pointer / frame pointer. Traffic through these is frame
    scaffolding; traffic through any OTHER base is real memory access and is
    refused."""
    reg == "sp" or reg == "s0"

fn simpleos_riscv_reg_is_const(consts: {text: bool}, reg: text) -> bool:
    """`zero` is constant by definition; everything else must have been proven
    constant by a preceding instruction in this same body."""
    val r = simpleos_riscv_canon_reg(reg)
    if r == "zero":
        return true
    consts.has(r) and consts[r]

fn simpleos_riscv_body_is_trivial_constant(insns: [text]) -> bool:
    """Abstract-interprets a RISC-V body and answers "does it do nothing but set
    up a frame and return a constant?".

    WHY THIS IS NOT A PER-INSTRUCTION CLASSIFIER. The x86-64/aarch64 predicate
    above works instruction-at-a-time because those ABIs materialize a constant
    return in one instruction. RISC-V does not, and the production SimpleOS
    stub objects are compiled WITHOUT -O (see the `riscv64-unknown-elf-gcc`
    invocations in `link_simpleos_riscv64` / `link_simpleos_riscv32`: no -O
    flag), so a `return 0x80000000ULL` is measured to disassemble as

        addi sp, sp, -0x10      <- frame
        sd   s0, 0x8(sp)        <- frame
        addi s0, sp, 0x10       <- frame
        li   a5, 0x1            <- constant, staged in a TEMPORARY
        slli a5, a5, 0x1f       <- still constant
        mv   a0, a5             <- constant reaches the return register
        ld   s0, 0x8(sp)        <- frame
        addi sp, sp, 0x10       <- frame
        ret

    No single instruction here says "constant return"; the fact only exists in
    the chain li -> slli -> mv. A stateless classifier scored this body 0 of 4
    on the bug's probe. Tracking which registers hold constants is the smallest
    model that can see it.

    SOUNDNESS (the fail-safe direction is what matters -- a false positive
    blocks a legitimate link, which is what got the first version of this guard
    rejected). Three independent conditions must ALL hold to return true:

      1. Every instruction was recognised. Any unknown mnemonic returns false
         immediately, so an unmodelled encoding makes the guard MISS a fake
         rather than accuse a real implementation.
      2. Memory traffic touches ONLY sp/s0. A store through any other base is
         an observable side effect, so it is real work. This is what stops a
         body like `*(int*)a0 = 5; return 0;` from being called fabricated.
      3. `a0`/`a1` -- the only registers that outlive the call -- are each
         either provably constant or never written. Provably constant means the
         constant was traced from an immediate through this body; a value
         reloaded from the stack is NOT constant, which is what stops the -O0
         shape of `return arg` (`sd a0,off(s0); ld a5,off(s0); mv a0,a5`) from
         being accused, and stops a body that computes a1 for real while
         holding a0 at a constant.

    Registers other than a0/a1 are dead at return, so their values need no
    constraint beyond having been produced by a recognised instruction.

    Never consults the symbol name, prefix, or linkage -- the body is the only
    trustworthy evidence. A hand-supplied "verified real" list was measured to
    contain `rt_dma_bytes_to_array`, which is literally `return 0;`, while
    `rt_dma_virt_of` and `rt_file_read_bytes`, which nobody listed, are real."""
    var consts: {text: bool} = {}
    var saw_return = false
    var recognized = 0
    for raw in insns:
        if raw == "":
            continue
        var toks: [text] = []
        for tok in raw.split(" "):
            if tok != "":
                toks.push(tok)
        if toks.len() == 0:
            continue
        val op = toks[0]
        val ops = simpleos_riscv_operands(raw)
        val n = ops.len()

        # --- the return itself, and true no-ops -------------------------
        if op == "ret" or op == "c.ret":
            saw_return = true
            recognized = recognized + 1
            continue
        if op == "nop" or op == "c.nop":
            recognized = recognized + 1
            continue
        if op == "jr" or op == "c.jr":
            if n == 1 and simpleos_riscv_canon_reg(ops[0]) == "ra":
                saw_return = true
                recognized = recognized + 1
                continue
            return false
        if op == "jalr":
            # `ret` is a pseudo for `jalr x0, ra, 0`, printed either as three
            # operands or with the base folded into `0x0(ra)`.
            var is_ret_form = false
            if n == 3 and simpleos_riscv_canon_reg(ops[0]) == "zero" and simpleos_riscv_canon_reg(ops[1]) == "ra":
                is_ret_form = true
            if n == 2 and simpleos_riscv_canon_reg(ops[0]) == "zero" and simpleos_riscv_mem_base(ops[1]) == "ra":
                is_ret_form = true
            if not is_ret_form:
                return false
            saw_return = true
            recognized = recognized + 1
            continue

        # --- frame traffic: stores define nothing, loads define a
        # --- NON-constant (a reloaded value is not a proven constant).
        if (op == "sd" or op == "sw" or op == "sh" or op == "sb" or
                op == "fsd" or op == "fsw" or op == "c.sdsp" or
                op == "c.swsp" or op == "c.sd" or op == "c.sw"):
            if n != 2 or not simpleos_riscv_is_frame_base(simpleos_riscv_mem_base(ops[1])):
                return false
            recognized = recognized + 1
            continue
        if (op == "ld" or op == "lw" or op == "lwu" or op == "lh" or
                op == "lhu" or op == "lb" or op == "lbu" or op == "fld" or
                op == "flw" or op == "c.ldsp" or op == "c.lwsp" or
                op == "c.ld" or op == "c.lw"):
            if n != 2 or not simpleos_riscv_is_frame_base(simpleos_riscv_mem_base(ops[1])):
                return false
            consts[simpleos_riscv_canon_reg(ops[0])] = false
            recognized = recognized + 1
            continue

        # --- constants straight out of an immediate ----------------------
        if op == "li" or op == "c.li" or op == "lui" or op == "c.lui":
            if n != 2:
                return false
            consts[simpleos_riscv_canon_reg(ops[0])] = true
            recognized = recognized + 1
            continue

        # --- register moves and unary forms: constant iff the source is ---
        if (op == "mv" or op == "c.mv" or op == "neg" or op == "not" or
                op == "sext.w" or op == "zext.b" or op == "zext.h" or
                op == "zext.w" or op == "sext.b" or op == "sext.h"):
            if n != 2:
                return false
            consts[simpleos_riscv_canon_reg(ops[0])] = simpleos_riscv_reg_is_const(consts, ops[1])
            recognized = recognized + 1
            continue

        # --- immediate ALU / shifts: constant iff the source is -----------
        if (op == "addi" or op == "addiw" or op == "andi" or op == "ori" or
                op == "xori" or op == "slli" or op == "srli" or op == "srai" or
                op == "slliw" or op == "srliw" or op == "sraiw"):
            if n == 3:
                consts[simpleos_riscv_canon_reg(ops[0])] = simpleos_riscv_reg_is_const(consts, ops[1])
                recognized = recognized + 1
                continue
            return false
        if (op == "c.addi" or op == "c.addiw" or op == "c.andi" or
                op == "c.slli" or op == "c.srli" or op == "c.srai" or
                op == "c.addi16sp"):
            # Compressed: the destination is also the source.
            if n != 2:
                return false
            val cd = simpleos_riscv_canon_reg(ops[0])
            consts[cd] = simpleos_riscv_reg_is_const(consts, cd)
            recognized = recognized + 1
            continue
        if op == "c.addi4spn":
            if n != 3:
                return false
            consts[simpleos_riscv_canon_reg(ops[0])] = false
            recognized = recognized + 1
            continue

        # --- register-register ALU: constant iff BOTH sources are ---------
        if (op == "add" or op == "addw" or op == "sub" or op == "subw" or
                op == "and" or op == "or" or op == "xor" or op == "sll" or
                op == "srl" or op == "sra" or op == "sllw" or op == "srlw" or
                op == "sraw" or op == "c.add" or op == "c.sub" or
                op == "c.and" or op == "c.or" or op == "c.xor" or
                op == "c.addw" or op == "c.subw"):
            if n == 3:
                val both = simpleos_riscv_reg_is_const(consts, ops[1]) and simpleos_riscv_reg_is_const(consts, ops[2])
                consts[simpleos_riscv_canon_reg(ops[0])] = both
                recognized = recognized + 1
                continue
            if n == 2:
                val cd2 = simpleos_riscv_canon_reg(ops[0])
                val both2 = simpleos_riscv_reg_is_const(consts, cd2) and simpleos_riscv_reg_is_const(consts, ops[1])
                consts[cd2] = both2
                recognized = recognized + 1
                continue
            return false

        # Unknown mnemonic -- branches, calls, CSR access, atomics, float
        # math, anything at all. Real work by construction.
        return false

    if not saw_return or recognized == 0:
        return false
    # `a0` must be PROVABLY constant -- not merely "never written". Accepting
    # "never written" was measured to be unsound: it is exactly the state a
    # foreign-architecture body presents (an aarch64 function writes `x0`, and
    # nothing here is called `a0`), so it turned every recognisable aarch64
    # body into a false positive. Demanding proof also means a RISC-V void stub
    # that never touches `a0` goes undetected, which is the safe direction.
    if not simpleos_riscv_reg_is_const(consts, "a0"):
        return false
    # `a1` carries the upper half of a wide return on rv32. It may be untouched
    # (narrow return), but if the body computed it for real the value escapes
    # and the function is not a constant-returner.
    if consts.has("a1") and not consts["a1"]:
        return false
    true

fn simpleos_insn_is_prefix_token(tok: text) -> bool:
    """Bare x86 instruction-prefix words that a disassembler prints AHEAD of the
    mnemonic, as separate tokens.

    Measured: GNU objdump renders clang's inter-function padding as
    `data16 data16 data16 cs nopw 0x0(%rax,%rax,1)`, so the first token is
    `data16`, not `nopw`. Treating token 0 as the mnemonic classified that
    padding as real work, which alone was enough to make every -O2
    constant-return body score 0 under GNU objdump -- the padding sits inside
    the preceding function's disassembly range. llvm-objdump prints the same
    bytes as `nopw %cs:(%rax,%rax)`, one token.

    Skipping these can only EXPOSE the underlying mnemonic; if that mnemonic is
    not one of the handful recognised below, the instruction still classifies as
    real work. Segment names are included because objdump prints a bare `cs`
    (etc.) for a prefixed instruction while an actual segment-relative operand
    is written `%cs:...` and stays attached to its operand."""
    (tok == "data16" or tok == "data32" or tok == "addr16" or tok == "addr32" or
        tok == "cs" or tok == "ds" or tok == "es" or tok == "fs" or
        tok == "gs" or tok == "ss")

fn simpleos_x86_canon_mnemonic(op: text) -> text:
    """x86 mnemonic with its operand-size suffix folded away.

    The two disassemblers disagree on the suffix: llvm-objdump prints
    `xorl`/`movl`/`retq`/`pushq` where GNU objdump prints `xor`/`mov`/`ret`/
    `push`. Matching one spelling made the whole x86-64 channel inert under the
    other -- and llvm-objdump is exactly what `find_objdump_portable` selects on
    Linux, so the architecture this guard's baseline was measured on was the one
    detecting nothing. A clang x86-64 object holding ten constant-return
    functions scored 0. Same defect class as the RISC-V blindness fixed in
    70c86f4b77b, on the most-used path
    (doc/08_tracking/bug/simpleos_fabricated_rt_guard_x86_classifier_inert_2026-07-28.md).

    An explicit table, NOT a generic trailing-b/w/l/q strip. A blind strip would
    also rewrite unrelated x86 and aarch64 mnemonics (`bl` -> `b`, `sarl` ->
    `sar`, `stlrb` -> `stlr`), and every rewrite is another chance to turn real
    work into something this function recognises as trivial. Only mnemonics
    already handled below are folded, so an unlisted spelling stays unlisted and
    classifies as real work -- the safe direction."""
    if op == "retq" or op == "retl" or op == "retw":
        return "ret"
    if op == "leaveq" or op == "leavel":
        return "leave"
    if op == "pushq" or op == "pushl" or op == "pushw":
        return "push"
    if op == "popq" or op == "popl" or op == "popw":
        return "pop"
    if (op == "movq" or op == "movl" or op == "movw" or op == "movb" or
            op == "movabs" or op == "movabsq"):
        return "mov"
    if op == "xorq" or op == "xorl" or op == "xorw" or op == "xorb":
        return "xor"
    if op == "nopq" or op == "nopl" or op == "nopw" or op == "nopb":
        return "nop"
    op

fn simpleos_insn_operands(toks: [text], start: i64) -> [text]:
    """Comma-split operand list for one x86-64/aarch64 instruction,
    spelling-agnostic.

    Exists for the same reason `simpleos_riscv_operands` does: llvm-objdump
    prints `xorl %eax, %eax` and `mov x0, xzr` (space after the comma) while GNU
    objdump prints `xor %eax,%eax`. Token-POSITION matching -- what this branch
    used to do, reading `toks[1]` and comparing it to `%eax,%eax` -- therefore
    worked under exactly one tool and silently failed under the other. Rejoining
    from `start` and splitting on `,` makes both spellings yield the same list,
    so a future toolchain spacing change cannot re-open the hole.

    Trailing disassembler comments are dropped: llvm-objdump x86 appends
    `# imm = 0x100`, and both aarch64 backends append `// =1`. Only a token that
    is EXACTLY `#` starts an x86/RISC-V comment -- aarch64 writes immediates as
    an attached `#0x1`, and those must survive untouched.

    A memory operand containing commas (`0x0(%rax,%rax,1)`) splits into several
    entries. That is harmless and safe: every check below compares operands
    against exact register spellings, so a split memory operand can only fail to
    match, never match something it should not."""
    var rest = ""
    var i = start
    while i < toks.len():
        if toks[i] == "#" or toks[i].starts_with("//"):
            break
        rest = rest + toks[i]
        i = i + 1
    var ops: [text] = []
    for op in rest.split(","):
        val t = op.trim()
        if t != "":
            ops.push(t)
    ops

fn simpleos_a64_ret_reg(reg: text) -> bool:
    """aarch64 return register, either width."""
    reg == "w0" or reg == "x0"

fn simpleos_a64_const_src(operand: text) -> bool:
    """An aarch64 `mov` source that is constant BY CONSTRUCTION: a literal
    immediate (`#0x1`, `#-0x1`) or the hardwired zero register (`wzr`/`xzr`).

    Both halves are load-bearing and were measured. clang -O2 emits
    `mov x0, xzr` for `return 0;`, so refusing the zero register would drop the
    aarch64 channel from 10 detections to 9. Accepting a plain register source
    (`mov w0, w1`) is the opposite error -- that is `return arg`, real work --
    and the old token-position match did exactly that, since it only ever looked
    at the DESTINATION token `w0,`. Neither is accepted here."""
    operand.starts_with("#") or operand == "wzr" or operand == "xzr"

fn simpleos_trivial_insn_class(insn: text) -> i64:
    """0 = does real work, 1 = frame/no-op scaffolding, 2 = materializes a
    constant return value. Covers x86-64 and aarch64 forms.

    RISC-V is deliberately NOT handled here. Its constant returns span several
    instructions and stage through temporaries, so no instruction-at-a-time
    verdict can see them; `simpleos_riscv_body_is_trivial_constant` analyses
    the whole body instead, and `simpleos_body_is_trivial_constant` dispatches
    to it.

    Mnemonic and operands are BOTH normalized before matching (see
    `simpleos_x86_canon_mnemonic` / `simpleos_insn_operands`) so the verdict is
    identical under llvm-objdump and GNU objdump. Verified against both on
    clang -O0 and -O2 objects for x86-64 and aarch64; that dual-tool check is
    what the RISC-V fix proved is mandatory, and skipping it here is what left
    this channel inert.

    Unknown mnemonics deliberately classify as 0 (does real work), so an
    unrecognised encoding makes the guard MISS a fake rather than accuse a real
    implementation. Every error here is a false negative by construction.

    Never consults the symbol name, prefix, or linkage -- only the body."""
    var toks: [text] = []
    for tok in insn.split(" "):
        if tok != "":
            toks.push(tok)
    var head = 0
    while head < toks.len() and simpleos_insn_is_prefix_token(toks[head]):
        head = head + 1
    if head >= toks.len():
        return 1
    val op = simpleos_x86_canon_mnemonic(toks[head])
    val ops = simpleos_insn_operands(toks, head + 1)
    val n = ops.len()
    if (op == "endbr64" or op == "endbr32" or op == "ret" or op == "leave" or
            op == "nop" or op == "hlt"):
        return 1
    if op == "push" or op == "pop":
        return if n == 1 and ops[0] == "%rbp": 1 else: 0
    if op == "mov":
        # x86-64 AT&T frame setup.
        if n == 2 and ops[0] == "%rsp" and ops[1] == "%rbp":
            return 1
        # x86-64 AT&T immediate into the return register.
        if n == 2 and ops[0].starts_with("$") and (ops[1] == "%eax" or ops[1] == "%rax"):
            return 2
        # aarch64 immediate / zero register into the return register.
        if n == 2 and simpleos_a64_ret_reg(ops[0]) and simpleos_a64_const_src(ops[1]):
            return 2
        return 0
    if op == "xor":
        return if n == 2 and ops[0] == ops[1] and (ops[0] == "%eax" or ops[0] == "%rax"): 2 else: 0
    if op == "movz" or op == "movn":
        return if n >= 2 and simpleos_a64_ret_reg(ops[0]) and ops[1].starts_with("#"): 2 else: 0
    0

pub fn simpleos_body_is_trivial_constant(insns: [text]) -> bool:
    """Does this already-normalized instruction sequence do nothing but set up a
    frame and return a constant?

    Split out of `simpleos_trivial_body_rt_symbols` so the predicate can be
    tested against recorded disassembly without a cross-toolchain object on
    disk. The guard shipped with no test at all, which is precisely how it went
    a full architecture (RISC-V) without anyone noticing it detected nothing
    there (doc/08_tracking/bug/simpleos_fabricated_rt_guard_riscv_classifier_inert_2026-07-28.md).

    Two analyzers, each sound on its own, ORed together. The instruction-class
    one covers x86-64/aarch64, where a constant return is a single recognisable
    instruction. The RISC-V one abstract-interprets the body, because there a
    constant return spans a chain (li -> slli -> mv) that no per-instruction
    verdict can see. ORing is safe precisely BECAUSE each is individually
    conservative: both answer false on anything they cannot fully account for,
    so feeding an x86 body to the RISC-V analyzer (or the reverse) yields false
    rather than a wrong accusation.

    No arch is detected up front, deliberately. Sniffing the architecture would
    be one more thing that can silently mis-fire; asking both analyzers cannot."""
    var trivial = true
    var constants = 0
    var count = 0
    for insn in insns:
        if insn == "":
            continue
        count = count + 1
        val cls = simpleos_trivial_insn_class(insn)
        if cls == 2:
            constants = constants + 1
        elif cls == 0:
            trivial = false
    if trivial and count > 0 and constants <= 1:
        return true
    simpleos_riscv_body_is_trivial_constant(insns)

pub fn simpleos_trivial_body_rt_symbols(objects: [text]) -> [text]:
    """Defined `rt_*` whose body only sets up a frame and returns a constant.

    GAP 1. A presence-only check ("is it defined outside auto_stubs.c?") is
    structurally blind to the hand-written `return 0;` fakes in
    `baremetal_stubs.c` / `baremetal_boot_stdout.c`: those are strong `T`
    symbols in the shipped kernel whose bodies disassemble to
    `xor %eax,%eax; ret` (`rt_pool_safepoint`, `rt_stderr_flush`, the whole
    `rt_arm_elf64_pt_load_*` family). They are exactly as dangerous as the
    generated weak ones and only a body-level predicate can see them.

    A genuine constant-returning implementation trips this too; that is
    intended. Such a symbol must be justified in
    `simpleos_rt_symbol_is_optional_backend` or carried in the baseline, never
    accepted silently."""
    val objdump = find_objdump_portable()
    if objdump == "":
        return []
    var out: [text] = []
    var seen: {text: bool} = {}
    for obj in objects:
        # `-r` is a SOUNDNESS requirement, not a convenience. A relocated
        # immediate disassembles as a plain literal: `rt_baremetal_heap_start`
        # is `return (uint64_t)(uintptr_t)_heap;` and prints as
        # `movl $0x0, %eax; retq` -- indistinguishable from `return 0;` until
        # the relocation is shown. Classifying it as fabricated would refuse a
        # legitimate link, the false-positive direction that got the first
        # version of this guard rejected. With `-r` the disassembler emits a
        # relocation line inside the body, which normalizes to a token like
        # `R_X86_64_32` -- an unrecognised mnemonic -- so the existing
        # unknown-mnemonic fail-safe classifies the whole body as real work.
        # That is exactly right: a body carrying a relocation references a
        # link-time address, and the nil stubs this guard hunts never do.
        val (dis, _derr, dcode) = process_run(objdump, ["-d", "-r", "--no-show-raw-insn", obj])
        if dcode != 0:
            continue
        var sym = ""
        var body: [text] = []
        for raw in dis.split("\n"):
            val line = raw.trim()
            if line.ends_with(">:") and line.contains(" <"):
                if sym.starts_with("rt_") and not seen.has(sym) and simpleos_body_is_trivial_constant(body):
                    seen[sym] = true
                    out.push(sym)
                sym = simpleos_objdump_symbol_name(line)
                body = []
                continue
            if sym == "":
                continue
            val insn = simpleos_objdump_normalized_insn(line)
            if insn == "":
                continue
            body.push(insn)
        if sym.starts_with("rt_") and not seen.has(sym) and simpleos_body_is_trivial_constant(body):
            seen[sym] = true
            out.push(sym)
    out

fn simpleos_entry_key(output: text) -> text:
    """Per-entry baseline key: the output binary's basename."""
    val parts = output.split("/")
    parts[parts.len() - 1]

fn simpleos_fabricated_baseline(entry_key: text) -> {text: bool}:
    """Shrink-only ratchet baseline for one entry point.

    `config/simpleos_fabricated_rt_baseline.sdn`, one `<entry> <rt_symbol>` per
    line, `#` comments. A missing file means an EMPTY baseline, i.e. maximum
    strictness -- deleting the file can never weaken the gate.

    This is NOT the allowlist. The allowlist
    (`simpleos_rt_symbol_is_optional_backend`) is a permanent semantic claim
    that nil is the correct answer; the baseline is a dated, per-entry,
    shrink-only record of debt that must go away. Keeping them in separate
    files is what stops migration pressure from converting an audited allowlist
    into a rubber stamp."""
    simpleos_baseline_entries("config/simpleos_fabricated_rt_baseline.sdn", entry_key)

fn simpleos_simple_symbol_baseline(entry_key: text) -> {text: bool}:
    """Shrink-only ratchet baseline for fabricated `lib__*` / `os__*` bodies.

    Deliberately a SEPARATE file from the `rt_*` baseline: the two record
    different debts (a missing freestanding C implementation vs. a pure-Simple
    body that failed to reach the link), and mixing them lets migration
    pressure on one quietly grow the other. Same shrink-only contract: a
    missing file means an EMPTY baseline, so deleting it can never weaken the
    gate."""
    simpleos_baseline_entries("config/simpleos_fabricated_lib_baseline.sdn", entry_key)

fn simpleos_baseline_entries(path: text, entry_key: text) -> {text: bool}:
    """Read one `<entry> <symbol>` ratchet baseline file, filtered to `entry_key`."""
    var allowed: {text: bool} = {}
    if not file_exists(path):
        return allowed
    for raw in file_read(path).split("\n"):
        val line = raw.trim()
        if line == "" or line.starts_with("#"):
            continue
        var toks: [text] = []
        for tok in line.split(" "):
            if tok != "":
                toks.push(tok)
        if toks.len() < 2:
            continue
        if toks[0] == entry_key:
            allowed[toks[1]] = true
    allowed

pub fn simpleos_check_no_forbidden_allocators(user_objects: [text], real_objects: [text]) -> Result<bool, text>:
    """WP-15 (aerospace hardening plan) call-site wrapper: reads the live env
    gate inputs (same `flight_closure` predicate as
    `simpleos_check_no_fabricated_rt_stubs` below), extracts the `nm -u`
    undefined-symbol references over the SAME `user_objects` + `real_objects`
    closure that guard receives, and enforces via
    `flight_allocator_scan_for_profile` (allocator_symbol_scan.spl, the
    spec-covered seam). Non-flight profiles: no behavior change. Sits
    alongside the fabricated-stub guard at each of its four call sites."""
    var closure: [text] = []
    for obj in user_objects:
        closure.push(obj)
    for obj in real_objects:
        closure.push(obj)
    flight_allocator_scan_for_profile(env_get("SIMPLE_SAFETY_PROFILE") ?? "", (env_get("SIMPLE_NO_STUB_FALLBACK") ?? "") == "1", object_undefined_symbol_names(closure))

pub fn simpleos_check_no_fabricated_rt_stubs(entry_key: text, user_objects: [text], real_objects: [text]) -> Result<bool, text>:
    """Task #97 guard, ported from the Rust seed
    (linker/native_binary/stubs.rs:474-505), which the pure-Simple SimpleOS
    link path never had -- which is why this class shipped silently.

    auto_stubs.c fabricates ~4023 WEAK definitions that return NIL_VALUE (0x3)
    so a freestanding link never fails on an unresolved cross-module ref. For
    an optional accelerator that is intended; for a real ABI symbol it links
    clean and only corrupts data at runtime. `rt_array_copy` had no
    freestanding implementation, so in the guest EVERY `var x = <array-typed
    place read>` -- which MIR lowers through it (mir_lowering_stmts.spl:240-254)
    -- returned 0. An untagged 0 fails the inline array reader's `tag == 1`
    check, which then yields its nil default, so every nested `.len()` read 0
    with no fault and no diagnostic.

    Fails the link rather than warning: a warning is what the weak stub already
    is. `SIMPLE_NO_STUB_FALLBACK=1` also disables the debt baselines: strict
    builds must contain no non-optional fabricated body, including previously
    measured debt. There is deliberately NO env bypass (the seed has
    SIMPLE_ALLOW_UNRESOLVED_RT=1); the in-tree escape hatch is
    simpleos_rt_symbol_is_optional_backend, which is greppable and reviewable,
    whereas an env var set once by a lane script is invisible silence again.

    `real_objects` must NOT include the auto-stub object -- being satisfied
    only by that object is precisely the condition being detected.

    CLASSIFY BY BODY, NEVER BY LINKAGE OR BY NAME. A definition in
    `real_objects` counts as real iff it is defined there (at ANY binding,
    weak included -- `simpleos_defined_symbols_any_binding`) AND its
    disassembled body is not a constant-return fake
    (`simpleos_trivial_body_rt_symbols`). Both halves are load-bearing:
    dropping weak definitions accused six real `baremetal_stubs.c`
    implementations, and trusting presence alone missed the hand-written
    `return 0;` fakes that sit right next to them in the same file
    (`rt_dma_bytes_to_array` is literally `return 0; /* not called on x86_64
    boot path */` while `rt_memcpy` two lines away is a real loop). Only the
    body separates them."""
    val strict_no_stub_fallback = (env_get("SIMPLE_NO_STUB_FALLBACK") ?? "") == "1"
    # WP-10 (aerospace hardening plan): a "flight closure" link -- the
    # critical assurance profile active (SIMPLE_SAFETY_PROFILE), or the
    # existing SIMPLE_NO_STUB_FALLBACK=1 escape hatch -- forbids fabricated
    # weak-stub bodies: zero baseline exemption, so ANY fabricated symbol
    # (including previously-baselined debt) is a hard link failure instead
    # of a fabricated NIL-returning stub. Reuses the WP-3 canonical policy
    # resolver rather than a hardcoded string compare.
    val flight_closure_profile = env_get("SIMPLE_SAFETY_PROFILE") ?? ""
    val flight_closure = strict_no_stub_fallback or strictness_for_profile_name(flight_closure_profile).at_least(AssuranceStrictness.Critical)

    # One disassembly pass over `real_objects` serves both channels.
    val trivial_names = simpleos_trivial_body_rt_symbols(real_objects)
    var trivial: {text: bool} = {}
    for name in trivial_names:
        trivial[name] = true

    var real: {text: bool} = {}
    for name in simpleos_defined_symbols_any_binding(real_objects):
        if not trivial.has(name):
            real[name] = true
    for obj in user_objects:
        for symbol in extract_symbols_nm(obj):
            real[symbol.name] = true

    val referenced_names = simpleos_undefined_rt_symbols(user_objects)
    var referenced: {text: bool} = {}
    for name in referenced_names:
        referenced[name] = true

    var fabricated: [text] = []
    var counted: {text: bool} = {}
    # Channel 1 -- satisfied only by auto_stubs.c's weak NIL_VALUE stub.
    for name in referenced_names:
        if simpleos_rt_symbol_is_optional_backend(name):
            continue
        if real.has(name) or counted.has(name):
            continue
        counted[name] = true
        fabricated.push(name)
    # Channel 2 (GAP 1) -- hand-written trivial bodies. Channel 1 now sees most
    # of these too (a trivial body is subtracted from `real` above), but this
    # channel still catches the case where a user object ALSO defines the name,
    # which puts it back in `real` presence-wise while the stub it actually
    # binds is still a fake. Restricted to symbols the user objects actually
    # reference, so --gc-sections'd stubs stay out of the report and the
    # baseline tracks only what this entry really binds. Reuses the single
    # disassembly pass computed above -- no second objdump sweep.
    for name in trivial_names:
        if simpleos_rt_symbol_is_optional_backend(name):
            continue
        if counted.has(name) or not referenced.has(name):
            continue
        counted[name] = true
        fabricated.push(name)

    # Channel 3 -- fabricated PURE-SIMPLE bodies (`lib__*` / `os__*`).
    #
    # Channels 1 and 2 only ever looked at `rt_*`, so every Simple method and
    # free function has been unprotected since this guard was written. The stub
    # generator does not care about the prefix: any name still undefined when
    # the link set is assembled gets an 8-byte weak `xor %eax,%eax; ret`. For a
    # `lib__*` body that is not a missing backend, it is a DROPPED
    # IMPLEMENTATION -- there is no such thing as an "optional" pure-Simple
    # function, which is why this channel has no allowlist counterpart to
    # `simpleos_rt_symbol_is_optional_backend`, only the shrink-only baseline.
    #
    # Detected by reference-vs-definition rather than by body: a name the
    # closure references and NOTHING in the closure (or the real objects)
    # defines is, by construction, exactly what the stub generator will
    # fabricate. That makes this channel independent of which fabricator ran,
    # and it costs one `nm -u` pass -- no second objdump sweep.
    #
    # Definitions are collected at ANY binding for the same reason channel 1
    # does: weak linkage does NOT imply fabricated.
    val simple_referenced = simpleos_undefined_simple_module_symbols(user_objects)
    var simple_novel: [text] = []
    if simple_referenced.len() > 0:
        var simple_defined: {text: bool} = {}
        for name in simpleos_defined_symbols_any_binding(user_objects):
            simple_defined[name] = true
        for name in simpleos_defined_symbols_any_binding(real_objects):
            simple_defined[name] = true
        val simple_baseline = if flight_closure: {} else: simpleos_simple_symbol_baseline(entry_key)
        var simple_counted: {text: bool} = {}
        for name in simple_referenced:
            if simple_defined.has(name) or simple_baseline.has(name):
                continue
            if simple_counted.has(name):
                continue
            simple_counted[name] = true
            simple_novel.push(name)
    if simple_novel.len() > 0:
        simple_novel.sort()
        return Err("SimpleOS freestanding link refused for entry '{entry_key}': {simple_novel.len()} pure-Simple symbol(s) are newly fabricated -- the closure REFERENCES them but nothing DEFINES them, so the stub generator emits an 8-byte weak nil-returning body and the guest silently takes the false/zero branch at every call site instead of failing here: {simple_novel.join(\", \")}. A pure-Simple function is never optional: find why its body did not reach the link (a stale cached object still referencing a pre-move mangled name is the known cause -- purge the object cache and rebuild) and fix that. This entry's fabricated set must stay a SUBSET of config/simpleos_fabricated_lib_baseline.sdn, which is shrink-only and records pre-existing debt, never new debt.")

    val baseline = if flight_closure: {} else: simpleos_fabricated_baseline(entry_key)
    var novel: [text] = []
    for name in fabricated:
        if not baseline.has(name):
            novel.push(name)
    if novel.len() == 0:
        return Ok(true)
    novel.sort()
    Err("SimpleOS freestanding link refused for entry '{entry_key}': {novel.len()} rt_* extern(s) are newly fabricated -- they resolve to a zero/nil-returning stub (auto_stubs.c's weak NIL_VALUE definition, or a hand-written constant-return body) and would silently return nil at runtime instead of failing here (task #97): {novel.join(\", \")}. This entry's fabricated set must stay a SUBSET of config/simpleos_fabricated_rt_baseline.sdn. Implement each in the arch's boot/baremetal_stubs.c, or add it to simpleos_rt_symbol_is_optional_backend with a written rationale naming the caller that treats nil as 'unavailable'. Do NOT add it to the baseline -- the baseline is shrink-only and records pre-existing debt, never new debt.")

fn simpleos_module_init_symbols(user_objects: [text]) -> [text]:
    """Collect defined `__module_init` / `__module_init_<prefix>` symbols
    across the user's compiled objects, sorted + deduped by name.

    Mirrors the naming convention `module_init_symbol()` computes on the Rust
    seed (src/compiler_rust/compiler/src/codegen/common_backend.rs, restored
    by commit 4aab3c435b7) and the discovery step of the seed linker's
    `generate_init_caller` (src/compiler_rust/compiler/src/pipeline/native_project/linker.rs:786-812),
    which sorts+dedups by symbol name rather than tracking a real dependency
    graph -- there is no cross-module init ORDER guarantee beyond that, on
    either backend. `extract_symbols_nm` already filters out undefined (U/u)
    and weak (W/w/V/v) symbols, so only concretely DEFINED init functions are
    collected here.

    Pure-Simple MIR lowering emits one init body per module for supported
    direct-call `val`/`var` initializers and preserves their source order
    inside that body. This collector still sorts separate module init symbols
    by name; cross-module dependency ordering remains unsupported. See
    doc/08_tracking/bug/native_multiple_module_initializers_declaration_order_2026-07-19.md."""
    var seen: {text: bool} = {}
    var names: [text] = []
    for obj in user_objects:
        for symbol in extract_symbols_nm(obj):
            var name = symbol.name
            if name.starts_with("___module_init"):
                name = name.substring(1)
            if name == "__module_init" or name.starts_with("__module_init_"):
                if not seen.has(name):
                    seen[name] = true
                    names.push(name)
    names.sort()
    names

fn simpleos_module_init_caller_source(init_names: [text]) -> text:
    """Generate the freestanding C source defining `__simple_call_module_inits`,
    which calls every discovered `__module_init_*` function.

    Always emits a concrete (non-weak) definition, even with zero names, so
    the `.weak __simple_call_module_inits` reference in
    examples/09_embedded/simple_os/arch/x86_64/boot/crt0.s and the
    `extern void __simple_call_module_inits(void) __attribute__((weak));`
    guard in baremetal_stubs.c resolve to a real function instead of staying
    permanently unresolved-weak (today both always skip the call). Each
    callee is itself declared `weak` inside this generated translation unit
    so a partial object set still links. Mirrors the non-clang-cl branch of
    generate_init_caller (linker.rs:844-855)."""
    var code = "// Auto-generated: calls all __module_init_* functions\n"
    for name in init_names:
        code = code + "extern void __attribute__((weak)) {name}(void);\n"
    code = code + "void __simple_call_module_inits(void) {\n"
    for name in init_names:
        code = code + "    if ({name}) {name}();\n"
    code = code + "}\n"
    code

fn link_simpleos_arm64(user_objects: [text], output: text, verbose: bool, opt_level: i64) -> Result<text, text>:
    val pid = getpid()
    val crt_o = "build/os/simpleos_arm64_crt0_{pid}.o"
    val stubs_o = "build/os/simpleos_arm64_baremetal_stubs_{pid}.o"
    match compile_simpleos_arm64("examples/09_embedded/simple_os/arch/arm64/boot/crt0.S", crt_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass
    match compile_simpleos_arm64("examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c", stubs_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass

    # GAP 3: this path previously never called the guard at all, and it links
    # no auto_stubs.c -- so every fake here is a real body in
    # arm64/boot/baremetal_stubs.c and ONLY the body-level predicate can see
    # it. arm64/os_entry is the worst entry in the audit.
    match simpleos_check_no_fabricated_rt_stubs(simpleos_entry_key(output), user_objects, [crt_o, stubs_o]):
        case Err(e):
            file_delete(crt_o)
            file_delete(stubs_o)
            return Err(e)
        case Ok(_): pass
    match simpleos_check_no_forbidden_allocators(user_objects, [crt_o, stubs_o]):
        case Err(e):
            file_delete(crt_o)
            file_delete(stubs_o)
            return Err(e)
        case Ok(_): pass

    val configured_script = env_get("SIMPLE_NATIVE_BUILD_LINKER_SCRIPT") ?? ""
    val linker_script = if configured_script != "": configured_script else: "examples/09_embedded/simple_os/arch/arm64/linker.ld"
    var args: [text] = ["-T", linker_script, "-nostdlib", "--gc-sections", "-o", output, crt_o, stubs_o]
    val spl_start = simpleos_spl_start_symbol(user_objects)
    if spl_start != "":
        args.push("--defsym=spl_start={spl_start}")
    for obj in user_objects:
        args.push(obj)
    val (_out, err, code) = process_run("ld.lld", args)
    file_delete(crt_o)
    file_delete(stubs_o)
    if code != 0:
        return Err("SimpleOS ARM64 freestanding link failed: {err}")
    if verbose:
        print "[llvm-link] SimpleOS ARM64 freestanding executable: {output}"
    Ok(output)

fn compile_simpleos_x86_64_asm(src: text, obj: text) -> Result<text, text>:
    val (_out, err, code) = process_run("cc", [
        "-c", "-m64", "-ffreestanding", "-fno-pic", "-fno-pie", "-mno-red-zone",
        "-o", obj, src
    ])
    if code != 0:
        return Err("SimpleOS x86_64 asm compile failed for {src}: {err}")
    Ok(obj)

fn link_simpleos_x86_64(user_objects: [text], output: text, verbose: bool, opt_level: i64) -> Result<text, text>:
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    if target == "simpleos" or target == "simpleos-x86_64" or target == "x86_64-simpleos" or target == "x86_64-unknown-simpleos" or target == "x86_64-unknown-simpleos-elf":
        val sysroot = simpleos_x86_64_sysroot()
        val support = simpleos_x86_64_user_link_inputs(sysroot)
        for path in support:
            if not file_exists(path):
                return Err("SimpleOS x86_64 sysroot is incomplete: missing {path}; run sh src/os/port/llvm/sysroot.shs or set SIMPLE_SYSROOT")
        val configured_script = env_get("SIMPLE_LINKER_SCRIPT") ?? ""
        val linker_script = if configured_script != "": configured_script else: "{sysroot}/share/simpleos/simpleos.ld"
        if not file_exists(linker_script):
            return Err("SimpleOS x86_64 sysroot is incomplete: missing {linker_script}; run sh src/os/port/llvm/sysroot.shs or set SIMPLE_SYSROOT")

        val entry_result = compile_entry_point_c([], getpid(), verbose, opt_level)
        val entry_object = match entry_result:
            case Ok(path): path
            case Err(e): return Err("SimpleOS x86_64 entry compilation failed: {e}")

        val support0 = support[0]
        var user_args: [text] = [
            "-T", linker_script, "-nostdlib", "-static", "--gc-sections",
            "-o", output, support0, entry_object
        ]
        for obj in user_objects:
            user_args.push(obj)
        user_args.push("--start-group")
        user_args.push(support[1])
        user_args.push(support[2])
        user_args.push("--end-group")
        val linker = if file_exists("/usr/bin/ld.lld"): "/usr/bin/ld.lld" else: "ld.lld"
        val (_user_out, user_err, user_code) = process_run(linker, user_args)
        file_delete(entry_object)
        if user_code != 0:
            return Err("SimpleOS x86_64 user executable link failed: {user_err}")
        if verbose:
            print "[llvm-link] SimpleOS x86_64 user executable: {output}"
        return Ok(output)

    # Legacy `*-unknown-none[-elf]` and filename-selected kernel builds keep
    # their boot CRT/stub path. The canonical `*-simpleos` target above is a
    # filesystem-launched user process and must use the installed sysroot.
    val pid = getpid()
    val crt_o = "build/os/simpleos_x86_64_crt0_{pid}.o"
    val stubs_o = "build/os/simpleos_x86_64_baremetal_stubs_{pid}.o"
    val registry_o = "build/os/simpleos_x86_64_freestanding_value_registry_{pid}.o"
    val type_o = "build/os/simpleos_x86_64_type_stubs_{pid}.o"
    val auto_o = "build/os/simpleos_x86_64_auto_stubs_{pid}.o"
    val init_c = "build/os/simpleos_x86_64_module_init_{pid}.c"
    val init_o = "build/os/simpleos_x86_64_module_init_{pid}.o"

    match compile_simpleos_x86_64_asm("examples/09_embedded/simple_os/arch/x86_64/boot/crt0.s", crt_o):
        case Err(e): return Err(e)
        case Ok(_): pass
    match compile_simpleos_x86_64_c("examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c", stubs_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass
    match compile_simpleos_x86_64_c("examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_value_registry.c", registry_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass
    match compile_simpleos_x86_64_c("examples/09_embedded/simple_os/arch/x86_64/boot/type_stubs.c", type_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass
    match compile_simpleos_x86_64_c("examples/09_embedded/simple_os/arch/x86_64/boot/auto_stubs.c", auto_o, opt_level):
        case Err(e): return Err(e)
        case Ok(_): pass

    # crt0.s (`.weak __simple_call_module_inits`) and baremetal_stubs.c
    # (`extern void __simple_call_module_inits(void) __attribute__((weak));`)
    # both only ever reference this symbol as unresolved-weak, so it is
    # always skipped. Emit a concrete definition that aggregates every
    # discovered `__module_init_*` from the user's objects (see
    # simpleos_module_init_symbols / simpleos_module_init_caller_source
    # above) so the aggregation mechanism exists on the pure-Simple path the
    # same way it does on the Rust seed's generate_init_caller.
    val module_init_names = simpleos_module_init_symbols(user_objects)
    file_write(init_c, simpleos_module_init_caller_source(module_init_names))
    match compile_simpleos_x86_64_c(init_c, init_o, opt_level):
        case Err(e):
            file_delete(init_c)
            return Err(e)
        case Ok(_): pass
    file_delete(init_c)

    match simpleos_check_no_fabricated_rt_stubs(simpleos_entry_key(output), user_objects, [crt_o, stubs_o, registry_o, type_o, init_o]):
        case Err(e):
            file_delete(crt_o)
            file_delete(stubs_o)
            file_delete(type_o)
            file_delete(auto_o)
            file_delete(init_o)
            return Err(e)
        case Ok(_): pass
    match simpleos_check_no_forbidden_allocators(user_objects, [crt_o, stubs_o, registry_o, type_o, init_o]):
        case Err(e):
            file_delete(crt_o)
            file_delete(stubs_o)
            file_delete(type_o)
            file_delete(auto_o)
            file_delete(init_o)
            return Err(e)
        case Ok(_): pass

    val linker_script_env = env_get("SIMPLE_NATIVE_BUILD_LINKER_SCRIPT") ?? ""
    val linker_script = if linker_script_env != "":
        linker_script_env
    else:
        "examples/09_embedded/simple_os/arch/x86_64/linker.ld"

    var args: [text] = [
        "-T", linker_script,
        "-nostdlib", "--gc-sections", "-o", output,
        crt_o, stubs_o, registry_o, type_o, auto_o, init_o
    ]
    for obj in user_objects:
        args.push(obj)
    val (_link_out, link_err, link_code) = process_run("ld.lld", args)
    file_delete(crt_o)
    file_delete(stubs_o)
    file_delete(registry_o)
    file_delete(type_o)
    file_delete(auto_o)
    file_delete(init_o)
    if link_code != 0:
        return Err("SimpleOS x86_64 freestanding link failed: {link_err}")
    if verbose:
        print "[llvm-link] SimpleOS x86_64 freestanding executable: {output}"
    Ok(output)

pub fn link_simpleos_x86_64_external(user_objects: [text], output: text) -> Result<text, text>:
    link_simpleos_x86_64(user_objects, output, false, 2)

fn link_simpleos_riscv64(user_objects: [text], output: text, verbose: bool) -> Result<text, text>:
    var is_smoke_entry = false
    val is_display_smoke = output.contains("simpleos_riscv64_display_smoke")
    val uses_freestanding_runtime = is_display_smoke or output.contains("simpleos_riscv64_host_gpu_probe")
    # TODO(rv64-real-exit-facade): remove legacy stub-source generation once
    # every remaining smoke target uses the architecture-owned QEMU exit path.
    # Tracked in doc/08_tracking/bug/rv64_host_gpu_real_runtime_exit_facade_2026-07-12.md.
    for obj in user_objects:
        if obj.contains("smoke_entry"):
            is_smoke_entry = true
    val entry_s = "build/os/simpleos_riscv64_entry.S"
    val entry_o = "build/os/simpleos_riscv64_entry.o"
    val stub_c = "build/os/simpleos_riscv64_link_stubs.c"
    val stub_o = "build/os/simpleos_riscv64_link_stubs.o"
    val init_c = "build/os/simpleos_riscv64_module_init.c"
    val init_o = "build/os/simpleos_riscv64_module_init.o"
    val entry_symbol = if is_smoke_entry: "spl_start" else: "boot_main"
    var entry_src = ".section .text.entry,\"ax\",@progbits\n"
    entry_src = entry_src + ".globl __simple_riscv_entry\n"
    entry_src = entry_src + "__simple_riscv_entry:\n"
    entry_src = entry_src + "  mv s0, a0\n"
    entry_src = entry_src + "  mv s1, a1\n"
    entry_src = entry_src + "  la sp, _stack_top\n"
    entry_src = entry_src + "  la t0, _sbss\n"
    entry_src = entry_src + "  la t1, _ebss\n"
    entry_src = entry_src + "1:\n"
    entry_src = entry_src + "  bgeu t0, t1, 2f\n"
    entry_src = entry_src + "  sd zero, 0(t0)\n"
    entry_src = entry_src + "  addi t0, t0, 8\n"
    entry_src = entry_src + "  j 1b\n"
    entry_src = entry_src + "2:\n"
    # RV64 kernel and userspace objects use the LP64D ABI; enable F/D and start
    # with the ABI-default rounding mode before entering compiled S-mode code.
    entry_src = entry_src + "  li t0, 0x6000\n"
    entry_src = entry_src + "  csrc sstatus, t0\n"
    entry_src = entry_src + "  li t0, 0x2000\n"
    entry_src = entry_src + "  csrs sstatus, t0\n"
    entry_src = entry_src + "  csrw fcsr, zero\n"
    entry_src = entry_src + "  mv a0, s0\n"
    entry_src = entry_src + "  mv a1, s1\n"
    entry_src = entry_src + "  call " + entry_symbol + "\n"
    entry_src = entry_src + "3:\n"
    entry_src = entry_src + "  wfi\n"
    entry_src = entry_src + "  j 3b\n"
    file_write(entry_s, entry_src)
    val (entry_out, entry_err, entry_code) = process_run("riscv64-unknown-elf-gcc", [
        "-c", "-march=rv64gc", "-mabi=lp64d", "-ffreestanding", "-nostdlib",
        "-o", entry_o, entry_s
    ])
    if entry_code != 0:
        return Err("SimpleOS RISC-V entry compilation failed: {entry_out}{entry_err}")

    var stub_src = "#include <stdint.h>\n"
    stub_src = stub_src + "#define UART0 ((volatile uint8_t*)0x10000000UL)\n"
    stub_src = stub_src + "#define SIFIVE_TEST ((volatile uint32_t*)0x100000UL)\n"
    stub_src = stub_src + "void rt_riscv_uart_put(uint64_t b){while(!(UART0[5]&0x20)){} UART0[0]=(uint8_t)b;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_qemu_ram_base(void){return 0x80000000ULL;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_qemu_ram_size(void){return 128ULL*1024ULL*1024ULL;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_qemu_reserved_end(void){return 0x80200000ULL;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_qemu_heap_start(void){return 0x80400000ULL;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_qemu_heap_size(void){return 16ULL*1024ULL*1024ULL;}\n"
    stub_src = stub_src + "int rt_riscv_noalloc_pmm_init(uint64_t a,uint64_t b,uint64_t c,uint64_t d){(void)a;(void)b;(void)c;(void)d;return 1;}\n"
    # `__simple_call_module_inits` used to be defined here as an always-empty
    # `{}` body. `src/os/kernel/arch/riscv64/boot.spl` declares it
    # `extern fn __simple_call_module_inits()` and CALLS it unconditionally
    # (not weakly) -- so the symbol must resolve for every riscv64 link, in
    # both the `stub_o` and `uses_freestanding_runtime` branches below. It is
    # now emitted unconditionally as its own object (init_c/init_o, see
    # simpleos_module_init_symbols / simpleos_module_init_caller_source
    # above) so both branches keep linking AND the aggregator actually
    # collects any `__module_init_*` the user's objects define, instead of
    # hard-coding an empty body regardless of what those objects contain.
    stub_src = stub_src + "void serial_println(uint64_t msg){const char*s=(const char*)(uintptr_t)msg;if(!s)return;while(*s)rt_riscv_uart_put((uint64_t)*s++);rt_riscv_uart_put(13);rt_riscv_uart_put(10);}\n"
    stub_src = stub_src + "void log_raw_println(uint64_t msg){serial_println(msg);}\n"
    stub_src = stub_src + "void rt_riscv_wfi_forever(void){for(;;){__asm__ volatile(\"wfi\");}}\n"
    stub_src = stub_src + "int64_t rt_riscv64_syscall(uint64_t id,uint64_t x0,uint64_t x1,uint64_t x2,uint64_t x3,uint64_t x4){register uint64_t a0 __asm__(\"a0\")=x0;register uint64_t a1 __asm__(\"a1\")=x1;register uint64_t a2 __asm__(\"a2\")=x2;register uint64_t a3 __asm__(\"a3\")=x3;register uint64_t a4 __asm__(\"a4\")=x4;register uint64_t a7 __asm__(\"a7\")=id;__asm__ volatile(\"ecall\":\"+r\"(a0):\"r\"(a1),\"r\"(a2),\"r\"(a3),\"r\"(a4),\"r\"(a7):\"memory\");return (int64_t)a0;}\n"
    stub_src = stub_src + "uint64_t rt_riscv64_csr_read(uint32_t c){uint64_t v=0;switch(c){case 0x100:__asm__ volatile(\"csrr %0, sstatus\":\"=r\"(v));break;case 0x104:__asm__ volatile(\"csrr %0, sie\":\"=r\"(v));break;case 0x105:__asm__ volatile(\"csrr %0, stvec\":\"=r\"(v));break;case 0x140:__asm__ volatile(\"csrr %0, sscratch\":\"=r\"(v));break;case 0x141:__asm__ volatile(\"csrr %0, sepc\":\"=r\"(v));break;case 0x142:__asm__ volatile(\"csrr %0, scause\":\"=r\"(v));break;case 0x143:__asm__ volatile(\"csrr %0, stval\":\"=r\"(v));break;case 0x144:__asm__ volatile(\"csrr %0, sip\":\"=r\"(v));break;case 0x180:__asm__ volatile(\"csrr %0, satp\":\"=r\"(v));break;case 0xC00:__asm__ volatile(\"csrr %0, cycle\":\"=r\"(v));break;case 0xC01:__asm__ volatile(\"csrr %0, time\":\"=r\"(v));break;case 0xC02:__asm__ volatile(\"csrr %0, instret\":\"=r\"(v));break;}return v;}\n"
    stub_src = stub_src + "void rt_riscv64_csr_write(uint32_t c,uint64_t v){switch(c){case 0x100:__asm__ volatile(\"csrw sstatus,%0\"::\"r\"(v):\"memory\");break;case 0x104:__asm__ volatile(\"csrw sie,%0\"::\"r\"(v):\"memory\");break;case 0x105:__asm__ volatile(\"csrw stvec,%0\"::\"r\"(v):\"memory\");break;case 0x140:__asm__ volatile(\"csrw sscratch,%0\"::\"r\"(v):\"memory\");break;case 0x141:__asm__ volatile(\"csrw sepc,%0\"::\"r\"(v):\"memory\");break;case 0x180:__asm__ volatile(\"csrw satp,%0\"::\"r\"(v):\"memory\");break;}}\n"
    stub_src = stub_src + "void rt_riscv64_csr_set(uint32_t c,uint64_t v){if(c==0x100)__asm__ volatile(\"csrs sstatus,%0\"::\"r\"(v):\"memory\");else if(c==0x104)__asm__ volatile(\"csrs sie,%0\"::\"r\"(v):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_csr_clear(uint32_t c,uint64_t v){if(c==0x100)__asm__ volatile(\"csrc sstatus,%0\"::\"r\"(v):\"memory\");else if(c==0x104)__asm__ volatile(\"csrc sie,%0\"::\"r\"(v):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_sfence_vma_addr(uint64_t v){__asm__ volatile(\"sfence.vma %0,zero\"::\"r\"(v):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_sfence_vma_asid(uint64_t v){__asm__ volatile(\"sfence.vma zero,%0\"::\"r\"(v):\"memory\");}\n"
    stub_src = stub_src + "uint64_t rt_riscv64_read_tp(void){uint64_t v;__asm__ volatile(\"mv %0,tp\":\"=r\"(v));return v;}\n"
    stub_src = stub_src + "void rt_riscv64_write_tp(uint64_t v){__asm__ volatile(\"mv tp,%0\"::\"r\"(v):\"memory\");}\n"
    stub_src = stub_src + "uint64_t rt_riscv64_read_sp(void){uint64_t v;__asm__ volatile(\"mv %0,sp\":\"=r\"(v));return v;}\n"
    stub_src = stub_src + "uint64_t rt_riscv64_read_gp(void){uint64_t v;__asm__ volatile(\"mv %0,gp\":\"=r\"(v));return v;}\n"
    stub_src = stub_src + "void rt_riscv64_fence_i(void){__asm__ volatile(\"fence.i\":::\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_cbo_clean(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbom\\ncbo.clean 0(%0)\\n.option pop\"::\"r\"(a):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_cbo_inval(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbom\\ncbo.inval 0(%0)\\n.option pop\"::\"r\"(a):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_cbo_flush(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbom\\ncbo.flush 0(%0)\\n.option pop\"::\"r\"(a):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_cbo_zero(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicboz\\ncbo.zero 0(%0)\\n.option pop\"::\"r\"(a):\"memory\");}\n"
    stub_src = stub_src + "void rt_riscv64_prefetch_r(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbop\\nprefetch.r 0(%0)\\n.option pop\"::\"r\"(a));}\n"
    stub_src = stub_src + "void rt_riscv64_prefetch_w(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbop\\nprefetch.w 0(%0)\\n.option pop\"::\"r\"(a));}\n"
    stub_src = stub_src + "void rt_riscv64_prefetch_i(uint64_t a){__asm__ volatile(\".option push\\n.option arch,+zicbop\\nprefetch.i 0(%0)\\n.option pop\"::\"r\"(a));}\n"
    # FAIL-CLOSED TARGET FOR THE `unknown_N` DEFSYM ALIASES.
    #
    # `symbol_to_operand` (src/compiler/50.mir/_MirLoweringExpr/
    # method_calls_literals.spl ~3396) names a callee it could not resolve
    # `unknown_<symbol-id>`. That reaches the linker as an undefined symbol --
    # which is loud and correct. The `--defsym=unknown_N=<real function>` block
    # below used to silence it by aliasing each one onto an UNRELATED kernel
    # function with an incompatible signature (`_uart_put`, `_boot_banner`,
    # `log_raw_println`, ...), so a call the compiler failed to resolve
    # executed some other function's code with whatever happened to be in the
    # argument registers. That is fail-open: exit 0, a booting kernel, and
    # silently wrong behaviour.
    #
    # The aliases now all point HERE instead. The link still succeeds (the same
    # symbol names are still defined, so this is not a build-breaking change and
    # needs no measurement of which unknown_N are live), but reaching one at
    # runtime prints a message on the UART and halts, instead of running an
    # unrelated function. A lost call is now observable at the exact moment it
    # is taken. See doc/08_tracking/bug/
    # simpleos_riscv64_defsym_unknown_symbol_aliasing_2026-07-28.md.
    stub_src = stub_src + "void __simple_unresolved_call_trap(void){const char*m=\"\\r\\nFATAL: unresolved call (unknown_N) reached at runtime; MIR lowering failed to resolve a callee\\r\\n\";while(*m)rt_riscv_uart_put((uint64_t)(unsigned char)*m++);for(;;){__asm__ volatile(\"wfi\");}}\n"
    stub_src = stub_src + "typedef struct{int64_t error;int64_t value;} RtRiscv64SbiRet;\n"
    stub_src = stub_src + "RtRiscv64SbiRet rt_riscv64_sbi_call(uint64_t ext,uint64_t fid,uint64_t x0,uint64_t x1,uint64_t x2,uint64_t x3,uint64_t x4,uint64_t x5){register uint64_t a0 __asm__(\"a0\")=x0;register uint64_t a1 __asm__(\"a1\")=x1;register uint64_t a2 __asm__(\"a2\")=x2;register uint64_t a3 __asm__(\"a3\")=x3;register uint64_t a4 __asm__(\"a4\")=x4;register uint64_t a5 __asm__(\"a5\")=x5;register uint64_t a6 __asm__(\"a6\")=fid;register uint64_t a7 __asm__(\"a7\")=ext;__asm__ volatile(\"ecall\":\"+r\"(a0),\"+r\"(a1):\"r\"(a2),\"r\"(a3),\"r\"(a4),\"r\"(a5),\"r\"(a6),\"r\"(a7):\"memory\");RtRiscv64SbiRet r={(int64_t)a0,(int64_t)a1};return r;}\n"
    stub_src = stub_src + "void rt_qemu_exit_success(void){SIFIVE_TEST[0]=0x5555U;for(;;){}}\n"
    stub_src = stub_src + "uint64_t rt_riscv_nvfs_probe(void){return 1;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_smf_cli_probe(void){return 1;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_smf_cli_load(void){return 1;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_smf_gui_probe(void){return 1;}\n"
    stub_src = stub_src + "uint64_t rt_riscv_native_gui_process_render(void){return 1;}\n"
    stub_src = stub_src + "uint64_t riscv64_hardening_boot_canary_marker(void){return 0;}\n"
    stub_src = stub_src + "uint64_t sandbox_boot_apply_embedded_riscv64(void){return 0;}\n"
    file_write(stub_c, stub_src)
    if not uses_freestanding_runtime:
        val (stub_out, stub_err, stub_code) = process_run("riscv64-unknown-elf-gcc", [
            "-c", "-march=rv64gc", "-mabi=lp64d", "-ffreestanding", "-nostdlib",
            "-o", stub_o, stub_c
        ])
        if stub_code != 0:
            return Err("SimpleOS RISC-V stub compilation failed: {stub_out}{stub_err}")

    val runtime_o = "build/os/simpleos_riscv64_freestanding_runtime.o"
    if uses_freestanding_runtime:
        val (runtime_out, runtime_err, runtime_code) = process_run("riscv64-unknown-elf-gcc", [
            "-c", "-march=rv64gc", "-mabi=lp64d", "-mcmodel=medany", "-ffreestanding", "-nostdlib",
            "-DSIMPLE_BOOT_MINIMAL=1", "-DSIMPLE_RUNTIME_NO_ENTRY=1", "-DSIMPLE_RUNTIME_NO_WEAK_HEAP=1",
            "-o", runtime_o, "src/os/kernel/arch/riscv64/boot/freestanding_runtime.c"
        ])
        if runtime_code != 0:
            return Err("SimpleOS RISC-V runtime compilation failed: {runtime_out}{runtime_err}")

    # Always compiled (both stub_o and freestanding_runtime branches link
    # this in) because boot.spl's `__simple_call_module_inits()` call is an
    # unconditional (non-weak) extern reference. `-mcmodel=medany` matches
    # the Rust seed's generate_init_caller (linker.rs:882-891): the
    # `if (__module_init_x) __module_init_x();` null-check pattern
    # materializes each callee's ADDRESS as a value (not just a PC-relative
    # call), which overflows medlow's +-2GB-from-zero window once this
    # freestanding kernel is linked high (0x80200000+, see linker_script).
    val module_init_names = simpleos_module_init_symbols(user_objects)
    file_write(init_c, simpleos_module_init_caller_source(module_init_names))
    val (init_out, init_err, init_code) = process_run("riscv64-unknown-elf-gcc", [
        "-c", "-march=rv64gc", "-mabi=lp64d", "-mcmodel=medany", "-ffreestanding", "-nostdlib",
        "-o", init_o, init_c
    ])
    file_delete(init_c)
    if init_code != 0:
        return Err("SimpleOS RISC-V module-init caller compilation failed: {init_out}{init_err}")

    # Task #97 guard. Deliberately NOT added until `simpleos_trivial_insn_class`
    # could actually see RISC-V: it recognised only x86-64 and aarch64
    # mnemonics, so `li a0,0; ret` classified as "does real work" and the guard
    # detected ZERO of four unambiguous fakes in a probe object. Calling it here
    # in that state would have been false assurance -- the same fail-open shape
    # the guard exists to remove
    # (doc/08_tracking/bug/simpleos_fabricated_rt_guard_riscv_classifier_inert_2026-07-28.md).
    #
    # rv64 links no auto_stubs.c, so channel 1 has nothing to find here and
    # channel 2 (trivial bodies) is the only channel that applies -- which is
    # precisely why the classifier had to be fixed first rather than the call
    # site added first.
    val riscv_real_objects = if uses_freestanding_runtime:
        [entry_o, runtime_o, init_o]
    else:
        [entry_o, stub_o, init_o]
    match simpleos_check_no_fabricated_rt_stubs(simpleos_entry_key(output), user_objects, riscv_real_objects):
        case Err(e): return Err(e)
        case Ok(_): pass
    match simpleos_check_no_forbidden_allocators(user_objects, riscv_real_objects):
        case Err(e): return Err(e)
        case Ok(_): pass

    val configured_script = env_get("SIMPLE_NATIVE_BUILD_LINKER_SCRIPT") ?? ""
    val linker_script = if configured_script != "": configured_script else: "src/os/kernel/arch/riscv64/linker.ld"
    var args: [text] = [
        "-m", "elf64lriscv",
        "--no-relax",
        "-nostdlib",
        "-T", linker_script,
        "--entry=__simple_riscv_entry"
    ]
    val spl_start = simpleos_spl_start_symbol(user_objects)
    if spl_start != "":
        args.push("--defsym=spl_start={spl_start}")
    if not is_smoke_entry and not uses_freestanding_runtime:
        # Every unknown_N resolves to the trap, NOT to an unrelated function.
        # See __simple_unresolved_call_trap in the stub source above for why.
        var unknown_idx = 0
        while unknown_idx <= 12:
            args = args.push("--defsym=unknown_{unknown_idx}=__simple_unresolved_call_trap")
            unknown_idx = unknown_idx + 1
    args = args.push(entry_o)
    for obj in user_objects:
        args = args.push(obj)
    if uses_freestanding_runtime:
        args = args.push(runtime_o)
    else:
        args = args.push(stub_o)
    args = args.push(init_o)
    args = args.push("-o")
    args = args.push(output)

    if verbose:
        val joined_args = args.join(" ")
        print "[llvm-link] SimpleOS RISC-V link: ld.lld {joined_args}"
    val (stdout, stderr, code) = process_run("ld.lld", args)
    if code != 0:
        return Err("SimpleOS RISC-V link failed: {stdout}{stderr}")
    Ok(output)

fn link_simpleos_riscv32(user_objects: [text], output: text, verbose: bool) -> Result<text, text>:
    val stub_c = "build/os/simpleos_riscv32_link_stubs.c"
    val stub_o = "build/os/simpleos_riscv32_link_stubs.o"
    var stub_src = "#include <stdint.h>\n"
    stub_src = stub_src + "#define UART0 ((volatile uint8_t*)0x10000000UL)\n"
    stub_src = stub_src + "void rt_riscv_uart_put(uint64_t b){while(!(UART0[5]&0x20)){} UART0[0]=(uint8_t)b;}\n"
    stub_src = stub_src + "long long rt_pool_safepoint(void){return 0;}\n"
    file_write(stub_c, stub_src)
    val (stub_out, stub_err, stub_code) = process_run("riscv64-unknown-elf-gcc", [
        "-c", "-march=rv32imafdc", "-mabi=ilp32d", "-ffreestanding", "-nostdlib",
        "-o", stub_o, stub_c
    ])
    if stub_code != 0:
        return Err("SimpleOS RV32 stub compilation failed: {stub_out}{stub_err}")

    # Task #97 guard -- see the matching call in `link_simpleos_riscv64` for why
    # this could not be added before `simpleos_trivial_insn_class` learned
    # RISC-V. On rv32 the classifier has to cope with a 64-bit return arriving
    # in the a0/a1 PAIR (`li a0,0; li a1,0; ret`), which is one constant spread
    # over two writes; `simpleos_riscv_ret_reg_rank` is what keeps that from
    # looking like two independent constants. That matters immediately: the
    # `rt_pool_safepoint` stub written into `stub_c` a few lines above is
    # literally `return 0;` and is exactly the shape being detected.
    match simpleos_check_no_fabricated_rt_stubs(simpleos_entry_key(output), user_objects, [stub_o]):
        case Err(e): return Err(e)
        case Ok(_): pass
    match simpleos_check_no_forbidden_allocators(user_objects, [stub_o]):
        case Err(e): return Err(e)
        case Ok(_): pass

    val linker_script_env = env_get("SIMPLE_NATIVE_BUILD_LINKER_SCRIPT") ?? ""
    val linker_script = if linker_script_env != "":
        linker_script_env
    else:
        "src/os/kernel/arch/riscv32/linker.ld"
    var args: [text] = [
        "-m", "elf32lriscv",
        "--no-relax",
        "-nostdlib",
        "-T", linker_script
    ]
    for obj in user_objects:
        args = args.push(obj)
    args = args.push(stub_o)
    args = args.push("-o")
    args = args.push(output)

    if verbose:
        val joined_args = args.join(" ")
        print "[llvm-link] SimpleOS RV32 link: ld.lld {joined_args}"
    val (stdout, stderr, code) = process_run("ld.lld", args)
    if code != 0:
        return Err("SimpleOS RV32 link failed: {stdout}{stderr}")
    Ok(output)

# ============================================================================
# Exports
# ============================================================================
