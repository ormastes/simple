# Runtime Compiler - Compiles C runtime sources to object files
#
# Provides compile_runtime_objects() which compiles the C runtime
# (runtime.c, runtime_native.c, runtime_rocm.c, runtime_thread.c, runtime_memtrack.c, runtime_timestamp.c, runtime_fork.c)
# into object files that can be linked with LLVM-compiled user code.
#
# Usage:
#   val objects = compile_runtime_objects(verbose)
#   match objects:
#       case Ok(paths): link_with(paths)
#       case Err(msg): report_error(msg)

use compiler.backend.io_compat.{backend_shell_tuple}
use compiler.common.mir_target_context.{mir_target_context_normalize_arch}
use compiler.backend.runtime_object_cache_windows.{runtime_windows_cache_toolchain_v1, runtime_windows_cached_compile_and_publish_v1, runtime_windows_cache_publish_batch_v1}
use compiler.backend.runtime_xray_context_policy_v1.{runtime_xray_context_validate_v1, runtime_xray_context_cache_suffix_v1, runtime_xray_context_flags_v1}
use common.types.{Enabled}
use compiler.backend.runtime_tagged_callback_owner_v1.{runtime_tagged_callback_owner_v1}
use compiler.backend.runtime_c_compile_pool_v1.{runtime_c_compile_workers_v1, runtime_c_compile_parallel_batch_v1, runtime_c_cache_publish_object_v1}
use compiler.backend.runtime_object_cache_posix.{runtime_posix_cache_fingerprint_command_v1}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.io_runtime.{host_arch, host_os, env_get_nullable, file_copy, file_exists, file_delete, file_read, file_write, file_hash_sha256_or_empty, process_run}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.disk_bound.{disk_bound_enforce, disk_bound_cap_bytes}
