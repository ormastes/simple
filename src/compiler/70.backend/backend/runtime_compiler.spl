# Runtime Compiler - Compiles C runtime sources to object files
#
# Provides compile_runtime_objects() which compiles the C runtime
# (runtime.c, runtime_native.c, runtime_rocm.c, runtime_thread.c, runtime_memtrack.c, runtime_timestamp.c, runtime_fork.c)
# into object files that can be linked with LLVM-compiled user code.
#
# Usage:
#   val objects = compile_runtime_objects(verbose)
#   match objects:
#       case Ok(paths): link_with(paths)
#       case Err(msg): report_error(msg)

use compiler.backend.backend.io_compat.{backend_shell_tuple}
use compiler.common.mir_target_context.{mir_target_context_normalize_arch}
use std.io_runtime.{host_arch, host_os, env_get_nullable, file_exists, file_delete, process_run}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.env.platform.{is_windows as platform_is_windows}

extern fn rt_path_absolute(path: text) -> text?
# Signatures mirror the canonical declarations in
# src/lib/nogc_sync_mut/io_runtime.spl (rt_process_run:21, rt_file_write_text:54,
# rt_file_exists:56, rt_file_delete:58) and
# src/lib/nogc_sync_mut/io/sysinfo_ops.spl:6 (rt_getpid). All five are called
# below (lines 185-202) but were never declared in this module, which is the
# HIR `unresolved name` fatal. All five are runtime-BACKED (none appears in
# scripts/check/unbacked_extern_baseline.txt).
extern fn rt_getpid() -> i64
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

# ============================================================================
# Platform Helpers
# ============================================================================

# FAIL-OPEN FIX (2026-09-02): read ONLY `OS` and returned false when unset --
# a silent "not Windows" under a stripped environment (where a bootstrap runs).
# Delegate to the single resolver in std.nogc_sync_mut.env.platform, which
# consults the in-process rt_platform_name() primitive first.
fn _is_windows() -> bool:
    platform_is_windows()

fn _is_msvc_cc(cc: text) -> bool:
    val normalized = cc.lower().replace("\\", "/")
    val parts = normalized.split("/")
    val driver = parts[parts.len() - 1]
    driver == "cl" or driver == "cl.exe" or driver == "clang-cl" or driver == "clang-cl.exe"

fn _is_mingw() -> bool:
    val linker_flavor = env_get_nullable("SIMPLE_LINKER_FLAVOR")
    if linker_flavor == "msvc":
        return false
    if linker_flavor == "gnu":
        return true
    val windows_abi = env_get_nullable("SIMPLE_WINDOWS_ABI")
    if windows_abi == "msvc":
        return false
    if windows_abi == "gnu":
        return true
    val msystem = env_get_nullable("MSYSTEM")
    msystem != "" and msystem != nil

fn _msys_drive_path(p: text) -> text:
    """On Windows, rewrite an MSYS/Cygwin '/d/foo' path to native 'd:/foo'.

    TMPDIR/TMP/TEMP under Git Bash / MSYS2 hold POSIX-form paths. Every
    consumer below hands the result to a NATIVE Windows tool via
    rt_process_run (no shell, so no MSYS argv conversion happens), and such a
    tool cannot open '/d/...' at all.

    Measured 2026-09-02 on the MSVC bootstrap lane, clang-cl 18.1.8, same
    probe source, argv differing only in path form:
      clang-cl /nologo /c /Fo/d/.../ccprobe.o /d/.../ccprobe.c
        -> "no such file or directory: '/d/.../ccprobe.c'", rc=1
      clang-cl /nologo /c /Fod:\...\ccprobe.o d:\...\ccprobe.c
        -> rc=0, 753-byte object
    This is why _cc_verify_compiles rejected EVERY candidate and
    find_c_compiler() returned "", producing "No C compiler found. Install
    clang or gcc." from llvm_native_link_orchestrator.spl:125 — the Stage 2
    receiver gate's real failure.

    Drive letters are case-insensitive on Windows, so no case folding is
    needed. CROSS-PLATFORM IMPACT: guarded by _is_windows(); on every other
    platform this returns its argument unchanged, and '/d/foo' is a perfectly
    ordinary POSIX path that must NOT be rewritten.
    """
    if not _is_windows():
        return p
    if p.len() < 3:
        return p
    if not p.starts_with("/"):
        return p
    if p.substring(2, 3) != "/":
        return p
    val drive = p.substring(1, 2)
    if drive == "/" or drive == "":
        return p
    "{drive}:{p.substring(2)}"

fn _get_temp_dir() -> text:
    val tmpdir = env_get_nullable("TMPDIR")
    if tmpdir != "" and tmpdir != nil:
        return _msys_drive_path(tmpdir)
    val tmp = env_get_nullable("TMP")
    if tmp != "" and tmp != nil:
        return _msys_drive_path(tmp)
    val temp = env_get_nullable("TEMP")
    if temp != "" and temp != nil:
        return _msys_drive_path(temp)
    if _is_windows():
        return "C:/Windows/Temp"
    "/tmp"

fn _obj_ext() -> text:
    if _is_windows() and not _is_mingw():
        ".obj"
    else:
        ".o"

fn runtime_compile_trace_enabled() -> bool:
    (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1"

# ============================================================================
# C Compiler Discovery
# ============================================================================

pub struct HostedCCompilerPlan:
    requires_cross: bool
    supported: bool
    command: text

fn hosted_c_arch_kind(arch: text) -> text:
    if arch == "riscv64" or arch == "riscv64gc" or arch == "rv64" or arch == "rv64gc":
        return "riscv64"
    val normalized = mir_target_context_normalize_arch(arch)
    if normalized == "x86_64" or normalized == "aarch64":
        return normalized
    ""

fn hosted_c_target_os_matches(target: text, host_os_name: text) -> bool:
    if not target.contains("-"):
        return true
    if host_os_name == "linux":
        return target.ends_with("-linux-gnu")
    if host_os_name == "macos" or host_os_name == "darwin":
        return target.ends_with("-apple-darwin")
    if host_os_name == "windows":
        return target.ends_with("-pc-windows-msvc")
    if host_os_name == "freebsd":
        return target.ends_with("-unknown-freebsd")
    false

pub fn hosted_c_compiler_plan(target: text, host_os_name: text, host_arch_name: text) -> HostedCCompilerPlan:
    """Classify hosted C compilation without enabling unsupported cross targets."""
    if target == "" or target == "host" or target == "native":
        return HostedCCompilerPlan(requires_cross: false, supported: true, command: "")
    val target_arch_text = if target.contains("-"): target.split("-")[0] else: target
    val target_arch = hosted_c_arch_kind(target_arch_text)
    val host_kind = hosted_c_arch_kind(host_arch_name)
    val os_matches = hosted_c_target_os_matches(target, host_os_name)
    val linux_to_mingw = host_os_name == "linux" and target.ends_with("-pc-windows-gnu")
    val requires_cross = target_arch != "" and host_kind != "" and
        (target_arch != host_kind or not os_matches)
    if target_arch == "" or host_kind == "" or (not os_matches and not linux_to_mingw):
        return HostedCCompilerPlan(requires_cross: requires_cross, supported: false, command: "")
    if not requires_cross:
        return HostedCCompilerPlan(requires_cross: false, supported: true, command: "")
    if linux_to_mingw:
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "x86_64-w64-mingw32-gcc")
    if host_os_name == "linux" and target_arch == "aarch64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "aarch64-linux-gnu-gcc")
    if host_os_name == "linux" and target_arch == "riscv64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "riscv64-linux-gnu-gcc")
    HostedCCompilerPlan(requires_cross: true, supported: false, command: "")

pub fn hosted_cross_c_compiler_name(target: text, host_os_name: text, host_arch_name: text) -> text:
    val plan = hosted_c_compiler_plan(target, host_os_name, host_arch_name)
    if plan.requires_cross and plan.supported:
        return plan.command
    ""

fn find_c_compiler() -> text:
    """Find a C compiler on the system.

    Tries SIMPLE_CC env var first, then platform-specific discovery.
    Returns the command name or empty string if none found.
    """
    val target = env_get_nullable("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    val plan = hosted_c_compiler_plan(target, host_os(), host_arch())
    if not plan.supported:
        return ""

    # User override via env var, after target admission.
    val simple_cc = env_get_nullable("SIMPLE_CC")
    if simple_cc != "" and simple_cc != nil:
        return simple_cc

    if plan.requires_cross:
        val (out, err, code) = backend_shell_tuple("command -v {plan.command} 2>/dev/null")
        if code == 0:
            for path in out.split("\n"):
                val resolved = path.trim()
                if resolved != "":
                    return resolved
        return ""

    if _is_windows():
        return _find_c_compiler_windows()

    # Unix: check well-known paths first
    if file_exists("/usr/bin/clang"):
        return "/usr/bin/clang"
    if file_exists("/usr/bin/gcc"):
        return "/usr/bin/gcc"
    if file_exists("/usr/bin/cc"):
        return "/usr/bin/cc"

    val candidates = ["clang", "clang-18", "clang-17", "clang-16", "gcc", "cc"]
    for candidate in candidates:
        val (out, err, code) = backend_shell_tuple("which {candidate} 2>/dev/null")
        if code == 0:
            return candidate
    ""

fn _cc_verify_compiles(cc: text) -> bool:
    """VERIFY a candidate C compiler by executing it on a trivial translation
    unit and checking the exit status AND the produced object file.

    A bare `where`/`which` hit is not evidence the compiler works: on this
    lane a PATH-shadowed MinGW gcc passed `where gcc` while its cc1.exe
    crashed on every input with no output at all (Git-for-Windows DLLs
    shadowing MSYS2's), and the llc bug this lane started from was the same
    exists-but-never-executed probe shape. Never assume; execute."""
    val tmp = _get_temp_dir()
    # getpid(), NOT the bare extern rt_getpid(): `rt_getpid` is not declared
    # `extern fn` anywhere in this file, so under native codegen `{pid}`
    # interpolated an opaque handle as the literal text `<value:0x34d4>`.
    # `<` and `>` are ILLEGAL in a Windows filename, so rt_file_write_text
    # below failed for EVERY candidate, _cc_verify_compiles returned false
    # four times, and find_c_compiler() returned "" -- the real
    # `reason=stage2-struct-receiver-failed` on the MSVC lane (measured
    # 2026-09-02). The typed wrapper was already imported at the top of this
    # file and simply unused. Third instance of the undeclared-extern
    # silent-value class; see
    # doc/08_tracking/bug/unregistered_extern_silent_nil_2026-08-01.md.
    # CROSS-PLATFORM: on Unix `<value:0x...>` is a legal filename, so the
    # probe worked there; the numeric name is strictly cleaner with no
    # behaviour change.
    val pid = getpid()
    # Staging names, not durable artifacts: the write-temp-then-rename idiom's
    # temp half. Nothing here is ever reused across runs -- the probe MUST
    # execute every time (a cached verdict would call a compiler healthy after
    # it broke, which is the exact incident this function exists to catch), so
    # there is no durable name to content-key. The pid only keeps two concurrent
    # probes from clobbering each other's file; the .tmp suffix marks it as
    # transient. See scripts/check/check-no-pid-keyed-build-artifacts.shs.
    # The .c / .o suffix must stay LAST: both clang and cl.exe select the input
    # language from the file extension, so a trailing .tmp would make the probe
    # unbuildable on every platform.
    val src = "{tmp}/simple-cc-verify.{pid}.tmp.c"
    val obj = "{tmp}/simple-cc-verify.{pid}.tmp.o"
    if not rt_file_write_text(src, "int main(void) { return 0; }\n"):
        # UNGATED, exactly like the REJECTED branch below and for the same
        # reason its own comment already gives: gating this behind
        # SIMPLE_COMPILER_TRACE meant the only lane that ever hits it never
        # printed it. The resulting silence was read as "every `where` probe
        # failed" and cost a full diagnosis cycle on 2026-09-02.
        print "[CC-VERIFY] {cc}: REJECTED could not write probe source {src}"
        return false
    var args: [text] = []
    if _is_msvc_cc(cc):
        args = ["/nologo", "/c", "/Fo{obj}", src]
    else:
        args = ["-c", "-o", obj, src]
    val (out, err, code) = rt_process_run(cc, args)
    val ok = code == 0 and rt_file_exists(obj)
    if runtime_compile_trace_enabled():
        print "[CC-VERIFY] {cc}: exit={code} obj_exists={ok}"
    elif not ok:
        # A failing probe is the thing worth reporting, and gating it behind a
        # trace flag meant the only lane that ever hits it never printed it.
        print "[CC-VERIFY] {cc}: REJECTED exit={code} src={src} obj={obj}"
        print "[CC-VERIFY] {cc}: stderr={err}"
    rt_file_delete(src)
    rt_file_delete(obj)
    ok

fn _find_c_compiler_windows() -> text:
    """Find a C compiler on Windows (MSVC cl.exe or MinGW gcc/clang).

    Every candidate is verified by actually compiling a trivial file
    (_cc_verify_compiles) — a `where` hit alone selects nothing."""
    # MinGW: prefer gcc/clang
    if _is_mingw():
        val mingw_candidates = ["gcc", "clang", "cc"]
        for candidate in mingw_candidates:
            val (out, err, code) = backend_shell_tuple("where {candidate} 2>nul")
            if code == 0 and _cc_verify_compiles(candidate):
                return candidate

    # clang-cl BEFORE cl.exe on the MSVC lane. cl.exe passes the trivial
    # _cc_verify_compiles probe and then cannot compile the C runtime at all:
    # measured 2026-09-01 on cl.exe 19.44.35228, src/runtime/runtime.c yields
    # C1189 ("C atomic support is not enabled" — stdatomic needs BOTH /std:c11
    # and /experimental:c11atomics), then C2099 non-constant initializers, then
    # C2143/C2091 on the GNU `__attribute__(...)` the runtime uses throughout.
    # clang-cl compiles the same file clean with the flags below. clang-cl is
    # also the compiler the stage-2 candidate itself was built with, so probing
    # the candidate with a DIFFERENT compiler than built it is its own defect.
    # Windows-only ordering change: the MinGW branch above and the Unix path in
    # find_c_compiler are untouched.
    val msvc_candidates = ["clang-cl", "cl.exe"]
    for candidate in msvc_candidates:
        val (mout, merr, mcode) = backend_shell_tuple("where {candidate} 2>nul")
        if mcode == 0 and _cc_verify_compiles(candidate):
            return candidate

    # Try clang/gcc on PATH (works in both MSVC and MinGW)
    val candidates = ["clang", "gcc"]
    for candidate in candidates:
        val (out, err, code) = backend_shell_tuple("where {candidate} 2>nul")
        if code == 0 and _cc_verify_compiles(candidate):
            return candidate

    # Returning "" here yields the bare message "No C compiler found. Install
    # clang or gcc." at two DIFFERENT call sites with identical text, and names
    # neither the candidates tried nor the temp dir the probe used. That cost a
    # full bootstrap cycle to re-diagnose. Always say what was attempted.
    print "[cc-detect] no C compiler verified on Windows."
    print "[cc-detect] temp dir: {_get_temp_dir()}"
    print "[cc-detect] tried: clang-cl, cl.exe, clang, gcc (each `where` + a real compile)"
    print "[cc-detect] set SIMPLE_CC to override, or SIMPLE_COMPILER_TRACE=1 for per-candidate exit codes"
    ""

# ============================================================================
# Runtime Source Directory Discovery
# ============================================================================

fn _runtime_dir_walk_up(start: text) -> text:
    """Walk upward from an absolute path looking for src/runtime/runtime.c.

    Returns the matching `<root>/src/runtime` or "" when no ancestor holds it.
    Used for both the executable location and the cwd so that resolution does
    not depend on how deep inside (or outside) the tree the tool was invoked.
    """
    if start.len() == 0 or not start.starts_with("/"):
        return ""
    val parts = start.split("/")
    var depth = parts.len()
    while depth > 0:
        var prefix = ""
        var i = 0
        while i < depth:
            if parts[i] != "":
                prefix = "{prefix}/{parts[i]}"
            i = i + 1
        if prefix != "":
            if file_exists("{prefix}/src/runtime/runtime.c"):
                return "{prefix}/src/runtime"
        depth = depth - 1
    ""

fn find_runtime_source_dir() -> text:
    """Find the runtime source directory, independent of the current directory.

    Order: SIMPLE_PROJECT_ROOT, then src/runtime/ directly under cwd, then an
    upward walk from the running executable's own path, then an upward walk
    from cwd. The executable walk is what makes this cwd-independent: the
    deployed binary lives at <root>/bin/release/<triple>/simple, so any
    fixed-depth `dirname` chain (the previous approach) lands on <root>/bin and
    misses the tree entirely.
    Returns the path or empty string if not found.
    """
    # Try SIMPLE_PROJECT_ROOT env var first so tests and callers can force
    # deterministic resolution even when cwd also contains src/runtime.
    val project_root = env_get_nullable("SIMPLE_PROJECT_ROOT")
    if project_root != "" and project_root != nil:
        val rt_path = "{project_root}/src/runtime/runtime.c"
        if file_exists(rt_path):
            return "{project_root}/src/runtime"

    # Try relative to current working directory
    if file_exists("src/runtime/runtime.c"):
        return "src/runtime"

    # Unix-only: walk up from the executable location.
    if not _is_windows():
        # Canonicalize in-process. Inside `sh -c`, /proc/self is the shell, so
        # a shell-out here reports the shell's path, not ours (2026-07-25).
        val exe_path = rt_path_absolute("/proc/self/exe") ?? ""
        if exe_path.len() > 0 and exe_path != "/proc/self/exe":
            val from_exe = _runtime_dir_walk_up(exe_path)
            if from_exe != "":
                return from_exe

    # Walk up from the current working directory: covers running from a nested
    # subdirectory of the tree.
    val cwd = rt_path_absolute(".") ?? ""
    val from_cwd = _runtime_dir_walk_up(cwd)
    if from_cwd != "":
        return from_cwd

    ""

fn _runtime_dir_not_found_message() -> text:
    """Honest diagnostic for a failed runtime-source lookup."""
    val cwd = rt_path_absolute(".") ?? "<unknown>"
    val exe_path = rt_path_absolute("/proc/self/exe") ?? "<unknown>"
    val project_root = env_get_nullable("SIMPLE_PROJECT_ROOT")
    val pr = if project_root != "" and project_root != nil: project_root else: "<unset>"
    var msg = "Runtime source directory not found: no src/runtime/runtime.c under the current directory ({cwd}), "
    msg = msg + "under any ancestor of it, or under any ancestor of the running executable ({exe_path}). "
    msg = msg + "SIMPLE_PROJECT_ROOT={pr} - set SIMPLE_PROJECT_ROOT to the repository root to resolve this explicitly."
    msg

# ============================================================================
# Runtime Compilation
# ============================================================================

# ============================================================================
# Runtime Object Cache
# ============================================================================

fn _runtime_object_cache_dir(rt_dir: text, cc: text, opt_level: i64, include_dynload: bool, include_stage4_legacy_compat: bool, target: text, ext: text) -> text:
    """Directory holding prebuilt C-runtime objects for this exact input set.

    The C runtime was recompiled from source on EVERY native build: 27
    `clang -c` invocations, serially, into a PID-keyed temp prefix that was
    then deleted. Landed as 71347b901b6 (2026-08-23, LINKPERF: 103s of a 108s
    hello-world build) and clobbered by the f1e0fff1662 merge restore; re-
    measured 2026-08-28 on the stage2 pure-Simple binary: 27 clang execs,
    53s of a 57s hello-world native-build, byte-identical on a warm rerun.
    This is a pure memo: the key covers the compiler, every flag-affecting
    option, the target, and the sha256 of the CONTENT of every .c/.h under
    the runtime source tree (content, not size+mtime, so it cannot go stale),
    so any change to any input misses the cache and recompiles. Returns ""
    when caching is unavailable or disabled (SIMPLE_RT_OBJ_CACHE=0), in which
    case the caller compiles exactly as before.
    """
    if (env_get_nullable("SIMPLE_RT_OBJ_CACHE") ?? "") == "0":
        return ""
    if _is_windows():
        return ""
    # VERIFY (2026-08-28): `riscv_vec` and `host_arch` close two key holes found
    # auditing this memo. `SIMPLE_RUNTIME_RISCV64_VECTOR=1` adds
    # `-march=rv64gcv -mabi=lp64d` to runtime_simd_dispatch.c, and
    # `host_arch()` adds `-mno-outline-atomics` when target == "host" on
    # aarch64 -- both change the emitted object while leaving every other key
    # input identical, so without them a flag flip would hit a stale object.
    # Adding inputs to the key can only cause MORE misses, never fewer.
    val riscv_vec = env_get_nullable("SIMPLE_RUNTIME_RISCV64_VECTOR") ?? ""
    val flag_sig = "v3;cc={cc};opt={opt_level};dyn={include_dynload};legacy={include_stage4_legacy_compat};target={target};ext={ext};rt_dir={rt_dir};riscv_vec={riscv_vec};host_arch={host_arch()}"
    var cmd = "( printf '%s\\n' '" + flag_sig + "'; '" + cc + "' --version 2>/dev/null; "
    cmd = cmd + "find '" + rt_dir + "' -type f \\( -name '*.c' -o -name '*.h' \\) 2>/dev/null | LC_ALL=C sort | xargs -r sha256sum 2>/dev/null "
    cmd = cmd + ") | sha256sum 2>/dev/null | cut -c1-40"
    val (out, err, code) = backend_shell_tuple(cmd)
    if code != 0:
        return ""
    val key = out.trim()
    if key.len() < 16:
        return ""
    val root = env_get_nullable("SIMPLE_RT_OBJ_CACHE_DIR") ?? ""
    val base = if root != "": root else: "{_get_temp_dir()}/simple-rt-objcache"
    val dir = base + "/" + key
    val (mout, merr, mcode) = backend_shell_tuple("mkdir -p '" + dir + "'")
    if mcode != 0:
        return ""
    dir

fn compile_runtime_objects(verbose: bool, opt_level: i64, include_dynload: bool = true, compiler: text = "", include_stage4_legacy_compat: bool = false) -> Result<[text], text>:
    """Compile all C runtime source files to object files.

    Compiles runtime.c, runtime_native.c, runtime_rocm.c, runtime_directx_core.c, runtime_thread.c,
    runtime_memtrack.c, runtime_timestamp.c, runtime_fork.c, runtime_process.c with appropriate flags for linking with LLVM-generated code.

    Preserves the caller's optimization level across runtime object compilation.
    Returns a list of object file paths on success, or an error message.
    """
    val trace = runtime_compile_trace_enabled()
    if trace:
        print "[RT-COMPILE] enter compile_runtime_objects"
    val cc = if compiler != "": compiler else: find_c_compiler()
    if trace:
        print "[RT-COMPILE] cc={cc}"
    if cc == "":
        return Err("No C compiler found. Install clang or gcc.")

    val rt_dir = find_runtime_source_dir()
    if trace:
        print "[RT-COMPILE] rt_dir={rt_dir}"
    if rt_dir == "":
        return Err(_runtime_dir_not_found_message())

    # runtime_sdl2 joins the default set now that it dlopens SDL2 at first use
    # instead of binding it at link time: it needs no SDL2 headers to compile and
    # no -lSDL2 to link, so hosts without SDL2 still build. Leaving it out was why
    # a native build could not resolve the rt_sdl2_* family at all.
    # runtime_audio joins the default set for the same reason: it was entirely
    # absent from this list, so a native build had no path to the real
    # miniaudio-backed rt_audio_* implementation either (31 names, see
    # doc/08_tracking/bug/interpreter_extern_unreachable_names.md bucket (a)).
    # It needs no extra link flags -- -lpthread/-ldl/-lm are already
    # unconditionally passed below for runtime_thread.c et al.
    # runtime_framebuffer/runtime_image close their bucket (a) providers.
    # runtime_socket_nonblock supplies only prepare/commit/mask syscalls for
    # the canonical Pure-Simple rt_socket_set_nonblocking owner.
    # The remaining bucket (a) log-lib names (rt_simpleos_log_*/
    # rt_log_target_*) were fixed only on the interpreter-crate side
    # (src/compiler_rust/runtime/build.rs); their C source
    # (startup/common/runtime_log_hosted.c) lives one directory down, which
    # this array's flat `{rt_dir}/{name}.c` naming does not support without
    # also teaching the object-path builder below to create nested
    # directories -- left as a follow-up, not silently dropped.
    var sources = ["runtime", "runtime_native", "runtime_backend_plugin", "runtime_contracts", "runtime_coverage_core", "runtime_rocm", "runtime_renderdoc", "runtime_directx_core", "runtime_thread", "runtime_memtrack", "runtime_timestamp", "runtime_fork", "runtime_process", "runtime_process_owned", "runtime_memory", "runtime_simd_utf8", "runtime_simd_search", "runtime_simd_case", "runtime_simd_dispatch", "runtime_packed_span", "runtime_font", "runtime_glfw", "runtime_sdl2", "runtime_sdl3", "runtime_audio", "runtime_framebuffer", "runtime_image", "runtime_socket_nonblock", "counterpart_abi_runtime", "runtime_terminal"]
    val tmp_dir = _get_temp_dir()
    val ext = _obj_ext()
    val use_msvc = _is_msvc_cc(cc)
    val compile_pid = getpid()
    val target = env_get_nullable("SIMPLE_NATIVE_BUILD_TARGET") ?? "host"
    val object_prefix = "{tmp_dir}/simple_rt_{compile_pid}_{target}_"
    var objects = [
        "{object_prefix}runtime{ext}",
        "{object_prefix}runtime_native{ext}",
        "{object_prefix}runtime_backend_plugin{ext}",
        "{object_prefix}runtime_contracts{ext}",
        "{object_prefix}runtime_coverage_core{ext}",
        "{object_prefix}runtime_rocm{ext}",
        "{object_prefix}runtime_renderdoc{ext}",
        "{object_prefix}runtime_directx_core{ext}",
        "{object_prefix}runtime_thread{ext}",
        "{object_prefix}runtime_memtrack{ext}",
        "{object_prefix}runtime_timestamp{ext}",
        "{object_prefix}runtime_fork{ext}",
        "{object_prefix}runtime_process{ext}",
        "{object_prefix}runtime_process_owned{ext}",
        "{object_prefix}runtime_memory{ext}",
        "{object_prefix}runtime_simd_utf8{ext}",
        "{object_prefix}runtime_simd_search{ext}",
        "{object_prefix}runtime_simd_case{ext}",
        "{object_prefix}runtime_simd_dispatch{ext}",
        # SimplePackedSpanV1 C resolve (F2).
        "{object_prefix}runtime_packed_span{ext}",
        "{object_prefix}runtime_font{ext}",
        "{object_prefix}runtime_glfw{ext}",
        "{object_prefix}runtime_sdl2{ext}",
        "{object_prefix}runtime_sdl3{ext}",
        "{object_prefix}runtime_audio{ext}",
        "{object_prefix}runtime_framebuffer{ext}",
        "{object_prefix}runtime_image{ext}",
        "{object_prefix}runtime_socket_nonblock{ext}",
        "{object_prefix}counterpart_abi_runtime{ext}",
        # Terminal probes (rt_terminal_is_tty / rt_terminal_stdout_is_tty / raw
        # mode / size / rt_stdin_read_byte) backing the std.tui.terminal externs
        # at src/lib/nogc_sync_mut/tui/terminal.spl:42-47. This list never
        # carried it, so a self-hosted native link of anything reaching
        # std.tui.terminal left rt_terminal_* undefined -- the tolerated-
        # undefined then NULL-GOT SIGSEGV class of
        # stage3_native_build_and_compile_segv_on_hello_world_2026-08-18.
        # The seed's core-C list (native_project/tools.rs) has always compiled
        # it unconditionally on every target, so the Linux/macOS build is
        # already proven; it needs no SDK and no extra link flags, and it is
        # the sole .c definer of all 7 of its symbols (zero collisions with the
        # other members of this list). Analysis:
        # doc/08_tracking/bug/c_runtime_source_list_divergence_2026-08-30.md
        "{object_prefix}runtime_terminal{ext}"
    ]
    if include_stage4_legacy_compat:
        sources = sources.push("runtime_legacy_core")
        objects = objects.push("{object_prefix}runtime_legacy_core{ext}")
    if include_dynload:
        sources = sources.push("runtime_dynload")
        objects = objects.push("{object_prefix}runtime_dynload{ext}")
    var object_count = 0
    val cache_dir = _runtime_object_cache_dir(
        rt_dir, cc, opt_level, include_dynload,
        include_stage4_legacy_compat, target, ext)
    if trace:
        print "[RT-COMPILE] object cache dir={cache_dir}"
    if trace:
        print "[RT-COMPILE] starting loop over {sources.len()} sources"

    for name in sources:
        if trace:
            print "[RT-COMPILE] processing: {name}"
        val src_path = "{rt_dir}/{name}.c"
        if trace:
            print "[RT-COMPILE] checking existence of {src_path}"
        if not file_exists(src_path):
            cleanup_runtime_objects(objects)
            return Err("Required runtime source not found: {src_path}")

        val obj_path = objects[object_count]
        if trace:
            print "[RT-COMPILE] compiling: {name}.c"

        var comp_args: [text] = []
        if use_msvc:
            # MSVC cl.exe flags (/Gy enables function-level linking for /OPT:REF)
            val msvc_opt = if opt_level <= 0: "/Od" elif opt_level == 1: "/O1" elif opt_level == 2: "/O2" else: "/Ox"
            # /std:c11 is required: the runtime uses <stdatomic.h>, which the MS
            # CRT header guards behind C11 (fatal C1189 otherwise). clang-cl
            # accepts it and it matches the -std=gnu11 the clang branch passes.
            comp_args = ["/c", msvc_opt, "/Gy", "/MD", "/std:c11", "/I", rt_dir, "/I", "{rt_dir}/platform", "/Fo{obj_path}", src_path]
            # runtime_memory.c is always in this bundle and canonically owns
            # the overlapping allocator/pointer ABI, including native-all.
            comp_args.push("/DSIMPLE_RUNTIME_MEMORY_OWNER=1")
            if include_dynload:
                # Only the standalone core-C composition may suppress hosted
                # providers. native-all needs runtime_native/thread/process
                # hosted fallbacks even though runtime_memory remains present.
                comp_args.push("/DSIMPLE_CORE_C_STANDALONE=1")
                # runtime_dynload.c is in this bundle and owns spl_dlopen/
                # spl_dlsym/spl_dlclose. Compile runtime_native.c's per-lane
                # fallback copies out so exactly ONE definition ships.
                comp_args.push("/DSIMPLE_RUNTIME_DYNLOAD_OWNER=1")
                # This composition sets SIMPLE_CORE_C_STANDALONE but does NOT
                # include runtime_legacy_core.c (see include_stage4_legacy_compat
                # below), and legacy_core.c is the sole owner of
                # spl_thread_cpu_count under that define -- so without this the
                # link fails with `runtime_thread.obj : error LNK2019:
                # unresolved external symbol spl_thread_cpu_count referenced in
                # function rt_pool_get_parallelism` (measured 2026-09-02). State
                # the ownership explicitly rather than letting runtime_thread.c
                # guess from the platform.
                if not include_stage4_legacy_compat:
                    comp_args.push("/DSIMPLE_RUNTIME_THREAD_CPU_COUNT_OWNER=1")
        else:
            # GCC/Clang flags (-fPIC only on Unix, not needed on Windows)
            # -ffunction-sections -fdata-sections: emit each function/data in its own
            # section so the linker's --gc-sections can strip unreferenced code.
            comp_args = ["-c"]
            if not _is_windows():
                comp_args.push("-fPIC")
            val cc_opt = if opt_level <= 0: "-O0" elif opt_level == 1: "-Oz" elif opt_level == 2: "-O2" else: "-O3"
            comp_args.push(cc_opt)
            comp_args.push("-ffunction-sections")
            comp_args.push("-fdata-sections")
            comp_args.push("-std=gnu11")
            # Keep runtime_memory.c as the sole allocator/pointer ABI owner in
            # both dynload and native-all/non-dynload compositions.
            comp_args.push("-DSIMPLE_RUNTIME_MEMORY_OWNER=1")
            if include_dynload:
                # Standalone core-C suppresses hosted fallbacks; native-all
                # must retain them and therefore must not receive this flag.
                comp_args.push("-DSIMPLE_CORE_C_STANDALONE=1")
                # runtime_dynload.c is in this bundle and owns spl_dlopen/
                # spl_dlsym/spl_dlclose. Compile runtime_native.c's per-lane
                # fallback copies out so exactly ONE definition ships.
                comp_args.push("-DSIMPLE_RUNTIME_DYNLOAD_OWNER=1")
                # Same ownership statement as the MSVC branch above. Inert
                # wherever runtime_legacy_core.c IS in the list.
                if not include_stage4_legacy_compat:
                    comp_args.push("-DSIMPLE_RUNTIME_THREAD_CPU_COUNT_OWNER=1")
            if target.starts_with("aarch64-") or (target == "host" and host_arch() == "aarch64"):
                comp_args.push("-mno-outline-atomics")
            # Explicit opt-in: the resulting binary requires an RVV-capable CPU.
            if name == "runtime_simd_dispatch" and target.starts_with("riscv64") and (env_get_nullable("SIMPLE_RUNTIME_RISCV64_VECTOR") ?? "") == "1":
                comp_args.push("-march=rv64gcv")
                comp_args.push("-mabi=lp64d")
            comp_args.push("-I")
            comp_args.push(rt_dir)
            comp_args.push("-I")
            comp_args.push("{rt_dir}/platform")
            comp_args.push("-o")
            comp_args.push(obj_path)
            comp_args.push(src_path)

        val cache_obj = if cache_dir != "": cache_dir + "/" + name + ext else: ""
        var cache_hit = false
        var cache_obj_exists = false
        if cache_obj != "":
            cache_obj_exists = file_exists(cache_obj)
        if cache_obj_exists:
            val (hit_out, hit_err, hit_code) = backend_shell_tuple(
                "cp -f '" + cache_obj + "' '" + obj_path + "'")
            if hit_code == 0:
                cache_hit = true
                if trace:
                    print "[RT-COMPILE] cache hit: {name}.c"
        var comp_out = ""
        var comp_err = ""
        var comp_code = 0
        if not cache_hit:
            val (run_out, run_err, run_code) = process_run(cc, comp_args)
            comp_out = run_out
            comp_err = run_err
            comp_code = run_code
        if trace:
            print "[RT-COMPILE] compile result: code={comp_code}"
        if comp_code != 0:
            cleanup_runtime_objects(objects)
            var comp_detail = "{comp_out}{comp_err}"
            if comp_detail.trim() == "":
                # A silent nonzero exit means the compiler itself died (crash,
                # missing DLL, spawn failure), not a diagnosis of the source.
                comp_detail = "(no compiler output; cc='{cc}' exited with code {comp_code} — the compiler crashed or could not start)"
            return Err("Failed to compile {name}.c:\n{comp_detail}")

        if cache_obj != "" and not cache_hit:
            # Publish via a private staging name + rename so concurrent builds
            # never observe a half-written object.
            val stage = cache_obj + ".tmp." + "{compile_pid}"
            backend_shell_tuple(
                "cp -f '" + obj_path + "' '" + stage + "' && mv -f '"
                + stage + "' '" + cache_obj + "'")

        object_count = object_count + 1

    if trace:
        print "[RT-COMPILE] loop done, {object_count} objects compiled"
    if object_count == 0:
        cleanup_runtime_objects(objects)
        return Err("No runtime source files were compiled")

    if object_count < sources.len():
        cleanup_runtime_objects(objects)
        return Err("Expected {sources.len()} runtime objects, got {object_count}")

    if trace:
        print "[RT-COMPILE] returning Ok with {object_count} objects"
    Ok(objects)

fn cleanup_runtime_objects(objects: [text]):
    """Remove temporary runtime object files."""
    for obj in objects:
        file_delete(obj)

# ============================================================================
# Exports
# ============================================================================
