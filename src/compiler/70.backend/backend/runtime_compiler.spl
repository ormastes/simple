use std.nogc_sync_mut.io.native_runtime_authority_v1.{native_runtime_strict_source_dir_v1, native_runtime_strict_revalidate_v1,
    native_runtime_strict_generated_bind_v1, native_runtime_strict_generated_release_v1}

extern fn rt_path_absolute(path: text) -> text?

# ============================================================================
# Platform Helpers
# ============================================================================

# Was: delegate to std.nogc_sync_mut.env.platform.is_windows() (itself a
# 2026-09-02 fail-open fix over a bare `OS` env-var read). That delegation was
# ITSELF broken under this file's own execution context: traced live inside
# the Stage 2 bootstrap sanity harness's in-process native-build (the
# "hosted native link" path this file's find_c_compiler serves), host_os()
# two lines above correctly answered "windows" while
# nogc_sync_mut.env.platform.is_windows() answered false in the SAME call --
# two independent OS-detection implementations disagreeing in one process.
# That silent false routed every _find_c_compiler_windows candidate probe
# through the POSIX branch (backend_shell_tuple's `/bin/sh -c`) instead of
# `cmd.exe /c`, well upstream of that function's own (otherwise unconditional)
# diagnostics -- which is why "No C compiler found" printed nothing about what
# was tried. host_os() is already imported by this file and already proven
# correct in this exact failing context by that same trace; compare against it
# directly instead of trusting a second detector.
fn _is_windows() -> bool:
    host_os() == "windows"

pub fn _is_msvc_cc(cc: text) -> bool:
    val normalized = cc.lower().replace("\\", "/")
    val parts = normalized.split("/")
    val driver = parts[parts.len() - 1]
    driver == "cl" or driver == "cl.exe" or driver == "clang-cl" or driver == "clang-cl.exe"

pub fn windows_link_flavor_select(target: text, linker_abi: text, flavor_override: text,
        abi_override: text) -> text:
    """Pure Windows toolchain-flavor selector: "msvc" or "gnu".

    An ABI-qualified TARGET wins (`*-windows-msvc` / `windows-msvc` -> msvc;
    `*-windows-gnu`, `*-w64-mingw32` / `windows-gnu` -> gnu), then the
    explicit env overrides `SIMPLE_LINKER_FLAVOR` (msvc|gnu|mingw) and
    `SIMPLE_WINDOWS_ABI` (msvc|gnu); otherwise gnu (llvm-mingw, no-MSVC policy).

    MSYSTEM (set by every MSYS2/Git Bash shell) is deliberately not consulted,
    unlike the Rust seed's `Target::linker_flavor`: it says nothing about the
    C compiler, and the runtime objects are compiled for the C compiler's
    default (MSVC) ABI, so MSYSTEM -> gnu linked MSVC objects through MinGW
    (undefined `__stdio_common_vfprintf`, `__chkstk`, `_fltused`). See
    doc/08_tracking/bug/windows_unqualified_native_build_msystem_gnu_flavor_mismatch_2026-10-18.md."""
    val normalized_target = target.lower()
    val normalized_abi = linker_abi.lower()
    if normalized_abi == "windows-msvc" or normalized_target.ends_with("-windows-msvc"):
        return "msvc"
    if normalized_abi == "windows-gnu" or normalized_target.ends_with("-windows-gnu") or
            normalized_target.ends_with("-w64-mingw32"):
        return "gnu"
    val flavor = flavor_override.lower()
    if flavor == "msvc":
        return "msvc"
    if flavor == "gnu" or flavor == "mingw":
        return "gnu"
    val abi = abi_override.lower()
    if abi == "msvc":
        return "msvc"
    if abi == "gnu":
        return "gnu"
    # No-MSVC policy (2026-10-27): an unqualified Windows link defaults to the
    # llvm-mingw GNU lane (clang + lld). MSVC only when the target or an
    # override asks for it explicitly.
    "gnu"

pub fn windows_link_flavor_env_conflict(target: text, linker_abi: text, flavor_override: text) -> text:
    """Message when SIMPLE_LINKER_FLAVOR contradicts an ABI-qualified target
    (the target wins, exactly as in the seed); "" when there is no conflict."""
    val flavor = flavor_override.lower()
    if flavor != "msvc" and flavor != "gnu" and flavor != "mingw":
        return ""
    val selected = windows_link_flavor_select(target, linker_abi, "", "")
    val requested = if flavor == "mingw": "gnu" else: flavor
    if selected == requested:
        return ""
    if not target.lower().contains("-windows-") and linker_abi == "":
        return ""
    "SIMPLE_LINKER_FLAVOR=" + flavor_override + " ignored: target '" + target + "' names the " + selected + " ABI"

fn _env_text(name: text) -> text:
    val value = env_get_nullable(name)
    if value.is_none():
        return ""
    value

pub fn windows_link_flavor_for_target(target: text, linker_abi: text) -> text:
    """windows_link_flavor_select over the live environment. An empty
    `target` falls back to SIMPLE_NATIVE_BUILD_TARGET (the driver's --target)."""
    val effective_target = if target != "": target else: _env_text("SIMPLE_NATIVE_BUILD_TARGET")
    val flavor_override = _env_text("SIMPLE_LINKER_FLAVOR")
    val conflict = windows_link_flavor_env_conflict(effective_target, linker_abi, flavor_override)
    if conflict != "":
        print "[linker-flavor] {conflict}"
    windows_link_flavor_select(effective_target, linker_abi, flavor_override,
        _env_text("SIMPLE_WINDOWS_ABI"))

pub fn _is_mingw() -> bool:
    windows_link_flavor_for_target("", "") == "gnu"

# reason: Windows MSYS path normalization helper exported for unit specs
@allow(primitive_api)
pub fn windows_msys_drive_path_v1(p: text, is_windows: bool) -> text:
    """On Windows, rewrite an MSYS/Cygwin '/d/foo' path to native 'd:/foo'."""
    if not is_windows:
        return p
    if p.len() < 3:
        return p
    if not p.starts_with("/"):
        return p
    val drive = p[1:2]
    if drive == "" or not "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".contains(drive):
        return p
    if p[2:3] != "/":
        return p
    "{drive}:{p[2:]}"

fn _msys_drive_path(p: text) -> text:
    """On Windows, rewrite an MSYS/Cygwin '/d/foo' path to native 'd:/foo'.

    TMPDIR/TMP/TEMP under Git Bash / MSYS2 hold POSIX-form paths. Every
    consumer below hands the result to a NATIVE Windows tool via
    process_run (no shell, so no MSYS argv conversion happens), and such a
    tool cannot open '/d/...' at all.

    Measured 2026-09-02 on the MSVC bootstrap lane, clang-cl 18.1.8, same
    probe source, argv differing only in path form:
      clang-cl /nologo /c /Fo/d/.../ccprobe.o /d/.../ccprobe.c
        -> "no such file or directory: '/d/.../ccprobe.c'", rc=1
      clang-cl /nologo /c /Fod:\...\ccprobe.o d:\...\ccprobe.c
        -> rc=0, 753-byte object
    This is why _cc_verify_compiles rejected EVERY candidate and
    find_c_compiler() returned "", producing "No C compiler found. Install
    clang or gcc." from llvm_native_link_orchestrator.spl:125 — the Stage 2
    receiver gate's real failure.

    Drive letters are case-insensitive on Windows, so no case folding is
    needed. CROSS-PLATFORM IMPACT: guarded by _is_windows(); on every other
    platform this returns its argument unchanged, and '/d/foo' is a perfectly
    ordinary POSIX path that must NOT be rewritten.
    """
    windows_msys_drive_path_v1(p, _is_windows())

pub fn _get_temp_dir() -> text:
    val tmpdir = env_get_nullable("TMPDIR")
    if tmpdir != "" and tmpdir.is_some():
        return _msys_drive_path(tmpdir)
    val tmp = env_get_nullable("TMP")
    if tmp != "" and tmp.is_some():
        return _msys_drive_path(tmp)
    val temp = env_get_nullable("TEMP")
    if temp != "" and temp.is_some():
        return _msys_drive_path(temp)
    if _is_windows():
        return "C:/Windows/Temp"
    "/tmp"

fn _obj_ext() -> text:
    if _is_windows() and not _is_mingw():
        ".obj"
    else:
        ".o"

fn runtime_compile_trace_enabled() -> bool:
    (env_get_nullable("SIMPLE_COMPILER_TRACE") ?? "") == "1"

pub fn runtime_abi_policy_v1() -> Result<text, text>:
    val configured = env_get_nullable("SIMPLE_ABI_POLICY") ?? ""
    if configured == "" or configured == "v1":
        return Ok("v1")
    Err("SIMPLE_ABI_POLICY selected policy is v1; rejected '{configured}'")

pub fn runtime_abi_define_args_v1(policy: text, msvc: bool) -> [text]:
    val prefix = if msvc: "/D" else: "-D"
    if policy == "v1":
        return ["{prefix}SIMPLE_ABI_VERSION=1",
            "{prefix}SIMPLE_ABI_VERSION_DEFERRED=0"]
    []

# ============================================================================
# C Compiler Discovery
# ============================================================================

pub struct HostedCCompilerPlan:
    requires_cross: bool
    supported: bool
    command: text

fn hosted_c_arch_kind(arch: text) -> text:
    if arch == "riscv64" or arch == "riscv64gc" or arch == "rv64" or arch == "rv64gc":
        return "riscv64"
    val normalized = mir_target_context_normalize_arch(arch)
    if arch == "i686" or arch == "i586" or arch == "i486" or arch == "i386" or arch == "x86":
        return "i686"
    if normalized == "x86_64" or normalized == "aarch64":
        return normalized
    ""

fn hosted_c_target_os_matches(target: text, host_os_name: text) -> bool:
    if not target.contains("-"):
        return true
    if host_os_name == "linux":
        return target.ends_with("-linux-gnu")
    if host_os_name == "macos" or host_os_name == "darwin":
        return target.ends_with("-apple-darwin")
    if host_os_name == "windows":
        return target.ends_with("-pc-windows-msvc") or hosted_c_target_is_mingw(target)
    if host_os_name == "freebsd":
        return target.ends_with("-unknown-freebsd")
    false

fn hosted_c_target_is_mingw(target: text) -> bool:
    target.ends_with("-pc-windows-gnu") or target.ends_with("-pc-windows-gnullvm") or target.ends_with("-w64-mingw32") or target.ends_with("-w64-windows-gnu")

pub fn hosted_mingw_clang_target(target: text) -> text:
    """llvm-mingw clang driver triple for a Windows GNU compile or link.

    The target's own architecture; x86_64 for an empty, host or unknown one.
    A hardcoded x86_64 triple sent an aarch64-pc-windows-gnu cross link to the
    x86_64 sysroot."""
    val lower = target.trim().lower()
    if lower.starts_with("aarch64-") or lower.starts_with("arm64-"):
        return "aarch64-w64-windows-gnu"
    if lower.starts_with("i686-"):
        return "i686-w64-windows-gnu"
    "x86_64-w64-windows-gnu"

pub fn hosted_c_compiler_plan(target: text, host_os_name: text, host_arch_name: text) -> HostedCCompilerPlan:
    """Classify hosted C compilation without enabling unsupported cross targets."""
    if target == "" or target == "host" or target == "native":
        return HostedCCompilerPlan(requires_cross: false, supported: true, command: "")
    val target_arch_text = if target.contains("-"): target.split("-")[0] else: target
    val target_arch = hosted_c_arch_kind(target_arch_text)
    val host_kind = hosted_c_arch_kind(host_arch_name)
    val os_matches = hosted_c_target_os_matches(target, host_os_name)
    val linux_to_mingw = host_os_name == "linux" and hosted_c_target_is_mingw(target)
    val requires_cross = target_arch != "" and host_kind != "" and
        (target_arch != host_kind or not os_matches)
    if target_arch == "" or host_kind == "" or (not os_matches and not linux_to_mingw):
        return HostedCCompilerPlan(requires_cross: requires_cross, supported: false, command: "")
    if not requires_cross:
        return HostedCCompilerPlan(requires_cross: false, supported: true, command: "")
    if linux_to_mingw:
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "clang")
    if host_os_name == "linux" and target_arch == "aarch64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "aarch64-linux-gnu-gcc")
    if host_os_name == "linux" and target_arch == "riscv64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "riscv64-linux-gnu-gcc")
    # Apple clang and the macOS SDK are multi-arch: arm64 <-> x86_64 Darwin
    # cross needs only `--target=<triple>` (see hosted_cross_c_target_args).
    val darwin_host = host_os_name == "macos" or host_os_name == "darwin"
    # llvm-mingw clang is multi-target: one driver builds the runtime, entry and
    # link for any mingw arch it ships a sysroot for (i686/x86_64/aarch64).
    if host_os_name == "windows" and hosted_c_target_is_mingw(target) and target_arch != "riscv64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "clang")
    if darwin_host and target.ends_with("-apple-darwin") and target_arch != "riscv64":
        return HostedCCompilerPlan(requires_cross: true, supported: true, command: "clang")
    HostedCCompilerPlan(requires_cross: true, supported: false, command: "")

pub fn hosted_cross_c_target_args(target: text, host_os_name: text, host_arch_name: text) -> [text]:
    """Driver flags that retarget a clang compile/link for a supported Darwin cross plan."""
    val plan = hosted_c_compiler_plan(target, host_os_name, host_arch_name)
    if plan.requires_cross and plan.supported and target.ends_with("-pc-windows-gnullvm"):
        # LLVM has no gnullvm environment; clang would treat it as MSVC.
        return ["--target=" + hosted_mingw_clang_target(target)]
    if plan.requires_cross and plan.supported and (target.ends_with("-apple-darwin") or hosted_c_target_is_mingw(target)):
        return ["--target={target}"]
    []

pub fn hosted_cross_c_compiler_name(target: text, host_os_name: text, host_arch_name: text) -> text:
    val plan = hosted_c_compiler_plan(target, host_os_name, host_arch_name)
    if plan.requires_cross and plan.supported:
        return plan.command
    ""

pub fn c_compiler_override(windows_gnu: bool, requires_cross: bool, target: text) -> text?:
    var simple_cc = env_get_nullable("SIMPLE_CC")
    if windows_gnu and not requires_cross:
        val gnu_cc = env_get_nullable("CC")
        if gnu_cc != "" and gnu_cc.is_some():
            simple_cc = gnu_cc
    elif windows_gnu and hosted_c_target_is_mingw(target) and (simple_cc == "" or simple_cc.is_none()):
        # llvm-mingw clang is multi-target: reuse CC for a mingw cross arch.
        val cross_cc = env_get_nullable("CC")
        if cross_cc != "" and cross_cc.is_some():
            simple_cc = cross_cc
    if simple_cc != "" and simple_cc.is_some():
        if ((windows_gnu and not requires_cross) or hosted_c_target_is_mingw(target)) and not simple_cc.lower().contains("clang"):
            return ""
    if simple_cc == "":
        return None
    simple_cc

# --- clang-only C driver policy (CLAUDE.md Critical Rules: "Never use GCC") ---
#
# Pure decision layer: `c_driver_classify_v1` + `c_compiler_select_v1` take the
# results of `command -v` / `readlink -f` / `--version` and decide; the I/O
# shell (`_c_driver_probe_v1`) only gathers them. A driver that resolves to
# GCC is REFUSED with a message naming the rule and the fix. Nothing here ever
# falls back to gcc, g++, bare `cc`/`c++` or collect2. Pinned by
# test/01_unit/compiler/backend/c_driver_clang_only_spec.spl.

pub struct CDriverProbeV1:
    name: text            # as requested: a candidate or the SIMPLE_CC/CC value
    invoked_path: text    # `command -v name` (the PATH entry); "" when not on PATH. What callers run.
    resolved_path: text   # realpath of invoked_path; used ONLY for classification (gcc basename signal)
    version_banner: text  # first lines of `<invoked_path> --version`; "" when not run
    explicit: bool        # from SIMPLE_CC/CC: unresolved or non-clang is a refusal, never a skip

val C_DRIVER_RULE_HINT = "CLAUDE.md Critical Rules: Never use GCC. Toolchain is clang + lld/mold, llvm-ar. Fix: `. scripts/setup/llvm-toolchain-env.shs` (puts clang-23/ld.lld first on PATH) or set SIMPLE_CC=clang-23 (any clang/clang-NN)."

fn _c_driver_basename(path: text) -> text:
    var base = path
    val slash = base.rfind("/")
    if slash >= 0:
        base = base.substring(slash + 1, base.len())
    val bslash = base.rfind("\\")
    if bslash >= 0:
        base = base.substring(bslash + 1, base.len())
    base = base.lower()
    if base.ends_with(".exe"):
        base = base.substring(0, base.len() - 4)
    base

pub fn c_driver_classify_v1(resolved_path: text, version_banner: text) -> text:
    """Classify a hosted C driver as "clang", "gcc" or "unknown".

    Basename first (`gcc`, `gcc-13`, `x86_64-linux-gnu-gcc-13`, `g++`), then the
    `--version` banner: clang prints `clang version` (also `Apple clang version`);
    GCC invoked as `cc`/`c++` prints `cc (Ubuntu ...)` and names the FSF only on
    its second line, so the whole banner is scanned, not line 1."""
    val base = _c_driver_basename(resolved_path)
    if base == "gcc" or base.starts_with("gcc-") or base.ends_with("-gcc") or base.contains("-gcc-"):
        return "gcc"
    if base == "g++" or base.starts_with("g++-") or base.ends_with("-g++") or base.contains("-g++-"):
        return "gcc"
    val banner = version_banner.lower()
    if banner.contains("clang version"):
        return "clang"
    if banner.contains("free software foundation") or banner.contains("gcc version") or banner.contains("(gcc)"):
        return "gcc"
    if base == "clang" or base.starts_with("clang-") or base == "clang++" or base.starts_with("clang++-"):
        return "clang"
    "unknown"

pub fn c_compiler_candidates_v1() -> [text]:
    """PATH candidates, bare `clang` first so a sourced llvm-toolchain-env PATH wins, then versioned."""
    ["clang", "clang-23", "clang-22", "clang-21", "clang-20", "clang-19", "clang-18", "clang-17", "clang-16"]

fn _c_driver_refusal_v1(probe: CDriverProbeV1, kind: text) -> text:
    "[cc-detect] REFUSED C driver '{probe.name}' -> {probe.resolved_path}: it is {kind}, not clang. {C_DRIVER_RULE_HINT}"

pub fn c_compiler_select_v1(probes: [CDriverProbeV1]) -> Result<text, text>:
    """Pick the first clang probe; refuse GCC; fail closed when nothing is clang.

    Explicit probes (SIMPLE_CC/CC) are never skipped: unresolved, GCC or
    unrecognised is an error. Non-explicit candidates that did not resolve or
    are unrecognisable are skipped; a candidate that IS gcc is refused outright
    (a `clang` on PATH that is really GCC is a broken environment, not a miss)."""
    var tried: [text] = []
    for probe in probes:
        tried.push(probe.name)
        if probe.invoked_path == "":
            if probe.explicit:
                return Err("[cc-detect] REFUSED: explicit C driver '{probe.name}' is not on PATH. {C_DRIVER_RULE_HINT}")
            continue
        val kind = c_driver_classify_v1(probe.resolved_path, probe.version_banner)
        if kind == "clang":
            if probe.explicit:
                return Ok(probe.name)
            # The PATH entry, never the realpath: a ccache masquerade dir
            # (/usr/lib64/ccache/clang -> /usr/bin/ccache) must be run as `clang`.
            return Ok(probe.invoked_path)
        if kind == "gcc":
            return Err(_c_driver_refusal_v1(probe, "GCC"))
        if probe.explicit:
            return Err(_c_driver_refusal_v1(probe, "not recognisable as clang"))
    Err("[cc-detect] no clang C driver found on PATH (tried: {tried.join(', ')}); gcc, g++ and bare cc are never used as a fallback. {C_DRIVER_RULE_HINT}")

pub fn cxx_driver_for_c_driver_v1(cc: text) -> text:
    """clang -> clang++, /x/clang-23 -> /x/clang++-23, clang.exe -> clang++.exe; clang-cl is both."""
    var dir = ""
    var base = cc
    val fslash = cc.rfind("/")
    val bslash = cc.rfind("\\")
    val slash = if fslash > bslash: fslash else: bslash
    if slash >= 0:
        dir = cc.substring(0, slash + 1)
        base = cc.substring(slash + 1, cc.len())
    var ext = ""
    if base.lower().ends_with(".exe"):
        ext = base.substring(base.len() - 4, base.len())
        base = base.substring(0, base.len() - 4)
    if base == "clang-cl" or base.starts_with("clang++"):
        return cc
    if base == "clang":
        return "{dir}clang++{ext}"
    if base.starts_with("clang-"):
        return "{dir}clang++-{base.substring(6, base.len())}{ext}"
    cc

fn _c_driver_probe_v1(name: text, explicit: bool) -> CDriverProbeV1:
    """I/O shell: resolve `name` on PATH, follow symlinks, read its banner."""
    val (out, _err, code) = backend_shell_tuple("command -v {name} 2>/dev/null")
    var resolved = ""
    if code == 0:
        for line in out.split("\n"):
            if line.trim() != "" and resolved == "":
                resolved = line.trim()
    if resolved == "":
        return CDriverProbeV1(name: name, invoked_path: "", resolved_path: "", version_banner: "", explicit: explicit)
    # Banner from the path as INVOKED (a ccache/wrapper symlink answers as the
    # tool it fronts); realpath only supplies the gcc-basename signal.
    val invoked = resolved
    val (real_out, _real_err, real_code) = backend_shell_tuple("readlink -f '{resolved}' 2>/dev/null")
    if real_code == 0 and real_out.trim() != "":
        resolved = real_out.trim()
    val (banner_out, _banner_err, _banner_code) = backend_shell_tuple("'{invoked}' --version 2>/dev/null | head -3")
    CDriverProbeV1(name: name, invoked_path: invoked, resolved_path: resolved, version_banner: banner_out, explicit: explicit)

pub fn c_driver_admit_v1(name: text) -> Result<text, text>:
    """Admit an explicitly requested C driver (SIMPLE_CC/CC): clang passes verbatim, GCC is refused."""
    c_compiler_select_v1([_c_driver_probe_v1(name, true)])

fn _find_c_compiler_unix() -> text:
    var probes: [CDriverProbeV1] = []
    for candidate in c_compiler_candidates_v1():
        val probe = _c_driver_probe_v1(candidate, false)
        probes.push(probe)
        # Stop at the first candidate that classifies at all (clang wins, gcc is
        # refused by the selector); an opaque wrapper realpath with no banner is
        # skipped so the next versioned clang still gets a chance.
        if probe.invoked_path != "" and c_driver_classify_v1(probe.resolved_path, probe.version_banner) != "unknown":
            break
    match c_compiler_select_v1(probes):
        case Ok(cc): return cc
        case Err(msg):
            print msg
            return ""

pub fn find_c_compiler() -> text:
    """Find a C compiler on the system (clang only; see c_compiler_select_v1).

    Native Windows GNU shares the final linker's CC; other lanes try SIMPLE_CC first.
    Returns the command name or empty string if none found or if the only
    driver offered is GCC (the refusal is printed with the fix).
    """
    val target = env_get_nullable("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    val plan = hosted_c_compiler_plan(target, host_os(), host_arch())
    if not plan.supported:
        return ""
    if native_tool_strict_requested_v1():
        match native_tool_strict_resolve_v1("cc"):
            case Ok(path): return path
            case Err(_): return ""

    # Keep runtime and entry compilation on the same driver as the GNU linker.
    val simple_cc = c_compiler_override(_is_windows() and _is_mingw(), plan.requires_cross, target)
    if simple_cc == "":
        return ""
    if simple_cc.is_some():
        if _is_windows():
            return _msys_drive_path(simple_cc)
        if plan.requires_cross:
            return simple_cc
        match c_driver_admit_v1(simple_cc):
            case Ok(cc): return cc
            case Err(msg):
                print msg
                return ""

    if plan.requires_cross:
        val (out, err, code) = backend_shell_tuple("command -v {plan.command} 2>/dev/null")
        if code == 0:
            for path in out.split("\n"):
                val resolved = path.trim()
                if resolved != "":
                    return resolved
        return ""

    if _is_windows():
        return _find_c_compiler_windows()

    _find_c_compiler_unix()

fn _cc_verify_compiles(cc: text) -> bool:
    """VERIFY a hosted C compiler by compiling a translation unit that requires
    the C library headers, checking exit status AND the produced object file.

    A bare `where`/`which` hit is not evidence the compiler works: on this
    lane a PATH-shadowed MinGW gcc passed `where gcc` while its cc1.exe
    crashed on every input with no output at all (Git-for-Windows DLLs
    shadowing MSYS2's), and the llc bug this lane started from was the same
    exists-but-never-executed probe shape. Never assume; execute."""
    val tmp = _get_temp_dir()
    # getpid(), NOT the bare extern rt_getpid(): `rt_getpid` is not declared
    # `extern fn` anywhere in this file, so under native codegen `{pid}`
    # interpolated an opaque handle as the literal text `<value:0x34d4>`.
    # `<` and `>` are ILLEGAL in a Windows filename, so rt_file_write_text
    # below failed for EVERY candidate, _cc_verify_compiles returned false
    # four times, and find_c_compiler() returned "" -- the real
    # `reason=stage2-struct-receiver-failed` on the MSVC lane (measured
    # 2026-09-02). The typed wrapper was already imported at the top of this
    # file and simply unused. Third instance of the undeclared-extern
    # silent-value class; see
    # doc/08_tracking/bug/unregistered_extern_silent_nil_2026-08-01.md.
    # CROSS-PLATFORM: on Unix `<value:0x...>` is a legal filename, so the
    # probe worked there; the numeric name is strictly cleaner with no
    # behaviour change.
    val pid = getpid()
    # Staging names, not durable artifacts: the write-temp-then-rename idiom's
    # temp half. Nothing here is ever reused across runs -- the probe MUST
    # execute every time (a cached verdict would call a compiler healthy after
    # it broke, which is the exact incident this function exists to catch), so
    # there is no durable name to content-key. The pid only keeps two concurrent
    # probes from clobbering each other's file; the .tmp suffix marks it as
    # transient. See scripts/check/check-no-pid-keyed-build-artifacts.shs.
    # The .c / .o suffix must stay LAST: both clang and cl.exe select the input
    # language from the file extension, so a trailing .tmp would make the probe
    # unbuildable on every platform.
    val src = "{tmp}/simple-cc-verify.{pid}.tmp.c"
    val obj = "{tmp}/simple-cc-verify.{pid}.tmp.o"
    # A headerless object does not prove the hosted SDK is available. clang-cl
    # can emit it without a Windows SDK, then fail on runtime.h's stdlib.h.
    # Reject that candidate here so discovery can try the next toolchain.
    if not file_write(src, "#include <stdlib.h>\nint main(void) { return 0; }\n"):
        # UNGATED, exactly like the REJECTED branch below and for the same
        # reason its own comment already gives: gating this behind
        # SIMPLE_COMPILER_TRACE meant the only lane that ever hits it never
        # printed it. The resulting silence was read as "every `where` probe
        # failed" and cost a full diagnosis cycle on 2026-09-02.
        print "[CC-VERIFY] {cc}: REJECTED could not write probe source {src}"
        return false
    var args: [text] = []
    if _is_msvc_cc(cc):
        args = ["/nologo", "/c", "/Fo{obj}", src]
    else:
        args = ["-c", "-o", obj, src]
    # A spawn that died before the compiler ran is not a verdict on the
    # compiler: retry it instead of rejecting a healthy toolchain.
    val (out, err, code) = _cc_probe_run_retrying(cc, args, false)
    val ok = code == 0 and file_exists(obj)
    if runtime_compile_trace_enabled():
        print "[CC-VERIFY] {cc}: exit={code} obj_exists={ok}"
    elif not ok:
        # A failing probe is the thing worth reporting, and gating it behind a
        # trace flag meant the only lane that ever hits it never printed it.
        print "[CC-VERIFY] {cc}: REJECTED exit={code} src={src} obj={obj}"
        print "[CC-VERIFY] {cc}: stderr={err}"
    file_delete(src)
    file_delete(obj)
    ok

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_c_compiler_candidates_v1(flavor: text) -> [text]:
    """Windows C driver order per toolchain flavor (windows_link_flavor_select).

    Default / "gnu": llvm-mingw (or msys2 clang64) `clang` ONLY -- MSVC drivers
    are never a fallback, because their objects carry the MSVC ABI and cannot
    link on the GNU lane. "msvc" (`--msvc`, SIMPLE_WINDOWS_ABI=msvc or a
    `*-windows-msvc` target): clang-cl, cl.exe, then clang. GCC never."""
    if flavor == "msvc":
        return ["clang-cl", "cl.exe", "clang"]
    ["clang"]

fn _windows_strip_trailing_slashes_v1(path: text) -> text:
    var out = path
    while out.byte_len() > 1 and (out.ends_with("/") or out.ends_with("\\")):
        out = out.substring(0, out.byte_len() - 1)
    out

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_clang_env_dirs_v1(llvm_bin: text, llvm_mingw_root: text) -> [text]:
    """Explicit clang bin dirs probed BEFORE PATH on the GNU lane:
    SIMPLE_LLVM_BIN, then SIMPLE_LLVM_MINGW_ROOT/bin (same vars as the LLVM
    tool lookup's env_tool_dirs). The LLVM_SYS_* prefixes are deliberately
    absent: those are MSVC-targeted LLVM installs."""
    var dirs: [text] = []
    if llvm_bin != "":
        dirs.push(llvm_bin)
    if llvm_mingw_root != "":
        dirs.push(llvm_mingw_root + "/bin")
    dirs

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_mingw_clang_env_dirs_v1(llvm_bin: text, llvm_mingw_root: text, mingw_root: text) -> [text]:
    """Explicit clang bin dirs probed BEFORE PATH on the GNU lane:
    SIMPLE_LLVM_BIN, then SIMPLE_LLVM_MINGW_ROOT/bin, then SIMPLE_MINGW_ROOT/bin.
    Bootstrap and Git Bash env scripts (platform-detect.shs,
    windows-gitbash-bootstrap-env.shs, retain-ladder-seed-runtime.shs) export
    SIMPLE_MINGW_ROOT while p3 scripts export SIMPLE_LLVM_MINGW_ROOT; probing
    both (deduplicated) keeps GNU C-driver discovery consistent across lanes."""
    var dirs: [text] = []
    if llvm_bin != "":
        dirs.push(_windows_strip_trailing_slashes_v1(llvm_bin))
    if llvm_mingw_root != "":
        val lm_bin = _windows_strip_trailing_slashes_v1(llvm_mingw_root) + "/bin"
        if not dirs.contains(lm_bin):
            dirs.push(lm_bin)
    if mingw_root != "":
        val mg_bin = _windows_strip_trailing_slashes_v1(mingw_root) + "/bin"
        if not dirs.contains(mg_bin):
            dirs.push(mg_bin)
    dirs

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_llvm_mingw_home_bin_dirs_v1(home: text, entries: [text]) -> [text]:
    """Default GNU-lane toolchains: `{home}/.simple/toolchains/llvm-mingw-*-ucrt-x86_64/bin`,
    newest (lexically greatest date stamp) first. Installed by
    scripts/setup/bootstrap-prereqs.shs; probed before PATH and Program Files."""
    var names: [text] = []
    if home == "":
        return names
    for e in entries:
        val n = e.replace("\r", "").trim()
        if n.starts_with("llvm-mingw-") and n.ends_with("-ucrt-x86_64"):
            # insertion sort, descending
            var i = 0
            while i < names.len() and names[i] > n:
                i = i + 1
            names.insert(i, n)
    var dirs: [text] = []
    for n in names:
        dirs.push("{home}/.simple/toolchains/{n}/bin")
    dirs

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_clang_triple_is_msvc_v1(triple: text) -> bool:
    """`clang -dumpmachine` of an MSVC-flavoured LLVM (e.g. Program Files\\LLVM)
    ends in `-msvc`; its GNU link lacks libclang_rt.builtins.a."""
    triple.replace("\r", "").trim().ends_with("-msvc")

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn windows_only_msvc_llvm_diagnostic_v1(paths: [text]) -> text:
    "[cc-detect] error: only MSVC-flavoured LLVM found ({paths.join(', ')}); the default GNU lane needs llvm-mingw UCRT under ~/.simple/toolchains/llvm-mingw-*-ucrt-x86_64 (scripts/setup/bootstrap-prereqs.shs install), SIMPLE_MINGW_ROOT, SIMPLE_LLVM_MINGW_ROOT or SIMPLE_LLVM_BIN. MSVC LLVM is never used on this lane (--msvc selects the MSVC lane)."

fn _windows_home_llvm_mingw_dirs() -> [text]:
    var home = _env_text("USERPROFILE")
    if home == "":
        home = _env_text("HOME")
    if home == "":
        return []
    val root = "{_msys_drive_path(home)}/.simple/toolchains"
    val win_root = root.replace("/", "\\")
    val (out, err, code) = _cc_probe_run_retrying("dir /b /ad \"{win_root}\" 2>nul", [], true)
    if code != 0:
        return []
    windows_llvm_mingw_home_bin_dirs_v1(_msys_drive_path(home), out.split("\n"))

fn _windows_clang_is_msvc(cc: text) -> bool:
    val (out, err, code) = _cc_probe_run_retrying(cc, ["-dumpmachine"], false)
    code == 0 and windows_clang_triple_is_msvc_v1(out)

# reason: Windows C-driver probe helper exported for unit specs
@allow(primitive_api)
pub fn cc_probe_exit_is_transient_v1(code: i64) -> bool:
    """0xC0000142 STATUS_DLL_INIT_FAILED (signed or unsigned): a Windows process
    failed to START under memory / desktop-heap pressure. It says nothing about
    the compiler, so a probe that hits it is retried, never taken as a verdict."""
    code == -1073741502 or code == 3221225794

val _CC_PROBE_MAX_TRANSIENT_RETRIES = 3

fn _cc_probe_run_retrying(cmd: text, args: [text], shell: bool) -> (text, text, i64):
    """Run a detection probe, re-running it while it fails transiently (bounded)."""
    var attempt = 0
    while attempt < _CC_PROBE_MAX_TRANSIENT_RETRIES:
        val (out, err, code) = _cc_probe_run_once(cmd, args, shell)
        if not cc_probe_exit_is_transient_v1(code):
            return (out, err, code)
        attempt = attempt + 1
        print "[cc-detect] {cmd}: transient spawn failure exit={code}; retry {attempt}/{_CC_PROBE_MAX_TRANSIENT_RETRIES}"
    _cc_probe_run_once(cmd, args, shell)

fn _cc_probe_run_once(cmd: text, args: [text], shell: bool) -> (text, text, i64):
    if shell:
        return backend_shell_tuple(cmd)
    process_run(cmd, args)

fn _find_c_compiler_windows() -> text:
    """Find a C compiler on Windows: llvm-mingw clang by default, clang-cl /
    cl.exe only on the explicit MSVC lane (windows_c_compiler_candidates_v1).

    Every candidate is verified by actually compiling a trivial file
    (_cc_verify_compiles) — a `where` hit alone selects nothing."""
    val mingw = _is_mingw()
    var tried: [text] = []
    var msvc_only: [text] = []
    if mingw:
        for dir in windows_mingw_clang_env_dirs_v1(_env_text("SIMPLE_LLVM_BIN"), _env_text("SIMPLE_LLVM_MINGW_ROOT"), _env_text("SIMPLE_MINGW_ROOT")):
            val direct = "{_msys_drive_path(dir)}/clang.exe"
            tried.push(direct)
            if file_exists(direct):
                if _windows_clang_is_msvc(direct):
                    msvc_only.push(direct)
                elif _cc_verify_compiles(direct):
                    return direct
        # Default: ~/.simple/toolchains llvm-mingw UCRT, newest first, before PATH.
        for dir in _windows_home_llvm_mingw_dirs():
            val direct = "{dir}/clang.exe"
            tried.push(direct)
            if file_exists(direct):
                if _windows_clang_is_msvc(direct):
                    msvc_only.push(direct)
                elif _cc_verify_compiles(direct):
                    return direct

    # MSVC lane: clang-cl BEFORE cl.exe. cl.exe passes the trivial
    # _cc_verify_compiles probe and then cannot compile the C runtime at all:
    # measured 2026-09-01 on cl.exe 19.44.35228, src/runtime/runtime.c yields
    # C1189 ("C atomic support is not enabled" — stdatomic needs BOTH /std:c11
    # and /experimental:c11atomics), then C2099 non-constant initializers, then
    # C2143/C2091 on the GNU `__attribute__(...)` the runtime uses throughout.
    # clang-cl compiles the same file clean with the flags below. clang-cl is
    # also the compiler the stage-2 candidate itself was built with, so probing
    # the candidate with a DIFFERENT compiler than built it is its own defect.
    # These are reached ONLY on the MSVC lane; the default lane is clang-only.
    for candidate in windows_c_compiler_candidates_v1(if mingw: "gnu" else: "msvc"):
        tried.push(candidate)
        val resolved = _first_verified_windows_compiler(candidate, mingw)
        if resolved.starts_with("msvc:"):
            msvc_only.push(resolved.substring(5))
        elif resolved != "":
            return resolved
    if mingw and msvc_only.len() > 0:
        print windows_only_msvc_llvm_diagnostic_v1(msvc_only)
        return ""

    # Returning "" here yields the bare message "No C compiler found" at two
    # DIFFERENT call sites with identical text, and names neither the
    # candidates tried nor the temp dir the probe used. That cost a full
    # bootstrap cycle to re-diagnose. Always say what was attempted.
    print "[cc-detect] no C compiler verified on Windows."
    print "[cc-detect] temp dir: {_get_temp_dir()}"
    print "[cc-detect] tried: {tried.join(', ')} (each `where` + a real compile; gcc is never used)"
    if mingw:
        print "[cc-detect] default lane is llvm-mingw clang: set SIMPLE_MINGW_ROOT or SIMPLE_LLVM_MINGW_ROOT (or SIMPLE_LLVM_BIN) or put its bin on PATH; clang-cl/cl.exe need the MSVC lane (--msvc / SIMPLE_WINDOWS_ABI=msvc)"
    print "[cc-detect] set SIMPLE_CC to override, or SIMPLE_COMPILER_TRACE=1 for per-candidate exit codes"
    ""

fn _first_verified_windows_compiler(candidate: text, gnu_lane: bool) -> text:
    """Return the first executable reported by `where` that really compiles.

    `where` may report multiple installations. Verifying the bare candidate
    name only retries the first PATH hit and can never reach a later healthy
    toolchain when the first executable has a missing DLL.
    On the GNU lane an MSVC-flavoured clang (`-dumpmachine` ends in -msvc) is
    skipped; if nothing else works, returns "msvc:<path>" so the caller can
    name it instead of producing a broken GNU link."""
    val (out, err, code) = _cc_probe_run_retrying("where {candidate} 2>nul", [], true)
    if code != 0:
        return ""
    var msvc_hit = ""
    for path in out.split("\n"):
        val resolved = path.trim()
        if resolved == "":
            continue
        if gnu_lane and _windows_clang_is_msvc(resolved):
            if msvc_hit == "":
                msvc_hit = resolved
            continue
        if _cc_verify_compiles(resolved):
            return resolved
    if msvc_hit != "":
        return "msvc:" + msvc_hit
    ""

# ============================================================================
# Runtime Source Directory Discovery
# ============================================================================

pub fn _runtime_dir_walk_up(start: text) -> text:
    """Walk upward from an absolute path looking for src/runtime/runtime.c.

    Returns the matching `<root>/src/runtime` or "" when no ancestor holds it.
    Used for both the executable location and the cwd so that resolution does
    not depend on how deep inside (or outside) the tree the tool was invoked.
    """
    if start.len() == 0 or not start.starts_with("/"):
        return ""
    val parts = start.split("/")
    var depth = parts.len()
    while depth > 0:
        var prefix = ""
        var i = 0
        while i < depth:
            if parts[i] != "":
                prefix = "{prefix}/{parts[i]}"
            i = i + 1
        if prefix != "":
            if file_exists("{prefix}/src/runtime/runtime.c"):
                return "{prefix}/src/runtime"
        depth = depth - 1
    ""

pub fn find_runtime_source_dir() -> text:
    """Find the runtime source directory, independent of the current directory.

    Order: SIMPLE_PROJECT_ROOT, then src/runtime/ directly under cwd, then an
    upward walk from the running executable's own path, then an upward walk
    from cwd. The executable walk is what makes this cwd-independent: the
    deployed binary lives at <root>/bin/release/<triple>/simple, so any
    fixed-depth `dirname` chain (the previous approach) lands on <root>/bin and
    misses the tree entirely.
    Returns the path or empty string if not found.
    """
    if native_tool_strict_requested_v1():
        # @workaround bug=unknown_call_origin_driver_hir_archive_stage3_2026-11-13 reason=bare unimported env_get resolves to the HIR interpreter-builtin fallback symbol, which has no MIR call origin (Unknown -> codegen SIGABRT); call the imported env_get_nullable
        if (env_get_nullable("SIMPLE_MANAGED_PHASE4_SOURCE_ROOT") ?? "") != "":
            match native_runtime_strict_source_dir_v1():
                case Ok(path): return path
                case Err(_): return ""
        # Source authority NOT configured for this invocation. The stage2/3
        # phase-C rows run managed tools + runtime-archive admission but pin
        # the runtime C sources at the HARNESS level (sealed target-c
        # binding + source_snapshot_sha256 checks in
        # bootstrap-phase-verification.shs), never exporting
        # SIMPLE_MANAGED_PHASE4_SOURCE_ROOT -- so the in-process source pin
        # cannot be satisfied and hard-failing here kills every strict
        # runtime C compile ('managed runtime authority root invalid' at
        # native_runtime_authority_v1.spl, first hit by the v35
        # test_runner_build link row). Fall through to the legacy search;
        # a CONFIGURED-but-invalid source authority keeps the hard error
        # above, so a phase4 lane that lost its env still fails loud.
    # Try SIMPLE_PROJECT_ROOT env var first so tests and callers can force
    # deterministic resolution even when cwd also contains src/runtime.
    val project_root = _msys_drive_path(env_get_nullable("SIMPLE_PROJECT_ROOT") ?? "")
    if project_root != "":
        val rt_path = "{project_root}/src/runtime/runtime.c"
        if file_exists(rt_path):
            return "{project_root}/src/runtime"

    # Try relative to current working directory
    if file_exists("src/runtime/runtime.c"):
        return "src/runtime"

    # Unix-only: walk up from the executable location.
    if not _is_windows():
        # Canonicalize in-process. Inside `sh -c`, /proc/self is the shell, so
        # a shell-out here reports the shell's path, not ours (2026-07-25).
        val exe_path = rt_path_absolute("/proc/self/exe") ?? ""
        if exe_path.len() > 0 and exe_path != "/proc/self/exe":
            val from_exe = _runtime_dir_walk_up(exe_path)
            if from_exe != "":
                return from_exe

    # Walk up from the current working directory: covers running from a nested
    # subdirectory of the tree.
    val cwd = rt_path_absolute(".") ?? ""
    val from_cwd = _runtime_dir_walk_up(cwd)
    if from_cwd != "":
        return from_cwd

    ""

pub fn _runtime_dir_not_found_message() -> text:
    """Honest diagnostic for a failed runtime-source lookup."""
    # Typed vars + statements only (bug native_build_inprocess_link_access_violation_2026-11-05):
    # on Windows `rt_path_absolute("/proc/self/exe")` is nil, and the native
    # lane rendered the `?? "<unknown>"` / Option if-expression results as a
    # non-text handle, so the first concat strlen'd garbage and the worker
    # died 0xC0000005 instead of reporting this message.
    var cwd: text = "<unknown>"
    val cwd_abs = rt_path_absolute(".")
    if cwd_abs != nil:
        cwd = cwd_abs.unwrap()
    var exe_path: text = "<unknown>"
    if not _is_windows():
        val exe_abs = rt_path_absolute("/proc/self/exe")
        if exe_abs != nil:
            exe_path = exe_abs.unwrap()
    var pr: text = "<unset>"
    val project_root = env_get_nullable("SIMPLE_PROJECT_ROOT")
    if project_root.is_some():
        val root_text: text = project_root.unwrap()
        if root_text != "":
            pr = root_text
    var msg = "Runtime source directory not found: no src/runtime/runtime.c under the current directory ({cwd}), "
    msg = msg + "under any ancestor of it, or under any ancestor of the running executable ({exe_path}). "
    msg = msg + "SIMPLE_PROJECT_ROOT={pr} - set SIMPLE_PROJECT_ROOT to the repository root to resolve this explicitly."
    msg

# ============================================================================
# Runtime Compilation
# ============================================================================

# ============================================================================
# Runtime Object Cache
# ============================================================================

fn _runtime_object_cache_dir(rt_dir: text, cc: text, opt_level: i64, include_dynload: bool, include_stage4_legacy_compat: bool, target: text, ext: text, abi_policy: text, sources: [text], runtime_profile: text, legacy_owner: bool, runtime_owner: text, alloc_observer: bool = false, vector_pin: text = "", xray_thread_context_v1: bool = false) -> text:
    """Directory holding prebuilt C-runtime objects for this exact input set.

    The C runtime was recompiled from source on EVERY native build: 27
    `clang -c` invocations, serially, into a PID-keyed temp prefix that was
    then deleted. Landed as 71347b901b6 (2026-08-23, LINKPERF: 103s of a 108s
    hello-world build) and clobbered by the f1e0fff1662 merge restore; re-
    measured 2026-08-28 on the stage2 pure-Simple binary: 27 clang execs,
    53s of a 57s hello-world native-build, byte-identical on a warm rerun.
    This is a pure memo: the key covers the compiler, every flag-affecting
    option, the target, and the sha256 of the CONTENT of every .c/.h under
    the runtime source tree (content, not size+mtime, so it cannot go stale),
    so any change to any input misses the cache and recompiles. Returns ""
    when caching is unavailable or disabled (SIMPLE_RT_OBJ_CACHE=0), in which
    case the caller compiles exactly as before.
    """
    if native_tool_strict_requested_v1() or (env_get_nullable("SIMPLE_RT_OBJ_CACHE") ?? "") == "0":
        return ""
    if _is_windows():
        return ""
    # VERIFY (2026-08-28): `riscv_vec` and `host_arch` close two key holes found
    # auditing this memo. `SIMPLE_RUNTIME_RISCV64_VECTOR=1` adds
    # `-march=rv64gcv -mabi=lp64d` to runtime_simd_dispatch.c, and
    # `host_arch()` adds `-mno-outline-atomics` when target == "host" on
    # aarch64 -- both change the emitted object while leaving every other key
    # input identical, so without them a flag flip would hit a stale object.
    # Adding inputs to the key can only cause MORE misses, never fewer.
    val riscv_vec = env_get_nullable("SIMPLE_RUNTIME_RISCV64_VECTOR") ?? ""
    var source_sig = ""
    for name in sources:
        source_sig = source_sig + ";" + name
    val timestamp_owner = runtime_profile == "core-c-bootstrap" or alloc_observer
    val base_flag_sig = "v8;alloc_observer_v1={alloc_observer};profile={runtime_profile};sources={source_sig};timestamp_owner={timestamp_owner};legacy_owner={legacy_owner};cc={cc};opt={opt_level};dyn={include_dynload};legacy={include_stage4_legacy_compat};target={target};ext={ext};rt_dir={rt_dir};riscv_vec={riscv_vec};host_arch={host_arch()};abi_policy={abi_policy};runtime_owner={runtime_owner};{runtime_vector_provider_pin_cache_sig_v1(vector_pin)}"
    val flag_sig = base_flag_sig + runtime_xray_context_cache_suffix_v1(Enabled(value: xray_thread_context_v1))
    val cmd = runtime_posix_cache_fingerprint_command_v1(rt_dir, cc, flag_sig, host_os())
    val (out, err, code) = backend_shell_tuple(cmd)
    if code != 0:
        return ""
    val key = out.trim()
    if key.len() < 16:
        return ""
    val root = env_get_nullable("SIMPLE_RT_OBJ_CACHE_DIR") ?? ""
    val base = if root != "": root else: "{_get_temp_dir()}/simple-rt-objcache"
    val dir = base + "/" + key
    val (mout, merr, mcode) = backend_shell_tuple("mkdir -p '" + dir + "'")
    if mcode != 0:
        return ""
    dir

pub fn runtime_vector_provider_pin_from_env_v1() -> Result<text, text>:
    """Build-time pin of the levelled vector provider DLL this build produced.

    Read from SIMPLE_VECTOR_PROVIDER_DEFAULT_SHA256 (set by the bootstrap
    after it builds the host provider). Unset/empty => "" (no pin: the
    runtime keeps its scalar default). A malformed value fails the build
    instead of baking a pin that can never match.
    """
    val pin = env_get_nullable("SIMPLE_VECTOR_PROVIDER_DEFAULT_SHA256") ?? ""
    if pin == "":
        return Ok("")
    if not sha256_lower_hex_valid(pin):
        return Err("SIMPLE_VECTOR_PROVIDER_DEFAULT_SHA256 must be 64 lowercase hex digits")
    Ok(pin)

pub fn runtime_vector_provider_pin_defines_v1(name: text, pin: text, msvc: bool) -> [text]:
    """Defines baking the provider pin, only into the loader-owning TU."""
    if pin == "" or name != "runtime_simd_utf8":
        return []
    val flag = if msvc: "/D" else: "-D"
    [flag + "SIMPLE_VECTOR_PROVIDER_PIN_HEX=" + pin]

pub fn runtime_vector_provider_pin_cache_sig_v1(pin: text) -> text:
    """Object-cache key term: a different or absent pin never reuses objects."""
    if pin == "":
        return "vector_pin=none"
    "vector_pin=" + pin

pub fn runtime_cache_stage_object_v1(cache_obj: text, obj_path: text) -> bool:
    """Stage one immutable cache object without copying its bytes when possible.

    The cache directory is already keyed by the exact runtime source content,
    compiler identity/version, target, ABI policy, provider selection, and
    code-generation flags.  A hard link therefore preserves the same object
    bytes and Mach-O/ELF/COFF ABI as the former copy while avoiding redundant
    reads and writes.  Cross-device and unsupported-filesystem cases retain
    the byte-copy fallback.
    """
    val (_, _, link_code) = process_run("ln", ["-f", cache_obj, obj_path])
    if link_code == 0:
        return true
    file_copy(cache_obj, obj_path)

pub fn runtime_cache_stage_bytes_v1(object_sizes: [i64], hard_linked: bool) -> i64:
    """Model bytes copied while staging a complete warm runtime cache hit."""
    if hard_linked:
        return 0
    var copied: i64 = 0
    for size in object_sizes:
        if size > 0:
            copied = copied + size
    copied

pub fn runtime_object_profile_v1(runtime_bundle: text, stage4_legacy: bool) -> text:
    """Closed composition identity: aliases share owners, Stage4 stays distinct."""
    if stage4_legacy:
        return "stage4-legacy"
    match runtime_bundle:
        case "core-c-alloc-observer-v1": "core-c-alloc-observer-v1"
        case "core-c-bootstrap": "core-c-bootstrap"
        case "core_c_bootstrap": "core-c-bootstrap"
        case "core-c": "core-c-bootstrap"
        case "core_c": "core-c-bootstrap"
        case _: "ordinary"

pub fn runtime_core_c_sources_v1() -> [text]:
    """Standalone hosted C owners, sharing the portable seed core-C composition.

    runtime.c is excluded: its monolithic exports collide with runtime_native
    and the narrow core provider owners. Extra existing media/device providers
    retain their C ABI; this profile never adds Rust archives or trap stubs.
    """
    ["runtime_native", "runtime_alloc_observer", "runtime_core_intrinsics", "runtime_file_view", "runtime_disk_headroom", "runtime_memory_headroom", "runtime_cache_host_authority_v1", "runtime_framebuffer", "runtime_directx_core", "runtime_legacy_core", "runtime_core_io_exports", "runtime_core_host_services", "runtime_fork", "runtime_memtrack", "runtime_process", "runtime_process_tree", "runtime_memory", "runtime_process_owned", "runtime_coverage_core", "runtime_contracts", "runtime_font", "runtime_thread", "runtime_simd_utf8", "runtime_simd_case", "runtime_simd_search", "runtime_simd_dispatch", "runtime_packed_span", "runtime_terminal", "runtime_prof_sample", "runtime_core_exports", "runtime_backend_plugin", "runtime_rocm", "runtime_renderdoc", "runtime_timestamp", "runtime_glfw", "runtime_sdl2", "runtime_sdl3", "runtime_audio", "runtime_image", "runtime_socket_nonblock", "counterpart_abi_runtime", "runtime_cranelift_bridge_stub"]

pub fn runtime_core_c_target_os_v1(target: text, host_windows: bool, host_os_name: text) -> text:
    """Which core-C platform owner set a native target takes: windows, linux or other.

    Android triples (`*-linux-android`) stay `other`: its async backend has
    not been compiled or linked through this list.
    """
    if target.contains("-windows") or (target == "host" and host_windows):
        return "windows"
    if target.contains("-linux-gnu") or target.contains("-linux-musl") or (target == "host" and host_os_name == "linux"):
        return "linux"
    if target.contains("-darwin") or (target == "host" and host_os_name == "macos"):
        return "macos"
    "other"

pub fn runtime_core_c_platform_sources_v1(target_os: text) -> [text]:
    """Per-OS async driver owners for the core-C composition.

    platform/async_driver.c owns the rt_driver_* exports and dispatches to
    one OS backend; on Windows that is platform/async_windows.c
    (spl_driver_create_iocp). The phase-3 stage3 link needed both and the
    baked list omitted them (bug stage2_runtime_missing_rt_heap_aux_live_bytes
    _2026-11-02 sibling). On Linux the dispatch probes io_uring and falls back
    to epoll, so both owners are linked; without SPL_HAS_IO_URING (never set
    here, no liburing) async_linux_uring.c is its stub that returns NULL. The
    aarch64 Stage 3 core-C link (2026-11-15) failed on 10 rt_driver_* symbols
    without them. FreeBSD/macOS kqueue owners are not yet admitted: they have
    not been compiled or linked through this list.
    """
    if target_os == "windows":
        return ["platform/async_driver", "platform/async_windows"]
    if target_os == "linux":
        return ["platform/async_driver", "platform/async_linux_epoll", "platform/async_linux_uring"]
    if target_os == "macos":
        return ["platform/async_driver", "platform/async_macos"]
    []

pub fn runtime_object_basename_v1(name: text) -> text:
    """Flat object basename for a runtime source that may live in a subdir."""
    name.replace("/", "_")

pub fn runtime_thread_rust_owner_v1(runtime_owner: text, include_dynload: bool,
        core_c_profile: bool, coff_host: bool, target: text) -> bool:
    """The `rust` arm of the runtime owner switch (--runtime-owner=rust).

    The sole caller passes include_dynload=false exactly when the link also
    takes simple_native_all. On COFF, rustc's merged-function aliases put
    rt_thread_id_limited / rt_thread_is_done_limited in the same COMDAT as
    Rust's rt_thread_id / rt_thread_is_done; if this C copy wins those names
    lld-link discards the section and the aliases with it, so under the rust
    owner the C handle family compiles under private names. The default `c`
    owner instead cedes the Rust copies (coff_runtime_owner.spl), and ELF
    never discards the losing definition's section.
    """
    if runtime_owner != "rust": return false
    if include_dynload or core_c_profile: return false
    coff_host or target.contains("-windows-")

pub fn runtime_bundle_nested_c_include_v1(source_text: text, bundle: [text]) -> text:
    """Name the bundle member that `source_text` textually `#include`s as a `.c`
    translation unit, or "" when it includes none.

    Only a preprocessor line counts: `#include "x.c"` (any spacing after the
    `#`). Header includes, `<...>` system includes, and prose that merely
    mentions a `.c` file inside a comment (runtime_process_owned.c:369 cites
    `rt_proc_start_time (runtime_process_tree.c)`) never match. The included
    path is matched against the bundle names as spelled in the source lists
    (`runtime_process_tree`, `platform/async_windows`), so a `.c` include of a
    file the bundle does NOT compile separately is allowed -- that is exactly
    the frozen-stage2 process-tree shadow (stage2-runtime-process-tree-shadow.shs),
    whose source list omits runtime_process_tree.
    """
    for raw_line in source_text.split("\n"):
        val line = raw_line.trim()
        if not line.starts_with("#"):
            continue
        val directive = line.substring(1, line.byte_len()).trim()
        if not directive.starts_with("include"):
            continue
        val open_quote = directive.find("\"")
        if open_quote < 0:
            continue
        val after_open = directive.substring(open_quote + 1, directive.byte_len())
        val close_quote = after_open.find("\"")
        if close_quote < 0:
            continue
        val included = after_open.substring(0, close_quote)
        if not included.ends_with(".c"):
            continue
        val stem = included.substring(0, included.byte_len() - 2)
        for name in bundle:
            if name == stem:
                return name
    ""

pub fn runtime_bundle_duplicate_owner_sources_v1(rt_dir: text, sources: [text]) -> [text]:
    """Every bundle source that would define another bundle member's exports a
    second time, as `"<a>.c includes <b>.c"` lines.

    Incident 2026-11-04: a stale shadow root (SIMPLE_PROJECT_ROOT pointing at a
    stage2 process-tree shadow) carried runtime_process_owned.c with
    `#include "runtime_process_tree.c"` appended, while the core-C list already
    compiled runtime_process_tree.c on its own. Both objects then exported
    rt_process_tree_support, rt_process_spawn_session, rt_process_kill_tree,
    rt_proc_start_time, ... and every link of the stage3 output died on
    `duplicate symbol` with no hint of which root was stale. The source lists
    are the authority on which translation units own which exports, so the
    overlap is detectable before a compiler runs. Missing sources are not
    reported here; the compile loop already rejects them by name.
    """
    var offenders: [text] = []
    for name in sources:
        val src_path = "{rt_dir}/{name}.c"
        if not file_exists(src_path):
            continue
        val nested = runtime_bundle_nested_c_include_v1(file_read(src_path), sources)
        if nested != "":
            offenders = offenders.push("{name}.c includes {nested}.c")
    offenders

pub fn runtime_object_paths_v1(sources: [text], prefix: text, ext: text) -> [text]:
    """Keep each object basename paired with the source that produced it."""
    var objects: [text] = []
    for name in sources:
        objects = objects.push("{prefix}{runtime_object_basename_v1(name)}{ext}")
    objects

pub fn compile_runtime_objects(verbose: bool, opt_level: i64, include_dynload: bool = true, compiler: text = "", include_stage4_legacy_compat: bool = false, runtime_bundle: text = "", runtime_owner: text = "c", xray_thread_context_v1: bool = false) -> Result<[text], text>:
    """Compile all C runtime source files to object files.

    The selected core-c-bootstrap profile excludes runtime.c and uses the
    portable standalone C owners; other profiles retain their source lists.
    Compiles runtime_native.c, runtime_rocm.c, runtime_directx_core.c, runtime_thread.c,
    runtime_memtrack.c, runtime_timestamp.c, runtime_fork.c, runtime_process.c, runtime_prof_sample.c
    with appropriate flags for linking with LLVM-generated code.

    Preserves the caller's optimization level across runtime object compilation.
    Returns a list of object file paths on success, or an error message.
    """
    val alloc_observer = runtime_bundle == "core-c-alloc-observer-v1"
    val vector_pin_result = runtime_vector_provider_pin_from_env_v1()
    if vector_pin_result.is_err():
        return Err(vector_pin_result.unwrap_err())
    val vector_pin = vector_pin_result.unwrap()
    if alloc_observer and (host_os() != "linux" or runtime_owner != "c" or include_stage4_legacy_compat):
        return Err("allocation observer v1 requires native Linux core-C owner without Stage4/archive providers")
    val trace = runtime_compile_trace_enabled()
    if trace:
        print "[RT-COMPILE] enter compile_runtime_objects"
    # @workaround bug=stage2_try_unwrap_text_typed_as_i64_2026-11-02 reason=frozen stage2 ef0681fc0e1 decodes a `?`-unwrapped Result<text,_> payload as an i64 local (handle rendered as digits / compared as int); bind through a typed match
    var cc: text = ""
    if native_tool_strict_requested_v1():
        cc = match native_tool_strict_resolve_v1("cc"):
            case Ok(v): v
            case Err(e): return Err(e)
    elif compiler != "":
        cc = compiler
    else:
        cc = find_c_compiler()
    if native_tool_strict_requested_v1() and compiler != "" and compiler != cc:
        return Err("runtime C compiler differs from admitted tool")
    if trace:
        print "[RT-COMPILE] cc={cc}"
    if cc == "":
        return Err("No clang C compiler found (clang-only toolchain, gcc is never used). Source scripts/setup/llvm-toolchain-env.shs or set SIMPLE_CC=clang-23.")

    # The nested if-expression form compiled (Stage 2, full closure) with an
    # i64 result: "{rt_dir}/{name}.c" rendered the text handle as a decimal
    # and every hosted link failed "Required runtime source not found:
    # 202444832811553/runtime_native.c". A typed var + statements keeps text.
    # The strict + configured-root arm calls the authority directly (one call)
    # so its real Err text reaches the caller.
    # @workaround bug=if_expression_text_result_erased_to_i64_2026-10-25 reason=nested_if_with_try_lost_text_type
    var rt_dir: text = ""
    # @workaround bug=unknown_call_origin_driver_hir_archive_stage3_2026-11-13 reason=bare unimported env_get resolves to the HIR interpreter-builtin fallback symbol, which has no MIR call origin (Unknown -> codegen SIGABRT); call the imported env_get_nullable
    if native_tool_strict_requested_v1() and (env_get_nullable("SIMPLE_MANAGED_PHASE4_SOURCE_ROOT") ?? "") != "":
        # @workaround bug=stage2_try_unwrap_text_typed_as_i64_2026-11-02 reason=frozen stage2 ef0681fc0e1 decodes a `?`-unwrapped Result<text,_> payload as an i64 local (handle rendered as digits / compared as int); bind through a typed match
        val trytext_54: text = match native_runtime_strict_source_dir_v1():
            case Ok(v): v
            case Err(e): return Err(e)
        rt_dir = trytext_54
    else:
        rt_dir = find_runtime_source_dir()
    rt_dir = _msys_drive_path(rt_dir)
    if trace:
        print "[RT-COMPILE] rt_dir={rt_dir}"
    if rt_dir == "":
        return Err(_runtime_dir_not_found_message())

    # runtime_sdl2 joins the default set now that it dlopens SDL2 at first use
    # instead of binding it at link time: it needs no SDL2 headers to compile and
    # no -lSDL2 to link, so hosts without SDL2 still build. Leaving it out was why
    # a native build could not resolve the rt_sdl2_* family at all.
    # runtime_audio joins the default set for the same reason: it was entirely
    # absent from this list, so a native build had no path to the real
    # miniaudio-backed rt_audio_* implementation either (31 names, see
    # doc/08_tracking/bug/interpreter_extern_unreachable_names.md bucket (a)).
    # It needs no extra link flags -- -lpthread/-ldl/-lm are already
    # unconditionally passed below for runtime_thread.c et al.
    # runtime_framebuffer/runtime_image close their bucket (a) providers.
    # runtime_socket_nonblock supplies only prepare/commit/mask syscalls for
    # the canonical Pure-Simple rt_socket_set_nonblocking owner.
    # The remaining bucket (a) log-lib names (rt_simpleos_log_*/
    # rt_log_target_*) were fixed only on the interpreter-crate side
    # (src/compiler_rust/runtime/build.rs); their C source
    # (startup/common/runtime_log_hosted.c) lives one directory down, which
    # this array's flat `{rt_dir}/{name}.c` naming does not support without
    # also teaching the object-path builder below to create nested
    # directories -- left as a follow-up, not silently dropped.
    var sources = ["runtime", "runtime_native", "runtime_alloc_observer", "runtime_file_view", "runtime_disk_headroom", "runtime_memory_headroom", "runtime_backend_plugin", "runtime_contracts", "runtime_coverage_core", "runtime_rocm", "runtime_renderdoc", "runtime_directx_core", "runtime_thread", "runtime_memtrack", "runtime_timestamp", "runtime_fork", "runtime_process", "runtime_process_tree", "runtime_process_owned", "runtime_memory", "runtime_simd_utf8", "runtime_simd_search", "runtime_simd_case", "runtime_simd_dispatch", "runtime_packed_span", "runtime_font", "runtime_glfw", "runtime_sdl2", "runtime_sdl3", "runtime_audio", "runtime_framebuffer", "runtime_image", "runtime_socket_nonblock", "counterpart_abi_runtime", "runtime_terminal", "runtime_prof_sample"]
    # Stage4 retains its separately admitted provider projection composition.
    val runtime_profile = runtime_object_profile_v1(runtime_bundle, include_stage4_legacy_compat)
    val core_c_profile = runtime_profile == "core-c-bootstrap" or alloc_observer
    if core_c_profile:
        sources = runtime_core_c_sources_v1()
        if host_os() == "linux":
            # Existing portable compositor non-target owners, as in tools.rs.
            sources = sources.push("hosted_cocoa")
            sources = sources.push("hosted_win32")
    val tmp_dir = _get_temp_dir()
    val ext = _obj_ext()
    val use_msvc = _is_msvc_cc(cc)
    val compile_pid = getpid()
    val target = env_get_nullable("SIMPLE_NATIVE_BUILD_TARGET") ?? "host"
    if core_c_profile:
        val target_os = runtime_core_c_target_os_v1(target, _is_windows(), host_os())
        for platform_source in runtime_core_c_platform_sources_v1(target_os):
            sources = sources.push(platform_source)
    val context_policy = runtime_xray_context_validate_v1(xray_thread_context_v1, target, host_os(),
        runtime_owner, core_c_profile, include_stage4_legacy_compat)
    if context_policy.is_err(): return Err(context_policy.unwrap_err())
    if alloc_observer and target != "host":
        return Err("allocation observer v1 requires startup-linked native host target")
    val abi_policy = match runtime_abi_policy_v1():
        case Ok(selected): selected
        case Err(reason): return Err(reason)
    val abi_defines = runtime_abi_define_args_v1(abi_policy, use_msvc)
    if abi_defines.len() != 2:
        return Err("SIMPLE_ABI_POLICY '{abi_policy}' has no canonical runtime ABI defines")
    val object_prefix = "{tmp_dir}/simple_rt_{compile_pid}_{target}_"
    if include_stage4_legacy_compat:
        sources = sources.push("runtime_legacy_core")
    if include_dynload:
        sources = sources.push("runtime_dynload")
    if include_stage4_legacy_compat and host_os() == "linux" and include_dynload:
        # Stage4 offers the checked SQLite bridge as a selectable runtime
        # owner. The provider library itself stays outside the executable and
        # is admitted on first SQLite use.
        sources = sources.push("runtime_sqlite_demand")
    var legacy_owner = false
    for name in sources:
        if name == "runtime_legacy_core":
            legacy_owner = true
    val nested_owners = runtime_bundle_duplicate_owner_sources_v1(rt_dir, sources)
    if nested_owners.len() > 0:
        val nested_list = nested_owners.join("; ")
        return Err("runtime bundle '{runtime_profile}' would define its exports twice ({nested_list}) in {rt_dir}; the runtime source dir carries a stale stage2 process-tree shadow include -- point SIMPLE_PROJECT_ROOT (or cwd) at a checkout whose src/runtime matches this compiler")
    val objects = runtime_object_paths_v1(sources, object_prefix, ext)
    var object_count = 0
    val cache_dir = _runtime_object_cache_dir(
        rt_dir, cc, opt_level, include_dynload,
        include_stage4_legacy_compat, target, ext, abi_policy, sources, runtime_profile, legacy_owner, runtime_owner, alloc_observer, vector_pin, xray_thread_context_v1)
    var windows_cache_root = ""
    var windows_toolchain = ""
    var windows_compiler_digest = ""
    var windows_pending_keys: [text] = []
    var windows_published_any = false
    # Both Windows drivers (clang-cl and llvm-mingw clang.exe) use the content
    # cache; the toolchain identity is "" (uncached) for any other compiler.
    if _is_windows() and not native_tool_strict_requested_v1() and (env_get_nullable("SIMPLE_RT_OBJ_CACHE") ?? "") != "0":
        windows_cache_root = env_get_nullable("SIMPLE_RT_OBJ_CACHE_DIR") ?? ""
        if windows_cache_root == "":
            val local_data = env_get_nullable("LOCALAPPDATA") ?? ""
            if local_data != "": windows_cache_root = local_data + "/Simple/cache/runtime-objects-v1"
        if windows_cache_root != "":
            windows_cache_root = _msys_drive_path(windows_cache_root)
            windows_compiler_digest = file_hash_sha256_or_empty(cc)
            windows_toolchain = runtime_windows_cache_toolchain_v1(windows_cache_root, cc)
    if trace:
        print "[RT-COMPILE] object cache dir={cache_dir}"
    val rt_parallel_workers = runtime_c_compile_workers_v1(sources.len())
    val rt_parallel_eligible = rt_parallel_workers >= 2 and windows_toolchain == "" and not native_tool_strict_requested_v1()
    var resolved_objects: [text] = []
    var rt_pending_slots: [i64] = []
    var rt_pending_names: [text] = []
    var rt_pending_srcs: [text] = []
    var rt_pending_objs: [text] = []
    var rt_pending_caches: [text] = []
    var rt_pending_argvs: [[text]] = []
    if trace:
        print "[RT-COMPILE] starting loop over {sources.len()} sources (workers={rt_parallel_workers})"

    for name in sources:
        if trace:
            print "[RT-COMPILE] processing: {name}"
        val src_path = "{rt_dir}/{name}.c"
        if trace:
            print "[RT-COMPILE] checking existence of {src_path}"
        if not file_exists(src_path):
            cleanup_runtime_objects(objects)
            return Err("Required runtime source not found: {src_path}")

        val obj_path = objects[object_count]
        if trace:
            print "[RT-COMPILE] compiling: {name}.c"

        var comp_args: [text] = []
        if use_msvc:
            # MSVC cl.exe flags (/Gy enables function-level linking for /OPT:REF)
            val msvc_opt = if opt_level <= 0: "/Od" elif opt_level == 1: "/O1" elif opt_level == 2: "/O2" else: "/Ox"
            # /std:c11 is required: the runtime uses <stdatomic.h>, which the MS
            # CRT header guards behind C11 (fatal C1189 otherwise). clang-cl
            # accepts it and it matches the -std=gnu11 the clang branch passes.
            comp_args = ["/c", msvc_opt, "/Gy", "/MD", "/std:c11", "/I", rt_dir, "/I", "{rt_dir}/platform", "/Fo{obj_path}", src_path]
            if core_c_profile:
                for abi_define in abi_defines:
                    comp_args.push(abi_define)
                comp_args.push("/DSIMPLE_RUNTIME_TIMESTAMP_OWNER=1")
                comp_args.push("/DSIMPLE_RUNTIME_NO_RUST_ARRAY_PACKING=1")
            # runtime_memory.c is always in this bundle and canonically owns
            # the overlapping allocator/pointer ABI, including native-all.
            comp_args.push("/DSIMPLE_RUNTIME_MEMORY_OWNER=1")
            if runtime_thread_rust_owner_v1(runtime_owner, include_dynload, core_c_profile, true, target):
                comp_args.push("/DSIMPLE_RUNTIME_THREAD_RUST_OWNER=1")
            if include_dynload or core_c_profile:
                # Only the standalone core-C composition may suppress hosted
                # providers. native-all needs runtime_native/thread/process
                # hosted fallbacks even though runtime_memory remains present.
                comp_args.push("/DSIMPLE_CORE_C_STANDALONE=1")
                # runtime_dynload.c is in this bundle and owns spl_dlopen/
                # spl_dlsym/spl_dlclose. Compile runtime_native.c's per-lane
                # fallback copies out so exactly ONE definition ships.
                if include_dynload:
                    comp_args.push("/DSIMPLE_RUNTIME_DYNLOAD_OWNER=1")
                # Select the CPU-count owner from the actual legacy provider.
                # The ordinary composition sets SIMPLE_CORE_C_STANDALONE but does NOT
                # include runtime_legacy_core.c (see include_stage4_legacy_compat
                # below), and legacy_core.c is the sole owner of
                # spl_thread_cpu_count under that define -- so without this the
                # link fails with `runtime_thread.obj : error LNK2019:
                # unresolved external symbol spl_thread_cpu_count referenced in
                # function rt_pool_get_parallelism` (measured 2026-09-02). State
                # the ownership explicitly rather than letting runtime_thread.c
                # guess from the platform.
                if not legacy_owner:
                    comp_args.push("/DSIMPLE_RUNTIME_THREAD_CPU_COUNT_OWNER=1")
        else:
            # GCC/Clang flags (-fPIC only on Unix, not needed on Windows)
            # -ffunction-sections -fdata-sections: emit each function/data in its own
            # section so the linker's --gc-sections can strip unreferenced code.
            comp_args = ["-c"]
            if hosted_c_target_is_mingw(target):
                comp_args.push("--target=" + hosted_mingw_clang_target(target))
            else:
                for target_arg in hosted_cross_c_target_args(target, host_os(), host_arch()):
                    comp_args.push(target_arg)
            for abi_define in abi_defines:
                comp_args.push(abi_define)
            if not _is_windows():
                comp_args.push("-fPIC")
            val cc_opt = if opt_level <= 0: "-O0" elif opt_level == 1: "-Oz" elif opt_level == 2: "-O2" else: "-O3"
            comp_args.push(cc_opt)
            comp_args.push("-ffunction-sections")
            comp_args.push("-fdata-sections")
            comp_args.push("-std=gnu11")
            # Keep runtime_memory.c as the sole allocator/pointer ABI owner in
            # both dynload and native-all/non-dynload compositions.
            comp_args.push("-DSIMPLE_RUNTIME_MEMORY_OWNER=1")
            if alloc_observer:
                comp_args.push("-DSIMPLE_ALLOC_OBSERVER_V1=1")
            if runtime_thread_rust_owner_v1(runtime_owner, include_dynload, core_c_profile, _is_windows(), target):
                comp_args.push("-DSIMPLE_RUNTIME_THREAD_RUST_OWNER=1")
            if core_c_profile:
                comp_args.push("-DSIMPLE_RUNTIME_TIMESTAMP_OWNER=1")
                comp_args.push("-DSIMPLE_RUNTIME_NO_RUST_ARRAY_PACKING=1")
            if include_dynload or core_c_profile:
                # Standalone core-C suppresses hosted fallbacks; native-all
                # must retain them and therefore must not receive this flag.
                comp_args.push("-DSIMPLE_CORE_C_STANDALONE=1")
                # runtime_dynload.c is in this bundle and owns spl_dlopen/
                # spl_dlsym/spl_dlclose. Compile runtime_native.c's per-lane
                # fallback copies out so exactly ONE definition ships.
                if include_dynload:
                    comp_args.push("-DSIMPLE_RUNTIME_DYNLOAD_OWNER=1")
                # Same ownership statement as the MSVC branch above. Inert
                # wherever runtime_legacy_core.c IS in the list.
                if not legacy_owner:
                    comp_args.push("-DSIMPLE_RUNTIME_THREAD_CPU_COUNT_OWNER=1")
            if target.starts_with("aarch64-") or (target == "host" and host_arch() == "aarch64"):
                comp_args.push("-mno-outline-atomics")
            # Explicit opt-in: the resulting binary requires an RVV-capable CPU.
            if name == "runtime_simd_dispatch" and target.starts_with("riscv64") and (env_get_nullable("SIMPLE_RUNTIME_RISCV64_VECTOR") ?? "") == "1":
                comp_args.push("-march=rv64gcv")
                comp_args.push("-mabi=lp64d")
            comp_args.push("-I")
            comp_args.push(rt_dir)
            comp_args.push("-I")
            comp_args.push("{rt_dir}/platform")
            comp_args.push("-o")
            comp_args.push(obj_path)
            comp_args.push(src_path)

        for context_define in runtime_xray_context_flags_v1(Enabled(value: xray_thread_context_v1), name):
            comp_args.push(context_define)
        for pin_define in runtime_vector_provider_pin_defines_v1(name, vector_pin, use_msvc):
            comp_args.push(pin_define)
        val cache_obj = if cache_dir != "": cache_dir + "/" + runtime_object_basename_v1(name) + ext else: ""
        var cache_hit = false
        var cache_obj_exists = false
        if cache_obj != "":
            cache_obj_exists = file_exists(cache_obj)
        if cache_obj_exists:
            cache_hit = true
            if trace:
                print "[RT-COMPILE] cache hit: {name}.c"
        var comp_out = ""
        var comp_err = ""
        var comp_code = 0
        if not cache_hit:
            if native_tool_strict_requested_v1():
                val checked = native_tool_strict_resolve_v1("cc")
                if checked.is_err():
                    cleanup_runtime_objects(objects)
                    return Err(checked.unwrap_err())
                if checked.unwrap() != cc:
                    cleanup_runtime_objects(objects)
                    return Err("runtime C compiler authority changed")
            val runtime_context = ["target=" + target, "profile=" + runtime_profile, "alloc_observer_v1={alloc_observer}", "abi=" + abi_policy, "host=" + host_arch()]
            if windows_toolchain != "":
                # Per-TU publish: a run killed mid-batch keeps every finished TU.
                val result = runtime_windows_cached_compile_and_publish_v1(windows_cache_root, cc, windows_compiler_digest, windows_toolchain, comp_args, src_path, obj_path, runtime_context, trace, process_run)
                comp_out = result.stdout
                comp_err = result.stderr
                comp_code = result.exit_code
                windows_pending_keys.push(result.pending_key)
                if comp_code == 0: windows_published_any = true
                print "[runtime-c] {object_count + 1}/{sources.len()} {name}"
            elif rt_parallel_eligible:
                rt_pending_slots.push(resolved_objects.len())
                resolved_objects.push(obj_path)
                rt_pending_names.push(name)
                rt_pending_srcs.push(src_path)
                rt_pending_objs.push(obj_path)
                rt_pending_caches.push(cache_obj)
                rt_pending_argvs.push(comp_args)
                object_count = object_count + 1
                continue
            else:
                val (run_out, run_err, run_code) = process_run(cc, comp_args)
                comp_out = run_out
                comp_err = run_err
                comp_code = run_code
        if trace:
            print "[RT-COMPILE] compile result: code={comp_code}"
        if comp_code != 0:
            if windows_toolchain != "":
                runtime_windows_cache_publish_batch_v1(windows_cache_root, cc, windows_toolchain, windows_pending_keys, objects)
            cleanup_runtime_objects(objects)
            var comp_detail = "{comp_out}{comp_err}"
            if comp_detail.trim() == "":
                # A silent nonzero exit means the compiler itself died (crash,
                # missing DLL, spawn failure), not a diagnosis of the source.
                comp_detail = "(no compiler output; cc='{cc}' exited with code {comp_code} — the compiler crashed or could not start)"
            return Err("Failed to compile {name}.c:\n{comp_detail}")

        val verified_obj = if cache_hit: cache_obj else: obj_path
        if core_c_profile and name == "runtime_native":
            match runtime_tagged_callback_owner_v1(src_path, verified_obj):
                case Ok(_): ()
                case Err(reason):
                    cleanup_runtime_objects(objects)
                    return Err(reason)

        var published_cache_obj = false
        if cache_obj != "" and not cache_hit:
            # Publish via a private staging name + rename so concurrent builds
            # never observe a half-written object.
            published_cache_obj = runtime_c_cache_publish_object_v1(obj_path, cache_obj, compile_pid, object_count)
        if cache_hit:
            resolved_objects.push(cache_obj)
        elif published_cache_obj:
            cleanup_runtime_objects([obj_path])
            resolved_objects.push(cache_obj)
        else:
            resolved_objects.push(obj_path)

        object_count = object_count + 1

    if rt_pending_names.len() > 0:
        val batch_err = runtime_c_compile_parallel_batch_v1(cc, rt_pending_names, rt_pending_srcs,
            rt_pending_objs, rt_pending_caches, rt_pending_argvs, rt_parallel_workers, compile_pid, core_c_profile)
        if batch_err != "":
            cleanup_runtime_objects(objects)
            return Err(batch_err)
        var pi = 0
        while pi < rt_pending_names.len():
            val p_cache = rt_pending_caches[pi]
            if p_cache != "" and file_exists(p_cache):
                cleanup_runtime_objects([rt_pending_objs[pi]])
                resolved_objects[rt_pending_slots[pi]] = p_cache
            pi = pi + 1

    if windows_toolchain != "" and not runtime_windows_cache_publish_batch_v1(windows_cache_root, cc, windows_toolchain, windows_pending_keys, objects):
        cleanup_runtime_objects(objects)
        return Err("runtime C toolchain changed during compilation")
    # Bounded store: sweep oldest objects past SIMPLE_RT_OBJ_CACHE_MAX_BYTES
    # (default 2 GiB; 542 MB measured for one toolchain, 2026-10-26).
    var published_any = windows_published_any
    for pending in windows_pending_keys:
        if pending != "": published_any = true
    if windows_toolchain != "" and published_any:
        val _swept = disk_bound_enforce(windows_cache_root + "/objects",
            disk_bound_cap_bytes("SIMPLE_RT_OBJ_CACHE_MAX_BYTES", 2147483648))
    if trace:
        print "[RT-COMPILE] loop done, {object_count} objects compiled"
    if object_count == 0:
        cleanup_runtime_objects(objects)
        return Err("No runtime source files were compiled")

    if object_count < sources.len():
        cleanup_runtime_objects(objects)
        return Err("Expected {sources.len()} runtime objects, got {object_count}")

    if trace:
        print "[RT-COMPILE] returning Ok with {object_count} objects"
    if native_tool_strict_requested_v1():
        val checked = native_runtime_strict_revalidate_v1(true)
        if checked.is_err():
            cleanup_runtime_objects(objects)
            return Err(checked.unwrap_err())
        val generated = native_runtime_strict_generated_bind_v1(resolved_objects)
        if generated.is_err():
            cleanup_runtime_objects(objects)
            return Err(generated.unwrap_err())
    Ok(resolved_objects)

fn cleanup_runtime_objects(objects: [text]):
    """Remove temporary runtime object files (preserving shared cache objects)."""
    if native_tool_strict_requested_v1():
        native_runtime_strict_generated_release_v1(objects)
    for obj in objects:
        if obj.contains("/simple_rt_") or obj.contains("\\simple_rt_"):
            file_delete(obj)

# ============================================================================
# Exports
# ============================================================================
