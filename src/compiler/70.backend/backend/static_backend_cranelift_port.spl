use compiler.backend.backend_port.{BackendDescV1, BackendPortV1, CodegenParamsV1, backend_port_header, backend_port_host_iface}
use common.plugin.iface_id.{ParamHeader}
use compiler.mir.mir_instructions.{MirModule}
use compiler.backend.codegen_types.{CodegenOutput}
use compiler.backend.backend.backend_types.{CompileError}
use compiler.backend.cranelift_codegen_adapter.{CraneliftCodegenAdapter}
use compiler.backend.backend.cranelift_retained_params_v2.{cranelift_retained_params_decode_v2}

fn _cranelift_desc() -> BackendDescV1:
    BackendDescV1(ParamHeader("simple.codegen.BackendDescV1", 1, 0, 0),
        "cranelift", ["host", "native", "x86_64", "aarch64", "riscv64"],
        ["emit-object"], "cranelift", [])

# Lane-side owner of the Cranelift adapter. The kernel's request sites
# (backend_helpers.cranelift_compile_module_via_k1_v1) carry the retained V2
# target triple / CPU / features as CodegenParamsV1.ext rows; a plain
# CodegenFactory request carries none and compiles for params.options.target.
fn _cranelift_run(params: CodegenParamsV1,
        module: MirModule) -> Result<CodegenOutput, CompileError>:
    val retained = cranelift_retained_params_decode_v2(params)
    CraneliftCodegenAdapter(options: params.options,
        retained_target_triple: retained.target_triple,
        retained_cpu_v2: retained.cpu,
        retained_features_v2: retained.features).compile_module(module)

fn _cranelift_supports(capability: text) -> bool:
    capability == "emit-object"

pub fn cranelift_backend_port_v1() -> BackendPortV1:
    BackendPortV1(backend_port_header(), backend_port_host_iface(),
        _cranelift_desc, _cranelift_run, _cranelift_supports, [])
