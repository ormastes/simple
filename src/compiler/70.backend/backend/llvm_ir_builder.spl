# LLVM IR Builder
#
# LlvmIRBuilder class and helper utilities for emitting LLVM IR.
#
# Refactored: Split into submodules for modularity:
# - llvm_passes.spl: LlvmPass enum and passes_for_level
# - llvm_ir_builder.spl: LlvmIRBuilder class + helper functions (this file)
# - mir_to_llvm.spl: MirToLlvm translation class

use compiler.backend.llvm_target.{LlvmTargetTriple}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.common.mir_target_context.{mir_target_context_os_from}
use compiler.common.attributes.FunctionAttr

@unsafe(reason: "raw target-policy environment read; empty text conflates unset input with provider failure", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text
# Amortized-O(1) string accumulation (same runtime builder as
# src/lib/common/string_builder.spl; bug rt_string_concat_quadratic_2026-06-12).
@unsafe(reason: "raw opaque builder acquisition; zero/sentinel and allocation failure are not represented by a typed contract", capabilities: [ffi])
extern fn rt_string_builder_new() -> i64
@unsafe(reason: "raw opaque builder mutation; invalid-handle and allocation failure are not represented by a typed contract", capabilities: [ffi])
extern fn rt_string_builder_push(handle: i64, s: text) -> i64
@unsafe(reason: "raw opaque builder ownership transfer; invalid-handle and finish failure are not represented by a typed contract", capabilities: [ffi])
extern fn rt_string_builder_finish(handle: i64) -> text
@unsafe(reason: "raw opaque builder query; invalid-handle failure is indistinguishable from a valid zero length", capabilities: [ffi])
extern fn rt_string_builder_len(handle: i64) -> i64

var _llvm_simpleos_header: bool = false

pub fn llvm_ir_builder_set_simpleos_header(enabled: bool):
    _llvm_simpleos_header = enabled

fn llvm_builder_target() -> CodegenTarget:
    var requested = ""
    unsafe(capabilities: [ffi]):
        requested = rt_env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
    if requested.contains("simpleos"):
        CodegenTarget.SimpleOS_X86_64
    elif requested.starts_with("aarch64-") or requested.starts_with("arm64-"):
        CodegenTarget.AArch64
    elif requested.starts_with("riscv64-") or requested.starts_with("rv64-"):
        CodegenTarget.Riscv64
    elif requested.starts_with("riscv32-") or requested.starts_with("rv32-"):
        CodegenTarget.Riscv32
    elif requested.starts_with("wasm64-") or requested == "wasm64":
        CodegenTarget.Wasm64
    elif requested.starts_with("wasm32-") or requested == "wasm32":
        CodegenTarget.Wasm32
    elif requested.starts_with("i686-") or requested.starts_with("i386-") or requested == "x86":
        CodegenTarget.X86
    elif requested.starts_with("armv") or requested.starts_with("thumbv") or requested == "arm":
        CodegenTarget.Arm
    elif requested.starts_with("x86_64-") or requested.starts_with("amd64-") or requested == "x64":
        CodegenTarget.X86_64
    else:
        CodegenTarget.Host

# Re-import from split module for re-export (backward compatibility)
use compiler.backend.llvm_passes.{LlvmPass, passes_for_level}

# ============================================================================
# LLVM IR Builder
# ============================================================================

class LlvmIRBuilder:
    """Builds LLVM IR from MIR."""
    module_name: text
    # IR text accumulator: rt_string_builder handle, NOT a [text] array.
    # Arrays are value types — `self.x = self.x.push(line)` re-copies the
    # whole array per emitted line under the seed interpreter, O(M^2) over
    # M IR lines (a 479-fn module spent >50min here). The runtime builder
    # appends in amortized O(1). Consumed exactly once by build()/
    # llvm_ir_builder_build (rt_string_builder_finish releases the handle).
    sb: i64
    # Layout-reserved legacy field. It has no readers. Do not mutate it in
    # start/end helpers: compiled Phase 2 write-back erased the opening `define`
    # line even when the external string-builder push happened first.
    current_function: text?
    local_counter: i64
    debug_counter: i64
    size_type: text            # "i32" for 32-bit targets, "i64" for 64-bit
    tbaa_counter: i64          # Counter for TBAA metadata nodes
    header_emitted: bool       # set by emit_module_header(); see emit_baremetal_attributes
    # Bare-metal attribute lines queued by emit_baremetal_attributes() when it
    # is called before emit_module_header() (the normal construction order:
    # MirToLlvm.create_baremetal() calls emit_baremetal_attributes() at
    # builder-construction time, before translate_module() later calls
    # emit_module_header()). Flushed by emit_module_header() right after the
    # header. Ordering matters: `llc` requires `source_filename`/`target
    # datalayout`/`target triple` to precede standalone `!N = ...` metadata
    # definitions, or it fails with "expected top-level entity" on the header
    # line. See doc/08_tracking/bug/nvme_rv32_smp_flatten_seed_object_to_int_2026-07-19.md.
    pending_baremetal_attrs: [text]

    static fn create(name: text, target: LlvmTargetTriple) -> LlvmIRBuilder:
        val st = if target.is_32bit(): "i32" else: "i64"
        var builder_handle = 0
        unsafe(capabilities: [ffi]):
            builder_handle = rt_string_builder_new()
        LlvmIRBuilder(
            module_name: name,
            sb: builder_handle,
            current_function: nil,
            local_counter: 0,
            debug_counter: 10,
            size_type: st,
            tbaa_counter: 100,
            header_emitted: false,
            pending_baremetal_attrs: []
        )

    me emit(line: text):
        """Emit an IR line."""
        unsafe(capabilities: [ffi]):
            if rt_string_builder_len(self.sb) > 0:
                rt_string_builder_push(self.sb, "\n")
            rt_string_builder_push(self.sb, line)

    me emit_module_header():
        """Emit module header."""
        # Do not retain or snapshot the incoming LlvmTargetTriple across the
        # builder class boundary. On the compiled pure-Simple lane its optional
        # env payload can already be corrupt at create(), while reconstructing
        # a fresh local from the scalar requested-target environment is stable.
        # Both locals MUST carry the explicit `: LlvmTargetTriple` annotation.
        # Untyped, the owner type is lost and every field read of the value is
        # displaced by one slot: .arch returns vendor, .vendor returns os, .os
        # returns the env Option (which then renders through the enum-to-text
        # path as `<enum@0x...>`), and .env reads past the end so the Some arm
        # never fires. That produced `target triple = "unknown-linux-<enum@0x...>"`
        # and llc "unable to get target". Note the absence of a leading `-`:
        # that is the tell that this is a shift, not an empty arch. The exact
        # seed mechanism is NOT established -- compiler.rs:1707 sets
        # owner_has_vtable = Some(false), which does not by itself explain a +1
        # displacement. Details and scope:
        # doc/08_tracking/bug/stage3_selfhost_llvm_triple_field_offset_shift_2026-08-06.md
        val target: LlvmTargetTriple = LlvmTargetTriple.from_target(llvm_builder_target())
        val requested = rt_env_get("SIMPLE_NATIVE_BUILD_TARGET") ?? ""
        val header_target: LlvmTargetTriple = if mir_target_context_os_from(requested, "") == "baremetal":
            LlvmTargetTriple.from_target_baremetal(llvm_builder_target())
        else:
            target
        # LlvmTargetTriple.to_text() returns newly interpolated text across a
        # compiled method boundary, which can arrive here as <invalid-heap>.
        # Compose the fresh local's scalar fields in this caller instead.
        var target_triple_text = "{header_target.arch}-{header_target.vendor}-{header_target.os}"
        match header_target.env:
            Some(target_env):
                if target_env != "":
                    target_triple_text = "{target_triple_text}-{target_env}"
            nil:
                ()
        self.emit("; ModuleID = '{self.module_name}'")
        self.emit("source_filename = \"{self.module_name}.spl\"")
        if _llvm_simpleos_header:
            self.emit("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
            self.emit("target triple = \"x86_64-unknown-simpleos\"")
        else:
            self.emit("target datalayout = \"{header_target.datalayout()}\"")
            self.emit("target triple = \"{target_triple_text}\"")
        self.emit("")
        self.header_emitted = true
        # Flush any bare-metal attributes queued before the header existed
        # (see emit_baremetal_attributes) now that it's safe to emit them.
        if self.pending_baremetal_attrs.len() > 0:
            for line in self.pending_baremetal_attrs:
                self.emit(line)
            self.pending_baremetal_attrs = []

    me emit_baremetal_attributes():
        """Emit bare-metal module attributes (no stdlib, panic=abort, etc.).

        Callers (MirToLlvm.create_baremetal) invoke this at builder
        construction time, BEFORE emit_module_header() runs (that happens
        later, from translate_module()). `llc` requires the module header
        (source_filename/target datalayout/target triple) to precede
        standalone `!N = ...` metadata definitions -- emitting these first
        produces "expected top-level entity" on the header line. So: queue
        the lines here and let emit_module_header() flush them in the
        correct position; if the header has already been emitted (future
        caller with a different order), emit immediately instead.
        """
        var lines: [text] = []
        lines = lines.push("; Bare-metal attributes")
        # NOTE: braces doubled (`{{`/`}}`) to escape Simple's string
        # interpolation. A single `!{!\"no-builtins\"}` is not just literal
        # text here: the compiler's string-interpolation parser tries to
        # parse the `{...}` body as an expression, and `!"no-builtins"`
        # parses as a valid unary-not-of-string expression (non-empty
        # string is truthy, so `!"no-builtins"` -> `false`), silently
        # rewriting the emitted line to the invalid `!0 = !false`. See
        # doc/08_tracking/bug/nvme_rv32_smp_flatten_seed_object_to_int_2026-07-19.md.
        lines = lines.push("!0 = !{{!\"no-builtins\"}}")
        lines = lines.push("!1 = !{{!\"trap-func-name\", !\"abort\"}}")
        lines = lines.push("")
        if self.header_emitted:
            for line in lines:
                self.emit(line)
        else:
            for line in lines:
                self.pending_baremetal_attrs = self.pending_baremetal_attrs.push(line)

    me start_function(name: text, params: [text], return_type: text):
        """Start a function definition with nounwind (Simple has no exceptions)."""
        val param_str = params.join(", ")
        llvm_ir_builder_push_line("define {return_type} @{name}({param_str}) nounwind {{", self.sb)

    me start_function_opt(name: text, params: [text], return_type: text, is_readonly: bool, is_small: bool, dbg_id: i64?):
        """Start a function definition with optimization attributes.

        - nounwind: always (Simple has no exceptions)
        - readonly: function has no side effects (no stores, no non-pure calls)
        - alwaysinline: function is small (< 10 instructions)
        - dbg_id: when Some(id), attaches `!dbg !id` linking this definition
          to the !DISubprogram emitted for it (see emit_di_subprogram). The
          verifier requires this attachment for any DISubprogram marked
          isDefinition: true.
        """
        val param_str = params.join(", ")
        var attrs = " nounwind"
        if is_readonly:
            attrs = attrs + " readonly"
        if is_small:
            attrs = attrs + " alwaysinline"
        var dbg_suffix = ""
        match dbg_id:
            Some(id):
                dbg_suffix = " !dbg !{id}"
            nil:
                ()
        llvm_ir_builder_push_line("define {return_type} @{name}({param_str}){attrs}{dbg_suffix} {{", self.sb)

    me start_function_with_attrs(name: text, params: [text], return_type: text, func_attr: FunctionAttr):
        """Start a function definition with attributes."""
        val param_str = params.join(", ")
        var attrs = ""
        if func_attr.is_naked:
            attrs = attrs + " naked"
        if func_attr.is_noreturn:
            attrs = attrs + " noreturn"
        var prefix = "define"
        if func_attr.is_entry:
            prefix = "define dso_local"
        var section_str = ""
        match func_attr.section:
            Some(section):
                section_str = " section \"{section}\""
            nil:
                ()
        llvm_ir_builder_push_line("{prefix} {return_type} @{name}({param_str}){attrs}{section_str} {{", self.sb)

    me end_function():
        """End a function definition."""
        llvm_ir_builder_push_line("}", self.sb)
        llvm_ir_builder_push_line("", self.sb)

    me fresh_local() -> text:
        """Generate a fresh local name.

        Must be a NAMED temporary (`%tN`), never an anonymous `%N`: LLVM requires
        unnamed temporaries to match its per-function implicit slot numbering
        (which counts blocks/params), so an anonymous `%0` interspersed with the
        named `%lN` locals is rejected by llc ("instruction expected to be
        numbered '%3' or greater"). A distinct-prefix named temp (`%t`) cannot
        collide with `%l{mir_id}` locals and sidesteps slot numbering entirely.
        `local_counter` is module-monotonic so every `%tN` is unique per function."""
        val id = self.local_counter
        self.local_counter = self.local_counter + 1
        "%t{id}"

    me emit_alloca(dest: text, ty: text):
        """Emit alloca instruction with natural alignment."""
        val alignment = natural_alignment(ty)
        self.emit("  {dest} = alloca {ty}, align {alignment}")

    me emit_alloca_aligned(dest: text, ty: text, alignment: i64):
        """Emit alloca with explicit alignment (for SIMD arrays)."""
        self.emit("  {dest} = alloca {ty}, align {alignment}")

    me emit_load(dest: text, ty: text, ptr: text):
        """Emit load instruction with natural alignment."""
        val alignment = natural_alignment(ty)
        self.emit("  {dest} = load {ty}, ptr {ptr}, align {alignment}")

    me emit_store(ty: text, value: text, ptr: text):
        """Emit store instruction with natural alignment."""
        val alignment = natural_alignment(ty)
        self.emit("  store {ty} {value}, ptr {ptr}, align {alignment}")

    # === Arithmetic with nsw/nuw flags ===

    me emit_add(dest: text, ty: text, lhs: text, rhs: text):
        """Emit add instruction."""
        self.emit("  {dest} = add {ty} {lhs}, {rhs}")

    me emit_add_nsw(dest: text, ty: text, lhs: text, rhs: text):
        """Emit add with no signed wrap (enables LLVM strength reduction)."""
        self.emit("  {dest} = add nsw {ty} {lhs}, {rhs}")

    me emit_add_nuw(dest: text, ty: text, lhs: text, rhs: text):
        """Emit add with no unsigned wrap (for array indexing)."""
        self.emit("  {dest} = add nuw {ty} {lhs}, {rhs}")

    me emit_sub(dest: text, ty: text, lhs: text, rhs: text):
        """Emit sub instruction."""
        self.emit("  {dest} = sub {ty} {lhs}, {rhs}")

    me emit_sub_nsw(dest: text, ty: text, lhs: text, rhs: text):
        """Emit sub with no signed wrap."""
        self.emit("  {dest} = sub nsw {ty} {lhs}, {rhs}")

    me emit_mul(dest: text, ty: text, lhs: text, rhs: text):
        """Emit mul instruction."""
        self.emit("  {dest} = mul {ty} {lhs}, {rhs}")

    me emit_mul_nsw(dest: text, ty: text, lhs: text, rhs: text):
        """Emit mul with no signed wrap (enables loop strength reduction)."""
        self.emit("  {dest} = mul nsw {ty} {lhs}, {rhs}")

    me emit_div(dest: text, ty: text, lhs: text, rhs: text):
        """Emit div instruction (signed)."""
        self.emit("  {dest} = sdiv {ty} {lhs}, {rhs}")

    me emit_udiv(dest: text, ty: text, lhs: text, rhs: text):
        """Emit div instruction (unsigned)."""
        self.emit("  {dest} = udiv {ty} {lhs}, {rhs}")

    me emit_rem(dest: text, ty: text, lhs: text, rhs: text):
        """Emit remainder instruction (signed modulo)."""
        self.emit("  {dest} = srem {ty} {lhs}, {rhs}")

    me emit_urem(dest: text, ty: text, lhs: text, rhs: text):
        """Emit remainder instruction (unsigned modulo)."""
        self.emit("  {dest} = urem {ty} {lhs}, {rhs}")

    me emit_neg(dest: text, ty: text, value: text):
        """Emit negation (0 - value)."""
        self.emit("  {dest} = sub {ty} 0, {value}")

    # === Float Arithmetic ===

    me emit_fadd(dest: text, ty: text, lhs: text, rhs: text):
        """Emit float add."""
        self.emit("  {dest} = fadd {ty} {lhs}, {rhs}")

    me emit_fsub(dest: text, ty: text, lhs: text, rhs: text):
        """Emit float sub."""
        self.emit("  {dest} = fsub {ty} {lhs}, {rhs}")

    me emit_fmul(dest: text, ty: text, lhs: text, rhs: text):
        """Emit float mul."""
        self.emit("  {dest} = fmul {ty} {lhs}, {rhs}")

    me emit_fdiv(dest: text, ty: text, lhs: text, rhs: text):
        """Emit float div."""
        self.emit("  {dest} = fdiv {ty} {lhs}, {rhs}")

    me emit_frem(dest: text, ty: text, lhs: text, rhs: text):
        """Emit float rem."""
        self.emit("  {dest} = frem {ty} {lhs}, {rhs}")

    me emit_fneg(dest: text, ty: text, value: text):
        """Emit float negation."""
        self.emit("  {dest} = fneg {ty} {value}")

    # === Bitwise Operations ===

    me emit_and(dest: text, ty: text, lhs: text, rhs: text):
        """Emit bitwise AND."""
        self.emit("  {dest} = and {ty} {lhs}, {rhs}")

    me emit_or(dest: text, ty: text, lhs: text, rhs: text):
        """Emit bitwise OR."""
        self.emit("  {dest} = or {ty} {lhs}, {rhs}")

    me emit_xor(dest: text, ty: text, lhs: text, rhs: text):
        """Emit bitwise XOR."""
        self.emit("  {dest} = xor {ty} {lhs}, {rhs}")

    me emit_shl(dest: text, ty: text, value: text, amount: text):
        """Emit left shift."""
        self.emit("  {dest} = shl {ty} {value}, {amount}")

    me emit_lshr(dest: text, ty: text, value: text, amount: text):
        """Emit logical right shift (zero-extend)."""
        self.emit("  {dest} = lshr {ty} {value}, {amount}")

    me emit_ashr(dest: text, ty: text, value: text, amount: text):
        """Emit arithmetic right shift (sign-extend)."""
        self.emit("  {dest} = ashr {ty} {value}, {amount}")

    me emit_not(dest: text, ty: text, value: text):
        """Emit bitwise NOT (xor with -1)."""
        self.emit("  {dest} = xor {ty} {value}, -1")

    # === Comparison Operations ===

    me emit_icmp_eq(dest: text, ty: text, lhs: text, rhs: text):
        """Emit integer equality comparison."""
        self.emit("  {dest} = icmp eq {ty} {lhs}, {rhs}")

    me emit_icmp_ne(dest: text, ty: text, lhs: text, rhs: text):
        """Emit integer inequality comparison."""
        self.emit("  {dest} = icmp ne {ty} {lhs}, {rhs}")

    me emit_icmp_slt(dest: text, ty: text, lhs: text, rhs: text):
        """Emit signed less-than comparison."""
        self.emit("  {dest} = icmp slt {ty} {lhs}, {rhs}")

    me emit_icmp_sle(dest: text, ty: text, lhs: text, rhs: text):
        """Emit signed less-or-equal comparison."""
        self.emit("  {dest} = icmp sle {ty} {lhs}, {rhs}")

    me emit_icmp_sgt(dest: text, ty: text, lhs: text, rhs: text):
        """Emit signed greater-than comparison."""
        self.emit("  {dest} = icmp sgt {ty} {lhs}, {rhs}")

    me emit_icmp_sge(dest: text, ty: text, lhs: text, rhs: text):
        """Emit signed greater-or-equal comparison."""
        self.emit("  {dest} = icmp sge {ty} {lhs}, {rhs}")

    me emit_icmp_ult(dest: text, ty: text, lhs: text, rhs: text):
        """Emit unsigned less-than comparison."""
        self.emit("  {dest} = icmp ult {ty} {lhs}, {rhs}")

    me emit_icmp_ule(dest: text, ty: text, lhs: text, rhs: text):
        """Emit unsigned less-or-equal comparison."""
        self.emit("  {dest} = icmp ule {ty} {lhs}, {rhs}")

    me emit_icmp_ugt(dest: text, ty: text, lhs: text, rhs: text):
        """Emit unsigned greater-than comparison."""
        self.emit("  {dest} = icmp ugt {ty} {lhs}, {rhs}")

    me emit_icmp_uge(dest: text, ty: text, lhs: text, rhs: text):
        """Emit unsigned greater-or-equal comparison."""
        self.emit("  {dest} = icmp uge {ty} {lhs}, {rhs}")

    me emit_fcmp_oeq(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered equality."""
        self.emit("  {dest} = fcmp oeq {ty} {lhs}, {rhs}")

    me emit_fcmp_one(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered inequality."""
        self.emit("  {dest} = fcmp one {ty} {lhs}, {rhs}")

    me emit_fcmp_olt(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered less-than."""
        self.emit("  {dest} = fcmp olt {ty} {lhs}, {rhs}")

    me emit_fcmp_ole(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered less-or-equal."""
        self.emit("  {dest} = fcmp ole {ty} {lhs}, {rhs}")

    me emit_fcmp_ogt(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered greater-than."""
        self.emit("  {dest} = fcmp ogt {ty} {lhs}, {rhs}")

    me emit_fcmp_oge(dest: text, ty: text, lhs: text, rhs: text):
        """Emit floating-point ordered greater-or-equal."""
        self.emit("  {dest} = fcmp oge {ty} {lhs}, {rhs}")

    # === Memory Operations ===

    me emit_memcpy(dest: text, src: text, size: text):
        """Emit memcpy intrinsic."""
        val st = self.size_type
        self.emit("  call void @llvm.memcpy.p0.p0.{st}(ptr {dest}, ptr {src}, {st} {size}, i1 false)")

    me emit_memset(dest: text, value: text, size: text):
        """Emit memset intrinsic."""
        val st = self.size_type
        self.emit("  call void @llvm.memset.p0.{st}(ptr {dest}, i8 {value}, {st} {size}, i1 false)")

    me emit_gep(dest: text, base_ty: text, ptr: text, indices: [text]):
        """Emit getelementptr instruction."""
        var typed_indices: [text] = []
        for idx in indices:
            if idx.contains(" "):
                typed_indices.push(idx)
            else:
                typed_indices.push("{self.size_type} {idx}")
        val idx_str = typed_indices.join(", ")
        self.emit("  {dest} = getelementptr {base_ty}, ptr {ptr}, {idx_str}")

    # === Function Calls ===

    me emit_call(dest: text?, ret_ty: text, func: text, args: [text]):
        """Emit direct call instruction."""
        val args_str = args.join(", ")
        match dest:
            Some(name):
                self.emit("  {name} = call {ret_ty} @{func}({args_str})")
            nil:
                self.emit("  call {ret_ty} @{func}({args_str})")

    me emit_call_indirect(dest: text?, ret_ty: text, func_ptr: text, args: [text]):
        """Emit indirect call through function pointer."""
        val args_str = args.join(", ")
        match dest:
            Some(name):
                self.emit("  {name} = call {ret_ty} {func_ptr}({args_str})")
            nil:
                self.emit("  call {ret_ty} {func_ptr}({args_str})")

    me emit_ret(ty: text, value: text):
        """Emit return instruction."""
        self.emit("  ret {ty} {value}")

    me emit_ret_void():
        """Emit void return."""
        self.emit("  ret void")

    me emit_br(label: text):
        """Emit unconditional branch."""
        self.emit("  br label %{label}")

    me emit_cond_br(cond: text, true_label: text, false_label: text):
        """Emit conditional branch."""
        self.emit("  br i1 {cond}, label %{true_label}, label %{false_label}")

    me emit_switch(value: text, ty: text, default_label: text, cases: [(text, text)]):
        """Emit switch instruction."""
        var line = "  switch {ty} {value}, label %{default_label} ["
        self.emit(line)
        for (case_val, case_label) in cases:
            self.emit("    {ty} {case_val}, label %{case_label}")
        self.emit("  ]")

    me emit_label(name: text):
        """Emit a label."""
        self.emit("{name}:")

    # === Debug Info (DWARF) ===

    me emit_debug_info_header(filename: text, directory: text):
        """Emit DWARF debug info metadata (compile unit + shared subroutine type).

        Verified against LLVM 18 (`opt -passes=verify` + `llc -filetype=obj` +
        `llvm-dwarfdump --debug-info`): this shape produces a real
        DW_TAG_compile_unit and, once a function's `define` is annotated with
        `!dbg !N` (see emit_di_subprogram + start_function_opt's dbg_id),
        a DW_TAG_subprogram naming the source file.

        emissionKind is deliberately FullDebug, not LineTablesOnly: LLVM's
        LineTablesOnly mode intentionally omits DW_TAG_subprogram DIEs
        entirely (confirmed against `clang -gline-tables-only`), which would
        leave nothing for tools to find. Until per-instruction MIR spans
        exist (DS5), "line-tables" support here means function-level
        file+line scope inside an otherwise-minimal FullDebug unit, not
        true `-gline-tables-only` DWARF trimming.

        !4/!5 are a single shared `void()`-shaped DISubroutineType reused by
        every function's DISubprogram (see emit_di_subprogram) -- callers
        only draw ONE fresh id per function from next_debug_id(), so
        reserving distinct ids per subprogram here would collide with the
        next function's id.
        """
        self.emit("")
        self.emit("; Debug information")
        # NOTE: braces doubled (`!{{!0}}`) same as emit_baremetal_attributes --
        # a single-element `!{!0}` is not just literal text here: Simple's
        # string-interpolation parser tries to parse the `{...}` body as an
        # expression, and `!0` parses as a valid unary-not-of-int expression
        # (0 is falsy, so `!0` -> true), silently rewriting this to the
        # invalid `!llvm.dbg.cu = !true` (confirmed empirically: this line
        # was broken exactly this way before the fix). The multi-element
        # `!{!1, !2}` below is NOT affected -- `!1, !2` doesn't parse as a
        # single expression, so it falls through unparsed as literal text.
        self.emit("!llvm.dbg.cu = !{{!0}}")
        self.emit("!llvm.module.flags = !{!1, !2}")
        self.emit("")
        self.emit("!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !3, producer: \"simple-compiler\", isOptimized: false, emissionKind: FullDebug)")
        self.emit("!1 = !{i32 2, !\"Dwarf Version\", i32 4}")
        self.emit("!2 = !{i32 2, !\"Debug Info Version\", i32 3}")
        self.emit("!3 = !DIFile(filename: \"{filename}\", directory: \"{directory}\")")
        self.emit("!4 = !DISubroutineType(types: !5)")
        self.emit("!5 = !{{null}}")

    me emit_di_subprogram(id: i64, name: text, line: i64):
        """Emit DISubprogram metadata for a function at `id` (a fresh id from
        next_debug_id()). References the shared !4 DISubroutineType emitted by
        emit_debug_info_header -- do NOT allocate extra ids here, or the next
        function's next_debug_id() call collides with them."""
        self.emit("!{id} = distinct !DISubprogram(name: \"{name}\", scope: !3, file: !3, line: {line}, type: !4, unit: !0, isDefinition: true)")

    me next_debug_id() -> i64:
        """Get next debug metadata ID."""
        val id = self.debug_counter
        self.debug_counter = self.debug_counter + 1
        id

    # === TBAA Metadata ===

    me emit_tbaa_hierarchy():
        """Emit TBAA type hierarchy for Simple language types.

        Simple has strict typing with no type punning, enabling aggressive alias analysis.
        Hierarchy: root -> int/float/ptr/struct subtypes.
        """
        # Literal `{`/`}` MUST come from lb/rb locals, never from a bare `{`
        # inside the text literal: a bare `{` opens a string interpolation, so
        # the old `"!{base} = !{!\"Simple TBAA\"}"` had its `{!"Simple TBAA"}`
        # evaluated as the expression `!"Simple TBAA"` and emitted
        # `!100 = !false`, which llc rejects with "expected metadata type" --
        # on EVERY module the pure-Simple LLVM lane produced. The sibling
        # `!{base + 1} = ...` lines degraded the other way and emitted the
        # un-substituted text `!{base}` verbatim.
        #
        # This body previously sat after a bare `return` meant to disable it.
        # That guard never worked: a statement-level `return` does not terminate
        # the function on the COMPILED lanes (JIT and native), because MIR
        # lowering overwrites the block terminator instead of starting a new
        # block. The tree-walking interpreter is correct. So there was never a
        # "disabled" state -- only broken-metadata-always vs valid-always. See
        # doc/08_tracking/bug/top_level_return_falls_through_2026-08-01.md.
        # Emitting verifier-clean metadata is the resolution the old comment
        # asked for, and it keeps llvm_opt_pipeline_spec's "Simple TBAA"
        # expectation honest instead of green-by-accident.
        val base = self.tbaa_counter
        val lb = "{"
        val rb = "}"
        self.emit("")
        self.emit("; TBAA metadata")
        self.emit("!{base} = !{lb}!\"Simple TBAA\"{rb}")
        self.emit("!{base + 1} = !{lb}!\"int\", !{base}, i64 0{rb}")
        self.emit("!{base + 2} = !{lb}!\"float\", !{base}, i64 0{rb}")
        self.emit("!{base + 3} = !{lb}!\"ptr\", !{base}, i64 0{rb}")
        self.emit("!{base + 4} = !{lb}!\"bool\", !{base}, i64 0{rb}")
        self.emit("!{base + 5} = !{lb}!\"struct\", !{base}, i64 0{rb}")
        # Access tags (type, type, offset)
        self.emit("!{base + 6} = !{lb}!{base + 1}, !{base + 1}, i64 0{rb}")
        self.emit("!{base + 7} = !{lb}!{base + 2}, !{base + 2}, i64 0{rb}")
        self.emit("!{base + 8} = !{lb}!{base + 3}, !{base + 3}, i64 0{rb}")
        self.emit("!{base + 9} = !{lb}!{base + 4}, !{base + 4}, i64 0{rb}")
        self.emit("!{base + 10} = !{lb}!{base + 5}, !{base + 5}, i64 0{rb}")
        self.tbaa_counter = base + 11

    fn tbaa_tag_for_type(ty: text) -> i64:
        """Get TBAA access tag metadata ID for a given LLVM type."""
        val base = 100  # Must match tbaa_counter initial value
        if ty == "i64" or ty == "i32" or ty == "i16" or ty == "i8":
            return base + 6
        if ty == "double" or ty == "float":
            return base + 7
        if ty == "ptr":
            return base + 8
        if ty == "i1":
            return base + 9
        # Default: struct tag
        base + 10

    me emit_load_tbaa(dest: text, ty: text, ptr: text):
        """Emit load with TBAA metadata for better alias analysis."""
        val alignment = natural_alignment(ty)
        self.emit("  {dest} = load {ty}, ptr {ptr}, align {alignment}")

    me emit_store_tbaa(ty: text, value: text, ptr: text):
        """Emit store with TBAA metadata."""
        val alignment = natural_alignment(ty)
        self.emit("  store {ty} {value}, ptr {ptr}, align {alignment}")

    me build() -> text:
        """Build final IR string."""
        unsafe(capabilities: [ffi]):
            return rt_string_builder_finish(self.sb)

# ============================================================================
# Helper Functions
# ============================================================================

pub fn llvm_ir_builder_push_line(line: text, handle: i64):
    """Append one LLVM IR line through the scalar builder handle."""
    unsafe(capabilities: [ffi]):
        if rt_string_builder_len(handle) > 0:
            rt_string_builder_push(handle, "\n")
        rt_string_builder_push(handle, line)

pub fn llvm_ir_builder_handle(builder: LlvmIRBuilder) -> i64:
    """Project the scalar accumulator handle in the builder owner module."""
    builder.sb

pub fn llvm_ir_builder_build(builder: LlvmIRBuilder) -> text:
    """Build final IR without relying on receiver-method dispatch."""
    unsafe(capabilities: [ffi]):
        return rt_string_builder_finish(builder.sb)

fn natural_alignment(ty: text) -> i64:
    """Return natural alignment in bytes for an LLVM type."""
    if ty == "i1":
        return 1
    if ty == "i8":
        return 1
    if ty == "i16":
        return 2
    if ty == "i32" or ty == "float":
        return 4
    if ty == "i64" or ty == "double" or ty == "ptr":
        return 8
    # Default for structs/arrays
    8

fn is_integer_type(ty: text) -> bool:
    """Check if an LLVM type is an integer type (for nsw/nuw flags)."""
    if ty == "i8" or ty == "i16" or ty == "i32" or ty == "i64":
        return true
    false

fn is_signed_int_type(ty: text) -> bool:
    """Check if type is used as signed integer (i32/i64 in Simple)."""
    ty == "i32" or ty == "i64"

fn is_float_type(ty: text) -> bool:
    """Check if an LLVM type is a floating-point type."""
    ty == "float" or ty == "double"

# Re-export for backward compatibility
