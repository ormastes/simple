# Hardware Codegen Types Re-export
#
# Re-exports hardware codegen trait types without going through "common".

# ponytail: VhdlProcessKind has ONE terminal declaration, in compiler.mir.mir_data.
# The tag-only copy that used to live here was never constructed or matched
# anywhere - every use is a bare parameter annotation - while the live call chain
# (_VhdlProcess/process_codegen.spl, vhdl_constraints.spl) already used the MIR
# type. Two declarations of one name is a silent wrong-variant hazard, because
# the enum discriminant is a cross-crate ABI and nothing in the repo detects a
# duplicate terminal declaration.
use compiler.mir.mir_data.{MirModule, MirBody, MirBlock, VhdlProcessKind}
use compiler.backend.backend.backend_types.{CompileError}

trait HardwareCodegen:
    """Interface for hardware description generation backends."""
    fn compile_entity(func_name: text, body: MirBody) -> Result<text, CompileError>
    fn compile_package(module: MirModule) -> text
    fn compile_process(kind: VhdlProcessKind, body_block: MirBlock) -> text

