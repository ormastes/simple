use std.nogc_sync_mut.io.file_ops.{file_atomic_write}

val BACKEND_AOT_DIAGNOSTIC_MAX_SCALARS: i64 = 1024

fn backend_aot_write_diagnostic(path: text, message: text) -> bool:
    """Persist a bounded owned diagnostic before its producing frame returns."""
    if path == "":
        return false
    # One Unicode scalar occupies at most four UTF-8 bytes, so this remains
    # within the driver's 4096-byte no-follow read bound.
    val bounded = if message.len() > BACKEND_AOT_DIAGNOSTIC_MAX_SCALARS:
        message[0:BACKEND_AOT_DIAGNOSTIC_MAX_SCALARS]
    else:
        message
    # The write result was DISCARDED here. That is how a failing backend became
    # unexplainable: every failure path in the backend dutifully calls this, the
    # write silently returned false, and the driver four frames up could only
    # report "diagnostic file empty" with no way to tell a backend that never
    # wrote from a write that failed. Surface it -- a diagnostic writer that can
    # fail silently is worse than none, because it makes the real fault look
    # like an absent one.
    # Unconditional, not env-gated: the Stage 2 child runs under `env -i` with
    # an allowlist, so a trace variable cannot reach it. This sits only on a
    # path that is already failing, and it answers the one question four
    # rounds of inference could not -- whether this writer is reached at all,
    # and with what. Remove once the backend failure is named.
    print "aot-diag: called msg_len={message.len()} bounded_len={bounded.len()} path_len={path.len()}"
    val written = file_atomic_write(path, bounded)
    if not written:
        print "warning: AOT diagnostic write failed ({path.len()} chars): {path}"
    written

export BACKEND_AOT_DIAGNOSTIC_MAX_SCALARS, backend_aot_write_diagnostic
