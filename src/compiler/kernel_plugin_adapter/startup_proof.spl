pub enum CompilerRootIntentV1:
    Help
    Version
    Compile

pub struct CompilerRootProviderProofV1:
    intent: CompilerRootIntentV1
    ordinary_provider_loads: u32
    dispatch_required: bool

pub fn compiler_root_provider_proof_v1(intent: CompilerRootIntentV1) -> CompilerRootProviderProofV1:
    match intent:
        case CompilerRootIntentV1.Help:
            CompilerRootProviderProofV1(intent, 0, false)
        case CompilerRootIntentV1.Version:
            CompilerRootProviderProofV1(intent, 0, false)
        case CompilerRootIntentV1.Compile:
            CompilerRootProviderProofV1(intent, 1, true)
