use common.kernel_plugin.ids.KpfId128

pub const COMPILER_DRIVER_KPF_INTERFACE_ID: KpfId128 = KpfId128(
    hi: 0x53494d504c454344, lo: 0x5249564552563100)
pub const COMPILER_DRIVER_KPF_PROVIDER_ID: KpfId128 = KpfId128(
    hi: 0x53494d504c455052, lo: 0x4f56494445523100)
pub const COMPILER_DRIVER_KPF_SCHEMA_DIGEST: u64 = 6000009050290832461
pub const COMPILER_DRIVER_KPF_OPERATION_RUN: u32 = 1

pub enum CompilerDriverKpfPlacementV1:
    Static
    Worker

pub enum CompilerDriverKpfStatusV1:
    Ok
    InvalidRequest
    PlacementMismatch
    WorkerFailure
    CompileFailed
    Closed

pub struct CompilerDriverKpfRequestV1:
    config_handle: u64
    request_epoch: u64

pub struct CompilerDriverKpfResultV1:
    status: CompilerDriverKpfStatusV1
    compile_status: i32
    diagnostic_count: u32
    generation: i64
    request_epoch: u64

pub struct CompilerDriverKpfReceiptV1:
    provider_id: KpfId128
    interface_id: KpfId128
    schema_digest: u64
    generation: i64
    placement: CompilerDriverKpfPlacementV1
    request_count: u64
