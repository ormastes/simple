use std.common.crypto.sha256.{sha256_text}

struct LayoutShapeInputV1:
    abi_version: text
    calling_convention: text
    size_bytes: i64
    alignment_bytes: i64
    pointer_map_digest: text
    layout_digest: text

struct LayoutShapeIdV1:
    digest: text

fn layout_shape_input_valid_v1(input: LayoutShapeInputV1) -> bool:
    input.abi_version != "" and
        input.calling_convention != "" and
        input.size_bytes >= 0 and
        input.alignment_bytes > 0 and
        input.pointer_map_digest != "" and
        input.layout_digest != ""

fn layout_shape_id_v1(input: LayoutShapeInputV1) -> LayoutShapeIdV1:
    if not layout_shape_input_valid_v1(input):
        return LayoutShapeIdV1("")
    LayoutShapeIdV1(sha256_text(
        "simple/layout-shape/v1" +
        "|abi={input.abi_version}" +
        "|cc={input.calling_convention}" +
        "|size={input.size_bytes}" +
        "|align={input.alignment_bytes}" +
        "|pointers={input.pointer_map_digest}" +
        "|layout={input.layout_digest}"))

fn layout_shapes_compatible_v1(left: LayoutShapeInputV1, right: LayoutShapeInputV1) -> bool:
    val left_id = layout_shape_id_v1(left)
    val right_id = layout_shape_id_v1(right)
    left_id.digest != "" and left_id.digest == right_id.digest

export LayoutShapeInputV1, LayoutShapeIdV1
export layout_shape_input_valid_v1, layout_shape_id_v1, layout_shapes_compatible_v1
