use std.common.crypto.sha256.{sha256_text}
use compiler.mono.shape.layout_shape.*

struct ShapeOperationV1:
    operation_id: text
    abi_digest: text
    implementation_digest: text

struct OperationDictionaryV1:
    shape_id: LayoutShapeIdV1
    operations: [ShapeOperationV1]
    digest: text

fn shape_operation_valid_v1(operation: ShapeOperationV1) -> bool:
    operation.operation_id != "" and
        operation.abi_digest != "" and
        operation.implementation_digest != ""

fn operation_dictionary_v1(
    shape_id: LayoutShapeIdV1,
    operations: [ShapeOperationV1]
) -> OperationDictionaryV1:
    if shape_id.digest == "" or operations.len() == 0:
        return OperationDictionaryV1(shape_id, [], "")
    var material = "simple/shape-operation-dictionary/v1|shape={shape_id.digest}"
    var previous = ""
    for operation in operations:
        if not shape_operation_valid_v1(operation) or operation.operation_id <= previous:
            return OperationDictionaryV1(shape_id, [], "")
        previous = operation.operation_id
        material = material +
            "|op={operation.operation_id}" +
            ":abi={operation.abi_digest}" +
            ":impl={operation.implementation_digest}"
    OperationDictionaryV1(shape_id, operations, sha256_text(material))

fn operation_dictionary_lookup_v1(
    dictionary: OperationDictionaryV1,
    operation_id: text
) -> ShapeOperationV1?:
    if dictionary.digest == "" or operation_id == "":
        return nil
    for operation in dictionary.operations:
        if operation.operation_id == operation_id:
            return Some(operation)
    nil

export ShapeOperationV1, OperationDictionaryV1
export shape_operation_valid_v1, operation_dictionary_v1, operation_dictionary_lookup_v1
