# Actual schedule/compact-state identities; no publisher or installer imports.
use compiler.mono.mono_archive_registration_types_v1.{MonoArchiveRootOrderV1,
    MonoArchiveRegistrationOwnerV1, MonoArchiveCurrentRegistrationOwnerV1}
use compiler.mono.mono_archive_state_v1.{mono_archive_state_digest_v1}
use compiler.mono.mono_archive_current_body_v1.{mono_archive_current_body_digest_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.common.crypto.sha256.{sha256_text}

fn mono_archive_registration_schedule_digest_v1(roots: [MonoArchiveRootOrderV1]) -> text:
    var writer = HirCodecWriter.create()
    writer.put_i64(roots.len())
    var seen: Dict<text, bool> = {}
    for module in roots:
        if seen.has(module.module_name): return ""
        seen[module.module_name] = true
        writer.put_text(module.module_name)
        writer.put_i64(module.symbols.len())
        var previous = -1
        for symbol in module.symbols:
            if symbol < 0 or symbol <= previous: return ""
            previous = symbol
            writer.put_i64(symbol)
    if not writer.ok: return ""
    sha256_text("mono-ordered-root-schedule-v1\n" + writer.finish())

fn mono_archive_registration_owner_digest_v1(owner: MonoArchiveRegistrationOwnerV1) -> text:
    val state_digest = mono_archive_state_digest_v1(owner.state)
    if state_digest == "" or owner.archives.len() != owner.roots.len(): return ""
    if owner.roots.len() == 0:
        if owner.published_schedule_digest != "": return ""
    else:
        if owner.published_schedule_digest == "" or
                mono_archive_registration_schedule_digest_v1(owner.roots) != owner.published_schedule_digest: return ""
    if owner.sealed and owner.sealed_schedule_digest != owner.published_schedule_digest: return ""
    var w = HirCodecWriter.create()
    w.put_text(state_digest)
    w.put_i64(owner.epoch)
    w.put_bool(owner.sealed)
    w.put_text(owner.published_schedule_digest)
    w.put_text(owner.sealed_schedule_digest)
    w.put_i64(owner.generic_functions)
    w.put_i64(owner.generic_structs)
    w.put_i64(owner.generic_classes)
    w.put_i64(owner.roots.len())
    var seen: Dict<text, bool> = {}
    for root in owner.roots:
        if seen.has(root.module_name): return ""
        seen[root.module_name] = true
        w.put_text(root.module_name)
        w.put_i64(root.symbols.len())
        for symbol in root.symbols: w.put_i64(symbol)
        if not owner.archives.has(root.module_name): return ""
        val archive: HirBodyArchiveV1 = owner.archives[root.module_name]
        w.put_text(archive.archive_key)
        w.put_text(archive.body_digest)
        w.put_text(archive.lowering_warnings_digest)
    if not w.ok: return ""
    sha256_text((if owner.logical_mode: "mono-logical-registration-owner-v1\n" else: "mono-registration-owner-v2\n") + w.finish())

fn mono_archive_current_registration_digest_v1(current: MonoArchiveCurrentRegistrationOwnerV1) -> text:
    val owner = current.registration
    # Only the empty factory digest may allocate outside scratch.
    if (owner.roots.len() > 0 and transient_array_scope_state_v1() != 1) or
            owner.state.epoch != 0 or owner.state.cursor != 0 or owner.state.queue.len() != 0 or
            owner.state.symbol_patches.len() != 0 or owner.state.spec_symbols.len() != 0 or owner.state.spec_display.len() != 0 or
            owner.state.spec_signatures.len() != 0 or owner.state.reported_once.len() != 0 or
            owner.state.unresolved_templates.len() != 0 or owner.state.emitted.len() != 0 or
            owner.state.fn_returns.len() != 0 or owner.state.sym_names.len() != 0:
        return ""
    val prior = mono_archive_registration_owner_digest_v1(owner)
    if prior == "" or owner.sealed or current.bodies.len() != owner.roots.len(): return ""
    var writer = HirCodecWriter.create()
    writer.put_text(prior)
    writer.put_text(current.cache.directory)
    writer.put_text(current.cache.producer_header)
    writer.put_bool(current.cache.enabled)
    for root in owner.roots:
        if not current.bodies.has(root.module_name): return ""
        val body = current.bodies[root.module_name]
        val digest = mono_archive_current_body_digest_v1(body)
        if digest == "" or body.original_parent.archive_key != owner.archives[root.module_name].archive_key: return ""
        writer.put_text(root.module_name)
        writer.put_text(digest)
    if not writer.ok: return ""
    sha256_text("mono-current-registration-owner-v1\n" + writer.finish())

export mono_archive_registration_schedule_digest_v1, mono_archive_registration_owner_digest_v1
export mono_archive_current_registration_digest_v1
