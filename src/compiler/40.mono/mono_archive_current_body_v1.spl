# Mechanical current-body identity. This is not prerequisite admission or a
# final-module capability. The driver must pin it to its accepted transform
# owner before supplying a production body reader.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_matches_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_codec.{hir_module_encode, hir_module_decode_stable}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{hir_body_archive_warnings_digest_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1,
    hir_owned_artifact_store_blob_v1, hir_owned_artifact_load_blob_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.common.crypto.sha256.{sha256_text}

struct MonoArchiveCurrentBodyV1:
    original_parent: HirBodyArchiveV1
    current_artifact_key: text
    current_body_digest: text
    current_warnings_digest: text
    current_stage: text
    parent_boundary_key: text
    parent_boundary_digest: text

# Complete module/warnings are borrowed scratch values, never receipt roots.
struct MonoArchiveCurrentBodyLoadV1:
    module: HirModule
    warnings: [text]

fn mono_archive_current_body_frame_v1(body: MonoArchiveCurrentBodyV1,
        blob: text, warnings: [text]) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text("post-hir-resolved-v1")
    writer.put_text(body.original_parent.input.module_name)
    writer.put_text(body.original_parent.input.source_path)
    writer.put_text(body.original_parent.archive_key)
    writer.put_text(body.original_parent.body_digest)
    writer.put_text(body.original_parent.lowering_warnings_digest)
    writer.put_text(body.parent_boundary_key)
    writer.put_text(body.parent_boundary_digest)
    writer.put_text(blob)
    writer.put_i64(warnings.len())
    for warning in warnings: writer.put_text(warning)
    if not writer.ok: return ""
    writer.finish()

fn mono_archive_current_body_key_v1(body: MonoArchiveCurrentBodyV1, frame: text) -> text:
    sha256_text("mono-current-body-artifact-v1\n" + sha256_text(frame) + "\n" +
        body.original_parent.archive_key + "\n" + body.parent_boundary_key + "\n" + body.parent_boundary_digest)

fn mono_archive_current_body_store_in_owned_scope_v1(context: HirOwnedArtifactContextV1,
        original_parent: HirBodyArchiveV1, boundary_key: text, boundary_digest: text,
        module: HirModule, warnings: [text]) -> Result<MonoArchiveCurrentBodyV1, text>:
    if transient_array_scope_state_v1() != 1:
        return Err("current body storage requires active unpaused parent scope")
    if not context.enabled or context.producer_header != original_parent.input.producer_header:
        return Err("current body cache producer differs from original parent")
    val blob = hir_module_encode(module)
    var body = MonoArchiveCurrentBodyV1(original_parent: original_parent,
        current_artifact_key: "", current_body_digest: sha256_text(blob),
        current_warnings_digest: hir_body_archive_warnings_digest_v1(warnings),
        current_stage: "post-hir-resolved-v1", parent_boundary_key: boundary_key, parent_boundary_digest: boundary_digest)
    if blob == "" or module.name != original_parent.input.module_name or
            module.path != original_parent.input.source_path or boundary_key.len() != 64 or boundary_digest.len() != 64 or
            not hir_body_archive_matches_v1(original_parent, original_parent.input):
        return Err("current body parent or complete encoding refused")
    val frame = mono_archive_current_body_frame_v1(body, blob, warnings)
    if frame == "": return Err("current body frame encoding refused")
    body.current_artifact_key = mono_archive_current_body_key_v1(body, frame)
    if mono_archive_current_body_digest_v1(body) == "": return Err("current body completed identity refused")
    val stored = hir_owned_artifact_store_blob_v1(context, body.current_artifact_key, frame)
    if stored.is_err(): return Err(stored.unwrap_err())
    Ok(body)

# Mechanical byte/body identity only. The production driver must additionally
# validate the genuinely accepted transformed prerequisite owner before use.
fn mono_archive_current_body_load_in_owned_scope_v1(context: HirOwnedArtifactContextV1,
        body: MonoArchiveCurrentBodyV1) -> Result<MonoArchiveCurrentBodyLoadV1, text>:
    if transient_array_scope_state_v1() != 1 or mono_archive_current_body_digest_v1(body) == "":
        return Err("current body read scope or descriptor refused")
    if not context.enabled or context.producer_header != body.original_parent.input.producer_header:
        return Err("current body read producer differs from original parent")
    val loaded = hir_owned_artifact_load_blob_v1(context, body.current_artifact_key)
    if loaded.is_err(): return Err(loaded.unwrap_err())
    val frame = loaded.unwrap()
    var reader = FlatPoolReader.new(frame)
    if reader.decode_text(reader.next()) != body.current_stage or
            reader.decode_text(reader.next()) != body.original_parent.input.module_name or
            reader.decode_text(reader.next()) != body.original_parent.input.source_path or
            reader.decode_text(reader.next()) != body.original_parent.archive_key or
            reader.decode_text(reader.next()) != body.original_parent.body_digest or
            reader.decode_text(reader.next()) != body.original_parent.lowering_warnings_digest or
            reader.decode_text(reader.next()) != body.parent_boundary_key or
            reader.decode_text(reader.next()) != body.parent_boundary_digest:
        return Err("current body frame parent or boundary refused")
    val blob = reader.decode_text(reader.next())
    val count = reader.next_len()
    if count > reader.lines.len() - reader.pos: return Err("current body warning count refused")
    var warnings: [text] = []
    var index = 0
    while index < count and reader.ok:
        warnings = warnings.push(reader.decode_text(reader.next()))
        index = index + 1
    if not reader.ok or reader.pos != reader.lines.len() - 1: return Err("current body frame exhaustion refused")
    if reader.lines[reader.pos] != "" or mono_archive_current_body_frame_v1(body, blob, warnings) != frame or
            mono_archive_current_body_key_v1(body, frame) != body.current_artifact_key or
            sha256_text(blob) != body.current_body_digest or
            hir_body_archive_warnings_digest_v1(warnings) != body.current_warnings_digest:
        return Err("current body stable frame or complete digest refused")
    if val module = hir_module_decode_stable(blob):
        if module.name == body.original_parent.input.module_name and module.path == body.original_parent.input.source_path:
            return Ok(MonoArchiveCurrentBodyLoadV1(module: module, warnings: warnings))
    Err("current complete module identity refused")

fn mono_archive_current_body_digest_v1(body: MonoArchiveCurrentBodyV1) -> text:
    if transient_array_scope_state_v1() != 1 or body.current_stage != "post-hir-resolved-v1" or
            body.current_artifact_key.len() != 64 or body.current_body_digest.len() != 64 or
            body.current_warnings_digest.len() != 64 or body.parent_boundary_key.len() != 64 or
            body.parent_boundary_digest.len() != 64 or
            body.current_artifact_key == body.original_parent.archive_key or
            not hir_body_archive_matches_v1(body.original_parent, body.original_parent.input):
        return ""
    var writer = HirCodecWriter.create()
    writer.put_text(body.original_parent.archive_key)
    writer.put_text(body.original_parent.body_digest)
    writer.put_text(body.original_parent.lowering_warnings_digest)
    writer.put_text(body.current_artifact_key)
    writer.put_text(body.current_body_digest)
    writer.put_text(body.current_warnings_digest)
    writer.put_text(body.current_stage)
    writer.put_text(body.parent_boundary_key)
    writer.put_text(body.parent_boundary_digest)
    if not writer.ok: return ""
    sha256_text("mono-current-body-mechanical-v1\n" + writer.finish())

export MonoArchiveCurrentBodyV1, mono_archive_current_body_digest_v1
export MonoArchiveCurrentBodyLoadV1
export mono_archive_current_body_store_in_owned_scope_v1, mono_archive_current_body_load_in_owned_scope_v1
