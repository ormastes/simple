use compiler.mono.mono_archive_nominal_v2.{MonoArchiveNominalDeclV2, mono_archive_nominal_project_v2, mono_archive_nominal_install_v2}
# Monomorphization Integration
#
# Integrates monomorphization into the compiler pipeline (driver Phase 4).
# Collects generic templates, drives a deterministic worklist fixed point
# (hardening plan section 9.3 steps 3-12) over the non-generic ROOTS, infers
# the type arguments of each generic call site from its argument types, emits
# one specialized HirFunction per distinct (template, type args), repoints
# every call site at its specialization, and prunes the consumed templates.
#
# Integration point: After HIR lowering + type checking, before MIR lowering


use compiler.hir.hir_types.*
# EXPLICIT, in addition to the glob above. A `use X.*` is not a declaration, a
# re-export hop, or an explicit import, so the imported-surface projection walk
# finds no ORIGIN for HirModule in this owner and the importer of
# `run_monomorphization` / `MonomorphizationPass` resolves it in ITS OWN scope
# with a synthesized span (span_file empty, line 0) and hard-errors.
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_definitions.{HirFunction, HirConst}
use compiler.hir.nominal_type_relocation.{hir_relocate_types}
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.monomorphize.engine.*
use compiler.monomorphize.types.ConcreteType
use compiler.monomorphize.type_subst.*
use compiler.mono.nominal_type_identity.{mono_owned_type_key, mono_owned_type_keys}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_owner_name.{hir_symbol_owner_module}
use std.io_runtime.{env_get}
use compiler.mono.mono_archive_types_v1.{
    MonoTemplateBodyModeV1, MonoTemplateSignatureV1, MonoTemplateRecipeV1,
    MonoSpecializationRequestV1, mono_template_signature_v1,
    mono_specialized_signature_v1, mono_apply_template_recipe_v1,
    mono_template_recipe_signature_v1
}

fn mono_arg_value(a: HirCallArg) -> HirExpr:
    """Typed-parameter accessor for HirCallArg.value (stage4 ANY-erasure
    hazard, bug doc iteration 18)."""
    a.value

# Nesting depth past which an instantiation chain is treated as polymorphic
# recursion (`f<T>` requesting `f<[T]>` forever) and refused loudly.
val MONO_MAX_TYPE_DEPTH: i64 = 16

# First SymbolId handed to a specialization (2^50). A fresh id used to be
# "largest FUNCTION id seen + 1", but a module's SymbolTable also holds its
# locals, params and type symbols, and the repointed callee's id is read
# through the CALLER's table by MIR: `pick_second$str` landed on id 4 ==
# `g_untyped`, so MIR named the specialization after that local, typed the
# call through the local's symbol (i64) and the `text` instance printed as a
# pointer / SEGV'd on `.len()` (stage2 micro_b / micro_f, BUG-IT-5). Same
# constant as the parked generic-class lane
# (doc/08_tracking/bug/mono_specialization_symbol_id_collision_2026-10-10.md).
#
# ONE id-space rule for specializations (three mechanisms, one invariant --
# "no SymbolId a module can see names two things"):
#   1. ids come from a single pass-wide counter that starts at this base and
#      is first advanced past every input table's own counter
#      (`collect_generics`), so an id is unique across ALL modules of the
#      pass and deterministic (module-key order, then request order);
#   2. a module that never OWNS a specialization keeps its compact counter:
#      nothing it mints later can reach this range, so the specialization
#      ids its call sites name stay unaliased;
#   3. the OWNING module gets a row per specialization
#      (`register_preserved_symbol`, which lifts that table's counter into
#      this range); its counter is then set to the pass's FINAL counter, so
#      what MIR mints there afterwards is past every specialization of the
#      pass, not just past the ones this module owns.
val MONO_SYMBOL_BASE: i64 = 1125899906842624

# Nominal ids are local to a symbol table. Inference between a template and
# its caller compares declaration owners, including nested type arguments.
struct NominalBindingContext:
    pattern_symbols: SymbolTable
    argument_symbols: SymbolTable
    pattern_module: text
    argument_module: text

# ============================================================================
# Monomorphization Pass
# ============================================================================

class MonomorphizationPass:
    """Runs monomorphization on HIR modules."""
    # Compatibility field for callers constructing the pass. The integration
    # owns its worklist and emitted bodies below; the legacy engine table is
    # not populated with a second, never-consumed copy of those bodies.
    monomorphizer: Monomorphizer
    # Original generic function bodies, keyed by template name. Canonical
    # signatures are body-free; only demanded specializations rewrite bodies.
    generic_functions: Dict<text, HirFunction>
    generic_structs: Dict<text, HirStruct>
    generic_classes: Dict<text, HirClass>
    # Module each generic function template was declared in
    template_module: Dict<text, text>
    # Specialized versions created, keyed by MANGLED name
    specialized_functions: Dict<text, HirFunction>
    specialized_structs: Dict<text, HirStruct>
    specialized_classes: Dict<text, HirClass>
    # Mangled name -> template name / module, for pruning and placement
    spec_template: Dict<text, text>
    spec_module: Dict<text, text>
    # Symbol id -> declared name, built while collecting (a call site names its
    # callee by SymbolId; the generic tables are keyed by name).
    # Keyed "<module>#<id>": SymbolIds are only unique PER MODULE, so a
    # global i64 key let module B's symbol 5 resolve to module A's generic
    # at id 5 (mis-specialization) -- measured on a 2-module fixture 2026-08-22.
    sym_names: Dict<text, text>
    # Symbol id -> declared return type of every NON-generic function, used by
    # local argument-type inference.
    fn_returns: Dict<text, HirType>
    # Same key -> full `fn(params) -> ret` type of every NON-generic
    # function, so a bare function REFERENCE passed as an argument
    # (`walk(e, acc, collect)`) binds a `fn(..., C) -> C` parameter.
    fn_sigs: Dict<text, HirType>
    # Non-generic struct/class/enum NAME -> its Named type, so a constructor
    # call `Acc(n: 1)` (lowered as Call(NamedVar("Acc"))) types as Acc. A
    # name declared by two modules is ambiguous and is not recorded.
    named_types: Dict<text, HirType>
    named_ambiguous: Dict<text, bool>
    # "<module>#<symbol id>" -> declared name of a struct/class/enum, so a
    # specialization is mangled by the TYPE NAME, not a module-local symbol
    # id that two modules can both hand out.
    named_symbol_names: Dict<text, text>
    # "<Type>::<field>" -> declared field type of every NON-generic struct or
    # class, so a generic argument reached through a field chain
    # (`eq(a.glyph_run.glyph_ids, ...)`, `without(self.globals, ...)`) types.
    field_types: Dict<text, HirType>
    # Same key -> module that declared the field (its SymbolIds' owner).
    field_owner_modules: Dict<text, text>
    # "<EnumName>::<Variant>" -> declared payload types, tuple payloads in
    # positional order and struct payloads keyed "<Enum>::<Variant>::<field>".
    # Match-arm pattern bindings are the ONLY binding form that carries no
    # `let` and no param, so without this table `infer_expr_type` returns nil
    # for every pattern-bound variable and `infer_call_type_args` fail-closes
    # to `[]` -> E-MONO-032 -> E-MONO-033. That is not a corner case: the
    # generated `hir_hash.spl` calls the generic `_hir_mix_prim<T>` 67 times
    # and EVERY argument is a match-arm binding, so the stage1 closure could
    # not survive monomorphization until these were bound (plan §9.4
    # "local annotations" / "enum payloads").
    enum_payload_types: Dict<text, HirType>
    # Enum name derived from the scrutinee of the match currently being walked.
    match_enum_hint: text
    # Module whose function bodies are being rewritten right now (scopes the
    # two maps above).
    current_module: text
    # Module name -> source path, so an unrewritten call site is reported as
    # `path:line:col` instead of an unlocatable message.
    module_paths: Dict<text, text>
    # Function return context is scoped and suspended for nested lambdas.
    current_return_type: HirType?
    # "<module>#<symbol id>" of every NON-GENERIC function, so a call whose
    # callee resolved to a LOCAL non-generic function is not misclassified
    # as a call to a same-short-named generic template collected from another
    # module (generic_functions is keyed by short name globally; the local
    # non-generic shadow must win). Cycle-40 frontier: every local call to
    # plugins/backend_llvm_lib's non-generic `_sffi_tuple_get(i64,i64)->i64`
    # was flagged unspecialized against 50.mir's `_sffi_tuple_get<T>`.
    plain_fn_symbols: Dict<text, bool>
    # Specializations whose bodies still have to be walked (FIFO worklist).
    spec_queue: [text]
    # Mangled name -> SymbolId allocated for the specialized function.
    archive_nominal_rows: Dict<text, MonoArchiveNominalDeclV2> = {}
    archive_nominal_keys: Dict<text, [text]> = {}
    archive_nominal_imports: Dict<text, MonoArchiveNominalDeclV2> = {}
    archive_caller_returns: Dict<text, HirType> = {}
    spec_symbols: Dict<text, i64>
    # Injective instantiation key (`type_key`) -> display name; see `mangled_name`.
    spec_display: Dict<text, text> = {}
    # Next free symbol id (seeded past every id seen while collecting).
    next_symbol: i64
    # Local-inference environment for the function being rewritten:
    # symbol id -> known concrete type (params, annotated lets, lambda params).
    env: Dict<i64, HirType>
    # Loud diagnostics for every generic call site this pass could not rewrite.
    diagnostics: [text]
    # Diagnostics whose level resolved to `warning` (`mono_diag_level`): the
    # build goes on and the site keeps the lowering it had before this pass
    # learned to recognise it.
    warnings: [text] = []
    # "<code>|<subject>" already reported, for once-per-subject diagnostics.
    reported_once: Dict<text, bool> = {}
    # Templates with >= 1 call site left unrewritten; never pruned, so the
    # dangling call and the template both stay visible to the verifier.
    unresolved_templates: Dict<text, bool>
    # Instance methods of a generic impl (`impl Box<T>:`), keyed
    # "<owner module>.<Class>::<method>" (the class's ownership identity) ->
    # the template's key in `generic_functions`. Such a method is a template
    # over the IMPL's type parameters, so a call on a receiver typed
    # `Box<i64>` is specialized by the receiver's type arguments.
    generic_methods: Dict<text, text>
    # Same key -> why a generic impl's method cannot be specialized by the
    # receiver's arguments alone. A call on a concrete instantiation is then
    # a loud E-MONO-034, never a silent bind to the unspecialized template.
    generic_method_rejected: Dict<text, text>
    # Module name -> its SymbolTable, to read a receiver type's identity.
    module_symbols: Dict<text, SymbolTable>
    # Generic struct/class tables, keyed by ownership identity
    # (`<owner module>.<Name>`): its type parameters, declaring module, field
    # order, and "<identity>::<field>" -> the declared field type with every
    # parameter spelled `TypeParam`. They type a value that flows THROUGH an
    # instance: `Box(item: "x")` is `Box<text>`, and `b.item` on it is `text`.
    generic_type_params: Dict<text, [HirTypeParam]> = {}
    generic_type_modules: Dict<text, text> = {}
    generic_type_field_names: Dict<text, [text]> = {}
    generic_type_fields: Dict<text, HirType> = {}
    # Statistics
    stats: MonoStats
    # Declared module constants/statics, keyed by module + actual SymbolId.
    # Raw IDs repeat in other modules; source names are not type authority.
    declared_global_types: Dict<text, HirType> = {}
    # Explicit consumer ownership, never an ambient production activation flag.
    archive_nominal_projection_valid: bool = true
    template_body_mode: MonoTemplateBodyModeV1 = MonoTemplateBodyModeV1.Retained
    # Body-free canonical signatures in both retained and archive modes.
    archive_template_signatures: Dict<text, MonoTemplateSignatureV1> = {}
    archive_specialized_signatures: Dict<text, MonoTemplateSignatureV1> = {}
    archive_symbol_identities: Dict<text, text> = {}
    template_recipes: Dict<text, MonoTemplateRecipeV1> = {}
    archive_requests: [MonoSpecializationRequestV1] = []
    # Filled only from completed FIFO emission records during archive assembly.
    archive_emitted_templates: Dict<text, text> = {}

struct MonoStats:
    generic_functions_found: i64
    generic_structs_found: i64
    generic_classes_found: i64
    call_sites_found: i64
    specializations_created: i64
    # Generic call sites left UNREWRITTEN (type args neither written nor
    # inferable, or an instantiation chain that never terminates). Each one
    # has a matching entry in `MonomorphizationPass.diagnostics`.
    unresolved_generic_calls: i64

impl MonomorphizationPass:
    static fn create() -> MonomorphizationPass:
        MonomorphizationPass(
            monomorphizer: monomorphizer_create(),
            generic_functions: {},
            generic_structs: {},
            generic_classes: {},
            template_module: {},
            specialized_functions: {},
            specialized_structs: {},
            specialized_classes: {},
            spec_template: {},
            spec_module: {},
            sym_names: {},
            current_module: "",
            module_paths: {},
            current_return_type: nil,
            plain_fn_symbols: {},
            fn_sigs: {},
            named_types: {},
            named_ambiguous: {},
            named_symbol_names: {},
            field_types: {},
            field_owner_modules: {},
            enum_payload_types: {},
            match_enum_hint: "",
            fn_returns: {},
            spec_queue: [],
            spec_symbols: {},
            spec_display: {},
            next_symbol: MONO_SYMBOL_BASE,
            env: {},
            diagnostics: [],
            warnings: [],
            reported_once: {},
            unresolved_templates: {},
            generic_methods: {},
            generic_method_rejected: {},
            module_symbols: {},
            generic_type_params: {},
            generic_type_modules: {},
            generic_type_field_names: {},
            generic_type_fields: {},
            stats: MonoStats(
                generic_functions_found: 0,
                generic_structs_found: 0,
                generic_classes_found: 0,
                call_sites_found: 0,
                specializations_created: 0,
                unresolved_generic_calls: 0
            ),
            declared_global_types: {}
        )

    # ========================================================================
    # Main Entry Point
    # ========================================================================

    me process_modules(modules: Dict<text, HirModule>) -> Dict<text, HirModule>:
        """Process all modules through monomorphization.

        Steps (plan section 9.3):
        1. Collect generic definitions from all modules
        2. Walk every non-template ROOT function: infer + request + rewrite
           each generic call site, then drain the specialization worklist to
           a fixed point (a specialization's body can request more)
        3. Insert the specializations into their template's module
        4. Prune the consumed templates

        BUG-001 fix: Use keys()-based iteration instead of `for (k,v) in dict`
        tuple destructuring, which silently produces zero iterations in compiled
        (bootstrap gen2) mode, causing hir_modules to become empty.
        """
        self.declared_global_types = {}
        val mod_keys = modules.keys()

        # Step 1: Collect generic definitions
        for name in mod_keys:
            val module: HirModule = modules[name]
            self.module_paths[name] = module.path
            self.collect_declared_globals(module, name)
            self.collect_generics(module, name)

        if self.stats.generic_functions_found == 0 and self.stats.generic_structs_found == 0 and self.stats.generic_classes_found == 0:
            return modules

        # Step 2: roots -> requests -> specializations -> fixed point.
        # Roots are walked in module-key order, then ascending symbol id, so
        # the specialization set and the symbol ids handed out are a pure
        # function of the input.
        var rewritten: Dict<text, Dict<SymbolId, HirFunction>> = {}
        var rewritten_consts: Dict<text, Dict<SymbolId, HirConst>> = {}
        for name in mod_keys:
            val module: HirModule = modules[name]
            self.current_module = name
            var funcs: Dict<SymbolId, HirFunction> = {}
            val function_values: [HirFunction] = module.functions.values()
            for function_index in sorted_function_indices(function_values):
                val func: HirFunction = function_values[function_index]
                val sym_id: SymbolId = func.symbol
                if is_generic_function(func) or func.is_generic_template:
                    funcs[sym_id] = func
                    continue
                funcs[sym_id] = self.rewrite_function(func)
            # Mono must also rewrite generic call sites in module-global
            # constant/var INITIALIZERS, not only function bodies: a call like
            # `var _lock: Mutex = mutex_new(0)` (dynamic_probe.spl) survived
            # here untouched and was lowered as a direct call to the generic
            # template's bare name, which MIR never emits -> undefined symbol
            # at link with no compile error anywhere. Rewrite the initializer
            # through the same expression pass so the call becomes a
            # specialization request like any other. (module is a value copy;
            # carry the rewritten table into step 3 via rewritten_consts.)
            var consts: Dict<SymbolId, HirConst> = module.constants
            for const_key in consts.keys():
                val const: HirConst = consts[const_key]
                if const.value == nil:
                    continue
                # Hoist the empty statement list to a typed local: the seed
                # parser rejects an inline `[]` literal in constructor-call
                # argument position ("expected Comma, found RBracket",
                # measured 2026-10-16 during stage2 discovery on this file).
                val no_stmts: [HirStmt] = []
                val wrapped = HirBlock(stmts: no_stmts, has: true, value: const.value, span: Span.empty())
                val rewritten_block = self.rewrite_block(wrapped, nil)
                consts[const_key] = HirConst(
                    symbol: const.symbol, name: const.name, type_: const.type_,
                    value: rewritten_block.value, is_mutable: const.is_mutable,
                    visibility: const.visibility, is_public: const.is_public,
                    is_volatile: const.is_volatile,
                    has_fixed_address: const.has_fixed_address,
                    fixed_address: const.fixed_address)
            rewritten_consts[name] = consts
            rewritten[name] = funcs
        self.drain_worklist()

        # Steps 3/4: place every specialization and prune its owner after the
        # fixed point. Pruning consults pass-wide specialization facts only;
        # it does not need a second complete inventory of unpruned modules.
        var result: Dict<text, HirModule> = {}
        for name in mod_keys:
            val module: HirModule = modules[name]
            var out = module
            if self.module_symbols.has(name):
                out.symbols = self.module_symbols[name]
            if rewritten_consts.has(name):
                out.constants = rewritten_consts[name]
            var funcs: Dict<SymbolId, HirFunction> = rewritten[name]
            var owns_specialization = false
            for mangled in self.specialized_functions.keys():
                val m: text = mangled
                if self.spec_module[m] != name:
                    continue
                val spec: HirFunction = self.specialized_functions[m]
                funcs[spec.symbol] = spec
                # MIR uses the owning table to resolve callable identity. A
                # specialization must have a row just like a parsed function.
                out.symbols.register_preserved_symbol(HirSymbol(
                    id: spec.symbol, name: spec.name, kind: SymbolKind.Function,
                    type_: nil, scope: ScopeId(id: 0), span: spec.span,
                    visibility: Visibility.Private, is_public: false,
                    is_mutable: false, defining_module: name,
                    builtin_method_tag: BUILTIN_METHOD_NONE))
                owns_specialization = true
            # Rule 3 at MONO_SYMBOL_BASE: an owner also CALLS specializations
            # other modules own; its counter must clear all of them.
            if (owns_specialization or out.symbols.next_symbol_id >= MONO_SYMBOL_BASE) and out.symbols.next_symbol_id < self.next_symbol:
                out.symbols.next_symbol_id = self.next_symbol
            out.functions = funcs
            result[name] = self.prune_consumed_templates(out)
            # Its function table is now owned by the result. Module iteration
            # uses the frozen mod_keys list, never the shrinking table keys.
            rewritten.remove(name)

        result

    # ========================================================================
    # Step 1: Collect Generic Definitions
    # ========================================================================

    me collect_generics(module: HirModule, module_name: text):
        """Collect generic functions, structs, and classes from a module.

        BUG-001 fix: Use keys()-based iteration instead of tuple destructuring.
        """
        # Locals, parameters and type parameters share the same ID namespace
        # as functions. Reserving only function IDs aliases fresh callees to
        # those rows (and can turn a nil local into an indirect call).
        # Read the table's own counter, not its keys: the keys of an `{i64: ..}`
        # dict come back as TEXT on the seed, so `raw_id >= self.next_symbol`
        # failed there with "comparing string with integer". The symbol table
        # keeps `next_symbol_id` above every id it holds (define and
        # register_preserved_symbol both advance it).
        if module.symbols.next_symbol_id > self.next_symbol:
            self.next_symbol = module.symbols.next_symbol_id
        # Collect generic functions
        # Typed rebinds (`val func: HirFunction = ...`): Dict values are
        # ANY-erased by the seed; field reads (func.type_params) on the
        # untyped value hit the most-fields-wins resolver and misread as
        # non-nil garbage, making is_generic_function(main) TRUE for a
        # plain -c module and dragging the whole mono scan in (iteration 18).
        val functions = module.functions
        # Seed the fresh-symbol counter past the module TABLE's next free id,
        # not only past its function ids (loop below): a type parameter or
        # local can hold a higher id, and a specialization landing on it was
        # named after that symbol in MIR (`walk$i64` -> `walker_abi.C`).
        # Verified post-mono as E-MONO-035; a fixed high-range base (parked
        # branch) satisfies the same invariant and makes this a no-op.
        # doc/08_tracking/bug/mono_specialization_symbol_id_collision_2026-10-10.md
        if module.symbols != nil:
            if module.symbols.next_symbol_id > self.next_symbol:
                self.next_symbol = module.symbols.next_symbol_id
        for sym_id in functions.keys():
            val func: HirFunction = functions[sym_id]
            # Record the symbol -> name edge for call-site resolution, and keep
            # the fresh-symbol counter past every id already in use.
            val fsym: SymbolId = func.symbol
            self.sym_names[mono_sym_key(module_name, fsym.id)] = func.name
            if fsym.id >= self.next_symbol:
                self.next_symbol = fsym.id + 1
            if is_generic_function(func):
                # Canonicalize `Named(sym_of_T, [])` -> `TypeParam("T")` once,
                # so inference and substitution see one spelling.
                val recipe = MonoTemplateRecipeV1(module_name: module_name,
                    original_symbol: func.symbol, template_name: func.name,
                    canonical_type_params: func.type_params,
                    bound_type_params: func.type_params, inherent_method: false)
                self.archive_template_signatures[func.name] = mono_template_recipe_signature_v1(func, recipe)
                if self.template_body_mode == MonoTemplateBodyModeV1.Retained:
                    self.generic_functions[func.name] = func
                self.template_recipes[func.name] = recipe
                self.template_module[func.name] = module_name
                self.stats.generic_functions_found = self.stats.generic_functions_found + 1
            else:
                self.fn_returns[mono_sym_key(module_name, fsym.id)] = func.return_type
                self.plain_fn_symbols[mono_sym_key(module_name, fsym.id)] = true
                if not func.is_method:
                    var ptys: [HirType] = []
                    for p in func.params:
                        val pp: HirParam = p
                        ptys = ptys.push(pp.type_)
                    self.fn_sigs[mono_sym_key(module_name, fsym.id)] = HirType(kind: HirTypeKind.Function(ptys, func.return_type, []), span: func.span)

        # Imported callables are declarations in this module's symbol table,
        # not bodies in module.functions. Their signatures were lowered in the
        # caller's type scope by import registration. Preserve that scope: a
        # callee-module SymbolId or a display-name lookup can alias a different
        # nominal type (or a shadowed callable) in this module.
        # declared_imported_surface_callable_type leaves generic imports untyped,
        # including unused type parameters; never invent a signature for them.
        if module.symbols != nil:
            for imported_id in module.symbols.symbols.keys():
                val imported: HirSymbol = module.symbols.symbols[imported_id]
                if imported.kind != SymbolKind.Function or imported.type_ == nil:
                    continue
                if not imported.defining_module.?:
                    continue
                val signature: HirType = imported.type_ ?? HirType(kind: HirTypeKind.Error, span: Span.empty())
                if not hir_type_is_concrete(signature):
                    continue
                val key = mono_sym_key(module_name, imported.id.id)
                if self.fn_returns.has(key):
                    continue
                match signature.kind:
                    case HirTypeKind.Function(_, ret, _):
                        self.fn_returns[key] = ret
                        self.fn_sigs[key] = signature
                    case _: ()

        # Collect generic structs
        val structs = module.structs
        for sym_id in structs.keys():
            val s: HirStruct = structs[sym_id]
            self.record_named_type(module_name, s.symbol, s.name, s.type_params.len() == 0)
            if s.type_params.len() == 0:
                self.record_field_types(module_name, s.name, s.fields)
            if is_generic_struct(s):
                self.record_generic_type(module, module_name, s.symbol, s.type_params, s.fields)
                if self.template_body_mode == MonoTemplateBodyModeV1.Retained:
                    self.generic_structs[s.name] = s
                self.stats.generic_structs_found = self.stats.generic_structs_found + 1

        # Collect enum variant payload types. Enums were not collected at all
        # before: nothing in the pass needed them until match-arm pattern
        # bindings had to be typed (see `enum_payload_types`). Generic enums
        # are recorded too -- their payload types stay `TypeParam(...)`, which
        # `hir_type_is_concrete` rejects downstream, so recording them cannot
        # manufacture a wrong binding, only a correctly-refused one.
        val enums = module.enums
        for sym_id in enums.keys():
            val en: HirEnum = enums[sym_id]
            self.record_named_type(module_name, en.symbol, en.name, en.type_params.len() == 0)
            for v in en.variants:
                val vt: HirVariant = v
                match vt.kind:
                    case HirVariantKind.Unit:
                        pass_do_nothing("no payload")
                    case HirVariantKind.Tuple(types):
                        var ti = 0
                        for t in types:
                            val tt: HirType = t
                            self.enum_payload_types["{en.name}::{vt.name}::{ti}"] = tt
                            if mono_diag_enabled():
                                eprint("[mono-diag] enum payload {en.name}::{vt.name}::{ti} concrete={hir_type_is_concrete(tt)}")
                            ti = ti + 1
                    case HirVariantKind.Struct(fields):
                        for f in fields:
                            val ft: HirField = f
                            self.enum_payload_types["{en.name}::{vt.name}::{ft.name}"] = ft.type_

        # Collect generic classes
        val classes = module.classes
        for sym_id in classes.keys():
            val c: HirClass = classes[sym_id]
            self.record_named_type(module_name, c.symbol, c.name, c.type_params.len() == 0)
            if c.type_params.len() == 0:
                self.record_field_types(module_name, c.name, c.fields)
            if is_generic_class(c):
                self.record_generic_type(module, module_name, c.symbol, c.type_params, c.fields)
                if self.template_body_mode == MonoTemplateBodyModeV1.Retained:
                    self.generic_classes[c.name] = c
                self.stats.generic_classes_found = self.stats.generic_classes_found + 1

        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            val nominal = mono_archive_nominal_project_v2(module_name, module.symbols)
            for key in nominal.keys(): self.archive_nominal_rows[key] = nominal[key]
            self.archive_nominal_keys[module_name] = nominal.keys().sort()
            for raw_id in module.symbols.symbols.keys():
                val symbol: HirSymbol = module.symbols.symbols[raw_id]
                self.archive_symbol_identities[mono_sym_key(module_name, symbol.id.id)] =
                    mono_type_identity(module.symbols, symbol.id, module_name)
        else:
            self.module_symbols[module_name] = module.symbols
        self.collect_generic_impl_methods(module, module_name)

    me collect_generic_impl_methods(module: HirModule, module_name: text):
        """Register each instance method of a generic inherent impl
        (`impl Box<T>:`, possibly in an extension module) as a function
        template over the impl's type parameters, receiver first (`self` is
        params[0]).

        HIR flags these methods `is_generic_template` and MIR never emits a
        template, so without a specialization a call on a `Box<i64>` receiver
        has no callable target. Only the shape the receiver's arguments can
        bind positionally is accepted -- an inherent impl whose target is
        exactly its own parameters in order, and a method with no type
        parameters of its own; every other method is recorded as rejected."""
        var by_id: Dict<i64, HirFunction> = {}
        var body_index_ready = false
        for raw_impl in module.impls:
            val gi: HirImpl = raw_impl
            val impl_tps: [HirTypeParam] = gi.type_params
            if impl_tps.len() == 0:
                continue
            # Build the body index once, only when a generic impl needs it.
            # Keep one impl traversal even when the first generic impl is last.
            if not body_index_ready:
                for raw_fn in module.functions.values():
                    val f: HirFunction = raw_fn
                    val fs: SymbolId = f.symbol
                    by_id[fs.id] = f
                body_index_ready = true
            var owner_identity = ""
            var owner_name = ""
            var target_reason = ""
            match gi.type_.kind:
                case HirTypeKind.Named(owner_sym, target_args):
                    owner_identity = mono_type_identity(module.symbols, owner_sym, module_name)
                    if val owner_info = module.symbols.get_symbol_raw(owner_sym.id):
                        owner_name = owner_info.name
                    if not mono_impl_target_is_canonical(target_args, impl_tps):
                        target_reason = "its impl target does not name the impl's type parameters in order"
                case _: ()
            if owner_identity == "" or owner_name == "":
                continue
            if gi.has_trait_:
                target_reason = "it is declared by a trait impl"
            for method_name in gi.methods.keys():
                val msym: SymbolId = gi.methods[method_name]
                if not by_id.has(msym.id):
                    continue
                val template: HirFunction = by_id[msym.id]
                if template.is_static or not template.is_method or template.params.len() == 0:
                    continue
                val method_key = "{owner_identity}::{method_name}"
                val gname = "{owner_name}__{method_name}"
                var reason = target_reason
                # Every symbol spelling of a parameter is canonicalized, but a
                # NAME binds once: the receiver's type arguments bind the
                # impl's parameters, in order.
                var all_tps: [HirTypeParam] = []
                var bound_tps: [HirTypeParam] = []
                var bound_names: [text] = []
                for itp in impl_tps:
                    val impl_tp: HirTypeParam = itp
                    all_tps = all_tps.push(impl_tp)
                    if not bound_names.contains(impl_tp.name):
                        bound_names = bound_names.push(impl_tp.name)
                        bound_tps = bound_tps.push(impl_tp)
                val impl_bound_count = bound_tps.len()
                for otp in template.type_params:
                    val own_tp: HirTypeParam = otp
                    all_tps = all_tps.push(own_tp)
                    if not bound_names.contains(own_tp.name):
                        bound_names = bound_names.push(own_tp.name)
                        bound_tps = bound_tps.push(own_tp)
                if reason == "" and bound_tps.len() != impl_bound_count:
                    reason = "it declares type parameters of its own"
                if reason == "" and (self.has_template_v1(gname) or self.generic_methods.has(method_key)):
                    reason = "another module declares a method under the same template key `{gname}`"
                    # The earlier registration is equally unusable.
                    for prior_key in self.generic_methods.keys():
                        val pk: text = prior_key
                        if self.generic_methods[pk] == gname:
                            self.generic_method_rejected[pk] = reason
                if reason != "":
                    self.generic_method_rejected[method_key] = reason
                    continue
                val recipe = MonoTemplateRecipeV1(module_name: module_name,
                    original_symbol: template.symbol, template_name: gname,
                    canonical_type_params: all_tps, bound_type_params: bound_tps,
                    inherent_method: true)
                self.archive_template_signatures[gname] = mono_template_recipe_signature_v1(template, recipe)
                if self.template_body_mode == MonoTemplateBodyModeV1.Retained:
                    self.generic_functions[gname] = template
                self.template_recipes[gname] = recipe
                self.template_module[gname] = module_name
                self.generic_methods[method_key] = gname

    # ========================================================================
    # Step 2: Worklist fixed point
    # ========================================================================

    me collect_declared_globals(module: HirModule, module_name: text):
        # HirConst also represents mutable module-level pools. Its symbol is
        # the declaration identity; bootstrap constants' dictionary keys can
        # instead be declaration indices, so never substitute the map key.
        for key in module.constants.keys():
            val declaration: HirConst = module.constants[key]
            if declaration.symbol.is_valid() and hir_type_is_concrete(declaration.type_):
                self.declared_global_types[mono_sym_key(module_name, declaration.symbol.id)] = declaration.type_
        # Imported constants are registered as consumer-scope Const symbols,
        # with their projected declaration type and provider in
        # defining_module; they are not copied into module.constants. Index
        # that exact alias identity under the consumer module so expressions
        # referencing the import resolve without a global name/leaf fallback.
        val symbol_ids = module.symbols.symbols.keys()
        for raw_id in symbol_ids:
            val symbol: HirSymbol = module.symbols.symbols[raw_id]
            if symbol.kind != SymbolKind.Const or symbol.type_ == nil:
                continue
            if not symbol.defining_module.?:
                continue
            val defining_module: text = symbol.defining_module ?? ""
            if defining_module == "" or defining_module == module.name or defining_module == module_name:
                continue
            val imported_type: HirType = symbol.type_ ?? HirType(kind: HirTypeKind.Error, span: Span.empty())
            if symbol.id.is_valid() and hir_type_is_concrete(imported_type):
                self.declared_global_types[mono_sym_key(module_name, symbol.id.id)] = imported_type

    me declared_global_type(symbol: SymbolId) -> HirType?:
        val key = mono_sym_key(self.current_module, symbol.id)
        if self.declared_global_types.has(key):
            val declared: HirType = self.declared_global_types[key]
            if hir_type_is_concrete(declared): return declared
        nil

    me rewrite_function(func: HirFunction) -> HirFunction:
        """Rewrite every generic call site in one function body.

        Seeds the local-inference environment with the parameter types, then
        pre-collects every annotated `let` (SymbolIds are unique per module,
        so scoping cannot alias two lets)."""
        self.env = {}
        val previous_return_type = self.current_return_type
        self.current_return_type = func.return_type
        for p in func.params:
            val pt: HirParam = p
            val ps: SymbolId = pt.symbol
            self.env[ps.id] = pt.type_
        if mono_diag_enabled():
            eprint("[mono-diag] rewrite_function {func.name} stmts={func.body.stmts.len()}")
        self.collect_lets_block(func.body)
        var out = func
        out.body = self.rewrite_block(func.body, func.return_type)
        self.current_return_type = previous_return_type
        out

    me drain_worklist():
        """Walk each queued specialization's body; a body can enqueue more.

        Terminates because every request is deduplicated by mangled name and
        `request_specialization` refuses instantiations deeper than
        `MONO_MAX_TYPE_DEPTH`."""
        var i = 0
        while i < self.spec_queue.len():
            val mangled: text = self.spec_queue[i]
            val spec: HirFunction = self.specialized_functions[mangled]
            self.current_module = self.spec_module[mangled]
            self.specialized_functions[mangled] = self.rewrite_function(spec)
            i = i + 1

    me mangled_name(func_name: text, type_args: [HirType]) -> text:
        """Display (symbol) name of one instantiation. The mangling is not
        injective (`Result`/`Slice`/`Ref` inside a tuple spell `unknown`,
        `_` both separates and nests), so identity is the structural
        `type_key`; a second instantiation that would spell like an existing
        one gets a `_k<n>` suffix instead of silently sharing its body."""
        if type_args.len() == 0:
            return func_name
        val argument_key = self.type_keys(type_args)
        if argument_key == "":
            self.diagnostics = self.diagnostics.push(
                "E-MONO-041: instantiation of `{func_name}` has a nominal type with no proven declaration owner in `{self.current_module}`; not specialized")
            return ""
        val key = "{func_name}${argument_key}"
        if self.spec_display.has(key):
            return self.spec_display[key]
        var display = "{func_name}${self.mangle_type_args(type_args)}"
        if self.spec_symbols.has(display):
            val base = display
            var n = 1
            display = "{base}_k{n}"
            while self.spec_symbols.has(display):
                n = n + 1
                display = "{base}_k{n}"
        self.spec_display[key] = display
        display

    me type_keys(types: [HirType]) -> text:
        self.ensure_archive_nominal_table_v2(self.current_module)
        val symbols: SymbolTable? = self.module_symbols[self.current_module] ?? nil
        mono_owned_type_keys(types, symbols, self.current_module)

    me same_type_key(left: HirType, right: HirType) -> bool:
        val left_key = self.type_key(left)
        left_key != "" and left_key == self.type_key(right)

    me type_key(t: HirType) -> text:
        """Owner-qualified structural identity, or empty if ownership is unknown."""
        self.ensure_archive_nominal_table_v2(self.current_module)
        val symbols: SymbolTable? = self.module_symbols[self.current_module] ?? nil
        mono_owned_type_key(t, symbols, self.current_module)

    me ensure_archive_nominal_table_v2(module: text) -> bool:
        if self.template_body_mode != MonoTemplateBodyModeV1.ArchiveRequests: return self.module_symbols.has(module)
        if self.module_symbols.has(module): return true
        if not self.module_paths.has(module): return false
        var rows: Dict<text, MonoArchiveNominalDeclV2> = {}
        if self.archive_nominal_keys.has(module):
            for key in self.archive_nominal_keys[module]:
                if self.archive_nominal_rows.has(key): rows[key] = self.archive_nominal_rows[key]
                elif self.archive_nominal_imports.has(key): rows[key] = self.archive_nominal_imports[key]
                else:
                    return false
        val table = SymbolTable.new()
        if not mono_archive_nominal_install_v2(table, module, rows): return false
        # Reserve the globally admitted high range, including pending specializations.
        if table.next_symbol_id > self.next_symbol: return false
        table.next_symbol_id = self.next_symbol
        self.module_symbols[module] = table
        true

    me relocate_mono_types(types: [HirType], source_module: text, target_module: text, site: text) -> [HirType]?:
        # Scalars contain no module-local ids and need no table or allocation.
        if not any_nominal(types):
            return Some(types)
        self.ensure_archive_nominal_table_v2(source_module)
        self.ensure_archive_nominal_table_v2(target_module)
        if not self.module_symbols.has(source_module) or not self.module_symbols.has(target_module):
            self.diagnostics = self.diagnostics.push(
                "E-MONO-042: {site}: nominal type transport lacks source or target symbol table ({source_module} -> {target_module})")
            return nil
        var target: SymbolTable = self.module_symbols[target_module]
        # A compact table cannot reach specialization ids. A table already
        # using the high range must skip every specialization minted so far,
        # including symbols not registered until final module assembly.
        if target.next_symbol_id >= MONO_SYMBOL_BASE and target.next_symbol_id < self.next_symbol:
            target.next_symbol_id = self.next_symbol
        val result = hir_relocate_types(types, self.module_symbols[source_module], source_module, target, target_module)
        if not result.valid:
            self.diagnostics = self.diagnostics.push("E-MONO-042: {site}: {result.error}")
            return nil
        self.module_symbols[target_module] = result.symbols
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            val rows = mono_archive_nominal_project_v2(target_module, result.symbols)
            for key in rows.keys():
                if not self.archive_nominal_rows.has(key):
                    self.archive_nominal_imports[key] = rows[key]
                    if not self.archive_nominal_keys.has(target_module): self.archive_nominal_keys[target_module] = []
                    if not self.archive_nominal_keys[target_module].contains(key):
                        self.archive_nominal_keys[target_module] = self.archive_nominal_keys[target_module].push(key)
        if result.symbols.next_symbol_id > self.next_symbol:
            self.next_symbol = result.symbols.next_symbol_id
        Some(result.types)

    me specialization_signature_in_caller(spec_name: text, span: Span) -> HirType?:
        val specialized = self.specialization_signature_v1(spec_name)
        val signature = HirType(kind: HirTypeKind.Function(specialized.param_types, specialized.return_type, []), span: span)
        if val transported = self.relocate_mono_types([signature], self.spec_module[spec_name], self.current_module, "signature of `{spec_name}`"):
            val caller_signature: HirType = transported[0]
            match caller_signature.kind:
                case HirTypeKind.Function(_, ret, _):
                    self.fn_returns[mono_sym_key(self.current_module, self.spec_symbols[spec_name])] = ret
                    if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
                        self.archive_caller_returns[mono_sym_key(self.current_module, self.spec_symbols[spec_name])] = ret
                case _: ()
            return caller_signature
        nil

    me request_specialization(func_name: text, type_args: [HirType]) -> i64:
        """Specialize `func_name` at `type_args` (deduplicated) and return the
        SymbolId of the specialization, or -1 with a recorded diagnostic when
        the instantiation must be refused."""
        # Preserve the existing depth diagnostic before any new completion
        # refusal, including direct calls with symbolic nested type arguments.
        for ta in type_args:
            val tat: HirType = ta
            if hir_type_depth(tat) > MONO_MAX_TYPE_DEPTH:
                self.diagnostics = self.diagnostics.push(
                    "E-MONO-030: instantiation of `{func_name}` exceeds depth {MONO_MAX_TYPE_DEPTH} (polymorphic recursion); not specialized")
                return -1
        # Existing low-level owner-key tests deliberately omit a template.
        # Keep owner identity refusal ahead of unsafe declaration lookup.
        if not self.has_template_v1(func_name):
            val unresolved_name = self.mangled_name(func_name, type_args)
            if unresolved_name == "": return -1
            self.diagnostics = self.diagnostics.push("E-MONO-032: generic template `{func_name}` is not registered")
            return -1
        val declaration = self.template_signature_v1(func_name)
        if type_args.len() > declaration.type_params.len():
            self.diagnostics = self.diagnostics.push("E-MONO-032: `{func_name}` has too many explicit type arguments")
            return -1
        var completed_args: [HirType] = type_args
        # Full direct requests retain their previous checks. Only a newly
        # omitted suffix enters default completion and its concrete gate.
        if type_args.len() < declaration.type_params.len():
            var supplied: Dict<text, HirType> = {}
            var argument_index = 0
            for actual in type_args:
                val tp: HirTypeParam = declaration.type_params[argument_index]
                supplied[tp.name] = actual
                argument_index = argument_index + 1
            val completion = self.complete_template_type_args_v1(declaration, supplied)
            if completion.is_err():
                val reason: text = completion.unwrap_err()
                self.diagnostics = self.diagnostics.push("E-MONO-032: `{func_name}`: {reason}")
                return -1
            completed_args = completion.unwrap()
        if completed_args.len() != type_args.len():
            for ta in completed_args:
                val tat: HirType = ta
                if hir_type_depth(tat) > MONO_MAX_TYPE_DEPTH:
                    self.diagnostics = self.diagnostics.push(
                        "E-MONO-030: instantiation of `{func_name}` exceeds depth {MONO_MAX_TYPE_DEPTH} (polymorphic recursion); not specialized")
                    return -1
        val mangled = self.mangled_name(func_name, completed_args)
        if mangled == "":
            return -1
        if self.spec_symbols.has(mangled):
            return self.spec_symbols[mangled]
        val spec_mod: text = self.template_module[func_name]
        var local_type_args: [HirType] = []
        if val transported = self.relocate_mono_types(completed_args, self.current_module, spec_mod, "arguments of `{func_name}`"):
            local_type_args = transported
        else:
            # A failed transport must not reserve a display alias that a
            # different key may legitimately take before a later retry.
            self.spec_display.remove("{func_name}${self.type_keys(completed_args)}")
            return -1
        val sym = self.next_symbol
        self.next_symbol = self.next_symbol + 1
        self.spec_symbols[mangled] = sym
        var signature = self.template_signature_v1(func_name)
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            # The archive consumer fulfills this request with
            # `specialize_function_with_types(canonical, item.type_args)` in
            # the TEMPLATE module's scope, so the archived arguments must be
            # the ones transported into that scope, not the caller-scoped
            # `type_args` (nominal identity is module-scoped).
            signature = mono_specialized_signature_v1(self.template_signature_v1(func_name), local_type_args, mangled)
            self.archive_specialized_signatures[mangled] = signature
            self.archive_requests = self.archive_requests.push(MonoSpecializationRequestV1(
                template_name: func_name, module_name: spec_mod,
                mangled_name: mangled, symbol_id: sym, type_args: local_type_args,
                caller_module: self.current_module, caller_type_args: completed_args))
        else:
            # Deduplication and nominal argument transport have already
            # admitted this request. Canonicalize the original executable
            # body only here, then immediately substitute concrete types.
            var template: HirFunction = self.generic_functions[func_name]
            if self.template_recipes.has(func_name):
                template = mono_apply_template_recipe_v1(template, self.template_recipes[func_name])
            var specialized: HirFunction = specialize_function_with_types(template, local_type_args)
            specialized.name = mangled
            specialized.symbol = SymbolId.new(sym)
            self.specialized_functions[mangled] = specialized
            signature = mono_template_signature_v1(specialized)
        # A specialization is a concrete callee from here on: its return
        # type feeds the inference of an ENCLOSING generic call (`wrap(wrap(v))`).
        self.fn_returns[mono_sym_key(spec_mod, sym)] = signature.return_type
        self.sym_names[mono_sym_key(spec_mod, sym)] = signature.name
        self.spec_template[mangled] = func_name
        self.spec_module[mangled] = spec_mod
        self.spec_queue = self.spec_queue.push(mangled)
        self.stats.specializations_created = self.stats.specializations_created + 1
        # spec_queue is the sole worklist. Mirroring this request into the
        # legacy engine retained another template body until pass teardown,
        # although that engine's pending queue is never drained or consumed.
        sym

    me has_template_v1(name: text) -> bool:
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            return self.archive_template_signatures.has(name)
        self.generic_functions.has(name)

    me template_signature_v1(name: text) -> MonoTemplateSignatureV1:
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            return self.archive_template_signatures[name]
        if self.archive_template_signatures.has(name):
            return self.archive_template_signatures[name]
        # Explicit callers may seed an already-canonical retained template
        # directly without discovery/recipe registration (legacy API).
        mono_template_signature_v1(self.generic_functions[name])

    me specialization_signature_v1(name: text) -> MonoTemplateSignatureV1:
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            return self.archive_specialized_signatures[name]
        mono_template_signature_v1(self.specialized_functions[name])

    me specialization_callee_name_v1(template_name: text, spec_name: text) -> text:
        # Original caller spelling may be bare or an import alias. Linkage is
        # owned by the actual template declaration, shared by both body modes.
        val signature = self.template_signature_v1(template_name)
        val owner: text = self.template_module[template_name]
        if signature.global_linkage or owner == self.current_module:
            return spec_name
        "{owner}.{spec_name}"

    me symbol_identity_v1(module_name: text, symbol: SymbolId) -> text:
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            val key = mono_sym_key(module_name, symbol.id)
            if self.archive_symbol_identities.has(key): return self.archive_symbol_identities[key]
            return ""
        if not self.module_symbols.has(module_name): return ""
        mono_type_identity(self.module_symbols[module_name], symbol, module_name)

    me record_named_type(module_name: text, sym: SymbolId, name: text, concrete: bool):
        self.named_symbol_names[mono_sym_key(module_name, sym.id)] = name
        if not concrete:
            return
        if self.named_types.has(name) or self.named_ambiguous.has(name):
            # Once a display name collides there is no canonical winner. The
            # declaration dictionaries can have a different traversal order
            # after HIR codec round-trip, so retaining the first SymbolId made
            # archive registration receipts depend on that incidental order.
            # Rebuild without the key because Dict.remove has incompatible
            # return semantics on interpreted and native compiler lanes.
            var unambiguous: Dict<text, HirType> = {}
            for key in self.named_types.keys():
                if key != name: unambiguous[key] = self.named_types[key]
            self.named_types = unambiguous
            self.named_ambiguous[name] = true
            return
        self.named_types[name] = HirType(kind: HirTypeKind.Named(sym, []), span: Span.empty())

    me record_generic_type(module: HirModule, module_name: text, sym: SymbolId, type_params: [HirTypeParam], fields: [HirField]):
        """Record a generic struct/class under its ownership identity. A second
        declaration under the same identity makes it unusable (fail closed)."""
        val identity = mono_type_identity(module.symbols, sym, module_name)
        if identity == "":
            return
        if self.generic_type_params.has(identity):
            self.generic_type_params[identity] = []
            return
        val canonical = typesubstitution_canonical(type_params)
        var names: [text] = []
        for f in fields:
            val ft: HirField = f
            names = names.push(ft.name)
            self.generic_type_fields["{identity}::{ft.name}"] = substitute_type(ft.type_, canonical)
        self.generic_type_params[identity] = type_params
        self.generic_type_modules[identity] = module_name
        self.generic_type_field_names[identity] = names

    me generic_type_identity(module_name: text, sym: SymbolId) -> text:
        """Identity of a recorded generic struct/class named by `sym` in
        `module_name`'s table, else ""."""
        val identity = self.symbol_identity_v1(module_name, sym)
        if identity == "" or not self.generic_type_params.has(identity):
            return ""
        val tps: [HirTypeParam] = self.generic_type_params[identity]
        if tps.len() == 0:
            return ""
        identity

    me generic_field_type(owner_module: text, sym: SymbolId, args: [HirType], field: text) -> (HirType?, text):
        """Type of `field` on the instance `Name<args>`: the declared field
        type under [params := args]. The answer's Named ids belong to the
        module returned with it: a bare parameter field is the caller's
        argument, a parameter-free field is the declaring module's type. A
        field that mixes the caller's arguments with a declared type of
        another module has no single owner -> nil."""
        val identity = self.generic_type_identity(owner_module, sym)
        if identity == "":
            return (nil, owner_module)
        val key = "{identity}::{field}"
        if not self.generic_type_fields.has(key):
            return (nil, owner_module)
        val tps: [HirTypeParam] = self.generic_type_params[identity]
        if tps.len() != args.len() or not all_concrete(args):
            return (nil, owner_module)
        val declared: HirType = self.generic_type_fields[key]
        val decl_mod: text = self.generic_type_modules[identity]
        if hir_type_is_concrete(declared):
            return (declared, decl_mod)
        var bare_param = false
        match declared.kind:
            case HirTypeKind.TypeParam(_, _):
                bare_param = true
            case _: ()
        if not bare_param and decl_mod != owner_module and hir_type_has_nominal(declared):
            return (nil, owner_module)
        val out = substitute_type(declared, typesubstitution_from_params(tps, args))
        if not hir_type_is_concrete(out):
            return (nil, owner_module)
        (out, owner_module)

    me report_leveled(code: text, message: text) -> bool:
        """Record `message` at the level `code` resolves to. True when it was
        recorded as an ERROR (the call site counts as unresolved)."""
        val level = mono_diag_level(code)
        if level == "off":
            return false
        if level == "warning":
            self.warnings = self.warnings.push(message)
            return false
        self.diagnostics = self.diagnostics.push(message)
        true

    me note_unknown_instance_field_read(base: HirExpr, field: text):
        """E-MONO-040, once per generic type field and module: a container
        field over a type parameter (`items: [T]`, `first: T?`) is read from a
        receiver whose instance type is unknown, so the element / payload
        reaches 50.mir untyped and an operator or interpolation on it works
        on the raw word (right for an integer, WRONG for text or a struct).
        The usual cause: the arguments of a same-module generic annotation
        (`b: Bag<text>`) are dropped before HIR."""
        val (bt, bmod) = self.infer_field_chain(base)
        if bt == nil:
            return
        val btt: HirType = bt
        match btt.kind:
            case HirTypeKind.Named(sym, args):
                if args.len() > 0:
                    return
                val identity = self.generic_type_identity(bmod, sym)
                if identity == "":
                    return
                val key = "{identity}::{field}"
                if not self.generic_type_fields.has(key):
                    return
                val declared: HirType = self.generic_type_fields[key]
                if hir_type_is_concrete(declared):
                    return
                match declared.kind:
                    case HirTypeKind.TypeParam(_, _):
                        # A bare parameter field: 50.mir refuses an operator
                        # on it by itself ("operator overload for struct T").
                        return
                    case _: ()
                val once = "E-MONO-040|{self.current_module}|{key}"
                if self.reported_once.has(once):
                    return
                self.reported_once[once] = true
                self.report_leveled("E-MONO-040",
                    "E-MONO-040: field `{field}` of generic `{identity}` is read in `{self.current_module}` from a receiver whose type arguments are unknown; its elements are untyped there, so an operator or interpolation on one uses the raw word (wrong unless the element is an integer). Give the receiver a known instance type (construct it in the function, or import the type by name so `Name<args>` annotations keep their arguments)")
            case _: ()

    me generic_instance_field_read_type(base: HirExpr, field: text) -> HirType?:
        """Type of `base.field` when `base` is a known instance of a generic
        struct/class (`Name<args>`) and the answer belongs to the module
        being rewritten; nil for every other field read."""
        val (bt, bmod) = self.infer_field_chain(base)
        if bt == nil:
            return nil
        val btt: HirType = bt
        match btt.kind:
            case HirTypeKind.Named(sym, args):
                if args.len() == 0:
                    return nil
                val (ft, fmod) = self.generic_field_type(bmod, sym, args, field)
                if ft == nil:
                    return nil
                val ftt: HirType = ft
                if fmod != self.current_module and hir_type_has_nominal(ftt):
                    return nil
                ft
            case _:
                nil

    me stamp_instance_field_use(expr: HirExpr, operand: HirExpr) -> HirExpr:
        """`b.items[0]`, `b.first ?? d`, `b.first!`: an element/payload taken
        straight out of a generic instance's field. HIR typed it from the
        declaration (`T`) or not at all; give it the instance's type, which
        50.mir takes as the result type. Any other operand: unchanged."""
        match operand.kind:
            case HirExprKind.Field(fbase, field, _):
                if self.generic_instance_field_read_type(fbase, field) == nil:
                    return expr
                val t = self.infer_expr_type(expr)
                if t == nil:
                    return expr
                var out = expr
                out.has_type_ = true
                out.type_ = t
                out
            case _:
                expr

    me generic_constructor_type(callee: HirExpr, args: [HirCallArg], type_args: [HirType]) -> HirType?:
        """`Box(item: "x")` -> `Box<text>`: the instance a generic struct/class
        constructor builds, its parameters bound by matching each DECLARED
        field type against the argument stored into it (named, else
        positional). Written type arguments must agree with that evidence.
        Every parameter must end up bound to a concrete type; else nil."""
        match callee.kind:
            case HirExprKind.NamedVar(sym_id, _):
                val identity = self.generic_type_identity(self.current_module, sym_id)
                if identity == "":
                    return nil
                val tps: [HirTypeParam] = self.generic_type_params[identity]
                val names: [text] = self.generic_type_field_names[identity]
                var bindings: Dict<text, HirType> = {}
                if type_args != nil and type_args.len() > 0:
                    if type_args.len() > tps.len() or not all_concrete(type_args):
                        return nil
                    var ti = 0
                    while ti < type_args.len():
                        val etp: HirTypeParam = tps[ti]
                        bindings[etp.name] = type_args[ti]
                        ti = ti + 1
                var i = 0
                for a in args:
                    val arg: HirCallArg = a
                    var fname = ""
                    if arg.has_name:
                        fname = arg.name
                    elif i < names.len():
                        fname = names[i]
                    val key = "{identity}::{fname}"
                    if not self.generic_type_fields.has(key):
                        return nil
                    val declared: HirType = self.generic_type_fields[key]
                    val at = self.infer_expr_type(mono_arg_value(arg))
                    if at != nil:
                        val att: HirType = at
                        if not self.call_evidence_is_valid_v1(mono_arg_value(arg), att):
                            self.diagnostics = self.diagnostics.push("E-MONO-032: constructor `{identity}` has invalid or erased argument type evidence; constructor type not resolved")
                            return nil
                        # `first: T?` initialised with a bare payload
                        # (`first: "a"`): the value is wrapped, so the
                        # evidence is for the payload type.
                        var pattern = declared
                        match declared.kind:
                            case HirTypeKind.Optional(payload):
                                match att.kind:
                                    case HirTypeKind.Optional(_): ()
                                    case _:
                                        pattern = payload
                            case _: ()
                        val field_module: text = self.generic_type_modules[identity]
                        val context = self.nominal_binding_context(field_module)
                        if context == nil and (hir_type_has_nominal(pattern) or hir_type_has_nominal(att)):
                            return nil
                        if not bind_type_params(pattern, att, bindings, context):
                            return nil
                    elif not hir_type_is_concrete(declared) and not mono_call_evidence_is_absent_v1(mono_arg_value(arg)):
                        return nil
                    i = i + 1
                val owner: text = self.generic_type_modules[identity]
                val completed = self.complete_declared_type_args_v1(tps, tps, owner, bindings)
                if completed.is_err():
                    val reason: text = completed.unwrap_err()
                    self.diagnostics = self.diagnostics.push("E-MONO-032: constructor `{identity}`: {reason}; constructor type not resolved")
                    return nil
                HirType(kind: HirTypeKind.Named(sym_id, completed.unwrap()), span: callee.span)
            case _:
                not_a_constructor_call()

    me record_field_types(module_name: text, type_name: text, fields: [HirField]):
        for f in fields:
            val ft: HirField = f
            val key = "{type_name}::{ft.name}"
            self.field_types[key] = ft.type_
            self.field_owner_modules[key] = module_name

    me field_type_in(owner_module: text, base_ty: HirType, field: text) -> (HirType?, text):
        """Declared type of `field` on a non-generic struct/class `base_ty`,
        plus the module that declared that field. `base_ty`'s SymbolId is
        resolved in `owner_module` (the module whose table minted it), never
        blindly in the module being rewritten: on a chain `a.b.c` the type
        of `a.b` carries the DECLARING module's id, which can collide with an
        unrelated id in the caller. A type name declared by two modules is
        ambiguous -> nil."""
        match base_ty.kind:
            case HirTypeKind.Named(sym, args):
                if args.len() > 0:
                    return self.generic_field_type(owner_module, sym, args, field)
                val n: text = self.named_type_name_in(owner_module, sym, base_ty)
                if self.named_ambiguous.has(n):
                    return (nil, owner_module)
                val key = "{n}::{field}"
                if self.field_types.has(key):
                    val t: HirType = self.field_types[key]
                    if hir_type_is_concrete(t):
                        val decl_mod: text = self.field_owner_modules[key] ?? owner_module
                        return (t, decl_mod)
                (nil, owner_module)
            case _:
                (nil, owner_module)

    me infer_field_chain(expr: HirExpr) -> (HirType?, text):
        """Type of an expression together with the module whose symbol table
        its Named ids belong to. Field hops switch to the declaring module."""
        match expr.kind:
            case HirExprKind.Field(base, field, _):
                val fb: HirExpr = base
                val (bt, bmod) = self.infer_field_chain(fb)
                if bt == nil:
                    return (nil, bmod)
                val btt: HirType = bt
                self.field_type_in(bmod, btt, field)
            case _:
                (self.infer_expr_type(expr), self.current_module)

    me fn_sig_of(sym_id: SymbolId) -> HirType?:
        val s: SymbolId = sym_id
        val k = mono_sym_key(self.current_module, s.id)
        if self.fn_sigs.has(k):
            val t: HirType = self.fn_sigs[k]
            if hir_type_is_concrete(t):
                return t
        nil

    me constructor_type(callee: HirExpr) -> HirType?:
        """Type of a struct/class constructor call `Name(...)`, which HIR
        lowers as a plain Call whose callee is NamedVar("Name")."""
        match callee.kind:
            case HirExprKind.NamedVar(sym_id, name):
                if self.fn_return_of(sym_id) != nil:
                    return nil
                self.ensure_archive_nominal_table_v2(self.current_module)
                if not self.module_symbols.has(self.current_module):
                    return nil
                if self.generic_type_identity(self.current_module, sym_id) != "":
                    return nil
                val symbols: SymbolTable = self.module_symbols[self.current_module]
                if val info = symbols.get_symbol_raw(sym_id.id):
                    match info.kind:
                        case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum:
                            return HirType(kind: HirTypeKind.Named(sym_id, []), span: callee.span)
                        case _: ()
                nil
            case _:
                not_a_constructor_call()

    me named_type_name(sym: SymbolId, t: HirType) -> text:
        self.named_type_name_in(self.current_module, sym, t)

    me named_type_name_in(module_name: text, sym: SymbolId, t: HirType) -> text:
        """Declared name of a Named type: by `module_name`'s symbol first; a
        type inferred from a constructor of an IMPORTED struct carries the
        declaring module's id, so fall back to the unique name any module
        declares under that id. Ambiguous -> engine `T<id>`."""
        val k = mono_sym_key(module_name, sym.id)
        if self.named_symbol_names.has(k):
            return self.named_symbol_names[k]
        val suffix = "#{sym.id}"
        var found = ""
        var distinct = 0
        for key in self.named_symbol_names.keys():
            val kt: text = key
            if not kt.ends_with(suffix):
                continue
            val n: text = self.named_symbol_names[kt]
            if n != found:
                distinct = distinct + 1
                found = n
        if distinct == 1:
            return found
        mangle_type(t)

    me mangle_type_args(type_args: [HirType]) -> text:
        """Engine mangling, except a `Named` leaf is spelled by its declared
        name (resolved in the CALLER's module) instead of `T<symbol id>`."""
        var parts: [text] = []
        for ta in type_args:
            val t: HirType = ta
            parts = parts.push(self.mangle_one(t))
        parts.join("_")

    me mangle_one(t: HirType) -> text:
        match t.kind:
            case Named(sym, args):
                val base = self.named_type_name(sym, t)
                if args.len() > 0:
                    return "{base}_{self.mangle_type_args(args)}"
                base
            case Array(elem, _):
                "arr_{self.mangle_one(elem)}"
            case Optional(inner):
                "opt_{self.mangle_one(inner)}"
            case Function(params, ret, _):
                "fn_{self.mangle_type_args(params)}_{self.mangle_one(ret)}"
            case _:
                mangle_type(t)

    me callee_local_plain(sym_id: SymbolId) -> bool:
        """True when the callee symbol is a NON-GENERIC function declared in
        the module currently being rewritten. The call bound to that local
        function, so a same-short-named generic template from another module
        must not claim the site (see plain_fn_symbols)."""
        val s: SymbolId = sym_id
        self.plain_fn_symbols.has(mono_sym_key(self.current_module, s.id))

    me callee_generic_name(callee: HirExpr) -> text:
        """Template name a call site's callee refers to, or "" when the callee
        is not a generic function known to this pass."""
        if callee == nil:
            return ""
        match callee.kind:
            case HirExprKind.Var(sym_id):
                val name = self.sym_name(sym_id)
                if self.has_template_v1(name):
                    if self.callee_local_plain(sym_id):
                        return ""
                    return name
                ""
            case HirExprKind.NamedVar(sym_id, name):
                val by_sym = self.sym_name(sym_id)
                if self.has_template_v1(by_sym):
                    if self.callee_local_plain(sym_id):
                        return ""
                    return by_sym
                val n: text = name
                if self.has_template_v1(n):
                    if self.callee_local_plain(sym_id):
                        return ""
                    return n
                # A cross-module import arrives as the qualified
                # `<module>.<fn>` display name baked in by HIR lowering
                # (expression_core.spl, `qualify_imported_function_symbol`).
                # Resolve the last segment, but only when the qualifier and
                # the template's module agree, so two modules with a
                # same-named generic never alias.
                val last = mono_last_segment(n)
                if last != n and self.has_template_v1(last):
                    val qual = n.substring(0, n.len() - last.len() - 1)
                    if mono_module_matches(qual, self.template_module[last]):
                        return last
                ""
            case _:
                ""

    me sym_name(sym_id: SymbolId) -> text:
        """Declared name of a symbol, from the map built in `collect_generics`.

        Falls back to the `sym_<id>` placeholder for a symbol this pass never
        saw declared; that never matches a generic-function key, so an
        unresolved callee is simply not specialized rather than mis-specialized.
        """
        val s: SymbolId = sym_id
        val k = mono_sym_key(self.current_module, s.id)
        if self.sym_names.has(k):
            return self.sym_names[k]
        "sym_{s.id}"

    fn call_site_location(sp: Span) -> text:
        """`path:line:col` of a call site in the module being rewritten; the
        span's own file wins when lowering recorded one."""
        var file: text = self.current_module
        if self.module_paths.has(self.current_module):
            val p: text = self.module_paths[self.current_module] ?? ""
            if p != "":
                file = p
        val sp_file: text = sp.file ?? ""
        if sp_file != "":
            file = sp_file
        "{file}:{sp.line}:{sp.col}"

    me nominal_binding_context(pattern_module: text) -> NominalBindingContext?:
        self.ensure_archive_nominal_table_v2(pattern_module)
        self.ensure_archive_nominal_table_v2(self.current_module)
        if not self.module_symbols.has(pattern_module) or not self.module_symbols.has(self.current_module):
            return nil
        NominalBindingContext(
            pattern_symbols: self.module_symbols[pattern_module],
            argument_symbols: self.module_symbols[self.current_module],
            pattern_module: pattern_module,
            argument_module: self.current_module)

    me infer_call_type_args(template: HirFunction, args: [HirCallArg], expected_result: HirType? = nil) -> [HirType]:
        self.infer_call_type_args_signature_v1(mono_template_signature_v1(template), args, expected_result)

    me infer_call_type_args_signature_v1(template: MonoTemplateSignatureV1, args: [HirCallArg], expected_result: HirType? = nil) -> [HirType]:
        val completed = self.resolve_call_type_args_signature_v1(template, args, [], expected_result)
        if completed.is_err(): return []
        completed.unwrap()

    me infer_call_bindings_signature_v1(template: MonoTemplateSignatureV1, args: [HirCallArg], explicit_prefix: [HirType], expected_result: HirType? = nil) -> Result<Dict<text, HirType>, text>:
        var bindings: Dict<text, HirType> = {}
        val tps: [HirTypeParam] = template.type_params
        if explicit_prefix.len() > tps.len():
            return Err("too many explicit type arguments")
        var ti = 0
        for written in explicit_prefix:
            val parameter: HirTypeParam = tps[ti]
            if not hir_type_is_concrete(written):
                return Err("explicit type argument for `{parameter.name}` is not concrete")
            bindings[parameter.name] = written
            ti = ti + 1
        var i = 0
        val params: [HirType] = template.param_types
        val owner_module: text = self.template_module[template.name] ?? self.current_module
        val nominal_context = self.nominal_binding_context(owner_module)
        while i < params.len() and i < args.len():
            val pt: HirType = params[i]
            val at: HirCallArg = args[i]
            if at.has_name:
                return Err("named call arguments are not supported by generic inference")
            val arg_ty = self.infer_expr_type(mono_arg_value(at))
            if mono_diag_enabled():
                if arg_ty == nil:
                    eprint("[mono-diag] infer `{template.name}` arg {i}: no local type for {mono_arg_value(at).kind}")
            if arg_ty != nil:
                if not self.call_evidence_is_valid_v1(mono_arg_value(at), arg_ty):
                    return Err("argument inference has invalid or erased type evidence")
                if nominal_context == nil and (hir_type_has_nominal(pt) or hir_type_has_nominal(arg_ty)):
                    return Err("generic inference lacks declaration/caller nominal context")
                if not bind_type_params(pt, arg_ty, bindings, nominal_context):
                    return Err("argument inference conflicts with another argument or explicit prefix")
            elif not hir_type_is_concrete(pt) and not mono_call_evidence_is_absent_v1(mono_arg_value(at)):
                return Err("argument inference has no concrete local type")
            i = i + 1
        if expected_result != nil:
            val expected: HirType = expected_result
            if hir_type_is_concrete(expected):
                if nominal_context == nil and (hir_type_has_nominal(template.return_type) or hir_type_has_nominal(expected)):
                    return Err("result inference lacks declaration/caller nominal context")
                if not bind_type_params(template.return_type, expected, bindings, nominal_context):
                    return Err("result inference conflicts with argument bindings")
        Ok(bindings)

    me complete_declared_type_args_v1(tps: [HirTypeParam], canonical_tps: [HirTypeParam], owner_module: text, bindings: Dict<text, HirType>) -> Result<[HirType], text>:
        # Binding values arrive in caller scope. Existing complete calls keep
        # their original values and existing prior type-checker bounds policy.
        var present_names: [text] = []
        var present: [HirType] = []
        var missing = false
        for raw in tps:
            val tp: HirTypeParam = raw
            if bindings.has(tp.name):
                val actual: HirType = bindings[tp.name]
                present_names = present_names.push(tp.name)
                present = present.push(actual)
            else:
                missing = true
        if not missing: return Ok(present)
        # New omissions require concrete supplied evidence; this must not
        # change the existing full direct-request validation boundary.
        if not all_concrete(present):
            return Err("supplied evidence for generic defaults is not concrete")
        # Refuse malformed/default-obligation failures before transport can
        # install any nominal rows. This check only tests shape/substitution;
        # actual nominal identity is resolved in declaration scope below.
        val preflight = mono_complete_default_args_v1(tps, canonical_tps, bindings)
        if preflight.is_err(): return Err(preflight.unwrap_err())
        var local: [HirType] = []
        if val transported = self.relocate_mono_types(present, self.current_module, owner_module, "bindings for generic defaults"):
            local = transported
        else:
            return Err("generic default bindings could not enter declaration scope")
        var local_bindings: Dict<text, HirType> = {}
        var index = 0
        for name in present_names:
            local_bindings[name] = local[index]
            index = index + 1
        val completed = mono_complete_default_args_v1(tps, canonical_tps, local_bindings)
        if completed.is_err(): return Err(completed.unwrap_err())
        if val caller_args = self.relocate_mono_types(completed.unwrap(), owner_module, self.current_module, "completed generic defaults"):
            return Ok(caller_args)
        Err("completed generic defaults could not enter caller scope")

    me complete_template_type_args_v1(template: MonoTemplateSignatureV1, bindings: Dict<text, HirType>) -> Result<[HirType], text>:
        var canonical_tps: [HirTypeParam] = template.type_params
        if self.template_recipes.has(template.name):
            canonical_tps = self.template_recipes[template.name].canonical_type_params
        val owner: text = self.template_module[template.name] ?? self.current_module
        self.complete_declared_type_args_v1(template.type_params, canonical_tps, owner, bindings)

    me resolve_call_type_args_signature_v1(template: MonoTemplateSignatureV1, args: [HirCallArg], type_args: [HirType], expected_result: HirType? = nil) -> Result<[HirType], text>:
        var written: [HirType] = []
        if type_args != nil: written = type_args
        # Full explicit calls previously bypassed inference. Preserve that
        # behavior; earlier type checking remains their validation authority.
        if written.len() == template.type_params.len() and written.len() > 0:
            return Ok(written)
        val inferred = self.infer_call_bindings_signature_v1(template, args, written, expected_result)
        if inferred.is_err(): return Err(inferred.unwrap_err())
        self.complete_template_type_args_v1(template, inferred.unwrap())

    me call_evidence_is_valid_v1(expr: HirExpr, actual: HirType) -> bool:
        if hir_type_is_concrete(actual): return true
        # Only an actual Ok/Err value has a genuinely absent Result arm.
        # Raw cast targets and untrusted type stamps cannot create this hole.
        match expr.kind:
            case HirExprKind.EnumLit(_, variant, payload):
                var active: HirType = nil
                var absent: HirType = nil
                match actual.kind:
                    case HirTypeKind.Result(ok, err):
                        if variant == "Ok":
                            active = ok
                            absent = err
                        elif variant == "Err":
                            active = err
                            absent = ok
                        else: return false
                    case _: return false
                if not hir_type_is_concrete(active): return false
                if absent == nil: return false
                match absent.kind:
                    case HirTypeKind.Infer(_, _): ()
                    case _: return false
                match payload:
                    case HirEnumPayload.Tuple(values):
                        if values.len() != 1: return false
                        val value: HirExpr = values[0]
                        val inferred = self.infer_expr_type(value)
                        if inferred == nil or not hir_type_is_concrete(inferred): return false
                        self.same_type_key(active, inferred)
                    case _: false
            case _: false

    me infer_expr_type(expr: HirExpr) -> HirType?:
        """Local, conservative type of an expression: literals, symbols bound
        in `env`, calls to non-generic functions, casts, constructors and
        collections of inferable elements. Anything else is nil."""
        if expr == nil:
            return nil
        if expr.has_type_:
            val own: HirType = expr.type_
            if hir_type_is_concrete(own):
                return own
        val sp = expr.span
        match expr.kind:
            case HirExprKind.IntLit(_, suffix):
                int_literal_type(suffix, sp)
            case HirExprKind.FloatLit(_, suffix):
                float_literal_type(suffix, sp)
            case HirExprKind.FloatLexeme(_, suffix):
                float_literal_type(suffix, sp)
            case HirExprKind.StringLit(_, _):
                HirType(kind: HirTypeKind.Str, span: sp)
            case HirExprKind.BoolLit(_):
                HirType(kind: HirTypeKind.Bool, span: sp)
            case HirExprKind.CharLit(_):
                HirType(kind: HirTypeKind.Char, span: sp)
            case HirExprKind.UnitLit:
                HirType(kind: HirTypeKind.Unit, span: sp)
            case HirExprKind.Var(sym_id):
                val vt = self.env_type(sym_id)
                if vt != nil:
                    return vt
                val declared = self.declared_global_type(sym_id)
                if declared != nil: return declared
                self.fn_sig_of(sym_id)
            case HirExprKind.NamedVar(sym_id, _):
                val nt = self.env_type(sym_id)
                if nt != nil:
                    return nt
                val declared = self.declared_global_type(sym_id)
                if declared != nil: return declared
                self.fn_sig_of(sym_id)
            case HirExprKind.Field(_, _, _):
                val (ft, _fmod) = self.infer_field_chain(expr)
                ft
            case HirExprKind.ExistsCheck(exists_base):
                # `opt.?` (also what `if val b = opt:` binds): still the
                # optional itself, present-or-nil.
                val eb: HirExpr = exists_base
                val ebt = self.infer_expr_type(eb)
                if ebt == nil:
                    return nil
                val ebtt: HirType = ebt
                match ebtt.kind:
                    case HirTypeKind.Optional(_): ebtt
                    case _: nil
            case HirExprKind.Cast(_, target):
                val ct: HirType = target
                ct
            case HirExprKind.As(_, target):
                val at: HirType = target
                at
            case HirExprKind.ConvertCall(_, target):
                val cvt: HirType = target
                cvt
            case HirExprKind.StructLit(ty, _):
                val st: HirType = ty
                st
            case HirExprKind.EnumLit(ty, _, _):
                val et: HirType = ty
                et
            case HirExprKind.ArrayLit(elements, elem_ty):
                # An EMPTY literal carries no element evidence. HIR lowering
                # fills its `elem_ty` with the configured placeholder default
                # (`get_empty_array_default`, i32 unless configured), which is
                # concrete and so used to bind `C := i32` here and then reject
                # the call's real witness (`first_or([], 9)`: `fallback: C` is
                # i64 -> conflict -> E-MONO-032). Treat it as no evidence: a
                # later concrete argument may still bind the parameter, and a
                # call whose only witness is `[]` still fails closed.
                if elements.len() == 0:
                    return nil
                match elem_ty:
                    Some(t):
                        val tt: HirType = t
                        HirType(kind: HirTypeKind.Array(tt, nil), span: sp)
                    nil:
                        val first: HirExpr = elements[0]
                        val ft = self.infer_expr_type(first)
                        if ft == nil:
                            return nil
                        val ftt: HirType = ft
                        HirType(kind: HirTypeKind.Array(ftt, nil), span: sp)
            case HirExprKind.TupleLit(elements):
                var parts: [HirType] = []
                for e in elements:
                    val et2: HirExpr = e
                    val pt = self.infer_expr_type(et2)
                    if pt == nil:
                        return nil
                    val ptt: HirType = pt
                    parts = parts.push(ptt)
                HirType(kind: HirTypeKind.Tuple(parts), span: sp)
            case HirExprKind.Call(callee, call_args, type_args):
                val ce: HirExpr = callee
                # A generic callee returns its declared return type under the
                # instantiation this very call resolves to (`val a = keep("x")`
                # makes `a` a `text`); an unresolved one answers nothing.
                val gname = self.callee_generic_name(ce)
                if gname != "":
                    val template = self.template_signature_v1(gname)
                    return self.instantiated_return_type_signature_v1(template, self.call_type_args_signature_v1(template, call_args, type_args))
                val generic_ctor = self.generic_constructor_type(ce, call_args, type_args)
                if generic_ctor != nil:
                    return generic_ctor
                if type_args != nil:
                    if type_args.len() > 0:
                        return nil
                val ctor = self.constructor_type(ce)
                if ctor != nil:
                    return ctor
                self.callee_return_type(ce)
            case HirExprKind.MethodCall(receiver, method, _, _):
                # A method of a generic impl on a known instance returns its
                # declared type under the receiver's arguments. Every other
                # method (builtins, traits) stays unanswered.
                val mrecv: HirExpr = receiver
                val mname = self.generic_method_lookup(mrecv, method)
                if mname == "":
                    return nil
                val mtemplate = self.template_signature_v1(mname)
                val (mrt, _mmod) = self.receiver_instance_type(mrecv)
                if mrt == nil:
                    return nil
                val mrtt: HirType = mrt
                match mrtt.kind:
                    case HirTypeKind.Named(_, owner_args):
                        self.instantiated_return_type_signature_v1(mtemplate, owner_args)
                    case _: nil
            case HirExprKind.Block(block):
                val bt: HirBlock = block
                self.block_value_type(bt)
            case HirExprKind.If(_, then_, else_):
                # Both arms must yield the same type; one arm alone, or two
                # that disagree, is no evidence.
                val then_ty = self.block_value_type(then_)
                if then_ty == nil:
                    return nil
                match else_:
                    Some(eb):
                        val else_block: HirBlock = eb
                        val else_ty = self.block_value_type(else_block)
                        if else_ty == nil:
                            return nil
                        val tt2: HirType = then_ty
                        val et3: HirType = else_ty
                        if self.same_type_key(tt2, et3):
                            return tt2
                        nil
                    nil: nil
            case HirExprKind.IfChain(arms, chain_else):
                match chain_else:
                    Some(ceb):
                        val chain_else_block: HirBlock = ceb
                        val chain_ty = self.block_value_type(chain_else_block)
                        if chain_ty == nil:
                            return nil
                        val cty: HirType = chain_ty
                        for arm in arms:
                            val ia: HirIfArm = arm
                            val arm_ty = self.block_value_type(ia.then_)
                            if arm_ty == nil:
                                return nil
                            val aty: HirType = arm_ty
                            if not self.same_type_key(aty, cty):
                                return nil
                        cty
                    nil: nil
            case HirExprKind.Index(base, index):
                # `xs[i]` loads an element, `d[k]` a value. A range index is a
                # slice and a text index is not typed here.
                val ib: HirExpr = base
                val ii: HirExpr = index
                val base_ty = self.infer_expr_type(ib)
                val index_ty = self.infer_expr_type(ii)
                if base_ty == nil or index_ty == nil:
                    return nil
                val bty: HirType = base_ty
                val ity: HirType = index_ty
                var index_is_int = false
                match ity.kind:
                    case HirTypeKind.Int(_, _):
                        index_is_int = true
                    case _: ()
                match bty.kind:
                    case HirTypeKind.Array(elem, _):
                        val ae: HirType = elem
                        if index_is_int and hir_type_is_concrete(ae):
                            return ae
                        nil
                    case HirTypeKind.Slice(selem):
                        val se: HirType = selem
                        if index_is_int and hir_type_is_concrete(se):
                            return se
                        nil
                    case HirTypeKind.Dict(dk, dv):
                        val dkt: HirType = dk
                        val dvt: HirType = dv
                        if self.same_type_key(dkt, ity) and hir_type_is_concrete(dvt):
                            return dvt
                        nil
                    case _: nil
            case HirExprKind.TupleIndex(base, slot):
                val tb: HirExpr = base
                val tuple_ty = self.infer_expr_type(tb)
                if tuple_ty == nil:
                    return nil
                val tty: HirType = tuple_ty
                match tty.kind:
                    case HirTypeKind.Tuple(parts):
                        if slot < 0 or slot >= parts.len():
                            return nil
                        val part: HirType = parts[slot]
                        part
                    case _: nil
            case HirExprKind.Unwrap(base):
                val ub: HirExpr = base
                self.optional_payload_type(self.infer_expr_type(ub))
            case HirExprKind.NullCoalesce(left, right):
                # `o ?? d`: the payload when `d` is one, still optional when
                # `d` is itself the same optional. Anything else: no answer.
                val cl: HirExpr = left
                val cr: HirExpr = right
                val left_ty = self.infer_expr_type(cl)
                val right_ty = self.infer_expr_type(cr)
                if left_ty == nil or right_ty == nil:
                    return nil
                val lty: HirType = left_ty
                val rty: HirType = right_ty
                val payload = self.optional_payload_type(left_ty)
                if payload == nil:
                    return nil
                val pty: HirType = payload
                if self.same_type_key(pty, rty):
                    return pty
                if self.same_type_key(lty, rty):
                    return lty
                nil
            case HirExprKind.Binary(op, left, right):
                val bl: HirExpr = left
                val br: HirExpr = right
                val lt2 = self.infer_expr_type(bl)
                val rt2 = self.infer_expr_type(br)
                if lt2 == nil or rt2 == nil:
                    return nil
                val blt: HirType = lt2
                val brt: HirType = rt2
                binary_result_type(op, blt, brt, sp)
            case HirExprKind.Unary(op, operand):
                val uo: HirExpr = operand
                val operand_ty = self.infer_expr_type(uo)
                if operand_ty == nil:
                    return nil
                val oty: HirType = operand_ty
                unary_result_type(op, oty)
            case HirExprKind.DictLit(entries, _, _):
                # Typed by its entries, all of which must agree; the recorded
                # key/value types can be lowering defaults (cf. ArrayLit).
                if entries.len() == 0:
                    return nil
                var key_ty: HirType? = nil
                var value_ty: HirType? = nil
                for entry in entries:
                    val (ek, ev) = entry
                    val eke: HirExpr = ek
                    val eve: HirExpr = ev
                    val kt2 = self.infer_expr_type(eke)
                    val vt2 = self.infer_expr_type(eve)
                    if kt2 == nil or vt2 == nil:
                        return nil
                    val ktt: HirType = kt2
                    val vtt: HirType = vt2
                    if key_ty == nil:
                        key_ty = kt2
                        value_ty = vt2
                    else:
                        val pk: HirType = key_ty
                        val pv: HirType = value_ty
                        if not self.same_type_key(pk, ktt) or not self.same_type_key(pv, vtt):
                            return nil
                val fk: HirType = key_ty
                val fv: HirType = value_ty
                HirType(kind: HirTypeKind.Dict(fk, fv), span: sp)
            case _:
                no_local_type_answer()

    me block_value_type(block: HirBlock) -> HirType?:
        if block == nil:
            return nil
        if not block.has:
            return nil
        val bv: HirExpr = block.value
        self.infer_expr_type(bv)

    me optional_payload_type(ty: HirType?) -> HirType?:
        if ty == nil:
            return nil
        val t: HirType = ty
        match t.kind:
            case HirTypeKind.Optional(inner):
                val payload: HirType = inner
                if hir_type_is_concrete(payload):
                    return payload
                nil
            case _: nil

    me call_type_args(template: HirFunction, args: [HirCallArg], type_args: [HirType]) -> [HirType]:
        self.call_type_args_signature_v1(mono_template_signature_v1(template), args, type_args)

    me call_type_args_signature_v1(template: MonoTemplateSignatureV1, args: [HirCallArg], type_args: [HirType]) -> [HirType]:
        val completed = self.resolve_call_type_args_signature_v1(template, args, type_args)
        if completed.is_err(): return []
        completed.unwrap()

    me instantiated_return_type(template: HirFunction, targs: [HirType]) -> HirType?:
        self.instantiated_return_type_signature_v1(mono_template_signature_v1(template), targs)

    me instantiated_return_type_signature_v1(template: MonoTemplateSignatureV1, targs: [HirType]) -> HirType?:
        """`template`'s declared return type under [type_params := targs],
        when that instantiation is complete and concrete."""
        val tps: [HirTypeParam] = template.type_params
        if targs.len() == 0 or targs.len() != tps.len() or not all_concrete(targs):
            return nil
        # A nominal type the TEMPLATE spells carries its declaring module's
        # SymbolId, which means something else in the caller's table; only the
        # caller's own type arguments may name one across modules.
        if self.template_module.has(template.name):
            val owner: text = self.template_module[template.name]
            if owner != self.current_module and hir_type_has_nominal(template.return_type):
                return nil
        val out = substitute_type(template.return_type, typesubstitution_from_params(tps, targs))
        if hir_type_is_concrete(out):
            return out
        nil

    me generic_method_lookup(receiver: HirExpr, method: text) -> text:
        """Side-effect-free twin of `generic_method_template`: the template
        key when `receiver` is a known instance whose generic impl declares
        `method` in the specializable shape, else ""."""
        val (rt, rmod) = self.receiver_instance_type(receiver)
        if rt == nil:
            return ""
        val rtt: HirType = rt
        match rtt.kind:
            case HirTypeKind.Named(owner_sym, owner_args):
                if owner_args.len() == 0:
                    return ""
                val identity = self.symbol_identity_v1(rmod, owner_sym)
                if identity == "": return ""
                val key = "{identity}::{method}"
                if self.generic_method_rejected.has(key) or not self.generic_methods.has(key):
                    return ""
                val known: text = self.generic_methods[key]
                val template = self.template_signature_v1(known)
                if template.type_params.len() == owner_args.len():
                    return known
                ""
            case _:
                ""

    me env_type(sym_id: SymbolId) -> HirType?:
        val s: SymbolId = sym_id
        if self.env.has(s.id):
            val t: HirType = self.env[s.id]
            if hir_type_is_concrete(t):
                return t
        nil

    me callee_return_type(callee: HirExpr) -> HirType?:
        """Declared return type of a NON-generic callee, when known: a named
        function, or a local/parameter bound to a concrete `fn(..) -> R`
        (a visitor's `var acc = f(node, ctx)` is typed by `f`'s signature)."""
        if callee == nil:
            return nil
        match callee.kind:
            case HirExprKind.Var(sym_id):
                val bound = self.bound_callable_return(sym_id)
                if bound != nil:
                    return bound
                self.fn_return_of(sym_id)
            case HirExprKind.NamedVar(sym_id, _):
                val nbound = self.bound_callable_return(sym_id)
                if nbound != nil:
                    return nbound
                self.fn_return_of(sym_id)
            case _:
                no_local_type_answer()

    me bound_callable_return(sym_id: SymbolId) -> HirType?:
        val vt = self.env_type(sym_id)
        if vt == nil:
            return nil
        val vtt: HirType = vt
        match vtt.kind:
            case HirTypeKind.Function(_, ret, _):
                val rt: HirType = ret
                if hir_type_is_concrete(rt):
                    return rt
                nil
            case _:
                no_local_type_answer()

    me fn_return_of(sym_id: SymbolId) -> HirType?:
        val s: SymbolId = sym_id
        val k = mono_sym_key(self.current_module, s.id)
        if self.fn_returns.has(k):
            val t: HirType = self.fn_returns[k]
            if hir_type_is_concrete(t):
                return t
        nil

    # --- let pre-collection ------------------------------------------------

    me collect_lets_block(block: HirBlock):
        if block == nil:
            return
        for stmt in block.stmts:
            val st: HirStmt = stmt
            self.collect_lets_stmt(st)
        if block.has:
            val bv: HirExpr = block.value
            self.collect_lets_expr(bv)

    me collect_lets_stmt(stmt: HirStmt):
        if stmt == nil:
            return
        match stmt.kind:
            case HirStmtKind.Let(sym, ty, init):
                val lt: HirType = ty
                val li: HirExpr = init
                val ls: SymbolId = sym
                if lt != nil and hir_type_is_concrete(lt):
                    self.env[ls.id] = lt
                else:
                    # HIR keeps the if-val payload type in the symbol table,
                    # while Let retains its absent source annotation and .?
                    # retains its optional value-or-nil representation. Use
                    # that binding evidence without globally unwrapping .?.
                    var it: HirType? = nil
                    var exists_binding = false
                    if li != nil:
                        match li.kind:
                            case HirExprKind.ExistsCheck(_):
                                exists_binding = true
                                it = self.exists_binding_type(ls, li)
                            case _: ()
                    if it == nil and not exists_binding:
                        it = self.infer_expr_type(li)
                    if it != nil:
                        val itt: HirType = it
                        self.env[ls.id] = itt
                self.collect_lets_expr(li)
            case HirStmtKind.Assign(target, _, value):
                val at: HirExpr = target
                val av: HirExpr = value
                self.collect_lets_expr(at)
                self.collect_lets_expr(av)
            case HirStmtKind.Expr(e):
                val et: HirExpr = e
                self.collect_lets_expr(et)
            case HirStmtKind.Block(b):
                val bt: HirBlock = b
                self.collect_lets_block(bt)
            case _:
                pass

    me exists_binding_type(symbol: SymbolId, checked: HirExpr) -> HirType?:
        if not self.module_symbols.has(self.current_module): return nil
        val symbols: SymbolTable = self.module_symbols[self.current_module]
        if val declared = symbols.get_symbol_type_raw(symbol.id):
            if hir_type_is_concrete(declared): return declared
            if not checked.has_type_ or checked.type_ == nil: return nil
            val original: HirType = checked.type_
            match original.kind:
                case HirTypeKind.Optional(original_payload):
                    if not hir_type_is_symbolic_evidence(original_payload) or not hir_type_is_symbolic_evidence(declared): return nil
                    val binds_payload = hir_types_equal(declared, original_payload)
                    val binds_optional = hir_types_equal(declared, original)
                    if not binds_payload and not binds_optional: return nil
                    match checked.kind:
                        case HirExprKind.ExistsCheck(base):
                            if val inferred = self.infer_expr_type(base):
                                match inferred.kind:
                                    case HirTypeKind.Optional(payload):
                                        if hir_type_is_concrete(payload):
                                            if binds_payload: return payload
                                            return inferred
                                    case _: ()
                        case _: ()
                case _: ()
        # Without the original semantic relation, .? could be either an
        # ordinary Optional binding or an if-val payload binding. Guess neither.
        nil

    me collect_lets_expr(expr: HirExpr):
        """Collect this lexical function's locals through expression operands.
        Lambda bodies are collected only when rewriting that lambda's scope."""
        if expr == nil:
            return
        match expr.kind:
            case HirExprKind.Call(callee, args, _):
                self.collect_lets_expr(callee)
                self.collect_lets_args(args)
            case HirExprKind.MethodCall(receiver, _, args, _):
                self.collect_lets_expr(receiver)
                self.collect_lets_args(args)
            case HirExprKind.StaticCall(_, _, args, _):
                self.collect_lets_args(args)
            case HirExprKind.Binary(_, left, right):
                self.collect_lets_expr(left)
                self.collect_lets_expr(right)
            case HirExprKind.NullCoalesce(left, right):
                self.collect_lets_expr(left)
                self.collect_lets_expr(right)
            case HirExprKind.Index(base, index):
                self.collect_lets_expr(base)
                self.collect_lets_expr(index)
            case HirExprKind.Unary(_, operand): self.collect_lets_expr(operand)
            case HirExprKind.Field(base, _, _): self.collect_lets_expr(base)
            case HirExprKind.TupleIndex(base, _): self.collect_lets_expr(base)
            case HirExprKind.OptionalChain(base, _): self.collect_lets_expr(base)
            case HirExprKind.ExistsCheck(base): self.collect_lets_expr(base)
            case HirExprKind.Unwrap(base): self.collect_lets_expr(base)
            case HirExprKind.Cast(inner, _): self.collect_lets_expr(inner)
            case HirExprKind.As(inner, _): self.collect_lets_expr(inner)
            case HirExprKind.ConvertCall(inner, _): self.collect_lets_expr(inner)
            case HirExprKind.TypeTest(inner, _): self.collect_lets_expr(inner)
            case HirExprKind.Throw(inner): self.collect_lets_expr(inner)
            case HirExprKind.Try(inner): self.collect_lets_expr(inner)
            case HirExprKind.Await(inner): self.collect_lets_expr(inner)
            case HirExprKind.Return(value): self.collect_lets_expr_opt(value)
            case HirExprKind.Break(_, value): self.collect_lets_expr_opt(value)
            case HirExprKind.Yield(value): self.collect_lets_expr_opt(value)
            case HirExprKind.ArrayLit(elements, _): self.collect_lets_exprs(elements)
            case HirExprKind.TupleLit(elements): self.collect_lets_exprs(elements)
            case HirExprKind.SetLit(elements, _): self.collect_lets_exprs(elements)
            case HirExprKind.ArrayRepeat(value, count, _):
                self.collect_lets_expr(value)
                self.collect_lets_expr(count)
            case HirExprKind.DictLit(entries, _, _):
                for entry in entries:
                    val (key, value) = entry
                    self.collect_lets_expr(key)
                    self.collect_lets_expr(value)
            case HirExprKind.StructLit(_, fields): self.collect_lets_named_exprs(fields)
            case HirExprKind.EnumLit(_, _, payload):
                val payload_opt: HirEnumPayload? = payload
                if val contents = payload_opt:
                    match contents:
                        case HirEnumPayload.Tuple(values): self.collect_lets_exprs(values)
                        case HirEnumPayload.Struct(fields): self.collect_lets_named_exprs(fields)
            case HirExprKind.Range(start, end, _, step):
                self.collect_lets_expr_opt(start)
                self.collect_lets_expr_opt(end)
                self.collect_lets_expr_opt(step)
            case HirExprKind.HostGpuLane(_, _, marker, body):
                self.collect_lets_expr(marker)
                self.collect_lets_block(body)
            case HirExprKind.Block(block):
                val bt: HirBlock = block
                self.collect_lets_block(bt)
            case HirExprKind.If(cond, then_, else_):
                self.collect_lets_expr(cond)
                val th: HirBlock = then_
                self.collect_lets_block(th)
                self.collect_lets_block_opt(else_)
            case HirExprKind.IfChain(arms, else_):
                for arm in arms:
                    val at: HirIfArm = arm
                    self.collect_lets_expr(at.cond)
                    self.collect_lets_block(at.then_)
                self.collect_lets_block_opt(else_)
            case HirExprKind.MatchCase(scrutinee, arms):
                # The arm PATTERN often carries no resolved type (`case Int(a)`
                # never spells its enum), so derive the enum name from the
                # SCRUTINEE and pass it down as a hint.
                var scrut_enum = ""
                val sc: HirExpr = scrutinee
                self.collect_lets_expr(sc)
                val sct = self.infer_expr_type(sc)
                if sct != nil:
                    val scc: HirType = sct
                    match scc.kind:
                        case HirTypeKind.Named(ssym, _):
                            scrut_enum = self.named_type_name(ssym, scc)
                        case _:
                            pass_do_nothing("not a named scrutinee")
                val previous_hint = self.match_enum_hint
                for arm in arms:
                    val mt: HirMatchArm = arm
                    # Bind the arm's pattern variables BEFORE descending, so a
                    # generic call in the arm body can infer its type args from
                    # a payload binding (plan §9.4). Without this the whole
                    # generated-visitor / generated-hash family fail-closes to
                    # E-MONO-032.
                    if mono_diag_enabled():
                        eprint("[mono-diag] match arm pattern kind={mt.pattern.kind}")
                    self.match_enum_hint = scrut_enum
                    self.collect_pattern_bindings(mt.pattern)
                    if mt.has_guard:
                        self.collect_lets_expr(mt.guard)
                    self.collect_lets_block(mt.body)
                self.match_enum_hint = previous_hint
            case HirExprKind.Loop(body, _):
                val lb: HirBlock = body
                self.collect_lets_block(lb)
            case HirExprKind.While(cond, body, _):
                self.collect_lets_expr(cond)
                val wb: HirBlock = body
                self.collect_lets_block(wb)
            case HirExprKind.Comprehension(_, cexpr, clauses):
                # Same class as `for`/`with`: a comprehension's `for` clause
                # binds a name with no `let`.
                for c in clauses:
                    val cc: HirCompClause = c
                    match cc.kind:
                        case HirCompClauseKind.For(cvar, citer):
                            val ci: HirExpr = citer
                            self.collect_lets_expr(ci)
                            self.bind_iteration_var(cvar, ci)
                        case HirCompClauseKind.If(cond):
                            self.collect_lets_expr(cond)
                val ce: HirExpr = cexpr
                self.collect_lets_expr(ce)
            case HirExprKind.For(var_, iter, body, _):
                # Same gap as a match-arm binding: the loop variable has no
                # `let`, so `for t in types: mix(h, t)` could not infer `T`.
                # Bound from the iterable's ELEMENT type when the iterable
                # itself is locally inferable; unbound otherwise (fail-closed).
                val fit: HirExpr = iter
                self.collect_lets_expr(fit)
                self.bind_iteration_var(var_, fit)
                val fb: HirBlock = body
                self.collect_lets_block(fb)
            case HirExprKind.With(items, body):
                # `with X as t:` binds `t` with no `let` either.
                for wi in items:
                    val wit: HirWithItem = wi
                    self.collect_lets_expr(wit.context_expr)
                    if wit.has_target:
                        val ct: HirExpr = wit.context_expr
                        val wt = self.infer_expr_type(ct)
                        if wt != nil:
                            val wtt: HirType = wt
                            if hir_type_is_concrete(wtt):
                                val ws: SymbolId = wit.target
                                self.env[ws.id] = wtt
                val wbb: HirBlock = body
                self.collect_lets_block(wbb)
            case HirExprKind.Lambda(_, _, _):
                # Never expose a nested function's bindings to its enclosing
                # function or sibling lambdas. Rewrite enters its own scope.
                pass
            case HirExprKind.UnsafeBlock(body):
                val ub: HirBlock = body
                self.collect_lets_block(ub)
            case HirExprKind.LossBlock(body):
                val lsb: HirBlock = body
                self.collect_lets_block(lsb)
            case HirExprKind.NogradBlock(body):
                val nb: HirBlock = body
                self.collect_lets_block(nb)
            case HirExprKind.StringLit(_, interps):
                val interps_opt: [HirInterpolation]? = interps
                if val interpolation_items = interps_opt:
                    for item in interpolation_items:
                        val it: HirInterpolation = item
                        self.collect_lets_expr(it.expr)
            case HirExprKind.TryCatch(body, clauses, finally_):
                val tcb: HirBlock = body
                self.collect_lets_block(tcb)
                for clause in clauses:
                    val cc: HirCatchClause = clause
                    if cc.has_pattern:
                        self.collect_pattern_bindings(cc.pattern)
                    self.collect_lets_block(cc.body)
                self.collect_lets_block_opt(finally_)
            case _:
                pass

    me collect_lets_expr_opt(expr: HirExpr?):
        if val present = expr:
            self.collect_lets_expr(present)

    me collect_lets_exprs(exprs: [HirExpr]):
        for expr in exprs:
            val item: HirExpr = expr
            self.collect_lets_expr(item)

    me collect_lets_args(args: [HirCallArg]):
        for arg in args:
            val item: HirCallArg = arg
            self.collect_lets_expr(item.value)

    me collect_lets_named_exprs(fields: [(text, HirExpr)]):
        for field in fields:
            val (_, expr) = field
            self.collect_lets_expr(expr)

    me bind_iteration_var(var_: SymbolId, iter: HirExpr):
        """Bind a `for` / comprehension-`for` variable to the ELEMENT type of
        its iterable, when the iterable is locally inferable and the element
        type is concrete. Fail-closed otherwise."""
        match iter.kind:
            case HirExprKind.Range(range_start, range_end, _, _):
                # `for i in a..b`: an i64 counter when both bounds are i64
                # (MIR counts in the 64-bit word); other widths stay unbound.
                var rs_ty: HirType? = nil
                var re_ty: HirType? = nil
                val start_opt: HirExpr? = start
                if val rs = start_opt:
                    rs_ty = self.infer_expr_type(rs)
                val end_opt: HirExpr? = end
                if val re = end_opt:
                    re_ty = self.infer_expr_type(re)
                if rs_ty != nil and re_ty != nil:
                    val rst: HirType = rs_ty
                    val ret: HirType = re_ty
                    if hir_type_key(rst) == "i64" and hir_type_key(ret) == "i64":
                        val rv: SymbolId = var_
                        self.env[rv.id] = rst
                return
            case _: ()
        val itt = self.infer_expr_type(iter)
        if itt == nil:
            return
        val itc: HirType = itt
        match itc.kind:
            case HirTypeKind.Array(elem, _):
                val et: HirType = elem
                if et != nil and hir_type_is_concrete(et):
                    val fv: SymbolId = var_
                    self.env[fv.id] = et
            case HirTypeKind.Slice(selem):
                val st: HirType = selem
                if st != nil and hir_type_is_concrete(st):
                    val sv: SymbolId = var_
                    self.env[sv.id] = st
            case _:
                pass_do_nothing("not an array/slice iterable")

    me collect_pattern_bindings(pat: HirPattern):
        """Seed `env` with every variable a pattern binds.

        A pattern binding carries no `let` and is not a parameter, so it was
        invisible to the inference environment. Types come from, in order:
        the pattern's own recorded type when concrete; the enclosing enum
        variant's DECLARED payload type. Anything else is left unbound --
        fail-closed, exactly like `infer_call_type_args`: an unbound name
        still yields the loud E-MONO-032, never a guessed specialization."""
        if pat == nil:
            return
        match pat.kind:
            case HirPatternKind.Binding(sym, _):
                if pat.has_type_:
                    val bt: HirType = pat.type_
                    if bt != nil and hir_type_is_concrete(bt):
                        val bs: SymbolId = sym
                        self.env[bs.id] = bt
            case HirPatternKind.Tuple(elements):
                for e in elements:
                    val et: HirPattern = e
                    self.collect_pattern_bindings(et)
            case HirPatternKind.Array(elements, _):
                for e in elements:
                    val at: HirPattern = e
                    self.collect_pattern_bindings(at)
            case HirPatternKind.Or(patterns):
                for e in patterns:
                    val ot: HirPattern = e
                    self.collect_pattern_bindings(ot)
            case HirPatternKind.Struct(_, fields):
                for f in fields:
                    val (_fname, fpat) = f
                    val fp: HirPattern = fpat
                    self.collect_pattern_bindings(fp)
            case HirPatternKind.Enum(ty, variant, payload):
                val ety: HirType = ty
                var ename = ""
                if ety != nil:
                    match ety.kind:
                        case HirTypeKind.Named(nsym, _):
                            ename = self.named_type_name(nsym, ety)
                        case _:
                            pass_do_nothing("not a named enum type")
                if mono_diag_enabled():
                    eprint("[mono-diag] enum pattern name='{ename}' variant='{variant}'")
                if ename == "":
                    ename = self.match_enum_hint
                self.collect_enum_payload_bindings(ename, variant, payload)
            case _:
                pass_do_nothing("binds nothing")

    me collect_enum_payload_bindings(enum_name: text, variant: text, payload: HirPatternPayload?):
        """Bind an enum arm's payload variables by DECLARED payload type."""
        match payload:
            Some(pp):
                match pp:
                    case HirPatternPayload.Tuple(patterns):
                        var i = 0
                        for sp in patterns:
                            val spt: HirPattern = sp
                            self.bind_payload_pattern(spt, "{enum_name}::{variant}::{i}")
                            i = i + 1
                    case HirPatternPayload.Struct(fields):
                        for f in fields:
                            val (fname, fpat) = f
                            val fp: HirPattern = fpat
                            self.bind_payload_pattern(fp, "{enum_name}::{variant}::{fname}")
            nil:
                pass_do_nothing("unit variant")

    me bind_payload_pattern(pat: HirPattern, key: text):
        """Bind one payload sub-pattern, preferring the declared payload type
        over the pattern's own (often absent) recorded type."""
        if pat == nil:
            return
        match pat.kind:
            case HirPatternKind.Binding(sym, _):
                val bs: SymbolId = sym
                if mono_diag_enabled():
                    eprint("[mono-diag] bind payload key='{key}' known={self.enum_payload_types.has(key)} sym={bs.id}")
                if self.enum_payload_types.has(key):
                    val dt: HirType = self.enum_payload_types[key]
                    if dt != nil and hir_type_is_concrete(dt):
                        self.env[bs.id] = dt
                        return
                # Last resort when the enum NAME could be recovered from
                # neither the pattern nor the scrutinee: a variant+slot suffix
                # that is declared by exactly ONE enum in the whole program is
                # unambiguous. Two or more matches -> leave unbound, so the
                # loud E-MONO-032 stands rather than a coin flip.
                val suffix = mono_payload_key_suffix(key)
                var found: HirType? = nil
                var hits = 0
                for k in self.enum_payload_types.keys():
                    val kt: text = k
                    if kt.ends_with(suffix):
                        hits = hits + 1
                        found = self.enum_payload_types[kt]
                if hits == 1:
                    if found != nil:
                        val ft: HirType = found
                        if hir_type_is_concrete(ft):
                            self.env[bs.id] = ft
                            return
                self.collect_pattern_bindings(pat)
            case _:
                self.collect_pattern_bindings(pat)

    me collect_lets_block_opt(block: HirBlock?):
        match block:
            Some(b):
                val bt: HirBlock = b
                self.collect_lets_block(bt)
            nil:
                pass_do_nothing("no block")

    # ========================================================================
    # Step 2b: Call-site rewriting (exhaustive over nested expressions)
    # ========================================================================

    me rewrite_block(block: HirBlock, expected_result: HirType? = nil) -> HirBlock:
        """Rewrite generic call sites inside a block. Nil-guarded: freshly
        single-file-lowered HIR can carry nil sub-blocks where the seed's
        ANY-erased payloads mis-resolved during lowering."""
        if block == nil:
            return block
        var out = block
        var stmts: [HirStmt] = []
        for stmt in block.stmts:
            val stmt_t: HirStmt = stmt
            stmts = stmts.push(self.rewrite_stmt(stmt_t))
        out.stmts = stmts
        if block.has:
            val bv: HirExpr = block.value
            out.value = self.rewrite_expr_with_context(bv, expected_result)
        out

    me rewrite_block_opt(block: HirBlock?) -> HirBlock?:
        match block:
            Some(b):
                val bt: HirBlock = b
                self.rewrite_block(bt)
            nil:
                nil

    me rewrite_expr_opt(expr: HirExpr?) -> HirExpr?:
        match expr:
            Some(e):
                val et: HirExpr = e
                self.rewrite_expr(et)
            nil:
                nil

    me rewrite_exprs(exprs: [HirExpr]) -> [HirExpr]:
        var out: [HirExpr] = []
        for e in exprs:
            val et: HirExpr = e
            out = out.push(self.rewrite_expr(et))
        out

    me rewrite_call_args(args: [HirCallArg]) -> [HirCallArg]:
        var out: [HirCallArg] = []
        for a in args:
            val at: HirCallArg = a
            var na = at
            na.value = self.rewrite_expr(mono_arg_value(at))
            out = out.push(na)
        out

    me rewrite_named_exprs(fields: [(text, HirExpr)]) -> [(text, HirExpr)]:
        var out: [(text, HirExpr)] = []
        for f in fields:
            val (fname, fexpr) = f
            val fe: HirExpr = fexpr
            out = out.push((fname, self.rewrite_expr(fe)))
        out

    me rewrite_enum_payload(payload: HirEnumPayload?) -> HirEnumPayload?:
        match payload:
            Some(p):
                match p:
                    case Tuple(values):
                        HirEnumPayload.Tuple(self.rewrite_exprs(values))
                    case Struct(fields):
                        HirEnumPayload.Struct(self.rewrite_named_exprs(fields))
            nil:
                nil

    me rewrite_stmt(stmt: HirStmt) -> HirStmt:
        """Rewrite generic call sites inside a statement. Patterns are
        qualified: the seed's unqualified-pattern heuristic looks a bare
        `Expr`/`Block` up as a TYPE and collides with the frontend AST."""
        if stmt == nil:
            return stmt
        if mono_diag_enabled():
            eprint("[mono-diag] stmt {stmt.kind}")
        var out = stmt
        match stmt.kind:
            case HirStmtKind.Let(sym, ty, init):
                val init_t: HirExpr = init
                out.kind = HirStmtKind.Let(sym, ty, self.rewrite_expr_with_context(init_t, ty))
            case HirStmtKind.Assign(target, op, value):
                val target_t: HirExpr = target
                val value_t: HirExpr = value
                out.kind = HirStmtKind.Assign(self.rewrite_expr(target_t), op, self.rewrite_expr(value_t))
            case HirStmtKind.Expr(e):
                val se_t: HirExpr = e
                out.kind = HirStmtKind.Expr(self.rewrite_expr(se_t))
            case HirStmtKind.Block(b):
                val sb_t: HirBlock = b
                out.kind = HirStmtKind.Block(self.rewrite_block(sb_t))
            case HirStmtKind.AsmAssert(_):
                pass_do_nothing("no nested expression")
        out

    me rewrite_call(callee: HirExpr, args: [HirCallArg], type_args: [HirType], expected_result: HirType? = nil, call_span: Span? = nil) -> HirExprKind:
        """Rewrite one call site.

        A call to a generic function becomes a plain call to its
        specialization with EMPTY `type_args`. Type arguments written at the
        call site are used verbatim; otherwise they are inferred from the
        argument types. A generic call that can be neither is left as-is and
        recorded as a loud diagnostic (the post-mono verifier also counts it)."""
        val new_args = self.rewrite_call_args(args)
        var new_callee = self.rewrite_expr(callee)
        var new_type_args: [HirType] = type_args
        val gname = self.callee_generic_name(callee)
        if gname == "":
            return HirExprKind.Call(new_callee, new_args, new_type_args)
        self.stats.call_sites_found = self.stats.call_sites_found + 1
        val template = self.template_signature_v1(gname)
        val completed = self.resolve_call_type_args_signature_v1(template, new_args, type_args, expected_result)
        if completed.is_err():
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            var site_span: Span = callee.span
            if site_span.line <= 0 and call_span != nil:
                val cs: Span = call_span
                if cs.line > 0: site_span = cs
            val site: text = self.call_site_location(site_span)
            val reason: text = completed.unwrap_err()
            var detail: text = reason
            if type_args == nil or type_args.len() == 0:
                detail = "has no explicit type arguments and they could not be inferred from its argument types ({reason})"
            self.diagnostics = self.diagnostics.push(
                "E-MONO-032: call to generic `{gname}` at {site}: {detail}; call site not monomorphized")
            return HirExprKind.Call(new_callee, new_args, new_type_args)
        val targs: [HirType] = completed.unwrap()
        val target = self.request_specialization(gname, targs)
        if target < 0:
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            return HirExprKind.Call(new_callee, new_args, new_type_args)
        # MIR resolves a direct callee by NAME (`lower_call`'s NamedVar arm
        # uses the baked display name; its Var arm looks the id up in the
        # CALLER's symbol table, where a fresh mono symbol does not exist).
        # Imported explicit calls may arrive as Var or bare/aliased NamedVar.
        # The template owner and physical linkage determine the emitted name;
        # caller spelling does not. The stamped type remains caller-local.
        val spec_name: text = self.mangled_name(gname, targs)
        # The repointed callee carries the SPECIALIZATION's concrete
        # `fn(params) -> ret`. Its SymbolId is minted outside every module
        # table (MONO_SYMBOL_BASE), so MIR cannot type the call through a
        # symbol lookup; without this stamp the result defaulted to the
        # erased i64 and a `text`/`f64` instance was consumed as an integer
        # (BUG-IT-5).
        # The stamp's nominal ids must live in the CALLER's module scope, so
        # the signature is transported out of the specialization's module.
        var spec_sig = HirType(kind: HirTypeKind.Any, span: callee.span)
        if val signature = self.specialization_signature_in_caller(spec_name, callee.span):
            spec_sig = signature
        else:
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            return HirExprKind.Call(new_callee, new_args, new_type_args)
        # Physical linkage and template owner survive both body modes;
        # caller spelling is not declaration ownership. The nominal signature
        # above remains transported into the caller's symbol table.
        new_callee = HirExpr(kind: HirExprKind.NamedVar(SymbolId.new(target), self.specialization_callee_name_v1(gname, spec_name)),
                             has_type_: true,
                             type_: spec_sig,
                             span: callee.span)
        new_type_args = []
        HirExprKind.Call(new_callee, new_args, new_type_args)

    me receiver_instance_type(receiver: HirExpr) -> (HirType?, text):
        """Receiver type from its DECLARATION -- a param/let binding or a
        field chain -- with the module whose table minted its SymbolIds, then
        the general local inference. HIR may stamp a receiver expression with
        its bare class (`Box`, no arguments), which would hide the `Box<i64>`
        the declaration carries. `if val b = opt:` aliases the optional
        binding, so an `Optional<Box<i64>>` receiver is its payload."""
        var found: HirType? = nil
        var found_module = self.current_module
        match receiver.kind:
            case HirExprKind.Var(sym_id):
                found = self.env_type(sym_id)
            case HirExprKind.NamedVar(sym_id, _):
                found = self.env_type(sym_id)
            case HirExprKind.Field(_, _, _):
                val (ft, fmod) = self.infer_field_chain(receiver)
                found = ft
                found_module = fmod
            case _: ()
        if found == nil:
            found = self.infer_expr_type(receiver)
            found_module = self.current_module
        if found == nil:
            return (nil, found_module)
        val ft2: HirType = found
        match ft2.kind:
            case HirTypeKind.Optional(inner):
                val payload: HirType = inner
                (payload, found_module)
            case _:
                (ft2, found_module)

    me generic_method_template(receiver: HirExpr, method: text) -> text:
        """Template key of `method` when the receiver's type is a concrete
        instantiation (`Box<i64>`) of a class whose generic impl declares it,
        else "". The class is matched by ownership identity, so a same-named
        class from another module never borrows the template. A method that
        cannot be specialized this way is reported (E-MONO-034) here: the
        receiver's class is known, so MIR would otherwise bind the call to the
        unspecialized template, which is never emitted."""
        val (rt, rmod) = self.receiver_instance_type(receiver)
        if rt == nil:
            return ""
        val rtt: HirType = rt
        match rtt.kind:
            case HirTypeKind.Named(owner_sym, owner_args):
                if owner_args.len() == 0:
                    return ""
                val identity = self.symbol_identity_v1(rmod, owner_sym)
                if identity == "": return ""
                val key = "{identity}::{method}"
                var reason = ""
                if self.generic_method_rejected.has(key):
                    reason = self.generic_method_rejected[key]
                elif not self.generic_methods.has(key):
                    return ""
                else:
                    val known: text = self.generic_methods[key]
                    val template = self.template_signature_v1(known)
                    if template.type_params.len() == owner_args.len():
                        return known
                    reason = "the receiver has {owner_args.len()} type arguments and the impl declares {template.type_params.len()} type parameters"
                # Leveled (default `warning`): before this pass typed generic
                # receivers such a call was simply left as a method call, and
                # modules containing one compile today. `error` refuses it.
                if self.report_leveled("E-MONO-034",
                        "E-MONO-034: method `{method}` of generic `{identity}` cannot be specialized for this receiver: {reason}; call site not monomorphized (it stays a call of the unspecialized method, as before this check existed)"):
                    self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
                ""
            case _:
                ""

    me rewrite_generic_method_call(gname: text, receiver: HirExpr, method: text, args: [HirCallArg], resolution: MethodResolution) -> HirExprKind:
        """`recv.m(a)` on a `Box<i64>` receiver -> a direct call of the
        `Box<i64>` specialization with the receiver first (UFCS; the
        template's params[0] is `self`). Falls back to the unchanged method
        call when the specialization is refused."""
        val new_receiver = self.rewrite_expr(receiver)
        val new_args = self.rewrite_call_args(args)
        var targs: [HirType] = []
        val (rt, rmod) = self.receiver_instance_type(receiver)
        if rt != nil:
            val rtt: HirType = rt
            match rtt.kind:
                case HirTypeKind.Named(_, owner_args):
                    targs = owner_args
                case _: ()
        self.stats.call_sites_found = self.stats.call_sites_found + 1
        if val caller_args = self.relocate_mono_types(targs, rmod, self.current_module, "receiver arguments of `{gname}`"):
            targs = caller_args
        else:
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            return HirExprKind.MethodCall(new_receiver, method, new_args, resolution)
        val target = self.request_specialization(gname, targs)
        if target < 0:
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            return HirExprKind.MethodCall(new_receiver, method, new_args, resolution)
        val spec_name: text = self.mangled_name(gname, targs)
        val callee_name = self.specialization_callee_name_v1(gname, spec_name)
        var call_args: [HirCallArg] = [HirCallArg(has_name: false, name: "", value: new_receiver, span: receiver.span)]
        for a in new_args:
            call_args = call_args.push(a)
        # Same stamp as `rewrite_call`: the specialization's own signature
        # types the call's result (a `text`-returning `get` is a pointer, not
        # the erased i64 -- BUG-IT-5 class), transported into the caller's
        # module scope.
        var spec_sig = HirType(kind: HirTypeKind.Any, span: receiver.span)
        if val signature = self.specialization_signature_in_caller(spec_name, receiver.span):
            spec_sig = signature
        else:
            self.stats.unresolved_generic_calls = self.stats.unresolved_generic_calls + 1
            self.unresolved_templates[gname] = true
            return HirExprKind.MethodCall(new_receiver, method, new_args, resolution)
        val callee = HirExpr(kind: HirExprKind.NamedVar(SymbolId.new(target), callee_name),
                             has_type_: true, type_: spec_sig, span: receiver.span)
        HirExprKind.Call(callee, call_args, [])

    me rewrite_expr_with_context(expr: HirExpr, expected: HirType?) -> HirExpr:
        # Context is used only for this call, never inherited by its arguments.
        if expr == nil:
            return expr
        match expr.kind:
            case HirExprKind.Call(callee, args, type_args):
                val ct: HirExpr = callee
                val at: [HirCallArg] = args
                var out = expr
                val context: HirType? = if expected != nil: expected else: (if expr.has_type_: expr.type_ else: nil)
                out.kind = self.rewrite_call(ct, at, type_args, context, expr.span)
                out
            case _:
                self.rewrite_expr(expr)

    me rewrite_expr(expr: HirExpr) -> HirExpr:
        """Rewrite generic call sites inside an expression.

        Every `HirExprKind` that can hold a nested expression or block is
        descended into, mirroring `substitute_expr` in `type_subst.spl`, so a
        generic call inside an `if` arm, a match body, a closure or a
        collection literal is rewritten like a top-level one."""
        if expr == nil:
            return expr
        if mono_diag_enabled():
            eprint("[mono-diag] expr line={expr.span.line}")
        var out = expr
        match expr.kind:
            case HirExprKind.Call(callee, args, type_args):
                val callee_t: HirExpr = callee
                val args_t: [HirCallArg] = args
                val expected: HirType? = if expr.has_type_: expr.type_ else: nil
                out.kind = self.rewrite_call(callee_t, args_t, type_args, expected, expr.span)

            # Collections
            case HirExprKind.ArrayLit(elements, elem_ty):
                out.kind = HirExprKind.ArrayLit(self.rewrite_exprs(elements), elem_ty)
            case HirExprKind.ArrayRepeat(value, count, elem_ty):
                val v1: HirExpr = value
                val c1: HirExpr = count
                out.kind = HirExprKind.ArrayRepeat(self.rewrite_expr(v1), self.rewrite_expr(c1), elem_ty)
            case HirExprKind.TupleLit(elements):
                out.kind = HirExprKind.TupleLit(self.rewrite_exprs(elements))
            case HirExprKind.DictLit(entries, key_ty, value_ty):
                var new_entries: [(HirExpr, HirExpr)] = []
                for entry in entries:
                    val (k, v) = entry
                    val kt: HirExpr = k
                    val vt: HirExpr = v
                    new_entries = new_entries.push((self.rewrite_expr(kt), self.rewrite_expr(vt)))
                out.kind = HirExprKind.DictLit(new_entries, key_ty, value_ty)
            case HirExprKind.SetLit(elements, elem_ty):
                out.kind = HirExprKind.SetLit(self.rewrite_exprs(elements), elem_ty)

            # Access
            case HirExprKind.Field(base, field, resolved):
                val b1: HirExpr = base
                # A field of a generic INSTANCE is typed by the instance
                # (`b.items` on a `Bag<text>` is `[text]`, not `[T]`). 50.mir
                # has no expression typing of its own, so the read carries
                # the instance type to it.
                val instance_field = self.generic_instance_field_read_type(b1, field)
                if instance_field != nil:
                    out.has_type_ = true
                    out.type_ = instance_field
                else:
                    self.note_unknown_instance_field_read(b1, field)
                out.kind = HirExprKind.Field(self.rewrite_expr(b1), field, resolved)
            case HirExprKind.Index(base, index):
                val b2: HirExpr = base
                val i2: HirExpr = index
                out = self.stamp_instance_field_use(out, b2)
                out.kind = HirExprKind.Index(self.rewrite_expr(b2), self.rewrite_expr(i2))
            case HirExprKind.TupleIndex(base, index):
                val b3: HirExpr = base
                out.kind = HirExprKind.TupleIndex(self.rewrite_expr(b3), index)
            case HirExprKind.OptionalChain(base, field):
                val b4: HirExpr = base
                out.kind = HirExprKind.OptionalChain(self.rewrite_expr(b4), field)
            case HirExprKind.NullCoalesce(left, right):
                val l1: HirExpr = left
                val r1: HirExpr = right
                out = self.stamp_instance_field_use(out, l1)
                out.kind = HirExprKind.NullCoalesce(self.rewrite_expr(l1), self.rewrite_expr(r1))
            case HirExprKind.ExistsCheck(base):
                val b5: HirExpr = base
                out.kind = HirExprKind.ExistsCheck(self.rewrite_expr(b5))
            case HirExprKind.Unwrap(base):
                val b6: HirExpr = base
                out = self.stamp_instance_field_use(out, b6)
                out.kind = HirExprKind.Unwrap(self.rewrite_expr(b6))

            # Operators
            case HirExprKind.Binary(op, left, right):
                val l2: HirExpr = left
                val r2: HirExpr = right
                out.kind = HirExprKind.Binary(op, self.rewrite_expr(l2), self.rewrite_expr(r2))
            case HirExprKind.Unary(op, operand):
                val o1: HirExpr = operand
                out.kind = HirExprKind.Unary(op, self.rewrite_expr(o1))

            # Resolve static generic factories by their exact method symbol.
            # Ordinary instance/trait dispatch must retain its receiver.
            case HirExprKind.MethodCall(receiver, method, args, resolution):
                val rc: HirExpr = receiver
                match resolution:
                    case MethodResolution.StaticMethod(_, method_id):
                        val callee = HirExpr(kind: HirExprKind.Var(method_id), has_type_: false, type_: nil, span: expr.span)
                        if self.callee_generic_name(callee) != "":
                            out.kind = self.rewrite_call(callee, args, [], if expr.has_type_: expr.type_ else: nil, expr.span)
                        else:
                            out.kind = HirExprKind.MethodCall(self.rewrite_expr(rc), method, self.rewrite_call_args(args), resolution)
                    case _:
                        val generic_method = self.generic_method_template(rc, method)
                        if generic_method != "":
                            out.kind = self.rewrite_generic_method_call(generic_method, rc, method, args, resolution)
                        else:
                            out.kind = HirExprKind.MethodCall(self.rewrite_expr(rc), method, self.rewrite_call_args(args), resolution)
            case HirExprKind.StaticCall(ty, method, args, resolution):
                match resolution:
                    case MethodResolution.StaticMethod(_, method_id):
                        val callee = HirExpr(kind: HirExprKind.Var(method_id), has_type_: false, type_: nil, span: expr.span)
                        if self.callee_generic_name(callee) != "":
                            out.kind = self.rewrite_call(callee, args, [], if expr.has_type_: expr.type_ else: nil, expr.span)
                        else:
                            out.kind = HirExprKind.StaticCall(ty, method, self.rewrite_call_args(args), resolution)
                    case _:
                        out.kind = HirExprKind.StaticCall(ty, method, self.rewrite_call_args(args), resolution)

            # Control flow
            case HirExprKind.If(cond, then_, else_):
                val cd: HirExpr = cond
                val th: HirBlock = then_
                out.kind = HirExprKind.If(self.rewrite_expr(cd), self.rewrite_block(th), self.rewrite_block_opt(else_))
            case HirExprKind.IfChain(arms, else_):
                var new_arms: [HirIfArm] = []
                for arm in arms:
                    val at2: HirIfArm = arm
                    var na = at2
                    na.cond = self.rewrite_expr(at2.cond)
                    na.then_ = self.rewrite_block(at2.then_)
                    new_arms = new_arms.push(na)
                out.kind = HirExprKind.IfChain(new_arms, self.rewrite_block_opt(else_))
            case HirExprKind.MatchCase(scrutinee, arms):
                val sc: HirExpr = scrutinee
                var marms: [HirMatchArm] = []
                for arm in arms:
                    val mt: HirMatchArm = arm
                    var nm = mt
                    if mt.has_guard:
                        nm.guard = self.rewrite_expr(mt.guard)
                    nm.body = self.rewrite_block(mt.body)
                    marms = marms.push(nm)
                out.kind = HirExprKind.MatchCase(self.rewrite_expr(sc), marms)
            case HirExprKind.Loop(body, label):
                val lb: HirBlock = body
                out.kind = HirExprKind.Loop(self.rewrite_block(lb), label)
            case HirExprKind.While(cond, body, label):
                val wc: HirExpr = cond
                val wb: HirBlock = body
                out.kind = HirExprKind.While(self.rewrite_expr(wc), self.rewrite_block(wb), label)
            case HirExprKind.For(var_, iter, body, label):
                val fi: HirExpr = iter
                val fb: HirBlock = body
                out.kind = HirExprKind.For(var_, self.rewrite_expr(fi), self.rewrite_block(fb), label)
            case HirExprKind.With(items, body):
                var new_items: [HirWithItem] = []
                for item in items:
                    val it2: HirWithItem = item
                    var ni = it2
                    ni.context_expr = self.rewrite_expr(it2.context_expr)
                    new_items = new_items.push(ni)
                val wbb: HirBlock = body
                out.kind = HirExprKind.With(new_items, self.rewrite_block(wbb))

            # Closures and blocks
            case HirExprKind.Lambda(params, body, captures):
                val lbody: HirExpr = body
                val previous_return_type = self.current_return_type
                val previous_env = self.env
                val previous_hint = self.match_enum_hint
                # Copy the captured environment into a distinct table so a
                # lambda's bindings cannot mutate the enclosing snapshot.
                var lambda_env: Dict<i64, HirType> = {}
                for raw_id in previous_env.keys():
                    # Bootstrap dictionaries may expose decimal text keys;
                    # preserve numeric SymbolIds under either representation.
                    val id: i64 = i64("{raw_id}")
                    val binding: HirType = previous_env[id]
                    lambda_env[id] = binding
                self.env = lambda_env
                self.match_enum_hint = ""
                for param in params:
                    val p: HirParam = param
                    if hir_type_is_concrete(p.type_):
                        self.env[p.symbol.id] = p.type_
                    else:
                        self.env.remove(p.symbol.id)
                self.current_return_type = nil
                if expr.has_type_:
                    match expr.type_.kind:
                        case HirTypeKind.Function(_, ret, _):
                            self.current_return_type = ret
                        case _:
                            pass
                self.collect_lets_expr(lbody)
                out.kind = HirExprKind.Lambda(params, self.rewrite_expr_with_context(lbody, self.current_return_type), captures)
                self.current_return_type = previous_return_type
                self.env = previous_env
                self.match_enum_hint = previous_hint
            case HirExprKind.Block(block):
                val bk: HirBlock = block
                out.kind = HirExprKind.Block(self.rewrite_block(bk))
            case HirExprKind.HostGpuLane(lane_code, payload_size, marker, body):
                val mk: HirExpr = marker
                val gb: HirBlock = body
                out.kind = HirExprKind.HostGpuLane(lane_code, payload_size, self.rewrite_expr(mk), self.rewrite_block(gb))

            # Control transfer
            case HirExprKind.Return(value):
                match value:
                    Some(v):
                        val rv: HirExpr = v
                        out.kind = HirExprKind.Return(self.rewrite_expr_with_context(rv, self.current_return_type))
                    nil:
                        pass
            case HirExprKind.Break(label, value):
                out.kind = HirExprKind.Break(label, self.rewrite_expr_opt(value))
            case HirExprKind.Throw(value):
                val tv: HirExpr = value
                out.kind = HirExprKind.Throw(self.rewrite_expr(tv))
            case HirExprKind.Try(inner):
                val ti: HirExpr = inner
                out.kind = HirExprKind.Try(self.rewrite_expr(ti))
            case HirExprKind.Await(inner):
                val ai: HirExpr = inner
                out.kind = HirExprKind.Await(self.rewrite_expr(ai))
            case HirExprKind.Yield(value):
                out.kind = HirExprKind.Yield(self.rewrite_expr_opt(value))

            # Construction
            case HirExprKind.StructLit(ty, fields):
                out.kind = HirExprKind.StructLit(ty, self.rewrite_named_exprs(fields))
            case HirExprKind.EnumLit(ty, variant, payload):
                out.kind = HirExprKind.EnumLit(ty, variant, self.rewrite_enum_payload(payload))

            # Casts
            case HirExprKind.Cast(inner, target):
                val ci: HirExpr = inner
                out.kind = HirExprKind.Cast(self.rewrite_expr(ci), target)
            case HirExprKind.As(inner, target):
                val ai2: HirExpr = inner
                out.kind = HirExprKind.As(self.rewrite_expr(ai2), target)
            case HirExprKind.ConvertCall(inner, target):
                val cvi: HirExpr = inner
                out.kind = HirExprKind.ConvertCall(self.rewrite_expr(cvi), target)

            # Special
            case HirExprKind.Range(start, end, inclusive, step):
                out.kind = HirExprKind.Range(self.rewrite_expr_opt(start), self.rewrite_expr_opt(end), inclusive, self.rewrite_expr_opt(step))
            case HirExprKind.Comprehension(kind, inner, clauses):
                val ce2: HirExpr = inner
                var new_clauses: [HirCompClause] = []
                for clause in clauses:
                    val cl: HirCompClause = clause
                    var nc2 = cl
                    match cl.kind:
                        case HirCompClauseKind.For(var_, iter):
                            val cli: HirExpr = iter
                            nc2.kind = HirCompClauseKind.For(var_, self.rewrite_expr(cli))
                        case HirCompClauseKind.If(cond):
                            val clc: HirExpr = cond
                            nc2.kind = HirCompClauseKind.If(self.rewrite_expr(clc))
                    new_clauses = new_clauses.push(nc2)
                out.kind = HirExprKind.Comprehension(kind, self.rewrite_expr(ce2), new_clauses)
            case HirExprKind.LossBlock(body):
                val lbb: HirBlock = body
                out.kind = HirExprKind.LossBlock(self.rewrite_block(lbb))
            case HirExprKind.NogradBlock(body):
                val nbb: HirBlock = body
                out.kind = HirExprKind.NogradBlock(self.rewrite_block(nbb))
            case HirExprKind.UnsafeBlock(body):
                val ubb: HirBlock = body
                out.kind = HirExprKind.UnsafeBlock(self.rewrite_block(ubb))

            # A string literal is a leaf only when it has no interpolation.
            # `"x={pick(a, b)}"` holds a full call expression per segment;
            # skipping it left the template name in the object file while
            # the counters said 0 unresolved (stage2 micro_h: `[mono]
            # call_sites=0`, then `undefined symbol: pick_second` at link).
            case HirExprKind.StringLit(value, interps):
                # Fresh HIR can carry a flat list; the generated cache decoder
                # constructs Some(list). Bind the optional before iterating so
                # both representations retain their interpolation expressions.
                val interps_opt: [HirInterpolation]? = interps
                if val interpolation_items = interps_opt:
                    var new_interps: [HirInterpolation] = []
                    for item in interpolation_items:
                        val it: HirInterpolation = item
                        var ni = it
                        ni.expr = self.rewrite_expr(it.expr)
                        new_interps = new_interps.push(ni)
                    out.kind = HirExprKind.StringLit(value, new_interps)
            case HirExprKind.TypeTest(value, type_name):
                val ttv: HirExpr = value
                out.kind = HirExprKind.TypeTest(self.rewrite_expr(ttv), type_name)
            case HirExprKind.TryCatch(body, clauses, finally_):
                val tcb: HirBlock = body
                var new_clauses: [HirCatchClause] = []
                for clause in clauses:
                    val cc: HirCatchClause = clause
                    var ncc = cc
                    ncc.body = self.rewrite_block(cc.body)
                    new_clauses = new_clauses.push(ncc)
                out.kind = HirExprKind.TryCatch(self.rewrite_block(tcb), new_clauses, self.rewrite_block_opt(finally_))

            # Leaves / opaque: literals, symbol references, Continue,
            # CustomBlock, inline asm (operands are substituted by
            # type_subst but cannot hold a generic CALL), Error.
            case _:
                pass
        out

    # ========================================================================
    # Step 4 (plan section 9.3 step 12): remove consumed generic templates
    # ========================================================================

    me template_was_specialized(name: text) -> bool:
        """True when at least one specialization of `name` was actually emitted
        AND no call site to `name` was left unrewritten (pruning a template a
        live call still targets would turn a loud leftover into a dangling
        symbol)."""
        if self.unresolved_templates.has(name):
            return false
        if self.template_body_mode == MonoTemplateBodyModeV1.ArchiveRequests:
            for template in self.archive_emitted_templates.values():
                if template == name: return true
            return false
        for mangled in self.specialized_functions.keys():
            val m: text = mangled
            if self.spec_template[m] == name:
                return true
        false

    me prune_consumed_templates(module: HirModule) -> HirModule:
        """Drop every generic definition that has >= 1 emitted specialization.

        Fail-closed on three axes:
        - a definition is only ever a candidate when it is genuinely generic
          (`type_params` non-empty, or the HIR `is_generic_template` flag set),
          so a non-generic function can never be dropped;
        - it is only dropped when `template_was_specialized` proves a
          specialization of that exact name reached `specialized_functions`;
        - a specialization itself is never a candidate: its name carries the
          `$` mangling separator and so cannot equal a template name.

        A generic template with ZERO instantiations is deliberately KEPT: it is
        unreachable, and removing it here would hide the fact that MIR lowering
        (`50.mir/_MirLowering/module_lowering.spl:981`, `lower_module`, which
        iterates `module.functions.values()` with no template check) does not
        skip it. That gap is the `hir_generic_templates_unconsumed` bug."""
        if module == nil:
            return module
        if self.specialized_functions.len() == 0:
            if self.template_body_mode != MonoTemplateBodyModeV1.ArchiveRequests or self.archive_emitted_templates.len() == 0:
                return module
        var out = module
        var kept: Dict<SymbolId, HirFunction> = {}
        for sym_id in module.functions.keys():
            val f: HirFunction = module.functions[sym_id]
            var is_template = false
            val tps: [HirTypeParam] = f.type_params
            if tps != nil:
                if tps.len() > 0:
                    is_template = true
            if f.is_generic_template:
                is_template = true
            if is_template:
                if self.template_was_specialized(f.name):
                    continue
            kept[sym_id] = f
        out.functions = kept
        out

    # ========================================================================
    # Statistics
    # ========================================================================

    fn get_stats() -> MonoStats:
        self.stats

# ============================================================================
# Helper Functions
# ============================================================================

fn sorted_function_indices(functions: [HirFunction]) -> [i64]:
    """Value-array indices in ascending symbol-id order (deterministic roots).

    Native erased dictionaries compare aggregate SymbolId keys by identity.
    Sorting copied keys and looking them up loses the function payload. Keep
    the values directly; sort only scalar indices so swaps never copy bodies.
    """
    var indices: [i64] = []
    var symbol_ids: [i64] = []
    var function_index = 0
    while function_index < functions.len():
        val function: HirFunction = functions[function_index]
        val symbol: SymbolId = function.symbol
        indices.push(function_index)
        symbol_ids.push(symbol.id)
        function_index = function_index + 1
    # Preserve the existing stable insertion sort and ascending numeric order.
    var i = 1
    while i < indices.len():
        val cur: i64 = indices[i]
        var j = i - 1
        while j >= 0:
            val prev: i64 = indices[j]
            if symbol_ids[prev] <= symbol_ids[cur]:
                break
            indices[j + 1] = prev
            j = j - 1
        indices[j + 1] = cur
        i = i + 1
    indices

fn is_generic_function(func: HirFunction) -> bool:
    """Check if a function has type parameters.

    `.?` on the plain (non-optional) [HirTypeParam] field is TRUE for an
    empty list, which classified EVERY function (incl. -c main) as generic
    and dragged the whole mono machinery in (bug doc iteration 18). Check
    emptiness, nil-guarded."""
    val tps: [HirTypeParam] = func.type_params
    if tps == nil:
        return false
    tps.len() > 0

fn is_generic_struct(s: HirStruct) -> bool:
    """Check if a struct has type parameters (see is_generic_function)."""
    val tps: [HirTypeParam] = s.type_params
    if tps == nil:
        return false
    tps.len() > 0

fn is_generic_class(c: HirClass) -> bool:
    """Check if a class has type parameters (see is_generic_function)."""
    val tps: [HirTypeParam] = c.type_params
    if tps == nil:
        return false
    tps.len() > 0

fn int_literal_type(suffix: text?, sp: Span) -> HirType:
    """Type of an integer literal: its suffix when written, i64 otherwise."""
    var bits = 64
    var signed = true
    match suffix:
        Some(s):
            val st: text = s
            if st == "i8": bits = 8
            elif st == "i16": bits = 16
            elif st == "i32": bits = 32
            elif st == "u8":
                bits = 8
                signed = false
            elif st == "u16":
                bits = 16
                signed = false
            elif st == "u32":
                bits = 32
                signed = false
            elif st == "u64":
                signed = false
        nil:
            pass_do_nothing("default i64")
    HirType(kind: HirTypeKind.Int(bits, signed), span: sp)

fn float_literal_type(suffix: text?, sp: Span) -> HirType:
    var bits = 64
    match suffix:
        Some(s):
            val st: text = s
            if st == "f32":
                bits = 32
        nil:
            pass_do_nothing("default f64")
    HirType(kind: HirTypeKind.Float(bits), span: sp)

fn hir_type_depth(ty: HirType) -> i64:
    """Nesting depth of a type (used to refuse polymorphic recursion)."""
    if ty == nil:
        return 0
    match ty.kind:
        case Array(elem, _): 1 + hir_type_depth(elem)
        case Slice(elem): 1 + hir_type_depth(elem)
        case Optional(inner): 1 + hir_type_depth(inner)
        case Isolated(inner): 1 + hir_type_depth(inner)
        case Ref(inner, _): 1 + hir_type_depth(inner)
        case Ptr(inner, _): 1 + hir_type_depth(inner)
        case Dict(k, v): 1 + max_i64(hir_type_depth(k), hir_type_depth(v))
        case Result(ok, err): 1 + max_i64(hir_type_depth(ok), hir_type_depth(err))
        case Tuple(elems): 1 + max_depth_of(elems)
        case Union(members): 1 + max_depth_of(members)
        case Named(_, args): 1 + max_depth_of(args)
        case Function(params, ret, _): 1 + max_i64(max_depth_of(params), hir_type_depth(ret))
        case Projection(base, _): 1 + hir_type_depth(base)
        case Tensor(elem, _, _): 1 + hir_type_depth(elem)
        case _: 1

fn max_i64(a: i64, b: i64) -> i64:
    if a > b: a else: b

fn max_depth_of(types: [HirType]) -> i64:
    var m = 0
    if types == nil:
        return 0
    for t in types:
        val tt: HirType = t
        val d = hir_type_depth(tt)
        if d > m:
            m = d
    m

fn hir_type_is_symbolic_evidence(ty: HirType) -> bool:
    # Unlike a display key, this admits formal parameters but never erased
    # Any/Error/Infer leaves as proof of an optional binding's provenance.
    if ty == nil: return false
    match ty.kind:
        case HirTypeKind.TypeParam(_, bounds): all_symbolic_evidence(bounds)
        case HirTypeKind.Named(_, args): all_symbolic_evidence(args)
        case HirTypeKind.Array(inner, _): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Slice(inner): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Optional(inner): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Isolated(inner): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Ref(inner, _): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Ptr(inner, _): hir_type_is_symbolic_evidence(inner)
        case HirTypeKind.Dict(key, value): hir_type_is_symbolic_evidence(key) and hir_type_is_symbolic_evidence(value)
        case HirTypeKind.Result(ok, err): hir_type_is_symbolic_evidence(ok) and hir_type_is_symbolic_evidence(err)
        case HirTypeKind.Tuple(items): all_symbolic_evidence(items)
        case HirTypeKind.Union(items): all_symbolic_evidence(items)
        case HirTypeKind.Function(params, returned, effects):
            # The shared structural comparator does not compare effects.
            # Such a function cannot prove this binding relation yet.
            effects.len() == 0 and all_symbolic_evidence(params) and hir_type_is_symbolic_evidence(returned)
        case HirTypeKind.Projection(base, _): hir_type_is_symbolic_evidence(base)
        case HirTypeKind.Tensor(inner, _, _): hir_type_is_symbolic_evidence(inner)
        case _: hir_type_is_concrete(ty)

fn all_symbolic_evidence(types: [HirType]) -> bool:
    for type_ in types:
        val item: HirType = type_
        if not hir_type_is_symbolic_evidence(item): return false
    true

fn mono_call_evidence_is_absent_v1(expr: HirExpr) -> bool:
    """Empty literals have no element evidence; later witnesses/defaults may fill it.
    Unknown expressions are not such a legitimate absence."""
    if expr == nil: return false
    match expr.kind:
        case HirExprKind.ArrayLit(elements, _): elements.len() == 0
        case HirExprKind.DictLit(entries, _, _): entries.len() == 0
        case _: false

fn mono_complete_default_args_v1(tps: [HirTypeParam], canonical_tps: [HirTypeParam], supplied: Dict<text, HirType>) -> Result<[HirType], text>:
    """Complete sparse bindings in declaration scope and declaration order.
    Supplied values win. Only earlier completed parameters can bind defaults.
    This bounded implementation refuses newly default-filled bounded parameters
    until actual trait-obligation validation is connected; explicit/inferred
    complete lists retain their existing prior bounds validation policy."""
    val canonical = typesubstitution_canonical(canonical_tps)
    var names: Dict<text, HirType> = {}
    var symbols: Dict<i64, HirType> = {}
    var completed: [HirType] = []
    for raw in tps:
        val parameter: HirTypeParam = raw
        if names.has(parameter.name):
            return Err("duplicate generic parameter `{parameter.name}`")
        var actual: HirType = nil
        if supplied.has(parameter.name):
            actual = supplied[parameter.name]
        else:
            if not parameter.has_default:
                return Err("missing required type argument `{parameter.name}`")
            if parameter.default == nil:
                return Err("default for `{parameter.name}` has no type payload")
            if parameter.bounds.len() > 0:
                return Err("default for bounded parameter `{parameter.name}` requires trait-obligation validation")
            # Canonicalizing this owner-authored payload recognizes both the
            # impl and method aliases without interpreting caller-local IDs.
            val declared = substitute_type(parameter.default, canonical)
            val bound = TypeSubstitution(mapping: names, by_symbol: symbols)
            actual = substitute_type(declared, bound)
        if not hir_type_is_concrete(actual):
            return Err("argument/default for `{parameter.name}` is unresolved, forward, cyclic or invalid")
        completed = completed.push(actual)
        names[parameter.name] = actual
        # Bind only symbols of completed parameters belonging to this owner.
        for alias_raw in canonical_tps:
            val alias: HirTypeParam = alias_raw
            if alias.name == parameter.name:
                symbols[alias.symbol.id] = actual
    Ok(completed)

fn hir_type_is_concrete(ty: HirType) -> bool:
    """True when no TypeParam / Infer / Error / Any occurs anywhere in `ty`.
    Only a fully concrete type may become a type argument."""
    if ty == nil:
        return false
    match ty.kind:
        case TypeParam(_, _): false
        case Infer(_, _): false
        case Error: false
        case Any: false
        case Array(elem, _): hir_type_is_concrete(elem)
        case Slice(elem): hir_type_is_concrete(elem)
        case Optional(inner): hir_type_is_concrete(inner)
        case Isolated(inner): hir_type_is_concrete(inner)
        case Ref(inner, _): hir_type_is_concrete(inner)
        case Ptr(inner, _): hir_type_is_concrete(inner)
        case Dict(k, v): hir_type_is_concrete(k) and hir_type_is_concrete(v)
        case Result(ok, err): hir_type_is_concrete(ok) and hir_type_is_concrete(err)
        case Tuple(elems): all_concrete(elems)
        case Union(members): all_concrete(members)
        case Named(_, args): all_concrete(args)
        case Function(params, ret, _): all_concrete(params) and hir_type_is_concrete(ret)
        case Projection(base, _): hir_type_is_concrete(base)
        case Tensor(elem, _, _): hir_type_is_concrete(elem)
        case _: true

fn hir_type_has_nominal(ty: HirType) -> bool:
    """True when `ty` names a declared type (`Named`, `DynTrait`) anywhere --
    the parts whose SymbolId is local to one module's table."""
    if ty == nil:
        return false
    match ty.kind:
        case Named(_, _): true
        case DynTrait(_): true
        case TypeParam(_, bounds): bounds.len() > 0
        case Array(elem, _): hir_type_has_nominal(elem)
        case Slice(elem): hir_type_has_nominal(elem)
        case Optional(inner): hir_type_has_nominal(inner)
        case Isolated(inner): hir_type_has_nominal(inner)
        case Ref(inner, _): hir_type_has_nominal(inner)
        case Ptr(inner, _): hir_type_has_nominal(inner)
        case Dict(k, v): hir_type_has_nominal(k) or hir_type_has_nominal(v)
        case Result(ok, err): hir_type_has_nominal(ok) or hir_type_has_nominal(err)
        case Tuple(elems): any_nominal(elems)
        case Union(members): any_nominal(members)
        case Function(params, ret, _): any_nominal(params) or hir_type_has_nominal(ret)
        case Projection(base, _): hir_type_has_nominal(base)
        case Tensor(elem, _, _): hir_type_has_nominal(elem)
        case _: false

fn any_nominal(types: [HirType]) -> bool:
    if types == nil:
        return false
    for t in types:
        val tt: HirType = t
        if hir_type_has_nominal(tt):
            return true
    false

fn binary_result_type(op: HirBinOp, left: HirType, right: HirType, sp: Span) -> HirType?:
    """Result type of a builtin binary operator on two KNOWN operand types.
    Only primitive operands answer: a user type may overload the operator,
    and mixed widths are the type checker's business, not a guess here."""
    val same = hir_type_key(left) == hir_type_key(right)
    var is_int = false
    var is_float = false
    var is_text = false
    var is_bool = false
    var is_char = false
    match left.kind:
        case HirTypeKind.Int(_, _):
            is_int = true
        case HirTypeKind.Float(_):
            is_float = true
        case HirTypeKind.Str:
            is_text = true
        case HirTypeKind.Bool:
            is_bool = true
        case HirTypeKind.Char:
            is_char = true
        case _: ()
    if not same:
        return nil
    # 1 = arithmetic on numbers (+ text for Add), 2 = integer-only,
    # 3 = comparison, 4 = logical.
    var family = 0
    var add = false
    match op:
        case HirBinOp.Add:
            family = 1
            add = true
        case HirBinOp.Sub:
            family = 1
        case HirBinOp.Mul:
            family = 1
        case HirBinOp.Div:
            family = 1
        case HirBinOp.Mod:
            family = 2
        case HirBinOp.BitAnd:
            family = 2
        case HirBinOp.BitOr:
            family = 2
        case HirBinOp.BitXor:
            family = 2
        case HirBinOp.Eq:
            family = 3
        case HirBinOp.NotEq:
            family = 3
        case HirBinOp.Lt:
            family = 3
        case HirBinOp.LtEq:
            family = 3
        case HirBinOp.Gt:
            family = 3
        case HirBinOp.GtEq:
            family = 3
        case HirBinOp.And:
            family = 4
        case HirBinOp.Or:
            family = 4
        case _: ()
    if family == 1:
        if is_int or is_float or (add and is_text):
            return left
    if family == 2:
        if is_int:
            return left
    if family == 3:
        if is_int or is_float or is_text or is_bool or is_char:
            return HirType(kind: HirTypeKind.Bool, span: sp)
    if family == 4:
        if is_bool:
            return left
    no_local_type_answer()

fn unary_result_type(op: HirUnaryOp, operand: HirType) -> HirType?:
    match op:
        case HirUnaryOp.Neg:
            match operand.kind:
                case HirTypeKind.Int(_, _): operand
                case HirTypeKind.Float(_): operand
                case _: nil
        case HirUnaryOp.Not:
            match operand.kind:
                case HirTypeKind.Bool: operand
                case _: nil
        case _:
            no_local_type_answer()

fn all_concrete(types: [HirType]) -> bool:
    if types == nil:
        return true
    for t in types:
        val tt: HirType = t
        if not hir_type_is_concrete(tt):
            return false
    true

fn hir_type_key(ty: HirType) -> text:
    """Structural rendering used to compare two inferred bindings of the same
    type parameter: every constructor is named and delimited at every depth,
    so two types are equal exactly when their keys are (array sizes and
    function effects aside, as in the mangling). The engine's mangling is
    used for the scalar leaves only -- it spells `Result`/`Slice`/`Ref`/a
    function type as `unknown`, which made `[Result<i64, E>]` and
    `[Result<bool, E>]` agree."""
    if ty == nil:
        return "<nil>"
    match ty.kind:
        case Array(elem, _): "[{hir_type_key(elem)}]"
        case Slice(elem): "slice<{hir_type_key(elem)}>"
        case Optional(inner): "opt<{hir_type_key(inner)}>"
        case Isolated(inner): "iso<{hir_type_key(inner)}>"
        case Ref(inner, m): "ref{m}<{hir_type_key(inner)}>"
        case Ptr(inner, m): "ptr{m}<{hir_type_key(inner)}>"
        case Dict(k, v): "dict<{hir_type_key(k)},{hir_type_key(v)}>"
        case Result(ok, err): "res<{hir_type_key(ok)},{hir_type_key(err)}>"
        case Tuple(elems): "({hir_type_keys(elems)})"
        case Union(members): "union<{hir_type_keys(members)}>"
        case Named(sym, args):
            if args.len() == 0:
                return "T{sym.id}"
            "T{sym.id}<{hir_type_keys(args)}>"
        case Function(params, ret, _): "fn({hir_type_keys(params)})->{hir_type_key(ret)}"
        case Projection(base, assoc): "proj<{hir_type_key(base)}>::{assoc}"
        case DynTrait(sym): "dyn_{sym.id}"
        case Tensor(elem, dims, _): "tensor<{hir_type_key(elem)};{dims.len()}>"
        case _: mangle_type(ty)

fn hir_type_keys(types: [HirType]) -> text:
    var parts: [text] = []
    for raw in types:
        val t: HirType = raw
        parts = parts.push(hir_type_key(t))
    parts.join(",")

fn bind_type_params(param_ty: HirType, arg_ty: HirType, bindings: Dict<text, HirType>, nominal_context: NominalBindingContext? = nil) -> bool:
    """Structurally unify a declared parameter type against an argument type,
    binding every `TypeParam` met on the parameter side.

    Returns false on a conflicting binding or a shape mismatch that involves
    a type parameter; shapes that carry no type parameter are not checked
    here (that is the type checker's job), so they always succeed."""
    if param_ty == nil or arg_ty == nil:
        return true
    match param_ty.kind:
        case TypeParam(name, _):
            # A partially-known argument (`Err(e)` types as Result<?, E>)
            # carries no evidence for this parameter: bind nothing rather
            # than poison the binding and reject a later concrete witness.
            if not hir_type_is_concrete(arg_ty):
                return true
            var argument_key = ""
            if val context = nominal_context:
                argument_key = mono_owned_type_key(arg_ty, context.argument_symbols, context.argument_module)
                if argument_key == "":
                    return false
            if bindings.has(name):
                val prev: HirType = bindings[name]
                if val context = nominal_context:
                    val previous_key = mono_owned_type_key(prev, context.argument_symbols, context.argument_module)
                    return previous_key != "" and previous_key == argument_key
                return hir_type_key(prev) == hir_type_key(arg_ty)
            bindings[name] = arg_ty
            true
        case Array(pe, _):
            match arg_ty.kind:
                case Array(ae, _): bind_type_params(pe, ae, bindings, nominal_context)
                case _: false
        case Slice(pe):
            match arg_ty.kind:
                case Slice(ae): bind_type_params(pe, ae, bindings, nominal_context)
                case Array(ae2, _): bind_type_params(pe, ae2, bindings, nominal_context)
                case _: false
        case Optional(pi):
            match arg_ty.kind:
                case Optional(ai): bind_type_params(pi, ai, bindings, nominal_context)
                case _: false
        case Isolated(pi):
            match arg_ty.kind:
                case Isolated(ai): bind_type_params(pi, ai, bindings, nominal_context)
                case _: false
        case Ref(pi, _):
            match arg_ty.kind:
                case Ref(ai, _): bind_type_params(pi, ai, bindings, nominal_context)
                case _: false
        case Ptr(pi, _):
            match arg_ty.kind:
                case Ptr(ai, _): bind_type_params(pi, ai, bindings, nominal_context)
                case _: false
        case Dict(pk, pv):
            match arg_ty.kind:
                case Dict(ak, av): bind_type_params(pk, ak, bindings, nominal_context) and bind_type_params(pv, av, bindings, nominal_context)
                case _: false
        case Result(po, pe2):
            match arg_ty.kind:
                case Result(ao, ae3): bind_type_params(po, ao, bindings, nominal_context) and bind_type_params(pe2, ae3, bindings, nominal_context)
                case _: false
        case Tuple(pes):
            match arg_ty.kind:
                case Tuple(aes): bind_type_lists(pes, aes, bindings, nominal_context)
                case _: false
        case Union(pms):
            match arg_ty.kind:
                case Union(ams): bind_type_lists(pms, ams, bindings, nominal_context)
                case _: false
        case Named(psym, pargs):
            # The context-free API is for a single-table model. Production
            # also validates the declaration owner of fixed nominal types.
            if pargs.len() == 0 and nominal_context == nil:
                return true
            match arg_ty.kind:
                case Named(asym, aargs):
                    if val context = nominal_context:
                        val pattern_identity = mono_type_identity(context.pattern_symbols, psym, context.pattern_module)
                        val argument_identity = mono_type_identity(context.argument_symbols, asym, context.argument_module)
                        if pattern_identity == "" or argument_identity == "" or pattern_identity != argument_identity:
                            return false
                    elif psym.id != asym.id:
                        return false
                    if pargs.len() == 0:
                        return true
                    bind_type_lists(pargs, aargs, bindings, nominal_context)
                case _: false
        case Function(pps, pr, _):
            match arg_ty.kind:
                case Function(aps, ar, _): bind_type_lists(pps, aps, bindings, nominal_context) and bind_type_params(pr, ar, bindings, nominal_context)
                case _: false
        case Projection(pb, _):
            match arg_ty.kind:
                case Projection(ab, _): bind_type_params(pb, ab, bindings, nominal_context)
                case _: false
        case Tensor(pe3, _, _):
            match arg_ty.kind:
                case Tensor(ae4, _, _): bind_type_params(pe3, ae4, bindings, nominal_context)
                case _: false
        case _:
            true

fn bind_type_lists(ps: [HirType], as_: [HirType], bindings: Dict<text, HirType>, nominal_context: NominalBindingContext? = nil) -> bool:
    if ps == nil or as_ == nil:
        return true
    if ps.len() != as_.len():
        return false
    var i = 0
    while i < ps.len():
        val p: HirType = ps[i]
        val a: HirType = as_[i]
        if not bind_type_params(p, a, bindings, nominal_context):
            return false
        i = i + 1
    true

# ============================================================================
# Pipeline Integration
# ============================================================================

fn hir_type_to_concrete(ty: HirType) -> ConcreteType:
    """Convert a HirType to ConcreteType for monomorphization."""
    match ty.kind:
        case Int(_, _): ConcreteType.Int
        case Float(_): ConcreteType.Float
        case Bool: ConcreteType.Bool
        case Str: ConcreteType.String
        case Unit: ConcreteType.Nil
        case Named(sym, args):
            if args.?:
                var concrete_args: [ConcreteType] = []
                for arg in args:
                    concrete_args.push(hir_type_to_concrete(arg))
                ConcreteType.Specialized("sym_{sym}", concrete_args)
            else:
                concretetype_Named("sym_{sym}")
        case Array(elem, _):
            ConcreteType.Array(hir_type_to_concrete(elem))
        case Tuple(elems):
            var concrete_elems: [ConcreteType] = []
            for e in elems:
                concrete_elems.push(hir_type_to_concrete(e))
            ConcreteType.Tuple(concrete_elems)
        case Optional(inner):
            ConcreteType.Optional(hir_type_to_concrete(inner))
        case _:
            concretetype_Named("unknown")

# §11.6 (critical wildcard ban): `infer_expr_type` and `callee_return_type` are
# deliberately PARTIAL — they answer only for expression shapes whose type is
# locally decidable without a full inference run. The absent answer is NOT a
# silent fallback: every caller fails CLOSED on it
# (`infer_type_args_from_args` returns [], the call site is left unspecialized,
# and the pass reports E-MONO-032 loudly). This named helper exists so the
# wildcard arm states that contract instead of spelling a bare `nil`.
fn no_local_type_answer() -> HirType?:
    nil

# §11.6 (critical wildcard ban): `constructor_type` asks one narrow question —
# "is this callee the NamedVar of a struct/class constructor?". HIR lowers a
# constructor call as a plain Call over NamedVar, so every OTHER callee shape
# (FieldAccess, MethodCall, Index, Lambda, ...) is NOT-APPLICABLE, not
# unhandled. The absence is consumed explicitly: the single caller
# (`infer_expr_type`) tests `ctor != nil` and falls through to
# `callee_return_type`, so nothing is silently zeroed. This named helper exists
# so the wildcard arm states that contract instead of spelling a bare `nil`.
fn not_a_constructor_call() -> HirType?:
    nil

fn run_monomorphization(modules: Dict<text, HirModule>) -> (Dict<text, HirModule>, MonoStats):
    """Run monomorphization pass on all modules.

    This is the main entry point for the driver to call.

    Returns:
        - Modified modules with specialized definitions
        - Statistics about the pass
    """
    var pass_ = MonomorphizationPass.create()
    val result = pass_.process_modules(modules)
    (result, pass_.get_stats())

fn run_monomorphization_with_diagnostics(modules: Dict<text, HirModule>) -> (Dict<text, HirModule>, MonoStats, [text]):
    """As `run_monomorphization`, additionally returning the loud diagnostics
    for every generic call site the pass could not rewrite. A non-empty list
    means the output is NOT monomorphic and must not reach canonical MIR."""
    var pass_ = MonomorphizationPass.create()
    val result = pass_.process_modules(modules)
    (result, pass_.get_stats(), pass_.diagnostics)

fn run_monomorphization_with_report(modules: Dict<text, HirModule>) -> (Dict<text, HirModule>, MonoStats, [text], [text]):
    """As `run_monomorphization_with_diagnostics`, plus the diagnostics whose
    level resolved to `warning` (fourth element). Errors gate the build;
    warnings are for the driver to print."""
    var pass_ = MonomorphizationPass.create()
    val result = pass_.process_modules(modules)
    (result, pass_.get_stats(), pass_.diagnostics, pass_.warnings)

# Levels of the diagnostics that may be met in code that compiles today.
# `SIMPLE_MONO_LEVELS="E-MONO-034=error,E-MONO-040=off"` overrides per code
# (error | warning | off). Every other E-MONO code is always an error.
#   E-MONO-034  default warning: method of a generic impl not specializable
#               for a known receiver (trait impl, own type parameters, ...).
#   E-MONO-040  default warning: container field over a type parameter read
#               from a receiver of unknown instance type.
fn mono_diag_level(code: text) -> text:
    var level = "error"
    if code == "E-MONO-034" or code == "E-MONO-040" or code == "E-MONO-036":
        # E-MONO-036: an erased-bridge default (erased arg, Optional-return
        # bridge, or return-only param) that monomorphized to the word
        # representation. The specialization EXISTS; the site is recorded so
        # the defaulting stays visible, but it does not block the build.
        level = "warning"
    else:
        return level
    val raw = env_get("SIMPLE_MONO_LEVELS")
    if raw == nil or raw == "":
        return level
    val spec: text = raw
    for entry in spec.split(","):
        val e: text = entry
        val parts = e.split("=")
        if parts.len() == 2:
            val name: text = parts[0]
            val wanted: text = parts[1]
            if name.trim() == code:
                val w = wanted.trim()
                if w == "error" or w == "warning" or w == "off":
                    level = w
    level

# Level-gated probe (default off): SIMPLE_MONO_DIAG=1 traces every function,
# statement and expression the pass visits and every argument it could not
# type, so a "call_sites=0" receipt can be explained from a log.
fn mono_payload_key_suffix(key: text) -> text:
    """`"<Enum>::<Variant>::<slot>"` -> `"::<Variant>::<slot>"`."""
    val i = key.index_of("::")
    if i < 0:
        return key
    key.substring(i, key.len())

fn mono_diag_enabled() -> bool:
    env_get("SIMPLE_MONO_DIAG") == "1"

fn mono_sym_key(module_name: text, sym_id: i64) -> text:
    "{module_name}#{sym_id}"

fn mono_last_segment(name: text) -> text:
    if not name.contains("."):
        return name
    val parts = name.split(".")
    parts[parts.len() - 1]

# `qual` is the caller's import spelling of the module (logical path from the
# source root); the template module key may be spelled by the driver with a
# longer prefix. Accept equality or a dotted-suffix relation either way.
fn mono_module_matches(qual: text, template_mod: text) -> bool:
    if qual == template_mod:
        return true
    if template_mod.ends_with(".{qual}"):
        return true
    qual.ends_with(".{template_mod}")

fn mono_type_identity(symbols: SymbolTable, sym: SymbolId, module_name: text) -> text:
    """Ownership identity `<owner module>.<Name>` of a type symbol, read in
    the table that minted `sym` (the same spelling MIR's mir_class_identity
    uses). "" when the table has no such symbol."""
    if val info = symbols.get_symbol_raw(sym.id):
        var owner = info.defining_module ?? ""
        if owner == "":
            owner = module_name
        return "{hir_symbol_owner_module(owner)}.{info.name}"
    ""

fn mono_impl_target_is_canonical(target_args: [HirType], impl_tps: [HirTypeParam]) -> bool:
    """True when an impl's target is exactly its own type parameters in
    order (`impl<A, B> Pair<A, B>`), so a receiver's type arguments bind them
    positionally. `impl Box<Option<T>>` and `impl<A, B> Pair<B, A>` are not.

    The parser leaves a positional target ARGLESS and records every other
    generic inherent target with an argument list
    (parser_decls_use.spl `impl_target_binds_positionally`), so an empty list
    is the positional case; a non-empty one must still spell the parameters."""
    if target_args.len() == 0:
        return true
    if target_args.len() != impl_tps.len():
        return false
    var i = 0
    while i < target_args.len():
        val arg: HirType = target_args[i]
        val tp: HirTypeParam = impl_tps[i]
        var matches = false
        match arg.kind:
            case HirTypeKind.TypeParam(arg_name, _):
                matches = arg_name == tp.name
            case HirTypeKind.Named(arg_sym, arg_args):
                val tp_sym: SymbolId = tp.symbol
                matches = arg_args.len() == 0 and arg_sym.id == tp_sym.id
            case _: ()
        if not matches:
            return false
        i = i + 1
    true
