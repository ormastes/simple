# Post-monomorphization invariant verifier (hardening plan agent M7).
#
# Implements the section 9.5 invariant set of
# doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md.
# Every counter must be zero before canonical MIR lowering; a non-zero counter
# carries the offending symbol and the instantiation chain so the driver can
# emit the section 17.5 `E-MONO-031` diagnostic.
#
# WIRING (the integrator, not this agent, makes the edit):
#   src/compiler/80.driver/driver_hir_pipeline_passes.spl,
#   `CompilerDriver.monomorphize_impl`, immediately after
#       val (mono_modules, mono_stats) = run_monomorphization(...)
#       self.ctx.hir_modules = mono_modules
#   call `post_mono_verify(module)` for every module in `mono_modules` (or
#   `post_mono_verify_modules(mono_modules)`) and fail the critical build when
#   `post_mono_report_is_clean(report)` is false.
#
# This module is READ-ONLY with respect to the mono pass: it never mutates HIR.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection

# Bound transport diagnostics independently of the invariant count. A broken
# aggregate boundary can affect every type in a full compiler closure; emitting
# one line/violation per node hid the first useful owner and added tens of
# thousands of allocations to the already-failing path.
val POST_MONO_TRANSPORT_RECEIPT_LIMIT: i64 = 16

# ============================================================================
# Report model
# ============================================================================

struct MonoViolation:
    """One offending site behind a non-zero section 9.5 counter."""
    counter: text
    symbol: text
    detail: text
    chain: text
    # Diagnostic code this violation renders under. The section 9.5 counters
    # all render as E-MONO-031; the symbol-identity invariants below carry
    # their own codes (E-MONO-035..038).
    code: text

struct PostMonoReport:
    """Section 9.5 post-monomorphization invariant counters.

    Critical compilation fails unless every counter is zero."""
    unresolved_type_param: i64
    generic_call: i64
    generic_ctor: i64
    generic_method: i64
    generic_emitted_definition: i64
    any_erasure: i64
    error_from_substitution: i64
    unknown_mangling: i64
    unresolved_projection: i64
    # Fail-closed guard: a HIR variant this walker does not name explicitly.
    unreachable_variant: i64
    # E-MONO-035: a specialization SymbolId that a module's symbol table
    # already binds to another symbol (`walk$i64` named `walker_abi.C` after
    # the caller's type parameter), or that was not allocated past the table.
    # doc/08_tracking/bug/mono_specialization_symbol_id_collision_2026-10-10.md
    symbol_id_collision: i64
    # E-MONO-036: a call whose callee still binds a generic TEMPLATE that has
    # no emitted definition in the callee's module (pruned, or owned by
    # another module), so it would fail at link instead of here.
    unemitted_template_call: i64
    # E-MONO-037: the same specialization key (mangled name) emitted twice
    # across the closure.
    duplicate_specialization_key: i64
    # E-MONO-038: devirtualized trait-object MIR in a module that gets
    # archived (verifier-side twin of driver_trait_devirtualization_allowed_v1).
    archived_devirtualization: i64
    violations: [MonoViolation]

fn post_mono_report_empty() -> PostMonoReport:
    PostMonoReport(
        unresolved_type_param: 0,
        generic_call: 0,
        generic_ctor: 0,
        generic_method: 0,
        generic_emitted_definition: 0,
        any_erasure: 0,
        error_from_substitution: 0,
        unknown_mangling: 0,
        unresolved_projection: 0,
        unreachable_variant: 0,
        symbol_id_collision: 0,
        unemitted_template_call: 0,
        duplicate_specialization_key: 0,
        archived_devirtualization: 0,
        violations: []
    )

fn post_mono_report_total(r: PostMonoReport) -> i64:
    """Sum of every section 9.5 counter. Zero means the module is monomorphic."""
    (r.unresolved_type_param + r.generic_call + r.generic_ctor
     + r.generic_method + r.generic_emitted_definition + r.any_erasure
     + r.error_from_substitution + r.unknown_mangling
     + r.unresolved_projection + r.unreachable_variant
     + r.symbol_id_collision + r.unemitted_template_call
     + r.duplicate_specialization_key + r.archived_devirtualization)

fn post_mono_report_is_clean(r: PostMonoReport) -> bool:
    post_mono_report_total(r) == 0

fn post_mono_report_diagnostics(r: PostMonoReport) -> [text]:
    """Render each violation as a section 17.5 diagnostic under its own code
    (`E-MONO-031` for the section 9.5 counters, `E-MONO-035..038` for the
    symbol-identity invariants)."""
    var out: [text] = []
    for v in r.violations:
        val vt: MonoViolation = v
        val code: text = vt.code ?? ""
        val rendered_code = if code == "": "E-MONO-031" else: code
        out = out.push(
            "{rendered_code}:\n{vt.counter}: {vt.detail}\n\ndefinition:\n  {vt.symbol}\n\ninstantiation chain:\n  {vt.chain}\n\nno MIR or object file was emitted."
        )
    out

fn post_mono_span_text(span: Span) -> text:
    """`file:line:col` for a call-site diagnostic; empty parts are omitted."""
    if span == nil:
        return "<no span>"
    val file: text = span.file ?? ""
    if file == "":
        return "{span.line}:{span.col}"
    "{file}:{span.line}:{span.col}"

fn post_mono_archive_admission_v1(module_name: text, devirtualized_calls: i64, archive_producing: bool) -> text?:
    """E-MONO-038 when a module that will be ARCHIVED carries devirtualized
    trait-object calls.

    Verifier-side twin of `driver_trait_devirtualization_allowed_v1`
    (80.driver/driver_pipeline_lowering.spl): the driver gate decides whether
    MirLowering MAY devirtualize; this assertion checks, after lowering, that
    no archive-bound MIR actually did. An archived consumer is never
    invalidated when another package later adds an implementor, so a
    devirtualized direct call baked into it would silently miscall.
    Returns nil when admissible."""
    if not archive_producing:
        return nil
    if devirtualized_calls <= 0:
        return nil
    Some("E-MONO-038:\narchived devirtualization: module `{module_name}` lowered {devirtualized_calls} devirtualized trait-object call(s) in an archive-producing lane\n\ndefinition:\n  {module_name}\n\ninstantiation chain:\n  driver_trait_devirtualization_allowed_v1 must be false for this lane\n\nno MIR or object file was emitted.")

fn post_mono_specialization_manifest(modules: Dict<text, HirModule>) -> [text]:
    """Sorted `module\\tmangled\\tsymbol_id` rows for every specialization in
    the closure. Two runs of the mono pass over the same input must produce
    byte-identical manifests (E-MONO-037 determinism half)."""
    var rows: [text] = []
    if modules == nil:
        return rows
    for key in modules.keys():
        val m: HirModule = modules[key]
        if m == nil:
            continue
        for fkey in m.functions.keys():
            val f: HirFunction = m.functions[fkey]
            val fname: text = f.name ?? ""
            if fname.contains("$"):
                val fs: SymbolId = f.symbol
                rows = rows.push("{m.name}\t{fname}\t{fs.id}")
    rows.sort()

fn unreachable_variant(enum_name: text, where_: text) -> text:
    """A HIR variant reached the verifier that this walker does not name.

    The walker below is written WITHOUT a semantic wildcard arm on purpose: a
    new `HirTypeKind`/`HirExprKind`/`HirStmtKind` variant must be noticed. The
    seed's match checker still demands a trailing `case _`, so that arm routes
    here and is recorded as the fail-closed `unreachable_variant` counter
    rather than being silently ignored."""
    print "[post-mono-verify] unhandled {enum_name} variant at {where_}"
    "{enum_name}@{where_}"

# ============================================================================
# Verifier
# ============================================================================

class PostMonoVerifier:
    """Exhaustive post-mono walker over one HirModule."""
    r: PostMonoReport
    symbol: text
    chain: text
    in_specialization: bool
    # Symbol id -> name of every function in the module under verification
    # that is still a generic TEMPLATE. A call whose callee names one of these
    # is a generic call even with EMPTY type args (the inferred-argument form
    # the mono pass failed to rewrite).
    template_syms: Dict<i64, text>
    transport_receipts: i64
    # ---- closure-wide index (filled by index_closure before any module walk)
    # Specialization SymbolId -> mangled name, over EVERY module. The mono
    # pass hands out specialization ids from one process-wide counter, so an
    # id is a specialization in every module it appears in.
    spec_ids: Dict<i64, text>
    # "<module>.<template name>" -> true for every generic template in the
    # closure: those still emitted (type_params / is_generic_template) and
    # those PRUNED after specialization (recovered from the `$` prefix of each
    # specialization placed in the template's module).
    template_keys: Dict<text, bool>
    # ---- per-module state (set by verify_module)
    cur_module: text
    cur_symbols: SymbolTable
    # Symbol ids that own a HirFunction in the module under verification.
    cur_fn_ids: Dict<i64, bool>

    static fn create() -> PostMonoVerifier:
        PostMonoVerifier(
            r: post_mono_report_empty(),
            symbol: "",
            chain: "",
            in_specialization: false,
            template_syms: {},
            transport_receipts: 0,
            spec_ids: {},
            template_keys: {},
            cur_module: "",
            cur_symbols: nil,
            cur_fn_ids: {}
        )

    me record(counter: text, detail: text):
        self.record_coded("E-MONO-031", counter, detail)

    me record_coded(code: text, counter: text, detail: text):
        var v = self.r.violations
        v = v.push(MonoViolation(
            counter: counter, symbol: self.symbol,
            detail: detail, chain: self.chain, code: code))
        self.r.violations = v

    # ------------------------------------------------------------------
    # Symbol-identity invariants (E-MONO-035..037)
    # ------------------------------------------------------------------
    me index_closure(modules: Dict<text, HirModule>):
        """Collect every specialization id and every template key across the
        closure. Also counts E-MONO-037 duplicate specialization keys: the
        same mangled name emitted twice (in one module or across modules)."""
        self.spec_ids = {}
        self.template_keys = {}
        var seen_keys: Dict<text, text> = {}
        if modules == nil:
            return
        for key in modules.keys():
            val m: HirModule = modules[key]
            if m == nil:
                continue
            val mname: text = m.name ?? ""
            for fkey in m.functions.keys():
                val f: HirFunction = m.functions[fkey]
                val fname: text = f.name ?? ""
                val fs: SymbolId = f.symbol
                if self.is_template(f.type_params, f.is_generic_template):
                    # A generic CLASS's method is `is_generic_template` under
                    # its bare method name (`ready`, `pending`, `get`); keying
                    # it here made a cross-module call to a non-generic FREE
                    # function of the same name an E-MONO-036 (real instance:
                    # std.nogc_async_mut.async_embedded `ready`/`pending`).
                    # Method templates are reached through a receiver, never
                    # through a bare callee symbol, so they are not candidates.
                    if not f.is_method:
                        self.template_keys["{mname}.{fname}"] = true
                    continue
                if not fname.contains("$"):
                    continue
                # A specialization lives in its template's module, so the
                # `$` prefix names a template of THIS module (pruned or not).
                self.template_keys["{mname}.{fname.split("$")[0]}"] = true
                if seen_keys.has(fname):
                    self.symbol = "{mname}.{fname}"
                    self.chain = "first emitted in {seen_keys[fname]}"
                    self.r.duplicate_specialization_key = self.r.duplicate_specialization_key + 1
                    self.record_coded("E-MONO-037", "duplicate specialization key",
                        "specialization key `{fname}` is emitted more than once (first in {seen_keys[fname]}, again in {mname})")
                else:
                    seen_keys[fname] = mname
                self.spec_ids[fs.id] = fname

    me table_symbol_name(sid: i64) -> text?:
        """Name the module symbol table binds to `sid`, if any."""
        if self.cur_symbols == nil:
            return nil
        val table: Dict<i64, HirSymbol> = self.cur_symbols.symbols
        if table == nil:
            return nil
        if not table.has(sid):
            return nil
        val hs: HirSymbol = table[sid]
        if hs == nil:
            return nil
        Some(hs.name ?? "")

    me table_symbol_is_callable(sid: i64) -> bool:
        if self.cur_symbols == nil:
            return false
        val table: Dict<i64, HirSymbol> = self.cur_symbols.symbols
        if table == nil:
            return false
        if not table.has(sid):
            return false
        val hs: HirSymbol = table[sid]
        if hs == nil:
            return false
        match hs.kind:
            case SymbolKind.Function: true
            case SymbolKind.Method: true
            case _: false

    me check_specialization_symbol(f: HirFunction):
        """E-MONO-035 at the DEFINITION: a specialization's id must be unused
        by the module table (allocated past its max id — true for both the
        `next_symbol_id`-seeded allocator and a fixed high-range base) or, if
        the table knows it, bound to a Function/Method of the same name."""
        val fs: SymbolId = f.symbol
        val sid: i64 = fs.id
        val fname: text = f.name ?? ""
        match self.table_symbol_name(sid):
            Some(bound):
                val bound_name: text = bound
                if bound_name != fname or not self.table_symbol_is_callable(sid):
                    self.r.symbol_id_collision = self.r.symbol_id_collision + 1
                    self.record_coded("E-MONO-035", "specialization symbol id collision",
                        "specialization `{fname}` was allocated SymbolId {sid}, which module `{self.cur_module}`'s symbol table already binds to `{bound_name}`; specialization ids must be allocated past the table's max id")
            nil:
                if self.cur_symbols != nil:
                    if sid < self.cur_symbols.next_symbol_id:
                        self.r.symbol_id_collision = self.r.symbol_id_collision + 1
                        self.record_coded("E-MONO-035", "specialization symbol id not past table",
                            "specialization `{fname}` was allocated SymbolId {sid} below module `{self.cur_module}`'s next free symbol id {self.cur_symbols.next_symbol_id}; a later definition in this module can alias it")

    me check_callee_identity(sid: i64, site: Span):
        """E-MONO-035 at a CALL SITE: the callee id is a specialization but the
        CALLER's table binds that id to something else (the `walk$i64` ->
        `walker_abi.C` shape, where the caller's type parameter `C` owned the
        id). E-MONO-036: the callee id owns no function in this module and
        the table says it is a generic template of the closure."""
        if self.spec_ids.has(sid):
            val spec_name: text = self.spec_ids[sid]
            match self.table_symbol_name(sid):
                Some(bound):
                    val bound_name: text = bound
                    if bound_name != spec_name:
                        self.r.symbol_id_collision = self.r.symbol_id_collision + 1
                        self.record_coded("E-MONO-035", "specialization symbol id collision",
                            "call at {post_mono_span_text(site)} targets specialization `{spec_name}` through SymbolId {sid}, which module `{self.cur_module}`'s symbol table binds to `{bound_name}`; MIR would name the callee after that symbol")
                nil:
                    pass_do_nothing("id is free in the caller's table")
            return
        if self.cur_fn_ids.has(sid):
            return
        match self.table_symbol_name(sid):
            Some(bound):
                val callee_name: text = bound
                if not self.table_symbol_is_callable(sid):
                    return
                var owner: text = self.cur_module
                val table: Dict<i64, HirSymbol> = self.cur_symbols.symbols
                val hs: HirSymbol = table[sid]
                if val dm = hs.defining_module:
                    val dmt: text = dm
                    if dmt != "":
                        owner = dmt
                if self.template_keys.has("{owner}.{callee_name}"):
                    self.r.unemitted_template_call = self.r.unemitted_template_call + 1
                    self.record_coded("E-MONO-036", "call to un-emitted generic template",
                        "call at {post_mono_span_text(site)} still binds generic template `{owner}.{callee_name}` (SymbolId {sid}), which has no emitted definition; type arguments were neither written nor inferred, and the link would fail on the template symbol")
            nil:
                pass_do_nothing("unknown callee id is not a template")

    me hit_type_param(name: text):
        self.r.unresolved_type_param = self.r.unresolved_type_param + 1
        self.record("unresolved TypeParam", "type parameter `{name}` reached the post-monomorphization verifier")

    me hit_projection(assoc: text):
        self.r.unresolved_projection = self.r.unresolved_projection + 1
        self.record("unresolved associated projection", "projection `.{assoc}` was never resolved")

    me hit_any(where_: text):
        # `Any` is only an erasure defect when it appears INSIDE a
        # specialization (a name carrying the `$` mangling separator): that is
        # the only place monomorphization itself can have introduced it.
        if self.in_specialization:
            self.r.any_erasure = self.r.any_erasure + 1
            self.record("Any introduced as generic erasure", "`Any` at {where_} in a specialized definition")

    me hit_error_type(where_: text):
        if self.in_specialization:
            self.r.error_from_substitution = self.r.error_from_substitution + 1
            self.record("HirTypeKind.Error created by substitution", "`Error` type at {where_} in a specialized definition")

    me hit_unreachable(enum_name: text, where_: text):
        self.r.unreachable_variant = self.r.unreachable_variant + 1
        if self.transport_receipts < POST_MONO_TRANSPORT_RECEIPT_LIMIT:
            self.transport_receipts = self.transport_receipts + 1
            self.record("unhandled HIR variant", unreachable_variant(enum_name, where_))

    # ------------------------------------------------------------------
    # Types — every HirTypeKind variant is owner-qualified and named. Covered (27):
    # Int Float Bool Char Str Unit Tuple Array Slice Dict Ref Ptr Optional
    # Result Named TypeParam Union DynTrait Function Projection Isolated
    # Infer Error Never Any Tensor Layer
    # Keep owner qualification for source-level disambiguation: this module
    # imports several HIR enums with colliding variant names. Qualification is
    # not an aggregate-transport repair; a malformed value still reaches the
    # bounded wildcard receipt below.
    # ------------------------------------------------------------------
    me walk_type_kind(kind: HirTypeKind):
        """Walk one HIR type kind without transporting its enclosing HirType.

        Stage-2 native ABI aggregate passing can zero the `kind` field of a
        `HirType` argument (the MIR lowering owner keeps the same data local
        for this reason).  Every caller therefore projects `.kind` while the
        owning HIR aggregate is still local, and this dispatcher receives only
        the enum required for the exhaustive check.  Do not add a successful
        fallback here: unknown tags remain an E-MONO-031 receipt.

        `PostMonoVerifier` is exported for report construction, but no
        production caller invokes its walker methods directly.  In particular,
        do not restore a `walk_type(HirType)` compatibility wrapper: that
        signature is the failing Stage-2 aggregate boundary itself.
        """
        match kind:
            case HirTypeKind.Int(_, _): pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Float(_): pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Bool: pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Char: pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Str: pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Unit: pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Never: pass_do_nothing("monomorphic primitive")
            case HirTypeKind.Tuple(elements): self.walk_type_kinds(elements)
            case HirTypeKind.Array(element, _):
                if element != nil: self.walk_type_kind(element.kind)
            case HirTypeKind.Slice(element):
                if element != nil: self.walk_type_kind(element.kind)
            case HirTypeKind.Dict(key, value):
                if key != nil: self.walk_type_kind(key.kind)
                if value != nil: self.walk_type_kind(value.kind)
            case HirTypeKind.Ref(inner, _):
                if inner != nil: self.walk_type_kind(inner.kind)
            case HirTypeKind.Ptr(inner, _):
                if inner != nil: self.walk_type_kind(inner.kind)
            case HirTypeKind.Optional(inner):
                if inner != nil: self.walk_type_kind(inner.kind)
            case HirTypeKind.Result(ok, err):
                if ok != nil: self.walk_type_kind(ok.kind)
                if err != nil: self.walk_type_kind(err.kind)
            case HirTypeKind.Named(_, args): self.walk_type_kinds(args)
            case HirTypeKind.TypeParam(name, bounds):
                self.hit_type_param(name)
                self.walk_type_kinds(bounds)
            case HirTypeKind.Union(members): self.walk_type_kinds(members)
            case HirTypeKind.DynTrait(_): pass_do_nothing("dyn trait is not a generic residue")
            case HirTypeKind.Function(params, ret, _):
                self.walk_type_kinds(params)
                if ret != nil: self.walk_type_kind(ret.kind)
            case HirTypeKind.Projection(base, assoc_name):
                self.hit_projection(assoc_name)
                if base != nil: self.walk_type_kind(base.kind)
            case HirTypeKind.Isolated(inner):
                if inner != nil: self.walk_type_kind(inner.kind)
            case HirTypeKind.Infer(_, _): pass_do_nothing("inference variable is a typecheck concern")
            case HirTypeKind.Error: self.hit_error_type("type position")
            case HirTypeKind.Any: self.hit_any("type position")
            case HirTypeKind.Tensor(element, _, _):
                if element != nil: self.walk_type_kind(element.kind)
            case HirTypeKind.Layer(_, _): pass_do_nothing("layer dims carry no HirType")
            case _:
                # The value reaching this arm is already malformed. Do not
                # inspect its kind payload or span while reporting the fault:
                # either access adds another unsafe aggregate dereference and
                # can hide the original transport defect behind a crash.
                if self.transport_receipts < POST_MONO_TRANSPORT_RECEIPT_LIMIT:
                    # MEASURED 2026-09-04 (aarch64-unknown-linux-gnu Stage 3):
                    # the single interpolated line that used to stand here was
                    # NOT swallowed -- it ran and rendered as an EMPTY line.
                    # The worker stderr holds exactly 16 blank lines in the
                    # whole 483 KB file, strictly alternating 1:1 with the 16
                    # `[post-mono-verify]` reports and bounded by `[mono]` and
                    # `phase4:monomorphize:done`. So the arm executes and the
                    # FORMATTED STRING collapses. A literal-only marker cannot
                    # collapse, so it separates "arm reached" from "string
                    # machinery broken"; each value then gets its own line so
                    # one poisoned operand cannot erase the others.
                    print "[post-mono-type-transport] malformed_hir_type at walk_type"
                    print "[post-mono-type-transport] receipt={self.transport_receipts + 1}/{POST_MONO_TRANSPORT_RECEIPT_LIMIT}"
                    print "[post-mono-type-transport] module_symbol={self.symbol}"
                self.hit_unreachable("HirTypeKind", "walk_type")

    me walk_type_kinds(tys: [HirType]):
        if tys == nil:
            return
        for t in tys:
            val tt: HirType = t
            if tt != nil:
                self.walk_type_kind(tt.kind)

    me type_param_count_of(kind: HirTypeKind) -> i64:
        """Type params found in `kind`, measured as the delta this walk adds."""
        val before = self.r.unresolved_type_param
        self.walk_type_kind(kind)
        self.r.unresolved_type_param - before

    # ------------------------------------------------------------------
    # Expressions — every HirExprKind variant is named. Covered (57):
    # IntLit FloatLit StringLit BoolLit CharLit UnitLit NilLit ArrayLit
    # ArrayRepeat TupleLit DictLit SetLit Var NamedVar Field Index TupleIndex
    # OptionalChain NullCoalesce ExistsCheck Unwrap Binary Unary Call
    # MethodCall StaticCall If IfChain MatchCase Loop While For With Lambda
    # Block HostGpuLane Return Break Continue Throw Try Await Yield StructLit
    # EnumLit Cast As Range Comprehension CustomBlock LossBlock NogradBlock
    # UnsafeBlock InlineAsm InlineAsmMatch Error TypeTest
    # ------------------------------------------------------------------
    me walk_expr(expr: HirExpr):
        if expr == nil:
            return
        if expr.has_type_:
            if expr.type_ != nil:
                self.walk_type_kind(expr.type_.kind)
        match expr.kind:
            case HirExprKind.IntLit(_, _): pass_do_nothing("literal")
            case HirExprKind.FloatLit(_, _): pass_do_nothing("literal")
            case HirExprKind.FloatLexeme(_, _): pass_do_nothing("literal")
            case HirExprKind.StringLit(_, interpolations): self.walk_interpolations(interpolations)
            case HirExprKind.BoolLit(_): pass_do_nothing("literal")
            case HirExprKind.CharLit(_): pass_do_nothing("literal")
            case HirExprKind.UnitLit: pass_do_nothing("literal")
            case HirExprKind.NilLit: pass_do_nothing("literal")
            case HirExprKind.ArrayLit(elements, type_):
                self.walk_opt_type(type_)
                self.walk_exprs(elements)
            case HirExprKind.ArrayRepeat(value, count, elem_type):
                self.walk_opt_type(elem_type)
                self.walk_expr(value)
                self.walk_expr(count)
            case HirExprKind.TupleLit(elements): self.walk_exprs(elements)
            case HirExprKind.DictLit(entries, key_type, value_type):
                if key_type != nil:
                    self.walk_type_kind(key_type.kind)
                self.walk_opt_type(value_type)
                self.walk_pairs(entries)
            case HirExprKind.SetLit(elements, elem_type):
                self.walk_opt_type(elem_type)
                self.walk_exprs(elements)
            case HirExprKind.Var(_): pass_do_nothing("symbol reference")
            case HirExprKind.NamedVar(_, _): pass_do_nothing("symbol reference")
            case HirExprKind.Field(base, _, _): self.walk_expr(base)
            case HirExprKind.Index(base, index):
                self.walk_expr(base)
                self.walk_expr(index)
            case HirExprKind.TupleIndex(base, _): self.walk_expr(base)
            case HirExprKind.OptionalChain(base, _): self.walk_expr(base)
            case HirExprKind.NullCoalesce(left, right):
                self.walk_expr(left)
                self.walk_expr(right)
            case HirExprKind.ExistsCheck(base): self.walk_expr(base)
            case HirExprKind.Unwrap(base): self.walk_expr(base)
            case HirExprKind.Binary(_, left, right):
                self.walk_expr(left)
                self.walk_expr(right)
            case HirExprKind.Unary(_, operand): self.walk_expr(operand)
            case HirExprKind.Call(callee, args, type_args):
                self.check_template_callee(callee)
                # `rewrite_expr` empties `type_args` when a call site is
                # repointed at its specialization, so ANY surviving type
                # argument is an unrewritten generic call.
                if type_args != nil:
                    if type_args.len() > 0:
                        self.r.generic_call = self.r.generic_call + 1
                        self.record("generic call", "call site still carries {type_args.len()} type argument(s)")
                self.walk_type_kinds(type_args)
                self.walk_expr(callee)
                self.walk_call_args(args)
            case HirExprKind.MethodCall(receiver, method, args, _):
                val rt: HirExpr = receiver
                if rt != nil:
                    if rt.has_type_:
                        if rt.type_ != nil and self.type_param_count_of(rt.type_.kind) > 0:
                            self.r.generic_method = self.r.generic_method + 1
                            self.record("generic method", "method `{method}` dispatched on a receiver still typed by a type parameter")
                self.walk_expr(receiver)
                self.walk_call_args(args)
            case HirExprKind.StaticCall(type_, method, args, _):
                if type_ != nil and self.type_param_count_of(type_.kind) > 0:
                    self.r.generic_method = self.r.generic_method + 1
                    self.record("generic method", "static call `{method}` on a type still carrying a type parameter")
                self.walk_call_args(args)
            case HirExprKind.If(cond, then_, else_):
                self.walk_expr(cond)
                self.walk_block(then_)
                self.walk_opt_block(else_)
            case HirExprKind.IfChain(arms, else_):
                for a in arms:
                    val at: HirIfArm = a
                    self.walk_expr(at.cond)
                    self.walk_block(at.then_)
                self.walk_opt_block(else_)
            case HirExprKind.MatchCase(scrutinee, arms):
                self.walk_expr(scrutinee)
                for a in arms:
                    val mt: HirMatchArm = a
                    self.walk_pattern(mt.pattern)
                    if mt.has_guard:
                        self.walk_expr(mt.guard)
                    self.walk_block(mt.body)
            case HirExprKind.Loop(body, _): self.walk_block(body)
            case HirExprKind.While(cond, body, _):
                self.walk_expr(cond)
                self.walk_block(body)
            case HirExprKind.For(_, iter, body, _):
                self.walk_expr(iter)
                self.walk_block(body)
            case HirExprKind.With(items, body):
                for i in items:
                    val it: HirWithItem = i
                    self.walk_expr(it.context_expr)
                self.walk_block(body)
            case HirExprKind.Lambda(params, body, _):
                self.walk_params(params)
                self.walk_expr(body)
            case HirExprKind.Block(block): self.walk_block(block)
            case HirExprKind.HostGpuLane(_, _, marker, body):
                self.walk_expr(marker)
                self.walk_block(body)
            case HirExprKind.Return(value): self.walk_opt_expr(value)
            case HirExprKind.Break(_, value): self.walk_opt_expr(value)
            case HirExprKind.Continue(_): pass_do_nothing("control transfer")
            case HirExprKind.Throw(value): self.walk_expr(value)
            case HirExprKind.Try(e): self.walk_expr(e)
            case HirExprKind.Await(e): self.walk_expr(e)
            case HirExprKind.Yield(value): self.walk_opt_expr(value)
            case HirExprKind.StructLit(type_, fields):
                if type_ != nil and self.type_param_count_of(type_.kind) > 0:
                    self.r.generic_ctor = self.r.generic_ctor + 1
                    self.record("generic constructor", "struct literal constructs a type still carrying a type parameter")
                self.walk_named_exprs(fields)
            case HirExprKind.EnumLit(type_, variant, payload):
                if type_ != nil and self.type_param_count_of(type_.kind) > 0:
                    self.r.generic_ctor = self.r.generic_ctor + 1
                    self.record("generic constructor", "enum literal `{variant}` constructs a type still carrying a type parameter")
                self.walk_enum_payload(payload)
            case HirExprKind.Cast(e, target):
                self.walk_expr(e)
                if target != nil:
                    self.walk_type_kind(target.kind)
            case HirExprKind.As(e, target):
                self.walk_expr(e)
                if target != nil:
                    self.walk_type_kind(target.kind)
            case HirExprKind.Range(start, end, _, step):
                self.walk_opt_expr(start)
                self.walk_opt_expr(end)
                self.walk_opt_expr(step)
            case HirExprKind.Comprehension(_, e, clauses):
                self.walk_expr(e)
                for c in clauses:
                    val ct: HirCompClause = c
                    self.walk_comp_clause(ct)
            case HirExprKind.CustomBlock(_, _): pass_do_nothing("custom block payload is opaque text")
            case HirExprKind.LossBlock(body): self.walk_block(body)
            case HirExprKind.NogradBlock(body): self.walk_block(body)
            case HirExprKind.UnsafeBlock(body): self.walk_block(body)
            case HirExprKind.InlineAsm(_): pass_do_nothing("inline asm carries no HirType")
            case HirExprKind.InlineAsmMatch(_): pass_do_nothing("inline asm carries no HirType")
            case HirExprKind.Error: pass_do_nothing("expression error recovery is a frontend concern")
            case HirExprKind.TypeTest(value, _): self.walk_expr(value)
            case _: self.hit_unreachable("HirExprKind", "walk_expr")

    me walk_comp_clause(clause: HirCompClause):
        if clause == nil:
            return
        match clause.kind:
            case HirCompClauseKind.For(_, iter): self.walk_expr(iter)
            case HirCompClauseKind.If(cond): self.walk_expr(cond)
            case _: self.hit_unreachable("HirCompClauseKind", "walk_comp_clause")

    # ------------------------------------------------------------------
    # Patterns — every HirPatternKind variant is named. Covered (13):
    # Wildcard Literal Binding Tuple Array Struct Enum Or Range Error
    # CompleteRegion DynRegion TypeTest
    # ------------------------------------------------------------------
    me walk_pattern(pattern: HirPattern):
        if pattern == nil:
            return
        if pattern.has_type_:
            if pattern.type_ != nil:
                self.walk_type_kind(pattern.type_.kind)
        match pattern.kind:
            case HirPatternKind.Wildcard: pass_do_nothing("wildcard binds nothing")
            case HirPatternKind.Literal(value): self.walk_expr(value)
            case HirPatternKind.Binding(_, _): pass_do_nothing("binding has no nested type")
            case HirPatternKind.Tuple(elements): self.walk_patterns(elements)
            case HirPatternKind.Array(elements, _): self.walk_patterns(elements)
            case HirPatternKind.Struct(type_, fields):
                if type_ != nil:
                    self.walk_type_kind(type_.kind)
                self.walk_named_patterns(fields)
            case HirPatternKind.Enum(type_, _, payload):
                if type_ != nil:
                    self.walk_type_kind(type_.kind)
                self.walk_pattern_payload(payload)
            case HirPatternKind.Or(patterns): self.walk_patterns(patterns)
            case HirPatternKind.Range(start, end, _):
                self.walk_expr(start)
                self.walk_expr(end)
            case HirPatternKind.Error: pass_do_nothing("pattern error recovery is a frontend concern")
            case HirPatternKind.CompleteRegion(_): pass_do_nothing("region binder carries no nested HIR")
            case HirPatternKind.DynRegion(_): pass_do_nothing("region binder carries no nested HIR")
            case HirPatternKind.TypeTest(_, _): pass_do_nothing("type-test names and binders carry no nested HIR")
            case _: self.hit_unreachable("HirPatternKind", "walk_pattern")

    # ------------------------------------------------------------------
    # Statements — every HirStmtKind variant is named. Covered (5):
    # Expr Let Assign Block AsmAssert
    # ------------------------------------------------------------------
    me walk_stmt(stmt: HirStmt):
        if stmt == nil:
            return
        match stmt.kind:
            case HirStmtKind.Expr(expr): self.walk_expr(expr)
            case HirStmtKind.Let(_, type_, init):
                if type_ != nil:
                    self.walk_type_kind(type_.kind)
                self.walk_expr(init)
            case HirStmtKind.Assign(target, _, value):
                self.walk_expr(target)
                self.walk_expr(value)
            case HirStmtKind.Block(block): self.walk_block(block)
            case HirStmtKind.AsmAssert(_): pass_do_nothing("asm target guard carries no HirType")
            case _: self.hit_unreachable("HirStmtKind", "walk_stmt")

    me walk_block(block: HirBlock):
        if block == nil:
            return
        for s in block.stmts:
            val st: HirStmt = s
            self.walk_stmt(st)
        if block.has:
            self.walk_expr(block.value)

    # ------------------------------------------------------------------
    # Small helpers
    # ------------------------------------------------------------------
    me walk_opt_type(ty: HirType?):
        if val present = ty:
            if present != nil:
                self.walk_type_kind(present.kind)

    me walk_opt_expr(expr: HirExpr?):
        match expr:
            Some(e):
                val et: HirExpr = e
                self.walk_expr(et)
            nil:
                pass_do_nothing("absent expression")

    me walk_opt_block(block: HirBlock?):
        match block:
            Some(b):
                val bt: HirBlock = b
                self.walk_block(bt)
            nil:
                pass_do_nothing("absent block")

    me walk_exprs(exprs: [HirExpr]):
        if exprs == nil:
            return
        for e in exprs:
            val et: HirExpr = e
            self.walk_expr(et)

    me walk_patterns(patterns: [HirPattern]):
        if patterns == nil:
            return
        for p in patterns:
            val pt: HirPattern = p
            self.walk_pattern(pt)

    me walk_named_patterns(fields: [(text, HirPattern)]):
        if fields == nil:
            return
        for f in fields:
            val (_, p) = f
            val pt: HirPattern = p
            self.walk_pattern(pt)

    me walk_pattern_payload(payload: HirPatternPayload?):
        match payload:
            Some(p):
                match p:
                    case HirPatternPayload.Tuple(patterns): self.walk_patterns(patterns)
                    case HirPatternPayload.Struct(fields): self.walk_named_patterns(fields)
                    case _: self.hit_unreachable("HirPatternPayload", "walk_pattern_payload")
            nil:
                pass_do_nothing("absent payload")

    me walk_enum_payload(payload: HirEnumPayload?):
        match payload:
            Some(p):
                match p:
                    case HirEnumPayload.Tuple(values): self.walk_exprs(values)
                    case HirEnumPayload.Struct(fields): self.walk_named_exprs(fields)
                    case _: self.hit_unreachable("HirEnumPayload", "walk_enum_payload")
            nil:
                pass_do_nothing("absent payload")

    me walk_pairs(entries: [(HirExpr, HirExpr)]):
        if entries == nil:
            return
        for e in entries:
            val (k, v) = e
            val kt: HirExpr = k
            val vt: HirExpr = v
            self.walk_expr(kt)
            self.walk_expr(vt)

    me walk_named_exprs(fields: [(text, HirExpr)]):
        if fields == nil:
            return
        for f in fields:
            val (_, e) = f
            val et: HirExpr = e
            self.walk_expr(et)

    me walk_call_args(args: [HirCallArg]):
        if args == nil:
            return
        for a in args:
            val at: HirCallArg = a
            self.walk_expr(at.value)

    me walk_interpolations(interps: [HirInterpolation]?):
        match interps:
            Some(items):
                for i in items:
                    val it: HirInterpolation = i
                    self.walk_expr(it.expr)
            nil:
                pass_do_nothing("plain string")

    me walk_params(params: [HirParam]):
        if params == nil:
            return
        for p in params:
            val pt: HirParam = p
            if pt.type_ != nil:
                self.walk_type_kind(pt.type_.kind)
            if pt.has_default:
                self.walk_expr(pt.default)

    # ------------------------------------------------------------------
    # Definitions
    # ------------------------------------------------------------------
    me check_mangling(name: text):
        """`mangle_type` (40.mono/monomorphize/engine.spl) emits `unknown` for
        an unmangleable type and `param_<T>` for an unsubstituted type
        parameter. Either token in a specialized name is an unknown mangling."""
        # NILNAME (2026-09-01): a HIR definition can reach this pass with a nil
        # name, and `nil.contains(...)` is fatal — it aborted the whole MCP
        # native build right after the `[mono]` receipt with
        # `method \`contains\` not found on type \`nil\``. An unnamed symbol
        # cannot carry a mangling token, so empty is the correct reading.
        # Record: doc/08_tracking/bug/mcp_native_build_post_mono_nil_contains_2026-09-01.md
        val mangled_name: text = name ?? ""
        if mangled_name.contains("unknown"):
            self.r.unknown_mangling = self.r.unknown_mangling + 1
            self.record("unknown type mangling", "specialized symbol `{mangled_name}` contains the `unknown` mangling token")
        else:
            if mangled_name.contains("param_"):
                self.r.unknown_mangling = self.r.unknown_mangling + 1
                self.record("unknown type mangling", "specialized symbol `{mangled_name}` mangles an unsubstituted type parameter")

    me is_template(type_params: [HirTypeParam], flagged: bool) -> bool:
        if flagged:
            return true
        if type_params == nil:
            return false
        type_params.len() > 0

    me enter(module_name: text, def_name: text):
        # NILNAME (2026-09-01): see check_mangling — a nil def name is fatal on
        # `.contains`/`.split`. An unnamed definition is not a specialization.
        val entered_def_name: text = def_name ?? ""
        self.symbol = "{module_name}.{entered_def_name}"
        self.in_specialization = entered_def_name.contains("$")
        if self.in_specialization:
            self.chain = "{module_name}.{entered_def_name} (template {entered_def_name.split("$")[0]})"
        else:
            self.chain = "{module_name}.{entered_def_name}"

    me check_template_callee(callee: HirExpr):
        if callee == nil:
            return
        var sid: i64 = -1
        match callee.kind:
            case HirExprKind.Var(s):
                val st: SymbolId = s
                sid = st.id
            case HirExprKind.NamedVar(s, _):
                val st2: SymbolId = s
                sid = st2.id
            case _: pass_do_nothing("not a symbol callee")
        if sid < 0:
            return
        if self.template_syms.has(sid):
            self.r.generic_call = self.r.generic_call + 1
            self.record("generic call", "call site still targets generic template `{self.template_syms[sid]}` (type arguments neither written nor inferred)")
            return
        self.check_callee_identity(sid, callee.span)

    me flag_template(kind: text, def_name: text):
        self.r.generic_emitted_definition = self.r.generic_emitted_definition + 1
        self.record("generic emitted definition", "{kind} `{def_name}` is still a generic template and is still emittable")

    me verify_module(module: HirModule) -> PostMonoReport:
        if module == nil:
            return self.r
        val mname: text = module.name
        self.template_syms = {}
        self.cur_module = mname ?? ""
        self.cur_symbols = module.symbols
        self.cur_fn_ids = {}
        for key in module.functions.keys():
            val tf: HirFunction = module.functions[key]
            val tsym: SymbolId = tf.symbol
            self.cur_fn_ids[tsym.id] = true
            if self.is_template(tf.type_params, tf.is_generic_template):
                self.template_syms[tsym.id] = tf.name
        for key in module.functions.keys():
            val f: HirFunction = module.functions[key]
            self.enter(mname, f.name)
            if self.is_template(f.type_params, f.is_generic_template):
                self.flag_template("function", f.name)
                continue
            if self.in_specialization:
                self.check_mangling(f.name)
                self.check_specialization_symbol(f)
            self.walk_params(f.params)
            if f.return_type != nil:
                self.walk_type_kind(f.return_type.kind)
            self.walk_block(f.body)
        for key in module.structs.keys():
            val s: HirStruct = module.structs[key]
            self.enter(mname, s.name)
            if self.is_template(s.type_params, s.is_generic_template):
                self.flag_template("struct", s.name)
                continue
            if self.in_specialization:
                self.check_mangling(s.name)
            for fld in s.fields:
                val ft: HirField = fld
                if ft.type_ != nil:
                    self.walk_type_kind(ft.type_.kind)
        for key in module.classes.keys():
            val c: HirClass = module.classes[key]
            self.enter(mname, c.name)
            if self.is_template(c.type_params, c.is_generic_template):
                self.flag_template("class", c.name)
                continue
            if self.in_specialization:
                self.check_mangling(c.name)
            for fld in c.fields:
                val ft2: HirField = fld
                if ft2.type_ != nil:
                    self.walk_type_kind(ft2.type_.kind)
        for key in module.enums.keys():
            val e: HirEnum = module.enums[key]
            self.enter(mname, e.name)
            if self.is_template(e.type_params, e.is_generic_template):
                self.flag_template("enum", e.name)
                continue
            if self.in_specialization:
                self.check_mangling(e.name)
        self.r

# ============================================================================
# Entry points
# ============================================================================

fn post_mono_verify(module: HirModule) -> PostMonoReport:
    """Verify the section 9.5 invariants over one post-mono HIR module."""
    var v = PostMonoVerifier.create()
    if module != nil:
        var one: Dict<text, HirModule> = {}
        one[module.name ?? ""] = module
        v.index_closure(one)
    v.verify_module(module)

fn post_mono_verify_modules(modules: Dict<text, HirModule>) -> PostMonoReport:
    """Verify every post-mono module, accumulating into one report."""
    var v = PostMonoVerifier.create()
    if modules == nil:
        return v.r
    v.index_closure(modules)
    for key in modules.keys():
        val m: HirModule = modules[key]
        v.verify_module(m)
    v.r
