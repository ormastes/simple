# Monomorphization Engine
#
# Creates specialized versions of generic functions, structs, and classes
# by substituting concrete type arguments. Iteratively processes pending
# specializations until all are resolved.
#
# Port of rust/compiler/src/monomorphize/engine.rs (300+ lines)

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use monomorphize.type_subst.*
use .types (SpecializationKey, ConcreteType, concretetype_Named)


fn concrete_types_to_text(types: [ConcreteType]) -> text:
    var parts: [text] = []
    for item in types:
        parts = parts.push(concrete_type_to_text(item))
    parts.join("_")

fn concrete_type_to_text(ty: ConcreteType) -> text:
    match ty:
        case Int: "Int"
        case Float: "Float"
        case Bool: "Bool"
        case String: "String"
        case Nil: "Nil"
        case Named(n): n
        case Array(elem): "Array_{concrete_type_to_text(elem)}"
        case Tuple(elems): "Tuple_{concrete_types_to_text(elems)}"
        case Dict(k, v): "Dict_{concrete_type_to_text(k)}_{concrete_type_to_text(v)}"
        case Function(params, ret):
            "Fn_{concrete_types_to_text(params)}_{concrete_type_to_text(ret)}"
        case Optional(inner): "Opt_{concrete_type_to_text(inner)}"
        case Pointer(_, _, inner): "Ptr_{concrete_type_to_text(inner)}"
        case Union(members): "Union_{concrete_types_to_text(members)}"
        case Specialized(name, args): "{name}_{concrete_types_to_text(args)}"

# ============================================================================
# Monomorphization Table
# ============================================================================

class MonomorphizationTable:
    """Tracks pending and completed specializations."""
    pending_functions: [(SpecializationKey, HirFunction)]
    pending_structs: [(SpecializationKey, HirStruct)]
    pending_classes: [(SpecializationKey, HirClass)]
    specialized_functions: {text: HirFunction}
    specialized_structs: {text: HirStruct}
    specialized_classes: {text: HirClass}
    processed: [text]


# ============================================================================
# MonomorphizationTable Methods (was: impl MonomorphizationTable:)
# ============================================================================

fn monomorphizationtable_create() -> MonomorphizationTable:
        MonomorphizationTable(
            pending_functions: [], pending_structs: [], pending_classes: [],
            specialized_functions: {}, specialized_structs: {}, specialized_classes: {},
            processed: [])


# ============================================================================
# Monomorphizer
# ============================================================================

class Monomorphizer:
    """Monomorphization engine that creates specialized versions of generics."""
    generic_functions: {text: HirFunction}
    generic_structs: {text: HirStruct}
    generic_classes: {text: HirClass}
    table: MonomorphizationTable


# ============================================================================
# Monomorphizer Methods (was: impl Monomorphizer:)
# ============================================================================

fn monomorphizer_create() -> Monomorphizer:
        Monomorphizer(generic_functions: {}, generic_structs: {},
                      generic_classes: {}, table: monomorphizationtable_create())

fn spec_key_mangled_name(key: SpecializationKey) -> text:
    var parts: [text] = []
    for arg in key.type_args:
        parts = parts.push(concrete_type_to_text(arg))
    val args_str = parts.join("_")
    if args_str == "":
        key.name
    else:
        "{key.name}${args_str}"

impl Monomorphizer:
    me register_generic_function(name: text, func: HirFunction):
        self.generic_functions[name] = func

    me register_generic_struct(name: text, s: HirStruct):
        self.generic_structs[name] = s

    me register_generic_class(name: text, c: HirClass):
        self.generic_classes[name] = c

    me specialize_function_call(name: text, args: [ConcreteType]) -> text:
        val key = SpecializationKey(name: name, type_args: args)
        val mangled = spec_key_mangled_name(key)
        # Dedup: skip if already specialized or already pending
        if self.table.specialized_functions.has(mangled):
            return mangled
        var already_pending = false
        for (pending_key, _) in self.table.pending_functions:
            if spec_key_mangled_name(pending_key) == mangled:
                already_pending = true
                break
        if not already_pending:
            self.table.pending_functions = self.table.pending_functions.push((key, self.generic_functions[name]))
        mangled

    me process_pending():
        for (key, func) in self.table.pending_functions:
            val mangled = spec_key_mangled_name(key)
            self.table.specialized_functions[mangled] = func
            self.table.processed = self.table.processed.push(mangled)
        self.table.pending_functions = []

    fn get_specialized_functions() -> {text: HirFunction}:
        self.table.specialized_functions


# ============================================================================
# Function Specialization with HirFunction
# ============================================================================

fn specialize_function_with_types(func: HirFunction, type_args: [HirType]) -> HirFunction:
    """Create a specialized version of a generic function.

    Args:
        func: The generic function to specialize
        type_args: Concrete type arguments to substitute

    Returns:
        A new HirFunction with type parameters replaced by concrete types
    """
    # Create substitution map from type parameters to concrete types
    val subst = typesubstitution_from_params(func.type_params, type_args)

    # Generate mangled name
    val mangled = generate_mangled_name(func.name, type_args)

    # Apply substitution to create specialized function
    substitute_function(func, subst, mangled)

fn generate_mangled_name(base_name: text, type_args: [HirType]) -> text:
    """Generate a unique mangled name for a specialization."""
    if type_args.len() == 0:
        base_name
    else:
        val args_str = mangle_types(type_args)
        "{base_name}${args_str}"

fn mangle_types(types: [HirType]) -> text:
    var parts: [text] = []
    for item in types:
        parts = parts.push(mangle_type(item))
    parts.join("_")

fn mangle_type(ty: HirType) -> text:
    """Generate a mangling string for a type."""
    match ty.kind:
        case Int(bits, signed):
            if signed: "i{bits}" else: "u{bits}"
        case Float(bits): "f{bits}"
        case Bool: "bool"
        case Char: "char"
        case Str: "str"
        case Unit: "unit"
        case Never: "never"
        case Tuple(elems):
            val inner = mangle_types(elems)
            "tup_{inner}"
        case Array(elem, _):
            "arr_{mangle_type(elem)}"
        case Dict(k, v):
            "dict_{mangle_type(k)}_{mangle_type(v)}"
        case Optional(inner):
            "opt_{mangle_type(inner)}"
        case Named(symbol, args):
            if args.len() > 0:
                val inner = mangle_types(args)
                "T{symbol.id}_{inner}"
            else:
                "T{symbol.id}"
        case Union(members):
            val inner = mangle_types(members)
            "union_{inner}"
        case TypeParam(name, _):
            # Type params should be substituted before mangling
            "param_{name}"
        case _: "unknown"
