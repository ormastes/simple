# Type conversion between the current parser AST and monomorphization types.
# The parser owns Type {kind: TypeKind, span: Span} and Expr {kind: ExprKind}.
# See issue #3021: legacy Type.Simple/Pointer constructors are not this API.

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Type, TypeKind, Expr, ExprKind}
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name, parser_type_kind_named_args}
use compiler.frontend.parser_types_expr.{parser_type_kind_array_element, parser_type_kind_function_params, parser_type_kind_function_return}
use compiler.frontend.parser_types_expr.{parser_type_kind_pointer_inner, parser_type_kind_pointer_is_mutable}
use compiler.frontend.parser_types_expr.{parser_type_kind_reference_inner, parser_type_kind_reference_is_mutable}
use compiler.mono.monomorphize.types.{ConcreteType, concretetype_Named, PointerKind, PointerKind as ConcretePointerKind, ReferenceCapability}

fn type_uses_param(ty: Type, param: text) -> bool:
    """Check names and nested type arguments for a parameter."""
    match ty.kind:
        case TypeKind.Named(_, _):
            if parser_type_kind_named_name(ty.kind) == param:
                return true
            for arg in parser_type_kind_named_args(ty.kind):
                if type_uses_param(arg, param):
                    return true
            false
        case TypeKind.Array(_, _):
            val element = parser_type_kind_array_element(ty.kind, Type(kind: TypeKind.Error, span: ty.span))
            type_uses_param(element, param)
        case TypeKind.Tuple(elems) | TypeKind.Union(elems):
            for elem in elems:
                if type_uses_param(elem, param):
                    return true
            false
        case TypeKind.Function(_, _):
            val params = parser_type_kind_function_params(ty.kind)
            val ret = parser_type_kind_function_return(ty.kind, Type(kind: TypeKind.Error, span: ty.span))
            for p in params:
                if type_uses_param(p, param):
                    return true
            type_uses_param(ret, param)
        case TypeKind.Optional(inner) | TypeKind.Atomic(inner) | TypeKind.Isolated(inner) | TypeKind.Weak(inner):
            type_uses_param(inner, param)
        case TypeKind.Unique(inner) | TypeKind.Shared(inner):
            type_uses_param(inner, param)
        case TypeKind.Reference(_, _):
            type_uses_param(parser_type_kind_reference_inner(ty.kind, Type(kind: TypeKind.Error, span: ty.span)), param)
        case TypeKind.Pointer(_, _):
            type_uses_param(parser_type_kind_pointer_inner(ty.kind, Type(kind: TypeKind.Error, span: ty.span)), param)
        case TypeKind.Projection(inner, _): type_uses_param(inner, param)
        case _: false

fn infer_concrete_type(expr: Expr, type_context: {text: ConcreteType}) -> ConcreteType?:
    """Infer literals, identifiers, and nonempty arrays; otherwise return nil."""
    match expr.kind:
        case ExprKind.IntLit(_): ConcreteType.Int
        case ExprKind.FloatLit(_): ConcreteType.Float
        case ExprKind.BoolLit(_): ConcreteType.Bool
        case ExprKind.StringLit(_, _): ConcreteType.String
        case ExprKind.NilLit: ConcreteType.Nil
        case ExprKind.Ident(name): type_context.get(name)
        case ExprKind.ArrayLit(elems):
            if val first = elems.first():
                if val elem_ty = infer_concrete_type(first, type_context):
                    return ConcreteType.Array(elem_ty)
            nil
        case _: nil

fn mono_pointer_concrete(kind: ConcretePointerKind, inner: Type, bindings: {text: ConcreteType}) -> ConcreteType:
    # @workaround bug=mono_match_capability_owner_2026_10_11 reason=retain the nominal ReferenceCapability owner across the match-result local
    val capability: ReferenceCapability = match kind:
        case ConcretePointerKind.Unique: ReferenceCapability.Isolated
        case ConcretePointerKind.BorrowMut | ConcretePointerKind.RawMut: ReferenceCapability.Exclusive
        case _: ReferenceCapability.Shared
    ConcreteType.Pointer(kind, capability, ast_type_to_concrete(inner, bindings))

fn ast_type_to_concrete(ty: Type, bindings: {text: ConcreteType}) -> ConcreteType:
    """Substitute bindings and normalize primitives in a parser type.

    Error is a hard failure, including in nested types. It must never become
    Named("Unknown"): that would swallow an unsupported Handle conversion.
    Infer and unsupported projections retain the existing Unknown fallback.
    """
    match ty.kind:
        case TypeKind.Error:
            panic("cannot monomorphize invalid AST type")
        case TypeKind.Named(_, _):
            val name = parser_type_kind_named_name(ty.kind)
            val args = parser_type_kind_named_args(ty.kind)
            # Validate/convert arguments before a binding can replace the base.
            # Otherwise a bound generic name could hide a nested Error value.
            var concrete_args: [ConcreteType] = []
            for arg in args:
                concrete_args = concrete_args.push(ast_type_to_concrete(arg, bindings))
            if val concrete = bindings.get(name):
                return concrete
            if args.len() > 0:
                return ConcreteType.Specialized(name, concrete_args)
            match name:
                case "Int" | "i32" | "i64" | "i8" | "i16": ConcreteType.Int
                case "Float" | "f32" | "f64": ConcreteType.Float
                case "Bool" | "bool": ConcreteType.Bool
                case "String" | "str" | "text": ConcreteType.String
                case "Nil" | "nil" | "()": ConcreteType.Nil
                case _: concretetype_Named(name)
        case TypeKind.Tuple(elems):
            var concrete_elems: [ConcreteType] = []
            for elem in elems:
                concrete_elems = concrete_elems.push(ast_type_to_concrete(elem, bindings))
            ConcreteType.Tuple(concrete_elems)
        case TypeKind.Array(_, _):
            # Array size remains runtime information for monomorphization.
            val element = parser_type_kind_array_element(ty.kind, Type(kind: TypeKind.Error, span: ty.span))
            ConcreteType.Array(ast_type_to_concrete(element, bindings))
        case TypeKind.Function(_, _):
            val params = parser_type_kind_function_params(ty.kind)
            val ret = parser_type_kind_function_return(ty.kind, Type(kind: TypeKind.Error, span: ty.span))
            var param_types: [ConcreteType] = []
            for param in params:
                param_types = param_types.push(ast_type_to_concrete(param, bindings))
            ConcreteType.Function(param_types, ast_type_to_concrete(ret, bindings))
        case TypeKind.Optional(inner):
            ConcreteType.Optional(ast_type_to_concrete(inner, bindings))
        case TypeKind.Isolated(inner): mono_pointer_concrete(ConcretePointerKind.Unique, inner, bindings)
        case TypeKind.Atomic(inner): mono_pointer_concrete(ConcretePointerKind.Atomic, inner, bindings)
        case TypeKind.Weak(inner): mono_pointer_concrete(ConcretePointerKind.Weak, inner, bindings)
        # memory.md `&T` unique owner: Unique with the Shared capability, so it
        # stays distinct from `iso T` (Unique + Isolated) on the way back.
        case TypeKind.Unique(inner):
            ConcreteType.Pointer(ConcretePointerKind.Unique, ReferenceCapability.Shared, ast_type_to_concrete(inner, bindings))
        case TypeKind.Shared(inner): mono_pointer_concrete(ConcretePointerKind.Shared, inner, bindings)
        case TypeKind.Reference(_, _):
            val kind = if parser_type_kind_reference_is_mutable(ty.kind): ConcretePointerKind.BorrowMut else: ConcretePointerKind.Borrow
            mono_pointer_concrete(kind, parser_type_kind_reference_inner(ty.kind, Type(kind: TypeKind.Error, span: ty.span)), bindings)
        case TypeKind.Pointer(_, _):
            val kind = if parser_type_kind_pointer_is_mutable(ty.kind): ConcretePointerKind.RawMut else: ConcretePointerKind.RawConst
            mono_pointer_concrete(kind, parser_type_kind_pointer_inner(ty.kind, Type(kind: TypeKind.Error, span: ty.span)), bindings)
        case TypeKind.Union(types):
            var concrete_members: [ConcreteType] = []
            for member in types:
                concrete_members = concrete_members.push(ast_type_to_concrete(member, bindings))
            if concrete_members.len() == 0:
                ConcreteType.Nil
            elif concrete_members.len() == 1:
                concrete_members[0]
            else:
                ConcreteType.Union(concrete_members)
        case TypeKind.Projection(inner, _):
            # Preserve the unsupported projection fallback, but not an Error
            # hidden under it. Conversion visits the full nested type first.
            ast_type_to_concrete(inner, bindings)
            concretetype_Named("Unknown")
        case _: concretetype_Named("Unknown")

fn mono_ast_type(kind: TypeKind) -> Type:
    Type(kind: kind, span: Span(0, 0, 0, 0, "", 0))

fn mono_ast_is_error(ty: Type) -> bool:
    ty.kind == TypeKind.Error

fn concrete_to_ast_type(concrete: ConcreteType) -> Type:
    """Convert back to the parser representation with a synthetic span.

    Specialized names remain already-mangled names; generic args are discarded
    as before. Pointer capability is derived from kind, not stored in the AST.
    Handle has no parser representation: Error must reach the HIR diagnostic
    path (see #3021), never a fake named type or a different pointer kind.
    """
    match concrete:
        case ConcreteType.Int: mono_ast_type(TypeKind.Named("Int", []))
        case ConcreteType.Float: mono_ast_type(TypeKind.Named("Float", []))
        case ConcreteType.Bool: mono_ast_type(TypeKind.Named("Bool", []))
        case ConcreteType.String: mono_ast_type(TypeKind.Named("String", []))
        case ConcreteType.Nil: mono_ast_type(TypeKind.Named("Nil", []))
        case ConcreteType.Named(name): mono_ast_type(TypeKind.Named(name, []))
        case ConcreteType.Array(elem):
            val elem_ty = concrete_to_ast_type(elem)
            if mono_ast_is_error(elem_ty): return elem_ty
            mono_ast_type(TypeKind.Array(elem_ty, None))
        case ConcreteType.Tuple(elems):
            var ast_elems: [Type] = []
            for elem in elems:
                val elem_ty = concrete_to_ast_type(elem)
                if mono_ast_is_error(elem_ty): return elem_ty
                ast_elems = ast_elems.push(elem_ty)
            mono_ast_type(TypeKind.Tuple(ast_elems))
        case ConcreteType.Dict(key, value):
            val key_ty = concrete_to_ast_type(key)
            if mono_ast_is_error(key_ty): return key_ty
            val value_ty = concrete_to_ast_type(value)
            if mono_ast_is_error(value_ty): return value_ty
            mono_ast_type(TypeKind.Named("Dict", [key_ty, value_ty]))
        case ConcreteType.Function(params, ret):
            var param_types: [Type] = []
            for param in params:
                val param_ty = concrete_to_ast_type(param)
                if mono_ast_is_error(param_ty): return param_ty
                param_types = param_types.push(param_ty)
            val ret_ty = concrete_to_ast_type(ret)
            if mono_ast_is_error(ret_ty): return ret_ty
            mono_ast_type(TypeKind.Function(param_types, ret_ty))
        case ConcreteType.Optional(inner):
            val inner_ty = concrete_to_ast_type(inner)
            if mono_ast_is_error(inner_ty): return inner_ty
            mono_ast_type(TypeKind.Optional(inner_ty))
        case ConcreteType.Pointer(kind, cap, inner):
            val inner_ty = concrete_to_ast_type(inner)
            # Atomic/Weak are not recursively consumed by current HIR lowering.
            # Lift child Error before any wrapper can hide unsupported Handle.
            if mono_ast_is_error(inner_ty): return inner_ty
            val ast_kind = match kind:
                case ConcretePointerKind.Unique:
                    match cap:
                        case ReferenceCapability.Isolated: TypeKind.Isolated(inner_ty)
                        case _: TypeKind.Unique(inner_ty)
                case ConcretePointerKind.Shared: TypeKind.Shared(inner_ty)
                case ConcretePointerKind.Atomic: TypeKind.Atomic(inner_ty)
                case ConcretePointerKind.Weak: TypeKind.Weak(inner_ty)
                case ConcretePointerKind.Borrow: TypeKind.Reference(inner_ty, false)
                case ConcretePointerKind.BorrowMut: TypeKind.Reference(inner_ty, true)
                case ConcretePointerKind.RawConst: TypeKind.Pointer(inner_ty, false)
                case ConcretePointerKind.RawMut: TypeKind.Pointer(inner_ty, true)
                case ConcretePointerKind.Handle: TypeKind.Error
            mono_ast_type(ast_kind)
        case ConcreteType.Union(members):
            var ast_members: [Type] = []
            for member in members:
                val member_ty = concrete_to_ast_type(member)
                if mono_ast_is_error(member_ty): return member_ty
                ast_members = ast_members.push(member_ty)
            mono_ast_type(TypeKind.Union(ast_members))
        case ConcreteType.Specialized(name, _):
            # Already-mangled names are authoritative. Their old argument list
            # remains intentionally ignored, including unsupported arguments.
            mono_ast_type(TypeKind.Named(name, []))

# Retained compatibility helpers: both names refer to the mono PointerKind.
# Parser pointers are represented by TypeKind wrappers, not this legacy enum.
fn ast_pointer_kind_to_concrete(kind: PointerKind) -> ConcretePointerKind:
    match kind:
        case PointerKind.Unique: ConcretePointerKind.Unique
        case PointerKind.Shared: ConcretePointerKind.Shared
        case PointerKind.Weak: ConcretePointerKind.Weak
        case PointerKind.Handle: ConcretePointerKind.Handle
        case PointerKind.Borrow: ConcretePointerKind.Borrow
        case PointerKind.BorrowMut: ConcretePointerKind.BorrowMut
        case PointerKind.RawConst: ConcretePointerKind.RawConst
        case PointerKind.RawMut: ConcretePointerKind.RawMut
        case PointerKind.Atomic: ConcretePointerKind.Atomic

fn concrete_pointer_kind_to_ast(kind: ConcretePointerKind) -> PointerKind:
    match kind:
        case ConcretePointerKind.Unique: PointerKind.Unique
        case ConcretePointerKind.Shared: PointerKind.Shared
        case ConcretePointerKind.Weak: PointerKind.Weak
        case ConcretePointerKind.Handle: PointerKind.Handle
        case ConcretePointerKind.Borrow: PointerKind.Borrow
        case ConcretePointerKind.BorrowMut: PointerKind.BorrowMut
        case ConcretePointerKind.RawConst: PointerKind.RawConst
        case ConcretePointerKind.RawMut: PointerKind.RawMut
        case ConcretePointerKind.Atomic: PointerKind.Atomic
