# Bounded universes for the generic substitution model.
#
# The laws of `generic_subst_model.spl` are checked EXHAUSTIVELY over the
# finite sets built here -- and over nothing else. Every set is duplicate-free
# by construction (distinct constructor / distinct argument position), and the
# specs print and assert each size so a vacuous sweep fails.
#
#   atoms            i64, text, bool, 'T, 'U                               (5)
#   depth <= 1       atoms + Array/Optional/Named:Box of an atom
#                    + Tuple/Fn/Dict of two atoms                          (95)
#   types            depth <= 1, plus Array/Optional/Named:Box of each
#                    non-atom of it                                        (365)
#   closed range     i64, text, bool, Array<i64>, Optional<text>,
#                    Tuple<i64,text>, Named:Box<i64>, Fn<i64,bool>         (8)
#   closed substs    {T, U} -> closed range, each variable bound or not    (81)
#
# Design: doc/05_design/compiler/generics/generic_instantiation_model.md

use compiler.mono.model.generic_subst_model.*

val MU_BOX = "Named:Box"
val MU_PAIR = "Named:Pair"

fn mu_closed_atoms() -> [MType]:
    [mt_con("i64"), mt_con("text"), mt_con("bool")]

fn mu_atoms() -> [MType]:
    [mt_con("i64"), mt_con("text"), mt_con("bool"), mt_var("T"), mt_var("U")]

fn mu_unary_ctors() -> [text]:
    [MT_ARRAY, MT_OPTIONAL, MU_BOX]

fn mu_binary_ctors() -> [text]:
    [MT_TUPLE, MT_FN, MT_DICT]

fn mu_unary_over(base: [MType]) -> [MType]:
    var out: [MType] = []
    for c in mu_unary_ctors():
        val ctor: text = c
        for b in base:
            val bt: MType = b
            out = out.push(mt_app(ctor, [bt]))
    out

fn mu_depth1(atoms: [MType]) -> [MType]:
    var out: [MType] = []
    for a in atoms:
        val at: MType = a
        out = out.push(at)
    for u in mu_unary_over(atoms):
        val ut: MType = u
        out = out.push(ut)
    for c in mu_binary_ctors():
        val ctor: text = c
        for a in atoms:
            val x: MType = a
            for b in atoms:
                val y: MType = b
                out = out.push(mt_app(ctor, [x, y]))
    out

fn mu_types() -> [MType]:
    """Every type the substitution laws are checked on."""
    val d1 = mu_depth1(mu_atoms())
    var out: [MType] = []
    for t in d1:
        val tt: MType = t
        out = out.push(tt)
    # Unary constructors of an ATOM are already in `d1`.
    var composite: [MType] = []
    for c in d1:
        val ct: MType = c
        if mt_depth(ct) > 0:
            composite = composite.push(ct)
    for t2 in mu_unary_over(composite):
        val tt2: MType = t2
        out = out.push(tt2)
    out

fn mu_closed_types() -> [MType]:
    """The closed members of `mu_types()`."""
    var out: [MType] = []
    for t in mu_types():
        val tt: MType = t
        if mt_is_closed(tt):
            out = out.push(tt)
    out

fn mu_closed_range() -> [MType]:
    [mt_con("i64"), mt_con("text"), mt_con("bool"),
     mt_app(MT_ARRAY, [mt_con("i64")]),
     mt_app(MT_OPTIONAL, [mt_con("text")]),
     mt_app(MT_TUPLE, [mt_con("i64"), mt_con("text")]),
     mt_app(MU_BOX, [mt_con("i64")]),
     mt_app(MT_FN, [mt_con("i64"), mt_con("bool")])]

fn mu_small_closed_range() -> [MType]:
    [mt_con("i64"), mt_con("text"), mt_app(MT_ARRAY, [mt_con("i64")]), mt_app(MU_BOX, [mt_con("bool")])]

fn mu_open_range() -> [MType]:
    """Images a NON-closed substitution may have (for the composition law)."""
    [mt_var("T"), mt_var("U"), mt_con("i64"),
     mt_app(MT_ARRAY, [mt_var("T")]),
     mt_app(MT_ARRAY, [mt_var("U")]),
     mt_app(MT_TUPLE, [mt_var("T"), mt_var("U")]),
     mt_app(MT_OPTIONAL, [mt_con("text")])]

fn mu_substs(range: [MType], total: bool) -> [MSubst]:
    """Every substitution of T and U into `range`. With `total` both are
    always bound; otherwise each may also be left unbound."""
    var t_choices: [MSubst] = []
    if not total:
        t_choices = t_choices.push(ms_empty())
    for r in range:
        val rt: MType = r
        t_choices = t_choices.push(ms_bind(ms_empty(), "T", rt))
    var out: [MSubst] = []
    for s in t_choices:
        val st: MSubst = s
        if not total:
            out = out.push(st)
        for r2 in range:
            val rt2: MType = r2
            out = out.push(ms_bind(st, "U", rt2))
    out

fn mu_flow_types() -> [MType]:
    """Types a variable-change step is tried on: every atom, each unary
    constructor of an atom, and the two-argument shapes the kinds inspect."""
    var out: [MType] = []
    for a in mu_atoms():
        val at: MType = a
        out = out.push(at)
    for u in mu_unary_over(mu_atoms()):
        val ut: MType = u
        out = out.push(ut)
    out = out.push(mt_app(MT_TUPLE, [mt_var("T"), mt_var("U")]))
    out = out.push(mt_app(MT_TUPLE, [mt_con("i64"), mt_var("T")]))
    out = out.push(mt_app(MT_FN, [mt_var("T"), mt_var("U")]))
    out = out.push(mt_app(MT_FN, [mt_var("T"), mt_con("i64")]))
    out = out.push(mt_app(MT_DICT, [mt_con("text"), mt_var("T")]))
    out = out.push(mt_app(MT_DICT, [mt_var("T"), mt_var("U")]))
    out

fn mu_field_declarations() -> [MType]:
    """Declared field types over struct parameters P, Q (and one that is
    open in `'T`, which every field kind must reject)."""
    [mt_var("P"), mt_con("i64"),
     mt_app(MT_ARRAY, [mt_var("P")]),
     mt_app(MT_OPTIONAL, [mt_var("P")]),
     mt_app(MT_TUPLE, [mt_var("P"), mt_var("Q")]),
     mt_app(MT_DICT, [mt_con("text"), mt_var("Q")]),
     mt_app(MT_FN, [mt_var("P"), mt_var("Q")]),
     mt_var("T")]

fn mu_pair_instances() -> [MType]:
    """`Pair<a, b>` for every two atoms: the instances a field is read from."""
    var out: [MType] = []
    for a in mu_atoms():
        val x: MType = a
        for b in mu_atoms():
            val y: MType = b
            out = out.push(mt_app(MU_PAIR, [x, y]))
    out
