# Executable correspondence boundary for the G2 effect-substitution fragment.
# This projection is not a production refinement proof or an admission receipt.
# Unsupported HIR refuses rather than becoming a successful unknown term.
use compiler.hir.hir_types.*
use compiler.mono.model.generic_subst_model.*

fn gep_types(types: [HirType]) -> Result<[MType], text>:
    if types == nil: return Err("AbsentTypes")
    var out: [MType] = []
    for type_ in types:
        match gep_type(type_):
            case Ok(term): out = out.push(term)
            case Err(reason): return Err(reason)
    Ok(out)

fn gep_effects(effects: [Effect]) -> Result<MType, text>:
    if effects == nil: return Err("AbsentEffects")
    var out: [MType] = []
    for raw in effects:
        val effect: Effect = raw
        if effect == nil: return Err("AbsentEffect")
        match effect.kind:
            case EffectKind.Throws(payload):
                match gep_type(payload):
                    case Ok(term): out = out.push(mt_app("Effect.Throws", [term]))
                    case Err(reason): return Err(reason)
            case EffectKind.Pure: out = out.push(mt_con("Effect.Pure"))
            case EffectKind.IO: out = out.push(mt_con("Effect.IO"))
            case EffectKind.Async: out = out.push(mt_con("Effect.Async"))
            case EffectKind.Mutates: out = out.push(mt_con("Effect.Mutates"))
            case EffectKind.Allocates: out = out.push(mt_con("Effect.Allocates"))
            case EffectKind.Custom(name):
                # A tagged child keeps custom names distinct from built-in kinds.
                out = out.push(mt_app("Effect.Custom", [mt_con("name:" + name)]))
    Ok(mt_app("Effects", out))

fn gep_type(type_: HirType) -> Result<MType, text>:
    """Project only the declared G2 fragment, preserving every semantic field.

    Spans are intentionally outside this structural quotient and are checked
    by the separate production API preservation spec. Nominal symbols require
    declaration ownership; this bridge does not invent that ownership."""
    if type_ == nil: return Err("AbsentType")
    match type_.kind:
        case HirTypeKind.TypeParam(name, bounds):
            if bounds == nil: return Err("AbsentBounds")
            if bounds.len() != 0: return Err("UnsupportedBounds")
            Ok(mt_var(name))
        case HirTypeKind.Int(width, signed):
            val sign = if signed: "signed" else: "unsigned"
            Ok(mt_app("Int", [mt_con("{width}"), mt_con(sign)]))
        case HirTypeKind.Float(width): Ok(mt_app("Float", [mt_con("{width}")]))
        case HirTypeKind.Bool: Ok(mt_con("Bool"))
        case HirTypeKind.Char: Ok(mt_con("Char"))
        case HirTypeKind.Str: Ok(mt_con("Str"))
        case HirTypeKind.Unit: Ok(mt_con("Unit"))
        case HirTypeKind.Never: Ok(mt_con("Never"))
        case HirTypeKind.Tuple(elements):
            match gep_types(elements):
                case Ok(terms): Ok(mt_app("Tuple", terms))
                case Err(reason): Err(reason)
        case HirTypeKind.Optional(inner):
            match gep_type(inner):
                case Ok(term): Ok(mt_app("Optional", [term]))
                case Err(reason): Err(reason)
        case HirTypeKind.Function(params, returned, effects):
            match gep_types(params):
                case Err(reason): return Err(reason)
                case Ok(parameters):
                    match gep_type(returned):
                        case Err(reason): return Err(reason)
                        case Ok(result):
                            match gep_effects(effects):
                                case Err(reason): return Err(reason)
                                case Ok(annotations):
                                    Ok(mt_app("Function", [mt_app("Params", parameters), result, annotations]))
        case _: Err("UnsupportedType")
