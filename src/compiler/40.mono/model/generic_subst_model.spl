# Generic substitution / matching / specialization-key MODEL.
#
# A small, pure, total model of what 40.mono does with type variables:
# substitution, one-way matching (the inference step), the evidence order of
# a call site, and the specialization key. It has NO dependency on HIR so its
# laws can be checked exhaustively over a bounded type universe, and the
# production code (`monomorphize_integration.spl`, `monomorphize/type_subst.spl`,
# `monomorphize/mono_key.spl`) is checked AGAINST it by a differential spec.
#
# Design: doc/05_design/compiler/generics/generic_instantiation_model.md
# Laws (checked by the specs under test/01_unit/compiler/mono/model/):
#   S1 idempotence, S2 composition, S3 closedness,
#   U1 soundness, U2 most-general (binds exactly the evidenced variables),
#   I1 no evidence => Unresolved (never a default),
#   K1 key determinism, K2 key injectivity on closed types,
#   F1-F3 every variable-change kind commutes with substitution, preserves
#   closedness and invents no variable.
# Nothing here is a machine-checked PROOF: the laws are bounded-exhaustively
# checked by Simple code (Lean, the repo's proof lane, is not part of this
# module). The spec prints and asserts the universe sizes so a vacuous sweep
# fails.

# Constructor names used by the model. Arity is part of the term, not the
# name, so `Tuple` with 2 and 3 members are different terms and render apart.
pub val MT_ARRAY = "Array"
val MT_SLICE = "Slice"
pub val MT_OPTIONAL = "Optional"
pub val MT_DICT = "Dict"
val MT_RESULT = "Result"
pub val MT_TUPLE = "Tuple"
pub val MT_FN = "Fn"          # args = params..., last = return
val MT_NAMED = "Named:"   # prefix; `Named:Box` is the user type Box<...>

# Sentinel for "this argument's type is not known at the call site"; it is
# never a legal type argument and `mt_is_closed` is false on it.
val MT_UNKNOWN = "?"

enum MType:
    Var(name: text)
    Con(name: text)
    App(ctor: text, args: [MType])

fn mt_var(name: text) -> MType:
    MType.Var(name)

fn mt_con(name: text) -> MType:
    MType.Con(name)

fn mt_app(ctor: text, args: [MType]) -> MType:
    MType.App(ctor, args)

fn mt_unknown() -> MType:
    MType.Con(MT_UNKNOWN)

fn mt_is_unknown(t: MType) -> bool:
    match t:
        case MType.Con(n): n == MT_UNKNOWN
        case _: false

fn mt_render(t: MType) -> text:
    """Readable display only: names containing delimiters can collide with
    structural syntax. Use mt_key_type / mk_key for type identity."""
    match t:
        case MType.Var(n): "'" + n
        case MType.Con(n): n
        case MType.App(c, args):
            var parts: [text] = []
            for a in args:
                val at: MType = a
                parts = parts.push(mt_render(at))
            c + "<" + parts.join(",") + ">"

fn mt_render_list(ts: [MType]) -> text:
    var parts: [text] = []
    for t in ts:
        val tt: MType = t
        parts = parts.push(mt_render(tt))
    "[" + parts.join(",") + "]"

fn mt_equal(a: MType, b: MType) -> bool:
    mt_struct_eq(a, b)

fn mt_is_closed(t: MType) -> bool:
    """No variable and no unknown anywhere (production: `hir_type_is_concrete`)."""
    match t:
        case MType.Var(_): false
        case MType.Con(n): n != MT_UNKNOWN
        case MType.App(_, args):
            for a in args:
                val at: MType = a
                if not mt_is_closed(at):
                    return false
            true

fn mt_free_vars(t: MType) -> [text]:
    """Free variables in first-occurrence order, without duplicates."""
    mt_free_vars_into(t, [])

fn mt_free_vars_into(t: MType, acc: [text]) -> [text]:
    match t:
        case MType.Var(n):
            if acc.contains(n):
                acc
            else:
                acc.push(n)
        case MType.Con(_): acc
        case MType.App(_, args):
            var out = acc
            for a in args:
                val at: MType = a
                out = mt_free_vars_into(at, out)
            out

fn mt_depth(t: MType) -> i64:
    match t:
        case MType.App(_, args):
            var d = 0
            for a in args:
                val at: MType = a
                val ad = mt_depth(at)
                if ad > d:
                    d = ad
            d + 1
        case _: 0

# ----------------------------------------------------------------------------
# Substitution
# ----------------------------------------------------------------------------

struct MSubst:
    """Finite map variable-name -> type. Treated as a VALUE: every operation
    returns a new map and never mutates its input."""
    mapping: Dict<text, MType>

fn ms_empty() -> MSubst:
    MSubst(mapping: {})

fn ms_copy(s: MSubst) -> MSubst:
    var m: Dict<text, MType> = {}
    for k in s.mapping.keys():
        val key: text = k
        m[key] = s.mapping[key]
    MSubst(mapping: m)

fn ms_bind(s: MSubst, name: text, t: MType) -> MSubst:
    var out = ms_copy(s)
    out.mapping[name] = t
    out

fn ms_has(s: MSubst, name: text) -> bool:
    s.mapping.has(name)

fn ms_get(s: MSubst, name: text) -> MType:
    s.mapping[name]

fn ms_domain(s: MSubst) -> [text]:
    var out: [text] = []
    for k in s.mapping.keys():
        val key: text = k
        out = out.push(key)
    out

fn ms_render(s: MSubst) -> text:
    """Order-independent rendering (sorted by variable name)."""
    var keys = ms_domain(s)
    keys = keys.sorted()
    var parts: [text] = []
    for k in keys:
        val key: text = k
        parts = parts.push(key + ":=" + mt_render(s.mapping[key]))
    "{" + parts.join(";") + "}"

fn ms_range_closed(s: MSubst) -> bool:
    for k in s.mapping.keys():
        val key: text = k
        if not mt_is_closed(s.mapping[key]):
            return false
    true

fn ms_apply(s: MSubst, t: MType) -> MType:
    """sigma(t): replace every bound variable, recurse through applications,
    leave an unbound variable as-is (production: `substitute_type`)."""
    match t:
        case MType.Var(n):
            if s.mapping.has(n):
                s.mapping[n]
            else:
                t
        case MType.Con(_): t
        case MType.App(c, args):
            var out: [MType] = []
            for a in args:
                val at: MType = a
                out = out.push(ms_apply(s, at))
            MType.App(c, out)

fn ms_apply_list(s: MSubst, ts: [MType]) -> [MType]:
    var out: [MType] = []
    for t in ts:
        val tt: MType = t
        out = out.push(ms_apply(s, tt))
    out

fn ms_compose(outer: MSubst, inner: MSubst) -> MSubst:
    """(outer o inner): first inner, then outer.
    dom = dom inner U dom outer; inner's bindings are rewritten by outer."""
    var m: Dict<text, MType> = {}
    for k in inner.mapping.keys():
        val key: text = k
        m[key] = ms_apply(outer, inner.mapping[key])
    for k2 in outer.mapping.keys():
        val key2: text = k2
        if not m.has(key2):
            m[key2] = outer.mapping[key2]
    MSubst(mapping: m)

# ----------------------------------------------------------------------------
# One-way matching (the unifier the inference step uses)
# ----------------------------------------------------------------------------

enum MMatch:
    Bound(subst: MSubst)
    Conflict(name: text)
    Shape

fn mm_is_bound(m: MMatch) -> bool:
    match m:
        case MMatch.Bound(_): true
        case _: false

fn mm_subst(m: MMatch) -> MSubst:
    match m:
        case MMatch.Bound(s): s
        case _: ms_empty()

fn mm_render(m: MMatch) -> text:
    match m:
        case MMatch.Bound(s): "Bound" + ms_render(s)
        case MMatch.Conflict(n): "Conflict(" + n + ")"
        case MMatch.Shape: "Shape"

fn mm_match(pattern: MType, evidence: MType, acc: MSubst) -> MMatch:
    """Match a declared type (may hold variables) against evidence, extending
    `acc`. Mirrors production `bind_type_params`:
      - a variable against non-closed evidence binds nothing (no evidence);
      - a variable already bound must agree structurally, else Conflict;
      - applications must share constructor and arity (Slice also accepts
        Array), else Shape;
      - a constant pattern never fails here (the type checker's job)."""
    match pattern:
        case MType.Var(n):
            if not mt_is_closed(evidence):
                return MMatch.Bound(acc)
            if acc.mapping.has(n):
                val prev: MType = acc.mapping[n]
                if mt_equal(prev, evidence):
                    return MMatch.Bound(acc)
                return MMatch.Conflict(n)
            MMatch.Bound(ms_bind(acc, n, evidence))
        case MType.Con(_):
            MMatch.Bound(acc)
        case MType.App(pc, pargs):
            match evidence:
                case MType.App(ec, eargs):
                    val ctor_ok = pc == ec or (pc == MT_SLICE and ec == MT_ARRAY)
                    if not ctor_ok:
                        return MMatch.Shape
                    if pargs.len() != eargs.len():
                        return MMatch.Shape
                    var cur = acc
                    var i = 0
                    while i < pargs.len():
                        val pa: MType = pargs[i]
                        val ea: MType = eargs[i]
                        val r = mm_match(pa, ea, cur)
                        match r:
                            case MMatch.Bound(s): cur = s
                            case _: return r
                        i = i + 1
                    MMatch.Bound(cur)
                case _:
                    MMatch.Shape

# ----------------------------------------------------------------------------
# Call-site inference: explicit > argument evidence > expected/return type
# ----------------------------------------------------------------------------

enum MInfer:
    Resolved(args: [MType])
    Unresolved(reason: text)

val MI_NO_EVIDENCE = "no_evidence"
val MI_CONFLICT = "conflict"
val MI_SHAPE = "shape"
val MI_NAMED_ARGS = "named_args"
val MI_EXPLICIT_ARITY = "explicit_arity"
val MI_EXPLICIT_NOT_CLOSED = "explicit_not_closed"

fn mi_render(r: MInfer) -> text:
    match r:
        case MInfer.Resolved(args): "Resolved" + mt_render_list(args)
        case MInfer.Unresolved(reason): "Unresolved(" + reason + ")"

fn mi_is_resolved(r: MInfer) -> bool:
    match r:
        case MInfer.Resolved(_): true
        case _: false

fn mi_from_match(m: MMatch) -> text:
    match m:
        case MMatch.Conflict(_): MI_CONFLICT
        case MMatch.Shape: MI_SHAPE
        case _: ""

fn mi_infer(gamma: [text], params: [MType], ret: MType, explicit: [MType],
            arg_types: [MType], expected: MType, has_named_args: bool) -> MInfer:
    """Resolve the instantiation of `f<gamma>(params) -> ret` at one call site.
    `explicit` are written type arguments (empty = none), `arg_types` the
    positional argument types (`mt_unknown()` = no local type), `expected`
    the context type (`mt_unknown()` = none). Every failure is a reason;
    a variable with no evidence is never defaulted."""
    var acc = ms_empty()
    if explicit.len() > 0:
        if explicit.len() != gamma.len():
            return MInfer.Unresolved(MI_EXPLICIT_ARITY)
        var i = 0
        while i < gamma.len():
            val et: MType = explicit[i]
            if not mt_is_closed(et):
                return MInfer.Unresolved(MI_EXPLICIT_NOT_CLOSED)
            acc = ms_bind(acc, gamma[i], et)
            i = i + 1
    if has_named_args:
        return MInfer.Unresolved(MI_NAMED_ARGS)
    var j = 0
    while j < params.len() and j < arg_types.len():
        val at: MType = arg_types[j]
        if not mt_is_unknown(at):
            val pt: MType = params[j]
            val r = mm_match(pt, at, acc)
            match r:
                case MMatch.Bound(s): acc = s
                case _: return MInfer.Unresolved(mi_from_match(r))
        j = j + 1
    if not mt_is_unknown(expected) and mt_is_closed(expected):
        val r2 = mm_match(ret, expected, acc)
        match r2:
            case MMatch.Bound(s2): acc = s2
            case _: return MInfer.Unresolved(mi_from_match(r2))
    var out: [MType] = []
    for g in gamma:
        val gn: text = g
        if not acc.mapping.has(gn):
            return MInfer.Unresolved(MI_NO_EVIDENCE)
        val bound: MType = acc.mapping[gn]
        if not mt_is_closed(bound):
            return MInfer.Unresolved(MI_NO_EVIDENCE)
        out = out.push(bound)
    MInfer.Resolved(out)

# ----------------------------------------------------------------------------
# Specialization key
# ----------------------------------------------------------------------------

fn mt_key_field(value: text) -> text:
    """Length framing preserves arbitrary delimiter-bearing names."""
    "{value.len()}:" + value

fn mt_key_type(t: MType) -> text:
    """Structural identity: constructor tag, framed name, application arity."""
    match t:
        case MType.Var(name): "v" + mt_key_field(name)
        case MType.Con(name): "c" + mt_key_field(name)
        case MType.App(ctor, args): "a" + mt_key_field(ctor) + mt_key_types(args)

fn mt_key_types(types: [MType]) -> text:
    var parts: [text] = []
    for t in types:
        val tt: MType = t
        parts = parts.push(mt_key_type(tt))
    "l{types.len()}:" + parts.join("")

fn mk_key(owner_module: text, fn_name: text, type_args: [MType]) -> text:
    """Identity of an instantiation, independent of ambiguous display text.
    Framed owner and function names precede the structural argument list."""
    "m" + mt_key_field(owner_module) + "f" + mt_key_field(fn_name) + mt_key_types(type_args)

# ----------------------------------------------------------------------------
# Structural equality (independent of rendering, so K2 is not circular)
# ----------------------------------------------------------------------------

fn mt_struct_eq(a: MType, b: MType) -> bool:
    match a:
        case MType.Var(an):
            match b:
                case MType.Var(bn): an == bn
                case _: false
        case MType.Con(an2):
            match b:
                case MType.Con(bn2): an2 == bn2
                case _: false
        case MType.App(ac, aargs):
            match b:
                case MType.App(bc, bargs):
                    if ac != bc or aargs.len() != bargs.len():
                        return false
                    var i = 0
                    while i < aargs.len():
                        val x: MType = aargs[i]
                        val y: MType = bargs[i]
                        if not mt_struct_eq(x, y):
                            return false
                        i = i + 1
                    true
                case _: false

# ----------------------------------------------------------------------------
# Variable-change kinds: how a typed value moves from one place to another
# ----------------------------------------------------------------------------
#
# One step moves a value of a known type into or out of a variable-like
# place. `mf_step(kind, inputs, decl_params)` is the type the destination
# holds, or `Ill` when the step is not well typed. Laws (flow spec):
#   F1 substitution commutes: step(k, ins) = Ok(t)  =>  step(k, s(ins)) = Ok(s(t))
#      -- a well-typed step of a TEMPLATE stays well typed, at the
#      substituted type, in every specialization;
#   F2 closedness: closed inputs give a closed result;
#   F3 no invention: every variable of the result occurs in the inputs.
# For the field kinds, inputs[1] is the DECLARED field type, written over the
# struct parameters `decl_params`; it belongs to the scope of the declaration
# and is never touched by the substitution of the enclosing function.

val MF_LET = "let"                  # val x: A = e   [A, type of e]          -> A
val MF_LET_INFER = "let_infer"      # val x = e      [type of e]             -> it
val MF_ASSIGN = "assign"            # x = e          [type of x, of e]       -> type of x
val MF_PARAM = "param"              # f(e)           [param type, of e]      -> param type
val MF_RETURN = "return"            # return e       [declared, of e]        -> declared
val MF_FIELD_READ = "field_read"    # s.f            [S<args>, decl F]       -> F[P:=args]
val MF_FIELD_WRITE = "field_write"  # s.f = e        [S<args>, decl F, of e] -> F[P:=args]
val MF_ELEM_READ = "elem_read"      # xs[i]          [Array<A>]              -> A
val MF_ELEM_WRITE = "elem_write"    # xs[i] = e      [Array<A>, of e]        -> A
val MF_DICT_READ = "dict_read"      # d[k]           [Dict<K,V>, of k]       -> V
val MF_DICT_WRITE = "dict_write"    # d[k] = e       [Dict<K,V>, of k, of e] -> V
val MF_OPT_WRAP = "opt_wrap"        # val o: A? = e  [type of e]             -> Optional<it>
val MF_OPT_UNWRAP = "opt_unwrap"    # o! / Some(v)   [Optional<A>]           -> A
val MF_OPT_DEFAULT = "opt_default"  # o ?? d         [Optional<A>, of d]     -> A
val MF_CAPTURE = "capture"          # \: ... x ...   [type of x]             -> it
val MF_CLOSURE_CALL = "closure_call"  # f(e)         [Fn<P,R>, of e]         -> R
val MF_TUPLE_FIRST = "tuple_first"  # val (a, _) = t [Tuple<A,B>]            -> A
val MF_TUPLE_SECOND = "tuple_second"  # val (_, b) = t [Tuple<A,B>]          -> B
val MF_LOOP = "loop"                # for x in xs    [Array<A>]              -> A

fn mf_kinds() -> [text]:
    [MF_LET, MF_LET_INFER, MF_ASSIGN, MF_PARAM, MF_RETURN, MF_FIELD_READ,
     MF_FIELD_WRITE, MF_ELEM_READ, MF_ELEM_WRITE, MF_DICT_READ, MF_DICT_WRITE,
     MF_OPT_WRAP, MF_OPT_UNWRAP, MF_OPT_DEFAULT, MF_CAPTURE, MF_CLOSURE_CALL,
     MF_TUPLE_FIRST, MF_TUPLE_SECOND, MF_LOOP]

fn mf_arity(kind: text) -> i64:
    """Number of type inputs a kind takes."""
    if kind == MF_LET_INFER or kind == MF_ELEM_READ or kind == MF_OPT_WRAP or kind == MF_OPT_UNWRAP:
        return 1
    if kind == MF_CAPTURE or kind == MF_TUPLE_FIRST or kind == MF_TUPLE_SECOND or kind == MF_LOOP:
        return 1
    if kind == MF_FIELD_WRITE or kind == MF_DICT_WRITE:
        return 3
    2

fn mf_is_field_kind(kind: text) -> bool:
    kind == MF_FIELD_READ or kind == MF_FIELD_WRITE

enum MFlow:
    Ok(result: MType)
    Ill(reason: text)

fn mf_is_ok(f: MFlow) -> bool:
    match f:
        case MFlow.Ok(_): true
        case _: false

fn mf_result(f: MFlow) -> MType:
    match f:
        case MFlow.Ok(t): t
        case _: mt_unknown()

fn mf_render(f: MFlow) -> text:
    match f:
        case MFlow.Ok(t): "Ok(" + mt_render(t) + ")"
        case MFlow.Ill(r): "Ill(" + r + ")"

fn mf_same(dest: MType, value: MType) -> MFlow:
    if mt_struct_eq(dest, value):
        return MFlow.Ok(dest)
    MFlow.Ill("mismatch")

fn mf_app_arg(t: MType, ctor: text, arity: i64, slot: i64) -> MFlow:
    """Argument `slot` of `t` when `t` is `ctor` applied to `arity` types."""
    match t:
        case MType.App(c, args):
            if c == ctor and args.len() == arity:
                val a: MType = args[slot]
                return MFlow.Ok(a)
            MFlow.Ill("shape")
        case _: MFlow.Ill("shape")

fn mf_field_type(instance: MType, declared: MType, decl_params: [text]) -> MFlow:
    """`declared[decl_params := the arguments of instance]`. The declaration
    must be closed over its own parameters and the instance must supply
    exactly one argument per parameter."""
    for v in mt_free_vars(declared):
        val vn: text = v
        if not decl_params.contains(vn):
            return MFlow.Ill("open_declaration")
    match instance:
        case MType.App(c, args):
            if not c.starts_with(MT_NAMED) or args.len() != decl_params.len():
                return MFlow.Ill("shape")
            var s = ms_empty()
            var i = 0
            while i < decl_params.len():
                val a: MType = args[i]
                s = ms_bind(s, decl_params[i], a)
                i = i + 1
            MFlow.Ok(ms_apply(s, declared))
        case _: MFlow.Ill("shape")

fn mf_step(kind: text, inputs: [MType], decl_params: [text]) -> MFlow:
    if inputs.len() != mf_arity(kind):
        return MFlow.Ill("arity")
    val a: MType = inputs[0]
    if kind == MF_LET_INFER or kind == MF_CAPTURE:
        return MFlow.Ok(a)
    if kind == MF_OPT_WRAP:
        return MFlow.Ok(mt_app(MT_OPTIONAL, [a]))
    if kind == MF_ELEM_READ or kind == MF_LOOP:
        return mf_app_arg(a, MT_ARRAY, 1, 0)
    if kind == MF_OPT_UNWRAP:
        return mf_app_arg(a, MT_OPTIONAL, 1, 0)
    if kind == MF_TUPLE_FIRST:
        return mf_app_arg(a, MT_TUPLE, 2, 0)
    if kind == MF_TUPLE_SECOND:
        return mf_app_arg(a, MT_TUPLE, 2, 1)
    val b: MType = inputs[1]
    if kind == MF_LET or kind == MF_ASSIGN or kind == MF_PARAM or kind == MF_RETURN:
        return mf_same(a, b)
    if kind == MF_FIELD_READ:
        return mf_field_type(a, b, decl_params)
    if kind == MF_ELEM_WRITE:
        val elem = mf_app_arg(a, MT_ARRAY, 1, 0)
        if not mf_is_ok(elem):
            return elem
        return mf_same(mf_result(elem), b)
    if kind == MF_OPT_DEFAULT:
        val payload = mf_app_arg(a, MT_OPTIONAL, 1, 0)
        if not mf_is_ok(payload):
            return payload
        return mf_same(mf_result(payload), b)
    if kind == MF_DICT_READ:
        val key = mf_app_arg(a, MT_DICT, 2, 0)
        if not mf_is_ok(key):
            return key
        if not mt_struct_eq(mf_result(key), b):
            return MFlow.Ill("mismatch")
        return mf_app_arg(a, MT_DICT, 2, 1)
    if kind == MF_CLOSURE_CALL:
        val param = mf_app_arg(a, MT_FN, 2, 0)
        if not mf_is_ok(param):
            return param
        if not mt_struct_eq(mf_result(param), b):
            return MFlow.Ill("mismatch")
        return mf_app_arg(a, MT_FN, 2, 1)
    val c: MType = inputs[2]
    if kind == MF_FIELD_WRITE:
        val field = mf_field_type(a, b, decl_params)
        if not mf_is_ok(field):
            return field
        return mf_same(mf_result(field), c)
    if kind == MF_DICT_WRITE:
        val wkey = mf_app_arg(a, MT_DICT, 2, 0)
        if not mf_is_ok(wkey):
            return wkey
        if not mt_struct_eq(mf_result(wkey), b):
            return MFlow.Ill("mismatch")
        val wvalue = mf_app_arg(a, MT_DICT, 2, 1)
        if not mf_is_ok(wvalue):
            return wvalue
        return mf_same(mf_result(wvalue), c)
    MFlow.Ill("unknown_kind")

fn mf_substitute_inputs(kind: text, s: MSubst, inputs: [MType]) -> [MType]:
    """Apply the substitution of the enclosing FUNCTION to the inputs of a
    step. A declared field type (inputs[1] of a field kind) lives in the
    scope of the declaration and is left untouched."""
    var out: [MType] = []
    var i = 0
    while i < inputs.len():
        val t: MType = inputs[i]
        if i == 1 and mf_is_field_kind(kind):
            out = out.push(t)
        else:
            out = out.push(ms_apply(s, t))
        i = i + 1
    out

# ----------------------------------------------------------------------------
# TLDR template instantiation (plan P3: concrete generic TLDR view)
# ----------------------------------------------------------------------------
# A template TLDR stores each field type as its structural key
# (`mt_key_type`). The view acquirer decodes that key, substitutes the
# positional binders with THIS model's `ms_apply`, and classifies the result;
# no second substitution engine exists.

struct MKeyParse:
    t: MType
    pos: i64
    ok: bool

fn _mk_bad() -> MKeyParse:
    MKeyParse(t: mt_unknown(), pos: -1, ok: false)

fn _mk_number(key: text, pos: i64) -> [i64]:
    """[value, position after ':'] or [] when malformed."""
    var i = pos
    var n = 0
    var digits = 0
    while i < key.len() and digits < 12:
        val code = key.char_code_at(i)
        if code == 58:
            break
        if code < 48 or code > 57:
            return []
        n = n * 10 + (code - 48)
        digits = digits + 1
        i = i + 1
    if digits == 0 or i >= key.len() or key.char_code_at(i) != 58:
        return []
    [n, i + 1]

fn _mk_parse(key: text, pos: i64) -> MKeyParse:
    if pos >= key.len():
        return _mk_bad()
    val tag = key.char_at(pos)
    val num = _mk_number(key, pos + 1)
    if num.len() != 2 or num[1] + num[0] > key.len():
        return _mk_bad()
    val name = key.substring(num[1], num[1] + num[0])
    var next = num[1] + num[0]
    if tag == "v":
        return MKeyParse(t: MType.Var(name), pos: next, ok: true)
    if tag == "c":
        return MKeyParse(t: MType.Con(name), pos: next, ok: true)
    if tag != "a" or next >= key.len() or key.char_at(next) != "l":
        return _mk_bad()
    val count = _mk_number(key, next + 1)
    if count.len() != 2:
        return _mk_bad()
    next = count[1]
    var args: [MType] = []
    var k = 0
    while k < count[0]:
        val p = _mk_parse(key, next)
        if not p.ok:
            return _mk_bad()
        args = args.push(p.t)
        next = p.pos
        k = k + 1
    MKeyParse(t: MType.App(name, args), pos: next, ok: true)

fn mt_from_key(key: text) -> MKeyParse:
    """Inverse of `mt_key_type`; `ok` is false on malformed or trailing input."""
    val p = _mk_parse(key, 0)
    if not p.ok or p.pos != key.len():
        return _mk_bad()
    p

pub val MI_STATUS_CLOSED = "closed"
pub val MI_STATUS_OPEN = "open"
pub val MI_STATUS_DEPTH = "depth"
pub val MI_STATUS_MALFORMED = "malformed"

struct MInstantiated:
    t: MType
    status: text

fn ms_from_positional(binders: [text], args: [MType]) -> MSubst:
    """Positional binder -> argument substitution (caller checks arity)."""
    var s = ms_empty()
    var i = 0
    while i < binders.len() and i < args.len():
        s = ms_bind(s, binders[i], args[i])
        i = i + 1
    s

fn mt_instantiate_key(field_key: text, binders: [text], args: [MType], depth_limit: i64) -> MInstantiated:
    """Substitute a template field's binders. Classification: `depth` when
    the result nests deeper than `depth_limit` (instantiation guard), `open`
    when a free variable remains, otherwise `closed`."""
    val parsed = mt_from_key(field_key)
    if not parsed.ok:
        return MInstantiated(t: mt_unknown(), status: MI_STATUS_MALFORMED)
    val t = ms_apply(ms_from_positional(binders, args), parsed.t)
    if mt_depth(t) > depth_limit:
        return MInstantiated(t: t, status: MI_STATUS_DEPTH)
    if not mt_is_closed(t):
        return MInstantiated(t: t, status: MI_STATUS_OPEN)
    MInstantiated(t: t, status: MI_STATUS_CLOSED)
