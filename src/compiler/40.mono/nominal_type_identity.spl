# Structural type identity with module-owned nominal leaves. Display mangling
# is intentionally separate; an empty key means ownership is not established.
use compiler.hir.hir_types.*
use compiler.hir.hir_owner_name.hir_symbol_owner_module
use compiler.monomorphize.engine.mangle_type

fn mono_nominal_type_key(sym: SymbolId, symbols: SymbolTable?, module: text) -> text:
    if val table = symbols:
        if val info = table.get_symbol_raw(sym.id):
            match info.kind:
                case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait | SymbolKind.TypeAlias:
                    var declared_owner = info.defining_module ?? ""
                    if declared_owner == "": declared_owner = module
                    val owner = hir_symbol_owner_module(declared_owner)
                    if owner == "" or info.name == "": return ""
                    return "named({owner.len()}:{owner}{info.name.len()}:{info.name})"
                case _: ()
    ""

fn mono_owned_type_keys(types: [HirType], symbols: SymbolTable?, module: text) -> text:
    var parts: [text] = []
    for type_ in types:
        val key = mono_owned_type_key(type_, symbols, module)
        if key == "": return ""
        parts = parts.push(key)
    parts.join(",")

fn mono_enclosed_type_key(prefix: text, children: [HirType], suffix: text, symbols: SymbolTable?, module: text) -> text:
    val key = mono_owned_type_keys(children, symbols, module)
    if children.len() > 0 and key == "": return ""
    prefix + key + suffix

fn mono_owned_type_key(type_: HirType, symbols: SymbolTable?, module: text) -> text:
    """Canonical owner-qualified identity, or empty on missing ownership.
    Array sizes and function effects remain outside the specialization key.
    """
    if type_ == nil: return ""
    match type_.kind:
        case HirTypeKind.Named(sym, args):
            val base = mono_nominal_type_key(sym, symbols, module)
            if base == "": return ""
            if args.len() == 0: return base
            mono_enclosed_type_key(base + "<", args, ">", symbols, module)
        case HirTypeKind.Array(elem, _): mono_enclosed_type_key("[", [elem], "]", symbols, module)
        case HirTypeKind.Slice(elem): mono_enclosed_type_key("slice<", [elem], ">", symbols, module)
        case HirTypeKind.Optional(inner): mono_enclosed_type_key("opt<", [inner], ">", symbols, module)
        case HirTypeKind.Isolated(inner): mono_enclosed_type_key("iso<", [inner], ">", symbols, module)
        case HirTypeKind.Unique(inner): mono_enclosed_type_key("uniq<", [inner], ">", symbols, module)
        case HirTypeKind.Shared(inner): mono_enclosed_type_key("shared<", [inner], ">", symbols, module)
        case HirTypeKind.Weak(inner): mono_enclosed_type_key("weak<", [inner], ">", symbols, module)
        case HirTypeKind.Ref(inner, mutable): mono_enclosed_type_key("ref{mutable}<", [inner], ">", symbols, module)
        case HirTypeKind.Ptr(inner, mutable): mono_enclosed_type_key("ptr{mutable}<", [inner], ">", symbols, module)
        case HirTypeKind.Dict(k, v): mono_enclosed_type_key("dict<", [k, v], ">", symbols, module)
        case HirTypeKind.Result(ok, err): mono_enclosed_type_key("res<", [ok, err], ">", symbols, module)
        case HirTypeKind.Tuple(elems): mono_enclosed_type_key("(", elems, ")", symbols, module)
        case HirTypeKind.Union(members): mono_enclosed_type_key("union<", members, ">", symbols, module)
        case HirTypeKind.Function(params, ret, _):
            val param_key = mono_owned_type_keys(params, symbols, module)
            val return_key = mono_owned_type_key(ret, symbols, module)
            if (params.len() > 0 and param_key == "") or return_key == "": return ""
            "fn({param_key})->{return_key}"
        case HirTypeKind.Projection(base, assoc): mono_enclosed_type_key("proj<", [base], ">::{assoc}", symbols, module)
        case HirTypeKind.Tensor(elem, dims, _): mono_enclosed_type_key("tensor<", [elem], ";{dims.len()}>", symbols, module)
        case HirTypeKind.DynTrait(sym):
            val identity = mono_nominal_type_key(sym, symbols, module)
            if identity == "": return ""
            "dyn<{identity}>"
        case _: mangle_type(type_)

# P-G5: one concrete generic type use, in source spelling (`Pair<i64, f64>`
# -> name "Pair", arg_texts ["i64", "f64"]), for the TLDR `generic-spec` list.
pub struct MonoObservedGenericUseV1:
    name: text
    arg_texts: [text]

fn _mono_nominal_name_v1(sym: SymbolId, symbols: SymbolTable?) -> text:
    if val table = symbols:
        if val info = table.get_symbol_raw(sym.id):
            return info.name
    ""

# Source spelling of a concrete type, or "" when it has none the TLDR key
# parser can be asked about (callers then fail closed).
fn mono_type_source_text_v1(type_: HirType, symbols: SymbolTable?) -> text:
    if type_ == nil: return ""
    match type_.kind:
        case HirTypeKind.Int(bits, signed):
            if signed: "i{bits}" else: "u{bits}"
        case HirTypeKind.Float(bits): "f{bits}"
        case HirTypeKind.Bool: "bool"
        case HirTypeKind.Char: "char"
        case HirTypeKind.Str: "text"
        case HirTypeKind.Optional(inner):
            val s = mono_type_source_text_v1(inner, symbols)
            if s == "": "" else: s + "?"
        case HirTypeKind.Slice(elem):
            val s = mono_type_source_text_v1(elem, symbols)
            if s == "": "" else: "[" + s + "]"
        case HirTypeKind.Named(sym, args):
            val name = _mono_nominal_name_v1(sym, symbols)
            if name == "": return ""
            if args.len() == 0: return name
            var parts: [text] = []
            for a in args:
                val s = mono_type_source_text_v1(a, symbols)
                if s == "": return ""
                parts.push(s)
            name + "<" + parts.join(", ") + ">"
        case _: ""

fn _mono_children_v1(type_: HirType) -> [HirType]:
    match type_.kind:
        case HirTypeKind.Named(_sym, args): args
        case HirTypeKind.Array(elem, _): [elem]
        case HirTypeKind.Slice(elem): [elem]
        case HirTypeKind.Optional(inner): [inner]
        case HirTypeKind.Ref(inner, _): [inner]
        case HirTypeKind.Ptr(inner, _): [inner]
        case HirTypeKind.Dict(k, v): [k, v]
        case HirTypeKind.Result(ok, err): [ok, err]
        case HirTypeKind.Tuple(elems): elems
        case HirTypeKind.Union(members): members
        case HirTypeKind.Function(params, ret, _):
            var out: [HirType] = []
            for p in params: out.push(p)
            out.push(ret)
            out
        case _: []

# Every `Name<args>` occurring in `type_` (nested ones included); ok=false
# when a generic use's arguments have no source spelling.
fn mono_generic_uses_of_type_v1(type_: HirType, symbols: SymbolTable?) -> ([MonoObservedGenericUseV1], bool):
    var uses: [MonoObservedGenericUseV1] = []
    var ok = true
    if type_ == nil: return (uses, ok)
    match type_.kind:
        case HirTypeKind.Named(sym, args):
            if args.len() > 0:
                val name = _mono_nominal_name_v1(sym, symbols)
                var texts: [text] = []
                for a in args:
                    val s = mono_type_source_text_v1(a, symbols)
                    if s == "": ok = false
                    texts.push(s)
                if name == "": ok = false
                if ok: uses.push(MonoObservedGenericUseV1(name: name, arg_texts: texts))
        case _: ()
    for child in _mono_children_v1(type_):
        val (inner, inner_ok) = mono_generic_uses_of_type_v1(child, symbols)
        if not inner_ok: ok = false
        for u in inner: uses.push(u)
    (uses, ok)

export mono_owned_type_key, mono_owned_type_keys
export MonoObservedGenericUseV1, mono_type_source_text_v1, mono_generic_uses_of_type_v1
