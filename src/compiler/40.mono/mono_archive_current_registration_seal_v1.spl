# Mechanical current seal. Genuine driver prerequisite acceptance remains separate.
use compiler.mono.mono_archive_registration_types_v1.{MonoArchiveCurrentRegistrationOwnerV1}
use compiler.mono.mono_archive_registration_identity_v1.{mono_archive_current_registration_digest_v1,
    mono_archive_registration_schedule_digest_v1}
use compiler.mono.mono_archive_state_v1.{mono_archive_state_create_v1, mono_archive_state_digest_v1}
use compiler.driver.cache.hir_mono_archive_consumer_v1.{MonoArchiveRepositoryV1,
    MonoArchiveAdmissionV1, mono_archive_repository_digest_v1}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings, hir_cache_clear_last_warnings,
    hir_cache_promote_diagnostic_owner_v1}
use std.io_runtime.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

fn mono_archive_current_registration_seal_v1(current: MonoArchiveCurrentRegistrationOwnerV1,
        expected_inventory: Dict<text, text>, expected_order: [text]) -> Result<MonoArchiveAdmissionV1, text>:
    # Mechanical completion only. Actual driver prerequisite acceptance must
    # still authorize these exact current bodies and fresh state.
    if transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0 or current.registration.sealed:
        return Err("current registration seal requires closed unsealed owner")
    if not transient_scope_begin(): return Err("current registration seal scope unavailable")
    val owner = current.registration
    var valid = current.published_digest != "" and
        mono_archive_current_registration_digest_v1(current) == current.published_digest and
        owner.state.facts.feature_policy == env_get("SIMPLE_MONO_LEVELS") and
        expected_inventory.len() != 0 and expected_order.len() == expected_inventory.len() and
        owner.roots.len() == expected_order.len()
    var seen: Dict<text, bool> = {}
    var index = 0
    for name in expected_order:
        if seen.has(name) or not expected_inventory.has(name) or not owner.archives.has(name):
            valid = false
        else:
            if owner.archives[name].input.source_path != expected_inventory[name]: valid = false
        seen[name] = true
        if index >= owner.roots.len():
            valid = false
        else:
            if owner.roots[index].module_name != name: valid = false
        index = index + 1
    val repository = MonoArchiveRepositoryV1(modules: owner.archives, authority: "",
        current_bodies: current.bodies, current_cache: Some(current.cache), current_order: expected_order,
        current_mode: true, logical_mode: owner.logical_mode)
    val authority = if valid: mono_archive_repository_digest_v1(repository) else: ""
    val schedule = mono_archive_registration_schedule_digest_v1(owner.roots)
    valid = valid and authority != "" and schedule == owner.published_schedule_digest
    var facts = owner.state.facts
    facts.body_authority = authority
    val sealed_state = mono_archive_state_create_v1(facts)
    val proof = if valid: sha256_text("mono-current-registration-sealed-v1\n" + authority + "\n" +
        mono_archive_state_digest_v1(sealed_state) + "\n" + schedule + "\n" + current.published_digest + "\n{owner.epoch}") else: ""
    val paused = transient_scope_pause()
    # @workaround bug=a174_transient_promote_inference_2026_10_16 recover=03d33d497ac6d1408683493f74ff9db434e4cfa3 reason=retain-explicit-text-owner-at-generic-promotion
    val owned = if paused and valid: transient_promote<text>(authority) and transient_promote<text>(schedule) and transient_promote<text>(proof) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not ended or not cache_owned or (valid and not owned): panic("current registration seal ownership")
    if not valid: return Err("current registration ordered inventory refused")
    var published_facts = owner.state.facts
    published_facts.body_authority = authority
    owner.state.facts = published_facts
    owner.sealed = true
    owner.sealed_schedule_digest = schedule
    current.sealed_digest = proof
    Ok(MonoArchiveAdmissionV1(repository: MonoArchiveRepositoryV1(modules: owner.archives, authority: authority,
        current_bodies: current.bodies, current_cache: Some(current.cache), current_order: expected_order, current_mode: true), state: owner.state))

export mono_archive_current_registration_seal_v1
