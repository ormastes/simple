# Direct-pass placement evidence, separate from archived final-reader authority.
# The owner publishes only scalar/text records: no HIR graph or callable body
# escapes through this process-local inventory. Never mutate a returned array.
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

pub struct MonoSelectiveFunctionPlacementV1:
    logical_key: text
    origin_logical_key: text
    symbol: i64
    name: text
    complete_function_digest: text

var _mono_selective_placements_owner_v1: [MonoSelectiveFunctionPlacementV1]? = nil

pub fn mono_selective_emission_reset_v1():
    # Nil revokes the prior inventory even if this invocation fails before
    # collection or returns early with no input modules.
    _mono_selective_placements_owner_v1 = nil

pub fn mono_selective_emission_publish_v1(rows: [MonoSelectiveFunctionPlacementV1]) -> bool:
    # Own this scope explicitly. An occupied caller lease is never paused,
    # promoted or closed here; absence of publication makes export fail closed.
    mono_selective_emission_reset_v1()
    if transient_array_scope_state_v1() != 0: return false
    if not transient_scope_begin(): return false
    var owned: [MonoSelectiveFunctionPlacementV1] = []
    var index = 0
    while index < rows.len():
        val row: MonoSelectiveFunctionPlacementV1 = rows[index]
        owned.push(MonoSelectiveFunctionPlacementV1(logical_key: row.logical_key,
            origin_logical_key: row.origin_logical_key, symbol: row.symbol,
            name: row.name, complete_function_digest: row.complete_function_digest))
        index = index + 1
    val paused = transient_scope_pause()
    val promoted = paused and transient_promote(owned)
    val ended = transient_scope_end()
    if not paused or not promoted or not ended: return false
    _mono_selective_placements_owner_v1 = Some(owned)
    true

pub fn mono_selective_emission_publication_v1() -> Result<[MonoSelectiveFunctionPlacementV1], text>:
    if val rows = _mono_selective_placements_owner_v1:
        return Ok(rows)
    Err("selective MIR direct monomorphization placement publication unavailable")
