# Body-free nominal declarations. Only scratch workers hydrate SymbolTables.
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.Span
use compiler.common.dependency.visibility.Visibility
use compiler.hir.hir_owner_name.hir_symbol_owner_module
use compiler.hir.hir_codec_support.HirCodecWriter
use compiler.hir.generated.hir_codec.{hc_enc_symbol_kind, hc_enc_visibility, hc_enc_span,
    hc_dec_symbol_kind, hc_dec_visibility, hc_dec_span}
use compiler.frontend.core.flat_pool_codec.FlatPoolReader
use std.common.crypto.sha256.sha256_text

struct MonoArchiveNominalDeclV2:
    module_name: text
    id: i64
    name: text
    owner: text
    kind: SymbolKind
    visibility: Visibility
    is_public: bool
    is_mutable: bool
    builtin_method_tag: i64
    span: Span
    qualified_id: i64

fn mono_archive_nominal_kind_v2(kind: SymbolKind) -> bool:
    match kind:
        case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait: true
        case _: false

fn mono_archive_nominal_project_v2(module: text, table: SymbolTable) -> Dict<text, MonoArchiveNominalDeclV2>:
    var rows: Dict<text, MonoArchiveNominalDeclV2> = {}
    for id in table.symbols.keys().sort():
        val symbol: HirSymbol = table.symbols[id]
        if not mono_archive_nominal_kind_v2(symbol.kind): continue
        val stored = symbol.defining_module ?? ""
        val owner = hir_symbol_owner_module(if stored == "": module else: stored)
        rows["{module}#{id}"] = MonoArchiveNominalDeclV2(module_name: module,
            id: symbol.id.id, name: symbol.name, owner: owner, kind: symbol.kind,
            visibility: symbol.visibility, is_public: symbol.is_public,
            is_mutable: symbol.is_mutable, builtin_method_tag: symbol.builtin_method_tag,
            span: symbol.span, qualified_id: table.lookup_qualified_type_raw(owner, symbol.name))
    rows

fn mono_archive_nominal_put_v2(writer: HirCodecWriter, row: MonoArchiveNominalDeclV2):
    writer.put_text(row.module_name)
    writer.put_i64(row.id)
    writer.put_text(row.name)
    writer.put_text(row.owner)
    hc_enc_symbol_kind(writer, row.kind)
    hc_enc_visibility(writer, row.visibility)
    writer.put_bool(row.is_public)
    writer.put_bool(row.is_mutable)
    writer.put_i64(row.builtin_method_tag)
    hc_enc_span(writer, row.span)
    writer.put_i64(row.qualified_id)

fn mono_archive_nominal_digest_v2(row: MonoArchiveNominalDeclV2) -> text:
    if row.id < 0 or row.module_name == "" or row.name == "" or row.owner == "" or
            not mono_archive_nominal_kind_v2(row.kind) or row.qualified_id < -1: return ""
    var writer = HirCodecWriter.create()
    mono_archive_nominal_put_v2(writer, row)
    if not writer.ok: return ""
    sha256_text("mono-archive-nominal-declaration-v2\n" + writer.finish())

fn mono_archive_nominal_rows_put_v2(writer: HirCodecWriter, rows: Dict<text, MonoArchiveNominalDeclV2>):
    writer.put_i64(rows.len())
    for key in rows.keys().sort():
        if key != "{rows[key].module_name}#{rows[key].id}" or mono_archive_nominal_digest_v2(rows[key]) == "":
            writer.reject("nominal declaration identity refused")
            return
        writer.put_text(key)
        mono_archive_nominal_put_v2(writer, rows[key])

fn mono_archive_nominal_index_put_v2(writer: HirCodecWriter, index: Dict<text, [text]>,
        rows: Dict<text, MonoArchiveNominalDeclV2>):
    var seen: Dict<text, bool> = {}
    writer.put_i64(index.len())
    for module in index.keys().sort():
        writer.put_text(module)
        writer.put_i64(index[module].len())
        for key in index[module].sort():
            if seen.has(key) or not rows.has(key) or rows[key].module_name != module:
                writer.reject("nominal module index differs from declaration owner")
                return
            seen[key] = true
            writer.put_text(key)
    if seen.len() != rows.len(): writer.reject("nominal module index is incomplete")

fn mono_archive_nominal_imports_for_module_v2(keys: Dict<text, [text]>,
        rows: Dict<text, MonoArchiveNominalDeclV2>, module: text) -> Dict<text, MonoArchiveNominalDeclV2>:
    var selected: Dict<text, MonoArchiveNominalDeclV2> = {}
    if keys.has(module):
        for key in keys[module]:
            if rows.has(key): selected[key] = rows[key]
    selected

# Validate a complete prospective overlay before mutating the target table.
fn mono_archive_nominal_install_v2(table: SymbolTable, module: text,
        rows: Dict<text, MonoArchiveNominalDeclV2>) -> bool:
    for key in rows.keys().sort():
        val row: MonoArchiveNominalDeclV2 = rows[key]
        if row.module_name != module: continue
        if key != "{module}#{row.id}" or mono_archive_nominal_digest_v2(row) == "": return false
        if table.structural_union_owners.has(row.id): return false
        if table.symbols.has(row.id):
            val original = table.symbols[row.id]
            val stored = original.defining_module ?? ""
            val owner = hir_symbol_owner_module(if stored == "": module else: stored)
            if original.id.id != row.id or original.kind != row.kind or original.name != row.name or owner != row.owner:
                return false
        if row.qualified_id >= 0:
            val binding = "{module}#{row.qualified_id}"
            if not rows.has(binding): return false
            val canonical: MonoArchiveNominalDeclV2 = rows[binding]
            if canonical.module_name != module or canonical.owner != row.owner or canonical.name != row.name or canonical.kind != row.kind:
                return false
            val prior = table.lookup_qualified_type_raw(row.owner, row.name)
            if prior >= 0 and prior != row.qualified_id: return false
    for key in rows.keys().sort():
        val row: MonoArchiveNominalDeclV2 = rows[key]
        if row.module_name != module: continue
        if not table.symbols.has(row.id):
            table.symbols[row.id] = HirSymbol(id: SymbolId(id: row.id), name: row.name,
                kind: row.kind, type_: nil, scope: table.current_scope, span: row.span,
                visibility: row.visibility, is_public: row.is_public, is_mutable: row.is_mutable,
                defining_module: Some(row.owner), builtin_method_tag: row.builtin_method_tag, generic_param_count: 0)
        if table.next_symbol_id <= row.id: table.next_symbol_id = row.id + 1
        if row.qualified_id >= 0:
            table.bind_qualified_type(row.owner, row.name, SymbolId(id: row.qualified_id))
    true

fn mono_archive_nominal_rows_get_v2(reader: FlatPoolReader) -> Dict<text, MonoArchiveNominalDeclV2>:
    var rows: Dict<text, MonoArchiveNominalDeclV2> = {}
    val count = reader.next_len()
    if count > 100000:
        reader.ok = false
        return rows
    var index = 0
    while index < count and reader.ok:
        val key = reader.decode_text(reader.next())
        val module = reader.decode_text(reader.next())
        val id = reader.next_i64()
        val name = reader.decode_text(reader.next())
        val owner = reader.decode_text(reader.next())
        val kind_position = reader.pos
        val kind_tag = reader.next_i64()
        if not [5, 6, 7, 9].contains(kind_tag):
            reader.ok = false
            return rows
        reader.pos = kind_position
        val kind = hc_dec_symbol_kind(reader)
        val visibility_position = reader.pos
        val visibility_tag = reader.next_i64()
        if visibility_tag < 0 or visibility_tag > 5:
            reader.ok = false
            return rows
        reader.pos = visibility_position
        val visibility = hc_dec_visibility(reader)
        val public_tag = reader.next_i64()
        val mutable_tag = reader.next_i64()
        if (public_tag != 0 and public_tag != 1) or (mutable_tag != 0 and mutable_tag != 1):
            reader.ok = false
            return rows
        val public_value = public_tag == 1
        val mutable_value = mutable_tag == 1
        val tag = reader.next_i64()
        val span = hc_dec_span(reader)
        val qualified = reader.next_i64()
        val row = MonoArchiveNominalDeclV2(module_name: module, id: id, name: name,
            owner: owner, kind: kind, visibility: visibility, is_public: public_value,
            is_mutable: mutable_value, builtin_method_tag: tag, span: span, qualified_id: qualified)
        if rows.has(key) or key != "{module}#{id}" or mono_archive_nominal_digest_v2(row) == "":
            reader.ok = false
            return rows
        rows[key] = row
        index = index + 1
    rows

export MonoArchiveNominalDeclV2, mono_archive_nominal_kind_v2
export mono_archive_nominal_project_v2, mono_archive_nominal_digest_v2
export mono_archive_nominal_put_v2, mono_archive_nominal_rows_put_v2, mono_archive_nominal_install_v2
export mono_archive_nominal_rows_get_v2
export mono_archive_nominal_index_put_v2, mono_archive_nominal_imports_for_module_v2
