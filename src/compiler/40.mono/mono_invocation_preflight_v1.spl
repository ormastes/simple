use compiler.mono.mono_preflight_visit_08_v1.*
use compiler.mono.mono_preflight_visit_09_v1.*

pub fn mono_preflight_schema_matches_v1(codec: text, canonical: text,
        rules: text, flatpool: text) -> bool:
    (codec == "spl-hircodec-v8" and canonical == "spl-hircodec-canonical-v4" and
        flatpool == "spl-flatpool-v7" and rules ==
        ("nil-before-present;i64-signed;symbol-id-signed;text-unsigned-utf8;" +
        "stable-bottom-up-merge;duplicate-reject;strict-flatpool-text-v1"))

fn mono_preflight_begin_v1(budget: MonoInvocationBudgetV1) -> bool:
    if budget.failure != "": return false
    if not mono_preflight_schema_matches_v1(HIR_CODEC_VERSION,
            HIR_CANONICAL_CODEC_VERSION, HIR_CANONICAL_CODEC_RULES_V1,
            FLAT_POOL_CODEC_VERSION):
        budget.fail_v1("E-MONO-SCHEMA: preflight codec/schema version is stale")
        return false
    true

pub fn mono_preflight_module_v1(module: HirModule,
        budget: MonoInvocationBudgetV1) -> Result<MonoPreflightFactsV1, text>:
    if not mono_preflight_begin_v1(budget): return Err(budget.failure)
    var walk = MonoPreflightWalkV1(budget: budget, start_depth: budget.hir_depth)
    walk.mono_pf_hir_module_v1(module)
    walk.finish_v1()

pub fn mono_preflight_function_v1(function: HirFunction,
        budget: MonoInvocationBudgetV1) -> Result<MonoPreflightFactsV1, text>:
    if not mono_preflight_begin_v1(budget): return Err(budget.failure)
    var walk = MonoPreflightWalkV1(budget: budget, start_depth: budget.hir_depth)
    walk.mono_pf_hir_function_v1(function)
    walk.finish_v1()

pub fn mono_preflight_type_v1(type_: HirType,
        budget: MonoInvocationBudgetV1) -> Result<MonoPreflightFactsV1, text>:
    if not mono_preflight_begin_v1(budget): return Err(budget.failure)
    var walk = MonoPreflightWalkV1(budget: budget, start_depth: budget.hir_depth)
    walk.mono_pf_hir_type_v1(type_)
    walk.finish_v1()

