# One unchanged publication identity/key codec shared by actual and replay consumers.
use compiler.hir.hir_codec_support.{HirCodecWriter}
use std.common.crypto.sha256.{sha256_text}

struct MonoArchiveSelectedFunctionV1:
    module_name: text
    input_archive_key: text
    input_body_digest: text
    output_archive_key: text
    output_body_digest: text
    output_function_digest: text
    target_symbol: i64
    target_name: text
    stage: text
    delta_digest: text
    function_archive_key: text

fn mono_archive_selected_record_key_v1(selected: MonoArchiveSelectedFunctionV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text(selected.module_name)
    writer.put_text(selected.input_archive_key)
    writer.put_text(selected.input_body_digest)
    writer.put_text(selected.output_body_digest)
    writer.put_text(selected.output_function_digest)
    writer.put_i64(selected.target_symbol)
    writer.put_text(selected.target_name)
    writer.put_text(selected.stage)
    writer.put_text(selected.delta_digest)
    if not writer.ok: return ""
    sha256_text("mono-function-record-key-v1\n" + writer.finish())

fn mono_archive_selected_output_key_v1(selected: MonoArchiveSelectedFunctionV1) -> text:
    var writer = HirCodecWriter.create()
    writer.put_text(selected.module_name)
    writer.put_text(selected.input_archive_key)
    writer.put_text(selected.input_body_digest)
    writer.put_text(selected.output_body_digest)
    writer.put_text(selected.output_function_digest)
    writer.put_i64(selected.target_symbol)
    writer.put_text(selected.target_name)
    writer.put_text(selected.stage)
    writer.put_text(selected.delta_digest)
    writer.put_text(selected.function_archive_key)
    if not writer.ok: return ""
    sha256_text("mono-function-artifact-v1\n" + writer.finish())

export MonoArchiveSelectedFunctionV1
export mono_archive_selected_record_key_v1, mono_archive_selected_output_key_v1
