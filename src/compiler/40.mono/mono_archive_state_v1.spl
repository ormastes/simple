# Compact read-only facts and explicit body-consumer publication delta.
use compiler.hir.hir_types.{HirType, SymbolId, SymbolTable, HirSymbol}
use compiler.hir.hir_definitions.{HirTypeParam}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_type, hc_enc_hir_type_param}
use compiler.mono.monomorphize_integration.{MonomorphizationPass, mono_type_identity, mono_sym_key}
use compiler.mono.mono_archive_types_v1.{MonoTemplateBodyModeV1, MonoTemplateSignatureV1, MonoTemplateRecipeV1, MonoSpecializationRequestV1, mono_template_signature_v1, mono_template_signature_digest_v1, mono_archive_put_type_v1}
use std.io_runtime.{env_get}
use std.common.crypto.sha256.{sha256_text}

type MonoDeclaredTypeFactsV1 = Dict<text, HirType>

struct MonoArchiveFactsV1:
    body_authority: text
    feature_policy: text
    templates: Dict<text, MonoTemplateSignatureV1>
    recipes: Dict<text, MonoTemplateRecipeV1>
    symbol_identities: Dict<text, text>
    initial_symbol: i64
    sym_names: Dict<text, text>
    fn_returns: Dict<text, HirType>
    fn_sigs: Dict<text, HirType>
    named_types: Dict<text, HirType>
    named_ambiguous: Dict<text, bool>
    named_symbol_names: Dict<text, text>
    field_types: Dict<text, HirType>
    field_owner_modules: Dict<text, text>
    enum_payload_types: Dict<text, HirType>
    module_paths: Dict<text, text>
    template_module: Dict<text, text>
    generic_methods: Dict<text, text>
    generic_method_rejected: Dict<text, text>
    generic_type_params: Dict<text, [HirTypeParam]>
    generic_type_modules: Dict<text, text>
    generic_type_field_names: Dict<text, [text]>
    generic_type_fields: Dict<text, HirType>
    declared_global_types: MonoDeclaredTypeFactsV1

class MonoArchiveStateV1:
    facts: MonoArchiveFactsV1
    spec_symbols: Dict<text, i64>
    spec_display: Dict<text, text>
    spec_signatures: Dict<text, MonoTemplateSignatureV1>
    reported_once: Dict<text, bool>
    unresolved_templates: Dict<text, bool>
    fn_returns: Dict<text, HirType>
    sym_names: Dict<text, text>
    queue: [MonoSpecializationRequestV1]
    emitted: Dict<text, text>
    cursor: i64
    next_symbol: i64
    epoch: i64

struct MonoArchiveDeltaV1:
    base_digest: text
    base_epoch: i64
    next_symbol: i64
    advance_cursor: bool
    requests: [MonoSpecializationRequestV1]
    signatures: Dict<text, MonoTemplateSignatureV1>
    spec_display: Dict<text, text>
    reported_once: Dict<text, bool>
    unresolved_templates: Dict<text, bool>
    diagnostics: [text]
    warnings: [text]
    call_sites_found: i64
    specializations_created: i64
    unresolved_generic_calls: i64

fn mono_archive_facts_from_collector_v1(pass_: MonomorphizationPass, body_authority: text) -> Result<MonoArchiveFactsV1, text>:
    # Requires the actual collection pass before roots/worklist, never a fake
    # provider HirModule projection. This seam alone does not reclaim that pass.
    if body_authority.len() != 64 or pass_.specialized_functions.len() != 0 or pass_.spec_queue.len() != 0:
        return Err("mono facts require an unrewritten actual collector")
    var templates: Dict<text, MonoTemplateSignatureV1> = {}
    for name in pass_.generic_functions.keys():
        templates[name] = mono_template_signature_v1(pass_.generic_functions[name])
    var identities: Dict<text, text> = {}
    for module_name in pass_.module_symbols.keys():
        val symbols: SymbolTable = pass_.module_symbols[module_name]
        # Strings keyed by original module+id preserve exact name/owner lookup,
        # including imported aliases and diagnostic inputs of unusual kinds.
        # No SymbolTable, HirSymbol or local-scope object enters these facts.
        for raw_id in symbols.symbols.keys():
            val symbol: HirSymbol = symbols.symbols[raw_id]
            identities[mono_sym_key(module_name, symbol.id.id)] = mono_type_identity(symbols, symbol.id, module_name)
    Ok(MonoArchiveFactsV1(body_authority: body_authority,
        feature_policy: env_get("SIMPLE_MONO_LEVELS"), templates: templates,
        recipes: pass_.template_recipes, symbol_identities: identities,
        initial_symbol: pass_.next_symbol,
        sym_names: pass_.sym_names,
        fn_returns: pass_.fn_returns,
        fn_sigs: pass_.fn_sigs,
        named_types: pass_.named_types,
        named_ambiguous: pass_.named_ambiguous,
        named_symbol_names: pass_.named_symbol_names,
        field_types: pass_.field_types,
        field_owner_modules: pass_.field_owner_modules,
        enum_payload_types: pass_.enum_payload_types,
        module_paths: pass_.module_paths,
        template_module: pass_.template_module,
        generic_methods: pass_.generic_methods,
        generic_method_rejected: pass_.generic_method_rejected,
        generic_type_params: pass_.generic_type_params,
        generic_type_modules: pass_.generic_type_modules,
        generic_type_field_names: pass_.generic_type_field_names,
        generic_type_fields: pass_.generic_type_fields,
        declared_global_types: pass_.declared_global_types))

fn mono_archive_state_create_v1(facts: MonoArchiveFactsV1) -> MonoArchiveStateV1:
    MonoArchiveStateV1(facts: facts, spec_symbols: {}, spec_display: {},
        spec_signatures: {}, reported_once: {}, unresolved_templates: {},
        fn_returns: {}, sym_names: {}, queue: [], emitted: {}, cursor: 0,
        next_symbol: facts.initial_symbol, epoch: 0)

# Deterministic framed codec projections; all temporary encodings stay in the
# consumer scope. The exact types, bounds, spans and array sizes are included.
fn mono_archive_put_types_v1(w: HirCodecWriter, values: Dict<text, HirType>):
    w.put_i64(values.len())
    for key in values.keys().sort():
        w.put_text(key)
        mono_archive_put_type_v1(w, values[key])

fn mono_archive_put_texts_v1(w: HirCodecWriter, values: Dict<text, text>):
    w.put_i64(values.len())
    for key in values.keys().sort():
        w.put_text(key)
        w.put_text(values[key])

fn mono_archive_put_flags_v1(w: HirCodecWriter, values: Dict<text, bool>):
    w.put_i64(values.len())
    for key in values.keys().sort():
        w.put_text(key)
        w.put_bool(values[key])

fn mono_archive_put_request_v1(w: HirCodecWriter, request: MonoSpecializationRequestV1):
    w.put_text(request.template_name)
    w.put_text(request.module_name)
    w.put_text(request.mangled_name)
    w.put_i64(request.symbol_id)
    w.put_i64(request.type_args.len())
    for arg in request.type_args: mono_archive_put_type_v1(w, arg)

fn mono_archive_state_digest_v1(state: MonoArchiveStateV1) -> text:
    var w = HirCodecWriter.create()
    val facts = state.facts
    w.put_text(facts.body_authority)
    w.put_text(facts.feature_policy)
    w.put_i64(facts.initial_symbol)
    w.put_i64(facts.templates.len())
    for name in facts.templates.keys().sort():
        w.put_text(name)
        w.put_text(mono_template_signature_digest_v1(facts.templates[name]))
        if not facts.recipes.has(name): return ""
        val recipe: MonoTemplateRecipeV1 = facts.recipes[name]
        w.put_text(recipe.module_name)
        w.put_i64(recipe.original_symbol.id)
        w.put_text(recipe.template_name)
        w.put_bool(recipe.inherent_method)
        for params in [recipe.canonical_type_params, recipe.bound_type_params]:
            w.put_i64(params.len())
            for param in params: hc_enc_hir_type_param(w, param)
    mono_archive_put_texts_v1(w, facts.symbol_identities)
    mono_archive_put_texts_v1(w, facts.sym_names)
    mono_archive_put_types_v1(w, facts.fn_returns)
    mono_archive_put_types_v1(w, facts.fn_sigs)
    mono_archive_put_types_v1(w, facts.named_types)
    mono_archive_put_flags_v1(w, facts.named_ambiguous)
    mono_archive_put_texts_v1(w, facts.named_symbol_names)
    mono_archive_put_types_v1(w, facts.field_types)
    mono_archive_put_texts_v1(w, facts.field_owner_modules)
    mono_archive_put_types_v1(w, facts.enum_payload_types)
    mono_archive_put_texts_v1(w, facts.module_paths)
    mono_archive_put_texts_v1(w, facts.template_module)
    mono_archive_put_texts_v1(w, facts.generic_methods)
    mono_archive_put_texts_v1(w, facts.generic_method_rejected)
    w.put_i64(facts.generic_type_params.len())
    for key in facts.generic_type_params.keys().sort():
        w.put_text(key)
        val values = facts.generic_type_params[key]
        w.put_i64(values.len())
        for value in values: hc_enc_hir_type_param(w, value)
    mono_archive_put_texts_v1(w, facts.generic_type_modules)
    w.put_i64(facts.generic_type_field_names.len())
    for key in facts.generic_type_field_names.keys().sort():
        w.put_text(key)
        val values = facts.generic_type_field_names[key]
        w.put_i64(values.len())
        for value in values: w.put_text(value)
    mono_archive_put_types_v1(w, facts.generic_type_fields)
    mono_archive_put_types_v1(w, facts.declared_global_types)
    w.put_i64(state.epoch)
    w.put_i64(state.cursor)
    w.put_i64(state.next_symbol)
    w.put_i64(state.spec_symbols.len())
    for key in state.spec_symbols.keys().sort():
        w.put_text(key)
        w.put_i64(state.spec_symbols[key])
    mono_archive_put_texts_v1(w, state.spec_display)
    w.put_i64(state.spec_signatures.len())
    for key in state.spec_signatures.keys().sort():
        w.put_text(key)
        w.put_text(mono_template_signature_digest_v1(state.spec_signatures[key]))
    mono_archive_put_flags_v1(w, state.reported_once)
    mono_archive_put_flags_v1(w, state.unresolved_templates)
    mono_archive_put_types_v1(w, state.fn_returns)
    mono_archive_put_texts_v1(w, state.sym_names)
    w.put_i64(state.queue.len())
    for request in state.queue: mono_archive_put_request_v1(w, request)
    mono_archive_put_texts_v1(w, state.emitted)
    if not w.ok: return ""
    sha256_text("mono-archive-state-v1\n" + w.finish())

fn mono_archive_scratch_pass_v1(state: MonoArchiveStateV1) -> MonomorphizationPass:
    var worker = MonomorphizationPass.create()
    val facts = state.facts
    worker.template_body_mode = MonoTemplateBodyModeV1.ArchiveRequests
    worker.archive_template_signatures = facts.templates
    worker.archive_symbol_identities = facts.symbol_identities
    worker.template_recipes = facts.recipes
    worker.next_symbol = state.next_symbol
    worker.fn_sigs = facts.fn_sigs
    worker.named_types = facts.named_types
    worker.named_ambiguous = facts.named_ambiguous
    worker.named_symbol_names = facts.named_symbol_names
    worker.field_types = facts.field_types
    worker.field_owner_modules = facts.field_owner_modules
    worker.enum_payload_types = facts.enum_payload_types
    worker.module_paths = facts.module_paths
    worker.template_module = facts.template_module
    worker.generic_methods = facts.generic_methods
    worker.generic_method_rejected = facts.generic_method_rejected
    worker.generic_type_params = facts.generic_type_params
    worker.generic_type_modules = facts.generic_type_modules
    worker.generic_type_field_names = facts.generic_type_field_names
    worker.generic_type_fields = facts.generic_type_fields
    worker.declared_global_types = facts.declared_global_types
    # Only these maps are mutated by rewrite_function/request_specialization.
    # Clone their compact row indexes into scratch rather than borrowing a
    # mutable resident dictionary. Other declaration maps are read-only.
    for key in facts.fn_returns.keys(): worker.fn_returns[key] = facts.fn_returns[key]
    for key in state.fn_returns.keys(): worker.fn_returns[key] = state.fn_returns[key]
    for key in facts.sym_names.keys(): worker.sym_names[key] = facts.sym_names[key]
    for key in state.sym_names.keys(): worker.sym_names[key] = state.sym_names[key]
    for key in state.spec_symbols.keys(): worker.spec_symbols[key] = state.spec_symbols[key]
    for key in state.spec_display.keys(): worker.spec_display[key] = state.spec_display[key]
    for key in state.spec_signatures.keys(): worker.archive_specialized_signatures[key] = state.spec_signatures[key]
    for key in state.reported_once.keys(): worker.reported_once[key] = state.reported_once[key]
    for key in state.unresolved_templates.keys(): worker.unresolved_templates[key] = state.unresolved_templates[key]
    worker

fn mono_archive_delta_v1(state: MonoArchiveStateV1, worker: MonomorphizationPass, base: text, advance: bool) -> MonoArchiveDeltaV1:
    var displays: Dict<text, text> = {}
    var once: Dict<text, bool> = {}
    var unresolved: Dict<text, bool> = {}
    var signatures: Dict<text, MonoTemplateSignatureV1> = {}
    for request in worker.archive_requests:
        signatures[request.mangled_name] = worker.archive_specialized_signatures[request.mangled_name]
    for key in worker.spec_display.keys():
        if not state.spec_display.has(key): displays[key] = worker.spec_display[key]
    for key in worker.reported_once.keys():
        if not state.reported_once.has(key): once[key] = worker.reported_once[key]
    for key in worker.unresolved_templates.keys():
        if not state.unresolved_templates.has(key): unresolved[key] = worker.unresolved_templates[key]
    MonoArchiveDeltaV1(base_digest: base, base_epoch: state.epoch,
        next_symbol: worker.next_symbol, advance_cursor: advance,
        requests: worker.archive_requests, signatures: signatures, spec_display: displays,
        reported_once: once, unresolved_templates: unresolved,
        diagnostics: worker.diagnostics, warnings: worker.warnings,
        call_sites_found: worker.stats.call_sites_found,
        specializations_created: worker.stats.specializations_created,
        unresolved_generic_calls: worker.stats.unresolved_generic_calls)

fn mono_archive_delta_digest_v1(delta: MonoArchiveDeltaV1) -> text:
    var w = HirCodecWriter.create()
    w.put_text(delta.base_digest)
    w.put_i64(delta.base_epoch)
    w.put_i64(delta.next_symbol)
    w.put_bool(delta.advance_cursor)
    w.put_i64(delta.requests.len())
    for request in delta.requests: mono_archive_put_request_v1(w, request)
    w.put_i64(delta.signatures.len())
    for key in delta.signatures.keys().sort():
        w.put_text(key)
        w.put_text(mono_template_signature_digest_v1(delta.signatures[key]))
    mono_archive_put_texts_v1(w, delta.spec_display)
    mono_archive_put_flags_v1(w, delta.reported_once)
    mono_archive_put_flags_v1(w, delta.unresolved_templates)
    for lines in [delta.diagnostics, delta.warnings]:
        w.put_i64(lines.len())
        for line in lines: w.put_text(line)
    w.put_i64(delta.call_sites_found)
    w.put_i64(delta.specializations_created)
    w.put_i64(delta.unresolved_generic_calls)
    if not w.ok: return ""
    sha256_text("mono-archive-delta-v1\n" + w.finish())

export MonoArchiveFactsV1, MonoArchiveStateV1, MonoArchiveDeltaV1
export mono_archive_facts_from_collector_v1, mono_archive_state_create_v1
export mono_archive_state_digest_v1, mono_archive_scratch_pass_v1, mono_archive_delta_v1
export mono_archive_delta_digest_v1
