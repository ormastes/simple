# Body-free registration schemas shared below collector and seal publication.
use compiler.hir.hir_types.{HirType}
use compiler.hir.hir_definitions.{HirTypeParam}
use compiler.mono.mono_archive_types_v1.{MonoTemplateSignatureV1, MonoTemplateRecipeV1}
use compiler.mono.mono_archive_state_v1.{MonoArchiveStateV1}
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyV1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}

use compiler.mono.mono_archive_nominal_v2.{MonoArchiveNominalDeclV2}

# Each variant owns exactly one declaration row family; expression defaults,
# full functions/structs/classes and symbol tables cannot occur in its schema.
enum MonoArchiveRegistrationRowV1:
    SymbolName(key: text, value: text)
    FunctionReturn(key: text, value: HirType)
    FunctionSignature(key: text, value: HirType)
    NamedType(key: text, value: HirType)
    NamedAmbiguous(key: text, value: bool)
    NamedSymbolName(key: text, value: text)
    FieldType(key: text, value: HirType)
    FieldOwner(key: text, value: text)
    EnumPayloadType(key: text, value: HirType)
    ModulePath(key: text, value: text)
    TemplateModule(key: text, value: text)
    GenericMethod(key: text, value: text)
    RejectedMethod(key: text, value: text)
    GenericTypeParams(key: text, value: [HirTypeParam])
    GenericTypeModule(key: text, value: text)
    GenericFieldNames(key: text, value: [text])
    GenericFieldType(key: text, value: HirType)
    DeclaredGlobalType(key: text, value: HirType)
    TemplateSignature(key: text, value: MonoTemplateSignatureV1)
    TemplateRecipe(key: text, value: MonoTemplateRecipeV1)
    SymbolIdentity(key: text, value: text)
    NominalDeclarationV2(key: text, value: MonoArchiveNominalDeclV2)
    SymbolProjection(key: text, value: text)

struct MonoArchiveRootOrderV1:
    module_name: text
    symbols: [i64]

class MonoArchiveRegistrationOwnerV1:
    state: MonoArchiveStateV1
    archives: Dict<text, HirBodyArchiveV1>
    roots: [MonoArchiveRootOrderV1]
    generic_functions: i64
    generic_structs: i64
    generic_classes: i64
    epoch: i64
    sealed: bool
    published_schedule_digest: text
    sealed_schedule_digest: text
    logical_mode: bool = false

struct MonoArchiveRegistrationReceiptV1:
    archive: HirBodyArchiveV1
    base_digest: text
    base_epoch: i64
    rows: [MonoArchiveRegistrationRowV1]
    roots: [i64]
    next_symbol: i64
    generic_functions: i64
    generic_structs: i64
    generic_classes: i64
    seal: text
    logical_name: text = ""

# The original publisher cannot accept this typed receipt. Its current body
# and boundary remain distinct from the original unresolved parent.
struct MonoArchiveCurrentRegistrationReceiptV1:
    current_body: MonoArchiveCurrentBodyV1
    registration: MonoArchiveRegistrationReceiptV1
    base_current_digest: text
    seal: text

class MonoArchiveCurrentRegistrationOwnerV1:
    registration: MonoArchiveRegistrationOwnerV1
    cache: HirOwnedArtifactContextV1
    bodies: Dict<text, MonoArchiveCurrentBodyV1>
    published_digest: text
    sealed_digest: text = ""

fn mono_archive_registration_receipt_module_name_v1(receipt: MonoArchiveRegistrationReceiptV1) -> text:
    if receipt.logical_name != "": receipt.logical_name else: receipt.archive.input.module_name

export MonoArchiveRegistrationRowV1, MonoArchiveRootOrderV1
export MonoArchiveRegistrationOwnerV1, MonoArchiveRegistrationReceiptV1
export MonoArchiveCurrentRegistrationOwnerV1, MonoArchiveCurrentRegistrationReceiptV1
export mono_archive_registration_receipt_module_name_v1
