# Shared Template Instantiator
#
# Common instantiation logic used by compiler, JIT, and linker contexts.
# Handles caching, cycle detection, and delegation to CompilationContext.

use compiler.common.compilation_context.{TemplateConcreteType}
use compiler.common.compilation_context.{CompilationContext}
# IMPORTER-SIDE explicit import, and it has to be HERE even though this file
# never names HirModule. The owner (compiler.mono.monomorphize_integration)
# exposes `Dict<text, HirModule>` in a re-exported signature; the imported-
# surface projection falls through on the OUTER `Dict` and hands the whole
# type to lower_type in THIS module's scope, which then resolves the generic
# ARGUMENT here. Measured with the [ist-scalar-fallthrough] owner probe:
#   name=Dict owner=compiler.mono.monomorphize_integration lowering=<this file>
# An owner-side import cannot help once that fall-through happens -- a 75-import
# owner-side batch across all of 40.mono left the fatal count unchanged, while
# this single line took this file from 8 `unresolved type: HirModule` occurrences
# to 0. doc/08_tracking/bug/hir_unresolved_type_owner_missing_import_2026-08-22.md (k)
use compiler.hir.hir_types.{HirModule}

# ============================================================================
# Name Mangling
# ============================================================================

fn mangle(template_name: text, type_args: [ConcreteType]) -> text:
    """Mangle a template name with concrete type arguments."""
    if type_args.len() == 0:
        return template_name
    val args_str = type_args.map(&:to_string).join(",")
    "{template_name}${args_str}"

fn _template_remove_text(items: [text], value: text) -> [text]:
    var kept: [text] = []
    for item in items:
        if item != value:
            kept = kept.push(item)
    kept

# ============================================================================
# TemplateInstantiator
# ============================================================================

class TemplateInstantiator:
    """Shared instantiation logic for compiler, JIT, and linker."""
    context: CompilationContext
    in_progress: Set<text>
    cache: Dict<text, Any>

    me instantiate(template_name: text, type_args: [TemplateConcreteType]):
        val key = mangle(template_name, type_args)

        # 1. Cache check
        if self.cache_contains_key(cache, key):
            return Ok(self.cache[key])

        # 2. Cycle detection
        if self.in_progress_contains(in_progress, key):
            return Err("Circular dependency: {key}")

        self.in_progress = self.in_progress.insert(key)

        # 3. Load template from context
        val load_result = self.context.load_template(template_name)
        if load_result.is_err():
            self.in_progress = _template_remove_text(self.in_progress, key)
            return load_result

        val tmpl = match load_result:
            case Ok(value): value
            case Err(err):
                self.in_progress = self.in_progress.remove(key)
                return Err(err)

        # 4. Compile through full pipeline (context handles AOP/DI/contracts)
        val compile_result = self.context.compile_template(tmpl, type_args)
        if compile_result.is_err():
            self.in_progress = _template_remove_text(self.in_progress, key)
            return compile_result

        val compiled = match compile_result:
            case Ok(value): value
            case Err(err):
                self.in_progress = _template_remove_text(self.in_progress, key)
                return Err(err)

        # 5. Cache
        self.cache[key] = compiled
        self.in_progress = _template_remove_text(self.in_progress, key)
        Ok(compiled)

    fn is_cached(template_name: text, type_args: [ConcreteType]) -> bool:
        val key = mangle(template_name, type_args)
        self.cache_contains_key(cache, key)

    fn cache_size():
        self.cache.len()

# ============================================================================
# Exports
# ============================================================================
