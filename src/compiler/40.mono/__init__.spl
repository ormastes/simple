# WS3: Explicit re-exports — no sibling preloading needed.
# Refactored 2026-03-29 as part of Driver API Heavy Path Stabilization.

# IMPORTER-SIDE explicit import. The owner (compiler.mono.monomorphize_integration)
# exposes `Dict<text, HirModule>` in a re-exported signature. The surface
# projection falls through on the OUTER `Dict` and hands the whole type to
# lower_type in THIS module's scope, which then resolves the generic ARGUMENT
# here -- so the name must be bound HERE, not only in the owner. Measured with
# [ist-scalar-fallthrough] name=Dict owner=compiler.mono.monomorphize_integration.
use compiler.hir.hir_types.{HirModule}

# Re-exported from instantiation.spl
export use compiler.mono.instantiation.{TemplateInstantiator, mangle}

# Re-exported from monomorphize_integration.spl
export use compiler.mono.monomorphize_integration.{MonomorphizationPass, run_monomorphization}
