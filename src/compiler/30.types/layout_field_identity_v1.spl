# Associate an already computed physical layout with declaration identity.
# This does not choose order, offsets, alignment, or a target layout policy.
use compiler.hir.hir_definitions.{HirField}
use compiler.types._TypeLayout.layout_core.{TypeLayout}

pub fn layout_field_offsets_by_declaration_v1(layout: TypeLayout, declarations: [HirField]) -> Result<[i64], text>:
    if layout.fields.len() != declarations.len(): return Err("layout field count differs from declaration")
    var physical: Dict<text, i64> = {}
    for field in layout.fields:
        if physical.has(field.name): return Err("duplicate physical layout field: {field.name}")
        if field.offset < 0: return Err("negative physical layout offset: {field.name}")
        physical[field.name] = field.offset
    var seen: Dict<text, bool> = {}
    var offsets: [i64] = []
    for field in declarations:
        if seen.has(field.name): return Err("duplicate declared layout field: {field.name}")
        if not physical.has(field.name): return Err("unresolved layout field: {field.name}")
        seen[field.name] = true
        offsets.push(physical[field.name])
    Ok(offsets)
