# Level-Based Generalization and Instantiation
#
# Implements the let-polymorphism mechanism of Algorithm W:
# - Level management (enter_level, exit_level)
# - Fresh type variable generation
# - Free variable collection
# - Generalization (types → type schemes)
# - Instantiation (type schemes → types with fresh vars)
#
# The level system ensures we only generalize variables that are
# local to the current binding, not those from outer scopes.

use compiler.hir.hir.*
use compiler.frontend.core.lexer.*
use type_infer_types.*
use compiler.types.type_infer_types.{HmInferContext, TypeScheme}

impl HmInferContext:
    # =========================================================================
    # Level Management
    # =========================================================================

    me enter_level():
        """Enter a new level (for let-bindings, lambdas)."""
        self.level = self.level + 1

    me exit_level():
        """Exit the current level."""
        self.level = self.level - 1

    me current_level() -> i64:
        """Get the current generalization level."""
        self.level

    # =========================================================================
    # Fresh Type Variables
    # =========================================================================

    me fresh_var(span: Span) -> HirType:
        """Create a fresh type variable at the current level."""
        self.fresh_var_at_level(self.level, span)

    me fresh_var_at_level(level: i64, span: Span) -> HirType:
        """Create a fresh type variable at a specific level."""
        val id = self.next_var
        self.next_var = self.next_var + 1
        HirType(
            kind: HirTypeKind.Infer(id, level),
            span: span
        )

    # =========================================================================
    # Free Variables
    # =========================================================================

    me free_vars_with_levels(ty: HirType) -> [(i64, i64)]:
        """Collect free type variables in a type with their levels."""
        val resolved = self.resolve(ty)
        var vars: [(i64, i64)] = []
        self.collect_free_vars(resolved, vars)
        vars

    me collect_free_vars(ty: HirType, vars: [(i64, i64)]):
        """Collect free variables from a type."""
        match ty.kind:
            case Infer(id, level):
                vars = vars.push((id, level))
            case Function(params, ret, _):
                for p in params:
                    self.collect_free_vars(p, vars)
                self.collect_free_vars(ret, vars)
            case Tuple(elements):
                for e in elements:
                    self.collect_free_vars(e, vars)
            case Array(element, _) | Slice(element):
                self.collect_free_vars(element, vars)
            case Dict(key, value):
                self.collect_free_vars(key, vars)
                self.collect_free_vars(value, vars)
            case Optional(inner) | Ref(inner, _) | Ptr(inner, _) | Unique(inner) | Shared(inner) | Weak(inner):
                self.collect_free_vars(inner, vars)
            case Result(ok, err):
                self.collect_free_vars(ok, vars)
                self.collect_free_vars(err, vars)
            case Named(_, args):
                for a in args:
                    self.collect_free_vars(a, vars)
            case _:
                pass

    me env_free_var_ids() -> Dict<i64, bool>:
        """Collect free type variable IDs in the environment."""
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        var vars: Dict<i64, bool> = {}
        for name in self.env.keys():
            val scheme: TypeScheme = self.env[name]
            var bound_vars: Dict<i64, bool> = {}
            for bound_id in scheme.vars:
                bound_vars[bound_id] = true
            val ty_vars = self.free_vars_with_levels(scheme.ty)
            for (id, _) in ty_vars:
                if not bound_vars.has(id):
                    vars[id] = true
        vars

    # =========================================================================
    # Generalization and Instantiation
    # =========================================================================

    me generalize(ty: HirType) -> TypeScheme:
        """Generalize a type to a type scheme.
        Only variables at level > current env level are generalized."""
        val resolved = self.resolve(ty)
        val free_vars = self.free_vars_with_levels(resolved)
        val env_vars = self.env_free_var_ids()

        # Variables to quantify: free in ty, not in env, at level > current
        var to_generalize: [i64] = []
        var seen: Dict<i64, bool> = {}
        for (id, var_level) in free_vars:
            if not env_vars.has(id) and var_level > self.level:
                if not seen.has(id):
                    seen[id] = true
                    to_generalize = to_generalize.push(id)

        TypeScheme(vars: to_generalize, ty: resolved)

    me generalize_all(ty: HirType) -> TypeScheme:
        """Generalize all variables (ignore levels) - for top-level definitions."""
        val resolved = self.resolve(ty)
        val free_vars = self.free_vars_with_levels(resolved)
        val env_vars = self.env_free_var_ids()

        var to_generalize: [i64] = []
        var seen: Dict<i64, bool> = {}
        for (id, _) in free_vars:
            if not env_vars.has(id):
                if not seen.has(id):
                    seen[id] = true
                    to_generalize = to_generalize.push(id)

        TypeScheme(vars: to_generalize, ty: resolved)

    me instantiate(scheme: TypeScheme) -> HirType:
        """Instantiate a type scheme with fresh type variables."""
        if scheme.vars.is_empty():
            return scheme.ty

        # Create mapping from bound vars to fresh vars
        var var_map: Dict<i64, HirType> = {}
        for bound_var in scheme.vars:
            var_map[bound_var] = self.fresh_var(scheme.ty.span)

        # Apply the mapping
        self.instantiate_type(scheme.ty, var_map)

    me instantiate_type(ty: HirType, var_map: Dict<i64, HirType>, binders: Dict<i64, HirType> = {}, names: Dict<text, HirType> = {}) -> HirType:
        """Apply instantiation mapping to a type."""
        match ty.kind:
            case Infer(id, _):
                if var_map[id].?:
                    var_map[id]
                else:
                    ty
            case TypeParam(name, _):
                if names.has(name): return names[name]
                ty
            case Function(params, ret, effects):
                var mapped_effects: [Effect] = []
                for effect in effects:
                    val mapped_kind = match effect.kind:
                        case Throws(thrown): EffectKind.Throws(self.instantiate_type(thrown, var_map, binders, names))
                        case _: effect.kind
                    mapped_effects = mapped_effects.push(Effect(kind: mapped_kind, span: effect.span))
                var new_params: [HirType] = []
                for p in params:
                    new_params = new_params.push(self.instantiate_type(p, var_map, binders, names))
                HirType(
                    kind: HirTypeKind.Function(new_params, self.instantiate_type(ret, var_map, binders, names), mapped_effects),
                    span: ty.span
                )
            case Tuple(elements):
                var new_elements: [HirType] = []
                for e in elements:
                    new_elements = new_elements.push(self.instantiate_type(e, var_map, binders, names))
                HirType(kind: HirTypeKind.Tuple(new_elements), span: ty.span)
            case Array(element, size):
                HirType(kind: HirTypeKind.Array(self.instantiate_type(element, var_map, binders, names), size), span: ty.span)
            case Slice(element):
                HirType(kind: HirTypeKind.Slice(self.instantiate_type(element, var_map, binders, names)), span: ty.span)
            case Dict(key, value):
                HirType(
                    kind: HirTypeKind.Dict(
                        self.instantiate_type(key, var_map, binders, names),
                        self.instantiate_type(value, var_map, binders, names)
                    ),
                    span: ty.span
                )
            case Optional(inner):
                HirType(kind: HirTypeKind.Optional(self.instantiate_type(inner, var_map, binders, names)), span: ty.span)
            case Result(ok, err):
                HirType(
                    kind: HirTypeKind.Result(
                        self.instantiate_type(ok, var_map, binders, names),
                        self.instantiate_type(err, var_map, binders, names)
                    ),
                    span: ty.span
                )
            case Ref(inner, mutable):
                HirType(kind: HirTypeKind.Ref(self.instantiate_type(inner, var_map, binders, names), mutable), span: ty.span)
            case Ptr(inner, mutable):
                HirType(kind: HirTypeKind.Ptr(self.instantiate_type(inner, var_map, binders, names), mutable), span: ty.span)
            case Named(symbol, args):
                if args.len() == 0 and binders.has(symbol.id): return binders[symbol.id]
                var new_args: [HirType] = []
                for a in args:
                    new_args = new_args.push(self.instantiate_type(a, var_map, binders, names))
                HirType(kind: HirTypeKind.Named(symbol, new_args), span: ty.span)
            case Isolated(inner):
                HirType(kind: HirTypeKind.Isolated(self.instantiate_type(inner, var_map, binders, names)), span: ty.span)
            case Unique(inner):
                HirType(kind: HirTypeKind.Unique(self.instantiate_type(inner, var_map, binders, names)), span: ty.span)
            case Shared(inner):
                HirType(kind: HirTypeKind.Shared(self.instantiate_type(inner, var_map, binders, names)), span: ty.span)
            case Weak(inner):
                HirType(kind: HirTypeKind.Weak(self.instantiate_type(inner, var_map, binders, names)), span: ty.span)
            case Union(members):
                var mapped: [HirType] = []
                for member in members:
                    mapped = mapped.push(self.instantiate_type(member, var_map, binders, names))
                HirType(kind: HirTypeKind.Union(mapped), span: ty.span)
            case Projection(base, name):
                HirType(kind: HirTypeKind.Projection(self.instantiate_type(base, var_map, binders, names), name), span: ty.span)
            case Tensor(element, dims, device):
                HirType(kind: HirTypeKind.Tensor(self.instantiate_type(element, var_map, binders, names), dims, device), span: ty.span)
            case _:
                ty
