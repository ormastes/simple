# Expression Type Inference — Call Helpers
#
# Split from inference_expr.spl. Contains ordinary function-call and method-call
# inference, including bidirectional argument checking and MethodCall transport
# safeguards for nested value aggregates.

use compiler.types.type_infer.inference_effects.*
use compiler.types.type_infer.inference_expr.*
use compiler.hir.hir.*
use compiler.frontend.core.lexer.*
use type_infer_types.*
use compiler.types.type_infer_types.{HmInferContext, HmPendingBoundCall}
use compiler.types.type_infer.generic_calls.*

impl HmInferContext:
    me infer_function_call(callee: HirExpr, args: [HirCallArg], type_args: [HirType], span: Span) -> Result<HirType, TypeInferError>:
        match self.synthesize_expr(callee):
            case Ok(synthesized_callee):
                val direct_symbol = self.direct_function_symbol(callee)
                var callee_ty = synthesized_callee
                var inferred_arguments: [HirType] = []
                if val function_symbol = direct_symbol:
                    match self.instantiate_declared_call(function_symbol, type_args, span):
                        case Ok(instance):
                            callee_ty = instance.0
                            inferred_arguments = instance.1
                        case Err(error): return Err(error)
                val resolved_callee = self.resolve(callee_ty)
                val callee_effects: [Effect] = match resolved_callee.kind:
                    case HirTypeKind.Function(_, _, effects): effects
                    case _: []
                for eff in callee_effects:
                    self.accumulate_effect(eff)

                val expected_params = match resolved_callee.kind:
                    case Function(params, _, _): Some(params)
                    case _: None
                var arg_types: [HirType] = []
                var i = 0
                for raw_arg in args:
                    val arg: HirCallArg = raw_arg
                    val arg_result = if expected_params.? and i < expected_params.unwrap().len():
                        val expected_param: HirType = expected_params.unwrap()[i]
                        self.infer_expr(arg.value, InferMode.Check(expected_param))
                    else:
                        self.synthesize_expr(arg.value)
                    match arg_result:
                        case Ok(ty): arg_types = arg_types.push(ty)
                        case Err(e): return Err(e)
                    i = i + 1

                val ret_ty = self.fresh_var(span)
                val expected_fn_ty = HirType(
                    kind: HirTypeKind.Function(arg_types, ret_ty, []),
                    span: span
                )
                match self.unify(callee_ty, expected_fn_ty):
                    case Err(e): Err(e)
                    case _:
                        if val function_symbol = direct_symbol:
                            self.pending_bound_calls = self.pending_bound_calls.push(HmPendingBoundCall(
                                function: function_symbol, arguments: inferred_arguments,
                                caller: self.current_function_symbol, span: span))
                        Ok(self.resolve(ret_ty))
            case Err(e): Err(e)

    me infer_method_call(receiver: HirExpr, method: text, args: [HirCallArg], resolution: MethodResolution, span: Span) -> Result<HirType, TypeInferError>:
        # HirExpr/HirCallArg are nested value aggregates. Stage-3 native
        # recursion may materialize a fresh aggregate copy. Snapshot scalar
        # resolution metadata, and retain only the args array's tagged owner
        # handle across recursive calls. Do not bind a HirCallArg/HirExpr
        # element across an inference boundary.
        val method_name = method
        val argument_count = args.len()
        var resolved_method_id = -1
        var has_resolved_method = false
        val needs_trait_obligation = match resolution:
            case InstanceMethod(_, method_id):
                resolved_method_id = method_id.id
                has_resolved_method = true
                false
            case TraitMethod(_, method_id):
                resolved_method_id = method_id.id
                has_resolved_method = true
                true
            case FreeFunction(func_id):
                resolved_method_id = func_id.id
                has_resolved_method = true
                false
            case StaticMethod(_, method_id):
                resolved_method_id = method_id.id
                has_resolved_method = true
                false
            case Unresolved: true
            case BuiltinCollection(_): false
        match self.synthesize_expr(receiver):
            case Ok(receiver_ty):
                # Option accessors on a receiver that can never be optional.
                # Mirrors infer_option_pattern's scrutinee rule (same bug row):
                # the flat runtime encoding makes this undecidable at run time.
                val recv_resolved = self.resolve(receiver_ty)
                val is_option_method_name = (method_name == "unwrap" or method_name == "unwrap_or" or method_name == "expect" or method_name == "is_some" or method_name == "is_none")
                if is_option_method_name:
                    val never_optional = match recv_resolved.kind:
                        case Int(_, _) | Float(_) | HirTypeKind.Bool | HirTypeKind.Char | HirTypeKind.Str | HirTypeKind.Unit | Tuple(_) | Array(_, _) | Slice(_) | Dict(_, _) | Function(_, _, _): true
                        case Result(_, _): method_name == "is_some" or method_name == "is_none"
                        case Named(sym, _):
                            val sym_name = if self.symbol_names.contains_key(sym.id): self.symbol_names[sym.id] else: ""
                            val sym_kind = if self.symbol_kinds.contains_key(sym.id): self.symbol_kinds[sym.id] else: ""
                            if sym_name == "Option":
                                false
                            elif sym_name == "Result":
                                method_name == "is_some" or method_name == "is_none"
                            elif sym_kind == "struct" or sym_kind == "class" or sym_kind == "enum":
                                val is_external_type = (self.external_type_symbols.contains_key(sym.id) and self.external_type_symbols[sym.id])
                                if has_resolved_method or is_external_type:
                                    false
                                else:
                                    val owner = if self.symbol_owners.contains_key(sym.id): self.symbol_owners[sym.id] else: ""
                                    not self.has_declared_type_method(owner, sym_name, method_name)
                            else:
                                false
                        case _: false
                    if never_optional:
                        return Err(TypeInferError.Other(
                            "Option method '{method_name}' requires an optional receiver; found '{recv_resolved.kind}'",
                            span))
                if not has_resolved_method:
                    var opt_inner_opt: HirType? = None
                    var is_result_recv = false
                    var result_ok_opt: HirType? = None
                    match recv_resolved.kind:
                        case Optional(inner):
                            opt_inner_opt = Some(inner)
                        case Named(sym, type_args):
                            if self.symbol_names.contains_key(sym.id):
                                val sym_name = self.symbol_names[sym.id]
                                if sym_name == "Option" and type_args.len() == 1:
                                    opt_inner_opt = Some(type_args[0])
                                elif sym_name == "Result" and type_args.len() == 2:
                                    is_result_recv = true
                                    result_ok_opt = Some(type_args[0])
                        case Result(ok, _):
                            is_result_recv = true
                            result_ok_opt = Some(ok)
                        case _: ()
                    if val opt_inner = opt_inner_opt:
                        if method_name == "is_some" or method_name == "is_none":
                            if argument_count != 0:
                                return Err(TypeInferError.Other("Option method '{method_name}' expects 0 arguments, found {argument_count}", span))
                            return Ok(HirType(kind: HirTypeKind.Bool, span: span))
                        if method_name == "unwrap":
                            if argument_count != 0:
                                return Err(TypeInferError.Other("Option method 'unwrap' expects 0 arguments, found {argument_count}", span))
                            return Ok(self.resolve(opt_inner))
                        if method_name == "expect":
                            if argument_count != 1:
                                return Err(TypeInferError.Other("Option method 'expect' expects 1 argument, found {argument_count}", span))
                            val str_ty = HirType(kind: HirTypeKind.Str, span: span)
                            match self.infer_expr(args[0].value, InferMode.Check(str_ty)):
                                case Err(e):
                                    return Err(TypeInferError.Other("Option method 'expect' message argument type mismatch: {e.message()}", span))
                                case _: ()
                            return Ok(self.resolve(opt_inner))
                        if method_name == "unwrap_or":
                            if argument_count != 1:
                                return Err(TypeInferError.Other("Option method 'unwrap_or' expects 1 argument, found {argument_count}", span))
                            match self.infer_expr(args[0].value, InferMode.Check(opt_inner)):
                                case Err(e):
                                    return Err(TypeInferError.Other("Option method 'unwrap_or' default argument type mismatch: {e.message()}", span))
                                case _: ()
                            return Ok(self.resolve(opt_inner))
                    if is_result_recv:
                        val result_ok = result_ok_opt ?? self.fresh_var(span)
                        if method_name == "is_ok" or method_name == "is_err":
                            if argument_count != 0:
                                return Err(TypeInferError.Other("Result method '{method_name}' expects 0 arguments, found {argument_count}", span))
                            return Ok(HirType(kind: HirTypeKind.Bool, span: span))
                        if method_name == "unwrap":
                            if argument_count != 0:
                                return Err(TypeInferError.Other("Result method 'unwrap' expects 0 arguments, found {argument_count}", span))
                            return Ok(self.resolve(result_ok))
                        if method_name == "expect":
                            if argument_count != 1:
                                return Err(TypeInferError.Other("Result method 'expect' expects 1 argument, found {argument_count}", span))
                            val str_ty = HirType(kind: HirTypeKind.Str, span: span)
                            match self.infer_expr(args[0].value, InferMode.Check(str_ty)):
                                case Err(e):
                                    return Err(TypeInferError.Other("Result method 'expect' message argument type mismatch: {e.message()}", span))
                                case _: ()
                            return Ok(self.resolve(result_ok))
                        if method_name == "unwrap_or":
                            if argument_count != 1:
                                return Err(TypeInferError.Other("Result method 'unwrap_or' expects 1 argument, found {argument_count}", span))
                            match self.infer_expr(args[0].value, InferMode.Check(result_ok)):
                                case Err(e):
                                    return Err(TypeInferError.Other("Result method 'unwrap_or' default argument type mismatch: {e.message()}", span))
                                case _: ()
                            return Ok(self.resolve(result_ok))
                var argument_index = 0
                while argument_index < argument_count:
                    match self.synthesize_expr(args[argument_index].value):
                        case Err(e): return Err(e)
                        case _: pass
                    argument_index = argument_index + 1

                if needs_trait_obligation:
                    self.generate_obligation_for_method_call(receiver_ty, method_name, span)
                if has_resolved_method and resolved_method_id < 0:
                    return Err(TypeInferError.Other("invalid resolved method id", span))
                # `Dict<K, V>.get(k)` is `V?` (policy since 2026-11-03), as in
                # the seed HIR (expr/mod.rs `get` arm), so returning it bare from
                # `-> V` is a mismatch. The seed keeps a u64 value bare (its
                # JIT cannot decode `u64?` yet); mirror that.
                if method_name == "get" and argument_count == 1:
                    match self.resolve(receiver_ty).kind:
                        case Dict(_, value_ty):
                            val bare_u64 = match self.resolve(value_ty).kind:
                                case Int(bits, signed): bits == 64 and not signed
                                case _: false
                            if not bare_u64:
                                return Ok(HirType(kind: HirTypeKind.Optional(value_ty), span: span))
                        case _: pass
                Ok(self.fresh_var(span))
            case Err(e): Err(e)
