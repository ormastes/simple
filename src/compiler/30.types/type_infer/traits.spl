# Trait Collection and Obligation Generation
#
# Implements trait-aware type checking:
# - Trait collection from HIR modules (Phase B.1)
# - Trait conversion (HirTrait → SolverTraitDef, HirImpl → ImplBlock)
# - Obligation generation (Phase B.2)
# - Trait obligation solving
#
# Obligations are generated during type inference and solved after
# unification completes. This ensures we verify that all trait bounds
# are satisfied (e.g., T: Display when calling print<T>(x: T)).

use compiler.hir.hir.*
use compiler.frontend.core.lexer.*
use compiler.common.diagnostics.span.Span
use compiler.traits.traits.*
use compiler.traits.trait_impl.{ImplBlock}
use type_infer_types.*
use compiler.types.type_infer_types.{HmInferContext, TypeInferError, FunctionBoundContext, FunctionBoundsMap, FunctionTypeParametersMap}
use compiler.types.type_infer.context.*
use compiler.hir.hir_owner_name.hir_symbol_owner_module
use compiler.hir.hir_types.{HirModule, HirType, HirSymbol, SymbolId, SymbolKind}  # explicit: a glob is not an import-origin for surface projection

# Every assumption and concrete obligation uses this same nominal authority.
fn hm_bound_symbol(context: FunctionBoundContext, id: SymbolId, kind: SymbolKind, label: text, span: Span) -> Result<HirSymbol, TypeInferError>:
    val row = context.symbols.get_symbol_raw(id.id)
    if row == nil:
        return Err(TypeInferError.Other("function bound has missing {label} symbol", span))
    val symbol: HirSymbol = row.unwrap()
    if symbol.id.id != id.id:
        return Err(TypeInferError.Other("function bound {label} symbol identity mismatch", span))
    val correct_kind = symbol.kind == kind or (kind == SymbolKind.Function and symbol.kind == SymbolKind.Method)
    if not correct_kind:
        return Err(TypeInferError.Other("function bound does not name a {label} symbol", span))
    if val declared_owner = symbol.defining_module:
        if declared_owner != "" and hir_symbol_owner_module(declared_owner) != context.module_name:
            return Err(TypeInferError.Other("function bound {label} owner mismatch", span))
    Ok(symbol)

fn hm_bound_symbols(context: FunctionBoundContext, bound: HirTraitBound, span: Span) -> Result<(HirSymbol, HirSymbol), TypeInferError>:
    val parameter = match hm_bound_symbol(context, bound.type_param, SymbolKind.TypeParam, "type parameter", span):
        case Ok(symbol): symbol
        case Err(error): return Err(error)
    match bound.trait_.kind:
        case Named(id, arguments):
            if arguments.len() > 0:
                return Err(TypeInferError.Other("parameterized trait bounds require argument-aware solver admission", span))
            match hm_bound_symbol(context, id, SymbolKind.Trait, "trait", span):
                case Ok(symbol): Ok((parameter, symbol))
                case Err(error): Err(error)
        case _: Err(TypeInferError.Other("function bound has missing trait symbol", span))

fn hm_validate_function_bound_metadata(context: FunctionBoundContext, module: HirModule) -> Result<(), TypeInferError>:
    for function in module.functions.values():
        match hm_bound_symbol(context, function.symbol, SymbolKind.Function, "function", function.span):
            case Err(error): return Err(error)
            case _: ()
        var ids: Dict<i64, bool> = {}
        var names: Dict<text, bool> = {}
        for parameter in function.type_params:
            val symbol = match hm_bound_symbol(context, parameter.symbol, SymbolKind.TypeParam, "type parameter", parameter.span):
                case Ok(value): value
                case Err(error): return Err(error)
            if symbol.name != parameter.name:
                return Err(TypeInferError.Other("function bound type parameter name mismatch", parameter.span))
            if ids.has(parameter.symbol.id) or names.has(parameter.name):
                return Err(TypeInferError.Other("generic declaration has duplicate binder identity", parameter.span))
            ids[parameter.symbol.id] = true
            names[parameter.name] = true
            for bound_type in parameter.bounds:
                val bound = HirTraitBound(type_param: parameter.symbol, trait_: bound_type, span: parameter.span)
                match hm_bound_symbols(context, bound, parameter.span):
                    case Err(error): return Err(error)
                    case _: ()
    Ok(())

impl HmInferContext:
    # =========================================================================
    # Trait Collection (Phase B.1)
    # =========================================================================

    me collect_function_bounds_from_module(module: HirModule):
        """Retain declaration order and symbols for one module's bound API.

        Called before inference so direct calls retain declaration authority.
        A context cannot merge unrelated module-local SymbolId spaces.
        """
        val owner = hir_symbol_owner_module(module.name)
        if owner == "":
            self.error(TypeInferError.Other("function bounds require a module owner", Span.empty()))
            return
        if val previous = self.function_bound_context:
            if previous.module_name != owner:
                self.error(TypeInferError.Other("function bound module owner mismatch", Span.empty()))
                return
        var collected: FunctionBoundsMap = {}
        var parameters: FunctionTypeParametersMap = {}
        var signatures: Dict<i64, HmGenericSignature> = {}
        for dk_12 in module.functions.keys():
            # ANY-transport hazard sweep round 3: annotated rebind.
            val hir_fn: HirFunction = module.functions[dk_12]
            var ordered: [SymbolId] = []
            var all_bounds: [HirTraitBound] = []
            for tp in hir_fn.type_params:
                ordered = ordered.push(tp.symbol)
                for bound_type in tp.bounds:
                    all_bounds = all_bounds.push(HirTraitBound(
                        type_param: tp.symbol, trait_: bound_type, span: tp.span))
            parameters[hir_fn.symbol.id] = ordered
            signatures[hir_fn.symbol.id] = HmGenericSignature(
                parameters: hir_fn.type_params,
                type_: HirType(kind: HirTypeKind.Function(hir_fn.params.map(_.type_), hir_fn.return_type, hir_fn.effects), span: hir_fn.span))
            if not all_bounds.is_empty():
                collected[hir_fn.symbol.id] = all_bounds
        val context = FunctionBoundContext(
            module_name: owner, symbols: module.symbols.module_snapshot(),
            parameters: parameters, signatures: signatures)
        # Validate before publishing metadata usable by symbolic assumptions.
        match hm_validate_function_bound_metadata(context, module):
            case Err(error):
                self.error(error)
                return
            case _: ()
        # Replace both maps together: recollection cannot retain removed bounds.
        self.function_bounds = collected
        self.function_bound_context = Some(context)

    # =========================================================================
    # Obligation Generation (Phase B.2)
    # =========================================================================

    me generate_obligation_for_bound(ty: HirType, bound: HirTraitBound, span: Span):
        """Resolve actual declaration symbols before invoking the existing solver."""
        if self.function_bound_context == nil:
            self.error(TypeInferError.Other("function bound has missing declaration context", span))
            return
        val context: FunctionBoundContext = self.function_bound_context.unwrap()
        match hm_bound_symbols(context, bound, span):
            case Err(error): self.error(error)
            case Ok(symbols):
                self.trait_solver.add_obligation(ty, symbols.1,
                    ObligationCause.SolverTraitBound(symbols.0), span)

    me generate_obligations_for_function_call(func_symbol: SymbolId, type_args: [HirType], span: Span):
        """Instantiate bounds using the declaration's complete binder order.

        Uncollected/unbounded functions retain the existing no-bound behavior;
        connecting declaration collection to every active call is a separate gate.
        """
        if not self.function_bounds.has(func_symbol.id): return
        if self.function_bound_context == nil:
            self.error(TypeInferError.Other("function bound has missing declaration context", span))
            return
        val context: FunctionBoundContext = self.function_bound_context.unwrap()
        if not context.parameters.has(func_symbol.id):
            self.error(TypeInferError.Other("function bound has missing ordered type parameters", span))
            return
        val parameters: [SymbolId] = context.parameters[func_symbol.id]
        if parameters.len() != type_args.len():
            self.error(TypeInferError.Other("function bound type argument count does not match declaration", span))
            return
        val bounds: [HirTraitBound] = self.function_bounds[func_symbol.id]
        for bound in bounds:
            self.generate_obligation_for_bound_with_args(bound, type_args, span, parameters)

    me generate_obligation_for_bound_with_args(bound: HirTraitBound, type_args: [HirType], span: Span, type_params: [SymbolId] = []):
        """Match the actual binder SymbolId; never guess argument zero.

        Legacy direct callers without declaration order receive an HM error.
        """
        if type_params.len() == 0:
            self.error(TypeInferError.Other("function bound has missing ordered type parameters", span))
            return
        if type_params.len() != type_args.len():
            self.error(TypeInferError.Other("function bound type argument count does not match declaration", span))
            return
        var found = -1
        var index = 0
        for parameter in type_params:
            if parameter.id == bound.type_param.id:
                if found >= 0:
                    self.error(TypeInferError.Other("function bound has ambiguous type parameter position", span))
                    return
                found = index
            index = index + 1
        if found < 0:
            self.error(TypeInferError.Other("function bound type parameter is absent from declaration", span))
            return
        self.generate_obligation_for_bound(type_args[found], bound, span)

    me generate_obligation_for_method_call(receiver_ty: HirType, method_name: text, span: Span):
        """Generate obligations for a method call.

        When calling `receiver.method_name()`, we need to check:
        1. If it's an instance method, no trait obligation needed
        2. If it's a trait method, generate obligation `receiver_ty: Trait`

        For now, this is a simplified implementation.
        """
        # Determine which trait defines this method by looking up in trait solver
        val defining_trait = self.trait_solver.find_trait_for_method(method_name)
        if defining_trait.?:
            val trait_sym = defining_trait.unwrap()
            val cause = ObligationCause.MethodCall(trait_sym, method_name)
            self.trait_solver.add_obligation(receiver_ty, trait_sym, cause, span)
            return

        # Fallback: For common trait methods, generate known obligations
        match method_name:
            case "to_string":
                # Assume Display trait (would need to look this up properly)
                # For now, skip - will be enhanced in Phase C (method resolution)
                pass
            case "clone":
                # Assume Clone trait
                pass
            case _:
                pass

    me generate_obligations_for_type(ty: HirType, bounds: [HirTraitBound], span: Span):
        """Generate obligations for all trait bounds on a type.

        Given a type and its bounds, create obligations for each bound.
        Used when instantiating generic functions or types.
        """
        for bound in bounds:
            self.generate_obligation_for_bound(ty, bound, span)

    me solve_trait_obligations() -> Result<(), [TraitError]>:
        """Solve all pending trait obligations.

        Should be called after type inference is complete for a module.
        Returns errors if any obligations cannot be satisfied.
        """
        match self.trait_solver.solve_all():
            case Ok(_):
                Ok(())
            case Err(trait_errors):
                # Convert trait errors to type inference errors
                for trait_err in trait_errors:
                    match trait_err:
                        case Unsatisfied(obligation):
                            val type_err = TypeInferError.TraitNotImplemented(
                                ty: obligation.type_,
                                trait_name: obligation.trait_.name,
                                span: obligation.span
                            )
                            self.errors = self.errors.push(type_err)
                        case _:
                            self.error(TypeInferError.Other(trait_err.message(), trait_err.span()))
                Err(trait_errors)
