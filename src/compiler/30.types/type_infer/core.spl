# Core Unification and Substitution Algorithms
#
# Implements the fundamental operations of Algorithm W:
# - Substitution application (apply_subst, resolve)
# - Occurs check (prevents infinite types)
# - Unification (type equality with substitution)
#
# These are the core operations of Hindley-Milner type inference.
# All type checking ultimately reduces to unification.

use compiler.hir.hir.*
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.frontend.core.lexer.*
use compiler.types.dim_constraints.*
use type_infer_types.*
use compiler.types.type_infer_types.{HmInferContext}

impl HmInferContext:
    # =========================================================================
    # Substitution
    # =========================================================================

    me apply_subst(ty: HirType) -> HirType:
        """Apply current substitution to a type (resolve all known variables)."""
        self.subst.apply(ty)

    me resolve(ty: HirType) -> HirType:
        """Get the fully resolved type (chase all substitutions)."""
        self.apply_subst(ty)

    # =========================================================================
    # Occurs Check
    # =========================================================================

    me occurs(var_id: i64, ty: HirType) -> bool:
        """Check if type variable occurs in type (for occurs check)."""
        val resolved: HirType = self.resolve(ty)
        match resolved.kind:
            case HirTypeKind.Infer(id, _):
                id == var_id
            case HirTypeKind.Function(params, ret, _):
                for p in params:
                    if self.occurs(var_id, p):
                        return true
                self.occurs(var_id, ret)
            case HirTypeKind.Tuple(elements):
                for e in elements:
                    if self.occurs(var_id, e):
                        return true
                false
            case HirTypeKind.Array(element, _) | HirTypeKind.Slice(element):
                self.occurs(var_id, element)
            case HirTypeKind.Dict(key, value):
                self.occurs(var_id, key) or self.occurs(var_id, value)
            case HirTypeKind.Optional(inner) | HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _):
                self.occurs(var_id, inner)
            case HirTypeKind.Result(ok, err):
                self.occurs(var_id, ok) or self.occurs(var_id, err)
            case HirTypeKind.Named(_, args):
                for a in args:
                    if self.occurs(var_id, a):
                        return true
                false
            case HirTypeKind.Tensor(element, _, _):
                self.occurs(var_id, element)
            case HirTypeKind.Layer(_, _):
                false  # Layer dimensions don't contain type variables
            case _:
                false

    # =========================================================================
    # Unification
    # =========================================================================

    me unify(t1: HirType, t2: HirType) -> Result<(), TypeInferError>:
        """Unify two types, updating the substitution."""
        val ty1: HirType = self.resolve(t1)
        val ty2: HirType = self.resolve(t2)

        match (ty1.kind, ty2.kind):
            # Same primitive types unify trivially
            case (HirTypeKind.Int(b1, s1), HirTypeKind.Int(b2, s2)) if b1 == b2 and s1 == s2:
                Ok(())
            case (HirTypeKind.Float(b1), HirTypeKind.Float(b2)) if b1 == b2:
                Ok(())
            case (HirTypeKind.Bool, HirTypeKind.Bool):
                Ok(())
            case (HirTypeKind.Char, HirTypeKind.Char):
                Ok(())
            case (HirTypeKind.Str, HirTypeKind.Str):
                Ok(())
            case (HirTypeKind.Unit, HirTypeKind.Unit):
                Ok(())
            case (HirTypeKind.Never, HirTypeKind.Never):
                Ok(())

            # Type variable unification
            case (HirTypeKind.Infer(id1, _), HirTypeKind.Infer(id2, _)) if id1 == id2:
                Ok(())
            case (HirTypeKind.Infer(id, level), _):
                if self.occurs(id, ty2):
                    Err(TypeInferError.OccursCheck(id, ty2, ty1.span))
                else:
                    self.subst.insert(id, ty2)
                    Ok(())
            case (_, HirTypeKind.Infer(id, level)):
                if self.occurs(id, ty1):
                    Err(TypeInferError.OccursCheck(id, ty1, ty2.span))
                else:
                    self.subst.insert(id, ty1)
                    Ok(())

            # Function types
            case (HirTypeKind.Function(p1, r1, _), HirTypeKind.Function(p2, r2, _)) if p1.len() == p2.len():
                var i = 0
                while i < p1.len():
                    match self.unify(p1[i], p2[i]):
                        case Err(e): return Err(e)
                        case _: pass
                    i = i + 1
                self.unify(r1, r2)

            # Tuple types
            case (HirTypeKind.Tuple(e1), HirTypeKind.Tuple(e2)) if e1.len() == e2.len():
                var i = 0
                while i < e1.len():
                    match self.unify(e1[i], e2[i]):
                        case Err(e): return Err(e)
                        case _: pass
                    i = i + 1
                Ok(())

            # Array types
            case (HirTypeKind.Array(el1, _), HirTypeKind.Array(el2, _)):
                self.unify(el1, el2)

            # Slice types
            case (HirTypeKind.Slice(el1), HirTypeKind.Slice(el2)):
                self.unify(el1, el2)

            # Dict types
            case (HirTypeKind.Dict(k1, v1), HirTypeKind.Dict(k2, v2)):
                match self.unify(k1, k2):
                    case Err(e): Err(e)
                    case _: self.unify(v1, v2)

            # Optional types
            case (HirTypeKind.Optional(i1), HirTypeKind.Optional(i2)):
                self.unify(i1, i2)

            # Result types
            case (HirTypeKind.Result(o1, e1), HirTypeKind.Result(o2, e2)):
                match self.unify(o1, o2):
                    case Err(e): Err(e)
                    case _: self.unify(e1, e2)

            # Reference types
            case (HirTypeKind.Ref(i1, m1), HirTypeKind.Ref(i2, m2)) if m1 == m2:
                self.unify(i1, i2)
            case (HirTypeKind.Ptr(i1, m1), HirTypeKind.Ptr(i2, m2)) if m1 == m2:
                self.unify(i1, i2)

            # Named types
            case (HirTypeKind.Named(s1, a1), HirTypeKind.Named(s2, a2)) if s1.id == s2.id and a1.len() == a2.len():
                var i = 0
                while i < a1.len():
                    match self.unify(a1[i], a2[i]):
                        case Err(e): return Err(e)
                        case _: pass
                    i = i + 1
                Ok(())

            # Type parameters
            case (HirTypeKind.TypeParam(n1, _), HirTypeKind.TypeParam(n2, _)) if n1 == n2:
                Ok(())

            # Tensor types
            case (HirTypeKind.Tensor(el1, dims1, dev1), HirTypeKind.Tensor(el2, dims2, dev2)):
                # Unify element types
                match self.unify(el1, el2):
                    case Err(e): return Err(e)
                    case _: pass
                # Check dimension count
                if dims1.len() != dims2.len():
                    return Err(TypeInferError.Other(
                        "tensor dimension count mismatch: {dims1.len()} vs {dims2.len()}",
                        ty1.span
                    ))
                # Add dimension equality constraints
                var dimension_i: i64 = 0
                while dimension_i < dims1.len():
                    self.dim_solver.add_equal(dims1[dimension_i], dims2[dimension_i], ty1.span)
                    dimension_i = dimension_i + 1
                Ok(())

            # Layer types
            case (HirTypeKind.Layer(in1, out1), HirTypeKind.Layer(in2, out2)):
                # Check input dimension count
                if in1.len() != in2.len():
                    return Err(TypeInferError.Other(
                        "layer input dimension count mismatch: {in1.len()} vs {in2.len()}",
                        ty1.span
                    ))
                # Check output dimension count
                if out1.len() != out2.len():
                    return Err(TypeInferError.Other(
                        "layer output dimension count mismatch: {out1.len()} vs {out2.len()}",
                        ty1.span
                    ))
                # Add dimension equality constraints
                var input_i: i64 = 0
                while input_i < in1.len():
                    self.dim_solver.add_equal(in1[input_i], in2[input_i], ty1.span)
                    input_i = input_i + 1
                var output_i: i64 = 0
                while output_i < out1.len():
                    self.dim_solver.add_equal(out1[output_i], out2[output_i], ty1.span)
                    output_i = output_i + 1
                Ok(())

            # Mismatch
            case _:
                Err(TypeInferError.Mismatch(ty1, ty2, ty1.span))
