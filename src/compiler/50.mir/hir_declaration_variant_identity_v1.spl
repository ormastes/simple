# Declaration identity across genuine logical variants of one physical source.
# These bytes are comparison projections, never artifacts sent to a decoder.
# Original expression records retain their full selected-body transport pins.
use compiler.mir.hir_declaration_types_v1.*
use compiler.mir.hir_expression_artifact_v1.{MirHirExpressionArtifactV1}
use compiler.mir.hir_declaration_codec_v1.{mir_hir_write_function_declaration_v1,
    mir_hir_write_global_declaration_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}

fn mir_hir_expression_comparison_record_v1(artifact: MirHirExpressionArtifactV1) -> MirHirExpressionArtifactV1:
    var record = artifact
    # A legitimate variant has another final archive/body pin. Preserve all
    # actual selectors, expression bytes digest, producer stage and owner.
    record.final_archive_key = ""
    record.final_body_digest = ""
    record.archive_key = ""
    record

fn mir_hir_callable_variant_identity_v1(function: MirHirFunctionDeclarationV1) -> text:
    var record = function
    # Callable ABI/default binding compares declarations. The normal emission
    # owner separately selects the first ordinary body and actual later mono
    # specializations using the complete retained-function digest.
    record.complete_function_digest = ""
    var params: [MirHirParamDeclarationV1] = []
    for raw_param in function.params:
        var param: MirHirParamDeclarationV1 = raw_param
        if val artifact = param.default_artifact:
            param.default_artifact = Some(mir_hir_expression_comparison_record_v1(artifact))
        params.push(param)
    record.params = params
    var writer = HirCodecWriter.create()
    mir_hir_write_function_declaration_v1(writer, record)
    if not writer.ok: return ""
    writer.finish()

fn mir_hir_global_variant_identity_v1(global: MirHirGlobalDeclarationV1) -> text:
    var record = global
    record.initializer = mir_hir_expression_comparison_record_v1(global.initializer)
    var writer = HirCodecWriter.create()
    mir_hir_write_global_declaration_v1(writer, record)
    if not writer.ok: return ""
    writer.finish()
