# Intrinsic-only physical consumer. No general alias/effect proof is inferred.
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_support.{MirBinOp}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.mir_target_context.{mir_collection_target_is_supported}
use compiler.semantics.perf.collection_plan_selection.*
use compiler.semantics.perf.collection_plan_explain.{collection_plan_explain}

fn collection_literal_i64(type_: HirType) -> bool:
    match type_.kind:
        case HirTypeKind.Int(bits, signed): bits == 64 and signed
        case _: false

fn collection_literal_keys(entries: [(HirExpr, HirExpr)]) -> bool:
    if entries.len() > 8: return false
    for entry in entries:
        match entry.0.kind:
            case HirExprKind.IntLit(value, suffix):
                # Immediate tagged integers have canonical equality. Wide
                # integers can be separately heap boxed: pointer equality is
                # not integer equality. Their lowering remains Original.
                if value < -1152921504606846976 or value > 1152921504606846975:
                    return false
                if suffix != nil and suffix != Some("i64"):
                    return false
            case _: return false
    true

impl MirLowering:
    fn collection_expression_identity(expr: HirExpr) -> text:
        match expr.kind:
            case HirExprKind.IntLit(value, _): "i64=" + value.to_text()
            case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                if val definition = self.symbols.get_symbol_raw(symbol.id):
                    return "var=" + definition.name
                "unresolved"
            case HirExprKind.Call(callee, args, _):
                var callable = "unresolved"
                match callee.kind:
                    case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                        if val definition = self.symbols.get_symbol_raw(symbol.id):
                            callable = definition.name
                    case _: ()
                "call=" + callable + "/argc=" + args.len().to_text()
            case _: "other"

    fn collection_probe_is_i64(probe: HirExpr) -> bool:
        if probe.has_type_ and probe.type_ != nil:
            return collection_literal_i64(probe.type_)
        match probe.kind:
            case HirExprKind.IntLit(_, suffix):
                return suffix == nil or suffix == Some("i64")
            case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                if val definition = self.symbols.get_symbol_raw(symbol.id):
                    if val type_ = definition.type_:
                        return collection_literal_i64(type_)
            case HirExprKind.Call(callee, _, _):
                var owner = SymbolId(id: -1)
                match callee.kind:
                    case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): owner = symbol
                    case _: ()
                if owner.id >= 0:
                    if val definition = self.symbols.get_symbol_raw(owner.id):
                        if val type_ = definition.type_:
                            match type_.kind:
                                case HirTypeKind.Function(_, returned, _):
                                    return collection_literal_i64(returned)
                                case _: ()
            case _: ()
        false

    me lower_collection_literal_membership(receiver: HirExpr, probe: HirExpr, receiver_local: LocalId, key_local: LocalId) -> LocalId?:
        var entries: [(HirExpr, HirExpr)] = []
        match receiver.kind:
            case HirExprKind.DictLit(values, _, _): entries = values
            case _: return nil
        var facts = collection_plan_unproven_facts()
        facts.collection_kind = "map"
        facts.policy = self.target_context.collection_policy
        facts.memory_budget_bytes = self.target_context.collection_memory_budget_bytes
        facts.static_size = entries.len()
        facts.static_lookups = 1
        facts.hard_size_bound = entries.len()
        val primitive = collection_literal_keys(entries) and self.collection_probe_is_i64(probe)
        val target = self.target_context
        val known_target = mir_collection_target_is_supported(target)
        val operands = self.collection_literal_operands.get(receiver_local.id) ?? []
        # A fresh builtin DictLit cannot escape before this lookup. Receiver,
        # values, all insertion attempts and the probe have ALREADY executed.
        # A runtime guard below preserves soft allocation/insertion failure.
        val proof = primitive and known_target and operands.len() == entries.len()
        facts.equality_pure = primitive
        facts.duplicate_semantics_preserved = primitive
        facts.order_insensitive = primitive
        facts.mutation_epoch_stable = primitive
        facts.p0_correctness_ready = proof and target.collection_opt_level > 0 and not target.collection_trace_active
        if proof:
            # Upper bound for additional live MIR scalar slots: retained keys
            # and insertion results, guard comparisons/ANDs, equality/ORs,
            # branches and merged result, with slack. 16 bytes per scalar
            # covers an 8-byte spill plus alignment on these 64-bit ABIs.
            # This is scratch storage above Original, not heap/RSS evidence.
            facts.linear_extra_memory_bytes = (8 * entries.len() + 8) * 16
        val decision = collection_plan_select(facts)
        var owner = "module"
        if val function = self.builder.current_function:
            owner = function.name
        var shape = ""
        for entry in entries:
            shape = shape + "/key=" + self.collection_expression_identity(entry.0)
            shape = shape + "/value=" + self.collection_expression_identity(entry.1)
        val identity = "ast://" + self.builder.module.name + "/" + owner + "/dict-membership" + shape + "/probe=" + self.collection_expression_identity(probe)
        val ordinal = self.collection_literal_ordinals.get(identity) ?? 0
        self.collection_literal_ordinals[identity] = ordinal + 1
        val site = identity + "/" + ordinal.to_text()
        var report = collection_plan_explain(site, target.arch + "-" + target.os + "-" + target.abi, facts, decision)
        report = report + "target.admitted={target.collection_target_admitted}\n"
        if decision.selected != CollectionPlanAlgorithm.Linear:
            report = report + "\ntyped_mir=original"
            var original_builder = self.builder
            var original_module = original_builder.module
            original_module.collection_plan_explanations = original_module.collection_plan_explanations.push(report)
            original_builder.module = original_module
            self.builder = original_builder
            return nil

        var b = self.builder
        val zero = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), MirType(kind: MirTypeKind.I8)))
        var constructed = b.emit_const_bool(true)
        for operand in operands:
            val succeeded = b.emit_binop(MirBinOp.Ne, mir_operand_copy(operand.1), zero, MirType.bool())
            constructed = b.emit_binop(MirBinOp.BitAnd, mir_operand_copy(constructed), mir_operand_copy(succeeded), MirType.bool())
        val linear = b.new_block(Some("collection_linear"))
        val original = b.new_block(Some("collection_original_on_failed_insert"))
        val done = b.new_block(Some("collection_membership_done"))
        val result = b.new_temp(MirType.bool())
        b.terminate_if(mir_operand_copy(constructed), linear, original)
        b.switch_to_block(linear)
        var found = b.emit_const_bool(false)
        for operand in operands:
            val equal = b.emit_binop(MirBinOp.Eq, mir_operand_copy(key_local), mir_operand_copy(operand.0), MirType.bool())
            found = b.emit_binop(MirBinOp.BitOr, mir_operand_copy(found), mir_operand_copy(equal), MirType.bool())
        b.emit_copy(result, found)
        b.terminate_goto(done)
        b.switch_to_block(original)
        val lookup = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("rt_dict_contains"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64()], return_type: MirType(kind: MirTypeKind.I8), is_variadic: false)))))
        val raw = b.emit_call(lookup, [mir_operand_copy(receiver_local), mir_operand_copy(key_local)], MirType(kind: MirTypeKind.I8))
        val raw_local = raw ?? b.new_temp(MirType(kind: MirTypeKind.I8))
        val present = b.emit_binop(MirBinOp.Ne, mir_operand_copy(raw_local), zero, MirType.bool())
        b.emit_copy(result, present)
        b.terminate_goto(done)
        b.switch_to_block(done)
        report = report.replace("fallback=none-after-selection", "fallback=original-on-materialization-failure")
        report = report + "\ntyped_mir=consumed\nmaterialization_guard=all-insertions-succeeded\nscratch_bound=mir-scalar-spills-16-byte-slots"
        var module = b.module
        module.collection_plan_explanations = module.collection_plan_explanations.push(report)
        b.module = module
        self.builder = b
        Some(result)

export collection_literal_keys
