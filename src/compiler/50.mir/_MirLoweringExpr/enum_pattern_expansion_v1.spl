# EE-01 ordered source-pattern expansion. No source HIR or binding identity is
# mutated. All owned vector/node growth is charged before allocation.
use compiler.hir.hir_definitions.{HirPattern, HirPatternKind, HirPatternPayload}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLoweringExpr.enum_semantic_capture_v1.*

impl MirLowering:
    me enum_pattern_expansion_charge_v1(amount: i64) -> Result<(), text>:
        if not self.enum_semantic_capture_enabled:
            return Err("EE-E-METADATA: pattern expansion requires enabled semantic capture")
        var remaining = amount
        while remaining > 0:
            if not self.enum_semantic_charge_v1():
                if self.enum_semantic_capture_error != "":
                    return Err(self.enum_semantic_capture_error)
                return Err("EE-E-LIMIT: pattern expansion exhausted function work")
            remaining = remaining - 1
        Ok(())

    me enum_pattern_expansion_node_v1(original: HirPattern,
            kind: HirPatternKind) -> Result<HirPattern, text>:
        self.enum_pattern_expansion_charge_v1(5)?
        Ok(HirPattern(kind: kind, has_type_: original.has_type_,
            type_: original.type_, span: original.span))

    me enum_pattern_expansion_product_v1(patterns: [HirPattern],
            depth: i64) -> Result<[[HirPattern]], text>:
        # Prefix-major expansion gives leftmost-slot-major lexicographic order.
        # There is one empty product, including nullary tuple payloads.
        self.enum_pattern_expansion_charge_v1(3)?
        var rows: [[HirPattern]] = [[]]
        var slot = 0
        while slot < patterns.len():
            self.enum_pattern_expansion_charge_v1(1)?
            val alternatives = self.enum_semantic_expand_pattern_v1(patterns[slot], depth)?
            self.enum_pattern_expansion_charge_v1(1)?
            var next_rows: [[HirPattern]] = []
            var row_index = 0
            while row_index < rows.len():
                self.enum_pattern_expansion_charge_v1(1)?
                val row = rows[row_index]
                var alternative_index = 0
                while alternative_index < alternatives.len():
                    self.enum_pattern_expansion_charge_v1(1)?
                    var next_row: [HirPattern] = []
                    var prefix_index = 0
                    while prefix_index < row.len():
                        # Indexed lookup, value copy and vector append.
                        self.enum_pattern_expansion_charge_v1(3)?
                        next_row.push(row[prefix_index])
                        prefix_index = prefix_index + 1
                    self.enum_pattern_expansion_charge_v1(3)?
                    next_row.push(alternatives[alternative_index])
                    self.enum_pattern_expansion_charge_v1(2)?
                    next_rows.push(next_row)
                    alternative_index = alternative_index + 1
                row_index = row_index + 1
            self.enum_pattern_expansion_charge_v1(1)?
            rows = next_rows
            slot = slot + 1
        self.enum_pattern_expansion_charge_v1(2)?
        Ok(rows)

    me enum_semantic_expand_pattern_v1(pattern: HirPattern,
            depth: i64) -> Result<[HirPattern], text>:
        """Expand every nested Or without allocating fresh source symbols.

        The caller owns original arm IDs, bodies and guard evaluation counts.
        This method preserves each retained node's type annotation and span.
        """
        if depth < 0 or depth > 128:
            return Err("EE-E-LIMIT: source pattern expansion depth exceeds 128")
        self.enum_pattern_expansion_charge_v1(1)?
        if pattern == nil:
            return Err("EE-E-PATTERN: cannot expand a missing source pattern")
        self.enum_pattern_expansion_charge_v1(1)?
        var result: [HirPattern] = []
        match pattern.kind:
            case HirPatternKind.Wildcard | HirPatternKind.Binding(_, _):
                val retained = self.enum_pattern_expansion_node_v1(pattern, pattern.kind)?
                self.enum_pattern_expansion_charge_v1(2)?
                result.push(retained)
            case HirPatternKind.Literal(value):
                if value == nil:
                    return Err("EE-E-PATTERN: cannot expand a missing literal expression")
                val retained = self.enum_pattern_expansion_node_v1(pattern, pattern.kind)?
                self.enum_pattern_expansion_charge_v1(2)?
                result.push(retained)
            case HirPatternKind.Or(patterns):
                if patterns.len() == 0:
                    return Err("EE-E-PATTERN: source Or pattern has no alternatives")
                var index = 0
                while index < patterns.len():
                    self.enum_pattern_expansion_charge_v1(1)?
                    val alternatives = self.enum_semantic_expand_pattern_v1(patterns[index], depth + 1)?
                    var alternative = 0
                    while alternative < alternatives.len():
                        self.enum_pattern_expansion_charge_v1(3)?
                        result.push(alternatives[alternative])
                        alternative = alternative + 1
                    index = index + 1
            case HirPatternKind.Tuple(patterns):
                val rows = self.enum_pattern_expansion_product_v1(patterns, depth + 1)?
                var index = 0
                while index < rows.len():
                    self.enum_pattern_expansion_charge_v1(2)?
                    val retained = self.enum_pattern_expansion_node_v1(pattern,
                        HirPatternKind.Tuple(rows[index]))?
                    self.enum_pattern_expansion_charge_v1(2)?
                    result.push(retained)
                    index = index + 1
            case HirPatternKind.Enum(owner, variant, payload):
                if payload == nil:
                    val retained = self.enum_pattern_expansion_node_v1(pattern, pattern.kind)?
                    self.enum_pattern_expansion_charge_v1(2)?
                    result.push(retained)
                else:
                    self.enum_pattern_expansion_charge_v1(1)?
                    match payload.unwrap():
                        case HirPatternPayload.Tuple(patterns):
                            val rows = self.enum_pattern_expansion_product_v1(patterns, depth + 1)?
                            var index = 0
                            while index < rows.len():
                                self.enum_pattern_expansion_charge_v1(4)?
                                val retained = self.enum_pattern_expansion_node_v1(pattern,
                                    HirPatternKind.Enum(owner, variant,
                                        Some(HirPatternPayload.Tuple(rows[index]))))?
                                self.enum_pattern_expansion_charge_v1(2)?
                                result.push(retained)
                                index = index + 1
                        case HirPatternPayload.Struct(fields):
                            self.enum_pattern_expansion_charge_v1(2)?
                            var names: [text] = []
                            var patterns: [HirPattern] = []
                            var field_index = 0
                            while field_index < fields.len():
                                self.enum_pattern_expansion_charge_v1(5)?
                                val field = fields[field_index]
                                names.push(field.0)
                                patterns.push(field.1)
                                field_index = field_index + 1
                            val rows = self.enum_pattern_expansion_product_v1(patterns, depth + 1)?
                            var row_index = 0
                            while row_index < rows.len():
                                self.enum_pattern_expansion_charge_v1(2)?
                                val row = rows[row_index]
                                var expanded_fields: [(text, HirPattern)] = []
                                var index = 0
                                while index < names.len():
                                    self.enum_pattern_expansion_charge_v1(6)?
                                    expanded_fields.push((names[index], row[index]))
                                    index = index + 1
                                self.enum_pattern_expansion_charge_v1(3)?
                                val retained = self.enum_pattern_expansion_node_v1(pattern,
                                    HirPatternKind.Enum(owner, variant,
                                        Some(HirPatternPayload.Struct(expanded_fields))))?
                                self.enum_pattern_expansion_charge_v1(2)?
                                result.push(retained)
                                row_index = row_index + 1
            case HirPatternKind.Error:
                return Err("EE-E-PATTERN: erroneous source pattern cannot be expanded")
            case _:
                return Err("EE-E-PATTERN: unsupported source pattern kind in enum expansion")
        self.enum_pattern_expansion_charge_v1(2)?
        Ok(result)
