use compiler.mir.mir_lowering_types.MirLowering
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolTable, SymbolId, SymbolKind, Effect, EffectKind}
use compiler.hir.hir_symbol_table_methods.*
use compiler.mir._MirLowering.provider_metadata.mir_class_identity
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*

struct FunctionSignatureRebinding:
    type_: HirType
    consumed: i64
    valid: bool

fn function_signature_children(type_: HirType) -> [HirType]?:
    # Unsupported signatures must not reach lower_type's erased-word fallback.
    match type_.kind:
        case HirTypeKind.Named(_, args) | HirTypeKind.Tuple(args): return Some(args)
        case HirTypeKind.Array(inner, _) | HirTypeKind.Slice(inner) |
             HirTypeKind.Ref(inner, _) | HirTypeKind.Ptr(inner, _) |
             HirTypeKind.Optional(inner) | HirTypeKind.Isolated(inner): return Some([inner])
        case HirTypeKind.Unique(inner) | HirTypeKind.Shared(inner) | HirTypeKind.Weak(inner): return Some([inner])
        case HirTypeKind.Dict(left, right) | HirTypeKind.Result(left, right): return Some([left, right])
        case HirTypeKind.Function(params, ret, effects):
            var children = params + [ret]
            for effect in effects:
                match effect.kind:
                    case EffectKind.Throws(payload): children = children.push(payload)
                    case EffectKind.Pure | EffectKind.IO | EffectKind.Async |
                         EffectKind.Mutates | EffectKind.Allocates | EffectKind.Custom(_): ()
                    case _: return nil
            return Some(children)
        case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Bool |
             HirTypeKind.Char | HirTypeKind.Str | HirTypeKind.Unit |
             HirTypeKind.Never | HirTypeKind.Any: return Some([])
        case _: return nil

impl MirLowering:
    me function_signature_ownership_proof(type_: HirType, symbols: SymbolTable) -> text:
        # Preorder nominal keys only. The declaration retains the structural
        # shape; this proof relocates every ID without retaining provider tables.
        val children = function_signature_children(type_)
        if children == nil: return "!unknown\n"
        var proof = ""
        match type_.kind:
            case HirTypeKind.Named(symbol, _):
                val declaration = symbols.get_symbol_raw(symbol.id)
                if declaration == nil: return "!unknown\n"
                match declaration.kind:
                    case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait: ()
                    case _: return "!unknown\n"
                val key = mir_class_identity(declaration)
                if key == "" or key.contains("\n"): return "!unknown\n"
                proof = key + "\n"
            case _: ()
        for child in children.unwrap():
            proof = proof + self.function_signature_ownership_proof(child, symbols)
        proof

    fn function_signature_owner_symbol(original: SymbolId, key: text) -> SymbolId?:
        if key == "" or key.starts_with("!"): return nil
        if self.function_signature_symbol_matches(original.id, key): return Some(original)
        # Aliases and same-named local types make a leaf lookup insufficient.
        # Search the consumer's index and accept only the exact provider identity.
        var candidate: SymbolId? = nil
        for indexed_name in self.symbols.exact_symbols.keys():
            val raw = self.symbols.exact_symbols[indexed_name]
            if self.function_signature_symbol_matches(raw, key):
                if val declaration = self.symbols.get_symbol_raw(raw):
                    match declaration.kind:
                        case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait:
                            if val prior = candidate:
                                if prior.id != raw: return nil
                            candidate = Some(SymbolId(id: raw))
                        case _: ()
        candidate

    fn function_signature_symbol_matches(raw: i64, key: text) -> bool:
        if val declaration = self.symbols.get_symbol_raw(raw):
            match declaration.kind:
                case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum | SymbolKind.Trait:
                    return mir_class_identity(declaration) == key
                case _: ()
        false

    me rebind_function_signature_type(type_: HirType, keys: [text], start: i64) -> FunctionSignatureRebinding:
        val invalid = FunctionSignatureRebinding(type_: HirType(kind: HirTypeKind.Error, span: type_.span), consumed: start, valid: false)
        val children = function_signature_children(type_)
        if children == nil: return invalid
        var cursor = start
        var rebound_symbol: SymbolId? = nil
        match type_.kind:
            case HirTypeKind.Named(original, _):
                if cursor >= keys.len(): return invalid
                rebound_symbol = self.function_signature_owner_symbol(original, keys[cursor])
                if rebound_symbol == nil: return invalid
                cursor = cursor + 1
            case _: ()
        var rebound_children: [HirType] = []
        for child in children.unwrap():
            val rebound = self.rebind_function_signature_type(child, keys, cursor)
            if not rebound.valid: return invalid
            cursor = rebound.consumed
            rebound_children = rebound_children.push(rebound.type_)
        val kind = match type_.kind:
            case HirTypeKind.Named(_, _): HirTypeKind.Named(rebound_symbol.unwrap(), rebound_children)
            case HirTypeKind.Tuple(_): HirTypeKind.Tuple(rebound_children)
            case HirTypeKind.Array(_, size): HirTypeKind.Array(rebound_children[0], size)
            case HirTypeKind.Slice(_): HirTypeKind.Slice(rebound_children[0])
            case HirTypeKind.Ref(_, mutable): HirTypeKind.Ref(rebound_children[0], mutable)
            case HirTypeKind.Ptr(_, mutable): HirTypeKind.Ptr(rebound_children[0], mutable)
            case HirTypeKind.Optional(_): HirTypeKind.Optional(rebound_children[0])
            case HirTypeKind.Isolated(_): HirTypeKind.Isolated(rebound_children[0])
            case HirTypeKind.Unique(_): HirTypeKind.Unique(rebound_children[0])
            case HirTypeKind.Shared(_): HirTypeKind.Shared(rebound_children[0])
            case HirTypeKind.Weak(_): HirTypeKind.Weak(rebound_children[0])
            case HirTypeKind.Dict(_, _): HirTypeKind.Dict(rebound_children[0], rebound_children[1])
            case HirTypeKind.Result(_, _): HirTypeKind.Result(rebound_children[0], rebound_children[1])
            case HirTypeKind.Function(params, _, effects):
                var rebuilt_params: [HirType] = []
                var index = 0
                while index < params.len():
                    rebuilt_params = rebuilt_params.push(rebound_children[index])
                    index = index + 1
                val rebuilt_return = rebound_children[index]
                index = index + 1
                var rebuilt_effects: [Effect] = []
                for effect in effects:
                    val rebuilt_effect = match effect.kind:
                        case EffectKind.Throws(_):
                            val payload = rebound_children[index]
                            index = index + 1
                            Effect(kind: EffectKind.Throws(payload), span: effect.span)
                        case _: effect
                    rebuilt_effects = rebuilt_effects.push(rebuilt_effect)
                HirTypeKind.Function(rebuilt_params, rebuilt_return, rebuilt_effects)
            case _: type_.kind
        FunctionSignatureRebinding(type_: HirType(kind: kind, span: type_.span), consumed: cursor, valid: true)

    me declared_function_field_signature(owner: text, field_index: i64, declared: HirType) -> HirType:
        val invalid = HirType(kind: HirTypeKind.Error, span: declared.span)
        if not self.struct_field_type_ownership_key.has(owner): return invalid
        val field_keys = self.struct_field_type_ownership_key[owner]
        if field_index < 0 or field_index >= field_keys.len(): return invalid
        val proof = field_keys[field_index]
        val prefix = "function-signature-v1\n"
        if not proof.starts_with(prefix): return invalid
        val body = proof.substring(prefix.len()).trim()
        var keys: [text] = []
        if body != "": keys = body.split("\n")
        val rebound = self.rebind_function_signature_type(declared, keys, 0)
        if not rebound.valid or rebound.consumed != keys.len(): return invalid
        rebound.type_
