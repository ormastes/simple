# Result tuple payloads use the ordinary raw heap tuple, not rt_tuple_new's
# multi-argument enum container. Keep unsupported element representations loud.
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.asm_and_targets.*

fn result_tuple_payload_type(type_: HirType) -> MirType?:
    match type_.kind:
        case HirTypeKind.Tuple(elements):
            if elements.len() == 0:
                return nil
            var fields: [MirType] = []
            for element in elements:
                match element.kind:
                    case HirTypeKind.Int(64, true): fields.push(MirType.i64())
                    case HirTypeKind.Bool: fields.push(MirType.bool())
                    case HirTypeKind.Float(64): fields.push(MirType.f64())
                    case HirTypeKind.Tuple(_):
                        if val nested = result_tuple_payload_type(element):
                            fields.push(nested)
                        else:
                            return nil
                    case _: return nil
            Some(MirType(kind: MirTypeKind.Tuple(fields)))
        case _: nil

# Match bindings have a separate admission contract from unwrap/? above.
# A declared wrapper tuple can contain a typed runtime collection handle;
# those fields require element provenance when projected, never Any erasure.
# This is native word-slot storage, not LLVM's packed tuple type layout:
# _MirToLlvm/aggregate_intrinsics Tuple and llvm_get_field_impl use the same
# native-word GEP stride; Bool loads truncate, Float loads bitcast, and nested
# Tuple fields are pointer words. cranelift_codegen_adapter likewise allocates
# N*8 and projects field*8 (load_uniform_i64 preserves Float load types).
# Str has distinct declared fat-pointer and literal Opaque representations;
# it and other unadmitted extras retain their pre-existing match route.
fn wrapper_native_tuple_field_type(type_: HirType) -> MirType?:
    match type_.kind:
        case HirTypeKind.Int(64, true): Some(MirType.i64())
        case HirTypeKind.Bool: Some(MirType.bool())
        case HirTypeKind.Float(64): Some(MirType.f64())
        case HirTypeKind.Tuple(_): wrapper_native_tuple_payload_type(type_)
        case HirTypeKind.Array(element, size):
            if val field_element = wrapper_native_tuple_field_type(element):
                Some(MirType(kind: MirTypeKind.Array(field_element, size ?? 0)))
            else:
                nil
        case HirTypeKind.Slice(element):
            if val field_element = wrapper_native_tuple_field_type(element):
                Some(MirType(kind: MirTypeKind.Slice(field_element)))
            else:
                nil
        case _: nil

fn wrapper_native_tuple_payload_type(type_: HirType) -> MirType?:
    match type_.kind:
        case HirTypeKind.Tuple(elements):
            if elements.len() == 0:
                return nil
            var fields: [MirType] = []
            for element in elements:
                if val field_type = wrapper_native_tuple_field_type(element):
                    fields = fields.push(field_type)
                else:
                    return nil
            Some(MirType(kind: MirTypeKind.Tuple(fields)))
        case _: nil

impl MirLowering:
    me decode_result_tuple_payload(raw: LocalId, expected: HirType) -> LocalId:
        # Invoked only by lower_try_expr's proven Result success branch.
        # Custom enum/Option payload decoding keeps its separate contract.
        if val tuple_type = result_tuple_payload_type(expected):
            val value = self.recover_result_tuple_payload(raw, tuple_type)
            self.remember_local_hir_type(value.id, expected, 0, 0)
            return value
        self.error_fatal("unsupported Result tuple payload element type", Some(expected.span))
        return self.builder.emit_const_int(0)

    me recover_result_tuple_payload(raw: LocalId, tuple_type: MirType) -> LocalId:
        # Cast the runtime's i64 payload WORD to a pointer, then copy that
        # pointer into a fresh local with the exact tuple field types. A direct
        # i64 -> Tuple cast would use tuple.size_bytes() in Cranelift's numeric
        # cast path (invalid for e.g. (bool, bool)); a Ptr cast is word-sized.
        # Both native tuple constructors allocate raw N-word heap storage.
        # No dereference, reallocation, runtime-tuple header or field erasure.
        var builder = self.builder
        val address = builder.emit_cast(mir_operand_copy(raw), MirType.ptr(tuple_type, false))
        val result = builder.new_temp(tuple_type)
        builder.emit_copy(result, address)
        self.builder = builder
        result

export result_tuple_payload_type, wrapper_native_tuple_payload_type
