# Result tuple payloads use the ordinary raw heap tuple, not rt_tuple_new's
# multi-argument enum container. Keep unsupported element representations loud.
use compiler.hir.hir_types.{HirType, HirTypeKind, HirSymbol, SymbolKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.asm_and_targets.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_class_identity}
use compiler.mir._MirLoweringExpr.result_err_record_owner.{result_err_layout_identity}
use compiler.mir._MirLoweringExpr.expr_dispatch.*

# Match bindings have a separate admission contract from unwrap/? above.
# A declared wrapper tuple can contain a typed runtime collection handle;
# those fields require element provenance when projected, never Any erasure.
# This is native word-slot storage, not LLVM's packed tuple type layout:
# _MirToLlvm/aggregate_intrinsics Tuple and llvm_get_field_impl use the same
# native-word GEP stride; Bool loads truncate, Float loads bitcast, and nested
# Tuple fields are pointer words. cranelift_codegen_adapter likewise allocates
# N*8 and projects field*8 (load_uniform_i64 preserves Float load types).
# Str has distinct declared fat-pointer and literal Opaque representations;
# it and other unadmitted extras retain their pre-existing match route.
fn wrapper_native_tuple_field_type(type_: HirType) -> MirType?:
    match type_.kind:
        case HirTypeKind.Int(slot_int_bits, slot_int_signed):
            # Binding form, not `Int(64, true)`: the native producer never
            # matched that literal-payload pattern, so every i64 slot was rejected.
            if slot_int_bits == 64 and slot_int_signed: return Some(MirType.i64())
            nil
        case HirTypeKind.Bool: Some(MirType.bool())
        case HirTypeKind.Float(slot_float_bits):
            if slot_float_bits == 64: return Some(MirType.f64())
            nil
        case HirTypeKind.Tuple(_): wrapper_native_tuple_payload_type(type_)
        case HirTypeKind.Array(element, size):
            if val field_element = wrapper_native_tuple_field_type(element):
                Some(MirType(kind: MirTypeKind.Array(field_element, size ?? 0)))
            else:
                nil
        case HirTypeKind.Slice(element):
            if val field_element = wrapper_native_tuple_field_type(element):
                Some(MirType(kind: MirTypeKind.Slice(field_element)))
            else:
                nil
        case _: nil

fn wrapper_native_tuple_payload_type(type_: HirType) -> MirType?:
    match type_.kind:
        case HirTypeKind.Tuple(elements):
            if elements.len() == 0:
                return nil
            var fields: [MirType] = []
            for element in elements:
                if val field_type = wrapper_native_tuple_field_type(element):
                    fields = fields.push(field_type)
                else:
                    return nil
            Some(MirType(kind: MirTypeKind.Tuple(fields)))
        case _: nil

fn result_tuple_kind_label(type_: HirType) -> text:
    match type_.kind:
        case HirTypeKind.Int(bits, signed): "Int({bits}, {signed})"
        case HirTypeKind.Float(bits): "Float({bits})"
        case HirTypeKind.Bool: "Bool"
        case HirTypeKind.Str: "Str"
        case HirTypeKind.Named(_, args): "Named(args={args.len()})"
        case HirTypeKind.Tuple(elements): "Tuple(len={elements.len()})"
        case HirTypeKind.Array(_, _): "Array"
        case HirTypeKind.Dict(_, _): "Dict"
        case HirTypeKind.Optional(_): "Optional"
        case HirTypeKind.Any: "Any"
        case HirTypeKind.Infer(_, _): "Infer"
        case HirTypeKind.Error: "Error"
        case _: "other"

impl MirLowering:
    me result_try_tuple_nominal_owner(type_: HirType, record: bool) -> text:
        # These IDs come from a consumer-owned, relocated callable signature.
        # Relocation establishes origin; an integer ID alone cannot do that.
        # Here validate the current declaration and its qualified binding.
        match type_.kind:
            case HirTypeKind.Named(symbol, args):
                if args.len() != 0 or not self.symbols.symbols.has(symbol.id): return ""
                val declaration: HirSymbol = self.symbols.symbols[symbol.id]
                if declaration.id.id != symbol.id: return ""
                if record:
                    if declaration.kind != SymbolKind.Struct and declaration.kind != SymbolKind.Class: return ""
                elif declaration.kind != SymbolKind.Enum:
                    return ""
                val module = mir_layout_canonical_module_name(declaration.defining_module ?? "")
                if module == "" or self.symbols.lookup_qualified_type_raw(module, declaration.name) != symbol.id: return ""
                if not record:
                    val owner = mir_class_identity(declaration)
                    if not self.enum_runtime_id_index_q.has(owner): return ""
                    return owner
                val shape = if declaration.kind == SymbolKind.Class:
                    mir_class_identity(declaration)
                else:
                    self.composite_layout_key(declaration)
                val owner = self.declared_struct_layout_key(shape)
                val identity = result_err_layout_identity(owner)
                if (identity == "" or not self.composite_layout_digests.has(identity) or
                    (self.composite_layout_owner_counts.get(identity) ?? 0) != 1 or
                    (self.result_err_layout_types.get(identity) ?? "") == "" or
                    not self.struct_field_order.has(owner) or not self.struct_field_hir_type.has(owner)):
                    return ""
                owner
            case _: ""

    me result_try_tuple_collection_element(type_: HirType, allow_struct: bool) -> MirType?:
        # Container metadata does not describe an inline tuple slot. In
        # particular a text dictionary key remains a runtime string handle.
        match type_.kind:
            case HirTypeKind.Int(slot_int_bits, slot_int_signed):
                # Binding form, not `Int(64, true)`: the native producer never
                # matched that literal-payload pattern, so every i64 slot was rejected.
                if slot_int_bits == 64 and slot_int_signed: return Some(MirType.i64())
                nil
            case HirTypeKind.Bool: Some(MirType.bool())
            case HirTypeKind.Float(slot_float_bits):
                if slot_float_bits == 64: return Some(MirType.f64())
                nil
            case HirTypeKind.Str: Some(self.lower_type(type_))
            case HirTypeKind.Named(symbol, _):
                if not self.symbols.symbols.has(symbol.id): return nil
                val declaration: HirSymbol = self.symbols.symbols[symbol.id]
                # Dict<Struct> currently loses its full owner in dictionary
                # value projection. Do not admit that unproven route here.
                if not allow_struct and declaration.kind != SymbolKind.Class: return nil
                if self.result_try_tuple_nominal_owner(type_, true) == "": return nil
                Some(self.lower_type(type_))
            case _: nil

    me result_try_tuple_field_type(type_: HirType) -> MirType?:
        match type_.kind:
            case HirTypeKind.Int(slot_int_bits, slot_int_signed):
                # Binding form, not `Int(64, true)`: the native producer never
                # matched that literal-payload pattern, so every i64 slot was rejected.
                if slot_int_bits == 64 and slot_int_signed: return Some(MirType.i64())
                nil
            case HirTypeKind.Bool: Some(MirType.bool())
            case HirTypeKind.Float(slot_float_bits):
                if slot_float_bits == 64: return Some(MirType.f64())
                nil
            case HirTypeKind.Tuple(_): self.result_try_tuple_payload_type(type_)
            # A text slot is one native word holding the runtime string
            # pointer (mir_type_is_str: the backend materializes both text MIR
            # spellings as a single char*). Declare it the way lower_tuple_lit
            # records a text element, Opaque("str"), never the fat-pointer
            # aggregate, so the projected local takes the text path.
            case HirTypeKind.Str: Some(MirType(kind: MirTypeKind.Opaque("str")))
            case HirTypeKind.Named(_, _):
                # Proven enum owners, then proven record owners: both are one
                # heap-handle word in the native slot, and both owners are
                # validated against the current declaration table.
                if self.result_try_tuple_nominal_owner(type_, false) == "" and self.result_try_tuple_nominal_owner(type_, true) == "": return nil
                Some(self.lower_type(type_))
            case HirTypeKind.Array(element, size):
                # Only the unsized runtime-array contract is admitted here.
                # Fixed arrays and slices need their own carrier proof.
                if size != nil: return nil
                if val lowered = self.result_try_tuple_collection_element(element, true):
                    Some(MirType(kind: MirTypeKind.Array(lowered, 0)))
                else: nil
            case HirTypeKind.Dict(key, value):
                # The observed parser contract is Dict<text, SdnSpan>. Keep
                # other key representations outside this bounded admission.
                if key.kind != HirTypeKind.Str: return nil
                if val lowered = self.result_try_tuple_collection_element(value, false):
                    Some(MirType(kind: MirTypeKind.Dict(self.lower_type(key), lowered)))
                else: nil
            case _: nil

    me result_try_tuple_payload_type(type_: HirType) -> MirType?:
        match type_.kind:
            case HirTypeKind.Tuple(elements):
                if elements.len() == 0: return nil
                var fields: [MirType] = []
                for element in elements:
                    if val field = self.result_try_tuple_field_type(element):
                        fields.push(field)
                    else:
                        return nil
                Some(MirType(kind: MirTypeKind.Tuple(fields)))
            case _: nil

    me result_tuple_rejected_element(type_: HirType) -> text:
        """Name the first slot result_try_tuple_field_type rejects, so the
        fatal diagnostic says which element shape is missing an admission."""
        match type_.kind:
            case HirTypeKind.Tuple(elements):
                var index = 0
                for element in elements:
                    if self.result_try_tuple_field_type(element) == nil:
                        return "slot {index} is {result_tuple_kind_label(element)}"
                    index = index + 1
                return "all slots admitted"
            case _: return "payload is {result_tuple_kind_label(type_)}, not a tuple"

    me remember_result_try_tuple_projection(base: LocalId, field: i64, destination: LocalId):
        # Transfer semantic metadata only; GetField already loaded the native
        # bits with the stored MIR field type. Never decode a scalar twice or
        # replace a literal's actual representation with a HIR text layout.
        if val remembered = self.find_local_hir_type(base.id):
            match remembered.kind:
                case HirTypeKind.Tuple(elements):
                    if field < 0 or field >= elements.len(): return
                    val expected: HirType = elements[field]
                    if val declared = self.result_try_tuple_field_type(expected):
                        if val actual = self.local_mir_type_of(destination):
                            if actual.kind != declared.kind: return
                        else: return
                        self.remember_local_hir_type(destination.id, expected, 0, 0)
                        match expected.kind:
                            case HirTypeKind.Named(_, _):
                                var slot_owner = self.result_try_tuple_nominal_owner(expected, false)
                                if slot_owner == "":
                                    slot_owner = self.result_try_tuple_nominal_owner(expected, true)
                                if slot_owner != "":
                                    self.struct_value_syms[destination.id] = slot_owner
                            case HirTypeKind.Array(element, _):
                                self.runtime_array_locals[destination.id] = true
                                self.mark_runtime_value_local(destination.id)
                                self.runtime_elem_value_type[destination.id] = self.lower_type(element)
                                val owner = self.result_try_tuple_nominal_owner(element, true)
                                if owner != "": self.array_element_struct_syms[destination.id] = owner
                            case HirTypeKind.Dict(_, element):
                                self.runtime_dict_locals[destination.id] = true
                                self.mark_runtime_value_local(destination.id)
                                self.runtime_elem_value_type[destination.id] = self.lower_type(element)
                                val owner = self.result_try_tuple_nominal_owner(element, true)
                                if owner != "": self.array_element_struct_syms[destination.id] = owner
                            case _: ()
                case _: ()

    me decode_result_tuple_payload(raw: LocalId, expected: HirType) -> LocalId:
        # Invoked only by lower_try_expr's proven Result success branch.
        # Custom enum/Option payload decoding keeps its separate contract.
        if val tuple_type = self.result_try_tuple_payload_type(expected):
            val value = self.recover_result_tuple_payload(raw, tuple_type)
            self.remember_local_hir_type(value.id, expected, 0, 0)
            return value
        self.error_fatal("unsupported Result tuple payload element type: {self.result_tuple_rejected_element(expected)}", Some(expected.span))
        return self.builder.emit_const_int(0)

    me recover_result_tuple_payload(raw: LocalId, tuple_type: MirType) -> LocalId:
        # Cast the runtime's i64 payload WORD to a pointer, then copy that
        # pointer into a fresh local with the exact tuple field types. A direct
        # i64 -> Tuple cast would use tuple.size_bytes() in Cranelift's numeric
        # cast path (invalid for e.g. (bool, bool)); a Ptr cast is word-sized.
        # Both native tuple constructors allocate raw N-word heap storage.
        # No dereference, reallocation, runtime-tuple header or field erasure.
        var builder = self.builder
        val address = builder.emit_cast(mir_operand_copy(raw), MirType.ptr(tuple_type, false))
        val result = builder.new_temp(tuple_type)
        builder.emit_copy(result, address)
        self.builder = builder
        result

export wrapper_native_tuple_payload_type
