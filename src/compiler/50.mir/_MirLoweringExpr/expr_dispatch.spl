# Part of src/compiler/50.mir/mir_lowering_expr.spl: expression dispatch, match-case, gpu lane, bitfield helpers
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*
# MIR Lowering - Expression Lowering
#
# Expression lowering from HIR to MIR:
# - Literal lowering (int, float, bool, string, nil, unit)
# - Variable references
# - Binary/unary operators (including special pipeline/compose/parallel)
# - Function calls (direct and indirect)
# - Method calls (instance, trait, static, free function / UFCS)
# - Array, tuple, set, and constant expression lowering
# - Field access

use compiler.mir.mir_data.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.blocks.value.BlockValue
use compiler.mir.mir_instructions.{MirPlace}
use compiler.mir.mir_lowering_types.{MirLowering, MirError}
use compiler.backend.gpu_intrinsics.{is_gpu_intrinsic}
use compiler.mir.mir_types.{MirType}
use compiler.mir.mir_types.{LocalId}  # explicit: a glob is not an import-origin for surface projection

# std.alloc.sffi only exists in the seed lib tree; the stage4 strict lane
# cannot resolve it — declare the runtime extern directly.
extern fn rt_dict_contains(dict: i64, key: Any) -> bool
extern fn rt_env_get(key: text) -> text?
extern fn rt_enum_discriminant(value: Any) -> i64
extern fn rt_enum_payload(value: Any) -> i64
extern fn rt_tuple_get(tuple: i64, index: i64) -> i64

# `rt_env_get` yields nil for an UNSET variable, so both the extern and this
# wrapper are OPTIONAL — every call site below already uses the optional-safe
# `?? ""` / `== "1"` form, which distinguishes unset from explicitly-empty.
# Same fix as flat_bridge_env_get (7825f01def2) and compiler/00.common/config.
fn mir_expr_env_get(key: text) -> text?:
    rt_env_get(key)

# ----------------------------------------------------------------------------
# Garbage-HirExpr breadcrumb (stage-3 self-host blocker #8, 2026-08-05)
#
# An unguarded qualified enum payload match can bind a payload extracted from
# the WRONG variant -- the header word is handed back as if it were the
# payload pointer, so a child HirExpr comes out GARBAGE (the recurring
# 0x1800000007 bit pattern; see hir_lowering/expressions.spl:1777 for the same
# class caught on the flat bridge). rt_enum_discriminant is a pure registry
# membership test (runtime_native.c rt_core_as_enum: pointer comparison, never
# a deref), so it is SAFE on a garbage handle and returns -1 for anything that
# is not a live boxed enum. That gives a cheap, non-faulting detector.
#
# The breadcrumb records the PARENT expression that lower_expr_impl was
# dispatching when a garbage child was handed down, so the producing match arm
# can be named from its source location instead of guessed.
var mir_lower_parent_expr_file: text = ""
var mir_lower_parent_expr_line: i64 = -1
var mir_lower_parent_expr_col: i64 = -1
var mir_lower_parent_expr_disc: i64 = -1
var mir_lower_garbage_expr_count: i64 = 0
var mir_lower_garbage_debug_state: i64 = -1
# Cached MIR lower-expr trace gate (-1 unknown, 0 off, 1 on). Default OFF.
var mir_lower_expr_trace_state: i64 = -1
var mir_lower_disc_table_dumped: bool = false

pub fn mir_lower_garbage_expr_count_value() -> i64:
    mir_lower_garbage_expr_count

# Pure env read. The RESULT is cached into mir_lower_garbage_debug_state by
# lower_expr (a method), not here: module-level `var` mutation from a
# module-level `fn` is not a shape this tree exercises, whereas mutation from a
# method body is (mir_bounds_check_bailout_count above). Caching matters because
# this gate sits on the hottest path in MIR lowering -- every expression node.
fn mir_lower_garbage_debug_enabled() -> bool:
    (mir_expr_env_get("SIMPLE_MIR_GARBAGE_EXPR_DEBUG") ?? "") == "1"

# SF1 (d), 2026-07-28: bounds-check lowering used to bail out SILENTLY when
# the indexed base type exposes no len symbol — the access then ran with no
# check at all and nothing recorded the gap. Count every bailout so the gap
# is measurable, and surface it under SIMPLE_MIR_BOUNDS_DEBUG=1.
var mir_bounds_check_bailout_count: i64 = 0

pub fn mir_bounds_check_bailouts() -> i64:
    """Number of indexed accesses lowered WITHOUT a bounds check because the
    base type had no len symbol (see emit_bounds_check_for_index)."""
    mir_bounds_check_bailout_count

fn mir_expr_symbol_id_value(symbol: SymbolId) -> i64:
    symbol.id

# True when a HIR operand's static type is an unsigned integer (u8/u16/u32/u64).
# Consulted at the mixed int/float comparison-promotion site so a u64 operand
# whose MIR local type was flattened to I64 still promotes via an UNSIGNED
# int->float convert (bug
# u64_to_f64_comparison_uses_signed_conversion_2026-07-25). Defaults to false
# (signed) when the HIR type is absent — matches the prior always-signed path.
fn hir_expr_static_unsigned(e: HirExpr) -> bool:
    if e == nil:
        return false
    if not e.has_type_:
        return false
    val t = e.type_
    if t == nil:
        return false
    match t.kind:
        case HirTypeKind.Int(_bits, signed):
            not signed
        case _:
            false

fn hir_expr_is_optional_type(e: HirExpr) -> bool:
    if e == nil or not e.has_type_:
        return false
    val t = e.type_
    if t == nil:
        return false
    match t.kind:
        case HirTypeKind.Optional(_): true
        case _: false

# ============================================================================
# Expression Lowering
# ============================================================================

impl MirLowering:
    # mutglobal2 lane (module-level `var`/`val` mutation end-to-end, see
    # scratchpad/mutglobal_plan.md + scratchpad/mutglobal2 report). The prior
    # lane gave `MirModule.statics`/`LoadGlobal`/`StoreGlobal` real backend
    # support (module_lowering.spl + core_codegen.spl), but nothing on this
    # path ever READ a module global -- `Var`/`NamedVar` below only consult
    # `self.local_map` (the current function's SSA locals) and error
    # "undefined variable" the moment a module-scope binding is referenced.
    # `global_static_ids`/`global_const_ids` (populated once per module, in
    # function_lowering.spl's `lower_const`, BEFORE any function body is
    # lowered -- see module_lowering.spl's reordered `lower_module`) now
    # carry that information. Returns `Some(local)` when `symbol_id` names a
    # known module-level binding, `nil` otherwise (falls through to the
    # existing "undefined variable" error, unchanged for every non-global
    # case). A mutable `var` gets a real `LoadGlobal` off the backend's
    # `@g_name` storage; an immutable `val` has no storage at all (see
    # `lower_static`'s `is_mutable` gate) so its read is inlined as an
    # ordinary `Const`, mirroring the existing OUTPUT_LIMIT/
    # DEFAULT_TIMEOUT_MS hardcoded-name special cases below but general
    # (driven by the registry, not a literal name match).
    # Module symbol id -> the `MirStatic` entry from `self.builder.module.
    # statics` whose `.symbol.id` matches, `nil` if `symbol_id` isn't a
    # mutable module-level `var`. Found by VALUE iteration deliberately, NOT
    # a keyed `Dict<SymbolId,...>[...]`/`.has(...)` lookup with a
    # freshly-built key -- see `global_symbol_ids`'s doc comment
    # (mir_lowering_types.spl) for the struct-keyed-dict interpreter
    # landmine that lookup style hits. Shared by the read hook below and
    # mir_lowering_stmts.spl's write hook (StoreGlobal needs the same type
    # for a compound `g += y` assignment's LoadGlobal-and-combine sequence).
    me find_global_static(symbol_id: i64) -> MirStatic?:
        val static_values = self.builder.module.statics.values()
        var sti = 0
        while sti < static_values.len():
            if static_values[sti].symbol.id == symbol_id:
                return Some(static_values[sti])
            sti = sti + 1
        nil

    # B2 (bug cranelift_native_aggregate_return_nil_receiver_hosted_wm_
    # 2026-07-26): 952d2ca34d7's re-lowering fallback at the bottom of
    # `try_lower_global_read` is sound ONLY for a never-mutated binding --
    # its own argument is "every reference constructing an equal, independent
    # value is observationally identical to sharing one" (see
    # `global_const_exprs`, mir_lowering_types.spl). A module-level `var` of
    # ARRAY type violates that end to end: `lower_static`
    # (module_lowering.spl) declines to emit a `MirStatic` for an array type,
    # so the write hook (`lower_assign_var`, mir_lowering_stmts.spl) finds no
    # backing static and silently degrades the store to a function-local SSA
    # copy, while every read re-builds the ORIGINAL initializer -- the
    # mutation is dropped and the program reads the initial value forever
    # (`module=0` in the freestanding RCA). 952d2ca34d7 turned what used to be
    # a loud "undefined variable" error into silent data loss; this restores
    # the noise.
    #
    # Declared mutability is used as the "is ever assigned" marker on purpose.
    # It is a superset of the true answer, and unlike the write hook's
    # `find_global_static`-returns-nil marker it is available at the FIRST
    # read, independent of the order functions happen to be lowered in (a read
    # lowered before the mutating function would otherwise never be flagged).
    # It also covers index-assignment (`G[i] = v`), whose base read comes
    # through this same path.
    #
    # Reported once per symbol. Loud by default, promoted to a hard lowering
    # error by `SIMPLE_STRICT_ARRAY_GLOBALS=1`, so a build can be made to fail
    # instead of corrupting at runtime. NOT a hard error by default because
    # the tree still carries many module-level `var` array bindings written
    # against the old silent behaviour; flipping the default belongs with the
    # real fix (null-init static slots + backend module-init wiring).
    me report_mutable_array_global(symbol_id: i64):
        if self.array_global_mutation_warned.contains(symbol_id):
            return
        var is_mutable = false
        var type_is_array = false
        var global_name = "<unnamed>"
        if val global_symbol = self.symbols.get_symbol_raw(symbol_id):
            is_mutable = global_symbol.is_mutable
            global_name = global_symbol.name
            if val declared_type = global_symbol.type_:
                match declared_type.kind:
                    case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                        type_is_array = true
                    # rationale: only array/slice globals are unrepresentable
                    # as a MirStatic; every other declared type either folds
                    # to a scalar constant or gets real `@g_name` storage.
                    case _:
                        ()
        if not is_mutable:
            return
        if not type_is_array:
            return
        self.array_global_mutation_warned[symbol_id] = true
        val message = "mutable array-typed module global '{global_name}' has no backing static: its initializer is re-lowered at every read and writes to it are dropped (bug cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26)"
        print "[mir-lower] WARNING: {message}"
        if (mir_expr_env_get("SIMPLE_STRICT_ARRAY_GLOBALS") ?? "") == "1":
            self.error(message, nil)

    me try_lower_global_read(symbol_id: i64) -> LocalId?:
        if not self.global_symbol_ids.contains(symbol_id):
            return nil
        # Mutable (`var`) case first: real storage, backed by a LoadGlobal
        # off the @g_name the backend emits for this MirModule.statics entry.
        if val static_ = self.find_global_static(symbol_id):
            var b_glob = self.builder
            val dest = b_glob.new_temp(static_.type_)
            b_glob.emit(MirInst(kind: MirInstKind.LoadGlobal(dest, static_.symbol), span: nil))
            self.builder = b_glob
            # Register struct provenance for the loaded local, mirroring every
            # other struct-value-producing site (mir_lowering_stmts.spl:291,
            # method_calls_literals.spl:537, etc). Every other such site
            # registers `struct_value_syms` so `resolve_field_index`'s first
            # (name-keyed) lookup can succeed without depending on HIR type
            # inference; this global-read path did not. Tested via
            # SIMPLE_MIR_FIELD_TRACE=1 against a minimal @repr("C") global
            # struct probe: the HIR-type-annotation fallback in
            # resolve_field_index already resolves this case correctly on the
            # x86_64 JIT host, so this omission is NOT confirmed as the cause
            # of the aarch64 field-misread defect (see the 2026-08-07 entry in
            # doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md
            # for the full discriminating test and the surviving candidates).
            # Landed anyway as a genuine, low-risk provenance-consistency gap.
            match static_.type_.kind:
                case Struct(struct_sym):
                    if val struct_symbol_raw = self.symbols.get_symbol_raw(struct_sym.id):
                        self.struct_value_syms[dest.id] = struct_symbol_raw.name
                case _: ()
            return Some(dest)
        # Immutable (`val`) case: no real storage (lower_static gates on
        # is_mutable) -- inline the folded constant value/type instead, the
        # same way the existing OUTPUT_LIMIT/DEFAULT_TIMEOUT_MS hardcoded
        # cases already do via `emit_const`. Restricted to SCALAR constant
        # kinds (Int/Float/Bool/Str/Zero) deliberately: `emit_const`'s
        # backend (`translate_const_value`, core_codegen.spl) only renders a
        # scalar LLVM literal -- it is not the same lowering strategy as a
        # real array/struct's runtime construction (`lower_array_lit`'s
        # rt_array_new-based heap allocation), so inlining a compound value
        # through it produced a bad LLVM constant and crashed at runtime
        # (SIGSEGV, confirmed empirically with `val SIZES = [10,20,30]`).
        val const_values = self.builder.module.constants.values()
        var cvi = 0
        while cvi < const_values.len():
            val mir_const = const_values[cvi]
            if mir_const.symbol.id == symbol_id:
                var is_scalar = false
                match mir_const.value:
                    case Int(_): is_scalar = true
                    case Float(_): is_scalar = true
                    case Bool(_): is_scalar = true
                    case Str(_): is_scalar = true
                    case Zero: is_scalar = true
                    case _: is_scalar = false
                if is_scalar:
                    # Derive the dest type from the VALUE kind, not
                    # mir_const.type_: an unannotated module `val NAME = "s"`
                    # carries Infer->i64 as its lowered type while the backend
                    # renders the Str value as a ptr GEP -- inlining with the
                    # i64 type then routes interpolation down the numeric
                    # renderer and llc rejects `'%lN' defined with type 'ptr'
                    # but expected 'i64'` (native_module_val_globals
                    # 2026-07-23). Mirror emit_bootstrap_str_const for Str;
                    # trust the declared type for the rest.
                    var const_read_ty = mir_const.type_
                    match mir_const.value:
                        case Str(_):
                            const_read_ty = MirType(kind: MirTypeKind.Opaque("str"))
                        case Bool(_):
                            # Raw 0/1 i64 lane: a bool-typed local is branched
                            # as bare `br i1 %lN` while the backend renders the
                            # Bool const as i64 arithmetic -- type it i64 so
                            # branch lowering inserts the icmp-ne widening
                            # (llc: "'%lN' defined with type 'i64' but
                            # expected 'i1'").
                            const_read_ty = MirType.i64()
                        case _:
                            pass
                    var b_const_read = self.builder
                    val const_dest = b_const_read.new_temp(const_read_ty)
                    b_const_read.emit_const(const_dest, mir_const.value, const_read_ty)
                    self.builder = b_const_read
                    return Some(const_dest)
                # Compound (Array/Tuple/Struct) match found in module.constants
                # but not scalar -- fall through to the global_const_exprs
                # re-lowering fallback below (outside this loop) instead of
                # returning nil here.
                cvi = const_values.len()
            else:
                cvi = cvi + 1
        # array_global_2026-07-25: fallback for a COMPOUND immutable module
        # `val` (Array/Tuple/Struct/...), reached either because the loop
        # above found a non-scalar `mir_const` match, or -- more commonly --
        # because `lower_const_expr` (function_lowering.spl's `lower_const`)
        # could not fold the initializer AT ALL (confirmed empirically: an
        # ArrayLit like `[2, 3]` returns nil from `lower_const_expr` on this
        # path, so `module.constants` never got an entry for this symbol in
        # the first place -- the earlier code comment claiming it "folds
        # fine at the MIR-constant level" did not hold up under test).
        # `global_const_exprs` (populated unconditionally by `lower_const`,
        # regardless of whether folding succeeded -- see its doc comment in
        # mir_lowering_types.spl) carries the ORIGINAL HIR initializer
        # expression; re-lower it fresh at this reference site, exercising
        # the real array/struct construction path (`lower_array_lit`'s
        # rt_array_new-based heap allocation) exactly as if the literal were
        # written inline at the use site (already proven to work). Safe
        # because the binding is immutable: every reference constructing an
        # independent equal value is observationally identical to sharing
        # one. Falls through to the existing `nil` -> "undefined variable"
        # error only if no initializer expr was recorded (should not happen
        # once `lower_const` has run for this symbol).
        if self.global_const_exprs.contains(symbol_id):
            # B2: the "immutable, so re-lowering is observationally identical"
            # premise above does NOT hold for a mutable array global -- say so
            # loudly (and fail the build under SIMPLE_STRICT_ARRAY_GLOBALS=1)
            # instead of quietly emitting code that drops every write. See
            # `report_mutable_array_global`.
            self.report_mutable_array_global(symbol_id)
            val hir_init = self.global_const_exprs[symbol_id]
            return Some(self.lower_expr(hir_init))
        nil

    fn local_is_runtime_array(local: LocalId) -> bool:
        if self.runtime_array_locals.contains(local.id): return true
        for item in self.builder.locals:
            if item.id.id == local.id:
                match item.type_.kind:
                    case MirTypeKind.Array(_, _): return true
                    case MirTypeKind.Slice(_): return true
                    case _: return false
        false

    fn local_is_runtime_dict(local: LocalId) -> bool:
        if self.runtime_dict_locals.contains(local.id):
            return true
        for item in self.builder.locals:
            if item.id.id == local.id:
                return rt_enum_discriminant(item.type_.kind) == rt_enum_discriminant(MirTypeKind.Dict(MirType.i64(), MirType.i64()))
        false
    fn noted_runtime_elem_type(container_local: LocalId) -> MirType?:
        """Nil-discriminating read of the store-observed element/value note.

        `runtime_elem_value_type` is a `Dict<i64, MirType>` held in a CLASS
        FIELD, and every consumer used to spell the read as the documented
        `contains(k)` + `d[k]` idiom (doc/07_guide/language/dict_native_pitfalls.md).
        On the self-hosted native backend that idiom is NOT sound for this
        receiver shape, and the two halves fail together:

        1. `.contains(k)` on a Dict-typed CLASS FIELD receiver does not reach
           `rt_dict_contains`. The field projection carries no HIR type and its
           MIR temp is typed i64, so `receiver_is_dict` stays false, the
           `local_is_runtime_dict` probe misses, and the call falls into the
           string-only arity-1 arm of `method_calls_literals.spl` — it is
           emitted as `lib.common.text.contains` with the dict handle passed as
           a text pointer. PROVED by disassembly of the stage-2 compiler:
           `lower_dict_runtime_read+633: call <lib__common__text__contains>`.
           The answer it returns is unrelated to key presence, so a MISS can
           report present. (Tracked separately — same silent-wrong-answer family
           as the array-receiver `contains`/`find`/`rfind` misroute already
           documented at method_calls_literals.spl:1847.)
        2. The following `d[k]` read of a MISSING key returns the tagged nil
           sentinel `3`, not a struct handle. Every consumer then read `.kind`
           off it; untagging `3` yields address `0` and the load SIGSEGVs, so
           the compiler DIED instead of reporting the real diagnostic (the
           `unresolved type:` cascade a `--source`-less native-build produces).

        Guarding key presence therefore cannot be trusted; the RESULT must be
        discriminated. `!= nil` lowers to `rt_native_neq(value, 3)`, which is
        exactly the sentinel test the miss produces. Callers get `nil` and keep
        their pre-existing default, so a lost note degrades a type refinement —
        never a crash, and never a silently different value.
        """
        if not self.runtime_elem_value_type.contains(container_local.id):
            return nil
        val noted = self.runtime_elem_value_type[container_local.id]
        if noted == nil:
            return nil
        Some(noted)

    me remember_field_projection_provenance(base: HirExpr, base_local: LocalId, field_idx: i64, result: LocalId):
        """Carry nested aggregate/array identity through a field projection."""
        val base_struct_name = self.resolve_base_struct_name(base, base_local)
        if val name = base_struct_name:
            if self.struct_field_type_name.contains(name):
                val nested_types = self.struct_field_type_name[name]
                if field_idx >= 0 and field_idx < nested_types.len():
                    val nested_name = nested_types[field_idx]
                    if nested_name != "":
                        self.struct_value_syms[result.id] = nested_name
            if self.struct_field_array_element_type_name.contains(name):
                val element_types = self.struct_field_array_element_type_name[name]
                if field_idx >= 0 and field_idx < element_types.len():
                    val element_name = element_types[field_idx]
                    if element_name != "":
                        self.runtime_array_locals[result.id] = true
                        self.mark_runtime_value_local(result.id)
                        # A1 (bug cranelift_native_aggregate_return_nil_
                        # receiver_hosted_wm_2026-07-26): record the
                        # "__runtime_array__" sentinel too, not only a real
                        # struct name. A field declared `events: [[text]]`
                        # gets exactly that sentinel from module_lowering.spl
                        # (its element is an Array, not a `Named` type), and
                        # dropping it here left `theme.events[i]` with no way
                        # to know the ELEMENT is itself a runtime array: the
                        # Index lowering below then decoded the element HANDLE
                        # as a plain i64/bootstrap-text scalar and never
                        # entered the decoded local in `runtime_array_locals`,
                        # so a following `.len()`/`[j]` lowered off a
                        # non-array local. Every consumer of this table
                        # already treats the sentinel as "not a real struct
                        # name" (`has_real_struct_name` in the Index case
                        # below, `for_has_real_struct_name` in
                        # mir_lowering_stmts.spl) and the copy-forward sites
                        # only test `!= ""`, so storing it is inert for them
                        # and adds only the element-is-an-array signal.
                        self.array_element_struct_syms[result.id] = element_name
            # Dict-typed FIELD provenance. Without this the projection temp for
            # `self.some_dict_field` is typed i64 and carries no HIR type, so
            # `receiver_is_dict` and `local_is_runtime_dict` both say no and
            # every dict method on it (`contains`/`has`/`contains_key`/`get`/
            # `keys`/`values`) falls through to an arm meant for another
            # receiver kind. For the arity-1 `contains` family that arm is the
            # STRING one: the dict handle was passed to `lib.common.text.contains`
            # as a text pointer and the answer had nothing to do with key
            # presence -- the same silent-wrong-answer class as the array
            # receiver misroute documented at method_calls_literals.spl:1847,
            # which excluded arrays but never dicts. Marking the temp here is
            # the receiver-side half of that fix and covers every
            # `Dict`-declared struct/class field at once, not one call site.
            if self.struct_field_hir_type.contains(name):
                val decl_field_types = self.struct_field_hir_type[name]
                # A missing/nil note must degrade to "unknown", never to a
                # `.len()` on the tagged nil sentinel (see
                # `noted_runtime_elem_type` for why this dict read cannot be
                # trusted on presence alone).
                if decl_field_types != nil and field_idx >= 0 and field_idx < decl_field_types.len():
                    match decl_field_types[field_idx].kind:
                        case HirTypeKind.Dict(_, _):
                            self.runtime_dict_locals[result.id] = true
                        # Array/Slice half of the SAME defect. The Dict arm
                        # above was landed alone, but an ARRAY-declared class
                        # field has exactly the same shape: the projection
                        # temp is typed i64 with no HIR type, so
                        # `local_is_runtime_array` misses and `.clear()` /
                        # `.len()` / `.contains()` on it fall into the string
                        # arm silently. The pre-existing array registration a
                        # few lines above fires only via
                        # `struct_field_array_element_type_name`, which
                        # records an entry only when the element type has a
                        # NAME (a `Named` type or the `__runtime_array__`
                        # nested-array sentinel) -- so a field declared
                        # `[i64]`, `[text]`, `[bool]` or `[f64]` got NOTHING
                        # and stayed misdispatched. Keying off the declared
                        # HIR type covers every array-typed field regardless
                        # of element kind. Marking is idempotent with the
                        # element-name path above.
                        case HirTypeKind.Array(_, _):
                            self.runtime_array_locals[result.id] = true
                            self.mark_runtime_value_local(result.id)
                        case HirTypeKind.Slice(_):
                            self.runtime_array_locals[result.id] = true
                            self.mark_runtime_value_local(result.id)
                        case _: ()

    fn mir_type_is_integer(t: MirType) -> bool:
        """True for the MIR kinds `decode_runtime_value` unboxes with `>> 3`.

        Kept in one place so the decode arm and the miss-sentinel guard in
        `lower_dict_runtime_read` can never disagree about which value types
        have their raw word transformed at read time.
        """
        val disc = rt_enum_discriminant(t.kind)
        disc == rt_enum_discriminant(MirTypeKind.I8) or disc == rt_enum_discriminant(MirTypeKind.U8) or disc == rt_enum_discriminant(MirTypeKind.I16) or disc == rt_enum_discriminant(MirTypeKind.U16) or disc == rt_enum_discriminant(MirTypeKind.I32) or disc == rt_enum_discriminant(MirTypeKind.U32) or disc == rt_enum_discriminant(MirTypeKind.I64) or disc == rt_enum_discriminant(MirTypeKind.U64) or disc == rt_enum_discriminant(MirTypeKind.Char)

    fn mir_type_is_str(t: MirType) -> bool:
        """True for the native string MIR types: the fat-pointer struct
        Tuple([Ptr(U8), U64]) that `Str` lowers to (function_lowering.lower_type)
        and the Opaque("str") raw-char* temp used by literal/interpolation
        lowering. The backend materializes both as a single raw char* value, so
        string `+` and `.len` route to rt_strcat/rt_strlen on that pointer."""
        match t.kind:
            case MirTypeKind.Opaque(name):
                return name == "str"
            case MirTypeKind.Tuple(elems):
                if elems.len() != 2:
                    return false
                var elem0_is_u8_ptr = false
                match elems[0].kind:
                    case MirTypeKind.Ptr(inner, _):
                        match inner.kind:
                            case MirTypeKind.U8: elem0_is_u8_ptr = true
                            case _: ()
                    case _: ()
                if not elem0_is_u8_ptr:
                    return false
                match elems[1].kind:
                    case MirTypeKind.U64: return true
                    case _: return false
            case _:
                return false

    fn local_is_str(local: LocalId) -> bool:
        """True when a lowered local holds a native string value.

        Tagged scalar-renderer results retain an i64 MIR ABI so codegen keeps
        their tagged handle representation. They are marked separately here;
        all other text remains keyed off the MIR local type because inferred
        HIR `.type_` is frequently nil on this path (flat HIR)."""
        if self.is_tagged_text_local(local.id):
            return true
        for item in self.builder.locals:
            if item.id.id == local.id:
                return self.mir_type_is_str(item.type_)
        false

    fn local_enum_type_id(local: LocalId) -> i64:
        """Return the declared enum symbol id for a proven enum local."""
        if val hir_type = self.find_local_hir_type(local.id):
            match hir_type.kind:
                case HirTypeKind.Named(symbol, _):
                    val enum_symbol = self.symbols.get_symbol_raw(symbol.id)
                    if val found_enum_symbol = enum_symbol:
                        if self.enum_variant_index.contains(found_enum_symbol.name):
                            return symbol.id
                case _:
                    ()
        -1

    fn local_is_float(local: LocalId) -> bool:
        """True when a lowered local holds an f64/f32 value.

        Keyed off the MIR local type (same rationale as local_is_str): HIR
        `.type_` is frequently nil on the flat path, so float-directed binop
        lowering must key off the MIR local type. Without this, arithmetic on
        floats gets an i64 dest from infer_binop_type and the backend emits
        integer add/mul on double BIT PATTERNS (garbage results)."""
        for item in self.builder.locals:
            if item.id.id == local.id:
                match item.type_.kind:
                    case MirTypeKind.F32 | MirTypeKind.F64: return true
                    case _: return false
        false

    fn local_is_f32(local: LocalId) -> bool:
        val type_ = self.local_mir_type_of(local)
        if type_ == nil:
            return false
        match type_.kind:
            case MirTypeKind.F32: true
            case _: false

    me coerce_concat_operand(local: LocalId) -> MirOperand:
        """strconcat2: `text + scalar` (e.g. `"n=" + 5`) must not hand the raw
        scalar bit pattern to rt_strcat_tagged -- rt_strcat_tagged unwraps
        each operand via rt_interp_cstr, which treats any non-tagged-string
        i64 as a raw char* and derefs it, SIGSEGVing on a plain int/bool/float
        operand (see bin_is_str_concat below). Mirrors
        lower_bootstrap_print_call's raw-render dispatch
        (switch_operators_calls.spl): render the scalar to a TAGGED heap
        string via rt_raw_i64_to_string/rt_raw_u64_to_string/
        rt_raw_bool_to_string/rt_raw_f64_to_string BEFORE it becomes a concat
        operand. Unlike that print path, no extra rt_interp_cstr unwrap is
        needed afterward: rt_strcat_tagged already runs every operand through
        rt_interp_cstr itself, and rt_interp_cstr's tagged-or-raw autodetect
        (bug #136) accepts the freshly tagged string handle directly.

        A str-typed operand passes through unchanged (this is also the
        text+text control path). An F32 operand is widened to F64 first
        (emit_cast) so rt_raw_f64_to_string's `double` ABI slot gets real
        float bits instead of a 32-bit value reinterpreted as 64-bit --
        widening here, before the value becomes a concat operand, is what
        sidesteps the separately-flagged double->ptr call-arg coercion bug in
        core_codegen (the coercion only misfires on an F64-typed operand
        reaching a call site as a bare arg; this path renders it to a tagged
        string handle first)."""
        if self.local_is_str(local):
            return mir_operand_copy(local)
        var is_bool = false
        var is_f32 = false
        var is_float = false
        var is_u64 = false
        var is_numeric = false
        if val ty = self.local_mir_type_of(local):
            match ty.kind:
                case MirTypeKind.Bool: is_bool = true
                case MirTypeKind.F32:
                    is_float = true
                    is_f32 = true
                case MirTypeKind.F64: is_float = true
                case MirTypeKind.U64: is_u64 = true
                case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64
                   | MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32:
                    is_numeric = true
                case MirTypeKind.Tuple(field_types):
                    # AOT tuples have no runtime type tag (bare rt_alloc
                    # block, no rt_tuple_* runtime API) -- render
                    # "(a, b, ...)" at COMPILE TIME via coerce_tuple_to_raw_str
                    # below (mirrors the array-literal `.join()` lowering's
                    # element splice). Return directly -- skip the scalar
                    # is_bool/is_float/... dispatch below.
                    return mir_operand_copy(self.coerce_tuple_to_raw_str(local, field_types))
                case _: ()
        if not (is_bool or is_float or is_u64 or is_numeric):
            return mir_operand_copy(local)
        val render_fn = if is_bool: "rt_raw_bool_to_string" elif is_float: "rt_raw_f64_to_string" elif is_u64: "rt_raw_u64_to_string" else: "rt_raw_i64_to_string"
        var render_src = mir_operand_copy(local)
        if is_f32:
            var b_widen = self.builder
            val widened = b_widen.emit_cast(mir_operand_copy(local), MirType.f64())
            self.builder = b_widen
            render_src = mir_operand_copy(widened)
        # Scalar renderers return a TAGGED runtime-string HANDLE, not a raw
        # C-string pointer. Keep that value nominally i64 until the one
        # explicit rt_interp_cstr bridge in bootstrap_coerce_to_raw_str.
        # In particular, never type the rt_raw_i64_to_string result as
        # Opaque("str"): doing so gives one SSA value incompatible nominal
        # identities across the renderer -> C-string boundary and lets a
        # later store/call treat tagged text as a raw pointer.
        var render_param_type = MirType.i64()
        if is_float:
            render_param_type = MirType.f64()
        val num_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(render_fn),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [render_param_type], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_num = self.builder
        val num_res = b_num.emit_call(num_op, [render_src], MirType.i64())
        self.builder = b_num
        if val num_local = num_res:
            self.mark_tagged_text_local(num_local.id)
            return mir_operand_copy(num_local)
        mir_operand_copy(local)

    me lower_tuple_field_raw(base_local: LocalId, elem_type: MirType, index: i64) -> LocalId:
        """Read tuple field `index` via a direct GEP+load off the tuple's
        raw rt_alloc(field_count*8) block. This is the SAME representation
        lower_tuple_lit builds (_MirLoweringExpr/literals.spl -- raw i64-slot
        GEP stores, no rt_tuple_* runtime header). Used only by
        coerce_tuple_to_raw_str below to render a tuple to text at compile
        time; NOT a general tuple-index lowering (that remains the
        HIR-level Index desugar, lower_index_expr above)."""
        var b = self.builder
        val idx_local = b.emit_const_int(index)
        val ptr = b.emit_gep(
            mir_operand_copy(base_local),
            [mir_operand_copy(idx_local)],
            MirType.ptr(elem_type, false)
        )
        val loaded = b.emit_load(mir_operand_copy(ptr), elem_type)
        self.builder = b
        loaded

    me coerce_tuple_to_raw_str(local: LocalId, field_types: [MirType]) -> LocalId:
        """Render a Tuple-typed local as "(a, b, ...)" at COMPILE TIME --
        see coerce_concat_operand's Tuple case above for why (no runtime
        tuple type tag under AOT). Reads each field via
        lower_tuple_field_raw, recursively renders it through
        bootstrap_coerce_to_raw_str (which itself routes back through
        coerce_concat_operand -- safe recursion, since a field's own type is
        never the SAME Tuple local), and splices the pieces with
        emit_raw_strcat, mirroring the array-literal `.join()` lowering
        (method_calls_literals.spl, ArrayLit case) element-by-element."""
        if field_types.len() == 0:
            var b_empty = self.builder
            val empty = b_empty.emit_const_str("()")
            self.builder = b_empty
            return empty
        var b_open = self.builder
        var acc = b_open.emit_const_str("(")
        self.builder = b_open
        var i = 0
        while i < field_types.len():
            if i > 0:
                var b_sep = self.builder
                val sep = b_sep.emit_const_str(", ")
                self.builder = b_sep
                acc = self.emit_raw_strcat(acc, sep)
            val field_local = self.lower_tuple_field_raw(local, field_types[i], i)
            val field_raw = self.bootstrap_coerce_to_raw_str(field_local)
            acc = self.emit_raw_strcat(acc, field_raw)
            i = i + 1
        var b_close = self.builder
        val close_paren = b_close.emit_const_str(")")
        self.builder = b_close
        acc = self.emit_raw_strcat(acc, close_paren)
        acc

    me box_runtime_value(local: LocalId) -> LocalId:
        if self.nil_locals.contains(local.id):
            var nil_builder = self.builder
            val tagged_nil = nil_builder.emit_const_int(3)
            self.builder = nil_builder
            self.mark_runtime_value_local(tagged_nil.id)
            return tagged_nil
        # A scalar renderer result is a tagged text handle even though its MIR
        # ABI type remains I64.  It is already valid RuntimeValue storage, so
        # preserve the handle at an Any/array/dict boundary instead of asking
        # rt_string_new to treat its tagged bits as a raw char*.
        if self.is_runtime_value_local(local.id) or self.is_tagged_text_local(local.id) or self.runtime_array_locals.contains(local.id) or self.runtime_dict_locals.contains(local.id):
            return local
        if self.local_is_str(local):
            val strlen = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_strlen"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
            ))
            var sb = self.builder
            val len = sb.emit_call(strlen, [mir_operand_copy(local)], MirType.i64())
            self.builder = sb
            if val length = len:
                val string_new = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_string_new"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                var nb = self.builder
                val tagged = nb.emit_call(string_new, [mir_operand_copy(local), mir_operand_copy(length)], MirType.i64())
                self.builder = nb
                if val value = tagged:
                    self.mark_runtime_value_local(value.id)
                    return value
            return local
        val type_ = self.local_mir_type_of(local)
        if type_ == nil:
            return local
        var b = self.builder
        val boxed = match type_.kind:
            case MirTypeKind.I64 | MirTypeKind.U64:
                # 64-bit-wide integers are the ONLY kinds that can overflow the
                # tagged immediate's 61-bit payload, so they -- and only they --
                # pay a call. `v << 3` silently sign-extended any |v| >= 2^60
                # back to a different number (2^60 -> negative, i64::MAX -> -1,
                # 2^62 -> 0), corrupting nanosecond timestamps, FNV/xxHash
                # seeds and i64::MAX sentinels merely by entering a container
                # (bug int61_bit_truncation_jit_scalars_and_native_container_
                # boxing_2026-08-09). rt_value_int_wide keeps the identical
                # `v << 3` immediate for in-range values and heap-boxes the
                # rest, which is the escape hatch
                # doc/04_architecture/compiler/array_value_abi_contract.md §1.1
                # already names as normative ("the encoder traps or heap-boxes;
                # silently truncating is a violation"). Mirror unbox is
                # decode_runtime_value's I64/U64 arm (rt_value_as_int_wide).
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                # Fallback first, mirroring the F64 arm's `boxed_opt ?? bits`
                # shape: should the call fail to materialize, the historical
                # inline form is still emitted rather than an unboxed word.
                val shift_wide = b.emit_const_int(3)
                val inline_shifted = b.emit_binop(MirBinOp.Shl, mir_operand_copy(widened), mir_operand_copy(shift_wide), MirType.i64())
                val box_int_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_int_wide"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val boxed_int = b.emit_call(box_int_fn, [mir_operand_copy(widened)], MirType.i64())
                boxed_int ?? inline_shifted
            case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.I16 | MirTypeKind.U16 | MirTypeKind.I32 | MirTypeKind.U32 | MirTypeKind.Char:
                # <= 32 bits: the payload cannot overflow 61 bits, so the
                # inline shift stays (no call, no perf change on these).
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                val shift = b.emit_const_int(3)
                b.emit_binop(MirBinOp.Shl, mir_operand_copy(widened), mir_operand_copy(shift), MirType.i64())
            case MirTypeKind.Bool:
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                val minus_eight = b.emit_const_int(-8)
                val nineteen = b.emit_const_int(19)
                val scaled = b.emit_binop(MirBinOp.Mul, mir_operand_copy(widened), mir_operand_copy(minus_eight), MirType.i64())
                b.emit_binop(MirBinOp.Add, mir_operand_copy(scaled), mir_operand_copy(nineteen), MirType.i64())
            case MirTypeKind.F32:
                # Widen to f64, then heap-box losslessly (see the F64 arm).
                val promoted = b.emit_cast(mir_operand_copy(local), MirType.f64())
                val bits = b.emit_bitcast(mir_operand_copy(promoted), MirType.i64())
                val box_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_float"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val boxed_opt = b.emit_call(box_fn, [mir_operand_copy(bits)], MirType.i64())
                boxed_opt ?? bits
            case MirTypeKind.F64:
                # Heap-box the f64 losslessly: rt_value_float allocates an
                # RtCoreFloat holding the full double and returns a TAG_HEAP ptr.
                # The old inline `(bits & ~7) | TAG_FLOAT` dropped the low 3
                # mantissa bits, so a container/Any float lost precision
                # ([0.1][0] != 0.1). Passing the raw i64 bits matches the C
                # `rt_value_float(int64_t raw_bits)` ABI; the mirror unbox is
                # decode_runtime_value's F64 arm (rt_value_as_float). A heap alloc
                # cannot be const-folded, so this now materializes at runtime.
                val bits = b.emit_bitcast(mir_operand_copy(local), MirType.i64())
                val box_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_float"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val boxed_opt = b.emit_call(box_fn, [mir_operand_copy(bits)], MirType.i64())
                boxed_opt ?? bits
            case _:
                local
        self.builder = b
        if boxed.id != local.id:
            self.mark_runtime_value_local(boxed.id)
        boxed

    # Record the f64/f32 type of a value stored into a container whose
    # declared element type may be the erased i64 default (empty `{}`/`[]`
    # literal). Reads consult runtime_elem_value_type so decode takes the
    # rt_value_as_float arm instead of shredding the heap-box ptr via `>>3`.
    me note_container_elem_type(container: LocalId, value_local: LocalId):
        val vt = self.local_mir_type_of(value_local)
        if vt != nil:
            val vt_disc = rt_enum_discriminant(vt.kind)
            if vt_disc == rt_enum_discriminant(MirTypeKind.F64) or vt_disc == rt_enum_discriminant(MirTypeKind.F32):
                self.runtime_elem_value_type[container.id] = vt
        # Bug (layoutglyph_struct_array_i64_field_tag_shift_readback):
        # lower_array_lit captures a struct-typed element's name into
        # array_element_struct_syms (keyed by the ARRAY's own local id) so
        # expr_dispatch's Index-read case can decode a re-read element as
        # Opaque(struct_name) -- a no-op passthrough, matching
        # box_runtime_value's own no-op for MirTypeKind.Struct. But a
        # container built via an initially-EMPTY `[]`/`{}` literal (fixed at
        # the i64 default, e.g. `var glyphs: [LayoutGlyph] = []`) that is
        # only ever populated via `.push(...)` or `arr[i] = ...` NEVER goes
        # through lower_array_lit's per-element loop, so
        # array_element_struct_syms is never populated for it. The Index-read
        # case then falls through decode_runtime_value's is_integer default
        # (raw >> 3), shredding the struct's heap pointer into a wild address
        # -- the next field access on it (a plain emit_get_field load) then
        # SIGSEGVs, or -- for scalar-looking bit patterns -- silently reads
        # back tag-shifted/masked garbage in every i64 field. Mirror
        # lower_array_lit's capture here (this helper already runs at every
        # push/index-assign call site, before box_runtime_value renames
        # nothing for Struct-kind values) so the read side learns the real
        # element type regardless of how the container was declared.
        val struct_name = self.struct_value_syms.get(value_local.id)
        if val sn = struct_name:
            if sn != "":
                self.array_element_struct_syms[container.id] = sn
        # Same shredding class, ARRAY elements (nested `[[text]]` /
        # `[[[text]]]`). Nothing else in the pipeline can tell an Index READ
        # that a container's elements are themselves runtime arrays: the
        # `__runtime_array__` sentinel is only ever written from a STRUCT FIELD
        # declaration, never into the per-local map the read consults, and an
        # outer container born from an empty `[]` literal has its element type
        # fixed at the erased i64 default. `outer[i] = inner` stores the inner
        # handle verbatim (box_runtime_value's runtime_array_locals
        # passthrough), so the store is the only site that still knows -- record
        # it here so the read reaches decode_runtime_value's Array arm (handle
        # copied through, runtime_array_locals re-registered) instead of the
        # is_integer `>> 3`, which turned every `outer[i].len()` into a silent
        # 0 while the outer `.len()` stayed correct.
        if self.local_is_runtime_array(value_local):
            var elem_array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
            if vt != nil:
                match vt.kind:
                    case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_):
                        elem_array_type = vt
                    case _:
                        ()
            self.runtime_elem_value_type[container.id] = elem_array_type

    me decode_runtime_value(raw: LocalId, result_type: MirType) -> LocalId:
        var b = self.builder
        val disc = rt_enum_discriminant(result_type.kind)
        val is_integer = self.mir_type_is_integer(result_type)
        if is_integer:
            if disc == rt_enum_discriminant(MirTypeKind.I64) or disc == rt_enum_discriminant(MirTypeKind.U64):
                # Mirror of box_runtime_value's I64/U64 arm: a wide value that
                # did not fit the 61-bit tagged immediate is heap-boxed, so a
                # bare `>> 3` would read back a shredded pointer. Narrower
                # integer kinds cannot be heap-boxed and keep the inline shift.
                val unbox_int_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_as_int_wide"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val unboxed = b.emit_call(unbox_int_fn, [mir_operand_copy(raw)], MirType.i64())
                if val unboxed_local = unboxed:
                    val decoded_wide = b.emit_cast(mir_operand_copy(unboxed_local), result_type)
                    self.builder = b
                    return decoded_wide
            val shift = b.emit_const_int(3)
            val value = b.emit_binop(MirBinOp.Shr, mir_operand_copy(raw), mir_operand_copy(shift), MirType.i64())
            val decoded = b.emit_cast(mir_operand_copy(value), result_type)
            self.builder = b
            return decoded
        if disc == rt_enum_discriminant(MirTypeKind.Bool):
            val true_value = b.emit_const_int(11)
            val decoded = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_copy(true_value), result_type)
            self.builder = b
            return decoded
        if disc == rt_enum_discriminant(MirTypeKind.F64):
            # Unbox via rt_value_as_float (dual-aware: heap-boxed lossless form,
            # or legacy inline TAG_FLOAT). Mirrors box_runtime_value's F64 heap
            # box. The old inline `raw & ~7` reinterpret dropped the low 3
            # mantissa bits at read time (a[0] != 0.1). Fallback below keeps the
            # legacy inline decode should the call fail to materialize.
            val unbox_fn = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_value_as_float"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.f64(), is_variadic: false)))
            ))
            val call_res = b.emit_call(unbox_fn, [mir_operand_copy(raw)], result_type)
            if call_res.?:
                val decoded_call = call_res ?? raw
                self.builder = b
                return decoded_call
            val mask = b.emit_const_int(-8)
            val bits = b.emit_binop(MirBinOp.BitAnd, mir_operand_copy(raw), mir_operand_copy(mask), MirType.i64())
            val decoded = b.emit_bitcast(mir_operand_copy(bits), result_type)
            self.builder = b
            return decoded
        if disc == rt_enum_discriminant(MirTypeKind.F32):
            # Unbox to f64 via rt_value_as_float, then narrow to f32.
            val unbox_fn = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_value_as_float"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.f64(), is_variadic: false)))
            ))
            val call_res = b.emit_call(unbox_fn, [mir_operand_copy(raw)], MirType.f64())
            if call_res.?:
                val f64_local = call_res ?? raw
                val decoded = b.emit_cast(mir_operand_copy(f64_local), result_type)
                self.builder = b
                return decoded
            val mask = b.emit_const_int(-8)
            val bits = b.emit_binop(MirBinOp.BitAnd, mir_operand_copy(raw), mir_operand_copy(mask), MirType.i64())
            val float64 = b.emit_bitcast(mir_operand_copy(bits), MirType.f64())
            val decoded = b.emit_cast(mir_operand_copy(float64), result_type)
            self.builder = b
            return decoded
        if disc == rt_enum_discriminant(MirTypeKind.Array(MirType.i64(), 0)) or disc == rt_enum_discriminant(MirTypeKind.Slice(MirType.i64())):
            val typed = b.new_temp(result_type)
            b.emit_copy(typed, raw)
            self.runtime_array_locals[typed.id] = true
            self.mark_runtime_value_local(typed.id)
            self.builder = b
            return typed
        if disc == rt_enum_discriminant(MirTypeKind.Dict(MirType.i64(), MirType.i64())):
            val typed = b.new_temp(result_type)
            b.emit_copy(typed, raw)
            self.runtime_dict_locals[typed.id] = true
            self.mark_runtime_value_local(typed.id)
            self.builder = b
            return typed
        if self.mir_type_is_str(result_type):
            # A string element/value read back off an array or dict is a
            # TAGGED heap-string handle (box_runtime_value tags raw string
            # literals via rt_strlen + rt_string_new before storing them),
            # but downstream string consumers (method calls,
            # tag_str_local_if_raw, etc.) expect a RAW char*. Left undecoded,
            # the tagged handle's bits get treated as a raw pointer -> SIGSEGV or
            # garbage (e.g. `for s in ["ab","cd"]: s.len()`). rt_interp_cstr
            # is the existing bug #136 autodetector: unwraps an
            # already-tagged handle to its real char* data buffer, or
            # passes an already-raw char* through unchanged -- so this is
            # safe regardless of which representation `raw` turns out to be.
            val cstr_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_interp_cstr"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
            ))
            val cstr_res = b.emit_call(cstr_op, [mir_operand_copy(raw)], MirType(kind: MirTypeKind.Opaque("str")))
            self.builder = b
            if val cstr_local = cstr_res:
                return cstr_local
            return raw
        self.mark_runtime_value_local(raw.id)
        self.builder = b
        raw

    me dict_get_preserve_flat_nil(raw: LocalId, decoded: LocalId, value_type: MirType) -> LocalId:
        """Route `rt_dict_get`'s MISS sentinel around `decode_runtime_value`.

        Bug `native_dict_get_miss_returns_zero_not_nil_2026-07-28`: on a miss
        `rt_dict_get` returns the flat-Option nil sentinel `RT_NIL == 3`
        (`rt_core_nil()`), and every decode arm that TRANSFORMS the raw word
        destroys it -- `3 >> 3` -> `0` (integer), `3 == 11` -> `false` (bool),
        `rt_interp_cstr(3)` -> `NULL` (str). Only the struct/default
        passthrough arm preserved it. A missing key was therefore
        indistinguishable from a stored zero, so `== nil`, `?? default` and
        `val Some(x) = ... else:` every one of them took the PRESENT branch on
        a miss -- silently, with nothing to crash on.

        `d.get(k)` is a FLAT-Option producer by design (see the "Option
        dual-ABI normalization" write-up in switch_operators_calls.spl): its
        `nil` IS the raw word `3`. So the sentinel has to go around the
        decode. `decoded` is already materialised in the current block and is
        harmless on the nil lane (`0` / `NULL`), so this only needs a select,
        not a re-ordering of the decode.
        """
        var merge_type = value_type
        if val decoded_type = self.local_mir_type_of(decoded):
            merge_type = decoded_type
        var b = self.builder
        val nil_key = b.emit_const_int(3)
        val is_nil = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_copy(nil_key), MirType.bool())
        val nil_block = b.new_block(Some("dict_get_miss_nil"))
        val value_block = b.new_block(Some("dict_get_hit_value"))
        val merge_block = b.new_block(Some("dict_get_merge"))
        val result = b.new_temp(merge_type)
        b.terminate_if(mir_operand_copy(is_nil), nil_block, value_block)
        self.builder = b

        var b_nil = self.builder
        b_nil.switch_to_block(nil_block)
        val nil_raw = b_nil.emit_const_int(3)
        val nil_typed = b_nil.emit_cast(mir_operand_copy(nil_raw), merge_type)
        b_nil.emit_copy(result, nil_typed)
        b_nil.terminate_goto(merge_block)
        self.builder = b_nil

        var b_val = self.builder
        b_val.switch_to_block(value_block)
        b_val.emit_copy(result, decoded)
        b_val.terminate_goto(merge_block)
        self.builder = b_val

        var b_merge = self.builder
        b_merge.switch_to_block(merge_block)
        self.builder = b_merge
        self.mark_runtime_value_local(result.id)
        result

    me lower_dict_runtime_get(base: HirExpr, base_local: LocalId, dict_key: LocalId) -> LocalId:
        self.lower_dict_runtime_read(base, base_local, dict_key, false)

    me lower_dict_runtime_read(base: HirExpr, base_local: LocalId, dict_key: LocalId, as_option: bool) -> LocalId:
        """The one `rt_dict_get` read shared by `d[k]` AND `d.get(k)`.

        `as_option` is true only for `d.get(k)`, whose declared result is
        `V?`: that path must preserve the MISS sentinel (see
        `dict_get_preserve_flat_nil`). `d[k]` (as_option false) keeps its
        existing raw-read behaviour byte for byte -- an index read has no
        `Option` to return, so there is nowhere for a miss signal to go.

        Both forms hit the SAME runtime call, so they must resolve the value
        type and decode identically -- but they had drifted apart, and the
        `.get()` copy was the weaker one (bug
        native_dict_get_struct_value_corrupt_option_2026-07-27):

        - `.get()` resolved the value type with a single unguarded
          `local_mir_type_of` lookup and, whenever that did not yield a
          `Dict(_, V)`, left `get_value_type` at the `MirType.i64()` default.
          `decode_runtime_value` then took its `is_integer` arm and did
          `raw >> 3` on a STRUCT value -- shredding the heap pointer into a
          wild address exactly as described in note_container_elem_type's
          comment above, so the first field read on the result SIGSEGVs
          (`d.get(k)` hit, then `.unwrap().name` -> crash), while a MISS
          stayed correctly nil because nil survives the shift as nil.
        - `.get()` also skipped the Bug #189 struct-symbol registration, so
          even an undamaged pointer lost its struct identity and every field
          access on it fell back to index 0.

        Keeping ONE implementation is the point: the two paths cannot
        re-diverge. Resolution order (widest that is still sound):
        1. the builder-tracked MIR type of the receiver local, accepted only
           behind the discriminant guard so a non-Dict kind can never be
           destructured as `Dict(_, V)`;
        2. the HIR annotation on the receiver expression -- now consulted
           whenever step 1 did not actually produce a Dict value type (it
           used to be gated on the local being entirely untracked, which made
           it nearly dead code: locals are almost always registered, just not
           always with a Dict type -- e.g. a `Dict`-typed STRUCT FIELD read,
           whose projection temp is typed i64 when the field access carries
           no HIR type);
        3. the store-observed element type, for an empty dict literal whose
           declared value type is stuck at the erased i64 default (an f64
           stored later would otherwise decode via `>>3` and leak the
           heap-box POINTER).
        """
        var dict_result_type = MirType.i64()
        var resolved_from_local = false
        var has_dict_mir_type = false
        var resolved_dict_mir_type = MirType.i64()
        for item in self.builder.locals:
            if item.id.id == base_local.id:
                has_dict_mir_type = true
                resolved_dict_mir_type = item.type_
        if has_dict_mir_type:
            if rt_enum_discriminant(resolved_dict_mir_type.kind) == rt_enum_discriminant(MirTypeKind.Dict(MirType.i64(), MirType.i64())):
                match resolved_dict_mir_type.kind:
                    case MirTypeKind.Dict(_, value_type):
                        dict_result_type = value_type
                        resolved_from_local = true
                    case _: ()
        if not resolved_from_local and base.has_type_ == true and base.type_ != nil:
            match base.type_.kind:
                case Dict(_, value_type):
                    dict_result_type = self.lower_type(value_type)
                case _: ()
        # Store-side refinement: an empty `{}` literal fixes the declared
        # value type at the i64 default, so an f64 stored later would decode
        # via the integer `>>3` arm and leak the heap-box POINTER. Use the
        # store-observed type instead.
        if rt_enum_discriminant(dict_result_type.kind) == rt_enum_discriminant(MirTypeKind.I64):
            if val noted_value_type = self.noted_runtime_elem_type(base_local):
                dict_result_type = noted_value_type
        val get_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_dict_get"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_dget = self.builder
        val get_res = b_dget.emit_call(get_op, [mir_operand_copy(base_local), mir_operand_copy(dict_key)], MirType.i64())
        self.builder = b_dget
        if val get_local = get_res:
            var value_is_bool = false
            match dict_result_type.kind:
                case MirTypeKind.Bool: value_is_bool = true
                case _: ()
            if as_option and value_is_bool:
                # `Option<bool>` has THREE states -- true, false and nil -- and
                # an `i1` can hold two. The decode arm collapses the raw word
                # to `raw == 11`, which both loses the miss sentinel AND made a
                # present `true` compare equal to `nil`. The flat ABI already
                # encodes all three in one word (11 / 0 / 3) and
                # `option_bool_value` (switch_operators_calls.spl) is its
                # matching decode, so hand the raw word back undecoded.
                self.mark_runtime_value_local(get_local.id)
                return get_local
            var decoded = self.decode_runtime_value(get_local, dict_result_type)
            # Only the decode arms that TRANSFORM the raw word destroy the miss
            # sentinel, and only those may be guarded: the struct / enum /
            # array / dict arms already pass `3` through untouched (so nil
            # already survives), and re-casting the sentinel into one of their
            # aggregate representations would be nonsense. f64 is deliberately
            # excluded too -- `rt_value_as_float` cannot round-trip a sentinel,
            # and an `Option<f64>` has no room for one in the flat ABI either
            # (tracked with the bool case in the bug doc).
            val guardable_value_type = self.mir_type_is_integer(dict_result_type) or self.mir_type_is_str(dict_result_type)
            if as_option and guardable_value_type:
                decoded = self.dict_get_preserve_flat_nil(get_local, decoded, dict_result_type)
            # Bug #189 (struct-valued Dict read misread): a struct-typed dict
            # result decodes via decode_runtime_value's default raw-passthrough
            # arm (no shift, correct bits), but that arm does not register the
            # VALUE's struct NAME in struct_value_syms the way lower_array_lit
            # already does via array_element_struct_syms. resolve_field_index's
            # fallback chain (HIR type annotation, then struct_value_syms keyed
            # by this local) then finds neither for a freshly-decoded dict-read
            # result and silently defaults every field access to index 0 --
            # `m["k1"].y` read `x`'s value instead of `y`'s (only invisible for
            # single-field structs, where field 0 IS the only field).
            # dict_result_type is already the correctly-resolved
            # Struct(symbol) here, so just look up its name and propagate it
            # the same way the array path does.
            var dict_struct_name = ""
            var dbg_arm_taken = false
            var dbg_sym_id = -1
            var dbg_sym_found = false
            match dict_result_type.kind:
                case MirTypeKind.Struct(struct_symbol):
                    dbg_arm_taken = true
                    dbg_sym_id = struct_symbol.id
                    if val struct_type_sym = self.symbols.get_symbol_raw(struct_symbol.id):
                        dbg_sym_found = true
                        if struct_type_sym.name != "":
                            dict_struct_name = struct_type_sym.name
                case _: ()
            # Bug #189, second half. The `Struct(symbol)` resolution above gets
            # the TYPE right -- decode_runtime_value takes the correct
            # raw-passthrough arm and the struct's bits survive intact, which is
            # why `.x` (field 0) always looked fine. But the numeric SymbolId
            # carried in the MIR type does NOT reliably resolve back to a named
            # symbol at this point in lowering, so `struct_value_syms` was never
            # written and `resolve_field_index` fell through its whole chain to
            # `0  # Default fallback` -- making EVERY field read return field 0's
            # word. `m["k"].y` returned `x` (invisible for a single-field
            # struct, where field 0 is the only field).
            #
            # `resolve_field_index`'s own leading comment states the rule this
            # restores: "Numeric SymbolIds are local to each module and can
            # collide ... A lowered local's name-keyed provenance is therefore
            # authoritative when available." The store side already recorded
            # exactly that name: `note_container_elem_type` runs at every
            # `d[k] = v` / push site and writes the value's struct NAME into
            # `array_element_struct_syms` keyed by the CONTAINER local. The
            # array Index-read path consumes it; the dict read never did. Use it
            # as the name-keyed fallback so both container reads agree.
            if dict_struct_name == "":
                val store_seen_name = self.array_element_struct_syms.get(base_local.id) ?? ""
                if store_seen_name != "" and store_seen_name != "__runtime_array__":
                    dict_struct_name = store_seen_name
            if dict_struct_name != "":
                self.struct_value_syms[decoded.id] = dict_struct_name
            if (mir_expr_env_get("SIMPLE_MIR_FIELD_TRACE") ?? "") == "1":
                val dbg_aes = self.array_element_struct_syms.get(base_local.id) ?? "<none>"
                print "[dict-read] base={base_local.id} decoded={decoded.id} arm={dbg_arm_taken} sym_id={dbg_sym_id} sym_found={dbg_sym_found} from_local={resolved_from_local} name='{dict_struct_name}' aes='{dbg_aes}'"
            return decoded
        base_local

    me host_gpu_runtime_func(name: text) -> MirOperand:
        MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(name),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))

    me split_interpolation_segments(value: text) -> [text]:
        """Bug #136: split an interpolated string literal into its N+1 literal
        text segments around N top-level `{...}` interpolation regions.

        The lexer copies each `{expr}` VERBATIM into `value`, so the literal
        text between/around the `{...}` regions is exactly what should surround
        the lowered interpolation-expr results. Brace depth is tracked so nested
        braces inside an expr (e.g. `{f({a: 1})}`) stay inside one region. Chars
        inside a `{...}` region are dropped here (the parsed expr is lowered
        separately from the interpolations list). Returns segments interleaving
        positionally with the interpolation exprs: seg0, expr0, seg1, ..., segN.
        """
        var segments: [text] = []
        var cur = ""
        var depth = 0
        var i = 0
        val n = value.len()
        while i < n:
            val ch = value[i:i + 1]
            val ch_next = if i + 1 < n: value[i + 1:i + 2] else: ""
            if depth == 0 and ch == "{" and ch_next == "{":
                # `{{` escape (doc
                # interp_brace_literal_collides_with_string_interpolation):
                # decode to a literal `{` in the segment text, do not open a
                # region. Must mirror flat_bridge_build_string_interps's
                # (10.frontend) identical skip exactly, or the regions found
                # here would drift out of positional alignment with that
                # function's interps list.
                cur = cur + "{"
                i = i + 1
            elif depth == 0 and ch == "}" and ch_next == "}":
                # `}}` escape, mirror of `{{` above.
                cur = cur + "}"
                i = i + 1
            elif depth == 0 and ch == "{":
                segments = segments.push(cur)
                cur = ""
                depth = 1
            elif depth > 0 and ch == "{":
                depth = depth + 1
            elif depth > 0 and ch == "}":
                depth = depth - 1
            elif depth == 0:
                cur = cur + ch
            i = i + 1
        segments = segments.push(cur)
        segments

    me emit_bootstrap_str_const(value: text) -> LocalId:
        """Emit a raw string-const local (an Opaque `str` char* pointer)."""
        var b = self.builder
        val dest = b.new_temp(MirType(kind: MirTypeKind.Opaque("str")))
        b.emit_const(dest, MirConstValue.Str(value), MirType(kind: MirTypeKind.Opaque("str")))
        self.builder = b
        dest

    me lower_string_interpolation(value: text, interps: [HirInterpolation]) -> LocalId:
        """Bug #136: lower an interpolated string literal to a real concatenated
        raw char* value instead of discarding the `{expr}` parts and emitting
        the verbatim literal.

        Split `value` into literal segments around the top-level `{...}` regions
        (positionally aligned with `interps`), lower each interpolation expr, and
        coerce it to a raw C string via rt_interp_cstr (handles both a tagged
        heap string -> its buffer, and an already-raw char* -> passthrough --
        the operands are statically undiscriminable). Concatenate the alternating
        [seg0, cstr(expr0), seg1, cstr(expr1), ..., segN] with rt_strcat, which
        takes and returns raw char*. The result is a raw char* (Opaque `str`),
        the same representation a plain string literal produces, so downstream
        consumers (rt_println, etc.) are unaffected.
        """
        val segments = self.split_interpolation_segments(value)
        # Number of interpolation slots to emit: guard against any mismatch
        # between {...} regions found and the parsed interps list.
        var slot_count = interps.len()
        if segments.len() - 1 < slot_count:
            slot_count = segments.len() - 1

        # result starts as the first literal segment (raw char*).
        # Two statements, NOT nested `self.a(self.b(...))`: a nested me-call in
        # argument position snapshots the receiver BEFORE the argument call's
        # builder mutations, so the outer method's write-back clobbers the
        # str-const emission and rewinds next_local_id -> the coerce call's
        # fresh dest collides with its own operand (`%lN = rt_interp_cstr(%lN)`,
        # llc "Only PHI nodes may reference their own value").
        val seg0_local = self.emit_bootstrap_str_const(segments[0])
        var result_local = self.bootstrap_coerce_to_raw_str(seg0_local)

        var k = 0
        while k < slot_count:
            # Lower the interpolation expr, then coerce to raw char* at runtime.
            # Intermediate var for the index access (seed chained-access quirk).
            val interp_item = interps[k]
            val interp_expr = interp_item.expr
            val interp_local = self.lower_expr(interp_expr)
            # Bug #136: coerce the operand to a raw char*. A string operand
            # (Opaque "str") passes straight through rt_interp_cstr. A non-string
            # operand -- e.g. `{a}` / `{a+b}` where `a` is an i64 -- must first be
            # rendered to a decimal string via rt_raw_i64_to_string (a tagged
            # string), which rt_interp_cstr then unwraps to its char* buffer.
            # Without this, rt_interp_cstr treats the raw i64 as a char* pointer
            # and derefs it -> SIGSEGV. The operand's lowered MIR type drives the
            # choice; a `val x = <int>` binding propagates the i64 init type to
            # the local so `{x}` routes to the numeric path.
            #
            # native_interp_bool_float: the old inline check here only tested
            # for Opaque("str") and otherwise ALWAYS rendered via
            # rt_raw_i64_to_string, so `"{3<5}"` printed "1"/"0" instead of
            # "true"/"false" (a bool's tag-adjusted i64 bit pattern misread as
            # a small decimal) and `"{2.5}"` printed garbage (an f64 bit
            # pattern reinterpreted as an integer via rt_raw_i64_to_string's
            # %lld format). coerce_concat_operand already implements the
            # exact type dispatch this needs -- str passthrough, else
            # bool/f32(widened)/f64/u64/i64 routed to the matching
            # rt_raw_*_to_string renderer, mirroring
            # lower_bootstrap_print_call -- so reuse it instead of
            # duplicating (and under-covering) that dispatch here. Its
            # output (str passthrough, or a freshly rt_raw_*_to_string
            # TAGGED handle) is exactly the shape rt_interp_cstr already
            # expects downstream.
            val cstr_local = self.bootstrap_coerce_to_raw_str(interp_local)
            result_local = self.emit_raw_strcat(result_local, cstr_local)
            # Append the following literal segment (split statements — see the
            # nested-me-call receiver-snapshot note on seg0 above).
            val next_seg_const = self.emit_bootstrap_str_const(segments[k + 1])
            val next_seg = self.bootstrap_coerce_to_raw_str(next_seg_const)
            result_local = self.emit_raw_strcat(result_local, next_seg)
            k = k + 1

        result_local

    me emit_raw_strcat(left: LocalId, right: LocalId) -> LocalId:
        """Concatenate two raw char* locals via rt_strcat (raw char* -> raw char*)."""
        val strcat_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_strcat"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
        ))
        var b = self.builder
        val res = b.emit_call(strcat_op, [mir_operand_copy(left), mir_operand_copy(right)], MirType(kind: MirTypeKind.Opaque("str")))
        self.builder = b
        if val res_local = res:
            res_local
        else:
            left

    me emit_host_gpu_runtime_call(name: text, args: [MirOperand]):
        var b = self.builder
        b.emit_call(self.host_gpu_runtime_func(name), args, MirType.i64())
        self.builder = b

    me lower_host_gpu_lane(lane_code: i64, payload_size: i64, marker: HirExpr, body: HirBlock) -> LocalId:
        self.lower_expr(marker)
        self.emit_host_gpu_runtime_call("rt_host_gpu_lane_event", [
            mir_operand_const_int(lane_code),
            mir_operand_const_int(1)
        ])
        if lane_code == 2:
            self.emit_host_gpu_runtime_call("rt_host_gpu_queue_emit", [
                mir_operand_const_int(lane_code),
                mir_operand_const_int(1),
                mir_operand_const_int(payload_size),
                mir_operand_const_int(0)
            ])
        self.lower_block(body)
        self.emit_host_gpu_runtime_call("rt_host_gpu_lane_event", [
            mir_operand_const_int(lane_code),
            mir_operand_const_int(2)
        ])
        var b = self.builder
        val result = b.new_temp(MirType.unit())
        self.builder = b
        result

    me emit_bounds_check_for_index(base_type: HirType?, base_local: LocalId, index_local: LocalId):
        """Emit an explicit bounds_check intrinsic before MIR indexed access."""
        # NOTE: avoid Option.unwrap() here -- the seed interpreter mishandles
        # .unwrap() on a "present" struct optional (a present optional is
        # stored as the bare payload; see mir_lowering_stmts.spl lower_stmt
        # and method_calls_literals.spl lower_method_call for the same
        # documented workaround). Use the explicit `if val` bind instead,
        # which correctly yields the bare HirType.
        var len_symbol = ""
        if val found_base_type = base_type:
            len_symbol = self.len_runtime_symbol_for_hir_type(found_base_type)
        if len_symbol == "":
            if self.local_is_runtime_array(base_local):
                len_symbol = "rt_array_len"
            else:
                # LOUD bailout (SF1 (d), 2026-07-28): no len symbol exists
                # for this base type, so no conservative check can be
                # emitted (there is no length source to compare against).
                # The indexed access proceeds UNCHECKED. Counted via
                # mir_bounds_check_bailouts(); per-site detail under
                # SIMPLE_MIR_BOUNDS_DEBUG=1.
                mir_bounds_check_bailout_count = mir_bounds_check_bailout_count + 1
                if (mir_expr_env_get("SIMPLE_MIR_BOUNDS_DEBUG") ?? "") == "1":
                    print("[mir] bounds-check bailout #{mir_bounds_check_bailout_count}: no len symbol for indexed base local {base_local.id} (access is UNCHECKED)")
                return
        val func_operand = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(len_symbol),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b = self.builder
        val len_result = b.emit_call(func_operand, [mir_operand_copy(base_local)], MirType.i64())
        if val len_local = len_result:
            b.emit(MirInst(
                kind: MirInstKind.Intrinsic(nil, "bounds_check", [
                    mir_operand_copy(index_local),
                    mir_operand_copy(len_local)
                ]),
                span: nil
            ))
        self.builder = b

    me resolved_call_hir_return_type(symbol: SymbolId) -> HirType?:
        # Bare-lift accumulator + explicit tail: explicit Some(...) on return
        # and mixed return/implicit-tail are both miscompiled on the stage4
        # native lane (bug doc 2026-07-23).
        # Primary source: declared return types recorded in the lower_module
        # pre-pass (fn_return_types, mir_lowering_types.spl) — the symbol
        # table's fn type_ is NOT reliably Function(...)-kind on this lane
        # (unresolved infer var observed). Bare-lift assign, no Some().
        if self.fn_return_types.contains(symbol.id):
            return self.fn_return_types[symbol.id]
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            # Name-keyed cross-module source: symbol IDs are per-module-table,
            # so a callee defined in another closure module never hits the
            # id-keyed map. The flat pre-pass registered every free fn's
            # declared return type globally (ambiguous names never answered).
            if val reg_ret = bootstrap_fn_ret_hir_type_lookup(found_sym.name):
                return reg_ret
            if val sym_type = found_sym.type_:
                match sym_type.kind:
                    case HirTypeKind.Function(_, ret, _):
                        return ret
                    case _:
                        ()
        nil

    me resolved_call_result_ok_shape(symbol: SymbolId) -> text?:
        """Cross-module-safe Ok-payload struct/class NAME for a `Result<T,E>`-
        returning callee, keyed by NAME (bootstrap_fn_ret_ok_shape_*) rather
        than the callee's per-module-table SymbolId.

        `resolved_call_hir_return_type` above already solves this for the
        OUTER declared return type via a name-keyed registry, but the HirType
        it returns for a Result-kind callee still carries the Ok payload as
        `HirTypeKind.Named(SymbolId)` verbatim, exactly as it was captured in
        the DEFINING module's own SymbolTable. Entry-closure lowering replaces
        the active SymbolTable per module, so that inner SymbolId is only
        valid there — dereferencing it against `self.symbols` while lowering
        a DIFFERENT (importing) module can coincidentally land on an
        unrelated symbol that happens to share the same numeric id (e.g. a
        sibling Method), silently mis-resolving the payload's struct name.
        See native_build_cross_module_result_payload_struct_name_collision_
        2026-08-09 (6th/7th layer)."""
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            if val shape = bootstrap_fn_ret_ok_shape_lookup(found_sym.name):
                return Some(shape)
        nil

    me field_array_element_override(struct_name: text, field_idx: i64) -> HirType?:
        if self.struct_field_array_elem_type.contains(struct_name):
            val element_types = self.struct_field_array_elem_type[struct_name]
            if field_idx >= 0 and field_idx < element_types.len():
                val element_type = element_types[field_idx]
                match element_type.kind:
                    case HirTypeKind.Error: return nil
                    case _: return element_type
        nil

    me resolved_call_hir_param_types(symbol: SymbolId) -> [HirType]:
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            # Cross-module declared param types (same prescan registry as
            # return types): without this a `fn f(a: i32, b: i64)` callee in
            # another module erased to all-i64 at the call site and rv32
            # marshaled the i64 into the wrong (unaligned) register pair.
            if val reg_params = bootstrap_fn_param_hir_types_lookup(found_sym.name):
                return reg_params
            if val sym_type = found_sym.type_:
                match sym_type.kind:
                    case HirTypeKind.Function(params, _, _):
                        return params
                    case _:
                        ()
        []

    me remember_call_hir_return(local: LocalId, symbol: SymbolId):
        val call_symbol = self.symbols.get_symbol_raw(symbol.id)
        if call_symbol != nil:
            val return_shape = bootstrap_fn_ret_shape_lookup(call_symbol.name)
            if return_shape != nil:
                val shape = return_shape ?? ""
                if shape == "__runtime_array__":
                    self.runtime_array_locals[local.id] = true
                elif shape != "":
                    self.struct_value_syms[local.id] = shape
        val return_type = self.resolved_call_hir_return_type(symbol)
        if val found_type = return_type:
            self.remember_local_hir_type(local.id, found_type, 0, 0)
            match found_type.kind:
                case HirTypeKind.Optional(_):
                    self.option_value_locals[local.id] = true
                    self.mark_runtime_value_local(local.id)
                case _:
                    ()

    me resolved_call_return_type(symbol: SymbolId) -> MirType:
        val hir_return_type = self.resolved_call_hir_return_type(symbol)
        if val found_type = hir_return_type:
            match found_type.kind:
                case HirTypeKind.Str:
                    # Call results carry runtime text HANDLES — same repr as
                    # literals (Opaque("str"), see bootstrap_text_type), NOT
                    # lower_type(Str)'s (ptr,len) fat-pointer Tuple. The Tuple
                    # typing sent user-fn text returns down the aggregate
                    # path and print rendered them as decimals.
                    return self.bootstrap_text_type()
                case _:
                    return self.lower_type(found_type)
        MirType.i64()

    me bitfield_field_mask(bit_width: i64) -> i64:
        """Return a signed i64 mask for a bitfield slice, including full-width fields."""
        if bit_width <= 0:
            return 0
        if bit_width >= 64:
            return -1
        (1 << bit_width) - 1

    me bitfield_field_result_type(field: HirBitfieldField) -> MirType:
        """Choose the MIR result type for a lowered bitfield field read."""
        match field:
            case HirBitfieldField(_, _, has_type_, type_, bit_width, _, _, _):
                if has_type_:
                    match type_.kind:
                        case Bool:
                            return MirType.bool()
                        case _:
                            return MirType.bits(bit_width)
                MirType.bits(bit_width)

    me bitfield_total_width(fields: [HirBitfieldField]) -> i64:
        """Return the packed storage width for a bitfield definition."""
        var total = 0
        for field in fields:
            match field:
                case HirBitfieldField(_, _, _, _, bit_width, _, _, _):
                    total = total + bit_width
        total

    me lower_return_expr(value: HirExpr?) -> LocalId:
        # Return's payload is HirExpr? (Optional): Some(expr) for
        # `return expr`, nil for a bare `return`.
        if val rv = value:
            var br = self.builder
            var result = self.lower_expr(rv)
            # current_function uses a boxed Option on this lane; only the
            # explicit Some arm unboxes it safely.
            var cur_builder = self.builder
            val declared_return: HirType? = match cur_builder.current_function:
                case Some(active_fn): self.resolved_call_hir_return_type(active_fn.symbol)
                case None: nil
            if val found_return = declared_return:
                match found_return.kind:
                    case HirTypeKind.Optional(_):
                        result = self.ensure_option_handle(result, found_return)
                    case _:
                        ()
            br = self.builder
            # WP-E: an explicit `return expr` is a real control-flow exit --
            # drop every still-owned resource local except `result` itself,
            # which is being handed back to the caller (a transfer, not a
            # drop; mirrors the implicit-return handling in
            # function_lowering.spl).
            self.emit_pending_resource_drops(Some(result))
            br = self.builder
            # Bug iso_transfer_sites_missing_move_return_assign_field
            # (2026-08-06), item #1's explicit-`return expr` twin of the
            # implicit-tail-return fix in function_lowering.spl: `result`
            # reached the Ret terminator as a bare `mir_operand_copy`
            # operand with no Move instruction backing it. This matters
            # even though the checker's `record_use` on a Copy operand
            # already flags a MOVED source read at the return site itself:
            # `record_use` only CHECKS moved_now, it never ADDS to it, so
            # an early `return a` inside one branch of an if/else left `a`
            # NOT marked moved for the checker's block-order forward walk
            # -- a later use of `a` in a sibling/merge block went
            # undetected. `record_move` (what a real Move instruction
            # triggers) does add to moved_now, closing that gap.
            var ret_operand = mir_operand_copy(result)
            if self.local_hir_type_isolation_state(result.id) == 1:
                var b_rmove = self.builder
                val rmove_ty = self.local_mir_type_of(result) ?? MirType.i64()
                val rmove_local = b_rmove.new_temp(rmove_ty)
                b_rmove.emit_move(rmove_local, result)
                self.builder = b_rmove
                br = self.builder
                ret_operand = mir_operand_copy(rmove_local)
            val ret_box: MirOperand? = Some(ret_operand)
            br.terminate_return(ret_box)
            self.builder = br
        else:
            self.emit_pending_resource_drops(nil)
            var br_void = self.builder
            br_void.terminate_return(nil)
            self.builder = br_void
        var br2 = self.builder
        val ret_temp = br2.new_temp(MirType.unit())
        self.builder = br2
        ret_temp

    me lower_index_expr_from_hir(expr_value: HirExpr) -> LocalId:
        val payload = rt_enum_payload(expr_value.kind)
        val base: HirExpr = rt_tuple_get(payload, 0)
        val index: HirExpr = rt_tuple_get(payload, 1)
        if base == nil or index == nil:
            self.error_fatal("empty HIR Index payload", Some(expr_value.span))
            return self.builder.emit_const_int(0)
        val has_result_hir_type = expr_value.has_type_ == true and expr_value.type_ != nil
        self.lower_index_expr(base, index, has_result_hir_type, expr_value.type_)

    me lower_index_expr(base: HirExpr, index: HirExpr, has_index_result_hir_type: bool, index_result_hir_type: HirType) -> LocalId:
        # Bug (array-slice-index SIGSEGV, CONFLICT-FLAG: expr_dispatch.spl
        # is fenced, touched here per the fence rule's "CONFLICT-FLAG if
        # must touch" allowance): `a[1:3]` where `a` is a runtime array
        # parses as an ordinary Index with `index` being a Range HIR
        # expr. lower_expr(Range) unconditionally calls lower_range
        # (function_lowering.spl), which is a KNOWN-incomplete stub --
        # its emitted call operand is a bare `MirConstValue.Int(0)`
        # ("function symbol -- will be resolved in codegen") that never
        # actually resolves to a real rt_range/array-slice runtime
        # symbol. The backend then has no valid callee and the whole
        # subtree silently collapses to a placeholder `0`, which this
        # Index arm then treats as a genuine index/pointer value --
        # inttoptr'ing and GEP/load'ing off address 0 at runtime
        # (SIGSEGV), the worst form of "silent wrong -> then crash"
        # this lane must never ship. Array-slice indexing has no
        # working native lowering today; fail the BUILD loudly and
        # cleanly (mirrors the existing unsupported-array-element
        # convention in lower_array_lit) instead of emitting IR that
        # crashes at runtime.
        match index.kind:
            case Range(_, _, _, _):
                self.error("unsupported array/string slice index a[start:end] (no native array-slice lowering; cannot safely lower to a value)", nil)
                return self.builder.emit_const_int(0)
            case _: ()
        # Runtime arrays are tagged handles, not raw element pointers.
        val base_local = self.lower_expr(base)
        # Dict handles compare keys as tagged heap values, so a `d[k]`
        # read routes to rt_dict_get with a tagged key -- NOT the raw GEP
        # array path below (which would treat the string key pointer as
        # an i64 element offset and emit invalid IR).
        if self.local_is_runtime_dict(base_local):
            # Value-type resolution, decode and struct-symbol registration all
            # live in lower_dict_runtime_get, shared verbatim with the
            # `d.get(k)` method lowering (method_calls_literals.spl) so the two
            # readers of rt_dict_get can never drift apart again.
            val dict_key = self.lower_dict_key(index)
            return self.lower_dict_runtime_get(base, base_local, dict_key)
        var index_local = self.lower_expr(index)
        if val cli_arg_local = self.try_lower_bootstrap_cli_arg_index(base, index_local):
            return cli_arg_local
        # Text values are tagged runtime handles, not raw element
        # pointers. Normalize literals and runtime-produced text to
        # the same representation before bounds checking and lookup.
        if self.local_is_str(base_local):
            val tagged_base = self.ensure_tagged_str(base_local)
            val text_len_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_string_len"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
            ))
            var b_text_len = self.builder
            val text_len_res = b_text_len.emit_call(text_len_op, [mir_operand_copy(tagged_base)], MirType.i64())
            if val text_len = text_len_res:
                b_text_len.emit(MirInst(
                    kind: MirInstKind.Intrinsic(nil, "bounds_check", [
                        mir_operand_copy(index_local),
                        mir_operand_copy(text_len)
                    ]),
                    span: nil
                ))
            self.builder = b_text_len
            val char_at_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_string_char_at"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
            ))
            var b_char_at = self.builder
            val char_at_res = b_char_at.emit_call(char_at_op, [mir_operand_copy(tagged_base), mir_operand_copy(index_local)], MirType.i64())
            self.builder = b_char_at
            if val char_at_local = char_at_res:
                return self.decode_runtime_value(char_at_local, MirType(kind: MirTypeKind.Opaque("str")))
            return base_local
        var result_type = MirType.i64()
        var result_type_from_base = false
        var has_base_mir_type = false
        var raw_pointer_base = false
        var base_mir_type = MirType.i64()
        for item in self.builder.locals:
            if item.id.id == base_local.id:
                has_base_mir_type = true
                base_mir_type = item.type_
                match item.type_.kind:
                    case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, _):
                        raw_pointer_base = true
                    case _:
                        ()
        val gpu_raw_pointer = raw_pointer_base and (self.current_gpu_kernel_target == "vulkan" or self.current_gpu_kernel_target == "cuda")
        if not gpu_raw_pointer:
            self.emit_bounds_check_for_index(base.type_, base_local, index_local)
        elif self.current_gpu_kernel_target == "vulkan":
            index_local = self.vulkan_u32_local(index_local)
        var is_tuple_base = false
        var tuple_field_mir_types: [MirType] = []
        if has_base_mir_type:
            match base_mir_type.kind:
                case MirTypeKind.Array(element_type, _):
                    result_type = element_type
                    result_type_from_base = true
                case MirTypeKind.Slice(element_type):
                    result_type = element_type
                    result_type_from_base = true
                case MirTypeKind.Ptr(element_type, _) | MirTypeKind.Ref(element_type, _):
                    result_type = element_type
                    result_type_from_base = true
                case MirTypeKind.Dict(_, value_type):
                    result_type = value_type
                    result_type_from_base = true
                case MirTypeKind.Tuple(field_types):
                    # Bug (native_pushed_tuple_into_empty_literal_list_
                    # unboxed_2026-08-02, gap (a) follow-up): `t.0`/`t.1`
                    # desugars to Index(base, IntLit(i)) at HIR-lowering time
                    # (20.hir/hir_lowering/expressions.spl,
                    # is_tuple_positional_field). Originally this arm
                    # deliberately did NOT set result_type from the tuple's
                    # own MIR field_types because, at the time, those were
                    # derived from each element's raw HIR `.type_`
                    # annotation in lower_tuple_lit (_MirLoweringExpr/
                    # literals.spl) -- unreliable for non-i64/mixed-type
                    # tuples. That source was fixed 2026-08-07
                    # (lower_tuple_lit now prefers
                    # `self.local_mir_type_of(local)`, the lowered
                    # element's own MIR-registered type, over the
                    # unreliable HIR annotation) -- field_types is now a
                    # trustworthy per-index type source and is kept here
                    # (gap (c) fix) as the tuple-index fallback below when
                    # HIR-sourced `index_result_hir_type` is unavailable
                    # (observed: `field_tuple_element_type`'s
                    # `local_tuple_types` lookup does not fire on every
                    # lowering path that reaches this function, e.g. a
                    # plain non-interpolated `val s = m.1`, leaving
                    # `has_index_result_hir_type` false and result_type
                    # stuck at the untyped i64 default).
                    is_tuple_base = true
                    tuple_field_mir_types = field_types
                    # Bug (tuple_constant_index_out_of_range_reads_oob_no_
                    # diagnostic_2026-08-08): tuple arity is statically
                    # known and `t.N` is a compile-time-constant index --
                    # an out-of-range index is a compile error, not a
                    # runtime concern. This is a defense-in-depth check
                    # independent of the primary HIR-level fix (which
                    # relies on `local_tuple_types`, a Dict whose
                    # `rt_dict_contains` was observed 2026-08-08 to return
                    # false immediately after a same-scope insert under
                    # native-build -- see the bug doc's "HIR-level fix is
                    # currently inert" note): `field_types` here comes
                    # straight off the matched MIR type, no Dict involved.
                    val mir_tuple_lit_idx = self.tuple_index_literal(index)
                    if mir_tuple_lit_idx >= 0 and mir_tuple_lit_idx >= field_types.len():
                        # error() alone is non-fatal (fatality is decided
                        # by a deprecated message-text allowlist in
                        # 80.driver) -- error_fatal() is the documented way
                        # to guarantee the build aborts instead of silently
                        # downgrading to a warning while the out-of-bounds
                        # GEP+load below still gets emitted.
                        self.error_fatal("tuple index {mir_tuple_lit_idx} is out of range for a {field_types.len()}-element tuple", base.span)
                case _: ()
        if not result_type_from_base and self.find_local_hir_type(base_local.id) != nil:
            val base_hir_type = self.find_local_hir_type(base_local.id) ?? HirType(kind: HirTypeKind.Error, span: base.span)
            match base_hir_type.kind:
                case HirTypeKind.Array(element_type, _) | HirTypeKind.Slice(element_type):
                    result_type = self.lower_type(element_type)
                    result_type_from_base = true
                case _: ()
        if (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1" and not result_type_from_base and not is_tuple_base:
            result_type = self.bootstrap_text_type()
        elif not result_type_from_base and has_index_result_hir_type:
            result_type = self.lower_type(index_result_hir_type)
        if is_tuple_base and not result_type_from_base and not has_index_result_hir_type:
            # gap (c) fallback (see the Tuple(field_types) arm above): no
            # HIR-sourced element type reached this call, so fall back to
            # the tuple's own MIR-registered field type at the literal
            # index instead of leaving result_type at the untyped i64
            # default.
            val lit_field_idx = self.tuple_index_literal(index)
            if lit_field_idx >= 0 and lit_field_idx < tuple_field_mir_types.len():
                result_type = tuple_field_mir_types[lit_field_idx]
        # Store-side refinement (mirror of the dict read above): an
        # empty `[]` literal fixes the element type at the i64 default;
        # a later `a.push(0.1)` / `a[i] = 0.1` heap-boxes, so decoding
        # as i64 would shred the box pointer via `>>3`.
        if val noted_elem_type = self.noted_runtime_elem_type(base_local):
            val array_disc = rt_enum_discriminant(MirTypeKind.Array(MirType.i64(), 0))
            val slice_disc = rt_enum_discriminant(MirTypeKind.Slice(MirType.i64()))
            val noted_disc = rt_enum_discriminant(noted_elem_type.kind)
            val result_disc = rt_enum_discriminant(result_type.kind)
            val noted_is_array = noted_disc == array_disc or noted_disc == slice_disc
            val result_is_array = result_disc == array_disc or result_disc == slice_disc
            # The erased-i64 gate alone cannot rescue nested arrays in the
            # freestanding lane: when the base MIR type was never threaded the
            # SIMPLE_BOOTSTRAP default a few lines up has ALREADY forced `text`,
            # and rt_interp_cstr on an inner array handle destroys it exactly as
            # `>> 3` would. A store-side ARRAY observation overrides that
            # default too — but never a result_type that is already an array,
            # whose element type came from the base and is the more precise of
            # the two (it feeds the next nesting level's own Index read).
            if result_disc == rt_enum_discriminant(MirTypeKind.I64) or (noted_is_array and not result_is_array):
                result_type = noted_elem_type
        val runtime_array = self.local_is_runtime_array(base_local)
        # Bug (native_pushed_tuple_into_empty_literal_list_unboxed_2026-08-02,
        # gap (a) follow-up, part 2): a tuple's physical storage is a raw
        # rt_alloc(field_count*8) block with NO rt_array header
        # (translate_aggregate's `case Tuple` in
        # 70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl -- "IDENTICAL
        # physical layout to Struct", explicitly not an rt_array). Routing a
        # tuple base through rt_array_get here -- which the plain
        # `SIMPLE_BOOTSTRAP=1` gate below did unconditionally, regardless of
        # `runtime_array` -- reads the tuple's raw field words as if they
        # were an SplArray header/length/elements-pointer, an out-of-bounds
        # or misinterpreted read (observed: `t.0`/`t.1` printed empty
        # instead of the field value). A tuple base must always take the
        # plain GEP+load else-branch below, which is the SAME single-index
        # native-int-word read `lower_tuple_field_raw`
        # (coerce_tuple_to_raw_str's helper, above in this file) and
        # `translate_get_field` already use for tuple/struct field reads.
        # (`is_tuple_base` was already computed above from the same
        # base_mir_type match -- no need to re-scan self.builder.locals.)
        if (runtime_array or (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1") and not is_tuple_base:
            val getter = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_array_get"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.ptr(result_type, false), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
            ))
            var bg = self.builder
            val getter_result = bg.emit_call(getter, [mir_operand_copy(base_local), mir_operand_copy(index_local)], MirType.i64())
            self.builder = bg
            if val getter_local = getter_result:
                # Bug s54/s54c/s54d: array_element_struct_syms is
                # registered (lower_array_lit for local literals,
                # function_lowering.spl's param-array Named-element
                # case for typed params -- root-fixed in s54d, see
                # 10.frontend/_FlatAstBridge/convert_nodes.spl's
                # array-generic-tag decode) with the REAL element
                # struct name whenever the element is a named
                # class/struct, and with "" / "__runtime_array__" (or
                # absent) for plain value-typed arrays (int/text/
                # bool/etc). Gate the Opaque decode strictly on a
                # real name so this stays a no-op for int arrays --
                # an earlier attempt that unconditionally marked
                # every runtime-array element as runtime_value
                # (regardless of element kind) corrupted int-array
                # reads (8x-too-large values from the un-skipped >>3
                # untag); see the revert commit for the falsified
                # unconditional version.
                val elem_struct_name = self.array_element_struct_syms.get(base_local.id)
                val esn = elem_struct_name ?? ""
                val has_real_struct_name = esn != "" and esn != "__runtime_array__"
                # A1 (bug cranelift_native_aggregate_return_nil_receiver_
                # hosted_wm_2026-07-26): an element that is ITSELF an array
                # (`[[text]]`, `[[i64]]`) sits in the outer slot as a runtime
                # array HANDLE, exactly like a named-struct element -- but
                # only the named-struct branch marked the raw `rt_array_get`
                # result as a runtime value, so an array element went down the
                # scalar decode (`>>3` shreds the handle) and the decoded
                # local was never registered in `runtime_array_locals`.
                # `nested[i].len()` / `nested[i][j]` then lowered off a
                # non-array local. Detected only when `result_type` did NOT
                # already derive to an Array/Slice from the base's MIR/HIR
                # type -- in that case the existing decode already takes the
                # Array arm. Registration mirrors
                # `emit_resolved_direct_call`'s Array/Slice return handling
                # (switch_operators_calls.spl): route the decode through an
                # Array-typed `decode_type` so `decode_runtime_value`'s
                # Array/Slice arm copies the handle untouched and sets both
                # `runtime_array_locals` and `mark_runtime_value_local` on the
                # decoded element. The inner element type is the best guess
                # available here (`result_type`, i.e. the scalar leaf default)
                # -- recovering the real one is the A2 lane's job.
                var elem_is_runtime_array = false
                if esn == "__runtime_array__":
                    match result_type.kind:
                        # rationale: an already Array/Slice-typed result_type
                        # reaches decode_runtime_value's Array arm on its own,
                        # which does this registration -- nothing to add.
                        case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_): ()
                        case _: elem_is_runtime_array = true
                val decode_type = if has_real_struct_name:
                    MirType(kind: MirTypeKind.Opaque(esn))
                elif elem_is_runtime_array:
                    MirType(kind: MirTypeKind.Slice(result_type))
                else:
                    result_type
                if has_real_struct_name or elem_is_runtime_array:
                    self.mark_runtime_value_local(getter_local.id)
                val decoded_elem = self.decode_runtime_value(getter_local, decode_type)
                # Bug (array-of-structs field misread): propagate the
                # array's known element struct name onto THIS decoded
                # element so a further `.field` access
                # (resolve_field_index's struct_value_syms fallback)
                # can find the real field order instead of silently
                # defaulting to field index 0 for every field name.
                if has_real_struct_name:
                    self.struct_value_syms[decoded_elem.id] = esn
                decoded_elem
            else:
                base_local
        elif is_tuple_base and self.tuple_index_literal(index) >= 0:
            # Bug (native_pushed_tuple_into_empty_literal_list_unboxed_2026-08-02,
            # gap (c), mixed-type tuple field READS): the plain
            # emit_gep/emit_load pair below loads the field's raw 8-byte
            # storage word straight into `result_type` with NO
            # storage-vs-logical reconciliation -- correct only when
            # `result_type` happens to already be a native-int-shaped type.
            # A str/bool/f64 tuple field's physical storage is still one
            # native-int word (same "every field is one word" layout
            # `translate_get_field` documents), so loading it directly as
            # "ptr"/"i1"/"double" is an `llc` type mismatch or a silent
            # bit-reinterpretation bug -- observed as `(1, "x").1` printing
            # a raw pointer-as-decimal instead of "x". `emit_get_field` +
            # its LLVM translation `translate_get_field`
            # (`70.backend/backend/_MirToLlvm/aggregate_intrinsics.spl`)
            # already implement exactly this dest_ty-keyed reconciliation
            # (ptr: load-then-inttoptr; float: load-then-bitcast; narrow
            # int/bool: load-then-trunc) for struct/tuple field reads
            # elsewhere in this file (e.g. line ~2108, ~3606) -- route the
            # tuple-index-desugared read through the same helper instead of
            # the raw GEP+load pair, rather than reinventing the
            # reconciliation here.
            var bf = self.builder
            val field_local = bf.emit_get_field(mir_operand_copy(base_local), self.tuple_index_literal(index), result_type)
            self.builder = bf
            field_local
        else:
            var b = self.builder
            val ptr = b.emit_gep(
                mir_operand_copy(base_local),
                [mir_operand_copy(index_local)],
                MirType.ptr(result_type, false)
            )
            val loaded = b.emit_load(mir_operand_copy(ptr), result_type)
            self.builder = b
            loaded

    me tuple_index_literal(index: HirExpr) -> i64:
        """Recover the literal field index from a `t.N` desugared Index
        expression (HirExprKind.IntLit), or -1 if `index` is not a literal
        int (e.g. a genuinely dynamic index on a tuple, which this lane does
        not support -- falls back to the plain GEP+load path)."""
        match index.kind:
            case IntLit(value, _):
                return value
            case _: ()
        -1


    me lower_cast_expr(operand: HirExpr, target: HirType, span: Span) -> LocalId:
        """Lower casts, extracting a runtime enum's resolved discriminant."""
        val operand_local = self.lower_expr(operand)
        val mir_target = self.lower_type(target)
        var target_is_integer = false
        match target.kind:
            case HirTypeKind.Int(_, _): target_is_integer = true
            case _: ()
        var operand_is_enum = false
        # Flat/bootstrap HIR frequently leaves expression .type_ unset. Enum
        # constructors register their result in local_hir_type_values, and let
        # bindings propagate that entry, so consult the shared local registry
        # after lowering before falling back to syntax annotations.
        if self.local_enum_type_id(operand_local) >= 0:
            operand_is_enum = true
        if self.option_value_locals.contains(operand_local.id):
            operand_is_enum = true
        # `has_type_ == true` does NOT imply `type_ != nil` on the
        # flat-bootstrap HIR lane: the two fields are set independently and a
        # node routinely carries the flag with a nil type. Reading
        # `operand.type_.kind` on such a node is a field access on a nil
        # receiver -> ud2/SIGILL, which is what killed Stage 3 here (rc 132).
        # lower_index_expr_from_hir above already pairs the flag with an
        # explicit `!= nil` test for exactly this reason; mirror it.
        if operand.has_type_ and operand.type_ != nil:
            match operand.type_.kind:
                case HirTypeKind.Named(symbol, _):
                    val symbol_info = self.symbols.get_symbol_raw(symbol.id)
                    if val info = symbol_info:
                        operand_is_enum = self.enum_variant_index.has(info.name)
                case HirTypeKind.Optional(_): operand_is_enum = true
                case HirTypeKind.Result(_, _): operand_is_enum = true
                case _: ()
        if target_is_integer and operand_is_enum:
            var enum_builder = self.builder
            val disc_func = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_enum_discriminant"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
            ))
            val disc_result = enum_builder.emit_call(disc_func, [mir_operand_copy(operand_local)], MirType.i64())
            self.builder = enum_builder
            if val resolved_disc = disc_result:
                if rt_enum_discriminant(mir_target.kind) == rt_enum_discriminant(MirTypeKind.I64):
                    return resolved_disc
                var cast_builder = self.builder
                val narrowed = cast_builder.emit_cast(mir_operand_copy(resolved_disc), mir_target)
                self.builder = cast_builder
                return narrowed
            self.error("enum-to-integer cast could not read runtime discriminant", Some(span))
            return operand_local
        var cast_builder = self.builder
        val result = cast_builder.emit_cast(mir_operand_copy(operand_local), mir_target)
        self.builder = cast_builder
        result

    me lower_expr(expr: HirExpr) -> LocalId:
        """Lower HIR expression to MIR, return result local.

        DS5 (mir-span-thread, 2026-07-28): thin save/set/restore wrapper
        around lower_expr_impl. Pushes this node's own span onto
        self.builder.current_span before dispatch and pops it back on the
        way out, so:
          - a leaf node (Const/Var/...) emits with ITS OWN span (set here,
            never overwritten before its emit_* call runs), and
          - a compound node (BinOp/Call/...) that recurses into lower_expr
            for its operands FIRST and emits its own instruction AFTER gets
            its own span back for that final emit, not its last operand's
            span -- because every recursive self.lower_expr(child) call
            saves/restores around itself via this same wrapper.
        All recursive descent must go through this name (not
        lower_expr_impl directly) for the stack discipline to hold.
        """
        # Garbage-child detector + parent breadcrumb, BEFORE the span push
        # below -- that push already dereferences `expr.span`, so the check has
        # to come first to stay useful on a wild handle. `expr.kind` that is not
        # a live boxed enum cannot have come from a real HIR node; it is a
        # mis-extracted payload. Detect it HERE (the single choke point every
        # lowered expression passes through) and name the PARENT that handed it
        # down, because the parent still has a valid span while the garbage
        # child's `.span` is unreadable.
        var garbage_saved_file = ""
        var garbage_saved_line = -1
        var garbage_saved_col = -1
        var garbage_saved_disc = -1
        var garbage_breadcrumb_pushed = false
        var garbage_expr_here = false
        if mir_lower_garbage_debug_state < 0:
            if mir_lower_garbage_debug_enabled():
                mir_lower_garbage_debug_state = 1
            else:
                mir_lower_garbage_debug_state = 0
        if mir_lower_expr_trace_state < 0:
            if mir_trace_enabled():
                mir_lower_expr_trace_state = 1
            else:
                mir_lower_expr_trace_state = 0
        if mir_lower_garbage_debug_state == 1 and expr != nil:
            val garbage_disc = rt_enum_discriminant(expr.kind)
            if garbage_disc < 0:
                garbage_expr_here = true
                mir_lower_garbage_expr_count = mir_lower_garbage_expr_count + 1
                eprint("[mir-lower-expr] garbage-expr-kind bits={expr.kind} parent_disc={mir_lower_parent_expr_disc} parent_at={mir_lower_parent_expr_file}:{mir_lower_parent_expr_line}:{mir_lower_parent_expr_col}\n")
            else:
                garbage_saved_file = mir_lower_parent_expr_file
                garbage_saved_line = mir_lower_parent_expr_line
                garbage_saved_col = mir_lower_parent_expr_col
                garbage_saved_disc = mir_lower_parent_expr_disc
                garbage_breadcrumb_pushed = true
                mir_lower_parent_expr_file = expr.span.file
                mir_lower_parent_expr_line = expr.span.line
                mir_lower_parent_expr_col = expr.span.col
                mir_lower_parent_expr_disc = garbage_disc
        var b_span_save = self.builder
        val saved_span = b_span_save.current_span
        var span_method_name = ""
        # `expr` is defensively nilable here (lower_expr_impl substitutes a
        # synthetic nil_expr when it is) -- guard the same way before the
        # first field deref so a nil expr doesn't crash the span push.
        if expr != nil and not garbage_expr_here:
            b_span_save.current_span = Some(expr.span)
            match expr.kind:
                case MethodCall(_, found_method_name, _, _):
                    span_method_name = found_method_name
                case _:
                    ()
        self.builder = b_span_save
        var span_result = self.lower_expr_impl(expr)
        if garbage_breadcrumb_pushed:
            mir_lower_parent_expr_file = garbage_saved_file
            mir_lower_parent_expr_line = garbage_saved_line
            mir_lower_parent_expr_col = garbage_saved_col
            mir_lower_parent_expr_disc = garbage_saved_disc
        # A nil LocalId is not representable downstream: every consumer
        # (local_mir_type_of, mir_operand_copy, emit_*) reads `.id` straight
        # away, so a nil here surfaces as `runtime error: field access on nil
        # receiver` + ud2 (SIGILL) in a callee, with no hint of which
        # expression produced it. Catch it at the single choke point every
        # lowered expression passes through, name it, and substitute a real
        # temp so the accumulated diagnostics actually get reported.
        if span_result == nil:
            self.error_fatal("MIR lowering produced no local for this expression", nil)
            if mir_lower_expr_trace_state == 1:
                eprint("[mir-lower-expr] nil-local-from-impl method={span_method_name}\n")
            var b_nil_local = self.builder
            span_result = b_nil_local.new_temp(MirType.unit())
            self.builder = b_nil_local
        if mir_lower_expr_trace_state == 1 and span_method_name != "":
            eprint("[mir-lower-expr] impl-return method={span_method_name} id={span_result.id}\n")
        var b_span_restore = self.builder
        if mir_lower_expr_trace_state == 1 and span_method_name != "":
            eprint("[mir-lower-expr] span-builder-read method={span_method_name}\n")
        b_span_restore.current_span = saved_span
        if mir_lower_expr_trace_state == 1 and span_method_name != "":
            eprint("[mir-lower-expr] span-restored-local method={span_method_name}\n")
        self.builder = b_span_restore
        if mir_lower_expr_trace_state == 1 and span_method_name != "":
            eprint("[mir-lower-expr] span-builder-written method={span_method_name} id={span_result.id}\n")
        span_result

    me lower_binary_expr(expr_value: HirExpr, op: HirBinOp, left: HirExpr, right: HirExpr) -> LocalId:

        match op:
            case PipeForward | Compose | ComposeBack | Parallel | LayerConnect:
                val special_result = self.lower_binop_special(op, left, right)
                if val special_local = special_result:
                    special_local
                else:
                    var b_special = self.builder
                    val temp = b_special.new_temp(MirType.i64())
                    self.builder = b_special
                    temp
            case And | Or:
                # Both operands of `and`/`or` sit in CONDITION position, so
                # they must go through lower_cond_expr, not the raw value
                # dispatcher. lower_cond_expr's docstring
                # (mir_lowering_stmts.spl:1836) already ASSERTS this
                # invariant -- "not/and/or already funnel their operands back
                # through the condition path via their own lowering, so they
                # need nothing here" -- but this arm called lower_expr, so the
                # invariant was false and the whole `.?`/bare-optional
                # condition normalization was skipped for logical operands.
                # Consequence: `opt.? and rhs()` / `opt and rhs()` branched on
                # the RAW payload-or-sentinel word, and RT_NIL is the NON-ZERO
                # integer 3, so an ABSENT optional tested TRUE -- the left
                # operand was effectively ignored, silently taking the wrong
                # branch. Same class of bug as
                # bare_optional_in_condition_position_wrong_branch, which fixed
                # `if`/`while` but left `and`/`or` behind.
                val left_local = self.lower_cond_expr(left)
                var b_logic = self.builder
                val rhs_block = b_logic.new_block(Some("logic_rhs"))
                val short_block = b_logic.new_block(Some("logic_short"))
                val merge_block = b_logic.new_block(Some("logic_merge"))
                # The merge slot has function lifetime. Keep its alloca in
                # entry so a logical expression inside a loop does not grow
                # the native stack on every iteration.
                val result_slot = b_logic.emit_entry_alloc(MirType.i64())
                match op:
                    case And: b_logic.terminate_if(mir_operand_copy(left_local), rhs_block, short_block)
                    case _: b_logic.terminate_if(mir_operand_copy(left_local), short_block, rhs_block)
                self.builder = b_logic

                var b_short = self.builder
                b_short.switch_to_block(short_block)
                val short_int = match op:
                    case And: 0
                    case _: 1
                val short_value = b_short.emit_const_int(short_int)
                b_short.emit_store(mir_operand_copy(result_slot), mir_operand_copy(short_value))
                b_short.terminate_goto(merge_block)
                self.builder = b_short

                var b_rhs = self.builder
                b_rhs.switch_to_block(rhs_block)
                self.builder = b_rhs
                # RHS is in condition position too -- same reasoning as the
                # LHS above. The Bool->i64 normalization below still applies
                # on top of whatever lower_cond_expr returns.
                val right_local = self.lower_cond_expr(right)
                var right_value = right_local
                var b_rhs_done = self.builder
                if val right_type = self.local_mir_type_of(right_local):
                    match right_type.kind:
                        case MirTypeKind.Bool:
                            right_value = b_rhs_done.emit_cast(mir_operand_copy(right_local), MirType.i64())
                        case _: ()
                b_rhs_done.emit_store(mir_operand_copy(result_slot), mir_operand_copy(right_value))
                b_rhs_done.terminate_goto(merge_block)
                b_rhs_done.switch_to_block(merge_block)
                # The merge slot itself stays i64 (both arms store 0/1
                # ints; a Bool rhs is zext'd above), but the RESULT
                # local must be typed Bool: downstream type dispatch --
                # lower_bootstrap_print_call, coerce_concat_operand --
                # keys off local_mir_type_of, and an I64-typed result
                # routes print(a and b) to rt_raw_i64_to_string ("0"/
                # "1") instead of rt_raw_bool_to_string ("true"/
                # "false") (strict-llvm parity case
                # logical_short_circuit). Normalize via `!= 0` -- a
                # compare with i64 operands and a Bool dest is the
                # established legal pattern (see the tagged-bool decode
                # above: emit_binop(Eq, raw, true_value, bool)); it
                # avoids the illegal i64->i1 narrowing bitcast that
                # loading the slot directly as Bool would risk.
                val merged_int = b_rhs_done.emit_load(mir_operand_copy(result_slot), MirType.i64())
                val logic_zero = b_rhs_done.emit_const_int(0)
                val logic_result = b_rhs_done.emit_binop(MirBinOp.Ne, mir_operand_copy(merged_int), mir_operand_copy(logic_zero), MirType.bool())
                self.builder = b_rhs_done
                logic_result
            case _:
                val left_local = self.lower_expr(left)
                val right_local = self.lower_expr(right)
                # Custom enum values are tagged runtime handles, so a
                # raw backend Eq compares allocation addresses. Route
                # only operands proven to share one declared enum type
                # before Named values can enter struct-dunder dispatch;
                # all user enums currently share enum_id=0.
                # `opt == nil` / `opt != nil` (and the `if val v =
                # opt:` -> `v != nil` desugar that reaches here via
                # lower_cond_expr's `case _: self.lower_expr(cond)`
                # fallthrough, mir_lowering_stmts.spl:1773) against a
                # STATICALLY Optional-typed operand: route straight
                # through rt_is_some/rt_is_none instead of the
                # enum-equality machinery below. rt_is_none
                # (runtime_native.c) already discriminates BOTH
                # representations an Optional value can carry at this
                # point -- the boxed `rt_enum_new` handle every real
                # producer creates via ensure_option_handle (function
                # returns, Some()/None() literals, annotated var
                # decls), AND the flat sentinel-or-payload word `.?`
                # (HirExprKind.ExistsCheck) produces directly (its
                # condition-position lowering right above already
                # calls rt_is_some on that exact representation) --
                # so this needs no option_value_locals/nil_locals
                # bookkeeping and is correct regardless of whether
                # the compiler's own registration tracking followed
                # the value through every intervening copy. Checked
                # via the operands' STATIC HIR type (`left.type_` /
                # `right.type_`, populated by the type-checker on
                # every HirExpr), not local-id registration, so a
                # copy or an unregistered call result is still
                # detected correctly. Closes bug
                # pure_simple_option_i64_ifval_always_some_eqnil_always_false_2026-08-08
                # (both `if val` always-Some and `== nil`
                # always-false were the SAME representation-blind raw
                # scalar compare fixed for Option<bool> literals in
                # ab773bb5d5e/ab3af6f728e, just never extended to a
                # nil-vs-Optional-typed-operand pairing).
                val op_is_eq_or_neq = match op:
                    case Eq | NotEq: true
                    case _: false
                val left_is_nil_lit = match left.kind:
                    case NilLit: true
                    case _: false
                val right_is_nil_lit = match right.kind:
                    case NilLit: true
                    case _: false
                var nil_check_operand = LocalId(id: -1)
                if op_is_eq_or_neq and right_is_nil_lit and not left_is_nil_lit:
                    if hir_expr_is_optional_type(left) or self.option_value_locals.contains(left_local.id):
                        nil_check_operand = left_local
                elif op_is_eq_or_neq and left_is_nil_lit and not right_is_nil_lit:
                    if hir_expr_is_optional_type(right) or self.option_value_locals.contains(right_local.id):
                        nil_check_operand = right_local
                if nil_check_operand.id >= 0:
                    val nil_check_func_name = match op:
                        case Eq: "rt_is_none"
                        case _: "rt_is_some"
                    val nil_check_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str(nil_check_func_name),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                            params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false
                        )))
                    ))
                    val nil_check_res = self.emit_resolved_direct_call(nil_check_func, [mir_operand_copy(nil_check_operand)], MirType.bool())
                    if val nil_check_local = nil_check_res:
                        return nil_check_local
                var bin_is_enum_eq = false
                var eq_left_local = left_local
                var eq_right_local = right_local
                match op:
                    case Eq | NotEq:
                        val left_enum_type = self.local_enum_type_id(left_local)
                        val right_enum_type = self.local_enum_type_id(right_local)
                        bin_is_enum_eq = left_enum_type >= 0 and left_enum_type == right_enum_type
                        if not bin_is_enum_eq:
                            # `Some(true) == true` (an Option<bool> compared
                            # against a bare bool/nil literal): the Option
                            # side is a boxed rt_enum_new handle registered in
                            # option_value_locals, but Option locals never get
                            # a declared HIR enum type recorded (see
                            # lower_enum_construct_named -- the "Option" arm
                            # deliberately skips remember_local_hir_type), and
                            # a raw `true`/`false`/`nil` literal never has one
                            # either. local_enum_type_id therefore returns -1
                            # for BOTH sides here, so the check above always
                            # misses this pairing and it falls through to a
                            # raw scalar Eq that compares a boxed
                            # pointer/handle against a 0/1/3 word -- always
                            # false regardless of the actual value (verified
                            # empirically: `Some(true) == true` printed
                            # "false"). Box the literal side into the same
                            # canonical Option handle representation
                            # (ensure_option_handle, used by `??`/field-
                            # default lowering) so both operands are boxed
                            # handles rt_native_eq already knows how to
                            # compare. ensure_option_handle itself consults
                            # nil_locals to pick Some vs None, so a `nil`
                            # literal on the wrapped side round-trips to a
                            # real None handle for free.
                            val left_is_option = self.option_value_locals.contains(left_local.id)
                            val right_is_option = self.option_value_locals.contains(right_local.id)
                            val opt_bool_type = HirType(kind: HirTypeKind.Optional(HirType(kind: HirTypeKind.Bool, span: nil)), span: nil)
                            if left_is_option and not right_is_option:
                                var right_wrappable = self.nil_locals.contains(right_local.id)
                                if not right_wrappable:
                                    if val right_ty = self.local_mir_type_of(right_local):
                                        match right_ty.kind:
                                            case MirTypeKind.Bool: right_wrappable = true
                                            case _: ()
                                if right_wrappable:
                                    eq_right_local = self.ensure_option_handle(right_local, opt_bool_type)
                                    bin_is_enum_eq = true
                            elif right_is_option and not left_is_option:
                                var left_wrappable = self.nil_locals.contains(left_local.id)
                                if not left_wrappable:
                                    if val left_ty = self.local_mir_type_of(left_local):
                                        match left_ty.kind:
                                            case MirTypeKind.Bool: left_wrappable = true
                                            case _: ()
                                if left_wrappable:
                                    eq_left_local = self.ensure_option_handle(left_local, opt_bool_type)
                                    bin_is_enum_eq = true
                    case _:
                        ()
                if bin_is_enum_eq:
                    val enum_eq_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_native_eq"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_enum_eq = self.builder
                    val enum_eq_res = b_enum_eq.emit_call(enum_eq_func, [mir_operand_copy(eq_left_local), mir_operand_copy(eq_right_local)], MirType.i64())
                    self.builder = b_enum_eq
                    if val enum_eq_local = enum_eq_res:
                        val enum_raw_bool = match op:
                            case NotEq:
                                var b_enum_neq = self.builder
                                val inverted = b_enum_neq.emit_binop(MirBinOp.BitXor, mir_operand_copy(enum_eq_local), mir_operand_const_int(1), MirType.i64())
                                self.builder = b_enum_neq
                                inverted
                            case _: enum_eq_local
                        var b_enum_narrow = self.builder
                        val enum_bool = b_enum_narrow.emit_binop(MirBinOp.Eq, mir_operand_copy(enum_raw_bool), mir_operand_const_int(1), MirType.bool())
                        self.builder = b_enum_narrow
                        return enum_bool
                # #168: struct-operand binary ops must dispatch to the
                # user's own __add__/__sub__/__mul__/__div__/__eq__/
                # __lt__/__gt__ impl method instead of falling through
                # to the generic emit_binop below. A struct value is a
                # POINTER to an aggregate (see lower_struct_construct),
                # so the generic path's raw i64 ADD/CMP on that
                # pointer bit pattern produces a garbage
                # pointer/comparison result that SIGBUSes on first
                # deref (verified empirically: `a + b` on two structs
                # with a user `__add__` crashed with SIGBUS before this
                # fix -- previously silent-wrong at build time, only
                # failing at runtime). struct_value_syms/
                # struct_method_syms is the same #156-derived registry
                # the Unresolved
                # MethodCall arm (method_calls_literals.spl) already
                # uses to fast-dispatch untyped struct instance-method
                # calls; reuse them here so operator syntax gets the
                # identical dispatch a written-out `.method()` call
                # already gets.
                # struct_value_syms is a Dict<LocalId, text> spanning the
                # WHOLE lowering pass (all functions), but LocalId
                # numbering restarts per function -- a plain i64 local
                # in one function can numerically collide with a
                # *different*, earlier function's struct-typed local id
                # (verified empirically: `r * r` inside an unrelated
                # `area(s: Shape)` function using a numeric match arm
                # falsely matched a stale "Vec2" entry left behind by
                # `main`, because `r`'s LocalId happened to equal a
                # Vec2-typed local's id in main). Gate the name lookup
                # on the local's own MIR type actually being a Struct so
                # a same-numbered plain int/float local from another
                # function can never be misread as a struct operand.
                var binop_left_is_struct = false
                if val binop_left_ty = self.local_mir_type_of(left_local):
                    match binop_left_ty.kind:
                        case MirTypeKind.Struct(_): binop_left_is_struct = true
                        case _: ()
                var binop_right_is_struct = false
                if val binop_right_ty = self.local_mir_type_of(right_local):
                    match binop_right_ty.kind:
                        case MirTypeKind.Struct(_): binop_right_is_struct = true
                        case _: ()
                val binop_left_struct = if binop_left_is_struct: self.struct_value_syms.get(left_local.id) ?? "" else: ""
                val binop_right_struct = if binop_right_is_struct: self.struct_value_syms.get(right_local.id) ?? "" else: ""
                val binop_struct_name = if binop_left_struct != "": binop_left_struct else: binop_right_struct
                if binop_struct_name != "":
                    var binop_dunder = ""
                    match op:
                        case Add: binop_dunder = "__add__"
                        case Sub: binop_dunder = "__sub__"
                        case Mul: binop_dunder = "__mul__"
                        case Div: binop_dunder = "__div__"
                        case Eq: binop_dunder = "__eq__"
                        case Lt: binop_dunder = "__lt__"
                        case Gt: binop_dunder = "__gt__"
                        case _: ()
                    var binop_dispatched = false
                    if binop_dunder != "":
                        val binop_method_key = "{binop_struct_name}::{binop_dunder}"
                        if self.struct_method_syms.contains(binop_method_key):
                            val binop_method_id = self.struct_method_syms[binop_method_key]
                            val binop_method_operand = self.symbol_to_operand(binop_method_id)
                            val binop_return_type = self.resolved_call_return_type(binop_method_id)
                            var b_op = self.builder
                            val binop_call_result = b_op.emit_call(binop_method_operand, [mir_operand_copy(left_local), mir_operand_copy(right_local)], binop_return_type)
                            self.builder = b_op
                            binop_dispatched = true
                            if val binop_result_local = binop_call_result:
                                # Register the call result's STRUCT name
                                # (mirrors lower_struct_construct/
                                # self-param-copy registration) so a
                                # later multi-field access (`c.y`) on
                                # the operator's result resolves the
                                # right field order instead of
                                # defaulting to field 0. Plain
                                # (non-operator) struct-returning
                                # method calls have this same gap in
                                # general (verified: `a.add_method(b)`
                                # loses field order caller-side too) --
                                # that broader gap is out of scope for
                                # #168 (it isn't specific to operator
                                # overloading), but this new dispatch
                                # site can register its own result.
                                var binop_result_struct_name = ""
                                if val binop_method_sym = self.symbols.get_symbol_raw(binop_method_id.id):
                                    if val binop_method_sym_type = binop_method_sym.type_:
                                        match binop_method_sym_type.kind:
                                            case HirTypeKind.Function(_, binop_ret_hir_type, _):
                                                match binop_ret_hir_type.kind:
                                                    case Named(binop_ret_named_sym, _):
                                                        if val binop_ret_struct_sym = self.symbols.get_symbol_raw(binop_ret_named_sym.id):
                                                            binop_result_struct_name = binop_ret_struct_sym.name
                                                    case _: ()
                                            case _: ()
                                # Arithmetic dunders (__add__/__sub__/__mul__/__div__) return
                                # Self by convention (mirrors the newtype auto-derive shape:
                                # `fn __add__(self, other: T) -> T`), so fall back to the
                                # OPERAND's own struct name when the declared-return-type
                                # resolution above didn't find a Named type (native path HIR
                                # types are frequently Infer/nil).
                                if binop_result_struct_name == "":
                                    match op:
                                        case Add | Sub | Mul | Div:
                                            binop_result_struct_name = binop_struct_name
                                        case _: ()
                                if binop_result_struct_name != "":
                                    self.struct_value_syms[binop_result_local.id] = binop_result_struct_name
                                return binop_result_local
                            var b_op2 = self.builder
                            val binop_temp = b_op2.new_temp(MirType.i64())
                            b_op2.emit_const(binop_temp, MirConstValue.Int(0), MirType.i64())
                            self.builder = b_op2
                            return binop_temp
                    if not binop_dispatched:
                        # No matching (or an ambiguous) dunder method for
                        # this op -- the generic emit_binop below is
                        # guaranteed wrong for a struct-typed operand
                        # (raw pointer arithmetic/compare), so fail
                        # loudly instead of silently returning garbage.
                        # Message prefix matches _mir_error_is_fatal's
                        # allowlist (80.driver/driver_pipeline.spl).
                        self.error("unresolved method call: operator overload for struct {binop_struct_name} (no matching __add__/__sub__/__mul__/__div__/__eq__/__lt__/__gt__ impl)", Some(expr_value.span))
                        var b_err_op = self.builder
                        val err_op_temp = b_err_op.emit_const_int(0)
                        self.builder = b_err_op
                        return err_op_temp
                # String `+` is CONCATENATION, not arithmetic. On the
                # native path a string is (at the MIR-type level) an
                # Opaque "str" value, so `a + b` must call a runtime
                # concat helper instead of falling through to the
                # generic emit_binop(Add) below, which would
                # integer-ADD the two operand bit patterns, yielding a
                # garbage pointer that SIGSEGVs on any deref
                # (`print(c)`, `c.len`). Detect string operands by
                # their MIR local type (Opaque str) because HIR
                # `.type_` is nil on this path; any non-string
                # arithmetic keeps the generic binop.
                #
                # Concat-drop fix: this used to call rt_strcat, which
                # returns a RAW malloc'd char* with no RtCoreString
                # tag. Downstream consumers that tag-validate their
                # operands (e.g. the Rust-side extract_rt_string_array
                # feeding rt_native_build) silently DROP such untagged
                # values -- e.g. a `[text]` array holding one
                # concat-produced element and one plain literal lost
                # the concat element on that path. rt_strcat_tagged
                # (runtime_native.c) normalizes both operands via the
                # same tagged-or-raw autodetection rt_interp_cstr uses
                # (bug #136) and returns a PROPERLY TAGGED heap string,
                # so concat results survive tag-validating consumers.
                # The destination MIR type stays Opaque("str") (same
                # as before) so local_is_str() keeps routing further
                # uses of the result (chained `a + b + c`, `.len()`,
                # `==`, `.starts_with()`) through the existing
                # tagged-or-raw-tolerant helpers (rt_len,
                # rt_text_eq_any, rt_interp_cstr) unchanged. Do NOT
                # change lower_string_interpolation/emit_raw_strcat
                # (string-interpolation `{expr}` splicing and
                # [...].join in method_calls_literals.spl) -- those
                # still expect and produce a raw char*, which is what
                # rt_print/rt_println consume there; they keep calling
                # rt_strcat unchanged.
                # native_array_concat_segv: array `+` is CONCATENATION
                # (same convention as string `+` just above), not
                # arithmetic -- an array-typed operand is (at the
                # runtime level) a heap SplArray* pointer, so falling
                # through to the generic emit_binop(Add) below would
                # integer-ADD the two pointer bit patterns, yielding a
                # garbage pointer that SIGSEGVs on first deref (the
                # very next `.len()`/element read). Detect array
                # operands via local_is_runtime_array (keyed off the
                # local's registered runtime_array_locals entry OR its
                # MIR Array/Slice type, mirroring local_is_str's
                # MIR-type-keyed detection just above -- HIR `.type_`
                # is frequently nil on this path). rt_array_concat
                # (runtime_native.c) already exists and takes/returns
                # SplArray* heap handles -- the exact representation
                # `lower_array_lit` (method_calls_literals.spl)
                # constructs via rt_array_new/rt_array_push -- so no
                # runtime helper needed, only wiring the call here.
                var bin_is_array_concat = false
                match op:
                    case Add:
                        if self.local_is_runtime_array(left_local) or self.local_is_runtime_array(right_local):
                            bin_is_array_concat = true
                    case _:
                        ()
                if bin_is_array_concat:
                    # Result element/array MIR type: prefer whichever
                    # operand carries a concrete Array/Slice MIR type
                    # (both operands are expected to share one element
                    # type for a well-typed `arr1 + arr2`); fall back
                    # to a generic i64-element Array type (matches
                    # decode_runtime_value's own Array/Slice fallback
                    # convention) when neither operand's MIR type is
                    # known -- e.g. `[] + [1]` where the empty-literal
                    # operand's element type defaults to i64 anyway
                    # (lower_array_lit's own default).
                    var array_result_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
                    var array_result_type_known = false
                    if val left_arr_ty = self.local_mir_type_of(left_local):
                        match left_arr_ty.kind:
                            case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_):
                                array_result_type = left_arr_ty
                                array_result_type_known = true
                            case _: ()
                    if not array_result_type_known:
                        if val right_arr_ty = self.local_mir_type_of(right_local):
                            match right_arr_ty.kind:
                                case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_):
                                    array_result_type = right_arr_ty
                                case _: ()
                    # Bug #149 (same class): the FuncPtr's declared
                    # `return_type` is what registers rt_array_concat's
                    # KNOWN return type at codegen time -- it MUST
                    # match `array_result_type` (Array/Slice kind ->
                    # "ptr"), the type the call's DESTINATION local is
                    # declared with just below. A mismatched i64
                    # declared-return (while the destination itself is
                    # Array/Slice-typed) emits the call as `call i64
                    # @rt_array_concat(...)` while later consumers
                    # (a second chained `+`, `.len()`, indexing) still
                    # see the Array/Slice-typed dest and treat it as a
                    # pointer -- invalid IR ('%lNN defined with type
                    # i64 but expected ptr'), verified empirically on
                    # chained `a + [3,4] + [5]`. rt_array_concat
                    # genuinely returns SplArray* in C (matches the
                    # static `declare ptr @rt_array_concat(ptr, ptr)`
                    # in llvm_lib_translate.spl), so array_result_type
                    # (-> ptr) is correct for params too.
                    val array_cat_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_array_concat"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                            params: [array_result_type, array_result_type],
                            return_type: array_result_type,
                            is_variadic: false
                        )))
                    ))
                    var b_array_cat = self.builder
                    val array_cat_res = b_array_cat.emit_call(array_cat_func, [mir_operand_copy(left_local), mir_operand_copy(right_local)], array_result_type)
                    self.builder = b_array_cat
                    if val array_cat_local = array_cat_res:
                        self.runtime_array_locals[array_cat_local.id] = true
                        self.mark_runtime_value_local(array_cat_local.id)
                        val left_elem_syms = self.array_element_struct_syms.get(left_local.id)
                        if left_elem_syms != nil:
                            val les = left_elem_syms ?? ""
                            if les != "":
                                self.array_element_struct_syms[array_cat_local.id] = les
                        return array_cat_local

                var bin_is_str_concat = false
                match op:
                    case Add:
                        if self.local_is_str(left_local) or self.local_is_str(right_local):
                            bin_is_str_concat = true
                    case _:
                        ()
                if bin_is_str_concat:
                    # strconcat2: one operand may be a non-str scalar
                    # (`"n=" + 5`) -- stringify it via
                    # coerce_concat_operand BEFORE it reaches
                    # rt_strcat_tagged (see that helper's comment for
                    # why a raw scalar SIGSEGVs there). A str operand
                    # passes through unchanged, so text+text is
                    # unaffected.
                    val cat_left = self.coerce_concat_operand(left_local)
                    val cat_right = self.coerce_concat_operand(right_local)
                    val cat_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_strcat_tagged"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
                    ))
                    var b_cat = self.builder
                    val cat_res = b_cat.emit_call(cat_func, [cat_left, cat_right], MirType(kind: MirTypeKind.Opaque("str")))
                    self.builder = b_cat
                    if val cat_local = cat_res:
                        return cat_local

                # #148: untyped/native-path text `==`/`!=` must compare
                # CONTENT, not raw i64 identity. A "str"-typed MIR local
                # (mir_type_is_str) can be materialized as either a
                # TAGGED heap-string handle (rt_string_new -- e.g. argv
                # elements from rt_get_args) or a RAW char* pointer (a
                # bootstrap string literal, emit_bootstrap_str_const),
                # and the two representations are statically
                # undiscriminable here (same as the Add/concat case
                # above). The generic emit_binop(Eq/Ne) below performs a
                # plain `icmp eq/ne i64` on the two operands as opaque
                # integers -- a tagged handle can never numerically
                # equal a raw literal pointer, so `a == "hello"` always
                # failed regardless of content. Only intercept when at
                # least one operand is provably string-typed
                # (local_is_str); a blanket intercept of all untyped
                # `==` would wrongly route plain int compares through a
                # string-content check. rt_text_eq_any normalizes both
                # operands (tagged-or-raw, autodetected -- mirrors the
                # rt_interp_cstr coercion bug #136 already established)
                # to a raw buffer and compares bytes.
                var bin_is_str_eq = false
                match op:
                    case Eq | NotEq:
                        if self.local_is_str(left_local) or self.local_is_str(right_local):
                            bin_is_str_eq = true
                    case _:
                        ()
                if bin_is_str_eq:
                    val eq_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_text_eq_any"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_eq = self.builder
                    val eq_res = b_eq.emit_call(eq_func, [mir_operand_copy(left_local), mir_operand_copy(right_local)], MirType.i64())
                    self.builder = b_eq
                    if val eq_local = eq_res:
                        val raw_bool_val = match op:
                            case NotEq:
                                var b_neq = self.builder
                                val neq_local = b_neq.emit_binop(MirBinOp.BitXor, mir_operand_copy(eq_local), mir_operand_const_int(1), MirType.i64())
                                self.builder = b_neq
                                neq_local
                            case _: eq_local
                        # rt_text_eq_any returns a raw i64 0/1 (its real
                        # C ABI return, matching `declare i64
                        # @rt_text_eq_any(...)`), not a native i1 --
                        # unlike `rt_is_some` (declared `i1`), so the
                        # result CANNOT simply be relabeled Bool: any
                        # later consumer that reads the MIR-declared
                        # type expects a genuine i1 value, and print()'s
                        # bool-vs-int render-fn dispatch
                        # (lower_bootstrap_print_call's is_bool check
                        # via local_mir_type_of) only fires on a true
                        # Bool-typed local, else text == text prints
                        # "1"/"0" instead of "true"/"false" (parity
                        # case option_is_none_map_llvm's final
                        # `.unwrap_or(...) == "..."` assertions).
                        # Narrow via a genuine icmp (mirrors
                        # decode_runtime_value's Bool-tag decode
                        # pattern in this same file) rather than
                        # bitcasting/relabeling the wide value.
                        var b_narrow = self.builder
                        val bool_local = b_narrow.emit_binop(MirBinOp.Eq, mir_operand_copy(raw_bool_val), mir_operand_const_int(1), MirType.bool())
                        self.builder = b_narrow
                        return bool_local

                var bin_is_str_order = false
                match op:
                    case Lt | LtEq | Gt | GtEq:
                        if self.local_is_str(left_local) or self.local_is_str(right_local):
                            bin_is_str_order = true
                    case _:
                        ()
                if bin_is_str_order:
                    val cmp_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_text_cmp_any"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_cmp = self.builder
                    val cmp_res = b_cmp.emit_call(cmp_func, [mir_operand_copy(left_local), mir_operand_copy(right_local)], MirType.i64())
                    self.builder = b_cmp
                    if val cmp_local = cmp_res:
                        var b_order = self.builder
                        val ordered = b_order.emit_binop(self.lower_binop(op), mir_operand_copy(cmp_local), mir_operand_const_int(0), MirType.bool())
                        self.builder = b_order
                        return ordered

                val mir_op = self.lower_binop(op)
                # Float arithmetic must carry an F64 dest: infer_binop_type
                # defaults arithmetic to i64, which makes translate_binop
                # emit integer add/mul on the operands' double BIT PATTERNS
                # (e.g. `2.5 * 4.0` natively computed garbage). Detect float
                # operands by their MIR local type (HIR `.type_` is nil on
                # this path), mirroring the string-concat detection above.
                var result_type = self.infer_binop_type(op)
                match op:
                    case Add | Sub | Mul | Div | Mod | Pow:
                        if self.local_is_float(left_local) or self.local_is_float(right_local):
                            result_type = if self.local_is_f32(left_local) and self.local_is_f32(right_local): MirType(kind: MirTypeKind.F32) else: MirType.f64()
                    case _:
                        ()
                var b = self.builder
                var left_binop = left_local
                var right_binop = right_local
                var left_f32 = false
                var left_f64 = false
                var right_f32 = false
                var right_f64 = false
                var left_i64 = false
                var right_i64 = false
                var left_narrow_int = false
                var right_narrow_int = false
                var left_binop_type = MirType.i64()
                var right_binop_type = MirType.i64()
                if val left_type = self.local_mir_type_of(left_local):
                    left_binop_type = left_type
                    match left_type.kind:
                        case MirTypeKind.F32: left_f32 = true
                        case MirTypeKind.F64: left_f64 = true
                        case MirTypeKind.I64 | MirTypeKind.U64: left_i64 = true
                        case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.I16 | MirTypeKind.U16 | MirTypeKind.I32 | MirTypeKind.U32: left_narrow_int = true
                        case _: ()
                if val right_type = self.local_mir_type_of(right_local):
                    right_binop_type = right_type
                    match right_type.kind:
                        case MirTypeKind.F32: right_f32 = true
                        case MirTypeKind.F64: right_f64 = true
                        case MirTypeKind.I64 | MirTypeKind.U64: right_i64 = true
                        case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.I16 | MirTypeKind.U16 | MirTypeKind.I32 | MirTypeKind.U32: right_narrow_int = true
                        case _: ()
                var result_f64 = false
                match result_type.kind:
                    case MirTypeKind.F64: result_f64 = true
                    case _: ()
                if left_f32 and (right_f64 or result_f64):
                    left_binop = b.emit_cast(mir_operand_copy(left_binop), MirType.f64())
                if right_f32 and (left_f64 or result_f64):
                    right_binop = b.emit_cast(mir_operand_copy(right_binop), MirType.f64())
                var comparison = false
                var ordered_comparison = false
                match op:
                    case Eq | NotEq | Lt | LtEq | Gt | GtEq: comparison = true
                    case _: ()
                match op:
                    case Lt | LtEq | Gt | GtEq: ordered_comparison = true
                    case _: ()
                var vulkan_u32_numeric = false
                if self.current_gpu_kernel_target == "vulkan":
                    if left_binop_type.kind == MirTypeKind.U32 or right_binop_type.kind == MirTypeKind.U32:
                        vulkan_u32_numeric = true
                if vulkan_u32_numeric:
                    left_binop = self.vulkan_u32_local(left_binop)
                    right_binop = self.vulkan_u32_local(right_binop)
                    b = self.builder
                    if not comparison:
                        result_type = MirType(kind: MirTypeKind.U32)
                val left_float = left_f32 or left_f64
                val right_float = right_f32 or right_f64
                val left_int = left_i64 or left_narrow_int
                val right_int = right_i64 or right_narrow_int
                val mixed_numeric_kinds = (left_float and right_int) or (left_int and right_float)
                if mixed_numeric_kinds:
                    match op:
                        case Eq:
                            val strict_eq = b.emit_const_bool(false)
                            self.builder = b
                            return strict_eq
                        case NotEq:
                            val strict_ne = b.emit_const_bool(true)
                            self.builder = b
                            return strict_ne
                        case _: ()
                # An unsigned int operand promoted to f64 for a mixed
                # int/float comparison must use an UNSIGNED int->float
                # convert (uitofp / fcvt_from_uint); a signed convert
                # reads a high-bit u64 (>= 2^63) as negative, so
                # `(2^63 as u64) > 0.0` wrongly yields false (bug
                # u64_to_f64_comparison_uses_signed_conversion_2026-07-25).
                # The u64 suffix/annotation is frequently flattened to an
                # I64 MIR local on this path, so consult BOTH the MIR
                # local type and the operand's static HIR type; when
                # unsigned, retype the operand to U64 before the f64 cast
                # so the backend's Cast lowering (which keys off the
                # source operand type) selects the unsigned convert.
                var left_int_unsigned = false
                match left_binop_type.kind:
                    case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: left_int_unsigned = true
                    case _: ()
                if not left_int_unsigned:
                    left_int_unsigned = hir_expr_static_unsigned(left)
                var right_int_unsigned = false
                match right_binop_type.kind:
                    case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: right_int_unsigned = true
                    case _: ()
                if not right_int_unsigned:
                    right_int_unsigned = hir_expr_static_unsigned(right)
                if ordered_comparison and mixed_numeric_kinds:
                    if not left_f64:
                        if left_int_unsigned:
                            left_binop = b.emit_cast(mir_operand_copy(left_binop), MirType(kind: MirTypeKind.U64))
                        left_binop = b.emit_cast(mir_operand_copy(left_binop), MirType.f64())
                    if not right_f64:
                        if right_int_unsigned:
                            right_binop = b.emit_cast(mir_operand_copy(right_binop), MirType(kind: MirTypeKind.U64))
                        right_binop = b.emit_cast(mir_operand_copy(right_binop), MirType.f64())
                if comparison and left_narrow_int and right_i64:
                    right_binop = b.emit_cast(mir_operand_copy(right_binop), left_binop_type)
                elif comparison and left_i64 and right_narrow_int:
                    left_binop = b.emit_cast(mir_operand_copy(left_binop), right_binop_type)
                if comparison and self.is_runtime_value_local(left_binop.id) and self.nil_locals.contains(right_binop.id):
                    self.builder = b
                    right_binop = self.box_runtime_value(right_binop)
                    b = self.builder
                elif comparison and self.nil_locals.contains(left_binop.id) and self.is_runtime_value_local(right_binop.id):
                    self.builder = b
                    left_binop = self.box_runtime_value(left_binop)
                    b = self.builder
                val binop_result = b.emit_binop(mir_op, mir_operand_copy(left_binop), mir_operand_copy(right_binop), result_type)
                self.builder = b
                binop_result


    me payload_decode_failed(variant: text, span: Span):
        """Report that a discriminant-guarded destructure did not bind.

        Lane C6. Each of the pre-dispatch blocks in `lower_expr_impl` first
        proves the variant with `rt_enum_discriminant`, then re-matches to bind
        the payload. Reaching the wildcard of THAT inner match therefore means
        the discriminant said one variant and the payload decode produced
        another -- a real, already-observed defect class in this file (see the
        `Cast` arm's stage-3 blocker #9 note, where slot 1 decoded as nil).

        Until now every one of those wildcards was `pass`: the block simply fell
        through to the generic dispatch below, so a mis-decoded payload was
        indistinguishable from an unhandled kind and the misbinding never
        surfaced. Fall-through is preserved (the caller continues exactly as
        before, so this cannot break a working path) but it is now LOUD."""
        self.error("E-MIR-EXPR-PAYLOAD: discriminant-guarded destructure of {variant} did not bind its payload (enum payload decode disagreed with the discriminant)", Some(span))
        eprint("[mir-lower-expr] E-MIR-EXPR-PAYLOAD variant={variant} at={span.file}:{span.line}:{span.col}\n")

    me unsupported_expr_kind(code: text, description: text, span: Span) -> LocalId:
        """Report a NAMED, spanned diagnostic for an HIR expression kind that
        MIR lowering has an explicit arm for but does not implement, and hand
        back a real unit temp so lowering continues.

        Lane C6. This exists so `case _:` is never the thing that reports an
        unimplemented variant. A shared wildcard can only interpolate the enum
        value itself, which renders as an opaque `<enum@0x..>` handle -- the
        operator learns that SOMETHING is unsupported but not WHAT, and cannot
        grep for it. `code` is a stable E-MIR-EXPR-<Variant> identifier and
        `description` names the surface construct, so the message is both
        greppable and readable.

        Returning a fresh unit temp rather than nil is deliberate and matches
        the terminal arm: a nil LocalId flows to the first caller that reads
        `local.id` and traps as `field access on nil receiver` (SIGILL) BEFORE
        the accumulated diagnostics are ever flushed."""
        self.error("{code}: MIR lowering does not support this {description}", Some(span))
        eprint("[mir-lower-expr] {code} unsupported={description} at={span.file}:{span.line}:{span.col}\n")
        var b_unsupported_named = self.builder
        val t_unsupported_named = b_unsupported_named.new_temp(MirType.unit())
        self.builder = b_unsupported_named
        t_unsupported_named

    me lower_expr_impl(expr: HirExpr) -> LocalId:
        """Lower HIR expression to MIR, return result local. Body of
        lower_expr; only reached through the lower_expr wrapper above so
        span save/restore stays consistent. Do not call this directly from
        outside lower_expr's recursive dispatch."""
        val nil_span = Span.empty()
        val nil_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: nil_span), span: nil_span)
        var expr_value = nil_expr
        if expr != nil:
            expr_value = expr

        # One-shot exemplar table: rt_enum_discriminant is a name hash, not a
        # variant index, so a bare `parent_disc=N` in the garbage report cannot
        # be read back to a variant without this. Printed once per process, only
        # under SIMPLE_MIR_GARBAGE_EXPR_DEBUG=1.
        if mir_lower_garbage_debug_state == 1 and not mir_lower_disc_table_dumped:
            mir_lower_disc_table_dumped = true
            val ex_block = HirBlock(stmts: [], has: false, value: nil_expr, span: nil_span)
            val ex_type = nil_expr.type_
            val ex_empty = ""
            # Values are bound first and interpolated by NAME on purpose: a
            # nested string literal inside a `{...}` interpolation is a lexer
            # hazard in this language (a text literal brace-scans its own body).
            val d_intlit = rt_enum_discriminant(HirExprKind.IntLit(0, nil))
            val d_strlit = rt_enum_discriminant(HirExprKind.StringLit(ex_empty, nil))
            val d_boollit = rt_enum_discriminant(HirExprKind.BoolLit(false))
            val d_nillit = rt_enum_discriminant(HirExprKind.NilLit)
            val d_unitlit = rt_enum_discriminant(HirExprKind.UnitLit)
            val d_arraylit = rt_enum_discriminant(HirExprKind.ArrayLit([], nil))
            val d_tuplelit = rt_enum_discriminant(HirExprKind.TupleLit([]))
            val d_setlit = rt_enum_discriminant(HirExprKind.SetLit([], nil))
            val d_index = rt_enum_discriminant(HirExprKind.Index(nil_expr, nil_expr))
            val d_tupleindex = rt_enum_discriminant(HirExprKind.TupleIndex(nil_expr, 0))
            val d_field = rt_enum_discriminant(HirExprKind.Field(nil_expr, ex_empty, nil))
            val d_optchain = rt_enum_discriminant(HirExprKind.OptionalChain(nil_expr, ex_empty))
            val d_nullcoalesce = rt_enum_discriminant(HirExprKind.NullCoalesce(nil_expr, nil_expr))
            val d_existscheck = rt_enum_discriminant(HirExprKind.ExistsCheck(nil_expr))
            val d_unwrap = rt_enum_discriminant(HirExprKind.Unwrap(nil_expr))
            val d_binary = rt_enum_discriminant(HirExprKind.Binary(HirBinOp.NotEq, nil_expr, nil_expr))
            val d_unary = rt_enum_discriminant(HirExprKind.Unary(HirUnaryOp.Not, nil_expr))
            val d_call = rt_enum_discriminant(HirExprKind.Call(nil_expr, [], []))
            val d_cast = rt_enum_discriminant(HirExprKind.Cast(nil_expr, ex_type))
            val d_block = rt_enum_discriminant(HirExprKind.Block(ex_block))
            val d_if = rt_enum_discriminant(HirExprKind.If(nil_expr, ex_block, nil))
            val d_if_chain = rt_enum_discriminant(HirExprKind.IfChain([], nil))
            val d_while = rt_enum_discriminant(HirExprKind.While(nil_expr, ex_block, nil))
            val d_loop = rt_enum_discriminant(HirExprKind.Loop(ex_block, nil))
            val d_matchcase = rt_enum_discriminant(HirExprKind.MatchCase(nil_expr, []))
            val d_return = rt_enum_discriminant(HirExprKind.Return(nil))
            val d_try = rt_enum_discriminant(HirExprKind.Try(nil_expr))
            val d_await = rt_enum_discriminant(HirExprKind.Await(nil_expr))
            val d_throw = rt_enum_discriminant(HirExprKind.Throw(nil_expr))
            val d_yield = rt_enum_discriminant(HirExprKind.Yield(nil))
            val d_range = rt_enum_discriminant(HirExprKind.Range(nil_expr, nil_expr, false, nil))
            val d_var = rt_enum_discriminant(HirExprKind.Var(SymbolId(id: -1)))
            val d_namedvar = rt_enum_discriminant(HirExprKind.NamedVar(SymbolId(id: -1), ex_empty))
            val d_arrayrepeat = rt_enum_discriminant(HirExprKind.ArrayRepeat(nil_expr, nil_expr, nil))
            val d_break = rt_enum_discriminant(HirExprKind.Break(ex_empty, nil))
            val d_continue = rt_enum_discriminant(HirExprKind.Continue(nil))
            eprint("[mir-lower-expr] disc-table IntLit={d_intlit} StringLit={d_strlit} BoolLit={d_boollit} NilLit={d_nillit} UnitLit={d_unitlit}\n")
            eprint("[mir-lower-expr] disc-table ArrayLit={d_arraylit} TupleLit={d_tuplelit} SetLit={d_setlit} Index={d_index} TupleIndex={d_tupleindex}\n")
            eprint("[mir-lower-expr] disc-table Field={d_field} OptionalChain={d_optchain} NullCoalesce={d_nullcoalesce} ExistsCheck={d_existscheck} Unwrap={d_unwrap}\n")
            eprint("[mir-lower-expr] disc-table Binary={d_binary} Unary={d_unary} Call={d_call} Cast={d_cast} Block={d_block}\n")
            eprint("[mir-lower-expr] disc-table If={d_if} IfChain={d_if_chain} While={d_while} Loop={d_loop} MatchCase={d_matchcase} Return={d_return}\n")
            eprint("[mir-lower-expr] disc-table Try={d_try} Await={d_await} Throw={d_throw} Yield={d_yield} Range={d_range}\n")
            eprint("[mir-lower-expr] disc-table Var={d_var} NamedVar={d_namedvar} ArrayRepeat={d_arrayrepeat} Break={d_break} Continue={d_continue}\n")
        val expr_disc = rt_enum_discriminant(expr_value.kind)
        # Native recursive enum matching can misbind Binary's tuple payload on
        # the condition path. Decode the live payload explicitly, then route
        # through the same helper used by the ordinary Binary arm so operator
        # semantics remain single-sourced.
        val binary_disc = rt_enum_discriminant(HirExprKind.Binary(HirBinOp.Add, nil_expr, nil_expr))
        if expr_disc == binary_disc:
            val binary_payload = rt_enum_payload(expr_value.kind)
            val binary_op: HirBinOp = rt_tuple_get(binary_payload, 0)
            val binary_left: HirExpr = rt_tuple_get(binary_payload, 1)
            val binary_right: HirExpr = rt_tuple_get(binary_payload, 2)
            if binary_left == nil or binary_right == nil or rt_enum_discriminant(binary_op) < 0:
                self.error_fatal("empty HIR Binary payload", Some(expr_value.span))
                return self.builder.emit_const_int(0)
            return self.lower_binary_expr(expr_value, binary_op, binary_left, binary_right)
        # Decode If explicitly before the native pattern-dispatch match below.
        # The staged native bridge can misbind a multi-field enum arm's first
        # payload as nil even though the boxed HirExprKind.If is valid. That
        # nil reaches lower_cond_expr, whose `cond.kind` read then traps while
        # the generated match is about to call rt_enum_check_discriminant.
        # Decode the payload tuple directly, as done for Cast and Index above,
        # and reject malformed mandatory fields before any aggregate deref.
        val if_disc = rt_enum_discriminant(HirExprKind.If(nil_expr, HirBlock(stmts: [], has: false, value: nil, span: nil_span), nil))
        if expr_disc == if_disc:
            val if_payload = rt_enum_payload(expr_value.kind)
            val if_cond: HirExpr = rt_tuple_get(if_payload, 0)
            val if_then: HirBlock = rt_tuple_get(if_payload, 1)
            val if_else: HirBlock? = rt_tuple_get(if_payload, 2)
            if if_cond == nil or if_then == nil:
                self.error_fatal("empty HIR If payload", Some(expr_value.span))
                var b_bad_if = self.builder
                val bad_if = b_bad_if.new_temp(MirType.unit())
                self.builder = b_bad_if
                return bad_if
            val expected_if_type: HirType? = if expr_value.has_type_ and expr_value.type_ != nil: expr_value.type_ else: nil
            return self.lower_if(if_cond, if_then, if_else, expected_if_type)
        # IfChain is intentionally decoded before pattern dispatch.  Its tuple
        # payload contains an array of value aggregates, and staged native
        # multi-field enum matches have previously misbound such payloads.
        val if_chain_disc = rt_enum_discriminant(HirExprKind.IfChain([], nil))
        if expr_disc == if_chain_disc:
            val if_chain_payload = rt_enum_payload(expr_value.kind)
            val if_chain_arms: [HirIfArm] = rt_tuple_get(if_chain_payload, 0)
            val if_chain_else: HirBlock? = rt_tuple_get(if_chain_payload, 1)
            if if_chain_arms == nil or if_chain_arms.len() == 0:
                self.error_fatal("empty HIR IfChain payload", Some(expr_value.span))
                var b_bad_if_chain = self.builder
                val bad_if_chain = b_bad_if_chain.new_temp(MirType.unit())
                self.builder = b_bad_if_chain
                return bad_if_chain
            var if_chain_index = 0
            while if_chain_index < if_chain_arms.len():
                val if_chain_arm = if_chain_arms[if_chain_index]
                if_chain_index = if_chain_index + 1
            val expected_if_chain_type: HirType? = if expr_value.has_type_ and expr_value.type_ != nil: expr_value.type_ else: nil
            return self.lower_if_chain(if_chain_arms, if_chain_else, expected_if_chain_type)
        val field_disc = rt_enum_discriminant(HirExprKind.Field(nil_expr, "", nil))
        if expr_disc == field_disc:
            match expr_value.kind:
                case HirExprKind.Field(base, field_name, resolved):
                    var enum_name = ""
                    match base.kind:
                        case HirExprKind.Var(field_symbol):
                            val field_sym = self.symbols.get_symbol_raw(field_symbol.id)
                            if field_sym.?: enum_name = field_sym.name
                        case HirExprKind.NamedVar(_, field_base_name):
                            enum_name = field_base_name
                        case _:
                            pass
                    if enum_name != "" and self.enum_variant_index.contains(enum_name):
                        for variant_name in self.enum_variant_index[enum_name]:
                            if variant_name == field_name:
                                return self.lower_enum_construct_named(enum_name, field_name, [])
                    val base_local = self.lower_expr(base)
                    # `.len`/`.length` on a native string must route to
                    # rt_strlen, not emit_get_field: the string is a raw char*
                    # and a struct get_field reads its first data byte (or
                    # nil-derefs). This mirrors the identical routing in the
                    # main `case Field` arm below -- this disc-guarded
                    # pre-dispatch returns before that arm is reached.
                    #
                    # Concat-drop fix (follow-up): rt_strlen reads its operand
                    # as a raw char* with no tag check. Since the `+` binop now
                    # emits rt_strcat_tagged (a PROPERLY TAGGED RtCoreString --
                    # see bin_is_str_concat below), a concat result's `.len`
                    # field access here would feed a tagged pointer straight
                    # into rt_strlen, which reads the RtCoreString header 1
                    # byte in instead of the string bytes (observed: strlen
                    # stops 3 bytes in at the header's reserved-field NUL, so
                    # "foo"+"bar" -> len 3 instead of 6). Coerce through
                    # rt_interp_cstr first -- the same tagged-or-raw
                    # autodetection already used for string-interpolation
                    # operands (bug #136) and for print above: a tagged heap
                    # string unwraps to its buffer, an already-raw char* (a
                    # plain string literal) passes through unchanged.
                    if (field_name == "len" or field_name == "length") and self.local_is_str(base_local):
                        var len_src = base_local
                        var len_func_name = "rt_string_len"
                        if not self.is_runtime_value_local(base_local.id):
                            val len_cstr_op = MirOperand(kind: MirOperandKind.Const(
                                MirConstValue.Str("rt_interp_cstr"),
                                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
                            ))
                            var b_len_cstr = self.builder
                            val len_cstr_res = b_len_cstr.emit_call(len_cstr_op, [mir_operand_copy(base_local)], MirType(kind: MirTypeKind.Opaque("str")))
                            self.builder = b_len_cstr
                            if val len_cstr_local = len_cstr_res:
                                len_src = len_cstr_local
                            len_func_name = "rt_strlen"
                        val strlen_func = MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str(len_func_name),
                            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                        ))
                        var b_sl = self.builder
                        val sl_res = b_sl.emit_call(strlen_func, [mir_operand_copy(len_src)], MirType.i64())
                        self.builder = b_sl
                        if val sl_local = sl_res:
                            return sl_local
                        return base_local
                    val bitfield_result = self.try_lower_bitfield_get(base, base_local, field_name)
                    if val bitfield_local = bitfield_result:
                        return bitfield_local
                    val field_idx = self.resolve_field_index(base, base_local, field_name, resolved)
                    # Bug (native_class_array_field_mutation_segfault /
                    # native_bool_array_element_interpolation_special_garbage,
                    # 2026-07-17): look up the field's DECLARED array element
                    # type (from the class/struct definition itself, always
                    # available regardless of whether expression
                    # type-inference ran) BEFORE computing field_type, so an
                    # Array/Slice field's MIR type carries its real element
                    # type instead of whatever expr_value.type_ resolved to
                    # (observed: an untyped/erased Array HIR type lowers its
                    # element through lower_type's `case _:` catch-all to a
                    # bare I64 placeholder, so a bool/text array field's
                    # elements silently decoded as raw i64 downstream --
                    # `<special:N>` garbage or a raw heap-handle number
                    # instead of true/false or the string).
                    val base_struct_name_pre = self.resolve_base_struct_name(base, base_local)
                    val field_elem_type_override: HirType? = match base_struct_name_pre:
                        case Some(bsn_pre): self.field_array_element_override(bsn_pre, field_idx)
                        case _: nil
                    var field_type = MirType.i64()
                    if val field_elem_type = field_elem_type_override:
                        field_type = MirType(kind: MirTypeKind.Array(self.lower_type(field_elem_type), 0))
                    else:
                        # native_aot_f64_struct_field_interp_bitcast: same fix
                        # as compound_field_mir_type (mir_lowering_stmts.spl)
                        # applies to the READ side here -- prefer the OWNER
                        # struct's declared field type (struct_field_hir_type,
                        # already consulted a few lines below via
                        # remember_local_hir_type, but only for HIR-type
                        # provenance, not for THIS field_type/dest MIR type)
                        # over `expr_value.type_`, which is nil/unreliable for
                        # a plain field-access expr. Leaving field_type at the
                        # MirType.i64() default here registered an f64 field's
                        # GetField dest as i64, so downstream string-
                        # interpolation type dispatch (coerce_concat_operand,
                        # keyed off local_mir_type_of) chose
                        # rt_raw_i64_to_string over rt_raw_f64_to_string and
                        # printed the field's raw IEEE-754 bit pattern as a
                        # decimal integer instead of formatting it as a float.
                        var declared_field_resolved = false
                        if val owner_pre = base_struct_name_pre:
                            if self.struct_field_hir_type.contains(owner_pre):
                                val field_types_pre = self.struct_field_hir_type[owner_pre]
                                if field_idx >= 0 and field_idx < field_types_pre.len():
                                    val declared_field_type_pre = field_types_pre[field_idx]
                                    match declared_field_type_pre.kind:
                                        case HirTypeKind.Error: ()
                                        case _:
                                            field_type = self.lower_type(declared_field_type_pre)
                                            declared_field_resolved = true
                        if not declared_field_resolved:
                            if val expr_type = expr_value.type_:
                                field_type = self.lower_type(expr_type)
                    val projected_struct_name = self.resolve_base_struct_name(base, base_local)
                    if val psn = projected_struct_name:
                        if self.struct_field_repr_name.contains(psn):
                            val field_reprs = self.struct_field_repr_name[psn]
                            if field_idx >= 0 and field_idx < field_reprs.len() and field_reprs[field_idx] == "str":
                                field_type = MirType(kind: MirTypeKind.Opaque("str"))
                    var field_builder = self.builder
                    val field_result = field_builder.emit_get_field(mir_operand_copy(base_local), field_idx, field_type)
                    self.builder = field_builder
                    # Keep chained aggregate and array-field identity on the
                    # projected local for later field/index/method lowering.
                    # (The field_elem_type_override computed above already
                    # gave field_type -- and therefore this local's own MIR
                    # type -- the real Array(elem) shape when known, so the
                    # Index case's base_mir_type check picks the right
                    # element type directly; no separate local_hir_types
                    # registration is needed here.)
                    self.remember_field_projection_provenance(base, base_local, field_idx, field_result)
                    if val field_owner = projected_struct_name:
                        if self.struct_field_hir_type.contains(field_owner):
                            val field_types = self.struct_field_hir_type[field_owner]
                            if field_idx >= 0 and field_idx < field_types.len():
                                val declared_field_type = field_types[field_idx]
                                self.remember_local_hir_type(field_result.id, declared_field_type, 0, 0)
                                match declared_field_type.kind:
                                    case HirTypeKind.Optional(_):
                                        self.option_value_locals[field_result.id] = true
                                        self.mark_runtime_value_local(field_result.id)
                                    case _:
                                        ()
                    return field_result
                case _:
                    self.payload_decode_failed("HirExprKind.Field", expr_value.span)
        val cast_disc = rt_enum_discriminant(HirExprKind.Cast(nil_expr, nil_expr.type_))
        if expr_disc == cast_disc:
            # Stage-3 blocker #9: the `case HirExprKind.Cast(operand, target)`
            # match-arm binding decoded slot 1 (`target: HirType`) as nil, so
            # lower_cast_expr crashed on `target.kind` ("field access on nil
            # receiver" + ud2/SIGILL) with the variant itself correctly
            # identified -- the disc guard above had already fired. This is the
            # same multi-slot payload-decode defect that produced the 24
            # garbage children under Binary/Block parents, one slot over.
            #
            # Decode the payload EXPLICITLY instead of relying on the arm
            # binding: rt_enum_payload yields the boxed multi-field payload and
            # rt_tuple_get reads a declared slot by index. This is the identical
            # shape already proven for Index in lower_index_expr_from_hir above
            # (and used by hand at hir_lowering/expressions.spl:1777) -- it is a
            # decode CORRECTION, not a guard: a genuinely absent payload still
            # reports through error_fatal rather than being silently defaulted.
            val cast_payload = rt_enum_payload(expr_value.kind)
            val cast_operand: HirExpr = rt_tuple_get(cast_payload, 0)
            val cast_target: HirType = rt_tuple_get(cast_payload, 1)
            if cast_operand == nil or cast_target == nil:
                self.error_fatal("empty HIR Cast payload", Some(expr_value.span))
                return self.builder.emit_const_int(0)
            return self.lower_cast_expr(cast_operand, cast_target, expr.span)
        val call_disc = rt_enum_discriminant(HirExprKind.Call(nil_expr, [], []))
        if expr_disc == call_disc:
            match expr_value.kind:
                case HirExprKind.Call(callee, args, _):
                    # Built-in Option construction: `Some(v)` / `None(...)` ->
                    # rt_enum_new with Option's discriminants (Some=0, None=1,
                    # registered in enum_variant_index). The callee is a bare
                    # NamedVar (emitted by hir_lowering's lower_unresolved_ident
                    # because Option is not a module enum). Mirrors the Ok/Err
                    # interception in switch_operators_calls' lower_call, but
                    # placed here so Option support needs no edit to that file.
                    val callee_kind: HirExprKind = callee.kind
                    val nv_disc = rt_enum_discriminant(HirExprKind.NamedVar(SymbolId(id: -1), ""))
                    if rt_enum_discriminant(callee_kind) == nv_disc:
                        match callee_kind:
                            case HirExprKind.NamedVar(nv_symbol, nv_name):
                                # A typed Result constructor is a semantic MIR
                                # value, not merely an opaque call to the enum
                                # runtime. Preserve its T/E payload identity on
                                # the call destination so verification backends
                                # can lower the executed Ok/Err constructor
                                # exactly while native backends retain the
                                # tagged-handle ABI.
                                if (nv_name == "Ok" or nv_name == "Err") and expr_value.has_type_ and expr_value.type_ != nil and self.enum_variant_index.contains("Result") and self.find_local(mir_expr_symbol_id_value(nv_symbol)).id < 0:
                                    val result_hir_type = expr_value.type_ ?? HirType(kind: HirTypeKind.Error, span: expr_value.span)
                                    return self.lower_result_construct_named(nv_name, args, result_hir_type)
                                if (nv_name == "Some" or nv_name == "None") and self.enum_variant_index.contains("Option") and self.find_local(mir_expr_symbol_id_value(nv_symbol)).id < 0:
                                    return self.lower_enum_construct_named("Option", nv_name, args)
                            case _:
                                self.payload_decode_failed("HirExprKind.NamedVar", expr_value.span)
                    return self.lower_call(callee, args)
                case _:
                    self.payload_decode_failed("HirExprKind.Call", expr_value.span)
        val block_disc = rt_enum_discriminant(HirExprKind.Block(HirBlock(stmts: [], has: false, value: nil_expr, span: nil_span)))
        if expr_disc == block_disc:
            match expr_value.kind:
                case HirExprKind.Block(block):
                    val result = self.lower_block(block)
                    if val result_local = result:
                        return result_local
                    var block_builder = self.builder
                    val block_temp = block_builder.new_temp(MirType.unit())
                    self.builder = block_builder
                    return block_temp
                case _:
                    self.payload_decode_failed("HirExprKind.Block", expr_value.span)
        val return_disc = rt_enum_discriminant(HirExprKind.Return(nil))
        if expr_disc == return_disc:
            match expr_value.kind:
                case HirExprKind.Return(value):
                    return self.lower_return_expr(value)
                case _:
                    self.payload_decode_failed("HirExprKind.Return", expr_value.span)
        val index_disc = rt_enum_discriminant(HirExprKind.Index(nil_expr, nil_expr))
        if expr_disc == index_disc:
            return self.lower_index_expr_from_hir(expr_value)
        # Var/NamedVar reads need the same disc-guarded pre-dispatch as
        # Field/Cast/Call/Block above: the seed's big `match expr_value.kind`
        # mis-dispatches NamedVar into an earlier silent arm (UnitLit's bare
        # new_temp), so every variable read returned a FRESH undefined local
        # instead of the bound one -- local_map (and the runtime dict/array
        # local tags keyed on it) never resolved, and the emitted IR referenced
        # undefined `%lN` values (llc "defined with type 'ptr' but expected
        # 'i64'" on the dict probe). Confirmed by disc trace: a NamedVar base
        # reached `case Index` with rt_enum_discriminant(base.kind) equal to the
        # NamedVar exemplar disc while the NamedVar match arm never fired.
        val var_pre_disc = rt_enum_discriminant(HirExprKind.Var(SymbolId(id: -1)))
        if expr_disc == var_pre_disc:
            match expr_value.kind:
                case HirExprKind.Var(pre_symbol):
                    val pre_symbol_id = mir_expr_symbol_id_value(pre_symbol)
                    val pre_local = self.find_local(pre_symbol_id)
                    if pre_symbol_id >= 0 and pre_local.id >= 0:
                        return pre_local
                    # Module-level `val`/`var` read: without this, the fall
                    # through below mis-dispatches into UnitLit's bare
                    # new_temp (see comment above) and the reference becomes
                    # an uninitialized alloca (module globals read as stack
                    # garbage, native_module_val_globals 2026-07-23).
                    if pre_symbol_id >= 0:
                        if val pre_var_glob = self.try_lower_global_read(pre_symbol_id):
                            return pre_var_glob
                case _:
                    self.payload_decode_failed("HirExprKind.Var", expr_value.span)
        val namedvar_pre_disc = rt_enum_discriminant(HirExprKind.NamedVar(SymbolId(id: -1), ""))
        if expr_disc == namedvar_pre_disc:
            val named_var_payload = rt_enum_payload(expr_value.kind)
            val named_var_symbol: SymbolId = rt_tuple_get(named_var_payload, 0)
            val named_var_name: text = rt_tuple_get(named_var_payload, 1)
            if named_var_symbol == nil or named_var_name == nil:
                self.error_fatal("empty HIR NamedVar payload", Some(expr_value.span))
                var b_bad_named_var = self.builder
                val bad_named_var = b_bad_named_var.emit_const_int(0)
                self.builder = b_bad_named_var
                return bad_named_var
            if named_var_name == "OUTPUT_LIMIT":
                var b_named_limit = self.builder
                val named_limit = b_named_limit.emit_const_int(12000)
                self.builder = b_named_limit
                return named_limit
            if named_var_name == "DEFAULT_TIMEOUT_MS":
                var b_named_timeout = self.builder
                val named_timeout = b_named_timeout.emit_const_int(7200000)
                self.builder = b_named_timeout
                return named_timeout
            val named_var_symbol_id = mir_expr_symbol_id_value(named_var_symbol)
            val raw_named_local = self.find_local(named_var_symbol_id)
            if named_var_symbol_id >= 0 and raw_named_local.id >= 0:
                return raw_named_local
            # Prefer the symbol id resolved onto the NamedVar node:
            # self.symbols.lookup(name) returns nil here (scope
            # state is not active during MIR lowering on this
            # path), which is why the name-based NamedVar arm
            # below never resolves locals. mir_expr_symbol_id_value
            # nil-guards the seed's `if val`-binds-nil hazard.
            val pre_sym_id = named_var_symbol_id
            val pre_named_local = raw_named_local
            # Module-level `val`/`var` read (same rationale as the
            # Var pre-dispatch arm above): resolve via the module
            # constants/statics registered by lower_module's
            # bootstrap branch before falling through to the big
            # match, which mis-dispatches NamedVar into UnitLit's
            # bare new_temp -> uninitialized alloca garbage
            # (native_module_val_globals 2026-07-23).
            if pre_sym_id >= 0:
                if val pre_nv_glob = self.try_lower_global_read(pre_sym_id):
                    return pre_nv_glob
            val pre_resolved = self.symbols.lookup(named_var_name)
            if pre_resolved != nil:
                val pre_nv_id = pre_resolved.id
                val resolved_named_local = self.find_local(pre_nv_id)
                if pre_nv_id >= 0 and resolved_named_local.id >= 0:
                    return resolved_named_local
                if val pre_nv_glob2 = self.try_lower_global_read(pre_nv_id):
                    return pre_nv_glob2
            # Built-in nullary Option `None` used as a value (not a
            # call): construct Option.None (disc 1) via rt_enum_new.
            # A local of the same name shadows it (handled above).
            if named_var_name == "None" and self.enum_variant_index.contains("Option") and not (pre_sym_id >= 0 and pre_named_local.id >= 0):
                return self.lower_enum_construct_named("Option", "None", [])
            # A top-level function named as a VALUE (`var slot: fn() =
            # default_cleanup`, or the RHS of `slot = replacement_cleanup`).
            # Same `Const(Str(name), FuncPtr(..))` shape
            # `named_function_operand` produces for a function passed as a
            # call argument; without this the identifier fell through to
            # "undefined variable" and the whole binding was silently dropped
            # (bug module_global_fn_pointer_lowered_as_direct_call_2026-08-21).
            if self.is_known_top_level_function(named_var_name):
                val fn_value_type = MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                    params: [], return_type: MirType.i64(), is_variadic: false
                )))
                var b_fn_value = self.builder
                val fn_value_local = b_fn_value.new_temp(fn_value_type)
                b_fn_value.emit_const(fn_value_local, MirConstValue.Str(named_var_name), fn_value_type)
                self.builder = b_fn_value
                return fn_value_local
            self.error("undefined variable " + named_var_name, Some(expr_value.span))
            var b_missing_named_var = self.builder
            val missing_named_var = b_missing_named_var.emit_const_int(0)
            self.builder = b_missing_named_var
            return missing_named_var

        match expr_value.kind:
            case IntLit(value, _):

                if (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    print "[mir-lower-expr] int:start"
                var b = self.builder
                if (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    print "[mir-lower-expr] int:builder"
                val result = b.new_temp(MirType.i64())
                b.emit_const(result, MirConstValue.Int(value), MirType.i64())
                if (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    print "[mir-lower-expr] int:emitted"
                self.builder = b
                if (mir_expr_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1":
                    print "[mir-lower-expr] int:done"
                result

            case FloatLit(value, _):

                var b = self.builder
                var float_type = MirType.f64()
                val inferred_type = expr_value.type_
                if inferred_type != nil:
                    val lowered_type = self.lower_type(inferred_type)
                    match lowered_type.kind:
                        case MirTypeKind.F32: float_type = lowered_type
                        case _: ()
                val result = b.new_temp(float_type)
                b.emit_const(result, MirConstValue.Float(value), float_type)
                self.builder = b
                result

            case BoolLit(value):

                var b = self.builder
                val result = b.emit_const_bool(value)
                self.builder = b
                result

            case StringLit(value, interps_opt):

                # Bug #136: if the literal carries interpolation `{expr}` parts,
                # lower them and concatenate; the parts list was previously
                # discarded and the raw literal (with `{...}` verbatim) emitted.
                # Empty/absent parts -> unchanged plain-literal behavior.
                var has_interps = false
                var interp_list: [HirInterpolation] = []
                if val il = interps_opt:
                    interp_list = il
                    if interp_list.len() > 0:
                        has_interps = true
                if has_interps:
                    self.lower_string_interpolation(value, interp_list)
                else:
                    # Store string as constant; runtime resolves pointer
                    var b = self.builder
                    val dest = b.new_temp(MirType(kind: MirTypeKind.Opaque("str")))
                    b.emit_const(dest, MirConstValue.Str(value), MirType(kind: MirTypeKind.Opaque("str")))
                    self.builder = b
                    dest

            case NilLit:
                # Bug #137 (follow-up): a bare `nil` literal previously
                # allocated a fresh temp via `new_temp` but emitted NO
                # defining instruction. When that temp was then used as an
                # operand -- e.g. the RHS of `args == nil`, lowered by the
                # backend to `inttoptr i64 %lN to ptr` -- `%lN` was a dangling
                # SSA reference (llc: "use of undefined value"). Materialize
                # nil as a real defined const (i64): translate_const emits
                # `%lN = add i64 0, 3`, a defined value that the Eq/Ne
                # comparison then casts to `ptr` via inttoptr, or compares
                # directly as an integer.
                #
                # Bug (native_i64opt_some0_collapses_to_nil): the const used
                # to be `Int(0)`, i.e. the flat sentinel was literally 0 --
                # indistinguishable at the value level from a real `Some(0)`
                # payload on the (non-boxed) primitive `i64?`/`bool?` fast
                # path, so `val x: i64? = 0` and `nil` were the SAME value and
                # `??`/`.?`/`if val`/`==nil` all silently treated Some(0) as
                # None. Emit `3` instead -- the same reserved bit pattern the
                # runtime's tagged/boxed lane already uses for nil
                # (`rt_core_nil()` = SPECIAL tag 0b011, payload 0 = 3; see
                # `box_runtime_value` above, which already materializes nil as
                # `emit_const_int(3)` for the boxed/runtime-value lane). Real
                # payloads on the flat fast path are never boxed (raw
                # int/bool bit patterns, e.g. false=0, true=1), so 3 cannot
                # collide with any real bool payload and only collides with
                # the specific literal int payload 3 (an acceptable, narrow
                # trade for closing the much more common Some(0) collision;
                # full non-collision requires boxing every flat Option
                # payload, which is out of scope here -- see
                # doc/08_tracking/bug/native_i64opt_some0_collapses_to_nil_2026-07-14.md).
                var b_nil_lit = self.builder
                val nil_result = b_nil_lit.new_temp(MirType.i64())
                b_nil_lit.emit_const(nil_result, MirConstValue.Int(3), MirType.i64())
                self.builder = b_nil_lit
                self.nil_locals[nil_result.id] = true
                nil_result

            case UnitLit:

                var b = self.builder
                val result = b.new_temp(MirType.unit())
                self.builder = b
                result

            case Var(symbol):
                # Look up variable in local_map using contains_key first
                val symbol_id = mir_expr_symbol_id_value(symbol)
                if symbol_id < 0:
                    self.error("undefined variable", Some(expr_value.span))
                    var b_nil = self.builder
                    val nil_tmp = b_nil.emit_const_int(0)
                    self.builder = b_nil
                    nil_tmp
                elif self.find_local(symbol_id).id >= 0:
                    self.find_local(symbol_id)
                elif val global_local = self.try_lower_global_read(symbol_id):
                    global_local
                else:
                    self.error("undefined variable", Some(expr_value.span))
                    var b_err = self.builder
                    val err_tmp = b_err.emit_const_int(0)
                    self.builder = b_err
                    err_tmp

            case NamedVar(symbol, name):
                # Same lookup as Var -- HirLowering's `case Ident(name):` (in
                # hir_lowering/expressions.spl) produces NamedVar(symbol, name)
                # for every resolved identifier reference, but this dispatch
                # only had a case for the name-less Var(symbol) variant. Every
                # other test in this suite builds MIR fixtures directly
                # (bypassing real source -> HIR -> MIR lowering), so this
                # never got exercised until real frontend parsing was used;
                # falling through to the `case _:` catch-all silently
                # returned nil for any local variable reference.
                #
                if name == "OUTPUT_LIMIT":
                    var b_const = self.builder
                    val const_tmp = b_const.emit_const_int(12000)
                    self.builder = b_const
                    const_tmp
                elif name == "DEFAULT_TIMEOUT_MS":
                    var b_timeout = self.builder
                    val timeout_tmp = b_timeout.emit_const_int(7200000)
                    self.builder = b_timeout
                    timeout_tmp
                else:
                    val symbol_id = mir_expr_symbol_id_value(symbol)
                    if symbol_id < 0:
                        self.error("undefined variable: {name}", Some(expr_value.span))
                        var b_err3 = self.builder
                        val err_tmp3 = b_err3.emit_const_int(0)
                        self.builder = b_err3
                        err_tmp3
                    elif self.find_local(symbol_id).id >= 0:
                        self.find_local(symbol_id)
                    elif val global_local2 = self.try_lower_global_read(symbol_id):
                        global_local2
                    else:
                        self.error("undefined variable: {name}", Some(expr_value.span))
                        var b_err2 = self.builder
                        val err_tmp2 = b_err2.emit_const_int(0)
                        self.builder = b_err2
                        err_tmp2

            case Binary(op, left, right):
                self.lower_binary_expr(expr_value, op, left, right)

            case Unary(op, operand):

                val operand_local = self.lower_expr(operand)
                var b = self.builder
                val operand_type = self.local_mir_type_of(operand_local) ?? MirType.i64()
                val op_disc = rt_enum_discriminant(op)
                var unary_result: LocalId = 0
                if op_disc == rt_enum_discriminant(HirUnaryOp.Ref):
                    unary_result = b.emit_ref(MirPlace.local_place(operand_local), MirBorrowKind.Shared, operand_type)
                elif op_disc == rt_enum_discriminant(HirUnaryOp.RefMut):
                    unary_result = b.emit_ref(MirPlace.local_place(operand_local), MirBorrowKind.Mutable, operand_type)
                else:
                    val mir_op = self.lower_unaryop(op)
                    unary_result = b.emit_unary(mir_op, mir_operand_copy(operand_local), operand_type)
                self.builder = b
                unary_result

            case If(cond, then_, else_):
                val expected_if_type: HirType? = if expr.has_type_ and expr.type_ != nil: expr.type_ else: nil
                self.lower_if(cond, then_, else_, expected_if_type)
            case IfChain(arms, else_):
                val expected_if_chain_type: HirType? = if expr_value.has_type_ and expr_value.type_ != nil: expr_value.type_ else: nil
                self.lower_if_chain(arms, else_, expected_if_chain_type)

            case MethodCall(receiver, method, args, resolution):
                if mir_lower_expr_trace_state == 1:
                    eprint("[mir-lower-expr] method-dispatch-before method={method}\n")
                # Do not inspect nested `resolution` or `receiver.kind`
                # payloads here. This outer MethodCall payload is already a
                # value extracted from `expr_value.kind`; a second native enum
                # match at this boundary can loop while allocating. Resolved
                # calls retain their MethodResolution, while unresolved static
                # calls use lower_method_call's conservative unique-symbol
                # recovery until HIR carries explicit scalar owner metadata.
                val method_result = self.lower_method_call(
                    receiver, method, args, resolution,
                    "", -1)
                if mir_lower_expr_trace_state == 1:
                    eprint("[mir-lower-expr] method-dispatch-after method={method} id={method_result.id}\n")
                method_result

            case ArrayLit(elements, _):
                self.lower_array_lit(elements)

            case ArrayRepeat(value, count, _):
                self.lower_array_repeat(value, count)

            case DictLit(entries, _, _):
                self.lower_dict_lit(entries)

            case Index(base, index):
                val has_index_result_type = expr_value.has_type_ == true and expr_value.type_ != nil
                self.lower_index_expr(base, index, has_index_result_type, expr_value.type_)

            case SetLit(elements, _):
                self.lower_set_lit(elements)

            case TupleLit(elements):
                self.lower_tuple_lit(elements)

            case NullCoalesce(left, right):
                # `x ?? default` -- Some(v) yields v, nil yields default.
                # Must branch on rt_is_some(x), NOT on truthiness of the
                # decoded payload: `Some(0) ?? 3` must yield 0, not 3.
                #
                # Merge via a shared result slot (store-in-each-branch, single
                # load after the merge block) instead of the __simple_ssa_phi
                # intrinsic: that intrinsic calls translate_operand() on each
                # arm's value at the point the phi instruction itself is
                # translated (in the merge block), which re-emits a fresh load
                # for any memory-backed local right before the `phi` line --
                # violating LLVM's "phi must be first in the block" rule
                # ("PHI nodes not grouped at top of basic block!"). Mirror the
                # ExistsCheck (`.?`) fix just below, which sidesteps this the
                # same way `lower_if` (mir_lowering_stmts.spl) does.
                val left_local = self.lower_expr(left)
                var result_type = MirType.i64()
                if val expr_type = expr_value.type_:
                    result_type = self.lower_type(expr_type)
                # Struct-typed payload: same gap as ExistsCheck (`.?`) just
                # below, and proven to reproduce identically here (both
                # `x ?? default` and its None-branch default silently
                # defaulted every `v.x`/`v.y` field to index 0 -- see
                # hosted_native_option_try_unwrap_payload_leak_2026-07-19).
                # `enum_payload_value`'s default arm hands back the raw
                # ptrtoint'd handle untouched (correct bits) but with no
                # struct-name provenance on the merged result_local. Look up
                # the left operand's Option-declared inner struct name the
                # same way ExistsCheck does; the right (default) operand's
                # own fresh construction is checked as an additional
                # fallback once right_local exists, below.
                var result_struct_name = ""
                if val nc_inner_type = self.option_inner_hir_type_for_local(left, left_local):
                    match nc_inner_type.kind:
                        case HirTypeKind.Named(nc_struct_symbol, _):
                            val nc_type_symbol = self.symbols.get_symbol_raw(nc_struct_symbol.id)
                            if nc_type_symbol != nil:
                                match nc_type_symbol.kind:
                                    case Struct:
                                        result_struct_name = nc_type_symbol.name
                                    case _: ()
                        case _: ()
                if result_struct_name == "":
                    # Same "raw migration form" fallback as ExistsCheck: a
                    # struct pointer bound straight to `T?` without ever
                    # calling ensure_option_handle leaves left_local with no
                    # local_hir_types/option_value_locals entry, but struct
                    # construction itself always registers struct_value_syms
                    # on the raw pointer.
                    val nc_fallback_sym = self.struct_value_syms.get(left_local.id)
                    if nc_fallback_sym != nil:
                        result_struct_name = nc_fallback_sym ?? ""
                var b_nc = self.builder
                val is_some_func = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_is_some"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                        params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false
                    )))
                ))
                val is_some_res = b_nc.emit_call(is_some_func, [mir_operand_copy(left_local)], MirType.bool())
                self.builder = b_nc
                val is_some_local = is_some_res ?? LocalId(id: 0)

                var b_split = self.builder
                val then_block = b_split.new_block(Some("null_coalesce_left"))
                val else_block = b_split.new_block(Some("null_coalesce_right"))
                val merge_block = b_split.new_block(Some("null_coalesce_merge"))
                val result_local = b_split.new_temp(result_type)
                b_split.terminate_if(mir_operand_copy(is_some_local), then_block, else_block)
                self.builder = b_split

                var b_left = self.builder
                b_left.switch_to_block(then_block)
                self.builder = b_left
                var left_value = self.option_payload_or_self(left_local)
                if self.is_runtime_value_local(left_local.id) and not self.option_value_locals.contains(left_local.id):
                    left_value = self.decode_runtime_value(left_local, result_type)
                else:
                    left_value = self.enum_payload_value(left_value, result_type)
                b_left = self.builder
                b_left.emit_copy(result_local, left_value)
                b_left.terminate_goto(merge_block)
                self.builder = b_left

                var b_right = self.builder
                b_right.switch_to_block(else_block)
                self.builder = b_right
                val right_local = self.lower_expr(right)
                var right_value = right_local
                val right_terminated = self.builder.current_block_has_explicit_terminator()
                if not right_terminated:
                    val right_runtime = self.is_runtime_value_local(right_local.id)
                    if right_runtime:
                        right_value = self.decode_runtime_value(right_local, result_type)
                    b_right = self.builder
                    b_right.emit_copy(result_local, right_value)
                    b_right.terminate_goto(merge_block)
                    self.builder = b_right
                if not right_terminated and result_struct_name == "":
                    # The right (default) operand is a fresh, non-Option
                    # expression -- its own construction registers
                    # struct_value_syms on right_local directly, independent
                    # of any Option-unwrap machinery. Use it if the left
                    # (Option) side's lookup above found nothing.
                    val nc_right_fallback_sym = self.struct_value_syms.get(right_local.id)
                    if nc_right_fallback_sym != nil:
                        result_struct_name = nc_right_fallback_sym ?? ""

                if self.is_runtime_value_local(left_value.id) or (not right_terminated and self.is_runtime_value_local(right_value.id)):
                    self.mark_runtime_value_local(result_local.id)
                if self.runtime_array_locals.contains(left_value.id) or (not right_terminated and self.runtime_array_locals.contains(right_value.id)):
                    self.runtime_array_locals[result_local.id] = true
                if self.runtime_dict_locals.contains(left_value.id) or (not right_terminated and self.runtime_dict_locals.contains(right_value.id)):
                    self.runtime_dict_locals[result_local.id] = true
                if result_struct_name != "":
                    self.struct_value_syms[result_local.id] = result_struct_name

                var b_merge = self.builder
                b_merge.switch_to_block(merge_block)
                self.builder = b_merge
                result_local

            case ExistsCheck(base):
                # `.?` (existence check) returns T? — the payload itself when
                # present, nil when absent (doc/07_guide/quick_reference/
                # syntax_quick_reference.md "Existence Check (.?) - Returns T?").
                # It must NOT collapse to the bare `rt_is_some` bool: that
                # discarded the payload (e.g. `if val v = x.?: return v`
                # returned 1 instead of x's value), the native-smoke-matrix
                # "(14) Option/nil check (x.?)" regression.
                #
                # Merge via a shared result slot (store-in-each-branch, single
                # load after the merge block) instead of the __simple_ssa_phi
                # intrinsic used by NullCoalesce just above: that intrinsic
                # calls translate_operand() on each arm's value at the point
                # the phi instruction itself is translated (in the merge
                # block), which re-emits a fresh load for any memory-backed
                # local right before the `phi` line -- violating LLVM's "phi
                # must be first in the block" rule ("PHI nodes not grouped at
                # top of basic block!"). That is a pre-existing bug in the
                # shared intrinsic, reproducible standalone on plain
                # `x ?? default` too, not something newly introduced here.
                # `lower_if` (mir_lowering_stmts.spl) sidesteps it exactly
                # this way, so mirror that proven pattern.
                val base_local = self.lower_expr(base)
                var result_type = MirType.i64()
                if val expr_type = expr_value.type_:
                    result_type = self.lower_type(expr_type)
                # Struct-typed payload: `enum_payload_value`'s default arm
                # (just below) hands back the raw ptrtoint'd handle
                # untouched -- correct bits, but with no struct-name
                # provenance attached to the merged result local. A later
                # `v.x`/`v.y` field access (resolve_field_index) then has
                # neither an HIR type annotation on `v` nor a
                # struct_value_syms entry to consult and silently defaults
                # EVERY field name to index 0 (same landmine documented at
                # struct_value_syms's other call sites in this file/module --
                # "array-of-structs field misread", "chained access"). Look
                # up the Option's declared inner struct name up front so it
                # can be attached to result_local once, mirroring how
                # lower_result_unwrap/emit_resolved_direct_call register
                # struct_value_syms for their own freshly-produced locals.
                var result_struct_name = ""
                if val exists_inner_type = self.option_inner_hir_type_for_local(base, base_local):
                    match exists_inner_type.kind:
                        case HirTypeKind.Named(exists_struct_symbol, _):
                            val exists_type_symbol = self.symbols.get_symbol_raw(exists_struct_symbol.id)
                            if exists_type_symbol != nil:
                                match exists_type_symbol.kind:
                                    case Struct:
                                        result_struct_name = exists_type_symbol.name
                                    case _: ()
                        case _: ()
                if result_struct_name == "":
                    # Struct-typed Option locals may use the "raw migration
                    # form" (see `.unwrap()`'s own doc comment a few hundred
                    # lines up): a plain struct pointer assigned straight to
                    # a `T?` binding without ever going through
                    # ensure_option_handle's canonical enum-id-1 wrap (the
                    # pointer's own non-nil-ness already distinguishes
                    # Some/None for rt_is_some/rt_unwrap_or_self, so the
                    # wrap is skippable). That leaves base_local with no
                    # local_hir_types/option_value_locals entry for the
                    # lookup above to find -- but struct construction itself
                    # always registers struct_value_syms on the raw pointer,
                    # so fall back to that direct, already-reliable source
                    # (same fallback resolve_field_index/
                    # resolve_base_struct_name use for the identical
                    # no-HIR-type-info situation).
                    val fallback_struct_sym = self.struct_value_syms.get(base_local.id)
                    if fallback_struct_sym != nil:
                        result_struct_name = fallback_struct_sym ?? ""
                var b_ec = self.builder
                val is_some_func = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_is_some"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                        params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false
                    )))
                ))
                val is_some_res = b_ec.emit_call(is_some_func, [mir_operand_copy(base_local)], MirType.bool())
                self.builder = b_ec
                val is_some_local = is_some_res ?? LocalId(id: 0)

                var b_split = self.builder
                val then_block = b_split.new_block(Some("exists_check_some"))
                val else_block = b_split.new_block(Some("exists_check_none"))
                val merge_block = b_split.new_block(Some("exists_check_merge"))
                val result_local = b_split.new_temp(result_type)
                b_split.terminate_if(mir_operand_copy(is_some_local), then_block, else_block)
                self.builder = b_split

                var b_then = self.builder
                b_then.switch_to_block(then_block)
                self.builder = b_then
                var some_value = self.option_payload_or_self(base_local)
                if self.is_runtime_value_local(base_local.id) and not self.option_value_locals.contains(base_local.id):
                    some_value = self.decode_runtime_value(base_local, result_type)
                else:
                    some_value = self.enum_payload_value(some_value, result_type)
                b_then = self.builder
                b_then.emit_copy(result_local, some_value)
                b_then.terminate_goto(merge_block)
                self.builder = b_then

                var b_else = self.builder
                b_else.switch_to_block(else_block)
                self.builder = b_else
                # Bug (native_i64opt_some0_collapses_to_nil): this used to
                # hardcode `Int(0)` as the "none" result of `x.?`. Now that
                # `NilLit` materializes the nil sentinel as `3`
                # (rt_core_nil(), see above), this branch must emit the SAME
                # sentinel -- otherwise `x.?` on a nil `x` yields a fresh 0,
                # which (post-fix) `rt_is_none` no longer recognizes as nil,
                # so an outer `if val v = x.?:` would wrongly treat the
                # none-case result as `Some(0)`.
                b_else.emit_const(result_local, MirConstValue.Int(3), result_type)
                b_else.terminate_goto(merge_block)
                self.builder = b_else

                if self.is_runtime_value_local(some_value.id):
                    self.mark_runtime_value_local(result_local.id)
                if self.runtime_array_locals.contains(some_value.id):
                    self.runtime_array_locals[result_local.id] = true
                if self.runtime_dict_locals.contains(some_value.id):
                    self.runtime_dict_locals[result_local.id] = true
                if result_struct_name != "":
                    self.struct_value_syms[result_local.id] = result_struct_name
                # Float payload provenance. `.?` keeps its result slot i64 on
                # purpose: `if val v = opt:` is parser-desugared to this binding
                # plus `v != nil`, and the nil sentinel comparison must run on
                # the raw word (a float-typed slot cannot even hold the integer
                # sentinel -- llc: "integer constant must have integer type").
                # The decode therefore belongs in the PRESENT branch, which
                # lower_if/lower_if_chain already implement
                # (mir_lowering_stmts.spl, `has_if_val_float_binding`) -- but
                # that code asks `find_local_hir_type` for the binder's
                # SEMANTIC type, and nothing ever registered one here, so it
                # never fired and the binder printed the raw IEEE-754 bits.
                # Record the payload's own HIR type on the result local: that
                # is the provenance the present-branch decode needs, carried
                # forward from the Option's declared inner type rather than
                # re-sniffed from the desugared shape.
                if val exists_payload_type = self.option_inner_hir_type_for_local(base, base_local):
                    match exists_payload_type.kind:
                        case HirTypeKind.Float(_):
                            self.remember_local_hir_type(result_local.id, exists_payload_type, 0, 0)
                        case _: ()

                var b_merge = self.builder
                b_merge.switch_to_block(merge_block)
                self.builder = b_merge
                result_local

            case Unwrap(base):
                # `expr!` -- force-unwrap: Some(v) (or the flat-nullable raw
                # word form) yields v, None/nil panics. Before this arm,
                # HirExprKind.Unwrap had NO MIR lowering at all and fell to
                # the `case _` default below, which records a compile error
                # and hands back a fresh unit temp -- see
                # doc/08_tracking/bug/enum_match_no_arm_when_entry_in_same_package_2026-08-06.md.
                #
                # This mirrors `.unwrap()`'s own MIR lowering exactly
                # (method_calls_literals.spl, the "unwrap" method-call arm):
                # same rt_is_some branch (never truthiness, so a present
                # numeric zero / payloadless variant is preserved), same
                # enum_payload_value/option_payload_or_self/decode_runtime_value
                # payload extraction depending on which physical Option lane
                # the receiver is in, same struct-name provenance carry-over
                # via struct_value_syms -- because `!` and `.unwrap()` are the
                # same runtime operation with different call syntax.
                val uw_base_local = self.lower_expr(base)
                var uw_result_type = MirType.i64()
                var uw_is_text = false
                var uw_is_bool = false
                val uw_inner_type = self.option_inner_hir_type_for_local(base, uw_base_local)
                if uw_inner_type != nil:
                    val uw_found_inner = uw_inner_type ?? HirType(kind: HirTypeKind.Error, span: base.span)
                    match uw_found_inner.kind:
                        case HirTypeKind.Str:
                            uw_result_type = self.bootstrap_text_type()
                            uw_is_text = true
                        case HirTypeKind.Bool:
                            uw_result_type = MirType.bool()
                            uw_is_bool = true
                        case _: uw_result_type = self.lower_type(uw_found_inner)
                elif self.local_is_str(uw_base_local):
                    uw_result_type = self.bootstrap_text_type()
                    uw_is_text = true
                elif val uw_base_mir_type = self.local_mir_type_of(uw_base_local):
                    uw_result_type = uw_base_mir_type

                var b_uw_chk = self.builder
                val is_some_uw_op = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_is_some"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                        params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false
                    )))
                ))
                val is_some_uw_res = b_uw_chk.emit_call(is_some_uw_op, [mir_operand_copy(uw_base_local)], MirType.bool())
                self.builder = b_uw_chk
                val is_some_uw_local = is_some_uw_res ?? LocalId(id: 0)

                var b_split_uw = self.builder
                val some_block_uw = b_split_uw.new_block(Some("force_unwrap_some"))
                val none_block_uw = b_split_uw.new_block(Some("force_unwrap_none"))
                val merge_block_uw = b_split_uw.new_block(Some("force_unwrap_merge"))
                val result_local_uw = b_split_uw.new_temp(uw_result_type)
                b_split_uw.terminate_if(mir_operand_copy(is_some_uw_local), some_block_uw, none_block_uw)
                self.builder = b_split_uw

                var b_some_uw = self.builder
                b_some_uw.switch_to_block(some_block_uw)
                self.builder = b_some_uw
                var some_val_uw = self.option_payload_or_self(uw_base_local)
                if uw_is_text:
                    some_val_uw = self.option_text_value(some_val_uw, uw_result_type)
                elif self.is_runtime_value_local(uw_base_local.id) and not self.option_value_locals.contains(uw_base_local.id):
                    some_val_uw = self.decode_runtime_value(some_val_uw, uw_result_type)
                elif uw_is_bool:
                    some_val_uw = self.option_bool_value(some_val_uw)
                else:
                    some_val_uw = self.enum_payload_value(some_val_uw, uw_result_type)
                b_some_uw = self.builder
                b_some_uw.emit_copy(result_local_uw, some_val_uw)
                b_some_uw.terminate_goto(merge_block_uw)
                self.builder = b_some_uw

                var b_none_uw = self.builder
                b_none_uw.switch_to_block(none_block_uw)
                self.builder = b_none_uw
                val panic_msg_uw = b_none_uw.emit_const_str("called `!` force-unwrap on a nil Option")
                val panic_op_uw = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_panic"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)))
                ))
                b_none_uw.emit_call(panic_op_uw, [mir_operand_copy(panic_msg_uw)], MirType.unit())
                b_none_uw.emit_const(result_local_uw, MirConstValue.Zero, uw_result_type)
                b_none_uw.terminate_goto(merge_block_uw)
                self.builder = b_none_uw

                if self.is_runtime_value_local(some_val_uw.id):
                    self.mark_runtime_value_local(result_local_uw.id)

                if self.struct_value_syms.contains(uw_base_local.id):
                    self.struct_value_syms[result_local_uw.id] = self.struct_value_syms[uw_base_local.id]
                elif uw_inner_type != nil:
                    # Option HANDLE base carries no struct_value_syms entry; recover the
                    # owner from the Option's inner Named type exactly as the `.unwrap()`
                    # arm does (method_calls_literals.spl), else `m!.method()` hard-fails
                    # with `unresolved method call`.
                    val owner_inner_bang = uw_inner_type ?? HirType(kind: HirTypeKind.Error, span: base.span)
                    match owner_inner_bang.kind:
                        case HirTypeKind.Named(bang_owner_symbol, _):
                            match self.symbols.get_symbol_raw(bang_owner_symbol.id):
                                case Some(bang_owner_sym):
                                    if bang_owner_sym.name != "":
                                        self.struct_value_syms[result_local_uw.id] = bang_owner_sym.name
                                case _: ()
                        case _: ()

                var b_merge_uw = self.builder
                b_merge_uw.switch_to_block(merge_block_uw)
                self.builder = b_merge_uw
                result_local_uw

            case Try(try_base):
                # `expr?` — Err propagates via early return, Ok yields payload.
                self.lower_try_expr(try_base)

            case HostGpuLane(lane_code, payload_size, marker, body):
                self.lower_host_gpu_lane(lane_code, payload_size, marker, body)

            case Loop(body, _):
                self.lower_loop(body)

            case While(cond, body, _):
                self.lower_while(cond, body)

            case For(var_, iter, body, _):
                self.lower_for(var_, iter, body, expr_value.span)

            case Return(value):
                self.lower_return_expr(value)

            case Break(break_label, break_value):
                if self.loop_stack.len() > 0:
                    val (loop_continue_block, break_block) = self.loop_stack[self.loop_stack.len() - 1]
                    var b = self.builder
                    b.terminate_goto(break_block)
                    self.builder = b
                var b = self.builder
                val break_temp = b.new_temp(MirType.unit())
                self.builder = b
                break_temp

            case Continue(cont_label):
                if self.loop_stack.len() > 0:
                    val (continue_block, loop_break_block) = self.loop_stack[self.loop_stack.len() - 1]
                    var b = self.builder
                    b.terminate_goto(continue_block)
                    self.builder = b
                var b = self.builder
                val cont_temp = b.new_temp(MirType.unit())
                self.builder = b
                cont_temp

            # Custom blocks (user-defined: sh{}, sql{}, re{}, etc.)
            case CustomBlock(kind, value):
                self.lower_custom_block(kind, value, expr_value.span)

            # Math/DL blocks with special semantics
            case LossBlock(body):
                self.lower_loss_block(body)

            case NogradBlock(body):
                self.lower_nograd_block(body)

            case Range(start, end, inclusive, step):
                self.lower_range(start, end, inclusive, step)

            # Async/Await expressions
            case Await(future_expr):
                self.lower_await(future_expr)

            case Yield(value):
                self.lower_yield(value)

            # Unsafe block - lower the body, no special handling
            case UnsafeBlock(body):
                self.lower_block(body) ?? self.builder.new_temp(MirType.unit())

            # Inline assembly
            case InlineAsm(asm_expr):
                self.lower_inline_asm(asm_expr)

            # Target-qualified inline assembly
            case InlineAsmMatch(arms):
                self.lower_inline_asm_match(arms)

            # Field access: obj.field_name
            case Field(base, field_name, resolved):
                # Reclassify `Color.Red` — a bare unit-variant construction
                # parsed as FIELD ACCESS — into enum construction when the base
                # names a registered enum and the field is one of its variants
                # (mirrors the MethodCall interception for `Shape.Circle(7)`).
                # Without this the base lowers as an undefined variable load and
                # the field read nil-derefs at runtime.
                var fa_enum_name = ""
                match base.kind:
                    case Var(fa_sym):
                        val fa_s = self.symbols.get_symbol_raw(fa_sym.id)
                        if fa_s.?: fa_enum_name = fa_s.name
                    case NamedVar(_, fa_name):
                        fa_enum_name = fa_name
                    case _: ()
                if fa_enum_name != "" and self.enum_variant_index.contains(fa_enum_name):
                    var fa_is_variant = false
                    for fa_vn in self.enum_variant_index[fa_enum_name]:
                        if fa_vn == field_name:
                            fa_is_variant = true
                    if fa_is_variant:
                        return self.lower_enum_construct_named(fa_enum_name, field_name, [])
                val base_local = self.lower_expr(base)
                # `.len`/`.length` as a BARE FIELD ACCESS on a string must route
                # to the raw-char* length helper `rt_strlen`, not emit_get_field.
                # On the native path a string (literal, `+` concat, or interp
                # result) is a RAW char*: translate_const emits a getelementptr
                # into a [N x i8] global and rt_strcat returns raw char* (see
                # lower_string_interpolation), and the lowered local carries MIR
                # type Opaque("str"). A struct get_field on that pointer reads
                # offset 0 -- the first data byte (e.g. 'f'=102 for "foobar") for
                # a valid pointer, and nil-derefs -> SIGSEGV when the base is a
                # concat result. `rt_strlen` (spl_str_len) is the correct
                # raw-char* length accessor. Keyed off the MIR local type
                # (Opaque str) because HIR `.type_` is nil on this path; user
                # structs with a real `len` field and arrays are unaffected.
                # Concat-drop fix (follow-up): same rt_interp_cstr coercion as
                # the pre-dispatch `.len` arm above -- required since `+` now
                # emits rt_strcat_tagged (a properly tagged RtCoreString), and
                # rt_strlen must never receive a tagged pointer directly.
                if (field_name == "len" or field_name == "length") and self.local_is_str(base_local):
                    var fa_len_src = base_local
                    var fa_len_func_name = "rt_string_len"
                    if not self.is_runtime_value_local(base_local.id):
                        val fa_cstr_op = MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("rt_interp_cstr"),
                            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
                        ))
                        var b_fa_cstr = self.builder
                        val fa_cstr_res = b_fa_cstr.emit_call(fa_cstr_op, [mir_operand_copy(base_local)], MirType(kind: MirTypeKind.Opaque("str")))
                        self.builder = b_fa_cstr
                        if val fa_cstr_local = fa_cstr_res:
                            fa_len_src = fa_cstr_local
                        fa_len_func_name = "rt_strlen"
                    val fa_func = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str(fa_len_func_name),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_fa = self.builder
                    val fa_res = b_fa.emit_call(fa_func, [mir_operand_copy(fa_len_src)], MirType.i64())
                    self.builder = b_fa
                    if val fa_res_local = fa_res:
                        return fa_res_local
                    return base_local
                val bitfield_result = self.try_lower_bitfield_get(base, base_local, field_name)
                if val bitfield_local = bitfield_result:
                    return bitfield_local
                val field_idx = self.resolve_field_index(base, base_local, field_name, resolved)
                # Bug (native_class_array_field_mutation_segfault /
                # native_bool_array_element_interpolation_special_garbage,
                # 2026-07-17): same pre-lookup as the disc-guarded Field arm
                # above, kept in sync for this fallback dispatch path -- see
                # that arm's comment for why field_type must be overridden
                # BEFORE emit_get_field rather than patched up afterward.
                val base_struct_name_pre2 = self.resolve_base_struct_name(base, base_local)
                val field_elem_type_override2: HirType? = match base_struct_name_pre2:
                    case Some(bsn_pre2): self.field_array_element_override(bsn_pre2, field_idx)
                    case _: nil
                var field_type = MirType.i64()
                if val field_elem_type3 = field_elem_type_override2:
                    field_type = MirType(kind: MirTypeKind.Array(self.lower_type(field_elem_type3), 0))
                else:
                    # native_aot_f64_struct_field_interp_bitcast: prefer the
                    # OWNER struct's declared field type (same
                    # struct_field_hir_type table compound_field_mir_type
                    # uses for `obj.f += v`'s read side) over the HIR
                    # field-access expr's own `.type_` annotation, which is
                    # unreliable/nil here and silently fell through to the
                    # `MirType.i64()` default above -- so an f64 field's
                    # GetField dest was registered as i64, and downstream
                    # string-interpolation type dispatch
                    # (coerce_concat_operand, which trusts local_mir_type_of)
                    # picked rt_raw_i64_to_string over rt_raw_f64_to_string,
                    # printing the field's raw IEEE-754 bit pattern as a
                    # decimal integer instead of formatting it as a float.
                    var declared_field_resolved = false
                    if val owner_name3 = base_struct_name_pre2:
                        if self.struct_field_hir_type.contains(owner_name3):
                            val field_types3 = self.struct_field_hir_type[owner_name3]
                            if field_idx >= 0 and field_idx < field_types3.len():
                                val declared_field_type3 = field_types3[field_idx]
                                match declared_field_type3.kind:
                                    case HirTypeKind.Error: ()
                                    case _:
                                        field_type = self.lower_type(declared_field_type3)
                                        declared_field_resolved = true
                    if not declared_field_resolved:
                        if val expr_type = expr_value.type_:
                            field_type = self.lower_type(expr_type)
                val projected_struct_name2 = self.resolve_base_struct_name(base, base_local)
                if val psn2 = projected_struct_name2:
                    if self.struct_field_repr_name.contains(psn2):
                        val field_reprs2 = self.struct_field_repr_name[psn2]
                        if field_idx >= 0 and field_idx < field_reprs2.len() and field_reprs2[field_idx] == "str":
                            field_type = MirType(kind: MirTypeKind.Opaque("str"))
                var b = self.builder
                val result = b.emit_get_field(mir_operand_copy(base_local), field_idx, field_type)
                self.builder = b
                # Same rationale as the disc-guarded Field arm above: the
                # field_elem_type_override2 computed above already gave
                # field_type the real Array(elem) shape when known, so no
                # separate local_hir_types registration is needed here.
                self.remember_field_projection_provenance(base, base_local, field_idx, result)
                result

            # Type cast: expr as Type
            case Cast(operand, target):
                self.lower_cast_expr(operand, target, expr.span)

            # B5b Phase 1: lower MatchCase on integer-literal patterns to
            # MirTerminator.Switch (dense >=4 arms, span <= 1024) or to a
            # nested If chain (sparse / smaller). Other pattern kinds and
            # guards are explicitly rejected as Phase 2.
            case EnumLit(type_, variant, payload):
                self.lower_enum_lit(type_, variant, payload)

            case MatchCase(scrutinee, arms):
                val expected_match_type: HirType? = if expr.has_type_: expr.type_ else: nil
                self.lower_match_case(scrutinee, arms, expected_match_type)

            # ----------------------------------------------------------------
            # Lane C6 (HIR-expr -> MIR completeness, hardening plan 2026-08-21
            # sections 11.3-11.6). Every remaining HirExprKind variant gets an
            # EXPLICIT arm here, even the ones MIR lowering does not implement.
            #
            # Before this block these eleven variants reached the terminal
            # `case _:` and were reported as `unsupported MIR expression:
            # {expr_value.kind}` -- which interpolates a heap enum as an opaque
            # `<enum@0x..>` handle (that arm's own comment says so). The variant
            # was therefore NOT NAMED in the diagnostic: an operator hitting
            # `x as T` or a struct literal in the self-hosted lane got an
            # unreadable message and no way to find the construct.
            #
            # Each arm now raises its own named E-MIR-EXPR-<Variant> diagnostic
            # carrying the real source span, and hands back a fresh unit temp so
            # lowering continues and the driver flushes diagnostics normally --
            # the same discipline the terminal arm already uses. The terminal
            # `case _:` survives ONLY for a garbage/mis-decoded enum handle,
            # which is a different failure with a different message.
            #
            # Recorded in spec/compiler_schema/transitions/hir_expr_to_mir.sdn
            # as `state: unsupported`; an omission there shows up as Missing and
            # fails check-compiler-transition-coverage.shs.
            # ----------------------------------------------------------------
            case As(_, _):
                self.unsupported_expr_kind("E-MIR-EXPR-As", "as-cast expression (`expr as Type`)", expr_value.span)

            case CharLit(_):
                self.unsupported_expr_kind("E-MIR-EXPR-CharLit", "character literal", expr_value.span)

            case Comprehension(_, _, _):
                self.unsupported_expr_kind("E-MIR-EXPR-Comprehension", "comprehension expression", expr_value.span)

            case Error:
                self.unsupported_expr_kind("E-MIR-EXPR-Error", "error-recovery expression node (an earlier phase already reported the real error)", expr_value.span)

            case Lambda(_, _, _):
                # A lambda literal in any other value position (returned from
                # a fn, stored in a struct field/array, nested inside another
                # lambda body): run the same closure conversion the Let/call-arg
                # paths use -- lift to `__lambda_lift_<n>` and, when it
                # captures, materialize an rt_closure_new env. Only a capture
                # shape the lift cannot handle keeps the loud failure.
                val lifted_lambda = self.lower_lambda_value(expr_value)
                if lifted_lambda != nil:
                    val lifted = lifted_lambda.unwrap()
                    match lifted.kind:
                        case Const(_, lambda_type):
                            var lambda_b = self.builder
                            val lambda_local = lambda_b.emit_cast(lifted, lambda_type)
                            self.builder = lambda_b
                            lambda_local
                        case Copy(lambda_local) | Move(lambda_local):
                            lambda_local
                        case _:
                            self.unsupported_expr_kind("E-MIR-EXPR-Lambda", "lambda expression (closure conversion has not run)", expr_value.span)
                else:
                    self.unsupported_expr_kind("E-MIR-EXPR-Lambda", "lambda expression (closure conversion has not run)", expr_value.span)

            case OptionalChain(_, _):
                self.unsupported_expr_kind("E-MIR-EXPR-OptionalChain", "optional-chain field access (`base?.field`)", expr_value.span)

            case StaticCall(_, _, _, _):
                self.unsupported_expr_kind("E-MIR-EXPR-StaticCall", "static/associated method call (`Type::method(..)`)", expr_value.span)

            case StructLit(_, _):
                self.unsupported_expr_kind("E-MIR-EXPR-StructLit", "struct literal", expr_value.span)

            case Throw(_):
                self.unsupported_expr_kind("E-MIR-EXPR-Throw", "throw expression", expr_value.span)

            case TupleIndex(_, _):
                self.unsupported_expr_kind("E-MIR-EXPR-TupleIndex", "tuple index access (`t.0`)", expr_value.span)

            case With(_, _):
                self.unsupported_expr_kind("E-MIR-EXPR-With", "with-block expression", expr_value.span)

            case _:
                # Loud-fail, but with a REAL local. Returning `nil` here made
                # the whole failure invisible and unfixable: `self.error()` only
                # accumulates a diagnostic, lowering keeps going, and the nil
                # LocalId flows to the first caller that touches it -- e.g.
                # `local_mir_type_of(local)` (mir_lowering_stmts.spl:69), whose
                # `local.id` read is a field access on a nil receiver. That
                # traps `runtime error: field access on nil receiver` + ud2
                # (SIGILL, exit 132) BEFORE the accumulated errors are ever
                # flushed, so the operator sees a bare SIGILL and never learns
                # which expression kind was unsupported. Stage-3 self-host died
                # exactly this way (2026-08-04).
                #
                # Mirror what every other "not yet implemented" rejection in
                # this file already does (see the B5b Phase 2 pattern arms in
                # lower_match_case): record the error, hand back a fresh unit
                # temp, and let the driver report the diagnostic normally.
                # `expr_value.span` is only safe to read when the kind is a
                # LIVE boxed enum. When the kind is garbage (a mis-extracted
                # payload, see the breadcrumb block in lower_expr above) the
                # whole node is a wild handle and `.span.file` faults --
                # SIGSEGV inside lower_expr_impl, which is strictly LESS
                # diagnosable than the SIGILL it replaced. Gate every span read
                # on the discriminant probe, which never dereferences.
                val unsupported_disc = rt_enum_discriminant(expr_value.kind)
                if unsupported_disc >= 0:
                    self.error("unsupported MIR expression: {expr_value.kind}", Some(expr_value.span))
                else:
                    self.error_fatal("MIR lowering received a garbage expression handle (mis-extracted enum payload); the producing match arm is upstream", nil)
                # Interpolating the kind alone is not diagnosable: a heap enum
                # renders as an opaque `<enum@0x..>` handle and a value the
                # runtime cannot classify at all renders as `<value:0x..>`
                # (observed on the stage3 self-host lane: 24x
                # `<value:0x1800000007>`, whose low tag bits are 7 -- not int,
                # heap, float or special, i.e. not a live enum at all). Print
                # the runtime discriminant (DefaultHasher(variant-name) & u32,
                # or -1 when the value is not a boxed enum) plus the source
                # location, so the kind can be NAMED and the construct FOUND.
                if unsupported_disc >= 0:
                    eprint("[mir-lower-expr] unsupported-expr-kind kind={expr_value.kind} disc={unsupported_disc} at={expr_value.span.file}:{expr_value.span.line}:{expr_value.span.col}\n")
                else:
                    eprint("[mir-lower-expr] unsupported-expr-kind kind={expr_value.kind} disc=-1 GARBAGE parent_at={mir_lower_parent_expr_file}:{mir_lower_parent_expr_line}:{mir_lower_parent_expr_col} parent_disc={mir_lower_parent_expr_disc}\n")
                var b_unsupported = self.builder
                val t_unsupported = b_unsupported.new_temp(MirType.unit())
                self.builder = b_unsupported
                t_unsupported

    # ========================================================================
    # B5b Phase 1 — MatchCase lowering (integer-literal patterns only)
    # ========================================================================

    me lower_match_case(scrutinee: HirExpr, arms: [HirMatchArm], expected_type: HirType?) -> LocalId:
        """Lower a `match` expression on integer-literal patterns.

        Phase 1 supports:
          - HirPatternKind.Wildcard            (default arm)
          - HirPatternKind.Literal(IntLit n)   (constant int arm)

        Phase 2a (this revision) additionally supports:
          - HirPatternKind.Binding(symbol, _)  (irrefutable default arm
            that also binds the scrutinee to a local symbol; mutability
            flag is irrelevant at MIR-lowering time and is ignored here)
          - HirPatternKind.Or(patterns) when every alternative is
            Literal(IntLit n) (each alternative becomes its own
            int_cases entry pointing at the shared arm body)

        Anything else (Tuple, Array, Struct, Enum, Range, non-IntLit
        Literal, Or with non-IntLit alternatives, or any guard) yields a
        clear diagnostic so users get a real error instead of
        `unsupported MIR expression`.

        Dense int matches (>=4 cases, key-span <= 1024) emit
        MirTerminator.Switch so the backend can produce a jump table; sparse
        / smaller matches fall back to a chained If terminator. The
        scrutinee is evaluated once into a temp to avoid duplicating side
        effects.
        """
        # Bare payload-less variant patterns (`case Green:`) arrive here as
        # HirPatternKind.Binding(symbol, _): the frontend (convert_nodes.spl)
        # cannot tell an unqualified enum-variant name from a genuine capture
        # variable without the enum registry, which only exists here at
        # MIR-lowering time (self.enum_variant_index). Reclassify a Binding
        # arm into an Enum arm ONLY when its symbol's name is registered as a
        # variant of EXACTLY ONE known enum -- a name matching zero enums (a
        # real binding like `case x:`) or 2+ enums (genuinely ambiguous) is
        # left as an ordinary Binding, unchanged, so plain bindings keep
        # working exactly as before.
        var norm_arms: [HirMatchArm] = []
        var norm_i = 0
        while norm_i < arms.len():
            val arm0 = arms[norm_i]
            match arm0.pattern.kind:
                case Binding(bsym, _):
                    var bname = ""
                    val bsym_opt = self.symbols.get_symbol_raw(bsym.id)
                    if val bsym_found = bsym_opt:
                        bname = bsym_found.name
                    # Step (c): owner search over the QUALIFIED keyspace, so two
                    # distinct same-bare-named enums are counted as two owners
                    # (the bare map keeps only the survivor) and a genuinely
                    # ambiguous bare name stops being reclassified as a
                    # unit-variant pattern against the wrong enum. Benign
                    # identical registrations are deduped inside
                    # `variant_owner_keys`, so the ordinary single-owner case is
                    # unchanged.
                    var owner_count = 0
                    if bname != "":
                        owner_count = self.variant_owner_keys(bname).len()
                    if owner_count == 1:
                        val enum_pat = HirPattern(
                            kind: HirPatternKind.Enum(
                                HirType(kind: HirTypeKind.Error, span: arm0.pattern.span),
                                bname,
                                nil
                            ),
                            type_: nil,
                            span: arm0.pattern.span
                        )
                        norm_arms = norm_arms.push(HirMatchArm(
                            pattern: enum_pat,
                            has_guard: arm0.has_guard,
                            guard: arm0.guard,
                            body: arm0.body,
                            span: arm0.span
                        ))
                    else:
                        norm_arms = norm_arms.push(arm0)
                case _:
                    norm_arms = norm_arms.push(arm0)
            norm_i = norm_i + 1

        # Route enum-pattern matches (case Variant(x):) to the enum path, which
        # dispatches on rt_enum_discriminant + binds payloads via rt_enum_payload.
        var has_enum_arm = false
        var scan_i = 0
        while scan_i < norm_arms.len():
            match norm_arms[scan_i].pattern.kind:
                case Enum(_, _, _):
                    has_enum_arm = true
                case _:
                    ()
            scan_i = scan_i + 1
        if has_enum_arm:
            return self.lower_enum_match(scrutinee, norm_arms, expected_type)

        # Phase 1+2a gate: every arm must be (Wildcard | Binding |
        # Literal(IntLit) | Or(of IntLit)) with no guard. If anything else
        # is present, emit a Phase 2 diagnostic naming the offending kind
        # and bail out with a unit temp.
        var int_cases: [(i64, HirBlock)] = []
        var has_default_body = false
        var default_body_value = HirBlock(stmts: [], value: nil, span: scrutinee.span)
        var has_default_binding = false
        var default_binding_value = SymbolId.new(-1)
        var idx = 0
        while idx < arms.len():
            val arm = arms[idx]
            if arm.has_guard:
                # Guard clauses (`case x if cond:`) have no MIR lowering yet
                # (B5b Phase 2). Fail loudly instead of silently: record a
                # compile error AND emit an rt_panic call carrying the same
                # message, so pipelines that drop MirLowering.errors (e.g.
                # the native-build worker's lower_to_mir — see
                # lower_for_iterator in mir_lowering_stmts.spl for the same
                # pattern) still abort with a clear diagnostic instead of
                # emitting an empty function body that crashes the LLVM
                # backend on a dangling SSA reference.
                val guard_unsupported_msg = "match guards (case x if cond:) are not supported by native codegen yet (B5b Phase 2)"
                self.error(guard_unsupported_msg, Some(arm.span))
                var b_err = self.builder
                val panic_msg_local = b_err.emit_const_str(guard_unsupported_msg)
                val panic_func_operand = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_panic"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)))
                ))
                b_err.emit_call(panic_func_operand, [mir_operand_copy(panic_msg_local)], MirType.unit())
                val err_temp = b_err.new_temp(MirType.unit())
                self.builder = b_err
                return err_temp
            match arm.pattern.kind:
                case Wildcard:
                    if has_default_body:
                        self.error(
                            "B5b: match has multiple wildcard arms",
                            Some(arm.span)
                        )
                        var b_err2 = self.builder
                        val err_temp2 = b_err2.new_temp(MirType.unit())
                        self.builder = b_err2
                        return err_temp2
                    has_default_body = true
                    default_body_value = arm.body
                case Literal(lit_expr):
                    match lit_expr.kind:
                        case IntLit(n, _):
                            int_cases = int_cases.push((n, arm.body))
                        case _:
                            self.error(
                                "B5b Phase 2 not yet implemented: pattern kind Literal(non-IntLit)",
                                Some(arm.pattern.span)
                            )
                            var b_err3 = self.builder
                            val err_temp3 = b_err3.new_temp(MirType.unit())
                            self.builder = b_err3
                            return err_temp3
                case Binding(symbol, _):
                    # Phase 2a: irrefutable binding pattern acts like a
                    # wildcard default but also binds the scrutinee to a
                    # local symbol. Mutability flag is ignored at MIR
                    # level (it only matters for borrow-check).
                    if has_default_body:
                        self.error(
                            "B5b: match has multiple wildcard/binding default arms",
                            Some(arm.span)
                        )
                        var b_dup = self.builder
                        val t_dup = b_dup.new_temp(MirType.unit())
                        self.builder = b_dup
                        return t_dup
                    has_default_body = true
                    default_body_value = arm.body
                    has_default_binding = true
                    default_binding_value = symbol
                case Or(sub_patterns):
                    # Phase 2a: Or-of-IntLit alternatives expand into one
                    # int_cases entry per alternative, all pointing at the
                    # same shared arm body. Any non-IntLit sub-pattern
                    # falls through to the Phase 2 diagnostic below.
                    var or_ok = true
                    var oi = 0
                    while oi < sub_patterns.len() and or_ok:
                        val sp = sub_patterns[oi]
                        match sp.kind:
                            case Literal(sp_lit):
                                match sp_lit.kind:
                                    case IntLit(sn, _):
                                        int_cases = int_cases.push((sn, arm.body))
                                    case _:
                                        or_ok = false
                            case _:
                                or_ok = false
                        oi = oi + 1
                    if not or_ok:
                        self.error(
                            "B5b Phase 2 not yet implemented: pattern kind Or with non-IntLit alternatives",
                            Some(arm.pattern.span)
                        )
                        var b_o2 = self.builder
                        val t_o2 = b_o2.new_temp(MirType.unit())
                        self.builder = b_o2
                        return t_o2
                case Tuple(_):
                    self.error(
                        "B5b Phase 2 not yet implemented: pattern kind Tuple",
                        Some(arm.pattern.span)
                    )
                    var b_t = self.builder
                    val t_t = b_t.new_temp(MirType.unit())
                    self.builder = b_t
                    return t_t
                case Array(_, _):
                    self.error(
                        "B5b Phase 2 not yet implemented: pattern kind Array",
                        Some(arm.pattern.span)
                    )
                    var b_a = self.builder
                    val t_a = b_a.new_temp(MirType.unit())
                    self.builder = b_a
                    return t_a
                case Struct(_, _):
                    self.error(
                        "B5b Phase 2 not yet implemented: pattern kind Struct",
                        Some(arm.pattern.span)
                    )
                    var b_s = self.builder
                    val t_s = b_s.new_temp(MirType.unit())
                    self.builder = b_s
                    return t_s
                case Enum(_, _, _):
                    self.error(
                        "B5b Phase 2 not yet implemented: pattern kind Enum",
                        Some(arm.pattern.span)
                    )
                    var b_e = self.builder
                    val t_e = b_e.new_temp(MirType.unit())
                    self.builder = b_e
                    return t_e
                case Range(_, _, _):
                    self.error(
                        "B5b Phase 2 not yet implemented: pattern kind Range",
                        Some(arm.pattern.span)
                    )
                    var b_r = self.builder
                    val t_r = b_r.new_temp(MirType.unit())
                    self.builder = b_r
                    return t_r
                case Error:
                    self.error(
                        "B5b: match arm has Error pattern (parser/HIR error)",
                        Some(arm.pattern.span)
                    )
                    var b_x = self.builder
                    val t_x = b_x.new_temp(MirType.unit())
                    self.builder = b_x
                    return t_x
            idx = idx + 1

        # Phase 1 also requires a wildcard default arm; without one we'd
        # need exhaustiveness analysis (Phase 2). Reject cleanly.
        if not has_default_body:
            self.error(
                "B5b Phase 2 not yet implemented: match without wildcard default arm",
                nil
            )
            var b_nd = self.builder
            val t_nd = b_nd.new_temp(MirType.unit())
            self.builder = b_nd
            return t_nd

        # Evaluate scrutinee once into a temp.
        val scrut_local = self.lower_expr(scrutinee)

        # Decide dense vs sparse. Same heuristic as Rust seed:
        #   arms >= 4 and (max - min) <= 1024  =>  Switch
        #   otherwise                          =>  If chain
        val use_switch = self.should_emit_switch(int_cases)
        val default_binding = if has_default_binding: Some(default_binding_value) else: nil

        if use_switch:
            self.emit_switch_dispatch(scrut_local, int_cases, default_body_value, default_binding, expected_type)
        else:
            self.emit_if_chain_dispatch(scrut_local, int_cases, default_body_value, default_binding, expected_type)
