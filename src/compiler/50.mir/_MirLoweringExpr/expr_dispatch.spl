# MIR Lowering - Expression Lowering
#
# Expression lowering from HIR to MIR:
# - Literal lowering (int, float, bool, string, nil, unit)
# - Variable references
# - Binary/unary operators (including special pipeline/compose/parallel)
# - Function calls (direct and indirect)
# - Method calls (instance, trait, static, free function / UFCS)
# - Array, tuple, set, and constant expression lowering
# - Field access
use compiler.frontend.core.types.{custom_primitive_underlying_type_tag_by_symbol, custom_primitive_underlying_type_tag_by_name}

use compiler.mir.mir_data.*
use compiler.mir._MirLoweringExpr.function_signature_owner.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.blocks.value.BlockValue
use compiler.mir.mir_instructions.{MirPlace}
use compiler.mir.mir_lowering_types.{MirLowering, MirError}
use compiler.backend.gpu_intrinsics.{is_gpu_intrinsic}
use compiler.mir.mir_types.{MirType}
use compiler.mir.mir_types.{LocalId}  # explicit: a glob is not an import-origin for surface projection
use std.io_runtime.{env_get_opt}

# std.alloc.sffi only exists in the seed lib tree; the stage4 strict lane
# cannot resolve it — declare the runtime extern directly.
@unsafe(reason: "raw tagged-enum discriminant projection ABI", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64
@unsafe(reason: "raw tagged-enum borrowed payload projection ABI", capabilities: [ffi])
extern fn rt_enum_payload<T>(value: T) -> i64
@unsafe(reason: "raw tagged-tuple indexed borrowed value projection ABI", capabilities: [ffi])
extern fn rt_tuple_get<T>(tuple: i64, index: i64) -> T?

@always_inline
fn _sffi_enum_discriminant<T>(value: T) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

@always_inline
fn _sffi_enum_payload<T>(value: T) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_payload(value)

@always_inline
# Returns nil for an absent optional payload slot (e.g. HirExprKind.If's
# `else` block, HirExprKind.IfChain's trailing else). The non-optional
# `-> Any` form made every such read a hard `nil is forbidden by the
# non-optional return contract` semantic error, so ANY `if` without an
# `else` failed native-build in the pure-Simple MIR lowerer.
fn _sffi_tuple_get<T>(tuple: i64, index: i64) -> T?:
    unsafe(capabilities: [ffi]):
        rt_tuple_get<T>(tuple, index)

# Unset and explicitly-empty environment values are both disabled through the
# canonical nullable owner.
@always_inline
fn folded_global_scalar_type(constant: MirConstant) -> MirType:
    """Canonical scalar type shared by inline reads and address storage.

    Module level, not class scope: a class-scope plain `fn` is not visible to
    sibling `me` methods on the whole-program native path (cause D of
    doc/08_tracking/bug/coverage_wrapper_undefined_identifier_clusters_2026-08-31.md).
    This takes no `self`, so hoisting is behaviour-identical; the underlying
    resolver question stays open in that record.
    """
    match constant.value:
        case Str(_): MirType(kind: MirTypeKind.Opaque("str"))
        # Const Bool is rendered in the raw i64 value lane today.
        case Bool(_): MirType.i64()
        case _: constant.type_

fn mir_expr_env_get(key: text) -> text?:
    env_get_opt(key)

fn mir_exception_type_tag(type_: HirType?) -> i64:
    """Stable, allocation-free tags for catchable runtime types.

    Composite structural types remain untagged until the runtime-frame ABI can
    carry a collision-free canonical identity; returning zero makes lowering
    reject those typed catches instead of selecting them unsoundly.
    """
    val optional_type: HirType? = type_
    if optional_type == nil:
        return 0
    if val present_type = optional_type:
        val concrete_type: HirType = present_type
        match concrete_type.kind:
            case HirTypeKind.Int(bits, signed): 100000 + bits * 2 + (if signed: 1 else: 0)
            case HirTypeKind.Float(bits): 200000 + bits
            case HirTypeKind.Bool: 300001
            case HirTypeKind.Char: 300002
            case HirTypeKind.Str: 300003
            case HirTypeKind.Unit: 300004
            case HirTypeKind.Named(symbol, _): 1000000000 + symbol.id
            case HirTypeKind.DynTrait(symbol): 2000000000 + symbol.id
            case _: 0
    else:
        0

# ----------------------------------------------------------------------------
# Garbage-HirExpr breadcrumb (stage-3 self-host blocker #8, 2026-08-05)
#
# An unguarded qualified enum payload match can bind a payload extracted from
# the WRONG variant -- the header word is handed back as if it were the
# payload pointer, so a child HirExpr comes out GARBAGE (the recurring
# 0x1800000007 bit pattern; see hir_lowering/expressions.spl:1777 for the same
# class caught on the flat bridge). rt_enum_discriminant is a pure registry
# membership test (runtime_native.c rt_core_as_enum: pointer comparison, never
# a deref), so it is SAFE on a garbage handle and returns -1 for anything that
# is not a live boxed enum. That gives a cheap, non-faulting detector.
#
# The breadcrumb records the PARENT expression that lower_expr_impl was
# dispatching when a garbage child was handed down, so the producing match arm
# can be named from its source location instead of guessed.
var mir_lower_parent_expr_file: text = ""
var mir_lower_parent_expr_line: i64 = -1
var mir_lower_parent_expr_col: i64 = -1
var mir_lower_parent_expr_disc: i64 = -1
var mir_lower_garbage_expr_count: i64 = 0
var mir_lower_garbage_debug_state: i64 = -1
# Cached MIR lower-expr trace gate (-1 unknown, 0 off, 1 on). Default OFF.
var mir_lower_expr_trace_state: i64 = -1
var mir_lower_expr_trace_generation: i64 = -1
var mir_lower_disc_table_dumped: bool = false

pub fn mir_lower_garbage_expr_count_value() -> i64:
    mir_lower_garbage_expr_count

# Pure env read. The RESULT is cached into mir_lower_garbage_debug_state by
# lower_expr (a method), not here: module-level `var` mutation from a
# module-level `fn` is not a shape this tree exercises, whereas mutation from a
# method body is (mir_bounds_check_bailout_count above). Caching matters because
# this gate sits on the hottest path in MIR lowering -- every expression node.
fn mir_lower_garbage_debug_enabled() -> bool:
    (mir_expr_env_get("SIMPLE_MIR_GARBAGE_EXPR_DEBUG") ?? "") == "1"

# SF1 (d), 2026-07-28: bounds-check lowering used to bail out SILENTLY when
# the indexed base type exposes no len symbol — the access then ran with no
# check at all and nothing recorded the gap. Count every bailout so the gap
# is measurable, and surface it under SIMPLE_MIR_BOUNDS_DEBUG=1.
var mir_bounds_check_bailout_count: i64 = 0

pub fn mir_bounds_check_bailouts() -> i64:
    """Number of indexed accesses lowered WITHOUT a bounds check because the
    base type had no len symbol (see emit_bounds_check_for_index)."""
    mir_bounds_check_bailout_count

fn mir_expr_symbol_id_value(symbol: SymbolId) -> i64:
    symbol.id

# True when a HIR operand's static type is an unsigned integer (u8/u16/u32/u64).
# Consulted at the mixed int/float comparison-promotion site so a u64 operand
# whose MIR local type was flattened to I64 still promotes via an UNSIGNED
# int->float convert (bug
# u64_to_f64_comparison_uses_signed_conversion_2026-07-25). Defaults to false
# (signed) when the HIR type is absent — matches the prior always-signed path.
fn hir_expr_static_unsigned(e: HirExpr) -> bool:
    if e == nil:
        return false
    if not e.has_type_:
        return false
    val t = e.type_
    if t == nil:
        return false
    match t.kind:
        case HirTypeKind.Int(_bits, signed):
            not signed
        case _:
            false

fn hir_type_has_unresolved_type_param(ty: HirType) -> bool:
    """True when `ty` still carries a bare, uninstantiated `TypeParam`
    anywhere in its structure (shallow recursion through the composite type
    shapes; a `Named(sym, args)`'s own type ARGUMENTS are checked, not its
    definition). Used by `try_lower_function_value` to refuse lowering a
    generic/unresolved function signature to a concrete MIR FuncPtr rather
    than silently guessing a wrong ABI for it."""
    match ty.kind:
        case HirTypeKind.TypeParam(_, _): true
        case HirTypeKind.Array(elem, _): hir_type_has_unresolved_type_param(elem)
        case HirTypeKind.Slice(elem): hir_type_has_unresolved_type_param(elem)
        case HirTypeKind.Optional(inner): hir_type_has_unresolved_type_param(inner)
        case HirTypeKind.Ref(inner, _): hir_type_has_unresolved_type_param(inner)
        case HirTypeKind.Ptr(inner, _): hir_type_has_unresolved_type_param(inner)
        case HirTypeKind.Dict(key, value):
            hir_type_has_unresolved_type_param(key) or hir_type_has_unresolved_type_param(value)
        case HirTypeKind.Result(ok, err):
            hir_type_has_unresolved_type_param(ok) or hir_type_has_unresolved_type_param(err)
        case HirTypeKind.Tuple(elements):
            var i = 0
            var found = false
            while i < elements.len() and not found:
                found = hir_type_has_unresolved_type_param(elements[i])
                i = i + 1
            found
        case HirTypeKind.Function(params, ret, _):
            var found = hir_type_has_unresolved_type_param(ret)
            var i = 0
            while i < params.len() and not found:
                found = hir_type_has_unresolved_type_param(params[i])
                i = i + 1
            found
        case HirTypeKind.Named(_, args):
            var i = 0
            var found = false
            while i < args.len() and not found:
                found = hir_type_has_unresolved_type_param(args[i])
                i = i + 1
            found
        case _: false

# ============================================================================
# Expression Lowering
# ============================================================================

impl MirLowering:
    me begin_expr_trace_session():
        """Snapshot the process trace policy for one module-lowering session.

        A compiler process may service several builds with different trace
        switches. Refreshing here prevents the module-global hot-path cache
        from leaking the first build's policy into later in-process builds.
        """
        if mir_trace_enabled():
            mir_lower_expr_trace_state = 1
        else:
            mir_lower_expr_trace_state = 0

    # mutglobal2 lane (module-level `var`/`val` mutation end-to-end, see
    # scratchpad/mutglobal_plan.md + scratchpad/mutglobal2 report). The prior
    # lane gave `MirModule.statics`/`LoadGlobal`/`StoreGlobal` real backend
    # support (module_lowering.spl + core_codegen.spl), but nothing on this
    # path ever READ a module global -- `Var`/`NamedVar` below only consult
    # `self.local_map` (the current function's SSA locals) and error
    # "undefined variable" the moment a module-scope binding is referenced.
    # `global_static_ids`/`global_const_ids` (populated once per module, in
    # function_lowering.spl's `lower_const`, BEFORE any function body is
    # lowered -- see module_lowering.spl's reordered `lower_module`) now
    # carry that information. Returns `Some(local)` when `symbol_id` names a
    # known module-level binding, `nil` otherwise (falls through to the
    # existing "undefined variable" error, unchanged for every non-global
    # case). A mutable `var` gets a real `LoadGlobal` off the backend's
    # `@g_name` storage; an immutable `val` has no storage at all (see
    # `lower_static`'s `is_mutable` gate) so its read is inlined as an
    # ordinary `Const`, mirroring the existing OUTPUT_LIMIT/
    # DEFAULT_TIMEOUT_MS hardcoded-name special cases below but general
    # (driven by the registry, not a literal name match).
    # Module symbol id -> the `MirStatic` entry from `self.builder.module.
    # statics` whose `.symbol.id` matches, `nil` if `symbol_id` isn't a
    # mutable module-level `var`. The i64-keyed mirror avoids the seed's
    # struct-keyed SymbolId lookup defect without allocating `.values()`.
    # Shared by the read hook below and
    # mir_lowering_stmts.spl's write hook (StoreGlobal needs the same type
    # for a compound `g += y` assignment's LoadGlobal-and-combine sequence).
    me find_global_static(symbol_id: i64) -> MirStatic?:
        if self.global_statics_by_id.contains(symbol_id):
            return Some(self.global_statics_by_id[symbol_id])
        nil

    me materialize_folded_global_static_for_address(symbol_id: i64) -> MirStatic?:
        """Give an address-taken folded module `val` canonical storage.

        Ordinary immutable reads remain inlined. Storage is created lazily
        only for the rare unsafe reference operation, avoiding global-data
        growth for constants whose address is never observed.
        """
        if not self.global_constants_by_id.contains(symbol_id):
            return nil
        if not self.global_const_exprs.contains(symbol_id):
            # Only local lower_const records an initializer here, before its
            # folded value. Provider imports record values without foreign HIR
            # expressions. This existing origin map authorizes local storage;
            # imported HIR visibility (always Public) cannot establish ownership.
            self.error_fatal("imported inline constant has no addressable provider storage; export an addressable binding", nil)
            return nil
        val constant: MirConstant = self.global_constants_by_id[symbol_id]
        # The scalar-type helper is module-level. Resolve its defining function
        # directly for both ordinary reads and address-backed storage.
        val corrected_type = folded_global_scalar_type(constant)
        var owner = self.builder.module.name
        var visibility = Visibility.Private
        if val symbol_info = self.symbols.get_symbol_raw(symbol_id):
            visibility = symbol_info.visibility
            if val defining_module = symbol_info.defining_module:
                if defining_module != "": owner = defining_module
        val link_name = mir_global_storage_name(owner, constant.name)
        val corrected_constant = MirConstant(
            symbol: constant.symbol, name: constant.name,
            type_: corrected_type, value: constant.value)
        val static_ = MirStatic(
            symbol: constant.symbol,
            name: link_name,
            type_: corrected_type,
            init: Some(corrected_constant),
            is_mutable: false,
            alignment: corrected_type.alignment(),
            visibility: visibility
        )
        var b = self.builder
        var module_ = b.module
        var statics = module_.statics
        statics[constant.symbol] = static_
        module_.statics = statics
        b.module = module_
        self.builder = b
        self.global_statics_by_id[symbol_id] = static_
        Some(static_)

    me try_lower_global_addr(operand: HirExpr, mutable: bool) -> LocalId?:
        """Lower a resolved module-static identifier without first loading it."""
        var symbol_id = -1
        match operand.kind:
            case Var(symbol): symbol_id = mir_expr_symbol_id_value(symbol)
            case NamedVar(symbol, _): symbol_id = mir_expr_symbol_id_value(symbol)
            case _: return nil
        # Resolved local identity wins, preserving lexical shadowing exactly.
        if symbol_id < 0 or self.find_local(symbol_id).id >= 0:
            return nil
        if not self.global_symbol_ids.contains(symbol_id):
            return nil
        var static_ = self.find_global_static(symbol_id)
        if not static_.?:
            static_ = self.materialize_folded_global_static_for_address(symbol_id)
        if not static_.?:
            return nil
        val target = static_.unwrap()
        self.ensure_imported_global_initialized(symbol_id)
        var b = self.builder
        val dest = b.emit_global_addr(target.symbol, target.type_, mutable)
        self.builder = b
        Some(dest)

    # B2 (bug cranelift_native_aggregate_return_nil_receiver_hosted_wm_
    # 2026-07-26): 952d2ca34d7's re-lowering fallback at the bottom of
    # `try_lower_global_read` is sound ONLY for a never-mutated binding --
    # its own argument is "every reference constructing an equal, independent
    # value is observationally identical to sharing one" (see
    # `global_const_exprs`, mir_lowering_types.spl). A module-level `var` of
    # ARRAY type violates that end to end: `lower_static`
    # (module_lowering.spl) declines to emit a `MirStatic` for an array type,
    # so the write hook (`lower_assign_var`, mir_lowering_stmts.spl) finds no
    # backing static and silently degrades the store to a function-local SSA
    # copy, while every read re-builds the ORIGINAL initializer -- the
    # mutation is dropped and the program reads the initial value forever
    # (`module=0` in the freestanding RCA). 952d2ca34d7 turned what used to be
    # a loud "undefined variable" error into silent data loss; this restores
    # the noise.
    #
    # Declared mutability is used as the "is ever assigned" marker on purpose.
    # It is a superset of the true answer, and unlike the write hook's
    # `find_global_static`-returns-nil marker it is available at the FIRST
    # read, independent of the order functions happen to be lowered in (a read
    # lowered before the mutating function would otherwise never be flagged).
    # It also covers index-assignment (`G[i] = v`), whose base read comes
    # through this same path.
    #
    # Reported once per symbol. Loud by default, promoted to a hard lowering
    # error by `SIMPLE_STRICT_ARRAY_GLOBALS=1`, so a build can be made to fail
    # instead of corrupting at runtime. NOT a hard error by default because
    # the tree still carries many module-level `var` array bindings written
    # against the old silent behaviour; flipping the default belongs with the
    # real fix (null-init static slots + backend module-init wiring).
    me report_mutable_array_global(symbol_id: i64):
        if self.array_global_mutation_warned.contains(symbol_id):
            return
        var is_mutable = false
        var type_is_array = false
        var global_name = "<unnamed>"
        if val global_symbol = self.symbols.get_symbol_raw(symbol_id):
            is_mutable = global_symbol.is_mutable
            global_name = global_symbol.name
            if val declared_type = global_symbol.type_:
                match declared_type.kind:
                    case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                        type_is_array = true
                    # rationale: only array/slice globals are unrepresentable
                    # as a MirStatic; every other declared type either folds
                    # to a scalar constant or gets real `@g_name` storage.
                    case _:
                        ()
        if not is_mutable:
            return
        if not type_is_array:
            return
        self.array_global_mutation_warned[symbol_id] = true
        val message = "mutable array-typed module global '{global_name}' has no backing static: its initializer is re-lowered at every read and writes to it are dropped (bug cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26)"
        print "[mir-lower] WARNING: {message}"
        if (mir_expr_env_get("SIMPLE_STRICT_ARRAY_GLOBALS") ?? "") == "1":
            self.error(message, nil)

    me try_lower_global_read(symbol_id: i64) -> LocalId?:
        # Imported callable values can observe provider globals when invoked
        # indirectly; initialize their provider before publishing the value.
        self.ensure_imported_global_initialized(symbol_id)
        if not self.global_symbol_ids.contains(symbol_id):
            return nil
        # Mutable (`var`) case first: real storage, backed by a LoadGlobal
        # off the @g_name the backend emits for this MirModule.statics entry.
        if val static_ = self.find_global_static(symbol_id):
            var b_glob = self.builder
            val dest = b_glob.new_temp(static_.type_)
            b_glob.emit(MirInst(kind: MirInstKind.LoadGlobal(dest, static_.symbol), span: nil))
            self.builder = b_glob
            # Storage may be an i64 handle while the declaration is a Dict or
            # array. Keep semantic provenance on the loaded receiver/iterable.
            if val global_symbol = self.symbols.get_symbol_raw(symbol_id):
                if val declared_type = global_symbol.type_:
                    self.remember_local_hir_type(dest.id, declared_type, 0, 0)
                    match declared_type.kind:
                        case HirTypeKind.Dict(_, _):
                            self.runtime_dict_locals[dest.id] = true
                            self.mark_runtime_value_local(dest.id)
                        case HirTypeKind.Array(global_elem_type, _) | HirTypeKind.Slice(global_elem_type):
                            self.runtime_array_locals[dest.id] = true
                            self.mark_runtime_value_local(dest.id)
                            # A `[Struct]` global must carry its element struct
                            # name exactly like a `[Struct]` parameter/let local
                            # (function_lowering.spl param registration): without
                            # it `var s = _slots[i]` decodes to a nameless word,
                            # `s.field` cannot resolve the owner struct, and a
                            # `for x in s.items` over a declared `[T]` field falls
                            # into the #143 non-array fallback.
                            match global_elem_type.kind:
                                case HirTypeKind.Named(global_elem_symbol, _):
                                    # Presence alone does not unwrap HirSymbol?: the
                                    # .name read needs the concrete payload (same
                                    # ABI defect class as 4710b22a991).
                                    if val present_global_elem = self.symbols.get_symbol_raw(global_elem_symbol.id):
                                        val global_elem: HirSymbol = present_global_elem
                                        self.array_element_struct_syms[dest.id] = global_elem.name
                                case _: ()
                        case _: ()
            # Register struct provenance for the loaded local, mirroring every
            # other struct-value-producing site (mir_lowering_stmts.spl:291,
            # method_calls_literals.spl:537, etc). Every other such site
            # registers `struct_value_syms` so `resolve_field_index`'s first
            # (name-keyed) lookup can succeed without depending on HIR type
            # inference; this global-read path did not. Tested via
            # SIMPLE_MIR_FIELD_TRACE=1 against a minimal @repr("C") global
            # struct probe: the HIR-type-annotation fallback in
            # resolve_field_index already resolves this case correctly on the
            # x86_64 JIT host, so this omission is NOT confirmed as the cause
            # of the aarch64 field-misread defect (see the 2026-08-07 entry in
            # doc/08_tracking/bug/aarch64_real_firmware_boot_gap_and_seed_defects_2026-07-14.md
            # for the full discriminating test and the surviving candidates).
            # Landed anyway as a genuine, low-risk provenance-consistency gap.
            match static_.type_.kind:
                case Struct(struct_sym):
                    # lower_type(Named) emits canonical MIR IDs, which do not
                    # exist in the HIR symbol table. Resolve that namespace and
                    # retain qualified class identities for method dispatch.
                    val global_struct_name = self.mir_struct_symbol_name(struct_sym)
                    if global_struct_name != "":
                        self.struct_value_syms[dest.id] = global_struct_name
                case _: ()
            return Some(dest)
        # Immutable (`val`) case: no real storage (lower_static gates on
        # is_mutable) -- inline the folded constant value/type instead, the
        # same way the existing OUTPUT_LIMIT/DEFAULT_TIMEOUT_MS hardcoded
        # cases already do via `emit_const`. Restricted to SCALAR constant
        # kinds (Int/Float/Bool/Str/Zero) deliberately: `emit_const`'s
        # backend (`translate_const_value`, core_codegen.spl) only renders a
        # scalar LLVM literal -- it is not the same lowering strategy as a
        # real array/struct's runtime construction (`lower_array_lit`'s
        # rt_array_new-based heap allocation), so inlining a compound value
        # through it produced a bad LLVM constant and crashed at runtime
        # (SIGSEGV, confirmed empirically with `val SIZES = [10,20,30]`).
        if self.global_constants_by_id.contains(symbol_id):
            val mir_const: MirConstant = self.global_constants_by_id[symbol_id]
            var is_scalar = false
            match mir_const.value:
                case Int(_): is_scalar = true
                case FloatLexeme(_): is_scalar = true
                case Float(_): is_scalar = true
                case Bool(_): is_scalar = true
                case Str(_): is_scalar = true
                case Zero: is_scalar = true
                case _: is_scalar = false
            if is_scalar:
                # Derive the dest type from the VALUE kind, not
                # mir_const.type_: an unannotated module `val NAME = "s"`
                # carries Infer->i64 as its lowered type while the backend
                # renders the Str value as a ptr GEP -- inlining with the
                # i64 type then routes interpolation down the numeric
                # renderer and llc rejects `'%lN' defined with type 'ptr'
                # but expected 'i64'` (native_module_val_globals
                # 2026-07-23). The helper is also the address-storage owner.
                val const_read_ty = folded_global_scalar_type(mir_const)
                var b_const_read = self.builder
                val const_dest = b_const_read.new_temp(const_read_ty)
                b_const_read.emit_const(const_dest, mir_const.value, const_read_ty)
                self.builder = b_const_read
                return Some(const_dest)
            # Compound values fall through to global_const_exprs below.
        # array_global_2026-07-25: fallback for a COMPOUND immutable module
        # `val` (Array/Tuple/Struct/...), reached either because the loop
        # above found a non-scalar `mir_const` match, or -- more commonly --
        # because `lower_const_expr` (function_lowering.spl's `lower_const`)
        # could not fold the initializer AT ALL (confirmed empirically: an
        # ArrayLit like `[2, 3]` returns nil from `lower_const_expr` on this
        # path, so `module.constants` never got an entry for this symbol in
        # the first place -- the earlier code comment claiming it "folds
        # fine at the MIR-constant level" did not hold up under test).
        # `global_const_exprs` (populated unconditionally by `lower_const`,
        # regardless of whether folding succeeded -- see its doc comment in
        # mir_lowering_types.spl) carries the ORIGINAL HIR initializer
        # expression; re-lower it fresh at this reference site, exercising
        # the real array/struct construction path (`lower_array_lit`'s
        # rt_array_new-based heap allocation) exactly as if the literal were
        # written inline at the use site (already proven to work). Safe
        # because the binding is immutable: every reference constructing an
        # independent equal value is observationally identical to sharing
        # one. Falls through to the existing `nil` -> "undefined variable"
        # error only if no initializer expr was recorded (should not happen
        # once `lower_const` has run for this symbol).
        if self.global_const_exprs.contains(symbol_id):
            # B2: the "immutable, so re-lowering is observationally identical"
            # premise above does NOT hold for a mutable array global -- say so
            # loudly (and fail the build under SIMPLE_STRICT_ARRAY_GLOBALS=1)
            # instead of quietly emitting code that drops every write. See
            # `report_mutable_array_global`.
            self.report_mutable_array_global(symbol_id)
            val hir_init = self.global_const_exprs[symbol_id]
            return Some(self.lower_expr(hir_init))
        nil

    me try_lower_function_value(symbol_id: i64, span: Span) -> LocalId?:
        """A bare `Var`/`NamedVar` reference to a top-level FUNCTION symbol
        used as a first-class VALUE (not called), e.g. a struct field
        initializer `Port(current_owner_fn: unavailable_owner)` or a local
        `val f = some_helper`. `try_lower_global_read` only recognizes
        static/const globals, and the Var/NamedVar dispatch had no other
        fallback, so this case fell straight to the "undefined variable"
        error path and produced a `Const(Int(0))` placeholder -- the
        function's own symbol was never referenced, so the field silently
        held a null function pointer instead of the intended callable value
        (P3, undefined-symbol audit `stage2_cli_link_undefined.md`: a local
        `fn` used as a value must be emitted/referenced by the right symbol).

        Deliberately resolves by the ALREADY-BOUND `symbol_id` the HIR node
        carries -- never by re-looking the name up in the symbol table (that
        was `named_function_operand`'s approach, and this codebase has real
        same-named overload sets, see `is_known_top_level_function`'s doc:
        "JIT call sites resolve by exact arg-type match ... falling back to
        the last definition when types are ambiguous"). A name-based re-
        lookup here could silently pick the WRONG overload; using the
        resolver's own binding cannot.

        Refuses (loud compiler error, no guess) rather than emit a wrong
        function pointer when the symbol's type is not a single concrete
        `HirTypeKind.Function` signature -- e.g. an unresolved/generic
        function whose parameter or return type still carries a bare
        `TypeParam` (see `hir_type_has_unresolved_type_param`). The previous
        version of this fix used a blanket `FuncPtr([] -> i64)` signature for
        every case, which is wrong ABI for any function that takes/returns
        anything other than one `i64`.
        """
        val optional_sym: HirSymbol? = self.symbols.get_symbol_raw(symbol_id)
        if optional_sym == nil:
            return nil
        if val present_sym = optional_sym:
            val sym: HirSymbol = present_sym
            match sym.kind:
                case SymbolKind.Function | SymbolKind.Method: ()
                case _: return nil
            val declared_resolved = SymbolId(id: symbol_id)
            if not self.is_known_top_level_function(sym.name, declared_resolved):
                return nil
            if sym.type_ == nil:
                self.error("cannot lower '{sym.name}' as a function value: no resolved function type", Some(span))
                var b_no_ty = self.builder
                val no_ty_tmp = b_no_ty.emit_const_int(0)
                self.builder = b_no_ty
                return Some(no_ty_tmp)
            var mir_params: [MirType] = []
            var mir_ret = MirType.i64()
            var is_concrete_function_type = false
            # Guard above returns in the nil arm; bind concrete via if val
            # (never unwrap — Poll.unwrap mis-dispatch is documented above).
            val fn_type: HirType = if val t = sym.type_: t else: HirType(kind: HirTypeKind.Error, span: span)
            match fn_type.kind:
                case HirTypeKind.Function(params, ret, _):
                    if hir_type_has_unresolved_type_param(ret):
                        is_concrete_function_type = false
                    else:
                        var all_params_concrete = true
                        for param in params:
                            if hir_type_has_unresolved_type_param(param):
                                all_params_concrete = false
                            mir_params = mir_params.push(self.lower_type(param))
                        mir_ret = self.lower_type(ret)
                        is_concrete_function_type = all_params_concrete
                case _: ()
            if not is_concrete_function_type:
                self.error("cannot lower generic or unresolved function '{sym.name}' as a value here; instantiate a concrete signature first", Some(span))
                var b_generic = self.builder
                val generic_tmp = b_generic.emit_const_int(0)
                self.builder = b_generic
                return Some(generic_tmp)
            val callable_name = self.provider_callable_symbol_name(declared_resolved, sym.name)
            val fn_operand = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str(callable_name),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: mir_params, return_type: mir_ret, is_variadic: false)))
            ))
            var b_fn = self.builder
            val fn_local = b_fn.emit_cast(fn_operand, MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: mir_params, return_type: mir_ret, is_variadic: false))))
            self.builder = b_fn
            Some(fn_local)
        else:
            nil

    fn local_is_runtime_array(local: LocalId) -> bool:
        # EXPLICIT DISCRIMINANTS, not `match` -- mirrors local_is_runtime_dict
        # just below, which already uses this form.
        # Measured on the Stage-2 native lane: `q + s` where both are text
        # lowered to `call i8 @rt_array_extend_i64(...)` instead of
        # `rt_strcat_tagged`, and the runtime then reported "rejected invalid
        # array handle before dereference; probable compiler/FFI ABI mismatch".
        # A literal operand (`p + "X"`) lowered correctly to rt_strcat_tagged,
        # which is why concat appeared to work only for literals and why every
        # char-accumulation loop silently produced "".
        # The array-concat branch is tested BEFORE the string-concat branch, so
        # a text local mis-answering this predicate hijacks the whole
        # expression. The `match` arms mis-dispatch on this lane (four other
        # instances fixed today), letting a Str kind reach `case Array`.
        # Comparing discriminants does not depend on arm binding.
        if self.runtime_array_locals.contains(local.id): return true
        if val type_ = self.builder.local_type(local):
            val lira_disc = _sffi_enum_discriminant<MirTypeKind>(type_.kind)
            if lira_disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Array(MirType.i64(), 0)):
                return true
            if lira_disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Slice(MirType.i64())):
                return true
            return false
        false

    fn runtime_dict_value_mir_type(container_type: MirType) -> MirType?:
        # A borrowed Dict parameter carries the same runtime handle as Dict.
        # Keep Ref in the signature/ownership metadata; unwrap only this
        # collection view, never arbitrary Ptr or Ref(Array) values.
        var dict_type = container_type
        if _sffi_enum_discriminant<MirTypeKind>(dict_type.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Ref(MirType.i64(), false)):
            match dict_type.kind:
                case MirTypeKind.Ref(inner, _): dict_type = inner
                case _: ()
        if _sffi_enum_discriminant<MirTypeKind>(dict_type.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Dict(MirType.i64(), MirType.i64())):
            match dict_type.kind:
                case MirTypeKind.Dict(_, value_type): return Some(value_type)
                case _: ()
        nil

    fn runtime_dict_value_hir_type(container_type: HirType) -> HirType?:
        var dict_type = container_type
        match dict_type.kind:
            case HirTypeKind.Ref(inner, _): dict_type = inner
            case _: ()
        match dict_type.kind:
            case HirTypeKind.Dict(_, value_type): Some(value_type)
            case _: nil

    fn local_is_runtime_dict(local: LocalId) -> bool:
        if self.runtime_dict_locals.contains(local.id):
            return true
        if val type_ = self.builder.local_type(local):
            return _sffi_enum_discriminant(type_.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Dict(MirType.i64(), MirType.i64()))
        false
    fn noted_runtime_elem_type(container_local: LocalId) -> MirType?:
        """Nil-discriminating read of the store-observed element/value note.

        `runtime_elem_value_type` is a `Dict<i64, MirType>` held in a CLASS
        FIELD, and every consumer used to spell the read as the documented
        `contains(k)` + `d[k]` idiom (doc/07_guide/language/dict_native_pitfalls.md).
        On the self-hosted native backend that idiom is NOT sound for this
        receiver shape, and the two halves fail together:

        1. `.contains(k)` on a Dict-typed CLASS FIELD receiver does not reach
           `rt_dict_contains`. The field projection carries no HIR type and its
           MIR temp is typed i64, so `receiver_is_dict` stays false, the
           `local_is_runtime_dict` probe misses, and the call falls into the
           string-only arity-1 arm of `method_calls_literals.spl` — it is
           emitted as `lib.common.text.contains` with the dict handle passed as
           a text pointer. PROVED by disassembly of the stage-2 compiler:
           `lower_dict_runtime_read+633: call <lib__common__text__contains>`.
           The answer it returns is unrelated to key presence, so a MISS can
           report present. (Tracked separately — same silent-wrong-answer family
           as the array-receiver `contains`/`find`/`rfind` misroute already
           documented at method_calls_literals.spl:1847.)
        2. The following `d[k]` read of a MISSING key returns the tagged nil
           sentinel `3`, not a struct handle. Every consumer then read `.kind`
           off it; untagging `3` yields address `0` and the load SIGSEGVs, so
           the compiler DIED instead of reporting the real diagnostic (the
           `unresolved type:` cascade a `--source`-less native-build produces).

        Guarding key presence therefore cannot be trusted; the RESULT must be
        discriminated. `!= nil` lowers to `rt_native_neq(value, 3)`, which is
        exactly the sentinel test the miss produces. Callers get `nil` and keep
        their pre-existing default, so a lost note degrades a type refinement —
        never a crash, and never a silently different value.
        """
        if not self.runtime_elem_value_type.contains(container_local.id):
            return nil
        val noted = self.runtime_elem_value_type[container_local.id]
        if noted == nil:
            return nil
        Some(noted)

    fn generic_field_param_name(owner: text, field_idx: i64) -> text:
        """Name of the type parameter field `field_idx` of `owner` is declared
        as (`a: A`), "" for every other field."""
        if not self.struct_field_type_param.has(owner):
            return ""
        val markers = self.struct_field_type_param[owner]
        if field_idx < 0 or field_idx >= markers.len():
            return ""
        val name: text = markers[field_idx]
        name

    fn generic_field_is_over_param(owner: text, field_idx: i64) -> bool:
        """True for a field whose declared type holds a type parameter inside
        a container (`items: [T]`, `first: T?`)."""
        if not self.struct_field_over_type_param.has(owner):
            return false
        val flags = self.struct_field_over_type_param[owner]
        if field_idx < 0 or field_idx >= flags.len():
            return false
        val flag: bool = flags[field_idx]
        flag

    fn instance_field_stamp(expr_value: HirExpr) -> HirType?:
        """The type of a generic-struct field read at its INSTANCE, when the
        expression carries one that is fully instantiated (no type parameter,
        nothing unknown). 40.mono writes it; a stamp that still mentions a
        parameter is the declaration and answers nothing."""
        if not expr_value.has_type_:
            return nil
        val stamped = expr_value.type_
        if stamped == nil:
            return nil
        val st: HirType = stamped
        match st.kind:
            case HirTypeKind.Error: return nil
            case HirTypeKind.Any: return nil
            case HirTypeKind.Infer(_, _): return nil
            case _: ()
        if self.hir_type_mentions_type_param(st, self.symbols):
            return nil
        stamped

    me instance_field_mir_type(field_hir: HirType) -> (MirType, text):
        """MIR type of a generic-struct field at its instance type, and the
        struct name the value holds ("" when it is not a struct)."""
        var mt = self.lower_type(field_hir)
        var nested = ""
        match field_hir.kind:
            case HirTypeKind.Str:
                mt = MirType(kind: MirTypeKind.Opaque("str"))
            case HirTypeKind.Array(elem, _):
                mt = MirType(kind: MirTypeKind.Array(self.lower_type(elem), 0))
            case HirTypeKind.Named(arg_sym, _):
                if val present_arg_symbol = self.symbols.get_symbol_raw(arg_sym.id):
                    val arg_symbol: HirSymbol = present_arg_symbol
                    nested = arg_symbol.name
            case _:
                ()
        (mt, nested)

    me mark_instance_field_local(result: LocalId, field_hir: HirType):
        """Runtime-shape marks for a field local typed by its instance: the
        same ones a declared `[E]` / `E?` / Dict field gets from its
        declaration."""
        match field_hir.kind:
            case HirTypeKind.Array(elem, _):
                self.mark_instance_array_local(result, elem)
            case HirTypeKind.Slice(selem):
                self.mark_instance_array_local(result, selem)
            case HirTypeKind.Optional(_):
                self.option_value_locals[result.id] = true
                self.mark_runtime_value_local(result.id)
            case HirTypeKind.Dict(_, _):
                self.runtime_dict_locals[result.id] = true
                self.mark_runtime_value_local(result.id)
            case _:
                ()

    me mark_instance_array_local(result: LocalId, elem: HirType):
        # Element identity: a struct/class name, the array sentinel when the
        # element is itself an array, nothing for a scalar/text element (its
        # MIR element type already says what it is).
        var element_name = ""
        match elem.kind:
            case HirTypeKind.Named(elem_sym, _):
                if val present_elem_symbol = self.symbols.get_symbol_raw(elem_sym.id):
                    val elem_symbol: HirSymbol = present_elem_symbol
                    element_name = elem_symbol.name
                    if elem_symbol.kind == SymbolKind.Class:
                        element_name = mir_class_identity(elem_symbol)
            case HirTypeKind.Array(_, _):
                element_name = "__runtime_array__"
            case HirTypeKind.Slice(_):
                element_name = "__runtime_array__"
            case _:
                ()
        self.runtime_array_locals[result.id] = true
        self.mark_runtime_value_local(result.id)
        if element_name != "":
            self.array_element_struct_syms[result.id] = element_name

    me generic_instance_field_type(owner: text, base_local: LocalId, field_idx: i64) -> (bool, MirType, text):
        """MIR type (and nested struct name, "" if none) of field `field_idx`
        of a GENERIC struct `owner` read off `base_local`, when that field is
        declared as a bare type parameter (BUG-IT-6). Resolved from the
        construct site's recorded argument types first, else from the base
        local's own HIR type arguments. `(false, i64, "")` when the field is
        not a type-param field or nothing records the instance."""
        if not self.struct_field_type_param.has(owner):
            return (false, MirType.i64(), "")
        val markers = self.struct_field_type_param[owner]
        if field_idx < 0 or field_idx >= markers.len():
            return (false, MirType.i64(), "")
        val tp_name: text = markers[field_idx]
        if tp_name == "":
            return (false, MirType.i64(), "")
        if self.generic_instance_field_types.has(base_local.id):
            val inst_types = self.generic_instance_field_types[base_local.id]
            if field_idx < inst_types.len():
                var nested = ""
                if self.generic_instance_field_struct_names.has(base_local.id):
                    val inst_names = self.generic_instance_field_struct_names[base_local.id]
                    if field_idx < inst_names.len():
                        nested = inst_names[field_idx]
                return (true, inst_types[field_idx], nested)
        val arg_hir = self.generic_instance_field_hir_arg(owner, base_local, field_idx)
        if arg_hir != nil:
            val arg_t: HirType = arg_hir
            var mt = self.lower_type(arg_t)
            var nested = ""
            match arg_t.kind:
                case HirTypeKind.Str:
                    mt = MirType(kind: MirTypeKind.Opaque("str"))
                case HirTypeKind.Named(arg_sym, _):
                    if val present_arg_symbol = self.symbols.get_symbol_raw(arg_sym.id):
                        val arg_symbol: HirSymbol = present_arg_symbol
                        nested = arg_symbol.name
                case _:
                    ()
            return (true, mt, nested)
        (false, MirType.i64(), "")

    me generic_instance_field_hir_arg(owner: text, base_local: LocalId, field_idx: i64) -> HirType?:
        """The HIR type argument that instantiates type-param field
        `field_idx` of `owner`, taken from the base local's HIR type
        (`Pair<text, i64>`); nil when the base carries no type arguments."""
        if not self.struct_field_type_param.has(owner) or not self.struct_type_param_names.has(owner):
            return nil
        val markers = self.struct_field_type_param[owner]
        if field_idx < 0 or field_idx >= markers.len():
            return nil
        val tp_name: text = markers[field_idx]
        if tp_name == "":
            return nil
        val base_hir = self.find_local_hir_type(base_local.id)
        if base_hir == nil:
            return nil
        val base_t: HirType = base_hir
        match base_t.kind:
            case HirTypeKind.Named(_, args):
                val tps = self.struct_type_param_names[owner]
                var i = 0
                while i < tps.len():
                    if tps[i] == tp_name and i < args.len():
                        val arg_t: HirType = args[i]
                        return arg_t
                    i = i + 1
                nil
            case _:
                nil

    me declared_field_type_in_current_table(owner: text, field_idx: i64, declared: HirType) -> HirType:
        """Rebind a declared field type's `Named` symbol into `self.symbols`.

        `struct_field_hir_type` is filled by the prescan from the DEFINING
        module's SymbolTable, so a `Named(sym)` field type carries a SymbolId
        that is only meaningful in that table. When the struct is imported,
        lowering reads it against the IMPORTER's table, where the same raw id
        names an unrelated symbol (measured: `u.quality` with imported
        `Usage.quality: Quality` resolved to `Usage` itself, so enum `==`
        on the projection fell into struct operator dispatch). The prescan
        also recorded the field type's module-qualified ownership key
        (`struct_field_type_ownership_key`), which is table-independent: keep
        the declared type when the id still names that exact owner, otherwise
        rebind to the importer's symbol of that exact owner, and degrade to
        `Error` (= unknown) rather than reuse a foreign id or capture a
        same-named type declared by a different module."""
        match declared.kind:
            case HirTypeKind.Array(element, size):
                val rebound = self.declared_record_array_element(owner, field_idx, element)
                return HirType(kind: HirTypeKind.Array(rebound, size), span: declared.span)
            case HirTypeKind.Slice(element):
                val rebound = self.declared_record_array_element(owner, field_idx, element)
                return HirType(kind: HirTypeKind.Slice(rebound), span: declared.span)
            case HirTypeKind.Function(_, _, _):
                return self.declared_function_field_signature(owner, field_idx, declared)
            case HirTypeKind.Optional(optional_inner):
                match optional_inner.kind:
                    case HirTypeKind.Named(_, optional_args):
                        if optional_args.len() == 0:
                            var optional_owner_key = ""
                            if self.struct_field_type_ownership_key.contains(owner):
                                val optional_keys: [text]? = self.struct_field_type_ownership_key[owner]
                                if optional_keys != nil:
                                    if val present_optional_keys = optional_keys:
                                        val keys: [text] = present_optional_keys
                                        if field_idx >= 0 and field_idx < keys.len():
                                            optional_owner_key = keys[field_idx]
                            # Missing evidence retains the prior compatibility
                            # behavior; it is not authenticated owner transport.
                            if optional_owner_key == "": return declared
                            val rebound = self.rebind_named_type_owner(optional_inner, optional_owner_key)
                            match rebound.kind:
                                case HirTypeKind.Error:
                                    # Field emission may continue from an HIR
                                    # fallback. A proven unavailable owner must
                                    # nevertheless block admission before codegen.
                                    self.error_fatal("optional field payload owner is unavailable in consumer: owner={optional_owner_key}", Some(declared.span))
                                    return rebound
                                case _:
                                    return HirType(kind: HirTypeKind.Optional(rebound), span: declared.span)
                    case _: ()
                declared
            case HirTypeKind.Named(declared_sym, declared_args):
                var owner_key = ""
                if self.struct_field_type_ownership_key.contains(owner):
                    val optional_keys: [text]? = self.struct_field_type_ownership_key[owner]
                    if optional_keys != nil:
                        if val present_keys = optional_keys:
                            val keys: [text] = present_keys
                            if field_idx >= 0 and field_idx < keys.len():
                                owner_key = keys[field_idx]
                if owner_key == "":
                    return declared
                self.rebind_named_type_owner(declared, owner_key)
            case _:
                declared

    me declared_record_array_element(owner: text, field_idx: i64, element: HirType) -> HirType:
        var owner_key = ""
        if self.struct_field_type_ownership_key.contains(owner):
            val optional_keys: [text]? = self.struct_field_type_ownership_key[owner]
            if optional_keys != nil:
                if val present_keys = optional_keys:
                    val keys: [text] = present_keys
                    if field_idx >= 0 and field_idx < keys.len():
                        owner_key = keys[field_idx]
        self.rebind_record_element_owner(element, owner_key)

    me rebind_record_element_owner(element: HirType, owner_key: text) -> HirType:
        # This transport knows the record's identity, not generic argument
        # identities. Reject incomplete evidence before layout can admit use.
        # "__no_struct_element__" is the return-array prescan's POSITIVE
        # "the element is not a struct/class" marker (module_lowering.spl),
        # not an owner key: an enum-element array such as
        # `[SdoctestModifier]` (sdoctest types.spl) or `[Color]` registers it,
        # and feeding it to rebind_named_type_owner below used to fail the
        # whole build with "record collection payload owner is unavailable in
        # the consumer: owner=__no_struct_element__". Enums need no record
        # owner rebinding, so the marker passes the element through.
        if owner_key == "__no_struct_element__":
            return element
        match element.kind:
            case HirTypeKind.Named(declared_symbol, args):
                if owner_key == "":
                    # No provider-owner evidence reached the consumer (the
                    # defining module could not resolve the element symbol, or
                    # the prescan found no aggregate layout). The consumer's
                    # own declared Named type is the only authoritative
                    # element identity available; pass it through un-rebound
                    # rather than fail the whole build for absent evidence.
                    return element
                if args.len() != 0:
                    # Generic instantiation (e.g. `[ProviderBox[T]]`): the
                    # provider-owner rebind is name-only evidence and cannot
                    # capture the instantiation's layout; the consumer's own
                    # Named(symbol, args) is the authoritative element type.
                    # Pass it through un-rebound, exactly as the enum sentinel
                    # above does for non-aggregates.
                    return element
                val rebound = self.rebind_named_type_owner(element, owner_key)
                match rebound.kind:
                    case HirTypeKind.Error:
                        # Preserve the exact-owner refusal; include enough evidence for
                        # aggregate builds to identify the failed provider lookup.
                        val consumer_symbol_name = self.symbols.symbol_name_scalar_raw(declared_symbol.id)
                        val consumer_symbol_owner = self.symbols.symbol_defining_module_scalar_raw(declared_symbol.id)
                        self.error_fatal("record collection payload owner is unavailable in the consumer: owner={owner_key} consumer={self.current_module_id} declared_symbol={declared_symbol.id} consumer_symbol={consumer_symbol_name} consumer_symbol_owner={consumer_symbol_owner} source={element.span.file}:{element.span.line}:{element.span.col}", Some(element.span))
                    case _: ()
                rebound
            case _: element

    me rebind_named_type_owner(declared: HirType, owner_key: text) -> HirType:
        # mcp_record_array_owner_loss_2026_10_11 (#3079).
        # An owner key is evidence from the provider, never a bare-name guess.
        match declared.kind:
            case HirTypeKind.Named(declared_sym, declared_args):
                val owner_arguments: [HirType] = declared_args
                if owner_key == "": return HirType(kind: HirTypeKind.Error, span: declared.span)
                if self.symbol_matches_ownership_key(declared_sym.id, owner_key): return declared
                var bare_start = 0
                val colon_at = owner_key.last_index_of("::")
                if colon_at >= 0:
                    bare_start = colon_at + 2
                else:
                    val dot_at = owner_key.last_index_of(".")
                    if dot_at >= 0: bare_start = dot_at + 1
                if bare_start > 0:
                    val separator_width = if colon_at >= 0: 2 else: 1
                    val owner_module = owner_key.substring(0, bare_start - separator_width)
                    val qualified = self.symbols.lookup_qualified_type_raw(mir_layout_canonical_module_name(owner_module), owner_key.substring(bare_start))
                    if qualified >= 0 and self.symbol_matches_ownership_key(qualified, owner_key):
                        val qualified_symbol: SymbolId = SymbolId(id: qualified)
                        return HirType(kind: HirTypeKind.Named(qualified_symbol, owner_arguments), span: declared.span)
                if val present_rebound = self.symbols.lookup_exact_type(owner_key.substring(bare_start)):
                    val rebound: SymbolId = present_rebound
                    if self.symbol_matches_ownership_key(rebound.id, owner_key):
                        return HirType(kind: HirTypeKind.Named(rebound, owner_arguments), span: declared.span)
                HirType(kind: HirTypeKind.Error, span: declared.span)
            case _: declared

    fn symbol_matches_ownership_key(raw: i64, owner_key: text) -> bool:
        """True when `raw` in `self.symbols` is exactly the type `owner_key`
        names: `composite_layout_key` ("<defining_module>::<Name>", or the
        bare name when ownerless) or `mir_class_identity` for classes."""
        val name = self.symbols.symbol_name_scalar_raw(raw)
        val defining_module = self.symbols.symbol_defining_module_scalar_raw(raw)
        if mir_nominal_profile_take_receipt():
            val agrees = mir_nominal_owner_matches(name, defining_module, owner_key)
            eprint("[nominal-owner] compare symbol={raw} name={name} module={defining_module} expected={owner_key} agrees={agrees}\n")
        mir_nominal_owner_matches(name, defining_module, owner_key)

    me remember_field_projection_provenance(base: HirExpr, base_local: LocalId, field_idx: i64, result: LocalId):
        """Carry nested aggregate/array identity through a field projection."""
        val base_struct_name = self.resolve_base_struct_name(base, base_local)
        if val name = base_struct_name:
            if self.struct_field_type_name.contains(name):
                val nested_types = self.struct_field_type_name[name]
                if field_idx >= 0 and field_idx < nested_types.len():
                    var nested_name = nested_types[field_idx]
                    # A struct field's bare display name is not its nominal
                    # owner. Retain the defining declaration's layout after
                    # exact consumer-table rebinding, so Result.map can prove
                    # the projected record without accepting a collided name.
                    if self.struct_field_hir_type.contains(name) and self.struct_field_type_ownership_key.contains(name):
                        val optional_field_types: [HirType]? = self.struct_field_hir_type[name]
                        val optional_ownership_keys: [text]? = self.struct_field_type_ownership_key[name]
                        if optional_field_types != nil and optional_ownership_keys != nil:
                            if val present_field_types = optional_field_types:
                                if val present_ownership_keys = optional_ownership_keys:
                                    val field_types: [HirType] = present_field_types
                                    val ownership_keys: [text] = present_ownership_keys
                                    if field_idx >= 0 and field_idx < field_types.len() and field_idx < ownership_keys.len():
                                        val field_hir = self.declared_field_type_in_current_table(name, field_idx, field_types[field_idx])
                                        match field_hir.kind:
                                            case HirTypeKind.Named(field_symbol, _):
                                                if val declaration = self.symbols.get_symbol_raw(field_symbol.id):
                                                    if declaration.kind == SymbolKind.Struct:
                                                        nested_name = ""
                                                        val ownership_key = ownership_keys[field_idx]
                                                        val layout_key = self.declared_struct_layout_key(ownership_key)
                                                        if ownership_key != "" and self.symbol_matches_ownership_key(field_symbol.id, ownership_key) and self.struct_field_order.has(layout_key):
                                                            nested_name = layout_key
                                            case _: ()
                    if nested_name != "":
                        self.struct_value_syms[result.id] = nested_name
            if self.struct_field_array_element_type_name.contains(name):
                val element_types = self.struct_field_array_element_type_name[name]
                if field_idx >= 0 and field_idx < element_types.len():
                    val element_name = element_types[field_idx]
                    if element_name != "":
                        self.runtime_array_locals[result.id] = true
                        self.mark_runtime_value_local(result.id)
                        # A1 (bug cranelift_native_aggregate_return_nil_
                        # receiver_hosted_wm_2026-07-26): record the
                        # "__runtime_array__" sentinel too, not only a real
                        # struct name. A field declared `events: [[text]]`
                        # gets exactly that sentinel from module_lowering.spl
                        # (its element is an Array, not a `Named` type), and
                        # dropping it here left `theme.events[i]` with no way
                        # to know the ELEMENT is itself a runtime array: the
                        # Index lowering below then decoded the element HANDLE
                        # as a plain i64/bootstrap-text scalar and never
                        # entered the decoded local in `runtime_array_locals`,
                        # so a following `.len()`/`[j]` lowered off a
                        # non-array local. Every consumer of this table
                        # already treats the sentinel as "not a real struct
                        # name" (`has_real_struct_name` in the Index case
                        # below, `for_has_real_struct_name` in
                        # mir_lowering_stmts.spl) and the copy-forward sites
                        # only test `!= ""`, so storing it is inert for them
                        # and adds only the element-is-an-array signal.
                        self.array_element_struct_syms[result.id] = element_name
            # Dict-typed FIELD provenance. Without this the projection temp for
            # `self.some_dict_field` is typed i64 and carries no HIR type, so
            # `receiver_is_dict` and `local_is_runtime_dict` both say no and
            # every dict method on it (`contains`/`has`/`contains_key`/`get`/
            # `keys`/`values`) falls through to an arm meant for another
            # receiver kind. For the arity-1 `contains` family that arm is the
            # STRING one: the dict handle was passed to `lib.common.text.contains`
            # as a text pointer and the answer had nothing to do with key
            # presence -- the same silent-wrong-answer class as the array
            # receiver misroute documented at method_calls_literals.spl:1847,
            # which excluded arrays but never dicts. Marking the temp here is
            # the receiver-side half of that fix and covers every
            # `Dict`-declared struct/class field at once, not one call site.
            if self.struct_field_hir_type.contains(name):
                val optional_decl_field_types: [HirType]? = self.struct_field_hir_type[name]
                # A missing/nil note must degrade to "unknown", never to a
                # `.len()` on the tagged nil sentinel (see
                # `noted_runtime_elem_type` for why this dict read cannot be
                # trusted on presence alone).
                if optional_decl_field_types != nil:
                    if val present_decl_field_types = optional_decl_field_types:
                        val decl_field_types: [HirType] = present_decl_field_types
                        if field_idx >= 0 and field_idx < decl_field_types.len():
                            match decl_field_types[field_idx].kind:
                                case HirTypeKind.Named(_, _):
                                    # Named enum fields share a Struct-shaped MIR word
                                    # with nominal aggregates. Preserve the declared
                                    # owner so enum equality can distinguish them after
                                    # projecting through a typed parameter.
                                    val rebound_field_type = self.declared_field_type_in_current_table(name, field_idx, decl_field_types[field_idx])
                                    match rebound_field_type.kind:
                                        case HirTypeKind.Named(_, _):
                                            self.remember_local_hir_type(result.id, rebound_field_type, 0, 0)
                                        case _: ()
                                case HirTypeKind.Optional(_):
                                    # Imported aggregate fields have an erased MIR
                                    # word. Keep the declared Option owner on that
                                    # projection so unwrap uses the Option contract.
                                    val rebound_optional = self.declared_field_type_in_current_table(name, field_idx, decl_field_types[field_idx])
                                    match rebound_optional.kind:
                                        case HirTypeKind.Optional(_):
                                            self.remember_local_hir_type(result.id, rebound_optional, 0, 0)
                                        case _: ()
                                case HirTypeKind.Dict(_, _):
                                    self.runtime_dict_locals[result.id] = true
                                    # A symbol-free declared type (`{text: i64}`)
                                    # means the same thing in every table, so it
                                    # needs no consumer rebinding to be retained.
                                    if mir_hir_type_is_symbol_free(decl_field_types[field_idx]):
                                        self.remember_local_hir_type(result.id, decl_field_types[field_idx], 0, 0)
                                # Array/Slice half of the SAME defect. The Dict arm
                                # above was landed alone, but an ARRAY-declared class
                                # field has exactly the same shape: the projection
                                # temp is typed i64 with no HIR type, so
                                # `local_is_runtime_array` misses and `.clear()` /
                                # `.len()` / `.contains()` on it fall into the string
                                # arm silently. The pre-existing array registration a
                                # few lines above fires only via
                                # `struct_field_array_element_type_name`, which
                                # records an entry only when the element type has a
                                # NAME (a `Named` type or the `__runtime_array__`
                                # nested-array sentinel) -- so a field declared
                                # `[i64]`, `[text]`, `[bool]` or `[f64]` got NOTHING
                                # and stayed misdispatched. Keying off the declared
                                # HIR type covers every array-typed field regardless
                                # of element kind. Marking is idempotent with the
                                # element-name path above.
                                case HirTypeKind.Array(_, _):
                                    val rebound_array = self.declared_field_type_in_current_table(name, field_idx, decl_field_types[field_idx])
                                    self.remember_local_hir_type(result.id, rebound_array, 0, 0)
                                    self.runtime_array_locals[result.id] = true
                                    self.mark_runtime_value_local(result.id)
                                case HirTypeKind.Slice(_):
                                    val rebound_slice = self.declared_field_type_in_current_table(name, field_idx, decl_field_types[field_idx])
                                    self.remember_local_hir_type(result.id, rebound_slice, 0, 0)
                                    self.runtime_array_locals[result.id] = true
                                    self.mark_runtime_value_local(result.id)
                                # Primitive field projections (text/bool/float): the
                                # projection temp is an erased word with no HIR type,
                                # so receiver-directed lowering missed it — text
                                # methods (substring/slice/trim_start/...) and
                                # float/bool binops on `observed.stdout`-shaped
                                # receivers fell through to the loud unresolved
                                # failure (matrix: env_access_host.spl:90/93).
                                # Same erased-word registration shape as the
                                # Named/Optional arms above.
                                case HirTypeKind.Str:
                                    self.remember_local_hir_type(result.id, decl_field_types[field_idx], 0, 0)
                                case HirTypeKind.Bool:
                                    self.remember_local_hir_type(result.id, decl_field_types[field_idx], 0, 0)
                                case HirTypeKind.Float(_):
                                    self.remember_local_hir_type(result.id, decl_field_types[field_idx], 0, 0)
                                case _: ()


    me remember_array_index_projection_provenance(base_local: LocalId, result: LocalId):
        # The mutation writeback path reads a slot once, without lower_expr(Index).
        # Preserve its declared array element type as well as handle identity;
        # pop needs the leaf type even when the current MIR word is erased i64.
        # Unknown/scalar elements do not acquire array identity from a method name.
        if val base_type = self.find_local_hir_type(base_local.id):
            match base_type.kind:
                case HirTypeKind.Array(element_type, _) | HirTypeKind.Slice(element_type):
                    if val stable_owner = self.array_element_struct_syms.get(base_local.id):
                        val stable_identity = result_err_layout_identity(stable_owner)
                        if stable_identity != "":
                            # Stable return metadata wins over a Named ID from
                            # another table. Only a consumer-owned declaration
                            # with that exact identity may supply an HIR note.
                            val checked_owner = self.checked_array_record_layout(stable_owner)
                            if checked_owner != "": self.struct_value_syms[result.id] = checked_owner
                            match element_type.kind:
                                case HirTypeKind.Named(symbol, args):
                                    if args.len() == 0:
                                        if val declaration = self.symbols.get_symbol_raw(symbol.id):
                                            match declaration.kind:
                                                case SymbolKind.Struct | SymbolKind.Class:
                                                    if result_err_layout_identity(mir_class_identity(declaration)) == stable_identity:
                                                        self.remember_local_hir_type(result.id, element_type, 0, 0)
                                                case _: ()
                                case _: ()
                            return
                    # Indexing retains the declared element owner as well as
                    # its storage representation. Imported record methods
                    # resolve through this consumer-owned Named type; a bare
                    # array-element layout name does not identify the method.
                    self.remember_local_hir_type(result.id, element_type, 0, 0)
                    match element_type.kind:
                        case HirTypeKind.Named(element_symbol, _):
                            # Field lookup consumes layout provenance, not the
                            # local HIR note. Nested array returns may have no
                            # separate array-element shape note at either index.
                            if val element_owner = self.symbols.get_symbol_raw(element_symbol.id):
                                if element_owner.kind == SymbolKind.Struct:
                                    val layout_key = self.declared_struct_layout_key(self.composite_layout_key(element_owner))
                                    if self.struct_field_order.has(layout_key):
                                        self.struct_value_syms[result.id] = layout_key
                        case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                            self.runtime_array_locals[result.id] = true
                            self.mark_runtime_value_local(result.id)
                        case _: ()
                case _: ()

    fn mir_type_is_integer(t: MirType) -> bool:
        """True for the MIR kinds `decode_runtime_value` unboxes with `>> 3`.

        Kept in one place so the decode arm and the miss-sentinel guard in
        `lower_dict_runtime_read` can never disagree about which value types
        have their raw word transformed at read time.
        """
        val disc = _sffi_enum_discriminant(t.kind)
        disc == _sffi_enum_discriminant(MirTypeKind.I8) or disc == _sffi_enum_discriminant(MirTypeKind.U8) or disc == _sffi_enum_discriminant(MirTypeKind.I16) or disc == _sffi_enum_discriminant(MirTypeKind.U16) or disc == _sffi_enum_discriminant(MirTypeKind.I32) or disc == _sffi_enum_discriminant(MirTypeKind.U32) or disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.I64) or disc == _sffi_enum_discriminant(MirTypeKind.U64) or disc == _sffi_enum_discriminant(MirTypeKind.Char)

    fn mir_type_is_str(t: MirType) -> bool:
        """True for the native string MIR types: the fat-pointer struct
        Tuple([Ptr(U8), U64]) that `Str` lowers to (function_lowering.lower_type)
        and the Opaque("str") raw-char* temp used by literal/interpolation
        lowering. The backend materializes both as a single raw char* value, so
        string `+` and `.len` route to rt_strcat/rt_strlen on that pointer."""
        match t.kind:
            case MirTypeKind.Opaque(name):
                return name == "str"
            case MirTypeKind.Tuple(elems):
                if elems.len() != 2:
                    return false
                var elem0_is_u8_ptr = false
                match elems[0].kind:
                    case MirTypeKind.Ptr(inner, _):
                        match inner.kind:
                            case MirTypeKind.U8: elem0_is_u8_ptr = true
                            case _: ()
                    case _: ()
                if not elem0_is_u8_ptr:
                    return false
                match elems[1].kind:
                    case MirTypeKind.U64: return true
                    case _: return false
            case _:
                return false

    fn local_is_str(local: LocalId) -> bool:
        """True when a lowered local holds a native string value.

        Tagged scalar-renderer results retain an i64 MIR ABI so codegen keeps
        their tagged handle representation. They are marked separately here;
        all other text remains keyed off the MIR local type because inferred
        HIR `.type_` is frequently nil on this path (flat HIR)."""
        if self.is_tagged_text_local(local.id):
            return true
        if val type_ = self.builder.local_type(local):
            return self.mir_type_is_str(type_)
        false

    me nil_compare_operand_hir_type(e: HirExpr, local: LocalId) -> HirType?:
        """Static HIR type of one side of a nil compare: the expression's
        own type-checker annotation when present, else the DECLARED type
        the lowering registered for the local (function params, annotated
        bindings -- function_lowering.spl remember_local_hir_type). The
        fallback matters on the flat/bootstrap HIR path and in in-process
        lowering specs, where `type_` is frequently absent."""
        if e != nil and e.has_type_:
            val t = e.type_
            if t != nil:
                return Some(t)
        match self.find_local_hir_type(local.id):
            case Some(found):
                if found != nil and found != 0:
                    return Some(found)
            case nil: ()
        # `xs[i]` on a declared `[T]`/`[T; n]` local: the element read's temp
        # carries no registered type on the flat path, but the array local
        # does, and its element type is the read's static type.
        if e != nil:
            match e.kind:
                case HirExprKind.Index(index_base, _):
                    match index_base.kind:
                        case HirExprKind.Var(base_symbol) | HirExprKind.NamedVar(base_symbol, _):
                            val base_local = self.find_local(base_symbol.id)
                            if base_local.id >= 0:
                                match self.find_local_hir_type(base_local.id):
                                    case Some(base_type):
                                        if base_type != nil and base_type != 0:
                                            match base_type.kind:
                                                case HirTypeKind.Array(elem, _) | HirTypeKind.Slice(elem):
                                                    return Some(elem)
                                                case _: ()
                                    case nil: ()
                        case _: ()
                case _: ()
        nil

    me cast_of_provably_scalar_variable(e: HirExpr) -> bool:
        """`x as T` with scalar `T` where `x` is a variable whose local is a
        provably non-optional scalar (declared type or non-I64 scalar slot,
        never an extern result). The structural rule refuses a cast of
        anything it cannot prove, because a cast passes the word through."""
        match e.kind:
            case HirExprKind.Cast(cast_operand, cast_target):
                if not hir_type_is_plain_scalar(cast_target):
                    return false
                match cast_operand.kind:
                    case HirExprKind.Var(cast_symbol) | HirExprKind.NamedVar(cast_symbol, _):
                        val cast_local = self.find_local(cast_symbol.id)
                        if cast_local.id >= 0:
                            return self.local_is_provably_scalar_payload(cast_local)
                    case _: ()
            case _: ()
        false

    me index_expr_reads_declared_scalar_element(e: HirExpr) -> bool:
        """`xs[i]` on a local DECLARED `[T]` / `[T; n]` with a non-optional
        scalar `T`: the same static element type the `== nil` fold uses
        (nil_compare_operand_hir_type). Dict reads are not covered -- a miss
        carries the raw nil word."""
        match e.kind:
            case HirExprKind.Index(index_base, _):
                match index_base.kind:
                    case HirExprKind.Var(base_symbol) | HirExprKind.NamedVar(base_symbol, _):
                        val base_local = self.find_local(base_symbol.id)
                        if base_local.id >= 0:
                            match self.find_local_hir_type(base_local.id):
                                case Some(base_type):
                                    if base_type != nil and base_type != 0:
                                        match base_type.kind:
                                            case HirTypeKind.Array(elem, _) | HirTypeKind.Slice(elem):
                                                return hir_type_is_plain_scalar(elem)
                                            case _: ()
                                case nil: ()
                    case _: ()
            case _: ()
        false

    me nil_compare_operand_is_declared_optional(e: HirExpr, local: LocalId) -> bool:
        if val t = self.nil_compare_operand_hir_type(e, local):
            return match t.kind:
                case HirTypeKind.Optional(_): true
                case _: false
        false

    me nil_compare_operand_is_struct(local: LocalId) -> bool:
        # Bootstrap record slots may carry nil despite a nominal declaration.
        # Presence is independent of user-defined equality; consult this local's
        # MIR type rather than the cross-function struct-name registry.
        if val type_ = self.local_mir_type_of(local):
            return match type_.kind:
                case MirTypeKind.Struct(_): true
                case _: false
        false

    me null_coalesce_nominal_join_type(left: HirExpr, left_local: LocalId) -> HirType?:
        """Declared class/struct/enum payload of `left` in `left ?? right`:
        the Option's inner type, or a declared container read (`d[k]`,
        `d.get(k)`). Nothing is lowered here; unknown stays nil."""
        var payload: HirType? = self.option_inner_hir_type_for_local(left, left_local)
        if payload == nil:
            payload = self.declared_container_read_type(left)
        if val present_payload = payload:
            var nominal = present_payload
            match present_payload.kind:
                case HirTypeKind.Optional(inner): nominal = inner
                case _: ()
            match nominal.kind:
                case HirTypeKind.Named(owner, _):
                    val nominal_kind = enum_payload_nominal_kind(owner, self.symbols)
                    if nominal_kind == 1 or nominal_kind == 2 or nominal_kind == 3:
                        return Some(nominal)
                case _: ()
        nil

    me nil_compare_operand_is_plain_scalar(e: HirExpr, local: LocalId) -> bool:
        """True when `e` (one side of `== nil` / `!= nil`) is a STATICALLY
        non-optional primitive scalar whose lowered local is also a plain
        scalar MIR slot with no nil state: HIR type Int/Float/Bool/Char,
        MIR type I8..U64/F32/F64/Bool/Char, and not tracked as an Option
        handle, a nil literal or a tagged runtime value. Such an operand
        can never be nil, so the compare folds to a constant instead of
        comparing payload bits against the raw nil sentinel (3)."""
        var hir_scalar = false
        if val t = self.nil_compare_operand_hir_type(e, local):
            hir_scalar = match t.kind:
                case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Bool | HirTypeKind.Char: true
                case _: false
        if not hir_scalar:
            return false
        if self.option_value_locals.contains(local.id) or self.nil_locals.contains(local.id):
            return false
        if self.is_runtime_value_local(local.id):
            return false
        # An extern's `-> i64` result may be the raw nil word (runtime
        # "absent"): keep the runtime compare there.
        if self.extern_result_locals.contains(local.id):
            return false
        var mir_scalar = false
        if val mir_ty = self.local_mir_type_of(local):
            mir_scalar = match mir_ty.kind:
                case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64: true
                case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: true
                case MirTypeKind.F32 | MirTypeKind.F64 | MirTypeKind.Bool | MirTypeKind.Char: true
                case _: false
        mir_scalar

    me local_enum_type_id(local: LocalId) -> i64:
        """Return the canonical declared owner id for a proven enum local."""
        if val hir_type = self.find_local_hir_type(local.id):
            match hir_type.kind:
                case HirTypeKind.Named(symbol, _):
                    val enum_name = self.symbols.symbol_name_scalar_raw(symbol.id)
                    if enum_name != "" and self.symbols.symbol_is_enum_declaration_scalar_raw(symbol.id):
                        val qualified = self.enum_qualified_key(symbol)
                        if qualified != "":
                            # Imported dependency materialization may index the
                            # bare table by its local alias, while the symbol
                            # retains the declaration's source name. The exact
                            # owner registry is authoritative independently.
                            if not self.enum_variant_index_q.has(qualified):
                                return -1
                        elif not self.enum_variant_index.contains(enum_name):
                            # Ownerless declarations have only a bare registry.
                            return -1
                        # A genuine enum and its imported alias share one
                        # canonical declaration id; foreign structs cannot pass
                        # the declaration-kind check even with a matching name.
                        return self.canonical_mir_type_symbol(symbol).id
                case _:
                    ()
        -1

    fn binop_struct_name_is_enum(name: text) -> bool:
        """A struct_value_syms owner that names an enum declaration (enum
        values share the Struct MIR kind) and no struct/class layout."""
        if name == "":
            return false
        if self.struct_field_order.has(self.declared_struct_layout_key(name)):
            return false
        self.enum_variant_index_q.has(name) or self.enum_variant_index.contains(name)

    fn binop_optional_text_depth_v1(type_: HirType) -> i64:
        """Positive only for an exact Optional chain ending in text."""
        var current = type_
        var depth: i64 = 0
        while true:
            match current.kind:
                case HirTypeKind.Optional(inner):
                    depth = depth + 1
                    current = inner
                case HirTypeKind.Str: return depth
                case _: return 0
        0

    me lower_optional_text_eq_v1(left: LocalId, right: LocalId, depth: i64, negate: bool) -> LocalId:
        """Compare only proven equal-depth Optional text, without re-lowering operands.

        Absent paths never unwrap or compare a payload. Each present layer
        unwraps once; the text leaf uses the existing raw/tagged comparator.
        No value/Option allocation or runtime type guessing is introduced.
        """
        var result = LocalId(id: -1)
        if depth == 0:
            result = self.emit_text_word_eq(left, right)
        else:
            val is_none_fn = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_is_none"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false)))
            ))
            var pb = self.builder
            val result_slot = pb.emit_entry_alloc(MirType.bool())
            val left_none = pb.emit_call(is_none_fn, [mir_operand_copy(left)], MirType.bool()) ?? LocalId(id: 0)
            val right_none = pb.emit_call(is_none_fn, [mir_operand_copy(right)], MirType.bool()) ?? LocalId(id: 0)
            val same_presence = pb.emit_binop(MirBinOp.Eq, mir_operand_copy(left_none), mir_operand_copy(right_none), MirType.bool())
            val same_block = pb.new_block(Some("option_text_same_presence"))
            val different_block = pb.new_block(Some("option_text_different_presence"))
            val absent_block = pb.new_block(Some("option_text_both_absent"))
            val present_block = pb.new_block(Some("option_text_both_present"))
            val merge_block = pb.new_block(Some("option_text_merge"))
            pb.terminate_if(mir_operand_copy(same_presence), same_block, different_block)

            pb.switch_to_block(different_block)
            val not_equal = pb.new_temp(MirType.bool())
            pb.emit_const(not_equal, MirConstValue.Bool(false), MirType.bool())
            pb.emit_store(mir_operand_copy(result_slot), mir_operand_copy(not_equal))
            pb.terminate_goto(merge_block)

            pb.switch_to_block(same_block)
            pb.terminate_if(mir_operand_copy(left_none), absent_block, present_block)
            pb.switch_to_block(absent_block)
            val equal = pb.new_temp(MirType.bool())
            pb.emit_const(equal, MirConstValue.Bool(true), MirType.bool())
            pb.emit_store(mir_operand_copy(result_slot), mir_operand_copy(equal))
            pb.terminate_goto(merge_block)

            pb.switch_to_block(present_block)
            self.builder = pb
            val left_payload = self.option_payload_or_self(left)
            val right_payload = self.option_payload_or_self(right)
            val payload_equal = self.lower_optional_text_eq_v1(left_payload, right_payload, depth - 1, false)
            var mb = self.builder
            mb.emit_store(mir_operand_copy(result_slot), mir_operand_copy(payload_equal))
            mb.terminate_goto(merge_block)
            mb.switch_to_block(merge_block)
            result = mb.emit_load(mir_operand_copy(result_slot), MirType.bool())
            self.builder = mb
        if negate:
            var nb = self.builder
            val false_local = nb.new_temp(MirType.bool())
            nb.emit_const(false_local, MirConstValue.Bool(false), MirType.bool())
            result = nb.emit_binop(MirBinOp.Eq, mir_operand_copy(result), mir_operand_copy(false_local), MirType.bool())
            self.builder = nb
        result

    me emit_runtime_word_eq(left: LocalId, right: LocalId) -> LocalId:
        """rt_native_eq(left, right) == 1 as a Bool local: the runtime's
        tag-aware structural equality (strings by content, arrays/enums
        element-/payload-wise), identity for any other word."""
        val eq_func = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_native_eq"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b = self.builder
        val raw = b.emit_call(eq_func, [mir_operand_copy(left), mir_operand_copy(right)], MirType.i64()) ?? LocalId(id: 0)
        val result = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_const_int(1), MirType.bool())
        self.builder = b
        result

    me emit_text_word_eq(left: LocalId, right: LocalId) -> LocalId:
        """Text content equality (raw or tagged operands), as a Bool local."""
        val eq_func = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_text_eq_any"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b = self.builder
        val raw = b.emit_call(eq_func, [mir_operand_copy(left), mir_operand_copy(right)], MirType.i64()) ?? LocalId(id: 0)
        val result = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_const_int(1), MirType.bool())
        self.builder = b
        result

    me struct_structural_eq_supported(struct_name: text) -> bool:
        """Whether lower_struct_structural_eq can compare every field of
        `struct_name` (recursively): a known layout and no erased native
        trait-object field."""
        val layout_key = self.declared_struct_layout_key(struct_name)
        if not self.struct_field_order.has(layout_key):
            return false
        val declared_field_types = self.struct_field_hir_type.get(layout_key) ?? []
        for declared in declared_field_types:
            if self.native_trait_value_type(declared):
                return false
        true

    me lower_struct_structural_eq(left: LocalId, right: LocalId, struct_name: text, chain: [text]) -> LocalId:
        """`==` for a struct/class value with no user `__eq__`.

        Language semantics are structural: the interpreter compares
        `Value::Object` by class and fields (compiler_rust value_pointers.rs
        `impl PartialEq for Value`) and the seed's native runtime does the
        same for RuntimeObject (runtime equality.rs `object_eq`). Native
        self-hosted structs are raw aggregate pointers the runtime cannot
        inspect, so compare field by field here: a nested value struct
        recurses, text uses rt_text_eq_any, plain scalars compare raw, and
        every other field (enum, Option, array, dict, tuple, type parameter)
        uses rt_native_eq, the same runtime equality enum `==` uses. A null or
        nil operand compares by word identity. A layout already on `chain`
        (a recursive class) is compared by identity. Returns a Bool local."""
        val layout_key = self.declared_struct_layout_key(struct_name)
        val nil_word = self.lower_expr(HirExpr(kind: HirExprKind.NilLit,
            has_type_: false, type_: nil, span: Span.empty()))
        var gb = self.builder
        val result_slot = gb.emit_entry_alloc(MirType.bool())
        val left_word = gb.emit_bitcast(mir_operand_copy(left), MirType.i64())
        val right_word = gb.emit_bitcast(mir_operand_copy(right), MirType.i64())
        val same_word = gb.emit_binop(MirBinOp.Eq, mir_operand_copy(left_word), mir_operand_copy(right_word), MirType.bool())
        gb.emit_store(mir_operand_copy(result_slot), mir_operand_copy(same_word))
        val zero_word = gb.new_temp(MirType.i64())
        gb.emit_const(zero_word, MirConstValue.Zero, MirType.i64())
        val left_non_null = gb.emit_binop(MirBinOp.Ne, mir_operand_copy(left_word), mir_operand_copy(zero_word), MirType.bool())
        val left_non_nil = gb.emit_binop(MirBinOp.Ne, mir_operand_copy(left_word), mir_operand_copy(nil_word), MirType.bool())
        val right_non_null = gb.emit_binop(MirBinOp.Ne, mir_operand_copy(right_word), mir_operand_copy(zero_word), MirType.bool())
        val right_non_nil = gb.emit_binop(MirBinOp.Ne, mir_operand_copy(right_word), mir_operand_copy(nil_word), MirType.bool())
        val left_present = gb.emit_binop(MirBinOp.BitAnd, mir_operand_copy(left_non_null), mir_operand_copy(left_non_nil), MirType.bool())
        val right_present = gb.emit_binop(MirBinOp.BitAnd, mir_operand_copy(right_non_null), mir_operand_copy(right_non_nil), MirType.bool())
        val both_present = gb.emit_binop(MirBinOp.BitAnd, mir_operand_copy(left_present), mir_operand_copy(right_present), MirType.bool())
        val compare_block = gb.new_block(Some("structeq_fields"))
        val merge_block = gb.new_block(Some("structeq_merge"))
        gb.terminate_if(mir_operand_copy(both_present), compare_block, merge_block)
        gb.switch_to_block(compare_block)
        self.builder = gb

        val field_names = self.struct_field_order.get(layout_key) ?? []
        val nested_names = self.struct_field_type_name.get(layout_key) ?? []
        val declared_field_types = self.struct_field_hir_type.get(layout_key) ?? []
        val repr_names = self.struct_field_repr_name.get(layout_key) ?? []
        var ab = self.builder
        var all_equal = ab.new_temp(MirType.bool())
        ab.emit_const(all_equal, MirConstValue.Bool(true), MirType.bool())
        self.builder = ab
        var fi = 0
        while fi < field_names.len():
            var nested_name = ""
            if fi < nested_names.len():
                nested_name = nested_names[fi]
            var nested_symbol = SymbolId(id: -1)
            var compare_nested = false
            if nested_name != "" and not chain.contains(nested_name) and self.struct_field_order.contains(nested_name):
                val nested_lookup = self.symbols.lookup_or_invalid(nested_name)
                if nested_lookup.is_valid():
                    nested_symbol = self.canonical_mir_type_symbol(nested_lookup)
                    compare_nested = self.struct_structural_eq_supported(nested_name)
            # 0 = runtime word, 1 = text, 2 = raw scalar, 3 = nested record
            var field_mode = 0
            var field_type = MirType.i64()
            if compare_nested:
                field_mode = 3
                field_type = MirType(kind: MirTypeKind.Struct(nested_symbol))
            elif fi < declared_field_types.len():
                val declared = declared_field_types[fi]
                match declared.kind:
                    case HirTypeKind.Str:
                        field_mode = 1
                        field_type = MirType(kind: MirTypeKind.Opaque("str"))
                    case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Bool | HirTypeKind.Char:
                        field_mode = 2
                        field_type = self.lower_type(declared)
                    case _: ()
            elif fi < repr_names.len() and repr_names[fi] == "str":
                field_mode = 1
                field_type = MirType(kind: MirTypeKind.Opaque("str"))
            var fb = self.builder
            val left_field = fb.emit_get_field(mir_operand_copy(left), fi, field_type)
            val right_field = fb.emit_get_field(mir_operand_copy(right), fi, field_type)
            self.builder = fb
            var field_equal = LocalId(id: 0)
            if field_mode == 3:
                var nested_chain: [text] = []
                for seen in chain:
                    nested_chain.push(seen)
                nested_chain.push(nested_name)
                self.struct_value_syms[left_field.id] = nested_name
                self.struct_value_syms[right_field.id] = nested_name
                field_equal = self.lower_struct_structural_eq(left_field, right_field, nested_name, nested_chain)
            elif field_mode == 1:
                field_equal = self.emit_text_word_eq(left_field, right_field)
            elif field_mode == 2:
                var sb = self.builder
                field_equal = sb.emit_binop(MirBinOp.Eq, mir_operand_copy(left_field), mir_operand_copy(right_field), MirType.bool())
                self.builder = sb
            else:
                field_equal = self.emit_runtime_word_eq(left_field, right_field)
            var cb = self.builder
            all_equal = cb.emit_binop(MirBinOp.BitAnd, mir_operand_copy(all_equal), mir_operand_copy(field_equal), MirType.bool())
            self.builder = cb
            fi = fi + 1
        var mb = self.builder
        mb.emit_store(mir_operand_copy(result_slot), mir_operand_copy(all_equal))
        mb.terminate_goto(merge_block)
        mb.switch_to_block(merge_block)
        val result = mb.emit_load(mir_operand_copy(result_slot), MirType.bool())
        self.builder = mb
        result

    # local_is_float lives in mir_lowering_stmts.spl (single declaration: a
    # second identical copy here made every unresolved-receiver call to it
    # "ambiguous on MirLowering").

    fn local_is_f32(local: LocalId) -> bool:
        val type_ = self.local_mir_type_of(local)
        if type_ == nil:
            return false
        match type_.kind:
            case MirTypeKind.F32: true
            case _: false

    me coerce_concat_operand(local: LocalId) -> MirOperand:
        """strconcat2: `text + scalar` (e.g. `"n=" + 5`) must not hand the raw
        scalar bit pattern to rt_strcat_tagged -- rt_strcat_tagged unwraps
        each operand via rt_interp_cstr, which treats any non-tagged-string
        i64 as a raw char* and derefs it, SIGSEGVing on a plain int/bool/float
        operand (see bin_is_str_concat below). Mirrors
        lower_bootstrap_print_call's raw-render dispatch
        (switch_operators_calls.spl): render the scalar to a TAGGED heap
        string via rt_raw_i64_to_string/rt_raw_u64_to_string/
        rt_raw_bool_to_string/rt_raw_f64_to_string BEFORE it becomes a concat
        operand. Unlike that print path, no extra rt_interp_cstr unwrap is
        needed afterward: rt_strcat_tagged already runs every operand through
        rt_interp_cstr itself, and rt_interp_cstr's tagged-or-raw autodetect
        (bug #136) accepts the freshly tagged string handle directly.

        A str-typed operand passes through unchanged (this is also the
        text+text control path). An F32 operand is widened to F64 first
        (emit_cast) so rt_raw_f64_to_string's `double` ABI slot gets real
        float bits instead of a 32-bit value reinterpreted as 64-bit --
        widening here, before the value becomes a concat operand, is what
        sidesteps the separately-flagged double->ptr call-arg coercion bug in
        core_codegen (the coercion only misfires on an F64-typed operand
        reaching a call site as a bare arg; this path renders it to a tagged
        string handle first)."""
        if self.local_is_str(local):
            return mir_operand_copy(local)
        # An `Any`-typed local carries a TAGGED runtime word, not a plain
        # integer -- `HirTypeKind.Any` lowers to `MirTypeKind.I64` (the tagged
        # any slot, see _MirLowering/function_lowering.spl's Any arm). The
        # scalar dispatch below keys only off the MIR type, so an Any local
        # matched `is_numeric` and rendered through rt_raw_i64_to_string,
        # printing the raw tagged word: `30` came out as `240` (30<<3), `true`
        # as `11` ((1<<3)|3) and a text handle as its pointer. Route a local
        # whose DECLARED HIR type is Any through rt_value_to_string, which
        # decodes the tag (tagged in, tagged out) -- the same runtime entry the
        # `str(x)` builtin already uses for any-typed values.
        if val any_hir_type = self.find_local_hir_type(local.id):
            match any_hir_type.kind:
                case HirTypeKind.Any:
                    val any_op = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_value_to_string"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_any = self.builder
                    val any_res = b_any.emit_call(any_op, [mir_operand_copy(local)], MirType.i64())
                    self.builder = b_any
                    if val any_local = any_res:
                        self.mark_tagged_text_local(any_local.id)
                        return mir_operand_copy(any_local)
                    return mir_operand_copy(local)
                case _: ()
        var is_bool = false
        var is_f32 = false
        var is_float = false
        var is_u64 = false
        var is_char = false
        var is_numeric = false
        if val ty = self.local_mir_type_of(local):
            match ty.kind:
                case MirTypeKind.Bool: is_bool = true
                case MirTypeKind.F32:
                    is_float = true
                    is_f32 = true
                case MirTypeKind.F64: is_float = true
                case MirTypeKind.U64: is_u64 = true
                case MirTypeKind.Char: is_char = true
                case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64
                   | MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32:
                    is_numeric = true
                case MirTypeKind.Tuple(field_types):
                    # AOT tuples have no runtime type tag (bare rt_alloc
                    # block, no rt_tuple_* runtime API) -- render
                    # "(a, b, ...)" at COMPILE TIME via coerce_tuple_to_raw_str
                    # below (mirrors the array-literal `.join()` lowering's
                    # element splice). Return directly -- skip the scalar
                    # is_bool/is_float/... dispatch below.
                    return mir_operand_copy(self.coerce_tuple_to_raw_str(local, field_types))
                case _: ()
        if is_char:
            val char_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_char_from_code"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
            ))
            var b_char = self.builder
            val char_res = b_char.emit_call(char_op, [mir_operand_copy(local)], MirType.i64())
            self.builder = b_char
            if val char_local = char_res:
                self.mark_tagged_text_local(char_local.id)
                return mir_operand_copy(char_local)
            return mir_operand_copy(local)
        if not (is_bool or is_float or is_u64 or is_numeric):
            return mir_operand_copy(local)
        val render_fn = if is_bool: "rt_raw_bool_to_string" elif is_float: "rt_raw_f64_to_string" elif is_u64: "rt_raw_u64_to_string" else: "rt_raw_i64_to_string"
        var render_src = mir_operand_copy(local)
        if is_f32:
            var b_widen = self.builder
            val widened = b_widen.emit_cast(mir_operand_copy(local), MirType.f64())
            self.builder = b_widen
            render_src = mir_operand_copy(widened)
        # Scalar renderers return a TAGGED runtime-string HANDLE, not a raw
        # C-string pointer. Keep that value nominally i64 until the one
        # explicit rt_interp_cstr bridge in bootstrap_coerce_to_raw_str.
        # In particular, never type the rt_raw_i64_to_string result as
        # Opaque("str"): doing so gives one SSA value incompatible nominal
        # identities across the renderer -> C-string boundary and lets a
        # later store/call treat tagged text as a raw pointer.
        var render_param_type = MirType.i64()
        if is_float:
            render_param_type = MirType.f64()
        val num_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(render_fn),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [render_param_type], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_num = self.builder
        val num_res = b_num.emit_call(num_op, [render_src], MirType.i64())
        self.builder = b_num
        if val num_local = num_res:
            self.mark_tagged_text_local(num_local.id)
            return mir_operand_copy(num_local)
        mir_operand_copy(local)

    me lower_tuple_field_raw(base_local: LocalId, elem_type: MirType, index: i64) -> LocalId:
        """Read tuple field `index` via a direct GEP+load off the tuple's
        raw rt_alloc(field_count*8) block. This is the SAME representation
        lower_tuple_lit builds (_MirLoweringExpr/method_calls_literals.spl -- raw i64-slot
        GEP stores, no rt_tuple_* runtime header). Used only by
        coerce_tuple_to_raw_str below to render a tuple to text at compile
        time; NOT a general tuple-index lowering (that remains the
        HIR-level Index desugar, lower_index_expr above)."""
        var b = self.builder
        val idx_local = b.emit_const_int(index)
        val ptr = b.emit_gep(
            mir_operand_copy(base_local),
            [mir_operand_copy(idx_local)],
            MirType.ptr(elem_type, false)
        )
        val loaded = b.emit_load(mir_operand_copy(ptr), elem_type)
        self.builder = b
        loaded

    me coerce_tuple_to_raw_str(local: LocalId, field_types: [MirType]) -> LocalId:
        """Render a Tuple-typed local as "(a, b, ...)" at COMPILE TIME --
        see coerce_concat_operand's Tuple case above for why (no runtime
        tuple type tag under AOT). Reads each field via
        lower_tuple_field_raw, recursively renders it through
        bootstrap_coerce_to_raw_str (which itself routes back through
        coerce_concat_operand -- safe recursion, since a field's own type is
        never the SAME Tuple local), and splices the pieces with
        emit_raw_strcat, mirroring the array-literal `.join()` lowering
        (method_calls_literals.spl, ArrayLit case) element-by-element."""
        if field_types.len() == 0:
            var b_empty = self.builder
            val empty = b_empty.emit_const_str("()")
            self.builder = b_empty
            return empty
        var b_open = self.builder
        var acc = b_open.emit_const_str("(")
        self.builder = b_open
        var i = 0
        while i < field_types.len():
            if i > 0:
                var b_sep = self.builder
                val sep = b_sep.emit_const_str(", ")
                self.builder = b_sep
                acc = self.emit_raw_strcat(acc, sep)
            val field_local = self.lower_tuple_field_raw(local, field_types[i], i)
            val field_raw = self.bootstrap_coerce_to_raw_str(field_local)
            acc = self.emit_raw_strcat(acc, field_raw)
            i = i + 1
        var b_close = self.builder
        val close_paren = b_close.emit_const_str(")")
        self.builder = b_close
        acc = self.emit_raw_strcat(acc, close_paren)
        acc

    me box_runtime_value_local_is_record(local: LocalId) -> bool:
        """True when `local` is known to hold a struct/class value although
        its MIR type may be the erased I64: a struct-name provenance entry, or
        a remembered HIR type naming a Struct/Class symbol. Enums are left
        out on purpose (unit variants may be immediates), and so are bitfield
        values, which are plain integer words."""
        if self.bitfield_value_syms.contains(local.id):
            return false
        if self.struct_value_syms.contains(local.id):
            val record_name = self.struct_value_syms[local.id]
            # Only a name with a registered record layout: struct_value_syms
            # also carries sentinels (`__runtime_array__`, a bare generic
            # parameter name such as `T`), and a newtype over a primitive is
            # an integer word.
            if record_name != "" and self.struct_field_order.contains(record_name) and
                    custom_primitive_underlying_type_tag_by_name(record_name) < 0:
                return true
        if val record_hir_type = self.find_local_hir_type(local.id):
            match record_hir_type.kind:
                case HirTypeKind.Named(record_owner, _):
                    # Bitfields are declared as SymbolKind.Struct, and so are
                    # newtypes over a primitive (lower_type maps those to
                    # their I64/F64/Bool word).
                    if self.bitfield_map.contains(record_owner.id):
                        return false
                    if custom_primitive_underlying_type_tag_by_symbol(record_owner.id) >= 0:
                        return false
                    val record_kind = enum_payload_nominal_kind(record_owner, self.symbols)
                    return record_kind == 1 or record_kind == 2
                case _: ()
        false

    me box_runtime_value(local: LocalId) -> LocalId:
        if self.nil_locals.contains(local.id):
            var nil_builder = self.builder
            val tagged_nil = nil_builder.emit_const_int(3)
            self.builder = nil_builder
            self.mark_runtime_value_local(tagged_nil.id)
            return tagged_nil
        # A scalar renderer result is a tagged text handle even though its MIR
        # ABI type remains I64.  It is already valid RuntimeValue storage, so
        # preserve the handle at an Any/array/dict boundary instead of asking
        # rt_string_new to treat its tagged bits as a raw char*.
        if self.is_runtime_value_local(local.id) or self.is_tagged_text_local(local.id) or self.runtime_array_locals.contains(local.id) or self.runtime_dict_locals.contains(local.id):
            return local
        if self.local_is_str(local):
            # Bug (native_typed_array_text_element_destroyed_at_store_2026-08-24):
            # the `is_tagged_text_local` guard above is a STATIC claim about
            # bookkeeping, and it does not hold for every text local that is
            # ALREADY a tagged handle at runtime -- a plain `a.push("LITERAL")`
            # on a `[text]` reaches here unmarked. `rt_strlen` is not tag-aware,
            # so it read the tagged handle as a raw char* and returned
            # strlen(header+1) == 3 or 4 (the RtCoreString `kind` magic bytes
            # 0x53545231 -> "1RTS", read from offset 1, plus the `reserved`
            # flag byte), and `rt_string_new` then COPIED those header bytes as
            # the element's content. Measured with gdb: rt_interp_cstr on the
            # stored element returned a perfectly valid registered
            # RtCoreString whose data was literally "RTS\001" -- the original
            # text was gone before any read happened, which is why `a[i]`,
            # `.first()` AND `for x in a` were all wrong at once.
            #
            # rt_interp_cstr is the existing representation AUTODETECTOR (it
            # unwraps a tagged handle to its char* data buffer and passes a raw
            # char* through unchanged), already used for exactly this purpose on
            # the read side in decode_runtime_value's Str arm. Normalizing
            # through it makes the store idempotent for both representations
            # without needing the static marking to be complete.
            var cb = self.builder
            val cstr_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_interp_cstr"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
            ))
            val cstr_res = cb.emit_call(cstr_op, [mir_operand_copy(local)], MirType(kind: MirTypeKind.Opaque("str")))
            self.builder = cb
            val raw_cstr = cstr_res ?? local
            val strlen = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_strlen"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
            ))
            var sb = self.builder
            val len = sb.emit_call(strlen, [mir_operand_copy(raw_cstr)], MirType.i64())
            self.builder = sb
            if val length = len:
                val string_new = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_string_new"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                var nb = self.builder
                val tagged = nb.emit_call(string_new, [mir_operand_copy(raw_cstr), mir_operand_copy(length)], MirType.i64())
                self.builder = nb
                if val value = tagged:
                    self.mark_runtime_value_local(value.id)
                    return value
            return local
        val type_ = self.local_mir_type_of(local)
        if type_ == nil:
            return local
        var b = self.builder
        # An erased I64 MIR type is not evidence of an integer. A local whose
        # nominal provenance says struct/class (an untyped `val k = if c:
        # f() else: K(..)` merge, an `if val p = opt` binding, a struct
        # pushed into `[HirExpr]`) is a record handle; int-boxing it turned
        # the pointer into `ptr << 3` before rt_dict_set / rt_array_push
        # (doc/08_tracking/bug/record_local_int_boxed_as_wide_int_2026-10-25.md).
        # A Struct-typed local already passes through via `case _` below.
        if self.box_runtime_value_local_is_record(local):
            self.builder = b
            return local
        val boxed = match type_.kind:
            case MirTypeKind.I64 | MirTypeKind.U64:
                # 64-bit-wide integers are the ONLY kinds that can overflow the
                # tagged immediate's 61-bit payload, so they -- and only they --
                # pay a call. `v << 3` silently sign-extended any |v| >= 2^60
                # back to a different number (2^60 -> negative, i64::MAX -> -1,
                # 2^62 -> 0), corrupting nanosecond timestamps, FNV/xxHash
                # seeds and i64::MAX sentinels merely by entering a container
                # (bug int61_bit_truncation_jit_scalars_and_native_container_
                # boxing_2026-08-09). rt_value_int_wide keeps the identical
                # `v << 3` immediate for in-range values and heap-boxes the
                # rest, which is the escape hatch
                # doc/04_architecture/compiler/array_value_abi_contract.md §1.1
                # already names as normative ("the encoder traps or heap-boxes;
                # silently truncating is a violation"). Mirror unbox is
                # decode_runtime_value's I64/U64 arm (rt_value_as_int_wide).
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                # Fallback first, mirroring the F64 arm's `boxed_opt ?? bits`
                # shape: should the call fail to materialize, the historical
                # inline form is still emitted rather than an unboxed word.
                val shift_wide = b.emit_const_int(3)
                val inline_shifted = b.emit_binop(MirBinOp.Shl, mir_operand_copy(widened), mir_operand_copy(shift_wide), MirType.i64())
                val box_int_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_int_wide"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val boxed_int = b.emit_call(box_int_fn, [mir_operand_copy(widened)], MirType.i64())
                boxed_int ?? inline_shifted
            case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.I16 | MirTypeKind.U16 | MirTypeKind.I32 | MirTypeKind.U32 | MirTypeKind.Char:
                # <= 32 bits: the payload cannot overflow 61 bits, so the
                # inline shift stays (no call, no perf change on these).
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                val shift = b.emit_const_int(3)
                b.emit_binop(MirBinOp.Shl, mir_operand_copy(widened), mir_operand_copy(shift), MirType.i64())
            case MirTypeKind.Bool:
                val widened = b.emit_cast(mir_operand_copy(local), MirType.i64())
                val minus_eight = b.emit_const_int(-8)
                val nineteen = b.emit_const_int(19)
                val scaled = b.emit_binop(MirBinOp.Mul, mir_operand_copy(widened), mir_operand_copy(minus_eight), MirType.i64())
                b.emit_binop(MirBinOp.Add, mir_operand_copy(scaled), mir_operand_copy(nineteen), MirType.i64())
            case MirTypeKind.F32:
                # Widen to f64, then heap-box losslessly (see the F64 arm).
                val promoted = b.emit_cast(mir_operand_copy(local), MirType.f64())
                val bits = b.emit_bitcast(mir_operand_copy(promoted), MirType.i64())
                val box_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_float"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.f64()], return_type: MirType.i64(), is_variadic: false)))
                ))
                # Pass the DOUBLE, not its i64 bit pattern: see the F64 arm.
                val boxed_opt = b.emit_call(box_fn, [mir_operand_copy(promoted)], MirType.i64())
                boxed_opt ?? bits
            case MirTypeKind.F64:
                # Heap-box the f64 losslessly: rt_value_float allocates an
                # RtCoreFloat holding the full double and returns a TAG_HEAP ptr.
                # The old inline `(bits & ~7) | TAG_FLOAT` dropped the low 3
                # mantissa bits, so a container/Any float lost precision
                # ([0.1][0] != 0.1). Passing the raw i64 bits matches the C
                # `rt_value_float(int64_t raw_bits)` ABI; the mirror unbox is
                # decode_runtime_value's F64 arm (rt_value_as_float). A heap alloc
                # cannot be const-folded, so this now materializes at runtime.
                #
                # ABI: the parameter is a `double`, passed in %xmm0 under SysV
                # x86-64 -- NOT the raw i64 bit pattern. The comment above used
                # to claim `rt_value_float(int64_t raw_bits)`; that stopped
                # being true when the C runtime's parameter was corrected to
                # `double` (bug native_lane_prints_every_f64_as_denormal_
                # garbage_2026-08-10). Passing the bitcast i64 put the payload
                # in %rdi while the callee read %xmm0, so EVERY f64 entering a
                # container on the native lane boxed whatever happened to be
                # left in %xmm0 -- the first read printed stale register bytes
                # and the rest printed 0.0. `bits` is retained solely for the
                # `??` fallback's legacy inline form.
                val bits = b.emit_bitcast(mir_operand_copy(local), MirType.i64())
                val box_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_float"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.f64()], return_type: MirType.i64(), is_variadic: false)))
                ))
                val boxed_opt = b.emit_call(box_fn, [mir_operand_copy(local)], MirType.i64())
                boxed_opt ?? bits
            case _:
                local
        self.builder = b
        if boxed.id != local.id:
            self.mark_runtime_value_local(boxed.id)
        boxed

    me infer_empty_array_elem_hir_type(container: LocalId, value_local: LocalId):
        """Adopt the stored elements' type for an unannotated array.

        `var c = []` carries no element type, so `c.first()` / `c.get(i)`
        could not choose a decode and failed as `unresolved method call`.
        Observed stores (push / index-assign) are the only evidence the
        compiler has. The first store's type is recorded as `[T]` only when it
        is positively known (the value's own HIR type, or a text/f64/bool MIR
        local; an i64 MIR type is the erased default and is NOT evidence).
        Every later store must agree (`hir_types_equal`): an unknown or
        different element type poisons the inference (state 2) and records
        `[Error]`, so `first`/`last`/`get` fail loudly instead of decoding
        with the wrong type, and other consumers see the same erased element
        they saw before inference existed. A declared element type is never
        touched (only containers this helper itself typed are revisited)."""
        if not self.local_is_runtime_array(container):
            return
        val state = if self.inferred_array_elem_state.contains(container.id): self.inferred_array_elem_state[container.id] else: 0
        if state == 2:
            return
        if state == 0:
            if val existing = self.find_local_hir_type(container.id):
                match existing.kind:
                    case HirTypeKind.Array(existing_elem, _):
                        match existing_elem.kind:
                            case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any: ()
                            case _: return
                    # An unannotated `var c = []` binding records no element and
                    # may record an unresolved container type; neither is evidence.
                    case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any: ()
                    case _: return
        var elem_kind_found = false
        var elem_type = HirType(kind: HirTypeKind.Error, span: Span.empty())
        if val value_hir = self.find_local_hir_type(value_local.id):
            match value_hir.kind:
                case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Any: ()
                case _:
                    elem_type = value_hir
                    elem_kind_found = true
        if not elem_kind_found:
            if self.local_is_str(value_local):
                elem_type = HirType(kind: HirTypeKind.Str, span: Span.empty())
                elem_kind_found = true
            elif val value_mir = self.local_mir_type_of(value_local):
                match value_mir.kind:
                    case MirTypeKind.F64:
                        elem_type = HirType(kind: HirTypeKind.Float(64), span: Span.empty())
                        elem_kind_found = true
                    case MirTypeKind.Bool:
                        elem_type = HirType(kind: HirTypeKind.Bool, span: Span.empty())
                        elem_kind_found = true
                    case _: ()
        var agrees = elem_kind_found
        if agrees and state == 1:
            agrees = false
            if val inferred = self.find_local_hir_type(container.id):
                match inferred.kind:
                    case HirTypeKind.Array(inferred_elem, _):
                        agrees = hir_types_equal(inferred_elem, elem_type)
                    case _: ()
        if agrees:
            if state == 0:
                self.inferred_array_elem_state[container.id] = 1
                self.remember_local_hir_type(container.id, HirType(kind: HirTypeKind.Array(elem_type, None), span: Span.empty()), 0, 0)
            return
        self.inferred_array_elem_state[container.id] = 2
        if state == 1:
            self.remember_local_hir_type(container.id, HirType(kind: HirTypeKind.Array(HirType(kind: HirTypeKind.Error, span: Span.empty()), None), span: Span.empty()), 0, 0)

    fn array_element_owner_is_enum_v1(owner: text) -> bool:
        # An enum call result carries its enum's qualified layout key in
        # struct_value_syms (the prescan registers a return shape for every
        # Named return), but an enum is a tagged word, not a record. Lending it
        # to array_element_struct_syms made the next index read fail in
        # checked_array_record_layout. Positive test only: an owner whose record
        # layout is merely not demanded yet must keep its element owner.
        # doc/08_tracking/bug/puresql_native_mir_failures_2026-10-25.md (cause 1)
        val identity = result_err_layout_identity(owner)
        if identity == "": return false
        if self.struct_field_order.has(self.declared_struct_layout_key(owner)): return false
        if self.enum_variant_index_q.has(identity) or self.enum_variant_index_q.has(identity.replace("::", ".")):
            return true
        val bare = identity.substring(identity.rfind("::") + 2)
        self.enum_variant_index.contains(bare) and not self.enum_bare_ambiguous.contains(bare)

    # Record the f64/f32 type of a value stored into a container whose
    # declared element type may be the erased i64 default (empty `{}`/`[]`
    # literal). Reads consult runtime_elem_value_type so decode takes the
    # rt_value_as_float arm instead of shredding the heap-box ptr via `>>3`.
    me note_container_elem_type(container: LocalId, value_local: LocalId):
        self.infer_empty_array_elem_hir_type(container, value_local)
        val vt = self.local_mir_type_of(value_local)
        # Presence test does not unwrap; .kind and the concrete
        # runtime_elem_value_type slot need the payload (4710b22a991 class).
        if val present_vt = vt:
            val vt_disc = _sffi_enum_discriminant<MirTypeKind>(present_vt.kind)
            if vt_disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.F64) or vt_disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.F32):
                self.runtime_elem_value_type[container.id] = present_vt
        # Bug (layoutglyph_struct_array_i64_field_tag_shift_readback):
        # lower_array_lit captures a struct-typed element's name into
        # array_element_struct_syms (keyed by the ARRAY's own local id) so
        # expr_dispatch's Index-read case can decode a re-read element as
        # Opaque(struct_name) -- a no-op passthrough, matching
        # box_runtime_value's own no-op for MirTypeKind.Struct. But a
        # container built via an initially-EMPTY `[]`/`{}` literal (fixed at
        # the i64 default, e.g. `var glyphs: [LayoutGlyph] = []`) that is
        # only ever populated via `.push(...)` or `arr[i] = ...` NEVER goes
        # through lower_array_lit's per-element loop, so
        # array_element_struct_syms is never populated for it. The Index-read
        # case then falls through decode_runtime_value's is_integer default
        # (raw >> 3), shredding the struct's heap pointer into a wild address
        # -- the next field access on it (a plain emit_get_field load) then
        # SIGSEGVs, or -- for scalar-looking bit patterns -- silently reads
        # back tag-shifted/masked garbage in every i64 field. Mirror
        # lower_array_lit's capture here (this helper already runs at every
        # push/index-assign call site, before box_runtime_value renames
        # nothing for Struct-kind values) so the read side learns the real
        # element type regardless of how the container was declared.
        val struct_name = self.struct_value_syms.get(value_local.id)
        if val sn = struct_name:
            if sn != "" and not self.array_element_owner_is_enum_v1(sn):
                self.array_element_struct_syms[container.id] = sn
        # Same shredding class, ARRAY elements (nested `[[text]]` /
        # `[[[text]]]`). Nothing else in the pipeline can tell an Index READ
        # that a container's elements are themselves runtime arrays: the
        # `__runtime_array__` sentinel is only ever written from a STRUCT FIELD
        # declaration, never into the per-local map the read consults, and an
        # outer container born from an empty `[]` literal has its element type
        # fixed at the erased i64 default. `outer[i] = inner` stores the inner
        # handle verbatim (box_runtime_value's runtime_array_locals
        # passthrough), so the store is the only site that still knows -- record
        # it here so the read reaches decode_runtime_value's Array arm (handle
        # copied through, runtime_array_locals re-registered) instead of the
        # is_integer `>> 3`, which turned every `outer[i].len()` into a silent
        # 0 while the outer `.len()` stayed correct.
        if self.local_is_runtime_array(value_local):
            var elem_array_type = MirType(kind: MirTypeKind.Array(MirType.i64(), 0))
            val optional_vt: MirType? = vt
            if optional_vt != nil:
                if val present_vt = optional_vt:
                    val concrete_vt: MirType = present_vt
                    match concrete_vt.kind:
                        case MirTypeKind.Array(_, _) | MirTypeKind.Slice(_):
                            elem_array_type = concrete_vt
                        case _:
                            ()
            self.runtime_elem_value_type[container.id] = elem_array_type

    me decode_runtime_value(raw: LocalId, result_type: MirType) -> LocalId:
        var b = self.builder
        val disc = _sffi_enum_discriminant<MirTypeKind>(result_type.kind)
        val is_integer = self.mir_type_is_integer(result_type)
        if is_integer:
            if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.I64) or disc == _sffi_enum_discriminant(MirTypeKind.U64):
                # Mirror of box_runtime_value's I64/U64 arm: a wide value that
                # did not fit the 61-bit tagged immediate is heap-boxed, so a
                # bare `>> 3` would read back a shredded pointer. Narrower
                # integer kinds cannot be heap-boxed and keep the inline shift.
                val unbox_int_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_value_as_int_wide"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
                ))
                val unboxed = b.emit_call(unbox_int_fn, [mir_operand_copy(raw)], MirType.i64())
                if val unboxed_local = unboxed:
                    val decoded_wide = b.emit_cast(mir_operand_copy(unboxed_local), result_type)
                    self.builder = b
                    return decoded_wide
            val shift = b.emit_const_int(3)
            val value = b.emit_binop(MirBinOp.Shr, mir_operand_copy(raw), mir_operand_copy(shift), MirType.i64())
            val decoded = b.emit_cast(mir_operand_copy(value), result_type)
            self.builder = b
            return decoded
        if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Bool):
            val true_value = b.emit_const_int(11)
            val decoded = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_copy(true_value), result_type)
            self.builder = b
            return decoded
        if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.F64):
            # Unbox via rt_value_as_float (dual-aware: heap-boxed lossless form,
            # or legacy inline TAG_FLOAT). Mirrors box_runtime_value's F64 heap
            # box. The old inline `raw & ~7` reinterpret dropped the low 3
            # mantissa bits at read time (a[0] != 0.1). Fallback below keeps the
            # legacy inline decode should the call fail to materialize.
            val unbox_fn = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_value_as_float"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.f64(), is_variadic: false)))
            ))
            val call_res = b.emit_call(unbox_fn, [mir_operand_copy(raw)], result_type)
            if call_res.?:
                val decoded_call = call_res ?? raw
                self.builder = b
                return decoded_call
            val mask = b.emit_const_int(-8)
            val bits = b.emit_binop(MirBinOp.BitAnd, mir_operand_copy(raw), mir_operand_copy(mask), MirType.i64())
            val decoded = b.emit_bitcast(mir_operand_copy(bits), result_type)
            self.builder = b
            return decoded
        if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.F32):
            # Unbox to f64 via rt_value_as_float, then narrow to f32.
            val unbox_fn = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_value_as_float"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.f64(), is_variadic: false)))
            ))
            val call_res = b.emit_call(unbox_fn, [mir_operand_copy(raw)], MirType.f64())
            if call_res.?:
                val f64_local = call_res ?? raw
                val decoded = b.emit_cast(mir_operand_copy(f64_local), result_type)
                self.builder = b
                return decoded
            val mask = b.emit_const_int(-8)
            val bits = b.emit_binop(MirBinOp.BitAnd, mir_operand_copy(raw), mir_operand_copy(mask), MirType.i64())
            val float64 = b.emit_bitcast(mir_operand_copy(bits), MirType.f64())
            val decoded = b.emit_cast(mir_operand_copy(float64), result_type)
            self.builder = b
            return decoded
        if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Array(MirType.i64(), 0)) or disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Slice(MirType.i64())):
            val typed = b.new_temp(result_type)
            b.emit_copy(typed, raw)
            self.runtime_array_locals[typed.id] = true
            self.mark_runtime_value_local(typed.id)
            self.builder = b
            return typed
        if disc == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Dict(MirType.i64(), MirType.i64())):
            val typed = b.new_temp(result_type)
            b.emit_copy(typed, raw)
            self.runtime_dict_locals[typed.id] = true
            self.mark_runtime_value_local(typed.id)
            self.builder = b
            return typed
        if self.mir_type_is_str(result_type):
            # A string element/value read back off an array or dict is a
            # TAGGED heap-string handle (box_runtime_value tags raw string
            # literals via rt_strlen + rt_string_new before storing them),
            # but downstream string consumers (method calls,
            # tag_str_local_if_raw, etc.) expect a RAW char*. Left undecoded,
            # the tagged handle's bits get treated as a raw pointer -> SIGSEGV or
            # garbage (e.g. `for s in ["ab","cd"]: s.len()`). rt_interp_cstr
            # is the existing bug #136 autodetector: unwraps an
            # already-tagged handle to its real char* data buffer, or
            # passes an already-raw char* through unchanged -- so this is
            # safe regardless of which representation `raw` turns out to be.
            val cstr_op = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_interp_cstr"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
            ))
            val cstr_res = b.emit_call(cstr_op, [mir_operand_copy(raw)], MirType(kind: MirTypeKind.Opaque("str")))
            self.builder = b
            if val cstr_local = cstr_res:
                return cstr_local
            return raw
        self.mark_runtime_value_local(raw.id)
        self.builder = b
        raw

    me dict_get_preserve_flat_nil(raw: LocalId, decoded: LocalId, value_type: MirType) -> LocalId:
        """Route `rt_dict_get`'s MISS sentinel around `decode_runtime_value`.

        Bug `native_dict_get_miss_returns_zero_not_nil_2026-07-28`: on a miss
        `rt_dict_get` returns the flat-Option nil sentinel `RT_NIL == 3`
        (`rt_core_nil()`), and every decode arm that TRANSFORMS the raw word
        destroys it -- `3 >> 3` -> `0` (integer), `3 == 11` -> `false` (bool),
        `rt_interp_cstr(3)` -> `NULL` (str). Only the struct/default
        passthrough arm preserved it. A missing key was therefore
        indistinguishable from a stored zero, so `== nil`, `?? default` and
        `val Some(x) = ... else:` every one of them took the PRESENT branch on
        a miss -- silently, with nothing to crash on.

        `d.get(k)` is a FLAT-Option producer by design (see the "Option
        dual-ABI normalization" write-up in switch_operators_calls.spl): its
        `nil` IS the raw word `3`. So the sentinel has to go around the
        decode. `decoded` is already materialised in the current block and is
        harmless on the nil lane (`0` / `NULL`), so this only needs a select,
        not a re-ordering of the decode.
        """
        var merge_type = value_type
        if val decoded_type = self.local_mir_type_of(decoded):
            merge_type = decoded_type
        var b = self.builder
        val nil_key = b.emit_const_int(3)
        val is_nil = b.emit_binop(MirBinOp.Eq, mir_operand_copy(raw), mir_operand_copy(nil_key), MirType.bool())
        val nil_block = b.new_block(Some("dict_get_miss_nil"))
        val value_block = b.new_block(Some("dict_get_hit_value"))
        val merge_block = b.new_block(Some("dict_get_merge"))
        val result = b.new_temp(merge_type)
        b.terminate_if(mir_operand_copy(is_nil), nil_block, value_block)
        self.builder = b

        var b_nil = self.builder
        b_nil.switch_to_block(nil_block)
        val nil_raw = b_nil.emit_const_int(3)
        val nil_typed = b_nil.emit_cast(mir_operand_copy(nil_raw), merge_type)
        b_nil.emit_copy(result, nil_typed)
        b_nil.terminate_goto(merge_block)
        self.builder = b_nil

        var b_val = self.builder
        b_val.switch_to_block(value_block)
        b_val.emit_copy(result, decoded)
        b_val.terminate_goto(merge_block)
        self.builder = b_val

        var b_merge = self.builder
        b_merge.switch_to_block(merge_block)
        self.builder = b_merge
        self.mark_runtime_value_local(result.id)
        result

    me lower_dict_runtime_get(base: HirExpr, base_local: LocalId, dict_key: LocalId) -> LocalId:
        self.lower_dict_runtime_read(base, base_local, dict_key, false)

    me lower_dict_runtime_read(base: HirExpr, base_local: LocalId, dict_key: LocalId, as_option: bool, raw_probe: bool = false) -> LocalId:
        """The one `rt_dict_get` read shared by `d[k]` AND `d.get(k)`.

        `as_option` is true only for `d.get(k)`, whose declared result is
        `V?`: that path must preserve the MISS sentinel (see
        `dict_get_preserve_flat_nil`). `d[k]` (as_option false) keeps its
        existing raw-read behaviour byte for byte -- an index read has no
        `Option` to return, so there is nowhere for a miss signal to go.

        Both forms hit the SAME runtime call, so they must resolve the value
        type and decode identically -- but they had drifted apart, and the
        `.get()` copy was the weaker one (bug
        native_dict_get_struct_value_corrupt_option_2026-07-27):

        - `.get()` resolved the value type with a single unguarded
          `local_mir_type_of` lookup and, whenever that did not yield a
          `Dict(_, V)`, left `get_value_type` at the `MirType.i64()` default.
          `decode_runtime_value` then took its `is_integer` arm and did
          `raw >> 3` on a STRUCT value -- shredding the heap pointer into a
          wild address exactly as described in note_container_elem_type's
          comment above, so the first field read on the result SIGSEGVs
          (`d.get(k)` hit, then `.unwrap().name` -> crash), while a MISS
          stayed correctly nil because nil survives the shift as nil.
        - `.get()` also skipped the Bug #189 struct-symbol registration, so
          even an undamaged pointer lost its struct identity and every field
          access on it fell back to index 0.

        Keeping ONE implementation is the point: the two paths cannot
        re-diverge. Resolution order (widest that is still sound):
        1. the builder-tracked MIR type of the receiver local, accepted only
           behind the discriminant guard so a non-Dict kind can never be
           destructured as `Dict(_, V)`;
        2. the HIR annotation on the receiver expression -- now consulted
           whenever step 1 did not actually produce a Dict value type (it
           used to be gated on the local being entirely untracked, which made
           it nearly dead code: locals are almost always registered, just not
           always with a Dict type -- e.g. a `Dict`-typed STRUCT FIELD read,
           whose projection temp is typed i64 when the field access carries
           no HIR type);
        3. the store-observed element type, for an empty dict literal whose
           declared value type is stuck at the erased i64 default (an f64
           stored later would otherwise decode via `>>3` and leak the
           heap-box POINTER).
        """
        var dict_result_type = MirType.i64()
        var dict_value_hir_type: HirType? = nil
        var resolved_from_local = false
        var resolved_dict_mir_type = MirType.i64()
        val has_dict_mir_type = if val type_ = self.builder.local_type(base_local):
            resolved_dict_mir_type = type_
            true
        else:
            false
        if has_dict_mir_type:
            if _sffi_enum_discriminant<MirTypeKind>(resolved_dict_mir_type.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Dict(MirType.i64(), MirType.i64())):
                match resolved_dict_mir_type.kind:
                    case MirTypeKind.Dict(_, value_type):
                        dict_result_type = value_type
                        resolved_from_local = true
                    case _: ()
        # Global storage and projected fields can use an i64 handle while
        # their semantic Dict type lives in the declaration/local metadata.
        # Never decode a nominal value as an integer just because the handle
        # erased the builder's Dict(K,V) type.
        # The HIR value type V is resolved from the same three sources
        # (expression type, remembered local type, declared receiver type)
        # whether or not the builder's Dict(K, V) MIR type already fixed the
        # decode: `d.get(k)` needs V for its `V?` tag either way.
        if base.has_type_ == true and base.type_ != nil:
            dict_value_hir_type = self.runtime_dict_value_hir_type(base.type_)
        if dict_value_hir_type == nil:
            if val remembered_dict = self.find_local_hir_type(base_local.id):
                dict_value_hir_type = self.runtime_dict_value_hir_type(remembered_dict)
        if dict_value_hir_type == nil:
            if val declared_dict = self.receiver_declared_type(base):
                dict_value_hir_type = self.runtime_dict_value_hir_type(declared_dict)
        val value_type_from_hir = not resolved_from_local and dict_value_hir_type != nil
        if value_type_from_hir:
            if val hir_value_type = dict_value_hir_type:
                dict_result_type = self.lower_type(hir_value_type)
                resolved_from_local = true
        # A builder-tracked `Dict(K, i64)` is often the ERASED default (field
        # projection / codec temp), not the declared V. When the HIR V is
        # Bool, the i64 `>>3` arm would turn a stored true/false into int 1/0
        # (bug native_dict_bool_index_int_2026-10-25), so prefer the HIR V.
        if not value_type_from_hir and _sffi_enum_discriminant<MirTypeKind>(dict_result_type.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.I64):
            if val hir_v = dict_value_hir_type:
                val hir_v_mir = self.lower_type(hir_v)
                if _sffi_enum_discriminant<MirTypeKind>(hir_v_mir.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.Bool):
                    dict_result_type = hir_v_mir
        # Store-side refinement: an empty `{}` literal fixes the declared
        # value type at the i64 default, so an f64 stored later would decode
        # via the integer `>>3` arm and leak the heap-box POINTER. Use the
        # store-observed type instead.
        if _sffi_enum_discriminant<MirTypeKind>(dict_result_type.kind) == _sffi_enum_discriminant<MirTypeKind>(MirTypeKind.I64):
            if val noted_value_type = self.noted_runtime_elem_type(base_local):
                dict_result_type = noted_value_type
        val get_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_dict_get"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_dget = self.builder
        val get_res = b_dget.emit_call(get_op, [mir_operand_copy(base_local), mir_operand_copy(dict_key)], MirType.i64())
        self.builder = b_dget
        if val get_local = get_res:
            if raw_probe and dict_value_hir_type != nil:
                # `d[k] ?? x`: hand the consumer the UNDECODED word. Its
                # present branch is the single decode (decode_runtime_value
                # on a runtime-value local), and its rt_is_some test sees the
                # miss word 3 intact. Decoding here as well would decode a
                # hit twice (an i64 5 -> 5>>3 = 0), which is what the
                # decoded `as_option` lane does under `??`. Only taken when
                # the declared value type V is known: the `??` present branch
                # recovers its decode type from the Optional(V) recorded
                # here, so without V fall through to the decoded read.
                self.mark_runtime_value_local(get_local.id)
                if val probe_value_hir_type = dict_value_hir_type:
                    val probe_value_type: HirType = probe_value_hir_type
                    self.remember_local_hir_type(get_local.id, HirType(kind: HirTypeKind.Optional(probe_value_type), span: base.span), 0, 0)
                # Bug #189 parity: carry the store-observed struct name.
                val probe_struct_name = self.array_element_struct_syms.get(base_local.id) ?? ""
                if probe_struct_name != "" and probe_struct_name != "__runtime_array__":
                    self.struct_value_syms[get_local.id] = probe_struct_name
                return get_local
            var value_is_bool = false
            match dict_result_type.kind:
                case MirTypeKind.Bool: value_is_bool = true
                case _: ()
            if as_option and value_is_bool:
                # `Option<bool>` has THREE states -- true, false and nil -- and
                # an `i1` can hold two. The decode arm collapses the raw word
                # to `raw == 11`, which both loses the miss sentinel AND made a
                # present `true` compare equal to `nil`. The flat ABI already
                # encodes all three in one word (11 / 0 / 3) and
                # `option_bool_value` (switch_operators_calls.spl) is its
                # matching decode, so hand the raw word back undecoded.
                self.mark_runtime_value_local(get_local.id)
                return get_local
            var decoded = self.decode_runtime_value(get_local, dict_result_type)
            # Only the decode arms that TRANSFORM the raw word destroy the miss
            # sentinel, and only those may be guarded: the struct / enum /
            # array / dict arms already pass `3` through untouched (so nil
            # already survives), and re-casting the sentinel into one of their
            # aggregate representations would be nonsense. f64 is deliberately
            # excluded too -- `rt_value_as_float` cannot round-trip a sentinel,
            # and an `Option<f64>` has no room for one in the flat ABI either
            # (tracked with the bool case in the bug doc).
            val guardable_value_type = self.mir_type_is_integer(dict_result_type) or self.mir_type_is_str(dict_result_type)
            if as_option and guardable_value_type:
                decoded = self.dict_get_preserve_flat_nil(get_local, decoded, dict_result_type)
            if val present_value_hir_type = dict_value_hir_type:
                val value_hir_type: HirType = present_value_hir_type
                if as_option:
                    # `d.get(k)` is declared `V?`: retain it so a later
                    # `x.unwrap()` / `x ?? d` on the binding sees an Option
                    # receiver instead of an untyped word.
                    self.remember_local_hir_type(decoded.id, HirType(kind: HirTypeKind.Optional(value_hir_type), span: base.span), 0, 0)
                else:
                    # bug=enum_payload_type_mismatch_dict_elem_untyped_2026-10-24:
                    # the declared V is the read's type whichever source fixed
                    # the MIR decode. Gating this on value_type_from_hir left
                    # `self.impls[k]` (MIR Dict(K, V) already known) untyped,
                    # so `xs[i]` on the binding had no element owner.
                    self.remember_local_hir_type(decoded.id, value_hir_type, 0, 0)
            # Bug #189 (struct-valued Dict read misread): a struct-typed dict
            # result decodes via decode_runtime_value's default raw-passthrough
            # arm (no shift, correct bits), but that arm does not register the
            # VALUE's struct NAME in struct_value_syms the way lower_array_lit
            # already does via array_element_struct_syms. resolve_field_index's
            # fallback chain (HIR type annotation, then struct_value_syms keyed
            # by this local) then finds neither for a freshly-decoded dict-read
            # result and silently defaults every field access to index 0 --
            # `m["k1"].y` read `x`'s value instead of `y`'s (only invisible for
            # single-field structs, where field 0 IS the only field).
            # dict_result_type is already the correctly-resolved
            # Struct(symbol) here, so just look up its name and propagate it
            # the same way the array path does.
            var dict_struct_name = ""
            var dbg_arm_taken = false
            var dbg_sym_id = -1
            var dbg_sym_found = false
            match dict_result_type.kind:
                case MirTypeKind.Struct(struct_symbol):
                    dbg_arm_taken = true
                    dbg_sym_id = struct_symbol.id
                    dict_struct_name = self.mir_struct_symbol_name(struct_symbol)
                    dbg_sym_found = dict_struct_name != ""
                case _: ()
            # Bug #189, second half. The `Struct(symbol)` resolution above gets
            # the TYPE right -- decode_runtime_value takes the correct
            # raw-passthrough arm and the struct's bits survive intact, which is
            # why `.x` (field 0) always looked fine. But the numeric SymbolId
            # carried in the MIR type does NOT reliably resolve back to a named
            # symbol at this point in lowering, so `struct_value_syms` was never
            # written and `resolve_field_index` fell through its whole chain to
            # `0  # Default fallback` -- making EVERY field read return field 0's
            # word. `m["k"].y` returned `x` (invisible for a single-field
            # struct, where field 0 is the only field).
            #
            # `resolve_field_index`'s own leading comment states the rule this
            # restores: "Numeric SymbolIds are local to each module and can
            # collide ... A lowered local's name-keyed provenance is therefore
            # authoritative when available." The store side already recorded
            # exactly that name: `note_container_elem_type` runs at every
            # `d[k] = v` / push site and writes the value's struct NAME into
            # `array_element_struct_syms` keyed by the CONTAINER local. The
            # array Index-read path consumes it; the dict read never did. Use it
            # as the name-keyed fallback so both container reads agree.
            if dict_struct_name == "":
                val store_seen_name = self.array_element_struct_syms.get(base_local.id) ?? ""
                if store_seen_name != "" and store_seen_name != "__runtime_array__":
                    dict_struct_name = store_seen_name
            if dict_struct_name != "":
                self.struct_value_syms[decoded.id] = dict_struct_name
            if (mir_expr_env_get("SIMPLE_MIR_FIELD_TRACE") ?? "") == "1":
                val dbg_aes = self.array_element_struct_syms.get(base_local.id) ?? "<none>"
                print "[dict-read] base={base_local.id} decoded={decoded.id} arm={dbg_arm_taken} sym_id={dbg_sym_id} sym_found={dbg_sym_found} from_local={resolved_from_local} name='{dict_struct_name}' aes='{dbg_aes}'"
            return decoded
        base_local

    me host_gpu_runtime_func(name: text) -> MirOperand:
        MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(name),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))

    me split_interpolation_segments(value: text) -> [text]:
        """Bug #136: split an interpolated string literal into its N+1 literal
        text segments around N top-level `{...}` interpolation regions.

        The lexer copies each `{expr}` VERBATIM into `value`, so the literal
        text between/around the `{...}` regions is exactly what should surround
        the lowered interpolation-expr results. Brace depth is tracked so nested
        braces inside an expr (e.g. `{f({a: 1})}`) stay inside one region. Chars
        inside a `{...}` region are dropped here (the parsed expr is lowered
        separately from the interpolations list). Returns segments interleaving
        positionally with the interpolation exprs: seg0, expr0, seg1, ..., segN.
        """
        var segments: [text] = []
        var cur = ""
        var depth = 0
        var i = 0
        val n = value.len()
        while i < n:
            val ch = value[i:i + 1]
            val ch_next = if i + 1 < n: value[i + 1:i + 2] else: ""
            if depth == 0 and ch == "{" and ch_next == "{":
                # `{{` escape (doc
                # interp_brace_literal_collides_with_string_interpolation):
                # decode to a literal `{` in the segment text, do not open a
                # region. Must mirror flat_bridge_build_string_interps's
                # (10.frontend) identical skip exactly, or the regions found
                # here would drift out of positional alignment with that
                # function's interps list.
                cur = cur + "{"
                i = i + 1
            elif depth == 0 and ch == "}" and ch_next == "}":
                # `}}` escape, mirror of `{{` above.
                cur = cur + "}"
                i = i + 1
            elif depth == 0 and ch == "{":
                segments = segments.push(cur)
                cur = ""
                depth = 1
            elif depth > 0 and ch == "{":
                depth = depth + 1
            elif depth > 0 and ch == "}":
                depth = depth - 1
            elif depth == 0:
                cur = cur + ch
            i = i + 1
        segments = segments.push(cur)
        segments

    me emit_bootstrap_str_const(value: text) -> LocalId:
        """Emit a raw string-const local (an Opaque `str` char* pointer)."""
        var b = self.builder
        val dest = b.new_temp(MirType(kind: MirTypeKind.Opaque("str")))
        b.emit_const(dest, MirConstValue.Str(value), MirType(kind: MirTypeKind.Opaque("str")))
        self.builder = b
        dest

    me lower_string_interpolation(value: text, interps: [HirInterpolation]) -> LocalId:
        """Bug #136: lower an interpolated string literal to a real concatenated
        raw char* value instead of discarding the `{expr}` parts and emitting
        the verbatim literal.

        Split `value` into literal segments around the top-level `{...}` regions
        (positionally aligned with `interps`), lower each interpolation expr, and
        coerce it to a raw C string via rt_interp_cstr (handles both a tagged
        heap string -> its buffer, and an already-raw char* -> passthrough --
        the operands are statically undiscriminable). Concatenate the alternating
        [seg0, cstr(expr0), seg1, cstr(expr1), ..., segN] with rt_strcat, which
        takes and returns raw char*. The result is a raw char* (Opaque `str`),
        the same representation a plain string literal produces, so downstream
        consumers (rt_println, etc.) are unaffected.
        """
        val segments = self.split_interpolation_segments(value)
        # Number of interpolation slots to emit: guard against any mismatch
        # between {...} regions found and the parsed interps list.
        var slot_count = interps.len()
        if segments.len() - 1 < slot_count:
            slot_count = segments.len() - 1

        # result starts as the first literal segment (raw char*).
        # Two statements, NOT nested `self.a(self.b(...))`: a nested me-call in
        # argument position snapshots the receiver BEFORE the argument call's
        # builder mutations, so the outer method's write-back clobbers the
        # str-const emission and rewinds next_local_id -> the coerce call's
        # fresh dest collides with its own operand (`%lN = rt_interp_cstr(%lN)`,
        # llc "Only PHI nodes may reference their own value").
        val seg0_local = self.emit_bootstrap_str_const(segments[0])
        var result_local = self.bootstrap_coerce_to_raw_str(seg0_local)

        var k = 0
        while k < slot_count:
            # Lower the interpolation expr, then coerce to raw char* at runtime.
            # Intermediate var for the index access (seed chained-access quirk).
            val interp_item: HirInterpolation = interps[k]
            val interp_expr = interp_item.expr
            val interp_local = self.lower_expr(interp_expr)
            # Bug #136: coerce the operand to a raw char*. A string operand
            # (Opaque "str") passes straight through rt_interp_cstr. A non-string
            # operand -- e.g. `{a}` / `{a+b}` where `a` is an i64 -- must first be
            # rendered to a decimal string via rt_raw_i64_to_string (a tagged
            # string), which rt_interp_cstr then unwraps to its char* buffer.
            # Without this, rt_interp_cstr treats the raw i64 as a char* pointer
            # and derefs it -> SIGSEGV. The operand's lowered MIR type drives the
            # choice; a `val x = <int>` binding propagates the i64 init type to
            # the local so `{x}` routes to the numeric path.
            #
            # native_interp_bool_float: the old inline check here only tested
            # for Opaque("str") and otherwise ALWAYS rendered via
            # rt_raw_i64_to_string, so `"{3<5}"` printed "1"/"0" instead of
            # "true"/"false" (a bool's tag-adjusted i64 bit pattern misread as
            # a small decimal) and `"{2.5}"` printed garbage (an f64 bit
            # pattern reinterpreted as an integer via rt_raw_i64_to_string's
            # %lld format). coerce_concat_operand already implements the
            # exact type dispatch this needs -- str passthrough, else
            # bool/f32(widened)/f64/u64/i64 routed to the matching
            # rt_raw_*_to_string renderer, mirroring
            # lower_bootstrap_print_call -- so reuse it instead of
            # duplicating (and under-covering) that dispatch here. Its
            # output (str passthrough, or a freshly rt_raw_*_to_string
            # TAGGED handle) is exactly the shape rt_interp_cstr already
            # expects downstream.
            val cstr_local = self.bootstrap_coerce_to_raw_str(interp_local)
            result_local = self.emit_raw_strcat(result_local, cstr_local)
            # Append the following literal segment (split statements — see the
            # nested-me-call receiver-snapshot note on seg0 above).
            val next_seg_const = self.emit_bootstrap_str_const(segments[k + 1])
            val next_seg = self.bootstrap_coerce_to_raw_str(next_seg_const)
            result_local = self.emit_raw_strcat(result_local, next_seg)
            k = k + 1

        result_local

    me emit_raw_strcat(left: LocalId, right: LocalId) -> LocalId:
        """Concatenate two raw char* locals via rt_strcat (raw char* -> raw char*)."""
        val strcat_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_strcat"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType(kind: MirTypeKind.Opaque("str")), is_variadic: false)))
        ))
        var b = self.builder
        val res = b.emit_call(strcat_op, [mir_operand_copy(left), mir_operand_copy(right)], MirType(kind: MirTypeKind.Opaque("str")))
        self.builder = b
        if val res_local = res:
            res_local
        else:
            left

    me emit_host_gpu_runtime_call(name: text, args: [MirOperand]):
        var b = self.builder
        b.emit_call(self.host_gpu_runtime_func(name), args, MirType.i64())
        self.builder = b

    me lower_host_gpu_lane(lane_code: i64, payload_size: i64, marker: HirExpr, body: HirBlock) -> LocalId:
        self.lower_expr(marker)
        self.emit_host_gpu_runtime_call("rt_host_gpu_lane_event", [
            mir_operand_const_int(lane_code),
            mir_operand_const_int(1)
        ])
        if lane_code == 2:
            self.emit_host_gpu_runtime_call("rt_host_gpu_queue_emit", [
                mir_operand_const_int(lane_code),
                mir_operand_const_int(1),
                mir_operand_const_int(payload_size),
                mir_operand_const_int(0)
            ])
        self.lower_block(body)
        self.emit_host_gpu_runtime_call("rt_host_gpu_lane_event", [
            mir_operand_const_int(lane_code),
            mir_operand_const_int(2)
        ])
        var b = self.builder
        val result = b.new_temp(MirType.unit())
        self.builder = b
        result

    me emit_bounds_check_for_index(base_type: HirType?, base_local: LocalId, index_local: LocalId):
        """Emit an explicit bounds_check intrinsic before MIR indexed access."""
        # NOTE: avoid Option.unwrap() here -- the seed interpreter mishandles
        # .unwrap() on a "present" struct optional (a present optional is
        # stored as the bare payload; see mir_lowering_stmts.spl lower_stmt
        # and method_calls_literals.spl lower_method_call for the same
        # documented workaround). Use the explicit `if val` bind instead,
        # which correctly yields the bare HirType.
        var len_symbol = ""
        if val found_base_type = base_type:
            len_symbol = self.len_runtime_symbol_for_hir_type(found_base_type)
        if len_symbol == "":
            if self.local_is_runtime_array(base_local):
                len_symbol = "rt_array_len"
            else:
                # LOUD bailout (SF1 (d), 2026-07-28): no len symbol exists
                # for this base type, so no conservative check can be
                # emitted (there is no length source to compare against).
                # The indexed access proceeds UNCHECKED. Counted via
                # mir_bounds_check_bailouts(); per-site detail under
                # SIMPLE_MIR_BOUNDS_DEBUG=1.
                mir_bounds_check_bailout_count = mir_bounds_check_bailout_count + 1
                if (mir_expr_env_get("SIMPLE_MIR_BOUNDS_DEBUG") ?? "") == "1":
                    print("[mir] bounds-check bailout #{mir_bounds_check_bailout_count}: no len symbol for indexed base local {base_local.id} (access is UNCHECKED)")
                return
        val func_operand = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(len_symbol),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b = self.builder
        val len_result = b.emit_call(func_operand, [mir_operand_copy(base_local)], MirType.i64())
        if val len_local = len_result:
            val optional_dest: LocalId? = nil
            b.emit(MirInst(
                kind: MirInstKind.Intrinsic(optional_dest, "bounds_check", [
                    mir_operand_copy(index_local),
                    mir_operand_copy(len_local)
                ]),
                span: b.current_span
            ))
        self.builder = b

    me resolved_call_hir_return_type(symbol: SymbolId) -> HirType?:
        # Bare-lift accumulator + explicit tail: explicit Some(...) on return
        # and mixed return/implicit-tail are both miscompiled on the stage4
        # native lane (bug doc 2026-07-23).
        # Primary source: declared return types recorded in the lower_module
        # pre-pass (fn_return_types, mir_lowering_types.spl) — the symbol
        # table's fn type_ is NOT reliably Function(...)-kind on this lane
        # (unresolved infer var observed). Bare-lift assign, no Some().
        if self.fn_return_types.contains(symbol.id):
            return self.fn_return_types[symbol.id]
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            if val sym_type = found_sym.type_:
                match sym_type.kind:
                    case HirTypeKind.Function(_, ret, _):
                        return ret
                    case _:
                        ()
            # Shared fallback carries symbol-free shapes only; Named return
            # types must come from the consumer's relocated signature above.
            if val reg_ret = bootstrap_fn_ret_hir_type_lookup(found_sym.name):
                return reg_ret
        nil

    me resolved_call_result_ok_shape(symbol: SymbolId) -> text?:
        """Cross-module-safe Ok-payload struct/class NAME for a `Result<T,E>`-
        returning callee, keyed by NAME (bootstrap_fn_ret_ok_shape_*) rather
        than the callee's per-module-table SymbolId.

        `resolved_call_hir_return_type` above already solves this for the
        OUTER declared return type via a name-keyed registry, but the HirType
        it returns for a Result-kind callee still carries the Ok payload as
        `HirTypeKind.Named(SymbolId)` verbatim, exactly as it was captured in
        the DEFINING module's own SymbolTable. Entry-closure lowering replaces
        the active SymbolTable per module, so that inner SymbolId is only
        valid there — dereferencing it against `self.symbols` while lowering
        a DIFFERENT (importing) module can coincidentally land on an
        unrelated symbol that happens to share the same numeric id (e.g. a
        sibling Method), silently mis-resolving the payload's struct name.
        See native_build_cross_module_result_payload_struct_name_collision_
        2026-08-09 (6th/7th layer)."""
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            val provider_name = self.provider_callable_symbol_name(symbol, found_sym.name)
            if val provider_shape = bootstrap_fn_ret_ok_shape_lookup(provider_name):
                return Some(provider_shape)
            if val shape = bootstrap_fn_ret_ok_shape_lookup(found_sym.name):
                return Some(shape)
        nil

    me resolved_call_result_opt_shape(symbol: SymbolId) -> text?:
        """Cross-module-safe payload struct/class NAME for an `Optional<T>`-
        returning callee. Exact sibling of `resolved_call_result_ok_shape`
        above, over the `bootstrap_fn_ret_opt_shape_*` registry the prescan
        fills at the same point and for the same reason."""
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            val provider_name = self.provider_callable_symbol_name(symbol, found_sym.name)
            if val provider_shape = bootstrap_fn_ret_opt_shape_lookup(provider_name):
                return Some(provider_shape)
            if val shape = bootstrap_fn_ret_opt_shape_lookup(found_sym.name):
                return Some(shape)
        nil

    me resolved_call_payload_shape(symbol: SymbolId, variant: text) -> text?:
        """Route a matched variant to the registry that owns its payload name.

        `Ok` -> the Result registry, `Some` -> the Optional registry; anything
        else answers nil rather than guessing, so a variant this lowering does
        not model can never borrow another one's payload layout."""
        if variant == "Ok":
            return self.resolved_call_result_ok_shape(symbol)
        if variant == "Some":
            return self.resolved_call_result_opt_shape(symbol)
        nil

    me field_array_element_override(struct_name: text, field_idx: i64) -> HirType?:
        if self.struct_field_array_elem_type.contains(struct_name):
            val element_types: [HirType] = self.struct_field_array_elem_type[struct_name]
            if field_idx >= 0 and field_idx < element_types.len():
                val element_type = element_types[field_idx]
                match element_type.kind:
                    case HirTypeKind.Error: return nil
                    case _: return self.declared_record_array_element(struct_name, field_idx, element_type)
        nil

    me resolved_call_hir_param_types(symbol: SymbolId) -> [HirType]:
        val sym = self.symbols.get_symbol_raw(symbol.id)
        if val found_sym = sym:
            # Cross-module declared param types (same prescan registry as
            # return types): without this a `fn f(a: i32, b: i64)` callee in
            # another module erased to all-i64 at the call site and rv32
            # marshaled the i64 into the wrong (unaligned) register pair.
            if val reg_params = bootstrap_fn_param_hir_types_lookup(found_sym.name):
                return reg_params
            if val sym_type = found_sym.type_:
                match sym_type.kind:
                    case HirTypeKind.Function(params, _, _):
                        return params
                    case _:
                        ()
        []

    me remember_call_hir_return(local: LocalId, symbol: SymbolId):
        self.remember_result_err_record_owner(local.id, symbol)
        val optional_call_symbol: HirSymbol? = self.symbols.get_symbol_raw(symbol.id)
        if optional_call_symbol != nil:
            if val present_call_symbol = optional_call_symbol:
                val call_symbol: HirSymbol = present_call_symbol
                val return_shape = bootstrap_fn_ret_shape_lookup(call_symbol.name)
                if return_shape != nil:
                    # A callee returning a struct it IMPORTS registered the import
                    # symbol's dotted-owner key; the layout lives under the key the
                    # declaring module registered. Fold onto that one, else
                    # resolve_field_index finds no field list and reads index 0.
                    val shape = self.declared_struct_layout_key(return_shape ?? "")
                    if shape == "__runtime_array__":
                        self.runtime_array_locals[local.id] = true
                        self.remember_direct_array_return_element(local, call_symbol.name)
                    elif shape != "":
                        self.struct_value_syms[local.id] = shape
        val return_type = self.resolved_call_hir_return_type(symbol)
        if self.extern_fn_symbols.contains(symbol.id):
            self.extern_result_locals[local.id] = true
        if val found_type = return_type:
            self.remember_local_hir_type(local.id, found_type, 0, 0)
            match found_type.kind:
                case HirTypeKind.Array(element, size):
                    if val present_call_symbol = optional_call_symbol:
                        val call_symbol: HirSymbol = present_call_symbol
                        if val shape = bootstrap_fn_ret_array_element_shape_lookup(call_symbol.name):
                            val rebound = self.rebind_record_element_owner(element, shape)
                            self.remember_local_hir_type(local.id, HirType(kind: HirTypeKind.Array(rebound, size), span: found_type.span), 0, 0)
                    # Same recovery as the Named arm below: the name-keyed
                    # element registry can miss, and then the untyped
                    # `val lines = make_lines(s)` binding inherited no
                    # array_element_struct_syms row from this temp.
                    if not self.array_element_struct_syms.contains(local.id):
                        val array_return_elem_owner = self.optional_payload_struct_name(element)
                        if array_return_elem_owner != "":
                            self.array_element_struct_syms[local.id] = array_return_elem_owner
                case HirTypeKind.Slice(element):
                    if val present_call_symbol = optional_call_symbol:
                        val call_symbol: HirSymbol = present_call_symbol
                        if val shape = bootstrap_fn_ret_array_element_shape_lookup(call_symbol.name):
                            val rebound = self.rebind_record_element_owner(element, shape)
                            self.remember_local_hir_type(local.id, HirType(kind: HirTypeKind.Slice(rebound), span: found_type.span), 0, 0)
                case HirTypeKind.Optional(optional_inner):
                    self.option_value_locals[local.id] = true
                    self.mark_runtime_value_local(local.id)
                    # Optional payload provenance (BOOT-11). A callee declared
                    # `-> T` gets T's layout key and a callee declared
                    # `-> Result<T, E>` additionally gets the Ok payload's NAME
                    # (bootstrap_fn_ret_ok_shape_register, module_lowering.spl
                    # prescan). A callee declared `-> T?` gets NEITHER: that
                    # prescan's match has Named/Array/Slice/Result arms and no
                    # Optional arm, and trait_impl_lowering.spl's
                    # method_return_struct_names sets "" for `case Optional(_)`.
                    # So `bootstrap_fn_ret_shape_lookup` above leaves this local
                    # with no struct_value_syms entry, `if val fp = <that call>`
                    # ALIASES the same local (maybe_copy_struct_value returns nil
                    # unless the local's MirType is Struct(...), which an
                    # optional's never is), and `fp.size` then reaches
                    # resolve_field_index with its name-keyed tier empty --
                    # falling through to the numeric-SymbolId `field_map` tier,
                    # which collides across modules in an entry-closure build,
                    # and finally to a silent index 0. That is
                    # `field=310824753:runtime=1080` in
                    # stage2_capsule_receipt_size_canary_blocks_linux_admission
                    # _2026-09-13.md and `920329169` in
                    # native_optional_unwrap_field_index_by_name_collision
                    # _2026-09-12.md.
                    val registered_payload = self.resolved_call_payload_shape(symbol, "Some")
                    val optional_payload_name = if val registered = registered_payload:
                        self.declared_struct_layout_key(registered)
                    else:
                        self.optional_payload_struct_name(optional_inner)
                    if val registered = registered_payload:
                        val rebound: HirType = self.rebind_record_element_owner(optional_inner, registered)
                        self.remember_local_hir_type(local.id, HirType(kind: HirTypeKind.Optional(rebound), span: found_type.span), 0, 0)
                    if optional_payload_name != "":
                        if not self.struct_value_syms.contains(local.id):
                            self.struct_value_syms[local.id] = optional_payload_name
                case HirTypeKind.Any:
                    # The callee's return boundary guarantees a tagged word;
                    # retain that fact after Any erases to MIR i64.
                    self.mark_runtime_value_local(local.id)
                case HirTypeKind.Named(_, _):
                    # The name-keyed shape registry above answers nothing for
                    # a free-fn name defined in two closure modules (e.g.
                    # `run_spl_doctests_same_file` / `extract_skip_feature_info`
                    # exist in both src/lib and src/app/test_runner_new), so
                    # the call result lost its struct identity and
                    # `info.status.lower()` / `for b in r.blocks:` failed.
                    # The callee's signature relocated into THIS module's
                    # table still names the struct; recover it with the same
                    # fail-closed Struct/Class + known-layout gate.
                    if not self.struct_value_syms.contains(local.id):
                        val named_return_struct = self.optional_payload_struct_name(found_type)
                        if named_return_struct != "":
                            self.struct_value_syms[local.id] = named_return_struct
                case _:
                    ()

    me optional_payload_struct_name(inner: HirType) -> text:
        """Struct/class NAME carried by an `Optional<T>` return, or "".

        Fails closed twice: the payload symbol must resolve to a Class/Struct,
        and its bare name must already be a layout this lowering knows
        (`struct_field_order`), which is exactly the table
        `resolve_field_index`'s name-keyed tier reads. A name that fails either
        test is discarded rather than guessed, so the worst case is the
        pre-existing behaviour (no provenance), never a NEW wrong index.

        The `Named(SymbolId)` this dereferences was captured in the DEFINING
        module's own SymbolTable (the declared return type reaches here through
        the name-keyed `bootstrap_fn_ret_hir_type_*` registry), so the id-space
        hazard documented on `resolved_call_result_ok_shape` applies here too.
        This is the same exposure the shipped `result_variant_payload_type`
        consumer already carries for a Result payload
        (switch_operators_calls.spl, the `known_rpt` branch); the
        `struct_field_order` gate below is what keeps a collided id from
        naming a layout that does not exist.
        """
        if inner == nil:
            return ""
        match inner.kind:
            case HirTypeKind.Named(optional_payload_sym, _):
                val raw_symbol: HirSymbol? = self.symbols.get_symbol_raw(optional_payload_sym.id)
                if val present_payload_symbol = raw_symbol:
                    val optional_payload_symbol: HirSymbol = present_payload_symbol
                    # A class is keyed by its owner identity everywhere this
                    # name is consumed (register_provider_class layouts and
                    # `{identity}::{method}` dispatch rows, the opt/ok shape
                    # prescan); its bare name exists only for a local class.
                    # Answering the bare name failed the layout gate for every
                    # IMPORTED class, so `if val a = maybe_reg(1): a.activate()`
                    # lost the receiver class and died as `unresolved method
                    # call`. Structs keep their bare-name convention.
                    var payload_key = ""
                    match optional_payload_symbol.kind:
                        case SymbolKind.Class:
                            payload_key = mir_class_identity(optional_payload_symbol)
                        case SymbolKind.Struct:
                            payload_key = optional_payload_symbol.name
                        case _:
                            return ""
                    if not self.struct_field_order.contains(payload_key):
                        return ""
                    return payload_key
            case _:
                ()
        ""

    me remember_function_value_return(local: LocalId, type_: HirType):
        self.remember_local_hir_type(local.id, type_, 0, 0)
        match type_.kind:
            case HirTypeKind.Named(owner, _):
                if val declaration = self.symbols.get_symbol_raw(owner.id):
                    var layout = ""
                    match declaration.kind:
                        case SymbolKind.Struct:
                            layout = self.declared_struct_layout_key(self.composite_layout_key(declaration))
                        case SymbolKind.Class:
                            layout = mir_class_identity(declaration)
                        case _: return
                    if layout != "" and self.struct_field_order.has(layout):
                        self.struct_value_syms[local.id] = layout
                    else:
                        self.error_fatal("indirect call return record has no declared owner layout", Some(type_.span))
                else:
                    self.error_fatal("indirect call return type has no declaration", Some(type_.span))
            case HirTypeKind.Optional(_):
                self.option_value_locals[local.id] = true
                self.mark_runtime_value_local(local.id)
            case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                self.runtime_array_locals[local.id] = true
                self.mark_runtime_value_local(local.id)
            case HirTypeKind.Dict(_, _):
                self.runtime_dict_locals[local.id] = true
                self.mark_runtime_value_local(local.id)
            case HirTypeKind.Any:
                self.mark_runtime_value_local(local.id)
            case _: ()

    me resolved_call_return_type(symbol: SymbolId) -> MirType:
        val hir_return_type = self.resolved_call_hir_return_type(symbol)
        if val found_type = hir_return_type:
            match found_type.kind:
                case HirTypeKind.Str:
                    # Call results carry runtime text HANDLES — same repr as
                    # literals (Opaque("str"), see bootstrap_text_type), NOT
                    # lower_type(Str)'s (ptr,len) fat-pointer Tuple. The Tuple
                    # typing sent user-fn text returns down the aggregate
                    # path and print rendered them as decimals.
                    return self.bootstrap_text_type()
                case _:
                    return self.lower_type(found_type)
        MirType.i64()

    me bitfield_field_mask(bit_width: i64) -> i64:
        """Return a signed i64 mask for a bitfield slice, including full-width fields."""
        if bit_width <= 0:
            return 0
        if bit_width >= 64:
            return -1
        (1 << bit_width) - 1

    me bitfield_field_result_type(field: HirBitfieldField) -> MirType:
        """Choose the MIR result type for a lowered bitfield field read."""
        match field:
            case HirBitfieldField(_, _, has_type_, type_, bit_width, _, _, _):
                if has_type_:
                    val field_type: HirType = type_
                    match field_type.kind:
                        case HirTypeKind.Bool:
                            return MirType.bool()
                        case _:
                            return MirType.bits(bit_width)
                MirType.bits(bit_width)

    me bitfield_total_width(fields: [HirBitfieldField]) -> i64:
        """Return the packed storage width for a bitfield definition."""
        var total = 0
        for field in fields:
            match field:
                case HirBitfieldField(_, _, _, _, bit_width, _, _, _):
                    total = total + bit_width
        total

    me lower_return_expr(value: HirExpr?) -> LocalId:
        # Return's payload is HirExpr? (Optional): Some(expr) for
        # `return expr`, nil for a bare `return`.
        # `return <expr>` inside a function whose MIR signature returns Unit
        # (e.g. `-> ()` with `return ()`) must terminate exactly like a bare
        # `return`, as the implicit tail does (function_lowering.spl,
        # `return_type.kind == MirTypeKind.Unit` -> terminate_return(nil)).
        # Ret(Some(unit_temp)) made Cranelift emit `return v53` against a
        # signature with no result (cranelift_unit_fn_return_unit_value_2026-10-24).
        # The value is still lowered for its side effects.
        var return_value: HirExpr? = value
        if val unit_rv = value:
            if self.current_mir_signature_returns_unit():
                self.lower_expr(unit_rv)
                return_value = nil
        if val rv = return_value:
            var br = self.builder
            # Lower for the DECLARED return slot, so a conditional returned
            # from a scalar-optional function boxes per arm.
            var result = LocalId(id: 0)
            val slot_builder = self.builder
            val slot_return: HirType? = match slot_builder.current_function:
                case Some(slot_fn): self.resolved_call_hir_return_type(slot_fn.symbol)
                case None: nil
            if val slot_return_type = slot_return:
                result = self.lower_expr_for_slot(rv, slot_return_type)
            else:
                result = self.lower_expr(rv)
            # The return payload is evaluated before control transfers; only
            # then release decisions owned by the abandoned enclosing path.
            self.emit_mcdc_abort_if_active()
            # current_function uses a boxed Option on this lane; only the
            # explicit Some arm unboxes it safely.
            var cur_builder = self.builder
            val declared_return: HirType? = match cur_builder.current_function:
                case Some(active_fn): self.resolved_call_hir_return_type(active_fn.symbol)
                case None: nil
            if val found_return = declared_return:
                result = self.coerce_native_trait_object(result, rv, found_return)
                match found_return.kind:
                    case HirTypeKind.Optional(_):
                        result = self.ensure_option_handle(result, found_return)
                    case HirTypeKind.Any:
                        # Explicit and implicit returns share the same tagged
                        # Any ABI. Never hand a raw scalar to an Any caller.
                        result = self.box_runtime_value(result)
                    case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Bool | HirTypeKind.Char:
                        # `return v` with `v: i64?` from a `-> i64` function
                        # returns the payload, not the Option handle.
                        result = self.option_scalar_payload_of(result)
                        if val result_hir = self.find_local_hir_type(result.id):
                            if result_hir.kind == HirTypeKind.Any and self.is_runtime_value_local(result.id):
                                result = self.decode_runtime_value(result, self.lower_type(found_return))
                    case _:
                        ()
            br = self.builder
            self.emit_pending_finally_for_transfer()
            br = self.builder
            if br.current_block_has_explicit_terminator():
                val overridden = br.new_temp(MirType.unit())
                self.builder = br
                return overridden
            # WP-E: an explicit `return expr` is a real control-flow exit --
            # drop every still-owned resource local except `result` itself,
            # which is being handed back to the caller (a transfer, not a
            # drop; mirrors the implicit-return handling in
            # function_lowering.spl).
            self.emit_pending_resource_drops(Some(result))
            br = self.builder
            # Bug iso_transfer_sites_missing_move_return_assign_field
            # (2026-08-06), item #1's explicit-`return expr` twin of the
            # implicit-tail-return fix in function_lowering.spl: `result`
            # reached the Ret terminator as a bare `mir_operand_copy`
            # operand with no Move instruction backing it. This matters
            # even though the checker's `record_use` on a Copy operand
            # already flags a MOVED source read at the return site itself:
            # `record_use` only CHECKS moved_now, it never ADDS to it, so
            # an early `return a` inside one branch of an if/else left `a`
            # NOT marked moved for the checker's block-order forward walk
            # -- a later use of `a` in a sibling/merge block went
            # undetected. `record_move` (what a real Move instruction
            # triggers) does add to moved_now, closing that gap.
            # The Ret operand carries the transfer itself, exactly once.
            # No intermediate Move plus second consuming operand is needed.
            val ret_operand = self.ownership_return_operand(result, rv)
            br = self.builder
            val ret_box: MirOperand? = Some(ret_operand)
            br.terminate_return(ret_box)
            self.builder = br
        else:
            self.emit_mcdc_abort_if_active()
            self.emit_pending_finally_for_transfer()
            var after_finally = self.builder
            if after_finally.current_block_has_explicit_terminator():
                val overridden = after_finally.new_temp(MirType.unit())
                self.builder = after_finally
                return overridden
            self.emit_pending_resource_drops(nil)
            var br_void = self.builder
            br_void.terminate_return(nil)
            self.builder = br_void
        var br2 = self.builder
        val ret_temp = br2.new_temp(MirType.unit())
        self.builder = br2
        ret_temp

    me current_mir_signature_returns_unit() -> bool:
        # Mirrors the backend's build_signature: `main` always returns i64.
        var cur_builder = self.builder
        match cur_builder.current_function:
            case Some(active_fn):
                if active_fn.name == "main":
                    return false
                match active_fn.signature.return_type.kind:
                    case MirTypeKind.Unit: true
                    case _: false
            case None: false

    me emit_pending_finally_for_transfer() -> ():
        """Run active finally blocks inner-to-outer before a nonlocal exit.

        The lexical stack is restored after CFG emission so sibling branches
        lowered later still see the same enclosing regions. Popping before
        lowering each finally prevents a return inside that finally from
        recursively re-entering itself; such a return may still run outers.
        """
        # `finally_stack` has no initializer on any construction path, so on a
        # function with no try/finally region it is still nil when a `return`
        # inside a nested block reaches here. `.len()` on nil then aborts the
        # whole native-build with `method \`len\` not found on type \`nil\``.
        # An absent stack is exactly an empty stack: nothing to run.
        if self.finally_stack == nil:
            return ()
        val saved = self.finally_stack
        while self.finally_stack.len() > 0:
            val i = self.finally_stack.len() - 1
            val cleanup = self.finally_stack[i]
            self.finally_stack.pop()
            self.lower_block(cleanup)
            if self.builder.current_block_has_explicit_terminator():
                break
        self.finally_stack = saved

    me lower_index_expr_from_hir(expr_value: HirExpr) -> LocalId:
        val payload = _sffi_enum_payload<HirExprKind>(expr_value.kind)
        val base: HirExpr = _sffi_tuple_get<HirExpr>(payload, 0)
        val index: HirExpr = _sffi_tuple_get<HirExpr>(payload, 1)
        if base == nil or index == nil:
            self.error_fatal("empty HIR Index payload", Some(expr_value.span))
            return self.builder.emit_const_int(0)
        val has_result_hir_type = expr_value.has_type_ == true and expr_value.type_ != nil
        self.lower_index_expr(base, index, has_result_hir_type, expr_value.type_)

    me lower_index_expr(base: HirExpr, index: HirExpr, has_index_result_hir_type: bool, index_result_hir_type: HirType, nil_probe: bool = false) -> LocalId:
        # Bug (array-slice-index SIGSEGV, CONFLICT-FLAG: expr_dispatch.spl
        # is fenced, touched here per the fence rule's "CONFLICT-FLAG if
        # must touch" allowance): `a[1:3]` where `a` is a runtime array
        # parses as an ordinary Index with `index` being a Range HIR
        # expr. lower_expr(Range) unconditionally calls lower_range
        # (function_lowering.spl), which is a KNOWN-incomplete stub --
        # its emitted call operand is a bare `MirConstValue.Int(0)`
        # ("function symbol -- will be resolved in codegen") that never
        # actually resolves to a real rt_range/array-slice runtime
        # symbol. The backend then has no valid callee and the whole
        # subtree silently collapses to a placeholder `0`, which this
        # Index arm then treats as a genuine index/pointer value --
        # inttoptr'ing and GEP/load'ing off address 0 at runtime
