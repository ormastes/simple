# Provider-owned Result Err record identity. No consumer-side foreign SymbolId.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.hir.hir_types.{Effect, EffectKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_types.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir.nominal_owner_diagnostics.{mir_nominal_profile_take_receipt}

fn result_err_layout_identity(owner: text) -> text:
    var separator = owner.rfind("::")
    var width = 2
    if separator < 0:
        separator = owner.rfind(".")
        width = 1
    if separator <= 0: return ""
    val module = mir_layout_canonical_module_name(owner.substring(0, separator))
    if module == "": return ""
    "{module}::{owner.substring(separator + width)}"

# Evaluate semantic identity only while symbols owns every Named ID.
# Recursive records stop at their declaration identity, never expand fields.
fn result_err_field_type_key(type_: HirType, symbols: SymbolTable) -> text:
    if type_ == nil: return ""
    match type_.kind:
        case HirTypeKind.Int(bits, signed): if signed: "i{bits}" else: "u{bits}"
        case HirTypeKind.Float(bits): "f{bits}"
        case HirTypeKind.Bool: "bool"
        case HirTypeKind.Char: "char"
        case HirTypeKind.Str: "text"
        case HirTypeKind.Unit: "unit"
        case HirTypeKind.Never: "never"
        case HirTypeKind.Any: "any"
        case HirTypeKind.Named(id, args):
            if not symbols.symbols.has(id.id): return ""
            val declaration: HirSymbol = symbols.symbols[id.id]
            val identity = result_err_layout_identity(mir_class_identity(declaration))
            if identity == "": return ""
            val kind = match declaration.kind:
                case SymbolKind.Class: "class"
                case SymbolKind.Struct: "struct"
                case SymbolKind.Enum: "enum"
                case SymbolKind.Trait: "trait"
                case _: ""
            if kind == "": return ""
            val arguments = result_err_field_type_keys(args, symbols)
            if arguments == "": return ""
            "{kind}({identity}){arguments}"
        case HirTypeKind.Function(params, ret, effects):
            val parameter_keys = result_err_field_type_keys(params, symbols)
            val return_key = result_err_field_type_key(ret, symbols)
            val effect_keys = result_err_function_effect_keys(effects, symbols)
            if parameter_keys == "" or return_key == "" or effect_keys == "": return ""
            "function(params={parameter_keys};return={return_key};effects={effect_keys})"
        case HirTypeKind.Optional(inner):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "optional({key})"
        case HirTypeKind.Array(inner, size):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "array({size ?? -1},{key})"
        case HirTypeKind.Slice(inner):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "slice({key})"
        case HirTypeKind.Tuple(elements):
            val keys = result_err_field_type_keys(elements, symbols)
            if keys == "": "" else: "tuple{keys}"
        case HirTypeKind.Dict(key_type, value_type):
            val keys = result_err_field_type_keys([key_type, value_type], symbols)
            if keys == "": "" else: "dict{keys}"
        case HirTypeKind.Result(ok_type, err_type):
            val keys = result_err_field_type_keys([ok_type, err_type], symbols)
            if keys == "": "" else: "result{keys}"
        case HirTypeKind.Ref(inner, mutable):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "ref({mutable},{key})"
        case HirTypeKind.Ptr(inner, mutable):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "ptr({mutable},{key})"
        case HirTypeKind.Isolated(inner):
            val key = result_err_field_type_key(inner, symbols)
            if key == "": "" else: "isolated({key})"
        case _: ""

fn result_err_function_effect_keys(effects: [Effect], symbols: SymbolTable) -> text:
    var keys: [text] = []
    for effect in effects:
        val key = match effect.kind:
            case EffectKind.Pure: "pure"
            case EffectKind.IO: "io"
            case EffectKind.Async: "async"
            case EffectKind.Mutates: "mutates"
            case EffectKind.Allocates: "allocates"
            case EffectKind.Custom(name): "custom({name.len()}:{name})"
            case EffectKind.Throws(type_):
                val payload_key = result_err_field_type_key(type_, symbols)
                if payload_key == "": "" else: "throws({payload_key})"
            case _: ""
        if key == "": return ""
        keys = keys.push(key)
    "[" + keys.join(",") + "]"

fn result_err_field_type_keys(types: [HirType], symbols: SymbolTable) -> text:
    var keys: [text] = []
    for type_ in types:
        val key = result_err_field_type_key(type_, symbols)
        if key == "": return ""
        keys.push(key)
    "[" + keys.join(",") + "]"

impl MirLowering:
    me register_result_err_layout_types(name: text, fields: [HirField], symbols: SymbolTable):
        var names: [text] = []
        var types: [HirType] = []
        for raw_field in fields:
            val field: HirField = raw_field
            names.push(field.name)
            types.push(field.type_)
        self.register_result_err_layout_types_fields_v1(name, names, types, symbols)

    me register_result_err_layout_types_fields_v1(name: text, names: [text], types: [HirType], symbols: SymbolTable):
        if names.len() != types.len():
            self.error_fatal("Result Err declaration field name/type count mismatch", nil)
            return
        val identity = result_err_layout_identity(name)
        if identity == "": return
        var rows: [text] = []
        var complete = true
        var index = 0
        while index < names.len():
            val field_type: HirType = types[index]
            val key = result_err_field_type_key(field_type, symbols)
            if key == "": complete = false
            rows.push("{names[index].len()}:{names[index]}:{key}")
            index = index + 1
        val snapshot = if complete: "fields[" + rows.join(";") + "]" else: ""
        if self.result_err_layout_types.contains(identity):
            if self.result_err_layout_types[identity] != snapshot:
                self.result_err_layout_types[identity] = ""
            return
        self.result_err_layout_types[identity] = snapshot

    me remember_result_err_record_owner(local_id: i64, symbol: SymbolId):
        if not self.provider_callable_has_link(symbol): return
        val callable = self.provider_callable_symbol_name(symbol, "")
        if val owner = bootstrap_fn_ret_err_shape_lookup(callable):
            # Canonicalize an imported declaration spelling through the exact
            # identity registry; this helper never searches by a unique leaf.
            self.result_err_record_owners[local_id] = self.declared_struct_layout_key(owner)

    me copy_result_err_record_owner(source: i64, destination: i64):
        if source == destination: return
        if self.result_err_record_owners.contains(source):
            val owner = self.result_err_record_owners[source]
            if self.result_err_record_owners.contains(destination) and self.result_err_record_owners[destination] != owner:
                self.result_err_record_owners[destination] = ""
            else:
                self.result_err_record_owners[destination] = owner
        elif self.result_err_record_owners.contains(destination):
            self.result_err_record_owners[destination] = ""

    me invalidate_result_err_record_owner(local_id: i64):
        if self.result_err_record_owners.contains(local_id):
            self.result_err_record_owners[local_id] = ""

    me assign_result_err_record_owner(source: i64, destination: i64):
        # Conservative for branch writes: contradictory assignments cannot
        # leave the last visited arm's layout on a runtime-dependent value.
        self.copy_result_err_record_owner(source, destination)

    me join_result_err_record_owners(arms: [LocalId], destination: i64):
        var any_known = false
        var all_known = true
        var owner = ""
        var index = 0
        while index < arms.len():
            val local_id = arms[index].id
            if self.result_err_record_owners.contains(local_id):
                val candidate = self.result_err_record_owners[local_id]
                if any_known and owner != candidate: all_known = false
                if not any_known: owner = candidate
                any_known = true
            else:
                all_known = false
            index = index + 1
        if any_known:
            self.result_err_record_owners[destination] = if all_known: owner else: ""

    me checked_result_err_record_owner(local_id: i64, span: Span) -> text:
        val owner = self.result_err_record_owners.get(local_id) ?? ""
        val identity = result_err_layout_identity(owner)
        if owner == "" or identity == "" or not self.composite_layout_digests.contains(identity) or (self.composite_layout_owner_counts.get(identity) ?? 0) != 1:
            self.error_fatal("Result Err record has no unique provider layout snapshot", Some(span))
            return ""
        if (self.result_err_layout_types.get(identity) ?? "") == "":
            self.error_fatal("Result Err record has conflicting or unknown provider field types", Some(span))
            return ""
        if not self.struct_field_order.contains(owner) or not self.struct_field_hir_type.contains(owner):
            self.error_fatal("Result Err record has no exact provider layout", Some(span))
            return ""
        owner

    me materialize_result_err_record_payload(raw: LocalId, owner: text, span: Span) -> LocalId:
        if owner == "": return raw
        if self.class_type_names.contains(owner): return raw
        # Structs require a real current-table declaration to preserve value
        # copying. Match exact registered identity; never interpret a foreign
        # cached payload ID in this table or choose an unqualified homonym.
        for raw_symbol in self.symbols.symbols.values():
            val declaration: HirSymbol = raw_symbol
            if declaration.kind == SymbolKind.Struct and self.declared_struct_layout_key(self.composite_layout_key(declaration)) == owner:
                val type_ = MirType(kind: MirTypeKind.Struct(declaration.id))
                var builder = self.builder
                val address = builder.emit_cast(mir_operand_copy(raw), MirType.ptr(type_, false))
                val value = builder.new_temp(type_)
                builder.emit_copy(value, address)
                self.builder = builder
                return value
        if mir_nominal_profile_take_receipt():
            val expected_identity = result_err_layout_identity(owner)
            eprint("[nominal-owner] result-err-missing local={raw.id} expected={owner} identity={expected_identity}\n")
            val separator = owner.rfind("::")
            val leaf = if separator >= 0: owner.substring(separator + 2) else: owner.substring(owner.rfind(".") + 1)
            var candidate_count = 0
            for candidate_id in self.symbols.symbols.keys():
                if candidate_count < 8 and self.symbols.symbol_name_scalar_raw(candidate_id) == leaf:
                    val candidate_module = self.symbols.symbol_defining_module_scalar_raw(candidate_id)
                    val candidate_identity = self.symbols.record_owner_identity_scalar_raw(candidate_id)
                    val candidate_layout = self.declared_struct_layout_key(if candidate_module == "": leaf else: "{candidate_module}::{leaf}")
                    eprint("[nominal-owner] result-err-candidate symbol={candidate_id} name={leaf} module={candidate_module} identity={candidate_identity} layout={candidate_layout}\n")
                    candidate_count = candidate_count + 1
        self.error_fatal("Result Err struct has no current declaration for its exact provider", Some(span))
        raw
