use compiler.mir.mir_instruction_support.{MirCallOrigin}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.MirLowering
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*

impl MirLowering:
    me try_lower_text_range_index(base: HirExpr, start: HirExpr?, end: HirExpr?, inclusive: bool, step: HirExpr?) -> LocalId?:
        # Exclusive, unit-step text ranges use the same code-point owner as
        # colon slices. Other collection/range forms remain explicit errors.
        if inclusive or step != None:
            return None
        val receiver = self.lower_expr(base)
        if not self.local_is_str(receiver) and not self.local_hir_type_is_str(receiver):
            # `arr[a..b]` / `arr[a..]` / `arr[..b]` on a proven runtime array
            # is the same operation as `arr.slice(a, b)`: reuse that owner
            # (rt_slice, fresh shallow storage, clamped bounds, element
            # metadata preserved) instead of failing the build.
            if self.runtime_array_locals.contains(receiver.id):
                var slice_args: [HirCallArg] = []
                if val start_value = start:
                    slice_args.push(HirCallArg(has_name: false, name: "", value: start_value, span: start_value.span))
                else:
                    val zero_start = HirExpr(kind: HirExprKind.IntLit(0, None), has_type_: false, type_: HirType(kind: HirTypeKind.Unit, span: base.span), span: base.span)
                    slice_args.push(HirCallArg(has_name: false, name: "", value: zero_start, span: base.span))
                if val end_value = end:
                    slice_args.push(HirCallArg(has_name: false, name: "", value: end_value, span: end_value.span))
                return Some(self.lower_runtime_array_slice(receiver, slice_args))
            return None
        # Text: the same CODE-POINT owner as the colon slice `s[a:b]`
        # (lower_text_codepoint_slice_v1 -> rt_slice); a range index is a
        # code-point cut, never the byte-offset `.slice`/`.substring` cutter.
        var range_args: [HirCallArg] = []
        if val start_value = start:
            range_args.push(HirCallArg(has_name: false, name: "", value: start_value, span: start_value.span))
        else:
            val zero_start = HirExpr(kind: HirExprKind.IntLit(0, None), has_type_: false, type_: HirType(kind: HirTypeKind.Unit, span: base.span), span: base.span)
            range_args.push(HirCallArg(has_name: false, name: "", value: zero_start, span: base.span))
        if val end_value = end:
            range_args.push(HirCallArg(has_name: false, name: "", value: end_value, span: end_value.span))
        return Some(self.lower_text_codepoint_slice_v1(receiver, range_args, base.span))
