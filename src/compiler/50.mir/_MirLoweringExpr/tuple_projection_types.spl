# Preserve a declared nominal tuple member after its native GetField load.
# Result/Option wrapper admission remains in result_tuple_payload.spl.
use compiler.hir.hir_types.{HirType, HirTypeKind, HirSymbol, SymbolKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.function_lowering.*

impl MirLowering:
    me remember_native_tuple_member_hir_type(base: LocalId, index: i64, destination: LocalId):
        # An existing, conflicting note must remain visible to validation.
        if self.find_local_hir_type(destination.id) != nil: return
        if val tuple_type = self.find_local_hir_type(base.id):
            match tuple_type.kind:
                case HirTypeKind.Tuple(elements):
                    if index < 0 or index >= elements.len(): return
                    val member: HirType = elements[index]
                    match member.kind:
                        case HirTypeKind.Named(symbol, arguments):
                            if arguments.len() != 0: return
                            if not self.symbols.symbols.contains_key(symbol.id): return
                            val declaration: HirSymbol = self.symbols.symbols[symbol.id]
                            if declaration.id.id != symbol.id: return
                            match declaration.kind:
                                case SymbolKind.Struct | SymbolKind.Class | SymbolKind.Enum: pass
                                case _: return
                            if val actual = self.local_mir_type_of(destination):
                                val declared = self.lower_type(member)
                                if actual.kind != declared.kind: return
                                # Metadata only: never re-decode the loaded word
                                # or turn an erased i64 into a claimed record.
                                self.remember_local_hir_type(destination.id, member, 0, 0)
                        case _: pass
                case _: pass
