# bug: enum_static_receiver_owner_erasure_2026_10_11
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{LocalId}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*

impl MirLowering:
    me try_lower_declared_enum_static_call(receiver: HirExpr, method: text,
            args: [HirCallArg], resolution: MethodResolution) -> LocalId?:
        # Keep resolved associated methods on their existing call path. Decode
        # the receiver in this frame, not inside the outer MethodCall payload.
        match resolution:
            case MethodResolution.StaticMethod(_, _): return nil
            case MethodResolution.Unresolved: ()
            case _: return nil
        var raw = -1
        match receiver.kind:
            case HirExprKind.Var(symbol): raw = symbol.id
            case HirExprKind.NamedVar(symbol, name):
                # This is a lexical lookup in the active module SymbolTable,
                # never a global variant-name search or a foreign numeric ID.
                val bound = self.symbols.lookup_or_invalid(name)
                if bound.id < 0: return nil
                if symbol.id >= 0 and symbol.id != bound.id: return nil
                raw = bound.id
            case _: return nil
        if raw < 0 or not self.symbols.symbol_is_enum_declaration_scalar_raw(raw):
            return nil
        val symbol = SymbolId(id: raw)
        val name = self.symbols.symbol_name_scalar_raw(raw)
        val qualified = self.enum_qualified_key(symbol)
        val owner = if qualified != "": qualified else: name
        val registered = if qualified != "":
            self.enum_variant_index_q.has(qualified)
        else:
            self.enum_variant_index.has(name) and not (self.enum_bare_ambiguous.get(name) ?? false)
        if registered:
            for variant in self.enum_variant_names(owner):
                if variant == method:
                    return Some(self.lower_enum_construct_named(owner, method, args))
        elif self.enum_variant_payload_kind.has(owner + "::" + method):
            # Only exact provider payload metadata proves that this name was a
            # variant. An arbitrary enum associated method is not an error.
            self.error_fatal("enum static constructor lacks exact provider registry: {owner}.{method}", Some(receiver.span))
            return Some(self.builder.emit_const_int(0))
        # Retain the known owner even on normal dispatch. With missing provider
        # metadata an empty hint would revive the unrelated unique-leaf fallback.
        return Some(self.lower_method_call(receiver, method, args, resolution, owner, raw))
