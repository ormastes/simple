# Stable provider ownership for Optional record values stored in local bindings.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir_types.*
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_class_identity}
use compiler.mir._MirLoweringExpr.result_err_record_owner.{result_err_layout_identity}

impl MirLowering:
    me remember_optional_record_owner(local: LocalId, callable: text):
        if val shape = bootstrap_fn_ret_opt_shape_lookup(callable):
            self.optional_record_owners[local.id] = self.declared_struct_layout_key(shape)

    me copy_optional_record_owner(source: i64, destination: i64):
        if source == destination: return
        if self.optional_record_owners.contains(source):
            val owner = self.optional_record_owners[source]
            if self.optional_record_owners.contains(destination) and self.optional_record_owners[destination] != owner:
                self.optional_record_owners[destination] = ""
            else:
                self.optional_record_owners[destination] = owner
        elif self.optional_record_owners.contains(destination):
            self.optional_record_owners[destination] = ""

    me invalidate_optional_record_owner(local: i64):
        if self.optional_record_owners.contains(local):
            self.optional_record_owners[local] = ""

    me join_optional_record_owners(arms: [LocalId], destination: i64):
        var any_known = false
        var all_known = true
        var owner = ""
        for arm in arms:
            if self.optional_record_owners.contains(arm.id):
                val candidate = self.optional_record_owners[arm.id]
                if any_known and owner != candidate: all_known = false
                if not any_known: owner = candidate
                any_known = true
            else:
                all_known = false
        if any_known:
            self.optional_record_owners[destination] = if all_known: owner else: ""

    me checked_optional_record_type(local: i64, span: Span) -> HirType:
        val bad = HirType(kind: HirTypeKind.Error, span: span)
        val owner = self.optional_record_owners.get(local) ?? ""
        val identity = result_err_layout_identity(owner)
        if owner == "" or identity == "" or not self.composite_layout_digests.contains(identity) or (self.composite_layout_owner_counts.get(identity) ?? 0) != 1:
            self.error_fatal("Optional record has no unique provider layout snapshot", Some(span))
            return bad
        if (self.result_err_layout_types.get(identity) ?? "") == "" or not self.struct_field_order.contains(owner) or not self.struct_field_hir_type.contains(owner):
            self.error_fatal("Optional record has conflicting or unknown provider field types", Some(span))
            return bad
        var matched = -1
        # A callable's return-type dependency is relocated without a lexical
        # binding. Its qualified declaration is still owned by this table.
        # Validate that index before using it; a stale or foreign row must not
        # authorize a record merely because its field layout happens to match.
        val separator = identity.rfind("::")
        val qualified = self.symbols.lookup_qualified_type_raw(
            identity.substring(0, separator), identity.substring(separator + 2))
        if qualified >= 0:
            if not self.symbols.symbols.has(qualified):
                self.error_fatal("Optional record has a stale qualified provider declaration", Some(span))
                return bad
            val declaration: HirSymbol = self.symbols.symbols[qualified]
            if (declaration.id.id != qualified or
                (declaration.kind != SymbolKind.Struct and declaration.kind != SymbolKind.Class) or
                result_err_layout_identity(mir_class_identity(declaration)) != identity):
                self.error_fatal("Optional record has a mismatched qualified provider declaration", Some(span))
                return bad
            matched = qualified
        # Retain the lexical ambiguity check: the qualified index is
        # first-write-wins and cannot prove that a conflicting ID is absent.
        for indexed_name in self.symbols.exact_symbols.keys():
            val raw = self.symbols.exact_symbols[indexed_name]
            if val declaration = self.symbols.get_symbol_raw(raw):
                match declaration.kind:
                    case SymbolKind.Struct | SymbolKind.Class:
                        if result_err_layout_identity(mir_class_identity(declaration)) == identity:
                            if matched >= 0 and matched != raw:
                                self.error_fatal("Optional record has ambiguous current provider declaration", Some(span))
                                return bad
                            matched = raw
                    case _: ()
        if matched < 0:
            self.error_fatal("Optional record has no current declaration for its exact provider", Some(span))
            return bad
        HirType(kind: HirTypeKind.Named(SymbolId(id: matched), []), span: span)

    me materialize_optional_record_payload(raw: LocalId, owner: text, declared: HirType) -> LocalId:
        var value = raw
        if owner != "" and not self.class_type_names.contains(owner):
            val type_ = self.lower_type(declared)
            var builder = self.builder
            val address = builder.emit_cast(mir_operand_copy(raw), MirType.ptr(type_, false))
            value = builder.new_temp(type_)
            builder.emit_copy(value, address)
            self.builder = builder
        if owner != "": self.struct_value_syms[value.id] = owner
        self.remember_local_hir_type(value.id, declared, 0, 0)
        value
