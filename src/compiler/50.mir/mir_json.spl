# MIR JSON Serialization - Bootstrap-Compatible Version
#
# Simplified implementation using only basic Simple syntax.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}

fn symbol_id_value(symbol: SymbolId) -> i64:
    symbol.id

fn local_id_value(local: LocalId) -> i64:
    local.id

fn block_id_value(block: BlockId) -> i64:
    block.id

fn serialize_switch_case(switch_case: SwitchCase) -> text:
    match switch_case:
        case SwitchCase(value, target):
            "{\"value\":{value},\"target\":{block_id_value(target)}}"

# ============================================================================
# Type Serialization
# ============================================================================

fn serialize_mir_type(t: MirType) -> text:
    """Serialize MIR type to JSON."""
    val k = t.kind

    # Use match for all type kinds
    match k:
        # Primitives
        case I8: "\"I8\""
        case I16: "\"I16\""
        case I32: "\"I32\""
        case I64: "\"I64\""
        case U8: "\"U8\""
        case U16: "\"U16\""
        case U32: "\"U32\""
        case U64: "\"U64\""
        case F32: "\"F32\""
        case F64: "\"F64\""
        case Bool: "\"Bool\""
        case Char: "\"Char\""
        case Unit: "\"Unit\""
        case Never: "\"Never\""

        # Pointers and references
        case Ptr(pointee, mutable):
            val p = serialize_mir_type(pointee)
            val m = if mutable: "true" else: "false"
            "{\"Ptr\":{\"pointee\":{p},\"mutable\":{m}}}"

        case Ref(referent, mutable):
            val r = serialize_mir_type(referent)
            val m = if mutable: "true" else: "false"
            "{\"Ref\":{\"referent\":{r},\"mutable\":{m}}}"

        case FuncPtr(signature):
            val sig = serialize_mir_signature(signature)
            "{\"FuncPtr\":{sig}}"

        # Aggregates
        case Array(element, size):
            val e = serialize_mir_type(element)
            "{\"Array\":{\"element\":{e},\"size\":{size}}}"

        case Dict(key, value):
            val k = serialize_mir_type(key)
            val v = serialize_mir_type(value)
            "{\"Dict\":{\"key\":{k},\"value\":{v}}}"

        case Slice(element):
            val e = serialize_mir_type(element)
            "{\"Slice\":{e}}"

        case Tuple(elements):
            var elems = "["
            var first = true
            for elem in elements:
                if not first:
                    elems = "{elems},"
                elems = "{elems}{serialize_mir_type(elem)}"
                first = false
            elems = "{elems}]"
            "{\"Tuple\":{elems}}"

        case Struct(symbol):
            "{\"Struct\":{symbol_id_value(symbol)}}"

        case Enum(symbol):
            "{\"Enum\":{symbol_id_value(symbol)}}"

        case Result(ok_type, err_type):
            val ok_json = serialize_mir_type(ok_type)
            val err_json = serialize_mir_type(err_type)
            "{\"Result\":{\"ok\":{ok_json},\"err\":{err_json}}}"

        # Special types
        case Opaque(name):
            "{\"Opaque\":\"{escape_json_string(name)}\"}"

        # Async types
        case Promise(inner):
            val i = serialize_mir_type(inner)
            "{\"Promise\":{i}}"

        case Generator(yieldType, returnType):
            val y = serialize_mir_type(yieldType)
            val r = serialize_mir_type(returnType)
            "{\"Generator\":{\"yield\":{y},\"return\":{r}}}"

        case ActorType(message):
            val m = serialize_mir_type(message)
            "{\"ActorType\":{m}}"

        # Union type
        case Union(members):
            var elems = "["
            var first = true
            for member in members:
                if not first:
                    elems = "{elems},"
                elems = "{elems}{serialize_mir_type(member)}"
                first = false
            elems = "{elems}]"
            "{\"Union\":{elems}}"

        # Catch-all for any missing types
        case _:
            "\"UnknownType\""

# ============================================================================
# Constant Value Serialization
# ============================================================================

fn serialize_const_value(c: MirConstValue) -> text:
    """Serialize constant value to JSON."""
    match c:
        case Int(n):
            "{n}"
        case Float(f):
            "{f}"
        case Bool(b):
            if b: "true" else: "false"
        case Str(s):
            "\"{escape_json_string(s)}\""
        case Zero:
            "\"Zero\""
        case _:
            "null"

# ============================================================================
# Operation Serialization
# ============================================================================

fn serialize_binop(op: MirBinOp) -> text:
    """Serialize binary operation."""
    match op:
        case Add: "\"Add\""
        case Sub: "\"Sub\""
        case Mul: "\"Mul\""
        case Div: "\"Div\""
        case Rem: "\"Rem\""
        case Pow: "\"Pow\""
        case MatMul: "\"MatMul\""
        case BitAnd: "\"BitAnd\""
        case BitOr: "\"BitOr\""
        case BitXor: "\"BitXor\""
        case Shl: "\"Shl\""
        case Shr: "\"Shr\""
        case Eq: "\"Eq\""
        case Ne: "\"Ne\""
        case Lt: "\"Lt\""
        case Le: "\"Le\""
        case Gt: "\"Gt\""
        case Ge: "\"Ge\""
        case BroadcastAdd: "\"BroadcastAdd\""
        case BroadcastSub: "\"BroadcastSub\""
        case BroadcastMul: "\"BroadcastMul\""
        case BroadcastDiv: "\"BroadcastDiv\""
        case BroadcastPow: "\"BroadcastPow\""
        case Offset: "\"Offset\""
        case _: "\"Other\""

fn serialize_unaryop(op: MirUnaryOp) -> text:
    """Serialize unary operation."""
    match op:
        case Neg: "\"Neg\""
        case Not: "\"Not\""
        case BitNot: "\"BitNot\""
        case Transpose: "\"Transpose\""
        case _: "\"Other\""

fn serialize_aggregate_kind(kind: AggregateKind) -> text:
    """Serialize aggregate kind to JSON."""
    match kind:
        case Array(elemType):
            val t = serialize_mir_type(elemType)
            "{\"Array\":{t}}"
        case Tuple:
            "\"Tuple\""
        case Struct(symbol):
            "{\"Struct\":{symbol_id_value(symbol)}}"
        case Enum(symbol, variant):
            "{\"Enum\":{\"symbol\":{symbol_id_value(symbol)},\"variant\":{variant}}}"

# ============================================================================
# Operand Serialization
# ============================================================================

fn serialize_operand(op: MirOperand) -> text:
    """Serialize operand to JSON."""
    val k = op.kind

    match k:
        case Copy(local):
            "{\"Copy\":{local_id_value(local)}}"
        case Move(local):
            "{\"Move\":{local_id_value(local)}}"
        case Const(value, mtype):
            val vj = serialize_const_value(value)
            val tj = serialize_mir_type(mtype)
            "{\"Const\":{\"value\":{vj},\"type\":{tj}}}"

fn serialize_execution_domain(domain: MirExecutionDomain) -> text:
    match domain:
        case MirExecutionDomain.Parent: "parent"
        case MirExecutionDomain.Thread: "thread"
        case MirExecutionDomain.Process: "process"
        case MirExecutionDomain.Actor: "actor"
        case MirExecutionDomain.Device: "device"
        case MirExecutionDomain.Remote: "remote"

fn serialize_transfer_mode(mode: MirTransferMode) -> text:
    match mode:
        case MirTransferMode.Copy: "copy"
        case MirTransferMode.FrozenShare: "frozen_share"
        case MirTransferMode.OwnedMove: "owned_move"
        case MirTransferMode.ScopedLoan: "scoped_loan"
        case MirTransferMode.Lease: "lease"

fn serialize_transfer_payload(payload: MirTransferPayload) -> text:
    match payload:
        case MirTransferPayload.InlineCopy: "inline_copy"
        case MirTransferPayload.FrozenRegion: "frozen_region"
        case MirTransferPayload.OwnedRegion: "owned_region"
        case MirTransferPayload.EncodedCopy: "encoded_copy"
        case MirTransferPayload.ObjectHandle: "object_handle"
        case MirTransferPayload.SharedSync: "shared_sync"
        case MirTransferPayload.DeviceLease: "device_lease"

# ============================================================================
# Terminator Serialization
# ============================================================================

fn serialize_mir_terminator(term: MirTerminator) -> text:
    """Serialize terminator to JSON."""
    match term:
        case Goto(target):
            "{\"Goto\":{block_id_value(target)}}"

        case MirTerminator.Ret(maybeVal):
            if val return_value = maybeVal:
                val v = serialize_operand(return_value)
                "{\"Return\":{v}}"
            else:
                "{\"Return\":null}"

        case If(cond, thenBlock, elseBlock):
            val c = serialize_operand(cond)
            "{\"If\":{\"cond\":{c},\"then\":{block_id_value(thenBlock)},\"else\":{block_id_value(elseBlock)}}}"

        case Switch(value, targets, defaultBlock):
            val v = serialize_operand(value)
            var cases = "["
            var first = true
            for switchCase in targets:
                if not first:
                    cases = "{cases},"
                cases = "{cases}{serialize_switch_case(switchCase)}"
                first = false
            cases = "{cases}]"
            "{\"Switch\":{\"value\":{v},\"targets\":{cases},\"default\":{block_id_value(defaultBlock)}}}"

        case CallTerminator(maybeDest, func, args, normal, maybeUnwind):
            val f = serialize_operand(func)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            var destStr = "null"
            if val dest = maybeDest:
                destStr = "{local_id_value(dest)}"
            var unwindStr = "null"
            if val unwind = maybeUnwind:
                unwindStr = "{block_id_value(unwind)}"

            "{\"CallTerminator\":{\"dest\":{destStr},\"func\":{f},\"args\":{argsStr},\"normal\":{block_id_value(normal)},\"unwind\":{unwindStr}}}"

        case Unreachable:
            "\"Unreachable\""

        case Abort(msg):
            "{\"Abort\":\"{escape_json_string(msg)}\"}"

        case _:
            "\"UnknownTerminator\""

# ============================================================================
# Instruction Serialization
# ============================================================================

fn serialize_mir_inst_kind(inst: MirInstKind) -> text:
    """Serialize instruction kind to JSON."""
    match inst:
        case Const(dest, value, mtype):
            val v = serialize_const_value(value)
            val t = serialize_mir_type(mtype)
            "{\"Const\":{\"dest\":{local_id_value(dest)},\"value\":{v},\"type\":{t}}}"

        case Copy(dest, src):
            "{\"Copy\":{\"dest\":{local_id_value(dest)},\"src\":{local_id_value(src)}}}"

        case Move(dest, src):
            "{\"Move\":{\"dest\":{local_id_value(dest)},\"src\":{local_id_value(src)}}}"

        case TransferOut(dest, source, destination, mode, payload, runtime_classify):
            "{\"TransferOut\":{\"dest\":{local_id_value(dest)},\"source\":{local_id_value(source)},\"destination\":\"{serialize_execution_domain(destination)}\",\"mode\":\"{serialize_transfer_mode(mode)}\",\"payload\":\"{serialize_transfer_payload(payload)}\",\"runtime_classify\":{runtime_classify}}}"

        case TransferIn(dest, source, mode, payload):
            "{\"TransferIn\":{\"dest\":{local_id_value(dest)},\"source\":\"{serialize_execution_domain(source)}\",\"mode\":\"{serialize_transfer_mode(mode)}\",\"payload\":\"{serialize_transfer_payload(payload)}\"}}"

        case FreezeRegion(local):
            "{\"FreezeRegion\":{local_id_value(local)}}"

        case AcquireSnapshot(dest, source):
            "{\"AcquireSnapshot\":{\"dest\":{local_id_value(dest)},\"source\":{local_id_value(source)}}}"

        case CommitUpdates(dest, base, updates):
            val dest_text = match dest:
                case Some(local): "{local_id_value(local)}"
                case nil: "null"
            "{\"CommitUpdates\":{\"dest\":{dest_text},\"base\":{local_id_value(base)},\"updates\":{local_id_value(updates)}}}"

        case BinOp(dest, op, left, right):
            val opstr = serialize_binop(op)
            val l = serialize_operand(left)
            val r = serialize_operand(right)
            "{\"BinOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"left\":{l},\"right\":{r}}}"

        case UnaryOp(dest, op, operand):
            val opstr = serialize_unaryop(op)
            val o = serialize_operand(operand)
            "{\"UnaryOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"operand\":{o}}}"

        case Alloc(dest, mtype):
            val t = serialize_mir_type(mtype)
            "{\"Alloc\":{\"dest\":{local_id_value(dest)},\"type\":{t}}}"

        case Load(dest, ptr):
            val p = serialize_operand(ptr)
            "{\"Load\":{\"dest\":{local_id_value(dest)},\"ptr\":{p}}}"

        case Store(ptr, value):
            val p = serialize_operand(ptr)
            val v = serialize_operand(value)
            "{\"Store\":{\"ptr\":{p},\"value\":{v}}}"

        case Call(maybeDest, func, args):
            val f = serialize_operand(func)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"Call\":{\"dest\":{local_id_value(dest)},\"func\":{f},\"args\":{argsStr}}}"
            else:
                "{\"Call\":{\"dest\":null,\"func\":{f},\"args\":{argsStr}}}"

        case GetField(dest, base, field):
            val b = serialize_operand(base)
            "{\"GetField\":{\"dest\":{local_id_value(dest)},\"base\":{b},\"field\":{field}}}"

        case SetField(base, field, value):
            val b = serialize_operand(base)
            val v = serialize_operand(value)
            "{\"SetField\":{\"base\":{b},\"field\":{field},\"value\":{v}}}"

        case Aggregate(dest, kind, operands):
            val k = serialize_aggregate_kind(kind)
            var ops = "["
            var first = true
            for op in operands:
                if not first:
                    ops = "{ops},"
                ops = "{ops}{serialize_operand(op)}"
                first = false
            ops = "{ops}]"
            "{\"Aggregate\":{\"dest\":{local_id_value(dest)},\"kind\":{k},\"operands\":{ops}}}"

        case Cast(dest, operand, targetType):
            val o = serialize_operand(operand)
            val t = serialize_mir_type(targetType)
            "{\"Cast\":{\"dest\":{local_id_value(dest)},\"operand\":{o},\"target\":{t}}}"

        case Bitcast(dest, operand, targetType):
            val o = serialize_operand(operand)
            val t = serialize_mir_type(targetType)
            "{\"Bitcast\":{\"dest\":{local_id_value(dest)},\"operand\":{o},\"target\":{t}}}"

        case CallIndirect(maybeDest, ptr, args, signature):
            val p = serialize_operand(ptr)
            val sig = serialize_mir_signature(signature)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"CallIndirect\":{\"dest\":{local_id_value(dest)},\"ptr\":{p},\"args\":{argsStr},\"signature\":{sig}}}"
            else:
                "{\"CallIndirect\":{\"dest\":null,\"ptr\":{p},\"args\":{argsStr},\"signature\":{sig}}}"

        case Intrinsic(maybeDest, name, args):
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"Intrinsic\":{\"dest\":{local_id_value(dest)},\"name\":\"{escape_json_string(name)}\",\"args\":{argsStr}}}"
            else:
                "{\"Intrinsic\":{\"dest\":null,\"name\":\"{escape_json_string(name)}\",\"args\":{argsStr}}}"

        case DecisionProbe(runtime_id, semantic_id, source_digest, condition_count, evaluated_mask, true_mask, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            val evaluated_json = serialize_operand(evaluated_mask)
            val true_json = serialize_operand(true_mask)
            "{\"DecisionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"source_digest\":{source_digest},\"condition_count\":{condition_count},\"evaluated_mask\":{evaluated_json},\"true_mask\":{true_json},\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case ConditionProbe(runtime_id, semantic_id, parent_runtime_id, parent_semantic_id, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            "{\"ConditionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"parent_runtime_id\":{parent_runtime_id},\"parent_semantic_id\":\"{escape_json_string(parent_semantic_id)}\",\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case DynamicDecisionProbe(runtime_id, semantic_id, source_digest, condition_count, evaluated_mask, true_mask, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            val evaluated_json = serialize_operand(evaluated_mask)
            val true_json = serialize_operand(true_mask)
            "{\"DynamicDecisionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"source_digest\":{source_digest},\"condition_count\":{condition_count},\"evaluated_mask\":{evaluated_json},\"true_mask\":{true_json},\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case DynamicConditionProbe(runtime_id, semantic_id, parent_runtime_id, parent_semantic_id, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            "{\"DynamicConditionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"parent_runtime_id\":{parent_runtime_id},\"parent_semantic_id\":\"{escape_json_string(parent_semantic_id)}\",\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case GetElementPtr(dest, base, indices):
            val b = serialize_operand(base)
            var idxs = "["
            var first = true
            for idx in indices:
                if not first:
                    idxs = "{idxs},"
                idxs = "{idxs}{serialize_operand(idx)}"
                first = false
            idxs = "{idxs}]"
            "{\"GetElementPtr\":{\"dest\":{local_id_value(dest)},\"base\":{b},\"indices\":{idxs}}}"

        case CheckedBinOp(dest, op, left, right):
            val opstr = serialize_binop(op)
            val l = serialize_operand(left)
            val r = serialize_operand(right)
            "{\"CheckedBinOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"left\":{l},\"right\":{r}}}"

        case VhdlResize(dest, operand, new_width, signed):
            val opnd = serialize_operand(operand)
            "{\"VhdlResize\":{\"dest\":{local_id_value(dest)},\"operand\":{opnd},\"new_width\":{new_width},\"signed\":{signed}}}"

        case VhdlSlice(dest, signal, hi, lo):
            val sig = serialize_operand(signal)
            "{\"VhdlSlice\":{\"dest\":{local_id_value(dest)},\"signal\":{sig},\"hi\":{hi},\"lo\":{lo}}}"

        case VhdlConcat(dest, parts):
            var partsStr = "["
            var firstPart = true
            for part in parts:
                if not firstPart:
                    partsStr = "{partsStr},"
                partsStr = "{partsStr}{serialize_operand(part)}"
                firstPart = false
            partsStr = "{partsStr}]"
            "{\"VhdlConcat\":{\"dest\":{local_id_value(dest)},\"parts\":{partsStr}}}"

        case Nop:
            "\"Nop\""

        case DebugValue(local, name):
            "{\"DebugValue\":{\"local\":{local_id_value(local)},\"name\":\"{escape_json_string(name)}\"}}"

        case ResultMatchSemantic(scrutinee, destination, ok_block, err_block, merge_block, ok_payload, err_payload):
            "{\"ResultMatchSemantic\":{\"scrutinee\":{local_id_value(scrutinee)},\"destination\":{local_id_value(destination)},\"ok_block\":{block_id_value(ok_block)},\"err_block\":{block_id_value(err_block)},\"merge_block\":{block_id_value(merge_block)},\"ok_payload\":{local_id_value(ok_payload)},\"err_payload\":{local_id_value(err_payload)}}}"

        case _:
            "\"UnsupportedInst\""

# ============================================================================
# Block Serialization
# ============================================================================

fn serialize_mir_block(block: MirBlock) -> text:
    """Serialize block to JSON."""
    match block:
        case MirBlock(id, label, instructions, terminator):
            var json = "{"
            json = "{json}\"id\":{block_id_value(id)},"

            if val block_label = label:
                json = "{json}\"label\":\"{escape_json_string(block_label)}\","
            else:
                json = "{json}\"label\":null,"

            # Instructions
            json = "{json}\"instructions\":["
            var firstInst = true
            for inst in instructions:
                if not firstInst:
                    json = "{json},"
                json = "{json}{serialize_mir_inst_kind(inst.kind)}"
                firstInst = false
            json = "{json}],"

            # Terminator
            json = "{json}\"terminator\":{serialize_mir_terminator(terminator)}"
            json = "{json}}"
            json

# ============================================================================
# Signature Serialization
# ============================================================================

fn serialize_mir_signature(sig: MirSignature) -> text:
    """Serialize function signature to JSON."""
    var json = "{"

    # Params
    json = "{json}\"params\":["
    var firstParam = true
    for param in sig.params:
        if not firstParam:
            json = "{json},"
        json = "{json}{serialize_mir_type(param)}"
        firstParam = false
    json = "{json}],"

    # Return type
    if sig.return_type == nil:
        json = "{json}\"return_type\":null,"
    else:
        json = "{json}\"return_type\":{serialize_mir_type(sig.return_type)},"

    # Variadic
    val variadicStr = if sig.is_variadic: "true" else: "false"
    json = "{json}\"is_variadic\":{variadicStr}"

    json = "{json}}"
    json

# ============================================================================
# Local Serialization
# ============================================================================

fn serialize_mir_local(local: MirLocal) -> text:
    """Serialize local variable to JSON."""
    match local:
        case MirLocal(id, name, type_, kind, is_ghost):
            var json = "{"
            json = "{json}\"id\":{local_id_value(id)},"

            if val local_name = name:
                json = "{json}\"name\":\"{escape_json_string(local_name)}\","
            else:
                json = "{json}\"name\":null,"

            json = "{json}\"type\":{serialize_mir_type(type_)},"

            # Kind
            val kindJson = match kind:
                case Arg(index): "{\"Arg\":{index}}"
                case Var: "\"Var\""
                case Temp: "\"Temp\""
                case Return: "\"Return\""

            json = "{json}\"kind\":{kindJson}"
            json = "{json}}"
            json

# ============================================================================
# Function Serialization
# ============================================================================

fn serialize_mir_function(func: MirFunction) -> text:
    """Serialize MIR function to JSON."""
    var json = "{"
    json = "{json}\"symbol\":{symbol_id_value(func.symbol)},"
    json = "{json}\"name\":\"{escape_json_string(func.name)}\","
    json = "{json}\"signature\":{serialize_mir_signature(func.signature)},"

    # Locals
    json = "{json}\"locals\":["
    var firstLocal = true
    for local in func.locals:
        if not firstLocal:
            json = "{json},"
        json = "{json}{serialize_mir_local(local)}"
        firstLocal = false
    json = "{json}],"

    # Blocks
    json = "{json}\"blocks\":["
    var firstBlock = true
    for block in func.blocks:
        if not firstBlock:
            json = "{json},"
        json = "{json}{serialize_mir_block(block)}"
        firstBlock = false
    json = "{json}],"

    json = "{json}\"entry_block\":{block_id_value(func.entry_block)}"
    json = "{json}}"
    json

# ============================================================================
# Utility Functions
# ============================================================================

fn escape_json_string(s: text) -> text:
    """Escape string for JSON."""
    var result = ""
    for i in 0..s.len():
        val c = s[i:i+1]
        if c == "\"":
            result = "{result}\\\""
        else:
            if c == "\\":
                result = "{result}\\\\"
            else:
                if c == "\n":
                    result = "{result}\\n"
                else:
                    if c == "\r":
                        result = "{result}\\r"
                    else:
                        if c == "\t":
                            result = "{result}\\t"
                        else:
                            result = "{result}{c}"
    result

