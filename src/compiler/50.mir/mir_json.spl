# MIR JSON Serialization - Bootstrap-Compatible Version
#
# Simplified implementation using only basic Simple syntax.

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock}
use compiler.mir.mir_types.{MirType}
use compiler.mir.mir_types.{LocalId}  # explicit: a glob is not an import-origin for surface projection
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_enum_semantic_types.{MirEnumPatternKindV1, MirEnumPatternNodeV1,
    MirEnumSiteKindV1, MirEnumSiteV1, MirEnumArmSemanticV1, MirEnumMatchSemanticV1,
    MirEnumVariantSlotsV1, MirEnumDeclarationIdentityV1}

fn symbol_id_value(symbol: SymbolId) -> i64:
    symbol.id

fn local_id_value(local: LocalId) -> i64:
    local.id

fn block_id_value(block: BlockId) -> i64:
    block.id

fn serialize_switch_case(switch_case: SwitchCase) -> text:
    match switch_case:
        case SwitchCase(value, target):
            "{\"value\":{value},\"target\":{block_id_value(target)}}"

# ============================================================================
# Type Serialization
# ============================================================================

fn serialize_mir_type(t: MirType) -> text:
    """Serialize MIR type to JSON."""
    val k = t.kind

    # Use match for all type kinds
    match k:
        # Primitives
        case I8: "\"I8\""
        case I16: "\"I16\""
        case I32: "\"I32\""
        case I64: "\"I64\""
        case U8: "\"U8\""
        case U16: "\"U16\""
        case U32: "\"U32\""
        case U64: "\"U64\""
        case F32: "\"F32\""
        case F64: "\"F64\""
        case Bool: "\"Bool\""
        case Char: "\"Char\""
        case Unit: "\"Unit\""
        case Never: "\"Never\""
        case Vec4f: "\"Vec4f\""
        case Vec8f: "\"Vec8f\""
        case Vec4d: "\"Vec4d\""
        case Vec4i: "\"Vec4i\""
        case Vec8i: "\"Vec8i\""
        case Vec16f: "\"Vec16f\""
        case Vec8d: "\"Vec8d\""
        case Vec16i: "\"Vec16i\""

        # Pointers and references
        case Ptr(pointee, mutable):
            val p = serialize_mir_type(pointee)
            val m = if mutable: "true" else: "false"
            "{\"Ptr\":{\"pointee\":{p},\"mutable\":{m}}}"

        case Ref(referent, mutable):
            val r = serialize_mir_type(referent)
            val m = if mutable: "true" else: "false"
            "{\"Ref\":{\"referent\":{r},\"mutable\":{m}}}"

        case FuncPtr(signature):
            val sig = serialize_mir_signature(signature)
            "{\"FuncPtr\":{sig}}"

        # Aggregates
        case Array(element, size):
            val e = serialize_mir_type(element)
            "{\"Array\":{\"element\":{e},\"size\":{size}}}"

        case Dict(key, value):
            val k = serialize_mir_type(key)
            val v = serialize_mir_type(value)
            "{\"Dict\":{\"key\":{k},\"value\":{v}}}"

        case Slice(element):
            val e = serialize_mir_type(element)
            "{\"Slice\":{e}}"

        case Tuple(elements):
            var elems = "["
            var first = true
            for elem in elements:
                if not first:
                    elems = "{elems},"
                elems = "{elems}{serialize_mir_type(elem)}"
                first = false
            elems = "{elems}]"
            "{\"Tuple\":{elems}}"

        case Struct(symbol):
            "{\"Struct\":{symbol_id_value(symbol)}}"

        case Enum(symbol):
            "{\"Enum\":{symbol_id_value(symbol)}}"

        case Result(ok_type, err_type):
            val ok_json = serialize_mir_type(ok_type)
            val err_json = serialize_mir_type(err_type)
            "{\"Result\":{\"ok\":{ok_json},\"err\":{err_json}}}"

        case Bits(width, signed):
            "{\"Bits\":{\"width\":{width},\"signed\":{signed}}}"

        # Special types
        case Opaque(name):
            "{\"Opaque\":\"{escape_json_string(name)}\"}"

        # Async types
        case Promise(inner):
            val i = serialize_mir_type(inner)
            "{\"Promise\":{i}}"

        case Generator(yieldType, returnType):
            val y = serialize_mir_type(yieldType)
            val r = serialize_mir_type(returnType)
            "{\"Generator\":{\"yield\":{y},\"return\":{r}}}"

        case ActorType(message):
            val m = serialize_mir_type(message)
            "{\"ActorType\":{m}}"

        # Union type
        case Union(members):
            var elems = "["
            var first = true
            for member in members:
                if not first:
                    elems = "{elems},"
                elems = "{elems}{serialize_mir_type(member)}"
                first = false
            elems = "{elems}]"
            "{\"Union\":{elems}}"

        case ScalableVec(element, min_lanes):
            "{\"ScalableVec\":{\"element\":{serialize_mir_type(element)},\"min_lanes\":{min_lanes}}}"

# ============================================================================
# Constant Value Serialization
# ============================================================================

fn serialize_const_value(c: MirConstValue) -> text:
    """Serialize constant value to JSON."""
    match c:
        case Int(n):
            "{n}"
        case FloatLexeme(f):
            f
        case Float(f):
            "{f}"
        case Bool(b):
            if b: "true" else: "false"
        case Str(s):
            "\"{escape_json_string(s)}\""
        case Array(elements):
            var values: [text] = []
            for element in elements:
                values.push(serialize_const_value(element))
            "{\"Array\":[" + values.join(",") + "]}"
        case Tuple(elements):
            var values: [text] = []
            for element in elements:
                values.push(serialize_const_value(element))
            "{\"Tuple\":[" + values.join(",") + "]}"
        case Struct(fields):
            var values: [text] = []
            for name in fields.keys().sorted():
                values.push("\"{escape_json_string(name)}\":{serialize_const_value(fields[name])}")
            "{\"Struct\":{" + values.join(",") + "}}"
        case Zero:
            "\"Zero\""

# ============================================================================
# Operation Serialization
# ============================================================================

fn serialize_binop(op: MirBinOp) -> text:
    """Serialize binary operation."""
    match op:
        case Add: "\"Add\""
        case Sub: "\"Sub\""
        case Mul: "\"Mul\""
        case Div: "\"Div\""
        case Rem: "\"Rem\""
        case Pow: "\"Pow\""
        case MatMul: "\"MatMul\""
        case BitAnd: "\"BitAnd\""
        case BitOr: "\"BitOr\""
        case BitXor: "\"BitXor\""
        case Shl: "\"Shl\""
        case Shr: "\"Shr\""
        case Eq: "\"Eq\""
        case Ne: "\"Ne\""
        case Lt: "\"Lt\""
        case Le: "\"Le\""
        case Gt: "\"Gt\""
        case Ge: "\"Ge\""
        case BroadcastAdd: "\"BroadcastAdd\""
        case BroadcastSub: "\"BroadcastSub\""
        case BroadcastMul: "\"BroadcastMul\""
        case BroadcastDiv: "\"BroadcastDiv\""
        case BroadcastPow: "\"BroadcastPow\""
        case Offset: "\"Offset\""

fn serialize_unaryop(op: MirUnaryOp) -> text:
    """Serialize unary operation."""
    match op:
        case Neg: "\"Neg\""
        case Not: "\"Not\""
        case BitNot: "\"BitNot\""
        case Transpose: "\"Transpose\""

fn serialize_aggregate_kind(kind: AggregateKind) -> text:
    """Serialize aggregate kind to JSON."""
    match kind:
        case Array(elemType):
            val t = serialize_mir_type(elemType)
            "{\"Array\":{t}}"
        case Tuple:
            "\"Tuple\""
        case Struct(symbol):
            "{\"Struct\":{symbol_id_value(symbol)}}"
        case Enum(symbol, variant):
            "{\"Enum\":{\"symbol\":{symbol_id_value(symbol)},\"variant\":{variant}}}"

# ============================================================================
# Operand Serialization
# ============================================================================

fn serialize_operand(op: MirOperand) -> text:
    """Serialize operand to JSON."""
    val k = op.kind

    match k:
        case Copy(local):
            "{\"Copy\":{local_id_value(local)}}"
        case Move(local):
            "{\"Move\":{local_id_value(local)}}"
        case Const(value, mtype):
            val vj = serialize_const_value(value)
            val tj = serialize_mir_type(mtype)
            "{\"Const\":{\"value\":{vj},\"type\":{tj}}}"

fn serialize_execution_domain(domain: MirExecutionDomain) -> text:
    match domain:
        case MirExecutionDomain.Parent: "parent"
        case MirExecutionDomain.Thread: "thread"
        case MirExecutionDomain.Process: "process"
        case MirExecutionDomain.Actor: "actor"
        case MirExecutionDomain.Device: "device"
        case MirExecutionDomain.Remote: "remote"

fn serialize_transfer_mode(mode: MirTransferMode) -> text:
    match mode:
        case MirTransferMode.Copy: "copy"
        case MirTransferMode.FrozenShare: "frozen_share"
        case MirTransferMode.OwnedMove: "owned_move"
        case MirTransferMode.ScopedLoan: "scoped_loan"
        case MirTransferMode.Lease: "lease"

fn serialize_transfer_payload(payload: MirTransferPayload) -> text:
    match payload:
        case MirTransferPayload.InlineCopy: "inline_copy"
        case MirTransferPayload.FrozenRegion: "frozen_region"
        case MirTransferPayload.OwnedRegion: "owned_region"
        case MirTransferPayload.EncodedCopy: "encoded_copy"
        case MirTransferPayload.ObjectHandle: "object_handle"
        case MirTransferPayload.SharedSync: "shared_sync"
        case MirTransferPayload.DeviceLease: "device_lease"

# ============================================================================
# Terminator Serialization
# ============================================================================

fn serialize_mir_terminator(term: MirTerminator) -> text:
    """Serialize terminator to JSON."""
    match term:
        case Goto(target):
            "{\"Goto\":{block_id_value(target)}}"

        case MirTerminator.Ret(maybeVal):
            if val return_value = maybeVal:
                val v = serialize_operand(return_value)
                "{\"Return\":{v}}"
            else:
                "{\"Return\":null}"

        case If(cond, thenBlock, elseBlock):
            val c = serialize_operand(cond)
            "{\"If\":{\"cond\":{c},\"then\":{block_id_value(thenBlock)},\"else\":{block_id_value(elseBlock)}}}"

        case Switch(value, targets, defaultBlock):
            val v = serialize_operand(value)
            var cases = "["
            var first = true
            for switchCase in targets:
                if not first:
                    cases = "{cases},"
                cases = "{cases}{serialize_switch_case(switchCase)}"
                first = false
            cases = "{cases}]"
            "{\"Switch\":{\"value\":{v},\"targets\":{cases},\"default\":{block_id_value(defaultBlock)}}}"

        case CallTerminator(maybeDest, func, args, normal, maybeUnwind,
                            maybePayloadDest, maybeTypeTagDest):
            val f = serialize_operand(func)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            var destStr = "null"
            if val dest = maybeDest:
                destStr = "{local_id_value(dest)}"
            var unwindStr = "null"
            if val unwind = maybeUnwind:
                unwindStr = "{block_id_value(unwind)}"
            var payloadDestStr = "null"
            if val payloadDest = maybePayloadDest:
                payloadDestStr = "{local_id_value(payloadDest)}"
            var typeTagDestStr = "null"
            if val typeTagDest = maybeTypeTagDest:
                typeTagDestStr = "{local_id_value(typeTagDest)}"

            "{\"CallTerminator\":{\"dest\":{destStr},\"func\":{f},\"args\":{argsStr},\"normal\":{block_id_value(normal)},\"unwind\":{unwindStr},\"unwind_payload_dest\":{payloadDestStr},\"unwind_type_tag_dest\":{typeTagDestStr}}}"

        case Unreachable:
            "\"Unreachable\""

        case Abort(msg):
            "{\"Abort\":\"{escape_json_string(msg)}\"}"

        case Throw(payload, type_tag):
            "{\"Throw\":{\"payload\":{serialize_operand(payload)},\"type_tag\":{serialize_operand(type_tag)}}}"

        case Resume(payload, type_tag):
            "{\"Resume\":{\"payload\":{serialize_operand(payload)},\"type_tag\":{serialize_operand(type_tag)}}}"

        case _:
            "\"UnknownTerminator\""

# ============================================================================
# Instruction Serialization
# ============================================================================

fn serialize_mir_inst_kind(inst: MirInstKind) -> text:
    """Serialize instruction kind to JSON."""
    match inst:
        case Const(dest, value, mtype):
            val v = serialize_const_value(value)
            val t = serialize_mir_type(mtype)
            "{\"Const\":{\"dest\":{local_id_value(dest)},\"value\":{v},\"type\":{t}}}"

        case Copy(dest, src):
            "{\"Copy\":{\"dest\":{local_id_value(dest)},\"src\":{local_id_value(src)}}}"

        case Move(dest, src):
            "{\"Move\":{\"dest\":{local_id_value(dest)},\"src\":{local_id_value(src)}}}"

        case TransferOut(dest, source, destination, mode, payload, runtime_classify):
            "{\"TransferOut\":{\"dest\":{local_id_value(dest)},\"source\":{local_id_value(source)},\"destination\":\"{serialize_execution_domain(destination)}\",\"mode\":\"{serialize_transfer_mode(mode)}\",\"payload\":\"{serialize_transfer_payload(payload)}\",\"runtime_classify\":{runtime_classify}}}"

        case TransferIn(dest, source, mode, payload):
            "{\"TransferIn\":{\"dest\":{local_id_value(dest)},\"source\":\"{serialize_execution_domain(source)}\",\"mode\":\"{serialize_transfer_mode(mode)}\",\"payload\":\"{serialize_transfer_payload(payload)}\"}}"

        case FreezeRegion(local):
            "{\"FreezeRegion\":{local_id_value(local)}}"

        case AcquireSnapshot(dest, source):
            "{\"AcquireSnapshot\":{\"dest\":{local_id_value(dest)},\"source\":{local_id_value(source)}}}"

        case CommitUpdates(dest, base, updates):
            val dest_text = match dest:
                case Some(local): "{local_id_value(local)}"
                case nil: "null"
            "{\"CommitUpdates\":{\"dest\":{dest_text},\"base\":{local_id_value(base)},\"updates\":{local_id_value(updates)}}}"

        case Drop(local):
            "{\"Drop\":{local_id_value(local)}}"

        case BinOp(dest, op, left, right):
            val opstr = serialize_binop(op)
            val l = serialize_operand(left)
            val r = serialize_operand(right)
            "{\"BinOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"left\":{l},\"right\":{r}}}"

        case UnaryOp(dest, op, operand):
            val opstr = serialize_unaryop(op)
            val o = serialize_operand(operand)
            "{\"UnaryOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"operand\":{o}}}"

        case Alloc(dest, mtype):
            val t = serialize_mir_type(mtype)
            "{\"Alloc\":{\"dest\":{local_id_value(dest)},\"type\":{t}}}"

        case Load(dest, ptr):
            val p = serialize_operand(ptr)
            "{\"Load\":{\"dest\":{local_id_value(dest)},\"ptr\":{p}}}"

        case Store(ptr, value):
            val p = serialize_operand(ptr)
            val v = serialize_operand(value)
            "{\"Store\":{\"ptr\":{p},\"value\":{v}}}"

        case GlobalAddr(dest, symbol, mutable):
            "{\"GlobalAddr\":{\"dest\":{local_id_value(dest)},\"symbol\":{symbol.id},\"mutable\":{mutable}}}"

        case LoadGlobal(dest, symbol):
            "{\"LoadGlobal\":{\"dest\":{local_id_value(dest)},\"symbol\":{symbol.id}}}"

        case StoreGlobal(symbol, value):
            "{\"StoreGlobal\":{\"symbol\":{symbol.id},\"value\":{serialize_operand(value)}}}"

        case Call(maybeDest, func, args):
            val f = serialize_operand(func)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"Call\":{\"dest\":{local_id_value(dest)},\"func\":{f},\"args\":{argsStr}}}"
            else:
                "{\"Call\":{\"dest\":null,\"func\":{f},\"args\":{argsStr}}}"

        case GetField(dest, base, field):
            val b = serialize_operand(base)
            "{\"GetField\":{\"dest\":{local_id_value(dest)},\"base\":{b},\"field\":{field}}}"

        case SetField(base, field, value):
            val b = serialize_operand(base)
            val v = serialize_operand(value)
            "{\"SetField\":{\"base\":{b},\"field\":{field},\"value\":{v}}}"

        case Aggregate(dest, kind, operands):
            val k = serialize_aggregate_kind(kind)
            var ops = "["
            var first = true
            for op in operands:
                if not first:
                    ops = "{ops},"
                ops = "{ops}{serialize_operand(op)}"
                first = false
            ops = "{ops}]"
            "{\"Aggregate\":{\"dest\":{local_id_value(dest)},\"kind\":{k},\"operands\":{ops}}}"

        case Cast(dest, operand, targetType):
            val o = serialize_operand(operand)
            val t = serialize_mir_type(targetType)
            "{\"Cast\":{\"dest\":{local_id_value(dest)},\"operand\":{o},\"target\":{t}}}"

        case Bitcast(dest, operand, targetType):
            val o = serialize_operand(operand)
            val t = serialize_mir_type(targetType)
            "{\"Bitcast\":{\"dest\":{local_id_value(dest)},\"operand\":{o},\"target\":{t}}}"

        case CallIndirect(maybeDest, ptr, args, signature):
            val p = serialize_operand(ptr)
            val sig = serialize_mir_signature(signature)
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"CallIndirect\":{\"dest\":{local_id_value(dest)},\"ptr\":{p},\"args\":{argsStr},\"signature\":{sig}}}"
            else:
                "{\"CallIndirect\":{\"dest\":null,\"ptr\":{p},\"args\":{argsStr},\"signature\":{sig}}}"

        case Intrinsic(maybeDest, name, args):
            var argsStr = "["
            var firstArg = true
            for arg in args:
                if not firstArg:
                    argsStr = "{argsStr},"
                argsStr = "{argsStr}{serialize_operand(arg)}"
                firstArg = false
            argsStr = "{argsStr}]"

            if val dest = maybeDest:
                "{\"Intrinsic\":{\"dest\":{local_id_value(dest)},\"name\":\"{escape_json_string(name)}\",\"args\":{argsStr}}}"
            else:
                "{\"Intrinsic\":{\"dest\":null,\"name\":\"{escape_json_string(name)}\",\"args\":{argsStr}}}"

        case DecisionProbe(runtime_id, semantic_id, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            "{\"DecisionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case ConditionProbe(runtime_id, semantic_id, parent_runtime_id, parent_semantic_id, result, authored_path, line, column):
            val result_json = serialize_operand(result)
            "{\"ConditionProbe\":{\"runtime_id\":{runtime_id},\"semantic_id\":\"{escape_json_string(semantic_id)}\",\"parent_runtime_id\":{parent_runtime_id},\"parent_semantic_id\":\"{escape_json_string(parent_semantic_id)}\",\"result\":{result_json},\"authored_path\":\"{escape_json_string(authored_path)}\",\"line\":{line},\"column\":{column}}}"

        case GetElementPtr(dest, base, indices):
            val b = serialize_operand(base)
            var idxs = "["
            var first = true
            for idx in indices:
                if not first:
                    idxs = "{idxs},"
                idxs = "{idxs}{serialize_operand(idx)}"
                first = false
            idxs = "{idxs}]"
            "{\"GetElementPtr\":{\"dest\":{local_id_value(dest)},\"base\":{b},\"indices\":{idxs}}}"

        case CheckedBinOp(dest, op, left, right):
            val opstr = serialize_binop(op)
            val l = serialize_operand(left)
            val r = serialize_operand(right)
            "{\"CheckedBinOp\":{\"dest\":{local_id_value(dest)},\"op\":{opstr},\"left\":{l},\"right\":{r}}}"

        case VhdlResize(dest, operand, new_width, signed):
            val opnd = serialize_operand(operand)
            "{\"VhdlResize\":{\"dest\":{local_id_value(dest)},\"operand\":{opnd},\"new_width\":{new_width},\"signed\":{signed}}}"

        case VhdlSlice(dest, signal, hi, lo):
            val sig = serialize_operand(signal)
            "{\"VhdlSlice\":{\"dest\":{local_id_value(dest)},\"signal\":{sig},\"hi\":{hi},\"lo\":{lo}}}"

        case VhdlConcat(dest, parts):
            var partsStr = "["
            var firstPart = true
            for part in parts:
                if not firstPart:
                    partsStr = "{partsStr},"
                partsStr = "{partsStr}{serialize_operand(part)}"
                firstPart = false
            partsStr = "{partsStr}]"
            "{\"VhdlConcat\":{\"dest\":{local_id_value(dest)},\"parts\":{partsStr}}}"

        case Nop:
            "\"Nop\""

        case DebugValue(local, name):
            "{\"DebugValue\":{\"local\":{local_id_value(local)},\"name\":\"{escape_json_string(name)}\"}}"

        case ResultMatchSemantic(scrutinee, destination, ok_block, err_block, merge_block, ok_payload, err_payload):
            "{\"ResultMatchSemantic\":{\"scrutinee\":{local_id_value(scrutinee)},\"destination\":{local_id_value(destination)},\"ok_block\":{block_id_value(ok_block)},\"err_block\":{block_id_value(err_block)},\"merge_block\":{block_id_value(merge_block)},\"ok_payload\":{local_id_value(ok_payload)},\"err_payload\":{local_id_value(err_payload)}}}"

        case _:
            "\"UnsupportedInst\""

# ============================================================================
# Block Serialization
# ============================================================================

fn serialize_mir_block(block: MirBlock) -> text:
    """Serialize block to JSON."""
    # Large basic blocks must not retain every growing instruction prefix.
    match block:
        case MirBlock(id, label, instructions, terminator):
            var parts: [text] = ["{"]
            parts = parts.push("\"id\":{block_id_value(id)},")

            if val block_label = label:
                parts = parts.push("\"label\":\"{escape_json_string(block_label)}\",")
            else:
                parts = parts.push("\"label\":null,")

            # Instructions
            parts = parts.push("\"instructions\":[")
            # Join once: repeated prefix interpolation retains quadratic bytes.
            var instruction_parts: [text] = []
            for inst in instructions:
                instruction_parts.push(serialize_mir_inst_kind(inst.kind))
            parts = parts.push(instruction_parts.join(","))
            parts = parts.push("],")

            # Terminator
            parts = parts.push("\"terminator\":{serialize_mir_terminator(terminator)}")
            parts = parts.push("}")
            parts.join("")

# ============================================================================
# Signature Serialization
# ============================================================================

fn serialize_mir_signature(sig: MirSignature) -> text:
    """Serialize function signature to JSON."""
    var json = "{"

    # Params
    json = "{json}\"params\":["
    var firstParam = true
    for param in sig.params:
        if not firstParam:
            json = "{json},"
        json = "{json}{serialize_mir_type(param)}"
        firstParam = false
    json = "{json}],"

    # Return type
    if sig.return_type == nil:
        json = "{json}\"return_type\":null,"
    else:
        json = "{json}\"return_type\":{serialize_mir_type(sig.return_type)},"

    # Variadic
    val variadicStr = if sig.is_variadic: "true" else: "false"
    json = "{json}\"is_variadic\":{variadicStr},"
    val paramsKnownStr = if sig.params_known: "true" else: "false"
    json = "{json}\"params_known\":{paramsKnownStr}"

    json = "{json}}"
    json

# ============================================================================
# Local Serialization
# ============================================================================

fn serialize_mir_local(local: MirLocal) -> text:
    """Serialize local variable to JSON."""
    match local:
        case MirLocal(id, name, type_, kind, is_ghost, short_borrow, short_mutable, short_boundary):
            var json = "{"
            json = "{json}\"id\":{local_id_value(id)},"

            if val local_name = name:
                json = "{json}\"name\":\"{escape_json_string(local_name)}\","
            else:
                json = "{json}\"name\":null,"

            json = "{json}\"type\":{serialize_mir_type(type_)},"

            # Kind
            val kindJson = match kind:
                case Arg(index): "{\"Arg\":{index}}"
                case Var: "\"Var\""
                case Temp: "\"Temp\""
                case Return: "\"Return\""

            json = "{json}\"kind\":{kindJson}"
            # Preserve legacy bytes for locals without short provenance, but
            # include all three fields whenever a short contract is present.
            # Unknown boundary (-1) is serialized rather than invented.
            if short_borrow or short_mutable or short_boundary != -1:
                json = "{json},\"short_borrow\":{short_borrow},"
                json = "{json}\"short_mutable\":{short_mutable},"
                json = "{json}\"short_boundary\":{short_boundary}"
            json = "{json}}"
            json

# ============================================================================
# Function Serialization
# ============================================================================

fn serialize_mir_function(func: MirFunction) -> text:
    """Serialize canonical MIR, including versioned nonempty enum metadata."""
    serialize_mir_function_canonical_v1(func, true)

fn serialize_mir_function_subject_v1(func: MirFunction) -> text:
    """The existing canonical function subject, excluding only enum metadata."""
    serialize_mir_function_canonical_v1(func, false)

fn serialize_mir_function_canonical_v1(func: MirFunction, include_enum_metadata: bool) -> text:
    # MIR capsule identities call this repeatedly. Retain each fragment once
    # instead of copying all previous locals/blocks for every appended item.
    var parts: [text] = ["{"]
    parts = parts.push("\"symbol\":{symbol_id_value(func.symbol)},")
    parts = parts.push("\"name\":\"{escape_json_string(func.name)}\",")
    parts = parts.push("\"signature\":{serialize_mir_signature(func.signature)},")

    # Locals
    parts = parts.push("\"locals\":[")
    var local_parts: [text] = []
    for local in func.locals:
        local_parts.push(serialize_mir_local(local))
    parts = parts.push(local_parts.join(","))
    parts = parts.push("],")

    # Blocks
    parts = parts.push("\"blocks\":[")
    var block_parts: [text] = []
    for block in func.blocks:
        block_parts.push(serialize_mir_block(block))
    parts = parts.push(block_parts.join(","))
    parts = parts.push("],")

    parts = parts.push("\"entry_block\":{block_id_value(func.entry_block)}")
    # SOURCE metadata changes the canonical subject. Empty ordinary functions
    # retain their established bytes and cannot authorize SOURCE execution.
    if (func.source_region_context_abi_v1 != 0 or func.source_region_context_local_v1 != -1 or func.source_region_closure_digest_v1 != ""):
        parts.push(",\"source_region_context\":{\"schema\":\"SourceRegionContext-v1\",\"abi\":{func.source_region_context_abi_v1},\"local\":{func.source_region_context_local_v1},\"closure_digest\":\"{escape_json_string(func.source_region_closure_digest_v1)}\"}")
    if include_enum_metadata and func.enum_matches.len() > 0:
        # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=preserve nonempty array values and a known join receiver
        var matches: [text] = []
        for record in func.enum_matches:
            matches.push(serialize_mir_enum_match_v1(record))
        parts.push(",\"enum_matches\":{\"schema\":\"MirEnumMatches-v1\",\"matches\":[")
        parts.push(matches.join(","))
        parts.push("]}")
    parts = parts.push("}")
    parts.join("")

fn serialize_mir_enum_span_v1(span: Span) -> text:
    "{\"start\":{span.start},\"end\":{span.end},\"line\":{span.line},\"col\":{span.col},\"file\":\"{escape_json_string(span.file)}\",\"length\":{span.length}}"

fn serialize_mir_enum_indexes_v1(indexes: [i64]) -> text:
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=preserve nonempty array values and a known join receiver
    var parts: [text] = []
    for index in indexes:
        parts.push("{index}")
    "[" + parts.join(",") + "]"

fn serialize_mir_enum_pattern_v1(node: MirEnumPatternNodeV1) -> text:
    val kind = match node.kind:
        case MirEnumPatternKindV1.Wildcard: "\"Wildcard\""
        case MirEnumPatternKindV1.Bind(symbol, local): "{\"Bind\":{\"source_symbol\":{symbol.id},\"destination_local\":{local.id}}}"
        case MirEnumPatternKindV1.Variant(owner, discriminant, children): "{\"Variant\":{\"owner_symbol\":{owner.id},\"discriminant\":{discriminant},\"children\":{serialize_mir_enum_indexes_v1(children)}}}"
        case MirEnumPatternKindV1.Tuple(children): "{\"Tuple\":{serialize_mir_enum_indexes_v1(children)}}"
        case MirEnumPatternKindV1.Literal(value, exact_type): "{\"Literal\":{\"value\":{serialize_const_value(value)},\"exact_type\":{serialize_mir_type(exact_type)}}}"
        case MirEnumPatternKindV1.Or(alternatives): "{\"Or\":{serialize_mir_enum_indexes_v1(alternatives)}}"
    "{\"kind\":{kind},\"expected_type\":{serialize_mir_type(node.expected_type)},\"source_span\":{serialize_mir_enum_span_v1(node.source_span)}}"

fn serialize_mir_enum_site_v1(site: MirEnumSiteV1) -> text:
    val kind = match site.kind:
        case MirEnumSiteKindV1.Discriminant: "Discriminant"
        case MirEnumSiteKindV1.VariantIdentityCheck: "VariantIdentityCheck"
        case MirEnumSiteKindV1.Payload: "Payload"
        case MirEnumSiteKindV1.PayloadSlot: "PayloadSlot"
        case MirEnumSiteKindV1.PayloadDecode: "PayloadDecode"
        case MirEnumSiteKindV1.Guard: "Guard"
        case MirEnumSiteKindV1.ArmResult: "ArmResult"
        case MirEnumSiteKindV1.PatternInstruction: "PatternInstruction"
        case MirEnumSiteKindV1.PatternTerminator: "PatternTerminator"
    "{\"kind\":\"{kind}\",\"block_id\":{site.block_id.id},\"instruction_index\":{site.instruction_index},\"exact_instruction_identity\":\"{escape_json_string(site.exact_instruction_identity)}\",\"semantic_input_type\":{serialize_mir_type(site.semantic_input_type)},\"semantic_output_type\":{serialize_mir_type(site.semantic_output_type)},\"related_pattern_node\":{site.related_pattern_node}}"

fn serialize_mir_enum_arm_v1(arm: MirEnumArmSemanticV1) -> text:
    var guard_entry = "null"
    if val entry = arm.guard_entry: guard_entry = "{entry.id}"
    var guard_result = "null"
    if val result = arm.guard_result: guard_result = serialize_operand(result)
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=native comprehension must preserve exit block identities
    var exits: [i64] = []
    for block in arm.body_exit_blocks:
        exits.push(block.id)
    "{\"source_arm_id\":{arm.source_arm_id},\"expanded_alternative_index\":{arm.expanded_alternative_index},\"pattern_root\":{arm.pattern_root},\"pattern_entry_block\":{arm.pattern_entry_block.id},\"pattern_entry_instruction_index\":{arm.pattern_entry_instruction_index},\"guard_entry\":{guard_entry},\"guard_entry_instruction_index\":{arm.guard_entry_instruction_index},\"guard_result\":{guard_result},\"body_entry\":{arm.body_entry.id},\"body_entry_instruction_index\":{arm.body_entry_instruction_index},\"body_exit_blocks\":{serialize_mir_enum_indexes_v1(exits)},\"pattern_failure_entry\":{arm.pattern_failure_entry.id},\"guard_failure_entry\":{arm.guard_failure_entry.id},\"source_span\":{serialize_mir_enum_span_v1(arm.source_span)}}"

fn serialize_mir_enum_match_v1(record: MirEnumMatchSemanticV1) -> text:
    # Stable field/vector order is part of the v1 canonical transport.
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=preserve nonempty enum metadata and known join receivers
    var patterns: [text] = []
    for node in record.pattern_nodes:
        patterns.push(serialize_mir_enum_pattern_v1(node))
    var arms: [text] = []
    for arm in record.arms:
        arms.push(serialize_mir_enum_arm_v1(arm))
    var sites: [text] = []
    for site in record.sites:
        sites.push(serialize_mir_enum_site_v1(site))
    var parts: [text] = ["{\"schema\":\"{escape_json_string(record.schema)}\",\"match_id\":{record.match_id},\"enum_owner\":{record.enum_owner.id},"]
    parts.push("\"scrutinee_operand\":{serialize_operand(record.scrutinee_operand)},\"scrutinee_semantic_type\":{serialize_mir_type(record.scrutinee_semantic_type)},")
    parts.push("\"entry_block\":{record.entry_block.id},\"entry_instruction_index\":{record.entry_instruction_index},\"result_local\":{record.result_local.id},\"merge_block\":{record.merge_block.id},")
    parts.push("\"pattern_nodes\":[" + patterns.join(",") + "],\"arms\":[" + arms.join(",") + "],\"sites\":[" + sites.join(",") + "],")
    parts.push("\"source_span\":{serialize_mir_enum_span_v1(record.source_span)},\"declaration_identity\":\"{escape_json_string(record.declaration_identity)}\",\"subject_identity\":\"{escape_json_string(record.subject_identity)}\"}")
    parts.join("")

fn serialize_mir_enum_variant_slots_v1(variant: MirEnumVariantSlotsV1) -> text:
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=preserve variant slots and known join receivers
    var types: [text] = []
    for type_ in variant.slot_types:
        types.push(serialize_mir_type(type_))
    var names: [text] = []
    for name in variant.slot_names:
        names.push("\"" + escape_json_string(name) + "\"")
    "{\"discriminant\":{variant.discriminant},\"source_variant\":{variant.source_variant.id},\"slot_types\":[" + types.join(",") + "],\"slot_names\":[" + names.join(",") + "]}"

fn serialize_mir_enum_declaration_v1(record: MirEnumDeclarationIdentityV1) -> text:
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=preserve declarations and a known join receiver
    var variants: [text] = []
    for variant in record.variants:
        variants.push(serialize_mir_enum_variant_slots_v1(variant))
    "{\"schema\":\"MirEnumDeclarationIdentity-v1\",\"owner\":{record.owner.id},\"source_owner\":{record.source_owner.id},\"runtime_name\":\"{escape_json_string(record.runtime_name)}\",\"runtime_identity\":{record.runtime_identity},\"variants\":[" + variants.join(",") + "]}"

fn escape_json_string(s: text) -> text:
    """Escape string for JSON."""
    # Keep each already-escaped fragment and assemble the output once. Repeated
    # interpolation copied the full prefix for every input unit, making long
    # MIR names and diagnostic payloads quadratic in output bytes.
    var parts: [text] = []
    for c in s.chars():
        if c == "\"":
            parts.push("\\\"")
        else:
            if c == "\\":
                parts.push("\\\\")
            else:
                if c == "\n":
                    parts.push("\\n")
                else:
                    if c == "\r":
                        parts.push("\\r")
                    else:
                        if c == "\t":
                            parts.push("\\t")
                        else:
                            val code = c.ord()
                            if code >= 0 and code < 32:
                                val hex = "0123456789abcdef"
                                parts.push("\\u00" + hex[code / 16:code / 16 + 1] + hex[code % 16:code % 16 + 1])
                            else:
                                parts.push(c)
    parts.join("")

# ============================================================================
# Exports
# ============================================================================
