"""Canonical typed facet adapter lowering through the existing indirect call."""

use compiler.common.structural_contracts.facet_artifact.{
    FACET_ARTIFACT_VERSION, FACET_WITNESS_DESCRIPTOR_VERSION, FacetContractMetadata,
    FacetWitnessDescriptorV1
}
use compiler.hir.facet_static.{HirFacetInterface}
use compiler.mir.mir_types.{LocalId, MirSignature, MirType, MirTypeKind}
use compiler.mir.mir_instructions.{
    MirInstKind, MirOperand
}
use std.common.crypto.sha256.{sha256_text}

enum FacetRefEscapeKind:
    LocalUse
    Copy
    Return
    Store
    Capture
    AsyncTransfer
    ThreadTransfer

struct FacetAcquisitionContextPlan:
    """Compiler-visible application owner used for acquire and exact release."""
    owner_type_id: text
    runtime_owner: MirOperand
    acquire_symbol: text
    release_symbol: text

struct TypedFacetAdapterPlan:
    """Application-local adapter over an acquired runtime descriptor lease."""
    base_type: MirType
    base: MirOperand
    facet_interface_id: text
    facet_contract_abi_hash: text
    descriptor_lease: MirOperand
    contract: FacetContractMetadata
    context: FacetAcquisitionContextPlan

struct TypedFacetMemberPlan:
    method_name: text
    method_ordinal: i64
    signature: MirSignature

fn facet_acquisition_runtime_symbol(mode: text) -> text:
    if mode == "try_facet":
        return "aspect_execution_context_acquire_facet_descriptor"
    "aspect_execution_context_acquire_or_activate_facet_descriptor"

fn facet_acquisition_context_plan(
    owner_type_id: text,
    runtime_owner: MirOperand,
    acquire_symbol: text,
    release_symbol: text
) -> Result<FacetAcquisitionContextPlan, text>:
    if owner_type_id == "" or acquire_symbol == "" or release_symbol == "":
        return Err("E-AF005 dynamic facet acquisition requires an explicit application runtime context")
    if acquire_symbol == release_symbol:
        return Err("E-AF005 facet acquisition and release boundaries must be distinct")
    Ok(FacetAcquisitionContextPlan(
        owner_type_id: owner_type_id,
        runtime_owner: runtime_owner,
        acquire_symbol: acquire_symbol,
        release_symbol: release_symbol))

fn facet_typed_base_type_supported(base_type: MirType) -> bool:
    # `Any` and dyn-trait names are erasure shortcuts, not typed base storage.
    match base_type.kind:
        case Opaque(name):
            not (name == "Any" or name.starts_with("dyn_"))
        case _: true

fn validate_typed_facet_descriptor(
    contract: FacetContractMetadata,
    descriptor: FacetWitnessDescriptorV1
) -> Result<(), text>:
    if contract.facet_interface_id == "" or contract.abi_hash == "":
        return Err("E-AF002 typed facet contract identity is incomplete")
    if descriptor.descriptor_version != FACET_WITNESS_DESCRIPTOR_VERSION:
        return Err("E-AF002 typed facet descriptor version is unsupported")
    if descriptor.owner_id == "" or descriptor.descriptor_symbol == "":
        return Err("E-AF002 typed facet descriptor has no resolved owner")
    if descriptor.facet_contract_abi_hash != contract.abi_hash:
        return Err("E-AF002 typed facet descriptor ABI hash does not match the contract")
    if descriptor.method_entries.len() != contract.method_names.len():
        return Err("E-AF002 typed facet descriptor method count does not match the contract")
    var index = 0
    while index < contract.method_names.len():
        val expected_name = contract.method_names[index]
        val method = descriptor.method_entries[index]
        if expected_name == "" or method.method_name != expected_name:
            return Err("E-AF002 typed facet descriptor method order/name does not match the contract")
        if method.method_symbol == "" or method.resolved_address <= 0:
            return Err("E-AF002 typed facet descriptor contains an unresolved method: {expected_name}")
        index = index + 1
    Ok(())

fn plan_typed_dynamic_facet_adapter(
    base_type: MirType,
    base: MirOperand,
    contract: FacetContractMetadata,
    descriptor_lease: MirOperand,
    context: FacetAcquisitionContextPlan
) -> Result<TypedFacetAdapterPlan, text>:
    if not facet_typed_base_type_supported(base_type):
        return Err("E-AF005 dynamic facet base must remain typed; erased Any/dyn bases are forbidden")
    if contract.facet_interface_id == "" or contract.abi_hash == "":
        return Err("E-AF002 typed facet contract identity is incomplete")
    Ok(TypedFacetAdapterPlan(
        base_type: base_type,
        base: base,
        facet_interface_id: contract.facet_interface_id,
        facet_contract_abi_hash: contract.abi_hash,
        descriptor_lease: descriptor_lease,
        contract: contract,
        context: context,
    ))

fn facet_contract_metadata_from_hir_interface(
    interface_: HirFacetInterface
) -> FacetContractMetadata:
    var names: [text] = []
    var signatures: [text] = []
    for method in interface_.methods:
        names = names.push(method.name)
        signatures = signatures.push(method.signature)
    val canonical = "facet-contract-v2\n" + interface_.aspect_id + "\n" +
        interface_.name + "\n" + interface_.parent_facets.join("\n") +
        "\n" + names.join("\n") + "\n" + signatures.join("\n")
    FacetContractMetadata(
        contract_version: FACET_ARTIFACT_VERSION,
        aspect_id: interface_.aspect_id,
        facet_interface_id: interface_.name,
        parent_facets: interface_.parent_facets,
        method_names: names,
        method_signatures: signatures,
        abi_hash: sha256_text(canonical))

fn facet_signature_scalar_type(name: text) -> Result<MirType, text>:
    val type_name = name.trim()
    match type_name:
        case "i8": Ok(MirType(kind: MirTypeKind.I8))
        case "i16": Ok(MirType(kind: MirTypeKind.I16))
        case "i32": Ok(MirType(kind: MirTypeKind.I32))
        case "i64" | "int": Ok(MirType(kind: MirTypeKind.I64))
        case "u8": Ok(MirType(kind: MirTypeKind.U8))
        case "u16": Ok(MirType(kind: MirTypeKind.U16))
        case "u32": Ok(MirType(kind: MirTypeKind.U32))
        case "u64": Ok(MirType(kind: MirTypeKind.U64))
        case "f32": Ok(MirType(kind: MirTypeKind.F32))
        case "f64" | "float": Ok(MirType(kind: MirTypeKind.F64))
        case "bool": Ok(MirType(kind: MirTypeKind.Bool))
        case "char": Ok(MirType(kind: MirTypeKind.Char))
        case "text": Ok(MirType(kind: MirTypeKind.Opaque("str")))
        case "()": Ok(MirType.unit())
        case _:
            if type_name == "" or type_name == "Any" or type_name.starts_with("dyn_"):
                return Err("E-AF005 facet method signature contains an erased or missing type")
            Ok(MirType(kind: MirTypeKind.Opaque(type_name)))

fn facet_method_signature(
    signature_text: text, base_type: MirType
) -> Result<MirSignature, text>:
    val open = signature_text.split("(")
    if open.len() < 2:
        return Err("E-AF005 facet method signature has no parameter list")
    val close = open[1:].join("(").split(")")
    if close.len() < 2:
        return Err("E-AF005 facet method signature has no closing parameter delimiter")
    val source_params = close[0].trim()
    var params: [MirType] = [base_type]
    if source_params != "":
        val parts = source_params.split(",")
        var index = 0
        while index < parts.len():
            val parameter = parts[index].trim()
            if index == 0 and parameter == "self":
                index = index + 1
                continue
            val colon = parameter.split(":")
            val type_text = if colon.len() > 1: colon[1:].join(":").trim() else: parameter
            params = params.push(facet_signature_scalar_type(type_text)?)
            index = index + 1
    val suffix = close[1:].join(")").trim()
    var return_type = MirType.unit()
    if suffix.starts_with("->"):
        return_type = facet_signature_scalar_type(suffix[2:].trim())?
    Ok(MirSignature(params: params, return_type: return_type, is_variadic: false))

fn resolve_typed_facet_member(
    adapter: TypedFacetAdapterPlan, method_name: text
) -> Result<TypedFacetMemberPlan, text>:
    var index = 0
    while index < adapter.contract.method_names.len():
        if adapter.contract.method_names[index] == method_name:
            if index >= adapter.contract.method_signatures.len():
                return Err("E-AF002 facet contract method signature is missing")
            return Ok(TypedFacetMemberPlan(
                method_name: method_name,
                method_ordinal: index,
                signature: facet_method_signature(
                    adapter.contract.method_signatures[index], adapter.base_type)?))
        index = index + 1
    Err("E-AF005 typed facet member is not in the validated contract: {method_name}")

fn validate_dynamic_facet_ref_escape(kind: FacetRefEscapeKind) -> Result<(), text>:
    match kind:
        case LocalUse: Ok(())
        case Copy: Err("E-AF006 leased FacetRef is affine and cannot be copied")
        case Return: Err("E-AF006 leased FacetRef cannot escape by return")
        case Store: Err("E-AF006 leased FacetRef cannot escape into stored state")
        case Capture: Err("E-AF006 leased FacetRef cannot be captured")
        case AsyncTransfer: Err("E-AF006 leased FacetRef cannot cross an async boundary")
        case ThreadTransfer: Err("E-AF006 leased FacetRef cannot cross a thread boundary")

fn lower_resolved_facet_witness_call(
    destination: LocalId?,
    resolved_witness: MirOperand,
    arguments: [MirOperand],
    signature: MirSignature
) -> MirInstKind:
    MirInstKind.CallIndirect(destination, resolved_witness, arguments, signature)

fn lower_resolved_facet_witness_method_call(
    destination: LocalId?,
    resolved_method: MirOperand,
    base: MirOperand,
    arguments: [MirOperand],
    signature: MirSignature
) -> Result<MirInstKind, text>:
    if signature.params.len() != arguments.len() + 1:
        return Err("E-AF005 facet witness method ABI requires base as the first argument")
    var receiver_arguments = [base]
    receiver_arguments = receiver_arguments.concat(arguments)
    Ok(lower_resolved_facet_witness_call(
        destination, resolved_method, receiver_arguments, signature))

fn lower_typed_facet_member_call(
    destination: LocalId?,
    adapter: TypedFacetAdapterPlan,
    member: TypedFacetMemberPlan,
    resolved_method: MirOperand,
    arguments: [MirOperand]
) -> Result<MirInstKind, text>:
    if member.method_name == "":
        return Err("E-AF005 typed facet member name is empty")
    lower_resolved_facet_witness_method_call(
        destination, resolved_method, adapter.base, arguments, member.signature)

export FacetRefEscapeKind, FacetAcquisitionContextPlan, TypedFacetAdapterPlan, TypedFacetMemberPlan
export facet_acquisition_context_plan, facet_acquisition_runtime_symbol
export validate_typed_facet_descriptor
export facet_contract_metadata_from_hir_interface, facet_method_signature
export plan_typed_dynamic_facet_adapter, resolve_typed_facet_member, validate_dynamic_facet_ref_escape
export lower_resolved_facet_witness_call, lower_resolved_facet_witness_method_call
export lower_typed_facet_member_call
