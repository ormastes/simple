# codex-impl
# Authoritative HIR-level MC/DC decision-form census.  Keep this table closed:
# adding a Boolean decision form requires either an instrumentation owner or a
# named backend-inapplicable receipt requirement; silent omission is invalid.

enum McdcSemanticDecisionFormV1:
    IfOrConditional
    Elif
    While
    MatchGuard
    ComprehensionFilter
    StaticAssertion
    Precondition
    Postcondition

enum McdcSemanticDecisionDispositionV1:
    Instrumented
    BackendInapplicable
    CompileTimeOnly

struct McdcSemanticDecisionDescriptorV1:
    form: McdcSemanticDecisionFormV1
    stable_name: text
    disposition: McdcSemanticDecisionDispositionV1
    governed_code: text
    reason: text

fn mcdc_semantic_decision_census_v1() -> [McdcSemanticDecisionDescriptorV1]:
    [
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.IfOrConditional,
            stable_name: "if-or-conditional", disposition: McdcSemanticDecisionDispositionV1.Instrumented,
            governed_code: "", reason: "HIR intentionally represents statement if and value conditional with one node"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.Elif,
            stable_name: "elif", disposition: McdcSemanticDecisionDispositionV1.Instrumented,
            governed_code: "", reason: "each ordered IfChain arm is an independent decision"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.While,
            stable_name: "while", disposition: McdcSemanticDecisionDispositionV1.Instrumented,
            governed_code: "", reason: "loop condition is evaluated once per attempted iteration"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.MatchGuard,
            stable_name: "match-guard", disposition: McdcSemanticDecisionDispositionV1.BackendInapplicable,
            governed_code: "MCDC-BACKEND-INAPPLICABLE-MATCH-GUARD",
            reason: "native MIR match guards are not implemented; governed platform-inapplicable evidence is required"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.ComprehensionFilter,
            stable_name: "comprehension-filter", disposition: McdcSemanticDecisionDispositionV1.BackendInapplicable,
            governed_code: "MCDC-BACKEND-INAPPLICABLE-COMPREHENSION-FILTER",
            reason: "native MIR comprehensions are not implemented; governed platform-inapplicable evidence is required"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.StaticAssertion,
            stable_name: "static-assertion", disposition: McdcSemanticDecisionDispositionV1.CompileTimeOnly,
            governed_code: "", reason: "static assertions are discharged before executable HIR"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.Precondition,
            stable_name: "precondition", disposition: McdcSemanticDecisionDispositionV1.CompileTimeOnly,
            governed_code: "", reason: "contracts are compile-time proof obligations in current executable HIR"),
        McdcSemanticDecisionDescriptorV1(
            form: McdcSemanticDecisionFormV1.Postcondition,
            stable_name: "postcondition", disposition: McdcSemanticDecisionDispositionV1.CompileTimeOnly,
            governed_code: "", reason: "contracts are compile-time proof obligations in current executable HIR")
    ]

fn mcdc_semantic_decision_census_v1_well_formed() -> bool:
    val rows = mcdc_semantic_decision_census_v1()
    if rows.len() != 8: return false
    var row_index = 0
    while row_index < rows.len():
        val row = rows[row_index]
        if row.stable_name == "" or row.reason == "":
            return false
        var prior = 0
        while prior < row_index:
            if rows[prior].stable_name == row.stable_name: return false
            prior = prior + 1
        if row.disposition == McdcSemanticDecisionDispositionV1.BackendInapplicable:
            if not row.governed_code.starts_with("MCDC-BACKEND-INAPPLICABLE-"):
                return false
        elif row.governed_code != "":
            return false
        row_index = row_index + 1
    true

export McdcSemanticDecisionFormV1, McdcSemanticDecisionDispositionV1
export McdcSemanticDecisionDescriptorV1
export mcdc_semantic_decision_census_v1, mcdc_semantic_decision_census_v1_well_formed
