# Invocation-private capture bookkeeping; never a consumer authority object.
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_instruction_support.{BlockId}
use compiler.mir.mir_enum_semantic_types.{MirEnumMatchSemanticV1}

struct MirEnumPendingMatchV1:
    function_symbol: SymbolId
    semantic: MirEnumMatchSemanticV1
    next_site: i64
    completed: bool
    next_terminator: i64 = 0
    current_pattern: i64 = -1
    pattern_entry: BlockId = BlockId(id: -1)
    pattern_entry_index: i64 = 0
