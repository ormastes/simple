pub class MirLoopTextExportPermitV1:
    reader: MirLoopReadViewV1
    identity: i64
    consumed: bool

    pub me copy_text() -> Result<text, MirLoopShapeErrorV1>:
        if self.consumed: return Err(MirLoopShapeErrorV1.InvalidState)
        self.consumed = true
        self.reader.ready()?
        if self.reader.phase != 1: return Err(MirLoopShapeErrorV1.InvalidState)
        return Ok(self.reader.owner.texts[self.identity].value)

export MirLoopTextExportPermitV1, MirLoopReadViewV1, MirLoopShapeOwnerV1, MirLoopNodeWriterV1, MirLoopTextPermitV1, MirLoopSealedViewV1, MirLoopConstructionViewV1
