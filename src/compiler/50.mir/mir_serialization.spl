# MIR Serialization - Compatibility Wrapper
#
# Provide the historical mir_serialization API by delegating to
# the bootstrap-safe implementations in mir_json.

use compiler.mir.mir_data.*
export use compiler.mir.mir_json.{
    serialize_mir_function, serialize_mir_type,
    serialize_mir_exception_cleanup_contracts
}
use compiler.mir.mir_json.{serialize_mir_inst_kind, serialize_mir_terminator, serialize_operand}
use compiler.mir.mir_json.{serialize_const_value, serialize_binop, serialize_unaryop}
use compiler.mir.mir_json.{escape_json_string}
use compiler.common.structural_contracts.aop.{
    COMPILER_AOP_CONTRACT_VERSION,
    FacetAccess, FacetBindingPlan, FacetMultiplicity, FacetRepresentation,
    PreparedAdviceSlotPlan,
    TypePredicateInstruction
}
use std.common.crypto.types.{text_to_bytes}

fn mir_facet_metadata_text_lt(a: text, b: text) -> bool:
    # Native text `<` historically compared addresses.  Metadata ordering is
    # byte-lexicographic so interpreter/native artifacts remain identical.
    val a_bytes = text_to_bytes(a)
    val b_bytes = text_to_bytes(b)
    var index = 0
    while index < a_bytes.len() and index < b_bytes.len():
        if a_bytes[index] != b_bytes[index]:
            return a_bytes[index] < b_bytes[index]
        index = index + 1
    a_bytes.len() < b_bytes.len()

fn serialize_facet_predicate_instruction(instruction: TypePredicateInstruction) -> text:
    match instruction:
        case MatchType(value):
            "{\"op\":\"type\",\"value\":\"{escape_json_string(value)}\"}"
        case MatchImplements(value):
            "{\"op\":\"implements\",\"value\":\"{escape_json_string(value)}\"}"
        case MatchSubtype(value):
            "{\"op\":\"subtype\",\"value\":\"{escape_json_string(value)}\"}"
        case Not: "{\"op\":\"not\"}"
        case And: "{\"op\":\"and\"}"
        case Or: "{\"op\":\"or\"}"

fn serialize_facet_binding_plan(plan: FacetBindingPlan) -> text:
    var predicate_parts: [text] = []
    for instruction in plan.target_predicate.instructions:
        predicate_parts = predicate_parts.push(
            serialize_facet_predicate_instruction(instruction))
    val representation = match plan.representation:
        case Attached: "attached"
        case NominalStatic: "nominal_static"
    val multiplicity = match plan.multiplicity:
        case Single: "single"
        case Multi: "multi"
    val access = match plan.access:
        case PublicReadonly: "public_readonly"
    val required = if plan.required: "true" else: "false"
    val predicate_json = predicate_parts.join(",")
    ("{\"access\":\"{access}\",\"aspectId\":\"{escape_json_string(plan.aspect_id)}\"," +
        "\"facetInterfaceId\":\"{escape_json_string(plan.facet_interface_id)}\"," +
        "\"implementationId\":\"{escape_json_string(plan.implementation_id)}\"," +
        "\"multiplicity\":\"{multiplicity}\",\"predicate\":{\"contractVersion\":" +
        "{plan.target_predicate.contract_version},\"instructions\":[{predicate_json}]}," +
        "\"representation\":\"{representation}\",\"required\":{required}}")

fn serialize_mir_facet_binding_plans(plans: [FacetBindingPlan]) -> text:
    """Serialize facet plans in a stable order independent of map/pass order."""
    var rows: [text] = []
    for plan in plans:
        rows = rows.push(serialize_facet_binding_plan(plan))
    var i = 0
    while i < rows.len():
        var j = i + 1
        while j < rows.len():
            if mir_facet_metadata_text_lt(rows[j], rows[i]):
                val tmp = rows[i]
                rows[i] = rows[j]
                rows[j] = tmp
            j = j + 1
        i = i + 1
    val rows_json = rows.join(",")
    ("{\"contractVersion\":{COMPILER_AOP_CONTRACT_VERSION}," +
        "\"plans\":[{rows_json}]}")

fn serialize_prepared_advice_slot(plan: PreparedAdviceSlotPlan) -> text:
    var forms: [text] = []
    for form in plan.admitted_forms:
        forms.push(form)
    var i = 0
    while i < forms.len():
        var j = i + 1
        while j < forms.len():
            if mir_facet_metadata_text_lt(forms[j], forms[i]):
                val tmp = forms[i]
                forms[i] = forms[j]
                forms[j] = tmp
            j = j + 1
        i = i + 1
    var quoted_forms: [text] = []
    for form in forms:
        quoted_forms.push("\"{escape_json_string(form)}\"")
    val forms_json = quoted_forms.join(",")
    ("{\"admittedForms\":[{forms_json}]," +
        "\"schemaId\":\"{escape_json_string(plan.schema_id)}\"," +
        "\"schemaVersion\":{plan.schema_version}," +
        "\"slotId\":\"{escape_json_string(plan.slot_id)}\"," +
        "\"targetFunctionId\":\"{escape_json_string(plan.target_function_id)}\"}")

fn serialize_mir_prepared_advice_slots(plans: [PreparedAdviceSlotPlan]) -> text:
    """Serialize prepared slots deterministically without producing dispatch code."""
    var rows: [text] = []
    for plan in plans:
        rows.push(serialize_prepared_advice_slot(plan))
    var i = 0
    while i < rows.len():
        var j = i + 1
        while j < rows.len():
            if mir_facet_metadata_text_lt(rows[j], rows[i]):
                val tmp = rows[i]
                rows[i] = rows[j]
                rows[j] = tmp
            j = j + 1
        i = i + 1
    val rows_json = rows.join(",")
    "{\"plans\":[{rows_json}]}"


fn serialize_mir_module(module: MirModule) -> text:
    """Serialize MIR functions and deterministic compile-time metadata to JSON."""
    var parts: [text] = []
    parts = parts.push("{\"name\":\"")
    parts = parts.push(escape_json_string(module.name))
    parts = parts.push("\",\"functions\":[")

    var first_fn = true
    for func in module.functions.values():
        if not first_fn:
            parts = parts.push(",")
        parts = parts.push(serialize_mir_function(func))
        first_fn = false

    parts = parts.push("],\"facetBindings\":")
    parts = parts.push(serialize_mir_facet_binding_plans(module.facet_binding_plans))
    parts = parts.push(",\"preparedAdviceSlots\":")
    parts = parts.push(serialize_mir_prepared_advice_slots(module.prepared_advice_slots))
    parts = parts.push("}")
    parts.join("")


fn serialize_mir_inst(inst: MirInst) -> text:
    """Serialize instruction wrapper with kind payload."""
    "{\"kind\":{serialize_mir_inst_kind(inst.kind)}}"

export serialize_mir_module, serialize_mir_inst, serialize_mir_facet_binding_plans
export serialize_mir_prepared_advice_slots
