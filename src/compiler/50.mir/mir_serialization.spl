# MIR Serialization - Compatibility Wrapper
#
# Provide the historical mir_serialization API by delegating to
# the bootstrap-safe implementations in mir_json.

use compiler.mir.mir_data.*
export use compiler.mir.mir_json.{serialize_mir_function, serialize_mir_type}
use compiler.mir.mir_json.{serialize_mir_inst_kind, serialize_mir_terminator, serialize_operand}
use compiler.mir.mir_json.{serialize_const_value, serialize_binop, serialize_unaryop}
use compiler.mir.mir_json.{escape_json_string}


fn serialize_mir_module(module: MirModule) -> text:
    """Serialize MIR module to JSON (functions-only compatibility shape)."""
    var parts: [text] = []
    parts = parts.push("{\"name\":\"")
    parts = parts.push(escape_json_string(module.name))
    parts = parts.push("\",\"functions\":[")

    var first_fn = true
    for symbol in module.functions.keys():
        if not first_fn:
            parts = parts.push(",")
        val func = module.functions[symbol]
        parts = parts.push(serialize_mir_function(func))
        first_fn = false

    parts = parts.push("]}")
    parts.join("")


fn serialize_mir_inst(inst: MirInst) -> text:
    """Serialize instruction wrapper with kind payload."""
    "{\"kind\":{serialize_mir_inst_kind(inst.kind)}}"

export serialize_mir_module, serialize_mir_inst

# Canonical declaration codec/hash/visitor/validator surface.
export use compiler.mir.mir_declaration_support.{
    serialize_mir_declaration_type, serialize_mir_declaration_signature,
    serialize_mir_declaration_attribute, serialize_mir_declaration_field,
    serialize_mir_extern_decl, serialize_mir_actor_decl, serialize_mir_bitfield_decl,
    serialize_mir_enum_extension_constructor, serialize_mir_enum_extension_decl,
    serialize_mir_declaration_metadata_row, serialize_mir_static_decl,
    serialize_mir_field_def, serialize_mir_variant_def, serialize_mir_type_def,
    serialize_mir_module_declarations, mir_declaration_structural_hash,
    visit_mir_declaration_scalars, validate_mir_declarations
}
