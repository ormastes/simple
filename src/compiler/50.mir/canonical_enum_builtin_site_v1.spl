# Compiler-owned primitive origins. A textual rt_enum_* call never creates one.
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirType, LocalId}
use compiler.mir.mir_instruction_support.{BlockId, MirOperand, MirOperandKind, MirTerminator}

pub enum CanonicalEnumBuiltinOperationV1:
    New
    CheckVariant
    Payload
    Discriminant
    Panic

pub struct CanonicalEnumBuiltinSiteV1:
    owner: SymbolId
    block: BlockId
    instruction_index: i64
    operation: CanonicalEnumBuiltinOperationV1
    abi: i64
    enum_runtime_id: i64
    discriminant: i64
    callee: MirOperand
    operands: [MirOperand]
    operand_types: [MirType]
    result: LocalId?
    result_type: MirType

pub struct CanonicalEnumBuiltinCfgUseV1:
    site_index: i64
    block: BlockId
    terminator: MirTerminator

pub struct CanonicalEnumBuiltinManifestV1:
    sites: [CanonicalEnumBuiltinSiteV1]
    cfg_uses: [CanonicalEnumBuiltinCfgUseV1]
    function_digest: text
    module_digest: text
    digest: text
