                self.block("rt_hal_request_text_event_length",[MirInst(kind:MirInstKind.Call(Some(length),rt_hal_exit_typed_text_length_fn(),[value]),span:nil),MirInst(kind:MirInstKind.BinOp(nonnegative,MirBinOp.Ge,mir_operand_copy(length),mir_operand_const_int(0)),span:nil)],MirTerminator.If(mir_operand_copy(nonnegative),cap,reject))
