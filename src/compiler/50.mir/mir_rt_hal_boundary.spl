# codex-impl
# RT/HAL V2 exit capture is typed MIR metadata. The lowering never calls a
# scalar receipt helper: a backend receives the original operand and exact
# descriptor, then either encodes it into a bounded preallocated envelope or
# fails closed. Pure-only @rt(hal) returns unchanged.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind, MirSignature}

# Compiler-only, bounded provenance ledger.  A marker contains only a slot;
# the authority tuple itself is recorded here at the resolved HIR->MIR choke
# point and checked by the boundary transform.  This avoids re-deriving a
# canonical executor from a text path after resolution.  The ledger is reset
# for each authored function and consumed before normal MIR leaves lowering.
struct RtHalEnvExecutorProvenanceRecord:
    executor_kind: i64
    executor_symbol: i64
    expected_callee: MirOperand
    plan: MirOperand

var rt_hal_env_executor_provenance_records: [RtHalEnvExecutorProvenanceRecord] = []
var rt_hal_env_executor_provenance_sealed = false

pub fn rt_hal_env_executor_provenance_reset() -> ():
    rt_hal_env_executor_provenance_records = []
    rt_hal_env_executor_provenance_sealed = false

pub fn rt_hal_env_executor_provenance_register(executor_kind: i64,
        executor_symbol: i64, expected_callee: MirOperand, plan: MirOperand) -> i64:
    if rt_hal_env_executor_provenance_sealed or executor_kind < 1 or
       executor_kind > 3 or executor_symbol < 0:
        return -1
    if rt_hal_env_executor_provenance_records.len() >= 64:
        # One function that needs more than 64 direct physical-plan actions is
        # not representable by the bounded V3 effect transcript.  Emit no
        # marker; semantic admission/normal backend handling stays fail-closed.
        return -1
    val id = rt_hal_env_executor_provenance_records.len()
    rt_hal_env_executor_provenance_records.push(RtHalEnvExecutorProvenanceRecord(
        executor_kind: executor_kind, executor_symbol: executor_symbol,
        expected_callee: expected_callee, plan: plan))
    id

fn rt_hal_exit_local_type(function: MirFunction, local: LocalId) -> MirType?:
    for candidate in function.locals:
        if candidate.id.id == local.id: return Some(candidate.type_)
    nil

fn rt_hal_exit_operand_type(function: MirFunction, value: MirOperand?) -> MirType?:
    match value:
        Some(operand):
            match operand.kind:
                case MirOperandKind.Const(_, type_): Some(type_)
                case MirOperandKind.Copy(local) | MirOperandKind.Move(local):
                    rt_hal_exit_local_type(function, local)
        nil: Some(MirType.unit())

# Canonical V2 descriptor grammar shared with the exact type parser.  Only
# canonical scalar, array, tuple, and Result forms are admitted here:
# `v2;i64`, `v2;array;<n>;<len>:<child>`,
# `v2;tuple;<n>;<len>:<child>...`, and
# `v2;result;<len>:<ok><len>:<err>`.  Empty is the documented fail-closed
# marker for representations without a V2 codec.  In particular it is never
# a pseudo ABI spelling for a pointer, struct, enum, or opaque host object.
fn rt_hal_exit_type_descriptor_v2(type_: MirType) -> text:
    match type_.kind:
        case I8: "v2;i8"
        case I16: "v2;i16"
        case I32: "v2;i32"
        case I64: "v2;i64"
        case U8: "v2;u8"
        case U16: "v2;u16"
        case U32: "v2;u32"
        case U64: "v2;u64"
        case F32: "v2;f32"
        case F64: "v2;f64"
        case Bool: "v2;bool"
        case Char: "v2;char"
        case Unit: "v2;unit"
        case Array(element, size):
            if size < 0: ""
            else:
                val child = rt_hal_exit_type_descriptor_v2(element)
                if child == "": "" else: "v2;array;" + size.to_text() + ";" + rt_hal_exit_descriptor_field(child)
        case Tuple(elements): rt_hal_exit_tuple_descriptor_v2(elements)
        case Result(ok, err):
            val ok_descriptor = rt_hal_exit_type_descriptor_v2(ok)
            val err_descriptor = rt_hal_exit_type_descriptor_v2(err)
            if ok_descriptor == "" or err_descriptor == "": ""
            else: "v2;result;" + rt_hal_exit_descriptor_field(ok_descriptor) + rt_hal_exit_descriptor_field(err_descriptor)
        case Opaque(name):
            if name == "text":
                "v2;text:utf8"
            else:
                ""
        # No guessed ABI representations. These must fail closed until their
        # canonical codec is added, including pointer/reference/dynamic host
        # handles and nominal forms whose field layout is not in this MIR node.
        case Vec4f | Vec8f | Vec4d | Vec4i | Vec8i | Ptr(_, _) | Ref(_, _) |
             FuncPtr(_) | Dict(_, _) | Slice(_) | Struct(_) | Enum(_) | Bits(_, _) |
             Union(_) | Never | ScalableVec(_, _) | Promise(_) |
             Generator(_, _) | ActorType(_): ""

fn rt_hal_exit_descriptor_field(value: text) -> text:
    value.len().to_text() + ":" + value

# The pre-registration key is deterministic over the exact descriptor.  It is
# an identity key, never a payload word; the backend/runtime validates the
# descriptor before admitting the matching bounded codec table entry.
# Stable schema key, never a dense type-table index. The cold runtime plan
# registers every descriptor then binds this key to its per-domain dense IDs.
fn rt_hal_exit_schema_id_v2(descriptor: text) -> i64:
    if descriptor == "": return -1
    var hash = 17
    for byte in descriptor.bytes():
        hash = (hash * 131 + byte.to_i64()) % 2147483647
    hash + 1

fn rt_hal_exit_identity_lane_v2(descriptor: text, salt: i64) -> i64:
    var hash = 31 + salt
    for byte in descriptor.bytes():
        hash = (hash * 257 + byte.to_i64() + salt) % 2147483647
    hash + 1

fn rt_hal_exit_encoding_code_v2(descriptor: text) -> i64:
    if descriptor == "v2;unit": return 0
    if descriptor == "v2;bytes": return 1
    if descriptor == "v2;text:utf8":
        return 2
    if descriptor.contains(";f32") or descriptor.contains(";f64"): return 5
    if descriptor.contains(";i"): return 3
    if descriptor.contains(";u") or descriptor == "v2;bool" or descriptor == "v2;char": return 4
    6

fn rt_hal_exit_codec_plan_v2(type_: MirType, descriptor: text) -> RtHalExitCodecPlan:
    if descriptor == "": return RtHalExitCodecPlan.Reject
    match type_.kind:
        case I8 | I16 | I32 | I64: RtHalExitCodecPlan.Scalar(3)
        case U8 | U16 | U32 | U64 | Bool | Char: RtHalExitCodecPlan.Scalar(4)
        case F32 | F64: RtHalExitCodecPlan.Scalar(5)
        case Unit: RtHalExitCodecPlan.Scalar(0)
        case Array(element, size):
            RtHalExitCodecPlan.ArrayIterate(size, rt_hal_exit_type_descriptor_v2(element))
        case Tuple(elements):
            if elements.len() == 0: RtHalExitCodecPlan.Scalar(0)
            else: RtHalExitCodecPlan.TupleProject(0, rt_hal_exit_type_descriptor_v2(elements[0]))
        case Result(ok, err):
            RtHalExitCodecPlan.ResultBranch(rt_hal_exit_type_descriptor_v2(ok), rt_hal_exit_type_descriptor_v2(err))
        case _: RtHalExitCodecPlan.Reject

fn rt_hal_exit_codec_ops_v2(type_: MirType, descriptor: text) -> [RtHalExitCodecPlan]:
    val root = rt_hal_exit_codec_plan_v2(type_, descriptor)
    match type_.kind:
        case Tuple(elements):
            var ops: [RtHalExitCodecPlan] = []
            var index = 0
            for element in elements:
                ops.push(RtHalExitCodecPlan.TupleProject(index, rt_hal_exit_type_descriptor_v2(element)))
                index = index + 1
            ops
        case Result(ok, err): [RtHalExitCodecPlan.ResultDiscriminator,
            RtHalExitCodecPlan.ResultBranch(rt_hal_exit_type_descriptor_v2(ok), rt_hal_exit_type_descriptor_v2(err))]
        case _: [root]

fn rt_hal_exit_tuple_descriptor_v2(elements: [MirType]) -> text:
    var result = "v2;tuple;" + elements.len().to_text() + ";"
    for element in elements:
        val child = rt_hal_exit_type_descriptor_v2(element)
        if child == "": return ""
        result = result + rt_hal_exit_descriptor_field(child)
    result

fn rt_hal_exit_capture(operation_id: text, compare_c: bool, compare_rust: bool,
        exit_kind: i64, value: MirOperand?, value_type: MirType) -> MirInst:
    val descriptor = rt_hal_exit_type_descriptor_v2(value_type)
    val schema_id = rt_hal_exit_schema_id_v2(descriptor)
    # Dense role IDs are resolved by the cold schema-register instruction
    # before backend_begin(case,schema,kind). -1 means "resolve by schema";
    # it is never a guessed hash index or a valid dense type ID.
    MirInst(kind: MirInstKind.RtHalExitCapture(operation_id, compare_c,
        compare_rust, exit_kind, value, value_type, descriptor, schema_id,
        -1, -1, -1, rt_hal_exit_codec_plan_v2(value_type, descriptor),
        rt_hal_exit_codec_ops_v2(value_type, descriptor)), span: nil)

fn rt_hal_abort_operand(message: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(message),
        MirType(kind: MirTypeKind.Opaque("text"))))

fn rt_hal_abort_capture(operation_id: text, compare_c: bool, compare_rust: bool,
        message: text) -> MirInst:
    # This is the only nominal terminal exception: Abort's MIR payload is a
    # source message, so it uses the explicit bounded UTF-8 error domain,
    # not generic Opaque serialization.
    val descriptor = "v2;text:utf8"
    val schema_id = rt_hal_exit_schema_id_v2(descriptor)
    val payload = rt_hal_abort_operand(message)
    MirInst(kind: MirInstKind.RtHalExitCapture(operation_id, compare_c,
        compare_rust, 5, Some(payload), MirType(kind: MirTypeKind.Opaque("text")),
        descriptor, schema_id, -1, -1, -1,
        RtHalExitCodecPlan.Utf8Text(4096), [RtHalExitCodecPlan.Utf8Text(4096)]), span: nil)

fn rt_hal_exit_token_local(function: MirFunction) -> LocalId:
    var next = 0
    for local in function.locals:
        if local.id.id >= next: next = local.id.id + 1
    LocalId(id: next)

fn rt_hal_exit_runtime_fn(name: text, params: [MirType], return_type: MirType) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: params,
            return_type: return_type, is_variadic: false)))))

fn rt_hal_exit_schema_resolve_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_schema_resolve",
        [MirType.i64(), MirType.i64()], MirType.i64())

# Composite lowering consumes these typed-call constructors.  They use only
# ordinary MIR Call nodes, preserving local/SSA ownership and allowing the
# normal compiler bridge to lower the language-level Result/array operations.
# No caller may replace them with rt_enum_* calls or layout/ordinal constants.
pub fn rt_hal_exit_typed_result_is_ok_fn(ok: MirType, err: MirType) -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_result_is_ok",
        [MirType(kind: MirTypeKind.Result(ok, err))], MirType.bool())

pub fn rt_hal_exit_typed_result_ok_payload_fn(ok: MirType, err: MirType) -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_result_ok_payload",
        [MirType(kind: MirTypeKind.Result(ok, err))], ok)

pub fn rt_hal_exit_typed_result_err_payload_fn(ok: MirType, err: MirType) -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_result_err_payload",
        [MirType(kind: MirTypeKind.Result(ok, err))], err)

pub fn rt_hal_exit_typed_array_length_fn(element: MirType, size: i64) -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_array_length",
        [MirType(kind: MirTypeKind.Array(element, size))], MirType.i64())

pub fn rt_hal_exit_typed_array_at_fn(element: MirType, size: i64) -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_array_at",
        [MirType(kind: MirTypeKind.Array(element, size)), MirType.i64()], element)

pub fn rt_hal_exit_typed_text_length_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_typed_text_length",
        [MirType(kind: MirTypeKind.Opaque("text"))], MirType.i64())

# Transcript events are written before the projected payload.  The composite
# CFG transform must emit begin -> zero or more append -> end in each selected
# Result arm / bounded array body, then emit the child payload writer.
pub fn rt_hal_exit_events_begin_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_events_begin",
        [MirType.i64(), MirType.i64()], MirType.bool())

pub fn rt_hal_exit_events_append_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_write_event",
        [MirType.i64(), MirType.i64(), MirType.i64()], MirType.bool())

pub fn rt_hal_exit_events_end_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_events_end",
        [MirType.i64()], MirType.bool())

pub fn rt_hal_exit_codec_scalar_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_write_codec_scalar",
        [MirType.i64(), MirType.i64(), MirType(kind: MirTypeKind.Opaque("text")),
         MirType.i64(), MirType.i64(), MirType.i64()], MirType.bool())

pub fn rt_hal_exit_codec_utf8_fn() -> MirOperand:
    rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_write_codec_utf8",
        [MirType.i64(), MirType.i64(), MirType(kind: MirTypeKind.Opaque("text")),
         MirType.i64(), MirType.i64(), MirType(kind: MirTypeKind.Opaque("text"))], MirType.bool())

fn rt_hal_exit_descriptor_operand(descriptor: text) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(descriptor),
        MirType(kind: MirTypeKind.Opaque("text"))))

fn rt_hal_exit_scalar_call(token: LocalId, role: i64, leaf_descriptor: text,
        payload: MirOperand, encoding: i64, width: i64, transform: i64,
        bits_local: LocalId, wide_local: LocalId,
        scalar: MirOperand) -> [MirInst]:
    var writes: [MirInst] = []
    var value = payload
    # `width` is canonical byte width (1/2/4/8), never a source bit count.
    # 1 = numeric cast to i64, 2 = f32 bits then zero/sign-independent i64,
    # 3 = f64 bitcast to i64. These preserve the canonical writer ABI without
    # passing a narrower value as an i64 argument.
    if transform == 1:
        writes.push(MirInst(kind: MirInstKind.Cast(wide_local, payload, MirType.i64()), span: nil))
        value = mir_operand_copy(wide_local)
    elif transform == 2:
        writes.push(MirInst(kind: MirInstKind.Bitcast(bits_local, payload, MirType(kind: MirTypeKind.I32)), span: nil))
        writes.push(MirInst(kind: MirInstKind.Cast(wide_local, mir_operand_copy(bits_local), MirType.i64()), span: nil))
        value = mir_operand_copy(wide_local)
    elif transform == 3:
        writes.push(MirInst(kind: MirInstKind.Bitcast(wide_local, payload, MirType.i64()), span: nil))
        value = mir_operand_copy(wide_local)
    writes.push(MirInst(kind: MirInstKind.Call(nil, scalar, [mir_operand_copy(token),
        mir_operand_const_int(role), rt_hal_exit_descriptor_operand(leaf_descriptor),
        mir_operand_const_int(encoding), mir_operand_const_int(width), value]), span: nil))
    writes

fn rt_hal_exit_direct_scalar_call(token: LocalId, payload: MirOperand, encoding: i64,
        width: i64, transform: i64, bits_local: LocalId, wide_local: LocalId,
        scalar: MirOperand) -> [MirInst]:
    var writes: [MirInst] = []
    var value = payload
    if transform == 1:
        writes.push(MirInst(kind: MirInstKind.Cast(wide_local, payload, MirType.i64()), span: nil)); value = mir_operand_copy(wide_local)
    elif transform == 2:
        writes.push(MirInst(kind: MirInstKind.Bitcast(bits_local, payload, MirType(kind: MirTypeKind.I32)), span: nil))
        writes.push(MirInst(kind: MirInstKind.Cast(wide_local, mir_operand_copy(bits_local), MirType.i64()), span: nil)); value = mir_operand_copy(wide_local)
    elif transform == 3:
        writes.push(MirInst(kind: MirInstKind.Bitcast(wide_local, payload, MirType.i64()), span: nil)); value = mir_operand_copy(wide_local)
    writes.push(MirInst(kind: MirInstKind.Call(nil, scalar, [mir_operand_copy(token), value,
        mir_operand_const_int(encoding), mir_operand_const_int(width)]), span: nil))
    writes

fn rt_hal_exit_is_composite(type_: MirType) -> bool:
    match type_.kind:
        case Array(_, _) | Tuple(_) | Result(_, _): true
        case _: false

# Every arena-owner operation is fallible.  The expansion must not leave a
# Bool return in a discarded Call: that converts a rejected transcript into a
# normal producer terminal and silently bypasses the C/Rust comparison.
#
# This pass is deliberately applied after scalar and composite CFG expansion,
# so one implementation covers begin/schema/event/write/end/finish in every
# generated route.  A failure rolls back the active arena when a token exists
# and then uses MIR Abort (a backend hard trap), while the success edge keeps
# the producer's original terminal unchanged.
fn rt_hal_exit_checked_bool_helper(name: text) -> bool:
    name == "rt_hal_exact_exit_backend_events_begin" or
    name == "rt_hal_exact_exit_backend_events_end" or
    name == "rt_hal_exact_exit_backend_write_event" or
    name == "rt_hal_exact_exit_backend_write_codec_scalar" or
    name == "rt_hal_exact_exit_backend_write_codec_utf8" or
    name == "rt_hal_exact_exit_backend_write_scalar" or
    name == "rt_hal_exact_exit_backend_write_utf8" or
    name == "rt_hal_exact_exit_backend_finish" or
    name == "rt_hal_exact_exit_schema_bind_descriptors" or
    name == "rt_hal_exact_exit_schema_policy_register" or
    name == "rt_hal_exact_exit_operation_effect_policy_register" or
    name == "rt_hal_exact_exit_type_seal" or
    name == "rt_hal_exact_exit_controller_seal" or
    name == "rt_hal_exact_request_events_begin" or
    name == "rt_hal_exact_request_write_event" or
    name == "rt_hal_exact_request_events_end" or
    name == "rt_hal_exact_request_payload_begin" or
    name == "rt_hal_exact_request_write_scalar" or
    name == "rt_hal_exact_request_write_utf8" or
    name == "rt_hal_exact_request_payload_end" or
    name == "rt_hal_exact_request_finish" or
    name == "rt_hal_exact_request_effect_begin" or
    name == "rt_hal_exact_request_effect_write_event" or
    name == "rt_hal_exact_request_effect_events_end" or
    name == "rt_hal_exact_request_effect_write_byte" or
    name == "rt_hal_exact_request_effect_finish" or
    name == "rt_hal_exact_request_effect_capture_env_plan" or
    name == "rt_hal_exact_request_effect_reject_dynamic"

fn rt_hal_exit_checked_i64_helper(name: text) -> bool:
    # Arena tokens and dense schema IDs are positive.  Zero is not a usable
    # token/type identity either, so admit strictly greater than zero.
    name == "rt_hal_exact_exit_backend_begin_next" or
    name == "rt_hal_exact_exit_backend_begin_next_with_request" or
    name == "rt_hal_exact_request_begin" or
    name == "rt_hal_exact_exit_schema_resolve"

fn rt_hal_exit_checked_helper_self_reclaims(name: text) -> bool:
    # These writers call `rt_hal_exact_exit_abort` before every false return.
    # The checked failure CFG must trap, but must not abort the same active
    # record a second time (a later token could otherwise be misinterpreted).
    name == "rt_hal_exact_exit_backend_events_begin" or
    name == "rt_hal_exact_exit_backend_events_end" or
    name == "rt_hal_exact_exit_backend_write_codec_scalar" or
    name == "rt_hal_exact_exit_backend_write_codec_utf8" or
    name == "rt_hal_exact_exit_backend_write_scalar" or
    name == "rt_hal_exact_exit_backend_write_utf8"

# The direct-call choke point has already resolved and sealed this marker from
# a SymbolId plus defining-module identity.  Boundary capture intentionally
# cannot recover that authority from the MIR call spelling: imports and a
# same-name user function may serialize to the same text.  The marker must be
# marker -> Call adjacency is mandatory; malformed/orphaned markers survive
# this pass and generic backends reject them fail-closed.
fn rt_hal_env_access_same_direct_operand(left: MirOperand, right: MirOperand) -> bool:
    # This is not authority discovery: authority came from the sealed SymbolId
    # at lowering. It only proves that no MIR transform separated the marker
    # from the exact direct-call operand it was minted beside.
    match left.kind:
        case MirOperandKind.Const(MirConstValue.Str(left_name), _):
            match right.kind:
                case MirOperandKind.Const(MirConstValue.Str(right_name), _):
                    left_name == right_name
                case _: false
        case MirOperandKind.Copy(left_local):
            match right.kind:
                case MirOperandKind.Copy(right_local): left_local.id == right_local.id
                case _: false
        case MirOperandKind.Move(left_local):
            match right.kind:
                case MirOperandKind.Move(right_local): left_local.id == right_local.id
                case _: false

fn rt_hal_env_access_same_plan_operand(left: MirOperand, right: MirOperand) -> bool:
    # Plans are scoped locals at this boundary. Constants/pointers are not an
    # admissible substitute; rejecting them prevents a forged marker from
    # observing a different host plan than its paired direct call.
    match left.kind:
        case MirOperandKind.Copy(left_local) | MirOperandKind.Move(left_local):
            match right.kind:
                case MirOperandKind.Copy(right_local) | MirOperandKind.Move(right_local):
                    left_local.id == right_local.id
                case _: false
        case _: false

fn rt_hal_env_access_provenance_record_matches(provenance_id: i64,
        executor_kind: i64, executor_symbol: i64, expected_callee: MirOperand,
        plan: MirOperand, call_callee: MirOperand, call_plan: MirOperand) -> bool:
    if provenance_id < 0 or provenance_id >= rt_hal_env_executor_provenance_records.len():
        return false
    val record = rt_hal_env_executor_provenance_records[provenance_id]
    # The opaque record, populated only from resolved HIR lowering, binds the
    # marker's scalar identity to its kind and both original operands. This is
    # the authority check; the operand comparison below only proves adjacency.
    record.executor_kind == executor_kind and
    record.executor_symbol == executor_symbol and
    rt_hal_env_access_same_direct_operand(record.expected_callee, expected_callee) and
    rt_hal_env_access_same_plan_operand(record.plan, plan) and
    rt_hal_env_access_same_direct_operand(record.expected_callee, call_callee) and
    rt_hal_env_access_same_plan_operand(record.plan, call_plan)

fn rt_hal_env_access_marked_plan(instructions: [MirInst], index: i64) -> MirOperand?:
    if index < 0 or index + 1 >= instructions.len(): return nil
    match instructions[index].kind:
        case RtHalEnvExecutorProvenance(provenance_id, kind, executor_symbol, expected_callee, plan):
            if kind < 1 or kind > 3 or executor_symbol < 0: return nil
            match instructions[index + 1].kind:
                case Call(_, callee, arguments):
                    # The direct-call emitter derives the marker plan from
                    # argument zero. Recheck the shape here so a future MIR
                    # transform cannot attach a provenance row to a zero-arg
                    # call and obtain an effect capture by accident.
                    if arguments.len() >= 1 and rt_hal_env_access_provenance_record_matches(
                       provenance_id, kind, executor_symbol, expected_callee, plan,
                       callee, arguments[0]): Some(plan)
                    else: nil
                case _: nil
        case _: nil

# Lower a real environment-executor call into one bounded V3 record capture
# immediately before the original parent-owned call.  The original call is
# retained: this transform never moves host authority to C/Rust.  The runtime
# helper validates all 24 closed instruction kinds and their declared bounds,
# writes directly to the preallocated request slot, and seals the plan before
# the parent can observe the effect.  The preceding semantic capability pass
# has already rejected aliases, wrappers, indirect calls and unresolved
# callable identities.  Do not reintroduce a name/prefix heuristic here: a
# non-environment function merely containing `env_access` in its name is not
# an effect authority and must retain normal Pure lowering.
fn inject_rt_hal_env_access_effect_capture(function: MirFunction,
        request_token: LocalId) -> MirFunction:
    val capture = rt_hal_exit_runtime_fn("rt_hal_exact_request_effect_capture_env_plan",
        [MirType.i64(), MirType(kind: MirTypeKind.Opaque("EnvAccessPlan"))], MirType.bool())
    var blocks: [MirBlock] = []
    for original in function.blocks:
        var instructions: [MirInst] = []
        var index = 0
        while index < original.instructions.len():
            val instruction = original.instructions[index]
            if val plan = rt_hal_env_access_marked_plan(original.instructions, index):
                # A source call may consume its plan with Move. The capture is
                # a read-only scoped observation, so materialise a preceding
                # Copy local operand rather than duplicating that move or
                # transferring the plan into the foreign boundary.
                val observed_plan = match plan.kind:
                    case MirOperandKind.Copy(local) | MirOperandKind.Move(local):
                        mir_operand_copy(local)
                    case _: plan
                instructions.push(MirInst(kind: MirInstKind.Call(nil, capture,
                    [mir_operand_copy(request_token), observed_plan]), span: instruction.span))
                # Marker has been consumed. Retain only the original authored
                # call; no provenance instruction reaches normal MIR passes.
                index = index + 1
                instructions.push(original.instructions[index])
            else:
                instructions.push(instruction)
            index = index + 1
        blocks.push(MirBlock(id: original.id, label: original.label,
            instructions: instructions, terminator: original.terminator))
    val captured = MirFunction.with_blocks(function, blocks)
    # No later lowering phase may mint another marker against this function's
    # ledger. Any orphaned/malformed row remains in MIR for backend rejection.
    rt_hal_env_executor_provenance_sealed = true
    captured

# Cold collection uses this after boundary injection and before metadata
# stripping.  Adapter 4 is registered only for operations that actually have
# a recognized parent environment effect. Registering it for every query
# forces effect-capability policy where none was declared and makes otherwise
# valid query-only operation-plan rows fail closed during installation.
pub fn rt_hal_function_has_env_effect_capture(function: MirFunction) -> bool:
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case Call(_, callee, _):
                    match rt_hal_exit_helper_name(callee):
                        case Some("rt_hal_exact_request_effect_capture_env_plan"): return true
                        case _: ()
                case _: ()
    false

fn rt_hal_exit_helper_name(operand: MirOperand) -> text?:
    match operand.kind:
        case Const(MirConstValue.Str(name), _): Some(name)
        case _: nil

fn rt_hal_exit_checked_failure_block(id: BlockId, name: text,
        token: LocalId?, request_token: LocalId?) -> MirBlock:
    var instructions: [MirInst] = []
    # Begin/schema-resolution failures have no usable token.  All later
    # failures reclaim their one active fixed-arena slot before trapping.
    val rollback_token = if name.starts_with("rt_hal_exact_request_"):
        request_token else: token
    if val active_token = rollback_token:
        # Entry requests are a distinct pre-Pure owner.  Rolling one back
        # through the exit writer could reclaim an unrelated terminal slot.
        val abort_name = if name.starts_with("rt_hal_exact_request_"):
            "rt_hal_exact_request_abort" else: "rt_hal_exact_exit_abort"
        instructions.push(MirInst(kind: MirInstKind.Call(nil,
            rt_hal_exit_runtime_fn(abort_name, [MirType.i64()],
                MirType.unit()), [mir_operand_copy(active_token)]), span: nil))
    val diagnostic = if name == "rt_hal_exact_request_effect_reject_dynamic":
        "RTHAL-E-ENV-EFFECT-DYNAMIC-UNREPRESENTABLE" else:
        "E-RTHAL-EXIT-HELPER-FAILURE:" + name
    MirBlock(id: id, label: Some("rt_hal_exit_checked_failure_" + name),
        instructions: instructions,
        terminator: MirTerminator.Abort(diagnostic))

fn rt_hal_exit_check_helper_failures(function: MirFunction,
        active_token: LocalId?, request_token: LocalId?) -> MirFunction:
    var next_local = 0
    for local in function.locals:
        if local.id.id >= next_local: next_local = local.id.id + 1
    var next_block = 0
    for block in function.blocks:
        if block.id.id >= next_block: next_block = block.id.id + 1
    var locals = function.locals
    var output: [MirBlock] = []
    for original in function.blocks:
        var current_id = original.id
        var current_label = original.label
        var current_instructions: [MirInst] = []
        var index = 0
        while index < original.instructions.len():
            val instruction = original.instructions[index]
            var helper: text? = nil
            var is_bool = false
            var is_i64 = false
            match instruction.kind:
                case Call(_, func, _):
                    helper = rt_hal_exit_helper_name(func)
                    if val name = helper:
                        is_bool = rt_hal_exit_checked_bool_helper(name)
                        is_i64 = rt_hal_exit_checked_i64_helper(name)
                case _: ()
            if not is_bool and not is_i64:
                current_instructions.push(instruction)
                index = index + 1
            else:
                val name = helper ?? "unknown"
                val checked_type = if is_bool: MirType.bool() else: MirType.i64()
                var checked = LocalId(id: next_local)
                var preserve_dest = false
                var call_func = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_hal_exit_internal_invalid"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [],
                        return_type: checked_type, is_variadic: false)))))
                var call_args: [MirOperand] = []
                match instruction.kind:
                    case Call(destination, func, args):
                        call_func = func
                        call_args = args
                        # Keep a generated destination as the checked value;
                        # do not replace a live token/type local with a
                        # temporary and pass an uninitialized value onward.
                        if val destination_local = destination:
                            # Preserve any existing result destination. This
                            # makes the pass safe for future generated Bool
                            # calls as well as begin/schema i64 calls.
                            checked = destination_local
                            preserve_dest = true
                    case _: ()
                if not preserve_dest:
                    next_local = next_local + 1
                    locals.push(MirLocal(id: checked,
                        name: Some("rt_hal_exit_checked_" + name), type_: checked_type,
                        kind: LocalKind.Temp, is_ghost: false))
                current_instructions.push(MirInst(kind: MirInstKind.Call(Some(checked),
                    call_func, call_args), span: instruction.span))
                val failure_id = BlockId(id: next_block)
                val success_id = BlockId(id: next_block + 1)
                next_block = next_block + 2
                var condition = mir_operand_copy(checked)
                if is_i64:
                    val nonnegative = LocalId(id: next_local)
                    next_local = next_local + 1
                    locals.push(MirLocal(id: nonnegative,
                        name: Some("rt_hal_exit_checked_nonnegative_" + name),
                        type_: MirType.bool(), kind: LocalKind.Temp, is_ghost: false))
                    current_instructions.push(MirInst(kind: MirInstKind.BinOp(nonnegative,
                        MirBinOp.Gt, mir_operand_copy(checked), mir_operand_const_int(0)),
                        span: instruction.span))
                    condition = mir_operand_copy(nonnegative)
                output.push(MirBlock(id: current_id, label: current_label,
                    instructions: current_instructions,
                    terminator: MirTerminator.If(condition, success_id, failure_id)))
                # Begin/schema-resolution failures have no token.  Most
                # payload writers reclaim internally on false; event append,
                # event end, and finish do not, so their failure edge owns the
                # sole rollback before hard trapping.
                val reclaim_token = if is_i64 or
                    rt_hal_exit_checked_helper_self_reclaims(name): nil
                    else: active_token
                val reclaim_request = if name.starts_with("rt_hal_exact_request_"):
                    request_token else: nil
                output.push(rt_hal_exit_checked_failure_block(failure_id, name,
                    reclaim_token, reclaim_request))
                current_id = success_id
                current_label = Some("rt_hal_exit_checked_success_" + name)
                current_instructions = []
                index = index + 1
        output.push(MirBlock(id: current_id, label: current_label,
            instructions: current_instructions, terminator: original.terminator))
    MirFunction.with_locals_and_blocks(function, locals, output)

# A transcript is a bounded prepass, not an interleaved payload format.  The
# capacity includes the selected value only; callers add RootBegin/RootEnd.
# Arrays in this MIR type are fixed-size, so their maximum transcript is known
# cold and their prepass verifies that the typed length is exactly that size.
fn rt_hal_exit_event_capacity_v2(type_: MirType) -> i64:
    match type_.kind:
        case Array(element, size):
            val child = rt_hal_exit_event_capacity_v2(element)
            if size < 0 or child <= 0 or size > (65536 - 2) / child: -1
            else: 2 + size * child
        case Tuple(elements):
            var total = 2
            for element in elements:
                val child = rt_hal_exit_event_capacity_v2(element)
                if child <= 0 or total > 65536 - child: return -1
                total = total + child
            total
        case Result(ok, err):
            val ok_count = rt_hal_exit_event_capacity_v2(ok)
            val err_count = rt_hal_exit_event_capacity_v2(err)
            if ok_count <= 0 or err_count <= 0: -1
            elif ok_count > err_count: 2 + ok_count
            else: 2 + err_count
        case Opaque(name): if name == "text": 2 else: -1
        case _: 1

fn rt_hal_exit_direct_writer(token: LocalId, bits: LocalId, wide: LocalId,
        payload: MirOperand, type_: MirType) -> [MirInst]:
    val scalar = rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_write_scalar", [MirType.i64(), MirType.i64(), MirType.i64(), MirType.i64()], MirType.bool())
    val utf8 = rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_write_utf8", [MirType.i64(), MirType(kind: MirTypeKind.Opaque("text"))], MirType.bool())
    match type_.kind:
        case I8: rt_hal_exit_direct_scalar_call(token, payload, 3, 1, 1, bits, wide, scalar)
        case I16: rt_hal_exit_direct_scalar_call(token, payload, 3, 2, 1, bits, wide, scalar)
        case I32: rt_hal_exit_direct_scalar_call(token, payload, 3, 4, 1, bits, wide, scalar)
        case I64: rt_hal_exit_direct_scalar_call(token, payload, 3, 8, 0, bits, wide, scalar)
        case U8: rt_hal_exit_direct_scalar_call(token, payload, 4, 1, 1, bits, wide, scalar)
        case U16: rt_hal_exit_direct_scalar_call(token, payload, 4, 2, 1, bits, wide, scalar)
        case U32: rt_hal_exit_direct_scalar_call(token, payload, 4, 4, 1, bits, wide, scalar)
        case U64: rt_hal_exit_direct_scalar_call(token, payload, 4, 8, 0, bits, wide, scalar)
        case F32: rt_hal_exit_direct_scalar_call(token, payload, 5, 4, 2, bits, wide, scalar)
        case F64: rt_hal_exit_direct_scalar_call(token, payload, 5, 8, 3, bits, wide, scalar)
        case Bool: rt_hal_exit_direct_scalar_call(token, payload, 4, 1, 1, bits, wide, scalar)
        case Char: rt_hal_exit_direct_scalar_call(token, payload, 4, 4, 1, bits, wide, scalar)
        case Opaque(name):
            if name == "text": [MirInst(kind: MirInstKind.Call(nil, utf8, [mir_operand_copy(token), payload]), span: nil)] else: []
        case _: []

# Entry request capture deliberately uses ordinary typed MIR operands.  It is
# a separate lowering from terminal capture: the foreign request exists before
# the authored Pure body runs and contains no return/throw/effect receipt.
fn rt_hal_request_tuple_descriptor(params: [MirType]) -> text:
    rt_hal_exit_tuple_descriptor_v2(params)

fn rt_hal_request_arg_local(function: MirFunction, index: i64) -> LocalId?:
    for local in function.locals:
        match local.kind:
            case Arg(position):
                if position == index: return Some(local.id)
            case _: ()
    nil

fn rt_hal_request_leaf_supported(type_: MirType) -> bool:
    match type_.kind:
        case I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 | F32 | F64 |
             Bool | Char | Unit: true
        case Opaque(name): name=="text"
        case _: false

fn rt_hal_request_leaf_event(type_: MirType) -> (i64,i64):
    match type_.kind:
        case Unit: (11,0)
        case Bool: (12,1)
        case I8: (13,1)
        case I16: (14,2)
        case I32: (15,4)
        case I64: (16,8)
        case U8: (17,1)
        case U16: (18,2)
        case U32: (19,4)
        case U64: (20,8)
        case F32: (21,4)
        case F64: (22,8)
        case Char: (27,4)
        case _: (-1,-1)

fn rt_hal_request_write_leaf(token: LocalId, bits: LocalId, wide: LocalId,
        payload: MirOperand, type_: MirType) -> [MirInst]:
    val writer=rt_hal_exit_runtime_fn("rt_hal_exact_request_write_scalar",
        [MirType.i64(),MirType.i64(),MirType.i64()],MirType.bool())
    val utf8=rt_hal_exit_runtime_fn("rt_hal_exact_request_write_utf8",
        [MirType.i64(),MirType(kind:MirTypeKind.Opaque("text"))],MirType.bool())
    var result: [MirInst]=[];var value=payload;var width=0;var transform=0
    match type_.kind:
        case I8:
            width=1
            transform=1
        case I16:
            width=2
            transform=1
        case I32:
            width=4
            transform=1
        case I64: width=8
        case U8:
            width=1
            transform=1
        case U16:
            width=2
            transform=1
        case U32:
            width=4
            transform=1
        case U64: width=8
        case Bool:
            width=1
            transform=1
        case Char:
            width=4
            transform=1
        case F32:
            width=4
            transform=2
        case F64:
            width=8
            transform=3
        case Unit: width=0
        case Opaque(name):
            if name == "text":
                return [MirInst(kind:MirInstKind.Call(nil,utf8,[mir_operand_copy(token),payload]),span:nil)]
            else:
                return []
        case _: return []
    if transform == 1:
        result.push(MirInst(kind:MirInstKind.Cast(wide,payload,MirType.i64()),span:nil))
        value=mir_operand_copy(wide)
    elif transform == 2:
        result.push(MirInst(kind:MirInstKind.Bitcast(bits,payload,MirType(kind:MirTypeKind.I32)),span:nil))
        result.push(MirInst(kind:MirInstKind.Cast(wide,mir_operand_copy(bits),MirType.i64()),span:nil))
        value=mir_operand_copy(wide)
    elif transform == 3:
        result.push(MirInst(kind:MirInstKind.Bitcast(wide,payload,MirType.i64()),span:nil))
        value=mir_operand_copy(wide)
    result.push(MirInst(kind:MirInstKind.Call(nil,writer,[mir_operand_copy(token),value,mir_operand_const_int(width)]),span:nil));result

### Entry request serialization is a typed CFG transform.  It owns neither
### foreign output nor an aggregate ABI view: tuple fields, fixed-array cells,
### Result payloads, and text all cross through ordinary typed MIR operations.
class RtHalRequestCfgBuilder:
    locals: [MirLocal]
    blocks: [MirBlock]
    next_local: i64
    next_block: i64
    token: LocalId
    bits: LocalId
    wide: LocalId

    me local(type_: MirType, name: text) -> LocalId:
        val id=LocalId(id:self.next_local);self.next_local=self.next_local+1
        self.locals=self.locals.push(MirLocal(id:id,name:Some(name),type_:type_,kind:LocalKind.Temp,is_ghost:false));id
    me mutable_local(type_: MirType, name: text) -> LocalId:
        val id=LocalId(id:self.next_local);self.next_local=self.next_local+1
        self.locals=self.locals.push(MirLocal(id:id,name:Some(name),type_:type_,kind:LocalKind.Var,is_ghost:false));id
    me block(label: text, instructions: [MirInst], terminator: MirTerminator) -> BlockId:
        val id=BlockId(id:self.next_block);self.next_block=self.next_block+1
        self.blocks=self.blocks.push(MirBlock(id:id,label:Some(label),instructions:instructions,terminator:terminator));id
    me event(tag: i64, arg: MirOperand) -> MirInst:
        MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_write_event",
            [MirType.i64(),MirType.i64(),MirType.i64()],MirType.bool()),
            [mir_operand_copy(self.token),mir_operand_const_int(tag),arg]),span:nil)
    me reject(label: text) -> BlockId:
        self.block(label,[MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_abort",[MirType.i64()],MirType.unit()),[mir_operand_copy(self.token)]),span:nil)],MirTerminator.Abort("E-RTHAL-REQUEST-TYPE-REJECT"))

    me events_value(value: MirOperand, type_: MirType, next: BlockId) -> BlockId:
        match type_.kind:
            case Tuple(items): self.events_tuple(value,items,next)
            case Array(element,size): self.events_array(value,element,size,next)
            case Result(ok,err): self.events_result(value,ok,err,next)
            case Opaque(name):
                if name != "text": return self.reject("rt_hal_request_event_opaque_reject")
                val length=self.local(MirType.i64(),"rt_hal_request_text_length")
                val nonnegative=self.local(MirType.bool(),"rt_hal_request_text_nonnegative")
                val within=self.local(MirType.bool(),"rt_hal_request_text_within_cap")
                val append=self.block("rt_hal_request_text_event_append",[self.event(25,mir_operand_copy(length)),self.event(26,mir_operand_const_int(0))],MirTerminator.Goto(next))
                val reject=self.reject("rt_hal_request_text_event_reject")
