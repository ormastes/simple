        val entry=self.block("rt_hal_request_array_begin",[MirInst(kind:MirInstKind.Const(state,MirConstValue.Int(0),MirType.i64()),span:nil),MirInst(kind:MirInstKind.Call(Some(length),rt_hal_exit_typed_array_length_fn(element,size),[value]),span:nil),self.event(5,mir_operand_const_int(size))],MirTerminator.Goto(length_check))
        self.blocks=self.blocks.push(MirBlock(id:length_check,label:Some("rt_hal_request_array_length_check"),instructions:[MirInst(kind:MirInstKind.BinOp(exact,MirBinOp.Eq,mir_operand_copy(length),mir_operand_const_int(size)),span:nil)],terminator:MirTerminator.If(mir_operand_copy(exact),cond_id,bad)))
        self.blocks=self.blocks.push(MirBlock(id:cond_id,label:Some("rt_hal_request_array_cond"),instructions:[MirInst(kind:MirInstKind.Copy(current,state),span:nil),MirInst(kind:MirInstKind.BinOp(cond,MirBinOp.Lt,mir_operand_copy(current),mir_operand_const_int(size)),span:nil)],terminator:MirTerminator.If(mir_operand_copy(cond),body_id,close)))
        self.blocks=self.blocks.push(MirBlock(id:body_id,label:Some("rt_hal_request_array_body"),instructions:[MirInst(kind:MirInstKind.Call(Some(item),rt_hal_exit_typed_array_at_fn(element,size),[value,mir_operand_copy(current)]),span:nil)],terminator:MirTerminator.Goto(child)))
