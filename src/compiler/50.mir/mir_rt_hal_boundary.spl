# codex-impl
# Lower typed @rt(hal) metadata to a real runtime dispatch at each normal
# function exit. Static non-HAL functions never call this pass and receive no
# instruction, branch, allocation, or runtime dependency.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind, MirSignature}

fn rt_hal_boundary_receipt(value: MirOperand?) -> MirOperand:
    match value:
        Some(operand):
            match operand.kind:
                case Move(local): MirOperand.copy(local)
                case _: operand
        nil: MirOperand.const_int(-1)

fn rt_hal_boundary_call(operation_id: text, compare_c: bool, compare_rust: bool, receipt: MirOperand) -> MirInst:
    val function = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("rt_hal_boundary_dispatch"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [MirType(kind: MirTypeKind.Opaque("str")), MirType.bool(), MirType.bool(), MirType.i64()],
            return_type: MirType.i64(), is_variadic: false
        )))
    ))
    val operation = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(operation_id), MirType(kind: MirTypeKind.Opaque("str"))
    ))
    MirInst(
        kind: MirInstKind.Call(nil, function, [
            operation, MirOperand.const_bool(compare_c),
            MirOperand.const_bool(compare_rust), receipt
        ]),
        span: nil
    )

pub fn inject_rt_hal_boundary(function: MirFunction, operation_id: text, compare_c: bool, compare_rust: bool) -> MirFunction:
    var blocks: [MirBlock] = []
    for original_block in function.blocks:
        var block = original_block
        match block.terminator:
            case Ret(value):
                var instructions = block.instructions
                instructions.push(rt_hal_boundary_call(
                    operation_id, compare_c, compare_rust,
                    rt_hal_boundary_receipt(value)
                ))
                blocks.push(MirBlock(
                    id: block.id, label: block.label,
                    instructions: instructions, terminator: block.terminator
                ))
            case _:
                blocks.push(block)
    MirFunction.with_blocks(function, blocks)

# Cold program-controller hook. The process owner drains every receipt for the
# current producer and terminates nonzero on overflow/mismatch/timeout.
pub fn inject_rt_hal_controller_finalize(function: MirFunction, plan_path: text) -> MirFunction:
    val finalize = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("rt_hal_process_finalize_current_owner"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false
        )))
    ))
    var blocks: [MirBlock] = []
    var block_index = 0
    for original_block in function.blocks:
        var block = original_block
        if block_index == 0:
            val installer = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_hal_install_isolated_exact_host_from_plan_path_or_fail"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                    params: [MirType(kind: MirTypeKind.Opaque("str"))],
                    return_type: MirType.unit(), is_variadic: false
                )))
            ))
            val plan = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str(plan_path), MirType(kind: MirTypeKind.Opaque("str"))
            ))
            var entry: [MirInst] = [MirInst(
                kind: MirInstKind.Call(nil, installer, [plan]), span: nil
            )]
            for instruction in block.instructions: entry.push(instruction)
            block = MirBlock(id: block.id, label: block.label,
                instructions: entry, terminator: block.terminator)
        match block.terminator:
            case Ret(_):
                var instructions = block.instructions
                instructions.push(MirInst(kind: MirInstKind.Call(nil, finalize, []), span: nil))
                blocks.push(MirBlock(id: block.id, label: block.label,
                    instructions: instructions, terminator: block.terminator))
            case _: blocks.push(block)
        block_index = block_index + 1
    MirFunction.with_blocks(function, blocks)

export inject_rt_hal_boundary, inject_rt_hal_controller_finalize

pub fn inject_rt_hal_worker_complete(function: MirFunction) -> MirFunction:
    val complete = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("rt_hal_boundary_worker_complete_hook"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [], return_type: MirType.unit(), is_variadic: false
        )))
    ))
    var blocks: [MirBlock] = []
    for block in function.blocks:
        match block.terminator:
            case Ret(_):
                var instructions = block.instructions
                instructions.push(MirInst(kind: MirInstKind.Call(nil, complete, []), span: nil))
                blocks.push(MirBlock(id: block.id, label: block.label,
                    instructions: instructions, terminator: block.terminator))
            case _: blocks.push(block)
    MirFunction.with_blocks(function, blocks)

export inject_rt_hal_worker_complete
