    me events_tuple(value: MirOperand, items: [MirType], next: BlockId) -> BlockId:
        var fields: [LocalId]=[];var instructions: [MirInst]=[self.event(3,mir_operand_const_int(items.len()))];var index=0
        for item in items:
            val field=self.local(item,"rt_hal_request_tuple_field");fields.push(field)
            instructions.push(MirInst(kind:MirInstKind.GetField(field,value,index),span:nil));index=index+1
        val close=self.block("rt_hal_request_tuple_end",[self.event(4,mir_operand_const_int(0))],MirTerminator.Goto(next));var cursor=close;var reverse=items.len()-1
        while reverse>=0:
