        val state=self.mutable_local(MirType.i64(),"rt_hal_request_array_index_state");val current=self.local(MirType.i64(),"rt_hal_request_array_index");val following=self.local(MirType.i64(),"rt_hal_request_array_next");val length=self.local(MirType.i64(),"rt_hal_request_array_length");val exact=self.local(MirType.bool(),"rt_hal_request_array_length_exact");val cond=self.local(MirType.bool(),"rt_hal_request_array_cond");val item=self.local(element,"rt_hal_request_array_item")
        val cond_id=BlockId(id:self.next_block);val body_id=BlockId(id:self.next_block+1);val increment_id=BlockId(id:self.next_block+2);val length_check=BlockId(id:self.next_block+3);self.next_block=self.next_block+4
