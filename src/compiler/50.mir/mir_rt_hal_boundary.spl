    me events_result(value: MirOperand, ok: MirType, err: MirType, next: BlockId) -> BlockId:
        val is_ok=self.local(MirType.bool(),"rt_hal_request_result_is_ok");val ok_value=self.local(ok,"rt_hal_request_result_ok");val err_value=self.local(err,"rt_hal_request_result_err");val ok_id=BlockId(id:self.next_block);val err_id=BlockId(id:self.next_block+1);self.next_block=self.next_block+2
        val ok_end=self.block("rt_hal_request_result_ok_end",[self.event(8,mir_operand_const_int(0))],MirTerminator.Goto(next));val err_end=self.block("rt_hal_request_result_err_end",[self.event(10,mir_operand_const_int(0))],MirTerminator.Goto(next));val ok_child=self.events_value(mir_operand_copy(ok_value),ok,ok_end);val err_child=self.events_value(mir_operand_copy(err_value),err,err_end)
        val entry=self.block("rt_hal_request_result_branch",[MirInst(kind:MirInstKind.Call(Some(is_ok),rt_hal_exit_typed_result_is_ok_fn(ok,err),[value]),span:nil)],MirTerminator.If(mir_operand_copy(is_ok),ok_id,err_id))
        self.blocks=self.blocks.push(MirBlock(id:ok_id,label:Some("rt_hal_request_result_ok"),instructions:[self.event(7,mir_operand_const_int(1)),MirInst(kind:MirInstKind.Call(Some(ok_value),rt_hal_exit_typed_result_ok_payload_fn(ok,err),[value]),span:nil)],terminator:MirTerminator.Goto(ok_child)))
        self.blocks=self.blocks.push(MirBlock(id:err_id,label:Some("rt_hal_request_result_err"),instructions:[self.event(9,mir_operand_const_int(1)),MirInst(kind:MirInstKind.Call(Some(err_value),rt_hal_exit_typed_result_err_payload_fn(ok,err),[value]),span:nil)],terminator:MirTerminator.Goto(err_child)));entry

    me payload_value(value: MirOperand, type_: MirType, next: BlockId) -> BlockId:
        match type_.kind:
            case Tuple(items):
                var fields: [LocalId]=[];var instructions: [MirInst]=[];var index=0
                for item in items:
                    val field=self.local(item,"rt_hal_request_payload_tuple_field");fields.push(field);instructions.push(MirInst(kind:MirInstKind.GetField(field,value,index),span:nil));index=index+1
                var cursor=next;var reverse=items.len()-1
                while reverse>=0:cursor=self.payload_value(mir_operand_copy(fields[reverse]),items[reverse],cursor);reverse=reverse-1
                self.block("rt_hal_request_payload_tuple",instructions,MirTerminator.Goto(cursor))
            case Array(element,size): self.payload_array(value,element,size,next)
            case Result(ok,err): self.payload_result(value,ok,err,next)
            case _:
                val writes=rt_hal_request_write_leaf(self.token,self.bits,self.wide,value,type_)
                if writes.len() == 0:
                    self.reject("rt_hal_request_payload_leaf_reject")
                else:
                    self.block("rt_hal_request_payload_leaf",writes,MirTerminator.Goto(next))

    me payload_array(value: MirOperand, element: MirType, size: i64, next: BlockId) -> BlockId:
        if size < 0: return self.reject("rt_hal_request_payload_array_static_reject")
        val state=self.mutable_local(MirType.i64(),"rt_hal_request_payload_array_state");val current=self.local(MirType.i64(),"rt_hal_request_payload_array_index");val following=self.local(MirType.i64(),"rt_hal_request_payload_array_next");val cond=self.local(MirType.bool(),"rt_hal_request_payload_array_cond");val item=self.local(element,"rt_hal_request_payload_array_item");val cond_id=BlockId(id:self.next_block);val body_id=BlockId(id:self.next_block+1);val inc_id=BlockId(id:self.next_block+2);self.next_block=self.next_block+3
        val child=self.payload_value(mir_operand_copy(item),element,inc_id);val entry=self.block("rt_hal_request_payload_array_begin",[MirInst(kind:MirInstKind.Const(state,MirConstValue.Int(0),MirType.i64()),span:nil)],MirTerminator.Goto(cond_id))
        self.blocks=self.blocks.push(MirBlock(id:cond_id,label:Some("rt_hal_request_payload_array_cond"),instructions:[MirInst(kind:MirInstKind.Copy(current,state),span:nil),MirInst(kind:MirInstKind.BinOp(cond,MirBinOp.Lt,mir_operand_copy(current),mir_operand_const_int(size)),span:nil)],terminator:MirTerminator.If(mir_operand_copy(cond),body_id,next)))
        self.blocks=self.blocks.push(MirBlock(id:body_id,label:Some("rt_hal_request_payload_array_body"),instructions:[MirInst(kind:MirInstKind.Call(Some(item),rt_hal_exit_typed_array_at_fn(element,size),[value,mir_operand_copy(current)]),span:nil)],terminator:MirTerminator.Goto(child)))
        self.blocks=self.blocks.push(MirBlock(id:inc_id,label:Some("rt_hal_request_payload_array_increment"),instructions:[MirInst(kind:MirInstKind.BinOp(following,MirBinOp.Add,mir_operand_copy(current),mir_operand_const_int(1)),span:nil),MirInst(kind:MirInstKind.Copy(state,following),span:nil)],terminator:MirTerminator.Goto(cond_id)));entry

    me payload_result(value: MirOperand, ok: MirType, err: MirType, next: BlockId) -> BlockId:
        val is_ok=self.local(MirType.bool(),"rt_hal_request_payload_result_is_ok");val ok_value=self.local(ok,"rt_hal_request_payload_result_ok");val err_value=self.local(err,"rt_hal_request_payload_result_err");val ok_id=BlockId(id:self.next_block);val err_id=BlockId(id:self.next_block+1);self.next_block=self.next_block+2
        val ok_child=self.payload_value(mir_operand_copy(ok_value),ok,next);val err_child=self.payload_value(mir_operand_copy(err_value),err,next);val entry=self.block("rt_hal_request_payload_result_branch",[MirInst(kind:MirInstKind.Call(Some(is_ok),rt_hal_exit_typed_result_is_ok_fn(ok,err),[value]),span:nil)],MirTerminator.If(mir_operand_copy(is_ok),ok_id,err_id))
        self.blocks=self.blocks.push(MirBlock(id:ok_id,label:Some("rt_hal_request_payload_result_ok"),instructions:[MirInst(kind:MirInstKind.Call(Some(ok_value),rt_hal_exit_typed_result_ok_payload_fn(ok,err),[value]),span:nil)],terminator:MirTerminator.Goto(ok_child)))
        self.blocks=self.blocks.push(MirBlock(id:err_id,label:Some("rt_hal_request_payload_result_err"),instructions:[MirInst(kind:MirInstKind.Call(Some(err_value),rt_hal_exit_typed_result_err_payload_fn(ok,err),[value]),span:nil)],terminator:MirTerminator.Goto(err_child)));entry

fn inject_rt_hal_request_capture(function: MirFunction, operation_id: text, request_token: LocalId, bits: LocalId, wide: LocalId) -> MirFunction:
    val descriptor=rt_hal_request_tuple_descriptor(function.signature.params)
    if descriptor == "": return function
    var args: [LocalId]=[];var index=0
    while index<function.signature.params.len():
        val arg=rt_hal_request_arg_local(function,index)
        if arg == nil: return function
        args.push(arg.unwrap());index=index+1
    var event_count=4
    for type_ in function.signature.params:
        val capacity=rt_hal_exit_event_capacity_v2(type_)
        if capacity<=0 or event_count>65534-capacity:
            var rejected: [MirBlock]=[]
            for original in function.blocks:
                if original.id.id==function.entry_block.id:
                    rejected.push(MirBlock(id:original.id,label:original.label,instructions:[],terminator:MirTerminator.Abort("E-RTHAL-REQUEST-EVENT-CAPACITY-REJECT")))
                else:rejected.push(original)
            return MirFunction.with_blocks(function,rejected)
        event_count=event_count+capacity
    var next_block=0
    for block in function.blocks:
        if block.id.id >= next_block: next_block=block.id.id+1
    var next_local=0
    for local in function.locals:
        if local.id.id >= next_local: next_local=local.id.id+1
    var cfg=RtHalRequestCfgBuilder(locals:function.locals,blocks:[],next_local:next_local,next_block:next_block,token:request_token,bits:bits,wide:wide)
    var output: [MirBlock]=[]
    for original in function.blocks:
        if original.id.id != function.entry_block.id:
            output.push(original)
            continue
        var finish_instructions: [MirInst]=[MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_finish",[MirType.i64()],MirType.bool()),[mir_operand_copy(request_token)]),span:nil)]
        for instruction in original.instructions:finish_instructions.push(instruction)
        val finish=cfg.block("rt_hal_request_finish",finish_instructions,original.terminator)
        val payload_end=cfg.block("rt_hal_request_payload_end",[MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_payload_end",[MirType.i64()],MirType.bool()),[mir_operand_copy(request_token)]),span:nil)],MirTerminator.Goto(finish))
        var payload=payload_end;var reverse=args.len()-1
        while reverse>=0:payload=cfg.payload_value(mir_operand_copy(args[reverse]),function.signature.params[reverse],payload);reverse=reverse-1
        # Function parameters are the canonical outer tuple, including the
        # empty tuple.  Its close event must precede RootEnd after all child
        # branches have selected their own transcript.
        val events_end=cfg.block("rt_hal_request_events_end",[cfg.event(4,mir_operand_const_int(0)),cfg.event(2,mir_operand_const_int(0)),MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_events_end",[MirType.i64()],MirType.bool()),[mir_operand_copy(request_token)]),span:nil),MirInst(kind:MirInstKind.Call(nil,rt_hal_exit_runtime_fn("rt_hal_exact_request_payload_begin",[MirType.i64(),MirType.i64()],MirType.bool()),[mir_operand_copy(request_token),mir_operand_const_int(-1)]),span:nil)],MirTerminator.Goto(payload))
        var events=events_end;reverse=args.len()-1
        while reverse>=0:events=cfg.events_value(mir_operand_copy(args[reverse]),function.signature.params[reverse],events);reverse=reverse-1
        val begin=rt_hal_exit_runtime_fn("rt_hal_exact_request_begin",[MirType(kind:MirTypeKind.Opaque("text")),MirType(kind:MirTypeKind.Opaque("text"))],MirType.i64())
        val events_begin=rt_hal_exit_runtime_fn("rt_hal_exact_request_events_begin",[MirType.i64(),MirType.i64()],MirType.bool())
        output.push(MirBlock(id:original.id,label:original.label,instructions:[MirInst(kind:MirInstKind.Call(Some(request_token),begin,[rt_hal_exit_descriptor_operand(operation_id),rt_hal_exit_descriptor_operand(descriptor)]),span:nil),MirInst(kind:MirInstKind.Call(nil,events_begin,[mir_operand_copy(request_token),mir_operand_const_int(event_count)]),span:nil),cfg.event(1,mir_operand_const_int(2<<32)),cfg.event(3,mir_operand_const_int(function.signature.params.len()))],terminator:MirTerminator.Goto(events)))
    for generated in cfg.blocks:output.push(generated)
    # The outer boundary performs the one shared checked-helper expansion
    # after it has appended terminal lowering.  Running it here would leave
    # the rewritten Calls visible to that outer pass and invoke every request
    # owner operation twice.
    MirFunction.with_locals_and_blocks(function,cfg.locals,output)

### The boundary is expanded before backend lowering.  In particular, the
### legacy RtHalExitArenaWrite* pseudo opcodes are intentionally not emitted:
### a backend receives ordinary typed Calls/GetField/CFG and never needs to
### infer the representation of a tuple, Result, or fixed array.
class RtHalExitCfgBuilder:
    locals: [MirLocal]
    blocks: [MirBlock]
    next_local: i64
    next_block: i64
    token: LocalId
    bits: LocalId
    wide: LocalId

    me local(type_: MirType, name: text) -> LocalId:
        val id = LocalId(id: self.next_local)
        self.next_local = self.next_local + 1
        self.locals = self.locals.push(MirLocal(id: id, name: Some(name), type_: type_, kind: LocalKind.Temp, is_ghost: false))
        id

    me mutable_local(type_: MirType, name: text) -> LocalId:
        val id = LocalId(id: self.next_local)
        self.next_local = self.next_local + 1
        self.locals = self.locals.push(MirLocal(id: id, name: Some(name), type_: type_, kind: LocalKind.Var, is_ghost: false))
        id

    me block(label: text, instructions: [MirInst], terminator: MirTerminator) -> BlockId:
        val id = BlockId(id: self.next_block)
        self.next_block = self.next_block + 1
        self.blocks = self.blocks.push(MirBlock(id: id, label: Some(label), instructions: instructions, terminator: terminator))
        id

    me event_append(tag: i64, argument: MirOperand) -> MirInst:
        MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_events_append_fn(),
            [mir_operand_copy(self.token), mir_operand_const_int(tag), argument]), span: nil)

    # Event CFG is deliberately separate from `value`: every event is emitted
    # before events_end hands the arena to the payload CFG.  This preserves the
    # wire format's transcript-before-payload invariant even for Result arms.
    me event_leaf(payload: MirOperand, type_: MirType, continuation: BlockId) -> BlockId:
        var instructions: [MirInst] = []
        match type_.kind:
            case Unit: instructions.push(self.event_append(11, mir_operand_const_int(0)))
            case Bool: instructions.push(self.event_append(12, mir_operand_const_int(1)))
            case I8: instructions.push(self.event_append(13, mir_operand_const_int(1)))
            case U8: instructions.push(self.event_append(17, mir_operand_const_int(1)))
            case I16: instructions.push(self.event_append(14, mir_operand_const_int(2)))
            case I32: instructions.push(self.event_append(15, mir_operand_const_int(4)))
            case I64: instructions.push(self.event_append(16, mir_operand_const_int(8)))
            case U16: instructions.push(self.event_append(18, mir_operand_const_int(2)))
            case U32 | Char: instructions.push(self.event_append(19, mir_operand_const_int(4)))
            case U64: instructions.push(self.event_append(20, mir_operand_const_int(8)))
            case F32: instructions.push(self.event_append(21, mir_operand_const_int(4)))
            case F64: instructions.push(self.event_append(22, mir_operand_const_int(8)))
            case Opaque(name):
                if name == "text":
                    val length = self.local(MirType.i64(), "rt_hal_exit_text_event_length")
                    val nonnegative = self.local(MirType.bool(), "rt_hal_exit_text_event_nonnegative")
                    val within_cap = self.local(MirType.bool(), "rt_hal_exit_text_event_within_cap")
                    val append = self.block("rt_hal_exit_text_event_append", [
                        self.event_append(25, mir_operand_copy(length)),
                        self.event_append(26, mir_operand_const_int(0))], MirTerminator.Goto(continuation))
                    val reject = self.block("rt_hal_exit_text_event_reject", [
                        MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_runtime_fn("rt_hal_exact_exit_abort", [MirType.i64()], MirType.unit()), [mir_operand_copy(self.token)]), span: nil)], MirTerminator.Abort("E-RTHAL-EXIT-TEXT-EVENT-REJECT"))
                    val cap_check = self.block("rt_hal_exit_text_event_cap_check", [
                        MirInst(kind: MirInstKind.BinOp(within_cap, MirBinOp.Le, mir_operand_copy(length), mir_operand_const_int(1048576)), span: nil)], MirTerminator.If(mir_operand_copy(within_cap), append, reject))
                    return self.block("rt_hal_exit_text_event_length", [
                        MirInst(kind: MirInstKind.Call(Some(length), rt_hal_exit_typed_text_length_fn(), [payload]), span: nil),
                        MirInst(kind: MirInstKind.BinOp(nonnegative, MirBinOp.Ge, mir_operand_copy(length), mir_operand_const_int(0)), span: nil)], MirTerminator.If(mir_operand_copy(nonnegative), cap_check, reject))
            case _: ()
        self.block("rt_hal_exit_event_leaf", instructions, MirTerminator.Goto(continuation))

    me event_value(payload: MirOperand, type_: MirType, continuation: BlockId) -> BlockId:
        match type_.kind:
            case Tuple(elements): self.event_tuple(payload, elements, continuation)
            case Array(element, size): self.event_array(payload, element, size, continuation)
            case Result(ok, err): self.event_result(payload, ok, err, continuation)
            case _: self.event_leaf(payload, type_, continuation)

    me event_tuple(payload: MirOperand, elements: [MirType], continuation: BlockId) -> BlockId:
        var fields: [LocalId] = []
        var instructions: [MirInst] = [self.event_append(3, mir_operand_const_int(elements.len()))]
        var index = 0
        for element in elements:
            val field = self.local(element, "rt_hal_exit_event_tuple_field")
            fields.push(field)
            instructions.push(MirInst(kind: MirInstKind.GetField(field, payload, index), span: nil))
            index = index + 1
        val close = self.block("rt_hal_exit_event_tuple_end", [self.event_append(4, mir_operand_const_int(0))], MirTerminator.Goto(continuation))
        var next = close
        var reverse = elements.len() - 1
        while reverse >= 0:
            next = self.event_value(mir_operand_copy(fields[reverse]), elements[reverse], next)
            reverse = reverse - 1
        self.block("rt_hal_exit_event_tuple_begin", instructions, MirTerminator.Goto(next))

    me event_array(payload: MirOperand, element: MirType, size: i64, continuation: BlockId) -> BlockId:
        val index_state = self.mutable_local(MirType.i64(), "rt_hal_exit_event_array_index_state")
        val index_current = self.local(MirType.i64(), "rt_hal_exit_event_array_index_current")
        val index_next = self.local(MirType.i64(), "rt_hal_exit_event_array_index_next")
        val length = self.local(MirType.i64(), "rt_hal_exit_event_array_length")
        val length_ok = self.local(MirType.bool(), "rt_hal_exit_event_array_length_exact")
        val cond = self.local(MirType.bool(), "rt_hal_exit_event_array_in_bounds")
        val value = self.local(element, "rt_hal_exit_event_array_element")
        val cond_block = BlockId(id: self.next_block)
        val body_block = BlockId(id: self.next_block + 1)
        val increment_block = BlockId(id: self.next_block + 2)
        val length_bad_block = BlockId(id: self.next_block + 3)
        val length_check_block = BlockId(id: self.next_block + 4)
        self.next_block = self.next_block + 5
        val child = self.event_value(mir_operand_copy(value), element, increment_block)
        val close = self.block("rt_hal_exit_event_array_end", [self.event_append(6, mir_operand_const_int(0))], MirTerminator.Goto(continuation))
        val entry = self.block("rt_hal_exit_event_array_begin", [
            MirInst(kind: MirInstKind.Const(index_state, MirConstValue.Int(0), MirType.i64()), span: nil),
            MirInst(kind: MirInstKind.Call(Some(length), rt_hal_exit_typed_array_length_fn(element, size), [payload]), span: nil),
            self.event_append(5, mir_operand_const_int(size))], MirTerminator.Goto(length_check_block))
        self.blocks = self.blocks.push(MirBlock(id: length_check_block, label: Some("rt_hal_exit_event_array_length_check"), instructions: [
            MirInst(kind: MirInstKind.BinOp(length_ok, MirBinOp.Eq, mir_operand_copy(length), mir_operand_const_int(size)), span: nil)], terminator: MirTerminator.If(mir_operand_copy(length_ok), cond_block, length_bad_block)))
        self.blocks = self.blocks.push(MirBlock(id: length_bad_block, label: Some("rt_hal_exit_event_array_length_reject"), instructions: [
            MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_runtime_fn("rt_hal_exact_exit_abort", [MirType.i64()], MirType.unit()), [mir_operand_copy(self.token)]), span: nil)], terminator: MirTerminator.Abort("E-RTHAL-EXIT-EVENT-ARRAY-REJECT")))
        self.blocks = self.blocks.push(MirBlock(id: cond_block, label: Some("rt_hal_exit_event_array_cond"), instructions: [
            MirInst(kind: MirInstKind.Copy(index_current, index_state), span: nil),
            MirInst(kind: MirInstKind.BinOp(cond, MirBinOp.Lt, mir_operand_copy(index_current), mir_operand_const_int(size)), span: nil)], terminator: MirTerminator.If(mir_operand_copy(cond), body_block, close)))
        self.blocks = self.blocks.push(MirBlock(id: body_block, label: Some("rt_hal_exit_event_array_body"), instructions: [
            MirInst(kind: MirInstKind.Call(Some(value), rt_hal_exit_typed_array_at_fn(element, size), [payload, mir_operand_copy(index_current)]), span: nil)], terminator: MirTerminator.Goto(child)))
        self.blocks = self.blocks.push(MirBlock(id: increment_block, label: Some("rt_hal_exit_event_array_increment"), instructions: [
            MirInst(kind: MirInstKind.BinOp(index_next, MirBinOp.Add, mir_operand_copy(index_current), mir_operand_const_int(1)), span: nil),
            MirInst(kind: MirInstKind.Copy(index_state, index_next), span: nil)], terminator: MirTerminator.Goto(cond_block)))
        entry

    me event_result(payload: MirOperand, ok: MirType, err: MirType, continuation: BlockId) -> BlockId:
        val is_ok = self.local(MirType.bool(), "rt_hal_exit_event_result_is_ok")
        val ok_payload = self.local(ok, "rt_hal_exit_event_result_ok")
        val err_payload = self.local(err, "rt_hal_exit_event_result_err")
        val ok_block = BlockId(id: self.next_block)
        val err_block = BlockId(id: self.next_block + 1)
        self.next_block = self.next_block + 2
        val ok_end = self.block("rt_hal_exit_event_result_ok_end", [self.event_append(8, mir_operand_const_int(0))], MirTerminator.Goto(continuation))
        val err_end = self.block("rt_hal_exit_event_result_err_end", [self.event_append(10, mir_operand_const_int(0))], MirTerminator.Goto(continuation))
        val ok_child = self.event_value(mir_operand_copy(ok_payload), ok, ok_end)
        val err_child = self.event_value(mir_operand_copy(err_payload), err, err_end)
        val entry = self.block("rt_hal_exit_event_result_branch", [
            MirInst(kind: MirInstKind.Call(Some(is_ok), rt_hal_exit_typed_result_is_ok_fn(ok, err), [payload]), span: nil)], MirTerminator.If(mir_operand_copy(is_ok), ok_block, err_block))
        self.blocks = self.blocks.push(MirBlock(id: ok_block, label: Some("rt_hal_exit_event_result_ok"), instructions: [
            self.event_append(7, mir_operand_const_int(1)),
            MirInst(kind: MirInstKind.Call(Some(ok_payload), rt_hal_exit_typed_result_ok_payload_fn(ok, err), [payload]), span: nil)], terminator: MirTerminator.Goto(ok_child)))
        self.blocks = self.blocks.push(MirBlock(id: err_block, label: Some("rt_hal_exit_event_result_err"), instructions: [
            self.event_append(9, mir_operand_const_int(1)),
            MirInst(kind: MirInstKind.Call(Some(err_payload), rt_hal_exit_typed_result_err_payload_fn(ok, err), [payload]), span: nil)], terminator: MirTerminator.Goto(err_child)))
        entry

    me leaf(payload: MirOperand, type_: MirType, continuation: BlockId,
            schema_id: i64, kind_code: i64) -> BlockId:
        # The root transcript is emitted once in the terminal block, before
        # this CFG is entered.  Child blocks only project and encode values;
        # a second RootBegin would violate the exact codec state machine.
        var instructions: [MirInst] = []
        val scalar = rt_hal_exit_codec_scalar_fn()
        val role = if kind_code == 1: 2 else: 3
        # Abort is the explicit UTF-8 terminal domain; generic Opaque values
        # otherwise remain rejected by the canonical descriptor gate.
        val descriptor = if kind_code == 5: "v2;text:utf8" else: rt_hal_exit_type_descriptor_v2(type_)
        match type_.kind:
            case I8: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 3, 1, 1, self.bits, self.wide, scalar): instructions.push(write)
            case I16: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 3, 2, 1, self.bits, self.wide, scalar): instructions.push(write)
            case I32: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 3, 4, 1, self.bits, self.wide, scalar): instructions.push(write)
            case I64: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 3, 8, 0, self.bits, self.wide, scalar): instructions.push(write)
            case U8: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 1, 1, self.bits, self.wide, scalar): instructions.push(write)
            case U16: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 2, 1, self.bits, self.wide, scalar): instructions.push(write)
            case U32: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 4, 1, self.bits, self.wide, scalar): instructions.push(write)
            case U64: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 8, 0, self.bits, self.wide, scalar): instructions.push(write)
            case F32: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 5, 4, 2, self.bits, self.wide, scalar): instructions.push(write)
            case F64: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 5, 8, 3, self.bits, self.wide, scalar): instructions.push(write)
            case Bool: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 1, 1, self.bits, self.wide, scalar): instructions.push(write)
            case Char: for write in rt_hal_exit_scalar_call(self.token, role, descriptor, payload, 4, 4, 1, self.bits, self.wide, scalar): instructions.push(write)
            case Opaque(name):
                if name == "text":
                    # A composite field is normally a local, not a string
                    # literal.  Never pass the old constant-only -1 width to
                    # the codec: derive it through the typed bridge and
                    # reject it before the byte writer if it exceeds the
                    # fixed exit arena ceiling.
                    val text_length = self.local(MirType.i64(), "rt_hal_exit_text_payload_length")
                    val text_nonnegative = self.local(MirType.bool(), "rt_hal_exit_text_payload_nonnegative")
                    val text_within_cap = self.local(MirType.bool(), "rt_hal_exit_text_payload_within_cap")
                    val utf8_write = self.block("rt_hal_exit_text_payload_write", [
                        MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_codec_utf8_fn(), [mir_operand_copy(self.token), mir_operand_const_int(role), rt_hal_exit_descriptor_operand("v2;text:utf8"), mir_operand_const_int(2), mir_operand_copy(text_length), payload]), span: nil)], MirTerminator.Goto(continuation))
                    val utf8_reject = self.block("rt_hal_exit_text_payload_reject", [
                        MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_runtime_fn("rt_hal_exact_exit_abort", [MirType.i64()], MirType.unit()), [mir_operand_copy(self.token)]), span: nil)], MirTerminator.Abort("E-RTHAL-EXIT-TEXT-PAYLOAD-REJECT"))
                    val utf8_cap_check = self.block("rt_hal_exit_text_payload_cap_check", [
                        MirInst(kind: MirInstKind.BinOp(text_within_cap, MirBinOp.Le, mir_operand_copy(text_length), mir_operand_const_int(1048576)), span: nil)], MirTerminator.If(mir_operand_copy(text_within_cap), utf8_write, utf8_reject))
                    return self.block("rt_hal_exit_text_payload_length", [
                        MirInst(kind: MirInstKind.Call(Some(text_length), rt_hal_exit_typed_text_length_fn(), [payload]), span: nil),
                        MirInst(kind: MirInstKind.BinOp(text_nonnegative, MirBinOp.Ge, mir_operand_copy(text_length), mir_operand_const_int(0)), span: nil)], MirTerminator.If(mir_operand_copy(text_nonnegative), utf8_cap_check, utf8_reject))
            case Unit: ()
            case _: ()
        self.block("rt_hal_exit_leaf", instructions, MirTerminator.Goto(continuation))

    me value(payload: MirOperand, type_: MirType, continuation: BlockId,
            schema_id: i64, kind_code: i64) -> BlockId:
        match type_.kind:
            case Tuple(elements): self.tuple(payload, elements, continuation, schema_id, kind_code)
            case Array(element, size): self.array(payload, element, size, continuation, schema_id, kind_code)
            case Result(ok, err): self.result(payload, ok, err, continuation, schema_id, kind_code)
            case _: self.leaf(payload, type_, continuation, schema_id, kind_code)

    me tuple(payload: MirOperand, elements: [MirType], continuation: BlockId,
            schema_id: i64, kind_code: i64) -> BlockId:
        var fields: [LocalId] = []
        var instructions: [MirInst] = []
        var index = 0
        for element in elements:
            val field = self.local(element, "rt_hal_exit_tuple_field")
            fields.push(field)
            instructions.push(MirInst(kind: MirInstKind.GetField(field, payload, index), span: nil))
            index = index + 1
        var next = continuation
        var reverse = elements.len() - 1
        while reverse >= 0:
            next = self.value(mir_operand_copy(fields[reverse]), elements[reverse], next,
                rt_hal_exit_schema_id_v2(rt_hal_exit_type_descriptor_v2(elements[reverse])), kind_code)
            reverse = reverse - 1
        self.block("rt_hal_exit_tuple_project", instructions, MirTerminator.Goto(next))

    me array(payload: MirOperand, element: MirType, size: i64, continuation: BlockId,
            schema_id: i64, kind_code: i64) -> BlockId:
        # `index_state` is the sole mutable loop carrier. Every calculated
        # iteration value is a distinct SSA temp, so a backend never sees a
        # BinOp redefining its own destination.
        val index_state = self.mutable_local(MirType.i64(), "rt_hal_exit_array_index_state")
        val index_current = self.local(MirType.i64(), "rt_hal_exit_array_index_current")
        val index_next = self.local(MirType.i64(), "rt_hal_exit_array_index_next")
        val length = self.local(MirType.i64(), "rt_hal_exit_array_length")
        val length_ok = self.local(MirType.bool(), "rt_hal_exit_array_length_within_schema")
        val cond = self.local(MirType.bool(), "rt_hal_exit_array_in_bounds")
        val value = self.local(element, "rt_hal_exit_array_element")
        val cond_block = BlockId(id: self.next_block)
        val body_block = BlockId(id: self.next_block + 1)
        val increment_block = BlockId(id: self.next_block + 2)
        val length_bad_block = BlockId(id: self.next_block + 3)
        val length_check_block = BlockId(id: self.next_block + 4)
        self.next_block = self.next_block + 5
        val child = self.value(mir_operand_copy(value), element, increment_block,
            rt_hal_exit_schema_id_v2(rt_hal_exit_type_descriptor_v2(element)), kind_code)
        val entry = self.block("rt_hal_exit_array_begin", [
            MirInst(kind: MirInstKind.Const(index_state, MirConstValue.Int(0), MirType.i64()), span: nil),
            MirInst(kind: MirInstKind.Call(Some(length), rt_hal_exit_typed_array_length_fn(element, size), [payload]), span: nil)], MirTerminator.Goto(length_check_block))
        self.blocks = self.blocks.push(MirBlock(id: length_check_block, label: Some("rt_hal_exit_array_length_check"), instructions: [
            MirInst(kind: MirInstKind.BinOp(length_ok, MirBinOp.Le, mir_operand_copy(length), mir_operand_const_int(size)), span: nil)], terminator: MirTerminator.If(mir_operand_copy(length_ok), cond_block, length_bad_block)))
        self.blocks = self.blocks.push(MirBlock(id: length_bad_block, label: Some("rt_hal_exit_array_length_reject"), instructions: [
            MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_runtime_fn("rt_hal_exact_exit_abort", [MirType.i64()], MirType.unit()), [mir_operand_copy(self.token)]), span: nil)], terminator: MirTerminator.Abort("E-RTHAL-EXIT-ARRAY-REJECT")))
        self.blocks = self.blocks.push(MirBlock(id: cond_block, label: Some("rt_hal_exit_array_cond"), instructions: [
            MirInst(kind: MirInstKind.Copy(index_current, index_state), span: nil),
            MirInst(kind: MirInstKind.BinOp(cond, MirBinOp.Lt, mir_operand_copy(index_current), mir_operand_copy(length)), span: nil)], terminator: MirTerminator.If(mir_operand_copy(cond), body_block, continuation)))
        self.blocks = self.blocks.push(MirBlock(id: body_block, label: Some("rt_hal_exit_array_body"), instructions: [
            MirInst(kind: MirInstKind.Call(Some(value), rt_hal_exit_typed_array_at_fn(element, size), [payload, mir_operand_copy(index_current)]), span: nil)], terminator: MirTerminator.Goto(child)))
        self.blocks = self.blocks.push(MirBlock(id: increment_block, label: Some("rt_hal_exit_array_increment"), instructions: [
            MirInst(kind: MirInstKind.BinOp(index_next, MirBinOp.Add, mir_operand_copy(index_current), mir_operand_const_int(1)), span: nil),
            MirInst(kind: MirInstKind.Copy(index_state, index_next), span: nil)], terminator: MirTerminator.Goto(cond_block)))
        entry

    me result(payload: MirOperand, ok: MirType, err: MirType, continuation: BlockId,
            schema_id: i64, kind_code: i64) -> BlockId:
        val is_ok = self.local(MirType.bool(), "rt_hal_exit_result_is_ok")
        val ok_payload = self.local(ok, "rt_hal_exit_result_ok")
        val err_payload = self.local(err, "rt_hal_exit_result_err")
        val ok_block = BlockId(id: self.next_block)
        val err_block = BlockId(id: self.next_block + 1)
        self.next_block = self.next_block + 2
        val ok_child = self.value(mir_operand_copy(ok_payload), ok, continuation,
            rt_hal_exit_schema_id_v2(rt_hal_exit_type_descriptor_v2(ok)), kind_code)
        val err_child = self.value(mir_operand_copy(err_payload), err, continuation,
            rt_hal_exit_schema_id_v2(rt_hal_exit_type_descriptor_v2(err)), kind_code)
        val entry = self.block("rt_hal_exit_result_branch", [
            MirInst(kind: MirInstKind.Call(Some(is_ok), rt_hal_exit_typed_result_is_ok_fn(ok, err), [payload]), span: nil)], MirTerminator.If(mir_operand_copy(is_ok), ok_block, err_block))
        self.blocks = self.blocks.push(MirBlock(id: ok_block, label: Some("rt_hal_exit_result_ok"), instructions: [
            MirInst(kind: MirInstKind.Call(Some(ok_payload), rt_hal_exit_typed_result_ok_payload_fn(ok, err), [payload]), span: nil)], terminator: MirTerminator.Goto(ok_child)))
        self.blocks = self.blocks.push(MirBlock(id: err_block, label: Some("rt_hal_exit_result_err"), instructions: [
            MirInst(kind: MirInstKind.Call(Some(err_payload), rt_hal_exit_typed_result_err_payload_fn(ok, err), [payload]), span: nil)], terminator: MirTerminator.Goto(err_child)))
        entry

pub fn inject_rt_hal_boundary(function: MirFunction, operation_id: text,
        compare_c: bool, compare_rust: bool) -> MirFunction:
    if not compare_c and not compare_rust: return function
    val token = rt_hal_exit_token_local(function)
    val bits_local = LocalId(id: token.id + 1)
    val wide_local = LocalId(id: token.id + 2)
    val request_token = LocalId(id: token.id + 3)
    var request_locals=function.locals
    # Request CFG projection is emitted before terminal CFG expansion, so its
    # scalar conversion temporaries must already have stable, non-overlapping
    # local IDs.  Do not add them after generated request blocks exist.
    request_locals.push(MirLocal(id:token,name:Some("rt_hal_exit_token"),type_:MirType.i64(),kind:LocalKind.Temp,is_ghost:false))
    request_locals.push(MirLocal(id:bits_local,name:Some("rt_hal_exit_bits"),type_:MirType(kind:MirTypeKind.I32),kind:LocalKind.Temp,is_ghost:false))
    request_locals.push(MirLocal(id:wide_local,name:Some("rt_hal_exit_wide"),type_:MirType.i64(),kind:LocalKind.Temp,is_ghost:false))
    request_locals.push(MirLocal(id:request_token,name:Some("rt_hal_request_token"),type_:MirType.i64(),kind:LocalKind.Temp,is_ghost:false))
    val request_prepared=inject_rt_hal_env_access_effect_capture(inject_rt_hal_request_capture(
        MirFunction.with_locals_and_blocks(function,request_locals,function.blocks),
        operation_id,request_token,bits_local,wide_local),request_token)
    var next_block = 0
    for candidate in request_prepared.blocks:
        if candidate.id.id >= next_block: next_block = candidate.id.id + 1
    var next_local = 0
    for candidate in request_prepared.locals:
        if candidate.id.id >= next_local: next_local = candidate.id.id + 1
    var cfg = RtHalExitCfgBuilder(locals: request_prepared.locals, blocks: [],
        next_local: next_local, next_block: next_block, token: token,
        bits: bits_local, wide: wide_local)
    val begin = rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_begin_next_with_request",
        [MirType.i64(), MirType.i64(), MirType(kind: MirTypeKind.Opaque("text")),MirType.i64()], MirType.i64())
    val operation = rt_hal_exit_descriptor_operand(operation_id)
    val finish = rt_hal_exit_runtime_fn("rt_hal_exact_exit_backend_finish",
        [MirType.i64()], MirType.bool())
    var needs_token = false
    var blocks: [MirBlock] = []
    for original_block in request_prepared.blocks:
        var block = original_block
        var instructions = block.instructions
        var terminal: MirTerminator? = nil
        var payload: MirOperand? = nil
        var type_ = MirType(kind: MirTypeKind.Never)
        var schema_id = 0
        var kind_code = 0
        match block.terminator:
            case Ret(value):
                type_ = rt_hal_exit_operand_type(request_prepared, value) ?? MirType(kind: MirTypeKind.Never)
                instructions.push(rt_hal_exit_capture(operation_id, compare_c, compare_rust, 1, value, type_))
                payload = value
                terminal = Some(block.terminator)
                kind_code = 1
            case Throw(payload, _):
                type_ = rt_hal_exit_operand_type(request_prepared, Some(payload)) ?? MirType(kind: MirTypeKind.Never)
                instructions.push(rt_hal_exit_capture(operation_id, compare_c, compare_rust, 3, Some(payload), type_))
                terminal = Some(block.terminator)
                kind_code = 3
            case Resume(payload, _):
                type_ = rt_hal_exit_operand_type(request_prepared, Some(payload)) ?? MirType(kind: MirTypeKind.Never)
                instructions.push(rt_hal_exit_capture(operation_id, compare_c, compare_rust, 4, Some(payload), type_))
                terminal = Some(block.terminator)
                kind_code = 4
            case Abort(message):
                instructions.push(rt_hal_abort_capture(operation_id, compare_c, compare_rust, message))
                payload = Some(rt_hal_abort_operand(message))
                type_ = MirType(kind: MirTypeKind.Opaque("text"))
                terminal = Some(block.terminator)
                kind_code = 5
            case _: ()
        val descriptor = if kind_code == 5: "v2;text:utf8" else: rt_hal_exit_type_descriptor_v2(type_)
        if descriptor != "" and terminal != nil:
            schema_id = rt_hal_exit_schema_id_v2(descriptor)
            if val observed = payload:
                val final_terminal = terminal ?? MirTerminator.Unreachable
                if not rt_hal_exit_is_composite(type_):
                    instructions.push(MirInst(kind: MirInstKind.Call(Some(token), begin, [mir_operand_const_int(schema_id), mir_operand_const_int(kind_code), operation,mir_operand_copy(request_token)]), span: nil))
                    for write in rt_hal_exit_direct_writer(token, bits_local, wide_local, observed, type_): instructions.push(write)
                    instructions.push(MirInst(kind: MirInstKind.Call(nil, finish, [mir_operand_copy(token)]), span: nil))
                    blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: final_terminal))
                    needs_token = true
                    continue
                # Schema role (Output=2/Error=3) is intentionally distinct
                # from the codec transcript's root-domain code
                # (Output=3/Error=4).  The former indexes the sealed schema;
                # the latter is replayed by the parent shape cursor.
                val role = if kind_code == 1: 2 else: 3
                val root_domain = if kind_code == 1: 3 else: 4
                # Resolve the cold-admitted dense type ID once per terminal.
                # It is then carried in RootBegin's low word; no schema hash
                # or target-layout surrogate leaks into the hot envelope.
                val root_type = cfg.local(MirType.i64(), "rt_hal_exit_root_type")
                val root_argument = cfg.local(MirType.i64(), "rt_hal_exit_root_argument")
                val finish_block = cfg.block("rt_hal_exit_finish", [MirInst(kind: MirInstKind.Call(nil, finish, [mir_operand_copy(token)]), span: nil)], final_terminal)
                val writer = cfg.value(observed, type_, finish_block, schema_id, kind_code)
                val event_capacity = rt_hal_exit_event_capacity_v2(type_)
                # Descriptor admission has already bounded the arena.  A
                # malformed/unrepresentable compile-time shape remains a
                # fail-closed capture rather than a partial transcript.
                if event_capacity <= 0 or event_capacity > 65534:
                    # This is a compile-time shape rejection before begin,
                    # so there is no arena token to reclaim.  It must still
                    # be a deterministic hard trap rather than a normal
                    # terminal that silently skips exact comparison.
                    blocks.push(MirBlock(id: block.id, label: block.label,
                        instructions: instructions,
                        terminator: MirTerminator.Abort("E-RTHAL-EXIT-EVENT-CAPACITY-REJECT")))
                    continue
                val event_finish = cfg.block("rt_hal_exit_events_finish", [
                    cfg.event_append(2, mir_operand_const_int(0)),
                    MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_events_end_fn(), [mir_operand_copy(token)]), span: nil)], MirTerminator.Goto(writer))
                val event_writer = cfg.event_value(observed, type_, event_finish)
                instructions.push(MirInst(kind: MirInstKind.Call(Some(root_type), rt_hal_exit_schema_resolve_fn(), [mir_operand_const_int(schema_id), mir_operand_const_int(role)]), span: nil))
                instructions.push(MirInst(kind: MirInstKind.BinOp(root_argument, MirBinOp.BitOr,
                    mir_operand_const_int(root_domain << 32), mir_operand_copy(root_type)), span: nil))
                instructions.push(MirInst(kind: MirInstKind.Call(Some(token), begin, [mir_operand_const_int(schema_id), mir_operand_const_int(kind_code), operation,mir_operand_copy(request_token)]), span: nil))
                # The preallocated event capacity is only a bounded arena
                # reservation.  `events_end` closes the exact selected
                # stream before any typed payload writer is reachable.
                instructions.push(MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_events_begin_fn(), [mir_operand_copy(token), mir_operand_const_int(event_capacity + 2)]), span: nil))
                instructions.push(MirInst(kind: MirInstKind.Call(nil, rt_hal_exit_events_append_fn(), [mir_operand_copy(token), mir_operand_const_int(1), mir_operand_copy(root_argument)]), span: nil))
                blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: MirTerminator.Goto(event_writer)))
                needs_token = true
            else:
                blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: block.terminator))
        elif instructions.len() == block.instructions.len(): blocks.push(block)
        else: blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: block.terminator))
    if not needs_token:
        # A tagged library/body can have no locally observed terminal in this
        # MIR function, but its pre-Pure request is still fallible and must
        # receive the same exactly-once helper failure expansion.
        return rt_hal_exit_check_helper_failures(
            MirFunction.with_blocks(request_prepared, blocks), Some(request_token), Some(request_token))
    var locals = cfg.locals
    for generated in cfg.blocks: blocks.push(generated)
    rt_hal_exit_check_helper_failures(
        MirFunction.with_locals_and_blocks(request_prepared, locals, blocks), Some(token), Some(request_token))

# Library setup has no arbitrary controller function: every exported tagged
# boundary receives this idempotent cold prefix. The runtime accepts only the
# same sealed plan on later entries, so no exported call can race ahead of
# installation/sealing. Finalization remains a separate library shutdown edge.
pub fn inject_rt_hal_controller_initialize(function: MirFunction, plan_path: text,
        required_assurance_rank: i64, plan_identity: text) -> MirFunction:
    val installer=MirOperand(kind:MirOperandKind.Const(
        MirConstValue.Str("rt_hal_compiler_stage_isolated_exact_host_from_plan_path_or_fail"),
        MirType(kind:MirTypeKind.FuncPtr(MirSignature(params:[MirType(kind:MirTypeKind.Opaque("str")),MirType.i64(),MirType(kind:MirTypeKind.Opaque("str"))],return_type:MirType.unit(),is_variadic:false)))))
    val arena=MirOperand(kind:MirOperandKind.Const(
        MirConstValue.Str("rt_hal_exact_exit_arena_install_or_fail"),
        MirType(kind:MirTypeKind.FuncPtr(MirSignature(params:[MirType.i64(),MirType.i64()],return_type:MirType.unit(),is_variadic:false)))))
    val plan=MirOperand(kind:MirOperandKind.Const(MirConstValue.Str(plan_path),MirType(kind:MirTypeKind.Opaque("str"))))
    val identity=MirOperand(kind:MirOperandKind.Const(MirConstValue.Str(plan_identity),MirType(kind:MirTypeKind.Opaque("str"))))
    var blocks: [MirBlock]=[];var index=0
    for original in function.blocks:
        if index==0:
            var entry: [MirInst]=[MirInst(kind:MirInstKind.Call(nil,installer,[plan,mir_operand_const_int(required_assurance_rank),identity]),span:nil),
                MirInst(kind:MirInstKind.Call(nil,arena,[mir_operand_const_int(256),mir_operand_const_int(1048576)]),span:nil)]
            for instruction in original.instructions:entry.push(instruction)
            blocks.push(MirBlock(id:original.id,label:original.label,instructions:entry,terminator:original.terminator))
        else:blocks.push(original)
        index=index+1
    MirFunction.with_blocks(function,blocks)

pub fn inject_rt_hal_controller_finalize(function: MirFunction, plan_path: text,
        required_assurance_rank: i64, plan_identity: text) -> MirFunction:
    val finalize = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str("rt_hal_process_finalize_current_owner"),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)))
    ))
    var blocks: [MirBlock] = []
    var block_index = 0
    for original_block in function.blocks:
        var block = original_block
        if block_index == 0:
            val installer = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_hal_compiler_stage_isolated_exact_host_from_plan_path_or_fail"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params:[MirType(kind:MirTypeKind.Opaque("str")),MirType.i64(),MirType(kind:MirTypeKind.Opaque("str"))],return_type:MirType.unit(),is_variadic:false)))
            ))
            val plan = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(plan_path), MirType(kind: MirTypeKind.Opaque("str"))))
            val identity = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(plan_identity), MirType(kind: MirTypeKind.Opaque("str"))))
            val arena_installer = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_hal_exact_exit_arena_install_or_fail"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64()], return_type: MirType.unit(), is_variadic: false)))
            ))
            # This allocation belongs to the foreign-comparison controller
            # only. Static Pure-only @rt(hal) never reaches this transform.
            var entry: [MirInst] = [MirInst(kind:MirInstKind.Call(nil,installer,[plan,mir_operand_const_int(required_assurance_rank),identity]),span:nil),
                MirInst(kind: MirInstKind.Call(nil, arena_installer,
                    [mir_operand_const_int(256), mir_operand_const_int(1048576)]), span: nil)]
            for instruction in block.instructions: entry.push(instruction)
            block = MirBlock(id: block.id, label: block.label, instructions: entry, terminator: block.terminator)
        match block.terminator:
            # A controller must drain and release its bounded arena on every
            # process-terminal path, not only a successful return.  The
            # finalizer preserves the original terminator, so an exception or
            # abort still propagates after its exact failure state is made
            # authoritative.
            case Ret(_) | Throw(_, _) | Resume(_, _) | Abort(_):
                var instructions = block.instructions
                instructions.push(MirInst(kind: MirInstKind.Call(nil, finalize, []), span: nil))
                blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: block.terminator))
            case _: blocks.push(block)
        block_index = block_index + 1
    MirFunction.with_blocks(function, blocks)

# Lowered only into the controller entry after the module has collected every
# capture schema. Backends translate this cold prefix to type_register x3,
# schema_register(schema, output_dense, error_dense, effect_dense), then one
# seal. It is outside every producer exit path.
pub fn inject_rt_hal_cold_schema_registration(function: MirFunction,
        schema_ids: [i64], output_descriptors: [text], error_descriptors: [text],
        effect_descriptors: [text], compare_c: [bool],
        compare_rust: [bool], effect_operations: [text],
        effect_captures: [bool], effect_compare_c: [bool],
        effect_compare_rust: [bool]) -> MirFunction:
    if schema_ids.len() == 0: return function
    var blocks: [MirBlock] = []
    var block_index = 0
    for original_block in function.blocks:
        if block_index != 0:
            blocks.push(original_block)
        else:
            var prefix: [MirInst] = []
            # Registration is a cold ordinary-call ABI.  Do not leave
            # compiler-private RtHalExitSchema* opcodes for a backend to
            # rediscover (or silently erase): the runtime owner validates,
            # binds, and seals the exact descriptor table itself.
            val bind = rt_hal_exit_runtime_fn(
                "rt_hal_exact_exit_schema_bind_descriptors",
                [MirType.i64(), MirType(kind: MirTypeKind.Opaque("text")), MirType.i64(),
                 MirType(kind: MirTypeKind.Opaque("text")), MirType.i64(),
                 MirType(kind: MirTypeKind.Opaque("text")), MirType.i64()],
                MirType.bool())
            val policy = rt_hal_exit_runtime_fn(
                "rt_hal_exact_exit_schema_policy_register",
                [MirType.i64(), MirType.bool(), MirType.bool()], MirType.bool())
            val effect_policy = rt_hal_exit_runtime_fn(
                "rt_hal_exact_exit_operation_effect_policy_register",
                [MirType(kind: MirTypeKind.Opaque("text")), MirType.bool(),
                 MirType.bool(), MirType.bool()], MirType.bool())
            val seal = rt_hal_exit_runtime_fn("rt_hal_exact_exit_type_seal", [], MirType.bool())
            val controller_seal = rt_hal_exit_runtime_fn("rt_hal_exact_exit_controller_seal", [], MirType.bool())
            var index = 0
            while index < schema_ids.len():
                val output = output_descriptors[index]
                val error = error_descriptors[index]
                val effect = effect_descriptors[index]
                val output_operand = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(output), MirType(kind: MirTypeKind.Opaque("text"))))
                val error_operand = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(error), MirType(kind: MirTypeKind.Opaque("text"))))
                val effect_operand = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(effect), MirType(kind: MirTypeKind.Opaque("text"))))
                prefix.push(MirInst(kind: MirInstKind.Call(nil, bind,
                    [mir_operand_const_int(schema_ids[index]), output_operand,
                     mir_operand_const_int(rt_hal_exit_encoding_code_v2(output)), error_operand,
                     mir_operand_const_int(rt_hal_exit_encoding_code_v2(error)), effect_operand,
                     mir_operand_const_int(rt_hal_exit_encoding_code_v2(effect))]), span: nil))
                # Keep foreign-provider requirements in the cold runtime
                # owner before the capture metadata is stripped.  A schema
                # shared by several tagged functions unions these flags in
                # the owner, preventing metadata stripping from downgrading
                # C/Rust comparison to Pure-only execution.
                prefix.push(MirInst(kind: MirInstKind.Call(nil, policy,
                    [mir_operand_const_int(schema_ids[index]),
                     MirOperand(kind: MirOperandKind.Const(MirConstValue.Bool(compare_c[index]), MirType.bool())),
                     MirOperand(kind: MirOperandKind.Const(MirConstValue.Bool(compare_rust[index]), MirType.bool()))]), span: nil))
                index = index + 1
            # Reconcile every foreign-tagged operation independently of its
            # exit descriptor.  This must happen before type/controller seal:
            # later capture only queries this immutable admission table.
            index = 0
            while index < effect_operations.len():
                val operation_operand=MirOperand(kind:MirOperandKind.Const(
                    MirConstValue.Str(effect_operations[index]),
                    MirType(kind:MirTypeKind.Opaque("text"))))
                prefix.push(MirInst(kind:MirInstKind.Call(nil,effect_policy,
                    [operation_operand,
                     MirOperand(kind:MirOperandKind.Const(MirConstValue.Bool(effect_captures[index]),MirType.bool())),
                     MirOperand(kind:MirOperandKind.Const(MirConstValue.Bool(effect_compare_c[index]),MirType.bool())),
                     MirOperand(kind:MirOperandKind.Const(MirConstValue.Bool(effect_compare_rust[index]),MirType.bool()))]),span:nil))
                index=index+1
            prefix.push(MirInst(kind: MirInstKind.Call(nil, seal, []), span: nil))
            prefix.push(MirInst(kind: MirInstKind.Call(nil, controller_seal, []), span: nil))
            for instruction in original_block.instructions: prefix.push(instruction)
            blocks.push(MirBlock(id: original_block.id, label: original_block.label,
                instructions: prefix, terminator: original_block.terminator))
        block_index = block_index + 1
    # Binding and sealing are cold but still security-critical: do not permit
    # a failed schema admission to fall through into a producer body.
    rt_hal_exit_check_helper_failures(MirFunction.with_blocks(function, blocks), nil, nil)

# RtHalExitCapture is deliberately retained through module-wide cold-schema
# collection, then removed.  The executable observation is entirely the
# ordinary helper-call sequence injected beside its terminal; keeping this
# metadata opcode past collection makes otherwise valid native backends fail
# closed before they can execute that sequence.
pub fn strip_rt_hal_exit_capture_metadata(function: MirFunction) -> MirFunction:
    var blocks: [MirBlock] = []
    for block in function.blocks:
        var instructions: [MirInst] = []
        for instruction in block.instructions:
            match instruction.kind:
                case RtHalExitCapture(_, _, _, _, _, _, _, _, _, _, _, _, _): ()
                case _: instructions.push(instruction)
        blocks.push(MirBlock(id: block.id, label: block.label,
            instructions: instructions, terminator: block.terminator))
    MirFunction.with_blocks(function, blocks)

export inject_rt_hal_boundary, inject_rt_hal_controller_initialize, inject_rt_hal_controller_finalize
export inject_rt_hal_cold_schema_registration, strip_rt_hal_exit_capture_metadata
export rt_hal_function_has_env_effect_capture
export rt_hal_env_executor_provenance_reset, rt_hal_env_executor_provenance_register
export rt_hal_exit_typed_result_is_ok_fn
export rt_hal_exit_typed_result_ok_payload_fn, rt_hal_exit_typed_result_err_payload_fn
export rt_hal_exit_typed_array_length_fn, rt_hal_exit_typed_array_at_fn
export rt_hal_exit_typed_text_length_fn
export rt_hal_exit_events_begin_fn, rt_hal_exit_events_append_fn, rt_hal_exit_events_end_fn
export rt_hal_exit_codec_scalar_fn, rt_hal_exit_codec_utf8_fn

pub fn inject_rt_hal_worker_complete(function: MirFunction) -> MirFunction:
    val complete = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("rt_hal_boundary_worker_complete_hook"), MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)))))
    var blocks: [MirBlock] = []
    for block in function.blocks:
        match block.terminator:
            case Ret(_):
                var instructions = block.instructions
                instructions.push(MirInst(kind: MirInstKind.Call(nil, complete, []), span: nil))
                blocks.push(MirBlock(id: block.id, label: block.label, instructions: instructions, terminator: block.terminator))
            case _: blocks.push(block)
    MirFunction.with_blocks(function, blocks)

export inject_rt_hal_worker_complete
