# Declaration-slot planning precedes expression lowering. Empty argument names
# denote positional arguments; explicit nil is still a supplied argument.
pub fn mir_call_argument_slots_v1(parameters: [text], defaults: [bool], names: [text]) -> Result<[i64], text>:
    if parameters.len() != defaults.len(): return Err("call parameter metadata is incomplete")
    var claimed: Dict<i64, bool> = {}
    var named_slots: Dict<text, i64> = {}
    for name in names:
        if name == "": continue
        if named_slots.has(name): return Err("duplicate named argument: {name}")
        var slot = -1
        var scan = 0
        while scan < parameters.len():
            if parameters[scan] == name:
                if slot >= 0: return Err("ambiguous parameter name: {name}")
                slot = scan
            scan = scan + 1
        if slot < 0: return Err("unknown named argument: {name}")
        named_slots[name] = slot
        claimed[slot] = true
    var slots: [i64] = []
    var next_slot = 0
    for name in names:
        if name != "":
            slots.push(named_slots[name])
        else:
            while next_slot < parameters.len() and claimed.has(next_slot): next_slot = next_slot + 1
            if next_slot >= parameters.len(): return Err("too many call arguments")
            slots.push(next_slot)
            claimed[next_slot] = true
            next_slot = next_slot + 1
    var index = 0
    while index < parameters.len():
        if not claimed.has(index) and not defaults[index]:
            return Err("missing required argument: {parameters[index]}")
        index = index + 1
    Ok(slots)
