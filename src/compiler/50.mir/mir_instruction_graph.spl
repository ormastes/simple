# MIR instruction graph and function/module owners.

use std.common.math.math.{math_pow}

use compiler.hir.hir_types.{SymbolId, HirType}
use compiler.hir.hir_definitions.{HirContractBlock}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{DriverManifestAttr, VhdlHardwareMetadata}
use compiler.common.native_layout_trace.{MirExternalLayoutTraceV1}
use compiler.mir.mir_types.*
use compiler.mir.mir_instruction_support.*
use compiler.mir.mir_instruction_kinds.*
# Preserve terminal providers when this graph is re-exported by mir_data.
use compiler.mir.mir_types.{MirType, MirConstValue}
use compiler.mir.mir_instruction_support.{mir_operand_const_int, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_enum_semantic_types.{MirEnumMatchSemanticV1, MirEnumDeclarationIdentityV1}

# Match runtime.h: integer folding uses the existing signed i64 power ABI.
# An explicit call also records the extern signature for older LLVM producers.
@unsafe(reason: "existing integer power runtime ABI", capabilities: [ffi])
extern fn __simple_pow(base: i64, exp: i64) -> i64

struct MirInst:
    """MIR instruction."""
    kind: MirInstKind
    span: Span?

impl MirInst:
    fn bootstrap_store_global_symbol_id() -> i64:
        match self.kind:
            case StoreGlobal(symbol, _): symbol.id
            case _: -1

    # Twins of bootstrap_store_global_symbol_id for LoadGlobal. The MirToLlvm
    # LoadGlobal handler used to decode the payload RAW
    # (rt_enum_payload + rt_tuple_get + `slot >> 32`) on the theory that a
    # one-field SymbolId "decays to its raw i64 when crossing the staged
    # enum-payload ABI". Measured 2026-08-24 on the seed's tree-walk
    # interpreter (the engine the native-build worker runs): it does NOT decay
    # there — tuple slot 1 is a live SymbolId Object, so `slot >> 32` reached
    # Value::as_int and failed with `type mismatch: cannot convert object to
    # int`, with no callee and no span. A typed match is the representation-
    # independent read, and is exactly what the StoreGlobal sibling above has
    # always used on the same lanes.
    fn bootstrap_load_global_dest_local_id() -> i64:
        match self.kind:
            case LoadGlobal(dest, _): dest.id
            case _: -1

    fn bootstrap_load_global_symbol_id() -> i64:
        match self.kind:
            case LoadGlobal(_, symbol): symbol.id
            case _: -1

    # Call's destination is OPTIONAL (a void call has none), so -1 means
    # "no destination to account for" as well as "not a Call" -- both are
    # non-answers for the emitted-destination guards in _MirToLlvm, which is
    # why they share one sentinel.
    # Typed match, NOT raw `rt_enum_payload` + `rt_tuple_get(payload, 0)`
    # decoding: measured 2026-08-24 (see bootstrap_load_global_dest_local_id
    # above) the seed's tree-walk interpreter keeps payload slots as live
    # Objects, so raw decoding fails with `cannot convert object to int`.
    # `??`, NOT `.unwrap()` -- the STOLEN UNWRAP: a bare `unwrap` published by
    # another module can steal every Option.unwrap binding on this lane and
    # return raw 0, which would report local 0 as the destination. `dest.?`
    # already proves presence, so the fallback below is unreachable.
    fn bootstrap_call_dest_local_id() -> i64:
        match self.kind:
            case Call(dest, _, _):
                if dest.?: (dest ?? LocalId(id: -1)).id else: -1
            case _: -1

    fn bootstrap_global_addr_dest_local_id() -> i64:
        match self.kind:
            case GlobalAddr(dest, _, _): dest.id
            case _: -1

    fn bootstrap_global_addr_symbol_id() -> i64:
        match self.kind:
            case GlobalAddr(_, symbol, _): symbol.id
            case _: -1

    fn bootstrap_global_addr_is_mutable() -> bool:
        match self.kind:
            case GlobalAddr(_, _, mutable): mutable
            case _: false

    fn bootstrap_store_global_value_kind() -> i64:
        """Return 1=Copy, 2=Move, 3=Const, or 0=not StoreGlobal."""
        match self.kind:
            case StoreGlobal(_, value):
                match value.kind:
                    case Copy(_): 1
                    case Move(_): 2
                    case Const(_, _): 3
            case _: 0

    fn bootstrap_store_global_value_local_id() -> i64:
        match self.kind:
            case StoreGlobal(_, value):
                match value.kind:
                    case Copy(local) | Move(local): local.id
                    case _: -1
            case _: -1

    fn bootstrap_store_global_const_kind() -> i64:
        """Return 1=Int, 2=Float, 3=Bool, 4=Str, 5=Zero, 6=Array, 7=Tuple, 8=Struct."""
        match self.kind:
            case StoreGlobal(_, value):
                match value.kind:
                    case Const(const_value, _):
                        match const_value:
                            case Int(_): 1
                            case FloatLexeme(_): 2
                            case Float(_): 2
                            case Bool(_): 3
                            case Str(_): 4
                            case Zero: 5
                            case Array(_): 6
                            case Tuple(_): 7
                            case Struct(_): 8
                    case _: 0
            case _: 0

    fn bootstrap_store_global_const_scalar_text() -> text:
        match self.kind:
            case StoreGlobal(_, value):
                match value.kind:
                    case Const(const_value, _):
                        match const_value:
                            case Int(v): "{v}"
                            case FloatLexeme(v): v
                            case Float(v): "{v}"
                            case Bool(v): if v: "1" else: "0"
                            case Str(v): v
                            case Zero: "0"
                            case Array(_): "zeroinitializer"
                            case Tuple(_): "zeroinitializer"
                            case Struct(_): "zeroinitializer"
                    case _: "0"
            case _: "0"

struct MirBlock:
    """Basic block."""
    id: BlockId
    label: text?
    instructions: [MirInst]
    terminator: MirTerminator

impl MirBlock:
    me bootstrap_block_id_value() -> i64:
        """Project the nested block identifier through the MirBlock owner."""
        self.id.id

    # @workaround bug=mir_ret_optional_operand_owner_2026_10_11 reason=preserve optional operand and enum owners through staged coalescing
    fn bootstrap_ret_kind() -> i64:
        """Return 0=nil, 1=Copy, 2=Move, 3=Const, or -1=not Ret."""
        match self.terminator:
            case MirTerminator.Ret(value):
                if value == nil:
                    0
                else:
                    val payload: MirOperand = value ?? mir_operand_const_int(0)
                    match payload.kind:
                        case MirOperandKind.Copy(_): 1
                        case MirOperandKind.Move(_): 2
                        case MirOperandKind.Const(_, _): 3
            case _: -1

    # Name every operand variant: future enum additions must be classified.
    # @workaround bug=mir_ret_optional_operand_owner_2026_10_11 reason=preserve optional operand and enum owners through staged coalescing
    fn bootstrap_ret_local_id() -> i64:
        match self.terminator:
            case MirTerminator.Ret(value):
                if value != nil:
                    val payload: MirOperand = value ?? mir_operand_const_int(0)
                    match payload.kind:
                        case MirOperandKind.Copy(local) | MirOperandKind.Move(local): local.id
                        case MirOperandKind.Const(_, _): -1
                else:
                    -1
            case _: -1

    # @workaround bug=mir_ret_optional_operand_owner_2026_10_11 reason=preserve optional operand and enum owners through staged coalescing
    fn bootstrap_ret_const_kind() -> i64:
        """Return 1=Int, 2=Float, 3=Bool, 4=Str, 5=Zero, 6=Array, 7=Tuple, 8=Struct."""
        match self.terminator:
            case MirTerminator.Ret(value):
                if value != nil:
                    val payload: MirOperand = value ?? mir_operand_const_int(0)
                    match payload.kind:
                        case MirOperandKind.Const(const_value, _):
                            match const_value:
                                case MirConstValue.Int(_): 1
                                case MirConstValue.FloatLexeme(_): 2
                                case MirConstValue.Float(_): 2
                                case MirConstValue.Bool(_): 3
                                case MirConstValue.Str(_): 4
                                case MirConstValue.Zero: 5
                                case MirConstValue.Array(_): 6
                                case MirConstValue.Tuple(_): 7
                                case MirConstValue.Struct(_): 8
                        case MirOperandKind.Copy(_) | MirOperandKind.Move(_): 0
                else:
                    0
            case _: 0

    # @workaround bug=mir_ret_optional_operand_owner_2026_10_11 reason=preserve optional operand and enum owners through staged coalescing
    fn bootstrap_ret_const_scalar_text() -> text:
        match self.terminator:
            case MirTerminator.Ret(value):
                if value != nil:
                    val payload: MirOperand = value ?? mir_operand_const_int(0)
                    match payload.kind:
                        case MirOperandKind.Const(const_value, _):
                            match const_value:
                                case MirConstValue.Int(v): "{v}"
                                case MirConstValue.FloatLexeme(v): v
                                case MirConstValue.Float(v): "{v}"
                                case MirConstValue.Bool(v): if v: "1" else: "0"
                                case MirConstValue.Str(v): v
                                case MirConstValue.Zero: "0"
                                case MirConstValue.Array(_): "zeroinitializer"
                                case MirConstValue.Tuple(_): "zeroinitializer"
                                case MirConstValue.Struct(_): "zeroinitializer"
                        case MirOperandKind.Copy(_) | MirOperandKind.Move(_): "0"
                else:
                    "0"
            case _: "0"

# ==========================================================================
# MIR Module and Function (depend on MirBlock)
# ==========================================================================

struct MirFunction:
    """Function in MIR."""
    symbol: SymbolId
    name: text
    signature: MirSignature
    locals: [MirLocal]
    blocks: [MirBlock]
    entry_block: BlockId
    span: Span

    # Generic template metadata for .smf template storage
    generic_params: [text]
    is_generic_template: bool
    specialization_of: text?
    type_bindings: Dict<text, HirType>

    # Layout optimization metadata for native binary compilation
    layout_phase: LayoutPhase?

    # GPU kernel flag - set when function has @gpu_kernel decorator
    is_kernel: bool
    gpu_target: text
    gpu_backend_order: text

    # C ABI export flag - set when function has @export("C") attribute
    is_export_c: bool
    export_name: text    # Custom C symbol name, empty = use default

    # Driver manifest attribute - set when function has @driver/@native_lib
    # # DESUGARED: driver_manifest_attr: DriverManifestAttr
    has_driver_manifest_attr: bool
    driver_manifest_attr: DriverManifestAttr

    # VHDL hardware metadata - set from @hardware/@generic/@clocked attributes
    # # DESUGARED: vhdl_metadata: VhdlHardwareMetadata
    has_vhdl_metadata: bool
    vhdl_metadata: VhdlHardwareMetadata

    # Fast-math permission flag — set by frontend when parsing #[fast_math] or
    # --ffast-math equivalent.  Default false (IEEE-strict).
    # When false, the auto-vectorizer MUST refuse FP reductions (§8 failure mode F3).
    has_fast_math: bool

    # FPGA kernel performance attributes (W3.2) — threaded from @unroll/@pipeline/@memory decorators.
    # 0 = absent/default (no attribute applied).
    unroll_factor: i64      # @unroll(n) structural unroll count
    pipeline_ii: i64        # @pipeline(n)/@pipeline(ii=n) initiation interval
    memory_banks: i64       # @memory(n)/@memory(banks=n) port banking count
    verification_contract: HirContractBlock?

    # Asm-embedding contract (doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md A.2)
    # threaded from @naked/@section/@align/@global. Defaults keep every
    # existing MirFunction constructor valid.
    is_naked: bool = false       # emit `naked noinline`, body = one raw asm block, `unreachable` terminator
    section: text = ""           # `section "<name>"` on the define; "" = target default
    align: i64 = 0               # `align <n>` on the define; 0 = target default
    is_global: bool = false      # unmangled symbol, external linkage

    # SIMD optimization requirement transport (@must/@prefer/@error_not/@warn_not).
    # Parsed into OptimizationReq by 00.common/_Attributes/decl_attrs.spl and
    # threaded here so the auto-vectorizer can actually enforce the tag instead
    # of ignoring it. Empty strings mean "no requirement"; defaults keep every
    # existing MirFunction constructor valid.
    simd_req_level: text = ""    # "" | must | prefer | error_not | warn_not
    simd_req_backend: text = ""  # "" | simd | avx2 | avx512 | sse | neon | ...
    simd_disabled: bool = false  # @simd(disable) — pass must not vectorize
    nogc_strict: bool = false
    short_call_contracts: Dict<text, [text]> = {}

    # Opt-in producer-owned semantic transport; ordinary lowering leaves empty.
    enum_matches: [MirEnumMatchSemanticV1] = []
    # Compiler-owned SOURCE specialization facts; never inferred from names.
    source_region_context_local_v1: i64 = -1
    source_region_context_abi_v1: i64 = 0
    source_region_closure_digest_v1: text = ""

impl MirFunction:
    # update field list when MirFunction gains fields — spread operator fails cross-module
    static fn with_blocks(func: MirFunction, new_blocks: [MirBlock]) -> MirFunction:
        MirFunction(
            symbol: func.symbol,
            name: func.name,
            signature: func.signature,
            locals: func.locals,
            blocks: new_blocks,
            entry_block: func.entry_block,
            span: func.span,
            generic_params: func.generic_params,
            is_generic_template: func.is_generic_template,
            specialization_of: func.specialization_of,
            type_bindings: func.type_bindings,
            layout_phase: func.layout_phase,
            is_kernel: func.is_kernel,
            gpu_target: func.gpu_target,
            gpu_backend_order: func.gpu_backend_order,
            is_export_c: func.is_export_c,
            export_name: func.export_name,
            has_driver_manifest_attr: func.has_driver_manifest_attr,
            driver_manifest_attr: func.driver_manifest_attr,
            has_vhdl_metadata: func.has_vhdl_metadata,
            vhdl_metadata: func.vhdl_metadata,
            has_fast_math: func.has_fast_math,
            unroll_factor: func.unroll_factor,
            pipeline_ii: func.pipeline_ii,
            memory_banks: func.memory_banks,
            verification_contract: func.verification_contract,
            is_naked: func.is_naked,
            section: func.section,
            align: func.align,
            is_global: func.is_global,
            simd_req_level: func.simd_req_level,
            simd_req_backend: func.simd_req_backend,
            simd_disabled: func.simd_disabled,
            # Preserve the original binding; changed bodies must fail consumer
            # validation until the producer's actual finalizer revalidates.
            enum_matches: func.enum_matches,
            source_region_context_local_v1: func.source_region_context_local_v1,
            source_region_context_abi_v1: func.source_region_context_abi_v1,
            source_region_closure_digest_v1: func.source_region_closure_digest_v1,
            nogc_strict: func.nogc_strict,
            short_call_contracts: func.short_call_contracts
        )

"""Function body wrapper for borrow checking."""
struct MirBody:
    name: text
    blocks: [MirBlock]
    locals: [MirLocal]
    arg_count: i64
    return_ty: MirType
    nogc_strict: bool = false
    short_call_contracts: Dict<text, [text]> = {}

impl MirBody:
    static fn from_bootstrap_parts(
        name: text,
        blocks: [MirBlock],
        locals: [MirLocal],
        arg_count: i64,
        nogc_strict: bool = false,
        short_call_contracts: Dict<text, [text]> = {}
    ) -> MirBody:
        """Create a flat-bootstrap body without crossing a MirType ABI."""
        MirBody(
            name: name,
            blocks: blocks,
            locals: locals,
            arg_count: arg_count,
            return_ty: MirType.unit(),
            nogc_strict: nogc_strict,
            short_call_contracts: short_call_contracts
        )

    static fn from_parts(
        name: text,
        blocks: [MirBlock],
        locals: [MirLocal],
        arg_count: i64,
        return_ty: MirType,
        nogc_strict: bool = false,
        short_call_contracts: Dict<text, [text]> = {}
    ) -> MirBody:
        """Create MirBody through its owner layout."""
        MirBody(
            name: name,
            blocks: blocks,
            locals: locals,
            arg_count: arg_count,
            return_ty: return_ty,
            nogc_strict: nogc_strict,
            short_call_contracts: short_call_contracts
        )

    static fn from_function(func: MirFunction) -> MirBody:
        """Create MirBody from MirFunction for borrow checking."""
        MirBody(
            name: func.name,
            blocks: func.blocks,
            locals: func.locals,
            arg_count: func.signature.params.len(),
            return_ty: func.signature.return_type,
            nogc_strict: func.nogc_strict,
            short_call_contracts: func.short_call_contracts
        )

    me bootstrap_return_type() -> MirType:
        """Read the return type through the MirBody owner layout."""
        self.return_ty

# ============================================================================
# Constant Folding
# ============================================================================

fn mir_fold_binop(op: MirBinOp, left: MirConstValue, right: MirConstValue) -> MirConstValue?:
    match (left, right):
        case (MirConstValue.Int(l), MirConstValue.Int(r)):
            var has_result = true
            var result = 0
            match op:
                case Add: result = l + r
                case Sub: result = l - r
                case Mul: result = l * r
                case Div:
                    if r != 0:
                        result = l / r
                    else:
                        has_result = false
                case Rem:
                    if r != 0:
                        result = l % r
                    else:
                        has_result = false
                case Pow:
                    unsafe(capabilities: [ffi]):
                        result = __simple_pow(l, r)
                case BitAnd: result = l & r
                case BitOr: result = l | r
                case BitXor: result = l xor r
                case Shl: result = l << (r & 63)
                case Shr: result = l >> (r & 63)
                case Eq: result = if l == r: 1 else: 0
                case Ne: result = if l != r: 1 else: 0
                case Lt: result = if l < r: 1 else: 0
                case Le: result = if l <= r: 1 else: 0
                case Gt: result = if l > r: 1 else: 0
                case Ge: result = if l >= r: 1 else: 0
                case _: has_result = false
            if not has_result:
                return nil
            Some(MirConstValue.Int(result))

        case (MirConstValue.Float(l), MirConstValue.Float(r)):
            var has_result = true
            var result = 0.0
            match op:
                case Add: result = l + r
                case Sub: result = l - r
                case Mul: result = l * r
                case Div:
                    if r != 0.0:
                        result = l / r
                    else:
                        has_result = false
                case Pow: result = math_pow(l, r)
                case _: has_result = false
            if not has_result:
                return nil
            Some(MirConstValue.Float(result))

        case _:
            nil

# Canonical emission order for module contents. On the native runtime,
# Dict<SymbolId, _> iterates in key-ADDRESS hash order (rt_core_dict_hash
# falls back to the pointer word for heap keys), so emission order permuted
# between identical native-build runs: four byte-identical planner builds of
# the same source/cache produced four distinct binaries with the module's
# functions laid out in different orders (2026-10-19, release_phase3 stage2
# planner admission). Sort by name so emitted bytes are reproducible; the
# symbol id breaks the (impossible for valid MIR) same-name tie.
pub fn mir_module_functions_sorted(module: MirModule) -> [MirFunction]:
    var ids: [i64] = []
    var funcs: [MirFunction] = []
    for symbol in module.functions.keys():
        ids = ids.push(symbol.id)
        funcs = funcs.push(module.functions[symbol])
    var i = 0
    while i < funcs.len():
        var j = i + 1
        while j < funcs.len():
            if funcs[j].name < funcs[i].name or
                    (funcs[j].name == funcs[i].name and ids[j] < ids[i]):
                val tmp_fn = funcs[i]
                funcs[i] = funcs[j]
                funcs[j] = tmp_fn
                val tmp_id = ids[i]
                ids[i] = ids[j]
                ids[j] = tmp_id
            j = j + 1
        i = i + 1
    funcs

pub fn mir_module_statics_sorted(module: MirModule) -> [MirStatic]:
    var ids: [i64] = []
    var statics: [MirStatic] = []
    for symbol in module.statics.keys():
        ids = ids.push(symbol.id)
        statics = statics.push(module.statics[symbol])
    var i = 0
    while i < statics.len():
        var j = i + 1
        while j < statics.len():
            if statics[j].name < statics[i].name or
                    (statics[j].name == statics[i].name and ids[j] < ids[i]):
                val tmp_static = statics[i]
                statics[i] = statics[j]
                statics[j] = tmp_static
                val tmp_id = ids[i]
                ids[i] = ids[j]
                ids[j] = tmp_id
            j = j + 1
        i = i + 1
    statics

# Keep MirModule last.  The bootstrap parser currently leaves declaration
# parsing in expression mode after generic Dict fields, which corrupts the
# declaration immediately following the struct.
struct MirModule:
    """Complete MIR module."""
    name: text
    functions: Dict<SymbolId, MirFunction>
    statics: Dict<SymbolId, MirStatic>
    constants: Dict<SymbolId, MirConstant>
    types: Dict<SymbolId, MirTypeDef>
    external_layout_traces: [MirExternalLayoutTraceV1] = []
    collection_plan_explanations: [text] = []
    enum_semantic_declarations: [MirEnumDeclarationIdentityV1] = []
    source_region_context_symbol_v1: i64 = -1
    source_region_closure_digest_v1: text = ""

export MirInst, MirBlock, MirFunction, MirBody, MirModule, mir_fold_binop
export mir_module_functions_sorted, mir_module_statics_sorted
