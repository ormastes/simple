# Canonical native trait metadata. All retained HirTypes use the consumer's
# symbol table; provider-local SymbolIds must not escape registration.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*

struct NativeTraitMethodSlot:
    name: text
    params: [HirType]
    parameter_names: [text]
    parameter_mutability: [bool]
    result: HirType
    mutable_receiver: bool

struct NativeTraitLayout:
    owner: text
    methods: [NativeTraitMethodSlot]
    object_safe: bool

struct NativeTraitImplementation:
    trait_owner: text
    concrete_owner: text
    methods: [text]
    concrete_type: HirType
    concrete_name: text
    reference_semantics: bool
    signatures: [NativeTraitMethodSlot]

fn native_trait_slot_index(layout: NativeTraitLayout, name: text) -> i64:
    var index = 0
    while index < layout.methods.len():
        if layout.methods[index].name == name: return index
        index = index + 1
    -1

fn native_trait_sorted_method_names(trait_decl: HirTrait) -> [text]:
    # Stable across declaration order and independent module compilation.
    var names: [text] = []
    for method in trait_decl.methods:
        if not names.contains(method.name): names.push(method.name)
    for method in trait_decl.defaults:
        if not names.contains(method.name): names.push(method.name)
    var index = 1
    while index < names.len():
        val name = names[index]
        var position = index
        while position > 0 and names[position - 1] > name:
            names[position] = names[position - 1]
            position = position - 1
        names[position] = name
        index = index + 1
    names
