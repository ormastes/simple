# Pure alpha conversion, never an allocation/epoch/retention receipt.
use compiler.mir.mir_data.*
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.source_region_operation_plan_types_v1.*
use compiler.mir.source_region_dictionary_site_types_v1.*
use compiler.mir.source_region_instruction_rebase_types_v1.*
use compiler.mir.source_region_request_budget_v1.{SourceRegionRequestBudgetV1}
use compiler.mir.source_region_request_type_check_v1.{source_request_types_same_v1}
use compiler.mir.canonical_enum_serialization_budget_v1.*
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1}

fn source_rebase_local_v1(local: LocalId, bindings: [SourceRegionPlanLocalBindingV1],
        budget: SourceRegionRequestBudgetV1) -> Result<SourceRegionPlanLocalBindingV1, text>:
    budget.rows(bindings.len(), 0, 0)?
    for binding in bindings:
        if binding.planned.id == local.id: return Ok(binding)
    Err("SOURCE-REBASE: local lacks typed origin binding")

fn source_rebase_operand_v1(operand: MirOperand, bindings: [SourceRegionPlanLocalBindingV1],
        budget: SourceRegionRequestBudgetV1) -> Result<MirOperand, text>:
    budget.charge(1, 4, 32)?
    match operand.kind:
        case MirOperandKind.Const(_, _): Ok(operand)
        case MirOperandKind.Copy(local):
            val binding = source_rebase_local_v1(local, bindings, budget)?
            Ok(MirOperand(kind: MirOperandKind.Copy(binding.actual)))
        case MirOperandKind.Move(local):
            val binding = source_rebase_local_v1(local, bindings, budget)?
            Ok(MirOperand(kind: MirOperandKind.Move(binding.actual)))

fn source_rebase_operands_v1(operands: [MirOperand], bindings: [SourceRegionPlanLocalBindingV1],
        budget: SourceRegionRequestBudgetV1) -> Result<[MirOperand], text>:
    val growth = canonical_enum_product_v1(canonical_enum_sum_v1(operands.len(), 1)?, canonical_enum_sum_v1(operands.len(), 1)?)?
    budget.rows(growth, 4, 32)?
    var result: [MirOperand] = []
    for operand in operands: result.push(source_rebase_operand_v1(operand, bindings, budget)?)
    Ok(result)

fn source_rebase_instruction_v1(instruction: MirInst, bindings: [SourceRegionPlanLocalBindingV1],
        budget: SourceRegionRequestBudgetV1) -> Result<MirInst, text>:
    budget.charge(1, 16, 128)?
    val kind = match instruction.kind:
        case MirInstKind.Copy(destination, source) | MirInstKind.Move(destination, source):
            val dest = source_rebase_local_v1(destination, bindings, budget)?
            val value = source_rebase_local_v1(source, bindings, budget)?
            if not source_request_types_same_v1(dest.type_, value.type_, budget)?:
                return Err("SOURCE-REBASE: copy/move type differs")
            match instruction.kind:
                case MirInstKind.Copy(_, _): MirInstKind.Copy(dest.actual, value.actual)
                case _: MirInstKind.Move(dest.actual, value.actual)
        case MirInstKind.Cast(destination, value, target) | MirInstKind.Bitcast(destination, value, target):
            val dest = source_rebase_local_v1(destination, bindings, budget)?
            if not source_request_types_same_v1(dest.type_, target, budget)?:
                return Err("SOURCE-REBASE: cast destination recipe differs")
            val operand = source_rebase_operand_v1(value, bindings, budget)?
            match instruction.kind:
                case MirInstKind.Cast(_, _, _): MirInstKind.Cast(dest.actual, operand, target)
                case _: MirInstKind.Bitcast(dest.actual, operand, target)
        case MirInstKind.Intrinsic(destination, name, operands):
            canonical_enum_charge_v1(budget.account, canonical_enum_text_bound_v1(name, budget.account)?, 0, 0)?
            var target: LocalId? = nil
            if val local = destination: target = Some(source_rebase_local_v1(local, bindings, budget)?.actual)
            MirInstKind.Intrinsic(target, name, source_rebase_operands_v1(operands, bindings, budget)?)
        case _: return Err("SOURCE-REBASE: unknown instruction or block-bearing plan variant")
    Ok(MirInst(kind: kind, span: instruction.span))

fn source_rebase_instructions_v1(instructions: [MirInst], bindings: [SourceRegionPlanLocalBindingV1],
        budget: SourceRegionRequestBudgetV1) -> Result<[MirInst], text>:
    val extent = canonical_enum_sum_v1(instructions.len(), 1)?
    budget.rows(canonical_enum_product_v1(extent, extent)?, 16, 128)?
    var result: [MirInst] = []
    for instruction in instructions: result.push(source_rebase_instruction_v1(instruction, bindings, budget)?)
    Ok(result)

# Stable locals are the owning original signature/body locals plus hidden context.
# Caller binds that exact source frame; this helper validates the concrete types.
# Prior bindings are retained only after caller's actual new_local checks.
fn source_region_instruction_plan_rebase_v1(plan: SourceRegionInstructionPlanV1,
        stable_locals: [MirLocal], prior: [SourceRegionPlanLocalBindingV1], actual_locals: [MirLocal],
        fresh_base: i64, account: MirLoopResourceAccountV1) -> Result<SourceRegionInstructionRebaseV1, text>:
    val budget = SourceRegionRequestBudgetV1.begin(account)?
    if fresh_base < 0 or fresh_base != actual_locals.len():
        return Err("SOURCE-REBASE: actual allocator base differs")
    val old_base = canonical_enum_sum_v1(stable_locals.len(), prior.len())?
    val old_end = canonical_enum_sum_v1(old_base, plan.locals.len())?
    val actual_end = canonical_enum_sum_v1(fresh_base, plan.locals.len())?
    if actual_end > account.limits().max_locals or old_end > account.limits().max_locals:
        return Err("SOURCE-REBASE: local capacity")
    if plan.next_local != old_end: return Err("SOURCE-REBASE: noncontiguous planned allocator recipe")
    val count = canonical_enum_sum_v1(old_end, 1)?
    budget.rows(canonical_enum_product_v1(count, count)?, 32, 256, 8)?
    budget.rows(actual_locals.len(), 0, 0)?
    for index in 0..actual_locals.len():
        if actual_locals[index].id.id != index: return Err("SOURCE-REBASE: actual local index identity differs")
    var bindings: [SourceRegionPlanLocalBindingV1] = []
    for index in 0..stable_locals.len():
        val stable = stable_locals[index]
        if stable.id.id != index or index >= actual_locals.len():
            return Err("SOURCE-REBASE: stable identity differs")
        val actual = actual_locals[index]
        if stable.kind != actual.kind or stable.is_ghost != actual.is_ghost or not source_request_types_same_v1(stable.type_, actual.type_, budget)?:
            return Err("SOURCE-REBASE: stable local signature/type differs")
        bindings.push(SourceRegionPlanLocalBindingV1(planned: stable.id, actual: actual.id, type_: stable.type_))
    for index in 0..prior.len():
        val binding = prior[index]
        if binding.planned.id != stable_locals.len() + index or binding.actual.id < stable_locals.len() or binding.actual.id >= fresh_base:
            return Err("SOURCE-REBASE: retained binding origin differs")
        for previous in bindings:
            if previous.actual.id == binding.actual.id: return Err("SOURCE-REBASE: retained actual alias")
        if actual_locals[binding.actual.id].kind != LocalKind.Temp or actual_locals[binding.actual.id].is_ghost:
            return Err("SOURCE-REBASE: retained actual is not an ordinary temporary")
        if not source_request_types_same_v1(binding.type_, actual_locals[binding.actual.id].type_, budget)?:
            return Err("SOURCE-REBASE: retained actual type differs")
        bindings.push(binding)
    var locals: [MirLocal] = []
    var retained: [SourceRegionPlanLocalBindingV1] = []
    for binding in prior: retained.push(binding)
    for index in 0..plan.locals.len():
        val recipe = plan.locals[index]
        if recipe.id.id != old_base + index or recipe.kind != LocalKind.Temp or recipe.is_ghost or recipe.name != nil:
            return Err("SOURCE-REBASE: fresh recipe identity/kind differs")
        val actual = LocalId(id: fresh_base + index)
        val binding = SourceRegionPlanLocalBindingV1(planned: recipe.id, actual: actual, type_: recipe.type_)
        bindings.push(binding)
        retained.push(binding)
        locals.push(MirLocal(id: actual, name: recipe.name, type_: recipe.type_, kind: recipe.kind, is_ghost: recipe.is_ghost))
    val steps_extent = canonical_enum_sum_v1(plan.steps.len(), 1)?
    budget.rows(canonical_enum_product_v1(steps_extent, steps_extent)?, 32, 256)?
    var steps: [SourceRegionOperationPlanV1] = []
    for step in plan.steps:
        if step.dictionary_read != nil: return Err("SOURCE-REBASE: read requires live epoch-finalized owner path")
        var destination: LocalId? = nil
        if val local = step.destination: destination = Some(source_rebase_local_v1(local, bindings, budget)?.actual)
        steps.push(SourceRegionOperationPlanV1(
            prelude: source_rebase_instructions_v1(step.prelude, bindings, budget)?,
            facade: source_rebase_operand_v1(step.facade, bindings, budget)?,
            args: source_rebase_operands_v1(step.args, bindings, budget)?, result_type: step.result_type,
            destination: destination, success: source_rebase_instructions_v1(step.success, bindings, budget)?,
            success_type: step.success_type, callee_symbol: step.callee_symbol))
    val rebased = SourceRegionInstructionPlanV1(steps: steps, locals: locals, next_local: actual_end)
    Ok(SourceRegionInstructionRebaseV1(plan: rebased, bindings: retained, next_local: actual_end))

# Structural validation ONLY after the live owner materializer returns. The
# owner must retain/revalidate the actual epoch authority and site relationship;
# neither this function nor its returned metadata creates that authority.
fn source_rebase_span_bound_v1(span: Span,
        budget: SourceRegionRequestBudgetV1) -> Result<(), text>:
    # Structural equality visits the fixed scalar fields and the filename too.
    # Missing spans are valid for synthesized recipes and structural fixtures.
    budget.charge(8)?
    if span == nil: return Ok(())
    budget.charge(canonical_enum_text_bound_v1(span.file, budget.account)?)

fn source_rebase_read_hir_v1(type_: HirType,
        budget: SourceRegionRequestBudgetV1) -> Result<(), text>:
    source_rebase_span_bound_v1(type_.span, budget)?
    match type_.kind:
        case HirTypeKind.Int(64, true): Ok(())
        case HirTypeKind.Named(owner, arguments):
            if owner.id < 0 or arguments.len() != 0: return Err("SOURCE-REBASE: generic/invalid dictionary value recipe")
            Ok(())
        case _: Err("SOURCE-REBASE: unsupported nested dictionary recipe")

fn source_rebase_read_step_bound_v1(step: SourceRegionOperationPlanV1,
        budget: SourceRegionRequestBudgetV1) -> Result<(), text>:
    budget.charge(64)?
    if step.dictionary_read == nil: return Err("SOURCE-REBASE: missing finalized read site")
    val site = step.dictionary_read.unwrap()
    source_rebase_read_hir_v1(site.key_type, budget)?
    source_rebase_read_hir_v1(site.value_type, budget)?
    source_rebase_read_hir_v1(site.descriptor.key_type, budget)?
    source_rebase_read_hir_v1(site.descriptor.value_type, budget)?
    if step.success_type == nil: return Err("SOURCE-REBASE: missing read success codec")
    val success = step.success_type.unwrap()
    source_rebase_span_bound_v1(success.span, budget)?
    match success.kind:
        case HirTypeKind.Optional(inner):
            source_rebase_span_bound_v1(inner.span, budget)?
            match inner.kind:
                case HirTypeKind.Int(64, true): ()
                case _: return Err("SOURCE-REBASE: read success codec differs")
        case _: return Err("SOURCE-REBASE: read success codec differs")
    val identity = canonical_enum_text_bound_v1(site.descriptor.value_layout_identity, budget.account)?
    val layout = canonical_enum_text_bound_v1(site.descriptor.value_layout_digest, budget.account)?
    budget.charge(canonical_enum_sum_v1(identity, layout)?)?
    if val span = site.emitted.span: source_rebase_span_bound_v1(span, budget)?
    match site.emitted.kind:
        case MirInstKind.Intrinsic(_, name, operands):
            budget.charge(canonical_enum_text_bound_v1(name, budget.account)?)?
            for operand in operands: budget.charge(canonical_enum_operand_bound_v1(operand, budget.account)?)?
        case _: return Err("SOURCE-REBASE: read source opcode differs")
    for operand in step.args: budget.charge(canonical_enum_operand_bound_v1(operand, budget.account)?)?
    budget.charge(canonical_enum_operand_bound_v1(step.facade, budget.account)?)?
    Ok(())

fn source_region_dictionary_read_plan_identity_v1(plan: SourceRegionInstructionPlanV1,
        expected: SourceRegionOperationPlanV1, actual_locals: [MirLocal], fresh_base: i64,
        account: MirLoopResourceAccountV1) -> Result<SourceRegionInstructionRebaseV1, text>:
    val budget = SourceRegionRequestBudgetV1.begin(account)?
    if expected.dictionary_read == nil or plan.steps.len() != 1 or plan.locals.len() != 0:
        return Err("SOURCE-REBASE: unresolved or malformed live read plan")
    val step = plan.steps[0]
    source_rebase_read_step_bound_v1(step, budget)?
    source_rebase_read_step_bound_v1(expected, budget)?
    val site = step.dictionary_read.unwrap()
    if site.operation != SourceRegionDictionaryOperationV1.Read or site.key_codec != SourceRegionDictionaryCodecV1.RawI64 or site.descriptor.value_codec != SourceRegionDictionaryCodecV1.OrdinaryStruct:
        return Err("SOURCE-REBASE: read dictionary recipe differs")
    match site.key_type.kind:
        case HirTypeKind.Int(64, true): ()
        case _: return Err("SOURCE-REBASE: read key is not exact i64")
    match site.value_type.kind:
        case HirTypeKind.Named(owner, arguments):
            if owner.id < 0 or arguments.len() != 0: return Err("SOURCE-REBASE: generic/invalid read value owner")
            if owner.id != site.descriptor.value_owner.id: return Err("SOURCE-REBASE: read value owner differs")
        case _: return Err("SOURCE-REBASE: read value is not exact Struct")
    if site.key_type != site.descriptor.key_type or site.value_type != site.descriptor.value_type:
        return Err("SOURCE-REBASE: read descriptor type recipe differs")

    if step.dictionary_read != expected.dictionary_read or step.callee_symbol != expected.callee_symbol or step.success_type != expected.success_type:
        return Err("SOURCE-REBASE: live read site/codec/target differs")
    if step.prelude.len() != 0 or step.success.len() != 0 or step.args.len() != 4 or expected.args.len() != 4:
        return Err("SOURCE-REBASE: live read operation shape differs")
    val key = site.key_local ?? LocalId(id: -1)
    if step.args[2] != mir_operand_copy(site.dictionary_local) or step.args[3] != mir_operand_copy(key) or step.destination != site.result_local:
        return Err("SOURCE-REBASE: read dictionary/key/result relationship differs")
    match step.args[1].kind:
        case MirOperandKind.Copy(epoch):
            if epoch.id < 0 or epoch.id >= actual_locals.len() or actual_locals[epoch.id].type_.kind != MirTypeKind.I64:
                return Err("SOURCE-REBASE: read epoch is not an actual i64 local")
        case _: return Err("SOURCE-REBASE: read epoch lacks actual local binding")
    if step.facade != expected.facade or step.args != expected.args or step.destination != expected.destination:
        return Err("SOURCE-REBASE: live read operand relationship differs")
    if not source_request_types_same_v1(step.result_type, expected.result_type, budget)?:
        return Err("SOURCE-REBASE: live read result type differs")
    # Clear only the already-compared site in a local copy to reuse the same
    # local/type validator. No authority metadata is dropped from the result.
    budget.rows(2, 32, 256)?
    var plain_step = step
    plain_step.dictionary_read = nil
    var plain = plan
    plain.steps = [plain_step]
    var validated = source_region_instruction_plan_rebase_v1(plain, actual_locals, [], actual_locals, fresh_base, account)?
    validated.plan.steps = [step]
    Ok(validated)
