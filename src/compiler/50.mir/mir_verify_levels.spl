# MIR verifier rule registry projection and level resolution.
#
# Kept free of every MIR data import so both the verifier (`mir_verify.spl`)
# and MIR lowering (the two lowering advisories below) can read one resolved
# level table without an import cycle.
#
# SIMPLE_MIR_VERIFY_LEVELS="MIRV-002=error,MIRV-005e=off,*=warning"
#   configurable levels: error (fatal, aborts before codegen) | warning | off
#   MIRV-001n is a structural missing-carrier error and always remains fatal.
#   `*`    : level for every id not named explicitly (MIRV rules AND the two
#            lowering advisories).
# The spec is parsed ONCE per run (`mir_verify_levels_from_env`), never per
# finding. A malformed entry, an unknown level or an unknown id REJECTS THE
# WHOLE SPEC: every id keeps its registry default and `config_error` names
# the offending entry, which the driver reports as a build error. A typo such
# as `MIRV-002=eror,*=off` therefore never resolves MIRV-002 to `off`.

use std.nogc_sync_mut.io.env_ops.{env_get}

struct MirVerifyRule:
    id: text
    family: text
    lifecycle: text              # registry default: "warning" | "error"
    promotion_candidate: bool    # zero hits so far; eligible for "error" after a full-closure zero-hit run

# Keep in sync with config/compiler/mir_verify_rules.sdn (pinned by spec).
# Configurable rules retain their warn-first lifecycle. MIRV-001n is a
# mandatory structural error: missing type carriers cannot reach codegen.
# Promotion to `error` happens per rule, in the registry, only after a
# phase-3 + phase-4 full-closure run shows zero hits for that rule.
fn mir_verify_rules() -> [MirVerifyRule]:
    [
        MirVerifyRule(id: "MIRV-001", family: "unresolved_type", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-001n", family: "missing_type_declaration", lifecycle: "error", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-002", family: "illegal_cast", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-002b", family: "bitcast_width", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-003", family: "unit_static", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-003b", family: "unit_stored_local", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-004", family: "call_generic_template", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-004b", family: "call_arity", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-004c", family: "call_arg_type", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-004d", family: "call_abi_kind", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-005", family: "cfg_structure", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-005b", family: "use_undeclared_local", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-005c", family: "unused_condition", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-005d", family: "invalid_variant", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-005e", family: "local_never_defined", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-006", family: "field_out_of_layout", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-006b", family: "layout_owner_unresolved", lifecycle: "warning", promotion_candidate: false),
        MirVerifyRule(id: "MIRV-007", family: "duplicate_symbol", lifecycle: "warning", promotion_candidate: true),
        MirVerifyRule(id: "MIRV-007b", family: "static_initializer_type", lifecycle: "warning", promotion_candidate: false)
    ]

fn mir_verify_rule_lifecycle(rule_id: text) -> text:
    """Registry default for a rule ('' = unregistered)."""
    for rule in mir_verify_rules():
        if rule.id == rule_id:
            return rule.lifecycle
    ""

# The two MIR LOWERING advisories that share this level switch. They are not
# verifier rules: lowering records them in `MirLowering.mir_advisories` (never
# in `MirLowering.errors`) at their default level `warning`.
fn mir_lowering_advisory_ids() -> [text]:
    ["E-MIR-TYPE-Error", "E-MIR-MATCH-GUARD"]

# Per-build cap on WARNING lines per rule / advisory id; the rest are counted
# and reported in one summary line per id. Errors are never capped.
fn mir_verify_warning_cap() -> i64:
    10

struct MirVerifyLevels:
    levels: Dict<text, text>   # every registered rule id + advisory id -> level
    config_error: text         # "" = spec accepted
    verifier_off: bool         # false while a mandatory structural rule is registered

impl MirVerifyLevels:
    fn level_of(id: text) -> text:
        """Resolved level. An unregistered id is a programming error in the
        caller and reports loudly as `error`."""
        if mir_verify_rule_is_mandatory_v1(id): return "error"
        self.levels[id] ?? "error"

fn mir_verify_rule_is_mandatory_v1(id: text) -> bool:
    # A missing type carrier cannot be inspected safely by a backend. This is
    # structural integrity, not the warn-first unresolved-type policy.
    id == "MIRV-001n"

fn mir_verify_levels_from_spec(spec: text) -> MirVerifyLevels:
    var ids: [text] = []
    var levels: Dict<text, text> = {}
    var rule_count = 0
    for rule in mir_verify_rules():
        ids = ids.push(rule.id)
        levels[rule.id] = rule.lifecycle
        rule_count = rule_count + 1
    for advisory_id in mir_lowering_advisory_ids():
        ids = ids.push(advisory_id)
        levels[advisory_id] = "warning"
    var config_error = ""
    var wildcard = ""
    var named_keys: [text] = []
    var named_values: [text] = []
    for item in spec.split(","):
        val entry = item.trim()
        if entry == "" or config_error != "":
            continue
        val eq = entry.index_of("=") ?? -1
        if eq <= 0:
            config_error = "entry '{entry}' is not <rule-id>=<level>"
            continue
        val key = entry.substring(0, eq).trim()
        val value = entry.substring(eq + 1).trim().lower()
        if value != "error" and value != "warning" and value != "off":
            config_error = "entry '{entry}' has unknown level '{value}' (expected error|warning|off)"
            continue
        if key == "*":
            wildcard = value
        elif levels.has(key):
            named_keys = named_keys.push(key)
            named_values = named_values.push(value)
        else:
            config_error = "entry '{entry}' names unknown rule id '{key}'"
    if config_error == "":
        if wildcard != "":
            for id in ids:
                levels[id] = wildcard
        var n = 0
        while n < named_keys.len():
            levels[named_keys[n]] = named_values[n]
            n = n + 1
    # Even `*=off` must walk modules to find missing type carriers.
    levels["MIRV-001n"] = "error"
    var verifier_off = true
    var r = 0
    while r < rule_count:
        if (levels[ids[r]] ?? "error") != "off":
            verifier_off = false
        r = r + 1
    MirVerifyLevels(levels: levels, config_error: config_error, verifier_off: verifier_off)

fn mir_verify_levels_from_env() -> MirVerifyLevels:
    """Resolve SIMPLE_MIR_VERIFY_LEVELS once. Callers hold the result for the
    whole run; do not call this per finding."""
    mir_verify_levels_from_spec(env_get("SIMPLE_MIR_VERIFY_LEVELS"))

fn mir_verify_rule_level_from_spec(rule_id: text, spec: text) -> text:
    mir_verify_levels_from_spec(spec).level_of(rule_id)

fn mir_verify_rule_level(rule_id: text) -> text:
    """One-off lookup (specs, single findings). Hot loops resolve a
    `MirVerifyLevels` once instead."""
    mir_verify_levels_from_env().level_of(rule_id)

export MirVerifyRule, MirVerifyLevels
export mir_verify_rules, mir_verify_rule_lifecycle, mir_lowering_advisory_ids, mir_verify_warning_cap
export mir_verify_levels_from_spec, mir_verify_levels_from_env
export mir_verify_rule_level_from_spec, mir_verify_rule_level
export mir_verify_rule_is_mandatory_v1
