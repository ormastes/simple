# Resident MIR declaration roots have no ordinary function/trait method bodies.
# Defaults and initializers are references to exact final-stage byte artifacts.
use compiler.hir.hir_types.{HirModule, HirType, SymbolId, SymbolTable, Effect, SymbolKind}
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr, ExportAttr}
use compiler.types.type_layout.{LayoutAttr, FieldLayout, compute_struct_layout, layoutattr_default_}
use compiler.mir.hir_expression_artifact_v1.*
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.hir.hir_symbol_table_methods.*
use compiler.hir.generated.hir_codec.*
use compiler.mir._MirLowering.module_lowering.{runtime_module_initializers_in_declaration_order}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

use compiler.mir.hir_declaration_binding_contract_v1.{mir_hir_callable_record_binding_valid_v1}

# Itemized for THIS module's own body: 'export use ... .*' re-exports the
# names to importers but does not import them into this module's scope, so
# every carrier literal below (MirHirParamDeclarationV1(symbol: ...), ...)
# resolved to ANY under the seed and failed importing modules with "struct
# 'ANY' field 'symbol'".
use compiler.mir.hir_declaration_types_v1.{MirHirParamDeclarationV1, MirHirFunctionDeclarationV1,
    MirHirFieldDeclarationV1, MirHirNominalDeclarationV1, MirHirVariantDeclarationV1,
    MirHirEnumDeclarationV1, MirHirTraitDeclarationV1, MirHirGlobalDeclarationV1,
    MirHirDeclarationSourceV1, MirHirModuleDeclarationsV1, MirHirDeclarationRepositoryV1,
    MirHirCallableDefaultsV1}
export use compiler.mir.hir_declaration_types_v1.*
export use compiler.mir.hir_declaration_codec_v1.*

fn mir_hir_nominal_layout_digest_v1(fields: [HirField], attr: LayoutAttr) -> text:
    # Same real layout producer/identity rows as MirLowering's legacy prescan.
    val layout = compute_struct_layout(fields, attr)
    var rows: [text] = ["size={layout.size};align={layout.align};stride={layout.stride}"]
    for raw_field in layout.fields:
        val field: FieldLayout = raw_field
        rows.push("field={field.name};offset={field.offset};size={field.size};align={field.align};bits={field.has_bits};width={field.bits_width};bit_offset={field.bit_offset}")
    sha256_text(rows.join("\n"))

fn mir_hir_project_parameter_in_owned_scope_v1(context: HirOwnedArtifactContextV1, module: HirModule, authority: text,
        key: text, digest: text, function: HirFunction, index: i64) -> Result<MirHirParamDeclarationV1, text>:
    val param: HirParam = function.params[index]
    var artifact: MirHirExpressionArtifactV1? = nil
    if param.has_default:
        val stored = mir_hir_expression_store_in_owned_scope_v1(context, authority, key, digest,
            module.name, module.path, "parameter-default", function.symbol.id, index,
            param.name, param.default)
        if stored.is_err(): return Err(stored.unwrap_err())
        artifact = Some(stored.unwrap())
    Ok(MirHirParamDeclarationV1(symbol: param.symbol, name: param.name,
        type_: param.type_, has_default: param.has_default, default_artifact: artifact,
        span: param.span, is_mutable: param.is_mutable))

fn mir_hir_project_function_in_owned_scope_v1(context: HirOwnedArtifactContextV1, module: HirModule, authority: text,
        key: text, digest: text, function: HirFunction) -> Result<MirHirFunctionDeclarationV1, text>:
    val function_digest = mono_complete_function_digest_v1(function)
    if function_digest == "": return Err("MIR complete function identity could not be encoded")
    var params: [MirHirParamDeclarationV1] = []
    var index = 0
    while index < function.params.len():
        val projected = mir_hir_project_parameter_in_owned_scope_v1(context, module, authority,
            key, digest, function, index)
        if projected.is_err(): return Err(projected.unwrap_err())
        params.push(projected.unwrap())
        index = index + 1
    Ok(MirHirFunctionDeclarationV1(symbol: function.symbol, name: function.name,
        type_params: function.type_params, params: params, return_type: function.return_type,
        effects: function.effects, visibility: function.visibility, is_async: function.is_async,
        is_static: function.is_static, is_public: function.is_public, is_method: function.is_method,
        is_mutable: function.is_mutable, is_const: function.is_const, is_extern: function.is_extern,
        func_attr: function.func_attr, has_export_attr: function.has_export_attr,
        export_attr: function.export_attr, is_generic_template: function.is_generic_template,
        span: function.span, complete_function_digest: function_digest))

fn mir_hir_project_fields_in_owned_scope_v1(context: HirOwnedArtifactContextV1, module: HirModule, authority: text,
        key: text, digest: text, declaration_symbol: i64,
        fields: [HirField]) -> Result<[MirHirFieldDeclarationV1], text>:
    var projected: [MirHirFieldDeclarationV1] = []
    var index = 0
    while index < fields.len():
        val field: HirField = fields[index]
        var artifact: MirHirExpressionArtifactV1? = nil
        if field.has_default:
            val stored = mir_hir_expression_store_in_owned_scope_v1(context, authority, key, digest,
                module.name, module.path, "field-default", declaration_symbol, index,
                field.name, field.default)
            if stored.is_err(): return Err(stored.unwrap_err())
            artifact = Some(stored.unwrap())
        projected.push(MirHirFieldDeclarationV1(symbol: field.symbol, name: field.name,
            type_: field.type_, has_default: field.has_default, default_artifact: artifact,
            visibility: field.visibility, is_public: field.is_public, is_volatile: field.is_volatile,
            has_bits_attr: field.has_bits_attr, bits_width: field.bits_width,
            has_fixed_address: field.has_fixed_address, fixed_address: field.fixed_address,
            span: field.span))
        index = index + 1
    Ok(projected)

fn mir_hir_project_module_in_owned_scope_v1(context: HirOwnedArtifactContextV1, module: HirModule, authority: text,
        key: text, digest: text, source_binding: MirHirDeclarationSourceV1? = nil) -> Result<MirHirModuleDeclarationsV1, text>:
    # Only the final-reader caller supplies authority. Recheck the complete
    # decoded bytes before publishing any expression/declaration artifact.
    if transient_array_scope_state_v1() != 1 or not sha256_lower_hex_valid(authority) or
            not sha256_lower_hex_valid(key) or not sha256_lower_hex_valid(digest):
        return Err("MIR declaration projection lacks final-stage scope/authority")
    val complete = hir_module_encode(module)
    if complete == "" or sha256_text(complete) != digest:
        return Err("MIR declaration projection final body mismatch")
    var functions: [MirHirFunctionDeclarationV1] = []
    for raw_function in module.functions.values():
        val function: HirFunction = raw_function
        val projected = mir_hir_project_function_in_owned_scope_v1(context, module, authority, key, digest, function)
        if projected.is_err(): return Err(projected.unwrap_err())
        functions.push(projected.unwrap())
    var structs: [MirHirNominalDeclarationV1] = []
    for raw_struct in module.structs.values():
        val declaration: HirStruct = raw_struct
        val projected = mir_hir_project_fields_in_owned_scope_v1(context, module, authority, key, digest,
            declaration.symbol.id, declaration.fields)
        if projected.is_err(): return Err(projected.unwrap_err())
        structs.push(MirHirNominalDeclarationV1(symbol: declaration.symbol, name: declaration.name,
            kind: SymbolKind.Struct, type_params: declaration.type_params, fields: projected.unwrap(),
            methods: {}, has_layout_attr: declaration.has_layout_attr, layout_attr: declaration.layout_attr,
            layout_digest: mir_hir_nominal_layout_digest_v1(declaration.fields,
                if declaration.has_layout_attr: declaration.layout_attr else: layoutattr_default_()),
            has_export_attr: false, export_attr: nil, visibility: declaration.visibility,
            is_public: declaration.is_public, is_generic_template: declaration.is_generic_template,
            span: declaration.span))
    var classes: [MirHirNominalDeclarationV1] = []
    for raw_class in module.classes.values():
        val declaration: HirClass = raw_class
        val projected = mir_hir_project_fields_in_owned_scope_v1(context, module, authority, key, digest,
            declaration.symbol.id, declaration.fields)
        if projected.is_err(): return Err(projected.unwrap_err())
        val exported = if declaration.has_export_attr: Some(declaration.export_attr) else: nil
        classes.push(MirHirNominalDeclarationV1(symbol: declaration.symbol, name: declaration.name,
            kind: SymbolKind.Class, type_params: declaration.type_params, fields: projected.unwrap(),
            methods: declaration.methods, has_layout_attr: declaration.has_layout_attr,
            layout_attr: declaration.layout_attr,
            layout_digest: mir_hir_nominal_layout_digest_v1(declaration.fields,
                if declaration.has_layout_attr: declaration.layout_attr else: layoutattr_default_()),
            has_export_attr: declaration.has_export_attr,
            export_attr: exported, visibility: declaration.visibility, is_public: declaration.is_public,
            is_generic_template: declaration.is_generic_template, span: declaration.span))
    var enums: [MirHirEnumDeclarationV1] = []
    for raw_enum in module.enums.values():
        val declaration: HirEnum = raw_enum
        var variants: [MirHirVariantDeclarationV1] = []
        var variant_index = 0
        while variant_index < declaration.variants.len():
            val variant: HirVariant = declaration.variants[variant_index]
            var kind = "unit"
            var tuple_types: [HirType] = []
            var fields: [MirHirFieldDeclarationV1] = []
            match variant.kind:
                case HirVariantKind.Unit: ()
                case HirVariantKind.Tuple(types):
                    kind = "tuple"
                    tuple_types = types
                case HirVariantKind.Struct(original_fields):
                    kind = "struct"
                    val projected = mir_hir_project_fields_in_owned_scope_v1(context, module, authority, key,
                        digest, variant.symbol.id, original_fields)
                    if projected.is_err(): return Err(projected.unwrap_err())
                    fields = projected.unwrap()
                case _: return Err("MIR declaration enum payload kind is invalid")
            var discriminant: MirHirExpressionArtifactV1? = nil
            if variant.has_discriminant:
                val stored = mir_hir_expression_store_in_owned_scope_v1(context, authority, key, digest,
                    module.name, module.path, "enum-discriminant", declaration.symbol.id,
                    variant_index, variant.name, variant.discriminant)
                if stored.is_err(): return Err(stored.unwrap_err())
                discriminant = Some(stored.unwrap())
            variants.push(MirHirVariantDeclarationV1(symbol: variant.symbol, name: variant.name,
                kind: kind, tuple_types: tuple_types, fields: fields,
                has_discriminant: variant.has_discriminant, discriminant_artifact: discriminant,
                span: variant.span))
            variant_index = variant_index + 1
        enums.push(MirHirEnumDeclarationV1(symbol: declaration.symbol, name: declaration.name,
            runtime_name: declaration.runtime_name, type_params: declaration.type_params,
            variants: variants, attributes: declaration.attributes,
            complete_open: declaration.complete_open, dyn_open: declaration.dyn_open,
            visibility: declaration.visibility, is_public: declaration.is_public,
            is_generic_template: declaration.is_generic_template, span: declaration.span))
    var traits: [MirHirTraitDeclarationV1] = []
    for raw_trait in module.traits.values():
        val declaration: HirTrait = raw_trait
        var methods: [MirHirFunctionDeclarationV1] = []
        var defaults: [MirHirFunctionDeclarationV1] = []
        for raw_method in declaration.methods:
            val method: HirFunction = raw_method
            val projected = mir_hir_project_function_in_owned_scope_v1(context, module, authority, key, digest, method)
            if projected.is_err(): return Err(projected.unwrap_err())
            methods.push(projected.unwrap())
        for raw_method in declaration.defaults:
            val method: HirFunction = raw_method
            val projected = mir_hir_project_function_in_owned_scope_v1(context, module, authority, key, digest, method)
            if projected.is_err(): return Err(projected.unwrap_err())
            defaults.push(projected.unwrap())
        traits.push(MirHirTraitDeclarationV1(symbol: declaration.symbol, name: declaration.name,
            type_params: declaration.type_params, methods: methods, defaults: defaults,
            supertraits: declaration.supertraits, where_clause: declaration.where_clause,
            assoc_types: declaration.assoc_types, visibility: declaration.visibility,
            is_public: declaration.is_public, is_generic_template: declaration.is_generic_template,
            span: declaration.span))
    var globals: [MirHirGlobalDeclarationV1] = []
    val constants: [HirConst] = module.constants.values()
    var needs_initialization = runtime_module_initializers_in_declaration_order(constants).len() > 0
    for raw_constant in constants:
        val constant: HirConst = raw_constant
        val stored = mir_hir_expression_store_in_owned_scope_v1(context, authority, key, digest,
            module.name, module.path, "global-initializer", constant.symbol.id, 0,
            constant.name, constant.value)
        if stored.is_err(): return Err(stored.unwrap_err())
        globals.push(MirHirGlobalDeclarationV1(symbol: constant.symbol, name: constant.name,
            type_: constant.type_, initializer: stored.unwrap(), is_mutable: constant.is_mutable,
            visibility: constant.visibility, is_public: constant.is_public,
            is_volatile: constant.is_volatile, has_fixed_address: constant.has_fixed_address,
            fixed_address: constant.fixed_address, span: constant.span))
        if constant.is_mutable:
            match constant.value.kind:
                case HirExprKind.NamedVar(callable_id, _):
                    if val callable = module.symbols.get_symbol_raw(callable_id.id):
                        if callable.kind == SymbolKind.Function: needs_initialization = true
                case _: ()
    var result = MirHirModuleDeclarationsV1(name: module.name, path: module.path,
        final_repository_authority: authority, final_archive_key: key, final_body_digest: digest,
        symbols: module.symbols, functions: functions, structs: structs, classes: classes,
        enums: enums, bitfields: module.bitfields.values(), traits: traits, impls: module.impls,
        globals: globals, needs_initialization: needs_initialization, declaration_digest: "",
        stage: "mir-hir-module-declarations-v1", source_binding: source_binding)
    if not mir_hir_declaration_source_valid_v1(result):
        return Err("MIR declaration source-index provenance is malformed")
    val declaration_digest = mir_hir_module_declaration_digest_v1(result)
    if declaration_digest == "": return Err("MIR declaration digest could not be encoded")
    result.declaration_digest = declaration_digest
    Ok(result)

# Typed summary encoding also seals every mutable declaration/symbol root.

fn mir_hir_expression_selector_matches_v1(module: MirHirModuleDeclarationsV1,
        artifact: MirHirExpressionArtifactV1, category: text, symbol: i64,
        index: i64, name: text) -> bool:
    artifact.final_repository_authority == module.final_repository_authority and
        artifact.final_archive_key == module.final_archive_key and
        artifact.final_body_digest == module.final_body_digest and
        artifact.module_name == module.name and artifact.source_path == module.path and
        artifact.category == category and artifact.declaration_symbol == symbol and
        artifact.member_index == index and artifact.member_name == name and
        artifact.archive_key != "" and mir_hir_expression_key_v1(artifact) == artifact.archive_key

fn mir_hir_callable_defaults_valid_v1(module: MirHirModuleDeclarationsV1,
        function: MirHirFunctionDeclarationV1) -> bool:
    if not mir_hir_callable_record_binding_valid_v1(module, function): return false
    var index = 0
    while index < function.params.len():
        val param: MirHirParamDeclarationV1 = function.params[index]
        if param.has_default:
            if val artifact = param.default_artifact:
                if not mir_hir_expression_selector_matches_v1(module, artifact,
                        "parameter-default", function.symbol.id, index, param.name): return false
            else: return false
        elif param.default_artifact != nil: return false
        index = index + 1
    true

fn mir_hir_fields_valid_v1(module: MirHirModuleDeclarationsV1, symbol: i64,
        fields: [MirHirFieldDeclarationV1]) -> bool:
    var index = 0
    while index < fields.len():
        val field: MirHirFieldDeclarationV1 = fields[index]
        if field.has_default:
            if val artifact = field.default_artifact:
                if not mir_hir_expression_selector_matches_v1(module, artifact,
                        "field-default", symbol, index, field.name): return false
            else: return false
        elif field.default_artifact != nil: return false
        index = index + 1
    true

fn mir_hir_module_declarations_valid_v1(module: MirHirModuleDeclarationsV1) -> bool:
    if module.stage != "mir-hir-module-declarations-v1" or module.name == "" or module.path == "" or
            not mir_hir_declaration_source_valid_v1(module) or
            not sha256_lower_hex_valid(module.final_repository_authority) or
            not sha256_lower_hex_valid(module.final_archive_key) or
            not sha256_lower_hex_valid(module.final_body_digest) or
            module.declaration_digest == "" or
            mir_hir_module_declaration_digest_v1(module) != module.declaration_digest: return false
    for raw_function in module.functions:
        val function: MirHirFunctionDeclarationV1 = raw_function
        if module.source_binding != nil and not sha256_lower_hex_valid(function.complete_function_digest): return false
        if not mir_hir_callable_defaults_valid_v1(module, function): return false
    for raw_trait_decl in module.traits:
        val trait_decl: MirHirTraitDeclarationV1 = raw_trait_decl
        for raw_method in trait_decl.methods:
            val method: MirHirFunctionDeclarationV1 = raw_method
            if module.source_binding != nil and not sha256_lower_hex_valid(method.complete_function_digest): return false
            if not mir_hir_callable_defaults_valid_v1(module, method): return false
        for raw_method in trait_decl.defaults:
            val method: MirHirFunctionDeclarationV1 = raw_method
            if module.source_binding != nil and not sha256_lower_hex_valid(method.complete_function_digest): return false
            if not mir_hir_callable_defaults_valid_v1(module, method): return false
    for raw_declaration in module.structs:
        val declaration: MirHirNominalDeclarationV1 = raw_declaration
        if declaration.kind != SymbolKind.Struct or
                not mir_hir_fields_valid_v1(module, declaration.symbol.id, declaration.fields): return false
    for raw_declaration in module.classes:
        val declaration: MirHirNominalDeclarationV1 = raw_declaration
        if declaration.kind != SymbolKind.Class or
                not mir_hir_fields_valid_v1(module, declaration.symbol.id, declaration.fields): return false
    for raw_declaration in module.enums:
        val declaration: MirHirEnumDeclarationV1 = raw_declaration
        var index = 0
        while index < declaration.variants.len():
            val variant: MirHirVariantDeclarationV1 = declaration.variants[index]
            if not mir_hir_fields_valid_v1(module, variant.symbol.id, variant.fields): return false
            if variant.has_discriminant:
                if val artifact = variant.discriminant_artifact:
                    if not mir_hir_expression_selector_matches_v1(module, artifact,
                            "enum-discriminant", declaration.symbol.id, index, variant.name): return false
                else: return false
            elif variant.discriminant_artifact != nil: return false
            index = index + 1
    for raw_declaration in module.globals:
        val declaration: MirHirGlobalDeclarationV1 = raw_declaration
        if not mir_hir_expression_selector_matches_v1(module, declaration.initializer,
                "global-initializer", declaration.symbol.id, 0, declaration.name): return false
    true

fn mir_hir_declaration_repository_valid_v1(repository: MirHirDeclarationRepositoryV1) -> bool:
    if repository.ordered_modules.len() == 0 or repository.ordered_modules.len() != repository.modules.len() or
            not sha256_lower_hex_valid(repository.final_repository_authority) or
            repository.authority == "" or
            mir_hir_declaration_repository_digest_v1(repository) != repository.authority: return false
    var seen: Dict<text, bool> = {}
    for name in repository.ordered_modules:
        if seen.has(name) or not repository.modules.has(name): return false
        seen[name] = true
        val module: MirHirModuleDeclarationsV1 = repository.modules[name]
        if mir_hir_declaration_logical_key_v1(module) != name or module.final_repository_authority != repository.final_repository_authority or
                not mir_hir_module_declarations_valid_v1(module): return false
    true

# The old mechanical route uses the decoded owner as its sole key. Production
# logical variants carry an explicit source-index key without renaming HIR.
fn mir_hir_declaration_logical_key_v1(module: MirHirModuleDeclarationsV1) -> text:
    if val source = module.source_binding: return source.logical_key
    module.name

fn mir_hir_declaration_source_valid_v1(module: MirHirModuleDeclarationsV1) -> bool:
    if val source = module.source_binding:
        return source.logical_key != "" and source.physical_path != "" and
            source.source_bytes >= 0 and sha256_lower_hex_valid(source.source_digest) and
            sha256_lower_hex_valid(source.input_archive_key)
    true

fn mir_hir_declarations_same_physical_source_v1(left: MirHirModuleDeclarationsV1,
        right: MirHirModuleDeclarationsV1) -> bool:
    if left.source_binding == nil or right.source_binding == nil: return false
    val a: MirHirDeclarationSourceV1 = left.source_binding.unwrap()
    val b: MirHirDeclarationSourceV1 = right.source_binding.unwrap()
    mir_hir_declaration_source_valid_v1(left) and mir_hir_declaration_source_valid_v1(right) and
        left.name == right.name and left.path == right.path and
        a.physical_path == b.physical_path and a.source_digest == b.source_digest and
        a.source_bytes == b.source_bytes and a.input_archive_key == b.input_archive_key
