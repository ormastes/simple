# PR-D: typed TargetHIR reader for @cfg expression-arm selection.
# MIR consumes the target only through a TargetHIR handle bound to a frozen
# snapshot; a handle for a different snapshot is rejected instead of silently
# selecting with the wrong target. Selection itself delegates to the existing
# mir_cfg_select_arm, so this reader is equivalent to the legacy path. The
# legacy MirLowering.lower_cfg_select route is unchanged; no caller is
# switched over yet.

use compiler.mir.mir_cfg_select.{mir_cfg_select_arm}
use compiler.hir.target_hir.hir_snapshot.{HirSnapshotId, hir_snapshot_id_equals, hir_snapshot_id_text}
use compiler.hir.target_hir.target_hir.{TargetHIR}

# Ok(index of the chosen arm) or Ok(-1) for "no arm"; malformed -> Err.
fn mir_target_hir_select_arm(view: TargetHIR, snapshot: HirSnapshotId, conditions: [text], features: [text]) -> Result<i64, text>:
    if not hir_snapshot_id_equals(view.snapshot, snapshot):
        return Err("target_hir_snapshot_mismatch: " + hir_snapshot_id_text(view.snapshot) + " != " + hir_snapshot_id_text(snapshot))
    val idx = mir_cfg_select_arm(conditions, view.target, features)
    if idx == -2:
        return Err("target_hir_malformed_cfg_condition")
    if idx < 0:
        return Ok(-1)
    Ok(idx)
