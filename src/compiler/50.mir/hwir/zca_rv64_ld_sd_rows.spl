# RV64-only C.LD/C.SD typed rows and normalized mission-critical outcomes.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwCompareOp, HwConstant, HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.predecode.{strict_riscv_predecode_interface}
use compiler.mir.hwir.frontend.{strict_frontend_data_row_fragment}

fn require_rv64_zca_memory(module_name: text, config: CoreConfig, instruction_name: text) -> Result<(), text>:
    if module_name == "": return Err("HWIR-E-MODULE-ID: strict RV64 Zca memory row requires a module name")
    val diagnostic = config.diagnostic()
    if diagnostic != "": return Err(diagnostic)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict RV64 Zca memory row requires zca-common-critical profile")
    if config.xlen != 64:
        return Err("HWIR-E-ZCA-RV64-MEMORY: " + instruction_name + " requires a concrete RV64 mission-critical product")
    Ok(())

fn strict_zca_rv64_compact_dword_row_hwir(module_name: text, config: CoreConfig,
    instruction_name: text, source_name: text, classifier: text, tag: i64,
    memory_write: bool) -> Result<HwModuleDef, text>:
    require_rv64_zca_memory(module_name, config, instruction_name)?
    val register_name = if memory_write: "rs2" else: "rd"
    val instruction_result = if memory_write: "sd_instruction" else: "ld_instruction"
    val signals = [
        HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
        HwSignal.comb(classifier, "Bits", 1), HwSignal.comb("register_shifted", "Bits", 32),
        HwSignal.comb("register_compact", "Bits", 32), HwSignal.comb(register_name, "Bits", 32),
        HwSignal.comb("rs1_shifted", "Bits", 32), HwSignal.comb("rs1_compact", "Bits", 32),
        HwSignal.comb("rs1", "Bits", 32), HwSignal.comb("imm_7_6_source", "Bits", 32),
        HwSignal.comb("imm_7_6_compact", "Bits", 32), HwSignal.comb("imm_7_6", "Bits", 32),
        HwSignal.comb("imm_5_3_source", "Bits", 32), HwSignal.comb("imm_5_3_compact", "Bits", 32),
        HwSignal.comb("imm_5_3", "Bits", 32), HwSignal.comb("immediate", "Bits", 32),
        HwSignal.comb("register_field", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
        HwSignal.comb("immediate_shifted_5", "Bits", 32), HwSignal.comb("imm_upper_field", "Bits", 32),
        HwSignal.comb("imm_low_bits", "Bits", 32), HwSignal.comb("imm_low_field", "Bits", 32),
        HwSignal.comb("instruction_partial_1", "Bits", 32), HwSignal.comb("instruction_partial_2", "Bits", 32),
        HwSignal.comb("instruction_partial_3", "Bits", 32), HwSignal.comb("instruction_with_funct3", "Bits", 32),
        HwSignal.comb(instruction_result, "Bits", 32)]
    val constants = [
        HwConstant.bits("low16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
        HwConstant.bits("expected_tag", 32, tag), HwConstant.bits("right_shift_2", 32, 2),
        HwConstant.bits("right_shift_5", 32, 5), HwConstant.bits("right_shift_7", 32, 7),
        HwConstant.bits("right_shift_10", 32, 10), HwConstant.bits("compact_mask", 32, 7),
        HwConstant.bits("two_bit_mask", 32, 3), HwConstant.bits("prime_base", 32, 8),
        HwConstant.bits("left_shift_3", 32, 3), HwConstant.bits("left_shift_6", 32, 6),
        HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("left_shift_15", 32, 15),
        HwConstant.bits("left_shift_20", 32, 20), HwConstant.bits("left_shift_25", 32, 25),
        HwConstant.bits("imm_low5_mask", 32, 31), HwConstant.bits("dword_funct3", 32, 12288),
        HwConstant.bits("base_opcode", 32, if memory_write: 35 else: 3),
        HwConstant.bits("zero_instruction", 32, 0)]
    var ops: [HwCombOp] = [
        HwCombOp.binary("and", "parcel16", "parcel", "low16_mask", 32),
        HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
        HwCombOp.binary("shr", "register_shifted", "parcel16", "right_shift_2", 32),
        HwCombOp.binary("and", "register_compact", "register_shifted", "compact_mask", 32),
        HwCombOp.binary("or", register_name, "register_compact", "prime_base", 32),
        HwCombOp.binary("shr", "rs1_shifted", "parcel16", "right_shift_7", 32),
        HwCombOp.binary("and", "rs1_compact", "rs1_shifted", "compact_mask", 32),
        HwCombOp.binary("or", "rs1", "rs1_compact", "prime_base", 32),
        HwCombOp.binary("shr", "imm_7_6_source", "parcel16", "right_shift_5", 32),
        HwCombOp.binary("and", "imm_7_6_compact", "imm_7_6_source", "two_bit_mask", 32),
        HwCombOp.binary("shl", "imm_7_6", "imm_7_6_compact", "left_shift_6", 32),
        HwCombOp.binary("shr", "imm_5_3_source", "parcel16", "right_shift_10", 32),
        HwCombOp.binary("and", "imm_5_3_compact", "imm_5_3_source", "compact_mask", 32),
        HwCombOp.binary("shl", "imm_5_3", "imm_5_3_compact", "left_shift_3", 32),
        HwCombOp.binary("or", "immediate", "imm_7_6", "imm_5_3", 32),
        HwCombOp.binary("shl", "rs1_field", "rs1", "left_shift_15", 32)]
    if memory_write:
        ops.push(HwCombOp.binary("shr", "immediate_shifted_5", "immediate", "right_shift_5", 32))
        ops.push(HwCombOp.binary("shl", "imm_upper_field", "immediate_shifted_5", "left_shift_25", 32))
        ops.push(HwCombOp.binary("and", "imm_low_bits", "immediate", "imm_low5_mask", 32))
        ops.push(HwCombOp.binary("shl", "imm_low_field", "imm_low_bits", "left_shift_7", 32))
        ops.push(HwCombOp.binary("shl", "register_field", register_name, "left_shift_20", 32))
        ops.push(HwCombOp.binary("or", "instruction_partial_1", "imm_upper_field", "register_field", 32))
        ops.push(HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "rs1_field", 32))
        ops.push(HwCombOp.binary("or", "instruction_partial_3", "instruction_partial_2", "imm_low_field", 32))
    else:
        ops.push(HwCombOp.binary("shl", "register_field", register_name, "left_shift_7", 32))
        ops.push(HwCombOp.binary("shl", "imm_upper_field", "immediate", "left_shift_20", 32))
        ops.push(HwCombOp.binary("or", "instruction_partial_1", "imm_upper_field", "rs1_field", 32))
        ops.push(HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "register_field", 32))
        ops.push(HwCombOp.unary("passthrough", "instruction_partial_3", "instruction_partial_2", 32))
    ops.push(HwCombOp.binary("or", "instruction_with_funct3", "instruction_partial_3", "dword_funct3", 32))
    ops.push(HwCombOp.binary("or", instruction_result, "instruction_with_funct3", "base_opcode", 32))
    val compares = [HwCompareOp.equal(classifier, "opcode_tag", "expected_tag", 32)]
    val selects = [HwSelectOp.mux("canonical_instruction", classifier, instruction_result, "zero_instruction", 32)]
    val summary = HwModule(name: module_name, profile: config.profile, port_count: 2,
        signal_count: signals.len(), register_count: 0, memory_count: 0,
        comb_op_count: ops.len() + compares.len() + selects.len(), clock_domain_count: 1,
        fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config, node_id: HwNodeId.module_root(module_name),
        origins: [HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: source_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: source_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "registers"), source_name: source_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "canonical"), source_name: source_name)],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: signals, constants: constants, comb_ops: ops, compare_ops: compares,
        select_ops: selects, clock_domains: [HwClockDomain.default_domain()])
    val shape = module.shape_diagnostic()
    if shape != "": return Err(shape)
    Ok(module)

pub fn strict_zca_cld_rv64_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_rv64_compact_dword_row_hwir(module_name, config, "C.LD", "zca.rv64.c.ld", "is_c_ld", 24576, false)

pub fn strict_zca_csd_rv64_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_rv64_compact_dword_row_hwir(module_name, config, "C.SD", "zca.rv64.c.sd", "is_c_sd", 57344, true)

fn strict_zca_rv64_memory_outcome_hwir(module_name: text, config: CoreConfig,
    prefix: text, source_name: text, classifier: text, row: HwModuleDef,
    memory_write: bool) -> Result<HwModuleDef, text>:
    val contract = strict_riscv_predecode_interface(config)?
    val fragment = strict_frontend_data_row_fragment(module_name, prefix, row, "parcel32")?
    val pa = config.physical_address_bits
    var signals: [HwSignal] = [HwSignal.comb("parcel32", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa), HwSignal.comb("match_legal", "Bits", 1),
        HwSignal.comb("effect_register_write", "Bits", 1), HwSignal.comb("effect_memory_read", "Bits", 1),
        HwSignal.comb("effect_memory_write", "Bits", 1), HwSignal.comb("control_fallthrough", "Bits", 1)]
    for signal in fragment.signals: signals.push(signal)
    var constants: [HwConstant] = [HwConstant.bits("two_bytes", pa, 2), HwConstant.bits("two_length", 2, 2),
        HwConstant.bits("zero_flag", 1, 0), HwConstant.bits("one_flag", 1, 1)]
    for constant in fragment.constants: constants.push(constant)
    var ops: [HwCombOp] = [HwCombOp.unary("zext", "parcel32", "original_parcel", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "canonical_instruction", prefix + "_canonical_instruction", 32),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa),
        HwCombOp.unary("passthrough", "legal", "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_register_write", if memory_write: "zero_flag" else: "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_memory_read", if memory_write: "zero_flag" else: "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_memory_write", if memory_write: "match_legal" else: "zero_flag", 1),
        HwCombOp.unary("passthrough", "control_fallthrough", "one_flag", 1)]
    for op in fragment.comb_ops: ops.push(op)
    var selects = fragment.select_ops
    selects.push(HwSelectOp.mux("match_legal", prefix + "_" + classifier, "one_flag", "zero_flag", 1))
    val summary = HwModule(name: module_name, profile: config.profile, port_count: contract.ports().len(),
        signal_count: signals.len(), register_count: 0, memory_count: 0,
        comb_op_count: ops.len() + fragment.compare_ops.len() + selects.len(), clock_domain_count: 1,
        fallback_function: "", cost: HwCostModel.empty())
    var origins: [HwOrigin] = [HwOrigin(node_id: HwNodeId.child(module_name, "outcome"), source_name: source_name + ".outcome")]
    for origin in fragment.origins: origins.push(origin)
    val module = HwModuleDef(summary: summary, config: config, node_id: HwNodeId.module_root(module_name),
        origins: origins,
        ports: contract.ports(), signals: signals, constants: constants, comb_ops: ops,
        compare_ops: fragment.compare_ops, select_ops: selects,
        clock_domains: [HwClockDomain.default_domain()])
    val shape = module.shape_diagnostic()
    if shape != "": return Err(shape)
    Ok(module)

pub fn strict_zca_cld_rv64_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_rv64_memory_outcome_hwir(module_name, config, "cld", "zca.rv64.c.ld", "is_c_ld",
        strict_zca_cld_rv64_row_hwir(module_name + "_row", config)?, false)

pub fn strict_zca_csd_rv64_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_rv64_memory_outcome_hwir(module_name, config, "csd", "zca.rv64.c.sd", "is_c_sd",
        strict_zca_csd_rv64_row_hwir(module_name + "_row", config)?, true)
