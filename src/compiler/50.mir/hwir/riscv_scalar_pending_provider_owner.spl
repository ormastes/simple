# One-entry sequential owner for the frozen stateful-provider protocol.

use compiler.mir.hwir.types.{HwCombOp, HwConstant, HwModuleDef, HwNodeId, HwOrigin,
    HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard,
    HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef,
    HwSequentialPlan, HwStateRegister}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{HwScalarDecodedUopInterface}
use compiler.mir.hwir.riscv_scalar_completion_interface.{HwScalarCompletionInterface}
use compiler.mir.hwir.riscv_scalar_pending_provider_protocol.{HwScalarPendingProviderProtocol}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_semantic_opcode}

fn pending_lanes() -> [text]: ["lsu", "muldiv", "csr", "fence"]

fn is_uop_control_field(name: text) -> bool:
    name == "uop_valid" or name == "uop_ready"

fn is_completion_control_field(name: text) -> bool:
    name == "completion_valid" or name == "completion_ready"

fn request_register_name(name: text) -> text: "request_" + name + "_reg"
fn completion_register_name(name: text) -> text: "completion_" + name + "_reg"

fn stateful_class(value: text) -> i64:
    if value == "load-store": return 3
    if value == "multiply-divide": return 4
    if value == "csr": return 6
    if value == "memory-order": return 7
    0

fn stateful_effect(value: text) -> i64:
    if value == "load": return 1
    if value == "store": return 2
    if value == "csr": return 3
    if value == "fence": return 4
    0

fn stateful_tag(execution_class: text) -> i64:
    if execution_class == "load-store": return 1
    if execution_class == "multiply-divide": return 2
    if execution_class == "csr": return 3
    if execution_class == "memory-order": return 4
    0

fn pending_ports(decoded: HwScalarDecodedUopInterface,
    completion: HwScalarCompletionInterface) -> [HwPort]:
    var ports = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("dispatch_valid", "Bits", 1), HwPort.input("dispatch_tag", "Bits", 3),
        HwPort.input("downstream_ready", "Bits", 1),
        HwPort.output("dispatch_ready", "Bits", 1), HwPort.output("uop_ready", "Bits", 1),
        HwPort.output("busy", "Bits", 1),
        HwPort.output("selected_completion_valid", "Bits", 1),
        HwPort.output("selected_completion_tag", "Bits", 3),
        HwPort.output("selected_completion_event_id", "Bits", 64),
        HwPort.output("selected_completion_decode_event_id", "Bits", 64),
        HwPort.output("protocol_fault", "Bits", 1)]
    for field in decoded.fields:
        if not is_uop_control_field(field.name):
            ports.push(HwPort.input("dispatch_" + field.name, "Bits", field.bit_width))
    for field in completion.fields:
        if not is_completion_control_field(field.name):
            ports.push(HwPort.output("selected_completion_" + field.name, "Bits", field.bit_width))
    for lane in pending_lanes():
        ports.push(HwPort.input(lane + "_request_ready", "Bits", 1))
        ports.push(HwPort.input(lane + "_request_accept", "Bits", 1))
        ports.push(HwPort.output(lane + "_request_valid", "Bits", 1))
        ports.push(HwPort.output(lane + "_request_provider_tag", "Bits", 3))
        for field in decoded.fields:
            if not is_uop_control_field(field.name):
                ports.push(HwPort.output(lane + "_request_" + field.name, "Bits", field.bit_width))
        ports.push(HwPort.input(lane + "_completion_valid", "Bits", 1))
        ports.push(HwPort.input(lane + "_provider_protocol_fault", "Bits", 1))
        ports.push(HwPort.input(lane + "_completion_tag", "Bits", 3))
        ports.push(HwPort.input(lane + "_completion_event_id", "Bits", 64))
        ports.push(HwPort.input(lane + "_completion_decode_event_id", "Bits", 64))
        for field in completion.fields:
            if not is_completion_control_field(field.name):
                ports.push(HwPort.input(lane + "_completion_" + field.name, "Bits", field.bit_width))
        ports.push(HwPort.output(lane + "_completion_ready", "Bits", 1))
    ports

fn pending_registers(decoded: HwScalarDecodedUopInterface,
    completion: HwScalarCompletionInterface) -> [HwStateRegister]:
    var registers = [HwStateRegister(name: "pending_reg", bit_width: 1,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "issued_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "full_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "fault_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "tag_reg", bit_width: 3, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "completion_tag_reg", bit_width: 3,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "completion_event_id_reg", bit_width: 64,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "completion_decode_event_id_reg", bit_width: 64,
            clock_domain: "default", reset_value: 0)]
    for field in decoded.fields:
        if not is_uop_control_field(field.name):
            registers.push(HwStateRegister(name: request_register_name(field.name),
                bit_width: field.bit_width, clock_domain: "default", reset_value: 0))
    for field in completion.fields:
        if not is_completion_control_field(field.name):
            registers.push(HwStateRegister(name: completion_register_name(field.name),
                bit_width: field.bit_width, clock_domain: "default", reset_value: 0))
    registers

fn fault_assignments() -> [HwSeqAssignment]:
    [HwSeqAssignment(destination: "fault_reg", value: HwSeqValue.copy("fault_all", 1)),
        HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]

fn consume_assignments(completion: HwScalarCompletionInterface) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "completion_tag_reg", value: HwSeqValue.zero(3)),
        HwSeqAssignment(destination: "completion_event_id_reg", value: HwSeqValue.zero(64)),
        HwSeqAssignment(destination: "completion_decode_event_id_reg", value: HwSeqValue.zero(64))]
    for field in completion.fields:
        if not is_completion_control_field(field.name):
            assignments.push(HwSeqAssignment(destination: completion_register_name(field.name),
                value: HwSeqValue.zero(field.bit_width)))
    assignments

fn dispatch_assignments(decoded: HwScalarDecodedUopInterface) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "pending_reg",
            value: HwSeqValue.copy("dispatch_valid", 1)),
        HwSeqAssignment(destination: "tag_reg", value: HwSeqValue.copy("dispatch_tag", 3))]
    for field in decoded.fields:
        if not is_uop_control_field(field.name):
            assignments.push(HwSeqAssignment(destination: request_register_name(field.name),
                value: HwSeqValue.copy("dispatch_" + field.name, field.bit_width)))
    assignments

fn completion_assignments(completion: HwScalarCompletionInterface) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "full_reg", value: HwSeqValue.copy("completion_good_any", 1)),
        HwSeqAssignment(destination: "completion_tag_reg", value: HwSeqValue.copy("selected_tag", 3)),
        HwSeqAssignment(destination: "completion_event_id_reg", value: HwSeqValue.copy("selected_event_id", 64)),
        HwSeqAssignment(destination: "completion_decode_event_id_reg",
            value: HwSeqValue.copy("selected_decode_event_id", 64))]
    for field in completion.fields:
        if not is_completion_control_field(field.name):
            assignments.push(HwSeqAssignment(destination: completion_register_name(field.name),
                value: HwSeqValue.copy("selected_payload_" + field.name, field.bit_width)))
    assignments

fn pending_outputs(decoded: HwScalarDecodedUopInterface,
    completion: HwScalarCompletionInterface) -> [HwSeqOutputBinding]:
    val idle = [HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"),
        HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")]
    val full = [HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")]
    var outputs = [HwSeqOutputBinding.all("dispatch_ready", idle),
        HwSeqOutputBinding.all("uop_ready", idle),
        HwSeqOutputBinding.direct("busy", "busy_any", 1),
        HwSeqOutputBinding.all("selected_completion_valid", full),
        HwSeqOutputBinding.guarded("selected_completion_tag", "completion_tag_reg", 3, full),
        HwSeqOutputBinding.guarded("selected_completion_event_id", "completion_event_id_reg", 64, full),
        HwSeqOutputBinding.guarded("selected_completion_decode_event_id",
            "completion_decode_event_id_reg", 64, full),
        HwSeqOutputBinding.direct("protocol_fault", "fault_reg", 1)]
    for field in completion.fields:
        if not is_completion_control_field(field.name):
            outputs.push(HwSeqOutputBinding.guarded("selected_completion_" + field.name,
                completion_register_name(field.name), field.bit_width, full))
    for lane in pending_lanes():
        val selected_pending = [HwSeqGuard.high("pending_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.high(lane + "_selected")]
        outputs.push(HwSeqOutputBinding.all(lane + "_request_valid", selected_pending))
        outputs.push(HwSeqOutputBinding.guarded(lane + "_request_provider_tag",
            "tag_reg", 3, selected_pending))
        for field in decoded.fields:
            if not is_uop_control_field(field.name):
                outputs.push(HwSeqOutputBinding.guarded(lane + "_request_" + field.name,
                    request_register_name(field.name), field.bit_width, selected_pending))
        outputs.push(HwSeqOutputBinding.all(lane + "_completion_ready", [
            HwSeqGuard.high("issued_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.high(lane + "_selected")]))
    outputs

fn pending_rules(decoded: HwScalarDecodedUopInterface,
    completion: HwScalarCompletionInterface) -> [HwSeqRule]:
    # Fault is deliberately first: it is the terminal owner rule.
    [HwSeqRule(name: "protocol_fault", guards: [HwSeqGuard.high("fault_all"),
            HwSeqGuard.low("fault_reg")], assignments: fault_assignments()),
        HwSeqRule(name: "consume", guards: [HwSeqGuard.high("downstream_ready"),
            HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")],
            assignments: consume_assignments(completion)),
        HwSeqRule(name: "capture_completion", guards: [HwSeqGuard.high("completion_good_any"),
            HwSeqGuard.high("issued_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.low("completion_overlap")], assignments: completion_assignments(completion)),
        HwSeqRule(name: "accept_request", guards: [HwSeqGuard.high("request_accept_any"),
            HwSeqGuard.high("pending_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.low("accept_mismatch")], assignments: [
            HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
            HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.copy("request_accept_any", 1))]),
        HwSeqRule(name: "capture_dispatch", guards: [HwSeqGuard.high("dispatch_valid"),
            HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"),
            HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.high("dispatch_identity_ok")], assignments: dispatch_assignments(decoded))]

fn append_or(signals: [HwSignal], ops: [HwCombOp], name: text,
    prior: text, value: text) -> ([HwSignal], [HwCombOp], text):
    var next_signals = signals; var next_ops = ops
    next_signals.push(HwSignal.comb(name, "Bits", 1))
    next_ops.push(HwCombOp.binary("or", name, prior, value, 1))
    (next_signals, next_ops, name)

pub fn strict_riscv_scalar_pending_provider_owner(module_name: text,
    protocol: HwScalarPendingProviderProtocol, decoded: HwScalarDecodedUopInterface,
    decoder: HwModuleDef, decoder_plan: RiscvScalarDecoderPlan,
    completion: HwScalarCompletionInterface) -> Result<HwSequentialModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-PENDING-OWNER-ID: pending-provider owner requires a module name")
    val protocol_error = protocol.diagnostic_for_interfaces(decoded, decoder, decoder_plan, completion)
    if protocol_error != "": return Err(protocol_error)
    var constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1)]
    var signals: [HwSignal] = []
    var ops: [HwCombOp] = []
    var selects: [HwSelectOp] = []
    var request_accept_any = "zero1"; var accept_mismatch = "zero1"
    var completion_any = "zero1"; var completion_good_any = "zero1"
    var completion_overlap = "zero1"; var provider_fault_any = "zero1"
    var seen_completion = "zero1"
    var index = 0
    for lane in pending_lanes():
        constants.push(HwConstant.bits("tag_" + lane, 3, (index + 1) as i64))
        for name in [lane + "_selected", lane + "_selected_pending", lane + "_expected_accept",
                lane + "_accept_mismatch", lane + "_tag_match", lane + "_event_match",
                lane + "_decode_match", lane + "_identity_left", lane + "_identity_ok",
                lane + "_not_fault", lane + "_valid_selected", lane + "_good_left",
                lane + "_completion_good", lane + "_overlap_here"]:
            signals.push(HwSignal.comb(name, "Bits", 1))
        ops.push(HwCombOp.binary("eq", lane + "_selected", "tag_reg", "tag_" + lane, 3))
        ops.push(HwCombOp.binary("and", lane + "_selected_pending", lane + "_selected", "pending_reg", 1))
        ops.push(HwCombOp.binary("and", lane + "_expected_accept", lane + "_selected_pending", lane + "_request_ready", 1))
        ops.push(HwCombOp.binary("xor", lane + "_accept_mismatch", lane + "_expected_accept", lane + "_request_accept", 1))
        ops.push(HwCombOp.binary("eq", lane + "_tag_match", lane + "_completion_tag", "tag_reg", 3))
        ops.push(HwCombOp.binary("eq", lane + "_event_match", lane + "_completion_event_id", request_register_name("provider_event_id"), 64))
        ops.push(HwCombOp.binary("eq", lane + "_decode_match", lane + "_completion_decode_event_id", request_register_name("decode_event_id"), 64))
        ops.push(HwCombOp.binary("and", lane + "_identity_left", lane + "_tag_match", lane + "_event_match", 1))
        ops.push(HwCombOp.binary("and", lane + "_identity_ok", lane + "_identity_left", lane + "_decode_match", 1))
        ops.push(HwCombOp.binary("xor", lane + "_not_fault", lane + "_provider_protocol_fault", "one1", 1))
        ops.push(HwCombOp.binary("and", lane + "_valid_selected", lane + "_completion_valid", lane + "_selected", 1))
        ops.push(HwCombOp.binary("and", lane + "_good_left", lane + "_valid_selected", lane + "_identity_ok", 1))
        ops.push(HwCombOp.binary("and", lane + "_completion_good", lane + "_good_left", lane + "_not_fault", 1))
        ops.push(HwCombOp.binary("and", lane + "_overlap_here", seen_completion, lane + "_completion_valid", 1))
        for reduction in [("accept", request_accept_any, lane + "_expected_accept"),
                ("mismatch", accept_mismatch, lane + "_accept_mismatch"),
                ("completion", completion_any, lane + "_completion_valid"),
                ("good", completion_good_any, lane + "_completion_good"),
                ("overlap", completion_overlap, lane + "_overlap_here"),
                ("provider_fault", provider_fault_any, lane + "_provider_protocol_fault")]:
            val appended = append_or(signals, ops, reduction[0] + "_after_" + index.to_text(), reduction[1], reduction[2])
            signals = appended[0]; ops = appended[1]
            if reduction[0] == "accept": request_accept_any = appended[2]
            elif reduction[0] == "mismatch": accept_mismatch = appended[2]
            elif reduction[0] == "completion": completion_any = appended[2]
            elif reduction[0] == "good": completion_good_any = appended[2]
            elif reduction[0] == "overlap": completion_overlap = appended[2]
            else: provider_fault_any = appended[2]
        val seen = append_or(signals, ops, "seen_completion_after_" + index.to_text(),
            seen_completion, lane + "_completion_valid")
        signals = seen[0]; ops = seen[1]; seen_completion = seen[2]
        index = index + 1
    for alias in [("request_accept_any", request_accept_any), ("accept_mismatch", accept_mismatch),
            ("completion_any", completion_any), ("completion_good_any", completion_good_any),
            ("completion_overlap", completion_overlap), ("provider_fault_any", provider_fault_any)]:
        signals.push(HwSignal.comb(alias[0], "Bits", 1))
        ops.push(HwCombOp.unary("passthrough", alias[0], alias[1], 1))
    # The exact frozen decoder plan, not a class-level approximation, owns admission.
    var selected_any = "zero1"; var route_overlap = "zero1"; var prior_selected = "zero1"
    var row_index = 0
    for entry in decoder_plan.entries:
        val class_value = stateful_class(entry.execution_class)
        if class_value != 0:
            val suffix = row_index.to_text()
            constants.push(HwConstant.bits("route_row_" + suffix, decoded.row_width, (row_index + 1) as i64))
            constants.push(HwConstant.bits("route_semantic_" + suffix, 6,
                riscv_scalar_semantic_opcode(entry.semantic_operation)))
            constants.push(HwConstant.bits("route_class_" + suffix, 3, class_value))
            constants.push(HwConstant.bits("route_effect_" + suffix, 3, stateful_effect(entry.memory_effect)))
            constants.push(HwConstant.bits("route_width32_" + suffix, 1,
                if entry.operand_width_bits == 32: 1 else: 0))
            constants.push(HwConstant.bits("route_tag_" + suffix, 3, stateful_tag(entry.execution_class)))
            for part in ["row", "semantic", "class", "effect", "width", "tag",
                    "left0", "left1", "left2", "left3", "selected", "overlap"]:
                signals.push(HwSignal.comb("route_" + suffix + "_" + part, "Bits", 1))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_row",
                "dispatch_decoded_row_index", "route_row_" + suffix, decoded.row_width))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_semantic",
                "dispatch_decoded_semantic_opcode", "route_semantic_" + suffix, 6))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_class",
                "dispatch_decoded_execution_class", "route_class_" + suffix, 3))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_effect",
                "dispatch_decoded_memory_effect", "route_effect_" + suffix, 3))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_width",
                "dispatch_decoded_declared_operand_width_is_32", "route_width32_" + suffix, 1))
            ops.push(HwCombOp.binary("eq", "route_" + suffix + "_tag",
                "dispatch_tag", "route_tag_" + suffix, 3))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_left0",
                "route_" + suffix + "_row", "route_" + suffix + "_semantic", 1))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_left1",
                "route_" + suffix + "_class", "route_" + suffix + "_effect", 1))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_left2",
                "route_" + suffix + "_width", "route_" + suffix + "_tag", 1))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_left3",
                "route_" + suffix + "_left0", "route_" + suffix + "_left1", 1))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_selected",
                "route_" + suffix + "_left3", "route_" + suffix + "_left2", 1))
            ops.push(HwCombOp.binary("and", "route_" + suffix + "_overlap",
                prior_selected, "route_" + suffix + "_selected", 1))
            val selected_reduction = append_or(signals, ops, "route_selected_after_" + suffix,
                selected_any, "route_" + suffix + "_selected")
            signals = selected_reduction[0]; ops = selected_reduction[1]; selected_any = selected_reduction[2]
            val overlap_reduction = append_or(signals, ops, "route_overlap_after_" + suffix,
                route_overlap, "route_" + suffix + "_overlap")
            signals = overlap_reduction[0]; ops = overlap_reduction[1]; route_overlap = overlap_reduction[2]
            prior_selected = selected_any
        row_index = row_index + 1
    for alias in [("route_selected_any", selected_any), ("route_overlap", route_overlap)]:
        signals.push(HwSignal.comb(alias[0], "Bits", 1))
        ops.push(HwCombOp.unary("passthrough", alias[0], alias[1], 1))
    # Completion control and every frozen completion payload field share one selected mux chain.
    var selected_fields = [("tag", 3), ("event_id", 64), ("decode_event_id", 64)]
    for field in completion.fields:
        if not is_completion_control_field(field.name): selected_fields.push(("payload_" + field.name, field.bit_width))
    for selected in selected_fields:
        var source_name = "fence_completion_" + selected[0].replace("payload_", "")
        var lane_index = 2
        while lane_index >= 0:
            val lane = pending_lanes()[lane_index]
            val result = if lane_index == 0: "selected_" + selected[0] else:
                "selected_" + selected[0] + "_after_" + lane_index.to_text()
            signals.push(HwSignal.comb(result, "Bits", selected[1]))
            selects.push(HwSelectOp.mux(result, lane + "_selected",
                lane + "_completion_" + selected[0].replace("payload_", ""), source_name, selected[1]))
            source_name = result
            lane_index = lane_index - 1
    val events_equal = "dispatch_events_equal"; val dispatch_lineage_ok = "dispatch_lineage_ok"
    val not_route_overlap = "not_route_overlap"; val legal_route = "dispatch_legal_route"
    val identity_left = "dispatch_identity_left"
    val dispatch_identity_ok = "dispatch_identity_ok"; val invalid_identity_raw = "invalid_identity_raw"
    val invalid_identity = "invalid_dispatch_identity"
    val idle_completion = "idle_completion"; val not_issued = "not_issued"
    val not_good = "not_good"; val issued_bad = "issued_bad"; val wrong_completion = "wrong_completion"
    for name in [events_equal, dispatch_lineage_ok, not_route_overlap,
            legal_route, identity_left, dispatch_identity_ok, invalid_identity_raw, invalid_identity,
            idle_completion, not_issued, not_good, issued_bad, wrong_completion,
            "fault_left", "fault_mid", "fault_right", "fault_partial", "fault_all"]:
        signals.push(HwSignal.comb(name, "Bits", 1))
    ops.push(HwCombOp.binary("eq", events_equal, "dispatch_provider_event_id", "dispatch_decode_event_id", 64))
    ops.push(HwCombOp.binary("and", dispatch_lineage_ok, "dispatch_lineage_valid", events_equal, 1))
    ops.push(HwCombOp.binary("xor", not_route_overlap, "route_overlap", "one1", 1))
    ops.push(HwCombOp.binary("and", legal_route, "dispatch_decode_legal", "route_selected_any", 1))
    ops.push(HwCombOp.binary("and", identity_left, legal_route, not_route_overlap, 1))
    ops.push(HwCombOp.binary("and", dispatch_identity_ok, identity_left, dispatch_lineage_ok, 1))
    ops.push(HwCombOp.binary("xor", invalid_identity_raw, dispatch_identity_ok, "one1", 1))
    ops.push(HwCombOp.binary("and", invalid_identity, "dispatch_valid", invalid_identity_raw, 1))
    ops.push(HwCombOp.binary("xor", not_issued, "issued_reg", "one1", 1))
    ops.push(HwCombOp.binary("and", idle_completion, "completion_any", not_issued, 1))
    ops.push(HwCombOp.binary("xor", not_good, "completion_good_any", "one1", 1))
    ops.push(HwCombOp.binary("and", issued_bad, "issued_reg", not_good, 1))
    ops.push(HwCombOp.binary("and", wrong_completion, "completion_any", issued_bad, 1))
    ops.push(HwCombOp.binary("or", "fault_left", "accept_mismatch", idle_completion, 1))
    ops.push(HwCombOp.binary("or", "fault_mid", wrong_completion, "completion_overlap", 1))
    ops.push(HwCombOp.binary("or", "fault_right", "provider_fault_any", invalid_identity, 1))
    ops.push(HwCombOp.binary("or", "fault_partial", "fault_left", "fault_mid", 1))
    ops.push(HwCombOp.binary("or", "fault_all", "fault_partial", "fault_right", 1))
    # A one-entry owner is unavailable from capture until completion consumption;
    # a sticky protocol fault is likewise unavailable until reset.
    signals.push(HwSignal.comb("busy_pending_or_issued", "Bits", 1))
    signals.push(HwSignal.comb("busy_full_or_fault", "Bits", 1))
    signals.push(HwSignal.comb("busy_any", "Bits", 1))
    ops.push(HwCombOp.binary("or", "busy_pending_or_issued", "pending_reg", "issued_reg", 1))
    ops.push(HwCombOp.binary("or", "busy_full_or_fault", "full_reg", "fault_reg", 1))
    ops.push(HwCombOp.binary("or", "busy_any", "busy_pending_or_issued", "busy_full_or_fault", 1))
    val rules = pending_rules(decoded, completion)
    val plan = HwSequentialPlan(owner_id: HwNodeId.child(module_name, "sequential"),
        registers: pending_registers(decoded, completion), rules: rules,
        outputs: pending_outputs(decoded, completion), decoder_pins: [])
    val module = HwSequentialModuleDef(node_id: HwNodeId.module_root(module_name),
        entity_name: module_name, config: protocol.config, origins: [HwOrigin(
            node_id: HwNodeId.child(module_name, "pending-protocol"),
            source_name: "riscv.scalar.pending-provider/" + protocol.structural_sha256())],
        ports: pending_ports(decoded, completion), datapath_signals: signals,
        datapath_constants: constants, datapath_bit_vector_constants: [], datapath_comb_ops: ops,
        datapath_compare_ops: [], datapath_select_ops: selects, datapath_bit_extract_ops: [],
        datapath_fixed_slice_ops: [], plan: plan, child_entity: "", child_graph_sha256: "")
    val diagnostic = module.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
