# Plan-bound admission and completion envelope for the dynamic RISC-V DIV/REM
# provider.  This is deliberately not an execution engine: the eventual
# sequential divider consumes this frozen contract so that it cannot accept a
# decoded M row merely because its execution class happens to be tag two.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, hwir_hash_fields}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_decoder_plan, riscv_scalar_semantic_opcode}

pub class RiscvScalarRuntimeDivAdmissionRow:
    id: text
    encoding_mask: u32
    encoding_value: u32
    decoded_row_index: i32
    semantic_opcode: i64
    operation_code: i32
    declared_width_is_32: bool

    me diagnostic() -> text:
        if self.id == "" or self.encoding_mask == 0 or
            (self.encoding_value & self.encoding_mask) != self.encoding_value:
            return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission rows require a concrete encoding"
        if self.decoded_row_index <= 0 or self.semantic_opcode == 0 or
            self.operation_code < 0 or self.operation_code > 3:
            return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission rows require frozen decode metadata"
        ""

    me canonical_text() -> text:
        self.id + ":" + self.encoding_mask.to_text() + ":" +
            self.encoding_value.to_text() + ":" + self.decoded_row_index.to_text() + ":" +
            self.semantic_opcode.to_text() + ":" + self.operation_code.to_text() + ":" +
            self.declared_width_is_32.to_text()

pub class RiscvScalarRuntimeDivAdmissionContract:
    isa_profile: text
    plan_sha256: text
    xlen: i32
    decoded_row_width: i32
    provider_tag: i32
    execution_class: i32
    memory_effect: i32
    rows: [RiscvScalarRuntimeDivAdmissionRow]
    required_metadata_checks: [text]
    completion_fields: [text]
    protocol_fault_scope: text

    me diagnostic() -> text:
        if (self.isa_profile != "rv32im" and self.isa_profile != "rv64im" and
            self.isa_profile != "rv32im_zicsr_zifencei" and self.isa_profile != "rv64im_zicsr_zifencei") or
            (self.xlen != 32 and self.xlen != 64):
            return "HWIR-E-RISCV-RUNTIME-DIV-PROFILE: DIV/REM admission requires a concrete IM product"
        if ((self.isa_profile == "rv32im" or self.isa_profile == "rv32im_zicsr_zifencei") and self.xlen != 32) or
            ((self.isa_profile == "rv64im" or self.isa_profile == "rv64im_zicsr_zifencei") and self.xlen != 64):
            return "HWIR-E-RISCV-RUNTIME-DIV-CONFIG: DIV/REM admission profile must match XLEN"
        val plan_result = riscv_scalar_decoder_plan(self.isa_profile)
        if plan_result.is_err():
            return "HWIR-E-RISCV-RUNTIME-DIV-PLAN: DIV/REM contract requires its exact decoder plan"
        val plan = plan_result.ok().unwrap()
        if self.plan_sha256 != plan.structural_sha256():
            return "HWIR-E-RISCV-RUNTIME-DIV-PLAN: DIV/REM contract plan provenance differs from its ISA profile"
        if self.decoded_row_width < 1 or self.provider_tag != 2 or
            self.execution_class != 4 or self.memory_effect != 0:
            return "HWIR-E-RISCV-RUNTIME-DIV-PROTOCOL: DIV/REM admission fixes tag two, class four, and no memory effect"
        val expected_rows = if self.xlen == 64: 8 else: 4
        if self.rows.len() != expected_rows:
            return "HWIR-E-RISCV-RUNTIME-DIV-SCOPE: DIV/REM admission requires every concrete divide/remainder row"
        val expected_ids = if self.xlen == 64:
            ["rv.m.div", "rv.m.divu", "rv.m.rem", "rv.m.remu", "rv64.m.divw",
                "rv64.m.divuw", "rv64.m.remw", "rv64.m.remuw"]
        else: ["rv.m.div", "rv.m.divu", "rv.m.rem", "rv.m.remu"]
        var expected_plan_rows: [RiscvScalarRuntimeDivAdmissionRow] = []
        var plan_index = 0
        for entry in plan.entries:
            if div_row_id(entry.id):
                expected_plan_rows.push(RiscvScalarRuntimeDivAdmissionRow(id: entry.id,
                    encoding_mask: entry.encoding_mask, encoding_value: entry.encoding_value,
                    decoded_row_index: plan_index + 1,
                    semantic_opcode: riscv_scalar_semantic_opcode(entry.semantic_operation),
                    operation_code: div_operation_code(entry.id),
                    declared_width_is_32: entry.operand_width_bits == 32))
            plan_index = plan_index + 1
        if expected_plan_rows.len() != expected_rows:
            return "HWIR-E-RISCV-RUNTIME-DIV-PLAN: DIV/REM contract decoder plan lacks its exact concrete rows"
        var ids: [text] = []
        for row in self.rows:
            val row_error = row.diagnostic(); if row_error != "": return row_error
            if ids.contains(row.id): return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission rows must be unique"
            if not expected_ids.contains(row.id):
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission rows must be the exact concrete M rows"
            val expected_operation = div_operation_code(row.id)
            if row.operation_code != expected_operation:
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission operation codes must match their exact rows"
            val expected_semantic = if expected_operation == 0: 17 elif expected_operation == 1: 18
                elif expected_operation == 2: 37 else: 38
            if row.semantic_opcode != expected_semantic:
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission semantic opcodes must match their exact rows"
            val expected_width = row.id.starts_with("rv64.m.")
            if row.declared_width_is_32 != expected_width:
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission width selectors must match exact rows"
            if row.decoded_row_index >= (1 << self.decoded_row_width):
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission row indices must fit the decoded-uop row width"
            ids.push(row.id)
        for id in expected_ids:
            if not ids.contains(id):
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM admission must cover every concrete M row"
        var exact_index = 0
        for expected in expected_plan_rows:
            val actual = self.rows[exact_index]
            if actual.id != expected.id or actual.encoding_mask != expected.encoding_mask or
                actual.encoding_value != expected.encoding_value or
                actual.decoded_row_index != expected.decoded_row_index or
                actual.semantic_opcode != expected.semantic_opcode or
                actual.operation_code != expected.operation_code or
                actual.declared_width_is_32 != expected.declared_width_is_32:
                return "HWIR-E-RISCV-RUNTIME-DIV-ROW: DIV/REM rows must preserve exact plan order and encoding provenance"
            exact_index = exact_index + 1
        if self.required_metadata_checks != ["decode_legal", "execution_class", "memory_effect",
            "instruction_length", "canonical_original_identity", "canonical_form",
            "decoded_row_index", "semantic_opcode", "declared_operand_width",
            "register_fields", "lineage", "event_identity", "fallthrough_pc"]:
            return "HWIR-E-RISCV-RUNTIME-DIV-METADATA: DIV/REM admission must preserve the full exact metadata check set"
        if self.completion_fields != ["privilege", "original_instruction", "canonical_instruction",
            "instruction_length_bytes", "pc_before", "pc_after", "rd", "rd_write",
            "rd_value", "memory_address", "memory_read_mask", "memory_write_mask",
            "memory_read_data", "memory_write_data", "execute_trap_valid",
            "execute_trap_cause", "execute_trap_tval", "memory_trap_valid",
            "memory_trap_cause", "memory_trap_tval", "redirect_valid", "redirect_target",
            "provider_event_id", "decode_event_id", "illegal_valid"]:
            return "HWIR-E-RISCV-RUNTIME-DIV-COMPLETION: DIV/REM must retain the normalized completion envelope"
        if self.protocol_fault_scope != "accepted_tag_two_request_with_any_admission_or_metadata_mismatch":
            return "HWIR-E-RISCV-RUNTIME-DIV-FAULT-SCOPE: protocol faults must be limited to accepted malformed tag-two requests"
        ""

    me structural_sha256() -> text:
        var fields = [hwir_hash_fields(["riscv-scalar-runtime-div-admission-v1",
            "profile", self.isa_profile, "plan", self.plan_sha256,
            "xlen", self.xlen.to_text(), "row_width", self.decoded_row_width.to_text(),
            "tag", self.provider_tag.to_text(), "class", self.execution_class.to_text(),
            "effect", self.memory_effect.to_text(), "metadata", hwir_hash_fields(self.required_metadata_checks),
            "completion", hwir_hash_fields(self.completion_fields), "fault_scope", self.protocol_fault_scope])]
        for row in self.rows:
            fields.push(hwir_hash_fields(["row", row.canonical_text()]))
        sha256_text(hwir_hash_fields(fields))

fn div_row_width(count: i32) -> i32:
    var width = 1; var capacity = 2
    while capacity <= count:
        width = width + 1; capacity = capacity * 2
    width

fn div_operation_code(id: text) -> i32:
    if id == "rv.m.div" or id == "rv64.m.divw": return 0
    if id == "rv.m.divu" or id == "rv64.m.divuw": return 1
    if id == "rv.m.rem" or id == "rv64.m.remw": return 2
    if id == "rv.m.remu" or id == "rv64.m.remuw": return 3
    -1

fn div_semantic_operation(operation: i32) -> text:
    if operation == 0: return "divide_signed"
    if operation == 1: return "divide_unsigned"
    if operation == 2: return "remainder_signed"
    if operation == 3: return "remainder_unsigned"
    ""

fn div_row_id(id: text) -> bool:
    div_operation_code(id) >= 0

pub fn strict_riscv_scalar_runtime_div_admission(config: CoreConfig,
    plan: RiscvScalarDecoderPlan) -> Result<RiscvScalarRuntimeDivAdmissionContract, text>:
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-DIV-COMPRESSED: v1 requires canonical four-byte instructions")
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-RUNTIME-DIV-CONFIG: admission requires its exact decoder plan")
    if config.isa_profile != "rv32im" and config.isa_profile != "rv64im" and
        config.isa_profile != "rv32im_zicsr_zifencei" and config.isa_profile != "rv64im_zicsr_zifencei":
        return Err("HWIR-E-RISCV-RUNTIME-DIV-SCOPE: admission requires an IM plan with DIV/REM rows")
    var rows: [RiscvScalarRuntimeDivAdmissionRow] = []
    var index = 0
    for entry in plan.entries:
        if div_row_id(entry.id):
            val word = entry.operand_width_bits == 32
            val writeback_ok = if word:
                config.xlen == 64 and entry.writeback_rule == "rd=sign_extend_to_xlen"
            else:
                entry.writeback_rule == "rd=result"
            if entry.execution_class != "multiply-divide" or entry.memory_effect != "none" or
                not writeback_ok:
                return Err("HWIR-E-RISCV-RUNTIME-DIV-METADATA: DIV/REM rows require exact non-memory result metadata")
            val operation = div_operation_code(entry.id)
            val expected_semantic = div_semantic_operation(operation)
            if entry.semantic_operation != expected_semantic:
                return Err("HWIR-E-RISCV-RUNTIME-DIV-METADATA: DIV/REM row semantic must match its operation code")
            if (word and config.xlen != 64) or (not word and entry.operand_width_bits != 0):
                return Err("HWIR-E-RISCV-RUNTIME-DIV-WIDTH: DIV/REM row width must match its concrete product")
            rows.push(RiscvScalarRuntimeDivAdmissionRow(id: entry.id,
                encoding_mask: entry.encoding_mask, encoding_value: entry.encoding_value,
                decoded_row_index: index + 1,
                semantic_opcode: riscv_scalar_semantic_opcode(entry.semantic_operation),
                operation_code: operation, declared_width_is_32: word))
        index = index + 1
    val contract = RiscvScalarRuntimeDivAdmissionContract(isa_profile: config.isa_profile,
        plan_sha256: plan.structural_sha256(),
        xlen: config.xlen, decoded_row_width: div_row_width(plan.entries.len()),
        provider_tag: 2, execution_class: 4, memory_effect: 0, rows: rows,
        required_metadata_checks: ["decode_legal", "execution_class", "memory_effect",
            "instruction_length", "canonical_original_identity", "canonical_form",
            "decoded_row_index", "semantic_opcode", "declared_operand_width",
            "register_fields", "lineage", "event_identity", "fallthrough_pc"],
        completion_fields: ["privilege", "original_instruction", "canonical_instruction",
            "instruction_length_bytes", "pc_before", "pc_after", "rd", "rd_write",
            "rd_value", "memory_address", "memory_read_mask", "memory_write_mask",
            "memory_read_data", "memory_write_data", "execute_trap_valid",
            "execute_trap_cause", "execute_trap_tval", "memory_trap_valid",
            "memory_trap_cause", "memory_trap_tval", "redirect_valid", "redirect_target",
            "provider_event_id", "decode_event_id", "illegal_valid"],
        protocol_fault_scope: "accepted_tag_two_request_with_any_admission_or_metadata_mismatch")
    val diagnostic = contract.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(contract)
