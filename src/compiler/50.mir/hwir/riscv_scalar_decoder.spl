# Declarative scalar ISA plan to fixed-XLEN typed HWIR decoder.
#
# The generated graph returns an explicit legal bit, stable one-based row
# index, and the original canonical 32-bit instruction. Illegal inputs produce
# all-zero outputs. No XLEN, extension, provider, or text metadata is selected
# at runtime.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwCompareOp,
    HwConstant, HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort,
    HwSelectOp, HwSignal}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_database_diagnostic, riscv_scalar_semantic_opcode}

fn scalar_decoder_row_width(row_count: i32) -> i32:
    var width = 1
    var capacity = 2
    while capacity <= row_count:
        width = width + 1
        capacity = capacity * 2
    width

fn scalar_decoder_execution_class(value: text) -> i64:
    if value == "integer" or value == "integer-word": return 1
    if value == "control-flow": return 2
    if value == "load-store": return 3
    if value == "multiply-divide": return 4
    if value == "system": return 5
    if value == "csr": return 6
    if value == "memory-order": return 7
    0

fn scalar_decoder_memory_effect(value: text) -> i64:
    if value == "load": return 1
    if value == "store": return 2
    if value == "csr": return 3
    if value == "fence": return 4
    0

pub fn strict_riscv_scalar_decoder_hwir(module_name: text, config: CoreConfig,
    plan: RiscvScalarDecoderPlan) -> Result<HwModuleDef, text>:
    if module_name == "":
        return Err("HWIR-E-RISCV-DECODER-ID: scalar decoder requires a module name")
    val plan_error = plan.diagnostic()
    if plan_error != "": return Err(plan_error)
    val table_error = riscv_scalar_database_diagnostic(plan.entries)
    if table_error != "": return Err(table_error)
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-DECODER-CONFIG: decoder plan must match the concrete CoreConfig")
    val row_width = scalar_decoder_row_width(plan.entries.len())
    val ports = [HwPort.input("instruction", "Bits", 32),
        HwPort.output("decoded_valid", "Bits", 1),
        HwPort.output("decoded_row_index", "Bits", row_width),
        HwPort.output("canonical_instruction", "Bits", 32),
        HwPort.output("decoded_execution_class", "Bits", 3),
        HwPort.output("decoded_memory_effect", "Bits", 3),
        HwPort.output("decoded_semantic_opcode", "Bits", 6),
        HwPort.output("decoded_operand_width_32", "Bits", 1),
        HwPort.output("instruction_rd_field", "Bits", 5),
        HwPort.output("instruction_rs1_field", "Bits", 5),
        HwPort.output("instruction_rs2_field", "Bits", 5)]
    var signals: [HwSignal] = []
    var constants = [HwConstant.bits("zero1", 1, 0),
        HwConstant.bits("one1", 1, 1),
        HwConstant.bits("zero_row", row_width, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero5", 5, 0),
        HwConstant.bits("zero3", 3, 0),
        HwConstant.bits("zero6", 6, 0),
        HwConstant.bits("shift7", 32, 7), HwConstant.bits("shift15", 32, 15),
        HwConstant.bits("shift20", 32, 20)]
    var comb_ops: [HwCombOp] = []
    var compare_ops: [HwCompareOp] = []
    var select_ops: [HwSelectOp] = []
    var origins: [HwOrigin] = [HwOrigin(
        node_id: HwNodeId.child(module_name, "decoder.plan"),
        source_name: "riscv.scalar.decoder." + plan.isa_profile)]
    var previous_valid = "zero1"
    var previous_row = "zero_row"
    var previous_instruction = "zero32"
    var previous_execution_class = "zero3"
    var previous_memory_effect = "zero3"
    var previous_semantic_opcode = "zero6"
    var previous_operand_width_32 = "zero1"
    var row_index = 0
    # The exact decoder plan is globally overlap-rejected above, so at most one
    # match may be true. The selection chain's textual order is therefore not
    # an architectural priority policy.
    for entry in plan.entries:
        val suffix = row_index.to_text()
        val mask_name = "mask_" + suffix
        val value_name = "value_" + suffix
        val row_name = "row_" + suffix
        val masked_name = "masked_" + suffix
        val match_name = "match_" + suffix
        val valid_name = "valid_" + suffix
        val selected_row_name = "selected_row_" + suffix
        val selected_instruction_name = "selected_instruction_" + suffix
        val execution_class_name = "execution_class_" + suffix
        val memory_effect_name = "memory_effect_" + suffix
        val selected_execution_class_name = "selected_execution_class_" + suffix
        val selected_memory_effect_name = "selected_memory_effect_" + suffix
        val semantic_opcode_name = "semantic_opcode_" + suffix
        val operand_width_32_name = "operand_width_32_" + suffix
        val selected_semantic_opcode_name = "selected_semantic_opcode_" + suffix
        val selected_operand_width_32_name = "selected_operand_width_32_" + suffix
        constants.push(HwConstant.bits(mask_name, 32, entry.encoding_mask as i64))
        constants.push(HwConstant.bits(value_name, 32, entry.encoding_value as i64))
        constants.push(HwConstant.bits(row_name, row_width, (row_index + 1) as i64))
        val execution_class = scalar_decoder_execution_class(entry.execution_class)
        val memory_effect = scalar_decoder_memory_effect(entry.memory_effect)
        val semantic_opcode = riscv_scalar_semantic_opcode(entry.semantic_operation)
        if execution_class == 0 or semantic_opcode == 0:
            return Err("HWIR-E-RISCV-DECODER-CLASS: scalar row has no frozen execution-class or semantic encoding")
        constants.push(HwConstant.bits(execution_class_name, 3, execution_class))
        constants.push(HwConstant.bits(memory_effect_name, 3, memory_effect))
        constants.push(HwConstant.bits(semantic_opcode_name, 6, semantic_opcode))
        constants.push(HwConstant.bits(operand_width_32_name, 1,
            if entry.operand_width_bits == 32: 1 else: 0))
        signals.push(HwSignal(name: masked_name, type_name: "Bits", bit_width: 32))
        signals.push(HwSignal(name: match_name, type_name: "Bits", bit_width: 1))
        signals.push(HwSignal(name: valid_name, type_name: "Bits", bit_width: 1))
        signals.push(HwSignal(name: selected_row_name, type_name: "Bits", bit_width: row_width))
        signals.push(HwSignal(name: selected_instruction_name, type_name: "Bits", bit_width: 32))
        signals.push(HwSignal(name: selected_execution_class_name,
            type_name: "Bits", bit_width: 3))
        signals.push(HwSignal(name: selected_memory_effect_name,
            type_name: "Bits", bit_width: 3))
        signals.push(HwSignal(name: selected_semantic_opcode_name,
            type_name: "Bits", bit_width: 6))
        signals.push(HwSignal(name: selected_operand_width_32_name,
            type_name: "Bits", bit_width: 1))
        comb_ops.push(HwCombOp.binary("and", masked_name, "instruction", mask_name, 32))
        compare_ops.push(HwCompareOp.equal(match_name, masked_name, value_name, 32))
        select_ops.push(HwSelectOp.mux(valid_name, match_name, "one1", previous_valid, 1))
        select_ops.push(HwSelectOp.mux(selected_row_name, match_name, row_name,
            previous_row, row_width))
        select_ops.push(HwSelectOp.mux(selected_instruction_name, match_name,
            "instruction", previous_instruction, 32))
        select_ops.push(HwSelectOp.mux(selected_execution_class_name, match_name,
            execution_class_name, previous_execution_class, 3))
        select_ops.push(HwSelectOp.mux(selected_memory_effect_name, match_name,
            memory_effect_name, previous_memory_effect, 3))
        select_ops.push(HwSelectOp.mux(selected_semantic_opcode_name, match_name,
            semantic_opcode_name, previous_semantic_opcode, 6))
        select_ops.push(HwSelectOp.mux(selected_operand_width_32_name, match_name,
            operand_width_32_name, previous_operand_width_32, 1))
        origins.push(HwOrigin(node_id: HwNodeId.child(module_name,
            "decoder.row." + entry.id), source_name: entry.id))
        previous_valid = valid_name
        previous_row = selected_row_name
        previous_instruction = selected_instruction_name
        previous_execution_class = selected_execution_class_name
        previous_memory_effect = selected_memory_effect_name
        previous_semantic_opcode = selected_semantic_opcode_name
        previous_operand_width_32 = selected_operand_width_32_name
        row_index = row_index + 1
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_valid", previous_valid, 1))
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_row_index", previous_row, row_width))
    comb_ops.push(HwCombOp.unary("passthrough", "canonical_instruction",
        previous_instruction, 32))
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_execution_class",
        previous_execution_class, 3))
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_memory_effect",
        previous_memory_effect, 3))
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_semantic_opcode",
        previous_semantic_opcode, 6))
    comb_ops.push(HwCombOp.unary("passthrough", "decoded_operand_width_32",
        previous_operand_width_32, 1))
    for field in [("rd", "shift7"), ("rs1", "shift15"), ("rs2", "shift20")]:
        val shifted = "instruction_" + field[0] + "_shifted"
        val raw = "instruction_" + field[0] + "_raw"
        signals.push(HwSignal(name: shifted, type_name: "Bits", bit_width: 32))
        signals.push(HwSignal(name: raw, type_name: "Bits", bit_width: 5))
        comb_ops.push(HwCombOp.binary("shr", shifted, "instruction", field[1], 32))
        comb_ops.push(HwCombOp.unary("trunc", raw, shifted, 5))
        select_ops.push(HwSelectOp.mux("instruction_" + field[0] + "_field", previous_valid,
            raw, "zero5", 5))
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: ports.len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0,
        comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins, ports: ports,
        signals: signals, constants: constants, comb_ops: comb_ops,
        compare_ops: compare_ops, select_ops: select_ops,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "": return Err(diagnostic)
    Ok(module)
