            HwSignal.comb("rs2_field", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
            HwSignal.comb("instruction_partial_1", "Bits", 32), HwSignal.comb("instruction_partial_2", "Bits", 32),
            HwSignal.comb("instruction_partial_3", "Bits", 32), HwSignal.comb("instruction_with_funct3", "Bits", 32),
            HwSignal.comb("sw_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_sw_tag", 32, 49152), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("compact_register_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("right_shift_7", 32, 7), HwConstant.bits("right_shift_5", 32, 5),
            HwConstant.bits("imm_bit_mask", 32, 1), HwConstant.bits("left_shift_6", 32, 6),
