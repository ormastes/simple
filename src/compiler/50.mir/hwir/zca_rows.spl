pub fn strict_zca_candi_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed shared C.ANDI row with its signed six-bit immediate.

    Unlike the low-shamt shift rows, bit12 is deliberately absent from the
    classifier because it is C.ANDI immediate bit5.  The graph sign-extends it
    into the canonical ANDI immediate while retaining a concrete RV32/RV64
    elaboration product and no legacy decode path.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 21, register_count: 0, memory_count: 0,
        comb_op_count: 22, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.andi"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.andi"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.andi")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_andi", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd_prime_raw", "Bits", 32), HwSignal.comb("rd_prime", "Bits", 32),
            HwSignal.comb("imm_bit5", "Bits", 32), HwSignal.comb("shifted_2", "Bits", 32),
            HwSignal.comb("imm_low5", "Bits", 32), HwSignal.comb("imm6", "Bits", 32),
            HwSignal.comb("sign_probe", "Bits", 32), HwSignal.comb("is_negative", "Bits", 1),
            HwSignal.comb("sign_fill12", "Bits", 32), HwSignal.comb("imm12", "Bits", 32),
            HwSignal.comb("imm_field", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
            HwSignal.comb("rd_field", "Bits", 32), HwSignal.comb("instruction_partial_1", "Bits", 32),
            HwSignal.comb("instruction_partial_2", "Bits", 32), HwSignal.comb("andi_instruction_with_funct3", "Bits", 32),
            HwSignal.comb("andi_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 60419),
            HwConstant.bits("c_andi_tag", 32, 34817), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("prime_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("imm_bit5_mask", 32, 32), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("imm_low5_mask", 32, 31), HwConstant.bits("sign_mask", 32, 4096),
            HwConstant.bits("negative_sign_probe", 32, 4096), HwConstant.bits("sign_fill", 32, 4032),
            HwConstant.bits("zero_instruction", 32, 0), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("left_shift_15", 32, 15), HwConstant.bits("left_shift_7", 32, 7),
            HwConstant.bits("andi_funct3", 32, 28672), HwConstant.bits("op_imm_opcode", 32, 19)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd_prime_raw", "shifted_7", "prime_mask", 32),
            HwCombOp.binary("or", "rd_prime", "rd_prime_raw", "prime_register_base", 32),
            HwCombOp.binary("and", "imm_bit5", "shifted_7", "imm_bit5_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "imm_low5", "shifted_2", "imm_low5_mask", 32),
            HwCombOp.binary("or", "imm6", "imm_low5", "imm_bit5", 32),
            HwCombOp.binary("and", "sign_probe", "parcel16", "sign_mask", 32),
            HwCombOp.binary("or", "imm12", "imm6", "sign_fill12", 32),
            HwCombOp.binary("shl", "imm_field", "imm12", "left_shift_20", 32),
            HwCombOp.binary("shl", "rs1_field", "rd_prime", "left_shift_15", 32),
            HwCombOp.binary("shl", "rd_field", "rd_prime", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial_1", "imm_field", "rs1_field", 32),
            HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "rd_field", 32),
            HwCombOp.binary("or", "andi_instruction_with_funct3", "instruction_partial_2", "andi_funct3", 32),
            HwCombOp.binary("or", "andi_instruction", "andi_instruction_with_funct3", "op_imm_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_andi", "opcode_tag", "c_andi_tag", 32),
            HwCompareOp.equal("is_negative", "sign_probe", "negative_sign_probe", 32)
        ],
        select_ops: [
            HwSelectOp.mux("sign_fill12", "is_negative", "sign_fill", "zero_instruction", 32),
            HwSelectOp.mux("canonical_instruction", "is_c_andi", "andi_instruction", "zero_instruction", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

fn strict_zca_compact_r_row_hwir(module_name: text, config: CoreConfig,
    source_name: text, predicate_name: text, tag: i64, funct3: i64, funct7: i64) -> Result<HwModuleDef, text>:
    """Build one approved common compact-register R-type row during elaboration.

    This is compiler-host specialization, not hardware dispatch.  Each public
    wrapper below binds a fixed ISA row and canonical operation before HWIR
    emission.  The closed source-name set prevents accidental unreviewed rows.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    if source_name != "zca.c.sub" and source_name != "zca.c.xor" and source_name != "zca.c.or" and source_name != "zca.c.and":
        return Err("HWIR-E-COMPACT-R-ROW: unsupported compact R-type row")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 17, register_count: 0, memory_count: 0,
        comb_op_count: 18, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: source_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: source_name)
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb(predicate_name, "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd_prime_raw", "Bits", 32), HwSignal.comb("rd_prime", "Bits", 32),
            HwSignal.comb("shifted_2", "Bits", 32), HwSignal.comb("rs2_prime_raw", "Bits", 32),
            HwSignal.comb("rs2_prime", "Bits", 32), HwSignal.comb("rs2_field", "Bits", 32),
            HwSignal.comb("rs1_field", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
            HwSignal.comb("instruction_partial_1", "Bits", 32), HwSignal.comb("instruction_partial_2", "Bits", 32),
            HwSignal.comb("compact_r_instruction_without_funct7", "Bits", 32), HwSignal.comb("compact_r_instruction_with_funct7", "Bits", 32),
            HwSignal.comb("compact_r_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 64611),
            HwConstant.bits("compact_r_tag", 32, tag), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("prime_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("left_shift_15", 32, 15), HwConstant.bits("left_shift_7", 32, 7),
            HwConstant.bits("compact_r_funct3", 32, funct3), HwConstant.bits("compact_r_funct7", 32, funct7), HwConstant.bits("op_opcode", 32, 51),
            HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd_prime_raw", "shifted_7", "prime_mask", 32),
            HwCombOp.binary("or", "rd_prime", "rd_prime_raw", "prime_register_base", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "rs2_prime_raw", "shifted_2", "prime_mask", 32),
            HwCombOp.binary("or", "rs2_prime", "rs2_prime_raw", "prime_register_base", 32),
            HwCombOp.binary("shl", "rs2_field", "rs2_prime", "left_shift_20", 32),
            HwCombOp.binary("shl", "rs1_field", "rd_prime", "left_shift_15", 32),
            HwCombOp.binary("shl", "rd_field", "rd_prime", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial_1", "rs2_field", "rs1_field", 32),
            HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "rd_field", 32),
            HwCombOp.binary("or", "compact_r_instruction_without_funct7", "instruction_partial_2", "compact_r_funct3", 32),
            HwCombOp.binary("or", "compact_r_instruction_with_funct7", "compact_r_instruction_without_funct7", "compact_r_funct7", 32),
            HwCombOp.binary("or", "compact_r_instruction", "compact_r_instruction_with_funct7", "op_opcode", 32)
        ],
        compare_ops: [HwCompareOp.equal(predicate_name, "opcode_tag", "compact_r_tag", 32)],
        select_ops: [HwSelectOp.mux("canonical_instruction", predicate_name, "compact_r_instruction", "zero_instruction", 32)],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

