        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_addi16sp", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd", "Bits", 32), HwSignal.comb("shifted_12", "Bits", 32),
            HwSignal.comb("bit_12", "Bits", 32), HwSignal.comb("imm_9", "Bits", 32),
            HwSignal.comb("shifted_6", "Bits", 32), HwSignal.comb("bit_6", "Bits", 32),
            HwSignal.comb("imm_4", "Bits", 32), HwSignal.comb("shifted_5", "Bits", 32),
            HwSignal.comb("bit_5", "Bits", 32), HwSignal.comb("imm_6", "Bits", 32),
            HwSignal.comb("shifted_3", "Bits", 32), HwSignal.comb("bits_4_3", "Bits", 32),
