pub fn strict_zca_caddi16sp_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the common C.ADDI16SP row with reserved encodings gated out.

    This is Q1/funct3=011 with `rd=x2`. The nonzero signed stack adjustment is
    reconstructed from its discontinuous compressed immediate into a 12-bit
    ADDI immediate. `rd!=x2`, an all-zero immediate, and adjacent C.LUI forms
    produce zero at this row boundary.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 35, register_count: 0, memory_count: 0,
        comb_op_count: 36, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.addi16sp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.addi16sp"),
