            HwCombOp.binary("shl", "imm_high", "imm_bit6", "left_shift_6", 32),
            HwCombOp.binary("shr", "shifted_10", "parcel16", "right_shift_10", 32),
            HwCombOp.binary("and", "imm_mid3", "shifted_10", "imm_mid3_mask", 32),
            HwCombOp.binary("shl", "imm_mid", "imm_mid3", "left_shift_3", 32),
            HwCombOp.binary("shr", "shifted_6", "parcel16", "right_shift_6", 32),
            HwCombOp.binary("and", "imm_bit2", "shifted_6", "imm_bit_mask", 32),
            HwCombOp.binary("shl", "imm_low", "imm_bit2", "left_shift_2", 32),
            HwCombOp.binary("or", "immediate_upper", "imm_high", "imm_mid", 32),
            HwCombOp.binary("or", "immediate", "immediate_upper", "imm_low", 32),
            HwCombOp.binary("shl", "imm_field", "immediate", "left_shift_20", 32),
            HwCombOp.binary("shl", "rs1_field", "rs1_prime", "left_shift_15", 32),
            HwCombOp.binary("shl", "rd_field", "rd_prime", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial_1", "imm_field", "rs1_field", 32),
            HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "rd_field", 32),
            HwCombOp.binary("or", "instruction_with_funct3", "instruction_partial_2", "lw_funct3", 32),
            HwCombOp.binary("or", "lw_instruction", "instruction_with_funct3", "lw_opcode", 32)
        ],
        compare_ops: [HwCompareOp.equal("is_c_lw", "opcode_tag", "c_lw_tag", 32)],
        select_ops: [HwSelectOp.mux("canonical_instruction", "is_c_lw", "lw_instruction", "zero_instruction", 32)],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_sw_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.SW row for one critical product.

    This shared row recognizes Q0/funct3=110, rebuilds its unsigned offset,
    maps both prime register fields to x8..x15, and emits canonical SW.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
