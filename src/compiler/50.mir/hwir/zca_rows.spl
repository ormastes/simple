            HwConstant.bits("c_slli_low_tag", 32, 2), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("shamt_mask", 32, 31), HwConstant.bits("left_shift_20", 32, 20),
