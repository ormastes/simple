pub fn strict_zca_srli_low_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed common C.SRLI row with a five-bit shift amount.

    The full tag fixes quadrant, funct3, mode, and bit12.  This graph therefore
    cannot accept the RV64-only six-bit shift forms or adjacent C.SRAI/C.ANDI
    encodings.  The compressed register prime is rebuilt as `rd' | 8`, which
    is equivalent to `rd' + 8` because `rd'` is constrained to three bits.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 15, register_count: 0, memory_count: 0,
        comb_op_count: 16, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.srli.low"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.srli.low")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_srli_low", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd_prime_raw", "Bits", 32), HwSignal.comb("rd_prime", "Bits", 32),
            HwSignal.comb("shifted_2", "Bits", 32), HwSignal.comb("shamt", "Bits", 32),
            HwSignal.comb("shamt_field", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
            HwSignal.comb("rd_field", "Bits", 32), HwSignal.comb("instruction_partial_1", "Bits", 32),
            HwSignal.comb("instruction_partial_2", "Bits", 32), HwSignal.comb("srli_instruction_with_funct3", "Bits", 32),
            HwSignal.comb("srli_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 64515),
            HwConstant.bits("c_srli_low_tag", 32, 32769), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("prime_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("shamt_mask", 32, 31),
            HwConstant.bits("left_shift_20", 32, 20), HwConstant.bits("left_shift_15", 32, 15),
            HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("srli_funct3", 32, 20480),
            HwConstant.bits("op_imm_opcode", 32, 19), HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd_prime_raw", "shifted_7", "prime_mask", 32),
            HwCombOp.binary("or", "rd_prime", "rd_prime_raw", "prime_register_base", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "shamt", "shifted_2", "shamt_mask", 32),
            HwCombOp.binary("shl", "shamt_field", "shamt", "left_shift_20", 32),
            HwCombOp.binary("shl", "rs1_field", "rd_prime", "left_shift_15", 32),
            HwCombOp.binary("shl", "rd_field", "rd_prime", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial_1", "shamt_field", "rs1_field", 32),
            HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "rd_field", 32),
            HwCombOp.binary("or", "srli_instruction_with_funct3", "instruction_partial_2", "srli_funct3", 32),
            HwCombOp.binary("or", "srli_instruction", "srli_instruction_with_funct3", "op_imm_opcode", 32)
        ],
        compare_ops: [HwCompareOp.equal("is_c_srli_low", "opcode_tag", "c_srli_low_tag", 32)],
        select_ops: [HwSelectOp.mux("canonical_instruction", "is_c_srli_low", "srli_instruction", "zero_instruction", 32)],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_srai_low_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed common C.SRAI row with a five-bit shift amount.

    Its tag differs from C.SRLI by the fixed compressed mode bits.  Bit12 is
    also fixed low, retaining a shared RV32/RV64 five-bit-shift graph and
    rejecting the unproven RV64-only six-bit variants.
