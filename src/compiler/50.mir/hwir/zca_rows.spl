pub fn strict_zca_cadd_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct C.ADD with XLEN-specialized x0-hint canonicalization.

    RV32 canonicalizes C.ADD x0, rs2 to NOP while RV64 retains ADD x0, x0,
    rs2.  This conditional runs during compiler-host elaboration; no XLEN or
    provider selection reaches the emitted circuit.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    var signals: [HwSignal] = [
        HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
        HwSignal.comb("is_c_add", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
        HwSignal.comb("rd", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
        HwSignal.comb("rs1_field", "Bits", 32), HwSignal.comb("shifted_2", "Bits", 32),
        HwSignal.comb("rs2", "Bits", 32), HwSignal.comb("rs2_field", "Bits", 32),
        HwSignal.comb("add_partial_1", "Bits", 32), HwSignal.comb("add_partial_2", "Bits", 32),
        HwSignal.comb("add_instruction", "Bits", 32), HwSignal.comb("rs2_is_zero", "Bits", 1),
        HwSignal.comb("cadd_if_tag", "Bits", 32)
    ]
    var constants: [HwConstant] = [
        HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 61443),
        HwConstant.bits("c_add_tag", 32, 36866), HwConstant.bits("right_shift_7", 32, 7),
        HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("register_mask", 32, 31),
        HwConstant.bits("left_shift_20", 32, 20), HwConstant.bits("left_shift_15", 32, 15),
        HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("op_opcode", 32, 51),
        HwConstant.bits("zero_register", 32, 0), HwConstant.bits("zero_instruction", 32, 0)
    ]
    val comb_ops: [HwCombOp] = [
        HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
        HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
        HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
        HwCombOp.binary("and", "rd", "shifted_7", "register_mask", 32),
        HwCombOp.binary("shl", "rd_field", "rd", "left_shift_7", 32),
        HwCombOp.binary("shl", "rs1_field", "rd", "left_shift_15", 32),
        HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
        HwCombOp.binary("and", "rs2", "shifted_2", "register_mask", 32),
        HwCombOp.binary("shl", "rs2_field", "rs2", "left_shift_20", 32),
        HwCombOp.binary("or", "add_partial_1", "rs2_field", "rs1_field", 32),
        HwCombOp.binary("or", "add_partial_2", "add_partial_1", "rd_field", 32),
        HwCombOp.binary("or", "add_instruction", "add_partial_2", "op_opcode", 32)
    ]
    var compare_ops: [HwCompareOp] = [
        HwCompareOp.equal("is_c_add", "opcode_tag", "c_add_tag", 32),
        HwCompareOp.equal("rs2_is_zero", "rs2", "zero_register", 32)
    ]
    var select_ops: [HwSelectOp] = [
        HwSelectOp.mux("cadd_if_tag", "is_c_add", "add_instruction", "zero_instruction", 32)
    ]
    if config.xlen == 32:
        signals.push(HwSignal.comb("rd_is_zero", "Bits", 1))
        signals.push(HwSignal.comb("cadd_if_rd", "Bits", 32))
        constants.push(HwConstant.bits("nop_instruction", 32, 19))
        compare_ops.push(HwCompareOp.equal("rd_is_zero", "rd", "zero_register", 32))
        select_ops.push(HwSelectOp.mux("cadd_if_rd", "rd_is_zero", "nop_instruction", "cadd_if_tag", 32))
        select_ops.push(HwSelectOp.mux("canonical_instruction", "rs2_is_zero", "zero_instruction", "cadd_if_rd", 32))
    else:
        select_ops.push(HwSelectOp.mux("canonical_instruction", "rs2_is_zero", "zero_instruction", "cadd_if_tag", 32))
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: signals.len(), register_count: 0, memory_count: 0,
        comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(), clock_domain_count: 1,
        fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.add"),
            HwOrigin(node_id: HwNodeId.child(module_name, "xlen_hint"), source_name: "zca.c.add"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.add")
        ], ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: signals, constants: constants, comb_ops: comb_ops, compare_ops: compare_ops,
        select_ops: select_ops, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)
