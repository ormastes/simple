pub fn strict_zca_cjr_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.JR control-transfer row with reserved-rd rejection."""
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 9, register_count: 0, memory_count: 0,
        comb_op_count: 10, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.jr"),
            HwOrigin(node_id: HwNodeId.child(module_name, "reserved"), source_name: "zca.c.jr"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.jr")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_jr", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rs1", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
            HwSignal.comb("jr_instruction", "Bits", 32), HwSignal.comb("rd_is_zero", "Bits", 1),
            HwSignal.comb("cjr_if_tag", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 61567),
            HwConstant.bits("c_jr_tag", 32, 32770), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("left_shift_15", 32, 15),
            HwConstant.bits("jalr_opcode", 32, 103), HwConstant.bits("zero_register", 32, 0),
            HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rs1", "shifted_7", "register_mask", 32),
            HwCombOp.binary("shl", "rs1_field", "rs1", "left_shift_15", 32),
            HwCombOp.binary("or", "jr_instruction", "rs1_field", "jalr_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_jr", "opcode_tag", "c_jr_tag", 32),
            HwCompareOp.equal("rd_is_zero", "rs1", "zero_register", 32)
        ],
        select_ops: [
            HwSelectOp.mux("cjr_if_tag", "is_c_jr", "jr_instruction", "zero_instruction", 32),
            HwSelectOp.mux("canonical_instruction", "rd_is_zero", "zero_instruction", "cjr_if_tag", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_cmv_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct C.MV with architectural-hint normalization and C.JR exclusion.

    C.MV is Q2/funct3=100/bit12=0 with a nonzero rs2 field.  The zero-rd
    encoding is a hint and canonicalizes to NOP, matching the shared ISA owner;
    rs2=zero remains outside this row so C.JR/reserved encodings cannot leak in.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 15, register_count: 0, memory_count: 0,
        comb_op_count: 16, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.mv"),
            HwOrigin(node_id: HwNodeId.child(module_name, "hint"), source_name: "zca.c.mv"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.mv")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_mv", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
            HwSignal.comb("shifted_2", "Bits", 32), HwSignal.comb("rs2", "Bits", 32),
            HwSignal.comb("rs2_field", "Bits", 32), HwSignal.comb("mv_partial", "Bits", 32),
            HwSignal.comb("mv_instruction", "Bits", 32), HwSignal.comb("rd_is_zero", "Bits", 1),
            HwSignal.comb("rs2_is_zero", "Bits", 1), HwSignal.comb("cmv_if_tag", "Bits", 32),
            HwSignal.comb("cmv_if_rd", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 61443),
            HwConstant.bits("c_mv_tag", 32, 32770), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("register_mask", 32, 31),
            HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("op_opcode", 32, 51), HwConstant.bits("zero_register", 32, 0),
            HwConstant.bits("nop_instruction", 32, 19), HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd", "shifted_7", "register_mask", 32),
            HwCombOp.binary("shl", "rd_field", "rd", "left_shift_7", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "rs2", "shifted_2", "register_mask", 32),
            HwCombOp.binary("shl", "rs2_field", "rs2", "left_shift_20", 32),
            HwCombOp.binary("or", "mv_partial", "rs2_field", "rd_field", 32),
            HwCombOp.binary("or", "mv_instruction", "mv_partial", "op_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_mv", "opcode_tag", "c_mv_tag", 32),
            HwCompareOp.equal("rd_is_zero", "rd", "zero_register", 32),
            HwCompareOp.equal("rs2_is_zero", "rs2", "zero_register", 32)
        ],
        select_ops: [
            HwSelectOp.mux("cmv_if_tag", "is_c_mv", "mv_instruction", "zero_instruction", 32),
            HwSelectOp.mux("cmv_if_rd", "rd_is_zero", "nop_instruction", "cmv_if_tag", 32),
            HwSelectOp.mux("canonical_instruction", "rs2_is_zero", "zero_instruction", "cmv_if_rd", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

