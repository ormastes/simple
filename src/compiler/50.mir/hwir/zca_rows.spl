# Proven common-Zca row constructors for the strict HWIR boundary.
#
# These are elaboration-time graph definitions, not a runtime decoder table.
# Real-MIR shape extractors may invoke them only after validating the complete
# semantic source shape for the corresponding declarative ISA entry.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwCompareOp, HwConstant, HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.predecode.{strict_riscv_predecode_interface}
use compiler.mir.hwir.branch_predecode.{strict_riscv_branch_predecode_interface}

pub fn strict_zca_cebreak_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.EBREAK parcel row for one critical product.

    The row recognizes only parcel `0x9002` and emits canonical `EBREAK`.
    It is a compile-time graph constructor, never a runtime extension lookup.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 1, register_count: 0, memory_count: 0,
        comb_op_count: 2, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.ebreak"),
            HwOrigin(node_id: HwNodeId.child(module_name, "select"), source_name: "zca.c.ebreak")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [HwSignal.comb("is_cebreak", "Bits", 1)],
        constants: [
            HwConstant.bits("cebreak_parcel", 32, 36866),
            HwConstant.bits("canonical_ebreak", 32, 1048691),
            HwConstant.bits("illegal_instruction", 32, 0)
        ],
        comb_ops: [],
        compare_ops: [HwCompareOp.equal("is_cebreak", "parcel", "cebreak_parcel", 32)],
        select_ops: [HwSelectOp.mux("canonical_instruction", "is_cebreak", "canonical_ebreak", "illegal_instruction", 32)],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

fn strict_zca_cj_like_predecode_row_hwir(module_name: text, config: CoreConfig,
    compressed_tag: i64, isa_name: text, jal_link_field: i64) -> Result<HwModuleDef, text>:
    """Construct C.J/C.JAL as a closed predecode and fetch-redirect graph.

    The port list comes directly from the frozen predecode interface.  The
    selected product fixes the address width before this graph is built; the
    emitted RTL contains neither XLEN selection nor a decoder-provider path.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    val predecode_contract = match strict_riscv_predecode_interface(config):
        case Ok(value): value
        case Err(diagnostic): return Err(diagnostic)
    val address_bits = config.physical_address_bits
    val signals: [HwSignal] = [
        HwSignal.comb("opcode_tag", "Bits", 16), HwSignal.comb("is_c_j", "Bits", 1),
        HwSignal.comb("imm_sign_bit", "Bits", 16), HwSignal.comb("imm_bit_11", "Bits", 16),
        HwSignal.comb("imm_bit_4_source", "Bits", 16), HwSignal.comb("imm_bit_4", "Bits", 16),
        HwSignal.comb("imm_bits_9_8_source", "Bits", 16), HwSignal.comb("imm_bits_9_8", "Bits", 16),
        HwSignal.comb("imm_bit_10_source", "Bits", 16), HwSignal.comb("imm_bit_10", "Bits", 16),
        HwSignal.comb("imm_bit_6_source", "Bits", 16), HwSignal.comb("imm_bit_6", "Bits", 16),
        HwSignal.comb("imm_bit_7_source", "Bits", 16), HwSignal.comb("imm_bit_7", "Bits", 16),
        HwSignal.comb("imm_bits_3_1_source", "Bits", 16), HwSignal.comb("imm_bits_3_1", "Bits", 16),
        HwSignal.comb("imm_bit_5_source", "Bits", 16), HwSignal.comb("imm_bit_5", "Bits", 16),
        HwSignal.comb("imm_partial_1", "Bits", 16),
        HwSignal.comb("imm_partial_2", "Bits", 16), HwSignal.comb("imm_partial_3", "Bits", 16),
        HwSignal.comb("imm_partial_4", "Bits", 16), HwSignal.comb("imm_partial_5", "Bits", 16),
        HwSignal.comb("imm_partial_6", "Bits", 16), HwSignal.comb("imm_low", "Bits", 16),
        HwSignal.comb("sign_is_clear", "Bits", 1), HwSignal.comb("immediate_negative", "Bits", 16),
        HwSignal.comb("immediate_signed", "Bits", 16), HwSignal.comb("immediate32", "Bits", 32),
        HwSignal.comb("immediate_pa", "Bits", address_bits), HwSignal.comb("canonical_sign_source", "Bits", 32),
        HwSignal.comb("canonical_sign", "Bits", 32), HwSignal.comb("canonical_bits30_21_source", "Bits", 32),
        HwSignal.comb("canonical_bits30_21", "Bits", 32), HwSignal.comb("canonical_bit20_source", "Bits", 32),
        HwSignal.comb("canonical_bit20", "Bits", 32), HwSignal.comb("canonical_bits19_12", "Bits", 32),
        HwSignal.comb("canonical_partial_1", "Bits", 32), HwSignal.comb("canonical_partial_2", "Bits", 32),
        HwSignal.comb("canonical_without_opcode", "Bits", 32), HwSignal.comb("jal_with_link", "Bits", 32),
        HwSignal.comb("jal_instruction", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", address_bits), HwSignal.comb("raw_redirect_target", "Bits", address_bits)
    ]
    val constants: [HwConstant] = [
        HwConstant.bits("c_j_tag_mask", 16, 57347), HwConstant.bits("c_j_tag", 16, compressed_tag),
        HwConstant.bits("parcel_bit_12", 16, 4096), HwConstant.bits("parcel_bit_11", 16, 2048),
        HwConstant.bits("parcel_bits_10_9", 16, 1536), HwConstant.bits("parcel_bit_8", 16, 256),
        HwConstant.bits("parcel_bit_7", 16, 128), HwConstant.bits("parcel_bit_6", 16, 64),
        HwConstant.bits("parcel_bits_5_3", 16, 56), HwConstant.bits("parcel_bit_2", 16, 4),
        HwConstant.bits("right_shift_1", 16, 1), HwConstant.bits("right_shift_2", 16, 2),
        HwConstant.bits("right_shift_7", 16, 7), HwConstant.bits("left_shift_1", 16, 1),
        HwConstant.bits("left_shift_2", 16, 2), HwConstant.bits("left_shift_3", 16, 3),
        HwConstant.bits("negative_imm_upper", 16, 61440), HwConstant.bits("zero16", 16, 0),
        HwConstant.bits("imm_bit_11_mask32", 32, 2048), HwConstant.bits("imm_bits_10_1_mask32", 32, 2046),
        HwConstant.bits("imm_bits_19_12_mask32", 32, 1044480), HwConstant.bits("left_shift_20", 32, 20),
        HwConstant.bits("left_shift_9", 32, 9), HwConstant.bits("jal_link_register_field", 32, jal_link_field),
        HwConstant.bits("jal_opcode", 32, 111),
        HwConstant.bits("zero_instruction", 32, 0), HwConstant.bits("two_bytes", address_bits, 2),
        HwConstant.bits("two_bytes_length", 2, 2)
    ]
    val comb_ops: [HwCombOp] = [
        HwCombOp.binary("and", "opcode_tag", "original_parcel", "c_j_tag_mask", 16),
        HwCombOp.binary("and", "imm_sign_bit", "original_parcel", "parcel_bit_12", 16),
        HwCombOp.binary("shr", "imm_bit_11", "imm_sign_bit", "right_shift_1", 16),
        HwCombOp.binary("and", "imm_bit_4_source", "original_parcel", "parcel_bit_11", 16),
        HwCombOp.binary("shr", "imm_bit_4", "imm_bit_4_source", "right_shift_7", 16),
        HwCombOp.binary("and", "imm_bits_9_8_source", "original_parcel", "parcel_bits_10_9", 16),
        HwCombOp.binary("shr", "imm_bits_9_8", "imm_bits_9_8_source", "right_shift_1", 16),
        HwCombOp.binary("and", "imm_bit_10_source", "original_parcel", "parcel_bit_8", 16),
        HwCombOp.binary("shl", "imm_bit_10", "imm_bit_10_source", "left_shift_2", 16),
        HwCombOp.binary("and", "imm_bit_6_source", "original_parcel", "parcel_bit_7", 16),
        HwCombOp.binary("shr", "imm_bit_6", "imm_bit_6_source", "right_shift_1", 16),
        HwCombOp.binary("and", "imm_bit_7_source", "original_parcel", "parcel_bit_6", 16),
        HwCombOp.binary("shl", "imm_bit_7", "imm_bit_7_source", "left_shift_1", 16),
        HwCombOp.binary("and", "imm_bits_3_1_source", "original_parcel", "parcel_bits_5_3", 16),
        HwCombOp.binary("shr", "imm_bits_3_1", "imm_bits_3_1_source", "right_shift_2", 16),
        HwCombOp.binary("and", "imm_bit_5_source", "original_parcel", "parcel_bit_2", 16),
        HwCombOp.binary("shl", "imm_bit_5", "imm_bit_5_source", "left_shift_3", 16),
        HwCombOp.binary("or", "imm_partial_1", "imm_bit_11", "imm_bit_4", 16),
        HwCombOp.binary("or", "imm_partial_2", "imm_partial_1", "imm_bits_9_8", 16),
        HwCombOp.binary("or", "imm_partial_3", "imm_partial_2", "imm_bit_10", 16),
        HwCombOp.binary("or", "imm_partial_4", "imm_partial_3", "imm_bit_6", 16),
        HwCombOp.binary("or", "imm_partial_5", "imm_partial_4", "imm_bit_7", 16),
        HwCombOp.binary("or", "imm_partial_6", "imm_partial_5", "imm_bits_3_1", 16),
        HwCombOp.binary("or", "imm_low", "imm_partial_6", "imm_bit_5", 16),
        HwCombOp.binary("or", "immediate_negative", "imm_low", "negative_imm_upper", 16),
        HwCombOp.unary("sext", "immediate32", "immediate_signed", 32),
        HwCombOp.unary("sext", "immediate_pa", "immediate_signed", address_bits),
        HwCombOp.binary("and", "canonical_sign_source", "immediate32", "imm_bit_11_mask32", 32),
        HwCombOp.binary("shl", "canonical_sign", "canonical_sign_source", "left_shift_20", 32),
        HwCombOp.binary("and", "canonical_bits30_21_source", "immediate32", "imm_bits_10_1_mask32", 32),
        HwCombOp.binary("shl", "canonical_bits30_21", "canonical_bits30_21_source", "left_shift_20", 32),
        HwCombOp.binary("and", "canonical_bit20_source", "immediate32", "imm_bit_11_mask32", 32),
        HwCombOp.binary("shl", "canonical_bit20", "canonical_bit20_source", "left_shift_9", 32),
        HwCombOp.binary("and", "canonical_bits19_12", "immediate32", "imm_bits_19_12_mask32", 32),
        HwCombOp.binary("or", "canonical_partial_1", "canonical_sign", "canonical_bits30_21", 32),
        HwCombOp.binary("or", "canonical_partial_2", "canonical_partial_1", "canonical_bit20", 32),
        HwCombOp.binary("or", "canonical_without_opcode", "canonical_partial_2", "canonical_bits19_12", 32),
        HwCombOp.binary("or", "jal_with_link", "canonical_without_opcode", "jal_link_register_field", 32),
        HwCombOp.binary("or", "jal_instruction", "jal_with_link", "jal_opcode", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", address_bits),
        HwCombOp.binary("add", "raw_redirect_target", "fetch_pc", "immediate_pa", address_bits),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_bytes_length", 2),
        HwCombOp.unary("passthrough", "legal", "is_c_j", 1),
        HwCombOp.unary("passthrough", "redirect_valid", "is_c_j", 1)
    ]
    val compare_ops: [HwCompareOp] = [
        HwCompareOp.equal("is_c_j", "opcode_tag", "c_j_tag", 16),
        HwCompareOp.equal("sign_is_clear", "imm_sign_bit", "zero16", 16)
    ]
    val select_ops: [HwSelectOp] = [
        HwSelectOp.mux("immediate_signed", "sign_is_clear", "imm_low", "immediate_negative", 16),
        HwSelectOp.mux("canonical_instruction", "is_c_j", "jal_instruction", "zero_instruction", 32),
        HwSelectOp.mux("redirect_target", "is_c_j", "raw_redirect_target", "fetch_pc", address_bits),
        HwSelectOp.mux("next_pc", "is_c_j", "raw_redirect_target", "fallthrough_pc", address_bits)
    ]
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: predecode_contract.ports().len(), signal_count: signals.len(), register_count: 0, memory_count: 0,
        comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(), clock_domain_count: 1,
        fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "canonical"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "redirect"), source_name: isa_name)
        ], ports: predecode_contract.ports(), signals: signals, constants: constants, comb_ops: comb_ops,
        compare_ops: compare_ops, select_ops: select_ops, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_cj_predecode_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the common C.J row, whose canonical JAL writes x0."""
    strict_zca_cj_like_predecode_row_hwir(module_name, config, 40961, "zca.c.j", 0)

pub fn strict_zca_cjal_rv32_predecode_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct RV32-only C.JAL with its canonical x1 link-register write.

    This row is intentionally outside `zca-common-critical`: the same parcel
    class is RV64 C.ADDIW. A distinct RV32 product must select and prove it
    before it can extend any advertised capability.
    """
    if config.xlen != 32 or config.profile != "riscv-gen2-rv32-zca-cjal-critical" or
        config.isa_profile != "rv32i_zca":
        return Err("HWIR-E-ZCA-CJAL-PROFILE: C.JAL requires the concrete RV32 Zca-C.JAL product profile")
    strict_zca_cj_like_predecode_row_hwir(module_name, config, 8193, "zca.c.jal", 128)

pub fn strict_zca_caddiw_rv64_predecode_row_hwir(module_name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct RV64-only C.ADDIW with an explicit `rd != x0` legality gate.

    This recognizes Q1/funct3=001, reconstructs its signed six-bit immediate,
    and emits `ADDIW rd, rd, imm`.  The same parcel class is RV32 C.JAL, so
    construction is restricted to the dedicated RV64 product profile.
    """
    if module_name == "":
        return Err("HWIR-E-ZCA-ADDIW-ID: C.ADDIW row requires a module name")
    if config.xlen != 64 or config.profile != "riscv-gen2-rv64-zca-addiw-critical" or
        config.isa_profile != "rv64i_zca":
        return Err("HWIR-E-ZCA-ADDIW-PROFILE: C.ADDIW requires the concrete RV64 Zca-ADDIW product profile")
    val contract = strict_riscv_predecode_interface(config)?
    val pa = config.physical_address_bits
    val signals = [
        HwSignal.comb("opcode_tag", "Bits", 16), HwSignal.comb("is_c_addiw", "Bits", 1),
        HwSignal.comb("rd_source", "Bits", 16), HwSignal.comb("rd", "Bits", 16),
        HwSignal.comb("rd_is_zero", "Bits", 1), HwSignal.comb("rd_nonzero", "Bits", 1),
        HwSignal.comb("legal_gate", "Bits", 1), HwSignal.comb("imm_low_source", "Bits", 16),
        HwSignal.comb("imm_low", "Bits", 16), HwSignal.comb("imm_sign_source", "Bits", 16),
        HwSignal.comb("imm_high", "Bits", 16), HwSignal.comb("imm6", "Bits", 16),
        HwSignal.comb("sign_is_clear", "Bits", 1), HwSignal.comb("imm_negative", "Bits", 16),
        HwSignal.comb("imm_signed", "Bits", 16), HwSignal.comb("imm32", "Bits", 32),
        HwSignal.comb("imm_field", "Bits", 32), HwSignal.comb("rd32", "Bits", 32),
        HwSignal.comb("rs1_field", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
        HwSignal.comb("instruction_partial", "Bits", 32), HwSignal.comb("instruction_with_rs1", "Bits", 32),
        HwSignal.comb("instruction_with_rd", "Bits", 32), HwSignal.comb("addiw_instruction", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa)
    ]
    val constants = [
        HwConstant.bits("tag_mask", 16, 57347), HwConstant.bits("c_addiw_tag", 16, 8193),
        HwConstant.bits("right_shift_7", 16, 7), HwConstant.bits("right_shift_2", 16, 2),
        HwConstant.bits("register_mask", 16, 31), HwConstant.bits("imm_low_mask", 16, 31),
        HwConstant.bits("imm_sign_mask", 16, 4096), HwConstant.bits("right_shift_7_sign", 16, 7),
        HwConstant.bits("negative_imm_upper", 16, 65472), HwConstant.bits("zero16", 16, 0),
        HwConstant.bits("zero_flag", 1, 0), HwConstant.bits("one_flag", 1, 1),
        HwConstant.bits("left_shift_20", 32, 20), HwConstant.bits("left_shift_15", 32, 15),
        HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("addiw_opcode", 32, 27),
        HwConstant.bits("zero_instruction", 32, 0), HwConstant.bits("two_bytes", pa, 2),
        HwConstant.bits("two_length", 2, 2)
    ]
    val comb_ops = [
        HwCombOp.binary("and", "opcode_tag", "original_parcel", "tag_mask", 16),
        HwCombOp.binary("shr", "rd_source", "original_parcel", "right_shift_7", 16),
        HwCombOp.binary("and", "rd", "rd_source", "register_mask", 16),
        HwCombOp.binary("shr", "imm_low_source", "original_parcel", "right_shift_2", 16),
        HwCombOp.binary("and", "imm_low", "imm_low_source", "imm_low_mask", 16),
        HwCombOp.binary("and", "imm_sign_source", "original_parcel", "imm_sign_mask", 16),
        HwCombOp.binary("shr", "imm_high", "imm_sign_source", "right_shift_7_sign", 16),
        HwCombOp.binary("or", "imm6", "imm_low", "imm_high", 16),
        HwCombOp.unary("sext", "imm32", "imm_signed", 32),
        HwCombOp.binary("shl", "imm_field", "imm32", "left_shift_20", 32),
        HwCombOp.unary("zext", "rd32", "rd", 32),
        HwCombOp.binary("shl", "rs1_field", "rd32", "left_shift_15", 32),
        HwCombOp.binary("shl", "rd_field", "rd32", "left_shift_7", 32),
        HwCombOp.binary("or", "instruction_partial", "imm_field", "rs1_field", 32),
        HwCombOp.binary("or", "instruction_with_rs1", "instruction_partial", "rd_field", 32),
        HwCombOp.binary("or", "instruction_with_rd", "instruction_with_rs1", "addiw_opcode", 32),
        HwCombOp.unary("passthrough", "addiw_instruction", "instruction_with_rd", 32),
        HwCombOp.binary("and", "legal_gate", "is_c_addiw", "rd_nonzero", 1),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "legal", "legal_gate", 1),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa)
    ]
    val compare_ops = [
        HwCompareOp.equal("is_c_addiw", "opcode_tag", "c_addiw_tag", 16),
        HwCompareOp.equal("rd_is_zero", "rd", "zero16", 16),
        HwCompareOp.equal("sign_is_clear", "imm_sign_source", "zero16", 16)
    ]
    val select_ops = [
        HwSelectOp.mux("rd_nonzero", "rd_is_zero", "zero_flag", "one_flag", 1),
        HwSelectOp.mux("imm_negative", "sign_is_clear", "imm6", "negative_imm_upper", 16),
        HwSelectOp.mux("imm_signed", "sign_is_clear", "imm6", "imm_negative", 16),
        HwSelectOp.mux("canonical_instruction", "legal_gate", "addiw_instruction", "zero_instruction", 32)
    ]
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: contract.ports().len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0, comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.addiw"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.addiw"),
            HwOrigin(node_id: HwNodeId.child(module_name, "canonical"), source_name: "zca.c.addiw")
        ], ports: contract.ports(), signals: signals, constants: constants, comb_ops: comb_ops,
        compare_ops: compare_ops, select_ops: select_ops, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

fn strict_zca_cb_predecode_row_hwir(module_name: text, config: CoreConfig,
    tag: i64, branch_funct3: i64, isa_name: text, branch_when_zero: bool) -> Result<HwModuleDef, text>:
    """Construct one C.BEQZ/C.BNEZ row with an explicit rs1 value.

    `rs1_value` is a concrete XLEN-wide input from the frozen branch-predecode
    interface. The parcel classification remains independent of the operand;
    only redirect validity and next PC depend on the typed zero comparison.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    val branch_contract = match strict_riscv_branch_predecode_interface(config):
        case Ok(value): value
        case Err(diagnostic): return Err(diagnostic)
    val address_bits = config.physical_address_bits
    val signals: [HwSignal] = [
        HwSignal.comb("opcode_tag", "Bits", 16), HwSignal.comb("is_c_branch", "Bits", 1),
        HwSignal.comb("sign_is_clear", "Bits", 1), HwSignal.comb("rs1_is_zero", "Bits", 1),
        HwSignal.comb("rs1_index_matches", "Bits", 1), HwSignal.comb("binding_valid", "Bits", 1),
        HwSignal.comb("rs1_compact_source", "Bits", 16), HwSignal.comb("rs1_compact", "Bits", 16),
        HwSignal.comb("rs1_prime", "Bits", 16), HwSignal.comb("rs1_prime5", "Bits", 5), HwSignal.comb("rs1_prime32", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
        HwSignal.comb("imm_sign_source", "Bits", 16), HwSignal.comb("imm_sign", "Bits", 16),
        HwSignal.comb("imm_bits_7_6_source", "Bits", 16), HwSignal.comb("imm_bits_7_6", "Bits", 16),
        HwSignal.comb("imm_bit_5_source", "Bits", 16), HwSignal.comb("imm_bit_5", "Bits", 16),
        HwSignal.comb("imm_bits_4_3_source", "Bits", 16), HwSignal.comb("imm_bits_4_3", "Bits", 16),
        HwSignal.comb("imm_bits_2_1_source", "Bits", 16), HwSignal.comb("imm_bits_2_1", "Bits", 16),
        HwSignal.comb("imm_partial_1", "Bits", 16), HwSignal.comb("imm_partial_2", "Bits", 16),
        HwSignal.comb("imm_partial_3", "Bits", 16), HwSignal.comb("imm_low", "Bits", 16),
        HwSignal.comb("immediate_negative", "Bits", 16), HwSignal.comb("immediate_signed", "Bits", 16),
        HwSignal.comb("immediate32", "Bits", 32), HwSignal.comb("immediate_pa", "Bits", address_bits),
        HwSignal.comb("canonical_sign_source", "Bits", 32), HwSignal.comb("canonical_sign", "Bits", 32),
        HwSignal.comb("canonical_bits_10_5_source", "Bits", 32), HwSignal.comb("canonical_bits_10_5", "Bits", 32),
        HwSignal.comb("canonical_bits_4_1_source", "Bits", 32), HwSignal.comb("canonical_bits_4_1", "Bits", 32),
        HwSignal.comb("canonical_bit_11_source", "Bits", 32), HwSignal.comb("canonical_bit_11", "Bits", 32),
        HwSignal.comb("canonical_partial_1", "Bits", 32), HwSignal.comb("canonical_partial_2", "Bits", 32),
        HwSignal.comb("canonical_partial_3", "Bits", 32), HwSignal.comb("canonical_with_rs1", "Bits", 32),
        HwSignal.comb("canonical_with_funct3", "Bits", 32), HwSignal.comb("canonical_branch", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", address_bits), HwSignal.comb("raw_redirect_target", "Bits", address_bits),
        HwSignal.comb("branch_condition", "Bits", 1), HwSignal.comb("taken", "Bits", 1)
    ]
    val constants: [HwConstant] = [
        HwConstant.bits("c_branch_tag_mask", 16, 57347), HwConstant.bits("c_branch_tag", 16, tag),
        HwConstant.bits("right_shift_2", 16, 2), HwConstant.bits("compact_mask", 16, 7),
        HwConstant.bits("prime_register_base", 16, 8), HwConstant.bits("left_shift_15", 32, 15),
        HwConstant.bits("parcel_bit_12", 16, 4096), HwConstant.bits("parcel_bits_6_5", 16, 96),
        HwConstant.bits("parcel_bit_2", 16, 4), HwConstant.bits("parcel_bits_11_10", 16, 3072),
        HwConstant.bits("parcel_bits_4_3", 16, 24), HwConstant.bits("right_shift_1", 16, 1),
        HwConstant.bits("right_shift_4", 16, 4), HwConstant.bits("right_shift_7", 16, 7),
        HwConstant.bits("left_shift_1", 16, 1), HwConstant.bits("left_shift_3", 16, 3),
        HwConstant.bits("negative_imm_upper", 16, 65024), HwConstant.bits("zero16", 16, 0),
        HwConstant.bits("imm_bit_12_mask", 32, 4096), HwConstant.bits("imm_bits_10_5_mask", 32, 2016),
        HwConstant.bits("imm_bits_4_1_mask", 32, 30), HwConstant.bits("imm_bit_11_mask", 32, 2048),
        HwConstant.bits("left_shift_19", 32, 19), HwConstant.bits("left_shift_20", 32, 20),
        HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("right_shift_4_32", 32, 4),
        HwConstant.bits("branch_opcode", 32, 99),
        HwConstant.bits("branch_funct3", 32, branch_funct3), HwConstant.bits("zero_instruction", 32, 0),
        HwConstant.bits("two_bytes", address_bits, 2), HwConstant.bits("two_bytes_length", 2, 2),
        HwConstant.bits("zero_xlen", config.xlen, 0),
        HwConstant.bits("branch_when_zero", 1, if branch_when_zero: 1 else: 0),
        HwConstant.bits("branch_when_nonzero", 1, if branch_when_zero: 0 else: 1)
    ]
    val comb_ops: [HwCombOp] = [
        HwCombOp.binary("and", "opcode_tag", "original_parcel", "c_branch_tag_mask", 16),
        HwCombOp.binary("shr", "rs1_compact_source", "original_parcel", "right_shift_7", 16),
        HwCombOp.binary("and", "rs1_compact", "rs1_compact_source", "compact_mask", 16),
        HwCombOp.binary("or", "rs1_prime", "rs1_compact", "prime_register_base", 16),
        HwCombOp.unary("trunc", "rs1_prime5", "rs1_prime", 5),
        HwCombOp.unary("zext", "rs1_prime32", "rs1_prime", 32),
        HwCombOp.binary("shl", "rs1_field", "rs1_prime32", "left_shift_15", 32),
        HwCombOp.binary("and", "imm_sign_source", "original_parcel", "parcel_bit_12", 16),
        HwCombOp.binary("shr", "imm_sign", "imm_sign_source", "right_shift_4", 16),
        HwCombOp.binary("and", "imm_bits_7_6_source", "original_parcel", "parcel_bits_6_5", 16),
        HwCombOp.binary("shl", "imm_bits_7_6", "imm_bits_7_6_source", "left_shift_1", 16),
        HwCombOp.binary("and", "imm_bit_5_source", "original_parcel", "parcel_bit_2", 16),
        HwCombOp.binary("shl", "imm_bit_5", "imm_bit_5_source", "left_shift_3", 16),
        HwCombOp.binary("and", "imm_bits_4_3_source", "original_parcel", "parcel_bits_11_10", 16),
        HwCombOp.binary("shr", "imm_bits_4_3", "imm_bits_4_3_source", "right_shift_7", 16),
        HwCombOp.binary("and", "imm_bits_2_1_source", "original_parcel", "parcel_bits_4_3", 16),
        HwCombOp.binary("shr", "imm_bits_2_1", "imm_bits_2_1_source", "right_shift_2", 16),
        HwCombOp.binary("or", "imm_partial_1", "imm_sign", "imm_bits_7_6", 16),
        HwCombOp.binary("or", "imm_partial_2", "imm_partial_1", "imm_bit_5", 16),
        HwCombOp.binary("or", "imm_partial_3", "imm_partial_2", "imm_bits_4_3", 16),
        HwCombOp.binary("or", "imm_low", "imm_partial_3", "imm_bits_2_1", 16),
        HwCombOp.binary("or", "immediate_negative", "imm_low", "negative_imm_upper", 16),
        HwCombOp.unary("sext", "immediate32", "immediate_signed", 32),
        HwCombOp.unary("sext", "immediate_pa", "immediate_signed", address_bits),
        HwCombOp.binary("and", "canonical_sign_source", "immediate32", "imm_bit_12_mask", 32),
        HwCombOp.binary("shl", "canonical_sign", "canonical_sign_source", "left_shift_19", 32),
        HwCombOp.binary("and", "canonical_bits_10_5_source", "immediate32", "imm_bits_10_5_mask", 32),
        HwCombOp.binary("shl", "canonical_bits_10_5", "canonical_bits_10_5_source", "left_shift_20", 32),
        HwCombOp.binary("and", "canonical_bits_4_1_source", "immediate32", "imm_bits_4_1_mask", 32),
        HwCombOp.binary("shl", "canonical_bits_4_1", "canonical_bits_4_1_source", "left_shift_7", 32),
        HwCombOp.binary("and", "canonical_bit_11_source", "immediate32", "imm_bit_11_mask", 32),
        HwCombOp.binary("shr", "canonical_bit_11", "canonical_bit_11_source", "right_shift_4_32", 32),
        HwCombOp.binary("or", "canonical_partial_1", "canonical_sign", "canonical_bits_10_5", 32),
        HwCombOp.binary("or", "canonical_partial_2", "canonical_partial_1", "canonical_bits_4_1", 32),
        HwCombOp.binary("or", "canonical_partial_3", "canonical_partial_2", "canonical_bit_11", 32),
        HwCombOp.binary("or", "canonical_with_rs1", "canonical_partial_3", "rs1_field", 32),
        HwCombOp.binary("or", "canonical_with_funct3", "canonical_with_rs1", "branch_funct3", 32),
        HwCombOp.binary("or", "canonical_branch", "canonical_with_funct3", "branch_opcode", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", address_bits),
        HwCombOp.binary("add", "raw_redirect_target", "fetch_pc", "immediate_pa", address_bits),
        HwCombOp.binary("and", "binding_valid", "is_c_branch", "rs1_index_matches", 1),
        HwCombOp.binary("and", "taken", "binding_valid", "branch_condition", 1),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_bytes_length", 2),
        HwCombOp.unary("passthrough", "legal", "binding_valid", 1),
        HwCombOp.unary("passthrough", "redirect_valid", "taken", 1)
    ]
    val compare_ops: [HwCompareOp] = [
        HwCompareOp.equal("is_c_branch", "opcode_tag", "c_branch_tag", 16),
        HwCompareOp.equal("sign_is_clear", "imm_sign", "zero16", 16),
        HwCompareOp.equal("rs1_index_matches", "rs1_index", "rs1_prime5", 5),
        HwCompareOp.equal("rs1_is_zero", "rs1_value", "zero_xlen", config.xlen)
    ]
    val select_ops: [HwSelectOp] = [
        HwSelectOp.mux("immediate_signed", "sign_is_clear", "imm_low", "immediate_negative", 16),
        HwSelectOp.mux("branch_condition", "rs1_is_zero", "branch_when_zero", "branch_when_nonzero", 1),
        HwSelectOp.mux("canonical_instruction", "binding_valid", "canonical_branch", "zero_instruction", 32),
        HwSelectOp.mux("redirect_target", "taken", "raw_redirect_target", "fetch_pc", address_bits),
        HwSelectOp.mux("next_pc", "taken", "raw_redirect_target", "fallthrough_pc", address_bits)
    ]
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: branch_contract.ports().len(), signal_count: signals.len(), register_count: 0, memory_count: 0,
        comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(), clock_domain_count: 1,
        fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "operand"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "canonical"), source_name: isa_name),
            HwOrigin(node_id: HwNodeId.child(module_name, "redirect"), source_name: isa_name)
        ], ports: branch_contract.ports(), signals: signals, constants: constants, comb_ops: comb_ops,
        compare_ops: compare_ops, select_ops: select_ops, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_cbeqz_predecode_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct C.BEQZ: redirect only when the explicit rs1 value is zero."""
    strict_zca_cb_predecode_row_hwir(module_name, config, 49153, 0, "zca.c.beqz", true)

pub fn strict_zca_cbnez_predecode_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct C.BNEZ: redirect only when the explicit rs1 value is nonzero."""
    strict_zca_cb_predecode_row_hwir(module_name, config, 57345, 4096, "zca.c.bnez", false)

pub fn strict_zca_addi4spn_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.ADDI4SPN row for one critical product.

    This common RV32/RV64 row recognizes Q0/funct3=000, rebuilds its unsigned
    nonzero immediate, maps rd' into x8..x15, and emits canonical ADDI rd',x2.
    The reserved zero-immediate encoding is gated to zero before target output.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 28, register_count: 0, memory_count: 0,
        comb_op_count: 29, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.addi4spn"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.addi4spn"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.addi4spn"),
            HwOrigin(node_id: HwNodeId.child(module_name, "select"), source_name: "zca.c.addi4spn")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_addi4spn", "Bits", 1), HwSignal.comb("shifted_2", "Bits", 32),
            HwSignal.comb("rd_compact", "Bits", 32), HwSignal.comb("rd_prime", "Bits", 32),
            HwSignal.comb("shifted_7", "Bits", 32), HwSignal.comb("imm_high4", "Bits", 32),
            HwSignal.comb("imm_high", "Bits", 32), HwSignal.comb("shifted_11", "Bits", 32),
            HwSignal.comb("imm_mid2", "Bits", 32), HwSignal.comb("imm_mid", "Bits", 32),
            HwSignal.comb("shifted_5", "Bits", 32), HwSignal.comb("imm_bit3", "Bits", 32),
            HwSignal.comb("imm_low3", "Bits", 32), HwSignal.comb("shifted_6", "Bits", 32),
            HwSignal.comb("imm_bit2", "Bits", 32), HwSignal.comb("imm_low2", "Bits", 32),
            HwSignal.comb("immediate_upper", "Bits", 32), HwSignal.comb("immediate_partial", "Bits", 32),
            HwSignal.comb("immediate", "Bits", 32),
            HwSignal.comb("immediate_is_zero", "Bits", 1), HwSignal.comb("imm_field", "Bits", 32),
            HwSignal.comb("rd_field", "Bits", 32), HwSignal.comb("instruction_partial", "Bits", 32),
            HwSignal.comb("instruction_with_rd", "Bits", 32), HwSignal.comb("addi_instruction", "Bits", 32),
            HwSignal.comb("nonzero_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_addi4spn_tag", 32, 0), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("rd_compact_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("right_shift_7", 32, 7), HwConstant.bits("imm_high4_mask", 32, 15),
            HwConstant.bits("left_shift_6", 32, 6), HwConstant.bits("right_shift_11", 32, 11),
            HwConstant.bits("imm_mid2_mask", 32, 3), HwConstant.bits("left_shift_4", 32, 4),
            HwConstant.bits("right_shift_5", 32, 5), HwConstant.bits("imm_bit_mask", 32, 1),
            HwConstant.bits("left_shift_3", 32, 3), HwConstant.bits("right_shift_6", 32, 6),
            HwConstant.bits("left_shift_2", 32, 2), HwConstant.bits("zero_immediate", 32, 0),
            HwConstant.bits("left_shift_20", 32, 20), HwConstant.bits("left_shift_7", 32, 7),
            HwConstant.bits("sp_rs1_field", 32, 65536), HwConstant.bits("addi_opcode", 32, 19),
            HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "rd_compact", "shifted_2", "rd_compact_mask", 32),
            HwCombOp.binary("or", "rd_prime", "rd_compact", "prime_register_base", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "imm_high4", "shifted_7", "imm_high4_mask", 32),
            HwCombOp.binary("shl", "imm_high", "imm_high4", "left_shift_6", 32),
            HwCombOp.binary("shr", "shifted_11", "parcel16", "right_shift_11", 32),
            HwCombOp.binary("and", "imm_mid2", "shifted_11", "imm_mid2_mask", 32),
            HwCombOp.binary("shl", "imm_mid", "imm_mid2", "left_shift_4", 32),
            HwCombOp.binary("shr", "shifted_5", "parcel16", "right_shift_5", 32),
            HwCombOp.binary("and", "imm_bit3", "shifted_5", "imm_bit_mask", 32),
            HwCombOp.binary("shl", "imm_low3", "imm_bit3", "left_shift_3", 32),
            HwCombOp.binary("shr", "shifted_6", "parcel16", "right_shift_6", 32),
            HwCombOp.binary("and", "imm_bit2", "shifted_6", "imm_bit_mask", 32),
            HwCombOp.binary("shl", "imm_low2", "imm_bit2", "left_shift_2", 32),
            HwCombOp.binary("or", "immediate_upper", "imm_high", "imm_mid", 32),
            HwCombOp.binary("or", "immediate_partial", "immediate_upper", "imm_low3", 32),
            HwCombOp.binary("or", "immediate", "immediate_partial", "imm_low2", 32),
            HwCombOp.binary("shl", "imm_field", "immediate", "left_shift_20", 32),
            HwCombOp.binary("shl", "rd_field", "rd_prime", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial", "imm_field", "sp_rs1_field", 32),
            HwCombOp.binary("or", "instruction_with_rd", "instruction_partial", "rd_field", 32),
            HwCombOp.binary("or", "addi_instruction", "instruction_with_rd", "addi_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_addi4spn", "opcode_tag", "c_addi4spn_tag", 32),
            HwCompareOp.equal("immediate_is_zero", "immediate", "zero_immediate", 32)
        ],
        select_ops: [
            HwSelectOp.mux("nonzero_instruction", "immediate_is_zero", "zero_instruction", "addi_instruction", 32),
            HwSelectOp.mux("canonical_instruction", "is_c_addi4spn", "nonzero_instruction", "zero_instruction", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_lw_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.LW row for one critical product.

    This shared row recognizes Q0/funct3=010, rebuilds its unsigned offset,
    maps both prime register fields to x8..x15, and emits canonical LW.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 27, register_count: 0, memory_count: 0,
        comb_op_count: 28, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.lw"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.lw"),
            HwOrigin(node_id: HwNodeId.child(module_name, "registers"), source_name: "zca.c.lw"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.lw")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_lw", "Bits", 1), HwSignal.comb("shifted_2", "Bits", 32),
            HwSignal.comb("rd_compact", "Bits", 32), HwSignal.comb("rd_prime", "Bits", 32),
            HwSignal.comb("shifted_7", "Bits", 32), HwSignal.comb("rs1_compact", "Bits", 32),
            HwSignal.comb("rs1_prime", "Bits", 32), HwSignal.comb("shifted_5", "Bits", 32),
            HwSignal.comb("imm_bit6", "Bits", 32), HwSignal.comb("imm_high", "Bits", 32),
            HwSignal.comb("shifted_10", "Bits", 32), HwSignal.comb("imm_mid3", "Bits", 32),
            HwSignal.comb("imm_mid", "Bits", 32), HwSignal.comb("shifted_6", "Bits", 32),
            HwSignal.comb("imm_bit2", "Bits", 32), HwSignal.comb("imm_low", "Bits", 32),
            HwSignal.comb("immediate_upper", "Bits", 32), HwSignal.comb("immediate", "Bits", 32),
            HwSignal.comb("imm_field", "Bits", 32), HwSignal.comb("rs1_field", "Bits", 32),
            HwSignal.comb("rd_field", "Bits", 32), HwSignal.comb("instruction_partial_1", "Bits", 32),
            HwSignal.comb("instruction_partial_2", "Bits", 32), HwSignal.comb("instruction_with_funct3", "Bits", 32),
            HwSignal.comb("lw_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_lw_tag", 32, 16384), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("compact_register_mask", 32, 7), HwConstant.bits("prime_register_base", 32, 8),
            HwConstant.bits("right_shift_7", 32, 7), HwConstant.bits("right_shift_5", 32, 5),
            HwConstant.bits("imm_bit_mask", 32, 1), HwConstant.bits("left_shift_6", 32, 6),
            HwConstant.bits("right_shift_10", 32, 10), HwConstant.bits("imm_mid3_mask", 32, 7),
            HwConstant.bits("left_shift_3", 32, 3), HwConstant.bits("right_shift_6", 32, 6),
            HwConstant.bits("left_shift_2", 32, 2), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("left_shift_15", 32, 15), HwConstant.bits("left_shift_7", 32, 7),
            HwConstant.bits("lw_funct3", 32, 8192), HwConstant.bits("lw_opcode", 32, 3),
            HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "rd_compact", "shifted_2", "compact_register_mask", 32),
            HwCombOp.binary("or", "rd_prime", "rd_compact", "prime_register_base", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rs1_compact", "shifted_7", "compact_register_mask", 32),
            HwCombOp.binary("or", "rs1_prime", "rs1_compact", "prime_register_base", 32),
