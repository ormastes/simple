    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 16, register_count: 0, memory_count: 0,
        comb_op_count: 17, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.srai.low"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.srai.low")
