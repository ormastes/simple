pub fn strict_zca_lwsp_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.LWSP row for one critical product.

    This shared stack-relative row recognizes Q2/funct3=010, rejects reserved
    rd=x0 encodings, reconstructs its unsigned offset, and emits canonical LW.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 25, register_count: 0, memory_count: 0,
        comb_op_count: 26, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.lwsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.lwsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "register"), source_name: "zca.c.lwsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.lwsp")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_lwsp", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd", "Bits", 32), HwSignal.comb("shifted_2", "Bits", 32),
            HwSignal.comb("imm_high2", "Bits", 32), HwSignal.comb("imm_high", "Bits", 32),
            HwSignal.comb("shifted_12", "Bits", 32), HwSignal.comb("imm_bit5", "Bits", 32),
            HwSignal.comb("imm_mid", "Bits", 32), HwSignal.comb("shifted_4", "Bits", 32),
            HwSignal.comb("imm_low3", "Bits", 32), HwSignal.comb("imm_low", "Bits", 32),
            HwSignal.comb("immediate_upper", "Bits", 32), HwSignal.comb("immediate_partial", "Bits", 32),
            HwSignal.comb("immediate", "Bits", 32), HwSignal.comb("rd_is_zero", "Bits", 1),
            HwSignal.comb("imm_field", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
            HwSignal.comb("instruction_partial", "Bits", 32), HwSignal.comb("instruction_with_rd", "Bits", 32),
            HwSignal.comb("lw_instruction", "Bits", 32), HwSignal.comb("lw_instruction_with_opcode", "Bits", 32),
            HwSignal.comb("nonzero_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_lwsp_tag", 32, 16386), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("imm_high2_mask", 32, 3), HwConstant.bits("left_shift_6", 32, 6),
            HwConstant.bits("right_shift_12", 32, 12), HwConstant.bits("imm_bit_mask", 32, 1),
            HwConstant.bits("left_shift_5", 32, 5), HwConstant.bits("right_shift_4", 32, 4),
            HwConstant.bits("imm_low3_mask", 32, 7), HwConstant.bits("left_shift_2", 32, 2),
            HwConstant.bits("zero_register", 32, 0), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("sp_rs1_field", 32, 65536),
            HwConstant.bits("lw_funct3", 32, 8192), HwConstant.bits("lw_opcode", 32, 3),
            HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd", "shifted_7", "register_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "imm_high2", "shifted_2", "imm_high2_mask", 32),
            HwCombOp.binary("shl", "imm_high", "imm_high2", "left_shift_6", 32),
            HwCombOp.binary("shr", "shifted_12", "parcel16", "right_shift_12", 32),
            HwCombOp.binary("and", "imm_bit5", "shifted_12", "imm_bit_mask", 32),
            HwCombOp.binary("shl", "imm_mid", "imm_bit5", "left_shift_5", 32),
            HwCombOp.binary("shr", "shifted_4", "parcel16", "right_shift_4", 32),
            HwCombOp.binary("and", "imm_low3", "shifted_4", "imm_low3_mask", 32),
            HwCombOp.binary("shl", "imm_low", "imm_low3", "left_shift_2", 32),
            HwCombOp.binary("or", "immediate_upper", "imm_high", "imm_mid", 32),
            HwCombOp.binary("or", "immediate_partial", "immediate_upper", "imm_low", 32),
            HwCombOp.binary("or", "immediate", "immediate_partial", "zero_register", 32),
            HwCombOp.binary("shl", "imm_field", "immediate", "left_shift_20", 32),
            HwCombOp.binary("shl", "rd_field", "rd", "left_shift_7", 32),
            HwCombOp.binary("or", "instruction_partial", "imm_field", "sp_rs1_field", 32),
            HwCombOp.binary("or", "instruction_with_rd", "instruction_partial", "rd_field", 32),
            HwCombOp.binary("or", "lw_instruction", "instruction_with_rd", "lw_funct3", 32),
            HwCombOp.binary("or", "lw_instruction_with_opcode", "lw_instruction", "lw_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_lwsp", "opcode_tag", "c_lwsp_tag", 32),
            HwCompareOp.equal("rd_is_zero", "rd", "zero_register", 32)
        ],
        select_ops: [
            HwSelectOp.mux("nonzero_instruction", "rd_is_zero", "zero_instruction", "lw_instruction_with_opcode", 32),
            HwSelectOp.mux("canonical_instruction", "is_c_lwsp", "nonzero_instruction", "zero_instruction", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_swsp_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.SWSP row for one critical product.

    This shared stack-relative row recognizes Q2/funct3=110, rebuilds its
    unsigned offset and source register, and emits canonical SW with rs1=x2.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 22, register_count: 0, memory_count: 0,
        comb_op_count: 23, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.swsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.swsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "register"), source_name: "zca.c.swsp"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.swsp")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_swsp", "Bits", 1), HwSignal.comb("shifted_2", "Bits", 32),
            HwSignal.comb("rs2", "Bits", 32), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("imm_high2", "Bits", 32), HwSignal.comb("imm_high", "Bits", 32),
            HwSignal.comb("shifted_9", "Bits", 32), HwSignal.comb("imm_low4", "Bits", 32),
            HwSignal.comb("imm_low", "Bits", 32), HwSignal.comb("immediate", "Bits", 32),
            HwSignal.comb("immediate_shifted_5", "Bits", 32), HwSignal.comb("imm_upper_field", "Bits", 32),
            HwSignal.comb("imm_low_bits", "Bits", 32), HwSignal.comb("imm_low_field", "Bits", 32),
            HwSignal.comb("rs2_field", "Bits", 32), HwSignal.comb("instruction_partial_1", "Bits", 32),
            HwSignal.comb("instruction_partial_2", "Bits", 32), HwSignal.comb("instruction_partial_3", "Bits", 32),
            HwSignal.comb("instruction_with_funct3", "Bits", 32), HwSignal.comb("sw_instruction", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_swsp_tag", 32, 49154), HwConstant.bits("right_shift_2", 32, 2),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("imm_high2_mask", 32, 3), HwConstant.bits("left_shift_6", 32, 6),
            HwConstant.bits("right_shift_9", 32, 9), HwConstant.bits("imm_low4_mask", 32, 15),
            HwConstant.bits("left_shift_2", 32, 2), HwConstant.bits("right_shift_5", 32, 5),
            HwConstant.bits("left_shift_25", 32, 25), HwConstant.bits("imm_low5_mask", 32, 31),
            HwConstant.bits("left_shift_7", 32, 7), HwConstant.bits("left_shift_20", 32, 20),
            HwConstant.bits("sp_rs1_field", 32, 65536), HwConstant.bits("sw_funct3", 32, 8192),
            HwConstant.bits("sw_opcode", 32, 35), HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "rs2", "shifted_2", "register_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "imm_high2", "shifted_7", "imm_high2_mask", 32),
            HwCombOp.binary("shl", "imm_high", "imm_high2", "left_shift_6", 32),
            HwCombOp.binary("shr", "shifted_9", "parcel16", "right_shift_9", 32),
            HwCombOp.binary("and", "imm_low4", "shifted_9", "imm_low4_mask", 32),
            HwCombOp.binary("shl", "imm_low", "imm_low4", "left_shift_2", 32),
            HwCombOp.binary("or", "immediate", "imm_high", "imm_low", 32),
            HwCombOp.binary("shr", "immediate_shifted_5", "immediate", "right_shift_5", 32),
            HwCombOp.binary("shl", "imm_upper_field", "immediate_shifted_5", "left_shift_25", 32),
            HwCombOp.binary("and", "imm_low_bits", "immediate", "imm_low5_mask", 32),
            HwCombOp.binary("shl", "imm_low_field", "imm_low_bits", "left_shift_7", 32),
            HwCombOp.binary("shl", "rs2_field", "rs2", "left_shift_20", 32),
            HwCombOp.binary("or", "instruction_partial_1", "imm_upper_field", "rs2_field", 32),
            HwCombOp.binary("or", "instruction_partial_2", "instruction_partial_1", "sp_rs1_field", 32),
            HwCombOp.binary("or", "instruction_partial_3", "instruction_partial_2", "imm_low_field", 32),
            HwCombOp.binary("or", "instruction_with_funct3", "instruction_partial_3", "sw_funct3", 32),
            HwCombOp.binary("or", "sw_instruction", "instruction_with_funct3", "sw_opcode", 32)
