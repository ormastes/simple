        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_clui_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the common C.LUI row with reserved encodings gated out.

    This is Q1/funct3=011 with a nonzero destination outside x0/x2.  The
    signed six-bit `nzimm` from parcel[12|6:2] is sign-extended to the LUI
    twenty-bit immediate field.  C.ADDI16SP, reserved zero-immediate C.LUI,
    and C.ADDI neighbours all produce zero at this row boundary.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
    if config.compressed_decode_profile != "zca-common-critical":
        return Err("HWIR-E-COMPRESSED-PROFILE: strict Zca row requires zca-common-critical profile")
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: 2, signal_count: 22, register_count: 0, memory_count: 0,
        comb_op_count: 23, clock_domain_count: 1, fallback_function: "",
        cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name),
        origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "classify"), source_name: "zca.c.lui"),
            HwOrigin(node_id: HwNodeId.child(module_name, "immediate"), source_name: "zca.c.lui"),
            HwOrigin(node_id: HwNodeId.child(module_name, "reserved"), source_name: "zca.c.lui"),
            HwOrigin(node_id: HwNodeId.child(module_name, "assemble"), source_name: "zca.c.lui")
        ],
        ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("canonical_instruction", "Bits", 32)],
        signals: [
            HwSignal.comb("parcel16", "Bits", 32), HwSignal.comb("opcode_tag", "Bits", 32),
            HwSignal.comb("is_c_lui", "Bits", 1), HwSignal.comb("shifted_7", "Bits", 32),
            HwSignal.comb("rd", "Bits", 32), HwSignal.comb("imm_bit5", "Bits", 32),
            HwSignal.comb("shifted_2", "Bits", 32), HwSignal.comb("imm_low5", "Bits", 32),
            HwSignal.comb("imm6", "Bits", 32), HwSignal.comb("is_negative", "Bits", 1),
            HwSignal.comb("sign_fill20", "Bits", 32), HwSignal.comb("imm20", "Bits", 32),
            HwSignal.comb("imm_field", "Bits", 32), HwSignal.comb("rd_field", "Bits", 32),
            HwSignal.comb("lui_partial", "Bits", 32), HwSignal.comb("lui_instruction", "Bits", 32),
            HwSignal.comb("rd_is_zero", "Bits", 1), HwSignal.comb("rd_is_sp", "Bits", 1),
            HwSignal.comb("imm_is_zero", "Bits", 1), HwSignal.comb("clui_if_tag", "Bits", 32),
            HwSignal.comb("clui_if_rd0", "Bits", 32), HwSignal.comb("clui_if_rdsp", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_lui_tag", 32, 24577), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("imm_bit5_mask", 32, 32),
            HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("imm_low5_mask", 32, 31),
            HwConstant.bits("negative_imm6", 32, 32), HwConstant.bits("sign_fill", 32, 1048512),
            HwConstant.bits("left_shift_12", 32, 12), HwConstant.bits("left_shift_7", 32, 7),
            HwConstant.bits("lui_opcode", 32, 55), HwConstant.bits("zero_register", 32, 0),
            HwConstant.bits("sp_register", 32, 2), HwConstant.bits("zero_instruction", 32, 0)
        ],
        comb_ops: [
            HwCombOp.binary("and", "parcel16", "parcel", "low_16_mask", 32),
            HwCombOp.binary("and", "opcode_tag", "parcel16", "opcode_tag_mask", 32),
            HwCombOp.binary("shr", "shifted_7", "parcel16", "right_shift_7", 32),
            HwCombOp.binary("and", "rd", "shifted_7", "register_mask", 32),
            HwCombOp.binary("and", "imm_bit5", "shifted_7", "imm_bit5_mask", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "imm_low5", "shifted_2", "imm_low5_mask", 32),
            HwCombOp.binary("or", "imm6", "imm_low5", "imm_bit5", 32),
            HwCombOp.binary("or", "imm20", "imm6", "sign_fill20", 32),
            HwCombOp.binary("shl", "imm_field", "imm20", "left_shift_12", 32),
            HwCombOp.binary("shl", "rd_field", "rd", "left_shift_7", 32),
            HwCombOp.binary("or", "lui_partial", "imm_field", "rd_field", 32),
            HwCombOp.binary("or", "lui_instruction", "lui_partial", "lui_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_lui", "opcode_tag", "c_lui_tag", 32),
            HwCompareOp.equal("rd_is_zero", "rd", "zero_register", 32),
            HwCompareOp.equal("rd_is_sp", "rd", "sp_register", 32),
            HwCompareOp.equal("imm_is_zero", "imm6", "zero_instruction", 32),
            HwCompareOp.equal("is_negative", "imm_bit5", "negative_imm6", 32)
        ],
        select_ops: [
            HwSelectOp.mux("sign_fill20", "is_negative", "sign_fill", "zero_instruction", 32),
            HwSelectOp.mux("clui_if_tag", "is_c_lui", "lui_instruction", "zero_instruction", 32),
            HwSelectOp.mux("clui_if_rd0", "rd_is_zero", "zero_instruction", "clui_if_tag", 32),
            HwSelectOp.mux("clui_if_rdsp", "rd_is_sp", "zero_instruction", "clui_if_rd0", 32),
            HwSelectOp.mux("canonical_instruction", "imm_is_zero", "zero_instruction", "clui_if_rdsp", 32)
        ],
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

