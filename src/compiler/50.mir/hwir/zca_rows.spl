            HwCombOp.binary("and", "bit_5", "shifted_5", "bit_mask", 32),
            HwCombOp.binary("shl", "imm_6", "bit_5", "left_shift_6", 32),
            HwCombOp.binary("shr", "shifted_3", "parcel16", "right_shift_3", 32),
            HwCombOp.binary("and", "bits_4_3", "shifted_3", "two_bit_mask", 32),
            HwCombOp.binary("shl", "imm_8_7", "bits_4_3", "left_shift_8_7", 32),
            HwCombOp.binary("shr", "shifted_2", "parcel16", "right_shift_2", 32),
            HwCombOp.binary("and", "bit_2", "shifted_2", "bit_mask", 32),
            HwCombOp.binary("shl", "imm_5", "bit_2", "left_shift_5", 32),
            HwCombOp.binary("or", "imm_partial_1", "imm_9", "imm_8_7", 32),
            HwCombOp.binary("or", "imm_partial_2", "imm_partial_1", "imm_6", 32),
            HwCombOp.binary("or", "imm_partial_3", "imm_partial_2", "imm_5", 32),
            HwCombOp.binary("or", "imm_raw", "imm_partial_3", "imm_4", 32),
            HwCombOp.binary("or", "imm12", "imm_raw", "sign_fill12", 32),
            HwCombOp.binary("shl", "imm_field", "imm12", "left_shift_20", 32),
            HwCombOp.binary("or", "addi_partial_1", "imm_field", "sp_rs1_field", 32),
            HwCombOp.binary("or", "addi_partial_2", "addi_partial_1", "sp_rd_field", 32),
            HwCombOp.binary("or", "addi_instruction", "addi_partial_2", "addi_opcode", 32)
        ],
        compare_ops: [
            HwCompareOp.equal("is_c_addi16sp", "opcode_tag", "c_addi16sp_tag", 32),
            HwCompareOp.equal("rd_is_sp", "rd", "sp_register", 32),
            HwCompareOp.equal("imm_is_zero", "imm_raw", "zero_instruction", 32),
            HwCompareOp.equal("is_negative", "imm_9", "negative_imm_9", 32)
        ],
        select_ops: [
            HwSelectOp.mux("sign_fill12", "is_negative", "sign_fill", "zero_instruction", 32),
            HwSelectOp.mux("caddi16sp_if_tag", "is_c_addi16sp", "addi_instruction", "zero_instruction", 32),
            HwSelectOp.mux("caddi16sp_if_rd", "rd_is_sp", "caddi16sp_if_tag", "zero_instruction", 32),
