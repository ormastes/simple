        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_cli_row_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Construct the typed C.LI row graph for one concrete critical product.

    The graph recognizes Q1/funct3=010, reconstructs the six-bit signed
    immediate, hard-wires rs1=x0, and emits canonical ADDI. Any other parcel
    produces zero; no host text, XLEN selector, or legacy decoder is present.
    """
    if module_name == "":
        return Err("HWIR-E-MODULE-ID: strict Zca row requires a module name")
    val config_error = config.diagnostic()
    if config_error != "":
        return Err(config_error)
