            HwSignal.comb("bit_2", "Bits", 32), HwSignal.comb("imm_5", "Bits", 32),
            HwSignal.comb("imm_partial_1", "Bits", 32), HwSignal.comb("imm_partial_2", "Bits", 32),
            HwSignal.comb("imm_partial_3", "Bits", 32), HwSignal.comb("imm_raw", "Bits", 32),
            HwSignal.comb("is_negative", "Bits", 1), HwSignal.comb("sign_fill12", "Bits", 32),
            HwSignal.comb("imm12", "Bits", 32), HwSignal.comb("imm_field", "Bits", 32),
            HwSignal.comb("addi_partial_1", "Bits", 32), HwSignal.comb("addi_partial_2", "Bits", 32),
            HwSignal.comb("addi_instruction", "Bits", 32), HwSignal.comb("rd_is_sp", "Bits", 1),
            HwSignal.comb("imm_is_zero", "Bits", 1), HwSignal.comb("caddi16sp_if_tag", "Bits", 32),
            HwSignal.comb("caddi16sp_if_rd", "Bits", 32)
        ],
        constants: [
            HwConstant.bits("low_16_mask", 32, 65535), HwConstant.bits("opcode_tag_mask", 32, 57347),
            HwConstant.bits("c_addi16sp_tag", 32, 24577), HwConstant.bits("right_shift_7", 32, 7),
            HwConstant.bits("register_mask", 32, 31), HwConstant.bits("sp_register", 32, 2),
            HwConstant.bits("right_shift_12", 32, 12), HwConstant.bits("right_shift_6", 32, 6),
            HwConstant.bits("right_shift_5", 32, 5), HwConstant.bits("right_shift_3", 32, 3),
            HwConstant.bits("right_shift_2", 32, 2), HwConstant.bits("bit_mask", 32, 1),
            HwConstant.bits("two_bit_mask", 32, 3), HwConstant.bits("left_shift_9", 32, 9),
            HwConstant.bits("left_shift_8_7", 32, 7), HwConstant.bits("left_shift_6", 32, 6),
            HwConstant.bits("left_shift_5", 32, 5), HwConstant.bits("left_shift_4", 32, 4),
            HwConstant.bits("negative_imm_9", 32, 512), HwConstant.bits("sign_fill", 32, 3072),
