# Global fail-closed fault aggregation for the direct-child runtime pipeline v5.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSignal}

pub class HwScalarRuntimeGlobalFaultGateV5Binding:
    source_owner: text
    source_port: text
    destination_owner: text
    destination_port: text
    bit_width: i32

    me canonical_text() -> text:
        [self.source_owner, self.source_port, self.destination_owner,
            self.destination_port, self.bit_width.to_text()].join("|")

pub fn runtime_global_fault_gate_v5_fault_owner_binding(
    gate_owner: text = "global_fault_gate",
    fault_owner: text = "fault_owner") -> HwScalarRuntimeGlobalFaultGateV5Binding:
    HwScalarRuntimeGlobalFaultGateV5Binding(source_owner: gate_owner,
        source_port: "fault_in", destination_owner: fault_owner,
        destination_port: "fault_in", bit_width: 1)

pub fn runtime_global_fault_owner_v5_sticky_gate_binding(
    fault_owner: text = "fault_owner",
    gate_owner: text = "global_fault_gate") -> HwScalarRuntimeGlobalFaultGateV5Binding:
    HwScalarRuntimeGlobalFaultGateV5Binding(source_owner: fault_owner,
        source_port: "protocol_fault", destination_owner: gate_owner,
        destination_port: "sticky_fault", bit_width: 1)

pub fn strict_riscv_scalar_runtime_global_fault_gate_v5(name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    if name == "":
        return Err("HWIR-E-RISCV-RUNTIME-GLOBAL-FAULT-GATE-V5-ID: gate requires a module name")
    val error = config.diagnostic(); if error != "": return Err(error)
    val faults = ["router_fault", "decoded_uop_skid_fault", "adapter_fault",
        "selector_fault", "pending_fault", "projection_fault", "lsu_fault",
        "fence_fault", "merge_fault", "completion_skid_fault"]
    var ports: [HwPort] = []
    for fault in faults: ports.push(HwPort.input(fault, "Bits", 1))
    # The sequential fault owner clears this feedback on reset; this gate has no state.
    ports.push(HwPort.input("sticky_fault", "Bits", 1))
    # Admission is a valid/ready pair: block both halves once any global fault is visible.
    ports.push(HwPort.input("raw_input_valid", "Bits", 1))
    ports.push(HwPort.input("raw_input_ready", "Bits", 1))
    ports.push(HwPort.input("raw_completion_valid", "Bits", 1))
    ports.push(HwPort.input("raw_completion_ready", "Bits", 1))
    ports.push(HwPort.input("raw_bus_request_valid", "Bits", 1))
    ports.push(HwPort.input("raw_bus_response_ready", "Bits", 1))
    ports.push(HwPort.input("raw_fence_effect_valid", "Bits", 1))
    ports.push(HwPort.input("raw_bus_request_ready", "Bits", 1))
    ports.push(HwPort.input("raw_bus_response_valid", "Bits", 1))
    ports.push(HwPort.input("raw_fence_effect_ready", "Bits", 1))
    ports.push(HwPort.output("fault_in", "Bits", 1))
    ports.push(HwPort.output("input_valid", "Bits", 1))
    ports.push(HwPort.output("input_ready", "Bits", 1))
    ports.push(HwPort.output("completion_valid", "Bits", 1))
    ports.push(HwPort.output("completion_ready", "Bits", 1))
    ports.push(HwPort.output("bus_request_valid", "Bits", 1))
    ports.push(HwPort.output("bus_response_ready", "Bits", 1))
    ports.push(HwPort.output("fence_effect_valid", "Bits", 1))
    ports.push(HwPort.output("bus_request_ready", "Bits", 1))
    ports.push(HwPort.output("bus_response_valid", "Bits", 1))
    ports.push(HwPort.output("fence_effect_ready", "Bits", 1))
    var signals: [HwSignal] = []
    # Ten raw faults reduce through indexes 0..8 (nine intermediate OR nodes).
    for index in 0..9: signals.push(HwSignal.comb("fault_or_" + index.to_text(), "Bits", 1))
    signals.push(HwSignal.comb("global_fault", "Bits", 1))
    signals.push(HwSignal.comb("not_fault", "Bits", 1))
    var ops = [HwCombOp.binary("or", "fault_or_0", faults[0], faults[1], 1)]
    var index = 2
    while index < faults.len():
        ops.push(HwCombOp.binary("or", "fault_or_" + (index - 1).to_text(),
            "fault_or_" + (index - 2).to_text(), faults[index], 1))
        index = index + 1
    ops.push(HwCombOp.unary("passthrough", "fault_in", "fault_or_8", 1))
    ops.push(HwCombOp.binary("or", "global_fault", "fault_or_8", "sticky_fault", 1))
    ops.push(HwCombOp.binary("xor", "not_fault", "global_fault", "one1", 1))
    ops.push(HwCombOp.binary("and", "input_valid", "raw_input_valid", "not_fault", 1))
    ops.push(HwCombOp.binary("and", "input_ready", "raw_input_ready", "not_fault", 1))
    ops.push(HwCombOp.binary("and", "completion_valid", "raw_completion_valid", "not_fault", 1))
    ops.push(HwCombOp.binary("and", "completion_ready", "raw_completion_ready", "not_fault", 1))
    for handshake in ["bus_request_valid", "bus_response_ready", "fence_effect_valid",
            "bus_request_ready", "bus_response_valid", "fence_effect_ready"]:
        ops.push(HwCombOp.binary("and", handshake, "raw_" + handshake, "not_fault", 1))
    val module = HwModuleDef(summary: HwModule(name: name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0,
            memory_count: 0, comb_op_count: ops.len(), clock_domain_count: 1,
            fallback_function: "", cost: HwCostModel.empty()), config: config,
        node_id: HwNodeId.module_root(name), origins: [HwOrigin(
            node_id: HwNodeId.child(name, "global-fault"),
            source_name: "riscv.scalar.runtime-pipeline.v5.global-fail-closed-gate")],
        ports: ports, signals: signals, constants: [HwConstant.bits("one1", 1, 1)],
        comb_ops: ops, compare_ops: [], select_ops: [],
        clock_domains: [HwClockDomain.default_domain()])
    val shape_error = module.shape_diagnostic(); if shape_error != "": return Err(shape_error)
    Ok(module)
