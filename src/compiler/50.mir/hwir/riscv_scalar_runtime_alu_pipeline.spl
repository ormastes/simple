# Closed typed composition for the runtime scalar ALU path.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef, HwNodeId, HwPort}
use compiler.mir.hwir.sequential.{HwSequentialModuleDef}
use compiler.mir.hwir.riscv_scalar_decoder.{strict_riscv_scalar_decoder_hwir}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{HwScalarDecodedUopInterface,
    strict_hw_scalar_decoded_uop_interface}
use compiler.mir.hwir.riscv_scalar_decode_dispatch_owner.{strict_riscv_scalar_decoded_uop_skid}
use compiler.mir.hwir.riscv_scalar_runtime_alu.{strict_riscv_scalar_runtime_alu_hwir}
use compiler.mir.hwir.riscv_scalar_completion_skid.{strict_riscv_scalar_completion_skid}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_support.{
    strict_riscv_scalar_runtime_fault_owner, strict_riscv_scalar_runtime_completion_defaults}
use compiler.mir.hwir.riscv_scalar_runtime_illegal_provider.{strict_riscv_scalar_runtime_illegal_provider}
use compiler.mir.hwir.riscv_scalar_runtime_completion_selector.{
    strict_riscv_scalar_runtime_completion_selector}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_decoder_plan}

pub class HwScalarRuntimeAluPipelineBinding:
    source_owner: text
    source_port: text
    destination_owner: text
    destination_port: text
    bit_width: i32

    me canonical_text() -> text:
        [self.source_owner, self.source_port, self.destination_owner,
            self.destination_port, self.bit_width.to_text()].join("|")

fn pipeline_top_ports(xlen: i32) -> [HwPort]:
    [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("in_valid", "Bits", 1), HwPort.output("in_ready", "Bits", 1),
        HwPort.input("instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("rs1_value", "Bits", xlen), HwPort.input("rs2_value", "Bits", xlen),
        HwPort.input("pc_before", "Bits", xlen), HwPort.input("fallthrough_pc", "Bits", xlen),
        HwPort.input("privilege", "Bits", 2), HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64),
        HwPort.input("completion_ready", "Bits", 1),
        HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("completion_rd", "Bits", 5),
        HwPort.output("completion_rd_write", "Bits", 1),
        HwPort.output("completion_rd_value", "Bits", xlen),
        HwPort.output("completion_pc_after", "Bits", xlen),
        HwPort.output("completion_execute_trap_valid", "Bits", 1),
        HwPort.output("completion_execute_trap_cause", "Bits", xlen),
        HwPort.output("completion_execute_trap_tval", "Bits", xlen),
        HwPort.output("completion_provider_event_id", "Bits", 64),
        HwPort.output("completion_decode_event_id", "Bits", 64),
        HwPort.output("completion_illegal_valid", "Bits", 1),
        HwPort.output("runtime_protocol_fault", "Bits", 1)]

fn add_binding(rows: [HwScalarRuntimeAluPipelineBinding], source_owner: text,
    source_port: text, destination_owner: text, destination_port: text,
    width: i32) -> [HwScalarRuntimeAluPipelineBinding]:
    var result = rows
    result.push(HwScalarRuntimeAluPipelineBinding(source_owner: source_owner,
        source_port: source_port, destination_owner: destination_owner,
        destination_port: destination_port, bit_width: width))
    result

fn pipeline_port_direction(ports: [HwPort], name: text) -> text:
    for port in ports:
        if port.name == name: return port.direction
    ""

fn pipeline_port_width(ports: [HwPort], name: text) -> i32:
    for port in ports:
        if port.name == name: return port.bit_width
    0

fn pipeline_bindings(x: i32, row_width: i32) -> [HwScalarRuntimeAluPipelineBinding]:
    var rows: [HwScalarRuntimeAluPipelineBinding] = []
    rows = add_binding(rows, "composition", "instruction", "decoder", "instruction", 32)
    for owner in ["uop_skid", "completion_skid", "fault_owner"]:
        rows = add_binding(rows, "composition", "clk", owner, "clk", 1)
        rows = add_binding(rows, "composition", "rst", owner, "rst", 1)
    rows = add_binding(rows, "composition", "in_valid", "uop_skid", "upstream_valid", 1)
    val decoder_fields = [("decoded_valid", "decoded_valid", 1),
        ("decoded_row_index", "decoded_row_index", row_width),
        ("decoded_execution_class", "decoded_execution_class", 3),
        ("decoded_memory_effect", "decoded_memory_effect", 3),
        ("decoded_semantic_opcode", "decoded_semantic_opcode", 6),
        ("decoded_operand_width_32", "decoded_declared_operand_width_is_32", 1),
        ("canonical_instruction", "canonical_instruction", 32),
        ("instruction_rd_field", "instruction_rd_field", 5),
        ("instruction_rs1_field", "instruction_rs1_field", 5),
        ("instruction_rs2_field", "instruction_rs2_field", 5)]
    for field in decoder_fields:
        rows = add_binding(rows, "decoder", field[0], "uop_skid",
            "upstream_" + field[1], field[2])
    for field in [("instruction", "original_instruction", 32),
            ("instruction_length_bytes", "instruction_length_bytes", 3),
            ("rs1_value", "rs1_value", x), ("rs2_value", "rs2_value", x),
            ("pc_before", "pc_before", x), ("fallthrough_pc", "fallthrough_pc", x),
            ("privilege", "privilege", 2), ("provider_event_id", "provider_event_id", 64),
            ("decode_event_id", "decode_event_id", 64)]:
        rows = add_binding(rows, "composition", field[0], "uop_skid",
            "upstream_" + field[1], field[2])
    val alu_inputs = [("uop_valid", 1), ("decode_legal", 1),
        ("decoded_row_index", row_width), ("decoded_execution_class", 3),
        ("decoded_memory_effect", 3), ("decoded_semantic_opcode", 6),
        ("decoded_declared_operand_width_is_32", 1), ("canonical_instruction", 32),
        ("original_instruction", 32), ("instruction_length_bytes", 3),
        ("instruction_rd_field", 5), ("instruction_rs1_field", 5),
        ("instruction_rs2_field", 5), ("rs1_value", x), ("rs2_value", x),
        ("pc_before", x), ("fallthrough_pc", x), ("privilege", 2),
        ("provider_event_id", 64), ("decode_event_id", 64), ("lineage_valid", 1)]
    for field in alu_inputs:
        rows = add_binding(rows, "uop_skid", field[0], "alu", field[0], field[1])
    for field in [("uop_valid", 1), ("decode_legal", 1), ("illegal_valid", 1),
            ("lineage_valid", 1), ("privilege", 2), ("original_instruction", 32),
            ("canonical_instruction", 32), ("instruction_length_bytes", 3),
            ("pc_before", x), ("fallthrough_pc", x), ("provider_event_id", 64),
            ("decode_event_id", 64)]:
        rows = add_binding(rows, "uop_skid", field[0], "illegal_provider", field[0], field[1])
    rows = add_binding(rows, "uop_skid", "uop_valid", "selector", "uop_valid", 1)
    rows = add_binding(rows, "uop_skid", "illegal_valid", "selector", "uop_illegal_valid", 1)
    for field in [("lineage_valid", 1), ("privilege", 2), ("original_instruction", 32),
            ("canonical_instruction", 32), ("instruction_length_bytes", 3),
            ("pc_before", x), ("fallthrough_pc", x), ("provider_event_id", 64),
            ("decode_event_id", 64)]:
        rows = add_binding(rows, "uop_skid", field[0], "selector", "uop_" + field[0], field[1])
    rows = add_binding(rows, "alu", "retire_valid", "selector", "alu_valid", 1)
    rows = add_binding(rows, "alu", "protocol_fault", "selector", "alu_fault", 1)
    rows = add_binding(rows, "illegal_provider", "completion_valid", "selector", "illegal_valid", 1)
    rows = add_binding(rows, "illegal_provider", "protocol_fault", "selector", "illegal_fault", 1)
    rows = add_binding(rows, "completion_skid", "upstream_ready", "selector", "completion_ready", 1)
    rows = add_binding(rows, "selector", "uop_ready", "uop_skid", "uop_ready", 1)
    rows = add_binding(rows, "selector", "selected_valid", "completion_skid", "upstream_valid", 1)
    rows = add_binding(rows, "composition", "completion_ready", "completion_skid", "downstream_ready", 1)
    for field in [("retire_privilege", "privilege", 2),
            ("retire_original_instruction", "original_instruction", 32),
            ("retire_canonical_instruction", "canonical_instruction", 32),
            ("retire_instruction_length_bytes", "instruction_length_bytes", 3),
            ("retire_pc_before", "pc_before", x), ("retire_pc_after", "pc_after", x),
            ("retire_rd", "rd", 5), ("retire_rd_write", "rd_write", 1),
            ("retire_rd_value", "rd_value", x)]:
        rows = add_binding(rows, "alu", field[0], "selector", "alu_" + field[1], field[2])
    for field in [("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
            ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
            ("redirect_valid", 1), ("redirect_target", x)]:
        rows = add_binding(rows, "defaults", field[0],
            "selector", "alu_" + field[0], field[1])
    for field in [("provider_event_id", 64), ("decode_event_id", 64)]:
        rows = add_binding(rows, "uop_skid", field[0], "selector", "alu_" + field[0], field[1])
    rows = add_binding(rows, "defaults", "memory_trap_valid", "selector", "alu_illegal_valid", 1)
    for field in [("privilege", 2), ("original_instruction", 32),
            ("canonical_instruction", 32), ("instruction_length_bytes", 3),
            ("pc_before", x), ("pc_after", x), ("rd", 5), ("rd_write", 1),
            ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
            ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
            ("redirect_valid", 1), ("redirect_target", x), ("provider_event_id", 64),
            ("decode_event_id", 64), ("illegal_valid", 1)]:
        rows = add_binding(rows, "illegal_provider", "completion_" + field[0],
            "selector", "illegal_" + field[0], field[1])
        rows = add_binding(rows, "selector", "selected_" + field[0],
            "completion_skid", "upstream_" + field[0], field[1])
    rows = add_binding(rows, "selector", "selector_fault", "fault_owner", "fault_in", 1)
    rows = add_binding(rows, "uop_skid", "upstream_ready", "composition", "in_ready", 1)
    for field in [("completion_valid", "completion_valid", 1),
            ("completion_rd", "completion_rd", 5),
            ("completion_rd_write", "completion_rd_write", 1),
            ("completion_rd_value", "completion_rd_value", x),
            ("completion_pc_after", "completion_pc_after", x),
            ("completion_execute_trap_valid", "completion_execute_trap_valid", 1),
            ("completion_execute_trap_cause", "completion_execute_trap_cause", x),
            ("completion_execute_trap_tval", "completion_execute_trap_tval", x),
            ("completion_provider_event_id", "completion_provider_event_id", 64),
            ("completion_decode_event_id", "completion_decode_event_id", 64),
            ("completion_illegal_valid", "completion_illegal_valid", 1)]:
        rows = add_binding(rows, "completion_skid", field[0], "composition", field[1], field[2])
    rows = add_binding(rows, "fault_owner", "protocol_fault", "composition",
        "runtime_protocol_fault", 1)
    rows

pub class HwScalarRuntimeAluPipeline:
    node_id: HwNodeId
    module_name: text
    config: CoreConfig
    plan: RiscvScalarDecoderPlan
    descriptor: HwScalarDecodedUopInterface
    decoder: HwModuleDef
    uop_skid: HwSequentialModuleDef
    alu: HwModuleDef
    completion_skid: HwSequentialModuleDef
    illegal_provider: HwModuleDef
    selector: HwModuleDef
    fault_owner: HwSequentialModuleDef
    defaults: HwModuleDef
    top_ports: [HwPort]
    bindings: [HwScalarRuntimeAluPipelineBinding]

    me owner_ports(owner: text) -> [HwPort]:
        if owner == "composition": return self.top_ports
        if owner == "decoder": return self.decoder.ports
        if owner == "uop_skid": return self.uop_skid.ports
        if owner == "alu": return self.alu.ports
        if owner == "completion_skid": return self.completion_skid.ports
        if owner == "illegal_provider": return self.illegal_provider.ports
        if owner == "selector": return self.selector.ports
        if owner == "fault_owner": return self.fault_owner.ports
        if owner == "defaults": return self.defaults.ports
        []

    me local_diagnostic() -> text:
        var destinations: [text] = []
        for row in self.bindings:
            val source_ports = self.owner_ports(row.source_owner)
            val destination_ports = self.owner_ports(row.destination_owner)
            val source_direction = pipeline_port_direction(source_ports, row.source_port)
            val destination_direction = pipeline_port_direction(destination_ports, row.destination_port)
            if ((row.source_owner == "composition" and source_direction != "in") or
                (row.source_owner != "composition" and source_direction != "out") or
                (row.destination_owner == "composition" and destination_direction != "out") or
                (row.destination_owner != "composition" and destination_direction != "in")):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-ENDPOINT: binding endpoint direction is invalid"
            if (pipeline_port_width(source_ports, row.source_port) != row.bit_width or
                pipeline_port_width(destination_ports, row.destination_port) != row.bit_width):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-WIDTH: binding endpoint width is invalid"
            val key = (row.destination_owner + "." + row.destination_port).lower()
            if destinations.contains(key):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-DRIVER: every destination requires one driver"
            destinations.push(key)
        for owner in ["decoder", "uop_skid", "alu", "illegal_provider", "selector",
                "completion_skid", "fault_owner", "defaults"]:
            for port in self.owner_ports(owner):
                if port.direction == "in" and not destinations.contains((owner + "." + port.name).lower()):
                    return "HWIR-E-RISCV-RUNTIME-PIPELINE-INPUT: every child input requires one driver"
        for port in self.top_ports:
            if port.direction == "out" and not destinations.contains(("composition." + port.name).lower()):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-DRIVER: every top output requires one driver"
        ""

    me diagnostic() -> text:
        val local = self.local_diagnostic(); if local != "": return local
        val rebuilt = strict_riscv_scalar_runtime_alu_pipeline(self.module_name, self.config)
        if rebuilt.is_err(): return rebuilt.err().unwrap()
        val canonical = rebuilt.ok().unwrap()
        if self.bindings.len() != canonical.bindings.len():
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-BINDINGS: pipeline requires exact ordered typed bindings"
        var index = 0
        while index < self.bindings.len():
            val row = self.bindings[index]; val expected = canonical.bindings[index]
            if row.canonical_text() != expected.canonical_text():
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-BINDINGS: pipeline requires exact ordered typed bindings"
            index = index + 1
        if self.structural_sha256() != canonical.structural_sha256():
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-HASH: pipeline requires exact compiler-owned child graphs"
        ""

    me structural_sha256() -> text:
        var rows = ["hwir-riscv-scalar-runtime-alu-pipeline/v2", self.node_id.value,
            self.module_name,
            self.config.profile, self.plan.structural_sha256(), self.descriptor.structural_sha256(),
            self.decoder.structural_sha256(), self.uop_skid.structural_sha256(),
            self.alu.structural_sha256(), self.completion_skid.structural_sha256(),
            self.illegal_provider.structural_sha256(), self.selector.structural_sha256(),
            self.fault_owner.structural_sha256(),
            self.defaults.structural_sha256()]
        for port in self.top_ports:
            rows.push([port.name, port.direction, port.bit_width.to_text()].join("|"))
        for binding in self.bindings: rows.push(binding.canonical_text())
        sha256_text(rows.join("\n"))

pub fn strict_riscv_scalar_runtime_alu_pipeline(module_name: text,
    config: CoreConfig) -> Result<HwScalarRuntimeAluPipeline, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-PIPELINE-ID: pipeline requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-PIPELINE-COMPRESSED: runtime ALU pipeline v1 requires canonical four-byte lineage")
    val plan = riscv_scalar_decoder_plan(config.isa_profile)?
    val decoder = strict_riscv_scalar_decoder_hwir(module_name + "_decoder", config, plan)?
    val descriptor = strict_hw_scalar_decoded_uop_interface(config, plan, decoder)?
    val uop_skid = strict_riscv_scalar_decoded_uop_skid(module_name + "_uop_skid",
        plan, decoder, descriptor)?
    val alu = strict_riscv_scalar_runtime_alu_hwir(module_name + "_alu", config, plan)?
    val completion_skid = strict_riscv_scalar_completion_skid(module_name + "_completion_skid", config)?
    val illegal_provider = strict_riscv_scalar_runtime_illegal_provider(module_name + "_illegal", config)?
    val selector = strict_riscv_scalar_runtime_completion_selector(module_name + "_selector", config)?
    val fault_owner = strict_riscv_scalar_runtime_fault_owner(module_name + "_fault_owner", config)?
    val defaults = strict_riscv_scalar_runtime_completion_defaults(module_name + "_defaults", config)?
    val pipeline = HwScalarRuntimeAluPipeline(node_id: HwNodeId.module_root(module_name),
        module_name: module_name, config: config,
        plan: plan, descriptor: descriptor, decoder: decoder, uop_skid: uop_skid, alu: alu,
        completion_skid: completion_skid, illegal_provider: illegal_provider, selector: selector,
        fault_owner: fault_owner,
        defaults: defaults, top_ports: pipeline_top_ports(config.xlen),
        bindings: pipeline_bindings(config.xlen, descriptor.row_width))
    val local = pipeline.local_diagnostic(); if local != "": return Err(local)
    Ok(pipeline)
