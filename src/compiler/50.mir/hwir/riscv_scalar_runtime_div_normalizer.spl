# Plan-bound operand normalization for the dynamic runtime DIV/REM owner.
#
# This is intentionally a capture-time leaf: it owns neither state nor a
# completion channel.  The eventual V7 owner captures these outputs into the
# two restoring-divider geometries.  Keeping row admission here prevents a
# divider from treating arbitrary class-four traffic as a divide operation.

use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}
use compiler.mir.hwir.types.{CoreConfig, HwBitExtractOp, HwCombOp, HwSelectOp, HwSignal}
use compiler.mir.hwir.riscv_scalar_runtime_div_admission.{
    RiscvScalarRuntimeDivAdmissionContract, RiscvScalarRuntimeDivAdmissionRow,
    strict_riscv_scalar_runtime_div_admission}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan}

pub class RiscvScalarRuntimeDivNormalizedOperands:
    row_matched: bool
    operand_width: i32
    lhs_magnitude: i64
    rhs_magnitude: i64
    result_negate: bool
    remainder_negate: bool
    select_remainder: bool
    special_code: i32
    word_result_mode: bool

pub class RiscvScalarRuntimeDivNormalizer:
    admission: RiscvScalarRuntimeDivAdmissionContract
    operand_width: i32
    input_fields: [(text, i32)]
    output_fields: [(text, i32)]
    signals: [HwSignal]
    constants: [HwBitVectorConstant]
    comb_ops: [HwCombOp]
    select_ops: [HwSelectOp]
    bit_extract_ops: [HwBitExtractOp]

    me diagnostic() -> text:
        val admission_error = self.admission.diagnostic(); if admission_error != "": return admission_error
        if self.operand_width != self.admission.xlen and
            not (self.admission.xlen == 64 and self.operand_width == 32):
            return "HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-WIDTH: normalizer requires XLEN or RV64 W geometry"
        if self.input_fields.len() != 6 or self.output_fields.len() != 8:
            return "HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-ABI: normalizer capture ABI has changed"
        if self.input_fields[0][0] != "rs1_value" or self.input_fields[5][0] != "decoded_declared_operand_width_is_32" or
            self.output_fields[0][0] != "row_matched" or self.output_fields[7][0] != "word_result_mode":
            return "HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-ABI: normalizer control names have changed"
        if self.signals.len() < 24 or self.constants.len() < 8 or self.comb_ops.len() < 16 or
            self.select_ops.len() < 4 or self.bit_extract_ops.len() != 2:
            return "HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-SHAPE: normalizer requires closed magnitude and admission controls"
        ""

fn repeat_bits(bit: text, width: i32) -> text:
    var result = ""; var index = 0
    while index < width:
        result = result + bit; index = index + 1
    result

fn fixed_binary(value: i64, width: i32) -> text:
    var result = ""; var bit = width - 1
    while bit >= 0:
        result = result + (if ((value >> bit) & 1) == 1: "1" else: "0")
        bit = bit - 1
    result

fn div_normalizer_row_matches_geometry(row: RiscvScalarRuntimeDivAdmissionRow,
    xlen: i32, operand_width: i32) -> bool:
    if xlen == 64 and operand_width == 32: return row.declared_width_is_32
    not row.declared_width_is_32

fn div_normalizer_signed(operation: i32) -> bool:
    operation == 0 or operation == 2

fn div_normalizer_remainder(operation: i32) -> bool:
    operation == 2 or operation == 3

fn div_normalizer_mask(width: i32) -> i64:
    if width == 64: return -1
    (1 << width) - 1

fn div_normalizer_bits(value: i64, width: i32) -> i64:
    value & div_normalizer_mask(width)

fn div_normalizer_negative(value: i64, width: i32) -> bool:
    if width == 64: return value < 0
    (value & (1 << (width - 1))) != 0

fn div_normalizer_magnitude(value: i64, signed_value: bool, width: i32) -> i64:
    val bits = div_normalizer_bits(value, width)
    if signed_value and div_normalizer_negative(bits, width):
        return div_normalizer_bits(0 - bits, width)
    bits

# Host-level evaluator for exact admitted row controls.  The HWIR graph below
# carries the same normalizing equations into a sequential owner; this helper
# makes the architectural corner cases falsifiable without inventing an owner.
pub fn riscv_scalar_runtime_div_normalize_host(normalizer: RiscvScalarRuntimeDivNormalizer,
    row_id: text, rs1_value: i64, rs2_value: i64) -> Result<RiscvScalarRuntimeDivNormalizedOperands, text>:
    val error = normalizer.diagnostic(); if error != "": return Err(error)
    var chosen: RiscvScalarRuntimeDivAdmissionRow? = nil
    for row in normalizer.admission.rows:
        if row.id == row_id and div_normalizer_row_matches_geometry(row,
            normalizer.admission.xlen, normalizer.operand_width):
            chosen = row
    if chosen == nil:
        return Err("HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-ROW: row is not admitted by this fixed divider geometry")
    val row = chosen.?
    val signed_operation = div_normalizer_signed(row.operation_code)
    val lhs_bits = div_normalizer_bits(rs1_value, normalizer.operand_width)
    val rhs_bits = div_normalizer_bits(rs2_value, normalizer.operand_width)
    val lhs_negative = signed_operation and div_normalizer_negative(lhs_bits, normalizer.operand_width)
    val rhs_negative = signed_operation and div_normalizer_negative(rhs_bits, normalizer.operand_width)
    val divisor_zero = rhs_bits == 0
    val minimum = if normalizer.operand_width == 64: (-1 << 63) else: (1 << 31)
    val all_ones = div_normalizer_mask(normalizer.operand_width)
    val overflow = signed_operation and lhs_bits == minimum and rhs_bits == all_ones
    Ok(RiscvScalarRuntimeDivNormalizedOperands(row_matched: true,
        operand_width: normalizer.operand_width,
        lhs_magnitude: div_normalizer_magnitude(lhs_bits, signed_operation, normalizer.operand_width),
        rhs_magnitude: div_normalizer_magnitude(rhs_bits, signed_operation, normalizer.operand_width),
        result_negate: lhs_negative != rhs_negative, remainder_negate: lhs_negative,
        select_remainder: div_normalizer_remainder(row.operation_code),
        special_code: if divisor_zero: 1 elif overflow: 2 else: 0,
        word_result_mode: row.declared_width_is_32))

pub fn strict_riscv_scalar_runtime_div_normalizer(config: CoreConfig,
    plan: RiscvScalarDecoderPlan, operand_width: i32) -> Result<RiscvScalarRuntimeDivNormalizer, text>:
    val admission = strict_riscv_scalar_runtime_div_admission(config, plan)?
    val x = config.xlen
    if operand_width != x and not (x == 64 and operand_width == 32):
        return Err("HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-WIDTH: normalizer requires XLEN or RV64 W geometry")
    val row_width = admission.decoded_row_width
    val word_geometry = x == 64 and operand_width == 32
    val zero_bits = repeat_bits("0", operand_width)
    val min_bits = "1" + repeat_bits("0", operand_width - 1)
    var signals = [HwSignal.comb("lhs_operand", "Bits", operand_width),
        HwSignal.comb("rhs_operand", "Bits", operand_width), HwSignal.comb("lhs_raw_sign", "Bits", 1),
        HwSignal.comb("rhs_raw_sign", "Bits", 1), HwSignal.comb("lhs_sign", "Bits", 1),
        HwSignal.comb("rhs_sign", "Bits", 1), HwSignal.comb("lhs_negated", "Bits", operand_width),
        HwSignal.comb("rhs_negated", "Bits", operand_width), HwSignal.comb("lhs_magnitude", "Bits", operand_width),
        HwSignal.comb("rhs_magnitude", "Bits", operand_width), HwSignal.comb("divisor_zero", "Bits", 1),
        HwSignal.comb("minimum_lhs", "Bits", 1), HwSignal.comb("minus_one_rhs", "Bits", 1),
        HwSignal.comb("overflow_pair", "Bits", 1), HwSignal.comb("row_matched", "Bits", 1),
        HwSignal.comb("selected_signed", "Bits", 1), HwSignal.comb("selected_remainder", "Bits", 1),
        HwSignal.comb("selected_any", "Bits", 1), HwSignal.comb("result_negate", "Bits", 1),
        HwSignal.comb("remainder_negate", "Bits", 1), HwSignal.comb("select_remainder", "Bits", 1),
        HwSignal.comb("special_overflow", "Bits", 1),
        HwSignal.comb("overflow_or_none", "Bits", 2), HwSignal.comb("raw_special_code", "Bits", 2),
        HwSignal.comb("special_code", "Bits", 2),
        HwSignal.comb("word_result_mode", "Bits", 1)]
    var constants = [HwBitVectorConstant.binary("zero_operand", operand_width, zero_bits),
        HwBitVectorConstant.binary("minimum_operand", operand_width, min_bits),
        HwBitVectorConstant.binary("all_ones_operand", operand_width, repeat_bits("1", operand_width)),
        HwBitVectorConstant.binary("zero1", 1, "0"), HwBitVectorConstant.binary("one1", 1, "1"),
        HwBitVectorConstant.binary("special_none", 2, "00"), HwBitVectorConstant.binary("special_divzero", 2, "01"),
        HwBitVectorConstant.binary("special_overflow_code", 2, "10")]
    var ops = [HwCombOp.unary("trunc", "lhs_operand", "rs1_value", operand_width),
        HwCombOp.unary("trunc", "rhs_operand", "rs2_value", operand_width),
        HwCombOp.binary("sub", "lhs_negated", "zero_operand", "lhs_operand", operand_width),
        HwCombOp.binary("sub", "rhs_negated", "zero_operand", "rhs_operand", operand_width),
        HwCombOp.binary("eq", "divisor_zero", "rhs_operand", "zero_operand", operand_width),
        HwCombOp.binary("eq", "minimum_lhs", "lhs_operand", "minimum_operand", operand_width),
        HwCombOp.binary("eq", "minus_one_rhs", "rhs_operand", "all_ones_operand", operand_width),
        HwCombOp.binary("and", "overflow_pair", "minimum_lhs", "minus_one_rhs", 1),
        HwCombOp.binary("xor", "result_negate", "lhs_sign", "rhs_sign", 1),
        HwCombOp.unary("passthrough", "remainder_negate", "lhs_sign", 1),
        HwCombOp.binary("and", "special_overflow", "overflow_pair", "selected_signed", 1)]
    var selects = [HwSelectOp.mux("lhs_magnitude", "lhs_sign", "lhs_negated", "lhs_operand", operand_width),
        HwSelectOp.mux("rhs_magnitude", "rhs_sign", "rhs_negated", "rhs_operand", operand_width),
        HwSelectOp.mux("overflow_or_none", "special_overflow", "special_overflow_code", "special_none", 2)]
    var selected = "zero1"; var signed = "zero1"; var remainder = "zero1"; var admitted = 0
    var row_index = 0
    for row in admission.rows:
        if div_normalizer_row_matches_geometry(row, x, operand_width):
            val suffix = admitted.to_text(); val mask = "row_mask_" + suffix; val value = "row_value_" + suffix
            val semantic = "row_semantic_" + suffix; val decoded = "row_decoded_" + suffix
            val masked = "row_masked_" + suffix; val form = "row_form_" + suffix; val semantic_ok = "row_semantic_ok_" + suffix
            val index_ok = "row_index_ok_" + suffix; val width_ok = "row_width_ok_" + suffix; val candidate_a = "row_candidate_a_" + suffix
            val candidate_b = "row_candidate_b_" + suffix; val candidate = "row_candidate_" + suffix; val selected_name = "selected_" + suffix
            val signed_name = "signed_" + suffix; val rem_name = "remainder_" + suffix
            for entry in [(masked, 32), (form, 1), (semantic_ok, 1), (index_ok, 1), (width_ok, 1),
                (candidate_a, 1), (candidate_b, 1), (candidate, 1), (selected_name, 1), (signed_name, 1), (rem_name, 1)]:
                signals.push(HwSignal.comb(entry[0], "Bits", entry[1]))
            constants.push(HwBitVectorConstant.binary(mask, 32, fixed_binary(row.encoding_mask as i64, 32)))
            constants.push(HwBitVectorConstant.binary(value, 32, fixed_binary(row.encoding_value as i64, 32)))
            constants.push(HwBitVectorConstant.binary(semantic, 6, fixed_binary(row.semantic_opcode, 6)))
            constants.push(HwBitVectorConstant.binary(decoded, row_width, fixed_binary(row.decoded_row_index as i64, row_width)))
            ops.push(HwCombOp.binary("and", masked, "canonical_instruction", mask, 32))
            ops.push(HwCombOp.binary("eq", form, masked, value, 32))
            ops.push(HwCombOp.binary("eq", semantic_ok, "decoded_semantic_opcode", semantic, 6))
            ops.push(HwCombOp.binary("eq", index_ok, "decoded_row_index", decoded, row_width))
            ops.push(HwCombOp.binary("eq", width_ok, "decoded_declared_operand_width_is_32", if word_geometry: "one1" else: "zero1", 1))
            ops.push(HwCombOp.binary("and", candidate_a, form, semantic_ok, 1))
            ops.push(HwCombOp.binary("and", candidate_b, candidate_a, index_ok, 1))
            ops.push(HwCombOp.binary("and", candidate, candidate_b, width_ok, 1))
            selects.push(HwSelectOp.mux(selected_name, candidate, "one1", selected, 1))
            selects.push(HwSelectOp.mux(signed_name, candidate, if div_normalizer_signed(row.operation_code): "one1" else: "zero1", signed, 1))
            selects.push(HwSelectOp.mux(rem_name, candidate, if div_normalizer_remainder(row.operation_code): "one1" else: "zero1", remainder, 1))
            selected = selected_name; signed = signed_name; remainder = rem_name; admitted = admitted + 1
        row_index = row_index + 1
    if admitted != 4:
        return Err("HWIR-E-RISCV-RUNTIME-DIV-NORMALIZER-SCOPE: each fixed geometry requires exactly four concrete DIV/REM rows")
    ops.push(HwCombOp.unary("passthrough", "selected_any", selected, 1))
    ops.push(HwCombOp.unary("passthrough", "selected_signed", signed, 1))
    ops.push(HwCombOp.unary("passthrough", "selected_remainder", remainder, 1))
    ops.push(HwCombOp.unary("passthrough", "row_matched", "selected_any", 1))
    ops.push(HwCombOp.unary("passthrough", "select_remainder", "selected_remainder", 1))
    selects.push(HwSelectOp.mux("lhs_sign", "selected_signed", "lhs_raw_sign", "zero1", 1))
    selects.push(HwSelectOp.mux("rhs_sign", "selected_signed", "rhs_raw_sign", "zero1", 1))
    selects.push(HwSelectOp.mux("word_result_mode", "selected_any", if word_geometry: "one1" else: "zero1", "zero1", 1))
    selects.push(HwSelectOp.mux("raw_special_code", "divisor_zero", "special_divzero", "overflow_or_none", 2))
    selects.push(HwSelectOp.mux("special_code", "selected_any", "raw_special_code", "special_none", 2))
    val normalizer = RiscvScalarRuntimeDivNormalizer(admission: admission, operand_width: operand_width,
        input_fields: [("rs1_value", x), ("rs2_value", x), ("canonical_instruction", 32),
            ("decoded_row_index", row_width), ("decoded_semantic_opcode", 6),
            ("decoded_declared_operand_width_is_32", 1)],
        output_fields: [("row_matched", 1), ("lhs_magnitude", operand_width), ("rhs_magnitude", operand_width),
            ("result_negate", 1), ("remainder_negate", 1), ("select_remainder", 1),
            ("special_code", 2), ("word_result_mode", 1)],
        signals: signals, constants: constants, comb_ops: ops, select_ops: selects,
        bit_extract_ops: [HwBitExtractOp.fixed("lhs_raw_sign", "lhs_operand", operand_width - 1),
            HwBitExtractOp.fixed("rhs_raw_sign", "rhs_operand", operand_width - 1)])
    val error = normalizer.diagnostic(); if error != "": return Err(error)
    Ok(normalizer)
