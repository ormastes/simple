# Host evaluator for validated strict combinational HWIR.
#
# This is intentionally a compiler-host verification surface. It executes the
# exact typed graph that the strict VHDL emitter consumes, so composed-parcel
# tests never substitute a separate decoder classifier for frontend behavior.

use compiler.mir.hwir.types.{HwCombOp, HwCompareOp, HwModuleDef, HwSelectOp}

pub class HwHostInput:
    name: text
    value: i64

    static fn bits(name: text, value: i64) -> HwHostInput:
        HwHostInput(name: name, value: value)

pub class HwHostValue:
    name: text
    value: i64

pub class HwHostEvaluation:
    """Concrete values produced by one validated strict combinational graph."""
    values: [HwHostValue]

    me value_of(name: text) -> Result<i64, text>:
        for entry in self.values:
            if entry.name == name:
                return Ok(entry.value)
        Err("HWIR-E-HOST-EVAL-VALUE: requested result is absent from the evaluated graph: " + name)

class HwPreparedOperation:
    kind: text
    op: text
    result_slot: i32
    lhs_slot: i32
    rhs_slot: i32
    condition_slot: i32
    bit_width: i32
    source_width: i32

    static fn comb(op: HwCombOp, result_slot: i32, lhs_slot: i32,
        rhs_slot: i32, source_width: i32) -> HwPreparedOperation:
        HwPreparedOperation(kind: "comb", op: op.op, result_slot: result_slot,
            lhs_slot: lhs_slot, rhs_slot: rhs_slot, condition_slot: -1,
            bit_width: op.bit_width, source_width: source_width)

    static fn compare(op: HwCompareOp, result_slot: i32, lhs_slot: i32,
        rhs_slot: i32) -> HwPreparedOperation:
        HwPreparedOperation(kind: "compare", op: "equal", result_slot: result_slot,
            lhs_slot: lhs_slot, rhs_slot: rhs_slot, condition_slot: -1,
            bit_width: 1, source_width: 0)

    static fn select(op: HwSelectOp, result_slot: i32, condition_slot: i32,
        when_true_slot: i32, when_false_slot: i32) -> HwPreparedOperation:
        HwPreparedOperation(kind: "select", op: "mux", result_slot: result_slot,
            lhs_slot: when_true_slot, rhs_slot: when_false_slot,
            condition_slot: condition_slot, bit_width: op.bit_width, source_width: 0)

pub class HwPreparedStrictCombHwir:
    """Validated, topologically scheduled strict combinational HWIR.

    Preparation happens once per graph: name resolution, validation, and the
    dependency schedule are frozen before an exhaustive oracle supplies its
    varying input tuples. Evaluation itself uses only integer slots.
    """
    value_names: [text]
    value_widths: [i32]
    initial_values: [i64]
    initial_known: [bool]
    input_names: [text]
    input_slots: [i32]
    scheduled_ops: [HwPreparedOperation]

    me input_slot(name: text) -> i32:
        var index = 0
        while index < self.input_names.len():
            if self.input_names[index] == name:
                return self.input_slots[index]
            index = index + 1
        -1

    me evaluate(inputs: [HwHostInput]) -> Result<HwHostEvaluation, text>:
        var values = self.initial_values
        var known = self.initial_known
        var supplied: [text] = []
        for input in inputs:
            if input.name == "" or supplied.contains(input.name):
                return Err("HWIR-E-HOST-EVAL-INPUT: host evaluation inputs must have unique non-empty names")
            val slot = self.input_slot(input.name)
            if slot < 0:
                return Err("HWIR-E-HOST-EVAL-INPUT: host evaluation input is not a declared graph input: " + input.name)
            values[slot] = hwir_host_normalize(input.value, self.value_widths[slot])
            known[slot] = true
            supplied.push(input.name)
        for name in self.input_names:
            if not supplied.contains(name):
                return Err("HWIR-E-HOST-EVAL-INPUT: host evaluation is missing declared graph input: " + name)
        for op in self.scheduled_ops:
            if op.kind == "comb":
                values[op.result_slot] = hwir_host_comb_value(op,
                    values[op.lhs_slot], if op.rhs_slot < 0: 0 else: values[op.rhs_slot])?
            elif op.kind == "compare":
                values[op.result_slot] = if values[op.lhs_slot] == values[op.rhs_slot]: 1 else: 0
            else:
                values[op.result_slot] = hwir_host_normalize(
                    if values[op.condition_slot] != 0: values[op.lhs_slot] else: values[op.rhs_slot],
                    op.bit_width)
            known[op.result_slot] = true
        var result: [HwHostValue] = []
        var index = 0
        while index < self.value_names.len():
            if known[index]:
                result.push(HwHostValue(name: self.value_names[index], value: values[index]))
            index = index + 1
        Ok(HwHostEvaluation(values: result))

fn hwir_host_mask(width: i32) -> i64:
    if width < 1 or width > 64:
        return 0
    if width == 64:
        return -1
    (1 << width) - 1

fn hwir_host_normalize(value: i64, width: i32) -> i64:
    value & hwir_host_mask(width)

fn hwir_host_comb_value(op: HwPreparedOperation, lhs: i64,
    rhs: i64) -> Result<i64, text>:
    if op.op == "and":
        return Ok(hwir_host_normalize(lhs & rhs, op.bit_width))
    if op.op == "or":
        return Ok(hwir_host_normalize(lhs | rhs, op.bit_width))
    if op.op == "add":
        return Ok(hwir_host_normalize(lhs + rhs, op.bit_width))
    if op.op == "eq": return Ok(if lhs == rhs: 1 else: 0)
    if op.op == "ne": return Ok(if lhs != rhs: 1 else: 0)
    if op.op == "ult": return Ok(if hwir_host_unsigned_less(lhs, rhs, op.bit_width): 1 else: 0)
    if op.op == "uge": return Ok(if not hwir_host_unsigned_less(lhs, rhs, op.bit_width): 1 else: 0)
    if op.op == "slt" or op.op == "sge":
        val lhs_signed = hwir_host_sign_value(lhs, op.bit_width)
        val rhs_signed = hwir_host_sign_value(rhs, op.bit_width)
        return Ok(if op.op == "slt": (if lhs_signed < rhs_signed: 1 else: 0) else: (if lhs_signed >= rhs_signed: 1 else: 0))
    if op.op == "shl":
        # The strict serializer keeps one-bit shifts as identity assignments
        # because numeric_std shift conversion is not used for std_logic.
        if op.bit_width == 1:
            return Ok(lhs & 1)
        if rhs < 0 or rhs >= 64:
            return Ok(0)
        return Ok(hwir_host_normalize(lhs << rhs, op.bit_width))
    if op.op == "shr":
        if op.bit_width == 1:
            return Ok(lhs & 1)
        if rhs < 0 or rhs >= op.bit_width:
            return Ok(0)
        # Strict VHDL lowers SHR through numeric_std.unsigned shift_right.
        # Simple's i64 right shift is arithmetic, so normalize to precisely
        # the remaining logical width after the shift. This is significant for
        # PA=64 C.JR/C.JALR targets whose source register has bit 63 set.
        return Ok(hwir_host_normalize(lhs >> rhs, op.bit_width - (rhs as i32)))
    if op.op == "passthrough" or op.op == "zext" or op.op == "trunc":
        return Ok(hwir_host_normalize(lhs, op.bit_width))
    if op.op == "sext":
        val source_width = op.source_width
        if source_width < 1 or source_width > op.bit_width:
            return Err("HWIR-E-HOST-EVAL-SEXT: sign extension requires a declared source width no larger than its result")
        val source = hwir_host_normalize(lhs, source_width)
        if source_width == 64 or (source & (1 << (source_width - 1))) == 0:
            return Ok(hwir_host_normalize(source, op.bit_width))
        return Ok(hwir_host_normalize(source | (-1 << source_width), op.bit_width))
    Err("HWIR-E-HOST-EVAL-OP: unsupported strict combinational operation " + op.op)

fn hwir_host_sign_value(value: i64, width: i32) -> i64:
    val normalized = hwir_host_normalize(value, width)
    if width == 64 or (normalized & (1 << (width - 1))) == 0: return normalized
    normalized | (-1 << width)

fn hwir_host_unsigned_less(lhs: i64, rhs: i64, width: i32) -> bool:
    val left = hwir_host_normalize(lhs, width)
    val right = hwir_host_normalize(rhs, width)
    if width == 64 and (left < 0) != (right < 0): return left >= 0
    left < right

fn hwir_host_slot(names: [text], name: text) -> i32:
    var index = 0
    while index < names.len():
        if names[index] == name:
            return index
        index = index + 1
    -1

fn hwir_host_prepare_operation_diagnostic(result_slot: i32, lhs_slot: i32,
    rhs_slot: i32, condition_slot: i32) -> text:
    if result_slot < 0 or lhs_slot < 0 or rhs_slot < -1 or condition_slot < -1:
        return "HWIR-E-HOST-EVAL-PREPARE: strict graph operation references an unresolved value"
    ""

pub fn prepare_strict_comb_hwir(module: HwModuleDef) -> Result<HwPreparedStrictCombHwir, text>:
    """Validate, resolve, and topologically schedule a strict HWIR graph once."""
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    var names: [text] = []
    var widths: [i32] = []
    var initial_values: [i64] = []
    var initial_known: [bool] = []
    var input_names: [text] = []
    var input_slots: [i32] = []
    for port in module.ports:
        names.push(port.name)
        widths.push(port.bit_width)
        initial_values.push(0)
        initial_known.push(port.direction == "in")
        if port.direction == "in":
            input_names.push(port.name)
            input_slots.push(names.len() - 1)
    for signal in module.signals:
        names.push(signal.name)
        widths.push(signal.bit_width)
        initial_values.push(0)
        initial_known.push(false)
    for constant in module.constants:
        names.push(constant.name)
        widths.push(constant.bit_width)
        initial_values.push(hwir_host_normalize(constant.value, constant.bit_width))
        initial_known.push(true)
    var pending: [HwPreparedOperation] = []
    for op in module.comb_ops:
        val result = hwir_host_slot(names, op.result)
        val lhs = hwir_host_slot(names, op.lhs)
        val rhs = if op.rhs == "": -1 else: hwir_host_slot(names, op.rhs)
        val operation_diagnostic = hwir_host_prepare_operation_diagnostic(result, lhs, rhs, -1)
        if operation_diagnostic != "":
            return Err(operation_diagnostic)
        pending.push(HwPreparedOperation.comb(op, result, lhs, rhs, widths[lhs]))
    for op in module.compare_ops:
        val result = hwir_host_slot(names, op.result)
        val lhs = hwir_host_slot(names, op.lhs)
        val rhs = hwir_host_slot(names, op.rhs)
        val operation_diagnostic = hwir_host_prepare_operation_diagnostic(result, lhs, rhs, -1)
        if operation_diagnostic != "":
            return Err(operation_diagnostic)
        pending.push(HwPreparedOperation.compare(op, result, lhs, rhs))
    for op in module.select_ops:
        val result = hwir_host_slot(names, op.result)
        val condition = hwir_host_slot(names, op.condition)
        val when_true = hwir_host_slot(names, op.when_true)
        val when_false = hwir_host_slot(names, op.when_false)
        val operation_diagnostic = hwir_host_prepare_operation_diagnostic(result, when_true, when_false, condition)
        if operation_diagnostic != "":
            return Err(operation_diagnostic)
        pending.push(HwPreparedOperation.select(op, result, condition, when_true, when_false))
    var scheduled: [HwPreparedOperation] = []
    var known = initial_known
    while pending.len() > 0:
        var remaining: [HwPreparedOperation] = []
        var progressed = false
        for op in pending:
            if known[op.lhs_slot] and (op.rhs_slot < 0 or known[op.rhs_slot]) and
                (op.condition_slot < 0 or known[op.condition_slot]):
                scheduled.push(op)
                known[op.result_slot] = true
                progressed = true
            else:
                remaining.push(op)
        if not progressed:
            return Err("HWIR-E-HOST-EVAL-UNRESOLVED: strict graph has a cyclic or unresolved combinational dependency")
        pending = remaining
    for port in module.ports:
        val output_slot = hwir_host_slot(names, port.name)
        if port.direction == "out" and (output_slot < 0 or not known[output_slot]):
            return Err("HWIR-E-HOST-EVAL-UNRESOLVED: strict graph did not resolve output " + port.name)
    Ok(HwPreparedStrictCombHwir(value_names: names, value_widths: widths,
        initial_values: initial_values, initial_known: initial_known,
        input_names: input_names, input_slots: input_slots, scheduled_ops: scheduled))

pub fn evaluate_strict_comb_hwir(module: HwModuleDef,
    inputs: [HwHostInput]) -> Result<HwHostEvaluation, text>:
    """One-shot compatibility wrapper around the prepared strict evaluator."""
    prepare_strict_comb_hwir(module)?.evaluate(inputs)
