# Generic closed composition of typed combinational HWIR children.
use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef, HwNodeId, HwPort,
    hwir_hash_fields, hwir_vhdl_identifier}

pub class HwCombChildInstance:
    owner: text
    module: HwModuleDef

pub class HwCombBinding:
    source_owner: text
    source_port: text
    destination_owner: text
    destination_port: text
    bit_width: i32

    me canonical_text() -> text:
        [self.source_owner, self.source_port, self.destination_owner,
            self.destination_port, self.bit_width.to_text()].join("|")

fn comb_composition_port(ports: [HwPort], name: text) -> Option<HwPort>:
    for port in ports:
        if port.name == name: return Some(port)
    nil

pub class HwCombCompositionDef:
    node_id: HwNodeId
    entity_name: text
    config: CoreConfig
    top_ports: [HwPort]
    children: [HwCombChildInstance]
    bindings: [HwCombBinding]

    me owner_ports(owner: text) -> [HwPort]:
        if owner == "composition": return self.top_ports
        for child in self.children:
            if child.owner == owner: return child.module.ports
        []

    me diagnostic() -> text:
        if (self.entity_name == "" or self.node_id.value != self.entity_name + ":module" or
            self.children.len() == 0):
            return "HWIR-E-COMB-COMPOSITION-ID: combinational composition requires identity"
        if not hwir_vhdl_identifier(self.entity_name):
            return "HWIR-E-COMB-COMPOSITION-ID: combinational composition requires a legal VHDL identity"
        val config_error = self.config.diagnostic(); if config_error != "": return config_error
        var top_names: [text] = []
        for port in self.top_ports:
            if (not hwir_vhdl_identifier(port.name) or top_names.contains(port.name.lower()) or
                (port.direction != "in" and port.direction != "out") or
                port.type_name != "Bits" or port.bit_width <= 0):
                return "HWIR-E-COMB-COMPOSITION-PORT: top ports require an exact unique Bits schema"
            top_names.push(port.name.lower())
        var owners: [text] = []
        var entities: [text] = [self.entity_name.lower()]
        for child in self.children:
            if (not hwir_vhdl_identifier(child.owner) or child.owner.lower() == "composition" or
                owners.contains(child.owner.lower())):
                return "HWIR-E-COMB-COMPOSITION-CHILD: child owners must be exact and unique"
            if entities.contains(child.module.summary.name.lower()):
                return "HWIR-E-COMB-COMPOSITION-ENTITY: child entities require unique identities"
            if child.module.ports.len() == 0:
                return "HWIR-E-COMB-COMPOSITION-PORT: child modules require a nonempty port schema"
            val child_error = child.module.shape_diagnostic(); if child_error != "": return child_error
            if (child.module.config.profile != self.config.profile or
                child.module.config.isa_profile != self.config.isa_profile or
                child.module.config.compressed_decode_profile != self.config.compressed_decode_profile or
                child.module.config.xlen != self.config.xlen or
                child.module.config.physical_address_bits != self.config.physical_address_bits or
                child.module.config.register_count != self.config.register_count):
                return "HWIR-E-COMB-COMPOSITION-CONFIG: every child requires the exact composition config"
            owners.push(child.owner.lower())
            entities.push(child.module.summary.name.lower())
        var destinations: [text] = []
        var source_widths: [text] = []
        var dependencies: [text] = []
        for binding in self.bindings:
            val source = comb_composition_port(self.owner_ports(binding.source_owner), binding.source_port)
            val destination = comb_composition_port(self.owner_ports(binding.destination_owner), binding.destination_port)
            if source == nil or destination == nil:
                return "HWIR-E-COMB-COMPOSITION-ENDPOINT: every binding endpoint must exist"
            val source_port = source.unwrap(); val destination_port = destination.unwrap()
            if ((binding.source_owner == "composition" and source_port.direction != "in") or
                (binding.source_owner != "composition" and source_port.direction != "out") or
                (binding.destination_owner == "composition" and destination_port.direction != "out") or
                (binding.destination_owner != "composition" and destination_port.direction != "in")):
                return "HWIR-E-COMB-COMPOSITION-DIRECTION: binding directions must be source-to-destination"
            if (binding.bit_width <= 0 or source_port.bit_width != binding.bit_width or
                destination_port.bit_width != binding.bit_width):
                return "HWIR-E-COMB-COMPOSITION-WIDTH: binding widths must match both endpoints"
            val destination_key = (binding.destination_owner + "." + binding.destination_port).lower()
            if destinations.contains(destination_key):
                return "HWIR-E-COMB-COMPOSITION-DRIVER: every destination requires exactly one driver"
            destinations.push(destination_key)
            val source_key = (binding.source_owner + "." + binding.source_port).lower()
            val width_key = source_key + "|" + binding.bit_width.to_text()
            for known in source_widths:
                if known.starts_with(source_key + "|") and known != width_key:
                    return "HWIR-E-COMB-COMPOSITION-FANOUT: fanout requires one width-consistent source"
            if not source_widths.contains(width_key): source_widths.push(width_key)
            val rendered_source = "source_o" + binding.source_owner.len().to_text() +
                "_" + binding.source_owner + "_p" + binding.source_port.len().to_text() +
                "_" + binding.source_port
            val rendered_wire = "wire_o" + binding.destination_owner.len().to_text() +
                "_" + binding.destination_owner + "_p" +
                binding.destination_port.len().to_text() + "_" + binding.destination_port
            if ((binding.source_owner != "composition" and
                    top_names.contains(rendered_source.lower())) or
                (binding.destination_owner != "composition" and
                    top_names.contains(rendered_wire.lower()))):
                return "HWIR-E-COMB-COMPOSITION-NAMESPACE: generated interconnects must not collide with top ports"
            if binding.source_owner != "composition" and binding.destination_owner != "composition":
                if binding.source_owner == binding.destination_owner:
                    return "HWIR-E-COMB-COMPOSITION-CYCLE: combinational child self-feedback is forbidden"
                val dependency = binding.source_owner.lower() + ">" + binding.destination_owner.lower()
                if not dependencies.contains(dependency): dependencies.push(dependency)
        # Compute the owner-level transitive closure.  Port fanout does not add
        # a cycle unless a destination owner can reach its source owner again.
        var changed = true
        while changed:
            changed = false
            var additions: [text] = []
            for left in dependencies:
                val left_parts = left.split(">")
                for right in dependencies:
                    val right_parts = right.split(">")
                    if left_parts[1] == right_parts[0]:
                        val transitive = left_parts[0] + ">" + right_parts[1]
                        if left_parts[0] == right_parts[1]:
                            return "HWIR-E-COMB-COMPOSITION-CYCLE: combinational child dependency cycle is forbidden"
                        if not dependencies.contains(transitive) and not additions.contains(transitive):
                            additions.push(transitive); changed = true
            for addition in additions: dependencies.push(addition)
        for child in self.children:
            for port in child.module.ports:
                if port.direction == "in" and not destinations.contains((child.owner + "." + port.name).lower()):
                    return "HWIR-E-COMB-COMPOSITION-INPUT: every child input requires one driver"
        for port in self.top_ports:
            if port.direction == "out" and not destinations.contains(("composition." + port.name).lower()):
                return "HWIR-E-COMB-COMPOSITION-TOP: every top output requires one driver"
        ""

    me structural_sha256() -> text:
        var rows = [hwir_hash_fields(["simple-hwir-combinational-composition/v2",
            self.node_id.value, self.entity_name, self.config.profile,
            self.config.isa_profile, self.config.compressed_decode_profile,
            self.config.xlen.to_text(), self.config.physical_address_bits.to_text(),
            self.config.register_count.to_text()])]
        for port in self.top_ports:
            rows.push(hwir_hash_fields(["port", port.name, port.direction,
                port.type_name, port.bit_width.to_text(), port.clock_domain]))
        for child in self.children:
            rows.push(hwir_hash_fields(["child", child.owner, child.module.summary.name,
                child.module.structural_sha256()]))
        for binding in self.bindings:
            rows.push(hwir_hash_fields(["binding", binding.source_owner,
                binding.source_port, binding.destination_owner,
                binding.destination_port, binding.bit_width.to_text()]))
        sha256_text(rows.join("\n"))

pub fn strict_comb_composition(module_name: text, config: CoreConfig,
    top_ports: [HwPort], children: [HwCombChildInstance],
    bindings: [HwCombBinding]) -> Result<HwCombCompositionDef, text>:
    val composition = HwCombCompositionDef(node_id: HwNodeId.module_root(module_name),
        entity_name: module_name, config: config, top_ports: top_ports,
        children: children, bindings: bindings)
    val diagnostic = composition.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(composition)
