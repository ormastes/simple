# Plan-bound dynamic ECALL/EBREAK provider for normalized scalar completion.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp,
    HwSignal}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_semantic_opcode}

fn system_row_width(count: i32) -> i32:
    var width = 1; var capacity = 2
    while capacity <= count:
        width = width + 1; capacity = capacity * 2
    width

fn runtime_system_ports(x: i32, row_width: i32) -> [HwPort]:
    var ports = [HwPort.input("uop_valid", "Bits", 1),
        HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("decoded_row_index", "Bits", row_width),
        HwPort.input("decoded_execution_class", "Bits", 3),
        HwPort.input("decoded_memory_effect", "Bits", 3),
        HwPort.input("decoded_semantic_opcode", "Bits", 6),
        HwPort.input("decoded_declared_operand_width_is_32", "Bits", 1),
        HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("original_instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("instruction_rd_field", "Bits", 5),
        HwPort.input("instruction_rs1_field", "Bits", 5),
        HwPort.input("instruction_rs2_field", "Bits", 5),
        HwPort.input("pc_before", "Bits", x), HwPort.input("fallthrough_pc", "Bits", x),
        HwPort.input("privilege", "Bits", 2),
        HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64), HwPort.input("lineage_valid", "Bits", 1),
        HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("protocol_fault", "Bits", 1)]
    for field in [("privilege", 2), ("original_instruction", 32),
            ("canonical_instruction", 32), ("instruction_length_bytes", 3),
            ("pc_before", x), ("pc_after", x), ("rd", 5), ("rd_write", 1),
            ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x),
            ("memory_write_data", x), ("execute_trap_valid", 1),
            ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x),
            ("memory_trap_tval", x), ("redirect_valid", 1),
            ("redirect_target", x), ("provider_event_id", 64),
            ("decode_event_id", 64), ("illegal_valid", 1)]:
        ports.push(HwPort.output("completion_" + field[0], "Bits", field[1]))
    ports

pub fn strict_riscv_scalar_runtime_system_provider(module_name: text,
    config: CoreConfig, plan: RiscvScalarDecoderPlan) -> Result<HwModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-SYSTEM-ID: runtime system provider requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-SYSTEM-COMPRESSED: v1 requires canonical four-byte instructions")
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-RUNTIME-SYSTEM-CONFIG: provider requires its exact decoder plan")
    val x = config.xlen; val row_width = system_row_width(plan.entries.len())
    var constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1),
        HwConstant.bits("zero2", 2, 0), HwConstant.bits("zero3", 3, 0),
        HwConstant.bits("zero5", 5, 0), HwConstant.bits("zero6", 6, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero64", 64, 0),
        HwConstant.bits("zero_xlen", x, 0), HwConstant.bits("system_class", 3, 5),
        HwConstant.bits("length4", 3, 4), HwConstant.bits("four_xlen", x, 4),
        HwConstant.bits("shift7", 32, 7), HwConstant.bits("shift15", 32, 15),
        HwConstant.bits("shift20", 32, 20),
        HwConstant.bits("privilege_s", 2, 1), HwConstant.bits("privilege_reserved", 2, 2),
        HwConstant.bits("privilege_m", 2, 3), HwConstant.bits("cause_illegal", x, 2),
        HwConstant.bits("cause_breakpoint", x, 3), HwConstant.bits("cause_ecall_u", x, 8),
        HwConstant.bits("cause_ecall_s", x, 9), HwConstant.bits("cause_ecall_m", x, 11)]
    var signals = [HwSignal.comb("class_valid", "Bits", 1),
        HwSignal.comb("memory_valid", "Bits", 1), HwSignal.comb("width_valid", "Bits", 1),
        HwSignal.comb("length_valid", "Bits", 1),
        HwSignal.comb("rd_shift", "Bits", 32), HwSignal.comb("rs1_shift", "Bits", 32),
        HwSignal.comb("rs2_shift", "Bits", 32), HwSignal.comb("canonical_rd", "Bits", 5),
        HwSignal.comb("canonical_rs1", "Bits", 5), HwSignal.comb("canonical_rs2", "Bits", 5),
        HwSignal.comb("rd_bound", "Bits", 1), HwSignal.comb("rs1_bound", "Bits", 1),
        HwSignal.comb("rs2_bound", "Bits", 1), HwSignal.comb("fields01", "Bits", 1),
        HwSignal.comb("fields_valid", "Bits", 1),
        HwSignal.comb("event_valid", "Bits", 1), HwSignal.comb("original_valid", "Bits", 1),
        HwSignal.comb("expected_fallthrough", "Bits", x),
        HwSignal.comb("fallthrough_valid", "Bits", 1), HwSignal.comb("base01", "Bits", 1),
        HwSignal.comb("base23", "Bits", 1), HwSignal.comb("base45", "Bits", 1),
        HwSignal.comb("base67", "Bits", 1), HwSignal.comb("base_a", "Bits", 1),
        HwSignal.comb("base_b", "Bits", 1), HwSignal.comb("base_c", "Bits", 1),
        HwSignal.comb("base_pre", "Bits", 1), HwSignal.comb("base_valid", "Bits", 1),
        HwSignal.comb("system_claim", "Bits", 1), HwSignal.comb("selected_any", "Bits", 1),
        HwSignal.comb("selected_ecall", "Bits", 1), HwSignal.comb("selection_missing", "Bits", 1),
        HwSignal.comb("privilege_is_s", "Bits", 1), HwSignal.comb("privilege_is_m", "Bits", 1),
        HwSignal.comb("privilege_is_reserved", "Bits", 1),
        HwSignal.comb("ecall_s_or_u_cause", "Bits", x), HwSignal.comb("ecall_cause", "Bits", x),
        HwSignal.comb("selected_cause", "Bits", x), HwSignal.comb("architectural_cause", "Bits", x),
        HwSignal.comb("instruction_tval", "Bits", x), HwSignal.comb("architectural_tval", "Bits", x)]
    var ops = [HwCombOp.binary("eq", "class_valid", "decoded_execution_class", "system_class", 3),
        HwCombOp.binary("eq", "memory_valid", "decoded_memory_effect", "zero3", 3),
        HwCombOp.binary("eq", "width_valid", "decoded_declared_operand_width_is_32", "zero1", 1),
        HwCombOp.binary("eq", "length_valid", "instruction_length_bytes", "length4", 3),
        HwCombOp.binary("shr", "rd_shift", "canonical_instruction", "shift7", 32),
        HwCombOp.binary("shr", "rs1_shift", "canonical_instruction", "shift15", 32),
        HwCombOp.binary("shr", "rs2_shift", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "canonical_rd", "rd_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs1", "rs1_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs2", "rs2_shift", 5),
        HwCombOp.binary("eq", "rd_bound", "canonical_rd", "instruction_rd_field", 5),
        HwCombOp.binary("eq", "rs1_bound", "canonical_rs1", "instruction_rs1_field", 5),
        HwCombOp.binary("eq", "rs2_bound", "canonical_rs2", "instruction_rs2_field", 5),
        HwCombOp.binary("and", "fields01", "rd_bound", "rs1_bound", 1),
        HwCombOp.binary("and", "fields_valid", "fields01", "rs2_bound", 1),
        HwCombOp.binary("eq", "event_valid", "provider_event_id", "decode_event_id", 64),
        HwCombOp.binary("eq", "original_valid", "original_instruction", "canonical_instruction", 32),
        HwCombOp.binary("add", "expected_fallthrough", "pc_before", "four_xlen", x),
        HwCombOp.binary("eq", "fallthrough_valid", "fallthrough_pc", "expected_fallthrough", x),
        HwCombOp.binary("and", "base01", "uop_valid", "decode_legal", 1),
        HwCombOp.binary("and", "base23", "class_valid", "memory_valid", 1),
        HwCombOp.binary("and", "base45", "width_valid", "length_valid", 1),
        HwCombOp.binary("and", "base67", "event_valid", "lineage_valid", 1),
        HwCombOp.binary("and", "base_a", "base01", "base23", 1),
        HwCombOp.binary("and", "base_b", "base45", "base67", 1),
        HwCombOp.binary("and", "base_c", "original_valid", "fallthrough_valid", 1),
        HwCombOp.binary("and", "base_pre", "base_a", "base_b", 1),
        HwCombOp.binary("and", "base_valid", "base_pre", "base_c", 1),
        HwCombOp.binary("and", "system_claim", "base01", "class_valid", 1)]
    var selects = [HwSelectOp.mux("ecall_s_or_u_cause", "privilege_is_s", "cause_ecall_s", "cause_ecall_u", x),
        HwSelectOp.mux("ecall_cause", "privilege_is_m", "cause_ecall_m", "ecall_s_or_u_cause", x)]
    var prior_valid = "zero1"; var prior_ecall = "zero1"; var row_index = 0; var admitted = 0
    var origins = [HwOrigin(node_id: HwNodeId.child(module_name, "plan"),
        source_name: "riscv.scalar.runtime.system.plan." + plan.structural_sha256())]
    for entry in plan.entries:
        if entry.id == "rv.i.ecall" or entry.id == "rv.i.ebreak":
            val suffix = admitted.to_text(); val instruction = "instruction_" + suffix
            val opcode = "opcode_" + suffix; val row = "row_" + suffix
            val form = "form_" + suffix; val semantic = "semantic_" + suffix
            val row_match = "row_match_" + suffix; val match01 = "match01_" + suffix
            val match23 = "match23_" + suffix; val candidate = "candidate_" + suffix
            val accepted = "accepted_" + suffix; val next_valid = "selected_valid_" + suffix
            val next_ecall = "selected_ecall_" + suffix
            constants.push(HwConstant.bits(instruction, 32, entry.encoding_value as i64))
            constants.push(HwConstant.bits(opcode, 6, riscv_scalar_semantic_opcode(entry.semantic_operation)))
            constants.push(HwConstant.bits(row, row_width, (row_index + 1) as i64))
            for signal in [(form, 1), (semantic, 1), (row_match, 1), (match01, 1),
                    (match23, 1), (candidate, 1), (accepted, 1), (next_valid, 1), (next_ecall, 1)]:
                signals.push(HwSignal.comb(signal[0], "Bits", signal[1]))
            ops.push(HwCombOp.binary("eq", form, "canonical_instruction", instruction, 32))
            ops.push(HwCombOp.binary("eq", semantic, "decoded_semantic_opcode", opcode, 6))
            ops.push(HwCombOp.binary("eq", row_match, "decoded_row_index", row, row_width))
            ops.push(HwCombOp.binary("and", match01, form, semantic, 1))
            ops.push(HwCombOp.binary("and", match23, row_match, "fields_valid", 1))
            ops.push(HwCombOp.binary("and", candidate, match01, match23, 1))
            ops.push(HwCombOp.binary("and", accepted, candidate, "base_valid", 1))
            selects.push(HwSelectOp.mux(next_valid, accepted, "one1", prior_valid, 1))
            val is_ecall = if entry.id == "rv.i.ecall": "one1" else: "zero1"
            selects.push(HwSelectOp.mux(next_ecall, accepted, is_ecall, prior_ecall, 1))
            prior_valid = next_valid; prior_ecall = next_ecall; admitted = admitted + 1
            origins.push(HwOrigin(node_id: HwNodeId.child(module_name, "row." + entry.id), source_name: entry.id))
        row_index = row_index + 1
    if admitted != 2: return Err("HWIR-E-RISCV-RUNTIME-SYSTEM-SCOPE: provider requires exact ECALL and EBREAK rows")
    ops.push(HwCombOp.unary("passthrough", "selected_any", prior_valid, 1))
    ops.push(HwCombOp.unary("passthrough", "selected_ecall", prior_ecall, 1))
    ops.push(HwCombOp.binary("eq", "selection_missing", "selected_any", "zero1", 1))
    ops.push(HwCombOp.binary("and", "protocol_fault", "system_claim", "selection_missing", 1))
    ops.push(HwCombOp.binary("eq", "privilege_is_s", "privilege", "privilege_s", 2))
    ops.push(HwCombOp.binary("eq", "privilege_is_m", "privilege", "privilege_m", 2))
    ops.push(HwCombOp.binary("eq", "privilege_is_reserved", "privilege", "privilege_reserved", 2))
    ops.push(HwCombOp.unary("zext", "instruction_tval", "original_instruction", x))
    selects.push(HwSelectOp.mux("selected_cause", "selected_ecall", "ecall_cause", "cause_breakpoint", x))
    selects.push(HwSelectOp.mux("architectural_cause", "privilege_is_reserved", "cause_illegal", "selected_cause", x))
    selects.push(HwSelectOp.mux("architectural_tval", "privilege_is_reserved", "instruction_tval", "zero_xlen", x))
    ops.push(HwCombOp.unary("passthrough", "completion_valid", "selected_any", 1))
    for field in [("rd", "zero5", 5), ("rd_write", "zero1", 1),
            ("rd_value", "zero_xlen", x), ("memory_address", "zero_xlen", x),
            ("memory_read_mask", "zero32", 32), ("memory_write_mask", "zero32", 32),
            ("memory_read_data", "zero_xlen", x), ("memory_write_data", "zero_xlen", x),
            ("memory_trap_valid", "zero1", 1), ("memory_trap_cause", "zero_xlen", x),
            ("memory_trap_tval", "zero_xlen", x), ("redirect_valid", "zero1", 1),
            ("redirect_target", "zero_xlen", x)]:
        ops.push(HwCombOp.unary("passthrough", "completion_" + field[0], field[1], field[2]))
    for field in [("privilege", "privilege", "zero2", 2),
            ("original_instruction", "original_instruction", "zero32", 32),
            ("canonical_instruction", "canonical_instruction", "zero32", 32),
            ("instruction_length_bytes", "instruction_length_bytes", "zero3", 3),
            ("pc_before", "pc_before", "zero_xlen", x),
            ("pc_after", "fallthrough_pc", "zero_xlen", x),
            ("provider_event_id", "provider_event_id", "zero64", 64),
            ("decode_event_id", "decode_event_id", "zero64", 64)]:
        selects.push(HwSelectOp.mux("completion_" + field[0], "selected_any", field[1], field[2], field[3]))
    selects.push(HwSelectOp.mux("completion_execute_trap_valid", "selected_any", "one1", "zero1", 1))
    selects.push(HwSelectOp.mux("completion_execute_trap_cause", "selected_any", "architectural_cause", "zero_xlen", x))
    selects.push(HwSelectOp.mux("completion_execute_trap_tval", "selected_any", "architectural_tval", "zero_xlen", x))
    ops.push(HwCombOp.unary("passthrough", "completion_illegal_valid", "zero1", 1))
    val ports = runtime_system_ports(x, row_width)
    val module = HwModuleDef(summary: HwModule(name: module_name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0,
            comb_op_count: ops.len() + selects.len(), memory_count: 0,
            clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty()),
        config: config, node_id: HwNodeId.module_root(module_name), origins: origins,
        ports: ports, signals: signals, constants: constants, comb_ops: ops,
        compare_ops: [], select_ops: selects, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
