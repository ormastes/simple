# Normalized typed outcomes for non-control critical-Zca rows.
#
# Old row constructors intentionally expose only their canonical word.  This
# layer supplies an explicit legal predicate from the original classifier and
# reserved-encoding gate before such a row is eligible for frontend composition.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant, HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwSelectOp, HwSignal}
use compiler.mir.hwir.predecode.{strict_riscv_predecode_interface}
use compiler.mir.hwir.zca_rows.{strict_zca_addi4spn_row_hwir, strict_zca_lw_row_hwir, strict_zca_sw_row_hwir, strict_zca_lwsp_row_hwir, strict_zca_swsp_row_hwir, strict_zca_cli_row_hwir, strict_zca_caddi_row_hwir, strict_zca_caddi16sp_row_hwir, strict_zca_clui_row_hwir, strict_zca_slli_low_row_hwir, strict_zca_srli_low_row_hwir, strict_zca_srai_low_row_hwir, strict_zca_candi_row_hwir, strict_zca_csub_row_hwir, strict_zca_cxor_row_hwir, strict_zca_cor_row_hwir, strict_zca_cand_row_hwir, strict_zca_cmv_row_hwir, strict_zca_cadd_row_hwir}
use compiler.mir.hwir.zca_rv64_rows.{strict_zca_caddw_rv64_row_hwir, strict_zca_csubw_rv64_row_hwir, strict_zca_slli6_rv64_row_hwir, strict_zca_srli6_rv64_row_hwir, strict_zca_srai6_rv64_row_hwir}
use compiler.mir.hwir.frontend.{strict_frontend_data_row_fragment}

fn strict_zca_tagged_data_outcome_hwir(module_name: text, config: CoreConfig,
    prefix: text, source_name: text, row: HwModuleDef, classifier_name: text,
    effect_kind: text) -> Result<HwModuleDef, text>:
    """Normalize a row whose tag classifier is its complete legality rule.

    This helper is intentionally not available to rows with reserved encodings,
    register-read effects, redirects, or traps. Callers must pass the exact
    classifier produced by the row; `canonical_instruction == 0` is never a
    legality test.
    """
    if module_name == "":
        return Err("HWIR-E-ZCA-OUTCOME-ID: normalized row outcome requires a module name")
    if effect_kind != "register-write" and effect_kind != "memory-read" and effect_kind != "memory-write":
        return Err("HWIR-E-ZCA-OUTCOME-EFFECT: normal outcome requires an explicit supported effect kind")
    val contract = strict_riscv_predecode_interface(config)?
    val fragment = strict_frontend_data_row_fragment(module_name, prefix, row, "parcel32")?
    val pa = config.physical_address_bits
    var signals: [HwSignal] = [HwSignal.comb("parcel32", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa), HwSignal.comb("match_legal", "Bits", 1),
        HwSignal.comb("effect_register_write", "Bits", 1), HwSignal.comb("effect_memory_read", "Bits", 1),
        HwSignal.comb("effect_memory_write", "Bits", 1), HwSignal.comb("control_fallthrough", "Bits", 1)]
    for signal in fragment.signals: signals.push(signal)
    var constants: [HwConstant] = [HwConstant.bits("two_bytes", pa, 2),
        HwConstant.bits("two_length", 2, 2), HwConstant.bits("zero_flag", 1, 0),
        HwConstant.bits("one_flag", 1, 1),
        # A load has two inseparable architectural effects: memory read and
        # destination-register writeback. Both remain gated by match_legal.
        HwConstant.bits("effect_register_write_value", 1,
            if effect_kind == "register-write" or effect_kind == "memory-read": 1 else: 0),
        HwConstant.bits("effect_memory_read_value", 1, if effect_kind == "memory-read": 1 else: 0),
        HwConstant.bits("effect_memory_write_value", 1, if effect_kind == "memory-write": 1 else: 0)]
    for constant in fragment.constants: constants.push(constant)
    var comb_ops: [HwCombOp] = [HwCombOp.unary("zext", "parcel32", "original_parcel", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "canonical_instruction", prefix + "_canonical_instruction", 32),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa),
        HwCombOp.unary("passthrough", "legal", "match_legal", 1),
        HwCombOp.binary("and", "effect_register_write", "match_legal", "effect_register_write_value", 1),
        HwCombOp.binary("and", "effect_memory_read", "match_legal", "effect_memory_read_value", 1),
        HwCombOp.binary("and", "effect_memory_write", "match_legal", "effect_memory_write_value", 1),
        HwCombOp.unary("passthrough", "control_fallthrough", "one_flag", 1)]
    for op in fragment.comb_ops: comb_ops.push(op)
    var compare_ops = fragment.compare_ops
    var select_ops = fragment.select_ops
    select_ops.push(HwSelectOp.mux("match_legal", prefix + "_" + classifier_name, "one_flag", "zero_flag", 1))
    var origins: [HwOrigin] = [HwOrigin(node_id: HwNodeId.child(module_name, "outcome"), source_name: source_name + ".outcome")]
    for origin in fragment.origins: origins.push(origin)
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: contract.ports().len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0, comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins,
        ports: contract.ports(), signals: signals, constants: constants,
        comb_ops: comb_ops, compare_ops: compare_ops, select_ops: select_ops,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

fn strict_zca_reserved_data_outcome_hwir(module_name: text, config: CoreConfig,
    prefix: text, source_name: text, row: HwModuleDef, classifier_name: text,
    reserved_conditions: [text], effect_kind: text) -> Result<HwModuleDef, text>:
    """Normalize a data row with explicit true-means-reserved conditions.

    Each condition is produced by the preserved row graph. The legality chain
    starts true, clears for every reserved condition, then applies the row tag.
    This makes every reserved gate visible in HWIR and keeps canonical output
    entirely out of control flow.
    """
    if reserved_conditions.len() == 0:
        return Err("HWIR-E-ZCA-OUTCOME-RESERVED: reserved outcome requires at least one explicit reserved predicate")
    if module_name == "":
        return Err("HWIR-E-ZCA-OUTCOME-ID: normalized row outcome requires a module name")
    if effect_kind != "register-write" and effect_kind != "memory-read" and effect_kind != "memory-write":
        return Err("HWIR-E-ZCA-OUTCOME-EFFECT: normal outcome requires an explicit supported effect kind")
    val contract = strict_riscv_predecode_interface(config)?
    val fragment = strict_frontend_data_row_fragment(module_name, prefix, row, "parcel32")?
    val pa = config.physical_address_bits
    var signals: [HwSignal] = [HwSignal.comb("parcel32", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa), HwSignal.comb("match_legal", "Bits", 1),
        HwSignal.comb("effect_register_write", "Bits", 1), HwSignal.comb("effect_memory_read", "Bits", 1),
        HwSignal.comb("effect_memory_write", "Bits", 1), HwSignal.comb("control_fallthrough", "Bits", 1)]
    for signal in fragment.signals: signals.push(signal)
    var constants: [HwConstant] = [HwConstant.bits("two_bytes", pa, 2),
        HwConstant.bits("two_length", 2, 2), HwConstant.bits("zero_flag", 1, 0),
        HwConstant.bits("one_flag", 1, 1),
        # Reserved load encodings must suppress both the read and its writeback.
        HwConstant.bits("effect_register_write_value", 1,
            if effect_kind == "register-write" or effect_kind == "memory-read": 1 else: 0),
        HwConstant.bits("effect_memory_read_value", 1, if effect_kind == "memory-read": 1 else: 0),
        HwConstant.bits("effect_memory_write_value", 1, if effect_kind == "memory-write": 1 else: 0)]
    for constant in fragment.constants: constants.push(constant)
    var comb_ops: [HwCombOp] = [HwCombOp.unary("zext", "parcel32", "original_parcel", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "canonical_instruction", prefix + "_canonical_instruction", 32),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa),
        HwCombOp.unary("passthrough", "legal", "match_legal", 1),
        HwCombOp.binary("and", "effect_register_write", "match_legal", "effect_register_write_value", 1),
        HwCombOp.binary("and", "effect_memory_read", "match_legal", "effect_memory_read_value", 1),
        HwCombOp.binary("and", "effect_memory_write", "match_legal", "effect_memory_write_value", 1),
        HwCombOp.unary("passthrough", "control_fallthrough", "one_flag", 1)]
    for op in fragment.comb_ops: comb_ops.push(op)
    var compare_ops = fragment.compare_ops
    var select_ops = fragment.select_ops
    var prior = "one_flag"
    var index = 0
    for reserved in reserved_conditions:
        val legal_name = prefix + "_legal_after_reserved_" + index.to_text()
        signals.push(HwSignal.comb(legal_name, "Bits", 1))
        select_ops.push(HwSelectOp.mux(legal_name, prefix + "_" + reserved, "zero_flag", prior, 1))
        prior = legal_name
        index = index + 1
    select_ops.push(HwSelectOp.mux("match_legal", prefix + "_" + classifier_name, prior, "zero_flag", 1))
    var origins: [HwOrigin] = [HwOrigin(node_id: HwNodeId.child(module_name, "outcome"), source_name: source_name + ".outcome")]
    for origin in fragment.origins: origins.push(origin)
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: contract.ports().len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0, comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins,
        ports: contract.ports(), signals: signals, constants: constants,
        comb_ops: comb_ops, compare_ops: compare_ops, select_ops: select_ops,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_addi4spn_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Normalize C.ADDI4SPN into a typed predecode outcome.

    `legal` is derived from the row's tag and its explicit nonzero-immediate
    reserved-encoding predicate.  It is never inferred from the canonical word.
    """
    if module_name == "":
        return Err("HWIR-E-ZCA-OUTCOME-ID: normalized row outcome requires a module name")
    val contract = strict_riscv_predecode_interface(config)?
    val row = strict_zca_addi4spn_row_hwir(module_name + "_row", config)?
    val fragment = strict_frontend_data_row_fragment(module_name, "addi4spn", row, "parcel32")?
    val pa = config.physical_address_bits
    var signals: [HwSignal] = [HwSignal.comb("parcel32", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa),
        HwSignal.comb("legal_nonreserved", "Bits", 1), HwSignal.comb("match_legal", "Bits", 1),
        HwSignal.comb("effect_register_write", "Bits", 1), HwSignal.comb("effect_memory_read", "Bits", 1),
        HwSignal.comb("effect_memory_write", "Bits", 1), HwSignal.comb("control_fallthrough", "Bits", 1)]
    for signal in fragment.signals: signals.push(signal)
    var constants: [HwConstant] = [HwConstant.bits("two_bytes", pa, 2),
        HwConstant.bits("two_length", 2, 2), HwConstant.bits("zero_flag", 1, 0),
        HwConstant.bits("one_flag", 1, 1)]
    for constant in fragment.constants: constants.push(constant)
    var comb_ops: [HwCombOp] = [HwCombOp.unary("zext", "parcel32", "original_parcel", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "canonical_instruction", "addi4spn_canonical_instruction", 32),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa),
        HwCombOp.unary("passthrough", "legal", "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_register_write", "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_memory_read", "zero_flag", 1),
        HwCombOp.unary("passthrough", "effect_memory_write", "zero_flag", 1),
        HwCombOp.unary("passthrough", "control_fallthrough", "one_flag", 1)]
    for op in fragment.comb_ops: comb_ops.push(op)
    var compare_ops = fragment.compare_ops
    var select_ops: [HwSelectOp] = []
    for op in fragment.select_ops: select_ops.push(op)
    select_ops.push(HwSelectOp.mux("legal_nonreserved", "addi4spn_immediate_is_zero", "zero_flag", "one_flag", 1))
    select_ops.push(HwSelectOp.mux("match_legal", "addi4spn_is_c_addi4spn", "legal_nonreserved", "zero_flag", 1))
    var origins: [HwOrigin] = [HwOrigin(node_id: HwNodeId.child(module_name, "outcome"), source_name: "zca.c.addi4spn.outcome")]
    for origin in fragment.origins: origins.push(origin)
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: contract.ports().len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0, comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins,
        ports: contract.ports(), signals: signals, constants: constants,
        comb_ops: comb_ops, compare_ops: compare_ops, select_ops: select_ops,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

pub fn strict_zca_lw_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Normalize C.LW using its explicit Q0/funct3 classifier."""
    val row = strict_zca_lw_row_hwir(module_name + "_row", config)?
    strict_zca_tagged_data_outcome_hwir(module_name, config, "lw", "zca.c.lw", row, "is_c_lw", "memory-read")

pub fn strict_zca_sw_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Normalize C.SW using its explicit Q0/funct3 classifier."""
    val row = strict_zca_sw_row_hwir(module_name + "_row", config)?
    strict_zca_tagged_data_outcome_hwir(module_name, config, "sw", "zca.c.sw", row, "is_c_sw", "memory-write")

# These rows have complete, disjoint classifiers in the frozen critical Zca
# subset. Rows with a reserved gate or architectural side effect deliberately
# do not call this helper.
pub fn strict_zca_swsp_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_tagged_data_outcome_hwir(module_name, config, "swsp", "zca.c.swsp", strict_zca_swsp_row_hwir(module_name + "_row", config)?, "is_c_swsp", "memory-write")

pub fn strict_zca_cli_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_tagged_data_outcome_hwir(module_name, config, "cli", "zca.c.li", strict_zca_cli_row_hwir(module_name + "_row", config)?, "is_c_li", "register-write")

pub fn strict_zca_caddi_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_tagged_data_outcome_hwir(module_name, config, "caddi", "zca.c.addi", strict_zca_caddi_row_hwir(module_name + "_row", config)?, "is_c_addi", "register-write")

pub fn strict_zca_caddi16sp_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    """Normalize C.ADDI16SP with its positive `rd=x2` eligibility rule.

    `rd_is_sp` is a required positive match, not an ordinary reserved
    predicate. The explicit chain requires the Q1/funct3 tag and x2, then
    rejects the all-zero immediate. C.LUI remains disjoint without a
    canonical-word sentinel.
    """
    if module_name == "":
        return Err("HWIR-E-ZCA-OUTCOME-ID: normalized row outcome requires a module name")
    val contract = strict_riscv_predecode_interface(config)?
    val row = strict_zca_caddi16sp_row_hwir(module_name + "_row", config)?
    val fragment = strict_frontend_data_row_fragment(module_name, "caddi16sp", row, "parcel32")?
    val pa = config.physical_address_bits
    var signals: [HwSignal] = [HwSignal.comb("parcel32", "Bits", 32),
        HwSignal.comb("fallthrough_pc", "Bits", pa),
        HwSignal.comb("legal_positive_rd", "Bits", 1),
        HwSignal.comb("legal_nonzero_immediate", "Bits", 1), HwSignal.comb("match_legal", "Bits", 1),
        HwSignal.comb("effect_register_write", "Bits", 1), HwSignal.comb("effect_memory_read", "Bits", 1),
        HwSignal.comb("effect_memory_write", "Bits", 1), HwSignal.comb("control_fallthrough", "Bits", 1)]
    for signal in fragment.signals: signals.push(signal)
    var constants: [HwConstant] = [HwConstant.bits("two_bytes", pa, 2),
        HwConstant.bits("two_length", 2, 2), HwConstant.bits("zero_flag", 1, 0),
        HwConstant.bits("one_flag", 1, 1)]
    for constant in fragment.constants: constants.push(constant)
    var comb_ops: [HwCombOp] = [HwCombOp.unary("zext", "parcel32", "original_parcel", 32),
        HwCombOp.binary("add", "fallthrough_pc", "fetch_pc", "two_bytes", pa),
        HwCombOp.unary("passthrough", "canonical_instruction", "caddi16sp_canonical_instruction", 32),
        HwCombOp.unary("passthrough", "original_length_bytes", "two_length", 2),
        HwCombOp.unary("passthrough", "next_pc", "fallthrough_pc", pa),
        HwCombOp.unary("passthrough", "redirect_valid", "zero_flag", 1),
        HwCombOp.unary("passthrough", "redirect_target", "fetch_pc", pa),
        HwCombOp.unary("passthrough", "legal", "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_register_write", "match_legal", 1),
        HwCombOp.unary("passthrough", "effect_memory_read", "zero_flag", 1),
        HwCombOp.unary("passthrough", "effect_memory_write", "zero_flag", 1),
        HwCombOp.unary("passthrough", "control_fallthrough", "one_flag", 1)]
    for op in fragment.comb_ops: comb_ops.push(op)
    var compare_ops = fragment.compare_ops
    var select_ops = fragment.select_ops
    select_ops.push(HwSelectOp.mux("legal_positive_rd", "caddi16sp_rd_is_sp", "one_flag", "zero_flag", 1))
    select_ops.push(HwSelectOp.mux("legal_nonzero_immediate", "caddi16sp_imm_is_zero", "zero_flag", "legal_positive_rd", 1))
    select_ops.push(HwSelectOp.mux("match_legal", "caddi16sp_is_c_addi16sp", "legal_nonzero_immediate", "zero_flag", 1))
    var origins: [HwOrigin] = [HwOrigin(node_id: HwNodeId.child(module_name, "outcome"), source_name: "zca.c.addi16sp.outcome")]
    for origin in fragment.origins: origins.push(origin)
    val summary = HwModule(name: module_name, profile: config.profile,
        port_count: contract.ports().len(), signal_count: signals.len(), register_count: 0,
        memory_count: 0, comb_op_count: comb_ops.len() + compare_ops.len() + select_ops.len(),
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins,
        ports: contract.ports(), signals: signals, constants: constants,
        comb_ops: comb_ops, compare_ops: compare_ops, select_ops: select_ops,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic()
    if diagnostic != "":
        return Err(diagnostic)
    Ok(module)

