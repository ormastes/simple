pub fn strict_zca_cxor_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_tagged_data_outcome_hwir(module_name, config, "cxor", "zca.c.xor", strict_zca_cxor_row_hwir(module_name + "_row", config)?, "is_c_xor", "register-write")

pub fn strict_zca_cor_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
    strict_zca_tagged_data_outcome_hwir(module_name, config, "cor", "zca.c.or", strict_zca_cor_row_hwir(module_name + "_row", config)?, "is_c_or", "register-write")

pub fn strict_zca_cand_outcome_hwir(module_name: text, config: CoreConfig) -> Result<HwModuleDef, text>:
