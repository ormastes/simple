# Typed architectural illegal-instruction provider for registered decoded uops.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp,
    HwSignal}

fn illegal_provider_ports(x: i32) -> [HwPort]:
    [HwPort.input("uop_valid", "Bits", 1), HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("illegal_valid", "Bits", 1), HwPort.input("lineage_valid", "Bits", 1),
        HwPort.input("privilege", "Bits", 2), HwPort.input("original_instruction", "Bits", 32),
        HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("pc_before", "Bits", x), HwPort.input("fallthrough_pc", "Bits", x),
        HwPort.input("provider_event_id", "Bits", 64), HwPort.input("decode_event_id", "Bits", 64),
        HwPort.output("completion_valid", "Bits", 1), HwPort.output("protocol_fault", "Bits", 1),
        HwPort.output("completion_privilege", "Bits", 2),
        HwPort.output("completion_original_instruction", "Bits", 32),
        HwPort.output("completion_canonical_instruction", "Bits", 32),
        HwPort.output("completion_instruction_length_bytes", "Bits", 3),
        HwPort.output("completion_pc_before", "Bits", x), HwPort.output("completion_pc_after", "Bits", x),
        HwPort.output("completion_rd", "Bits", 5), HwPort.output("completion_rd_write", "Bits", 1),
        HwPort.output("completion_rd_value", "Bits", x), HwPort.output("completion_memory_address", "Bits", x),
        HwPort.output("completion_memory_read_mask", "Bits", 32),
        HwPort.output("completion_memory_write_mask", "Bits", 32),
        HwPort.output("completion_memory_read_data", "Bits", x),
        HwPort.output("completion_memory_write_data", "Bits", x),
        HwPort.output("completion_execute_trap_valid", "Bits", 1),
        HwPort.output("completion_execute_trap_cause", "Bits", x),
        HwPort.output("completion_execute_trap_tval", "Bits", x),
        HwPort.output("completion_memory_trap_valid", "Bits", 1),
        HwPort.output("completion_memory_trap_cause", "Bits", x),
        HwPort.output("completion_memory_trap_tval", "Bits", x),
        HwPort.output("completion_redirect_valid", "Bits", 1),
        HwPort.output("completion_redirect_target", "Bits", x),
        HwPort.output("completion_provider_event_id", "Bits", 64),
        HwPort.output("completion_decode_event_id", "Bits", 64),
        HwPort.output("completion_illegal_valid", "Bits", 1)]

pub fn strict_riscv_scalar_runtime_illegal_provider(module_name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-ILLEGAL-ID: illegal provider requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val x = config.xlen
    val constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("zero2", 2, 0),
        HwConstant.bits("zero3", 3, 0), HwConstant.bits("zero5", 5, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero64", 64, 0),
        HwConstant.bits("zero_xlen", x, 0), HwConstant.bits("cause_illegal", x, 2)]
    val signals = [HwSignal.comb("not_legal", "Bits", 1),
        HwSignal.comb("valid_01", "Bits", 1), HwSignal.comb("valid_23", "Bits", 1),
        HwSignal.comb("admitted", "Bits", 1), HwSignal.comb("malformed", "Bits", 1),
        HwSignal.comb("instruction_tval", "Bits", x)]
    var ops = [HwCombOp.binary("eq", "not_legal", "decode_legal", "zero1", 1),
        HwCombOp.binary("and", "valid_01", "uop_valid", "illegal_valid", 1),
        HwCombOp.binary("and", "valid_23", "lineage_valid", "not_legal", 1),
        HwCombOp.binary("and", "admitted", "valid_01", "valid_23", 1),
        HwCombOp.binary("ne", "malformed", "illegal_valid", "admitted", 1),
        HwCombOp.unary("zext", "instruction_tval", "original_instruction", x),
        HwCombOp.unary("passthrough", "completion_valid", "admitted", 1),
        HwCombOp.unary("passthrough", "protocol_fault", "malformed", 1)]
    var selects = [HwSelectOp.mux("completion_privilege", "admitted", "privilege", "zero2", 2),
        HwSelectOp.mux("completion_original_instruction", "admitted", "original_instruction", "zero32", 32),
        HwSelectOp.mux("completion_canonical_instruction", "admitted", "canonical_instruction", "zero32", 32),
        HwSelectOp.mux("completion_instruction_length_bytes", "admitted", "instruction_length_bytes", "zero3", 3),
        HwSelectOp.mux("completion_pc_before", "admitted", "pc_before", "zero_xlen", x),
        HwSelectOp.mux("completion_pc_after", "admitted", "fallthrough_pc", "zero_xlen", x),
        HwSelectOp.mux("completion_execute_trap_valid", "admitted", "admitted", "zero1", 1),
        HwSelectOp.mux("completion_execute_trap_cause", "admitted", "cause_illegal", "zero_xlen", x),
        HwSelectOp.mux("completion_execute_trap_tval", "admitted", "instruction_tval", "zero_xlen", x),
        HwSelectOp.mux("completion_provider_event_id", "admitted", "provider_event_id", "zero64", 64),
        HwSelectOp.mux("completion_decode_event_id", "admitted", "decode_event_id", "zero64", 64),
        HwSelectOp.mux("completion_illegal_valid", "admitted", "admitted", "zero1", 1)]
    for field in [("completion_rd", "zero5", 5), ("completion_rd_write", "zero1", 1),
            ("completion_rd_value", "zero_xlen", x), ("completion_memory_address", "zero_xlen", x),
            ("completion_memory_read_mask", "zero32", 32), ("completion_memory_write_mask", "zero32", 32),
            ("completion_memory_read_data", "zero_xlen", x), ("completion_memory_write_data", "zero_xlen", x),
            ("completion_memory_trap_valid", "zero1", 1), ("completion_memory_trap_cause", "zero_xlen", x),
            ("completion_memory_trap_tval", "zero_xlen", x), ("completion_redirect_valid", "zero1", 1),
            ("completion_redirect_target", "zero_xlen", x)]:
        ops.push(HwCombOp.unary("passthrough", field[0], field[1], field[2]))
    val ports = illegal_provider_ports(x)
    val module = HwModuleDef(summary: HwModule(name: module_name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0,
            comb_op_count: ops.len() + selects.len(), memory_count: 0,
            clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty()),
        config: config, node_id: HwNodeId.module_root(module_name), origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "architectural-illegal"),
                source_name: "riscv.scalar.runtime.illegal.normalized-completion")],
        ports: ports, signals: signals, constants: constants, comb_ops: ops,
        compare_ops: [], select_ops: selects, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
