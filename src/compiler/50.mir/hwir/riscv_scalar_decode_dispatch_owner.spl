# Registered runtime boundary between the declarative decoder and scalar providers.

use compiler.mir.hwir.types.{CoreConfig, HwCombOp, HwConstant, HwModuleDef,
    HwNodeId, HwOrigin, HwPort, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard,
    HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef,
    HwSequentialPlan, HwStateRegister}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{HwScalarDecodedUopInterface}

fn dispatch_row_width(row_count: i32) -> i32:
    var width = 1
    var capacity = 2
    while capacity <= row_count:
        width = width + 1
        capacity = capacity * 2
    width

fn dispatch_payload_fields(xlen: i32, row_width: i32) -> [(text, i32)]:
    [("decoded_valid", 1), ("decoded_row_index", row_width),
        ("decoded_execution_class", 3), ("decoded_memory_effect", 3),
        ("decoded_semantic_opcode", 6), ("decoded_declared_operand_width_is_32", 1),
        ("canonical_instruction", 32), ("original_instruction", 32),
        ("instruction_length_bytes", 3), ("instruction_rd_field", 5),
        ("instruction_rs1_field", 5), ("instruction_rs2_field", 5), ("rs1_value", xlen),
        ("rs2_value", xlen), ("pc_before", xlen), ("fallthrough_pc", xlen),
        ("privilege", 2), ("provider_event_id", 64), ("decode_event_id", 64)]

fn dispatch_ports(xlen: i32, row_width: i32) -> [HwPort]:
    var ports = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("upstream_valid", "Bits", 1),
        HwPort.input("uop_ready", "Bits", 1),
        HwPort.output("upstream_ready", "Bits", 1),
        HwPort.output("uop_valid", "Bits", 1),
        HwPort.output("decode_legal", "Bits", 1),
        HwPort.output("lineage_valid", "Bits", 1),
        HwPort.output("illegal_valid", "Bits", 1)]
    for field in dispatch_payload_fields(xlen, row_width):
        ports.push(HwPort.input("upstream_" + field[0], "Bits", field[1]))
        if field[0] != "decoded_valid":
            ports.push(HwPort.output(field[0], "Bits", field[1]))
    ports

fn dispatch_registers(xlen: i32, row_width: i32) -> [HwStateRegister]:
    var registers = [HwStateRegister(name: "full_reg", bit_width: 1,
            clock_domain: "default", reset_value: 0)]
    for field in dispatch_payload_fields(xlen, row_width):
        registers.push(HwStateRegister(name: field[0] + "_reg",
            bit_width: field[1], clock_domain: "default", reset_value: 0))
    registers

fn dispatch_capture(xlen: i32, row_width: i32) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "full_reg",
        value: HwSeqValue.copy("upstream_valid", 1))]
    for field in dispatch_payload_fields(xlen, row_width):
        assignments.push(HwSeqAssignment(destination: field[0] + "_reg",
            value: HwSeqValue.copy("upstream_" + field[0], field[1])))
    assignments

fn dispatch_clear(xlen: i32, row_width: i32) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]
    for field in dispatch_payload_fields(xlen, row_width):
        assignments.push(HwSeqAssignment(destination: field[0] + "_reg",
            value: HwSeqValue.zero(field[1])))
    assignments

fn dispatch_outputs(xlen: i32, row_width: i32) -> [HwSeqOutputBinding]:
    val occupied = [HwSeqGuard.high("full_reg")]
    var outputs = [HwSeqOutputBinding.all("upstream_ready",
            [HwSeqGuard.low("full_reg")]),
        HwSeqOutputBinding.direct("uop_valid", "full_reg", 1),
        HwSeqOutputBinding.guarded("decode_legal", "decoded_valid_reg", 1, occupied),
        HwSeqOutputBinding.guarded("illegal_valid", "illegal_value", 1, occupied)]
    for field in dispatch_payload_fields(xlen, row_width):
        if field[0] != "decoded_valid":
            outputs.push(HwSeqOutputBinding.guarded(field[0],
                field[0] + "_reg", field[1], occupied))
    outputs.push(HwSeqOutputBinding.guarded("lineage_valid", "lineage_equal", 1, occupied))
    outputs

pub fn strict_riscv_scalar_decoded_uop_skid(module_name: text,
    plan: RiscvScalarDecoderPlan, decoder: HwModuleDef,
    descriptor: HwScalarDecodedUopInterface) -> Result<HwSequentialModuleDef, text>:
    if module_name == "":
        return Err("HWIR-E-RISCV-DECODED-UOP-SKID-ID: decoded-uop skid requires a module name")
    val config = descriptor.config
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    val descriptor_error = descriptor.diagnostic_for_decoder(decoder, plan)
    if descriptor_error != "": return Err(descriptor_error)
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-DECODED-UOP-SKID-CONFIG: skid requires its exact decoder plan")
    val row_width = dispatch_row_width(plan.entries.len())
    val plan_graph = plan.structural_sha256()
    val descriptor_graph = descriptor.structural_sha256()
    val rules = [HwSeqRule(name: "consume", guards: [HwSeqGuard.high("full_reg"),
                HwSeqGuard.high("uop_ready")],
            assignments: dispatch_clear(config.xlen, row_width)),
        HwSeqRule(name: "capture", guards: [HwSeqGuard.low("full_reg"),
                HwSeqGuard.high("upstream_valid")],
            assignments: dispatch_capture(config.xlen, row_width))]
    val sequential = HwSequentialPlan(owner_id: HwNodeId.child(module_name, "sequential"),
        registers: dispatch_registers(config.xlen, row_width), rules: rules,
        outputs: dispatch_outputs(config.xlen, row_width), decoder_pins: [])
    val module = HwSequentialModuleDef(node_id: HwNodeId.module_root(module_name),
        entity_name: module_name, config: config, origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "decoder-plan"),
                source_name: "riscv.scalar.decode-dispatch.plan." + plan_graph),
            HwOrigin(node_id: HwNodeId.child(module_name, "decoded-uop-interface"),
                source_name: "riscv.scalar.decoded-uop.interface." + descriptor_graph),
            HwOrigin(node_id: HwNodeId.child(module_name, "atomic-capture"),
                source_name: "riscv.scalar.decode-dispatch.atomic-capture-held-until-ready")],
        ports: dispatch_ports(config.xlen, row_width),
        datapath_signals: [HwSignal.comb("illegal_value", "Bits", 1),
            HwSignal.comb("lineage_equal", "Bits", 1)],
        datapath_constants: [HwConstant.bits("zero1", 1, 0)],
        datapath_bit_vector_constants: [], datapath_comb_ops: [
            HwCombOp.binary("eq", "illegal_value", "decoded_valid_reg", "zero1", 1),
            HwCombOp.binary("eq", "lineage_equal", "provider_event_id_reg",
                "decode_event_id_reg", 64)],
        datapath_compare_ops: [], datapath_select_ops: [],
        datapath_bit_extract_ops: [], datapath_fixed_slice_ops: [], plan: sequential,
        child_entity: "", child_graph_sha256: "")
    val diagnostic = module.diagnostic(); if diagnostic != "": return Err(diagnostic)
    for field in descriptor.fields:
        if field.name == "uop_valid":
            if module.port_direction("uop_valid") != "out" or module.port_width("uop_valid") != 1:
                return Err("HWIR-E-RISCV-DECODED-UOP-SKID-PORT: skid must implement the frozen interface")
        elif field.name == "uop_ready":
            if module.port_direction("uop_ready") != "in" or module.port_width("uop_ready") != 1:
                return Err("HWIR-E-RISCV-DECODED-UOP-SKID-PORT: skid must implement the frozen interface")
        elif field.name == "decode_legal":
            if (module.port_direction("decode_legal") != "out" or
                module.port_width("decode_legal") != field.bit_width or
                module.port_direction("upstream_decoded_valid") != "in"):
                return Err("HWIR-E-RISCV-DECODED-UOP-SKID-PORT: skid must implement the frozen interface")
        elif field.name == "lineage_valid":
            if (module.port_direction("lineage_valid") != "out" or
                module.port_width("lineage_valid") != 1):
                return Err("HWIR-E-RISCV-DECODED-UOP-SKID-PORT: skid must implement the frozen interface")
        else:
            val stored_name = if field.name == "decoded_declared_operand_width_is_32":
                "decoded_declared_operand_width_is_32"
            else: field.name
            if (module.port_direction(stored_name) != "out" or
                module.port_width(stored_name) != field.bit_width or
                module.port_direction("upstream_" + stored_name) != "in" or
                module.port_width("upstream_" + stored_name) != field.bit_width):
                return Err("HWIR-E-RISCV-DECODED-UOP-SKID-PORT: skid must implement the frozen interface")
    Ok(module)
