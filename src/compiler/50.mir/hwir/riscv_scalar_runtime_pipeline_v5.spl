# Direct-child scalar runtime pipeline v5 construction seam.
#
# V5 deliberately exposes the one decoder/uop skid and its stateful LSU/FENCE
# children directly.  It does not retain either of the older product wrappers.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef, HwNodeId, HwPort, hwir_hash_fields}
use compiler.mir.hwir.sequential.{HwSequentialModuleDef}
use compiler.mir.hwir.combinational_composition.{HwCombCompositionDef}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v4.{strict_riscv_scalar_runtime_pipeline_v4}
use compiler.mir.hwir.riscv_scalar_completion_interface.{strict_hw_scalar_completion_interface}
use compiler.mir.hwir.riscv_scalar_pending_provider_protocol.{strict_hw_scalar_pending_provider_protocol}
use compiler.mir.hwir.riscv_scalar_pending_provider_owner.{strict_riscv_scalar_pending_provider_owner}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_projection.{strict_riscv_scalar_runtime_lsu_projection}
use compiler.mir.hwir.riscv_scalar_runtime_lsu_owner.{strict_riscv_scalar_runtime_lsu_owner}
use compiler.mir.hwir.riscv_scalar_runtime_fence_provider.{strict_riscv_scalar_runtime_fence_provider}
use compiler.mir.hwir.riscv_scalar_runtime_class_router_v5.{strict_riscv_scalar_runtime_class_router_v5}
use compiler.mir.hwir.riscv_scalar_runtime_immediate_adapter_v5.{strict_riscv_scalar_runtime_immediate_adapter_v5}
use compiler.mir.hwir.riscv_scalar_runtime_completion_merge_v5.{strict_riscv_scalar_runtime_completion_merge_v5}
use compiler.mir.hwir.riscv_scalar_runtime_completion_selector_v5.{strict_riscv_scalar_runtime_completion_selector_v5}
use compiler.mir.hwir.riscv_scalar_runtime_global_fault_gate_v5.{strict_riscv_scalar_runtime_global_fault_gate_v5}
use compiler.mir.hwir.typed_zero_owner.{strict_hw_typed_zero_owner}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{HwScalarDecodedUopInterface}

# A v5 binding is an ownership boundary, not a renderer hint.  In particular,
# composition is the sole public owner; child-private endpoints must never be
# promoted merely to make a partial product appear closed.
pub class HwScalarRuntimePipelineV5Binding:
    source_owner: text
    source_port: text
    destination_owner: text
    destination_port: text
    bit_width: i32

    me canonical_text() -> text:
        hwir_hash_fields(["binding", self.source_owner, self.source_port,
            self.destination_owner, self.destination_port, self.bit_width.to_text()])

fn pipeline_v5_add(rows: [HwScalarRuntimePipelineV5Binding], source_owner: text,
    source_port: text, destination_owner: text, destination_port: text,
    width: i32) -> [HwScalarRuntimePipelineV5Binding]:
    var result = rows
    result.push(HwScalarRuntimePipelineV5Binding(source_owner: source_owner,
        source_port: source_port, destination_owner: destination_owner,
        destination_port: destination_port, bit_width: width))
    result

fn pipeline_v5_top_ports(x: i32, pa: i32, bus_bits: i32, mask_bits: i32) -> [HwPort]:
    # This order is the externally frozen ABI.  Do not derive it from child
    # ports: that would reintroduce the v4 promoted-endpoint failure mode.
    [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("in_valid", "Bits", 1), HwPort.input("instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("rs1_value", "Bits", x), HwPort.input("rs2_value", "Bits", x),
        HwPort.input("pc_before", "Bits", x), HwPort.input("fallthrough_pc", "Bits", x),
        HwPort.input("privilege", "Bits", 2), HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64), HwPort.input("completion_ready", "Bits", 1),
        HwPort.input("bus_request_ready", "Bits", 1), HwPort.input("bus_response_valid", "Bits", 1),
        HwPort.input("bus_response_id", "Bits", 64), HwPort.input("bus_response_data", "Bits", bus_bits),
        HwPort.input("bus_response_fault", "Bits", 1), HwPort.input("bus_response_cause", "Bits", x),
        HwPort.input("bus_response_tval", "Bits", x), HwPort.input("fence_effect_ready", "Bits", 1),
        HwPort.output("in_ready", "Bits", 1), HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("completion_privilege", "Bits", 2),
        HwPort.output("completion_original_instruction", "Bits", 32),
        HwPort.output("completion_canonical_instruction", "Bits", 32),
        HwPort.output("completion_instruction_length_bytes", "Bits", 3),
        HwPort.output("completion_pc_before", "Bits", x), HwPort.output("completion_pc_after", "Bits", x),
        HwPort.output("completion_rd", "Bits", 5), HwPort.output("completion_rd_write", "Bits", 1),
        HwPort.output("completion_rd_value", "Bits", x), HwPort.output("completion_memory_address", "Bits", x),
        HwPort.output("completion_memory_read_mask", "Bits", 32), HwPort.output("completion_memory_write_mask", "Bits", 32),
        HwPort.output("completion_memory_read_data", "Bits", x), HwPort.output("completion_memory_write_data", "Bits", x),
        HwPort.output("completion_execute_trap_valid", "Bits", 1), HwPort.output("completion_execute_trap_cause", "Bits", x),
        HwPort.output("completion_execute_trap_tval", "Bits", x), HwPort.output("completion_memory_trap_valid", "Bits", 1),
        HwPort.output("completion_memory_trap_cause", "Bits", x), HwPort.output("completion_memory_trap_tval", "Bits", x),
        HwPort.output("completion_redirect_valid", "Bits", 1), HwPort.output("completion_redirect_target", "Bits", x),
        HwPort.output("completion_provider_event_id", "Bits", 64),
        HwPort.output("completion_decode_event_id", "Bits", 64),
        HwPort.output("completion_illegal_valid", "Bits", 1),
        HwPort.output("runtime_protocol_fault", "Bits", 1), HwPort.output("bus_request_valid", "Bits", 1),
        HwPort.output("bus_request_id", "Bits", 64), HwPort.output("bus_request_address", "Bits", pa),
        HwPort.output("bus_request_write", "Bits", 1), HwPort.output("bus_request_byte_mask", "Bits", mask_bits),
        HwPort.output("bus_request_write_data", "Bits", bus_bits), HwPort.output("bus_response_ready", "Bits", 1),
        HwPort.output("fence_effect_valid", "Bits", 1), HwPort.output("fence_effect_kind", "Bits", 2),
        HwPort.output("fence_effect_fm", "Bits", 4), HwPort.output("fence_effect_pred", "Bits", 4),
        HwPort.output("fence_effect_succ", "Bits", 4)]

fn pipeline_v5_direct_bindings(x: i32, pa: i32, row_width: i32) -> [HwScalarRuntimePipelineV5Binding]:
    # Ordered direct edges. No endpoint is promoted; the direct product
    # validates complete child-input and public-output closure below.
    var rows: [HwScalarRuntimePipelineV5Binding] = []
    for owner in ["uop_skid", "pending", "lsu", "fence", "completion_skid", "fault_owner"]:
        rows = pipeline_v5_add(rows, "composition", "clk", owner, "clk", 1)
        rows = pipeline_v5_add(rows, "composition", "rst", owner, "rst", 1)
    rows = pipeline_v5_add(rows, "composition", "instruction", "decoder", "instruction", 32)
    # A faulted cycle must not capture an input while publicly reporting it
    # unaccepted.  The fault gate is the sole admission qualifier.
    rows = pipeline_v5_add(rows, "composition", "in_valid", "global_fault_gate", "raw_input_valid", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "input_valid", "uop_skid", "upstream_valid", 1)
    for field in [("decoded_valid", "decoded_valid", 1), ("decoded_row_index", "decoded_row_index", row_width),
            ("decoded_execution_class", "decoded_execution_class", 3), ("decoded_memory_effect", "decoded_memory_effect", 3),
            ("decoded_semantic_opcode", "decoded_semantic_opcode", 6),
            ("decoded_operand_width_32", "decoded_declared_operand_width_is_32", 1),
            ("canonical_instruction", "canonical_instruction", 32), ("instruction_rd_field", "instruction_rd_field", 5),
            ("instruction_rs1_field", "instruction_rs1_field", 5), ("instruction_rs2_field", "instruction_rs2_field", 5)]:
        rows = pipeline_v5_add(rows, "decoder", field[0], "uop_skid", "upstream_" + field[1], field[2])
    for field in [("instruction", "original_instruction", 32), ("instruction_length_bytes", "instruction_length_bytes", 3),
            ("rs1_value", "rs1_value", x), ("rs2_value", "rs2_value", x), ("pc_before", "pc_before", x),
            ("fallthrough_pc", "fallthrough_pc", x), ("privilege", "privilege", 2),
            ("provider_event_id", "provider_event_id", 64), ("decode_event_id", "decode_event_id", 64)]:
        rows = pipeline_v5_add(rows, "composition", field[0], "uop_skid", "upstream_" + field[1], field[2])
    for field in [("uop_valid", 1), ("decode_legal", 1), ("illegal_valid", 1), ("decoded_execution_class", 3)]:
        rows = pipeline_v5_add(rows, "uop_skid", field[0], "router", field[0], field[1])
    # The merge admission ready is the one existing immediate-lane completion
    # capacity signal; it fans out to the router's class-specific accepts.
    # This is a direct source-to-destination fanout, not a promoted top port.
    for ready in ["alu_ready", "control_ready", "system_ready", "illegal_ready"]:
        rows = pipeline_v5_add(rows, "completion_merge", "immediate_ready", "router", ready, 1)
    rows = pipeline_v5_add(rows, "fault_owner", "protocol_fault", "router", "sticky_fault", 1)
    # Stateful dispatch uses the direct router tag and the one decoded-uop
    # source.  `pending.busy` is the frozen owner availability signal; it is
    # deliberately distinct from `dispatch_ready`, which is only the atomic
    # dispatch-accept handshake.
    rows = pipeline_v5_add(rows, "router", "pending_dispatch_valid", "pending", "dispatch_valid", 1)
    rows = pipeline_v5_add(rows, "router", "pending_dispatch_tag", "pending", "dispatch_tag", 3)
    rows = pipeline_v5_add(rows, "pending", "dispatch_ready", "router", "pending_ready", 1)
    rows = pipeline_v5_add(rows, "pending", "busy", "router", "pending_busy", 1)
    for field in [("decode_legal", 1), ("decoded_row_index", row_width),
            ("decoded_execution_class", 3), ("decoded_memory_effect", 3),
            ("decoded_semantic_opcode", 6), ("decoded_declared_operand_width_is_32", 1),
            ("canonical_instruction", 32), ("original_instruction", 32),
            ("instruction_length_bytes", 3), ("instruction_rd_field", 5),
            ("instruction_rs1_field", 5), ("instruction_rs2_field", 5),
            ("rs1_value", x), ("rs2_value", x), ("pc_before", x),
            ("fallthrough_pc", x), ("privilege", 2), ("provider_event_id", 64),
            ("decode_event_id", 64), ("lineage_valid", 1)]:
        rows = pipeline_v5_add(rows, "uop_skid", field[0], "pending", "dispatch_" + field[0], field[1])
    # MulDiv and CSR are deliberately not product children in v5.  The
    # pending owner still has a fixed four-provider protocol, so every input
    # of those disabled lanes is driven by the typed literal-zero capability
    # owner.  This makes their non-participation structural rather than an
    # implicit renderer default, while keeping LSU/FENCE as the only live
    # stateful providers.
    for lane in ["muldiv", "csr"]:
        for field in [("request_ready", 1), ("request_accept", 1),
                ("completion_valid", 1), ("provider_protocol_fault", 1),
                ("completion_tag", 3), ("completion_event_id", 64),
                ("completion_decode_event_id", 64),
                ("completion_privilege", 2), ("completion_original_instruction", 32),
                ("completion_canonical_instruction", 32), ("completion_instruction_length_bytes", 3),
                ("completion_pc_before", x), ("completion_pc_after", x),
                ("completion_rd", 5), ("completion_rd_write", 1),
                ("completion_rd_value", x), ("completion_memory_address", x),
                ("completion_memory_read_mask", 32), ("completion_memory_write_mask", 32),
                ("completion_memory_read_data", x), ("completion_memory_write_data", x),
                ("completion_execute_trap_valid", 1), ("completion_execute_trap_cause", x),
                ("completion_execute_trap_tval", x), ("completion_memory_trap_valid", 1),
                ("completion_memory_trap_cause", x), ("completion_memory_trap_tval", x),
                ("completion_redirect_valid", 1), ("completion_redirect_target", x),
                ("completion_illegal_valid", 1)]:
            rows = pipeline_v5_add(rows, "zero_defaults", "zero_" + field[1].to_text(),
                "pending", lane + "_" + field[0], field[1])
    # The pending LSU request is the sole projection input source; projection
    # is combinational and does not own a second copy of decoded context.
    for field in [("uop_valid", "valid", 1), ("decode_legal", "decode_legal", 1),
            ("decoded_row_index", "decoded_row_index", row_width),
            ("decoded_execution_class", "decoded_execution_class", 3),
            ("decoded_memory_effect", "decoded_memory_effect", 3),
            ("decoded_semantic_opcode", "decoded_semantic_opcode", 6),
            ("decoded_declared_operand_width_is_32", "decoded_declared_operand_width_is_32", 1),
            ("canonical_instruction", "canonical_instruction", 32),
            ("instruction_rd_field", "instruction_rd_field", 5),
            ("instruction_rs1_field", "instruction_rs1_field", 5),
            ("instruction_rs2_field", "instruction_rs2_field", 5),
            ("rs1_value", "rs1_value", x), ("rs2_value", "rs2_value", x)]:
        rows = pipeline_v5_add(rows, "pending", "lsu_request_" + field[1], "projection", field[0], field[2])
    rows = pipeline_v5_add(rows, "pending", "lsu_request_valid", "lsu", "request_valid", 1)
    rows = pipeline_v5_add(rows, "pending", "lsu_request_provider_tag", "lsu", "request_provider_tag", 3)
    for field in [("projection_valid", 1), ("protocol_fault", 1), ("local_fault", 1),
            ("local_cause", x), ("local_tval", x), ("effective_address", pa),
            ("access_size_bytes", 4), ("access_signed_load", 1), ("access_rd_index", 5)]:
        rows = pipeline_v5_add(rows, "projection", field[0], "lsu",
            if field[0] == "projection_valid": field[0] elif field[0] == "protocol_fault": "projection_protocol_fault" else: field[0], field[1])
    for field in [("request_write", "projected_request_write", 1),
            ("request_byte_mask", "projected_request_byte_mask", x / 8),
            ("request_write_data", "projected_request_write_data", x)]:
        rows = pipeline_v5_add(rows, "projection", field[0], "lsu", field[1], field[2])
    for field in [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
            ("instruction_length_bytes", 3), ("pc_before", x), ("fallthrough_pc", x),
            ("provider_event_id", 64), ("decode_event_id", 64)]:
        val destination = if field[0] == "fallthrough_pc": "request_pc_after" else: "request_" + field[0]
        rows = pipeline_v5_add(rows, "pending", "lsu_request_" + field[0], "lsu", destination, field[1])
    # Router pending dispatch is qualified by legal_uop, so an illegal uop can
    # never reach either stateful owner.  Their required illegal context is
    # nevertheless driven by this typed one-bit zero, never left implicit.
    rows = pipeline_v5_add(rows, "zero_defaults", "zero_1", "lsu",
        "request_illegal_valid", 1)
    # Raw handshake booleans are gated; bus payload remains a direct ABI row.
    for field in [("bus_request_ready", 1), ("bus_response_valid", 1)]:
        rows = pipeline_v5_add(rows, "composition", field[0], "global_fault_gate", "raw_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "global_fault_gate", field[0], "lsu", field[0], field[1])
    for field in [("bus_response_id", 64), ("bus_response_data", x), ("bus_response_fault", 1),
            ("bus_response_cause", x), ("bus_response_tval", x)]:
        rows = pipeline_v5_add(rows, "composition", field[0], "lsu", field[0], field[1])
    for field in [("request_ready", "lsu_request_ready", 1), ("request_accept", "lsu_request_accept", 1),
            ("completion_valid", "lsu_completion_valid", 1),
            ("completion_provider_tag", "lsu_completion_tag", 3),
            ("provider_protocol_fault", "lsu_provider_protocol_fault", 1)]:
        rows = pipeline_v5_add(rows, "lsu", field[0], "pending", field[1], field[2])
    for field in [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
            ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x), ("rd", 5),
            ("rd_write", 1), ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
            ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
            ("redirect_valid", 1), ("redirect_target", x), ("illegal_valid", 1)]:
        rows = pipeline_v5_add(rows, "lsu", "completion_" + field[0], "pending",
            "lsu_completion_" + field[0], field[1])
    rows = pipeline_v5_add(rows, "lsu", "completion_provider_event_id", "pending",
        "lsu_completion_event_id", 64)
    rows = pipeline_v5_add(rows, "lsu", "completion_decode_event_id", "pending",
        "lsu_completion_decode_event_id", 64)
    rows = pipeline_v5_add(rows, "pending", "lsu_completion_ready", "lsu",
        "completion_ready", 1)
    # FENCE is the other supported pending provider and has the same exact
    # held-uop request/return protocol, with its raw effect ready gated.
    for field in [("request_valid", "valid", 1), ("request_provider_tag", "provider_tag", 3),
            ("decode_legal", "decode_legal", 1), ("decoded_row_index", "decoded_row_index", row_width),
            ("decoded_execution_class", "decoded_execution_class", 3), ("decoded_memory_effect", "decoded_memory_effect", 3),
            ("decoded_semantic_opcode", "decoded_semantic_opcode", 6),
            ("decoded_declared_operand_width_is_32", "decoded_declared_operand_width_is_32", 1),
            ("canonical_instruction", "canonical_instruction", 32), ("original_instruction", "original_instruction", 32),
            ("instruction_length_bytes", "instruction_length_bytes", 3), ("instruction_rd_field", "instruction_rd_field", 5),
            ("instruction_rs1_field", "instruction_rs1_field", 5), ("instruction_rs2_field", "instruction_rs2_field", 5),
            ("rs1_value", "rs1_value", x), ("rs2_value", "rs2_value", x), ("pc_before", "pc_before", x),
            ("fallthrough_pc", "fallthrough_pc", x), ("privilege", "privilege", 2),
            ("provider_event_id", "provider_event_id", 64), ("decode_event_id", "decode_event_id", 64),
            ("lineage_valid", "lineage_valid", 1)]:
        rows = pipeline_v5_add(rows, "pending", "fence_request_" + field[1], "fence", field[0], field[2])
    rows = pipeline_v5_add(rows, "zero_defaults", "zero_1", "fence",
        "illegal_valid", 1)
    rows = pipeline_v5_add(rows, "composition", "fence_effect_ready", "global_fault_gate", "raw_fence_effect_ready", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "fence_effect_ready", "fence", "fence_effect_ready", 1)
    for field in [("request_ready", "fence_request_ready", 1), ("request_accept", "fence_request_accept", 1),
            ("completion_valid", "fence_completion_valid", 1),
            ("completion_provider_tag", "fence_completion_tag", 3),
            ("provider_protocol_fault", "fence_provider_protocol_fault", 1)]:
        rows = pipeline_v5_add(rows, "fence", field[0], "pending", field[1], field[2])
    for field in [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
            ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x), ("rd", 5),
            ("rd_write", 1), ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
            ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
            ("redirect_valid", 1), ("redirect_target", x), ("illegal_valid", 1)]:
        rows = pipeline_v5_add(rows, "fence", "completion_" + field[0], "pending",
            "fence_completion_" + field[0], field[1])
    rows = pipeline_v5_add(rows, "fence", "completion_provider_event_id", "pending",
        "fence_completion_event_id", 64)
    rows = pipeline_v5_add(rows, "fence", "completion_decode_event_id", "pending",
        "fence_completion_decode_event_id", 64)
    rows = pipeline_v5_add(rows, "pending", "fence_completion_ready", "fence",
        "completion_ready", 1)
    rows = pipeline_v5_add(rows, "completion_merge", "pending_ready", "pending", "downstream_ready", 1)
    rows = pipeline_v5_add(rows, "pending", "selected_completion_valid", "completion_merge", "pending_valid", 1)
    rows = pipeline_v5_add(rows, "pending", "protocol_fault", "completion_merge", "pending_fault", 1)
    for field in [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
            ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x), ("rd", 5),
            ("rd_write", 1), ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
            ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
            ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
            ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
            ("redirect_valid", 1), ("redirect_target", x), ("illegal_valid", 1)]:
        rows = pipeline_v5_add(rows, "pending", "selected_completion_" + field[0],
            "completion_merge", "pending_" + field[0], field[1])
    rows = pipeline_v5_add(rows, "pending", "selected_completion_event_id",
        "completion_merge", "pending_provider_event_id", 64)
    rows = pipeline_v5_add(rows, "pending", "selected_completion_decode_event_id",
        "completion_merge", "pending_decode_event_id", 64)
    rows = pipeline_v5_add(rows, "router", "uop_ready", "uop_skid", "uop_ready", 1)
    for lane in ["alu", "control", "system", "illegal"]:
        rows = pipeline_v5_add(rows, "router", if lane == "illegal": "illegal_lane_valid" else: lane + "_valid",
            "immediate_adapter", lane + "_valid", 1)
    rows = pipeline_v5_add(rows, "immediate_adapter", "selector_uop_valid", "selector", "uop_valid", 1)
    # A provider sees its router-qualified valid, but every other decoded
    # field comes from the one held uop.  This is intentionally explicit: no
    # provider input is inferred from the former v4 product wrapper.
    val uop_fields = [("decode_legal", 1), ("decoded_row_index", row_width),
        ("decoded_execution_class", 3), ("decoded_memory_effect", 3),
        ("decoded_semantic_opcode", 6), ("decoded_declared_operand_width_is_32", 1),
        ("canonical_instruction", 32), ("original_instruction", 32),
        ("instruction_length_bytes", 3), ("instruction_rd_field", 5),
        ("instruction_rs1_field", 5), ("instruction_rs2_field", 5),
        ("rs1_value", x), ("rs2_value", x), ("pc_before", x),
        ("fallthrough_pc", x), ("privilege", 2), ("provider_event_id", 64),
        ("decode_event_id", 64), ("lineage_valid", 1)]
    for lane in ["alu", "control", "system"]:
        rows = pipeline_v5_add(rows, "router", lane + "_valid", lane, "uop_valid", 1)
        for field in uop_fields:
            rows = pipeline_v5_add(rows, "uop_skid", field[0], lane, field[0], field[1])
    rows = pipeline_v5_add(rows, "router", "illegal_lane_valid", "illegal_provider", "uop_valid", 1)
    for field in [("decode_legal", 1), ("illegal_valid", 1), ("lineage_valid", 1),
            ("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
            ("instruction_length_bytes", 3), ("pc_before", x), ("fallthrough_pc", x),
            ("provider_event_id", 64), ("decode_event_id", 64)]:
        rows = pipeline_v5_add(rows, "uop_skid", field[0], "illegal_provider", field[0], field[1])
    # The v5 selector retains invariant held-uop lineage; provider PC-after
    # remains authoritative for redirects and precise traps.
    # Its valid is adapter-owned above; router owns the skid ready return.
    for field in [("illegal_valid", "uop_illegal_valid", 1),
            ("lineage_valid", "uop_lineage_valid", 1),
            ("decoded_execution_class", "uop_decoded_execution_class", 3),
            ("privilege", "uop_privilege", 2),
            ("original_instruction", "uop_original_instruction", 32),
            ("canonical_instruction", "uop_canonical_instruction", 32),
            ("instruction_length_bytes", "uop_instruction_length_bytes", 3),
            ("pc_before", "uop_pc_before", x),
            ("provider_event_id", "uop_provider_event_id", 64),
            ("decode_event_id", "uop_decode_event_id", 64)]:
        rows = pipeline_v5_add(rows, "uop_skid", field[0], "selector", field[1], field[2])
    for lane in [("alu", "alu", "retire_valid", "protocol_fault"),
            ("control", "control", "completion_valid", "protocol_fault"),
            ("system", "system", "completion_valid", "protocol_fault"),
            ("illegal_provider", "illegal", "completion_valid", "protocol_fault")]:
        rows = pipeline_v5_add(rows, lane[0], lane[2], "selector", lane[1] + "_valid", 1)
        rows = pipeline_v5_add(rows, lane[0], lane[3], "selector", lane[1] + "_fault", 1)
    val completion_fields = [("privilege", 2), ("original_instruction", 32),
        ("canonical_instruction", 32), ("instruction_length_bytes", 3),
        ("pc_before", x), ("pc_after", x), ("rd", 5), ("rd_write", 1),
        ("rd_value", x), ("memory_address", x), ("memory_read_mask", 32),
        ("memory_write_mask", 32), ("memory_read_data", x), ("memory_write_data", x),
        ("execute_trap_valid", 1), ("execute_trap_cause", x), ("execute_trap_tval", x),
        ("memory_trap_valid", 1), ("memory_trap_cause", x), ("memory_trap_tval", x),
        ("redirect_valid", 1), ("redirect_target", x), ("provider_event_id", 64),
        ("decode_event_id", 64), ("illegal_valid", 1)]
    for field in completion_fields:
        val alu_owner = if ["privilege", "original_instruction", "canonical_instruction",
                "instruction_length_bytes", "pc_before", "pc_after", "rd", "rd_write",
                "rd_value"].contains(field[0]): "alu" elif ["provider_event_id",
                "decode_event_id"].contains(field[0]): "uop_skid" else: "defaults"
        val alu_port = if alu_owner == "alu": "retire_" + field[0]
            elif field[0] == "illegal_valid": "memory_trap_valid" else: field[0]
        rows = pipeline_v5_add(rows, alu_owner, alu_port, "selector", "alu_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "control", "completion_" + field[0], "selector", "control_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "system", "completion_" + field[0], "selector", "system_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "illegal_provider", "completion_" + field[0], "selector", "illegal_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "selector", "selected_" + field[0], "completion_merge", "immediate_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "completion_merge", "selected_" + field[0], "completion_skid", "upstream_" + field[0], field[1])
    rows = pipeline_v5_add(rows, "selector", "selected_valid", "completion_merge", "immediate_valid", 1)
    rows = pipeline_v5_add(rows, "selector", "selector_fault", "completion_merge", "immediate_fault", 1)
    rows = pipeline_v5_add(rows, "completion_skid", "upstream_ready", "completion_merge", "skid_upstream_ready", 1)
    rows = pipeline_v5_add(rows, "completion_merge", "immediate_ready", "selector", "completion_ready", 1)
    rows = pipeline_v5_add(rows, "completion_merge", "selected_valid", "completion_skid", "upstream_valid", 1)
    rows = pipeline_v5_add(rows, "composition", "completion_ready", "global_fault_gate", "raw_completion_ready", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "completion_ready", "completion_skid", "downstream_ready", 1)
    for field in completion_fields:
        rows = pipeline_v5_add(rows, "completion_skid", "completion_" + field[0],
            "composition", "completion_" + field[0], field[1])
    rows = pipeline_v5_add(rows, "uop_skid", "upstream_ready", "global_fault_gate", "raw_input_ready", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "input_ready", "composition", "in_ready", 1)
    rows = pipeline_v5_add(rows, "completion_skid", "completion_valid", "global_fault_gate", "raw_completion_valid", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "completion_valid", "composition", "completion_valid", 1)
    for field in [("bus_request_valid", 1), ("bus_response_ready", 1)]:
        rows = pipeline_v5_add(rows, "lsu", field[0], "global_fault_gate", "raw_" + field[0], field[1])
        rows = pipeline_v5_add(rows, "global_fault_gate", field[0], "composition", field[0], field[1])
    for field in [("bus_request_id", 64), ("bus_request_address", pa), ("bus_request_write", 1),
            ("bus_request_byte_mask", x / 8), ("bus_request_write_data", x)]:
        rows = pipeline_v5_add(rows, "lsu", field[0], "composition", field[0], field[1])
    rows = pipeline_v5_add(rows, "fence", "fence_effect_valid", "global_fault_gate", "raw_fence_effect_valid", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "fence_effect_valid", "composition", "fence_effect_valid", 1)
    for field in [("fence_effect_kind", 2), ("fence_effect_fm", 4), ("fence_effect_pred", 4),
            ("fence_effect_succ", 4)]:
        rows = pipeline_v5_add(rows, "fence", field[0], "composition", field[0], field[1])
    for fault in [("router", "router_fault", "router_fault"),
            ("uop_skid", "protocol_fault", "decoded_uop_skid_fault"),
            ("immediate_adapter", "adapter_fault", "adapter_fault"),
            ("selector", "selector_fault", "selector_fault"),
            ("pending", "protocol_fault", "pending_fault"),
            ("projection", "protocol_fault", "projection_fault"),
            ("lsu", "provider_protocol_fault", "lsu_fault"),
            ("fence", "provider_protocol_fault", "fence_fault"),
            ("completion_merge", "merge_fault", "merge_fault"),
            ("completion_skid", "protocol_fault", "completion_skid_fault")]:
        rows = pipeline_v5_add(rows, fault[0], fault[1], "global_fault_gate", fault[2], 1)
    rows = pipeline_v5_add(rows, "fault_owner", "protocol_fault", "global_fault_gate", "sticky_fault", 1)
    rows = pipeline_v5_add(rows, "global_fault_gate", "fault_in", "fault_owner", "fault_in", 1)
    rows = pipeline_v5_add(rows, "fault_owner", "protocol_fault", "composition", "runtime_protocol_fault", 1)
    rows

pub class HwScalarRuntimePipelineV5Direct:
    node_id: HwNodeId
    module_name: text
    config: CoreConfig
    bus: LsuConfig
    plan: RiscvScalarDecoderPlan
    descriptor: HwScalarDecodedUopInterface
    # There is exactly one public decoder and one public decoded-uop skid.
    decoder: HwModuleDef
    uop_skid: HwSequentialModuleDef
    alu: HwModuleDef
    control: HwCombCompositionDef
    system: HwModuleDef
    illegal_provider: HwModuleDef
    router: HwModuleDef
    immediate_adapter: HwModuleDef
    # Stateful V2 contributes these leaves only; it is never retained as a child.
    pending: HwSequentialModuleDef
    projection: HwModuleDef
    lsu: HwSequentialModuleDef
    fence: HwSequentialModuleDef
    selector: HwModuleDef
    completion_merge: HwModuleDef
    completion_skid: HwSequentialModuleDef
    global_fault_gate: HwModuleDef
    fault_owner: HwSequentialModuleDef
    defaults: HwModuleDef
    zero_defaults: HwModuleDef
    top_ports: [HwPort]
    bindings: [HwScalarRuntimePipelineV5Binding]

    me owner_ports(owner: text) -> [HwPort]:
        if owner == "composition": return self.top_ports
        if owner == "decoder": return self.decoder.ports
        if owner == "uop_skid": return self.uop_skid.ports
        if owner == "alu": return self.alu.ports
        if owner == "control": return self.control.top_ports
        if owner == "system": return self.system.ports
        if owner == "illegal_provider": return self.illegal_provider.ports
        if owner == "router": return self.router.ports
        if owner == "immediate_adapter": return self.immediate_adapter.ports
        if owner == "pending": return self.pending.ports
        if owner == "projection": return self.projection.ports
        if owner == "lsu": return self.lsu.ports
        if owner == "fence": return self.fence.ports
        if owner == "selector": return self.selector.ports
        if owner == "completion_merge": return self.completion_merge.ports
        if owner == "completion_skid": return self.completion_skid.ports
        if owner == "global_fault_gate": return self.global_fault_gate.ports
        if owner == "fault_owner": return self.fault_owner.ports
        if owner == "defaults": return self.defaults.ports
        if owner == "zero_defaults": return self.zero_defaults.ports
        []

    me binding_list_sha256() -> text:
        var rows = [hwir_hash_fields(["hwir-riscv-scalar-runtime-binding/v5"])]
        for binding in self.bindings: rows.push(binding.canonical_text())
        sha256_text(hwir_hash_fields(rows))

    # Validates the exact ordered direct wiring closure.
    me binding_prefix_diagnostic() -> text:
        self.local_diagnostic()

    me local_diagnostic() -> text:
        if self.module_name == "":
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-ID: pipeline requires a module name"
        val error = self.config.diagnostic(); if error != "": return error
        val bus_error = self.bus.diagnostic(); if bus_error != "": return bus_error
        if self.config.compressed_decode_profile != "none":
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-COMPRESSED: v5 requires canonical four-byte lineage"
        if self.bus.bus_data_bits != self.config.xlen:
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-BUS: v5 requires one XLEN-wide pending LSU beat"
        val control_error = self.control.diagnostic()
        if control_error != "": return control_error
        for child in [self.decoder, self.alu, self.system, self.illegal_provider,
                self.router, self.immediate_adapter, self.projection, self.selector,
                self.completion_merge, self.global_fault_gate, self.defaults,
                self.zero_defaults]:
            val diagnostic = child.shape_diagnostic()
            if diagnostic != "": return diagnostic
        for child in [self.uop_skid, self.pending, self.lsu, self.fence,
                self.completion_skid, self.fault_owner]:
            val diagnostic = child.shape_diagnostic()
            if diagnostic != "": return diagnostic
        var destinations: [text] = []
        var sources: [text] = []
        for binding in self.bindings:
            var source_found = false
            var source_direction = ""
            var source_width = 0
            for port in self.owner_ports(binding.source_owner):
                if port.name == binding.source_port:
                    source_found = true; source_direction = port.direction; source_width = port.bit_width
            var destination_found = false
            var destination_direction = ""
            var destination_width = 0
            for port in self.owner_ports(binding.destination_owner):
                if port.name == binding.destination_port:
                    destination_found = true; destination_direction = port.direction; destination_width = port.bit_width
            if not source_found or not destination_found:
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-ENDPOINT: binding endpoint must exist"
            if ((binding.source_owner == "composition" and source_direction != "in") or
                (binding.source_owner != "composition" and source_direction != "out") or
                (binding.destination_owner == "composition" and destination_direction != "out") or
                (binding.destination_owner != "composition" and destination_direction != "in")):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-DIRECTION: binding direction must be source-to-destination"
            if binding.bit_width <= 0 or source_width != binding.bit_width or destination_width != binding.bit_width:
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-WIDTH: binding widths must match both endpoints"
            val key = (binding.destination_owner + "." + binding.destination_port).lower()
            if destinations.contains(key):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-DRIVER: every bound destination requires exactly one driver"
            destinations.push(key)
            sources.push((binding.source_owner + "." + binding.source_port).lower())
        for owner in ["decoder", "uop_skid", "alu", "control", "system",
                "illegal_provider", "router", "immediate_adapter", "pending",
                "projection", "lsu", "fence", "selector", "completion_merge",
                "completion_skid", "global_fault_gate", "fault_owner", "defaults",
                "zero_defaults"]:
            for port in self.owner_ports(owner):
                if port.direction == "in" and not destinations.contains((owner + "." + port.name).lower()):
                    return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-CLOSURE: every child input requires one binding"
        for port in self.top_ports:
            if port.direction == "out" and not destinations.contains(("composition." + port.name).lower()):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-CLOSURE: every top output requires one binding"
            if port.direction == "in" and not sources.contains(("composition." + port.name).lower()):
                return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-CLOSURE: every top input requires one source binding"
        ""

    me structural_sha256() -> text:
        val rows = ["hwir-riscv-scalar-runtime-pipeline/v5-direct", self.node_id.value,
            self.module_name, self.config.xlen.to_text(),
            self.config.physical_address_bits.to_text(), self.config.register_count.to_text(),
            self.config.profile, self.config.isa_profile, self.config.compressed_decode_profile,
            self.bus.bus_data_bits.to_text(), self.bus.byte_mask_bits.to_text(),
            self.plan.structural_sha256(), self.descriptor.structural_sha256(),
            self.decoder.structural_sha256(), self.uop_skid.structural_sha256(),
            self.alu.structural_sha256(), self.control.structural_sha256(),
            self.system.structural_sha256(), self.illegal_provider.structural_sha256(),
            self.router.structural_sha256(), self.immediate_adapter.structural_sha256(),
            self.pending.structural_sha256(), self.projection.structural_sha256(),
            self.lsu.structural_sha256(), self.fence.structural_sha256(),
            self.selector.structural_sha256(), self.completion_merge.structural_sha256(),
            self.completion_skid.structural_sha256(), self.global_fault_gate.structural_sha256(),
            self.fault_owner.structural_sha256(), self.defaults.structural_sha256(),
            self.zero_defaults.structural_sha256()]
        for port in self.top_ports:
            rows.push(hwir_hash_fields(["port", port.name, port.direction,
                port.type_name, port.bit_width.to_text(), port.clock_domain]))
        rows.push(self.binding_list_sha256())
        sha256_text(hwir_hash_fields(rows))

    me diagnostic() -> text:
        val local = self.local_diagnostic(); if local != "": return local
        val rebuilt = strict_riscv_scalar_runtime_pipeline_v5_direct(self.module_name,
            self.config, self.bus)
        if rebuilt.is_err(): return rebuilt.err().unwrap()
        if self.structural_sha256() != rebuilt.ok().unwrap().structural_sha256():
            return "HWIR-E-RISCV-RUNTIME-PIPELINE-V5-CANONICAL: pipeline requires exact direct compiler-owned children"
        ""

pub fn strict_riscv_scalar_runtime_pipeline_v5_direct(module_name: text,
    config: CoreConfig, bus: LsuConfig) -> Result<HwScalarRuntimePipelineV5Direct, text>:
    if module_name == "":
        return Err("HWIR-E-RISCV-RUNTIME-PIPELINE-V5-ID: pipeline requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val bus_error = bus.diagnostic(); if bus_error != "": return Err(bus_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-PIPELINE-V5-COMPRESSED: v5 requires canonical four-byte lineage")
    if bus.bus_data_bits != config.xlen:
        return Err("HWIR-E-RISCV-RUNTIME-PIPELINE-V5-BUS: v5 requires one XLEN-wide pending LSU beat")
    # V4 remains the canonical immediate-path constructor.  The stateful-v2
    # leaf constructors are applied directly to this decoder/descriptor: no
    # nested product and no second decoder are created.
    val immediate = strict_riscv_scalar_runtime_pipeline_v4(module_name + "_immediate", config)?
    val completion = strict_hw_scalar_completion_interface(config, bus)?
    val protocol = strict_hw_scalar_pending_provider_protocol(config, immediate.descriptor,
        immediate.decoder, immediate.plan, completion)?
    val pending = strict_riscv_scalar_pending_provider_owner(module_name + "_pending",
        protocol, immediate.descriptor, immediate.decoder, immediate.plan, completion)?
    val projection = strict_riscv_scalar_runtime_lsu_projection(module_name + "_projection",
        config, bus, immediate.descriptor, immediate.decoder, immediate.plan)?
    val lsu = strict_riscv_scalar_runtime_lsu_owner(module_name + "_lsu", config, bus)?
    val fence = strict_riscv_scalar_runtime_fence_provider(module_name + "_fence",
        config, immediate.plan)?
    val router = strict_riscv_scalar_runtime_class_router_v5(module_name + "_router", config)?
    val immediate_adapter = strict_riscv_scalar_runtime_immediate_adapter_v5(
        module_name + "_immediate_adapter", config)?
    val completion_merge = strict_riscv_scalar_runtime_completion_merge_v5(
        module_name + "_completion_merge", config)?
    val selector = strict_riscv_scalar_runtime_completion_selector_v5(
        module_name + "_selector", config)?
    val global_fault_gate = strict_riscv_scalar_runtime_global_fault_gate_v5(
        module_name + "_global_fault_gate", config)?
    # Fixed schema for every disabled MulDiv/CSR protocol input.  XLEN is
    # constrained to 32 or 64, both explicitly present, so this child is
    # stable across supported scalar configurations.
    val zero_defaults = strict_hw_typed_zero_owner(module_name + "_zero_defaults",
        config, [1, 2, 3, 5, 32, 64])?
    val result = HwScalarRuntimePipelineV5Direct(node_id: HwNodeId.module_root(module_name),
        module_name: module_name, config: config, bus: bus, plan: immediate.plan,
        descriptor: immediate.descriptor, decoder: immediate.decoder,
        uop_skid: immediate.uop_skid, alu: immediate.alu, control: immediate.control,
        system: immediate.system, illegal_provider: immediate.illegal_provider,
        router: router, immediate_adapter: immediate_adapter, pending: pending,
        projection: projection, lsu: lsu, fence: fence,
        selector: selector, completion_merge: completion_merge,
        completion_skid: immediate.completion_skid, global_fault_gate: global_fault_gate,
        fault_owner: immediate.fault_owner, defaults: immediate.defaults,
        zero_defaults: zero_defaults,
        top_ports: pipeline_v5_top_ports(config.xlen, config.physical_address_bits,
            bus.bus_data_bits, bus.byte_mask_bits),
        bindings: pipeline_v5_direct_bindings(config.xlen, config.physical_address_bits,
            immediate.descriptor.row_width))
    val error = result.local_diagnostic(); if error != "": return Err(error)
    Ok(result)

# Stable v5 entry point; the explicit bus geometry remains part of the product
# contract rather than being inferred from XLEN.
pub fn strict_riscv_scalar_runtime_pipeline_v5(module_name: text, config: CoreConfig,
    bus: LsuConfig) -> Result<HwScalarRuntimePipelineV5Direct, text>:
    strict_riscv_scalar_runtime_pipeline_v5_direct(module_name, config, bus)
