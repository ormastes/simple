# Clocked, single-outstanding restoring divider for Gen2 M.

use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}
use compiler.mir.hwir.types.{CoreConfig, HwBitExtractOp, HwCombOp, HwCompareOp,
    HwFixedSliceOp, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard, HwSeqOutputBinding,
    HwSeqRule, HwSeqValue, HwSequentialModuleDef, HwSequentialPlan}
use compiler.mir.hwir.riscv_scalar_muldiv_projection.{RiscvScalarMulDivProjection}
use compiler.mir.hwir.riscv_scalar_muldiv_iterative_contract.{
    strict_riscv_scalar_muldiv_iterative_contract}
use compiler.mir.hwir.riscv_scalar_muldiv_dispatch_datapath.{
    strict_riscv_scalar_muldiv_dispatch_datapath}
use compiler.mir.hwir.riscv_scalar_restoring_divider_datapath.{
    strict_riscv_scalar_restoring_divider_datapath}
use compiler.mir.hwir.riscv_scalar_muldiv_completion.{
    riscv_scalar_muldiv_completion_outputs, riscv_scalar_muldiv_metadata_capture,
    riscv_scalar_muldiv_owner_ports}

fn divider_ports(xlen: i32) -> [HwPort]:
    riscv_scalar_muldiv_owner_ports(xlen)

fn add_signals(a: [HwSignal], b: [HwSignal]) -> [HwSignal]:
    var out = a; for value in b: out.push(value); out
fn add_constants(a: [HwBitVectorConstant], b: [HwBitVectorConstant]) -> [HwBitVectorConstant]:
    var out = a; for value in b: out.push(value); out
fn add_comb(a: [HwCombOp], b: [HwCombOp]) -> [HwCombOp]:
    var out = a; for value in b: out.push(value); out
fn add_select(a: [HwSelectOp], b: [HwSelectOp]) -> [HwSelectOp]:
    var out = a; for value in b: out.push(value); out
fn add_extract(a: [HwBitExtractOp], b: [HwBitExtractOp]) -> [HwBitExtractOp]:
    var out = a; for value in b: out.push(value); out

fn bits(value: i32, width: i32) -> text:
    var out = ""; var index = width - 1
    while index >= 0:
        out = out + (if ((value >> index) & 1) == 1: "1" else: "0")
        index = index - 1
    out

fn bits32(value: u32) -> text:
    var out = ""; var index = 31
    while index >= 0:
        out = out + (if ((value >> index) & 1) == 1: "1" else: "0")
        index = index - 1
    out

fn zero_bits(width: i32) -> text:
    var out = ""; var index = 0
    while index < width:
        out = out + "0"; index = index + 1
    out

pub fn strict_riscv_scalar_iterative_divider(name: text, config: CoreConfig,
    projection: RiscvScalarMulDivProjection) -> Result<HwSequentialModuleDef, text>:
    if name == "": return Err("HWIR-E-RISCV-DIVIDER-ID: iterative divider requires a module name")
    if projection.config.profile != config.profile or projection.config.xlen != config.xlen:
        return Err("HWIR-E-RISCV-DIVIDER-CONFIG: iterative divider requires the exact projection configuration")
    val contract = strict_riscv_scalar_muldiv_iterative_contract(projection)?
    if contract.family != "divide": return Err("HWIR-E-RISCV-DIVIDER-FAMILY: divider requires a divide or remainder projection")
    val dispatch = strict_riscv_scalar_muldiv_dispatch_datapath(contract)?
    val divide = strict_riscv_scalar_restoring_divider_datapath(contract)?
    val w = contract.operand_width; val x = contract.xlen; val remw = contract.remainder_width
    val countw = contract.count_width
    var signals = add_signals(dispatch.signals, divide.signals)
    for signal in [HwSignal.comb("rhs_magnitude_remainder", "Bits", remw),
        HwSignal.comb("count_is_width", "Bits", 1), HwSignal.comb("special_nonzero", "Bits", 1),
        HwSignal.comb("finalize_ready", "Bits", 1), HwSignal.comb("canonical_match", "Bits", 1),
        HwSignal.comb("original_match", "Bits", 1), HwSignal.comb("instruction_match", "Bits", 1),
        HwSignal.comb("rd_match", "Bits", 1), HwSignal.comb("rs1_match", "Bits", 1),
        HwSignal.comb("rs2_match", "Bits", 1), HwSignal.comb("event_match", "Bits", 1),
        HwSignal.comb("length_match", "Bits", 1), HwSignal.comb("illegal_clear", "Bits", 1),
        HwSignal.comb("identity_a", "Bits", 1), HwSignal.comb("identity_b", "Bits", 1),
        HwSignal.comb("identity_c", "Bits", 1), HwSignal.comb("identity_d", "Bits", 1),
        HwSignal.comb("identity_e", "Bits", 1), HwSignal.comb("identity_ok", "Bits", 1),
        HwSignal.comb("identity_final", "Bits", 1), HwSignal.comb("rd_nonzero", "Bits", 1)]: signals.push(signal)
    var constants = add_constants(dispatch.constants, divide.constants)
    for constant in [HwBitVectorConstant.binary("frozen_instruction_owner", 32, bits32(projection.canonical_instruction)),
        HwBitVectorConstant.binary("frozen_rd_owner", 5, bits(projection.rd_index, 5)),
        HwBitVectorConstant.binary("frozen_rs1_owner", 5, bits(projection.rs1_index, 5)),
        HwBitVectorConstant.binary("frozen_rs2_owner", 5, bits(projection.rs2_index, 5)),
        HwBitVectorConstant.binary("length_four_owner", 3, "100"),
        HwBitVectorConstant.binary("zero1_owner", 1, "0"),
        HwBitVectorConstant.binary("zero32_owner", 32, bits32(0)),
        HwBitVectorConstant.binary("zero_xlen_owner", x, zero_bits(x)),
        HwBitVectorConstant.binary("zero5_owner", 5, "00000"),
        HwBitVectorConstant.binary("count_width_owner", countw, bits(w, countw))]: constants.push(constant)
    var comb = add_comb(dispatch.comb_ops, divide.comb_ops)
    for op in [HwCombOp.unary("zext", "rhs_magnitude_remainder", "rhs_magnitude", remw),
        HwCombOp.binary("ne", "special_nonzero", "special_reg", "zero_special", 2),
        HwCombOp.binary("or", "finalize_ready", "count_is_width", "special_nonzero", 1),
        HwCombOp.binary("eq", "canonical_match", "dispatch_canonical_instruction", "frozen_instruction_owner", 32),
        HwCombOp.binary("eq", "original_match", "dispatch_original_instruction", "frozen_instruction_owner", 32),
        HwCombOp.binary("and", "instruction_match", "canonical_match", "original_match", 1),
        HwCombOp.binary("eq", "rd_match", "dispatch_rd", "frozen_rd_owner", 5),
        HwCombOp.binary("eq", "rs1_match", "rs1_index", "frozen_rs1_owner", 5),
        HwCombOp.binary("eq", "rs2_match", "rs2_index", "frozen_rs2_owner", 5),
        HwCombOp.binary("eq", "event_match", "dispatch_event_id", "decode_event_id", 64),
        HwCombOp.binary("eq", "length_match", "dispatch_instruction_length_bytes", "length_four_owner", 3),
        HwCombOp.binary("eq", "illegal_clear", "illegal_valid", "zero1_owner", 1),
        HwCombOp.binary("and", "identity_a", "dispatch_lineage_valid", "event_match", 1),
        HwCombOp.binary("and", "identity_b", "instruction_match", "rd_match", 1),
        HwCombOp.binary("and", "identity_c", "rs1_match", "rs2_match", 1),
        HwCombOp.binary("and", "identity_d", "identity_a", "identity_b", 1),
        HwCombOp.binary("and", "identity_e", "identity_c", "length_match", 1),
        HwCombOp.binary("and", "identity_ok", "identity_d", "identity_e", 1),
        HwCombOp.binary("and", "identity_final", "identity_ok", "illegal_clear", 1),
        HwCombOp.binary("ne", "rd_nonzero", "rd_reg", "zero5_owner", 5)]: comb.push(op)
    val compares = [HwCompareOp.equal("count_is_width", "count_reg", "count_width_owner", countw)]
    val registers = contract.registers()
    var capture_assignments = [HwSeqAssignment(destination: "busy_reg", value: HwSeqValue.copy("dispatch_valid", 1)),
        HwSeqAssignment(destination: "count_reg", value: HwSeqValue.zero(countw)),
        HwSeqAssignment(destination: "remainder_reg", value: HwSeqValue.zero(remw)),
        HwSeqAssignment(destination: "divisor_reg", value: HwSeqValue.copy("rhs_magnitude_remainder", remw)),
        HwSeqAssignment(destination: "dividend_reg", value: HwSeqValue.copy("lhs_magnitude", w)),
        HwSeqAssignment(destination: "original_dividend_reg", value: HwSeqValue.copy("lhs_operand", w)),
        HwSeqAssignment(destination: "quotient_reg", value: HwSeqValue.zero(w)),
        HwSeqAssignment(destination: "result_negate_reg", value: HwSeqValue.copy("quotient_negate", 1)),
        HwSeqAssignment(destination: "remainder_negate_reg", value: HwSeqValue.copy("remainder_negate", 1)),
        HwSeqAssignment(destination: "special_reg", value: HwSeqValue.copy("special_value", 2)),
        HwSeqAssignment(destination: "event_id_reg", value: HwSeqValue.copy("dispatch_event_id", 64)),
        HwSeqAssignment(destination: "decode_event_id_reg", value: HwSeqValue.copy("decode_event_id", 64)),
        HwSeqAssignment(destination: "rd_reg", value: HwSeqValue.copy("dispatch_rd", 5))]
    for assignment in riscv_scalar_muldiv_metadata_capture(x): capture_assignments.push(assignment)
    val plan = HwSequentialPlan(owner_id: HwNodeId.child(name, "sequential"), registers: registers,
        rules: [HwSeqRule(name: "consume", guards: [HwSeqGuard.high("completion_ready"), HwSeqGuard.high("result_valid_reg")],
                assignments: [HwSeqAssignment(destination: "result_valid_reg", value: HwSeqValue.zero(1)),
                    HwSeqAssignment(destination: "result_reg", value: HwSeqValue.zero(x))]),
            HwSeqRule(name: "finalize", guards: [HwSeqGuard.high("busy_reg"), HwSeqGuard.high("finalize_ready")],
                assignments: [HwSeqAssignment(destination: "busy_reg", value: HwSeqValue.zero(1)),
                    HwSeqAssignment(destination: "result_valid_reg", value: HwSeqValue.copy("busy_reg", 1)),
                    HwSeqAssignment(destination: "result_reg", value: HwSeqValue.copy("architectural_result", x))]),
            HwSeqRule(name: "iterate", guards: [HwSeqGuard.high("busy_reg"), HwSeqGuard.low("finalize_ready")],
                assignments: [HwSeqAssignment(destination: "remainder_reg", value: HwSeqValue.copy("remainder_next", remw)),
                    HwSeqAssignment(destination: "quotient_reg", value: HwSeqValue.copy("quotient_next", w)),
                    HwSeqAssignment(destination: "dividend_reg", value: HwSeqValue.copy("dividend_next", w)),
                    HwSeqAssignment(destination: "count_reg", value: HwSeqValue.increment("count_reg", countw))]),
            HwSeqRule(name: "identity_fault", guards: [HwSeqGuard.high("dispatch_valid"), HwSeqGuard.low("busy_reg"),
                    HwSeqGuard.low("result_valid_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.low("identity_final")],
                assignments: [HwSeqAssignment(destination: "fault_reg", value: HwSeqValue.copy("dispatch_valid", 1))]),
            HwSeqRule(name: "capture", guards: [HwSeqGuard.high("dispatch_valid"), HwSeqGuard.low("busy_reg"),
                    HwSeqGuard.low("result_valid_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.high("identity_final")],
                assignments: capture_assignments)],
        outputs: riscv_scalar_muldiv_completion_outputs(x), decoder_pins: [])
    val module = HwSequentialModuleDef(node_id: HwNodeId.module_root(name), entity_name: name, config: config,
        origins: [HwOrigin(node_id: HwNodeId.child(name, "iterative_divider"),
            source_name: "riscv.scalar.muldiv.iterative-divider/v1|projection=" + projection.structural_sha256())],
        ports: divider_ports(x), datapath_signals: signals, datapath_constants: [],
        datapath_bit_vector_constants: constants, datapath_comb_ops: comb,
        datapath_compare_ops: compares, datapath_select_ops: add_select(dispatch.select_ops, divide.select_ops),
        datapath_bit_extract_ops: add_extract(dispatch.bit_extract_ops, divide.bit_extract_ops),
        datapath_fixed_slice_ops: divide.fixed_slice_ops, plan: plan, child_entity: "", child_graph_sha256: "")
    val diagnostic = module.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
