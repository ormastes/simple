# Typed sequential-HWIR primitives for bounded Gen2 products.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwBitExtractOp, HwCombOp, HwCompareOp,
    HwConstant, HwFixedSliceOp, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal,
    hwir_hash_fields, hwir_vhdl_identifier}
use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}

pub class HwStateRegister:
    name: text
    bit_width: i32
    clock_domain: text
    reset_value: i64

    me is_valid() -> bool:
        self.name != "" and self.bit_width > 0 and self.clock_domain == "default" and self.reset_value >= 0

pub class HwSeqGuard:
    kind: text
    lhs: text
    rhs: text

    static fn high(signal: text) -> HwSeqGuard:
        HwSeqGuard(kind: "high", lhs: signal, rhs: "")
    static fn low(signal: text) -> HwSeqGuard:
        HwSeqGuard(kind: "low", lhs: signal, rhs: "")
    static fn equal(lhs: text, rhs: text) -> HwSeqGuard:
        HwSeqGuard(kind: "equal", lhs: lhs, rhs: rhs)
    static fn all_ones(signal: text) -> HwSeqGuard:
        HwSeqGuard(kind: "all_ones", lhs: signal, rhs: "")

pub class HwSeqValue:
    kind: text
    value: text
    bit_width: i32

    static fn zero(bit_width: i32) -> HwSeqValue:
        HwSeqValue(kind: "zero", value: "", bit_width: bit_width)
    static fn copy(signal: text, bit_width: i32) -> HwSeqValue:
        HwSeqValue(kind: "copy", value: signal, bit_width: bit_width)
    static fn invert(signal: text) -> HwSeqValue:
        HwSeqValue(kind: "invert", value: signal, bit_width: 1)
    static fn increment(signal: text, bit_width: i32) -> HwSeqValue:
        HwSeqValue(kind: "increment", value: signal, bit_width: bit_width)

pub class HwSeqAssignment:
    destination: text
    value: HwSeqValue

pub class HwSeqRule:
    name: text
    guards: [HwSeqGuard]
    assignments: [HwSeqAssignment]

pub class HwSeqOutputBinding:
    result: text
    kind: text
    source: text
    bit_width: i32
    guards: [HwSeqGuard]

    static fn direct(result: text, source: text, bit_width: i32) -> HwSeqOutputBinding:
        HwSeqOutputBinding(result: result, kind: "direct", source: source, bit_width: bit_width, guards: [])
    static fn all(result: text, guards: [HwSeqGuard]) -> HwSeqOutputBinding:
        HwSeqOutputBinding(result: result, kind: "all", source: "", bit_width: 1, guards: guards)
    static fn guarded(result: text, source: text, bit_width: i32, guards: [HwSeqGuard]) -> HwSeqOutputBinding:
        HwSeqOutputBinding(result: result, kind: "guarded", source: source, bit_width: bit_width, guards: guards)

pub class HwSeqInstancePin:
    port_name: text
    signal_name: text
    direction: text
    bit_width: i32

pub class HwSequentialPlan:
    owner_id: HwNodeId
    registers: [HwStateRegister]
    rules: [HwSeqRule]
    outputs: [HwSeqOutputBinding]
    decoder_pins: [HwSeqInstancePin]

    me register_node_id(register: HwStateRegister) -> HwNodeId:
        HwNodeId.child(self.owner_id.value, "register:" + register.name)
    me rule_node_id(rule: HwSeqRule) -> HwNodeId:
        HwNodeId.child(self.owner_id.value, "rule:" + rule.name)
    me output_node_id(output: HwSeqOutputBinding) -> HwNodeId:
        HwNodeId.child(self.owner_id.value, "output:" + output.result)
    me decoder_pin_node_id(pin: HwSeqInstancePin) -> HwNodeId:
        HwNodeId.child(self.owner_id.value, "decoder_pin:" + pin.port_name)

    me named_width(ports: [HwPort], name: text) -> i32:
        for port in ports:
            if port.name == name: return port.bit_width
        for register in self.registers:
            if register.name == name: return register.bit_width
        for pin in self.decoder_pins:
            if pin.direction == "out" and pin.signal_name == name: return pin.bit_width
        for output in self.outputs:
            if output.result == name: return output.bit_width
        -1

    me port_direction(ports: [HwPort], name: text) -> text:
        for port in ports:
            if port.name == name: return port.direction
        ""

    me readable_width(ports: [HwPort], name: text) -> i32:
        val direction = self.port_direction(ports, name)
        if direction == "in": return self.named_width(ports, name)
        for register in self.registers:
            if register.name == name: return register.bit_width
        for pin in self.decoder_pins:
            if pin.direction == "out" and pin.signal_name == name: return pin.bit_width
        # An "all"-kind output binding is a fully combinational one-bit
        # conjunction driven inside this plan, so later rules may read it
        # (VHDL-2008 out-port readback) as a typed one-bit value.
        for output in self.outputs:
            if output.kind == "all" and output.result == name: return 1
        -1

    me guards_diagnostic(ports: [HwPort], guards: [HwSeqGuard]) -> text:
        if guards.len() == 0:
            return "HWIR-E-SEQUENTIAL-GUARD: sequential conditions must be explicit and nonempty"
        for guard in guards:
            if (guard.kind != "high" and guard.kind != "low" and guard.kind != "equal" and guard.kind != "all_ones") or
                not hwir_vhdl_identifier(guard.lhs) or (guard.kind == "equal" and not hwir_vhdl_identifier(guard.rhs)):
                return "HWIR-E-SEQUENTIAL-GUARD: sequential guards must use typed high, low, equality, or all-ones predicates"
            if guard.kind != "equal" and guard.rhs != "":
                return "HWIR-E-SEQUENTIAL-GUARD: sequential guards must use typed high, low, equality, or all-ones predicates"
            if self.readable_width(ports, guard.lhs) < 1 or
                (guard.kind == "equal" and self.readable_width(ports, guard.rhs) < 1):
                return "HWIR-E-SEQUENTIAL-GUARD: sequential guard references must resolve to readable typed values"
            if (guard.kind == "high" or guard.kind == "low") and self.readable_width(ports, guard.lhs) != 1:
                return "HWIR-E-SEQUENTIAL-GUARD: high and low guards require one-bit typed values"
            if guard.kind == "all_ones" and self.readable_width(ports, guard.lhs) < 2:
                return "HWIR-E-SEQUENTIAL-GUARD: all-ones guards require multi-bit typed values"
            if guard.kind == "equal" and self.readable_width(ports, guard.lhs) != self.readable_width(ports, guard.rhs):
                return "HWIR-E-SEQUENTIAL-GUARD: equality guards require equal-width typed values"
        ""

    me diagnostic() -> text:
        if not self.owner_id.is_valid(): return "HWIR-E-SEQUENTIAL-ID: sequential plan requires a stable owner node ID"
        if self.registers.len() == 0 or self.rules.len() == 0 or self.outputs.len() == 0:
            return "HWIR-E-SEQUENTIAL-PLAN: sequential plan requires registers, ordered rules, and outputs"
        # Keep the authored spelling for VHDL and provenance, but compare
        # identifiers as VHDL does.  Without folded keys, two records such as
        # `valid_reg` and `VALID_REG` would silently describe one register.
        var registers: [text] = []
        for register in self.registers:
            val comparison_name = register.name.lower()
            if not register.is_valid() or not hwir_vhdl_identifier(register.name) or registers.contains(comparison_name):
                return "HWIR-E-SEQUENTIAL-REGISTER: sequential registers must be unique and valid"
            if register.bit_width < 63 and register.reset_value > ((1 << register.bit_width) - 1):
                return "HWIR-E-SEQUENTIAL-RESET: sequential reset values must fit their register width"
            registers.push(comparison_name)
        var rules: [text] = []
        for rule in self.rules:
            val comparison_name = rule.name.lower()
            if not hwir_vhdl_identifier(rule.name) or rules.contains(comparison_name) or rule.guards.len() == 0 or rule.assignments.len() == 0:
                return "HWIR-E-SEQUENTIAL-RULE: sequential rules require unique names, guards, and assignments"
            rules.push(comparison_name)
            var assigned: [text] = []
            for assignment in rule.assignments:
                val destination_key = assignment.destination.lower()
                if not registers.contains(destination_key) or assigned.contains(destination_key) or assignment.value.bit_width < 1:
                    return "HWIR-E-SEQUENTIAL-ASSIGNMENT: one sequential rule may assign each typed register once"
                if assignment.value.kind != "zero" and assignment.value.kind != "copy" and
                    assignment.value.kind != "invert" and assignment.value.kind != "increment":
                    return "HWIR-E-SEQUENTIAL-ASSIGNMENT: sequential assignments use only zero, copy, invert, or increment values"
                if assignment.value.kind == "invert" and assignment.value.bit_width != 1:
                    return "HWIR-E-SEQUENTIAL-ASSIGNMENT: inversion is defined only for one-bit state"
                assigned.push(destination_key)
        ""

    me diagnostic_for_ports(ports: [HwPort]) -> text:
        val basic = self.diagnostic()
        if basic != "": return basic
        var decoder_ports: [text] = []
        var decoder_signals: [text] = []
        for pin in self.decoder_pins:
            val port_key = pin.port_name.lower()
            val signal_key = pin.signal_name.lower()
            if not hwir_vhdl_identifier(pin.port_name) or not hwir_vhdl_identifier(pin.signal_name) or pin.bit_width < 1 or
                (pin.direction != "in" and pin.direction != "out") or decoder_ports.contains(port_key) or decoder_signals.contains(signal_key):
                return "HWIR-E-SEQUENTIAL-INSTANCE: decoder pins must be typed inputs or outputs"
            if pin.direction == "in" and self.readable_width(ports, pin.signal_name) != pin.bit_width:
                return "HWIR-E-SEQUENTIAL-INSTANCE: decoder inputs must bind width-matched typed values"
            decoder_ports.push(port_key)
            decoder_signals.push(signal_key)
        for rule in self.rules:
            val guard_error = self.guards_diagnostic(ports, rule.guards)
            if guard_error != "": return guard_error
            for assignment in rule.assignments:
                if assignment.value.kind != "zero" and self.readable_width(ports, assignment.value.value) != assignment.value.bit_width:
                    return "HWIR-E-SEQUENTIAL-ASSIGNMENT: sequential assignment sources must preserve width"
                if self.named_width(ports, assignment.destination) != assignment.value.bit_width:
                    return "HWIR-E-SEQUENTIAL-ASSIGNMENT: sequential assignment value width must match its register"
        var output_names: [text] = []
        for output in self.outputs:
            val result_key = output.result.lower()
            if not hwir_vhdl_identifier(output.result) or output_names.contains(result_key) or self.port_direction(ports, output.result) != "out" or
                self.named_width(ports, output.result) != output.bit_width:
                return "HWIR-E-SEQUENTIAL-OUTPUT: sequential bindings must drive matching public outputs"
            if output.kind != "direct" and output.kind != "all" and output.kind != "guarded":
                return "HWIR-E-SEQUENTIAL-OUTPUT: sequential bindings must use direct, all, or guarded forms"
            if output.kind == "all" and (output.bit_width != 1 or output.source != ""):
                return "HWIR-E-SEQUENTIAL-OUTPUT: all bindings require a one-bit output without a data source"
            if output.kind != "all" and self.readable_width(ports, output.source) != output.bit_width:
                return "HWIR-E-SEQUENTIAL-OUTPUT: sequential binding sources must preserve width"
            if output.kind == "direct" and output.guards.len() != 0:
                return "HWIR-E-SEQUENTIAL-OUTPUT: direct bindings may not discard guard semantics"
            if output.kind != "direct":
                val guard_error = self.guards_diagnostic(ports, output.guards)
                if guard_error != "": return guard_error
            output_names.push(result_key)
        for port in ports:
            if port.direction == "out" and not output_names.contains(port.name.lower()):
                return "HWIR-E-SEQUENTIAL-OUTPUT: every public output requires exactly one typed binding"
        ""

    me canonical_text() -> text:
        var text = hwir_hash_fields(["simple-hwir-sequential/v2", "owner", self.owner_id.value])
        for register in self.registers:
            text = text + hwir_hash_fields(["register", register.name, register.bit_width.to_text(), register.clock_domain, register.reset_value.to_text()])
        for rule in self.rules:
            text = text + hwir_hash_fields(["rule", rule.name])
            for guard in rule.guards:
                text = text + hwir_hash_fields(["guard", guard.kind, guard.lhs, guard.rhs])
            for assignment in rule.assignments:
                text = text + hwir_hash_fields(["assignment", assignment.destination, assignment.value.kind, assignment.value.value, assignment.value.bit_width.to_text()])
        for output in self.outputs:
            text = text + hwir_hash_fields(["output", output.result, output.kind, output.source, output.bit_width.to_text()])
            # Output guards are behavior, not display metadata.  Omitting them
            # would let a changed ready/valid/trap visibility condition retain
            # the same product HWIR hash while producing different VHDL.
            for guard in output.guards:
                text = text + hwir_hash_fields(["output_guard", guard.kind, guard.lhs, guard.rhs])
        for pin in self.decoder_pins:
            text = text + hwir_hash_fields(["pin", pin.port_name, pin.signal_name, pin.direction, pin.bit_width.to_text()])
        text

    me structural_sha256() -> text:
        sha256_text(self.canonical_text())

pub class HwSequentialModuleDef:
    """Typed standalone or single-child sequential module boundary.

    An empty child entity is an explicit standalone module and therefore
    requires no decoder pins.  A non-empty child retains the closed typed pin
    contract used by existing stateful products.
    """
    node_id: HwNodeId
    entity_name: text
    config: CoreConfig
    origins: [HwOrigin]
    ports: [HwPort]
    datapath_signals: [HwSignal]
    datapath_constants: [HwConstant]
    datapath_bit_vector_constants: [HwBitVectorConstant]
    datapath_comb_ops: [HwCombOp]
    datapath_compare_ops: [HwCompareOp]
    datapath_select_ops: [HwSelectOp]
    datapath_bit_extract_ops: [HwBitExtractOp]
    datapath_fixed_slice_ops: [HwFixedSliceOp]
    plan: HwSequentialPlan
    child_entity: text
    child_graph_sha256: text

    me datapath_width(name: text) -> i32:
        for port in self.ports:
            if port.name == name: return port.bit_width
        for register in self.plan.registers:
            if register.name == name: return register.bit_width
        for pin in self.plan.decoder_pins:
            if pin.direction == "out" and pin.signal_name == name: return pin.bit_width
        for signal in self.datapath_signals:
            if signal.name == name: return signal.bit_width
        for constant in self.datapath_constants:
            if constant.name == name: return constant.bit_width
        for constant in self.datapath_bit_vector_constants:
            if constant.name == name: return constant.bit_width
        -1

    me datapath_signal_width(name: text) -> i32:
        for signal in self.datapath_signals:
            if signal.name == name: return signal.bit_width
        -1

    me datapath_readable_width(name: text) -> i32:
        for port in self.ports:
            if port.name == name and port.direction == "in": return port.bit_width
        for register in self.plan.registers:
            if register.name == name: return register.bit_width
        for pin in self.plan.decoder_pins:
            if pin.direction == "out" and pin.signal_name == name: return pin.bit_width
        for signal in self.datapath_signals:
            if signal.name == name: return signal.bit_width
        for constant in self.datapath_constants:
            if constant.name == name: return constant.bit_width
        for constant in self.datapath_bit_vector_constants:
            if constant.name == name: return constant.bit_width
        -1

    me datapath_diagnostic() -> text:
        var names: [text] = []
        for port in self.ports: names.push(port.name.lower())
        for register in self.plan.registers:
            val folded = register.name.lower()
            if names.contains(folded):
                return "HWIR-E-SEQUENTIAL-DATAPATH-NAMESPACE: ports, registers, child outputs, signals, and constants must be distinct"
            names.push(folded)
        for pin in self.plan.decoder_pins:
            if pin.direction == "out":
                val folded = pin.signal_name.lower()
                if names.contains(folded):
                    return "HWIR-E-SEQUENTIAL-DATAPATH-NAMESPACE: ports, registers, child outputs, signals, and constants must be distinct"
                names.push(folded)
        for signal in self.datapath_signals:
            val folded = signal.name.lower()
            if not hwir_vhdl_identifier(signal.name) or signal.bit_width < 1 or
                signal.type_name != "Bits" or signal.driver_count > 1 or names.contains(folded):
                return "HWIR-E-SEQUENTIAL-DATAPATH-SIGNAL: datapath signals require unique typed combinational values"
            names.push(folded)
        for constant in self.datapath_constants:
            val folded = constant.name.lower()
            if not hwir_vhdl_identifier(constant.name) or constant.bit_width < 1 or names.contains(folded):
                return "HWIR-E-SEQUENTIAL-DATAPATH-CONSTANT: datapath constants require unique typed values"
            if constant.bit_width == 1 and constant.value != 0 and constant.value != 1:
                return "HWIR-E-SEQUENTIAL-DATAPATH-CONSTANT: one-bit constants must be zero or one"
            names.push(folded)
        for constant in self.datapath_bit_vector_constants:
            val folded = constant.name.lower()
            if not hwir_vhdl_identifier(constant.name) or names.contains(folded):
                return "HWIR-E-SEQUENTIAL-DATAPATH-BIT-CONSTANT: bit-vector constants require unique VHDL identifiers"
            val bits_error = constant.bits_diagnostic()
            if bits_error != "": return bits_error
            names.push(folded)
        var drivers: [text] = []
        for op in self.datapath_comb_ops:
            if op.op != "and" and op.op != "or" and op.op != "xor" and op.op != "add" and
                op.op != "sub" and op.op != "shl" and op.op != "shr" and op.op != "sar" and op.op != "eq" and
                op.op != "ne" and op.op != "slt" and op.op != "sge" and op.op != "ult" and
                op.op != "uge" and op.op != "passthrough" and op.op != "zext" and
                op.op != "trunc" and op.op != "sext":
                return "HWIR-E-SEQUENTIAL-DATAPATH-COMB: unsupported combinational operation"
            val result_width = self.datapath_signal_width(op.result)
            val lhs_width = self.datapath_readable_width(op.lhs)
            val rhs_width = if op.rhs == "": -1 else: self.datapath_readable_width(op.rhs)
            val unary = op.op == "passthrough" or op.op == "zext" or op.op == "trunc" or op.op == "sext"
            val predicate = op.op == "eq" or op.op == "ne" or op.op == "slt" or
                op.op == "sge" or op.op == "ult" or op.op == "uge"
            val invalid_resize = (op.op == "zext" or op.op == "sext") and lhs_width >= op.bit_width or
                op.op == "trunc" and lhs_width <= op.bit_width
            if (if predicate: result_width != 1 else: result_width != op.bit_width) or lhs_width < 1 or
                (not unary and (lhs_width != op.bit_width or rhs_width != op.bit_width)) or
                (op.op == "passthrough" and lhs_width != op.bit_width) or invalid_resize:
                return "HWIR-E-SEQUENTIAL-DATAPATH-COMB: combinational operation requires typed readable operands and signal result"
            val driver = op.result.lower()
            if drivers.contains(driver): return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: datapath values require one driver"
            drivers.push(driver)
        for op in self.datapath_compare_ops:
            if self.datapath_signal_width(op.result) != 1 or self.datapath_readable_width(op.lhs) != op.bit_width or
                self.datapath_readable_width(op.rhs) != op.bit_width:
                return "HWIR-E-SEQUENTIAL-DATAPATH-COMPARE: comparison requires typed operands and one-bit signal result"
            val driver = op.result.lower()
            if drivers.contains(driver): return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: datapath values require one driver"
            drivers.push(driver)
        for op in self.datapath_select_ops:
            if self.datapath_signal_width(op.result) != op.bit_width or self.datapath_readable_width(op.condition) != 1 or
                self.datapath_readable_width(op.when_true) != op.bit_width or
                self.datapath_readable_width(op.when_false) != op.bit_width:
                return "HWIR-E-SEQUENTIAL-DATAPATH-SELECT: select requires typed condition, alternatives, and signal result"
            val driver = op.result.lower()
            if drivers.contains(driver): return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: datapath values require one driver"
            drivers.push(driver)
        for op in self.datapath_bit_extract_ops:
            val source_width = self.datapath_readable_width(op.source)
            if self.datapath_signal_width(op.result) != 1 or source_width < 1 or
                op.bit_index < 0 or op.bit_index >= source_width:
                return "HWIR-E-SEQUENTIAL-DATAPATH-BIT-EXTRACT: fixed bit extract requires a readable source, in-range index, and one-bit signal result"
            val driver = op.result.lower()
            if drivers.contains(driver): return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: datapath values require one driver"
            drivers.push(driver)
        for op in self.datapath_fixed_slice_ops:
            val source_width = self.datapath_readable_width(op.source)
            val result_width = op.high_bit - op.low_bit + 1
            if self.datapath_signal_width(op.result) != result_width or source_width < 1 or
                op.low_bit < 0 or op.high_bit <= op.low_bit or op.high_bit >= source_width:
                return "HWIR-E-SEQUENTIAL-DATAPATH-FIXED-SLICE: fixed slice requires a readable source, ordered in-range bounds, and matching signal result"
            val driver = op.result.lower()
            if drivers.contains(driver): return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: datapath values require one driver"
            drivers.push(driver)
        if drivers.len() != self.datapath_signals.len():
            return "HWIR-E-SEQUENTIAL-DATAPATH-DRIVER: every datapath signal requires one driver"
        ""

    me diagnostic() -> text:
        val config_error = self.config.diagnostic()
        if config_error != "": return config_error
        if not self.node_id.is_valid() or not hwir_vhdl_identifier(self.entity_name) or
            self.plan.owner_id.value == self.node_id.value:
            return "HWIR-E-SEQUENTIAL-MODULE-ID: sequential module and plan require distinct stable identities"
        if self.origins.len() == 0:
            return "HWIR-E-SEQUENTIAL-MODULE-ORIGIN: sequential module requires source lineage"
        var port_names: [text] = []
        var has_clk = false
        var has_rst = false
        for port in self.ports:
            val folded = port.name.lower()
            if not hwir_vhdl_identifier(port.name) or
                (port.direction != "in" and port.direction != "out") or port.type_name != "Bits" or
                port.bit_width < 1 or port.clock_domain != "default" or port_names.contains(folded):
                return "HWIR-E-SEQUENTIAL-MODULE-PORT: sequential ports require unique default-domain Bits values"
            if port.name == "clk" and port.direction == "in" and port.bit_width == 1: has_clk = true
            if port.name == "rst" and port.direction == "in" and port.bit_width == 1: has_rst = true
            port_names.push(folded)
        if not has_clk or not has_rst:
            return "HWIR-E-SEQUENTIAL-MODULE-CLOCK: sequential module requires one-bit clk and synchronous active-high rst inputs"
        var origin_ids: [text] = []
        for origin in self.origins:
            if not origin.node_id.is_valid() or origin.source_name == "" or
                origin.node_id.value == self.node_id.value or origin_ids.contains(origin.node_id.value):
                return "HWIR-E-SEQUENTIAL-MODULE-ORIGIN: sequential origins must be distinct and valid"
            origin_ids.push(origin.node_id.value)
        val datapath_error = self.datapath_diagnostic()
        if datapath_error != "": return datapath_error
        var validation_ports = self.ports
        for signal in self.datapath_signals:
            validation_ports.push(HwPort.input(signal.name, "Bits", signal.bit_width))
        for constant in self.datapath_constants:
            validation_ports.push(HwPort.input(constant.name, "Bits", constant.bit_width))
        for constant in self.datapath_bit_vector_constants:
            validation_ports.push(HwPort.input(constant.name, "Bits", constant.bit_width))
        val plan_error = self.plan.diagnostic_for_ports(validation_ports)
        if plan_error != "": return plan_error
        if self.child_entity == "":
            if self.child_graph_sha256 != "" or self.plan.decoder_pins.len() != 0:
                return "HWIR-E-SEQUENTIAL-MODULE-CHILD: standalone modules cannot retain child identity or pins"
        else:
            if not hwir_vhdl_identifier(self.child_entity) or self.child_graph_sha256 == "" or
                self.plan.decoder_pins.len() == 0:
                return "HWIR-E-SEQUENTIAL-MODULE-CHILD: child-bound modules require entity, graph hash, and typed pins"
        ""

    me canonical_text() -> text:
        var fields = ["simple-hwir-sequential-module/v3", self.node_id.value, self.entity_name,
            self.config.xlen.to_text(), self.config.physical_address_bits.to_text(),
            self.config.register_count.to_text(), self.config.profile,
            self.config.isa_profile, self.config.compressed_decode_profile]
        for origin in self.origins:
            fields.push("origin")
            fields.push(origin.node_id.value)
            fields.push(origin.source_name)
        for port in self.ports:
            fields.push("port")
            fields.push(port.name)
            fields.push(port.direction)
            fields.push(port.type_name)
            fields.push(port.bit_width.to_text())
            fields.push(port.clock_domain)
        for signal in self.datapath_signals:
            fields.push(hwir_hash_fields(["datapath_signal", signal.name, signal.type_name,
                signal.bit_width.to_text(), signal.driver_count.to_text(), signal.source_id]))
        for constant in self.datapath_constants:
            fields.push(hwir_hash_fields(["datapath_constant", constant.name,
                constant.bit_width.to_text(), constant.value.to_text()]))
        for constant in self.datapath_bit_vector_constants:
            fields.push(hwir_hash_fields(["datapath_bit_vector_constant", constant.name,
                constant.bit_width.to_text(), constant.canonical_bits]))
        for op in self.datapath_comb_ops:
            fields.push(hwir_hash_fields(["datapath_comb", op.op, op.result, op.lhs,
                op.rhs, op.bit_width.to_text()]))
        for op in self.datapath_compare_ops:
            fields.push(hwir_hash_fields(["datapath_compare", op.result, op.lhs,
                op.rhs, op.bit_width.to_text()]))
        for op in self.datapath_select_ops:
            fields.push(hwir_hash_fields(["datapath_select", op.result, op.condition,
                op.when_true, op.when_false, op.bit_width.to_text()]))
        for op in self.datapath_bit_extract_ops:
            fields.push(hwir_hash_fields(["datapath_bit_extract", op.result, op.source,
                op.bit_index.to_text()]))
        for op in self.datapath_fixed_slice_ops:
            fields.push(hwir_hash_fields(["datapath_fixed_slice", op.result, op.source,
                op.high_bit.to_text(), op.low_bit.to_text()]))
        fields.push("plan")
        fields.push(self.plan.canonical_text())
        fields.push("child")
        fields.push(self.child_entity)
        fields.push(self.child_graph_sha256)
        hwir_hash_fields(fields)

    me structural_sha256() -> text:
        sha256_text(self.canonical_text())
