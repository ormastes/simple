# Sequential one-outstanding owner for the plan-bound runtime LSU projection.
use compiler.mir.hwir.types.{CoreConfig, HwCombOp, HwCompareOp, HwConstant,
    HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard,
    HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef,
    HwSequentialPlan, HwStateRegister}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}

fn completion_rows(x: i32) -> [(text, i32)]:
    [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
        ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x),
        ("rd", 5), ("rd_write", 1), ("rd_value", x), ("memory_address", x),
        ("memory_read_mask", 32), ("memory_write_mask", 32),
        ("memory_read_data", x), ("memory_write_data", x),
        ("execute_trap_valid", 1), ("execute_trap_cause", x),
        ("execute_trap_tval", x), ("memory_trap_valid", 1),
        ("memory_trap_cause", x), ("memory_trap_tval", x),
        ("redirect_valid", 1), ("redirect_target", x),
        ("provider_event_id", 64), ("decode_event_id", 64), ("illegal_valid", 1)]

fn owner_ports(config: CoreConfig, bus: LsuConfig) -> [HwPort]:
    val x = config.xlen; val pa = config.physical_address_bits
    var ports = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("request_valid", "Bits", 1), HwPort.input("request_provider_tag", "Bits", 3),
        HwPort.input("projection_valid", "Bits", 1), HwPort.input("projection_protocol_fault", "Bits", 1),
        HwPort.input("local_fault", "Bits", 1), HwPort.input("local_cause", "Bits", x),
        HwPort.input("local_tval", "Bits", x), HwPort.input("effective_address", "Bits", pa),
        HwPort.input("access_size_bytes", "Bits", 4), HwPort.input("access_signed_load", "Bits", 1),
        HwPort.input("access_rd_index", "Bits", 5), HwPort.input("projected_request_write", "Bits", 1),
        HwPort.input("projected_request_byte_mask", "Bits", bus.byte_mask_bits),
        HwPort.input("projected_request_write_data", "Bits", bus.bus_data_bits),
        HwPort.input("request_privilege", "Bits", 2), HwPort.input("request_original_instruction", "Bits", 32),
        HwPort.input("request_canonical_instruction", "Bits", 32),
        HwPort.input("request_instruction_length_bytes", "Bits", 3),
        HwPort.input("request_pc_before", "Bits", x), HwPort.input("request_pc_after", "Bits", x),
        HwPort.input("request_provider_event_id", "Bits", 64), HwPort.input("request_decode_event_id", "Bits", 64),
        HwPort.input("request_illegal_valid", "Bits", 1),
        HwPort.input("bus_request_ready", "Bits", 1), HwPort.input("bus_response_valid", "Bits", 1),
        HwPort.input("bus_response_id", "Bits", 64), HwPort.input("bus_response_data", "Bits", bus.bus_data_bits),
        HwPort.input("bus_response_fault", "Bits", 1), HwPort.input("bus_response_cause", "Bits", x),
        HwPort.input("bus_response_tval", "Bits", x), HwPort.input("completion_ready", "Bits", 1),
        HwPort.output("request_ready", "Bits", 1), HwPort.output("request_accept", "Bits", 1),
        HwPort.output("bus_request_valid", "Bits", 1),
        HwPort.output("bus_request_id", "Bits", 64), HwPort.output("bus_request_address", "Bits", pa),
        HwPort.output("bus_request_write", "Bits", 1),
        HwPort.output("bus_request_byte_mask", "Bits", bus.byte_mask_bits),
        HwPort.output("bus_request_write_data", "Bits", bus.bus_data_bits),
        HwPort.output("bus_response_ready", "Bits", 1), HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("completion_provider_tag", "Bits", 3),
        HwPort.output("provider_protocol_fault", "Bits", 1)]
    for row in completion_rows(x): ports.push(HwPort.output("completion_" + row[0], "Bits", row[1]))
    ports

fn registers(config: CoreConfig, bus: LsuConfig) -> [HwStateRegister]:
    val x = config.xlen; val pa = config.physical_address_bits
    var result = [HwStateRegister(name: "pending_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "issued_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "full_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "fault_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "next_id_reg", bit_width: 64, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "id_reg", bit_width: 64, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "address_reg", bit_width: pa, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "write_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "mask_reg", bit_width: bus.byte_mask_bits, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "write_data_reg", bit_width: bus.bus_data_bits, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "size_reg", bit_width: 4, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "signed_reg", bit_width: 1, clock_domain: "default", reset_value: 0)]
    for row in completion_rows(x):
        result.push(HwStateRegister(name: "completion_" + row[0] + "_reg", bit_width: row[1], clock_domain: "default", reset_value: 0))
    result

fn clear_completion(x: i32) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]
    for row in completion_rows(x):
        result.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.zero(row[1])))
    result

fn capture_common(x: i32, memory_fault: text) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "completion_privilege_reg", value: HwSeqValue.copy("request_privilege", 2)),
        HwSeqAssignment(destination: "completion_original_instruction_reg", value: HwSeqValue.copy("request_original_instruction", 32)),
        HwSeqAssignment(destination: "completion_canonical_instruction_reg", value: HwSeqValue.copy("request_canonical_instruction", 32)),
        HwSeqAssignment(destination: "completion_instruction_length_bytes_reg", value: HwSeqValue.copy("request_instruction_length_bytes", 3)),
        HwSeqAssignment(destination: "completion_pc_before_reg", value: HwSeqValue.copy("request_pc_before", x)),
        HwSeqAssignment(destination: "completion_pc_after_reg", value: HwSeqValue.copy("request_pc_after", x)),
        HwSeqAssignment(destination: "completion_rd_reg", value: HwSeqValue.copy("access_rd_index", 5)),
        HwSeqAssignment(destination: "completion_rd_write_reg", value: HwSeqValue.copy("completion_rd_write_value", 1)),
        HwSeqAssignment(destination: "completion_rd_value_reg", value: HwSeqValue.copy("completion_rd_value_value", x)),
        HwSeqAssignment(destination: "completion_memory_address_reg", value: HwSeqValue.copy("completion_address_value", x)),
        HwSeqAssignment(destination: "completion_memory_read_mask_reg", value: HwSeqValue.copy("completion_read_mask_value", 32)),
        HwSeqAssignment(destination: "completion_memory_write_mask_reg", value: HwSeqValue.copy("completion_write_mask_value", 32)),
        HwSeqAssignment(destination: "completion_memory_read_data_reg", value: HwSeqValue.copy("completion_rd_value_value", x)),
        HwSeqAssignment(destination: "completion_memory_write_data_reg", value: HwSeqValue.copy("completion_write_data_value", x)),
        HwSeqAssignment(destination: "completion_execute_trap_valid_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "completion_execute_trap_cause_reg", value: HwSeqValue.zero(x)),
        HwSeqAssignment(destination: "completion_execute_trap_tval_reg", value: HwSeqValue.zero(x)),
        HwSeqAssignment(destination: "completion_memory_trap_valid_reg", value: HwSeqValue.copy(memory_fault, 1)),
        HwSeqAssignment(destination: "completion_memory_trap_cause_reg", value: HwSeqValue.copy("completion_cause_value", x)),
        HwSeqAssignment(destination: "completion_memory_trap_tval_reg", value: HwSeqValue.copy("completion_tval_value", x)),
        HwSeqAssignment(destination: "completion_redirect_valid_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "completion_redirect_target_reg", value: HwSeqValue.zero(x)),
        HwSeqAssignment(destination: "completion_provider_event_id_reg", value: HwSeqValue.copy("request_provider_event_id", 64)),
        HwSeqAssignment(destination: "completion_decode_event_id_reg", value: HwSeqValue.copy("request_decode_event_id", 64)),
        HwSeqAssignment(destination: "completion_illegal_valid_reg", value: HwSeqValue.copy("request_illegal_valid", 1))]
    result

fn capture_response(x: i32) -> [HwSeqAssignment]:
    [HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "full_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "completion_rd_write_reg", value: HwSeqValue.copy("completion_rd_write_value", 1)),
        HwSeqAssignment(destination: "completion_rd_value_reg", value: HwSeqValue.copy("completion_rd_value_value", x)),
        HwSeqAssignment(destination: "completion_memory_address_reg", value: HwSeqValue.copy("completion_address_value", x)),
        HwSeqAssignment(destination: "completion_memory_read_mask_reg", value: HwSeqValue.copy("completion_read_mask_value", 32)),
        HwSeqAssignment(destination: "completion_memory_write_mask_reg", value: HwSeqValue.copy("completion_write_mask_value", 32)),
        HwSeqAssignment(destination: "completion_memory_read_data_reg", value: HwSeqValue.copy("safe_load_value", x)),
        HwSeqAssignment(destination: "completion_memory_write_data_reg", value: HwSeqValue.copy("completion_write_data_value", x)),
        HwSeqAssignment(destination: "completion_memory_trap_valid_reg", value: HwSeqValue.copy("bus_response_fault", 1)),
        HwSeqAssignment(destination: "completion_memory_trap_cause_reg", value: HwSeqValue.copy("completion_cause_value", x)),
        HwSeqAssignment(destination: "completion_memory_trap_tval_reg", value: HwSeqValue.copy("completion_tval_value", x))]

fn capture_local(x: i32) -> [HwSeqAssignment]:
    var result = capture_common(x, "local_fault")
    for index in 0..result.len():
        val destination = result[index].destination
        if (destination == "completion_rd_write_reg" or destination == "completion_rd_value_reg" or
            destination == "completion_memory_read_mask_reg" or destination == "completion_memory_write_mask_reg" or
            destination == "completion_memory_read_data_reg" or destination == "completion_memory_write_data_reg"):
            result[index] = HwSeqAssignment(destination: destination,
                value: HwSeqValue.zero(result[index].value.bit_width))
        elif destination == "completion_memory_address_reg":
            result[index] = HwSeqAssignment(destination: destination,
                value: HwSeqValue.copy("local_address_x", x))
        elif destination == "completion_memory_trap_cause_reg":
            result[index] = HwSeqAssignment(destination: destination,
                value: HwSeqValue.copy("local_cause", x))
        elif destination == "completion_memory_trap_tval_reg":
            result[index] = HwSeqAssignment(destination: destination,
                value: HwSeqValue.copy("local_tval", x))
    result

pub fn strict_riscv_scalar_runtime_lsu_owner(module_name: text,
    config: CoreConfig, bus: LsuConfig) -> Result<HwSequentialModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RUNTIME-LSU-OWNER-ID: runtime LSU owner requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val bus_error = bus.diagnostic(); if bus_error != "": return Err(bus_error)
    if bus.bus_data_bits != config.xlen:
        return Err("HWIR-E-RUNTIME-LSU-OWNER-BUS: v1 requires one XLEN-wide LSU beat")
    val x = config.xlen; val pa = config.physical_address_bits
    val regs = registers(config, bus)
    val fault_assignments = [HwSeqAssignment(destination: "fault_reg", value: HwSeqValue.copy("fault_any", 1)),
        HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]
    var local_assignments = capture_local(x)
    local_assignments.push(HwSeqAssignment(destination: "next_id_reg", value: HwSeqValue.increment("next_id_reg", 64)))
    var request_assignments = [HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "id_reg", value: HwSeqValue.copy("next_id_reg", 64)),
        HwSeqAssignment(destination: "next_id_reg", value: HwSeqValue.increment("next_id_reg", 64)),
        HwSeqAssignment(destination: "address_reg", value: HwSeqValue.copy("effective_address", pa)),
        HwSeqAssignment(destination: "write_reg", value: HwSeqValue.copy("projected_request_write", 1)),
        HwSeqAssignment(destination: "mask_reg", value: HwSeqValue.copy("projected_request_byte_mask", bus.byte_mask_bits)),
        HwSeqAssignment(destination: "write_data_reg", value: HwSeqValue.copy("projected_request_write_data", bus.bus_data_bits)),
        HwSeqAssignment(destination: "size_reg", value: HwSeqValue.copy("access_size_bytes", 4)),
        HwSeqAssignment(destination: "signed_reg", value: HwSeqValue.copy("access_signed_load", 1))]
    for row in [("privilege", "request_privilege", 2), ("original_instruction", "request_original_instruction", 32),
            ("canonical_instruction", "request_canonical_instruction", 32),
            ("instruction_length_bytes", "request_instruction_length_bytes", 3),
            ("pc_before", "request_pc_before", x), ("pc_after", "request_pc_after", x),
            ("rd", "access_rd_index", 5), ("provider_event_id", "request_provider_event_id", 64),
            ("decode_event_id", "request_decode_event_id", 64), ("illegal_valid", "request_illegal_valid", 1)]:
        request_assignments.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.copy(row[1], row[2])))
    val response_assignments = capture_response(x)
    val rules = [HwSeqRule(name: "protocol_fault", guards: [HwSeqGuard.high("fault_any"), HwSeqGuard.low("fault_reg")], assignments: fault_assignments),
        HwSeqRule(name: "completion_consume", guards: [HwSeqGuard.high("completion_ready"), HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")], assignments: clear_completion(x)),
        HwSeqRule(name: "response_capture", guards: [HwSeqGuard.high("response_good"), HwSeqGuard.high("issued_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")], assignments: response_assignments),
        HwSeqRule(name: "bus_request_accept", guards: [HwSeqGuard.high("bus_request_ready"), HwSeqGuard.high("pending_reg"), HwSeqGuard.low("issued_reg"), HwSeqGuard.low("fault_reg")], assignments: [HwSeqAssignment(destination: "issued_reg", value: HwSeqValue.copy("one1", 1))]),
        HwSeqRule(name: "local_completion", guards: [HwSeqGuard.high("request_handshake"), HwSeqGuard.high("request_tag_ok"), HwSeqGuard.high("local_fault"), HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.low("id_terminal")], assignments: local_assignments),
        HwSeqRule(name: "request_capture", guards: [HwSeqGuard.high("request_handshake"), HwSeqGuard.high("request_tag_ok"), HwSeqGuard.high("projection_valid"), HwSeqGuard.low("local_fault"), HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.low("id_terminal")], assignments: request_assignments)]
    val active = [HwSeqGuard.high("pending_reg"), HwSeqGuard.low("issued_reg"), HwSeqGuard.low("fault_reg")]
    val full = [HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")]
    var outputs = [HwSeqOutputBinding.all("request_ready", [HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.low("id_terminal")]),
        HwSeqOutputBinding.all("request_accept", [HwSeqGuard.high("request_valid"),
            HwSeqGuard.low("pending_reg"), HwSeqGuard.low("issued_reg"),
            HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"),
            HwSeqGuard.low("id_terminal")]),
        HwSeqOutputBinding.all("bus_request_valid", active), HwSeqOutputBinding.guarded("bus_request_id", "id_reg", 64, active),
        HwSeqOutputBinding.guarded("bus_request_address", "address_reg", pa, active),
        HwSeqOutputBinding.guarded("bus_request_write", "write_reg", 1, active),
        HwSeqOutputBinding.guarded("bus_request_byte_mask", "mask_reg", bus.byte_mask_bits, active),
        HwSeqOutputBinding.guarded("bus_request_write_data", "write_data_reg", bus.bus_data_bits, active),
        HwSeqOutputBinding.all("bus_response_ready", [HwSeqGuard.high("issued_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")]),
        HwSeqOutputBinding.all("completion_valid", full),
        HwSeqOutputBinding.guarded("completion_provider_tag", "tag_lsu", 3, full),
        HwSeqOutputBinding.direct("provider_protocol_fault", "fault_reg", 1)]
    for row in completion_rows(x): outputs.push(HwSeqOutputBinding.guarded("completion_" + row[0], "completion_" + row[0] + "_reg", row[1], full))
    val signals = [HwSignal.comb("request_handshake", "Bits", 1), HwSignal.comb("not_pending", "Bits", 1),
        HwSignal.comb("not_issued", "Bits", 1), HwSignal.comb("not_full", "Bits", 1),
        HwSignal.comb("not_fault", "Bits", 1), HwSignal.comb("not_terminal", "Bits", 1),
        HwSignal.comb("ready01", "Bits", 1), HwSignal.comb("ready23", "Bits", 1),
        HwSignal.comb("ready_pre", "Bits", 1), HwSignal.comb("ready_value", "Bits", 1),
        HwSignal.comb("request_tag_ok", "Bits", 1), HwSignal.comb("request_tag_bad", "Bits", 1),
        HwSignal.comb("request_bad_tag", "Bits", 1), HwSignal.comb("id_terminal", "Bits", 1),
        HwSignal.comb("id_exhaustion_attempt", "Bits", 1), HwSignal.comb("invalid_size", "Bits", 1),
        HwSignal.comb("invalid_size_attempt", "Bits", 1), HwSignal.comb("size_is_8", "Bits", 1),
        HwSignal.comb("request_size_is_1", "Bits", 1), HwSignal.comb("request_size_is_2", "Bits", 1),
        HwSignal.comb("request_size_is_4", "Bits", 1), HwSignal.comb("request_size_is_8", "Bits", 1),
        HwSignal.comb("request_size_valid_12", "Bits", 1), HwSignal.comb("request_size_valid_48", "Bits", 1),
        HwSignal.comb("request_size_valid", "Bits", 1), HwSignal.comb("request_unprojected", "Bits", 1),
        HwSignal.comb("request_not_local_fault", "Bits", 1), HwSignal.comb("unprojected_no_fault", "Bits", 1),
        HwSignal.comb("accepted_unprojected", "Bits", 1),
        HwSignal.comb("size_valid_12", "Bits", 1), HwSignal.comb("size_valid_48", "Bits", 1),
        HwSignal.comb("size_valid", "Bits", 1),
        HwSignal.comb("response_id_match", "Bits", 1), HwSignal.comb("response_expected", "Bits", 1),
        HwSignal.comb("response_good", "Bits", 1), HwSignal.comb("response_not_expected", "Bits", 1),
        HwSignal.comb("response_bad", "Bits", 1), HwSignal.comb("fault_left", "Bits", 1),
        HwSignal.comb("fault_mid", "Bits", 1), HwSignal.comb("fault_pre", "Bits", 1),
        HwSignal.comb("fault_size", "Bits", 1),
        HwSignal.comb("fault_any", "Bits", 1), HwSignal.comb("completion_address_value", "Bits", x),
        HwSignal.comb("completion_read_mask_value", "Bits", 32), HwSignal.comb("completion_write_mask_value", "Bits", 32),
        HwSignal.comb("completion_write_data_value", "Bits", x), HwSignal.comb("completion_rd_write_value", "Bits", 1),
        HwSignal.comb("completion_rd_value_value", "Bits", x), HwSignal.comb("completion_cause_value", "Bits", x),
        HwSignal.comb("completion_tval_value", "Bits", x), HwSignal.comb("offset_pa", "Bits", pa),
        HwSignal.comb("offset_x", "Bits", x), HwSignal.comb("shift_amount", "Bits", x),
        HwSignal.comb("shifted_response", "Bits", x), HwSignal.comb("load8", "Bits", 8),
        HwSignal.comb("load16", "Bits", 16), HwSignal.comb("load32", "Bits", 32),
        HwSignal.comb("load8_z", "Bits", x), HwSignal.comb("load8_s", "Bits", x),
        HwSignal.comb("load16_z", "Bits", x), HwSignal.comb("load16_s", "Bits", x),
        HwSignal.comb("load32_z", "Bits", x), HwSignal.comb("load32_s", "Bits", x),
        HwSignal.comb("size_is_1", "Bits", 1), HwSignal.comb("size_is_2", "Bits", 1),
        HwSignal.comb("size_is_4", "Bits", 1), HwSignal.comb("load8_value", "Bits", x),
        HwSignal.comb("load16_value", "Bits", x), HwSignal.comb("load32_value", "Bits", x),
        HwSignal.comb("load16_or_wider", "Bits", x), HwSignal.comb("load32_or_64", "Bits", x),
        HwSignal.comb("normalized_load", "Bits", x), HwSignal.comb("local_address_x", "Bits", x),
        HwSignal.comb("rd_zero", "Bits", 1), HwSignal.comb("rd_nonzero", "Bits", 1),
        HwSignal.comb("response_no_fault", "Bits", 1),
        HwSignal.comb("load_effect", "Bits", 1), HwSignal.comb("load_rd_pre", "Bits", 1),
        HwSignal.comb("safe_load_effect", "Bits", 1), HwSignal.comb("safe_write_effect", "Bits", 1),
        HwSignal.comb("safe_load_value", "Bits", x),
        HwSignal.comb("mask4_or_8", "Bits", 32), HwSignal.comb("mask2_or_wider", "Bits", 32),
        HwSignal.comb("normalized_mask", "Bits", 32), HwSignal.comb("normalized_write_data", "Bits", x)]
    val constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1),
        HwConstant.bits("tag_lsu", 3, 1), HwConstant.bits("all_ids", 64, -1),
        HwConstant.bits("zero5", 5, 0), HwConstant.bits("zero32", 32, 0),
        HwConstant.bits("zero_xlen", x, 0), HwConstant.bits("offset_mask", pa, bus.byte_mask_bits - 1),
        HwConstant.bits("three_xlen", x, 3), HwConstant.bits("size1", 4, 1),
        HwConstant.bits("size2", 4, 2), HwConstant.bits("size4", 4, 4),
        HwConstant.bits("size8", 4, 8), HwConstant.bits("mask1", 32, 1),
        HwConstant.bits("mask2", 32, 3), HwConstant.bits("mask4", 32, 15),
        HwConstant.bits("mask8", 32, 255)]
    val ops = [HwCombOp.binary("xor", "not_pending", "pending_reg", "one1", 1),
        HwCombOp.binary("xor", "not_issued", "issued_reg", "one1", 1),
        HwCombOp.binary("xor", "not_full", "full_reg", "one1", 1),
        HwCombOp.binary("xor", "not_fault", "fault_reg", "one1", 1),
        HwCombOp.binary("xor", "not_terminal", "id_terminal", "one1", 1),
        HwCombOp.binary("and", "ready01", "not_pending", "not_issued", 1),
        HwCombOp.binary("and", "ready23", "not_full", "not_fault", 1),
        HwCombOp.binary("and", "ready_pre", "ready01", "ready23", 1),
        HwCombOp.binary("and", "ready_value", "ready_pre", "not_terminal", 1),
        HwCombOp.binary("and", "request_handshake", "request_valid", "ready_value", 1),
        HwCombOp.binary("xor", "request_tag_bad", "request_tag_ok", "one1", 1),
        HwCombOp.binary("and", "request_bad_tag", "request_valid", "request_tag_bad", 1),
        HwCombOp.binary("and", "id_exhaustion_attempt", "request_valid", "id_terminal", 1),
        HwCombOp.binary("and", "invalid_size_attempt", "request_handshake", "invalid_size", 1),
        HwCombOp.binary("xor", "request_unprojected", "projection_valid", "one1", 1),
        HwCombOp.binary("xor", "request_not_local_fault", "local_fault", "one1", 1),
        HwCombOp.binary("and", "unprojected_no_fault", "request_unprojected", "request_not_local_fault", 1),
        HwCombOp.binary("and", "accepted_unprojected", "request_handshake", "unprojected_no_fault", 1),
        HwCombOp.binary("and", "response_expected", "issued_reg", "response_id_match", 1),
        HwCombOp.binary("and", "response_good", "bus_response_valid", "response_expected", 1),
        HwCombOp.binary("xor", "response_not_expected", "response_expected", "one1", 1),
        HwCombOp.binary("and", "response_bad", "bus_response_valid", "response_not_expected", 1),
        HwCombOp.binary("or", "fault_left", "projection_protocol_fault", "request_bad_tag", 1),
        HwCombOp.binary("or", "fault_mid", "fault_left", "response_bad", 1),
        HwCombOp.binary("or", "fault_pre", "fault_mid", "id_exhaustion_attempt", 1),
        HwCombOp.binary("or", "fault_size", "fault_pre", "invalid_size_attempt", 1),
        HwCombOp.binary("or", "fault_any", "fault_size", "accepted_unprojected", 1),
        HwCombOp.binary("or", "size_valid_12", "size_is_1", "size_is_2", 1),
        HwCombOp.binary("or", "size_valid_48", "size_is_4", "size_is_8", 1),
        HwCombOp.binary("or", "size_valid", "size_valid_12", "size_valid_48", 1),
        HwCombOp.binary("or", "request_size_valid_12", "request_size_is_1", "request_size_is_2", 1),
        HwCombOp.binary("or", "request_size_valid_48", "request_size_is_4",
            if x == 64: "request_size_is_8" else: "zero1", 1),
        HwCombOp.binary("or", "request_size_valid", "request_size_valid_12", "request_size_valid_48", 1),
        HwCombOp.unary("zext", "local_address_x", "effective_address", x),
        HwCombOp.binary("and", "offset_pa", "address_reg", "offset_mask", pa),
        HwCombOp.unary("zext", "offset_x", "offset_pa", x),
        HwCombOp.binary("shl", "shift_amount", "offset_x", "three_xlen", x),
        HwCombOp.binary("shr", "shifted_response", "bus_response_data", "shift_amount", x),
        HwCombOp.binary("shr", "normalized_write_data", "write_data_reg", "shift_amount", x),
        HwCombOp.unary("trunc", "load8", "shifted_response", 8),
        HwCombOp.unary("trunc", "load16", "shifted_response", 16),
        HwCombOp.unary("trunc", "load32", "shifted_response", 32),
        HwCombOp.unary("zext", "load8_z", "load8", x), HwCombOp.unary("sext", "load8_s", "load8", x),
        HwCombOp.unary("zext", "load16_z", "load16", x), HwCombOp.unary("sext", "load16_s", "load16", x),
        HwCombOp.unary("zext", "load32_z", "load32", x), HwCombOp.unary("sext", "load32_s", "load32", x),
        HwCombOp.unary("zext", "completion_address_value", "address_reg", x),
        HwCombOp.binary("and", "safe_load_effect", "load_effect", "response_no_fault", 1),
        HwCombOp.binary("and", "safe_write_effect", "write_reg", "response_no_fault", 1)]
    val compares = [HwCompareOp.equal("request_tag_ok", "request_provider_tag", "tag_lsu", 3),
        HwCompareOp.equal("id_terminal", "next_id_reg", "all_ids", 64),
        HwCompareOp.equal("response_id_match", "bus_response_id", "id_reg", 64),
        HwCompareOp.equal("rd_zero", "completion_rd_reg", "zero5", 5),
        HwCompareOp.equal("size_is_1", "size_reg", "size1", 4),
        HwCompareOp.equal("size_is_2", "size_reg", "size2", 4),
        HwCompareOp.equal("size_is_4", "size_reg", "size4", 4),
        HwCompareOp.equal("size_is_8", "size_reg", "size8", 4),
        HwCompareOp.equal("request_size_is_1", "access_size_bytes", "size1", 4),
        HwCompareOp.equal("request_size_is_2", "access_size_bytes", "size2", 4),
        HwCompareOp.equal("request_size_is_4", "access_size_bytes", "size4", 4),
        HwCompareOp.equal("request_size_is_8", "access_size_bytes", "size8", 4),
        HwCompareOp.equal("invalid_size", "request_size_valid", "zero1", 1)]
    val selects = [HwSelectOp.mux("rd_nonzero", "rd_zero", "zero1", "one1", 1),
        HwSelectOp.mux("load_effect", "write_reg", "zero1", "one1", 1),
        HwSelectOp.mux("response_no_fault", "bus_response_fault", "zero1", "one1", 1),
        HwSelectOp.mux("load_rd_pre", "rd_nonzero", "load_effect", "zero1", 1),
        HwSelectOp.mux("completion_rd_write_value", "response_no_fault", "load_rd_pre", "zero1", 1),
        HwSelectOp.mux("load8_value", "signed_reg", "load8_s", "load8_z", x),
        HwSelectOp.mux("load16_value", "signed_reg", "load16_s", "load16_z", x),
        HwSelectOp.mux("load32_value", "signed_reg", "load32_s", "load32_z", x),
        HwSelectOp.mux("load32_or_64", "size_is_4", "load32_value", "shifted_response", x),
        HwSelectOp.mux("load16_or_wider", "size_is_2", "load16_value", "load32_or_64", x),
        HwSelectOp.mux("normalized_load", "size_is_1", "load8_value", "load16_or_wider", x),
        HwSelectOp.mux("mask4_or_8", "size_is_4", "mask4", "mask8", 32),
        HwSelectOp.mux("mask2_or_wider", "size_is_2", "mask2", "mask4_or_8", 32),
        HwSelectOp.mux("normalized_mask", "size_is_1", "mask1", "mask2_or_wider", 32),
        HwSelectOp.mux("completion_read_mask_value", "safe_load_effect", "normalized_mask", "zero32", 32),
        HwSelectOp.mux("completion_write_mask_value", "safe_write_effect", "normalized_mask", "zero32", 32),
        HwSelectOp.mux("completion_write_data_value", "safe_write_effect", "normalized_write_data", "zero_xlen", x),
        HwSelectOp.mux("safe_load_value", "safe_load_effect", "normalized_load", "zero_xlen", x),
        HwSelectOp.mux("completion_rd_value_value", "completion_rd_write_value", "safe_load_value", "zero_xlen", x),
        HwSelectOp.mux("completion_cause_value", "bus_response_fault", "bus_response_cause", "local_cause", x),
        HwSelectOp.mux("completion_tval_value", "bus_response_fault", "bus_response_tval", "local_tval", x)]
    val plan = HwSequentialPlan(owner_id: HwNodeId.module_root(module_name), registers: regs,
        rules: rules, outputs: outputs, decoder_pins: [])
    val module = HwSequentialModuleDef(node_id: HwNodeId.module_root(module_name), entity_name: module_name,
        config: config, origins: [HwOrigin(node_id: HwNodeId.child(module_name, "runtime-owner"),
            source_name: "riscv.scalar.runtime.lsu.sequential-owner")], ports: owner_ports(config, bus),
        datapath_signals: signals, datapath_constants: constants, datapath_bit_vector_constants: [],
        datapath_comb_ops: ops, datapath_compare_ops: compares, datapath_select_ops: selects,
        datapath_bit_extract_ops: [], datapath_fixed_slice_ops: [], plan: plan,
        child_entity: "", child_graph_sha256: "")
    val error = module.diagnostic(); if error != "": return Err(error)
    Ok(module)
