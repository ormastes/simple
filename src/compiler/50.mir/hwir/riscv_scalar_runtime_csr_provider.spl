# Flat, one-entry dynamic Zicsr owner.  The projection graph is copied into this
# sequential definition; no child entity or deferred CSR lookup is permitted.

use compiler.mir.hwir.types.{CoreConfig, HwCombOp, HwConstant, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard, HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef, HwSequentialPlan, HwStateRegister}
use compiler.mir.hwir.riscv_scalar_runtime_csr_projection.{strict_riscv_scalar_runtime_csr_projection}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan}

fn csr_completion_rows(x: i32) -> [(text, i32)]:
    [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
        ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x),
        ("rd", 5), ("rd_write", 1), ("rd_value", x), ("memory_address", x),
        ("memory_read_mask", 32), ("memory_write_mask", 32), ("memory_read_data", x),
        ("memory_write_data", x), ("execute_trap_valid", 1), ("execute_trap_cause", x),
        ("execute_trap_tval", x), ("memory_trap_valid", 1), ("memory_trap_cause", x),
        ("memory_trap_tval", x), ("redirect_valid", 1), ("redirect_target", x),
        ("provider_event_id", 64), ("decode_event_id", 64), ("illegal_valid", 1)]

fn csr_registers(x: i32) -> [HwStateRegister]:
    var result = [HwStateRegister(name: "full_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "fault_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "commit_intent_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "commit_address_reg", bit_width: 12, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "commit_value_reg", bit_width: x, clock_domain: "default", reset_value: 0)]
    for row in csr_completion_rows(x):
        result.push(HwStateRegister(name: "completion_" + row[0] + "_reg", bit_width: row[1], clock_domain: "default", reset_value: 0))
    result

fn csr_clear_completion(x: i32) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "commit_intent_reg", value: HwSeqValue.zero(1)),
        HwSeqAssignment(destination: "commit_address_reg", value: HwSeqValue.zero(12)),
        HwSeqAssignment(destination: "commit_value_reg", value: HwSeqValue.zero(x))]
    for row in csr_completion_rows(x):
        result.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.zero(row[1])))
    result

fn csr_capture_completion(x: i32) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "commit_intent_reg", value: HwSeqValue.copy("legal_commit_intent", 1)),
        HwSeqAssignment(destination: "commit_address_reg", value: HwSeqValue.copy("legal_commit_address", 12)),
        HwSeqAssignment(destination: "commit_value_reg", value: HwSeqValue.copy("legal_commit_value", x))]
    for row in csr_completion_rows(x):
        var source = "zero1"
        if row[0] == "privilege" or row[0] == "original_instruction" or row[0] == "canonical_instruction" or row[0] == "instruction_length_bytes" or row[0] == "pc_before" or row[0] == "provider_event_id" or row[0] == "decode_event_id": source = row[0]
        elif row[0] == "pc_after": source = "fallthrough_pc"
        elif row[0] == "rd": source = "canonical_rd"
        elif row[0] == "rd_write": source = "completion_rd_write"
        elif row[0] == "rd_value": source = "completion_rd_value"
        elif row[0] == "execute_trap_valid": source = "execute_trap_valid"
        elif row[0] == "execute_trap_cause": source = "execute_trap_cause"
        elif row[0] == "execute_trap_tval": source = "canonical_instruction_xlen"
        elif row[0] == "illegal_valid": source = "zero1"
        elif row[1] == x: source = "zero_xlen"
        elif row[1] == 32: source = "zero32"
        result.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.copy(source, row[1])))
    result

pub fn strict_riscv_scalar_runtime_csr_provider(module_name: text, config: CoreConfig, plan: RiscvScalarDecoderPlan) -> Result<HwSequentialModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-CSR-ID: CSR provider requires a module name")
    val projection = strict_riscv_scalar_runtime_csr_projection(module_name + "_flat_admission", config, plan)?
    val x = config.xlen
    var ports: [HwPort] = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1), HwPort.input("request_valid", "Bits", 1)]
    for port in projection.ports:
        if port.name != "request_handshake" and port.direction == "in": ports.push(port)
    ports.push(HwPort.input("completion_ready", "Bits", 1))
    ports.push(HwPort.output("request_ready", "Bits", 1)); ports.push(HwPort.output("request_accept", "Bits", 1))
    ports.push(HwPort.output("csr_lookup_valid", "Bits", 1)); ports.push(HwPort.output("csr_lookup_address", "Bits", 12)); ports.push(HwPort.output("csr_lookup_read_enable", "Bits", 1))
    ports.push(HwPort.output("csr_commit_valid", "Bits", 1)); ports.push(HwPort.output("csr_commit_address", "Bits", 12)); ports.push(HwPort.output("csr_commit_value", "Bits", x))
    ports.push(HwPort.output("completion_valid", "Bits", 1)); ports.push(HwPort.output("completion_provider_tag", "Bits", 3)); ports.push(HwPort.output("provider_protocol_fault", "Bits", 1))
    for row in csr_completion_rows(x): ports.push(HwPort.output("completion_" + row[0], "Bits", row[1]))
    var constants = projection.constants
    constants.push(HwConstant.bits("zero32", 32, 0))
    var signals = projection.signals
    for item in [("request_handshake", 1), ("not_full", 1), ("not_fault", 1), ("idle", 1), ("completion_rd_write", 1), ("completion_rd_value", x), ("canonical_instruction_xlen", x)]:
        signals.push(HwSignal.comb(item[0], "Bits", item[1]))
    var ops = projection.comb_ops
    ops.push(HwCombOp.binary("eq", "not_full", "full_reg", "zero1", 1))
    ops.push(HwCombOp.binary("eq", "not_fault", "fault_reg", "zero1", 1))
    ops.push(HwCombOp.binary("and", "idle", "not_full", "not_fault", 1))
    ops.push(HwCombOp.binary("and", "request_handshake", "request_valid", "idle", 1))
    # Architectural writeback is independent of whether the CSR form needed a
    # read for its service/RMW path: a legal CSRRW[I] still writes the old CSR
    # value to any non-x0 rd.  `not_rd_zero` is the projection's explicit
    # canonical-rd compare/xor proof gate and has exactly one producer there.
    ops.push(HwCombOp.binary("and", "completion_rd_write", "access_allowed", "not_rd_zero", 1))
    ops.push(HwCombOp.unary("zext", "canonical_instruction_xlen", "canonical_instruction", x))
    var selects = projection.select_ops
    selects.push(HwSelectOp.mux("completion_rd_value", "access_allowed", "csr_read_value", "zero_xlen", x))
    val rules = [HwSeqRule(name: "protocol_fault", guards: [HwSeqGuard.high("protocol_fault_candidate"), HwSeqGuard.low("fault_reg")], assignments: [HwSeqAssignment(destination: "fault_reg", value: HwSeqValue.copy("one1", 1)), HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]),
        HwSeqRule(name: "completion_consume_and_commit", guards: [HwSeqGuard.high("completion_ready"), HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")], assignments: csr_clear_completion(x)),
        HwSeqRule(name: "request_capture", guards: [HwSeqGuard.high("admitted"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")], assignments: csr_capture_completion(x))]
    val idle_guards = [HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg"), HwSeqGuard.high("tag_ok")]
    val full_guards = [HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")]
    var outputs = [HwSeqOutputBinding.all("request_ready", idle_guards), HwSeqOutputBinding.all("request_accept", [HwSeqGuard.high("request_valid"), HwSeqGuard.high("tag_ok"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")]),
        HwSeqOutputBinding.guarded("csr_lookup_valid", "csr_lookup_valid", 1, idle_guards), HwSeqOutputBinding.guarded("csr_lookup_address", "csr_lookup_address", 12, idle_guards), HwSeqOutputBinding.guarded("csr_lookup_read_enable", "csr_lookup_read_enable", 1, idle_guards),
        HwSeqOutputBinding.all("csr_commit_valid", [HwSeqGuard.high("completion_ready"), HwSeqGuard.high("full_reg"), HwSeqGuard.high("commit_intent_reg"), HwSeqGuard.low("fault_reg")]), HwSeqOutputBinding.guarded("csr_commit_address", "commit_address_reg", 12, full_guards), HwSeqOutputBinding.guarded("csr_commit_value", "commit_value_reg", x, full_guards),
        HwSeqOutputBinding.all("completion_valid", full_guards), HwSeqOutputBinding.guarded("completion_provider_tag", "tag_csr", 3, full_guards), HwSeqOutputBinding.direct("provider_protocol_fault", "fault_reg", 1)]
    for row in csr_completion_rows(x): outputs.push(HwSeqOutputBinding.guarded("completion_" + row[0], "completion_" + row[0] + "_reg", row[1], full_guards))
    val owner = HwSequentialModuleDef(node_id: HwNodeId.module_root(module_name), entity_name: module_name, config: config, origins: projection.origins, ports: ports, datapath_signals: signals, datapath_constants: constants, datapath_bit_vector_constants: [], datapath_comb_ops: ops, datapath_compare_ops: projection.compare_ops, datapath_select_ops: selects, datapath_bit_extract_ops: [], datapath_fixed_slice_ops: [], plan: HwSequentialPlan(owner_id: HwNodeId.child(module_name, "sequential"), registers: csr_registers(x), rules: rules, outputs: outputs, decoder_pins: []), child_entity: "", child_graph_sha256: "")
    val diagnostic = owner.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(owner)
