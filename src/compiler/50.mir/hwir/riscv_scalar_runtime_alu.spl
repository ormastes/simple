# One runtime-parameterized scalar integer provider for a concrete ISA product.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp,
    HwSignal}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    RiscvScalarIsaEntry, riscv_scalar_semantic_opcode}

fn runtime_alu_operation(entry: RiscvScalarIsaEntry) -> text:
    if entry.semantic_operation == "add": return "add"
    if entry.semantic_operation == "subtract": return "sub"
    if entry.semantic_operation == "and": return "and"
    if entry.semantic_operation == "or": return "or"
    if entry.semantic_operation == "xor": return "xor"
    if entry.semantic_operation == "set_less_than_signed": return "slt"
    if entry.semantic_operation == "set_less_than_unsigned": return "ult"
    if entry.semantic_operation == "shift_left_logical": return "shl"
    if entry.semantic_operation == "shift_left_logical_immediate": return "shl"
    if entry.semantic_operation == "shift_right_logical": return "shr"
    if entry.semantic_operation == "shift_right_logical_immediate": return "shr"
    if entry.semantic_operation == "shift_right_arithmetic": return "sar"
    if entry.semantic_operation == "shift_right_arithmetic_immediate": return "sar"
    if entry.semantic_operation == "lui": return "lui"
    if entry.semantic_operation == "auipc": return "add"
    ""

fn runtime_alu_is_immediate(entry: RiscvScalarIsaEntry) -> bool:
    ["rv.i.addi", "rv.i.slti", "rv.i.sltiu", "rv.i.xori", "rv.i.ori",
        "rv.i.andi", "rv32.i.slli", "rv32.i.srli", "rv32.i.srai",
        "rv64.i.slli", "rv64.i.srli", "rv64.i.srai", "rv64.i.addiw",
        "rv64.i.slliw", "rv64.i.srliw", "rv64.i.sraiw"].contains(entry.id)

fn runtime_alu_row_width(row_count: i32) -> i32:
    var width = 1
    var capacity = 2
    while capacity <= row_count:
        width = width + 1
        capacity = capacity * 2
    width

fn runtime_alu_ports(xlen: i32, row_width: i32) -> [HwPort]:
    [HwPort.input("uop_valid", "Bits", 1), HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("decoded_row_index", "Bits", row_width),
        HwPort.input("decoded_execution_class", "Bits", 3),
        HwPort.input("decoded_memory_effect", "Bits", 3),
        HwPort.input("decoded_semantic_opcode", "Bits", 6),
        HwPort.input("decoded_declared_operand_width_is_32", "Bits", 1),
        HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("original_instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("instruction_rd_field", "Bits", 5),
        HwPort.input("instruction_rs1_field", "Bits", 5),
        HwPort.input("instruction_rs2_field", "Bits", 5),
        HwPort.input("rs1_value", "Bits", xlen), HwPort.input("rs2_value", "Bits", xlen),
        HwPort.input("pc_before", "Bits", xlen), HwPort.input("fallthrough_pc", "Bits", xlen),
        HwPort.input("privilege", "Bits", 2),
        HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64), HwPort.input("lineage_valid", "Bits", 1),
        HwPort.output("retire_valid", "Bits", 1), HwPort.output("protocol_fault", "Bits", 1),
        HwPort.output("retire_order", "Bits", 64), HwPort.output("retire_xlen", "Bits", 7),
        HwPort.output("retire_privilege", "Bits", 2),
        HwPort.output("retire_original_instruction", "Bits", 32),
        HwPort.output("retire_canonical_instruction", "Bits", 32),
        HwPort.output("retire_instruction_length_bytes", "Bits", 3),
        HwPort.output("retire_pc_before", "Bits", xlen),
        HwPort.output("retire_pc_after", "Bits", xlen),
        HwPort.output("retire_rd", "Bits", 5), HwPort.output("retire_rd_write", "Bits", 1),
        HwPort.output("retire_rd_value", "Bits", xlen)]

pub fn strict_riscv_scalar_runtime_alu_hwir(module_name: text, config: CoreConfig,
    plan: RiscvScalarDecoderPlan) -> Result<HwModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-ALU-ID: runtime ALU requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-ALU-COMPRESSED: runtime ALU v1 requires canonical four-byte lineage")
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if (config.xlen as u32 != plan.xlen or
        config.isa_profile != plan.isa_profile):
        return Err("HWIR-E-RISCV-RUNTIME-ALU-CONFIG: runtime ALU requires its exact decoder plan")
    val x = config.xlen
    val row_width = runtime_alu_row_width(plan.entries.len())
    var constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1),
        HwConstant.bits("zero2", 2, 0), HwConstant.bits("zero3", 3, 0),
        HwConstant.bits("zero5", 5, 0), HwConstant.bits("zero6", 6, 0),
        HwConstant.bits("zero7", 7, 0), HwConstant.bits("zero12", 12, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero64", 64, 0),
        HwConstant.bits("zero_xlen", x, 0), HwConstant.bits("integer_class", 3, 1),
        HwConstant.bits("length4", 3, 4),
        HwConstant.bits("four_xlen", x, 4),
        HwConstant.bits("xlen_value", 7, x as i64), HwConstant.bits("shift7", 32, 7),
        HwConstant.bits("shift15", 32, 15), HwConstant.bits("shift20", 32, 20),
        HwConstant.bits("u_mask", 32, 0xFFFFF000)]
    var signals = [HwSignal.comb("instruction_rd_shift", "Bits", 32),
        HwSignal.comb("instruction_rs1_shift", "Bits", 32),
        HwSignal.comb("instruction_rs2_shift", "Bits", 32),
        HwSignal.comb("canonical_rd", "Bits", 5), HwSignal.comb("canonical_rs1", "Bits", 5),
        HwSignal.comb("canonical_rs2", "Bits", 5), HwSignal.comb("rd_bound", "Bits", 1),
        HwSignal.comb("rs1_bound", "Bits", 1), HwSignal.comb("rs2_bound", "Bits", 1),
        HwSignal.comb("fields_01", "Bits", 1), HwSignal.comb("fields_bound", "Bits", 1),
        HwSignal.comb("class_valid", "Bits", 1), HwSignal.comb("memory_valid", "Bits", 1),
        HwSignal.comb("length_valid", "Bits", 1), HwSignal.comb("event_valid", "Bits", 1),
        HwSignal.comb("original_valid", "Bits", 1),
        HwSignal.comb("expected_fallthrough", "Bits", x),
        HwSignal.comb("fallthrough_valid", "Bits", 1),
        HwSignal.comb("rs1_nonzero", "Bits", 1), HwSignal.comb("rs2_nonzero", "Bits", 1),
        HwSignal.comb("effective_rs1", "Bits", x), HwSignal.comb("effective_rs2", "Bits", x),
        HwSignal.comb("base_01", "Bits", 1), HwSignal.comb("base_23", "Bits", 1),
        HwSignal.comb("base_45", "Bits", 1), HwSignal.comb("base_partial", "Bits", 1),
        HwSignal.comb("base_lineage", "Bits", 1), HwSignal.comb("base_core", "Bits", 1),
        HwSignal.comb("base_valid", "Bits", 1),
        HwSignal.comb("i_shifted", "Bits", 32), HwSignal.comb("i_imm12", "Bits", 12),
        HwSignal.comb("i_immediate", "Bits", x),
        HwSignal.comb("i_immediate_word", "Bits", 32), HwSignal.comb("u_masked", "Bits", 32),
        HwSignal.comb("u_immediate", "Bits", x), HwSignal.comb("rs1_word", "Bits", 32),
        HwSignal.comb("rs2_word", "Bits", 32), HwSignal.comb("selected_any", "Bits", 1),
        HwSignal.comb("shamt5_raw", "Bits", 5), HwSignal.comb("shamt6_raw", "Bits", 6),
        HwSignal.comb("shamt5_xlen", "Bits", x), HwSignal.comb("shamt6_xlen", "Bits", x),
        HwSignal.comb("shamt5_word", "Bits", 32),
        HwSignal.comb("rs2_shamt5_raw", "Bits", 5), HwSignal.comb("rs2_shamt6_raw", "Bits", 6),
        HwSignal.comb("rs2_shamt5_xlen", "Bits", x), HwSignal.comb("rs2_shamt6_xlen", "Bits", x),
        HwSignal.comb("rs2_shamt5_word", "Bits", 32),
        HwSignal.comb("selected_result", "Bits", x), HwSignal.comb("selection_missing", "Bits", 1),
        HwSignal.comb("alu_claim", "Bits", 1), HwSignal.comb("fault_value", "Bits", 1),
        HwSignal.comb("rd_nonzero", "Bits", 1),
        HwSignal.comb("write_valid", "Bits", 1)]
    var ops = [HwCombOp.binary("shr", "instruction_rd_shift", "canonical_instruction", "shift7", 32),
        HwCombOp.binary("shr", "instruction_rs1_shift", "canonical_instruction", "shift15", 32),
        HwCombOp.binary("shr", "instruction_rs2_shift", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "canonical_rd", "instruction_rd_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs1", "instruction_rs1_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs2", "instruction_rs2_shift", 5),
        HwCombOp.binary("eq", "rd_bound", "canonical_rd", "instruction_rd_field", 5),
        HwCombOp.binary("eq", "rs1_bound", "canonical_rs1", "instruction_rs1_field", 5),
        HwCombOp.binary("eq", "rs2_bound", "canonical_rs2", "instruction_rs2_field", 5),
        HwCombOp.binary("and", "fields_01", "rd_bound", "rs1_bound", 1),
        HwCombOp.binary("and", "fields_bound", "fields_01", "rs2_bound", 1),
        HwCombOp.binary("eq", "class_valid", "decoded_execution_class", "integer_class", 3),
        HwCombOp.binary("eq", "memory_valid", "decoded_memory_effect", "zero3", 3),
        HwCombOp.binary("eq", "length_valid", "instruction_length_bytes", "length4", 3),
        HwCombOp.binary("eq", "event_valid", "provider_event_id", "decode_event_id", 64),
        HwCombOp.binary("eq", "original_valid", "original_instruction", "canonical_instruction", 32),
        HwCombOp.binary("add", "expected_fallthrough", "pc_before", "four_xlen", x),
        HwCombOp.binary("eq", "fallthrough_valid", "fallthrough_pc", "expected_fallthrough", x),
        HwCombOp.binary("ne", "rs1_nonzero", "canonical_rs1", "zero5", 5),
        HwCombOp.binary("ne", "rs2_nonzero", "canonical_rs2", "zero5", 5),
        HwCombOp.binary("and", "base_01", "uop_valid", "decode_legal", 1),
        HwCombOp.binary("and", "base_23", "memory_valid", "length_valid", 1),
        HwCombOp.binary("and", "base_45", "event_valid", "lineage_valid", 1),
        HwCombOp.binary("and", "base_partial", "base_01", "base_23", 1),
        HwCombOp.binary("and", "base_lineage", "original_valid", "fallthrough_valid", 1),
        HwCombOp.binary("and", "base_core", "base_partial", "base_45", 1),
        HwCombOp.binary("and", "base_valid", "base_core", "base_lineage", 1),
        HwCombOp.binary("shr", "i_shifted", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "i_imm12", "i_shifted", 12),
        HwCombOp.unary("sext", "i_immediate", "i_imm12", x),
        HwCombOp.unary("sext", "i_immediate_word", "i_imm12", 32),
        HwCombOp.binary("and", "u_masked", "canonical_instruction", "u_mask", 32),
        HwCombOp.unary("sext", "u_immediate", "u_masked", x),
        HwCombOp.unary("trunc", "rs1_word", "effective_rs1", 32),
        HwCombOp.unary("trunc", "rs2_word", "effective_rs2", 32),
        HwCombOp.unary("trunc", "shamt5_raw", "i_shifted", 5),
        HwCombOp.unary("trunc", "shamt6_raw", "i_shifted", 6),
        HwCombOp.unary("zext", "shamt5_xlen", "shamt5_raw", x),
        HwCombOp.unary("zext", "shamt6_xlen", "shamt6_raw", x),
        HwCombOp.unary("zext", "shamt5_word", "shamt5_raw", 32),
        HwCombOp.unary("trunc", "rs2_shamt5_raw", "effective_rs2", 5),
        HwCombOp.unary("trunc", "rs2_shamt6_raw", "effective_rs2", 6),
        HwCombOp.unary("zext", "rs2_shamt5_xlen", "rs2_shamt5_raw", x),
        HwCombOp.unary("zext", "rs2_shamt6_xlen", "rs2_shamt6_raw", x),
        HwCombOp.unary("zext", "rs2_shamt5_word", "rs2_shamt5_raw", 32)]
    var selects: [HwSelectOp] = [
        HwSelectOp.mux("effective_rs1", "rs1_nonzero", "rs1_value", "zero_xlen", x),
        HwSelectOp.mux("effective_rs2", "rs2_nonzero", "rs2_value", "zero_xlen", x)]
    var prior_valid = "zero1"
    var prior_result = "zero_xlen"
    var row_index = 0
    var admitted = 0
    var origins = [HwOrigin(node_id: HwNodeId.child(module_name, "runtime-interface"),
        source_name: "riscv.scalar.runtime-alu.plan." + plan.structural_sha256())]
    for entry in plan.entries:
        val operation = runtime_alu_operation(entry)
        if ((entry.execution_class == "integer" or
                entry.execution_class == "integer-word") and
            operation != ""):
            val suffix = admitted.to_text()
            val mask = "mask_" + suffix; val value = "value_" + suffix
            val opcode = "opcode_" + suffix; val width_mode = "width_mode_" + suffix
            val row_id = "row_id_" + suffix
            val masked = "masked_" + suffix; val form_match = "form_match_" + suffix
            val opcode_match = "opcode_match_" + suffix; val width_match = "width_match_" + suffix
            val row_id_match = "row_id_match_" + suffix
            val match01 = "match01_" + suffix; val match23 = "match23_" + suffix
            val match45 = "match45_" + suffix; val row_match = "row_match_" + suffix
            val candidate = "candidate_" + suffix; val row_accepted = "row_accepted_" + suffix
            val selected_valid = "selected_valid_" + suffix
            val selected_result = "selected_result_" + suffix
            constants.push(HwConstant.bits(mask, 32, entry.encoding_mask as i64))
            constants.push(HwConstant.bits(value, 32, entry.encoding_value as i64))
            constants.push(HwConstant.bits(opcode, 6,
                riscv_scalar_semantic_opcode(entry.semantic_operation)))
            constants.push(HwConstant.bits(width_mode, 1,
                if entry.operand_width_bits == 32: 1 else: 0))
            constants.push(HwConstant.bits(row_id, row_width, (row_index + 1) as i64))
            for signal in [(masked, 32), (form_match, 1), (opcode_match, 1),
                    (width_match, 1), (row_id_match, 1), (match01, 1), (match23, 1), (match45, 1),
                    (row_match, 1), (candidate, x), (row_accepted, 1), (selected_valid, 1),
                    (selected_result, x)]:
                signals.push(HwSignal.comb(signal[0], "Bits", signal[1]))
            ops.push(HwCombOp.binary("and", masked, "canonical_instruction", mask, 32))
            ops.push(HwCombOp.binary("eq", form_match, masked, value, 32))
            ops.push(HwCombOp.binary("eq", opcode_match, "decoded_semantic_opcode", opcode, 6))
            ops.push(HwCombOp.binary("eq", width_match,
                "decoded_declared_operand_width_is_32", width_mode, 1))
            ops.push(HwCombOp.binary("eq", row_id_match, "decoded_row_index", row_id, row_width))
            ops.push(HwCombOp.binary("and", match01, form_match, opcode_match, 1))
            ops.push(HwCombOp.binary("and", match23, width_match, "class_valid", 1))
            ops.push(HwCombOp.binary("and", match45, "fields_bound", "lineage_valid", 1))
            val row_pre = "row_pre_" + suffix
            signals.push(HwSignal.comb(row_pre, "Bits", 1))
            ops.push(HwCombOp.binary("and", row_pre, match01, match23, 1))
            ops.push(HwCombOp.binary("and", row_match, row_pre, row_id_match, 1))
            val complete_match = "complete_match_" + suffix
            signals.push(HwSignal.comb(complete_match, "Bits", 1))
            ops.push(HwCombOp.binary("and", complete_match, row_match, match45, 1))
            ops.push(HwCombOp.binary("and", row_accepted, complete_match, "base_valid", 1))
            val is_word = entry.execution_class == "integer-word"
            val lhs = if entry.semantic_operation == "auipc": "pc_before"
                elif is_word: "rs1_word" else: "effective_rs1"
            val rhs = if entry.semantic_operation == "lui" or entry.semantic_operation == "auipc":
                    "u_immediate"
                elif operation == "shl" or operation == "shr" or operation == "sar":
                    if is_word: (if runtime_alu_is_immediate(entry): "shamt5_word" else: "rs2_shamt5_word")
                    elif runtime_alu_is_immediate(entry): (if x == 32: "shamt5_xlen" else: "shamt6_xlen")
                    else: (if x == 32: "rs2_shamt5_xlen" else: "rs2_shamt6_xlen")
                elif runtime_alu_is_immediate(entry): (if is_word: "i_immediate_word" else: "i_immediate")
                elif is_word: "rs2_word" else: "effective_rs2"
            if operation == "lui":
                ops.push(HwCombOp.unary("passthrough", candidate, "u_immediate", x))
            elif is_word:
                val word = "candidate_word_" + suffix
                signals.push(HwSignal.comb(word, "Bits", 32))
                ops.push(HwCombOp.binary(operation, word, lhs, rhs, 32))
                ops.push(HwCombOp.unary("sext", candidate, word, x))
            elif operation == "slt" or operation == "ult":
                val predicate = "candidate_predicate_" + suffix
                signals.push(HwSignal.comb(predicate, "Bits", 1))
                ops.push(HwCombOp.binary(operation, predicate, lhs, rhs, x))
                ops.push(HwCombOp.unary("zext", candidate, predicate, x))
            else:
                ops.push(HwCombOp.binary(operation, candidate, lhs, rhs, x))
            selects.push(HwSelectOp.mux(selected_valid, row_accepted, "one1", prior_valid, 1))
            selects.push(HwSelectOp.mux(selected_result, row_accepted, candidate, prior_result, x))
            prior_valid = selected_valid
            prior_result = selected_result
            origins.push(HwOrigin(node_id: HwNodeId.child(module_name, "row." + entry.id),
                source_name: entry.id))
            admitted = admitted + 1
        row_index = row_index + 1
    if admitted == 0: return Err("HWIR-E-RISCV-RUNTIME-ALU-SCOPE: product has no admitted runtime integer rows")
    ops.push(HwCombOp.unary("passthrough", "selected_any", prior_valid, 1))
    ops.push(HwCombOp.unary("passthrough", "selected_result", prior_result, x))
    ops.push(HwCombOp.binary("eq", "selection_missing", "selected_any", "zero1", 1))
    ops.push(HwCombOp.binary("and", "alu_claim", "base_01", "class_valid", 1))
    ops.push(HwCombOp.binary("and", "fault_value", "alu_claim", "selection_missing", 1))
    ops.push(HwCombOp.binary("ne", "rd_nonzero", "canonical_rd", "zero5", 5))
    ops.push(HwCombOp.binary("and", "write_valid", "selected_any", "rd_nonzero", 1))
    ops.push(HwCombOp.unary("passthrough", "retire_valid", "selected_any", 1))
    ops.push(HwCombOp.unary("passthrough", "protocol_fault", "fault_value", 1))
    selects.push(HwSelectOp.mux("retire_order", "selected_any", "provider_event_id", "zero64", 64))
    selects.push(HwSelectOp.mux("retire_xlen", "selected_any", "xlen_value", "zero7", 7))
    selects.push(HwSelectOp.mux("retire_privilege", "selected_any", "privilege", "zero2", 2))
    selects.push(HwSelectOp.mux("retire_original_instruction", "selected_any",
        "original_instruction", "zero32", 32))
    selects.push(HwSelectOp.mux("retire_canonical_instruction", "selected_any",
        "canonical_instruction", "zero32", 32))
    selects.push(HwSelectOp.mux("retire_instruction_length_bytes", "selected_any",
        "instruction_length_bytes", "zero3", 3))
    selects.push(HwSelectOp.mux("retire_pc_before", "selected_any", "pc_before", "zero_xlen", x))
    selects.push(HwSelectOp.mux("retire_pc_after", "selected_any", "fallthrough_pc", "zero_xlen", x))
    selects.push(HwSelectOp.mux("retire_rd", "write_valid", "canonical_rd", "zero5", 5))
    selects.push(HwSelectOp.mux("retire_rd_write", "selected_any", "rd_nonzero", "zero1", 1))
    selects.push(HwSelectOp.mux("retire_rd_value", "write_valid", "selected_result", "zero_xlen", x))
    val ports = runtime_alu_ports(x, row_width)
    val summary = HwModule(name: module_name, profile: config.profile, port_count: ports.len(),
        signal_count: signals.len(), register_count: 0,
        comb_op_count: ops.len() + selects.len(), memory_count: 0,
        clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty())
    val module = HwModuleDef(summary: summary, config: config,
        node_id: HwNodeId.module_root(module_name), origins: origins, ports: ports,
        signals: signals, constants: constants, comb_ops: ops,
        compare_ops: [], select_ops: selects,
        clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
