# Plan-bound dynamic FENCE/FENCE.I provider with accepted external-effect ownership.

use compiler.mir.hwir.types.{CoreConfig, HwCombOp, HwConstant, HwNodeId,
    HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard,
    HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef,
    HwSequentialPlan, HwStateRegister}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_semantic_opcode}

fn fence_row_width(count: i32) -> i32:
    var width = 1; var capacity = 2
    while capacity <= count:
        width = width + 1; capacity = capacity * 2
    width

fn completion_rows(x: i32) -> [(text, i32)]:
    [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
        ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x),
        ("rd", 5), ("rd_write", 1), ("rd_value", x), ("memory_address", x),
        ("memory_read_mask", 32), ("memory_write_mask", 32),
        ("memory_read_data", x), ("memory_write_data", x),
        ("execute_trap_valid", 1), ("execute_trap_cause", x),
        ("execute_trap_tval", x), ("memory_trap_valid", 1),
        ("memory_trap_cause", x), ("memory_trap_tval", x),
        ("redirect_valid", 1), ("redirect_target", x),
        ("provider_event_id", 64), ("decode_event_id", 64), ("illegal_valid", 1)]

fn provider_ports(x: i32, row_width: i32) -> [HwPort]:
    var ports = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("request_valid", "Bits", 1),
        HwPort.input("request_provider_tag", "Bits", 3),
        HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("decoded_row_index", "Bits", row_width),
        HwPort.input("decoded_execution_class", "Bits", 3),
        HwPort.input("decoded_memory_effect", "Bits", 3),
        HwPort.input("decoded_semantic_opcode", "Bits", 6),
        HwPort.input("decoded_declared_operand_width_is_32", "Bits", 1),
        HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("original_instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("instruction_rd_field", "Bits", 5),
        HwPort.input("instruction_rs1_field", "Bits", 5),
        HwPort.input("instruction_rs2_field", "Bits", 5),
        HwPort.input("rs1_value", "Bits", x), HwPort.input("rs2_value", "Bits", x),
        HwPort.input("pc_before", "Bits", x), HwPort.input("fallthrough_pc", "Bits", x),
        HwPort.input("privilege", "Bits", 2),
        HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64), HwPort.input("lineage_valid", "Bits", 1),
        HwPort.input("illegal_valid", "Bits", 1),
        HwPort.input("fence_effect_ready", "Bits", 1),
        HwPort.input("completion_ready", "Bits", 1),
        HwPort.output("request_ready", "Bits", 1), HwPort.output("request_accept", "Bits", 1),
        HwPort.output("fence_effect_valid", "Bits", 1),
        HwPort.output("fence_effect_kind", "Bits", 2),
        HwPort.output("fence_effect_fm", "Bits", 4),
        HwPort.output("fence_effect_pred", "Bits", 4),
        HwPort.output("fence_effect_succ", "Bits", 4),
        HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("completion_provider_tag", "Bits", 3),
        HwPort.output("provider_protocol_fault", "Bits", 1)]
    for row in completion_rows(x):
        ports.push(HwPort.output("completion_" + row[0], "Bits", row[1]))
    ports

fn provider_registers(x: i32) -> [HwStateRegister]:
    var registers = [HwStateRegister(name: "pending_reg", bit_width: 1,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "full_reg", bit_width: 1,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "fault_reg", bit_width: 1,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "effect_kind_reg", bit_width: 2,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "effect_fm_reg", bit_width: 4,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "effect_pred_reg", bit_width: 4,
            clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "effect_succ_reg", bit_width: 4,
            clock_domain: "default", reset_value: 0)]
    for row in completion_rows(x):
        registers.push(HwStateRegister(name: "completion_" + row[0] + "_reg",
            bit_width: row[1], clock_domain: "default", reset_value: 0))
    registers

fn capture_request(x: i32) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "effect_kind_reg", value: HwSeqValue.copy("selected_kind", 2)),
        HwSeqAssignment(destination: "effect_fm_reg", value: HwSeqValue.copy("decoded_fm", 4)),
        HwSeqAssignment(destination: "effect_pred_reg", value: HwSeqValue.copy("decoded_pred", 4)),
        HwSeqAssignment(destination: "effect_succ_reg", value: HwSeqValue.copy("decoded_succ", 4))]
    for row in completion_rows(x):
        var source = row[0]
        if row[0] == "pc_after": source = "fallthrough_pc"
        elif row[0] == "rd": source = "zero5"
        elif row[0] == "provider_event_id": source = "provider_event_id"
        elif row[0] == "decode_event_id": source = "decode_event_id"
        elif row[0] == "privilege" or row[0] == "original_instruction" or
            row[0] == "canonical_instruction" or row[0] == "instruction_length_bytes" or
            row[0] == "pc_before": source = row[0]
        else: source = if row[1] == x: "zero_xlen" elif row[1] == 32: "zero32" elif row[1] == 5: "zero5" else: "zero1"
        assignments.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg",
            value: HwSeqValue.copy(source, row[1])))
    assignments

fn clear_completion(x: i32) -> [HwSeqAssignment]:
    var assignments = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]
    for row in completion_rows(x):
        assignments.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg",
            value: HwSeqValue.zero(row[1])))
    assignments

pub fn strict_riscv_scalar_runtime_fence_provider(module_name: text,
    config: CoreConfig, plan: RiscvScalarDecoderPlan) -> Result<HwSequentialModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-FENCE-ID: runtime FENCE provider requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-FENCE-COMPRESSED: v1 requires canonical four-byte instructions")
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-RUNTIME-FENCE-CONFIG: provider requires its exact decoder plan")
    val x = config.xlen; val row_width = fence_row_width(plan.entries.len())
    var constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1),
        HwConstant.bits("zero2", 2, 0),
        HwConstant.bits("zero3", 3, 0), HwConstant.bits("zero5", 5, 0),
        HwConstant.bits("zero4", 4, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero_xlen", x, 0),
        HwConstant.bits("tag_fence", 3, 4), HwConstant.bits("class_fence", 3, 7),
        HwConstant.bits("effect_fence", 3, 4), HwConstant.bits("length4", 3, 4),
        HwConstant.bits("four_xlen", x, 4), HwConstant.bits("shift7", 32, 7),
        HwConstant.bits("shift15", 32, 15), HwConstant.bits("shift20", 32, 20),
        HwConstant.bits("shift24", 32, 24), HwConstant.bits("shift28", 32, 28)]
    var signals = [HwSignal.comb("tag_ok", "Bits", 1), HwSignal.comb("tag_bad", "Bits", 1),
        HwSignal.comb("not_pending", "Bits", 1), HwSignal.comb("not_full", "Bits", 1),
        HwSignal.comb("not_fault", "Bits", 1), HwSignal.comb("idle_pre", "Bits", 1),
        HwSignal.comb("idle", "Bits", 1), HwSignal.comb("request_handshake", "Bits", 1),
        HwSignal.comb("class_ok", "Bits", 1), HwSignal.comb("effect_ok", "Bits", 1),
        HwSignal.comb("width_ok", "Bits", 1), HwSignal.comb("length_ok", "Bits", 1),
        HwSignal.comb("raw_ok", "Bits", 1), HwSignal.comb("events_ok", "Bits", 1),
        HwSignal.comb("fallthrough_expected", "Bits", x), HwSignal.comb("fallthrough_ok", "Bits", 1),
        HwSignal.comb("rd_shift", "Bits", 32), HwSignal.comb("rs1_shift", "Bits", 32),
        HwSignal.comb("rs2_shift", "Bits", 32), HwSignal.comb("canonical_rd", "Bits", 5),
        HwSignal.comb("canonical_rs1", "Bits", 5), HwSignal.comb("canonical_rs2", "Bits", 5),
        HwSignal.comb("rd_ok", "Bits", 1), HwSignal.comb("rs1_ok", "Bits", 1),
        HwSignal.comb("rs2_ok", "Bits", 1), HwSignal.comb("raw_fields01", "Bits", 1),
        HwSignal.comb("raw_fields_ok", "Bits", 1),
        HwSignal.comb("rd_zero", "Bits", 1), HwSignal.comb("rs1_zero", "Bits", 1),
        HwSignal.comb("fm_zero", "Bits", 1), HwSignal.comb("fence_zero01", "Bits", 1),
        HwSignal.comb("fence_encoding_ok", "Bits", 1), HwSignal.comb("legal_flag_ok", "Bits", 1),
        HwSignal.comb("base01", "Bits", 1), HwSignal.comb("base23", "Bits", 1),
        HwSignal.comb("base45", "Bits", 1), HwSignal.comb("base67", "Bits", 1),
        HwSignal.comb("base_a", "Bits", 1), HwSignal.comb("base_b", "Bits", 1),
        HwSignal.comb("base_pre", "Bits", 1), HwSignal.comb("base_valid", "Bits", 1),
        HwSignal.comb("selected_any", "Bits", 1),
        HwSignal.comb("selected_kind", "Bits", 2), HwSignal.comb("selection_missing", "Bits", 1),
        HwSignal.comb("accepted_malformed", "Bits", 1), HwSignal.comb("fault_any", "Bits", 1),
        HwSignal.comb("fm_shift", "Bits", 32), HwSignal.comb("pred_shift", "Bits", 32),
        HwSignal.comb("succ_shift", "Bits", 32), HwSignal.comb("decoded_fm", "Bits", 4),
        HwSignal.comb("decoded_pred", "Bits", 4), HwSignal.comb("decoded_succ", "Bits", 4)]
    var ops = [HwCombOp.binary("eq", "tag_ok", "request_provider_tag", "tag_fence", 3),
        HwCombOp.binary("ne", "tag_bad", "request_provider_tag", "tag_fence", 3),
        HwCombOp.binary("eq", "not_pending", "pending_reg", "zero1", 1),
        HwCombOp.binary("eq", "not_full", "full_reg", "zero1", 1),
        HwCombOp.binary("eq", "not_fault", "fault_reg", "zero1", 1),
        HwCombOp.binary("and", "idle_pre", "not_pending", "not_full", 1),
        HwCombOp.binary("and", "idle", "idle_pre", "not_fault", 1),
        HwCombOp.binary("and", "request_handshake", "request_valid", "idle", 1),
        HwCombOp.binary("eq", "class_ok", "decoded_execution_class", "class_fence", 3),
        HwCombOp.binary("eq", "effect_ok", "decoded_memory_effect", "effect_fence", 3),
        HwCombOp.binary("eq", "width_ok", "decoded_declared_operand_width_is_32", "zero1", 1),
        HwCombOp.binary("eq", "length_ok", "instruction_length_bytes", "length4", 3),
        HwCombOp.binary("eq", "raw_ok", "original_instruction", "canonical_instruction", 32),
        HwCombOp.binary("eq", "events_ok", "provider_event_id", "decode_event_id", 64),
        HwCombOp.binary("add", "fallthrough_expected", "pc_before", "four_xlen", x),
        HwCombOp.binary("eq", "fallthrough_ok", "fallthrough_pc", "fallthrough_expected", x),
        HwCombOp.binary("shr", "rd_shift", "canonical_instruction", "shift7", 32),
        HwCombOp.binary("shr", "rs1_shift", "canonical_instruction", "shift15", 32),
        HwCombOp.binary("shr", "rs2_shift", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "canonical_rd", "rd_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs1", "rs1_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs2", "rs2_shift", 5),
        HwCombOp.binary("eq", "rd_ok", "canonical_rd", "instruction_rd_field", 5),
        HwCombOp.binary("eq", "rs1_ok", "canonical_rs1", "instruction_rs1_field", 5),
        HwCombOp.binary("eq", "rs2_ok", "canonical_rs2", "instruction_rs2_field", 5),
        HwCombOp.binary("and", "raw_fields01", "rd_ok", "rs1_ok", 1),
        HwCombOp.binary("and", "raw_fields_ok", "raw_fields01", "rs2_ok", 1),
        HwCombOp.binary("eq", "rd_zero", "canonical_rd", "zero5", 5),
        HwCombOp.binary("eq", "rs1_zero", "canonical_rs1", "zero5", 5),
        HwCombOp.binary("eq", "legal_flag_ok", "illegal_valid", "zero1", 1),
        HwCombOp.binary("and", "base01", "decode_legal", "class_ok", 1),
        HwCombOp.binary("and", "base23", "effect_ok", "width_ok", 1),
        HwCombOp.binary("and", "base45", "length_ok", "raw_ok", 1),
        HwCombOp.binary("and", "base67", "events_ok", "lineage_valid", 1),
        HwCombOp.binary("and", "base_a", "base01", "base23", 1),
        HwCombOp.binary("and", "base_b", "base45", "base67", 1),
        HwCombOp.binary("and", "base_pre", "base_a", "base_b", 1),
        HwCombOp.binary("and", "base_valid", "base_pre", "fallthrough_ok", 1),
        HwCombOp.binary("shr", "fm_shift", "canonical_instruction", "shift28", 32),
        HwCombOp.binary("shr", "pred_shift", "canonical_instruction", "shift24", 32),
        HwCombOp.binary("shr", "succ_shift", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "decoded_fm", "fm_shift", 4),
        HwCombOp.unary("trunc", "decoded_pred", "pred_shift", 4),
        HwCombOp.unary("trunc", "decoded_succ", "succ_shift", 4),
        HwCombOp.binary("eq", "fm_zero", "decoded_fm", "zero4", 4),
        HwCombOp.binary("and", "fence_zero01", "rd_zero", "rs1_zero", 1),
        HwCombOp.binary("and", "fence_encoding_ok", "fence_zero01", "fm_zero", 1)]
    var selects: [HwSelectOp] = []
    var prior_valid = "zero1"; var prior_kind = "zero2"; var row_index = 0; var admitted = 0
    var origins = [HwOrigin(node_id: HwNodeId.child(module_name, "plan"),
        source_name: "riscv.scalar.runtime.fence.plan." + plan.structural_sha256())]
    for entry in plan.entries:
        if entry.id == "rv.i.fence" or entry.id == "rv.i.fence_i":
            val suffix = admitted.to_text(); val mask = "mask_" + suffix
            val value = "value_" + suffix; val opcode = "opcode_" + suffix
            val row = "row_" + suffix; val masked = "masked_" + suffix
            val form = "form_" + suffix; val semantic = "semantic_" + suffix
            val row_match = "row_match_" + suffix
            val candidate01 = "candidate01_" + suffix; val candidate = "candidate_" + suffix
            val legal_candidate = "legal_candidate_" + suffix
            val accepted = "accepted_" + suffix; val next_valid = "selected_valid_" + suffix
            val next_kind = "selected_kind_" + suffix
            constants.push(HwConstant.bits(mask, 32,
                if entry.id == "rv.i.fence_i": 0xFFFFFFFF else: entry.encoding_mask as i64))
            constants.push(HwConstant.bits(value, 32, entry.encoding_value as i64))
            constants.push(HwConstant.bits(opcode, 6, riscv_scalar_semantic_opcode(entry.semantic_operation)))
            constants.push(HwConstant.bits(row, row_width, (row_index + 1) as i64))
            for signal in [(masked, 32), (form, 1), (semantic, 1), (row_match, 1),
                    (candidate01, 1), (candidate, 1), (legal_candidate, 1), (accepted, 1),
                    (next_valid, 1), (next_kind, 2)]:
                signals.push(HwSignal.comb(signal[0], "Bits", signal[1]))
            ops.push(HwCombOp.binary("and", masked, "canonical_instruction", mask, 32))
            ops.push(HwCombOp.binary("eq", form, masked, value, 32))
            ops.push(HwCombOp.binary("eq", semantic, "decoded_semantic_opcode", opcode, 6))
            ops.push(HwCombOp.binary("eq", row_match, "decoded_row_index", row, row_width))
            ops.push(HwCombOp.binary("and", candidate01, form, semantic, 1))
            ops.push(HwCombOp.binary("and", candidate, candidate01, row_match, 1))
            val accepted_base = "accepted_base_" + suffix
            signals.push(HwSignal.comb(accepted_base, "Bits", 1))
            val encoding_ok = if entry.id == "rv.i.fence": "fence_encoding_ok" else: "one1"
            ops.push(HwCombOp.binary("and", legal_candidate, candidate, encoding_ok, 1))
            ops.push(HwCombOp.binary("and", accepted_base, legal_candidate, "base_valid", 1))
            ops.push(HwCombOp.binary("and", accepted, accepted_base, "raw_fields_ok", 1))
            val accepted_legal = "accepted_legal_" + suffix
            signals.push(HwSignal.comb(accepted_legal, "Bits", 1))
            ops.push(HwCombOp.binary("and", accepted_legal, accepted, "legal_flag_ok", 1))
            selects.push(HwSelectOp.mux(next_valid, accepted_legal, "one1", prior_valid, 1))
            val kind = if entry.id == "rv.i.fence_i": "kind_i" else: "kind_order"
            constants.push(HwConstant.bits(kind, 2, if entry.id == "rv.i.fence_i": 2 else: 1))
            selects.push(HwSelectOp.mux(next_kind, accepted_legal, kind, prior_kind, 2))
            prior_valid = next_valid; prior_kind = next_kind; admitted = admitted + 1
            origins.push(HwOrigin(node_id: HwNodeId.child(module_name, "row." + entry.id), source_name: entry.id))
        row_index = row_index + 1
    if admitted < 1 or admitted > 2:
        return Err("HWIR-E-RISCV-RUNTIME-FENCE-SCOPE: provider requires exact FENCE and optional plan-present FENCE.I rows")
    ops.push(HwCombOp.unary("passthrough", "selected_any", prior_valid, 1))
    ops.push(HwCombOp.unary("passthrough", "selected_kind", prior_kind, 2))
    ops.push(HwCombOp.binary("eq", "selection_missing", "selected_any", "zero1", 1))
    ops.push(HwCombOp.binary("and", "accepted_malformed", "request_handshake", "selection_missing", 1))
    ops.push(HwCombOp.binary("and", "fault_any", "accepted_malformed", "tag_ok", 1))
    val rules = [HwSeqRule(name: "protocol_fault", guards: [HwSeqGuard.high("fault_any"),
                HwSeqGuard.low("fault_reg")], assignments: [
                HwSeqAssignment(destination: "fault_reg", value: HwSeqValue.copy("one1", 1)),
                HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
                HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]),
        HwSeqRule(name: "completion_consume", guards: [HwSeqGuard.high("completion_ready"),
                HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")], assignments: clear_completion(x)),
        HwSeqRule(name: "effect_accept", guards: [HwSeqGuard.high("fence_effect_ready"),
                HwSeqGuard.high("pending_reg"), HwSeqGuard.low("fault_reg")], assignments: [
                HwSeqAssignment(destination: "pending_reg", value: HwSeqValue.zero(1)),
                HwSeqAssignment(destination: "full_reg", value: HwSeqValue.copy("one1", 1))]),
        HwSeqRule(name: "request_capture", guards: [HwSeqGuard.high("request_handshake"),
                HwSeqGuard.high("tag_ok"), HwSeqGuard.high("selected_any"),
                HwSeqGuard.low("pending_reg"), HwSeqGuard.low("full_reg"),
                HwSeqGuard.low("fault_reg")], assignments: capture_request(x))]
    val idle_guards = [HwSeqGuard.low("pending_reg"), HwSeqGuard.low("full_reg"),
        HwSeqGuard.low("fault_reg"), HwSeqGuard.high("tag_ok")]
    val pending = [HwSeqGuard.high("pending_reg"), HwSeqGuard.low("fault_reg")]
    val full = [HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")]
    var outputs = [HwSeqOutputBinding.all("request_ready", idle_guards),
        HwSeqOutputBinding.all("request_accept", [HwSeqGuard.high("request_valid"),
            HwSeqGuard.high("tag_ok"), HwSeqGuard.low("pending_reg"),
            HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")]),
        HwSeqOutputBinding.all("fence_effect_valid", pending),
        HwSeqOutputBinding.guarded("fence_effect_kind", "effect_kind_reg", 2, pending),
        HwSeqOutputBinding.guarded("fence_effect_fm", "effect_fm_reg", 4, pending),
        HwSeqOutputBinding.guarded("fence_effect_pred", "effect_pred_reg", 4, pending),
        HwSeqOutputBinding.guarded("fence_effect_succ", "effect_succ_reg", 4, pending),
        HwSeqOutputBinding.all("completion_valid", full),
        HwSeqOutputBinding.guarded("completion_provider_tag", "tag_fence", 3, full),
        HwSeqOutputBinding.direct("provider_protocol_fault", "fault_reg", 1)]
    for row in completion_rows(x):
        outputs.push(HwSeqOutputBinding.guarded("completion_" + row[0],
            "completion_" + row[0] + "_reg", row[1], full))
    val plan_def = HwSequentialPlan(owner_id: HwNodeId.child(module_name, "sequential"),
        registers: provider_registers(x), rules: rules, outputs: outputs, decoder_pins: [])
    val module = HwSequentialModuleDef(node_id: HwNodeId.module_root(module_name),
        entity_name: module_name, config: config, origins: origins,
        ports: provider_ports(x, row_width), datapath_signals: signals,
        datapath_constants: constants, datapath_bit_vector_constants: [],
        datapath_comb_ops: ops, datapath_compare_ops: [], datapath_select_ops: selects,
        datapath_bit_extract_ops: [], datapath_fixed_slice_ops: [], plan: plan_def,
        child_entity: "", child_graph_sha256: "")
    val diagnostic = module.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
