# Dynamic base-I branch/jump datapath; it makes no admission/completion claim.
use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp,
    HwSignal}

class HwRuntimeControlPart:
    signals: [HwSignal]
    ops: [HwCombOp]
    value_name: text

fn runtime_control_part(prefix: text, shift: text, mask: text,
    left: text) -> HwRuntimeControlPart:
    val shifted = prefix + "_shifted"; val masked = prefix + "_masked"
    var signals = [HwSignal.comb(shifted, "Bits", 32), HwSignal.comb(masked, "Bits", 32)]
    var ops = [HwCombOp.binary("shr", shifted, "canonical_instruction", shift, 32),
        HwCombOp.binary("and", masked, shifted, mask, 32)]
    if left == "": return HwRuntimeControlPart(signals: signals, ops: ops, value_name: masked)
    val positioned = prefix + "_positioned"
    signals.push(HwSignal.comb(positioned, "Bits", 32))
    ops.push(HwCombOp.binary("shl", positioned, masked, left, 32))
    HwRuntimeControlPart(signals: signals, ops: ops, value_name: positioned)

fn append_runtime_control_part(signals: [HwSignal], ops: [HwCombOp],
    part: HwRuntimeControlPart) -> ([HwSignal], [HwCombOp]):
    var next_signals = signals; var next_ops = ops
    for signal in part.signals: next_signals.push(signal)
    for op in part.ops: next_ops.push(op)
    (next_signals, next_ops)

pub fn strict_riscv_scalar_runtime_control_datapath(module_name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-CONTROL-DATAPATH-ID: control datapath requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val x = config.xlen
    val ports = [HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("instruction_rs1_field", "Bits", 5),
        HwPort.input("pc_before", "Bits", x), HwPort.input("rs1_value", "Bits", x),
        HwPort.input("rs2_value", "Bits", x), HwPort.output("branch_immediate", "Bits", x),
        HwPort.output("jump_immediate", "Bits", x), HwPort.output("jalr_immediate", "Bits", x),
        HwPort.output("branch_target", "Bits", x), HwPort.output("jal_target", "Bits", x),
        HwPort.output("jalr_target", "Bits", x), HwPort.output("branch_eq", "Bits", 1),
        HwPort.output("branch_ne", "Bits", 1), HwPort.output("branch_lt", "Bits", 1),
        HwPort.output("branch_ge", "Bits", 1), HwPort.output("branch_ltu", "Bits", 1),
        HwPort.output("branch_geu", "Bits", 1), HwPort.output("branch_target_misaligned", "Bits", 1),
        HwPort.output("jal_target_misaligned", "Bits", 1), HwPort.output("jalr_target_misaligned", "Bits", 1)]
    val constants = [HwConstant.bits("zero_x", x, 0), HwConstant.bits("shift7", 32, 7),
        HwConstant.bits("shift8", 32, 8), HwConstant.bits("shift12", 32, 12),
        HwConstant.bits("shift20", 32, 20), HwConstant.bits("shift21", 32, 21),
        HwConstant.bits("shift25", 32, 25), HwConstant.bits("shift31", 32, 31),
        HwConstant.bits("mask1", 32, 1), HwConstant.bits("mask4", 32, 15),
        HwConstant.bits("mask6", 32, 63), HwConstant.bits("mask8", 32, 255),
        HwConstant.bits("mask10", 32, 1023), HwConstant.bits("mask12", 32, 4095),
        HwConstant.bits("zero5", 5, 0),
        HwConstant.bits("left1", 32, 1), HwConstant.bits("left5", 32, 5),
        HwConstant.bits("left11", 32, 11), HwConstant.bits("left12", 32, 12),
        HwConstant.bits("left20", 32, 20), HwConstant.bits("jalr_mask", x, -2),
        HwConstant.bits("ialign_mask", x, if config.compressed_decode_profile == "none": 3 else: 1)]
    val parts = [runtime_control_part("b12", "shift31", "mask1", "left12"),
        runtime_control_part("b11", "shift7", "mask1", "left11"),
        runtime_control_part("b10_5", "shift25", "mask6", "left5"),
        runtime_control_part("b4_1", "shift8", "mask4", "left1"),
        runtime_control_part("j20", "shift31", "mask1", "left20"),
        runtime_control_part("j19_12", "shift12", "mask8", "left12"),
        runtime_control_part("j11", "shift20", "mask1", "left11"),
        runtime_control_part("j10_1", "shift21", "mask10", "left1"),
        runtime_control_part("i11_0", "shift20", "mask12", "")]
    var signals: [HwSignal] = []; var ops: [HwCombOp] = []
    for part in parts:
        val appended = append_runtime_control_part(signals, ops, part)
        signals = appended[0]; ops = appended[1]
    for signal in [("b01", 32), ("b23", 32), ("braw", 32), ("braw13", 13),
            ("j01", 32), ("j23", 32), ("jraw", 32), ("jraw21", 21),
            ("iraw12", 12), ("rs1_nonzero", 1), ("effective_rs1", x),
            ("jalr_raw", x), ("branch_low", x), ("jal_low", x),
            ("jalr_low", x)]:
        signals.push(HwSignal.comb(signal[0], "Bits", signal[1]))
    ops.push(HwCombOp.binary("or", "b01", parts[0].value_name, parts[1].value_name, 32)); ops.push(HwCombOp.binary("or", "b23", parts[2].value_name, parts[3].value_name, 32)); ops.push(HwCombOp.binary("or", "braw", "b01", "b23", 32)); ops.push(HwCombOp.unary("trunc", "braw13", "braw", 13)); ops.push(HwCombOp.unary("sext", "branch_immediate", "braw13", x))
    ops.push(HwCombOp.binary("or", "j01", parts[4].value_name, parts[5].value_name, 32)); ops.push(HwCombOp.binary("or", "j23", parts[6].value_name, parts[7].value_name, 32)); ops.push(HwCombOp.binary("or", "jraw", "j01", "j23", 32)); ops.push(HwCombOp.unary("trunc", "jraw21", "jraw", 21)); ops.push(HwCombOp.unary("sext", "jump_immediate", "jraw21", x)); ops.push(HwCombOp.unary("trunc", "iraw12", parts[8].value_name, 12)); ops.push(HwCombOp.unary("sext", "jalr_immediate", "iraw12", x))
    ops.push(HwCombOp.binary("ne", "rs1_nonzero", "instruction_rs1_field", "zero5", 5))
    val selects = [HwSelectOp.mux("effective_rs1", "rs1_nonzero",
        "rs1_value", "zero_x", x)]
    ops.push(HwCombOp.binary("add", "branch_target", "pc_before", "branch_immediate", x)); ops.push(HwCombOp.binary("add", "jal_target", "pc_before", "jump_immediate", x)); ops.push(HwCombOp.binary("add", "jalr_raw", "effective_rs1", "jalr_immediate", x)); ops.push(HwCombOp.binary("and", "jalr_target", "jalr_raw", "jalr_mask", x))
    for predicate in [("eq", "branch_eq"), ("ne", "branch_ne"), ("slt", "branch_lt"),
            ("sge", "branch_ge"), ("ult", "branch_ltu"), ("uge", "branch_geu")]:
        ops.push(HwCombOp.binary(predicate[0], predicate[1], "rs1_value", "rs2_value", x))
    for item in [("branch_target", "branch_low", "branch_target_misaligned"),
            ("jal_target", "jal_low", "jal_target_misaligned"),
            ("jalr_target", "jalr_low", "jalr_target_misaligned")]:
        ops.push(HwCombOp.binary("and", item[1], item[0], "ialign_mask", x)); ops.push(HwCombOp.binary("ne", item[2], item[1], "zero_x", x))
    val module = HwModuleDef(summary: HwModule(name: module_name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0,
            comb_op_count: ops.len() + selects.len(), memory_count: 0, clock_domain_count: 1,
            fallback_function: "", cost: HwCostModel.empty()), config: config,
        node_id: HwNodeId.module_root(module_name), origins: [HwOrigin(
            node_id: HwNodeId.child(module_name, "dynamic-control"),
            source_name: "riscv.scalar.runtime.control.datapath")], ports: ports,
        signals: signals, constants: constants, comb_ops: ops, compare_ops: [],
        select_ops: selects, clock_domains: [HwClockDomain.default_domain()])
    val diagnostic = module.shape_diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(module)
