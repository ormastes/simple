# Frozen control-and-lineage descriptor for registered dispatch to stateful scalar providers.
#
# This descriptor owns no registers and performs no arbitration.  The eventual
# dispatcher/provider owner must implement the frozen hold, match, and sticky
# fault rules below.  Request payload is the decoded-uop interface and response
# payload is the shared completion interface; neither payload is duplicated here.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwModuleDef, hwir_hash_fields}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{HwScalarDecodedUopInterface}
use compiler.mir.hwir.riscv_scalar_completion_interface.{HwScalarCompletionInterface}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan}

pub class HwScalarPendingProviderTag:
    name: text
    value: i32

pub class HwScalarPendingProtocolField:
    name: text
    direction: text
    bit_width: i32
    semantic: text

fn pending_provider_tags() -> [HwScalarPendingProviderTag]:
    [HwScalarPendingProviderTag(name: "lsu", value: 1),
        HwScalarPendingProviderTag(name: "muldiv", value: 2),
        HwScalarPendingProviderTag(name: "csr", value: 3),
        HwScalarPendingProviderTag(name: "fence", value: 4)]

fn pending_protocol_fields() -> [HwScalarPendingProtocolField]:
    [HwScalarPendingProtocolField(name: "request_valid", direction: "dispatcher-to-provider",
            bit_width: 1, semantic: "held-until-request-ready"),
        HwScalarPendingProtocolField(name: "request_ready", direction: "provider-to-dispatcher",
            bit_width: 1, semantic: "atomic-request-accept"),
        HwScalarPendingProtocolField(name: "request_provider_tag", direction: "dispatcher-to-provider",
            bit_width: 3, semantic: "accepted-provider-owner-zero-reserved-invalid"),
        HwScalarPendingProtocolField(name: "request_event_id", direction: "dispatcher-to-provider",
            bit_width: 64, semantic: "provider-lineage"),
        HwScalarPendingProtocolField(name: "request_decode_event_id", direction: "dispatcher-to-provider",
            bit_width: 64, semantic: "decode-lineage"),
        HwScalarPendingProtocolField(name: "completion_valid", direction: "provider-to-dispatcher",
            bit_width: 1, semantic: "held-until-completion-ready"),
        HwScalarPendingProtocolField(name: "completion_ready", direction: "dispatcher-to-provider",
            bit_width: 1, semantic: "atomic-completion-accept"),
        HwScalarPendingProtocolField(name: "completion_provider_tag", direction: "provider-to-dispatcher",
            bit_width: 3, semantic: "must-match-accepted-request-zero-reserved-invalid"),
        HwScalarPendingProtocolField(name: "completion_event_id", direction: "provider-to-dispatcher",
            bit_width: 64, semantic: "must-match-accepted-request"),
        HwScalarPendingProtocolField(name: "completion_decode_event_id", direction: "provider-to-dispatcher",
            bit_width: 64, semantic: "must-match-accepted-request"),
        HwScalarPendingProtocolField(name: "provider_protocol_fault", direction: "provider-to-dispatcher",
            bit_width: 1, semantic: "any-provider-fault-is-sticky-owner-fault"),
        HwScalarPendingProtocolField(name: "protocol_fault", direction: "owner-to-pipeline",
            bit_width: 1, semantic: "sticky-until-reset")]

fn pending_protocol_rules() -> [text]:
    ["compiler-route-selects-exactly-one-provider-or-faults",
        "one-outstanding-request-per-owner",
        "request-control-and-decoded-uop-payload-stable-while-valid-and-not-ready",
        "request-valid-and-accept-are-one-hot-and-consistent",
        "accepted-tag-event-ids-and-full-dispatch-payload-are-held",
        "completion-control-and-shared-payload-stable-while-valid-and-not-ready",
        "completion-ready-is-one-hot-for-the-accepted-provider",
        "completion-before-request-acceptance-is-fault",
        "wrong-lane-tag-overlap-or-either-event-id-mismatch-is-fault",
        "duplicate-completion-or-any-provider-fault-is-fault",
        "sticky-fault-suppresses-requests-completion-ready-output-and-new-dispatch-until-reset"]

pub class HwScalarPendingProviderProtocol:
    version: text
    config: CoreConfig
    plan_sha256: text
    decoded_uop_schema_sha256: text
    completion_schema_sha256: text
    provider_tag_width: i32
    provider_tags: [HwScalarPendingProviderTag]
    fields: [HwScalarPendingProtocolField]
    rules: [text]
    state_owner: text

    me diagnostic_for_interfaces(decoded_uop: HwScalarDecodedUopInterface,
        decoder: HwModuleDef, plan: RiscvScalarDecoderPlan,
        completion: HwScalarCompletionInterface) -> text:
        if self.version != "hwir-scalar-pending-provider/v1":
            return "HWIR-E-SCALAR-PENDING-VERSION: pending-provider protocol requires frozen v1"
        val config_error = self.config.diagnostic(); if config_error != "": return config_error
        val completion_error = completion.diagnostic(); if completion_error != "": return completion_error
        val decoded_error = decoded_uop.diagnostic_for_decoder(decoder, plan)
        if decoded_error != "": return decoded_error
        if (self.config.profile != decoded_uop.config.profile or
            self.config.isa_profile != decoded_uop.config.isa_profile or
            self.config.compressed_decode_profile != decoded_uop.config.compressed_decode_profile or
            self.config.xlen != decoded_uop.config.xlen or
            self.config.physical_address_bits != decoded_uop.config.physical_address_bits or
            self.config.register_count != decoded_uop.config.register_count or
            self.config.profile != completion.config.profile or
            self.config.isa_profile != completion.config.isa_profile or
            self.config.compressed_decode_profile != completion.config.compressed_decode_profile or
            self.config.xlen != completion.config.xlen or
            self.config.physical_address_bits != completion.config.physical_address_bits or
            self.config.register_count != completion.config.register_count):
            return "HWIR-E-SCALAR-PENDING-CONFIG: protocol requires one exact core configuration"
        if (self.plan_sha256 != plan.structural_sha256() or
            self.plan_sha256 != decoded_uop.plan_sha256 or
            self.decoded_uop_schema_sha256 != decoded_uop.structural_sha256() or
            self.completion_schema_sha256 != completion.structural_sha256()):
            return "HWIR-E-SCALAR-PENDING-SCHEMA: protocol requires exact plan and payload schemas"
        if self.provider_tag_width != 3 or self.state_owner != "sequential-dispatcher-and-provider-owners":
            return "HWIR-E-SCALAR-PENDING-OWNER: protocol descriptor does not own state"
        val expected_tags = pending_provider_tags()
        if self.provider_tags.len() != expected_tags.len():
            return "HWIR-E-SCALAR-PENDING-TAG: protocol requires exact provider tags"
        var index = 0
        while index < expected_tags.len():
            if (self.provider_tags[index].name != expected_tags[index].name or
                self.provider_tags[index].value != expected_tags[index].value):
                return "HWIR-E-SCALAR-PENDING-TAG: protocol requires exact provider tags"
            index = index + 1
        val expected_fields = pending_protocol_fields()
        if self.fields.len() != expected_fields.len():
            return "HWIR-E-SCALAR-PENDING-FIELD: protocol requires exact ordered fields"
        index = 0
        while index < expected_fields.len():
            val field = self.fields[index]; val required = expected_fields[index]
            if (field.name != required.name or field.direction != required.direction or
                field.bit_width != required.bit_width or field.semantic != required.semantic):
                return "HWIR-E-SCALAR-PENDING-FIELD: protocol requires exact ordered fields"
            index = index + 1
        val expected_rules = pending_protocol_rules()
        if self.rules.len() != expected_rules.len():
            return "HWIR-E-SCALAR-PENDING-RULE: protocol requires exact fault semantics"
        index = 0
        while index < expected_rules.len():
            if self.rules[index] != expected_rules[index]:
                return "HWIR-E-SCALAR-PENDING-RULE: protocol requires exact fault semantics"
            index = index + 1
        ""

    me structural_sha256() -> text:
        var rows = [hwir_hash_fields(["header", self.version, self.config.profile, self.config.isa_profile,
            self.config.compressed_decode_profile, self.config.xlen.to_text(),
            self.config.physical_address_bits.to_text(), self.config.register_count.to_text(),
            self.plan_sha256, self.decoded_uop_schema_sha256, self.completion_schema_sha256,
            self.provider_tag_width.to_text(), self.state_owner])]
        for tag in self.provider_tags:
            rows.push(hwir_hash_fields(["tag", tag.name, tag.value.to_text()]))
        for field in self.fields:
            rows.push(hwir_hash_fields(["field", field.name, field.direction,
                field.bit_width.to_text(), field.semantic]))
        for rule in self.rules: rows.push(hwir_hash_fields(["rule", rule]))
        sha256_text(rows.join("\n"))

pub fn strict_hw_scalar_pending_provider_protocol(config: CoreConfig,
    decoded_uop: HwScalarDecodedUopInterface,
    decoder: HwModuleDef, plan: RiscvScalarDecoderPlan,
    completion: HwScalarCompletionInterface) -> Result<HwScalarPendingProviderProtocol, text>:
    val descriptor = HwScalarPendingProviderProtocol(
        version: "hwir-scalar-pending-provider/v1", config: config,
        plan_sha256: decoded_uop.plan_sha256,
        decoded_uop_schema_sha256: decoded_uop.structural_sha256(),
        completion_schema_sha256: completion.structural_sha256(),
        provider_tag_width: 3, provider_tags: pending_provider_tags(),
        fields: pending_protocol_fields(), rules: pending_protocol_rules(),
        state_owner: "sequential-dispatcher-and-provider-owners")
    val error = descriptor.diagnostic_for_interfaces(decoded_uop, decoder, plan, completion)
    if error != "": return Err(error)
    Ok(descriptor)
