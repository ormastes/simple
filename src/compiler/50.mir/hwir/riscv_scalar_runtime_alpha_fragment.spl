# Owner-local alpha-renaming for embedding closed runtime datapath fragments.
#
# A V7 owner must stay one flat sequential module: HWIR sequential modules have
# one child slot and cannot compose the DIV normalizer and restoring datapath as
# detached child entities.  This helper preserves typed graph records while
# binding only their declared inputs to owner-local values.  Every other value
# is prefixed, preventing d64/d32 and normalizer/datapath collisions.

use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}
use compiler.mir.hwir.types.{HwBitExtractOp, HwCombOp, HwFixedSliceOp,
    HwSelectOp, HwSignal, hwir_vhdl_identifier}

pub class RiscvScalarRuntimeAlphaFragment:
    signals: [HwSignal]
    constants: [HwBitVectorConstant]
    comb_ops: [HwCombOp]
    select_ops: [HwSelectOp]
    bit_extract_ops: [HwBitExtractOp]
    fixed_slice_ops: [HwFixedSliceOp]

fn alpha_input_width(inputs: [(text, i32)], name: text) -> i32:
    for input in inputs:
        if input[0] == name: return input[1]
    0

fn alpha_binding_target(bindings: [(text, text)], name: text) -> text:
    for binding in bindings:
        if binding[0] == name: return binding[1]
    ""

fn alpha_name(prefix: text, bindings: [(text, text)], name: text) -> text:
    if name == "": return ""
    val bound = alpha_binding_target(bindings, name)
    if bound != "": return bound
    prefix + "_" + name

fn alpha_bindings_diagnostic(prefix: text, inputs: [(text, i32)],
    bindings: [(text, text)]) -> text:
    if not hwir_vhdl_identifier(prefix):
        return "HWIR-E-RISCV-RUNTIME-ALPHA-PREFIX: fragment prefix is not a strict VHDL identifier"
    if bindings.len() != inputs.len():
        return "HWIR-E-RISCV-RUNTIME-ALPHA-BINDINGS: every declared fragment input requires exactly one binding"
    for binding in bindings:
        if alpha_input_width(inputs, binding[0]) == 0 or not hwir_vhdl_identifier(binding[1]):
            return "HWIR-E-RISCV-RUNTIME-ALPHA-BINDINGS: binding has an unknown input or unsafe owner value"
        var duplicates = 0
        var target_duplicates = 0
        for other in bindings:
            if other[0] == binding[0]: duplicates = duplicates + 1
            if other[1] == binding[1]: target_duplicates = target_duplicates + 1
        if duplicates != 1:
            return "HWIR-E-RISCV-RUNTIME-ALPHA-BINDINGS: fragment input is bound more than once"
        if target_duplicates != 1:
            return "HWIR-E-RISCV-RUNTIME-ALPHA-BINDINGS: owner value is bound by more than one fragment input"
    ""

pub fn strict_riscv_scalar_runtime_alpha_fragment(prefix: text,
    input_fields: [(text, i32)], bindings: [(text, text)], signals: [HwSignal],
    constants: [HwBitVectorConstant], comb_ops: [HwCombOp],
    select_ops: [HwSelectOp], bit_extract_ops: [HwBitExtractOp],
    fixed_slice_ops: [HwFixedSliceOp]) -> Result<RiscvScalarRuntimeAlphaFragment, text>:
    """Return a closed, collision-free owner-local copy of a typed fragment.

    `bindings` is deliberately limited to the fragment's declared inputs.
    Outputs, intermediates and constants always receive `prefix`, so an owner
    can safely import d64, d32 and normalizer fragments in one flat graph.
    """
    val binding_error = alpha_bindings_diagnostic(prefix, input_fields, bindings)
    if binding_error != "": return Err(binding_error)
    var renamed_signals: [HwSignal] = []
    for signal in signals:
        if alpha_input_width(input_fields, signal.name) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment signal must not drive a declared input")
        renamed_signals.push(HwSignal.comb(alpha_name(prefix, bindings, signal.name),
            signal.type_name, signal.bit_width))
    var renamed_constants: [HwBitVectorConstant] = []
    for constant in constants:
        if alpha_input_width(input_fields, constant.name) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment constant must not shadow a declared input")
        renamed_constants.push(HwBitVectorConstant.binary(alpha_name(prefix, bindings, constant.name),
            constant.bit_width, constant.canonical_bits))
    var renamed_comb: [HwCombOp] = []
    for op in comb_ops:
        if alpha_input_width(input_fields, op.result) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment operation must not drive a declared input")
        renamed_comb.push(HwCombOp(op: op.op, result: alpha_name(prefix, bindings, op.result),
            lhs: alpha_name(prefix, bindings, op.lhs), rhs: alpha_name(prefix, bindings, op.rhs), bit_width: op.bit_width))
    var renamed_select: [HwSelectOp] = []
    for op in select_ops:
        if alpha_input_width(input_fields, op.result) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment operation must not drive a declared input")
        renamed_select.push(HwSelectOp.mux(alpha_name(prefix, bindings, op.result),
            alpha_name(prefix, bindings, op.condition), alpha_name(prefix, bindings, op.when_true),
            alpha_name(prefix, bindings, op.when_false), op.bit_width))
    var renamed_extract: [HwBitExtractOp] = []
    for op in bit_extract_ops:
        if alpha_input_width(input_fields, op.result) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment operation must not drive a declared input")
        renamed_extract.push(HwBitExtractOp.fixed(alpha_name(prefix, bindings, op.result),
            alpha_name(prefix, bindings, op.source), op.bit_index))
    var renamed_slice: [HwFixedSliceOp] = []
    for op in fixed_slice_ops:
        if alpha_input_width(input_fields, op.result) != 0:
            return Err("HWIR-E-RISCV-RUNTIME-ALPHA-DRIVER: fragment operation must not drive a declared input")
        renamed_slice.push(HwFixedSliceOp.fixed(alpha_name(prefix, bindings, op.result),
            alpha_name(prefix, bindings, op.source), op.high_bit, op.low_bit))
    Ok(RiscvScalarRuntimeAlphaFragment(signals: renamed_signals, constants: renamed_constants,
        comb_ops: renamed_comb, select_ops: renamed_select, bit_extract_ops: renamed_extract,
        fixed_slice_ops: renamed_slice))
