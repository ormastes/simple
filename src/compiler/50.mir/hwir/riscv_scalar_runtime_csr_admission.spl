# Frozen, host-evaluable admission contract for the V8 dynamic Zicsr provider.
# This file deliberately owns no sequential state or public pipeline wiring.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_decoder_plan, riscv_scalar_semantic_opcode}

pub class RiscvScalarRuntimeCsrAdmissionRow:
    id: text
    encoding_mask: u32
    encoding_value: u32
    decoded_row_index: i32
    semantic_opcode: i64
    form_code: i32

    me canonical_text() -> text:
        self.id + ":" + self.encoding_mask.to_text() + ":" +
            self.encoding_value.to_text() + ":" + self.decoded_row_index.to_text() + ":" +
            self.semantic_opcode.to_text() + ":" + self.form_code.to_text()

pub class RiscvScalarRuntimeCsrAdmissionContract:
    isa_profile: text
    plan_sha256: text
    xlen: i32
    decoded_row_width: i32
    provider_tag: i32
    execution_class: i32
    memory_effect: i32
    rows: [RiscvScalarRuntimeCsrAdmissionRow]
    required_metadata_checks: [text]
    trap_policy: text

    me diagnostic() -> text:
        if (self.isa_profile != "rv32i_zicsr_zifencei" and
            self.isa_profile != "rv64i_zicsr_zifencei" and
            self.isa_profile != "rv32i_zmmul_zicsr_zifencei" and
            self.isa_profile != "rv64i_zmmul_zicsr_zifencei" and
            self.isa_profile != "rv32im_zicsr_zifencei" and
            self.isa_profile != "rv64im_zicsr_zifencei") or
            (self.xlen != 32 and self.xlen != 64):
            return "HWIR-E-RISCV-RUNTIME-CSR-PROFILE: CSR admission requires a concrete Zicsr product"
        if (self.isa_profile.starts_with("rv32") and self.xlen != 32) or
            (self.isa_profile.starts_with("rv64") and self.xlen != 64):
            return "HWIR-E-RISCV-RUNTIME-CSR-CONFIG: CSR profile must match XLEN"
        val plan_result = riscv_scalar_decoder_plan(self.isa_profile)
        if plan_result.is_err():
            return "HWIR-E-RISCV-RUNTIME-CSR-PLAN: CSR contract requires its exact decoder plan"
        val plan = plan_result.ok().unwrap()
        if self.plan_sha256 != plan.structural_sha256():
            return "HWIR-E-RISCV-RUNTIME-CSR-PLAN: CSR contract plan provenance differs from its ISA profile"
        if self.decoded_row_width < 1 or self.provider_tag != 3 or
            self.execution_class != 6 or self.memory_effect != 3:
            return "HWIR-E-RISCV-RUNTIME-CSR-PROTOCOL: CSR admission fixes tag three, CSR class, and CSR effect"
        val expected_ids = ["rv.zicsr.csrrw", "rv.zicsr.csrrs", "rv.zicsr.csrrc",
            "rv.zicsr.csrrwi", "rv.zicsr.csrrsi", "rv.zicsr.csrrci"]
        if self.rows.len() != expected_ids.len():
            return "HWIR-E-RISCV-RUNTIME-CSR-SCOPE: CSR admission requires all six exact Zicsr rows"
        var ids: [text] = []
        var expected_rows: [RiscvScalarRuntimeCsrAdmissionRow] = []
        var plan_index = 0
        for entry in plan.entries:
            if csr_id(entry.id):
                expected_rows.push(RiscvScalarRuntimeCsrAdmissionRow(id: entry.id,
                    encoding_mask: entry.encoding_mask, encoding_value: entry.encoding_value,
                    decoded_row_index: plan_index + 1,
                    semantic_opcode: riscv_scalar_semantic_opcode(entry.semantic_operation),
                    form_code: csr_form_code(entry.id)))
            plan_index = plan_index + 1
        for row in self.rows:
            if row.id == "" or row.encoding_mask == 0 or
                (row.encoding_value & row.encoding_mask) != row.encoding_value or
                row.decoded_row_index <= 0 or row.decoded_row_index >= (1 << self.decoded_row_width):
                return "HWIR-E-RISCV-RUNTIME-CSR-ROW: CSR rows require concrete frozen decode metadata"
            if ids.contains(row.id) or not expected_ids.contains(row.id):
                return "HWIR-E-RISCV-RUNTIME-CSR-ROW: CSR rows must be unique exact Zicsr rows"
            if row.form_code != csr_form_code(row.id) or
                row.semantic_opcode != csr_semantic_opcode(row.id):
                return "HWIR-E-RISCV-RUNTIME-CSR-ROW: CSR row form or semantic opcode differs from its exact row"
            ids.push(row.id)
        var exact_index = 0
        for expected in expected_rows:
            val actual = self.rows[exact_index]
            if actual.id != expected.id or actual.encoding_mask != expected.encoding_mask or
                actual.encoding_value != expected.encoding_value or
                actual.decoded_row_index != expected.decoded_row_index or
                actual.semantic_opcode != expected.semantic_opcode or actual.form_code != expected.form_code:
                return "HWIR-E-RISCV-RUNTIME-CSR-ROW: CSR rows must preserve exact plan order and encoding provenance"
            exact_index = exact_index + 1
        for id in expected_ids:
            if not ids.contains(id):
                return "HWIR-E-RISCV-RUNTIME-CSR-ROW: CSR admission must cover all six exact Zicsr rows"
        if self.required_metadata_checks != ["decode_legal", "execution_class", "memory_effect",
            "instruction_length", "canonical_original_identity", "canonical_form",
            "decoded_row_index", "semantic_opcode", "declared_operand_width", "register_fields",
            "lineage", "event_identity", "fallthrough_pc"]:
            return "HWIR-E-RISCV-RUNTIME-CSR-METADATA: CSR admission requires the full exact metadata check set"
        if self.trap_policy != "absent_or_privilege_or_read_only_write_is_execute_cause_2":
            return "HWIR-E-RISCV-RUNTIME-CSR-TRAP: CSR admission fixes the execute cause-two access policy"
        ""

    me structural_sha256() -> text:
        var fields = ["riscv-scalar-runtime-csr-admission-v1", self.isa_profile, self.plan_sha256,
            self.xlen.to_text(), self.decoded_row_width.to_text(), self.provider_tag.to_text(),
            self.execution_class.to_text(), self.memory_effect.to_text(),
            self.required_metadata_checks.join(","), self.trap_policy]
        for row in self.rows: fields.push(row.canonical_text())
        sha256_text(fields.join("\n"))

pub class RiscvScalarRuntimeCsrAdmissionEvaluation:
    admitted: bool
    form_code: i32
    csr_address: i64
    source_value: i64
    source_is_immediate: bool
    write_requested: bool
    write_value: i64
    read_requested: bool
    rd_write_requested: bool
    access_allowed: bool
    execute_trap_valid: bool
    execute_trap_cause: i64

fn csr_form_code(id: text) -> i32:
    if id == "rv.zicsr.csrrw": return 0
    if id == "rv.zicsr.csrrs": return 1
    if id == "rv.zicsr.csrrc": return 2
    if id == "rv.zicsr.csrrwi": return 3
    if id == "rv.zicsr.csrrsi": return 4
    if id == "rv.zicsr.csrrci": return 5
    -1

fn csr_semantic_opcode(id: text) -> i64:
    if id == "rv.zicsr.csrrw": return 14
    if id == "rv.zicsr.csrrs": return 13
    if id == "rv.zicsr.csrrc": return 12
    if id == "rv.zicsr.csrrwi": return 16
    if id == "rv.zicsr.csrrsi": return 15
    if id == "rv.zicsr.csrrci": return 11
    -1

fn csr_row_width(count: i32) -> i32:
    var width = 1; var capacity = 2
    while capacity <= count:
        width = width + 1; capacity = capacity * 2
    width

fn csr_id(id: text) -> bool:
    csr_form_code(id) >= 0

fn csr_xlen_bits(value: i64, xlen: i32) -> i64:
    if xlen == 64: return value
    value & ((1 << xlen) - 1)

pub fn strict_riscv_scalar_runtime_csr_admission(config: CoreConfig,
    plan: RiscvScalarDecoderPlan) -> Result<RiscvScalarRuntimeCsrAdmissionContract, text>:
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if config.compressed_decode_profile != "none":
        return Err("HWIR-E-RISCV-RUNTIME-CSR-COMPRESSED: v1 requires canonical four-byte instructions")
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile:
        return Err("HWIR-E-RISCV-RUNTIME-CSR-CONFIG: admission requires its exact decoder plan")
    if config.isa_profile != "rv32i_zicsr_zifencei" and
        config.isa_profile != "rv64i_zicsr_zifencei" and
        config.isa_profile != "rv32i_zmmul_zicsr_zifencei" and
        config.isa_profile != "rv64i_zmmul_zicsr_zifencei" and
        config.isa_profile != "rv32im_zicsr_zifencei" and
        config.isa_profile != "rv64im_zicsr_zifencei":
        return Err("HWIR-E-RISCV-RUNTIME-CSR-SCOPE: admission requires a Zicsr decoder plan")
    var rows: [RiscvScalarRuntimeCsrAdmissionRow] = []
    var index = 0
    for entry in plan.entries:
        if csr_id(entry.id):
            if entry.execution_class != "csr" or entry.memory_effect != "csr" or
                entry.operand_width_bits != 0 or entry.writeback_rule != "rd=old_csr" or
                entry.trap_behavior != "illegal_or_csr_fault":
                return Err("HWIR-E-RISCV-RUNTIME-CSR-METADATA: CSR rows require exact non-memory old-value metadata")
            val form = csr_form_code(entry.id)
            val expected_semantic = if form == 0: "csr_read_write" elif form == 1: "csr_read_set"
                elif form == 2: "csr_read_clear" elif form == 3: "csr_write_immediate"
                elif form == 4: "csr_set_immediate" else: "csr_clear_immediate"
            if entry.semantic_operation != expected_semantic:
                return Err("HWIR-E-RISCV-RUNTIME-CSR-METADATA: CSR row semantic must match its exact form")
            rows.push(RiscvScalarRuntimeCsrAdmissionRow(id: entry.id,
                encoding_mask: entry.encoding_mask, encoding_value: entry.encoding_value,
                decoded_row_index: index + 1,
                semantic_opcode: riscv_scalar_semantic_opcode(entry.semantic_operation), form_code: form))
        index = index + 1
    val contract = RiscvScalarRuntimeCsrAdmissionContract(isa_profile: config.isa_profile,
        plan_sha256: plan.structural_sha256(),
        xlen: config.xlen, decoded_row_width: csr_row_width(plan.entries.len()), provider_tag: 3,
        execution_class: 6, memory_effect: 3, rows: rows,
        required_metadata_checks: ["decode_legal", "execution_class", "memory_effect",
            "instruction_length", "canonical_original_identity", "canonical_form",
            "decoded_row_index", "semantic_opcode", "declared_operand_width", "register_fields",
            "lineage", "event_identity", "fallthrough_pc"],
        trap_policy: "absent_or_privilege_or_read_only_write_is_execute_cause_2")
    val diagnostic = contract.diagnostic(); if diagnostic != "": return Err(diagnostic)
    Ok(contract)

pub fn evaluate_riscv_scalar_runtime_csr_admission(contract: RiscvScalarRuntimeCsrAdmissionContract,
    row_id: text, instruction: u32, privilege: i64, rs1_value: i64,
    csr_present: bool, csr_read_value: i64) -> Result<RiscvScalarRuntimeCsrAdmissionEvaluation, text>:
    val diagnostic = contract.diagnostic(); if diagnostic != "": return Err(diagnostic)
    val form = csr_form_code(row_id)
    val row = contract.rows.filter(_.id == row_id)
    if form < 0 or row.len() != 1:
        return Err("HWIR-E-RISCV-RUNTIME-CSR-ADMISSION: request must name an exact admitted CSR row")
    val row_match = (instruction & row[0].encoding_mask) == row[0].encoding_value
    if not row_match:
        return Err("HWIR-E-RISCV-RUNTIME-CSR-ADMISSION: instruction does not match its admitted CSR form")
    val csr_address = ((instruction >> 20) & 0xFFF) as i64
    val rd = ((instruction >> 7) & 31) as i64
    val rs1_or_zimm = ((instruction >> 15) & 31) as i64
    val immediate = form >= 3
    val source = csr_xlen_bits(if immediate: rs1_or_zimm elif rs1_or_zimm == 0: 0 else: rs1_value,
        contract.xlen)
    val read_write = form == 0 or form == 3
    val write_requested = read_write or rs1_or_zimm != 0
    val old_value = csr_xlen_bits(csr_read_value, contract.xlen)
    val write_value = csr_xlen_bits(if form == 1 or form == 4: old_value | source
        elif form == 2 or form == 5: old_value & (~source)
        else: source
        , contract.xlen)
    val read_requested = not (read_write and rd == 0)
    val required_privilege = (csr_address >> 8) & 3
    val read_only = ((csr_address >> 10) & 3) == 3
    val privilege_ok = privilege >= required_privilege and privilege != 2 and required_privilege != 2
    val access_allowed = csr_present and privilege_ok and not (read_only and write_requested)
    Ok(RiscvScalarRuntimeCsrAdmissionEvaluation(admitted: true, form_code: form,
        csr_address: csr_address, source_value: source, source_is_immediate: immediate,
        write_requested: write_requested, write_value: write_value, read_requested: read_requested,
        rd_write_requested: rd != 0, access_allowed: access_allowed,
        execute_trap_valid: not access_allowed,
        execute_trap_cause: if access_allowed: 0 else: 2))
