# Generic typed literal-zero owner for disabled hardware capability inputs.
#
# This is deliberately separate from the scalar runtime completion-default
# owner: a consumer must opt in by naming this child and binding its output.

use std.common.crypto.sha256.{sha256_text}
use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort,
    hwir_hash_fields, hwir_vhdl_identifier}

pub fn hw_typed_zero_owner_port_name(width: i32) -> text:
    "zero_" + width.to_text()

pub fn hw_typed_zero_owner_port_schema_sha256(ports: [HwPort]) -> text:
    """Return the ordered, typed public default-port schema digest.

    The full module digest also commits origins and literal drivers.  This
    smaller digest lets a composition manifest audit the exact disabled-input
    boundary without treating a port spelling as an implicit default.
    """
    var fields: [text] = ["simple-hwir-typed-zero-owner-schema/v1",
        ports.len().to_text()]
    for port in ports:
        fields.push(port.name)
        fields.push(port.direction)
        fields.push(port.type_name)
        fields.push(port.bit_width.to_text())
        fields.push(port.clock_domain)
    sha256_text(hwir_hash_fields(fields))

fn typed_zero_owner_schema_diagnostic(ports: [HwPort]) -> text:
    if ports.len() == 0:
        return "HWIR-E-TYPED-ZERO-PORT: typed zero owner requires at least one requested width"
    var widths: [i32] = []
    var names: [text] = []
    for port in ports:
        if (port.bit_width <= 0 or port.direction != "out" or
            port.type_name != "Bits" or port.clock_domain != "default" or
            not hwir_vhdl_identifier(port.name) or
            port.name != hw_typed_zero_owner_port_name(port.bit_width)):
            return "HWIR-E-TYPED-ZERO-PORT: zero owner ports require exact zero_<positive-width> output Bits schema"
        if widths.contains(port.bit_width) or names.contains(port.name.lower()):
            return "HWIR-E-TYPED-ZERO-PORT: zero owner widths and VHDL port names must be injective"
        widths.push(port.bit_width)
        names.push(port.name.lower())
    ""

fn typed_zero_owner_from_schema(module_name: text, config: CoreConfig,
    ports: [HwPort]) -> Result<HwModuleDef, text>:
    if module_name == "" or not hwir_vhdl_identifier(module_name):
        return Err("HWIR-E-TYPED-ZERO-ID: typed zero owner requires a legal module name")
    val config_error = config.diagnostic()
    if config_error != "": return Err(config_error)
    val schema_error = typed_zero_owner_schema_diagnostic(ports)
    if schema_error != "": return Err(schema_error)
    var constants: [HwConstant] = []
    var ops: [HwCombOp] = []
    for port in ports:
        val constant = "literal_" + port.name
        constants.push(HwConstant.bits(constant, port.bit_width, 0))
        ops.push(HwCombOp.unary("passthrough", port.name, constant,
            port.bit_width))
    val module = HwModuleDef(summary: HwModule(name: module_name,
            profile: config.profile, port_count: ports.len(), signal_count: 0,
            register_count: 0, comb_op_count: ops.len(), memory_count: 0,
            clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty()), config: config,
        node_id: HwNodeId.module_root(module_name), origins: [
            HwOrigin(node_id: HwNodeId.child(module_name, "literal-zero"),
                source_name: "hwir.typed-zero-owner.literal-default")],
        ports: ports, signals: [], constants: constants, comb_ops: ops,
        compare_ops: [], select_ops: [],
        clock_domains: [HwClockDomain.default_domain()])
    val shape_error = module.shape_diagnostic()
    if shape_error != "": return Err(shape_error)
    Ok(module)

pub fn strict_hw_typed_zero_owner(module_name: text, config: CoreConfig,
    requested_widths: [i32]) -> Result<HwModuleDef, text>:
    """Build one literal-zero output for every requested distinct width.

    Output names are deliberately derived only from their bit widths, e.g.
    `zero_1`, `zero_32`, and `zero_64`; duplicate requests fail rather than
    silently changing the public capability boundary.
    """
    var ports: [HwPort] = []
    for width in requested_widths:
        ports.push(HwPort.output(hw_typed_zero_owner_port_name(width), "Bits",
            width))
    typed_zero_owner_from_schema(module_name, config, ports)

pub fn strict_hw_typed_zero_owner_schema(module_name: text, config: CoreConfig,
    ports: [HwPort]) -> Result<HwModuleDef, text>:
    """Build from a predeclared exact `zero_<width>` public port schema."""
    typed_zero_owner_from_schema(module_name, config, ports)
