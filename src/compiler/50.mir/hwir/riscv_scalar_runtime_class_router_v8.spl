# Class-aware admission router for the flattened V8 runtime pipeline.
# V8 adds the stateful Zicsr owner at class six/tag three; all V6 routes stay frozen.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}

pub fn strict_riscv_scalar_runtime_class_router_v8(name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    if name == "": return Err("HWIR-E-RISCV-RUNTIME-CLASS-ROUTER-V8-ID: router requires a module name")
    val error = config.diagnostic(); if error != "": return Err(error)
    if config.isa_profile != "rv32i_zmmul_zicsr_zifencei" and
        config.isa_profile != "rv64i_zmmul_zicsr_zifencei":
        return Err("HWIR-E-RISCV-RUNTIME-CLASS-ROUTER-V8-SCOPE: V8 requires the combined Zmmul+Zicsr profile")
    val ports = [HwPort.input("uop_valid", "Bits", 1), HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("illegal_valid", "Bits", 1), HwPort.input("decoded_execution_class", "Bits", 3),
        HwPort.input("alu_ready", "Bits", 1), HwPort.input("control_ready", "Bits", 1),
        HwPort.input("system_ready", "Bits", 1), HwPort.input("illegal_ready", "Bits", 1),
        HwPort.input("pending_ready", "Bits", 1), HwPort.input("pending_busy", "Bits", 1),
        HwPort.input("sticky_fault", "Bits", 1),
        HwPort.output("alu_valid", "Bits", 1), HwPort.output("control_valid", "Bits", 1),
        HwPort.output("system_valid", "Bits", 1), HwPort.output("illegal_lane_valid", "Bits", 1),
        HwPort.output("pending_dispatch_valid", "Bits", 1),
        HwPort.output("pending_dispatch_tag", "Bits", 3), HwPort.output("uop_ready", "Bits", 1),
        HwPort.output("router_fault", "Bits", 1)]
    val signals = [HwSignal.comb("class_alu", "Bits", 1), HwSignal.comb("class_control", "Bits", 1),
        HwSignal.comb("class_lsu", "Bits", 1), HwSignal.comb("class_muldiv", "Bits", 1),
        HwSignal.comb("class_system", "Bits", 1), HwSignal.comb("class_csr", "Bits", 1),
        HwSignal.comb("class_fence", "Bits", 1), HwSignal.comb("legal_uop", "Bits", 1),
        HwSignal.comb("not_illegal", "Bits", 1), HwSignal.comb("legal_decode", "Bits", 1),
        HwSignal.comb("not_legal", "Bits", 1), HwSignal.comb("illegal_route", "Bits", 1),
        HwSignal.comb("decode_illegal_candidate", "Bits", 1),
        HwSignal.comb("decode_illegal_mismatch", "Bits", 1),
        HwSignal.comb("router_fault_base", "Bits", 1),
        HwSignal.comb("not_busy", "Bits", 1), HwSignal.comb("not_sticky_fault", "Bits", 1),
        HwSignal.comb("admission_enabled", "Bits", 1), HwSignal.comb("lsu_valid", "Bits", 1),
        HwSignal.comb("muldiv_valid", "Bits", 1), HwSignal.comb("csr_valid", "Bits", 1),
        HwSignal.comb("fence_valid", "Bits", 1), HwSignal.comb("pending_candidate_v6", "Bits", 1),
        HwSignal.comb("pending_candidate_v8", "Bits", 1), HwSignal.comb("pending_candidate", "Bits", 1),
        HwSignal.comb("alu_candidate", "Bits", 1), HwSignal.comb("control_candidate", "Bits", 1),
        HwSignal.comb("system_candidate", "Bits", 1), HwSignal.comb("illegal_candidate", "Bits", 1),
        HwSignal.comb("lsu_candidate", "Bits", 1), HwSignal.comb("muldiv_candidate", "Bits", 1),
        HwSignal.comb("csr_candidate", "Bits", 1), HwSignal.comb("fence_candidate", "Bits", 1),
        HwSignal.comb("alu_accept", "Bits", 1), HwSignal.comb("control_accept", "Bits", 1),
        HwSignal.comb("system_accept", "Bits", 1), HwSignal.comb("illegal_accept", "Bits", 1),
        HwSignal.comb("pending_accept", "Bits", 1), HwSignal.comb("ready_left", "Bits", 1),
        HwSignal.comb("ready_right", "Bits", 1), HwSignal.comb("ready_stateless", "Bits", 1),
        HwSignal.comb("ready_candidate", "Bits", 1), HwSignal.comb("known_left", "Bits", 1),
        HwSignal.comb("known_right", "Bits", 1), HwSignal.comb("known_four", "Bits", 1),
        HwSignal.comb("known_five", "Bits", 1), HwSignal.comb("known_six", "Bits", 1),
        HwSignal.comb("known_class", "Bits", 1), HwSignal.comb("unknown_legal", "Bits", 1)]
    val constants = [HwConstant.bits("one1", 1, 1), HwConstant.bits("class1", 3, 1),
        HwConstant.bits("class2", 3, 2), HwConstant.bits("class3", 3, 3), HwConstant.bits("class4", 3, 4),
        HwConstant.bits("class5", 3, 5), HwConstant.bits("class6", 3, 6), HwConstant.bits("class7", 3, 7),
        HwConstant.bits("tag_lsu", 3, 1), HwConstant.bits("tag_muldiv", 3, 2),
        HwConstant.bits("tag_csr", 3, 3), HwConstant.bits("tag_fence", 3, 4)]
    val ops = [HwCombOp.binary("eq", "class_alu", "decoded_execution_class", "class1", 3),
        HwCombOp.binary("eq", "class_control", "decoded_execution_class", "class2", 3),
        HwCombOp.binary("eq", "class_lsu", "decoded_execution_class", "class3", 3),
        HwCombOp.binary("eq", "class_muldiv", "decoded_execution_class", "class4", 3),
        HwCombOp.binary("eq", "class_system", "decoded_execution_class", "class5", 3),
        HwCombOp.binary("eq", "class_csr", "decoded_execution_class", "class6", 3),
        HwCombOp.binary("eq", "class_fence", "decoded_execution_class", "class7", 3),
        HwCombOp.binary("xor", "not_illegal", "illegal_valid", "one1", 1),
        HwCombOp.binary("and", "legal_decode", "decode_legal", "not_illegal", 1),
        HwCombOp.binary("and", "legal_uop", "uop_valid", "legal_decode", 1),
        HwCombOp.binary("xor", "not_legal", "decode_legal", "one1", 1),
        HwCombOp.unary("passthrough", "illegal_route", "illegal_valid", 1),
        HwCombOp.binary("and", "decode_illegal_candidate", "uop_valid", "not_legal", 1),
        HwCombOp.binary("xor", "not_busy", "pending_busy", "one1", 1),
        HwCombOp.binary("xor", "not_sticky_fault", "sticky_fault", "one1", 1),
        HwCombOp.binary("and", "admission_enabled", "not_busy", "not_sticky_fault", 1),
        HwCombOp.binary("and", "alu_candidate", "legal_uop", "class_alu", 1),
        HwCombOp.binary("and", "alu_valid", "alu_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "control_candidate", "legal_uop", "class_control", 1),
        HwCombOp.binary("and", "control_valid", "control_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "system_candidate", "legal_uop", "class_system", 1),
        HwCombOp.binary("and", "system_valid", "system_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "illegal_candidate", "uop_valid", "illegal_route", 1),
        HwCombOp.binary("and", "illegal_lane_valid", "illegal_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "lsu_candidate", "legal_uop", "class_lsu", 1),
        HwCombOp.binary("and", "lsu_valid", "lsu_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "muldiv_candidate", "legal_uop", "class_muldiv", 1),
        HwCombOp.binary("and", "muldiv_valid", "muldiv_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "csr_candidate", "legal_uop", "class_csr", 1),
        HwCombOp.binary("and", "csr_valid", "csr_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "fence_candidate", "legal_uop", "class_fence", 1),
        HwCombOp.binary("and", "fence_valid", "fence_candidate", "admission_enabled", 1),
        HwCombOp.binary("or", "pending_candidate_v6", "lsu_valid", "muldiv_valid", 1),
        HwCombOp.binary("or", "pending_candidate_v8", "pending_candidate_v6", "csr_valid", 1),
        HwCombOp.binary("or", "pending_candidate", "pending_candidate_v8", "fence_valid", 1),
        HwCombOp.binary("and", "pending_dispatch_valid", "pending_candidate", "admission_enabled", 1),
        HwCombOp.binary("and", "alu_accept", "alu_valid", "alu_ready", 1),
        HwCombOp.binary("and", "control_accept", "control_valid", "control_ready", 1),
        HwCombOp.binary("and", "system_accept", "system_valid", "system_ready", 1),
        HwCombOp.binary("and", "illegal_accept", "illegal_lane_valid", "illegal_ready", 1),
        HwCombOp.binary("and", "pending_accept", "pending_dispatch_valid", "pending_ready", 1),
        HwCombOp.binary("or", "ready_left", "alu_accept", "control_accept", 1),
        HwCombOp.binary("or", "ready_right", "system_accept", "illegal_accept", 1),
        HwCombOp.binary("or", "ready_stateless", "ready_left", "ready_right", 1),
        HwCombOp.binary("or", "ready_candidate", "ready_stateless", "pending_accept", 1),
        HwCombOp.binary("and", "uop_ready", "ready_candidate", "admission_enabled", 1),
        HwCombOp.binary("or", "known_left", "class_alu", "class_control", 1),
        HwCombOp.binary("or", "known_right", "class_lsu", "class_muldiv", 1),
        HwCombOp.binary("or", "known_four", "known_left", "known_right", 1),
        HwCombOp.binary("or", "known_five", "known_four", "class_system", 1),
        HwCombOp.binary("or", "known_six", "known_five", "class_csr", 1),
        HwCombOp.binary("or", "known_class", "known_six", "class_fence", 1),
        HwCombOp.binary("xor", "unknown_legal", "known_class", "one1", 1),
        HwCombOp.binary("and", "router_fault_base", "legal_uop", "unknown_legal", 1),
        HwCombOp.binary("and", "decode_illegal_mismatch", "decode_illegal_candidate", "not_illegal", 1),
        HwCombOp.binary("or", "router_fault", "router_fault_base", "decode_illegal_mismatch", 1)]
    val module = HwModuleDef(summary: HwModule(name: name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0, memory_count: 0,
            comb_op_count: ops.len(), clock_domain_count: 1, fallback_function: "", cost: HwCostModel.empty()),
        config: config, node_id: HwNodeId.module_root(name), origins: [HwOrigin(
            node_id: HwNodeId.child(name, "admission"), source_name: "riscv.scalar.runtime-pipeline.v8.class-router")],
        ports: ports, signals: signals, constants: constants, comb_ops: ops, compare_ops: [],
        select_ops: [HwSelectOp.mux("pending_tag_0", "class_muldiv", "tag_muldiv", "tag_lsu", 3),
            HwSelectOp.mux("pending_tag_1", "class_csr", "tag_csr", "pending_tag_0", 3),
            HwSelectOp.mux("pending_dispatch_tag", "class_fence", "tag_fence", "pending_tag_1", 3)],
        clock_domains: [HwClockDomain.default_domain()])
    val shape_error = module.shape_diagnostic(); if shape_error != "": return Err(shape_error)
    Ok(module)
