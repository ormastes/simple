# Explicit scalar LSU transport geometry.  This is product configuration,
# never inferred by the HWIR from XLEN or physical-address width.

pub class LsuConfig:
    bus_data_bits: i32
    byte_mask_bits: i32

    me diagnostic() -> text:
        if self.bus_data_bits != 32 and self.bus_data_bits != 64 and
            self.bus_data_bits != 128:
            return "HWIR-E-LSU-CONFIG-DATA: LSU bus data width must be an explicit 32, 64, or 128 bits"
        if self.byte_mask_bits != self.bus_data_bits / 8:
            return "HWIR-E-LSU-CONFIG-MASK: LSU byte-mask width must equal the explicit bus byte count"
        ""

    static fn explicit(bus_data_bits: i32, byte_mask_bits: i32) -> Result<LsuConfig, text>:
        val config = LsuConfig(bus_data_bits: bus_data_bits,
            byte_mask_bits: byte_mask_bits)
        val diagnostic = config.diagnostic()
        if diagnostic != "": return Err(diagnostic)
        Ok(config)

    static fn rv32_product_default() -> LsuConfig:
        # The value is explicit product policy, not derived from CoreConfig.
        LsuConfig(bus_data_bits: 32, byte_mask_bits: 4)

    static fn rv64_product_default() -> LsuConfig:
        # The value is explicit product policy, not derived from CoreConfig.
        LsuConfig(bus_data_bits: 64, byte_mask_bits: 8)
