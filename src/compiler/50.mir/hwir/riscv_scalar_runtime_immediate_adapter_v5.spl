# Canonical immediate-lane valid adapter for the direct-child runtime pipeline v5.

use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwConstant,
    HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSignal}

pub fn strict_riscv_scalar_runtime_immediate_adapter_v5(name: text,
    config: CoreConfig) -> Result<HwModuleDef, text>:
    if name == "":
        return Err("HWIR-E-RISCV-RUNTIME-IMMEDIATE-ADAPTER-V5-ID: adapter requires a module name")
    val error = config.diagnostic(); if error != "": return Err(error)
    val ports = [HwPort.input("alu_valid", "Bits", 1),
        HwPort.input("control_valid", "Bits", 1),
        HwPort.input("system_valid", "Bits", 1),
        HwPort.input("illegal_valid", "Bits", 1),
        HwPort.output("selector_uop_valid", "Bits", 1),
        HwPort.output("immediate_valid", "Bits", 1),
        HwPort.output("adapter_fault", "Bits", 1)]
    val signals = [HwSignal.comb("left_valid", "Bits", 1),
        HwSignal.comb("right_valid", "Bits", 1),
        HwSignal.comb("left_overlap", "Bits", 1),
        HwSignal.comb("right_overlap", "Bits", 1),
        HwSignal.comb("cross_left", "Bits", 1),
        HwSignal.comb("cross_right", "Bits", 1),
        HwSignal.comb("cross_overlap", "Bits", 1),
        HwSignal.comb("pair_overlap", "Bits", 1),
        HwSignal.comb("fault_any", "Bits", 1),
        HwSignal.comb("valid_candidate", "Bits", 1),
        HwSignal.comb("not_fault", "Bits", 1),
        HwSignal.comb("immediate_safe", "Bits", 1)]
    val ops = [HwCombOp.binary("or", "left_valid", "alu_valid", "control_valid", 1),
        HwCombOp.binary("or", "right_valid", "system_valid", "illegal_valid", 1),
        HwCombOp.binary("or", "valid_candidate", "left_valid", "right_valid", 1),
        HwCombOp.binary("and", "left_overlap", "alu_valid", "control_valid", 1),
        HwCombOp.binary("and", "right_overlap", "system_valid", "illegal_valid", 1),
        HwCombOp.binary("and", "cross_left", "left_valid", "system_valid", 1),
        HwCombOp.binary("and", "cross_right", "left_valid", "illegal_valid", 1),
        HwCombOp.binary("or", "cross_overlap", "cross_left", "cross_right", 1),
        HwCombOp.binary("or", "pair_overlap", "left_overlap", "right_overlap", 1),
        HwCombOp.binary("or", "fault_any", "pair_overlap", "cross_overlap", 1),
        HwCombOp.unary("passthrough", "adapter_fault", "fault_any", 1),
        HwCombOp.binary("xor", "not_fault", "fault_any", "one1", 1),
        HwCombOp.binary("and", "immediate_safe", "valid_candidate", "not_fault", 1),
        HwCombOp.unary("passthrough", "selector_uop_valid", "immediate_safe", 1),
        HwCombOp.unary("passthrough", "immediate_valid", "immediate_safe", 1)]
    val module = HwModuleDef(summary: HwModule(name: name, profile: config.profile,
            port_count: ports.len(), signal_count: signals.len(), register_count: 0,
            memory_count: 0, comb_op_count: ops.len(), clock_domain_count: 1,
            fallback_function: "", cost: HwCostModel.empty()), config: config,
        node_id: HwNodeId.module_root(name), origins: [HwOrigin(
            node_id: HwNodeId.child(name, "immediate-valid"),
            source_name: "riscv.scalar.runtime-pipeline.v5.immediate-valid-adapter")],
        ports: ports, signals: signals, constants: [HwConstant.bits("one1", 1, 1)], comb_ops: ops,
        compare_ops: [], select_ops: [], clock_domains: [HwClockDomain.default_domain()])
    val shape_error = module.shape_diagnostic(); if shape_error != "": return Err(shape_error)
    Ok(module)
