        scheduler_rules.push(HwSeqRule(name: "d32_iterate", guards: [HwSeqGuard.high("busy_reg"), HwSeqGuard.high("family_div_reg"), HwSeqGuard.high("word_reg"), HwSeqGuard.low("d32_count_done_value"), HwSeqGuard.low("fault_reg")], assignments: d32_iterate))
