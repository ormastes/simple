        selects.push(HwSelectOp.mux("div_count_done", "word_reg", "d32_count_done_value", "d64_count_done_value", 1))
        selects.push(HwSelectOp.mux("div_architectural_result", "word_reg", "d32_architectural_result", "d64_architectural_result", x))
    else:
        signals.push(HwSignal.comb("div_count_done", "Bits", 1)); signals.push(HwSignal.comb("d32_count_done_value", "Bits", 1))
        constants.push(HwConstant.bits("d32_count_done", 6, 32)); ops.push(HwCombOp.binary("eq", "d32_count_done_value", "d32_count_reg", "d32_count_done", 6))
        ops.push(HwCombOp.unary("passthrough", "div_count_done", "d32_count_done_value", 1)); ops.push(HwCombOp.unary("passthrough", "div_architectural_result", "d32_architectural_result", x))
    selects.push(HwSelectOp.mux("count_done", "family_div_reg", "div_count_done", "count_last_value", 1))
    selects.push(HwSelectOp.mux("architectural_result", "family_div_reg", "div_architectural_result", "mul_architectural_result", x))
