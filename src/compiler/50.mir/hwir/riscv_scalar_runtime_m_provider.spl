# Flat, plan-bound RV32IM/RV64IM multiply/divide provider.
#
# This owner accepts every declarative multiply row dynamically.  Its shift/add
# body always forms the unsigned full product; completion applies the RISC-V
# signed-high corrections and the RV64 MULW sign extension.  A separately
# named restoring divider state is inlined below.  This is one sequential
# owner: it has no provider child or wrapper boundary.

use compiler.mir.hwir.types.{CoreConfig, HwBitExtractOp, HwCombOp, HwConstant,
    HwFixedSliceOp, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.sequential.{HwSeqAssignment, HwSeqGuard,
    HwSeqOutputBinding, HwSeqRule, HwSeqValue, HwSequentialModuleDef,
    HwSequentialPlan, HwStateRegister}
use compiler.mir.hwir.bit_vector_constant.{HwBitVectorConstant}
use compiler.mir.hwir.riscv_scalar_runtime_div_admission.{
    strict_riscv_scalar_runtime_div_admission}
use compiler.mir.hwir.riscv_scalar_runtime_div_normalizer.{
    strict_riscv_scalar_runtime_div_normalizer}
use compiler.mir.hwir.riscv_scalar_runtime_restoring_divider_datapath.{
    strict_riscv_scalar_runtime_restoring_divider_datapath}
use lib.hardware.riscv_common.isa.scalar_database.{RiscvScalarDecoderPlan,
    riscv_scalar_semantic_opcode}

fn m_provider_external(name: text) -> bool:
    name == "rs1_value" or name == "rs2_value" or name == "canonical_instruction" or
        name == "decoded_row_index" or name == "decoded_semantic_opcode" or
        name == "decoded_declared_operand_width_is_32"

fn m_provider_name(prefix: text, name: text) -> text:
    if name == "rs1_value": return "effective_rs1"
    if name == "rs2_value": return "effective_rs2"
    if m_provider_external(name): name else: prefix + "_" + name

fn m_provider_datapath_name(prefix: text, name: text) -> text:
    if name == "select_remainder": return prefix + "_select_remainder_reg"
    if name == "word_result_mode": return prefix + "_word_result_mode_reg"
    prefix + "_" + name

# The normalizer and restoring datapath intentionally share selected state
# names (for example `d32_dividend_reg`), but both leaf graphs also declare
# generic constants such as `zero_operand`.  Keep those leaf-local constants
# distinct when inlining them into one flat owner.
fn m_provider_datapath_value_name(prefix: text, name: text) -> text:
    if name == "zero_remainder" or name == "one_remainder" or
        name == "zero_operand" or name == "one_operand" or
        name == "all_ones_operand" or name == "minimum_operand" or
        name == "special_divzero" or name == "special_overflow":
        return prefix + "_dp_" + name
    m_provider_datapath_name(prefix, name)

fn m_provider_clone_normalizer(prefix: text, normalizer, signals: [HwSignal],
    constants: [HwBitVectorConstant], ops: [HwCombOp], selects: [HwSelectOp],
    extracts: [HwBitExtractOp]) -> ():
    for signal in normalizer.signals: signals.push(HwSignal.comb(m_provider_name(prefix, signal.name), "Bits", signal.bit_width))
    for constant in normalizer.constants: constants.push(HwBitVectorConstant.binary(m_provider_name(prefix, constant.name), constant.bit_width, constant.canonical_bits))
    for op in normalizer.comb_ops:
        ops.push(HwCombOp(op: op.op, result: m_provider_name(prefix, op.result), lhs: m_provider_name(prefix, op.lhs), rhs: if op.rhs == "": "" else: m_provider_name(prefix, op.rhs), bit_width: op.bit_width))
    for op in normalizer.select_ops:
        selects.push(HwSelectOp.mux(m_provider_name(prefix, op.result), m_provider_name(prefix, op.condition), m_provider_name(prefix, op.when_true), m_provider_name(prefix, op.when_false), op.bit_width))
    for op in normalizer.bit_extract_ops:
        extracts.push(HwBitExtractOp.fixed(m_provider_name(prefix, op.result), m_provider_name(prefix, op.source), op.bit_index))

fn m_provider_clone_datapath(prefix: text, datapath, signals: [HwSignal],
    constants: [HwBitVectorConstant], ops: [HwCombOp], selects: [HwSelectOp],
    extracts: [HwBitExtractOp], slices: [HwFixedSliceOp]) -> ():
    for signal in datapath.signals: signals.push(HwSignal.comb(m_provider_datapath_name(prefix, signal.name), "Bits", signal.bit_width))
    for constant in datapath.constants: constants.push(HwBitVectorConstant.binary(m_provider_datapath_value_name(prefix, constant.name), constant.bit_width, constant.canonical_bits))
    for op in datapath.comb_ops:
        ops.push(HwCombOp(op: op.op, result: m_provider_datapath_value_name(prefix, op.result), lhs: m_provider_datapath_value_name(prefix, op.lhs), rhs: if op.rhs == "": "" else: m_provider_datapath_value_name(prefix, op.rhs), bit_width: op.bit_width))
    for op in datapath.select_ops:
        selects.push(HwSelectOp.mux(m_provider_datapath_value_name(prefix, op.result), m_provider_datapath_value_name(prefix, op.condition), m_provider_datapath_value_name(prefix, op.when_true), m_provider_datapath_value_name(prefix, op.when_false), op.bit_width))
    for op in datapath.bit_extract_ops: extracts.push(HwBitExtractOp.fixed(m_provider_datapath_value_name(prefix, op.result), m_provider_datapath_value_name(prefix, op.source), op.bit_index))
    for op in datapath.fixed_slice_ops: slices.push(HwFixedSliceOp.fixed(m_provider_datapath_value_name(prefix, op.result), m_provider_datapath_value_name(prefix, op.source), op.high_bit, op.low_bit))

fn muldiv_row_width(count: i32) -> i32:
    var width = 1; var capacity = 2
    while capacity <= count:
        width = width + 1; capacity = capacity * 2
    width

fn completion_rows(x: i32) -> [(text, i32)]:
    [("privilege", 2), ("original_instruction", 32), ("canonical_instruction", 32),
        ("instruction_length_bytes", 3), ("pc_before", x), ("pc_after", x),
        ("rd", 5), ("rd_write", 1), ("rd_value", x), ("memory_address", x),
        ("memory_read_mask", 32), ("memory_write_mask", 32),
        ("memory_read_data", x), ("memory_write_data", x),
        ("execute_trap_valid", 1), ("execute_trap_cause", x),
        ("execute_trap_tval", x), ("memory_trap_valid", 1),
        ("memory_trap_cause", x), ("memory_trap_tval", x),
        ("redirect_valid", 1), ("redirect_target", x),
        ("provider_event_id", 64), ("decode_event_id", 64), ("illegal_valid", 1)]

fn ports(x: i32, row_width: i32) -> [HwPort]:
    var result = [HwPort.input("clk", "Bits", 1), HwPort.input("rst", "Bits", 1),
        HwPort.input("request_valid", "Bits", 1),
        HwPort.input("request_provider_tag", "Bits", 3),
        HwPort.input("decode_legal", "Bits", 1),
        HwPort.input("decoded_row_index", "Bits", row_width),
        HwPort.input("decoded_execution_class", "Bits", 3),
        HwPort.input("decoded_memory_effect", "Bits", 3),
        HwPort.input("decoded_semantic_opcode", "Bits", 6),
        HwPort.input("decoded_declared_operand_width_is_32", "Bits", 1),
        HwPort.input("canonical_instruction", "Bits", 32),
        HwPort.input("original_instruction", "Bits", 32),
        HwPort.input("instruction_length_bytes", "Bits", 3),
        HwPort.input("instruction_rd_field", "Bits", 5),
        HwPort.input("instruction_rs1_field", "Bits", 5),
        HwPort.input("instruction_rs2_field", "Bits", 5),
        HwPort.input("rs1_value", "Bits", x), HwPort.input("rs2_value", "Bits", x),
        HwPort.input("pc_before", "Bits", x), HwPort.input("fallthrough_pc", "Bits", x),
        HwPort.input("privilege", "Bits", 2), HwPort.input("provider_event_id", "Bits", 64),
        HwPort.input("decode_event_id", "Bits", 64), HwPort.input("lineage_valid", "Bits", 1),
        HwPort.input("illegal_valid", "Bits", 1), HwPort.input("completion_ready", "Bits", 1),
        HwPort.output("request_ready", "Bits", 1), HwPort.output("request_accept", "Bits", 1),
        HwPort.output("completion_valid", "Bits", 1),
        HwPort.output("completion_provider_tag", "Bits", 3),
        HwPort.output("provider_protocol_fault", "Bits", 1)]
    for row in completion_rows(x): result.push(HwPort.output("completion_" + row[0], "Bits", row[1]))
    result

fn registers(x: i32) -> [HwStateRegister]:
    var result = [HwStateRegister(name: "busy_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "full_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "fault_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "count_reg", bit_width: 7, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "acc_reg", bit_width: x * 2, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "multiplicand_reg", bit_width: x * 2, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "multiplier_reg", bit_width: x, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "lhs_reg", bit_width: x, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "rhs_reg", bit_width: x, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "operation_reg", bit_width: 3, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "family_div_reg", bit_width: 1, clock_domain: "default", reset_value: 0),
        HwStateRegister(name: "word_reg", bit_width: 1, clock_domain: "default", reset_value: 0)]
    # The divider geometries are deliberately independent.  RV64 has d64 for
    # XLEN operations and d32 for the W forms; RV32 only owns d32.
    for prefix in if x == 64: ["d64", "d32"] else: ["d32"]:
        val width = if prefix == "d64": 64 else: 32; val rem = width + 1
        val count_width = if width == 64: 7 else: 6
        for field in [("dividend_reg", width), ("divisor_reg", rem), ("remainder_reg", rem),
            ("quotient_reg", width), ("original_dividend_reg", width), ("result_negate_reg", 1),
            ("remainder_negate_reg", 1), ("select_remainder_reg", 1), ("special_reg", 2),
            ("word_result_mode_reg", 1), ("count_reg", count_width)]:
            result.push(HwStateRegister(name: prefix + "_" + field[0], bit_width: field[1], clock_domain: "default", reset_value: 0))
    for row in completion_rows(x):
        result.push(HwStateRegister(name: "completion_" + row[0] + "_reg", bit_width: row[1], clock_domain: "default", reset_value: 0))
    result

fn clear_completion(x: i32) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "full_reg", value: HwSeqValue.zero(1))]
    for row in completion_rows(x): result.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.zero(row[1])))
    result

fn capture_common_request(x: i32) -> [HwSeqAssignment]:
    var result = [HwSeqAssignment(destination: "busy_reg", value: HwSeqValue.copy("one1", 1)),
        HwSeqAssignment(destination: "lhs_reg", value: HwSeqValue.copy("capture_lhs", x)),
        HwSeqAssignment(destination: "rhs_reg", value: HwSeqValue.copy("capture_rhs", x)),
        HwSeqAssignment(destination: "operation_reg", value: HwSeqValue.copy("request_operation", 3))]
    for row in completion_rows(x):
        var source = if row[0] == "pc_after": "fallthrough_pc" elif row[0] == "rd": "instruction_rd_field" elif row[0] == "rd_write": "rd_nonzero" elif row[0] == "provider_event_id": "provider_event_id" elif row[0] == "decode_event_id": "decode_event_id" elif row[0] == "rd_value": "zero_xlen" elif row[0] == "privilege" or row[0] == "original_instruction" or row[0] == "canonical_instruction" or row[0] == "instruction_length_bytes" or row[0] == "pc_before" or row[0] == "illegal_valid": row[0] else: if row[1] == x: "zero_xlen" elif row[1] == 32: "zero32" else: "zero1"
        result.push(HwSeqAssignment(destination: "completion_" + row[0] + "_reg", value: HwSeqValue.copy(source, row[1])))
    result

fn capture_multiply_request(x: i32) -> [HwSeqAssignment]:
    var result = capture_common_request(x)
    result.push(HwSeqAssignment(destination: "family_div_reg", value: HwSeqValue.zero(1)))
    result.push(HwSeqAssignment(destination: "word_reg", value: HwSeqValue.copy("decoded_declared_operand_width_is_32", 1)))
    result.push(HwSeqAssignment(destination: "count_reg", value: HwSeqValue.zero(7)))
    result.push(HwSeqAssignment(destination: "acc_reg", value: HwSeqValue.zero(x * 2)))
    result.push(HwSeqAssignment(destination: "multiplicand_reg", value: HwSeqValue.copy("capture_lhs_wide", x * 2)))
    result.push(HwSeqAssignment(destination: "multiplier_reg", value: HwSeqValue.copy("capture_rhs", x)))
    result

pub fn strict_riscv_scalar_runtime_m_provider(module_name: text,
    config: CoreConfig, plan: RiscvScalarDecoderPlan) -> Result<HwSequentialModuleDef, text>:
    if module_name == "": return Err("HWIR-E-RISCV-RUNTIME-M-ID: runtime M provider requires a module name")
    val config_error = config.diagnostic(); if config_error != "": return Err(config_error)
    val plan_error = plan.diagnostic(); if plan_error != "": return Err(plan_error)
    if config.compressed_decode_profile != "none": return Err("HWIR-E-RISCV-RUNTIME-M-COMPRESSED: v7 requires canonical four-byte instructions")
    if config.xlen as u32 != plan.xlen or config.isa_profile != plan.isa_profile: return Err("HWIR-E-RISCV-RUNTIME-M-CONFIG: provider requires its exact decoder plan")
    if config.isa_profile != "rv32im" and config.isa_profile != "rv64im" and config.isa_profile != "rv32im_zicsr_zifencei" and config.isa_profile != "rv64im_zicsr_zifencei": return Err("HWIR-E-RISCV-RUNTIME-M-SCOPE: unified provider accepts only canonical IM products")
    # DIV admission freezes exact IM plan provenance and all eight/non-W DIV rows.
    val div_admission = strict_riscv_scalar_runtime_div_admission(config, plan)?
    val x = config.xlen; val wide = x * 2; val row_width = muldiv_row_width(plan.entries.len())
    var constants = [HwConstant.bits("zero1", 1, 0), HwConstant.bits("one1", 1, 1),
        HwConstant.bits("zero3", 3, 0), HwConstant.bits("zero5", 5, 0),
        HwConstant.bits("zero32", 32, 0), HwConstant.bits("zero_xlen", x, 0),
        HwConstant.bits("zero_effect", 3, 0),
        HwConstant.bits("tag_muldiv", 3, 2), HwConstant.bits("class_muldiv", 3, 4),
        HwConstant.bits("op_mul", 3, 0), HwConstant.bits("op_mulh", 3, 1),
        HwConstant.bits("op_mulhsu", 3, 2), HwConstant.bits("op_mulhu", 3, 3),
        HwConstant.bits("op_mulw", 3, 4),
        HwConstant.bits("length4", 3, 4), HwConstant.bits("count_last", 7, x - 1),
        HwConstant.bits("four_xlen", x, 4),
        HwConstant.bits("shift7", 32, 7), HwConstant.bits("shift15", 32, 15),
        HwConstant.bits("shift20", 32, 20),
        HwConstant.bits("one_wide", wide, 1), HwConstant.bits("one_xlen", x, 1)]
    var bit_constants: [HwBitVectorConstant] = []
    var signals = [HwSignal.comb("tag_ok", "Bits", 1), HwSignal.comb("idle_a", "Bits", 1),
        HwSignal.comb("idle_b", "Bits", 1), HwSignal.comb("idle_pre", "Bits", 1),
        HwSignal.comb("not_fault", "Bits", 1), HwSignal.comb("idle", "Bits", 1),
        HwSignal.comb("request_handshake", "Bits", 1), HwSignal.comb("class_ok", "Bits", 1),
        HwSignal.comb("effect_ok", "Bits", 1), HwSignal.comb("length_ok", "Bits", 1),
        HwSignal.comb("raw_ok", "Bits", 1), HwSignal.comb("events_ok", "Bits", 1),
        HwSignal.comb("fallthrough_expected", "Bits", x), HwSignal.comb("fallthrough_ok", "Bits", 1),
        HwSignal.comb("legal_ok", "Bits", 1), HwSignal.comb("rd_shift", "Bits", 32),
        HwSignal.comb("rs1_shift", "Bits", 32), HwSignal.comb("rs2_shift", "Bits", 32),
        HwSignal.comb("canonical_rd", "Bits", 5), HwSignal.comb("canonical_rs1", "Bits", 5),
        HwSignal.comb("canonical_rs2", "Bits", 5), HwSignal.comb("rd_ok", "Bits", 1),
        HwSignal.comb("rs1_ok", "Bits", 1), HwSignal.comb("rs2_ok", "Bits", 1),
        HwSignal.comb("fields_a", "Bits", 1), HwSignal.comb("fields_ok", "Bits", 1),
        HwSignal.comb("rs1_nonzero", "Bits", 1), HwSignal.comb("rs2_nonzero", "Bits", 1),
        HwSignal.comb("effective_rs1", "Bits", x), HwSignal.comb("effective_rs2", "Bits", x),
        HwSignal.comb("base_a", "Bits", 1),
        HwSignal.comb("base_b", "Bits", 1), HwSignal.comb("base_c", "Bits", 1),
        HwSignal.comb("base_d", "Bits", 1), HwSignal.comb("base_pre", "Bits", 1),
        HwSignal.comb("base_mid", "Bits", 1), HwSignal.comb("base_ok", "Bits", 1),
        HwSignal.comb("base_extra", "Bits", 1),
        HwSignal.comb("base_valid", "Bits", 1),
        HwSignal.comb("selected_any", "Bits", 1), HwSignal.comb("selection_missing", "Bits", 1),
        HwSignal.comb("fault_any", "Bits", 1), HwSignal.comb("rd_nonzero", "Bits", 1),
        HwSignal.comb("rs1_word", "Bits", 32), HwSignal.comb("rs2_word", "Bits", 32),
        HwSignal.comb("rs1_word_xlen", "Bits", x), HwSignal.comb("rs2_word_xlen", "Bits", x),
        HwSignal.comb("capture_lhs", "Bits", x), HwSignal.comb("capture_rhs", "Bits", x),
        HwSignal.comb("capture_lhs_wide", "Bits", wide), HwSignal.comb("request_operation", "Bits", 3),
        HwSignal.comb("request_family_div", "Bits", 1),
        HwSignal.comb("request_is_mulw", "Bits", 1),
        HwSignal.comb("multiplier_lsb", "Bits", 1),
        HwSignal.comb("acc_added", "Bits", wide), HwSignal.comb("acc_next", "Bits", wide),
        HwSignal.comb("multiplicand_next", "Bits", wide), HwSignal.comb("multiplier_next", "Bits", x),
        HwSignal.comb("count_last_value", "Bits", 1), HwSignal.comb("product_low", "Bits", x),
        HwSignal.comb("product_high", "Bits", x), HwSignal.comb("product_low_word", "Bits", 32),
        HwSignal.comb("word_result", "Bits", x), HwSignal.comb("lhs_sign", "Bits", 1),
        HwSignal.comb("rhs_sign", "Bits", 1), HwSignal.comb("op_is_mulh", "Bits", 1),
        HwSignal.comb("op_is_mulhsu", "Bits", 1), HwSignal.comb("op_is_mulhu", "Bits", 1),
        HwSignal.comb("op_is_mulw", "Bits", 1),
        HwSignal.comb("lhs_signed_op", "Bits", 1), HwSignal.comb("rhs_signed_op", "Bits", 1),
        HwSignal.comb("lhs_negative", "Bits", 1), HwSignal.comb("rhs_negative", "Bits", 1),
        HwSignal.comb("high_lhs_adjust", "Bits", x), HwSignal.comb("high_rhs_adjust", "Bits", x),
        HwSignal.comb("high_after_lhs", "Bits", x), HwSignal.comb("high_corrected", "Bits", x),
        HwSignal.comb("high_operation_a", "Bits", 1), HwSignal.comb("high_operation", "Bits", 1),
        HwSignal.comb("nonword_result", "Bits", x),
        HwSignal.comb("mul_architectural_result", "Bits", x),
        HwSignal.comb("div_architectural_result", "Bits", x),
        HwSignal.comb("count_done", "Bits", 1),
        HwSignal.comb("architectural_result", "Bits", x)]
    var ops = [HwCombOp.binary("eq", "tag_ok", "request_provider_tag", "tag_muldiv", 3),
        HwCombOp.binary("eq", "idle_a", "busy_reg", "zero1", 1), HwCombOp.binary("eq", "idle_b", "full_reg", "zero1", 1),
        HwCombOp.binary("and", "idle_pre", "idle_a", "idle_b", 1),
        HwCombOp.binary("eq", "not_fault", "fault_reg", "zero1", 1),
        HwCombOp.binary("and", "idle", "idle_pre", "not_fault", 1),
        HwCombOp.binary("and", "request_handshake", "request_valid", "idle", 1),
        HwCombOp.binary("eq", "class_ok", "decoded_execution_class", "class_muldiv", 3),
        HwCombOp.binary("eq", "effect_ok", "decoded_memory_effect", "zero_effect", 3),
        HwCombOp.binary("eq", "length_ok", "instruction_length_bytes", "length4", 3),
        HwCombOp.binary("eq", "raw_ok", "original_instruction", "canonical_instruction", 32),
        HwCombOp.binary("eq", "events_ok", "provider_event_id", "decode_event_id", 64),
        HwCombOp.binary("add", "fallthrough_expected", "pc_before", "four_xlen", x),
        HwCombOp.binary("eq", "fallthrough_ok", "fallthrough_pc", "fallthrough_expected", x),
        HwCombOp.binary("eq", "legal_ok", "illegal_valid", "zero1", 1),
        HwCombOp.binary("shr", "rd_shift", "canonical_instruction", "shift7", 32),
        HwCombOp.binary("shr", "rs1_shift", "canonical_instruction", "shift15", 32),
        HwCombOp.binary("shr", "rs2_shift", "canonical_instruction", "shift20", 32),
        HwCombOp.unary("trunc", "canonical_rd", "rd_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs1", "rs1_shift", 5),
        HwCombOp.unary("trunc", "canonical_rs2", "rs2_shift", 5),
        HwCombOp.binary("eq", "rd_ok", "canonical_rd", "instruction_rd_field", 5),
        HwCombOp.binary("eq", "rs1_ok", "canonical_rs1", "instruction_rs1_field", 5),
        HwCombOp.binary("eq", "rs2_ok", "canonical_rs2", "instruction_rs2_field", 5),
        HwCombOp.binary("and", "fields_a", "rd_ok", "rs1_ok", 1),
        HwCombOp.binary("and", "fields_ok", "fields_a", "rs2_ok", 1),
        HwCombOp.binary("ne", "rs1_nonzero", "canonical_rs1", "zero5", 5),
        HwCombOp.binary("ne", "rs2_nonzero", "canonical_rs2", "zero5", 5),
        HwCombOp.binary("and", "base_a", "decode_legal", "class_ok", 1),
        HwCombOp.binary("and", "base_b", "effect_ok", "length_ok", 1),
        HwCombOp.binary("and", "base_c", "raw_ok", "events_ok", 1),
        HwCombOp.binary("and", "base_d", "lineage_valid", "legal_ok", 1),
        HwCombOp.binary("and", "base_pre", "base_a", "base_b", 1),
        HwCombOp.binary("and", "base_mid", "base_c", "base_d", 1),
        HwCombOp.binary("and", "base_ok", "base_pre", "base_mid", 1),
        HwCombOp.binary("and", "base_extra", "fields_ok", "fallthrough_ok", 1),
        HwCombOp.unary("trunc", "rs1_word", "effective_rs1", 32),
        HwCombOp.unary("trunc", "rs2_word", "effective_rs2", 32),
        HwCombOp.unary("zext", "rs1_word_xlen", "rs1_word", x),
        HwCombOp.unary("zext", "rs2_word_xlen", "rs2_word", x),
        HwCombOp.unary("zext", "capture_lhs_wide", "capture_lhs", wide),
        HwCombOp.binary("and", "base_valid", "base_ok", "base_extra", 1),
        HwCombOp.binary("ne", "rd_nonzero", "instruction_rd_field", "zero5", 5),
        HwCombOp.binary("add", "acc_added", "acc_reg", "multiplicand_reg", wide),
        HwCombOp.binary("shl", "multiplicand_next", "multiplicand_reg", "one_wide", wide),
        HwCombOp.binary("shr", "multiplier_next", "multiplier_reg", "one_xlen", x),
        HwCombOp.binary("eq", "count_last_value", "count_reg", "count_last", 7),
        HwCombOp.unary("trunc", "product_low", "acc_next", x),
