        scheduler_rules.push(HwSeqRule(name: "d64_iterate", guards: [HwSeqGuard.high("busy_reg"), HwSeqGuard.high("family_div_reg"), HwSeqGuard.low("word_reg"), HwSeqGuard.low("d64_count_done_value"), HwSeqGuard.low("fault_reg")], assignments: d64_iterate))
