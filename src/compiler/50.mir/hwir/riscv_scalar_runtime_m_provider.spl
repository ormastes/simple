            ("word_result_mode_reg", "word_result_mode", 1)]:
            val source = if field[1] == "zero_remainder": prefix + "_dp_" + field[1] else: prefix + "_" + field[1]
            divider_capture.push(HwSeqAssignment(destination: prefix + "_" + field[0], value: HwSeqValue.copy(source, field[2])))
        val zero_count = "zero_div_count_" + prefix
        constants.push(HwConstant.bits(zero_count, count_width, 0))
        divider_capture.push(HwSeqAssignment(destination: prefix + "_count_reg", value: HwSeqValue.copy(zero_count, count_width)))
