    var d32_iterate: [HwSeqAssignment] = []
    for field in [("remainder_reg", "remainder_next", 33), ("quotient_reg", "quotient_next", 32), ("dividend_reg", "dividend_next", 32)]: d32_iterate.push(HwSeqAssignment(destination: "d32_" + field[0], value: HwSeqValue.copy("d32_" + field[1], field[2])))
