    val full = [HwSeqGuard.high("full_reg"), HwSeqGuard.low("fault_reg")]
    var outputs = [HwSeqOutputBinding.all("request_ready", idle), HwSeqOutputBinding.all("request_accept", [HwSeqGuard.high("request_valid"), HwSeqGuard.high("tag_ok"), HwSeqGuard.low("busy_reg"), HwSeqGuard.low("full_reg"), HwSeqGuard.low("fault_reg")]), HwSeqOutputBinding.all("completion_valid", full), HwSeqOutputBinding.guarded("completion_provider_tag", "tag_muldiv", 3, full), HwSeqOutputBinding.direct("provider_protocol_fault", "fault_reg", 1)]
    for row in completion_rows(x): outputs.push(HwSeqOutputBinding.guarded("completion_" + row[0], "completion_" + row[0] + "_reg", row[1], full))
