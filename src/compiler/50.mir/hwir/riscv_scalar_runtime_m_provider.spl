    var capture_mul = capture_multiply_request(x)
    var capture_d32 = capture_common_request(x)
    var capture_d64: [HwSeqAssignment] = []
    for prefix in if x == 64: ["d64", "d32"] else: ["d32"]:
        val width = if prefix == "d64": 64 else: 32; val rem = width + 1; val count_width = if width == 64: 7 else: 6
        var divider_capture = capture_common_request(x)
        divider_capture.push(HwSeqAssignment(destination: "family_div_reg", value: HwSeqValue.copy("one1", 1)))
        divider_capture.push(HwSeqAssignment(destination: "word_reg", value: HwSeqValue.copy(if prefix == "d32" and x == 64: "one1" else: "zero1", 1)))
        for field in [("dividend_reg", "lhs_magnitude", width), ("remainder_reg", "zero_remainder", rem),
