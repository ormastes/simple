    var selected = "zero1"; var selected_operation = "op_mul"; var selected_family = "zero1"; var row_index = 0; var admitted = 0
    for entry in plan.entries:
        if entry.id == "rv.m.mul" or entry.id == "rv.m.mulh" or entry.id == "rv.m.mulhsu" or entry.id == "rv.m.mulhu" or entry.id == "rv64.m.mulw" or
            entry.id == "rv.m.div" or entry.id == "rv.m.divu" or entry.id == "rv.m.rem" or entry.id == "rv.m.remu" or entry.id == "rv64.m.divw" or entry.id == "rv64.m.divuw" or entry.id == "rv64.m.remw" or entry.id == "rv64.m.remuw":
            val suffix = admitted.to_text(); val mask = "mask_" + suffix; val value = "value_" + suffix
            val opcode = "opcode_" + suffix; val row = "row_" + suffix; val masked = "masked_" + suffix
            val form = "form_" + suffix; val semantic = "semantic_" + suffix; val row_match = "row_match_" + suffix
            val width_match = "width_match_" + suffix; val candidate_a = "candidate_a_" + suffix; val candidate_b = "candidate_b_" + suffix; val candidate_c = "candidate_c_" + suffix; val accepted = "accepted_" + suffix
            val selected_name = "selected_" + suffix; val operation_name = "operation_" + suffix; val family_name = "family_" + suffix
            val operation = if entry.id == "rv.m.mulh": "op_mulh" elif entry.id == "rv.m.mulhsu": "op_mulhsu" elif entry.id == "rv.m.mulhu": "op_mulhu" elif entry.id == "rv64.m.mulw": "op_mulw" else: "op_mul"
            val div_family = entry.id == "rv.m.div" or entry.id == "rv.m.divu" or entry.id == "rv.m.rem" or entry.id == "rv.m.remu" or entry.id.starts_with("rv64.m.div") or entry.id.starts_with("rv64.m.rem")
            val expected_width = if entry.id == "rv64.m.mulw" or entry.id.starts_with("rv64.m.div") or entry.id.starts_with("rv64.m.rem"): "one1" else: "zero1"
            for signal in [(masked, 32), (form, 1), (semantic, 1), (row_match, 1), (width_match, 1), (candidate_a, 1), (candidate_b, 1), (candidate_c, 1), (accepted, 1), (selected_name, 1), (operation_name, 3), (family_name, 1)]: signals.push(HwSignal.comb(signal[0], "Bits", signal[1]))
            constants.push(HwConstant.bits(mask, 32, entry.encoding_mask as i64)); constants.push(HwConstant.bits(value, 32, entry.encoding_value as i64))
            constants.push(HwConstant.bits(opcode, 6, riscv_scalar_semantic_opcode(entry.semantic_operation))); constants.push(HwConstant.bits(row, row_width, (row_index + 1) as i64))
            ops.push(HwCombOp.binary("and", masked, "canonical_instruction", mask, 32)); ops.push(HwCombOp.binary("eq", form, masked, value, 32))
            ops.push(HwCombOp.binary("eq", semantic, "decoded_semantic_opcode", opcode, 6)); ops.push(HwCombOp.binary("eq", row_match, "decoded_row_index", row, row_width))
            ops.push(HwCombOp.binary("eq", width_match, "decoded_declared_operand_width_is_32", expected_width, 1))
            ops.push(HwCombOp.binary("and", candidate_a, form, semantic, 1)); ops.push(HwCombOp.binary("and", candidate_b, candidate_a, row_match, 1))
            ops.push(HwCombOp.binary("and", candidate_c, candidate_b, "base_valid", 1)); ops.push(HwCombOp.binary("and", accepted, candidate_c, width_match, 1)); selects.push(HwSelectOp.mux(selected_name, accepted, "one1", selected, 1)); selects.push(HwSelectOp.mux(operation_name, accepted, operation, selected_operation, 3)); selects.push(HwSelectOp.mux(family_name, accepted, if div_family: "one1" else: "zero1", selected_family, 1)); selected = selected_name; selected_operation = operation_name; selected_family = family_name; admitted = admitted + 1
            origins.push(HwOrigin(node_id: HwNodeId.child(module_name, "row." + entry.id), source_name: entry.id))
        row_index = row_index + 1
    val expected_rows = if x == 64: 13 else: 8
    if admitted != expected_rows: return Err("HWIR-E-RISCV-RUNTIME-M-SCOPE: unified provider requires every concrete M row")
    ops.push(HwCombOp.unary("passthrough", "selected_any", selected, 1)); ops.push(HwCombOp.binary("eq", "selection_missing", "selected_any", "zero1", 1))
    ops.push(HwCombOp.unary("passthrough", "request_operation", selected_operation, 3)); ops.push(HwCombOp.unary("passthrough", "request_family_div", selected_family, 1)); ops.push(HwCombOp.binary("eq", "request_is_mulw", "request_operation", "op_mulw", 3))
    signals.push(HwSignal.comb("malformed_request", "Bits", 1))
    ops.push(HwCombOp.binary("and", "malformed_request", "request_handshake", "selection_missing", 1))
    ops.push(HwCombOp.binary("and", "fault_any", "malformed_request", "tag_ok", 1))
