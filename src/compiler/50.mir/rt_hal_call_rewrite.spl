# Closed compile-time @rt(hal) direct-call rewrite.
#
# MIR direct-call operands already carry the semantic resolver's selected
# callee. Normal mode substitutes the fixed provider ABI inside the tagged
# wrapper, retaining its surrounding validation and panic behavior. Compare
# mode binds to a zero-argument leaf backed by an immutable @init_phase owner.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_data.{MirFunction}
use compiler.mir.mir_types.{MirConstValue}
use compiler.common.hal.rt_hal_static_binding.*
use compiler.mir.rt_hal_call_abi_proof.{
    rt_hal_call_operand_signature_key_v1,
    rt_hal_call_operand_parameter_count_v1}

enum RtHalCallModeV1:
    NormalDirect
    SealedCompare

struct RtHalCallRewriteResultV1:
    function: MirFunction
    operation: text
    raw_symbol: text
    selected_symbol: text
    rewritten_calls: i64
    diagnostic: text

fn _rt_hal_rewrite_call_operand_v1(
        operand: MirOperand, raw_symbol: text,
        selected_symbol: text) -> (MirOperand, bool):
    match operand.kind:
        case MirOperandKind.Const(MirConstValue.Str(name), type_):
            if name == raw_symbol:
                return (MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(selected_symbol), type_)), true)
        case _: ()
    (operand, false)

fn rt_hal_rewrite_function_calls_v1(
        function: MirFunction, manifest: text,
        mode: RtHalCallModeV1) -> RtHalCallRewriteResultV1:
    val operation = rt_hal_manifest_operation_v1(manifest)
    val binding = rt_hal_static_binding_v1(operation)
    if not binding.known:
        return RtHalCallRewriteResultV1(function, operation, "", "", 0,
            binding.diagnostic)
    if rt_hal_binding_requires_device_execution_route_v1(binding):
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, "", 0, binding.diagnostic)
    if (mode == RtHalCallModeV1.NormalDirect
            and not binding.direct_rewrite_supported):
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, binding.raw_symbol, 0, "")
    if mode == RtHalCallModeV1.SealedCompare and not binding.compare_supported:
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, "", 0, binding.diagnostic)
    val selected_symbol = if mode == RtHalCallModeV1.SealedCompare:
        binding.compare_symbol
    else:
        binding.direct_symbol
    if selected_symbol == "":
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, selected_symbol, 0,
            "E-RT-HAL-BIND-004: selected @rt(hal) mode has no ABI-compatible closed binding")

    # Prove every matching resolved leaf before changing any block. This is a
    # transaction: an unknown or mismatched MIR ABI leaves the function byte-
    # for-byte unchanged instead of partially routing it to a same-name leaf.
    var matching_calls: i64 = 0
    for proof_block in function.blocks:
        for proof_instruction in proof_block.instructions:
            match proof_instruction.kind:
                case MirInstKind.Call(_, proof_callee, proof_args):
                    match proof_callee.kind:
                        case MirOperandKind.Const(
                                MirConstValue.Str(proof_name), _):
                            if proof_name == binding.raw_symbol:
                                matching_calls = matching_calls + 1
                                val actual_signature =
                                    rt_hal_call_operand_signature_key_v1(
                                        proof_callee)
                                val signature_diagnostic =
                                    rt_hal_binding_signature_key_diagnostic_v1(
                                        binding, actual_signature)
                                if signature_diagnostic != "":
                                    return RtHalCallRewriteResultV1(function,
                                        operation, binding.raw_symbol,
                                        selected_symbol, 0,
                                        signature_diagnostic)
                                if rt_hal_call_operand_parameter_count_v1(
                                        proof_callee) != proof_args.len():
                                    return RtHalCallRewriteResultV1(function,
                                        operation, binding.raw_symbol,
                                        selected_symbol, 0,
                                        "E-RT-HAL-BIND-006: resolved call argument count does not match its frozen function-pointer ABI")
                        case _: ()
                case _: ()
    if matching_calls == 0:
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, selected_symbol, 0, "")

    var blocks: [MirBlock] = []
    var rewritten: i64 = 0
    for block in function.blocks:
        var instructions: [MirInst] = []
        for instruction in block.instructions:
            var next = instruction
            match instruction.kind:
                case MirInstKind.Call(dest, callee, args):
                    val replacement = _rt_hal_rewrite_call_operand_v1(
                        callee, binding.raw_symbol, selected_symbol)
                    if replacement.1:
                        next = MirInst(kind: MirInstKind.Call(
                            dest, replacement.0, args), span: instruction.span)
                        rewritten = rewritten + 1
                case _: ()
            instructions.push(next)
        blocks.push(MirBlock(id: block.id, label: block.label,
            instructions: instructions, terminator: block.terminator))
    RtHalCallRewriteResultV1(MirFunction.with_blocks(function, blocks),
        operation, binding.raw_symbol, selected_symbol, rewritten, "")

export RtHalCallModeV1, RtHalCallRewriteResultV1
export rt_hal_rewrite_function_calls_v1
