# Closed compile-time @rt(hal) direct-call rewrite.
#
# MIR direct-call operands already carry the semantic resolver's selected
# callee. Normal mode substitutes the fixed provider ABI inside the tagged
# wrapper, retaining its surrounding validation and panic behavior. Compare
# mode fails closed until an @init_phase owner can supply the sealed V2 handle,
# invocation cursor, captured instruction identity, and result extraction.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_data.{MirFunction}
use compiler.mir.mir_types.{MirConstValue}
use compiler.common.hal.rt_hal_static_binding.*

enum RtHalCallModeV1:
    NormalDirect
    SealedCompare

struct RtHalCallRewriteResultV1:
    function: MirFunction
    operation: text
    raw_symbol: text
    selected_symbol: text
    rewritten_calls: i64
    diagnostic: text

fn _rt_hal_rewrite_call_operand_v1(
        operand: MirOperand, raw_symbol: text,
        selected_symbol: text) -> (MirOperand, bool):
    match operand.kind:
        case MirOperandKind.Const(MirConstValue.Str(name), type_):
            if name == raw_symbol:
                return (MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(selected_symbol), type_)), true)
        case _: ()
    (operand, false)

fn rt_hal_rewrite_function_calls_v1(
        function: MirFunction, manifest: text,
        mode: RtHalCallModeV1) -> RtHalCallRewriteResultV1:
    val operation = rt_hal_manifest_operation_v1(manifest)
    val binding = rt_hal_static_binding_v1(operation)
    if not binding.known:
        return RtHalCallRewriteResultV1(function, operation, "", "", 0,
            binding.diagnostic)
    if mode == RtHalCallModeV1.SealedCompare:
        return RtHalCallRewriteResultV1(function, operation,
            binding.raw_symbol, binding.compare_symbol, 0,
            "E-RT-HAL-BIND-004: sealed comparison rewrite requires an immutable @init_phase session owner and bounded V2 result extraction")

    var blocks: [MirBlock] = []
    var rewritten: i64 = 0
    for block in function.blocks:
        var instructions: [MirInst] = []
        for instruction in block.instructions:
            var next = instruction
            match instruction.kind:
                case MirInstKind.Call(dest, callee, args):
                    val replacement = _rt_hal_rewrite_call_operand_v1(
                        callee, binding.raw_symbol, binding.direct_symbol)
                    if replacement.1:
                        next = MirInst(kind: MirInstKind.Call(
                            dest, replacement.0, args), span: instruction.span)
                        rewritten = rewritten + 1
                case _: ()
            instructions.push(next)
        blocks.push(MirBlock(id: block.id, label: block.label,
            instructions: instructions, terminator: block.terminator))
    RtHalCallRewriteResultV1(MirFunction.with_blocks(function, blocks),
        operation, binding.raw_symbol, binding.direct_symbol, rewritten, "")

export RtHalCallModeV1, RtHalCallRewriteResultV1
export rt_hal_rewrite_function_calls_v1
