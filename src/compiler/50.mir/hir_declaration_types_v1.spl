# Typed resident MIR declaration roots; ordinary function bodies are absent.
use compiler.hir.hir_types.{HirModule, HirType, SymbolId, SymbolTable, Effect, SymbolKind}
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr, ExportAttr}
use compiler.types.type_layout.{LayoutAttr, FieldLayout, compute_struct_layout, layoutattr_default_}
use compiler.mir.hir_expression_artifact_v1.*
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}

# Export surface: consumers across 50.mir/80.driver reach these carriers
# through compiler.mir.hir_declaration_summary_v1's 'export use ... .*'
# re-export, which materializes ONLY for items this module exports. Without
# this list the seed registry leaves every carrier unresolvable in importers
# ('struct ANY field ...' when a literal's type is ANY), even with itemized
# imports at the use site (seed regression family, stage-2 bulk build).
export MirHirParamDeclarationV1, MirHirFunctionDeclarationV1, MirHirFieldDeclarationV1
export MirHirNominalDeclarationV1, MirHirVariantDeclarationV1, MirHirEnumDeclarationV1
export MirHirTraitDeclarationV1, MirHirGlobalDeclarationV1, MirHirDeclarationSourceV1
export MirHirModuleDeclarationsV1, MirHirDeclarationRepositoryV1, MirHirCallableDefaultsV1

struct MirHirParamDeclarationV1:
    symbol: SymbolId
    name: text
    type_: HirType
    has_default: bool
    default_artifact: MirHirExpressionArtifactV1?
    span: Span
    is_mutable: bool

struct MirHirFunctionDeclarationV1:
    symbol: SymbolId
    name: text
    type_params: [HirTypeParam]
    params: [MirHirParamDeclarationV1]
    return_type: HirType
    effects: [Effect]
    visibility: Visibility
    is_async: bool
    is_static: bool
    is_public: bool
    is_method: bool
    is_mutable: bool
    is_const: bool
    is_extern: bool
    func_attr: FunctionAttr
    has_export_attr: bool
    export_attr: ExportAttr
    is_generic_template: bool
    span: Span
    complete_function_digest: text = ""

struct MirHirFieldDeclarationV1:
    symbol: SymbolId
    name: text
    type_: HirType
    has_default: bool
    default_artifact: MirHirExpressionArtifactV1?
    visibility: Visibility
    is_public: bool
    is_volatile: bool
    has_bits_attr: bool
    bits_width: i64
    has_fixed_address: bool
    fixed_address: i64
    span: Span

struct MirHirNominalDeclarationV1:
    symbol: SymbolId
    name: text
    kind: SymbolKind
    type_params: [HirTypeParam]
    fields: [MirHirFieldDeclarationV1]
    methods: Dict<text, SymbolId>
    has_layout_attr: bool
    layout_attr: LayoutAttr
    layout_digest: text
    has_export_attr: bool
    export_attr: ExportAttr?
    visibility: Visibility
    is_public: bool
    is_generic_template: bool
    span: Span

struct MirHirVariantDeclarationV1:
    symbol: SymbolId
    name: text
    # Payload structure is explicit; HirVariantKind.Struct contains HirFields.
    kind: text
    tuple_types: [HirType]
    fields: [MirHirFieldDeclarationV1]
    has_discriminant: bool
    discriminant_artifact: MirHirExpressionArtifactV1?
    span: Span

struct MirHirEnumDeclarationV1:
    symbol: SymbolId
    name: text
    runtime_name: text
    type_params: [HirTypeParam]
    variants: [MirHirVariantDeclarationV1]
    attributes: [HirAttribute]
    complete_open: bool
    dyn_open: bool
    visibility: Visibility
    is_public: bool
    is_generic_template: bool
    span: Span

struct MirHirTraitDeclarationV1:
    symbol: SymbolId
    name: text
    type_params: [HirTypeParam]
    methods: [MirHirFunctionDeclarationV1]
    defaults: [MirHirFunctionDeclarationV1]
    supertraits: [HirType]
    where_clause: [HirTraitBound]
    assoc_types: [HirAssocTypeDecl]
    visibility: Visibility
    is_public: bool
    is_generic_template: bool
    span: Span

struct MirHirGlobalDeclarationV1:
    symbol: SymbolId
    name: text
    type_: HirType
    initializer: MirHirExpressionArtifactV1
    is_mutable: bool
    visibility: Visibility
    is_public: bool
    is_volatile: bool
    has_fixed_address: bool
    fixed_address: i64
    span: Span

# Actual source-index provenance is supplied by the driver from its admitted
# inventory. It is comparison evidence, never an admission token.
struct MirHirDeclarationSourceV1:
    logical_key: text
    physical_path: text
    source_digest: text
    source_bytes: i64
    input_archive_key: text

struct MirHirModuleDeclarationsV1:
    name: text
    path: text
    final_repository_authority: text
    final_archive_key: text
    final_body_digest: text
    symbols: SymbolTable
    functions: [MirHirFunctionDeclarationV1]
    structs: [MirHirNominalDeclarationV1]
    classes: [MirHirNominalDeclarationV1]
    enums: [MirHirEnumDeclarationV1]
    bitfields: [HirBitfield]
    traits: [MirHirTraitDeclarationV1]
    impls: [HirImpl]
    globals: [MirHirGlobalDeclarationV1]
    needs_initialization: bool
    declaration_digest: text
    stage: text
    source_binding: MirHirDeclarationSourceV1? = nil

struct MirHirDeclarationRepositoryV1:
    artifact_context: HirOwnedArtifactContextV1
    final_repository_authority: text
    # Ordering is admitted driver source order, not dictionary iteration order.
    ordered_modules: [text]
    modules: Dict<text, MirHirModuleDeclarationsV1>
    authority: text

struct MirHirCallableDefaultsV1:
    module_name: text
    function: MirHirFunctionDeclarationV1
