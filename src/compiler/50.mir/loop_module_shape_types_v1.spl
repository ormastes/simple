pub fn mir_loop_shape_type_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case TypeI8 | TypeI16 | TypeI32 | TypeI64 | TypeU8 | TypeU16 | TypeU32 | TypeU64 | TypeBool | TypeChar | TypeUnit | TypeNever | TypeArray | TypeSlice | TypeTuple | TypeResult | TypeStruct | TypeEnum | TypeF32 | TypeF64 | TypeVec4f | TypeVec8f | TypeVec4d | TypeVec4i | TypeVec8i | TypeVec16f | TypeVec8d | TypeVec16i | TypePtr | TypeRef | TypeDict | TypeUnion | TypeFuncPtr | TypeBits | TypeOpaque | TypeScalableVec | TypePromise | TypeGenerator | TypeActorType: true
        case _: false

pub fn mir_loop_shape_hir_type_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case HirBool | HirChar | HirStr | HirUnit | HirError | HirNever | HirAny | HirInt | HirFloat | HirTuple | HirUnion | HirArray | HirSlice | HirOptional | HirIsolated | HirUnique | HirShared | HirWeak | HirPtr | HirRef | HirDict | HirResult | HirNamed | HirTypeParam | HirDynTrait | HirFunction | HirProjection | HirInfer | HirTensor | HirLayer: true
        case _: false

pub fn mir_loop_shape_effect_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case EffectPure | EffectIO | EffectAsync | EffectMutates | EffectAllocates | EffectThrows | EffectCustom: true
        case _: false

pub fn mir_loop_shape_dimension_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case DimLiteral | DimNamed | DimVar | DimDynamic | DimBroadcast | DimConstParam | DimAdd | DimMul | DimDiv: true
        case _: false

pub fn mir_loop_shape_constant_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case ConstInt | ConstBool | ConstZero | ConstText | ConstArray | ConstTuple | ConstStruct | ConstFloat | ConstFloatLexeme: true
        case _: false

pub fn mir_loop_shape_predicate_v1(tag: MirLoopShapeTagV1) -> bool:
    match tag:
        case PredicateInt | PredicateBool | PredicateVar | PredicateUnary | PredicateBinary | PredicateUnit | PredicateCast: true
        case _: false

export MirLoopShapeTagV1, MirLoopShapeErrorV1, MirLoopShapeSchemaV1, MirLoopShapeObservationV1

pub fn mir_loop_shape_child_v1(parent: MirLoopShapeTagV1, ordinal: i64, count: i64, child: MirLoopShapeTagV1) -> bool:
    match parent:
        case TypeArray | TypeSlice | TypeTuple | TypeResult | TypePtr | TypeRef | TypeDict | TypeUnion | TypeScalableVec | TypePromise | TypeGenerator | TypeActorType | Signature | Field | Variant | DeclUnion | EnumSlotTypes:
            mir_loop_shape_type_v1(child)
        case TypeFuncPtr: child == MirLoopShapeTagV1.Signature
        case HirTuple | HirArray | HirSlice | HirDict | HirRef | HirPtr | HirOptional | HirResult | HirNamed | HirTypeParam | HirUnion | HirProjection | HirIsolated | HirUnique | HirShared | HirWeak | EffectThrows:
            mir_loop_shape_hir_type_v1(child)
        case HirFunction:
            mir_loop_shape_hir_type_v1(child) or mir_loop_shape_effect_v1(child)
        case HirTensor:
            if ordinal == 0: return mir_loop_shape_hir_type_v1(child)
            mir_loop_shape_dimension_v1(child)
        case HirLayer | DimAdd | DimMul | DimDiv: mir_loop_shape_dimension_v1(child)
        case ConstArray | ConstTuple | ConstField: mir_loop_shape_constant_v1(child)
        case ConstStruct: child == MirLoopShapeTagV1.ConstField
        case OperandConst | InstConst:
            if ordinal == 1: return mir_loop_shape_type_v1(child)
            mir_loop_shape_constant_v1(child)
        case Local: mir_loop_shape_type_v1(child)
        case InstCall | InstBinOp | InstUnaryOp | InstGetField | TermIf | TermRet:
            child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
        case InstCast:
            if ordinal == 1: return mir_loop_shape_type_v1(child)
            child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
        case InstAggregate:
            if ordinal == 0: return mir_loop_shape_type_v1(child)
            child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
        case TermSwitch:
            if ordinal > 0: return child == MirLoopShapeTagV1.SwitchArm
            child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
        case SwitchArm: mir_loop_shape_constant_v1(child)
        case Block:
            if ordinal == count - 1:
                match child:
                    case TermGoto | TermRet | TermIf | TermSwitch | TermAbort | TermUnreachable: return true
                    case _: return false
            match child:
                case InstCall | InstNop | InstDebugValue | InstConst | InstCopy | InstMove | InstDrop | InstBinOp | InstUnaryOp | InstCast | InstAggregate | InstGetField: true
                case _: false
        case Function:
            if ordinal == 0: return child == MirLoopShapeTagV1.Signature
            match child:
                case Local | Block | Site | EnumMatch | MetadataScalar | MetadataText | MetadataType | MetadataHirType | MetadataList: true
                case _: false
        case DeclStruct: child == MirLoopShapeTagV1.Field
        case DeclEnum: child == MirLoopShapeTagV1.Variant
        case PredicateInt | PredicateBool | PredicateVar | PredicateUnit: mir_loop_shape_hir_type_v1(child)
        case PredicateUnary | PredicateBinary:
            if ordinal == 0: return mir_loop_shape_hir_type_v1(child)
            mir_loop_shape_predicate_v1(child)
        case PredicateCast:
            if ordinal == 0 or ordinal == 2: return mir_loop_shape_hir_type_v1(child)
            mir_loop_shape_predicate_v1(child)
        case SourceRange:
            if ordinal == 0: return mir_loop_shape_hir_type_v1(child)
            mir_loop_shape_predicate_v1(child)
        case Binding:
            if ordinal == 0: return mir_loop_shape_hir_type_v1(child)
            mir_loop_shape_type_v1(child)
        case Invariant:
            if ordinal == 0: return mir_loop_shape_predicate_v1(child)
            child == MirLoopShapeTagV1.Binding
        case Site:
            match child:
                case SiteMember | SiteBackedge | SiteExitEdge | Invariant | SiteCondition | SiteRange: true
                case _: false
        case SiteBackedge | SiteExitEdge: child == MirLoopShapeTagV1.Edge
        case SiteCondition: mir_loop_shape_predicate_v1(child)
        case SiteRange: child == MirLoopShapeTagV1.SourceRange
        case AggregateSite:
            if ordinal < 2: return mir_loop_shape_type_v1(child)
            if ordinal == 2: return child == MirLoopShapeTagV1.Span
            child == MirLoopShapeTagV1.LocalReference
        case MetadataHirType: mir_loop_shape_hir_type_v1(child)
        case MetadataType: mir_loop_shape_type_v1(child)
        case MetadataList | ExternalLayout:
            match child:
                case MetadataScalar | MetadataText | MetadataType | MetadataHirType | MetadataList | EnumDeclarationIdentity | Contract: true
                case _: false
        case Contract: child == MirLoopShapeTagV1.ContractClause
        case ContractClause: mir_loop_shape_predicate_v1(child)
        case EnumMatch:
            if ordinal == 0: return child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
            if ordinal == 1: return mir_loop_shape_type_v1(child)
            if ordinal == 2: return child == MirLoopShapeTagV1.EnumPatterns
            if ordinal == 3: return child == MirLoopShapeTagV1.EnumArms
            child == MirLoopShapeTagV1.EnumSites
        case EnumPatterns:
            match child:
                case EnumPatternWildcard | EnumPatternBind | EnumPatternVariant | EnumPatternTuple | EnumPatternOr | EnumPatternLiteral: true
                case _: false
        case EnumArms: child == MirLoopShapeTagV1.EnumArm
        case EnumSites: child == MirLoopShapeTagV1.EnumSite
        case EnumIndices: child == MirLoopShapeTagV1.EnumIndex
        case EnumSlotNames: child == MirLoopShapeTagV1.EnumName
        case EnumPatternWildcard | EnumPatternBind | EnumSite: mir_loop_shape_type_v1(child)
        case EnumPatternVariant | EnumPatternTuple | EnumPatternOr:
            if ordinal == 0: return mir_loop_shape_type_v1(child)
            child == MirLoopShapeTagV1.EnumIndices
        case EnumPatternLiteral:
            if ordinal == 1: return mir_loop_shape_constant_v1(child)
            mir_loop_shape_type_v1(child)
        case EnumArm:
            if ordinal == 1: return child == MirLoopShapeTagV1.EnumIndices
            child == MirLoopShapeTagV1.OperandCopy or child == MirLoopShapeTagV1.OperandMove or child == MirLoopShapeTagV1.OperandConst
        case EnumDeclarationIdentity: child == MirLoopShapeTagV1.EnumVariantSlots
        case EnumVariantSlots:
            if ordinal == 0: return child == MirLoopShapeTagV1.EnumSlotTypes
            child == MirLoopShapeTagV1.EnumSlotNames
        case _: false

# Explicit schema codes, independent of enum physical discriminants.
pub fn mir_loop_mir_binop_code_v1(value: MirBinOp) -> i64:
    match value:
        case MirBinOp.Add: 0
        case MirBinOp.Sub: 1
        case MirBinOp.Mul: 2
        case MirBinOp.Div: 3
        case MirBinOp.Rem: 4
        case MirBinOp.Pow: 5
        case MirBinOp.MatMul: 6
        case MirBinOp.BitAnd: 7
        case MirBinOp.BitOr: 8
        case MirBinOp.BitXor: 9
        case MirBinOp.Shl: 10
        case MirBinOp.Shr: 11
        case MirBinOp.Eq: 12
        case MirBinOp.Ne: 13
        case MirBinOp.Lt: 14
        case MirBinOp.Le: 15
        case MirBinOp.Gt: 16
        case MirBinOp.Ge: 17
        case MirBinOp.BroadcastAdd: 18
        case MirBinOp.BroadcastSub: 19
        case MirBinOp.BroadcastMul: 20
        case MirBinOp.BroadcastDiv: 21
        case MirBinOp.BroadcastPow: 22
        case MirBinOp.Offset: 23

pub fn mir_loop_mir_binop_from_code_v1(value: i64) -> Result<MirBinOp, MirLoopShapeErrorV1>:
    match value:
        case 0: Ok(MirBinOp.Add)
        case 1: Ok(MirBinOp.Sub)
        case 2: Ok(MirBinOp.Mul)
        case 3: Ok(MirBinOp.Div)
        case 4: Ok(MirBinOp.Rem)
        case 5: Ok(MirBinOp.Pow)
        case 6: Ok(MirBinOp.MatMul)
        case 7: Ok(MirBinOp.BitAnd)
        case 8: Ok(MirBinOp.BitOr)
        case 9: Ok(MirBinOp.BitXor)
        case 10: Ok(MirBinOp.Shl)
        case 11: Ok(MirBinOp.Shr)
        case 12: Ok(MirBinOp.Eq)
        case 13: Ok(MirBinOp.Ne)
        case 14: Ok(MirBinOp.Lt)
        case 15: Ok(MirBinOp.Le)
        case 16: Ok(MirBinOp.Gt)
        case 17: Ok(MirBinOp.Ge)
        case 18: Ok(MirBinOp.BroadcastAdd)
        case 19: Ok(MirBinOp.BroadcastSub)
        case 20: Ok(MirBinOp.BroadcastMul)
        case 21: Ok(MirBinOp.BroadcastDiv)
        case 22: Ok(MirBinOp.BroadcastPow)
        case 23: Ok(MirBinOp.Offset)
        case _: Err(MirLoopShapeErrorV1.InvalidField)

# Explicit schema codes, independent of enum physical discriminants.
pub fn mir_loop_mir_unaryop_code_v1(value: MirUnaryOp) -> i64:
    match value:
        case MirUnaryOp.Neg: 0
        case MirUnaryOp.Not: 1
        case MirUnaryOp.BitNot: 2
        case MirUnaryOp.Transpose: 3

pub fn mir_loop_mir_unaryop_from_code_v1(value: i64) -> Result<MirUnaryOp, MirLoopShapeErrorV1>:
    match value:
        case 0: Ok(MirUnaryOp.Neg)
        case 1: Ok(MirUnaryOp.Not)
        case 2: Ok(MirUnaryOp.BitNot)
        case 3: Ok(MirUnaryOp.Transpose)
        case _: Err(MirLoopShapeErrorV1.InvalidField)

