pub fn mir_loop_shape_boolean_slot_v1(tag: MirLoopShapeTagV1, ordinal: i64) -> bool:
    match tag:
        case ConstBool: ordinal == 0
        case Local: ordinal == 3 or ordinal == 4
        case Signature: ordinal == 0 or ordinal == 1 or ordinal == 3
        case Field: ordinal == 1
        case DeclStruct: ordinal == 1
        case DeclEnum: ordinal == 1
        case DeclUnion: ordinal == 1
        case PredicateInt: ordinal == 1 or ordinal == 2
        case PredicateBool: ordinal == 0 or ordinal == 1
        case PredicateVar: ordinal == 1 or ordinal == 2
        case PredicateUnary: ordinal == 1
        case PredicateBinary: ordinal == 1
        case PredicateUnit: ordinal == 0
        case PredicateCast: ordinal == 0
        case SourceRange: ordinal == 0 or ordinal == 1 or ordinal == 2 or ordinal == 3 or ordinal == 4
        case TypePtr: ordinal == 0
        case TypeRef: ordinal == 0
        case TypeBits: ordinal == 1
        case HirInt: ordinal == 1
        case HirArray: ordinal == 0
        case HirPtr: ordinal == 0
        case HirRef: ordinal == 0
        case DimNamed: ordinal == 0 or ordinal == 2
        case EnumArm: ordinal == 3 or ordinal == 5
        case InstCall: ordinal == 0
        case _: false
