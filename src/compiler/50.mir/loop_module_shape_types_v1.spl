enum MirLoopShapeErrorV1:
    InvalidState
    InvalidCursor
    InvalidTag
    InvalidField
    Duplicate
    Incomplete
    Capacity
    Unsupported
    StaleRevision

struct MirLoopShapeSchemaV1:
    scalars: i64
    texts: i64
    minimum_children: i64
    maximum_children: i64

struct MirLoopShapeObservationV1:
    nodes: i64
    texts: i64
    functions: i64
    declarations: i64
    state: i64

