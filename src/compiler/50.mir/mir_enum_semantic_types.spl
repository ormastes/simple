# EE-01 producer-bound named-enum transport. No executable instruction or
# validation authority lives here. Consumers must validate the final function,
# declaration identities, sites and graph before using these records.
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_types.{LocalId, MirType, MirConstValue}
use compiler.mir.mir_instruction_support.{BlockId, MirOperand}

enum MirEnumPatternKindV1:
    Wildcard
    Bind(source_symbol: SymbolId, destination_local: LocalId)
    Variant(owner_symbol: SymbolId, discriminant: i64, children: [i64])
    Tuple(children: [i64])
    Literal(value: MirConstValue, exact_type: MirType)
    Or(alternatives: [i64])

struct MirEnumPatternNodeV1:
    kind: MirEnumPatternKindV1
    expected_type: MirType
    source_span: Span

enum MirEnumSiteKindV1:
    Discriminant
    VariantIdentityCheck
    Payload
    PayloadSlot
    PayloadDecode
    Guard
    ArmResult
    PatternInstruction
    PatternTerminator

struct MirEnumSiteV1:
    kind: MirEnumSiteKindV1
    block_id: BlockId
    instruction_index: i64
    exact_instruction_identity: text
    semantic_input_type: MirType
    semantic_output_type: MirType
    related_pattern_node: i64

struct MirEnumArmSemanticV1:
    source_arm_id: i64
    expanded_alternative_index: i64
    pattern_root: i64
    guard_entry: BlockId?
    guard_result: MirOperand?
    body_entry: BlockId
    body_exit_blocks: [BlockId]
    pattern_failure_entry: BlockId
    guard_failure_entry: BlockId
    source_span: Span
    # Entry cursors distinguish native pattern/guard prefixes sharing a block.
    guard_entry_instruction_index: i64 = 0
    body_entry_instruction_index: i64 = 0
    pattern_entry_block: BlockId = BlockId(id: -1)
    pattern_entry_instruction_index: i64 = 0

struct MirEnumMatchSemanticV1:
    match_id: i64
    enum_owner: SymbolId
    scrutinee_operand: MirOperand
    scrutinee_semantic_type: MirType
    entry_block: BlockId
    result_local: LocalId
    merge_block: BlockId
    pattern_nodes: [MirEnumPatternNodeV1]
    arms: [MirEnumArmSemanticV1]
    sites: [MirEnumSiteV1]
    source_span: Span
    declaration_identity: text
    subject_identity: text
    schema: text = "MirEnumMatchSemantic-v1"
    entry_instruction_index: i64 = 0

struct MirEnumVariantSlotsV1:
    discriminant: i64
    source_variant: SymbolId
    slot_types: [MirType]
    slot_names: [text]

struct MirEnumDeclarationIdentityV1:
    owner: SymbolId
    source_owner: SymbolId
    runtime_name: text
    runtime_identity: i64
    variants: [MirEnumVariantSlotsV1]
