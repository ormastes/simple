# Retain the dictionary's original SymbolId key carrier while comparing the
# numeric identity; never reconstruct an object-identity key for a lookup.
use compiler.mir.mir_instructions.{MirModule}
use compiler.mir.mir_types.{MirTypeDef}
use compiler.hir.hir_types.{SymbolId}

pub fn mir_accessor_layout_lookup_v1(module: MirModule, symbol: SymbolId) -> Result<MirTypeDef, text>:
    val keys = module.types.keys()
    var found = -1
    for index in 0..keys.len():
        if keys[index].id != symbol.id: continue
        if found >= 0: return Err("E-AOP-FIELD-TYPE: duplicate physical type identity")
        found = index
    if found < 0: return Err("E-AOP-FIELD-TYPE: actual worker has no declaring physical layout")
    Ok(module.types[keys[found]])
