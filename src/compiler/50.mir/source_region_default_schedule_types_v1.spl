# Compiler-owned observations only. No replay or admission authority.
use compiler.common.loop_resource_account_v1.{MirLoopResourceAccountV1}
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.mir.hir_expression_artifact_v1.{MirHirExpressionArtifactV1}
use compiler.mir.source_region_default_binding_types_v1.{MirSourceDefaultBindingsV1}

struct MirSourceRegionDefaultOccurrenceV1:
    original: SymbolId
    ordinal: i64
    artifact: MirHirExpressionArtifactV1?
    field_owner: text
    field_index: i64
    target_blob: text
    bindings: MirSourceDefaultBindingsV1

class MirSourceRegionDefaultScheduleV1:
    source: HirModule
    target_key: text
    account: MirLoopResourceAccountV1
    queue: [SymbolId]
    completed: [SymbolId]
    occurrences: [MirSourceRegionDefaultOccurrenceV1]
    cursor: i64
    active: SymbolId?
    active_occurrence: i64
    active_errors: i64
    initial_errors: i64
    failure: text
    failure_published: bool
    bound: bool
