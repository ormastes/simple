# Immutable registration evidence. This record alone grants no transport or
# lowering authority; the owner publishes it only beside an actual map write.
struct BootstrapFnRegistrationOriginV1:
    bound: bool
    registry: text
    row_name: text
    repository_authority: text
    module_key: text
    declaration_digest: text
    function_digest: text
    function_symbol: i64
    selector: text
    write_event: i64

export BootstrapFnRegistrationOriginV1
