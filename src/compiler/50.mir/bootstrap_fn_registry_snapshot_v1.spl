# Canonical 20-map owner snapshot. Decode/reconstruction touches only a fresh
# private state; publication belongs exclusively to mir_data after promotion.
use compiler.mir.bootstrap_fn_registry_state_v1.{BootstrapFnRegistryStateV1, bootstrap_fn_registry_names_v1}
use compiler.mir.bootstrap_fn_reference_resolver_v1.*
use compiler.mir.bootstrap_fn_reference_values_v1.*
use compiler.mir.bootstrap_fn_registration_origin_v1.{BootstrapFnRegistrationOriginV1, bootstrap_fn_registration_storage_key_v1}
use compiler.mir.bootstrap_owner_snapshot_v1.*
use compiler.mir.hir_declaration_types_v1.*
use compiler.mir.hir_declaration_reference_key_v1.{mir_hir_reference_module_key_v1}
use compiler.hir.hir_definitions.{HirConst}
use compiler.hir.hir_codec_key_order.{hc_order_text_keys_v1}
use std.common.sdn.value.{SdnValue}
use std.common.crypto.sha256.{sha256_text}
use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}
use std.common.encoding.utf8.{text_byte_len}

struct BootstrapFnRegistryPreparedV1:
    state: BootstrapFnRegistryStateV1
    snapshot: BootstrapOwnerSnapshotV1
    maximum_event: i64
    origin_rows: i64
    origin_bytes: i64

fn _snapshot_origin_key_v1(registry: text, name: text) -> text:
    bootstrap_fn_registration_storage_key_v1(registry, name)

fn _snapshot_count_v1(state: BootstrapFnRegistryStateV1, registry: text) -> i64:
    match registry:
        case "fn_ret_types": state.fn_ret_types.len()
        case "fn_ret_hir_types": state.fn_ret_hir_types.len()
        case "fn_ret_hir_ambig": state.fn_ret_hir_ambig.len()
        case "fn_ret_shapes": state.fn_ret_shapes.len()
        case "fn_ret_shape_ambig": state.fn_ret_shape_ambig.len()
        case "fn_ret_array_element_shapes": state.fn_ret_array_element_shapes.len()
        case "fn_ret_array_element_identities": state.fn_ret_array_element_identities.len()
        case "fn_ret_array_element_shape_ambig": state.fn_ret_array_element_shape_ambig.len()
        case "fn_ret_ok_shapes": state.fn_ret_ok_shapes.len()
        case "fn_ret_ok_shape_ambig": state.fn_ret_ok_shape_ambig.len()
        case "fn_ret_err_shapes": state.fn_ret_err_shapes.len()
        case "fn_ret_opt_shapes": state.fn_ret_opt_shapes.len()
        case "fn_ret_opt_shape_ambig": state.fn_ret_opt_shape_ambig.len()
        case "fn_param_hir_types": state.fn_param_hir_types.len()
        case "fn_param_hir_rejected": state.fn_param_hir_rejected.len()
        case "fn_param_defaults": state.fn_param_defaults.len()
        case "fn_param_defaults_ambig": state.fn_param_defaults_ambig.len()
        case "fn_param_default_owners": state.fn_param_default_owners.len()
        case "default_provider_symbols": state.default_provider_symbols.len()
        case "default_provider_globals": state.default_provider_globals.len()
        case _: -1

fn _snapshot_keys_v1(state: BootstrapFnRegistryStateV1, registry: text) -> [text]:
    match registry:
        case "fn_ret_types": state.fn_ret_types.keys()
        case "fn_ret_hir_types": state.fn_ret_hir_types.keys()
        case "fn_ret_hir_ambig": state.fn_ret_hir_ambig.keys()
        case "fn_ret_shapes": state.fn_ret_shapes.keys()
        case "fn_ret_shape_ambig": state.fn_ret_shape_ambig.keys()
        case "fn_ret_array_element_shapes": state.fn_ret_array_element_shapes.keys()
        case "fn_ret_array_element_identities": state.fn_ret_array_element_identities.keys()
        case "fn_ret_array_element_shape_ambig": state.fn_ret_array_element_shape_ambig.keys()
        case "fn_ret_ok_shapes": state.fn_ret_ok_shapes.keys()
        case "fn_ret_ok_shape_ambig": state.fn_ret_ok_shape_ambig.keys()
        case "fn_ret_err_shapes": state.fn_ret_err_shapes.keys()
        case "fn_ret_opt_shapes": state.fn_ret_opt_shapes.keys()
        case "fn_ret_opt_shape_ambig": state.fn_ret_opt_shape_ambig.keys()
        case "fn_param_hir_types": state.fn_param_hir_types.keys()
        case "fn_param_hir_rejected": state.fn_param_hir_rejected.keys()
        case "fn_param_defaults": state.fn_param_defaults.keys()
        case "fn_param_defaults_ambig": state.fn_param_defaults_ambig.keys()
        case "fn_param_default_owners": state.fn_param_default_owners.keys()
        case "default_provider_symbols": state.default_provider_symbols.keys()
        case "default_provider_globals": state.default_provider_globals.keys()
        case _: []

fn _snapshot_has_v1(state: BootstrapFnRegistryStateV1, registry: text, name: text) -> bool:
    match registry:
        case "fn_ret_types": state.fn_ret_types.has(name)
        case "fn_ret_hir_types": state.fn_ret_hir_types.has(name)
        case "fn_ret_hir_ambig": state.fn_ret_hir_ambig.has(name)
        case "fn_ret_shapes": state.fn_ret_shapes.has(name)
        case "fn_ret_shape_ambig": state.fn_ret_shape_ambig.has(name)
        case "fn_ret_array_element_shapes": state.fn_ret_array_element_shapes.has(name)
        case "fn_ret_array_element_identities": state.fn_ret_array_element_identities.has(name)
        case "fn_ret_array_element_shape_ambig": state.fn_ret_array_element_shape_ambig.has(name)
        case "fn_ret_ok_shapes": state.fn_ret_ok_shapes.has(name)
        case "fn_ret_ok_shape_ambig": state.fn_ret_ok_shape_ambig.has(name)
        case "fn_ret_err_shapes": state.fn_ret_err_shapes.has(name)
        case "fn_ret_opt_shapes": state.fn_ret_opt_shapes.has(name)
        case "fn_ret_opt_shape_ambig": state.fn_ret_opt_shape_ambig.has(name)
        case "fn_param_hir_types": state.fn_param_hir_types.has(name)
        case "fn_param_hir_rejected": state.fn_param_hir_rejected.has(name)
        case "fn_param_defaults": state.fn_param_defaults.has(name)
        case "fn_param_defaults_ambig": state.fn_param_defaults_ambig.has(name)
        case "fn_param_default_owners": state.fn_param_default_owners.has(name)
        case "default_provider_symbols": state.default_provider_symbols.has(name)
        case "default_provider_globals": state.default_provider_globals.has(name)
        case _: true

fn _snapshot_reference_v1(state: BootstrapFnRegistryStateV1, registry: text, name: text,
        resolver: BootstrapFnReferenceResolverV1) -> Result<SdnValue, text>:
    val origin_registry = bootstrap_fn_origin_registry_v1(registry)
    val key = _snapshot_origin_key_v1(origin_registry, name)
    if not state.origins.has(key): return Err("bootstrap typed row has no registration origin")
    val origin: BootstrapFnRegistrationOriginV1 = state.origins[key]
    if (not origin.bound or origin.registry != origin_registry or origin.row_name != name or
            origin.repository_authority != resolver.repository.final_repository_authority):
        return Err("bootstrap typed row origin is unknown or belongs to another repository")
    var items: [SdnValue] = []
    if registry == "default_provider_globals":
        val globals: [HirConst] = state.default_provider_globals[name]
        if globals.len() > 65536 or not resolver.budget.reserve(globals.len() * 128 + 64):
            return Err("bootstrap globals selector bound")
        for global in globals:
            if global == nil: return Err("bootstrap global row is nil")
            items.push(SdnValue.Int(global.symbol.id))
    val fields: Dict<text, SdnValue> = {
        "module": SdnValue.String(origin.module_key),
        "declaration": SdnValue.String(origin.declaration_digest),
        "function": SdnValue.String(origin.function_digest),
        "symbol": SdnValue.Int(origin.function_symbol),
        "selector": SdnValue.String(origin.selector),
        "event": SdnValue.Int(origin.write_event), "items": SdnValue.Array(items),
        "repository": SdnValue.String(resolver.repository.authority)}
    val value = SdnValue.Dict(fields)
    val resolved = resolver.resolve(registry, value)
    if resolved.is_err(): return Err(resolved.unwrap_err())
    val reference = resolved.unwrap()
    var matches = false
    match registry:
        case "fn_ret_types":
            val expected = bootstrap_fn_str_mir_value_v1(reference)
            matches = expected.is_ok() and bootstrap_fn_str_mir_matches_v1(state.fn_ret_types[name])
        case "fn_ret_hir_types":
            val expected = bootstrap_fn_return_hir_value_v1(reference)
            matches = expected.is_ok() and bootstrap_fn_hir_value_matches_v1(state.fn_ret_hir_types[name], expected.unwrap(), resolver.budget)
        case "fn_param_hir_types":
            val expected = bootstrap_fn_parameter_hir_value_v1(reference, resolver.budget)
            matches = expected.is_ok() and bootstrap_fn_hir_types_equal_v1(state.fn_param_hir_types[name], expected.unwrap(), resolver.budget)
        case "fn_param_defaults":
            matches = bootstrap_fn_params_match_v1(state.fn_param_defaults[name], reference, resolver.budget)
        case "default_provider_symbols":
            val actual = bootstrap_fn_symbol_digest_v1(state.default_provider_symbols[name], resolver.budget)
            if actual.is_err(): return Err(actual.unwrap_err())
            val expected = bootstrap_fn_symbol_digest_v1(reference.module.symbols, resolver.budget)
            matches = expected.is_ok() and actual.unwrap() == expected.unwrap()
        case "default_provider_globals":
            matches = bootstrap_fn_globals_match_v1(state.default_provider_globals[name], reference, resolver)
        case _: return Err("bootstrap typed registry unknown")
    if not matches: return Err("bootstrap actual typed value differs from its exact declaration field")
    Ok(value)

fn _snapshot_value_v1(state: BootstrapFnRegistryStateV1, registry: text, name: text,
        resolver: BootstrapFnReferenceResolverV1) -> Result<SdnValue, text>:
    match registry:
        case "fn_ret_hir_ambig": Ok(SdnValue.Bool(state.fn_ret_hir_ambig[name]))
        case "fn_ret_shapes": Ok(SdnValue.String(state.fn_ret_shapes[name]))
        case "fn_ret_shape_ambig": Ok(SdnValue.Bool(state.fn_ret_shape_ambig[name]))
        case "fn_ret_array_element_shapes": Ok(SdnValue.String(state.fn_ret_array_element_shapes[name]))
        case "fn_ret_array_element_identities": Ok(SdnValue.String(state.fn_ret_array_element_identities[name]))
        case "fn_ret_array_element_shape_ambig": Ok(SdnValue.Bool(state.fn_ret_array_element_shape_ambig[name]))
        case "fn_ret_ok_shapes": Ok(SdnValue.String(state.fn_ret_ok_shapes[name]))
        case "fn_ret_ok_shape_ambig": Ok(SdnValue.Bool(state.fn_ret_ok_shape_ambig[name]))
        case "fn_ret_err_shapes": Ok(SdnValue.String(state.fn_ret_err_shapes[name]))
        case "fn_ret_opt_shapes": Ok(SdnValue.String(state.fn_ret_opt_shapes[name]))
        case "fn_ret_opt_shape_ambig": Ok(SdnValue.Bool(state.fn_ret_opt_shape_ambig[name]))
        case "fn_param_hir_rejected": Ok(SdnValue.Bool(state.fn_param_hir_rejected[name]))
        case "fn_param_defaults_ambig": Ok(SdnValue.Bool(state.fn_param_defaults_ambig[name]))
        case "fn_param_default_owners": Ok(SdnValue.String(state.fn_param_default_owners[name]))
        case _: _snapshot_reference_v1(state, registry, name, resolver)

fn bootstrap_fn_registry_snapshot_encode_v1(state: BootstrapFnRegistryStateV1,
        repository: MirHirDeclarationRepositoryV1) -> Result<BootstrapOwnerSnapshotV1, text>:
    val budget = BootstrapOwnerBudgetV1.create()
    bootstrap_fn_registry_snapshot_encode_budgeted_v1(state, repository, budget)

fn bootstrap_fn_registry_snapshot_encode_budgeted_v1(state: BootstrapFnRegistryStateV1,
        repository: MirHirDeclarationRepositoryV1, budget: BootstrapOwnerBudgetV1) -> Result<BootstrapOwnerSnapshotV1, text>:
    val created = BootstrapFnReferenceResolverV1.create(repository, budget)
    if created.is_err(): return Err(created.unwrap_err())
    val resolver = created.unwrap()
    if not budget.reserve(8192): return Err("bootstrap writer allocation bound")
    var writer = BootstrapOwnerWireWriterV1.create("function_registry",
        repository.final_repository_authority, repository.authority, budget)
    for registry in bootstrap_fn_registry_names_v1():
        val count = _snapshot_count_v1(state, registry)
        # An unavailable native extent is an explicit refusal, never a
        # keys()-allocation fallback or guessed empty map.
        if count < 0 or count > BOOTSTRAP_OWNER_MAX_ROWS_V1 - writer.rows:
            return Err("bootstrap dictionary extent unavailable or row bound exceeded")
        if not budget.reserve(count * 128 + 128): return Err("bootstrap key snapshot allocation bound")
        val keys = _snapshot_keys_v1(state, registry)
        if keys.len() != count: return Err("bootstrap dictionary extent differs from actual keys")
        var key_bytes: i64 = 0
        for key in keys:
            val bytes = text_byte_len(key)
            if bytes <= 0 or bytes > BOOTSTRAP_OWNER_MAX_BYTES_V1 - key_bytes:
                return Err("bootstrap dictionary key byte bound")
            key_bytes = key_bytes + bytes
        if not budget.reserve(key_bytes * 4 + 128): return Err("bootstrap key order allocation bound")
        val ordered = hc_order_text_keys_v1(keys)
        if not budget.reserve(128) or not writer.append("@map", registry, SdnValue.Int(count)):
            return Err("bootstrap owner map header refused")
        for name in ordered:
            if not budget.reserve(4096): return Err("bootstrap row allocation bound")
            val value = _snapshot_value_v1(state, registry, name, resolver)
            if value.is_err(): return Err(value.unwrap_err())
            if not writer.append(registry, name, value.unwrap()): return Err("bootstrap owner row bound")
            writer.rows = writer.rows + 1
    writer.finish()

fn _snapshot_assign_v1(state: BootstrapFnRegistryStateV1, registry: text, name: text,
        value: SdnValue, resolver: BootstrapFnReferenceResolverV1,
        events: Dict<i64, bool>) -> Result<i64, text>:
    match registry:
        case "fn_ret_hir_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_ret_hir_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_shapes":
            match value:
                case SdnValue.String(item): state.fn_ret_shapes[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_shape_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_ret_shape_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_array_element_shapes":
            match value:
                case SdnValue.String(item): state.fn_ret_array_element_shapes[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_array_element_identities":
            match value:
                case SdnValue.String(item): state.fn_ret_array_element_identities[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_array_element_shape_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_ret_array_element_shape_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_ok_shapes":
            match value:
                case SdnValue.String(item): state.fn_ret_ok_shapes[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_ok_shape_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_ret_ok_shape_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_err_shapes":
            match value:
                case SdnValue.String(item): state.fn_ret_err_shapes[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_opt_shapes":
            match value:
                case SdnValue.String(item): state.fn_ret_opt_shapes[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_ret_opt_shape_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_ret_opt_shape_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_param_hir_rejected":
            match value:
                case SdnValue.Bool(item): state.fn_param_hir_rejected[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_param_defaults_ambig":
            match value:
                case SdnValue.Bool(item): state.fn_param_defaults_ambig[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case "fn_param_default_owners":
            match value:
                case SdnValue.String(item): state.fn_param_default_owners[name] = item
                case _: return Err("bootstrap scalar row type differs")
            return Ok(0)
        case _: ()
    val resolved = resolver.resolve(registry, value)
    if resolved.is_err(): return Err(resolved.unwrap_err())
    val reference = resolved.unwrap()
    if events.has(reference.event): return Err("bootstrap registration event duplicated")
    events[reference.event] = true
    match registry:
        case "fn_ret_types":
            val actual = bootstrap_fn_str_mir_value_v1(reference)
            if actual.is_err(): return Err(actual.unwrap_err())
            state.fn_ret_types[name] = actual.unwrap()
        case "fn_ret_hir_types":
            val actual = bootstrap_fn_return_hir_value_v1(reference)
            if actual.is_err(): return Err(actual.unwrap_err())
            state.fn_ret_hir_types[name] = actual.unwrap()
        case "fn_param_hir_types":
            val actual = bootstrap_fn_parameter_hir_value_v1(reference, resolver.budget)
            if actual.is_err(): return Err(actual.unwrap_err())
            state.fn_param_hir_types[name] = actual.unwrap()
        case "fn_param_defaults":
            val actual = bootstrap_fn_parameters_value_v1(resolver, reference)
            if actual.is_err(): return Err(actual.unwrap_err())
            state.fn_param_defaults[name] = actual.unwrap()
        case "default_provider_symbols":
            state.default_provider_symbols[name] = bootstrap_fn_symbols_value_v1(reference)
        case "default_provider_globals":
            val actual = bootstrap_fn_globals_value_v1(resolver, reference)
            if actual.is_err(): return Err(actual.unwrap_err())
            state.default_provider_globals[name] = actual.unwrap()
        case _: return Err("bootstrap typed registry unknown")
    var symbol: i64 = -1
    var digest = ""
    if val function = reference.function:
        symbol = function.symbol.id
        digest = function.complete_function_digest
    val origin_registry = bootstrap_fn_origin_registry_v1(registry)
    val key = _snapshot_origin_key_v1(origin_registry, name)
    state.origins[key] = BootstrapFnRegistrationOriginV1(bound: true, registry: origin_registry,
        row_name: name, repository_authority: resolver.repository.final_repository_authority,
        module_key: mir_hir_reference_module_key_v1(reference.module),
        declaration_digest: reference.module.declaration_digest, function_digest: digest,
        function_symbol: symbol, selector: bootstrap_fn_reference_selector_v1(registry),
        write_event: reference.event)
    Ok(reference.event)

fn bootstrap_fn_registry_snapshot_prepare_v1(blob: text, expected_digest: text,
        repository: MirHirDeclarationRepositoryV1) -> Result<BootstrapFnRegistryPreparedV1, text>:
    val budget = BootstrapOwnerBudgetV1.create()
    bootstrap_fn_registry_snapshot_prepare_budgeted_v1(blob, expected_digest, repository, budget)

fn bootstrap_fn_registry_snapshot_prepare_budgeted_v1(blob: text, expected_digest: text,
        repository: MirHirDeclarationRepositoryV1, budget: BootstrapOwnerBudgetV1) -> Result<BootstrapFnRegistryPreparedV1, text>:
    val bytes = text_byte_len(blob)
    if not sha256_lower_hex_valid(expected_digest) or bytes > BOOTSTRAP_OWNER_MAX_BYTES_V1:
        return Err("bootstrap registry snapshot digest or bound differs")
    if not budget.reserve(bytes * 2 + 256): return Err("bootstrap snapshot hash allocation bound")
    if sha256_text(blob) != expected_digest: return Err("bootstrap registry snapshot digest differs")
    val created = BootstrapFnReferenceResolverV1.create(repository, budget)
    if created.is_err(): return Err(created.unwrap_err())
    val resolver = created.unwrap()
    val opened = BootstrapOwnerWireReaderV1.create(blob, "function_registry",
        repository.final_repository_authority, repository.authority, budget)
    if opened.is_err(): return Err(opened.unwrap_err())
    var reader = opened.unwrap()
    if not budget.reserve(8192): return Err("bootstrap private owner allocation bound")
    var candidate = BootstrapFnRegistryStateV1.empty()
    var events: Dict<i64, bool> = {}
    var rows: i64 = 0
    var origin_rows: i64 = 0
    var maximum_event: i64 = 0
    var origin_bytes: i64 = 0
    for registry in bootstrap_fn_registry_names_v1():
        val header = reader.next()
        if header.is_err(): return Err(header.unwrap_err())
        val cells = header.unwrap()
        if cells[0].as_str() != Some("@map") or cells[1].as_str() != Some(registry):
            return Err("bootstrap registry inventory missing, reordered or unknown")
        val count = cells[2].as_i64() ?? -1
        if count < 0 or count > BOOTSTRAP_OWNER_MAX_ROWS_V1 - rows:
            return Err("bootstrap registry row count bound")
        var index: i64 = 0
        while index < count:
            val entry = reader.next()
            if entry.is_err(): return Err(entry.unwrap_err())
            val values = entry.unwrap()
            val name = values[1].as_str() ?? ""
            if values[0].as_str() != Some(registry) or name == "" or _snapshot_has_v1(candidate, registry, name):
                return Err("bootstrap registry row unknown, duplicate or misplaced")
            if not budget.reserve(2048): return Err("bootstrap private row allocation bound")
            val installed = _snapshot_assign_v1(candidate, registry, name, values[2], resolver, events)
            if installed.is_err(): return Err(installed.unwrap_err())
            val event = installed.unwrap()
            if event > 0:
                origin_rows = origin_rows + 1
                origin_bytes = origin_bytes + 1024 + (text_byte_len(bootstrap_fn_origin_registry_v1(registry)) + text_byte_len(name)) * 4
            if event > maximum_event: maximum_event = event
            rows = rows + 1
            index = index + 1
    if not reader.finished(): return Err("bootstrap registry trailing data")
    # Exact re-export compares actual reconstructed typed state, not just the
    # caller-supplied reference strings or receipt fields. Nothing is live yet.
    val equivalence = bootstrap_fn_registry_snapshot_encode_budgeted_v1(candidate, repository, budget)
    if equivalence.is_err(): return Err(equivalence.unwrap_err())
    val snapshot = equivalence.unwrap()
    if snapshot.body != blob or snapshot.digest != expected_digest or snapshot.rows != rows:
        return Err("bootstrap private owner semantic equivalence differs")
    Ok(BootstrapFnRegistryPreparedV1(state: candidate, snapshot: snapshot,
        maximum_event: maximum_event, origin_rows: origin_rows, origin_bytes: origin_bytes))

export BootstrapFnRegistryPreparedV1
export bootstrap_fn_registry_snapshot_encode_v1, bootstrap_fn_registry_snapshot_encode_budgeted_v1
export bootstrap_fn_registry_snapshot_prepare_v1, bootstrap_fn_registry_snapshot_prepare_budgeted_v1
