# Compiler-owned RT/HAL lifecycle regression seam.
#
# This is the sole executable test owner permitted to invoke the package-only
# V3 cold host preparation. Generic tests receive only its final result.

use std.common.env_access.model.*
use std.common.env_access.plan_sdn.*
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}
use std.nogc_sync_mut.rt_hal.process_task_arena.{
    rt_hal_process_arena_reset, rt_hal_process_arena_shutdown,
    rt_hal_process_controller_claim, rt_hal_process_lifecycle_begin_draining,
    rt_hal_process_lifecycle_fail_install, rt_hal_process_lifecycle_finish_closed,
    rt_hal_process_lifecycle_is_draining, rt_hal_process_lifecycle_is_installing,
    rt_hal_process_lifecycle_is_closed, rt_hal_process_lifecycle_is_ready,
    rt_hal_process_exact_arena
}
use std.nogc_sync_mut.rt_hal.exit_arena.{
    rt_hal_exact_exit_arena_install,
    rt_hal_exact_exit_schema_bind_descriptors_and_seal,
    rt_hal_exact_exit_controller_seal
}
use app.io.rt_hal_isolated_host.{rt_hal_compiler_stage_isolated_exact_host}

fn rt_hal_stage_test_operation(adapter: i64) -> EnvRtHalOperationPlan:
    # Adapter 4 is the independent effect-replay ABI. Ready must therefore
    # prove the full query+effect catalog, not a query-only shortcut.
    EnvRtHalOperationPlan(
        operation_id: "test/rt_hal_compiler_stage.spl::query",
        c_adapter_id: adapter, rust_adapter_id: 0,
        effect_capable: true, c_effect_adapter_id: 4, rust_effect_adapter_id: 0
    )

fn rt_hal_stage_test_plan(plan_id: text, executable: text) -> EnvAccessPlan:
    EnvAccessPlan(
        plan_id: plan_id, canonical_repo_root: "/workspace/rt-hal",
        instructions: [], max_total_bytes: 512, max_processes: 1,
        allowed_tools: [EnvToolIdentity(
            tool_id: "c-provider", canonical_path: executable,
            identity_hash: "sha256:" + file_hash_sha256(executable)
        )], allowed_hardware_probes: []
    )

fn rt_hal_stage_test_install(plan: EnvAccessPlan,
        operations: [EnvRtHalOperationPlan]) -> EnvAccessPlanInstallV1:
    EnvAccessPlanInstallV1(
        plan: plan, compare_c: true, compare_rust: false,
        c_tool_id: "c-provider", rust_tool_id: "",
        worker_count: 1, queue_capacity: 1, timeout_ticks: 100,
        max_output_bytes: 512, required_assurance_rank: 2,
        rt_hal_operations: operations
    )

# Always attempt terminal cleanup before returning the harness result. Failed
# installation moves to Draining first; shutdown then owns acknowledged close.
fn rt_hal_stage_test_cleanup() -> text:
    if rt_hal_process_lifecycle_is_ready():
        val claim = rt_hal_process_controller_claim()
        if claim != "": return claim
        if not rt_hal_process_lifecycle_begin_draining(): return "RTHAL-E-TEST-DRAIN"
    elif rt_hal_process_lifecycle_is_installing():
        rt_hal_process_lifecycle_fail_install()
    # `fail_install` deliberately retains a partially bound arena in
    # Draining. Re-read the state after that transition: an `elif` here would
    # strand its host/wire leases until a later, unrelated test happened to
    # clean them up.
    if rt_hal_process_lifecycle_is_draining():
        val stopped = rt_hal_process_arena_shutdown()
        if stopped != "": return stopped
        if not rt_hal_process_lifecycle_finish_closed(): return "RTHAL-E-TEST-CLOSE"
    ""

fn rt_hal_stage_test_closed_without_host() -> text:
    # `finish_closed` already proves every bounded host, wire, registry and
    # task field was released. Keep the availability check as an executable
    # regression against accidentally retaining the base host after a failed
    # cold installation.
    if not rt_hal_process_lifecycle_is_closed(): return "RTHAL-E-TEST-NOT-CLOSED"
    if rt_hal_process_exact_arena().capabilities.available:
        return "RTHAL-E-TEST-HOST-RETAINED"
    ""

fn rt_hal_stage_test_forced_pre_ready_failure(
        install: EnvAccessPlanInstallV1, identity: text) -> text:
    # Force the precise failure window: the cold host has bound its bounded
    # ports, but no exit schema/controller seal has published Ready yet.
    var outcome = rt_hal_compiler_stage_isolated_exact_host(install, identity)
    if outcome == "" and not rt_hal_process_lifecycle_is_installing():
        outcome = "RTHAL-E-TEST-NOT-INSTALLING"
    if outcome == "":
        rt_hal_process_lifecycle_fail_install()
    val cleanup = rt_hal_stage_test_cleanup()
    if outcome != "": return outcome
    if cleanup != "": return cleanup
    rt_hal_stage_test_closed_without_host()

pub fn rt_hal_compiler_stage_lifecycle_harness() -> text:
    # Do not let another test/lifetime leak state into this compiler cold path.
    val reset = rt_hal_process_arena_reset()
    if reset != "":
        val cleanup = rt_hal_stage_test_cleanup()
        if cleanup != "": return cleanup
        return reset
    val executable = "/bin/true"
    # Same rank, tools and bounds; only canonical plan/map identity differs.
    val install_a = rt_hal_stage_test_install(
        rt_hal_stage_test_plan("compiler-plan-a", executable),
        [rt_hal_stage_test_operation(1)])
    val install_b = rt_hal_stage_test_install(
        rt_hal_stage_test_plan("compiler-plan-b", executable),
        [rt_hal_stage_test_operation(2)])
    val identity_a = match env_access_plan_canonical_identity_v1(install_a):
        case Err(problem): return problem
        case Ok(value): value
    val identity_b = match env_access_plan_canonical_identity_v1(install_b):
        case Err(problem): return problem
        case Ok(value): value
    if identity_a == identity_b: return "RTHAL-E-TEST-IDENTITY"

    # A failed staged preparation is not allowed to leave a Draining arena
    # behind. The subsequent Plan A install below is the fresh-state proof.
    val forced_failure = rt_hal_stage_test_forced_pre_ready_failure(install_a, identity_a)
    if forced_failure != "": return forced_failure

    var outcome = rt_hal_compiler_stage_isolated_exact_host(install_a, identity_a)
    if outcome == "":
        if not rt_hal_exact_exit_arena_install(4, 4096):
            outcome = "RTHAL-E-TEST-ARENA"
        elif not rt_hal_exact_exit_schema_bind_descriptors_and_seal(
            1, "v2;text:utf8", 2, "v2;text:utf8", 2, "v2;unit", 0
        ):
            outcome = "RTHAL-E-TEST-SCHEMA"
        elif not rt_hal_exact_exit_controller_seal():
            outcome = "RTHAL-E-TEST-SEAL"
        elif not rt_hal_process_lifecycle_is_ready():
            outcome = "RTHAL-E-TEST-NOT-READY"
        else:
            val rejected = rt_hal_compiler_stage_isolated_exact_host(install_b, identity_b)
            if rejected != "RTHAL-E-LIFECYCLE":
                outcome = "RTHAL-E-TEST-PLAN-B:" + rejected
    val cleanup = rt_hal_stage_test_cleanup()
    if outcome != "": return outcome
    if cleanup != "": return cleanup
    rt_hal_stage_test_closed_without_host()
