fn mir_hir_write_nominal_declaration_v1(writer: HirCodecWriter, declaration: MirHirNominalDeclarationV1):
    writer.put_text(declaration.layout_digest)
    if declaration.symbol == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_symbol_id(writer, declaration.symbol)
    writer.put_text(declaration.name)
    if declaration.kind == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_symbol_kind(writer, declaration.kind)
    writer.put_i64(declaration.type_params.len())
    var index_9 = 0
    while index_9 < declaration.type_params.len():
        val item_10: HirTypeParam = declaration.type_params[index_9]
        if item_10 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_hir_type_param(writer, item_10)
        index_9 = index_9 + 1
    writer.put_i64(declaration.fields.len())
    var index_11 = 0
    while index_11 < declaration.fields.len():
        val item_12: MirHirFieldDeclarationV1 = declaration.fields[index_11]
        if item_12 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_field_declaration_v1(writer, item_12)
        index_11 = index_11 + 1
    writer.put_i64(declaration.methods.len())
    for key_13 in declaration.methods.keys().sort():
        writer.put_text(key_13)
        if declaration.methods[key_13] == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_symbol_id(writer, declaration.methods[key_13])
    writer.put_bool(declaration.has_layout_attr)
    if declaration.layout_attr == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_layout_attr(writer, declaration.layout_attr)
    writer.put_bool(declaration.has_export_attr)
    if val optional_14 = declaration.export_attr:
        writer.put_i64(1)
        if optional_14 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_export_attr(writer, optional_14)
    else:
        writer.put_i64(0)
    if declaration.visibility == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_visibility(writer, declaration.visibility)
    writer.put_bool(declaration.is_public)
    writer.put_bool(declaration.is_generic_template)
    if declaration.span == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_span(writer, declaration.span)

