fn mir_hir_write_module_declarations_v1(writer: HirCodecWriter, declaration: MirHirModuleDeclarationsV1):
    writer.put_text(declaration.name)
    writer.put_text(declaration.path)
    if val source = declaration.source_binding:
        writer.put_i64(1)
        writer.put_text(source.logical_key)
        writer.put_text(source.physical_path)
        writer.put_text(source.source_digest)
        writer.put_i64(source.source_bytes)
        writer.put_text(source.input_archive_key)
    else:
        writer.put_i64(0)
    writer.put_text(declaration.final_repository_authority)
    writer.put_text(declaration.final_archive_key)
    writer.put_text(declaration.final_body_digest)
    if declaration.symbols == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_symbol_table(writer, declaration.symbols)
    writer.put_i64(declaration.functions.len())
    var index_38 = 0
    while index_38 < declaration.functions.len():
        val item_39: MirHirFunctionDeclarationV1 = declaration.functions[index_38]
        if item_39 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_function_declaration_v1(writer, item_39)
        index_38 = index_38 + 1
    writer.put_i64(declaration.structs.len())
    var index_40 = 0
    while index_40 < declaration.structs.len():
        val item_41: MirHirNominalDeclarationV1 = declaration.structs[index_40]
        if item_41 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_nominal_declaration_v1(writer, item_41)
        index_40 = index_40 + 1
    writer.put_i64(declaration.classes.len())
    var index_42 = 0
    while index_42 < declaration.classes.len():
        val item_43: MirHirNominalDeclarationV1 = declaration.classes[index_42]
        if item_43 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_nominal_declaration_v1(writer, item_43)
        index_42 = index_42 + 1
    writer.put_i64(declaration.enums.len())
    var index_44 = 0
    while index_44 < declaration.enums.len():
        val item_45: MirHirEnumDeclarationV1 = declaration.enums[index_44]
        if item_45 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_enum_declaration_v1(writer, item_45)
        index_44 = index_44 + 1
    writer.put_i64(declaration.bitfields.len())
    var index_46 = 0
    while index_46 < declaration.bitfields.len():
        val item_47: HirBitfield = declaration.bitfields[index_46]
        if item_47 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_hir_bitfield(writer, item_47)
        index_46 = index_46 + 1
    writer.put_i64(declaration.traits.len())
    var index_48 = 0
    while index_48 < declaration.traits.len():
        val item_49: MirHirTraitDeclarationV1 = declaration.traits[index_48]
        if item_49 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_trait_declaration_v1(writer, item_49)
        index_48 = index_48 + 1
    writer.put_i64(declaration.impls.len())
    var index_50 = 0
    while index_50 < declaration.impls.len():
        val item_51: HirImpl = declaration.impls[index_50]
        if item_51 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_hir_impl(writer, item_51)
        index_50 = index_50 + 1
    writer.put_i64(declaration.globals.len())
    var index_52 = 0
    while index_52 < declaration.globals.len():
        val item_53: MirHirGlobalDeclarationV1 = declaration.globals[index_52]
        if item_53 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_global_declaration_v1(writer, item_53)
        index_52 = index_52 + 1
    writer.put_bool(declaration.needs_initialization)
    writer.put_text(declaration.stage)

fn mir_hir_write_declaration_repository_v1(writer: HirCodecWriter, declaration: MirHirDeclarationRepositoryV1):
    writer.put_text(declaration.artifact_context.directory)
    writer.put_text(declaration.artifact_context.producer_header)
    writer.put_bool(declaration.artifact_context.enabled)
    writer.put_text(declaration.final_repository_authority)
    writer.put_i64(declaration.ordered_modules.len())
    var index_54 = 0
    while index_54 < declaration.ordered_modules.len():
        val item_55: text = declaration.ordered_modules[index_54]
        writer.put_text(item_55)
        index_54 = index_54 + 1
    writer.put_i64(declaration.modules.len())
    for key_56 in declaration.modules.keys().sort():
        writer.put_text(key_56)
        if declaration.modules[key_56] == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_module_declarations_v1(writer, declaration.modules[key_56])

fn mir_hir_write_expression_artifact_v1(writer: HirCodecWriter, declaration: MirHirExpressionArtifactV1):
    writer.put_text(declaration.final_repository_authority)
    writer.put_text(declaration.final_archive_key)
    writer.put_text(declaration.final_body_digest)
    writer.put_text(declaration.module_name)
    writer.put_text(declaration.source_path)
    writer.put_text(declaration.category)
    writer.put_i64(declaration.declaration_symbol)
    writer.put_i64(declaration.member_index)
    writer.put_text(declaration.member_name)
    writer.put_text(declaration.expression_digest)
    writer.put_text(declaration.archive_key)
    writer.put_text(declaration.stage)

fn mir_hir_module_declaration_digest_v1(module: MirHirModuleDeclarationsV1) -> text:
    var writer = HirCodecWriter.create()
    mir_hir_write_module_declarations_v1(writer, module)
    if not writer.ok: return ""
    sha256_text("mir-hir-module-declarations-digest-v2\n" + writer.finish())

fn mir_hir_declaration_repository_digest_v1(repository: MirHirDeclarationRepositoryV1) -> text:
    var writer = HirCodecWriter.create()
    mir_hir_write_declaration_repository_v1(writer, repository)
    if not writer.ok: return ""
    sha256_text("mir-hir-declaration-repository-v2\n" + writer.finish())
