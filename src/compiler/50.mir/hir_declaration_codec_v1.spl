# Stable typed declaration seals. Map order is explicit and independent of allocation.
use compiler.mir.hir_declaration_types_v1.{MirHirParamDeclarationV1, MirHirFunctionDeclarationV1,
    MirHirFieldDeclarationV1, MirHirNominalDeclarationV1, MirHirVariantDeclarationV1,
    MirHirEnumDeclarationV1, MirHirTraitDeclarationV1, MirHirGlobalDeclarationV1,
    MirHirDeclarationSourceV1, MirHirModuleDeclarationsV1, MirHirDeclarationRepositoryV1,
    MirHirCallableDefaultsV1}
use compiler.mir.hir_expression_artifact_v1.{MirHirExpressionArtifactV1}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.attributes.{FunctionAttr, ExportAttr}
use compiler.types.type_layout.{LayoutAttr}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.*
use std.common.crypto.sha256.{sha256_text}

fn mir_hir_write_param_declaration_v1(writer: HirCodecWriter, declaration: MirHirParamDeclarationV1):
    if declaration.symbol == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_symbol_id(writer, declaration.symbol)
    writer.put_text(declaration.name)
    if declaration.type_ == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_hir_type(writer, declaration.type_)
    writer.put_bool(declaration.has_default)
    if val optional_1 = declaration.default_artifact:
        writer.put_i64(1)
        if optional_1 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_expression_artifact_v1(writer, optional_1)
    else:
        writer.put_i64(0)
    if declaration.span == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_span(writer, declaration.span)
    writer.put_bool(declaration.is_mutable)

fn mir_hir_write_function_declaration_v1(writer: HirCodecWriter, declaration: MirHirFunctionDeclarationV1):
    writer.put_text(declaration.complete_function_digest)
    if declaration.symbol == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_symbol_id(writer, declaration.symbol)
    writer.put_text(declaration.name)
    writer.put_i64(declaration.type_params.len())
    var index_2 = 0
    while index_2 < declaration.type_params.len():
        val item_3: HirTypeParam = declaration.type_params[index_2]
        if item_3 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_hir_type_param(writer, item_3)
        index_2 = index_2 + 1
    writer.put_i64(declaration.params.len())
    var index_4 = 0
    while index_4 < declaration.params.len():
        val item_5: MirHirParamDeclarationV1 = declaration.params[index_4]
        if item_5 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            mir_hir_write_param_declaration_v1(writer, item_5)
        index_4 = index_4 + 1
    if declaration.return_type == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_hir_type(writer, declaration.return_type)
    writer.put_i64(declaration.effects.len())
    var index_6 = 0
    while index_6 < declaration.effects.len():
        val item_7: Effect = declaration.effects[index_6]
        if item_7 == nil:
            writer.put_i64(0)
        else:
            writer.put_i64(1)
            hc_enc_effect(writer, item_7)
        index_6 = index_6 + 1
    if declaration.visibility == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_visibility(writer, declaration.visibility)
    writer.put_bool(declaration.is_async)
    writer.put_bool(declaration.is_static)
    writer.put_bool(declaration.is_public)
    writer.put_bool(declaration.is_method)
    writer.put_bool(declaration.is_mutable)
    writer.put_bool(declaration.is_const)
    writer.put_bool(declaration.is_extern)
    if declaration.func_attr == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_function_attr(writer, declaration.func_attr)
    writer.put_bool(declaration.has_export_attr)
    if declaration.export_attr == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_export_attr(writer, declaration.export_attr)
    writer.put_bool(declaration.is_generic_template)
    if declaration.span == nil:
        writer.put_i64(0)
    else:
        writer.put_i64(1)
        hc_enc_span(writer, declaration.span)

