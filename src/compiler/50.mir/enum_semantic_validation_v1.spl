# EE-01 physical MIR validation. This record is data, never a capability:
# consumers must bind it to the actual module/function before interpreting it.
use std.common.crypto.sha256.{sha256_text}
use compiler.common.error.{CompileError}
use compiler.hir.hir_types.{SymbolId}
use compiler.core.interpreter.hashmap.{hm_hash_text}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind,
    MirLocal, LocalId, MirSignature, MirConstValue}
use compiler.mir.mir_instruction_graph.{MirModule, MirFunction, MirBlock}
use compiler.mir.mir_instruction_support.{BlockId, MirOperand, MirOperandKind,
    MirTerminator, AggregateKind}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_enum_semantic_types.*
use compiler.mir.mir_json.{serialize_mir_function_subject_v1,
    serialize_mir_inst_kind, serialize_mir_terminator, serialize_mir_type}
use compiler.mir.enum_pattern_totality_v1.{enum_pattern_decision_plan_v1, EnumPatternDecisionPlanV1}
use compiler.mir.enum_pattern_physical_v1.{enum_pattern_physical_plan_v1}
use compiler.mir.enum_semantic_identity_v1.{enum_semantic_declaration_identity_v1}

struct ValidatedEnumSemanticsV1:
    physical_function: MirFunction
    semantic_function: MirFunction
    matches: [MirEnumMatchSemanticV1]
    block_indices: Dict<i64, i64>
    declarations: Dict<i64, MirTypeDef>
    work_remaining: i64
    replaced_instruction_sites: Dict<text, bool>
    replaced_terminator_blocks: Dict<i64, bool>
    match_entry_instruction_indices: Dict<i64, i64>
    decision_plans: Dict<i64, EnumPatternDecisionPlanV1>

class EnumPhysicalValidatorV1:
    module: MirModule
    function: MirFunction
    remaining: i64
    blocks: Dict<i64, i64>
    locals: Dict<i64, i64>
    declarations: Dict<i64, MirTypeDef>
    projected: Dict<i64, MirType>
    binding_types: Dict<i64, MirType>
    sites: Dict<text, bool>
    guard_arms: Dict<text, MirEnumArmSemanticV1>
    guard_sites: Dict<text, bool>
    runtime_declarations: Dict<i64, MirEnumDeclarationIdentityV1>
    replaced_instructions: Dict<text, bool>
    replaced_terminators: Dict<i64, bool>
    match_offsets: Dict<i64, i64>
    decision_plans: Dict<i64, EnumPatternDecisionPlanV1>
    defined_locals: Dict<i64, bool>
    multiple_definitions: Dict<i64, bool>

impl EnumPhysicalValidatorV1:
    me charge(amount: i64) -> Result<(), text>:
        if amount < 0 or amount > self.remaining:
            return Err("EE-E-LIMIT: function validation work budget exhausted")
        self.remaining = self.remaining - amount
        Ok(())

    me type_projection(type_: MirType, depth: i64) -> Result<MirType, text>:
        self.charge(1)?
        if depth > 128:
            return Err("EE-E-LIMIT: type nesting exceeds 128")
        val next = depth + 1
        match type_.kind:
            case MirTypeKind.Struct(owner):
                if val definition = self.declarations.get(owner.id):
                    match definition.kind:
                        case MirTypeDefKind.Enum(_):
                            return Ok(MirType(kind: MirTypeKind.Enum(owner)))
                        case _: ()
                Ok(type_)
            case MirTypeKind.Enum(owner):
                if not self.declarations.contains_key(owner.id):
                    return Err("EE-E-DECLARATION: semantic enum owner is missing")
                match self.declarations[owner.id].kind:
                    case MirTypeDefKind.Enum(_): Ok(type_)
                    case _: Err("EE-E-DECLARATION: semantic enum owner is not an enum")
            case MirTypeKind.Tuple(elements):
                self.charge(elements.len())?
                var result: [MirType] = []
                for element in elements:
                    result.push(self.type_projection(element, next)?)
                Ok(MirType(kind: MirTypeKind.Tuple(result)))
            case MirTypeKind.Ptr(inner, mutable):
                Ok(MirType(kind: MirTypeKind.Ptr(self.type_projection(inner, next)?, mutable)))
            case MirTypeKind.Ref(inner, mutable):
                Ok(MirType(kind: MirTypeKind.Ref(self.type_projection(inner, next)?, mutable)))
            case MirTypeKind.Array(inner, size):
                Ok(MirType(kind: MirTypeKind.Array(self.type_projection(inner, next)?, size)))
            case MirTypeKind.Slice(inner):
                Ok(MirType(kind: MirTypeKind.Slice(self.type_projection(inner, next)?)))
            case MirTypeKind.Dict(key, value):
                Ok(MirType(kind: MirTypeKind.Dict(self.type_projection(key, next)?,
                    self.type_projection(value, next)?)))
            case MirTypeKind.Result(ok, err):
                Ok(MirType(kind: MirTypeKind.Result(self.type_projection(ok, next)?,
                    self.type_projection(err, next)?)))
            case MirTypeKind.FuncPtr(signature):
                Ok(MirType(kind: MirTypeKind.FuncPtr(self.signature_projection(signature, next)?)))
            case MirTypeKind.Union(members):
                self.charge(members.len())?
                var result: [MirType] = []
                for member in members: result.push(self.type_projection(member, next)?)
                Ok(MirType(kind: MirTypeKind.Union(result)))
            case MirTypeKind.Promise(inner):
                Ok(MirType(kind: MirTypeKind.Promise(self.type_projection(inner, next)?)))
            case MirTypeKind.ActorType(inner):
                Ok(MirType(kind: MirTypeKind.ActorType(self.type_projection(inner, next)?)))
            case MirTypeKind.Generator(yield_, return_):
                Ok(MirType(kind: MirTypeKind.Generator(self.type_projection(yield_, next)?,
                    self.type_projection(return_, next)?)))
            case MirTypeKind.ScalableVec(inner, lanes):
                Ok(MirType(kind: MirTypeKind.ScalableVec(self.type_projection(inner, next)?, lanes)))
            case MirTypeKind.Opaque(name):
                self.charge(name.len())?
                Ok(type_)
            case _: Ok(type_)

    me signature_projection(signature: MirSignature, depth: i64) -> Result<MirSignature, text>:
        self.charge(signature.params.len() + signature.declared_params.len() + 1)?
        if depth > 128: return Err("EE-E-LIMIT: signature depth exceeds 128")
        var params: [MirType] = []
        var declared: [MirType] = []
        for type_ in signature.params: params.push(self.type_projection(type_, depth + 1)?)
        for type_ in signature.declared_params:
            declared.push(self.type_projection(type_, depth + 1)?)
        Ok(MirSignature(params: params,
            return_type: self.type_projection(signature.return_type, depth + 1)?,
            is_variadic: signature.is_variadic, params_known: signature.params_known,
            declared_params: declared, declared_params_known: signature.declared_params_known))

    me same_type(left: MirType, right: MirType) -> Result<bool, text>:
        # Bound both trees before recursive canonical serialization.
        self.type_projection(left, 0)?
        self.type_projection(right, 0)?
        Ok(serialize_mir_type(left) == serialize_mir_type(right))

    me local_type(local: LocalId) -> Result<MirType, text>:
        self.charge(1)?
        if not self.locals.contains_key(local.id):
            return Err("EE-E-AVAILABILITY: local is outside the actual function")
        Ok(self.function.locals[self.locals[local.id]].type_)

    me constant(value: MirConstValue, depth: i64) -> Result<(), text>:
        self.charge(1)?
        if depth > 128: return Err("EE-E-LIMIT: constant depth exceeds 128")
        match value:
            case MirConstValue.Array(elements):
                self.charge(elements.len())?
                for element in elements: self.constant(element, depth + 1)?
            case MirConstValue.Tuple(elements):
                self.charge(elements.len())?
                for element in elements: self.constant(element, depth + 1)?
            case MirConstValue.Struct(fields):
                for name, element in fields:
                    self.charge(name.len() + 1)?
                    self.constant(element, depth + 1)?
            case MirConstValue.Str(value): self.charge(value.len())?
            case MirConstValue.FloatLexeme(value): self.charge(value.len())?
            case _: ()
        Ok(())

    me operand_type(operand: MirOperand) -> Result<MirType, text>:
        self.charge(1)?
        match operand.kind:
            case MirOperandKind.Copy(local): self.local_type(local)
            case MirOperandKind.Move(local): self.local_type(local)
            case MirOperandKind.Const(value, type_):
                self.constant(value, 0)?
                self.type_projection(type_, 0)?
                Ok(type_)

    me same_operand(left: MirOperand, right: MirOperand) -> Result<bool, text>:
        self.operand_type(left)?
        self.operand_type(right)?
        match left.kind:
            case MirOperandKind.Copy(a):
                match right.kind:
                    case MirOperandKind.Copy(b): return Ok(a.id == b.id)
                    case _: return Ok(false)
            case MirOperandKind.Move(a):
                match right.kind:
                    case MirOperandKind.Move(b): return Ok(a.id == b.id)
                    case _: return Ok(false)
            case MirOperandKind.Const(_, _):
                # Reuse canonical terminator encoding to retain exact constants.
                Ok(serialize_mir_terminator(MirTerminator.Ret(Some(left))) ==
                    serialize_mir_terminator(MirTerminator.Ret(Some(right))))

    me block(block: BlockId) -> Result<MirBlock, text>:
        self.charge(1)?
        if not self.blocks.contains_key(block.id):
            return Err("EE-E-EDGE: block is outside the actual function")
        Ok(self.function.blocks[self.blocks[block.id]])

    me cursor(block: BlockId, offset: i64) -> Result<(), text>:
        val actual = self.block(block)?
        if offset < 0 or offset > actual.instructions.len():
            return Err("EE-E-SITE: entry instruction offset is out of range")
        Ok(())

    me define(local: LocalId) -> Result<(), text>:
        self.charge(1)?
        if self.defined_locals.contains_key(local.id):
            self.multiple_definitions[local.id] = true
        self.defined_locals[local.id] = true
        Ok(())

    me instruction(kind: MirInstKind) -> Result<(), text>:
        self.charge(1)?
        match kind:
            case MirInstKind.Const(dest, value, type_):
                self.define(dest)?
                self.local_type(dest)?
                self.constant(value, 0)?
                self.type_projection(type_, 0)?
            case MirInstKind.Copy(dest, source):
                self.define(dest)?
                self.local_type(dest)?
                self.local_type(source)?
            case MirInstKind.Move(dest, source):
                self.define(dest)?
                self.local_type(dest)?
                self.local_type(source)?
            case MirInstKind.BinOp(dest, _, left, right):
                self.define(dest)?
                self.local_type(dest)?
                self.operand_type(left)?
                self.operand_type(right)?
            case MirInstKind.UnaryOp(dest, _, operand):
                self.define(dest)?
                self.local_type(dest)?
                self.operand_type(operand)?
            case MirInstKind.Cast(dest, operand, target):
                self.define(dest)?
                self.local_type(dest)?
                self.operand_type(operand)?
                self.type_projection(target, 0)?
            case MirInstKind.Call(dest, callee, args):
                if val local = dest:
                    self.define(local)?
                    self.local_type(local)?
                self.operand_type(callee)?
                self.charge(args.len())?
                for arg in args: self.operand_type(arg)?
            case MirInstKind.Aggregate(dest, aggregate, operands):
                self.define(dest)?
                self.local_type(dest)?
                match aggregate:
                    case AggregateKind.Array(type_): self.type_projection(type_, 0)?
                    case _: ()
                self.charge(operands.len())?
                for operand in operands: self.operand_type(operand)?
            case MirInstKind.GetField(dest, base, field):
                self.define(dest)?
                self.local_type(dest)?
                self.operand_type(base)?
                if field < 0: return Err("EE-E-SITE: negative physical field index")
            case MirInstKind.Drop(local):
                self.local_type(local)?
            case _:
                return Err("EE-E-SITE: unsupported physical instruction in semantic subject")
        Ok(())

    me terminator(term: MirTerminator) -> Result<(), text>:
        self.charge(1)?
        match term:
            case MirTerminator.Goto(target): self.block(target)?
            case MirTerminator.If(condition, success, failure):
                val type_ = self.operand_type(condition)?
                if not self.same_type(type_, MirType.bool())?:
                    return Err("EE-E-EDGE: branch condition is not Bool")
                self.block(success)?
                self.block(failure)?
            case MirTerminator.Switch(value, targets, default):
                self.operand_type(value)?
                self.charge(targets.len())?
                for target in targets: self.block(target.target)?
                self.block(default)?
            case MirTerminator.Ret(value):
                if val operand = value: self.operand_type(operand)?
            case MirTerminator.Unreachable: ()
            case MirTerminator.Abort(message): self.charge(message.len())?
            case _:
                return Err("EE-E-EDGE: unsupported physical terminator in semantic subject")
        Ok(())

    me preflight() -> Result<(), text>:
        if self.function.blocks.len() > 4096:
            return Err("EE-E-LIMIT: function block count exceeds 4096")
        self.charge(self.module.name.len() + self.function.name.len())?
        self.charge(self.function.locals.len() +
            self.function.blocks.len() + self.function.enum_matches.len())?
        # @workaround bug=dict_nominal_tuple_binders_any_bootstrap_2026_10_21 recover=0bfa8039acd reason=bootstrap dictionary tuple binders erase declared nominal K/V types
        for raw_symbol, raw_declaration in self.module.types:
            val symbol: SymbolId = raw_symbol
            val declaration: MirTypeDef = raw_declaration
            self.charge(1)?
            if declaration.symbol.id != symbol.id or self.declarations.contains_key(symbol.id):
                return Err("EE-E-DECLARATION: relocated or duplicate nominal owner")
            self.declarations[symbol.id] = declaration
        for id in 0..self.function.locals.len():
            val local = self.function.locals[id]
            if local.id.id < 0 or self.locals.contains_key(local.id.id):
                return Err("EE-E-AVAILABILITY: duplicate or negative local identity")
            self.locals[local.id.id] = id
        for id in 0..self.function.blocks.len():
            val block = self.function.blocks[id]
            if block.id.id < 0 or self.blocks.contains_key(block.id.id):
                return Err("EE-E-EDGE: duplicate or negative block identity")
            self.blocks[block.id.id] = id
        self.block(self.function.entry_block)?
        # Validate declarations before the declaration identity serializer runs.
        # @workaround bug=dict_nominal_tuple_binders_any_bootstrap_2026_10_21 recover=0bfa8039acd reason=bootstrap dictionary value binder loses MirTypeDef identity
        for _, raw_declaration in self.declarations:
            val declaration: MirTypeDef = raw_declaration
            self.charge(declaration.name.len() + declaration.export_name.len() + 1)?
            match declaration.kind:
                case MirTypeDefKind.Enum(variants):
                    self.charge(variants.len())?
                    var tags: Dict<i64, bool> = {}
                    var names: Dict<text, bool> = {}
                    for variant in variants:
                        self.charge(variant.name.len() + 2)?
                        if tags.contains_key(variant.discriminant) or names.contains_key(variant.name):
                            return Err("EE-E-DECLARATION: duplicate constructor name or discriminant")
                        tags[variant.discriminant] = true
                        names[variant.name] = true
                        if val payload = variant.payload: self.type_projection(payload, 0)?
                case MirTypeDefKind.Struct(fields):
                    self.charge(fields.len())?
                    for field in fields:
                        self.charge(field.name.len())?
                        self.type_projection(field.type_, 0)?
                case MirTypeDefKind.Union(members):
                    self.charge(members.len())?
                    for member in members: self.type_projection(member, 0)?
        self.runtime_declaration_facts()?
        self.signature_projection(self.function.signature, 0)?
        for local in self.function.locals:
            self.projected[local.id.id] = self.type_projection(local.type_, 0)?
            if val name = local.name: self.charge(name.len())?
        for block in self.function.blocks:
            self.charge(block.instructions.len())?
            if val label = block.label: self.charge(label.len())?
            for instruction in block.instructions: self.instruction(instruction.kind)?
            self.terminator(block.terminator)?
        Ok(())

    me runtime_declaration_facts() -> Result<(), text>:
        self.charge(self.module.enum_semantic_declarations.len())?
        var source_owners: Dict<i64, bool> = {}
        var source_variants: Dict<i64, bool> = {}
        var runtime_names: Dict<text, bool> = {}
        var runtime_ids: Dict<i64, bool> = {}
        for facts in self.module.enum_semantic_declarations:
            self.charge(facts.runtime_name.len() + facts.variants.len() + 4)?
            if (facts.owner.id < 0 or facts.source_owner.id < 0 or facts.runtime_name == "" or
                    self.runtime_declarations.contains_key(facts.owner.id) or
                    source_owners.contains_key(facts.source_owner.id) or
                    runtime_names.contains_key(facts.runtime_name) or
                    runtime_ids.contains_key(facts.runtime_identity)):
                return Err("EE-E-DECLARATION: duplicate or invalid retained runtime owner identity")
            if not self.declarations.contains_key(facts.owner.id):
                return Err("EE-E-DECLARATION: runtime owner has no semantic declaration")
            var expected_runtime = (hm_hash_text(facts.runtime_name) % 2147483646) + 2
            if facts.runtime_name == "Result": expected_runtime = 0
            elif facts.runtime_name == "Option": expected_runtime = 1
            if facts.runtime_identity != expected_runtime:
                return Err("EE-E-DECLARATION: native runtime identity differs from its retained qualified name")
            val declaration = self.declarations[facts.owner.id]
            if (facts.runtime_name != declaration.name and
                    not facts.runtime_name.ends_with("." + declaration.name)):
                return Err("EE-E-DECLARATION: runtime name disagrees with selected declaration name")
            match declaration.kind:
                case MirTypeDefKind.Enum(variants):
                    if variants.len() != facts.variants.len():
                        return Err("EE-E-DECLARATION: retained runtime variant count differs")
                    for index in 0..variants.len():
                        self.charge(1)?
                        val variant = variants[index]
                        val slots = facts.variants[index]
                        if (variant.discriminant != slots.discriminant or
                                slots.source_variant.id < 0 or
                                source_variants.contains_key(slots.source_variant.id)):
                            return Err("EE-E-DECLARATION: variant order, tag or source identity differs")
                        self.charge(slots.slot_types.len() + slots.slot_names.len() + 1)?
                        source_variants[slots.source_variant.id] = true
                        if slots.slot_names.len() != 0 and slots.slot_names.len() != slots.slot_types.len():
                            return Err("EE-E-DECLARATION: named payload slot count differs")
                        var names: Dict<text, bool> = {}
                        for name in slots.slot_names:
                            self.charge(name.len() + 1)?
                            if name == "" or names.contains_key(name):
                                return Err("EE-E-DECLARATION: empty or duplicate payload slot name")
                            names[name] = true
                        for slot in slots.slot_types: self.type_projection(slot, 0)?
                        if slots.slot_types.len() == 0:
                            if variant.payload != nil:
                                return Err("EE-E-DECLARATION: nullary variant carries a payload")
                        else:
                            if variant.payload == nil:
                                return Err("EE-E-DECLARATION: payload variant has no declared type")
                            val collapsed = if slots.slot_types.len() == 1 and slots.slot_names.len() == 0:
                                slots.slot_types[0]
                            else:
                                MirType(kind: MirTypeKind.Tuple(slots.slot_types))
                            if not self.same_type(collapsed, variant.payload.unwrap())?:
                                return Err("EE-E-DECLARATION: retained ordered slots differ from semantic payload")
                case _: return Err("EE-E-DECLARATION: runtime owner is not an enum declaration")
            self.runtime_declarations[facts.owner.id] = facts
            source_owners[facts.source_owner.id] = true
            runtime_names[facts.runtime_name] = true
            runtime_ids[facts.runtime_identity] = true
        Ok(())

    me site(semantic: MirEnumMatchSemanticV1, site: MirEnumSiteV1) -> Result<(), text>:
        self.charge(1)?
        if site.related_pattern_node < -1 or site.related_pattern_node >= semantic.pattern_nodes.len():
            return Err("EE-E-PATTERN: site has no actual pattern node")
        val actual = self.block(site.block_id)?
        val key = "{site.block_id.id}:{site.instruction_index}"
        if self.sites.contains_key(key):
            return Err("EE-E-SITE: physical site is claimed more than once")
        self.charge(key.len() + 1)?
        self.sites[key] = true
        self.type_projection(site.semantic_input_type, 0)?
        self.type_projection(site.semantic_output_type, 0)?
        val related_type = if site.related_pattern_node == -1:
            semantic.scrutinee_semantic_type
        else:
            semantic.pattern_nodes[site.related_pattern_node].expected_type
        match site.kind:
            case MirEnumSiteKindV1.PatternTerminator:
                if site.related_pattern_node == -1:
                    return Err("EE-E-PATTERN: pattern edge has no actual source pattern")
                if (not self.same_type(site.semantic_input_type, related_type)? or
                        not self.same_type(site.semantic_output_type, related_type)?):
                    return Err("EE-E-SITE: pattern edge semantic type differs")
                if site.instruction_index != -1:
                    return Err("EE-E-SITE: pattern terminator has an instruction offset")
                if sha256_text(serialize_mir_terminator(actual.terminator)) != site.exact_instruction_identity:
                    return Err("EE-E-SITE: pattern terminator identity differs")
                return Ok(())
            case MirEnumSiteKindV1.Guard:
                if site.instruction_index != -1:
                    return Err("EE-E-SITE: guard must identify its actual terminator")
                if sha256_text(serialize_mir_terminator(actual.terminator)) != site.exact_instruction_identity:
                    return Err("EE-E-SITE: guard terminator identity differs")
                if (not self.same_type(site.semantic_input_type, MirType.bool())? or
                        not self.same_type(site.semantic_output_type, MirType.bool())?):
                    return Err("EE-E-SITE: guard semantic type is not Bool")
                val guard_key = "{semantic.match_id}:{site.related_pattern_node}"
                self.charge(guard_key.len() + 1)?
                if not self.guard_arms.contains_key(guard_key) or self.guard_sites.contains_key(guard_key):
                    return Err("EE-E-METADATA: guard site has no unique owning arm")
                val arm = self.guard_arms[guard_key]
                match actual.terminator:
                    case MirTerminator.If(condition, success, failure):
                        if (not self.same_operand(condition, arm.guard_result.unwrap())? or
                                success.id != arm.body_entry.id or failure.id != arm.guard_failure_entry.id):
                            return Err("EE-E-EDGE: actual guard condition or successor differs")
                    case _: return Err("EE-E-EDGE: guard site is not a conditional edge")
                self.guard_sites[guard_key] = true
                return Ok(())
            case _: ()
        if site.instruction_index < 0 or site.instruction_index >= actual.instructions.len():
            return Err("EE-E-SITE: instruction site is out of range")
        val instruction = actual.instructions[site.instruction_index]
        if sha256_text(serialize_mir_inst_kind(instruction.kind)) != site.exact_instruction_identity:
            return Err("EE-E-SITE: actual instruction identity differs")
        match site.kind:
            case MirEnumSiteKindV1.PatternInstruction:
                if (not self.same_type(site.semantic_input_type, related_type)? or
                        not self.same_type(site.semantic_output_type, related_type)?):
                    return Err("EE-E-SITE: pattern instruction semantic type differs")
                # The physical pattern interpreter checks the exact opcode,
                # operand provenance and retained node before this is erased.
                return Ok(())
            case _: ()
        match instruction.kind:
            case MirInstKind.Call(destination, callee, args):
                if destination == nil: return Err("EE-E-SITE: enum adapter has no destination")
                val result_type = self.local_type(destination.unwrap())?
                var name = ""
                match callee.kind:
                    case MirOperandKind.Const(MirConstValue.Str(symbol), _): name = symbol
                    case _: return Err("EE-E-SITE: enum adapter is not an exact direct helper")
                var arity = 1
                var expected = MirType.i64()
                match site.kind:
                    case MirEnumSiteKindV1.Discriminant:
                        if name != "rt_enum_discriminant":
                            return Err("EE-E-SITE: discriminant operation family differs")
                    case MirEnumSiteKindV1.VariantIdentityCheck:
                        if name != "rt_enum_check_variant":
                            return Err("EE-E-SITE: variant identity operation family differs")
                        arity = 3
                        expected = MirType.bool()
                    case MirEnumSiteKindV1.Payload:
                        if name != "rt_enum_payload":
                            return Err("EE-E-SITE: payload operation family differs")
                    case MirEnumSiteKindV1.PayloadSlot:
                        if name != "rt_tuple_get":
                            return Err("EE-E-SITE: payload slot operation family differs")
                        arity = 2
                    case MirEnumSiteKindV1.PayloadDecode:
                        if name != "rt_value_as_u64" and name != "rt_value_as_int":
                            return Err("EE-E-SITE: unsupported payload decode operation")
                    case _:
                        return Err("EE-E-SITE: call is not a retained enum adapter")
                if args.len() != arity or not self.same_type(result_type, expected)?:
                    return Err("EE-E-SITE: enum adapter physical arity or result type differs")
                # Semantic output is checked against retained facts by the
                # consumer; physical carrier equality is not semantic authority.
                match callee.kind:
                    case MirOperandKind.Const(_, type_):
                        match type_.kind:
                            case MirTypeKind.FuncPtr(signature):
                                if (signature.params.len() != arity or signature.is_variadic or
                                        not self.same_type(signature.return_type, expected)?):
                                    return Err("EE-E-SITE: enum adapter declared signature differs")
                            case _: return Err("EE-E-SITE: enum adapter lacks a function signature")
                    case _: ()
            case _:
                return Err("EE-E-SITE: retained adapter site is not a call")
        Ok(())

    me match_record(semantic: MirEnumMatchSemanticV1, subject: text,
            declaration_identity: text) -> Result<(), text>:
        self.charge(semantic.pattern_nodes.len() + semantic.arms.len() + semantic.sites.len() + 1)?
        if semantic.schema != "MirEnumMatchSemantic-v1":
            return Err("EE-E-METADATA: unknown enum semantic schema")
        if semantic.subject_identity != subject:
            return Err("EE-E-SUBJECT: retained match belongs to another physical function")
        if semantic.declaration_identity != declaration_identity:
            return Err("EE-E-DECLARATION: retained declarations differ from the actual module")
        self.cursor(semantic.entry_block, semantic.entry_instruction_index)?
        if not self.runtime_declarations.contains_key(semantic.enum_owner.id):
            return Err("EE-E-DECLARATION: match owner has no actual retained runtime declaration")
        self.match_offsets[semantic.match_id] = semantic.entry_instruction_index
        self.block(semantic.merge_block)?
        self.local_type(semantic.result_local)?
        val physical_scrutinee = self.operand_type(semantic.scrutinee_operand)?
        val projected_scrutinee = self.type_projection(physical_scrutinee, 0)?
        if not self.same_type(projected_scrutinee, semantic.scrutinee_semantic_type)?:
            return Err("EE-E-DECLARATION: actual scrutinee has no exact nominal owner")
        var alternatives: Dict<i64, bool> = {}
        var arm_index = 0
        for arm in semantic.arms:
            self.charge(1)?
            if (arm.source_arm_id < 0 or arm.expanded_alternative_index < 0 or
                    alternatives.contains_key(arm.expanded_alternative_index)):
                return Err("EE-E-METADATA: duplicate or invalid expanded arm identity")
            if arm.pattern_root < 0 or arm.pattern_root >= semantic.pattern_nodes.len():
                return Err("EE-E-PATTERN: arm root is outside its actual pattern vector")
            val irrefutable = match semantic.pattern_nodes[arm.pattern_root].kind:
                case MirEnumPatternKindV1.Wildcard | MirEnumPatternKindV1.Bind(_, _): true
                case _: false
            alternatives[arm.expanded_alternative_index] = true
            self.cursor(arm.pattern_entry_block, arm.pattern_entry_instruction_index)?
            if arm.expanded_alternative_index != arm_index:
                return Err("EE-E-METADATA: expanded arm order differs from retained source order")
            if arm_index == 0:
                if (arm.pattern_entry_block.id != semantic.entry_block.id or
                        arm.pattern_entry_instruction_index != semantic.entry_instruction_index):
                    return Err("EE-E-EDGE: first native pattern does not start at actual match entry")
            else:
                val prior = semantic.arms[arm_index - 1]
                val prior_irrefutable = match semantic.pattern_nodes[prior.pattern_root].kind:
                    case MirEnumPatternKindV1.Wildcard | MirEnumPatternKindV1.Bind(_, _): true
                    case _: false
                if not prior_irrefutable:
                    if (prior.pattern_failure_entry.id != arm.pattern_entry_block.id or
                            arm.pattern_entry_instruction_index != 0):
                        return Err("EE-E-EDGE: pattern failure does not enter the next actual expanded alternative")
                if prior.guard_entry != nil:
                    if (prior.guard_failure_entry.id != arm.pattern_entry_block.id or
                            arm.pattern_entry_instruction_index != 0):
                        return Err("EE-E-EDGE: guard failure does not enter the next actual expanded alternative")
            arm_index = arm_index + 1
            self.cursor(arm.body_entry, arm.body_entry_instruction_index)?
            if arm.pattern_failure_entry.id == -1:
                if not irrefutable:
                    return Err("EE-E-EDGE: refutable pattern omits its actual failure edge")
            else:
                self.block(arm.pattern_failure_entry)?
            if arm.guard_failure_entry.id == -1:
                if arm.guard_entry != nil:
                    return Err("EE-E-EDGE: guarded arm omits its actual false successor")
            else:
                # Legacy unguarded variant rows retain the pattern target in
                # this field; its membership is a fact, not a guard authority.
                self.block(arm.guard_failure_entry)?
            if arm.guard_entry == nil:
                if arm.guard_result != nil:
                    return Err("EE-E-METADATA: condition without an actual guard entry")
            else:
                self.cursor(arm.guard_entry.unwrap(), arm.guard_entry_instruction_index)?
                if arm.guard_result == nil:
                    return Err("EE-E-METADATA: guard entry without a condition")
                val type_ = self.operand_type(arm.guard_result.unwrap())?
                if not self.same_type(type_, MirType.bool())?:
                    return Err("EE-E-EDGE: actual guard condition is not Bool")
                val guard_key = "{semantic.match_id}:{arm.pattern_root}"
                self.charge(guard_key.len() + 1)?
                if self.guard_arms.contains_key(guard_key):
                    return Err("EE-E-METADATA: guarded arms share a pattern identity")
                self.guard_arms[guard_key] = arm
            self.charge(arm.body_exit_blocks.len())?
            var exits: Dict<i64, bool> = {}
            for exit_block in arm.body_exit_blocks:
                if exits.contains_key(exit_block.id):
                    return Err("EE-E-EDGE: duplicate arm exit")
                exits[exit_block.id] = true
                val actual = self.block(exit_block)?
                match actual.terminator:
                    case MirTerminator.Goto(target):
                        if target.id != semantic.merge_block.id:
                            return Err("EE-E-EDGE: arm exit does not reach actual merge")
                    case MirTerminator.Ret(_): ()
                    case MirTerminator.Unreachable: ()
                    # A factual native terminal is not a reachable semantic
                    # exit. The consumer must exclude a nested exhaustive
                    # fallback through its checked decision DAG, or refuse it.
                    case MirTerminator.Abort(_): ()
                    case _: return Err("EE-E-EDGE: unsupported arm exit edge")
        # The symbolic checker also validates child indices, cycles, declaration
        # arities, exact nested types, literal widths and every unreachable node.
        val decision = enum_pattern_decision_plan_v1(self.module, semantic, self.remaining)?
        self.remaining = decision.remaining_work
        self.decision_plans[semantic.match_id] = decision
        for site in semantic.sites: self.site(semantic, site)?
        for arm in semantic.arms:
            self.charge(1)?
            if arm.guard_entry != nil:
                if not self.guard_sites.contains_key("{semantic.match_id}:{arm.pattern_root}"):
                    return Err("EE-E-SITE: guarded arm lacks exactly one actual guard site")
        val physical = enum_pattern_physical_plan_v1(self.function, semantic, self.blocks,
            self.locals, self.runtime_declarations, self.multiple_definitions, self.remaining)?
        self.remaining = physical.remaining_work
        for key, used in physical.replaced_instruction_sites:
            self.charge(1)?
            self.replaced_instructions[key] = used
        for block, used in physical.replaced_terminator_blocks:
            self.charge(1)?
            self.replaced_terminators[block] = used
        for local, type_ in physical.binding_types:
            self.charge(1)?
            if val prior = self.binding_types.get(local):
                if not self.same_type(prior, type_)?:
                    return Err("EE-E-PATTERN: shared binding has conflicting semantic types")
            self.binding_types[local] = type_
            self.projected[local] = type_
        Ok(())

    me validate() -> Result<ValidatedEnumSemanticsV1, text>:
        self.preflight()?
        if self.function.enum_matches.len() == 0:
            return Err("EE-E-METADATA: enum semantic consumer requires retained matches")
        val subject = sha256_text(serialize_mir_function_subject_v1(self.function))
        val declaration_identity = enum_semantic_declaration_identity_v1(self.module)
        var ids: Dict<i64, bool> = {}
        for semantic in self.function.enum_matches:
            self.charge(1)?
            if semantic.match_id < 0 or ids.contains_key(semantic.match_id):
                return Err("EE-E-METADATA: duplicate or invalid match identity")
            ids[semantic.match_id] = true
            self.match_record(semantic, subject, declaration_identity)?
        self.charge(self.function.locals.len() + self.function.blocks.len())?
        var locals: [MirLocal] = []
        for local in self.function.locals:
            locals.push(MirLocal(id: local.id, name: local.name,
                type_: self.projected[local.id.id], kind: local.kind, is_ghost: local.is_ghost))
        # with_blocks reconstructs the function value and preserves every
        # physical field. Replace owned signature/local containers only.
        var blocks: [MirBlock] = []
        for block in self.function.blocks: blocks.push(block)
        var semantic_function = MirFunction.with_blocks(self.function, blocks)
        semantic_function.locals = locals
        semantic_function.signature = self.signature_projection(self.function.signature, 0)?
        Ok(ValidatedEnumSemanticsV1(physical_function: self.function,
            semantic_function: semantic_function, matches: self.function.enum_matches,
            block_indices: self.blocks, declarations: self.declarations,
            work_remaining: self.remaining,
            replaced_instruction_sites: self.replaced_instructions,
            replaced_terminator_blocks: self.replaced_terminators,
            match_entry_instruction_indices: self.match_offsets, decision_plans: self.decision_plans))

fn enum_physical_validator_v1(module: MirModule, function: MirFunction) -> EnumPhysicalValidatorV1:
    EnumPhysicalValidatorV1(module: module, function: function,
        remaining: 65536, blocks: {}, locals: {}, declarations: {}, projected: {},
        binding_types: {}, sites: {}, guard_arms: {}, guard_sites: {},
        runtime_declarations: {}, replaced_instructions: {}, replaced_terminators: {},
        match_offsets: {}, decision_plans: {}, defined_locals: {}, multiple_definitions: {})

pub fn enum_semantic_preflight_v1(module: MirModule,
        function: MirFunction) -> Result<(), CompileError>:
    """Bound actual declaration/function trees before canonical hashing.

    This performs no semantic admission and returns no validated plan.
    """
    var validator = enum_physical_validator_v1(module, function)
    match validator.preflight():
        case Ok(_): Ok(())
        case Err(message): Err(CompileError.Semantic(message))

pub fn validate_enum_semantics_v1(module: MirModule,
        function: MirFunction) -> Result<ValidatedEnumSemanticsV1, CompileError>:
    """Validate physical identities and metadata, without rewriting native MIR.

    Consumers may consume only the certified physical prefix maps. They still
    validate actual body/guard dataflow, semantic reachability and CFG state
    before publishing output, and reject any unsupported reachable operation.
    """
    var validator = enum_physical_validator_v1(module, function)
    match validator.validate():
        case Ok(plan): Ok(plan)
        case Err(message): Err(CompileError.Semantic(message))

pub fn enum_validation_remaining_work_v1(plan: ValidatedEnumSemanticsV1) -> i64:
    plan.work_remaining

export ValidatedEnumSemanticsV1, validate_enum_semantics_v1, enum_validation_remaining_work_v1
export enum_semantic_preflight_v1
