# Opted source producer. Canonical IDs are allocated only after ordinary native
# emission; the finalized semantic transport never rewrites physical MIR.
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_types.{HirModule, SymbolId}
use compiler.common.mir_target_context.{MirTargetContext}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.enum_semantic_declarations_v1.*
use compiler.mir.verification_source_environment_v1.{verification_source_environment_v1}
use compiler.mir.mir_instruction_graph.{MirModule, MirFunction, MirBlock}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind, MirVariantDef}
use compiler.mir.mir_enum_semantic_types.*
use compiler.mir.mir_json.{serialize_mir_function_subject_v1}
use compiler.mir.enum_semantic_identity_v1.{enum_semantic_declaration_identity_v1,
    enum_semantic_type_definition_identity_v1}
use compiler.mir.enum_semantic_validation_v1.{validate_enum_semantics_v1,
    enum_semantic_preflight_v1}

class EnumSemanticFinalizerV1:
    lowering: MirLowering
    owners: Dict<i64, SymbolId>
    work: i64

impl EnumSemanticFinalizerV1:
    me charge(amount: i64) -> Result<(), text>:
        if amount < 0 or amount > self.work:
            return Err("EE-E-LIMIT: semantic finalization work budget exhausted")
        self.work = self.work - amount
        Ok(())

    me owner(source: SymbolId) -> Result<SymbolId, text>:
        if val retained = self.owners.get(source.id): return Ok(retained)
        return Err("EE-E-DECLARATION: captured enum owner was not prepared from source")

    me type_(source: MirType, depth: i64) -> Result<MirType, text>:
        self.charge(1)?
        if depth > 128:
            return Err("EE-E-LIMIT: semantic type nesting exceeds 128")
        match source.kind:
            case MirTypeKind.Enum(symbol):
                Ok(MirType(kind: MirTypeKind.Enum(self.owner(symbol)?)))
            case MirTypeKind.Struct(symbol):
                val canonical = self.lowering.canonical_mir_type_symbol(symbol)
                Ok(MirType(kind: MirTypeKind.Struct(canonical)))
            case MirTypeKind.Tuple(elements):
                self.charge(elements.len())?
                var converted: [MirType] = []
                for element in elements: converted.push(self.type_(element, depth + 1)?)
                Ok(MirType(kind: MirTypeKind.Tuple(converted)))
            case MirTypeKind.Array(element, size):
                Ok(MirType(kind: MirTypeKind.Array(self.type_(element, depth + 1)?, size)))
            case MirTypeKind.Result(ok_type, error_type):
                Ok(MirType(kind: MirTypeKind.Result(self.type_(ok_type, depth + 1)?,
                    self.type_(error_type, depth + 1)?)))
            case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64 | MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64 | MirTypeKind.F32 | MirTypeKind.F64 | MirTypeKind.Bool | MirTypeKind.Char | MirTypeKind.Unit | MirTypeKind.Never:
                Ok(MirType(kind: source.kind))
            case _: Err("EE-E-DECLARATION: unsupported captured semantic type")

    me declarations(module: MirModule) -> Result<MirModule, text>:
        var owned_types: Dict<SymbolId, MirTypeDef> = {}
        for key, definition in module.types:
            self.charge(1)?
            if definition.symbol.id != key.id:
                return Err("EE-E-DECLARATION: physical type table key disagrees with owner")
            owned_types[key] = definition
        # Both preparation passes used source IDs; do not allocate these before
        # lowering.lower_module has finished its native type allocation.
        for source in self.lowering.enum_semantic_source_declarations:
            self.charge(1)?
            if source.owner.id != source.source_owner.id or self.owners.get(source.source_owner.id) != nil:
                return Err("EE-E-DECLARATION: duplicate or non-source provisional owner")
            self.owners[source.source_owner.id] = self.lowering.canonical_mir_type_symbol(source.source_owner)
        var canonical_seen: Dict<i64, bool> = {}
        var records: [MirEnumDeclarationIdentityV1] = []
        for source in self.lowering.enum_semantic_source_declarations:
            val owner = self.owner(source.source_owner)?
            if canonical_seen.get(owner.id) != nil:
                return Err("EE-E-DECLARATION: distinct source enums alias one canonical owner")
            canonical_seen[owner.id] = true
            val runtime_identity = match self.lowering.enum_runtime_id_index_q.get(source.runtime_name):
                case Some(value): value
                case _: return Err("EE-E-DECLARATION: native lowering did not register the exact runtime name")
            if runtime_identity < 2:
                return Err("EE-E-DECLARATION: named enum aliases a reserved runtime identity")
            val definition = match self.lowering.enum_semantic_declarations.get(source.source_owner.id):
                case Some(value): value
                case _: return Err("EE-E-DECLARATION: prepared enum definition is absent")
            if definition.symbol.id != source.source_owner.id:
                return Err("EE-E-DECLARATION: prepared definition owner changed")
            val variants = match definition.kind:
                case MirTypeDefKind.Enum(value): value
                case _: return Err("EE-E-DECLARATION: prepared nominal definition is not an enum")
            self.charge(variants.len() + source.variants.len())?
            if variants.len() != source.variants.len():
                return Err("EE-E-DECLARATION: source slot table and variants disagree")
            var copied_variants: [MirVariantDef] = []
            var copied_slots: [MirEnumVariantSlotsV1] = []
            var index = 0
            for variant in variants:
                val slots = source.variants[index]
                if slots.discriminant != variant.discriminant:
                    return Err("EE-E-DECLARATION: source slot discriminant disagrees")
                var payload: MirType? = nil
                if val source_payload = variant.payload:
                    payload = Some(self.type_(source_payload, 0)?)
                copied_variants.push(MirVariantDef(name: variant.name,
                    discriminant: variant.discriminant, payload: payload))
                self.charge(slots.slot_types.len() + slots.slot_names.len())?
                var types: [MirType] = []
                for slot_type in slots.slot_types: types.push(self.type_(slot_type, 0)?)
                var names: [text] = []
                for name in slots.slot_names: names.push(name)
                copied_slots.push(MirEnumVariantSlotsV1(discriminant: slots.discriminant,
                    source_variant: SymbolId(id: slots.source_variant.id),
                    slot_types: types, slot_names: names))
                index = index + 1
            val converted = MirTypeDef(symbol: owner, name: definition.name,
                kind: MirTypeDefKind.Enum(copied_variants), is_export_c: definition.is_export_c,
                export_name: definition.export_name)
            if val existing = owned_types.get(owner):
                if (enum_semantic_type_definition_identity_v1(existing) !=
                        enum_semantic_type_definition_identity_v1(converted)):
                    return Err("EE-E-DECLARATION: canonical enum conflicts with an existing MIR declaration")
            else:
                owned_types[owner] = converted
            records.push(MirEnumDeclarationIdentityV1(owner: owner,
                source_owner: SymbolId(id: source.source_owner.id),
                runtime_name: source.runtime_name, runtime_identity: runtime_identity,
                variants: copied_slots))
        var result = module
        result.types = owned_types
        result.enum_semantic_declarations = records
        Ok(result)

    me arm_exits(arm: MirEnumArmSemanticV1, merge: BlockId,
            blocks: Dict<i64, MirBlock>, boundaries: Dict<i64, bool>) -> Result<[BlockId], text>:
        self.charge(1)?
        if arm.body_entry.id == merge.id:
            return Err("EE-E-EDGE: arm body entry is its match merge")
        var stack: [(BlockId, bool)] = [(arm.body_entry, false)]
        var colors: Dict<i64, i64> = {}
        var exits: [BlockId] = []
        while stack.len() > 0:
            val frame = stack[stack.len() - 1]
            stack.pop()
            self.charge(1)?
            if frame.1:
                colors[frame.0.id] = 2
                continue
            val color = colors.get(frame.0.id) ?? 0
            if color == 1:
                return Err("EE-E-EDGE: cycle in captured arm body")
            if color == 2: continue
            if frame.0.id == merge.id:
                return Err("EE-E-EDGE: conditional arm exit bypasses its terminal merge edge")
            if frame.0.id != arm.body_entry.id and boundaries.get(frame.0.id) != nil:
                return Err("EE-E-EDGE: arm body crosses its match pattern, guard or sibling entry")
            val block = match blocks.get(frame.0.id):
                case Some(value): value
                case _: return Err("EE-E-EDGE: arm body targets an absent block")
            self.charge(2)?
            colors[frame.0.id] = 1
            stack.push((frame.0, true))
            var successors: [BlockId] = []
            match block.terminator:
                case MirTerminator.Ret(_) | MirTerminator.Unreachable | MirTerminator.Abort(_):
                    # This records a physical terminal, not semantic admission.
                    # Exhaustive nested matches retain a diagnostic Abort on
                    # their impossible residual path. Only the consumer's
                    # checked decision DAG can make that path unreachable;
                    # any Abort or effect reached by that DAG still refuses.
                    self.charge(1)?
                    exits.push(block.id)
                case MirTerminator.Goto(target):
                    if target.id == merge.id:
                        self.charge(1)?
                        exits.push(block.id)
                    else:
                        self.charge(1)?
                        successors.push(target)
                case MirTerminator.If(_, success, failure):
                    self.charge(2)?
                    successors.push(success)
                    successors.push(failure)
                case MirTerminator.Switch(_, targets, default):
                    self.charge(targets.len() + 1)?
                    for target in targets: successors.push(target.target)
                    successors.push(default)
                case _: return Err("EE-E-EDGE: unsupported captured arm body exit")
            # Reverse stack insertion visits source-order successor edges first.
            # Each block is completed once per arm, shared joins are not paths.
            var index = successors.len() - 1
            while index >= 0:
                self.charge(1)?
                stack.push((successors[index], false))
                index = index - 1
        if exits.len() == 0:
            return Err("EE-E-EDGE: arm body has no completed exit")
        Ok(exits)

    me match_(source: MirEnumMatchSemanticV1, blocks: Dict<i64, MirBlock>, declaration_identity: text,
            subject_identity: text) -> Result<MirEnumMatchSemanticV1, text>:
        self.charge(source.pattern_nodes.len() + source.arms.len() + source.sites.len() + 1)?
        if source.schema != "MirEnumMatchSemantic-v1":
            return Err("EE-E-METADATA: unsupported producer capture schema")
        var nodes: [MirEnumPatternNodeV1] = []
        for node in source.pattern_nodes:
            val kind = match node.kind:
                case MirEnumPatternKindV1.Wildcard: MirEnumPatternKindV1.Wildcard
                case MirEnumPatternKindV1.Bind(symbol, local):
                    MirEnumPatternKindV1.Bind(SymbolId(id: symbol.id), local)
                case MirEnumPatternKindV1.Variant(owner, discriminant, children):
                    self.charge(children.len())?
                    var copied: [i64] = []
                    for child in children: copied.push(child)
                    MirEnumPatternKindV1.Variant(self.owner(owner)?, discriminant, copied)
                case MirEnumPatternKindV1.Tuple(children):
                    self.charge(children.len())?
                    var copied: [i64] = []
                    for child in children: copied.push(child)
                    MirEnumPatternKindV1.Tuple(copied)
                case MirEnumPatternKindV1.Or(alternatives):
                    self.charge(alternatives.len())?
                    var copied: [i64] = []
                    for alternative in alternatives: copied.push(alternative)
                    MirEnumPatternKindV1.Or(copied)
                case MirEnumPatternKindV1.Literal(value, exact_type):
                    MirEnumPatternKindV1.Literal(value, self.type_(exact_type, 0)?)
            nodes.push(MirEnumPatternNodeV1(kind: kind,
                expected_type: self.type_(node.expected_type, 0)?, source_span: node.source_span))
        # Only boundaries of this match are barriers. A nested match's own
        # pattern/guard/body blocks are ordinary internal blocks of this body.
        var boundaries: Dict<i64, bool> = {}
        for arm in source.arms:
            self.charge(5)?
            boundaries[arm.pattern_entry_block.id] = true
            boundaries[arm.body_entry.id] = true
            boundaries[arm.pattern_failure_entry.id] = true
            boundaries[arm.guard_failure_entry.id] = true
            if val guard = arm.guard_entry: boundaries[guard.id] = true
        var arms: [MirEnumArmSemanticV1] = []
        for arm in source.arms:
            var owned_arm = arm
            owned_arm.body_exit_blocks = self.arm_exits(arm, source.merge_block, blocks, boundaries)?
            arms.push(owned_arm)
        var sites: [MirEnumSiteV1] = []
        for site in source.sites:
            sites.push(MirEnumSiteV1(kind: site.kind, block_id: site.block_id,
                instruction_index: site.instruction_index,
                exact_instruction_identity: site.exact_instruction_identity,
                semantic_input_type: self.type_(site.semantic_input_type, 0)?,
                semantic_output_type: self.type_(site.semantic_output_type, 0)?,
                related_pattern_node: site.related_pattern_node))
        Ok(MirEnumMatchSemanticV1(match_id: source.match_id, enum_owner: self.owner(source.enum_owner)?,
            scrutinee_operand: source.scrutinee_operand,
            scrutinee_semantic_type: self.type_(source.scrutinee_semantic_type, 0)?,
            entry_block: source.entry_block, result_local: source.result_local,
            merge_block: source.merge_block, pattern_nodes: nodes, arms: arms, sites: sites,
            source_span: source.source_span, declaration_identity: declaration_identity,
            subject_identity: subject_identity, schema: source.schema,
            entry_instruction_index: source.entry_instruction_index))

    me finish(module: MirModule) -> Result<MirModule, text>:
        var result = self.declarations(module)?
        var declaration_identity = ""
        var functions: Dict<SymbolId, MirFunction> = {}
        var captures: Dict<i64, [MirEnumMatchSemanticV1]> = {}
        for pending in self.lowering.enum_semantic_captures:
            if not pending.completed:
                return Err("EE-E-METADATA: incomplete producer capture")
            val function = match module.functions.get(pending.function_symbol):
                case Some(value): value
                case _: return Err("EE-E-SUBJECT: captured physical function is absent")
            if function.symbol.id != pending.function_symbol.id:
                return Err("EE-E-SUBJECT: capture function key/owner mismatch")
            var owned = captures.get(pending.function_symbol.id) ?? []
            if owned.len() >= 65536:
                return Err("EE-E-LIMIT: function capture index exceeds 65536 entries")
            if pending.semantic.match_id != owned.len():
                return Err("EE-E-METADATA: capture match IDs are not contiguous preorder")
            owned.push(pending.semantic)
            captures[pending.function_symbol.id] = owned
        for owner_id, expected in self.lowering.enum_semantic_function_counts:
            if expected < 0 or expected > 65536:
                return Err("EE-E-LIMIT: invalid producer function capture count")
            if expected > 0:
                val retained = match captures.get(owner_id):
                    case Some(value): value
                    case _: return Err("EE-E-METADATA: producer count has no completed captures")
                if retained.len() != expected:
                    return Err("EE-E-METADATA: producer capture count is incomplete")
        for key, function in result.functions:
            if key.id != function.symbol.id:
                return Err("EE-E-SUBJECT: physical function key/owner mismatch")
            if function.enum_matches.len() != 0:
                return Err("EE-E-METADATA: ordinary lowering returned presealed metadata")
            var copied = function
            copied.enum_matches = []
            if val pending = captures.get(key.id):
                # The bound is per function, independently of declaration work.
                self.work = 65536
                val expected = self.lowering.enum_semantic_function_counts.get(key.id) ?? 0
                if expected != pending.len():
                    return Err("EE-E-METADATA: completed captures disagree with producer count")
                if function.blocks.len() > 4096:
                    return Err("EE-E-LIMIT: captured function exceeds 4096 blocks")
                self.charge(function.blocks.len())?
                var blocks: Dict<i64, MirBlock> = {}
                for block in function.blocks:
                    if blocks.get(block.id.id) != nil:
                        return Err("EE-E-EDGE: duplicate block while indexing arm bodies")
                    blocks[block.id.id] = block
                # Bound actual declarations, operands, constants and instruction
                # trees before the canonical serializers traverse any of them.
                match enum_semantic_preflight_v1(result, function):
                    case Ok(_): ()
                    case Err(error): return Err(error.message())
                if declaration_identity == "":
                    declaration_identity = enum_semantic_declaration_identity_v1(result)
                val subject = sha256_text(serialize_mir_function_subject_v1(function))
                for semantic in pending:
                    copied.enum_matches.push(self.match_(semantic, blocks, declaration_identity, subject)?)
            functions[key] = copied
        result.functions = functions
        # Publish nothing until all actual functions and declarations pass.
        for _, function in result.functions:
            if function.enum_matches.len() > 0:
                match validate_enum_semantics_v1(result, function):
                    case Ok(_): ()
                    case Err(error): return Err(error.message())
        Ok(result)

pub fn lower_module_with_enum_semantics_v1(module: HirModule,
        target: MirTargetContext) -> Result<MirModule, text>:
    if module == nil or module.symbols == nil:
        return Err("EE-E-DECLARATION: source module and symbol environment are required")
    val symbols = verification_source_environment_v1(module.symbols)?
    var owned_module = module
    owned_module.symbols = symbols
    var lowering = MirLowering.new_for_target(symbols, target)
    lowering.allow_ambient_bootstrap_policy = false
    lowering.enum_semantic_capture_enabled = true
    lowering.prepare_enum_semantic_declarations_v1(owned_module)?
    var native_module = lowering.lower_module(owned_module)
    if lowering.enum_semantic_capture_error != "":
        return Err(lowering.enum_semantic_capture_error)
    if lowering.errors.len() > 0:
        return Err("EE-E-METADATA: source lowering failed: " + lowering.errors[0].message)
    if lowering.enum_semantic_depth != 0:
        return Err("EE-E-METADATA: source lowering left an open enum capture")
    # Original source path remains unchanged; only the newly built MIR namespace
    # is normalized, before declaration and physical subject finalization.
    native_module.name = "EeModel_" + sha256_text(module.path)
    var finalizer = EnumSemanticFinalizerV1(lowering: lowering, owners: {}, work: 65536)
    finalizer.finish(native_module)
