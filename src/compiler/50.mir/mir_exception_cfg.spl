use compiler.mir.mir_instructions.*

fn exception_cfg_error(message: text) -> Result<(), text>:
    Err("E-MIR-UNWIND003 {message}")

fn exception_local_type(body: MirBody, id: i64) -> MirTypeKind?:
    for local in body.locals:
        if local.id.id == id:
            return Some(local.type_.kind)
    nil

fn exception_operand_local(operand: MirOperand) -> i64:
    match operand.kind:
        case Copy(local) | Move(local): local.id
        case _: -1

fn exception_operand_is_token(operand: MirOperand, tokens: Dict<i64, bool>) -> bool:
    tokens.has(exception_operand_local(operand))

fn exception_operands_have_token(
    operands: [MirOperand], tokens: Dict<i64, bool>
) -> bool:
    for operand in operands:
        if exception_operand_is_token(operand, tokens):
            return true
    false

fn exception_illegal_inst_use(inst: MirInstKind, tokens: Dict<i64, bool>) -> bool:
    match inst:
        case LandingPad(_): false
        case Const(dest, _, _) | Alloc(dest, _): tokens.has(dest.id)
        case Copy(dest, src) | Move(dest, src):
            tokens.has(dest.id) or tokens.has(src.id)
        case DebugValue(local, _): tokens.has(local.id)
        case Ref(dest, _, place): tokens.has(dest.id) or tokens.has(place.local.id)
        case Nop: false
        case BinOp(_, _, left, right) | CheckedBinOp(_, _, left, right):
            exception_operand_is_token(left, tokens) or exception_operand_is_token(right, tokens)
        case UnaryOp(_, _, operand) | Cast(_, operand, _) | Bitcast(_, operand, _):
            exception_operand_is_token(operand, tokens)
        case Load(_, ptr) | GetField(_, ptr, _):
            exception_operand_is_token(ptr, tokens)
        case Store(ptr, value) | SetField(ptr, _, value):
            exception_operand_is_token(ptr, tokens) or exception_operand_is_token(value, tokens)
        case GetElementPtr(_, base, indices):
            exception_operand_is_token(base, tokens) or exception_operands_have_token(indices, tokens)
        case Aggregate(_, _, operands):
            exception_operands_have_token(operands, tokens)
        case Call(_, func, args) | CallIndirect(_, func, args, _):
            exception_operand_is_token(func, tokens) or exception_operands_have_token(args, tokens)
        case Intrinsic(_, _, args):
            exception_operands_have_token(args, tokens)
        case PipeForward(_, value, func):
            exception_operand_is_token(value, tokens) or exception_operand_is_token(func, tokens)
        case Compose(_, left, right, _):
            exception_operand_is_token(left, tokens) or exception_operand_is_token(right, tokens)
        case Parallel(_, funcs):
            exception_operands_have_token(funcs, tokens)
        # Sound fail-closed default: a newly added opcode must explicitly
        # prove that none of its fields can consume or redefine a token.
        case _: true

fn exception_block_by_id(body: MirBody, id: i64) -> MirBlock?:
    for block in body.blocks:
        if block.id.id == id:
            return Some(block)
    nil

fn exception_successors(term: MirTerminator) -> [i64]:
    match term:
        case Goto(target): [target.id]
        case If(_, then_, else_): [then_.id, else_.id]
        case Switch(_, targets, default):
            var result: [i64] = [default.id]
            for target in targets:
                result.push(target.target.id)
            result
        case _: []

fn validate_mir_exception_cfg(body: MirBody) -> Result<(), text>:
    """Validate unwind-only landing pads and linear exception-token provenance."""
    var unwind_targets: Dict<i64, bool> = {}
    var normal_targets: Dict<i64, bool> = {}
    for block in body.blocks:
        match block.terminator:
            case Goto(target): normal_targets[target.id] = true
            case If(_, then_, else_):
                normal_targets[then_.id] = true
                normal_targets[else_.id] = true
            case Switch(_, targets, default):
                normal_targets[default.id] = true
                for target in targets:
                    normal_targets[target.target.id] = true
            case CallTerminator(_, _, _, normal, contract, unwind):
                normal_targets[normal.id] = true
                if contract == MirCallUnwindContract.MayUnwind:
                    if unwind == nil:
                        return exception_cfg_error("MayUnwind call has no unwind successor")
                    unwind_targets[unwind.unwrap().id] = true
            case _: ()

    var token_ids: Dict<i64, bool> = {}
    var token_definition_counts: Dict<i64, i64> = {}
    for block in body.blocks:
        var pad_count = 0
        var instruction_index = 0
        for instruction in block.instructions:
            match instruction.kind:
                case LandingPad(dest):
                    pad_count = pad_count + 1
                    if instruction_index != 0:
                        return exception_cfg_error("LandingPad must be the first instruction of unwind block {block.id.id}")
                    if not unwind_targets.has(block.id.id):
                        return exception_cfg_error("LandingPad block {block.id.id} is not an unwind successor")
                    if normal_targets.has(block.id.id):
                        return exception_cfg_error("LandingPad block {block.id.id} has a normal predecessor")
                    val local_kind = exception_local_type(body, dest.id)
                    if local_kind == nil or local_kind.unwrap() != MirTypeKind.ExceptionToken:
                        return exception_cfg_error("LandingPad destination {dest.id} is not ExceptionToken")
                    token_ids[dest.id] = true
                    token_definition_counts[dest.id] = (
                        token_definition_counts.get(dest.id) ?? 0) + 1
                case _: ()
            instruction_index = instruction_index + 1
        if unwind_targets.has(block.id.id) and pad_count != 1:
            return exception_cfg_error("unwind successor {block.id.id} must contain exactly one LandingPad")

    # No fabricated token locals: every ExceptionToken local has exactly one
    # LandingPad definition, and tokens are never forwarded or redefined.
    for local in body.locals:
        if local.type_.kind == MirTypeKind.ExceptionToken and not token_ids.has(local.id.id):
            return exception_cfg_error(
                "ExceptionToken local {local.id.id} has no LandingPad definition")
    for token_id in token_ids.keys():
        if token_definition_counts[token_id] != 1:
            return exception_cfg_error(
                "ExceptionToken local {token_id} must have exactly one LandingPad definition")

    for block in body.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case LandingPad(_): ()
                case Call(_, func, args) | CallIndirect(_, func, args, _):
                    if exception_operand_is_token(func, token_ids):
                        return exception_cfg_error("exception token used as call target")
                    if exception_operands_have_token(args, token_ids):
                        return exception_cfg_error("exception token passed to ordinary call")
                case _:
                    if exception_illegal_inst_use(instruction.kind, token_ids):
                        return exception_cfg_error(
                            "exception token used by ordinary instruction")
        match block.terminator:
            case Resume(token):
                val token_id = exception_operand_local(token)
                if not token_ids.has(token_id):
                    return exception_cfg_error("Resume operand is not a LandingPad token")
            case If(cond, _, _) | Switch(cond, _, _):
                if exception_operand_is_token(cond, token_ids):
                    return exception_cfg_error("exception token used as branch condition")
            case CallTerminator(_, func, args, _, _, _):
                if (exception_operand_is_token(func, token_ids) or
                    exception_operands_have_token(args, token_ids)):
                    return exception_cfg_error("exception token used by CallTerminator")
            case Ret(value):
                if value != nil and token_ids.has(exception_operand_local(value.unwrap())):
                    return exception_cfg_error("exception token returned from function")
            case Throw(value):
                if token_ids.has(exception_operand_local(value)):
                    return exception_cfg_error("exception token used as source Throw payload")
            case _: ()

    # Path proof per unwind entry. The region is closed under ordinary CFG
    # successors; every terminal must Resume the entry token. Fixed-point
    # completion rejects cycles and paths that cannot reach Resume. External
    # entries into any region block are rejected, which proves pad dominance.
    for unwind_id in unwind_targets.keys():
        val unwind_block = exception_block_by_id(body, unwind_id)
        if unwind_block == nil:
            return exception_cfg_error("unwind successor {unwind_id} does not exist")
        val first_inst = unwind_block.unwrap().instructions[0]
        val token_id = match first_inst.kind:
            case LandingPad(dest): dest.id
            case _: -1
        var region: Dict<i64, bool> = {}
        var worklist: [i64] = [unwind_id]
        while worklist.len() > 0:
            val current = worklist.pop()
            if region.has(current):
                continue
            region[current] = true
            val current_block = exception_block_by_id(body, current)
            if current_block == nil:
                return exception_cfg_error("cleanup successor {current} does not exist")
            for instruction in current_block.unwrap().instructions:
                match instruction.kind:
                    case LandingPad(_): ()
                    case Call(_, func, args):
                        var known_release = false
                        match func.kind:
                            case Const(MirConstValue.Str(name), _):
                                known_release = name == "aspect_execution_context_release_facet_descriptor_or_panic"
                            case _: ()
                        if not known_release:
                            return exception_cfg_error(
                                "cleanup region call is not the known NoUnwind facet release ABI")
                    case _:
                        return exception_cfg_error(
                            "cleanup region contains a non-cleanup instruction")
            match current_block.unwrap().terminator:
                case Resume(token):
                    if exception_operand_local(token) != token_id:
                        return exception_cfg_error("cleanup path resumes the wrong ExceptionToken")
                case Goto(_) | If(_, _, _) | Switch(_, _, _):
                    for successor in exception_successors(current_block.unwrap().terminator):
                        worklist.push(successor)
                case _:
                    return exception_cfg_error(
                        "unwind cleanup path must terminate in Resume")

        for block in body.blocks:
            if region.has(block.id.id):
                continue
            for successor in exception_successors(block.terminator):
                if region.has(successor):
                    return exception_cfg_error(
                        "landing-pad region has a non-unwind external predecessor")
            match block.terminator:
                case CallTerminator(_, _, _, normal, _, unwind):
                    if region.has(normal.id):
                        return exception_cfg_error(
                            "landing-pad region has a normal call predecessor")
                    if unwind != nil and region.has(unwind.unwrap().id) and unwind.unwrap().id != unwind_id:
                        return exception_cfg_error(
                            "landing-pad region has an external unwind predecessor")
                case _: ()
            match block.terminator:
                case Resume(token):
                    if exception_operand_local(token) == token_id:
                        return exception_cfg_error(
                            "Resume is not dominated by its LandingPad")
                case _: ()

        var complete: Dict<i64, bool> = {}
        var progress = true
        while progress:
            progress = false
            for block_id in region.keys():
                if complete.has(block_id):
                    continue
                val region_block = exception_block_by_id(body, block_id).unwrap()
                var ready = false
                match region_block.terminator:
                    case Resume(_): ready = true
                    case Goto(_) | If(_, _, _) | Switch(_, _, _):
                        ready = true
                        for successor in exception_successors(region_block.terminator):
                            if not complete.has(successor): ready = false
                    case _: ()
                if ready:
                    complete[block_id] = true
                    progress = true
        if complete.len() != region.len():
            return exception_cfg_error(
                "unwind cleanup region contains a cycle or non-resuming path")
    Ok(())

export validate_mir_exception_cfg
