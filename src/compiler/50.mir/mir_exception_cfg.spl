use compiler.mir.mir_instructions.*

fn exception_cfg_error(message: text) -> Result<(), text>:
    Err("E-MIR-UNWIND003 {message}")

fn exception_local_type(body: MirBody, id: i64) -> MirTypeKind?:
    for local in body.locals:
        if local.id.id == id:
            return Some(local.type_.kind)
    nil

fn exception_operand_local(operand: MirOperand) -> i64:
    match operand.kind:
        case Copy(local) | Move(local): local.id
        case _: -1

fn exception_operand_is_token(operand: MirOperand, tokens: Dict<i64, bool>) -> bool:
    tokens.has(exception_operand_local(operand))

fn exception_optional_dest_id(dest: LocalId?) -> i64:
    if dest == nil:
        return -1
    dest.unwrap().id

fn exception_inst_dest_id(inst: MirInstKind) -> i64:
    match inst:
        case LandingPad(dest) | Const(dest, _, _) | Alloc(dest, _): dest.id
        case Copy(dest, _) | Move(dest, _): dest.id
        case BinOp(dest, _, _, _) | CheckedBinOp(dest, _, _, _): dest.id
        case UnaryOp(dest, _, _) | Load(dest, _) | GetElementPtr(dest, _, _): dest.id
        case LoadGlobal(dest, _): dest.id
        case Aggregate(dest, _, _) | GetField(dest, _, _): dest.id
        case Cast(dest, _, _) | Bitcast(dest, _, _): dest.id
        case SimdAddF32x4(dest, _, _) | SimdSubF32x4(dest, _, _): dest.id
        case SimdMulF32x4(dest, _, _) | SimdDivF32x4(dest, _, _): dest.id
        case SimdFmaF32x4(dest, _, _, _): dest.id
        case SimdAddF32x8(dest, _, _) | SimdSubF32x8(dest, _, _): dest.id
        case SimdMulF32x8(dest, _, _) | SimdDivF32x8(dest, _, _): dest.id
        case SimdFmaF32x8(dest, _, _, _): dest.id
        case SimdAddF64x4(dest, _, _) | SimdSubF64x4(dest, _, _): dest.id
        case SimdMulF64x4(dest, _, _) | SimdDivF64x4(dest, _, _): dest.id
        case SimdFmaF64x4(dest, _, _, _): dest.id
        case SimdAddI32x4(dest, _, _) | SimdSubI32x4(dest, _, _): dest.id
        case SimdMulI32x4(dest, _, _) | SimdXorI32x4(dest, _, _): dest.id
        case SimdAndI32x4(dest, _, _) | SimdOrI32x4(dest, _, _): dest.id
        case SimdShlI32x4(dest, _, _) | SimdShrI32x4(dest, _, _): dest.id
        case SimdAddI32x8(dest, _, _) | SimdSubI32x8(dest, _, _): dest.id
        case SimdMulI32x8(dest, _, _) | SimdXorI32x8(dest, _, _): dest.id
        case SimdAndI32x8(dest, _, _) | SimdOrI32x8(dest, _, _): dest.id
        case SimdShlI32x8(dest, _, _) | SimdShrI32x8(dest, _, _): dest.id
        case SimdHaddF32x4(dest, _) | SimdHmaxF32x4(dest, _): dest.id
        case SimdHminF32x4(dest, _): dest.id
        case PipeForward(dest, _, _) | Compose(dest, _, _, _): dest.id
        case Parallel(dest, _) | LayerConnect(dest, _, _): dest.id
        case CreatePromise(dest, _, _) | Await(dest, _): dest.id
        case Spawn(dest, _, _) | Receive(dest, _): dest.id
        case Ref(dest, _, _): dest.id
        case GpuGlobalId(dest, _) | GpuLocalId(dest, _): dest.id
        case GpuBlockId(dest, _) | GpuBlockDim(dest, _): dest.id
        case GpuGridDim(dest, _) | GpuSharedAlloc(dest, _, _): dest.id
        case GpuAtomicOp(dest, _, _, _) | GpuAtomicCas(dest, _, _, _): dest.id
        case VhdlResize(dest, _, _, _) | VhdlSlice(dest, _, _, _): dest.id
        case VhdlConcat(dest, _): dest.id
        case MirSimdSplat(dest, _, _) | MirSimdLoad(dest, _, _, _): dest.id
        case MirSimdGather(dest, _, _, _) | MirSimdBinop(dest, _, _, _): dest.id
        case MirSimdTernop(dest, _, _, _, _) | MirSimdUnop(dest, _, _): dest.id
        case MirSimdReduce(dest, _, _) | MirSimdShuffle(dest, _, _, _): dest.id
        case MirSimdPermute(dest, _, _) | MirSimdCmp(dest, _, _, _): dest.id
        case MirSimdSelect(dest, _, _, _) | MirSimdMaskOp(dest, _, _, _): dest.id
        case MirSimdScalableVsetvl(dest, _, _): dest.id
        case MaskFromCmp(dest, _, _, _) | MaskedAdd(dest, _, _, _): dest.id
        case MaskedMul(dest, _, _, _) | MaskedFma(dest, _, _, _, _): dest.id
        case PredicatedAdd(dest, _, _, _, _, _): dest.id
        case PredicatedMul(dest, _, _, _, _, _): dest.id
        case PredicatedFma(dest, _, _, _, _, _, _): dest.id
        case MirWarpShfl(dest, _, _, _, _) | MirWarpReduce(dest, _, _, _): dest.id
        case MirWarpBallot(dest, _, _) | MirWarpActivesMask(dest): dest.id
        case Call(dest, _, _) | CallIndirect(dest, _, _, _) | Intrinsic(dest, _, _):
            exception_optional_dest_id(dest)
        case Store(_, _) | StoreGlobal(_, _) | SetField(_, _, _): -1
        case InlineAsm(_, _, _, _, _) | DebugValue(_, _) | Nop: -1
        case Yield(_) | Send(_, _): -1
        case GpuKernelDef(_) | GpuLaunch(_) | GpuBarrier(_) | GpuMemFence(_): -1
        case HostGpuLaneBegin(_, _) | HostGpuLaneEnd(_): -1
        case VhdlProcess(_, _) | VhdlSignalAssign(_, _, _): -1
        case VhdlVarAssign(_, _) | VhdlPortMap(_, _, _): -1
        case ScalableVecFence(_) | MirSimdStore(_, _, _): -1
        case MirSimdScatter(_, _, _) | MirWarpSync(_): -1

fn exception_inst_definition_count_for_local(
    inst: MirInstKind, local: LocalId
) -> i64:
    match inst:
        case InlineAsm(_, _, _, outputs, _):
            var count = 0
            for output in outputs:
                match output.kind:
                    case Out | LateOut | InOut:
                        if exception_operand_local(output.operand) == local.id:
                            count = count + 1
                    case In: ()
            count
        case _:
            if exception_inst_dest_id(inst) == local.id: 1 else: 0

fn exception_terminator_dest_id(term: MirTerminator) -> i64:
    match term:
        case CallTerminator(dest, _, _, _, _, _): exception_optional_dest_id(dest)
        case _: -1

fn exception_operands_have_token(
    operands: [MirOperand], tokens: Dict<i64, bool>
) -> bool:
    for operand in operands:
        if exception_operand_is_token(operand, tokens):
            return true
    false

fn exception_illegal_inst_use(inst: MirInstKind, tokens: Dict<i64, bool>) -> bool:
    match inst:
        case LandingPad(_): false
        case Const(dest, _, _) | Alloc(dest, _): tokens.has(dest.id)
        case Copy(dest, src) | Move(dest, src):
            tokens.has(dest.id) or tokens.has(src.id)
        case DebugValue(local, _): tokens.has(local.id)
        case Ref(dest, _, place): tokens.has(dest.id) or tokens.has(place.local.id)
        case Nop: false
        case BinOp(_, _, left, right) | CheckedBinOp(_, _, left, right):
            exception_operand_is_token(left, tokens) or exception_operand_is_token(right, tokens)
        case UnaryOp(_, _, operand) | Cast(_, operand, _) | Bitcast(_, operand, _):
            exception_operand_is_token(operand, tokens)
        case Load(_, ptr) | GetField(_, ptr, _):
            exception_operand_is_token(ptr, tokens)
        case Store(ptr, value) | SetField(ptr, _, value):
            exception_operand_is_token(ptr, tokens) or exception_operand_is_token(value, tokens)
        case GetElementPtr(_, base, indices):
            exception_operand_is_token(base, tokens) or exception_operands_have_token(indices, tokens)
        case Aggregate(_, _, operands):
            exception_operands_have_token(operands, tokens)
        case Call(_, func, args) | CallIndirect(_, func, args, _):
            exception_operand_is_token(func, tokens) or exception_operands_have_token(args, tokens)
        case Intrinsic(_, _, args):
            exception_operands_have_token(args, tokens)
        case PipeForward(_, value, func):
            exception_operand_is_token(value, tokens) or exception_operand_is_token(func, tokens)
        case Compose(_, left, right, _):
            exception_operand_is_token(left, tokens) or exception_operand_is_token(right, tokens)
        case Parallel(_, funcs):
            exception_operands_have_token(funcs, tokens)
        # Sound fail-closed default: a newly added opcode must explicitly
        # prove that none of its fields can consume or redefine a token.
        case _: true

fn exception_block_by_id(body: MirBody, id: i64) -> MirBlock?:
    for block in body.blocks:
        if block.id.id == id:
            return Some(block)
    nil

fn exception_successors(term: MirTerminator) -> [i64]:
    match term:
        case Goto(target): [target.id]
        case If(_, then_, else_): [then_.id, else_.id]
        case Switch(_, targets, default):
            var result: [i64] = [default.id]
            for target in targets:
                result.push(target.target.id)
            result
        case _: []

fn exception_normal_successors(term: MirTerminator) -> [i64]:
    match term:
        case CallTerminator(_, _, _, normal, _, _): [normal.id]
        case _: exception_successors(term)

fn exception_reaches_block_avoiding(
    body: MirBody, target: i64, forbidden: i64
) -> bool:
    if body.blocks.len() == 0:
        return false
    var visited: Dict<i64, bool> = {}
    var worklist: [i64] = [body.entry_block.id]
    while worklist.len() > 0:
        val current = worklist.pop()
        if current == forbidden or visited.has(current):
            continue
        if current == target:
            return true
        visited[current] = true
        val block = exception_block_by_id(body, current)
        if block != nil:
            for successor in exception_normal_successors(
                block.unwrap().terminator):
                worklist.push(successor)
    false

fn exception_definition_count(body: MirBody, local: LocalId) -> i64:
    var count = 0
    for block in body.blocks:
        for instruction in block.instructions:
            count = count + exception_inst_definition_count_for_local(
                instruction.kind, local)
        if exception_terminator_dest_id(block.terminator) == local.id:
            count = count + 1
    count

fn exception_definition_block(body: MirBody, local: LocalId) -> BlockId?:
    for block in body.blocks:
        for instruction in block.instructions:
            if exception_inst_definition_count_for_local(
                instruction.kind, local) > 0:
                return Some(block.id)
        if exception_terminator_dest_id(block.terminator) == local.id:
            return Some(block.id)
    nil

fn exception_has_instruction_definition(body: MirBody, local: LocalId) -> bool:
    for block in body.blocks:
        for instruction in block.instructions:
            if exception_inst_definition_count_for_local(
                instruction.kind, local) > 0:
                return true
    false

fn exception_owner_has_canonical_bitcast(body: MirBody, owner: LocalId) -> bool:
    for block in body.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case Bitcast(dest, source, target):
                    if dest.id != owner.id:
                        continue
                    match target.kind:
                        case Opaque(name):
                            if name != "AspectExecutionContext": return false
                        case _: return false
                    val source_type = exception_local_type(
                        body, exception_operand_local(source))
                    if source_type == nil:
                        return false
                    match source_type.unwrap():
                        case Struct(_): return true
                        case _: return false
                case _: ()
    false

fn exception_owner_source_struct_symbol(body: MirBody, owner: LocalId) -> i64:
    for block in body.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case Bitcast(dest, source, target):
                    if dest.id != owner.id:
                        continue
                    match target.kind:
                        case Opaque(name):
                            if name != "AspectExecutionContext": return -1
                        case _: return -1
                    val source_type = exception_local_type(
                        body, exception_operand_local(source))
                    if source_type == nil:
                        return -1
                    match source_type.unwrap():
                        case Struct(symbol): return symbol.id
                        case _: return -1
                case _: ()
    -1

fn exception_module_context_symbol(module: MirModule) -> i64:
    var context_symbol = -1
    for symbol in module.types.keys():
        val type_def = module.types[symbol]
        val is_context_struct = match type_def.kind:
            case Struct(_): true
            case _: false
        if type_def.name == "AspectExecutionContext" and is_context_struct:
            if context_symbol >= 0:
                return -1
            context_symbol = symbol.id
    context_symbol

fn exception_validate_cleanup_owner_nominals(
    module: MirModule, function: MirFunction
) -> Result<(), text>:
    val body = MirBody.from_function(function)
    val canonical_symbol = exception_module_context_symbol(module)
    for contract in function.exception_cleanup_contracts:
        for entry in contract.entries:
            val symbol_id = exception_owner_source_struct_symbol(body, entry.owner)
            if symbol_id < 0 or symbol_id != canonical_symbol:
                return exception_cfg_error(
                    "facet cleanup manifest owner source is not canonical AspectExecutionContext")
    Ok(())

fn exception_definition_dominates_unwind_calls(
    body: MirBody, local: LocalId, unwind_entry: BlockId
) -> bool:
    val definition = exception_definition_block(body, local)
    if definition == nil:
        return false
    var found_call = false
    for block in body.blocks:
        match block.terminator:
            case CallTerminator(_, _, _, _, MayUnwind, unwind):
                if unwind != nil and unwind.unwrap().id == unwind_entry.id:
                    found_call = true
                    if not exception_reaches_block_avoiding(
                        body, block.id.id, -1):
                        return false
                    if (definition.unwrap().id != block.id.id and
                        exception_reaches_block_avoiding(
                            body, block.id.id, definition.unwrap().id)):
                        return false
            case _: ()
    found_call

fn exception_release_signature_is_exact(type_: MirType) -> bool:
    match type_.kind:
        case FuncPtr(signature):
            if signature.is_variadic or signature.params.len() != 2:
                return false
            if signature.return_type.kind != MirTypeKind.Unit:
                return false
            match signature.params[0].kind:
                case Opaque(name):
                    if name != "AspectExecutionContext": return false
                case _: return false
            match signature.params[1].kind:
                case Opaque(name): name == "__simple_facet_descriptor_lease_abi"
                case _: false
        case _: false

fn exception_is_exact_facet_release(
    body: MirBody, dest: LocalId?, func: MirOperand, args: [MirOperand]
) -> bool:
    if dest != nil or args.len() != 2:
        return false
    match func.kind:
        case Const(MirConstValue.Str(name), type_):
            if name != "aspect_execution_context_release_facet_descriptor_or_panic":
                return false
            if not exception_release_signature_is_exact(type_): return false
        case _: return false
    val owner_type = exception_local_type(body, exception_operand_local(args[0]))
    val lease_type = exception_local_type(body, exception_operand_local(args[1]))
    if owner_type == nil or lease_type == nil:
        return false
    val owner_exact = match owner_type.unwrap():
        case Opaque(name): name == "AspectExecutionContext"
        case _: false
    val lease_exact = match lease_type.unwrap():
        case Opaque(name): name == "__simple_facet_descriptor_lease_abi"
        case _: false
    # The manifest verifier adds exact site, identity, count, and order checks.
    owner_exact and lease_exact

fn exception_release_matches_entry(
    body: MirBody, inst: MirInstKind, entry: MirFacetCleanupEntryContract
) -> bool:
    if (entry.release_symbol !=
        "aspect_execution_context_release_facet_descriptor_or_panic"):
        return false
    match inst:
        case Call(dest, func, args):
            if not exception_is_exact_facet_release(body, dest, func, args):
                return false
            if args.len() != 2:
                return false
            exception_operand_local(args[0]) == entry.owner.id and
                exception_operand_local(args[1]) == entry.lease.id
        case _: false

fn exception_validate_cleanup_manifest(
    body: MirBody,
    contract: MirExceptionCleanupContract,
    region: Dict<i64, bool>
) -> Result<(), text>:
    val entry_block = exception_block_by_id(body, contract.unwind_entry.id)
    if entry_block == nil or not region.has(contract.unwind_entry.id):
        return exception_cfg_error("facet cleanup manifest has stale unwind entry")
    if entry_block.unwrap().instructions.len() == 0:
        return exception_cfg_error("facet cleanup manifest entry has no LandingPad")
    match entry_block.unwrap().instructions[0].kind:
        case LandingPad(token):
            if token.id != contract.token.id:
                return exception_cfg_error("facet cleanup manifest token does not match LandingPad")
        case _:
            return exception_cfg_error("facet cleanup manifest entry does not begin with LandingPad")

    var leases: Dict<i64, bool> = {}
    for entry in contract.entries:
        val owner_type = exception_local_type(body, entry.owner.id)
        val lease_type = exception_local_type(body, entry.lease.id)
        if owner_type == nil or lease_type == nil:
            return exception_cfg_error("facet cleanup manifest references a stale local")
        val owner_ok = match owner_type.unwrap():
            case Opaque(name): name == "AspectExecutionContext"
            case _: false
        val lease_ok = match lease_type.unwrap():
            case Opaque(name): name == "__simple_facet_descriptor_lease_abi"
            case _: false
        if not owner_ok or not lease_ok:
            return exception_cfg_error("facet cleanup manifest owner or lease type is not exact")
        if (exception_definition_count(body, entry.owner) != 1 or
            exception_definition_count(body, entry.lease) != 1 or
            not exception_has_instruction_definition(body, entry.owner) or
            not exception_has_instruction_definition(body, entry.lease)):
            return exception_cfg_error(
                "facet cleanup manifest local must have exactly one definition")
        if not exception_owner_has_canonical_bitcast(body, entry.owner):
            return exception_cfg_error(
                "facet cleanup manifest owner is not a canonical context Bitcast")
        if (not exception_definition_dominates_unwind_calls(
                body, entry.owner, contract.unwind_entry) or
            not exception_definition_dominates_unwind_calls(
                body, entry.lease, contract.unwind_entry)):
            return exception_cfg_error(
                "facet cleanup manifest local definition does not dominate unwind call")
        if leases.has(entry.lease.id):
            return exception_cfg_error("facet cleanup manifest repeats a lease local")
        leases[entry.lease.id] = true

        val site_block = exception_block_by_id(body, entry.release_site.block.id)
        if site_block == nil or not region.has(entry.release_site.block.id):
            return exception_cfg_error("facet cleanup manifest has a stale release block")
        if (entry.release_site.instruction_index < 0 or
            entry.release_site.instruction_index >= site_block.unwrap().instructions.len()):
            return exception_cfg_error("facet cleanup manifest has a stale release instruction index")
        val site_inst = site_block.unwrap().instructions[
            entry.release_site.instruction_index]
        if not exception_release_matches_entry(body, site_inst.kind, entry):
            return exception_cfg_error("facet cleanup manifest release site does not match exact ABI arguments")

        if entry.present == nil:
            if entry.guard_block != nil or entry.continue_block != nil:
                return exception_cfg_error("unconditional cleanup manifest entry carries guard metadata")
        else:
            val present = entry.present.unwrap()
            val present_type = exception_local_type(body, present.id)
            if present_type == nil or present_type.unwrap() != MirTypeKind.Bool:
                return exception_cfg_error("facet cleanup manifest presence guard is not Bool")
            if (exception_definition_count(body, present) != 1 or
                not exception_has_instruction_definition(body, present)):
                return exception_cfg_error(
                    "facet cleanup manifest local must have exactly one definition")
            if not exception_definition_dominates_unwind_calls(
                body, present, contract.unwind_entry):
                return exception_cfg_error(
                    "facet cleanup manifest local definition does not dominate unwind call")
            if entry.guard_block == nil or entry.continue_block == nil:
                return exception_cfg_error("guarded cleanup manifest entry lacks CFG metadata")
            val guard_id = entry.guard_block.unwrap().id
            val continue_id = entry.continue_block.unwrap().id
            val guard = exception_block_by_id(body, guard_id)
            val release = exception_block_by_id(body, entry.release_site.block.id)
            if (guard == nil or release == nil or not region.has(guard_id) or
                not region.has(continue_id)):
                return exception_cfg_error("guarded cleanup manifest references a stale CFG block")
            match guard.unwrap().terminator:
                case If(cond, then_, else_):
                    if (exception_operand_local(cond) != present.id or
                        then_.id != entry.release_site.block.id or
                        else_.id != continue_id):
                        return exception_cfg_error("guarded cleanup manifest does not match true-release false-bypass CFG")
                case _:
                    return exception_cfg_error("guarded cleanup manifest guard block is not If")
            match release.unwrap().terminator:
                case Goto(target):
                    if target.id != continue_id:
                        return exception_cfg_error("guarded cleanup release does not reach its continuation")
                case _:
                    return exception_cfg_error("guarded cleanup release block is not a single continuation edge")
            for candidate in body.blocks:
                if not region.has(candidate.id.id) or candidate.id.id == guard_id:
                    continue
                for successor in exception_successors(candidate.terminator):
                    if successor == entry.release_site.block.id:
                        return exception_cfg_error("guarded cleanup release block has an extra predecessor")

    var cursors: Dict<i64, i64> = {}
    var worklist: [i64] = [contract.unwind_entry.id]
    cursors[contract.unwind_entry.id] = 0
    while worklist.len() > 0:
        val block_id = worklist.pop()
        val block = exception_block_by_id(body, block_id).unwrap()
        var cursor = cursors[block_id]
        var instruction_index = 0
        for instruction in block.instructions:
            match instruction.kind:
                case Call(_, _, _):
                    if cursor >= contract.entries.len():
                        return exception_cfg_error("facet cleanup path contains an extra release")
                    val expected = contract.entries[cursor]
                    if (expected.release_site.block.id != block_id or
                        expected.release_site.instruction_index != instruction_index):
                        return exception_cfg_error("facet cleanup releases are missing or reordered")
                    if not exception_release_matches_entry(body, instruction.kind, expected):
                        return exception_cfg_error("facet cleanup release does not match manifest")
                    cursor = cursor + 1
                case _:
                    ()
            instruction_index = instruction_index + 1

        match block.terminator:
            case Resume(token):
                if (exception_operand_local(token) != contract.token.id or
                    cursor != contract.entries.len()):
                    return exception_cfg_error("facet cleanup Resume occurs before all manifest entries are consumed")
            case If(_, then_, else_):
                var guarded = false
                var false_cursor = cursor
                if cursor < contract.entries.len():
                    val expected = contract.entries[cursor]
                    if (expected.present != nil and expected.guard_block != nil and
                        expected.guard_block.unwrap().id == block_id):
                        guarded = true
                        false_cursor = cursor + 1
                val successor_ids = [then_.id, else_.id]
                val successor_cursors = [cursor, if guarded: false_cursor else: cursor]
                var successor_index = 0
                while successor_index < successor_ids.len():
                    val successor = successor_ids[successor_index]
                    val next_cursor = successor_cursors[successor_index]
                    if cursors.has(successor):
                        if cursors[successor] != next_cursor:
                            return exception_cfg_error("facet cleanup join has inconsistent manifest order")
                    else:
                        cursors[successor] = next_cursor
                        worklist.push(successor)
                    successor_index = successor_index + 1
            case Goto(target):
                if cursors.has(target.id):
                    if cursors[target.id] != cursor:
                        return exception_cfg_error("facet cleanup join has inconsistent manifest order")
                else:
                    cursors[target.id] = cursor
                    worklist.push(target.id)
            case Switch(_, targets, default):
                var successors: [i64] = [default.id]
                for target in targets:
                    successors.push(target.target.id)
                for successor in successors:
                    if cursors.has(successor):
                        if cursors[successor] != cursor:
                            return exception_cfg_error("facet cleanup join has inconsistent manifest order")
                    else:
                        cursors[successor] = cursor
                        worklist.push(successor)
            case _:
                return exception_cfg_error("facet cleanup manifest reaches a non-Resume terminal")
    Ok(())

fn validate_mir_exception_cfg(body: MirBody) -> Result<(), text>:
    """Validate unwind-only landing pads and linear exception-token provenance."""
    var block_ids: Dict<i64, bool> = {}
    for block in body.blocks:
        if block_ids.has(block.id.id):
            return exception_cfg_error("duplicate MIR block id {block.id.id}")
        block_ids[block.id.id] = true
    var local_ids: Dict<i64, bool> = {}
    for local in body.locals:
        if local_ids.has(local.id.id):
            return exception_cfg_error("duplicate MIR local id {local.id.id}")
        local_ids[local.id.id] = true

    var unwind_targets: Dict<i64, bool> = {}
    var normal_targets: Dict<i64, bool> = {}
    for block in body.blocks:
        match block.terminator:
            case Goto(target): normal_targets[target.id] = true
            case If(_, then_, else_):
                normal_targets[then_.id] = true
                normal_targets[else_.id] = true
            case Switch(_, targets, default):
                normal_targets[default.id] = true
                for target in targets:
                    normal_targets[target.target.id] = true
            case CallTerminator(_, _, _, normal, contract, unwind):
                val contract_validation = validate_mir_call_unwind_contract(contract, unwind)
                if contract_validation.is_err():
                    return exception_cfg_error(contract_validation.unwrap_err())
                normal_targets[normal.id] = true
                if contract == MirCallUnwindContract.MayUnwind:
                    unwind_targets[unwind.unwrap().id] = true
            case _: ()

    var token_ids: Dict<i64, bool> = {}
    var token_definition_counts: Dict<i64, i64> = {}
    for block in body.blocks:
        var pad_count = 0
        var instruction_index = 0
        for instruction in block.instructions:
            match instruction.kind:
                case LandingPad(dest):
                    pad_count = pad_count + 1
                    if instruction_index != 0:
                        return exception_cfg_error("LandingPad must be the first instruction of unwind block {block.id.id}")
                    if not unwind_targets.has(block.id.id):
                        return exception_cfg_error("LandingPad block {block.id.id} is not an unwind successor")
                    if normal_targets.has(block.id.id):
                        return exception_cfg_error("LandingPad block {block.id.id} has a normal predecessor")
                    val local_kind = exception_local_type(body, dest.id)
                    if local_kind == nil or local_kind.unwrap() != MirTypeKind.ExceptionToken:
                        return exception_cfg_error("LandingPad destination {dest.id} is not ExceptionToken")
                    token_ids[dest.id] = true
                    token_definition_counts[dest.id] = (
                        token_definition_counts.get(dest.id) ?? 0) + 1
                case _: ()
            instruction_index = instruction_index + 1
        if unwind_targets.has(block.id.id) and pad_count != 1:
            return exception_cfg_error("unwind successor {block.id.id} must contain exactly one LandingPad")

    # No fabricated token locals: every ExceptionToken local has exactly one
    # LandingPad definition, and tokens are never forwarded or redefined.
    for local in body.locals:
        if local.type_.kind == MirTypeKind.ExceptionToken and not token_ids.has(local.id.id):
            return exception_cfg_error(
                "ExceptionToken local {local.id.id} has no LandingPad definition")
    for token_id in token_ids.keys():
        if token_definition_counts[token_id] != 1:
            return exception_cfg_error(
                "ExceptionToken local {token_id} must have exactly one LandingPad definition")

    var manifest_entries: Dict<i64, bool> = {}
    for contract in body.exception_cleanup_contracts:
        match contract.kind:
            case FacetCleanup:
                if contract.entries.len() == 0:
                    return exception_cfg_error(
                        "facet cleanup manifest must contain at least one release")
            case OrdinaryUnwind:
                if contract.entries.len() > 0:
                    return exception_cfg_error(
                        "ordinary unwind manifest cannot contain facet releases")
        val unwind_id = contract.unwind_entry.id
        if manifest_entries.has(unwind_id):
            return exception_cfg_error("facet cleanup landing pad has multiple manifests")
        if not unwind_targets.has(unwind_id):
            return exception_cfg_error("orphan facet cleanup manifest has no unwind entry")
        manifest_entries[unwind_id] = true
    for unwind_id in unwind_targets.keys():
        if not manifest_entries.has(unwind_id):
            return exception_cfg_error("facet cleanup landing pad has no manifest")

    for block in body.blocks:
        for instruction in block.instructions:
            val instruction_dest = exception_inst_dest_id(instruction.kind)
            if token_ids.has(instruction_dest):
                match instruction.kind:
                    case LandingPad(_): ()
                    case _:
                        return exception_cfg_error(
                            "ordinary instruction redefines an ExceptionToken local")
            match instruction.kind:
                case LandingPad(_): ()
                case Call(_, func, args) | CallIndirect(_, func, args, _):
                    if exception_operand_is_token(func, token_ids):
                        return exception_cfg_error("exception token used as call target")
                    if exception_operands_have_token(args, token_ids):
                        return exception_cfg_error("exception token passed to ordinary call")
                case _:
                    if exception_illegal_inst_use(instruction.kind, token_ids):
                        return exception_cfg_error(
                            "exception token used by ordinary instruction")
        if token_ids.has(exception_terminator_dest_id(block.terminator)):
            return exception_cfg_error(
                "CallTerminator redefines an ExceptionToken local")
        match block.terminator:
            case Resume(token):
                val token_id = exception_operand_local(token)
                if not token_ids.has(token_id):
                    return exception_cfg_error("Resume operand is not a LandingPad token")
            case If(cond, _, _) | Switch(cond, _, _):
                if exception_operand_is_token(cond, token_ids):
                    return exception_cfg_error("exception token used as branch condition")
            case CallTerminator(_, func, args, _, _, _):
                if (exception_operand_is_token(func, token_ids) or
                    exception_operands_have_token(args, token_ids)):
                    return exception_cfg_error("exception token used by CallTerminator")
            case Ret(value):
                if value != nil and token_ids.has(exception_operand_local(value.unwrap())):
                    return exception_cfg_error("exception token returned from function")
            case Throw(value):
                if token_ids.has(exception_operand_local(value)):
                    return exception_cfg_error("exception token used as source Throw payload")
            case _: ()

    # Path proof per unwind entry. The region is closed under ordinary CFG
    # successors; every terminal must Resume the entry token. Fixed-point
    # completion rejects cycles and paths that cannot reach Resume. External
    # entries into any region block are rejected, which proves pad dominance.
    for unwind_id in unwind_targets.keys():
        val unwind_block = exception_block_by_id(body, unwind_id)
        if unwind_block == nil:
            return exception_cfg_error("unwind successor {unwind_id} does not exist")
        val first_inst = unwind_block.unwrap().instructions[0]
        val token_id = match first_inst.kind:
            case LandingPad(dest): dest.id
            case _: -1
        var region: Dict<i64, bool> = {}
        var has_facet_release = false
        var worklist: [i64] = [unwind_id]
        while worklist.len() > 0:
            val current = worklist.pop()
            if region.has(current):
                continue
            region[current] = true
            val current_block = exception_block_by_id(body, current)
            if current_block == nil:
                return exception_cfg_error("cleanup successor {current} does not exist")
            for instruction in current_block.unwrap().instructions:
                match instruction.kind:
                    case LandingPad(_): ()
                    case Call(dest, func, args):
                        if not exception_is_exact_facet_release(body, dest, func, args):
                            return exception_cfg_error(
                                "cleanup region call is not the exact NoUnwind facet release ABI")
                        has_facet_release = true
                    case _:
                        return exception_cfg_error(
                            "cleanup region contains a non-cleanup instruction")
            match current_block.unwrap().terminator:
                case Resume(token):
                    if exception_operand_local(token) != token_id:
                        return exception_cfg_error("cleanup path resumes the wrong ExceptionToken")
                case Goto(_) | If(_, _, _) | Switch(_, _, _):
                    for successor in exception_successors(current_block.unwrap().terminator):
                        worklist.push(successor)
                case _:
                    return exception_cfg_error(
                        "unwind cleanup path must terminate in Resume")

        var matching_contract: MirExceptionCleanupContract? = nil
        for contract in body.exception_cleanup_contracts:
            if contract.unwind_entry.id == unwind_id:
                matching_contract = Some(contract)
        if matching_contract == nil:
            return exception_cfg_error("facet cleanup landing pad has no manifest")
        if matching_contract != nil:
            val manifest_validation = exception_validate_cleanup_manifest(
                body, matching_contract.unwrap(), region)
            if manifest_validation.is_err():
                return manifest_validation

        for block in body.blocks:
            if region.has(block.id.id):
                continue
            for successor in exception_successors(block.terminator):
                if region.has(successor):
                    return exception_cfg_error(
                        "landing-pad region has a non-unwind external predecessor")
            match block.terminator:
                case CallTerminator(_, _, _, normal, _, unwind):
                    if region.has(normal.id):
                        return exception_cfg_error(
                            "landing-pad region has a normal call predecessor")
                    if unwind != nil and region.has(unwind.unwrap().id) and unwind.unwrap().id != unwind_id:
                        return exception_cfg_error(
                            "landing-pad region has an external unwind predecessor")
                case _: ()
            match block.terminator:
                case Resume(token):
                    if exception_operand_local(token) == token_id:
                        return exception_cfg_error(
                            "Resume is not dominated by its LandingPad")
                case _: ()

        var complete: Dict<i64, bool> = {}
        var progress = true
        while progress:
            progress = false
            for block_id in region.keys():
                if complete.has(block_id):
                    continue
                val region_block = exception_block_by_id(body, block_id).unwrap()
                var ready = false
                match region_block.terminator:
                    case Resume(_): ready = true
                    case Goto(_) | If(_, _, _) | Switch(_, _, _):
                        ready = true
                        for successor in exception_successors(region_block.terminator):
                            if not complete.has(successor): ready = false
                    case _: ()
                if ready:
                    complete[block_id] = true
                    progress = true
        if complete.len() != region.len():
            return exception_cfg_error(
                "unwind cleanup region contains a cycle or non-resuming path")
    Ok(())

fn validate_mir_exception_module(module: MirModule, phase: text) -> Result<(), text>:
    """Validate every function at a typed production pipeline boundary."""
    for function in module.functions.values():
        val validation = validate_mir_exception_cfg(MirBody.from_function(function))
        if validation.is_err():
            return Err("{validation.unwrap_err()} in function '{function.name}' {phase}")
        val nominal_validation = exception_validate_cleanup_owner_nominals(
            module, function)
        if nominal_validation.is_err():
            return Err("{nominal_validation.unwrap_err()} in function '{function.name}' {phase}")
    Ok(())

fn validate_mir_exception_module_gate_or_panic(module: MirModule, phase: text):
    """Validate every function at a production pipeline boundary."""
    val validation = validate_mir_exception_module(module, phase)
    if validation.is_err():
        panic(validation.unwrap_err())

export validate_mir_exception_cfg, validate_mir_exception_module
export validate_mir_exception_module_gate_or_panic
