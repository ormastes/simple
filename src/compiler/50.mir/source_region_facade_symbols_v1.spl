# Resolved compiler declaration identities, never caller-authored function names.
use compiler.hir.hir_types.{SymbolId}

struct SourceRegionFacadeSymbolsV1:
    create: SymbolId
    alloc: SymbolId
    write_begin: SymbolId
    write_commit: SymbolId
    alias_write: SymbolId
    stamp: SymbolId
    read_begin: SymbolId
    read_end: SymbolId
    close: SymbolId
