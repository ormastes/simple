# Invoked at the canonical enum emitter, not from function-name dispatch.
use compiler.mir.mir_data.*
use compiler.mir.canonical_enum_builtin_site_v1.{CanonicalEnumBuiltinOperationV1, CanonicalEnumBuiltinSiteV1}

impl MirBuilder:
    me emit_canonical_enum_builtin_v1(operation: CanonicalEnumBuiltinOperationV1,
            enum_runtime_id: i64, discriminant: i64, callee: MirOperand,
            args: [MirOperand], result_type: MirType) -> LocalId?:
        val block = self.current_block
        val position = self.instructions.len()
        val owner = self.current_function
        var argument_types: [MirType] = []
        if self.canonical_enum_builtin_capture_enabled_v1:
            for argument in args:
                match argument.kind:
                    case MirOperandKind.Const(_, type_): argument_types.push(type_)
                    case MirOperandKind.Copy(local) | MirOperandKind.Move(local):
                        var count = 0
                        for declared in self.locals:
                            if declared.id.id == local.id:
                                count = count + 1
                                argument_types.push(declared.type_)
                        if count != 1:
                            self.canonical_enum_builtin_error_v1 = "ENUM-ORIGIN: emitted operand has no unique actual type"
        val result = self.emit_call(callee, args, result_type)
        if self.canonical_enum_builtin_capture_enabled_v1:
            if val function = owner:
                self.canonical_enum_builtin_sites_v1.push(CanonicalEnumBuiltinSiteV1(
                    owner: function.symbol, block: block, instruction_index: position,
                    operation: operation, abi: 1, enum_runtime_id: enum_runtime_id,
                    discriminant: discriminant, callee: callee, operands: args,
                    operand_types: argument_types, result: result, result_type: result_type))
            else:
                self.canonical_enum_builtin_error_v1 = "ENUM-ORIGIN: emitted outside actual function"
        result
