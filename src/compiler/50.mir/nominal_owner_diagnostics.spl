use std.io_runtime.{env_get_opt}

var mir_nominal_profile_enabled_state: i64 = -1
var mir_nominal_profile_receipts: i64 = 0

fn mir_nominal_profile_take_receipt() -> bool:
    # Retained diagnostics only, bounded across one compiler process.
    if mir_nominal_profile_enabled_state < 0:
        mir_nominal_profile_enabled_state = if (env_get_opt("SIMPLE_COMPILER_PHASE_PROFILE") ?? "") == "1": 1 else: 0
    if mir_nominal_profile_enabled_state != 1 or mir_nominal_profile_receipts >= 256:
        return false
    mir_nominal_profile_receipts = mir_nominal_profile_receipts + 1
    true
