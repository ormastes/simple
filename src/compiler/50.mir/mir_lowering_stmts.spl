# MIR Lowering - Statement and Control Flow Lowering
#
# Statement and control flow lowering from HIR to MIR:
# - Statement lowering (let, assign, expr, block, asm assert)
# - Assignment lowering (variable, field, index)
# - If/else lowering to basic blocks
# - Loop, while, for lowering with break/continue
# - Range-based and iterator-based for loop lowering

use compiler.mir.mir_data.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_lowering_types.{MirLowering, MirError}

# std.alloc.sffi only exists in the seed lib tree; the stage4 strict lane
# cannot resolve it — declare the runtime extern directly.
extern fn rt_dict_contains(dict: i64, key: Any) -> bool
extern fn rt_enum_discriminant(value: HirStmtKind) -> i64
extern fn rt_enum_payload(value: HirStmtKind) -> HirExpr

fn mir_stmt_symbol_id_value(symbol: SymbolId) -> i64:
    symbol.id

fn mir_stmt_local_id_value(local: LocalId) -> i64:
    local.id

fn mir_hir_stmt_kind_disc(k: HirStmtKind) -> i64:
    rt_enum_discriminant(k)

fn mir_expr_kind_is_place(k: HirExprKind) -> bool:
    """True when a HIR expression is a PLACE read -- it evaluates to the
    SAME memory an existing binding already owns (a plain variable read,
    a field projection, an index/tuple-index projection) rather than a
    freshly-constructed value (a struct literal, a call result, ...).
    Used by Bug #177's struct local-alias fix (see
    MirLowering.maybe_copy_struct_value below): structs are
    pointer-represented, so binding a NEW name straight to a place read's
    result (as the bitfield/struct pass-through does for a genuinely
    fresh aggregate) makes the new and old names literal aliases of the
    same struct memory."""
    match k:
        case Var(_) | NamedVar(_, _) | Field(_, _, _) | Index(_, _) | TupleIndex(_, _):
            true
        case _:
            false

fn mir_hir_type_is_isolated(t: HirType?) -> bool:
    """LANE ISO1 (2026-07-29): true when a HIR type is the `iso` capability
    wrapper (HirTypeKind.Isolated). Used at variable-to-variable binding
    sites to choose emit_move over emit_copy so the NLL borrow checker sees
    a real Move fact for iso-typed bindings (see MirBuilder.emit_move,
    mir_data.spl, for the prior "no caller yet" state this wires up)."""
    match t:
        case Some(ht):
            match ht.kind:
                case HirTypeKind.Isolated(_):
                    true
                case _:
                    false
        case nil:
            false

# ============================================================================
# Statement Lowering
# ============================================================================

impl MirLowering:
    me local_mir_type_of(local: LocalId) -> MirType?:
        """Look up a local's registered MIR type (mirrors the scan in
        local_is_runtime_array). Used to thread a runtime-array initializer's
        real Array/Slice type onto an un-annotated `var xs = [...]` binding,
        instead of the i64 default that would send later `xs[i]` reads down the
        wrong raw-GEP path (they must take rt_array_get)."""
        for item in self.builder.locals:
            if item.id.id == local.id:
                return item.type_
        nil

    me vulkan_u32_local(local: LocalId) -> LocalId:
        if val type_ = self.local_mir_type_of(local):
            if type_.kind == MirTypeKind.U32:
                return local
        var b = self.builder
        var i = 0
        while i < b.instructions.len():
            val inst = b.instructions[i]
            match inst.kind:
                case MirInstKind.Const(dest, MirConstValue.Int(value), _):
                    if dest.id == local.id and value >= 0 and value <= 4294967295:
                        val u32_type = MirType(kind: MirTypeKind.U32)
                        b.instructions[i] = MirInst(
                            kind: MirInstKind.Const(dest, MirConstValue.Int(value), u32_type),
                            span: inst.span
                        )
                        b.set_local_type(local, u32_type)
                        self.builder = b
                        return local
                case _:
                    ()
            i = i + 1
        val narrowed = b.emit_cast(mir_operand_copy(local), MirType(kind: MirTypeKind.U32))
        self.builder = b
        narrowed

    fn local_is_float(local: LocalId) -> bool:
        """True when a lowered local holds a native float value (F32/F64).

        Keyed off the MIR local type (mirrors local_is_str/local_mir_type_of)
        because the inferred HIR `let_type` for `val y = x * 4.0` is
        unreliably a non-nil i64 on this path. Without threading the real
        F64/F32 type onto the binding, its spill slot is alloca'd i64 and the
        float round-trips through an i64 store (10.0 -> 10)."""
        for item in self.builder.locals:
            if item.id.id == local.id:
                match item.type_.kind:
                    case MirTypeKind.F32: return true
                    case MirTypeKind.F64: return true
                    case _: return false
        false

    fn local_is_bool(local: LocalId) -> bool:
        """True when a lowered local holds a native Bool value."""
        for item in self.builder.locals:
            if item.id.id == local.id:
                match item.type_.kind:
                    case MirTypeKind.Bool: return true
                    case _: return false
        false

    fn local_is_unit(local: LocalId) -> bool:
        """True when a lowered local's registered MIR type is Unit -- e.g. the
        placeholder result of a void statement like `print "x"` used as a
        block's trailing "value" (bootstrap print lowering always returns a
        LocalId even though the call itself has no result). Unit maps to LLVM
        `void` (llvm_type_mapper map_type), and `void` is not a legal alloca /
        load / store operand type -- only a legal function return type. Used
        by lower_if to skip copying such a placeholder into the (always-i64)
        merge-result slot, which otherwise forces the backend to materialize
        an `alloca void` for the arm's placeholder (see bug doc
        native_if_print_only_arms_alloca_void_2026-07-11.md)."""
        val type_ = self.local_mir_type_of(local) ?? MirType.i64()
        match type_.kind:
            case MirTypeKind.Unit: true
            case _: false

    me copy_struct_value_recursive(init_local: LocalId, struct_type_name: text, type_symbol: SymbolId, copy_chain: [text]) -> LocalId:
        """Rebuild a value struct, recursively copying nested value structs."""
        val canonical_type_symbol = self.canonical_mir_type_symbol(type_symbol)
        val field_names = self.struct_field_order[struct_type_name]
        val nested_names = self.struct_field_type_name.get(struct_type_name) ?? []
        var copy_ops: [MirOperand] = []
        var cfi = 0
        while cfi < field_names.len():
            var field_type = MirType.i64()
            var nested_name = ""
            var nested_symbol = SymbolId(id: -1)
            var copy_nested = false
            if cfi < nested_names.len():
                nested_name = nested_names[cfi]
            # Classes remain shared references. Cyclic value layouts are not
            # recursively expanded: their back-edge stays shared until the
            # The pre-MIR value-layout validator rejects direct cyclic value
            # structs; keep the guard defensive for malformed/stale HIR.
            if nested_name != "" and not self.class_type_names.contains(nested_name) and not copy_chain.contains(nested_name):
                nested_symbol = self.symbols.lookup_or_invalid(nested_name)
                if nested_symbol.is_valid() and self.struct_field_order.contains(nested_name):
                    nested_symbol = self.canonical_mir_type_symbol(nested_symbol)
                    field_type = MirType(kind: MirTypeKind.Struct(nested_symbol))
                    copy_nested = true

            var field_bldr = self.builder
            val field_val = field_bldr.emit_get_field(mir_operand_copy(init_local), cfi, field_type)
            self.builder = field_bldr
            var copied_field = field_val

            if copy_nested:
                # Preserve a nil nested field instead of dereferencing it.
                var guard_bldr = self.builder
                val result_slot = guard_bldr.emit_entry_alloc(field_type)
                guard_bldr.emit_store(mir_operand_copy(result_slot), mir_operand_copy(field_val))
                val null_value = guard_bldr.new_temp(field_type)
                guard_bldr.emit_const(null_value, MirConstValue.Zero, field_type)
                val has_value = guard_bldr.emit_binop(MirBinOp.Ne, mir_operand_copy(field_val), mir_operand_copy(null_value), MirType.bool())
                val copy_block = guard_bldr.new_block(Some("structcopy_nested"))
                val merge_block = guard_bldr.new_block(Some("structcopy_merge"))
                guard_bldr.terminate_if(mir_operand_copy(has_value), copy_block, merge_block)
                guard_bldr.switch_to_block(copy_block)
                self.builder = guard_bldr

                var nested_chain: [text] = []
                for seen_name in copy_chain:
                    nested_chain.push(seen_name)
                nested_chain.push(nested_name)
                val nested_copy = self.copy_struct_value_recursive(field_val, nested_name, nested_symbol, nested_chain)

                var merge_bldr = self.builder
                merge_bldr.emit_store(mir_operand_copy(result_slot), mir_operand_copy(nested_copy))
                merge_bldr.terminate_goto(merge_block)
                merge_bldr.switch_to_block(merge_block)
                copied_field = merge_bldr.emit_load(mir_operand_copy(result_slot), field_type)
                self.builder = merge_bldr

            copy_ops.push(mir_operand_copy(copied_field))
            cfi = cfi + 1

        var agg_bldr = self.builder
        val copy_local = agg_bldr.emit_aggregate(
            AggregateKind.Struct(canonical_type_symbol),
            copy_ops,
            MirType(kind: MirTypeKind.Struct(canonical_type_symbol))
        )
        self.builder = agg_bldr
        self.struct_value_syms[copy_local.id] = struct_type_name
        copy_local

    me maybe_copy_struct_value(init_local: LocalId, struct_sym: text?, init_is_place: bool) -> LocalId?:
        """Bug #177 (native struct local-alias copy missing): `var b = a` /
        `val b = a` for a struct-typed `a` used to alias the binding's
        symbol straight to `a`'s own local (the same `bf_sym != nil or
        struct_sym != nil: self.bind_local(symbol, init_local` pass-through)
        the bitfield/fresh-aggregate case correctly uses to skip a redundant
        copy) -- correct when the initializer is a FRESH aggregate (a struct
        literal, a call result: no other name can alias that memory yet),
        but wrong when it is a PLACE read of an EXISTING binding (a plain
        variable read, `outer.child`, `arr[i]`, ...): structs are
        pointer-represented (see the struct_sym computation just above each
        caller), so aliasing there made `b.x = 41` write through to `a.x` /
        `outer.child.n` too. Structs are VALUE types (mirrors Bug #167's
        by-value struct PARAM copy and the interpreter's Value.Struct
        copy-on-bind); classes stay reference types (Bug s19's
        class_type_names), so this copy is skipped for anything registered
        there -- `var d = someClassInstance; d.x = 41` must still leak into
        `someClassInstance.x`. Returns the fresh per-binding copy's LocalId
        when a copy was materialized, nil when the caller should fall back
        to its existing alias/plain-copy behavior (non-struct, class, or a
        fresh-construction initializer -- keeps the redundant-copy cost
        confined to the one case that actually needs it)."""
        if struct_sym == nil or not init_is_place:
            return nil
        val struct_type_name = struct_sym ?? ""
        if struct_type_name == "" or self.class_type_names.contains(struct_type_name):
            return nil
        if not self.struct_field_order.contains(struct_type_name):
            return nil
        val init_type = self.local_mir_type_of(init_local) ?? MirType.i64()
        val struct_symbol_id: SymbolId? = match init_type.kind:
            case MirTypeKind.Struct(sym): sym
            case _: nil
        if val type_symbol = struct_symbol_id:
            return self.copy_struct_value_recursive(init_local, struct_type_name, type_symbol, [struct_type_name])
        nil

    me maybe_copy_array_value(init_local: LocalId, effective_type: MirType, init_is_place: bool) -> LocalId?:
        """Bug #186 (native array local-alias copy missing): sibling to Bug
        #177's struct local-alias fix (maybe_copy_struct_value above), for
        runtime arrays' separate rt_array mechanism -- struct_value_syms /
        struct_field_order don't cover arrays (struct_sym is nil for an
        array-typed binding), so #177's struct-scoped guard correctly left
        this case untouched (see #177's commit message, "Known out-of-scope
        finding"). `var c = arr` / `val c = arr` for an array-typed `arr`
        fell into the ordinary new_local + emit_copy pass-through (the
        `else` branch below, taken whenever bf_sym/struct_sym are both nil)
        for ANY non-struct/non-bitfield initializer: runtime arrays are
        heap-allocated, POINTER-represented handles (core_array_ops.spl's
        SplArray header -- ptr/items/len/cap fields reached via array_ptr/
        array_items), so `emit_copy` there only duplicates the i64 HANDLE
        value, not the backing element buffer -- `c[0] = 99` then calls
        rt_array_set on the exact SAME heap array `arr` still points to (a
        true alias, not a copy), violating the repo's "arrays are value
        types" rule. Correct when the initializer is a FRESH aggregate (an
        array literal, a call result: nothing else names that heap array
        yet, so aliasing the fresh local is harmless) -- wrong when it is a
        PLACE read of an EXISTING array binding (a plain variable read,
        `outer.items` where `items` is a struct's array field, `arr[i]`
        when `arr` holds nested arrays, ...).

        Materializes a private per-binding copy with a synthesized counted
        loop (rt_array_len -> rt_array_new(len) -> per-index rt_array_get +
        rt_array_push), the EXACT same shape as lower_array_map/
        lower_array_filter in method_calls_literals.spl -- NOT a call to
        core_array_ops.spl's `rt_array_copy`, even though that helper exists
        and does the equivalent memcpy in one call: this project's default
        native-build link step compiles/links the hand-written C runtime
        (src/runtime/runtime_native.c), not the pure-Simple `simple_core`
        layer, and runtime_native.c implements rt_array_len/rt_array_new/
        rt_array_get/rt_array_push but NOT rt_array_copy -- a first attempt
        wiring a bare `rt_array_copy` call hit "undefined symbol:
        rt_array_copy" at the ld.lld link step. Adding rt_array_copy to
        runtime_native.c was avoided on purpose (repo hard rule: never wire
        a new `extern fn rt_*` into a CLI-closure module here); the loop
        form needs zero new runtime surface. Mirrors lower_array_filter's
        "push the ORIGINAL tagged element unchanged" step (not
        lower_array_map's decode/re-box round trip): a copy must preserve
        every element's raw tagged word bit-for-bit, matching
        rt_array_copy's own memcpy semantics -- this remains a SHALLOW array
        copy (an array of structs copies each element's pointer, not the
        pointed-to struct). Nested fields inside a directly copied struct use
        copy_struct_value_recursive above; array element depth is separate.
        Returns the fresh copy's LocalId (already flag-propagated -- NOT yet
        bound into local_map, unlike maybe_copy_struct_value, since the
        caller's two call sites bind local_map slightly differently) when a
        copy was materialized; nil when the caller should fall back to its
        existing new_local+emit_copy behavior (non-array, or a
        fresh-construction initializer -- keeps the extra loop confined to
        the one case that actually needs it, per repo perf-review rules)."""
        if not init_is_place or not self.local_is_runtime_array(init_local):
            return nil
        val loop_ty = MirType.i64()

        var b_len = self.builder
        val len_call = b_len.emit_call(self.rt_array_len_operand(), [mir_operand_copy(init_local)], MirType.i64())
        val len_local = len_call ?? b_len.new_temp(MirType.i64())
        self.builder = b_len

        # Pre-size the result at the source's exact length (unlike
        # lower_array_map/filter, which start from an unknown-length 0-cap
        # array since a map/filter result length isn't known up front) --
        # a copy's length IS known up front, so allocate it once instead of
        # growing via push reallocation.
        var b_new = self.builder
        val new_call = b_new.emit_call(MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_array_new"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()], return_type: effective_type, is_variadic: false)))
        )), [mir_operand_copy(len_local)], effective_type)
        val result_arr = new_call ?? b_new.new_temp(effective_type)
        self.builder = b_new
        self.runtime_array_locals[result_arr.id] = true
        self.mark_runtime_value_local(result_arr.id)

        var b_init = self.builder
        val counter = b_init.new_local(nil, loop_ty, LocalKind.Var)
        val zero = b_init.new_temp(loop_ty)
        b_init.emit_const(zero, MirConstValue.Int(0), loop_ty)
        b_init.emit_copy(counter, zero)
        val one = b_init.new_temp(loop_ty)
        b_init.emit_const(one, MirConstValue.Int(1), loop_ty)
        self.builder = b_init

        var b_blocks = self.builder
        val cond_block = b_blocks.new_block(Some("arrcopy_cond"))
        val body_block = b_blocks.new_block(Some("arrcopy_body"))
        val inc_block = b_blocks.new_block(Some("arrcopy_inc"))
        val exit_block = b_blocks.new_block(Some("arrcopy_exit"))
        self.builder = b_blocks

        var b_goto = self.builder
        b_goto.terminate_goto(cond_block)
        b_goto.switch_to_block(cond_block)
        self.builder = b_goto

        var b_cond = self.builder
        val cond_result = b_cond.emit_binop(MirBinOp.Lt, mir_operand_copy(counter), mir_operand_copy(len_local), MirType.bool())
        b_cond.terminate_if(mir_operand_copy(cond_result), body_block, exit_block)
        b_cond.switch_to_block(body_block)
        self.builder = b_cond

        var b_get = self.builder
        val get_call = b_get.emit_call(self.rt_array_get_operand(), [mir_operand_copy(init_local), mir_operand_copy(counter)], MirType.i64())
        val elem_tagged = get_call ?? b_get.new_temp(MirType.i64())
        self.builder = b_get

        var b_push = self.builder
        b_push.emit_call(self.rt_array_push_operand(), [mir_operand_copy(result_arr), mir_operand_copy(elem_tagged)], MirType(kind: MirTypeKind.I8))
        self.builder = b_push

        var b_body_end = self.builder
        if not b_body_end.current_block_has_explicit_terminator():
            b_body_end.terminate_goto(inc_block)
        self.builder = b_body_end

        var b_inc = self.builder
        b_inc.switch_to_block(inc_block)
        val incremented = b_inc.emit_binop(MirBinOp.Add, mir_operand_copy(counter), mir_operand_copy(one), loop_ty)
        b_inc.emit_copy(counter, incremented)
        self.builder = b_inc
        var b_back = self.builder
        b_back.terminate_goto(cond_block)
        self.builder = b_back

        var b_exit = self.builder
        b_exit.switch_to_block(exit_block)
        self.builder = b_exit

        if self.nil_locals.contains(init_local.id):
            self.nil_locals[result_arr.id] = true
        if val init_hir_type = self.find_local_hir_type(init_local.id):
            self.remember_local_hir_type(result_arr.id, init_hir_type)
        val ael_sym = self.array_element_struct_syms.get(init_local.id)
        if ael_sym != nil:
            val ael_name = ael_sym ?? ""
            if ael_name != "":
                self.array_element_struct_syms[result_arr.id] = ael_name
        Some(result_arr)

    me lower_stmt(stmt: HirStmt):
        """Lower HIR statement to MIR.

        Thin save/set/restore wrapper around lower_stmt_impl, mirroring
        lower_expr's wrapper in expr_dispatch.spl. Pushes this statement's own
        span so the emit_* sites in mir_data.spl stamp a real location instead
        of nil, then restores whatever the caller had. Nested blocks go through
        lower_block rather than recursing through this name, so the restore
        mainly guards a later same-scope emit from picking up an inner
        statement's span.
        """
        var b_save = self.builder
        val saved_span = b_save.current_span
        if stmt != nil:
            b_save.current_span = Some(stmt.span)
        self.builder = b_save
        self.lower_stmt_impl(stmt)
        var b_restore = self.builder
        b_restore.current_span = saved_span
        self.builder = b_restore

    me lower_stmt_impl(stmt: HirStmt):
        """Body of lower_stmt. Only reached through the wrapper above, so the
        span save/restore stays consistent."""
        # NOTE: previously declared `val stmt_kind: HirStmtKind` / `val
        # stmt_span: Span` without an initializer and assigned them inside
        # the `case HirStmt(kind, span):` arm below, then matched on
        # stmt_kind in a SECOND, separate match statement. That pattern was
        # found to be broken in the interpreter: stmt_kind ends up bound to
        # an unresolved placeholder that matches no real HirStmtKind
        # pattern, so every statement silently fell through to the
        # catch-all no-op arm (confirmed by isolated repro -- see
        # doc/08_tracking/bug/vhdl_backend_spec_remaining_failures_2026-07-02.md).
        # Fixed by nesting the stmt_kind match directly inside the
        # HirStmt(kind, span) arm instead of round-tripping through
        # pre-declared, later-assigned `val`s.
        match stmt:
            case _:
                val span: Span = stmt.span
                val stmt_kind_value: HirStmtKind = stmt.kind
                val fallback_type = HirType(kind: HirTypeKind.Unit, span: Span.empty())
                val fallback_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: fallback_type, span: span)
                val let_disc = mir_hir_stmt_kind_disc(HirStmtKind.Let(SymbolId(id: -1), fallback_type, fallback_expr))
                if mir_hir_stmt_kind_disc(stmt_kind_value) == let_disc:
                    val let_symbol = match stmt_kind_value:
                        case HirStmtKind.Let(symbol, _, _):
                            if symbol != nil:
                                Some(symbol)
                            else:
                                nil
                        case _:
                            nil
                    val let_type = match stmt_kind_value:
                        case HirStmtKind.Let(_, type_, _):
                            type_
                        case _:
                            nil
                    val let_init = match stmt_kind_value:
                        case HirStmtKind.Let(_, _, init):
                            init
                        case _:
                            fallback_expr

                    if let_symbol.?:
                        val symbol_value = let_symbol ?? SymbolId(id: -1)
                        val symbol_value_id = mir_stmt_symbol_id_value(symbol_value)
                        if symbol_value_id < 0:
                            self.error("let binding has no resolved symbol", Some(span))
                            return
                        # `val f = \x: ...` -- keep the existing bind-time
                        # capture snapshot, and materialize non-capturing lambdas
                        # through the same lifted FuncPtr used for lambda args.
                        val is_lambda_bind = match let_init.kind:
                            case Lambda(_, _, _):
                                true
                            case _:
                                false
                        if is_lambda_bind:
                            self.lambda_bindings[symbol_value_id] = let_init
                            # By-value capture (match oracle semantics): freeze
                            # each free variable's CURRENT value into a new temp
                            # local NOW, at bind time (see
                            # snapshot_lambda_capture in switch_operators_calls.spl),
                            # so a later mutation of a captured outer `var` (which
                            # this pipeline's MIR mutates in place, not via SSA
                            # renaming) does not leak into calls of this lambda.
                            self.lambda_capture_snapshot[symbol_value_id] = self.snapshot_lambda_capture(let_init)
                            val lambda_operand = self.lower_lambda_value(let_init)
                            if val lifted_lambda = lambda_operand:
                                match lifted_lambda.kind:
                                    case Const(_, lambda_type):
                                        var lambda_builder = self.builder
                                        val lambda_local = lambda_builder.emit_cast(lifted_lambda, lambda_type)
                                        self.builder = lambda_builder
                                        self.bind_local(symbol_value_id, lambda_local)
                                    case Copy(lambda_local) | Move(lambda_local):
                                        self.bind_local(symbol_value_id, lambda_local)
                                    case _:
                                        pass
                            return
                        val mir_type = match let_type:
                            case Some(type_value):
                                match type_value.kind:
                                    case HirTypeKind.Infer(_, _): MirType.i64()
                                    case _: self.lower_type(type_value)
                            case nil:
                                MirType.i64()

                        var init_local = self.lower_expr(let_init)
                        match let_type:
                            case Some(declared_type):
                                # The staged native lane can preserve the
                                # optional discriminant while dropping its
                                # struct payload after an earlier match of the
                                # same flat optional. Never read `.kind` until
                                # the payload itself is proven non-nil.
                                if declared_type != nil:
                                    match declared_type.kind:
                                        case HirTypeKind.Optional(_):
                                            init_local = self.ensure_option_handle(init_local, declared_type)
                                        case _:
                                            ()
                            case nil:
                                ()
                        val annotated_narrow_int = match mir_type.kind:
                            case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.I16 | MirTypeKind.U16 | MirTypeKind.I32 | MirTypeKind.U32: true
                            case _: false
                        val annotated_float = match mir_type.kind:
                            case MirTypeKind.F32 | MirTypeKind.F64: true
                            case _: false
                        if let_type != nil and (annotated_narrow_int or annotated_float):
                            var cast_builder = self.builder
                            init_local = cast_builder.emit_cast(mir_operand_copy(init_local), mir_type)
                            self.builder = cast_builder
                        val init_local_id = mir_stmt_local_id_value(init_local)
                        if init_local_id < 0:
                            self.error("let initializer produced no local", Some(span))
                            return
                        # Without an explicit annotation (`var xs = [...]`),
                        # mir_type defaulted to i64, so `xs` lost the array type
                        # and later `xs[i]` reads took the wrong raw-GEP path
                        # (local_is_runtime_array checks THIS binding's MIR kind).
                        # Thread the initializer's real Array/Slice type onto the
                        # binding instead. Copy is unchanged (a runtime array is a
                        # pointer; translate_copy_move keys off the source local),
                        # so value semantics are preserved -- only the read-path
                        # decision is corrected.
                        # Same preservation for a string binding (`val c = a + b`):
                        # a `+` concat produces a string temp (Opaque str) but the
                        # binding's HIR type is nil / a non-string arithmetic type,
                        # so mir_type defaulted to i64 and `c` lost its string type
                        # -- a later `c.len` then took the struct get_field path
                        # (reading the first byte / nil-deref -> SIGSEGV) instead
                        # of rt_strlen. When the initializer is a real string
                        # value, thread its string MIR type onto the binding
                        # regardless of the (unreliable) inferred let_type.
                        # Same preservation for float and Bool bindings
                        # (`val y = x * 4.0`, `val flag = flags[0]`):
                        # the inferred let_type is unreliably non-nil (i64) on this
                        # path, so mir_type defaulted to i64, the binding's SSA
                        # spill slot was alloca'd i64, and the f64 value
                        # round-tripped through fptosi/store i64 (10.0 -> 10),
                        # degrading later comparisons to icmp on truncated ints.
                        # When the initializer is a real float value, thread its
                        # F64/F32 MIR type onto the binding (same rationale as the
                        # string case above). Bool must likewise remain Bool so
                        # text interpolation selects the boolean formatter.
                        #
                        # Bug #138: the array case above was gated on
                        # `let_type == nil`, unlike its str/float siblings just
                        # below (which thread unconditionally) -- but
                        # `val all_args = get_cli_args()` (a call returning
                        # `[text]`) gets a non-nil-but-wrong synthesized
                        # `let_type` (the HirTypeKind.Infer -> i64 default noted
                        # throughout this file), same as the str/float cases'
                        # "unreliably non-nil" HIR type. That left `all_args`
                        # bound as plain i64, so `all_args[i]` took the raw-GEP
                        # path instead of rt_array_get -- reading raw bytes off
                        # the SplArray header as if they were an element, then
                        # feeding that garbage i64 to rt_len/rt_string_starts_with
                        # as a tagged handle (SIGSEGV). Thread unconditionally,
                        # matching str/float/bool.
                        val init_mir_type = self.local_mir_type_of(init_local)
                        var init_mir_type_value = mir_type
                        var vulkan_u32_initializer = false
                        if self.current_gpu_kernel_target == "vulkan":
                            if val found_init_mir_type = init_mir_type:
                                if found_init_mir_type != nil:
                                    init_mir_type_value = found_init_mir_type
                                    match found_init_mir_type.kind:
                                        case MirTypeKind.U32:
                                            vulkan_u32_initializer = true
                                        case _:
                                            ()
                        val effective_type = if vulkan_u32_initializer:
                            init_mir_type_value
                        else if self.local_is_runtime_array(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if self.local_is_runtime_dict(init_local):
                            # Bug #189 (native struct-valued Dict access
                            # SIGSEGV): an empty dict literal (`{}`) has no
                            # entries to infer key/value types from, so
                            # lower_dict_lit (method_calls_literals.spl)
                            # defaults BOTH to plain i64 -- discarding the
                            # real value type (e.g. Struct(S) for `Dict<text,
                            # S>`, or `text` for the key). Blindly trusting
                            # the initializer's inferred type here (as the
                            # array/str/float/bool siblings do, where an
                            # untyped initializer's OWN type is still the
                            # best info available) then poisoned every later
                            # read of this binding: `local_mir_type_of`
                            # reported Dict(I64,I64), so expr_dispatch.spl's
                            # dict-index-read applied `decode_runtime_value`'s
                            # boxed-INTEGER `raw >> 3` decode to a real heap
                            # struct pointer from `rt_dict_get` (mangling the
                            # address -> SIGSEGV on the next `.field` GEP/
                            # load), and `.keys()`/`.values()`
                            # (method_calls_literals.spl) misdecoded text
                            # keys as garbage ints the same way. When an
                            # explicit `var x: Dict<K, V> = ...` annotation is
                            # present and resolves to a Dict, it is always at
                            # least as informative as the initializer (Simple
                            # requires the annotation to type an empty `{}`
                            # literal in the first place) -- prefer it over
                            # the initializer's inferred type in that case.
                            val annotated_is_dict = match mir_type.kind:
                                case MirTypeKind.Dict(_, _): true
                                case _: false
                            if let_type != nil and annotated_is_dict:
                                mir_type
                            else:
                                self.local_mir_type_of(init_local) ?? mir_type
                        else if self.local_is_str(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if self.local_is_float(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if self.local_is_bool(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else:
                            mir_type
                        val bf_sym = self.bitfield_value_syms.get(init_local_id)
                        # Struct values are pointer-represented; alias the binding
                        # straight to the constructed local (like the bitfield
                        # pass-through) so struct_value_syms (keyed by that local's
                        # .id) stays valid for a later `p.x` field read. Bug #177:
                        # that alias is only safe when `init_local` is a FRESH
                        # aggregate -- when the initializer is a PLACE read of an
                        # existing struct binding (`var b = a`, `var inner =
                        # outer.child`), maybe_copy_struct_value materializes a
                        # private per-binding copy instead (skipped for classes,
                        # which keep reference semantics).
                        # TODO(LANE ISO1, mir_lowering_stmts.spl:600): an iso-typed
                        # `struct` (not class) binding takes this
                        # maybe_copy_struct_value path and is NOT wired to
                        # emit_move -- it still emits emit_copy inside that
                        # helper. Binding-transfer for class/primitive iso
                        # types is covered below (mir_hir_type_is_isolated +
                        # emit_move at the new_local+emit_copy fallback); iso
                        # structs are scoped out of this lane per the "cover
                        # binding-transfer only" guardrail.
                        val struct_sym = self.struct_value_syms.get(init_local.id)
                        # A dynamic FacetRef is affine. Keep the acquired lease
                        # handle as the binding itself instead of emitting the
                        # ordinary value-copy path, preserving its adapter plan.
                        if self.find_facet_adapter(init_local).?:
                            self.bind_local(symbol_value_id, init_local)
                            return
                        val struct_copy = self.maybe_copy_struct_value(init_local, struct_sym, mir_expr_kind_is_place(let_init.kind))
                        if val copy_local = struct_copy:
                            self.bind_local(symbol_value_id, copy_local)
                        elif bf_sym != nil or struct_sym != nil:
                            self.bind_local(symbol_value_id, init_local)
                        else:
                            # Bug #186: array-typed place-read local-alias fix
                            # (maybe_copy_array_value, sibling to #177's struct
                            # fix above) -- fires only for a PLACE read of an
                            # EXISTING runtime-array binding; a fresh array
                            # literal/call-result initializer falls through to
                            # the unchanged new_local+emit_copy path below.
                            val array_copy = self.maybe_copy_array_value(init_local, effective_type, mir_expr_kind_is_place(let_init.kind))
                            if val array_copy_local = array_copy:
                                self.bind_local(symbol_value_id, array_copy_local)
                            else:
                                var b = self.builder
                                val local = b.new_local(nil, effective_type, LocalKind.Var)
                                self.builder = b
                                self.bind_local(symbol_value_id, local)
                                if self.runtime_array_locals.contains(init_local.id):
                                    self.runtime_array_locals[local.id] = true
                                if self.runtime_dict_locals.contains(init_local.id):
                                    self.runtime_dict_locals[local.id] = true
                                if self.is_runtime_value_local(init_local.id):
                                    self.mark_runtime_value_local(local.id)
                                if self.option_value_locals.contains(init_local.id):
                                    self.option_value_locals[local.id] = true
                                if self.nil_locals.contains(init_local.id):
                                    self.nil_locals[local.id] = true
                                val found_init_hir_type = self.find_local_hir_type(init_local.id)
                                if found_init_hir_type.?:
                                    val init_hir_type = found_init_hir_type ?? HirType(kind: HirTypeKind.Error, span: span)
                                    self.remember_local_hir_type(local.id, init_hir_type)
                                else:
                                    match let_type:
                                        case Some(declared_type):
                                            self.remember_local_hir_type(local.id, declared_type)
                                        case nil:
                                            ()
                                # Bug (array-of-structs field misread), CONFLICT-FLAG
                                # (mir_lowering_stmts.spl is fenced, touched per the
                                # fence rule's "CONFLICT-FLAG if must touch"
                                # allowance): array_element_struct_syms (see
                                # lower_array_lit / expr_dispatch.spl's Index case)
                                # must propagate the SAME way runtime_array_locals
                                # does above -- otherwise `val pts = [Point(...),
                                # ...]` rebinds the array literal's result to a NEW
                                # local id that has no entry in
                                # array_element_struct_syms, silently losing the
                                # element struct name and reverting `pts[i].y` to
                                # the field-index-0 misread this fix exists to stop.
                                val ael_sym = self.array_element_struct_syms.get(init_local.id)
                                if ael_sym != nil:
                                    val ael_name = ael_sym ?? ""
                                    if ael_name != "":
                                        self.array_element_struct_syms[local.id] = ael_name
                                var b2 = self.builder
                                # LANE ISO1 (2026-07-29): the genuine move site
                                # named in MirBuilder.emit_move's docstring --
                                # a PLACE read (plain variable/field/index, not
                                # a fresh construction) of an iso-typed source
                                # is a real transfer, not a copy. Emitting Move
                                # here feeds the NLL checker's already-real
                                # Move handling (55.borrow) so iso use-after-
                                # move is reported; non-iso code is unaffected
                                # (mir_hir_type_is_isolated is false for every
                                # pre-existing HirTypeKind).
                                if mir_expr_kind_is_place(let_init.kind) and mir_hir_type_is_isolated(found_init_hir_type):
                                    b2.emit_move(local, init_local)
                                else:
                                    b2.emit_copy(local, init_local)
                                self.builder = b2
                    else:
                        self.error("let binding has no resolved symbol", Some(span))
                    return

                val expr_disc = mir_hir_stmt_kind_disc(HirStmtKind.Expr(fallback_expr))
                if mir_hir_stmt_kind_disc(stmt_kind_value) == expr_disc:
                    # The native worker can misbind this first-variant payload
                    # in a qualified match even after exact discriminator
                    # dispatch. Read the already-validated enum payload
                    # directly and reject a malformed producer loudly.
                    val expr: HirExpr = rt_enum_payload(stmt_kind_value)
                    if expr == nil:
                        self.error("empty HIR expression-statement payload", Some(span))
                        return
                    self.lower_expr(expr)
                    return

                match stmt_kind_value:
                    case HirStmtKind.Expr(extracted_expr):
                        val expr: HirExpr = extracted_expr
                        self.lower_expr(expr)

                    case Let(symbol, type_, init):
                        val symbol_id = mir_stmt_symbol_id_value(symbol)
                        if symbol_id < 0:
                            self.error("let binding has no resolved symbol", Some(span))
                            return
                        # NOTE: avoid Option.map()/.unwrap() and `if val ...`
                        # here -- the seed interpreter mishandles both on a
                        # "present" struct optional. `type_` is nil for any
                        # `val x = ...` without an explicit type annotation;
                        # the direct match keeps that nil from reaching
                        # lower_type and tripping a `.kind` read on nil.
                        val mir_type = match type_:
                            case Some(type_value):
                                match type_value.kind:
                                    case HirTypeKind.Infer(_, _): MirType.i64()
                                    case _: self.lower_type(type_value)
                            case nil:
                                MirType.i64()

                        # Lower the initializer first so a bitfield-construct
                        # pass-through can be aliased directly, without first
                        # materializing an intermediate I64 local.
                        var has_init = false
                        var init_local = LocalId(id: 0)
                        var init_is_place = false
                        if val init_expr = init:
                            init_local = self.lower_expr(init_expr)
                            has_init = true
                            init_is_place = mir_expr_kind_is_place(init_expr.kind)

                        # Bitfield construction (`val inst = BitfieldType(raw)`)
                        # is a bit-identical identity pass-through: alias the
                        # binding straight to the source local instead of
                        # emitting a fresh I64 temp + Copy, so downstream slices
                        # read the source signal directly (imem_rdata(6 downto 0),
                        # not sig_N(6 downto 0)). bitfield_value_syms is only
                        # populated for real bitfield types, so non-bitfield
                        # code always takes the ordinary new_local + Copy path.
                        # `i64?`/`text?` are shared (Option/heap) types, so the
                        # W1003 mut-capability checker forbids reassigning a `var`
                        # of these types. Compute the initializer's local id once
                        # into a plain-i64 var (not a shared type, so a var-i64
                        # reassignment is allowed) and then bind bf_sym/struct_sym
                        # exactly once as `val`.
                        var init_local_id: i64 = -1
                        if has_init:
                            init_local_id = mir_stmt_local_id_value(init_local)
                            if init_local_id < 0:
                                self.error("let initializer produced no local", Some(span))
                                return
                        val bf_sym: i64? = if has_init: self.bitfield_value_syms.get(init_local_id) else: nil
                        # Struct values are pointer-represented; aliasing the
                        # binding straight to the constructed local (like the
                        # bitfield pass-through) keeps struct_value_syms (keyed
                        # by the constructed local's .id) valid so a later
                        # `p.x` field read can recover the field ordering.
                        # Key on init_local.id directly to match how
                        # lower_struct_construct writes the map.
                        val struct_sym: text? = if has_init: self.struct_value_syms.get(init_local.id) else: nil
                        # See the disc==1 early-Let path: a `val`/`var xs = ...`
                        # must inherit the initializer's real Array/Slice/Bool type
                        # (unconditionally -- a non-nil-but-Infer-defaulted
                        # `type_` is as unreliable as a nil one, see Bug #138)
                        # so later `xs[i]` reads take rt_array_get instead of a
                        # raw GEP. (This arm is dead for Let today -- disc==1
                        # handles it above -- but kept in sync so the two paths
                        # cannot silently diverge.)
                        val effective_type = if has_init and self.local_is_runtime_array(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if has_init and self.local_is_runtime_dict(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if has_init and self.local_is_float(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else if has_init and self.local_is_bool(init_local):
                            self.local_mir_type_of(init_local) ?? mir_type
                        else:
                            mir_type
                        # Bug #177: same struct-value-copy guard as the disc==1
                        # early-Let path above -- kept in sync (this arm is dead
                        # today, see the comment above effective_type).
                        val struct_copy2 = self.maybe_copy_struct_value(init_local, struct_sym, init_is_place)
                        if has_init and self.find_facet_adapter(init_local).?:
                            self.bind_local(symbol_id, init_local)
                            return
                        if val copy_local2 = struct_copy2:
                            self.bind_local(symbol_id, copy_local2)
                        elif bf_sym != nil or struct_sym != nil:
                            self.bind_local(symbol_id, init_local)
                        else:
                            # Bug #186: same array-value-copy guard as the
                            # disc==1 early-Let path above -- kept in sync
                            # (this arm is dead today, see the comment above
                            # effective_type).
                            val array_copy2 = if has_init: self.maybe_copy_array_value(init_local, effective_type, init_is_place) else: nil
                            if val array_copy2_local = array_copy2:
                                self.bind_local(symbol_id, array_copy2_local)
                            else:
                                var b = self.builder
                                val local = b.new_local(nil, effective_type, LocalKind.Var)
                                self.builder = b
                                self.bind_local(symbol_id, local)
                                if has_init and self.runtime_array_locals.contains(init_local.id):
                                    self.runtime_array_locals[local.id] = true
                                if has_init and self.runtime_dict_locals.contains(init_local.id):
                                    self.runtime_dict_locals[local.id] = true
                                if has_init and self.is_runtime_value_local(init_local.id):
                                    self.mark_runtime_value_local(local.id)
                                if has_init and self.nil_locals.contains(init_local.id):
                                    self.nil_locals[local.id] = true
                                if has_init:
                                    val found_init_hir_type = self.find_local_hir_type(init_local.id)
                                    if found_init_hir_type.?:
                                        val init_hir_type = found_init_hir_type ?? HirType(kind: HirTypeKind.Error, span: span)
                                        self.remember_local_hir_type(local.id, init_hir_type)
                                    else:
                                        match type_:
                                            case Some(declared_type):
                                                self.remember_local_hir_type(local.id, declared_type)
                                            case nil:
                                                ()
                                # Bug (array-of-structs field misread), CONFLICT-FLAG
                                # (mir_lowering_stmts.spl is fenced): mirror the same
                                # array_element_struct_syms propagation as the other
                                # Let-lowering arm above, so `val pts = [Point(...),
                                # ...]` (this Let path) doesn't lose the element
                                # struct name when it rebinds to a fresh local id.
                                if has_init:
                                    val ael_sym2 = self.array_element_struct_syms.get(init_local.id)
                                    if ael_sym2 != nil:
                                        val ael_name2 = ael_sym2 ?? ""
                                        if ael_name2 != "":
                                            self.array_element_struct_syms[local.id] = ael_name2
                                if has_init:
                                    var b2 = self.builder
                                    b2.emit_copy(local, init_local)
                                    self.builder = b2

                    case Assign(target, op, value):
                        val value_local = self.lower_expr(value)
                        self.lower_assign(target, op, value_local)

                    case Block(block):
                        self.lower_block(block)

                    case AsmAssert(spec):
                        self.lower_asm_assert(spec, span)

                    case _:
                        ()

    me lower_assign_var(symbol_id: i64, op: HirAssignOp?, value_local: LocalId, span: Span):
        """Emit the write-back for an assignment to a local variable target
        (shared by the `Var` and `NamedVar` lvalue cases)."""
        if symbol_id < 0:
            self.error_fatal("assignment target has no resolved symbol", Some(span))
        elif self.global_symbol_ids.contains(symbol_id) and self.find_global_static(symbol_id).?:
            # mutglobal2 lane (module-level `var` mutation end-to-end, see
            # scratchpad/mutglobal_plan.md + scratchpad/mutglobal2 report):
            # `g = ...` / `g += ...` where `g` is a module-level `var`
            # (registered by function_lowering.spl's `lower_const`, BEFORE
            # any function body is lowered) has no per-function SSA local at
            # all -- write through the backend's real `@g_name` global
            # storage via `StoreGlobal` instead of the local_map's
            # emit_copy/alloca path below. Checked BEFORE `local_map` on
            # purpose: a module-level `var` is deliberately never also
            # inserted into `local_map` (see the read hook in
            # expr_dispatch.spl), so the two branches are mutually exclusive
            # for any given symbol_id; order here is not load-bearing today,
            # only documents that a global write must never fall through to
            # the per-function-local path.
            #
            # `elif val x = opt:` is NOT used here on purpose: this exact
            # pattern regressed the smoke matrix's `while_sum`/`for_in_array`
            # cases (2 failures, "undefined field 'symbol': cannot access
            # field on value of type 'nil'") -- an ordinary LOCAL loop
            # counter's `symbol_id` makes `find_global_static` return a bare
            # `nil` (not a real module global), but the seed interpreter's
            # `if val <pat> = <optional>`/`elif val` presence check can still
            # enter the "true" branch with the bound value nil (the same
            # documented quirk as the `op.?`/`if val assign_op = op` note
            # just below, and Bug native_i64opt_some0_collapses_to_nil's
            # class of issue) -- `global_static.symbol` on that nil then
            # crashed. The explicit `.has(...)`/`.? ` + `.unwrap()` sequence
            # below never touches that unsafe pattern.
            val global_static = self.find_global_static(symbol_id).unwrap()
            if not global_static.is_mutable:
                self.error_fatal("cannot assign to immutable module global", Some(span))
                return
            val global_symbol = global_static.symbol
            val g_type = global_static.type_
            if op.?:
                # Compound assignment (g += y etc.): load current value,
                # combine, store back -- mirrors the local_map compound-
                # assign arm below, but through Load/StoreGlobal.
                val assign_op = op.unwrap()
                var b_cur = self.builder
                val cur_local = b_cur.new_temp(g_type)
                b_cur.emit(MirInst(kind: MirInstKind.LoadGlobal(cur_local, global_symbol), span: Some(span)))
                self.builder = b_cur
                val current = mir_operand_copy(cur_local)
                val new_val = mir_operand_copy(value_local)
                val mir_op = self.lower_assign_op(assign_op)
                var b_op = self.builder
                val result = b_op.emit_binop(mir_op, current, new_val, g_type)
                b_op.emit(MirInst(kind: MirInstKind.StoreGlobal(global_symbol, mir_operand_copy(result)), span: Some(span)))
                self.builder = b_op
            else:
                var b_store = self.builder
                b_store.emit(MirInst(kind: MirInstKind.StoreGlobal(global_symbol, mir_operand_copy(value_local)), span: Some(span)))
                self.builder = b_store
        else:
            val local = self.find_local(symbol_id)
            if local.id < 0:
                self.error_fatal("assignment target has no local binding", Some(span))
                return
            # Use the positive `op.?` presence test, NOT `if val assign_op = op`:
            # the seed interpreter's `if val <pat> = <optional>` presence check
            # can wrongly enter the true branch when the optional is nil (the
            # documented `if val`/`if not x.?` quirk), which turned a plain
            # `x = x + 1` (op == nil) into a spurious compound `x + (x + 1)`.
            if op.?:
                # Compound assignment (x += y etc.)
                val assign_op = op.unwrap()
                val current = mir_operand_copy(local)
                val new_val = mir_operand_copy(value_local)
                val mir_op = self.lower_assign_op(assign_op)
                var b = self.builder
                val result = b.emit_binop(mir_op, current, new_val, MirType.i64())
                b.emit_copy(local, result)
                self.builder = b
                self.unmark_runtime_value_local(local.id)
                self.option_value_locals = self.option_value_locals.remove(local.id)
                self.nil_locals = self.nil_locals.remove(local.id)
                self.runtime_array_locals = self.runtime_array_locals.remove(local.id)
                self.runtime_dict_locals = self.runtime_dict_locals.remove(local.id)
                self.forget_local_hir_type(local.id)
            else:
                var assigned_value = value_local
                val found_declared_type = self.find_local_hir_type(local.id)
                if found_declared_type.?:
                    val declared_type = found_declared_type ?? HirType(kind: HirTypeKind.Error, span: span)
                    match declared_type.kind:
                        case HirTypeKind.Optional(_):
                            assigned_value = self.ensure_option_handle(value_local, declared_type)
                        case _:
                            ()
                var b = self.builder
                b.emit_copy(local, assigned_value)
                self.builder = b
                if self.is_runtime_value_local(assigned_value.id):
                    self.mark_runtime_value_local(local.id)
                else:
                    self.unmark_runtime_value_local(local.id)
                if self.option_value_locals.contains(assigned_value.id):
                    self.option_value_locals[local.id] = true
                else:
                    self.option_value_locals = self.option_value_locals.remove(local.id)
                if self.runtime_array_locals.contains(assigned_value.id):
                    self.runtime_array_locals[local.id] = true
                else:
                    self.runtime_array_locals = self.runtime_array_locals.remove(local.id)
                if self.runtime_dict_locals.contains(assigned_value.id):
                    self.runtime_dict_locals[local.id] = true
                else:
                    self.runtime_dict_locals = self.runtime_dict_locals.remove(local.id)
                if self.nil_locals.contains(assigned_value.id):
                    self.nil_locals[local.id] = true
                else:
                    self.nil_locals = self.nil_locals.remove(local.id)
                val found_assigned_hir_type = self.find_local_hir_type(assigned_value.id)
                if found_assigned_hir_type.?:
                    val assigned_hir_type = found_assigned_hir_type ?? HirType(kind: HirTypeKind.Error, span: span)
                    self.remember_local_hir_type(local.id, assigned_hir_type)
                else:
                    self.forget_local_hir_type(local.id)
                # Bug (array-of-structs field misread), CONFLICT-FLAG
                # (mir_lowering_stmts.spl is fenced): a `var`-reassignment
                # (`pts = pts.push(...)`, etc.) must carry
                # array_element_struct_syms forward the same way
                # runtime_array_locals does above, or a reassigned
                # array-of-structs variable loses its element struct name.
                if self.array_element_struct_syms.contains(assigned_value.id):
                    self.array_element_struct_syms[local.id] = self.array_element_struct_syms[assigned_value.id]
                else:
                    self.array_element_struct_syms = self.array_element_struct_syms.remove(local.id)

    me lower_assign(target: HirExpr, op: HirAssignOp?, value_local: LocalId):
        """Lower assignment."""
        match target.kind:
            case Var(symbol):
                self.lower_assign_var(mir_stmt_symbol_id_value(symbol), op, value_local, target.span)

            case NamedVar(symbol, name):
                # HIR lowering emits NamedVar(symbol, name) for every resolved
                # identifier (see expr_dispatch `case NamedVar`). The assignment
                # lvalue path only handled the name-less Var(symbol) variant, so
                # `x = ...` where the target is a NamedVar fell through to the
                # catch-all and the write-back Copy was silently dropped --
                # loop-carried updates (`i = i + 1`) were lost, producing
                # non-terminating loops on the native path. Mirror the Var arm.
                self.lower_assign_var(mir_stmt_symbol_id_value(symbol), op, value_local, target.span)

            case Field(base, field, resolved):
                # Field assignment: obj.field = value
                #
                # Bug jit_struct_field_compound_assign_loads_zero (2026-07-27):
                # this arm used to ignore `op` entirely and hand the bare RHS
                # local to emit_set_field, so `obj.f += v` stored `v` -- the
                # field's CURRENT value never entered the computation and the
                # observable result was `0 <op> v` on the JIT/native path
                # (`s.n += 2` with n == 5 printed 2, not 7). The read side is
                # restored below and it deliberately reuses the SAME already-
                # lowered `receiver` and the SAME `field_index` the store uses:
                # the place is resolved exactly once, so a receiver expression
                # with side effects still runs exactly once.
                val receiver = self.lower_expr(base)
                var rhs_value = value_local
                # Bitfield-ness is probed with the pure predicate pair (no MIR
                # emitted) so the compound read can be routed to the packed
                # get/set helpers instead of a raw GetField on a packed word.
                val bitfield_sym = self.bitfield_type_sym_for(base, receiver)
                val is_bitfield = bitfield_sym >= 0 and self.bitfield_map.contains(bitfield_sym)
                if op.? and is_bitfield:
                    val bf_current = self.try_lower_bitfield_get(base, receiver, field)
                    if val bf_current_local = bf_current:
                        val bf_type = self.local_mir_type_of(bf_current_local) ?? MirType.i64()
                        rhs_value = self.lower_compound_combine(bf_current_local, op.unwrap(), value_local, bf_type)
                val bitfield_value = self.try_lower_bitfield_set(base, receiver, field, rhs_value)
                if val bitfield_local = bitfield_value:
                    var bitfield_b = self.builder
                    bitfield_b.emit_copy(receiver, bitfield_local)
                    self.builder = bitfield_b
                    return
                val field_index = self.resolve_field_index(base, receiver, field, resolved)
                if op.? and not is_bitfield:
                    # Read-modify-write through the same (receiver, field_index)
                    # place the emit_set_field below writes to.
                    val current_type = self.compound_field_mir_type(base, receiver, field_index, value_local)
                    var b_load = self.builder
                    val current_local = b_load.emit_get_field(mir_operand_copy(receiver), field_index, current_type)
                    self.builder = b_load
                    rhs_value = self.lower_compound_combine(current_local, op.unwrap(), value_local, current_type)
                var assigned_field_value = rhs_value
                val field_owner = self.resolve_base_struct_name(base, receiver)
                if val owner_name = field_owner:
                    if self.struct_field_hir_type.contains(owner_name):
                        val field_types = self.struct_field_hir_type[owner_name]
                        if field_index >= 0 and field_index < field_types.len():
                            val declared_field_type = field_types[field_index]
                            match declared_field_type.kind:
                                case HirTypeKind.Optional(_):
                                    assigned_field_value = self.ensure_option_handle(rhs_value, declared_field_type)
                                case _:
                                    ()
                var b = self.builder
                b.emit_set_field(mir_operand_copy(receiver), field_index, mir_operand_copy(assigned_field_value))
                self.builder = b

            case Index(base, index):
                # Index assignment: arr[i] = value
                # Lower to runtime call: rt_array_set(arr, index, value)
                val receiver = self.lower_expr(base)
                # Dict handles insert via rt_dict_set with a tagged key, NOT the
                # raw rt_array_set/GEP path below (which treats the string key as
                # an element offset). Mirrors the dict getter in expr_dispatch.
                if self.local_is_runtime_dict(receiver):
                    # `d[k]` is lowered ONCE and reused by both the compound
                    # read and the write, so a side-effecting key expression
                    # runs exactly once (same rule as the array arm below).
                    val dict_key = self.lower_dict_key(index)
                    var dict_value = value_local
                    if op.?:
                        # Bug jit_struct_field_compound_assign_loads_zero: the
                        # read side was missing here too, so `d[k] += v` stored
                        # `v`. rt_dict_get is the exact inverse of the
                        # rt_dict_set below (same handle, same tagged key), and
                        # decode_runtime_value is the inverse of the
                        # box_runtime_value applied to the stored operand.
                        val dict_elem_type = self.compound_elem_mir_type(base, receiver, value_local)
                        val dict_get_op = MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str("rt_dict_get"),
                            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
                        ))
                        var b_dget = self.builder
                        val dict_get_res = b_dget.emit_call(dict_get_op, [mir_operand_copy(receiver), mir_operand_copy(dict_key)], MirType.i64())
                        self.builder = b_dget
                        if val dict_raw = dict_get_res:
                            val dict_current = self.decode_runtime_value(dict_raw, dict_elem_type)
                            dict_value = self.lower_compound_combine(dict_current, op.unwrap(), value_local, dict_elem_type)
                    self.note_container_elem_type(receiver, dict_value)
                    val boxed_value = self.box_runtime_value(dict_value)
                    val dict_set_op = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_dict_set"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64(), MirType.i64(), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_dset = self.builder
                    b_dset.emit_call(dict_set_op, [mir_operand_copy(receiver), mir_operand_copy(dict_key), mir_operand_copy(boxed_value)], MirType.i64())
                    self.builder = b_dset
                    return
                var index_local = self.lower_expr(index)
                if self.current_gpu_kernel_target == "vulkan" or self.current_gpu_kernel_target == "cuda":
                    if val receiver_type = self.local_mir_type_of(receiver):
                        match receiver_type.kind:
                            case MirTypeKind.Ptr(element_type, mutable) | MirTypeKind.Ref(element_type, mutable):
                                if not mutable:
                                    val message = if self.current_gpu_kernel_target == "vulkan":
                                        "cannot write through an immutable Vulkan storage buffer"
                                    else:
                                        "cannot write through an immutable CUDA global buffer"
                                    self.error_fatal(message, Some(target.span))
                                    return
                                var raw_value = value_local
                                if self.current_gpu_kernel_target == "vulkan":
                                    index_local = self.vulkan_u32_local(index_local)
                                    raw_value = self.vulkan_u32_local(value_local)
                                var b_raw = self.builder
                                val raw_ptr = b_raw.emit_gep(
                                    mir_operand_copy(receiver),
                                    [mir_operand_copy(index_local)],
                                    MirType.ptr(element_type, mutable)
                                )
                                if op.?:
                                    val current = b_raw.emit_load(mir_operand_copy(raw_ptr), element_type)
                                    self.builder = b_raw
                                    raw_value = self.lower_compound_combine(current, op.unwrap(), raw_value, element_type)
                                    b_raw = self.builder
                                b_raw.emit_store(mir_operand_copy(raw_ptr), mir_operand_copy(raw_value))
                                self.builder = b_raw
                                return
                            case _:
                                ()
                self.emit_bounds_check_for_index(base.type_, receiver, index_local)
                var elem_value = value_local
                if op.?:
                    # Bug jit_struct_field_compound_assign_loads_zero: `arr[i]
                    # += v` stored `v` (probe: [1,2,3] then `arr[1] += 10`
                    # printed 10, not 12). rt_array_get is the exact inverse of
                    # the rt_array_set emitted below, and `index_local` /
                    # `receiver` are the SAME locals the store uses -- the index
                    # subexpression is lowered once, never twice.
                    #
                    # Arrays stay value types: this only restores the READ of
                    # the element, it does not alias or share the backing
                    # buffer, and the write below is the unchanged rt_array_set.
                    val elem_type = self.compound_elem_mir_type(base, receiver, value_local)
                    val array_get_op = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_array_get"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.ptr(elem_type, false), MirType.i64()], return_type: MirType.i64(), is_variadic: false)))
                    ))
                    var b_aget = self.builder
                    val array_get_res = b_aget.emit_call(array_get_op, [mir_operand_copy(receiver), mir_operand_copy(index_local)], MirType.i64())
                    self.builder = b_aget
                    if val array_raw = array_get_res:
                        val elem_current = self.decode_runtime_value(array_raw, elem_type)
                        elem_value = self.lower_compound_combine(elem_current, op.unwrap(), value_local, elem_type)
                self.note_container_elem_type(receiver, elem_value)
                val boxed_value = self.box_runtime_value(elem_value)

                # Create function operand for rt_array_set(ptr, i64, i64) -> void.
                # Mirror the rt_array_get callee shape (see expr_dispatch.spl
                # `case Index` getter): the callee MUST name the runtime symbol
                # via MirConstValue.Str, not the integer 0, or the store no-ops.
                val func_operand = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_array_set"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.ptr(MirType.i64(), false), MirType.i64(), MirType.i64()], return_type: MirType.unit(), is_variadic: false)))
                ))

                # Emit call with no return value
                self.builder.emit_call(func_operand, [mir_operand_copy(receiver), mir_operand_copy(index_local), mir_operand_copy(boxed_value)], MirType.unit())

            case _:
                self.error_fatal("unsupported MIR assignment target: {target.kind}", nil)

    me lower_receiver_and_args(receiver: HirExpr, args: [HirCallArg]) -> [MirOperand]:
        """Lower receiver and arguments for method calls."""
        val receiver_local = self.lower_expr(receiver)
        # Keep the implicit receiver insertion as an explicit push. The
        # self-hosted Stage 3 compiler has miscompiled the one-element generic
        # array literal above for zero-explicit-argument calls, leaving an
        # empty MIR argument vector. The native call then reuses the previous
        # return register as `self` (cross-architecture receiver loss).
        var arg_operands: [MirOperand] = []
        arg_operands = arg_operands.push(mir_operand_copy(receiver_local))
        for arg in args:
            val arg_local = self.lower_expr(arg.value)
            arg_operands = arg_operands.push(mir_operand_copy(arg_local))
        arg_operands

    me lower_compound_combine(current: LocalId, op: HirAssignOp, rhs: LocalId, type_: MirType) -> LocalId:
        """Read-modify-write core of `place <op>= rhs`.

        `current` MUST already be a load from the very same place the caller is
        about to store to (see the Field/Index arms of lower_assign, which pass
        the receiver/field_index/index_local they then reuse for the store).
        Keeping the combine in one helper is what guarantees the load and the
        store agree on the place and that the place is resolved exactly once."""
        val mir_op = self.lower_assign_op(op)
        var b = self.builder
        val result = b.emit_binop(mir_op, mir_operand_copy(current), mir_operand_copy(rhs), type_)
        self.builder = b
        result

    me compound_field_mir_type(base: HirExpr, receiver: LocalId, field_index: i64, value_local: LocalId) -> MirType:
        """MIR type for the read side of `obj.f <op>= v`.

        Prefers the OWNER struct's declared field type (the same
        struct_field_hir_type table the store side consults for the
        Optional-handle fix-up), so an f64 field is not read back through the
        i64 default and shredded. Falls back to the RHS local's own MIR type,
        then to i64."""
        var result = MirType.i64()
        var resolved_type = false
        val field_owner = self.resolve_base_struct_name(base, receiver)
        if val owner_name = field_owner:
            if self.struct_field_hir_type.contains(owner_name):
                val field_types = self.struct_field_hir_type[owner_name]
                if field_index >= 0 and field_index < field_types.len():
                    val declared_field_type = field_types[field_index]
                    match declared_field_type.kind:
                        case HirTypeKind.Error:
                            ()
                        case _:
                            result = self.lower_type(declared_field_type)
                            resolved_type = true
        if not resolved_type:
            val rhs_type = self.local_mir_type_of(value_local)
            if val rhs_mir_type = rhs_type:
                result = rhs_mir_type
        result

    me compound_elem_mir_type(base: HirExpr, receiver: LocalId, value_local: LocalId) -> MirType:
        """MIR element type for the read side of `container[k] <op>= v`.

        Mirrors the getter's type resolution in expr_dispatch's `case Index`:
        the store-observed element type wins (an empty `[]`/`{}` literal pins
        the declared type at the i64 default, which would decode a heap-boxed
        f64 as an integer and leak the box pointer), then the container's own
        MIR/HIR element type, then the RHS local's type, then i64."""
        var result = MirType.i64()
        var resolved_type = false
        if val noted_receiver_elem_type = self.noted_runtime_elem_type(receiver):
            result = noted_receiver_elem_type
            resolved_type = true
        if not resolved_type:
            val container_type = self.local_mir_type_of(receiver)
            if val container_mir_type = container_type:
                match container_mir_type.kind:
                    case MirTypeKind.Array(element_type, _):
                        result = element_type
                        resolved_type = true
                    case MirTypeKind.Slice(element_type):
                        result = element_type
                        resolved_type = true
                    case MirTypeKind.Dict(_, value_type):
                        result = value_type
                        resolved_type = true
                    case _:
                        ()
        if not resolved_type and base.has_type_ == true and base.type_ != nil:
            match base.type_.kind:
                case HirTypeKind.Array(element_type, _) | HirTypeKind.Slice(element_type):
                    result = self.lower_type(element_type)
                    resolved_type = true
                case HirTypeKind.Dict(_, value_type):
                    result = self.lower_type(value_type)
                    resolved_type = true
                case _:
                    ()
        if not resolved_type:
            val rhs_type = self.local_mir_type_of(value_local)
            if val rhs_mir_type = rhs_type:
                result = rhs_mir_type
        result

    me lower_assign_op(op: HirAssignOp) -> MirBinOp:
        """Convert assignment op to binary op."""
        match op:
            case Add: MirBinOp.Add
            case Sub: MirBinOp.Sub
            case Mul: MirBinOp.Mul
            case Div: MirBinOp.Div
            case Mod: MirBinOp.Rem
            case _: MirBinOp.Add

    me try_lower_bitfield_set(base: HirExpr, base_local: LocalId, field_name: text, value_local: LocalId) -> LocalId?:
        """Lower bitfield field writes before generic struct field assignment."""
        val sym_id = self.bitfield_type_sym_for(base, base_local)
        if sym_id < 0:
            return nil
        if not self.bitfield_map.contains(sym_id):
            return nil

        val fields = self.bitfield_map[sym_id]
        var idx = 0
        while idx < fields.len():
            match fields[idx]:
                case HirBitfieldField(_, name, _, _, bit_width, bit_offset, is_reserved, _):
                    if name != field_name or is_reserved:
                        idx = idx + 1
                        continue
                    val total_width = self.bitfield_total_width(fields)
                    if self.current_has_vhdl_metadata and bit_offset == 0 and bit_width > 0 and total_width > bit_width:
                        var b = self.builder
                        val preserved_high = b.new_temp(MirType.bits(total_width - bit_width))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlSlice(
                                preserved_high,
                                mir_operand_copy(base_local),
                                total_width - 1,
                                bit_width
                            ),
                            span: nil
                        ))
                        val casted_new = b.emit_cast(mir_operand_copy(value_local), MirType.bits(bit_width))
                        val result = b.new_temp(MirType.bits(total_width))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlConcat(
                                result,
                                [mir_operand_copy(preserved_high), mir_operand_copy(casted_new)]
                            ),
                            span: nil
                        ))
                        self.builder = b
                        return result
                    elif self.current_has_vhdl_metadata and bit_offset + bit_width == total_width and bit_width > 0 and bit_offset > 0:
                        var b = self.builder
                        val casted_new = b.emit_cast(mir_operand_copy(value_local), MirType.bits(bit_width))
                        val preserved_low = b.new_temp(MirType.bits(bit_offset))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlSlice(
                                preserved_low,
                                mir_operand_copy(base_local),
                                bit_offset - 1,
                                0
                            ),
                            span: nil
                        ))
                        val result = b.new_temp(MirType.bits(total_width))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlConcat(
                                result,
                                [mir_operand_copy(casted_new), mir_operand_copy(preserved_low)]
                            ),
                            span: nil
                        ))
                        self.builder = b
                        return result
                    elif self.current_has_vhdl_metadata and bit_offset > 0 and bit_width > 0 and bit_offset + bit_width < total_width:
                        var b = self.builder
                        val high_width = total_width - (bit_offset + bit_width)
                        val preserved_high = b.new_temp(MirType.bits(high_width))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlSlice(
                                preserved_high,
                                mir_operand_copy(base_local),
                                total_width - 1,
                                bit_offset + bit_width
                            ),
                            span: nil
                        ))
                        val casted_new = b.emit_cast(mir_operand_copy(value_local), MirType.bits(bit_width))
                        val preserved_low = b.new_temp(MirType.bits(bit_offset))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlSlice(
                                preserved_low,
                                mir_operand_copy(base_local),
                                bit_offset - 1,
                                0
                            ),
                            span: nil
                        ))
                        val result = b.new_temp(MirType.bits(total_width))
                        b.emit(MirInst(
                            kind: MirInstKind.VhdlConcat(
                                result,
                                [mir_operand_copy(preserved_high), mir_operand_copy(casted_new), mir_operand_copy(preserved_low)]
                            ),
                            span: nil
                        ))
                        self.builder = b
                        return result

                    val mask = self.bitfield_field_mask(bit_width)
                    val shifted_mask = mask << bit_offset
                    var b = self.builder
                    val clear_mask_const = b.emit_const_int(~shifted_mask)
                    val cleared = b.emit_binop(
                        MirBinOp.BitAnd,
                        mir_operand_copy(base_local),
                        mir_operand_copy(clear_mask_const),
                        MirType.i64()
                    )
                    val mask_const = b.emit_const_int(mask)
                    val masked_new = b.emit_binop(
                        MirBinOp.BitAnd,
                        mir_operand_copy(value_local),
                        mir_operand_copy(mask_const),
                        MirType.i64()
                    )
                    val shifted_new = if bit_offset == 0:
                        masked_new
                    else:
                        val offset_const = b.emit_const_int(bit_offset)
                        b.emit_binop(
                            MirBinOp.Shl,
                            mir_operand_copy(masked_new),
                            mir_operand_copy(offset_const),
                            MirType.i64()
                        )
                    val result = b.emit_binop(
                        MirBinOp.BitOr,
                        mir_operand_copy(cleared),
                        mir_operand_copy(shifted_new),
                        MirType.i64()
                    )
                    self.builder = b
                    return result
            idx = idx + 1

        nil

# ============================================================================
# Control Flow Lowering
# ============================================================================

    me lower_cond_expr(cond: HirExpr) -> LocalId:
        """Lower an expression that sits in boolean/condition position.

        `.?` is an existence check whose VALUE is `T?` -- the payload when
        present, nil when absent (syntax_quick_reference.md "Existence Check
        (.?) - Returns T?"), and `lower_expr`'s ExistsCheck arm
        (_MirLoweringExpr/expr_dispatch.spl) correctly produces exactly that.
        But the nil sentinel is the NON-ZERO integer 3 (RT_NIL =
        (SPECIAL_NIL << 3) | TAG_SPECIAL, runtime_value.h), so branching on
        that value directly is unconditionally TRUE -- a silent wrong-branch
        bug, strictly worse than a loud crash.

        So position decides the lowering, the same split the seed uses since
        ab773bb5d5e (lower_condition in the Rust seed's
        hir/lower/expr/control.rs) and the same split the tree-walk
        interpreter has always used: value position keeps the payload,
        condition position keeps the `rt_is_some` predicate.

        Everything that is not a bare `.?` falls through to the normal
        `lower_expr` dispatcher untouched. That fall-through is deliberate:
        the seed's first cut hand-built the and/or/not nodes here instead of
        routing through the dispatcher, which perturbed the JIT's extern set
        and demoted a whole module to the interpreter (a ~1000x perf cliff).
        `not`/`and`/`or` already funnel their operands back through the
        condition path via their own lowering, so they need nothing here.
        """
        match cond.kind:
            case HirExprKind.ExistsCheck(exists_base):
                val exists_local = self.lower_expr(exists_base)
                var b_cond = self.builder
                val is_some_func = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_is_some"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                        params: [MirType.i64()], return_type: MirType.bool(), is_variadic: false
                    )))
                ))
                val is_some_res = b_cond.emit_call(is_some_func, [mir_operand_copy(exists_local)], MirType.bool())
                self.builder = b_cond
                is_some_res ?? LocalId(id: 0)
            case _:
                self.lower_expr(cond)

    me lower_if(cond: HirExpr, then_: HirBlock, else_: HirBlock?, expected_type: HirType?) -> LocalId:
        """Lower if expression."""
        val cond_local = self.lower_cond_expr(cond)

        # `if val v = option.?:` is parser-desugared to a raw binding followed
        # by `v != nil`. Float payload bits must stay in that raw i64 binding
        # until the sentinel comparison has run, then become a real f32/f64
        # only while lowering the present branch.
        var if_val_symbol_id = -1
        var if_val_raw_local = LocalId(id: 0)
        var if_val_payload_type = MirType.i64()
        var has_if_val_float_binding = false
        match cond.kind:
            case HirExprKind.Binary(HirBinOp.NotEq, left, right):
                var right_is_nil = false
                match right.kind:
                    case HirExprKind.NilLit:
                        right_is_nil = true
                    case _:
                        ()
                if right_is_nil:
                    match left.kind:
                        case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                            val candidate = self.find_local(symbol.id)
                            if candidate.id >= 0:
                                val candidate_type = self.local_mir_type_of(candidate)
                                if val found_candidate_type = candidate_type:
                                    match found_candidate_type.kind:
                                        case MirTypeKind.I64:
                                            if val semantic_type = self.find_local_hir_type(candidate.id):
                                                match semantic_type.kind:
                                                    case HirTypeKind.Float(_):
                                                        if_val_symbol_id = symbol.id
                                                        if_val_raw_local = candidate
                                                        if_val_payload_type = self.lower_type(semantic_type)
                                                        has_if_val_float_binding = true
                                                    case _:
                                                        ()
                                        case _:
                                            ()
                        case _:
                            ()
            case _:
                ()

        var b = self.builder
        val then_block = b.new_block(Some("then"))
        val else_block = b.new_block(Some("else"))
        val merge_block = b.new_block(Some("merge"))
        # Typed from expected when known; else arm-type inference below
        # retypes at the merge (same fix as the match dispatches: an i64
        # default made print decimal-render text results of value-position
        # ifs).
        val result = b.new_temp(self.match_result_mir_type(expected_type))
        var inferred_known = false
        var inferred_ty = MirType.i64()
        b.terminate_if(mir_operand_copy(cond_local), then_block, else_block)
        self.builder = b

        # Then block
        var b2 = self.builder
        b2.switch_to_block(then_block)
        self.builder = b2
        if has_if_val_float_binding:
            val decoded_if_val = self.enum_payload_value(if_val_raw_local, if_val_payload_type)
            self.bind_local(if_val_symbol_id, decoded_if_val)
        val then_result = self.lower_block_expected(then_, expected_type)
        if has_if_val_float_binding:
            self.bind_local(if_val_symbol_id, if_val_raw_local)
        var b3 = self.builder
        var result_defined = false
        if not b3.current_block_has_explicit_terminator():
            # `.?` + `??` extraction: if-val on lower_block_expected's
            # LocalId? evaluates FALSE on the stage4 lane (pairing class),
            # silently skipping the arm-result copy (value-position if
            # printed 0).
            if then_result.?:
                val then_local_fb = LocalId(id: 0)
                val then_local = then_result ?? then_local_fb
                # A Unit-typed arm result (statement-form print, etc.) has no
                # real value to merge -- copying it into the i64 result slot
                # would force an `alloca void` in the backend. Leave
                # result_defined false; the merge block below falls back to
                # a const-0 def in that case.
                if not self.local_is_unit(then_local):
                    b3.emit_copy(result, then_local)
                    result_defined = true
                    if not inferred_known:
                        if val then_ty_found = self.local_mir_type_of(then_local):
                            inferred_known = true
                            inferred_ty = then_ty_found
            b3.terminate_goto(merge_block)
        self.builder = b3

        # Else block
        var b4 = self.builder
        b4.switch_to_block(else_block)
        self.builder = b4
        if val else_block_value = else_:
            val else_result = self.lower_block_expected(else_block_value, expected_type)
            var b5 = self.builder
            if not b5.current_block_has_explicit_terminator():
                if else_result.?:
                    val else_local_fb = LocalId(id: 0)
                    val else_local = else_result ?? else_local_fb
                    if not self.local_is_unit(else_local):
                        b5.emit_copy(result, else_local)
                        result_defined = true
                        if not inferred_known:
                            if val else_ty_found = self.local_mir_type_of(else_local):
                                inferred_known = true
                                inferred_ty = else_ty_found
                b5.terminate_goto(merge_block)
            self.builder = b5
        else:
            var b5 = self.builder
            b5.terminate_goto(merge_block)
            self.builder = b5

        # Merge block
        var b6 = self.builder
        b6.switch_to_block(merge_block)
        # The terminator guard skips emit_copy in arms that already returned;
        # if no arm defined result, the returned LocalId would be read while
        # undefined downstream (NULL llvm::Value* -> ICmp SIGSEGV in llvm-lib).
        # Define it in the merge block so every returned id has a def.
        if not result_defined:
            b6.emit_const(result, MirConstValue.Int(0), MirType.i64())
        if inferred_known:
            b6.set_local_type(result, inferred_ty)
        self.builder = b6

        if val found_expected = expected_type:
            self.remember_local_hir_type(result.id, found_expected)
            match found_expected.kind:
                case HirTypeKind.Optional(_):
                    self.option_value_locals[result.id] = true
                    self.mark_runtime_value_local(result.id)
                case _:
                    ()

        result

    me lower_loop(body: HirBlock) -> LocalId:
        """Lower loop expression."""
        var b = self.builder
        val loop_block = b.new_block(Some("loop"))
        val exit_block = b.new_block(Some("loop_exit"))
        self.builder = b

        self.loop_stack = self.loop_stack.push((loop_block, exit_block))
        self.loop_cleanup_depths.push(self.facet_cleanup_scopes.len())

        var b2 = self.builder
        b2.terminate_goto(loop_block)
        b2.switch_to_block(loop_block)
        self.builder = b2

        self.lower_block(body)

        # If the body's last statement already terminated the current block
        # (an explicit break/continue/return with no trailing code), don't
        # add a second terminator -- doing so would silently overwrite it
        # (e.g. turning a trailing `break` into a backedge, making the loop
        # infinite). Mirrors the guard in lower_for.
        var b3 = self.builder
        if not b3.current_block_has_explicit_terminator():
            b3.terminate_goto(loop_block)
        self.builder = b3

        self.loop_stack = self.loop_stack[0:self.loop_stack.len() - 1]
        self.loop_cleanup_depths = self.loop_cleanup_depths[0:self.loop_cleanup_depths.len() - 1]

        var b4 = self.builder
        b4.switch_to_block(exit_block)
        val loop_result = b4.new_temp(MirType.unit())
        self.builder = b4
        loop_result

    me lower_while(cond: HirExpr, body: HirBlock) -> LocalId:
        """Lower while expression."""
        var b = self.builder
        val cond_block = b.new_block(Some("while_cond"))
        val body_block = b.new_block(Some("while_body"))
        val exit_block = b.new_block(Some("while_exit"))
        self.builder = b

        self.loop_stack = self.loop_stack.push((cond_block, exit_block))
        self.loop_cleanup_depths.push(self.facet_cleanup_scopes.len())

        var b2 = self.builder
        b2.terminate_goto(cond_block)
        b2.switch_to_block(cond_block)
        self.builder = b2

        # Condition position: see lower_cond_expr -- a bare `while opt.?:`
        # would otherwise spin forever on the non-zero nil sentinel.
        val cond_local = self.lower_cond_expr(cond)
        var b3 = self.builder
        b3.terminate_if(mir_operand_copy(cond_local), body_block, exit_block)
        b3.switch_to_block(body_block)
        self.builder = b3

        self.lower_block(body)

        # If the body's last statement already terminated the current block
        # (an explicit break/continue/return with no trailing code), don't
        # add a second terminator -- doing so would silently overwrite it
        # (e.g. turning a trailing `break` into a backedge, making the loop
        # infinite -- #163: `while true:`/`loop:` + continue). Mirrors the
        # guard in lower_for.
        var b4 = self.builder
        if not b4.current_block_has_explicit_terminator():
            b4.terminate_goto(cond_block)
        self.builder = b4

        self.loop_stack = self.loop_stack[0:self.loop_stack.len() - 1]
        self.loop_cleanup_depths = self.loop_cleanup_depths[0:self.loop_cleanup_depths.len() - 1]

        var b5 = self.builder
        b5.switch_to_block(exit_block)
        val while_result = b5.new_temp(MirType.unit())
        self.builder = b5
        while_result

    me lower_for(var_: SymbolId, iter: HirExpr, body: HirBlock, source_span: Span) -> LocalId:
        """Lower for expression.

        For range-based iteration (for x in start..end), lowers directly to
        a counted while-loop with an integer counter. This avoids the overhead
        of the full iterator protocol and produces simpler MIR that is easier
        to optimize (LICM, unrolling, strength reduction).

        For non-range iterables, falls back to the iterator protocol:
            val _iter = collection.iter()
            while _iter.has_next():
                val x = _iter.next()
                body
        """
        # Check if the iterable is a Range expression for direct lowering
        # NOTE: this arm was previously dead in practice for every native
        # `for i in start..end:` loop -- NOT because this match is broken,
        # but because the flat-AST bridge that feeds this pipeline
        # (_FlatAstBridge/convert_nodes.spl's convert_flat_expr) had no
        # EXPR_RANGE case, so `iter.kind` arrived here as ExprKind.NilLit
        # instead of a real Range and always fell to `case _`. That always
        # sent range-based for-loops into the generic iterator-protocol
        # fallback (lower_for_iterator), which panics with "for-in over
        # non-array iterables is not supported" for anything that isn't a
        # runtime array -- i.e. every native-build `for i in 0..N:` crashed
        # at runtime. Fixed at the source (convert_nodes.spl now builds
        # ExprKind.Range for EXPR_RANGE); this match itself needed no change
        # once the bridge fed it a real Range.
        match iter.kind:
            case Range(start, end, inclusive, step):
                return self.lower_for_range(var_, start, end, inclusive, step, body, source_span)
            case _:
                pass  # Fall through to iterator protocol

        # General case: iterator protocol lowering
        self.lower_for_iterator(var_, iter, body, source_span)

    me lower_for_range(
        var_: SymbolId,
        start: HirExpr?,
        end: HirExpr?,
        inclusive: bool,
        step: HirExpr?,
        body: HirBlock,
        source_span: Span
    ) -> LocalId:
        """Lower range-based for loop directly to a counted while-loop.

        Lowers:
            for i in start..end:
                body

        Into:
            var i = start
            while i < end:   (or i <= end for inclusive)
                body
                i = i + step
        """
        # Derive loop counter type from bound HirExpr types before emitting any code.
        # This preserves u64 (and other non-i64 integer) counter types end-to-end.
        var loop_ty = MirType.i64()
        if val end_expr = end:
            match end_expr.type_:
                case Some(end_type):
                    loop_ty = self.lower_type(end_type)
                case nil:
                    ()
        elif val start_expr = start:
            match start_expr.type_:
                case Some(start_type):
                    loop_ty = self.lower_type(start_type)
                case nil:
                    ()

        # Lower start value (default to typed 0)
        var start_local: LocalId = 0
        if val start_expr = start:
            start_local = self.lower_expr(start_expr)
        else:
            var b = self.builder
            val temp = b.new_temp(loop_ty)
            b.emit_const(temp, MirConstValue.Int(0), loop_ty)
            self.builder = b
            start_local = temp

        # Lower end value (default to typed 0; open-ended ranges need the iterator path)
        var end_local: LocalId = 0
        if val end_expr = end:
            end_local = self.lower_expr(end_expr)
        else:
            var b = self.builder
            val temp = b.new_temp(loop_ty)
            b.emit_const(temp, MirConstValue.Int(0), loop_ty)
            self.builder = b
            end_local = temp

        # Lower step value (default to typed 1)
        var step_local: LocalId = 0
        if val step_expr = step:
            step_local = self.lower_expr(step_expr)
        else:
            var b = self.builder
            val temp = b.new_temp(loop_ty)
            b.emit_const(temp, MirConstValue.Int(1), loop_ty)
            self.builder = b
            step_local = temp

        # Create the loop counter variable (mutable)
        var b_init = self.builder
        val counter = b_init.new_local(nil, loop_ty, LocalKind.Var)
        b_init.emit_copy(counter, start_local)
        self.builder = b_init

        # Bind loop variable to the counter
        val range_var_id = mir_stmt_symbol_id_value(var_)
        if range_var_id < 0:
            self.error("for range loop variable has no resolved symbol", Some(body.span))
        else:
            self.bind_local(range_var_id, counter)

        # Create loop blocks
        var b_blocks = self.builder
        val cond_block = b_blocks.new_block(Some("for_range_cond"))
        val body_block = b_blocks.new_block(Some("for_range_body"))
        val inc_block = b_blocks.new_block(Some("for_range_inc"))
        val exit_block = b_blocks.new_block(Some("for_range_exit"))
        self.builder = b_blocks

        # `continue` must target inc_block, not cond_block directly: the
        # counter increment (counter = counter + step) is compiler-
        # synthesized and must run on every iteration, including ones ended
        # early by `continue` -- otherwise the counter never advances and
        # the loop spins forever once a `continue` fires. Mirrors the fix
        # already applied to lower_for_array_indexed (see its loop_stack
        # push below for the same rationale).
        self.loop_stack = self.loop_stack.push((inc_block, exit_block))
        self.loop_cleanup_depths.push(self.facet_cleanup_scopes.len())

        # Jump to condition check
        var b_goto = self.builder
        b_goto.terminate_goto(cond_block)
        b_goto.switch_to_block(cond_block)
        self.builder = b_goto

        # Condition: counter < end (or counter <= end for inclusive)
        val cmp_op = if inclusive: MirBinOp.Le else: MirBinOp.Lt
        var b_cond = self.builder
        val cond_result = b_cond.emit_binop(
            cmp_op,
            mir_operand_copy(counter),
            mir_operand_copy(end_local),
            MirType.bool()
        )
        self.builder = b_cond
        b_cond = self.builder
        b_cond.terminate_if(mir_operand_copy(cond_result), body_block, exit_block)
        b_cond.switch_to_block(body_block)
        self.builder = b_cond

        # Lower the loop body
        self.lower_block(body)

        # If the body's last statement already terminated the current block
        # (an explicit break/continue/return with no trailing code), don't
        # add a second terminator here -- doing so would silently overwrite
        # it: e.g. a trailing `break`'s Goto(exit_block) or a `return`'s Ret
        # would be clobbered by this loop's own fall-through jump, turning
        # `break`/`return` into a plain backedge. Mirrors the guard already
        # used by lower_loop/lower_while/lower_for_array_indexed -- this
        # range-based for-loop was the one lowering missing it.
        var b_body_end = self.builder
        if not b_body_end.current_block_has_explicit_terminator():
            b_body_end.terminate_goto(inc_block)
        self.builder = b_body_end

        # Increment: counter = counter + step (also the `continue` target)
        var b_inc = self.builder
        b_inc.switch_to_block(inc_block)
        val incremented = b_inc.emit_binop(
            MirBinOp.Add,
            mir_operand_copy(counter),
            mir_operand_copy(step_local),
            loop_ty
        )
        b_inc.emit_copy(counter, incremented)
        self.builder = b_inc

        # Jump back to condition
        var b_back = self.builder
        b_back.terminate_goto(cond_block)
        self.builder = b_back

        # Exit block
        self.loop_stack = self.loop_stack[0:self.loop_stack.len() - 1]
        self.loop_cleanup_depths = self.loop_cleanup_depths[0:self.loop_cleanup_depths.len() - 1]
        var b_exit = self.builder
        b_exit.switch_to_block(exit_block)
        val for_result = b_exit.new_temp(MirType.unit())
        self.builder = b_exit
        for_result

    me lower_for_iterator(var_: SymbolId, iter: HirExpr, body: HirBlock, source_span: Span) -> LocalId:
        """Lower `for x in collection` for non-range iterables.

        Runtime arrays and text lower to a real counted index loop (see
        lower_for_array_indexed). Any other iterable (dicts, custom
        iterators, ...) has no native iterator-protocol lowering yet (#143):
        the old stub emitted iter()/has_next()/next() calls through null
        function-pointer constants (Const Int(0) FuncPtr), which resolve to
        `call 0` and SIGSEGV natively. Instead of that, fail loudly: record a
        compile error AND emit an rt_panic call carrying the same message, so
        pipelines that drop MirLowering.errors (e.g. the native-build
        worker's lower_to_mir) still abort with a clear diagnostic at runtime
        rather than crashing on a null call.
        """
        # Step 1: Lower the iterable expression
        val collection_local = self.lower_expr(iter)
        var element_type = MirType.i64()
        if val loop_symbol = self.symbols.get_symbol_raw(var_.id):
            match loop_symbol.type_:
                case Some(loop_symbol_type):
                    element_type = self.lower_type(loop_symbol_type)
                case nil:
                    ()

        # The loop-variable symbol's HIR type is frequently nil on this
        # pipeline (native-build's lower_to_mir runs without a full
        # type-inference pass), so `element_type` silently defaulted to i64
        # above for EVERY for-in loop whose loop var has no resolved type --
        # correct by accident for `for n in [1,2,3]` (ints really are i64),
        # but WRONG for `for s in ["ab","cd"]`: a string array element is a
        # TAGGED heap-string handle (see box_runtime_value/lower_array_lit),
        # and decoding it as i64 shifts/truncates the handle into garbage,
        # which downstream string method calls then dereference as if it
        # were a raw char* -> SIGSEGV or garbage output.
        #
        # The array/slice's OWN lowered MIR type is authoritative and always
        # populated at construction time (lower_array_lit sets
        # `Array(first_element's_mir_type, size)`), exactly like the direct
        # index-read path `arr[i]` already reads element type off
        # `base_mir_type.kind` (see expr_dispatch.spl `case Index`). Mirror
        # that here so `for x in arr` and `arr[i]` agree on the element type.
        if val collection_hir_type = self.find_local_hir_type(collection_local.id):
            match collection_hir_type.kind:
                case HirTypeKind.Array(elem_t, _) | HirTypeKind.Slice(elem_t):
                    element_type = self.lower_type(elem_t)
                case _: ()
        if val coll_mir_type = self.local_mir_type_of(collection_local):
            match coll_mir_type.kind:
                case MirTypeKind.Array(elem_t, _):
                    element_type = elem_t
                case MirTypeKind.Slice(elem_t):
                    element_type = elem_t
                case _:
                    ()

        # Text iteration reuses the canonical Unicode splitter, then the same
        # counted array loop used by `text.chars()`. Do not index bytes here:
        # one loop element is one UTF-8 codepoint-sized text value.
        if self.local_is_str(collection_local):
            val tagged_text = self.ensure_tagged_str(collection_local)
            val chars_func = MirOperand(kind: MirOperandKind.Const(
                MirConstValue.Str("rt_string_chars"),
                MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
            ))
            var b_chars = self.builder
            val chars_call = b_chars.emit_call(chars_func, [mir_operand_copy(tagged_text)], MirType.i64())
            self.builder = b_chars
            if val chars_local = chars_call:
                return self.lower_for_array_indexed(
                    var_,
                    chars_local,
                    MirType(kind: MirTypeKind.Opaque("str")),
                    body,
                    source_span
                )

        # Runtime-array fast path: lower `for x in arr` to an index-based
        # counted loop over rt_array_len / rt_array_get (mirrors the array
        # index-read call shape in _MirLoweringExpr/expr_dispatch.spl).
        if self.local_is_runtime_array(collection_local):
            return self.lower_for_array_indexed(var_, collection_local, element_type, body, source_span)

        # Non-array iterable: no supported lowering (#143). Fail loudly.
        val iter_unsupported_msg = "for-in over non-array iterables is not supported by native codegen yet (#143); iterate an array or use while"
        self.error(iter_unsupported_msg, Some(body.span))

        # Belt-and-braces for pipelines that never read MirLowering.errors:
        # emit `rt_panic(msg)` where the loop would have been. A MIR Str
        # const lowers to a NUL-terminated C-string pointer, matching
        # rt_panic(const char*). The loop body is intentionally not lowered.
        var b_panic = self.builder
        self.emit_facet_cleanup_from(0)
        b_panic = self.builder
        val panic_msg_local = b_panic.emit_const_str(iter_unsupported_msg)
        val panic_func_operand = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_panic"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)))
        ))
        b_panic.emit_call(panic_func_operand, [mir_operand_copy(panic_msg_local)], MirType.unit())
        val for_result = panic_msg_local
        self.builder = b_panic
        for_result

    me lower_for_array_indexed(
        var_: SymbolId,
        collection_local: LocalId,
        element_type: MirType,
        body: HirBlock,
        source_span: Span
    ) -> LocalId:
        """Lower `for x in arr` over a runtime array as a counted index loop.

        Emits the equivalent of:
            var i = 0
            val n = rt_array_len(arr)
            while i < n:
                val x = rt_array_get(arr, i)
                body
                i = i + 1

        Uses the same rt_array_len / rt_array_get call shape as the array
        index-read lowering in _MirLoweringExpr/expr_dispatch.spl, avoiding the
        generic iterator protocol whose null-funcptr callees SIGSEGV natively.
        """
        val loop_ty = MirType.i64()

        # Length: n = rt_array_len(arr)
        val len_func = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_array_len"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_len = self.builder
        val len_call = b_len.emit_call(len_func, [mir_operand_copy(collection_local)], MirType.i64())
        var len_local: LocalId = 0
        if val len_value = len_call:
            len_local = len_value
        else:
            len_local = b_len.new_temp(MirType.i64())
        self.builder = b_len

        # Counter: var i = 0
        var b_init = self.builder
        val counter = b_init.new_local(nil, loop_ty, LocalKind.Var)
        val zero = b_init.new_temp(loop_ty)
        b_init.emit_const(zero, MirConstValue.Int(0), loop_ty)
        b_init.emit_copy(counter, zero)
        # Step constant 1 (defined once, used in the increment block)
        val one = b_init.new_temp(loop_ty)
        b_init.emit_const(one, MirConstValue.Int(1), loop_ty)
        self.builder = b_init

        # Loop blocks
        var b_blocks = self.builder
        val cond_block = b_blocks.new_block(Some("for_arr_cond"))
        val body_block = b_blocks.new_block(Some("for_arr_body"))
        val inc_block = b_blocks.new_block(Some("for_arr_inc"))
        val exit_block = b_blocks.new_block(Some("for_arr_exit"))
        self.builder = b_blocks

        # `continue` must target the increment block, not cond_block directly:
        # this is a counted-index desugaring of `for x in arr`, so the counter
        # increment is compiler-synthesized and must run on every iteration
        # (including ones ended early by `continue`). Pointing continue at
        # cond_block skips the increment, so the counter never advances and the
        # loop spins forever once a `continue` fires.
        self.loop_stack = self.loop_stack.push((inc_block, exit_block))
        self.loop_cleanup_depths.push(self.facet_cleanup_scopes.len())

        # Jump to condition check
        var b_goto = self.builder
        b_goto.terminate_goto(cond_block)
        b_goto.switch_to_block(cond_block)
        self.builder = b_goto

        # Condition: i < n
        var b_cond = self.builder
        val cond_result = b_cond.emit_binop(
            MirBinOp.Lt,
            mir_operand_copy(counter),
            mir_operand_copy(len_local),
            MirType.bool()
        )
        self.builder = b_cond
        b_cond = self.builder
        b_cond.terminate_if(mir_operand_copy(cond_result), body_block, exit_block)
        b_cond.switch_to_block(body_block)
        self.builder = b_cond

        # Element: x = rt_array_get(arr, i)
        val get_func = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_array_get"),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)))
        ))
        var b_get = self.builder
        val get_call = b_get.emit_call(
            get_func,
            [mir_operand_copy(collection_local), mir_operand_copy(counter)],
            MirType.i64()
        )
        var elem_local: LocalId = 0
        if val get_value = get_call:
            elem_local = get_value
        else:
            elem_local = b_get.new_temp(MirType.i64())
        self.builder = b_get

        # rt_array_get returns a TAGGED runtime value (value << 3 for small
        # ints, boxed handle otherwise). Decode it to the element's primitive
        # type before binding, exactly as the direct index-read path does
        # (decode_runtime_value in _MirLoweringExpr/expr_dispatch.spl). Without
        # this the loop variable stays tagged, so arithmetic and comparisons
        # against untagged literals are wrong (e.g. `x == 3` never matches a
        # tagged element, and `total + x` accumulates value<<3). Regression
        # introduced when array elements began carrying tagged runtime values.
        #
        # Bug s54/s54c/s54d: when array_element_struct_syms has a REAL
        # registered element struct name (not "" / not the
        # "__runtime_array__" placeholder used for plain value-typed
        # arrays), decode via an Opaque placeholder instead of trusting
        # element_type -- same gated fix as expr_dispatch.spl's Index case,
        # now safe because s54d's frontend fix (parser.spl's `[T]`
        # array-type branch + convert_flat_type's array-generic-tag decode)
        # makes function_lowering.spl's param-array Named-element case
        # populate this map for class/struct-typed PARAMS too, not just
        # local array literals. Gating strictly on a real name keeps this a
        # no-op for int/text/bool arrays (an earlier unconditional version
        # corrupted int-array for-in sums by leaving them tagged <<3).
        val for_elem_struct_name = self.array_element_struct_syms.get(collection_local.id)
        val fesn = for_elem_struct_name ?? ""
        val for_has_real_struct_name = fesn != "" and fesn != "__runtime_array__"
        val decode_elem_type = if for_has_real_struct_name:
            MirType(kind: MirTypeKind.Opaque(fesn))
        else:
            element_type
        if for_has_real_struct_name:
            self.mark_runtime_value_local(elem_local.id)
        val decoded_elem = self.decode_runtime_value(elem_local, decode_elem_type)

        # Bind loop variable to the (decoded) element
        var b_bind = self.builder
        val loop_var = b_bind.new_local(nil, element_type, LocalKind.Var)
        b_bind.emit_copy(loop_var, decoded_elem)
        self.builder = b_bind
        val loop_var_id = mir_stmt_symbol_id_value(var_)
        if loop_var_id < 0:
            self.error("for loop variable has no resolved symbol", Some(body.span))
        else:
            self.bind_local(loop_var_id, loop_var)
            # Bug (array-of-structs field misread), CONFLICT-FLAG
            # (mir_lowering_stmts.spl is fenced): `for p in pts` over an
            # array of structs desugars to this counted-index loop, whose
            # decoded per-iteration element is a SEPARATE decode_runtime_value
            # call site from expr_dispatch.spl's Index case (which already
            # got the array_element_struct_syms -> struct_value_syms
            # propagation). Without the SAME propagation here, `p.y` inside
            # the loop body silently defaulted to field index 0 (reading
            # `.x`'s slot) exactly like the standalone `pts[i].y` bug this
            # lane fixed, just reached via the for-loop desugaring instead.
            # Reuses for_elem_struct_name/fesn computed above the decode.
            if for_has_real_struct_name:
                self.struct_value_syms[loop_var.id] = fesn

        # Lower the loop body
        self.lower_block(body)

        # Fall through into the increment block. If the body's last statement
        # already terminated the current block (an explicit break/continue/
        # return with no trailing code), don't add a second terminator -- let
        # that jump stand.
        var b_body_end = self.builder
        if not b_body_end.current_block_has_explicit_terminator():
            b_body_end.terminate_goto(inc_block)
        self.builder = b_body_end

        # Increment: i = i + 1 (also the `continue` target -- see loop_stack push)
        var b_inc = self.builder
        b_inc.switch_to_block(inc_block)
        val incremented = b_inc.emit_binop(
            MirBinOp.Add,
            mir_operand_copy(counter),
            mir_operand_copy(one),
            loop_ty
        )
        b_inc.emit_copy(counter, incremented)
        self.builder = b_inc

        # Jump back to condition
        var b_back = self.builder
        b_back.terminate_goto(cond_block)
        self.builder = b_back

        # Exit block
        self.loop_stack = self.loop_stack[0:self.loop_stack.len() - 1]
        self.loop_cleanup_depths = self.loop_cleanup_depths[0:self.loop_cleanup_depths.len() - 1]
        var b_exit = self.builder
        b_exit.switch_to_block(exit_block)
        val for_result = b_exit.new_temp(MirType.unit())
        self.builder = b_exit
        for_result

# ============================================================================
# Exports
# ============================================================================

# Methods are attached to MirLowering via impl block above.
# No separate exports needed -- they are accessed through MirLowering instances.
