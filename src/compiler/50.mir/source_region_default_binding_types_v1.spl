# Immutable encoded observations, never replay/admission authority.
use compiler.hir.hir_codec_support.{HirCodecSymbolOccurrenceV1}

struct MirSourceDefaultSymbolRecordV1:
    symbol: i64
    bytes: text
    references: [HirCodecSymbolOccurrenceV1]

struct MirSourceDefaultBindingsV1:
    original: i64
    ordinal: i64
    target_key: text
    expression_references: [HirCodecSymbolOccurrenceV1]
    symbols: [MirSourceDefaultSymbolRecordV1]

struct MirSourceDefaultCapturedExpressionV1:
    blob: text
    bindings: MirSourceDefaultBindingsV1
