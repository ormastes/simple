# Explicit compiler-owned cross-object function visibility. This is MIR
# metadata, not a source export or authority inferred from a name prefix.
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirSignature}

struct MirCompilerPrivateFunctionV1:
    schema_version: i64
    symbol: SymbolId
    name: text
    signature: MirSignature
    emission_owner: text
    canonical_key: text
    key_digest: text
    defines_here: bool

pub fn mir_compiler_private_identity_valid_v1(binding: MirCompilerPrivateFunctionV1) -> bool:
    binding.schema_version == 1 and binding.symbol.is_valid() and
        binding.name != "" and binding.emission_owner != "" and
        binding.canonical_key != "" and binding.key_digest != "" and
        binding.signature.params_known and binding.signature.declared_params_known and
        binding.signature.params == binding.signature.declared_params and
        not binding.signature.is_variadic
