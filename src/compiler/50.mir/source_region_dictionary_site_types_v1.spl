# Data-only owner for actual SOURCE dictionary emission records.
use compiler.hir.hir_types.{HirType, SymbolId}
use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_instruction_support.{BlockId}
use compiler.mir.mir_instruction_graph.{MirInst}

enum SourceRegionDictionaryOperationV1:
    Birth
    Put
    Remove
    Read

enum SourceRegionDictionaryCodecV1:
    RawI64
    OrdinaryStruct

enum SourceRegionDictionaryReadKindV1:
    Optional
    Index

struct SourceRegionDictionaryDescriptorV1:
    key_type: HirType
    value_type: HirType
    value_owner: SymbolId
    value_codec: SourceRegionDictionaryCodecV1
    value_layout_identity: text
    value_layout_digest: text

struct SourceRegionDictionarySiteV1:
    owner: SymbolId
    block: BlockId
    instruction_index: i64
    operation: SourceRegionDictionaryOperationV1
    dictionary_local: LocalId
    result_local: LocalId?
    key_local: LocalId?
    value_local: LocalId?
    key_type: HirType
    value_type: HirType
    descriptor: SourceRegionDictionaryDescriptorV1
    # Exact pre-box local bindings and emitted compiler-private operation.
    # These rows are captured at the source operation, never reconstructed
    # from an rt_dict_* spelling or a later typed alias. Native ABI emission
    # occurs only after the resolved-facade planner consumes this authority.
    key_codec: SourceRegionDictionaryCodecV1
    emitted: MirInst
    read_kind: SourceRegionDictionaryReadKindV1? = nil
