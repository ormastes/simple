# Shared selected-class reservation for coordinator and MIR workers.
use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_owner_name.{hir_symbol_owner_module}

struct AccessorTypeBindingV1:
    canonical_key: text
    physical_symbol: SymbolId
    declaring_module: text
    declaring_name: text
    layout_identity: text
    provider_identity: text

pub fn accessor_type_key_v1(module_name: text, type_name: text) -> text:
    val owner = hir_symbol_owner_module(module_name)
    if owner == "" or type_name == "": return ""
    owner + "." + type_name

pub fn accessor_type_bindings_validate_v1(bindings: [AccessorTypeBindingV1]) -> Result<bool, text>:
    for index in 0..bindings.len():
        val row = bindings[index]
        if row.canonical_key == "" or row.canonical_key != accessor_type_key_v1(row.declaring_module, row.declaring_name) or
                row.physical_symbol.id < 1000000000 or row.physical_symbol.id == 9223372036854775807 or
                row.layout_identity == "" or row.provider_identity == "":
            return Err("E-AOP-FIELD-TYPE: incomplete canonical physical binding")
        for earlier in 0..index:
            if bindings[earlier].canonical_key == row.canonical_key or bindings[earlier].physical_symbol.id == row.physical_symbol.id:
                return Err("E-AOP-FIELD-TYPE: duplicate canonical key or reserved physical ID")
    Ok(true)
