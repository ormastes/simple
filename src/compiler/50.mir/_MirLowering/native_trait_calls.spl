use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_data.*
use compiler.mir.mir_types.*
use compiler.mir.mir_instructions.*
use compiler.mir.native_trait_metadata.*
use compiler.mir._MirLowering.native_trait_registration.*
use compiler.mir._MirLowering.native_trait_dispatch.*
use compiler.mir._MirLowering.native_trait_conversion.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*

impl MirLowering:
    me lower_native_trait_method(receiver: HirExpr, owner: text, name: text,
            arguments: [HirCallArg]) -> LocalId:
        val layout_index = self.native_trait_layout_index(owner)
        if layout_index < 0:
            self.error_fatal("native trait dispatch lacks declaration: {owner}", Some(receiver.span))
            return LocalId(id: -1)
        val layout = self.native_trait_layouts[layout_index]
        val slot_index = native_trait_slot_index(layout, name)
        if not layout.object_safe or slot_index < 0:
            self.error_fatal("native trait dispatch lacks object-safe method: {owner}::{name}", Some(receiver.span))
            return LocalId(id: -1)
        val slot = layout.methods[slot_index]
        if slot.params.len() != arguments.len() + 1:
            self.error_fatal("native trait argument count mismatch: {owner}::{name}", Some(receiver.span))
            return LocalId(id: -1)
        val receiver_local = self.lower_expr(receiver)
        var locals: [LocalId] = []
        var assigned: [bool] = []
        for argument in arguments:
            locals.push(LocalId(id: -1))
            assigned.push(false)
        var positional_index = 0
        # Evaluate in source order, then arrange the already-evaluated values
        # in declaration order. Named arguments must not reorder side effects.
        for argument in arguments:
            var index = positional_index
            if argument.has_name:
                index = -1
                var candidate = 1
                while candidate < slot.parameter_names.len():
                    if slot.parameter_names[candidate] == argument.name: index = candidate - 1
                    candidate = candidate + 1
            else:
                positional_index = positional_index + 1
            if index < 0 or index >= locals.len():
                self.error_fatal("unknown native trait argument: {owner}::{name}", Some(argument.span))
                return LocalId(id: -1)
            if assigned[index]:
                self.error_fatal("duplicate native trait argument: {owner}::{name}", Some(argument.span))
                return LocalId(id: -1)
            val expected = slot.params[index + 1]
            var local = self.lower_expr(argument.value)
            local = self.coerce_native_trait_object(local, argument.value, expected)
            match expected.kind:
                case HirTypeKind.Optional(_):
                    local = self.ensure_option_handle(local, expected)
                case HirTypeKind.Int(width, _):
                    if width < 64:
                        val actual = self.local_mir_type_of(local)
                        if val actual_type = actual:
                            if actual_type.kind == MirTypeKind.I64 or actual_type.kind == MirTypeKind.U64:
                                val narrowed_type = self.lower_type(expected)
                                var builder = self.builder
                                local = builder.emit_cast(mir_operand_copy(local), narrowed_type)
                                self.builder = builder
                case _: ()
            locals[index] = local
            assigned[index] = true
        var operands: [MirOperand] = []
        var index = 0
        while index < locals.len():
            if not assigned[index]:
                self.error_fatal("missing native trait argument: {owner}::{name}", Some(receiver.span))
                return LocalId(id: -1)
            operands.push(mir_operand_copy(locals[index]))
            index = index + 1
        val result = self.emit_native_trait_slot_call(receiver_local, owner, name, operands)
        if val local = result:
            # declared_result differs from result only for a bootstrap-erased
            # `-> X?` (an i64 Option handle word either way): mark it as the
            # Option it is, or `if val v = o.m()` tests a scalar.
            # A generic slot's `T?` takes the receiver instance's argument, so
            # a `match` binder decodes the payload as i64/text/f64, not as T.
            var marked = slot.declared_result
            val result_param = self.native_trait_optional_param_payload(marked)
            if result_param != "":
                if val instance_arg = self.native_trait_receiver_type_arg(receiver, receiver_local, layout, result_param):
                    marked = HirType(kind: HirTypeKind.Optional(instance_arg), span: marked.span)
                    self.native_trait_concrete_option_locals[local.id] = true
            self.remember_local_hir_type(local.id, marked, 2, 0)
            match marked.kind:
                case HirTypeKind.Optional(_):
                    self.option_value_locals[local.id] = true
                    self.mark_runtime_value_local(local.id)
                case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                    self.runtime_array_locals[local.id] = true
                    self.mark_runtime_value_local(local.id)
                case HirTypeKind.Named(result_owner, _):
                    # A record result (`core.read_pixels_region(..)` ->
                    # `Engine2DReadback`) needs its layout owner, same as the
                    # indirect-call result arm: without it a projection
                    # `.pixels` on this local never takes the declared-field
                    # path, so the `[u32]` field lost its runtime-array mark
                    # and `.slice` fell to the runtime fallback.
                    if val result_declaration = self.symbols.get_symbol_raw(result_owner.id):
                        val result_layout_key = self.declared_struct_layout_key(self.composite_layout_key(result_declaration))
                        if self.struct_field_order.has(result_layout_key):
                            self.struct_value_syms[local.id] = result_layout_key
                case _: ()
            if self.native_trait_owner_for_type(marked) != "":
                val result_mir_type = self.local_mir_type_of(local)
                var already_trait_tuple = false
                if val mir_t = result_mir_type:
                    match mir_t.kind:
                        case MirTypeKind.Tuple(_): already_trait_tuple = true
                        case _: ()
                if not already_trait_tuple:
                    var cast_builder = self.builder
                    val trait_local = cast_builder.emit_bitcast(mir_operand_copy(local), native_trait_object_type())
                    self.builder = cast_builder
                    self.remember_local_hir_type(trait_local.id, marked, 2, 0)
                    return trait_local
            return local
        var builder = self.builder
        val unit_local = builder.new_temp(MirType.unit())
        self.builder = builder
        unit_local

    fn native_trait_receiver_type_arg(receiver: HirExpr, receiver_local: LocalId,
            layout: NativeTraitLayout, name: text) -> HirType?:
        """The receiver instance's argument for trait parameter `name`
        (`Reader<i64>` gives i64), else None and the declared `T` stays."""
        var position = -1
        var index = 0
        while index < layout.type_params.len():
            if layout.type_params[index] == name: position = index
            index = index + 1
        if position < 0: return None
        var candidates: [HirType] = [receiver.type_]
        if val remembered = self.find_local_hir_type(receiver_local.id):
            candidates.push(remembered)
        for candidate in candidates:
            if self.native_trait_owner_for_kind(candidate.kind) != layout.owner: continue
            match candidate.kind:
                case HirTypeKind.Named(_, args):
                    if position < args.len(): return Some(args[position])
                case _: ()
        None
