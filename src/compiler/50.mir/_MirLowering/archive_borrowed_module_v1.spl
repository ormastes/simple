# Actual borrowed HIR -> MIR mechanics. This is not final-stage admission:
# the driver must obtain this complete module from its genuine final reader.
use compiler.hir.hir_types.{HirModule, SymbolTable}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_symbol}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_instructions.{MirModule, MirFunction}
use compiler.mir.hir_declaration_summary_v1.*
# Explicit items: the summary module re-exports these through a nested
# 'export use ... .*' glob, which the Rust seed registry does not materialize
# one level up — the bare summary glob left MirHirDeclarationRepositoryV1 /
# MirHirModuleDeclarationsV1 unresolved here, so the annotated bindings below
# typed as ANY and 'declaration.globals[..].symbol' failed seed HIR with
# "struct 'ANY' field 'symbol'" (same visibility family as HirConst).
use compiler.mir.hir_declaration_types_v1.{MirHirDeclarationRepositoryV1, MirHirModuleDeclarationsV1, MirHirGlobalDeclarationV1}
use compiler.mir.hir_declaration_variant_identity_v1.{mir_hir_global_variant_identity_v1}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_data.{bootstrap_fn_param_defaults_detach_for_archive_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

# Exact complete-function selection. This carrier is mechanical evidence,
# never final admission: the driver must obtain its origin from issued e3.
struct MirArchiveFunctionEmissionV1:
    symbol: i64
    name: text
    complete_function_digest: text

impl MirLowering:
    me lower_archive_module_in_owned_scope_v1(module: HirModule,
            is_entry_module: bool, logical_key: text = "",
            selected_functions: [MirArchiveFunctionEmissionV1]? = nil,
            primary_logical_key: text = "", primary_globals: MirModule? = nil,
            primary_symbols: SymbolTable? = nil, symbol_baseline_key: text = "", primary_trait_thunks: [MirFunction] = []) -> Result<MirModule, text>:
        # Never acquire, pause, promote or close the caller's lease. A failure
        # leaves its lifecycle intact; the driver must discard failed output.
        if transient_array_scope_state_v1() != 1:
            return Err("borrowed MIR module requires an active unpaused scope")
        if self.declaration_repository == nil or self.ambient_bootstrap_enabled() or self.trait_impl_provider_modules.len() != 0:
            return Err("borrowed MIR module requires complete native declarations")
        if self.finally_stack.len() != 0 or self.lambda_bindings.len() != 0 or self.lambda_capture_snapshot.len() != 0:
            return Err("borrowed MIR module callable or finally scratch is occupied")
        val repository: MirHirDeclarationRepositoryV1 = self.declaration_repository.unwrap()
        val selected_key = if logical_key == "": module.name else: logical_key
        if not repository.modules.has(selected_key):
            return Err("borrowed MIR module has no exact declaration owner")
        val declaration: MirHirModuleDeclarationsV1 = repository.modules[selected_key]
        if declaration.final_repository_authority != repository.final_repository_authority or
                mir_hir_declaration_logical_key_v1(declaration) != selected_key or
                declaration.name != module.name or
                not mir_hir_module_declarations_valid_v1(declaration) or module.path != declaration.path:
            return Err("borrowed MIR module declaration identity differs")
        # Validate the actual retained complete graph, not a recomputed source
        # guess or a caller-supplied body hash. The reader's final admission is
        # separate and still required at the driver boundary.
        val blob = hir_module_encode(module)
        if blob == "" or sha256_text(blob) != declaration.final_body_digest:
            return Err("borrowed MIR module complete body differs")
        # A public declaration carrier can be edited and resealed. Bind its
        # actual headers/default selectors back to this selected complete
        # body before they drive ABI or provider lowering. Projection writers
        # and temporary descriptors remain inside the caller's scope.
        val actual = mir_hir_project_module_in_owned_scope_v1(repository.artifact_context,
            module, repository.final_repository_authority, declaration.final_archive_key,
            declaration.final_body_digest, declaration.source_binding)
        if actual.is_err(): return Err(actual.unwrap_err())
        if actual.unwrap().declaration_digest != declaration.declaration_digest:
            return Err("borrowed MIR declaration records differ from selected complete body")
        var selected_symbols: [i64]? = nil
        if val selections = selected_functions:
            if is_entry_module or primary_globals == nil or primary_symbols == nil or primary_logical_key == "" or
                    not repository.modules.has(primary_logical_key):
                return Err("selected archive functions require an actual primary emission owner")
            # Annotate: the bare binding inherits the dict value type through
            # the registry projection, which the bulk closure can degrade to
            # ANY; the explicit annotation pins the element type.
            val primary: MirHirModuleDeclarationsV1 = repository.modules[primary_logical_key]
            if not mir_hir_declarations_same_physical_source_v1(primary, declaration) or
                    primary.globals.len() != declaration.globals.len() or
                    primary.needs_initialization != declaration.needs_initialization:
                return Err("selected archive functions differ from primary storage owner")
            var global_idx = 0
            while global_idx < declaration.globals.len():
                # Bind each element to an explicitly annotated local BEFORE any
                # field read: in the bulk closure the for-in element type can
                # degrade to ANY through the registry projection, and
                # 'global.symbol' then fails seed HIR with "struct 'ANY' field
                # 'symbol'". The annotation pins the real element type.
                val global: MirHirGlobalDeclarationV1 = declaration.globals[global_idx]
                val global_bytes = mir_hir_global_variant_identity_v1(global)
                var matches = 0
                var own_idx = 0
                while own_idx < primary.globals.len():
                    val own_global: MirHirGlobalDeclarationV1 = primary.globals[own_idx]
                    if own_global.symbol.id == global.symbol.id and
                            mir_hir_global_variant_identity_v1(own_global) == global_bytes:
                        matches = matches + 1
                    own_idx = own_idx + 1
                if global_bytes == "" or matches != 1:
                    return Err("selected archive functions have conflicting global storage")
                global_idx = global_idx + 1
            var symbols: [i64] = []
            var seen: Dict<i64, bool> = {}
            var selection_idx = 0
            while selection_idx < selections.len():
                # Index + annotated element: for-in/values() element types can
                # arrive as ANY from the seed's aggregate typing, and an
                # annotation on an ANY-typed RHS is not authoritative there
                # ("seed aggregate typing not authoritative").
                val selection: MirArchiveFunctionEmissionV1 = selections[selection_idx]
                if seen.has(selection.symbol): return Err("selected archive function appears twice")
                seen[selection.symbol] = true
                var matches = 0
                for function_name in module.functions.keys():
                    val function: HirFunction = module.functions[function_name]
                    if function.symbol.id == selection.symbol and function.name == selection.name and
                            not function.is_generic_template and not function.is_extern and
                            mono_complete_function_digest_v1(function) == selection.complete_function_digest:
                        matches = matches + 1
                if selection.complete_function_digest == "" or matches != 1:
                    return Err("selected archive function differs from complete retained body")
                symbols.push(selection.symbol)
                selection_idx = selection_idx + 1
            # Reapply only actual MIR-added rows, after full selected-body
            # validation. Original mono rows keep this variant's exact types.
            # Actual prior allocation counter/scopes preserve generated-symbol
            # identity; no counter is inferred from names or function count.
            val baseline_key = if symbol_baseline_key == "": primary_logical_key else: symbol_baseline_key
            if not repository.modules.has(baseline_key) or
                    not mir_hir_declarations_same_physical_source_v1(primary, repository.modules[baseline_key]):
                return Err("selected archive function prior symbol baseline differs")
            val baseline = repository.modules[baseline_key]
            val previous: SymbolTable = primary_symbols.unwrap()
            for id in previous.symbols.keys():
                if not baseline.symbols.symbols.has(id):
                    val row = previous.symbols[id]
                    if module.symbols.symbols.has(id):
                        var old_writer = HirCodecWriter.create()
                        var new_writer = HirCodecWriter.create()
                        hc_enc_hir_symbol(old_writer, row)
                        hc_enc_hir_symbol(new_writer, module.symbols.symbols[id])
                        if not old_writer.ok or not new_writer.ok or old_writer.finish() != new_writer.finish():
                            return Err("selected archive function collides with prior MIR symbol ownership")
                    else:
                        module.symbols.register_preserved_symbol(row)
            for scope_id in previous.scopes.keys():
                if not baseline.symbols.scopes.has(scope_id):
                    if module.symbols.scopes.has(scope_id):
                        return Err("selected archive function collides with prior MIR scope ownership")
                    module.symbols.scopes[scope_id] = previous.scopes[scope_id]
            if module.symbols.next_symbol_id < previous.next_symbol_id:
                module.symbols.next_symbol_id = previous.next_symbol_id
            if module.symbols.next_scope_id < previous.next_scope_id:
                module.symbols.next_scope_id = previous.next_scope_id
            selected_symbols = Some(symbols)
        elif primary_globals != nil or primary_logical_key != "" or primary_symbols != nil or symbol_baseline_key != "" or primary_trait_thunks.len() != 0:
            return Err("primary storage supplied without selected archive functions")
        val no_body_providers: [HirModule] = []
        val output: MirModule = self.lower_module(module, no_body_providers, is_entry_module,
            selected_symbols, primary_globals, primary_trait_thunks)
        # Function emission has completed every nested default/capture consumer.
        # Keep actual MIR contracts/spans and all diagnostics/counters. Only
        # body-bearing compatibility/scratch roots are detached here.
        self.struct_field_default_expr = {}
        self.global_const_exprs = {}
        self.lambda_bindings = {}
        self.lambda_capture_snapshot = {}
        bootstrap_fn_param_defaults_detach_for_archive_v1()
        if self.finally_stack.len() != 0:
            return Err("borrowed MIR module left an unfinished finally scope")
        Ok(output)
