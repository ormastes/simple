# C1 resolver facts owned by one opt-in MIR lowering invocation.
# No name lookup can manufacture a callee identity. This table is populated
# from retained declarations in the same HIR symbol-table environment only.
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirSignature, MirConstValue, LocalId}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, mir_operand_copy}
use compiler.mir.mir_instruction_graph.{MirFunction}
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolKind}
use compiler.hir.hir_definitions.{HirFunction, HirParam}
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.mir.mir_json.{serialize_mir_type}
use compiler.mir.mir_verify.{mir_verify_type_unresolved_reason}
use compiler.mir.verification_call_manifest_finalizer.{ResolvedDirectCallCaptureV1}

fn verification_same_params_v1(left: [MirType], right: [MirType]) -> bool:
    if left.len() != right.len(): return false
    for index in 0..left.len():
        if serialize_mir_type(left[index]) != serialize_mir_type(right[index]):
            return false
    true

impl MirLowering:
    me verification_call_error_v1(message: text):
        if self.verification_capture_error == "":
            self.verification_capture_error = message

    me verification_prepare_calls_v1(module: HirModule):
        self.verification_call_declarations = {}
        self.verification_call_defaults = {}
        self.verification_default_frames = []
        self.verification_default_symbols = []
        self.verification_default_indices = []
        self.verification_default_depth = 0
        self.verification_call_captures = []
        self.verification_capture_error = ""
        for key in module.functions.keys():
            val function: HirFunction = module.functions[key]
            if function == nil or function.symbol == nil or key == nil:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: retained function identity is absent")
                return
            if key.id != function.symbol.id or function.symbol.id < 0:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: retained function key and SymbolId disagree")
                return
            if self.verification_call_declarations.contains(function.symbol.id):
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: duplicate retained function SymbolId")
                return
            if function.type_params.len() > 0:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-TEMPLATE: open generic declarations require specialization before verified lowering")
                return
            # Extern declarations never acquire an internal-body binding.
            if function.is_extern: continue
            val symbol = match module.symbols.get_symbol_raw(function.symbol.id):
                case Some(value): value
                case _:
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: retained declaration is absent from its symbol table")
                    return
            if symbol == nil or symbol.id == nil or symbol.id.id != function.symbol.id:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: declaration symbol identity is inconsistent")
                return
            match symbol.kind:
                case SymbolKind.Function: ()
                case _:
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: this producer requires a resolved function declaration")
                    return
            val declared: HirType = match symbol.type_:
                case Some(value): value
                case _:
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: resolved declaration signature is unavailable")
                    return
            if declared == nil or declared.kind == nil:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: resolved declaration signature is malformed")
                return
            match declared.kind:
                case HirTypeKind.Function(param_types, return_type, _):
                    if param_types.len() != function.params.len() or not hir_types_equal(return_type, function.return_type):
                        self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: retained declaration and resolved signature disagree")
                        return
                    for index in 0..param_types.len():
                        if not hir_types_equal(param_types[index], function.params[index].type_):
                            self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: ordered parameter types differ from the resolved declaration")
                            return
                case _:
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: resolved symbol does not retain a function signature")
                    return
            var params: [MirType] = []
            for param in function.params:
                val type_ = self.lower_type(param.type_)
                if mir_verify_type_unresolved_reason(type_, 0) != "":
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: unresolved parameter type")
                    return
                params.push(type_)
            val result = self.lower_type(function.return_type)
            if mir_verify_type_unresolved_reason(result, 0) != "":
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: unresolved return type")
                return
            # Same constructor/metadata as lower_function's definition signature.
            self.verification_call_declarations[function.symbol.id] = MirSignature(
                params: params, return_type: result, is_variadic: false)
            # Retain actual same-environment defaults by selected SymbolId.
            # The ordinary body-structure scan does NOT prepare these rows.
            var defaults: [HirParam] = []
            for param in function.params:
                defaults.push(HirParam(symbol: param.symbol, name: param.name,
                    type_: param.type_, has_default: param.has_default,
                    default: param.default, span: param.span,
                    is_mutable: param.is_mutable))
            self.verification_call_defaults[function.symbol.id] = defaults

    me verification_default_local_v1(operand: MirOperand) -> LocalId:
        match operand.kind:
            case MirOperandKind.Copy(local) | MirOperandKind.Move(local): local
            case MirOperandKind.Const(value, type_):
                var builder = self.builder
                val local = builder.new_temp(type_)
                builder.emit_const(local, value, type_)
                self.builder = builder
                local

    me verification_pad_default_args_v1(symbol: SymbolId?,
        supplied: [MirOperand]) -> [MirOperand]:
        if self.verification_capture_error != "": return supplied
        val selected: SymbolId = match symbol:
            case Some(value): value
            case _:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-BOUNDARY: default preparation requires the selected declaration SymbolId")
                return supplied
        if selected == nil or not self.verification_call_defaults.contains(selected.id):
            self.verification_call_error_v1("FV2-E-CALL-SOURCE-BOUNDARY: no invocation-owned default declaration for callee")
            return supplied
        val params: [HirParam] = self.verification_call_defaults[selected.id]
        if supplied.len() >= params.len(): return supplied
        # Preflight every omitted slot before evaluating any default expression.
        for index in supplied.len()..params.len():
            if not params[index].has_default or params[index].default == nil:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-DEFAULT: omitted argument has no retained default expression")
                return supplied
        val frame_index = self.verification_default_depth
        if frame_index >= 128:
            self.verification_call_error_v1("FV2-E-CALL-SOURCE-DEFAULT-DEPTH: retained default expansion exceeds 128 active frames")
            return supplied
        var bindings: Dict<i64, LocalId> = {}
        for param in params:
            if param.symbol == nil or param.symbol.id < 0 or bindings.contains(param.symbol.id):
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-DEFAULT: retained parameter identities are absent or duplicated")
                return supplied
            # Shadow later parameters even in a recursive source function.
            bindings[param.symbol.id] = LocalId(id: -1)
        for index in 0..supplied.len():
            bindings[params[index].symbol.id] = self.verification_default_local_v1(supplied[index])
        if frame_index == self.verification_default_frames.len():
            self.verification_default_frames.push(bindings)
            self.verification_default_symbols.push(selected.id)
            self.verification_default_indices.push(-1)
        else:
            self.verification_default_frames[frame_index] = bindings
            self.verification_default_symbols[frame_index] = selected.id
            self.verification_default_indices[frame_index] = -1
        self.verification_default_depth = frame_index + 1
        # New output array: supplied operands retain order and evaluation count.
        var result: [MirOperand] = []
        for operand in supplied: result.push(operand)
        var index = supplied.len()
        while index < params.len():
            var parent_index = 0
            while parent_index < frame_index:
                if (self.verification_default_symbols[parent_index] == selected.id and
                        self.verification_default_indices[parent_index] == index):
                    self.verification_call_error_v1("FV2-E-CALL-SOURCE-DEFAULT-CYCLE: repeated active declaration/default position")
                    break
                parent_index = parent_index + 1
            if self.verification_capture_error != "": break
            self.verification_default_indices[frame_index] = index
            val param: HirParam = params[index]
            val local = self.lower_expr_for_slot(param.default, param.type_)
            self.verification_default_indices[frame_index] = -1
            if self.verification_capture_error != "": break
            result.push(mir_operand_copy(local))
            var current = self.verification_default_frames[frame_index]
            current[param.symbol.id] = local
            self.verification_default_frames[frame_index] = current
            index = index + 1
        # Clear on both success and refusal. Parent frames are independent maps;
        # no global save/reset or mutation of borrowed HIR expressions occurs.
        self.verification_default_depth = frame_index
        self.verification_default_frames[frame_index] = {}
        self.verification_default_symbols[frame_index] = -1
        self.verification_default_indices[frame_index] = -1
        if self.verification_capture_error != "": return supplied
        result

    me verification_call_operand_v1(operand: MirOperand, symbol: SymbolId?,
        argument_count: i64) -> MirOperand:
        if self.verification_capture_error != "": return operand
        val selected: SymbolId = match symbol:
            case Some(value): value
            case _:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-BOUNDARY: direct call lacks a resolver-selected declaration")
                return operand
        if selected == nil or not self.verification_call_declarations.contains(selected.id):
            self.verification_call_error_v1("FV2-E-CALL-SOURCE-BOUNDARY: callee has no retained internal declaration in this source environment")
            return operand
        val expected = self.verification_call_declarations[selected.id]
        if expected.params.len() != argument_count:
            self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: emitted argument count differs from the retained declaration")
            return operand
        match operand.kind:
            case MirOperandKind.Const(MirConstValue.Str(name), type_):
                match type_.kind:
                    case MirTypeKind.FuncPtr(signature):
                        if (signature.is_variadic or
                                serialize_mir_type(signature.return_type) != serialize_mir_type(expected.return_type) or
                                ((signature.params_known or signature.params.len() > 0) and
                                    not verification_same_params_v1(signature.params, expected.params)) or
                                (signature.declared_params_known and
                                    not verification_same_params_v1(signature.declared_params, expected.params)) or
                                (expected.params.len() > 0 and not signature.params_known and
                                    signature.params.len() == 0 and not signature.declared_params_known)):
                            self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: emitted call signature differs from the retained declaration")
                            return operand
                        # Normalize the legacy unknown-params representation only
                        # after checking its actual declared_params and source ID.
                        return MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
                            MirType(kind: MirTypeKind.FuncPtr(expected))))
                    case _: ()
            case _: ()
        self.verification_call_error_v1("FV2-E-CALL-SOURCE-SIGNATURE: emitted direct call has no typed function operand")
        operand

    me verification_capture_site_v1(symbol: SymbolId?):
        if self.verification_capture_error != "": return
        val selected: SymbolId = match symbol:
            case Some(value): value
            case _:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-BOUNDARY: missing resolved callee")
                return
        val owner: MirFunction = match self.builder.current_function:
            case Some(value): value
            case _:
                self.verification_call_error_v1("FV2-E-CALL-SOURCE-OWNER: call emitted outside a function")
                return
        # Called immediately before builder.emit, after nested/default arguments.
        self.verification_call_captures.push(ResolvedDirectCallCaptureV1(
            owner.symbol.id.to_string(), self.builder.current_block.id,
            self.builder.instructions.len(), selected.id.to_string()))
