# Direct frozen-HIR statement and block emission.  This lane deliberately
# consumes only scalar registry columns; no HirStmt, HirBlock, or BlockValue is
# reconstructed at the MIR boundary.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_block_values.*
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir._MirLowering.hir_destination_types.*

fn mir_destination_span(r: MirDestinationFunctionReceipt, row: i64) -> Span:
    Span(start: hdr_span_start(r.slot, r.generation, row),
        end: hdr_span_end(r.slot, r.generation, row),
        line: hdr_span_line(r.slot, r.generation, row),
        col: hdr_span_col(r.slot, r.generation, row),
        file: hdr_span_file(r.slot, r.generation, row),
        length: hdr_span_length(r.slot, r.generation, row))

fn mir_destination_assign_op(shape: i64) -> MirBinOp:
    # Wire 0 is plain assignment; compound operators begin at one.
    if shape == 1: return MirBinOp.Add
    if shape == 2: return MirBinOp.Sub
    if shape == 3: return MirBinOp.Mul
    if shape == 4: return MirBinOp.Div
    if shape == 5: return MirBinOp.Rem
    if shape == 6: return MirBinOp.BitAnd
    if shape == 7: return MirBinOp.BitOr
    if shape == 8: return MirBinOp.BitXor
    if shape == 9: return MirBinOp.Shl
    MirBinOp.Shr

fn mir_destination_integer_type(type_: MirType?) -> bool:
    if not type_.?: return false
    val exact = type_ ?? MirType.unit()
    match exact.kind:
        case I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64: true
        case _: false

impl MirLowering:
    me destination_assignment_field_ordinal(r: MirDestinationFunctionReceipt,
            target_row: i64) -> i64:
        val shape = hdr_expr_shape(r.slot, r.generation, target_row)
        if shape != HD_EXPR_FIELD and shape != HD_EXPR_RESOLVED_FIELD: return -1
        if shape == HD_EXPR_FIELD and not hdr_expr_bool(r.slot, r.generation,
                target_row, 0): return -1
        val module_row = if shape == HD_EXPR_RESOLVED_FIELD:
            hdr_expr_i64(r.slot, r.generation, target_row, 2)
        else: r.module_index
        val field_symbol = hdr_expr_i64(r.slot, r.generation, target_row, 1)
        val symbol_row = hdr_destination_symbol_lookup_in_module(r.slot,
            r.generation, module_row, field_symbol)
        val owner = hdr_destination_symbol_owner(r.slot, r.generation, symbol_row)
        val member = hdr_destination_member_lookup_name(r.slot, r.generation,
            module_row, owner, hdr_expr_text(r.slot, r.generation, target_row, 0))
        hdr_destination_member_ordinal(r.slot, r.generation, member)

    me lower_destination_block(r: MirDestinationFunctionReceipt, block_row: i64,
            expected_type: MirType?) -> LocalId?:
        val previous_span = self.builder.current_span
        val stmt_range = hdr_block_stmt_range(r.slot, r.generation, block_row)
        val stmt_count = hdr_range_length(r.slot, r.generation, stmt_range)
        val stmt_subtype = hdr_range_subtype(r.slot, r.generation, stmt_range)
        var offset = 0
        while offset < stmt_count:
            val stmt_row = hdr_range_value(r.slot, r.generation, stmt_range,
                stmt_subtype, offset)
            val saved_span = self.builder.current_span
            self.lower_destination_stmt_row(r, stmt_row)
            var restored_builder = self.builder
            restored_builder.current_span = saved_span
            self.builder = restored_builder
            offset = offset + 1
        val value_row = hdr_block_value(r.slot, r.generation, block_row)
        var result: LocalId? = nil
        if value_row >= 0:
            var tail_builder = self.builder
            tail_builder.current_span = Some(mir_destination_span(r,
                hdr_block_span(r.slot, r.generation, block_row)))
            self.builder = tail_builder
            # HirDestinationGraph.finalize_block validates this as an EXPR
            # row. BlockValue rows are payloads of HD_EXPR_CUSTOM_BLOCK only.
            result = self.mir_destination_lower_expr_row(r, value_row, expected_type)
        var restore_builder = self.builder
        restore_builder.current_span = previous_span
        self.builder = restore_builder
        result

    me lower_destination_root_block(r: MirDestinationFunctionReceipt,
            expected_type: MirType) -> LocalId?:
        self.lower_destination_block(r, r.root_block, Some(expected_type))

    me lower_destination_stmt_row(r: MirDestinationFunctionReceipt, row: i64):
        # Shape and span are hoisted once; payload columns are read only in the
        # selected arm.  Every range loop caches kind/subtype/count, keeping the
        # complete walk O(number of frozen rows).
        val shape = hdr_stmt_shape(r.slot, r.generation, row)
        val span = mir_destination_span(r, hdr_stmt_span(r.slot, r.generation, row))
        var statement_builder = self.builder
        statement_builder.current_span = Some(span)
        self.builder = statement_builder
        if shape == HD_STMT_EXPR:
            self.mir_destination_lower_expr_row(r,
                hdr_stmt_i64(r.slot, r.generation, row, 0), nil)
            return
        if shape == HD_STMT_LET:
            val symbol = hdr_stmt_i64(r.slot, r.generation, row, 0)
            val declared_type = self.destination_checked_type(r,
                hdr_stmt_i64(r.slot, r.generation, row, 1), "local declaration")
            val init_row = hdr_stmt_i64(r.slot, r.generation, row, 2)
            if hdr_expr_shape(r.slot, r.generation, init_row) == HD_EXPR_LAMBDA:
                val marker = self.register_destination_lambda_binding(r,
                    symbol, init_row, declared_type)
                self.bind_local(symbol, marker)
                return
            val init = self.mir_destination_lower_expr_row(r, init_row, Some(declared_type))
            var let_builder = self.builder
            val local = let_builder.new_local(nil, declared_type, LocalKind.Var)
            let_builder.emit_copy(local, init)
            self.builder = let_builder
            self.bind_local(symbol, local)
            return
        if shape == HD_STMT_ASSIGN:
            val target_row = hdr_stmt_i64(r.slot, r.generation, row, 0)
            val target_shape = hdr_expr_shape(r.slot, r.generation, target_row)
            val op_shape = hdr_stmt_i64(r.slot, r.generation, row, 1)
            if target_shape == HD_EXPR_FIELD or target_shape == HD_EXPR_RESOLVED_FIELD:
                val ordinal = self.destination_assignment_field_ordinal(r, target_row)
                if ordinal < 0:
                    self.error_fatal("direct destination field assignment lacks member authority", Some(span)); return
                val base = self.mir_destination_lower_expr_row(r,
                    hdr_expr_i64(r.slot, r.generation, target_row, 0), nil)
                val value = self.mir_destination_lower_expr_row(r,
                    hdr_stmt_i64(r.slot, r.generation, row, 2), nil)
                var field_value = value
                var field_builder = self.builder
                if op_shape > 0:
                    val value_type = self.local_mir_type_of(value) ?? MirType.i64()
                    val current = field_builder.emit_get_field(mir_operand_copy(base), ordinal, value_type)
                    field_value = field_builder.emit_binop(mir_destination_assign_op(op_shape),
                        mir_operand_copy(current), mir_operand_copy(value), value_type)
                field_builder.emit_set_field(mir_operand_copy(base), ordinal,
                    mir_operand_copy(field_value))
                self.builder = field_builder
                return
            if target_shape == HD_EXPR_INDEX:
                val base_row = hdr_expr_i64(r.slot, r.generation, target_row, 0)
                val base = self.mir_destination_lower_expr_row(r, base_row, nil)
                val base_type_row = hdr_expr_type(r.slot, r.generation, base_row)
                val base_type_shape = if base_type_row >= 0:
                    hdr_type_shape(r.slot, r.generation, base_type_row)
                else: 0
                val runtime_dict = base_type_shape == HD_TYPE_DICT or
                    self.runtime_dict_locals.contains(base.id)
                val runtime_array = base_type_shape == HD_TYPE_ARRAY or
                    self.runtime_array_locals.contains(base.id)
                val index_raw = self.mir_destination_lower_expr_row(r,
                    hdr_expr_i64(r.slot, r.generation, target_row, 1),
                    if runtime_array: Some(MirType.i64()) else: nil)
                val index = if runtime_dict:
                    self.box_runtime_value(index_raw)
                else: index_raw
                val value = self.mir_destination_lower_expr_row(r,
                    hdr_stmt_i64(r.slot, r.generation, row, 2), nil)
                val value_type = self.local_mir_type_of(value) ?? MirType.i64()
                if runtime_array or runtime_dict:
                    val get_name = if runtime_dict:
                        "rt_dict_get"
                    else: "rt_array_get"
                    val set_name = if runtime_dict:
                        "rt_dict_set"
                    else: "rt_array_set"
                    var stored = value
                    if op_shape > 0:
                        val get_params = if runtime_dict:
                            [MirType.i64(), MirType.i64()]
                        else: [MirType.ptr(value_type, false), MirType.i64()]
                        val get_fn = MirOperand(kind: MirOperandKind.Const(
                            MirConstValue.Str(get_name), MirType(kind: MirTypeKind.FuncPtr(
                                MirSignature(params: get_params,
                                    return_type: MirType.i64(), is_variadic: false)))))
                        var runtime_builder = self.builder
                        val raw_current = runtime_builder.emit_call(get_fn,
                            [mir_operand_copy(base), mir_operand_copy(index)], MirType.i64())
                        self.builder = runtime_builder
                        if not raw_current.?:
                            self.error_fatal("runtime container get produced no local", Some(span)); return
                        val current = self.decode_runtime_value(
                            raw_current ?? LocalId(id: -1), value_type)
                        runtime_builder = self.builder
                        stored = runtime_builder.emit_binop(mir_destination_assign_op(op_shape),
                            mir_operand_copy(current), mir_operand_copy(value), value_type)
                        self.builder = runtime_builder
                    val boxed = self.box_runtime_value(stored)
                    val set_params = if runtime_dict:
                        [MirType.i64(), MirType.i64(), MirType.i64()]
                    else: [MirType.ptr(MirType.i64(), false), MirType.i64(), MirType.i64()]
                    val set_fn = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str(set_name), MirType(kind: MirTypeKind.FuncPtr(
                            MirSignature(params: set_params,
                                return_type: MirType.unit(), is_variadic: false)))))
                    var runtime_builder = self.builder
                    runtime_builder.emit_call(set_fn, [mir_operand_copy(base),
                        mir_operand_copy(index), mir_operand_copy(boxed)], MirType.unit())
                    self.builder = runtime_builder
                    return
                # Only pointer/ref authority permits a native GEP store. A
                # missing scalar type receipt must never guess this path.
                val base_mir_type = self.local_mir_type_of(base)
                var native_pointer = false
                if val exact_base_type = base_mir_type:
                    match exact_base_type.kind:
                        case MirTypeKind.Ptr(_, mutable) | MirTypeKind.Ref(_, mutable):
                            native_pointer = mutable
                        case _: ()
                if not native_pointer:
                    self.error_fatal("index assignment lacks dynamic-container or mutable-pointer authority", Some(span)); return
                var index_builder = self.builder
                val pointer = index_builder.emit_gep(mir_operand_copy(base),
                    [mir_operand_copy(index)], MirType.ptr(value_type, true))
                var stored = value
                if op_shape > 0:
                    val current = index_builder.emit_load(mir_operand_copy(pointer), value_type)
                    stored = index_builder.emit_binop(mir_destination_assign_op(op_shape),
                        mir_operand_copy(current), mir_operand_copy(value), value_type)
                index_builder.emit_store(mir_operand_copy(pointer), mir_operand_copy(stored))
                self.builder = index_builder
                return
            if (target_shape != HD_EXPR_VAR and target_shape != HD_EXPR_NAMED_VAR and
                    target_shape != HD_EXPR_QUALIFIED_NAMED_VAR):
                self.error_fatal("direct destination assignment target shape is unsupported", Some(span)); return
            val symbol = hdr_expr_i64(r.slot, r.generation, target_row, 0)
            val target = self.find_local(symbol)
            if target.id < 0:
                val module_row = if target_shape == HD_EXPR_QUALIFIED_NAMED_VAR:
                    hdr_expr_i64(r.slot, r.generation, target_row, 1)
                else: r.module_index
                val symbol_row = hdr_destination_symbol_lookup_in_module(r.slot,
                    r.generation, module_row, symbol)
                if symbol_row < 0 or not hdr_destination_symbol_mutable(r.slot,
                        r.generation, symbol_row):
                    self.error_fatal("direct destination global assignment lacks mutable authority", Some(span)); return
                if not hdr_destination_symbol_has_type(r.slot, r.generation, symbol_row):
                    self.error_fatal("direct destination global assignment lacks type authority", Some(span)); return
                val global_type = self.destination_checked_type(r,
                    hdr_destination_symbol_type(r.slot, r.generation, symbol_row),
                    "global assignment")
                val value = self.mir_destination_lower_expr_row(r,
                    hdr_stmt_i64(r.slot, r.generation, row, 2), Some(global_type))
                var global_builder = self.builder
                var stored = value
                if op_shape > 0:
                    val current = global_builder.new_temp(global_type)
                    global_builder.emit(MirInst(kind: MirInstKind.LoadGlobal(current,
                        SymbolId(id: symbol)), span: Some(span)))
                    stored = global_builder.emit_binop(mir_destination_assign_op(op_shape),
                        mir_operand_copy(current), mir_operand_copy(value), global_type)
                global_builder.emit(MirInst(kind: MirInstKind.StoreGlobal(SymbolId(id: symbol),
                    mir_operand_copy(stored)), span: Some(span)))
                self.builder = global_builder
                return
            val value = self.mir_destination_lower_expr_row(r,
                hdr_stmt_i64(r.slot, r.generation, row, 2), self.local_mir_type_of(target))
            var assign_builder = self.builder
            if op_shape > 0:
                val result = assign_builder.emit_binop(mir_destination_assign_op(op_shape),
                    mir_operand_copy(target), mir_operand_copy(value),
                    self.local_mir_type_of(target) ?? MirType.i64())
                assign_builder.emit_copy(target, result)
            else:
                assign_builder.emit_copy(target, value)
            self.builder = assign_builder
            return
        if shape == HD_STMT_BLOCK:
            self.lower_destination_block(r,
                hdr_stmt_i64(r.slot, r.generation, row, 0), nil)
            return
        if shape == HD_STMT_ASM_ASSERT:
            self.lower_destination_asm_assert(r,
                hdr_stmt_i64(r.slot, r.generation, row, 0), span)
            return
        if shape == HD_STMT_SHARED_VAL or shape == HD_STMT_SHARED_VAR:
            self.lower_destination_shared(r, row, shape == HD_STMT_SHARED_VAR, span)
            return
        if shape == HD_STMT_GPU_LAUNCH:
            self.lower_destination_gpu_launch(r, row, span)
            return
        self.error_fatal("unsupported frozen HIR statement shape {shape}", Some(span))

    me lower_destination_shared(r: MirDestinationFunctionReceipt, row: i64,
            mutable_binding: bool, span: Span):
        val symbol = hdr_stmt_i64(r.slot, r.generation, row, 0)
        val type_row = hdr_stmt_i64(r.slot, r.generation, row, 1)
        val declared_type = self.destination_checked_type(r, type_row,
            "shared declaration")
        var element_type = declared_type
        var element_count = 1
        if hdr_type_shape(r.slot, r.generation, type_row) == HD_TYPE_ARRAY:
            element_type = self.destination_checked_type(r,
                hdr_type_i64(r.slot, r.generation, type_row, 0),
                "shared array element")
            if hdr_type_bool(r.slot, r.generation, type_row, 0):
                element_count = hdr_type_i64(r.slot, r.generation, type_row, 1)
            else:
                self.error_fatal("GPU shared array requires a fixed compile-time size", Some(span))
                return
        if element_count <= 0:
            self.error_fatal("GPU shared allocation requires a positive fixed size", Some(span))
            return
        val has_init = hdr_stmt_bool(r.slot, r.generation, row, 0)
        var shared_builder = self.builder
        val local = shared_builder.new_local(nil,
            MirType.ptr(element_type, mutable_binding), LocalKind.Var)
        self.builder = shared_builder
        if has_init:
            if element_count != 1:
                self.error_fatal("GPU shared array initialization requires indexed stores", Some(span))
                return
            val init = self.mir_destination_lower_expr_row(r,
                hdr_stmt_i64(r.slot, r.generation, row, 2), Some(element_type))
            shared_builder = self.builder
            shared_builder.emit(MirInst(kind: MirInstKind.GpuSharedAllocInit(local,
                element_type, element_count, mir_operand_copy(init)), span: Some(span)))
        else:
            shared_builder.emit(MirInst(kind: MirInstKind.GpuSharedAlloc(local,
                element_type, element_count), span: Some(span)))
        self.builder = shared_builder
        self.bind_local(symbol, local)

    me lower_destination_gpu_launch(r: MirDestinationFunctionReceipt, row: i64,
            span: Span):
        val config_span = mir_destination_span(r,
            hdr_stmt_i64(r.slot, r.generation, row, 5))
        var grid: [MirOperand] = []
        val grid_range = hdr_stmt_i64(r.slot, r.generation, row, 0)
        val grid_count = hdr_stmt_i64(r.slot, r.generation, row, 1)
        val grid_subtype = hdr_range_subtype(r.slot, r.generation, grid_range)
        var i = 0
        while i < grid_count:
            val expr_row = hdr_range_value(r.slot, r.generation, grid_range, grid_subtype, i)
            val local = self.mir_destination_lower_expr_row(r, expr_row, nil)
            if not mir_destination_integer_type(self.local_mir_type_of(local)):
                self.error_fatal("GPU launch grid dimensions must have integer MIR types", Some(config_span)); return
            grid.push(mir_operand_copy(local)); i = i + 1
        var block: [MirOperand] = []
        val block_range = hdr_stmt_i64(r.slot, r.generation, row, 2)
        val block_count = hdr_stmt_i64(r.slot, r.generation, row, 3)
        val block_subtype = hdr_range_subtype(r.slot, r.generation, block_range)
        i = 0
        while i < block_count:
            val expr_row = hdr_range_value(r.slot, r.generation, block_range, block_subtype, i)
            val local = self.mir_destination_lower_expr_row(r, expr_row, nil)
            if not mir_destination_integer_type(self.local_mir_type_of(local)):
                self.error_fatal("GPU launch block dimensions must have integer MIR types", Some(config_span)); return
            block.push(mir_operand_copy(local)); i = i + 1
        var launch_builder = self.builder
        val body_id = launch_builder.new_block(Some("gpu_launch_body"))
        val continuation = launch_builder.new_block(Some("gpu_launch_cont"))
        launch_builder.emit(MirInst(kind: MirInstKind.GpuLaunchConfigured(grid, block, body_id), span: Some(span)))
        launch_builder.terminate_goto(continuation)
        launch_builder.switch_to_block(body_id)
        self.builder = launch_builder
        self.lower_destination_block(r, hdr_stmt_i64(r.slot, r.generation, row, 4), nil)
        launch_builder = self.builder
        if not launch_builder.current_block_has_explicit_terminator():
            launch_builder.terminate_goto(continuation)
        launch_builder.switch_to_block(continuation)
        self.builder = launch_builder

    me lower_destination_asm_assert(r: MirDestinationFunctionReceipt,
            spec: i64, span: Span):
        val arch_range = hdr_aux_i64(r.slot, r.generation, spec, 0)
        val arch_count = hdr_aux_i64(r.slot, r.generation, spec, 1)
        val subtype = hdr_range_subtype(r.slot, r.generation, arch_range)
        var archs: [text] = []
        var i = 0
        while i < arch_count:
            val text_row = hdr_range_value(r.slot, r.generation, arch_range, subtype, i)
            archs.push(hdr_aux_text(r.slot, r.generation, text_row, 0))
            i = i + 1
        val os_row = hdr_aux_i64(r.slot, r.generation, spec, 2)
        val abi_row = hdr_aux_i64(r.slot, r.generation, spec, 3)
        val backend_row = hdr_aux_i64(r.slot, r.generation, spec, 4)
        val version_range = hdr_aux_range(r.slot, r.generation, spec)
        val version_count = hdr_range_length(r.slot, r.generation, version_range)
        val version_subtype = hdr_range_subtype(r.slot, r.generation, version_range)
        var version_ops: [text] = []
        var version_values: [i64] = []
        i = 0
        while i < version_count:
            val version_row = hdr_range_value(r.slot, r.generation,
                version_range, version_subtype, i)
            version_ops.push(hdr_aux_text(r.slot, r.generation, version_row, 0))
            version_values.push(hdr_aux_i64(r.slot, r.generation, version_row, 0))
            i = i + 1
        val result = self.asm_target_spec_match_kind(
            archs,
            os_row >= 0, if os_row >= 0: hdr_aux_text(r.slot, r.generation, os_row, 0) else: "",
            abi_row >= 0, if abi_row >= 0: hdr_aux_text(r.slot, r.generation, abi_row, 0) else: "",
            backend_row >= 0, if backend_row >= 0: hdr_aux_text(r.slot, r.generation, backend_row, 0) else: "",
            version_ops, version_values,
            self.get_target_arch(), self.get_target_os(), self.get_target_abi(),
            self.get_target_backend(), self.get_target_backend_version())
        if result == "unknown_version":
            self.error("cannot evaluate asm target backend version: " +
                self.get_target_backend() + " version is unavailable", Some(span))
        elif result == "not_matched":
            self.error("asm assert failed for current target", Some(span))
        elif result == "note":
            self.error("note: target backend differs from recommended version", Some(span))

export mir_destination_span
