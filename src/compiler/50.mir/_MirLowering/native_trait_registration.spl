use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_lowering_stmts.*
use compiler.mir.native_trait_metadata.*
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*

fn native_trait_qualified_owner(symbol: HirSymbol) -> text:
    val module_name = mir_layout_canonical_module_name(symbol.defining_module ?? "")
    if module_name == "": return ""
    "{module_name}::{symbol.name}"

impl MirLowering:
    fn native_trait_signature_type_key(type_: HirType) -> text:
        match type_.kind:
            case HirTypeKind.Int(bits, signed): "int:{bits}:{signed}"
            case HirTypeKind.Float(bits): "float:{bits}"
            case HirTypeKind.Bool: "bool"
            case HirTypeKind.Char: "char"
            case HirTypeKind.Str: "text"
            case HirTypeKind.Unit: "unit"
            case HirTypeKind.Tuple(elements):
                var key = "tuple"
                for element in elements:
                    val child = self.native_trait_signature_type_key(element)
                    if child == "": return ""
                    key = key + "[" + child + "]"
                key
            case HirTypeKind.Slice(inner):
                val child = self.native_trait_signature_type_key(inner)
                if child == "": "" else: "slice[" + child + "]"
            case HirTypeKind.Dict(key_type, value_type):
                val key = self.native_trait_signature_type_key(key_type)
                val value = self.native_trait_signature_type_key(value_type)
                if key == "" or value == "": "" else: "dict[" + key + "][" + value + "]"
            case HirTypeKind.DynTrait(id):
                val owner = self.native_trait_owner_for_type(type_)
                if owner == "": "" else: "named:" + owner
            case HirTypeKind.Named(id, args):
                val symbol = self.symbols.get_symbol_raw(id.id)
                if symbol == nil: return ""
                val owner = native_trait_qualified_owner(symbol)
                if owner == "": return ""
                var key = "named:" + owner
                for arg in args:
                    val child = self.native_trait_signature_type_key(arg)
                    if child == "": return ""
                    key = key + "[" + child + "]"
                key
            case HirTypeKind.Optional(inner):
                val child = self.native_trait_signature_type_key(inner)
                if child == "": "" else: "optional[" + child + "]"
            case HirTypeKind.Result(ok, err):
                val left = self.native_trait_signature_type_key(ok)
                val right = self.native_trait_signature_type_key(err)
                if left == "" or right == "": "" else: "result[" + left + "][" + right + "]"
            case HirTypeKind.Array(inner, size):
                val child = self.native_trait_signature_type_key(inner)
                if child == "": "" else: "array[{size}][" + child + "]"
            case HirTypeKind.Ptr(inner, mutable):
                val child = self.native_trait_signature_type_key(inner)
                if child == "": "" else: "pointer:{mutable}[" + child + "]"
            case HirTypeKind.Ref(inner, mutable):
                val child = self.native_trait_signature_type_key(inner)
                if child == "": "" else: "reference:{mutable}[" + child + "]"
            case _: ""

    fn native_trait_implementation_admitted(layout: NativeTraitLayout,
            implementation: NativeTraitImplementation) -> bool:
        self.native_trait_implementation_rejection(layout, implementation) == ""

    fn native_trait_implementation_rejection(layout: NativeTraitLayout,
            implementation: NativeTraitImplementation) -> text:
        # Same fail-closed admission predicates, with the first exact boundary
        # retained for bounded native diagnosis instead of an opaque false.
        if not layout.object_safe: return "trait declaration is not object-safe"
        if implementation.methods.len() != layout.methods.len(): return "implementation method count mismatch"
        if implementation.signatures.len() != layout.methods.len(): return "implementation signature count mismatch"
        if self.mir_hir_type_is_resource_direct(implementation.concrete_type): return "concrete resource requires a drop slot"
        var index = 0
        while index < layout.methods.len():
            val slot = layout.methods[index]
            val concrete = implementation.signatures[index]
            val method = slot.name
            if implementation.methods[index] == "": return "method {method}: missing implementation callable"
            if slot.params.len() == 0: return "method {method}: missing declared receiver"
            if slot.params.len() != concrete.params.len(): return "method {method}: parameter count expected={slot.params.len()} actual={concrete.params.len()}"
            if slot.mutable_receiver != concrete.mutable_receiver: return "method {method}: receiver mutability expected={slot.mutable_receiver} actual={concrete.mutable_receiver}"
            if slot.parameter_mutability.len() != slot.params.len(): return "method {method}: incomplete declaration parameter mutability"
            if concrete.parameter_mutability.len() != concrete.params.len(): return "method {method}: incomplete implementation parameter mutability"
            if self.mir_hir_type_is_resource_direct(slot.result): return "method {method}: declaration resource return requires a drop slot"
            if self.mir_hir_type_is_resource_direct(concrete.result): return "method {method}: implementation resource return requires a drop slot"
            val receiver_owner = self.native_trait_owner_for_type(slot.params[0])
            if receiver_owner != layout.owner: return "method {method}: trait receiver expected={layout.owner} actual={receiver_owner}"
            val concrete_receiver = self.native_trait_signature_type_key(concrete.params[0])
            val expected_receiver = self.native_trait_signature_type_key(implementation.concrete_type)
            if concrete_receiver != expected_receiver: return "method {method}: concrete receiver expected={expected_receiver} actual={concrete_receiver}"
            val result_key = self.native_trait_signature_type_key(slot.result)
            val concrete_result = self.native_trait_signature_type_key(concrete.result)
            if result_key == "": return "method {method}: unsupported declaration return type"
            if result_key != concrete_result: return "method {method}: return type expected={result_key} actual={concrete_result}"
            var argument = 1
            while argument < slot.params.len():
                if self.mir_hir_type_is_resource_direct(slot.params[argument]): return "method {method} parameter {argument}: declaration resource requires a drop slot"
                if self.mir_hir_type_is_resource_direct(concrete.params[argument]): return "method {method} parameter {argument}: implementation resource requires a drop slot"
                if slot.parameter_mutability[argument] != concrete.parameter_mutability[argument]: return "method {method} parameter {argument}: mutability mismatch"
                val key = self.native_trait_signature_type_key(slot.params[argument])
                val concrete_key = self.native_trait_signature_type_key(concrete.params[argument])
                if key == "": return "method {method} parameter {argument}: unsupported declaration type"
                if key != concrete_key: return "method {method} parameter {argument}: type expected={key} actual={concrete_key}"
                argument = argument + 1
            index = index + 1
        ""

    fn native_trait_layout_index(owner: text) -> i64:
        var index = 0
        while index < self.native_trait_layouts.len():
            if self.native_trait_layouts[index].owner == owner: return index
            index = index + 1
        -1

    fn native_trait_layout_matches(left: NativeTraitLayout, right: NativeTraitLayout) -> bool:
        if left.owner != right.owner or left.object_safe != right.object_safe or left.methods.len() != right.methods.len(): return false
        var index = 0
        while index < left.methods.len():
            val a = left.methods[index]
            val b = right.methods[index]
            if a.name != b.name or a.mutable_receiver != b.mutable_receiver or a.params.len() != b.params.len(): return false
            if self.native_trait_signature_type_key(a.result) != self.native_trait_signature_type_key(b.result): return false
            var param = 0
            while param < a.params.len():
                if a.parameter_names[param] != b.parameter_names[param]: return false
                if a.parameter_mutability[param] != b.parameter_mutability[param]: return false
                if self.native_trait_signature_type_key(a.params[param]) != self.native_trait_signature_type_key(b.params[param]): return false
                param = param + 1
            index = index + 1
        true

    fn native_trait_owner_for_type(type_: HirType) -> text:
        val symbol_id = match type_.kind:
            case HirTypeKind.Named(id, _) | HirTypeKind.DynTrait(id): id
            case _: return ""
        val symbol = self.symbols.get_symbol_raw(symbol_id.id)
        if symbol == nil or symbol.kind != SymbolKind.Trait: return ""
        native_trait_qualified_owner(symbol)

    fn native_trait_value_type(type_: HirType) -> bool:
        if self.native_trait_owner_for_type(type_) != "": return true
        match type_.kind:
            case HirTypeKind.Optional(inner): self.native_trait_owner_for_type(inner) != ""
            case _: false

    me register_native_trait_declarations(module: HirModule):
        for declaration in module.traits.values():
            val symbol = module.symbols.get_symbol_raw(declaration.symbol.id)
            if symbol == nil: continue
            val owner = native_trait_qualified_owner(symbol)
            # A missing declaration identity is not a usable object layout.
            # Diagnose at conversion, not for an unused generic declaration.
            if owner == "": continue
            var slots: [NativeTraitMethodSlot] = []
            var safe = declaration.type_params.len() == 0 and declaration.assoc_types.len() == 0 and declaration.supertraits.len() == 0
            val method_names = native_trait_sorted_method_names(declaration)
            if method_names.len() != declaration.methods.len() + declaration.defaults.len(): safe = false
            for method_name in method_names:
                var selected: HirFunction? = nil
                for method in declaration.methods:
                    if method.name == method_name: selected = method
                if selected == nil:
                    for method in declaration.defaults:
                        if method.name == method_name: selected = method
                if val method = selected:
                    if method.is_static or method.type_params.len() != 0: safe = false
                    var params: [HirType] = []
                    var parameter_names: [text] = []
                    var parameter_mutability: [bool] = []
                    for param in method.params:
                        params.push(self.relocate_provider_type(param.type_, module.symbols))
                        parameter_names.push(param.name)
                        parameter_mutability.push(param.is_mutable)
                    slots.push(NativeTraitMethodSlot(name: method_name, params: params,
                        parameter_names: parameter_names,
                        parameter_mutability: parameter_mutability,
                        result: self.relocate_provider_type(method.return_type, module.symbols),
                        mutable_receiver: method.is_mutable))
            val layout = NativeTraitLayout(owner: owner, methods: slots, object_safe: safe)
            val existing = self.native_trait_layout_index(owner)
            if existing >= 0:
                if not self.native_trait_layout_matches(self.native_trait_layouts[existing], layout):
                    self.error_fatal("conflicting native trait declaration ABI: {owner}", Some(declaration.span))
            else:
                self.native_trait_layouts.push(layout)

    me register_native_trait_implementations(module: HirModule):
        # SymbolId is a value struct. A copied key is not the allocation used
        # by the native HIR dictionary; index the declaration's scalar ID.
        val function_values: [HirFunction] = module.functions.values()
        var function_index: Dict<i64, i64> = {}
        var function_position = 0
        for declaration in function_values:
            val function_id = declaration.symbol.id
            if function_index.has(function_id):
                self.error_fatal("duplicate native trait function symbol: {function_id}", Some(declaration.span))
                return
            function_index[function_id] = function_position
            function_position = function_position + 1
        for implementation in module.impls:
            if not implementation.has_trait_: continue
            val trait_type = self.relocate_provider_type(implementation.trait_, module.symbols)
            val owner = self.native_trait_owner_for_type(trait_type)
            val index = self.native_trait_layout_index(owner)
            if index < 0: continue
            val concrete_id = match implementation.type_.kind:
                case HirTypeKind.Named(id, _): id
                case _: continue
            val concrete = module.symbols.get_symbol_raw(concrete_id.id)
            if concrete == nil: continue
            val concrete_owner = native_trait_qualified_owner(concrete)
            if concrete_owner == "": continue
            var methods: [text] = []
            var signatures: [NativeTraitMethodSlot] = []
            for slot in self.native_trait_layouts[index].methods:
                val method_id = implementation.methods.get(slot.name)
                if val target = method_id:
                    if function_index.has(target.id):
                        val declaration: HirFunction = function_values[function_index[target.id]]
                        methods.push(mir_provider_function_name(module.name, module.symbols, declaration))
                        var params: [HirType] = []
                        var parameter_names: [text] = []
                        var parameter_mutability: [bool] = []
                        for param in declaration.params:
                            params.push(self.relocate_provider_type(param.type_, module.symbols))
                            parameter_names.push(param.name)
                            parameter_mutability.push(param.is_mutable)
                        signatures.push(NativeTraitMethodSlot(name: slot.name, params: params,
                            parameter_names: parameter_names,
                            parameter_mutability: parameter_mutability,
                            result: self.relocate_provider_type(declaration.return_type, module.symbols),
                            mutable_receiver: declaration.is_mutable))
                    else:
                        methods.push("")
                else:
                    methods.push("")
            self.native_trait_implementations.push(NativeTraitImplementation(
                trait_owner: owner, concrete_owner: concrete_owner, methods: methods,
                concrete_type: self.relocate_provider_type(implementation.type_, module.symbols),
                concrete_name: concrete.name, reference_semantics: concrete.kind == SymbolKind.Class,
                signatures: signatures))
