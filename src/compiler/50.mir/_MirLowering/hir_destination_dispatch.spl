# Complete destination-HIR schema gates used by the MIR scalar consumer.
# Keep these direct interval/singleton decisions out of statement/expression
# hot loops: a function receipt is validated once, then row shape is dispatched
# once at its owning loop.
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_block_values.*

fn mir_destination_expr_shape_supported(shape: i64) -> bool:
    # This is an executable-consumer gate, not merely a schema-domain gate.
    # Keep it synchronized with hir_destination_expr_emit*. Unsupported rows
    # must be rejected before any MIR is published.
    # Valid schema rows whose flat MIR owner is still explicitly unsupported
    # must fail during receipt preflight, not after partial body emission.
    if (shape == HD_EXPR_ERROR or shape == HD_EXPR_OPTIONAL_CHAIN or
            shape == HD_EXPR_WITH or shape == HD_EXPR_COMPREHENSION or
            shape == HD_EXPR_TYPE_TEST or shape == HD_EXPR_DICT_COMPREHENSION or
            shape == HD_EXPR_ARRAY_SUFFIX or shape == HD_EXPR_KERNEL_LAUNCH or
            shape == HD_EXPR_RANGE): return false
    if shape >= HD_EXPR_INT and shape <= HD_EXPR_SET: return true
    if shape >= HD_EXPR_VAR and shape <= HD_EXPR_TUPLE_INDEX: return true
    if shape == HD_EXPR_NULL_COALESCE or shape == HD_EXPR_EXISTS: return true
    if shape == HD_EXPR_BINARY or shape == HD_EXPR_UNARY: return true
    if shape >= HD_EXPR_CALL and shape <= HD_EXPR_MATCH: return true
    if shape == HD_EXPR_LOOP or shape == HD_EXPR_WHILE: return true
    if shape == HD_EXPR_FOR: return true
    if shape == HD_EXPR_LAMBDA: return true
    if shape == HD_EXPR_BLOCK: return true
    if (shape == HD_EXPR_RETURN or shape == HD_EXPR_BREAK or
            shape == HD_EXPR_CONTINUE or shape == HD_EXPR_THROW): return true
    if shape == HD_EXPR_TRY: return true
    if shape == HD_EXPR_TRY_CATCH: return true
    if shape == HD_EXPR_AWAIT or shape == HD_EXPR_YIELD: return true
    if shape >= HD_EXPR_STRUCT and shape <= HD_EXPR_AS: return true
    if shape == HD_EXPR_CUSTOM_BLOCK: return true
    if (shape == HD_EXPR_LOSS or shape == HD_EXPR_NOGRAD or
            shape == HD_EXPR_UNSAFE or shape == HD_EXPR_INLINE_ASM): return true
    if shape == HD_EXPR_INLINE_ASM_MATCH: return true
    if shape == HD_EXPR_SPAWN or shape == HD_EXPR_GPU_INTRINSIC: return true
    if shape == HD_EXPR_QUALIFIED_NAMED_VAR or shape == HD_EXPR_RESOLVED_FIELD: return true
    false

fn mir_destination_stmt_shape_supported(shape: i64) -> bool:
    shape >= HD_STMT_EXPR and shape <= HD_STMT_GPU_LAUNCH

fn mir_destination_type_shape_supported(shape: i64) -> bool:
    if (shape == HD_TYPE_INT or shape == HD_TYPE_FLOAT or
            shape == HD_TYPE_BOOL or shape == HD_TYPE_CHAR or
            shape == HD_TYPE_STR or shape == HD_TYPE_UNIT or
            shape == HD_TYPE_NEVER or shape == HD_TYPE_NAMED): return true
    if (shape == HD_TYPE_TUPLE or shape == HD_TYPE_ARRAY or
            shape == HD_TYPE_SLICE or shape == HD_TYPE_DICT or
            shape == HD_TYPE_FUNCTION or shape == HD_TYPE_REF or
            shape == HD_TYPE_PTR or shape == HD_TYPE_UNION or
            shape == HD_TYPE_RESULT): return true
    false

fn mir_destination_pattern_shape_supported(shape: i64) -> bool:
    # Executable MIR support only. Error/region/dynamic/type-test patterns are
    # valid destination-schema rows, but have no destination MIR semantics.
    if (shape == HD_PATTERN_WILDCARD or shape == HD_PATTERN_LITERAL or
            shape == HD_PATTERN_BINDING): return true
    if (shape == HD_PATTERN_TUPLE or shape == HD_PATTERN_ARRAY or
            shape == HD_PATTERN_STRUCT or shape == HD_PATTERN_ENUM): return true
    if (shape == HD_PATTERN_OR or shape == HD_PATTERN_RANGE or
            shape == HD_PATTERN_AS): return true
    false

fn mir_destination_effect_shape_supported(shape: i64) -> bool:
    shape >= HD_EFFECT_PURE and shape <= HD_EFFECT_CUSTOM

fn mir_destination_dim_shape_supported(shape: i64) -> bool:
    shape >= HD_DIM_LITERAL and shape <= HD_DIM_DIV

fn mir_destination_aux_shape_supported(shape: i64) -> bool:
    shape >= HD_AUX_INTERPOLATION and shape <= HD_AUX_TENSOR_SUFFIX

fn mir_destination_block_value_shape_supported(shape: i64) -> bool:
    # The existing flat custom-block lowering has exact MIR semantics only for
    # an expression payload. Other BlockValue shapes remain schema-valid but
    # may not be advertised as executable destination MIR support.
    shape == HD_BV_EXPR

fn mir_destination_range_kind_supported(kind: i64) -> bool:
    kind >= HD_RANGE_EXPR and kind <= HD_RANGE_BLOCK

export mir_destination_expr_shape_supported, mir_destination_stmt_shape_supported
export mir_destination_type_shape_supported, mir_destination_pattern_shape_supported
export mir_destination_effect_shape_supported, mir_destination_dim_shape_supported
export mir_destination_aux_shape_supported, mir_destination_block_value_shape_supported
export mir_destination_range_kind_supported
