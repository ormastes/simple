# Resident counterpart of the archived default binder's global-storage step.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirSymbol, HirType, HirTypeKind, SymbolId, SymbolKind, SymbolTable}
use compiler.mir.mir_target_hir_symbol_writes.{mir_symbol_write_record}
use compiler.hir.hir_definitions.{HirCallArg, HirConst, HirExpr, HirExprKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_data.{bootstrap_fn_param_default_owner,
    bootstrap_default_provider_symbols, bootstrap_default_provider_globals}
use compiler.mir.mir_types.{MirStatic}
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.provider_globals.*

impl MirLowering:
    me resident_default_has_provider_ref_v1(expression: HirExpr) -> bool:
        val kind: HirExprKind = expression.kind
        match kind:
            case HirExprKind.IntLit(_, _) | HirExprKind.FloatLit(_, _) |
                 HirExprKind.FloatLexeme(_, _) | HirExprKind.BoolLit(_) |
                 HirExprKind.CharLit(_) | HirExprKind.UnitLit | HirExprKind.NilLit |
                 HirExprKind.Error:
                false
            case HirExprKind.StringLit(_, interpolations):
                interpolations != None
            case HirExprKind.ArrayLit(elements, elem_ty):
                if elem_ty != None:
                    return true
                for item in elements:
                    val item_expr: HirExpr = item
                    if self.resident_default_has_provider_ref_v1(item_expr):
                        return true
                false
            case HirExprKind.TupleLit(elements):
                for item in elements:
                    val item_expr: HirExpr = item
                    if self.resident_default_has_provider_ref_v1(item_expr):
                        return true
                false
            case _:
                true

    me bind_resident_default_global_symbol_v1(callee: text, owner: text, symbols: SymbolTable,
            source: HirSymbol, expression: HirExpr) -> HirExpr:
        val global_owner = mir_layout_canonical_module_name(source.defining_module ?? owner)
        val optional_globals = bootstrap_default_provider_globals(global_owner)
        val optional_global_symbols = bootstrap_default_provider_symbols(global_owner)
        if optional_globals == None or optional_global_symbols == None:
            self.error_fatal("parameter default lacks resident global declarations: {global_owner}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val globals: [HirConst] = optional_globals.unwrap()
        val global_symbols: SymbolTable = optional_global_symbols.unwrap()
        var selected: [HirConst] = []
        for raw_global in globals:
            val global: HirConst = raw_global
            if global.name == source.name:
                selected.push(global)
        if selected.len() != 1:
            self.error_fatal("parameter default requires one resident global declaration: {global_owner}::{source.name}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val declaration: HirConst = selected[0]
        val storage_name = mir_global_storage_name(global_owner, declaration.name)
        var target = SymbolId(id: -1)
        for raw_static in self.global_statics_by_id.values():
            val static_: MirStatic = raw_static
            if static_.name == storage_name:
                target = static_.symbol
        if target.id < 0:
            val decl_kind: HirTypeKind = declaration.type_.kind
            val decl_type: HirType = HirType(kind: decl_kind, span: declaration.span)
            val type_ = self.relocate_provider_type(decl_type, global_symbols)
            val allocation_name = "__mir_default_global_{self.symbols.next_symbol_id}"
            target = self.symbols.define_with_binding(allocation_name, source.kind,
                Some(type_), source.span, source.visibility, source.is_mutable,
                Some(global_owner), false)
            self.symbol_write_ledger = mir_symbol_write_record(self.symbol_write_ledger, "resident_global_writes", allocation_name, target.id)
            val key = mir_global_declaration_key(global_owner, declaration.name)
            val demands: Dict<text, [i64]> = {key: [target.id]}
            # Delegate folding, storage naming, visibility and module-init
            # guards to the same real owner used by ordinary global imports.
            val found = self.register_provider_global_bindings(global_owner,
                global_symbols, globals, demands, {}, {})
            if not found.has(key):
                self.error_fatal("parameter default resident global could not be bound: {key}", Some(expression.span))
                var rejected = expression
                rejected.kind = HirExprKind.Error
                return rejected
        var remapped = expression
        remapped.kind = HirExprKind.NamedVar(target,
            self.symbols.symbol_display_name(target, source.name))
        if expression.has_type_ and expression.type_ != None:
            val expr_kind_ty: HirTypeKind = expression.type_.kind
            val expr_type = HirType(kind: expr_kind_ty, span: expression.span)
            remapped.type_ = self.relocate_provider_type(expr_type, symbols)
        remapped

    me bind_resident_default_expr_v1(callee: text, owner: text, symbols: SymbolTable, expression: HirExpr) -> HirExpr:
        var out = expression
        if expression.has_type_ and expression.type_ != None:
            val expr_ty_kind: HirTypeKind = expression.type_.kind
            val expr_ty = HirType(kind: expr_ty_kind, span: expression.span)
            out.type_ = self.relocate_provider_type(expr_ty, symbols)
        val kind: HirExprKind = expression.kind
        match kind:
            case HirExprKind.Var(source_id):
                if not symbols.symbols.has(source_id.id):
                    self.error_fatal("parameter default lacks its resident provider symbol: {callee}", Some(expression.span))
                    out.kind = HirExprKind.Error
                    return out
                val source: HirSymbol = symbols.symbols[source_id.id]
                if source.kind == SymbolKind.Const or source.kind == SymbolKind.Variable:
                    return self.bind_resident_default_global_symbol_v1(callee, owner, symbols, source, out)
                val relocated = self.relocate_provider_default(expression, symbols, {})
                match relocated.kind:
                    case HirExprKind.Error:
                        self.error_fatal("parameter default expression could not be relocated: {callee}", Some(expression.span))
                    case _: ()
                return relocated
            case HirExprKind.NamedVar(source_id, name):
                if source_id.id < 0 and (name == "None" or name == "Some" or name == "Ok" or name == "Err"):
                    return out
                if not symbols.symbols.has(source_id.id):
                    self.error_fatal("parameter default lacks its resident provider symbol: {callee}", Some(expression.span))
                    out.kind = HirExprKind.Error
                    return out
                val source: HirSymbol = symbols.symbols[source_id.id]
                if source.kind == SymbolKind.Const or source.kind == SymbolKind.Variable:
                    return self.bind_resident_default_global_symbol_v1(callee, owner, symbols, source, out)
                val relocated = self.relocate_provider_default(expression, symbols, {})
                match relocated.kind:
                    case HirExprKind.Error:
                        self.error_fatal("parameter default expression could not be relocated: {callee}", Some(expression.span))
                    case _: ()
                return relocated
            case HirExprKind.Call(call_callee, args, type_args):
                val callee_expr: HirExpr = call_callee
                val relocated_callee = self.bind_resident_default_expr_v1(callee, owner, symbols, callee_expr)
                match relocated_callee.kind:
                    case HirExprKind.Error:
                        out.kind = HirExprKind.Error
                        return out
                    case _: ()
                var relocated_args: [HirCallArg] = []
                for raw_arg in args:
                    val cur_arg: HirCallArg = raw_arg
                    var next_arg = cur_arg
                    next_arg.value = self.bind_resident_default_expr_v1(callee, owner, symbols, cur_arg.value)
                    match next_arg.value.kind:
                        case HirExprKind.Error:
                            out.kind = HirExprKind.Error
                            return out
                        case _: ()
                    relocated_args = relocated_args.push(next_arg)
                out.kind = HirExprKind.Call(relocated_callee, relocated_args, self.relocate_provider_types(type_args, symbols))
                return out
            case HirExprKind.StructLit(ty, fields):
                val ty_kind: HirTypeKind = ty.kind
                val bare_ty = HirType(kind: ty_kind, span: expression.span)
                val relocated_ty = self.relocate_provider_type(bare_ty, symbols)
                var relocated_fields: [(text, HirExpr)] = []
                for raw_field in fields:
                    val cur_field: (text, HirExpr) = raw_field
                    val relocated_val = self.bind_resident_default_expr_v1(callee, owner, symbols, cur_field.1)
                    match relocated_val.kind:
                        case HirExprKind.Error:
                            out.kind = HirExprKind.Error
                            return out
                        case _: ()
                    relocated_fields = relocated_fields.push((cur_field.0, relocated_val))
                out.kind = HirExprKind.StructLit(relocated_ty, relocated_fields)
                return out
            case HirExprKind.Error:
                return out
            case _:
                val relocated = self.relocate_provider_default(expression, symbols, {})
                match relocated.kind:
                    case HirExprKind.Error:
                        self.error_fatal("parameter default expression could not be relocated: {callee}", Some(expression.span))
                    case _: ()
                return relocated

    me bind_resident_default_global_v1(callee: text, expression: HirExpr) -> HirExpr:
        val owner = bootstrap_fn_param_default_owner(callee)
        if owner == "" or owner == mir_layout_canonical_module_name(self.current_module_id):
            return expression
        val optional_symbols = bootstrap_default_provider_symbols(owner)
        if optional_symbols == None:
            if self.resident_default_has_provider_ref_v1(expression):
                self.error_fatal("parameter default lacks its resident provider symbols: {callee}", Some(expression.span))
                var rejected = expression
                rejected.kind = HirExprKind.Error
                return rejected
            return expression
        val symbols: SymbolTable = optional_symbols.unwrap()
        self.bind_resident_default_expr_v1(callee, owner, symbols, expression)
