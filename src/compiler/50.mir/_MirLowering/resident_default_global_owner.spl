# Resident counterpart of the archived default binder's global-storage step.
use compiler.hir.hir_types.{HirSymbol, SymbolId, SymbolKind, SymbolTable}
use compiler.hir.hir_definitions.{HirConst, HirExpr, HirExprKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_data.{bootstrap_fn_param_default_owner,
    bootstrap_default_provider_symbols, bootstrap_default_provider_globals}
use compiler.mir.mir_types.{MirStatic}
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.provider_globals.*

impl MirLowering:
    me bind_resident_default_global_v1(callee: text, expression: HirExpr) -> HirExpr:
        # This repair covers a default which is a direct global reference.
        # Other expression shapes keep their existing lowering path; this is
        # not an admission of general foreign lexical/default expressions.
        var source_id = SymbolId(id: -1)
        match expression.kind:
            case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): source_id = symbol
            case _: return expression
        val owner = bootstrap_fn_param_default_owner(callee)
        if owner == "" or owner == mir_layout_canonical_module_name(self.current_module_id): return expression
        val optional_symbols = bootstrap_default_provider_symbols(owner)
        if optional_symbols == nil:
            self.error_fatal("parameter default lacks its resident provider symbols: {callee}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val symbols: SymbolTable = optional_symbols.unwrap()
        if not symbols.symbols.has(source_id.id):
            self.error_fatal("parameter default lacks its resident provider symbol: {callee}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val source: HirSymbol = symbols.symbols[source_id.id]
        if source.kind != SymbolKind.Const and source.kind != SymbolKind.Variable:
            return expression
        val global_owner = mir_layout_canonical_module_name(source.defining_module ?? owner)
        val optional_globals = bootstrap_default_provider_globals(global_owner)
        val optional_global_symbols = bootstrap_default_provider_symbols(global_owner)
        if optional_globals == nil or optional_global_symbols == nil:
            self.error_fatal("parameter default lacks resident global declarations: {global_owner}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val globals: [HirConst] = optional_globals.unwrap()
        val global_symbols: SymbolTable = optional_global_symbols.unwrap()
        var selected: [HirConst] = []
        for raw_global in globals:
            val global: HirConst = raw_global
            if global.name == source.name:
                selected.push(global)
        if selected.len() != 1:
            self.error_fatal("parameter default requires one resident global declaration: {global_owner}::{source.name}", Some(expression.span))
            var rejected = expression
            rejected.kind = HirExprKind.Error
            return rejected
        val declaration: HirConst = selected[0]
        val storage_name = mir_global_storage_name(global_owner, declaration.name)
        var target = SymbolId(id: -1)
        for raw_static in self.global_statics_by_id.values():
            val static_: MirStatic = raw_static
            if static_.name == storage_name:
                target = static_.symbol
        if target.id < 0:
            val type_ = self.relocate_provider_type(declaration.type_, global_symbols)
            val allocation_name = "__mir_default_global_{self.symbols.next_symbol_id}"
            target = self.symbols.define_with_binding(allocation_name, source.kind,
                Some(type_), source.span, source.visibility, source.is_mutable,
                Some(global_owner), false)
            val key = mir_global_declaration_key(global_owner, declaration.name)
            val demands: Dict<text, [i64]> = {key: [target.id]}
            # Delegate folding, storage naming, visibility and module-init
            # guards to the same real owner used by ordinary global imports.
            val found = self.register_provider_global_bindings(global_owner,
                global_symbols, globals, demands, {}, {})
            if not found.has(key):
                self.error_fatal("parameter default resident global could not be bound: {key}", Some(expression.span))
                var rejected = expression
                rejected.kind = HirExprKind.Error
                return rejected
        var remapped = expression
        remapped.kind = HirExprKind.NamedVar(target,
            self.symbols.symbol_display_name(target, source.name))
        if expression.has_type_:
            remapped.type_ = self.relocate_provider_type(expression.type_, symbols)
        remapped
