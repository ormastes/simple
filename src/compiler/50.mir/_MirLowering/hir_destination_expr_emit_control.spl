# Composite scalar-pattern lowering for destination-HIR expression CFG.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_declarations.{HD_ENUM_PAYLOAD_TUPLE, HD_ENUM_PAYLOAD_STRUCT}
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir._MirLowering.hir_destination_types.*
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBinOp, MirOperand, MirOperandKind}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirConstValue, MirSignature}

impl MirLowering:
    fn destination_pattern_binding_symbols(r: MirDestinationFunctionReceipt,
            pattern: i64) -> [i64]:
        var result: [i64] = []
        val shape = hdr_pattern_shape(r.slot, r.generation, pattern)
        if shape == HD_PATTERN_BINDING:
            result.push(hdr_pattern_i64(r.slot, r.generation, pattern, 0))
            return result
        if shape == HD_PATTERN_AS:
            result = self.destination_pattern_binding_symbols(r,
                hdr_pattern_i64(r.slot, r.generation, pattern, 0))
            val symbol = hdr_pattern_i64(r.slot, r.generation, pattern, 1)
            if not result.contains(symbol): result.push(symbol)
            return result
        var range = -1
        var struct_children = false
        if (shape == HD_PATTERN_TUPLE or shape == HD_PATTERN_ARRAY or
                shape == HD_PATTERN_STRUCT or shape == HD_PATTERN_OR):
            range = hdr_pattern_range(r.slot, r.generation, pattern)
            struct_children = shape == HD_PATTERN_STRUCT
        elif shape == HD_PATTERN_ENUM and hdr_pattern_bool(r.slot, r.generation, pattern, 0):
            val payload = hdr_pattern_i64(r.slot, r.generation, pattern, 1)
            range = hdr_aux_range(r.slot, r.generation, payload)
            struct_children = hdr_aux_shape(r.slot, r.generation, payload) == HD_AUX_PATTERN_STRUCT
        if range < 0: return result
        val subtype = hdr_range_subtype(r.slot, r.generation, range)
        val count = hdr_range_length(r.slot, r.generation, range)
        var offset = 0
        while offset < count:
            val child = hdr_range_value(r.slot, r.generation, range, subtype, offset)
            val child_pattern = if struct_children:
                hdr_aux_i64(r.slot, r.generation, child, 0)
            else:
                child
            val child_symbols = self.destination_pattern_binding_symbols(r, child_pattern)
            var child_offset = 0
            while child_offset < child_symbols.len():
                if not result.contains(child_symbols[child_offset]):
                    result.push(child_symbols[child_offset])
                child_offset = child_offset + 1
            offset = offset + 1
        result

    me destination_pattern_runtime_call(name: text, value: LocalId) -> LocalId:
        val function = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [MirType.i64()],
                return_type: MirType.i64(), is_variadic: false)))))
        var b = self.builder
        val result = b.emit_call(function, [mir_operand_copy(value)], MirType.i64())
        self.builder = b
        result ?? LocalId(id: -1)

    fn destination_pattern_owner_symbol(r: MirDestinationFunctionReceipt,
            pattern: i64) -> i64:
        val type_row = hdr_pattern_i64(r.slot, r.generation, pattern, 0)
        if type_row < 0: return -1
        hdr_type_i64(r.slot, r.generation, type_row, 0)

    fn destination_pattern_binds(r: MirDestinationFunctionReceipt,
            pattern: i64) -> bool:
        val shape = hdr_pattern_shape(r.slot, r.generation, pattern)
        if shape == HD_PATTERN_BINDING or shape == HD_PATTERN_AS: return true
        if shape == HD_PATTERN_ARRAY and hdr_pattern_bool(r.slot, r.generation, pattern, 0):
            return true
        if shape == HD_PATTERN_ENUM and hdr_pattern_bool(r.slot, r.generation, pattern, 0):
            val payload = hdr_pattern_i64(r.slot, r.generation, pattern, 1)
            val values = hdr_aux_range(r.slot, r.generation, payload)
            val subtype = hdr_range_subtype(r.slot, r.generation, values)
            val count = hdr_range_length(r.slot, r.generation, values)
            var offset = 0
            while offset < count:
                val child = hdr_range_value(r.slot, r.generation, values, subtype, offset)
                val child_pattern = if hdr_aux_shape(r.slot, r.generation, payload) == HD_AUX_PATTERN_STRUCT:
                    hdr_aux_i64(r.slot, r.generation, child, 0)
                else:
                    child
                if self.destination_pattern_binds(r, child_pattern): return true
                offset = offset + 1
            return false
        if (shape != HD_PATTERN_TUPLE and shape != HD_PATTERN_ARRAY and
                shape != HD_PATTERN_OR and shape != HD_PATTERN_STRUCT): return false
        val values = hdr_pattern_range(r.slot, r.generation, pattern)
        val subtype = hdr_range_subtype(r.slot, r.generation, values)
        val count = hdr_range_length(r.slot, r.generation, values)
        var offset = 0
        while offset < count:
            val child = hdr_range_value(r.slot, r.generation, values, subtype, offset)
            val child_pattern = if shape == HD_PATTERN_STRUCT:
                hdr_aux_i64(r.slot, r.generation, child, 0)
            else:
                child
            if self.destination_pattern_binds(r, child_pattern):
                return true
            offset = offset + 1
        false

    me destination_complex_pattern_test(r: MirDestinationFunctionReceipt,
            pattern: i64, value: LocalId) -> LocalId:
        val shape = hdr_pattern_shape(r.slot, r.generation, pattern)
        if shape == HD_PATTERN_AS:
            self.bind_local(hdr_pattern_i64(r.slot, r.generation, pattern, 1), value)
            return self.destination_pattern_test(r,
                hdr_pattern_i64(r.slot, r.generation, pattern, 0), value)
        if shape == HD_PATTERN_RANGE:
            var range_builder = self.builder
            var result = range_builder.emit_const_bool(true)
            self.builder = range_builder
            if hdr_pattern_endpoint_present(r.slot, r.generation, pattern, false):
                val start = self.mir_destination_lower_expr_row(r,
                    hdr_pattern_i64(r.slot, r.generation, pattern, 0), nil)
                range_builder = self.builder
                result = range_builder.emit_binop(MirBinOp.Ge,
                    mir_operand_copy(value), mir_operand_copy(start), MirType.bool())
                self.builder = range_builder
            if hdr_pattern_endpoint_present(r.slot, r.generation, pattern, true):
                val end = self.mir_destination_lower_expr_row(r,
                    hdr_pattern_i64(r.slot, r.generation, pattern, 1), nil)
                range_builder = self.builder
                val comparison = range_builder.emit_binop(
                    if hdr_pattern_bool(r.slot, r.generation, pattern, 0): MirBinOp.Le else: MirBinOp.Lt,
                    mir_operand_copy(value), mir_operand_copy(end), MirType.bool())
                result = range_builder.emit_binop(MirBinOp.BitAnd,
                    mir_operand_copy(result), mir_operand_copy(comparison), MirType.bool())
                self.builder = range_builder
            return result
        if shape == HD_PATTERN_TUPLE:
            val members = hdr_pattern_range(r.slot, r.generation, pattern)
            val subtype = hdr_range_subtype(r.slot, r.generation, members)
            val count = hdr_range_length(r.slot, r.generation, members)
            var tuple_builder = self.builder
            var result = tuple_builder.emit_const_bool(true)
            self.builder = tuple_builder
            var offset = 0
            while offset < count:
                tuple_builder = self.builder
                val field = tuple_builder.emit_get_field(mir_operand_copy(value),
                    offset, MirType.i64())
                self.builder = tuple_builder
                val member = hdr_range_value(r.slot, r.generation, members, subtype, offset)
                val matches = self.destination_pattern_test(r, member, field)
                tuple_builder = self.builder
                result = tuple_builder.emit_binop(MirBinOp.BitAnd,
                    mir_operand_copy(result), mir_operand_copy(matches), MirType.bool())
                self.builder = tuple_builder
                offset = offset + 1
            return result
        if shape == HD_PATTERN_ARRAY:
            if hdr_pattern_bool(r.slot, r.generation, pattern, 0):
                self.error_fatal("E-MIR-DESTINATION-PATTERN: array rest binding has no exact runtime slice ABI", nil)
                return LocalId(id: -1)
            val members = hdr_pattern_range(r.slot, r.generation, pattern)
            val subtype = hdr_range_subtype(r.slot, r.generation, members)
            val count = hdr_range_length(r.slot, r.generation, members)
            var array_builder = self.builder
            val length_call = array_builder.emit_call(
                MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("rt_array_len"),
                    MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [],
                        return_type: MirType.i64(), is_variadic: false))))),
                [mir_operand_copy(value)], MirType.i64())
            val expected = array_builder.emit_const_int(count)
            var result = array_builder.emit_binop(MirBinOp.Eq,
                mir_operand_copy(length_call ?? LocalId(id: -1)),
                mir_operand_copy(expected), MirType.bool())
            self.builder = array_builder
            var offset = 0
            while offset < count:
                array_builder = self.builder
                val index = array_builder.emit_const_int(offset)
                val field_call = array_builder.emit_call(
                    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str("rt_array_get"),
                        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: [],
                            return_type: MirType.i64(), is_variadic: false))))),
                    [mir_operand_copy(value), mir_operand_copy(index)], MirType.i64())
                self.builder = array_builder
                val member = hdr_range_value(r.slot, r.generation, members, subtype, offset)
                val matches = self.destination_pattern_test(r, member,
                    field_call ?? LocalId(id: -1))
                array_builder = self.builder
                result = array_builder.emit_binop(MirBinOp.BitAnd,
                    mir_operand_copy(result), mir_operand_copy(matches), MirType.bool())
                self.builder = array_builder
                offset = offset + 1
            return result
        if shape == HD_PATTERN_STRUCT:
            val owner = self.destination_pattern_owner_symbol(r, pattern)
            val type_row = hdr_pattern_i64(r.slot, r.generation, pattern, 0)
            val defining_module = hdr_type_i64(r.slot, r.generation, type_row, 1)
            if owner < 0 or defining_module < 0:
                self.error_fatal("E-MIR-DESTINATION-PATTERN: struct pattern owner type is absent", nil)
                return LocalId(id: -1)
            val fields = hdr_pattern_range(r.slot, r.generation, pattern)
            val subtype = hdr_range_subtype(r.slot, r.generation, fields)
            val count = hdr_range_length(r.slot, r.generation, fields)
            var struct_builder = self.builder
            var result = struct_builder.emit_const_bool(true)
            self.builder = struct_builder
            var offset = 0
            while offset < count:
                val named = hdr_range_value(r.slot, r.generation, fields, subtype, offset)
                val name = hdr_aux_text(r.slot, r.generation, named, 0)
                val member = hdr_destination_member_lookup_name(r.slot, r.generation,
                    defining_module, owner, name)
                val ordinal = hdr_destination_member_ordinal(r.slot, r.generation, member)
                if member < 0 or ordinal < 0:
                    self.error_fatal("E-MIR-DESTINATION-PATTERN: struct field has no authoritative ordinal: " + name, nil)
                    return LocalId(id: -1)
                struct_builder = self.builder
                val field = struct_builder.emit_get_field(mir_operand_copy(value), ordinal,
                    if hdr_destination_member_has_type(r.slot, r.generation, member):
                        self.destination_checked_type(r,
                            hdr_destination_member_type(r.slot, r.generation, member),
                            "pattern member")
                    else:
                        MirType.i64())
                self.builder = struct_builder
                val matches = self.destination_pattern_test(r,
                    hdr_aux_i64(r.slot, r.generation, named, 0), field)
                struct_builder = self.builder
                result = struct_builder.emit_binop(MirBinOp.BitAnd,
                    mir_operand_copy(result), mir_operand_copy(matches), MirType.bool())
                self.builder = struct_builder
                offset = offset + 1
            return result
        if shape == HD_PATTERN_ENUM:
            val owner = self.destination_pattern_owner_symbol(r, pattern)
            val type_row = hdr_pattern_i64(r.slot, r.generation, pattern, 0)
            val defining_module = hdr_type_i64(r.slot, r.generation, type_row, 1)
            if defining_module < 0 or hdr_module_identity(r.slot, r.generation,
                    defining_module) < 0:
                self.error_fatal("E-MIR-DESTINATION-PATTERN: enum defining-module authority is absent", nil)
                return LocalId(id: -1)
            val enum_symbol_row = hdr_destination_symbol_lookup_in_module(r.slot,
                r.generation, defining_module, owner)
            val enum_name = hdr_destination_symbol_name(r.slot, r.generation,
                enum_symbol_row)
            val declaration_row = hdr_decl_lookup(r.slot, r.generation,
                defining_module, owner)
            val variant = hdr_pattern_text(r.slot, r.generation, pattern, 0)
            val variant_ordinal = hdr_decl_enum_variant_lookup(r.slot,
                r.generation, declaration_row, variant)
            if (enum_symbol_row < 0 or enum_name == "" or declaration_row < 0 or
                    variant_ordinal < 0):
                self.error_fatal("E-MIR-DESTINATION-PATTERN: enum variant authority is absent for " + variant, nil)
                return LocalId(id: -1)
            val actual_disc = self.destination_pattern_runtime_call("rt_enum_discriminant", value)
            val actual_id = self.destination_pattern_runtime_call("rt_enum_id", value)
            var enum_builder = self.builder
            var expected = LocalId(id: -1)
            if hdr_decl_enum_variant_has_discriminant(r.slot, r.generation,
                    declaration_row, variant_ordinal):
                expected = self.mir_destination_lower_expr_row(r,
                    hdr_decl_enum_variant_i64(r.slot, r.generation,
                        declaration_row, variant_ordinal, 2), Some(MirType.i64()))
            else:
                expected = enum_builder.emit_const_int(variant_ordinal)
                self.builder = enum_builder
            enum_builder = self.builder
            val disc_matches = enum_builder.emit_binop(MirBinOp.Eq,
                mir_operand_copy(actual_disc), mir_operand_copy(expected), MirType.bool())
            val expected_id = enum_builder.emit_const_int(declaration_row)
            val id_matches = enum_builder.emit_binop(MirBinOp.Eq,
                mir_operand_copy(actual_id), mir_operand_copy(expected_id), MirType.bool())
            var result = enum_builder.emit_binop(MirBinOp.BitAnd,
                mir_operand_copy(disc_matches), mir_operand_copy(id_matches), MirType.bool())
            self.builder = enum_builder
            val declared_arity = hdr_decl_enum_variant_i64(r.slot, r.generation,
                declaration_row, variant_ordinal, 4)
            val declared_kind = hdr_decl_enum_variant_i64(r.slot, r.generation,
                declaration_row, variant_ordinal, 1)
            if declared_arity < 0:
                self.error_fatal("E-MIR-DESTINATION-PATTERN: frozen enum payload authority is absent", nil)
                return LocalId(id: -1)
            if not hdr_pattern_bool(r.slot, r.generation, pattern, 0):
                if declared_arity != 0:
                    self.error_fatal("E-MIR-DESTINATION-PATTERN: missing enum payload pattern for " + variant, nil)
                    return LocalId(id: -1)
                return result
            val payload_aux = hdr_pattern_i64(r.slot, r.generation, pattern, 1)
            val payload_shape = hdr_aux_shape(r.slot, r.generation, payload_aux)
            val payload_range = hdr_aux_range(r.slot, r.generation, payload_aux)
            val payload_subtype = hdr_range_subtype(r.slot, r.generation, payload_range)
            val payload_count = hdr_range_length(r.slot, r.generation, payload_range)
            if payload_count != declared_arity:
                self.error_fatal("E-MIR-DESTINATION-PATTERN: enum payload arity mismatch for " + variant, nil)
                return LocalId(id: -1)
            if ((declared_kind == HD_ENUM_PAYLOAD_TUPLE and payload_shape != HD_AUX_PATTERN_TUPLE) or
                    (declared_kind == HD_ENUM_PAYLOAD_STRUCT and payload_shape != HD_AUX_PATTERN_STRUCT) or
                    (declared_kind != HD_ENUM_PAYLOAD_TUPLE and declared_kind != HD_ENUM_PAYLOAD_STRUCT)):
                self.error_fatal("E-MIR-DESTINATION-PATTERN: enum payload form mismatch for " + variant, nil)
                return LocalId(id: -1)
            val payload = self.destination_pattern_runtime_call("rt_enum_payload", value)
            var ordered_patterns: [i64] = []; var present: [bool] = []
            if payload_shape == HD_AUX_PATTERN_STRUCT:
                var initialize = 0
                while initialize < declared_arity:
                    ordered_patterns.push(-1); present.push(false)
                    initialize = initialize + 1
                var source_offset = 0
                while source_offset < payload_count:
                    val named = hdr_range_value(r.slot, r.generation,
                        payload_range, payload_subtype, source_offset)
                    val field_name = hdr_aux_text(r.slot, r.generation, named, 0)
                    val field_ordinal = hdr_decl_enum_payload_lookup(r.slot,
                        r.generation, declaration_row, variant_ordinal, field_name)
                    if field_ordinal < 0 or field_ordinal >= declared_arity:
                        self.error_fatal("E-MIR-DESTINATION-PATTERN: unknown enum payload field " + field_name, nil)
                        return LocalId(id: -1)
                    if present[field_ordinal]:
                        self.error_fatal("E-MIR-DESTINATION-PATTERN: duplicate enum payload field " + field_name, nil)
                        return LocalId(id: -1)
                    ordered_patterns[field_ordinal] = hdr_aux_i64(r.slot,
                        r.generation, named, 0)
                    present[field_ordinal] = true
                    source_offset = source_offset + 1
            var ordinal = 0
            while ordinal < declared_arity:
                var child_pattern = -1
                if payload_shape == HD_AUX_PATTERN_TUPLE:
                    child_pattern = hdr_range_value(r.slot, r.generation,
                        payload_range, payload_subtype, ordinal)
                else:
                    if not present[ordinal]:
                        self.error_fatal("E-MIR-DESTINATION-PATTERN: missing enum payload field " +
                            hdr_decl_enum_payload_name(r.slot, r.generation,
                                declaration_row, variant_ordinal, ordinal), nil)
                        return LocalId(id: -1)
                    child_pattern = ordered_patterns[ordinal]
                var child_value = payload
                if declared_arity > 1:
                    enum_builder = self.builder
                    val tuple_get = MirOperand(kind: MirOperandKind.Const(
                        MirConstValue.Str("rt_tuple_get"), MirType(kind: MirTypeKind.FuncPtr(
                            MirSignature(params: [MirType.i64(), MirType.i64()],
                                return_type: MirType.i64(), is_variadic: false)))))
                    val tuple_value = enum_builder.emit_call(tuple_get,
                        [mir_operand_copy(payload), mir_operand_const_int(ordinal)], MirType.i64())
                    child_value = tuple_value ?? LocalId(id: -1)
                    self.builder = enum_builder
                val matches = self.destination_pattern_test(r, child_pattern, child_value)
                enum_builder = self.builder
                result = enum_builder.emit_binop(MirBinOp.BitAnd,
                    mir_operand_copy(result), mir_operand_copy(matches), MirType.bool())
                self.builder = enum_builder
                ordinal = ordinal + 1
            return result
        if shape == HD_PATTERN_OR:
            val alternatives = hdr_pattern_range(r.slot, r.generation, pattern)
            val subtype = hdr_range_subtype(r.slot, r.generation, alternatives)
            val count = hdr_range_length(r.slot, r.generation, alternatives)
            if count == 0:
                return self.builder.emit_const_bool(false)
            val first = hdr_range_value(r.slot, r.generation, alternatives, subtype, 0)
            val symbols = self.destination_pattern_binding_symbols(r, first)
            var or_builder = self.builder
            val result = or_builder.new_temp(MirType.bool())
            val merge = or_builder.new_block(Some("destination_pattern_or_merge"))
            var committed: [LocalId] = []
            var symbol_offset = 0
            self.builder = or_builder
            var offset = 0
            while offset < count:
                val alternative = hdr_range_value(r.slot, r.generation,
                    alternatives, subtype, offset)
                val alternative_symbols = self.destination_pattern_binding_symbols(r, alternative)
                if alternative_symbols != symbols:
                    self.error_fatal("E-MIR-DESTINATION-PATTERN: OR alternatives bind different symbols", nil)
                    return LocalId(id: -1)
                # Pattern tests update only the lowering symbol table.  Snapshot
                # it around each alternative so a failed alternative cannot
                # leak bindings into later guards/arms.  The alternative-local
                # values are evaluated once and committed below through stable
                # result locals selected by the OR condition.
                val saved_ids = self.local_symbol_ids
                val saved_values = self.local_symbol_values
                val saved_slots = self.local_symbol_index_slots
                val matches = self.destination_pattern_test(r, alternative, value)
                var candidates: [LocalId] = []
                symbol_offset = 0
                while symbol_offset < symbols.len():
                    candidates.push(self.find_local(symbols[symbol_offset]))
                    if candidates[candidates.len() - 1].id < 0:
                        self.error_fatal("E-MIR-DESTINATION-PATTERN: OR alternative failed to produce an advertised binding", nil)
                        return LocalId(id: -1)
                    symbol_offset = symbol_offset + 1
                self.local_symbol_ids = saved_ids
                self.local_symbol_values = saved_values
                self.local_symbol_index_slots = saved_slots
                or_builder = self.builder
                if offset == 0:
                    symbol_offset = 0
                    while symbol_offset < candidates.len():
                        committed.push(or_builder.new_temp(
                            self.local_mir_type_of(candidates[symbol_offset]) ?? MirType.i64()))
                        symbol_offset = symbol_offset + 1
                val success = or_builder.new_block(Some("destination_pattern_or_success"))
                val next = or_builder.new_block(Some("destination_pattern_or_next"))
                or_builder.terminate_if(mir_operand_copy(matches), success, next)
                or_builder.switch_to_block(success)
                symbol_offset = 0
                while symbol_offset < symbols.len():
                    or_builder.emit_copy(committed[symbol_offset], candidates[symbol_offset])
                    symbol_offset = symbol_offset + 1
                or_builder.emit_const(result, MirConstValue.Bool(true), MirType.bool())
                or_builder.terminate_goto(merge)
                or_builder.switch_to_block(next)
                self.builder = or_builder
                offset = offset + 1
                if offset == count:
                    or_builder.emit_const(result, MirConstValue.Bool(false), MirType.bool())
                    or_builder.terminate_goto(merge)
                    or_builder.switch_to_block(merge)
                    self.builder = or_builder
            symbol_offset = 0
            while symbol_offset < symbols.len():
                self.bind_local(symbols[symbol_offset], committed[symbol_offset])
                symbol_offset = symbol_offset + 1
            return result
        self.error_fatal("E-MIR-DESTINATION-PATTERN: unsupported composite pattern shape " + shape.to_text(), nil)
        LocalId(id: -1)
