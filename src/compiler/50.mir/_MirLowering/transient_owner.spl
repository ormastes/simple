# Retained roots for the per-module MIR transient allocation boundary.
#
# The lowering and its nested aggregate carriers can predate the active scope.
# A raw carrier from an older scope is not traversable by this scope's runtime.
# Enumerate its children directly; also retain replacement carriers born in the
# current scope. The boundary gate checks these lists against the declarations.

use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.transient_owner_sffi.{promote_and_release_transient_owner_roots}

impl MirLowering:
    me promote_transient_owner() -> bool:
        """Retain the lowering's field roots while its module scope is paused.

        One managed inventory handles nil/scalar fields without asking the
        runtime to promote a non-heap root, and performs one graph walk/arena
        scan. Free only the temporary inventory; its retained children remain
        owned by the lowering. Mirror the HIR module-surface promotion boundary.
        """
        var roots: [Any] = []
        # MirLowering: every declared field, including optional/scalar carriers.
        roots.push(self.builder)
        roots.push(self.symbols)
        roots.push(self.local_map)
        roots.push(self.local_symbol_ids)
        roots.push(self.local_symbol_values)
        roots.push(self.local_symbol_index_slots)
        roots.push(self.local_hir_type_ids)
        roots.push(self.local_hir_type_values)
        roots.push(self.local_hir_type_isolation_states)
        roots.push(self.local_hir_type_resource_states)
        roots.push(self.fn_return_types)
        roots.push(self.current_function_symbols)
        roots.push(self.current_function_names)
        roots.push(self.loop_stack)
        roots.push(self.finally_stack)
        roots.push(self.unsafe_depth)
        roots.push(self.errors)
        roots.push(self.current_module_id)
        roots.push(self.composite_layout_digests)
        roots.push(self.composite_layout_owner_counts)
        roots.push(self.external_layout_traces)
        roots.push(self.type_transport_receipts)
        roots.push(self.type_transport_owner)
        roots.push(self.type_transport_context)
        roots.push(self.type_transport_param_index)
        roots.push(self.type_transport_caller_disc)
        roots.push(self.mir_tag_probe_active_function)
        roots.push(self.mir_tag_probe_pending_site)
        roots.push(self.mir_tag_probe_pending_caller_disc)
        roots.push(self.mcdc_mode)
        roots.push(self.mcdc_owner_bytes)
        roots.push(self.mcdc_global_bytes)
        roots.push(self.mcdc_include_csv)
        roots.push(self.mcdc_exclude_csv)
        roots.push(self.mcdc_next_runtime_id)
        roots.push(self.mcdc_active_decision_id)
        roots.push(self.mcdc_active_decision_semantic)
        roots.push(self.mcdc_next_condition_ordinal)
        roots.push(self.mcdc_active_dynamic_token)
        roots.push(self.mcdc_active_tokens)
        roots.push(self.field_map)
        roots.push(self.bitfield_map)
        roots.push(self.bitfield_value_syms)
        roots.push(self.struct_field_order)
        roots.push(self.struct_field_order_conflict_warned)
        roots.push(self.struct_field_has_default)
        roots.push(self.struct_field_default_expr)
        roots.push(self.class_type_names)
        roots.push(self.struct_field_type_ownership_key)
        roots.push(self.struct_field_type_name)
        roots.push(self.struct_field_repr_name)
        roots.push(self.struct_field_hir_type)
        roots.push(self.struct_field_array_element_type_name)
        roots.push(self.struct_field_array_elem_type)
        roots.push(self.struct_value_syms)
        roots.push(self.struct_method_syms)
        roots.push(self.struct_method_ambiguous)
        roots.push(self.struct_method_return_names)
        roots.push(self.struct_method_return_is_array)
        roots.push(self.struct_method_return_is_optional)
        roots.push(self.enum_payload_struct_names)
        roots.push(self.enum_single_payload_types)
        roots.push(self.enum_variant_payload_types)
        roots.push(self.enum_variant_payload_names)
        roots.push(self.enum_variant_payload_kind)
        roots.push(self.enum_tuple_text_slots)
        roots.push(self.runtime_array_locals)
        roots.push(self.runtime_dict_locals)
        roots.push(self.runtime_elem_value_type)
        roots.push(self.array_element_struct_syms)
        roots.push(self.runtime_value_local_ids)
        roots.push(self.tagged_text_locals)
        roots.push(self.option_value_locals)
        roots.push(self.nil_locals)
        roots.push(self.enum_variant_index)
        roots.push(self.enum_variant_discriminants)
        roots.push(self.enum_variant_owners)
        roots.push(self.enum_bare_name_collisions)
        roots.push(self.enum_variant_index_q)
        roots.push(self.enum_variant_discriminants_q)
        roots.push(self.enum_runtime_id_index_q)
        roots.push(self.enum_runtime_to_bare)
        roots.push(self.enum_bare_ambiguous)
        roots.push(self.enum_runtime_id_index)
        roots.push(self.enum_runtime_id_names)
        roots.push(self.lambda_bindings)
        roots.push(self.lambda_capture_snapshot)
        roots.push(self.current_has_vhdl_metadata)
        roots.push(self.current_gpu_kernel_target)
        roots.push(self.current_fn_returns_bool)
        roots.push(self.canonical_type_symbols)
        roots.push(self.next_canonical_type_symbol)
        roots.push(self.global_symbol_ids)
        roots.push(self.global_statics_by_id)
        roots.push(self.global_constants_by_id)
        roots.push(self.global_const_exprs)
        roots.push(self.array_global_mutation_warned)
        roots.push(self.target_context)
        roots.push(self.allow_ambient_bootstrap_policy)
        roots.push(self.resource_owned_locals)
        roots.push(self.consumed_resource_locals)
        # MirBuilder: every declared field, including optional/scalar carriers.
        roots.push(self.builder.module)
        roots.push(self.builder.current_function)
        roots.push(self.builder.current_block)
        roots.push(self.builder.next_local_id)
        roots.push(self.builder.next_block_id)
        roots.push(self.builder.locals)
        roots.push(self.builder.blocks)
        roots.push(self.builder.instructions)
        roots.push(self.builder.current_span)
        roots.push(self.builder.unwind_target)
        roots.push(self.builder.unwind_payload)
        roots.push(self.builder.unwind_type_tag)
        # MirModule: every declared field, including optional/scalar carriers.
        roots.push(self.builder.module.name)
        roots.push(self.builder.module.functions)
        roots.push(self.builder.module.statics)
        roots.push(self.builder.module.constants)
        roots.push(self.builder.module.types)
        roots.push(self.builder.module.external_layout_traces)
        # SymbolTable: every declared field, including optional/scalar carriers.
        roots.push(self.symbols.symbols)
        roots.push(self.symbols.scopes)
        roots.push(self.symbols.current_scope)
        roots.push(self.symbols.next_symbol_id)
        roots.push(self.symbols.next_scope_id)
        roots.push(self.symbols.gpu_function_targets)
        roots.push(self.symbols.gpu_function_backend_orders)
        roots.push(self.symbols.qualified_functions)
        roots.push(self.symbols.qualified_types)
        roots.push(self.symbols.exact_symbols)
        roots.push(self.symbols.module_callables)
        roots.push(self.symbols.root_scope_symbols)
        roots.push(self.symbols.structural_union_symbols)
        roots.push(self.symbols.structural_union_owners)
        # MirTargetContext: every declared field, including optional/scalar carriers.
        roots.push(self.target_context.arch)
        roots.push(self.target_context.os)
        roots.push(self.target_context.abi)
        roots.push(self.target_context.backend)
        roots.push(self.target_context.version)
        promote_and_release_transient_owner_roots(roots)
