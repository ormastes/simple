# Retained roots for the per-module MIR transient allocation boundary.
#
# The lowering and its nested aggregate carriers can predate the active scope.
# A raw carrier from an older scope is not traversable by this scope's runtime.
# Enumerate its children directly; also retain replacement carriers born in the
# current scope. The boundary gate checks these lists against the declarations.

use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.transient_owner_sffi.{promote_and_release_transient_owner_roots}

impl MirLowering:
    me promote_transient_owner() -> bool:
        """Retain the lowering's field roots while its module scope is paused.

        Each field is wrapped in a one-element temporary array, so a nil,
        scalar, or older-scope field is skipped as an array element instead of
        being refused as a root. Free only the temporary array; its retained
        child remains owned by the lowering. Mirror the HIR module-surface
        promotion boundary.
        """
        var ok = true
        # MirLowering: every declared field, including optional/scalar carriers.
        ok = promote_and_release_transient_owner_roots([self.builder]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_map]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_symbol_ids]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_symbol_values]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_symbol_index_slots]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_hir_type_ids]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_hir_type_values]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_hir_type_isolation_states]) and ok
        ok = promote_and_release_transient_owner_roots([self.local_hir_type_resource_states]) and ok
        ok = promote_and_release_transient_owner_roots([self.fn_return_types]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_function_symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_function_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.callable_link_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.loop_stack]) and ok
        ok = promote_and_release_transient_owner_roots([self.finally_stack]) and ok
        ok = promote_and_release_transient_owner_roots([self.unsafe_depth]) and ok
        ok = promote_and_release_transient_owner_roots([self.errors]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_module_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.native_trait_layouts]) and ok
        ok = promote_and_release_transient_owner_roots([self.native_trait_implementations]) and ok
        ok = promote_and_release_transient_owner_roots([self.native_trait_thunks]) and ok
        ok = promote_and_release_transient_owner_roots([self.composite_layout_digests]) and ok
        ok = promote_and_release_transient_owner_roots([self.composite_layout_owner_counts]) and ok
        ok = promote_and_release_transient_owner_roots([self.external_layout_traces]) and ok
        ok = promote_and_release_transient_owner_roots([self.type_transport_receipts]) and ok
        ok = promote_and_release_transient_owner_roots([self.type_transport_owner]) and ok
        ok = promote_and_release_transient_owner_roots([self.type_transport_context]) and ok
        ok = promote_and_release_transient_owner_roots([self.type_transport_param_index]) and ok
        ok = promote_and_release_transient_owner_roots([self.type_transport_caller_disc]) and ok
        ok = promote_and_release_transient_owner_roots([self.mir_tag_probe_active_function]) and ok
        ok = promote_and_release_transient_owner_roots([self.mir_tag_probe_pending_site]) and ok
        ok = promote_and_release_transient_owner_roots([self.mir_tag_probe_pending_caller_disc]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_mode]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_owner_bytes]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_global_bytes]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_include_csv]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_exclude_csv]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_next_runtime_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_active_decision_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_active_decision_semantic]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_next_condition_ordinal]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_active_dynamic_token]) and ok
        ok = promote_and_release_transient_owner_roots([self.mcdc_active_tokens]) and ok
        ok = promote_and_release_transient_owner_roots([self.field_map]) and ok
        ok = promote_and_release_transient_owner_roots([self.bitfield_map]) and ok
        ok = promote_and_release_transient_owner_roots([self.bitfield_value_syms]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_order]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_order_conflict_warned]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_has_default]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_default_expr]) and ok
        ok = promote_and_release_transient_owner_roots([self.class_type_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_type_ownership_key]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_type_name]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_repr_name]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_hir_type]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_bare_layout_owner]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_identity_layout_key]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_array_element_type_name]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_field_array_elem_type]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_value_syms]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_method_syms]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_method_ambiguous]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_method_return_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_method_return_is_array]) and ok
        ok = promote_and_release_transient_owner_roots([self.struct_method_return_is_optional]) and ok
        ok = promote_and_release_transient_owner_roots([self.trait_impl_owners]) and ok
        ok = promote_and_release_transient_owner_roots([self.trait_impl_methods]) and ok
        ok = promote_and_release_transient_owner_roots([self.trait_impl_closure_complete]) and ok
        ok = promote_and_release_transient_owner_roots([self.trait_impl_provider_modules]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_payload_struct_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_single_payload_types]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_payload_types]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_payload_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_payload_kind]) and ok
        ok = promote_and_release_transient_owner_roots([self.generic_enum_constructor_owners]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_tuple_text_slots]) and ok
        ok = promote_and_release_transient_owner_roots([self.runtime_array_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.runtime_dict_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.runtime_elem_value_type]) and ok
        ok = promote_and_release_transient_owner_roots([self.inferred_array_elem_state]) and ok
        ok = promote_and_release_transient_owner_roots([self.array_element_struct_syms]) and ok
        ok = promote_and_release_transient_owner_roots([self.runtime_value_local_ids]) and ok
        ok = promote_and_release_transient_owner_roots([self.tagged_text_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.option_value_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.nil_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_index]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_discriminants]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_owners]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_bare_name_collisions]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_index_q]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_variant_discriminants_q]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_runtime_id_index_q]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_runtime_to_bare]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_bare_ambiguous]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_runtime_id_index]) and ok
        ok = promote_and_release_transient_owner_roots([self.enum_runtime_id_names]) and ok
        ok = promote_and_release_transient_owner_roots([self.lambda_bindings]) and ok
        ok = promote_and_release_transient_owner_roots([self.lambda_capture_snapshot]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_has_vhdl_metadata]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_gpu_kernel_target]) and ok
        ok = promote_and_release_transient_owner_roots([self.current_fn_returns_bool]) and ok
        ok = promote_and_release_transient_owner_roots([self.canonical_type_symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.next_canonical_type_symbol]) and ok
        ok = promote_and_release_transient_owner_roots([self.global_symbol_ids]) and ok
        ok = promote_and_release_transient_owner_roots([self.global_statics_by_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.global_constants_by_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.global_const_exprs]) and ok
        ok = promote_and_release_transient_owner_roots([self.array_global_mutation_warned]) and ok
        ok = promote_and_release_transient_owner_roots([self.target_context]) and ok
        ok = promote_and_release_transient_owner_roots([self.allow_ambient_bootstrap_policy]) and ok
        ok = promote_and_release_transient_owner_roots([self.resource_owned_locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.consumed_resource_locals]) and ok
        # MirBuilder: every declared field, including optional/scalar carriers.
        ok = promote_and_release_transient_owner_roots([self.builder.module]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.current_function]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.current_block]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.next_local_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.next_block_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.locals]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.blocks]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.instructions]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.current_span]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.unwind_target]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.unwind_payload]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.unwind_type_tag]) and ok
        # MirModule: every declared field, including optional/scalar carriers.
        ok = promote_and_release_transient_owner_roots([self.builder.module.name]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.module.functions]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.module.statics]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.module.constants]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.module.types]) and ok
        ok = promote_and_release_transient_owner_roots([self.builder.module.external_layout_traces]) and ok
        # SymbolTable: every declared field, including optional/scalar carriers.
        ok = promote_and_release_transient_owner_roots([self.symbols.symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.scopes]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.current_scope]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.next_symbol_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.next_scope_id]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.gpu_function_targets]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.gpu_function_backend_orders]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.qualified_functions]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.qualified_types]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.exact_symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.module_callables]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.root_scope_symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.structural_union_symbols]) and ok
        ok = promote_and_release_transient_owner_roots([self.symbols.structural_union_owners]) and ok
        # MirTargetContext: every declared field, including optional/scalar carriers.
        ok = promote_and_release_transient_owner_roots([self.target_context.arch]) and ok
        ok = promote_and_release_transient_owner_roots([self.target_context.os]) and ok
        ok = promote_and_release_transient_owner_roots([self.target_context.abi]) and ok
        ok = promote_and_release_transient_owner_roots([self.target_context.backend]) and ok
        ok = promote_and_release_transient_owner_roots([self.target_context.version]) and ok
        ok
