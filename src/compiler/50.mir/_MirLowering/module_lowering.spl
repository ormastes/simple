pub fn mir_dynamic_module_init_name(module_name_path: text, bootstrap_module_index: i64 = -1) -> text:
    # The symbol is an external ABI a C shim may declare by its fixed name, so
    # it is derived from the repo-relative path, never the raw parsed one
    # (an SCV freeze parses from an absolute snapshot path).
    val module_name_raw = module_source_relative_path(module_name_path)
    var module_name = ""
    var has_identity_char = false
    var index = 0
    val count = module_name_raw.len()
    while index < count:
        val ch = module_name_raw.char_code_at(index)
        if (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or
           (ch >= 48 and ch <= 57) or ch == 95:
            module_name = module_name + module_name_raw.char_at(index)
            has_identity_char = true
        else:
            module_name = module_name + "_"
        index = index + 1
    var unique_name = module_name
    if not has_identity_char:
        var fallback_name = bootstrap_module_index
        if fallback_name < 0:
            fallback_name = hm_hash_text(module_name_raw)
            if fallback_name < 0:
                fallback_name = 0 - (fallback_name + 1)
        unique_name = "mod_" + fallback_name.to_text()
    elif bootstrap_module_index >= 0:
        unique_name = unique_name + "_" + bootstrap_module_index.to_text()
    "__module_init_" + unique_name + "_dynamic"
