    me use_explicit_semantic_policy():
        self.allow_ambient_bootstrap_policy = false

    me ambient_bootstrap_enabled() -> bool:
        self.allow_ambient_bootstrap_policy and
            (mir_lower_env_get("SIMPLE_BOOTSTRAP") ?? "") == "1"

    fn symbol_id_value(symbol: SymbolId) -> i64:
        symbol.id

    fn composite_layout_key(symbol: HirSymbol) -> text:
        # DELIBERATELY NOT normalized yet -- see the BLOCKER section of
        # doc/08_tracking/bug/mir_qualified_field_key_namespace_mismatch_2026-08-08.md.
        # Wrapping this in mir_layout_canonical_module_name() is the one-line
        # change that makes resolve_field_index's module-qualified tier
        # actually fire across an import, but on its own it is HARMFUL: the
        # CONSTRUCTION path (lower_struct_construct) is still bare-name keyed,
        # so a read newly resolved against the defining module's layout would
        # disagree with a write laid out from the collided bare key. Land it
        # only together with the struct_value_syms re-namespacing described
        # there.
        val defining_module = symbol.defining_module ?? ""
        if defining_module != "":
            return "{defining_module}::{symbol.name}"
        symbol.name

    me register_struct_identity_layout_key(symbol: HirSymbol, layout_key: text):
        """Record which layout key a struct DECLARATION registered, under its
        canonical `{dotted owner}::{Name}` identity (see
        struct_identity_layout_key). First declaration wins, matching the
        prescan's own first-wins metadata registration."""
        val owner = mir_layout_canonical_module_name(symbol.defining_module ?? "")
        if owner == "":
            return
        val identity = "{owner}::{symbol.name}"
        if not self.struct_identity_layout_key.has(identity):
            self.struct_identity_layout_key[identity] = layout_key

    fn declared_struct_layout_key(shape: text) -> text:
        """Fold a struct layout key onto the spelling its declaration
        registered. `shape` is returned unchanged when it already names a
        registered layout, or when no declaration owns its identity -- so an
        unknown name stays unknown instead of borrowing a same-named layout."""
        if shape == "" or self.struct_field_order.has(shape):
            return shape
        val separator = shape.rfind("::")
        if separator <= 0:
            return shape
        val owner = mir_layout_canonical_module_name(shape.substring(0, separator))
        val identity = "{owner}::{shape.substring(separator + 2)}"
        if self.struct_identity_layout_key.has(identity):
            return self.struct_identity_layout_key[identity]
        shape

    fn struct_owner_method_key(owner: text, method: text) -> text:
        """`{owner}::{method}` dispatch-row key for a receiver's recorded owner.

        A struct value is recorded under its qualified LAYOUT key
        (`{module}::{Name}`, composite_layout_key), while
        register_provider_method publishes a struct's methods under the
        callable identity `{dotted module}.{Name}`. Answer that row when the
        direct spelling has none; the module qualifier keeps a same-named
        struct of another module out."""
        val direct = "{owner}::{method}"
        if self.struct_method_syms.has(direct):
            return direct
        val separator = owner.rfind("::")
        if separator > 0:
            val identity_owner = mir_layout_canonical_module_name(owner.substring(0, separator))
            val identity_key = "{identity_owner}.{owner.substring(separator + 2)}::{method}"
            if self.struct_method_syms.has(identity_key):
                return identity_key
        direct

    fn canonical_layout_digest(fields: [HirField], layout_attr: LayoutAttr) -> text:
        val layout = compute_struct_layout(fields, layout_attr)
        var rows: [text] = ["size={layout.size};align={layout.align};stride={layout.stride}"]
        for raw_field in layout.fields:
            val field: FieldLayout = raw_field
            rows.push("field={field.name};offset={field.offset};size={field.size};align={field.align};bits={field.has_bits};width={field.bits_width};bit_offset={field.bit_offset}")
        sha256_text(rows.join("\n"))

    me register_composite_layout_identity(symbol: HirSymbol, fields: [HirField], layout_attr: LayoutAttr):
        self.register_composite_layout_digest_v1(symbol, self.canonical_layout_digest(fields, layout_attr))

    me register_composite_layout_digest_v1(symbol: HirSymbol, digest: text):
        val owner = mir_layout_canonical_module_name(symbol.defining_module ?? "")
        if owner == "":
            return
        # Trace identity is deliberately independent of the legacy composite
        # metadata key, whose raw path spelling can differ at import sites.
        val key = "{owner}::{symbol.name}"
        if self.composite_layout_digests.has(key):
            if self.composite_layout_digests[key] != digest:
                self.composite_layout_owner_counts[key] = 2
            return
        self.composite_layout_digests[key] = digest
        self.composite_layout_owner_counts[key] = 1

    me record_external_layout_reference(symbol: SymbolId):
        # Do not carry `HirSymbol?` across this boundary, and never call
        # `.unwrap()` on it. In a Stage-2 compiler this site's
        # `symbol_info.unwrap()` was bound to
        # `lib.nogc_async_mut.async.poll.Poll.unwrap` (disassembly of the
        # 2026-09-20 aarch64 Linux Stage 2: `bl Poll.unwrap` at
        # `record_external_layout_reference+192`). `Poll.unwrap` matches
        # neither Poll tag and returns 0, so `info` was a NULL pointer, not the
        # nil sentinel 3 -- the old `if info == nil: return` guard compared
        # 0 against 3, passed, and the `info.defining_module` load faulted at
        # address 0x48 for every program with a struct-typed local. Open
        # producer bug: doc/08_tracking/bug/unwrap_still_rebinds_to_poll_unwrap_at_closure_scale_2026-09-13.md.
        # The scalar readers keep the struct-valued Dict access inside
        # SymbolTable (same workaround as enum symbol resolution in
        # _MirLoweringExpr/switch_operators_calls.spl); "" means absent.
        val info_name = self.symbols.symbol_name_scalar_raw(symbol.id)
        if info_name == "":
            return
        var owner = mir_layout_canonical_module_name(self.symbols.symbol_defining_module_scalar_raw(symbol.id))
        var key = "{owner}::{info_name}"
        var owner_count = 0
        # Imported type symbols can retain the consumer filename in older HIR
        # transports. Resolve that lossy spelling only against layouts actually
        # prescanned in this lowering session, and retain ambiguity explicitly.
        if owner == "" or owner == self.current_module_id or
           not self.composite_layout_digests.has(key):
            val suffix = "::{info_name}"
            for candidate in self.composite_layout_digests.keys():
                if candidate.ends_with(suffix) and
                   not candidate.starts_with(self.current_module_id + "::"):
                    owner_count = owner_count + 1
                    if owner_count == 1:
                        key = candidate
                        owner = candidate[0:candidate.len() - suffix.len()]
        if owner_count == 0 and self.composite_layout_digests.has(key):
            owner_count = self.composite_layout_owner_counts[key]
        if owner == "" or owner == self.current_module_id or owner_count == 0:
            return
        for raw_trace in self.external_layout_traces:
            val trace: MirExternalLayoutTraceV1 = raw_trace
            if trace.owner_module_id == owner and trace.type_id == info_name:
                return
        self.external_layout_traces.push(MirExternalLayoutTraceV1(
            consumer_module_id: self.current_module_id,
            owner_module_id: owner, type_id: info_name,
            layout_digest: self.composite_layout_digests[key],
            owner_count: owner_count))

    me attach_external_layout_traces():
        var builder = self.builder
        var module = builder.module
        module.external_layout_traces = self.external_layout_traces
        builder.module = module
        self.builder = builder

    # Bare struct name for a `MirTypeKind.Struct(symbol)`.
    #
    # `canonical_mir_type_symbol` above MINTS ids from 1000000000 up that exist
    # only in `canonical_type_symbols` -- `symbols.get_symbol_raw` knows nothing
    # about them. So a consumer that only asked the symbol table got nil for
    # every canonicalized struct type and silently fell back to "unknown type".
    # That is what left `for f in d.values()` with no element struct name and
    # collapsed every field read to offset 0 (see the bug comment in
    # _MirLoweringExpr/method_calls_literals.spl's values/keys arm). Try the
    # real symbol table first, then reverse the canonical map, returning the
    # bare name (the segment after the last '.') because that is the form
    # `struct_value_syms` / `resolve_field_index` are keyed on.
    me mir_struct_symbol_name(symbol: SymbolId) -> text:
        match self.symbols.get_symbol_raw(symbol.id):
            case Some(info):
                if info != nil and info.name != "":
                    if info.kind == SymbolKind.Class: return mir_class_identity(info)
                    return info.name
            case None: ()
        val canonical_keys = self.canonical_type_symbols.keys()
        var cki = 0
        while cki < canonical_keys.len():
            val canonical_key = canonical_keys[cki]
            if self.canonical_type_symbols[canonical_key] == symbol.id:
                if self.class_type_names.has(canonical_key):
                    return canonical_key
                val canonical_parts = canonical_key.split(".")
                if canonical_parts.len() == 0: return canonical_key
                return canonical_parts[canonical_parts.len() - 1]
            cki = cki + 1
        ""

    me canonical_mir_type_symbol(symbol: SymbolId) -> SymbolId:
        val symbol_info = self.symbols.get_symbol_raw(symbol.id)
        match symbol_info:
            case Some(info):
                if info == nil: return symbol
                # Same two-namespace hazard as composite_layout_key (see
                # mir_layout_canonical_module_name): without normalization one
                # physical type reached via DECLARATION (path-form
                # defining_module) and via IMPORT (dotted-form) minted TWO
                # distinct canonical MIR type symbols, defeating the very
                # canonicalization this function exists to provide. Merging
                # them is strictly correct here -- the id is derived from the
                # key, so folding two spellings of one module onto one key
                # folds two ids that always denoted the same type.
                val raw_defining_module = match info.defining_module:
                    case Some(value): value
                    case None: ""
                val defining_module = mir_layout_canonical_module_name(raw_defining_module)
                if defining_module == "":
                    return symbol
                val key = "{defining_module}.{info.name}"
                if val id = self.canonical_type_symbols.get(key):
                    return SymbolId(id: id)
                val id = self.next_canonical_type_symbol
                self.next_canonical_type_symbol = id + 1
                self.canonical_type_symbols[key] = id
                SymbolId(id: id)
            case None:
                symbol

    me register_enum_runtime_name(runtime_name: text, enum_name: text, span: Span?):
        val runtime_id = (hm_hash_text(runtime_name) % 2147483646) + 2
        val id_key = "{runtime_id}"
        val existing = self.enum_runtime_id_names.get(id_key)
        if existing != nil and existing != runtime_name:
            val prior_name = existing ?? "<unknown>"
            self.error_fatal("enum runtime ID collision: '{prior_name}' and '{runtime_name}'", span)
            return
        self.enum_runtime_id_names[id_key] = runtime_name
        self.enum_runtime_id_index[enum_name] = runtime_id
        # Dual key (step c): runtime_name is unique per declaration, so this
        # write never evicts another enum's identity the way the bare-keyed
        # write above does.
        self.enum_runtime_id_index_q[runtime_name] = runtime_id

    me register_enum_runtime_id(enum_def: HirEnum):
        self.register_enum_runtime_name(enum_def.runtime_name, enum_def.name, Some(enum_def.span))

    me register_builtin_enum_dual(bare_name: text, names: [text], discriminants: [i64], runtime_id: i64):
        """Mirror a BUILT-IN enum seed (Option/Result) into the qualified maps.

        Option and Result are not carried in `module.enums`, so they never reach
        `register_enum_variants` and would otherwise be absent from the
        runtime_name-keyed maps -- making every qualified-first read for them
        fall back to the bare key. They have no owner module, so their
        runtime_name IS their bare name (declaration_lowering.spl:755 returns
        the bare name when owner_module is empty); seeding under `bare_name`
        therefore uses the same key the real registration would have used.

        Seeds only what is missing, exactly like the bare seeds it accompanies,
        so user code that legitimately declares its own `Option` still wins."""
        if not self.enum_variant_index_q.has(bare_name):
            self.enum_variant_index_q[bare_name] = names
            self.enum_variant_discriminants_q[bare_name] = discriminants
            self.enum_runtime_to_bare[bare_name] = bare_name
        if not self.enum_runtime_id_index_q.has(bare_name):
            self.enum_runtime_id_index_q[bare_name] = runtime_id

    me enum_variant_payload_arity(payload_key: text) -> i64:
        """Declared payload slot count for "{enum}::{variant}", 0 when unknown.

        Index-based counterpart to the arity-1-only
        `enum_single_payload_types` lookup: a caller that needs slot N asks
        this first and then `enum_variant_payload_type_at`."""
        self.ensure_declaration_enum_payloads_v1(payload_key)
        if val types = self.enum_variant_payload_types.get(payload_key):
            return types.len()
        return 0

    me enum_variant_payload_type_at(payload_key: text, index: i64) -> HirType?:
        """Declared type of payload slot `index`, nil when out of range.

        Slot 0 of an arity-1 Tuple is the same HirType the pre-existing
        `enum_single_payload_types[payload_key]` returns; that map is still
        consulted FIRST by its callers, so its behaviour is unchanged."""
        self.ensure_declaration_enum_payloads_v1(payload_key)
        if val types = self.enum_variant_payload_types.get(payload_key):
            if index >= 0 and index < types.len():
                return Some(types[index])
        return nil

    me enum_variant_payload_name_at(payload_key: text, index: i64) -> text:
        """Declared field name of payload slot `index`.

        Empty for positional (Tuple) slots and for an out-of-range index."""
        if val names = self.enum_variant_payload_names.get(payload_key):
            if index >= 0 and index < names.len():
                return names[index]
        return ""

    me enum_variant_payload_slot_of(payload_key: text, field_name: text) -> i64:
        """Declared slot index of a NAMED payload field, -1 when absent.

        Struct-variant field order is the source order recorded at
        registration, so this is the index a positional payload read uses."""
        if val names = self.enum_variant_payload_names.get(payload_key):
            var ni = 0
            while ni < names.len():
                if names[ni] == field_name:
                    return ni
                ni = ni + 1
        return -1

    me register_enum_variants(enum_def: HirEnum, store_payload_types: bool = true):
        """Register names and resolved portable runtime discriminants."""
        # Cycle-171: annotated rebind of the by-value HirEnum param --
        # field reads (name/runtime_name/variants) of the bare parameter
        # drew erased on candidate-seednew (corrupt qualified keys such
        # as 'DiagramGraphKind.CompileMode' and missing runtime ids in
        # the 56k-error MIR dump). Same bind-once family as cycle-169.
        val enum_def_r: HirEnum = enum_def
        if store_payload_types and self.declaration_repository != nil:
            self.declaration_enum_payload_owner[enum_def_r.name] = enum_def_r.runtime_name
        # SIMPLE_ENUM_REG_TRACE=1 (cycle-53 discriminator): capture the exact
        # name/runtime_name spellings at write time for the failing enum. A
        # mismatch between this runtime_name and the subject owner key built
        # by enum_qualified_key is the remaining suspect for the disc=0 /
        # is_unit=false asymmetry.
        if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1" and enum_def_r.name == "SdnValue":
            eprint("[enum-reg] register-enum module={self.current_module_id} name='{enum_def_r.name}' runtime_name='{enum_def_r.runtime_name}' variants={enum_def_r.variants.len()}")
        val generic_constructor = enum_def_r.type_params.len() > 0 or enum_def_r.is_generic_template
        self.generic_enum_constructor_owners[enum_def_r.name] = generic_constructor
        if enum_def_r.runtime_name != "":
            self.generic_enum_constructor_owners[enum_def_r.runtime_name] = generic_constructor
        var names: [text] = []
        var discriminants: [i64] = []
        var next_value: i64 = 0
        var vi = 0
        while vi < enum_def_r.variants.len():
            val variant: HirVariant = enum_def_r.variants[vi]
            var value = next_value
            if variant.has_discriminant:
                val folded = self.lower_const_expr(variant.discriminant)
                if val const_value = folded:
                    match const_value:
                        case Int(int_value): value = int_value
                        case _:
                            self.error_fatal("enum variant '{enum_def_r.name}.{variant.name}' discriminant must be an integer constant", Some(variant.span))
                else:
                    self.error_fatal("enum variant '{enum_def_r.name}.{variant.name}' discriminant must be a constant integer expression", Some(variant.span))
            if value < 0 or value > 2147483647:
                self.error_fatal("enum variant '{enum_def_r.name}.{variant.name}' discriminant {value} is outside portable runtime range 0..2147483647", Some(variant.span))
            var duplicate = false
            var di = 0
            while di < discriminants.len():
                if discriminants[di] == value:
                    duplicate = true
                di = di + 1
            if duplicate:
                self.error_fatal("enum '{enum_def_r.name}' has duplicate discriminant {value}", Some(variant.span))
            names.push(variant.name)
            discriminants.push(value)
            # Full payload registration (2026-08-21). The arity-1 Tuple write
            # into enum_single_payload_types below is UNCHANGED -- its readers
            # keep their exact previous behaviour -- and the three full-arity
            # maps are written alongside it for every variant, so match
            # lowering / payload extraction / layout can index slot N.
            var full_types: [HirType] = []
            var full_names: [text] = []
            var payload_kind = "unit"
            match variant.kind:
                case HirVariantKind.Tuple(payload_types):
                    payload_kind = "tuple"
                    var pti = 0
                    while pti < payload_types.len():
                        full_types.push(payload_types[pti])
                        full_names.push("")
                        pti = pti + 1
                case HirVariantKind.Struct(payload_fields):
                    payload_kind = "struct"
                    var pfi = 0
                    while pfi < payload_fields.len():
                        full_types.push(payload_fields[pfi].type_)
                        full_names.push(payload_fields[pfi].name)
                        pfi = pfi + 1
                case _: ()
            self.register_enum_payload_metadata_v1(enum_def_r.name, enum_def_r.runtime_name,
                variant.name, full_types, full_names, payload_kind, store_payload_types, true)
            next_value = value + 1
            vi = vi + 1
        # Bare-name collision registry (2026-08-01). enum_variant_index is keyed
        # by the BARE enum name and this write is LAST-WINS, so a same-bare-named
        # enum from another module evicts the set registered here. Record the
        # eviction when the variant sets DIVERGE, so that a later lookup miss can
        # NAME the colliding owner instead of returning a silent -1. Divergence
        # only -- an identical re-registration is benign and stays quiet.
        if self.enum_variant_index.has(enum_def_r.name):
            val prior_names = self.enum_variant_index[enum_def_r.name]
            if not _text_list_eq(prior_names, names):
                val prior_text = prior_names.join(", ")
                val new_text = names.join(", ")
                self.enum_bare_name_collisions[enum_def_r.name] = "previously registered as [{prior_text}], now overwritten by [{new_text}] (runtime_name '{enum_def_r.runtime_name}')"
                # Step (c) ambiguity flag. Readers that could not derive a
                # runtime_name and fell back to the bare key consult this to
                # tell "one enum owns this name" from "the survivor of a
                # contest". Set only on DIVERGENCE, so the 192 benign identical
                # re-registrations never raise it.
                self.enum_bare_ambiguous[enum_def_r.name] = true
        # Dual key (step c): the qualified maps are keyed by runtime_name, which
        # is unique per declaration, so BOTH sides of a bare-name contest are
        # retained here in full. Written before the bare maps below purely so a
        # reader observing a half-updated state sees the complete set, never a
        # partial one.
        self.enum_variant_index_q[enum_def_r.runtime_name] = names
        self.enum_variant_discriminants_q[enum_def_r.runtime_name] = discriminants
        self.enum_runtime_to_bare[enum_def_r.runtime_name] = enum_def_r.name
        # Captured BEFORE the bare-key write below, which is last-wins: these
        # are the variant leaves this owner currently contributes to
        # `enum_variant_owners` and must be withdrawn before the new set is
        # added, or an evicted leaf would keep naming this owner forever.
        val prior_variant_names: [text] = if self.enum_variant_index.has(enum_def_r.name):
            self.enum_variant_index[enum_def_r.name]
        else:
            []
        self.enum_variant_index[enum_def_r.name] = names
        self.reindex_enum_variant_owners(enum_def_r.name, prior_variant_names, names)
        self.enum_variant_discriminants[enum_def_r.name] = discriminants

    me register_enum_payload_metadata_v1(enum_name: text, runtime_name: text, variant: text,
            types: [HirType], names: [text], kind: text, store_types: bool = true, write_bare: bool = true):
        # Kind/names are ID-free and needed by unit-arm inference even before
        # a consumer demands nominal payload types. Keep the legacy tuple-only
        # bare single-slot rule and the qualified any-single-slot rule exact.
        if write_bare:
            val key = "{enum_name}::{variant}"
            self.enum_variant_payload_names[key] = names
            self.enum_variant_payload_kind[key] = kind
            if store_types:
                self.enum_variant_payload_types[key] = types
                if kind == "tuple" and types.len() == 1:
                    self.enum_single_payload_types[key] = types[0]
        if runtime_name != "":
            val key = "{runtime_name}::{variant}"
            self.enum_variant_payload_names[key] = names
            self.enum_variant_payload_kind[key] = kind
            if store_types:
                self.enum_variant_payload_types[key] = types
                if types.len() == 1:
                    self.enum_single_payload_types[key] = types[0]

    me register_module_enum_inventory_v1(modules: [HirModule]):
        """Register every given module's own enums, up front, before any
        per-module lowering runs.

        Measured gap (2026-10-16, manual stage3 per-module object sweep):
        compiling `src/compiler/di.spl` with the admitted stage2 binary failed
        in `compiler.common.config.CompilerProfile.to_text` with B5b "match
        has multiple wildcard/binding default arms (binding `Test`)". A
        two-module fixture (entry declaring a struct with an enum-typed
        static-fn parameter + a dependency whose own fn matches on its own
        enum's bare variants) reproduces it in ~4s: the dependency's `case X:`
        arms degrade to bindings whenever the entry's demand set does not
        cover the dependency's callables, because the only registration that
        would reach its enums is the per-module provider pass in lower_module,
        which skips `provider_module.name == module.name`. When that pass is
        demand-incomplete (or the module's HirModule no longer carries
        `module.enums` by the time its turn comes), the module's own match
        arms find an empty variant registry and the scalar gate rejects them.

        register_enum_variants reads only the HirEnum (no symbol table), and
        identical re-registration inside lower_module is quiet by the
        existing dedup rules, so calling this once over all scheduled source
        modules closes the gap without changing any per-module behaviour.
        Enum metadata is small (names + discriminants + payload shapes)
        relative to the struct-name prescan the driver already pays."""
        # Cycle-171: `modules` is an array whose bare index read drew on
        # candidate-seednew; the annotated rebind restores it (same
        # bind-once family as cycle-169), and the enum element read is
        # annotated on its way into register_enum_variants.
        var inv_module_i = 0
        while inv_module_i < modules.len():
            val inv_module: HirModule = modules[inv_module_i]
            val inventory_enum_values = inv_module.enums.values()
            var inventory_enum_i = 0
            while inventory_enum_i < inventory_enum_values.len():
                val inv_enum: HirEnum = inventory_enum_values[inventory_enum_i]
                self.register_enum_variants(inv_enum)
                inventory_enum_i = inventory_enum_i + 1

    me register_module_composite_inventory_v1(modules: [HirModule]):
        """Register every given module's own struct/class NAME-keyed layout
        rows, up front, before any per-module lowering runs. Struct/class
        analog of register_module_enum_inventory_v1 (#3527).

        What the existing up-front coverage already registers: the driver's
        struct-name prescan (prescan_module_struct_names) writes name-keyed
        struct field ORDER + declared field types for every module, and
        ID-free class layout identities. What it deliberately does NOT
        register, and what only each module's own lower_module pass
        registers today:

        - struct_field_has_default / struct_field_default_expr for STRUCTS
          (paren-constructor default fills read these by NAME).
        - every NAME-keyed CLASS row: class_type_names (bare name,
          composite layout key, and mir_class_identity) plus
          struct_field_order / struct_field_has_default /
          struct_field_default_expr under the same three keys. Param
          binding and value-method dispatch consult class_type_names to tell
          a class from a same-named value struct; a class whose module is
          lowered only AFTER its consumer (the direct lane lowers the entry
          first) or whose callables the entry never demands leaves those
          maps empty for exactly the window where the consumer lowers.

        Like the enum inventory, this reads only declaration data through
        the module's own SymbolTable (composite_layout_key / mir_class_identity
        take the declaring symbol) and writes NAME-keyed maps only:
        field_map is keyed by per-module SymbolIds and stays untouched.
        Rows use keep-first semantics on a name collision, matching the
        struct-name prescan; the module's own lower_module pass still
        overwrites unconditionally when its turn comes, so a module's local
        definition always shadows an imported same-name composite while that
        module is being lowered."""
        var composite_module_i = 0
        while composite_module_i < modules.len():
            val composite_module: HirModule = modules[composite_module_i]
            val composite_struct_keys: [SymbolId] = composite_module.structs.keys()
            var composite_struct_i = 0
            while composite_struct_i < composite_struct_keys.len():
                val composite_struct_key: SymbolId = composite_struct_keys[composite_struct_i]
                # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                val composite_struct: HirStruct = composite_module.structs[composite_struct_key]
                if composite_struct == nil:
                    composite_struct_i = composite_struct_i + 1
                    continue
                if not self.struct_field_has_default.has(composite_struct.name):
                    var struct_has_default: [bool] = []
                    var struct_default_expr: [HirExpr] = []
                    var composite_field_i = 0
                    while composite_field_i < composite_struct.fields.len():
                        struct_has_default.push(composite_struct.fields[composite_field_i].has_default)
                        struct_default_expr.push(composite_struct.fields[composite_field_i].default)
                        composite_field_i = composite_field_i + 1
                    self.struct_field_has_default[composite_struct.name] = struct_has_default
                    self.struct_field_default_expr[composite_struct.name] = struct_default_expr
                composite_struct_i = composite_struct_i + 1
            val composite_class_keys: [SymbolId] = composite_module.classes.keys()
            var composite_class_i = 0
            while composite_class_i < composite_class_keys.len():
                val composite_class_key: SymbolId = composite_class_keys[composite_class_i]
                # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                val composite_class: HirClass = composite_module.classes[composite_class_key]
                if composite_class == nil:
                    composite_class_i = composite_class_i + 1
                    continue
                var class_field_names: [text] = []
                var class_has_default: [bool] = []
                var class_default_expr: [HirExpr] = []
                var class_field_i = 0
                while class_field_i < composite_class.fields.len():
                    class_field_names.push(composite_class.fields[class_field_i].name)
                    class_has_default.push(composite_class.fields[class_field_i].has_default)
                    class_default_expr.push(composite_class.fields[class_field_i].default)
                    class_field_i = class_field_i + 1
                var class_keys: [text] = [composite_class.name]
                # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                val optional_composite_class_symbol: HirSymbol? = composite_module.symbols.get_symbol_raw(composite_class.symbol.id)
                if val present_composite_class_symbol = optional_composite_class_symbol:
                    val composite_class_symbol: HirSymbol = present_composite_class_symbol
                    class_keys.push(self.composite_layout_key(composite_class_symbol))
                    class_keys.push(mir_class_identity(composite_class_symbol))
                var class_key_i = 0
                while class_key_i < class_keys.len():
                    val class_key: text = class_keys[class_key_i]
                    self.class_type_names[class_key] = true
                    if not self.struct_field_order.has(class_key):
                        self.struct_field_order[class_key] = class_field_names
                    if not self.struct_field_has_default.has(class_key):
                        self.struct_field_has_default[class_key] = class_has_default
                    if not self.struct_field_default_expr.has(class_key):
                        self.struct_field_default_expr[class_key] = class_default_expr
                    class_key_i = class_key_i + 1
                composite_class_i = composite_class_i + 1
            composite_module_i = composite_module_i + 1


    # O(1) inverse of `enum_variant_index`, maintained at every bare-key write.
    # `prior_names` is the variant set this owner previously had registered
    # under the same bare key (empty on a first registration); those entries are
    # withdrawn before the new ones are added, so the divergent last-wins
    # eviction path in `register_enum` cannot leave a stale owner behind.
    #
    # Kept exactly equivalent to the full-keyspace scan it replaces: the scan
    # accepted an owner only when the variant leaf occurred under exactly ONE
    # key of `enum_variant_index`, which is precisely a single-element list
    # here. The scan itself ran once per method call and allocated a fresh
    # `.keys()` array each time -- the phase-5 MIR allocation runaway.
    me reindex_enum_variant_owners(owner_name: text, prior_names: [text], names: [text]):
        for prior_variant in prior_names:
            if self.enum_variant_owners.has(prior_variant):
                var kept_owners: [text] = []
                for existing_owner in self.enum_variant_owners[prior_variant]:
                    if existing_owner != owner_name:
                        kept_owners.push(existing_owner)
                self.enum_variant_owners[prior_variant] = kept_owners
        for variant_name in names:
            var current_owners: [text] = if self.enum_variant_owners.has(variant_name):
                self.enum_variant_owners[variant_name]
            else:
                []
            var owner_already_listed = false
            for existing_owner in current_owners:
                if existing_owner == owner_name:
                    owner_already_listed = true
            if not owner_already_listed:
                current_owners.push(owner_name)
            self.enum_variant_owners[variant_name] = current_owners

    fn hir_bitfield_fields(bitfield_def: HirBitfield) -> [HirBitfieldField]:
        match bitfield_def:
            case HirBitfield(_, _, _, fields, _, _, _, _, _, _):
                fields

    fn hir_module_function(module: HirModule, symbol: SymbolId) -> HirFunction:
        val target_id = self.symbol_id_value(symbol)
        if target_id < 0:
            return HirFunction(
                symbol: symbol,
                name: "",
                type_params: [],
                params: [],
                return_type: HirType(kind: HirTypeKind.Int(64, true), span: Span.empty()),
                body: HirBlock(stmts: [], has: false, value: nil, span: Span.empty()),
                effects: [],
                visibility: Visibility.Private,
                is_async: false,
                is_static: false,
                is_public: false,
                is_method: false,
                is_mutable: false,
                is_const: false,
                is_extern: true,
                func_attr: FunctionAttr.default(),
                has_export_attr: false,
                export_attr: nil,
                has_driver_manifest_attr: false,
                driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
                has_suspension: false,
                has_vhdl_metadata: false,
                vhdl_metadata: vhdl_hardware_metadata_default(),
                has_doc_comment: false,
                doc_comment: "",
                span: Span.empty(),
                verification_contract: nil
            )
        # Cycle-91 playbook form: materialized keys + guard-first double access.
        val function_keys_39_values: [HirFunction] = module.functions.values()
        for raw_fn_ in function_keys_39_values:
            val fn_: HirFunction = raw_fn_
            val fn_id = self.symbol_id_value(fn_.symbol)
            if fn_id == target_id:
                return fn_
        HirFunction(
            symbol: symbol,
            name: "",
            type_params: [],
            params: [],
            return_type: HirType(kind: HirTypeKind.Int(64, true), span: Span.empty()),
            body: HirBlock(stmts: [], has: false, value: nil, span: Span.empty()),
            effects: [],
            visibility: Visibility.Private,
            is_async: false,
            is_static: false,
            is_public: false,
            is_method: false,
            is_mutable: false,
            is_const: false,
            is_extern: true,
            func_attr: FunctionAttr.default(),
            has_export_attr: false,
            export_attr: nil,
            has_driver_manifest_attr: false,
            driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
            has_suspension: false,
            has_vhdl_metadata: false,
            vhdl_metadata: vhdl_hardware_metadata_default(),
            has_doc_comment: false,
            doc_comment: "",
            span: Span.empty(),
            verification_contract: nil
        )

    fn hir_function_is_extern(fn_: HirFunction) -> bool:
        fn_.is_extern

    me bootstrap_function_signature(name: text) -> MirSignature:
        MirSignature(params: [], return_type: self.bootstrap_call_return_type(name), is_variadic: false)

    fn bootstrap_default_return_operand(return_type: MirType) -> MirOperand?:
        if return_type.kind == MirTypeKind.Unit:
            return nil
        # Explicit tail: mixed return/implicit-tail returns 0 on the stage4
        # native lane — non-unit bootstrap stubs then fed a garbage Ret
        # payload into the adapter (SIGILL in cl_translate_operand). The Some
        # box itself is CORRECT here (Ret payload consumers are box-paired).
        return Some(MirOperand(kind: MirOperandKind.Const(MirConstValue.Zero, return_type)))

    me lower_bootstrap_stub_function(symbol: SymbolId, name: text) -> MirFunction:
        if mir_lower_trace_enabled():
            print "[mir-lower] bootstrap-stub:start {name}"
        val signature = self.bootstrap_function_signature(name)
        var bldr = self.builder
        bldr.begin_function(symbol, name, signature, nil)
        bldr.terminate_return(self.bootstrap_default_return_operand(signature.return_type))
        val fn_result = bldr.end_function()
        self.builder = bldr
        if mir_lower_trace_enabled():
            print "[mir-lower] bootstrap-stub:done {name}"
        fn_result

    me lower_bootstrap_flat_function(symbol: SymbolId, name: text, body: HirBlock) -> MirFunction:
        if name == "bootstrap_version":
            if mir_lower_trace_enabled():
                print "[mir-lower] bootstrap-known:bootstrap_version"
            val str_type = MirType(kind: MirTypeKind.Opaque("str"))
            val signature = MirSignature(params: [], return_type: str_type, is_variadic: false)
            var bldr_known = self.builder
            bldr_known.begin_function(symbol, name, signature, nil)
            val dest = bldr_known.new_temp(str_type)
            bldr_known.emit_const(dest, MirConstValue.Str("0.9.8"), str_type)
            bldr_known.terminate_return(Some(mir_operand_copy(dest)))
            val fn_result = bldr_known.end_function()
            self.builder = bldr_known
            return fn_result

        if name == "native_build_help":
            if mir_lower_trace_enabled():
                print "[mir-lower] bootstrap-known:native_build_help"
            val signature = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
            var bldr_known = self.builder
            bldr_known.begin_function(symbol, name, signature, nil)
            val result = bldr_known.emit_const_int(0)
            bldr_known.terminate_return(Some(mir_operand_copy(result)))
            val fn_result = bldr_known.end_function()
            self.builder = bldr_known
            return fn_result

        if mir_lower_trace_enabled():
            print "[mir-lower] bootstrap-flat:start {name}"
        self.reset_function_local_tracking()
        val signature = self.bootstrap_function_signature(name)
        var bldr = self.builder
        bldr.begin_function(symbol, name, signature, nil)
        self.builder = bldr
        val result = self.lower_block(body)
        var bldr2 = self.builder
        if not bldr2.current_block_has_explicit_terminator():
            if result.?:
                bldr2.terminate_return(Some(mir_operand_copy(result ?? LocalId(id: 0))))
            else:
                bldr2.terminate_return(self.bootstrap_default_return_operand(signature.return_type))
        self.builder = bldr2
        var bldr3 = self.builder
        val fn_result = bldr3.end_function()
        self.builder = bldr3
        if mir_lower_trace_enabled():
            print "[mir-lower] bootstrap-flat:done {name}"
        fn_result

    fn asm_version_constraint_op(vc: AsmVersionConstraint) -> text:
        vc.op

    fn asm_version_constraint_value(vc: AsmVersionConstraint) -> i64:
        vc.version

    fn asm_target_spec_archs(spec: AsmTargetSpec) -> [text]:
        spec.archs

    fn asm_target_spec_has_os(spec: AsmTargetSpec) -> bool:
        spec.has_os

    fn asm_target_spec_os(spec: AsmTargetSpec) -> text:
        spec.os

    fn asm_target_spec_has_abi(spec: AsmTargetSpec) -> bool:
        spec.has_abi

    fn asm_target_spec_abi(spec: AsmTargetSpec) -> text:
        spec.abi

    fn asm_target_spec_has_backend(spec: AsmTargetSpec) -> bool:
        spec.has_backend

    fn asm_target_spec_backend(spec: AsmTargetSpec) -> text:
        spec.backend

    me register_struct_type_param_names(name: text, type_params: [HirTypeParam]):
        """Record a generic struct's type-parameter names in declaration
        order (empty for a non-generic struct), keyed like the field maps."""
        var names: [text] = []
        for tp in type_params:
            val tpt: HirTypeParam = tp
            names.push(tpt.name)
        if names.len() > 0 or not self.struct_type_param_names.has(name):
            self.struct_type_param_names[name] = names

    me register_composite_field_metadata(name: text, fields: [HirField], symbols: SymbolTable, overwrite: bool):
        var declaration_names: [text] = []
        var declaration_types: [HirType] = []
        var declaration_spans: [Span] = []
        for raw_field in fields:
            val field: HirField = raw_field
            declaration_names.push(field.name)
            declaration_types.push(field.type_)
            declaration_spans.push(field.span)
        self.register_composite_field_metadata_types_v1(name, declaration_names, declaration_types, declaration_spans, symbols, overwrite)

    me register_composite_field_metadata_types_v1(name: text, declaration_names: [text], declaration_types: [HirType], declaration_spans: [Span], symbols: SymbolTable, overwrite: bool):
        """Register name-keyed struct/class field metadata."""
        if declaration_names.len() != declaration_types.len() or declaration_names.len() != declaration_spans.len():
            self.error_fatal("composite declaration field/type inventory mismatch: {name}", nil)
            return
        self.register_result_err_layout_types_fields_v1(name, declaration_names, declaration_types, symbols)
        var field_names: [text] = []
        var field_type_names: [text] = []
        var field_type_ownership_keys: [text] = []
        var field_repr_names: [text] = []
        var field_hir_types: [HirType] = []
        var field_array_element_type_names: [text] = []
        var field_elem_types: [HirType] = []
        var field_type_params: [text] = []
        var field_over_type_params: [bool] = []
        var fi = 0
        while fi < declaration_names.len():
            val field_type: HirType = declaration_types[fi]
            field_names.push(declaration_names[fi])
            var field_type_name = ""
            var field_type_ownership_key = ""
            var field_repr_name = ""
            var field_array_element_type_name = ""
            var field_type_param = ""
            var field_elem_type = HirType(kind: HirTypeKind.Error, span: declaration_spans[fi])
            var field_hir_type = HirType(kind: HirTypeKind.Error, span: declaration_spans[fi])
            if field_type != nil:
                field_hir_type = field_type
                match field_type.kind:
                    case Str:
                        field_repr_name = "str"
                    case TypeParam(tp_name, _):
                        field_type_param = tp_name
                    case Function(_, _, _):
                        field_type_ownership_key = "function-signature-v1\n" + self.function_signature_ownership_proof(field_type, symbols)
                    case Named(field_type_sym, _):
                        # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                        val optional_field_type_symbol: HirSymbol? = symbols.get_symbol_raw(field_type_sym.id)
                        if val present_field_type_symbol = optional_field_type_symbol:
                            val field_type_symbol: HirSymbol = present_field_type_symbol
                            if field_type_symbol.kind == SymbolKind.TypeParam:
                                # `a: A` of `struct Pair<A, B>`: not a struct
                                # named A -- the instance decides (BUG-IT-6).
                                field_type_param = field_type_symbol.name
                            else:
                                field_type_name = field_type_symbol.name
                                field_type_ownership_key = self.composite_layout_key(field_type_symbol)
                                if field_type_symbol.kind == SymbolKind.Class:
                                    field_type_name = mir_class_identity(field_type_symbol)
                                    field_type_ownership_key = field_type_name
                                elif field_type_symbol.kind == SymbolKind.Enum:
                                    # Projected enum methods use the provider's
                                    # canonical owner, not a bare layout name.
                                    # Keep the separate HIR rebinding key above.
                                    field_type_name = mir_class_identity(field_type_symbol)
                    case HirTypeKind.Function(_, field_return, _):
                        # The callback value is not a record, but its named
                        # return type still belongs to the declaring table.
                        # Retain that exact owner for importer-side rebinding.
                        match field_return.kind:
                            case HirTypeKind.Named(return_symbol, _):
                                if val return_owner = symbols.get_symbol_raw(return_symbol.id):
                                    field_type_ownership_key = self.composite_layout_key(return_owner)
                                    if return_owner.kind == SymbolKind.Class:
                                        field_type_ownership_key = mir_class_identity(return_owner)
                            case _: ()
                    case Array(field_element_type, _):
                        # Bug (native_class_array_field_mutation_segfault /
                        # native_bool_array_element_interpolation_special_garbage,
                        # 2026-07-17): field_array_element_type_name above
                        # only preserves a NAME (a nested-array sentinel or a
                        # struct/class symbol name) -- not enough to tell a
                        # primitive bool/text/i64/f64 element apart from any
                        # other, so a primitive-element array field's reads
                        # still decoded as raw i64 downstream (bool printed
                        # as its tag int; text printed as its raw heap-handle
                        # number). Keep the full declared element HirType too
                        # so the Field-access lowering can build the correct
                        # primitive MIR type for the field-read result,
                        # matching the class of bug commit 4539b364955 fixed
                        # for split()-produced arrays.
                        field_elem_type = field_element_type
                        match field_element_type.kind:
                            # This describes the ELEMENT, not the outer field.
                            # Marking [u16] as nested made index reads decode a
                            # numeric slot as an array handle/pointer; scalar/
                            # text elements must not be decoded or copied as
                            # nested array handles.
                            case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                                field_array_element_type_name = "__runtime_array__"
                            case Named(field_element_sym, _):
                                # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                                val optional_field_element_symbol: HirSymbol? = symbols.get_symbol_raw(field_element_sym.id)
                                if val present_field_element_symbol = optional_field_element_symbol:
                                    val field_element_symbol: HirSymbol = present_field_element_symbol
                                    # Only aggregates carry a provider layout. An
                                    # enum element (e.g. modifiers:
                                    # [SdoctestModifier]) has no struct provider
                                    # layout; recording composite_layout_key for
                                    # it made the record-array check demand one
                                    # and fail the build. Enums stay word-tagged
                                    # values, not runtime arrays.
                                    if field_element_symbol.kind == SymbolKind.Class or
                                            field_element_symbol.kind == SymbolKind.Struct:
                                        field_array_element_type_name = self.composite_layout_key(field_element_symbol)
                                        if field_element_symbol.kind == SymbolKind.Class:
                                            field_array_element_type_name = mir_class_identity(field_element_symbol)
                                        field_type_ownership_key = field_array_element_type_name

                            case _: ()
                    case Slice(field_slice_element_type):
                        field_elem_type = field_slice_element_type
                        match field_slice_element_type.kind:
                            case HirTypeKind.Array(_, _) | HirTypeKind.Slice(_):
                                field_array_element_type_name = "__runtime_array__"
                            case Named(field_slice_element_sym, _):
                                # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                                val optional_field_slice_element_symbol: HirSymbol? = symbols.get_symbol_raw(field_slice_element_sym.id)
                                if val present_field_slice_element_symbol = optional_field_slice_element_symbol:
                                    val field_slice_element_symbol: HirSymbol = present_field_slice_element_symbol
                                    if field_slice_element_symbol.kind == SymbolKind.Class or
                                            field_slice_element_symbol.kind == SymbolKind.Struct:
                                        field_array_element_type_name = self.composite_layout_key(field_slice_element_symbol)
                                        if field_slice_element_symbol.kind == SymbolKind.Class:
                                            field_array_element_type_name = mir_class_identity(field_slice_element_symbol)
                                        field_type_ownership_key = field_array_element_type_name

                            case _: ()
                    case _: ()
            field_type_names.push(field_type_name)
            field_type_ownership_keys.push(field_type_ownership_key)
            field_repr_names.push(field_repr_name)
            field_hir_types.push(field_hir_type)
            field_array_element_type_names.push(field_array_element_type_name)
            field_elem_types.push(field_elem_type)
            field_type_params.push(field_type_param)
            var field_over_type_param = false
            if field_type_param == "" and field_type != nil:
                field_over_type_param = self.hir_type_mentions_type_param(field_type, symbols)
            field_over_type_params.push(field_over_type_param)
            fi = fi + 1
        if overwrite or not self.struct_field_type_param.has(name):
            self.struct_field_type_param[name] = field_type_params
            self.struct_field_over_type_param[name] = field_over_type_params
        # Field-index-collision diagnostic (stage3 borrow-checker SIGSEGV,
        # 2026-08-07): ~1,500 struct/class names are duplicated across
        # src/{compiler,lib,app}. A bare-name re-registration with a
        # DIFFERENT field list silently overwrote (overwrite=true) or was
        # silently dropped against (overwrite=false) the existing entry with
        # ZERO diagnostics, so every bare-name field lookup for that type was
        # ambiguous across modules of an entry-closure build. Warn ONCE per
        # bare name; an identical re-registration (same field list) stays
        # silent, and module-qualified '<module>::<Name>' keys (from
        # composite_layout_key) were assumed never to collide.
        #
        # That exemption is NO LONGER SOUND (bug
        # mir_qualified_field_key_namespace_mismatch_2026-08-08):
        # composite_layout_key now normalizes defining_module through
        # mir_layout_canonical_module_name, which DROPS all-digit tier
        # segments and folds `std.` -> `lib.`. Those rules exist to collapse
        # the path/dotted spellings of ONE module, but they could in
        # principle merge two genuinely distinct modules onto one key -- and
        # then `overwrite: false` first-wins would hand the qualified tier a
        # CONFIDENTLY WRONG layout, which is worse than the ambiguous bare
        # key it replaced. So qualified keys warn too: this is the only
        # canary for a normalization over-merge.
        if self.struct_field_order.has(name):
            val existing_fields = self.struct_field_order[name]
            var fields_differ = existing_fields.len() != field_names.len()
            if not fields_differ:
                var cmp_i = 0
                while cmp_i < existing_fields.len():
                    if existing_fields[cmp_i] != field_names[cmp_i]:
                        fields_differ = true
                    cmp_i = cmp_i + 1
            if fields_differ and not self.struct_field_order_conflict_warned.contains(name):
                self.struct_field_order_conflict_warned[name] = true
                val kept_side = if overwrite: "keeping NEW" else: "keeping EXISTING"
                val key_kind = if name.contains("::"): "QUALIFIED key — the module-name normalizer over-merged two distinct modules; this is a NORMALIZER BUG, not an ordinary bare-name collision" else: "bare-name field-index lookups for this type are ambiguous across modules — module-qualified keys stay correct"
                print "[mir-lower] WARNING: struct/class name '{name}' re-registered with a DIFFERENT field list (existing=[{existing_fields.join(", ")}] vs new=[{field_names.join(", ")}]; {kept_side}); {key_kind} (field-index collision, 2026-08-07)"
        if overwrite or not self.struct_field_order.has(name):
            self.struct_field_order[name] = field_names
        if overwrite or not self.struct_field_type_name.has(name):
            self.struct_field_type_name[name] = field_type_names
        if overwrite or not self.struct_field_type_ownership_key.has(name):
            self.struct_field_type_ownership_key[name] = field_type_ownership_keys
        if overwrite or not self.struct_field_repr_name.has(name):
            self.struct_field_repr_name[name] = field_repr_names
        if overwrite or not self.struct_field_hir_type.has(name):
            self.struct_field_hir_type[name] = field_hir_types
        if overwrite or not self.struct_field_array_element_type_name.has(name):
            self.struct_field_array_element_type_name[name] = field_array_element_type_names
        if overwrite or not self.struct_field_array_elem_type.has(name):
            self.struct_field_array_elem_type[name] = field_elem_types

    # Cycle-144 endgame: dict+key passing. The feed array's modules were
    # copy-corrupted at the big-host push site (cycle-141/144); the module
    # is bound HERE (mono's process_modules precedent) from the caller's
    # dict, and every functions walk goes through the param-only codec
    # getters (hir_fn_scalars_in_v1 -- the encode-proven access class).
    me prescan_module_struct_names(modules: Dict<text, HirModule>, module_key: text):
        if not modules.has(module_key):
            return
        val prescan_module_value: HirModule = modules[module_key]
        val structs: Dict<SymbolId, HirStruct> = prescan_module_value.structs
        val classes: Dict<SymbolId, HirClass> = prescan_module_value.classes
        val module_name: text = prescan_module_value.name
        val module_symbols: SymbolTable = prescan_module_value.symbols
        bootstrap_default_provider_register(mir_layout_canonical_module_name(module_name),
            module_symbols, prescan_module_value.constants.values())
        """Cross-module struct/class-name prepass (field-index SEGV).

        Entry-closure lowering iterates modules on ONE shared MirLowering,
        and the ENTRY module is lowered BEFORE the dependency modules it
        imports. A field read on an imported struct value (`state.driver`
        where DisplayState lives in another module) therefore found nothing
        in struct_field_order — the provider module's structs had not been
        registered yet — and resolve_field_index silently fell back to
        field index 0, reading `frame_id` as the `driver` pointer (SIGSEGV
        at address 7). Callers that loop several HIR modules over one
        MirLowering must call this for EVERY module before lowering ANY of
        them, so imported struct layouts resolve regardless of lowering
        order.

        NAME-keyed maps only: field_map is keyed by per-module numeric
        SymbolIds which collide across modules (each module has its own
        SymbolTable), so it must never be filled cross-module. Existing
        entries are kept (first module wins on a name collision); the
        module's own registration in lower_module still overwrites
        unconditionally at lowering time, so a module's local definition
        always shadows an imported same-name struct while that module is
        being lowered.

        Also derives struct_field_type_name from the DECLARED field types
        (`driver: FramebufferDriver`), so chained access off an imported
        nested struct (`state.driver.width`, bug #166 mechanism) resolves
        too — the construct-site prescan that normally fills that map runs
        per-module and hits the same ordering gap."""
        val prescan_struct_values = structs.values()
        var psi = 0
        while psi < prescan_struct_values.len():
            # Annotated rebind: .values() element through ANY (stage2
            # composite-transport hazard; 2026-10-16).
            val struct_def: HirStruct = prescan_struct_values[psi]
            # register_composite_field_metadata (above) now also captures
            # each field's declared array ELEMENT HirType into
            # struct_field_array_elem_type, so this call alone covers both
            # the struct-name/repr bookkeeping and the primitive-element
            # bool/text decode fix (native_class_array_field_mutation_segfault
            # / native_bool_array_element_interpolation_special_garbage,
            # 2026-07-17) -- no separate inline loop needed here.
            val bare_layout_was_free = not self.struct_field_order.has(struct_def.name)
            self.register_composite_field_metadata(struct_def.name, struct_def.fields, module_symbols, false)
            self.register_struct_type_param_names(struct_def.name, struct_def.type_params)
            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
            val optional_struct_symbol: HirSymbol? = module_symbols.get_symbol_raw(struct_def.symbol.id)
            if val present_struct_symbol = optional_struct_symbol:
                val struct_symbol: HirSymbol = present_struct_symbol
                val struct_key = self.composite_layout_key(struct_symbol)
                self.register_result_err_layout_types(struct_key, struct_def.fields, module_symbols)
                if bare_layout_was_free:
                    self.struct_bare_layout_owner[struct_def.name] = struct_key
                if struct_key != struct_def.name:
                    self.register_composite_field_metadata(struct_key, struct_def.fields, module_symbols, false)
                    self.register_struct_identity_layout_key(struct_symbol, struct_key)
                    self.register_struct_type_param_names(struct_key, struct_def.type_params)
                val struct_attr = if struct_def.has_layout_attr: struct_def.layout_attr else: layoutattr_default_()
                self.register_composite_layout_identity(struct_symbol, struct_def.fields, struct_attr)
            psi = psi + 1
        val prescan_class_values = classes.values()
        psi = 0
        while psi < prescan_class_values.len():
            val class_def: HirClass = prescan_class_values[psi]
            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
            val optional_class_symbol: HirSymbol? = module_symbols.get_symbol_raw(class_def.symbol.id)
            if val present_class_symbol = optional_class_symbol:
                val class_symbol: HirSymbol = present_class_symbol
                # Types/defaults are relocated after each consumer installs
                # its own SymbolTable. This prepass only records ID-free layout.
                val class_attr = if class_def.has_layout_attr: class_def.layout_attr else: layoutattr_default_()
                self.register_result_err_layout_types(mir_class_identity(class_symbol), class_def.fields, module_symbols)
                self.register_composite_layout_identity(class_symbol, class_def.fields, class_attr)
            psi = psi + 1
        # Same ordering gap for CALL RETURN TYPES: the entry module lowers
        # before its dependency modules, so a cross-module call's declared
        # return type was unknown and defaulted to the erased i64 — on
        # 32-bit targets the caller then read the a0/a1 REGISTER PAIR of an
        # i32-returning callee (garbage high word OR'd into every result;
        # NVMe rv32 fw mask-361, 2026-07-24). Register every free fn's
        # declared HIR return type name-keyed (ambiguous duplicates are
        # never answered — see mir_data.spl).
        # Cycle-100: moved to prescan_module_functions_v1 (fresh-method
        # draw; both keys+index (cycle-91 crash) and values for-in
        # (cycle-100 crash) draw corrupted in this function's body).
        # Cycle-109: pass the functions DICT, not the module -- a dict is a
        # reference-typed handle, so the call-site copy is a single pointer
        # (the HirModule by-value arg copy at this big call site is the
        # cycle-109 corruptor: the callee's .values() then produced a garbage
        # array, faulting on the first element deref).
        self.prescan_module_functions_v1(modules, module_key, module_name, module_symbols)

    # Cycle-100: the per-function prescan body of prescan_module_struct_names,
    # hosted in a fresh method. Both prior extraction shapes drew corrupted
    # inside the caller: keys+index crashed the dict probe (cycle-91) and
    # values for-in rebind corrupted the element that register_provider_callable_link
    # then read through its by-value param (cycle-100 shim, same callee as
    # cycle-91). The module crosses by value (proven transport); no large
    # composite crosses back.
    me prescan_module_functions_v1(modules: Dict<text, HirModule>, module_key: text,
            module_name: text, module_symbols: SymbolTable):
        # Cycle-129: NO owner-field round-trip. MirLowering's struct header
        # documents that field mutations do not reliably persist (Stage4
        # native reason); the cycle-129 shim faulted on the field-read
        # handle inside hir_fn_scalars_at_v1 even though the write happened
        # two lines earlier in the same function. The values array crosses
        # as a pure EXPRESSION argument straight into the codec pool -- no
        # local, no field, no bind. (The dict HANDLE param transport from
        # cycle-108/109 stays: reference copy at the call site, C-level
        # rt_dict_values.)
        # Cycle-144: param-only codec extraction via dict+key -- the
        # encode-proven access class (hir_fn_scalars_in_v1 /
        # hir_module_functions_count_in_v1). No .values(), no binds of the
        # module or keys anywhere on this path.
        val prescan_fn_count: i64 = hir_module_functions_count_in_v1(modules, module_key)
        var psi = 0
        while psi < prescan_fn_count:
            val prescan_scalars = hir_fn_scalars_in_v1(modules, module_key, psi)
            self.prescan_one_function_v1(module_name, module_symbols,
                prescan_scalars[0], prescan_scalars[1], prescan_scalars[2],
                prescan_scalars[3], prescan_scalars[4], prescan_scalars[5],
                prescan_scalars[6], prescan_scalars[7], prescan_scalars[8])
            psi = psi + 1

    # Cycle-102: per-function prescan body; prescan_fn is the by-value
    # param (no caller-side named bind of the for-in element).
    # Cycle-106: scalar-feed signature. The HirFunction by-value param's
    # prologue copy drew corrupted in this big host (cycle-106 shim: the
    # register_provider_callable_link_fields_v1 marshalling faulted on the
    # param spill); the tiny caller now reads every needed field off the
    # for-in element as EXPRESSIONS (the has_rt_hal class) and only
    # scalars/small composites cross.
    me prescan_one_function_v1(module_name: text, module_symbols: SymbolTable, fn_symbol: SymbolId,
            fn_name: text, fn_is_extern: bool, fn_is_method: bool,
            fn_is_static: bool, fn_has_export_attr: bool,
            fn_attr: FunctionAttr, fn_return_type: HirType,
            fn_params: [HirParam]):
        # Cycle-113 inline shield: the MIR FunctionInliner absorbs this body
        # into prescan_one_extracted_v1 (same 635-line function at cycles
        # 111/112 despite the cross-unit move -- MIR-level inlining predates
        # object splitting), recreating the big-host prologue-copy crash.
        # The inliner NEVER inlines recursive functions (policy.spl
        # is_recursive: any self-name call matches), so this unreachable
        # self-reference pins this body as a real call boundary. The sentinel
        # can never be true: module_name comes from the module path
        # normalizer and never contains NUL.
        if module_name == "\u0000inline-shield-self-call":
            self.prescan_one_function_v1(module_name, module_symbols, fn_symbol,
                fn_name, fn_is_extern, fn_is_method, fn_is_static,
                fn_has_export_attr, fn_attr, fn_return_type, fn_params)
        # Cycle-101/106: register_provider_callable_link's HirFunction-param
        # read draw is defective, and the cycle-106 shim proved this big
        # host's own HirFunction prologue copy corrupts too (the fields_v1
        # marshalling faulted on the param spill). The caller now feeds
        # scalars/small composites extracted as element expressions.
        self.register_provider_callable_link_fields_v1(module_name, module_symbols,
            fn_symbol, fn_name, fn_is_extern,
            fn_is_method, fn_is_static, fn_has_export_attr,
            fn_attr, false)
        val prescan_call_name = mir_provider_function_name_fields_v1(module_name, module_symbols,
            fn_symbol, fn_name, fn_is_extern, fn_has_export_attr, fn_attr, false)
        var prescan_return_shape = ""
        match fn_return_type.kind:
            case Named(prescan_return_symbol_id, _):
                # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                val optional_prescan_return_symbol: HirSymbol? = module_symbols.get_symbol_raw(prescan_return_symbol_id.id)
                if val present_prescan_return_symbol = optional_prescan_return_symbol:
                    val prescan_return_symbol: HirSymbol = present_prescan_return_symbol
                    prescan_return_shape = self.composite_layout_key(prescan_return_symbol)
                    if prescan_return_symbol.kind == SymbolKind.Class:
                        prescan_return_shape = mir_class_identity(prescan_return_symbol)
            case Array(prescan_element_type, _) | Slice(prescan_element_type):
                prescan_return_shape = "__runtime_array__"
                var prescan_element_shape = "__no_struct_element__"
                var prescan_element_identity = "__no_struct_element__"
                # Resolve while this module owns the SymbolId space.
                # A caller cannot safely look up an imported element id.
                match prescan_element_type.kind:
                    case Named(prescan_element_id, _):
                        # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                        val optional_prescan_element: HirSymbol? = module_symbols.get_symbol_raw(prescan_element_id.id)
                        if val present_prescan_element = optional_prescan_element:
                            val prescan_element: HirSymbol = present_prescan_element
                            match prescan_element.kind:
                                case SymbolKind.Class:
                                    prescan_element_shape = mir_class_identity(prescan_element)
                                    prescan_element_identity = self.composite_layout_key(prescan_element)
                                case SymbolKind.Struct:
                                    prescan_element_shape = self.composite_layout_key(prescan_element)
                                    prescan_element_identity = prescan_element_shape
                                case _: ()
                    case _: ()
                # Include scalar arrays in ambiguity detection so a name
                # collision cannot lend a struct layout to an integer.
                val array_return_names = [fn_name, prescan_call_name,
                    prescan_call_name.replace("-", "_"),
                    prescan_call_name.replace("::", "."),
                    prescan_call_name.replace("-", "_").replace("::", ".")]
                for array_return_name in array_return_names:
                    bootstrap_fn_ret_array_element_shape_register(
                        array_return_name, prescan_element_shape, prescan_element_identity)
                    bootstrap_fn_ret_shape_register(array_return_name, "__runtime_array__")
            case Result(prescan_ok_type, prescan_err_type):
                match prescan_err_type.kind:
                    case Named(err_symbol_id, _):
                        if val err_symbol = module_symbols.get_symbol_raw(err_symbol_id.id):
                            match err_symbol.kind:
                                case Class:
                                    bootstrap_fn_ret_err_shape_register(prescan_call_name, mir_class_identity(err_symbol))
                                case Struct:
                                    bootstrap_fn_ret_err_shape_register(prescan_call_name, self.composite_layout_key(err_symbol))
                                case _: ()
                    case _: ()
                # Ok-payload struct/class layout key, resolved HERE while
                # `module_symbols` is still the DEFINING module's own
                # self-consistent table (see bootstrap_fn_ret_ok_shape_
                # register's doc comment in mir_data.spl for why this
                # can't be deferred to the consumer).
                match prescan_ok_type.kind:
                    case Named(prescan_ok_symbol_id, _):
                        # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                        val optional_prescan_ok_symbol: HirSymbol? = module_symbols.get_symbol_raw(prescan_ok_symbol_id.id)
                        if val present_prescan_ok_symbol = optional_prescan_ok_symbol:
                            val prescan_ok_symbol: HirSymbol = present_prescan_ok_symbol
                            match prescan_ok_symbol.kind:
                                case Class:
                                    bootstrap_fn_ret_ok_shape_register(prescan_call_name, mir_class_identity(prescan_ok_symbol))
                                case Struct:
                                    # Bare name, matching the spelling
                                    # `struct_value_syms`/`lookup_or_invalid`
                                    # consumers expect downstream
                                    # (method_calls_literals.spl's
                                    # unresolved-owner recovery) -- NOT
                                    # composite_layout_key's module-
                                    # qualified form, which those bare
                                    # name-keyed lookups never match.
                                    bootstrap_fn_ret_ok_shape_register(
                                        prescan_call_name, prescan_ok_symbol.name)
                                case _: ()
                    case _: ()
            case Optional(prescan_optional_inner):
                # Exact sibling of the Result arm above, and closed for the
                # same reason it was: this `match` had no Optional arm, so a
                # callee declared `-> T?` registered NO payload name at all.
                # The call result then reached MIR with no struct_value_syms
                # entry, `if val fp = <that call>` aliased the same local,
                # and `fp.size` fell through resolve_field_index's name-keyed
                # tier into the numeric-SymbolId field_map tier (which
                # collides across modules in an entry-closure build) and
                # finally to a silent index 0 -- reading `path`, a text
                # POINTER, as the i64 `size`. Resolved HERE, while
                # `module_symbols` is still the DEFINING module's own
                # self-consistent table, so no consumer has to dereference a
                # foreign per-module SymbolId. Record the defining owner
                # for structs as well as classes; a stored Optional must
                # not capture an importer declaration with the same leaf.
                match prescan_optional_inner.kind:
                    case Named(prescan_optional_symbol_id, _):
                        # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                        val optional_prescan_optional_symbol: HirSymbol? = module_symbols.get_symbol_raw(prescan_optional_symbol_id.id)
                        if val present_prescan_optional_symbol = optional_prescan_optional_symbol:
                            val prescan_optional_symbol: HirSymbol = present_prescan_optional_symbol
                            match prescan_optional_symbol.kind:
                                case Class:
                                    bootstrap_fn_ret_opt_shape_register(prescan_call_name, mir_class_identity(prescan_optional_symbol))
                                case Struct:
                                    bootstrap_fn_ret_opt_shape_register(
                                        prescan_call_name, self.composite_layout_key(prescan_optional_symbol))
                                case _: ()
                    case _: ()
            case _: ()
        bootstrap_fn_ret_shape_register(prescan_call_name, prescan_return_shape)
        # Trailing-default pad registry. Registered for EVERY function
        # (free, static method, instance method) and under BOTH spellings,
        # because this prescan is the only pass that sees all modules
        # before any is lowered -- a cross-module callee has no other
        # pre-lowering source for its declared defaults. See
        # bootstrap_fn_param_defaults_register in mir_data.spl and
        # doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md.
        val default_owner = mir_layout_canonical_module_name(module_name)
        bootstrap_fn_param_defaults_register(fn_name, fn_params, default_owner)
        if prescan_call_name != fn_name:
            bootstrap_fn_param_defaults_register(prescan_call_name, fn_params, default_owner)
            val prescan_defaults_sanitized = prescan_call_name.replace("-", "_")
            if prescan_defaults_sanitized != prescan_call_name:
                bootstrap_fn_param_defaults_register(prescan_defaults_sanitized, fn_params, default_owner)
        # `symbol_to_operand` (method_calls_literals.spl:3207) ALWAYS
        # rewrites the symbol's raw "Owner::method" spelling to
        # "Owner.method" before it ever reaches `direct_call_extern_name`,
        # so a method-call lookup against the raw "::" spelling above
        # would miss even for a SAME-module instance/static method.
        # Register the dot-joined spelling too so the pad's lookup key
        # matches exactly what the call site actually looks up.
        if prescan_call_name.contains("::"):
            val prescan_defaults_dotted = prescan_call_name.replace("::", ".")
            if prescan_defaults_dotted != prescan_call_name:
                bootstrap_fn_param_defaults_register(prescan_defaults_dotted, fn_params, default_owner)
        if not fn_is_method:
            bootstrap_fn_ret_hir_type_register(fn_name, fn_return_type)
        # Cross-module METHOD return types (native_build_cross_module_
        # result_payload_struct_name_collision_2026-08-09 mechanism #2):
        # a method's SYMBOL name is already owner-qualified
        # ("{module}.{Type}::{method}") and therefore globally unique, so
        # registering the declared return HirType under it is
        # collision-free. resolved_call_hir_return_type's name-keyed
        # lookup (found_sym.name) then recovers e.g. `FileHandle.open`'s
        # `Result<FileHandle, text>` while lowering the ENTRY module,
        # before the defining dependency module has been lowered --
        # module.impls/struct_method_syms never carry inline class
        # methods, so this registry is the only pre-lowering source.
        if prescan_call_name != fn_name:
            bootstrap_fn_ret_hir_type_register(prescan_call_name, fn_return_type)
            # The IMPORTING module's symbol table spells the same method
            # with `_hir_symbol_owner_module`-sanitized module segments
            # (dashes -> underscores), while the defining module's own
            # symbol keeps the raw directory-derived name. Register the
            # sanitized spelling too so the importing-side name-keyed
            # lookup hits.
            val prescan_sanitized_name = prescan_call_name.replace("-", "_")
            if prescan_sanitized_name != prescan_call_name:
                bootstrap_fn_ret_hir_type_register(prescan_sanitized_name, fn_return_type)
            var prescan_param_tys: [HirType] = []
            for prescan_param in fn_params:
                prescan_param_tys.push(prescan_param.type_)
            bootstrap_fn_param_hir_types_register(fn_name, prescan_param_tys)
    me register_builtin_enum_seeds():
        """Register the built-in Result/Option variant and runtime-identity
        seeds. Extracted from lower_module's tail (2026-10-17) so lanes that
        bypass the non-bootstrap tail -- the stage3 bootstrap-fixed entry
        lane above all -- can apply the same seeds. Seeds only what is
        missing, so a user declaration of the same name still wins."""
        if not self.enum_variant_index.has("Result"):
            self.enum_variant_index["Result"] = ["Ok", "Err"]
            self.reindex_enum_variant_owners("Result", [], ["Ok", "Err"])
            self.enum_variant_discriminants["Result"] = [0, 1]
        if not self.enum_runtime_id_index.has("Result"):
            self.enum_runtime_id_index["Result"] = 0
        self.register_builtin_enum_dual("Result", ["Ok", "Err"], [0, 1], 0)

        # Register the built-in Option enum so bare-variant construction
        # (`Some(v)` / `None`) and `match o: case Some(v)/None` resolve the same
        # discriminants (Some=0, None=1, matching the stdlib `enum Option`
        # declaration order). Option is not carried in module.enums. Skip if
        # user code shadows the name.
        if not self.enum_variant_index.has("Option"):
            self.enum_variant_index["Option"] = ["Some", "None"]
            self.reindex_enum_variant_owners("Option", [], ["Some", "None"])
            self.enum_variant_discriminants["Option"] = [0, 1]
        if not self.enum_runtime_id_index.has("Option"):
            self.enum_runtime_id_index["Option"] = 1
        self.register_builtin_enum_dual("Option", ["Some", "None"], [0, 1], 1)

    me register_module_enum_bootstrap_inventory_v1(modules: [HirModule]):
        """Register every given module's own enums (variants AND runtime
        ids) plus the built-in Result/Option seeds, up front, before a
        bootstrap-lane lowering runs.

        Measured gap (stage3 frontier, 2026-10-17, site-19): the
        bootstrap-fixed stage3 lane lowers app.cli.bootstrap_main through
        lower_module's bootstrap-flat branch on a fresh MirLowering. That
        branch returns before the non-bootstrap tail, so NONE of the tail's
        registration runs on this instance: not the module's own
        module.enums loop, not the built-in Option/Result seeds, and (with
        the empty provider list this lane passes) no dependency enums
        either. The stage3 build therefore died with "enum construction:
        missing runtime identity for 'Option'" and "enum construction:
        unregistered declaration 'compiler.common.driver_core_modes.
        CompileMode'" at the entry's construction sites, while stage2 --
        built by the Rust seed, which seeds a GLOBAL enum sidecar across
        the whole closure (reserved Result/Option lane 0/1) before lowering
        -- compiled the same entry fine. The other Simple lanes never hit
        this because their registration arrives from a different pass
        (bootstrap_globals' per-module flat type defs, or lower_module's
        provider loops); only this lane bypasses all of them.

        register_enum_variants / register_enum_runtime_id read only the
        HirEnum (no symbol table), the seeds guard on has() so re-runs are
        quiet, and the module's own tail registration overwrites
        unconditionally if it ever runs."""
        # Cycle-171: `modules[i]` (Dict<text, HirModule> index read) draws
        # erased on candidate-seednew -- measured as 65k 'enum construction:
        # unregistered declaration' MIR errors whose lookup keys were clean
        # but the registry missed whole modules. Iterate keys() and extract
        # with an annotated rebind (the proven cycle-76 transport), the same
        # pattern driver_rt_criticality uses for Dict<text, HirModule>.
        for raw_inventory_module in modules.keys():
            val inventory_module_key: text = raw_inventory_module
            val inventory_module: HirModule = modules[inventory_module_key]
            val inventory_enums = inventory_module.enums.values()
            var inventory_enum_i = 0
            while inventory_enum_i < inventory_enums.len():
                val inventory_enum_def: HirEnum = inventory_enums[inventory_enum_i]
                self.register_enum_variants(inventory_enum_def)
                self.register_enum_runtime_id(inventory_enum_def)
                inventory_enum_i = inventory_enum_i + 1
        self.register_builtin_enum_seeds()

    me lower_bootstrap_entry_module(module: HirModule) -> MirModule:
        """Lower the stage3 fixed-entry module (`app.cli.bootstrap_main`).

        The stage3 bootstrap-fixed lane used to call `lower_module(hir)`: one
        argument, both defaults omitted, under a method name `HirLowering`
        also declares with that one-argument arity. The natively compiled
        stage2 died at that call with an access violation on every phase-3
        build, while `lower_module_transient_scoped(hir, providers, is_entry)`
        - three explicit arguments - lowered the same module on the same
        binary. This entry is named by no other class and forwards every
        argument explicitly, the call shape the direct lane already proves.
        doc/08_tracking/bug/stage3_bootstrap_fixed_lower_module_segv_2026-10-11.md"""
        val no_providers: [HirModule] = []
        self.lower_module(module, no_providers, true)

    me lower_module_transient_scoped(module: HirModule, providers: [HirModule] = [], is_entry_module: bool = true) -> Result<MirModule, text>:
        """`lower_module` with the per-module lowering arena reclaimed.

        One HIR module's lowering allocates an arena of intermediates — the
        per-function local/type sidecars, the block and instruction graphs
        that generic MIR construction rebuilds, every interpolated diagnostic
        and layout-key text — and none of it is reachable once the MirModule
        exists. Nothing in the compiler ever freed it, so the arena is
        immortal and the compiler IS the leak
        (doc/08_tracking/bug/native_build_worker_interpreter_heap_grows_unbounded_2026-08-17.md).

        Escape set, enumerated rather than assumed (this is what makes the
        boundary safe, and the reason the ambient-bootstrap path is excluded):

        1. the returned `MirModule` — promoted;
        2. everything `lower_module` writes into the lowering itself
           (`errors`, `composite_layout_*`, `struct_field_*`, `builder`,
           `external_layout_traces`, ... — these accumulate ACROSS modules on
           the shared `--entry-closure` instance) — promoted through an
           explicit managed inventory in `transient_owner.spl`. The lowering
           and nested carriers can predate the scope, so promoting `self`
           cannot traverse their new children. The boundary gate compares
           the inventory with the owner declarations to catch field drift;
        3. reverse-reference facts are captured in a per-module batch, promoted
           independently and published only after this scope ends. Other
           module-level mutable globals: 50.mir's non-bootstrap
           heap-typed globals are `mir_data.spl:_mir_trace_scope_slot` (an
           i64 array whose writes store no heap value) and
           `mir_bitfield.spl:BITFIELD_REGISTRY` (read-only — it has no write
           site anywhere in the tree); 25.traits, 40.mono and 30.types
           declare no heap-typed globals; the only 35.semantics import is the
           bool READER `rt_hal_compilation_requires_finalize`; the only
           15.blocks import is the `BlockValue` type; and none of the std
           modules 50.mir imports (`std.array`, `std.io_runtime`,
           `std.common.crypto.sha256`, `std.common.encoding.sha256_contract`,
           `std.common.mcdc.model`, `std.nogc_sync_mut.io.process_ops`,
           `std.nogc_sync_mut.sffi.system`) declares a module-level `var`.

        AMBIENT BOOTSTRAP escape set, now enumerated and promoted (previously
        excluded -- see
        doc/08_tracking/bug/native_build_worker_interpreter_heap_grows_unbounded_2026-08-17.md
        for the census). That path additionally writes the flat
        `_bootstrap_mir_*` registries (`_MirLowering/bootstrap_globals.spl`)
        and `mir_data.spl`'s `_bootstrap_fn_*` dicts. Both accumulate ACROSS
        modules by design (a later module's cross-module call/prescan lookup
        reads an earlier module's row) and are read again after the whole
        entry-closure loop ends (70.backend's `bootstrap_llvm_name_index_ensure`
        reads `_bootstrap_mir_function_names`), so a value written into them
        during module i's scope must survive module i's `scope_end`.
        `bootstrap_mir_registries_promote` / `bootstrap_fn_registries_promote`
        promote every OUTER array/dict (not just the newly pushed/inserted
        element), matching 20.hir's proven `bootstrap_hir_modules_promote_last`
        pattern (hir_lowering/_Items/lowering_helpers.spl), because `.push()`/
        dict-insert can reallocate the backing store while a scope is active
        and that reallocation must be adopted too. 20.hir's `_bootstrap_hir_*`
        arrays are OUT OF SCOPE here -- they are written and promoted inside
        their OWN per-file transient scope in
        `driver_hir_pipeline_lowering.spl:lower_streaming_surface_source`,
        a phase that completes before this one ever runs."""
        # The scope is thread-local and non-reentrant: `begin` returns false
        # when one is already live. Reclamation is an optimisation and must
        # never be the reason a module fails to lower, so a refused scope
        # falls back to exactly today's unscoped behaviour.
        val scope_trace = mir_scope_trace_selected_v1(mir_lower_env_get("SIMPLE_MIR_SCOPE_TRACE_MODULE") ?? "", module.name)
        var scope_decisions: i64 = 0
        if not transient_array_scope_begin_v1():
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 0))
            return Ok(self.lower_module(module, providers, is_entry_module))
        scope_decisions = scope_decisions | 1
        val reverse_token = reverse_reference_module_begin_v1()
        if reverse_token < 0:
            val _ended = transient_array_scope_end_v1()
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 1))
            return Err("transient MIR scope reverse-reference owner unavailable for {module.name}")
        val lowered: MirModule = self.lower_module(module, providers, is_entry_module)
        # Function-local lookup tables are scratch. The completed MIR owns its
        # locals/blocks, while cross-module declaration/default/layout facts
        # have separate retained roots. Clear these before promotion so the
        # last function's transient indexes can be reclaimed with this scope.
        self.reset_function_local_tracking()
        # These consumer-local trait lookup tables are rebuilt at the start of
        # every lower_module. Promoting them here makes obsolete versions
        # immortal after the next module replaces their roots. All synchronous
        # lambda lowering has returned; emitted signatures/vtables and thunks
        # remain reachable through lowered and the retained builder/thunk roots.
        # Detach only the lookup roots while the scope still owns allocations;
        # do not free their children, which may alias completed MIR or HIR.
        self.native_trait_layouts = []
        self.native_trait_implementations = []
        # Provider method dispatch rows contain consumer-local SymbolIds and
        # return-shape hints, rebuilt by lower_module for every consumer.
        # All synchronous method/lambda lowering has completed. Keep the MIR
        # call operands/signatures and shared declaration facts; retire only
        # these obsolete lookup roots before their allocations are promoted.
        self.struct_method_syms = {}
        self.struct_method_ambiguous = {}
        self.struct_method_return_names = {}
        self.struct_method_return_is_array = {}
        self.struct_method_return_is_optional = {}
        # Only lower_module's completed prescan/emission loops read this
        # .values() scratch array. Do not promote a second owner of HIR bodies.
        # The input HIR and returned MIR keep their own retained roots.
        self.lower_emit_fn_values = []
        # From here every exit path must close the scope. `end` frees the
        # arena, so any path that ends WITHOUT a successful promotion must
        # also refuse to hand `lowered` back.
        if not transient_array_scope_pause_v1():
            val _ended_pause = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 2))
            return Err("transient MIR scope pause failed for {module.name}")
        scope_decisions = scope_decisions | 2
        if not transient_heap_promote_v1(lowered):
            val _ended_module = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 3))
            return Err("MIR module ownership promotion failed for {module.name}")
        scope_decisions = scope_decisions | 4
        # The owner's field roots overlap heavily (builder.*, symbols.*). One
        # share window over the straight-line promote sequence walks the
        # common graph once instead of once per root; it only promotes and
        # releases temporary carriers, which is the window's contract.
        val _owner_share_opened = transient_heap_promote_share_begin_v1()
        val owner_promoted = self.promote_transient_owner()
        val _owner_share_closed = transient_heap_promote_share_end_v1()
        if not owner_promoted:
            val _ended_owner = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 4))
            return Err("MIR lowering owner promotion failed for {module.name}")
        scope_decisions = scope_decisions | 8
        if not bootstrap_mir_registries_promote():
            val _ended_mir_registries = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 5))
            return Err("bootstrap MIR registry promotion failed for {module.name}")
        scope_decisions = scope_decisions | 16
        if not bootstrap_fn_registries_promote():
            val _ended_fn_registries = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 6))
            return Err("bootstrap fn registry promotion failed for {module.name}")
        scope_decisions = scope_decisions | 32
        if not reverse_reference_module_seal_v1(reverse_token):
            val _ended_reverse = mir_abort_reverse_reference_scope_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 7))
            return Err("reverse-reference ownership promotion failed for {module.name}")
        scope_decisions = scope_decisions | 64
        if not transient_array_scope_end_v1():
            val _aborted = reverse_reference_module_abort_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 8))
            return Err("transient MIR scope end failed for {module.name}")
        scope_decisions = scope_decisions | 128
        if not reverse_reference_module_publish_v1(reverse_token):
            val _aborted = reverse_reference_module_abort_v1(reverse_token)
            if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 9))
            return Err("reverse-reference publication failed for {module.name}")
        scope_decisions = scope_decisions | 256
        if scope_trace: eprint(mir_scope_decision_trace_line_v1(scope_decisions, 10))
        Ok(lowered)

    me record_exact_extern_declaration_v1(declaration: HirFunction):
        # HIR exposes fixed parameters only. Generic/default/method and
        # adapted text signatures must retain their existing lowering.
        if not declaration.is_extern or declaration.is_method or declaration.is_async or declaration.type_params.len() != 0 or declaration.is_generic_template:
            return
        if not mir_exact_extern_type_v1(declaration.return_type, true):
            return
        var parameters: [MirType] = []
        for raw_parameter in declaration.params:
            val parameter: HirParam = raw_parameter
            if parameter.has_default or not mir_exact_extern_type_v1(parameter.type_, false):
                return
            parameters.push(self.lower_type(parameter.type_))
        if declaration.symbol.id < 0:
            return
        var signatures = self.exact_extern_signatures
        signatures[declaration.symbol.id] = MirSignature(params: parameters,
            return_type: self.lower_type(declaration.return_type), is_variadic: false,
            params_known: true)
        self.exact_extern_signatures = signatures

    me lower_module(module: HirModule, providers: [HirModule] = [], is_entry_module: bool = true,
            archive_function_symbols: [i64]? = nil, archive_primary_globals: MirModule? = nil,
            archive_trait_thunks: [MirFunction] = []) -> MirModule:
        """Lower HIR module to MIR."""
        self.unsafe_depth = 0
        self.current_module_id = mir_layout_canonical_module_name(module.name)
        # SIMPLE_ENUM_REG_TRACE=1 progression receipt (cycle-54/55 MIR livelock
        # localization): brackets every module's lowering so the next failing
        # cycle's last printed module is the one whose pass spins.
        if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
            eprint("[enum-reg] lower-module-start module={module.name} functions={module.functions.len()} enums={module.enums.len()}")
        self.external_layout_traces = []
        self.collection_literal_operands = {}
        self.collection_literal_ordinals = {}
        self.symbols = module.symbols
        if self.declaration_repository != nil:
            # These HirTypes contain consumer-local numeric IDs. Scalar enum
            # identities/kinds and deferred declaration indexes survive; type
            # arrays are rebound lazily only when this consumer reads them.
            self.enum_variant_payload_types = {}
            self.enum_single_payload_types = {}
            self.declaration_enum_payload_owner = {}
        # Provider SymbolIds are module-local: rebuild and relocate trait
        # metadata whenever the active consumer symbol table changes.
        self.native_trait_layouts = []
        self.native_trait_implementations = []
        var retained_thunks: [MirFunction] = []
        # Cycle-169 (candidate-seednew 2026-10-19): the bare for-in read of the
        # defaulted `archive_trait_thunks` parameter drew erased on the first
        # bootstrap-fixed closure module (SIGSEGV in _rt_for_iterable's length
        # load, lower_module+804, deterministic per binary). Bind the parameter
        # ONCE into an annotated local -- the rebind restores the value (the
        # cycle-71 ANY-transport pattern used throughout this file) -- and
        # iterate the local, exactly the p2_add cycles 91-105 "bind once, guard
        # the local" treatment for per-read draw corruption.
        val archived_thunks_in: [MirFunction] = archive_trait_thunks
        for raw_thunk in archived_thunks_in:
            val thunk: MirFunction = raw_thunk
            retained_thunks.push(thunk)
        self.native_trait_thunks = retained_thunks
        self.register_native_trait_declarations(module)
        for raw_trait_provider in providers:
            val trait_provider: HirModule = raw_trait_provider
            if trait_provider.name != module.name:
                self.register_native_trait_declarations(trait_provider)
        if self.declaration_repository != nil:
            self.register_declaration_provider_traits_v1(module, false)
        self.register_native_trait_implementations(module)
        for raw_trait_provider in providers:
            val trait_provider: HirModule = raw_trait_provider
            if trait_provider.name != module.name:
                self.register_native_trait_implementations(trait_provider)
        if self.declaration_repository != nil:
            self.register_declaration_provider_traits_v1(module, true)
        self.exact_extern_signatures = {}
        # E-MIR-TYPE-Error rate limit is per module (see lower_type).
        self.mir_type_error_reports = {}
        val function_keys_37_values: [HirFunction] = module.functions.values()
        for raw_declaration in function_keys_37_values:
            val declaration: HirFunction = raw_declaration
            self.record_exact_extern_declaration_v1(declaration)
        self.record_imported_exact_extern_modules_v1(module.name, providers)
        self.lowering_entry_module = is_entry_module
        var function_names: [text] = []
        val function_keys_36_values: [HirFunction] = module.functions.values()
        for raw_func in function_keys_36_values:
            val func: HirFunction = raw_func
            # Cycle-101: same defective callee draw as the prescan site above.
            self.register_provider_callable_link_fields_v1(module.name, module.symbols,
                func.symbol, func.name, func.is_extern, func.is_method,
                func.is_static, func.has_export_attr, func.func_attr, is_entry_module)
            function_names.push(mir_provider_function_name(module.name, module.symbols, func, is_entry_module))
        self.current_function_names = function_names
        # Cross-module prescans keep the first definition. The module being
        # lowered is authoritative for its own same-name struct/class.
        val local_struct_values = module.structs.values()
        var local_meta_i = 0
        while local_meta_i < local_struct_values.len():
            # Annotated rebind: .values() elements travel through ANY; the
            # stage2-compiled compiler faults reading fields off an
            # unannotated extraction (same hazard class as the
            # runtime_module_initializers_in_declaration_order index-sort
            # fix, 2026-10-16 -- first fired on test_runner_main's
            # struct/class/enum tables, which main.spl leaves empty).
            val struct_def: HirStruct = local_struct_values[local_meta_i]
            self.register_composite_field_metadata(struct_def.name, struct_def.fields, module.symbols, true)
            self.register_struct_type_param_names(struct_def.name, struct_def.type_params)
            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
            val optional_struct_symbol: HirSymbol? = module.symbols.get_symbol_raw(struct_def.symbol.id)
            if val present_struct_symbol = optional_struct_symbol:
                val struct_symbol: HirSymbol = present_struct_symbol
                val struct_key = self.composite_layout_key(struct_symbol)
                self.struct_bare_layout_owner[struct_def.name] = struct_key
                if struct_key != struct_def.name:
                    self.register_composite_field_metadata(struct_key, struct_def.fields, module.symbols, true)
                    self.register_struct_identity_layout_key(struct_symbol, struct_key)
                    self.register_struct_type_param_names(struct_key, struct_def.type_params)
            local_meta_i = local_meta_i + 1
        val local_class_values = module.classes.values()
        local_meta_i = 0
        while local_meta_i < local_class_values.len():
            val class_def: HirClass = local_class_values[local_meta_i]
            self.register_composite_field_metadata(class_def.name, class_def.fields, module.symbols, true)
            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
            val optional_class_symbol: HirSymbol? = module.symbols.get_symbol_raw(class_def.symbol.id)
            if val present_class_symbol = optional_class_symbol:
                val class_symbol: HirSymbol = present_class_symbol
                val class_key = self.composite_layout_key(class_symbol)
                self.struct_bare_layout_owner[class_def.name] = class_key
                if class_key != class_def.name:
                    self.register_composite_field_metadata(class_key, class_def.fields, module.symbols, true)
                val canonical_class_key = mir_class_identity(class_symbol)
                if canonical_class_key != class_def.name:
                    self.register_composite_field_metadata(canonical_class_key, class_def.fields, module.symbols, true)
            local_meta_i = local_meta_i + 1
        # Entry-closure lowering reuses one MirLowering while replacing its
        # active SymbolTable for every module. Method SymbolIds are therefore
        # module-local state and must not survive that boundary.
        self.struct_method_syms = {}
        self.struct_method_ambiguous = {}
        self.struct_method_return_names = {}
        self.struct_method_return_is_array = {}
        self.struct_method_return_is_optional = {}
        self.trait_impl_owners = {}
        self.trait_impl_methods = {}
        # Provider arrays belong to the driver and are borrowed for this pass;
        # retain only relocated field/default metadata in the MIR owner roots.
        var consumer_composite_names: Dict<text, bool> = {}
        for raw_local_struct_value in local_struct_values:
            val local_struct_value: HirStruct = raw_local_struct_value
            consumer_composite_names[local_struct_value.name] = true
        for raw_local_class_value in local_class_values:
            val local_class_value: HirClass = raw_local_class_value
            consumer_composite_names[local_class_value.name] = true
        for raw_provider_module in providers:
            val provider_module: HirModule = raw_provider_module
            if provider_module.name != module.name:
                val provider_struct_keys: [SymbolId] = provider_module.structs.keys()
                for dk_35 in provider_struct_keys:
                    # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                    val provider_struct_def: HirStruct = provider_module.structs[dk_35]
                    if provider_struct_def == nil:
                        continue
                    self.register_provider_struct(provider_struct_def, provider_module.symbols,
                        consumer_composite_names.has(provider_struct_def.name))
            # Struct-only providers also own receiver methods (for example
            # CoreLexer); their absence of classes/enums must not hide them.
            # So do impl-only providers: `impl Imported:` extension modules
            # (app.test_daemon.qemu_broker_snapshot) declare no type at all.
            if provider_module.name != module.name and (provider_module.classes.len() > 0 or provider_module.enums.len() > 0 or provider_module.structs.len() > 0 or provider_module.impls.len() > 0):
                var provider_links: Dict<i64, text> = {}
                val provider_function_keys_34: [SymbolId] = provider_module.functions.keys()
                for dk_34 in provider_function_keys_34:
                    # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                    val provider_func: HirFunction = provider_module.functions[dk_34]
                    if provider_func == nil:
                        continue
                    provider_links[provider_func.symbol.id] = mir_provider_function_name(provider_module.name, provider_module.symbols, provider_func)
                val provider_class_keys: [SymbolId] = provider_module.classes.keys()
                for dk_33 in provider_class_keys:
                    # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                    val provider_class: HirClass = provider_module.classes[dk_33]
                    if provider_class == nil:
                        continue
                    self.register_provider_class(provider_class, provider_module.symbols, provider_links, false)
                # Provider enums were gated-in by the condition above but
                # never registered: a consumer module's match arms on a
                # provider enum's variants found an empty registry
                # (measured B5b, lib.common.sdn.value.SdnValue.is_null,
                # site-19 fifth layer). register_enum_variants is the same
                # registration the enum's own module pass runs.
                for provider_enum in provider_module.enums.values():
                    self.register_enum_variants(provider_enum)
                val provider_function_keys_32: [SymbolId] = provider_module.functions.keys()
                for dk_32 in provider_function_keys_32:
                    # workaround(p2_add cycles 91-105): per-read draw corruption — bind once, guard the local.
                    val provider_func: HirFunction = provider_module.functions[dk_32]
                    if provider_func == nil:
                        continue
                    self.register_provider_method(provider_func, provider_module.symbols, provider_links)
        # Before the ambient-bootstrap early return below: the stage3
        # bootstrap-fixed lane lowers through that branch too.
        if self.declaration_repository != nil:
            self.declaration_field_defaults = {}
            self.declaration_field_default_owners = {}
            self.register_declaration_provider_layouts_v1(module)
            self.register_declaration_trait_receiver_impls_v1(module)
        else:
            self.register_trait_receiver_impls(module, providers)
        self.global_symbol_ids = {}
        self.imported_global_initializers = {}
        # These mirrors contain module-local SymbolIds just like the owner
        # set. A reused lowering must not bind a consumer ID to prior storage.
        self.global_statics_by_id = {}
        self.global_constants_by_id = {}
        self.global_const_exprs = {}
        val bootstrap_mode = self.ambient_bootstrap_enabled()
        val trace_enabled = mir_lower_trace_enabled()
        val bootstrap_trace = bootstrap_mode and trace_enabled
        if bootstrap_trace:
            print "[mir-lower] lower_module:start module={module.name} functions={module.functions.keys().len()}"
        # Copy-modify-reassign: nested field mutations don't propagate in interpreter
        var builder = self.builder
        if bootstrap_trace:
            print "[mir-lower] builder"
        val output_name = if bootstrap_mode: builder.module.name else: module.name
        var builder_module = MirModule(
            name: output_name,
            functions: {},
            statics: {},
            constants: {},
            types: {}
        )
        if bootstrap_trace:
            print "[mir-lower] builder-module"
        # Bug (entry-MIR duplication for __init__ re-export shims,
        # native_build_entry_mir_duplication_2026-07-13): callers that lower
        # several HIR modules in a loop on ONE shared MirLowering instance
        # (driver_pipeline.spl's --entry-closure `direct_lowering` loop, and
        # the whole-hir_modules fallback loop) reuse `self.builder` — and
        # this method used to mutate `builder_module.functions/statics/
        # constants/types` IN PLACE without ever clearing them first. A
        # module with no functions/types of its own (a pure `export use`
        # re-export shim, e.g. compiler.driver's __init__.spl) would then
        # silently inherit whatever the PREVIOUS module in the loop had
        # accumulated in the shared builder, since nothing in that call
        # added anything new to overwrite it. Observed as
        # object.compiler.driver.mod.o containing app.cli.bootstrap_main's
        # entire function set (duplicate symbol definitions at link time).
        # Reset the OUTPUT module body per call so `lower_module` always
        # returns a module scoped to the HIR module just passed in,
        # regardless of what a shared builder carried over from a prior
        # call. Single-shot callers (a fresh MirLowering per call) are
        # unaffected since these dicts already start empty for them.
        if bootstrap_trace:
            print "[mir-lower] builder-name"
        builder.module = builder_module
        if bootstrap_trace:
            print "[mir-lower] builder-assign"
        self.builder = builder
        if not bootstrap_mode:
            self.enum_runtime_id_index = {}
            # The qualified sibling must be cleared by the SAME gate as the bare
            # map it shadows. Leaving it populated here would let a qualified-
            # first read return a runtime ID from a previous module after the
            # bare map was reset -- a stale hit is worse than the miss it
            # replaces.
            self.enum_runtime_id_index_q = {}
        if bootstrap_trace:
            print "[mir-lower] builder-done"

        if self.declaration_repository != nil:
            self.register_declaration_provider_globals_v1(module)
        else:
            self.register_imported_global_bindings(module, providers)

        if bootstrap_mode:
            if bootstrap_trace:
                print "[mir-lower] fn-list:start"
            # Module-level `val` constants MUST lower BEFORE function bodies:
            # this branch returns before the non-bootstrap constants loop far
            # below, so module `val`s were never registered -- an identifier
            # reference then resolved through local_map/pre-dispatch to a
            # nonexistent local and the backend emitted an uninitialized
            # alloca+load (module globals read as stack garbage; LSP server
            # startup SIGSEGV, native_module_val_globals 2026-07-23).
            val bs_const_vals = module.constants.values()
            if bootstrap_trace and bs_const_vals.len() > 0:
                print "[mir-lower] constants:count {bs_const_vals.len()}"
            var bs_ci = 0
            while bs_ci < bs_const_vals.len():
                # Cycle-171: annotated rebind -- the bare element read feeds
                # lower_const/lower_static and drew on candidate-seednew
                # (module `val`s such as gzip BLOCK_FIXED then failed every
                # reference as 'undefined variable').
                val bs_const: HirConst = bs_const_vals[bs_ci]
                self.lower_const(bs_const)
                bs_ci = bs_ci + 1
            # Statics are typed in a second pass: an unfolded initializer such as
            # `val passed = executed - failed` recovers its scalar type from the
            # operands' registered initializers (`global_const_exprs`), and
            # `module.constants.values()` is not in source order, so typing a
            # static in the same step as its own registration made the result
            # depend on whether its operands happened to be visited first.
            bs_ci = 0
            while bs_ci < bs_const_vals.len():
                val bs_static_const: HirConst = bs_const_vals[bs_ci]
                self.lower_static(bs_static_const)
                bs_ci = bs_ci + 1
            bootstrap_mir_functions_reset()
            val bootstrap_function_values: [HirFunction] = module.functions.values()
            val bootstrap_function_indices = hir_function_symbol_order(bootstrap_function_values)
            val bootstrap_function_count = bootstrap_function_indices.len()
            if bootstrap_trace:
                print "[mir-lower] functions:count {bootstrap_function_count}"
            # Cycle-96 discrimination receipt: p2_add lowers through THIS
            # bootstrap branch (not the main loop below, which returns
            # unreachable). len=0 -> the .values() materialization or the
            # symbol-order helper silently failed; per-fn lines absent ->
            # the skip chain below misfired.
            if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
                eprint("[enum-reg] bs-fn-keys: module={module.name} len={bootstrap_function_count} values_len={bootstrap_function_values.len()}")
            var bootstrap_fni = 0
            while bootstrap_fni < bootstrap_function_count:
                if bootstrap_trace:
                    print "[mir-lower] function-index {bootstrap_fni}"
                val function_index = bootstrap_function_indices[bootstrap_fni]
                val fn_: HirFunction = bootstrap_function_values[function_index]
                if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
                    eprint("[enum-reg] bs-fn: module={module.name} fn={fn_.name} generic={fn_.is_generic_template} extern={fn_.is_extern}")
                if bootstrap_trace:
                    print "[mir-lower] function-symbol"
                if bootstrap_trace:
                    print "[mir-lower] function-loaded"
                # Declared-return-type registry (native_call_return_type_loss
                # 2026-07-23) — Str-only, see bootstrap_globals.spl comment
                # (registering degraded non-Str types shadowed the MIR
                # builtin table, W93 regression).
                match fn_.return_type.kind:
                    case HirTypeKind.Str:
                        bootstrap_fn_ret_type_register(fn_.name, self.lower_type(fn_.return_type))
                    case _: ()
                # #158 Phase C: a generic TEMPLATE is non-emittable (hardening
                # plan 9.3 step 12). It carries unsubstituted TypeParams, so
                # lowering it produces opaque pointer-width slots and silent
                # wrong answers. 40.mono emits the specializations that ARE
                # reachable; anything still flagged here has zero live
                # instantiations and must simply not be emitted. A generic
                # call that mono could NOT rewrite is still a hard error
                # (E-MONO-030/032). Postmono invariants additionally reject
                # retained templates under robust/critical profiles.
                if fn_.is_generic_template:
                    ()
                elif not self.hir_function_is_extern(fn_):
                    if bootstrap_trace:
                        print "[mir-lower] function:start {fn_.name}"
                    var mir_fn = self.lower_function(fn_)
                    if fn_.has_vhdl_metadata:
                        mir_fn.has_vhdl_metadata = true
                        mir_fn.vhdl_metadata = fn_.vhdl_metadata
                    bootstrap_mir_functions_add(mir_fn.name, mir_fn, 0)
                    var bldr = self.builder
                    var bldr_module = bldr.module
                    var functions = bldr_module.functions
                    functions[mir_fn.symbol] = mir_fn
                    bldr_module.functions = functions
                    bldr.module = bldr_module
                    self.builder = bldr
                    if bootstrap_trace:
                        print "[mir-lower] function:added"
                bootstrap_fni = bootstrap_fni + 1
            if bootstrap_trace:
                print "[mir-lower] lower_module:done"
            # bootstrap_mir_functions_reset() above clears the parallel static
            # accumulators after constants/statics have already lowered. Re-add
            # the now-complete module so its statics and module index are
            # available to the flat bootstrap LLVM emitter.
            self.publish_native_trait_thunks(true)
            self.attach_external_layout_traces()
            bootstrap_mir_modules_add(self.builder.module)
            return self.builder.module

        # Build field map from struct and class definitions
        # (use while loops - for-in broken in compiled native code)
        val struct_values = module.structs.values()
        var si = 0
        while si < struct_values.len():
            val struct_def: HirStruct = struct_values[si]
            val sym_id = struct_def.symbol
            var field_names: [text] = []
            var field_has_default: [bool] = []
            var field_default_expr: [HirExpr] = []
            var fi = 0
            while fi < struct_def.fields.len():
                field_names.push(struct_def.fields[fi].name)
                field_has_default.push(struct_def.fields[fi].has_default)
                field_default_expr.push(struct_def.fields[fi].default)
                fi = fi + 1
            self.field_map[self.symbol_id_value(sym_id)] = field_names
            self.struct_field_has_default[struct_def.name] = field_has_default
            self.struct_field_default_expr[struct_def.name] = field_default_expr
            # Name-keyed struct field order: lower_call reclassifies a
            # `Point(x:3,y:4)` paren-constructor Call into aggregate construction
            # by looking up the callee name here (structs only, not classes).
            self.struct_field_order[struct_def.name] = field_names
            si = si + 1

        # Build enum variant registry. Explicit values win; omitted variants
        # continue from the previous value, matching enum declaration semantics.
        val enum_values = module.enums.values()
        var ei = 0
        while ei < enum_values.len():
            val enum_def: HirEnum = enum_values[ei]
            self.register_enum_variants(enum_def)
            self.register_enum_runtime_id(enum_def)
            ei = ei + 1
        # SIMPLE_ENUM_REG_TRACE=1 (cycle-51/52 discriminator; next-fire proof):
        # one receipt per module AFTER local enum registration, showing the
        # module's own declaration count and the cumulative variant-registry
        # size. If lib.common.sdn.value lowers with local_enums>=1 while its
        # SdnValue lookups still miss, the cumulative sizes here prove whether
        # the registration links fed anything at all.
        if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
            eprint("[enum-reg] module={module.name} local_enums={enum_values.len()} bare_registry={self.enum_variant_index.len()} q_registry={self.enum_variant_index_q.len()}")

        # Register the built-in Result enum so bare-variant construction
        # (`Ok(v)` / `Err(e)`) and `match r: case Ok(v)/Err(e)` resolve the same
        # discriminants (Ok=0, Err=1) as user enums. Result is not carried in
        # module.enums, so without this the variants lowered as indirect calls
        # to an undefined callee. Skip if user code shadows the name.
        self.register_builtin_enum_seeds()

        # Build (struct NAME, method name) -> method SymbolId lookup from
        # module.impls. Bug #138/#156: a receiver with no HIR type inference
        # (receiver.type_ nil) leaves MethodResolution.Unresolved for every
        # user struct instance method on the native-build path (try_
        # instance_method requires a typed receiver). The Unresolved fallback
        # in method_calls_literals.spl recovers the receiver's struct NAME
        # from struct_value_syms and looks it up here to dispatch the real
        # method instead of failing.
        var static_method_symbol_ids: Dict<i64, bool> = {}
        # Cycle-98: values+index (bootstrap-branch-proven shape). The
        # keys+index form silently mismatched aggregate SymbolId keys on
        # re-lookup (cycle-97/98 receipts); values are heap refs whose
        # rebind draws clean here.
        val module_fn_values: [HirFunction] = module.functions.values()
        var module_fn_i = 0
        # Cycle-95: while+index, NOT for-in (silent zero-iteration class).
        while module_fn_i < module_fn_values.len():
            # module.functions also contains impl methods; retain their static
            # marker for the separate static receiver lookup below.
            # workaround(p2_add): values() draws corrupt per read; bind once
            # via if val, guard and use the same binding.
            val static_element: HirFunction? = module_fn_values[module_fn_i]
            if val module_fn = static_element:
                if module_fn.is_static:
                    static_method_symbol_ids[self.symbol_id_value(module_fn.symbol)] = true
            module_fn_i = module_fn_i + 1

        var impl_mi = 0
        while impl_mi < module.impls.len():
            val impl_def: HirImpl = module.impls[impl_mi]
            var impl_type_name = ""
            var impl_type_key = ""
            var canonical_impl_type_key = ""
            match impl_def.type_.kind:
                case Named(impl_type_sym, _):
                    # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                    val optional_impl_type_symbol: HirSymbol? = self.symbols.get_symbol_raw(impl_type_sym.id)
                    if val present_impl_type_symbol = optional_impl_type_symbol:
                        val impl_type_symbol: HirSymbol = present_impl_type_symbol
                        impl_type_name = impl_type_symbol.name
                        impl_type_key = self.composite_layout_key(impl_type_symbol)
                        canonical_impl_type_key = mir_class_identity(impl_type_symbol)
                case _: ()
            if impl_type_name != "":
                if impl_type_key == "":
                    impl_type_key = impl_type_name
                val impl_method_names = impl_def.methods.keys()
                var mni = 0
                while mni < impl_method_names.len():
                    val impl_method_name = impl_method_names[mni]
                    val impl_method_id = impl_def.methods[impl_method_name]
                    val impl_method_key = "{impl_type_name}::{impl_method_name}"
                    self.struct_method_syms[impl_method_key] = impl_method_id
                    if impl_type_key != impl_type_name:
                        self.struct_method_syms["{impl_type_key}::{impl_method_name}"] = impl_method_id
                    if canonical_impl_type_key != "" and canonical_impl_type_key != impl_type_name:
                        # Owner-identity row: a local extension colliding with
                        # an imported owner's method is reported as ambiguous.
                        self.register_owner_method("{canonical_impl_type_key}::{impl_method_name}", impl_method_id, module.name)
                    val impl_method_is_static = static_method_symbol_ids.has(self.symbol_id_value(impl_method_id))
                    if impl_method_is_static:
                        self.struct_method_syms["static::{impl_method_key}"] = impl_method_id
                        if impl_type_key != impl_type_name:
                            self.struct_method_syms["static::{impl_type_key}::{impl_method_name}"] = impl_method_id
                        if canonical_impl_type_key != "" and canonical_impl_type_key != impl_type_name:
                            self.struct_method_syms["static::{canonical_impl_type_key}::{impl_method_name}"] = impl_method_id
                    # Methchain lane: thread the method's declared return-type
                    # struct name (resolved during HIR lowering -- see
                    # HirImpl.method_return_struct_names doc comment) so a
                    # chained `.m2()` on this call's RESULT can resolve too
                    # (consumed in method_calls_literals.spl's Unresolved arm).
                    val impl_ret_struct_name = impl_def.method_return_struct_names.get(impl_method_name)
                    if impl_ret_struct_name != nil and impl_ret_struct_name != "":
                        self.struct_method_return_names["{impl_type_name}::{impl_method_name}"] = impl_ret_struct_name
                        if impl_type_key != impl_type_name:
                            self.struct_method_return_names["{impl_type_key}::{impl_method_name}"] = impl_ret_struct_name
                    # Methchain lane construct #5 (`obj.items()[0]`): thread
                    # whether the method returns an Array/Slice so the call
                    # result registers into runtime_array_locals (see
                    # HirImpl.method_return_is_array doc comment).
                    val impl_ret_is_array = impl_def.method_return_is_array.get(impl_method_name)
                    if impl_ret_is_array != nil and impl_ret_is_array:
                        self.struct_method_return_is_array["{impl_type_name}::{impl_method_name}"] = true
                        if impl_type_key != impl_type_name:
                            self.struct_method_return_is_array["{impl_type_key}::{impl_method_name}"] = true
                    val impl_ret_is_optional = impl_def.method_return_is_optional.get(impl_method_name)
                    if impl_ret_is_optional != nil and impl_ret_is_optional:
                        self.struct_method_return_is_optional["{impl_type_name}::{impl_method_name}"] = true
                        if impl_type_key != impl_type_name:
                            self.struct_method_return_is_optional["{impl_type_key}::{impl_method_name}"] = true
                    mni = mni + 1
            impl_mi = impl_mi + 1

        val class_values = module.classes.values()
        var ci = 0
        while ci < class_values.len():
            val class_def: HirClass = class_values[ci]
            val sym_id = class_def.symbol
            var field_names: [text] = []
            var field_has_default: [bool] = []
            var field_default_expr: [HirExpr] = []
            var fi = 0
            while fi < class_def.fields.len():
                field_names.push(class_def.fields[fi].name)
                field_has_default.push(class_def.fields[fi].has_default)
                field_default_expr.push(class_def.fields[fi].default)
                fi = fi + 1
            self.field_map[self.symbol_id_value(sym_id)] = field_names
            self.struct_field_has_default[class_def.name] = field_has_default
            self.struct_field_default_expr[class_def.name] = field_default_expr
            # Name-keyed, same as the struct loop above: `lower_call`'s
            # paren-constructor reclassification and struct_value_syms'
            # field/method-dispatch bookkeeping both key off
            # struct_field_order by NAME regardless of struct/class, so a
            # class instance needs an entry here too (module_assembly.spl
            # now routes `class` decls into `module.classes` instead of
            # `module.structs` -- see bug
            # s19_class_free_fn_mutation_dropped_native_2026-07-17). The
            # separate `class_type_names` set below is what lets
            # function_lowering.spl's param binding tell a class apart from a
            # real struct once both satisfy struct_field_order.
            self.struct_field_order[class_def.name] = field_names
            self.class_type_names[class_def.name] = true
            # Also record the module-qualified ownership key, so a nested
            # field whose declared type resolves to THIS class is recognised
            # as a class even when another module declares a value struct of
            # the same bare name.
            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
            val optional_class_owner_symbol: HirSymbol? = module.symbols.get_symbol_raw(sym_id.id)
            if val present_class_owner_symbol = optional_class_owner_symbol:
                val class_owner_symbol: HirSymbol = present_class_owner_symbol
                self.class_type_names[self.composite_layout_key(class_owner_symbol)] = true
                self.struct_field_has_default[self.composite_layout_key(class_owner_symbol)] = field_has_default
                self.struct_field_default_expr[self.composite_layout_key(class_owner_symbol)] = field_default_expr
                self.struct_field_order[self.composite_layout_key(class_owner_symbol)] = field_names
                val raw_owner = class_owner_symbol.defining_module ?? ""
                val class_key = mir_class_identity(class_owner_symbol)
                self.class_type_names[class_key] = true
                self.struct_field_has_default[class_key] = field_has_default
                self.struct_field_default_expr[class_key] = field_default_expr
                self.struct_field_order[class_key] = field_names
            ci = ci + 1

        var local_callable_links: Dict<i64, text> = {}
        val function_keys_31_values: [HirFunction] = module.functions.values()
        for raw_local_func in function_keys_31_values:
            val local_func: HirFunction = raw_local_func
            local_callable_links[local_func.symbol.id] = self.provider_callable_symbol_name(local_func.symbol, local_func.name)
        val function_keys_30_values: [HirFunction] = module.functions.values()
        for raw_local_func in function_keys_30_values:
            val local_func: HirFunction = raw_local_func
            self.register_provider_method(local_func, module.symbols, local_callable_links)

        val bitfield_values = module.bitfields.values()
        var bi = 0
        while bi < bitfield_values.len():
            val bitfield_def: HirBitfield = bitfield_values[bi]
            val sym_id = bitfield_def.symbol
            # Key by direct .id access: symbol_id_value's match-destructure
            # of SymbolId returns nil in the interpreter, silently keying
            # the whole map by nil.
            self.bitfield_map[sym_id.id] = self.hir_bitfield_fields(bitfield_def)
            bi = bi + 1

        # Lower type definitions so headers/export wrappers can consume real MIR types.
        val struct_type_values = module.structs.values()
        var sti = 0
        while sti < struct_type_values.len():
            self.lower_struct_type(struct_type_values[sti])
            sti = sti + 1

        val class_type_values = module.classes.values()
        var cti = 0
        while cti < class_type_values.len():
            self.lower_class_type(class_type_values[cti])
            cti = cti + 1

        # Lower module-level constants/statics BEFORE any function body is
        # lowered (mutglobal2 lane, see scratchpad/mutglobal_plan.md +
        # scratchpad/mutglobal2 report). This loop used to run AFTER the
        # function-lowering loop below, which meant `self.global_static_ids`/
        # `self.global_const_ids` (populated by `lower_const`,
        # function_lowering.spl -- consulted by expr_dispatch.spl's
        # NamedVar/Var read hook and mir_lowering_stmts.spl's
        # lower_assign_var write hook to recognize a module-level `var`/`val`
        # reference) were still empty while every function body was being
        # lowered, so a real reference to a module global inside ANY function
        # would still hit the "undefined variable" fallback. Moving this
        # loop earlier makes the module-global registry available to every
        # function body lowered below, module-wide (order-independent, same
        # rationale as the struct/class/enum prep above and the prescan
        # pass right after this).
        val const_vals = module.constants.values()
        if val primary = archive_primary_globals:
            # The borrowed archive adapter proves equal complete global
            # declarations before this branch. Reuse actual first emission
            # storage; never repeat initializer effects or initializer MIR.
            var module_builder = self.builder
            var output_module = module_builder.module
            # Fresh carrier: insertion below cannot mutate the first output's
            # dictionary, whose child roots may predate this scratch scope.
            var functions: Dict<SymbolId, MirFunction> = {}
            for symbol in primary.functions.keys(): functions[symbol] = primary.functions[symbol]
            output_module.functions = functions
            var traces: [MirExternalLayoutTraceV1] = []
            for trace in primary.external_layout_traces: traces.push(trace)
            self.external_layout_traces = traces
            var output_types = output_module.types
            for symbol in primary.types.keys():
                if not output_types.has(symbol): output_types[symbol] = primary.types[symbol]
            output_module.types = output_types
            var constants: Dict<SymbolId, MirConstant> = {}
            for symbol in primary.constants.keys(): constants[symbol] = primary.constants[symbol]
            var statics: Dict<SymbolId, MirStatic> = {}
            for symbol in primary.statics.keys(): statics[symbol] = primary.statics[symbol]
            output_module.constants = constants
            output_module.statics = statics
            module_builder.module = output_module
            self.builder = module_builder
            for raw_const in const_vals:
                val const_: HirConst = raw_const
                val id = const_.symbol.id
                if id >= 0:
                    self.global_symbol_ids[id] = true
                    if hir_const_is_unit_typed(const_):
                        self.global_const_exprs[id] = HirExpr(kind: HirExprKind.UnitLit,
                            has_type_: true, type_: const_.type_, span: const_.value.span)
                    else:
                        self.global_const_exprs[id] = const_.value
                if primary.constants.has(const_.symbol):
                    self.global_constants_by_id[id] = primary.constants[const_.symbol]
                if primary.statics.has(const_.symbol):
                    self.global_statics_by_id[id] = primary.statics[const_.symbol]
        else:
            var coni = 0
            while coni < const_vals.len():
                val const_pass: HirConst = const_vals[coni]
                self.lower_const(const_pass)
                coni = coni + 1
            # Second pass for statics; see the bootstrap-path loop above.
            coni = 0
            while coni < const_vals.len():
                val const_pass: HirConst = const_vals[coni]
                self.lower_static(const_pass)
                coni = coni + 1

            self.lower_runtime_module_initializers(module, const_vals)
        # Order-independent pre-pass: walk every function body (read-only,
        # no MIR emitted) to seed struct_field_type_name from its real
        # construction sites BEFORE any function is actually lowered. See
        # prescan_expr_for_struct_types's own comment for the nondeterministic
        # bug this closes: a nested struct field's chained access
        # (`q.inner.y` where `q = outer()` and `outer`'s OWN body constructs
        # `Q(inner: make(3), ...)`) previously depended on whether
        # module.functions happened to lower `outer` before `main` --
        # `module.functions.values()` iteration order is not guaranteed
        # stable, so `q.inner.y` nondeterministically read field 0 (`x`)
        # instead of field 1 (`y`) on runs where the populating function
        # (`outer`) had not yet been visited by the real lowering loop below.
        # Cycle-94: .values()+array-index over [HirFunction] is the
        # corrupting draw (cycle-92 class); guard-first dict walk instead.
        # Cycle-99: values+index, same as the emission loop below -- the
        # keys+index form's corrupt aggregate-key re-lookup crashed inside
        # the dict probe at this site (cycle-99 shim: fault in lower_module
        # at the prescan region's dict access).
        # Cycle-107: same field as the emission loop (one materialization per
        # module). Local-array-var + named-bind + body-pass all draw corrupted
        # in this host (cycles 102/105/106 ledger); expression reads on the
        # field are the proven class.
        self.lower_emit_fn_values = module.functions.values()
        var psi = 0
        # Level-gated (default OFF), retained per the log-retention policy.
        val prescan_trace = mir_lower_trace_enabled()
        if prescan_trace:
            eprint("[mir-prescan-module] start module={module.name} functions={self.lower_emit_fn_values.len()}")
        while psi < self.lower_emit_fn_values.len():
            # workaround(p2_add): values() elements draw nil-3 PER READ in this
            # lane's codegen (smoke8: check-draw non-nil, use-draw nil-3).
            # Bind ONE draw, unwrap via if val, use that binding throughout.
            val prescan_element: HirFunction? = self.lower_emit_fn_values[psi]
            if val prescan_fn = prescan_element:
                if prescan_trace:
                    eprint("[mir-prescan-function] start module={module.name} index={psi} name={prescan_fn.name}")
                if not prescan_fn.is_extern:
                    self.prescan_block_for_struct_types(prescan_fn.body)
                else:
                    # Mark every extern BEFORE any body is lowered. The lowering
                    # loop below also records it, but only when it reaches the
                    # declaration, so a caller lowered earlier saw the extern's
                    # `-> i64` result as a declared scalar: `ext() == nil` folded
                    # to false and `take(ext())` boxed a nil word as Some.
                    self.extern_fn_symbols[prescan_fn.symbol.id] = true
                if prescan_trace:
                    eprint("[mir-prescan-function] done module={module.name} index={psi} name={prescan_fn.name}")
            psi = psi + 1
        if prescan_trace:
            eprint("[mir-prescan-module] done module={module.name}")

        # Lower functions (skip extern declarations - they have no body)
        # Cycle-94: same draw fix as the prescan loop above; skip branches
        # become continue + one increment.
        # Cycle-97: the emission loop moved to lower_module_emit_all_v1
        # (fresh-method draw; see the method header). All key-carried
        # dict walks draw corrupted inside lower_module itself.
        self.lower_module_emit_all_v1(module, archive_function_symbols, bootstrap_trace, trace_enabled)

        if bootstrap_trace:
            print "[mir-lower] lower_module:done"
        self.publish_native_trait_thunks(false)
        self.attach_external_layout_traces()
        self.builder.module

    # Cycle-97: lower_module's per-function emission loop, hosted in a fresh
    # method. Receipts from the cycle-97 binary proved the loop's dict walks
    # draw corrupted inside lower_module itself: fn-keys materialized len=5
    # but module.functions.has(first key) was FALSE at loop entry, so the
    # nil guard skipped every function and the lane emitted nothing
    # (E-LANE-VACUOUS). Every clean key-carried extraction draw in this
    # campaign (10/10) is in a fresh method in the has_rt_hal shape; every
    # draw inside lower_module corrupts (values+index: cycle-94 crash;
    # keys+index: cycle-97 silent mismatch). The module crosses by value
    # (proven transport); no large composite crosses back.
    me lower_module_emit_all_v1(module: HirModule, archive_function_symbols: [i64]?,
            bootstrap_trace: bool, trace_enabled: bool):
        # Cycle-98: values+index (the ORIGINAL main-loop shape, and the same
        # shape the bootstrap branch uses at self-host scale), NOT keys+index:
        # the cycle-97/98 receipts proved keys() round-trip corrupts aggregate
        # SymbolId keys in EVERY compiled host (fn-keys len=5 but
        # dict.has(first key)=false -> nil guard skipped all). Values are
        # heap refs whose rebind draws clean here (bootstrap branch evidence);
        # the first-element receipt converts any residual rebind corruption
        # from silent-skip to loud.
        # Cycle-105: struct-field transport (cycle-78's final working fix).
        # The local-var form -- rebind, promotion pin, unconditional scalar --
        # all failed with 'llvm global load referenced undeclared symbol
        # fn_values' (cycle-104); only the owner-field form promotes. The
        # assignment is the per-module reset (sequential lowering, one module
        # at a time; the next module's assignment replaces these entries).
        self.lower_emit_fn_values = module.functions.values()
        # Cycle-103: per-iteration body moved to lower_module_emit_fn_v1
        # (param-feed split, cycle-102 pattern). The loop-head named
        # bind `val fn_: HirFunction = fn_values[fni]` is the same
        # corruptor class fixed in prescan; the element now crosses
        # as a by-value argument with no caller-side bind.
        val fn_values_count: i64 = self.lower_emit_fn_values.len()
        if bootstrap_trace:
            print "[mir-lower] function-keys"
        if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
            eprint("[enum-reg] fn-keys: module={module.name} values_len={fn_values_count} dict_len={module.functions.len()}")
        var fni = 0
        while fni < fn_values_count:
            # workaround(p2_add): values() draws corrupt PER READ (smoke8: the
            # nil record passed the check-draw and faulted the use-draw at
            # lower_module_emit_fn_v1's first field read). Bind ONE draw into
            # an optional, unwrap via if val, pass that binding.
            val emit_element: HirFunction? = self.lower_emit_fn_values[fni]
            if val emit_fn = emit_element:
                self.lower_module_emit_fn_v1(module, emit_fn,
                        archive_function_symbols, bootstrap_trace, trace_enabled, fni)
            fni = fni + 1

    # Cycle-103: per-function emission step for lower_module_emit_all_v1.
    # fn_ is the by-value param (callee-prologue copy, the proven
    # class); no named bind of the array element at any call site.
    me lower_module_emit_fn_v1(module: HirModule, fn_: HirFunction,
        archive_function_symbols: [i64]?, bootstrap_trace: bool,
        trace_enabled: bool, index: i64):
        var selected_for_emission = true
        if val selected_symbols = archive_function_symbols:
            selected_for_emission = false
            for selected_symbol in selected_symbols:
                if selected_symbol == fn_.symbol.id: selected_for_emission = true
        if not selected_for_emission:
            return
        elif fn_.is_generic_template:
            return
            # #158 Phase C: generic templates are non-emittable (see the
            # function-symbol loop above for the full rationale).
        elif self.hir_function_is_extern(fn_):
            # Record the extern's symbol so call-result locals can be
            # excluded from nil-free scalar reasoning (see
            # extern_fn_symbols in mir_lowering_types.spl).
            self.extern_fn_symbols[fn_.symbol.id] = true
            return
            # skip extern functions
        else:
            # Cycle-96 discrimination receipt: reaching this line proves
            # keys materialization AND the skip chain passed; absence with
            # fn-keys nonzero means a skip branch misfired.
            if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
                eprint("[enum-reg] fn-emit: module={module.name} fn={fn_.name} idx={index}")
            if bootstrap_trace:
                print "[mir-lower] function:start"
            # SIMPLE_ENUM_REG_TRACE=1 progression receipt: names the
            # function whose lowering follows. On a livelock the LAST
            # fn-start line in the log is the spinning function.
            if (mir_lower_env_get("SIMPLE_ENUM_REG_TRACE") ?? "") == "1":
                eprint("[enum-reg] fn-start module={module.name} fn={fn_.name} idx={index}/{self.lower_emit_fn_values.len()}")
            var mir_fn = self.lower_function(fn_)
            if fn_.has_vhdl_metadata:
                mir_fn.has_vhdl_metadata = true
                mir_fn.vhdl_metadata = fn_.vhdl_metadata
                if trace_enabled:
                    print "[mir-vhdl-store] before name={fn_.name} hardware={mir_fn.has_vhdl_metadata}"
            # Copy-modify-reassign: nested field mutations don't propagate in the
            # bootstrap interpreter, so update builder.module.functions explicitly.
            var bldr = self.builder
            var bldr_module = bldr.module
            var functions = bldr_module.functions
            functions[mir_fn.symbol] = mir_fn
            if fn_.has_vhdl_metadata and trace_enabled:
                print "[mir-vhdl-store] after name={fn_.name} hardware={functions[mir_fn.symbol].has_vhdl_metadata}"
            bldr_module.functions = functions
            bldr.module = bldr_module
            self.builder = bldr
            if bootstrap_trace:
                print "[mir-lower] function:added"


    # mutglobal lane (module-level `var` mutation, see
    # scratchpad/mutglobal_plan.md): `lower_const` (function_lowering.spl,
    # owned by another lane) already lowers EVERY module-level HIR binding
    # (`val` and `var`) into `MirModule.constants` unconditionally -- that
    # path is untouched here. `MirModule.statics`/`MirStatic` previously had
    # no producer anywhere in the compiler (pure dead scaffolding: the field
    # existed on `MirModule`/`MirStatic` but nothing ever wrote to it and no
    # backend ever read it). This gives module-level `var` bindings (the
    # MUTABLE subset, `const_.is_mutable`) a real MIR-level representation
    # distinct from the constant-folded `.constants` entry, so a backend can
    # emit genuine `@name = global ...` storage for them instead of only
    # ever seeing an inlinable compile-time value. Does not remove or alter
    # anything already in `.constants` -- purely additive, so any existing
    # consumer of `.constants` (e.g. the VHDL backend) is unaffected.
    #
    # NOTE (gap, see scratchpad/mutglobal_plan.md): nothing downstream of
    # this MIR-level population yet READS a global's address for an
    # identifier reference (MIR expr lowering's `NamedVar` case only
    # consults the per-function `local_map`) or WRITES to one for a plain
    # `name = expr` assignment target (statement lowering only knows about
    # per-function SSA locals) -- both of those hooks live in files owned by
    # other lanes (`_MirLoweringExpr/expr_dispatch.spl`,
    # `mir_lowering_stmts.spl`/`var_reassign_ssa.spl`). This method makes
    # `MirModule.statics` real and populated; wiring an actual read/write
    # through it is the documented follow-up.
    me lower_static(const_: HirConst):
        """Lower a module-level HIR binding that needs storage into a MIR
        static. Literal immutable bindings remain compile-time constants;
        non-folded bindings receive runtime initialization."""
        # Unit has no storage; the runtime initializer evaluates such an
        # initializer for its side effects only (see
        # lower_runtime_module_initializers_named).
        if hir_const_is_unit_typed(const_):
            return
        var folded = self.lower_const_expr(const_.value)
        match const_.value.kind:
            case StringLit(_, _):
                if runtime_module_initializer_supported(const_):
                    folded = nil
            case _: ()
        if folded.?:
            if not const_.is_mutable and const_.visibility.is_private():
                return
        elif not runtime_module_initializer_supported(const_):
            return
        else:
            # A dict-literal global's storage type is knowable only from the
            # LOWERED initializer (a dict is an i64 handle, not the pointer the
            # `Dict<K, V>` annotation lowers to). Emitting a placeholder static
            # here declared the global as `ptr` while the initializer produced
            # an i64, and llc rejected the module with
            #   '%l1' defined with type 'i64' but expected 'ptr'
            # `lower_runtime_module_initializers_named` creates BOTH the static
            # and its `global_statics_by_id` mirror entry from the real value
            # type, so hand ownership to it rather than guessing. Returning here
            # is safe: `lower_const` (function_lowering.spl) has already
            # registered `global_symbol_ids` for this symbol, unconditionally.
            match const_.value.kind:
                case DictLit(_, _, _): return
                case _: ()
        val static_type = match folded:
            case Some(const_value):
                match const_.type_.kind:
                    case Infer(_, _):
                        if val derived_type = self.mir_folded_const_type(const_.value, const_value):
                            derived_type
                        else:
                            self.error_fatal("cannot derive module static type from folded value; add an explicit annotation", Some(const_.value.span))
                            MirType.i64()
                    case _: self.lower_type(const_.type_)
            case _:
                match const_.value.kind:
                    case StringLit(_, _): self.bootstrap_text_type()
                    case Binary(_, _, _):
                        # A runtime module initializer overwrites this static
                        # later on the ordinary path, but bootstrap functions
                        # can read the provisional slot first. Do not route
                        # every unresolved binary through string concatenation:
                        # recover only scalar type evidence from its operands.
                        if val declared = self.static_scalar_type_from_hir(const_.type_):
                            declared
                        elif val inferred = self.infer_unfolded_static_expr_type(const_.value):
                            inferred
                        else:
                            self.error_fatal("cannot derive module static type from unresolved binary initializer; add an explicit annotation", Some(const_.value.span))
                            MirType.i64()
                    case MethodCall(_, _, _, _): MirType(kind: MirTypeKind.Opaque("str"))
                    case _:
                        match const_.type_.kind:
                            case Infer(_, _):
                                self.error_fatal("cannot derive module static type from unresolved initializer; add an explicit annotation", Some(const_.value.span))
                                MirType.i64()
                            case Str: MirType(kind: MirTypeKind.Opaque("str"))
                            case _: self.lower_type(const_.type_)
        val init_const: MirConstant? = match folded:
            case Some(const_value):
                Some(MirConstant(
                    symbol: const_.symbol,
                    name: const_.name,
                    type_: static_type,
                    value: const_value
                ))
            case _: nil
        val sym_id = const_.symbol.id
        # Object-level global identity must not contain SymbolId: it is local
        # to one HIR lowering and the same imported global can receive a
        # different id when another closure module is lowered.  Keep that id
        # for MIR lookup, but give every backend a stable owner-qualified link
        # name so all per-module aliases bind one storage slot.
        var global_owner = self.builder.module.name
        if val symbol_info = self.symbols.get_symbol_raw(sym_id):
            if val defining_module = symbol_info.defining_module:
                if defining_module != "":
                    global_owner = defining_module
        val global_link_name = mir_global_storage_name(global_owner, const_.name)
        if sym_id >= 0:
            self.global_symbol_ids[sym_id] = true
        var bldr = self.builder
        var module_ = bldr.module
        var statics = module_.statics
        val lowered_static = MirStatic(
            symbol: const_.symbol,
            name: global_link_name,
            type_: static_type,
            init: init_const,
            is_mutable: const_.is_mutable,
            alignment: 0,
            visibility: const_.visibility,
            is_external: false
        )
        statics[const_.symbol] = lowered_static
        module_.statics = statics
        bldr.module = module_
        self.builder = bldr
        # Mirror the entry into the i64-keyed index. `find_global_static`
        # (expr_dispatch.spl) reads ONLY `global_statics_by_id` -- it stopped
        # scanning `module.statics` to dodge the seed's struct-keyed SymbolId
        # lookup defect -- but this producer was never updated to feed it, so
        # the mirror was written by nothing except the address-taken-folded-val
        # path and lambda lifting. Consequence: EVERY module-level `var` was
        # invisible to `find_global_static`, so `lower_assign_var`'s
        # `global_symbol_ids.contains(...) and find_global_static(...).?` guard
        # fell through to the per-function local path and every `G = x` aborted
        # the build with "assignment target has no local binding", whatever the
        # global's type. That is the fatal that blocked
        # `native-build src/app/mcp/main.spl` (2026-09-03); a `var G: text = ""`
        # reproduces it in three lines.
        if sym_id >= 0:
            self.global_statics_by_id[sym_id] = lowered_static

    me lower_runtime_module_initializers(module: HirModule, consts: [HirConst], bootstrap_module_index: i64 = -1):
        self.lower_runtime_module_initializers_named(module.name, consts, bootstrap_module_index)

    me hir_const_is_function_slot(const_: HirConst) -> bool:
        """True for a module-level `var` whose initializer NAMES a top-level
        function -- a function-pointer slot (`var cleanup: fn() =
        default_cleanup`).

        Such a binding is not a compile-time constant and `const_.type_.kind`
        arrives as `Any` (the `fn()` annotation does not survive HIR
        lowering), so `runtime_module_initializer_supported`'s type-driven
        fallback rejects it and it used to get NO static slot at all: the
        assignment in another function was dropped and every call through the
        slot was bound DIRECTLY at lowering time. Bug
        module_global_fn_pointer_lowered_as_direct_call_2026-08-21.
        """
        if not const_.is_mutable:
            return false
        match const_.value.kind:
            case NamedVar(symbol, name): self.is_known_top_level_function(name, symbol)
            case _: false

    me lower_runtime_module_initializers_named(module_name_raw: text, consts: [HirConst], bootstrap_module_index: i64 = -1):
        reverse_reference_owner_mark_known_v1("initializer-dependent")
        var dynamic = runtime_module_initializers_in_declaration_order(consts)
        # Function-pointer slots need the same runtime-initialized global
        # storage, but cannot be recognised by the free type-driven predicate
        # above (it has no view of the module's function names). Appended
        # rather than merged in declaration order: a function-pointer
        # initializer names a function, never another global, so it has no
        # ordering dependency on the entries already collected.
        for raw_slot_const in consts:
            # Annotated rebind: composite element through ANY (same hazard
            # class as the runtime-initializer index-sort fix, 2026-10-16).
            val slot_const: HirConst = raw_slot_const
            if self.hir_const_is_function_slot(slot_const):
                var slot_already = false
                for raw_existing in dynamic:
                    val existing: HirConst = raw_existing
                    if existing.symbol.id == slot_const.symbol.id:
                        slot_already = true
                if not slot_already:
                    dynamic = dynamic.push(slot_const)
        if dynamic.len() == 0:
            return
        var init_index = 1
        while init_index < dynamic.len():
            val prev_init: HirConst = dynamic[init_index - 1]
            val next_init: HirConst = dynamic[init_index]
            module_lowering_publish_initializer_dependency_v1(
                "{module_name_raw}::{prev_init.name}",
                "{module_name_raw}::{next_init.name}",
                "declaration-order:{init_index - 1}:{init_index}")
            init_index = init_index + 1

        # This symbol is external because the aggregate linker discovers and
        # calls it, but it must be unique in every per-module worker object.
        val init_name = mir_dynamic_module_init_name(
            module_name_raw, bootstrap_module_index)
        var symbols = self.symbols
        val init_symbol = symbols.define(init_name, SymbolKind.Function, nil, Span.empty(), Visibility.Private, false, nil)
        self.symbols = symbols

        self.reset_function_local_tracking()

        val signature = MirSignature(params: [], return_type: MirType.unit(), is_variadic: false)
        var bldr = self.builder
        bldr.begin_function(init_symbol, init_name, signature, Span.empty())
        self.builder = bldr

        var finalized_statics: [MirStatic] = []
        val initializer_guard = self.begin_global_initializer_guard(init_name)

        for raw_const in dynamic:
            val const_: HirConst = raw_const
            val value = self.lower_expr(const_.value)
            var value_type = self.lookup_local_type(value)
            # A dict initializer's SSA local is an i64 handle, but its MIR type
            # is `Dict(K, V)`, which the LLVM backend declares as `ptr`. Storing
            # the handle into that global is rejected by llc ("'%l1' defined
            # with type 'i64' but expected 'ptr'"). Declare the storage as what
            # is actually stored.
            match const_.value.kind:
                case DictLit(_, _, _): value_type = MirType.i64()
                case _: ()
            # A Unit-valued initializer (a top-level `main()` statement,
            # lowered as `_expr_N`) runs for its side effects only: the call
            # was just emitted above. Unit has no storage -- LLVM would emit
            # `global void` (rejected by llc) and Cranelift has no Unit
            # static -- so no static and no StoreGlobal.
            if mir_type_is_unit(value_type) or hir_const_is_unit_typed(const_):
                continue
            var value_builder = self.builder
            var value_module = value_builder.module
            var statics = value_module.statics
            var runtime_global_owner = module_name_raw
            if val runtime_symbol_info = self.symbols.get_symbol_raw(const_.symbol.id):
                if val runtime_defining_module = runtime_symbol_info.defining_module:
                    if runtime_defining_module != "":
                        runtime_global_owner = runtime_defining_module
            val runtime_global_link_name = mir_global_storage_name(runtime_global_owner, const_.name)
            val runtime_static = MirStatic(
                symbol: const_.symbol,
                name: runtime_global_link_name,
                type_: value_type,
                init: nil,
                is_mutable: const_.is_mutable,
                alignment: 0,
                visibility: const_.visibility,
                is_external: false
            )
            statics[const_.symbol] = runtime_static
            finalized_statics = finalized_statics.push(runtime_static)
            # Same mirror contract as `lower_static` above: this pass
            # OVERWRITES the static with the type of the lowered initializer,
            # so the i64 index must be re-pointed at the new entry or
            # `find_global_static` would keep handing out the placeholder type
            # (or nothing at all, for a runtime-only initializer).
            if const_.symbol.id >= 0:
                self.global_statics_by_id[const_.symbol.id] = runtime_static
            value_module.statics = statics
            value_builder.module = value_module
            value_builder.emit(MirInst(kind: MirInstKind.StoreGlobal(const_.symbol, mir_operand_copy(value)), span: Some(const_.span)))
            self.builder = value_builder

        self.finish_global_initializer_guard(initializer_guard)
        var finish = self.builder
        finish.terminate_return(nil)
        var init_function = finish.end_function()
        # The native startup owner discovers this canonical C ABI name.
        # Preserve it across backend nonentry-module qualification, as the
        # generated initializer wrapper already does.
        init_function.is_export_c = true
        init_function.export_name = init_name
        var result_module = finish.module
        # Compact provisional/replacement struct keys once per module, not
        # once per initializer: work stays linear in static storage count.
        result_module.statics = mir_static_storage_finalize(
            result_module.statics, finalized_statics)
        var functions = result_module.functions
        functions[init_function.symbol] = init_function
        result_module.functions = functions
        finish.module = result_module
        self.builder = finish
        if bootstrap_module_index >= 0:
            bootstrap_mir_functions_add(init_function.name, init_function, bootstrap_module_index)
        self.lower_global_initializer_wrapper(module_name_raw, init_name, bootstrap_module_index)

    me lower_struct_type(struct_def: HirStruct):
        """Lower a HIR struct definition into MIR type metadata."""
        val layout_attr = if struct_def.has_layout_attr:
            struct_def.layout_attr
        else:
            layoutattr_default_()
        val layout = compute_struct_layout(struct_def.fields, layout_attr)

        var fields: [MirFieldDef] = []
        var fi = 0
        while fi < struct_def.fields.len():
            val hir_field: HirField = struct_def.fields[fi]
            val field_layout: FieldLayout = layout.fields[fi]
            val field_offset: i64 = field_layout.offset
            val errors_before = self.errors.len()
            if (struct_def.name == "BackendError" and hir_field.name == "span") or (struct_def.name == "CompiledUnit" and hir_field.name == "entry_point"):
                val actual_disc = rt_enum_discriminant(hir_field.type_.kind)
                eprint("[mir-field-type] struct={struct_def.name} field={hir_field.name} actual={actual_disc}\n")
            val lowered_field_type = self.lower_type(hir_field.type_)
            if self.errors.len() > errors_before:
                # Interpolating an enum value prints an opaque `<enum@0x..>`
                # handle, which names nothing. Print the runtime discriminant
                # too -- it is DefaultHasher(variant-name) truncated to u32, so
                # it identifies the HirTypeKind variant exactly.
                eprint("[bootstrap-type-registration] struct={struct_def.name} field={hir_field.name} field_index={fi} hir_kind={hir_field.type_.kind} disc={rt_enum_discriminant(hir_field.type_.kind)} any={rt_enum_discriminant(HirTypeKind.Any)} fn={rt_enum_discriminant(HirTypeKind.Function([], hir_field.type_, []))} infer={rt_enum_discriminant(HirTypeKind.Infer(0, 0))}\n")
            fields.push(MirFieldDef(
                name: hir_field.name,
                type_: lowered_field_type,
                offset: field_offset,
                has_bits_attr: hir_field.has_bits_attr,
                bits_width: hir_field.bits_width
            ))
            fi = fi + 1

        var bldr = self.builder
        var module = bldr.module
        var types = module.types
        val canonical_symbol = self.canonical_mir_type_symbol(struct_def.symbol)
        types[canonical_symbol] = MirTypeDef(
            symbol: canonical_symbol,
            name: struct_def.name,
            kind: MirTypeDefKind.Struct(fields),
            is_export_c: false,
            export_name: ""
        )
        module.types = types
        bldr.module = module
        self.builder = bldr

    me lower_class_type(class_def: HirClass):
        """Lower a HIR class definition into MIR type metadata."""
        val layout_attr = if class_def.has_layout_attr:
            class_def.layout_attr
        else:
            layoutattr_default_()
        val layout = compute_struct_layout(class_def.fields, layout_attr)

        var fields: [MirFieldDef] = []
        var fi = 0
        while fi < class_def.fields.len():
            val hir_field: HirField = class_def.fields[fi]
            val field_layout: FieldLayout = layout.fields[fi]
            val field_offset: i64 = field_layout.offset
            fields.push(MirFieldDef(
                name: hir_field.name,
                type_: self.lower_type(hir_field.type_),
                offset: field_offset,
                has_bits_attr: hir_field.has_bits_attr,
                bits_width: hir_field.bits_width
            ))
            fi = fi + 1

        var is_export_c = false
        var export_name = ""
        if class_def.has_export_attr:
            is_export_c = class_def.export_attr.is_export_c
            export_name = class_def.export_attr.export_name

        var bldr = self.builder
        var module = bldr.module
        var types = module.types
        val canonical_symbol = self.canonical_mir_type_symbol(class_def.symbol)
        types[canonical_symbol] = MirTypeDef(
            symbol: canonical_symbol,
            name: class_def.name,
            kind: MirTypeDefKind.Struct(fields),
            is_export_c: is_export_c,
            export_name: export_name
        )
        module.types = types
        bldr.module = module
        self.builder = bldr

    # ========================================================================
    # Order-independent struct_field_type_name pre-pass (see call site above)
    # ========================================================================

    me prescan_enum_owner_for_variant(name: text) -> text:
        # Metadata cannot use the discriminant-only deduplication used by
        # variant patterns: equal variant leaves may carry different types.
        var owner = ""
        for key in self.enum_variant_index_q.keys():
            if self.enum_variant_discriminant(key, name) >= 0:
                if owner != "" and owner != key: return ""
                owner = key
        owner

    me prescan_block_for_struct_types(block: HirBlock):
        """Read-only HIR walk over a function body (no MIR emitted): finds
        every struct-construct call reachable from `block` and records its
        nested field struct names into struct_field_type_name, regardless of
        which function this block belongs to or in what order module.functions
        happens to be visited by the real per-function lowering loop."""
        var si = 0
        while si < block.stmts.len():
            self.prescan_stmt_for_struct_types(block.stmts[si])
            si = si + 1
        if block.has:
            self.prescan_expr_for_struct_types(block.value)

    me prescan_stmt_for_struct_types(stmt: HirStmt):
        val nil_span = Span.empty()
        val nil_type = HirType(kind: HirTypeKind.Unit, span: nil_span)
        val nil_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: nil_type, span: nil_span)
        val empty_block = HirBlock(stmts: [], has: false, value: nil_expr, span: nil_span)
        val stmt_kind: HirStmtKind = stmt.kind
        val stmt_disc = rt_enum_discriminant(stmt_kind)
        val expr_stmt_disc = rt_enum_discriminant(HirStmtKind.Expr(nil_expr))
        if stmt_disc == expr_stmt_disc:
            match stmt_kind:
                case HirStmtKind.Expr(expr):
                    if mir_lower_trace_enabled():
                        eprint("[mir-prescan] HirStmtKind.Expr")
                    val expr_t: HirExpr = expr
                    self.prescan_expr_for_struct_types(expr_t)
                    return
                case _:
                    ()
        val let_disc = rt_enum_discriminant(HirStmtKind.Let(SymbolId(id: -1), nil_type, nil_expr))
        if stmt_disc == let_disc:
            match stmt_kind:
                case HirStmtKind.Let(_, _, init):
                    val init_t: HirExpr = init
                    self.prescan_expr_for_struct_types(init_t)
                    return
                case _:
                    ()
        val assign_disc = rt_enum_discriminant(HirStmtKind.Assign(nil_expr, HirAssignOp.Add, nil_expr))
        if stmt_disc == assign_disc:
            match stmt_kind:
                case HirStmtKind.Assign(_, _, value):
                    val value_t: HirExpr = value
                    self.prescan_expr_for_struct_types(value_t)
                    return
                case _:
                    ()
        val stmt_block_disc = rt_enum_discriminant(HirStmtKind.Block(empty_block))
        if stmt_disc == stmt_block_disc:
            match stmt_kind:
                case HirStmtKind.Block(inner_block):
                    val block_t: HirBlock = inner_block
                    self.prescan_block_for_struct_types(block_t)
                    return
                case _:
                    ()

    me prescan_expr_for_struct_types(expr: HirExpr) -> text:
        """Returns the struct NAME `expr` statically denotes (a direct struct
        construct, or a call to a function whose declared return type is a
        Named struct), or "" when unknown. Recurses into Call args, Return,
        Block, and If so a `return Q(inner: make(3), tag: 99)`-shaped function
        body (the exact case this pre-pass exists for) is fully covered."""
        val nil_span = Span.empty()
        val nil_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true, type_: HirType(kind: HirTypeKind.Unit, span: nil_span), span: nil_span)
        val expr_kind: HirExprKind = expr.kind
        val block_disc = rt_enum_discriminant(HirExprKind.Block(HirBlock(stmts: [], has: false, value: nil_expr, span: nil_span)))
        if rt_enum_discriminant(expr_kind) == block_disc:
            match expr_kind:
                case HirExprKind.Block(inner_block):
                    if mir_lower_trace_enabled():
                        eprint("[mir-prescan] HirExprKind.Block")
                    val block_t: HirBlock = inner_block
                    self.prescan_block_for_struct_types(block_t)
                    return ""
                case _:
                    ()
        match expr_kind:
            case Call(callee, args, _):
                var name = ""
                match callee.kind:
                    case Var(sym):
                        # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                        val optional_s: HirSymbol? = self.symbols.get_symbol_raw(sym.id)
                        if val present_s = optional_s:
                            val s: HirSymbol = present_s
                            name = s.name
                    case NamedVar(_, n):
                        name = n
                    case _:
                        ()
                if name != "":
                    var owner_enum = ""
                    if expr.has_type_:
                        match expr.type_.kind:
                            case Named(owner_symbol, _):
                                owner_enum = self.enum_constructor_symbol_owner(owner_symbol)
                            case HirTypeKind.Result(_, _): owner_enum = "Result"
                            case HirTypeKind.Optional(_): owner_enum = "Option"
                            case _: ()
                    if owner_enum == "": owner_enum = self.prescan_enum_owner_for_variant(name)
                    if owner_enum != "" and self.enum_variant_discriminant(owner_enum, name) < 0:
                        owner_enum = ""
                    if owner_enum != "" and args.len() == 1:
                        # Enum/Result payload chain fix: `Ok(make(3))` /
                        # `Circle(make_point())` constructs a payload that may
                        # itself be a struct VALUE. Record
                        # "{owner_enum}::{name}" -> that struct's NAME here too
                        # (same map lower_enum_construct_named/lower_enum_lit
                        # populate at real-lowering time), order-independently,
                        # so `case Ok(p): print(p.y)` resolves correctly no
                        # matter which function constructs the payload relative
                        # to which function matches on it.
                        val nested_payload = self.prescan_expr_for_struct_types(args[0].value)
                        if nested_payload != "":
                            self.enum_payload_struct_names["{owner_enum}::{name}"] = nested_payload
                        return ""
                if name != "" and self.struct_field_order.has(name):
                    val field_names = self.struct_field_order[name]
                    var field_type_names: [text] = []
                    var fi = 0
                    while fi < field_names.len():
                        val want = field_names[fi]
                        var chosen_idx = if fi < args.len(): fi else: -1
                        var ai = 0
                        while ai < args.len():
                            if args[ai].has_name and args[ai].name == want:
                                chosen_idx = ai
                            ai = ai + 1
                        var nested = ""
                        if chosen_idx >= 0 and chosen_idx < args.len():
                            nested = self.prescan_expr_for_struct_types(args[chosen_idx].value)
                        field_type_names.push(nested)
                        fi = fi + 1
                    if not self.struct_field_type_name.has(name):
                        self.struct_field_type_name[name] = field_type_names
                    else:
                        val prev = self.struct_field_type_name[name]
                        var merged: [text] = []
                        var mi = 0
                        while mi < field_type_names.len():
                            var name_i = field_type_names[mi]
                            if name_i == "" and mi < prev.len():
                                name_i = prev[mi]
                            merged.push(name_i)
                            mi = mi + 1
                        self.struct_field_type_name[name] = merged
                    return name
                # Not a direct struct construct: maybe a call to a known
                # function whose declared return type is a Named struct
                # (mirrors resolved_call_return_type's own symbol lookup).
                val callee_symbol: SymbolId? = match callee.kind:
                    case Var(sym2): Some(sym2)
                    case NamedVar(sym2, _): Some(sym2)
                    case _: nil
                if val cs = callee_symbol:
                    # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                    val optional_fn_sym: HirSymbol? = self.symbols.get_symbol_raw(cs.id)
                    if val present_fn_sym = optional_fn_sym:
                        val fn_sym: HirSymbol = present_fn_sym
                        if val fn_type = fn_sym.type_:
                            match fn_type.kind:
                                case HirTypeKind.Function(_, ret, _):
                                    match ret.kind:
                                        case Named(ret_sym, _):
                                            # Presence does not unwrap HirSymbol?: a Some box used as concrete HirSymbol reads its enum header as a struct header (4710b22a991 class).
                                            val optional_ret_symbol: HirSymbol? = self.symbols.get_symbol_raw(ret_sym.id)
                                            if val present_ret_symbol = optional_ret_symbol:
                                                val ret_symbol: HirSymbol = present_ret_symbol
                                                return ret_symbol.name
                                        case _:
                                            ()
                                case _:
                                    ()
                ""
            case Return(value):
                if val rv = value:
                    self.prescan_expr_for_struct_types(rv)
                else:
                    ""
            case If(cond, then_, else_):
                self.prescan_expr_for_struct_types(cond)
                self.prescan_block_for_struct_types(then_)
                if val eb = else_:
                    self.prescan_block_for_struct_types(eb)
                ""
            case IfChain(arms, else_):
                var arm_index = 0
                while arm_index < arms.len():
                    self.prescan_expr_for_struct_types(arms[arm_index].cond)
                    self.prescan_block_for_struct_types(arms[arm_index].then_)
                    arm_index = arm_index + 1
                if val eb = else_:
                    self.prescan_block_for_struct_types(eb)
                ""
            case MethodCall(mc_receiver, mc_method, mc_args, mc_resolution):
                # Dot-qualified enum construction (`Shape.Circle(make(9))`)
                # actually arrives as a MethodCall (receiver=Shape,
                # method=Circle), reclassified into enum construction only at
                # REAL-lowering time by method_calls_literals.spl's own
                # "receiver names a registered enum and method is one of its
                # variants" check (mirrored here) -- NOT as a distinct EnumLit
                # node. Recurse into args either way so a struct-returning
                # call passed as a plain method argument is still discovered.
                var mc_recv_enum_name = ""
                match mc_receiver.kind:
                    case Var(mc_rsym):
                        mc_recv_enum_name = self.enum_constructor_symbol_owner(mc_rsym)
                    case NamedVar(mc_rsym, _):
                        mc_recv_enum_name = self.enum_constructor_symbol_owner(mc_rsym)
                    case _:
                        ()
                match mc_resolution:
                    case MethodResolution.Unresolved: ()
                    case _: mc_recv_enum_name = ""
                var mc_is_variant = false
                if mc_recv_enum_name != "" and self.enum_variant_index_q.has(mc_recv_enum_name):
                    for mc_vn in self.enum_variant_index_q[mc_recv_enum_name]:
                        if mc_vn == mc_method:
                            mc_is_variant = true
                if mc_is_variant and mc_args.len() == 1:
                    val mc_nested = self.prescan_expr_for_struct_types(mc_args[0].value)
                    if mc_nested != "":
                        self.enum_payload_struct_names["{mc_recv_enum_name}::{mc_method}"] = mc_nested
                else:
                    var mc_ai = 0
                    while mc_ai < mc_args.len():
                        self.prescan_expr_for_struct_types(mc_args[mc_ai].value)
                        mc_ai = mc_ai + 1
                ""
            case EnumLit(type_, variant, payload):
                # Dot-qualified enum construction (`Shape.Circle(make(9))`)
                # arrives as a distinct HirExprKind.EnumLit node, NOT a Call --
                # the Call-shaped enum-owner check above never sees this shape
                # at all. Same struct-value chain fix, mirrors lower_enum_lit's
                # own single-value Tuple payload handling.
                var elit_enum_name = ""
                match type_.kind:
                    case Named(elit_sym, _):
                        elit_enum_name = self.enum_constructor_symbol_owner(elit_sym)
                    case _:
                        ()
                if val elit_payload = payload:
                    match elit_payload:
                        case Tuple(elit_values):
                            if elit_values.len() == 1 and elit_enum_name != "":
                                val elit_nested = self.prescan_expr_for_struct_types(elit_values[0])
                                if elit_nested != "":
                                    self.enum_payload_struct_names["{elit_enum_name}::{variant}"] = elit_nested
                        case _:
                            ()
                ""
            case _:
                ""
