extern fn rt_env_get(key: text) -> text

fn mir_lower_env_get(key: text) -> text:
    rt_env_get(key)

fn _text_list_eq(a: [text], b: [text]) -> bool:
    """Order-sensitive equality for two variant-name lists.

    Order matters: the declared order IS the discriminant assignment, so two
    same-bare-named enums listing the same names in a different order are still
    a divergent (hazardous) collision, not a benign duplicate."""
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

fn mir_lower_trace_enabled() -> bool:
    val trace = mir_lower_env_get("SIMPLE_COMPILER_TRACE") ?? ""
    val phase = mir_lower_env_get("SIMPLE_COMPILER_PHASE_PROFILE") ?? ""
    val diag = mir_lower_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? ""
    if trace == "1":
        return true
    if phase == "1":
        return true
    diag == "1"
