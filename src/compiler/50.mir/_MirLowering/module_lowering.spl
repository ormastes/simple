fn mir_abort_reverse_reference_scope_v1(token: i64) -> bool:
    val aborted = reverse_reference_module_abort_v1(token)
    val ended = transient_array_scope_end_v1()
    aborted and ended

pub fn module_lowering_publish_initializer_dependency_v1(subject: text,
        consumer: text, evidence: text):
    reverse_reference_owner_mark_known_v1("initializer-dependent")
    reverse_reference_register_initializer_v1(subject, consumer, evidence)
