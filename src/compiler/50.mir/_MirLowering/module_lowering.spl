fn string_literal_has_runtime_interpolations(interps: [HirInterpolation]?) -> bool:
    if val parts = interps:
        return parts.len() > 0
    false

fn mir_static_type_is_float(type_: MirType) -> bool:
    match type_.kind:
        case MirTypeKind.F32 | MirTypeKind.F64: true
        case _: false

fn mir_static_type_is_integer(type_: MirType) -> bool:
    match type_.kind:
        case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64 |
             MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: true
        case _: false

fn mir_exact_extern_type_v1(type_: HirType, allow_void: bool) -> bool:
    match type_.kind:
        case HirTypeKind.Int(bits, _): bits == 32 or bits == 64
        case HirTypeKind.Unit: allow_void
        case HirTypeKind.Ptr(inner, _): mir_exact_extern_pointee_v1(inner)
        case _: false

fn mir_exact_extern_pointee_v1(type_: HirType) -> bool:
    match type_.kind:
        case HirTypeKind.Int(bits, _): bits == 8 or bits == 16 or bits == 32 or bits == 64
        case HirTypeKind.Unit: true
        case HirTypeKind.Ptr(inner, _): mir_exact_extern_pointee_v1(inner)
        case _: false

# Local diagnostic decisions only; cleanup/abort return values are not counted.
# Bits1/2/4/8/16/32/64/128/256: normal begin/pause/module/owner/MIRregistry/
# functionregistry/seal/end/publish succeeded. Outcome0 precedes fallback work.
fn mir_scope_trace_selected_v1(selected: text, module_name: text) -> bool:
    selected != "" and selected == module_name

# eprint adds the sole newline; do not retain arbitrary module/graph text.
fn mir_scope_decision_trace_line_v1(decisions: i64, outcome: i64) -> text:
    "[mir-scope-decisions] decisions={decisions} outcome={outcome}"

impl MirLowering:
    me static_scalar_type_from_hir(type_: HirType?) -> MirType?:
        # Presence does not unwrap HirType?: a Some box crossing the concrete
        # HirType ABI (match .kind / lower_type) reads its enum header as a
        # struct header. Bind the concrete payload first (4710b22a991 pattern).
        val optional_type: HirType? = type_
        if optional_type == nil:
            return nil
        if val present_type = optional_type:
            val concrete_type: HirType = present_type
            match concrete_type.kind:
                # Raw bootstrap text uses the Opaque representation. `lower_type`
                # describes the general fat-pointer text ABI instead, so it is not
                # the static slot representation used by literal lowering.
                case HirTypeKind.Str: Some(self.bootstrap_text_type())
                case HirTypeKind.Int(_, _) | HirTypeKind.Float(_) | HirTypeKind.Bool:
                    Some(self.lower_type(concrete_type))
                case _: nil
        else:
            nil

    me infer_unfolded_static_expr_type(expr: HirExpr) -> MirType?:
        # Shared across both binary branches so a repeated dependency cannot
        # turn type recovery into an exponential traversal.
        var visit_budget: [i64] = [256]
        self.infer_unfolded_static_expr_type_bounded(expr, 0, visit_budget)

    me infer_unfolded_static_expr_type_bounded(expr: HirExpr, depth: i64, visit_budget: [i64]) -> MirType?:
        """Recover a scalar static type without guessing that an expression is text.

        Bootstrap function bodies may read a static before the runtime module
        initializer replaces its provisional static. Only scalar facts that
        the HIR operands establish are admissible here; unknown expressions
        keep the existing explicit-annotation diagnostic.
        """
        if depth > 64 or visit_budget[0] <= 0:
            return nil
        visit_budget[0] = visit_budget[0] - 1
        if val typed = self.static_scalar_type_from_hir(expr.type_):
            return Some(typed)
        match expr.kind:
            case IntLit(_, _): Some(MirType.i64())
            case FloatLit(_, _): Some(MirType.f64())
            case FloatLexeme(_, _): Some(MirType.f64())
            case BoolLit(_): Some(MirType.bool())
            case StringLit(_, _): Some(self.bootstrap_text_type())
            case Var(symbol) | NamedVar(symbol, _):
                # Normal HIR identifier nodes deliberately have no scalar
                # type payload here. Resolve their registered initializer,
                # with a depth guard for cyclic module definitions.
                if self.global_const_exprs.contains(symbol.id):
                    return self.infer_unfolded_static_expr_type_bounded(
                        self.global_const_exprs[symbol.id], depth + 1, visit_budget)
                nil
            case Binary(op, left, right):
                val left_type = self.infer_unfolded_static_expr_type_bounded(left, depth + 1, visit_budget)
                val right_type = self.infer_unfolded_static_expr_type_bounded(right, depth + 1, visit_budget)
                match op:
                    case HirBinOp.Eq | HirBinOp.NotEq | HirBinOp.Lt | HirBinOp.LtEq | HirBinOp.Gt | HirBinOp.GtEq:
                        if left_type.? and right_type.?: return Some(MirType.bool())
                    case HirBinOp.And | HirBinOp.Or:
                        if val left_known = left_type:
                            if val right_known = right_type:
                                if left_known.kind == MirTypeKind.Bool and right_known.kind == MirTypeKind.Bool:
                                    return Some(MirType.bool())
                        return nil
                    case Add:
                        if val left_known = left_type:
                            match left_known.kind:
                                case MirTypeKind.Opaque(name):
                                    if name == "str": return Some(self.bootstrap_text_type())
                                case _: ()
                        if val right_known = right_type:
                            match right_known.kind:
                                case MirTypeKind.Opaque(name):
                                    if name == "str": return Some(self.bootstrap_text_type())
                                case _: ()
                    case HirBinOp.Sub | HirBinOp.Mul | HirBinOp.Div | HirBinOp.Mod | HirBinOp.Pow | HirBinOp.BitAnd | HirBinOp.BitOr | HirBinOp.BitXor | HirBinOp.Shl | HirBinOp.Shr: ()
                    case _: return nil
                if val left_known = left_type:
                    if val right_known = right_type:
                        var arithmetic = false
                        match op:
                            case HirBinOp.Add | HirBinOp.Sub | HirBinOp.Mul | HirBinOp.Div | HirBinOp.Mod | HirBinOp.Pow: arithmetic = true
                            case _: ()
                        val both_numeric = (mir_static_type_is_float(left_known) or mir_static_type_is_integer(left_known)) and
                            (mir_static_type_is_float(right_known) or mir_static_type_is_integer(right_known))
                        if arithmetic and both_numeric and (mir_static_type_is_float(left_known) or mir_static_type_is_float(right_known)):
                            if left_known.kind == MirTypeKind.F32 and right_known.kind == MirTypeKind.F32:
                                return Some(MirType(kind: MirTypeKind.F32))
                            return Some(MirType.f64())
                        if mir_static_type_is_integer(left_known) and mir_static_type_is_integer(right_known):
                            # `lower_binary_expr` uses i64 for non-float
                            # arithmetic, including matching narrow widths.
                            # Keep this provisional slot identical to its
                            # later runtime initializer rather than relabeling
                            # the result with an operand's width.
                            return Some(MirType.i64())
                nil
            case _: nil

fn hir_const_is_unit_typed(const_: HirConst) -> bool:
    """A module binding whose settled HIR type is Unit (`_expr_N = main()`)
    has no value to store; it gets no static on any backend."""
    match const_.type_.kind:
        case HirTypeKind.Unit: true
        case _: false

fn mir_type_is_unit(type_: MirType) -> bool:
    match type_.kind:
        case MirTypeKind.Unit: true
        case _: false

fn runtime_module_initializer_supported(const_: HirConst) -> bool:
    match const_.value.kind:
        case IntLit(_, _) | FloatLit(_, _) | FloatLexeme(_, _) | BoolLit(_): false
        # A signed or bit-inverted numeric literal (`val NEG = -1`,
        # `val HALF = -2.5`) folds to a compile-time constant exactly like the
        # bare literal above (`lower_const_expr`'s Unary arm). Now that HIR
        # settles its type (`unannotated_const_type`), the type-driven
        # fallback below would admit it for a redundant runtime re-store;
        # keep it on the static path with the literal it wraps.
        case Unary(_, un_operand):
            val un_operand_t: HirExpr = un_operand
            match un_operand_t.kind:
                case IntLit(_, _) | FloatLit(_, _) | FloatLexeme(_, _): false
                case _: runtime_module_initializer_type_fallback(const_)
        # `var G: T? = nil` neither folds (no MirConstValue for nil) nor was
        # admitted here, so lower_static emitted no static and every later
        # `G = x` died with "assignment target has no local binding".
        case NilLit: true
        case StringLit(_, interps):
            # Any stored text slot needs a boxed runtime string, including
            # immutable exported values read through imported global storage.
            # Private immutable literals remain inlinable constants.
            string_literal_has_runtime_interpolations(interps) or
                (const_.is_mutable and const_.type_.kind == HirTypeKind.Str) or
                not const_.visibility.is_private()
        # Preserve the pre-existing call path; additionally admit wrapped
        # expressions only when every native backend can declare the scalar.
        case Call(_, _, _): true
        # Compound module `val` whose initializer is a runtime expression, e.g.
        # `val X = OTHER + "/sub"` (string concat) or `X.method()`: needs a
        # runtime-initialized global slot, exactly like a Call init. Without
        # this the binding got NO static slot, so a reference to it emitted an
        # undefined local rendered as i64 (native_compound_module_val_runtime_
        # init 2026-07-23: main_lazy_assistant ASSIST_TIMELINES = ASSIST_ROOT
        # + "/timelines" -> `rt_raw_i64_to_string(i64 %undef)`).
        case Binary(_, _, _): true
        case MethodCall(_, _, _, _): true
        # bug: array_global_2026-07-25 -- `var xs: [T] = []` (or any array
        # literal) module-level global. Previously fell through to the
        # type-driven fallback below, whose Int/Float/Bool/Str allowlist has
        # no Array case, so this returned false and `lower_static` (above,
        # `elif not runtime_module_initializer_supported(const_): return`)
        # emitted NO MirStatic at all for it. Every later reassignment
        # (`XS = new_xs`) then found neither a global static
        # (`find_global_static` miss) nor a function-local binding
        # (`find_local` miss, since it is a module global, not a local) and
        # hit "assignment target has no local binding" at
        # mir_lowering_stmts.spl:1377 (MCP: dap_bridge.spl DAP_SESSIONS at
        # lines 226/236/273). `lower_runtime_module_initializers_named`
        # already lowers the initializer expression generically via
        # `self.lower_expr(const_.value)` and derives the static's type from
        # that result, so admitting ArrayLit here needs no new lowering
        # machinery -- it only starts routing array globals through the same
        # runtime-init path Call/Binary/MethodCall already use.
        case ArrayLit(_, _): true
        # Same defect as the ArrayLit case above, one container kind over:
        # `var D: Dict<K, V> = {}` (or any dict literal) module-level global.
        # DictLit matched no arm here and the type-driven fallback below has
        # no Dict case, so this returned false, `lower_static` returned before
        # emitting a MirStatic, and no `global_symbol_ids` entry was recorded.
        # Every later `D = new_d` then missed BOTH `find_global_static` and
        # `find_local` and aborted the build with "assignment target has no
        # local binding" (mir_lowering_stmts.spl). This is a SECOND, narrower
        # instance of that message than the `global_statics_by_id` mirror
        # desync fixed in `lower_static` below: the mirror fix repairs every
        # global that HAS a static, this arm is what gives a dict global one at
        # all. The MCP closure reaches assigned dict globals through std
        # (`log.spl` SCOPE_LEVELS at :256).
        # `lower_runtime_module_initializers_named` lowers the initializer
        # generically via `self.lower_expr(const_.value)` and OVERWRITES the
        # static with the type of that lowered value, so admitting DictLit
        # needs no new lowering machinery, exactly like ArrayLit.
        case DictLit(_, _, _): true
        # Third container kind of the same defect: `var S: (i64, i64, f64) =
        # (0, 0, 100.0)` (std.nogc_sync_mut.io.windows_resource_owner) got no
        # static, so `S = (a, b, c)` aborted with "assignment target has no
        # local binding". Same generic runtime-initializer path as above.
        case TupleLit(_): true
        case _: runtime_module_initializer_type_fallback(const_)

fn runtime_module_initializer_type_fallback(const_: HirConst) -> bool:
    match const_.type_.kind:
        case Int(_, _) | Float(_) | Bool | Str: true
        case _: false

fn runtime_module_initializers_in_declaration_order(consts: [HirConst]) -> [HirConst]:
    # Sort INDICES over parallel scalar key arrays, never moving composite
    # HirConst elements between array slots. The previous insertion sort
    # read AND rewrote `dynamic[j + 1]` element-wise; Stage-2 stores array
    # elements through ANY (the documented transport hazard behind
    # expr_dispatch.spl's "Rebind the extracted composite" pattern), and the
    # stage2-compiled compiler faulted inside THIS function chasing a tagged
    # word read back from a moved element (reproduced under gdb:
    # `ldr x10, [x10]` on an untagged element field, SIGSEGV in
    # register_provider_global_bindings -> lower_module of the entry module,
    # 2026-10-16). i64 keys and indices are primitive transports; each
    # composite element is read exactly twice under an explicit annotation.
    var order: [i64] = []
    var key_span: [i64] = []
    var key_symbol: [i64] = []
    var di = 0
    while di < consts.len():
        val const_: HirConst = consts[di]
        if runtime_module_initializer_supported(const_):
            order.push(di)
            # Retained-HIR decode can nil-fill trailing fields of an
            # old-schema receipt (span included); a nil span must not reach
            # the (span, symbol) ordering compare (0xC0000005 NULL deref,
            # Windows stage3 mir boundary). Default it to the front.
            val span_start = if const_.span == nil: 0 else: const_.span.start
            key_span.push(span_start)
            key_symbol.push(const_.symbol.id)
        di = di + 1
    # Stable insertion sort is O(n^2) in this module's dynamic globals only.
    var i = 1
    while i < order.len():
        val cur_order = order[i]
        val cur_span = key_span[i]
        val cur_symbol = key_symbol[i]
        var j = i - 1
        while j >= 0:
            val before = cur_span < key_span[j] or
                (cur_span == key_span[j] and cur_symbol < key_symbol[j])
            if not before: break
            order[j + 1] = order[j]
            key_span[j + 1] = key_span[j]
            key_symbol[j + 1] = key_symbol[j]
            j = j - 1
        order[j + 1] = cur_order
        key_span[j + 1] = cur_span
        key_symbol[j + 1] = cur_symbol
        i = i + 1
    var out: [HirConst] = []
    for ordered_index in order:
        val selected: HirConst = consts[ordered_index]
        out.push(selected)
    out

fn mir_layout_canonical_module_name(name: text) -> text:
    """Fold every spelling of ONE physical module onto a single dotted name.

    ROOT FIX for the qualified-key namespace mismatch (bug
    mir_qualified_field_key_namespace_mismatch_2026-08-08): `defining_module`
    is populated from TWO DIFFERENT NAMESPACES depending on how a symbol was
    created.

    - DECLARATION (`declare_module_types`, 20.hir/hir_lowering/_Items/
      module_lowering.spl) stores `self.module_filename` -- a repo-relative
      FILE PATH (`src/compiler/55.borrow/nll.spl`). Every qualified
      `struct_field_order` key is registered from these symbols.
    - IMPORT (`register_imported_symbol`, same file) stores
      `imported_mod.module_name` -- the DOTTED LOGICAL NAME
      (`compiler.borrow.nll`).

    So `composite_layout_key` produced `src/compiler/55.borrow/nll.spl::X` on
    the producer side and `compiler.borrow.nll::X` on the consumer side, and
    the module-qualified tier added by `b9e23914a0e` could never fire across
    an import -- precisely the case it was written to fix. It fired only for
    locally-declared types, where the bare tier was already correct thanks to
    the `overwrite: true` re-registration below.

    Normalizing HERE rather than at the two population sites is deliberate:
    `defining_module` is load-bearing for other consumers (visibility
    matching in 20.hir/hir_lowering/types.spl compares it against literal
    PATHS), so changing what is stored would have a blast radius far beyond
    layout keying. `composite_layout_key` is the single funnel through which
    both the registration sites and the read tier pass, so one normalization
    makes producer and consumer agree by construction.

    The dotted logical name is the canonical namespace (not the path) because
    it is stable under the numbered-directory/symlink layout: `src/compiler`
    exposes both `50.mir/` (real) and `mir/` (symlink), so ONE module has two
    distinct path spellings but only one dotted name. Applies the same two
    rules as `hir_pkg_canonical_module_name`: drop all-digit tier segments and
    fold a leading `std.` to `lib.`."""
    _hir_symbol_owner_module(name)

impl MirLowering:
    static fn new(symbols: SymbolTable) -> MirLowering:
        val target_context = mir_target_context_from("", "unknown", "unknown", "llvm", -1)
        MirLowering.new_for_target(symbols, target_context)

    static fn new_for_target(symbols: SymbolTable, target_context: MirTargetContext) -> MirLowering:
        val empty_loop_stack: [(BlockId, BlockId)] = []
        val empty_errors: [MirError] = []
        MirLowering(
            builder: MirBuilder.new(),
            symbols: symbols,
            local_map: {},
            local_symbol_ids: [],
            local_symbol_values: [],
            local_symbol_index_slots: [],
            local_hir_type_ids: [],
            local_hir_type_values: [],
            local_hir_type_isolation_states: [],
            local_hir_type_resource_states: [],
            fn_return_types: {},
