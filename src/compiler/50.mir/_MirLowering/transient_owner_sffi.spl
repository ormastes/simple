# Raw runtime boundary for MIR transient-owner scope management and root
# promotion.
#
# Keep the ABI operations in this sanctioned SFFI provider. Product lowering
# code consumes only the semantic operations below.

@unsafe(reason: "begin the per-module transient allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool

@unsafe(reason: "pause the per-module transient allocation scope before promotion", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool

@unsafe(reason: "end the per-module transient allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool

@unsafe(reason: "promote a managed root inventory across the paused transient scope", capabilities: [ffi])
extern fn rt_transient_heap_promote<T>(value: T) -> bool

@unsafe(reason: "release the temporary managed root inventory after promotion", capabilities: [ffi])
extern fn rt_array_free<T>(array: [T])

@unsafe(reason: "open the promotion share window over the paused transient scope", capabilities: [ffi])
extern fn rt_transient_heap_promote_share_begin() -> bool

@unsafe(reason: "close the promotion share window", capabilities: [ffi])
extern fn rt_transient_heap_promote_share_end() -> bool

fn transient_array_scope_begin_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

fn transient_array_scope_pause_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

fn transient_array_scope_end_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

fn transient_heap_promote_v1<T>(value: T) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

# Inside the share window a promote does not re-walk nodes an earlier promote
# of the same window committed, turning the owner's ~190 overlapping root
# promotions from O(roots x graph) into O(graph). Contract (no write barrier
# exists): between begin and end the caller only promotes and releases
# temporary root carriers. begin answers false without a paused scope, and
# promotion is then simply unshared; the promoted set is identical either way.
fn transient_heap_promote_share_begin_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote_share_begin()

fn transient_heap_promote_share_end_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote_share_end()

fn promote_and_release_transient_owner_roots<T>(roots: [T]) -> bool:
    unsafe(capabilities: [ffi]):
        val promoted = rt_transient_heap_promote(roots)
        rt_array_free(roots)
        promoted
