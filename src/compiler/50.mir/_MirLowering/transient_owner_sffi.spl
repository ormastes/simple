# Raw runtime boundary for MIR transient-owner scope management and root
# promotion.
#
# Keep the ABI operations in this sanctioned SFFI provider. Product lowering
# code consumes only the semantic operations below.

@unsafe(reason: "begin the per-module transient allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool

@unsafe(reason: "pause the per-module transient allocation scope before promotion", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool

@unsafe(reason: "end the per-module transient allocation scope", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool

@unsafe(reason: "promote a managed root inventory across the paused transient scope", capabilities: [ffi])
extern fn rt_transient_heap_promote(value: Any) -> bool

@unsafe(reason: "release the temporary managed root inventory after promotion", capabilities: [ffi])
extern fn rt_array_free(array: [Any])

fn transient_array_scope_begin_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

fn transient_array_scope_pause_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

fn transient_array_scope_end_v1() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

fn transient_heap_promote_v1(value: Any) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

fn promote_and_release_transient_owner_roots(roots: [Any]) -> bool:
    unsafe(capabilities: [ffi]):
        val promoted = rt_transient_heap_promote(roots)
        rt_array_free(roots)
        promoted
