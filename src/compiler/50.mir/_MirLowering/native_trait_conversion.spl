use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_target_hir_symbol_writes.{mir_symbol_write_record}
use compiler.mir.mir_lowering_stmts.{mir_expr_kind_is_place}
use compiler.mir.mir_data.*
use compiler.mir.mir_instruction_support.{MirBinOp}
use compiler.mir.mir_types.*
use compiler.mir.mir_instructions.*
use compiler.mir.native_trait_metadata.*
use compiler.mir._MirLowering.native_trait_registration.*
use compiler.mir._MirLowering.native_trait_dispatch.*
use compiler.mir._MirLowering.native_trait_thunks.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use std.common.crypto.sha256.{sha256_text}

impl MirLowering:
    me coerce_native_trait_assignment(local: LocalId, kind: HirExprKind,
            expected: HirType, span: Span) -> LocalId:
        val source_type = self.find_local_hir_type(local.id)
        val value = HirExpr(kind: kind, has_type_: source_type != nil,
            type_: source_type ?? HirType(kind: HirTypeKind.Unit, span: span), span: span)
        var converted = self.coerce_native_trait_object(local, value, expected)
        if self.native_trait_value_type(expected) and mir_expr_kind_is_place(kind):
            converted = self.copy_native_trait_value(converted, expected)
        converted

    me coerce_native_trait_object(local: LocalId, value: HirExpr, expected: HirType) -> LocalId:
        match expected.kind:
            case HirTypeKind.Isolated(inner):
                if self.native_trait_owner_for_type(inner) != "":
                    self.error_fatal("native isolated trait conversion requires an owned transfer slot", Some(value.span))
                    return local
            case HirTypeKind.Optional(inner):
                if self.native_trait_owner_for_type(inner) != "":
                    match value.kind:
                        case HirExprKind.NilLit: return self.ensure_option_handle(local, expected)
                        case _: ()
                    # `Some(<concrete>)`: `local` is the already-built Option
                    # handle (typed `Concrete?`, or untyped), which names no
                    # implementation itself -- the impl search failed with an
                    # EMPTY concrete owner, or the declared-payload check
                    # rejected `Concrete?`. Statically Some, so take its
                    # payload word and convert THAT, typed by the `Some`
                    # argument, to the trait object before re-wrapping.
                    val some_argument = self.native_trait_some_argument(value)
                    if val existing = self.native_trait_declared_source_type(local, value):
                        match existing.kind:
                            case HirTypeKind.Optional(existing_inner):
                                if self.native_trait_owner_for_type(existing_inner) == self.native_trait_owner_for_type(inner):
                                    self.option_value_locals[local.id] = true
                                    self.mark_runtime_value_local(local.id)
                                    return local
                                if some_argument == nil:
                                    self.error_fatal("native optional trait conversion requires a matching declared payload", Some(value.span))
                                    return local
                            case _: ()
                    if val some_payload_expr = some_argument:
                        val raw_payload = self.native_trait_some_payload_word(local, value)
                        val payload = self.coerce_native_trait_object(raw_payload, some_payload_expr, inner)
                        return self.ensure_option_handle(payload, expected)
                    # Use the same Option owner as ordinary call/field
                    # lowering, after the payload has the real trait ABI.
                    val payload = self.coerce_native_trait_object(local, value, inner)
                    return self.ensure_option_handle(payload, expected)
            case _: ()
        val owner = self.native_trait_owner_for_type(expected)
        if owner == "": return local
        # A resource drop must target its concrete runtime owner, never the
        # two-word envelope. Do not publish an unsupported destructor ABI.
        if self.local_hir_type_resource_state(local.id) != 0:
            self.error_fatal("native trait resource conversion requires a concrete drop slot", Some(value.span))
            return local
        # An already trait-typed source (typed local, declared field chain,
        # declared container read) is this trait's object: move the existing
        # (data, table) value. Only a concrete source searches for an impl.
        val source_type = self.native_trait_declared_source_type(local, value)
        if val existing = source_type:
            if self.native_trait_owner_for_kind(existing.kind) == owner: return local
        val layout_index = self.native_trait_layout_index(owner)
        if layout_index < 0:
            self.error_fatal("native trait conversion lacks canonical declaration: {owner}", Some(value.span))
            return local
        var concrete_owner = ""
        if val source = source_type:
            match source.kind:
                case HirTypeKind.Isolated(_):
                    self.error_fatal("native trait conversion cannot erase isolated ownership", Some(value.span))
                    return local
                case HirTypeKind.Named(symbol_id, _):
                    # Presence alone does not unwrap HirSymbol?: the .kind reads
                    # and the concrete-param call need the payload (ABI defect
                    # class 4710b22a991).
                    if val present_symbol = self.symbols.get_symbol_raw(symbol_id.id):
                        val symbol: HirSymbol = present_symbol
                        if symbol.kind == SymbolKind.Class or symbol.kind == SymbolKind.Struct:
                            concrete_owner = native_trait_qualified_owner(symbol)
                case _: ()
        # Construction provenance names a concrete type, never a trait or a
        # candidate inferred from the number of implementations.
        if concrete_owner == "":
            val provenance = self.struct_value_syms.get(local.id) ?? ""
            if provenance != "":
                val symbol_id = self.symbols.lookup_or_invalid(provenance)
                if val present_symbol = self.symbols.get_symbol_raw(symbol_id.id):
                    val symbol: HirSymbol = present_symbol
                    if symbol.kind == SymbolKind.Class or symbol.kind == SymbolKind.Struct:
                        concrete_owner = native_trait_qualified_owner(symbol)
        var selected = -1
        var index = 0
        while index < self.native_trait_implementations.len():
            val candidate = self.native_trait_implementations[index]
            if candidate.trait_owner == owner and candidate.concrete_owner == concrete_owner:
                if selected >= 0:
                    self.error_fatal("ambiguous native trait implementation: {owner} for {concrete_owner}", Some(value.span))
                    return local
                selected = index
            index = index + 1
        if selected < 0:
            self.error_fatal("missing native trait implementation: {owner} for {concrete_owner}", Some(value.span))
            return local
        val implementation = self.native_trait_implementations[selected]
        val layout = self.native_trait_layouts[layout_index]
        val rejection = self.native_trait_implementation_rejection(layout, implementation)
        if rejection != "":
            self.error_fatal("incompatible native trait object signature: {owner} for {concrete_owner}: {rejection}", Some(value.span))
            return local
        # The concrete type is known only here, so this is where its
        # trait-to-trait cast thunk is emitted (see native_trait_cast_thunk).
        val cast_name = self.native_trait_cast_thunk(concrete_owner)
        var builder = self.builder
        val data = builder.emit_bitcast(mir_operand_copy(local), native_trait_data_pointer_type())
        self.builder = builder
        val object = self.emit_native_trait_object_for(implementation, layout, data, cast_name)
        val isolation_state = self.local_hir_type_isolation_state(local.id)
        val resource_state = self.local_hir_type_resource_state(local.id)
        self.remember_local_hir_type(object.id, expected, isolation_state, resource_state)
        object

    me native_trait_some_argument(value: HirExpr) -> HirExpr?:
        """The single argument of a `Some(arg)` construction, else nil."""
        match value.kind:
            case HirExprKind.Call(callee, args, _):
                if args.len() != 1: return nil
                var name = ""
                match callee.kind:
                    case HirExprKind.Var(symbol):
                        if val present_symbol = self.symbols.get_symbol_raw(symbol.id):
                            val symbol_entry: HirSymbol = present_symbol
                            name = symbol_entry.name
                    case HirExprKind.NamedVar(_, named): name = named
                    case _: ()
                if name == "Some": return Some(args[0].value)
                nil
            case _: nil

    me native_trait_some_payload_word(option: LocalId, value: HirExpr) -> LocalId:
        """Payload word of a statically-Some Option handle, carrying the
        `Some` argument's static type: its own HIR type, else the class or
        struct a constructor call `Concrete(..)` names."""
        var builder = self.builder
        val enum_signature = MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false, params_known: true)
        val payload_fn = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_enum_payload"), MirType(kind: MirTypeKind.FuncPtr(enum_signature))))
        val payload_result = builder.emit_call(payload_fn, [mir_operand_copy(option)], MirType.i64())
        self.builder = builder
        if payload_result == nil:
            self.error_fatal("native optional trait conversion lacks payload", Some(value.span))
            return option
        val payload = payload_result ?? LocalId(id: -1)
        val argument = self.native_trait_some_argument(value) ?? value
        var payload_type: HirType? = nil
        if argument.has_type_ and argument.type_ != nil:
            val argument_type = argument.type_ ?? HirType(kind: HirTypeKind.Error, span: value.span)
            match argument_type.kind:
                case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Unit: ()
                case _: payload_type = Some(argument_type)
        if payload_type == nil:
            match argument.kind:
                case HirExprKind.Call(callee, _, _):
                    var constructor = SymbolId(id: -1)
                    match callee.kind:
                        case HirExprKind.Var(symbol): constructor = symbol
                        case HirExprKind.NamedVar(symbol, _): constructor = symbol
                        case _: ()
                    if constructor.id >= 0:
                        if val present_symbol = self.symbols.get_symbol_raw(constructor.id):
                            val symbol_entry: HirSymbol = present_symbol
                            if symbol_entry.kind == SymbolKind.Class or symbol_entry.kind == SymbolKind.Struct:
                                payload_type = Some(HirType(kind: HirTypeKind.Named(constructor, []), span: value.span))
                case _: ()
        # `Some(c)` with `c` an unannotated local (`val c = Concrete(..)`):
        # type the payload the way the direct `slot = c` form types `c` -- the
        # binding's remembered HIR type, else its construction provenance.
        if payload_type == nil:
            payload_type = self.receiver_declared_type(argument)
        if payload_type == nil:
            var argument_symbol = -1
            match argument.kind:
                case HirExprKind.Var(var_symbol): argument_symbol = var_symbol.id
                case HirExprKind.NamedVar(named_symbol, _): argument_symbol = named_symbol.id
                case _: ()
            if argument_symbol >= 0:
                val argument_local = self.find_local(argument_symbol)
                if argument_local.id >= 0:
                    val provenance = self.struct_value_syms.get(argument_local.id) ?? ""
                    if provenance != "":
                        self.struct_value_syms[payload.id] = provenance
        if val known = payload_type:
            self.remember_local_hir_type(payload.id, known, 0, 0)
        payload

    me native_trait_declared_source_type(local: LocalId, value: HirExpr) -> HirType?:
        """Static type of a conversion source without lowering anything: the
        local's remembered HIR type, then the expression's own type, then the
        declared type of a binding/field chain (`parsed.parser` with
        `parser: Trait?` -- its field-load local carries no HIR type), then a
        declared container read (`self.blocks[kind]` on Dict<text, Trait>).
        A missing answer leaves the concrete-implementation search in charge."""
        if val local_type = self.find_local_hir_type(local.id):
            # Only top-level Error/Infer are unavailable local metadata.
            # Any, Unit and nested unknown payloads remain authoritative.
            match local_type.kind:
                case HirTypeKind.Error | HirTypeKind.Infer(_, _): ()
                case _: return Some(local_type)
        if value.has_type_ and value.type_ != nil:
            val expression_type = value.type_ ?? HirType(kind: HirTypeKind.Error, span: value.span)
            match expression_type.kind:
                case HirTypeKind.Infer(_, _) | HirTypeKind.Error | HirTypeKind.Unit: ()
                case _: return Some(expression_type)
        # receiver_declared_type intentionally trusts all bound-local metadata.
        # This conversion alone treats top-level Error/Infer as unavailable,
        # including when the binding points back to the same unknown local.
        match value.kind:
            case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _):
                return self.native_trait_declared_binding_type(symbol)
            case _: ()
        if val declared = self.receiver_declared_type(value):
            return Some(declared)
        self.declared_container_read_type(value)

    me native_trait_declared_binding_type(symbol: SymbolId) -> HirType?:
        val bound = self.find_local(symbol.id)
        if bound.id >= 0:
            if val bound_type = self.find_local_hir_type(bound.id):
                match bound_type.kind:
                    case HirTypeKind.Error | HirTypeKind.Infer(_, _): ()
                    case _: return Some(bound_type)
        if val declaration = self.symbols.get_symbol_raw(symbol.id):
            return declaration.type_
        nil

    me emit_native_trait_object_for(implementation: NativeTraitImplementation,
            layout: NativeTraitLayout, data: LocalId, cast_name: text) -> LocalId:
        """Build `(data, table)` on self.builder. Table slots: copy thunk,
        reference semantics, the layout's method thunks in canonical order,
        then the concrete type's cast thunk. The cast slot is LAST so every
        method slot keeps its `index + 2` position (emit_native_trait_slot_call)."""
        val copy_name = self.native_trait_copy_thunk(implementation)
        val copy_signature = MirSignature(params: [native_trait_data_pointer_type()],
            return_type: native_trait_data_pointer_type(), is_variadic: false, params_known: true)
        var table_types: [MirType] = [MirType(kind: MirTypeKind.FuncPtr(copy_signature)), MirType.bool()]
        var table_values: [MirOperand] = [MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(copy_name), table_types[0])),
            MirOperand(kind: MirOperandKind.Const(MirConstValue.Bool(implementation.reference_semantics), MirType.bool()))]
        var index = 0
        while index < layout.methods.len():
            val signature = self.native_trait_slot_signature(layout.methods[index])
            val name = self.native_trait_method_thunk(implementation, layout.methods[index], index)
            val type_ = MirType(kind: MirTypeKind.FuncPtr(signature))
            table_types.push(type_)
            table_values.push(MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name), type_)))
            index = index + 1
        val cast_type = MirType(kind: MirTypeKind.FuncPtr(native_trait_cast_signature()))
        table_types.push(cast_type)
        table_values.push(MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(cast_name), cast_type)))
        var builder = self.builder
        val table = builder.emit_aggregate(AggregateKind.Tuple, table_values,
            MirType(kind: MirTypeKind.Tuple(table_types)))
        val object = builder.emit_aggregate(AggregateKind.Tuple,
            [mir_operand_copy(data), mir_operand_copy(table)], native_trait_object_type())
        self.builder = builder
        object

    me native_trait_cast_thunk(concrete_owner: text) -> text:
        """`(data, target_trait_id) -> object word | nil word (3)` for one
        concrete type: a compare chain over every trait implementation of
        `concrete_owner` visible to this module, building the target trait's
        object around the same data pointer. Implementations the converting
        module cannot see (declared in a module it does not import) answer
        nil, exactly like a type that does not implement the target."""
        val name = "__simple_trait_cast_" + sha256_text(self.current_module_id + "\n" + concrete_owner)
        for existing in self.native_trait_thunks:
            if existing.name == name: return name
        val signature = native_trait_cast_signature()
        val symbol = self.symbols.define(name, SymbolKind.Function, nil,
            Span.empty(), Visibility.Private, false, nil)
        self.symbol_write_ledger = mir_symbol_write_record(self.symbol_write_ledger, "trait_conversion_writes", name, symbol.id)
        val outer_builder = self.builder
        var builder = MirBuilder.new()
        builder.begin_function(symbol, name, signature, Span.empty())
        var data = LocalId(id: -1)
        var target_id = LocalId(id: -1)
        for local in builder.locals:
            match local.kind:
                case LocalKind.Arg(0): data = local.id
                case LocalKind.Arg(1): target_id = local.id
                case _: ()
        var seen_ids: Dict<i64, text> = {}
        var index = 0
        while index < self.native_trait_implementations.len():
            val implementation = self.native_trait_implementations[index]
            index = index + 1
            if implementation.concrete_owner != concrete_owner: continue
            val layout_index = self.native_trait_layout_index(implementation.trait_owner)
            if layout_index < 0: continue
            val layout = self.native_trait_layouts[layout_index]
            if not layout.object_safe: continue
            if self.native_trait_implementation_rejection(layout, implementation) != "": continue
            val id = native_trait_cast_id(implementation.trait_owner)
            if val prior = seen_ids.get(id):
                if prior != implementation.trait_owner:
                    self.builder = outer_builder
                    self.error_fatal("native trait cast id collision: {prior} and {implementation.trait_owner}", nil)
                    return name
                continue
            seen_ids[id] = implementation.trait_owner
            val wanted = builder.emit_const_int(id)
            val matches = builder.emit_binop(MirBinOp.Eq, mir_operand_copy(target_id), mir_operand_copy(wanted), MirType.bool())
            val hit = builder.new_block(Some("trait_cast_hit"))
            val next = builder.new_block(Some("trait_cast_next"))
            builder.terminate_if(mir_operand_copy(matches), hit, next)
            builder.switch_to_block(hit)
            self.builder = builder
            val object = self.emit_native_trait_object_for(implementation, layout, data, name)
            builder = self.builder
            val word = builder.emit_bitcast(mir_operand_copy(object), MirType.i64())
            builder.set_terminator(MirTerminator.Ret(Some(mir_operand_copy(word))))
            builder.switch_to_block(next)
        val miss = builder.emit_const_int(3)
        builder.set_terminator(MirTerminator.Ret(Some(mir_operand_copy(miss))))
        self.native_trait_thunks.push(builder.end_function())
        self.builder = outer_builder
        name

    me lower_native_trait_as(local: LocalId, operand: HirExpr, target: HirType, span: Span, optional_context: bool) -> LocalId:
        """`e as T` for a native trait `T`. A trait-typed `e` is a checked
        downcast through the source vtable's cast thunk and yields `T?`
        (nil when the dynamic type does not implement `T`, as in the
        interpreter). A concrete `e` converts statically and fails the build
        when the type has no implementation of `T`.

        HIR types the Cast as `T`, so the `T?` result is only sound under an
        Optional consumer (`optional_context`: the `.?` that `if val x = e as
        T` desugars to). Anywhere else the trait-to-trait form is a compile
        error, never an Option handle silently read as a trait object."""
        val target_owner = self.native_trait_owner_for_type(target)
        var source_type: HirType? = self.find_local_hir_type(local.id)
        if source_type == nil and operand.has_type_ and operand.type_ != nil:
            source_type = operand.type_
        var source_owner = ""
        if val source = source_type:
            source_owner = self.native_trait_owner_for_kind(source.kind)
        if source_owner == "":
            return self.coerce_native_trait_object(local, operand, target)
        if source_owner == target_owner:
            if not optional_context: return local
            return self.ensure_option_handle(local, HirType(kind: HirTypeKind.Optional(target), span: span))
        if not optional_context:
            self.error_fatal("E-MIR-TRAIT-CAST-CONTEXT: `e as {target_owner}` on a {source_owner} value is a checked downcast yielding `{target_owner}?`; use it only as `if val x = e as {target_owner}:` or `(e as {target_owner}).?`", Some(span))
            return local
        val optional_target = HirType(kind: HirTypeKind.Optional(target), span: span)
        val source_index = self.native_trait_layout_index(source_owner)
        val target_index = self.native_trait_layout_index(target_owner)
        if source_index < 0 or target_index < 0:
            self.error_fatal("native trait cast lacks canonical declaration: {source_owner} as {target_owner}", Some(span))
            return local
        if not self.native_trait_layouts[target_index].object_safe:
            self.error_fatal("native trait cast target is not object-safe: {target_owner}", Some(span))
            return local
        # A thunk only checks ids among its own type's traits; refuse a
        # target whose id another visible trait shares, or the thunk could
        # hand back that trait's vtable.
        val target_id = native_trait_cast_id(target_owner)
        for other in self.native_trait_layouts:
            if other.owner != target_owner and native_trait_cast_id(other.owner) == target_id:
                self.error_fatal("native trait cast id collision: {other.owner} and {target_owner}", Some(span))
                return local
        val cast_slot = self.native_trait_layouts[source_index].methods.len() + 2
        val signature = native_trait_cast_signature()
        var builder = self.builder
        val data = builder.emit_get_field(mir_operand_copy(local), 0, native_trait_data_pointer_type())
        val table = builder.emit_get_field(mir_operand_copy(local), 1, native_trait_data_pointer_type())
        val thunk = builder.emit_get_field(mir_operand_copy(table), cast_slot, MirType(kind: MirTypeKind.FuncPtr(signature)))
        val wanted = builder.emit_const_int(target_id)
        val word_result = builder.emit_call_indirect(mir_operand_copy(thunk),
            [mir_operand_copy(data), mir_operand_copy(wanted)], signature, signature.return_type)
        if word_result == nil:
            self.builder = builder
            self.error_fatal("native trait cast thunk lacks its required result", Some(span))
            return local
        val word = word_result ?? LocalId(id: -1)
        val object = builder.emit_bitcast(mir_operand_copy(word), native_trait_object_type())
        self.builder = builder
        self.remember_local_hir_type(object.id, target, 0, 0)
        self.ensure_option_handle(object, optional_target)

    me copy_native_trait_value(local: LocalId, type_: HirType) -> LocalId:
        if self.native_trait_owner_for_type(type_) != "":
            return self.copy_native_trait_object(local)
        match type_.kind:
            case HirTypeKind.Optional(inner):
                if self.native_trait_owner_for_type(inner) == "": return local
                # The declared Optional ABI is an enum handle. Branch before
                # reading its payload: None has no data or vtable to copy.
                self.option_value_locals[local.id] = true
                self.mark_runtime_value_local(local.id)
                var builder = self.builder
                val storage = builder.emit_entry_alloc(MirType.i64())
                builder.emit_store(mir_operand_copy(storage), mir_operand_copy(local))
                val enum_signature = MirSignature(params: [MirType.i64()], return_type: MirType.i64(), is_variadic: false, params_known: true)
                val discriminant_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_enum_discriminant"), MirType(kind: MirTypeKind.FuncPtr(enum_signature))))
                val discriminant_result = builder.emit_call(discriminant_fn, [mir_operand_copy(local)], MirType.i64())
                if discriminant_result == nil:
                    self.builder = builder
                    self.error_fatal("native optional trait copy lacks discriminant", nil)
                    return local
                val discriminant = discriminant_result ?? LocalId(id: -1)
                val some_tag = builder.emit_const_int(0)
                val present = builder.emit_binop(MirBinOp.Eq, mir_operand_copy(discriminant), mir_operand_copy(some_tag), MirType.bool())
                val copy_block = builder.new_block(Some("trait_option_copy_some"))
                val merge_block = builder.new_block(Some("trait_option_copy_merge"))
                builder.terminate_if(mir_operand_copy(present), copy_block, merge_block)
                builder.switch_to_block(copy_block)
                val payload_fn = MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str("rt_enum_payload"), MirType(kind: MirTypeKind.FuncPtr(enum_signature))))
                val payload_result = builder.emit_call(payload_fn, [mir_operand_copy(local)], MirType.i64())
                self.builder = builder
                if payload_result == nil:
                    self.error_fatal("native optional trait copy lacks payload", nil)
                    return local
                val raw_payload = payload_result ?? LocalId(id: -1)
                builder = self.builder
                val payload = builder.emit_bitcast(mir_operand_copy(raw_payload), native_trait_object_type())
                self.builder = builder
                self.remember_local_hir_type(payload.id, inner, 2, 0)
                val copied = self.copy_native_trait_object(payload)
                val wrapped = self.ensure_option_handle(copied, type_)
                builder = self.builder
                builder.emit_store(mir_operand_copy(storage), mir_operand_copy(wrapped))
                builder.terminate_goto(merge_block)
                builder.switch_to_block(merge_block)
                val loaded = builder.emit_load(mir_operand_copy(storage), MirType.i64())
                self.builder = builder
                val result = self.tag_enum_construct_result(loaded)
                self.option_value_locals[result.id] = true
                self.mark_runtime_value_local(result.id)
                self.remember_local_hir_type(result.id, type_, 2, 0)
                return result
            case _: return local

    me copy_native_trait_object(local: LocalId) -> LocalId:
        var builder = self.builder
        val data = builder.emit_get_field(mir_operand_copy(local), 0, native_trait_data_pointer_type())
        val table = builder.emit_get_field(mir_operand_copy(local), 1, native_trait_data_pointer_type())
        val signature = MirSignature(params: [native_trait_data_pointer_type()],
            return_type: native_trait_data_pointer_type(), is_variadic: false, params_known: true)
        val copy = builder.emit_get_field(mir_operand_copy(table), 0, MirType(kind: MirTypeKind.FuncPtr(signature)))
        val copied = builder.emit_call_indirect(mir_operand_copy(copy), [mir_operand_copy(data)], signature, signature.return_type)
        if val copied_data = copied:
            val object = builder.emit_aggregate(AggregateKind.Tuple,
                [mir_operand_copy(copied_data), mir_operand_copy(table)], native_trait_object_type())
            self.builder = builder
            self.copy_local_hir_type_metadata(local.id, object.id)
            return object
        self.builder = builder
        self.error_fatal("native trait copy thunk lacks its required result", nil)
        local
