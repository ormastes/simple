# Complex direct destination-expression emitters kept separate from the hot
# scalar dispatcher.  Inputs remain frozen row indices.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_declarations.{HD_ENUM_PAYLOAD_TUPLE, HD_ENUM_PAYLOAD_STRUCT}
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir._MirLowering.hir_destination_types.*
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirInst, MirInstKind, MirAsmOperand}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirConstValue, MirSignature}
use compiler.mir.mir_instructions.{MirOperand, MirOperandKind}
use compiler.frontend.parser_types_expr.{AsmConstraintKind, AsmLocation}

fn destination_complex_asm_kind(shape: i64) -> AsmConstraintKind:
    if shape == 1: return AsmConstraintKind.Out
    if shape == 2: return AsmConstraintKind.InOut
    if shape == 3: return AsmConstraintKind.LateOut
    AsmConstraintKind.In

fn destination_complex_asm_location(shape: i64, register: text) -> AsmLocation:
    if shape == 1: return AsmLocation.RegSpec(register)
    if shape == 2: return AsmLocation.Mem
    if shape == 3: return AsmLocation.Imm
    AsmLocation.Reg

fn destination_complex_text_range(r: MirDestinationFunctionReceipt,
        handle: i64) -> [text]:
    var values: [text] = []
    val subtype = hdr_range_subtype(r.slot, r.generation, handle)
    val count = hdr_range_length(r.slot, r.generation, handle)
    var offset = 0
    while offset < count:
        val aux = hdr_range_value(r.slot, r.generation, handle, subtype, offset)
        values.push(hdr_aux_text(r.slot, r.generation, aux, 0))
        offset = offset + 1
    values

impl MirLowering:
    me destination_enum_expr_operands(r: MirDestinationFunctionReceipt,
            declaration_row: i64, variant_ordinal: i64, has_payload: bool,
            payload_aux: i64) -> [MirOperand]:
        val variant = hdr_decl_enum_variant_name(r.slot, r.generation,
            declaration_row, variant_ordinal)
        val arity = hdr_decl_enum_variant_i64(r.slot, r.generation,
            declaration_row, variant_ordinal, 4)
        val declared_kind = hdr_decl_enum_variant_i64(r.slot, r.generation,
            declaration_row, variant_ordinal, 1)
        if variant == "" or arity < 0:
            self.error_fatal("E-MIR-DESTINATION-ENUM: frozen payload authority is absent", nil); return []
        if not has_payload:
            if arity != 0:
                self.error_fatal("E-MIR-DESTINATION-ENUM: missing payload for " + variant, nil)
            return []
        val payload_shape = hdr_aux_shape(r.slot, r.generation, payload_aux)
        val handle = hdr_aux_range(r.slot, r.generation, payload_aux)
        val subtype = hdr_range_subtype(r.slot, r.generation, handle)
        val count = hdr_range_length(r.slot, r.generation, handle)
        if count != arity:
            self.error_fatal("E-MIR-DESTINATION-ENUM: payload arity mismatch for " + variant, nil); return []
        var values: [MirOperand] = []
        if declared_kind == HD_ENUM_PAYLOAD_TUPLE:
            if payload_shape != HD_AUX_ENUM_TUPLE:
                self.error_fatal("E-MIR-DESTINATION-ENUM: tuple payload requires positional arguments for " + variant, nil); return []
            var ordinal = 0
            while ordinal < arity:
                val expr = hdr_range_value(r.slot, r.generation, handle, subtype, ordinal)
                val payload_type = hdr_decl_enum_payload_i64(r.slot, r.generation,
                    declaration_row, variant_ordinal, ordinal, 0)
                val expected_mir = mir_destination_lower_type_scalar_checked(
                    r.slot, r.generation, payload_type)
                if not expected_mir.?:
                    self.error_fatal("E-MIR-DESTINATION-ENUM: invalid frozen payload type for " + variant, nil); return []
                values.push(mir_operand_copy(self.mir_destination_lower_expr_row(r, expr, expected_mir)))
                ordinal = ordinal + 1
            return values
        if declared_kind != HD_ENUM_PAYLOAD_STRUCT or payload_shape != HD_AUX_ENUM_STRUCT:
            self.error_fatal("E-MIR-DESTINATION-ENUM: payload form does not match declaration for " + variant, nil); return []
        # Resolve each source field through the frozen declaration hash bank.
        # This is O(n), preserves declaration order, and detects duplicates
        # without an ephemeral text-keyed map.
        var ordered: [MirOperand] = []; var present: [bool] = []
        var ordinal = 0
        while ordinal < arity:
            ordered.push(mir_operand_const_int(0)); present.push(false)
            ordinal = ordinal + 1
        var offset = 0
        while offset < count:
            val named = hdr_range_value(r.slot, r.generation, handle, subtype, offset)
            val field_name = hdr_aux_text(r.slot, r.generation, named, 0)
            ordinal = hdr_decl_enum_payload_lookup(r.slot, r.generation,
                declaration_row, variant_ordinal, field_name)
            if ordinal < 0 or ordinal >= arity:
                self.error_fatal("E-MIR-DESTINATION-ENUM: unknown payload field " + field_name, nil); return []
            if present[ordinal]:
                self.error_fatal("E-MIR-DESTINATION-ENUM: duplicate payload field " + field_name, nil); return []
            val payload_type = hdr_decl_enum_payload_i64(r.slot, r.generation,
                declaration_row, variant_ordinal, ordinal, 0)
            val expected_mir = mir_destination_lower_type_scalar_checked(
                r.slot, r.generation, payload_type)
            if not expected_mir.?:
                self.error_fatal("E-MIR-DESTINATION-ENUM: invalid frozen payload type for " + field_name, nil); return []
            ordered[ordinal] = mir_operand_copy(self.mir_destination_lower_expr_row(r,
                hdr_aux_i64(r.slot, r.generation, named, 0), expected_mir))
            present[ordinal] = true; offset = offset + 1
        ordinal = 0
        while ordinal < arity:
            if not present[ordinal]:
                self.error_fatal("E-MIR-DESTINATION-ENUM: missing payload field " +
                    hdr_decl_enum_payload_name(r.slot, r.generation, declaration_row,
                        variant_ordinal, ordinal), nil); return []
            ordinal = ordinal + 1
        values = ordered
        values

    me destination_struct_expr_operands(r: MirDestinationFunctionReceipt,
            type_row: i64, handle: i64) -> [MirOperand]:
        val owner = hdr_type_i64(r.slot, r.generation, type_row, 0)
        val defining_module = hdr_type_i64(r.slot, r.generation, type_row, 1)
        val member_count = hdr_destination_member_range_len(r.slot, r.generation,
            defining_module, owner)
        if owner < 0 or defining_module < 0 or member_count < 0:
            self.error_fatal("E-MIR-DESTINATION-STRUCT: defining-module member authority is absent", nil); return []
        var values: [LocalId] = []; var present: [bool] = []; var ordinal = 0
        while ordinal < member_count:
            values.push(LocalId(id: -1)); present.push(false); ordinal = ordinal + 1
        val subtype = hdr_range_subtype(r.slot, r.generation, handle)
        val count = hdr_range_length(r.slot, r.generation, handle)
        var offset = 0
        while offset < count:
            val field = hdr_range_value(r.slot, r.generation, handle, subtype, offset)
            val name = hdr_aux_text(r.slot, r.generation, field, 0)
            val member = hdr_destination_member_lookup_name(r.slot, r.generation,
                defining_module, owner, name)
            ordinal = hdr_destination_member_ordinal(r.slot, r.generation, member)
            if member < 0 or ordinal < 0 or ordinal >= member_count:
                self.error_fatal("E-MIR-DESTINATION-STRUCT: unknown field " + name, nil); return []
            if present[ordinal]:
                self.error_fatal("E-MIR-DESTINATION-STRUCT: duplicate field " + name, nil); return []
            values[ordinal] = self.mir_destination_lower_expr_row(r,
                hdr_aux_i64(r.slot, r.generation, field, 0),
                if hdr_destination_member_has_type(r.slot, r.generation, member):
                    Some(self.destination_checked_type(r,
                        hdr_destination_member_type(r.slot, r.generation, member),
                        "struct field"))
                else:
                    nil)
            present[ordinal] = true; offset = offset + 1
        var operands: [MirOperand] = []; ordinal = 0
        while ordinal < member_count:
            val member = hdr_destination_member_lookup_ordinal(r.slot, r.generation,
                defining_module, owner, ordinal)
            if not present[ordinal]:
                if member < 0 or not hdr_destination_member_has_default(r.slot, r.generation, member):
                    self.error_fatal("E-MIR-DESTINATION-STRUCT: missing required field at ordinal " + ordinal.to_text(), nil); return []
                values[ordinal] = self.mir_destination_lower_expr_row(r,
                    hdr_destination_member_default(r.slot, r.generation, member),
                    if hdr_destination_member_has_type(r.slot, r.generation, member):
                        Some(self.destination_checked_type(r,
                            hdr_destination_member_type(r.slot, r.generation, member),
                            "struct default field"))
                    else:
                        nil)
            operands.push(mir_operand_copy(values[ordinal])); ordinal = ordinal + 1
        operands

    me destination_asm_spec_match(r: MirDestinationFunctionReceipt,
            spec: i64) -> text:
        var archs: [text] = []
        val arch_start = hdr_aux_i64(r.slot, r.generation, spec, 0)
        val arch_count = hdr_aux_i64(r.slot, r.generation, spec, 1)
        var offset = 0
        while offset < arch_count:
            archs.push(hdr_aux_text(r.slot, r.generation, arch_start + offset, 0))
            offset = offset + 1
        val os_row = hdr_aux_i64(r.slot, r.generation, spec, 2)
        val abi_row = hdr_aux_i64(r.slot, r.generation, spec, 3)
        val backend_row = hdr_aux_i64(r.slot, r.generation, spec, 4)
        var version_ops: [text] = []
        var version_values: [i64] = []
        val versions = hdr_aux_range(r.slot, r.generation, spec)
        val version_subtype = hdr_range_subtype(r.slot, r.generation, versions)
        val version_count = hdr_range_length(r.slot, r.generation, versions)
        offset = 0
        while offset < version_count:
            val version = hdr_range_value(r.slot, r.generation, versions,
                version_subtype, offset)
            version_ops.push(hdr_aux_text(r.slot, r.generation, version, 0))
            version_values.push(hdr_aux_i64(r.slot, r.generation, version, 0))
            offset = offset + 1
        self.asm_target_spec_match_kind(archs,
            os_row >= 0, if os_row >= 0: hdr_aux_text(r.slot, r.generation, os_row, 0) else: "",
            abi_row >= 0, if abi_row >= 0: hdr_aux_text(r.slot, r.generation, abi_row, 0) else: "",
            backend_row >= 0, if backend_row >= 0: hdr_aux_text(r.slot, r.generation, backend_row, 0) else: "",
            version_ops, version_values,
            self.get_target_arch(), self.get_target_os(), self.get_target_abi(),
            self.get_target_backend(), self.get_target_backend_version())

    me lower_destination_inline_asm_match_row(r: MirDestinationFunctionReceipt,
            expr_row: i64, result_type: MirType) -> LocalId:
        val arms = hdr_expr_range(r.slot, r.generation, expr_row, false)
        val subtype = hdr_range_subtype(r.slot, r.generation, arms)
        val count = hdr_range_length(r.slot, r.generation, arms)
        var offset = 0
        while offset < count:
            val arm = hdr_range_value(r.slot, r.generation, arms, subtype, offset)
            var matched = hdr_aux_bool(r.slot, r.generation, arm, 1)
            var match_kind = "matched"
            if not matched and hdr_aux_bool(r.slot, r.generation, arm, 0):
                match_kind = self.destination_asm_spec_match(r,
                    hdr_aux_i64(r.slot, r.generation, arm, 0))
                if match_kind == "unknown_version":
                    self.error_fatal("E-MIR-DESTINATION-ASM-MATCH: target backend version is unavailable", nil)
                    return LocalId(id: -1)
                matched = match_kind == "matched" or match_kind == "note"
            if matched:
                if match_kind == "note":
                    self.error("note: target backend differs from recommended version", nil)
                if hdr_aux_i64(r.slot, r.generation, arm, 3) == 1:
                    self.error_fatal(hdr_aux_text(r.slot, r.generation, arm, 0), nil)
                    return LocalId(id: -1)
                if hdr_aux_i64(r.slot, r.generation, arm, 2) == 1:
                    return self.lower_destination_inline_asm_row(r,
                        hdr_aux_i64(r.slot, r.generation, arm, 1), result_type)
                self.error_fatal("E-MIR-DESTINATION-ASM-MATCH: selected arm has no body", nil)
                return LocalId(id: -1)
            offset = offset + 1
        self.error_fatal("E-MIR-DESTINATION-ASM-MATCH: no arm matches configured target", nil)
        LocalId(id: -1)

    me lower_destination_dict_row(r: MirDestinationFunctionReceipt,
            expr_row: i64, result_type: MirType) -> LocalId:
        val new_fn = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_dict_new"), MirType(kind: MirTypeKind.FuncPtr(
                MirSignature(params: [MirType.i64()], return_type: MirType.i64(),
                    is_variadic: false)))))
        var dict_builder = self.builder
        val created = dict_builder.emit_call(new_fn, [mir_operand_const_int(0)], MirType.i64())
        self.builder = dict_builder
        if not created.?:
            self.error_fatal("E-MIR-DESTINATION-DICT: runtime constructor returned no local", nil)
            return LocalId(id: -1)
        val dict_local = created ?? LocalId(id: -1)
        val entries = hdr_expr_range(r.slot, r.generation, expr_row, false)
        val subtype = hdr_range_subtype(r.slot, r.generation, entries)
        val count = hdr_range_length(r.slot, r.generation, entries)
        val set_fn = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_dict_set"), MirType(kind: MirTypeKind.FuncPtr(
                MirSignature(params: [MirType.i64(), MirType.i64(), MirType.i64()],
                    return_type: MirType.i64(), is_variadic: false)))))
        var offset = 0
        while offset < count:
            val entry = hdr_range_value(r.slot, r.generation, entries, subtype, offset)
            val key_raw = self.mir_destination_lower_expr_row(r,
                hdr_aux_i64(r.slot, r.generation, entry, 0), nil)
            val key = self.box_runtime_value(key_raw)
            val value_raw = self.mir_destination_lower_expr_row(r,
                hdr_aux_i64(r.slot, r.generation, entry, 1), nil)
            val value = self.box_runtime_value(value_raw)
            dict_builder = self.builder
            dict_builder.emit_call(set_fn, [mir_operand_copy(dict_local),
                mir_operand_copy(key), mir_operand_copy(value)], MirType.i64())
            self.builder = dict_builder
            offset = offset + 1
        dict_builder = self.builder
        val typed = dict_builder.new_temp(result_type)
        dict_builder.emit_copy(typed, dict_local)
        self.builder = dict_builder
        self.runtime_dict_locals[typed.id] = true
        self.mark_runtime_value_local(typed.id)
        typed

    me lower_destination_inline_asm_row(r: MirDestinationFunctionReceipt,
            asm_row: i64, result_type: MirType) -> LocalId:
        var inputs: [MirAsmOperand] = []
        var outputs: [MirAsmOperand] = []
        var output_destinations: [LocalId] = []
        var output_results: [LocalId] = []
        val constraints = hdr_aux_i64(r.slot, r.generation, asm_row, 0)
        val count = hdr_aux_i64(r.slot, r.generation, asm_row, 1)
        val subtype = hdr_range_subtype(r.slot, r.generation, constraints)
        var offset = 0
        while offset < count:
            val row = hdr_range_value(r.slot, r.generation, constraints, subtype, offset)
            val kind_shape = hdr_aux_i64(r.slot, r.generation, row, 0)
            val value = self.mir_destination_lower_expr_row(r,
                hdr_aux_i64(r.slot, r.generation, row, 2), nil)
            val operand = MirAsmOperand(name: hdr_aux_text(r.slot, r.generation, row, 0),
                kind: destination_complex_asm_kind(kind_shape),
                location: destination_complex_asm_location(
                    hdr_aux_i64(r.slot, r.generation, row, 1),
                    hdr_aux_text(r.slot, r.generation, row, 1)),
                operand: mir_operand_copy(value), constraint_index: offset)
            if kind_shape == 0 or kind_shape == 2: inputs.push(operand)
            if kind_shape != 0:
                var destination = value
                if hdr_aux_bool(r.slot, r.generation, row, 0):
                    destination = self.mir_destination_lower_expr_row(r,
                        hdr_aux_i64(r.slot, r.generation, row, 3), nil)
                var asm_builder = self.builder
                val output = asm_builder.new_temp(
                    self.local_mir_type_of(destination) ?? MirType.i64())
                self.builder = asm_builder
                outputs.push(MirAsmOperand(name: operand.name, kind: operand.kind,
                    location: operand.location, operand: mir_operand_copy(output),
                    constraint_index: offset))
                output_destinations.push(destination)
                output_results.push(output)
            offset = offset + 1
        var asm_builder = self.builder
        asm_builder.emit(MirInst(kind: MirInstKind.InlineAsm(
            asm_template: hdr_aux_text(r.slot, r.generation, asm_row, 0),
            is_volatile: hdr_aux_bool(r.slot, r.generation, asm_row, 0),
            inputs: inputs, outputs: outputs,
            clobbers: destination_complex_text_range(r,
                hdr_aux_i64(r.slot, r.generation, asm_row, 2)),
            clobber_abis: destination_complex_text_range(r,
                hdr_aux_i64(r.slot, r.generation, asm_row, 4)),
            options: destination_complex_text_range(r,
                hdr_aux_range(r.slot, r.generation, asm_row))),
            span: asm_builder.current_span))
        offset = 0
        while offset < output_destinations.len():
            asm_builder.emit_copy(output_destinations[offset], output_results[offset])
            offset = offset + 1
        val result = asm_builder.new_temp(result_type)
        asm_builder.emit_const(result, MirConstValue.Zero, result_type)
        self.builder = asm_builder
        result
