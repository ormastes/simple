# Real lexical bindings for a used complete parameter-default expression.
# The frame is scoped scratch. MirLowering remains the actual mutable owner.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
# HirConst is not pub/exported in hir_definitions.spl; the bare `.*` glob does
# not provide it under the Rust seed (self-hosted sibling visibility masked
# this). Import it explicitly (stage-2 seed regression, 4bec5687ee6).
use compiler.hir.hir_definitions.{HirConst}
use compiler.hir.hir_symbol_table_methods.*
use compiler.hir.hir_symbol_table_methods.{_hir_symbol_owner_module}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.*
use compiler.mir.hir_declaration_types_v1.{MirHirParamDeclarationV1, MirHirFunctionDeclarationV1,
    MirHirFieldDeclarationV1, MirHirNominalDeclarationV1, MirHirVariantDeclarationV1,
    MirHirEnumDeclarationV1, MirHirTraitDeclarationV1, MirHirGlobalDeclarationV1,
    MirHirDeclarationSourceV1, MirHirModuleDeclarationsV1, MirHirDeclarationRepositoryV1,
    MirHirCallableDefaultsV1}
use compiler.mir.hir_declaration_binding_contract_v1.{mir_hir_callable_record_binding_valid_v1}
use compiler.mir._MirLoweringExpr.lambda_abi.{lambda_abi_type_resolved}
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLowering.declaration_default_effects_v1.*
use compiler.mir.hir_declaration_codec_v1.{mir_hir_write_function_declaration_v1}
use compiler.mir.hir_declaration_summary_v1.{mir_hir_declaration_logical_key_v1,
    mir_hir_declarations_same_physical_source_v1}
use compiler.mir.hir_declaration_variant_identity_v1.{mir_hir_callable_variant_identity_v1,
    mir_hir_global_variant_identity_v1}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.provider_globals.*
use compiler.mir._MirLowering.declaration_providers_v1.*
use compiler.mir._MirLowering.declaration_default_rewrite_v1.*

class MirHirDefaultBindingFrameV1:
    provider: MirHirModuleDeclarationsV1
    links: Dict<i64, text>
    lexical_ids: Dict<i64, i64>
    declaration_ids: Dict<i64, i64>
    failed: bool

fn declaration_default_callable_records_v1(provider: MirHirModuleDeclarationsV1) -> [MirHirFunctionDeclarationV1]:
    var records: [MirHirFunctionDeclarationV1] = []
    for raw_function in provider.functions:
        val function: MirHirFunctionDeclarationV1 = raw_function
        records.push(function)
    for raw_trait in provider.traits:
        val trait_: MirHirTraitDeclarationV1 = raw_trait
        for raw_method in trait_.methods:
            val method: MirHirFunctionDeclarationV1 = raw_method
            records.push(method)
        for raw_method in trait_.defaults:
            val method: MirHirFunctionDeclarationV1 = raw_method
            records.push(method)
    records

fn declaration_default_callable_bytes_v1(function: MirHirFunctionDeclarationV1) -> text:
    var writer = HirCodecWriter.create()
    mir_hir_write_function_declaration_v1(writer, function)
    if not writer.ok: return ""
    writer.finish()

impl MirLowering:
    me declaration_default_fail_v1(frame: MirHirDefaultBindingFrameV1, message: text, span: Span):
        if not frame.failed: self.error_fatal(message, Some(span))
        frame.failed = true

    me remap_declaration_default_type_v1(type_: HirType, frame: MirHirDefaultBindingFrameV1) -> HirType:
        if type_ == nil: return type_
        self.relocate_provider_type(type_, frame.provider.symbols)

    me declaration_default_resolution_v1(resolution: MethodResolution,
            frame: MirHirDefaultBindingFrameV1, span: Span) -> MethodResolution:
        val mapped: MethodResolution = match resolution:
            case MethodResolution.InstanceMethod(type_id, method_id):
                MethodResolution.InstanceMethod(self.relocate_provider_type_symbol(type_id, frame.provider.symbols), self.declaration_default_reference_v1(method_id, frame))
            case MethodResolution.StaticMethod(type_id, method_id):
                MethodResolution.StaticMethod(self.relocate_provider_type_symbol(type_id, frame.provider.symbols), self.declaration_default_reference_v1(method_id, frame))
            case MethodResolution.TraitMethod(type_id, method_id):
                MethodResolution.TraitMethod(self.relocate_provider_type_symbol(type_id, frame.provider.symbols), self.declaration_default_reference_v1(method_id, frame))
            case MethodResolution.FreeFunction(method_id):
                MethodResolution.FreeFunction(self.declaration_default_reference_v1(method_id, frame))
            case MethodResolution.Unresolved | MethodResolution.BuiltinCollection(_): resolution
        var valid = true
        match mapped:
            case MethodResolution.InstanceMethod(type_id, method_id) | MethodResolution.StaticMethod(type_id, method_id) | MethodResolution.TraitMethod(type_id, method_id):
                valid = type_id.id >= 0 and method_id.id >= 0
            case MethodResolution.FreeFunction(method_id): valid = method_id.id >= 0
            case MethodResolution.Unresolved | MethodResolution.BuiltinCollection(_): ()
        if not valid: self.declaration_default_fail_v1(frame, "parameter default method resolution lost its canonical declaration", span)
        mapped

    me declaration_default_allocate_lexical_v1(source_id: SymbolId,
            frame: MirHirDefaultBindingFrameV1) -> SymbolId:
        if frame.lexical_ids.has(source_id.id): return SymbolId(id: frame.lexical_ids[source_id.id])
        if not frame.provider.symbols.symbols.has(source_id.id):
            self.declaration_default_fail_v1(frame, "parameter default lexical binder has no provider symbol", Span.empty())
            return SymbolId(id: -1)
        val source: HirSymbol = frame.provider.symbols.symbols[source_id.id]
        match source.kind:
            case SymbolKind.Variable | SymbolKind.Parameter: ()
            case _:
                self.declaration_default_fail_v1(frame, "parameter default binder is not a lexical declaration", source.span)
                return SymbolId(id: -1)
        var type_: HirType? = nil
        if val declared = source.type_:
            type_ = Some(self.remap_declaration_default_type_v1(declared, frame))
        # Allocation is through the real consumer SymbolTable counter. The
        # private spelling guarantees a new binding; no reserved numeric ID
        # range or guessed source identity is used.
        val expected_id = self.symbols.next_symbol_id
        val allocation_name = "__mir_default_{expected_id}_{source.name}"
        val target = self.symbols.define_with_binding(allocation_name, source.kind,
            type_, source.span, source.visibility, source.is_mutable,
            Some(self.current_module_id), false)
        # The real allocator may skip its registered structural-union IDs.
        if target.id < expected_id or not self.symbols.symbols.has(target.id):
            self.declaration_default_fail_v1(frame, "parameter default lexical allocation failed", source.span)
            return SymbolId(id: -1)
        var ids = frame.lexical_ids
        ids[source_id.id] = target.id
        frame.lexical_ids = ids
        target

    me declaration_default_bind_operand_v1(source: SymbolId, operand: MirOperand,
            frame: MirHirDefaultBindingFrameV1):
        val target = self.declaration_default_allocate_lexical_v1(source, frame)
        if target.id < 0: return
        val kind: MirOperandKind = operand.kind
        val local = match kind:
            case MirOperandKind.Copy(value) | MirOperandKind.Move(value): value
            case MirOperandKind.Const(value, type_):
                var builder = self.builder
                val materialized = builder.new_temp(type_)
                builder.emit_const(materialized, value, type_)
                self.builder = builder
                materialized
        # Keep the actual operand's scalar/tagged/closure provenance. Binding
        # does not reinterpret a raw word or overwrite its HIR metadata.
        self.bind_local(target.id, local)

    me declaration_default_bind_parameter_v1(param: MirHirParamDeclarationV1, operand: MirOperand,
            frame: MirHirDefaultBindingFrameV1):
        self.declaration_default_bind_operand_v1(param.symbol, operand, frame)
        if frame.failed: return
        val target_id = frame.lexical_ids[param.symbol.id]
        var target: HirSymbol = self.symbols.symbols[target_id]
        # HirParam is the callable signature's authority, including inferred
        # callable types and explicit mutability not duplicated in SymbolTable.
        target.type_ = Some(self.remap_declaration_default_type_v1(param.type_, frame))
        target.is_mutable = param.is_mutable
        self.symbols.symbols[target_id] = target

    me declaration_default_global_symbol_v1(source: HirSymbol,
            frame: MirHirDefaultBindingFrameV1) -> SymbolId:
        if self.declaration_repository == nil:
            self.declaration_default_fail_v1(frame, "parameter default global lacks admitted declarations", source.span)
            return SymbolId(id: -1)
        val repository: MirHirDeclarationRepositoryV1 = self.declaration_repository.unwrap()
        var source_owner = mir_layout_canonical_module_name(source.defining_module ?? "")
        if source_owner == "":
            # Older owned declarations can omit defining_module. Only an
            # actual retained local declaration with this exact symbol can
            # supply its owner; an imported alias without ownership cannot.
            for raw_global in frame.provider.globals:
                val declaration: MirHirGlobalDeclarationV1 = raw_global
                if declaration.symbol.id == source.id.id and declaration.name == source.name:
                    source_owner = mir_layout_canonical_module_name(frame.provider.name)
        if source_owner == "":
            self.declaration_default_fail_v1(frame, "parameter default global has no canonical provider owner", source.span)
            return SymbolId(id: -1)
        var selected_owner = ""
        var selected: MirHirGlobalDeclarationV1? = nil
        for name in repository.ordered_modules:
            val provider: MirHirModuleDeclarationsV1 = repository.modules[name]
            for raw_global in provider.globals:
                val declaration: MirHirGlobalDeclarationV1 = raw_global
                if declaration.name != source.name: continue
                if not provider.symbols.symbols.has(declaration.symbol.id): continue
                val definition: HirSymbol = provider.symbols.symbols[declaration.symbol.id]
                val owner = mir_layout_canonical_module_name(definition.defining_module ?? provider.name)
                if owner != source_owner: continue
                if selected != nil:
                    val previous_provider: MirHirModuleDeclarationsV1 = repository.modules[selected_owner]
                    val previous: MirHirGlobalDeclarationV1 = selected.unwrap()
                    val previous_bytes = mir_hir_global_variant_identity_v1(previous)
                    if mir_hir_declarations_same_physical_source_v1(previous_provider, provider) and
                            previous.symbol.id == declaration.symbol.id and previous_bytes != "" and
                            previous_bytes == mir_hir_global_variant_identity_v1(declaration): continue
                    self.declaration_default_fail_v1(frame, "parameter default global has conflicting provider declarations", source.span)
                    return SymbolId(id: -1)
                selected = Some(declaration)
                selected_owner = name
        if selected == nil:
            self.declaration_default_fail_v1(frame, "parameter default global provider declaration is missing", source.span)
            return SymbolId(id: -1)
        val declaration: MirHirGlobalDeclarationV1 = selected.unwrap()
        val provider: MirHirModuleDeclarationsV1 = repository.modules[selected_owner]
        val definition: HirSymbol = provider.symbols.symbols[declaration.symbol.id]
        val storage_name = mir_global_storage_name(definition.defining_module ?? provider.name, declaration.name)
        # Reuse an existing actual storage declaration rather than creating a
        # second export/provider with the same name.
        for raw_static in self.global_statics_by_id.values():
            val static_: MirStatic = raw_static
            if static_.name == storage_name:
                if not self.symbols.symbols.has(static_.symbol.id):
                    self.declaration_default_fail_v1(frame, "parameter default global storage symbol is absent", source.span)
                    return SymbolId(id: -1)
                return static_.symbol
        val type_ = self.relocate_provider_type(declaration.type_, provider.symbols)
        val target = self.symbols.define_with_binding(storage_name, source.kind, Some(type_),
            source.span, source.visibility, source.is_mutable, Some(source_owner), false)
        if val initializer = self.load_declaration_raw_expression_v1(selected_owner, declaration.initializer):
            val actual = HirConst(symbol: declaration.symbol, name: declaration.name,
                type_: declaration.type_, value: initializer, is_mutable: declaration.is_mutable,
                visibility: declaration.visibility, is_public: declaration.is_public,
                is_volatile: declaration.is_volatile, has_fixed_address: declaration.has_fixed_address,
                fixed_address: declaration.fixed_address, span: declaration.span)
            val key = mir_global_declaration_key(source_owner, declaration.name)
            val demanded: Dict<text, [i64]> = {key: [target.id]}
            val found = self.register_provider_global_bindings_with_initializer_policy_v1(
                provider.name, provider.symbols, [actual], demanded, {}, {}, provider.needs_initialization)
            if not found.has(key):
                self.declaration_default_fail_v1(frame, "parameter default global storage could not be bound", source.span)
                return SymbolId(id: -1)
            return target
        frame.failed = true
        SymbolId(id: -1)

    me declaration_default_callable_symbol_v1(source: HirSymbol,
            frame: MirHirDefaultBindingFrameV1) -> SymbolId:
        val owner = _hir_symbol_owner_module(source.defining_module ?? "")
        var providers: [MirHirModuleDeclarationsV1] = [frame.provider]
        if self.declaration_repository != nil:
            val repository: MirHirDeclarationRepositoryV1 = self.declaration_repository.unwrap()
            for name in repository.ordered_modules:
                if name != mir_hir_declaration_logical_key_v1(frame.provider): providers.push(repository.modules[name])
        var selected: [MirHirFunctionDeclarationV1] = []
        var selected_provider: MirHirModuleDeclarationsV1 = frame.provider
        var selected_bytes = ""
        for raw_provider in providers:
            val provider: MirHirModuleDeclarationsV1 = raw_provider
            for raw_function in declaration_default_callable_records_v1(provider):
                val function: MirHirFunctionDeclarationV1 = raw_function
                if not provider.symbols.symbols.has(function.symbol.id): continue
                val definition: HirSymbol = provider.symbols.symbols[function.symbol.id]
                val definition_owner = _hir_symbol_owner_module(definition.defining_module ?? provider.name)
                # A nil bootstrap predeclaration owner is proven ONLY by the
                # exact local function record and symbol in that same table.
                val exact_local = provider.name == frame.provider.name and function.symbol.id == source.id.id
                val exact_foreign = owner != "" and definition_owner == owner and definition.name == source.name
                if not exact_local and not exact_foreign: continue
                if exact_local and owner != "" and owner != definition_owner: continue
                if not mir_hir_callable_record_binding_valid_v1(provider, function) or (exact_local and (definition.name != source.name or definition.kind != source.kind)):
                    self.declaration_default_fail_v1(frame, "parameter default callable record does not match its retained symbol declaration", source.span)
                    return SymbolId(id: -1)
                val bytes = mir_hir_callable_variant_identity_v1(function)
                if bytes == "":
                    self.declaration_default_fail_v1(frame, "parameter default callable declaration codec refused", source.span)
                    return SymbolId(id: -1)
                if selected.len() > 0:
                    val same_record = mir_hir_declaration_logical_key_v1(selected_provider) == mir_hir_declaration_logical_key_v1(provider)
                    val same_source = mir_hir_declarations_same_physical_source_v1(selected_provider, provider)
                    if (same_record or same_source) and selected_provider.name == provider.name and
                            selected[0].symbol.id == function.symbol.id and selected_bytes == bytes: continue
                    self.declaration_default_fail_v1(frame, "parameter default callable has conflicting canonical declarations", source.span)
                    return SymbolId(id: -1)
                selected.push(function)
                selected_provider = provider
                selected_bytes = bytes
        if selected.len() != 1:
            self.declaration_default_fail_v1(frame, "parameter default callable lacks an exact provider declaration", source.span)
            return SymbolId(id: -1)
        val function: MirHirFunctionDeclarationV1 = selected[0]
        val definition: HirSymbol = selected_provider.symbols.symbols[function.symbol.id]
        var canonical_owner = _hir_symbol_owner_module(definition.defining_module ?? "")
        if canonical_owner == "": canonical_owner = _hir_symbol_owner_module(selected_provider.name)
        val key = mir_provider_callable_key(canonical_owner, definition.name)
        if not self.callable_link_names.has(key):
            # Trait interface records are declarations too. Publish their real
            # naming contract; this neither supplies nor fabricates a body.
            self.register_declaration_callable_variant_link_v1(selected_provider, function)
        if not self.callable_link_names.has(key):
            self.declaration_default_fail_v1(frame, "parameter default callable has no admitted emission identity", source.span)
            return SymbolId(id: -1)
        val link = self.callable_link_names[key]
        var target = SymbolId(id: self.symbols.lookup_qualified_function_raw(canonical_owner, link))
        if target.id < 0:
            target = self.symbols.define_with_binding(link, source.kind, nil, source.span,
                source.visibility, false, Some(canonical_owner), false)
            self.symbols.bind_qualified_function(canonical_owner, link, target)
        var params: [HirType] = []
        for raw_param in function.params:
            val param: MirHirParamDeclarationV1 = raw_param
            params.push(self.relocate_provider_type(param.type_, selected_provider.symbols))
        val signature = HirType(kind: HirTypeKind.Function(params,
            self.relocate_provider_type(function.return_type, selected_provider.symbols),
            self.relocate_provider_effects_v1(function.effects, selected_provider.symbols)), span: function.span)
        # Run the real recursive ABI/type diagnostic owner before publishing a
        # callable. Error advisories retain their policy; unresolved callback
        # slots still fail the existing resolved-ABI contract.
        val errors_before = self.errors.len()
        val physical_signature = self.lower_type(signature)
        if self.errors.len() != errors_before or not lambda_abi_type_resolved(signature) or not self.declaration_default_effect_types_valid_v1(signature):
            self.declaration_default_fail_v1(frame, "parameter default callable signature has no resolved physical ABI", function.span)
            return SymbolId(id: -1)
        var declaration: HirSymbol = self.symbols.symbols[target.id]
        declaration.type_ = Some(signature)
        declaration.builtin_method_tag = source.builtin_method_tag
        self.symbols.symbols[target.id] = declaration
        self.callable_link_names[mir_provider_callable_key(canonical_owner, link)] = link
        self.callable_text_value_abi[mir_provider_callable_key(canonical_owner, link)] = not function.is_extern
        target

    me declaration_default_reference_v1(source_id: SymbolId,
            frame: MirHirDefaultBindingFrameV1) -> SymbolId:
        if frame.lexical_ids.has(source_id.id): return SymbolId(id: frame.lexical_ids[source_id.id])
        if frame.declaration_ids.has(source_id.id): return SymbolId(id: frame.declaration_ids[source_id.id])
        if not frame.provider.symbols.symbols.has(source_id.id):
            self.declaration_default_fail_v1(frame, "parameter default reference lacks a provider symbol", Span.empty())
            return SymbolId(id: -1)
        val source: HirSymbol = frame.provider.symbols.symbols[source_id.id]
        var target = SymbolId(id: -1)
        match source.kind:
            case SymbolKind.Function | SymbolKind.Method:
                target = self.declaration_default_callable_symbol_v1(source, frame)
            case SymbolKind.Class | SymbolKind.Struct | SymbolKind.Enum | SymbolKind.Trait:
                target = self.relocate_provider_type_symbol(source_id, frame.provider.symbols)
            case SymbolKind.Const | SymbolKind.Variable:
                target = self.declaration_default_global_symbol_v1(source, frame)
            case _:
                self.declaration_default_fail_v1(frame, "parameter default reference is not a bound lexical or canonical declaration", source.span)
        if target.id < 0:
            self.declaration_default_fail_v1(frame, "parameter default canonical reference could not be relocated", source.span)
            return target
        var ids = frame.declaration_ids
        ids[source_id.id] = target.id
        frame.declaration_ids = ids
        target

    me declaration_default_frame_v1(provider: MirHirModuleDeclarationsV1,
            function: MirHirFunctionDeclarationV1, supplied: [MirOperand]) -> MirHirDefaultBindingFrameV1:
        val frame = MirHirDefaultBindingFrameV1(provider: provider,
            links: self.declaration_links_v1(provider), lexical_ids: {}, declaration_ids: {}, failed: false)
        if supplied.len() > function.params.len():
            self.declaration_default_fail_v1(frame, "parameter default supplied argument count exceeds declaration", function.span)
            return frame
        var index = 0
        while index < supplied.len():
            val param: MirHirParamDeclarationV1 = function.params[index]
            self.declaration_default_bind_parameter_v1(param, supplied[index], frame)
            index = index + 1
        frame
