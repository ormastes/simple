# Compile-level exact-release transaction for destination HIR.
#
# MIR lowering only installs a scalar lease.  The frozen graph remains READ
# while verification, optimization, and backend emission may still consult its
# scalar metadata.  The AOT driver commits this lease exactly once after the
# complete compile reports success.  A later failure deliberately leaves the
# graph readable, including its diagnostics.  No graph aggregate crosses this
# boundary and the terminal walk allocates no token list.
use compiler.hir.hir_lowering.items.{
    bootstrap_hir_module_count, bootstrap_hir_module_graph_mode,
    bootstrap_hir_module_graph_slot,
    bootstrap_hir_module_graph_generation, bootstrap_hir_module_graph_row,
    bootstrap_hir_module_graph_function_count,
    bootstrap_hir_module_graph_function_row
}
use compiler.hir.hir_lowering.hir_destination_registry.{
    hir_destination_registry_release_terminal
}
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir._MirLowering.hir_destination_validation.*

# Process-serialized compile lease.  Stage3 currently admits one destination
# graph per one-shot compiler process; reject overlap instead of replacing a
# pending owner and losing its diagnostic lifetime.
var _mir_destination_compile_lease_active: bool = false
var _mir_destination_compile_lease_slot: i64 = -1
var _mir_destination_compile_lease_generation: i64 = -1
var _mir_destination_compile_lease_module_count: i64 = 0
var _mir_destination_compile_lease_function_count: i64 = 0

fn mir_destination_module_receipts_supported(module_index: i64) -> bool:
    if not bootstrap_hir_module_graph_mode(module_index): return false
    val slot = bootstrap_hir_module_graph_slot(module_index)
    val generation = bootstrap_hir_module_graph_generation(module_index)
    val module_row = bootstrap_hir_module_graph_row(module_index)
    val count = bootstrap_hir_module_graph_function_count(module_index)
    if slot < 0 or generation < 0 or module_row < 0 or count < 0: return false
    var offset = 0
    while offset < count:
        val row = bootstrap_hir_module_graph_function_row(module_index, offset)
        val receipt = mir_destination_function_receipt(slot, generation,
            module_row, row)
        match receipt:
            case Some(active):
                if not mir_destination_function_graph_supported(active):
                    return false
            case _: return false
        offset = offset + 1
    true

fn mir_destination_compile_lease_begin() -> bool:
    if _mir_destination_compile_lease_active: return false
    val module_count = bootstrap_hir_module_count()
    if module_count <= 0: return false
    val slot = bootstrap_hir_module_graph_slot(0)
    val generation = bootstrap_hir_module_graph_generation(0)
    if slot < 0 or generation < 0: return false
    var module_index = 0
    var function_count = 0
    while module_index < module_count:
        if (bootstrap_hir_module_graph_slot(module_index) != slot or
            bootstrap_hir_module_graph_generation(module_index) != generation or
            not mir_destination_module_receipts_supported(module_index)):
            return false
        val module_function_count =
            bootstrap_hir_module_graph_function_count(module_index)
        if module_function_count < 0: return false
        val next_function_count = function_count + module_function_count
        if next_function_count < function_count: return false
        function_count = next_function_count
        module_index = module_index + 1
    _mir_destination_compile_lease_slot = slot
    _mir_destination_compile_lease_generation = generation
    _mir_destination_compile_lease_module_count = module_count
    _mir_destination_compile_lease_function_count = function_count
    _mir_destination_compile_lease_active = true
    true

fn mir_destination_compile_lease_pending() -> bool:
    _mir_destination_compile_lease_active

fn mir_destination_compile_lease_release_terminal_success() -> bool:
    # A second commit is not success: exact-once means a caller must present
    # the still-pending lease selected by `mir_destination_compile_lease_pending`.
    if not _mir_destination_compile_lease_active: return false
    val slot = _mir_destination_compile_lease_slot
    val generation = _mir_destination_compile_lease_generation
    val module_count = _mir_destination_compile_lease_module_count
    val function_count = _mir_destination_compile_lease_function_count
    if (slot < 0 or generation < 0 or module_count <= 0 or
        function_count < 0 or bootstrap_hir_module_count() != module_count):
        return false

    # Compile-wide preflight makes the serialized release walk infallible for
    # the retained generation and avoids an otherwise preventable partial
    # token commit.
    var module_index = 0
    while module_index < module_count:
        if (bootstrap_hir_module_graph_slot(module_index) != slot or
            bootstrap_hir_module_graph_generation(module_index) != generation or
            not mir_destination_module_receipts_supported(module_index)):
            return false
        module_index = module_index + 1

    if not hir_destination_registry_release_terminal(slot, generation,
            function_count):
        return false
    _mir_destination_compile_lease_active = false
    _mir_destination_compile_lease_slot = -1
    _mir_destination_compile_lease_generation = -1
    _mir_destination_compile_lease_module_count = 0
    _mir_destination_compile_lease_function_count = 0
    true

export mir_destination_module_receipts_supported
export mir_destination_compile_lease_begin
export mir_destination_compile_lease_pending
export mir_destination_compile_lease_release_terminal_success
