# Imported externs are proved by the resolved owner declaration, never the
# spelling or a provider-local numeric SymbolId.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.provider_metadata.{mir_provider_callable_key}

fn mir_imported_extern_consumers_v1(symbols: SymbolTable, owner: text) -> Dict<text, [HirSymbol]>:
    var consumers: Dict<text, [HirSymbol]> = {}
    for symbol in symbols.symbols.values():
        if symbol.kind != SymbolKind.Function or symbol.type_ == nil:
            continue
        val defining_owner = symbol.defining_module ?? ""
        if defining_owner == "" or mir_provider_callable_key(defining_owner, "") == mir_provider_callable_key(owner, ""):
            continue
        val key = mir_provider_callable_key(defining_owner, symbol.name)
        var matches: [HirSymbol] = if consumers.has(key): consumers[key] else: []
        matches.push(symbol)
        consumers[key] = matches
    consumers

fn mir_imported_extern_type_matches_v1(consumer: HirSymbol, declaration: HirFunction) -> bool:
    if consumer.type_ == nil:
        return false
    if val type_ = consumer.type_:
        match type_.kind:
            case HirTypeKind.Function(params, result, _):
                if params.len() != declaration.params.len() or not hir_types_equal(result, declaration.return_type):
                    return false
                for index in 0..params.len():
                    if not hir_types_equal(params[index], declaration.params[index].type_):
                        return false
                return true
            case _: false
    false

fn mir_imported_extern_owner_keys_v1(consumers: Dict<text, [HirSymbol]>) -> Dict<text, bool>:
    var owners: Dict<text, bool> = {}
    for matches in consumers.values():
        for symbol in matches:
            owners[mir_provider_callable_key(symbol.defining_module ?? "", "")] = true
    owners

impl MirLowering:
    me record_imported_exact_extern_modules_v1(owner: text, providers: [HirModule]):
        val consumers = mir_imported_extern_consumers_v1(self.symbols, owner)
        val owners = mir_imported_extern_owner_keys_v1(consumers)
        var visited: Dict<text, bool> = {}
        for provider in providers:
            if provider == nil:
                continue
            val provider_key = mir_provider_callable_key(provider.name, "")
            if not owners.has(provider_key):
                continue
            if visited.has(provider_key):
                self.error_fatal("ambiguous imported extern provider owner", nil)
                continue
            visited[provider_key] = true
            self.record_imported_exact_externs_v1(provider.name, provider.functions.values(), consumers)

    me record_imported_exact_externs_v1(owner: text, declarations: [HirFunction], consumers: Dict<text, [HirSymbol]>):
        for declaration in declarations:
            if not declaration.is_extern:
                continue
            val key = mir_provider_callable_key(owner, declaration.name)
            if not consumers.has(key):
                continue
            val imported_symbols: [HirSymbol] = consumers[key]
            for consumer in imported_symbols:
                if not mir_imported_extern_type_matches_v1(consumer, declaration):
                    continue
                var relocated = declaration
                relocated.symbol = consumer.id
                self.record_exact_extern_declaration_v1(relocated)
                if self.exact_extern_signatures.has(consumer.id.id):
                    # Only the proved extern declaration owns its physical C
                    # link name; aliases stay lookup keys in the caller table.
                    var links = self.callable_link_names
                    links[key] = declaration.name
                    self.callable_link_names = links

export mir_imported_extern_consumers_v1, mir_imported_extern_type_matches_v1, mir_imported_extern_owner_keys_v1
