# Scalar MIR read authority for one frozen destination-HIR function.
#
# This value contains indexes only. It never owns, embeds, or loans a HIR
# aggregate. The registry remains the canonical owner until every active
# function token has been lowered successfully and the module commit releases
# the tokens exactly once.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*

struct MirDestinationFunctionReceipt:
    slot: i64
    generation: i64
    module_index: i64
    function_row: i64
    token: i64
    root_block: i64

fn mir_destination_function_receipt(slot: i64, generation: i64,
        module_index: i64, function_row: i64) -> MirDestinationFunctionReceipt?:
    if slot < 0 or generation < 0 or module_index < 0 or function_row < 0:
        return nil
    val row_module = hdr_function_module(slot, generation, function_row)
    val token = hdr_function_token(slot, generation, function_row)
    val root = hdr_function_root(slot, generation, function_row)
    if row_module != module_index or token < 0 or root < 0:
        return nil
    if not hdr_token_active(slot, generation, token):
        return nil
    if hdr_token_root(slot, generation, token) != root:
        return nil
    if not hdr_block_ready(slot, generation, root):
        return nil
    MirDestinationFunctionReceipt(slot: slot, generation: generation,
        module_index: module_index, function_row: function_row, token: token,
        root_block: root)

fn mir_destination_receipt_still_active(r: MirDestinationFunctionReceipt) -> bool:
    hdr_function_module(r.slot, r.generation, r.function_row) == r.module_index and
        hdr_function_root(r.slot, r.generation, r.function_row) == r.root_block and
        hdr_function_token(r.slot, r.generation, r.function_row) == r.token and
        hdr_token_active(r.slot, r.generation, r.token) and
        hdr_token_root(r.slot, r.generation, r.token) == r.root_block

# Release is deliberately separate from lowering. A module driver calls it only
# after all functions have produced valid MIR. Any lowering failure therefore
# retains the frozen graph and diagnostics for postmortem inspection.
fn mir_destination_release_function_once(r: MirDestinationFunctionReceipt) -> bool:
    if not mir_destination_receipt_still_active(r):
        return false
    hdr_release_function(r.slot, r.generation, r.token)

export MirDestinationFunctionReceipt, mir_destination_function_receipt
export mir_destination_receipt_still_active, mir_destination_release_function_once
