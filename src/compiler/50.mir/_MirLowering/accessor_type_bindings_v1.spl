use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_accessor_type_bindings_v1.{AccessorTypeBindingV1, accessor_type_bindings_validate_v1}

impl MirLowering:
    me install_accessor_type_bindings_v1(bindings: [AccessorTypeBindingV1]) -> Result<bool, text>:
        val checked = accessor_type_bindings_validate_v1(bindings)?
        var next_symbol = self.next_canonical_type_symbol
        # Validate the whole reservation before changing either direction.
        for binding in bindings:
            val key = binding.canonical_key
            val raw_id = binding.physical_symbol.id
            if self.canonical_type_symbols.has(key):
                if self.canonical_type_symbols[key] != raw_id:
                    return Err("E-AOP-FIELD-TYPE: selected class was already minted with another physical ID")
            elif raw_id < self.next_canonical_type_symbol:
                return Err("E-AOP-FIELD-TYPE: selected reservation overlaps previously minted type IDs")
            if self.canonical_type_symbol_names.has(raw_id) and self.canonical_type_symbol_names[raw_id] != key:
                return Err("E-AOP-FIELD-TYPE: physical ID belongs to another canonical class")
            if self.symbols.symbols.has(raw_id):
                return Err("E-AOP-FIELD-TYPE: physical reservation overlaps a source symbol")
            if raw_id >= next_symbol: next_symbol = raw_id + 1
        for binding in bindings:
            self.canonical_type_symbols[binding.canonical_key] = binding.physical_symbol.id
            self.canonical_type_symbol_names[binding.physical_symbol.id] = binding.canonical_key
        self.next_canonical_type_symbol = next_symbol
        Ok(true)
