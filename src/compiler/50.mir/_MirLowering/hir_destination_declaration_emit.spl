# Frozen scalar declaration rows to the declaration surfaces MirModule can own.
# Every retained row is copied once from the frozen scalar reader into
# compile-owned MIR. No HIR aggregate or borrowed graph address crosses here.
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{SymbolId}
use compiler.hir.hir_destination_declaration_metadata.*
use compiler.hir.hir_lowering.hir_destination_declarations.{HD_DECL_ACTOR,
    HD_DECL_BITFIELD, HD_DECL_CONSTANT, HD_DECL_ENUM, HD_ENUM_PAYLOAD_NONE,
    HD_ENUM_PAYLOAD_TUPLE, HD_ENUM_PAYLOAD_STRUCT}
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{MirConstValue, MirConstant, MirStatic, MirType,
    MirTypeKind, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef,
    MirSignature, MirDeclarationField, MirExternDecl, MirActorDecl, MirBitfieldDecl,
    MirEnumExtensionConstructor, MirDeclarationAttribute,
    MirEnumExtensionDecl, MirDeclarationMetadataRow}
use compiler.mir._MirLowering.hir_destination_types.*

fn mir_destination_visibility(wire: i64) -> Visibility:
    if wire == 0: return Visibility.Public
    if wire == 1: return Visibility.Peer
    if wire == 2: return Visibility.Up
    if wire == 3: return Visibility.Internal
    if wire == 4: return Visibility.Package
    Visibility.Private

fn mir_destination_decl_const(slot: i64, generation: i64,
        expr_row: i64) -> MirConstValue?:
    val shape = hdr_expr_shape(slot, generation, expr_row)
    if shape == HD_EXPR_INT or shape == HD_EXPR_CHAR:
        return MirConstValue.Int(hdr_expr_i64(slot, generation, expr_row, 0))
    if shape == HD_EXPR_FLOAT:
        return MirConstValue.Float(hdr_float_value(slot, generation, expr_row))
    if shape == HD_EXPR_STRING:
        return MirConstValue.Str(hdr_expr_text(slot, generation, expr_row, 0))
    if shape == HD_EXPR_BOOL:
        return MirConstValue.Bool(hdr_expr_bool(slot, generation, expr_row, 0))
    if shape == HD_EXPR_UNIT or shape == HD_EXPR_NIL:
        return MirConstValue.Zero
    nil

fn mir_destination_decl_const_type(slot: i64, generation: i64,
        expr_row: i64) -> MirType?:
    val type_row = hdr_expr_type(slot, generation, expr_row)
    if type_row >= 0:
        return mir_destination_lower_type_scalar_checked(slot, generation, type_row)
    val shape = hdr_expr_shape(slot, generation, expr_row)
    if shape == HD_EXPR_BOOL: return Some(MirType(kind: MirTypeKind.Bool))
    if shape == HD_EXPR_FLOAT: return Some(MirType(kind: MirTypeKind.F64))
    if shape == HD_EXPR_STRING: return Some(MirType(kind: MirTypeKind.Opaque("str")))
    if shape == HD_EXPR_CHAR: return Some(MirType(kind: MirTypeKind.Char))
    if shape == HD_EXPR_UNIT: return Some(MirType(kind: MirTypeKind.Unit))
    if shape == HD_EXPR_INT: return Some(MirType(kind: MirTypeKind.I64))
    nil

fn mir_destination_module_name(slot: i64, generation: i64, row: i64) -> text:
    hdr_module_name(slot, generation, hdr_decl_i64(slot, generation, row, 1))

fn mir_destination_field(slot: i64, generation: i64, row: i64,
        ordinal: i64, bitfield: bool) -> MirDeclarationField?:
    val symbol = hdr_decl_field_i64(slot, generation, row, ordinal, 0)
    val type_row = hdr_decl_field_i64(slot, generation, row, ordinal, 1)
    val has_type = if bitfield:
        hdr_decl_field_bool(slot, generation, row, ordinal, 4)
    else: true
    if symbol < 0 or (has_type and type_row < 0): return nil
    val bit_width = if bitfield:
        hdr_decl_field_i64(slot, generation, row, ordinal, 3)
    elif hdr_decl_field_bool(slot, generation, row, ordinal, 2):
        hdr_decl_field_i64(slot, generation, row, ordinal, 3)
    else: 0
    if bit_width < 0: return nil
    val checked_type = if has_type:
        mir_destination_lower_type_scalar_checked(slot, generation, type_row)
    else:
        Some(MirType(kind: MirTypeKind.Bits(bit_width, false)))
    if not checked_type.?: return nil
    val type_ = checked_type ?? MirType.unit()
    val visibility_wire = if bitfield: 5 else:
        hdr_decl_field_i64(slot, generation, row, ordinal, 2)
    Some(MirDeclarationField(
        symbol: SymbolId(id: symbol),
        name: hdr_decl_field_name(slot, generation, row, ordinal),
        type_: type_, visibility: mir_destination_visibility(visibility_wire),
        is_public: if bitfield: false else:
            hdr_decl_field_bool(slot, generation, row, ordinal, 0),
        is_volatile: if bitfield: false else:
            hdr_decl_field_bool(slot, generation, row, ordinal, 1),
        has_bits_attr: if bitfield: true else:
            hdr_decl_field_bool(slot, generation, row, ordinal, 2),
        bits_width: bit_width,
        has_fixed_address: if bitfield: false else:
            hdr_decl_field_bool(slot, generation, row, ordinal, 3),
        fixed_address: if bitfield: 0 else:
            hdr_decl_field_i64(slot, generation, row, ordinal, 4),
        has_default: if bitfield: false else:
            hdr_decl_field_bool(slot, generation, row, ordinal, 4),
        default_expr_row: if bitfield: -1 else:
            hdr_decl_field_i64(slot, generation, row, ordinal, 5),
        bit_offset: if bitfield:
            hdr_decl_field_i64(slot, generation, row, ordinal, 2)
        else: 0,
        bit_width: bit_width,
        has_source_bits: bitfield and
            hdr_decl_field_bool(slot, generation, row, ordinal, 2),
        source_bits: if bitfield:
            hdr_decl_field_i64(slot, generation, row, ordinal, 4)
        else: 0,
        is_reserved: bitfield and
            hdr_decl_field_bool(slot, generation, row, ordinal, 5),
        span_row: hdr_decl_field_i64(slot, generation, row, ordinal, 6)))

fn mir_destination_metadata_type_slots(kind: i64) -> [i64]:
    if kind == HDDM_TRAIT_IMPL: return [0, 1]
    if kind == HDDM_TYPE_ALIAS or kind == HDDM_TRAIT_BOUND: return [0]
    if (kind == HDDM_TYPE_PARAM or kind == HDDM_ASSOC_DECL or
            kind == HDDM_ASSOC_IMPL): return [1]
    if kind == HDDM_FUNCTION_REF: return [4, 5]
    if kind == HDDM_TYPE_BINDING: return [1]
    if kind == HDDM_CLASS_DECL or kind == HDDM_STRUCT_DECL: return [4]
    []

fn mir_destination_metadata_type_range_slots(kind: i64) -> [i64]:
    if kind == HDDM_TRAIT_DECL: return [2]
    if (kind == HDDM_TYPE_PARAM or kind == HDDM_ASSOC_DECL or
            kind == HDDM_ASSOC_IMPL): return [0]
    if kind == HDDM_CLASS_DECL or kind == HDDM_STRUCT_DECL: return [5]
    []

fn mir_destination_attributes(slot: i64, generation: i64, start: i64,
        count: i64) -> [MirDeclarationAttribute]?:
    if count < 0 or (count > 0 and start < 0): return nil
    var result: [MirDeclarationAttribute] = []
    var offset = 0
    while offset < count:
        val row = start + offset
        val expr_count = hdr_decl_raw_attribute_i64(slot, generation, row, 4)
        if expr_count < 0: return nil
        var expr_rows: [i64] = []
        var expr_offset = 0
        while expr_offset < expr_count:
            val expr_row = hdr_decl_raw_attribute_expr(slot, generation, row,
                expr_offset)
            if expr_row < 0: return nil
            expr_rows.push(expr_row); expr_offset = expr_offset + 1
        result.push(MirDeclarationAttribute(
            name: hdr_decl_raw_attribute_text(slot, generation, row, 0),
            argument: hdr_decl_raw_attribute_text(slot, generation, row, 1),
            expr_rows: expr_rows,
            span_row: hdr_decl_raw_attribute_i64(slot, generation, row, 2)))
        offset = offset + 1
    Some(result)

impl MirLowering:
    me lower_destination_extern_decl(slot: i64, generation: i64,
            module_row: i64, function_row: i64) -> bool:
        val flags = hdr_function_flags(slot, generation, function_row)
        if (flags % (HD_FUNC_EXTERN * 2) < HD_FUNC_EXTERN or
                hdr_function_module(slot, generation, function_row) != module_row):
            return false
        val params_handle = hdr_function_params(slot, generation, function_row)
        val param_count = hdr_range_length(slot, generation, params_handle)
        val return_row = hdr_function_return_type(slot, generation, function_row)
        if param_count < 0 or return_row < 0: return false
        var params: [MirType] = []
        var ordinal = 0
        while ordinal < param_count:
            val aux = hdr_function_param(slot, generation, function_row, ordinal)
            val type_row = hdr_aux_i64(slot, generation, aux, 1)
            if aux < 0 or type_row < 0: return false
            val type_ = mir_destination_lower_type_scalar_checked(slot,
                generation, type_row)
            if not type_.?: return false
            params.push(type_ ?? MirType.unit())
            ordinal = ordinal + 1
        val symbol = SymbolId(id: hdr_function_symbol(slot, generation,
            function_row))
        val name = hdr_function_name(slot, generation, function_row)
        val module_name = hdr_module_name(slot, generation, module_row)
        var linkage_name = name
        var linkage_kind = "external"
        val metadata_handle = hdr_function_metadata(slot, generation,
            function_row)
        val metadata_count = if metadata_handle < 0: 0 else:
            hdr_range_length(slot, generation, metadata_handle)
        if metadata_count < 0: return false
        ordinal = 0
        while ordinal < metadata_count:
            val aux = hdr_function_metadata_row(slot, generation, function_row,
                ordinal)
            if hdr_aux_shape(slot, generation, aux) == HD_AUX_EXPORT_ATTR:
                val exported = hdr_aux_text(slot, generation, aux, 0)
                if exported != "": linkage_name = exported
                linkage_kind = "exported-external"
            ordinal = ordinal + 1
        var builder = self.builder; var module_ = builder.module
        var externs = module_.externs
        val checked_return = mir_destination_lower_type_scalar_checked(slot,
            generation, return_row)
        if not checked_return.?: return false
        externs[symbol] = MirExternDecl(symbol: symbol, name: name,
            defining_module: module_row, defining_module_name: module_name,
            overload_ordinal: hdr_function_overload_ordinal(slot, generation,
                function_row),
            signature: MirSignature(params: params,
                return_type: checked_return ?? MirType.unit(), is_variadic: false),
            linkage_name: linkage_name, linkage_kind: linkage_kind,
            visibility: mir_destination_visibility(hdr_function_visibility(slot,
                generation, function_row)),
            span_row: hdr_function_span(slot, generation, function_row))
        module_.externs = externs; builder.module = module_; self.builder = builder
        true

    me lower_destination_actor_decl(slot: i64, generation: i64,
            row: i64) -> bool:
        val count = hdr_decl_field_range_len(slot, generation, row)
        if count < 0: return false
        var fields: [MirDeclarationField] = []
        var ordinal = 0
        while ordinal < count:
            val field = mir_destination_field(slot, generation, row, ordinal, false)
            if not field.?: return false
            fields.push(field ?? MirDeclarationField(
                symbol: SymbolId(id: -1), name: "", type_: MirType.unit(),
                visibility: Visibility.Private, is_public: false,
                is_volatile: false, has_bits_attr: false, bits_width: 0,
                has_fixed_address: false, fixed_address: 0,
                has_default: false, default_expr_row: -1, bit_offset: 0,
                bit_width: 0, has_source_bits: false, source_bits: 0,
                is_reserved: false, span_row: -1))
            ordinal = ordinal + 1
        val has_message = hdr_decl_actor_bool(slot, generation, row, 0)
        val message_row = hdr_decl_actor_i64(slot, generation, row, 0)
        if has_message != (message_row >= 0): return false
        val symbol = SymbolId(id: hdr_decl_i64(slot, generation, row, 2))
        val message_type: MirType? = if has_message:
            mir_destination_lower_type_scalar_checked(slot, generation, message_row)
        else: nil
        if has_message and not message_type.?: return false
        val has_mailbox = hdr_decl_actor_bool(slot, generation, row, 1)
        val mailbox = hdr_decl_actor_i64(slot, generation, row, 1)
        if has_mailbox != (mailbox >= 0): return false
        var builder = self.builder; var module_ = builder.module
        var actors = module_.actors
        actors[symbol] = MirActorDecl(symbol: symbol,
            name: hdr_decl_name(slot, generation, row),
            defining_module: hdr_decl_i64(slot, generation, row, 1),
            defining_module_name: mir_destination_module_name(slot, generation, row),
            visibility: mir_destination_visibility(hdr_decl_i64(slot, generation, row, 3)),
            has_message_type: has_message, message_type: message_type,
            has_mailbox_capacity: has_mailbox, mailbox_capacity_expr_row: mailbox,
            fields: fields, span_row: hdr_decl_i64(slot, generation, row, 4))
        module_.actors = actors; builder.module = module_; self.builder = builder
        true

    me lower_destination_bitfield_decl(slot: i64, generation: i64,
            row: i64) -> bool:
        val storage_row = hdr_decl_bitfield_i64(slot, generation, row, 0)
        val storage_bits = hdr_decl_bitfield_i64(slot, generation, row, 1)
        val count = hdr_decl_field_range_len(slot, generation, row)
        if storage_row < 0 or storage_bits <= 0 or count < 0: return false
        var declaration_fields: [MirDeclarationField] = []
        var layout_fields: [MirFieldDef] = []
        var ordinal = 0
        while ordinal < count:
            val maybe_field = mir_destination_field(slot, generation, row,
                ordinal, true)
            if not maybe_field.?: return false
            val field = maybe_field ?? MirDeclarationField(
                symbol: SymbolId(id: -1), name: "", type_: MirType.unit(),
                visibility: Visibility.Private, is_public: false,
                is_volatile: false, has_bits_attr: false, bits_width: 0,
                has_fixed_address: false, fixed_address: 0,
                has_default: false, default_expr_row: -1, bit_offset: 0,
                bit_width: 0, has_source_bits: false, source_bits: 0,
                is_reserved: false, span_row: -1)
            if (field.bit_offset < 0 or field.bit_width <= 0 or
                    field.bit_offset + field.bit_width > storage_bits):
                return false
            declaration_fields.push(field)
            layout_fields.push(MirFieldDef(name: field.name, type_: field.type_,
                offset: field.bit_offset, has_bits_attr: true,
                bits_width: field.bit_width, symbol: field.symbol,
                visibility: field.visibility, is_public: field.is_public,
                is_volatile: false, has_fixed_address: false,
                fixed_address: 0, has_default: false, default_expr_row: -1,
                has_source_bits: field.has_source_bits,
                source_bits: field.source_bits, is_reserved: field.is_reserved,
                span_row: field.span_row))
            ordinal = ordinal + 1
        val symbol = SymbolId(id: hdr_decl_i64(slot, generation, row, 2))
        val module_id = hdr_decl_i64(slot, generation, row, 1)
        val module_name = mir_destination_module_name(slot, generation, row)
        val visibility = mir_destination_visibility(
            hdr_decl_i64(slot, generation, row, 3))
        var builder = self.builder; var module_ = builder.module
        var bitfields = module_.bitfields
        val checked_storage = mir_destination_lower_type_scalar_checked(slot,
            generation, storage_row)
        if not checked_storage.?: return false
        bitfields[symbol] = MirBitfieldDecl(symbol: symbol,
            name: hdr_decl_name(slot, generation, row),
            defining_module: module_id, defining_module_name: module_name,
            visibility: visibility,
            storage_type: checked_storage ?? MirType.unit(),
            storage_bits: storage_bits,
            fields: declaration_fields,
            span_row: hdr_decl_i64(slot, generation, row, 4))
        var types = module_.types
        types[symbol] = MirTypeDef(symbol: symbol,
            name: hdr_decl_name(slot, generation, row),
            kind: MirTypeDefKind.Struct(layout_fields), is_export_c: false,
            export_name: "", defining_module: module_id,
            defining_module_name: module_name, visibility: visibility,
            declaration_kind: HD_DECL_BITFIELD,
            declaration_fields: declaration_fields)
        module_.bitfields = bitfields; module_.types = types
        builder.module = module_; self.builder = builder
        true

    me lower_destination_enum_decl(slot: i64, generation: i64,
            row: i64) -> bool:
        val count = hdr_decl_enum_variant_range_len(slot, generation, row)
        if count < 0: return false
        var variants: [MirVariantDef] = []
        var ordinal = 0
        var next_discriminant = 0
        while ordinal < count:
            val payload_count = hdr_decl_enum_variant_i64(slot, generation,
                row, ordinal, 4)
            if payload_count < 0: return false
            val payload_kind = hdr_decl_enum_variant_i64(slot, generation,
                row, ordinal, 1)
            if payload_kind == HD_ENUM_PAYLOAD_NONE and payload_count != 0: return false
            if (payload_kind == HD_ENUM_PAYLOAD_TUPLE or
                    payload_kind == HD_ENUM_PAYLOAD_STRUCT) and payload_count <= 0:
                return false
            var payload_types: [MirType] = []
            var payload_names: [text] = []
            var payload_spans: [i64] = []
            var payload_ordinal = 0
            while payload_ordinal < payload_count:
                val type_row = hdr_decl_enum_payload_i64(slot, generation, row,
                    ordinal, payload_ordinal, 0)
                if type_row < 0: return false
                val payload_type = mir_destination_lower_type_scalar_checked(slot,
                    generation, type_row)
                if not payload_type.?: return false
                payload_types.push(payload_type ?? MirType.unit())
                val payload_name = hdr_decl_enum_payload_name(slot, generation,
                    row, ordinal, payload_ordinal)
                if payload_kind == HD_ENUM_PAYLOAD_TUPLE and payload_name != "": return false
                if payload_kind == HD_ENUM_PAYLOAD_STRUCT and payload_name == "": return false
                payload_names.push(payload_name)
                payload_spans.push(hdr_decl_enum_payload_i64(slot, generation,
                    row, ordinal, payload_ordinal, 1))
                payload_ordinal = payload_ordinal + 1
            val payload: MirType? = if payload_count == 0:
                nil
            else:
                MirType(kind: MirTypeKind.Tuple(payload_types))
            val has_discriminant = hdr_decl_enum_variant_has_discriminant(slot,
                generation, row, ordinal)
            val discriminant_expr = hdr_decl_enum_variant_i64(slot, generation,
                row, ordinal, 2)
            var discriminant = next_discriminant
            if has_discriminant:
                if discriminant_expr < 0: return false
                val folded = mir_destination_decl_const(slot, generation,
                    discriminant_expr)
                match folded:
                    case Some(MirConstValue.Int(value)): discriminant = value
                    case _: return false
            elif discriminant_expr != -1:
                return false
            val variant_attributes = mir_destination_attributes(slot, generation,
                hdr_decl_enum_variant_raw_attribute_range_start(slot, generation,
                    row, ordinal),
                hdr_decl_enum_variant_raw_attribute_range_count(slot, generation,
                    row, ordinal))
            if not variant_attributes.?: return false
            variants.push(MirVariantDef(name: hdr_decl_enum_variant_name(slot,
                generation, row, ordinal), discriminant: discriminant,
                payload: payload,
                symbol: SymbolId(id: hdr_decl_enum_variant_i64(slot, generation,
                    row, ordinal, 0)), payload_kind: payload_kind,
                has_discriminant: has_discriminant,
                discriminant_expr_row: discriminant_expr,
                payload_names: payload_names, payload_types: payload_types,
                payload_span_rows: payload_spans,
                attributes: variant_attributes ?? [],
                span_row: hdr_decl_enum_variant_i64(slot, generation,
                    row, ordinal, 5)))
            next_discriminant = discriminant + 1
            ordinal = ordinal + 1
        val symbol = SymbolId(id: hdr_decl_i64(slot, generation, row, 2))
        val enum_attributes = mir_destination_attributes(slot, generation,
            hdr_decl_enum_raw_attribute_range_start(slot, generation, row),
            hdr_decl_enum_raw_attribute_range_count(slot, generation, row))
        if not enum_attributes.?: return false
        var builder = self.builder; var module_ = builder.module
        var types = module_.types
        types[symbol] = MirTypeDef(symbol: symbol,
            name: hdr_decl_name(slot, generation, row),
            kind: MirTypeDefKind.Enum(variants), is_export_c: false,
            export_name: "", defining_module:
                hdr_decl_i64(slot, generation, row, 1),
            defining_module_name: mir_destination_module_name(slot, generation, row),
            visibility: mir_destination_visibility(hdr_decl_i64(slot, generation, row, 3)),
            declaration_kind: HD_DECL_ENUM,
            is_complete_open: hdr_decl_enum_bool(slot, generation, row, 0),
            is_dynamic_open: hdr_decl_enum_bool(slot, generation, row, 1),
            attributes: enum_attributes ?? [])
        module_.types = types; builder.module = module_; self.builder = builder
        true

    me lower_destination_constant_decl(slot: i64, generation: i64,
            row: i64) -> bool:
        val expr_row = hdr_decl_constant_i64(slot, generation, row, 1)
        if expr_row < 0: return false
        val folded = mir_destination_decl_const(slot, generation, expr_row)
        val has_type = hdr_decl_constant_bool(slot, generation, row, 0)
        if not folded.? and not has_type: return false
        val checked_type = if has_type:
            mir_destination_lower_type_scalar_checked(slot, generation,
                hdr_decl_constant_i64(slot, generation, row, 0))
        else: mir_destination_decl_const_type(slot, generation, expr_row)
        if not checked_type.?: return false
        val type_ = checked_type ?? MirType.unit()
        val symbol = SymbolId(id: hdr_decl_i64(slot, generation, row, 2))
        val name = hdr_decl_name(slot, generation, row)
        val module_name = hdr_module_name(slot, generation,
            hdr_decl_i64(slot, generation, row, 1))
        val owner_dots = module_name.replace(".", "_")
        val owner_slashes = owner_dots.replace("/", "_")
        val owner_safe = owner_slashes.replace("-", "_")
        val link_name = if owner_safe == "": name else: owner_safe + "__" + name
        var builder = self.builder; var module_ = builder.module
        val mutable_value = hdr_decl_constant_bool(slot, generation, row, 1)
        val volatile_value = hdr_decl_constant_bool(slot, generation, row, 2)
        val has_address = hdr_decl_constant_bool(slot, generation, row, 3)
        if mutable_value or volatile_value or has_address or not folded.?:
            val initializer: MirConstant? = match folded:
                case Some(value): Some(MirConstant(symbol: symbol,
                    name: link_name, type_: type_, value: value))
                case None: nil
            var statics = module_.statics
            statics[symbol] = MirStatic(symbol: symbol, name: link_name,
                type_: type_, init: initializer, is_mutable: mutable_value,
                alignment: type_.alignment(), visibility:
                    mir_destination_visibility(hdr_decl_i64(slot, generation, row, 3)),
                is_volatile: volatile_value,
                has_fixed_address: has_address,
                fixed_address: hdr_decl_constant_i64(slot, generation, row, 2),
                has_runtime_init: not folded.?,
                runtime_init_expr_row: if folded.?: -1 else: expr_row,
                defining_module: hdr_decl_i64(slot, generation, row, 1),
                defining_module_name: module_name)
            module_.statics = statics
        else:
            val value = folded ?? MirConstValue.Zero
            val constant = MirConstant(symbol: symbol, name: link_name,
                type_: type_, value: value)
            var constants = module_.constants; constants[symbol] = constant
            module_.constants = constants
        builder.module = module_; self.builder = builder
        true

    me lower_destination_extensions(slot: i64, generation: i64,
            module_row: i64) -> bool:
        val start = hdr_module_extension_start(slot, generation, module_row)
        val count = hdr_module_extension_count(slot, generation, module_row)
        if start < 0 or count < 0: return false
        var builder = self.builder; var module_ = builder.module
        var extensions = module_.enum_extensions
        var offset = 0
        while offset < count:
            val row = start + offset
            if hdr_decl_extension_i64(slot, generation, row, 0) != module_row:
                return false
            val variant_start = hdr_decl_extension_range(slot, generation,
                row, 0, false)
            val variant_count = hdr_decl_extension_range(slot, generation,
                row, 0, true)
            val constructor_count = hdr_decl_extension_range(slot, generation,
                row, 1, true)
            val attribute_count = hdr_decl_extension_range(slot, generation,
                row, 2, true)
            if (variant_start < 0 or variant_count < 0 or
                    constructor_count < 0 or attribute_count < 0):
                return false
            var variants: [MirVariantDef] = []
            var variant_ordinal = 0
            while variant_ordinal < variant_count:
                val payload_kind = hdr_decl_extension_variant_i64(slot,
                    generation, row, variant_ordinal, 1)
                val payload_count = hdr_decl_extension_variant_i64(slot,
                    generation, row, variant_ordinal, 5)
                if (payload_count < 0 or payload_kind < HD_ENUM_PAYLOAD_NONE or
                        payload_kind > HD_ENUM_PAYLOAD_STRUCT):
                    return false
                if payload_kind == HD_ENUM_PAYLOAD_NONE and payload_count != 0:
                    return false
                if (payload_kind == HD_ENUM_PAYLOAD_TUPLE or
                        payload_kind == HD_ENUM_PAYLOAD_STRUCT) and payload_count <= 0:
                    return false
                var payload_names: [text] = []
                var payload_types: [MirType] = []
                var payload_spans: [i64] = []
                var payload_ordinal = 0
                while payload_ordinal < payload_count:
                    val type_row = hdr_decl_extension_variant_payload_i64(slot,
                        generation, row, variant_ordinal, payload_ordinal, 0)
                    val type_ = mir_destination_lower_type_scalar_checked(slot,
                        generation, type_row)
                    if not type_.?: return false
                    val payload_name = hdr_decl_extension_variant_payload_name(
                        slot, generation, row, variant_ordinal, payload_ordinal)
                    if payload_kind == HD_ENUM_PAYLOAD_TUPLE and payload_name != "":
                        return false
                    if payload_kind == HD_ENUM_PAYLOAD_STRUCT and payload_name == "":
                        return false
                    payload_names.push(payload_name)
                    payload_types.push(type_ ?? MirType.unit())
                    payload_spans.push(hdr_decl_extension_variant_payload_i64(
                        slot, generation, row, variant_ordinal,
                        payload_ordinal, 1))
                    payload_ordinal = payload_ordinal + 1
                val has_discriminant = hdr_decl_extension_variant_has_discriminant(
                    slot, generation, row, variant_ordinal)
                val expr_row = hdr_decl_extension_variant_i64(slot, generation,
                    row, variant_ordinal, 2)
                var resolved = false
                var discriminant = 0
                if has_discriminant:
                    val folded = mir_destination_decl_const(slot, generation,
                        expr_row)
                    match folded:
                        case Some(MirConstValue.Int(value)):
                            discriminant = value; resolved = true
                        case _: return false
                elif expr_row != -1:
                    return false
                val payload: MirType? = if payload_count == 0: nil else:
                    Some(MirType(kind: MirTypeKind.Tuple(payload_types)))
                variants.push(MirVariantDef(
                    name: hdr_decl_extension_variant_name(slot, generation,
                        row, variant_ordinal), discriminant: discriminant,
                    payload: payload,
                    symbol: SymbolId(id: hdr_decl_extension_variant_i64(slot,
                        generation, row, variant_ordinal, 0)),
                    payload_kind: payload_kind,
                    has_discriminant: has_discriminant,
                    has_resolved_discriminant: resolved,
                    discriminant_expr_row: expr_row,
                    payload_names: payload_names, payload_types: payload_types,
                    payload_span_rows: payload_spans, attributes: [],
                    span_row: hdr_decl_extension_variant_i64(slot, generation,
                        row, variant_ordinal, 3)))
                variant_ordinal = variant_ordinal + 1
            var constructors: [MirEnumExtensionConstructor] = []
            var constructor_ordinal = 0
            while constructor_ordinal < constructor_count:
                val variant_row = hdr_decl_extension_constructor_i64(slot,
                    generation, row, constructor_ordinal, 0)
                val relative_variant = variant_row - variant_start
                if relative_variant < 0 or relative_variant >= variant_count:
                    return false
                val variant = variants[relative_variant]
                val payload_kind = hdr_decl_extension_constructor_i64(slot,
                    generation, row, constructor_ordinal, 6)
                val has_discriminant =
                    hdr_decl_extension_constructor_has_discriminant(slot,
                        generation, row, constructor_ordinal)
                val discriminant_expr = hdr_decl_extension_constructor_i64(slot,
                    generation, row, constructor_ordinal, 7)
                val payload_count = hdr_decl_extension_constructor_i64(slot,
                    generation, row, constructor_ordinal, 4)
                if (payload_kind != variant.payload_kind or
                        has_discriminant != variant.has_discriminant or
                        discriminant_expr != variant.discriminant_expr_row or
                        payload_count != variant.payload_types.len()):
                    return false
                var constructor_names: [text] = []
                var constructor_types: [MirType] = []
                var constructor_spans: [i64] = []
                var payload_ordinal = 0
                while payload_ordinal < payload_count:
                    val type_row = hdr_decl_extension_payload_i64(slot,
                        generation, row, constructor_ordinal,
                        payload_ordinal, 0)
                    val variant_type_row =
                        hdr_decl_extension_variant_payload_i64(slot, generation,
                            row, relative_variant, payload_ordinal, 0)
                    val payload_name = hdr_decl_extension_payload_name(slot,
                        generation, row, constructor_ordinal, payload_ordinal)
                    val variant_name = hdr_decl_extension_variant_payload_name(
                        slot, generation, row, relative_variant, payload_ordinal)
                    if type_row != variant_type_row or payload_name != variant_name:
                        return false
                    val type_ = mir_destination_lower_type_scalar_checked(slot,
                        generation, type_row)
                    if not type_.?: return false
                    constructor_names.push(payload_name)
                    constructor_types.push(type_ ?? MirType.unit())
                    constructor_spans.push(hdr_decl_extension_payload_i64(slot,
                        generation, row, constructor_ordinal,
                        payload_ordinal, 1))
                    payload_ordinal = payload_ordinal + 1
                constructors.push(MirEnumExtensionConstructor(
                    symbol: SymbolId(id: hdr_decl_extension_constructor_i64(slot,
                        generation, row, constructor_ordinal, 1)),
                    name: hdr_decl_extension_constructor_text(slot, generation,
                        row, constructor_ordinal, 1),
                    provider: hdr_decl_extension_constructor_text(slot,
                        generation, row, constructor_ordinal, 0),
                    function_symbol: SymbolId(id:
                        hdr_decl_extension_constructor_i64(slot, generation,
                            row, constructor_ordinal, 2)),
                    variant_row: variant_row, payload_kind: payload_kind,
                    has_discriminant: has_discriminant,
                    discriminant_expr_row: discriminant_expr,
                    payload_names: constructor_names,
                    payload_types: constructor_types,
                    payload_span_rows: constructor_spans,
                    span_row: hdr_decl_extension_constructor_i64(slot,
                        generation, row, constructor_ordinal, 5)))
                constructor_ordinal = constructor_ordinal + 1
            var attributes: [MirDeclarationAttribute] = []
            var attribute_ordinal = 0
            while attribute_ordinal < attribute_count:
                val expr_count = hdr_decl_extension_attribute_i64(slot,
                    generation, row, attribute_ordinal, 1)
                if expr_count < 0: return false
                var expr_rows: [i64] = []
                var expr_ordinal = 0
                while expr_ordinal < expr_count:
                    val expr_row = hdr_decl_extension_attribute_expr(slot,
                        generation, row, attribute_ordinal, expr_ordinal)
                    if expr_row < 0: return false
                    expr_rows.push(expr_row); expr_ordinal = expr_ordinal + 1
                attributes.push(MirDeclarationAttribute(
                    name: hdr_decl_extension_attribute_text(slot, generation,
                        row, attribute_ordinal, 0),
                    argument: hdr_decl_extension_attribute_text(slot, generation,
                        row, attribute_ordinal, 1), expr_rows: expr_rows,
                    span_row: hdr_decl_extension_attribute_span(slot,
                        generation, row, attribute_ordinal)))
                attribute_ordinal = attribute_ordinal + 1
            extensions.push(MirEnumExtensionDecl(
                defining_module: module_row,
                target_module: hdr_decl_extension_i64(slot, generation, row, 1),
                target_symbol: SymbolId(id: hdr_decl_extension_i64(slot,
                    generation, row, 2)),
                target_name: hdr_decl_extension_text(slot, generation, row, 0),
                closure_kind: hdr_decl_extension_i64(slot, generation, row, 3),
                closure_name: hdr_decl_extension_text(slot, generation, row, 1),
                source_ordinal: hdr_decl_extension_i64(slot, generation, row, 5),
                variants: variants, constructors: constructors,
                attributes: attributes,
                span_row: hdr_decl_extension_i64(slot, generation, row, 4)))
            offset = offset + 1
        module_.enum_extensions = extensions
        builder.module = module_; self.builder = builder
        true

    me lower_destination_metadata(slot: i64, generation: i64,
            module_row: i64) -> bool:
        val total = hdr_declaration_metadata_count(slot, generation)
        if total < 0: return false
        var builder = self.builder; var module_ = builder.module
        var rows = module_.declaration_metadata
        var kind = HDDM_TRAIT_DECL
        while kind <= HDDM_NOMINAL_ATTRIBUTE:
            val range_row = hdr_declaration_metadata_module_range(slot,
                generation, module_row, kind)
            if range_row >= 0:
                val start = hdr_declaration_metadata_range_start(slot,
                    generation, range_row)
                val count = hdr_declaration_metadata_range_len(slot,
                    generation, range_row)
                if start < 0 or count < 0: return false
                var offset = 0
                while offset < count:
                    val row = start + offset
                    if (row < 0 or row >= total or
                            hdr_declaration_metadata_kind(slot, generation,
                                row) != kind or
                            hdr_declaration_metadata_module(slot, generation,
                                row) != module_row):
                        return false
                    var resolved_type_slots: [i64] = []
                    var resolved_types: [MirType] = []
                    val type_slots = mir_destination_metadata_type_slots(kind)
                    for slot_index in type_slots:
                        val type_row = hdr_declaration_metadata_i64(slot,
                            generation, row, slot_index)
                        if type_row >= 0:
                            val type_ = mir_destination_lower_type_scalar_checked(
                                slot, generation, type_row)
                            if not type_.?: return false
                            resolved_type_slots.push(slot_index)
                            resolved_types.push(type_ ?? MirType.unit())
                    var resolved_range_slots: [i64] = []
                    var resolved_range_starts: [i64] = []
                    var resolved_range_counts: [i64] = []
                    var resolved_range_types: [MirType] = []
                    val range_slots = mir_destination_metadata_type_range_slots(kind)
                    for slot_index in range_slots:
                        val handle = hdr_declaration_metadata_i64(slot,
                            generation, row, slot_index)
                        if handle >= 0:
                            if hdr_range_kind(slot, generation, handle) != HD_RANGE_TYPE:
                                return false
                            val subtype = hdr_range_subtype(slot, generation, handle)
                            val type_count = hdr_range_length(slot, generation,
                                handle)
                            if type_count < 0: return false
                            resolved_range_slots.push(slot_index)
                            resolved_range_starts.push(resolved_range_types.len())
                            resolved_range_counts.push(type_count)
                            var type_offset = 0
                            while type_offset < type_count:
                                val type_row = hdr_range_value(slot, generation,
                                    handle, subtype, type_offset)
                                val type_ = mir_destination_lower_type_scalar_checked(
                                    slot, generation, type_row)
                                if not type_.?: return false
                                resolved_range_types.push(type_ ?? MirType.unit())
                                type_offset = type_offset + 1
                    rows.push(MirDeclarationMetadataRow(kind: kind,
                        defining_module: module_row,
                        owner_symbol: hdr_declaration_metadata_owner(slot,
                            generation, row),
                        name: hdr_declaration_metadata_name(slot, generation, row),
                        text0: hdr_declaration_metadata_text(slot, generation,
                            row, 0),
                        text1: hdr_declaration_metadata_text(slot, generation,
                            row, 1),
                        flag0: hdr_declaration_metadata_bool(slot, generation,
                            row, 0),
                        flag1: hdr_declaration_metadata_bool(slot, generation,
                            row, 1),
                        flag2: hdr_declaration_metadata_bool(slot, generation,
                            row, 2),
                        value0: hdr_declaration_metadata_i64(slot, generation,
                            row, 0),
                        value1: hdr_declaration_metadata_i64(slot, generation,
                            row, 1),
                        value2: hdr_declaration_metadata_i64(slot, generation,
                            row, 2),
                        value3: hdr_declaration_metadata_i64(slot, generation,
                            row, 3),
                        value4: hdr_declaration_metadata_i64(slot, generation,
                            row, 4),
                        value5: hdr_declaration_metadata_i64(slot, generation,
                            row, 5),
                        child_range_kind: 0,
                        child_range_start: -1,
                        child_range_len: 0,
                        span_row: hdr_declaration_metadata_span(slot,
                            generation, row),
                        resolved_type_slots: resolved_type_slots,
                        resolved_types: resolved_types,
                        resolved_range_slots: resolved_range_slots,
                        resolved_range_starts: resolved_range_starts,
                        resolved_range_counts: resolved_range_counts,
                        resolved_range_types: resolved_range_types))
                    offset = offset + 1
            kind = kind + 1
        module_.declaration_metadata = rows
        builder.module = module_; self.builder = builder
        true

    me lower_destination_declarations(slot: i64, generation: i64,
            module_row: i64) -> bool:
        val start = hdr_module_declaration_start(slot, generation, module_row)
        val count = hdr_module_declaration_count(slot, generation, module_row)
        if start < 0 or count < 0: return false
        var offset = 0
        while offset < count:
            val row = start + offset
            if hdr_decl_i64(slot, generation, row, 1) != module_row: return false
            val kind = hdr_decl_i64(slot, generation, row, 0)
            var ok = false
            if kind == HD_DECL_ACTOR:
                ok = self.lower_destination_actor_decl(slot, generation, row)
            elif kind == HD_DECL_BITFIELD:
                ok = self.lower_destination_bitfield_decl(slot, generation, row)
            elif kind == HD_DECL_ENUM:
                ok = self.lower_destination_enum_decl(slot, generation, row)
            elif kind == HD_DECL_CONSTANT:
                ok = self.lower_destination_constant_decl(slot, generation, row)
            if not ok: return false
            offset = offset + 1
        self.lower_destination_nominal_details(slot, generation, module_row) and
            self.lower_destination_extensions(slot, generation, module_row) and
            self.lower_destination_metadata(slot, generation, module_row)
export mir_destination_visibility, mir_destination_decl_const
