# Verified declaration contracts are projected onto exact emitted MIR symbols.
# No basename lookup, imported summary, or unchecked inference is authoritative.
use compiler.hir.hir_types.{HirModule, HirSymbol, SymbolId}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.hir.hir_symbol_table_methods.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_instructions.{MirFunction}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.declaration_providers_v1.*
use compiler.mir._MirLowering.module_lowering.{mir_layout_canonical_module_name}
use compiler.mir._MirLowering.asm_and_targets.*

impl MirLowering:
    me publish_short_call_contracts(module: HirModule):
        var contracts: Dict<text, [text]> = {}
        var output = self.builder.module
        var functions = output.functions
        var emitted_name_counts: Dict<text, i64> = {}
        for emitted in functions.values():
            val name = emitted.name
            emitted_name_counts[name] = if emitted_name_counts.has(name): emitted_name_counts[name] + 1 else: 1
        if module.nogc_strict:
            if not module.nogc_param_effects_checked or module.nogc_param_effect_symbol_ids.len() != module.nogc_param_effects.len():
                self.error_fatal("NOGC-POLICY-002: strict MIR module has no verified parameter-effect rows", nil)
            else:
                var seen: Dict<i64, bool> = {}
                var duplicate: Dict<i64, bool> = {}
                for id in module.nogc_param_effect_symbol_ids:
                    if seen.has(id): duplicate[id] = true
                    seen[id] = true
                var row = 0
                while row < module.nogc_param_effect_symbol_ids.len():
                    val id = module.nogc_param_effect_symbol_ids[row]
                    val symbol = SymbolId(id: id)
                    if not duplicate.has(id) and module.functions.has(symbol) and functions.has(symbol):
                        val declaration: HirFunction = module.functions[symbol]
                        val emitted: MirFunction = functions[symbol]
                        val effects: [text] = module.nogc_param_effects[row]
                        var owner = self.current_module_id
                        var local_declaration = false
                        val maybe_symbol: HirSymbol? = module.symbols.get_symbol_raw(id)
                        if val present = maybe_symbol:
                            val declared_owner = present.defining_module ?? ""
                            if declared_owner != "":
                                owner = declared_owner
                                local_declaration = mir_layout_canonical_module_name(owner) == self.current_module_id
                        val fallback = mir_provider_function_name(owner, module.symbols, declaration, self.lowering_entry_module)
                        val expected = if declaration.has_export_attr: fallback else: self.provider_callable_symbol_name(symbol, fallback)
                        var valid = local_declaration and not declaration.is_extern and not declaration.is_generic_template and effects.len() == declaration.params.len()
                        for effect in effects:
                            if effect != "read-short" and effect != "mutate-short" and effect != "consume" and effect != "share-explicit": valid = false
                        if valid and emitted.symbol.id == id and emitted.name == expected and emitted_name_counts[expected] == 1:
                            contracts[expected] = effects
                    row = row + 1
        # Explicit owner writeback: every body carries this consumer's strict
        # policy and the same checked local-call map, regardless of iteration order.
        for key in functions.keys():
            var function: MirFunction = functions[key]
            function.nogc_strict = module.nogc_strict
            function.short_call_contracts = contracts
            functions[key] = function
        output.functions = functions
        var builder = self.builder
        builder.module = output
        self.builder = builder
        self.short_call_contracts = contracts
