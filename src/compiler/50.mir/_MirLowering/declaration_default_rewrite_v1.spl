# Complete structural parameter-default remapping. No consumer-local source IDs.
# Traversal starts from the actual HIR node records, not serialized text.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
# HirConst is not pub/exported in hir_definitions.spl; the bare `.*` glob does
# not provide it under the Rust seed (self-hosted sibling visibility masked
# this). Import it explicitly (stage-2 seed regression, 4bec5687ee6).
use compiler.hir.hir_definitions.{HirConst}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.provider_metadata.*
use compiler.mir._MirLowering.declaration_default_bindings_v1.*

impl MirLowering:
    me remap_declaration_default_type_opt_v1(ty: HirType?, frame: MirHirDefaultBindingFrameV1) -> HirType?:
        """Remap inside an optional type annotation."""
        match ty:
            Some(t):
                val tt: HirType = t
                self.remap_declaration_default_type_v1(tt, frame)
            nil:
                nil


    me remap_declaration_default_expr_opt_v1(expr: HirExpr?, frame: MirHirDefaultBindingFrameV1) -> HirExpr?:
        """Remap inside an optional sub-expression."""
        match expr:
            Some(e):
                val et: HirExpr = e
                self.remap_declaration_default_expr_v1(et, frame)
            nil:
                nil


    me remap_declaration_default_block_opt_v1(block: HirBlock?, frame: MirHirDefaultBindingFrameV1) -> HirBlock?:
        """Remap inside an optional block."""
        match block:
            Some(b):
                val bt: HirBlock = b
                self.remap_declaration_default_block_v1(bt, frame)
            nil:
                nil


    me remap_declaration_default_exprs_v1(exprs: [HirExpr], frame: MirHirDefaultBindingFrameV1) -> [HirExpr]:
        var out: [HirExpr] = []
        for e in exprs:
            val et: HirExpr = e
            out = out.push(self.remap_declaration_default_expr_v1(et, frame))
        out


    me remap_declaration_default_call_args_v1(args: [HirCallArg], frame: MirHirDefaultBindingFrameV1) -> [HirCallArg]:
        var out: [HirCallArg] = []
        for a in args:
            val at: HirCallArg = a
            var na = at
            na.value = self.remap_declaration_default_expr_v1(at.value, frame)
            out = out.push(na)
        out


    me remap_declaration_default_named_exprs_v1(fields: [(text, HirExpr)], frame: MirHirDefaultBindingFrameV1) -> [(text, HirExpr)]:
        var out: [(text, HirExpr)] = []
        for f in fields:
            val (fname, fexpr) = f
            val fe: HirExpr = fexpr
            out = out.push((fname, self.remap_declaration_default_expr_v1(fe, frame)))
        out


    me remap_declaration_default_enum_payload_v1(payload: HirEnumPayload?, frame: MirHirDefaultBindingFrameV1) -> HirEnumPayload?:
        match payload:
            Some(p):
                match p:
                    case Tuple(values):
                        HirEnumPayload.Tuple(self.remap_declaration_default_exprs_v1(values, frame))
                    case Struct(fields):
                        HirEnumPayload.Struct(self.remap_declaration_default_named_exprs_v1(fields, frame))
            nil:
                nil


    me remap_declaration_default_patterns_v1(patterns: [HirPattern], frame: MirHirDefaultBindingFrameV1) -> [HirPattern]:
        var out: [HirPattern] = []
        for p in patterns:
            val pt: HirPattern = p
            out = out.push(self.remap_declaration_default_pattern_v1(pt, frame))
        out


    me remap_declaration_default_named_patterns_v1(fields: [(text, HirPattern)], frame: MirHirDefaultBindingFrameV1) -> [(text, HirPattern)]:
        var out: [(text, HirPattern)] = []
        for f in fields:
            val (fname, fpat) = f
            val fp: HirPattern = fpat
            out = out.push((fname, self.remap_declaration_default_pattern_v1(fp, frame)))
        out


    me remap_declaration_default_pattern_payload_v1(payload: HirPatternPayload?, frame: MirHirDefaultBindingFrameV1) -> HirPatternPayload?:
        match payload:
            Some(p):
                match p:
                    case Tuple(patterns):
                        HirPatternPayload.Tuple(self.remap_declaration_default_patterns_v1(patterns, frame))
                    case Struct(fields):
                        HirPatternPayload.Struct(self.remap_declaration_default_named_patterns_v1(fields, frame))
            nil:
                nil


    me remap_declaration_default_pattern_v1(pattern: HirPattern, frame: MirHirDefaultBindingFrameV1) -> HirPattern:
        """Remap type parameters inside a pattern and its sub-patterns.

        A pattern carries its own `type_` (gated by `has_type_`) and, for the
        Struct/Enum forms, a scrutinee type written in the source - all three can
        name a type parameter."""
        if pattern == nil:
            return pattern
        var out = pattern
        if pattern.has_type_:
            out.type_ = self.remap_declaration_default_type_v1(pattern.type_, frame)
        match pattern.kind:
            case HirPatternKind.Binding(symbol, mutable):
                out.kind = HirPatternKind.Binding(self.declaration_default_allocate_lexical_v1(symbol, frame), mutable)
            case HirPatternKind.Literal(value):
                val vt: HirExpr = value
                out.kind = HirPatternKind.Literal(self.remap_declaration_default_expr_v1(vt, frame))
            case HirPatternKind.Tuple(elements):
                out.kind = HirPatternKind.Tuple(self.remap_declaration_default_patterns_v1(elements, frame))
            case HirPatternKind.Array(elements, rest):
                var mapped_rest: SymbolId? = nil
                if val binder = rest:
                    mapped_rest = Some(self.declaration_default_allocate_lexical_v1(binder, frame))
                out.kind = HirPatternKind.Array(self.remap_declaration_default_patterns_v1(elements, frame), mapped_rest)
            case HirPatternKind.Struct(ty, fields):
                val st: HirType = ty
                out.kind = HirPatternKind.Struct(self.remap_declaration_default_type_v1(st, frame), self.remap_declaration_default_named_patterns_v1(fields, frame))
            case HirPatternKind.Enum(ty, variant, payload):
                val et: HirType = ty
                out.kind = HirPatternKind.Enum(self.remap_declaration_default_type_v1(et, frame), variant, self.remap_declaration_default_pattern_payload_v1(payload, frame))
            case HirPatternKind.Or(patterns):
                out.kind = HirPatternKind.Or(self.remap_declaration_default_patterns_v1(patterns, frame))
            case HirPatternKind.Range(start, end, inclusive):
                val s2: HirExpr = start
                val e2: HirExpr = end
                out.kind = HirPatternKind.Range(self.remap_declaration_default_expr_v1(s2, frame), self.remap_declaration_default_expr_v1(e2, frame), inclusive)
            case HirPatternKind.Wildcard | HirPatternKind.Error | HirPatternKind.CompleteRegion(_) | HirPatternKind.DynRegion(_) | HirPatternKind.TypeTest(_, _): ()
            case _:
                self.declaration_default_fail_v1(frame, "parameter default pattern variant requires structural remapping", pattern.span)
                out.kind = HirPatternKind.Error
        out


    me remap_declaration_default_stmt_v1(stmt: HirStmt, frame: MirHirDefaultBindingFrameV1) -> HirStmt:
        """Remap type parameters inside a statement."""
        if stmt == nil:
            return stmt
        var out = stmt
        match stmt.kind:
            case HirStmtKind.Let(sym, ty, init):
                # An unannotated binding lowers with a nil type slot; only a
                # written annotation can mention a type parameter.
                var new_ty = ty
                if ty != nil:
                    val lt: HirType = ty
                    new_ty = self.remap_declaration_default_type_v1(lt, frame)
                val li: HirExpr = init
                val mapped_init = self.remap_declaration_default_expr_v1(li, frame)
                val target = self.declaration_default_allocate_lexical_v1(sym, frame)
                out.kind = HirStmtKind.Let(target, new_ty, mapped_init)
            case HirStmtKind.Assign(target, op, value):
                val at: HirExpr = target
                val av: HirExpr = value
                out.kind = HirStmtKind.Assign(self.remap_declaration_default_expr_v1(at, frame), op, self.remap_declaration_default_expr_v1(av, frame))
            case HirStmtKind.Expr(e):
                val et: HirExpr = e
                out.kind = HirStmtKind.Expr(self.remap_declaration_default_expr_v1(et, frame))
            case HirStmtKind.Block(b):
                val bt: HirBlock = b
                out.kind = HirStmtKind.Block(self.remap_declaration_default_block_v1(bt, frame))
            case HirStmtKind.AsmAssert(_): ()
            case _:
                self.declaration_default_fail_v1(frame, "parameter default statement variant requires structural remapping", stmt.span)
        out


    me remap_declaration_default_block_v1(block: HirBlock, frame: MirHirDefaultBindingFrameV1) -> HirBlock:
        """Remap type parameters throughout a block.

        `block.value` is a DESUGARED plain field gated by `block.has` (NOT an
        Option), so it is gated on `has` rather than Option-matched - same
        convention as the scan/rewrite walks in `monomorphize_integration.spl`."""
        if block == nil:
            return block
        var out = block
        var stmts: [HirStmt] = []
        for stmt in block.stmts:
            val st: HirStmt = stmt
            stmts = stmts.push(self.remap_declaration_default_stmt_v1(st, frame))
        out.stmts = stmts
        if block.has:
            val bv: HirExpr = block.value
            out.value = self.remap_declaration_default_expr_v1(bv, frame)
        out


    me remap_declaration_default_asm_v1(asm_node: HirAsm, frame: MirHirDefaultBindingFrameV1) -> HirAsm:
        """Remap inside inline-assembly operand expressions."""
        var out = asm_node
        var cons: [HirAsmConstraint] = []
        for c in asm_node.constraints:
            val ct: HirAsmConstraint = c
            var nc = ct
            nc.value = self.remap_declaration_default_expr_v1(ct.value, frame)
            nc.output_value = self.remap_declaration_default_expr_opt_v1(ct.output_value, frame)
            cons = cons.push(nc)
        out.constraints = cons
        out


    me remap_declaration_default_expr_v1(expr: HirExpr, frame: MirHirDefaultBindingFrameV1) -> HirExpr:
        """Bind a complete provider expression in the current consumer scope.

        Types and canonical declarations use the actual provider table;
        lexical binders receive fresh consumer symbols and prior parameters
        refer to their actual supplied MIR operands. All nested records retain
        their source spans, flags and callable effects."""
        if expr == nil:
            return expr
        var out = expr
        if expr.has_type_:
            out.type_ = self.remap_declaration_default_type_v1(expr.type_, frame)
        match expr.kind:
            case HirExprKind.Var(symbol):
                val target = self.declaration_default_reference_v1(symbol, frame)
                out.kind = HirExprKind.Var(target)
            case HirExprKind.NamedVar(symbol, name):
                val target = self.declaration_default_reference_v1(symbol, frame)
                if target.id >= 0:
                    out.kind = HirExprKind.NamedVar(target, self.symbols.symbol_display_name(target, name))
                else: out.kind = HirExprKind.Error
            # Collections
            case HirExprKind.ArrayLit(elements, elem_ty):
                out.kind = HirExprKind.ArrayLit(self.remap_declaration_default_exprs_v1(elements, frame), self.remap_declaration_default_type_opt_v1(elem_ty, frame))
            case HirExprKind.ArrayRepeat(value, count, elem_ty):
                val v1: HirExpr = value
                val c1: HirExpr = count
                out.kind = HirExprKind.ArrayRepeat(self.remap_declaration_default_expr_v1(v1, frame), self.remap_declaration_default_expr_v1(c1, frame), self.remap_declaration_default_type_opt_v1(elem_ty, frame))
            case HirExprKind.TupleLit(elements):
                out.kind = HirExprKind.TupleLit(self.remap_declaration_default_exprs_v1(elements, frame))
            case HirExprKind.DictLit(entries, key_ty, value_ty):
                var new_entries: [(HirExpr, HirExpr)] = []
                for entry in entries:
                    val (k, v) = entry
                    val kt: HirExpr = k
                    val vt: HirExpr = v
                    new_entries = new_entries.push((self.remap_declaration_default_expr_v1(kt, frame), self.remap_declaration_default_expr_v1(vt, frame)))
                val ktype: HirType = key_ty
                out.kind = HirExprKind.DictLit(new_entries, self.remap_declaration_default_type_v1(ktype, frame), self.remap_declaration_default_type_opt_v1(value_ty, frame))
            case HirExprKind.SetLit(elements, elem_ty):
                out.kind = HirExprKind.SetLit(self.remap_declaration_default_exprs_v1(elements, frame), self.remap_declaration_default_type_opt_v1(elem_ty, frame))

            # Access
            case HirExprKind.Field(base, field, resolved):
                val b1: HirExpr = base
                # Field IDs belong to the source nominal owner. The existing
                # receiver/type owner resolver rebinds the field by name.
                out.kind = HirExprKind.Field(self.remap_declaration_default_expr_v1(b1, frame), field, None)
            case HirExprKind.Index(base, index):
                val b2: HirExpr = base
                val i2: HirExpr = index
                out.kind = HirExprKind.Index(self.remap_declaration_default_expr_v1(b2, frame), self.remap_declaration_default_expr_v1(i2, frame))
            case HirExprKind.TupleIndex(base, index):
                val b3: HirExpr = base
                out.kind = HirExprKind.TupleIndex(self.remap_declaration_default_expr_v1(b3, frame), index)

            # Optional operations
            case HirExprKind.OptionalChain(base, field):
                val b4: HirExpr = base
                out.kind = HirExprKind.OptionalChain(self.remap_declaration_default_expr_v1(b4, frame), field)
            case HirExprKind.NullCoalesce(left, right):
                val l1: HirExpr = left
                val r1: HirExpr = right
                out.kind = HirExprKind.NullCoalesce(self.remap_declaration_default_expr_v1(l1, frame), self.remap_declaration_default_expr_v1(r1, frame))
            case HirExprKind.ExistsCheck(base):
                val b5: HirExpr = base
                out.kind = HirExprKind.ExistsCheck(self.remap_declaration_default_expr_v1(b5, frame))
            case HirExprKind.Unwrap(base):
                val b6: HirExpr = base
                out.kind = HirExprKind.Unwrap(self.remap_declaration_default_expr_v1(b6, frame))

            # Operators
            case HirExprKind.Binary(op, left, right):
                val l2: HirExpr = left
                val r2: HirExpr = right
                out.kind = HirExprKind.Binary(op, self.remap_declaration_default_expr_v1(l2, frame), self.remap_declaration_default_expr_v1(r2, frame))
            case HirExprKind.Unary(op, operand):
                val o1: HirExpr = operand
                out.kind = HirExprKind.Unary(op, self.remap_declaration_default_expr_v1(o1, frame))

            # Calls - the type ARGUMENTS are remapped too, so an inner generic
            # call inside a specialization names concrete types.
            case HirExprKind.Call(callee, args, type_args):
                val ce: HirExpr = callee
                var new_targs: [HirType] = []
                for ta in type_args:
                    val tat: HirType = ta
                    new_targs = new_targs.push(self.remap_declaration_default_type_v1(tat, frame))
                out.kind = HirExprKind.Call(self.remap_declaration_default_expr_v1(ce, frame), self.remap_declaration_default_call_args_v1(args, frame), new_targs)
            case HirExprKind.MethodCall(receiver, method, args, resolution):
                val rc: HirExpr = receiver
                out.kind = HirExprKind.MethodCall(self.remap_declaration_default_expr_v1(rc, frame), method,
                    self.remap_declaration_default_call_args_v1(args, frame),
                    self.declaration_default_resolution_v1(resolution, frame, expr.span))
            case HirExprKind.StaticCall(ty, method, args, resolution):
                val sct: HirType = ty
                out.kind = HirExprKind.StaticCall(self.remap_declaration_default_type_v1(sct, frame), method,
                    self.remap_declaration_default_call_args_v1(args, frame),
                    self.declaration_default_resolution_v1(resolution, frame, expr.span))

            # Control flow
            case HirExprKind.If(cond, then_, else_):
                val cd: HirExpr = cond
                val th: HirBlock = then_
                out.kind = HirExprKind.If(self.remap_declaration_default_expr_v1(cd, frame), self.remap_declaration_default_block_v1(th, frame), self.remap_declaration_default_block_opt_v1(else_, frame))
            case HirExprKind.IfChain(arms, else_):
                var new_arms: [HirIfArm] = []
                for arm in arms:
                    val at2: HirIfArm = arm
                    var na = at2
                    na.cond = self.remap_declaration_default_expr_v1(at2.cond, frame)
                    na.then_ = self.remap_declaration_default_block_v1(at2.then_, frame)
                    new_arms = new_arms.push(na)
                out.kind = HirExprKind.IfChain(new_arms, self.remap_declaration_default_block_opt_v1(else_, frame))
            case HirExprKind.MatchCase(scrutinee, arms):
                val sc: HirExpr = scrutinee
                var marms: [HirMatchArm] = []
                for arm in arms:
                    val mt: HirMatchArm = arm
                    var nm = mt
                    nm.pattern = self.remap_declaration_default_pattern_v1(mt.pattern, frame)
                    if mt.has_guard:
                        nm.guard = self.remap_declaration_default_expr_v1(mt.guard, frame)
                    nm.body = self.remap_declaration_default_block_v1(mt.body, frame)
                    marms = marms.push(nm)
                out.kind = HirExprKind.MatchCase(self.remap_declaration_default_expr_v1(sc, frame), marms)
            case HirExprKind.Loop(body, label):
                val lb: HirBlock = body
                out.kind = HirExprKind.Loop(self.remap_declaration_default_block_v1(lb, frame), label)
            case HirExprKind.While(cond, body, label):
                val wc: HirExpr = cond
                val wb: HirBlock = body
                out.kind = HirExprKind.While(self.remap_declaration_default_expr_v1(wc, frame), self.remap_declaration_default_block_v1(wb, frame), label)
            case HirExprKind.For(var_, iter, body, label):
                val fi: HirExpr = iter
                val fb: HirBlock = body
                val mapped_iter = self.remap_declaration_default_expr_v1(fi, frame)
                val binder = self.declaration_default_allocate_lexical_v1(var_, frame)
                out.kind = HirExprKind.For(binder, mapped_iter, self.remap_declaration_default_block_v1(fb, frame), label)
            case HirExprKind.With(items, body):
                var new_items: [HirWithItem] = []
                for item in items:
                    val it2: HirWithItem = item
                    var ni = it2
                    ni.context_expr = self.remap_declaration_default_expr_v1(it2.context_expr, frame)
                    if it2.has_target:
                        ni.target = self.declaration_default_allocate_lexical_v1(it2.target, frame)
                    new_items = new_items.push(ni)
                val wbb: HirBlock = body
                out.kind = HirExprKind.With(new_items, self.remap_declaration_default_block_v1(wbb, frame))

            # Closures and blocks
            case HirExprKind.Lambda(params, body, captures):
                var lparams: [HirParam] = []
                for p in params:
                    val pt2: HirParam = p
                    lparams = lparams.push(self.remap_declaration_default_param_v1(pt2, frame))
                val lbody: HirExpr = body
                var mapped_captures: [SymbolId] = []
                for capture in captures:
                    val source: SymbolId = capture
                    mapped_captures.push(self.declaration_default_reference_v1(source, frame))
                out.kind = HirExprKind.Lambda(lparams, self.remap_declaration_default_expr_v1(lbody, frame), mapped_captures)
            case HirExprKind.Block(block):
                val bk: HirBlock = block
                out.kind = HirExprKind.Block(self.remap_declaration_default_block_v1(bk, frame))
            case HirExprKind.HostGpuLane(lane_code, payload_size, marker, body):
                val mk: HirExpr = marker
                val gb: HirBlock = body
                out.kind = HirExprKind.HostGpuLane(lane_code, payload_size, self.remap_declaration_default_expr_v1(mk, frame), self.remap_declaration_default_block_v1(gb, frame))

            # Control transfer
            case HirExprKind.Return(value):
                out.kind = HirExprKind.Return(self.remap_declaration_default_expr_opt_v1(value, frame))
            case HirExprKind.Break(label, value):
                out.kind = HirExprKind.Break(label, self.remap_declaration_default_expr_opt_v1(value, frame))
            case HirExprKind.Throw(value):
                val tv: HirExpr = value
                out.kind = HirExprKind.Throw(self.remap_declaration_default_expr_v1(tv, frame))
            case HirExprKind.Try(inner):
                val ti: HirExpr = inner
                out.kind = HirExprKind.Try(self.remap_declaration_default_expr_v1(ti, frame))

            # Async
            case HirExprKind.Await(inner):
                val ai: HirExpr = inner
                out.kind = HirExprKind.Await(self.remap_declaration_default_expr_v1(ai, frame))
            case HirExprKind.Yield(value):
                out.kind = HirExprKind.Yield(self.remap_declaration_default_expr_opt_v1(value, frame))

            # Construction
            case HirExprKind.StructLit(ty, fields):
                val slt: HirType = ty
                out.kind = HirExprKind.StructLit(self.remap_declaration_default_type_v1(slt, frame), self.remap_declaration_default_named_exprs_v1(fields, frame))
            case HirExprKind.EnumLit(ty, variant, payload):
                val elt: HirType = ty
                out.kind = HirExprKind.EnumLit(self.remap_declaration_default_type_v1(elt, frame), variant, self.remap_declaration_default_enum_payload_v1(payload, frame))

            # Casts
            case HirExprKind.Cast(inner, target):
                val ci: HirExpr = inner
                val ct2: HirType = target
                out.kind = HirExprKind.Cast(self.remap_declaration_default_expr_v1(ci, frame), self.remap_declaration_default_type_v1(ct2, frame))
            case HirExprKind.As(inner, target):
                val ai2: HirExpr = inner
                val at3: HirType = target
                out.kind = HirExprKind.As(self.remap_declaration_default_expr_v1(ai2, frame), self.remap_declaration_default_type_v1(at3, frame))
            case HirExprKind.ConvertCall(inner, target):
                val cvi: HirExpr = inner
                val cvt2: HirType = target
                out.kind = HirExprKind.ConvertCall(self.remap_declaration_default_expr_v1(cvi, frame), self.remap_declaration_default_type_v1(cvt2, frame))

            # Special
            case HirExprKind.Range(start, end, inclusive, step):
                out.kind = HirExprKind.Range(self.remap_declaration_default_expr_opt_v1(start, frame), self.remap_declaration_default_expr_opt_v1(end, frame), inclusive, self.remap_declaration_default_expr_opt_v1(step, frame))
            case HirExprKind.Comprehension(kind, inner, clauses):
                val ce2: HirExpr = inner
                var new_clauses: [HirCompClause] = []
                for clause in clauses:
                    val cl: HirCompClause = clause
                    var nc2 = cl
                    match cl.kind:
                        case HirCompClauseKind.For(var_, iter):
                            val cli: HirExpr = iter
                            val mapped_iter = self.remap_declaration_default_expr_v1(cli, frame)
                            val binder = self.declaration_default_allocate_lexical_v1(var_, frame)
                            nc2.kind = HirCompClauseKind.For(binder, mapped_iter)
                        case HirCompClauseKind.If(cond):
                            val clc: HirExpr = cond
                            nc2.kind = HirCompClauseKind.If(self.remap_declaration_default_expr_v1(clc, frame))
                    new_clauses = new_clauses.push(nc2)
                out.kind = HirExprKind.Comprehension(kind, self.remap_declaration_default_expr_v1(ce2, frame), new_clauses)

            # Math/DL and unsafe blocks
            case HirExprKind.LossBlock(body):
                val lbb: HirBlock = body
                out.kind = HirExprKind.LossBlock(self.remap_declaration_default_block_v1(lbb, frame))
            case HirExprKind.NogradBlock(body):
                val nbb: HirBlock = body
                out.kind = HirExprKind.NogradBlock(self.remap_declaration_default_block_v1(nbb, frame))
            case HirExprKind.UnsafeBlock(body):
                val ubb: HirBlock = body
                out.kind = HirExprKind.UnsafeBlock(self.remap_declaration_default_block_v1(ubb, frame))

            # Inline assembly - operand expressions can name a type parameter.
            case HirExprKind.InlineAsm(asm_node):
                val an: HirAsm = asm_node
                out.kind = HirExprKind.InlineAsm(self.remap_declaration_default_asm_v1(an, frame))
            case HirExprKind.InlineAsmMatch(arms):
                var aarms: [HirAsmMatchArm] = []
                for arm in arms:
                    val aa: HirAsmMatchArm = arm
                    var na2 = aa
                    if aa.has_asm_body:
                        na2.asm_body = self.remap_declaration_default_asm_v1(aa.asm_body, frame)
                    aarms = aarms.push(na2)
                out.kind = HirExprKind.InlineAsmMatch(aarms)

            # Interpolation segments, type tests and try/catch hold full
            # expressions/blocks too (same positions `rewrite_expr` in
            # monomorphize_integration.spl walks for call sites).
            case HirExprKind.StringLit(value, interps):
                # Cached HIR can wrap the list in Some; unwrap before traversal.
                if val interpolation_items = interps:
                    var new_interps: [HirInterpolation] = []
                    for item in interpolation_items:
                        val it: HirInterpolation = item
                        var ni = it
                        ni.expr = self.remap_declaration_default_expr_v1(it.expr, frame)
                        new_interps = new_interps.push(ni)
                    out.kind = HirExprKind.StringLit(value, new_interps)
            case HirExprKind.TypeTest(value, type_name):
                val ttv: HirExpr = value
                out.kind = HirExprKind.TypeTest(self.remap_declaration_default_expr_v1(ttv, frame), type_name)
            case HirExprKind.TryCatch(body, clauses, finally_):
                val tcb: HirBlock = body
                var new_clauses: [HirCatchClause] = []
                for clause in clauses:
                    val cc: HirCatchClause = clause
                    var ncc = cc
                    if cc.has_pattern:
                        ncc.pattern = self.remap_declaration_default_pattern_v1(cc.pattern, frame)
                    if cc.has_type_:
                        ncc.type_ = self.remap_declaration_default_type_v1(cc.type_, frame)
                    ncc.body = self.remap_declaration_default_block_v1(cc.body, frame)
                    new_clauses = new_clauses.push(ncc)
                out.kind = HirExprKind.TryCatch(self.remap_declaration_default_block_v1(tcb, frame), new_clauses, self.remap_declaration_default_block_opt_v1(finally_, frame))

            case HirExprKind.CfgSelect(conds, arms, else_):
                var new_arms: [HirBlock] = []
                for arm in arms:
                    val ab: HirBlock = arm
                    new_arms = new_arms.push(self.remap_declaration_default_block_v1(ab, frame))
                out.kind = HirExprKind.CfgSelect(conds, new_arms, self.remap_declaration_default_block_opt_v1(else_, frame))

            case HirExprKind.IntLit(_, _) | HirExprKind.FloatLit(_, _) | HirExprKind.FloatLexeme(_, _) | HirExprKind.BoolLit(_) | HirExprKind.CharLit(_) | HirExprKind.UnitLit | HirExprKind.NilLit | HirExprKind.Continue(_) | HirExprKind.CustomBlock(_, _) | HirExprKind.Error: ()
            case _:
                self.declaration_default_fail_v1(frame, "parameter default expression variant requires structural remapping", expr.span)
                out.kind = HirExprKind.Error
        out


    me remap_declaration_default_param_v1(param: HirParam, frame: MirHirDefaultBindingFrameV1) -> HirParam:
        """Allocate a real lexical parameter and preserve its full metadata."""
        var out = param
        out.symbol = self.declaration_default_allocate_lexical_v1(param.symbol, frame)
        out.type_ = self.remap_declaration_default_type_v1(param.type_, frame)
        if out.symbol.id >= 0:
            var target: HirSymbol = self.symbols.symbols[out.symbol.id]
            target.type_ = Some(out.type_)
            target.is_mutable = param.is_mutable
            self.symbols.symbols[out.symbol.id] = target
        if param.has_default:
            out.default = self.remap_declaration_default_expr_v1(param.default, frame)
        out
