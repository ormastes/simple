# Dense destination-HIR expression cases whose scalar payload has an exact
# existing MIR/runtime representation. Cases whose legacy lowering is a
# placeholder remain fail-closed in the hot dispatcher.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirInst, MirInstKind, MirOperand, MirOperandKind, MirBinOp}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirConstValue, MirSignature}

fn destination_dense_runtime(name: text, arity: i64,
        return_type: MirType) -> MirOperand:
    var params: [MirType] = []
    var i = 0
    while i < arity:
        params.push(MirType.i64())
        i = i + 1
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(params: params,
            return_type: return_type, is_variadic: false)))))

impl MirLowering:
    me destination_dense_zero(type_: MirType) -> LocalId:
        val result = self.builder.new_temp(type_)
        self.builder.emit_const(result, MirConstValue.Zero, type_)
        result

    me lower_destination_unwrap(r: MirDestinationFunctionReceipt,
            row: i64, type_: MirType) -> LocalId:
        val base = self.mir_destination_lower_expr_row(r,
            hdr_expr_i64(r.slot, r.generation, row, 0), nil)
        val present = self.destination_option_is_some(base)
        var b = self.builder
        val some_block = b.new_block(Some("destination_unwrap_some"))
        val none_block = b.new_block(Some("destination_unwrap_none"))
        val merge_block = b.new_block(Some("destination_unwrap_merge"))
        val result = b.new_temp(type_)
        b.terminate_if(mir_operand_copy(present), some_block, none_block)
        b.switch_to_block(some_block)
        self.builder = b
        var payload = self.option_payload_or_self(base)
        payload = self.enum_payload_value(payload, type_)
        b = self.builder
        b.emit_copy(result, payload)
        b.terminate_goto(merge_block)
        b.switch_to_block(none_block)
        val panic_message = b.emit_const_str("attempted to unwrap absent optional value")
        val panic = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("rt_panic"), MirType(kind: MirTypeKind.FuncPtr(
                MirSignature(params: [], return_type: MirType.unit(),
                    is_variadic: false)))))
        b.emit_call(panic, [mir_operand_copy(panic_message)], MirType.unit())
        b.emit_const(result, MirConstValue.Zero, type_)
        b.terminate_goto(merge_block)
        b.switch_to_block(merge_block)
        self.builder = b
        result

    me lower_destination_host_gpu(r: MirDestinationFunctionReceipt,
            row: i64, type_: MirType) -> LocalId:
        self.mir_destination_lower_expr_row(r,
            hdr_expr_i64(r.slot, r.generation, row, 2), nil)
        val lane = hdr_expr_i64(r.slot, r.generation, row, 0)
        val payload_size = hdr_expr_i64(r.slot, r.generation, row, 1)
        var b = self.builder
        b.emit_call(destination_dense_runtime("rt_host_gpu_lane_event", 2,
            MirType.i64()), [mir_operand_const_int(lane), mir_operand_const_int(1)],
            MirType.i64())
        if lane == 2:
            b.emit_call(destination_dense_runtime("rt_host_gpu_queue_emit", 4,
                MirType.i64()), [mir_operand_const_int(lane), mir_operand_const_int(1),
                mir_operand_const_int(payload_size), mir_operand_const_int(0)], MirType.i64())
        self.builder = b
        self.lower_destination_block(r, hdr_expr_i64(r.slot, r.generation, row, 3), nil)
        b = self.builder
        b.emit_call(destination_dense_runtime("rt_host_gpu_lane_event", 2,
            MirType.i64()), [mir_operand_const_int(lane), mir_operand_const_int(2)],
            MirType.i64())
        self.builder = b
        self.destination_dense_zero(type_)

    me lower_destination_for(r: MirDestinationFunctionReceipt,
            row: i64, type_: MirType) -> LocalId:
        # The flat/runtime iterator fallback admits runtime arrays.  Keep the
        # destination path allocation-free: one length, one counter, and one
        # decoded element local reused by the loop body.
        val iter_row = hdr_expr_i64(r.slot, r.generation, row, 1)
        if hdr_expr_shape(r.slot, r.generation, iter_row) == HD_EXPR_RANGE:
            return self.lower_destination_for_range(r, row, iter_row, type_)
        var iterable = self.mir_destination_lower_expr_row(r, iter_row, nil)
        val iter_type_row = hdr_expr_type(r.slot, r.generation, iter_row)
        val iter_type_shape = if iter_type_row >= 0:
            hdr_type_shape(r.slot, r.generation, iter_type_row)
        else: -1
        if iter_type_shape == HD_TYPE_STR:
            var chars_builder = self.builder
            val chars = chars_builder.emit_call(destination_dense_runtime("rt_string_chars", 1,
                MirType.i64()), [mir_operand_copy(iterable)], MirType.i64())
            self.builder = chars_builder
            iterable = chars ?? LocalId(id: -1)
        elif iter_type_shape != HD_TYPE_ARRAY and iter_type_shape != HD_TYPE_SLICE:
            self.error_fatal("E-MIR-DESTINATION-FOR: flat native semantics admit only Range, text, Array, or Slice", nil)
            return LocalId(id: -1)
        var b = self.builder
        val length_call = b.emit_call(destination_dense_runtime("rt_array_len", 1,
            MirType.i64()), [mir_operand_copy(iterable)], MirType.i64())
        val length = length_call ?? LocalId(id: -1)
        val counter = b.new_local(nil, MirType.i64(), LocalKind.Var)
        b.emit_const(counter, MirConstValue.Int(0), MirType.i64())
        val head = b.new_block(Some("destination_for_head"))
        val body = b.new_block(Some("destination_for_body"))
        val increment = b.new_block(Some("destination_for_increment"))
        val exit = b.new_block(Some("destination_for_exit"))
        b.terminate_goto(head)
        b.switch_to_block(head)
        val condition = b.emit_binop(MirBinOp.Lt,
            mir_operand_copy(counter), mir_operand_copy(length), MirType.bool())
        b.terminate_if(mir_operand_copy(condition), body, exit)
        b.switch_to_block(body)
        val element_call = b.emit_call(destination_dense_runtime("rt_array_get", 2,
            MirType.i64()), [mir_operand_copy(iterable), mir_operand_copy(counter)],
            MirType.i64())
        self.builder = b
        self.bind_local(hdr_expr_i64(r.slot, r.generation, row, 0),
            element_call ?? LocalId(id: -1))
        self.loop_stack.push((increment, exit))
        self.lower_destination_block(r, hdr_expr_i64(r.slot, r.generation, row, 2), nil)
        self.loop_stack.pop()
        b = self.builder
        if not b.current_block_has_explicit_terminator(): b.terminate_goto(increment)
        b.switch_to_block(increment)
        val one = b.emit_const_int(1)
        val next = b.emit_binop(MirBinOp.Add,
            mir_operand_copy(counter), mir_operand_copy(one), MirType.i64())
        b.emit_copy(counter, next)
        b.terminate_goto(head)
        b.switch_to_block(exit)
        self.builder = b
        self.destination_dense_zero(type_)

    me lower_destination_for_range(r: MirDestinationFunctionReceipt,
            for_row: i64, range_row: i64, type_: MirType) -> LocalId:
        if (not hdr_expr_bool(r.slot, r.generation, range_row, 2) or
                not hdr_expr_bool(r.slot, r.generation, range_row, 3)):
            self.error_fatal("E-MIR-DESTINATION-FOR: open-ended Range has no finite native loop bound", nil)
            return LocalId(id: -1)
        val start = self.mir_destination_lower_expr_row(r,
            hdr_expr_i64(r.slot, r.generation, range_row, 0), nil)
        val end = self.mir_destination_lower_expr_row(r,
            hdr_expr_i64(r.slot, r.generation, range_row, 1), nil)
        var b = self.builder
        val counter_type = self.local_mir_type_of(start) ?? MirType.i64()
        val counter = b.new_local(nil, counter_type, LocalKind.Var)
        b.emit_copy(counter, start)
        var step = b.new_temp(counter_type)
        b.emit_const(step, MirConstValue.Int(1), counter_type)
        self.builder = b
        if hdr_expr_bool(r.slot, r.generation, range_row, 1):
            step = self.mir_destination_lower_expr_row(r,
                hdr_expr_i64(r.slot, r.generation, range_row, 2), Some(counter_type))
            b = self.builder
        val head = b.new_block(Some("destination_for_range_head"))
        val ascending_check = b.new_block(Some("destination_for_range_ascending_check"))
        val descending_dispatch = b.new_block(Some("destination_for_range_descending_dispatch"))
        val descending_check = b.new_block(Some("destination_for_range_descending_check"))
        val body = b.new_block(Some("destination_for_range_body"))
        val increment = b.new_block(Some("destination_for_range_increment"))
        val exit = b.new_block(Some("destination_for_range_exit"))
        # Direction follows the evaluated step. Hoist both invariant direction
        # comparisons out of the loop; the head only dispatches on the cached
        # boolean. A zero step exits instead of producing a non-progressing
        # native loop.
        val zero = b.new_temp(counter_type)
        b.emit_const(zero, MirConstValue.Int(0), counter_type)
        val ascending = b.emit_binop(MirBinOp.Gt,
            mir_operand_copy(step), mir_operand_copy(zero), MirType.bool())
        val descending = b.emit_binop(MirBinOp.Lt,
            mir_operand_copy(step), mir_operand_copy(zero), MirType.bool())
        b.terminate_if(mir_operand_copy(ascending), head, descending_dispatch)
        b.switch_to_block(descending_dispatch)
        b.terminate_if(mir_operand_copy(descending), head, exit)
        b.switch_to_block(head)
        b.terminate_if(mir_operand_copy(ascending), ascending_check, descending_check)
        b.switch_to_block(ascending_check)
        val ascending_condition = b.emit_binop(
            if hdr_expr_bool(r.slot, r.generation, range_row, 0): MirBinOp.Le else: MirBinOp.Lt,
            mir_operand_copy(counter), mir_operand_copy(end), MirType.bool())
        b.terminate_if(mir_operand_copy(ascending_condition), body, exit)
        b.switch_to_block(descending_check)
        val descending_condition = b.emit_binop(
            if hdr_expr_bool(r.slot, r.generation, range_row, 0): MirBinOp.Ge else: MirBinOp.Gt,
            mir_operand_copy(counter), mir_operand_copy(end), MirType.bool())
        b.terminate_if(mir_operand_copy(descending_condition), body, exit)
        b.switch_to_block(body)
        self.builder = b
        self.bind_local(hdr_expr_i64(r.slot, r.generation, for_row, 0), counter)
        self.loop_stack.push((increment, exit))
        self.lower_destination_block(r, hdr_expr_i64(r.slot, r.generation, for_row, 2), nil)
        self.loop_stack.pop(); b = self.builder
        if not b.current_block_has_explicit_terminator(): b.terminate_goto(increment)
        b.switch_to_block(increment)
        val next = b.emit_binop(MirBinOp.Add, mir_operand_copy(counter),
            mir_operand_copy(step), counter_type)
        b.emit_copy(counter, next); b.terminate_goto(head); b.switch_to_block(exit)
        self.builder = b
        self.destination_dense_zero(type_)

    me lower_destination_try(r: MirDestinationFunctionReceipt,
            row: i64, type_: MirType) -> LocalId:
        val base_row = hdr_expr_i64(r.slot, r.generation, row, 0)
        val base = self.mir_destination_lower_expr_row(r, base_row, nil)
        val base_type_row = hdr_expr_type(r.slot, r.generation, base_row)
        val base_type_shape = if base_type_row >= 0:
            hdr_type_shape(r.slot, r.generation, base_type_row)
        else: -1
        if base_type_shape != HD_TYPE_OPTIONAL and base_type_shape != HD_TYPE_RESULT:
            self.error_fatal("E-MIR-DESTINATION-TRY: operand is neither Optional nor Result", nil)
            return LocalId(id: -1)
        var b = self.builder
        val disc_call = b.emit_call(destination_dense_runtime("rt_enum_discriminant", 1,
            MirType.i64()), [mir_operand_copy(base)], MirType.i64())
        val disc = disc_call ?? LocalId(id: -1)
        val one = b.emit_const_int(1)
        val not_enum = b.emit_const_int(-1)
        val boxed_failure = b.emit_binop(MirBinOp.Eq,
            mir_operand_copy(disc), mir_operand_copy(one), MirType.bool())
        val failure = b.new_block(Some("destination_try_failure"))
        val success = b.new_block(Some("destination_try_success"))
        if base_type_shape == HD_TYPE_RESULT:
            b.terminate_if(mir_operand_copy(boxed_failure), failure, success)
        else:
            val boxed = b.emit_binop(MirBinOp.Ne,
                mir_operand_copy(disc), mir_operand_copy(not_enum), MirType.bool())
            val boxed_dispatch = b.new_block(Some("destination_try_optional_boxed"))
            val flat = b.new_block(Some("destination_try_optional_flat"))
            b.terminate_if(mir_operand_copy(boxed), boxed_dispatch, flat)
            b.switch_to_block(boxed_dispatch)
            # Boxed Optional uses the reserved Some=0/None=1 layout.
            b.terminate_if(mir_operand_copy(boxed_failure), failure, success)
            b.switch_to_block(flat)
            val present_call = b.emit_call(destination_dense_runtime("rt_is_some", 1,
                MirType.bool()), [mir_operand_copy(base)], MirType.bool())
            b.terminate_if(mir_operand_copy(present_call ?? LocalId(id: -1)), success, failure)
        b.switch_to_block(failure)
        if base_type_shape == HD_TYPE_OPTIONAL:
            val enum_id = b.emit_const_int(self.enum_runtime_id("Option"))
            val none_disc = b.emit_const_int(self.enum_variant_discriminant("Option", "None"))
            val zero = b.emit_const_int(0)
            val none_call = b.emit_call(destination_dense_runtime("rt_enum_new", 3,
                MirType.i64()), [mir_operand_copy(enum_id), mir_operand_copy(none_disc),
                mir_operand_copy(zero)], MirType.i64())
            b.terminate_return(Some(mir_operand_copy(none_call ?? base)))
        else:
            b.terminate_return(Some(mir_operand_copy(base)))
        b.switch_to_block(success)
        self.builder = b
        if base_type_shape == HD_TYPE_OPTIONAL:
            # Flat present option is its own payload; boxed values decode.
            val boxed = b.emit_binop(MirBinOp.Ne,
                mir_operand_copy(disc), mir_operand_copy(not_enum), MirType.bool())
            val boxed_payload = b.new_block(Some("destination_try_payload_boxed"))
            val flat_payload = b.new_block(Some("destination_try_payload_flat"))
            val merge = b.new_block(Some("destination_try_payload_merge"))
            val result = b.new_temp(type_)
            b.terminate_if(mir_operand_copy(boxed), boxed_payload, flat_payload)
            b.switch_to_block(boxed_payload)
            val payload_call = b.emit_call(destination_dense_runtime("rt_enum_payload", 1,
                MirType.i64()), [mir_operand_copy(base)], MirType.i64())
            self.builder = b
            val decoded = self.enum_payload_value(payload_call ?? base, type_)
            b = self.builder
            b.emit_copy(result, decoded)
            b.terminate_goto(merge)
            b.switch_to_block(flat_payload)
            b.emit_copy(result, base)
            b.terminate_goto(merge)
            b.switch_to_block(merge)
            self.builder = b
            return result
        val payload_call = b.emit_call(destination_dense_runtime("rt_enum_payload", 1,
            MirType.i64()), [mir_operand_copy(base)], MirType.i64())
        self.builder = b
        self.enum_payload_value(payload_call ?? base, type_)

    me lower_destination_dense_expr_row(r: MirDestinationFunctionReceipt,
            row: i64, shape: i64, type_: MirType,
            expected_type: MirType?) -> LocalId?:
        if shape == HD_EXPR_UNWRAP:
            return Some(self.lower_destination_unwrap(r, row, type_))
        if shape == HD_EXPR_HOST_GPU:
            return Some(self.lower_destination_host_gpu(r, row, type_))
        if shape == HD_EXPR_FOR:
            return Some(self.lower_destination_for(r, row, type_))
        if shape == HD_EXPR_TRY:
            return Some(self.lower_destination_try(r, row, type_))
        if shape == HD_EXPR_INLINE_ASM_MATCH:
            return Some(self.lower_destination_inline_asm_match_row(r, row, type_))
        if shape == HD_EXPR_TRY_CATCH:
            return Some(self.lower_destination_try_catch(r, row, type_))
        if shape == HD_EXPR_LAMBDA:
            return Some(self.lower_destination_lambda_value(r, row, type_))
        if shape == HD_EXPR_ERROR:
            self.error_fatal("E-MIR-DESTINATION-ERROR: recovery expression reached MIR", nil)
            return Some(LocalId(id: -1))
        if (shape == HD_EXPR_OPTIONAL_CHAIN or shape == HD_EXPR_WITH or
                shape == HD_EXPR_COMPREHENSION or
                shape == HD_EXPR_TYPE_TEST or
                shape == HD_EXPR_DICT_COMPREHENSION or shape == HD_EXPR_ARRAY_SUFFIX or
                shape == HD_EXPR_KERNEL_LAUNCH):
            # Source audit: expr_dispatch.spl explicitly rejects OptionalChain,
            # With, and Comprehension; TypeTest/DictComprehension/ArrayLitSuffix/
            # KernelLaunch have no dispatch arm and reach its terminal unsupported
            # branch. Destination lambdas are handled above through deterministic
            # synthesized MirFunction and closure-environment publication.
            self.error_fatal("E-MIR-DESTINATION-DENSE-UNSUPPORTED: scalar graph shape " +
                shape.to_text() + " has no exact legacy MIR/runtime ABI", nil)
            return Some(LocalId(id: -1))
        nil
