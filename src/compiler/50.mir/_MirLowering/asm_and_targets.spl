# Part of src/compiler/50.mir/mir_lowering.spl: inline-asm match lowering, asm asserts, target arch/os/abi/backend queries
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.bootstrap_globals.*
use compiler.mir._MirLowering.function_lowering.*
# MIR Lowering - HIR to MIR Transformation
#
# This module handles lowering from HIR (High-level IR) to MIR (Mid-level IR).
# It converts:
# - Nested expressions to SSA form
# - Control flow to basic blocks
# - Memory operations to explicit loads/stores
# - Type system from HIR to MIR representation
#
# Split into:
# - mir_lowering_types.spl: Struct definitions (MirLowering, MirError)
# - mir_lowering.spl: Core coordinator, module/function/type lowering, asm/target (this file)
# - mir_lowering_expr.spl: Expression lowering, operators, calls, literals
# - mir_lowering_stmts.spl: Statement lowering, control flow (if/loop/for)
# - mir_lowering_ml.spl: ML blocks, async/await, custom blocks

use compiler.mir.mir_data.*
use compiler.mir.mir_cfg_select.{mir_cfg_select_arm, mir_cfg_item_enabled}
use compiler.core.cfg_platform.{cfg_enabled_features}
use compiler.mir.mir_verify_levels.{mir_verify_levels_from_env}
use compiler.mir.mir_instructions.{MirModule, MirFunction, mir_operand_const_int}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.flat_ast_bridge.{flat_bootstrap_function_count, flat_bootstrap_function_at}
use compiler.common.diagnostics.span.{Span}
use compiler.blocks.value.BlockValue
use compiler.types.type_layout.{compute_struct_layout, layoutattr_default_, FieldLayout}
use compiler.core.types.{TYPE_BOOL, TYPE_I64, TYPE_F64}
use compiler.mir.synthetic_driver_codegen.{apply_synthetic_driver_codegen}
use compiler.frontend.core.types.{custom_primitive_underlying_type_tag_by_symbol}

# Import struct definitions from types module
use compiler.mir.mir_lowering_types.{MirLowering, MirError}

# Import split modules so their impl blocks are linked
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*
use compiler.mir.mir_lowering_stmts.*
use compiler.mir.mir_lowering_ml.*

impl MirLowering:
    me asm_target_spec_match_kind(
        archs: [text], has_os: bool, os: text, has_abi: bool, abi: text, has_backend: bool, backend: text,
        ver_ops: [text], ver_vals: [i64],
        target_arch: text, target_os: text, target_abi: text, target_backend: text,
        target_backend_version: i64
    ) -> text:
        """Match a target spec without importing std.common.target_spec helpers."""
        val normalized_target = if target_arch == "amd64" or target_arch == "x64":
            "x86_64"
        elif target_arch == "arm64":
            "aarch64"
        else:
            target_arch

        if archs.len() > 0:
            var arch_found = false
            for arch in archs:
                val normalized_arch = if arch == "amd64" or arch == "x64":
                    "x86_64"
                elif arch == "arm64":
                    "aarch64"
                else:
                    arch
                if normalized_arch == normalized_target:
                    arch_found = true
                    break
            if not arch_found:
                return "not_matched"

        if has_os and os != "_" and os != target_os:
            return "not_matched"
        if has_abi and abi != "_" and abi != target_abi:
            return "not_matched"
        if has_backend and backend != "_" and backend != target_backend:
            return "not_matched"

        if ver_ops.len() > 0 and target_backend_version < 0:
            return "unknown_version"

        var have_note = false
        var i = 0
        while i < ver_ops.len():
            val op = ver_ops[i]
            val value = ver_vals[i]
            if op == ">=" and target_backend_version < value:
                return "not_matched"
            if op == "<=" and target_backend_version > value:
                return "not_matched"
            if op == ">" and target_backend_version <= value:
                return "not_matched"
            if op == "<" and target_backend_version >= value:
                return "not_matched"
            if op == "==" and target_backend_version != value:
                return "not_matched"
            if op == "!=" and target_backend_version == value:
                return "not_matched"
            if op == "~=" and target_backend_version != value:
                have_note = true
            i = i + 1

        if have_note:
            return "note"
        "matched"

    me lower_cfg_select(conds: [text], arms: [HirBlock], else_: HirBlock?) -> LocalId?:
        """Lower a target-neutral @cfg select: pick the arm for THIS target.

        HIR keeps every arm; the selection lives here via mir_cfg_select_arm
        (first matching condition, else the `else` arm, else drop the select).
        A malformed condition is a hard error, never a silent false.
        """
        var conditions: [text] = []
        for c in conds:
            conditions.push(c)
        var has_else = false
        if else_.?:
            conditions.push("")
            has_else = true
        val idx = mir_cfg_select_arm(conditions, self.target_context, cfg_enabled_features())
        if idx == -2:
            self.error_fatal("malformed @cfg/@when condition in cfg select", nil)
            return self.builder.new_temp(MirType.unit())
        if idx < 0:
            return self.builder.new_temp(MirType.unit())
        if idx < arms.len():
            return self.lower_block(arms[idx]) ?? self.builder.new_temp(MirType.unit())
        if has_else:
            return self.lower_block(else_!) ?? self.builder.new_temp(MirType.unit())
        self.builder.new_temp(MirType.unit())

    me decl_cfg_keep(name: text, cfg: [text], group: i64, arm: i64, winners: Dict<i64, i64>) -> bool:
        """Decl-level @cfg gate: true = lower the item for THIS target.

        group 0: a standalone guard, evaluated alone (fast path when unguarded).
        group != 0: the item survives iff its arm is the group winning arm
        (see cfg_group_winners). A malformed guard is a hard error.
        """
        if group != 0:
            val won = winners.get(group) ?? -99
            return won == arm
        if cfg.len() == 0:
            return true
        val verdict = mir_cfg_item_enabled(cfg, self.target_context, cfg_enabled_features())
        if verdict == -2:
            self.error_fatal("malformed @cfg guard on {name}", nil)
            return false
        verdict == 1

    me cfg_rec_cond(group: i64, arm: i64, cfg: [text]) -> text:
        """Condition text of one grouped arm: cfg joined with " and ", "" for the else arm (cfg_arm == -1).

        A numbered arm without a condition (or an arm index below -1) is malformed.
        """
        if arm == -1: return ""
        if arm < -1 or cfg.len() == 0:
            self.error_fatal("malformed @cfg guard in group {group}: arm {arm} has no condition", nil)
            return "false"
        cfg.join(" and ")

    me cfg_group_winners(fn_values: [HirFunction], class_values: [HirClass], struct_values: [HirStruct],
            enum_values: [HirEnum], trait_values: [HirTrait], const_values: [HirConst],
            impls: [HirImpl]) -> Dict<i64, i64>:
        """Winning arm per @cfg group (-99 = no arm survives), each group evaluated once.

        Arms are ordered by cfg_arm with the else arm (cfg_arm == -1, per
        hir_cfg_decl_select_design.md) last. mir_cfg_select_arm then gives
        first-match-wins, else, or -1 (drop the group); -2 is malformed.
        """
        var rec_group: [i64] = []
        var rec_arm: [i64] = []
        var rec_cond: [text] = []
        for f in fn_values:
            if f.cfg_group != 0:
                rec_group.push(f.cfg_group)
                rec_arm.push(f.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(f.cfg_group, f.cfg_arm, f.cfg))
        for c in class_values:
            if c.cfg_group != 0:
                rec_group.push(c.cfg_group)
                rec_arm.push(c.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(c.cfg_group, c.cfg_arm, c.cfg))
        for s in struct_values:
            if s.cfg_group != 0:
                rec_group.push(s.cfg_group)
                rec_arm.push(s.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(s.cfg_group, s.cfg_arm, s.cfg))
        for e in enum_values:
            if e.cfg_group != 0:
                rec_group.push(e.cfg_group)
                rec_arm.push(e.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(e.cfg_group, e.cfg_arm, e.cfg))
        for t in trait_values:
            if t.cfg_group != 0:
                rec_group.push(t.cfg_group)
                rec_arm.push(t.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(t.cfg_group, t.cfg_arm, t.cfg))
        for k in const_values:
            if k.cfg_group != 0:
                rec_group.push(k.cfg_group)
                rec_arm.push(k.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(k.cfg_group, k.cfg_arm, k.cfg))
        for im in impls:
            if im.cfg_group != 0:
                rec_group.push(im.cfg_group)
                rec_arm.push(im.cfg_arm)
                rec_cond.push(self.cfg_rec_cond(im.cfg_group, im.cfg_arm, im.cfg))
        var winners: Dict<i64, i64> = {}
        var ri = 0
        while ri < rec_group.len():
            val g = rec_group[ri]
            ri = ri + 1
            if winners.has(g):
                continue
            # Distinct arms of group g, sorted (else = -1 sorts last).
            var arms: [i64] = []
            var conds: [text] = []
            var rj = 0
            while rj < rec_group.len():
                if rec_group[rj] == g and not arms.contains(rec_arm[rj]):
                    var pos = 0
                    while pos < arms.len() and cfg_arm_sort_key(arms[pos]) < cfg_arm_sort_key(rec_arm[rj]):
                        pos = pos + 1
                    arms.insert(pos, rec_arm[rj])
                    conds.insert(pos, rec_cond[rj])
                rj = rj + 1
            val idx = mir_cfg_select_arm(conds, self.target_context, cfg_enabled_features())
            if idx == -2:
                self.error_fatal("malformed @cfg guard in group {g}", nil)
                winners[g] = -99
            elif idx < 0:
                winners[g] = -99
            else:
                winners[g] = arms[idx]
        winners

    me apply_decl_cfg_guards(module: HirModule) -> HirModule:
        """Drop decls whose @cfg guard is off for this MirTargetContext.

        HIR is target-neutral and keeps every guarded variant; selection happens
        here. A disabled impl/class also drops its methods (they live in
        module.functions). Returns `module` untouched, with no allocation beyond
        one .values() per kind, when no decl carries a guard.
        """
        val fn_values: [HirFunction] = module.functions.values()
        val class_values: [HirClass] = module.classes.values()
        val struct_values: [HirStruct] = module.structs.values()
        val enum_values: [HirEnum] = module.enums.values()
        val trait_values: [HirTrait] = module.traits.values()
        val const_values: [HirConst] = module.constants.values()
        var guarded = false
        for f in fn_values:
            if f.cfg_group != 0 or f.cfg.len() > 0: guarded = true
        for c in class_values:
            if c.cfg_group != 0 or c.cfg.len() > 0: guarded = true
        for s in struct_values:
            if s.cfg_group != 0 or s.cfg.len() > 0: guarded = true
        for e in enum_values:
            if e.cfg_group != 0 or e.cfg.len() > 0: guarded = true
        for t in trait_values:
            if t.cfg_group != 0 or t.cfg.len() > 0: guarded = true
        for k in const_values:
            if k.cfg_group != 0 or k.cfg.len() > 0: guarded = true
        for im in module.impls:
            if im.cfg_group != 0 or im.cfg.len() > 0: guarded = true
        if not guarded:
            return module
        val winners = self.cfg_group_winners(fn_values, class_values, struct_values, enum_values,
            trait_values, const_values, module.impls)
        var dropped_fns: Dict<i64, bool> = {}
        var dropped_types: Dict<i64, bool> = {}
        var any_dropped = false
        var fi = 0
        while fi < fn_values.len():
            val f: HirFunction = fn_values[fi]
            if not self.decl_cfg_keep(f.name, f.cfg, f.cfg_group, f.cfg_arm, winners):
                dropped_fns[self.symbol_id_value(f.symbol)] = true
                any_dropped = true
            fi = fi + 1
        var kept_classes: Dict<SymbolId, HirClass> = {}
        var ci = 0
        while ci < class_values.len():
            val c: HirClass = class_values[ci]
            if self.decl_cfg_keep(c.name, c.cfg, c.cfg_group, c.cfg_arm, winners):
                kept_classes[c.symbol] = c
            else:
                dropped_types[self.symbol_id_value(c.symbol)] = true
                any_dropped = true
                for mname, msym in c.methods:
                    dropped_fns[self.symbol_id_value(msym)] = true
            ci = ci + 1
        var kept_structs: Dict<SymbolId, HirStruct> = {}
        var si = 0
        while si < struct_values.len():
            val s: HirStruct = struct_values[si]
            if self.decl_cfg_keep(s.name, s.cfg, s.cfg_group, s.cfg_arm, winners):
                kept_structs[s.symbol] = s
            else:
                dropped_types[self.symbol_id_value(s.symbol)] = true
                any_dropped = true
            si = si + 1
        var kept_enums: Dict<SymbolId, HirEnum> = {}
        var ei = 0
        while ei < enum_values.len():
            val e: HirEnum = enum_values[ei]
            if self.decl_cfg_keep(e.name, e.cfg, e.cfg_group, e.cfg_arm, winners):
                kept_enums[e.symbol] = e
            else:
                dropped_types[self.symbol_id_value(e.symbol)] = true
                any_dropped = true
            ei = ei + 1
        var kept_traits: Dict<SymbolId, HirTrait> = {}
        var ti = 0
        while ti < trait_values.len():
            val t: HirTrait = trait_values[ti]
            if self.decl_cfg_keep(t.name, t.cfg, t.cfg_group, t.cfg_arm, winners):
                kept_traits[t.symbol] = t
            else:
                any_dropped = true
            ti = ti + 1
        var kept_consts: Dict<SymbolId, HirConst> = {}
        var ki = 0
        while ki < const_values.len():
            val k: HirConst = const_values[ki]
            if self.decl_cfg_keep(k.name, k.cfg, k.cfg_group, k.cfg_arm, winners):
                kept_consts[k.symbol] = k
            else:
                any_dropped = true
            ki = ki + 1
        var kept_impls: [HirImpl] = []
        var ii = 0
        while ii < module.impls.len():
            val im: HirImpl = module.impls[ii]
            # An impl of a dropped class/struct/enum goes with its type.
            var impl_type_dropped = false
            match im.type_.kind:
                case Named(impl_type_sym, _):
                    impl_type_dropped = dropped_types.has(self.symbol_id_value(impl_type_sym))
                case _: ()
            if not impl_type_dropped and self.decl_cfg_keep("impl", im.cfg, im.cfg_group, im.cfg_arm, winners):
                kept_impls.push(im)
            else:
                any_dropped = true
                for mname, msym in im.methods:
                    dropped_fns[self.symbol_id_value(msym)] = true
            ii = ii + 1
        if not any_dropped:
            return module
        var kept_fns: Dict<SymbolId, HirFunction> = {}
        var gi = 0
        while gi < fn_values.len():
            val g: HirFunction = fn_values[gi]
            if not dropped_fns.has(self.symbol_id_value(g.symbol)):
                kept_fns[g.symbol] = g
            gi = gi + 1
        var out = module
        out.functions = kept_fns
        out.classes = kept_classes
        out.structs = kept_structs
        out.enums = kept_enums
        out.traits = kept_traits
        out.constants = kept_consts
        out.impls = kept_impls
        out

    me lower_inline_asm_match(arms: [HirAsmMatchArm]) -> LocalId?:
        """Lower target-qualified asm match by resolving against current target.

        Evaluates each arm's target spec against the build target.
        The first matching arm is compiled; all others are discarded.
        """

        # Get current target info from compilation context
        val target_arch = self.get_target_arch()
        val target_os = self.get_target_os()
        val target_abi = self.get_target_abi()
        val target_backend = self.get_target_backend()
        val target_backend_version = self.get_target_backend_version()

        # Collect arm specs for exhaustiveness checking
        var arms_archs: [[text]] = []
        var arms_is_wildcard: [bool] = []
        for arm in arms:
            arms_is_wildcard.push(arm.is_wildcard)
            if arm.has_spec:
                arms_archs.push(arm.spec.archs)
            else:
                arms_archs.push([])

        # Check exhaustiveness - warn if no wildcard
        var has_wildcard = false
        for arm in arms:
            if arm.is_wildcard:
                has_wildcard = true
                break
        if not has_wildcard:
            val all_archs = ["x86_64", "x86", "aarch64", "arm", "riscv32", "riscv64", "wasm32", "wasm64", "avr", "mcs51", "msp430"]
            var covered: [text] = []
            for arm_archs in arms_archs:
                for arch in arm_archs:
                    if arch == "amd64" or arch == "x64":
                        covered.push("x86_64")
                    elif arch == "arm64":
                        covered.push("aarch64")
                    else:
                        covered.push(arch)
            var missing: [text] = []
            for arch in all_archs:
                var found = false
                for covered_arch in covered:
                    if covered_arch == arch:
                        found = true
                        break
                if not found:
                    missing.push(arch)
            if missing.len() > 0:
                val missing_str = missing.join(", ")
                self.error("asm match is non-exhaustive, missing: {missing_str}. Add 'case _: compile_error(\"...\")' for exhaustive matching", nil)

        # Find matching arm
        for arm in arms:
            if arm.is_wildcard:
                # Wildcard matches everything
                if arm.is_compile_error:
                    self.error_fatal(arm.error_message, Some(arm.span))
                    return nil
                if arm.has_asm_body:
                    return self.lower_inline_asm(arm.asm_body)
                return nil

            if arm.has_spec:
                val spec = arm.spec
                val ver_ops: [text] = []
                val ver_vals: [i64] = []
                for vc in spec.version_constraints:
                    ver_ops.push(self.asm_version_constraint_op(vc))
                    ver_vals.push(self.asm_version_constraint_value(vc))

                val result = self.asm_target_spec_match_kind(
                    self.asm_target_spec_archs(spec), self.asm_target_spec_has_os(spec), self.asm_target_spec_os(spec),
                    self.asm_target_spec_has_abi(spec), self.asm_target_spec_abi(spec), self.asm_target_spec_has_backend(spec), self.asm_target_spec_backend(spec),
                    ver_ops, ver_vals,
                    target_arch, target_os, target_abi, target_backend,
                    target_backend_version
                )

                if result == "unknown_version":
                    self.error_fatal("cannot evaluate asm target backend version: {target_backend} version is unavailable", Some(arm.span))
                    return nil

                if result == "matched" or result == "note":
                    if result == "note":
                        self.error("note: target backend differs from recommended version", Some(arm.span))
                    if arm.is_compile_error:
                        self.error_fatal(arm.error_message, Some(arm.span))
                        return nil
                    if arm.has_asm_body:
                        return self.lower_inline_asm(arm.asm_body)
                    return nil

        # No arm matched
        self.error_fatal("no asm match case for target {target_arch}-{target_os}", nil)
        nil

    me lower_asm_assert(spec: AsmTargetSpec, span: Span?):
        """Lower asm assert by checking spec against current target.

        Emits a compile error if the target doesn't match.
        """
        val target_arch = self.get_target_arch()
        val target_os = self.get_target_os()
        val target_abi = self.get_target_abi()
        val target_backend = self.get_target_backend()
        val target_backend_version = self.get_target_backend_version()

        val ver_ops: [text] = []
        val ver_vals: [i64] = []
        for vc in spec.version_constraints:
            ver_ops.push(self.asm_version_constraint_op(vc))
            ver_vals.push(self.asm_version_constraint_value(vc))

        val result = self.asm_target_spec_match_kind(
            self.asm_target_spec_archs(spec), self.asm_target_spec_has_os(spec), self.asm_target_spec_os(spec),
            self.asm_target_spec_has_abi(spec), self.asm_target_spec_abi(spec), self.asm_target_spec_has_backend(spec), self.asm_target_spec_backend(spec),
            ver_ops, ver_vals,
            target_arch, target_os, target_abi, target_backend,
            target_backend_version
        )

        if result == "unknown_version":
            self.error_fatal("cannot evaluate asm target backend version: {target_backend} version is unavailable", span)
        elif result == "not_matched":
            val spec_str = spec.archs.join("|")
            self.error_fatal("asm assert failed: target {target_arch}-{target_os} does not match [{spec_str}]", span)
        elif result == "note":
            self.error("note: target backend differs from recommended version", span)

# ============================================================================
# Target Query
# ============================================================================

    me get_target_arch() -> text:
        """Get current target architecture from compilation context."""
        self.target_context.arch

    me get_target_os() -> text:
        """Get current target OS from compilation context."""
        self.target_context.os

    me get_target_abi() -> text:
        """Get current target ABI from compilation context."""
        self.target_context.abi

    me get_target_backend() -> text:
        """Get current backend from compilation context."""
        self.target_context.backend

    me get_target_backend_version() -> i64:
        """Get current backend version from compilation context."""
        self.target_context.version

# ============================================================================
# Error Handling
# ============================================================================

    me error(message: text, span: Span?):
        """Record a non-fatal lowering diagnostic.

        Fatality for these is still decided downstream by the legacy
        message-text allowlist in 80.driver (`_mir_error_is_fatal`). That
        allowlist is DEPRECATED -- prefer `error_fatal` at any site that must
        abort the build, so the decision lives with the site instead of with
        its wording.
        """
        self.errors = self.errors.push(MirError(message: message, span: span, fatal: false))

    me mir_advisory_level(code: text) -> text:
        """Level of a lowering advisory (`error` | `warning` | `off`), from
        SIMPLE_MIR_VERIFY_LEVELS, resolved once per lowering. A rejected
        (malformed) spec leaves the default `warning`; the driver reports the
        spec itself as an error."""
        if not self.mir_advisory_levels_loaded:
            self.mir_advisory_levels = mir_verify_levels_from_env().levels
            self.mir_advisory_levels_loaded = true
        self.mir_advisory_levels[code] ?? "warning"

    me advisory(code: text, message: text, span: Span?):
        """Record a lowering ADVISORY: a suspicious-but-tolerated state that
        release builds lowered silently.

        Default level `warning`: appended to `self.mir_advisories`, never to
        `self.errors`, so no `errors.len() > 0` route check and no
        `errors_before` comparison inside lowering can observe it. `off`:
        nothing is recorded. `error` (opt-in via
        SIMPLE_MIR_VERIFY_LEVELS="<code>=error"): a real `error_fatal`.
        """
        val level = self.mir_advisory_level(code)
        if level == "off":
            return
        if level == "error":
            self.error_fatal("{code}: {message}", span)
            return
        self.mir_advisories = self.mir_advisories.push(MirError(message: "{code}: {message}", span: span, fatal: false))

    me error_fatal(message: text, span: Span?):
        """Record a lowering error that MUST abort the build before codegen.

        Use this at every site that continues past the error and emits a
        placeholder operand (a const 0/3, a default `MirType.I64`, a dropped
        store, a nil asm body, a -1 enum id). Those placeholders are fail-open:
        without an explicit fatal flag the driver downgrades the error to a
        warning, the build succeeds, and the bogus value reaches codegen.

        Collection semantics are unchanged -- this still only pushes onto
        `self.errors`, so batch diagnostics are preserved and lowering keeps
        going in order to report every error in a single pass.
        """
        self.errors = self.errors.push(MirError(message: message, span: span, fatal: true))
# ============================================================================
# Exports
# ============================================================================

fn cfg_arm_sort_key(arm: i64) -> i64:
    # else arm (cfg_arm == -1) sorts after every numbered arm.
    if arm < 0: 1000000000 else: arm
