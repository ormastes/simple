# Recoverable destination-HIR exception CFG. Frozen block/type/pattern row IDs
# are the only values crossing the HIR/MIR boundary.
use compiler.hir.hir_lowering.hir_destination_registry_reader.*
use compiler.hir.hir_lowering.hir_destination_graph.*
use compiler.mir._MirLowering.hir_destination_receipt.*
use compiler.mir._MirLowering.hir_destination_types.*
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBinOp, BlockId}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir.mir_types.{LocalId, MirType, MirConstValue}

fn destination_exception_type_tag(r: MirDestinationFunctionReceipt,
        type_row: i64) -> i64:
    if type_row < 0: return 0
    val shape = hdr_type_shape(r.slot, r.generation, type_row)
    if shape == HD_TYPE_INT:
        return 100000 + hdr_type_i64(r.slot, r.generation, type_row, 0) * 2 +
            (if hdr_type_bool(r.slot, r.generation, type_row, 0): 1 else: 0)
    if shape == HD_TYPE_FLOAT:
        return 200000 + hdr_type_i64(r.slot, r.generation, type_row, 0)
    if shape == HD_TYPE_BOOL: return 300001
    if shape == HD_TYPE_CHAR: return 300002
    if shape == HD_TYPE_STR: return 300003
    if shape == HD_TYPE_UNIT: return 300004
    if shape == HD_TYPE_NAMED:
        return 1000000000 + hdr_type_i64(r.slot, r.generation, type_row, 0)
    if shape == HD_TYPE_DYN_TRAIT:
        return 2000000000 + hdr_type_i64(r.slot, r.generation, type_row, 0)
    0

impl MirLowering:
    me emit_destination_pending_finally(r: MirDestinationFunctionReceipt):
        val saved = self.destination_finally_blocks
        while self.destination_finally_blocks.len() > 0:
            var pending_builder = self.builder
            if pending_builder.current_block_has_explicit_terminator(): break
            val block = self.destination_finally_blocks.pop()
            self.lower_destination_block(r, block, nil)
        self.destination_finally_blocks = saved

    me lower_destination_catch_body(r: MirDestinationFunctionReceipt,
            clause: i64, payload: LocalId, result: LocalId,
            catch_cleanup: BlockId, cleanup_payload: LocalId,
            cleanup_type_tag: LocalId, outer_unwind: BlockId?,
            outer_payload: LocalId?, outer_type_tag: LocalId?,
            has_finally: bool, finally_block: i64, merge: BlockId):
        var b = self.builder
        b.set_unwind_target(Some(catch_cleanup), Some(cleanup_payload), Some(cleanup_type_tag))
        self.builder = b
        if hdr_aux_bool(r.slot, r.generation, clause, 0):
            val pattern = hdr_aux_i64(r.slot, r.generation, clause, 0)
            if hdr_pattern_shape(r.slot, r.generation, pattern) == HD_PATTERN_BINDING:
                self.bind_local(hdr_pattern_i64(r.slot, r.generation, pattern, 0), payload)
        if has_finally: self.destination_finally_blocks.push(finally_block)
        val catch_value = self.lower_destination_block(r,
            hdr_aux_i64(r.slot, r.generation, clause, 2),
            self.local_mir_type_of(result))
        if has_finally and self.destination_finally_blocks.len() > 0:
            self.destination_finally_blocks.pop()
        b = self.builder
        b.set_unwind_target(outer_unwind, outer_payload, outer_type_tag)
        if not b.current_block_has_explicit_terminator():
            if val value = catch_value: b.emit_copy(result, value)
            if has_finally:
                self.builder = b
                self.lower_destination_block(r, finally_block, nil)
                b = self.builder
        if not b.current_block_has_explicit_terminator(): b.terminate_goto(merge)
        self.builder = b

    me lower_destination_try_catch(r: MirDestinationFunctionReceipt,
            row: i64, type_: MirType) -> LocalId:
        var b = self.builder
        val catch_dispatch = b.new_block(Some("destination_catch_dispatch"))
        val normal_finally = b.new_block(Some("destination_try_normal_finally"))
        val catch_cleanup = b.new_block(Some("destination_catch_cleanup"))
        val merge = b.new_block(Some("destination_try_merge"))
        val payload = b.new_temp(MirType.i64())
        val caught_type_tag = b.new_temp(MirType.i64())
        val cleanup_payload = b.new_temp(MirType.i64())
        val cleanup_type_tag = b.new_temp(MirType.i64())
        val result = b.new_temp(type_)
        val outer_unwind = b.unwind_target
        val outer_payload = b.unwind_payload
        val outer_type_tag = b.unwind_type_tag
        val has_finally = hdr_expr_bool(r.slot, r.generation, row, 0)
        val finally_block = hdr_expr_i64(r.slot, r.generation, row, 1)
        b.set_unwind_target(Some(catch_dispatch), Some(payload), Some(caught_type_tag))
        self.builder = b
        if has_finally: self.destination_finally_blocks.push(finally_block)
        val body_value = self.lower_destination_block(r,
            hdr_expr_i64(r.slot, r.generation, row, 0), Some(type_))
        if has_finally and self.destination_finally_blocks.len() > 0:
            self.destination_finally_blocks.pop()
        b = self.builder
        b.set_unwind_target(outer_unwind, outer_payload, outer_type_tag)
        if not b.current_block_has_explicit_terminator():
            if val value = body_value: b.emit_copy(result, value)
            b.terminate_goto(normal_finally)
        b.switch_to_block(normal_finally)
        self.builder = b
        if has_finally: self.lower_destination_block(r, finally_block, nil)
        b = self.builder
        if not b.current_block_has_explicit_terminator(): b.terminate_goto(merge)

        b.switch_to_block(catch_dispatch)
        self.builder = b
        val clauses = hdr_expr_range(r.slot, r.generation, row, false)
        val subtype = hdr_range_subtype(r.slot, r.generation, clauses)
        val count = hdr_range_length(r.slot, r.generation, clauses)
        var offset = 0
        var catch_all = false
        while offset < count:
            val clause = hdr_range_value(r.slot, r.generation, clauses, subtype, offset)
            if hdr_aux_bool(r.slot, r.generation, clause, 0):
                val pattern_shape = hdr_pattern_shape(r.slot, r.generation,
                    hdr_aux_i64(r.slot, r.generation, clause, 0))
                if pattern_shape != HD_PATTERN_WILDCARD and pattern_shape != HD_PATTERN_BINDING:
                    self.error_fatal("E-MIR-DESTINATION-CATCH: only wildcard and binding catch patterns have exact recoverable MIR semantics", nil)
                    return LocalId(id: -1)
            var condition = b.emit_const_bool(true)
            if hdr_aux_bool(r.slot, r.generation, clause, 1):
                val tag = destination_exception_type_tag(r,
                    hdr_aux_i64(r.slot, r.generation, clause, 1))
                if tag == 0:
                    self.error_fatal("E-MIR-DESTINATION-CATCH: typed catch has no collision-free runtime tag", nil)
                    return LocalId(id: -1)
                condition = b.emit_binop(MirBinOp.Eq, mir_operand_copy(caught_type_tag),
                    mir_operand_const_int(tag), MirType.bool())
            elif not hdr_aux_bool(r.slot, r.generation, clause, 0):
                catch_all = true
            val arm = b.new_block(Some("destination_catch_arm"))
            val next = b.new_block(Some("destination_catch_next"))
            b.terminate_if(mir_operand_copy(condition), arm, next)
            b.switch_to_block(arm)
            self.builder = b
            self.lower_destination_catch_body(r, clause, payload, result,
                catch_cleanup, cleanup_payload, cleanup_type_tag,
                outer_unwind, outer_payload, outer_type_tag,
                has_finally, finally_block, merge)
            b = self.builder
            b.switch_to_block(next)
            self.builder = b
            offset = offset + 1
            if catch_all: break

        if not catch_all:
            if has_finally:
                self.lower_destination_block(r, finally_block, nil)
                b = self.builder
            if not b.current_block_has_explicit_terminator():
                if outer_unwind.? and outer_payload.?:
                    b.emit_copy(outer_payload.unwrap(), payload)
                    if outer_type_tag.?: b.emit_copy(outer_type_tag.unwrap(), caught_type_tag)
                    b.terminate_goto(outer_unwind.unwrap())
                else:
                    b.terminate_resume(mir_operand_move(payload), mir_operand_copy(caught_type_tag))

        b.switch_to_block(catch_cleanup)
        b.set_unwind_target(outer_unwind, outer_payload, outer_type_tag)
        self.builder = b
        if has_finally: self.lower_destination_block(r, finally_block, nil)
        b = self.builder
        if not b.current_block_has_explicit_terminator():
            if outer_unwind.? and outer_payload.?:
                b.emit_copy(outer_payload.unwrap(), cleanup_payload)
                if outer_type_tag.?: b.emit_copy(outer_type_tag.unwrap(), cleanup_type_tag)
                b.terminate_goto(outer_unwind.unwrap())
            else:
                b.terminate_resume(mir_operand_move(cleanup_payload),
                    mir_operand_copy(cleanup_type_tag))
        b.switch_to_block(merge)
        b.set_unwind_target(outer_unwind, outer_payload, outer_type_tag)
        self.builder = b
        result

export destination_exception_type_tag
