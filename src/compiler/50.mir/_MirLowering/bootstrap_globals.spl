# Part of src/compiler/50.mir/mir_lowering.spl: bootstrap HIR-globals-to-MIR-module lowering helpers
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.function_lowering.*
use compiler.mir._MirLowering.asm_and_targets.*
use compiler.mir._MirLowering.bootstrap_type_registration.{bootstrap_type_registry_reset, bootstrap_register_flat_type_defs, bootstrap_register_flat_class_defs, bootstrap_register_hir_type_defs}
# MIR Lowering - HIR to MIR Transformation
#
# This module handles lowering from HIR (High-level IR) to MIR (Mid-level IR).
# It converts:
# - Nested expressions to SSA form
# - Control flow to basic blocks
# - Memory operations to explicit loads/stores
# - Type system from HIR to MIR representation
#
# Split into:
# - mir_lowering_types.spl: Struct definitions (MirLowering, MirError)
# - mir_lowering.spl: Core coordinator, module/function/type lowering, asm/target (this file)
# - mir_lowering_expr.spl: Expression lowering, operators, calls, literals
# - mir_lowering_stmts.spl: Statement lowering, control flow (if/loop/for)
# - mir_lowering_ml.spl: ML blocks, async/await, custom blocks

use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirModule, MirFunction, mir_operand_const_int}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.items.{bootstrap_hir_module_count, bootstrap_hir_entry_index, bootstrap_hir_module_name_at, bootstrap_hir_module_symbol_count, bootstrap_hir_module_symbol_at, bootstrap_hir_module_function_count, bootstrap_hir_module_function_at, bootstrap_hir_module_constant_count, bootstrap_hir_module_constant_at}
use compiler.frontend.flat_ast_bridge.{flat_bootstrap_function_count, flat_bootstrap_function_at}
use std.nogc_sync_mut.io.process_ops.{eprint}
extern fn rt_exit(code: i64)
extern fn rt_string_len(value: text) -> i64

fn bootstrap_report_recorded_mir_errors(lowering: MirLowering, context: text):
    """Surface MIR errors recorded while lowering FUNCTION BODIES.

    Silent-swallow (bootstrap_stage2_empty_mir_bodies_2026-07-05, 2026-08-24):
    `bootstrap_reject_fatal_mir_errors` runs BEFORE the function loop, and the
    0-instruction guard below exits after it, with no rejection call in
    between. So a `self.error(...)` raised while lowering a body was recorded
    into `lowering.errors` and NEVER printed -- the build died saying only
    "0 MIR instructions", with the actual reason sitting unread in memory.
    Every defect on this path was undiagnosable for that reason alone.

    Called on the fatal path only, so it is unconditional rather than
    level-gated: the process is about to `rt_exit(1)` and there is no such
    thing as noise in a death message. Non-fatal entries are printed too --
    on this path a recorded non-fatal error IS the diagnosis.

    The `0 errors recorded` line is load-bearing, not filler: it distinguishes
    "a handler ran and bailed via a recorded error" from "no handler ever ran",
    which is exactly the question the 0-instruction guard cannot answer by
    itself."""
    var count = 0
    for err in lowering.errors:
        count = count + 1
        val kind = if err.fatal: "fatal" else: "non-fatal"
        eprint("error: bootstrap MIR lowering ({context}, {kind}): {err.message}\n")
    if count == 0:
        eprint("note: bootstrap MIR lowering ({context}): 0 errors recorded\n")

fn bootstrap_reject_fatal_mir_errors(lowering: MirLowering) -> bool:
    var rejected = false
    for err in lowering.errors:
        if err.fatal:
            rejected = true
            eprint("error: bootstrap MIR lowering: {err.message}\n")
    rejected
use compiler.common.diagnostics.span.{Span}
use compiler.blocks.value.BlockValue
use compiler.types.type_layout.{compute_struct_layout, layoutattr_default_, FieldLayout}
use compiler.core.types.{TYPE_BOOL, TYPE_I64, TYPE_F64}
use compiler.mir.synthetic_driver_codegen.{apply_synthetic_driver_codegen}
use compiler.mir_opt.mir_opt.var_reassign_ssa.{ssa_alloca_transform_blocks}
use compiler.frontend.core.types.{custom_primitive_underlying_type_tag_by_symbol}
use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from}
use compiler.common.module_path_naming.{module_logical_name_from_path}

# Import struct definitions from types module
use compiler.mir.mir_lowering_types.{MirLowering, MirError}

# Import split modules so their impl blocks are linked
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*
use compiler.mir._MirLoweringExpr.method_calls_literals.*
use compiler.mir.mir_lowering_stmts.*
use compiler.mir.mir_lowering_ml.*
use compiler.mir.mir_types.{MirType}
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection

fn _mir_text_index_of(value: text, needle: text) -> i64:
    if needle == "":
        return 0
    if not value.contains(needle):
        return -1
    rt_string_len(value.split(needle)[0])

fn bootstrap_mir_logical_module_name(path: text) -> text:
    # Delegates to the single shared derivation in 00.common — see
    # module_path_naming.spl for history (this used to be one of four
    # hand-duplicated copies; a 70a29867bc2 drift between copies broke the
    # whole native-smoke-matrix 0/19).
    module_logical_name_from_path(path)

fn bootstrap_hir_function_symbol_name(module: HirModule, func: HirFunction) -> text:
    if func.is_method:
        return module.symbols.symbol_display_name(func.symbol, func.name).replace("::", ".")
    func.name

fn bootstrap_hir_accumulator_name(module: HirModule, func: HirFunction) -> text:
    val name = bootstrap_hir_function_symbol_name(module, func)
    if func.is_method:
        return name
    "{bootstrap_mir_logical_module_name(module.name)}.{name}"

var _bootstrap_mir_functions: [MirFunction] = []
var _bootstrap_mir_function_names: [text] = []
var _bootstrap_mir_function_modules: [i64] = []
var _bootstrap_mir_function_return_type_tags: [i64] = []
var _bootstrap_mir_function_return_unsigned: [bool] = []
var _bootstrap_mir_function_param_starts: [i64] = []
var _bootstrap_mir_function_param_counts: [i64] = []
var _bootstrap_mir_function_param_type_tags: [i64] = []
var _bootstrap_mir_module_count_value: i64 = 0
var _bootstrap_mir_static_modules: [i64] = []
var _bootstrap_mir_static_symbol_ids: [i64] = []
var _bootstrap_mir_static_names: [text] = []
var _bootstrap_mir_static_type_tags: [i64] = []
var _bootstrap_mir_static_init_kinds: [i64] = []
var _bootstrap_mir_static_init_payloads: [text] = []
var _bootstrap_function_value_names: [text] = []

fn bootstrap_function_value_names_reset():
    _bootstrap_function_value_names = []

fn bootstrap_register_function_value_module(module: HirModule):
    val module_name = bootstrap_mir_logical_module_name(module.name)
    for func in module.functions.values():
        val function_name = bootstrap_hir_function_symbol_name(module, func)
        _bootstrap_function_value_names.push(function_name)
        if not func.is_method:
            _bootstrap_function_value_names.push("{module_name}.{function_name}")

fn bootstrap_register_fn_ret_types_module(module: HirModule):
    """Pre-register Str-returning functions' return types under every call-site
    spelling (bare, symbol, module-qualified) BEFORE any module lowers.

    The per-module registration inside the lowering loops fires too late for
    the entry module's cross-module calls: the entry lowers FIRST
    (driver_bootstrap line ~128) while helper modules register during the
    extras loop afterwards — so `LB() + RB()` in an entry fn saw i64-typed
    dests and lowered to INTEGER ADDITION of two char* pointers (SIGSEGV in
    strlen; W96/W97, native_call_return_type_loss 2026-07-23). Str-only, same
    rationale as the in-loop registration."""
    val module_name = bootstrap_mir_logical_module_name(module.name)
    for func in module.functions.values():
        match func.return_type.kind:
            case HirTypeKind.Str:
                val str_ty = MirType(kind: MirTypeKind.Tuple([
                    MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.U8), false)),
                    MirType(kind: MirTypeKind.U64)
                ]))
                val function_name = bootstrap_hir_function_symbol_name(module, func)
                bootstrap_fn_ret_type_register(func.name, str_ty)
                bootstrap_fn_ret_type_register(function_name, str_ty)
                if not func.is_method:
                    bootstrap_fn_ret_type_register("{module_name}.{function_name}", str_ty)
                    bootstrap_fn_ret_type_register(bootstrap_hir_accumulator_name(module, func), str_ty)
            case _: ()

# NOTE: bootstrap_fn_ret_type_* registry is deliberately NOT reset here —
# lower_module's bootstrap branch resets the function accumulator per module,
# but the return-type registry must accumulate across ALL closure modules
# (cross-module call sites need the callee module's declared types). The
# native-build worker is one process per build, so no reset is needed at all.
fn bootstrap_mir_functions_reset():
    _bootstrap_mir_functions = []
    _bootstrap_mir_function_names = []
    _bootstrap_mir_function_modules = []
    _bootstrap_mir_function_return_type_tags = []
    _bootstrap_mir_function_return_unsigned = []
    _bootstrap_mir_function_param_starts = []
    _bootstrap_mir_function_param_counts = []
    _bootstrap_mir_function_param_type_tags = []
    _bootstrap_mir_module_count_value = 0
    _bootstrap_mir_static_modules = []
    _bootstrap_mir_static_symbol_ids = []
    _bootstrap_mir_static_names = []
    _bootstrap_mir_static_type_tags = []
    _bootstrap_mir_static_init_kinds = []
    _bootstrap_mir_static_init_payloads = []

fn bootstrap_mir_functions_add(name: text, fn_: MirFunction, module_index: i64):
    val return_type_tag = bootstrap_mir_static_type_tag(fn_.signature.return_type)
    val return_unsigned = bootstrap_mir_return_type_unsigned(fn_.signature.return_type)
    val param_start = _bootstrap_mir_function_param_type_tags.len()
    val param_count = fn_.signature.params.len()
    # Accumulate param tags in a LOCAL, then reassign the module global ONCE
    # at straight-line level. The seed rejects `global = global.push(...)`
    # INSIDE a loop body ("cannot reassign to immutable variable",
    # rMCP19/20) but accepts it straight-line (see the names/functions
    # reassigns below, unchanged from the original). Reassign is REQUIRED —
    # bare `.push()` on a module global silently drops elements (81 of 842),
    # desyncing the parallel accumulator arrays (rMCP17 OOB 761/761).
    var jn_param_tags = _bootstrap_mir_function_param_type_tags
    var jn_param_i = 0
    while jn_param_i < fn_.signature.params.len():
        jn_param_tags = jn_param_tags.push(bootstrap_mir_static_type_tag(fn_.signature.params[jn_param_i]))
        jn_param_i = jn_param_i + 1
    _bootstrap_mir_function_param_type_tags = jn_param_tags
    _bootstrap_mir_function_return_type_tags = _bootstrap_mir_function_return_type_tags.push(return_type_tag)
    _bootstrap_mir_function_return_unsigned = _bootstrap_mir_function_return_unsigned.push(return_unsigned)
    _bootstrap_mir_function_param_starts = _bootstrap_mir_function_param_starts.push(param_start)
    _bootstrap_mir_function_param_counts = _bootstrap_mir_function_param_counts.push(param_count)
    var stored_fn = fn_
    val rewritten = ssa_alloca_transform_blocks(fn_.blocks, fn_.locals, fn_.entry_block)
    if rewritten.applied:
        stored_fn.blocks = rewritten.blocks
    _bootstrap_mir_function_names = _bootstrap_mir_function_names.push(name)
    _bootstrap_mir_functions = _bootstrap_mir_functions.push(stored_fn)
    _bootstrap_mir_function_modules = _bootstrap_mir_function_modules.push(module_index)

fn bootstrap_mir_static_type_tag(type_: MirType) -> i64:
    match type_.kind:
        case MirTypeKind.I64 | MirTypeKind.U64 | MirTypeKind.Result(_, _): 1
        case MirTypeKind.I32 | MirTypeKind.U32 | MirTypeKind.Char: 2
        case MirTypeKind.I16 | MirTypeKind.U16: 3
        case MirTypeKind.I8 | MirTypeKind.U8: 4
        case MirTypeKind.F64: 5
        case MirTypeKind.F32: 6
        case MirTypeKind.Bool: 7
        case MirTypeKind.Unit | MirTypeKind.Never: 8
        case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, _) | MirTypeKind.FuncPtr(_) | MirTypeKind.Function(_, _) | MirTypeKind.Opaque(_): 9
        case MirTypeKind.Struct(_) | MirTypeKind.Enum(_) | MirTypeKind.Tuple(_) | MirTypeKind.Array(_, _) | MirTypeKind.Dict(_, _) | MirTypeKind.Slice(_) | MirTypeKind.Union(_): 9
        case MirTypeKind.Promise(_) | MirTypeKind.Generator(_, _) | MirTypeKind.ActorType(_): 9
        case _: 0

fn bootstrap_mir_return_type_unsigned(type_: MirType) -> bool:
    match type_.kind:
        case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: true
        case _: false

fn bootstrap_mir_static_init_kind(value: MirConstValue) -> i64:
    match value:
        case Str(_): 2
        case _: 1

fn bootstrap_mir_static_init_payload(value: MirConstValue) -> text:
    match value:
        case Int(v): "{v}"
        case Float(v): "{v}"
        case Bool(v): if v: "1" else: "0"
        case Str(v): v
        case Zero: "0"
        case Array(_): "zeroinitializer"
        case Tuple(_): "zeroinitializer"
        case Struct(_): "zeroinitializer"

fn bootstrap_mir_modules_add(module: MirModule):
    val module_index = _bootstrap_mir_module_count_value
    # Accumulate into LOCALS inside the loop, reassign each module global
    # ONCE at straight-line level after — same seed reassign-in-loop rule +
    # bare-push element-drop rationale as bootstrap_mir_functions_add above.
    var bs_modules = _bootstrap_mir_static_modules
    var bs_symbol_ids = _bootstrap_mir_static_symbol_ids
    var bs_names = _bootstrap_mir_static_names
    var bs_type_tags = _bootstrap_mir_static_type_tags
    var bs_init_kinds = _bootstrap_mir_static_init_kinds
    var bs_init_payloads = _bootstrap_mir_static_init_payloads
    val bs_static_vals = module.statics.values()
    var bs_si = 0
    while bs_si < bs_static_vals.len():
        val static_ = bs_static_vals[bs_si]
        var init_kind = 0
        var init_payload = ""
        match static_.init:
            case Some(init):
                if init == nil:
                    eprint("bootstrap MIR static initializer is nil\n")
                    rt_exit(1)
                else:
                    init_kind = bootstrap_mir_static_init_kind(init.value)
                    init_payload = bootstrap_mir_static_init_payload(init.value)
            case nil:
                ()
        bs_modules = bs_modules.push(module_index)
        bs_symbol_ids = bs_symbol_ids.push(static_.symbol.id)
        bs_names = bs_names.push(static_.name)
        bs_type_tags = bs_type_tags.push(bootstrap_mir_static_type_tag(static_.type_))
        bs_init_kinds = bs_init_kinds.push(init_kind)
        bs_init_payloads = bs_init_payloads.push(init_payload)
        bs_si = bs_si + 1
    _bootstrap_mir_static_modules = bs_modules
    _bootstrap_mir_static_symbol_ids = bs_symbol_ids
    _bootstrap_mir_static_names = bs_names
    _bootstrap_mir_static_type_tags = bs_type_tags
    _bootstrap_mir_static_init_kinds = bs_init_kinds
    _bootstrap_mir_static_init_payloads = bs_init_payloads
    _bootstrap_mir_module_count_value = module_index + 1

# The real HIR module for the bootstrap entry, set by the driver
# (bootstrap_lower_to_mir_context) from ctx.hir_modules before MIR lowering.
# Carrying it through a module global avoids changing the no-arg signature of
# bootstrap_lower_hir_globals_to_mir_module (called from several sites). When
# nil, the free path lowers to nothing and the loud guard fires.
var _bootstrap_entry_hir_module: HirModule? = nil

fn bootstrap_set_entry_hir_module(m: HirModule):
    bootstrap_type_registry_reset()
    _bootstrap_entry_hir_module = Some(m)

fn bootstrap_clear_entry_hir_module():
    _bootstrap_entry_hir_module = nil

fn bootstrap_flat_symbol_table(module_index: i64) -> SymbolTable:
    var table = SymbolTable.new()
    var symbol_index = 0
    while symbol_index < bootstrap_hir_module_symbol_count(module_index):
        val symbol = bootstrap_hir_module_symbol_at(module_index, symbol_index)
        table.symbols[symbol.id.id] = symbol
        symbol_index = symbol_index + 1
    table

fn bootstrap_flat_function_symbol_name(symbols: SymbolTable, func: HirFunction) -> text:
    # Static methods (is_static, is_method may be false) must emit under their
    # qualified `Type.method` symbol name too — same as instance methods — so the
    # body matches symbol_to_operand at the call site (which reads the symbol's
    # renamed .name). Without this a static method emits as a bare, collision-prone
    # `method` and mismatches the call.
    if func.is_method or func.is_static:
        return symbols.symbol_display_name(func.symbol, func.name).replace("::", ".")
    func.name

fn bootstrap_register_flat_function_values():
    var module_index = 0
    while module_index < bootstrap_hir_module_count():
        val module_name = bootstrap_mir_logical_module_name(bootstrap_hir_module_name_at(module_index))
        val symbols = bootstrap_flat_symbol_table(module_index)
        var function_index = 0
        while function_index < bootstrap_hir_module_function_count(module_index):
            val func = bootstrap_hir_module_function_at(module_index, function_index)
            val function_name = bootstrap_flat_function_symbol_name(symbols, func)
            _bootstrap_function_value_names.push(function_name)
            if not func.is_method:
                _bootstrap_function_value_names.push("{module_name}.{function_name}")
                # Cross-module declared HIR return types (name-keyed; see
                # bootstrap_fn_ret_hir_type_register in mir_data.spl).
                bootstrap_fn_ret_hir_type_register(func.name, func.return_type)
            function_index = function_index + 1
        module_index = module_index + 1

fn bootstrap_lower_flat_hir_module_to_mir(module_index: i64, target_context: MirTargetContext, is_entry: bool) -> (MirModule, i64):
    val module_name = bootstrap_hir_module_name_at(module_index)
    val logical_module_name = bootstrap_mir_logical_module_name(module_name)
    val symbols = bootstrap_flat_symbol_table(module_index)
    var constants: [HirConst] = []
    var constant_index = 0
    while constant_index < bootstrap_hir_module_constant_count(module_index):
        constants = constants.push(bootstrap_hir_module_constant_at(module_index, constant_index))
        constant_index = constant_index + 1
    var lowering = MirLowering.new_for_target(symbols, target_context)
    lowering.current_function_names = _bootstrap_function_value_names
    # Register this module's own enum/struct type defs so `E.V` reclassifies to
    # an enum-variant const (not a field-load on an undefined base) and `S(..)`
    # reclassifies to an inline aggregate construct (not a call to an undefined
    # `@S` ctor). The reduced flat store now carries these; the globals/extra
    # lowering paths use bootstrap_register_hir_type_defs for the same purpose.
    lowering = bootstrap_register_flat_type_defs(lowering, module_index)
    # Register class field layout so class construction lowers inline instead of
    # calling an undefined `@C` ctor. (Class method resolution is a follow-up that
    # also needs the method bodies lowered into the flat function stream.)
    lowering = bootstrap_register_flat_class_defs(lowering, module_index)
    for const_ in constants:
        lowering.lower_const(const_)
        lowering.lower_static(const_)
    if bootstrap_reject_fatal_mir_errors(lowering):
        rt_exit(1)
    val mir_module_index = _bootstrap_mir_module_count_value
    lowering.lower_runtime_module_initializers_named(module_name, constants, mir_module_index)

    var lowered_module = lowering.builder.module
    lowered_module.name = module_name

    # Order-independent struct_field_type_name pre-pass.
    #
    # `lower_module` (mir/_MirLowering/module_lowering.spl) runs exactly this
    # walk before it lowers any function, precisely so a chained nested field
    # access does not depend on which function happens to be lowered first.
    # The BOOTSTRAP-FLAT path below never goes through `lower_module`, so it
    # never got that pre-pass: `struct_field_type_name` was populated only as a
    # side effect of lowering each construction site in stream order.
    #
    # Consequence when the constructing function is lowered AFTER its consumer
    # (measured on `SIMPLE_BOOTSTRAP=1 native-build --entry-closure`, the path
    # Stage 2/3 use): `n.inner` has no registered struct name, so
    # `resolve_field_index` (function_lowering.spl) hits its
    # "type cannot be determined" tier and returns 0. `n.inner.b` then reads
    # field 0 and yields `inner.a`'s value -- a silent wrong answer with no
    # diagnostic and exit 0. Seeding the map here makes the result independent
    # of function order, exactly as the non-flat path already is.
    val function_count = bootstrap_hir_module_function_count(module_index)
    # Level-gated (default OFF), retained per the log-retention policy.
    val flat_prescan_trace = mir_trace_enabled()
    if flat_prescan_trace:
        eprint("[mir-flat-prescan-module] start index={module_index} module={module_name} functions={function_count}")
    var flat_prescan_index = 0
    while flat_prescan_index < function_count:
        val prescan_fn = bootstrap_hir_module_function_at(module_index, flat_prescan_index)
        if flat_prescan_trace:
            eprint("[mir-flat-prescan-function] start module={module_name} index={flat_prescan_index} name={prescan_fn.name}")
        if not prescan_fn.is_extern:
            lowering.prescan_block_for_struct_types(prescan_fn.body)
        if flat_prescan_trace:
            eprint("[mir-flat-prescan-function] done module={module_name} index={flat_prescan_index} name={prescan_fn.name}")
        flat_prescan_index = flat_prescan_index + 1
    if flat_prescan_trace:
        eprint("[mir-flat-prescan-module] done index={module_index} module={module_name}")

    var instruction_total = 0
    var function_index = 0
    while function_index < function_count:
        val hir_fn = bootstrap_hir_module_function_at(module_index, function_index)
        if hir_fn.is_extern:
            function_index = function_index + 1
            continue
        val function_name = bootstrap_flat_function_symbol_name(symbols, hir_fn)
        # is_static methods already carry a qualified `Type.method` function_name
        # (see bootstrap_flat_function_symbol_name) — don't module-prefix them.
        val emitted_name = if is_entry or hir_fn.is_method or hir_fn.is_static:
            function_name
        else:
            "{logical_module_name}.{function_name}"
        lowering.symbols = symbols
        val mir_fn = lowering.lower_function(hir_fn)
        bootstrap_mir_functions_add(emitted_name, mir_fn, mir_module_index)
        for block in mir_fn.blocks:
            instruction_total = instruction_total + block.instructions.len()
        var builder = lowering.builder
        lowered_module = builder.module
        lowered_module.name = module_name
        function_index = function_index + 1
        var lowered_functions = lowered_module.functions
        lowered_functions[mir_fn.symbol] = mir_fn
        lowered_module.functions = lowered_functions
        builder.module = lowered_module
        lowering.builder = builder

    lowered_module = lowering.builder.module
    lowered_module.name = module_name
    bootstrap_mir_modules_add(lowered_module)
    # Silent-swallow fix: the caller's 0-instruction guard exits without ever
    # seeing `lowering.errors`, which only exists here. Report before returning
    # so the death message carries its reason. See the helper's docstring.
    if is_entry and instruction_total == 0:
        bootstrap_report_recorded_mir_errors(lowering, "flat entry")
    (lowered_module, instruction_total)

fn bootstrap_lower_flat_hir_modules_to_mir_for_target(entry_module_name: text, target_context: MirTargetContext) -> MirModule:
    bootstrap_mir_functions_reset()
    bootstrap_function_value_names_reset()
    bootstrap_register_flat_function_values()
    val entry_index = bootstrap_hir_entry_index()
    var module_index = 0
    if entry_index < 0:
        eprint("error: bootstrap flat HIR entry module was not captured: {entry_module_name}\n")
        rt_exit(1)

    val entry_function_count = bootstrap_hir_module_function_count(entry_index)
    eprint("[bootstrap-flat-entry] index={entry_index} modules={bootstrap_hir_module_count()} functions={entry_function_count}\n")

    val (entry_module, entry_instruction_total) = bootstrap_lower_flat_hir_module_to_mir(entry_index, target_context, true)
    if entry_instruction_total == 0:
        eprint("error: bootstrap entry lowered to 0 MIR instructions (ret-0 stub module)\n")
        rt_exit(1)
    module_index = 0
    while module_index < bootstrap_hir_module_count():
        if module_index != entry_index:
            val _extra_result = bootstrap_lower_flat_hir_module_to_mir(module_index, target_context, false)
        module_index = module_index + 1
    entry_module

fn bootstrap_mir_function_count() -> i64:
    _bootstrap_mir_functions.len()

fn bootstrap_mir_function_at(index: i64) -> MirFunction:
    _bootstrap_mir_functions[index]

fn bootstrap_mir_function_name_at(index: i64) -> text:
    _bootstrap_mir_function_names[index]

fn bootstrap_mir_accumulator_lens_diag():
    print "[acc-lens] fns={_bootstrap_mir_functions.len()} names={_bootstrap_mir_function_names.len()} modules={_bootstrap_mir_function_modules.len()} ret_tags={_bootstrap_mir_function_return_type_tags.len()} ret_unsigned={_bootstrap_mir_function_return_unsigned.len()} p_starts={_bootstrap_mir_function_param_starts.len()} p_counts={_bootstrap_mir_function_param_counts.len()} p_tags={_bootstrap_mir_function_param_type_tags.len()} statics={_bootstrap_mir_static_names.len()}"

fn bootstrap_mir_function_module_at(index: i64) -> i64:
    _bootstrap_mir_function_modules[index]

fn bootstrap_mir_function_return_type_tag_at(index: i64) -> i64:
    _bootstrap_mir_function_return_type_tags[index]

fn bootstrap_mir_function_return_unsigned_at(index: i64) -> bool:
    _bootstrap_mir_function_return_unsigned[index]

fn bootstrap_mir_function_param_count_at(index: i64) -> i64:
    _bootstrap_mir_function_param_counts[index]

fn bootstrap_mir_function_param_type_tag_at(function_index: i64, param_index: i64) -> i64:
    _bootstrap_mir_function_param_type_tags[_bootstrap_mir_function_param_starts[function_index] + param_index]

fn bootstrap_mir_static_count() -> i64:
    _bootstrap_mir_static_names.len()

fn bootstrap_mir_static_module_at(index: i64) -> i64:
    _bootstrap_mir_static_modules[index]

fn bootstrap_mir_static_symbol_id_at(index: i64) -> i64:
    _bootstrap_mir_static_symbol_ids[index]

fn bootstrap_mir_static_name_at(index: i64) -> text:
    _bootstrap_mir_static_names[index]

fn bootstrap_mir_static_type_tag_at(index: i64) -> i64:
    _bootstrap_mir_static_type_tags[index]

fn bootstrap_mir_static_init_kind_at(index: i64) -> i64:
    _bootstrap_mir_static_init_kinds[index]

fn bootstrap_mir_static_init_payload_at(index: i64) -> text:
    _bootstrap_mir_static_init_payloads[index]

fn bootstrap_mir_symbol_for_index(index: i64) -> SymbolId:
    if index == 0:
        return SymbolId(id: 1)
    if index == 1:
        return SymbolId(id: 2)
    if index == 2:
        return SymbolId(id: 3)
    if index == 3:
        return SymbolId(id: 4)
    if index == 4:
        return SymbolId(id: 5)
    if index == 5:
        return SymbolId(id: 6)
    if index == 6:
        return SymbolId(id: 8)
    SymbolId(id: 100)

fn bootstrap_mir_name_for_index(index: i64) -> text:
    if index == 0:
        return "bootstrap_version"
    if index == 1:
        return "native_build_help"
    if index == 2:
        return "compile_result_exit"
    if index == 3:
        return "run_native_build_bootstrap"
    if index == 4:
        return "get_cli_args"
    if index == 5:
        return "main"
    if index == 6:
        return "rt_native_build"
    ""

fn bootstrap_lower_hir_globals_to_mir_module() -> MirModule:
    val target_context = mir_target_context_from("", "unknown", "unknown", "llvm", -1)
    bootstrap_lower_hir_globals_to_mir_module_for_target(target_context)

fn bootstrap_lower_hir_globals_to_mir_module_for_target(target_context: MirTargetContext) -> MirModule:
    """Lower the bootstrap entry to MIR with REAL function bodies.

    The real HIR module for the entry is produced by the driver's HIR phase
    (lower_and_check -> HirLowering.lower_module over the freshly-parsed
    Module.functions) and handed here through _bootstrap_entry_hir_module. Each
    HIR function is lowered to MIR via MirLowering.lower_function.

    A prior implementation emitted ret-0 stub bodies here
    (lower_bootstrap_stub_function), so the linked stage-2 binary printed
    nothing on `--version` (bug bootstrap_stage2_empty_mir_bodies_2026-07-05)."""
    val trace_enabled = mir_lower_trace_enabled()
    if trace_enabled:
        print "[mir-lower-free] start"
    bootstrap_mir_functions_reset()
    var real_instr_total = 0
    # Seed-compiled `if val` can enter the Some arm while binding a nil payload.
    # Check the option explicitly before extracting the module used below.
    if _bootstrap_entry_hir_module.?:
        val hir_module: HirModule = _bootstrap_entry_hir_module.unwrap()
        # `.?` above is not a liveness proof: it has been measured entering the
        # Some arm while binding a nil payload in Stage-2-compiled code (the
        # same predicate-misread class as `is_empty()` returning false on an
        # empty list, c018ee15926). Dereferencing `hir_module` on the next line
        # then SIGSEGVs with `[mir-lower-free] start` as the last output --
        # which is exactly how a lost module set was reported as a MIR bug.
        # Check the payload explicitly and fail closed, loudly.
        if hir_module == nil:
            print "error[E-MIR-BOOTSTRAP-ENTRY-NIL]: the bootstrap entry HIR module is nil at MIR lowering -- the HIR phase produced no entry module (upstream: the phase-2 module set was lost before phase 3). Refusing to lower an empty program."
            rt_exit(1)
        var lowering = MirLowering.new_for_target(hir_module.symbols, target_context)
        lowering = bootstrap_register_hir_type_defs(lowering, hir_module)
        val entry_functions = hir_module.functions
        val fn_keys = entry_functions.keys()
        var function_names: [text] = []
        for func in entry_functions.values():
            function_names.push(bootstrap_hir_function_symbol_name(hir_module, func))
            # Declared-return-type registry (native_call_return_type_loss
            # 2026-07-23): bare + qualified spellings, cross-module global.
            # Register ONLY Str returns — for other kinds the HIR-side
            # builtin-table fallback yields a degraded Int type that would
            # SHADOW the more accurate MIR-side bootstrap_call_return_type
            # table (e.g. get_args -> ptr(Array(str)); W93 regression).
            match func.return_type.kind:
                case HirTypeKind.Str:
                    val bg_ret_ty = lowering.lower_type(func.return_type)
                    bootstrap_fn_ret_type_register(func.name, bg_ret_ty)
                    bootstrap_fn_ret_type_register(bootstrap_hir_function_symbol_name(hir_module, func), bg_ret_ty)
                case _: ()
        for function_name in _bootstrap_function_value_names:
            function_names.push(function_name)
        lowering.current_function_names = function_names
        val const_vals = hir_module.constants.values()
        val module_index = _bootstrap_mir_module_count_value
        for const_ in const_vals:
            lowering.lower_const(const_)
            lowering.lower_static(const_)
        if bootstrap_reject_fatal_mir_errors(lowering):
            rt_exit(1)
        lowering.lower_runtime_module_initializers(hir_module, const_vals, module_index)
        var lowered_module = lowering.builder.module
        lowered_module.name = hir_module.name
        if trace_enabled:
            print "[mir-lower-free] functions:count {fn_keys.len()}"
        var fki = 0
        while fki < fn_keys.len():
            val hir_fn: HirFunction = entry_functions[fn_keys[fki]]
            val bootstrap_name = bootstrap_hir_function_symbol_name(hir_module, hir_fn)
            if hir_fn.is_extern:
                # Extern functions (e.g. rt_cli_get_args) have no body. Lowering
                # them to MIR emits a STRONG `define <ret> @name(){ ret 0 }` stub
                # that shadows the real runtime archive symbol at link, so calls
                # return a null/zero handle. Skip externs -- the real archive
                # symbol (rt_get_args etc.) then resolves for callers.
                fki = fki + 1
                continue
            if bootstrap_name != "":
                if trace_enabled:
                    print "[mir-lower-free] function:start {bootstrap_name}"
                lowering.symbols = hir_module.symbols
                val mir_fn = lowering.lower_function(hir_fn)
                bootstrap_mir_functions_add(bootstrap_name, mir_fn, module_index)
                var blk_i = 0
                while blk_i < mir_fn.blocks.len():
                    real_instr_total = real_instr_total + mir_fn.blocks[blk_i].instructions.len()
                    blk_i = blk_i + 1
                var bldr = lowering.builder
                lowered_module = bldr.module
                lowered_module.name = hir_module.name
                var functions = lowered_module.functions
                functions[mir_fn.symbol] = mir_fn
                lowered_module.functions = functions
                bldr.module = lowered_module
                lowering.builder = bldr
                if trace_enabled:
                    print "[mir-lower-free] function:added"
            fki = fki + 1
        if trace_enabled:
            print "[mir-lower-free] done instr-total={real_instr_total}"
        # Loud-failure guard: the bootstrap entry must never lower to an all-stub
        # (ret-0, zero-instruction) module. Emitting such a module produced a
        # link-clean but non-functional stage-2 binary that silently shipped.
        # Fail closed instead (policy: stub fallbacks intentionally rejected).
        if real_instr_total == 0:
            bootstrap_report_recorded_mir_errors(lowering, "globals entry")
            eprint("error: bootstrap entry lowered to 0 MIR instructions (ret-0 stub module)\n")
            eprint("error: refusing to emit a stub-only bootstrap binary; real Simple lowering produced no bodies\n")
            rt_exit(1)
        bootstrap_mir_modules_add(lowering.builder.module)
        return lowering.builder.module
    eprint("error: bootstrap entry HIR module was not set before MIR lowering\n")
    eprint("error: refusing to emit a stub-only bootstrap binary\n")
    rt_exit(1)
    MirModule(name: "", functions: {}, statics: {}, constants: {}, types: {})

fn bootstrap_lower_extra_hir_module_to_mir(hir_module: HirModule) -> i64:
    val target_context = mir_target_context_from("", "unknown", "unknown", "llvm", -1)
    bootstrap_lower_extra_hir_module_to_mir_for_target(hir_module, target_context)

fn bootstrap_lower_extra_hir_module_to_mir_for_target(hir_module: HirModule, target_context: MirTargetContext) -> i64:
    """Lower one additional (non-entry) closure module's functions to MIR,
    APPENDING to the same flat _bootstrap_mir_functions/_bootstrap_mir_function_names
    accumulator that bootstrap_lower_hir_globals_to_mir_module() populates for the
    entry module. Does NOT call bootstrap_mir_functions_reset() -- callers must
    lower the entry first via bootstrap_lower_hir_globals_to_mir_module(), then
    call this once per remaining --entry-closure module.

    Needed because the real object emitter (bootstrap_emit_real_llvm_object)
    iterates the flat accumulator by index (bootstrap_mir_function_count/at/
    name_at), not a per-module MirModule.functions dict -- without this, a
    closure's non-entry modules lowered fine to HIR (after the
    flat_is_bootstrap_entry_path + resolve_import_symbols fixes) but their
    function bodies never reached the accumulator the object emitter reads,
    so calls into them linked as "undefined symbol" (bug
    bootstrap_stage2_empty_mir_bodies_2026-07-05, cross-module closure gap,
    stage 3: object emission).

    Returns the number of MIR instructions added (0 is not itself an error --
    an extern-only or type-only helper module legitimately contributes none)."""
    val trace_enabled = mir_lower_trace_enabled()
    var added_instr_total = 0
    var lowering = MirLowering.new_for_target(hir_module.symbols, target_context)
    lowering = bootstrap_register_hir_type_defs(lowering, hir_module)
    # Same module-constant registration as the entry path above: non-entry
    # closure modules (std.log etc.) also reference their own module `val`s.
    val bx_const_vals = hir_module.constants.values()
    if trace_enabled and bx_const_vals.len() > 0:
        print "[mir-lower-extra] constants:count {bx_const_vals.len()}"
    var bx_ci = 0
    while bx_ci < bx_const_vals.len():
        lowering.lower_const(bx_const_vals[bx_ci])
        bx_ci = bx_ci + 1
    val entry_functions = hir_module.functions
    val fn_keys = entry_functions.keys()
    var function_names: [text] = []
    for func in entry_functions.values():
        function_names.push(bootstrap_hir_function_symbol_name(hir_module, func))
        if not func.is_method:
            function_names.push(bootstrap_hir_accumulator_name(hir_module, func))
        # Declared-return-type registry (native_call_return_type_loss
        # 2026-07-23): bare + qualified spellings, cross-module global.
        # Str-only — see the entry-path comment above (W93 regression).
        match func.return_type.kind:
            case HirTypeKind.Str:
                val bx_ret_ty = lowering.lower_type(func.return_type)
                bootstrap_fn_ret_type_register(func.name, bx_ret_ty)
                bootstrap_fn_ret_type_register(bootstrap_hir_function_symbol_name(hir_module, func), bx_ret_ty)
                if not func.is_method:
                    bootstrap_fn_ret_type_register(bootstrap_hir_accumulator_name(hir_module, func), bx_ret_ty)
            case _: ()
    for function_name in _bootstrap_function_value_names:
        function_names.push(function_name)
    lowering.current_function_names = function_names
    val const_vals = hir_module.constants.values()
    val module_index = _bootstrap_mir_module_count_value
    for const_ in const_vals:
        lowering.lower_const(const_)
        lowering.lower_static(const_)
    # Match the entry and flat-module paths: a fatal constant/static lowering
    # error must stop this closure helper before it can append placeholder MIR
    # initializers or functions to the global object-emission accumulator.
    if bootstrap_reject_fatal_mir_errors(lowering):
        return -1
    lowering.lower_runtime_module_initializers(hir_module, const_vals, module_index)
    # Dynamic initializer expressions lower after static registration and may
    # fail independently; reject before an extern-only helper can return clean.
    if bootstrap_reject_fatal_mir_errors(lowering):
        return -1
    var lowered_module = lowering.builder.module
    lowered_module.name = hir_module.name
    if trace_enabled:
        print "[mir-lower-extra] module={hir_module.name} functions:count {fn_keys.len()}"
    var fki = 0
    while fki < fn_keys.len():
        val hir_fn: HirFunction = entry_functions[fn_keys[fki]]
        val fn_name = bootstrap_hir_function_symbol_name(hir_module, hir_fn)
        if hir_fn.is_extern:
            fki = fki + 1
            continue
        # Qualified accumulator identity prevents same-named functions in
        # different closure modules from suppressing one another.
        val qualified_fn_name = bootstrap_hir_accumulator_name(hir_module, hir_fn)
        var already_added = false
        var dup_i = 0
        while dup_i < _bootstrap_mir_function_names.len():
            if _bootstrap_mir_function_names[dup_i] == qualified_fn_name:
                already_added = true
            dup_i = dup_i + 1
        if fn_name != "" and not already_added:
            lowering.symbols = hir_module.symbols
            val mir_fn = lowering.lower_function(hir_fn)
            if bootstrap_reject_fatal_mir_errors(lowering):
                return -1
            bootstrap_mir_functions_add(qualified_fn_name, mir_fn, module_index)
            var bldr = lowering.builder
            lowered_module = bldr.module
            lowered_module.name = hir_module.name
            var functions = lowered_module.functions
            functions[mir_fn.symbol] = mir_fn
            lowered_module.functions = functions
            bldr.module = lowered_module
            lowering.builder = bldr
            var blk_i = 0
            while blk_i < mir_fn.blocks.len():
                added_instr_total = added_instr_total + mir_fn.blocks[blk_i].instructions.len()
                blk_i = blk_i + 1
            if trace_enabled:
                print "[mir-lower-extra] function:added {fn_name}"
        fki = fki + 1
    bootstrap_mir_modules_add(lowering.builder.module)
    added_instr_total
