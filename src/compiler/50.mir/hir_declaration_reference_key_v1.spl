# Body-free reference key owner. Kept below the summary/prescan coordinator so
# private registry reconstruction never imports MirLowering through that hub.
use compiler.mir.hir_declaration_types_v1.{MirHirModuleDeclarationsV1}

fn mir_hir_reference_module_key_v1(module: MirHirModuleDeclarationsV1) -> text:
    if val source = module.source_binding: return source.logical_key
    module.name

export mir_hir_reference_module_key_v1
