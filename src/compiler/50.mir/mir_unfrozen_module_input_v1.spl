# Target binding for the existing mutable HIR path. This carrier is not a
# HirSnapshot, TargetHIR, frozen owner, semantic witness or cache authority.
use compiler.hir.hir_types.{HirModule}
use compiler.common.mir_target_context.{MirTargetContext}

pub struct UnfrozenMirModuleInputV1:
    module: HirModule
    target: MirTargetContext

pub fn mir_unfrozen_module_input_validate_v1(input: UnfrozenMirModuleInputV1) -> Result<bool, text>:
    val target = input.target
    # Placeholder detection is not tuple compatibility or backend admission.
    # Keep exact original values for the complete identity comparison.
    for value in [target.arch, target.os, target.abi]:
        val placeholder = value.trim().lower()
        if ["", "unknown", "host", "native", "auto"].contains(placeholder):
            return Err("mir_module_target_unresolved: non-placeholder arch/os/ABI required")
    # "native" is a valid backend; ABI "none" is valid for bare-metal/SimpleOS.
    if ["", "unknown", "auto"].contains(target.backend.trim().lower()):
        return Err("mir_module_target_unresolved: non-placeholder backend required")
    if input.module == None or input.module.symbols == None:
        return Err("mir_module_source_missing: retained module and symbols required")
    Ok(true)

pub fn mir_unfrozen_module_input_v1(module: HirModule, target: MirTargetContext
) -> Result<UnfrozenMirModuleInputV1, text>:
    val input = UnfrozenMirModuleInputV1(module: module, target: target)
    mir_unfrozen_module_input_validate_v1(input)?
    Ok(input)
