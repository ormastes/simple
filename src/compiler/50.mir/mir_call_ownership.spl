# Callable identity is carried by MirOperand.call_origin. Source operands
# resolve through local definitions; Runtime/Foreign operands preserve the
# external ABI name. These helpers only allocate private names for the
# runtime symbols also emitted directly by aggregate lowering.
# Never infer a callee origin from the spelling of a source identifier.

fn mir_runtime_owned_call_name(name: text) -> bool:
    name.starts_with("rt_") or name.starts_with("spl_array_") or name.starts_with("spl_dict_") or name.starts_with("spl_str_")

fn mir_runtime_owned_local_symbol(name: text) -> text:
    "__simple_local_{name}"
