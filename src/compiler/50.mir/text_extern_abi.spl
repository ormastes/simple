# Registry of extern runtime function names whose `text`-typed argument(s)
# must be lowered as a raw (ptr: i64, len: i64) TWO-WORD pair rather than
# passed through as a single collapsed operand.
#
# Background: all three pure-Simple native backends (LLVM `.spl`, Cranelift
# `.spl`, hand-written x86_64 isel) collapse a `text`-typed MIR operand
# (`MirTypeKind.Tuple([Ptr(U8), U64])`) to a single machine word at any
# extern `Call` site -- see
# doc/08_tracking/bug/pure_simple_text_extern_abi_audit_2026-07-30.md. A
# handful of C/Rust runtime functions are declared with the raw C ABI
# `(ptr: *const u8, len: u64)` shape (as opposed to a boxed/tagged runtime
# `Value` handle, which the generic single-word collapse already works for --
# see the plan doc's §4.3) and need their `text` argument(s) split into two
# real MIR operands BEFORE any backend's generic one-word-per-operand `Call`
# lowering sees them.
#
# This table mirrors `text_arg_indices` in
# `src/compiler_rust/compiler/src/codegen/instr/calls.rs` (kept in lockstep
# by hand: the underlying C/Rust runtime symbol and its real ABI are shared
# between the Rust seed and this pure-Simple compiler -- see
# doc/05_design/compiler/codegen/pure_simple_text_extern_abi_fix_plan.md
# §4.2). Data only; consumed by `expand_text_args` in
# `_MirLoweringExpr/switch_operators_calls.spl`.
#
# The Rust file's separate `text_cstr_arg_indices` table is now EMPTY (its
# last occupants, the rt_db_* family, moved here), so nothing is missing from
# this twin on that account.
# Historical note: NOT included here: the Rust file's separate `text_cstr_arg_indices` table
# -- that is a DIFFERENT convention (ptr-only, NUL-terminated, no length
# word) and is out of scope for this (ptr, len) fix.

fn text_arg_indices(func_name: text) -> [i64]?:
    match func_name:
        case "rt_print_str" | "rt_println_str" | "rt_eprint_str" | "rt_eprintln_str":
            return Some([0])
        case "rt_mem_attr_set_owner":
            return Some([0])
        # Registered explicitly even though neither probe ABI has text
        # arguments. Keeping them here marks the raw i64 contracts as audited
        # alongside the facade and is a no-op in expand_text_abi_args.
        case "rt_file_exists_probe_begin" | "rt_file_exists_probe_end":
            return Some([])
        case "rt_panic":
            return Some([0])
        case "rt_env_get" | "rt_env_get_i64" | "rt_get_env" | "rt_env_exists" | "rt_env_remove":
            return Some([0])
        case "rt_env_set" | "rt_set_env":
            return Some([0, 1])
        case "rt_lexer_source_set":
            return Some([0])
        # Package SFFI. The whole family was converted off `*const c_char` to
        # (ptr, len): Simple heap strings carry no trailing NUL, so no sound
        # C-string expansion exists. `rt_package_chmod`'s `mode` stays at index
        # 1 because each length is inserted directly after its own pointer.
        # Fast in-memory DB SFFI (src/runtime/runtime_db.c). Moved off the
        # unsound `*const c_char` table: Simple heap strings carry no trailing
        # NUL, so a bare pointer made the C side read past the allocation.
        case "rt_db_table_create":
            return Some([0])
        case "rt_db_put" | "rt_db_get" | "rt_db_delete" | "rt_db_put_row3" | "rt_db_get_int_by_pk" | "rt_db_update_int":
            return Some([1])
        case "rt_db_update_text":
            return Some([1, 3])
        case "rt_db_put_value_text":
            return Some([3])
        # `rt_package_sha256` is included: its `*mut c_char` RETURN was changed
        # to a RuntimeValue text in the runtime, which an arg-index table could
        # never have fixed. See doc/08_tracking/bug/
        # rt_package_chmod_family_fails_from_jit_key_left_world_readable_2026-08-08.md
        case "rt_package_sha256" | "rt_package_exists" | "rt_package_is_dir" | "rt_package_file_size" | "rt_package_mkdir_all" | "rt_package_remove_dir_all" | "rt_package_chmod":
            return Some([0])
        case "rt_package_copy_file" | "rt_package_create_symlink" | "rt_package_create_tarball" | "rt_package_extract_tarball":
            return Some([0, 1])
        case "rt_crc32_text" | "rt_file_exists" | "rt_file_is_regular_no_follow" | "rt_file_is_char_device" | "rt_file_canonicalize" | "rt_file_read_text" | "rt_file_size" | "rt_file_hash_sha256" | "rt_file_fsync" | "rt_file_fsync_cached" | "rt_file_sync" | "rt_file_delete" | "rt_file_remove" | "rt_file_read_lines" | "rt_file_read_bytes" | "rt_file_mmap_read_text" | "rt_file_mmap_len" | "rt_file_mmap_read_bytes":
            return Some([0])
        case "rt_file_write_text" | "rt_file_append_text" | "rt_file_copy" | "rt_file_rename" | "rt_file_move" | "rt_file_wrap_smf_dynlib" | "rt_file_extract_smf_dynlib" | "rt_file_create_excl":
            return Some([0, 1])
        # rt_file_open is (path_ptr, path_len, mode: i32) -- descriptor.rs:19.
        # rt_process_run_with_limits: cmd is (ptr, len) -- env_process.rs:1269.
        case "rt_process_run_with_limits":
            return Some([0])
        case "rt_file_open":
            return Some([0])
        case "rt_file_write_bytes":
            return Some([0])
        case "rt_dir_list" | "rt_dir_remove_all" | "rt_dir_walk" | "rt_set_current_dir" | "rt_dir_exists":
            return Some([0])
        # rt_dir_glob is (dir, pattern): its ONLY implementation
        # (runtime/src/value/sffi/file_io/directory.rs:199) takes four words.
        case "rt_dir_glob":
            return Some([0, 1])
        case "rt_dir_create" | "rt_dir_create_all" | "rt_dir_remove":
            return Some([0])
        case "rt_file_find":
            return Some([0, 1])
        case "rt_driver_submit_open":
            return Some([1])
        case "rt_driver_submit_connect" | "rt_driver_submit_send" | "rt_driver_submit_write":
            return Some([2])
        case "rt_path_basename" | "rt_path_dirname" | "rt_path_ext" | "rt_path_absolute" | "rt_path_stem" | "rt_path_parent":
            return Some([0])
        case "rt_path_relative" | "rt_path_join":
            return Some([0, 1])
        case "simple_contract_check":
            return Some([2])
        case "simple_contract_check_msg":
            return Some([2, 3])
        case "rt_contract_violation_new":
            return Some([1, 2])
        case "rt_interp_call":
            return Some([0])
        case "rt_sffi_call_method" | "rt_sffi_has_method" | "rt_sffi_object_call_method" | "rt_sffi_object_has_method":
            return Some([1])
        case "rt_sffi_type_register":
            return Some([0])
        case "rt_bdd_describe_start" | "rt_bdd_it_start" | "rt_bdd_expect_fail":
            return Some([0])
        case "native_tcp_bind" | "native_tcp_connect" | "native_udp_bind":
            return Some([0])
        case "native_tcp_connect_timeout":
            return Some([0])
        case "native_tcp_read" | "native_tcp_write" | "native_tcp_peek" | "native_udp_recv_from" | "native_udp_recv" | "native_udp_send" | "native_udp_peek_from" | "native_udp_peek":
            return Some([1])
        case "native_udp_connect":
            return Some([1])
        case "native_udp_send_to":
            return Some([1, 2])
        case "sffi_regex_is_match" | "sffi_regex_find" | "sffi_regex_find_all" | "sffi_regex_captures" | "sffi_regex_split":
            return Some([0, 1])
        case "sffi_regex_replace" | "sffi_regex_replace_all":
            return Some([0, 1, 2])
        case "sffi_regex_split_n":
            return Some([0, 1])
        case "rt_file_stat":
            return Some([0])
        case "rt_cocoa_window_new" | "rt_win32_window_new":
            return Some([2])
        case "rt_cuda_launch_kernel":
            return Some([1])
        case "rt_cuda_module_load":
            return Some([0])
        case "rt_cuda_module_load_data":
            return Some([0])
        case "rt_profiler_record_call":
            return Some([0])
        case _("every other extern name is either non-text or already uses the boxed/tagged single-word convention that the generic one-word-per-operand Call lowering already handles correctly"):
            return nil

# Exact facade arity for symbols also called through raw machine-word bridges.
# Indices alone cannot distinguish rt_env_set(text,text), which must expand
# 2 -> 4, from rt_env_set(i64,i64,i64,i64), which must remain unchanged.
fn text_extern_semantic_arity(func_name: text) -> i64?:
    match func_name:
        case "rt_env_get" | "rt_get_env" | "rt_env_exists" | "rt_env_remove":
            Some(1)
        case "rt_env_get_i64" | "rt_env_set" | "rt_set_env":
            Some(2)
        case _:
            nil

fn boxed_text_arg_indices(func_name: text) -> [i64]?:
    match func_name:
        case "rt_string_builder_push": return Some([1])
        case _: return nil
