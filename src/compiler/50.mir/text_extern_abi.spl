# Registry of extern runtime function names whose `text`-typed argument(s)
# must be lowered as a raw (ptr: i64, len: i64) TWO-WORD pair rather than
# passed through as a single collapsed operand.
#
# Background: all three pure-Simple native backends (LLVM `.spl`, Cranelift
# `.spl`, hand-written x86_64 isel) collapse a `text`-typed MIR operand
# (`MirTypeKind.Tuple([Ptr(U8), U64])`) to a single machine word at any
# extern `Call` site -- see
# doc/08_tracking/bug/pure_simple_text_extern_abi_audit_2026-07-30.md. A
# handful of C/Rust runtime functions are declared with the raw C ABI
# `(ptr: *const u8, len: u64)` shape (as opposed to a boxed/tagged runtime
# `Value` handle, which the generic single-word collapse already works for --
# see the plan doc's §4.3) and need their `text` argument(s) split into two
# real MIR operands BEFORE any backend's generic one-word-per-operand `Call`
# lowering sees them.
#
# This table mirrors `text_arg_indices` in
# `src/compiler_rust/compiler/src/codegen/instr/calls.rs` (kept in lockstep
# by hand: the underlying C/Rust runtime symbol and its real ABI are shared
# between the Rust seed and this pure-Simple compiler -- see
# doc/05_design/compiler/codegen/pure_simple_text_extern_abi_fix_plan.md
# §4.2). Data only; consumed by `expand_text_args` in
# `_MirLoweringExpr/switch_operators_calls.spl`.
#
# Lockstep is now checked, not hand-kept: test/01_unit/compiler/mir/
# text_extern_abi_seed_parity_spec.spl reads the seed tables from calls.rs and
# requires every seed row here with equal indices. This side is a SUPERSET:
# it also lists C-lane owners (runtime_native.c, runtime_cache_host_*.c, ...)
# that seed-built binaries never meet because they link the Rust runtime.
#
# The Rust file's separate `text_cstr_arg_indices` table is now EMPTY (its
# last occupants, the rt_db_* family, moved here), so nothing is missing from
# this twin on that account.
# Historical note: NOT included here: the Rust file's separate `text_cstr_arg_indices` table
# -- that is a DIFFERENT convention (ptr-only, NUL-terminated, no length
# word) and is out of scope for this (ptr, len) fix.

use compiler.mir.mir_types.{MirSignature, MirType, MirTypeKind}

fn text_arg_indices(func_name: text) -> [i64]?:
    match func_name:
        # Linux process-owner C boundary: arrays and scalar limits remain
        # single operands; each semantic text contributes pointer + length.
        case "rt_linux_group_available_capacity_v1":
            return Some([0])
        case "rt_linux_group_parent_acquire_v1":
            return Some([0, 1])
        case "rt_linux_group_launch_broker_v1":
            return Some([0, 1])
        case "rt_linux_group_start_v1":
            return Some([0, 1, 4, 5, 6, 9, 10])
        case "rt_print_str" | "rt_println_str" | "rt_eprint_str" | "rt_eprintln_str":
            return Some([0])
        case "rt_mem_attr_set_owner":
            return Some([0])
        # Registered explicitly even though neither probe ABI has text
        # arguments. Keeping them here marks the raw i64 contracts as audited
        # alongside the facade and is a no-op in expand_text_abi_args.
        case "rt_file_exists_probe_begin" | "rt_file_exists_probe_end":
            return Some([])
        case "rt_panic":
            return Some([0])
        case "rt_env_get" | "rt_env_get_i64" | "rt_get_env" | "rt_env_exists" | "rt_env_remove":
            return Some([0])
        case "rt_env_set" | "rt_set_env":
            return Some([0, 1])
        case "rt_lexer_source_set":
            return Some([0])
        # Package SFFI. The whole family was converted off `*const c_char` to
        # (ptr, len): Simple heap strings carry no trailing NUL, so no sound
        # C-string expansion exists. `rt_package_chmod`'s `mode` stays at index
        # 1 because each length is inserted directly after its own pointer.
        # Fast in-memory DB SFFI (src/runtime/runtime_db.c). Moved off the
        # unsound `*const c_char` table: Simple heap strings carry no trailing
        # NUL, so a bare pointer made the C side read past the allocation.
        case "rt_db_table_create":
            return Some([0])
        case "rt_db_put" | "rt_db_get" | "rt_db_delete" | "rt_db_put_row3" | "rt_db_get_int_by_pk" | "rt_db_update_int":
            return Some([1])
        case "rt_db_update_text":
            return Some([1, 3])
        case "rt_db_put_value_text":
            return Some([3])
        # `rt_package_sha256` is included: its `*mut c_char` RETURN was changed
        # to a RuntimeValue text in the runtime, which an arg-index table could
        # never have fixed. See doc/08_tracking/bug/
        # rt_package_chmod_family_fails_from_jit_key_left_world_readable_2026-08-08.md
        case "rt_package_sha256" | "rt_package_exists" | "rt_package_is_dir" | "rt_package_file_size" | "rt_package_mkdir_all" | "rt_package_remove_dir_all" | "rt_package_chmod":
            return Some([0])
        case "rt_package_copy_file" | "rt_package_create_symlink" | "rt_package_create_tarball" | "rt_package_extract_tarball":
            return Some([0, 1])
        case "rt_crc32_text" | "rt_file_exists" | "rt_file_is_regular_no_follow" | "rt_file_is_char_device" | "rt_file_canonicalize" | "rt_file_read_text" | "rt_file_read_regular_no_follow_bounded" | "rt_file_read_regular_no_follow_bounded_bytes" | "rt_file_size" | "rt_file_hash_sha256" | "rt_file_fsync" | "rt_file_fsync_cached" | "rt_file_sync" | "rt_file_delete" | "rt_file_remove" | "rt_file_read_lines" | "rt_file_read_bytes" | "rt_file_mmap_read_text" | "rt_file_mmap_len" | "rt_file_mmap_read_bytes":
            return Some([0])
        case "rt_file_write_text" | "rt_file_append_text" | "rt_file_copy" | "rt_file_rename" | "rt_file_move" | "rt_file_wrap_smf_dynlib" | "rt_file_extract_smf_dynlib" | "rt_file_create_excl" | "rt_file_copy_create_excl_no_follow" | "rt_file_link_create_excl_no_follow" | "rt_secure_temp_dir" | "rt_file_publish_noreplace":
            return Some([0, 1])
        # NOT listed: the cycle-170 split setters rt_secure_temp_dir_set_parent
        # / _set_prefix take ONE boxed text RuntimeValue (runtime_native.c),
        # the generic single-word crossing, so their ABI does not depend on
        # any table vintage; _make takes no argument. Twin of calls.rs. See
        # doc/08_tracking/bug/tracked_seed_cranelift_split_secure_temp_dir_refuses_20261019.md
        # Stage-3 memory-evidence sink (runtime.c rt_mem_snapshot_*), raw
        # (ptr, len) C ABI. Twin of the calls.rs entries.
        case "rt_mem_snapshot_open":
            return Some([0])
        case "rt_mem_snapshot_record":
            return Some([2, 3, 5])
        # rt_file_open is (path_ptr, path_len, mode: i32) -- descriptor.rs:19.
        # rt_process_run_with_limits: cmd is (ptr, len) -- env_process.rs:1269.
        case "rt_process_run_with_limits" | "rt_process_run_bounded_bytes":
            return Some([0])
        # Process-run owners whose C ABI is (cmd_ptr, cmd_len, SplArray* args,
        # ...): runtime_native.c rt_process_run / rt_process_run_inherit,
        # runtime_process.c rt_process_run_timeout / rt_process_run_bounded,
        # runtime_process_owned.c rt_process_run_owned_{,observed_}bounded_value
        # and rt_process_owned_v3_start_value. Twin of the seed's
        # process_c_runtime_arg_indices (calls.rs), which expands cmd to
        # (ptr, len) for exactly these. Missing here, the extern pointer bridge
        # passed ONE word (rt_interp_cstr(cmd)) to the five-word
        # rt_process_run_bounded: cmd_len got the args handle, args got
        # timeout_ms, and every Stage-2-built child spawn returned status 4
        # without forking (SCV-E-ADMISSION: git-event-source-unavailable).
        # NOT listed: rt_process_spawn{,_async,_guarded} and
        # rt_process_execute -- their C owners take (char*, char**, count) and
        # native callers reach them through the *_value facades instead.
        case "rt_process_run" | "rt_process_run_inherit" | "rt_process_run_timeout" | "rt_process_run_bounded" | "rt_process_run_owned_bounded_value" | "rt_process_run_owned_observed_bounded_value" | "rt_process_owned_v3_start_value":
            return Some([0])
        case "rt_file_open":
            return Some([0])
        # FileHandle providers consume (path_ptr, path_len[, mode]), matching
        # calls.rs and runtime_native.c. Missing this row sent read mode zero
        # as path length in nogc_schema_input_probe_guarded_v2 (2026-10-21).
        # Source repair only: the existing r17 producer retains its old table
        # until rebuilt; binaries it emits do not qualify this edited registry.
        case "rt_io_file_open" | "rt_io_file_exists" | "rt_io_file_delete":
            return Some([0])
        # rt_file_lock is (path_ptr, path_len, timeout_secs) --
        # runtime/src/value/sffi/file_io/file_ops.rs:679, and
        # runtime_sffi.rs:323 registers it as [I64,I64,I64] -> [I64].
        # The Rust twin has had this row since calls.rs:2672; this table
        # was missing it, so pure-Simple codegen emitted TWO words for a
        # THREE-word C function (lockstep drift, found 2026-09-02).
        case "rt_file_lock":
            return Some([0])
        case "rt_file_write_bytes":
            return Some([0])
        case "rt_hosted_safe_artifact_root_open_v1":
            return Some([0])
        case "rt_hosted_safe_artifact_read_v1" | "rt_hosted_safe_artifact_publish_v1":
            return Some([1])
        case "rt_hosted_safe_artifact_bundle_begin_v1":
            return Some([0, 1, 2, 3, 4])
        case "rt_hosted_safe_artifact_bundle_stage_scr1_v1":
            return Some([1])
        case "rt_dir_list" | "rt_dir_remove_all" | "rt_dir_walk" | "rt_set_current_dir" | "rt_dir_exists" | "rt_dir_is_real_no_follow":
            return Some([0])
        # rt_dir_glob is (dir, pattern) in the Rust runtime
        # (runtime/src/value/sffi/file_io/directory.rs:199, four words) but
        # (pattern_ptr, pattern_len) in runtime_native.c, and both arities are
        # declared in .spl. Out-of-range indices are skipped (seed semantics),
        # so the one-text facade splits index 0 only.
        case "rt_dir_glob":
            return Some([0, 1])
        # C-lane (ptr, len) owners the seed never lists (it links the Rust
        # providers): runtime_shared_parse_cell_private.h,
        # runtime_native.c rt_host_dynlib_*, runtime_cache_host_authority_v1.c,
        # runtime_process{,_owned}.c pin owners. Unlisted, the pointer bridge
        # passed one word and every later argument shifted by one register.
        case "rt_shared_parse_cell_read_v1" | "rt_host_dynlib_open" | "rt_cache_host_open_root_v1" | "rt_process_observation_v4_pin_cwd_value" | "rt_process_pin_executable_owned_value":
            return Some([0])
        case "rt_host_dynlib_symbol" | "rt_cache_host_open_read_v1" | "rt_cache_host_open_child_v1" | "rt_cache_host_open_cas_kind_v1" | "rt_cache_host_open_cas_shard_v1" | "rt_cache_host_open_cas_leaf_v1" | "rt_cache_host_publish_noreplace_v1" | "rt_cache_host_publish_retained_noreplace_v2":
            return Some([1])
        case "rt_cache_host_open_pinned_cas_v1":
            return Some([1, 2])
        case "rt_cache_host_quarantine_v1":
            return Some([2])
        case "rt_dir_create" | "rt_dir_create_all" | "rt_dir_remove":
            return Some([0])
        case "rt_file_find":
            return Some([0, 1])
        case "rt_driver_submit_open":
            return Some([1])
        case "rt_driver_submit_connect" | "rt_driver_submit_send" | "rt_driver_submit_write":
            return Some([2])
        case "rt_path_basename" | "rt_path_dirname" | "rt_path_ext" | "rt_path_absolute" | "rt_path_stem" | "rt_path_parent":
            return Some([0])
        case "rt_path_relative" | "rt_path_join":
            return Some([0, 1])
        case "simple_contract_check":
            return Some([2])
        case "simple_contract_check_msg":
            return Some([2, 3])
        case "rt_contract_violation_new":
            return Some([1, 2])
        case "rt_interp_call":
            return Some([0])
        case "rt_sffi_call_method" | "rt_sffi_has_method" | "rt_sffi_object_call_method" | "rt_sffi_object_has_method":
            return Some([1])
        case "rt_sffi_type_register":
            return Some([0])
        case "rt_bdd_describe_start" | "rt_bdd_it_start" | "rt_bdd_expect_fail":
            return Some([0])
        case "native_tcp_bind" | "native_tcp_connect" | "native_udp_bind":
            return Some([0])
        case "native_tcp_connect_timeout":
            return Some([0])
        case "native_tcp_read" | "native_tcp_write" | "native_tcp_peek" | "native_udp_recv_from" | "native_udp_recv" | "native_udp_send" | "native_udp_peek_from" | "native_udp_peek":
            return Some([1])
        case "native_udp_connect":
            return Some([1])
        case "native_udp_send_to":
            return Some([1, 2])
        case "sffi_regex_is_match" | "sffi_regex_find" | "sffi_regex_find_all" | "sffi_regex_captures" | "sffi_regex_split":
            return Some([0, 1])
        case "sffi_regex_replace" | "sffi_regex_replace_all":
            return Some([0, 1, 2])
        case "sffi_regex_split_n":
            return Some([0, 1])
        case "rt_file_stat":
            return Some([0])
        case "rt_cocoa_window_new" | "rt_win32_window_new":
            return Some([2])
        case "rt_cuda_launch_kernel":
            return Some([1])
        case "rt_cuda_module_load":
            return Some([0])
        case "rt_cuda_module_load_data":
            return Some([0])
        case "rt_profiler_record_call":
            return Some([0])
        case _("every other extern name is either non-text or already uses the boxed/tagged single-word convention that the generic one-word-per-operand Call lowering already handles correctly"):
            return nil

# Exact facade arity for symbols that are also invoked through raw machine-word
# bridges. The symbol name and split indices alone cannot distinguish
# rt_env_set(text, text), which must expand 2 -> 4, from the already-lowered
# rt_env_set(i64, i64, i64, i64), which must remain unchanged.
fn text_extern_semantic_arity(func_name: text) -> i64?:
    match func_name:
        case "rt_env_get" | "rt_get_env" | "rt_env_exists" | "rt_env_remove":
            Some(1)
        case "rt_env_get_i64" | "rt_env_set" | "rt_set_env":
            Some(2)
        case "rt_file_write_bytes":
            Some(2)
        # Process owners: the semantic facade arity. A different-arity
        # declaration (e.g. the wasm backend's `rt_process_run(cmd) -> i64`
        # import) is not this C owner and is left unsplit.
        case "rt_process_run" | "rt_process_run_inherit":
            Some(2)
        case "rt_process_run_timeout":
            Some(3)
        case "rt_process_run_bounded" | "rt_process_run_owned_bounded_value" | "rt_process_run_owned_observed_bounded_value":
            Some(4)
        case "rt_process_owned_v3_start_value":
            Some(6)
        case "rt_io_file_open":
            Some(2)
        case "rt_io_file_exists" | "rt_io_file_delete":
            Some(1)
        case _:
            nil

fn boxed_text_arg_indices(func_name: text) -> [i64]?:
    match func_name:
        case "rt_string_builder_push": return Some([1])
        # Bug: redis_tagged_text_runtime_abi_2026_10_11. These owned runtime
        # entrypoints consume tagged text handles, never borrowed C strings.
        # Keep byte extents (including NUL) and the TCP address owner intact.
        case "rt_text_to_bytes" | "rt_io_tcp_bind": return Some([0])
        case "rt_io_tcp_write_text": return Some([1])
        # Atomic writers decode both operands as owned RuntimeValue text.
        # Without this registration the extern pointer bridge strips their
        # handles via rt_interp_cstr, so the writer can reject valid paths and
        # lose the diagnostic it was meant to preserve. The mode stays i32.
        case "rt_file_atomic_write" | "rt_file_atomic_write_mode": return Some([0, 1])
        # `rt_file_write_bytes_array` consumes tagged path and byte-array
        # RuntimeValues. Re-box only the semantic text path; the array handle
        # is already the provider's expected representation.
        case "rt_file_write_bytes_array": return Some([0])
        # Tagged-RuntimeValue text ABI (runtime_sffi.rs:2215-2217: "path
        # RuntimeValue, offset, data RuntimeValue"; Rust impl file_ops.rs:1405
        # uses tagged_text_to_str — tagged ONLY, no raw-cstr fallback). The
        # generic extern text-arg bridge (rt_interp_cstr unwrap) destroys
        # these args: measured 2026-10-09 on the stage-2-built
        # bootstrap_reason_planner — rt_file_write_text_at received a raw
        # char* in x0/x2, rt_core_string_to_cpath rejected it (tag 0 != heap),
        # and the planner died with receipt-write-failed, blocking the
        # stage-3 planner admission producer. Re-box through rt_string_new so
        # a proper tagged handle arrives regardless of whether the operand is
        # a tagged heap string or a raw string literal.
        # Atomic publication consumes two tagged text values in both variants.
        # Raw C-string lowering makes the runtime reject the path/content.
        case "rt_file_atomic_write" | "rt_file_atomic_write_mode": return Some([0, 1])
        case "rt_file_write_text_at": return Some([0, 2])
        case "rt_file_write_text_at_cached": return Some([1])
        case "rt_file_write_text_at_cached_repeat": return Some([1])
        case _: return nil

fn file_write_bytes_array_alias_target(func_name: text, signature: MirSignature, argument_count: i64) -> text?:
    """Return the tagged-value provider only for the exact imported facade.

    Callers must obtain this source signature from the separate adapted-extern
    receipt, never from the raw exact-extern ABI registry. The name, fixed
    arity, source types, and bool result all remain part of this ABI admission.
    """
    if func_name != "rt_file_write_bytes" or argument_count != 2 or
            signature.is_variadic or signature.params.len() != 2:
        return nil
    if signature.return_type.kind != MirTypeKind.Bool:
        return nil
    val path_is_text = match signature.params[0].kind:
        case MirTypeKind.Tuple(elements):
            if elements.len() != 2:
                false
            else:
                val pointer_is_u8 = match elements[0].kind:
                    case MirTypeKind.Ptr(inner, false): inner.kind == MirTypeKind.U8
                    case _: false
                pointer_is_u8 and elements[1].kind == MirTypeKind.U64
        case _: false
    val data_is_u8_array = match signature.params[1].kind:
        case MirTypeKind.Array(element, size): size == 0 and element.kind == MirTypeKind.U8
        case _: false
    if path_is_text and data_is_u8_array:
        return "rt_file_write_bytes_array"
    nil

# Externs whose `text` argument(s) are consumed as a complete tagged
# RuntimeValue and must cross the boundary UNCHANGED: no rt_interp_cstr
# pointer bridge, no (ptr, len) split, no re-box. rt_stderr_write /
# rt_stdout_write (runtime_native.c, `int64_t (int64_t value)`, and the Rust
# twin io_print.rs) decode the value with rt_core_as_string; handed the bare
# char* the bridge produced, the decode failed and the pointer was printed as
# an integer. The seed lists neither name in any table, so it already passes
# the value through. Only `text`-typed parameters are bridged, so the
# `[u8]` / `i64` declarations of the same names are unaffected.
#
# Parity rule (audit 2026-10-25): the seed passes every UNLISTED `text`
# argument as the tagged value, while this compiler's default is the char*
# bridge. Every C-lane owner whose text parameter is an `int64_t` decoded as a
# runtime value is therefore listed here. Strict decoders (rt_core_as_string,
# rt_core_string_to_cpath, rt_core_string_bytes, simd_as_string,
# rt_eprint_value) returned nil/0/""/-1 for the bridged char*, or printed it
# as an integer (rt_print_err -> empty `panic:` + pointer-like numbers).
# Raw-tolerant owners (rt_string_data/len, rt_interp_cstr, promote_raw)
# are listed too: tagged is exactly what they accept, and it keeps the
# length. True `const char*` owners (rt_print, rt_println, rt_eprintln,
# rt_dir_delete, rt_process_spawn*, ...) stay on the bridge.
fn tagged_text_value_arg_indices(func_name: text) -> [i64]?:
    match func_name:
        case "rt_stderr_write" | "rt_stdout_write": return Some([0])
        # Strict tagged decoders (runtime_native.c, runtime_simd_utf8.c).
        case "rt_file_read_text_at_checked" | "rt_file_mode" | "rt_file_exists_str" | "rt_file_hash" | "rt_file_list_dir" | "rt_file_read_text_rv" | "rt_fs_read_text": return Some([0])
        case "rt_hash_text" | "rt_xxh3_128_text" | "rt_path_filename" | "rt_path_extension" | "rt_shell_exec" | "rt_shell_exec_tuple": return Some([0])
        case "rt_print_err" | "rt_println_value" | "print_raw" | "rt_heap_ref_wellformed": return Some([0])
        case "rt_string_bytes" | "rt_string_char_at" | "rt_string_to_int" | "rt_string_free": return Some([0])
        case "rt_string_find" | "rt_string_rfind" | "rt_string_contains" | "rt_string_starts_with" | "rt_string_ends_with": return Some([0, 1])
        case "rt_string_replace": return Some([0, 1, 2])
        case "rt_text_is_ascii" | "rt_text_to_lower_ascii" | "rt_text_to_upper_ascii" | "rt_text_validate_utf8" | "rt_text_count_codepoints" | "rt_text_count_codepoints_cached": return Some([0])
        case "rt_simd_str_search": return Some([0, 1])
        # Raw-tolerant decoders: tagged matches the seed and keeps the length.
        case "rt_string_data" | "rt_string_len" | "rt_string_byte_at" | "rt_string_char_code_at" | "rt_string_substr_from" | "rt_string_trim" | "rt_string_to_byte_array": return Some([0])
        case "rt_file_modified" | "rt_file_modified_time" | "rt_mmap" | "rt_path_normalize" | "rt_process_output" | "rt_process_spawn_async_value": return Some([0])
        case "rt_secure_temp_dir_set_parent" | "rt_secure_temp_dir_set_prefix" | "rt_sysctlbyname_i32" | "rt_shell" | "rt_shell_output" | "rt_term_write": return Some([0])
        case "rt_timestamp_from_iso" | "rt_timestamp_parse" | "spl_dlopen" | "spl_dlopen_checked" | "spl_dlsym_process_checked" | "spl_dynlib_snapshot_linux" | "spl_collection_capture_begin": return Some([0])
        case "rt_time_format" | "spl_dlsym" | "spl_dlsym_checked": return Some([1])
        case "rt_list_dir_recursive" | "rt_file_view_open_beneath_no_follow_v1" | "rt_pinned_archive_open_beneath_v1": return Some([0, 1])
        case "spl_collection_capture_note_size" | "spl_collection_capture_note_lookup" | "spl_collection_capture_note_materialization" | "spl_collection_capture_note_hash_probe" | "spl_collection_capture_note_filter" | "spl_collection_capture_note_loop": return Some([0, 1])
        case _: return nil

export file_write_bytes_array_alias_target
export tagged_text_value_arg_indices
