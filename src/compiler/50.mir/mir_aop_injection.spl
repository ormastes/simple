# MIR AOP Injection — Advice Call Insertion into MIR Functions
#
# Provides functions to inject advice calls (before/after/around) into
# MIR function blocks. Used by the driver's weave_aop() step.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind, MirSignature}
use compiler.frontend.core.aop.{MirBlockInfo, InstructionInfo, WeavingResult, AdviceCallInfo, JoinPointKind, AdviceForm}

# ============================================================================
# AOP Weave Accounting (W2-B)
# ============================================================================
# Tracks how many advices were requested vs. actually woven into MIR so that
# generation backends (e.g. VHDL) can record `aop_weave_count` in their
# generation manifest and fail closed when requested aspects were not woven
# (a silently dropped aspect would remove woven debug/JTAG logic from RTL).

var g_aop_advices_requested: i64 = 0
var g_aop_weave_count: i64 = 0

pub fn aop_weave_accounting_reset(requested: i64):
    g_aop_advices_requested = requested
    g_aop_weave_count = 0

pub fn aop_weave_accounting_add(inserted: i64):
    g_aop_weave_count = g_aop_weave_count + inserted

pub fn aop_advices_requested() -> i64:
    g_aop_advices_requested

pub fn aop_weave_count() -> i64:
    g_aop_weave_count

# ============================================================================
# Before Advice Injection
# ============================================================================

fn inject_before_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn at the beginning of the entry block."""
    if func.blocks.len() == 0:
        return func
    var new_blocks: [MirBlock] = []
    var bi = 0
    while bi < func.blocks.len():
        val block: MirBlock = func.blocks[bi]
        if block.id.id == func.entry_block.id:
            # Prepend advice call to entry block
            val call_inst = make_advice_call_inst(advice_fn_name)
            var new_insts: [MirInst] = [call_inst]
            for inst in block.instructions:
                new_insts.push(inst)
            new_blocks.push(MirBlock(
                id: block.id,
                label: block.label,
                instructions: new_insts,
                terminator: block.terminator
            ))
        else:
            new_blocks.push(block)
        bi = bi + 1
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# After Success Advice Injection
# ============================================================================

fn inject_after_success_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn before every Return terminator."""
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case MirTerminator.Ret(_):
                val call_inst = make_advice_call_inst(advice_fn_name)
                var new_insts: [MirInst] = []
                for inst in block.instructions:
                    new_insts.push(inst)
                new_insts.push(call_inst)
                new_blocks.push(MirBlock(
                    id: block.id,
                    label: block.label,
                    instructions: new_insts,
                    terminator: block.terminator
                ))
            case _:
                new_blocks.push(block)
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# After Error Advice Injection
# ============================================================================

fn inject_after_error_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn at blocks that terminate abnormally.

    MirTerminator has no `Unwind` variant — the error exit is `Abort(message)`.
    The historical `case Unwind:` here was a bare identifier, i.e. an
    irrefutable BINDING pattern, so it matched EVERY terminator and this pass
    injected the after-error advice into every block of the function.
    `CallTerminator`'s `unwind` edge is deliberately not a join point here: the
    error handler is the unwind TARGET block, not the calling block, and
    injecting there would also run the advice on the normal-return path.
    """
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case MirTerminator.Abort(_):
                val call_inst = make_advice_call_inst(advice_fn_name)
                var new_insts: [MirInst] = []
                for inst in block.instructions:
                    new_insts.push(inst)
                new_insts.push(call_inst)
                new_blocks.push(MirBlock(
                    id: block.id,
                    label: block.label,
                    instructions: new_insts,
                    terminator: block.terminator
                ))
            case _:
                new_blocks.push(block)
    MirFunction(..func, blocks: new_blocks)

fn inject_advice_at_instruction(func: MirFunction, block_id: i64, instruction_index: i64, advice_fn_name: text, before: bool) -> MirFunction:
    """Insert an advice call before or after a specific MIR instruction."""
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        if block.id.id != block_id:
            new_blocks.push(block)
        else:
            val call_inst = make_advice_call_inst(advice_fn_name)
            var new_insts: [MirInst] = []
            var idx = 0
            for inst in block.instructions:
                if before and idx == instruction_index:
                    new_insts.push(call_inst)
                new_insts.push(inst)
                if not before and idx == instruction_index:
                    new_insts.push(call_inst)
                idx = idx + 1
            new_blocks.push(MirBlock(
                id: block.id,
                label: block.label,
                instructions: new_insts,
                terminator: block.terminator
            ))
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# Around Advice Injection
# ============================================================================

fn inject_around_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Legacy entry pre-hook; this does not implement around/proceed semantics."""
    # Retained for source compatibility only. Checked placement rejects Around;
    # no arguments or proceed context are passed by this helper.
    if func.blocks.len() == 0:
        return func
    var new_blocks: [MirBlock] = []
    val entry_block = func.blocks[0]
    val call_inst = make_advice_call_inst(advice_fn_name)
    var new_insts: [MirInst] = [call_inst]
    for inst in entry_block.instructions:
        new_insts.push(inst)
    new_blocks.push(MirBlock(
        id: entry_block.id,
        label: entry_block.label,
        instructions: new_insts,
        terminator: entry_block.terminator
    ))
    var bi = 1
    while bi < func.blocks.len():
        new_blocks.push(func.blocks[bi])
        bi = bi + 1
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# MIR ↔ AOP Bridge
# ============================================================================

fn extract_mir_block_info(blocks: [MirBlock]) -> [MirBlockInfo]:
    """Convert real MIR blocks to AOP-compatible MirBlockInfo structs."""
    var result: [MirBlockInfo] = []
    for block in blocks:
        var infos: [InstructionInfo] = []
        var idx = 0
        for inst in block.instructions:
            val tag = classify_mir_inst_kind(inst.kind)
            infos.push(InstructionInfo(index: idx, kind_tag: tag))
            idx = idx + 1
        result.push(MirBlockInfo(id: block.id.id, instruction_kinds: infos))
    result

fn classify_mir_inst_kind(kind: MirInstKind) -> text:
    """Classify a MIR instruction kind into an AOP-relevant tag."""
    match kind:
        case BinOp(_, op, _, _):
            match op:
                case Eq: "comparison"
                case Ne: "comparison"
                case Lt: "comparison"
                case Le: "comparison"
                case Gt: "comparison"
                case Ge: "comparison"
                case _: "arithmetic"
        case Call(_, _, _): "call"
        case CallIndirect(_, _, _, _): "call"
        case Intrinsic(_, _, _): "intrinsic"
        case Store(_, _): "assignment"
        case SetField(_, _, _): "assignment"
        case VhdlSignalAssign(_, _, _): "assignment"
        case VhdlVarAssign(_, _): "assignment"
        case MirSimdStore(_, _, _): "assignment"
        case _: "other"

# Closed static placement contract. Around is reserved, but the existing
# pre-hook helper does not implement proceed/replacement and is not admitted.
pub enum AspectPlacementKindV1:
    Before
    AfterSuccess
    AfterError
    Around
    AtInstruction

pub trait Placement:
    fn apply(func: MirFunction) -> Result<MirFunction, text>

pub struct StaticAspectPlacementV1:
    kind: AspectPlacementKindV1
    advice_function: text
    block_id: i64
    instruction_index: i64
    before: bool

impl Placement for StaticAspectPlacementV1:
    fn apply(func: MirFunction) -> Result<MirFunction, text>:
        val validated = _validate_static_placement_v1(func, self)?
        match self.kind:
            case AspectPlacementKindV1.Before:
                Ok(inject_before_advice(func, self.advice_function))
            case AspectPlacementKindV1.AfterSuccess:
                Ok(inject_after_success_advice(func, self.advice_function))
            case AspectPlacementKindV1.AfterError:
                Ok(inject_after_error_advice(func, self.advice_function))
            case AspectPlacementKindV1.AtInstruction:
                Ok(inject_advice_at_instruction(func, self.block_id,
                    self.instruction_index, self.advice_function, self.before))
            case AspectPlacementKindV1.Around:
                Err("AOP-E-PLACEMENT: around/proceed is not implemented")

pub fn aspect_static_placement_v1(call: AdviceCallInfo) -> Result<StaticAspectPlacementV1, text>:
    if call.form == AdviceForm.Around:
        return Err("AOP-E-PLACEMENT: around/proceed is not implemented")
    var kind = AspectPlacementKindV1.Before
    var before = true
    match call.join_point_kind:
        case JoinPointKind.Execution:
            match call.form:
                case AdviceForm.Before: kind = AspectPlacementKindV1.Before
                case AdviceForm.AfterSuccess: kind = AspectPlacementKindV1.AfterSuccess
                case AdviceForm.AfterError: kind = AspectPlacementKindV1.AfterError
                case AdviceForm.Around: return Err("AOP-E-PLACEMENT: around/proceed is not implemented")
        case JoinPointKind.FunctionCall:
            if call.form == AdviceForm.AfterError:
                return Err("AOP-E-PLACEMENT: instruction error outcome is unavailable")
            kind = AspectPlacementKindV1.AtInstruction
            before = call.form == AdviceForm.Before
        case JoinPointKind.VariableAssignment:
            if call.form == AdviceForm.AfterError:
                return Err("AOP-E-PLACEMENT: instruction error outcome is unavailable")
            kind = AspectPlacementKindV1.AtInstruction
            before = call.form == AdviceForm.Before
        case JoinPointKind.Error:
            return Err("AOP-E-PLACEMENT: instruction error edge is unavailable")
        case _:
            return Err("AOP-E-PLACEMENT: unsupported join point")
    Ok(StaticAspectPlacementV1(kind: kind, advice_function: call.advice_function,
        block_id: call.block_id, instruction_index: call.instruction_index, before: before))

fn _validate_static_placement_v1(func: MirFunction, placement: StaticAspectPlacementV1) -> Result<bool, text>:
    if placement.advice_function == "": return Err("AOP-E-PLACEMENT: empty advice")
    if placement.kind == AspectPlacementKindV1.AtInstruction:
        var found = false
        for block in func.blocks:
            if block.id.id == placement.block_id and placement.instruction_index >= 0 and
                    placement.instruction_index < block.instructions.len(): found = true
        if not found: return Err("AOP-E-PLACEMENT: invalid original instruction coordinate")
    if placement.kind == AspectPlacementKindV1.Before:
        var found_entry = false
        for block in func.blocks:
            if block.id.id == func.entry_block.id: found_entry = true
        if not found_entry: return Err("AOP-E-PLACEMENT: missing entry block")
    if placement.kind == AspectPlacementKindV1.Around:
        return Err("AOP-E-PLACEMENT: around/proceed is not implemented")
    Ok(true)

fn _instruction_placement_precedes_v1(a: StaticAspectPlacementV1,
        b: StaticAspectPlacementV1) -> bool:
    if a.block_id != b.block_id: return a.block_id > b.block_id
    if a.instruction_index != b.instruction_index:
        return a.instruction_index > b.instruction_index
    # After inserts must happen before before-inserts at the same anchor.
    not a.before and b.before

pub fn apply_weaving_result_checked_v1(func: MirFunction,
        result: WeavingResult) -> Result<MirFunction, text>:
    var placements: [StaticAspectPlacementV1] = []
    for call in result.advice_calls:
        val placement = aspect_static_placement_v1(call)?
        val validated = _validate_static_placement_v1(func, placement)?
        placements.push(placement)
    # Coordinates name the original function. Descending edits preserve them;
    # reverse source order preserves advice order when insertions share a slot.
    var instructions: [StaticAspectPlacementV1] = []
    var i = placements.len() - 1
    while i >= 0:
        val placement = placements[i]
        if placement.kind == AspectPlacementKindV1.AtInstruction:
            var at = instructions.len()
            instructions.push(placement)
            while at > 0 and _instruction_placement_precedes_v1(placement, instructions[at - 1]):
                instructions[at] = instructions[at - 1]
                at = at - 1
            instructions[at] = placement
        i = i - 1
    var woven = func
    for placement in instructions: woven = placement.apply(woven)?
    # Exit appends preserve source order, and cannot shift an original anchor.
    for placement in placements:
        if placement.kind == AspectPlacementKindV1.AfterSuccess or placement.kind == AspectPlacementKindV1.AfterError:
            woven = placement.apply(woven)?
    i = placements.len() - 1
    while i >= 0:
        if placements[i].kind == AspectPlacementKindV1.Before:
            woven = placements[i].apply(woven)?
        i = i - 1
    Ok(woven)

fn apply_weaving_result(func: MirFunction, result: WeavingResult) -> MirFunction:
    # Compatibility entry point: unsupported requests fail explicitly. The
    # compiler driver consumes Result and emits an ordinary diagnostic instead.
    apply_weaving_result_checked_v1(func, result).unwrap()

# ============================================================================
# Helpers
# ============================================================================

fn make_advice_call_inst(advice_fn_name: text) -> MirInst:
    """Create a MIR Call instruction to an advice function (void -> void)."""
    val func_operand = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(advice_fn_name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [],
            return_type: MirType.unit(),
            is_variadic: false
        )))
    ))
    MirInst(
        kind: MirInstKind.Call(None, func_operand, []),
        span: None
    )
