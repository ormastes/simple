# MIR AOP Injection — Advice Call Insertion into MIR Functions
#
# Provides functions to inject advice calls (before/after/around) into
# MIR function blocks. Used by the driver's weave_aop() step.

use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.{
    LocalKind, MirConstValue, MirType, MirTypeDef, MirTypeKind, MirSignature
}
use compiler.hir.hir_types.{SymbolId}
use compiler.frontend.core.aop.{MirBlockInfo, InstructionInfo, WeavingResult, AdviceCallInfo, JoinPointKind}
use compiler.mir.mir_json.{serialize_mir_signature}
use compiler.common.structural_contracts.aop.{
    PREPARED_ADVICE_SLOT_SCHEMA_ID, PREPARED_ADVICE_SLOT_SCHEMA_VERSION,
    PreparedAdviceSlotPlan, prepared_advice_slot_plan_create
}

struct PreparedAdviceInjection:
    function: MirFunction
    slot: PreparedAdviceSlotPlan?

# ============================================================================
# AOP Weave Accounting (W2-B)
# ============================================================================
# Tracks how many advices were requested vs. actually woven into MIR so that
# generation backends (e.g. VHDL) can record `aop_weave_count` in their
# generation manifest and fail closed when requested aspects were not woven
# (a silently dropped aspect would remove woven debug/JTAG logic from RTL).

var g_aop_advices_requested: i64 = 0
var g_aop_weave_count: i64 = 0

pub fn aop_weave_accounting_reset(requested: i64):
    g_aop_advices_requested = requested
    g_aop_weave_count = 0

pub fn aop_weave_accounting_add(inserted: i64):
    g_aop_weave_count = g_aop_weave_count + inserted

pub fn aop_advices_requested() -> i64:
    g_aop_advices_requested

pub fn aop_weave_count() -> i64:
    g_aop_weave_count

# ============================================================================
# Before Advice Injection
# ============================================================================

fn inject_before_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn at the beginning of the entry block."""
    if func.blocks.len() == 0:
        return func
    var new_blocks: [MirBlock] = []
    var bi = 0
    while bi < func.blocks.len():
        val block = func.blocks[bi]
        if bi == 0:
            # Prepend advice call to entry block
            val call_inst = make_advice_call_inst(advice_fn_name)
            var new_insts: [MirInst] = [call_inst]
            for inst in block.instructions:
                new_insts.push(inst)
            new_blocks.push(MirBlock(
                id: block.id,
                label: block.label,
                instructions: new_insts,
                terminator: block.terminator
            ))
        else:
            new_blocks.push(block)
        bi = bi + 1
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# After Success Advice Injection
# ============================================================================

fn inject_after_success_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn before every Return terminator."""
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case Ret(_):
                val call_inst = make_advice_call_inst(advice_fn_name)
                var new_insts: [MirInst] = []
                for inst in block.instructions:
                    new_insts.push(inst)
                new_insts.push(call_inst)
                new_blocks.push(MirBlock(
                    id: block.id,
                    label: block.label,
                    instructions: new_insts,
                    terminator: block.terminator
                ))
            case _:
                new_blocks.push(block)
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# After Error Advice Injection
# ============================================================================

fn inject_after_error_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Insert a call to advice_fn at blocks that terminate abnormally.

    MirTerminator has no `Unwind` variant — the error exit is `Abort(message)`.
    The historical `case Unwind:` here was a bare identifier, i.e. an
    irrefutable BINDING pattern, so it matched EVERY terminator and this pass
    injected the after-error advice into every block of the function.
    `CallTerminator`'s `unwind` edge is deliberately not a join point here: the
    error handler is the unwind TARGET block, not the calling block, and
    injecting there would also run the advice on the normal-return path.
    """
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case MirTerminator.Abort(_):
                val call_inst = make_advice_call_inst(advice_fn_name)
                var new_insts: [MirInst] = []
                for inst in block.instructions:
                    new_insts.push(inst)
                new_insts.push(call_inst)
                new_blocks.push(MirBlock(
                    id: block.id,
                    label: block.label,
                    instructions: new_insts,
                    terminator: block.terminator
                ))
            case _:
                new_blocks.push(block)
    MirFunction(..func, blocks: new_blocks)

fn inject_advice_at_instruction(func: MirFunction, block_id: i64, instruction_index: i64, advice_fn_name: text, before: bool) -> MirFunction:
    """Insert an advice call before or after a specific MIR instruction."""
    var new_blocks: [MirBlock] = []
    for block in func.blocks:
        if block.id.id != block_id:
            new_blocks.push(block)
        else:
            val call_inst = make_advice_call_inst(advice_fn_name)
            var new_insts: [MirInst] = []
            var idx = 0
            for inst in block.instructions:
                if before and idx == instruction_index:
                    new_insts.push(call_inst)
                new_insts.push(inst)
                if not before and idx == instruction_index:
                    new_insts.push(call_inst)
                idx = idx + 1
            new_blocks.push(MirBlock(
                id: block.id,
                label: block.label,
                instructions: new_insts,
                terminator: block.terminator
            ))
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# Around Advice Injection
# ============================================================================

fn inject_around_advice(func: MirFunction, advice_fn_name: text) -> MirFunction:
    """Wrap the function entry with a call to around advice.
       The around advice receives a proceed context that calls the original body."""
    # For around advice, prepend a call at entry that passes the function name
    # as context. The around advice framework handles proceed() internally.
    if func.blocks.len() == 0:
        return func
    var new_blocks: [MirBlock] = []
    val entry_block = func.blocks[0]
    val call_inst = make_advice_call_inst(advice_fn_name)
    var new_insts: [MirInst] = [call_inst]
    for inst in entry_block.instructions:
        new_insts.push(inst)
    new_blocks.push(MirBlock(
        id: entry_block.id,
        label: entry_block.label,
        instructions: new_insts,
        terminator: entry_block.terminator
    ))
    var bi = 1
    while bi < func.blocks.len():
        new_blocks.push(func.blocks[bi])
        bi = bi + 1
    MirFunction(..func, blocks: new_blocks)

# ============================================================================
# MIR ↔ AOP Bridge
# ============================================================================

fn extract_mir_block_info(blocks: [MirBlock]) -> [MirBlockInfo]:
    """Convert real MIR blocks to AOP-compatible MirBlockInfo structs."""
    var result: [MirBlockInfo] = []
    for block in blocks:
        var infos: [InstructionInfo] = []
        var idx = 0
        for inst in block.instructions:
            val tag = classify_mir_inst_kind(inst.kind)
            infos.push(InstructionInfo(index: idx, kind_tag: tag))
            idx = idx + 1
        result.push(MirBlockInfo(id: block.id.id, instruction_kinds: infos))
    result

fn classify_mir_inst_kind(kind: MirInstKind) -> text:
    """Classify a MIR instruction kind into an AOP-relevant tag."""
    match kind:
        case BinOp(_, op, _, _):
            match op:
                case Eq: "comparison"
                case Ne: "comparison"
                case Lt: "comparison"
                case Le: "comparison"
                case Gt: "comparison"
                case Ge: "comparison"
                case _: "arithmetic"
        case Call(_, _, _): "call"
        case CallIndirect(_, _, _, _): "call"
        case Intrinsic(_, _, _): "intrinsic"
        case Store(_, _): "assignment"
        case SetField(_, _, _): "assignment"
        case VhdlSignalAssign(_, _, _): "assignment"
        case VhdlVarAssign(_, _): "assignment"
        case MirSimdStore(_, _, _): "assignment"
        case _: "other"

fn apply_weaving_result(func: MirFunction, result: WeavingResult) -> MirFunction:
    """Apply advice insertions from a WeavingResult to a MirFunction."""
    var woven = func
    for call_info in result.advice_calls:
        match call_info.join_point_kind:
            case Execution:
                woven = inject_before_advice(woven, call_info.advice_function)
            case FunctionCall:
                woven = inject_advice_at_instruction(woven, call_info.block_id, call_info.instruction_index, call_info.advice_function, true)
            case VariableAssignment:
                woven = inject_advice_at_instruction(woven, call_info.block_id, call_info.instruction_index, call_info.advice_function, false)
            case Error:
                woven = inject_after_error_advice(woven, call_info.advice_function)
            case _:
                # Decision, Condition — inject at entry for now
                woven = inject_before_advice(woven, call_info.advice_function)
    woven

# Builds one execution-slot guard per admitted phase. The runtime chain is
# already preordered, so multiple matching rules of one form still require
# exactly one phase dispatch at the business call site.
fn apply_prepared_advice_result(
    func: MirFunction,
    module_path: text,
    result: WeavingResult,
    module_types: Dict<SymbolId, MirTypeDef>
) -> Result<PreparedAdviceInjection, text>:
    var forms: [text] = []
    for call_info in result.advice_calls:
        match call_info.join_point_kind:
            case Execution:
                var form = ""
                match call_info.form:
                    case Before: form = "before"
                    case AfterSuccess: form = "after_success"
                    case AfterError: form = "after_error"
                    case Around:
                        return Err("E-AF010 runtime around advice requires an exactly-once proceed path")
                if not forms.contains(form):
                    forms.push(form)
            case _:
                ()
    if forms.len() == 0:
        if result.advice_calls.len() > 0:
            return Err("E-AF010 prepared dynamic advice currently supports execution join points only")
        return Ok(PreparedAdviceInjection(function: func, slot: nil))

    val context = prepared_advice_context_arg(func, module_types)?

    # Name alone aliases overloads. Signature JSON plus the lowering-owned
    # symbol ID is canonical for one compilation and distinguishes every body.
    val target_id = "{module_path}::{func.name}:{serialize_mir_signature(func.signature)}#symbol={func.symbol.id}"
    val slot_id = "{target_id}.prepared"
    val slot = prepared_advice_slot_plan_create(
        PREPARED_ADVICE_SLOT_SCHEMA_ID,
        PREPARED_ADVICE_SLOT_SCHEMA_VERSION,
        slot_id, target_id, forms)?
    var prepared = func
    for form in forms:
        if form == "before":
            prepared = inject_prepared_before(prepared, context, slot_id, form)?
        elif form == "after_success":
            prepared = inject_prepared_after_success(prepared, context, slot_id, form)
        elif form == "after_error":
            prepared = inject_prepared_after_error(prepared, context, slot_id, form)
    Ok(PreparedAdviceInjection(function: prepared, slot: Some(slot)))

fn prepared_advice_context_type_matches(
    type_: MirType,
    module_types: Dict<SymbolId, MirTypeDef>
) -> bool:
    match type_.kind:
        case Struct(symbol):
            module_types.contains_key(symbol) and
                module_types[symbol].name == "AspectExecutionContext"
        case Ref(referent, _):
            prepared_advice_context_type_matches(referent, module_types)
        case _: false

fn prepared_advice_context_arg(
    func: MirFunction,
    module_types: Dict<SymbolId, MirTypeDef>
) -> Result<MirOperand, text>:
    var context_index: i64 = -1
    for index in 0..func.signature.params.len():
        if prepared_advice_context_type_matches(
            func.signature.params[index], module_types):
            if context_index >= 0:
                return Err(
                    "E-AF010 prepared advice target must declare exactly one AspectExecutionContext parameter")
            context_index = index
    if context_index < 0:
        return Err(
            "E-AF010 prepared advice target must declare exactly one AspectExecutionContext parameter")

    for local in func.locals:
        match local.kind:
            case LocalKind.Arg(index):
                if index == context_index and prepared_advice_context_type_matches(
                    local.type_, module_types):
                    return Ok(MirOperand(kind: MirOperandKind.Copy(local.id)))
            case _:
                ()
    Err("E-AF010 prepared advice context parameter has no exact MIR Arg local")

fn make_prepared_advice_dispatch_inst(
    context: MirOperand,
    slot_id: text,
    form: text
) -> MirInst:
    val slot = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(slot_id), MirType(kind: MirTypeKind.Opaque("str"))))
    val phase = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(form), MirType(kind: MirTypeKind.Opaque("str"))))
    MirInst(
        kind: MirInstKind.Intrinsic(
            nil, "simple.prepared_advice_dispatch.v2", [context, slot, phase]),
        span: nil)

fn inject_prepared_before(
    func: MirFunction,
    context: MirOperand,
    slot_id: text,
    form: text
) -> Result<MirFunction, text>:
    if func.blocks.len() == 0:
        return Err("E-AF010 prepared advice target has no entry block")
    var blocks: [MirBlock] = []
    var found_entry = false
    for block in func.blocks:
        if block.id.id == func.entry_block.id:
            found_entry = true
            var instructions: [MirInst] = [
                make_prepared_advice_dispatch_inst(context, slot_id, form)]
            for inst in block.instructions:
                instructions.push(inst)
            blocks.push(MirBlock(..block, instructions: instructions))
        else:
            blocks.push(block)
    if not found_entry:
        return Err("E-AF010 prepared advice target entry block is missing")
    Ok(MirFunction(..func, blocks: blocks))

fn inject_prepared_after_success(
    func: MirFunction,
    context: MirOperand,
    slot_id: text,
    form: text
) -> MirFunction:
    var blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case Ret(_):
                var instructions = block.instructions
                instructions.push(
                    make_prepared_advice_dispatch_inst(context, slot_id, form))
                blocks.push(MirBlock(..block, instructions: instructions))
            case _: blocks.push(block)
    MirFunction(..func, blocks: blocks)

fn inject_prepared_after_error(
    func: MirFunction,
    context: MirOperand,
    slot_id: text,
    form: text
) -> MirFunction:
    var blocks: [MirBlock] = []
    for block in func.blocks:
        match block.terminator:
            case MirTerminator.Abort(_):
                var instructions = block.instructions
                instructions.push(
                    make_prepared_advice_dispatch_inst(context, slot_id, form))
                blocks.push(MirBlock(..block, instructions: instructions))
            case _: blocks.push(block)
    MirFunction(..func, blocks: blocks)

# ============================================================================
# Helpers
# ============================================================================

fn make_advice_call_inst(advice_fn_name: text) -> MirInst:
    """Create a MIR Call instruction to an advice function (void -> void)."""
    val func_operand = MirOperand(kind: MirOperandKind.Const(
        MirConstValue.Str(advice_fn_name),
        MirType(kind: MirTypeKind.FuncPtr(MirSignature(
            params: [],
            return_type: MirType.unit(),
            is_variadic: false
        )))
    ))
    MirInst(
        kind: MirInstKind.Call(nil, func_operand, []),
        span: nil
    )
