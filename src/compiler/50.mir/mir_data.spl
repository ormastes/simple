    me terminate_if(cond: MirOperand, then_: BlockId, else_: BlockId, condition_cursor_v1: i64 = -1):
        """Terminate current block with conditional branch."""
        if val capture = self.loop_view_capture_v1:
            var condition_node_v1 = condition_cursor_v1
            if condition_node_v1 < 0:
                match cond.kind:
                    case Copy(local): condition_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                    case Move(local): condition_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                    case Const(value, type_):
                        var operand_constant_v1 = -1
                        if operand_constant_v1 < 0:
                            match value:
                                case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
