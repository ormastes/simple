# MIR - Mid-level Intermediate Representation (Data Structures)
#
# Lower-level IR between HIR and native code generation.
# Features:
# - Explicit control flow (basic blocks, terminators)
# - Explicit memory operations (load, store, alloc)
# - SSA form (each value defined once)
# - Type-annotated values
# - Ready for optimization and codegen
#
# Split into:
# - mir_types.spl: Type system and leaf data structures (~210 lines)
# - mir_instructions.spl: Blocks, instructions, terminators, operands (~460 lines)
# - mir_data.spl: MirBuilder API + re-exports (this file)

use compiler.hir.hir_types.{SymbolId, HirType}
use compiler.hir.hir_definitions.{HirParam}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.mir.mir_types.*
use compiler.mir.mir_instructions.*
use compiler.mir.intrinsics.{MIR_STORAGE_ALLOC_OWNED_RAW_V1}
# `eprint` is not an implicit builtin under the self-hosted HIR resolver: the
# Rust seed happened to resolve it ambiently, so the three [mir-call-value]
# probes below compiled under stage2 but failed Stage 3 with
# `HIR lowering error in src/compiler/mir/mir_data.spl: unresolved name: eprint`.
# Import it explicitly, exactly as the sibling lowering file does
# (50.mir/_MirLowering/bootstrap_globals.spl:25). (2026-08-08 stage3)
use std.nogc_sync_mut.io.process_ops.{eprint}

extern fn rt_env_get(key: text) -> text

# One immutable trace-policy snapshot per outer MIR lowering. The lowering
# pipeline is process-global/serial today; nested lowering inherits the parent
# decision and restores its depth without rewriting environment variables.
var _mir_trace_scope_slot: [i64] = [0, 0, 0, 0]

pub fn mir_trace_scope_enter() -> i64:
    val previous_depth = _mir_trace_scope_slot[0]
    if previous_depth == 0:
        val compiler_trace = (rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1"
        val phase_trace = (rt_env_get("SIMPLE_COMPILER_PHASE_PROFILE") ?? "") == "1"
        val bootstrap_diag = (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1"
        _mir_trace_scope_slot[1] = if (
            compiler_trace or phase_trace or bootstrap_diag): 1 else: 0
        _mir_trace_scope_slot[2] = if (
            (rt_env_get("SIMPLE_MIRB_TRACE") ?? "") == "1"): 1 else: 0
        _mir_trace_scope_slot[3] = _mir_trace_scope_slot[3] + 1
    _mir_trace_scope_slot[0] = previous_depth + 1
    previous_depth

pub fn mir_trace_scope_exit(previous_depth: i64):
    _mir_trace_scope_slot[0] = previous_depth

pub fn mir_trace_generation() -> i64:
    _mir_trace_scope_slot[3]

pub fn mir_lowering_trace_enabled() -> bool:
    if _mir_trace_scope_slot[0] > 0:
        return _mir_trace_scope_slot[1] != 0
    ((rt_env_get("SIMPLE_COMPILER_TRACE") ?? "") == "1" or
     (rt_env_get("SIMPLE_COMPILER_PHASE_PROFILE") ?? "") == "1" or
     (rt_env_get("SIMPLE_BOOTSTRAP_DIAG") ?? "") == "1")

pub fn mir_builder_trace_enabled() -> bool:
    if _mir_trace_scope_slot[0] > 0:
        return _mir_trace_scope_slot[2] != 0
    (rt_env_get("SIMPLE_MIRB_TRACE") ?? "") == "1"

pub fn mir_trace_enabled() -> bool:
    """Shared MIR-lowering trace gate. Default OFF.

    Same idiom (and same env names) as `mir_lower_trace_enabled` in
    _MirLowering/module_lowering.spl, plus this file's own SIMPLE_MIRB_TRACE,
    so one switch turns every MIR-lowering receipt back on. Callers on hot
    paths must read this ONCE and cache it (see emit_call_value below), never
    per receipt."""
    mir_lowering_trace_enabled() or mir_builder_trace_enabled()

# ============================================================================
# MIR Builder
# ============================================================================

struct MirOwnedRawAllocationFactV1:
    base_local: LocalId
    allocation_byte_len: i64
    logical_type_id: i64
    revision: i64
    element_count: i64
    allocation_identity: text
    allocation_provenance: text
    source_revision: text

struct MirBuilder:
    """Builder for constructing MIR."""
    module: MirModule
    current_function: MirFunction?
    current_block: BlockId
    next_local_id: i64
    next_block_id: i64
    locals: [MirLocal]
    blocks: [MirBlock]
    instructions: [MirInst]
    # DS5 (mir-span-thread, 2026-07-28): source span attributed to whatever
    # HIR node is *currently* being lowered. Seeded per-function from
    # begin_function's span, then stacked (save/set/restore) around each
    # lower_stmt / lower_expr entry so nested emit_* calls stamp the
    # innermost node's real span instead of a hardcoded `nil`. See
    # expr_dispatch.spl::lower_expr and mir_lowering_stmts.spl::lower_stmt
    # for the save/restore wrappers that maintain this stack discipline.
    current_span: Span?

impl MirBuilder:
    static fn new() -> MirBuilder:
        MirBuilder(
            module: MirModule(
                name: "",
                functions: {},
                statics: {},
                constants: {},
                types: {}
            ),
            current_function: nil,
            current_block: BlockId.entry(),
            next_local_id: 0,
            next_block_id: 1,
            locals: [],
            blocks: [],
            instructions: [],
            current_span: nil
        )

    # ========================================================================
    # Function Building
    # ========================================================================

    me begin_function(symbol: SymbolId, name: text, signature: MirSignature, span: Span):
        """Begin building a new function."""
        self.current_function = Some(MirFunction(
            symbol: symbol,
            name: name,
            signature: signature,
            locals: [],
            blocks: [],
            entry_block: BlockId.entry(),
            span: span,
            generic_params: [],
            is_generic_template: false,
            specialization_of: nil,
            type_bindings: {},
            layout_phase: nil,
            is_kernel: false,
            gpu_target: "",
            gpu_backend_order: "",
            is_export_c: false,
            export_name: "",
            has_driver_manifest_attr: false,
            driver_manifest_attr: nil,
            has_vhdl_metadata: false,
            vhdl_metadata: vhdl_hardware_metadata_default(),
            has_fast_math: false,
            unroll_factor: 0,
            pipeline_ii: 0,
            memory_banks: 0,
            verification_contract: nil
        ))
        self.next_local_id = 0
        self.next_block_id = 1
        self.locals = []
        self.blocks = []
        self.instructions = []
        self.current_block = BlockId.entry()
        # DS5: seed the per-function default span from the function's own
        # declaration span. lower_stmt/lower_expr push a more specific span
        # while lowering a given node and restore this on the way back out,
        # so anything emitted with no narrower node in scope (e.g. synthetic
        # prologue instructions) still carries a real, in-function location
        # instead of nil.
        self.current_span = Some(span)
        if mir_builder_trace_enabled():
            print "MIRB begin {name} post-reset blocks={self.blocks.len()} locals={self.locals.len()}"

        # Create entry block
        self.blocks = self.blocks.push(MirBlock(
            id: BlockId.entry(),
            label: Some("entry"),
            instructions: [],
            terminator: MirTerminator.Unreachable  # Placeholder
        ))

        if (rt_env_get("SIMPLE_BOOTSTRAP") ?? "") != "1":
            # Create return local
            if signature.return_type.kind != MirTypeKind.Unit:
                self.new_local(Some("_return"), signature.return_type, LocalKind.Return)

        # NOTE(#133): parameter locals are created unconditionally, including
        # under SIMPLE_BOOTSTRAP. HIR param lowering was fixed (declaration_lowering.spl
        # lower_function) to stop dropping params under bootstrap, so `signature.params`
        # is now correctly populated -- but this loop was still gated off, so no
        # `LocalKind.Arg(i)` locals ever got created for bootstrap functions. Without
        # them, function_lowering.spl's param-to-local mapping fell back to a phantom
        # `LocalId(id: pli+1)` that was never registered as a real local (and collided
        # with body-local ids, which also start counting from 0/1), so the codegen's
        # Arg-local scan (core_codegen.spl) found nothing and emitted a zero-param
        # `define`, while body references to the param read as `undef`. Creating the
        # Arg locals here fixes both: real params on `define`, and body identifier
        # references resolve to the correct local.
        # `_return` local creation stays bootstrap-gated -- 0-param bootstrap functions
        # (e.g. `bootstrap_version`, which returns `text`) already work today without
        # it, so this is left untouched to avoid an unrelated behavior change.
        for i in 0..signature.params.len():
            self.new_local(nil, signature.params[i], LocalKind.Arg(i))

    me end_function() -> MirFunction:
        """Finish building current function and return it."""
        # Finalize current block
        self.finalize_block()

        var fn_ = match self.current_function:
            case Some(active_function):
                active_function
            case None:
                MirFunction(
                symbol: SymbolId.new(-1),
                name: "<invalid>",
                signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
                locals: [],
                blocks: [],
                entry_block: BlockId.entry(),
                span: nil,
                generic_params: [],
                is_generic_template: false,
                specialization_of: nil,
                type_bindings: {},
                layout_phase: nil,
                is_kernel: false,
                gpu_target: "",
                gpu_backend_order: "",
                is_export_c: false,
                export_name: "",
                has_driver_manifest_attr: false,
                driver_manifest_attr: nil,
                has_vhdl_metadata: false,
                vhdl_metadata: vhdl_hardware_metadata_default(),
                has_fast_math: false,
                unroll_factor: 0,
                pipeline_ii: 0,
                memory_banks: 0,
                verification_contract: nil
                )
        fn_.locals = self.locals
        fn_.blocks = self.blocks
        self.current_function = nil
        if mir_builder_trace_enabled():
            var first_insts = -1
            if fn_.blocks.len() > 0:
                first_insts = fn_.blocks[0].instructions.len()
            print "MIRB end {fn_.name} blocks={fn_.blocks.len()} b0_insts={first_insts} locals={fn_.locals.len()}"
        return fn_

    me add_function(fn_: MirFunction):
        """Add a completed function to the module."""
        var functions = self.module.functions
        functions[fn_.symbol] = fn_
        self.module.functions = functions

    # ========================================================================
    # Local Variables
    # ========================================================================

    me new_local(name: text?, type_: MirType, kind: LocalKind) -> LocalId:
        """Create a new local variable."""
        val id = LocalId(id: self.next_local_id)
        self.next_local_id = self.next_local_id + 1

        self.locals = self.locals.push(MirLocal(
            id: id,
            name: name,
            type_: type_,
            kind: kind,
            is_ghost: false
        ))

        id

    me new_temp(type_: MirType) -> LocalId:
        """Create a new temporary."""
        self.new_local(nil, type_, LocalKind.Temp)

    me set_local_name(id: LocalId, name: text):
        """Assign a source-level name to an existing local.

        Used to thread real HIR parameter names onto the MIR arg locals that
        begin_function creates nameless from the (types-only) MirSignature, so
        backends emit real port names (e.g. imem_rdata) instead of arg0/arg1.
        """
        var updated: [MirLocal] = []
        var i = 0
        while i < self.locals.len():
            val loc = self.locals[i]
            if loc.id.id == id.id:
                updated = updated.push(MirLocal(
                    id: loc.id,
                    name: Some(name),
                    type_: loc.type_,
                    kind: loc.kind,
                    is_ghost: loc.is_ghost
                ))
            else:
                updated = updated.push(loc)
            i = i + 1
        self.locals = updated

    me set_local_type(id: LocalId, ty: MirType):
        """Retype an existing local (mirror of set_local_name).

        Used to thread an inferred result type onto a value-position
        match/if merge temp after its arms are lowered — the temp is
        created i64 before any arm type is known, and downstream consumers
        (print's numeric-coercion check, spill slots) read the local's MIR
        type. Instructions reference locals by id, so a post-hoc retype is
        safe."""
        var updated: [MirLocal] = []
        var i = 0
        while i < self.locals.len():
            val loc = self.locals[i]
            if loc.id.id == id.id:
                updated = updated.push(MirLocal(
                    id: loc.id,
                    name: loc.name,
                    type_: ty,
                    kind: loc.kind,
                    is_ghost: loc.is_ghost
                ))
            else:
                updated = updated.push(loc)
            i = i + 1
        self.locals = updated

    # ========================================================================
    # Basic Blocks
    # ========================================================================

    me new_block(label: text?) -> BlockId:
        """Create a new basic block."""
        val id = BlockId.new(self.next_block_id)
        self.next_block_id = self.next_block_id + 1

        self.blocks = self.blocks.push(MirBlock(
            id: id,
            label: label,
            instructions: [],
            terminator: MirTerminator.Unreachable  # Placeholder
        ))

        id

    me switch_to_block(block: BlockId):
        """Switch to building a different block."""
        self.finalize_block()
        self.current_block = block
        self.instructions = []

    me finalize_block():
        """Finalize current block with accumulated instructions."""
        # Hypothesis probe (bootstrap_stage2_empty_mir_bodies_2026-07-05):
        # the Stage-2 instruction loss is localised to this ONE statement --
        # `self.builder` holds 3 finalized instructions immediately before
        # `end_function`, and `end_function`'s own trace, one call later,
        # reports 0. If the early return below fails to fire when pending IS
        # empty (measured 0 at that point), control reaches
        # `block.instructions = self.instructions` and overwrites the already
        # finalized instructions with the empty pending list. Print the length
        # AND the predicate's own answer AND whether the return is taken, so
        # the three are distinguishable. Reuses this file's existing
        # SIMPLE_MIRB_TRACE gate; default OFF.
        val fb_pending_len = self.instructions.len()
        val fb_is_empty = self.instructions.is_empty()
        val fb_trace = (rt_env_get("SIMPLE_MIRB_TRACE") ?? "") == "1"
        if fb_trace:
            print "MIRB finalize pending_len={fb_pending_len} is_empty={fb_is_empty} block={self.current_block.id}"
        if self.instructions.is_empty():
            if fb_trace:
                print "MIRB finalize early-return-taken"
            return
        if fb_trace:
            print "MIRB finalize FELL-THROUGH pending_len={fb_pending_len}"

        # Find and update current block
        var found = false
        for i in 0..self.blocks.len():
            if self.blocks[i].id.id == self.current_block.id:
                var block = self.blocks[i]
                block.instructions = self.instructions
                self.blocks[i] = block
                found = true
                break

        self.instructions = []

    # ========================================================================
    # Instructions
    # ========================================================================

    me emit(inst: MirInst):
        """Emit an instruction to current block."""
        self.instructions.push(inst)

    me emit_const(dest: LocalId, value: MirConstValue, type_: MirType):
        """Emit a constant load."""
        self.emit(MirInst(
            kind: MirInstKind.Const(dest, value, type_),
            span: self.current_span
        ))

    me emit_const_int(value: i64) -> LocalId:
        """Emit an integer constant and return its local."""
        val dest = self.new_temp(MirType.i64())
        self.emit_const(dest, MirConstValue.Int(value), MirType.i64())
        dest

    me emit_const_float(value: f64) -> LocalId:
        """Emit a float constant and return its local."""
        val dest = self.new_temp(MirType.f64())
        self.emit_const(dest, MirConstValue.Float(value), MirType.f64())
        dest

    me emit_const_bool(value: bool) -> LocalId:
        """Emit a boolean constant and return its local."""
        val dest = self.new_temp(MirType.bool())
        self.emit_const(dest, MirConstValue.Bool(value), MirType.bool())
        dest

    me emit_copy(dest: LocalId, src: LocalId):
        """Emit a copy instruction."""
        self.emit(MirInst(
            kind: MirInstKind.Copy(dest, src),
            span: self.current_span
        ))

    me emit_move(dest: LocalId, src: LocalId):
        """Emit a move instruction.

        SF1 audit (2026-07-28): Simple's surface language currently has NO
        semantically-true move sites — assignment is copy for value types
        (structs/arrays) and reference-share for classes (s19
        mutation-by-design, see _MirLowering/function_lowering.spl class
        param binding); there is no `move` keyword in the frontend; and the
        `iso` (Isolated) move-only capability parses as a type
        (parser_types_expr.spl) but is erased to Infer at HIR type lowering
        (hir_lowering/types.spl "Infer / Atomic / Isolated" arm). So this
        builder has no surface-lowering caller yet by DESIGN, not by
        omission. When iso-capability lowering lands, iso-typed
        variable-to-variable assignment is the genuine move site to wire
        here. The NLL checker's Move handling is real and spec-proven via
        hand-built MIR (test/01_unit/compiler/borrow/borrow_check_spec.spl).
        """
        self.emit(MirInst(
            kind: MirInstKind.Move(dest, src),
            span: self.current_span
        ))

    me emit_drop(local: LocalId):
        """WP-E: emit a drop edge for an owned `resource`-typed local (see
        MirInstKind.Drop's docstring, mir_instruction_kinds.spl). Callers are
        responsible for exactly-once placement -- MirLowering.
        emit_pending_resource_drops (mir_lowering_stmts.spl) tracks which
        locals have already been consumed (moved out, returned, or already
        `.close()`d) so this is never called twice for the same local on the
        same control-flow path."""
        self.emit(MirInst(
            kind: MirInstKind.Drop(local),
            span: self.current_span
        ))

    me emit_binop(op: MirBinOp, left: MirOperand, right: MirOperand, type_: MirType) -> LocalId:
        """Emit a binary operation and return result local."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.BinOp(dest, op, left, right),
            span: self.current_span
        ))
        dest

    me emit_unary(op: MirUnaryOp, operand: MirOperand, type_: MirType) -> LocalId:
        """Emit a unary operation and return result local."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.UnaryOp(dest, op, operand),
            span: self.current_span
        ))
        dest

    me emit_ref(place: MirPlace, borrow_kind: MirBorrowKind, type_: MirType) -> LocalId:
        """Emit a borrow reference and return result local."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.Ref(dest, borrow_kind, place),
            span: self.current_span
        ))
        dest

    me emit_load(ptr: MirOperand, type_: MirType) -> LocalId:
        """Emit a load instruction."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.Load(dest, ptr),
            span: self.current_span
        ))
        dest

    me emit_store(ptr: MirOperand, value: MirOperand):
        """Emit a store instruction."""
        self.emit(MirInst(
            kind: MirInstKind.Store(ptr, value),
            span: self.current_span
        ))

    me emit_alloc(type_: MirType) -> LocalId:
        """Emit an allocation."""
        val dest = self.new_temp(MirType.ptr(type_, true))
        self.emit(MirInst(
            kind: MirInstKind.Alloc(dest, type_),
            span: self.current_span
        ))
        dest

    me emit_typed_storage_alloc_owned_raw_v1(
        pointee_type: MirType, allocation_byte_len: i64, logical_type_id: i64,
        revision: i64, element_count: i64, allocation_identity: text,
        allocation_provenance: text, source_revision: text
    ) -> MirOwnedRawAllocationFactV1:
        """Emit an exact compiler-owned raw fixed-record allocation.

        This operation is compiler-private and must be consumed by the typed
        storage producer before backend optimization/codegen.
        """
        val dest = self.new_temp(MirType.ptr(pointee_type, true))
        self.emit(MirInst(kind: MirInstKind.Intrinsic(Some(dest),
            MIR_STORAGE_ALLOC_OWNED_RAW_V1, [
                MirOperand.const_int(allocation_byte_len),
                MirOperand.const_int(logical_type_id),
                MirOperand.const_int(revision),
                MirOperand.const_int(element_count),
                MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(allocation_identity),
                    MirType(kind: MirTypeKind.Opaque("str"))))
            ]), span: self.current_span))
        MirOwnedRawAllocationFactV1(base_local: dest,
            allocation_byte_len: allocation_byte_len,
            logical_type_id: logical_type_id, revision: revision,
            element_count: element_count,
            allocation_identity: allocation_identity,
            allocation_provenance: allocation_provenance,
            source_revision: source_revision)

    me emit_entry_alloc(type_: MirType) -> LocalId:
        """Emit a fixed-lifetime allocation in the function entry block."""
        val dest = self.new_temp(MirType.ptr(type_, true))
        val alloc = MirInst(kind: MirInstKind.Alloc(dest, type_), span: self.current_span)
        if self.current_block.id == BlockId.entry().id:
            self.emit(alloc)
        else:
            var entry = self.blocks[0]
            entry.instructions = entry.instructions.push(alloc)
            self.blocks[0] = entry
        dest

    me emit_call(func: MirOperand, args: [MirOperand], return_type: MirType) -> LocalId?:
        """Emit a function call."""
        # Bare-lift (no explicit Some): an explicit Some(...) builds a heap
        # Option box on the stage4 native lane; downstream readers of the
        # flat LocalId? payload then see the box header as the id.
        val dest: LocalId? = if return_type.kind != MirTypeKind.Unit: self.new_temp(return_type) else: nil

        self.emit(MirInst(
            kind: MirInstKind.Call(dest, func, args),
            span: self.current_span
        ))

        dest

    me emit_call_value(func: MirOperand, args: [MirOperand], return_type: MirType) -> LocalId:
        """Emit a function call whose non-unit result is required."""
        # Level-gated behind this file's existing SIMPLE_MIRB_TRACE gate (see
        # lines 113/186). These probes were unconditional, which on a hot path
        # (every non-unit call emit) floods stderr for the whole build; they are
        # retained, not deleted, per the log-retention policy. (2026-08-08)
        val mirb_trace = mir_builder_trace_enabled()
        if mirb_trace:
            eprint("[mir-call-value] new-temp-before next={self.next_local_id}\n")
        val dest = self.new_temp(return_type)
        if mirb_trace:
            eprint("[mir-call-value] new-temp-after id={dest.id} next={self.next_local_id}\n")
        self.emit(MirInst(
            kind: MirInstKind.Call(dest, func, args),
            span: self.current_span
        ))
        if mirb_trace:
            eprint("[mir-call-value] emit-after id={dest.id}\n")
        dest

    me emit_call_indirect(ptr: MirOperand, args: [MirOperand], sig: MirSignature, return_type: MirType) -> LocalId?:
        """Emit an indirect function call (through closure or function pointer)."""
        # Bare-lift (no explicit Some): an explicit Some(...) builds a heap
        # Option box on the stage4 native lane; downstream readers of the
        # flat LocalId? payload then see the box header as the id.
        val dest: LocalId? = if return_type.kind != MirTypeKind.Unit: self.new_temp(return_type) else: nil

        self.emit(MirInst(
            kind: MirInstKind.CallIndirect(dest, ptr, args, sig),
            span: self.current_span
        ))

        dest

    me emit_cast(operand: MirOperand, target: MirType) -> LocalId:
        """Emit a type cast."""
        val dest = self.new_temp(target)
        self.emit(MirInst(
            kind: MirInstKind.Cast(dest, operand, target),
            span: self.current_span
        ))
        dest

    me emit_bitcast(operand: MirOperand, target: MirType) -> LocalId:
        val dest = self.new_temp(target)
        self.emit(MirInst(
            kind: MirInstKind.Bitcast(dest, operand, target),
            span: self.current_span
        ))
        dest

    me emit_aggregate(kind: AggregateKind, operands: [MirOperand], type_: MirType) -> LocalId:
        """Emit aggregate construction."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.Aggregate(dest, kind, operands),
            span: self.current_span
        ))
        dest

    me emit_get_field(base: MirOperand, field: i64, type_: MirType) -> LocalId:
        """Emit field access."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.GetField(dest, base, field),
            span: self.current_span
        ))
        dest

    me emit_set_field(base: MirOperand, field: i64, value: MirOperand):
        """Emit field assignment."""
        self.emit(MirInst(
            kind: MirInstKind.SetField(base, field, value),
            span: self.current_span
        ))

    me emit_gep(base: MirOperand, indices: [MirOperand], type_: MirType) -> LocalId:
        """Emit GetElementPtr instruction."""
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.GetElementPtr(dest, base, indices),
            span: self.current_span
        ))
        dest

    # ========================================================================
    # Terminators
    # ========================================================================

    me terminate_goto(target: BlockId):
        """Terminate current block with unconditional jump."""
        self.set_terminator(MirTerminator.Goto(target))

    me terminate_return(value: MirOperand?):
        """Terminate current block with return."""
        self.set_terminator(MirTerminator.Ret(value))

    me terminate_if(cond: MirOperand, then_: BlockId, else_: BlockId):
        """Terminate current block with conditional branch."""
        self.set_terminator(MirTerminator.If(cond, then_, else_))

    me terminate_switch(value: MirOperand, targets: [SwitchCase], default: BlockId):
        """Terminate current block with switch.

        B5b dormant-bug fix: previously declared targets as [(i64, BlockId)]
        which was incompatible with MirTerminator.Switch (which takes
        [SwitchCase]). Zero callers existed when this was discovered; the
        signature is now corrected so the MatchCase MIR lowerer can call it.
        """
        self.set_terminator(MirTerminator.Switch(value, targets, default))

    me terminate_unreachable():
        """Terminate current block as unreachable."""
        self.set_terminator(MirTerminator.Unreachable)

    me terminate_abort(message: text):
        """Terminate current block with a diverging abort.

        Until this existed there were ZERO `MirTerminator.Abort(...)`
        construction sites anywhere in `src/**` -- the variant was declared
        (mir_instruction_support.spl) and handled by every backend, but
        nothing ever built one, so no MIR block was ever marked as
        non-returning. A diverging construct (`panic(...)`) therefore lowered
        to an ordinary Call and left the block falling through into whatever
        came next, which is exactly the failure the isel fix in 30743ecd674
        (Abort/CallTerminator lowering to a bare NOP) was about at the other
        end of the pipeline. Backends lower Abort to a hard trap: INT3 on
        x86_64, BRK #0 on aarch64, EBREAK on riscv32/64.
        """
        self.set_terminator(MirTerminator.Abort(message))

    me set_terminator(term: MirTerminator):
        """Set terminator for current block."""
        self.finalize_block()

        for i in 0..self.blocks.len():
            if self.blocks[i].id.id == self.current_block.id:
                var block = self.blocks[i]
                block.terminator = term
                self.blocks[i] = block
                break

    fn current_block_has_explicit_terminator() -> bool:
        for block in self.blocks:
            if block.id.id == self.current_block.id:
                match block.terminator:
                    case Unreachable:
                        return false
                    case _:
                        return true
        false

    # ========================================================================
    # Convenience Methods (for interpreter compatibility)
    # ========================================================================

    me begin_simple_function(name: text, return_type_kind: text):
        """Begin a function with simple return type.
        return_type_kind: "i64", "f64", "bool", "unit", "void"
        """
        var ret_type = MirType(kind: MirTypeKind.Unit)
        if return_type_kind == "i64":
            ret_type = MirType(kind: MirTypeKind.I64)
        elif return_type_kind == "f64":
            ret_type = MirType(kind: MirTypeKind.F64)
        elif return_type_kind == "bool":
            ret_type = MirType(kind: MirTypeKind.Bool)

        val sig = MirSignature(params: [], return_type: ret_type, is_variadic: false)
        val sym = SymbolId(id: self.module.functions.len())
        self.begin_function(sym, name, sig, nil)

    me emit_const_str(value: text) -> LocalId:
        """Emit a string constant and return its local."""
        val str_type = MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.I8), false))
        val dest = self.new_temp(str_type)
        self.emit_const(dest, MirConstValue.Str(value), str_type)
        dest

    me emit_void_call(func_name: text, args: [LocalId]):
        """Emit a void call to a named function."""
        val func_type = MirType(kind: MirTypeKind.Unit)
        var operands: [MirOperand] = []
        for a in args:
            operands.push(MirOperand(kind: MirOperandKind.Copy(a)))

        val func_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(func_name),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                params: [],
                return_type: func_type,
                is_variadic: false
            )))
        ))

        self.emit(MirInst(
            kind: MirInstKind.Call(nil, func_op, operands),
            span: self.current_span
        ))

    me terminate_return_copy(local: LocalId):
        """Terminate with return copying a local."""
        self.set_terminator(MirTerminator.Ret(
            MirOperand(kind: MirOperandKind.Copy(local))
        ))

    me terminate_return_void():
        """Terminate with void return."""
        self.set_terminator(MirTerminator.Ret(nil))

