# --------------------------------------------------------------------------
# Bootstrap call-return-type registry (native_call_return_type_loss 2026-07-23)
#
# In the bootstrap flat path a call site's SymbolId often cannot recover the
# callee's HirTypeKind.Function (symbol-table mutations don't survive the
# HIR->MIR pass boundary), so call dests degraded to i64 and every
# static-type consumer (interpolation, concat coercion) mis-rendered
# text-returning calls as raw integers. The bootstrap prep loops register
# each function's declared MIR return type here (bare + qualified names,
# accumulated ACROSS modules for cross-module calls);
# bootstrap_resolved_call_return_type consults it before the i64 fallback.
# Lives in mir_data (not mir_lowering) so _MirLoweringExpr can import it
# without an import cycle.
# Deliberately has NO reset: the registry must accumulate across ALL closure
# modules because cross-module call sites need the callee module's declared
# types, and the native-build worker is one process per build. See the design
# note at bootstrap_globals.spl (bootstrap_mir_functions_reset). A reset would
# also be inert on the common path — the reader consults the HIR symbol table
# first and registration is Str-returns only.
var _bootstrap_fn_ret_types: Dict<text, MirType> = {}

fn bootstrap_fn_ret_type_register(name: text, ty: MirType):
    _bootstrap_fn_ret_types[name] = ty

fn bootstrap_fn_ret_type_lookup(name: text) -> MirType?:
    # contains_key + [] rather than .get(): Dict.get returns nil on present
    # keys in the interpreter lane (known quirk).
    if _bootstrap_fn_ret_types.contains_key(name):
        return Some(_bootstrap_fn_ret_types[name])
    nil

# HIR-typed declared-return registry, name-keyed, accumulated across ALL
# closure modules in the flat pre-pass (bootstrap_register_flat_function_values).
# Symbol IDs are per-module-table, so id-keyed maps can't answer for a callee
# defined in another module; without this a cross-module call to an `-> i32`
# fn defaulted to the erased i64 return and 32-bit targets read the a0/a1
# REGISTER PAIR — garbage a1 OR'd into every i32 result (NVMe rv32 fw
# mask-361, 2026-07-24). Duplicate free-fn names (e.g. two `main`s) are marked
# ambiguous and never answered.
var _bootstrap_fn_ret_hir_types: Dict<text, HirType> = {}
var _bootstrap_fn_ret_hir_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_hir_type_register(name: text, ty: HirType):
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        _bootstrap_fn_ret_hir_ambig[name] = true
        _bootstrap_fn_ret_hir_types = _bootstrap_fn_ret_hir_types.remove(name)
        return
    _bootstrap_fn_ret_hir_types[name] = ty

fn bootstrap_fn_ret_hir_type_lookup(name: text) -> HirType?:
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        return Some(_bootstrap_fn_ret_hir_types[name])
    nil

# Canonical callable return shape accumulated across flat closure modules.
# Values are module-qualified aggregate layout keys or "__runtime_array__".
var _bootstrap_fn_ret_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_shapes.contains_key(name):
        if _bootstrap_fn_ret_shapes[name] != shape:
            _bootstrap_fn_ret_shape_ambig[name] = true
            _bootstrap_fn_ret_shapes = _bootstrap_fn_ret_shapes.remove(name)
        return
    _bootstrap_fn_ret_shapes[name] = shape

fn bootstrap_fn_ret_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_shapes[name])
    nil

# Result<T, E>'s Ok-payload struct/class layout key, name-keyed like the plain
# return-shape registry above. Needed because a Result<T,E> return type's
# inner `ok_type` is an HirTypeKind.Named(SymbolId) whose SymbolId was minted
# in the DEFINING module's own per-module SymbolTable id-space
# (native_build_cross_module_result_payload_struct_name_collision_2026-08-09,
# 6th/7th layer): re-deferencing that id against a DIFFERENT module's
# `self.symbols` (entry-closure lowering replaces the active SymbolTable per
# module) can coincidentally land on an unrelated symbol with the same
# numeric id (e.g. a sibling Method), silently mis-resolving the payload's
# struct name. Registered here, name-keyed, at prescan time — while
# `module.symbols` is still the DEFINING module's own, self-consistent table —
# so consumers never need to dereference the foreign id at all.
var _bootstrap_fn_ret_ok_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_ok_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_ok_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_ok_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_ok_shapes.contains_key(name):
        if _bootstrap_fn_ret_ok_shapes[name] != shape:
            _bootstrap_fn_ret_ok_shape_ambig[name] = true
            _bootstrap_fn_ret_ok_shapes = _bootstrap_fn_ret_ok_shapes.remove(name)
        return
    _bootstrap_fn_ret_ok_shapes[name] = shape

fn bootstrap_fn_ret_ok_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_ok_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_ok_shapes[name])
    nil

# Companion PARAM-type registry (same ambiguity set as returns): without it a
# cross-module call to `fn f(a: i32, b: i64)` erased both params to i64 — on
# rv32 ilp32 the caller then marshaled the i64 into the wrong (unaligned)
# register pair while the callee read the ABI-correct one (band/policy/dram/
# target section failures, 2026-07-24).
var _bootstrap_fn_param_hir_types: Dict<text, [HirType]> = {}

fn bootstrap_fn_param_hir_types_register(name: text, tys: [HirType]):
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        if _bootstrap_fn_param_hir_types.contains_key(name):
            _bootstrap_fn_param_hir_types = _bootstrap_fn_param_hir_types.remove(name)
        return
    _bootstrap_fn_param_hir_types[name] = tys

fn bootstrap_fn_param_hir_types_lookup(name: text) -> [HirType]?:
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_param_hir_types.contains_key(name):
        return Some(_bootstrap_fn_param_hir_types[name])
    nil

# Per-parameter DEFAULT-expression registry.
#
# `35.semantics/resolve.spl:fill_call_defaults` is the only other default-fill
# machinery and it is NOT on the AOT lane at all (proven by instrumentation:
# `dbg-fill: 0` under `native-build`), so an omitted trailing defaulted
# argument reached the callee as an UNINITIALIZED register/stack slot -- the
# callee read garbage, not the declared default
# (doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md).
# The pad now happens in MIR call lowering, which every call kind (same-module
# free function, cross-module callee, instance/static method) passes through.
#
# Whole `HirParam`s are stored, not just the default expressions, because the
# pad must know per-index `has_default` as well as the declared arity. For
# INSTANCE methods `HirFunction.params[0]` is the implicit `self`
# (20.hir/hir_lowering/_Items/declaration_lowering.spl:317) and the lowered MIR
# call likewise carries the receiver as arg 0, so index alignment holds for
# free functions, static methods and instance methods alike.
#
# Ambiguity policy is STRICTER than the sibling registries above: padding the
# wrong callee would inject a bogus argument, so any name that two definitions
# disagree on (different arity, or a different has_default pattern) is dropped
# and never answered. Same-shape duplicates are harmless and keep the first.
var _bootstrap_fn_param_defaults: Dict<text, [HirParam]> = {}
var _bootstrap_fn_param_defaults_ambig: Dict<text, bool> = {}

fn _fn_param_defaults_shape(params: [HirParam]) -> text:
    var shape = ""
    for p in params:
        shape = shape + (if p.has_default: "D" else: "-")
    shape

fn bootstrap_fn_param_defaults_register(name: text, params: [HirParam]):
    if name == "" or _bootstrap_fn_param_defaults_ambig.contains_key(name):
        return
    var any_default = false
    for p in params:
        if p.has_default:
            any_default = true
    if not any_default:
        # Nothing to pad. Still record the arity shape so a LATER same-name
        # definition that DOES have defaults is recognised as ambiguous
        # rather than silently winning.
        if _bootstrap_fn_param_defaults.contains_key(name):
            if _fn_param_defaults_shape(_bootstrap_fn_param_defaults[name]) != _fn_param_defaults_shape(params):
                _bootstrap_fn_param_defaults_ambig[name] = true
                _bootstrap_fn_param_defaults = _bootstrap_fn_param_defaults.remove(name)
        return
    if _bootstrap_fn_param_defaults.contains_key(name):
        if _fn_param_defaults_shape(_bootstrap_fn_param_defaults[name]) != _fn_param_defaults_shape(params):
            _bootstrap_fn_param_defaults_ambig[name] = true
            _bootstrap_fn_param_defaults = _bootstrap_fn_param_defaults.remove(name)
        return
    _bootstrap_fn_param_defaults[name] = params

fn bootstrap_fn_param_defaults_lookup(name: text) -> [HirParam]?:
    if _bootstrap_fn_param_defaults_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_param_defaults.contains_key(name):
        return Some(_bootstrap_fn_param_defaults[name])
    nil

