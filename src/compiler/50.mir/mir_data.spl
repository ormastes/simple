                                            case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                        if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                            capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                            operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                            var operand_type_v1 = -1
                            if operand_type_v1 < 0:
                                match type_.kind:
                                    case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                    case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                    case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                    case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                    case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                    case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                    case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                    case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                    case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                    case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                    case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                    case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                    case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                    case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                    case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                    case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                    case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                    case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                    case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                    case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                    case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                    case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                    case Bits(width, signed):
                                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                            capture.accept(type_writer_v1.scalar(0, width))
                                            capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                            operand_type_v1 = capture.node(type_writer_v1.finish())
                                    case Opaque(name):
                                        var type_text_v1: i64 = -1
                                        match capture.owner().reserve_text(name.len()):
                                            case Err(error): capture.fail(error)
                                            case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                            capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                            operand_type_v1 = capture.node(type_writer_v1.finish())
                                    case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                    case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                            value_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
                capture.charge_edges(targets.len() + 1)
                if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermSwitch):
                    capture.accept(term_writer_v1.scalar(0, default.id))
                    capture.accept(term_writer_v1.child(value_node_v1))
                    for arm_v1 in targets:
                        val case_value_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, arm_v1.value)
                        if val arm_writer_v1 = capture.start(MirLoopShapeTagV1.SwitchArm):
                            capture.accept(arm_writer_v1.scalar(0, arm_v1.target.id))
                            capture.accept(arm_writer_v1.child(case_value_v1))
                            capture.accept(term_writer_v1.child(capture.node(arm_writer_v1.finish())))
                    capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Switch(value, targets, default))

    me terminate_unreachable():
        """Terminate current block as unreachable."""
        if val capture = self.loop_view_capture_v1:
            capture.charge_edges(0)
            if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermUnreachable):
                capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Unreachable)

    me terminate_abort(message: text):
        """Terminate current block with a diverging abort.

        Until this existed there were ZERO `MirTerminator.Abort(...)`
        construction sites anywhere in `src/**` -- the variant was declared
        (mir_instruction_support.spl) and handled by every backend, but
        nothing ever built one, so no MIR block was ever marked as
        non-returning. A diverging construct (`panic(...)`) therefore lowered
        to an ordinary Call and left the block falling through into whatever
        came next, which is exactly the failure the isel fix in 30743ecd674
        (Abort/CallTerminator lowering to a bare NOP) was about at the other
        end of the pipeline. Backends lower Abort to a hard trap: INT3 on
        x86_64, BRK #0 on aarch64, EBREAK on riscv32/64.
        """
        if val capture = self.loop_view_capture_v1:
            var message_text_v1: i64 = -1
            match capture.owner().reserve_text(message.len()):
                case Err(error): capture.fail(error)
                case Ok(permit): message_text_v1 = capture.node(permit.publish(message))
            if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermAbort):
                capture.accept(term_writer_v1.text_id(0, message_text_v1))
                capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Abort(message))

    me terminate_throw(payload: MirOperand, type_tag: MirOperand):
        """Start recoverable exception propagation without allocation."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return
        self.set_terminator(MirTerminator.Throw(payload, type_tag))

    me terminate_resume(payload: MirOperand, type_tag: MirOperand):
        """Resume propagation after running a cleanup pad."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return
        self.set_terminator(MirTerminator.Resume(payload, type_tag))

    me set_unwind_target(target: BlockId?, payload: LocalId?, type_tag: LocalId?):
        self.unwind_target = target
        self.unwind_payload = payload
        self.unwind_type_tag = type_tag

    me set_terminator(term: MirTerminator):
        """Set terminator for current block."""
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        if self.enum_semantic_recording:
            if self.enum_semantic_site_calls.len() + self.enum_semantic_terms.len() >= 65536:
                self.enum_semantic_site_overflow = true
            else:
                self.enum_semantic_term_blocks.push(self.current_block)
                self.enum_semantic_terms.push(term)
                self.enum_semantic_term_nodes.push(self.enum_semantic_node)
        self.finalize_block()
        if val capture = self.loop_view_capture_v1:
            capture.accept(capture.consume_terminator(self.current_block.id))

        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        for i in 0..self.blocks.len():
            if self.blocks[i].id.id == self.current_block.id:
                var block = self.blocks[i]
                block.terminator = term
                self.blocks[i] = block
                break

    fn current_block_has_explicit_terminator() -> bool:
        for block in self.blocks:
            if block.id.id == self.current_block.id:
                match block.terminator:
                    case Unreachable:
                        return false
                    case _:
                        return true
        false

    # ========================================================================
    # Convenience Methods (for interpreter compatibility)
    # ========================================================================

    me begin_simple_function(name: text, return_type_kind: text, signature_cursor_v1: i64 = -1):
        """Begin a function with simple return type.
        return_type_kind: "i64", "f64", "bool", "unit", "void"
        """
        var ret_type = MirType(kind: MirTypeKind.Unit)
        if return_type_kind == "i64":
            ret_type = MirType(kind: MirTypeKind.I64)
        elif return_type_kind == "f64":
            ret_type = MirType(kind: MirTypeKind.F64)
        elif return_type_kind == "bool":
            ret_type = MirType(kind: MirTypeKind.Bool)

        val sig = MirSignature(params: [], return_type: ret_type, is_variadic: false)
        val sym = SymbolId(id: self.module.functions.len())
        self.begin_function(sym, name, sig, nil, signature_cursor_v1)

    me emit_const_str(value: text) -> LocalId:
        """Emit a string constant and return its local."""
        val str_type = MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.I8), false))
        val dest = self.new_temp(str_type)
        self.emit_const(dest, MirConstValue.Str(value), str_type)
        dest

    me emit_void_call(func_name: text, args: [LocalId]):
        """Emit a void call to a named function."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return
        val func_type = MirType(kind: MirTypeKind.Unit)
        var operands: [MirOperand] = []
        for a in args:
            operands.push(MirOperand(kind: MirOperandKind.Copy(a)))

        val func_op = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str(func_name),
            MirType(kind: MirTypeKind.FuncPtr(MirSignature(
                params: [],
                return_type: func_type,
                is_variadic: false
            )))
        ))

        val optional_dest: LocalId? = nil
        self.emit(MirInst(
            kind: MirInstKind.Call(optional_dest, func_op, operands),
            span: self.current_span
        ))

    me terminate_return_copy(local: LocalId):
        """Terminate with return copying a local."""
        if val capture = self.loop_view_capture_v1:
            val operand_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
            capture.charge_edges(0)
            if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermRet):
                capture.accept(term_writer_v1.child(operand_node_v1))
                capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Ret(
            MirOperand(kind: MirOperandKind.Copy(local))
        ))

    me terminate_return_void():
        """Terminate with void return."""
        if val capture = self.loop_view_capture_v1:
            capture.charge_edges(0)
            if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermRet):
                capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Ret(None))

# ============================================================================
# Exports (re-export all from split modules + MirBuilder)
# ============================================================================

export use compiler.mir.mir_types.{
    LocalId, LocalKind, MirLocal,
    MirTypeKind, MirType, MirSignature, MirConstValue, MirTypeDef
}
export use compiler.mir.mir_instruction_graph.{MirBody, MirBlock, MirInst}
export use compiler.mir.mir_instruction_support.{
    MirOperand, MirOperandKind, MirTerminator,
    MirBinOp, MirUnaryOp, AggregateKind, GpuAtomicOpKind, MirBorrowKind,
    SwitchCase, MirAsmOperand,
    VhdlProcessKind, VhdlClockDomain, VhdlClockEdge,
    mir_operand_copy, mir_operand_move, mir_operand_const_int,
    mir_operand_const_float, mir_operand_const_bool
}

# MirBuilder (defined in this file)
# --------------------------------------------------------------------------
# Bootstrap call-return-type registry (native_call_return_type_loss 2026-07-23)
#
# In the bootstrap flat path a call site's SymbolId often cannot recover the
# callee's HirTypeKind.Function (symbol-table mutations don't survive the
# HIR->MIR pass boundary), so call dests degraded to i64 and every
# static-type consumer (interpolation, concat coercion) mis-rendered
# text-returning calls as raw integers. The bootstrap prep loops register
# each function's declared MIR return type here (bare + qualified names,
# accumulated ACROSS modules for cross-module calls);
# bootstrap_resolved_call_return_type consults it before the i64 fallback.
# Lives in mir_data (not mir_lowering) so _MirLoweringExpr can import it
# without an import cycle.
# Deliberately has NO reset: the registry must accumulate across ALL closure
# modules because cross-module call sites need the callee module's declared
# types, and the native-build worker is one process per build. See the design
# note at bootstrap_globals.spl (bootstrap_mir_functions_reset). A reset would
# also be inert on the common path — the reader consults the HIR symbol table
# first and registration is Str-returns only.
var _bootstrap_fn_ret_types: Dict<text, MirType> = {}

# Per-scope delta journal for every `_bootstrap_fn_*` registry in this file.
# The registries accumulate across all closure modules, and the per-module
# transient MIR scope used to promote each one WHOLESALE: the runtime walk
# visits every entry of a persistent dict too, so every module re-walked the
# whole accumulated registry (Stage 3 closure lowering ~700 -> ~150
# modules/min after #3919). Promotion only has to adopt what the scope
# allocated: the dict handles predate the scope and their bucket storage is
# plain calloc (runtime `rt_core_dict_resize`), so an in-scope write adds only
# transient KEYS and VALUES. Write paths journal their retained values while
# a scope is live. Ambiguity text keys need their actual dictionary promoted
# because native stores box separately from the text journal. A rebuild/reset
# marks a registry REPLACED when it assigns a new (in-scope) handle;
# `bootstrap_fn_registries_promote` promotes the journal, replaced handles,
# and any ambiguity dictionary with newly stored scoped keys.
# doc/08_tracking/bug/stage3_bootstrap_closure_promote_walks_full_registry_2026_10_20.md
var _bootstrap_fn_journal_texts: [text] = []
var _bootstrap_fn_journal_mir_types: [MirType] = []
var _bootstrap_fn_journal_hir_types: [HirType] = []
var _bootstrap_fn_journal_hir_type_lists: [[HirType]] = []
var _bootstrap_fn_journal_params: [[HirParam]] = []
var _bootstrap_fn_journal_symbol_tables: [SymbolTable] = []
var _bootstrap_fn_journal_consts: [[HirConst]] = []
var _bootstrap_fn_replaced_ret_hir_types = false
# A native text-key store boxes separately from the text journal. When an
# ambiguity key is inserted in scope, promote its actual dictionary owner.
# WORKAROUND native_boxed_dictionary_key_journal_identity_2026_10_26:
# remove the whole-dictionary promotion only after key-identity scope tests pass.
var _bootstrap_fn_dirty_ret_hir_ambig = false
var _bootstrap_fn_replaced_ret_shapes = false
var _bootstrap_fn_replaced_ret_array_element_shapes = false
var _bootstrap_fn_replaced_ret_ok_shapes = false
var _bootstrap_fn_replaced_ret_opt_shapes = false
var _bootstrap_fn_replaced_param_hir_types = false
var _bootstrap_fn_replaced_param_defaults = false
var _bootstrap_fn_replaced_default_rows = false
# The first promotion in a process adopts every registry wholesale once, so
# rows written before journaling could see a scope (or a lazily initialised
# handle) are covered; every later promotion is delta-only.
var _bootstrap_fn_registries_adopted = false

fn _bootstrap_fn_delta_live() -> bool:
    transient_array_scope_state_v1() != 0

fn _bootstrap_fn_delta_text(value: text):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_texts = _bootstrap_fn_journal_texts.push(value)

fn _bootstrap_fn_delta_mir_type(value: MirType):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_mir_types = _bootstrap_fn_journal_mir_types.push(value)

fn _bootstrap_fn_delta_hir_type(value: HirType):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_hir_types = _bootstrap_fn_journal_hir_types.push(value)

fn _bootstrap_fn_delta_hir_type_list(value: [HirType]):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_hir_type_lists = _bootstrap_fn_journal_hir_type_lists.push(value)

fn _bootstrap_fn_delta_params(value: [HirParam]):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_params = _bootstrap_fn_journal_params.push(value)

fn _bootstrap_fn_delta_symbol_table(value: SymbolTable):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_symbol_tables = _bootstrap_fn_journal_symbol_tables.push(value)

fn _bootstrap_fn_delta_consts(value: [HirConst]):
    if _bootstrap_fn_delta_live():
        _bootstrap_fn_journal_consts = _bootstrap_fn_journal_consts.push(value)

fn _bootstrap_fn_hir_type_lists_equal(left: [HirType], right: [HirType]) -> bool:
    if left.len() != right.len():
        return false
    var index = 0
    while index < left.len():
        if not hir_types_equal(left[index], right[index]):
            return false
        index = index + 1
    true

fn bootstrap_fn_registries_discard_delta_v1():
    """Drop a journal left by a scope that ended without registry promotion
    (an aborted module). Call only right after a successful scope begin: no
    live scope can still own those rows then."""
    _bootstrap_fn_delta_reset()

fn _bootstrap_fn_delta_reset():
    _bootstrap_fn_journal_texts = []
    _bootstrap_fn_journal_mir_types = []
    _bootstrap_fn_journal_hir_types = []
    _bootstrap_fn_journal_hir_type_lists = []
    _bootstrap_fn_journal_params = []
    _bootstrap_fn_journal_symbol_tables = []
    _bootstrap_fn_journal_consts = []
    _bootstrap_fn_replaced_ret_hir_types = false
    _bootstrap_fn_dirty_ret_hir_ambig = false
    _bootstrap_fn_replaced_ret_shapes = false
    _bootstrap_fn_replaced_ret_array_element_shapes = false
    _bootstrap_fn_replaced_ret_ok_shapes = false
    _bootstrap_fn_replaced_ret_opt_shapes = false
    _bootstrap_fn_replaced_param_hir_types = false
    _bootstrap_fn_replaced_param_defaults = false
    _bootstrap_fn_replaced_default_rows = false

fn bootstrap_fn_ret_type_register(name: text, ty: MirType):
    # An update keeps the stored key; only a new key enters the journal.
    if not _bootstrap_fn_ret_types.contains_key(name):
        _bootstrap_fn_delta_text(name)
    _bootstrap_fn_ret_types[name] = ty
    _bootstrap_fn_delta_mir_type(ty)

fn bootstrap_fn_ret_type_lookup(name: text) -> MirType?:
    # contains_key + [] rather than .get(): Dict.get returns nil on present
    # keys in the interpreter lane (known quirk).
    if _bootstrap_fn_ret_types.contains_key(name):
        return Some(_bootstrap_fn_ret_types[name])
    nil

# HIR-typed declared-return registry, name-keyed, accumulated across ALL
# closure modules in the flat pre-pass (bootstrap_register_flat_function_values).
# Symbol IDs are per-module-table, so id-keyed maps can't answer for a callee
# defined in another module; without this a cross-module call to an `-> i32`
# fn defaulted to the erased i64 return and 32-bit targets read the a0/a1
# REGISTER PAIR — garbage a1 OR'd into every i32 result (NVMe rv32 fw
# mask-361, 2026-07-24). Duplicate free-fn names (e.g. two `main`s) are marked
# ambiguous and never answered.
var _bootstrap_fn_ret_hir_types: Dict<text, HirType> = {}
var _bootstrap_fn_ret_hir_ambig: Dict<text, bool> = {}

fn _bootstrap_fn_ret_hir_mark_ambiguous(name: text):
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return
    _bootstrap_fn_ret_hir_ambig[name] = true
    _bootstrap_fn_dirty_ret_hir_ambig = _bootstrap_fn_dirty_ret_hir_ambig or _bootstrap_fn_delta_live()

fn bootstrap_fn_ret_hir_type_register(name: text, ty: HirType):
    if not hir_type_metadata_symbol_free(ty):
        _bootstrap_fn_ret_hir_mark_ambiguous(name)
        return
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        _bootstrap_fn_ret_hir_mark_ambiguous(name)
        # Both HIR lookups veto this name before reading stored metadata.
        # Keep the existing value: rebuilding the entire registry
        # for every duplicate makes closure prescan quadratic and promotes
        # unrelated rows again. The ambiguity dictionary itself owns the
        # stored boxed key; a separately boxed text journal is insufficient.
        # doc/bug_report/mir_hir_registry_ambiguity_copy_2026-10-26.md
        return
    _bootstrap_fn_ret_hir_types[name] = ty
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_hir_type(ty)

fn bootstrap_fn_ret_hir_type_lookup(name: text) -> HirType?:
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        return Some(_bootstrap_fn_ret_hir_types[name])
    nil

# Canonical callable return shape accumulated across flat closure modules.
# Values are module-qualified aggregate layout keys or "__runtime_array__".
var _bootstrap_fn_ret_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_shapes.contains_key(name):
        if _bootstrap_fn_ret_shapes[name] != shape:
            _bootstrap_fn_ret_shape_ambig[name] = true
            _bootstrap_fn_delta_text(name)
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_bootstrap_fn_ret_shapes: Dict<text, text> = {}
            for _k in _bootstrap_fn_ret_shapes.keys():
                if _k != name:
                    _kept_bootstrap_fn_ret_shapes[_k] = _bootstrap_fn_ret_shapes[_k]
            _bootstrap_fn_ret_shapes = _kept_bootstrap_fn_ret_shapes
            _bootstrap_fn_replaced_ret_shapes = _bootstrap_fn_replaced_ret_shapes or _bootstrap_fn_delta_live()
        return
    _bootstrap_fn_ret_shapes[name] = shape
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_text(shape)

fn bootstrap_fn_ret_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_shapes[name])
    nil

# Array/Slice element layout identity, resolved in the defining module.
var _bootstrap_fn_ret_array_element_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_array_element_identities: Dict<text, text> = {}
var _bootstrap_fn_ret_array_element_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_array_element_shape_register(name: text, shape: text, identity: text):
    if shape == "" or _bootstrap_fn_ret_array_element_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_array_element_shapes.contains_key(name):
        if _bootstrap_fn_ret_array_element_identities[name] != identity:
            _bootstrap_fn_ret_array_element_shape_ambig[name] = true
            _bootstrap_fn_delta_text(name)
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_bootstrap_fn_ret_array_element_shapes: Dict<text, text> = {}
            for _k in _bootstrap_fn_ret_array_element_shapes.keys():
                if _k != name:
                    _kept_bootstrap_fn_ret_array_element_shapes[_k] = _bootstrap_fn_ret_array_element_shapes[_k]
            _bootstrap_fn_ret_array_element_shapes = _kept_bootstrap_fn_ret_array_element_shapes
            _bootstrap_fn_replaced_ret_array_element_shapes = _bootstrap_fn_replaced_ret_array_element_shapes or _bootstrap_fn_delta_live()
        return
    _bootstrap_fn_ret_array_element_shapes[name] = shape
    _bootstrap_fn_ret_array_element_identities[name] = identity
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_text(shape)
    _bootstrap_fn_delta_text(identity)

fn bootstrap_fn_ret_array_element_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_array_element_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_array_element_shapes[name])
    nil

# Result<T, E>'s Ok-payload struct/class layout key, name-keyed like the plain
# return-shape registry above. Needed because a Result<T,E> return type's
# inner `ok_type` is an HirTypeKind.Named(SymbolId) whose SymbolId was minted
# in the DEFINING module's own per-module SymbolTable id-space
# (native_build_cross_module_result_payload_struct_name_collision_2026-08-09,
# 6th/7th layer): re-deferencing that id against a DIFFERENT module's
# `self.symbols` (entry-closure lowering replaces the active SymbolTable per
# module) can coincidentally land on an unrelated symbol with the same
# numeric id (e.g. a sibling Method), silently mis-resolving the payload's
# struct name. Registered here, name-keyed, at prescan time — while
# `module.symbols` is still the DEFINING module's own, self-consistent table —
# so consumers never need to dereference the foreign id at all.
var _bootstrap_fn_ret_ok_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_ok_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_ok_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_ok_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_ok_shapes.contains_key(name):
        if _bootstrap_fn_ret_ok_shapes[name] != shape:
            _bootstrap_fn_ret_ok_shape_ambig[name] = true
            _bootstrap_fn_delta_text(name)
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_bootstrap_fn_ret_ok_shapes: Dict<text, text> = {}
            for _k in _bootstrap_fn_ret_ok_shapes.keys():
                if _k != name:
                    _kept_bootstrap_fn_ret_ok_shapes[_k] = _bootstrap_fn_ret_ok_shapes[_k]
            _bootstrap_fn_ret_ok_shapes = _kept_bootstrap_fn_ret_ok_shapes
            _bootstrap_fn_replaced_ret_ok_shapes = _bootstrap_fn_replaced_ret_ok_shapes or _bootstrap_fn_delta_live()
        return
    _bootstrap_fn_ret_ok_shapes[name] = shape
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_text(shape)

fn bootstrap_fn_ret_ok_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_ok_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_ok_shapes[name])
    nil

# Result Err record identity is captured in the provider's symbol table. The
# key is its exact callable link name, never an unqualified lookup candidate.
var _bootstrap_fn_ret_err_shapes: Dict<text, text> = {}

fn bootstrap_fn_ret_err_shape_register(name: text, shape: text):
    if name == "" or shape == "": return
    if _bootstrap_fn_ret_err_shapes.contains_key(name):
        if _bootstrap_fn_ret_err_shapes[name] != shape:
            # An empty retained entry is conflicting authority, not a miss.
            val conflicting_err_shape = ""
            _bootstrap_fn_ret_err_shapes[name] = conflicting_err_shape
            _bootstrap_fn_delta_text(name)
            _bootstrap_fn_delta_text(conflicting_err_shape)
        return
    _bootstrap_fn_ret_err_shapes[name] = shape
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_text(shape)

fn bootstrap_fn_ret_err_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_err_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_err_shapes[name])
    nil

# `Optional<T>`'s payload struct/class NAME, the exact sibling of the Ok-shape
# registry above and for the identical reason. A callee declared `-> T` got its
# layout key through `bootstrap_fn_ret_shape_register` and a callee declared
# `-> Result<T, E>` additionally got its Ok payload's name through the pair
# above; a callee declared `-> T?` got NEITHER, because the prescan's
# `match prescan_fn.return_type.kind` had no `Optional` arm at all. The payload
# type therefore never reached MIR under a cross-module-safe key, the call
# result carried no `struct_value_syms` entry, and `resolve_field_index` fell
# through to the numeric-SymbolId `field_map` tier (which collides across
# modules in an entry-closure build) and finally to a silent index 0 — reading
# `path` at offset 0 as `FileFingerprint.size`. That is
# `field=310824753:runtime=1080` in
# stage2_capsule_receipt_size_canary_blocks_linux_admission_2026-09-13.md and
# `920329169` in native_optional_unwrap_field_index_by_name_collision
# _2026-09-12.md. Same registration point as the Ok pair — prescan time, while
# `module.symbols` is still the DEFINING module's own self-consistent table —
# so consumers never dereference the foreign SymbolId either.
var _bootstrap_fn_ret_opt_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_opt_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_opt_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_opt_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_opt_shapes.contains_key(name):
        if _bootstrap_fn_ret_opt_shapes[name] != shape:
            _bootstrap_fn_ret_opt_shape_ambig[name] = true
            _bootstrap_fn_delta_text(name)
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_bootstrap_fn_ret_opt_shapes: Dict<text, text> = {}
            for _k in _bootstrap_fn_ret_opt_shapes.keys():
                if _k != name:
                    _kept_bootstrap_fn_ret_opt_shapes[_k] = _bootstrap_fn_ret_opt_shapes[_k]
            _bootstrap_fn_ret_opt_shapes = _kept_bootstrap_fn_ret_opt_shapes
            _bootstrap_fn_replaced_ret_opt_shapes = _bootstrap_fn_replaced_ret_opt_shapes or _bootstrap_fn_delta_live()
        return
    _bootstrap_fn_ret_opt_shapes[name] = shape
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_text(shape)

fn bootstrap_fn_ret_opt_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_opt_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_opt_shapes[name])
    nil

# Companion PARAM-type registry (same ambiguity set as returns): without it a
# cross-module call to `fn f(a: i32, b: i64)` erased both params to i64 — on
# rv32 ilp32 the caller then marshaled the i64 into the wrong (unaligned)
# register pair while the callee read the ABI-correct one (band/policy/dram/
# target section failures, 2026-07-24).
var _bootstrap_fn_param_hir_types: Dict<text, [HirType]> = {}
# This unowned registry must never transport a provider's local SymbolId.
# Keep parameter rejection separate: a valid scalar return ABI remains valid.
var _bootstrap_fn_param_hir_rejected: Dict<text, bool> = {}

fn bootstrap_fn_param_hir_types_register(name: text, tys: [HirType]):
    if _bootstrap_fn_param_hir_rejected.contains_key(name):
        return
    for ty in tys:
        if not hir_type_metadata_symbol_free(ty):
            _bootstrap_fn_param_hir_rejected[name] = true
            _bootstrap_fn_delta_text(name)
            return
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        # The ambiguity veto also hides any earlier parameter metadata.
        # Its original insertion owns the key/list; no replacement or new
        # transient root is needed here. See the return-registry note above.
        return
    if _bootstrap_fn_param_hir_types.contains_key(name):
        # Per-consumer provider prescan re-registers the same declaration:
        # storing an equal fresh list would promote a copy per module and
        # orphan the previous one.
        if _bootstrap_fn_hir_type_lists_equal(_bootstrap_fn_param_hir_types[name], tys):
            return
    else:
        _bootstrap_fn_delta_text(name)
    _bootstrap_fn_param_hir_types[name] = tys
    _bootstrap_fn_delta_hir_type_list(tys)

fn bootstrap_fn_param_hir_types_lookup(name: text) -> [HirType]?:
    if _bootstrap_fn_param_hir_rejected.contains_key(name):
        return nil
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_param_hir_types.contains_key(name):
        val params = _bootstrap_fn_param_hir_types[name]
        # Admission also covers an existing record; registration is not proof
        # that an older/restored value owns the active consumer's symbol table.
        for param in params:
            if not hir_type_metadata_symbol_free(param):
                return nil
        return Some(params)
    nil

# Per-parameter DEFAULT-expression registry.
#
# `35.semantics/resolve.spl:fill_call_defaults` is the only other default-fill
# machinery and it is NOT on the AOT lane at all (proven by instrumentation:
# `dbg-fill: 0` under `native-build`), so an omitted trailing defaulted
# argument reached the callee as an UNINITIALIZED register/stack slot -- the
# callee read garbage, not the declared default
# (doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md).
# The pad now happens in MIR call lowering, which every call kind (same-module
# free function, cross-module callee, instance/static method) passes through.
#
# Whole `HirParam`s are stored, not just the default expressions, because the
# pad must know per-index `has_default` as well as the declared arity. For
# INSTANCE methods `HirFunction.params[0]` is the implicit `self`
# (20.hir/hir_lowering/_Items/declaration_lowering.spl:317) and the lowered MIR
# call likewise carries the receiver as arg 0, so index alignment holds for
# free functions, static methods and instance methods alike.
#
# Ambiguity policy is STRICTER than the sibling registries above: padding the
# wrong callee would inject a bogus argument, so any name that two definitions
# disagree on (different arity, or a different has_default pattern) is dropped
# and never answered. Same-shape duplicates are harmless and keep the first.
var _bootstrap_fn_param_defaults: Dict<text, [HirParam]> = {}
var _bootstrap_fn_param_defaults_ambig: Dict<text, bool> = {}
var _bootstrap_fn_param_default_owners: Dict<text, text> = {}
var _bootstrap_default_provider_symbols: Dict<text, SymbolTable> = {}
var _bootstrap_default_provider_globals: Dict<text, [HirConst]> = {}

fn bootstrap_default_provider_register(owner: text, symbols: SymbolTable, globals: [HirConst]):
    # Re-registered for every consumer once providers are passed: the owner's
    # table and constants come from the same driver HIR module each time, so
    # the first registration is kept. Re-storing it per consumer would journal
    # (and, under the memory-owner runtime, re-walk) a whole provider graph
    # per module. `bootstrap_fn_param_defaults_detach_for_archive_v1` clears
    # these rows when a new declaration owner is installed.
    if _bootstrap_default_provider_symbols.contains_key(owner) and
            _bootstrap_default_provider_globals.contains_key(owner):
        return
    _bootstrap_default_provider_symbols[owner] = symbols
    _bootstrap_default_provider_globals[owner] = globals
    _bootstrap_fn_delta_text(owner)
    _bootstrap_fn_delta_symbol_table(symbols)
    _bootstrap_fn_delta_consts(globals)

fn bootstrap_default_provider_symbols(owner: text) -> SymbolTable?:
    _bootstrap_default_provider_symbols.get(owner)

fn bootstrap_default_provider_globals(owner: text) -> [HirConst]?:
    _bootstrap_default_provider_globals.get(owner)

fn bootstrap_fn_param_default_owner(name: text) -> text:
    _bootstrap_fn_param_default_owners.get(name) ?? ""

fn _fn_param_defaults_shape(params: [HirParam]) -> text:
    var shape = ""
    for p in params:
        shape = shape + (if p.has_default: "D" else: "-")
    shape

fn bootstrap_fn_param_defaults_register(name: text, params: [HirParam], owner: text = ""):
    if name == "" or _bootstrap_fn_param_defaults_ambig.contains_key(name):
        return
    # Equal arity/default flags do not prove equal declarations. In particular,
    # two providers may both declare f(x = LIMIT) with different LIMIT storage.
    if _bootstrap_fn_param_default_owners.has(name) and _bootstrap_fn_param_default_owners[name] != owner:
        _bootstrap_fn_param_defaults_ambig[name] = true
        _bootstrap_fn_delta_text(name)
        return
    # A present key already holds this same owner (the branch above returned
    # otherwise); rewriting it would only store a fresh transient copy.
    if not _bootstrap_fn_param_default_owners.has(name):
        _bootstrap_fn_param_default_owners[name] = owner
        _bootstrap_fn_delta_text(name)
        _bootstrap_fn_delta_text(owner)
    var any_default = false
    for p in params:
        if p.has_default:
            any_default = true
    if not any_default:
        # Nothing to pad. Still record the arity shape so a LATER same-name
        # definition that DOES have defaults is recognised as ambiguous
        # rather than silently winning.
        if _bootstrap_fn_param_defaults.contains_key(name):
            if _fn_param_defaults_shape(_bootstrap_fn_param_defaults[name]) != _fn_param_defaults_shape(params):
                _bootstrap_fn_param_defaults_ambig[name] = true
                _bootstrap_fn_delta_text(name)
                # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
                # natively (rt_dict_remove); assigning it back destroys the map on the
                # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
                # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
                var _kept_bootstrap_fn_param_defaults: Dict<text, [HirParam]> = {}
                for _k in _bootstrap_fn_param_defaults.keys():
                    if _k != name:
                        _kept_bootstrap_fn_param_defaults[_k] = _bootstrap_fn_param_defaults[_k]
                _bootstrap_fn_param_defaults = _kept_bootstrap_fn_param_defaults
                _bootstrap_fn_replaced_param_defaults = _bootstrap_fn_replaced_param_defaults or _bootstrap_fn_delta_live()
        return
    if _bootstrap_fn_param_defaults.contains_key(name):
        if _fn_param_defaults_shape(_bootstrap_fn_param_defaults[name]) != _fn_param_defaults_shape(params):
            _bootstrap_fn_param_defaults_ambig[name] = true
            _bootstrap_fn_delta_text(name)
            # `Dict.remove(k)` returns a NEW dict interpreted but the REMOVED VALUE
            # natively (rt_dict_remove); assigning it back destroys the map on the
            # compiled lane. Rebuild without the key. See doc/08_tracking/bug/
            # dict_remove_return_value_differs_native_vs_interpreter_2026-09-13.md
            var _kept_bootstrap_fn_param_defaults_2: Dict<text, [HirParam]> = {}
            for _k in _bootstrap_fn_param_defaults.keys():
                if _k != name:
                    _kept_bootstrap_fn_param_defaults_2[_k] = _bootstrap_fn_param_defaults[_k]
            _bootstrap_fn_param_defaults = _kept_bootstrap_fn_param_defaults_2
            _bootstrap_fn_replaced_param_defaults = _bootstrap_fn_replaced_param_defaults or _bootstrap_fn_delta_live()
        return
    _bootstrap_fn_param_defaults[name] = params
    _bootstrap_fn_delta_text(name)
    _bootstrap_fn_delta_params(params)

fn bootstrap_fn_param_defaults_lookup(name: text) -> [HirParam]?:
    if _bootstrap_fn_param_defaults_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_param_defaults.contains_key(name):
        return Some(_bootstrap_fn_param_defaults[name])
    nil

# Complete archive consumers use sealed expression descriptors, not these
# body-bearing compatibility rows. Detach only their roots when that actual
# declaration owner is installed; ordinary prescan routes repopulate them.
# This does not claim to reclaim graphs already promoted by an earlier compile.
fn bootstrap_fn_param_defaults_detach_for_archive_v1():
    _bootstrap_fn_param_defaults = {}
    _bootstrap_fn_param_defaults_ambig = {}
    _bootstrap_fn_param_default_owners = {}
    _bootstrap_default_provider_symbols = {}
    _bootstrap_default_provider_globals = {}
    _bootstrap_fn_replaced_default_rows = _bootstrap_fn_replaced_default_rows or _bootstrap_fn_delta_live()

# Same declaration shape as the sibling bootstrap module
# _MirLowering/module_lowering.spl:63 -- avoids an import cycle (mir_data is
# imported BY module_lowering, not the reverse).
extern fn rt_transient_heap_promote<T>(value: T) -> bool

fn _promote_bootstrap_registry<T>(value: T) -> bool:
    """Promote one module-level registry out of the transient heap; the single
    direct runtime call this file makes for that (the ratchet counts sites)."""
    rt_transient_heap_promote(value)

var _bootstrap_fn_promote_last_roots: i64 = 0

fn bootstrap_fn_registries_last_promote_roots_v1() -> i64:
    _bootstrap_fn_promote_last_roots

fn _bootstrap_fn_registries_promote_all() -> bool:
    """Wholesale adoption of every `_bootstrap_fn_*` Dict: the runtime Dict
    walk visits every bucket's key+value pair (collections.rs
    `transient_heap_children`), so this costs the WHOLE accumulated registry.
    Used once per process (see `_bootstrap_fn_registries_adopted`)."""
    val ret_types_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_types)
    val ret_hir_types_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_hir_types)
    val ret_hir_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_hir_ambig)
    val ret_shapes_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_shapes)
    val ret_shape_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_shape_ambig)
    val ret_array_element_identities_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_array_element_identities)
    val ret_array_element_shapes_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_array_element_shapes)
    val ret_array_element_shape_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_array_element_shape_ambig)
    val ret_err_shapes_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_err_shapes)
    val ret_ok_shapes_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_ok_shapes)
    val ret_ok_shape_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_ok_shape_ambig)
    val ret_opt_shapes_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_opt_shapes)
    val ret_opt_shape_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_ret_opt_shape_ambig)
    val param_hir_types_ok = _promote_bootstrap_registry(_bootstrap_fn_param_hir_types)
    val param_hir_rejected_ok = _promote_bootstrap_registry(_bootstrap_fn_param_hir_rejected)
    val param_defaults_ok = _promote_bootstrap_registry(_bootstrap_fn_param_defaults)
    val param_defaults_ambig_ok = _promote_bootstrap_registry(_bootstrap_fn_param_defaults_ambig)
    val default_owners_ok = _promote_bootstrap_registry(_bootstrap_fn_param_default_owners)
    val default_symbols_ok = _promote_bootstrap_registry(_bootstrap_default_provider_symbols)
    val default_globals_ok = _promote_bootstrap_registry(_bootstrap_default_provider_globals)
    ret_types_ok and ret_hir_types_ok and ret_hir_ambig_ok and ret_shapes_ok and
        ret_shape_ambig_ok and ret_err_shapes_ok and ret_ok_shapes_ok and ret_ok_shape_ambig_ok and
        ret_opt_shapes_ok and ret_opt_shape_ambig_ok and
        ret_array_element_shapes_ok and ret_array_element_shape_ambig_ok and ret_array_element_identities_ok and
        param_hir_types_ok and param_hir_rejected_ok and param_defaults_ok and param_defaults_ambig_ok and
        default_owners_ok and default_symbols_ok and default_globals_ok

fn _bootstrap_fn_registry_rows() -> i64:
    _bootstrap_fn_ret_types.len() + _bootstrap_fn_ret_hir_types.len() + _bootstrap_fn_ret_hir_ambig.len() +
        _bootstrap_fn_ret_shapes.len() + _bootstrap_fn_ret_shape_ambig.len() +
        _bootstrap_fn_ret_array_element_identities.len() + _bootstrap_fn_ret_array_element_shapes.len() +
        _bootstrap_fn_ret_array_element_shape_ambig.len() + _bootstrap_fn_ret_err_shapes.len() +
        _bootstrap_fn_ret_ok_shapes.len() + _bootstrap_fn_ret_ok_shape_ambig.len() +
        _bootstrap_fn_ret_opt_shapes.len() + _bootstrap_fn_ret_opt_shape_ambig.len() +
        _bootstrap_fn_param_hir_types.len() + _bootstrap_fn_param_hir_rejected.len() +
        _bootstrap_fn_param_defaults.len() + _bootstrap_fn_param_defaults_ambig.len() +
        _bootstrap_fn_param_default_owners.len() + _bootstrap_default_provider_symbols.len() +
        _bootstrap_default_provider_globals.len()

fn bootstrap_fn_registries_promote() -> bool:
    """Promote what the active per-module transient scope added to the
    `_bootstrap_fn_*` Dicts, mirroring 20.hir's `bootstrap_hir_modules_promote_last`
    and this file's own sibling `bootstrap_mir_registries_promote`
    (_MirLowering/bootstrap_globals.spl). These dicts accumulate ACROSS
    modules by design (see the "Deliberately has NO reset" note above
    `_bootstrap_fn_ret_types`) -- a LATER module's cross-module call site
    looks up an EARLIER module's registration -- so a row written during
    module i's transient scope must survive into module i+1's scope and
    beyond.

    The journals retain inserted values. A registry whose handle a
    rebuild/reset replaced in scope is promoted whole. Newly inserted HIR
    ambiguity keys also require promotion of their actual dictionary owner
    because the text journal boxes independently on the native path. Everything
    else in the registries is already persistent and has no transient child,
    because the bucket storage is not scope-allocated. The promoted-root count
    is published for the scaling spec
    (test/01_unit/compiler/mir/bootstrap_fn_registry_delta_promote_spec.spl)."""
    var roots = _bootstrap_fn_journal_texts.len() + _bootstrap_fn_journal_mir_types.len() +
        _bootstrap_fn_journal_hir_types.len() + _bootstrap_fn_journal_hir_type_lists.len() +
        _bootstrap_fn_journal_params.len() + _bootstrap_fn_journal_symbol_tables.len() +
        _bootstrap_fn_journal_consts.len()
    var ok = true
    if not _bootstrap_fn_registries_adopted:
        roots = roots + _bootstrap_fn_registry_rows()
        ok = _bootstrap_fn_registries_promote_all()
        _bootstrap_fn_registries_adopted = ok
    else:
        if _bootstrap_fn_dirty_ret_hir_ambig:
            roots = roots + _bootstrap_fn_ret_hir_ambig.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_hir_ambig) and ok
        if _bootstrap_fn_replaced_ret_hir_types:
            roots = roots + _bootstrap_fn_ret_hir_types.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_hir_types) and ok
        if _bootstrap_fn_replaced_ret_shapes:
            roots = roots + _bootstrap_fn_ret_shapes.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_shapes) and ok
        if _bootstrap_fn_replaced_ret_array_element_shapes:
            roots = roots + _bootstrap_fn_ret_array_element_shapes.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_array_element_shapes) and ok
        if _bootstrap_fn_replaced_ret_ok_shapes:
            roots = roots + _bootstrap_fn_ret_ok_shapes.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_ok_shapes) and ok
        if _bootstrap_fn_replaced_ret_opt_shapes:
            roots = roots + _bootstrap_fn_ret_opt_shapes.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_ret_opt_shapes) and ok
        if _bootstrap_fn_replaced_param_hir_types:
            roots = roots + _bootstrap_fn_param_hir_types.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_param_hir_types) and ok
        if _bootstrap_fn_replaced_param_defaults or _bootstrap_fn_replaced_default_rows:
            roots = roots + _bootstrap_fn_param_defaults.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_param_defaults) and ok
        if _bootstrap_fn_replaced_default_rows:
            roots = roots + _bootstrap_fn_param_defaults_ambig.len() + _bootstrap_fn_param_default_owners.len() +
                _bootstrap_default_provider_symbols.len() + _bootstrap_default_provider_globals.len()
            ok = _promote_bootstrap_registry(_bootstrap_fn_param_defaults_ambig) and ok
            ok = _promote_bootstrap_registry(_bootstrap_fn_param_default_owners) and ok
            ok = _promote_bootstrap_registry(_bootstrap_default_provider_symbols) and ok
            ok = _promote_bootstrap_registry(_bootstrap_default_provider_globals) and ok
    # The journal carriers are released after their elements are adopted; the
    # fresh empty journals below are allocated while the scope is paused.
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_texts) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_mir_types) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_hir_types) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_hir_type_lists) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_params) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_symbol_tables) and ok
    ok = promote_and_release_transient_owner_roots(_bootstrap_fn_journal_consts) and ok
    _bootstrap_fn_delta_reset()
    _bootstrap_fn_promote_last_roots = roots
    ok

export use compiler.mir.mir_instruction_support.{BlockId}
export use compiler.mir.mir_instruction_graph.{MirFunction, MirModule}
export MirBuilder, MirOwnedRawAllocationFactV1
export bootstrap_fn_ret_type_register, bootstrap_fn_ret_type_lookup
export bootstrap_fn_ret_hir_type_register, bootstrap_fn_ret_hir_type_lookup
export bootstrap_fn_ret_shape_register, bootstrap_fn_ret_shape_lookup
export bootstrap_fn_param_hir_types_register, bootstrap_fn_param_hir_types_lookup
export bootstrap_fn_param_defaults_register, bootstrap_fn_param_defaults_lookup
export bootstrap_fn_param_default_owner, bootstrap_default_provider_register
