                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return dest
        self.emit(MirInst(
            kind: MirInstKind.UnaryOp(dest, op, operand),
            span: self.current_span
        ))
        dest

    me emit_ref(place: MirPlace, borrow_kind: MirBorrowKind, type_: MirType, type_cursor_v1: i64 = -1) -> LocalId:
        """Emit a borrow reference and return result local."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.Ref(dest, borrow_kind, place),
            span: self.current_span
        ))
        dest

    me emit_global_addr(symbol: SymbolId, pointee_type: MirType, mutable: bool) -> LocalId:
        """Emit the typed address of canonical module-static storage."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val ref_type = MirType(kind: MirTypeKind.Ref(pointee_type, mutable))
        val dest = self.new_temp(ref_type)
        self.emit(MirInst(
            kind: MirInstKind.GlobalAddr(dest, symbol, mutable),
            span: self.current_span
        ))
        dest

    me emit_load(ptr: MirOperand, type_: MirType, type_cursor_v1: i64 = -1) -> LocalId:
        """Emit a load instruction."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.Load(dest, ptr),
            span: self.current_span
        ))
        dest

    me emit_store(ptr: MirOperand, value: MirOperand):
        """Emit a store instruction."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return
        self.emit(MirInst(
            kind: MirInstKind.Store(ptr, value),
            span: self.current_span
        ))

    me emit_alloc(type_: MirType) -> LocalId:
        """Emit an allocation."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(MirType.ptr(type_, true))
        self.emit(MirInst(
            kind: MirInstKind.Alloc(dest, type_),
            span: self.current_span
        ))
        dest

    me emit_typed_storage_alloc_owned_raw_v1(
        pointee_type: MirType, allocation_byte_len: i64, logical_type_id: i64,
        revision: i64, element_count: i64, allocation_identity: text,
        allocation_provenance: text, source_revision: text
    ) -> MirOwnedRawAllocationFactV1:
        """Emit an exact compiler-owned raw fixed-record allocation.

        This operation is compiler-private and must be consumed by the typed
        storage producer before backend optimization/codegen.
        """
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return MirOwnedRawAllocationFactV1(base_local: LocalId(id: -1), allocation_byte_len: 0, logical_type_id: -1, revision: 0, element_count: 0, allocation_identity: "", allocation_provenance: "", source_revision: "")
        val dest = self.new_temp(MirType.ptr(pointee_type, true))
        # Match emit_call's flat optional LocalId representation.
        val optional_dest: LocalId? = dest
        self.emit(MirInst(kind: MirInstKind.Intrinsic(optional_dest,
            MIR_STORAGE_ALLOC_OWNED_RAW_V1, [
                MirOperand.const_int(allocation_byte_len),
                MirOperand.const_int(logical_type_id),
                MirOperand.const_int(revision),
                MirOperand.const_int(element_count),
                MirOperand(kind: MirOperandKind.Const(
                    MirConstValue.Str(allocation_identity),
                    MirType(kind: MirTypeKind.Opaque("str"))))
            ]), span: self.current_span))
        MirOwnedRawAllocationFactV1(base_local: dest,
            allocation_byte_len: allocation_byte_len,
            logical_type_id: logical_type_id, revision: revision,
            element_count: element_count,
            allocation_identity: allocation_identity,
            allocation_provenance: allocation_provenance,
            source_revision: source_revision)

    me emit_entry_alloc(type_: MirType) -> LocalId:
        """Emit a fixed-lifetime allocation in the function entry block."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(MirType.ptr(type_, true))
        val alloc = MirInst(kind: MirInstKind.Alloc(dest, type_), span: self.current_span)
        if self.current_block.id == BlockId.entry().id:
            self.emit(alloc)
        else:
            var entry = self.blocks[0]
            entry.instructions = entry.instructions.push(alloc)
            self.blocks[0] = entry
        dest

    me emit_call(func: MirOperand, args: [MirOperand], return_type: MirType, return_type_cursor_v1: i64 = -1) -> LocalId?:
        """Emit a function call."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return nil
        # Bare-lift (no explicit Some): an explicit Some(...) builds a heap
        # Option box on the stage4 native lane; downstream readers of the
        # flat LocalId? payload then see the box header as the id.
        val dest: LocalId? = if return_type.kind != MirTypeKind.Unit: self.new_temp(return_type) else: nil

        if val unwind = self.unwind_target:
            val optional_unwind: BlockId? = unwind
            val normal = self.new_block(Some("invoke_cont"))
            self.set_terminator(MirTerminator.CallTerminator(
                dest, func, args, normal, optional_unwind, self.unwind_payload, self.unwind_type_tag))
            self.switch_to_block(normal)
        else:
            self.emit(MirInst(kind: MirInstKind.Call(dest, func, args), span: self.current_span))

        dest

    me emit_call_value(func: MirOperand, args: [MirOperand], return_type: MirType, return_type_cursor_v1: i64 = -1) -> LocalId:
        """Emit a function call whose non-unit result is required."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        # Level-gated behind this file's existing SIMPLE_MIRB_TRACE gate (see
        # lines 113/186). These probes were unconditional, which on a hot path
        # (every non-unit call emit) floods stderr for the whole build; they are
        # retained, not deleted, per the log-retention policy. (2026-08-08)
        val mirb_trace = mir_builder_trace_enabled()
        if mirb_trace:
            eprint("[mir-call-value] new-temp-before next={self.next_local_id}\n")
        val dest = self.new_temp(return_type)
        val optional_dest: LocalId? = dest
        if mirb_trace:
            eprint("[mir-call-value] new-temp-after id={dest.id} next={self.next_local_id}\n")
        if val unwind = self.unwind_target:
            val optional_unwind: BlockId? = unwind
            val normal = self.new_block(Some("invoke_value_cont"))
            self.set_terminator(MirTerminator.CallTerminator(
                optional_dest, func, args, normal, optional_unwind, self.unwind_payload, self.unwind_type_tag))
            self.switch_to_block(normal)
        else:
            self.emit(MirInst(kind: MirInstKind.Call(optional_dest, func, args), span: self.current_span))
        if mirb_trace:
            eprint("[mir-call-value] emit-after id={dest.id}\n")
        dest

    me emit_call_indirect(ptr: MirOperand, args: [MirOperand], sig: MirSignature, return_type: MirType, return_type_cursor_v1: i64 = -1) -> LocalId?:
        """Emit an indirect function call (through closure or function pointer)."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return nil
        # Bare-lift (no explicit Some): an explicit Some(...) builds a heap
        # Option box on the stage4 native lane; downstream readers of the
        # flat LocalId? payload then see the box header as the id.
        val dest: LocalId? = if return_type.kind != MirTypeKind.Unit: self.new_temp(return_type) else: nil

        if val unwind = self.unwind_target:
            val optional_unwind: BlockId? = unwind
            val normal = self.new_block(Some("invoke_indirect_cont"))
            self.set_terminator(MirTerminator.CallTerminator(
                dest, ptr, args, normal, optional_unwind, self.unwind_payload, self.unwind_type_tag))
            self.switch_to_block(normal)
        else:
            self.emit(MirInst(kind: MirInstKind.CallIndirect(dest, ptr, args, sig), span: self.current_span))

        dest

    me emit_cast(operand: MirOperand, target: MirType, type_cursor_v1: i64 = -1, operand_cursor_v1: i64 = -1) -> LocalId:
        """Emit a type cast."""
        val dest = self.new_temp(target, type_cursor_v1)
        if val capture = self.loop_view_capture_v1:
            var operand_node_v1 = operand_cursor_v1
            if operand_node_v1 < 0:
                match operand.kind:
                    case Copy(local): operand_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                    case Move(local): operand_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                    case Const(value, type_):
                        var operand_constant_v1 = -1
                        if operand_constant_v1 < 0:
                            match value:
                                case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                                case Float(value):
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                                        capture.accept(constant_writer_v1.real(value))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case FloatLexeme(value):
                                    var lexeme_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                                        capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case Str(value):
                                    var constant_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                        capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        var operand_type_v1 = -1
                        if operand_type_v1 < 0:
                            match type_.kind:
                                case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                case Bits(width, signed):
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                        capture.accept(type_writer_v1.scalar(0, width))
                                        capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Opaque(name):
                                    var type_text_v1: i64 = -1
                                    match capture.owner().reserve_text(name.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                        capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        operand_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
            val target_node_v1 = capture.node(capture.local_type_cursor(dest.id))
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstCast):
                capture.accept(instruction_writer_v1.scalar(0, dest.id))
                capture.accept(instruction_writer_v1.child(operand_node_v1))
                capture.accept(instruction_writer_v1.child(target_node_v1))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return dest
        self.emit(MirInst(
            kind: MirInstKind.Cast(dest, operand, target),
            span: self.current_span
        ))
        dest

    me emit_bitcast(operand: MirOperand, target: MirType, type_cursor_v1: i64 = -1, operand_cursor_v1: i64 = -1) -> LocalId:
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(target)
        self.emit(MirInst(
            kind: MirInstKind.Bitcast(dest, operand, target),
            span: self.current_span
        ))
        dest

    me emit_aggregate(kind: AggregateKind, operands: [MirOperand], type_: MirType, type_cursor_v1: i64 = -1, aggregate_cursor_v1: i64 = -1, aggregate_type_cursor_v1: i64 = -1) -> LocalId:
        """Emit aggregate construction."""
        val dest = self.new_temp(type_, type_cursor_v1)
        if val capture = self.loop_view_capture_v1:
            if aggregate_cursor_v1 >= 0:
                capture.accept(capture.prepare_instruction(aggregate_cursor_v1))
            if aggregate_cursor_v1 < 0:
                if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstAggregate):
                    var aggregate_kind_v1: i64 = 0
                    var aggregate_symbol_v1: i64 = -1
                    var aggregate_variant_v1: i64 = -1
                    var aggregate_type_v1: i64 = -1
                    match kind:
                        case Array(array_type_v1):
                            aggregate_kind_v1 = 0
                            aggregate_type_v1 = aggregate_type_cursor_v1
                            if aggregate_type_v1 < 0:
                                match array_type_v1.kind:
                                    case I8: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                    case I16: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                    case I32: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                    case I64: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                    case U8: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                    case U16: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                    case U32: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                    case U64: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                    case Bool: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                    case Char: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                    case Unit: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                    case Never: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                    case F32: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                    case F64: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                    case Vec4f: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                    case Vec8f: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                    case Vec4d: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                    case Vec4i: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                    case Vec8i: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                    case Vec16f: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                    case Vec8d: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                    case Vec16i: aggregate_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                    case Bits(width, signed):
                                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                            capture.accept(type_writer_v1.scalar(0, width))
                                            capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                            aggregate_type_v1 = capture.node(type_writer_v1.finish())
                                    case Opaque(name):
                                        var type_text_v1: i64 = -1
                                        match capture.owner().reserve_text(name.len()):
                                            case Err(error): capture.fail(error)
                                            case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                            capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                            aggregate_type_v1 = capture.node(type_writer_v1.finish())
                                    case Struct(symbol): aggregate_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                    case Enum(symbol): aggregate_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        case Tuple: aggregate_kind_v1 = 1
                        case Struct(symbol):
                            aggregate_kind_v1 = 2
                            aggregate_symbol_v1 = symbol.id
                        case Enum(symbol, variant):
                            aggregate_kind_v1 = 3
                            aggregate_symbol_v1 = symbol.id
                            aggregate_variant_v1 = variant
                    capture.accept(instruction_writer_v1.scalar(0, dest.id))
                    capture.accept(instruction_writer_v1.scalar(1, aggregate_kind_v1))
                    capture.accept(instruction_writer_v1.scalar(2, aggregate_symbol_v1))
                    capture.accept(instruction_writer_v1.scalar(3, aggregate_variant_v1))
                    capture.accept(instruction_writer_v1.child(aggregate_type_v1))
                    for element_v1 in operands:
                        var element_node_v1 = -1
                        if element_node_v1 < 0:
                            match element_v1.kind:
                                case Copy(local): element_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                                case Move(local): element_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                                case Const(value, type_):
                                    var operand_constant_v1 = -1
                                    if operand_constant_v1 < 0:
                                        match value:
                                            case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                            case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                            case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                                            case Float(value):
                                                if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                                                    capture.accept(constant_writer_v1.real(value))
                                                    operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                            case FloatLexeme(value):
                                                var lexeme_text_v1: i64 = -1
                                                match capture.owner().reserve_text(value.len()):
                                                    case Err(error): capture.fail(error)
                                                    case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                                                if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                                                    capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                                                    operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                            case Str(value):
                                                var constant_text_v1: i64 = -1
                                                match capture.owner().reserve_text(value.len()):
                                                    case Err(error): capture.fail(error)
                                                    case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                                if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                                    capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                                    operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                            case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                                    var operand_type_v1 = -1
                                    if operand_type_v1 < 0:
                                        match type_.kind:
                                            case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                            case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                            case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                            case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                            case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                            case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                            case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                            case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                            case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                            case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                            case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                            case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                            case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                            case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                            case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                            case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                            case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                            case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                            case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                            case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                            case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                            case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                            case Bits(width, signed):
                                                if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                                    capture.accept(type_writer_v1.scalar(0, width))
                                                    capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                                    operand_type_v1 = capture.node(type_writer_v1.finish())
                                            case Opaque(name):
                                                var type_text_v1: i64 = -1
                                                match capture.owner().reserve_text(name.len()):
                                                    case Err(error): capture.fail(error)
                                                    case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                                if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                                    capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                                    operand_type_v1 = capture.node(type_writer_v1.finish())
                                            case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                            case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                            case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                                    element_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
                        capture.accept(instruction_writer_v1.child(element_node_v1))
                    var instruction_span_v1: i64 = -1
                    if val source_span_v1 = self.current_span:
                        var span_file_v1: i64 = -1
                        match capture.owner().reserve_text(source_span_v1.file.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                        if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                            capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                            capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                            capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                            capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                            capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                            capture.accept(span_writer_v1.text_id(0, span_file_v1))
                            instruction_span_v1 = capture.node(span_writer_v1.finish())
                    if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                    capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return dest
        self.emit(MirInst(
            kind: MirInstKind.Aggregate(dest, kind, operands),
            span: self.current_span
        ))
        dest

    me emit_get_field(base: MirOperand, field: i64, type_: MirType, type_cursor_v1: i64 = -1, base_cursor_v1: i64 = -1) -> LocalId:
        """Emit field access."""
        val dest = self.new_temp(type_, type_cursor_v1)
        if val capture = self.loop_view_capture_v1:
            var base_node_v1 = base_cursor_v1
            if base_node_v1 < 0:
                match base.kind:
                    case Copy(local): base_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                    case Move(local): base_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                    case Const(value, type_):
                        var operand_constant_v1 = -1
                        if operand_constant_v1 < 0:
                            match value:
                                case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                                case Float(value):
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                                        capture.accept(constant_writer_v1.real(value))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case FloatLexeme(value):
                                    var lexeme_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                                        capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case Str(value):
                                    var constant_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                        capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        var operand_type_v1 = -1
                        if operand_type_v1 < 0:
                            match type_.kind:
                                case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                case Bits(width, signed):
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                        capture.accept(type_writer_v1.scalar(0, width))
                                        capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Opaque(name):
                                    var type_text_v1: i64 = -1
                                    match capture.owner().reserve_text(name.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                        capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        base_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstGetField):
                capture.accept(instruction_writer_v1.scalar(0, dest.id))
                capture.accept(instruction_writer_v1.scalar(1, field))
                capture.accept(instruction_writer_v1.child(base_node_v1))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return dest
        self.emit(MirInst(
            kind: MirInstKind.GetField(dest, base, field),
            span: self.current_span
        ))
        dest

    me emit_set_field(base: MirOperand, field: i64, value: MirOperand):
        """Emit field assignment."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return
        self.emit(MirInst(
            kind: MirInstKind.SetField(base, field, value),
            span: self.current_span
        ))

    me emit_gep(base: MirOperand, indices: [MirOperand], type_: MirType, type_cursor_v1: i64 = -1) -> LocalId:
        """Emit GetElementPtr instruction."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Unsupported)
            return LocalId(id: -1)
        val dest = self.new_temp(type_)
        self.emit(MirInst(
            kind: MirInstKind.GetElementPtr(dest, base, indices),
            span: self.current_span
        ))
        dest

    # ========================================================================
    # Terminators
    # ========================================================================

    me terminate_goto(target: BlockId):
        """Terminate current block with unconditional jump."""
        if val capture = self.loop_view_capture_v1:
            capture.charge_edges(1)
            if val term_writer_v1 = capture.start(MirLoopShapeTagV1.TermGoto):
                capture.accept(term_writer_v1.scalar(0, target.id))
                capture.accept(capture.prepare_terminator(capture.node(term_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.set_terminator(MirTerminator.Goto(target))

    me terminate_return(value: MirOperand?, value_cursor_v1: i64 = -1):
        """Terminate current block with return."""
        if val capture = self.loop_view_capture_v1:
            var return_node_v1: i64 = -1
            if val return_value_v1 = value:
                var operand_node_v1 = value_cursor_v1
                if operand_node_v1 < 0:
                    match return_value_v1.kind:
                        case Copy(local): operand_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                        case Move(local): operand_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                        case Const(value, type_):
                            var operand_constant_v1 = -1
