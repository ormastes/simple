    me terminate_switch(value: MirOperand, targets: [SwitchCase], default: BlockId, value_cursor_v1: i64 = -1, switch_cursor_v1: i64 = -1):
        """Terminate current block with switch.

        B5b dormant-bug fix: previously declared targets as [(i64, BlockId)]
        which was incompatible with MirTerminator.Switch (which takes
        [SwitchCase]). Zero callers existed when this was discovered; the
        signature is now corrected so the MatchCase MIR lowerer can call it.
        """
        if val capture = self.loop_view_capture_v1:
            if switch_cursor_v1 >= 0:
                capture.accept(capture.prepare_terminator(switch_cursor_v1))
            else:
                var value_node_v1 = value_cursor_v1
                if value_node_v1 < 0:
                    match value.kind:
                        case Copy(local): value_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                        case Move(local): value_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
