                capture.accept(instruction_writer_v1.scalar(1, operation_v1))
                capture.accept(instruction_writer_v1.child(left_node_v1))
                capture.accept(instruction_writer_v1.child(right_node_v1))
                var instruction_span_v1: i64 = -1
