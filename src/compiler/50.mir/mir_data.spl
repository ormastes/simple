# MIR - Mid-level Intermediate Representation (Data Structures)
#
# Lower-level IR between HIR and native code generation.
# Features:
# - Explicit control flow (basic blocks, terminators)
# - Explicit memory operations (load, store, alloc)
# - SSA form (each value defined once)
# - Type-annotated values
# - Ready for optimization and codegen
#
# Split into:
# - mir_types.spl: Type system and leaf data structures (~210 lines)
# - mir_instructions.spl: Blocks, instructions, terminators, operands (~460 lines)
# - mir_data.spl: MirBuilder API + re-exports (this file)

use compiler.hir.hir_types.{SymbolId, SymbolTable, HirType, hir_type_metadata_symbol_free}
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.hir.hir_definitions.{HirParam, HirConst}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common._Attributes.decl_attrs.{DriverManifestAttr, DriverManifestAttrKind}
use compiler.mir.loop_builder_capture_v1.{MirLoopBuilderCaptureV1}
use compiler.mir.loop_module_shape_types_v1.{MirLoopShapeTagV1, MirLoopShapeErrorV1}
use compiler.mir.mir_types.*
use compiler.mir.mir_instructions.*
# Strict staged lowering must record the terminal owner for these dominant MIR
# exports.  Keeping the broad compatibility import above is intentional for the
# MirBuilder surface; the explicit imports prevent these names from acquiring
# mir_instructions/mir_data facade ownership during export materialization.
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{
    mir_operand_copy, mir_operand_const_int
}
use compiler.mir.intrinsics.{MIR_STORAGE_ALLOC_OWNED_RAW_V1}
# `eprint` is not an implicit builtin under the self-hosted HIR resolver: the
# Rust seed happened to resolve it ambiently, so the three [mir-call-value]
# probes below compiled under stage2 but failed Stage 3 with
# `HIR lowering error in src/compiler/mir/mir_data.spl: unresolved name: eprint`.
# Import it explicitly, exactly as the sibling lowering file does
# (50.mir/_MirLowering/bootstrap_globals.spl:25). (2026-08-08 stage3)
use std.nogc_sync_mut.io.process_ops.{eprint}
use std.io_runtime.{env_get_opt}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use compiler.mir._MirLowering.transient_owner_sffi.{promote_and_release_transient_owner_roots}

pub fn mir_trace_requested(
    compiler_trace: text,
    bootstrap_diag: text,
    mir_builder_trace: text
) -> bool:
    """Whether fine-grained MIR tracing was explicitly requested.

    Phase profiling owns bounded phase receipts, not per-expression tracing.
    """
    compiler_trace == "1" or bootstrap_diag == "1" or mir_builder_trace == "1"

# One immutable trace-policy snapshot per outer MIR lowering. The lowering
# pipeline is process-global/serial today; nested lowering inherits the parent
# decision and restores its depth without rewriting environment variables.
pub var _mir_trace_scope_slot: [i64] = [0, 0, 0, 0]

pub fn mir_trace_scope_enter() -> i64:
    val previous_depth = _mir_trace_scope_slot[0]
    if previous_depth == 0:
        val compiler_trace = env_get_opt("SIMPLE_COMPILER_TRACE") ?? ""
        val bootstrap_diag = env_get_opt("SIMPLE_BOOTSTRAP_DIAG") ?? ""
        val mir_builder_trace = env_get_opt("SIMPLE_MIRB_TRACE") ?? ""
        _mir_trace_scope_slot[1] = if mir_trace_requested(
            compiler_trace, bootstrap_diag, ""): 1 else: 0
        _mir_trace_scope_slot[2] = if mir_trace_requested(
            "", "", mir_builder_trace): 1 else: 0
        _mir_trace_scope_slot[3] = _mir_trace_scope_slot[3] + 1
    _mir_trace_scope_slot[0] = previous_depth + 1
    previous_depth

pub fn mir_trace_scope_exit(previous_depth: i64):
    _mir_trace_scope_slot[0] = previous_depth

pub fn mir_trace_generation() -> i64:
    _mir_trace_scope_slot[3]

pub fn mir_lowering_trace_enabled() -> bool:
    if _mir_trace_scope_slot[0] > 0:
        return _mir_trace_scope_slot[1] != 0
    mir_trace_requested(
        env_get_opt("SIMPLE_COMPILER_TRACE") ?? "",
        env_get_opt("SIMPLE_BOOTSTRAP_DIAG") ?? "",
        "")

pub fn mir_builder_trace_enabled() -> bool:
    if _mir_trace_scope_slot[0] > 0:
        return _mir_trace_scope_slot[2] != 0
    mir_trace_requested("", "", env_get_opt("SIMPLE_MIRB_TRACE") ?? "")

pub fn mir_trace_enabled() -> bool:
    """Shared MIR-lowering trace gate. Default OFF.

    Same idiom (and same env names) as `mir_lower_trace_enabled` in
    _MirLowering/module_lowering.spl, plus this file's own SIMPLE_MIRB_TRACE,
    so one switch turns every MIR-lowering receipt back on. Callers on hot
    paths must read this ONCE and cache it (see emit_call_value below), never
    per receipt."""
    mir_lowering_trace_enabled() or mir_builder_trace_enabled()

# ============================================================================
# MIR Builder
# ============================================================================

struct MirOwnedRawAllocationFactV1:
    base_local: LocalId
    allocation_byte_len: i64
    logical_type_id: i64
    revision: i64
    element_count: i64
    allocation_identity: text
    allocation_provenance: text
    source_revision: text

struct MirBuilder:
    """Builder for constructing MIR."""
    module: MirModule
    current_function: MirFunction?
    current_block: BlockId
    next_local_id: i64
    next_block_id: i64
    locals: [MirLocal]
    blocks: [MirBlock]
    instructions: [MirInst]
    # DS5 (mir-span-thread, 2026-07-28): source span attributed to whatever
    # HIR node is *currently* being lowered. Seeded per-function from
    # begin_function's span, then stacked (save/set/restore) around each
    # lower_stmt / lower_expr entry so nested emit_* calls stamp the
    # innermost node's real span instead of a hardcoded `nil`. See
    # expr_dispatch.spl::lower_expr and mir_lowering_stmts.spl::lower_stmt
    # for the save/restore wrappers that maintain this stack discipline.
    current_span: Span?
    # Active protected-region destination. Nil outside try blocks, so normal
    # compilation pays one predictable lowering-time branch and emits exactly
    # the pre-existing Call instruction shape.
    unwind_target: BlockId?
    unwind_payload: LocalId?
    unwind_type_tag: LocalId?

    # EE-01 records real producer call positions only while an opted enum
    # pattern test/binding is being emitted. Native instructions are unchanged.
    enum_semantic_recording: bool = false
    enum_semantic_site_blocks: [BlockId] = []
    enum_semantic_site_indices: [i64] = []
    enum_semantic_site_calls: [MirInst] = []
    enum_semantic_site_nodes: [i64] = []
    enum_semantic_node: i64 = -1
    enum_semantic_term_blocks: [BlockId] = []
    enum_semantic_terms: [MirTerminator] = []
    enum_semantic_term_nodes: [i64] = []
    enum_semantic_site_overflow: bool = false
    # Nil ordinary route allocates no capture tables or provider views.
    loop_view_capture_v1: MirLoopBuilderCaptureV1? = nil

impl MirBuilder:
    static fn new() -> MirBuilder:
        MirBuilder(
            module: MirModule(
                name: "",
                functions: {},
                statics: {},
                constants: {},
                types: {}
            ),
            current_function: nil,
            current_block: BlockId.entry(),
            next_local_id: 0,
            next_block_id: 1,
            locals: [],
            blocks: [],
            instructions: [],
            current_span: nil,
            unwind_target: nil,
            unwind_payload: nil,
            unwind_type_tag: nil
        )

    # ========================================================================
    # Function Building
    # ========================================================================

    me begin_function(symbol: SymbolId, name: text, signature: MirSignature, span: Span, signature_cursor_v1: i64 = -1):
        """Begin building a new function."""
        if val capture = self.loop_view_capture_v1:
            capture.reserve_function_return()
            var name_text_v1: i64 = -1
            match capture.owner().reserve_text(name.len()):
                case Err(error): capture.fail(error)
                case Ok(permit): name_text_v1 = capture.node(permit.publish(name))
            var span_node_v1: i64 = -1
            if span != nil:
                var span_file_v1: i64 = -1
                match capture.owner().reserve_text(span.file.len()):
                    case Err(error): capture.fail(error)
                    case Ok(permit): span_file_v1 = capture.node(permit.publish(span.file))
                if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                    capture.accept(span_writer_v1.scalar(0, span.start))
                    capture.accept(span_writer_v1.scalar(1, span.end))
                    capture.accept(span_writer_v1.scalar(2, span.line))
                    capture.accept(span_writer_v1.scalar(3, span.col))
                    capture.accept(span_writer_v1.scalar(4, span.length))
                    capture.accept(span_writer_v1.text_id(0, span_file_v1))
                    span_node_v1 = capture.node(span_writer_v1.finish())
            capture.accept(capture.begin_function(symbol.id, name_text_v1, signature_cursor_v1, span_node_v1))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.current_function = Some(MirFunction(
            symbol: symbol,
            name: name,
            signature: signature,
            locals: [],
            blocks: [],
            entry_block: BlockId.entry(),
            span: span,
            generic_params: [],
            is_generic_template: false,
            specialization_of: nil,
            type_bindings: {},
            layout_phase: nil,
            is_kernel: false,
            gpu_target: "",
            gpu_backend_order: "",
            is_export_c: false,
            export_name: "",
            has_driver_manifest_attr: false,
            # @workaround bug=BUG-NATIVE-NESTED-STRUCT-NIL-COPY-20261016 recover=6ba18bacb6c431956ade4156b10397250d8e550a reason=tagged-nil-nested-record-copy-guard
            driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
            has_vhdl_metadata: false,
            vhdl_metadata: vhdl_hardware_metadata_default(),
            has_fast_math: false,
            unroll_factor: 0,
            pipeline_ii: 0,
            memory_banks: 0,
            verification_contract: nil
        ))
        self.next_local_id = 0
        self.next_block_id = 1
        self.locals = []
        self.blocks = []
        self.instructions = []
        self.current_block = BlockId.entry()
        self.enum_semantic_recording = false
        self.enum_semantic_site_blocks = []
        self.enum_semantic_site_indices = []
        self.enum_semantic_site_calls = []
        self.enum_semantic_site_nodes = []
        self.enum_semantic_node = -1
        self.enum_semantic_term_blocks = []
        self.enum_semantic_terms = []
        self.enum_semantic_term_nodes = []
        self.enum_semantic_site_overflow = false
        # DS5: seed the per-function default span from the function's own
        # declaration span. lower_stmt/lower_expr push a more specific span
        # while lowering a given node and restore this on the way back out,
        # so anything emitted with no narrower node in scope (e.g. synthetic
        # prologue instructions) still carries a real, in-function location
        # instead of nil.
        self.current_span = Some(span)
        self.unwind_target = nil
        self.unwind_payload = nil
        self.unwind_type_tag = nil
        if mir_builder_trace_enabled():
            print "MIRB begin {name} post-reset blocks={self.blocks.len()} locals={self.locals.len()}"

        # Create entry block
        if val capture = self.loop_view_capture_v1:
            var entry_text_v1: i64 = -1
            match capture.owner().reserve_text("entry".len()):
                case Err(error): capture.fail(error)
                case Ok(permit): entry_text_v1 = capture.node(permit.publish("entry"))
            capture.accept(capture.new_block(0, entry_text_v1))
        self.blocks = self.blocks.push(MirBlock(
            id: BlockId.entry(),
            label: Some("entry"),
            instructions: [],
            terminator: MirTerminator.Unreachable  # Placeholder
        ))

        var bootstrap_mode = false
        if self.loop_view_capture_v1 == nil:
            bootstrap_mode = (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1"
        if not bootstrap_mode:
            # Create return local
            if signature.return_type.kind != MirTypeKind.Unit:
                var return_cursor_v1: i64 = -1
                if val capture = self.loop_view_capture_v1:
                    return_cursor_v1 = capture.node(capture.signature_type_cursor(0))
                self.new_local(Some("_return"), signature.return_type, LocalKind.Return, return_cursor_v1)

        # NOTE(#133): parameter locals are created unconditionally, including
        # under SIMPLE_BOOTSTRAP. HIR param lowering was fixed (declaration_lowering.spl
        # lower_function) to stop dropping params under bootstrap, so `signature.params`
        # is now correctly populated -- but this loop was still gated off, so no
        # `LocalKind.Arg(i)` locals ever got created for bootstrap functions. Without
        # them, function_lowering.spl's param-to-local mapping fell back to a phantom
        # `LocalId(id: pli+1)` that was never registered as a real local (and collided
        # with body-local ids, which also start counting from 0/1), so the codegen's
        # Arg-local scan (core_codegen.spl) found nothing and emitted a zero-param
        # `define`, while body references to the param read as `undef`. Creating the
        # Arg locals here fixes both: real params on `define`, and body identifier
        # references resolve to the correct local.
        # `_return` local creation stays bootstrap-gated -- 0-param bootstrap functions
        # (e.g. `bootstrap_version`, which returns `text`) already work today without
        # it, so this is left untouched to avoid an unrelated behavior change.
        for i in 0..signature.params.len():
            var param_cursor_v1: i64 = -1
            if val capture = self.loop_view_capture_v1:
                param_cursor_v1 = capture.node(capture.signature_type_cursor(i + 1))
            self.new_local(nil, signature.params[i], LocalKind.Arg(i), param_cursor_v1)

    me end_function() -> MirFunction:
        """Finish building current function and return it."""
        # Finalize current block
        self.finalize_block()

        if val capture = self.loop_view_capture_v1:
            capture.accept(capture.finish_function(self.blocks.len(), self.locals.len()))
            # This fixed empty representation is not the publication authority.
            # Its construction and return copies were reserved before begin.
            val funded_return_v1 = capture.consume_sentinel_credit()
            self.current_function = nil
            if not funded_return_v1: return nil
            return MirFunction(
                symbol: SymbolId.new(-1),
                name: "",
                signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
                locals: [],
                blocks: [],
                entry_block: BlockId.entry(),
                span: Span.empty(),
                generic_params: [],
                is_generic_template: false,
                specialization_of: nil,
                type_bindings: {},
                layout_phase: nil,
                is_kernel: false,
                gpu_target: "",
                gpu_backend_order: "",
                is_export_c: false,
                export_name: "",
                has_driver_manifest_attr: false,
                # @workaround bug=BUG-NATIVE-NESTED-STRUCT-NIL-COPY-20261016 recover=6ba18bacb6c431956ade4156b10397250d8e550a reason=tagged-nil-nested-record-copy-guard
                driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
                has_vhdl_metadata: false,
                vhdl_metadata: vhdl_hardware_metadata_default(),
                has_fast_math: false,
                unroll_factor: 0,
                pipeline_ii: 0,
                memory_banks: 0,
                verification_contract: nil
                )

        var fn_ = match self.current_function:
            case Some(active_function):
                active_function
            case None:
                MirFunction(
                symbol: SymbolId.new(-1),
                name: "<invalid>",
                signature: MirSignature(params: [], return_type: MirType.unit(), is_variadic: false),
                locals: [],
                blocks: [],
                entry_block: BlockId.entry(),
                span: Span.empty(),
                generic_params: [],
                is_generic_template: false,
                specialization_of: nil,
                type_bindings: {},
                layout_phase: nil,
                is_kernel: false,
                gpu_target: "",
                gpu_backend_order: "",
                is_export_c: false,
                export_name: "",
                has_driver_manifest_attr: false,
                # @workaround bug=BUG-NATIVE-NESTED-STRUCT-NIL-COPY-20261016 recover=6ba18bacb6c431956ade4156b10397250d8e550a reason=tagged-nil-nested-record-copy-guard
                driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
                has_vhdl_metadata: false,
                vhdl_metadata: vhdl_hardware_metadata_default(),
                has_fast_math: false,
                unroll_factor: 0,
                pipeline_ii: 0,
                memory_banks: 0,
                verification_contract: nil
                )
        fn_.locals = self.locals
        fn_.blocks = self.blocks
        self.current_function = nil
        if mir_builder_trace_enabled():
            var first_insts = -1
            if fn_.blocks.len() > 0:
                first_insts = fn_.blocks[0].instructions.len()
            # eprint, NOT print: this trace sat on the correct gate but wrote to
            # STDOUT, which the native-build worker swallows -- so it produced no
            # output and its silence was mistaken for "not called". stderr passes
            # through, which is why every probe that DID fire this session used
            # eprint. Same conversion applied to finalize_block below.
            eprint("MIRB end {fn_.name} blocks={fn_.blocks.len()} b0_insts={first_insts} locals={fn_.locals.len()}\n")
        return fn_

    me add_function(fn_: MirFunction):
        """Add a completed function to the module."""
        if val capture = self.loop_view_capture_v1:
            capture.fail(MirLoopShapeErrorV1.Incomplete)
            return
        var functions = self.module.functions
        functions[fn_.symbol] = fn_
        self.module.functions = functions

    # ========================================================================
    # Local Variables
    # ========================================================================

    me new_local(name: text?, type_: MirType, kind: LocalKind, type_cursor_v1: i64 = -1) -> LocalId:
        """Create a new local variable."""
        if val capture = self.loop_view_capture_v1:
            var type_node_v1 = type_cursor_v1
            if type_node_v1 < 0:
                match type_.kind:
                    case I8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                    case I16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                    case I32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                    case I64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                    case U8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                    case U16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                    case U32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                    case U64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                    case Bool: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                    case Char: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                    case Unit: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                    case Never: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                    case F32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                    case F64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                    case Vec4f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                    case Vec8f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                    case Vec4d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                    case Vec4i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                    case Vec8i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                    case Vec16f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                    case Vec8d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                    case Vec16i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                    case Bits(width, signed):
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                            capture.accept(type_writer_v1.scalar(0, width))
                            capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Opaque(name):
                        var type_text_v1: i64 = -1
                        match capture.owner().reserve_text(name.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                            capture.accept(type_writer_v1.text_id(0, type_text_v1))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Struct(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                    case Enum(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
            var name_text_v1: i64 = -1
            if val local_name_v1 = name:
                var published_name_v1: i64 = -1
                match capture.owner().reserve_text(local_name_v1.len()):
                    case Err(error): capture.fail(error)
                    case Ok(permit): published_name_v1 = capture.node(permit.publish(local_name_v1))
                name_text_v1 = published_name_v1
            var kind_v1: i64 = 2
            var ordinal_v1: i64 = -1
            match kind:
                case Arg(index):
                    kind_v1 = 0
                    ordinal_v1 = index
                case Var: kind_v1 = 1
                case Temp: kind_v1 = 2
                case Return: kind_v1 = 3
            capture.accept(capture.new_local(self.next_local_id, name_text_v1, type_node_v1, kind_v1, ordinal_v1))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return LocalId(id: -1)
        val id = LocalId(id: self.next_local_id)
        self.next_local_id = self.next_local_id + 1

        self.locals = self.locals.push(MirLocal(
            id: id,
            name: name,
            type_: type_,
            kind: kind,
            is_ghost: false
        ))

        id

    me new_temp(type_: MirType, type_cursor_v1: i64 = -1) -> LocalId:
        """Create a new temporary."""
        self.new_local(nil, type_, LocalKind.Temp, type_cursor_v1)

    me _local_position(id: LocalId) -> i64:
        """Resolve a unique local through the canonical dense index."""
        if id.id >= 0 and id.id < self.locals.len():
            if self.locals[id.id].id.id == id.id:
                return id.id
        var position = 0
        while position < self.locals.len():
            if self.locals[position].id.id == id.id:
                return position
            position = position + 1
        -1

    me local_type(id: LocalId) -> MirType?:
        """Return a local's type through the dense LocalId position.

        Canonical builder locals are append-only and receive their array
        position as LocalId. The fallback preserves lookup behavior for a
        directly constructed sparse or reordered builder with unique LocalIds.
        Duplicate LocalIds violate the builder invariant.
        """
        val position = self._local_position(id)
        if position >= 0:
            return self.locals[position].type_
        nil

    me set_local_name(id: LocalId, name: text):
        """Assign a source-level name to an existing local.

        Used to thread real HIR parameter names onto the MIR arg locals that
        begin_function creates nameless from the (types-only) MirSignature, so
        backends emit real port names (e.g. imem_rdata) instead of arg0/arg1.
        """
        val position = self._local_position(id)
        if position < 0:
            return
        if val capture = self.loop_view_capture_v1:
            var name_text_v1: i64 = -1
            match capture.owner().reserve_text(name.len()):
                case Err(error): capture.fail(error)
                case Ok(permit): name_text_v1 = capture.node(permit.publish(name))
            capture.accept(capture.rename_local(id.id, name_text_v1))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        val loc: MirLocal = self.locals[position]
        self.locals[position] = MirLocal(
            id: loc.id,
            name: Some(name),
            type_: loc.type_,
            kind: loc.kind,
            is_ghost: loc.is_ghost,
            short_borrow: loc.short_borrow,
            short_mutable: loc.short_mutable,
            short_boundary: loc.short_boundary
        )

    me set_local_type(id: LocalId, ty: MirType, type_cursor_v1: i64 = -1):
        """Retype an existing local (mirror of set_local_name).

        Used to thread an inferred result type onto a value-position
        match/if merge temp after its arms are lowered — the temp is
        created i64 before any arm type is known, and downstream consumers
        (print's numeric-coercion check, spill slots) read the local's MIR
        type. Instructions reference locals by id, so a post-hoc retype is
        safe."""
        val position = self._local_position(id)
        if position < 0:
            return
        if val capture = self.loop_view_capture_v1:
            var type_node_v1 = type_cursor_v1
            if type_node_v1 < 0:
                match ty.kind:
                    case I8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                    case I16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                    case I32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                    case I64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                    case U8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                    case U16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                    case U32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                    case U64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                    case Bool: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                    case Char: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                    case Unit: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                    case Never: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                    case F32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                    case F64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                    case Vec4f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                    case Vec8f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                    case Vec4d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                    case Vec4i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                    case Vec8i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                    case Vec16f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                    case Vec8d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                    case Vec16i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                    case Bits(width, signed):
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                            capture.accept(type_writer_v1.scalar(0, width))
                            capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Opaque(name):
                        var type_text_v1: i64 = -1
                        match capture.owner().reserve_text(name.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                            capture.accept(type_writer_v1.text_id(0, type_text_v1))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Struct(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                    case Enum(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
            capture.accept(capture.retype_local(id.id, type_node_v1))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        val loc: MirLocal = self.locals[position]
        self.locals[position] = MirLocal(
            id: loc.id,
            name: loc.name,
            type_: ty,
            kind: loc.kind,
            is_ghost: loc.is_ghost,
            short_borrow: loc.short_borrow,
            short_mutable: loc.short_mutable,
            short_boundary: loc.short_boundary
        )

    # ========================================================================
    # Basic Blocks
    # ========================================================================

    me new_block(label: text?) -> BlockId:
        """Create a new basic block."""
        if val capture = self.loop_view_capture_v1:
            var label_text_v1: i64 = -1
            if val block_label_v1 = label:
                var published_label_v1: i64 = -1
                match capture.owner().reserve_text(block_label_v1.len()):
                    case Err(error): capture.fail(error)
                    case Ok(permit): published_label_v1 = capture.node(permit.publish(block_label_v1))
                label_text_v1 = published_label_v1
            capture.accept(capture.new_block(self.next_block_id, label_text_v1))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return BlockId.new(-1)
        val id = BlockId.new(self.next_block_id)
        self.next_block_id = self.next_block_id + 1

        self.blocks = self.blocks.push(MirBlock(
            id: id,
            label: label,
            instructions: [],
            terminator: MirTerminator.Unreachable  # Placeholder
        ))

        id

    me switch_to_block(block: BlockId):
        """Switch to building a different block."""
        self.finalize_block()
        if val capture = self.loop_view_capture_v1:
            capture.accept(capture.switch_to_block(block.id))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.current_block = block
        self.instructions = []

    me finalize_block():
        """Finalize current block with accumulated instructions."""
        # Hypothesis probe (bootstrap_stage2_empty_mir_bodies_2026-07-05):
        # the Stage-2 instruction loss is localised to this ONE statement --
        # `self.builder` holds 3 finalized instructions immediately before
        # `end_function`, and `end_function`'s own trace, one call later,
        # reports 0. If the early return below fails to fire when pending IS
        # empty (measured 0 at that point), control reaches
        # `block.instructions = self.instructions` and overwrites the already
        # finalized instructions with the empty pending list. Print the length
        # AND the predicate's own answer AND whether the return is taken, so
        # the three are distinguishable. Reuses this file's existing
        # SIMPLE_MIRB_TRACE gate; default OFF.
        if val capture = self.loop_view_capture_v1:
            capture.accept(capture.flush(self.current_block.id, self.instructions.len()))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        val fb_pending_len = self.instructions.len()
        val fb_is_empty = self.instructions.is_empty()
        var fb_trace = false
        fb_trace = (env_get_opt("SIMPLE_MIRB_TRACE") ?? "") == "1"
        if fb_trace:
            eprint("MIRB finalize pending_len={fb_pending_len} is_empty={fb_is_empty} block={self.current_block.id}\n")
        if self.instructions.is_empty():
            if fb_trace:
                eprint("MIRB finalize early-return-taken\n")
            return
        if fb_trace:
            eprint("MIRB finalize FELL-THROUGH pending_len={fb_pending_len}\n")

        # Find and update current block
        var found = false
        for i in 0..self.blocks.len():
            if self.blocks[i].id.id == self.current_block.id:
                var block = self.blocks[i]
                block.instructions = self.instructions
                self.blocks[i] = block
                found = true
                break

        self.instructions = []

    # ========================================================================
    # Instructions
    # ========================================================================

    me emit(inst: MirInst):
        """Emit an instruction to current block."""
        if val capture = self.loop_view_capture_v1:
            capture.accept(capture.consume_instruction(self.current_block.id, self.instructions.len()))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        if self.enum_semantic_recording:
            if self.enum_semantic_site_calls.len() + self.enum_semantic_terms.len() >= 65536:
                self.enum_semantic_site_overflow = true
            else:
                self.enum_semantic_site_blocks.push(self.current_block)
                self.enum_semantic_site_indices.push(self.instructions.len())
                self.enum_semantic_site_calls.push(inst)
                self.enum_semantic_site_nodes.push(self.enum_semantic_node)
        self.instructions.push(inst)

    me emit_const(dest: LocalId, value: MirConstValue, type_: MirType, type_cursor_v1: i64 = -1, constant_cursor_v1: i64 = -1):
        """Emit a constant load."""
        if val capture = self.loop_view_capture_v1:
            var type_node_v1 = type_cursor_v1
            if type_node_v1 < 0:
                match type_.kind:
                    case I8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                    case I16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                    case I32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                    case I64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                    case U8: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                    case U16: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                    case U32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                    case U64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                    case Bool: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                    case Char: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                    case Unit: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                    case Never: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                    case F32: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                    case F64: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                    case Vec4f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                    case Vec8f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                    case Vec4d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                    case Vec4i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                    case Vec8i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                    case Vec16f: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                    case Vec8d: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                    case Vec16i: type_node_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                    case Bits(width, signed):
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                            capture.accept(type_writer_v1.scalar(0, width))
                            capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Opaque(name):
                        var type_text_v1: i64 = -1
                        match capture.owner().reserve_text(name.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                        if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                            capture.accept(type_writer_v1.text_id(0, type_text_v1))
                            type_node_v1 = capture.node(type_writer_v1.finish())
                    case Struct(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                    case Enum(symbol): type_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
            var constant_node_v1 = constant_cursor_v1
            if constant_node_v1 < 0:
                match value:
                    case Int(value): constant_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                    case Bool(value): constant_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                    case Zero: constant_node_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                    case Float(value):
                        if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                            capture.accept(constant_writer_v1.real(value))
                            constant_node_v1 = capture.node(constant_writer_v1.finish())
                    case FloatLexeme(value):
                        var lexeme_text_v1: i64 = -1
                        match capture.owner().reserve_text(value.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                        if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                            capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                            constant_node_v1 = capture.node(constant_writer_v1.finish())
                    case Str(value):
                        var constant_text_v1: i64 = -1
                        match capture.owner().reserve_text(value.len()):
                            case Err(error): capture.fail(error)
                            case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                        if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                            capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                            constant_node_v1 = capture.node(constant_writer_v1.finish())
                    case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstConst):
                capture.accept(instruction_writer_v1.scalar(0, dest.id))
                capture.accept(instruction_writer_v1.child(constant_node_v1))
                capture.accept(instruction_writer_v1.child(type_node_v1))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.emit(MirInst(
            kind: MirInstKind.Const(dest, value, type_),
            span: self.current_span
        ))

    me emit_const_int(value: i64) -> LocalId:
        """Emit an integer constant and return its local."""
        val dest = self.new_temp(MirType.i64())
        self.emit_const(dest, MirConstValue.Int(value), MirType.i64())
        dest

    me emit_const_float(value: f64) -> LocalId:
        """Emit a float constant and return its local."""
        val dest = self.new_temp(MirType.f64())
        self.emit_const(dest, MirConstValue.Float(value), MirType.f64())
        dest

    me emit_const_bool(value: bool) -> LocalId:
        """Emit a boolean constant and return its local."""
        val dest = self.new_temp(MirType.bool())
        self.emit_const(dest, MirConstValue.Bool(value), MirType.bool())
        dest

    me emit_copy(dest: LocalId, src: LocalId):
        """Emit a copy instruction."""
        if val capture = self.loop_view_capture_v1:
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstCopy):
                capture.accept(instruction_writer_v1.scalar(0, dest.id))
                capture.accept(instruction_writer_v1.scalar(1, src.id))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.emit(MirInst(
            kind: MirInstKind.Copy(dest, src),
            span: self.current_span
        ))

    me emit_move(dest: LocalId, src: LocalId):
        """Emit a move instruction.

        SF1 audit (2026-07-28): Simple's surface language currently has NO
        semantically-true move sites — assignment is copy for value types
        (structs/arrays) and reference-share for classes (s19
        mutation-by-design, see _MirLowering/function_lowering.spl class
        param binding); there is no `move` keyword in the frontend; and the
        `iso` (Isolated) move-only capability parses as a type
        (parser_types_expr.spl) but is erased to Infer at HIR type lowering
        (hir_lowering/types.spl "Infer / Atomic / Isolated" arm). So this
        builder has no surface-lowering caller yet by DESIGN, not by
        omission. When iso-capability lowering lands, iso-typed
        variable-to-variable assignment is the genuine move site to wire
        here. The NLL checker's Move handling is real and spec-proven via
        hand-built MIR (test/01_unit/compiler/borrow/borrow_check_spec.spl).
        """
        if val capture = self.loop_view_capture_v1:
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstMove):
                capture.accept(instruction_writer_v1.scalar(0, dest.id))
                capture.accept(instruction_writer_v1.scalar(1, src.id))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.emit(MirInst(
            kind: MirInstKind.Move(dest, src),
            span: self.current_span
        ))

    me emit_drop(local: LocalId):
        """WP-E: emit a drop edge for an owned `resource`-typed local (see
        MirInstKind.Drop's docstring, mir_instruction_kinds.spl). Callers are
        responsible for exactly-once placement -- MirLowering.
        emit_pending_resource_drops (mir_lowering_stmts.spl) tracks which
        locals have already been consumed (moved out, returned, or already
        `.close()`d) so this is never called twice for the same local on the
        same control-flow path."""
        if val capture = self.loop_view_capture_v1:
            if val instruction_writer_v1 = capture.start_instruction(MirLoopShapeTagV1.InstDrop):
                capture.accept(instruction_writer_v1.scalar(0, local.id))
                var instruction_span_v1: i64 = -1
                if val source_span_v1 = self.current_span:
                    var span_file_v1: i64 = -1
                    match capture.owner().reserve_text(source_span_v1.file.len()):
                        case Err(error): capture.fail(error)
                        case Ok(permit): span_file_v1 = capture.node(permit.publish(source_span_v1.file))
                    if val span_writer_v1 = capture.start(MirLoopShapeTagV1.Span):
                        capture.accept(span_writer_v1.scalar(0, source_span_v1.start))
                        capture.accept(span_writer_v1.scalar(1, source_span_v1.end))
                        capture.accept(span_writer_v1.scalar(2, source_span_v1.line))
                        capture.accept(span_writer_v1.scalar(3, source_span_v1.col))
                        capture.accept(span_writer_v1.scalar(4, source_span_v1.length))
                        capture.accept(span_writer_v1.text_id(0, span_file_v1))
                        instruction_span_v1 = capture.node(span_writer_v1.finish())
                if instruction_span_v1 >= 0: capture.accept(instruction_writer_v1.span(instruction_span_v1))
                capture.accept(capture.prepare_instruction(capture.node(instruction_writer_v1.finish())))
        if val capture = self.loop_view_capture_v1:
            if not capture.is_active(): return
        self.emit(MirInst(
            kind: MirInstKind.Drop(local),
            span: self.current_span
        ))

    me emit_binop(op: MirBinOp, left: MirOperand, right: MirOperand, type_: MirType, type_cursor_v1: i64 = -1, left_cursor_v1: i64 = -1, right_cursor_v1: i64 = -1) -> LocalId:
        """Emit a binary operation and return result local."""
        val dest = self.new_temp(type_, type_cursor_v1)
        if val capture = self.loop_view_capture_v1:
            var left_node_v1 = left_cursor_v1
            if left_node_v1 < 0:
                match left.kind:
                    case Copy(local): left_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                    case Move(local): left_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                    case Const(value, type_):
                        var operand_constant_v1 = -1
                        if operand_constant_v1 < 0:
                            match value:
                                case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                                case Float(value):
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                                        capture.accept(constant_writer_v1.real(value))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case FloatLexeme(value):
                                    var lexeme_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                                        capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case Str(value):
                                    var constant_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                        capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        var operand_type_v1 = -1
                        if operand_type_v1 < 0:
                            match type_.kind:
                                case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                case Bits(width, signed):
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                        capture.accept(type_writer_v1.scalar(0, width))
                                        capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Opaque(name):
                                    var type_text_v1: i64 = -1
                                    match capture.owner().reserve_text(name.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                        capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        left_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
            var right_node_v1 = right_cursor_v1
            if right_node_v1 < 0:
                match right.kind:
                    case Copy(local): right_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandCopy, local.id)
                    case Move(local): right_node_v1 = capture.scalar_leaf(MirLoopShapeTagV1.OperandMove, local.id)
                    case Const(value, type_):
                        var operand_constant_v1 = -1
                        if operand_constant_v1 < 0:
                            match value:
                                case Int(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstInt, value)
                                case Bool(value): operand_constant_v1 = capture.scalar_leaf(MirLoopShapeTagV1.ConstBool, if value: 1 else: 0)
                                case Zero: operand_constant_v1 = capture.leaf(MirLoopShapeTagV1.ConstZero)
                                case Float(value):
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloat):
                                        capture.accept(constant_writer_v1.real(value))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case FloatLexeme(value):
                                    var lexeme_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): lexeme_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstFloatLexeme):
                                        capture.accept(constant_writer_v1.text_id(0, lexeme_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case Str(value):
                                    var constant_text_v1: i64 = -1
                                    match capture.owner().reserve_text(value.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): constant_text_v1 = capture.node(permit.publish(value))
                                    if val constant_writer_v1 = capture.start(MirLoopShapeTagV1.ConstText):
                                        capture.accept(constant_writer_v1.text_id(0, constant_text_v1))
                                        operand_constant_v1 = capture.node(constant_writer_v1.finish())
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        var operand_type_v1 = -1
                        if operand_type_v1 < 0:
                            match type_.kind:
                                case I8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI8)
                                case I16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI16)
                                case I32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI32)
                                case I64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeI64)
                                case U8: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU8)
                                case U16: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU16)
                                case U32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU32)
                                case U64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeU64)
                                case Bool: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeBool)
                                case Char: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeChar)
                                case Unit: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeUnit)
                                case Never: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeNever)
                                case F32: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF32)
                                case F64: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeF64)
                                case Vec4f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4f)
                                case Vec8f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8f)
                                case Vec4d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4d)
                                case Vec4i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec4i)
                                case Vec8i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8i)
                                case Vec16f: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16f)
                                case Vec8d: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec8d)
                                case Vec16i: operand_type_v1 = capture.leaf(MirLoopShapeTagV1.TypeVec16i)
                                case Bits(width, signed):
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeBits):
                                        capture.accept(type_writer_v1.scalar(0, width))
                                        capture.accept(type_writer_v1.scalar(1, if signed: 1 else: 0))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Opaque(name):
                                    var type_text_v1: i64 = -1
                                    match capture.owner().reserve_text(name.len()):
                                        case Err(error): capture.fail(error)
                                        case Ok(permit): type_text_v1 = capture.node(permit.publish(name))
                                    if val type_writer_v1 = capture.start(MirLoopShapeTagV1.TypeOpaque):
                                        capture.accept(type_writer_v1.text_id(0, type_text_v1))
                                        operand_type_v1 = capture.node(type_writer_v1.finish())
                                case Struct(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeStruct, symbol.id)
                                case Enum(symbol): operand_type_v1 = capture.scalar_leaf(MirLoopShapeTagV1.TypeEnum, symbol.id)
                                case _: capture.fail(MirLoopShapeErrorV1.Incomplete)
                        right_node_v1 = capture.constant_operand(operand_constant_v1, operand_type_v1)
            val operation_v1 = match op:
                case Add: 0
                case Sub: 1
                case Mul: 2
                case Div: 3
                case Rem: 4
                case Pow: 5
                case MatMul: 6
                case BitAnd: 7
                case BitOr: 8
                case BitXor: 9
                case Shl: 10
                case Shr: 11
                case Eq: 12
                case Ne: 13
                case Lt: 14
                case Le: 15
                case Gt: 16
                case Ge: 17
