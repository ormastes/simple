export MirBody, MirTypeDef
export MirBlock, MirInst, MirInstKind
export MirOperand, MirOperandKind, MirTerminator
export MirBinOp, MirUnaryOp, AggregateKind, GpuAtomicOpKind, MirBorrowKind
export SwitchCase, MirAsmOperand
export VhdlProcessKind, VhdlClockDomain, VhdlClockEdge
export mir_operand_copy, mir_operand_move, mir_operand_const_int
export mir_operand_const_float, mir_operand_const_bool

# Borrow checking support types

# GPU support types

# VHDL support types

# MirBuilder (defined in this file)
export LocalId, LocalKind, MirLocal
export MirTypeKind, MirType, MirSignature, MirConstValue
# --------------------------------------------------------------------------
# Bootstrap call-return-type registry (native_call_return_type_loss 2026-07-23)
#
# In the bootstrap flat path a call site's SymbolId often cannot recover the
# callee's HirTypeKind.Function (symbol-table mutations don't survive the
# HIR->MIR pass boundary), so call dests degraded to i64 and every
# static-type consumer (interpolation, concat coercion) mis-rendered
# text-returning calls as raw integers. The bootstrap prep loops register
# each function's declared MIR return type here (bare + qualified names,
# accumulated ACROSS modules for cross-module calls);
# bootstrap_resolved_call_return_type consults it before the i64 fallback.
# Lives in mir_data (not mir_lowering) so _MirLoweringExpr can import it
# without an import cycle.
var _bootstrap_fn_ret_types: Dict<text, MirType> = {}

fn bootstrap_fn_ret_types_reset():
    _bootstrap_fn_ret_types = {}

fn bootstrap_fn_ret_type_register(name: text, ty: MirType):
    _bootstrap_fn_ret_types[name] = ty

fn bootstrap_fn_ret_type_lookup(name: text) -> MirType?:
    # contains_key + [] rather than .get(): Dict.get returns nil on present
    # keys in the interpreter lane (known quirk).
    if _bootstrap_fn_ret_types.contains_key(name):
        return Some(_bootstrap_fn_ret_types[name])
    nil

# HIR-typed declared-return registry, name-keyed, accumulated across ALL
# closure modules in the flat pre-pass (bootstrap_register_flat_function_values).
# Symbol IDs are per-module-table, so id-keyed maps can't answer for a callee
# defined in another module; without this a cross-module call to an `-> i32`
# fn defaulted to the erased i64 return and 32-bit targets read the a0/a1
# REGISTER PAIR — garbage a1 OR'd into every i32 result (NVMe rv32 fw
# mask-361, 2026-07-24). Duplicate free-fn names (e.g. two `main`s) are marked
# ambiguous and never answered.
var _bootstrap_fn_ret_hir_types: Dict<text, HirType> = {}
var _bootstrap_fn_ret_hir_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_hir_type_register(name: text, ty: HirType):
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        _bootstrap_fn_ret_hir_ambig[name] = true
        _bootstrap_fn_ret_hir_types = _bootstrap_fn_ret_hir_types.remove(name)
        return
    _bootstrap_fn_ret_hir_types[name] = ty

fn bootstrap_fn_ret_hir_type_lookup(name: text) -> HirType?:
    if _bootstrap_fn_ret_hir_types.contains_key(name):
        return Some(_bootstrap_fn_ret_hir_types[name])
    nil

# Canonical callable return shape accumulated across flat closure modules.
# Values are module-qualified aggregate layout keys or "__runtime_array__".
var _bootstrap_fn_ret_shapes: Dict<text, text> = {}
var _bootstrap_fn_ret_shape_ambig: Dict<text, bool> = {}

fn bootstrap_fn_ret_shape_register(name: text, shape: text):
    if shape == "" or _bootstrap_fn_ret_shape_ambig.contains_key(name):
        return
    if _bootstrap_fn_ret_shapes.contains_key(name):
        if _bootstrap_fn_ret_shapes[name] != shape:
            _bootstrap_fn_ret_shape_ambig[name] = true
            _bootstrap_fn_ret_shapes = _bootstrap_fn_ret_shapes.remove(name)
        return
    _bootstrap_fn_ret_shapes[name] = shape

fn bootstrap_fn_ret_shape_lookup(name: text) -> text?:
    if _bootstrap_fn_ret_shapes.contains_key(name):
        return Some(_bootstrap_fn_ret_shapes[name])
    nil

# Companion PARAM-type registry (same ambiguity set as returns): without it a
# cross-module call to `fn f(a: i32, b: i64)` erased both params to i64 — on
# rv32 ilp32 the caller then marshaled the i64 into the wrong (unaligned)
# register pair while the callee read the ABI-correct one (band/policy/dram/
# target section failures, 2026-07-24).
var _bootstrap_fn_param_hir_types: Dict<text, [HirType]> = {}

fn bootstrap_fn_param_hir_types_register(name: text, tys: [HirType]):
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        if _bootstrap_fn_param_hir_types.contains_key(name):
            _bootstrap_fn_param_hir_types = _bootstrap_fn_param_hir_types.remove(name)
        return
    _bootstrap_fn_param_hir_types[name] = tys

fn bootstrap_fn_param_hir_types_lookup(name: text) -> [HirType]?:
    if _bootstrap_fn_ret_hir_ambig.contains_key(name):
        return nil
    if _bootstrap_fn_param_hir_types.contains_key(name):
        return Some(_bootstrap_fn_param_hir_types[name])
    nil

export BlockId, MirBlock, MirInst, MirInstKind
export MirFunction, MirModule
export MirOperand, MirOperandKind, MirTerminator
export MirBinOp, MirUnaryOp, AggregateKind, GpuAtomicOpKind, MirBorrowKind
export mir_operand_copy, mir_operand_const_int
export MirBuilder
export bootstrap_fn_ret_types_reset, bootstrap_fn_ret_type_register, bootstrap_fn_ret_type_lookup
export bootstrap_fn_ret_hir_type_register, bootstrap_fn_ret_hir_type_lookup
export bootstrap_fn_ret_shape_register, bootstrap_fn_ret_shape_lookup
export bootstrap_fn_param_hir_types_register, bootstrap_fn_param_hir_types_lookup
