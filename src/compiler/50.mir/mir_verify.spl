# Mandatory MIR validity verification (RB-19A, LPH-20261009 lightweight default).
#
# One linear pass per function over the LOWERED MIR, run by 80.driver on every
# module before any backend, optimizer, or cache publication sees it
# (`CompilerDriver.lower_to_mir` / `lower_to_mir_for_explicit_target`). It
# turns today's crash / wrong-code classes into precise per-function
# diagnostics (rule id, module, function, block, instruction, source span)
# delivered through the existing fatal-error channel (`ctx.add_error`), so a
# `--keep-going` build continues collecting diagnostics and nothing invalid
# reaches codegen.
#
# This is the ALWAYS-ON validity core (plan §5.1 RB-19A), not the optional
# RB-19B debug verifier (`ir_verify: boundaries|each_pass`), which stays off.
# Cost contract: O(locals + instructions) integer/kind compares per function,
# one scalar layout index per module plus small local indexes per function;
# no graph or module snapshot.
#
# Rule ids `MIRV-00n[x]` and their lifecycle (error | warning) are recorded in
# `config/compiler/mir_verify_rules.sdn`; `mir_verify_rules()` in
# `mir_verify_levels.spl` is the in-binary projection of that registry and the spec
# `mir_verify_rule_registry_spec.spl` pins the two in agreement. A rule whose
# lifecycle is `warning` is warn-first (noisy on the compiler's own source
# today — see MIR_VERIFY_FINDINGS.md); promotion happens by editing the
# registry record, never by rewording a message.

use compiler.hir.hir_types.{SymbolId}
use std.io_runtime.{env_get_opt}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_types.*
use compiler.mir.mir_instruction_support.*
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_graph.{MirInst, MirBlock, MirFunction, MirModule}
use compiler.mir.mir_verify_levels.{MirVerifyRule, MirVerifyLevels, mir_verify_rules, mir_verify_rule_lifecycle, mir_verify_levels_from_spec, mir_verify_levels_from_env, mir_verify_rule_level_from_spec, mir_verify_rule_level}

var mir_verify_profile_state: i64 = -1
var mir_verify_profile_receipts: i64 = 0

fn mir_verify_profile_note(marker: text):
    if mir_verify_profile_state < 0:
        mir_verify_profile_state = if (env_get_opt("SIMPLE_COMPILER_PHASE_PROFILE") ?? "") == "1": 1 else: 0
    if mir_verify_profile_state == 1 and mir_verify_profile_receipts < 1024:
        mir_verify_profile_receipts = mir_verify_profile_receipts + 1
        eprint("[MIR-VERIFY-PHASE] {marker}\n")

# ============================================================================
# Findings
# ============================================================================

struct MirVerifyFinding:
    rule: text
    module: text
    function: text   # "" for module-level findings
    block: i64       # -1 when not block-scoped
    inst: i64        # -1 for terminators / non-instruction findings
    message: text
    span: Span?

impl MirVerifyFinding:
    fn level() -> text:
        """Resolved level: registry default overridden by SIMPLE_MIR_VERIFY_LEVELS.
        Re-reads the environment: for specs and single findings only. The
        driver resolves `mir_verify_levels_from_env()` once per run and
        calls `levels.level_of(finding.rule)`."""
        mir_verify_rule_level(self.rule)

    fn is_fatal() -> bool:
        self.level() == "error"

    fn is_suppressed() -> bool:
        self.level() == "off"

    fn format() -> text:
        var where_ = "module {self.module}"
        if self.function != "":
            where_ = where_ + ", fn {self.function}"
        if self.block >= 0:
            where_ = where_ + ", block {self.block}"
        if self.inst >= 0:
            where_ = where_ + ", inst {self.inst}"
        var at = ""
        if val s = self.span:
            if s.file != "":
                at = " at {s.file}:{s.line}:{s.col}"
            elif s.line > 0:
                at = " at line {s.line}:{s.col}"
        "MIR verify [{self.rule}]: {self.message} ({where_}){at}"

struct MirVerifyReport:
    findings: [MirVerifyFinding]
    functions_checked: i64
    instructions_checked: i64

impl MirVerifyReport:
    fn fatal_count() -> i64:
        var n = 0
        for f in self.findings:
            if f.is_fatal():
                n = n + 1
        n

    fn is_clean() -> bool:
        self.findings.len() == 0

# ============================================================================
# Type helpers (no allocation beyond the returned text in the error path)
# ============================================================================

# Coarse representation classes used by the cast / call-agreement rules.
val MVT_UNKNOWN: i64 = 0
val MVT_INT: i64 = 1       # I*/U*/Char/Bits/Bool
val MVT_FLOAT: i64 = 2
val MVT_PTR: i64 = 3       # Ptr/Ref/FuncPtr/Opaque/Dict handle
val MVT_AGG: i64 = 4       # Tuple(text)/Struct/Enum/Array/Slice/Result/Union/vectors
val MVT_UNIT: i64 = 5
val MVT_NEVER: i64 = 6

# Variant-membership key = slot * span + discriminant (see enum_slot_of).
val MV_VARIANT_KEY_SPAN: i64 = 4294967296
# Switches up to this many cases are checked for duplicates pairwise.
val MV_SWITCH_PAIRWISE_MAX: i64 = 8

fn mir_verify_type_class(t: MirType) -> i64:
    match t.kind:
        case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64: MVT_INT
        case MirTypeKind.U8 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: MVT_INT
        case MirTypeKind.Bool | MirTypeKind.Char: MVT_INT
        case MirTypeKind.Bits(_, _): MVT_INT
        case MirTypeKind.F32 | MirTypeKind.F64: MVT_FLOAT
        case MirTypeKind.Ptr(_, _) | MirTypeKind.Ref(_, _) | MirTypeKind.FuncPtr(_): MVT_PTR
        case MirTypeKind.Opaque(_) | MirTypeKind.Dict(_, _): MVT_PTR
        case MirTypeKind.Promise(_) | MirTypeKind.Generator(_, _) | MirTypeKind.ActorType(_): MVT_PTR
        case MirTypeKind.Unit: MVT_UNIT
        case MirTypeKind.Never: MVT_NEVER
        case _: MVT_AGG

fn mir_verify_projection_target(t: MirType) -> MirType:
    """One level of indirection: project a field access through a pointer/ref."""
    match t.kind:
        case MirTypeKind.Ptr(pointee, _): pointee
        case MirTypeKind.Ref(referent, _): referent
        case _: t

fn mir_verify_type_bits(t: MirType) -> i64:
    """Bit width of a scalar; 0 when not a fixed-width scalar."""
    match t.kind:
        case MirTypeKind.I8 | MirTypeKind.U8 | MirTypeKind.Bool: 8
        case MirTypeKind.I16 | MirTypeKind.U16: 16
        case MirTypeKind.I32 | MirTypeKind.U32 | MirTypeKind.F32 | MirTypeKind.Char: 32
        case MirTypeKind.I64 | MirTypeKind.U64 | MirTypeKind.F64: 64
        case MirTypeKind.Bits(width, _): width
        case _: 0

fn mir_verify_is_text(t: MirType) -> bool:
    """`text` has two lowerings today: Opaque("str") (runtime string handle)
    and the (ptr<u8>,u64) fat tuple. Both are the language's text type."""
    match t.kind:
        case MirTypeKind.Opaque(name): name == "str"
        case MirTypeKind.Tuple(elements):
            if elements.len() != 2: return false
            var ptr_u8 = false
            match elements[0].kind:
                case MirTypeKind.Ptr(pointee, _):
                    match pointee.kind:
                        case MirTypeKind.U8: ptr_u8 = true
                        case _: ()
                case _: ()
            if not ptr_u8: return false
            match elements[1].kind:
                case MirTypeKind.U64: true
                case _: false
        case _: false

fn mir_verify_type_text(t: MirType) -> text:
    match t.kind:
        case MirTypeKind.I8: "i8"
        case MirTypeKind.I16: "i16"
        case MirTypeKind.I32: "i32"
        case MirTypeKind.I64: "i64"
        case MirTypeKind.U8: "u8"
        case MirTypeKind.U16: "u16"
        case MirTypeKind.U32: "u32"
        case MirTypeKind.U64: "u64"
        case MirTypeKind.F32: "f32"
        case MirTypeKind.F64: "f64"
        case MirTypeKind.Bool: "bool"
        case MirTypeKind.Char: "char"
        case MirTypeKind.Unit: "unit"
        case MirTypeKind.Never: "never"
        case MirTypeKind.Bits(width, signed):
            if signed:
                "sbits{width}"
            else:
                "bits{width}"
        case MirTypeKind.Ptr(pointee, _): "ptr<" + mir_verify_type_text(pointee) + ">"
        case MirTypeKind.Ref(referent, _): "ref<" + mir_verify_type_text(referent) + ">"
        case MirTypeKind.FuncPtr(sig): "fnptr/" + sig.params.len().to_string()
        case MirTypeKind.Array(element, size): "array<" + mir_verify_type_text(element) + ";{size}>"
        case MirTypeKind.Slice(element): "slice<" + mir_verify_type_text(element) + ">"
        case MirTypeKind.Dict(k, v): "dict<" + mir_verify_type_text(k) + "," + mir_verify_type_text(v) + ">"
        case MirTypeKind.Tuple(elements):
            var out = "("
            var i = 0
            while i < elements.len():
                if i > 0: out = out + ","
                out = out + mir_verify_type_text(elements[i])
                i = i + 1
            out + ")"
        case MirTypeKind.Struct(symbol): "struct#{symbol.id}"
        case MirTypeKind.Enum(symbol): "enum#{symbol.id}"
        case MirTypeKind.Result(ok, err): "result<" + mir_verify_type_text(ok) + "," + mir_verify_type_text(err) + ">"
        case MirTypeKind.Union(members): "union/" + members.len().to_string()
        case MirTypeKind.Opaque(name): "opaque<" + name + ">"
        case _: "<other>"

fn mir_verify_type_same(a: MirType, b: MirType) -> bool:
    mir_verify_type_eq(a, b, 0)

fn mir_verify_type_eq(a: MirType, b: MirType, depth: i64) -> bool:
    """Structural equality without allocation (hot path for every aggregate
    call argument). Depth-bounded; unknown/foreign kinds compare equal only
    when their coarse class agrees."""
    if depth > 8:
        return true
    match a.kind:
        case MirTypeKind.Ptr(pa, _):
            match b.kind:
                case MirTypeKind.Ptr(pb, _): mir_verify_type_eq(pa, pb, depth + 1)
                case _: false
        case MirTypeKind.Ref(ra, _):
            match b.kind:
                case MirTypeKind.Ref(rb, _): mir_verify_type_eq(ra, rb, depth + 1)
                case _: false
        case MirTypeKind.Array(ea, na):
            match b.kind:
                case MirTypeKind.Array(eb, nb): na == nb and mir_verify_type_eq(ea, eb, depth + 1)
                case _: false
        case MirTypeKind.Slice(ea):
            match b.kind:
                case MirTypeKind.Slice(eb): mir_verify_type_eq(ea, eb, depth + 1)
                case _: false
        case MirTypeKind.Dict(ka, va):
            match b.kind:
                case MirTypeKind.Dict(kb, vb): mir_verify_type_eq(ka, kb, depth + 1) and mir_verify_type_eq(va, vb, depth + 1)
                case _: false
        case MirTypeKind.Tuple(ea):
            match b.kind:
                case MirTypeKind.Tuple(eb):
                    if ea.len() != eb.len(): return false
                    var i = 0
                    while i < ea.len():
                        if not mir_verify_type_eq(ea[i], eb[i], depth + 1): return false
                        i = i + 1
                    true
                case _: false
        case MirTypeKind.Struct(sa):
            match b.kind:
                case MirTypeKind.Struct(sb): sa.id == sb.id
                case _: false
        case MirTypeKind.Enum(sa):
            match b.kind:
                case MirTypeKind.Enum(sb): sa.id == sb.id
                case _: false
        case MirTypeKind.Result(oa, ea):
            match b.kind:
                case MirTypeKind.Result(ob, eb): mir_verify_type_eq(oa, ob, depth + 1) and mir_verify_type_eq(ea, eb, depth + 1)
                case _: false
        case MirTypeKind.Opaque(na):
            match b.kind:
                case MirTypeKind.Opaque(nb): na == nb
                case _: false
        case MirTypeKind.Bits(wa, sa):
            match b.kind:
                case MirTypeKind.Bits(wb, sb): wa == wb and sa == sb
                case _: false
        case _:
            mir_verify_type_class(a) == mir_verify_type_class(b) and mir_verify_type_bits(a) == mir_verify_type_bits(b)

fn mir_verify_type_unresolved_reason(t: MirType, depth: i64) -> text:
    """'' when the type is fully resolved; otherwise why it is not.

    MIR has no Infer/Error kind: lowering is fatal on Infer and (today) erases
    HIR `Error` to I64, so the detectable residue is an Opaque with an empty or
    `<…>` marker name, a nominal with a negative symbol id, and unknown
    callee signatures. Depth-bounded so a pathological nested type cannot make
    this super-linear."""
    if depth > 8:
        return ""
    match t.kind:
        case MirTypeKind.Opaque(name):
            if name == "" or name.starts_with("<"):
                return "unresolved opaque type '" + name + "'"
            ""
        case MirTypeKind.Struct(symbol):
            if symbol.id < 0: return "struct with unresolved symbol id {symbol.id}"
            ""
        case MirTypeKind.Enum(symbol):
            if symbol.id < 0: return "enum with unresolved symbol id {symbol.id}"
            ""
        case MirTypeKind.Ptr(pointee, _): mir_verify_type_unresolved_reason(pointee, depth + 1)
        case MirTypeKind.Ref(referent, _): mir_verify_type_unresolved_reason(referent, depth + 1)
        case MirTypeKind.Array(element, _): mir_verify_type_unresolved_reason(element, depth + 1)
        case MirTypeKind.Slice(element): mir_verify_type_unresolved_reason(element, depth + 1)
        case MirTypeKind.Tuple(elements):
            for e in elements:
                val r = mir_verify_type_unresolved_reason(e, depth + 1)
                if r != "": return r
            ""
        case MirTypeKind.Result(ok, err):
            val r = mir_verify_type_unresolved_reason(ok, depth + 1)
            if r != "": return r
            mir_verify_type_unresolved_reason(err, depth + 1)
        case _: ""

# ============================================================================
# Per-function verifier state (one small index array, reused per function)
# ============================================================================

struct MirFnVerifier:
    module_name: text
    fn_name: text
    findings: [MirVerifyFinding]
    # dense position of each LocalId.id (-1 = no such local)
    pos_of_id: [i64]
    locals: [MirLocal]
    # Index once by the semantic id; native boxed SymbolId keys are not stable.
    type_by_id: Dict<i64, MirTypeDef>
    defined: [bool]      # local receives a value somewhere in the function
    used: [i64]          # read count
    cond_def: [bool]     # defined by a comparison BinOp into a Bool slot
    block_pos: [i64]     # dense position of each BlockId.id (-1 = none)
    cur_block: i64
    cur_inst: i64
    cur_span: Span?
    # Variant-membership cache, built once per enum per function (see
    # `enum_slot_of`). All three containers stay empty for a function that
    # never names an enum variant.
    enum_slot: Dict<i64, i64>       # enum SymbolId.id -> slot (-1 = uncached path)
    variant_keys: Dict<i64, bool>   # slot * MV_VARIANT_KEY_SPAN + discriminant
    enum_names: [text]              # per slot, for the diagnostic only
    enum_counts: [i64]

impl MirFnVerifier:
    me report(rule: text, message: text):
        self.findings = self.findings.push(MirVerifyFinding(
            rule: rule, module: self.module_name, function: self.fn_name,
            block: self.cur_block, inst: self.cur_inst, message: message,
            span: self.cur_span))

    fn local_pos(id: LocalId) -> i64:
        if id.id < 0 or id.id >= self.pos_of_id.len():
            return -1
        self.pos_of_id[id.id]

    fn local_type(id: LocalId) -> MirType?:
        val p = self.local_pos(id)
        if p < 0: return nil
        Some(self.locals[p].type_)

    fn operand_type(op: MirOperand) -> MirType?:
        match op.kind:
            case MirOperandKind.Copy(local): self.local_type(local)
            case MirOperandKind.Move(local): self.local_type(local)
            case MirOperandKind.Const(_, type_): Some(type_)

    me use_local(id: LocalId):
        val p = self.local_pos(id)
        if p < 0:
            self.report("MIRV-005b", "use of local %{id.id} that is not declared in this function")
            return
        self.used[p] = self.used[p] + 1

    me use_operand(op: MirOperand):
        match op.kind:
            case MirOperandKind.Copy(local): self.use_local(local)
            case MirOperandKind.Move(local): self.use_local(local)
            case MirOperandKind.Const(_, _): ()

    me use_operands(ops: [MirOperand]):
        for op in ops:
            self.use_operand(op)

    me def_local(id: LocalId):
        val p = self.local_pos(id)
        if p < 0:
            self.report("MIRV-005b", "definition of local %{id.id} that is not declared in this function")
            return
        self.defined[p] = true

    me def_local_opt(id: LocalId?):
        if val d = id:
            self.def_local(d)

    me def_operand_base(op: MirOperand):
        """Mark the local behind an operand as defined WITHOUT counting a use.
        Used where a local is initialised indirectly: address-taken (`Ref`,
        `GetElementPtr`), written through a pointer (`Store` target), or
        passed to an intrinsic/call that fills an out-parameter. MIRV-005e is
        therefore 'no direct or indirect definition anywhere in the function',
        not dominance -- see mir_verify_rules.sdn (005e stays warn-first)."""
        match op.kind:
            case MirOperandKind.Copy(local):
                val p = self.local_pos(local)
                if p >= 0: self.defined[p] = true
            case MirOperandKind.Move(local):
                val p = self.local_pos(local)
                if p >= 0: self.defined[p] = true
            case MirOperandKind.Const(_, _): ()

    fn block_exists(id: BlockId) -> bool:
        id.id >= 0 and id.id < self.block_pos.len() and self.block_pos[id.id] >= 0

    me check_target(id: BlockId, what: text):
        if not self.block_exists(id):
            self.report("MIRV-005", "{what} targets block {id.id}, which does not exist in this function")

    # ---- rule bodies -------------------------------------------------------

    me check_cast(dest: LocalId, operand: MirOperand, target: MirType, bitcast: bool):
        val src_opt = self.operand_type(operand)
        if src_opt == nil:
            return
        val src = src_opt!
        val sc = mir_verify_type_class(src)
        val tc = mir_verify_type_class(target)
        # MIRV-002 is deliberately NARROW (review of 0df5354dfca): `lower_cast_expr`
        # emits Cast for every non-enum `as`, and text/aggregate <-> i64/ptr
        # handle casts and same-type `x as T` are legal today (backends lower
        # them as PtrToInt/IntToPtr or no-ops). The only shape no backend can
        # lower is a text or aggregate value cast to/from a NARROW scalar:
        # `s[i] as u8` (the "ptr to i8" LLVM crash) or `s as f64`.
        val src_wide = sc == MVT_AGG or mir_verify_is_text(src)
        val dst_wide = tc == MVT_AGG or mir_verify_is_text(target)
        val src_narrow = sc == MVT_FLOAT or (sc == MVT_INT and mir_verify_type_bits(src) < 64)
        val dst_narrow = tc == MVT_FLOAT or (tc == MVT_INT and mir_verify_type_bits(target) < 64)
        if (src_wide and dst_narrow) or (src_narrow and dst_wide):
            # Renderings are built on the error path only.
            val src_text = mir_verify_type_text(src)
            val dst_text = mir_verify_type_text(target)
            val what = if mir_verify_is_text(src) or mir_verify_is_text(target): "text" else: "aggregate"
            self.report("MIRV-002", "raw cast between {what} and narrow scalar: {src_text} -> {dst_text}; no backend can lower this (use a byte/char accessor or a conversion call)")
            return
        if bitcast:
            val sb = mir_verify_type_bits(src)
            val tb = mir_verify_type_bits(target)
            if sb != 0 and tb != 0 and sb != tb:
                self.report("MIRV-002b", "bitcast between different widths: " + mir_verify_type_text(src) + " ({sb} bits) -> " + mir_verify_type_text(target) + " ({tb} bits)")

    me check_field(base: MirOperand, field: i64, module: MirModule, write: bool):
        val base_opt = self.operand_type(base)
        if base_opt == nil:
            return
        val base_t = base_opt!
        val bt = mir_verify_projection_target(base_t)
        val op_name = if write: "SetField" else: "GetField"
        match bt.kind:
            case MirTypeKind.Tuple(elements):
                if field < 0 or field >= elements.len():
                    self.report("MIRV-006", "{op_name} index {field} outside tuple layout of {elements.len()} element(s)")
            case MirTypeKind.Struct(symbol):
                val def_opt: MirTypeDef? = self.type_by_id[symbol.id]
                if def_opt == nil:
                    self.report("MIRV-006b", "{op_name} index {field} on struct#{symbol.id} whose layout owner is not resolved in this module")
                    return
                val def = def_opt!
                match def.kind:
                    case MirTypeDefKind.Struct(fields):
                        if field < 0 or field >= fields.len():
                            self.report("MIRV-006", "{op_name} index {field} outside struct '{def.name}' layout of {fields.len()} field(s)")
                    case _:
                        self.report("MIRV-006", "{op_name} on '{def.name}', which is not a struct layout")
            case _:
                ()

    me enum_slot_of(symbol: SymbolId, module: MirModule) -> i64:
        """Slot of `symbol`'s variant set in this function's cache; the set is
        built ONCE per enum per function. -1 = not a resolved enum whose
        discriminants all lie in [0, MV_VARIANT_KEY_SPAN): the caller takes
        the uncached diagnostic path in `check_variant`."""
        if self.enum_slot.has(symbol.id):
            return self.enum_slot[symbol.id]!
        var slot = -1
        val def_opt: MirTypeDef? = self.type_by_id[symbol.id]
        if def_opt != nil:
            val def = def_opt!
            match def.kind:
                case MirTypeDefKind.Enum(variants):
                    var in_range = true
                    for v in variants:
                        if v.discriminant < 0 or v.discriminant >= MV_VARIANT_KEY_SPAN:
                            in_range = false
                    if in_range:
                        slot = self.enum_names.len()
                        for v in variants:
                            self.variant_keys[slot * MV_VARIANT_KEY_SPAN + v.discriminant] = true
                        self.enum_names = self.enum_names.push(def.name)
                        self.enum_counts = self.enum_counts.push(variants.len())
                case _: ()
        self.enum_slot[symbol.id] = slot
        slot

    me check_switch_duplicates(targets: [SwitchCase]):
        """Duplicate case values of a LARGE switch (set lookup, O(n)). Small
        switches are compared pairwise inline with no allocation."""
        var seen_cases: Dict<i64, bool> = {}
        for t in targets:
            if seen_cases.has(t.value):
                self.report("MIRV-005", "Switch has duplicate case value {t.value}")
            else:
                seen_cases[t.value] = true

    me check_variant(symbol: SymbolId, variant: i64, module: MirModule, what: text):
        val slot = self.enum_slot_of(symbol, module)
        if slot >= 0:
            if variant < 0 or variant >= MV_VARIANT_KEY_SPAN or not self.variant_keys.has(slot * MV_VARIANT_KEY_SPAN + variant):
                val enum_name = self.enum_names[slot]
                val variant_count = self.enum_counts[slot]
                self.report("MIRV-005d", "{what} references variant {variant}, which is not a variant of enum '{enum_name}' ({variant_count} variant(s))")
            return
        # Uncached path: unresolved owner, not an enum, or discriminants
        # outside the key span (one linear scan).
        val def_opt: MirTypeDef? = self.type_by_id[symbol.id]
        if def_opt == nil:
            self.report("MIRV-006b", "{what} references enum#{symbol.id} whose definition is not resolved in this module")
            return
        val def = def_opt!
        match def.kind:
            case MirTypeDefKind.Enum(variants):
                var found = false
                for v in variants:
                    if v.discriminant == variant:
                        found = true
                if not found:
                    self.report("MIRV-005d", "{what} references variant {variant}, which is not a variant of enum '{def.name}' ({variants.len()} variant(s))")
            case _:
                self.report("MIRV-005d", "{what} references '{def.name}', which is not an enum")

    me check_call(dest: LocalId?, func: MirOperand, args: [MirOperand], module: MirModule, fn_by_name: Dict<text, MirFunction>):
        self.def_local_opt(dest)
        self.use_operand(func)
        self.use_operands(args)
        match func.kind:
            case MirOperandKind.Const(value, type_):
                var callee_name = ""
                match value:
                    case MirConstValue.Str(name): callee_name = name
                    case _: ()
                if callee_name == "":
                    return
                val callee_opt: MirFunction? = fn_by_name[callee_name]
                if callee_opt == nil:
                    # Extern / cross-module callee: identity is resolved at
                    # link time; nothing to compare against here.
                    return
                val callee: MirFunction = callee_opt!
                if callee.is_generic_template:
                    self.report("MIRV-004", "call to '{callee_name}', which is an un-emitted generic template (no specialization was selected)")
                    return
                val sig = callee.signature
                val params = sig.params
                if sig.params_known or params.len() > 0:
                    val arity_ok = if sig.is_variadic: args.len() >= params.len() else: args.len() == params.len()
                    if not arity_ok:
                        self.report("MIRV-004b", "call to '{callee_name}' passes {args.len()} argument(s) but the callee declares {params.len()}")
                        return
                    var i = 0
                    while i < params.len():
                        val at_opt = self.operand_type(args[i])
                        if at_opt != nil:
                            val at = at_opt!
                            val pc = mir_verify_type_class(params[i])
                            val ac = mir_verify_type_class(at)
                            # Int widths coerce in every backend; pointers and
                            # i64 handles are interchangeable by convention.
                            var compatible = pc == ac or
                                (pc == MVT_PTR and ac == MVT_INT and mir_verify_type_bits(at) == 64) or
                                (ac == MVT_PTR and pc == MVT_INT and mir_verify_type_bits(params[i]) == 64)
                            if pc == MVT_AGG and ac == MVT_AGG:
                                compatible = mir_verify_type_same(params[i], at)
                            if mir_verify_is_text(params[i]) and mir_verify_is_text(at):
                                compatible = true
                            if not compatible:
                                self.report("MIRV-004c", "call to '{callee_name}' argument {i} has type " + mir_verify_type_text(at) + " but the callee parameter is " + mir_verify_type_text(params[i]))
                        i = i + 1
            case _:
                # Indirect call through a value: the operand must be callable.
                val ft_opt = self.operand_type(func)
                if ft_opt != nil:
                    val fc = mir_verify_type_class(ft_opt!)
                    val is_handle = fc == MVT_INT and mir_verify_type_bits(ft_opt!) == 64
                    if fc != MVT_PTR and not is_handle:
                        self.report("MIRV-004d", "Call through a value of non-callable type " + mir_verify_type_text(ft_opt!) + " (closure/aggregate callee needs CallIndirect with a signature)")

    me visit_inst(inst: MirInst, module: MirModule, fn_by_name: Dict<text, MirFunction>):
        match inst.kind:
            case MirInstKind.Const(dest, _, type_):
                self.def_local(dest)
                val reason = mir_verify_type_unresolved_reason(type_, 0)
                if reason != "":
                    self.report("MIRV-001", "Const result has {reason}")
            case MirInstKind.Copy(dest, src):
                self.def_local(dest)
                self.use_local(src)
            case MirInstKind.Move(dest, src):
                self.def_local(dest)
                self.use_local(src)
            case MirInstKind.TransferOut(dest, source, _, _, _, _):
                self.def_local(dest)
                self.use_local(source)
            case MirInstKind.TransferIn(dest, _, _, _):
                self.def_local(dest)
            case MirInstKind.FreezeRegion(local):
                self.use_local(local)
            case MirInstKind.AcquireSnapshot(dest, source):
                self.def_local(dest)
                self.use_local(source)
            case MirInstKind.CommitUpdates(dest, base, updates):
                self.def_local_opt(dest)
                self.use_local(base)
                self.use_local(updates)
            case MirInstKind.Drop(local):
                self.use_local(local)
            case MirInstKind.BinOp(dest, op, left, right):
                self.def_local(dest)
                self.use_operand(left)
                self.use_operand(right)
                match op:
                    case MirBinOp.Eq | MirBinOp.Ne | MirBinOp.Lt | MirBinOp.Le | MirBinOp.Gt | MirBinOp.Ge:
                        val p = self.local_pos(dest)
                        if p >= 0:
                            match self.locals[p].type_.kind:
                                case MirTypeKind.Bool: self.cond_def[p] = true
                                case _: ()
                    case _: ()
            case MirInstKind.CheckedBinOp(dest, _, left, right):
                self.def_local(dest)
                self.use_operand(left)
                self.use_operand(right)
            case MirInstKind.UnaryOp(dest, _, operand):
                self.def_local(dest)
                self.use_operand(operand)
            case MirInstKind.Alloc(dest, type_):
                self.def_local(dest)
                val reason = mir_verify_type_unresolved_reason(type_, 0)
                if reason != "":
                    self.report("MIRV-001", "Alloc has {reason}")
            case MirInstKind.Load(dest, ptr):
                self.def_local(dest)
                self.use_operand(ptr)
            case MirInstKind.Store(ptr, value):
                self.use_operand(ptr)
                self.use_operand(value)
                # A Store through a local-held pointer initialises what it
                # points at; when that pointer IS the var slot (address-taken
                # var lowered as its own pointer), count the slot as defined.
                self.def_operand_base(ptr)
            case MirInstKind.GetElementPtr(dest, base, indices):
                self.def_local(dest)
                self.use_operand(base)
                self.use_operands(indices)
                # Address-taken: the pointee may be initialised through the
                # resulting pointer (Store), so the base counts as defined.
                self.def_operand_base(base)
            case MirInstKind.LoadGlobal(dest, _):
                self.def_local(dest)
            case MirInstKind.StoreGlobal(_, value):
                self.use_operand(value)
            case MirInstKind.GlobalAddr(dest, _, _):
                self.def_local(dest)
            case MirInstKind.Aggregate(dest, kind, operands):
                self.def_local(dest)
                self.use_operands(operands)
                match kind:
                    case AggregateKind.Enum(symbol, variant):
                        self.check_variant(symbol, variant, module, "Aggregate")
                    case _: ()
            case MirInstKind.GetField(dest, base, field):
                self.def_local(dest)
                self.use_operand(base)
                self.check_field(base, field, module, false)
            case MirInstKind.SetField(base, field, value):
                self.use_operand(base)
                self.use_operand(value)
                self.check_field(base, field, module, true)
            case MirInstKind.Cast(dest, operand, target):
                self.def_local(dest)
                self.use_operand(operand)
                self.check_cast(dest, operand, target, false)
            case MirInstKind.Bitcast(dest, operand, target):
                self.def_local(dest)
                self.use_operand(operand)
                self.check_cast(dest, operand, target, true)
            case MirInstKind.Call(dest, func, args):
                self.check_call(dest, func, args, module, fn_by_name)
            case MirInstKind.CallIndirect(dest, ptr, args, _):
                self.def_local_opt(dest)
                self.use_operand(ptr)
                self.use_operands(args)
                val pt_opt = self.operand_type(ptr)
                if pt_opt != nil:
                    val pc = mir_verify_type_class(pt_opt!)
                    val is_handle = pc == MVT_INT and mir_verify_type_bits(pt_opt!) == 64
                    if pc != MVT_PTR and not is_handle:
                        self.report("MIRV-004d", "CallIndirect through a value of non-callable type " + mir_verify_type_text(pt_opt!))
            case MirInstKind.Intrinsic(dest, _, args):
                self.def_local_opt(dest)
                self.use_operands(args)
                # Intrinsics fill out-parameters passed by local; count them
                # as definitions rather than reads of an undefined slot.
                for a in args:
                    self.def_operand_base(a)
            case MirInstKind.Ref(dest, _, place):
                self.def_local(dest)
                self.use_local(place.local)
                # Address-taken var: initialised through the reference later.
                val rp = self.local_pos(place.local)
                if rp >= 0: self.defined[rp] = true
                for proj in place.projection:
                    match proj:
                        case MirProjection.Index(local): self.use_local(local)
                        case _: ()
            case MirInstKind.DebugValue(local, _):
                self.use_local(local)
            case MirInstKind.CreatePromise(dest, body, _):
                self.def_local(dest)
                self.use_local(body)
            case MirInstKind.Await(dest, promise):
                self.def_local(dest)
                self.use_operand(promise)
            case MirInstKind.Yield(value):
                if val v = value: self.use_operand(v)
            case MirInstKind.Spawn(dest, handler, args):
                self.def_local(dest)
                self.use_operand(handler)
                self.use_operands(args)
            case MirInstKind.Send(dest, target, message):
                self.def_local(dest)
                self.use_operand(target)
                self.use_operand(message)
            case MirInstKind.Receive(dest, timeout):
                self.def_local(dest)
                if val t = timeout: self.use_operand(t)
            case MirInstKind.PipeForward(dest, value, func):
                self.def_local(dest)
                self.use_operand(value)
                self.use_operand(func)
            case MirInstKind.Compose(dest, f, g, _):
                self.def_local(dest)
                self.use_operand(f)
                self.use_operand(g)
            case MirInstKind.Parallel(dest, funcs):
                self.def_local(dest)
                self.use_operands(funcs)
            case MirInstKind.LayerConnect(dest, a, b):
                self.def_local(dest)
                self.use_operand(a)
                self.use_operand(b)
            case _:
                # SIMD / GPU / VHDL / asm / probe forms: no dest-type or
                # layout rule applies at this level; they are owned by their
                # own lowering gates. Their dests are still definitions.
                self.visit_other_dest(inst)

    me visit_other_dest(inst: MirInst):
        match inst.kind:
            case MirInstKind.SimdAddF32x4(dest, _, _) | MirInstKind.SimdSubF32x4(dest, _, _) | MirInstKind.SimdMulF32x4(dest, _, _) | MirInstKind.SimdDivF32x4(dest, _, _):
                self.def_local(dest)
            case MirInstKind.MirSimdSplat(dest, _, _) | MirInstKind.MirSimdLoad(dest, _, _, _) | MirInstKind.MirSimdBinop(dest, _, _, _) | MirInstKind.MirSimdUnop(dest, _, _) | MirInstKind.MirSimdReduce(dest, _, _) | MirInstKind.MirSimdCmp(dest, _, _, _) | MirInstKind.MirSimdSelect(dest, _, _, _):
                self.def_local(dest)
            case MirInstKind.GpuGlobalId(dest, _) | MirInstKind.GpuLocalId(dest, _) | MirInstKind.GpuBlockId(dest, _) | MirInstKind.GpuBlockDim(dest, _) | MirInstKind.GpuGridDim(dest, _) | MirInstKind.GpuSharedAlloc(dest, _, _):
                self.def_local(dest)
            case MirInstKind.GpuAtomicOp(dest, _, _, _) | MirInstKind.GpuAtomicCas(dest, _, _, _):
                self.def_local(dest)
            case _:
                ()

    me visit_terminator(term: MirTerminator, module: MirModule):
        self.cur_inst = -1
        match term:
            case MirTerminator.Goto(target):
                self.check_target(target, "Goto")
            case MirTerminator.Ret(value):
                if val v = value: self.use_operand(v)
            case MirTerminator.If(cond, then_, else_):
                self.use_operand(cond)
                self.check_target(then_, "If.then")
                self.check_target(else_, "If.else")
            case MirTerminator.Switch(value, targets, default):
                self.use_operand(value)
                self.check_target(default, "Switch.default")
                var enum_sym: SymbolId? = nil
                if val vt = self.operand_type(value):
                    match vt.kind:
                        case MirTypeKind.Enum(symbol): enum_sym = Some(symbol)
                        case _: ()
                # Non-error path allocates nothing: the case text is built only
                # when a target is missing, the variant set comes from the
                # per-function cache, and duplicate detection is pairwise up
                # to MV_SWITCH_PAIRWISE_MAX cases (a set beyond that).
                val case_count = targets.len()
                var i = 0
                while i < case_count:
                    val case_value = targets[i].value
                    val case_target = targets[i].target
                    if not self.block_exists(case_target):
                        self.report("MIRV-005", "Switch case {case_value} targets block {case_target.id}, which does not exist in this function")
                    if case_count <= MV_SWITCH_PAIRWISE_MAX:
                        var j = 0
                        while j < i:
                            if targets[j].value == case_value:
                                self.report("MIRV-005", "Switch has duplicate case value {case_value}")
                                j = i
                            j = j + 1
                    if val es = enum_sym:
                        self.check_variant(es, case_value, module, "Switch case")
                    i = i + 1
                if case_count > MV_SWITCH_PAIRWISE_MAX:
                    self.check_switch_duplicates(targets)
            case MirTerminator.Unreachable: ()
            case MirTerminator.Abort(_): ()
            case MirTerminator.Throw(payload, type_tag):
                self.use_operand(payload)
                self.use_operand(type_tag)
            case MirTerminator.Resume(payload, type_tag):
                self.use_operand(payload)
                self.use_operand(type_tag)
            case MirTerminator.CallTerminator(dest, func, args, normal, unwind, payload_dest, tag_dest):
                self.def_local_opt(dest)
                self.use_operand(func)
                self.use_operands(args)
                self.check_target(normal, "CallTerminator.normal")
                if val u = unwind: self.check_target(u, "CallTerminator.unwind")
                self.def_local_opt(payload_dest)
                self.def_local_opt(tag_dest)

# ============================================================================
# Entry points
# ============================================================================

fn mir_verify_function(func: MirFunction, module: MirModule, fn_by_name: Dict<text, MirFunction>) -> [MirVerifyFinding]:
    """Standalone function verification preserves the public call surface."""
    _mir_verify_function_indexed(func, module, fn_by_name, _mir_verify_type_index(module))

fn _mir_verify_type_index(module: MirModule) -> Dict<i64, MirTypeDef>:
    mir_verify_profile_note("type-index:entry")
    # MIR type owners carry the same semantic SymbolId as their module key.
    # Index the payload id so separately boxed references resolve consistently.
    var indexed: Dict<i64, MirTypeDef> = {}
    val definitions: Dict<SymbolId, MirTypeDef> = module.types
    val owners: [MirTypeDef] = definitions.values()
    for definition in owners:
        indexed[definition.symbol.id] = definition
    mir_verify_profile_note("type-index:done")
    indexed

fn _mir_verify_function_indexed(func: MirFunction, module: MirModule, fn_by_name: Dict<text, MirFunction>, type_by_id: Dict<i64, MirTypeDef>) -> [MirVerifyFinding]:
    """One linear pass over `func`. Returns every finding (fatal and warn-first)."""
    # --- index locals (dense fast path; one array sized max id + 1) ---------
    mir_verify_profile_note("function:entry")
    mir_verify_profile_note("function:locals:start name={func.name}")
    var max_local = -1
    for l in func.locals:
        if l.id.id > max_local: max_local = l.id.id
    var pos_of_id: [i64] = []
    var k = 0
    while k <= max_local:
        pos_of_id = pos_of_id.push(-1)
        k = k + 1
    var defined: [bool] = []
    var used: [i64] = []
    var cond_def: [bool] = []
    var p = 0
    while p < func.locals.len():
        val l: MirLocal = func.locals[p]
        if l.id.id >= 0:
            pos_of_id[l.id.id] = p
        var is_def = false
        match l.kind:
            case LocalKind.Arg(_): is_def = true
            case LocalKind.Return: is_def = true
            case _: ()
        defined = defined.push(is_def)
        used = used.push(0)
        cond_def = cond_def.push(false)
        p = p + 1
    mir_verify_profile_note("function:locals:done name={func.name}")
    # --- index blocks --------------------------------------------------------
    var max_block = -1
    for b in func.blocks:
        if b.id.id > max_block: max_block = b.id.id
    var block_pos: [i64] = []
    k = 0
    while k <= max_block:
        block_pos = block_pos.push(-1)
        k = k + 1
    # One Option for the whole function: instructions without their own span
    # share it instead of allocating `Some(func.span)` each.
    val fn_span: Span? = Some(func.span)
    var v = MirFnVerifier(
        module_name: module.name, fn_name: func.name, findings: [],
        pos_of_id: pos_of_id, locals: func.locals, type_by_id: type_by_id, defined: defined, used: used,
        cond_def: cond_def, block_pos: block_pos, cur_block: -1, cur_inst: -1,
        cur_span: fn_span, enum_slot: {}, variant_keys: {}, enum_names: [],
        enum_counts: [])
    var bi = 0
    while bi < func.blocks.len():
        val b: MirBlock = func.blocks[bi]
        if b.id.id < 0:
            v.cur_block = b.id.id
            v.report("MIRV-005", "block has negative id {b.id.id}")
        elif v.block_pos[b.id.id] >= 0:
            v.cur_block = b.id.id
            v.report("MIRV-005", "duplicate block id {b.id.id}")
        else:
            v.block_pos[b.id.id] = bi
        bi = bi + 1
    v.cur_block = -1
    if func.blocks.len() == 0:
        if not func.is_generic_template:
            v.report("MIRV-005", "function has no blocks")
    elif not v.block_exists(func.entry_block):
        v.report("MIRV-005", "entry block {func.entry_block.id} does not exist")
    # --- signature / local types (rule 1 and 3b) ----------------------------
    var si = 0
    while si < func.signature.params.len():
        val reason = mir_verify_type_unresolved_reason(func.signature.params[si], 0)
        if reason != "":
            v.report("MIRV-001", "parameter {si} has {reason}")
        si = si + 1
    val ret_reason = mir_verify_type_unresolved_reason(func.signature.return_type, 0)
    if ret_reason != "":
        v.report("MIRV-001", "return type has {ret_reason}")
    p = 0
    while p < func.locals.len():
        val l: MirLocal = func.locals[p]
        val reason = mir_verify_type_unresolved_reason(l.type_, 0)
        if reason != "":
            v.report("MIRV-001", "local %{l.id.id} ('" + (l.name ?? "") + "') has {reason}")
        match l.kind:
            case LocalKind.Var:
                match l.type_.kind:
                    case MirTypeKind.Unit:
                        v.report("MIRV-003b", "stored local %{l.id.id} ('" + (l.name ?? "") + "') has type unit; a unit value has no storage")
                    case _: ()
            case _: ()
        p = p + 1
    # --- instructions and terminators (rules 2, 4, 5, 6) ---------------------
    var instructions = 0
    bi = 0
    while bi < func.blocks.len():
        val b: MirBlock = func.blocks[bi]
        v.cur_block = b.id.id
        var ii = 0
        while ii < b.instructions.len():
            val inst = b.instructions[ii]
            v.cur_inst = ii
            v.cur_span = if inst.span != nil: inst.span else: fn_span
            v.visit_inst(inst, module, fn_by_name)
            ii = ii + 1
        instructions = instructions + ii
        v.cur_span = fn_span
        v.visit_terminator(b.terminator, module)
        bi = bi + 1
    # --- final linear sweep over locals (5b, 5c) -----------------------------
    v.cur_block = -1
    v.cur_inst = -1
    v.cur_span = fn_span
    p = 0
    while p < func.locals.len():
        if v.used[p] > 0 and not v.defined[p]:
            val l: MirLocal = func.locals[p]
            v.report("MIRV-005e", "local %{l.id.id} ('" + (l.name ?? "") + "') is read but never defined in this function")
        if v.cond_def[p] and v.used[p] == 0:
            val l: MirLocal = func.locals[p]
            v.report("MIRV-005c", "comparison result %{l.id.id} is computed but never consumed by a branch or value (dropped guard/condition)")
        p = p + 1
    v.findings

fn mir_verify_module(module: MirModule) -> MirVerifyReport:
    """Verify every function, static and type owner of one lowered module."""
    mir_verify_profile_note("module:entry")
    mir_verify_profile_note("module:function-index:start name={module.name}")
    var findings: [MirVerifyFinding] = []
    var fn_by_name: Dict<text, MirFunction> = {}
    var name_count: Dict<text, i64> = {}
    # --- rule 7: duplicate symbol definitions ------------------------------
    for f in module.functions.values():
        mir_verify_profile_note("module:function-index:item name={f.name}")
        val prior = name_count[f.name] ?? 0
        name_count[f.name] = prior + 1
        if prior == 0:
            fn_by_name[f.name] = f
        elif prior == 1:
            findings = findings.push(MirVerifyFinding(
                rule: "MIRV-007", module: module.name, function: f.name, block: -1, inst: -1,
                message: "function '{f.name}' is defined more than once in this module (distinct symbol ids lower to one emitted name)",
                span: Some(f.span)))
    mir_verify_profile_note("module:function-index:done name={module.name}")
    mir_verify_profile_note("module:statics:start name={module.name}")
    var static_names: Dict<text, i64> = {}
    for s in module.statics.values():
        mir_verify_profile_note("module:static:start name={s.name} has_init={s.init != nil} external={s.is_external}")
        val prior = static_names[s.name] ?? 0
        static_names[s.name] = prior + 1
        if prior == 1:
            findings = findings.push(MirVerifyFinding(
                rule: "MIRV-007", module: module.name, function: "", block: -1, inst: -1,
                message: "static '{s.name}' is defined more than once in this module", span: nil))
        # --- rule 3: unit static; rule 1: unresolved static type -------------
        match s.type_.kind:
            case MirTypeKind.Unit:
                findings = findings.push(MirVerifyFinding(
                    rule: "MIRV-003", module: module.name, function: "", block: -1, inst: -1,
                    message: "static '{s.name}' has type unit (`global void`); a static must have a sized type", span: nil))
            case _: ()
        val reason = mir_verify_type_unresolved_reason(s.type_, 0)
        if reason != "":
            findings = findings.push(MirVerifyFinding(
                rule: "MIRV-001", module: module.name, function: "", block: -1, inst: -1,
                message: "static '{s.name}' has {reason}", span: nil))
        # --- rule 7b: initializer type agrees with the declared type ---------
        if val init = s.init:
            mir_verify_profile_note("module:static:initializer:start name={s.name}")
            val ic = mir_verify_type_class(init.type_)
            val sc = mir_verify_type_class(s.type_)
            val agree = ic == sc or
                (ic == MVT_PTR and sc == MVT_INT and mir_verify_type_bits(s.type_) == 64) or
                (sc == MVT_PTR and ic == MVT_INT and mir_verify_type_bits(init.type_) == 64)
            if not agree:
                findings = findings.push(MirVerifyFinding(
                    rule: "MIRV-007b", module: module.name, function: "", block: -1, inst: -1,
                    message: "static '{s.name}' declared as " + mir_verify_type_text(s.type_) + " but its initializer has type " + mir_verify_type_text(init.type_),
                    span: nil))
        elif not s.is_external:
            # A defined (non-consumer) static with no initializer is
            # zero-filled by every backend; that is a valid, explicit state.
            ()
        mir_verify_profile_note("module:static:done name={s.name}")
    mir_verify_profile_note("module:statics:done name={module.name}")
    # --- per function -------------------------------------------------------
    var functions_checked = 0
    var instructions_checked = 0
    val type_by_id = _mir_verify_type_index(module)
    for f in module.functions.values():
        mir_verify_profile_note("module:function:start name={f.name}")
        for fnd in _mir_verify_function_indexed(f, module, fn_by_name, type_by_id):
            findings = findings.push(fnd)
        mir_verify_profile_note("module:function:done name={f.name}")
        functions_checked = functions_checked + 1
        for b in f.blocks:
            instructions_checked = instructions_checked + b.instructions.len() + 1
    MirVerifyReport(findings: findings, functions_checked: functions_checked,
                    instructions_checked: instructions_checked)

export MirVerifyRule, MirVerifyLevels, MirVerifyFinding, MirVerifyReport
export mir_verify_rules, mir_verify_rule_lifecycle, mir_verify_levels_from_spec, mir_verify_levels_from_env
export mir_verify_rule_level_from_spec, mir_verify_rule_level
export mir_verify_module, mir_verify_function
export mir_verify_type_class, mir_verify_type_text, mir_verify_type_unresolved_reason
