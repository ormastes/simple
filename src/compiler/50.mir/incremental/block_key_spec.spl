# BlockKey stability spec (C5).
#
# Proves the cache-critical identity properties:
#   - BlockKey digests are INVARIANT under BlockId renumbering (an unrelated
#     edit that renumbers blocks must not change any key);
#   - keys are derived from CFG structure, so reordering the blocks vector
#     changes nothing;
#   - a dangling edge (old<->new correspondence not trustworthy) raises
#     `ambiguous`, the whole-function-fallback signal.
#
# Run: bin/simple test src/compiler/50.mir/incremental/block_key_spec.spl
# (bin/simple test = tree-walk interpreter engine)

use compiler.mir.mir_instructions.{MirBlock, MirTerminator, BlockId, MirOperand, MirOperandKind}
use compiler.mir.mir_types.{MirConstValue, MirType, MirTypeKind}
use compiler.mir.incremental.block_key.{
    BlockKeyMap, compute_block_keys, block_key_digest_for, block_key_for
}

fn _blk(id: i64, label: text?, t: MirTerminator) -> MirBlock:
    MirBlock(id: BlockId(id: id), label: label, instructions: [], terminator: t)

fn _diamond(e: i64, t: i64, f: i64, x: i64) -> [MirBlock]:
    """entry -> if -> (then | else) -> exit"""
    [
        _blk(e, "entry", MirTerminator.If(
            cond: nil_operand(), then_: BlockId(id: t), else_: BlockId(id: f))),
        _blk(t, "then_arm", MirTerminator.Goto(target: BlockId(id: x))),
        _blk(f, "else_arm", MirTerminator.Goto(target: BlockId(id: x))),
        _blk(x, "exit", MirTerminator.Ret(value: nil))
    ]

fn nil_operand() -> MirOperand:
    # operand content is irrelevant to key derivation; simplest constant
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), MirType(kind: MirTypeKind.I64)))

describe "BlockKey stable identity":
    it "survives an edit that renumbers every BlockId":
        val a = compute_block_keys("m.f", _diamond(0, 1, 2, 3), BlockId(id: 0))
        val b = compute_block_keys("m.f", _diamond(40, 17, 8, 99), BlockId(id: 40))
        assert_false(a.ambiguous)
        assert_false(b.ambiguous)
        # role-for-role, the digests are identical despite disjoint BlockIds
        assert_equal(block_key_digest_for(a, 0), block_key_digest_for(b, 40))
        assert_equal(block_key_digest_for(a, 1), block_key_digest_for(b, 17))
        assert_equal(block_key_digest_for(a, 2), block_key_digest_for(b, 8))
        assert_equal(block_key_digest_for(a, 3), block_key_digest_for(b, 99))
        # and the ids themselves are NOT part of the key: then/else digests differ
        assert_not_equal(block_key_digest_for(a, 1), block_key_digest_for(a, 2))

    it "is invariant under blocks-vector reordering":
        val fwd = _diamond(0, 1, 2, 3)
        var rev: [MirBlock] = []
        var i = fwd.len() - 1
        while i >= 0:
            rev.push(fwd[i])
            i = i - 1
        val a = compute_block_keys("m.f", fwd, BlockId(id: 0))
        val b = compute_block_keys("m.f", rev, BlockId(id: 0))
        assert_equal(block_key_digest_for(a, 0), block_key_digest_for(b, 0))
        assert_equal(block_key_digest_for(a, 1), block_key_digest_for(b, 1))
        assert_equal(block_key_digest_for(a, 3), block_key_digest_for(b, 3))

    it "keys differ across parent functions":
        val a = compute_block_keys("m.f", _diamond(0, 1, 2, 3), BlockId(id: 0))
        val b = compute_block_keys("m.g", _diamond(0, 1, 2, 3), BlockId(id: 0))
        assert_not_equal(block_key_digest_for(a, 0), block_key_digest_for(b, 0))

    it "flags ambiguous on a dangling edge (whole-function fallback signal)":
        val blocks = [
            _blk(0, "entry", MirTerminator.Goto(target: BlockId(id: 77)))  # 77 missing
        ]
        val m = compute_block_keys("m.f", blocks, BlockId(id: 0))
        assert_true(m.ambiguous)

    it "does not map unreachable blocks":
        val blocks = [
            _blk(0, "entry", MirTerminator.Ret(value: nil)),
            _blk(1, "island", MirTerminator.Ret(value: nil))
        ]
        val m = compute_block_keys("m.f", blocks, BlockId(id: 0))
        assert_true(block_key_for(m, 1) == nil)
        assert_equal(block_key_digest_for(m, 1), "")
