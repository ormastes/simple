# BlockKey — stable, cache-safe basic-block identity (C5, schema_version 2).
#
# `BlockId` (mir_instruction_support.spl) is a bare i64 index: LOCAL_STATE per
# the frozen schema (c0_schema_freeze_2026-08-09.md §5b). It must NEVER enter a
# cache key or serialized artifact. `BlockKey` is the stable identity:
#   {parent_function, origin_anchor, role, structural_path, same_anchor_ordinal}
# derived purely from CFG STRUCTURE reachable from the entry block — never from
# BlockId numbers, vector indices, source lines, or pointer values.
#
# `compute_block_keys` returns an explicit BlockId -> BlockKey mapping for one
# run. If two reachable blocks collapse to the same (anchor, role, path) the
# map disambiguates with `same_anchor_ordinal` (canonical-DFS order, itself a
# pure function of CFG structure) AND raises `ambiguous`, which consumers must
# treat as "old<->new block correspondence unknown: whole-function fallback".
#
# NOTE on schema types: `EntityKey` and `StableAstId` have no producer in the
# tree yet; `parent_function` carries the function's stable qualified name and
# `origin_anchor` the block label when lowering provided one ("" sentinel
# otherwise), matching the freeze's sentinel rule.

use compiler.mir.mir_instructions.{BlockId, MirTerminator, MirBlock}

enum BlockRole:
    Entry
    GotoTarget
    ThenBranch
    ElseBranch
    SwitchArm
    SwitchDefault
    CallNormal
    CallUnwind

struct BlockKey:
    parent_function: text      # stable qualified function name (EntityKey stand-in)
    origin_anchor: text        # block label if any, "" sentinel (StableAstId stand-in)
    role: BlockRole
    structural_path: text      # digest of the role-edge path from entry
    same_anchor_ordinal: i64   # canonical-DFS disambiguator among identical keys

struct BlockKeyMap:
    """Transient BlockId -> BlockKey mapping for one compile of one function."""
    block_ids: [i64]           # parallel arrays; index-aligned
    keys: [BlockKey]
    ambiguous: bool            # true => whole-function fallback required

fn block_role_name(r: BlockRole) -> text:
    # encode by NAME, never by ordinal (freeze §5a rule)
    match r:
        case Entry: "entry"
        case GotoTarget: "goto"
        case ThenBranch: "then"
        case ElseBranch: "else"
        case SwitchArm: "arm"
        case SwitchDefault: "default"
        case CallNormal: "normal"
        case CallUnwind: "unwind"

fn incr_fnv1a64(s: text) -> text:
    """FNV-1a 64-bit over the text's characters, hex-encoded."""
    var h = 14695981039346656037
    val n = s.len()
    var i = 0
    while i < n:
        h = (h ^ s.char_code_at(i)) & 0xFFFFFFFFFFFFFFFF
        h = (h * 1099511628211) & 0xFFFFFFFFFFFFFFFF
        i = i + 1
    "{h}"

fn block_key_encode(k: BlockKey) -> text:
    """Canonical encoding: length-prefixed fields in frozen order."""
    val f = k.parent_function
    val a = k.origin_anchor
    val r = block_role_name(k.role)
    "F{f.len()}:{f}|A{a.len()}:{a}|R{r.len()}:{r}|P{k.structural_path.len()}:{k.structural_path}|O:{k.same_anchor_ordinal}"

fn block_key_digest(k: BlockKey) -> text:
    incr_fnv1a64(block_key_encode(k))

struct _EdgeStep:
    """One canonical successor edge: target block + role + edge tag."""
    target: i64
    role: BlockRole
    tag: text

fn _terminator_edges(t: MirTerminator) -> [_EdgeStep]:
    """Successor edges in canonical (semantic) order — never storage order."""
    match t:
        case Goto(target):
            [_EdgeStep(target: target.id, role: BlockRole.GotoTarget, tag: "g")]
        case If(_, then_, else_):
            [_EdgeStep(target: then_.id, role: BlockRole.ThenBranch, tag: "t"),
             _EdgeStep(target: else_.id, role: BlockRole.ElseBranch, tag: "e")]
        case Switch(_, targets, default):
            var out: [_EdgeStep] = []
            var i = 0
            while i < targets.len():
                # arm position is semantic (matches the source case order)
                out.push(_EdgeStep(target: targets[i].target.id, role: BlockRole.SwitchArm, tag: "s{i}"))
                i = i + 1
            out.push(_EdgeStep(target: default.id, role: BlockRole.SwitchDefault, tag: "d"))
            out
        case CallTerminator(_, _, _, normal, unwind):
            var out: [_EdgeStep] = []
            out.push(_EdgeStep(target: normal.id, role: BlockRole.CallNormal, tag: "n"))
            if unwind != nil:
                val u = unwind ?? BlockId.entry()
                out.push(_EdgeStep(target: u.id, role: BlockRole.CallUnwind, tag: "u"))
            out
        case _:
            []

fn block_successor_ids(t: MirTerminator) -> [i64]:
    val edges = _terminator_edges(t)
    var out: [i64] = []
    for e in edges:
        out.push(e.target)
    out

fn _find_block_index(blocks: [MirBlock], id: i64) -> i64:
    var i = 0
    while i < blocks.len():
        if blocks[i].id.id == id:
            return i
        i = i + 1
    -1

fn compute_block_keys(parent_function: text, blocks: [MirBlock], entry: BlockId) -> BlockKeyMap:
    """Deterministic canonical DFS from entry along semantic edge order.

    The path digest of a block is derived only from the FIRST canonical path
    that reaches it (edge tags), the block's role on that arriving edge, and
    its label anchor — never from BlockId values.
    """
    var ids: [i64] = []
    var keys: [BlockKey] = []
    var ambiguous = false

    # explicit DFS stack of (block id, arriving role, path-so-far)
    var stack_ids: [i64] = [entry.id]
    var stack_roles: [BlockRole] = [BlockRole.Entry]
    var stack_paths: [text] = ["^"]

    var visited: [i64] = []
    # count occurrences of identical (anchor, role, path) for ordinals
    var seen_encodings: [text] = []
    var seen_counts: [i64] = []

    while stack_ids.len() > 0:
        val top = stack_ids.len() - 1
        val bid = stack_ids[top]
        val role = stack_roles[top]
        val path = stack_paths[top]
        stack_ids.pop()
        stack_roles.pop()
        stack_paths.pop()

        if visited.contains(bid):
            continue
        visited.push(bid)

        val bidx = _find_block_index(blocks, bid)
        if bidx < 0:
            # dangling edge: correspondence cannot be trusted
            ambiguous = true
            continue
        val blk = blocks[bidx]
        val anchor = blk.label ?? ""
        val path_digest = incr_fnv1a64(path)

        # ordinal among identical (anchor, role, path) keys
        val base_enc = "{anchor}{block_role_name(role)}{path_digest}"
        var ordinal = 0
        var si = 0
        var found = false
        while si < seen_encodings.len():
            if seen_encodings[si] == base_enc:
                ordinal = seen_counts[si] + 1
                seen_counts[si] = ordinal
                found = true
                ambiguous = true   # duplicate structural identity => fallback
            si = si + 1
        if not found:
            seen_encodings.push(base_enc)
            seen_counts.push(0)

        ids.push(bid)
        keys.push(BlockKey(
            parent_function: parent_function,
            origin_anchor: anchor,
            role: role,
            structural_path: path_digest,
            same_anchor_ordinal: ordinal))

        # push successors in REVERSE so canonical order pops first
        val edges = _terminator_edges(blk.terminator)
        var ei = edges.len() - 1
        while ei >= 0:
            val e = edges[ei]
            if not visited.contains(e.target):
                stack_ids.push(e.target)
                stack_roles.push(e.role)
                stack_paths.push("{path}/{e.tag}")
            ei = ei - 1

    BlockKeyMap(block_ids: ids, keys: keys, ambiguous: ambiguous)

fn block_key_for(map: BlockKeyMap, id: i64) -> BlockKey?:
    var i = 0
    while i < map.block_ids.len():
        if map.block_ids[i] == id:
            return map.keys[i]
        i = i + 1
    nil

fn block_key_digest_for(map: BlockKeyMap, id: i64) -> text:
    """Digest of the block's key, or "" when the id is unmapped (unreachable)."""
    val k = block_key_for(map, id)
    if k == nil:
        return ""
    block_key_digest(k ?? map.keys[0])

export BlockRole, BlockKey, BlockKeyMap
export block_role_name, block_key_encode, block_key_digest
export compute_block_keys, block_key_for, block_key_digest_for
export block_successor_ids, incr_fnv1a64
