# Shared typed instruction replacement products. Execution belongs to the
# actual-owner current-function transform and canonical Result CFG.
use compiler.mir.mir_instructions.*
use compiler.hir.hir_types.{HirType, SymbolId}
use compiler.mir.source_region_dictionary_site_types_v1.{SourceRegionDictionarySiteV1}

struct SourceRegionOperationPlanV1:
    prelude: [MirInst]
    facade: MirOperand
    args: [MirOperand]
    result_type: MirType
    destination: LocalId?
    success: [MirInst]
    success_type: HirType? = nil
    callee_symbol: SymbolId? = nil
    dictionary_read: SourceRegionDictionarySiteV1? = nil

struct SourceRegionInstructionPlanV1:
    steps: [SourceRegionOperationPlanV1]
    locals: [MirLocal]
    next_local: i64
