# Replace provisional storage by numeric SymbolId identity. Struct-keyed
# dictionaries in admitted bootstrap producers may retain both old and new keys.
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_types.{MirStatic}

pub fn mir_static_storage_finalize(
    statics: Dict<SymbolId, MirStatic>, replacements: [MirStatic]
) -> Dict<SymbolId, MirStatic>:
    var finalized: Dict<i64, MirStatic> = {}
    for replacement in replacements:
        finalized[replacement.symbol.id] = replacement
    var result: Dict<SymbolId, MirStatic> = {}
    for existing in statics.values():
        if not finalized.contains(existing.symbol.id):
            result[existing.symbol] = existing
    for replacement in finalized.values():
        result[replacement.symbol] = replacement
    result
