# Actual HIR-to-resolved-VIR entry. Structural source provenance is not a
# compiler execution attestation, an authenticated resolver, or a proof gate.
use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_types.{HirModule}
use compiler.common.mir_target_context.{MirTargetContext, mir_target_context_from}
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.verification_source_environment_v1.{verification_source_environment_v1}
use compiler.mir.mir_instruction_graph.{MirModule, MirFunction}
use compiler.mir.mir_instructions.{MirInstKind, MirTerminator}
use compiler.mir.verification_call_identity.{ResolvedDirectCallManifestV1,
    resolved_direct_call_module_hash_v1}
use compiler.mir.verification_call_manifest_finalizer.{finalize_resolved_direct_call_manifest_v1}
use compiler.mir.verification_ir.{ResolvedVerificationIrModuleV2,
    verification_ir_module_from_resolved_mir_v2}

pub struct ResolvedCallLoweringV1:
    module: MirModule
    calls: ResolvedDirectCallManifestV1

fn verification_call_boundary_v1(module: MirModule) -> text:
    for key in module.functions.keys():
        val function: MirFunction = module.functions[key]
        for block in function.blocks:
            match block.terminator:
                case MirTerminator.CallTerminator(_, _, _, _, _, _, _):
                    return "FV2-E-CALL-SOURCE-BOUNDARY: throwing call terminators require a separate resolved-site contract"
                case _: ()
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.CallIndirect(_, _, _, _):
                        return "FV2-E-CALL-SOURCE-BOUNDARY: indirect calls require independent target authority"
                    case _: ()
    ""

pub fn lower_module_with_resolved_calls_v1(module: HirModule
) -> Result<ResolvedCallLoweringV1, text>:
    lower_module_with_resolved_calls_for_target_v1(module,
        mir_target_context_from("", "unknown", "unknown", "llvm", -1))

fn verification_capture_target_key_v1(target: MirTargetContext) -> text:
    var fields = [target.arch, target.os, target.abi, target.backend,
        target.version.to_string(), target.collection_policy,
        target.collection_memory_budget_bytes.to_string(),
        target.collection_opt_level.to_string(),
        if target.collection_trace_active: "1" else: "0",
        if target.collection_target_admitted: "1" else: "0"]
    var framed: [text] = []
    for field in fields: framed.push(field.len().to_string() + ":" + field)
    "C1-MIR-TARGET-v1|" + framed.join("")

pub fn lower_module_with_resolved_calls_for_target_v1(module: HirModule,
    target: MirTargetContext
) -> Result<ResolvedCallLoweringV1, text>:
    if module == nil or module.symbols == nil:
        return Err("FV2-E-CALL-SOURCE-OWNER: a retained source module and symbol environment are required")
    val symbols = verification_source_environment_v1(module.symbols)?
    var owned_module = module
    owned_module.symbols = symbols
    var lowering = MirLowering.new_for_target(symbols, target)
    lowering.allow_ambient_bootstrap_policy = false
    lowering.verification_capture_enabled = true
    val mir = lowering.lower_module(owned_module)
    if lowering.verification_capture_error != "":
        return Err(lowering.verification_capture_error)
    if lowering.errors.len() > 0:
        return Err("FV2-E-CALL-SOURCE-LOWERING: " + lowering.errors[0].message)
    val boundary = verification_call_boundary_v1(mir)
    if boundary != "": return Err(boundary)
    var rows: [text] = []
    for capture in lowering.verification_call_captures:
        rows.push(capture.site_key() + "|" + capture.callee_symbol_id)
    # Derived only from this invocation's captured facts and completed MIR.
    # It carries no caller boolean and makes no independent-authenticity claim.
    val receipt = sha256_text("C1-source-call-capture-v1|module=" +
        resolved_direct_call_module_hash_v1(mir) + "|path=" +
        module.path.len().to_string() + ":" + module.path + "|target=" +
        verification_capture_target_key_v1(target) + "|captures=" + rows.join(";"))
    val calls = finalize_resolved_direct_call_manifest_v1(mir, receipt,
        lowering.verification_call_captures)?
    Ok(ResolvedCallLoweringV1(mir, calls))

pub fn verification_ir_module_from_hir_calls_v1(module: HirModule,
    source_hash: text, expanded_hash: text, woven_hash: text, policy_hash: text
) -> Result<ResolvedVerificationIrModuleV2, text>:
    val lowered = lower_module_with_resolved_calls_v1(module)?
    val result = verification_ir_module_from_resolved_mir_v2(lowered.module,
        source_hash, expanded_hash, woven_hash, policy_hash, lowered.calls)
    if not result.closure_ready(): return Err(result.diagnostic)
    Ok(result)
