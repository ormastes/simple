# Finalize actual canonical-emitter sites against the candidate body/module.
use compiler.mir.canonical_enum_builtin_site_v1.*
use compiler.mir.mir_types.{MirType, LocalId, MirConstValue}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_graph.{MirModule, MirFunction}
use compiler.mir.mir_json.{serialize_mir_function, serialize_operand, serialize_mir_type}
use compiler.mir.verification_call_identity.{resolved_direct_call_module_hash_v1}
use std.common.crypto.sha256.{sha256_text}

fn canonical_enum_local_type_v1(function: MirFunction, operand: MirOperand) -> Result<MirType, text>:
    match operand.kind:
        case MirOperandKind.Const(_, type_): Ok(type_)
        case MirOperandKind.Copy(local) | MirOperandKind.Move(local):
            var count = 0
            var type_ = MirType.unit()
            for declared in function.locals:
                if declared.id.id == local.id:
                    count = count + 1
                    type_ = declared.type_
            if count != 1: return Err("ENUM-ORIGIN: operand lacks unique actual local")
            Ok(type_)

fn canonical_enum_uses_result_v1(operand: MirOperand, result: LocalId?) -> bool:
    if val expected = result:
        match operand.kind:
            case MirOperandKind.Copy(local) | MirOperandKind.Move(local): return local.id == expected.id
            case _: ()
    false

fn canonical_enum_expected_abi_name_v1(operation: CanonicalEnumBuiltinOperationV1) -> text:
    match operation:
        case CanonicalEnumBuiltinOperationV1.New: "rt_enum_new"
        case CanonicalEnumBuiltinOperationV1.CheckVariant: "rt_enum_check_variant"
        case CanonicalEnumBuiltinOperationV1.Payload: "rt_enum_payload"
        case CanonicalEnumBuiltinOperationV1.Discriminant: "rt_enum_discriminant"
        case CanonicalEnumBuiltinOperationV1.Panic: "rt_panic"

pub fn canonical_enum_builtin_finalize_v1(module: MirModule, function: MirFunction,
        sites: [CanonicalEnumBuiltinSiteV1]) -> Result<CanonicalEnumBuiltinManifestV1, text>:
    val actual = module.functions.get(function.symbol)
    if actual == nil: return Err("ENUM-ORIGIN: function absent from candidate module")
    if val declared = actual:
        if serialize_mir_function(declared) != serialize_mir_function(function):
            return Err("ENUM-ORIGIN: candidate function body differs")
    var seen: Dict<text, bool> = {}
    var rows: [text] = ["CanonicalEnumBuiltin-v1"]
    var uses: [CanonicalEnumBuiltinCfgUseV1] = []
    for index in 0..sites.len():
        val site = sites[index]
        if site.owner.id != function.symbol.id or site.abi != 1:
            return Err("ENUM-ORIGIN: foreign owner or primitive ABI")
        match site.callee.kind:
            case MirOperandKind.Const(MirConstValue.Str(name), _):
                # The producer supplies the operation; this checks its emitted
                # ABI spelling, never infers origin from an arbitrary name.
                if name != canonical_enum_expected_abi_name_v1(site.operation):
                    return Err("ENUM-ORIGIN: operation and emitted primitive ABI differ")
            case _: return Err("ENUM-ORIGIN: canonical primitive call operand absent")
        val key = "{site.block.id}:{site.instruction_index}"
        if seen.has(key): return Err("ENUM-ORIGIN: duplicate primitive site")
        seen[key] = true
        var block_index = -1
        for candidate in 0..function.blocks.len():
            if function.blocks[candidate].id.id == site.block.id:
                if block_index >= 0: return Err("ENUM-ORIGIN: duplicate actual block")
                block_index = candidate
        if block_index < 0 or site.instruction_index < 0:
            return Err("ENUM-ORIGIN: actual site absent")
        val block = function.blocks[block_index]
        if site.instruction_index >= block.instructions.len():
            return Err("ENUM-ORIGIN: actual instruction absent")
        match block.instructions[site.instruction_index].kind:
            case MirInstKind.Call(destination, callee, arguments):
                if (serialize_operand(callee) != serialize_operand(site.callee) or
                        arguments.len() != site.operands.len() or arguments.len() != site.operand_types.len()):
                    return Err("ENUM-ORIGIN: actual call operands differ")
                if (destination == nil) != (site.result == nil):
                    return Err("ENUM-ORIGIN: actual destination presence differs")
                if val local = destination:
                    if local.id != (site.result ?? LocalId(id: -1)).id:
                        return Err("ENUM-ORIGIN: actual destination identity differs")
                    val result_type = canonical_enum_local_type_v1(function,
                        MirOperand(kind: MirOperandKind.Copy(local)))?
                    if serialize_mir_type(result_type) != serialize_mir_type(site.result_type):
                        return Err("ENUM-ORIGIN: actual result type differs")
                for argument in 0..arguments.len():
                    if serialize_operand(arguments[argument]) != serialize_operand(site.operands[argument]):
                        return Err("ENUM-ORIGIN: changed primitive argument")
                    val type_ = canonical_enum_local_type_v1(function, arguments[argument])?
                    if serialize_mir_type(type_) != serialize_mir_type(site.operand_types[argument]):
                        return Err("ENUM-ORIGIN: actual argument type differs")
            case _: return Err("ENUM-ORIGIN: actual site is not a call")
        # These are observations of actual CFG, not predicted success flags.
        for user in function.blocks:
            match user.terminator:
                case MirTerminator.If(condition, _, _) | MirTerminator.Switch(condition, _, _):
                    if canonical_enum_uses_result_v1(condition, site.result):
                        uses.push(CanonicalEnumBuiltinCfgUseV1(site_index: index,
                            block: user.id, terminator: user.terminator))
                case _: ()
        rows.push(key + "|{site.operation}|abi={site.abi}|enum={site.enum_runtime_id}|disc={site.discriminant}|")
        rows.push(serialize_operand(site.callee))
        for operand in site.operands: rows.push(serialize_operand(operand))
        for type_ in site.operand_types: rows.push(serialize_mir_type(type_))
        rows.push(serialize_mir_type(site.result_type))
    val function_digest = sha256_text(serialize_mir_function(function))
    val module_digest = resolved_direct_call_module_hash_v1(module)
    rows.push(function_digest)
    rows.push(module_digest)
    Ok(CanonicalEnumBuiltinManifestV1(sites: sites, cfg_uses: uses,
        function_digest: function_digest, module_digest: module_digest,
        digest: sha256_text(rows.join("\n"))))

