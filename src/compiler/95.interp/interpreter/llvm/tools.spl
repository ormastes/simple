# LLVM Tool Invocations
#
# Shared LLVM tool discovery and invocation functions.
# Used by both Full Simple and Core Simple LLVM backends.
#
# Bootstrap-compatible subset: no generics and no Option types in shared bootstrap-sensitive code.
# Portable: uses `where` on Windows, `command -v` on Unix.

use compiler.backend.io_compat.{backend_shell_tuple, backend_tool_on_path}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete, file_read_bytes, file_exists}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.process_ops.{process_run}
use std.io_runtime.{host_os}
use std.nogc_sync_mut.io.native_tool_authority_v1.{
    native_tool_strict_requested_v1, native_tool_strict_resolve_v1}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}

extern fn rt_env_get(key: text) -> text?  # nil when unset; callers here use `?? ""` because unset == empty is the intended semantics
@unsafe(reason: "process-lifetime tool cache spinlock handle ABI", capabilities: [ffi])
extern fn rt_atomic_int_new(initial: i64) -> i64
@unsafe(reason: "process-lifetime tool cache spinlock state query ABI", capabilities: [ffi])
extern fn rt_atomic_int_load(handle: i64) -> i64
@unsafe(reason: "process-lifetime tool cache spinlock CAS ABI", capabilities: [ffi])
extern fn rt_atomic_int_compare_exchange(handle: i64, current: i64, new_value: i64) -> bool

# ============================================================================
# Portable Tool Finder (shared helper)
# ============================================================================

# Homebrew installs LLVM keg-only (not linked onto PATH) so `command -v` never
# finds it there. These absolute prefixes are checked as a last resort after
# the PATH probe fails. They are no-ops on non-macOS hosts since the paths
# simply don't exist.
fn _macos_homebrew_llvm_prefixes() -> [text]:
    [
        "/opt/homebrew/opt/llvm",
        "/opt/homebrew/opt/llvm@25", "/opt/homebrew/opt/llvm@24", "/opt/homebrew/opt/llvm@23",
        "/opt/homebrew/opt/llvm@22", "/opt/homebrew/opt/llvm@21", "/opt/homebrew/opt/llvm@20",
        "/opt/homebrew/opt/llvm@19", "/opt/homebrew/opt/llvm@18", "/opt/homebrew/opt/llvm@17",
        "/opt/homebrew/opt/llvm@16", "/opt/homebrew/opt/llvm@15", "/opt/homebrew/opt/llvm@14",
        "/usr/local/opt/llvm",
        "/usr/local/opt/llvm@25", "/usr/local/opt/llvm@24", "/usr/local/opt/llvm@23",
        "/usr/local/opt/llvm@22", "/usr/local/opt/llvm@21", "/usr/local/opt/llvm@20",
        "/usr/local/opt/llvm@19", "/usr/local/opt/llvm@18", "/usr/local/opt/llvm@17",
        "/usr/local/opt/llvm@16",
    ]

pub fn tool_probe_locations(base_name: text) -> [text]:
    """Absolute paths that _find_tool checks for `base_name` beyond PATH."""
    var out: [text] = []
    for prefix in _macos_homebrew_llvm_prefixes():
        out.push("{prefix}/bin/{base_name}")
    out

fn _tool_runs(cmd: text) -> bool:
    """Execute the candidate and require exit 0 from `--version`.

    Existence on PATH is NOT proof a tool can run: on MSYS2 Windows the
    mingw64 `llc.exe` exists and is found by `where`, but exits 127 with
    "error while loading shared libraries" the moment it is executed
    (2026-08-31). Any probe here must run the binary, never just stat it.
    Uses process_run directly (no shell) to avoid cmd.exe quoting issues.
    """
    val (out, err, code) = process_run(cmd, ["--version"])
    code == 0

fn _tool_path_is_absolute(path: text) -> bool:
    """POSIX `/...`, Windows `C:\\...` / `C:/...` or a UNC `\\\\host\\...` path."""
    if path.starts_with("/") or path.starts_with("\\\\"):
        return true
    path.len() >= 3 and path.char_at(1) == ":" and (path.char_at(2) == "\\" or path.char_at(2) == "/")

pub fn env_tool_dirs_from(explicit_bin: text, llvm_sys_231: text, win_root_23: text, llvm_sys_180: text, llvm_mingw_root: text) -> [text]:
    """Pure builder for explicit LLVM bin dirs from env var values."""
    var dirs: [text] = []
    if explicit_bin != "":
        dirs.push(explicit_bin)
    for prefix in [llvm_sys_231, win_root_23, llvm_sys_180, llvm_mingw_root]:
        if prefix != "":
            dirs.push(prefix + "/bin")
    dirs

fn _env_tool_dirs() -> [text]:
    """Explicit LLVM bin dirs from the environment, highest priority.

    SIMPLE_LLVM_BIN points at a bin directory; LLVM_SYS_231_PREFIX,
    SIMPLE_LLVM_WIN_ROOT_23, LLVM_SYS_180_PREFIX (the var the Windows MSVC
    bootstrap lane sets for LLVM 18), and SIMPLE_LLVM_MINGW_ROOT point at
    install prefixes whose bin/ is used.
    All unset => empty list => no behavior change (Unix no-op).
    """
    env_tool_dirs_from(
        rt_env_get("SIMPLE_LLVM_BIN") ?? "",
        rt_env_get("LLVM_SYS_231_PREFIX") ?? "",
        rt_env_get("SIMPLE_LLVM_WIN_ROOT_23") ?? "",
        rt_env_get("LLVM_SYS_180_PREFIX") ?? "",
        rt_env_get("SIMPLE_LLVM_MINGW_ROOT") ?? ""
    )

pub fn env_tool_dirs() -> [text]:
    """Return explicit LLVM bin directories configured in the environment."""
    _env_tool_dirs()

# Per-process resolution cache for _find_tool, keyed by the joined candidate
# list. find_llc/find_clang run once per AOT unit; re-spawning `where` and
# `--version` for every unit failed transiently in a long stage3 build
# ("llc not found" for 51 units across 7 batches with llc on PATH, and 1427
# occurrences when transient --version spawn failures poisoned the cache).
# Hits are cached for the process lifetime. A miss where NO candidate exists on
# disk is retried up to _FIND_TOOL_MAX_MISSES (3) times, then cached as "".
# A transient `--version` probe failure on an existing candidate on disk does
# NOT advance absent misses and retries up to _FIND_TOOL_MAX_TRANSIENT_MISSES (16)
# times so a transient spike recovers while a permanently broken binary stops
# re-spawning `where` + `--version` across thousands of modules.
# Cache/diagnostic globals are NEVER mutated while inside an active
# transient_scope (transient_array_scope_state_v1() != 0), preventing
# scope-owned strings/arrays from dangling after transient_scope_end().
# find_tool_cache_check() is strictly read-only so parallel worker hits never
# race on _last_tool_probe_diagnostic.
fn _find_tool_cache_lock_init() -> i64:
    var handle: i64 = 0
    unsafe(capabilities: [ffi]):
        handle = rt_atomic_int_new(0)
    handle

val _FIND_TOOL_MAX_MISSES = 3
val _FIND_TOOL_MAX_TRANSIENT_MISSES = 16
var _find_tool_cache_lock_handle: i64 = _find_tool_cache_lock_init()
var _find_tool_cache_keys: [text] = []
var _find_tool_cache_paths: [text] = []
var _find_tool_cache_misses: [i64] = []
var _find_tool_cache_transient_misses: [i64] = []
var _find_tool_cache_diagnostics: [text] = []
var _last_tool_probe_diagnostic: text = ""

fn _find_tool_cache_lock_acquire() -> bool:
    if _find_tool_cache_lock_handle <= 0:
        return false
    while true:
        val acquired = unsafe(capabilities: [ffi]):
            rt_atomic_int_compare_exchange(_find_tool_cache_lock_handle, 0, 1)
        if acquired:
            return true
    false

fn _find_tool_cache_lock_release(held: bool):
    if held and _find_tool_cache_lock_handle > 0:
        val _ = unsafe(capabilities: [ffi]):
            rt_atomic_int_compare_exchange(_find_tool_cache_lock_handle, 1, 0)

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn find_tool_cache_lock_is_free() -> bool:
    """Return true when the cache spinlock handle is initialized (> 0) and unlocked (0)."""
    if _find_tool_cache_lock_handle <= 0:
        return false
    val state = unsafe(capabilities: [ffi]):
        rt_atomic_int_load(_find_tool_cache_lock_handle)
    state == 0

pub struct ToolProbeObservation:
    path: text
    exists_on_disk: bool
    probe_ok: bool

pub struct ToolProbeOutcome:
    found_path: text
    failed_candidates: [text]
    had_existing_candidate: bool

pub struct ToolCacheDecision:
    cached_path: text
    absent_misses: i64
    transient_misses: i64
    should_retry: bool
    diagnostic: text

pub struct ToolCacheLookup:
    hit: bool
    path: text
    diagnostic: text

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn find_tool_max_misses() -> i64:
    """Maximum consecutive absent-binary misses before caching empty string."""
    _FIND_TOOL_MAX_MISSES

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn find_tool_max_transient_misses() -> i64:
    """Maximum consecutive transient --version failures on an existing binary before caching broken."""
    _FIND_TOOL_MAX_TRANSIENT_MISSES

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn tool_cache_can_persist() -> bool:
    """Return true only when outside an active transient scope (safe to write process globals)."""
    transient_array_scope_state_v1() == 0

pub fn last_tool_probe_diagnostic() -> text:
    """Diagnostic from the most recent persisted tool discovery probe (empty on success)."""
    val held = _find_tool_cache_lock_acquire()
    val diag = _last_tool_probe_diagnostic
    _find_tool_cache_lock_release(held)
    diag

pub fn reset_find_tool_cache():
    """Clear the per-process tool discovery cache and last diagnostic (for tests)."""
    val held = _find_tool_cache_lock_acquire()
    _find_tool_cache_keys = []
    _find_tool_cache_paths = []
    _find_tool_cache_misses = []
    _find_tool_cache_transient_misses = []
    _find_tool_cache_diagnostics = []
    _last_tool_probe_diagnostic = ""
    _find_tool_cache_lock_release(held)

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn tool_cache_should_reuse_counts(cached_path: text, absent_misses: i64, transient_misses: i64) -> bool:
    """Return true when cache holds a working hit or reached either miss limit."""
    cached_path != "" or absent_misses >= _FIND_TOOL_MAX_MISSES or transient_misses >= _FIND_TOOL_MAX_TRANSIENT_MISSES

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn tool_cache_should_reuse(cached_path: text, absent_misses: i64) -> bool:
    """Return true when cache holds a working hit or reached the absent-tool miss limit."""
    tool_cache_should_reuse_counts(cached_path, absent_misses, 0)

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn format_tool_probe_diagnostic_with_cap(candidates_key: text, found_path: text, failed_candidates: [text], cached_absent: bool, cached_broken: bool) -> text:
    """Format diagnostic distinguishing transient --version failure, repeated broken binary, and absent binary."""
    if found_path != "":
        return ""
    if failed_candidates.len() > 0:
        val joined = failed_candidates.join(", ")
        if cached_broken:
            return "tool probe failed repeatedly (cached broken after {_FIND_TOOL_MAX_TRANSIENT_MISSES} --version failures) for existing candidate(s): {joined} (candidates: {candidates_key})"
        return "tool probe failed transiently (--version failed) for existing candidate(s): {joined} (candidates: {candidates_key})"
    if cached_absent:
        return "tool missing (cached absent after {_FIND_TOOL_MAX_MISSES} misses; no candidate file exists on disk) for candidates: {candidates_key}"
    "tool missing (no candidate file exists on disk) for candidates: {candidates_key}"

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn format_tool_probe_diagnostic(candidates_key: text, found_path: text, failed_candidates: [text], cached_absent: bool) -> text:
    """Format diagnostic distinguishing transient --version failure from absent binary."""
    format_tool_probe_diagnostic_with_cap(candidates_key, found_path, failed_candidates, cached_absent, false)

fn _contains_text(items: [text], target: text) -> bool:
    for item in items:
        if item == target:
            return true
    false

fn _append_unique_text(items: [text], value: text) -> [text]:
    if value == "" or _contains_text(items, value):
        return items
    var out: [text] = []
    for item in items:
        out.push(item)
    out.push(value)
    out

pub fn tool_probe_evaluate_observations(observations: [ToolProbeObservation]) -> ToolProbeOutcome:
    """Pure classification separating absent tools from existing candidates whose --version failed."""
    var failed: [text] = []
    for obs in observations:
        if obs.path != "" and obs.exists_on_disk:
            if obs.probe_ok:
                return ToolProbeOutcome(
                    found_path: obs.path,
                    failed_candidates: [],
                    had_existing_candidate: true
                )
            failed = _append_unique_text(failed, obs.path)
    ToolProbeOutcome(
        found_path: "",
        failed_candidates: failed,
        had_existing_candidate: failed.len() > 0
    )

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn tool_probe_decide_counts(candidates_key: text, prev_absent_misses: i64, prev_transient_misses: i64, outcome: ToolProbeOutcome) -> ToolCacheDecision:
    """Pure state transition deciding cache path, absent/transient miss counts, retry, and diagnostic."""
    if outcome.found_path != "":
        return ToolCacheDecision(
            cached_path: outcome.found_path,
            absent_misses: 0,
            transient_misses: 0,
            should_retry: false,
            diagnostic: ""
        )
    if outcome.had_existing_candidate or outcome.failed_candidates.len() > 0:
        val next_transient = prev_transient_misses + 1
        val can_retry = next_transient < _FIND_TOOL_MAX_TRANSIENT_MISSES
        val diag = format_tool_probe_diagnostic_with_cap(candidates_key, "", outcome.failed_candidates, false, not can_retry)
        return ToolCacheDecision(
            cached_path: "",
            absent_misses: 0,
            transient_misses: next_transient,
            should_retry: can_retry,
            diagnostic: diag
        )
    val next_misses = prev_absent_misses + 1
    val can_retry = next_misses < _FIND_TOOL_MAX_MISSES
    val diag = format_tool_probe_diagnostic_with_cap(candidates_key, "", [], not can_retry, false)
    ToolCacheDecision(
        cached_path: "",
        absent_misses: next_misses,
        transient_misses: prev_transient_misses,
        should_retry: can_retry,
        diagnostic: diag
    )

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn tool_probe_decide(candidates_key: text, prev_absent_misses: i64, outcome: ToolProbeOutcome) -> ToolCacheDecision:
    """Pure state transition from a discovery outcome (starting at zero transient misses)."""
    tool_probe_decide_counts(candidates_key, prev_absent_misses, 0, outcome)

fn _find_tool_cache_index(key: text) -> i64:
    var idx = -1
    var i = 0
    while i < _find_tool_cache_keys.len():
        if _find_tool_cache_keys[i] == key:
            idx = i
        i = i + 1
    idx

fn _find_tool_cache_check_unlocked(key: text) -> ToolCacheLookup:
    val idx = _find_tool_cache_index(key)
    if idx < 0:
        return ToolCacheLookup(hit: false, path: "", diagnostic: "")
    val cached_path = _find_tool_cache_paths[idx]
    val absent_misses = _find_tool_cache_misses[idx]
    val transient_misses = _find_tool_cache_transient_misses[idx]
    if tool_cache_should_reuse_counts(cached_path, absent_misses, transient_misses):
        return ToolCacheLookup(
            hit: true,
            path: cached_path,
            diagnostic: _find_tool_cache_diagnostics[idx]
        )
    ToolCacheLookup(hit: false, path: "", diagnostic: "")

fn _find_tool_cache_record_unlocked(key: text, outcome: ToolProbeOutcome) -> text:
    val idx = _find_tool_cache_index(key)
    val prev_misses = if idx < 0: 0 else: _find_tool_cache_misses[idx]
    val prev_transient = if idx < 0: 0 else: _find_tool_cache_transient_misses[idx]
    val decision = tool_probe_decide_counts(key, prev_misses, prev_transient, outcome)
    if idx < 0:
        _find_tool_cache_keys.push(key)
        _find_tool_cache_paths.push(decision.cached_path)
        _find_tool_cache_misses.push(decision.absent_misses)
        _find_tool_cache_transient_misses.push(decision.transient_misses)
        _find_tool_cache_diagnostics.push(decision.diagnostic)
    else:
        _find_tool_cache_paths[idx] = decision.cached_path
        _find_tool_cache_misses[idx] = decision.absent_misses
        _find_tool_cache_transient_misses[idx] = decision.transient_misses
        _find_tool_cache_diagnostics[idx] = decision.diagnostic
    _last_tool_probe_diagnostic = decision.diagnostic
    decision.cached_path

fn _clear_last_tool_probe_diagnostic_if_needed():
    if not tool_cache_can_persist():
        return
    val held = _find_tool_cache_lock_acquire()
    if _last_tool_probe_diagnostic != "":
        _last_tool_probe_diagnostic = ""
    _find_tool_cache_lock_release(held)

fn _set_last_tool_probe_diagnostic(msg: text):
    if not tool_cache_can_persist():
        return
    val held = _find_tool_cache_lock_acquire()
    _last_tool_probe_diagnostic = msg
    _find_tool_cache_lock_release(held)

pub fn find_tool_cache_check(key: text) -> ToolCacheLookup:
    """Locked read-only lookup of the per-process cache (safe on concurrent workers and in transient scopes)."""
    val held = _find_tool_cache_lock_acquire()
    val lookup = _find_tool_cache_check_unlocked(key)
    _find_tool_cache_lock_release(held)
    lookup

# reason: internal LLVM tool-probe cache helper exported for unit specs
@allow(primitive_api)
pub fn find_tool_cache_record_with_persist(key: text, outcome: ToolProbeOutcome, allow_persist: bool) -> text:
    """Update per-process cache and diagnostic state when `allow_persist` is true.

    When inside an active transient scope (`allow_persist == false`), return
    `outcome.found_path` directly without storing scope-owned strings or array
    buffers in process-lifetime globals.
    """
    if not allow_persist:
        return outcome.found_path
    val held = _find_tool_cache_lock_acquire()
    val res = _find_tool_cache_record_unlocked(key, outcome)
    _find_tool_cache_lock_release(held)
    res

pub fn find_tool_cache_record(key: text, outcome: ToolProbeOutcome) -> text:
    """Update the per-process cache and diagnostic state when outside a transient scope."""
    find_tool_cache_record_with_persist(key, outcome, tool_cache_can_persist())

pub fn find_tool_cache_commit_probe(key: text, outcome: ToolProbeOutcome) -> text:
    """Commit a probe outcome under the cache spinlock with double-check against concurrent winners."""
    if not tool_cache_can_persist():
        return outcome.found_path
    val held = _find_tool_cache_lock_acquire()
    val recheck = _find_tool_cache_check_unlocked(key)
    if recheck.hit and (recheck.path != "" or outcome.found_path == ""):
        _find_tool_cache_lock_release(held)
        return recheck.path
    val res = _find_tool_cache_record_unlocked(key, outcome)
    _find_tool_cache_lock_release(held)
    res

fn _find_tool(candidates: [text]) -> text:
    """Find a WORKING tool using platform-appropriate detection.

    Priority: env-provided LLVM bin dirs (SIMPLE_LLVM_BIN,
    LLVM_SYS_231_PREFIX/bin, SIMPLE_LLVM_WIN_ROOT_23/bin,
    LLVM_SYS_180_PREFIX/bin, SIMPLE_LLVM_MINGW_ROOT/bin) -> /usr/bin ->
    in-process PATH scan -> `where` (Windows, every listed path tried in
    order) -> Homebrew keg-only prefixes (macOS). Every hit is verified by
    EXECUTING the candidate (`--version`, exit 0) before it is returned — a
    bare existence probe selected a DLL-broken mingw64 llc on Windows and
    produced "Bootstrap LLVM llc failed" far downstream.
    Bootstrap-safe.
    """
    if native_tool_strict_requested_v1():
        if candidates.len() == 0:
            _set_last_tool_probe_diagnostic("strict tool resolution failed: empty candidates")
            return ""
        val name = candidates[candidates.len() - 1]
        val role = if name == "clang": "cc" else: name
        # Missing, changed or unadmitted tools never fall through to discovery.
        match native_tool_strict_resolve_v1(role):
            Ok(path):
                _clear_last_tool_probe_diagnostic_if_needed()
                return path
            Err(_):
                _set_last_tool_probe_diagnostic("strict tool resolution failed for role: {role}")
                return ""
    val key = candidates.join(",")
    val lookup = find_tool_cache_check(key)
    if lookup.hit:
        return lookup.path
    val outcome = _find_tool_discover_outcome(candidates)
    find_tool_cache_commit_probe(key, outcome)

pub fn find_tool_for_candidates(candidates: [text]) -> text:
    """Public entrypoint to resolve a tool candidate list through _find_tool."""
    _find_tool(candidates)

fn _probe_candidate_paths(paths: [text], require_file_exists: bool, prev_failed: [text]) -> ToolProbeOutcome:
    var failed = prev_failed
    for path in paths:
        if path != "":
            val exists = if require_file_exists: file_exists(path) else: (file_exists(path) or _tool_path_is_absolute(path))
            if exists:
                if _tool_runs(path):
                    return ToolProbeOutcome(
                        found_path: path,
                        failed_candidates: [],
                        had_existing_candidate: true
                    )
                failed = _append_unique_text(failed, path)
    ToolProbeOutcome(
        found_path: "",
        failed_candidates: failed,
        had_existing_candidate: failed.len() > 0
    )

fn _find_tool_discover_outcome(candidates: [text]) -> ToolProbeOutcome:
    """Uncached discovery body returning hit path or failed existing candidate(s)."""
    var failed: [text] = []
    # Env-provided dirs first (see _env_tool_dirs docstring). With
    # SIMPLE_LLVM_BIN or SIMPLE_LLVM_MINGW_ROOT set and the tool present there,
    # no `where`/`command -v` process is ever spawned.
    var env_paths: [text] = []
    for dir in _env_tool_dirs():
        for candidate in candidates:
            env_paths.push(dir + "/" + candidate)
            env_paths.push(dir + "/" + candidate + ".exe")
    val env_res = _probe_candidate_paths(env_paths, true, failed)
    if env_res.found_path != "":
        return env_res
    failed = env_res.failed_candidates

    val on_windows = host_os() == "windows"
    for candidate in candidates:
        # /usr/bin and the POSIX `command -v` probe are meaningless under
        # cmd.exe; on Windows only `where` below applies.
        # PATH hit resolved in process to the file it names. This used to ask
        # `command -v` and return the BARE name, but callers spawn the result
        # with process_run, which does not search PATH: every AOT unit then
        # failed "llc failed (exit -1)" with llc on PATH and SIMPLE_LLVM_BIN
        # unset (bug stage2_llc_discovery_ignores_path_2026-10-31).
        # backend_tool_on_path follows the host rules (`:` on POSIX; `;`,
        # the working directory and PATHEXT on Windows). Only an absolute hit
        # is returned; a relative PATH entry falls through to `where`.
        var step_paths: [text] = []
        if not on_windows:
            val usr_path = "/usr/bin/{candidate}"
            if file_exists(usr_path):
                step_paths.push(usr_path)
        val on_path = backend_tool_on_path([candidate])
        if _tool_path_is_absolute(on_path):
            step_paths.push(on_path)
        val step_res = _probe_candidate_paths(step_paths, false, failed)
        if step_res.found_path != "":
            return step_res
        failed = step_res.failed_candidates

        # Windows fallback: `where` can list several installs and the FIRST
        # can be broken (mingw64 llc missing its own DLLs) while a later one
        # works (e.g. an LLVM MSVC release install). Try each resolved path
        # and return the first that actually executes. Note: paths with
        # spaces (e.g. C:\Program Files\LLVM) would need quoting at the
        # invocation sites that build shell strings from this result.
        val (wout, werr, wcode) = backend_shell_tuple("where {candidate}")
        if wcode == 0:
            var where_paths: [text] = []
            for line in wout.split("\n"):
                # `where` output is CRLF-terminated; strip \r explicitly.
                val p = line.replace("\r", "").trim()
                if p != "":
                    where_paths.push(p)
            val where_res = _probe_candidate_paths(where_paths, false, failed)
            if where_res.found_path != "":
                return where_res
            failed = where_res.failed_candidates

    # Homebrew keg-only fallback (macOS): probe absolute prefixes for the
    # unversioned tool name (last candidate in the fallback chain).
    if candidates.len() > 0:
        val base_name = candidates[candidates.len() - 1]
        val brew_res = _probe_candidate_paths(tool_probe_locations(base_name), true, failed)
        if brew_res.found_path != "":
            return brew_res
        failed = brew_res.failed_candidates

    ToolProbeOutcome(
        found_path: "",
        failed_candidates: failed,
        had_existing_candidate: failed.len() > 0
    )

fn _find_tool_discover(candidates: [text]) -> text:
    """Uncached discovery body of _find_tool (non-strict path only)."""
    _find_tool_discover_outcome(candidates).found_path

# ============================================================================
# LLVM Tool Discovery
# ============================================================================

fn find_llc() -> text:
    """
    Find llc binary with fallback chain: llc-19 → llc-18 → llc-17 → llc-16 → llc.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["llc-20", "llc-19", "llc-18", "llc-17", "llc-16", "llc"])

pub fn find_llvm_as() -> text:
    """Find the LLVM textual-IR assembler for replayable bitcode debugging."""
    _find_tool(["llvm-as-20", "llvm-as-19", "llvm-as-18", "llvm-as-17", "llvm-as-16", "llvm-as"])

pub fn find_opt() -> text:
    """
    Find LLVM opt binary with fallback chain: opt-19 → opt-18 → opt-17 → opt-16 → opt.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["opt-20", "opt-19", "opt-18", "opt-17", "opt-16", "opt"])

fn find_clang() -> text:
    """
    Find clang binary with fallback chain: clang-23 → ... → clang-16 → clang.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["clang-23", "clang-22", "clang-21", "clang-20", "clang-19", "clang-18", "clang-17", "clang-16", "clang"])

# ============================================================================
# WASM Tool Discovery
# ============================================================================

pub fn find_wasm_ld() -> text:
    """
    Find wasm-ld binary with fallback chain: wasm-ld-19 -> wasm-ld-18 -> wasm-ld-17 -> wasm-ld-16 -> wasm-ld.

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wasm-ld-19", "wasm-ld-18", "wasm-ld-17", "wasm-ld-16", "wasm-ld"])

pub fn find_wasm_opt() -> text:
    """
    Find wasm-opt binary (from Binaryen).

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wasm-opt"])

fn find_wat2wasm() -> text:
    """
    Find wat2wasm binary (from WABT).

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wat2wasm"])

pub fn find_wasi_sysroot() -> text:
    """
    Find WASI sysroot directory.

    Checks WASI_SYSROOT env var, then probes common locations.
    Returns the path if found, otherwise empty string.
    """
    # Check env var first
    val (env_out, env_err, env_code) = backend_shell_tuple("echo $WASI_SYSROOT")
    if env_code == 0:
        val env_path = env_out.trim()
        if env_path != "":
            val (chk_out, chk_err, chk_code) = backend_shell_tuple("test -d '{env_path}' && echo ok")
            if chk_code == 0:
                return env_path

    # Probe common locations (Unix)
    val probe_paths = [
        "/opt/wasi-sdk/share/wasi-sysroot",
        "/usr/share/wasi-sysroot",
        "/usr/local/share/wasi-sysroot",
        "/opt/wasi-sysroot"
    ]
    for probe in probe_paths:
        val (p_out, p_err, p_code) = backend_shell_tuple("test -d '{probe}' && echo ok")
        if p_code == 0:
            return probe

    # Windows: check WASI_SDK_PATH
    val (ws_out, ws_err, ws_code) = backend_shell_tuple("echo %WASI_SDK_PATH%")
    if ws_code == 0:
        val ws_path = ws_out.trim()
        if ws_path != "" and ws_path != "%WASI_SDK_PATH%":
            return "{ws_path}/share/wasi-sysroot"
    ""

# ============================================================================
# WASM Tool Availability Checks
# ============================================================================

fn wasm_ld_available() -> bool:
    """Check if wasm-ld is available on PATH."""
    val tool = find_wasm_ld()
    tool != ""

fn wasm_opt_available() -> bool:
    """Check if wasm-opt (Binaryen optimizer) is available on PATH."""
    val tool = find_wasm_opt()
    tool != ""

fn wat2wasm_available() -> bool:
    """Check if wat2wasm (WABT) is available on PATH."""
    val tool = find_wat2wasm()
    tool != ""

# ============================================================================
# Tool Availability Checks
# ============================================================================

fn opt_available() -> bool:
    """Check if opt (LLVM optimizer) is available on PATH."""
    val tool = find_opt()
    tool != ""

pub fn llc_available() -> bool:
    """Check if llc (LLVM static compiler) is available on PATH."""
    val tool = find_llc()
    tool != ""

fn llvm_as_available() -> bool:
    """Check if llvm-as (textual IR to bitcode) is available on PATH."""
    val tool = find_llvm_as()
    tool != ""

fn clang_available() -> bool:
    """Check if clang (C compiler with LLVM backend) is available on PATH."""
    val tool = find_clang()
    tool != ""

