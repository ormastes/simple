# LLVM Tool Invocations
#
# Shared LLVM tool discovery and invocation functions.
# Used by both Full Simple and Core Simple LLVM backends.
#
# Bootstrap-compatible subset: no generics and no Option types in shared bootstrap-sensitive code.
# Portable: uses `where` on Windows, `command -v` on Unix.

use compiler.backend.backend.io_compat.{backend_shell_tuple}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete, file_read_bytes, file_exists}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}

# ============================================================================
# Portable Tool Finder (shared helper)
# ============================================================================

# Homebrew installs LLVM keg-only (not linked onto PATH) so `command -v` never
# finds it there. These absolute prefixes are checked as a last resort after
# the PATH probe fails. They are no-ops on non-macOS hosts since the paths
# simply don't exist.
fn _macos_homebrew_llvm_prefixes() -> [text]:
    [
        "/opt/homebrew/opt/llvm@23",
        "/usr/local/opt/llvm@23",
    ]

pub fn tool_probe_locations(base_name: text) -> [text]:
    """Absolute paths that _find_tool checks for `base_name` beyond PATH."""
    var out: [text] = []
    for prefix in _macos_homebrew_llvm_prefixes():
        out.push("{prefix}/bin/{base_name}")
    out

fn _find_tool(candidates: [text]) -> text:
    """Find a tool using platform-appropriate detection.

    On Unix: `command -v`
    On Windows: `where`
    Falls back to known Homebrew keg-only install locations on macOS.
    Bootstrap-safe.
    """
    # Official LLVM 23.1 archives install unversioned tools under the
    # explicitly configured dedicated prefix. Keep this probe ahead of PATH.
    val configured_prefix = env_get("SIMPLE_LLVM_PREFIX") ?? ""
    if configured_prefix != "" and candidates.len() > 0:
        val configured = "{configured_prefix}/bin/{candidates[candidates.len() - 1]}"
        if file_exists(configured):
            return configured

    # Detect Windows by trying `where` first on failure of `command -v`
    for candidate in candidates:
        if file_exists("/usr/bin/{candidate}"):
            return "/usr/bin/{candidate}"
        val (out, err, code) = backend_shell_tuple("command -v {candidate} >/dev/null 2>&1")
        if code == 0:
            return candidate
        # Windows fallback
        val (wout, werr, wcode) = backend_shell_tuple("where {candidate} 2>NUL")
        if wcode == 0 and wout.trim() != "":
            return candidate
    # Homebrew keg-only fallback (macOS): probe absolute prefixes for the
    # unversioned tool name (last candidate in the fallback chain).
    if candidates.len() > 0:
        val base_name = candidates[candidates.len() - 1]
        for path in tool_probe_locations(base_name):
            if file_exists(path):
                return path
    ""

# ============================================================================
# LLVM Tool Discovery
# ============================================================================

fn find_llc() -> text:
    """
    Find the LLVM 23-series llc binary, with unversioned-prefix fallback.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["llc-23", "llc"])

fn find_opt() -> text:
    """
    Find the LLVM 23-series opt binary, with unversioned-prefix fallback.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["opt-23", "opt"])

fn find_clang() -> text:
    """
    Find the Clang 23-series binary, with unversioned-prefix fallback.

    Returns the command name if found, otherwise empty string.
    Bootstrap-safe: Returns text (not text?) with "" for not found.
    """
    _find_tool(["clang-23", "clang"])

# ============================================================================
# WASM Tool Discovery
# ============================================================================

fn find_wasm_ld() -> text:
    """
    Find the LLD 23-series wasm linker, with unversioned-prefix fallback.

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wasm-ld-23", "wasm-ld"])

fn find_wasm_opt() -> text:
    """
    Find wasm-opt binary (from Binaryen).

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wasm-opt"])

fn find_wat2wasm() -> text:
    """
    Find wat2wasm binary (from WABT).

    Returns the command name if found, otherwise empty string.
    """
    _find_tool(["wat2wasm"])

fn find_wasi_sysroot() -> text:
    """
    Find WASI sysroot directory.

    Checks WASI_SYSROOT env var, then probes common locations.
    Returns the path if found, otherwise empty string.
    """
    # Check env var first
    val (env_out, env_err, env_code) = backend_shell_tuple("echo $WASI_SYSROOT")
    if env_code == 0:
        val env_path = env_out.trim()
        if env_path != "":
            val (chk_out, chk_err, chk_code) = backend_shell_tuple("test -d '{env_path}' && echo ok")
            if chk_code == 0:
                return env_path

    # Probe common locations (Unix)
    val probe_paths = [
        "/opt/wasi-sdk/share/wasi-sysroot",
        "/usr/share/wasi-sysroot",
        "/usr/local/share/wasi-sysroot",
        "/opt/wasi-sysroot"
    ]
    for probe in probe_paths:
        val (p_out, p_err, p_code) = backend_shell_tuple("test -d '{probe}' && echo ok")
        if p_code == 0:
            return probe

    # Windows: check WASI_SDK_PATH
    val (ws_out, ws_err, ws_code) = backend_shell_tuple("echo %WASI_SDK_PATH% 2>NUL")
    if ws_code == 0:
        val ws_path = ws_out.trim()
        if ws_path != "" and ws_path != "%WASI_SDK_PATH%":
            return "{ws_path}/share/wasi-sysroot"
    ""

# ============================================================================
# WASM Tool Availability Checks
# ============================================================================

fn wasm_ld_available() -> bool:
    """Check if wasm-ld is available on PATH."""
    val tool = find_wasm_ld()
    tool != ""

fn wasm_opt_available() -> bool:
    """Check if wasm-opt (Binaryen optimizer) is available on PATH."""
    val tool = find_wasm_opt()
    tool != ""

fn wat2wasm_available() -> bool:
    """Check if wat2wasm (WABT) is available on PATH."""
    val tool = find_wat2wasm()
    tool != ""

# ============================================================================
# Tool Availability Checks
# ============================================================================

fn opt_available() -> bool:
    """Check if opt (LLVM optimizer) is available on PATH."""
    val tool = find_opt()
    tool != ""

fn llc_available() -> bool:
    """Check if llc (LLVM static compiler) is available on PATH."""
    val tool = find_llc()
    tool != ""

fn clang_available() -> bool:
    """Check if clang (C compiler with LLVM backend) is available on PATH."""
    val tool = find_clang()
    tool != ""

# ============================================================================
# Exports
# ============================================================================
