# Tiered JIT hotspot policy — Java-style adaptive planning in pure Simple
#
# Tier 0: Interpreted (default)
# Tier 1: Cranelift-compiled (fast compile, moderate runtime perf)
# Tier 2: LLVM-compiled (slow compile, fully optimized runtime)
#
# Policy, profiling, and tier decisions live here in Simple. Native execution
# is isolated in tiered_jit_manager.spl.

use compiler.mir_opt.pattern.rules_clib_parity.{CLibParityRule, clib_parity_rule_table}
use compiler.mir_opt.pattern.rule_engine.{get_eligible_rules_for_function}
use compiler.mir_opt.mod.{
    OptLevel, optlevel_name,
    MirPassBackendDecision,
    optimizationpipeline_backend_plan_for_budget
}
use compiler.mir_opt.general_patterns.{
    BackendOptimizationDecision,
    backend_optimization_plan_for_budget_with_facts
}

# ============================================================================
# Configuration
# ============================================================================

struct TieredJitConfig:
    tier1_threshold: i64
    tier2_threshold: i64
    debug_mode: bool

# ============================================================================
# Tier State
# ============================================================================

enum JitTier:
    Interpreted
    Fast
    Optimized

struct FunctionProfile:
    name: text
    call_count: i64
    tier: JitTier
    compile_time_ms: f64
    source: text
    typed_mir: bool
    safe_deopt: bool
    hotspot_specialized_source: text
    hotspot_semantic_proof: bool
    var_facts: JitVarOptimizationFacts

struct TieredJitStats:
    tier1_compilations: i64
    tier2_compilations: i64
    total_compile_time_ms: f64
    hotspot_plans: i64

struct JitHotspotPlan:
    function_name: text
    call_count: i64
    threshold: i64
    eligible: bool
    invalidated: bool
    reason: text
    facts: [text]

struct JitHotspotCompileDecision:
    plan: JitHotspotPlan
    compile_source: text
    provider_used: bool
    reason: text

struct JitHotspotRebuildPlan:
    function_name: text
    backend: text
    eligible: bool
    reason: text
    cost_class: text
    required_count: i64

struct JitHotspotRebuildChoice:
    function_name: text
    selected_backend: text
    eligible: bool
    reason: text
    cost_class: text
    required_count: i64
    attempted_backends: [text]

struct JitHotspotOptimizationPlan:
    function_name: text
    backend: text
    eligible: bool
    reason: text
    cost_class: text
    max_cost_class: text
    opt_level: text
    passes: [text]
    skipped_passes: [MirPassBackendDecision]
    plugin_recommendations: [text]
    skipped_plugin_recommendations: [BackendOptimizationDecision]

struct JitHotspotSpecializationProvider:
    name: text
    enabled: bool
    specialized_source: text
    semantic_proof: bool
    eligible_rules: [CLibParityRule]

struct JitVarOptimizationFacts:
    has_var_reassignment: bool
    reassignment_count: i64
    ssa_transform: bool
    escape_analyzed: bool
    no_escape: bool
    borrow_reassign_safe: bool

# ============================================================================
# Hotspot optimization facts
# ============================================================================

fn jit_hotspot_profile_facts(
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool
) -> [text]:
    var facts: [text] = []
    if profile.call_count >= config.tier1_threshold:
        facts = facts.push("profile.hot_count")
    if typed_mir:
        facts = facts.push("typed_mir")
    if safe_deopt:
        facts = facts.push("safe_deopt")
    facts

fn jit_hotspot_plan_reason(
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool
) -> text:
    if profile.source == "":
        return "missing source"
    if profile.call_count < config.tier1_threshold:
        return "missing profile.hot_count"
    if not typed_mir:
        return "missing typed_mir"
    if not safe_deopt:
        return "missing safe_deopt"
    "ready"

fn jit_hotspot_plan_from_profile(
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool
) -> JitHotspotPlan:
    val facts = jit_hotspot_profile_facts(profile, config, typed_mir, safe_deopt)
    val reason = jit_hotspot_plan_reason(profile, config, typed_mir, safe_deopt)
    JitHotspotPlan(
        function_name: profile.name,
        call_count: profile.call_count,
        threshold: config.tier1_threshold,
        eligible: reason == "ready",
        invalidated: false,
        reason: reason,
        facts: facts
    )

fn jit_var_optimization_facts(
    has_var_reassignment: bool,
    reassignment_count: i64,
    ssa_transform: bool,
    escape_analyzed: bool,
    no_escape: bool,
    borrow_reassign_safe: bool
) -> JitVarOptimizationFacts:
    JitVarOptimizationFacts(
        has_var_reassignment: has_var_reassignment,
        reassignment_count: reassignment_count,
        ssa_transform: ssa_transform,
        escape_analyzed: escape_analyzed,
        no_escape: no_escape,
        borrow_reassign_safe: borrow_reassign_safe
    )

fn jit_var_optimization_facts_none() -> JitVarOptimizationFacts:
    jit_var_optimization_facts(false, 0, false, false, true, true)

fn jit_var_optimization_fact_list(var_facts: JitVarOptimizationFacts) -> [text]:
    var facts: [text] = []
    if var_facts.has_var_reassignment and var_facts.reassignment_count > 0:
        facts = facts.push("var.reassignment")
    if var_facts.ssa_transform:
        facts = facts.push("ssa.var_transform")
    if var_facts.escape_analyzed:
        facts = facts.push("escape.analyzed")
    if var_facts.no_escape:
        facts = facts.push("escape.no_escape")
    if var_facts.borrow_reassign_safe:
        facts = facts.push("borrow.reassign_safe")
    facts

fn jit_var_optimization_implies_scalar_cleanup(var_facts: JitVarOptimizationFacts) -> bool:
    var_facts.has_var_reassignment and var_facts.reassignment_count > 0 and var_facts.ssa_transform and var_facts.escape_analyzed and var_facts.no_escape and var_facts.borrow_reassign_safe

fn jit_var_optimization_reason(var_facts: JitVarOptimizationFacts) -> text:
    if not var_facts.has_var_reassignment or var_facts.reassignment_count == 0:
        return "ready"
    if not var_facts.ssa_transform:
        return "missing ssa.var_transform"
    if not var_facts.escape_analyzed:
        return "missing escape.analyzed"
    if not var_facts.no_escape:
        return "missing escape.no_escape"
    if not var_facts.borrow_reassign_safe:
        return "missing borrow.reassign_safe"
    "ready"

fn jit_hotspot_plan_with_var_facts(
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool,
    var_facts: JitVarOptimizationFacts
) -> JitHotspotPlan:
    val base = jit_hotspot_plan_from_profile(profile, config, typed_mir, safe_deopt)
    val var_reason = jit_var_optimization_reason(var_facts)
    var merged_facts = base.facts
    for fact in jit_var_optimization_fact_list(var_facts):
        merged_facts = merged_facts.push(fact)
    if not base.eligible:
        return JitHotspotPlan(
            function_name: base.function_name,
            call_count: base.call_count,
            threshold: base.threshold,
            eligible: false,
            invalidated: base.invalidated,
            reason: base.reason,
            facts: merged_facts
        )
    if var_reason != "ready":
        return JitHotspotPlan(
            function_name: base.function_name,
            call_count: base.call_count,
            threshold: base.threshold,
            eligible: false,
            invalidated: base.invalidated,
            reason: var_reason,
            facts: merged_facts
        )
    JitHotspotPlan(
        function_name: base.function_name,
        call_count: base.call_count,
        threshold: base.threshold,
        eligible: true,
        invalidated: base.invalidated,
        reason: base.reason,
        facts: merged_facts
    )

fn jit_hotspot_plan_from_profile_var_facts(
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool
) -> JitHotspotPlan:
    jit_hotspot_plan_with_var_facts(profile, config, typed_mir, safe_deopt, profile.var_facts)

fn jit_hotspot_rebuild_backend_name(backend: text) -> text:
    if backend == "cranlift":
        "cranelift"
    elif backend == "llvm-lib" or backend == "llvmlib":
        "llvm"
    else:
        backend

fn jit_hotspot_cost_rank(cost_class: text) -> i64:
    match cost_class:
        case "free": 0
        case "low": 1
        case "medium": 2
        case "high": 3
        case _: 99

fn jit_hotspot_cost_allowed(cost_class: text, max_cost_class: text) -> bool:
    jit_hotspot_cost_rank(cost_class) <= jit_hotspot_cost_rank(max_cost_class)

fn jit_hotspot_rebuild_plan(
    profile: FunctionProfile,
    config: TieredJitConfig,
    backend: text,
    backend_available: bool
) -> JitHotspotRebuildPlan:
    val normalized = jit_hotspot_rebuild_backend_name(backend)
    if not backend_available:
        return JitHotspotRebuildPlan(
            function_name: profile.name,
            backend: normalized,
            eligible: false,
            reason: "backend unavailable",
            cost_class: "unavailable",
            required_count: 0
        )
    if normalized == "cranelift":
        val ready = profile.call_count >= config.tier1_threshold
        JitHotspotRebuildPlan(
            function_name: profile.name,
            backend: normalized,
            eligible: ready,
            reason: if ready: "ready" else: "missing tier1 hot_count",
            cost_class: "medium",
            required_count: config.tier1_threshold
        )
    elif normalized == "llvm":
        val ready = profile.call_count >= config.tier2_threshold
        JitHotspotRebuildPlan(
            function_name: profile.name,
            backend: normalized,
            eligible: ready,
            reason: if ready: "ready" else: "missing tier2 hot_count",
            cost_class: "high",
            required_count: config.tier2_threshold
        )
    else:
        JitHotspotRebuildPlan(
            function_name: profile.name,
            backend: normalized,
            eligible: false,
            reason: "unsupported backend",
            cost_class: "unknown",
            required_count: 0
        )

fn jit_hotspot_rebuild_plan_with_cost_budget(
    profile: FunctionProfile,
    config: TieredJitConfig,
    backend: text,
    backend_available: bool,
    max_cost_class: text
) -> JitHotspotRebuildPlan:
    val plan = jit_hotspot_rebuild_plan(profile, config, backend, backend_available)
    if not plan.eligible:
        return plan
    if not jit_hotspot_cost_allowed(plan.cost_class, max_cost_class):
        return JitHotspotRebuildPlan(
            function_name: plan.function_name,
            backend: plan.backend,
            eligible: false,
            reason: "cost budget exceeded",
            cost_class: plan.cost_class,
            required_count: plan.required_count
        )
    plan

fn jit_hotspot_llvm_preference_threshold(config: TieredJitConfig) -> i64:
    config.tier2_threshold * 2

fn jit_hotspot_var_rebuild_reason(profile: FunctionProfile) -> text:
    jit_var_optimization_reason(profile.var_facts)

struct JitHotspotSourceScanCounters:
    source_byte_snapshots: i64
    source_passes: i64
    source_bytes_visited: i64
    needle_attempts: i64
    needle_byte_comparisons: i64

struct JitHotspotSourceScan:
    has_loop: bool
    has_indexed_access: bool
    advances_index: bool
    small_fixed_trip_loop: bool
    predication_candidate: bool
    vectorization_candidate: bool
    range_facts: bool
    hot_call_candidate: bool
    strength_reduce_candidate: bool
    bounded_byte_scan: bool
    checksum_reducer: bool
    counters: JitHotspotSourceScanCounters

struct JitHotspotFactBuild:
    facts: [text]
    counters: JitHotspotSourceScanCounters

fn _jit_zero_source_scan_counters() -> JitHotspotSourceScanCounters:
    JitHotspotSourceScanCounters(
        source_byte_snapshots: 0,
        source_passes: 0,
        source_bytes_visited: 0,
        needle_attempts: 0,
        needle_byte_comparisons: 0
    )

fn _jit_bytes_match_at(bytes: [u8], total_bytes: i64, pos: i64, pat: [u8]) -> (bool, i64):
    val pat_len = pat.len()
    if pos + pat_len > total_bytes:
        return (false, 0)
    var k: i64 = 0
    while k < pat_len:
        if bytes[pos + k] != pat[k]:
            return (false, k + 1)
        k = k + 1
    (true, pat_len)

fn _jit_hotspot_source_scan(source: text) -> JitHotspotSourceScan:
    val bytes = source.bytes()
    val total_bytes = bytes.len()
    var has_loop = false
    var has_open_bracket = false
    var has_close_bracket = false
    var has_dot = false
    var advances_index = false
    var has_small_bound = false
    var has_branch = false
    var has_select_shape = false
    var has_scalar_compare = false
    var has_return_word = false
    var has_return_space = false
    var has_assign_eq = false
    var has_vector_op = false
    var has_break = false
    var has_return_neg_one = false
    var has_upper_bound = false
    var starts_at_zero = false
    var has_direct_call = false
    var strength_reduce = false
    var has_acc_update = false
    var has_checksum_op = false
    var needle_attempts: i64 = 0
    var needle_comparisons: i64 = 0

    var idx: i64 = 0
    while idx < total_bytes:
        val b = bytes[idx]
        if b == 91:
            has_open_bracket = true
        elif b == 93:
            has_close_bracket = true
        elif b == 46:
            has_dot = true
            needle_attempts = needle_attempts + 1
            val (m_len, c_len) = _jit_bytes_match_at(bytes, total_bytes, idx, [46, 108, 101, 110])
            needle_comparisons = needle_comparisons + c_len
            if m_len:
                has_upper_bound = true
        elif b == 63:
            has_select_shape = true
        elif b == 43:
            has_vector_op = true
            has_checksum_op = true
            needle_attempts = needle_attempts + 1
            val (m_p1, c_p1) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 32, 49])
            needle_comparisons = needle_comparisons + c_p1
            if m_p1:
                advances_index = true
            needle_attempts = needle_attempts + 1
            val (m_peq, c_peq) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61])
            needle_comparisons = needle_comparisons + c_peq
            if m_peq:
                has_acc_update = true
                needle_attempts = needle_attempts + 1
                val (m_peq1, c_peq1) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61, 32, 49])
                needle_comparisons = needle_comparisons + c_peq1
                if m_peq1:
                    advances_index = true
                    needle_attempts = needle_attempts + 1
                    val (m_peq16, c_peq16) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61, 32, 49, 54])
                    needle_comparisons = needle_comparisons + c_peq16
                    if m_peq16:
                        strength_reduce = true
                else:
                    needle_attempts = needle_attempts + 3
                    val (m_peq2, c_peq2) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61, 32, 50])
                    val (m_peq4, c_peq4) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61, 32, 52])
                    val (m_peq8, c_peq8) = _jit_bytes_match_at(bytes, total_bytes, idx, [43, 61, 32, 56])
                    needle_comparisons = needle_comparisons + c_peq2 + c_peq4 + c_peq8
                    if m_peq2 or m_peq4 or m_peq8:
                        strength_reduce = true
        elif b == 45:
            has_vector_op = true
        elif b == 42:
            has_vector_op = true
            needle_attempts = needle_attempts + 4
            val (m_m2, c_m2) = _jit_bytes_match_at(bytes, total_bytes, idx, [42, 32, 50])
            val (m_m4, c_m4) = _jit_bytes_match_at(bytes, total_bytes, idx, [42, 32, 52])
            val (m_m8, c_m8) = _jit_bytes_match_at(bytes, total_bytes, idx, [42, 32, 56])
            val (m_m16, c_m16) = _jit_bytes_match_at(bytes, total_bytes, idx, [42, 32, 49, 54])
            needle_comparisons = needle_comparisons + c_m2 + c_m4 + c_m8 + c_m16
            if m_m2 or m_m4 or m_m8 or m_m16:
                strength_reduce = true
        elif b == 94:
            has_vector_op = true
            has_checksum_op = true
            needle_attempts = needle_attempts + 1
            val (m_xeq, c_xeq) = _jit_bytes_match_at(bytes, total_bytes, idx, [94, 61])
            needle_comparisons = needle_comparisons + c_xeq
            if m_xeq:
                has_acc_update = true
        elif b == 60:
            needle_attempts = needle_attempts + 1
            val (m_shl, c_shl) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 60])
            needle_comparisons = needle_comparisons + c_shl
            if m_shl:
                strength_reduce = true
                has_checksum_op = true
            else:
                needle_attempts = needle_attempts + 5
                val (m_lt2, c_lt2) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 32, 50])
                val (m_lt3, c_lt3) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 32, 51])
                val (m_lt4, c_lt4) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 32, 52])
                val (m_lt8, c_lt8) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 32, 56])
                val (m_lt16, c_lt16) = _jit_bytes_match_at(bytes, total_bytes, idx, [60, 32, 49, 54])
                needle_comparisons = needle_comparisons + c_lt2 + c_lt3 + c_lt4 + c_lt8 + c_lt16
                if m_lt2 or m_lt3 or m_lt4 or m_lt8 or m_lt16:
                    has_small_bound = true
        elif b == 62:
            needle_attempts = needle_attempts + 1
            val (m_shr, c_shr) = _jit_bytes_match_at(bytes, total_bytes, idx, [62, 62])
            needle_comparisons = needle_comparisons + c_shr
            if m_shr:
                has_checksum_op = true
        elif b == 61:
            needle_attempts = needle_attempts + 1
            val (m_eq0, c_eq0) = _jit_bytes_match_at(bytes, total_bytes, idx, [61, 32, 48])
            needle_comparisons = needle_comparisons + c_eq0
            if m_eq0:
                starts_at_zero = true
        elif b == 32:
            needle_attempts = needle_attempts + 5
            val (m_aeq, c_aeq) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 61, 32])
            val (m_slt, c_slt) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 60, 32])
            val (m_sgt, c_sgt) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 62, 32])
            val (m_seq, c_seq) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 61, 61, 32])
            val (m_sne, c_sne) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 33, 61, 32])
            needle_comparisons = needle_comparisons + c_aeq + c_slt + c_sgt + c_seq + c_sne
            if m_aeq:
                has_assign_eq = true
            if m_slt or m_sgt or m_seq or m_sne:
                has_scalar_compare = true
            if m_slt:
                needle_attempts = needle_attempts + 3
                val (m_ubn, c_ubn) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 60, 32, 110])
                val (m_ubl, c_ubl) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 60, 32, 108, 101, 110])
                val (m_ublg, c_ublg) = _jit_bytes_match_at(bytes, total_bytes, idx, [32, 60, 32, 108, 101, 110, 103, 116, 104])
                needle_comparisons = needle_comparisons + c_ubn + c_ubl + c_ublg
                if m_ubn or m_ubl or m_ublg:
                    has_upper_bound = true
        elif b == 119:
            needle_attempts = needle_attempts + 1
            val (m_wh, c_wh) = _jit_bytes_match_at(bytes, total_bytes, idx, [119, 104, 105, 108, 101])
            needle_comparisons = needle_comparisons + c_wh
            if m_wh:
                has_loop = true
        elif b == 102:
            needle_attempts = needle_attempts + 1
            val (m_for, c_for) = _jit_bytes_match_at(bytes, total_bytes, idx, [102, 111, 114, 32])
            needle_comparisons = needle_comparisons + c_for
            if m_for:
                has_loop = true
        elif b == 105:
            needle_attempts = needle_attempts + 2
            val (m_if, c_if) = _jit_bytes_match_at(bytes, total_bytes, idx, [105, 102, 32])
            val (m_inl, c_inl) = _jit_bytes_match_at(bytes, total_bytes, idx, [105, 110, 108, 105, 110, 101, 95, 116, 97, 114, 103, 101, 116, 40])
            needle_comparisons = needle_comparisons + c_if + c_inl
            if m_if:
                has_branch = true
            if m_inl:
                has_direct_call = true
        elif b == 101:
            needle_attempts = needle_attempts + 1
            val (m_el, c_el) = _jit_bytes_match_at(bytes, total_bytes, idx, [101, 108, 115, 101])
            needle_comparisons = needle_comparisons + c_el
            if m_el:
                has_branch = true
                has_select_shape = true
        elif b == 115:
            needle_attempts = needle_attempts + 1
            val (m_sel, c_sel) = _jit_bytes_match_at(bytes, total_bytes, idx, [115, 101, 108, 101, 99, 116])
            needle_comparisons = needle_comparisons + c_sel
            if m_sel:
                has_select_shape = true
        elif b == 114:
            needle_attempts = needle_attempts + 1
            val (m_ret, c_ret) = _jit_bytes_match_at(bytes, total_bytes, idx, [114, 101, 116, 117, 114, 110])
            needle_comparisons = needle_comparisons + c_ret
            if m_ret:
                has_return_word = true
                needle_attempts = needle_attempts + 1
                val (m_rets, c_rets) = _jit_bytes_match_at(bytes, total_bytes, idx, [114, 101, 116, 117, 114, 110, 32])
                needle_comparisons = needle_comparisons + c_rets
                if m_rets:
                    has_return_space = true
                    needle_attempts = needle_attempts + 1
                    val (m_retn1, c_retn1) = _jit_bytes_match_at(bytes, total_bytes, idx, [114, 101, 116, 117, 114, 110, 32, 45, 49])
                    needle_comparisons = needle_comparisons + c_retn1
                    if m_retn1:
                        has_return_neg_one = true
        elif b == 98:
            needle_attempts = needle_attempts + 1
            val (m_brk, c_brk) = _jit_bytes_match_at(bytes, total_bytes, idx, [98, 114, 101, 97, 107])
            needle_comparisons = needle_comparisons + c_brk
            if m_brk:
                has_break = true
        elif b == 97:
            needle_attempts = needle_attempts + 1
            val (m_acc, c_acc) = _jit_bytes_match_at(bytes, total_bytes, idx, [97, 99, 99, 32, 61])
            needle_comparisons = needle_comparisons + c_acc
            if m_acc:
                has_acc_update = true
        elif b == 99:
            needle_attempts = needle_attempts + 2
            val (m_chk, c_chk) = _jit_bytes_match_at(bytes, total_bytes, idx, [99, 104, 101, 99, 107, 115, 117, 109, 32, 61])
            val (m_cal, c_cal) = _jit_bytes_match_at(bytes, total_bytes, idx, [99, 97, 108, 108, 101, 101, 40])
            needle_comparisons = needle_comparisons + c_chk + c_cal
            if m_chk:
                has_acc_update = true
            if m_cal:
                has_direct_call = true
        elif b == 104:
            needle_attempts = needle_attempts + 2
            val (m_hlp, c_hlp) = _jit_bytes_match_at(bytes, total_bytes, idx, [104, 101, 108, 112, 101, 114, 40])
            val (m_hc, c_hc) = _jit_bytes_match_at(bytes, total_bytes, idx, [104, 111, 116, 95, 99, 97, 108, 108, 40])
            needle_comparisons = needle_comparisons + c_hlp + c_hc
            if m_hlp or m_hc:
                has_direct_call = true
        elif b == 108:
            needle_attempts = needle_attempts + 1
            val (m_lf, c_lf) = _jit_bytes_match_at(bytes, total_bytes, idx, [108, 101, 97, 102, 40])
            needle_comparisons = needle_comparisons + c_lf
            if m_lf:
                has_direct_call = true
        elif b == 120:
            needle_attempts = needle_attempts + 1
            val (m_xor, c_xor) = _jit_bytes_match_at(bytes, total_bytes, idx, [120, 111, 114])
            needle_comparisons = needle_comparisons + c_xor
            if m_xor:
                has_checksum_op = true
        idx = idx + 1

    val has_indexed_access = has_open_bracket and has_close_bracket
    val has_safe_result = has_return_word or has_assign_eq
    val has_scalar_site = has_return_space or has_assign_eq
    val avoids_indexed_or_method = not has_open_bracket and not has_dot
    val no_early_exit = not has_break and not has_return_neg_one
    val has_scan_terminator = has_break or has_return_word

    JitHotspotSourceScan(
        has_loop: has_loop,
        has_indexed_access: has_indexed_access,
        advances_index: advances_index,
        small_fixed_trip_loop: has_loop and has_small_bound and advances_index,
        predication_candidate: has_branch and has_select_shape and has_scalar_compare and has_safe_result,
        vectorization_candidate: has_loop and has_indexed_access and advances_index and has_vector_op and no_early_exit,
        range_facts: has_loop and has_indexed_access and has_upper_bound and starts_at_zero and advances_index,
        hot_call_candidate: has_direct_call and has_scalar_site and avoids_indexed_or_method,
        strength_reduce_candidate: strength_reduce,
        bounded_byte_scan: has_loop and has_indexed_access and has_scan_terminator and advances_index,
        checksum_reducer: has_loop and has_indexed_access and has_acc_update and has_checksum_op,
        counters: JitHotspotSourceScanCounters(
            source_byte_snapshots: 1,
            source_passes: 1,
            source_bytes_visited: total_bytes,
            needle_attempts: needle_attempts,
            needle_byte_comparisons: needle_comparisons
        )
    )

fn _jit_hotspot_backend_plugin_fact_build(profile: FunctionProfile, config: TieredJitConfig, backend_name: text) -> JitHotspotFactBuild:
    var facts = jit_hotspot_profile_facts(profile, config, profile.typed_mir, profile.safe_deopt)
    for fact in jit_var_optimization_fact_list(profile.var_facts):
        facts = facts.push(fact)
    if profile.typed_mir and profile.safe_deopt and jit_var_optimization_implies_scalar_cleanup(profile.var_facts):
        facts = facts.push("ssa.canonical")
        facts = facts.push("alias_stable")
    var counters = _jit_zero_source_scan_counters()
    if profile.typed_mir and profile.safe_deopt:
        val scan = _jit_hotspot_source_scan(profile.source)
        counters = scan.counters
        if scan.has_loop:
            facts = facts.push("loop_preheader")
        if scan.small_fixed_trip_loop:
            facts = facts.push("loop_canonical")
            facts = facts.push("loop_trip_count")
            facts = facts.push("unroll_budget")
        if scan.predication_candidate:
            facts = facts.push("predication_candidate")
            facts = facts.push("predicate_safe")
        if scan.vectorization_candidate:
            facts = facts.push("vectorization_candidate")
        if scan.range_facts:
            facts = facts.push("range_facts")
        if scan.hot_call_candidate:
            facts = facts.push("profile.hot_call")
            facts = facts.push("inline_budget")
        if scan.strength_reduce_candidate:
            facts = facts.push("strength_reduce_candidate")
            facts = facts.push("induction_safe")
        if scan.bounded_byte_scan:
            facts = facts.push("bounded_scan_terminates")
        if scan.checksum_reducer:
            facts = facts.push("checksum_associative")
    if backend_name == "llvm":
        facts = facts.push("llvm_backend_available")
    if backend_name == "cranelift":
        facts = facts.push("cranelift_backend_available")
    JitHotspotFactBuild(facts: facts, counters: counters)

fn jit_hotspot_backend_plugin_facts(profile: FunctionProfile, config: TieredJitConfig, backend_name: text) -> [text]:
    _jit_hotspot_backend_plugin_fact_build(profile, config, backend_name).facts

fn jit_hotspot_rebuild_choice(
    profile: FunctionProfile,
    config: TieredJitConfig,
    cranelift_available: bool,
    llvm_available: bool,
    max_cost_class: text
) -> JitHotspotRebuildChoice:
    val var_reason = jit_hotspot_var_rebuild_reason(profile)
    if var_reason != "ready":
        return JitHotspotRebuildChoice(
            function_name: profile.name,
            selected_backend: "",
            eligible: false,
            reason: var_reason,
            cost_class: "none",
            required_count: config.tier1_threshold,
            attempted_backends: []
        )
    val llvm_heat_preferred = profile.call_count >= jit_hotspot_llvm_preference_threshold(config)
    if cranelift_available and profile.call_count >= config.tier1_threshold and jit_hotspot_cost_allowed("medium", max_cost_class):
        if llvm_available and llvm_heat_preferred and jit_hotspot_cost_allowed("high", max_cost_class):
            return JitHotspotRebuildChoice(
                function_name: profile.name,
                selected_backend: "llvm",
                eligible: true,
                reason: "ready",
                cost_class: "high",
                required_count: config.tier2_threshold,
                attempted_backends: ["llvm"]
            )
        return JitHotspotRebuildChoice(
            function_name: profile.name,
            selected_backend: "cranelift",
            eligible: true,
            reason: "ready",
            cost_class: "medium",
            required_count: config.tier1_threshold,
            attempted_backends: ["llvm", "cranelift"]
        )

    var attempted: [text] = []
    val llvm_plan = jit_hotspot_rebuild_plan_with_cost_budget(profile, config, "llvm", llvm_available and ((not cranelift_available) or llvm_heat_preferred), max_cost_class)
    attempted = attempted.push("llvm")
    if llvm_plan.eligible:
        return JitHotspotRebuildChoice(
            function_name: profile.name,
            selected_backend: "llvm",
            eligible: true,
            reason: "ready",
            cost_class: llvm_plan.cost_class,
            required_count: llvm_plan.required_count,
            attempted_backends: attempted
        )

    val cranelift_plan = jit_hotspot_rebuild_plan_with_cost_budget(profile, config, "cranelift", cranelift_available, max_cost_class)
    attempted = attempted.push("cranelift")
    if cranelift_plan.eligible:
        return JitHotspotRebuildChoice(
            function_name: profile.name,
            selected_backend: "cranelift",
            eligible: true,
            reason: "ready",
            cost_class: cranelift_plan.cost_class,
            required_count: cranelift_plan.required_count,
            attempted_backends: attempted
        )

    var reason = llvm_plan.reason
    if not cranelift_available and not llvm_available:
        reason = "no backend available"
    elif llvm_plan.reason == "cost budget exceeded":
        reason = "llvm cost budget exceeded"
    elif llvm_available and cranelift_available and profile.call_count >= config.tier2_threshold and not llvm_heat_preferred:
        reason = "llvm heat margin not reached"
    elif profile.call_count < config.tier1_threshold:
        reason = "missing tier1 hot_count"
    JitHotspotRebuildChoice(
        function_name: profile.name,
        selected_backend: "",
        eligible: false,
        reason: reason,
        cost_class: "none",
        required_count: config.tier1_threshold,
        attempted_backends: attempted
    )

fn jit_hotspot_rebuild_opt_level(choice: JitHotspotRebuildChoice) -> OptLevel:
    OptLevel.Aggressive

fn jit_hotspot_ready_optimization_plan(
    profile: FunctionProfile,
    config: TieredJitConfig,
    backend: text,
    reason: text,
    cost_class: text,
    max_cost_class: text
) -> JitHotspotOptimizationPlan:
    val mir_plan = optimizationpipeline_backend_plan_for_budget(OptLevel.Aggressive, backend, max_cost_class)
    val plugin_plan = backend_optimization_plan_for_budget_with_facts(backend, max_cost_class, jit_hotspot_backend_plugin_facts(profile, config, backend))
    JitHotspotOptimizationPlan(
        function_name: profile.name,
        backend: backend,
        eligible: true,
        reason: reason,
        cost_class: cost_class,
        max_cost_class: max_cost_class,
        opt_level: "aggressive",
        passes: mir_plan.passes,
        skipped_passes: mir_plan.skipped_passes,
        plugin_recommendations: plugin_plan.recommendation_names,
        skipped_plugin_recommendations: plugin_plan.skipped_decisions
    )

fn jit_hotspot_optimization_plan(
    profile: FunctionProfile,
    config: TieredJitConfig,
    cranelift_available: bool,
    llvm_available: bool,
    max_cost_class: text
) -> JitHotspotOptimizationPlan:
    val var_reason = jit_hotspot_var_rebuild_reason(profile)
    if var_reason != "ready":
        return JitHotspotOptimizationPlan(
            function_name: profile.name,
            backend: "",
            eligible: false,
            reason: var_reason,
            cost_class: "none",
            max_cost_class: max_cost_class,
            opt_level: "",
            passes: [],
            skipped_passes: [],
            plugin_recommendations: [],
            skipped_plugin_recommendations: []
        )
    val llvm_heat_preferred = profile.call_count >= jit_hotspot_llvm_preference_threshold(config)
    if cranelift_available and profile.call_count >= config.tier1_threshold and max_cost_class == "medium":
        return jit_hotspot_ready_optimization_plan(profile, config, "cranelift", "ready", "medium", max_cost_class)
    if llvm_available and llvm_heat_preferred and jit_hotspot_cost_allowed("high", max_cost_class):
        return jit_hotspot_ready_optimization_plan(profile, config, "llvm", "ready", "high", max_cost_class)
    val choice = jit_hotspot_rebuild_choice(profile, config, cranelift_available, llvm_available, max_cost_class)
    if not choice.eligible:
        return JitHotspotOptimizationPlan(
            function_name: choice.function_name,
            backend: choice.selected_backend,
            eligible: false,
            reason: choice.reason,
            cost_class: choice.cost_class,
            max_cost_class: max_cost_class,
            opt_level: "",
            passes: [],
            skipped_passes: [],
            plugin_recommendations: [],
            skipped_plugin_recommendations: []
        )
    val opt_level = jit_hotspot_rebuild_opt_level(choice)
    if opt_level == OptLevel.Aggressive:
        return jit_hotspot_ready_optimization_plan(profile, config, choice.selected_backend, choice.reason, choice.cost_class, max_cost_class)
    val mir_plan = optimizationpipeline_backend_plan_for_budget(opt_level, choice.selected_backend, max_cost_class)
    val plugin_facts = jit_hotspot_backend_plugin_facts(profile, config, choice.selected_backend)
    val plugin_plan = backend_optimization_plan_for_budget_with_facts(choice.selected_backend, max_cost_class, plugin_facts)
    JitHotspotOptimizationPlan(
        function_name: choice.function_name,
        backend: choice.selected_backend,
        eligible: true,
        reason: choice.reason,
        cost_class: choice.cost_class,
        max_cost_class: max_cost_class,
        opt_level: optlevel_name(opt_level),
        passes: mir_plan.passes,
        skipped_passes: mir_plan.skipped_passes,
        plugin_recommendations: plugin_plan.recommendation_names,
        skipped_plugin_recommendations: plugin_plan.skipped_decisions
    )

fn jit_hotspot_plan_invalidate(plan: JitHotspotPlan, reason: text) -> JitHotspotPlan:
    JitHotspotPlan(
        function_name: plan.function_name,
        call_count: plan.call_count,
        threshold: plan.threshold,
        eligible: false,
        invalidated: true,
        reason: reason,
        facts: plan.facts
    )

fn jit_hotspot_consume_plan(
    plan: JitHotspotPlan,
    source: text,
    provider_enabled: bool
) -> JitHotspotCompileDecision:
    if not provider_enabled:
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: "provider disabled"
        )
    if not plan.eligible:
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: plan.reason
        )
    JitHotspotCompileDecision(
        plan: plan,
        compile_source: source,
        provider_used: true,
        reason: "jit.hotspot_plan accepted"
    )

fn jit_hotspot_specialization_provider(
    name: text,
    specialized_source: text,
    semantic_proof: bool
) -> JitHotspotSpecializationProvider:
    JitHotspotSpecializationProvider(
        name: name,
        enabled: true,
        specialized_source: specialized_source,
        semantic_proof: semantic_proof,
        eligible_rules: []
    )

fn jit_hotspot_specialization_provider_with_rules(
    name: text,
    specialized_source: text,
    semantic_proof: bool,
    fn_name: text,
    facts: [text],
    proofs: [text]
) -> JitHotspotSpecializationProvider:
    val rules = get_eligible_rules_for_function(fn_name, clib_parity_rule_table(), facts, proofs)
    JitHotspotSpecializationProvider(
        name: name,
        enabled: true,
        specialized_source: specialized_source,
        semantic_proof: semantic_proof,
        eligible_rules: rules
    )

fn jit_hotspot_analysis_has_semantic_proof(facts: [text]) -> bool:
    if not facts.contains("typed_mir"):
        return false
    if not facts.contains("safe_deopt"):
        return false
    if not facts.contains("ssa.var_transform"):
        return false
    if not facts.contains("escape.analyzed"):
        return false
    if not facts.contains("escape.no_escape"):
        return false
    facts.contains("borrow.reassign_safe")

fn jit_hotspot_specialization_provider_from_analysis(
    name: text,
    specialized_source: text,
    facts: [text]
) -> JitHotspotSpecializationProvider:
    jit_hotspot_specialization_provider(
        name,
        specialized_source,
        jit_hotspot_analysis_has_semantic_proof(facts)
    )

fn jit_hotspot_specialization_provider_from_profile_analysis(
    name: text,
    profile: FunctionProfile,
    config: TieredJitConfig,
    typed_mir: bool,
    safe_deopt: bool
) -> JitHotspotSpecializationProvider:
    val plan = jit_hotspot_plan_from_profile_var_facts(profile, config, typed_mir, safe_deopt)
    jit_hotspot_specialization_provider_from_analysis(name, profile.hotspot_specialized_source, plan.facts)

fn jit_hotspot_provider_get_eligible_rules(provider: JitHotspotSpecializationProvider) -> [CLibParityRule]:
    provider.eligible_rules

fn jit_hotspot_consume_plan_with_provider(
    plan: JitHotspotPlan,
    source: text,
    provider: JitHotspotSpecializationProvider
) -> JitHotspotCompileDecision:
    if not provider.enabled:
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: "provider disabled"
        )
    if not plan.eligible:
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: plan.reason
        )
    if not provider.semantic_proof:
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: "missing semantic proof"
        )
    if provider.specialized_source == "":
        return JitHotspotCompileDecision(
            plan: plan,
            compile_source: source,
            provider_used: false,
            reason: "missing specialized source"
        )
    JitHotspotCompileDecision(
        plan: plan,
        compile_source: provider.specialized_source,
        provider_used: true,
        reason: "jit.hotspot_specialized_source accepted"
    )

fn jit_hotspot_compile_decision_allows_compile(decision: JitHotspotCompileDecision) -> bool:
    decision.plan.eligible and decision.compile_source != ""

fn default_config() -> TieredJitConfig:
    TieredJitConfig(tier1_threshold: 64, tier2_threshold: 1024, debug_mode: true)

fn release_config() -> TieredJitConfig:
    TieredJitConfig(tier1_threshold: 64, tier2_threshold: 1024, debug_mode: false)

fn eager_config() -> TieredJitConfig:
    TieredJitConfig(tier1_threshold: 8, tier2_threshold: 128, debug_mode: true)
