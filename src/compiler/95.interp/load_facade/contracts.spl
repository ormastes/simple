use compiler.driver.cache.package_archive_types.{PackageArchiveReceiptV1}
use compiler.driver.cache.pinned_archive_capability.{PinnedArchiveCapability}
use compiler.hir.import_materialization.state.{ImportSnapshotIdentityV1}

enum InterpreterLoadErrorV1:
    invalid_snapshot_identity
    invalid_resolver_identity
    invalid_route
    dirty_package_requires_compile
    archive_authority_missing
    archive_authority_mismatch
    archive_open_failed
    duplicate_package
    empty_route

struct InterpreterLoadSnapshotIdentityV1:
    revision: text
    tree_digest: text
    inventory_digest: text
    package_index_digest: text

struct InterpreterLoadResolverIdentityV1:
    producer_digest: text
    root_generation: text
    variant_digest: text

struct InterpreterLoadDiagnosticIdentityV1:
    code: text
    package_identity: text
    module_identity: text
    snapshot_revision: text
    identity_digest: text

struct InterpreterArchivePlanV1:
    package_identity: text
    module_identities: [text]
    archive_path: text
    receipt: PackageArchiveReceiptV1

struct InterpreterLoadPlanV1:
    snapshot: InterpreterLoadSnapshotIdentityV1
    resolver: InterpreterLoadResolverIdentityV1
    archives: [InterpreterArchivePlanV1]

class InterpreterPackageLoadV1:
    package_identity: text
    module_identities: [text]
    snapshot: ImportSnapshotIdentityV1
    receipt: PackageArchiveReceiptV1
    capability: PinnedArchiveCapability

struct InterpreterLoadFailureV1:
    error: InterpreterLoadErrorV1
    diagnostic: InterpreterLoadDiagnosticIdentityV1

export InterpreterLoadErrorV1
export InterpreterLoadSnapshotIdentityV1, InterpreterLoadResolverIdentityV1
export InterpreterLoadDiagnosticIdentityV1, InterpreterLoadFailureV1
export InterpreterArchivePlanV1, InterpreterLoadPlanV1, InterpreterPackageLoadV1
