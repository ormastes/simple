# MIR Interpreter
#
# Pure interpreter backend for MIR execution without native compilation.
# Evaluates MIR instructions directly using virtual register mapping.
#
# This enables:
# - Self-hosting (no SFFI dependencies)
# - Debugging (compare interpreter vs native results)
# - Portable execution (no Cranelift/LLVM needed)
# - Fast iteration (no compilation overhead)
#
# Architecture:
#   MIR Instructions -> Direct Evaluation -> RuntimeValue
#
# Port of rust/compiler/src/codegen/mir_interpreter.rs (1,058 lines)

use std.log.{debug, log_get_level, LOG_DEBUG}
use compiler.mir.mir_data.*
use compiler.common.diagnostics.span.{Span}

# Cohesion split (2026-08-18): class-independent pieces live in sibling
# modules; re-exported here so the public surface of this module is unchanged.
export use compiler.interp.mir_interp_error.{InterpError, CallFrame}
export use compiler.interp.mir_interp_runtime.{mir_interp_call_runtime_fn, f64_to_bits, f64_from_bits, _extract_func_name}

# Miri-mode: dynamic UB checks too expensive for normal runs, gated behind
# SIMPLE_STRICT_INTERP=1 so default interpreter perf/behavior is untouched.
# Read once at interpreter creation (see MirInterpreter.strict_mode).
extern fn rt_env_get(key: text) -> text


# ============================================================================
# MIR Interpreter
# ============================================================================

class MirInterpreter:
    """
    MIR instruction interpreter.

    Maintains runtime state:
    - locals: Local variable values (LocalId -> i64)
    - globals: Global variable storage (name -> i64)
    - blocks: Basic block map (BlockId -> MirBlock)
    - current_block: Currently executing block
    - return_value: Return value from function
    """
    locals: {i64: i64}       # LocalId.id -> value
    globals: {text: i64}     # Global name -> value
    blocks: {i64: MirBlock}  # BlockId.id -> block
    current_block: i64?      # Current block ID
    previous_block: i64?     # Last block ID before the current block
    return_value: i64?       # Return value
    has_returned: bool       # Whether function has returned
    function_table: {text: MirFunction}  # Function name -> MirFunction
    call_stack: [CallFrame]  # Stack of saved frames for nested calls
    next_aggregate_id: i64   # Counter for aggregate base addresses
    aggregate_sizes: {i64: i64}  # Aggregate base address -> element count
    string_table: {i64: text}
    next_string_id: i64
    strict_mode: bool       # Miri-mode: SIMPLE_STRICT_INTERP=1, read once at create()
    current_function: text  # Name of the function currently executing
    error_frames: [text]    # Innermost-first frame names captured when an error escapes
    # Perf (Phase D): log-facade debug() costs an rt_env_get + string compares
    # per call even when the level gate rejects it. Cache the verdict once at
    # create() (level-gated, default off) instead of paying the facade on the
    # execute_function hot path. Toggle via set_debug_log_enabled for tests.
    debug_enabled: bool
    # Perf (Phase D): repeated direct calls to the same callee re-do a
    # contains() + [] pair on function_table per call. Cache the last
    # resolved (name, function). Invalidated by set_function_table.
    cached_call_name: text
    cached_call_fn: MirFunction?
    # Perf (frame pool): bounded reuse of INNER-call frame dicts only. The
    # top-level locals/blocks set up by execute_function are never pooled --
    # complex-const behavior relies on top-level locals persisting across
    # execute_function calls on one instance. Dicts are cleared ON REUSE
    # (in _take_*) so no value can leak between sibling or successive calls.
    frame_locals_pool: [{i64: i64}]
    frame_blocks_pool: [{i64: MirBlock}]

impl MirInterpreter:
    static fn create() -> MirInterpreter:
        """Create a new interpreter instance."""
        # Level-gated (default off): read the log level ONCE here; the facade
        # itself costs an env read + string compares per call, too expensive
        # for the dispatch hot path.
        val dbg = log_get_level() <= LOG_DEBUG
        if dbg:
            debug("interp", "Creating MIR interpreter instance")
        MirInterpreter(
            locals: {},
            globals: {},
            blocks: {},
            current_block: nil,
            previous_block: nil,
            return_value: nil,
            has_returned: false,
            function_table: {},
            call_stack: [],
            next_aggregate_id: 100000,
            aggregate_sizes: {},
            string_table: {},
            next_string_id: -1,
            # Read once at startup so default (unset) perf/behavior is untouched;
            # never re-read per instruction.
            strict_mode: (rt_env_get("SIMPLE_STRICT_INTERP") ?? "") == "1",
            current_function: "<toplevel>",
            error_frames: [],
            debug_enabled: dbg,
            cached_call_name: "",
            cached_call_fn: nil,
            frame_locals_pool: [],
            frame_blocks_pool: []
        )

    fn is_debug_log_enabled() -> bool:
        """Accessor: is per-run debug logging active? Cached once at create."""
        self.debug_enabled

    me set_debug_log_enabled(on: bool):
        """Enable/disable the cached debug-log gate (observability only --
        never affects execution semantics)."""
        self.debug_enabled = on

    me _record_error_frame():
        """Record the currently-executing function as an unwound error frame.

        Called on every error-return path BEFORE the frame is popped -- popping
        restores caller state and destroys the evidence, which is exactly why
        the frame stack existed but no trace was ever printable.
        """
        self.error_frames.push(self.current_function)

    me call_stack_trace() -> text:
        """Render the captured error frames as a `Call stack:` section.

        Empty string when no error has unwound, so callers can append it
        unconditionally without emitting a bare header.
        """
        if self.error_frames.len() == 0:
            return ""
        var out = "Call stack:"
        var i = 0
        while i < self.error_frames.len():
            out = out + "\n  #{i} {self.error_frames[i]}"
            i = i + 1
        out

    me format_error(err: InterpError) -> text:
        """Format a runtime error together with its call stack section."""
        val msg = err.message()
        # InterpError.RuntimeError already carries the "Runtime error: " prefix;
        # every other variant does not. Prefix only when it is missing so the
        # header appears exactly once.
        var head = msg
        if not msg.starts_with("Runtime error"):
            head = "Runtime error: {msg}"
        val trace = self.call_stack_trace()
        if trace == "":
            return head
        "{head}\n{trace}"

    # ========================================================================
    # Value Management
    # ========================================================================

    me set_local(dest: LocalId, value: i64):
        """Store a value in a local variable."""
        self.locals[dest.id] = value

    fn get_local(local: LocalId) -> i64:
        """Get a value from a local variable (0 if not set)."""
        # ponytail: undefined locals fail closed instead of masquerading as zero.
        self.locals[local.id] ?? -1

    fn is_local_set(local: LocalId) -> bool:
        """Miri-mode helper: has this local ever been written?"""
        self.locals.contains(local.id)

    fn _format_span(span: Span?) -> text:
        """Miri-mode helper: render a source span for a loud diagnostic, or
        'unknown location' when the instruction carries no span."""
        if span.?:
            val sp = span.unwrap()
            "{sp.file}:{sp.line}:{sp.col}"
        else:
            "unknown location"

    fn get_operand(operand: MirOperand) -> i64:
        """Evaluate an operand to get its value."""
        match operand.kind:
            case Copy(local): self.get_local(local)
            case Move(local): self.get_local(local)
            case Const(value, type_):
                match value:
                    case Int(v): v
                    case Float(v): f64_to_bits(v)
                    case Bool(v): if v: 1 else: 0
                    case _: 0  # Stub for complex constants

    me set_function_table(table: {text: MirFunction}):
        """Set the function table for cross-function calls."""
        if self.debug_enabled:
            debug("interp", "Setting function table ({table.keys().len()} functions)")
        self.function_table = table
        # Invalidate the direct-call cache: entries may have changed.
        self.cached_call_name = ""
        self.cached_call_fn = nil

    me _resolve_function(name: text) -> MirFunction?:
        """Resolve a callee by name with a one-entry cache for repeated
        direct calls (hot in call-heavy loops). Semantics identical to
        contains()+[] on function_table; cache invalidated whenever the
        table is replaced (set_function_table)."""
        if name == self.cached_call_name and self.cached_call_fn.?:
            return self.cached_call_fn
        if self.function_table.contains(name):
            val f = self.function_table[name]
            self.cached_call_name = name
            self.cached_call_fn = Some(f)
            return Some(f)
        nil

    # ========================================================================
    # Instruction Execution
    # ========================================================================

    me execute_instruction(inst: MirInst) -> InterpError?:
        """Execute a single MIR instruction."""
        match inst.kind:
            case Const(dest, value, type_):
                self.execute_const(dest, value)
                nil

            case Copy(dest, src):
                if self.strict_mode and not self.is_local_set(src):
                    print "PANIC: strict-interp uninitialized-local-read: Copy reads v{src.id} before any write, at {self._format_span(inst.span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:uninitialized-local-read Copy v{src.id} at {self._format_span(inst.span)}"))
                val value = self.get_local(src)
                self.set_local(dest, value)
                nil

            case Move(dest, src):
                if self.strict_mode and not self.is_local_set(src):
                    print "PANIC: strict-interp uninitialized-local-read: Move reads v{src.id} before any write, at {self._format_span(inst.span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:uninitialized-local-read Move v{src.id} at {self._format_span(inst.span)}"))
                val value = self.get_local(src)
                self.set_local(dest, value)
                # Note: Move semantics not enforced in interpreter
                nil

            case BinOp(dest, op, left, right):
                self.execute_binop(dest, op, left, right)

            case UnaryOp(dest, op, operand):
                self.execute_unaryop(dest, op, operand)

            case Cast(dest, operand, target):
                val value = self.get_operand(operand)
                # Simple cast - just copy value for now
                self.set_local(dest, value)
                nil

            case Bitcast(dest, operand, target):
                val value = self.get_operand(operand)
                self.set_local(dest, value)
                nil

            case Load(dest, ptr):
                val addr = self.get_operand(ptr)
                # Interpret addr as local ID for now
                val local_id = LocalId(id: addr)
                val value = self.get_local(local_id)
                self.set_local(dest, value)
                nil

            case Store(ptr, value):
                val addr = self.get_operand(ptr)
                val val_to_store = self.get_operand(value)
                val local_id = LocalId(id: addr)
                self.set_local(local_id, val_to_store)
                nil

            case Alloc(dest, type_):
                # Allocate local storage - return local ID
                self.set_local(dest, dest.id)
                nil

            case GetElementPtr(dest, base, indices):
                val base_val = self.get_operand(base)
                var offset = base_val
                for idx in indices:
                    val idx_val = self.get_operand(idx)
                    offset = offset + (idx_val * 8)
                self.set_local(dest, offset)
                nil

            case Aggregate(dest, kind, operands):
                # Allocate a base address for the aggregate
                val base_addr = self.next_aggregate_id
                self.next_aggregate_id = self.next_aggregate_id + (operands.len() * 8) + 8
                # Store each element at base + index * 8
                var i = 0
                for op in operands:
                    val elem_val = self.get_operand(op)
                    val slot = LocalId(id: base_addr + (i * 8))
                    self.set_local(slot, elem_val)
                    i = i + 1
                # dest holds the base address
                self.set_local(dest, base_addr)
                nil

            case GetField(dest, base, field):
                val base_val = self.get_operand(base)
                # Read value from base_address + field_offset
                val field_addr = base_val + (field * 8)
                val slot = LocalId(id: field_addr)
                val field_val = self.get_local(slot)
                self.set_local(dest, field_val)
                nil

            case SetField(base, field, value):
                val base_val = self.get_operand(base)
                val val_to_set = self.get_operand(value)
                val field_addr = base_val + (field * 8)
                val slot = LocalId(id: field_addr)
                self.set_local(slot, val_to_set)
                nil

            case Call(dest, call_target, args):
                val func_name = _extract_func_name(call_target)
                if func_name.?:
                    val name = func_name.unwrap()
                    val callee_opt = self._resolve_function(name)
                    if callee_opt.?:
                        val callee = callee_opt.unwrap()
                        val call_result = self._call_function(callee, args)
                        if call_result[1].?:
                            return call_result[1]
                        if dest.?:
                            val ret = call_result[0] ?? 0
                            self.set_local(dest.unwrap(), ret)
                    else:
                        # Unknown function - set dest to 0
                        if dest.?:
                            self.set_local(dest.unwrap(), 0)
                else:
                    # Cannot resolve function name
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                nil

            case CallIndirect(dest, ptr, args, sig):
                # Try to resolve function pointer as a named function
                val func_name = _extract_func_name(ptr)
                if func_name.?:
                    val name = func_name.unwrap()
                    val callee_opt = self._resolve_function(name)
                    if callee_opt.?:
                        val callee = callee_opt.unwrap()
                        val call_result = self._call_function(callee, args)
                        if call_result[1].?:
                            return call_result[1]
                        if dest.?:
                            val ret = call_result[0] ?? 0
                            self.set_local(dest.unwrap(), ret)
                    else:
                        if dest.?:
                            self.set_local(dest.unwrap(), 0)
                else:
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                nil

            case Intrinsic(dest, name, args):
                # bounds_check must trap loudly, mirroring the native path
                # (__simple_intrinsic_bounds_check in runtime.c: PANIC + exit).
                # Handled here (not in _execute_intrinsic) because lowering may
                # discard the dest, so a returned value would be silently lost.
                if name == "bounds_check":
                    return self._execute_bounds_check(dest, args)
                # abort as an *instruction* was a silent 0-return no-op; the
                # Abort terminator already errors — keep instruction parity.
                if name == "abort":
                    print "PANIC: abort intrinsic executed"
                    return Some(InterpError.RuntimeError(message: "Abort intrinsic executed"))
                # `assert COND[, MSG]` desugars to __assert(...) in
                # parser_stmts.spl. Handled here, not in _execute_intrinsic, for
                # the same reason as bounds_check: lowering may discard dest, so
                # a returned value would be silently lost — which is exactly the
                # failure mode that made every bare `assert` a no-op.
                if name == "__assert":
                    if args.len() < 1:
                        return Some(InterpError.RuntimeError(message: "__assert intrinsic malformed: 0 args"))
                    if self.get_operand(args[0]) == 0:
                        print "PANIC: assertion failed"
                        return Some(InterpError.RuntimeError(message: "assertion failed"))
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                    return nil
                val result = self._execute_intrinsic(name, args)
                if dest.?:
                    self.set_local(dest.unwrap(), result)
                nil

            case DecisionProbe(_, semantic_id, _, _, _, _):
                Some(InterpError.UnsupportedOperation(
                    op: "unlowered DecisionProbe '{semantic_id}'"
                ))

            case ConditionProbe(_, semantic_id, _, _, _, _, _, _):
                Some(InterpError.UnsupportedOperation(
                    op: "unlowered ConditionProbe '{semantic_id}'"
                ))

            case PipeForward(dest, value, _func):
                # Stub: Pipeline operators need runtime support
                val val_res = self.get_operand(value)
                self.set_local(dest, val_res)
                nil

            case Compose(dest, f, g, forward):
                # Stub: Function composition
                self.set_local(dest, 0)
                nil

            case Parallel(dest, funcs):
                # Stub: Parallel execution
                self.set_local(dest, 0)
                nil

            case LayerConnect(dest, layer1, layer2):
                # Stub: Neural network layers
                self.set_local(dest, 0)
                nil

            case CreatePromise(dest, body, result_type):
                # Mirrors LLVM: call ptr @__simple_runtime_create_promise(ptr null)
                val result = mir_interp_call_runtime_fn("__simple_runtime_create_promise", [0])
                self.set_local(dest, result)
                nil

            case Await(dest, promise):
                # Mirrors LLVM: call i64 @__simple_runtime_await(ptr promise)
                val prom_val = self.get_operand(promise)
                val result = mir_interp_call_runtime_fn("__simple_runtime_await", [prom_val])
                self.set_local(dest, result)
                nil

            case Yield(value):
                # Mirrors LLVM: call void @__simple_runtime_yield(i64 value)
                if value.?:
                    val val_int = self.get_operand(value.unwrap())
                    mir_interp_call_runtime_fn("__simple_runtime_yield", [val_int])
                else:
                    mir_interp_call_runtime_fn("__simple_runtime_yield", [0])
                nil

            case Spawn(dest, handler, args):
                # Mirrors LLVM: call ptr @__simple_runtime_spawn(ptr handler)
                val handler_val = self.get_operand(handler)
                val result = mir_interp_call_runtime_fn("__simple_runtime_spawn", [handler_val])
                self.set_local(dest, result)
                nil

            case Send(target, message):
                # Mirrors LLVM: call void @__simple_runtime_send(ptr target, i64 message)
                val target_val = self.get_operand(target)
                val msg_val = self.get_operand(message)
                mir_interp_call_runtime_fn("__simple_runtime_send", [target_val, msg_val])
                nil

            case Receive(dest, timeout):
                # Mirrors LLVM: call i64 @__simple_runtime_receive(i64 timeout)
                var timeout_val: i64 = -1
                if timeout.?:
                    timeout_val = self.get_operand(timeout.unwrap())
                val result = mir_interp_call_runtime_fn("__simple_runtime_receive", [timeout_val])
                self.set_local(dest, result)
                nil

            case Ref(dest, borrow_kind, place):
                # Borrow checking - return place address
                self.set_local(dest, place.local.id)
                nil

            case DebugValue(local, name):
                # Debug - no-op
                nil

            case Nop:
                # No-op
                nil

            case Drop(local):
                # WP-I interpreter parity (resource ownership): MirLowering
                # (shared by every backend, see 50.mir/mir_lowering_stmts.spl
                # emit_drop/emit_pending_resource_drops) emits this at
                # implicit scope end, an explicit `return`, a `?` Err/None
                # early-return, and for a consuming `.close()` call. No
                # backend wires a real release extern yet -- that is WP-H,
                # still open -- so today this is a bare marker in EVERY
                # backend, not just here. Treating it as a no-op keeps this
                # interpreter able to execute any function WP-E's lowering
                # now emits Drop into, instead of erroring on the
                # `case _:` "unknown instruction" fallthrough below.
                nil

            case TransferOut(_, _, _, _, _, _):
                Some(InterpError.UnsupportedOperation(op: "transfer envelope"))
            case TransferIn(_, _, _, _):
                Some(InterpError.UnsupportedOperation(op: "transfer receipt"))
            case FreezeRegion(_):
                Some(InterpError.UnsupportedOperation(op: "freeze region"))
            case AcquireSnapshot(_, _):
                Some(InterpError.UnsupportedOperation(op: "snapshot"))
            case CommitUpdates(_, _, _):
                Some(InterpError.UnsupportedOperation(op: "parent commit"))

            case CheckedBinOp(dest, op, left, right):
                # Miri-mode: real overflow checking under SIMPLE_STRICT_INTERP;
                # default (unset) behavior unchanged (same as plain BinOp).
                if self.strict_mode:
                    self._execute_checked_binop(inst.span, dest, op, left, right)
                else:
                    self.execute_binop(dest, op, left, right)

            case _:
                Some(InterpError.UnsupportedOperation(op: "unknown instruction"))

    # ========================================================================
    # Helper Methods
    # ========================================================================

    me execute_const(dest: LocalId, value: MirConstValue):
        """Execute constant load."""
        # Hot path first: scalar constants take the same three arms as before,
        # with zero extra work. Only complex constants fall to _eval_const.
        val val_int = match value:
            case Int(v): v
            case Float(v): f64_to_bits(v)
            case Bool(v): if v: 1 else: 0
            case _: self._eval_const(value)
        self.set_local(dest, val_int)

    me _eval_const(value: MirConstValue) -> i64:
        """Recursively evaluate a constant, storing complex values in tables.

        Strings register in string_table under a stable negative id
        (readable back via get_const_string). Array/Tuple/Struct constants
        materialize as aggregates using the same base-address + slot-per-8
        layout Aggregate/GetField/GetElementPtr already use, so indexed
        reads on them just work.
        """
        match value:
            case Int(v): v
            case Float(v): f64_to_bits(v)
            case Bool(v): if v: 1 else: 0
            case Str(v): self._store_string(v)
            case Array(elements): self._store_const_aggregate(elements)
            case Tuple(elements): self._store_const_aggregate(elements)
            case Struct(fields):
                # Field order follows keys() order, matching GetField's
                # positional field*8 offsets for lowered struct reads.
                var elems: [MirConstValue] = []
                for key in fields.keys():
                    elems.push(fields[key])
                self._store_const_aggregate(elems)
            case Zero: 0
            case _: 0

    me _store_const_aggregate(elements: [MirConstValue]) -> i64:
        """Materialize a constant aggregate; returns its base address."""
        val base_addr = self.next_aggregate_id
        val count = elements.len()
        self.next_aggregate_id = self.next_aggregate_id + (count * 8) + 8
        var i = 0
        for elem in elements:
            val elem_val = self._eval_const(elem)
            val slot = LocalId(id: base_addr + (i * 8))
            self.set_local(slot, elem_val)
            i = i + 1
        self.aggregate_sizes[base_addr] = count
        base_addr

    me _store_string(s: text) -> i64:
        """Register a string constant; returns its stable (negative) id.

        Ids grow downward from -1 so they can never collide with aggregate
        base addresses (>= 100000) or small scalar values used as truthy
        pointers elsewhere.
        """
        val id = self.next_string_id
        self.next_string_id = self.next_string_id - 1
        self.string_table[id] = s
        id

    fn get_const_string(id: i64) -> text?:
        """Look up a registered string constant by its id."""
        if self.string_table.contains(id):
            Some(self.string_table[id])
        else:
            nil

    me execute_binop(dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand) -> InterpError?:
        """Evaluate binary operation."""
        val l = self.get_operand(left)
        val r = self.get_operand(right)

        val result = match op:
            case Add: l + r
            case Sub: l - r
            case Mul: l * r
            case Div:
                if r == 0:
                    return Some(InterpError.DivisionByZero(message: "Integer division"))
                l / r
            case Rem:
                if r == 0:
                    return Some(InterpError.DivisionByZero(message: "Integer modulo"))
                l % r
            case Pow: l ** r
            case MatMul:
                # Stub: Matrix multiplication needs runtime support
                0
            case Eq: if l == r: 1 else: 0
            case Ne: if l != r: 1 else: 0
            case Lt: if l < r: 1 else: 0
            case Le: if l <= r: 1 else: 0
            case Gt: if l > r: 1 else: 0
            case Ge: if l >= r: 1 else: 0
            case BitAnd: l & r
            case BitOr: l | r
            case BitXor: l xor r
            case Shl: l << (r & 63)  # Mask to avoid overflow
            case Shr: l >> (r & 63)
            case BroadcastAdd: l + r  # Stub: Broadcast needs tensor support
            case BroadcastSub: l - r
            case BroadcastMul: l * r
            case BroadcastDiv: if r != 0: l / r else: 0
            case BroadcastPow: l ** r
            case Offset: l + r
            case _:
                return Some(InterpError.UnsupportedOperation(op: "unknown binop"))

        self.set_local(dest, result)
        nil

    me _execute_checked_binop(span: Span?, dest: LocalId, op: MirBinOp, left: MirOperand, right: MirOperand) -> InterpError?:
        """Miri-mode: real i64 overflow detection for Add/Sub/Mul under
        SIMPLE_STRICT_INTERP. Every other op falls back to plain execute_binop
        (unchecked, same as default). Too expensive to run unconditionally,
        hence the env-var gate — see MirInterpreter.strict_mode."""
        val i64_min = -9223372036854775808
        match op:
            case Add:
                val l = self.get_operand(left)
                val r = self.get_operand(right)
                val result = l + r
                val overflowed = (l > 0 and r > 0 and result <= 0) or (l < 0 and r < 0 and result >= 0)
                if overflowed:
                    print "PANIC: strict-interp integer-overflow: {l} + {r} overflows i64, at {self._format_span(span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:integer-overflow Add {l} + {r} at {self._format_span(span)}"))
                self.set_local(dest, result)
                nil
            case Sub:
                val l = self.get_operand(left)
                val r = self.get_operand(right)
                val result = l - r
                val overflowed = (l >= 0 and r < 0 and result < 0) or (l < 0 and r > 0 and result >= 0)
                if overflowed:
                    print "PANIC: strict-interp integer-overflow: {l} - {r} overflows i64, at {self._format_span(span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:integer-overflow Sub {l} - {r} at {self._format_span(span)}"))
                self.set_local(dest, result)
                nil
            case Mul:
                val l = self.get_operand(left)
                val r = self.get_operand(right)
                val edge_overflow = (l == -1 and r == i64_min) or (r == -1 and l == i64_min)
                if edge_overflow:
                    print "PANIC: strict-interp integer-overflow: {l} * {r} overflows i64, at {self._format_span(span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:integer-overflow Mul {l} * {r} at {self._format_span(span)}"))
                val result = l * r
                val overflowed = l != 0 and (result / l != r)
                if overflowed:
                    print "PANIC: strict-interp integer-overflow: {l} * {r} overflows i64, at {self._format_span(span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:integer-overflow Mul {l} * {r} at {self._format_span(span)}"))
                self.set_local(dest, result)
                nil
            case _:
                self.execute_binop(dest, op, left, right)

    me execute_unaryop(dest: LocalId, op: MirUnaryOp, operand: MirOperand) -> InterpError?:
        """Evaluate unary operation."""
        val v = self.get_operand(operand)

        val result = match op:
            case Neg: -v
            case Not: if v == 0: 1 else: 0
            case BitNot: ~v
            case Transpose:
                # Stub: Transpose needs matrix support
                v

        self.set_local(dest, result)
        nil

    # ========================================================================
    # Call Support
    # ========================================================================

    me _take_frame_locals() -> {i64: i64}:
        """Take a locals dict for an inner call frame: pooled (cleared) or fresh."""
        val n = self.frame_locals_pool.len()
        if n == 0:
            return {}
        var d = self.frame_locals_pool[n - 1]
        self.frame_locals_pool.pop()
        # Clear-on-reuse: without this, a previous callee's locals leak into
        # the next call (undefined locals must stay fail-closed at -1).
        d.clear()
        d

    me _take_frame_blocks() -> {i64: MirBlock}:
        """Take a blocks dict for an inner call frame: pooled (cleared) or fresh."""
        val n = self.frame_blocks_pool.len()
        if n == 0:
            return {}
        var d = self.frame_blocks_pool[n - 1]
        self.frame_blocks_pool.pop()
        d.clear()
        d

    me _release_frame_dicts(locals_dict: {i64: i64}, blocks_dict: {i64: MirBlock}):
        """Return a finished inner frame's dicts to the bounded pool (max 8 each).
        Pool exhaustion is safe: over-limit dicts are simply dropped."""
        if self.frame_locals_pool.len() < 8:
            self.frame_locals_pool.push(locals_dict)
        if self.frame_blocks_pool.len() < 8:
            self.frame_blocks_pool.push(blocks_dict)

    me _call_function(callee: MirFunction, args: [MirOperand]) -> (i64?, InterpError?):
        """Call a function by saving state, executing, and restoring."""
        # Evaluate arguments before saving state
        var arg_values: [i64] = []
        for arg in args:
            val v = self.get_operand(arg)
            arg_values.push(v)

        # Save current state to call stack
        val frame = CallFrame(
            function_name: self.current_function,
            locals: self.locals,
            current_block: self.current_block,
            previous_block: self.previous_block,
            return_value: self.return_value,
            has_returned: self.has_returned,
            blocks: self.blocks
        )
        self.call_stack.push(frame)
        self.current_function = callee.name

        # Set up fresh state for callee (pooled dicts, cleared on reuse)
        self.locals = self._take_frame_locals()
        self.blocks = self._take_frame_blocks()
        self.has_returned = false
        self.return_value = nil
        self.previous_block = nil

        # Initialize callee blocks
        for block in callee.blocks:
            self.blocks[block.id.id] = block

        # Initialize callee locals and bind arguments in one pass (perf:
        # avoids a second dict write per Arg local; same resulting state).
        for local in callee.locals:
            var init_val: i64 = 0
            match local.kind:
                case Arg(index):
                    if index < arg_values.len():
                        init_val = arg_values[index]
                case _: pass
            self.locals[local.id.id] = init_val

        # Start at entry block
        self.current_block = Some(callee.entry_block.id)

        # Execute blocks until return
        # NOTE: driven by an explicit `match self.current_block` (not
        # `while self.current_block.?:`) -- block id 0 is the conventional
        # entry-block id, and `.?` truthiness on a boxed `i64?` collapses
        # `Some(0)` to falsy in the bootstrap seed interpreter (same class
        # of bug as the landed var_reassign_written_local fix), which would
        # make this loop exit immediately whenever the current block is 0.
        var max_iter = 10000
        var has_block = true
        while has_block and not self.has_returned and max_iter > 0:
            match self.current_block:
                case Some(block_id):
                    val block = self.blocks[block_id]

                    for inst in block.instructions:
                        val error = self.execute_instruction(inst)
                        if error.?:
                            # Restore state on error -- but capture the frame
                            # name FIRST; the pop destroys it.
                            self._record_error_frame()
                            self._pop_call_stack()
                            return (nil, error)
                        if self.has_returned:
                            break

                    if not self.has_returned:
                        val error = self.execute_terminator(block.terminator)
                        if error.?:
                            self._record_error_frame()
                            self._pop_call_stack()
                            return (nil, error)

                    max_iter = max_iter - 1
                case nil:
                    has_block = false

        if max_iter == 0:
            self._record_error_frame()
            self._pop_call_stack()
            return (nil, Some(InterpError.RuntimeError(message: "Infinite loop in called function")))

        # Capture return value
        val ret_val = self.return_value

        # Restore caller state from call stack
        self._pop_call_stack()

        (ret_val, nil)

    me _pop_call_stack():
        """Pop the top frame from call stack and restore state."""
        val stack_len = self.call_stack.len()
        if stack_len > 0:
            # Recycle the finished callee's dicts (self.locals/self.blocks are
            # the callee's here; the caller's are restored from the frame below,
            # so top-level execute_function state is never pooled).
            self._release_frame_dicts(self.locals, self.blocks)
            val frame = self.call_stack[stack_len - 1]
            self.current_function = frame.function_name
            self.locals = frame.locals
            self.current_block = frame.current_block
            self.previous_block = frame.previous_block
            self.return_value = frame.return_value
            self.has_returned = frame.has_returned
            self.blocks = frame.blocks
            self.call_stack.pop()

    me set_previous_block_for_phi(block_id: i64):
        """Set predecessor metadata for testing/interpreter pseudo-phi fallback."""
        self.previous_block = Some(block_id)

    me _execute_intrinsic(name: text, args: [MirOperand]) -> i64:
        """Execute a built-in intrinsic by name and return result."""
        match name:
            case "__simple_ssa_phi":
                # Pseudo-phi args are either plain values or predecessor/value pairs.
                if args.len() >= 4:
                    # NOTE: explicit match, not `if self.previous_block.?:` --
                    # predecessor block id 0 landmine, see the entry-block
                    # loop note above. A falsy collapse here silently drops
                    # straight to the arg[1] fallback value instead of the
                    # value actually paired with predecessor block 0.
                    match self.previous_block:
                        case Some(pred):
                            var i = 0
                            while i + 1 < args.len():
                                if self.get_operand(args[i]) == pred:
                                    return self.get_operand(args[i + 1])
                                i = i + 2
                        case nil:
                            pass_do_nothing
                    self.get_operand(args[1])
                elif args.len() > 0:
                    self.get_operand(args[0])
                else:
                    0
            case "print":
                if args.len() > 0:
                    val v = self.get_operand(args[0])
                    print "{v}"
                0
            case "println":
                if args.len() > 0:
                    val v = self.get_operand(args[0])
                    print "{v}"
                else:
                    print ""
                0
            case "len":
                if args.len() > 0:
                    val v = self.get_operand(args[0])
                    v  # Length stored as value
                else:
                    0
            case "sizeof":
                if args.len() > 0:
                    8  # Default word size
                else:
                    0
            case "typeof":
                0  # Type info not available at interpreter level
            case "abort":
                0  # Abort is handled as error elsewhere
            case "min":
                if args.len() >= 2:
                    val a = self.get_operand(args[0])
                    val b = self.get_operand(args[1])
                    if a < b: a else: b
                else:
                    0
            case "max":
                if args.len() >= 2:
                    val a = self.get_operand(args[0])
                    val b = self.get_operand(args[1])
                    if a > b: a else: b
                else:
                    0
            case "abs":
                if args.len() > 0:
                    val v = self.get_operand(args[0])
                    if v < 0: -v else: v
                else:
                    0
            # NOTE: "bounds_check" is intercepted in execute_instruction's
            # Intrinsic case (_execute_bounds_check) so OOB traps loudly
            # instead of returning a value lowering may discard.
            case _:
                # Unknown intrinsic - return 0
                0

    me _execute_bounds_check(dest: LocalId?, args: [MirOperand]) -> InterpError?:
        """Loud OOB trap — parity with runtime.c __simple_intrinsic_bounds_check
        (PANIC + exit(1)) and the tree-walk interpreter's index checks."""
        if args.len() < 2:
            print "PANIC: bounds_check intrinsic malformed (got {args.len()} args, need 2)"
            return Some(InterpError.RuntimeError(message: "bounds_check intrinsic malformed: {args.len()} args"))
        val index = self.get_operand(args[0])
        val len = self.get_operand(args[1])
        if index < 0 or index >= len:
            print "PANIC: bounds_check intrinsic index={index} len={len}"
            return Some(InterpError.OutOfBounds(index: index, size: len))
        if dest.?:
            self.set_local(dest.unwrap(), 0)
        nil

    # ========================================================================
    # Function Execution
    # ========================================================================

    me execute_function(func: MirFunction) -> (i64?, InterpError?):
        """Execute a MIR function and return result."""
        if self.debug_enabled:
            debug("interp", "Executing function: {func.name} ({func.blocks.len()} blocks, {func.locals.len()} locals)")
        self.current_function = func.name
        self.error_frames = []
        # Initialize blocks
        for block in func.blocks:
            self.blocks[block.id.id] = block

        # Initialize locals
        for local in func.locals:
            self.locals[local.id.id] = 0

        # Start at entry block
        self.current_block = Some(func.entry_block.id)
        self.previous_block = nil
        self.has_returned = false
        self.return_value = nil

        # Execute blocks until return
        var max_iterations = 10000  # Prevent infinite loops
        while self.current_block.? and not self.has_returned and max_iterations > 0:
            val block_id = self.current_block.unwrap()
            val block = self.blocks[block_id]

            # Execute all instructions in block
            for inst in block.instructions:
                val error = self.execute_instruction(inst)
                if error.?:
                    self._record_error_frame()
                    return (nil, error)
                if self.has_returned:
                    break

            # Execute terminator if not returned
            if not self.has_returned:
                val error = self.execute_terminator(block.terminator)
                if error.?:
                    self._record_error_frame()
                    return (nil, error)

            max_iterations = max_iterations - 1

        if max_iterations == 0:
            if self.debug_enabled:
                debug("interp", "Infinite loop detected in function: {func.name}")
            self._record_error_frame()
            return (nil, Some(InterpError.RuntimeError(message: "Infinite loop detected")))

        # Return value from return instruction
        (self.return_value, nil)

    me execute_terminator(term: MirTerminator) -> InterpError?:
        """Execute a block terminator."""
        match term:
            case Goto(target):
                self.previous_block = self.current_block
                self.current_block = Some(target.id)
                nil

            case Ret(value):
                if value.?:
                    self.return_value = Some(self.get_operand(value.unwrap()))
                else:
                    self.return_value = Some(0)
                self.has_returned = true
                self.current_block = nil
                nil

            case If(cond, then_, else_):
                val cond_val = self.get_operand(cond)
                self.previous_block = self.current_block
                self.current_block = Some(if cond_val != 0: then_.id else: else_.id)
                nil

            case Switch(value, targets, default):
                val v = self.get_operand(value)
                var target = default.id
                for case_ in targets:
                    if v == case_.value:
                        target = case_.target.id
                        break
                self.previous_block = self.current_block
                self.current_block = Some(target)
                nil

            case Unreachable:
                self.has_returned = true
                Some(InterpError.RuntimeError(message: "Unreachable code executed"))

            case Abort(message):
                self.has_returned = true
                Some(InterpError.RuntimeError(message: "Abort: {message}"))

            case CallTerminator(dest, call_target, args, normal, unwind):
                val func_name = _extract_func_name(call_target)
                if func_name.?:
                    val name = func_name.unwrap()
                    val callee_opt = self._resolve_function(name)
                    if callee_opt.?:
                        val callee = callee_opt.unwrap()
                        val call_result = self._call_function(callee, args)
                        if call_result[1].?:
                            # Error during call - jump to unwind if available
                            if unwind.?:
                                self.previous_block = self.current_block
                                self.current_block = Some(unwind.unwrap().id)
                                return nil
                            return call_result[1]
                        if dest.?:
                            val ret = call_result[0] ?? 0
                            self.set_local(dest.unwrap(), ret)
                    else:
                        if dest.?:
                            self.set_local(dest.unwrap(), 0)
                else:
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                self.previous_block = self.current_block
                self.current_block = Some(normal.id)
                nil

# Helper functions (f64_to_bits, f64_from_bits, _extract_func_name) moved to
# mir_interp_runtime.spl and re-exported at the top of this file.
