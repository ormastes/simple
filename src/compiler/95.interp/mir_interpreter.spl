# MIR Interpreter
#
# Pure interpreter backend for MIR execution without native compilation.
# Evaluates MIR instructions directly using virtual register mapping.
#
# This enables:
# - Self-hosting (no SFFI dependencies)
# - Debugging (compare interpreter vs native results)
# - Portable execution (no Cranelift/LLVM needed)
# - Fast iteration (no compilation overhead)
#
# Architecture:
#   MIR Instructions -> Direct Evaluation -> RuntimeValue
#
# Port of rust/compiler/src/codegen/mir_interpreter.rs (1,058 lines)

use std.log.{debug, log_get_level, LOG_DEBUG}
use compiler.mir.mir_data.*
use compiler.interp.execir.{ExecIrModule, ExecIrArenaCtx, execir_encode_call, execir_binop_code}
use compiler.common.diagnostics.span.{Span}
extern fn rt_enum_discriminant(value: Any) -> i64

# Cohesion split (2026-08-18): class-independent pieces live in sibling
# modules; re-exported here so the public surface of this module is unchanged.
export use compiler.interp.mir_interp_error.{InterpError, CallFrame}
export use compiler.interp.mir_interp_runtime.{mir_interp_call_runtime_fn, f64_to_bits, f64_from_bits, _extract_func_name}

# Miri-mode: dynamic UB checks too expensive for normal runs, gated behind
# SIMPLE_STRICT_INTERP=1 so default interpreter perf/behavior is untouched.
# Read once at interpreter creation (see MirInterpreter.strict_mode).
extern fn rt_env_get(key: text) -> text
extern fn rt_mcdc_record_compiled_vector_v1(decision_id: u64,
                                             condition_count: u32,
                                             source_digest: u64,
                                             evaluated_mask: u64,
                                             true_mask: u64,
                                             outcome: u8) -> i32


# ============================================================================
# MIR Interpreter
# ============================================================================

class MirInterpreter:
    """
    MIR instruction interpreter.

    Maintains runtime state:
    - locals: Local variable values (LocalId -> i64)
    - globals: Global variable storage (name -> i64)
    - blocks: Basic block map (BlockId -> MirBlock)
    - current_block: Currently executing block
    - return_value: Return value from function
    """
    locals: {i64: i64}       # LocalId.id -> value
    globals: {text: i64}     # Global name -> value
    blocks: {i64: MirBlock}  # BlockId.id -> block
    current_block: i64?      # Current block ID
    previous_block: i64?     # Last block ID before the current block
    return_value: i64?       # Return value
    has_returned: bool       # Whether function has returned
    function_table: {text: MirFunction}  # Function name -> MirFunction
    call_stack: [CallFrame]  # Stack of saved frames for nested calls
    next_aggregate_id: i64   # Counter for aggregate base addresses
    aggregate_sizes: {i64: i64}  # Aggregate base address -> element count
    string_table: {i64: text}
    last_error: InterpError?  # Lane C8: deferred diagnostic from i64-returning helpers (const/intrinsic)
    next_string_id: i64
    strict_mode: bool       # Miri-mode: SIMPLE_STRICT_INTERP=1, read once at create()
    current_function: text  # Name of the function currently executing
    error_frames: [text]    # Innermost-first frame names captured when an error escapes
    # Perf (Phase D): log-facade debug() costs an rt_env_get + string compares
    # per call even when the level gate rejects it. Cache the verdict once at
    # create() (level-gated, default off) instead of paying the facade on the
    # execute_function hot path. Toggle via set_debug_log_enabled for tests.
    debug_enabled: bool
    # Perf (Phase D): repeated direct calls to the same callee re-do a
    # contains() + [] pair on function_table per call. Cache the last
    # resolved (name, function). Invalidated by set_function_table.
    cached_call_name: text
    cached_call_fn: MirFunction?
    # Perf (frame pool): bounded reuse of INNER-call frame dicts only. The
    # top-level locals/blocks set up by execute_function are never pooled --
    # complex-const behavior relies on top-level locals persisting across
    # execute_function calls on one instance. Dicts are cleared ON REUSE
    # (in _take_*) so no value can leak between sibling or successive calls.
    frame_locals_pool: [{i64: i64}]
    frame_blocks_pool: [{i64: MirBlock}]
    # ExecIR tier-0.5 (Phase E): memoized flat-code fast path. Keyed by a
    # shallow fingerprint (name + shape + entry-block kind/const fold) so two
    # same-name same-shape functions with different consts never collide.
    # Verdict 1 = encodable (module+arena present), 0 = memoized nil (probe
    # once, then always tree-walk). Arena is created ONCE per module and
    # reused across runs (memory efficiency). Kill switch: SIMPLE_EXECIR=0.
    execir_enabled: bool
    execir_modules: {text: ExecIrModule}
    execir_arenas: {text: ExecIrArenaCtx}
    execir_verdicts: {text: i64}
    execir_probe_count: i64

impl MirInterpreter:
    static fn create() -> MirInterpreter:
        """Create a new interpreter instance."""
        # Level-gated (default off): read the log level ONCE here; the facade
        # itself costs an env read + string compares per call, too expensive
        # for the dispatch hot path.
        val dbg = log_get_level() <= LOG_DEBUG
        if dbg:
            debug("interp", "Creating MIR interpreter instance")
        MirInterpreter(
            locals: {},
            globals: {},
            blocks: {},
            current_block: nil,
            previous_block: nil,
            return_value: nil,
            has_returned: false,
            function_table: {},
            call_stack: [],
            next_aggregate_id: 100000,
            aggregate_sizes: {},
            string_table: {},
            last_error: nil,
            next_string_id: -1,
            # Read once at startup so default (unset) perf/behavior is untouched;
            # never re-read per instruction.
            strict_mode: (rt_env_get("SIMPLE_STRICT_INTERP") ?? "") == "1",
            current_function: "<toplevel>",
            error_frames: [],
            debug_enabled: dbg,
            cached_call_name: "",
            cached_call_fn: nil,
            frame_locals_pool: [],
            frame_blocks_pool: [],
            # Read once at startup (default ON); never re-read per call.
            execir_enabled: (rt_env_get("SIMPLE_EXECIR") ?? "") != "0",
            execir_modules: {},
            execir_arenas: {},
            execir_verdicts: {},
            execir_probe_count: 0
        )

    fn execir_memo_size() -> i64:
        """Number of memoized ExecIR verdicts (encodable AND nil)."""
        self.execir_verdicts.len()

    fn execir_probe_count_value() -> i64:
        """Number of encode attempts actually performed (memo misses)."""
        self.execir_probe_count

    fn is_debug_log_enabled() -> bool:
        """Accessor: is per-run debug logging active? Cached once at create."""
        self.debug_enabled

    me set_debug_log_enabled(on: bool):
        """Enable/disable the cached debug-log gate (observability only --
        never affects execution semantics)."""
        self.debug_enabled = on

    me _record_error_frame():
        """Record the currently-executing function as an unwound error frame.

        Called on every error-return path BEFORE the frame is popped -- popping
        restores caller state and destroys the evidence, which is exactly why
        the frame stack existed but no trace was ever printable.
        """
        self.error_frames.push(self.current_function)

    me call_stack_trace() -> text:
        """Render the captured error frames as a `Call stack:` section.

        Empty string when no error has unwound, so callers can append it
        unconditionally without emitting a bare header.
        """
        if self.error_frames.len() == 0:
            return ""
        var out = "Call stack:"
        var i = 0
        while i < self.error_frames.len():
            out = out + "\n  #{i} {self.error_frames[i]}"
            i = i + 1
        out

    me format_error(err: InterpError) -> text:
        """Format a runtime error together with its call stack section."""
        val msg = err.message()
        # InterpError.RuntimeError already carries the "Runtime error: " prefix;
        # every other variant does not. Prefix only when it is missing so the
        # header appears exactly once.
        var head = msg
        if not msg.starts_with("Runtime error"):
            head = "Runtime error: {msg}"
        val trace = self.call_stack_trace()
        if trace == "":
            return head
        "{head}\n{trace}"

    # ========================================================================
    # Value Management
    # ========================================================================

    me set_local(dest: LocalId, value: i64):
        """Store a value in a local variable."""
        self.locals[dest.id] = value

    fn get_local(local: LocalId) -> i64:
        """Get a value from a local variable (0 if not set)."""
        # ponytail: undefined locals fail closed instead of masquerading as zero.
        self.locals[local.id] ?? -1

    fn is_local_set(local: LocalId) -> bool:
        """Miri-mode helper: has this local ever been written?"""
        self.locals.contains(local.id)

    fn _format_span(span: Span?) -> text:
        """Miri-mode helper: render a source span for a loud diagnostic, or
        'unknown location' when the instruction carries no span."""
        if span.?:
            val sp = span.unwrap()
            "{sp.file}:{sp.line}:{sp.col}"
        else:
            "unknown location"

    fn get_operand(operand: MirOperand) -> i64:
        """Evaluate an operand to get its value."""
        match operand.kind:
            case Copy(local): self.get_local(local)
            case Move(local): self.get_local(local)
            case Const(value, type_):
                match value:
                    case Int(v): v
                    case Float(v): f64_to_bits(v)
                    case Bool(v): if v: 1 else: 0
                    case _: self._eval_const(value)  # Lane C8: aggregates/strings materialise like execute_const (was a silent 0)

    me set_function_table(table: {text: MirFunction}):
        """Set the function table for cross-function calls."""
        if self.debug_enabled:
            debug("interp", "Setting function table ({table.keys().len()} functions)")
        self.function_table = table
        # Invalidate the direct-call cache: entries may have changed.
        self.cached_call_name = ""
        self.cached_call_fn = nil
        # Invalidate the ExecIR memo: encoded CALL targets bind to a table
        # snapshot, so a new table must force re-probe.
        self.execir_modules = {}
        self.execir_arenas = {}
        self.execir_verdicts = {}

    me _resolve_function(name: text) -> MirFunction?:
        """Resolve a callee by name with a one-entry cache for repeated
        direct calls (hot in call-heavy loops). Semantics identical to
        contains()+[] on function_table; cache invalidated whenever the
        table is replaced (set_function_table)."""
        if name == self.cached_call_name and self.cached_call_fn.?:
            return self.cached_call_fn
        if self.function_table.contains(name):
            val f = self.function_table[name]
            self.cached_call_name = name
            self.cached_call_fn = Some(f)
            return Some(f)
        nil

    # ========================================================================
    # Instruction Execution
    # ========================================================================

    me execute_instruction(inst: MirInst) -> InterpError?:
        """Execute a single MIR instruction."""
        match inst.kind:
            case Const(dest, value, type_):
                self.execute_const(dest, value)
                val const_err = self.last_error
                self.last_error = nil
                const_err

            case Copy(dest, src):
                if self.strict_mode and not self.is_local_set(src):
                    print "PANIC: strict-interp uninitialized-local-read: Copy reads v{src.id} before any write, at {self._format_span(inst.span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:uninitialized-local-read Copy v{src.id} at {self._format_span(inst.span)}"))
                val value = self.get_local(src)
                self.set_local(dest, value)
                nil

            case Move(dest, src):
                if self.strict_mode and not self.is_local_set(src):
                    print "PANIC: strict-interp uninitialized-local-read: Move reads v{src.id} before any write, at {self._format_span(inst.span)}"
                    return Some(InterpError.RuntimeError(message: "strict-interp:uninitialized-local-read Move v{src.id} at {self._format_span(inst.span)}"))
                val value = self.get_local(src)
                self.set_local(dest, value)
                # Note: Move semantics not enforced in interpreter
                nil

            case BinOp(dest, op, left, right):
                self.execute_binop(dest, op, left, right)

            case UnaryOp(dest, op, operand):
                self.execute_unaryop(dest, op, operand)

            case Cast(dest, operand, target):
                val value = self.get_operand(operand)
                # Simple cast - just copy value for now
                self.set_local(dest, value)
                nil

            case Bitcast(dest, operand, target):
                val value = self.get_operand(operand)
                self.set_local(dest, value)
                nil

            case Load(dest, ptr):
                val addr = self.get_operand(ptr)
                # Interpret addr as local ID for now
                val local_id = LocalId(id: addr)
                val value = self.get_local(local_id)
                self.set_local(dest, value)
                nil

            case Store(ptr, value):
                val addr = self.get_operand(ptr)
                val val_to_store = self.get_operand(value)
                val local_id = LocalId(id: addr)
                self.set_local(local_id, val_to_store)
                nil

            case Alloc(dest, type_):
                # Allocate local storage - return local ID
                self.set_local(dest, dest.id)
                nil

            case GetElementPtr(dest, base, indices):
                val base_val = self.get_operand(base)
                var offset = base_val
                for idx in indices:
                    val idx_val = self.get_operand(idx)
                    offset = offset + (idx_val * 8)
                self.set_local(dest, offset)
                nil

            case Aggregate(dest, kind, operands):
                # Allocate a base address for the aggregate
                val base_addr = self.next_aggregate_id
                self.next_aggregate_id = self.next_aggregate_id + (operands.len() * 8) + 8
                # Store each element at base + index * 8
                var i = 0
                for op in operands:
                    val elem_val = self.get_operand(op)
                    val slot = LocalId(id: base_addr + (i * 8))
                    self.set_local(slot, elem_val)
                    i = i + 1
                # dest holds the base address
                self.set_local(dest, base_addr)
                nil

            case GetField(dest, base, field):
                val base_val = self.get_operand(base)
                # Read value from base_address + field_offset
                val field_addr = base_val + (field * 8)
                val slot = LocalId(id: field_addr)
                val field_val = self.get_local(slot)
                self.set_local(dest, field_val)
                nil

            case SetField(base, field, value):
                val base_val = self.get_operand(base)
                val val_to_set = self.get_operand(value)
                val field_addr = base_val + (field * 8)
                val slot = LocalId(id: field_addr)
                self.set_local(slot, val_to_set)
                nil

            case Call(dest, call_target, args):
                val func_name = _extract_func_name(call_target)
                if func_name.?:
                    val name = func_name.unwrap()
                    val callee_opt = self._resolve_function(name)
                    if callee_opt.?:
                        val callee = callee_opt.unwrap()
                        val call_result = self._call_function(callee, args)
                        if call_result[1].?:
                            return call_result[1]
                        if dest.?:
                            val ret = call_result[0] ?? 0
                            self.set_local(dest.unwrap(), ret)
                    else:
                        # Unknown function - set dest to 0
                        if dest.?:
                            self.set_local(dest.unwrap(), 0)
                else:
                    # Cannot resolve function name
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                nil

            case CallIndirect(dest, ptr, args, sig):
                # Try to resolve function pointer as a named function
                val func_name = _extract_func_name(ptr)
                if func_name.?:
                    val name = func_name.unwrap()
                    val callee_opt = self._resolve_function(name)
                    if callee_opt.?:
                        val callee = callee_opt.unwrap()
                        val call_result = self._call_function(callee, args)
                        if call_result[1].?:
                            return call_result[1]
                        if dest.?:
                            val ret = call_result[0] ?? 0
                            self.set_local(dest.unwrap(), ret)
                    else:
                        if dest.?:
                            self.set_local(dest.unwrap(), 0)
                else:
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                nil

            case Intrinsic(dest, name, args):
                # bounds_check must trap loudly, mirroring the native path
                # (__simple_intrinsic_bounds_check in runtime.c: PANIC + exit).
                # Handled here (not in _execute_intrinsic) because lowering may
                # discard the dest, so a returned value would be silently lost.
                if name == "bounds_check":
                    return self._execute_bounds_check(dest, args)
                # abort as an *instruction* was a silent 0-return no-op; the
                # Abort terminator already errors — keep instruction parity.
                if name == "abort":
                    print "PANIC: abort intrinsic executed"
                    return Some(InterpError.RuntimeError(message: "Abort intrinsic executed"))
                # `assert COND[, MSG]` desugars to __assert(...) in
                # parser_stmts.spl. Handled here, not in _execute_intrinsic, for
                # the same reason as bounds_check: lowering may discard dest, so
                # a returned value would be silently lost — which is exactly the
                # failure mode that made every bare `assert` a no-op.
                if name == "__assert":
                    if args.len() < 1:
                        return Some(InterpError.RuntimeError(message: "__assert intrinsic malformed: 0 args"))
                    if self.get_operand(args[0]) == 0:
                        print "PANIC: assertion failed"
                        return Some(InterpError.RuntimeError(message: "assertion failed"))
                    if dest.?:
                        self.set_local(dest.unwrap(), 0)
                    return nil
                val result = self._execute_intrinsic(name, args)
                if dest.?:
                    self.set_local(dest.unwrap(), result)
                val intrinsic_err = self.last_error
                self.last_error = nil
                intrinsic_err

            case DecisionProbe(runtime_id, semantic_id, source_digest, condition_count,
                               evaluated_mask, true_mask, result, _, _, _):
                val status = rt_mcdc_record_compiled_vector_v1(
                    runtime_id as u64, condition_count as u32,
                    source_digest as u64,
                    self.get_operand(evaluated_mask) as u64,
                    self.get_operand(true_mask) as u64,
                    if self.get_operand(result) != 0: 1u8 else: 0u8)
                if status == 0:
                    nil
                else:
                    Some(InterpError.RuntimeError(
                        message: "DecisionProbe '{semantic_id}' runtime status {status}"))

            case ConditionProbe(_, semantic_id, _, _, _, _, _, _):
                Some(InterpError.UnsupportedOperation(
                    op: "unlowered ConditionProbe '{semantic_id}'"
                ))

            case DynamicDecisionProbe(_, semantic_id, _, _, _, _, _, _, _, _):
                Some(InterpError.UnsupportedOperation(
                    op: "unlowered DynamicDecisionProbe '{semantic_id}'"
                ))

            case DynamicConditionProbe(_, semantic_id, _, _, _, _, _, _):
                Some(InterpError.UnsupportedOperation(
                    op: "unlowered DynamicConditionProbe '{semantic_id}'"
                ))

            case PipeForward(dest, value, _func):
                # Stub: Pipeline operators need runtime support
                val val_res = self.get_operand(value)
                self.set_local(dest, val_res)
                nil

            case Compose(dest, f, g, forward):
                # Stub: Function composition
                self.set_local(dest, 0)
                nil

            case Parallel(dest, funcs):
                # Stub: Parallel execution
                self.set_local(dest, 0)
                nil

            case LayerConnect(dest, layer1, layer2):
                # Stub: Neural network layers
                self.set_local(dest, 0)
                nil

            case CreatePromise(dest, body, result_type):
                # Mirrors LLVM: call ptr @__simple_runtime_create_promise(ptr null)
                val result = mir_interp_call_runtime_fn("__simple_runtime_create_promise", [0])
                self.set_local(dest, result)
                nil

            case Await(dest, promise):
                # Mirrors LLVM: call i64 @__simple_runtime_await(ptr promise)
                val prom_val = self.get_operand(promise)
                val result = mir_interp_call_runtime_fn("__simple_runtime_await", [prom_val])
                self.set_local(dest, result)
                nil

            case Yield(value):
                # Mirrors LLVM: call void @__simple_runtime_yield(i64 value)
                if value.?:
                    val val_int = self.get_operand(value.unwrap())
                    mir_interp_call_runtime_fn("__simple_runtime_yield", [val_int])
                else:
                    mir_interp_call_runtime_fn("__simple_runtime_yield", [0])
                nil

            case Spawn(dest, handler, args):
                # Mirrors LLVM: call ptr @__simple_runtime_spawn(ptr handler)
                val handler_val = self.get_operand(handler)
                val result = mir_interp_call_runtime_fn("__simple_runtime_spawn", [handler_val])
                self.set_local(dest, result)
                nil

            case Send(target, message):
                # Mirrors LLVM: call void @__simple_runtime_send(ptr target, i64 message)
                val target_val = self.get_operand(target)
                val msg_val = self.get_operand(message)
                mir_interp_call_runtime_fn("__simple_runtime_send", [target_val, msg_val])
                nil

            case Receive(dest, timeout):
                # Mirrors LLVM: call i64 @__simple_runtime_receive(i64 timeout)
                var timeout_val: i64 = -1
                if timeout.?:
                    timeout_val = self.get_operand(timeout.unwrap())
                val result = mir_interp_call_runtime_fn("__simple_runtime_receive", [timeout_val])
                self.set_local(dest, result)
                nil

            case Ref(dest, borrow_kind, place):
                # Borrow checking - return place address
                self.set_local(dest, place.local.id)
                nil

            case DebugValue(local, name):
                # Debug - no-op
                nil

            case Nop:
                # No-op
                nil

            case Drop(local):
                # WP-I interpreter parity (resource ownership): MirLowering
                # (shared by every backend, see 50.mir/mir_lowering_stmts.spl
                # emit_drop/emit_pending_resource_drops) emits this at
                # implicit scope end, an explicit `return`, a `?` Err/None
                # early-return, and for a consuming `.close()` call. No
                # backend wires a real release extern yet -- that is WP-H,
                # still open -- so today this is a bare marker in EVERY
                # backend, not just here. Treating it as a no-op keeps this
                # interpreter able to execute any function WP-E's lowering
                # now emits Drop into, instead of erroring on the
                # `case _:` "unknown instruction" fallthrough below.
                nil

            case TransferOut(_, _, _, _, _, _):
                self._unsupported_inst("TransferOut", inst.span)
            case TransferIn(_, _, _, _):
                self._unsupported_inst("TransferIn", inst.span)
            case FreezeRegion(_):
                self._unsupported_inst("FreezeRegion", inst.span)
            case AcquireSnapshot(_, _):
                self._unsupported_inst("AcquireSnapshot", inst.span)
            case CommitUpdates(_, _, _):
                self._unsupported_inst("CommitUpdates", inst.span)

            case CheckedBinOp(dest, op, left, right):
                # Miri-mode: real overflow checking under SIMPLE_STRICT_INTERP;
                # default (unset) behavior unchanged (same as plain BinOp).
                if self.strict_mode:
                    self._execute_checked_binop(inst.span, dest, op, left, right)
                else:
                    self.execute_binop(dest, op, left, right)

            # ----------------------------------------------------------------
            # Lane C8 (interpreter coverage, hardening plan 2026-08-21 sections
            # 11.3-11.6). Every remaining MirInstKind variant gets an EXPLICIT
            # arm, even the ones this interpreter does not execute. Before this
            # block all of them reached `case _:` and were reported as the
            # unnamed "unknown instruction" -- the operator learned that
            # SOMETHING was unsupported, not WHAT, and could not grep for it.
            # Each arm now raises a stable, spanned E-INTERP-INST-<Variant>.
            # Universe: spec/compiler_schema/registry/compiler.mir.MirInstKind.sdn;
            # table: spec/compiler_schema/transitions/mir_inst_to_interp.sdn.
            # ----------------------------------------------------------------
            case GpuAtomicCas(_, _, _, _):
                self._unsupported_inst("GpuAtomicCas", inst.span)
            case GpuAtomicOp(_, _, _, _):
                self._unsupported_inst("GpuAtomicOp", inst.span)
            case GpuBarrier(_):
                self._unsupported_inst("GpuBarrier", inst.span)
            case GpuBlockDim(_, _):
                self._unsupported_inst("GpuBlockDim", inst.span)
            case GpuBlockId(_, _):
                self._unsupported_inst("GpuBlockId", inst.span)
            case GpuGlobalId(_, _):
                self._unsupported_inst("GpuGlobalId", inst.span)
            case GpuGridDim(_, _):
                self._unsupported_inst("GpuGridDim", inst.span)
            case GpuKernelDef(_):
                self._unsupported_inst("GpuKernelDef", inst.span)
            case GpuLaunch(_):
                self._unsupported_inst("GpuLaunch", inst.span)
            case GpuLocalId(_, _):
                self._unsupported_inst("GpuLocalId", inst.span)
            case GpuMemFence(_):
                self._unsupported_inst("GpuMemFence", inst.span)
            case GpuSharedAlloc(_, _, _):
                self._unsupported_inst("GpuSharedAlloc", inst.span)
            case HostGpuLaneBegin(_, _):
                self._unsupported_inst("HostGpuLaneBegin", inst.span)
            case HostGpuLaneEnd(_):
                self._unsupported_inst("HostGpuLaneEnd", inst.span)
            case InlineAsm(_, _, _, _, _, _, _):
                self._unsupported_inst("InlineAsm", inst.span)
            case LoadGlobal(_, _):
                self._unsupported_inst("LoadGlobal", inst.span)
            case MaskedAdd(_, _, _, _):
                self._unsupported_inst("MaskedAdd", inst.span)
            case MaskedFma(_, _, _, _, _):
                self._unsupported_inst("MaskedFma", inst.span)
            case MaskedMul(_, _, _, _):
                self._unsupported_inst("MaskedMul", inst.span)
            case MaskFromCmp(_, _, _, _):
                self._unsupported_inst("MaskFromCmp", inst.span)
            case MirSimdBinop(_, _, _, _):
                self._unsupported_inst("MirSimdBinop", inst.span)
            case MirSimdCmp(_, _, _, _):
                self._unsupported_inst("MirSimdCmp", inst.span)
            case MirSimdGather(_, _, _, _):
                self._unsupported_inst("MirSimdGather", inst.span)
            case MirSimdLoad(_, _, _, _):
                self._unsupported_inst("MirSimdLoad", inst.span)
            case MirSimdMaskOp(_, _, _, _):
                self._unsupported_inst("MirSimdMaskOp", inst.span)
            case MirSimdPermute(_, _, _):
                self._unsupported_inst("MirSimdPermute", inst.span)
            case MirSimdReduce(_, _, _):
