            case MirSimdTernop(_, _, _, _, _):
                self._unsupported_inst("MirSimdTernop", inst.span)
            case MirSimdUnop(_, _, _):
                self._unsupported_inst("MirSimdUnop", inst.span)
            case MirWarpActivesMask(_):
                self._unsupported_inst("MirWarpActivesMask", inst.span)
            case MirWarpBallot(_, _, _):
                self._unsupported_inst("MirWarpBallot", inst.span)
            case MirWarpReduce(_, _, _, _):
