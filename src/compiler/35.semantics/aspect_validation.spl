# C3 `@advice(KIND, SELECTOR[, MODE])` production wiring: prove every
# source-level advice declaration against the join-point universe this
# compilation can actually SEE.
#
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (C3)
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (M5 = C3)
#
# THE GAP THIS CLOSES: this tree already had two AOP weavers
# (`70.backend/backend/interpreter_aop_weave.spl`,
# `50.mir/mir_aop_injection.spl`), but both target PHYSICAL functions. C3's
# defining claim is the opposite -- "a business-logic-free forwarder need not
# exist physically for advice to observe it" -- so neither could express a
# logical join point, and there was no attribute that even named one.
#
# Shape deliberately mirrors `layer_eq_validation.spl` (C1) and
# `effect_validation.spl` (C4): same `(modules) -> [text]` contract, same
# "return diagnostics, let the driver decide how to surface them" rule, same
# module-identity scoping, and it is invoked from the SAME driver hook so a new
# checker cannot quietly fail to be wired. There is exactly one such mechanism
# in this tree; a second would be the drift the C0-C5 plan warns about.
#
# HONEST SCOPE -- what this pass proves and what it refuses to claim:
#   PROVEN HERE, on real source, for every advice declaration:
#     * the join-point kind is one of C3's seven (a typo is an ERROR, never a
#       silently disabled aspect)
#     * a per-pixel / per-glyph / per-span / per-tile kind is REJECTED, with
#       the plan's prohibition as the stated reason
#     * the three advice obligations `@readonly @noalloc @bounded_time` are all
#       present (missing ones are named individually)
#     * the weave mode is known, and is `static` -- `dynload` and `live_reload`
#       are recognised and rejected as not-implemented, never downgraded
#     * for kind `forward`: the selector matches a real logical forward edge
#       enumerated from LOWERED HIR BODIES (join_point_model.forward_join_points).
#       An unmatched selector is an ERROR.
#   NOT proven, and explicitly reported as UNMEASURED rather than assumed:
#     * selectors on the other six kinds (`layer_view`, `scene_commit`,
#       `render_batch`, `event_route`, `fallback`, `frame`). Nothing on this
#       tree emits those join points, so a "no match" verdict there would be a
#       statement about the compiler, not about the source. Each one gets an
#       `error[aspect]: UNMEASURED` diagnostic carrying the blocker.
#     * the WEAVE itself. This pass validates and enumerates; it does not yet
#       rewrite anything. Zero-disabled-overhead static weaving, the sidecar
#       aspect state keyed by slot+generation, and the dynload/live-reload
#       modes are the remainder of M5 and are NOT claimed here.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.join_point_model.{JoinPoint}
use compiler.semantics.join_point_model.{join_point_kind_is_known, join_point_kind_is_prohibited}
use compiler.semantics.join_point_model.{join_point_kind_is_measurable, join_point_unmeasured_reason}
use compiler.semantics.join_point_model.{join_point_kinds, join_point_prohibited_kinds}
use compiler.semantics.join_point_model.{join_point_mode_is_known, join_point_mode_is_implemented}
use compiler.semantics.join_point_model.{join_point_modes}
use compiler.semantics.join_point_model.{forward_join_points, join_points_matching}
use compiler.frontend.aspect_registry.{aspect_registry_claim_keys, aspect_claim_path, aspect_claim_fn}
use compiler.frontend.aspect_registry.{aspect_registry_kind_of_key, aspect_registry_selector_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_mode_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_readonly_of_key, aspect_registry_noalloc_of_key}
use compiler.frontend.aspect_registry.{aspect_registry_bounded_time_of_key}

# Every identity a compiled module can be recognised by. The aspect registry is
# process-wide (it survives across compilations inside one process, e.g. a spec
# run or a long-lived driver), so advice must be scoped to the modules ACTUALLY
# being compiled here -- identical reasoning, and identical code, to
# `layer_eq_module_identities` (C1) and `effect_module_identities` (C4).
fn aspect_module_identities(modules: Dict<text, HirModule>) -> [text]:
    var ids: [text] = []
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if module.path != "" and not ids.contains(module.path):
            ids.push(module.path)
        if module.name != "" and not ids.contains(module.name):
            ids.push(module.name)
        if not ids.contains(module_key):
            ids.push(module_key)
    ids

fn aspect_join_point_kind_list() -> text:
    join_point_kinds().join(", ")

# The `@readonly @noalloc @bounded_time` obligations that are absent, in the
# plan's own order. Empty list = all three declared.
fn aspect_missing_obligations(key: text) -> [text]:
    var missing: [text] = []
    if not aspect_registry_readonly_of_key(key):
        missing.push("@readonly")
    if not aspect_registry_noalloc_of_key(key):
        missing.push("@noalloc")
    if not aspect_registry_bounded_time_of_key(key):
        missing.push("@bounded_time")
    missing

fn validate_aspect_contracts(modules: Dict<text, HirModule>) -> [text]:
    """Prove every recorded `@advice(...)` declaration against the join-point
    universe of this compilation; return one diagnostic per unproven or
    unmeasurable claim (empty list = every advice proven)."""
    var errors: [text] = []
    val claim_keys = aspect_registry_claim_keys()
    if claim_keys.len() == 0:
        return errors

    val module_ids = aspect_module_identities(modules)
    # Enumerated ONCE for the whole compilation, not per claim: two advice
    # declarations on the same edge must see the same join-point id.
    val forwards = forward_join_points(modules)

    for key in claim_keys:
        val claim_path = aspect_claim_path(key)
        val advice_fn = aspect_claim_fn(key)
        if advice_fn == "":
            continue
        # Out-of-scope advice: recorded for a module that is not part of this
        # compilation. Skipping is correct and is NOT a fail-open -- the module
        # that owns the advice carries it again when it is compiled, and the
        # spec asserts that in-scope advice really does produce diagnostics, so
        # a scoping bug that silenced everything would turn it red.
        if not module_ids.contains(claim_path):
            continue

        val kind = aspect_registry_kind_of_key(key)
        val selector = aspect_registry_selector_of_key(key)
        val mode = aspect_registry_mode_of_key(key)

        # --- the three advice obligations ------------------------------------
        # Checked FIRST and independently of the pointcut, so an advice that is
        # both misdeclared and mistargeted reports both problems in one run
        # rather than hiding one behind the other.
        val missing = aspect_missing_obligations(key)
        if missing.len() > 0:
            errors.push("error[aspect]: advice '" + advice_fn
                + "' must declare @readonly @noalloc @bounded_time (missing: "
                + missing.join(" ") + ")")

        # --- the pointcut kind ------------------------------------------------
        if kind == "":
            errors.push("error[aspect]: advice '" + advice_fn
                + "' has no join-point kind; expected @advice(KIND, SELECTOR) with KIND one of: "
                + aspect_join_point_kind_list())
            continue
        if join_point_kind_is_prohibited(kind):
            # Not "unknown" -- deliberately a different message. The plan rules
            # these out by design ("Never per-pixel/glyph/span/tile join
            # points"), so pointing the author at a spelling fix would be
            # wrong advice about wrong advice.
            errors.push("error[aspect]: advice '" + advice_fn + "' targets '" + kind
                + "', a per-element join point. Per-pixel/glyph/span/tile join points are"
                + " prohibited; hot-path join points exist only at frame/commit/plan/batch/"
                + "submit/event-batch/fallback granularity")
            continue
        if not join_point_kind_is_known(kind):
            errors.push("error[aspect]: advice '" + advice_fn
                + "' names unknown join-point kind '" + kind + "'; expected one of: "
                + aspect_join_point_kind_list())
            continue
        if selector == "":
            errors.push("error[aspect]: advice '" + advice_fn + "' on kind '" + kind
                + "' has no selector; expected @advice(" + kind + ", SELECTOR)")
            continue

        # --- the weave mode ---------------------------------------------------
        if not join_point_mode_is_known(mode):
            errors.push("error[aspect]: advice '" + advice_fn + "' names unknown weave mode '"
                + mode + "'; expected one of: " + join_point_modes().join(", "))
            continue
        if not join_point_mode_is_implemented(mode):
            # Rejecting rather than downgrading to static is the anti-fail-open
            # move: source that asks for a live-reloadable aspect and silently
            # gets a frozen one is a correctness bug that never surfaces.
            errors.push("error[aspect]: advice '" + advice_fn + "' requests weave mode '"
                + mode + "', which is not implemented in this slice (static weave only;"
                + " startup dynload and live reload are follow-on milestones)")
            continue

        # --- the pointcut selector -------------------------------------------
        if not join_point_kind_is_measurable(kind):
            # UNMEASURED, not "not found". This is the entire reason C3 does not
            # report a clean bill of health on six of its seven kinds.
            errors.push("error[aspect]: advice '" + advice_fn + "' selects '" + selector
                + "' of kind '" + kind + "': " + join_point_unmeasured_reason(kind))
            continue
        val matched = join_points_matching(forwards, kind, selector)
        if matched.len() == 0:
            errors.push("error[aspect]: advice '" + advice_fn + "' selects '" + selector
                + "' of kind '" + kind
                + "' but no such logical join point exists in this compilation ("
                + "{forwards.len()} forward join point(s) enumerated)")
            continue
    errors

export validate_aspect_contracts, aspect_module_identities, aspect_missing_obligations
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection
