# Enum-contract match coverage built from HIR match sites (S2/S3 wiring).
#
# Produces one `ResolvedMatchCoverage` per `match` whose arms name variants of
# an enum DECLARED IN THE SAME MODULE (`module.enums`). The scrutinee enum is
# identified from the arm patterns themselves: `HirPatternKind.Enum(type_, ...)`
# carries the enum's `HirTypeKind.Named(symbol)`, which is resolved back to a
# `HirEnum` through `module.enums` and, when symbol ids are not distinct (the
# seed hands several local enums id 0), disambiguated by the variant name the
# arm spells. A match with no enum arm at all (a literal or binding match) is
# not an enum match and produces no record.
#
# Variant IDS are the variant's declaration INDEX within its enum, not the
# `HirVariant.symbol` id: the index is guaranteed distinct per enum on every
# binary, which is all `ResolvedMatchCoverage` needs from an id. Two enums are
# never mixed in one record, so the index is sufficient to keep coverage
# id-keyed rather than name-keyed.
#
# Scope, stated: walks `module.functions` bodies (free functions and the
# methods HIR already hoists into that table), recursing through blocks,
# if/loop/while/for, let/assign/return/try values, lambdas and nested match
# arm bodies. An arm shape this walker does not recognise contributes nothing;
# it never invents a wildcard.

use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId}
use compiler.hir.hir_definitions.{
    HirEnum, HirFunction, HirExpr, HirExprKind, HirStmt, HirStmtKind, HirBlock,
    HirMatchArm, HirPattern, HirPatternKind, HirCallArg, HirInterpolation, HirIfArm,
    HirWithItem, HirEnumPayload, HirCompClause, HirCompClauseKind
}
use compiler.hir.match_coverage.{ResolvedMatchCoverage}

struct HirMatchSite:
    """One enum match found in HIR, with the function it sits in."""
    function_name: text
    line: i64
    coverage: ResolvedMatchCoverage

struct ArmScan:
    """Raw facts collected from one match's arms before enum resolution."""
    enum_symbol_ids: [i64]
    variant_names: [text]
    has_wildcard: bool

fn hir_walk_unhandled(node_kind: text, line: i64) -> void:
    # Loud by design: a HirPatternKind/HirExprKind variant added after this
    # walker was written must fail visibly rather than be silently skipped.
    print("E-ENUM-CONTRACT-WALK-UNHANDLED: unhandled {node_kind} variant at line {line} - add it to enum_contract/hir_match_coverage.spl")

fn scan_pattern(p: HirPattern, acc: ArmScan) -> ArmScan:
    var out = acc
    var handled = false
    match p.kind:
        case HirPatternKind.Enum(type_, variant, payload):
            match type_.kind:
                case HirTypeKind.Named(symbol, args):
                    out.enum_symbol_ids = out.enum_symbol_ids.push(symbol.id)
                case _:
                    out.enum_symbol_ids = out.enum_symbol_ids.push(-1)
            out.variant_names = out.variant_names.push(variant)
            handled = true
        case HirPatternKind.Wildcard:
            out.has_wildcard = true
            handled = true
        case HirPatternKind.Binding(symbol, mutable):
            out.has_wildcard = true
            handled = true
        case HirPatternKind.Or(patterns):
            for sub in patterns:
                out = scan_pattern(sub, out)
            handled = true
        case HirPatternKind.Tuple(elements):
            for sub in elements:
                out = scan_pattern(sub, out)
            handled = true
        case HirPatternKind.Array(elements, rest):
            for sub in elements:
                out = scan_pattern(sub, out)
            handled = true
        case HirPatternKind.Struct(type_, fields):
            for f in fields:
                val (fname, sub) = f
                val sp: HirPattern = sub
                out = scan_pattern(sp, out)
            handled = true
        case HirPatternKind.Literal(value):
            # A literal arm names no enum variant and covers nothing else.
            handled = true
        case HirPatternKind.Range(start, end, inclusive):
            # A range arm names no enum variant and is never a wildcard.
            handled = true
        case HirPatternKind.Error:
            # A parse-error placeholder pattern contributes no coverage fact.
            handled = true
        case HirPatternKind.CompleteRegion(binder):
            # `case complete b:` covers only the CLOSED region; not a wildcard.
            handled = true
        case HirPatternKind.DynRegion(binder):
            # `case dyn b:` covers only the OPEN region; it is not a wildcard
            # over the static constructors (design §2).
            handled = true
    if not handled:
        hir_walk_unhandled("HirPatternKind", p.span.line)
    out
fn variant_index(e: HirEnum, name: text) -> i64:
    var i = 0
    while i < e.variants.len():
        if e.variants[i].name == name:
            return i
        i = i + 1
    -1

fn resolve_enum(module: HirModule, scan: ArmScan) -> HirEnum?:
    """The module-local enum the arms belong to, or nil.

    First by symbol id; if that leaves more than one candidate (ids not
    distinct) or none, by the enum that declares the first named variant."""
    var by_symbol: [HirEnum] = []
    val first_sym = if scan.enum_symbol_ids.len() > 0: scan.enum_symbol_ids[0] else: -1
    for e in module.enums.values():
        if e.symbol.id == first_sym:
            by_symbol = by_symbol.push(e)
    if by_symbol.len() == 1:
        return by_symbol[0]
    if scan.variant_names.len() == 0:
        return nil
    val first_name = scan.variant_names[0]
    var by_variant: [HirEnum] = []
    for e in module.enums.values():
        if variant_index(e, first_name) >= 0:
            by_variant = by_variant.push(e)
    if by_variant.len() == 1:
        return by_variant[0]
    nil

fn coverage_for_match(module: HirModule, arms: [HirMatchArm]) -> ResolvedMatchCoverage?:
    var scan = ArmScan(enum_symbol_ids: [], variant_names: [], has_wildcard: false)
    for arm in arms:
        scan = scan_pattern(arm.pattern, scan)
    if scan.variant_names.len() == 0:
        return nil
    val found = resolve_enum(module, scan)
    if found == nil:
        return nil
    val e: HirEnum = found
    var all_ids: [i64] = []
    var all_names: [text] = []
    var i = 0
    while i < e.variants.len():
        all_ids = all_ids.push(i)
        all_names = all_names.push(e.variants[i].name)
        i = i + 1
    var covered: [i64] = []
    for vname in scan.variant_names:
        val idx = variant_index(e, vname)
        if idx >= 0:
            var seen = false
            for c in covered:
                if c == idx:
                    seen = true
            if not seen:
                covered = covered.push(idx)
    ResolvedMatchCoverage(
        scrutinee_type_id: e.symbol.id,
        enum_symbol_id: e.symbol.id,
        enum_name: e.name,
        all_variant_ids: all_ids,
        all_variant_names: all_names,
        covered_variant_ids: covered,
        has_wildcard: scan.has_wildcard
    )

fn walk_block(module: HirModule, fn_name: text, b: HirBlock, acc: [HirMatchSite]) -> [HirMatchSite]:
    var out = acc
    for s in b.stmts:
        out = walk_stmt(module, fn_name, s, out)
    if b.has:
        out = walk_expr(module, fn_name, b.value, out)
    out

fn walk_stmt(module: HirModule, fn_name: text, s: HirStmt, acc: [HirMatchSite]) -> [HirMatchSite]:
    match s.kind:
        case HirStmtKind.Expr(e): walk_expr(module, fn_name, e, acc)
        case HirStmtKind.Let(symbol, type_, init): walk_expr(module, fn_name, init, acc)
        case HirStmtKind.Assign(target, op, value): walk_expr(module, fn_name, value, acc)
        case HirStmtKind.Block(block): walk_block(module, fn_name, block, acc)
        case _: acc


fn walk_exprs(module: HirModule, fn_name: text, es: [HirExpr], acc: [HirMatchSite]) -> [HirMatchSite]:
    var out = acc
    for e in es:
        out = walk_expr(module, fn_name, e, out)
    out

fn walk_args(module: HirModule, fn_name: text, args: [HirCallArg], acc: [HirMatchSite]) -> [HirMatchSite]:
    var out = acc
    for a in args:
        val ca: HirCallArg = a
        out = walk_expr(module, fn_name, ca.value, out)
    out

fn walk_named_exprs(module: HirModule, fn_name: text, fields: [(text, HirExpr)], acc: [HirMatchSite]) -> [HirMatchSite]:
    var out = acc
    for f in fields:
        val (fname, fe) = f
        val fx: HirExpr = fe
        out = walk_expr(module, fn_name, fx, out)
    out

fn walk_expr_opt(module: HirModule, fn_name: text, e: HirExpr?, acc: [HirMatchSite]) -> [HirMatchSite]:
    if e == nil:
        return acc
    val v: HirExpr = e
    walk_expr(module, fn_name, v, acc)

fn walk_block_opt(module: HirModule, fn_name: text, b: HirBlock?, acc: [HirMatchSite]) -> [HirMatchSite]:
    if b == nil:
        return acc
    val v: HirBlock = b
    walk_block(module, fn_name, v, acc)

fn walk_expr(module: HirModule, fn_name: text, e: HirExpr, acc: [HirMatchSite]) -> [HirMatchSite]:
    var out = acc
    var handled = false
    match e.kind:
        # ---- Literals (leaves) ---------------------------------------------
        case HirExprKind.IntLit(value, suffix): handled = true
        case HirExprKind.FloatLit(value, suffix): handled = true
        case HirExprKind.StringLit(value, interpolations):
            if interpolations != nil:
                val ips: [HirInterpolation] = interpolations
                for ip in ips:
                    val ipv: HirInterpolation = ip
                    out = walk_expr(module, fn_name, ipv.expr, out)
            handled = true
        case HirExprKind.BoolLit(value): handled = true
        case HirExprKind.CharLit(value): handled = true
        case HirExprKind.UnitLit: handled = true
        case HirExprKind.NilLit: handled = true

        # ---- Collections ----------------------------------------------------
        case HirExprKind.ArrayLit(elements, elem_ty):
            out = walk_exprs(module, fn_name, elements, out)
            handled = true
        case HirExprKind.ArrayRepeat(value, count, elem_ty):
            val av: HirExpr = value
            val ac: HirExpr = count
            out = walk_expr(module, fn_name, av, out)
            out = walk_expr(module, fn_name, ac, out)
            handled = true
        case HirExprKind.TupleLit(elements):
            out = walk_exprs(module, fn_name, elements, out)
            handled = true
        case HirExprKind.DictLit(entries, key_ty, value_ty):
            for entry in entries:
                val (k, v) = entry
                val kt: HirExpr = k
                val vt: HirExpr = v
                out = walk_expr(module, fn_name, kt, out)
                out = walk_expr(module, fn_name, vt, out)
            handled = true
        case HirExprKind.SetLit(elements, elem_ty):
            out = walk_exprs(module, fn_name, elements, out)
            handled = true

        # ---- Variables and access -------------------------------------------
        case HirExprKind.Var(symbol): handled = true
        case HirExprKind.NamedVar(symbol, name): handled = true
        case HirExprKind.Field(base, field, resolved):
            val fb: HirExpr = base
            out = walk_expr(module, fn_name, fb, out)
            handled = true
        case HirExprKind.Index(base, index):
            val ib: HirExpr = base
            val ii: HirExpr = index
            out = walk_expr(module, fn_name, ib, out)
            out = walk_expr(module, fn_name, ii, out)
            handled = true
        case HirExprKind.TupleIndex(base, index):
            val tb: HirExpr = base
            out = walk_expr(module, fn_name, tb, out)
            handled = true
        case HirExprKind.OptionalChain(base, field):
            val ob: HirExpr = base
            out = walk_expr(module, fn_name, ob, out)
            handled = true
        case HirExprKind.NullCoalesce(left, right):
            val nl: HirExpr = left
            val nr: HirExpr = right
            out = walk_expr(module, fn_name, nl, out)
            out = walk_expr(module, fn_name, nr, out)
            handled = true
        case HirExprKind.ExistsCheck(base):
            val eb: HirExpr = base
            out = walk_expr(module, fn_name, eb, out)
            handled = true
        case HirExprKind.Unwrap(base):
            val ub: HirExpr = base
            out = walk_expr(module, fn_name, ub, out)
            handled = true

        # ---- Operators ------------------------------------------------------
        case HirExprKind.Binary(op, left, right):
            val bl: HirExpr = left
            val br: HirExpr = right
            out = walk_expr(module, fn_name, bl, out)
            out = walk_expr(module, fn_name, br, out)
            handled = true
        case HirExprKind.Unary(op, operand):
            val uo: HirExpr = operand
            out = walk_expr(module, fn_name, uo, out)
            handled = true

        # ---- Calls ----------------------------------------------------------
        case HirExprKind.Call(callee, args, type_args):
            val cc: HirExpr = callee
            out = walk_expr(module, fn_name, cc, out)
            out = walk_args(module, fn_name, args, out)
            handled = true
        case HirExprKind.MethodCall(receiver, method, args, resolution):
            val mr: HirExpr = receiver
            out = walk_expr(module, fn_name, mr, out)
            out = walk_args(module, fn_name, args, out)
            handled = true
        case HirExprKind.StaticCall(ty, method, args, resolution):
            out = walk_args(module, fn_name, args, out)
            handled = true

        # ---- Control flow ---------------------------------------------------
        case HirExprKind.If(cond, then_, else_):
            val ic: HirExpr = cond
            out = walk_expr(module, fn_name, ic, out)
            out = walk_block(module, fn_name, then_, out)
            out = walk_block_opt(module, fn_name, else_, out)
            handled = true
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                val a: HirIfArm = arm
                out = walk_expr(module, fn_name, a.cond, out)
                out = walk_block(module, fn_name, a.then_, out)
            out = walk_block_opt(module, fn_name, else_, out)
            handled = true
        case HirExprKind.MatchCase(scrutinee, arms):
            val cov = coverage_for_match(module, arms)
            if cov != nil:
                out = out.push(HirMatchSite(function_name: fn_name, line: e.span.line, coverage: cov))
            val ms: HirExpr = scrutinee
            out = walk_expr(module, fn_name, ms, out)
            for arm in arms:
                out = walk_block(module, fn_name, arm.body, out)
            handled = true
        case HirExprKind.Loop(body, label):
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.While(cond, body, label):
            val wc: HirExpr = cond
            out = walk_expr(module, fn_name, wc, out)
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.For(var_, iter, body, label):
            val fi: HirExpr = iter
            out = walk_expr(module, fn_name, fi, out)
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.With(items, body):
            for item in items:
                val wi: HirWithItem = item
                out = walk_expr(module, fn_name, wi.context_expr, out)
            out = walk_block(module, fn_name, body, out)
            handled = true

        # ---- Closures and blocks --------------------------------------------
        case HirExprKind.Lambda(params, body, captures):
            val lb: HirExpr = body
            out = walk_expr(module, fn_name, lb, out)
            handled = true
        case HirExprKind.Block(block):
            out = walk_block(module, fn_name, block, out)
            handled = true
        case HirExprKind.HostGpuLane(lane_code, payload_size, marker, body):
            val gm: HirExpr = marker
            out = walk_expr(module, fn_name, gm, out)
            out = walk_block(module, fn_name, body, out)
            handled = true

        # ---- Control transfer -----------------------------------------------
        case HirExprKind.Return(value):
            out = walk_expr_opt(module, fn_name, value, out)
            handled = true
        case HirExprKind.Break(label, value):
            out = walk_expr_opt(module, fn_name, value, out)
            handled = true
        case HirExprKind.Continue(label): handled = true
        case HirExprKind.Throw(value):
            val tv: HirExpr = value
            out = walk_expr(module, fn_name, tv, out)
            handled = true
        case HirExprKind.Try(inner):
            val te: HirExpr = inner
            out = walk_expr(module, fn_name, te, out)
            handled = true
        case HirExprKind.Await(inner):
            val ae: HirExpr = inner
            out = walk_expr(module, fn_name, ae, out)
            handled = true
        case HirExprKind.Yield(value):
            out = walk_expr_opt(module, fn_name, value, out)
            handled = true

        # ---- Constructors and casts -----------------------------------------
        case HirExprKind.StructLit(ty, fields):
            out = walk_named_exprs(module, fn_name, fields, out)
            handled = true
        case HirExprKind.EnumLit(ty, variant, payload):
            if payload != nil:
                val pl: HirEnumPayload = payload
                match pl:
                    case HirEnumPayload.Tuple(values):
                        out = walk_exprs(module, fn_name, values, out)
                    case HirEnumPayload.Struct(pfields):
                        out = walk_named_exprs(module, fn_name, pfields, out)
            handled = true
        case HirExprKind.Cast(inner, target):
            val ce: HirExpr = inner
            out = walk_expr(module, fn_name, ce, out)
            handled = true
        case HirExprKind.As(inner, target):
            val ase: HirExpr = inner
            out = walk_expr(module, fn_name, ase, out)
            handled = true
        case HirExprKind.Range(start, end, inclusive, step):
            val rs: HirExpr = start
            val re: HirExpr = end
            out = walk_expr(module, fn_name, rs, out)
            out = walk_expr(module, fn_name, re, out)
            out = walk_expr_opt(module, fn_name, step, out)
            handled = true
        case HirExprKind.Comprehension(kind, inner, clauses):
            val ce2: HirExpr = inner
            out = walk_expr(module, fn_name, ce2, out)
            for clause in clauses:
                val cl: HirCompClause = clause
                match cl.kind:
                    case HirCompClauseKind.For(cvar, iter):
                        val cli: HirExpr = iter
                        out = walk_expr(module, fn_name, cli, out)
                    case HirCompClauseKind.If(cond):
                        val clc: HirExpr = cond
                        out = walk_expr(module, fn_name, clc, out)
            handled = true

        # ---- Custom / DL / unsafe / asm blocks ------------------------------
        case HirExprKind.CustomBlock(kind, value):
            # Opaque BlockValue payload; carries no HIR match this layer can reach.
            handled = true
        case HirExprKind.LossBlock(body):
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.NogradBlock(body):
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.UnsafeBlock(body):
            out = walk_block(module, fn_name, body, out)
            handled = true
        case HirExprKind.InlineAsm(asm_node):
            # Assembly text carries no Simple `match`.
            handled = true
        case HirExprKind.InlineAsmMatch(arms):
            # Arms select by target spec and hold asm bodies, not HIR blocks.
            handled = true
        case HirExprKind.Error: handled = true
    if not handled:
        hir_walk_unhandled("HirExprKind", e.span.line)
    out

fn hir_enum_match_sites(module: HirModule) -> [HirMatchSite]:
    """Every enum match in `module`'s function bodies, in table order."""
    var out: [HirMatchSite] = []
    for f in module.functions.values():
        if not f.is_extern:
            out = walk_block(module, f.name, f.body, out)
    out

fn hir_enum_match_coverages(module: HirModule) -> [ResolvedMatchCoverage]:
    var out: [ResolvedMatchCoverage] = []
    for site in hir_enum_match_sites(module):
        out = out.push(site.coverage)
    out

export HirMatchSite, hir_enum_match_sites, hir_enum_match_coverages, coverage_for_match
