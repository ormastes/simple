# codex-impl
# Five semantic-owner evidence adapters for one L7 live attempt.
#
# HONESTY BOUNDARY: these receipts are diagnostic owner-revision probes only.
# The current owners do not expose a source-universe completion lease or exact
# conditional dependency proof, and portable body descriptors are copyable
# facts rather than verifier authority. Therefore every projection remains
# Unknown/incomplete and the driver installation gate remains closed.

use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache_contract.physical_tld_v1.{
    three_payload_contract_digest_valid_v1,
    three_payload_contract_max_items_v1,
    three_payload_contract_text_valid_v1,
}
use compiler.common.cache_contract.three_payload_compile_v2.{ThreePayloadFallbackV1}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{SemanticCoverageV1}
use compiler.common.cache_contract.semantic_scope_live_port_contract_v1.{
    SemanticScopeContributionLiveRequestV1,
    L78BoundaryErrorV4, L78OwnerTokenV4, L78OwnedResultV4
}
use compiler.frontend.parser.macro_registry.{MacroRegistry, IntroducedSymbol,
    InjectionAnchor, InjectionCodeKind}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName,
    module_surfaces_retained_alignment}
use compiler.hir.portable_body_budget.{PortableBodyLedgerV1}
use compiler.hir.portable_body_profile_types.{PortableBodyDescriptorV1}
use compiler.traits.trait_coherence.{CoherenceChecker}
use compiler.semantics.aspect_seal.seal.{AspectSeal}
use compiler.semantics.semantic_scope_contribution_v1.{
    SemanticScopeDimensionV1,
    SemanticScopeDependencyEnumerationV1,
    semantic_scope_empty_dependency_enumeration_v1,
    semantic_scope_body_dependency_enumeration_v1,
    semantic_scope_dependency_enumeration_valid_v1,
    semantic_scope_source_universe_digest_v1,
}

pub struct SemanticIssuerAttemptContextV2:
    scope_owner_instance_digest: text
    scope_session_serial: i64
    writer_instance_digest: text
    generation: i64
    manifest_digest: text
    generation_closure_digest: text
    binding_digest: text
    query_domain_digest: text
    semantic_rules_digest: text
    attempt_seal_digest: text
    cancellation_epoch: i64
    pin_id_digest: text
    pin_reader_epoch: i64
    pin_generation: i64
    pin_manifest_digest: text
    pin_deadline_monotonic_ms: i64
    process_instance_nonce_digest: text
    boot_identity_digest: text
    namespace_entry_digest: text
    source_universe: [text]

# Copied diagnostic evidence only.  It cannot be installed, sealed, or used as
# a cache authority.  The opaque handle plus retained receipt is still required
# even to revalidate this projection.
pub struct SemanticScopeIssuerEvidenceProjectionV2:
    dimension: SemanticScopeDimensionV1
    attempt_context_digest: text
    source_universe_digest: text
    owner_revision_digest: text
    dependency_enumeration_digest: text
    issuer_instance_digest: text
    issuer_generation: i64
    authority_serial: i64
    members: [text]
    negative_witnesses: [text]
    source_universe: [text]
    dependency_enumeration: SemanticScopeDependencyEnumerationV1
    coverage: SemanticCoverageV1
    universe_complete: bool
    gateway_install_available: bool

# Identity-only handle.  Its constructor/fields are module-private; it never
# contains a candidate, source universe, pin snapshot or grant material.
struct SemanticScopeIssuedHandleV2:
    issuer_instance_digest: text
    issuer_generation: i64
    authority_serial: i64

enum _SemanticIssuerResultOwnerV2:
    Declaration(ModuleSurfacesByName)
    Trait(CoherenceChecker)
    Aspect(AspectSeal)
    Macro(MacroRegistry)
    Body([PortableBodyDescriptorV1], PortableBodyLedgerV1)

# One receipt retains exactly one diagnostic semantic result. It is not an
# aggregate registry and cannot install, seal, reserve or publish a scope.
class SemanticScopeIssuerReceiptV2:
    owner_result: _SemanticIssuerResultOwnerV2
    context: SemanticIssuerAttemptContextV2
    dimension: SemanticScopeDimensionV1
    members: [text]
    negative_witnesses: [text]
    dependency_enumeration: SemanticScopeDependencyEnumerationV1
    dependency_enumeration_digest: text
    owner_revision_digest: text
    issuer_instance_digest: text
    issuer_generation: i64
    authority_serial: i64
    closed: bool

var _next_semantic_issuer_instance_v2: i64 = 1

fn _frame_issuer_v2(value: text) -> text:
    value.len().to_string() + ":" + value

fn _sorted_unique_issuer_text_v2(values: [text], allow_empty: bool) -> bool:
    if values.len() > three_payload_contract_max_items_v1(): return false
    var previous = ""
    var first = true
    for value in values:
        if not three_payload_contract_text_valid_v1(value, allow_empty): return false
        if not first and value <= previous: return false
        previous = value
        first = false
    true

fn _conditional_issuer_members_v2(
    context: SemanticIssuerAttemptContextV2, active: bool,
) -> [text]:
    if active: return context.source_universe
    []

fn _conditional_issuer_negative_v2(active: bool, absent: text) -> [text]:
    if active: return []
    [absent]

fn _trait_owner_active_v2(checker: CoherenceChecker) -> bool:
    checker.local_traits.len() > 0 or checker.local_types.len() > 0 or
        checker.impls.len() > 0

fn _aspect_owner_active_v2(seal: AspectSeal) -> bool:
    seal.binding_count > 0 or seal.aspect_ids.len() > 0 or
        seal.advice_order.len() > 0

fn _macro_owner_active_v2(registry: MacroRegistry) -> bool:
    registry.macro_names().len() > 0 or
        registry.introduced_symbols.len() > 0 or
        registry.pending_injections.len() > 0

fn _issuer_context_valid_v2(value: SemanticIssuerAttemptContextV2) -> bool:
    (three_payload_contract_digest_valid_v1(value.scope_owner_instance_digest) and
        value.scope_session_serial > 0 and
        three_payload_contract_digest_valid_v1(value.writer_instance_digest) and
        value.generation >= 0 and
        three_payload_contract_digest_valid_v1(value.manifest_digest) and
        three_payload_contract_digest_valid_v1(value.generation_closure_digest) and
        three_payload_contract_digest_valid_v1(value.binding_digest) and
        three_payload_contract_digest_valid_v1(value.query_domain_digest) and
        three_payload_contract_digest_valid_v1(value.semantic_rules_digest) and
        three_payload_contract_digest_valid_v1(value.attempt_seal_digest) and
        value.cancellation_epoch >= 0 and
        three_payload_contract_digest_valid_v1(value.pin_id_digest) and
        value.pin_reader_epoch >= 0 and value.pin_reader_epoch % 2 == 0 and
        value.pin_generation == value.generation and
        value.pin_manifest_digest == value.manifest_digest and
        value.pin_deadline_monotonic_ms > 0 and
        three_payload_contract_digest_valid_v1(value.process_instance_nonce_digest) and
        three_payload_contract_digest_valid_v1(value.boot_identity_digest) and
        three_payload_contract_digest_valid_v1(value.namespace_entry_digest) and
        value.source_universe.len() > 0 and
        _sorted_unique_issuer_text_v2(value.source_universe, false))

fn _issuer_context_same_v2(left: SemanticIssuerAttemptContextV2,
                           right: SemanticIssuerAttemptContextV2) -> bool:
    left.scope_owner_instance_digest == right.scope_owner_instance_digest and
        left.scope_session_serial == right.scope_session_serial and
        left.writer_instance_digest == right.writer_instance_digest and
        left.generation == right.generation and
        left.manifest_digest == right.manifest_digest and
        left.generation_closure_digest == right.generation_closure_digest and
        left.binding_digest == right.binding_digest and
        left.query_domain_digest == right.query_domain_digest and
        left.semantic_rules_digest == right.semantic_rules_digest and
        left.attempt_seal_digest == right.attempt_seal_digest and
        left.cancellation_epoch == right.cancellation_epoch and
        left.pin_id_digest == right.pin_id_digest and
        left.pin_reader_epoch == right.pin_reader_epoch and
        left.pin_generation == right.pin_generation and
        left.pin_manifest_digest == right.pin_manifest_digest and
        left.pin_deadline_monotonic_ms == right.pin_deadline_monotonic_ms and
        left.process_instance_nonce_digest == right.process_instance_nonce_digest and
        left.boot_identity_digest == right.boot_identity_digest and
        left.namespace_entry_digest == right.namespace_entry_digest and
        left.source_universe == right.source_universe

fn _issuer_context_digest_v2(value: SemanticIssuerAttemptContextV2) -> text:
    var parts: [text] = ["simple.semantic-issuer.attempt.v2\u0000"]
    for field in [value.scope_owner_instance_digest,
            value.scope_session_serial.to_string(), value.writer_instance_digest,
            value.generation.to_string(), value.manifest_digest,
            value.generation_closure_digest, value.binding_digest,
            value.query_domain_digest, value.semantic_rules_digest,
            value.attempt_seal_digest, value.cancellation_epoch.to_string(),
            value.pin_id_digest, value.pin_reader_epoch.to_string(),
            value.pin_generation.to_string(), value.pin_manifest_digest,
            value.pin_deadline_monotonic_ms.to_string(),
            value.process_instance_nonce_digest, value.boot_identity_digest,
            value.namespace_entry_digest]:
        parts.push(_frame_issuer_v2(field))
    for source in value.source_universe: parts.push(_frame_issuer_v2(source))
    sha256_text(parts.join(""))

fn _allocate_issuer_instance_v2() -> i64:
    if (_next_semantic_issuer_instance_v2 <= 0 or
            _next_semantic_issuer_instance_v2 == 9223372036854775807): return -1
    val result = _next_semantic_issuer_instance_v2
    _next_semantic_issuer_instance_v2 = result + 1
    result

fn _declaration_universe_v2(registry: ModuleSurfacesByName) -> [text]:
    var universe: [text] = []
    for surface in registry.surfaces: universe.push(surface.canonical_path)
    universe.sort()
    universe

fn _declaration_revision_v2(registry: ModuleSurfacesByName) -> text:
    var rows: [text] = ["simple.semantic-issuer.declarations.v2",
        registry.generation.to_string(), registry.frozen.to_string()]
    var aliases = registry.index_by_name.keys()
    aliases.sort()
    for alias in aliases:
        rows.push("alias=" + alias + "|" + registry.index_by_name[alias].to_string())
    var ordered_index = 0
    while ordered_index < registry.ordered_names.len():
        rows.push("ordered=" + registry.ordered_names[ordered_index] + "|" +
            registry.ordered_indices[ordered_index].to_string())
        ordered_index = ordered_index + 1
    for surface in registry.surfaces:
        rows.push(surface.physical_index.to_string())
        rows.push(surface.generation.to_string())
        rows.push(surface.frozen.to_string())
        rows.push(surface.source_index.to_string())
        rows.push(surface.canonical_path)
        rows.push(surface.module_name)
        rows.push(surface.logical_name)
        rows.push(surface.canonical_name)
        rows.push(surface.package_name)
        rows.push(surface.preferred_registry_name)
        rows.push(surface.content_length.to_string())
        rows.push(surface.content_hash.to_string())
        rows.push(surface.semantic_hash0.to_string())
        rows.push(surface.semantic_hash1.to_string())
        rows.push(surface.semantic_hash2.to_string())
        rows.push(surface.semantic_hash3.to_string())
        rows.push(surface.semantic_cacheable.to_string())
        rows = rows.merge(surface.composite_names)
        rows = rows.merge(surface.enum_names)
        rows = rows.merge(surface.trait_names)
        rows = rows.merge(surface.callable_names)
        rows = rows.merge(surface.type_alias_names)
        rows = rows.merge(surface.constant_names)
        rows = rows.merge(surface.import_target_names)
        rows = rows.merge(surface.export_route_sources)
        rows = rows.merge(surface.export_route_locals)
        rows = rows.merge(surface.export_route_target_names)
        rows = rows.merge(surface.import_item_names)
        rows = rows.merge(surface.import_item_aliases)
        for callable in surface.callable_values:
            rows.push("callable=" + callable.name)
            for type_parameter in callable.type_params:
                rows.push("type-param=" + type_parameter.name + "|" +
                    type_parameter.has_default.to_string())
            for parameter in callable.params:
                rows.push("param=" + parameter.name + "|" + parameter.type_name +
                    "|" + parameter.array_element_name + "|" +
                    parameter.has_type_.to_string() + "|" +
                    parameter.has_default.to_string() + "|" +
                    parameter.is_mutable.to_string())
            rows.push("return=" + callable.has_return_type.to_string() + "|" +
                callable.return_type_name + "|" + callable.return_array_element_name)
            rows.push("visibility=" + callable.visibility.to_string() + "|" +
                callable.is_public.to_string())
            rows.push("flags=" + callable.is_async.to_string() + "|" +
                callable.is_static.to_string() + "|" +
                callable.is_method.to_string() + "|" +
                callable.is_mutable.to_string() + "|" +
                callable.is_const.to_string() + "|" +
                callable.is_kernel.to_string() + "|" +
                callable.is_extern.to_string())
    var framed: [text] = []
    for row in rows: framed.push(_frame_issuer_v2(row))
    sha256_text(framed.join(""))

fn _trait_revision_v2(checker: CoherenceChecker) -> text:
    var rows: [text] = ["simple.semantic-issuer.traits.v2"]
    var trait_names = checker.local_traits.keys()
    var type_names = checker.local_types.keys()
    var impl_groups = checker.impls.keys()
    trait_names.sort()
    type_names.sort()
    impl_groups.sort()
    for name in trait_names: rows.push("trait=" + name)
    for name in type_names: rows.push("type=" + name)
    for group in impl_groups:
        var impl_rows: [text] = []
        for info in checker.impls[group]:
            var associated = info.associated_types.keys()
            associated.sort()
            var associated_rows: [text] = []
            for name in associated:
                associated_rows.push(name + "=" + info.associated_types[name])
            impl_rows.push(group + "|" + info.target_type + "|" +
                info.generic_params.join(",") + "|" + info.is_blanket.to_string() +
                "|" + info.is_default.to_string() + "|" + associated_rows.join(","))
        impl_rows.sort()
        rows = rows.merge(impl_rows)
    var framed: [text] = []
    for row in rows: framed.push(_frame_issuer_v2(row))
    sha256_text(framed.join(""))

fn _aspect_seal_valid_v2(seal: AspectSeal) -> bool:
    if seal.binding_count < 0 or seal.obligation_count < 0: return false
    var sorted_lines = seal.lines.copy()
    var sorted_ids = seal.aspect_ids.copy()
    var sorted_advice = seal.advice_order.copy()
    var sorted_signatures = seal.unverified_signatures.copy()
    sorted_lines.sort()
    sorted_ids.sort()
    sorted_advice.sort()
    sorted_signatures.sort()
    if (sorted_lines != seal.lines or sorted_ids != seal.aspect_ids or
            sorted_advice != seal.advice_order or
            sorted_signatures != seal.unverified_signatures): return false
    val profile = if seal.profile_critical: "profile=critical" else: "profile=default"
    seal.seal_hash == "ASPECTSEALV1-" + sha256_text(profile + "\n" + seal.lines.join("\n"))

fn _aspect_revision_v2(seal: AspectSeal) -> text:
    var rows: [text] = ["simple.semantic-issuer.aspects.v2",
        seal.profile_critical.to_string(), seal.seal_hash,
        seal.binding_count.to_string(), seal.obligation_count.to_string()]
    rows = rows.merge(seal.lines)
    rows = rows.merge(seal.aspect_ids)
    rows = rows.merge(seal.advice_order)
    rows = rows.merge(seal.unverified_signatures)
    var framed: [text] = []
    for row in rows: framed.push(_frame_issuer_v2(row))
    sha256_text(framed.join(""))

fn _macro_symbol_row_v2(value: IntroducedSymbol) -> text:
    match value:
        case Function(name, params, return_type, source):
            var parameter_rows: [text] = []
            for (parameter, type_name) in params:
                parameter_rows.push(parameter + ":" + type_name)
            "fn|" + name + "|" + parameter_rows.join(",") + "|" +
                (return_type ?? "") + "|" + source
        case Field(name, type_name, source):
            "field|" + name + "|" + type_name + "|" + source
        case TypeAlias(name, source): "type|" + name + "|" + source
        case Variable(name, type_name, is_const, source):
            "var|" + name + "|" + type_name + "|" + is_const.to_string() + "|" + source

fn _macro_anchor_v2(value: InjectionAnchor) -> text:
    match value:
        case Head: "head"
        case Tail: "tail"
        case Here: "here"

fn _macro_code_kind_v2(value: InjectionCodeKind) -> text:
    match value:
        case Stmt: "stmt"
        case Block: "block"

fn _macro_revision_v2(registry: MacroRegistry) -> text:
    var rows: [text] = ["simple.semantic-issuer.macros.v2",
        registry.is_ll1_mode().to_string()]
    var macro_names = registry.macro_names()
    macro_names.sort()
    for name in macro_names:
        rows.push("macro=" + name)
        val definition = registry.macros[name]
        rows.push("params=" + definition.params.join(","))
        for intro in definition.contract_intros:
            rows.push("intro=" + intro.kind + "|" + intro.name_pattern + "|" +
                (intro.type_pattern ?? ""))
        for inject in definition.contract_injects:
            rows.push("inject=" + inject.label + "|" + _macro_anchor_v2(inject.anchor) +
                "|" + _macro_code_kind_v2(inject.code_kind))
    var scopes = registry.introduced_symbols.keys()
    scopes.sort()
    for scope in scopes:
        var symbol_index = 0
        for symbol in registry.get_symbols_in_scope(scope):
            # lookup_symbol is first-match, so semantic array order is part of
            # the owner revision even when names collide.
            rows.push("scope=" + scope + "|" + symbol_index.to_string() + "|" +
                _macro_symbol_row_v2(symbol))
            symbol_index = symbol_index + 1
    for inject in registry.pending_injections:
        rows.push("pending=" + inject.source_macro + "|" + inject.label + "|" +
            _macro_anchor_v2(inject.anchor) + "|" + _macro_code_kind_v2(inject.code_kind))
    var framed: [text] = []
    for row in rows: framed.push(_frame_issuer_v2(row))
    sha256_text(framed.join(""))

fn _body_revision_v2(descriptors: [PortableBodyDescriptorV1],
                     ledger: PortableBodyLedgerV1) -> text:
    var rows: [text] = ["simple.semantic-issuer.bodies.v2"]
    for descriptor in descriptors:
        rows.push(descriptor.object_kind)
        rows.push(descriptor.object_schema.to_string())
        rows.push(descriptor.codec_identity)
        rows.push(descriptor.verifier_identity)
        rows.push(descriptor.raw_content_digest)
        rows.push(descriptor.rules_identity)
        rows.push(descriptor.semantic_profile_digest)
        rows.push(descriptor.module_name)
        rows.push(descriptor.module_path)
        rows.push(descriptor.transitive_effect_digest)
        rows.push(descriptor.dependency_digest)
        rows.push(descriptor.call_occurrences.to_string())
        rows.push(descriptor.longest_call_chain.to_string())
        for entry in descriptor.exported_entries:
            rows.push("export=" + entry.symbol_id.to_string() + "|" + entry.name +
                "|" + entry.signature_digest + "|" +
                entry.normalized_effect_digest)
        for edge in descriptor.dependency_edges:
            rows.push(edge.caller_symbol_id.to_string() + "|" + edge.caller_name +
                "|" + edge.callee_symbol_id.to_string() + "|" + edge.callee_name)
        val descriptor_budget = descriptor.budget
        for value in [descriptor_budget.body_objects, descriptor_budget.functions,
                descriptor_budget.symbols, descriptor_budget.scopes,
                descriptor_budget.exports, descriptor_budget.parameters,
                descriptor_budget.nodes, descriptor_budget.graph_nodes,
                descriptor_budget.dependency_edges,
                descriptor_budget.call_occurrences, descriptor_budget.text_bytes,
                descriptor_budget.encoded_bytes, descriptor_budget.retained_bytes,
                descriptor_budget.work_units]:
            rows.push("descriptor-budget=" + value.to_string())
    rows.push("ledger-ok=" + ledger.ok().to_string())
    rows.push("ledger-failure=" + ledger.failure_detail)
    val limits = ledger.limits
    for value in [limits.max_body_objects, limits.max_functions,
            limits.max_symbols, limits.max_scopes, limits.max_exports,
            limits.max_parameters, limits.max_nodes, limits.max_graph_nodes,
            limits.max_dependency_edges, limits.max_call_occurrences,
            limits.max_call_chain_depth, limits.max_semantic_depth,
            limits.max_text_bytes, limits.max_encoded_bytes,
            limits.max_retained_bytes, limits.max_work_units]:
        rows.push("ledger-limit=" + value.to_string())
    val counters = ledger.snapshot()
    for value in [counters.body_objects, counters.functions, counters.symbols,
            counters.scopes, counters.exports, counters.parameters, counters.nodes,
            counters.graph_nodes, counters.dependency_edges,
            counters.call_occurrences, counters.text_bytes, counters.encoded_bytes,
            counters.retained_bytes, counters.work_units]:
        rows.push(value.to_string())
    var framed: [text] = []
    for row in rows: framed.push(_frame_issuer_v2(row))
    sha256_text(framed.join(""))

fn _receipt_v2(owner_result: _SemanticIssuerResultOwnerV2,
               context: SemanticIssuerAttemptContextV2,
               dimension: SemanticScopeDimensionV1,
               members: [text],
               negative_witnesses: [text],
               dependency_enumeration: SemanticScopeDependencyEnumerationV1,
               revision: text,
               issuer_generation: i64,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    if not _issuer_context_valid_v2(context):
        return Err(ThreePayloadFallbackV1.CorruptPayload)
    if (not _sorted_unique_issuer_text_v2(members, false) or
            not _sorted_unique_issuer_text_v2(negative_witnesses, false) or
            not semantic_scope_dependency_enumeration_valid_v1(
                dependency_enumeration)):
        return Err(ThreePayloadFallbackV1.WitnessIncomplete)
    for member in members:
        if context.source_universe.index_of(member) < 0:
            return Err(ThreePayloadFallbackV1.WitnessIncomplete)
    val instance = _allocate_issuer_instance_v2()
    if instance <= 0: return Err(ThreePayloadFallbackV1.BoundsExceeded)
    val issuer_instance_digest = sha256_text(
        "simple.semantic-issuer.instance.v2\u0000" + instance.to_string() + "\u0000" +
        _issuer_context_digest_v2(context) + "\u0000" + revision)
    Ok(SemanticScopeIssuerReceiptV2(owner_result: owner_result, context: context,
        dimension: dimension,
        members: members, negative_witnesses: negative_witnesses,
        dependency_enumeration: dependency_enumeration,
        dependency_enumeration_digest: dependency_enumeration.enumeration_digest,
        owner_revision_digest: revision,
        issuer_instance_digest: issuer_instance_digest,
        issuer_generation: issuer_generation, authority_serial: 1, closed: false))

pub fn issue_declaration_scope_v2(
    registry: ModuleSurfacesByName,
    context: SemanticIssuerAttemptContextV2,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    if not module_surfaces_retained_alignment(registry):
        return Err(ThreePayloadFallbackV1.WitnessIncomplete)
    val universe = _declaration_universe_v2(registry)
    if universe != context.source_universe or
            not _sorted_unique_issuer_text_v2(universe, false):
        return Err(ThreePayloadFallbackV1.WitnessIncomplete)
    val revision = _declaration_revision_v2(registry)
    val dependencies = semantic_scope_empty_dependency_enumeration_v1()
    _receipt_v2(_SemanticIssuerResultOwnerV2.Declaration(registry), context,
        SemanticScopeDimensionV1.DeclarationsReexports,
        context.source_universe, [], dependencies, revision, registry.generation)

pub fn issue_trait_scope_v2(
    checker: CoherenceChecker,
    context: SemanticIssuerAttemptContextV2,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    if checker.check_all().len() != 0:
        return Err(ThreePayloadFallbackV1.UnsupportedSemantics)
    val revision = _trait_revision_v2(checker)
    val dependencies = semantic_scope_empty_dependency_enumeration_v1()
    val active = _trait_owner_active_v2(checker)
    _receipt_v2(_SemanticIssuerResultOwnerV2.Trait(checker), context,
        SemanticScopeDimensionV1.TraitCandidatesCoherence,
        _conditional_issuer_members_v2(context, active),
        _conditional_issuer_negative_v2(active,
            "trait-candidate-universe-empty"),
        dependencies, revision, 1)

pub fn issue_aspect_scope_v2(
    seal: AspectSeal,
    context: SemanticIssuerAttemptContextV2,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    if not _aspect_seal_valid_v2(seal):
        return Err(ThreePayloadFallbackV1.WitnessIncomplete)
    val revision = _aspect_revision_v2(seal)
    val dependencies = semantic_scope_empty_dependency_enumeration_v1()
    val active = _aspect_owner_active_v2(seal)
    _receipt_v2(_SemanticIssuerResultOwnerV2.Aspect(seal), context,
        SemanticScopeDimensionV1.AspectCandidatesOrdering,
        _conditional_issuer_members_v2(context, active),
        _conditional_issuer_negative_v2(active,
            "aspect-candidate-universe-empty"),
        dependencies, revision, 1)

pub fn issue_macro_scope_v2(
    registry: MacroRegistry,
    context: SemanticIssuerAttemptContextV2,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    val revision = _macro_revision_v2(registry)
    val dependencies = semantic_scope_empty_dependency_enumeration_v1()
    val active = _macro_owner_active_v2(registry)
    _receipt_v2(_SemanticIssuerResultOwnerV2.Macro(registry), context,
        SemanticScopeDimensionV1.MacroCtfeLookup,
        _conditional_issuer_members_v2(context, active),
        _conditional_issuer_negative_v2(active, "macro-ctfe-universe-empty"),
        dependencies, revision, 1)

pub fn issue_body_scope_v2(
    descriptors: [PortableBodyDescriptorV1],
    ledger: PortableBodyLedgerV1,
    context: SemanticIssuerAttemptContextV2,
) -> Result<SemanticScopeIssuerReceiptV2, ThreePayloadFallbackV1>:
    if not ledger.ok(): return Err(ThreePayloadFallbackV1.BoundsExceeded)
    val dependencies = semantic_scope_body_dependency_enumeration_v1(descriptors)?
    val revision = _body_revision_v2(descriptors, ledger)
    val active = descriptors.len() > 0
    _receipt_v2(_SemanticIssuerResultOwnerV2.Body(descriptors, ledger), context,
        SemanticScopeDimensionV1.BodyDependencyClosure,
        _conditional_issuer_members_v2(context, active),
        _conditional_issuer_negative_v2(active,
            "body-dependency-universe-empty"),
        dependencies, revision, 1)

fn _receipt_current_revision_v2(receipt: SemanticScopeIssuerReceiptV2) -> text:
    match receipt.owner_result:
        case Declaration(registry):
            if not module_surfaces_retained_alignment(registry): return ""
            _declaration_revision_v2(registry)
        case Trait(checker):
            if checker.check_all().len() != 0: return ""
            _trait_revision_v2(checker)
        case Aspect(seal):
            if not _aspect_seal_valid_v2(seal): return ""
            _aspect_revision_v2(seal)
        case Macro(registry): _macro_revision_v2(registry)
        case Body(descriptors, ledger):
            if not ledger.ok(): return ""
            match semantic_scope_body_dependency_enumeration_v1(descriptors):
                case Ok(_): _body_revision_v2(descriptors, ledger)
                case Err(_): ""

impl SemanticScopeIssuerReceiptV2:
    pub fn handle_v2() -> SemanticScopeIssuedHandleV2:
        SemanticScopeIssuedHandleV2(
            issuer_instance_digest: self.issuer_instance_digest,
            issuer_generation: self.issuer_generation,
            authority_serial: self.authority_serial)

    pub fn validate_issued_scope_v2(
        handle: SemanticScopeIssuedHandleV2,
        expected: SemanticIssuerAttemptContextV2,
    ) -> Result<SemanticScopeIssuerEvidenceProjectionV2, ThreePayloadFallbackV1>:
        if self.closed:
            return Err(ThreePayloadFallbackV1.AuthorityUnavailable)
        if handle.issuer_instance_digest != self.issuer_instance_digest:
            return Err(ThreePayloadFallbackV1.AuthorityUnavailable)
        if (handle.issuer_generation != self.issuer_generation or
                handle.authority_serial != self.authority_serial):
            return Err(ThreePayloadFallbackV1.ScopeGenerationMismatch)
        if not _issuer_context_valid_v2(expected):
            return Err(ThreePayloadFallbackV1.CorruptPayload)
        if not _issuer_context_same_v2(self.context, expected):
            return Err(ThreePayloadFallbackV1.ScopeGenerationMismatch)
        val current_revision = _receipt_current_revision_v2(self)
        if (current_revision == "" or
                current_revision != self.owner_revision_digest):
            return Err(ThreePayloadFallbackV1.ScopeGenerationMismatch)
        Ok(SemanticScopeIssuerEvidenceProjectionV2(
            dimension: self.dimension,
            attempt_context_digest: _issuer_context_digest_v2(self.context),
            source_universe_digest:
                semantic_scope_source_universe_digest_v1(self.context.source_universe),
            owner_revision_digest: self.owner_revision_digest,
            dependency_enumeration_digest: self.dependency_enumeration_digest,
            issuer_instance_digest: self.issuer_instance_digest,
            issuer_generation: self.issuer_generation,
            authority_serial: self.authority_serial,
            members: self.members,
            negative_witnesses: self.negative_witnesses,
            source_universe: self.context.source_universe,
            dependency_enumeration: self.dependency_enumeration,
            coverage: SemanticCoverageV1.Unknown,
            universe_complete: false,
            gateway_install_available: false))

    pub me close_v2() -> Result<(), ThreePayloadFallbackV1>:
        if self.closed: return Err(ThreePayloadFallbackV1.AuthorityUnavailable)
        self.closed = true
        Ok(())

pub fn semantic_scope_issuer_gateway_install_available_v2() -> bool:
    false

# Owner-specific V4 hook seam. These factories deliberately create only
# unavailable adapters; production semantic owners must retain and validate
# their own live capability before gateway installation can succeed.
pub trait L78SemanticHookPortV4:
    me issue(request: SemanticScopeContributionLiveRequestV1
    ) -> Result<L78OwnerTokenV4, L78BoundaryErrorV4>
    me validate(token: L78OwnerTokenV4,
                request: SemanticScopeContributionLiveRequestV1
    ) -> Result<(), L78BoundaryErrorV4>
    me close(token: L78OwnerTokenV4) -> Result<(), L78BoundaryErrorV4>

pub struct L78ClosedSemanticHookV4:
    dimension_index: i64
    reason: text

impl L78SemanticHookPortV4 for L78ClosedSemanticHookV4:
    me issue(request: SemanticScopeContributionLiveRequestV1
    ) -> Result<L78OwnerTokenV4, L78BoundaryErrorV4>:
        Err(L78BoundaryErrorV4.Unavailable)

    me validate(token: L78OwnerTokenV4,
                request: SemanticScopeContributionLiveRequestV1
    ) -> Result<(), L78BoundaryErrorV4>:
        Err(L78BoundaryErrorV4.Unavailable)

    me close(token: L78OwnerTokenV4) -> Result<(), L78BoundaryErrorV4>:
        Err(L78BoundaryErrorV4.Unavailable)

pub fn l78_closed_declaration_hook_v4(reason: text) -> L78ClosedSemanticHookV4:
    L78ClosedSemanticHookV4(dimension_index: 0, reason: reason)

pub fn l78_closed_trait_hook_v4(reason: text) -> L78ClosedSemanticHookV4:
    L78ClosedSemanticHookV4(dimension_index: 1, reason: reason)

pub fn l78_closed_aspect_hook_v4(reason: text) -> L78ClosedSemanticHookV4:
    L78ClosedSemanticHookV4(dimension_index: 2, reason: reason)

pub fn l78_closed_macro_hook_v4(reason: text) -> L78ClosedSemanticHookV4:
    L78ClosedSemanticHookV4(dimension_index: 3, reason: reason)

pub fn l78_closed_body_hook_v4(reason: text) -> L78ClosedSemanticHookV4:
    L78ClosedSemanticHookV4(dimension_index: 4, reason: reason)

# Owner-returning hook issuance.  The concrete owner is handed back on every
# branch, including refusal, so a caller never keeps a pre-call copy.  This
# runner grants nothing: with the closed adapters installed it can only ever
# report Unavailable.
pub fn l78_issue_hook_with_port_v4<P: L78SemanticHookPortV4>(
    owner: P,
    request: SemanticScopeContributionLiveRequestV1,
) -> L78OwnedResultV4<P, L78OwnerTokenV4>:
    val outcome = owner.issue(request)
    L78OwnedResultV4<P, L78OwnerTokenV4>(owner: owner, outcome: outcome)

export SemanticScopeIssuedHandleV2, SemanticScopeIssuerReceiptV2
