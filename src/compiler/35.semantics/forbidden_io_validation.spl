# Production HIR adapter for E-APACK008 forbidden-context I/O checking.
#
# This pass intentionally recognizes only the loader-level acquisition calls
# classified by forbidden_io_checker. Typed facet<T>() syntax is not present in
# HIR yet, so manufacturing a syntax-level classification here would be
# contract fiction. When that syntax lowers to a canonical loader call, the
# existing classification remains sufficient.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.effect_validation.{effect_block_callees}
use compiler.semantics.forbidden_io_checker.{
    ForbiddenIoContextManifest,
    check_all_forbidden_io_fns,
    format_forbidden_io_violations,
    is_forbidden_io_acquire_fn
}
use compiler.semantics.rt_criticality_validation.{rt_module_matches, rt_stable_fn_id}
use compiler.frontend.rt_criticality_registry.{
    rt_criticality_claim_keys,
    rt_criticality_claim_path,
    rt_criticality_claim_fn
}

fn forbidden_io_module_is_aspect_pack(module_key: text, module: HirModule) -> bool:
    (module.path == "src/lib/common/aspect_pack.spl" or
        module_key == "std.common.aspect_pack" or
        module_key == "lib.common.aspect_pack" or
        module_key == "src.lib.common.aspect_pack")

fn forbidden_io_import_is_aspect_pack(module_path: text) -> bool:
    (module_path == "std.common.aspect_pack" or
        module_path == "lib.common.aspect_pack" or
        module_path == "src.lib.common.aspect_pack")

fn forbidden_io_sift_down(mut values: [text], start: i64, heap_len: i64):
    var root = start
    while true:
        val left = root * 2 + 1
        if left >= heap_len: return
        var largest = root
        if values[largest] < values[left]:
            largest = left
        val right = left + 1
        if right < heap_len and values[largest] < values[right]:
            largest = right
        if largest == root: return
        val temporary = values[root]
        values[root] = values[largest]
        values[largest] = temporary
        root = largest

fn forbidden_io_sort(values: [text]) -> [text]:
    """Deterministic O(D log D) heapsort matching action-key ordering.

    Equal diagnostic strings are observationally identical, so the heapsort's
    lack of stable equal-item positioning cannot alter the public text order.
    The array is copied once by value and sorted in place without per-item
    transient arrays.
    """
    var out = values
    if out.len() < 2: return out
    var start = out.len() / 2
    while start > 0:
        start = start - 1
        forbidden_io_sift_down(out, start, out.len())
    var end = out.len()
    while end > 1:
        end = end - 1
        val temporary = out[0]
        out[0] = out[end]
        out[end] = temporary
        forbidden_io_sift_down(out, 0, end)
    out

pub fn validate_forbidden_io_contexts(modules: Dict<text, HirModule>) -> [text]:
    """Run the existing forbidden-I/O classifier over resolved HIR once.

    The adapter builds a single compilation-unit graph and the checker builds a
    single reverse reachability index. Local bare callees are translated only
    when their identity is unique; canonical loader acquisitions retain their
    classified spelling. Ambiguous local names do not acquire a guessed edge.
    """
    val manifest = ForbiddenIoContextManifest.new()
    val claims = rt_criticality_claim_keys()
    var unique_ids: Dict<text, text> = {}
    var qualified_ids: Dict<text, text> = {}
    var ambiguous: Dict<text, bool> = {}
    var realtime_ids: Dict<text, bool> = {}

    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            val stable = rt_stable_fn_id(module_key, fn_.symbol.id)
            if unique_ids.contains_key(fn_.name):
                ambiguous[fn_.name] = true
            else:
                unique_ids[fn_.name] = stable
            qualified_ids[module_key + "." + fn_.name] = stable
            qualified_ids[module_key + "::" + fn_.name] = stable
            qualified_ids[module.name + "." + fn_.name] = stable
        for key in claims:
            if not rt_module_matches(
                    module_key, module, rt_criticality_claim_path(key)):
                continue
            val claimed_name = rt_criticality_claim_fn(key)
            for fn_ in module.functions.values():
                if fn_.name == claimed_name:
                    realtime_ids[rt_stable_fn_id(module_key, fn_.symbol.id)] = true

    for module_key in modules.keys():
        val module = modules[module_key]
        var symbol_names: Dict<i64, text> = {}
        for known_fn in module.functions.values():
            symbol_names[known_fn.symbol.id] = known_fn.name
        # HIR import resolution currently leaves HirImportItem.resolved nil.
        # The canonical import path plus imported item/alias is therefore the
        # stable authority for loader identity; no raw basename is trusted.
        var imported_acquires: Dict<text, text> = {}
        for import_ in module.imports:
            if not forbidden_io_import_is_aspect_pack(import_.module_path):
                continue
            for item in import_.items:
                if not is_forbidden_io_acquire_fn(item.name): continue
                var local_name = item.name
                match item.alias:
                    Some(alias): local_name = alias
                    nil: pass_dn
                imported_acquires[local_name] =
                    "src/lib/common/aspect_pack.spl::" + item.name
                imported_acquires[import_.module_path + "." + item.name] =
                    "src/lib/common/aspect_pack.spl::" + item.name
                imported_acquires[import_.module_path + "::" + item.name] =
                    "src/lib/common/aspect_pack.spl::" + item.name
        for fn_ in module.functions.values():
            val stable = rt_stable_fn_id(module_key, fn_.symbol.id)
            manifest.register(
                stable,
                realtime_ids.contains_key(stable) or fn_.func_attr.is_rt_hal,
                fn_.func_attr.is_interrupt,
                fn_.func_attr.is_no_alloc
            )
            var callees: [text] = []
            var seen_callees: Dict<text, bool> = {}
            for raw_callee in effect_block_callees(fn_.body, symbol_names):
                if imported_acquires.contains_key(raw_callee):
                    val canonical = imported_acquires[raw_callee]
                    if not seen_callees.contains_key(canonical):
                        callees.push(canonical)
                        seen_callees[canonical] = true
                elif (forbidden_io_module_is_aspect_pack(module_key, module) and
                        is_forbidden_io_acquire_fn(raw_callee)):
                    val canonical = if raw_callee.contains(".") or raw_callee.contains("::"):
                        raw_callee
                    else:
                        "src/lib/common/aspect_pack.spl::" + raw_callee
                    if not seen_callees.contains_key(canonical):
                        callees.push(canonical)
                        seen_callees[canonical] = true
                elif qualified_ids.contains_key(raw_callee):
                    val resolved = qualified_ids[raw_callee]
                    if not seen_callees.contains_key(resolved):
                        callees.push(resolved)
                        seen_callees[resolved] = true
                elif unique_ids.contains_key(raw_callee) and not ambiguous.contains_key(raw_callee):
                    val resolved = unique_ids[raw_callee]
                    if not seen_callees.contains_key(resolved):
                        callees.push(resolved)
                        seen_callees[resolved] = true
            manifest.set_callees(stable, callees)

    forbidden_io_sort(format_forbidden_io_violations(
        check_all_forbidden_io_fns(manifest)))

export validate_forbidden_io_contexts
