# Layer call-direction whole-program wiring (M1b of doc/03_plan/compiler/
# forwarding/zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md).
#
# module_assembly.spl (M0/M1a) already validates the layer DAG and the
# `@layer(NAME)` tag PER MODULE, one parse call at a time — that local view
# cannot see whether module A's call into module B crosses layers, because
# it never sees module B. The whole-program view DOES exist one level up:
# src/compiler/80.driver/driver_source_pipeline_parsing.spl's `parse_all_impl`
# holds every parsed module (with M1a's `tagged_layer`) and every module's
# source text at once, once all modules in the compilation unit are parsed.
#
# This file is the free-function core that a driver call site adapts to:
# given every module's path, source text, `tagged_layer`, and serialized
# `layer_dag_edges` (ParserModule.layer_dag_edges, written by
# module_assembly.spl), it (1) merges every module's own declared
# layers/`uses` edges into one project-wide LayerDagRegistry, (2) rebuilds
# the caller->callee module edges via layer_call_scan's text scan (reusing
# in-memory content, not a second disk read), and (3) runs
# layer_call_direction_checker.check_all_layer_calls over the result.
#
# SCOPE, stated plainly:
#   - The call-edge extraction is layer_call_scan's TEXT/regex heuristic
#     (bare `ident(` matched against `use` import lines) — the same
#     documented gaps apply here: no re-export, no wildcard `use module.*`,
#     no aliased import, no fully-qualified inline call. It can also produce
#     a false POSITIVE (a local fn sharing an imported symbol's name is
#     misattributed as a call into that module). Because of that, a found
#     violation is NOT surfaced as a `parser_error` here — it is returned as
#     formatted diagnostic text for the caller to report as a WARNING.
#     Gating compilation on this is future work once call edges come from
#     AST/HIR instead of text (see the plan doc's later milestones).
#   - The merged LayerDagRegistry replays every module's serialized
#     "D:name" / "E:from>to" facts in module-list order. `declare()` is
#     idempotent, so a layer named in more than one module's `layer NAME`
#     decl merges into a single entry; `uses()` edges accumulate.
#     check_declared_upward's index ordering therefore reflects the ORDER
#     MODULES WERE PASSED IN (i.e. the driver's source list order), not any
#     cross-module authority — this is a best-effort merge, not a proof the
#     project's layer declarations are globally consistent.
#   - Cheap no-op path: if no module in the batch carries a non-empty
#     `tagged_layer`, this returns [] immediately without scanning anything
#     (see check_project_layer_calls below) — a repo with zero `@layer(...)`
#     tags (true of this repo today) pays no per-compile cost.

use compiler.semantics.layer_dag_checker.{LayerDagRegistry}
use compiler.semantics.layer_call_direction_checker.{
    check_all_layer_calls,
    format_layer_call_violations
}
use compiler.tools.verify.layer_call_scan.{scan_source_calls}

# ============================================================================
# Merge every module's serialized layer_dag_edges into one registry
# ============================================================================

fn merge_layer_dag(dag_edges_texts: [text]) -> LayerDagRegistry:
    """Replay every module's "D:name" / "E:from>to" lines (module.
    layer_dag_edges, see module_assembly.spl) into one shared
    LayerDagRegistry, in the order the texts are given.

    sdoctest:
        val merged = merge_layer_dag(["D:draw", "D:gui\nE:gui>draw"])
        expect(merged.has_layer("draw")).to_equal(true)
        expect(merged.has_layer("gui")).to_equal(true)
        expect(merged.edges_from("gui")).to_contain("draw")
    """
    var reg = LayerDagRegistry.new()
    for dag_text in dag_edges_texts:
        if dag_text == "":
            continue
        for line in dag_text.split("\n"):
            if line.starts_with("D:"):
                reg.declare(line[2:line.len()])
            elif line.starts_with("E:"):
                val rest = line[2:line.len()]
                val parts = rest.split(">")
                if parts.len() == 2:
                    reg.uses(parts[0], parts[1])
    reg

# ============================================================================
# module_path -> tagged_layer lookup shape (array-of-single-key-maps, same
# convention layer_call_direction_checker.check_all_layer_calls expects)
# ============================================================================

fn build_module_layers(module_paths: [text], tagged_layers: [text]) -> [{text: text}]:
    """Pair up module_paths[i] -> tagged_layers[i] into the array-of-maps
    shape check_all_layer_calls consumes. Untagged modules (tagged_layers[i]
    == "") are skipped -- check_layer_call_edge already treats "no known
    layer tag" as nothing-to-check, so omitting them here is equivalent and
    keeps the map smaller.

    sdoctest:
        val layers = build_module_layers(["a.spl", "b.spl"], ["gui", ""])
        expect(layers.len()).to_equal(1)
        expect(layers[0].has("a.spl")).to_equal(true)
    """
    var result: [{text: text}] = []
    var i = 0
    while i < module_paths.len() and i < tagged_layers.len():
        if tagged_layers[i] != "":
            var entry: {text: text} = {}
            entry[module_paths[i]] = tagged_layers[i]
            result.push(entry)
        i = i + 1
    result

# ============================================================================
# Whole-program entry point
# ============================================================================

fn check_project_layer_calls(
    module_paths: [text],
    module_contents: [text],
    tagged_layers: [text],
    dag_edges_texts: [text]
) -> [text]:
    """Whole-program M1b call-direction check over an in-memory batch of
    modules (module_paths[i]/module_contents[i]/tagged_layers[i]/
    dag_edges_texts[i] are one module's facts, same index i).

    Returns [] with NO scanning at all when no module carries a non-empty
    tagged_layer (the common case today: zero modules use `@layer(...)`).
    Otherwise returns formatted "error[layer_call]: ..." diagnostic strings
    for every same-layer-or-downward violation found -- the caller decides
    how to report these (this function never calls parser_error itself; see
    the file header for why gating is deferred).

    Real-call-edge behavior (a genuine violation caught against real,
    on-disk-resolvable source text, not a synthetic fixture) is exercised in
    test/01_unit/compiler/semantics/layer_call_wiring_spec.spl instead of
    here: scan_source_calls' import resolution is file_exists-gated, so a
    faithful positive-violation example needs a real file on disk and does
    not fit this doctest's no-filesystem-setup shape.

    sdoctest:
        val result = check_project_layer_calls(
            ["a.spl", "b.spl"], ["", ""], ["", ""], ["D:draw", "D:gui"])
        expect(result.len()).to_equal(0)
    """
    var any_tagged = false
    for tag in tagged_layers:
        if tag != "":
            any_tagged = true
    if not any_tagged:
        return []

    val module_layers = build_module_layers(module_paths, tagged_layers)
    val dag = merge_layer_dag(dag_edges_texts)

    var call_edges: [{text: [text]}] = []
    var i = 0
    while i < module_paths.len() and i < module_contents.len():
        val scanned = scan_source_calls(module_paths[i], module_contents[i])
        var entry: {text: [text]} = {}
        entry[scanned.module_path] = scanned.callee_modules
        call_edges.push(entry)
        i = i + 1

    val violations = check_all_layer_calls(call_edges, module_layers, dag)
    format_layer_call_violations(violations)

export merge_layer_dag, build_module_layers, check_project_layer_calls
