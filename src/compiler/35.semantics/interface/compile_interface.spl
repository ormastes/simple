# CompileInterfaceDigest — canonical digest of a module's typed public surface.
#
# Plan: doc/03_plan/compiler/build/targeted_build_interface_compat_minimal_bootstrap_2026-08-10.md (§7, §20)
# Encoding: reuses the canonical encoder helpers from
# compiler.driver.cache.action_key (domain separation, length prefixing,
# sorted sets, SHA-256) — see c0_schema_freeze_2026-08-09.md. NO second scheme.
#
# First slice (compute-and-log only): computed over the existing ApiSurface
# structures (compiler.tools.api_surface). ApiSurface today carries symbol
# names, parameter names/types, return type, visibility, fields, enum
# variants, trait/class method names. It does NOT yet carry generic
# arity+constraints, effects, parameter passing modes, or public constants —
# those enter the encoding when the typed-HIR extractor provides them
# (fields are versioned via the domain tag, so adding them bumps the domain).
#
# EXCLUDED by construction: comments, formatting, line numbers, source paths,
# function bodies, and any declaration whose declared visibility is private.

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.action_key.{
    canon_str, canon_nat, canon_field, canon_seq, action_key_sort_texts}
use compiler.tools.api_surface.{
    ApiSurface, FunctionSignature, StructSignature, ClassSignature,
    EnumSignature, TraitSignature, FieldSignature}

# Domain tags (schema-versioned; distinct per digest kind).
val COMPILE_INTERFACE_DOMAIN: text = "simple/compile-interface/v1"

# A declaration is part of the public surface unless explicitly private.
# nil visibility = module default = public.
fn interface_visibility_is_public(declared: text?) -> bool:
    match declared:
        Some(v): v != "private" and v != "priv"
        None: true

# Sorted-set digest under an explicit domain tag. Same shape as
# action_key.interface_digest_of, generalised over domain so the ABI /
# semantic placeholder digests can share the encoder without colliding.
fn interface_digest_with_domain(domain: text, parts: [text]) -> text:
    val sorted = action_key_sort_texts(parts)
    var items: [text] = []
    for p in sorted:
        items.push(canon_str(p))
    sha256_text(canon_field(domain, canon_seq(items)))

# ---- per-declaration canonical item encodings -----------------------------

fn encode_interface_function(sig: FunctionSignature) -> text:
    var params: [text] = []
    for p in sig.params:
        var pf: [text] = []
        # Parameter names are semantic in Simple (named args) — included.
        pf.push(canon_field("name", canon_str(p.name)))
        pf.push(canon_field("type", canon_str(p.type_name ?? "_")))
        params.push(canon_seq(pf))
    var inner: [text] = []
    inner.push(canon_field("name", canon_str(sig.name)))
    inner.push(canon_field("params", canon_seq(params)))
    inner.push(canon_field("ret", canon_str(sig.return_type ?? "_")))
    inner.push(canon_field("async", canon_nat(if sig.is_async: 1 else: 0)))
    inner.push(canon_field("gen", canon_nat(if sig.is_generator: 1 else: 0)))
    inner.push(canon_field("vis", canon_str(sig.declared_visibility ?? "public")))
    canon_field("fn", canon_seq(inner))

fn encode_interface_fields(fields: [FieldSignature]) -> text:
    # Field ORDER is semantic for layout/positional construction — kept ordered.
    var items: [text] = []
    for f in fields:
        if interface_visibility_is_public(f.declared_visibility):
            var ff: [text] = []
            ff.push(canon_field("name", canon_str(f.name)))
            ff.push(canon_field("type", canon_str(f.type_name ?? "_")))
            items.push(canon_seq(ff))
    canon_seq(items)

fn encode_interface_struct(sig: StructSignature) -> text:
    var inner: [text] = []
    inner.push(canon_field("name", canon_str(sig.name)))
    inner.push(canon_field("fields", encode_interface_fields(sig.fields)))
    canon_field("struct", canon_seq(inner))

fn encode_interface_class(sig: ClassSignature) -> text:
    var methods: [text] = []
    for m in action_key_sort_texts(sig.methods):
        methods.push(canon_str(m))
    var inner: [text] = []
    inner.push(canon_field("name", canon_str(sig.name)))
    inner.push(canon_field("fields", encode_interface_fields(sig.fields)))
    inner.push(canon_field("methods", canon_seq(methods)))
    canon_field("class", canon_seq(inner))

fn encode_interface_enum(sig: EnumSignature) -> text:
    # Variant order is semantic (discriminants) — kept ordered.
    var variants: [text] = []
    for v in sig.variants:
        variants.push(canon_str(v))
    var inner: [text] = []
    inner.push(canon_field("name", canon_str(sig.name)))
    inner.push(canon_field("variants", canon_seq(variants)))
    canon_field("enum", canon_seq(inner))

fn encode_interface_trait(sig: TraitSignature) -> text:
    var methods: [text] = []
    for m in action_key_sort_texts(sig.methods):
        methods.push(canon_str(m))
    var inner: [text] = []
    inner.push(canon_field("name", canon_str(sig.name)))
    inner.push(canon_field("methods", canon_seq(methods)))
    canon_field("trait", canon_seq(inner))

# ---- whole-surface digest -------------------------------------------------

# Canonical item texts for the public surface. A SET: sorted before hashing,
# so declaration iteration order never changes the digest.
fn compile_interface_parts(surface: ApiSurface) -> [text]:
    var parts: [text] = []
    for name in surface.functions.keys():
        val sig = surface.functions[name]
        if interface_visibility_is_public(sig.declared_visibility):
            parts.push(encode_interface_function(sig))
    for name in surface.structs.keys():
        parts.push(encode_interface_struct(surface.structs[name]))
    for name in surface.classes.keys():
        parts.push(encode_interface_class(surface.classes[name]))
    for name in surface.enums.keys():
        parts.push(encode_interface_enum(surface.enums[name]))
    for name in surface.traits.keys():
        parts.push(encode_interface_trait(surface.traits[name]))
    parts

fn compile_interface_digest(surface: ApiSurface) -> text:
    interface_digest_with_domain(COMPILE_INTERFACE_DOMAIN, compile_interface_parts(surface))
