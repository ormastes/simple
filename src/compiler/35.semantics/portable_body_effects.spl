# Existing semantic-layer owner adapter for the portable Base profile.  Empty
# and one explicit Pure annotation normalize identically; duplicates and every
# non-Pure effect are noncanonical/unsupported.

use std.common.crypto.sha256.{sha256_text}
use compiler.hir.hir_types.{Effect, EffectKind}

pub fn portable_body_effect_rules_digest_v1() -> text:
    sha256_text("simple.semantics.portable-body-effects.v1\u0000" +
        "empty-or-one-explicit-pure\u0000reject-duplicate-and-non-pure")

pub fn portable_body_normalized_pure_effect_v1(
    effects: [Effect],
) -> Result<text, text>:
    if effects.len() == 0: return Ok(portable_body_effect_rules_digest_v1())
    if effects.len() != 1: return Err("duplicate-effect-annotation")
    match effects[0].kind:
        case EffectKind.Pure: Ok(portable_body_effect_rules_digest_v1())
        case EffectKind.IO: Err("io-effect")
        case EffectKind.Async: Err("async-effect")
        case EffectKind.Throws(_): Err("throws-effect")
        case EffectKind.Mutates: Err("mutation-effect")
        case EffectKind.Allocates: Err("allocation-effect")
        case EffectKind.Custom(_): Err("custom-effect")
