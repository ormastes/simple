# C4 `@copy_budget(N)` / `@bounded_loop` production wiring: prove every
# source-level effect contract against facts EXTRACTED FROM LOWERED HIR BODIES,
# not hand-built fixtures.
#
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (C4)
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (line 203)
#
# THE GAP THIS CLOSES: `effect_verifier.spl` has implemented all four violation
# classes since it landed and passes 16/16 -- but its own header said so
# plainly: "Deferred -- 1. Driver wiring. Nothing populates an EffectManifest".
# The checker only ever saw hand-built `CopySite`/`LoopSite` values, so its
# obligations were unenforced on the tree. That is the exact shape that left C1
# unenforced for months. This pass is the consumer end of the attribute path
# added in 10.frontend (`effect_registry.spl`): it drains the parser's recorded
# contracts, finds each annotated function in the lowered HIR, WALKS ITS BODY
# for real loop and copy facts, and returns real compile diagnostics.
#
# Shape deliberately mirrors `layer_eq_validation.spl` (C1) and
# `value_struct_layout.spl`: same `(modules) -> [text]` contract, same
# "return diagnostics, let the driver decide how to surface them" rule, and it
# is invoked from the same driver hook so a new checker cannot quietly fail to
# be wired. There is exactly ONE such mechanism in this tree; a second would be
# the drift the C0-C5 plan warns about.
#
# HONEST SCOPE -- what real HIR does and does not provide:
#   PROVEN HERE from real bodies:
#     * loop presence and shape (`Loop` / `While` / `For` in HirExprKind)
#     * `while true` and bare `loop:` -> LOOP_BOUND_NONE
#     * `while i < <int literal>` -> LOOP_BOUND_CONST
#     * `for x in a..<int literal>` -> LOOP_BOUND_CONST; any other `for` ->
#       LOOP_BOUND_CAPACITY (iterating a collection is bounded by its length)
#     * container growth in a loop body (`.push` / `.insert` / `.append` /
#       `.extend` / `.add` method calls)
#     * whole-value struct copies: a `Let` whose DECLARED type is a
#       non-generic struct of this compilation and whose initialiser is an
#       existing place (variable / field / index / unwrap) rather than a
#       constructor. Byte size comes from the production layout engine
#       (`compute_struct_layout`), the same source C1 proves layouts with.
#     * the transitive call graph over DIRECT calls resolvable to a function
#       in this compilation, fed to `effect_copy_closure`.
#   NOT proven here, and NOT reported as proven (these remain exactly the open
#   items `effect_verifier.spl`'s own footer lists):
#     * indirect calls -- closures, function values, trait-object dispatch --
#       carry no callee name, so the closure cannot see through them. They are
#       simply not followed; a caller's cost is therefore a LOWER bound.
#     * methods declared inside `impl` blocks: `parse_module_body`'s decorator
#       arm only sees module-level `fn`, so an effect contract on a method is
#       rejected at parse time rather than silently dropped.
#     * induction-variable analysis for non-literal trip bounds. A bound this
#       pass cannot prove is classified NONE (fail-closed), never CONST.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.effect_verifier.{CopySite, LoopSite, EffectViolation}
use compiler.semantics.effect_verifier.{LOOP_BOUND_NONE, LOOP_BOUND_CONST, LOOP_BOUND_CAPACITY}
use compiler.semantics.effect_verifier.{COPY_BUDGET_UNSET}
use compiler.semantics.effect_verifier.{effect_copy_closure, check_copy_budget, check_bounded_loops}
use compiler.semantics.effect_verifier.{format_effect_violation}
use compiler.types.type_layout.{compute_struct_layout, layoutattr_default_}
use compiler.frontend.effect_registry.{effect_registry_claim_keys, effect_claim_path, effect_claim_fn}
use compiler.frontend.effect_registry.{effect_registry_budget_of_key, effect_registry_bounded_of_key}

# ============================================================================
# Struct size index -- SymbolId.id -> byte size
# ============================================================================
# Generic templates are skipped: a template has no single layout, exactly the
# exclusion `layer_eq_validation.spl` and `value_struct_layout.spl` both apply.

fn effect_struct_sizes(modules: Dict<text, HirModule>) -> Dict<i64, i64>:
    var sizes: Dict<i64, i64> = {}
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        for struct_ in module.structs.values():
            if struct_.type_params.len() > 0 or struct_.is_generic_template:
                continue
            var layout = compute_struct_layout(struct_.fields, layoutattr_default_())
            if struct_.has_layout_attr:
                layout = compute_struct_layout(struct_.fields, struct_.layout_attr)
            sizes[struct_.symbol.id] = layout.size
    sizes

# SymbolId.id -> function name, for resolving direct-call callees by name.
fn effect_fn_names(modules: Dict<text, HirModule>) -> Dict<i64, text>:
    var names: Dict<i64, text> = {}
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        for func in module.functions.values():
            names[func.symbol.id] = func.name
    names

# ============================================================================
# Loop-bound classification
# ============================================================================

fn effect_while_bound(cond: HirExpr) -> i64:
    """Trip-bound class for a `while` condition.

    Fail-CLOSED: anything this pass cannot prove finite is NONE. Classifying an
    unprovable bound as CONST would make `@bounded_loop` pass on exactly the
    loops it exists to reject.
    """
    match cond.kind:
        case HirExprKind.BoolLit(_):
            # `while true` (and `while false`, which is dead) has no bound.
            LOOP_BOUND_NONE
        case HirExprKind.Binary(_, _, right):
            val rhs: HirExpr = right
            match rhs.kind:
                case HirExprKind.IntLit(_, _):
                    LOOP_BOUND_CONST
                case _:
                    LOOP_BOUND_NONE
        case _:
            LOOP_BOUND_NONE

fn effect_for_bound(iter: HirExpr) -> i64:
    """Trip-bound class for a `for` iterable.

    A range with a literal end is CONST. Anything else is a collection, whose
    trip count is bounded by that collection's length -- CAPACITY, which
    `check_bounded_loops` accepts. This is the one place C4 is permissive, and
    deliberately so: `for tile in tiles` is the bounded per-frame shape the
    render-perf plan is asking for.
    """
    match iter.kind:
        case HirExprKind.Range(_, end, _, _):
            val e: HirExpr = end
            match e.kind:
                case HirExprKind.IntLit(_, _):
                    LOOP_BOUND_CONST
                case _:
                    LOOP_BOUND_CAPACITY
        case _:
            LOOP_BOUND_CAPACITY

fn effect_is_growth_method(name: text) -> bool:
    """Method names that grow a container by one element per call."""
    if name == "push":
        return true
    if name == "insert":
        return true
    if name == "append":
        return true
    if name == "extend":
        return true
    if name == "add":
        return true
    if name == "push_back":
        return true
    false

# ============================================================================
# Body walk
# ============================================================================
# Recursive, returning fresh lists rather than mutating a shared accumulator:
# this tree's interpreter value-copies class references on field and array
# stores, so an accumulator written through a class field would silently
# collect nothing under one engine and work under the other -- the same
# reasoning `effect_copy_closure` records for its parallel arrays.

fn effect_block_grows(block: HirBlock) -> bool:
    for st in block.stmts:
        val s: HirStmt = st
        match s.kind:
            case HirStmtKind.Expr(e):
                if effect_expr_grows(e):
                    return true
            case HirStmtKind.Let(_, _, init):
                if effect_expr_grows(init):
                    return true
            case HirStmtKind.Assign(_, _, value):
                if effect_expr_grows(value):
                    return true
            case HirStmtKind.Block(inner):
                if effect_block_grows(inner):
                    return true
            case _:
                pass_do_nothing("statement kind carries no growth site")
    if block.has:
        if effect_expr_grows(block.value):
            return true
    false

fn effect_expr_grows(expr: HirExpr) -> bool:
    match expr.kind:
        case HirExprKind.MethodCall(receiver, method, args, _):
            if effect_is_growth_method(method):
                return true
            if effect_expr_grows(receiver):
                return true
            for a in args:
                val arg: HirCallArg = a
                if effect_expr_grows(arg.value):
                    return true
            false
        case HirExprKind.Call(callee, args, _):
            if effect_expr_grows(callee):
                return true
            for a in args:
                val arg: HirCallArg = a
                if effect_expr_grows(arg.value):
                    return true
            false
        case HirExprKind.If(cond, then_, else_):
            if effect_expr_grows(cond):
                return true
            if effect_block_grows(then_):
                return true
            match else_:
                Some(eb):
                    effect_block_grows(eb)
                nil:
                    false
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                val typed_arm: HirIfArm = arm
                if effect_expr_grows(typed_arm.cond):
                    return true
                if effect_block_grows(typed_arm.then_):
                    return true
            match else_:
                Some(eb): effect_block_grows(eb)
                nil: false
        case HirExprKind.MatchCase(scrutinee, arms):
            if effect_expr_grows(scrutinee):
                return true
            for arm in arms:
                val a: HirMatchArm = arm
                if effect_block_grows(a.body):
                    return true
            false
        case HirExprKind.Loop(body, _):
            effect_block_grows(body)
        case HirExprKind.While(cond, body, _):
            if effect_expr_grows(cond):
                return true
            effect_block_grows(body)
        case HirExprKind.For(_, iter, body, _):
            if effect_expr_grows(iter):
                return true
            effect_block_grows(body)
        case HirExprKind.Block(inner):
            effect_block_grows(inner)
        case HirExprKind.UnsafeBlock(inner):
            effect_block_grows(inner)
        case HirExprKind.Binary(_, left, right):
            if effect_expr_grows(left):
                return true
            effect_expr_grows(right)
        case HirExprKind.Unary(_, operand):
            effect_expr_grows(operand)
        case HirExprKind.Return(value):
            match value:
                Some(v):
                    effect_expr_grows(v)
                nil:
                    false
        case _:
            false

fn effect_block_loops(block: HirBlock) -> [LoopSite]:
    var out: [LoopSite] = []
    for st in block.stmts:
        val s: HirStmt = st
        match s.kind:
            case HirStmtKind.Expr(e):
                for lp in effect_expr_loops(e):
                    out = out.push(lp)
            case HirStmtKind.Let(_, _, init):
                for lp in effect_expr_loops(init):
                    out = out.push(lp)
            case HirStmtKind.Assign(_, _, value):
                for lp in effect_expr_loops(value):
                    out = out.push(lp)
            case HirStmtKind.Block(inner):
                for lp in effect_block_loops(inner):
                    out = out.push(lp)
            case _:
                pass_do_nothing("statement kind carries no loop site")
    if block.has:
        for lp in effect_expr_loops(block.value):
            out = out.push(lp)
    out

fn effect_expr_loops(expr: HirExpr) -> [LoopSite]:
    var out: [LoopSite] = []
    match expr.kind:
        case HirExprKind.Loop(body, _):
            # A bare `loop:` has no trip bound by construction. `break` is not
            # a bound: proving it fires needs the induction analysis this pass
            # does not have, and guessing would be the fail-open direction.
            out = out.push(LoopSite(detail: "loop", bound_kind: LOOP_BOUND_NONE,
                grows_container: effect_block_grows(body), line: expr.span.line))
            for lp in effect_block_loops(body):
                out = out.push(lp)
        case HirExprKind.While(cond, body, _):
            out = out.push(LoopSite(detail: "while", bound_kind: effect_while_bound(cond),
                grows_container: effect_block_grows(body), line: expr.span.line))
            for lp in effect_block_loops(body):
                out = out.push(lp)
        case HirExprKind.For(_, iter, body, _):
            out = out.push(LoopSite(detail: "for", bound_kind: effect_for_bound(iter),
                grows_container: effect_block_grows(body), line: expr.span.line))
            for lp in effect_block_loops(body):
                out = out.push(lp)
        case HirExprKind.If(cond, then_, else_):
            for lp in effect_expr_loops(cond):
                out = out.push(lp)
            for lp in effect_block_loops(then_):
                out = out.push(lp)
            match else_:
                Some(eb):
                    for lp in effect_block_loops(eb):
                        out = out.push(lp)
                nil:
                    pass_do_nothing("if expression has no else block")
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                val typed_arm: HirIfArm = arm
                for lp in effect_expr_loops(typed_arm.cond):
                    out = out.push(lp)
                for lp in effect_block_loops(typed_arm.then_):
                    out = out.push(lp)
            match else_:
                Some(eb):
                    for lp in effect_block_loops(eb):
                        out = out.push(lp)
                nil:
                    pass_do_nothing("if chain has no else block")
        case HirExprKind.MatchCase(scrutinee, arms):
            for lp in effect_expr_loops(scrutinee):
                out = out.push(lp)
            for arm in arms:
                val a: HirMatchArm = arm
                for lp in effect_block_loops(a.body):
                    out = out.push(lp)
        case HirExprKind.Block(inner):
            for lp in effect_block_loops(inner):
                out = out.push(lp)
        case HirExprKind.UnsafeBlock(inner):
            for lp in effect_block_loops(inner):
                out = out.push(lp)
        case HirExprKind.Call(_, args, _):
            for a in args:
                val arg: HirCallArg = a
                for lp in effect_expr_loops(arg.value):
                    out = out.push(lp)
        case HirExprKind.MethodCall(receiver, _, args, _):
            for lp in effect_expr_loops(receiver):
                out = out.push(lp)
            for a in args:
                val arg: HirCallArg = a
                for lp in effect_expr_loops(arg.value):
                    out = out.push(lp)
        case HirExprKind.Return(value):
            match value:
                Some(v):
                    for lp in effect_expr_loops(v):
                        out = out.push(lp)
                nil:
                    pass_do_nothing("bare return has no sub-expression")
        case _:
            pass_do_nothing("expression kind contains no loop")
    out

# --- copy sites --------------------------------------------------------------

fn effect_is_place_expr(expr: HirExpr) -> bool:
    """True when `expr` reads an EXISTING value rather than constructing one.

    Binding such a place to a struct-typed `val` is a whole-value copy the
    author never wrote -- exactly the `implicit: true` case `check_copy_budget`
    rejects on sight under `@copy_budget(0)`. A `StructLit` initialiser is NOT
    a copy: it constructs in place.
    """
    match expr.kind:
        case HirExprKind.Var(_):
            true
        case HirExprKind.NamedVar(_, _):
            true
        case HirExprKind.Field(_, _, _):
            true
        case HirExprKind.Index(_, _):
            true
        case HirExprKind.TupleIndex(_, _):
            true
        case HirExprKind.Unwrap(_):
            true
        case _:
            false

fn effect_struct_size_of_type(type_: HirType, sizes: Dict<i64, i64>) -> i64:
    """Byte size when `type_` names a non-generic struct of this compilation,
    else -1. Generic instantiations are excluded (no single layout)."""
    match type_.kind:
        case HirTypeKind.Named(symbol, args):
            if args.len() > 0:
                return 0 - 1
            if sizes.contains_key(symbol.id):
                return sizes[symbol.id]
            0 - 1
        case _:
            0 - 1

fn effect_block_copies(block: HirBlock, sizes: Dict<i64, i64>) -> [CopySite]:
    var out: [CopySite] = []
    for st in block.stmts:
        val s: HirStmt = st
        match s.kind:
            case HirStmtKind.Let(_, type_, init):
                val size = effect_struct_size_of_type(type_, sizes)
                if size >= 0 and effect_is_place_expr(init):
                    out = out.push(CopySite(detail: "let binding", bytes: size,
                        implicit: true, line: s.span.line))
                for c in effect_expr_copies(init, sizes):
                    out = out.push(c)
            case HirStmtKind.Expr(e):
                for c in effect_expr_copies(e, sizes):
                    out = out.push(c)
            case HirStmtKind.Assign(_, _, value):
                for c in effect_expr_copies(value, sizes):
                    out = out.push(c)
            case HirStmtKind.Block(inner):
                for c in effect_block_copies(inner, sizes):
                    out = out.push(c)
            case _:
                pass_do_nothing("statement kind carries no copy site")
    if block.has:
        for c in effect_expr_copies(block.value, sizes):
            out = out.push(c)
    out

fn effect_expr_copies(expr: HirExpr, sizes: Dict<i64, i64>) -> [CopySite]:
    var out: [CopySite] = []
    match expr.kind:
        case HirExprKind.If(cond, then_, else_):
            for c in effect_expr_copies(cond, sizes):
                out = out.push(c)
            for c in effect_block_copies(then_, sizes):
                out = out.push(c)
            match else_:
                Some(eb):
                    for c in effect_block_copies(eb, sizes):
                        out = out.push(c)
                nil:
                    pass_do_nothing("if expression has no else block")
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                val typed_arm: HirIfArm = arm
                for c in effect_expr_copies(typed_arm.cond, sizes):
                    out = out.push(c)
                for c in effect_block_copies(typed_arm.then_, sizes):
                    out = out.push(c)
            match else_:
                Some(eb):
                    for c in effect_block_copies(eb, sizes):
                        out = out.push(c)
                nil:
                    pass_do_nothing("if chain has no else block")
        case HirExprKind.MatchCase(_, arms):
            for arm in arms:
                val a: HirMatchArm = arm
                for c in effect_block_copies(a.body, sizes):
                    out = out.push(c)
        case HirExprKind.Loop(body, _):
            for c in effect_block_copies(body, sizes):
                out = out.push(c)
        case HirExprKind.While(_, body, _):
            for c in effect_block_copies(body, sizes):
                out = out.push(c)
        case HirExprKind.For(_, _, body, _):
            for c in effect_block_copies(body, sizes):
                out = out.push(c)
        case HirExprKind.Block(inner):
            for c in effect_block_copies(inner, sizes):
                out = out.push(c)
        case HirExprKind.UnsafeBlock(inner):
            for c in effect_block_copies(inner, sizes):
                out = out.push(c)
        case _:
            pass_do_nothing("expression kind carries no copy site")
    out

# --- direct callees ----------------------------------------------------------

fn effect_callee_name(callee: HirExpr, fn_names: Dict<i64, text>) -> text:
    match callee.kind:
        case HirExprKind.NamedVar(_, name):
            name
        case HirExprKind.Var(symbol):
            if fn_names.contains_key(symbol.id):
                return fn_names[symbol.id]
            ""
        case _:
            ""

fn effect_block_callees(block: HirBlock, fn_names: Dict<i64, text>) -> [text]:
    var out: [text] = []
    for st in block.stmts:
        val s: HirStmt = st
        match s.kind:
            case HirStmtKind.Expr(e):
                for n in effect_expr_callees(e, fn_names):
                    out = out.push(n)
            case HirStmtKind.Let(_, _, init):
                for n in effect_expr_callees(init, fn_names):
                    out = out.push(n)
            case HirStmtKind.Assign(_, _, value):
                for n in effect_expr_callees(value, fn_names):
                    out = out.push(n)
            case HirStmtKind.Block(inner):
                for n in effect_block_callees(inner, fn_names):
                    out = out.push(n)
            case _:
                pass_do_nothing("statement kind carries no call")
    if block.has:
        for n in effect_expr_callees(block.value, fn_names):
            out = out.push(n)
    out

fn effect_expr_callees(expr: HirExpr, fn_names: Dict<i64, text>) -> [text]:
    var out: [text] = []
    match expr.kind:
        case HirExprKind.Call(callee, args, _):
            val name = effect_callee_name(callee, fn_names)
            if name != "" and not out.contains(name):
                out = out.push(name)
            for a in args:
                val arg: HirCallArg = a
                for n in effect_expr_callees(arg.value, fn_names):
                    out = out.push(n)
        case HirExprKind.MethodCall(receiver, _, args, _):
            for n in effect_expr_callees(receiver, fn_names):
                out = out.push(n)
            for a in args:
                val arg: HirCallArg = a
                for n in effect_expr_callees(arg.value, fn_names):
                    out = out.push(n)
        case HirExprKind.If(cond, then_, else_):
            for n in effect_expr_callees(cond, fn_names):
                out = out.push(n)
            for n in effect_block_callees(then_, fn_names):
                out = out.push(n)
            match else_:
                Some(eb):
                    for n in effect_block_callees(eb, fn_names):
                        out = out.push(n)
                nil:
                    pass_do_nothing("if expression has no else block")
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                val typed_arm: HirIfArm = arm
                for n in effect_expr_callees(typed_arm.cond, fn_names):
                    out = out.push(n)
                for n in effect_block_callees(typed_arm.then_, fn_names):
                    out = out.push(n)
            match else_:
                Some(eb):
                    for n in effect_block_callees(eb, fn_names):
                        out = out.push(n)
                nil:
                    pass_do_nothing("if chain has no else block")
        case HirExprKind.MatchCase(scrutinee, arms):
            for n in effect_expr_callees(scrutinee, fn_names):
                out = out.push(n)
            for arm in arms:
                val a: HirMatchArm = arm
                for n in effect_block_callees(a.body, fn_names):
                    out = out.push(n)
        case HirExprKind.Loop(body, _):
            for n in effect_block_callees(body, fn_names):
                out = out.push(n)
        case HirExprKind.While(cond, body, _):
            for n in effect_expr_callees(cond, fn_names):
                out = out.push(n)
            for n in effect_block_callees(body, fn_names):
                out = out.push(n)
        case HirExprKind.For(_, iter, body, _):
            for n in effect_expr_callees(iter, fn_names):
                out = out.push(n)
            for n in effect_block_callees(body, fn_names):
                out = out.push(n)
        case HirExprKind.Block(inner):
            for n in effect_block_callees(inner, fn_names):
                out = out.push(n)
        case HirExprKind.UnsafeBlock(inner):
            for n in effect_block_callees(inner, fn_names):
                out = out.push(n)
        case HirExprKind.Binary(_, left, right):
            for n in effect_expr_callees(left, fn_names):
                out = out.push(n)
            for n in effect_expr_callees(right, fn_names):
                out = out.push(n)
        case HirExprKind.Unary(_, operand):
            for n in effect_expr_callees(operand, fn_names):
                out = out.push(n)
        case HirExprKind.Return(value):
            match value:
                Some(v):
                    for n in effect_expr_callees(v, fn_names):
                        out = out.push(n)
                nil:
                    pass_do_nothing("bare return has no sub-expression")
        case _:
            pass_do_nothing("expression kind contains no call")
    out

# ============================================================================
# Driver entry point
# ============================================================================

# Every identity a compiled module can be recognised by. The effect registry is
# process-wide (it survives across compilations inside one process, e.g. a spec
# run or a long-lived driver), so contracts must be scoped to the modules
# ACTUALLY being compiled here -- identical reasoning, and identical code, to
# `layer_eq_module_identities` in `layer_eq_validation.spl`.
fn effect_module_identities(modules: Dict<text, HirModule>) -> [text]:
    var ids: [text] = []
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if module.path != "" and not ids.contains(module.path):
            ids = ids.push(module.path)
        if module.name != "" and not ids.contains(module.name):
            ids = ids.push(module.name)
        if not ids.contains(module_key):
            ids = ids.push(module_key)
    ids

fn validate_effect_contracts(modules: Dict<text, HirModule>) -> [text]:
    """Prove every recorded `@copy_budget(N)` / `@bounded_loop` contract against
    real lowered bodies; return one diagnostic per violation (empty = clean)."""
    var errors: [text] = []
    val claim_keys = effect_registry_claim_keys()
    if claim_keys.len() == 0:
        return errors

    val module_ids = effect_module_identities(modules)
    val sizes = effect_struct_sizes(modules)
    val fn_names = effect_fn_names(modules)

    # Whole-compilation call graph, so the transitive closure sees callees that
    # are NOT themselves annotated -- an unannotated helper's copy cost is
    # still paid by its annotated caller. Building this from annotated
    # functions alone would be the fail-open shape.
    var graph_names: [text] = []
    var graph_own: [i64] = []
    var graph_callees: [[text]] = []
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        for func in module.functions.values():
            if graph_names.contains(func.name):
                continue
            var own: i64 = 0
            for c in effect_block_copies(func.body, sizes):
                own = own + c.bytes
            graph_names = graph_names.push(func.name)
            graph_own = graph_own.push(own)
            graph_callees = graph_callees.push(effect_block_callees(func.body, fn_names))
    val totals = effect_copy_closure(graph_names, graph_own, graph_callees)

    for key in claim_keys:
        val claim_path = effect_claim_path(key)
        val fn_name = effect_claim_fn(key)
        if fn_name == "":
            continue
        # Out-of-scope contract: recorded for a module that is not part of this
        # compilation. Skipping is correct and is NOT a fail-open -- the module
        # that owns the contract carries it again when it is compiled, and the
        # specs assert that in-scope contracts really do produce diagnostics,
        # so a scoping bug that silenced everything would turn them red.
        if not module_ids.contains(claim_path):
            continue

        val budget = effect_registry_budget_of_key(key)
        val bounded = effect_registry_bounded_of_key(key)

        var found = false
        for module_key in modules.keys():
            val module: HirModule = modules[module_key]
            for func in module.functions.values():
                if func.name != fn_name:
                    continue
                found = true
                val loops = effect_block_loops(func.body)
                val copies = effect_block_copies(func.body, sizes)
                # Callee cost only -- `check_copy_budget` re-adds this body's
                # own sites from `copies`, so passing the closure total here
                # would double-count them.
                var callee_bytes: i64 = 0
                val gi = effect_find_index(graph_names, fn_name)
                if gi >= 0:
                    callee_bytes = totals[gi] - graph_own[gi]
                    if callee_bytes < 0:
                        callee_bytes = 0
                for v in check_copy_budget(fn_name, budget, copies, callee_bytes):
                    errors = errors.push(format_effect_violation(v))
                for v in check_bounded_loops(fn_name, bounded, loops):
                    errors = errors.push(format_effect_violation(v))
        if not found:
            # An annotated function that never reached HIR cannot be proven,
            # and reporting it as proven is exactly the fail-open this pass
            # exists to prevent.
            errors = errors.push("error[effect]: '" + fn_name
                + "' carries an effect contract but is not a function visible in this compilation")
    errors

fn effect_find_index(names: [text], target: text) -> i64:
    var i = 0
    while i < names.len():
        if names[i] == target:
            return i
        i = i + 1
    0 - 1

export validate_effect_contracts, effect_struct_sizes, effect_fn_names
export effect_block_loops, effect_block_copies, effect_block_callees
export effect_while_bound, effect_for_bound, effect_is_growth_method
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection
