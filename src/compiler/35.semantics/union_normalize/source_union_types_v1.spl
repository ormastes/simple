# Invocation-owned structural-union map. The caller supplies a fresh, admitted
# SymbolTable graph; this owner never mutates the borrowed source module.
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolKind, EffectKind}
use compiler.hir.hir_definitions.{HirEnum, HirVariant, HirVariantKind, HirAttribute, HirExpr, HirExprKind}
use compiler.semantics.union_normalize.canonical.{union_member_key, union_variant_name}
use compiler.semantics.union_normalize.source_union_admission_v1.{SourceUnionLedgerV1, SourceUnionErrorV1}

struct SourceUnionEntryV1:
    source: HirType
    normalized: HirType
    enum_symbol: SymbolId
    members: [HirType]
    keys: [text]
    variant_names: [text]
    variant_symbols: [SymbolId]

struct SourceUnionPlanV1:
    source: HirType
    canonical_name: text

class SourceUnionMapV1:
    module: HirModule
    ledger: SourceUnionLedgerV1
    entries: Dict<text, SourceUnionEntryV1>
    symbols: Dict<i64, text>
    nominal_states: Dict<i64, i64>
    registry_checked: bool
    plans: [SourceUnionPlanV1]

impl SourceUnionMapV1:
    static fn create(module: HirModule, ledger: SourceUnionLedgerV1) -> SourceUnionMapV1:
        SourceUnionMapV1(module: module, ledger: ledger, entries: {},
            symbols: {}, nominal_states: {}, registry_checked: false, plans: [])

    fn entry_for_symbol(symbol: SymbolId) -> SourceUnionEntryV1?:
        if self.symbols.has(symbol.id):
            return Some(self.entries[self.symbols[symbol.id]])
        nil

    me visit(depth: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        self.ledger.enter(depth, span)?
        self.ledger.debit("nodes", 1, span)?
        self.ledger.debit("work", 1, span)?
        Ok(())

    # Reserve string construction, retention and comparison work before making
    # the string. All supported terminal keys have a small fixed upper bound.
    me text_units(units: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        self.ledger.debit("key_bytes", units, span)?
        self.ledger.debit("copy_units", units, span)?
        self.ledger.debit("work", units, span)?
        Ok(())

    me compatible(left: HirType, right: HirType, span: Span) -> Result<bool, SourceUnionErrorV1>:
        self.ledger.debit("work", 1, span)?
        # Called only after terminal admission. Exact symbol ID identifies one
        # validated declaration/owner in this invocation, never a source name.
        match left.kind:
            case Int(bits, signed):
                return Ok(match right.kind:
                    case Int(other_bits, other_signed): bits == other_bits and signed == other_signed
                    case _: false)
            case Bool:
                return Ok(match right.kind:
                    case Bool: true
                    case _: false)
            case Char:
                return Ok(match right.kind:
                    case Char: true
                    case _: false)
            case Unit:
                return Ok(match right.kind:
                    case Unit: true
                    case _: false)
            case Named(symbol, args):
                return Ok(match right.kind:
                    case Named(other, other_args): symbol.id == other.id and args.len() == 0 and other_args.len() == 0
                    case _: false)
            case _: return Ok(false)

    me nominal(symbol: SymbolId, span: Span, depth: i64) -> Result<(), SourceUnionErrorV1>:
        if self.nominal_states.has(symbol.id):
            if self.nominal_states[symbol.id] == 2: return Ok(())
            return Err(self.ledger.fail("UNION-E-NOMINAL", "recursive nominal payload requires representation admission", span))
        if not self.module.symbols.symbols.has(symbol.id):
            return Err(self.ledger.fail("UNION-E-NOMINAL", "missing nominal symbol owner", span))
        val row = self.module.symbols.symbols[symbol.id]
        if row.id.id != symbol.id:
            return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal symbol identity mismatch", span))
        if val owner = row.defining_module:
            if owner != self.module.name and owner != self.module.path:
                return Err(self.ledger.fail("UNION-E-NOMINAL", "foreign nominal owner", span))
        else:
            return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal defining owner absent", span))
        if not self.module.symbols.scopes.has(row.scope.id):
            return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal scope absent", span))
        val scope = self.module.symbols.scopes[row.scope.id]
        if scope.id.id != row.scope.id or not scope.symbols.has(row.name):
            return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal scope mirror absent", span))
        if scope.symbols[row.name] != symbol.id:
            return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal scope mirror mismatch", span))
        self.ledger.debit("copy_units", 1, span)?
        self.nominal_states[symbol.id] = 1
        match row.kind:
            case SymbolKind.Struct:
                if not self.module.structs.has(symbol):
                    return Err(self.ledger.fail("UNION-E-NOMINAL", "struct declaration absent", span))
                val definition = self.module.structs[symbol]
                if (definition.symbol.id != symbol.id or definition.name != row.name or
                    definition.type_params.len() != 0 or definition.is_generic_template):
                    return Err(self.ledger.fail("UNION-E-NOMINAL", "struct declaration identity is not closed", span))
                for field in definition.fields:
                    self.visit(depth + 1, field.span)?
                    if field.has_bits_attr or field.has_fixed_address or field.is_volatile:
                        return Err(self.ledger.fail("UNION-E-NOMINAL", "field representation is not admitted", field.span))
                    self.payload(field.type_, depth + 1)?
            case SymbolKind.Enum:
                if not self.module.enums.has(symbol):
                    return Err(self.ledger.fail("UNION-E-NOMINAL", "enum declaration absent", span))
                val definition = self.module.enums[symbol]
                if (definition.symbol.id != symbol.id or definition.name != row.name or
                    definition.type_params.len() != 0 or definition.is_generic_template or
                    definition.complete_open or definition.dyn_open):
                    return Err(self.ledger.fail("UNION-E-NOMINAL", "enum declaration identity is not closed", span))
                for variant in definition.variants:
                    self.visit(depth + 1, variant.span)?
                    if variant.has_discriminant:
                        return Err(self.ledger.fail("UNION-E-NOMINAL", "explicit discriminant requires representation admission", variant.span))
                    match variant.kind:
                        case Unit: ()
                        case Tuple(types):
                            for nested in types: self.payload(nested, depth + 1)?
                        case Struct(fields):
                            for field in fields:
                                if field.has_bits_attr or field.has_fixed_address or field.is_volatile:
                                    return Err(self.ledger.fail("UNION-E-NOMINAL", "variant field representation is not admitted", field.span))
                                self.payload(field.type_, depth + 1)?
            case _:
                return Err(self.ledger.fail("UNION-E-NOMINAL", "nominal symbol is not a struct or enum", span))
        self.nominal_states[symbol.id] = 2
        Ok(())

    me payload(type_: HirType, depth: i64) -> Result<(), SourceUnionErrorV1>:
        if type_ == nil or type_.kind == nil:
            return Err(self.ledger.fail("UNION-E-TYPE", "absent nominal payload type", Span.empty()))
        self.visit(depth, type_.span)?
        match type_.kind:
            case Tuple(elements):
                for element in elements: self.payload(element, depth + 1)?
            case Array(element, size):
                if val count = size:
                    if count < 0: return Err(self.ledger.fail("UNION-E-NOMINAL", "negative nominal array length", type_.span))
                else:
                    return Err(self.ledger.fail("UNION-E-NOMINAL", "unresolved nominal array length", type_.span))
                self.payload(element, depth + 1)?
            case Slice(element): self.payload(element, depth + 1)?
            case Result(ok, error):
                self.payload(ok, depth + 1)?
                self.payload(error, depth + 1)?
            case _: self.terminal(type_, depth)?
        Ok(())

    me terminal(type_: HirType, depth: i64) -> Result<(), SourceUnionErrorV1>:
        if type_ == nil or type_.kind == nil:
            return Err(self.ledger.fail("UNION-E-TYPE", "absent union member type", Span.empty()))
        match type_.kind:
            case Int(bits, _):
                if bits != 8 and bits != 16 and bits != 32 and bits != 64:
                    return Err(self.ledger.fail("UNION-E-MEMBER", "unsupported integer width", type_.span))
            case Bool | Char | Unit: ()
            case Named(symbol, args):
                if args.len() != 0:
                    return Err(self.ledger.fail("UNION-E-MEMBER", "generic nominal union member", type_.span))
                self.nominal(symbol, type_.span, depth)?
            case _:
                return Err(self.ledger.fail("UNION-E-MEMBER", "unsupported union member representation", type_.span))
        Ok(())

    me flatten(type_: HirType, depth: i64, members: [HirType]) -> Result<[HirType], SourceUnionErrorV1>:
        if type_ == nil or type_.kind == nil:
            return Err(self.ledger.fail("UNION-E-TYPE", "absent union member type", Span.empty()))
        self.visit(depth, type_.span)?
        self.ledger.debit("copy_units", members.len(), type_.span)?
        var out = members
        match type_.kind:
            case Union(nested):
                self.ledger.debit("work", nested.len(), type_.span)?
                for member in nested: out = self.flatten(member, depth + 1, out)?
            case Optional(inner):
                out = self.flatten(inner, depth + 1, out)?
                self.ledger.debit("members", 1, type_.span)?
                self.ledger.debit("copy_units", out.len(), type_.span)?
                self.ledger.debit("copy_units", 1, type_.span)?
                out.push(HirType(kind: HirTypeKind.Unit, span: type_.span))
            case _:
                self.terminal(type_, depth)?
                self.ledger.debit("members", 1, type_.span)?
                self.ledger.debit("copy_units", out.len(), type_.span)?
                self.ledger.debit("copy_units", 1, type_.span)?
                out.push(type_)
        Ok(out)

    me registry(span: Span) -> Result<(), SourceUnionErrorV1>:
        if self.registry_checked: return Ok(())
        val table = self.module.symbols
        val symbol_count = table.symbols.len()
        self.ledger.debit("copy_units", symbol_count, span)?
        self.ledger.debit("work", symbol_count, span)?
        val source_ids = table.symbols.keys()
        if source_ids.len() != symbol_count:
            return Err(self.ledger.fail("UNION-E-COUNT", "symbol snapshot count changed", span))
        for raw in source_ids:
            val row = table.symbols[raw]
            self.ledger.debit("work", row.name.len(), span)?
            if row.name.starts_with("__Union_"):
                return Err(self.ledger.fail("UNION-E-REGISTRY", "synthetic-looking ordinary source symbol", row.span))
        val count = table.structural_union_symbols.len()
        self.ledger.debit("copy_units", count, span)?
        self.ledger.debit("work", count, span)?
        val names = table.structural_union_symbols.keys()
        if names.len() != count:
            return Err(self.ledger.fail("UNION-E-COUNT", "registry snapshot count changed", span))
        for name in names:
            self.ledger.debit("work", name.len(), span)?
            val raw = table.structural_union_symbols[name]
            if not table.structural_union_owners.has(raw):
                return Err(self.ledger.fail("UNION-E-REGISTRY", "registry reverse owner absent", span))
            if table.structural_union_owners[raw] != name:
                return Err(self.ledger.fail("UNION-E-REGISTRY", "registry reverse owner mismatch", span))
            if table.symbols.has(raw):
                return Err(self.ledger.fail("UNION-E-REGISTRY", "registry aliases an ordinary source symbol", span))
        val reverse_count = table.structural_union_owners.len()
        self.ledger.debit("copy_units", reverse_count, span)?
        self.ledger.debit("work", reverse_count, span)?
        val raw_ids = table.structural_union_owners.keys()
        if raw_ids.len() != reverse_count:
            return Err(self.ledger.fail("UNION-E-COUNT", "reverse registry snapshot count changed", span))
        for raw in raw_ids:
            val name = table.structural_union_owners[raw]
            self.ledger.debit("work", name.len(), span)?
            if not table.structural_union_symbols.has(name):
                return Err(self.ledger.fail("UNION-E-REGISTRY", "registry forward owner absent", span))
            if table.structural_union_symbols[name] != raw:
                return Err(self.ledger.fail("UNION-E-REGISTRY", "registry forward owner mismatch", span))
        val enum_count = self.module.enums.len()
        self.ledger.debit("copy_units", enum_count, span)?
        self.ledger.debit("work", enum_count, span)?
        val enums = self.module.enums.keys()
        if enums.len() != enum_count:
            return Err(self.ledger.fail("UNION-E-COUNT", "enum snapshot count changed", span))
        for symbol in enums:
            val definition = self.module.enums[symbol]
            self.ledger.debit("work", definition.name.len(), span)?
            if definition.name.starts_with("__Union_"):
                if not table.structural_union_symbols.has(definition.name):
                    return Err(self.ledger.fail("UNION-E-REGISTRY", "synthetic-looking user declaration", definition.span))
                if table.structural_union_symbols[definition.name] != symbol.id:
                    return Err(self.ledger.fail("UNION-E-REGISTRY", "synthetic declaration registry mismatch", definition.span))
                if definition.symbol.id != symbol.id:
                    return Err(self.ledger.fail("UNION-E-REGISTRY", "synthetic declaration symbol mismatch", definition.span))
                self.registry_enum(definition)?
        self.registry_checked = true
        Ok(())

    me registry_enum(definition: HirEnum) -> Result<(), SourceUnionErrorV1>:
        val span = definition.span
        if (definition.runtime_name != definition.name or definition.type_params.len() != 0 or
            definition.is_generic_template or definition.complete_open or definition.dyn_open or
            definition.variants.len() == 0):
            return Err(self.ledger.fail("UNION-E-REGISTRY", "invalid existing structural union declaration", span))
        var closed = false
        for attribute in definition.attributes:
            self.ledger.debit("work", 1, span)?
            if attribute.name == "closed" and attribute.args == "": closed = true
        if not closed:
            return Err(self.ledger.fail("UNION-E-REGISTRY", "existing structural union is not closed", span))
        self.text_units(7, span)?
        var canonical_name = "__Union"
        var previous = ""
        for variant in definition.variants:
            self.visit(0, variant.span)?
            if variant.has_discriminant:
                return Err(self.ledger.fail("UNION-E-REGISTRY", "explicit structural union discriminant", span))
            match variant.kind:
                case Tuple(payload):
                    if payload.len() != 1:
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "existing structural union payload arity", span))
                    self.terminal(payload[0], 0)?
                    self.text_units(64, span)?
                    val key = union_member_key(payload[0])
                    self.ledger.debit("work", 64, span)?
                    if previous != "" and not (previous < key):
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union order or duplicate mismatch", span))
                    self.text_units(key.len(), span)?
                    self.ledger.debit("work", 90, span)?
                    if variant.name != union_variant_name(key):
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union variant spelling mismatch", span))
                    self.text_units(definition.name.len(), span)?
                    self.text_units(2, span)?
                    self.text_units(key.len(), span)?
                    val identity = definition.name + "::" + key
                    if not self.module.symbols.structural_union_symbols.has(identity):
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union variant registry absent", span))
                    if self.module.symbols.structural_union_symbols[identity] != variant.symbol.id:
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union variant registry mismatch", span))
                    self.text_units(canonical_name.len(), span)?
                    self.text_units(1, span)?
                    self.text_units(key.len(), span)?
                    canonical_name = canonical_name + "_" + key
                    previous = key
                case _: return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union payload is not Tuple1", span))
        self.ledger.debit("work", canonical_name.len(), span)?
        if canonical_name != definition.name:
            return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union canonical name mismatch", span))
        Ok(())

    me registry_symbol(identity: text, span: Span) -> Result<SymbolId, SourceUnionErrorV1>:
        if self.module.symbols.structural_union_symbols.has(identity):
            return Ok(SymbolId.new(self.module.symbols.structural_union_symbols[identity]))
        # The existing allocator hashes every byte and probes at most 4096 slots.
        # Reserve its entire bound before invoking it; no hidden unbounded scan.
        self.ledger.debit("work", identity.len(), span)?
        for character in identity: self.ledger.debit("work", 16, span)?
        self.ledger.debit("work", 4097, span)?
        self.ledger.debit("registry_rows", 2, span)?
        self.ledger.debit("copy_units", 2, span)?
        val next = self.module.symbols.next_symbol_id
        if next < 0 or next >= 9223372036854775807:
            return Err(self.ledger.fail("UNION-E-REGISTRY", "invalid registry fallback counter", span))
        if self.module.symbols.symbols.has(next) or self.module.symbols.structural_union_owners.has(next):
            return Err(self.ledger.fail("UNION-E-REGISTRY", "registry fallback counter is occupied", span))
        Ok(self.module.symbols.structural_union_symbol(identity, 0))

    me union_entry(type_: HirType) -> Result<SourceUnionEntryV1?, SourceUnionErrorV1>:
        self.union_at(type_, 0)

    me same_structure(left: HirType, right: HirType, depth: i64) -> Result<bool, SourceUnionErrorV1>:
        # Collision-safe read-only lookup: compare the exact admitted syntax
        # structure, excluding spans. No canonical keys, temporary arrays or
        # names are constructed here. Each visited pair consumes node/work.
        if left == nil or left.kind == nil or right == nil or right.kind == nil:
            return Ok(false)
        self.visit(depth, left.span)?
        match left.kind:
            case Union(members):
                match right.kind:
                    case Union(other):
                        self.ledger.debit("work", members.len(), left.span)?
                        self.ledger.debit("work", other.len(), left.span)?
                        if members.len() != other.len(): return Ok(false)
                        for index in 0..members.len():
                            if not self.same_structure(members[index], other[index], depth + 1)?:
                                return Ok(false)
                        return Ok(true)
                    case _: return Ok(false)
            case Optional(inner):
                match right.kind:
                    case Optional(other): return self.same_structure(inner, other, depth + 1)
                    case _: return Ok(false)
            # These are the only terminal forms that a completed plan admits.
            # Unsupported shapes cannot acquire cached authority by key omission.
            case Int(_, _) | Bool | Char | Unit | Named(_, _):
                return self.compatible(left, right, left.span)
            case _: return Ok(false)

    me remember(source: HirType, name: text) -> Result<(), SourceUnionErrorV1>:
        self.ledger.debit("copy_units", self.plans.len(), source.span)?
        self.ledger.debit("copy_units", 1, source.span)?
        self.plans.push(SourceUnionPlanV1(source: source, canonical_name: name))
        Ok(())

    me union_at(type_: HirType, depth: i64) -> Result<SourceUnionEntryV1?, SourceUnionErrorV1>:
        if type_ == nil or type_.kind == nil:
            return Err(self.ledger.fail("UNION-E-TYPE", "absent union type", Span.empty()))
        match type_.kind:
            case Union(_): ()
            case Named(symbol, args):
                if args.len() != 0:
                    return Err(self.ledger.fail("UNION-E-TYPE", "already-tagged union requires zero generic arguments", type_.span))
                return Ok(self.entry_for_symbol(symbol))
            case _: return Ok(nil)
        self.ledger.debit("work", self.plans.len(), type_.span)?
        for plan in self.plans:
            if self.same_structure(type_, plan.source, depth)?:
                return Ok(Some(self.entries[plan.canonical_name]))
        val flat = self.flatten(type_, depth, [])?
        if flat.len() == 0:
            return Err(self.ledger.fail("UNION-E-MEMBER", "empty structural union", type_.span))
        var members: [HirType] = []
        var keys: [text] = []
        var seen: Dict<text, i64> = {}
        for member in flat:
            # Only exact-width primitives or Named(id,[]) reach this helper.
            # 64 covers signed i64 ID spelling and the length-framed empty list.
            self.text_units(64, member.span)?
            val key = union_member_key(member)
            if seen.has(key):
                if not self.compatible(members[seen[key]], member, member.span)?:
                    return Err(self.ledger.fail("UNION-E-KEY", "incompatible duplicate canonical key", member.span))
            else:
                self.ledger.debit("copy_units", 3, member.span)?
                seen[key] = keys.len()
                keys.push(key)
                members.push(member)
        # Meter each comparison and move before insertion sort performs it.
        var index = 1
        while index < keys.len():
            var cursor = index
            while cursor > 0:
                self.ledger.debit("work", 64, type_.span)?
                if not (keys[cursor] < keys[cursor - 1]): break
                self.ledger.debit("copy_units", 4, type_.span)?
                val saved_key = keys[cursor - 1]
                val saved_member = members[cursor - 1]
                keys[cursor - 1] = keys[cursor]
                members[cursor - 1] = members[cursor]
                keys[cursor] = saved_key
                members[cursor] = saved_member
                cursor = cursor - 1
            index = index + 1
        self.text_units(7, type_.span)?
        var name = "__Union"
        for key in keys:
            self.text_units(name.len(), type_.span)?
            self.text_units(1, type_.span)?
            self.text_units(key.len(), type_.span)?
            name = name + "_" + key
        if self.entries.has(name):
            self.remember(type_, name)?
            return Ok(Some(self.entries[name]))
        self.registry(type_.span)?
        val enum_symbol = self.registry_symbol(name, type_.span)?
        var variant_symbols: [SymbolId] = []
        var variant_names: [text] = []
        for key in keys:
            self.text_units(name.len(), type_.span)?
            self.text_units(2, type_.span)?
            self.text_units(key.len(), type_.span)?
            val identity = name + "::" + key
            val variant_symbol = self.registry_symbol(identity, type_.span)?
            self.text_units(key.len(), type_.span)?
            # union_variant_name scans characters and its first-letter helper
            # scans a fixed 26-letter alphabet; reserve before the helper call.
            self.ledger.debit("work", 26, type_.span)?
            self.ledger.debit("copy_units", key.len(), type_.span)?
            self.ledger.debit("work", key.len(), type_.span)?
            self.ledger.debit("copy_units", 2, type_.span)?
            variant_symbols.push(variant_symbol)
            variant_names.push(union_variant_name(key))
        self.ledger.debit("copy_units", 1, type_.span)?
        val normalized = HirType(kind: HirTypeKind.Named(enum_symbol, []), span: type_.span)
        val entry = SourceUnionEntryV1(source: type_, normalized: normalized,
            enum_symbol: enum_symbol, members: members, keys: keys,
            variant_names: variant_names, variant_symbols: variant_symbols)
        if self.module.enums.has(enum_symbol):
            self.existing_enum(entry, name)?
        else:
            self.install_enum(entry, name)?
        self.ledger.debit("copy_units", 2, type_.span)?
        self.entries[name] = entry
        self.symbols[enum_symbol.id] = name
        self.remember(type_, name)?
        Ok(Some(entry))

    me existing_enum(entry: SourceUnionEntryV1, name: text) -> Result<(), SourceUnionErrorV1>:
        val definition = self.module.enums[entry.enum_symbol]
        val span = entry.source.span
        if (definition.symbol.id != entry.enum_symbol.id or definition.name != name or
            definition.runtime_name != name or definition.type_params.len() != 0 or
            definition.is_generic_template or definition.complete_open or definition.dyn_open or
            definition.variants.len() != entry.members.len()):
            return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union declaration identity mismatch", span))
        var closed = false
        for attribute in definition.attributes:
            self.ledger.debit("work", 1, span)?
            if attribute.name == "closed" and attribute.args == "": closed = true
        if not closed:
            return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union declaration is not closed", span))
        for index in 0..entry.members.len():
            self.ledger.debit("work", 1, span)?
            val variant = definition.variants[index]
            if (variant.symbol.id != entry.variant_symbols[index].id or
                variant.name != entry.variant_names[index] or variant.has_discriminant):
                return Err(self.ledger.fail("UNION-E-REGISTRY", "existing union variant identity mismatch", span))
            match variant.kind:
                case Tuple(payload):
                    if payload.len() != 1:
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "union payload must have arity one", span))
                    self.terminal(payload[0], 0)?
                    if not self.compatible(payload[0], entry.members[index], span)?:
                        return Err(self.ledger.fail("UNION-E-REGISTRY", "union payload type mismatch", span))
                case _: return Err(self.ledger.fail("UNION-E-REGISTRY", "union payload must be a tuple", span))
        Ok(())

    me install_enum(entry: SourceUnionEntryV1, name: text) -> Result<(), SourceUnionErrorV1>:
        # Field-for-field equivalent to the unexported
        # synth_union_enum_normalized_with_symbols; shared owner stays untouched.
        var variants: [HirVariant] = []
        for index in 0..entry.members.len():
            self.ledger.debit("copy_units", 4, entry.source.span)?
            variants.push(HirVariant(symbol: entry.variant_symbols[index],
                name: entry.variant_names[index], kind: HirVariantKind.Tuple([entry.members[index]]),
                has_discriminant: false,
                discriminant: HirExpr(kind: HirExprKind.UnitLit, has_type_: false,
                    type_: entry.source, span: entry.source.span), span: entry.source.span))
        self.ledger.debit("copy_units", 3, entry.source.span)?
        self.module.enums[entry.enum_symbol] = HirEnum(symbol: entry.enum_symbol,
            name: name, runtime_name: name, type_params: [], variants: variants,
            visibility: Visibility.Private, is_public: false, has_doc_comment: false,
            doc_comment: "", span: entry.source.span, is_generic_template: false,
            has_specialization_of: false, specialization_of: "", type_bindings: {},
            attributes: [HirAttribute(name: "closed", args: "")],
            complete_open: false, dyn_open: false)
        Ok(())

    me normalize_type(type_: HirType, span: Span) -> Result<HirType, SourceUnionErrorV1>:
        self.normalize_at(type_, span, 0, true, "type")

    me normalize_at(type_: HirType, span: Span, depth: i64, direct: bool, path: text) -> Result<HirType, SourceUnionErrorV1>:
        self.visit(depth, span)?
        if type_ == nil or type_.kind == nil:
            return Err(self.ledger.fail("UNION-E-TYPE", "absent carrier type", span))
        match type_.kind:
            case Union(_):
                if not direct:
                    return Err(self.ledger.fail("UNION-E-CARRIER", "union nested under " + path, span))
                if val entry = self.union_at(type_, depth)?:
                    return Ok(entry.normalized)
                return Err(self.ledger.fail("UNION-E-TYPE", "union map entry absent", span))
            case Function(params, result, effects):
                self.ledger.debit("copy_units", params.len(), span)?
                var mapped: [HirType] = []
                for param in params:
                    mapped.push(self.normalize_at(param, span, depth + 1, direct, "function parameter")?)
                val return_type = self.normalize_at(result, span, depth + 1, direct, "function return")?
                for effect in effects:
                    self.visit(depth + 1, span)?
                    if effect == nil or effect.kind == nil:
                        return Err(self.ledger.fail("UNION-E-TYPE", "absent function effect", span))
                    match effect.kind:
                        case EffectKind.Throws(payload):
                            self.normalize_at(payload, span, depth + 1, false, "function effect")?
                        case _: ()
                self.ledger.debit("copy_units", 1, span)?
                return Ok(HirType(kind: HirTypeKind.Function(mapped, return_type, effects), span: type_.span))
            case Optional(inner): self.normalize_at(inner, span, depth + 1, false, "Optional")?
            case Array(inner, _): self.normalize_at(inner, span, depth + 1, false, "Array")?
            case Slice(inner): self.normalize_at(inner, span, depth + 1, false, "Slice")?
            case Ref(inner, _): self.normalize_at(inner, span, depth + 1, false, "Ref")?
            case Ptr(inner, _): self.normalize_at(inner, span, depth + 1, false, "Ptr")?
            case Isolated(inner): self.normalize_at(inner, span, depth + 1, false, "Isolated")?
            case Unique(inner): self.normalize_at(inner, span, depth + 1, false, "Unique")?
            case Shared(inner): self.normalize_at(inner, span, depth + 1, false, "Shared")?
            case Weak(inner): self.normalize_at(inner, span, depth + 1, false, "Weak")?
            case Projection(inner, _): self.normalize_at(inner, span, depth + 1, false, "Projection")?
            case Tensor(inner, _, _): self.normalize_at(inner, span, depth + 1, false, "Tensor")?
            case Result(ok, error):
                self.normalize_at(ok, span, depth + 1, false, "Result.ok")?
                self.normalize_at(error, span, depth + 1, false, "Result.error")?
            case Dict(key, value):
                self.normalize_at(key, span, depth + 1, false, "Dict.key")?
                self.normalize_at(value, span, depth + 1, false, "Dict.value")?
            case Tuple(elements):
                for element in elements: self.normalize_at(element, span, depth + 1, false, "Tuple")?
            case Named(_, args):
                for arg in args: self.normalize_at(arg, span, depth + 1, false, "Named argument")?
            case TypeParam(_, bounds):
                for bound in bounds: self.normalize_at(bound, span, depth + 1, false, "TypeParam bound")?
            case Int(_, _) | Float(_) | Bool | Char | Str | Unit | DynTrait(_) | Infer(_, _) | Error | Never | Any | Layer(_, _): ()
        Ok(type_)

export SourceUnionEntryV1, SourceUnionMapV1
