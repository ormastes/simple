# Read-only bounded HIR traversal. No canonical keys, registration or rewrites.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.union_normalize.source_union_admission_v1.*

use compiler.semantics.union_normalize.source_union_preflight_walk_v1.{SourceUnionPreflightV1}

# Module snapshots are admitted once. The key list sort is insertion sort,
# with each comparison charged before it happens; no n*n arithmetic occurs.
# Order is actual defining owner, name, declaration kind, then SymbolId.
struct SourceUnionDeclarationV1:
    symbol: SymbolId
    owner: text
    name: text
    kind: text

fn source_union_declaration_before_v1(left: SourceUnionDeclarationV1, right: SourceUnionDeclarationV1) -> bool:
    if left.owner != right.owner: return left.owner < right.owner
    if left.name != right.name: return left.name < right.name
    if left.kind != right.kind: return left.kind < right.kind
    left.symbol.id < right.symbol.id

fn source_union_preflight_v1(module: HirModule, ledger: SourceUnionLedgerV1) -> Result<bool, SourceUnionErrorV1>:
    val span = Span.empty()
    if module == nil:
        return Err(ledger.fail("UNION-E-TYPE", "absent HIR module", span))
    ledger.enter(0, span)?
    ledger.debit("nodes", 1, span)?
    ledger.debit("work", 1, span)?
    ledger.debit("copy_units", 1, span)?
    if module.symbols == nil:
        return Err(ledger.fail("UNION-E-SCOPE", "absent module symbol owner", span))
    if module.symbols.current_scope == nil or module.symbols.scopes == nil:
        return Err(ledger.fail("UNION-E-SCOPE", "absent current scope or scope dictionary", span))
    if not module.symbols.scopes.has(module.symbols.current_scope.id):
        return Err(ledger.fail("UNION-E-SCOPE", "absent current scope row", span))
    if module.symbols.scopes[module.symbols.current_scope.id] == nil:
        return Err(ledger.fail("UNION-E-SCOPE", "absent current scope row", span))
    var visitor = SourceUnionPreflightV1(ledger: ledger, direct_functions: {}, required_signatures: {})
    visitor.module_metadata(module)?
    var declarations: [SourceUnionDeclarationV1] = []
    val functions_count = if module.functions == nil: 0 else: module.functions.len()
    visitor.slots(functions_count, span)?
    visitor.slots(functions_count, span)?
    val functions_keys: [SymbolId] = if module.functions == nil: [] else: module.functions.keys()
    source_union_check_snapshot_v1(functions_count, source_union_array_count_v1(functions_keys), ledger, span)?
    for id in functions_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.functions[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.functions[id].symbol == nil or module.functions[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.functions[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.functions[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.functions[id].name, kind: "function"))
        ledger.debit("copy_units", 1, span)?
        visitor.direct_functions[id.id] = true
    val classes_count = if module.classes == nil: 0 else: module.classes.len()
    visitor.slots(classes_count, span)?
    visitor.slots(classes_count, span)?
    val classes_keys: [SymbolId] = if module.classes == nil: [] else: module.classes.keys()
    source_union_check_snapshot_v1(classes_count, source_union_array_count_v1(classes_keys), ledger, span)?
    for id in classes_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.classes[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.classes[id].symbol == nil or module.classes[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.classes[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.classes[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.classes[id].name, kind: "class"))
    val structs_count = if module.structs == nil: 0 else: module.structs.len()
    visitor.slots(structs_count, span)?
    visitor.slots(structs_count, span)?
    val structs_keys: [SymbolId] = if module.structs == nil: [] else: module.structs.keys()
    source_union_check_snapshot_v1(structs_count, source_union_array_count_v1(structs_keys), ledger, span)?
    for id in structs_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.structs[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.structs[id].symbol == nil or module.structs[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.structs[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.structs[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.structs[id].name, kind: "struct"))
    val enums_count = if module.enums == nil: 0 else: module.enums.len()
    visitor.slots(enums_count, span)?
    visitor.slots(enums_count, span)?
    val enums_keys: [SymbolId] = if module.enums == nil: [] else: module.enums.keys()
    source_union_check_snapshot_v1(enums_count, source_union_array_count_v1(enums_keys), ledger, span)?
    for id in enums_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.enums[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.enums[id].symbol == nil or module.enums[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.enums[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.enums[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.enums[id].name, kind: "enum"))
    val bitfields_count = if module.bitfields == nil: 0 else: module.bitfields.len()
    visitor.slots(bitfields_count, span)?
    visitor.slots(bitfields_count, span)?
    val bitfields_keys: [SymbolId] = if module.bitfields == nil: [] else: module.bitfields.keys()
    source_union_check_snapshot_v1(bitfields_count, source_union_array_count_v1(bitfields_keys), ledger, span)?
    for id in bitfields_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.bitfields[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.bitfields[id].symbol == nil or module.bitfields[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.bitfields[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.bitfields[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.bitfields[id].name, kind: "bitfield"))
    val traits_count = if module.traits == nil: 0 else: module.traits.len()
    visitor.slots(traits_count, span)?
    visitor.slots(traits_count, span)?
    val traits_keys: [SymbolId] = if module.traits == nil: [] else: module.traits.keys()
    source_union_check_snapshot_v1(traits_count, source_union_array_count_v1(traits_keys), ledger, span)?
    for id in traits_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.traits[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.traits[id].symbol == nil or module.traits[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.traits[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.traits[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.traits[id].name, kind: "trait"))
    val constants_count = if module.constants == nil: 0 else: module.constants.len()
    visitor.slots(constants_count, span)?
    visitor.slots(constants_count, span)?
    val constants_keys: [SymbolId] = if module.constants == nil: [] else: module.constants.keys()
    source_union_check_snapshot_v1(constants_count, source_union_array_count_v1(constants_keys), ledger, span)?
    for id in constants_keys:
        if id == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration key", span))
        if id.id < 0 or module.constants[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration row or invalid key", span))
        if module.constants[id].symbol == nil or module.constants[id].name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent declaration identity", span))
        if module.constants[id].symbol.id != id.id: return Err(ledger.fail("UNION-E-SCOPE", "declaration identity mismatch", span))
        ledger.debit("copy_units", 4, span)?
        if module.symbols.symbols == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol dictionary", span))
        if not module.symbols.symbols.has(id.id):
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol is absent", span))
        if module.symbols.symbols[id.id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol row", span))
        if module.symbols.symbols[id.id].id == nil or module.symbols.symbols[id.id].scope == nil or module.symbols.symbols[id.id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent declaration symbol identity or kind", span))
        if module.symbols.symbols[id.id].id.id != id.id:
            return Err(ledger.fail("UNION-E-SCOPE", "declaration symbol identity mismatch", span))
        var owner = ""
        if val defining = module.symbols.symbols[id.id].defining_module:
            visitor.text(defining, span)?
            owner = defining
        visitor.text(module.constants[id].name, span)?
        declarations.push(SourceUnionDeclarationV1(symbol: id, owner: owner, name: module.constants[id].name, kind: "constant"))
    # Required trait signatures can also appear in module.functions. Record
    # their actual SymbolIds before any function-body requirement is applied.
    for id in traits_keys:
        visitor.slots(source_union_array_count_v1(module.traits[id].methods), span)?
        for method in module.traits[id].methods:
            if method == nil: return Err(ledger.fail("UNION-E-TYPE", "absent required trait method", span))
            if method.symbol == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent required trait method identity", span))
            ledger.debit("copy_units", 1, span)?
            visitor.required_signatures[method.symbol.id] = true
    var index = 1
    while index < declarations.len():
        var cursor = index
        while cursor > 0:
            ledger.debit("work", 1, span)?
            # Text comparisons can inspect every character; precharge both
            # records conservatively before invoking text comparison.
            ledger.debit("work", declarations[cursor].owner.len(), span)?
            ledger.debit("work", declarations[cursor - 1].owner.len(), span)?
            ledger.debit("work", declarations[cursor].name.len(), span)?
            ledger.debit("work", declarations[cursor - 1].name.len(), span)?
            ledger.debit("work", declarations[cursor].kind.len(), span)?
            ledger.debit("work", declarations[cursor - 1].kind.len(), span)?
            if not source_union_declaration_before_v1(declarations[cursor], declarations[cursor - 1]): break
            ledger.debit("copy_units", 3, span)?
            val previous = declarations[cursor - 1]
            declarations[cursor - 1] = declarations[cursor]
            declarations[cursor] = previous
            cursor = cursor - 1
        index = index + 1
    for declaration in declarations:
        val id = declaration.symbol
        match declaration.kind:
            case "function": visitor.function(module.functions[id], 1, visitor.required_signatures.has(id.id))?
            case "class":
                val value = module.classes[id]
                visitor.node(1, value.span)?
                visitor.type_params(value.type_params, 2)?
                visitor.fields(value.fields, 2)?
                visitor.bindings(value.type_bindings, 2, value.span)?
                visitor.text_id_index(value.methods, value.span)?
                visitor.text(value.doc_comment, value.span)?
                if value.export_attr != nil: visitor.text(value.export_attr.export_name, value.span)?
                elif value.has_export_attr: return Err(ledger.fail("UNION-E-TYPE", "absent export attribute", value.span))
                visitor.text(value.platform_diagnostic_message, value.span)?
                visitor.text(value.specialization_of, value.span)?
            case "struct":
                val value = module.structs[id]
                visitor.node(1, value.span)?
                visitor.type_params(value.type_params, 2)?
                visitor.fields(value.fields, 2)?
                visitor.bindings(value.type_bindings, 2, value.span)?
                visitor.text(value.doc_comment, value.span)?
                visitor.text(value.platform_diagnostic_message, value.span)?
                visitor.text(value.specialization_of, value.span)?
            case "enum": visitor.enum_(module.enums[id], 1)?
            case "bitfield":
                val value = module.bitfields[id]
                visitor.node(1, value.span)?
                visitor.text(value.doc_comment, value.span)?
                visitor.type_(value.backing_type, 2, false, false, "bitfield backing type")?
                visitor.slots(source_union_array_count_v1(value.fields), value.span)?
                for field in value.fields:
                    if field == nil: return Err(ledger.fail("UNION-E-TYPE", "absent bitfield field", span))
                    if field.symbol == nil or field.name == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent bitfield field identity", span))
                    visitor.node(2, field.span)?
                    visitor.text(field.name, field.span)?
                    visitor.retained_type(field.has_type_, field.type_, 3, "bitfield field", false)?
            case "trait": visitor.trait_(module.traits[id], 1)?
            case "constant":
                val value = module.constants[id]
                visitor.node(1, value.span)?
                visitor.type_(value.type_, 2, true, false, "module constant")?
                visitor.expr(value.value, 2)?
    val symbols_count = if module.symbols.symbols == nil: 0 else: module.symbols.symbols.len()
    visitor.slots(symbols_count, span)?
    val symbols_keys: [i64] = if module.symbols.symbols == nil: [] else: module.symbols.symbols.keys()
    source_union_check_snapshot_v1(symbols_count, source_union_array_count_v1(symbols_keys), ledger, span)?
    for id in symbols_keys:
        if id < 0 or module.symbols.symbols[id] == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent symbol row or invalid key", span))
        if module.symbols.symbols[id].id == nil or module.symbols.symbols[id].scope == nil or module.symbols.symbols[id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent symbol identity, scope or kind", span))
        if module.symbols.symbols[id].id.id != id: return Err(ledger.fail("UNION-E-SCOPE", "symbol identity mismatch", span))
        visitor.node(1, module.symbols.symbols[id].span)?
        if val type_ = module.symbols.symbols[id].type_:
            if visitor.direct_functions.has(id):
                visitor.signature_type(type_, 2)?
            else:
                visitor.type_(type_, 2, true, false, "symbol type")?
    visitor.slots(source_union_array_count_v1(module.impls), span)?
    for value in module.impls:
        if value == nil: return Err(ledger.fail("UNION-E-TYPE", "absent impl declaration", span))
        visitor.node(1, value.span)?
        visitor.type_(value.type_, 2, false, false, "impl owner")?
        visitor.retained_type(value.has_trait_, value.trait_, 2, "impl trait", false)?
        visitor.type_params(value.type_params, 2)?
        visitor.text_id_index(value.methods, value.span)?
        visitor.text_text_index(value.method_return_struct_names, value.span)?
        visitor.text_bool_index(value.method_return_is_array, value.span)?
        visitor.text_bool_index(value.method_return_is_optional, value.span)?
        visitor.bounds(value.where_clause, 2, value.span)?
        visitor.slots(source_union_array_count_v1(value.assoc_type_impls), value.span)?
        for item in value.assoc_type_impls:
            if item == nil: return Err(ledger.fail("UNION-E-TYPE", "absent associated implementation", span))
            visitor.node(2, value.span)?
            visitor.text(item.name, value.span)?
            visitor.type_(item.concrete_type, 3, false, false, "associated implementation")?
    visitor.slots(source_union_array_count_v1(module.static_asserts), span)?
    for item in module.static_asserts:
        if item == nil: return Err(ledger.fail("UNION-E-TYPE", "absent static assertion", span))
        visitor.node(1, item.span)?
        visitor.expr(item.condition, 2)?
        visitor.text(item.message, item.span)?
    if source_union_array_count_v1(module.extend_enums) > 0:
        visitor.opaque("unlowered enum extension payload", span)
    # Metadata has no typed HIR children. Its opaque frontend objects cannot
    # be retained on a union rewrite without a dedicated clone/admission.
    if source_union_array_count_v1(module.domain_blocks) > 0:
        visitor.opaque("custom domain block metadata", span)
    if visitor.union_sites > 0 and visitor.opaque_position != "":
        return Err(ledger.fail("UNION-E-POSITION", visitor.opaque_position, visitor.opaque_span))
    Ok(visitor.union_sites > 0)

export source_union_preflight_v1
