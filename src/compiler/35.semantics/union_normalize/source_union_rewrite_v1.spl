# Invocation-owned structural union conversion. No parser, runtime or proof
# authority is manufactured here. Input ownership is established by the caller.
use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_lowering.type_equality.{hir_types_equal}
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.union_normalize.source_union_admission_v1.{
    SourceUnionLedgerV1, SourceUnionErrorV1
}
use compiler.semantics.union_normalize.source_union_types_v1.{
    SourceUnionMapV1, SourceUnionEntryV1
}

class SourceUnionRewriterV1:
    map: SourceUnionMapV1
    original_types: Dict<i64, HirType>

impl SourceUnionRewriterV1:
    static fn create(map: SourceUnionMapV1) -> SourceUnionRewriterV1:
        SourceUnionRewriterV1(map: map, original_types: {})

    fn error(message: text, span: Span) -> SourceUnionErrorV1:
        self.map.ledger.fail("UNION-E-CARRIER", message, span)

    me visit(depth: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        self.map.ledger.enter(depth, span)?
        self.map.ledger.debit("nodes", 1, span)?
        self.map.ledger.debit("work", 1, span)?
        self.map.ledger.debit("copy_units", 1, span)

    me slots(count: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        self.map.ledger.debit("copy_units", count, span)?
        self.map.ledger.debit("work", count, span)

    fn original_symbol_type(symbol: SymbolId) -> HirType?:
        if self.original_types.has(symbol.id):
            return Some(self.original_types[symbol.id])
        nil

    fn expression_type(expr: HirExpr) -> HirType?:
        match expr.kind:
            case Var(symbol) | NamedVar(symbol, _):
                return self.original_symbol_type(symbol)
            case BoolLit(_): return Some(HirType(kind: HirTypeKind.Bool, span: expr.span))
            case CharLit(_): return Some(HirType(kind: HirTypeKind.Char, span: expr.span))
            case UnitLit | NilLit: return Some(HirType(kind: HirTypeKind.Unit, span: expr.span))
            case _: ()
        if expr.has_type_ and expr.type_ != nil:
            match expr.type_.kind:
                case Infer(_, _) | Error | Any: return nil
                case _: return Some(expr.type_)
        nil

    me require_narrowed(expr: HirExpr) -> Result<(), SourceUnionErrorV1>:
        if val type_ = self.expression_type(expr):
            if val entry = self.map.union_entry(type_)?:
                return Err(self.error("operation requires explicit union narrowing", expr.span))
        Ok(())

    me annotate_symbol(symbol: SymbolId, type_: HirType, span: Span
    ) -> Result<(), SourceUnionErrorV1>:
        if not self.map.module.symbols.symbols.has(symbol.id):
            return Err(self.error("missing symbol for typed carrier", span))
        var row = self.map.module.symbols.symbols[symbol.id]
        if row.id.id != symbol.id:
            return Err(self.error("symbol key disagrees with typed carrier", span))
        row.type_ = Some(type_)
        self.map.module.symbols.symbols[symbol.id] = row
        Ok(())

    me convert(expr: HirExpr, actual: HirType?, expected: HirType?
    ) -> Result<HirExpr, SourceUnionErrorV1>:
        var out = expr
        if val target = expected:
            val mapped = self.map.normalize_type(target, expr.span)?
            val possible = self.map.union_entry(target)?
            if val entry = possible:
                if val known = actual:
                    val normalized_actual = self.map.normalize_type(known, expr.span)?
                    if hir_types_equal(normalized_actual, entry.normalized):
                        out.has_type_ = true
                        out.type_ = entry.normalized
                        return Ok(out)
                var selected: i64 = -1
                for index in 0..entry.members.len():
                    self.map.ledger.debit("work", 1, expr.span)?
                    var matches = false
                    if val known = actual:
                        matches = hir_types_equal(known, entry.members[index])
                    else:
                        # Literal evidence is used only under one exact
                        # declared integer slot. It never infers another value.
                        match expr.kind:
                            case IntLit(value, suffix):
                                match entry.members[index].kind:
                                    case Int(bits, signed):
                                        val spelling = (if signed: "i" else: "u") + bits.to_string()
                                        var suffix_matches = true
                                        if val explicit_suffix = suffix:
                                            suffix_matches = explicit_suffix == spelling
                                        if suffix_matches:
                                            if bits == 64:
                                                matches = signed or value >= 0
                                            elif bits > 0 and bits < 64:
                                                var bound: i64 = 1
                                                val magnitude = if signed: bits - 1 else: bits
                                                for bit in 0..magnitude: bound = bound * 2
                                                matches = if signed: value >= -bound and value < bound else: value >= 0 and value < bound
                                    case _: ()
                            case _: ()
                    if matches:
                        if selected >= 0:
                            return Err(self.error("ambiguous union member introduction", expr.span))
                        selected = index
                if selected < 0:
                    return Err(self.error("missing exact member evidence for union introduction", expr.span))
                self.map.ledger.debit("injections", 1, expr.span)?
                self.map.ledger.debit("nodes", 1, expr.span)?
                self.map.ledger.debit("copy_units", 2, expr.span)?
                var payload = out
                # Existing synthetic enums represent nil as Tuple([Unit]).
                match payload.kind:
                    case NilLit: payload.kind = HirExprKind.UnitLit
                    case _: ()
                payload.has_type_ = true
                payload.type_ = entry.members[selected]
                out.kind = HirExprKind.EnumLit(entry.normalized,
                    entry.variant_names[selected], Some(HirEnumPayload.Tuple([payload])))
                out.has_type_ = true
                out.type_ = entry.normalized
                return Ok(out)
            if val known = actual:
                if val source_entry = self.map.union_entry(known)?:
                    return Err(self.error("union value requires explicit narrowing", expr.span))
                # A declared variable/member is resolved evidence, not a
                # contextual literal. Never overwrite a contradictory type.
                # Unknown inference remains owned by ordinary HIR lowering.
                match known.kind:
                    case Infer(_, _) | Error | Any: ()
                    case _:
                        val normalized_actual = self.map.normalize_type(known, expr.span)?
                        if not hir_types_equal(normalized_actual, mapped):
                            return Err(self.error("known expression type disagrees with expected carrier", expr.span))
            out.has_type_ = true
            out.type_ = mapped
        elif val known = actual:
            out.has_type_ = true
            out.type_ = self.map.normalize_type(known, expr.span)?
        Ok(out)

    me block(block: HirBlock, expected: HirType?, result: HirType, depth: i64
    ) -> Result<HirBlock, SourceUnionErrorV1>:
        self.visit(depth, block.span)?
        self.slots(block.stmts.len(), block.span)?
        var out = HirBlock(stmts: [], has: block.has, value: nil,
            span: block.span, unsafe_caps: block.unsafe_caps)
        var statements: [HirStmt] = []
        for statement in block.stmts:
            self.visit(depth + 1, statement.span)?
            var rewritten = HirStmt(kind: HirStmtKind.Block(
                HirBlock(stmts: [], has: false, value: nil, span: statement.span)),
                span: statement.span)
            match statement.kind:
                case Let(symbol, type_, init):
                    val mapped = self.map.normalize_type(type_, statement.span)?
                    val value = self.expression(init, Some(type_), result, depth + 2)?
                    self.original_types[symbol.id] = type_
                    self.annotate_symbol(symbol, mapped, statement.span)?
                    rewritten.kind = HirStmtKind.Let(symbol, mapped, value)
                case Expr(value):
                    rewritten.kind = HirStmtKind.Expr(self.expression(value, nil, result, depth + 2)?)
                case Assign(target, op, value):
                    val target_type = self.expression_type(target)
                    if target_type == nil:
                        return Err(self.error("assignment lacks resolved target type", statement.span))
                    if op != nil:
                        if val entry = self.map.union_entry(target_type.unwrap())?:
                            return Err(self.error("compound operation on union requires explicit narrowing", statement.span))
                    match target.kind:
                        case Var(_) | NamedVar(_, _): ()
                        case _: return Err(self.error("union-stage assignment requires an owned local", statement.span))
                    val new_target = self.expression(target, nil, result, depth + 2)?
                    val new_value = self.expression(value, target_type, result, depth + 2)?
                    rewritten.kind = HirStmtKind.Assign(new_target, op, new_value)
                case Block(nested):
                    rewritten.kind = HirStmtKind.Block(self.block(nested, nil, result, depth + 2)?)
                case AsmAssert(_):
                    return Err(self.error("assembly carrier is outside the union source stage", statement.span))
            statements.push(rewritten)
        out.stmts = statements
        if block.has:
            out.value = self.expression(block.value, expected, result, depth + 1)?
        elif val target = expected:
            if val entry = self.map.union_entry(target)?:
                return Err(self.error("union result block has no value", block.span))
        Ok(out)

    me pattern(pattern: HirPattern, type_: HirType, depth: i64
    ) -> Result<HirPattern, SourceUnionErrorV1>:
        self.visit(depth, pattern.span)?
        var out = pattern
        out.has_type_ = true
        out.type_ = type_
        match pattern.kind:
            case Binding(symbol, mutable):
                self.original_types[symbol.id] = type_
                self.annotate_symbol(symbol, type_, pattern.span)?
            case Wildcard: ()
            case Literal(_): ()
            case _:
                return Err(self.error("unsupported nested union member pattern", pattern.span))
        Ok(out)

    me union_arm(arm: HirMatchArm, entry: SourceUnionEntryV1,
        expected: HirType?, result: HirType, depth: i64
    ) -> Result<HirMatchArm, SourceUnionErrorV1>:
        self.visit(depth, arm.span)?
        var out = HirMatchArm(pattern: arm.pattern, has_guard: arm.has_guard,
            guard: nil, body: nil, span: arm.span)
        match arm.pattern.kind:
            case Enum(type_, variant, payload):
                match type_.kind:
                    case Named(symbol, args):
                        if symbol.id != entry.enum_symbol.id or args.len() != 0:
                            return Err(self.error("narrowing enum identity disagrees with union registry", arm.span))
                    case _: return Err(self.error("narrowing lacks a registered enum owner", arm.span))
                var index: i64 = -1
                for candidate in 0..entry.variant_names.len():
                    self.map.ledger.debit("work", 1, arm.span)?
                    if entry.variant_names[candidate] == variant: index = candidate
                if index < 0:
                    return Err(self.error("narrowing variant is not a canonical union member", arm.span))
                var patterns: [HirPattern] = []
                if val supplied = payload:
                    match supplied:
                        case Tuple(values):
                            if values.len() != 1:
                                return Err(self.error("union narrowing requires exactly one member payload", arm.span))
                            patterns.push(self.pattern(values[0], entry.members[index], depth + 1)?)
                        case _: return Err(self.error("union narrowing payload must be tuple-shaped", arm.span))
                else:
                    match entry.members[index].kind:
                        case Unit:
                            self.map.ledger.debit("nodes", 1, arm.span)?
                            self.map.ledger.debit("copy_units", 1, arm.span)?
                            patterns.push(HirPattern(kind: HirPatternKind.Wildcard,
                                has_type_: true, type_: entry.members[index], span: arm.pattern.span))
                        case _: return Err(self.error("union narrowing omits a member payload", arm.span))
                var pattern = arm.pattern
                pattern.kind = HirPatternKind.Enum(entry.normalized, variant,
                    Some(HirPatternPayload.Tuple(patterns)))
                pattern.has_type_ = true
                pattern.type_ = entry.normalized
                out.pattern = pattern
            case Wildcard:
                # Exhaustiveness and closed-enum wildcard policy remain owned
                # by the actual enum semantic validator.
                out.pattern.has_type_ = true
                out.pattern.type_ = entry.normalized
            case _: return Err(self.error("union arm was not lowered to a registered enum pattern", arm.span))
        if arm.has_guard:
            out.guard = self.expression(arm.guard,
                Some(HirType(kind: HirTypeKind.Bool, span: arm.guard.span)), result, depth + 1)?
        out.body = self.block(arm.body, expected, result, depth + 1)?
        Ok(out)

    me expression(expr: HirExpr, expected: HirType?, result: HirType, depth: i64
    ) -> Result<HirExpr, SourceUnionErrorV1>:
        self.visit(depth, expr.span)?
        # Reconstruct the node instead of copying its old recursive subtree
        # only to replace that subtree immediately.
        var out = HirExpr(kind: HirExprKind.UnitLit, has_type_: expr.has_type_,
            type_: expr.type_, span: expr.span)
        var actual = self.expression_type(expr)
        match expr.kind:
            case IntLit(_, _) | BoolLit(_) | CharLit(_) | UnitLit | NilLit | FloatLit(_, _) | FloatLexeme(_, _):
                out.kind = expr.kind
            case StringLit(_, interpolations):
                if val items = interpolations:
                    if items.len() > 0:
                        return Err(self.error("interpolated string carrier is outside the union source stage", expr.span))
                out.kind = expr.kind
            case Var(_) | NamedVar(_, _): out.kind = expr.kind
            case Unary(op, value):
                self.require_narrowed(value)?
                out.kind = HirExprKind.Unary(op, self.expression(value, nil, result, depth + 1)?)
            case Binary(op, left, right):
                self.require_narrowed(left)?
                self.require_narrowed(right)?
                val first = self.expression(left, nil, result, depth + 1)?
                val second = self.expression(right, nil, result, depth + 1)?
                out.kind = HirExprKind.Binary(op, first, second)
            case Block(body):
                out.kind = HirExprKind.Block(self.block(body, expected, result, depth + 1)?)
                actual = expected
            case If(condition, then_, else_):
                val test = self.expression(condition,
                    Some(HirType(kind: HirTypeKind.Bool, span: condition.span)), result, depth + 1)?
                val yes = self.block(then_, expected, result, depth + 1)?
                var no: HirBlock? = nil
                if val other = else_: no = Some(self.block(other, expected, result, depth + 1)?)
                out.kind = HirExprKind.If(test, yes, no)
                actual = expected
            case MatchCase(scrutinee, arms):
                val subject_type = self.expression_type(scrutinee)
                var entry: SourceUnionEntryV1? = nil
                if val subject = subject_type: entry = self.map.union_entry(subject)?
                val subject = self.expression(scrutinee, nil, result, depth + 1)?
                self.slots(arms.len(), expr.span)?
                var rewritten: [HirMatchArm] = []
                for arm in arms:
                    if val union = entry:
                        rewritten.push(self.union_arm(arm, union, expected, result, depth + 1)?)
                    else:
                        var ordinary = arm
                        if arm.has_guard:
                            ordinary.guard = self.expression(arm.guard, nil, result, depth + 1)?
                        ordinary.body = self.block(arm.body, expected, result, depth + 1)?
                        rewritten.push(ordinary)
                out.kind = HirExprKind.MatchCase(subject, rewritten)
                actual = expected
            case Return(value):
                var returned: HirExpr? = nil
                if val operand = value:
                    returned = Some(self.expression(operand, Some(result), result, depth + 1)?)
                elif val entry = self.map.union_entry(result)?:
                    return Err(self.error("union return omits its value", expr.span))
                out.kind = HirExprKind.Return(returned)
                return Ok(out)
            case Call(callee, args, type_args):
                if type_args.len() != 0:
                    return Err(self.error("generic call is outside the union source stage", expr.span))
                var symbol: SymbolId? = nil
                match callee.kind:
                    case Var(id) | NamedVar(id, _): symbol = Some(id)
                    case _: ()
                if symbol == nil:
                    return Err(self.error("indirect union-stage call has no local declaration", expr.span))
                val id = symbol.unwrap()
                if not self.map.module.functions.has(id):
                    return Err(self.error("provider call is outside the union source stage", expr.span))
                val function = self.map.module.functions[id]
                if args.len() > function.params.len():
                    return Err(self.error("call has too many supplied arguments", expr.span))
                var rewritten: [HirCallArg] = []
                self.slots(args.len(), expr.span)?
                for index in 0..args.len():
                    var arg = args[index]
                    if arg.has_name:
                        return Err(self.error("named argument requires resolved formal-position evidence", arg.span))
                    arg.value = self.expression(arg.value,
                        Some(function.params[index].type_), result, depth + 1)?
                    rewritten.push(arg)
                for index in args.len()..function.params.len():
                    if not function.params[index].has_default:
                        return Err(self.error("call omits a required argument", expr.span))
                out.kind = HirExprKind.Call(self.expression(callee, nil, result, depth + 1)?,
                    rewritten, type_args)
                actual = Some(function.return_type)
            case EnumLit(type_, variant, payload):
                var rewritten: HirEnumPayload? = nil
                if val supplied = payload:
                    match supplied:
                        case Tuple(values):
                            self.slots(values.len(), expr.span)?
                            var items: [HirExpr] = []
                            for value in values:
                                self.require_narrowed(value)?
                                items.push(self.expression(value, nil, result, depth + 1)?)
                            rewritten = Some(HirEnumPayload.Tuple(items))
                        case Struct(fields):
                            self.slots(fields.len(), expr.span)?
                            var items: [(text, HirExpr)] = []
                            for (name, value) in fields:
                                self.require_narrowed(value)?
                                items.push((name, self.expression(value, nil, result, depth + 1)?))
                            rewritten = Some(HirEnumPayload.Struct(items))
                out.kind = HirExprKind.EnumLit(self.map.normalize_type(type_, expr.span)?, variant, rewritten)
                actual = Some(type_)
            case StructLit(type_, fields):
                self.slots(fields.len(), expr.span)?
                var values: [(text, HirExpr)] = []
                for (name, value) in fields:
                    self.require_narrowed(value)?
                    values.push((name, self.expression(value, nil, result, depth + 1)?))
                out.kind = HirExprKind.StructLit(self.map.normalize_type(type_, expr.span)?, values)
                actual = Some(type_)
            case TupleLit(values):
                self.slots(values.len(), expr.span)?
                var items: [HirExpr] = []
                for value in values:
                    self.require_narrowed(value)?
                    items.push(self.expression(value, nil, result, depth + 1)?)
                out.kind = HirExprKind.TupleLit(items)
            case ArrayLit(values, element):
                self.slots(values.len(), expr.span)?
                var items: [HirExpr] = []
                for value in values: items.push(self.expression(value, element, result, depth + 1)?)
                out.kind = HirExprKind.ArrayLit(items, element)
            case Field(base, name, resolved):
                self.require_narrowed(base)?
                out.kind = HirExprKind.Field(self.expression(base, nil, result, depth + 1)?, name, resolved)
            case TupleIndex(base, index):
                self.require_narrowed(base)?
                out.kind = HirExprKind.TupleIndex(self.expression(base, nil, result, depth + 1)?, index)
            case Index(base, index):
                self.require_narrowed(base)?
                self.require_narrowed(index)?
                val subject = self.expression(base, nil, result, depth + 1)?
                val offset = self.expression(index, nil, result, depth + 1)?
                out.kind = HirExprKind.Index(subject, offset)
            case Cast(value, type_):
                self.require_narrowed(value)?
                out.kind = HirExprKind.Cast(self.expression(value, nil, result, depth + 1)?,
                    self.map.normalize_type(type_, expr.span)?)
                actual = Some(type_)
            case ConvertCall(value, type_):
                self.require_narrowed(value)?
                out.kind = HirExprKind.ConvertCall(self.expression(value, nil, result, depth + 1)?,
                    self.map.normalize_type(type_, expr.span)?)
                actual = Some(type_)
            case Try(value):
                out.kind = HirExprKind.Try(self.expression(value, nil, result, depth + 1)?)
            case _:
                return Err(self.error("expression position has no admitted union conversion", expr.span))
        self.convert(out, actual, expected)

    me function(function: HirFunction) -> Result<HirFunction, SourceUnionErrorV1>:
        self.visit(0, function.span)?
        if function.type_params.len() != 0 or function.is_generic_template:
            return Err(self.error("open template requires canonical specialization before union transport", function.span))
        var out = function
        self.slots(function.params.len(), function.span)?
        var params: [HirParam] = []
        for param in function.params:
            self.visit(1, param.span)?
            var rewritten = param
            rewritten.type_ = self.map.normalize_type(param.type_, param.span)?
            self.original_types[param.symbol.id] = param.type_
            self.annotate_symbol(param.symbol, rewritten.type_, param.span)?
            if param.has_default:
                rewritten.default = self.expression(param.default, Some(param.type_), function.return_type, 1)?
            params.push(rewritten)
        out.params = params
        out.return_type = self.map.normalize_type(function.return_type, function.span)?
        # Admission has already distinguished a legitimate signature-only
        # declaration from a malformed missing ordinary body.
        if function.body != nil:
            out.body = self.block(function.body, Some(function.return_type), function.return_type, 1)?
        if val contract = function.verification_contract:
            var rewritten_contract = contract
            self.slots(contract.clauses.len(), function.span)?
            var clauses: [HirContractClause] = []
            for clause in contract.clauses:
                var rewritten_clause = clause
                rewritten_clause.predicate = self.expression(clause.predicate,
                    nil, function.return_type, 1)?
                clauses.push(rewritten_clause)
            rewritten_contract.clauses = clauses
            out.verification_contract = Some(rewritten_contract)
        return Ok(out)

export SourceUnionRewriterV1
