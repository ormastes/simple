# Per-invocation, pre-growth accounting and fresh SymbolTable ownership.
# Logical allocation counters are not RSS measurements or parser limits.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolTable, HirSymbol, Scope, ScopeId}

struct SourceUnionLimitsV1:
    max_nodes: i64 = 65536
    max_depth: i64 = 128
    max_members: i64 = 4096
    max_key_bytes: i64 = 1048576
    max_registry_rows: i64 = 8192
    max_injections: i64 = 16384
    max_copy_units: i64 = 1048576
    max_work: i64 = 8388608

struct SourceUnionUsageV1:
    nodes: i64 = 0
    members: i64 = 0
    key_bytes: i64 = 0
    registry_rows: i64 = 0
    injections: i64 = 0
    copy_units: i64 = 0
    work: i64 = 0
    max_depth_seen: i64 = 0

struct SourceUnionErrorV1:
    code: text
    message: text
    span: Span
    usage: SourceUnionUsageV1

class SourceUnionLedgerV1:
    limits: SourceUnionLimitsV1
    usage: SourceUnionUsageV1

    static fn create(limits: SourceUnionLimitsV1) -> Result<SourceUnionLedgerV1, SourceUnionErrorV1>:
        if limits == nil:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "absent limits", span: Span.empty(), usage: SourceUnionUsageV1()))
        val defaults = SourceUnionLimitsV1()
        if limits.max_nodes < 0 or limits.max_nodes > defaults.max_nodes:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_nodes", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_depth < 0 or limits.max_depth > defaults.max_depth:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_depth", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_members < 0 or limits.max_members > defaults.max_members:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_members", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_key_bytes < 0 or limits.max_key_bytes > defaults.max_key_bytes:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_key_bytes", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_registry_rows < 0 or limits.max_registry_rows > defaults.max_registry_rows:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_registry_rows", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_injections < 0 or limits.max_injections > defaults.max_injections:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_injections", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_copy_units < 0 or limits.max_copy_units > defaults.max_copy_units:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_copy_units", span: Span.empty(), usage: SourceUnionUsageV1()))
        if limits.max_work < 0 or limits.max_work > defaults.max_work:
            return Err(SourceUnionErrorV1(code: "UNION-E-LIMITS", message: "invalid max_work", span: Span.empty(), usage: SourceUnionUsageV1()))
        Ok(SourceUnionLedgerV1(limits: limits, usage: SourceUnionUsageV1()))

    fn snapshot() -> SourceUnionUsageV1:
        # Explicit value construction prevents a mutable ledger alias escaping.
        SourceUnionUsageV1(nodes: self.usage.nodes, members: self.usage.members,
            key_bytes: self.usage.key_bytes, registry_rows: self.usage.registry_rows,
            injections: self.usage.injections, copy_units: self.usage.copy_units,
            work: self.usage.work, max_depth_seen: self.usage.max_depth_seen)

    fn fail(code: text, message: text, span: Span) -> SourceUnionErrorV1:
        SourceUnionErrorV1(code: code, message: message, span: span, usage: self.snapshot())

    me enter(depth: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        if depth < 0:
            return Err(self.fail("UNION-E-COUNT", "negative traversal depth", span))
        if depth > self.limits.max_depth:
            return Err(self.fail("UNION-E-DEPTH", "traversal depth exceeds allowance", span))
        if depth > self.usage.max_depth_seen:
            self.usage.max_depth_seen = depth
        Ok(())

    me debit(kind: text, amount: i64, span: Span) -> Result<(), SourceUnionErrorV1>:
        if amount < 0:
            return Err(self.fail("UNION-E-COUNT", "negative operation count", span))
        # Remaining-budget comparison avoids overflow even on hostile i64 counts.
        match kind:
            case "nodes":
                if amount > self.limits.max_nodes - self.usage.nodes:
                    return Err(self.fail("UNION-E-NODES", "nodes allowance exhausted", span))
                self.usage.nodes = self.usage.nodes + amount
            case "members":
                if amount > self.limits.max_members - self.usage.members:
                    return Err(self.fail("UNION-E-MEMBERS", "members allowance exhausted", span))
                self.usage.members = self.usage.members + amount
            case "key_bytes":
                if amount > self.limits.max_key_bytes - self.usage.key_bytes:
                    return Err(self.fail("UNION-E-KEY", "key_bytes allowance exhausted", span))
                self.usage.key_bytes = self.usage.key_bytes + amount
            case "registry_rows":
                if amount > self.limits.max_registry_rows - self.usage.registry_rows:
                    return Err(self.fail("UNION-E-REGISTRY", "registry_rows allowance exhausted", span))
                self.usage.registry_rows = self.usage.registry_rows + amount
            case "injections":
                if amount > self.limits.max_injections - self.usage.injections:
                    return Err(self.fail("UNION-E-INJECTIONS", "injections allowance exhausted", span))
                self.usage.injections = self.usage.injections + amount
            case "copy_units":
                if amount > self.limits.max_copy_units - self.usage.copy_units:
                    return Err(self.fail("UNION-E-COPY", "copy_units allowance exhausted", span))
                self.usage.copy_units = self.usage.copy_units + amount
            case "work":
                if amount > self.limits.max_work - self.usage.work:
                    return Err(self.fail("UNION-E-WORK", "work allowance exhausted", span))
                self.usage.work = self.usage.work + amount
            case _:
                return Err(self.fail("UNION-E-COUNT", "unknown operation counter", span))
        Ok(())

fn source_union_reserve_snapshot_v1(count: i64, ledger: SourceUnionLedgerV1, span: Span) -> Result<(), SourceUnionErrorV1>:
    # The count must come from nonallocating len(), never keys().len().
    ledger.debit("copy_units", count, span)?
    ledger.debit("work", count, span)?
    Ok(())

fn source_union_check_snapshot_v1(expected: i64, actual: i64, ledger: SourceUnionLedgerV1, span: Span) -> Result<(), SourceUnionErrorV1>:
    if actual < 0 or expected != actual:
        return Err(ledger.fail("UNION-E-COUNT", "dictionary count changed during snapshot", span))
    Ok(())

fn source_union_reserve_text_v1(value: text, ledger: SourceUnionLedgerV1, span: Span) -> Result<(), SourceUnionErrorV1>:
    # Canonical HIR permits nil metadata text distinctly from empty text.
    # Do not call native string length on nil and do not rewrite its value.
    if value == nil: return Ok(())
    ledger.debit("copy_units", value.len(), span)?
    ledger.debit("work", value.len(), span)?
    Ok(())

fn source_union_clone_text_ids_v1(input: Dict<text, i64>, ledger: SourceUnionLedgerV1) -> Result<Dict<text, i64>, SourceUnionErrorV1>:
    val span = Span.empty()
    if input == nil: return Ok({})
    val count = input.len()
    source_union_reserve_snapshot_v1(count, ledger, span)?
    # Reserve destination rows independently of the temporary key snapshot.
    source_union_reserve_snapshot_v1(count, ledger, span)?
    val keys = input.keys()
    source_union_check_snapshot_v1(count, source_union_array_count_v1(keys), ledger, span)?
    var output: Dict<text, i64> = {}
    for key in keys:
        if key == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent index key", span))
        source_union_reserve_text_v1(key, ledger, span)?
        output[key] = input[key]
    Ok(output)

fn source_union_clone_text_text_v1(input: Dict<text, text>, ledger: SourceUnionLedgerV1) -> Result<Dict<text, text>, SourceUnionErrorV1>:
    val span = Span.empty()
    if input == nil: return Ok({})
    val count = input.len()
    source_union_reserve_snapshot_v1(count, ledger, span)?
    # Reserve destination rows independently of the temporary key snapshot.
    source_union_reserve_snapshot_v1(count, ledger, span)?
    val keys = input.keys()
    source_union_check_snapshot_v1(count, source_union_array_count_v1(keys), ledger, span)?
    var output: Dict<text, text> = {}
    for key in keys:
        if key == nil: return Err(ledger.fail("UNION-E-SCOPE", "absent index key", span))
        source_union_reserve_text_v1(key, ledger, span)?
        source_union_reserve_text_v1(input[key], ledger, span)?
        output[key] = input[key]
    Ok(output)

fn source_union_clone_id_text_v1(input: Dict<i64, text>, ledger: SourceUnionLedgerV1) -> Result<Dict<i64, text>, SourceUnionErrorV1>:
    val span = Span.empty()
    if input == nil: return Ok({})
    val count = input.len()
    source_union_reserve_snapshot_v1(count, ledger, span)?
    # Reserve destination rows independently of the temporary key snapshot.
    source_union_reserve_snapshot_v1(count, ledger, span)?
    val keys = input.keys()
    source_union_check_snapshot_v1(count, source_union_array_count_v1(keys), ledger, span)?
    var output: Dict<i64, text> = {}
    for key in keys:
        if key < 0 or input[key] == nil: return Err(ledger.fail("UNION-E-SCOPE", "invalid reverse-owner identity", span))
        source_union_reserve_text_v1(input[key], ledger, span)?
        output[key] = input[key]
    Ok(output)

fn source_union_clone_symbols_v1(input: SymbolTable, ledger: SourceUnionLedgerV1) -> Result<SymbolTable, SourceUnionErrorV1>:
    val span = Span.empty()
    if input == nil:
        return Err(ledger.fail("UNION-E-SCOPE", "absent symbol-table owner", span))
    # Charge class and fixed fields before construction. Every dictionary has
    # its own admitted snapshot and destination rows, including the root mirror.
    ledger.debit("copy_units", 16, span)?
    if input.current_scope == nil or input.scopes == nil:
        return Err(ledger.fail("UNION-E-SCOPE", "absent current scope or scope dictionary", span))
    if not input.scopes.has(0) or not input.scopes.has(input.current_scope.id):
        return Err(ledger.fail("UNION-E-SCOPE", "absent root or current scope", span))
    if input.next_symbol_id < 0 or input.next_scope_id < 1:
        return Err(ledger.fail("UNION-E-COUNT", "invalid symbol-table next ID", span))
    val root = source_union_clone_text_ids_v1(input.root_scope_symbols, ledger)?
    val scope_count = input.scopes.len()
    source_union_reserve_snapshot_v1(scope_count, ledger, span)?
    source_union_reserve_snapshot_v1(scope_count, ledger, span)?
    val scope_keys = input.scopes.keys()
    source_union_check_snapshot_v1(scope_count, source_union_array_count_v1(scope_keys), ledger, span)?
    var scopes: Dict<i64, Scope> = {}
    for id in scope_keys:
        ledger.debit("copy_units", 4, span)?
        if id < 0 or input.scopes[id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent scope row or invalid key", span))
        if input.scopes[id].id == nil or input.scopes[id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent scope identity or kind", span))
        if input.scopes[id].id.id != id:
            return Err(ledger.fail("UNION-E-SCOPE", "scope row identity mismatch", span))
        if val parent = input.scopes[id].parent:
            if parent == nil:
                return Err(ledger.fail("UNION-E-SCOPE", "absent parent scope identity", span))
            if not input.scopes.has(parent.id):
                return Err(ledger.fail("UNION-E-SCOPE", "parent scope row is absent", span))
        val bindings = source_union_clone_text_ids_v1(input.scopes[id].symbols, ledger)?
        var scope = Scope(id: input.scopes[id].id, parent: input.scopes[id].parent,
            kind: input.scopes[id].kind, symbols: bindings)
        if id == 0:
            if scope.symbols.len() != root.len():
                return Err(ledger.fail("UNION-E-SCOPE", "root scope mirror count differs", span))
            val binding_count = root.len()
            source_union_reserve_snapshot_v1(binding_count, ledger, span)?
            val root_keys = root.keys()
            source_union_check_snapshot_v1(binding_count, source_union_array_count_v1(root_keys), ledger, span)?
            for name in root_keys:
                if not scope.symbols.has(name) or scope.symbols[name] != root[name]:
                    return Err(ledger.fail("UNION-E-SCOPE", "root scope mirror binding differs", span))
            # Same fresh backing owner inside the result; never reuse input maps.
            scope.symbols = root
        scopes[id] = scope
    val symbol_count = if input.symbols == nil: 0 else: input.symbols.len()
    source_union_reserve_snapshot_v1(symbol_count, ledger, span)?
    source_union_reserve_snapshot_v1(symbol_count, ledger, span)?
    val symbol_keys: [i64] = if input.symbols == nil: [] else: input.symbols.keys()
    source_union_check_snapshot_v1(symbol_count, source_union_array_count_v1(symbol_keys), ledger, span)?
    var symbols: Dict<i64, HirSymbol> = {}
    for id in symbol_keys:
        if id < 0 or input.symbols[id] == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent symbol row or invalid key", span))
        if input.symbols[id].id == nil or input.symbols[id].scope == nil or input.symbols[id].kind == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent symbol identity, scope or kind", span))
        if input.symbols[id].id.id != id or not input.scopes.has(input.symbols[id].scope.id):
            return Err(ledger.fail("UNION-E-SCOPE", "symbol identity or scope mismatch", span))
        if input.symbols[id].name == nil:
            return Err(ledger.fail("UNION-E-SCOPE", "absent symbol name", span))
        ledger.debit("copy_units", 12, span)?
        source_union_reserve_text_v1(input.symbols[id].name, ledger, span)?
        if val owner = input.symbols[id].defining_module:
            source_union_reserve_text_v1(owner, ledger, span)?
        symbols[id] = input.symbols[id]
    val gpu_targets = source_union_clone_text_text_v1(input.gpu_function_targets, ledger)?
    val gpu_orders = source_union_clone_text_text_v1(input.gpu_function_backend_orders, ledger)?
    val functions = source_union_clone_text_ids_v1(input.qualified_functions, ledger)?
    val types = source_union_clone_text_ids_v1(input.qualified_types, ledger)?
    val exact = source_union_clone_text_ids_v1(input.exact_symbols, ledger)?
    val callables = source_union_clone_text_ids_v1(input.module_callables, ledger)?
    val union_symbols = source_union_clone_text_ids_v1(input.structural_union_symbols, ledger)?
    val union_owners = source_union_clone_id_text_v1(input.structural_union_owners, ledger)?
    Ok(SymbolTable(symbols: symbols, scopes: scopes, current_scope: input.current_scope,
        next_symbol_id: input.next_symbol_id, next_scope_id: input.next_scope_id,
        gpu_function_targets: gpu_targets, gpu_function_backend_orders: gpu_orders,
        qualified_functions: functions, qualified_types: types, exact_symbols: exact,
        module_callables: callables, root_scope_symbols: root,
        structural_union_symbols: union_symbols, structural_union_owners: union_owners))

export SourceUnionLimitsV1, SourceUnionUsageV1, SourceUnionErrorV1, SourceUnionLedgerV1
export source_union_clone_symbols_v1, source_union_reserve_snapshot_v1
export source_union_check_snapshot_v1, source_union_reserve_text_v1

# Nil array fields are the provider's valid empty-array representation.
fn source_union_array_count_v1<T>(items: [T]) -> i64:
    if items == nil: 0 else: items.len()

export source_union_array_count_v1
