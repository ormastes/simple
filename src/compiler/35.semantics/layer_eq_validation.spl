# C1 `@layer_eq` production wiring: prove every source-level `@layer_eq(Target)`
# claim against the compiler's OWN computed struct layouts.
#
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (C1)
# doc/05_design/language/forwarding/
#   layer_forwarding_and_layer_eq_types.md §3 (the 8 obligations)
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (why C1 exists)
#
# THE GAP THIS CLOSES: `layer_eq_checker.spl` has implemented all 8 obligations
# since M3, and `layer_eq_real_layout.spl` has been able to feed it real
# `TypeLayout` facts since M2 -- but nothing in the compiler ever CALLED either
# on real source, because `@layer_eq` could not be spelled. The checker ran on
# hand-built fixtures only, so its obligations were unenforced on the tree. This
# pass is the consumer end of the attribute path added in 10.frontend
# (`layer_eq_registry.spl`): it drains the parser's recorded claims, resolves
# both types in the lowered HIR, computes their layouts with the production
# layout engine, and returns real compile diagnostics.
#
# Shape deliberately mirrors `value_struct_layout.spl`'s
# `validate_value_struct_layouts(modules) -> [text]`: same input type, same
# "return diagnostics, let the driver decide how to surface them" contract, and
# it is invoked from the same driver hook so a new checker cannot quietly fail
# to be wired.
#
# Obligation coverage note (honest scope): `TypeLayout` is a pure
# size/offset/align model, so obligations 1-4 (field count, name mapping,
# per-field type, per-field and whole-type layout) are proven here against real
# computed layout. Obligations 5-8 (enum discriminants, ownership/mutability,
# address space, unit/space/color/alpha tags) are implemented in
# `check_layer_eq` and are exercised at their neutral defaults here, because HIR
# does not yet carry those per-field facts -- see `layer_eq_real_layout.spl`'s
# own note. Wiring 5-8's declared-fact source is tracked separately; nothing
# here silently reports those obligations as PROVEN.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.{HirStruct}
use compiler.semantics.layer_eq_checker.{check_layer_eq, LayerEqType, LayerEqField}
use compiler.semantics.layer_eq_real_layout.{layer_eq_type_from_layout}
use compiler.types.type_layout.{compute_struct_layout, layoutattr_default_}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_claim_keys, layer_eq_claim_view, layer_eq_claim_path}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_target_of_key, layer_eq_registry_renames_of_key}
use compiler.types.type_layout.{TypeLayout}

# Index every non-generic struct in every module by its plain name. A generic
# template has no single layout to prove, so it is skipped rather than measured
# at some arbitrary instantiation (same exclusion `value_struct_layout.spl`
# applies for the same reason).
fn layer_eq_index_structs(modules: Dict<text, HirModule>) -> Dict<text, HirStruct>:
    var out: Dict<text, HirStruct> = {}
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        for raw_struct in module.structs.values():
            # ANY-transport: annotated rebind (cycle-70 sweep).
            val struct_: HirStruct = raw_struct
            if struct_.type_params.len() > 0 or struct_.is_generic_template:
                continue
            out[struct_.name] = struct_
    out

# Every identity a compiled module can be recognised by. The `@layer_eq`
# registry is process-wide (it survives across compilations inside one process,
# e.g. a spec run or a long-lived driver), so claims must be scoped to the
# modules ACTUALLY being compiled here. Scoping on the view type NAME alone is
# not enough: two source files can each define a `ViewPoint`, and an earlier
# file's claim would then be re-proven against a later file's unrelated struct.
fn layer_eq_module_identities(modules: Dict<text, HirModule>) -> [text]:
    var ids: [text] = []
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if module.path != "" and not ids.contains(module.path):
            ids.push(module.path)
        if module.name != "" and not ids.contains(module.name):
            ids.push(module.name)
        if not ids.contains(module_key):
            ids.push(module_key)
    ids

fn layer_eq_layout_of(struct_: HirStruct) -> TypeLayout:
    if struct_.has_layout_attr:
        return compute_struct_layout(struct_.fields, struct_.layout_attr)
    compute_struct_layout(struct_.fields, layoutattr_default_())

pub fn layer_eq_module_declarations_v1(module: HirModule) -> [LayerEqType]:
    var declarations: [LayerEqType] = []
    for raw_struct in module.structs.values():
        # ANY-transport: annotated rebind (cycle-70 sweep).
        val struct_: HirStruct = raw_struct
        if struct_.type_params.len() > 0 or struct_.is_generic_template: continue
        declarations.push(layer_eq_struct_declaration_v1(struct_))
    declarations

pub fn layer_eq_struct_declaration_v1(struct_: HirStruct) -> LayerEqType:
    layer_eq_type_from_layout(struct_.name, layer_eq_layout_of(struct_), [])

pub fn layer_eq_required_declaration_names_v1(module_ids: [text], available_names: [text]) -> [text]:
    layer_eq_required_claim_declaration_names_v1(module_ids, available_names, layer_eq_contract_claims_v1())

# Body-free replay inputs derived from the actual ordered parser registry.
# Only a genuine driver source/policy owner can admit these editable rows.
struct LayerEqContractClaimV1:
    registry_key: text
    path: text
    view: text
    target: text
    renames: [text]

pub fn layer_eq_contract_claims_v1() -> [LayerEqContractClaimV1]:
    var claims: [LayerEqContractClaimV1] = []
    for key in layer_eq_registry_claim_keys():
        claims.push(LayerEqContractClaimV1(registry_key: key, path: layer_eq_claim_path(key),
            view: layer_eq_claim_view(key), target: layer_eq_registry_target_of_key(key),
            renames: layer_eq_registry_renames_of_key(key)))
    claims

pub fn layer_eq_required_claim_declaration_names_v1(module_ids: [text], available_names: [text],
        claims: [LayerEqContractClaimV1]) -> [text]:
    var required: [text] = []
    for claim in claims:
        val view = claim.view
        val target = claim.target
        if view == "" or target == "" or not module_ids.contains(claim.path) or
                not available_names.contains(view) or not available_names.contains(target): continue
        if not required.contains(view): required.push(view)
        if not required.contains(target): required.push(target)
    required

fn layer_eq_declaration_renames_v1(declaration: LayerEqType, renames: [text]) -> LayerEqType:
    var fields: [LayerEqField] = []
    var index = 0
    while index < declaration.fields.len():
        val field = declaration.fields[index]
        fields.push(LayerEqField(..field, mapped_name: if index < renames.len(): renames[index] else: ""))
        index = index + 1
    LayerEqType(..declaration, fields: fields)

# Physical declarations contain only actual computed sizes/offsets/type text.
# The original aggregate registry gate is shared; no caller-authored fact is
# promoted to driver admission without replay against the admitted archive.
pub fn validate_layer_eq_declarations_v1(module_ids: [text],
        declarations: [LayerEqType]) -> [text]:
    var names: [text] = []
    for declaration in declarations:
        if not names.contains(declaration.name): names.push(declaration.name)
    validate_layer_eq_selected_declarations_v1(module_ids, names, declarations)
fn validate_layer_eq_types(modules: Dict<text, HirModule>) -> [text]:
    """Prove every recorded `@layer_eq(Target)` claim; return one diagnostic per
    unproven claim (empty list = every claim proven)."""
    if layer_eq_registry_claim_keys().len() == 0: return []
    val module_ids = layer_eq_module_identities(modules)
    # Preserve the original selection boundary: unrelated and unresolved
    # missing-target declarations never reach the physical layout engine.
    # Duplicate names still use the original last-module declaration winner.
    val by_name = layer_eq_index_structs(modules)
    var declarations: [LayerEqType] = []
    val required = layer_eq_required_declaration_names_v1(module_ids, by_name.keys())
    for name in required: declarations.push(layer_eq_struct_declaration_v1(by_name[name]))
    # The gate also needs membership for missing-target diagnostics and the
    # old absent-view exclusion. Supply names separately; never synthesize a
    # physical layout for a declaration that was not measured.
    validate_layer_eq_selected_declarations_v1(module_ids, by_name.keys(), declarations)

pub fn validate_layer_eq_selected_declarations_v1(module_ids: [text],
        available_names: [text], declarations: [LayerEqType]) -> [text]:
    validate_layer_eq_claim_declarations_v1(module_ids, available_names, declarations, layer_eq_contract_claims_v1())

pub fn validate_layer_eq_claim_declarations_v1(module_ids: [text],
        available_names: [text], declarations: [LayerEqType], claims: [LayerEqContractClaimV1]) -> [text]:
    var errors: [text] = []
    var measured: Dict<text, LayerEqType> = {}
    for declaration in declarations: measured[declaration.name] = declaration
    for claim in claims:
        val view_name = claim.view
        val target_name = claim.target
        if view_name == "" or target_name == "" or
                not module_ids.contains(claim.path): continue
        if not available_names.contains(view_name): continue
        if not available_names.contains(target_name):
            errors.push("error[layer_eq]: '" + view_name + "' declares @layer_eq("
                + target_name + ") but '" + target_name
                + "' is not a non-generic struct visible in this compilation")
            continue
        if not measured.has(view_name) or not measured.has(target_name):
            errors.push("internal error: selected layer-equivalence declaration was not measured")
            continue
        val view = layer_eq_declaration_renames_v1(measured[view_name], claim.renames)
        val verdict = check_layer_eq(view, measured[target_name])
        if not verdict.ok: errors.push(verdict.diagnostic)
    errors

export validate_layer_eq_types, layer_eq_index_structs, layer_eq_layout_of
export layer_eq_module_declarations_v1, validate_layer_eq_declarations_v1
export layer_eq_struct_declaration_v1, layer_eq_required_declaration_names_v1
export validate_layer_eq_selected_declarations_v1
export LayerEqContractClaimV1, layer_eq_contract_claims_v1
export layer_eq_required_claim_declaration_names_v1, validate_layer_eq_claim_declarations_v1
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection
