# any_escape — critical-profile `Any` origin/escape analysis (agent Y2, 2026-08-21).
#
# Plan: doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md
#       §8.5, §14.1 REQ-MC-ANY-001, §17.1/§17.2, §20.5 row Y2.
#
# Single entry point: `any_escape_check(module: HirModule, profile) -> [AnyEscapeDiag]`.
#
# NOT WIRED HERE ON PURPOSE. The driver call site belongs in
# `80.driver/driver_hir_pipeline_passes.spl`, next to `run_safety_warn_pass`,
# which already walks `hir_modules` and already maps a checker's findings onto
# `ctx.add_warning` / `ctx.add_error` by profile severity. Wiring it is the
# integrator's change, not this package's.

export use compiler.semantics.any_escape.types.{
    AnyEscapeKind, AnyEscapeSeverity, AnyEscapeDiag, AnyEscapeProfile,
    any_escape_kind_name, any_escape_kind_code, any_escape_severity_name,
    type_erasure_capability_name
}

export use compiler.semantics.any_escape.checker.{
    AnyEscapeState, any_escape_check,
    any_type_is_any, any_type_mentions_any, any_is_checked_boundary_callee
}
