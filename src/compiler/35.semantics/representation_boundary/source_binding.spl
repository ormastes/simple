use compiler.common.assurance.representation_manifest_v1.{RepresentationDeclarationV1}
use compiler.common.assurance.representation_context_v1.{RepresentationSourceContextV1}
use compiler.semantics.symbol_id.stable_id.{stable_symbol_id}

pub fn representation_bind_source_v1(declarations: [RepresentationDeclarationV1],
        context: RepresentationSourceContextV1) -> [RepresentationDeclarationV1]:
    val valid_context = context.package_identity.trim() != "" and
        context.module_identity != "" and context.owner_kind == "project-config" and
        context.owner_manifest_path != "" and context.owner_manifest_digest.len() == 64 and
        context.source_identity.len() == 64
    var identities: Dict<text, text> = {}
    var out: [RepresentationDeclarationV1] = []
    for raw in declarations:
        var declaration = raw
        declaration.components.package = if valid_context: context.package_identity else: ""
        declaration.components.module_path = context.module_identity
        if raw.components.owner_id != "":
            if identities.contains_key(raw.components.owner_id):
                declaration.components.owner_id = identities[raw.components.owner_id]
            else:
                declaration.metadata_errors.push("representation declaration owner could not be rebound")
        if not valid_context and (raw.manifest != nil or raw.requires_manifest or raw.metadata_errors.len() > 0):
            declaration.metadata_errors.push("representation admission requires a valid explicitly selected project/source owner")
        if raw.source_digest != context.source_identity:
            declaration.source_digest = ""
        declaration.declaration_id = stable_symbol_id(declaration.components)
        identities[raw.declaration_id] = declaration.declaration_id
        out.push(declaration)
    out

export representation_bind_source_v1
