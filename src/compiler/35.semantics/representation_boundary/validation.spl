# Pure A5 validation. Callers provide source-budgeted declaration facts once per
# invocation. No ambient package identity, I/O, unsafe-depth changes or waiver.
use compiler.common.assurance.representation_manifest_v1.{RepresentationManifestV1, RepresentationDeclarationV1, RepresentationAdmissionV1, RepresentationManifestIndexV1, RepresentationOwnedIntervalV1}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.assurance.unsafe_capabilities.{is_known_unsafe_capability, unsafe_capability_names}
use compiler.common.diagnostics.span.{Span}
use compiler.common.diagnostics.diagnostic.{Diagnostic}
use compiler.common.diagnostics.severity.{Severity}
use compiler.semantics.symbol_id.stable_id.{stable_symbol_id}

fn representation_diagnostic_v1(code: text, message: text, span: Span, strictness: AssuranceStrictness) -> Diagnostic:
    val severity = if strictness == AssuranceStrictness.Critical: Severity.Error else: Severity.Warning
    Diagnostic(severity: severity, code: Some(code), message: message, span: Some(span), labels: [], notes: [], help: nil)

fn representation_full_id_v1(identity: text) -> bool:
    if identity.len() != 32:
        return false
    for i in 0..32:
        if not "0123456789abcdef".contains(identity.slice(i, i + 1)):
            return false
    true

fn representation_target_supported_v1(kind: text) -> bool:
    # SymbolComponents normally uses fn/method/type. Preserve concrete parser
    # target spellings when that producer retains the declaration distinction.
    kind == "fn" or kind == "method" or kind == "type" or kind == "me" or kind == "extern_fn" or kind == "extern fn" or kind == "struct" or kind == "class" or kind == "enum"

fn representation_span_valid_v1(span: Span) -> bool:
    span.start >= 0 and span.end >= span.start and span.length == span.end - span.start

fn representation_manifest_validate_v1(declaration: RepresentationDeclarationV1, strictness: AssuranceStrictness) -> RepresentationAdmissionV1:
    """Validate source-authored metadata; every error prevents exemption.

    Repeated region caps are allowed because distinct regions may use the same
    capability. Repeated manifest literals are rejected. List normalization
    trims reviewer text, preserves reviewer order, and orders caps by the
    existing vocabulary. Work is linear in the budgeted metadata bytes/rows.
    """
    var diagnostics: [Diagnostic] = []
    var normalized: RepresentationManifestV1? = nil
    val needs_manifest = declaration.requires_manifest or declaration.region_capabilities.len() > 0
    val has_metadata = declaration.manifest.? or needs_manifest or declaration.metadata_errors.len() > 0
    for problem in declaration.metadata_errors:
        diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", problem, declaration.attribute_span, strictness))

    if has_metadata:
        val components = declaration.components
        if (components.package.trim() == "" or components.module_path.trim() == "" or components.name.trim() == "" or
            not representation_target_supported_v1(components.item_kind) or declaration.local_symbol_id < 0 or
            not representation_full_id_v1(declaration.declaration_id) or stable_symbol_id(components) != declaration.declaration_id or
            (components.owner_id != "" and not representation_full_id_v1(components.owner_id))):
            diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-002", "representation declaration identity or target is invalid; provide exact package/module/owner/signature identity", declaration.declaration_span, strictness))
        if declaration.source_digest.trim() == "":
            diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-004", "representation metadata requires a current source-content digest", declaration.declaration_span, strictness))
        if (not representation_span_valid_v1(declaration.declaration_span) or not representation_span_valid_v1(declaration.attribute_span) or
            declaration.attribute_span.file != declaration.declaration_span.file):
            diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-002", "representation attribute/declaration source scope is invalid", declaration.attribute_span, strictness))

    var previous_end = declaration.declaration_span.start
    for interval in declaration.owned_intervals:
        if (not representation_span_valid_v1(interval) or interval.start >= interval.end or
            interval.file != declaration.declaration_span.file or interval.start < declaration.declaration_span.start or
            interval.end > declaration.declaration_span.end or interval.start < previous_end):
            diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-002", "owned representation intervals must be ordered, disjoint and inside their declaration", interval, strictness))
        previous_end = interval.end

    match declaration.manifest:
        Some(manifest):
            if manifest.schema_version != 1:
                diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-004", "unsupported representation manifest schema_version; expected 1", declaration.attribute_span, strictness))
            if manifest.kind != "ffi" and manifest.kind != "layout" and manifest.kind != "hardware" and manifest.kind != "intrinsics":
                diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "representation kind must be ffi, layout, hardware or intrinsics", declaration.attribute_span, strictness))
            val reason = manifest.reason.trim()
            if reason == "":
                diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "representation reason must be nonempty after trimming", declaration.attribute_span, strictness))
            if manifest.reviewers.len() == 0:
                diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "representation reviewers must contain a nonempty reviewer", declaration.attribute_span, strictness))
            var reviewer_set: Dict<text, bool> = {}
            var reviewers: [text] = []
            for raw_reviewer in manifest.reviewers:
                val reviewer = raw_reviewer.trim()
                if reviewer == "":
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "representation reviewer must be nonempty after trimming", declaration.attribute_span, strictness))
                elif reviewer_set.contains_key(reviewer):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "duplicate representation reviewer: {reviewer}", declaration.attribute_span, strictness))
                else:
                    reviewer_set[reviewer] = true
                    reviewers = reviewers.push(reviewer)
            var audited_caps: Dict<text, bool> = {}
            for capability in manifest.capabilities:
                if not is_known_unsafe_capability(capability):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-003", "unknown representation capability: {capability}", declaration.attribute_span, strictness))
                elif audited_caps.contains_key(capability):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-003", "duplicate representation capability: {capability}", declaration.attribute_span, strictness))
                else:
                    audited_caps[capability] = true
            for capability in declaration.region_capabilities:
                if not is_known_unsafe_capability(capability):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-003", "unknown unsafe region capability: {capability}", declaration.declaration_span, strictness))
                elif not audited_caps.contains_key(capability):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-003", "unsafe region capability exceeds reviewed representation bounds: {capability}", declaration.declaration_span, strictness))
            var capabilities: [text] = []
            for capability in unsafe_capability_names():
                if audited_caps.contains_key(capability):
                    capabilities = capabilities.push(capability)
            if diagnostics.len() == 0:
                normalized = Some(RepresentationManifestV1(schema_version: 1, kind: manifest.kind, reason: reason, reviewers: reviewers, capabilities: capabilities))
        nil:
            if needs_manifest:
                diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-001", "unsafe declaration requires representation reason and reviewers", declaration.declaration_span, strictness))
            for capability in declaration.region_capabilities:
                if not is_known_unsafe_capability(capability):
                    diagnostics = diagnostics.push(representation_diagnostic_v1("E-MC-REP-003", "unknown unsafe region capability: {capability}", declaration.declaration_span, strictness))
    RepresentationAdmissionV1(declaration: declaration, manifest: normalized, primitive_internal_exempt: normalized.? and diagnostics.len() == 0, diagnostics: diagnostics)

fn representation_intervals_order_v1(intervals: [RepresentationOwnedIntervalV1]) -> [RepresentationOwnedIntervalV1]:
    # Nonnegative i64 start offsets, stable eight-pass radix ordering. This
    # handles an outer declaration's split intervals without O(I log I) sort.
    var ordered = intervals
    var divisor: i64 = 1
    for radix_pass in 0..8:
        var buckets: Dict<i64, [RepresentationOwnedIntervalV1]> = {}
        for interval in ordered:
            val digit = (interval.span.start / divisor) % 256
            if buckets.contains_key(digit):
                var bucket = buckets[digit]
                bucket = bucket.push(interval)
                buckets[digit] = bucket
            else:
                buckets[digit] = [interval]
        ordered = []
        for digit in 0..256:
            if buckets.contains_key(digit):
                for interval in buckets[digit]:
                    ordered = ordered.push(interval)
        if radix_pass < 7:
            divisor = divisor * 256
    ordered

fn representation_diagnostics_order_v1(diagnostics: [Diagnostic]) -> [Diagnostic]:
    # Keep source encounter order, then stable byte-offset order per source.
    # This runs once at index construction, never during a binding lookup.
    var by_source: Dict<text, [Diagnostic]> = {}
    var sources: [text] = []
    for diagnostic in diagnostics:
        val span = diagnostic.span ?? Span.empty()
        if not by_source.contains_key(span.file):
            by_source[span.file] = []
            sources = sources.push(span.file)
        var source_diagnostics = by_source[span.file]
        source_diagnostics = source_diagnostics.push(diagnostic)
        by_source[span.file] = source_diagnostics
    var result: [Diagnostic] = []
    for source in sources:
        var ordered = by_source[source]
        var divisor: i64 = 1
        for radix_pass in 0..8:
            var buckets: Dict<i64, [Diagnostic]> = {}
            for diagnostic in ordered:
                val span = diagnostic.span ?? Span.empty()
                val start = if span.start < 0: 0 else: span.start
                val digit = (start / divisor) % 256
                if buckets.contains_key(digit):
                    var bucket = buckets[digit]
                    bucket = bucket.push(diagnostic)
                    buckets[digit] = bucket
                else:
                    buckets[digit] = [diagnostic]
            ordered = []
            for digit in 0..256:
                if buckets.contains_key(digit):
                    for diagnostic in buckets[digit]:
                        ordered = ordered.push(diagnostic)
            if radix_pass < 7:
                divisor = divisor * 256
        for diagnostic in ordered:
            result = result.push(diagnostic)
    result

fn representation_index_build_v1(declarations: [RepresentationDeclarationV1], strictness: AssuranceStrictness) -> RepresentationManifestIndexV1:
    """Build once from caller source-ordered, source-budgeted declaration facts.

    O(D+R+I) expected dictionary work, eight fixed radix passes per source;
    storage O(D+R+I). Existing parser input/token limits own the byte budget.
    Rebuild admission for each strictness/source version; never cache a grant.
    """
    var admissions: Dict<text, RepresentationAdmissionV1> = {}
    var declaration_order: [text] = []
    var by_source: Dict<text, [RepresentationOwnedIntervalV1]> = {}
    var source_order: [text] = []
    for declaration in declarations:
        # Anonymous/nested parser barriers have no canonical declaration
        # identity. The producer already removes their spans from each owning
        # declaration, so they need no index entry when they carry no metadata.
        # Ordinary named declarations must remain indexed: an unannotated row
        # can conflict with an annotated identity in either encounter order.
        val no_authority = (declaration.manifest == nil and not declaration.requires_manifest and
            declaration.region_capabilities.len() == 0 and declaration.metadata_errors.len() == 0)
        val parser_barrier = (declaration.local_symbol_id < 0 and
            (declaration.components.item_kind == "nested_callable" or declaration.components.item_kind == "nested_extern"))
        if no_authority and parser_barrier:
            continue
        val admitted = representation_manifest_validate_v1(declaration, strictness)
        val identity = declaration.declaration_id
        if admissions.contains_key(identity):
            var previous = admissions[identity]
            previous.primitive_internal_exempt = false
            previous.manifest = nil
            val stale = previous.declaration.source_digest != declaration.source_digest
            val code = if stale: "E-MC-REP-004" else: "E-MC-REP-002"
            val message = if stale: "conflicting source-content digests for representation declaration identity" else: "duplicate or conflicting representation declaration identity"
            previous.diagnostics = previous.diagnostics.push(representation_diagnostic_v1(code, message, declaration.declaration_span, strictness))
            for diagnostic in admitted.diagnostics:
                previous.diagnostics = previous.diagnostics.push(diagnostic)
            admissions[identity] = previous
        else:
            admissions[identity] = admitted
            declaration_order = declaration_order.push(identity)
        # Include rejected duplicate rows in overlap detection as well: a bad
        # duplicate may claim a different owner's interval and must not let
        # that other owner inherit an ambiguous exemption.
        for span in declaration.owned_intervals:
            if span.start >= 0 and span.end > span.start:
                val interval = RepresentationOwnedIntervalV1(declaration_id: identity, span: span)
                if not by_source.contains_key(span.file):
                    by_source[span.file] = []
                    source_order = source_order.push(span.file)
                var source_intervals = by_source[span.file]
                source_intervals = source_intervals.push(interval)
                by_source[span.file] = source_intervals

    var intervals: [RepresentationOwnedIntervalV1] = []
    var overlapping: Dict<text, Span> = {}
    for source in source_order:
        val ordered = representation_intervals_order_v1(by_source[source])
        var active: RepresentationOwnedIntervalV1? = nil
        for interval in ordered:
            match active:
                Some(previous):
                    if interval.span.start < previous.span.end:
                        if not overlapping.contains_key(previous.declaration_id):
                            overlapping[previous.declaration_id] = previous.span
                        if not overlapping.contains_key(interval.declaration_id):
                            overlapping[interval.declaration_id] = interval.span
                    if interval.span.end > previous.span.end:
                        active = Some(interval)
                nil:
                    active = Some(interval)
            intervals = intervals.push(interval)

    var diagnostics: [Diagnostic] = []
    for identity in declaration_order:
        var admitted = admissions[identity]
        if overlapping.contains_key(identity):
            admitted.primitive_internal_exempt = false
            admitted.manifest = nil
            admitted.diagnostics = admitted.diagnostics.push(representation_diagnostic_v1("E-MC-REP-002", "overlapping representation ownership intervals are ambiguous", overlapping[identity], strictness))
            admissions[identity] = admitted
        for diagnostic in admitted.diagnostics:
            diagnostics = diagnostics.push(diagnostic)
    var unambiguous: [RepresentationOwnedIntervalV1] = []
    for interval in intervals:
        if not overlapping.contains_key(interval.declaration_id):
            unambiguous = unambiguous.push(interval)
    RepresentationManifestIndexV1(declarations: admissions, diagnostics: representation_diagnostics_order_v1(diagnostics), intervals: unambiguous)

fn representation_internal_binding_exempt_v1(index: RepresentationManifestIndexV1, declaration_id: text, binding_span: Span) -> bool:
    """O(log I_owner) exact half-open containment; no parsing, sorting or I/O."""
    if not index.declarations.contains_key(declaration_id):
        return false
    val admission = index.declarations[declaration_id]
    if not admission.primitive_internal_exempt or not representation_span_valid_v1(binding_span):
        return false
    val owned = admission.declaration.owned_intervals
    var low: i64 = 0
    var high = owned.len()
    while low < high:
        val middle = low + (high - low) / 2
        if owned[middle].start <= binding_span.start:
            low = middle + 1
        else:
            high = middle
    if low == 0:
        return false
    val interval = owned[low - 1]
    interval.file == binding_span.file and binding_span.start >= interval.start and binding_span.start < interval.end and binding_span.end <= interval.end

fn representation_manifest_diagnostics_v1(index: RepresentationManifestIndexV1) -> [Diagnostic]:
    """Publish the already-built source-order diagnostics without revalidation."""
    index.diagnostics

export representation_manifest_validate_v1, representation_index_build_v1
export representation_internal_binding_exempt_v1, representation_manifest_diagnostics_v1
export representation_diagnostics_order_v1
