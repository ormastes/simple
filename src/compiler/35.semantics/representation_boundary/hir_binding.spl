# Bind parsed facts to actual module-local HIR symbols once, after lowering.
use compiler.common.assurance.representation_manifest_v1.{RepresentationDeclarationV1}
use compiler.common.assurance.representation_context_v1.{RepresentationSourceContextV1}
use compiler.semantics.representation_boundary.source_binding.{representation_bind_source_v1}
use compiler.hir.hir_types.{HirModule, SymbolKind}
use compiler.semantics.symbol_id.stable_id.{stable_symbol_id}

fn representation_symbol_kind_v1(kind: SymbolKind) -> text:
    match kind:
        case SymbolKind.Function: "fn"
        case SymbolKind.Method: "fn"
        case SymbolKind.Struct: "struct"
        case SymbolKind.Class: "class"
        case SymbolKind.Enum: "enum"
        case _: ""

pub fn representation_bind_hir_v1(module: HirModule,
        context: RepresentationSourceContextV1) -> [RepresentationDeclarationV1]:
    if module.representation_declarations.len() == 0:
        return []
    var symbols: Dict<text, [i64]> = {}
    for symbol in module.symbols.symbols.values():
        val kind = representation_symbol_kind_v1(symbol.kind)
        if kind != "":
            val key = "{symbol.span.start}:{symbol.span.end}:{kind}"
            var claims: [i64] = symbols[key] ?? []
            claims.push(symbol.id.id)
            symbols[key] = claims
    var out: [RepresentationDeclarationV1] = []
    for raw in representation_bind_source_v1(module.representation_declarations, context):
        var declaration = raw
        val kind = if raw.components.item_kind == "extern_fn" or raw.components.item_kind == "method": "fn" else: raw.components.item_kind
        val span = raw.declaration_span
        val key = "{span.start}:{span.end}:{kind}"
        val claims: [i64] = symbols[key] ?? []
        if claims.len() == 1:
            declaration.local_symbol_id = claims[0]
        else:
            declaration.local_symbol_id = -1
            if raw.manifest != nil or raw.requires_manifest:
                declaration.metadata_errors.push("representation declaration has no unique exact HIR symbol/span binding")
        out.push(declaration)
    out
