# In-memory short-fingerprint index over stable symbol ids.
#
# Maps short fingerprint -> (full 128-bit id, module path) with collision
# detection at build time: a build whose short forms are ambiguous fails with
# Err instead of guessing. No persistence — consumers (LSP/lint/doc lanes)
# layer that on later.
#
# Native-codegen note: Dict.len() and Dict.get() are unreliable under native
# codegen (see CLAUDE.md "Native-Codegen Dict Pitfalls"), so this index keeps
# a maintained count and uses contains_key + index reads only.

use compiler.semantics.symbol_id.stable_id.{
    SymbolComponents, stable_symbol_id, short_fingerprint_n,
    clamp_short_len, default_short_len
}
use compiler.semantics.symbol_id.redirects_v1.{
    SymbolRedirectV1, SymbolRedirectTableV1, build_symbol_redirect_table_v1
}

class SymbolIndex:
    short_len: i64
    count: i64
    shorts: [text]                    # insertion-ordered short forms
    short_to_full: Dict<text, text>   # short -> full 32-hex id
    short_to_module: Dict<text, text> # short -> module path
    redirect_table_v1: SymbolRedirectTableV1

    me size() -> i64:
        self.count

    me contains(short: text) -> bool:
        self.short_to_full.contains_key(short)

    me full_id_of(short: text) -> text:
        """Full 32-hex id for a short form, "" when unknown."""
        if self.short_to_full.contains_key(short):
            self.short_to_full[short]
        else:
            ""

    me module_of(short: text) -> text:
        """Module path for a short form, "" when unknown."""
        if self.short_to_module.contains_key(short):
            self.short_to_module[short]
        else:
            ""

    me resolve_full_id_v1(full_id: text) -> text:
        """Exact current or registered historical full ID, else empty text.

        Short forms retain the existing full_id_of semantics. This read borrows
        the index and its owned table; no ID hashing or history walk occurs.
        """
        val short = short_fingerprint_n(full_id, self.short_len)
        if self.short_to_full.contains_key(short):
            if self.short_to_full[short] == full_id:
                return full_id
        self.redirect_table_v1.resolve_old_id_v1(full_id)

fn build_symbol_index(items: [SymbolComponents]) -> Result<SymbolIndex, text>:
    build_symbol_index_with_short_len(items, default_short_len())

fn build_symbol_index_with_short_len(items: [SymbolComponents], short_len: i64) -> Result<SymbolIndex, text>:
    """Build an index from symbol components.

    short_len is the test seam for collision behaviour: shrinking it (e.g. to 1)
    forces distinct ids onto the same short form, which must yield Err.
    Re-listing the exact same symbol is idempotent, not a collision."""
    val n = clamp_short_len(short_len)
    val idx = SymbolIndex(
        short_len: n,
        count: 0,
        shorts: [],
        short_to_full: {},
        short_to_module: {},
        redirect_table_v1: SymbolRedirectTableV1(
            table_version: 1,
            edge_count: 0,
            direct_to_full: {},
            terminal_by_old: {}
        )
    )
    var collisions: [text] = []
    for c in items:
        val full = stable_symbol_id(c)
        val short = short_fingerprint_n(full, n)
        if idx.short_to_full.contains_key(short):
            val existing = idx.short_to_full[short]
            if existing != full and not collisions.contains(short):
                collisions = collisions.push(short)
        else:
            idx.short_to_full[short] = full
            idx.short_to_module[short] = c.module_path
            idx.shorts = idx.shorts.push(short)
            idx.count = 1 + idx.count
    if collisions.is_empty():
        Ok(idx)
    else:
        val joined = collisions.join(", ")
        Err("short fingerprint collision at length {n}: {joined}")

fn build_symbol_index_with_redirects_v1(items: [SymbolComponents], rows: [SymbolRedirectV1]) -> Result<SymbolIndex, text>:
    """Build current symbols first, then atomically admit explicit redirects.

    Only fully validated snapshots escape. Empty rows preserve the legacy
    construction path without historical preprocessing or duplicate hashing.
    """
    match build_symbol_index(items):
        case Err(message):
            Err(message)
        case Ok(idx):
            if rows.is_empty():
                return Ok(idx)
            var live_full_ids: [text] = []
            for short in idx.shorts:
                live_full_ids = live_full_ids.push(idx.short_to_full[short])
            match build_symbol_redirect_table_v1(rows, live_full_ids):
                case Err(message):
                    Err(message)
                case Ok(table):
                    idx.redirect_table_v1 = table
                    Ok(idx)
