# REQ-MC-008 / B2. URI syntax only; source authority belongs to semantic_link_source.
# Adapted from the retained lane06 short-URI draft. B1 owns identity encoding.
use compiler.semantics.symbol_id.stable_id.{default_short_len}

pub enum SemanticLinkFailureV1:
    InvalidUri
    UnsupportedKind
    MissingFingerprint
    InvalidAuthority
    WrongPackage
    RevisionChanged
    IoFailed
    ParseFailed
    UnsupportedSignature
    UnsupportedSourceTransform
    InvalidSpan
    UnresolvedTarget
    StaleFingerprint
    AmbiguousTarget
    FingerprintCollision
    CapacityExceeded

pub struct SemanticLinkErrorV1:
    failure: SemanticLinkFailureV1
    message: text

# A row is an input URI index. -1 denotes whole-batch authority/admission
# failure, which must not be attributed to an arbitrary Markdown destination.
pub struct SemanticLinkBatchErrorV1:
    row: i64
    error: SemanticLinkErrorV1

pub struct SemanticLinkV1:
    package: text               # empty only for the repository-local short form
    module_path: text
    item_kind: text
    name: text
    fingerprint: text

pub fn semantic_link_error_v1(failure: SemanticLinkFailureV1, message: text) -> SemanticLinkErrorV1:
    SemanticLinkErrorV1(failure: failure, message: message)

pub fn semantic_link_identifier_v1(value: text) -> bool:
    if value.len() == 0:
        return false
    for i in 0..value.len():
        val ch = value.slice(i, i + 1)
        val letter = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
        val digit = ch >= "0" and ch <= "9"
        if not letter and (i == 0 or not digit):
            return false
    true

pub fn semantic_link_path_v1(value: text) -> bool:
    if value == "":
        return false
    for part in value.split("."):
        if not semantic_link_identifier_v1(part):
            return false
    true

pub fn semantic_link_hex_v1(value: text, length: i64) -> bool:
    if value.len() != length:
        return false
    for i in 0..value.len():
        if not "0123456789abcdef".contains(value.slice(i, i + 1)):
            return false
    true

pub fn parse_semantic_link_v1(uri: text) -> Result<SemanticLinkV1, SemanticLinkErrorV1>:
    """Accept B1 short links and the original package/module#kind:name form.

    Both use B1's 12 lowercase hex fingerprint; no URI decoding, whitespace
    trimming, historical illustrative base32, or alternate full-ID grammar.
    """
    if uri.len() > 4096 or not uri.starts_with("spl:"):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected a bounded spl URI"))
    val fingerprint_parts = uri.split("~")
    if fingerprint_parts.len() == 1 or (fingerprint_parts.len() == 2 and fingerprint_parts[1] == ""):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.MissingFingerprint, "stable fingerprint is required"))
    if fingerprint_parts.len() != 2 or not semantic_link_hex_v1(fingerprint_parts[1], default_short_len()):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected one lowercase 12-hex fingerprint"))
    var package = ""
    var module_path = ""
    var kind = ""
    var name = ""
    val body = fingerprint_parts[0]
    if body.starts_with("spl://"):
        val parts = body.slice(6, body.len()).split("/")
        if parts.len() != 2:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected package/module#kind:name"))
        package = parts[0]
        val fragment = parts[1].split("#")
        if fragment.len() != 2 or not semantic_link_path_v1(package):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "invalid package or declaration fragment"))
        module_path = fragment[0]
        val declaration = fragment[1].split(":")
        if declaration.len() != 2:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected kind:name"))
        kind = declaration[0]
        name = declaration[1]
    else:
        val parts = body.slice(4, body.len()).split("@")
        if parts.len() != 2:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "expected kind@module.name"))
        kind = parts[0]
        val names = parts[1].split(".")
        if names.len() < 2:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "module-qualified name is required"))
        name = names[names.len() - 1]
        var modules: [text] = []
        for i in 0..(names.len() - 1):
            modules.push(names[i])
        module_path = modules.join(".")
    if not semantic_link_path_v1(module_path) or not semantic_link_identifier_v1(name) or not semantic_link_identifier_v1(kind):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidUri, "noncanonical declaration name"))
    if not ["fn", "method", "type", "trait", "field", "variant", "const", "contract", "test"].contains(kind):
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.UnsupportedKind, "unknown declaration kind"))
    Ok(SemanticLinkV1(package: package, module_path: module_path, item_kind: kind, name: name, fingerprint: fingerprint_parts[1]))
