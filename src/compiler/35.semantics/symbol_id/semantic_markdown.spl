# REQ-MC-008 / B3. Pure, bounded Markdown edits backed by parsed source snapshots.
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkErrorV1, SemanticLinkFailureV1, semantic_link_error_v1, parse_semantic_link_v1}
use compiler.semantics.symbol_id.semantic_link_source.{SemanticLinkDocumentV1, semantic_link_read_revision_v1, resolve_semantic_links_source_indexed_v1}
use compiler.semantics.symbol_id.semantic_link_location.{semantic_links_from_lines_v1}
use std.common.crypto.sha256.{sha256_text}
use compiler.semantics.symbol_id.semantic_markdown_exception.{SemanticMarkdownExceptionReceiptV1, validate_semantic_markdown_exception_v1}

pub struct SemanticMarkdownSourceV1:
    local_file: text
    remote_file: text
    document: SemanticLinkDocumentV1

pub struct SemanticMarkdownDiagnosticV1:
    rule: text
    severity: text
    start: i64
    end: i64
    target: text
    replacement: text
    message: text

pub struct SemanticMarkdownPlanV1:
    revision: text
    diagnostics: [SemanticMarkdownDiagnosticV1]
    sources: [SemanticMarkdownSourceV1]
    reviewed_exception: SemanticMarkdownExceptionReceiptV1? = nil

struct MarkdownLineTargetV1:
    start: i64
    end: i64
    file: text
    first: i64
    last: i64

fn markdown_line_number_v1(value: text) -> i64:
    if value == "" or value.len() > 9:
        return -1
    var result = 0
    for i in 0..value.len():
        val digit = value.slice(i, i + 1)
        if digit < "0" or digit > "9":
            return -1
        result = result * 10 + (digit.to_int() ?? 0)
    result

fn markdown_line_target_v1(token: text, start: i64) -> MarkdownLineTargetV1?:
    if token.starts_with("spl:"):
        return Some(MarkdownLineTargetV1(start: start, end: start + token.len(), file: token, first: 0, last: 0))
    var marker = token.index_of(".spl#L")
    var file_end = marker + 4
    var range_start = marker + 6
    var separator = "-L"
    if marker < 0:
        marker = token.index_of(".spl:")
        file_end = marker + 4
        range_start = marker + 5
        separator = "-"
    if marker < 0:
        return nil
    val ranges = token.slice(range_start, token.len()).split(separator)
    val first = if ranges.len() >= 1 and ranges.len() <= 2: markdown_line_number_v1(ranges[0]) else: -1
    val last = if ranges.len() == 2: markdown_line_number_v1(ranges[1]) else: first
    Some(MarkdownLineTargetV1(start: start, end: start + token.len(), file: token.slice(0, file_end), first: first, last: last))

fn markdown_marker_run_v1(source: text, offset: i64, marker: text) -> i64:
    var end = offset
    while end < source.len() and source.slice(end, end + 1) == marker:
        end = end + 1
    end - offset

fn markdown_line_targets_v1(markdown: text) -> Result<[MarkdownLineTargetV1], SemanticLinkErrorV1>:
    # Byte-space scanner: protect fences, matching backtick runs, link labels,
    # escaped characters and HTML comments. Destinations and reference-definition
    # destinations share token parsing; bare src/... locations are also linted.
    if markdown.len() > 1048576:
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "Markdown exceeds 1 MiB"))
    var targets: [MarkdownLineTargetV1] = []
    var probes = 0
    var offset = 0
    var line_start = true
    var fence_marker = ""
    var fence_length = 0
    var labels = 0
    var destination = false
    var link_tail = false
    while offset < markdown.len():
        probes = probes + 1
        if probes > markdown.len() * 8 + 64:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "Markdown scanner work budget exceeded"))
        if line_start:
            var probe = offset
            while probe < markdown.len() and probe - offset < 4 and markdown.slice(probe, probe + 1) == " ":
                probe = probe + 1
            if fence_marker == "" and (probe - offset == 4 or markdown.slice(offset, offset + 1) == "\t"):
                while offset < markdown.len() and markdown.slice(offset, offset + 1) != "\n":
                    offset = offset + 1
                if offset < markdown.len():
                    offset = offset + 1
                continue
            if probe - offset <= 3 and probe < markdown.len():
                val marker = markdown.slice(probe, probe + 1)
                if marker == "`" or marker == "~":
                    val run = markdown_marker_run_v1(markdown, probe, marker)
                    if run >= 3 and (fence_marker == "" or (marker == fence_marker and run >= fence_length)):
                        if fence_marker == "":
                            fence_marker = marker
                            fence_length = run
                        else:
                            # Only whitespace may follow a closing fence.
                            var close_end = probe + run
                            while close_end < markdown.len() and markdown.slice(close_end, close_end + 1) != "\n":
                                close_end = close_end + 1
                            if markdown.slice(probe + run, close_end).trim() == "":
                                fence_marker = ""
                                fence_length = 0
                        while offset < markdown.len() and markdown.slice(offset, offset + 1) != "\n":
                            offset = offset + 1
                        continue
            line_start = false
        val ch = markdown.slice(offset, offset + 1)
        if ch == "\n":
            line_start = true
            destination = false
            link_tail = false
            labels = 0
            offset = offset + 1
            continue
        if fence_marker != "":
            offset = offset + 1
            continue
        if offset + 4 <= markdown.len() and markdown.slice(offset, offset + 4) == "<!--":
            val close = markdown.slice(offset + 4, markdown.len()).index_of("-->")
            if close < 0:
                break
            offset = offset + 4 + close + 3
            continue
        if ch == "\\":
            # Skip the escaped token, including escaped prose source examples.
            offset = offset + 1
            while offset < markdown.len() and not [" ", "\n", "\t"].contains(markdown.slice(offset, offset + 1)):
                offset = offset + 1
            continue
        if ch == "`":
            val run = markdown_marker_run_v1(markdown, offset, "`")
            var close = offset + run
            var found = false
            while close < markdown.len():
                probes = probes + 1
                if probes > markdown.len() * 8 + 64:
                    return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "Markdown inline scan work budget exceeded"))
                if markdown.slice(close, close + 1) == "`":
                    val closing_run = markdown_marker_run_v1(markdown, close, "`")
                    if closing_run == run:
                        offset = close + run
                        found = true
                        break
                    close = close + closing_run
                else:
                    close = close + 1
            if not found:
                offset = offset + run
            continue
        if link_tail and (ch == "\"" or ch == "'"):
            var close = offset + 1
            while close < markdown.len() and markdown.slice(close, close + 1) != ch and markdown.slice(close, close + 1) != "\n":
                close = close + 1
            offset = if close < markdown.len(): close + 1 else: close
            continue
        if ch == "[":
            labels = labels + 1
            link_tail = false
            offset = offset + 1
            continue
        if ch == "]":
            labels = if labels > 0: labels - 1 else: 0
            if offset + 1 < markdown.len():
                val next = markdown.slice(offset + 1, offset + 2)
                if next == "(" or next == ":":
                    destination = true
                    offset = offset + 2
                    continue
            offset = offset + 1
            continue
        if labels > 0:
            offset = offset + 1
            continue
        if ch == "<":
            destination = true
            offset = offset + 1
            continue
        if [" ", "\t", "\r", "("].contains(ch):
            offset = offset + 1
            continue
        if ch == ")" or ch == ">":
            destination = false
            link_tail = false
            offset = offset + 1
            continue
        var end = offset
        while end < markdown.len() and not [" ", "\t", "\n", "\r", ")", ">", "\"", "'", "[", "]", "`"].contains(markdown.slice(end, end + 1)):
            end = end + 1
        if end == offset:
            offset = offset + 1
            continue
        val token = markdown.slice(offset, end)
        if destination or token.starts_with("src/") or token.starts_with("https://github.com/"):
            if val target = markdown_line_target_v1(token, offset):
                if targets.len() >= 4096:
                    return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "more than 4096 Markdown locations"))
                targets.push(target)
        offset = end
        # A destination's optional title must never become another destination.
        link_tail = destination
        destination = false
    Ok(targets)

pub fn plan_semantic_markdown_links_v1(markdown: text, bindings: [SemanticMarkdownSourceV1], critical: bool, reviewed_exception: SemanticMarkdownExceptionReceiptV1? = nil) -> Result<SemanticMarkdownPlanV1, SemanticLinkErrorV1>:
    if bindings.len() > 4096:
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "more than 4096 source bindings"))
    val targets = markdown_line_targets_v1(markdown)?
    var diagnostics: [SemanticMarkdownDiagnosticV1] = []
    var assignments: [i64] = []
    for target in targets:
        var binding_index = -1
        var duplicate = false
        var message = "source destination has no unique configured revision authority"
        val semantic = target.file.starts_with("spl:")
        if semantic:
            match parse_semantic_link_v1(target.file):
                case Ok(link):
                    for row in 0..bindings.len():
                        val document = bindings[row].document
                        if link.module_path == document.module_path and (link.package == "" or link.package == document.package):
                            if binding_index >= 0:
                                duplicate = true
                            binding_index = row
                case Err(error): return Err(semantic_link_error_v1(error.failure, "{target.start}:{target.end} {target.file}: " + error.message))
        else:
            for row in 0..bindings.len():
                if target.file == bindings[row].local_file or (bindings[row].remote_file != "" and target.file == bindings[row].remote_file):
                    if binding_index >= 0:
                        duplicate = true
                    binding_index = row
        if semantic and (duplicate or binding_index < 0):
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "{target.start}:{target.end} {target.file}: unique explicit source identity/revision owner required"))
        assignments.push(if duplicate: -1 else: binding_index)
        diagnostics.push(SemanticMarkdownDiagnosticV1(rule: "W-DOC-AST-001", severity: if semantic or critical: "deny" else: "warn", start: target.start, end: target.end,
            target: markdown.slice(target.start, target.end), replacement: "", message: message))
    # Group by explicit snapshot and URI form: at most two bounded reads per
    # source/form batch, regardless of the number of links referencing it.
    for binding_index in 0..bindings.len():
        for remote in [false, true]:
            var rows: [i64] = []
            var ranges: [(i64, i64)] = []
            for row in 0..targets.len():
                if assignments[row] == binding_index and not targets[row].file.starts_with("spl:") and targets[row].file.starts_with("https://") == remote:
                    rows.push(row)
                    ranges.push((targets[row].first, targets[row].last))
            if rows.is_empty():
                continue
            val binding = bindings[binding_index]
            match semantic_links_from_lines_v1(binding.document, binding.document.revision, ranges, remote):
                case Ok(uris):
                    for position in 0..rows.len():
                        val row = rows[position]
                        val prior = diagnostics[row]
                        diagnostics[row] = SemanticMarkdownDiagnosticV1(rule: prior.rule, severity: prior.severity, start: prior.start, end: prior.end,
                            target: prior.target, replacement: uris[position], message: "replace line location with a stable semantic declaration URI")
                case Err(error):
                    for row in rows:
                        val prior = diagnostics[row]
                        diagnostics[row] = SemanticMarkdownDiagnosticV1(rule: prior.rule, severity: prior.severity, start: prior.start, end: prior.end,
                            target: prior.target, replacement: "", message: error.message)
    # Existing semantic destinations use the same actual-source resolver, once
    # per configured owner batch. A valid URI needs no edit or lint diagnostic.
    for binding_index in 0..bindings.len():
        var rows: [i64] = []
        var uris: [text] = []
        for row in 0..targets.len():
            if assignments[row] == binding_index and targets[row].file.starts_with("spl:"):
                rows.push(row)
                uris.push(targets[row].file)
        if rows.is_empty():
            continue
        val document = bindings[binding_index].document
        match resolve_semantic_links_source_indexed_v1(uris, document, document.revision):
            case Ok(_):
                for row in rows:
                    val prior = diagnostics[row]
                    diagnostics[row] = SemanticMarkdownDiagnosticV1(rule: prior.rule, severity: prior.severity, start: prior.start, end: prior.end,
                        target: prior.target, replacement: prior.target, message: "semantic URI validated")
            case Err(failure):
                if failure.row >= 0 and failure.row < rows.len():
                    val target = targets[rows[failure.row]]
                    return Err(semantic_link_error_v1(failure.error.failure,
                        "{target.start}:{target.end} {target.file}: semantic batch refused: " + failure.error.message))
                return Err(semantic_link_error_v1(failure.error.failure,
                    "semantic source batch refused: " + failure.error.message))
    var findings: [SemanticMarkdownDiagnosticV1] = []
    for diagnostic in diagnostics:
        if diagnostic.message != "semantic URI validated":
            findings.push(diagnostic)
    if val receipt = reviewed_exception:
        val scope = validate_semantic_markdown_exception_v1(receipt, markdown)?
        var matches = 0
        var retained: [SemanticMarkdownDiagnosticV1] = []
        for finding in findings:
            if finding.start == scope.start and finding.end == scope.end and finding.target == scope.target and not finding.target.starts_with("spl:"):
                matches = matches + 1
            else:
                retained.push(finding)
        if matches != 1:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "reviewed exception must match exactly one scanner line destination"))
        findings = retained
    Ok(SemanticMarkdownPlanV1(revision: sha256_text(markdown), diagnostics: findings, sources: bindings, reviewed_exception: reviewed_exception))

pub fn apply_semantic_markdown_links_v1(markdown: text, plan: SemanticMarkdownPlanV1) -> Result<text, SemanticLinkErrorV1>:
    """Return all replacements or an error; caller performs one atomic publication.

    No filesystem write occurs here. Revalidate all source revisions and the full
    Markdown revision immediately before constructing the immutable replacement.
    """
    if markdown.len() > 1048576 or plan.diagnostics.len() > 4096 or plan.sources.len() > 4096:
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.CapacityExceeded, "edit plan exceeds bounds"))
    if sha256_text(markdown) != plan.revision:
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.RevisionChanged, "Markdown changed after lint planning"))
    val fresh = plan_semantic_markdown_links_v1(markdown, plan.sources, false, plan.reviewed_exception)?
    if fresh.diagnostics.len() != plan.diagnostics.len():
        return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "edit plan does not match the Markdown source"))
    for row in 0..fresh.diagnostics.len():
        val observed = fresh.diagnostics[row]
        val proposed = plan.diagnostics[row]
        if observed.start != proposed.start or observed.end != proposed.end or observed.target != proposed.target or observed.replacement != proposed.replacement:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.InvalidAuthority, "edit plan differs from fresh semantic resolution"))
    var position = 0
    var parts: [text] = []
    for diagnostic in plan.diagnostics:
        if diagnostic.start < position or diagnostic.end <= diagnostic.start or diagnostic.end > markdown.len() or diagnostic.replacement == "":
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.AmbiguousTarget, "edit plan contains unresolved or overlapping changes"))
        if markdown.slice(diagnostic.start, diagnostic.end) != diagnostic.target:
            return Err(semantic_link_error_v1(SemanticLinkFailureV1.RevisionChanged, "edit target changed"))
        parts.push(markdown.slice(position, diagnostic.start))
        parts.push(diagnostic.replacement)
        position = diagnostic.end
    parts.push(markdown.slice(position, markdown.len()))
    for binding in plan.sources:
        semantic_link_read_revision_v1(binding.document.file, binding.document.revision)?
    if val receipt = plan.reviewed_exception:
        val _scope = validate_semantic_markdown_exception_v1(receipt, markdown)?
    Ok(parts.join(""))


pub fn semantic_markdown_process_failures_v1(markdown: text, bindings: [SemanticMarkdownSourceV1]) -> [text]:
    """Process-doc callers without identity ownership must pass no bindings.

    Actual semantic destinations then fail closed; no guessed package/revision.
    The configured doc command may supply explicitly owned parsed sources.
    """
    var failures: [text] = []
    match plan_semantic_markdown_links_v1(markdown, bindings, false):
        case Err(error): failures.push("semantic document check refused: " + error.message)
        case Ok(_): return failures
    failures
