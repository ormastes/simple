# Explicit full-ID rename metadata for the frozen schema1 symbol identity.
# Table format v1 is independent of identity schema1; no persistence or rename
# event producer is implied. Build a new validated snapshot when facts change.
use compiler.semantics.symbol_id.stable_id.{
    SymbolComponents, stable_symbol_id, normalize_signature
}

struct SymbolRedirectV1:
    table_version: i64
    old_symbol: SymbolComponents
    new_symbol: SymbolComponents

class SymbolRedirectTableV1:
    table_version: i64
    edge_count: i64
    direct_to_full: Dict<text, text>
    terminal_by_old: Dict<text, text>

    me resolve_old_id_v1(old_full_id: text) -> text:
        """Historical full ID to indexed live terminal, or empty when absent.

        Borrow the owned table: lookup never copies or walks the graph.
        Current IDs are handled by SymbolIndex, not this alias-only method.
        """
        if self.terminal_by_old.contains_key(old_full_id):
            self.terminal_by_old[old_full_id]
        else:
            ""

fn build_symbol_redirect_table_v1(rows: [SymbolRedirectV1], live_full_ids: [text]) -> Result<SymbolRedirectTableV1, text>:
    """Validate explicit rename rows and pre-resolve every historical source.

    Example: rows A->B, B->C with only C live resolve both A and B to C.
    An A->B edge with no live terminal returns Err. Equal duplicate edges are
    idempotent; an ambiguous source, cycle or live source always returns Err.
    Callers provide actual indexed live IDs, never a spelling/similarity map.
    """
    val table = SymbolRedirectTableV1(
        table_version: 1,
        edge_count: 0,
        direct_to_full: {},
        terminal_by_old: {}
    )
    if rows.is_empty():
        return Ok(table)

    # Stable source order controls diagnostics; never iterate dictionary keys.
    var sources: [text] = []
    for row in rows:
        if row.table_version != 1:
            return Err("unsupported symbol redirect table version {row.table_version}")
        val old = row.old_symbol
        val new = row.new_symbol
        if (old.package != new.package or old.module_path != new.module_path or
            old.item_kind != new.item_kind or old.owner_id != new.owner_id or
            normalize_signature(old.signature) != normalize_signature(new.signature)):
            return Err("redirect identity mismatch for {old.name} -> {new.name}")
        val old_full = stable_symbol_id(old)
        val new_full = stable_symbol_id(new)
        if old.name == new.name or old_full == new_full:
            return Err("self redirect refused for {old_full} -> {new_full}")
        if table.direct_to_full.contains_key(old_full):
            val existing = table.direct_to_full[old_full]
            if existing != new_full:
                return Err("redirect conflict for {old_full}: {existing} versus {new_full}")
        else:
            table.direct_to_full[old_full] = new_full
            sources = sources.push(old_full)
            table.edge_count = table.edge_count + 1

    var live: Dict<text, bool> = {}
    for full in live_full_ids:
        live[full] = true
    for source in sources:
        if live.contains_key(source):
            return Err("live symbol is also a redirect source: {source}")

    # A node is visited once globally. Resolved paths are compressed into the
    # owned terminal map; later roots sharing a tail stop immediately there.
    # Explicit iteration avoids recursion and bounds even malformed histories.
    var visited: Dict<text, bool> = {}
    for source in sources:
        if table.terminal_by_old.contains_key(source):
            continue
        var path: [text] = []
        var current = source
        var terminal = ""
        for walk in 0..(table.edge_count + 1):
            if table.terminal_by_old.contains_key(current):
                terminal = table.terminal_by_old[current]
                break
            if live.contains_key(current):
                terminal = current
                break
            if not table.direct_to_full.contains_key(current):
                return Err("redirect terminal is not indexed live: {current} (from {source})")
            if visited.contains_key(current):
                return Err("redirect cycle at {current} (from {source})")
            visited[current] = true
            path = path.push(current)
            current = table.direct_to_full[current]
        if terminal == "":
            return Err("redirect history exceeds edge bound from {source}")
        for old_full in path:
            table.terminal_by_old[old_full] = terminal
    Ok(table)
