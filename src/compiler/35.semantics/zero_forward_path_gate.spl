# `@zero_forward_path` mechanical gate — C5 / M7 of
# doc/03_plan/compiler/forwarding/zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md,
# which is §3 lane C5 of doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md
# (lines 209-215).
#
# WHAT THE PLAN ASKS FOR (verbatim, §3 C5): "Compiler reports per hot
# entrypoint: logical_forward_edges=N, physical_forward_calls=0,
# layer_view_copy_bytes=0, temporary_allocations=0, dynamic_dispatches<=1/batch.
# Compilation FAILS when a claimed identity view changes size/alignment/
# ownership/address-space, needs unit/color conversion, allocates, copies, or
# calls a user conversion."
#
# WHAT THIS FILE IS — AND IS NOT (stated plainly, do not overclaim):
#   - This is the DECISION half of the gate: a pure function over supplied
#     counters, in exactly the established shape of its siblings in this
#     directory (layer_dag_checker.spl, layer_eq_checker.spl,
#     effect_verifier.spl) — a self-contained checker + spec, not a pass
#     registered with the compile driver.
#   - The FACT half (turning real source into these counters) lives in
#     src/compiler/90.tools/verify/forward_hop_scan.spl, mirroring the
#     layer_call_direction_checker.spl <- layer_call_scan.spl split already
#     used for M1.
#   - M7's own plan text says "wire the gate to already-existing counters; do
#     not invent new measurement machinery here if M4-M6 already emit what's
#     needed — re-check before adding anything." Re-checked 2026-08-08: M4 is
#     PARTIAL (hir_forward_decl.spl is a data shape with ZERO consumers —
#     grep-verified), M5 and M6 are DESIGNED-ONLY. So no post-collapse MIR
#     counters exist to wire to. Three of the four axes are therefore NOT
#     measurable today, and this gate refuses to pretend otherwise.
#
# FAIL-CLOSED CONTRACT (the point of the whole file):
#   A gate that reports "0 violations" having examined 0 entrypoints has
#   proven nothing. Therefore:
#     1. An empty entry list is BLOCKED, never OK.
#     2. An entry list with zero `@zero_forward_path`-annotated entrypoints is
#        BLOCKED, never OK — the annotation is what makes a claim checkable.
#     3. Every axis a producer could not measure MUST be declared in
#        `unmeasured_axes` and yields an explicit ZFP_UNMEASURED violation with
#        a reason string. An absent number is never read as a zero.
#     4. `dynamic_dispatches` with `batches <= 0` is unmeasurable (no divisor),
#        not a pass.
#   Consequently, on today's tree the FULL gate is BLOCKED for every
#   entrypoint. The HOP axis alone IS measurable from source right now (an
#   alias forwarding declaration provably desugars to a physical body — see
#   src/app/desugar/forwarding.spl), so `hop_axis_verdict` gates that one axis
#   independently and really does bite. That is the plan's §0 line "physical
#   forward hops = 0" pinned ahead of M4-M6, which is the only part of C5 that
#   can honestly land before them.

# --- violation kinds -------------------------------------------------------

val ZFP_PHYSICAL_FORWARD_CALL = 1
val ZFP_LAYER_VIEW_COPY = 2
val ZFP_TEMPORARY_ALLOCATION = 3
val ZFP_DYNAMIC_DISPATCH = 4
val ZFP_UNMEASURED = 5

# --- axis names ------------------------------------------------------------
# An axis named in `ZeroForwardEntry.unmeasured_axes` is one the fact producer
# could not determine. Any other spelling is itself an error (see
# `zfp_known_axis`) — a typo'd axis name must not silently disable a check.

val ZFP_AXIS_HOPS = "hops"
val ZFP_AXIS_COPY_BYTES = "copy_bytes"
val ZFP_AXIS_ALLOCATIONS = "allocations"
val ZFP_AXIS_DISPATCH = "dispatch"

struct ForwardEdge:
    """One logical forwarding edge `from_symbol -> to_symbol`.

    `physical` is true when a real call instruction survives to the executable
    for this edge (i.e. the hop was NOT collapsed). `copy_bytes` is the
    layer-view copy this edge costs; it is only meaningful when the producer
    did not declare the `copy_bytes` axis unmeasured.
    """
    from_symbol: text
    to_symbol: text
    physical: bool
    copy_bytes: i64

struct ZeroForwardEntry:
    """Facts about one hot entrypoint, as supplied by a fact producer.

    `annotated` mirrors the `@zero_forward_path` decorator: only annotated
    entrypoints are gated, but unannotated ones still count toward `scanned`
    so that a run which examined real code can be told apart from one that
    examined nothing.

    `unmeasured_axes` is the honesty valve: every axis listed there produces an
    explicit BLOCKED violation instead of being read as a zero.
    """
    entrypoint: text
    annotated: bool
    edges: [ForwardEdge]
    temporary_allocations: i64
    dynamic_dispatches: i64
    batches: i64
    unmeasured_axes: [text]
    unmeasured_reason: text

struct ZeroForwardViolation:
    entrypoint: text
    kind: i64
    detail: text

struct ZeroForwardCounters:
    """The per-entrypoint report line the plan's §3 C5 asks the compiler to
    print. Counts on unmeasured axes are reported as -1, never 0 — a negative
    reading is unmistakably "not measured" and cannot be mistaken for a pass.
    """
    entrypoint: text
    logical_forward_edges: i64
    physical_forward_calls: i64
    layer_view_copy_bytes: i64
    temporary_allocations: i64
    dynamic_dispatches: i64
    batches: i64

struct ZeroForwardVerdict:
    """`ok` is true only when the run examined a nonzero number of gated
    entrypoints AND every axis of every gated entrypoint was both measured and
    clean. `blocked` is true when anything was unmeasurable — a blocked verdict
    is never also `ok`.
    """
    ok: bool
    blocked: bool
    reason: text
    scanned: i64
    gated: i64
    violations: [ZeroForwardViolation]

fn zfp_known_axis(axis: text) -> bool:
    """True for the four axis names this gate understands. An unrecognized
    axis name is treated as an error rather than silently ignored, so a typo in
    a producer cannot disable a check by accident."""
    if axis == ZFP_AXIS_HOPS:
        return true
    if axis == ZFP_AXIS_COPY_BYTES:
        return true
    if axis == ZFP_AXIS_ALLOCATIONS:
        return true
    if axis == ZFP_AXIS_DISPATCH:
        return true
    false

fn zfp_axis_unmeasured(entry: ZeroForwardEntry, axis: text) -> bool:
    """True when `axis` was declared unmeasurable for this entrypoint."""
    for a in entry.unmeasured_axes:
        if a == axis:
            return true
    false

fn zfp_violation(entrypoint: text, kind: i64, detail: text) -> ZeroForwardViolation:
    ZeroForwardViolation(entrypoint: entrypoint, kind: kind, detail: detail)

fn zfp_kind_label(kind: i64) -> text:
    if kind == ZFP_PHYSICAL_FORWARD_CALL:
        return "physical_forward_call"
    if kind == ZFP_LAYER_VIEW_COPY:
        return "layer_view_copy"
    if kind == ZFP_TEMPORARY_ALLOCATION:
        return "temporary_allocation"
    if kind == ZFP_DYNAMIC_DISPATCH:
        return "dynamic_dispatch"
    if kind == ZFP_UNMEASURED:
        return "unmeasured"
    "unknown"

fn format_zfp_violation(v: ZeroForwardViolation) -> text:
    "error[zero_forward_path]: " + v.entrypoint + ": " + zfp_kind_label(v.kind)
        + ": " + v.detail

fn format_zfp_violations(violations: [ZeroForwardViolation]) -> [text]:
    var out: [text] = []
    for v in violations:
        out.push(format_zfp_violation(v))
    out

fn zfp_physical_calls(entry: ZeroForwardEntry) -> i64:
    var n = 0
    for e in entry.edges:
        if e.physical:
            n = n + 1
    n

fn zfp_copy_bytes(entry: ZeroForwardEntry) -> i64:
    var n = 0
    for e in entry.edges:
        n = n + e.copy_bytes
    n

fn zero_forward_counters(entry: ZeroForwardEntry) -> ZeroForwardCounters:
    """Build the §3 C5 report line. Unmeasured axes read -1, not 0."""
    var physical = 0 - 1
    if not zfp_axis_unmeasured(entry, ZFP_AXIS_HOPS):
        physical = zfp_physical_calls(entry)
    var copy_bytes = 0 - 1
    if not zfp_axis_unmeasured(entry, ZFP_AXIS_COPY_BYTES):
        copy_bytes = zfp_copy_bytes(entry)
    var allocations = 0 - 1
    if not zfp_axis_unmeasured(entry, ZFP_AXIS_ALLOCATIONS):
        allocations = entry.temporary_allocations
    var dispatches = 0 - 1
    var batches = 0 - 1
    if not zfp_axis_unmeasured(entry, ZFP_AXIS_DISPATCH):
        dispatches = entry.dynamic_dispatches
        batches = entry.batches
    ZeroForwardCounters(
        entrypoint: entry.entrypoint,
        logical_forward_edges: entry.edges.len(),
        physical_forward_calls: physical,
        layer_view_copy_bytes: copy_bytes,
        temporary_allocations: allocations,
        dynamic_dispatches: dispatches,
        batches: batches,
    )

fn format_zero_forward_counters(c: ZeroForwardCounters) -> text:
    c.entrypoint + ": logical_forward_edges=" + c.logical_forward_edges.to_text()
        + ", physical_forward_calls=" + c.physical_forward_calls.to_text()
        + ", layer_view_copy_bytes=" + c.layer_view_copy_bytes.to_text()
        + ", temporary_allocations=" + c.temporary_allocations.to_text()
        + ", dynamic_dispatches=" + c.dynamic_dispatches.to_text()
        + "/batches=" + c.batches.to_text()

fn _zfp_unmeasured_detail(entry: ZeroForwardEntry, axis: text) -> text:
    var reason = entry.unmeasured_reason
    if reason == "":
        reason = "producer supplied no reason"
    "axis '" + axis + "' was not measured (" + reason
        + "); an unmeasured axis is BLOCKED, never a pass"

fn check_zero_forward_entry(entry: ZeroForwardEntry) -> [ZeroForwardViolation]:
    """Gate one entrypoint. Returns [] for an unannotated entrypoint (nothing
    was claimed, so nothing is checked) — callers must NOT read that empty list
    as a pass; `check_all_zero_forward_paths` is what enforces that at least
    one annotated entrypoint existed."""
    var violations: [ZeroForwardViolation] = []
    if not entry.annotated:
        return violations

    for axis in entry.unmeasured_axes:
        if not zfp_known_axis(axis):
            violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
                "unknown axis name '" + axis
                + "' — a misspelled axis must not silently disable a check"))

    # Hop axis — the plan's §0 "physical forward hops = 0".
    if zfp_axis_unmeasured(entry, ZFP_AXIS_HOPS):
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            _zfp_unmeasured_detail(entry, ZFP_AXIS_HOPS)))
    else:
        for e in entry.edges:
            if e.physical:
                violations.push(zfp_violation(entry.entrypoint,
                    ZFP_PHYSICAL_FORWARD_CALL,
                    "forwarding edge '" + e.from_symbol + "' -> '" + e.to_symbol
                    + "' still lowers to a physical call; required 0"))

    # Copy axis.
    if zfp_axis_unmeasured(entry, ZFP_AXIS_COPY_BYTES):
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            _zfp_unmeasured_detail(entry, ZFP_AXIS_COPY_BYTES)))
    else:
        for e in entry.edges:
            if e.copy_bytes > 0:
                violations.push(zfp_violation(entry.entrypoint,
                    ZFP_LAYER_VIEW_COPY,
                    "layer-view edge '" + e.from_symbol + "' -> '" + e.to_symbol
                    + "' copies " + e.copy_bytes.to_text()
                    + " bytes; required 0"))
            if e.copy_bytes < 0:
                violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
                    "edge '" + e.from_symbol + "' -> '" + e.to_symbol
                    + "' reports negative copy_bytes (" + e.copy_bytes.to_text()
                    + "), which is a sentinel for 'not measured', not a zero"))

    # Allocation axis.
    if zfp_axis_unmeasured(entry, ZFP_AXIS_ALLOCATIONS):
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            _zfp_unmeasured_detail(entry, ZFP_AXIS_ALLOCATIONS)))
    elif entry.temporary_allocations < 0:
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            "temporary_allocations is negative ("
            + entry.temporary_allocations.to_text()
            + "), which is a sentinel for 'not measured', not a zero"))
    elif entry.temporary_allocations > 0:
        violations.push(zfp_violation(entry.entrypoint, ZFP_TEMPORARY_ALLOCATION,
            entry.temporary_allocations.to_text()
            + " temporary allocation(s) on the warm path; required 0"))

    # Dispatch axis — the plan's bound is `dynamic_dispatches <= 1/batch`.
    if zfp_axis_unmeasured(entry, ZFP_AXIS_DISPATCH):
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            _zfp_unmeasured_detail(entry, ZFP_AXIS_DISPATCH)))
    elif entry.dynamic_dispatches < 0:
        violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
            "dynamic_dispatches is negative ("
            + entry.dynamic_dispatches.to_text()
            + "), which is a sentinel for 'not measured', not a zero"))
    elif entry.batches <= 0:
        if entry.dynamic_dispatches > 0:
            violations.push(zfp_violation(entry.entrypoint, ZFP_UNMEASURED,
                "dynamic_dispatches=" + entry.dynamic_dispatches.to_text()
                + " but batches=" + entry.batches.to_text()
                + "; the <=1/batch bound has no divisor, so it is unmeasurable"))
    elif entry.dynamic_dispatches > entry.batches:
        violations.push(zfp_violation(entry.entrypoint, ZFP_DYNAMIC_DISPATCH,
            entry.dynamic_dispatches.to_text() + " dynamic dispatch(es) over "
            + entry.batches.to_text() + " batch(es) exceeds the <=1/batch bound"))

    violations

fn _zfp_has_unmeasured(violations: [ZeroForwardViolation]) -> bool:
    for v in violations:
        if v.kind == ZFP_UNMEASURED:
            return true
    false

fn check_all_zero_forward_paths(entries: [ZeroForwardEntry]) -> ZeroForwardVerdict:
    """Whole-run gate. FAIL-CLOSED on an empty scan and on a scan that found no
    `@zero_forward_path` claim at all."""
    var violations: [ZeroForwardViolation] = []
    var gated = 0
    for entry in entries:
        if entry.annotated:
            gated = gated + 1
        for v in check_zero_forward_entry(entry):
            violations.push(v)

    val scanned = entries.len()
    if scanned == 0:
        return ZeroForwardVerdict(ok: false, blocked: true,
            reason: "error[zero_forward_path]: BLOCKED — scanned 0 entrypoints; "
                + "a gate that examined nothing cannot report a pass",
            scanned: 0, gated: 0, violations: violations)
    if gated == 0:
        return ZeroForwardVerdict(ok: false, blocked: true,
            reason: "error[zero_forward_path]: BLOCKED — scanned "
                + scanned.to_text()
                + " entrypoint(s) but 0 carry @zero_forward_path; "
                + "with no claim to check, '0 violations' proves nothing",
            scanned: scanned, gated: 0, violations: violations)

    val blocked = _zfp_has_unmeasured(violations)
    if blocked:
        return ZeroForwardVerdict(ok: false, blocked: true,
            reason: "error[zero_forward_path]: BLOCKED — one or more axes of "
                + gated.to_text() + " gated entrypoint(s) were not measurable",
            scanned: scanned, gated: gated, violations: violations)
    if violations.len() > 0:
        return ZeroForwardVerdict(ok: false, blocked: false,
            reason: "error[zero_forward_path]: FAIL — " + violations.len().to_text()
                + " violation(s) across " + gated.to_text()
                + " gated entrypoint(s)",
            scanned: scanned, gated: gated, violations: violations)
    ZeroForwardVerdict(ok: true, blocked: false,
        reason: "PASS — " + gated.to_text() + " gated entrypoint(s) of "
            + scanned.to_text() + " scanned; all axes measured and clean",
        scanned: scanned, gated: gated, violations: violations)

fn hop_axis_verdict(entries: [ZeroForwardEntry]) -> ZeroForwardVerdict:
    """The one axis that is measurable ahead of M4-M6: physical forward hops.

    Same fail-closed contract as the full gate (empty scan BLOCKED, no
    annotated entrypoint BLOCKED, `hops` declared unmeasured BLOCKED), but the
    copy/allocation/dispatch axes — which genuinely require post-collapse MIR
    that does not exist yet — are not consulted. This lets the plan's §0 line
    `physical forward hops = 0` be pinned today without fabricating the other
    three zeros."""
    var hop_entries: [ZeroForwardEntry] = []
    for entry in entries:
        var axes: [text] = []
        for a in entry.unmeasured_axes:
            if a == ZFP_AXIS_HOPS or not zfp_known_axis(a):
                axes.push(a)
        # Neutralize the per-edge copy_bytes sentinel as well: a producer that
        # declared the copy axis unmeasured legitimately writes -1 there, and
        # -1 is a BLOCKED sentinel on the copy axis. Since this verdict does
        # not consult the copy axis at all, carrying the sentinel through would
        # block the hop axis for a reason that has nothing to do with hops.
        var hop_edges: [ForwardEdge] = []
        for e in entry.edges:
            hop_edges.push(ForwardEdge(from_symbol: e.from_symbol,
                to_symbol: e.to_symbol, physical: e.physical, copy_bytes: 0))
        hop_entries.push(ZeroForwardEntry(
            entrypoint: entry.entrypoint,
            annotated: entry.annotated,
            edges: hop_edges,
            temporary_allocations: 0,
            dynamic_dispatches: 0,
            batches: 1,
            unmeasured_axes: axes,
            unmeasured_reason: entry.unmeasured_reason,
        ))
    check_all_zero_forward_paths(hop_entries)

export ForwardEdge, ZeroForwardEntry, ZeroForwardViolation
export ZeroForwardCounters, ZeroForwardVerdict
export ZFP_PHYSICAL_FORWARD_CALL, ZFP_LAYER_VIEW_COPY
export ZFP_TEMPORARY_ALLOCATION, ZFP_DYNAMIC_DISPATCH, ZFP_UNMEASURED
export ZFP_AXIS_HOPS, ZFP_AXIS_COPY_BYTES, ZFP_AXIS_ALLOCATIONS, ZFP_AXIS_DISPATCH
export zfp_known_axis, zfp_axis_unmeasured, zfp_kind_label
export format_zfp_violation, format_zfp_violations
export zfp_physical_calls, zfp_copy_bytes
export zero_forward_counters, format_zero_forward_counters
export check_zero_forward_entry, check_all_zero_forward_paths, hop_axis_verdict
