# Post-HIR coherence and witness publication for static facets.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.frontend.facet_static_registry.*

fn facet_static_module_identity(module_key: text, module: HirModule) -> text:
    if module.path != "":
        return facet_static_module_key(module.path)
    if module.name != "":
        return facet_static_module_key(module.name)
    facet_static_module_key(module_key)

fn facet_static_module_matches(module_key: text, module: HirModule, wanted: text) -> bool:
    facet_static_module_identity(module_key, module) == wanted or
        facet_static_module_key(module_key) == wanted

fn facet_static_hir_type_key(module: HirModule, type_: HirType) -> text:
    match type_.kind:
        case HirTypeKind.Named(symbol_id, _):
            if val symbol = module.symbols.get_symbol_raw(symbol_id.id):
                return facet_static_key(symbol.defining_module ?? module.path, symbol.name)
        case _: ()
    ""

fn facet_static_hir_has_trait(modules: Dict<text, HirModule>, facet_key: text) -> bool:
    val wanted_module = facet_static_path_of(facet_key)
    val wanted_name = facet_static_name_of(facet_key)
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if not facet_static_module_matches(module_key, module, wanted_module):
            continue
        for trait_id in module.traits.keys():
            val trait_: HirTrait = module.traits[trait_id]
            if trait_.name == wanted_name:
                if val symbol = module.symbols.get_symbol_raw(trait_.symbol.id):
                    match symbol.kind:
                        case SymbolKind.Trait: return true
                        case _: return false
    false

fn facet_static_hir_target_kind_valid(modules: Dict<text, HirModule>, target_key: text) -> bool:
    val wanted_module = facet_static_path_of(target_key)
    val wanted_name = facet_static_name_of(target_key)
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if not facet_static_module_matches(module_key, module, wanted_module):
            continue
        for symbol_id in module.symbols.symbols.keys():
            val symbol = module.symbols.symbols[symbol_id]
            if symbol.name == wanted_name:
                match symbol.kind:
                    case SymbolKind.Struct | SymbolKind.Class: return true
                    case _: return false
    false

fn facet_static_hir_impl_matches(modules: Dict<text, HirModule>, impl_key: text, target_key: text, facet_key: text) -> bool:
    val wanted_module = facet_static_path_of(impl_key)
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if not facet_static_module_matches(module_key, module, wanted_module):
            continue
        for impl_ in module.impls:
            if impl_.facet_impl_key == impl_key:
                return facet_static_hir_type_key(module, impl_.type_) == target_key and
                    impl_.has_trait_ and facet_static_hir_type_key(module, impl_.trait_) == facet_key
    false

fn facet_static_hir_missing_methods(modules: Dict<text, HirModule>, impl_key: text, facet_key: text) -> [text]:
    var required: [text] = []
    var provided: [text] = []
    val facet_module = facet_static_path_of(facet_key)
    val facet_name = facet_static_name_of(facet_key)
    val impl_module = facet_static_path_of(impl_key)
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if facet_static_module_matches(module_key, module, facet_module):
            for trait_id in module.traits.keys():
                val trait_: HirTrait = module.traits[trait_id]
                if trait_.name == facet_name:
                    for method in trait_.methods:
                        if not required.contains(method.name):
                            required.push(method.name)
                    for method in trait_.defaults:
                        if not required.contains(method.name):
                            required.push(method.name)
        if facet_static_module_matches(module_key, module, impl_module):
            for impl_ in module.impls:
                if impl_.facet_impl_key == impl_key:
                    for method_name in impl_.methods.keys():
                        if not provided.contains(method_name):
                            provided.push(method_name)
    var missing: [text] = []
    for required_name in required:
        if not provided.contains(required_name):
            missing.push(required_name)
    missing

fn facet_static_publish_hir_methods(modules: Dict<text, HirModule>, impl_key: text, route_id: i64):
    val wanted_module = facet_static_path_of(impl_key)
    for module_key in modules.keys():
        val module: HirModule = modules[module_key]
        if not facet_static_module_matches(module_key, module, wanted_module):
            continue
        for impl_ in module.impls:
            if impl_.facet_impl_key != impl_key:
                continue
            for method_name in impl_.methods.keys():
                val method_id = impl_.methods[method_name]
                if val method_symbol = module.symbols.get_symbol_raw(method_id.id):
                    facet_static_publish_method(
                        route_id, method_name, method_id.id,
                        method_symbol.name, wanted_module)

fn validate_static_facet_bindings(modules: Dict<text, HirModule>) -> [text]:
    var errors: [text] = []
    facet_static_clear_resolved()

    var i: i64 = 0
    while i < facet_static_bind_facets.len():
        val facet_key = facet_static_bind_facets[i]
        val target_key = facet_static_bind_targets[i]
        val impl_key = facet_static_bind_impls[i]
        val facet_name = facet_static_name_of(facet_key)
        val impl_name = facet_static_name_of(impl_key)

        if not facet_static_interface_declared_key(facet_key):
            errors.push("error[facet]: bind names undeclared facet interface '" + facet_key + "'")
        elif not facet_static_hir_has_trait(modules, facet_key):
            errors.push("error[facet]: '" + facet_key + "' is not a lowered facet interface")

        if not facet_static_hir_target_kind_valid(modules, target_key):
            errors.push("error[facet]: target '" + target_key + "' must be a concrete struct or class")

        val impl_index = facet_static_impl_index_key(impl_key)
        if impl_index < 0:
            errors.push("error[facet]: bind for '" + facet_name + "' names undeclared facet impl '" + impl_key + "'")
        else:
            val declared_target = facet_static_impl_targets[impl_index]
            val declared_facet = facet_static_impl_facets[impl_index]
            if declared_target != target_key:
                errors.push("error[facet]: impl '" + impl_name + "' targets '" + declared_target + "', not bound target '" + target_key + "'")
            if declared_facet != facet_key:
                errors.push("error[facet]: impl '" + impl_name + "' implements '" + declared_facet + "', not bound facet '" + facet_key + "'")
            if declared_target == target_key and declared_facet == facet_key:
                if not facet_static_hir_impl_matches(modules, impl_key, target_key, facet_key):
                    errors.push("error[facet]: impl '" + impl_key + "' did not survive HIR lowering with its exact identity")
                else:
                    val missing = facet_static_hir_missing_methods(modules, impl_key, facet_key)
                    if missing.len() > 0:
                        errors.push("error[facet]: impl '" + impl_name + "' is missing facet method(s): " + missing.join(", "))

        var duplicate_count: i64 = 0
        var j: i64 = 0
        while j < facet_static_bind_facets.len():
            if facet_static_bind_facets[j] == facet_key and facet_static_bind_targets[j] == target_key:
                duplicate_count = duplicate_count + 1
            j = j + 1
        if duplicate_count > 1:
            errors.push("error[facet]: incoherent overlapping bindings for ('" + target_key + "', '" + facet_key + "')")
        i = i + 1

    if errors.len() == 0:
        i = 0
        while i < facet_static_bind_facets.len():
            val facet_key = facet_static_bind_facets[i]
            val target_key = facet_static_bind_targets[i]
            val impl_key = facet_static_bind_impls[i]
            val route_id = facet_static_publish_resolved(
                facet_key, target_key, impl_key, facet_static_path_of(impl_key))
            facet_static_publish_hir_methods(modules, impl_key, route_id)
            i = i + 1
    errors

export validate_static_facet_bindings
export facet_static_hir_has_trait, facet_static_hir_impl_matches
export facet_static_hir_missing_methods
