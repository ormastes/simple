# Conservative builtin collection facts for parameter-effect analysis.
use compiler.hir.hir_definitions.{HirExpr}
use compiler.hir.hir_types.*
use compiler.semantics.param_effects.context.{PeCtx}

pub(package) fn builtin_collection_receiver(ctx: PeCtx, recv: HirExpr, res: MethodResolution) -> bool:
    match res:
        case BuiltinCollection(_): return true
        case Unresolved: pass
        case _: return false
    if recv.has_type_ and recv.type_ != nil:
        match recv.type_.kind:
            case Array(_, _) | Slice(_): return true
            case _: return false
    var sid = -1
    match recv.kind:
        case Var(sym) | NamedVar(sym, _): sid = sym.id
        case _: return false
    if not ctx.module.symbols.symbols.contains_key(sid): return false
    val symbol: HirSymbol = ctx.module.symbols.symbols[sid]
    match symbol.type_:
        case Some(t):
            match t.kind:
                case Array(_, _) | Slice(_): return true
                case _: return false
        case nil: return false
