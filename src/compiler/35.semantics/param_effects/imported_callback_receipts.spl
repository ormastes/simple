"""Live-owner callback receipts. Encoded bytes alone never authorize trust.

Import registration has already chased frozen export origins and records the
terminal defining_module and physical declaration name on each Function symbol.
Only that resolver identity can map a checked provider to a consumer symbol.
The complete generated function digest binds bodies, not declaration surfaces.
Unsupported signatures and absent live admitted providers fail closed.
"""
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.module_surface_types.{ModuleSurface}
use compiler.hir.hir_lowering.module_surface_source_identity.{module_surface_canonical_path}
use compiler.hir.hir_function_record_identity_v1.{mono_complete_function_digest_v1}
use compiler.common.cache.canonical_identity.{canon_str, canon_nat}
use compiler.semantics.param_effects.callback_contracts.{checked_sync_callback_slots}
use std.common.crypto.sha256.{sha256_text}

pub struct ImportedCallbackReceiptV1:
    provider_path: text
    provider_name: text
    provider_symbol: i64
    consumer_symbol: i64
    source_identity: text
    signature_digest: text
    body_digest: text
    callback_slots: [i64]

fn callback_type_identity(type_: HirType) -> text:
    if type_ == nil: return ""
    match type_.kind:
        case Int(bits, signed): return "int" + canon_nat(bits) + canon_str("{signed}")
        case Float(bits): return "float" + canon_nat(bits)
        case Bool: return "bool"
        case Char: return "char"
        case Unit: return "unit"
        case Never: return "never"
        case Function(parameters, result, effects):
            if effects.len() != 0: return ""
            var identity = "function" + canon_nat(parameters.len())
            for parameter in parameters:
                val part = callback_type_identity(parameter)
                if part == "": return ""
                identity = identity + canon_str(part)
            val returned = callback_type_identity(result)
            if returned == "": return ""
            return identity + canon_str(returned)
        # Nominal IDs are module-local: never compare equal raw IDs across
        # providers. Reference/nominal signatures need canonical type receipts.
        case _: return ""

fn callback_function_signature(function: HirFunction) -> text:
    if function.type_params.len() != 0 or function.effects.len() != 0: return ""
    var parameters: [HirType] = []
    for parameter in function.params: parameters.push(parameter.type_)
    val type_ = HirType(kind: HirTypeKind.Function(parameters, function.return_type, []), span: function.span)
    callback_type_identity(type_)

pub fn imported_callback_receipt_encode_v1(receipt: ImportedCallbackReceiptV1) -> text:
    var encoded = "simple/imported-callback-proof/v1\n"
    encoded = encoded + canon_str(receipt.provider_path) + canon_str(receipt.provider_name)
    encoded = encoded + canon_nat(receipt.provider_symbol) + canon_nat(receipt.consumer_symbol)
    encoded = encoded + canon_str(receipt.source_identity) + canon_str(receipt.signature_digest) + canon_str(receipt.body_digest)
    encoded = encoded + canon_nat(receipt.callback_slots.len())
    for slot in receipt.callback_slots: encoded = encoded + canon_nat(slot)
    encoded

pub fn imported_callback_receipt_matches_v1(encoded: text, live: ImportedCallbackReceiptV1) -> bool:
    # Exact canonical re-encoding rejects truncated/duplicate/unknown fields,
    # trailing data, stale versions and noncanonical numbers in one comparison.
    # `live` must be recomputed through the resolver-owned producer below.
    encoded == imported_callback_receipt_encode_v1(live)

fn callback_source_identity(surface: ModuleSurface) -> text:
    canon_nat(surface.content_length) + canon_str("{surface.content_hash}") +
        canon_str("{surface.semantic_hash0}") + canon_str("{surface.semantic_hash1}") +
        canon_str("{surface.semantic_hash2}") + canon_str("{surface.semantic_hash3}")

pub fn verified_imported_callback_receipts(consumer: HirModule, providers: [HirModule], surfaces: [ModuleSurface]) -> [ImportedCallbackReceiptV1]:
    var receipts: [ImportedCallbackReceiptV1] = []
    for symbol_key in consumer.symbols.symbols.keys():
        val symbol: HirSymbol = consumer.symbols.symbols[symbol_key]
        if symbol_key != symbol.id.id: continue
        if symbol.kind != SymbolKind.Function or consumer.functions.contains_key(symbol.id): continue
        val owner = symbol.defining_module ?? ""
        if owner == "": continue
        var matching_surfaces: [ModuleSurface] = []
        for candidate_surface in surfaces:
            val surface: ModuleSurface = candidate_surface
            if surface.module_name == owner and surface.frozen and surface.semantic_cacheable and surface.nogc_strict:
                if surface.canonical_path == "" or surface.content_length < 0: continue
                if module_surface_canonical_path(surface.canonical_path) != surface.canonical_path: continue
                matching_surfaces.push(surface)
        if matching_surfaces.len() != 1: continue
        val surface: ModuleSurface = matching_surfaces[0]
        var matching_providers: [HirModule] = []
        for candidate_provider in providers:
            val provider: HirModule = candidate_provider
            if provider.name != surface.module_name: continue
            if provider.nogc_strict and provider.nogc_param_effects_checked and module_surface_canonical_path(provider.path) == surface.canonical_path:
                matching_providers.push(provider)
        if matching_providers.len() != 1: continue
        val provider: HirModule = matching_providers[0]
        val proofs = checked_sync_callback_slots(provider)
        var matched: [ImportedCallbackReceiptV1] = []
        for function_key in provider.functions.keys():
            val function: HirFunction = provider.functions[function_key]
            if function_key.id != function.symbol.id: continue
            if not function.is_public or not proofs.contains_key(function.symbol.id): continue
            if symbol.name != function.name and symbol.name != owner + "." + function.name: continue
            val signature = callback_function_signature(function)
            if signature == "": continue
            var imported_signature = ""
            match symbol.type_:
                case Some(type_): imported_signature = callback_type_identity(type_)
                case nil: pass
            if imported_signature != signature: continue
            val body = mono_complete_function_digest_v1(function)
            if body == "": continue
            matched.push(ImportedCallbackReceiptV1(surface.canonical_path, owner,
                function.symbol.id, symbol.id.id, callback_source_identity(surface),
                sha256_text(signature), body, proofs[function.symbol.id]))
        if matched.len() == 1: receipts.push(matched[0])
    receipts

pub fn verified_imported_callback_slots(consumer: HirModule, providers: [HirModule], surfaces: [ModuleSurface]) -> {i64: [i64]}:
    var slots: {i64: [i64]} = {}
    for receipt in verified_imported_callback_receipts(consumer, providers, surfaces):
        slots[receipt.consumer_symbol] = receipt.callback_slots
    slots
