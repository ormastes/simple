# Production adapter: authoritative parameter symbols seed short-view provenance.
use compiler.hir.hir_definitions.{HirFunction, HirExpr, HirExprKind, HirCallArg}
use compiler.hir.hir_types.{HirModule, HirSymbol, HirTypeKind, SymbolKind, SymbolId}
use compiler.hir.ownership_types.{hir_type_is_short_candidate}
use compiler.semantics.param_effects.effects.{ParamEffectDiag}
use compiler.semantics.param_effects.short_escape.{short_escape_messages}

pub(package) fn exact_call_symbol(callee: HirExpr) -> i64:
    match callee.kind:
        case HirExprKind.Var(symbol) | HirExprKind.NamedVar(symbol, _): return symbol.id
        case _: return -1

pub(package) fn checked_callback_slot(checked: {i64: [i64]}, symbol: i64, args: [HirCallArg], index: i64, offset: i64) -> bool:
    if symbol < 0 or not checked.contains_key(symbol): return false
    # Any named argument invalidates positional matching for this entire call.
    for argument in args:
        if argument.has_name: return false
    return checked[symbol].contains(index + offset)

pub fn is_resolved_imported_callable(module: HirModule, id: i64) -> bool:
    if id < 0 or module.functions.contains_key(SymbolId(id)): return false
    if not module.symbols.symbols.contains_key(id): return false
    val symbol: HirSymbol = module.symbols.symbols[id]
    if symbol.id.id != id: return false
    if symbol.kind != SymbolKind.Function: return false
    val owner = symbol.defining_module ?? ""
    return owner != "" and owner != module.name and owner != module.path

pub(package) fn pending_import_callback_slots(module: HirModule, checked: {i64: [i64]}) -> {i64: [i64]}:
    var pending: {i64: [i64]} = {}
    for id in module.symbols.symbols.keys():
        if checked.contains_key(id) or not is_resolved_imported_callable(module, id): continue
        val symbol: HirSymbol = module.symbols.symbols[id]
        match symbol.type_:
            case Some(type_):
                match type_.kind:
                    case HirTypeKind.Function(parameters, _, _):
                        var slots: [i64] = []
                        var index = 0
                        for parameter in parameters:
                            match parameter.kind:
                                case HirTypeKind.Function(_, _, _): slots.push(index)
                                case _: pass
                            index = index + 1
                        if slots.len() > 0: pending[id] = slots
                    case _: pass
            case nil: pass
    pending

pub(package) fn short_parameter_capture_diags(function: HirFunction, checked_callbacks: {i64: [i64]}, checked_regions: {i64: {i64: [i64]}} = {}, pending_import_callbacks: {i64: [i64]} = {}) -> [ParamEffectDiag]:
    if function.is_extern: return []
    var short_params: {i64: bool} = {}
    for param in function.params:
        if hir_type_is_short_candidate(param.type_):
            short_params[param.symbol.id] = true
    var diagnostics: [ParamEffectDiag] = []
    for message in short_escape_messages(function, short_params, checked_callbacks, checked_regions):
        diagnostics.push(ParamEffectDiag(code: "NOGC-BOR-001", function: function.name,
            param: "", message: message, line: function.span.line))
    diagnostics
