# Declared parameter contracts and finite-lattice comparison helpers.
# Body inference remains in infer.spl; these helpers perform no body walks.

use compiler.hir.hir_definitions.{HirFunction, HirParam}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.ownership_types.{hir_type_is_short_candidate, hir_type_ownership_is_known}
use compiler.semantics.param_effects.context.{PeCtx}
use compiler.semantics.param_effects.effects.{ParamEffectEntry}

pub(package) fn declared_parameter_category(type_: HirType) -> text:
    # Parameter syntax, independent of the ownership of stored inner payloads.
    if type_ == nil: return ""
    match type_.kind:
        case HirTypeKind.Unique(_): return "unique"
        case HirTypeKind.Isolated(_): return "iso"
        case HirTypeKind.Shared(_): return "shared"
        case HirTypeKind.Weak(_): return "weak"
        case HirTypeKind.Ref(_, _): return "ref"
        case HirTypeKind.Ptr(_, _): return "ptr"
        case _: return ""

pub(package) fn declared_param_effect(ctx: PeCtx, function: HirFunction, param: HirParam) -> text:
    val category = declared_parameter_category(param.type_)
    if function.is_extern and (category != "" or hir_type_is_short_candidate(param.type_) or not hir_type_ownership_is_known(param.type_)): return "foreign-unknown"
    if category == "shared" or category == "weak": return "share-explicit"
    if category == "iso" or category == "unique": return "consume"
    if param.is_mutable: return "mutate-short"
    "read-short"

pub(package) fn param_effect_entry_values(entries: [ParamEffectEntry]) -> [text]:
    var values: [text] = []
    for entry in entries:
        values.push(entry.effect)
    values

pub(package) fn param_effect_lists_equal(left: [text], right: [text]) -> bool:
    if left.len() != right.len(): return false
    var index = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true
