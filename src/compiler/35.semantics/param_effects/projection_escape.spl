# Scalar projections copy values; all other projections retain source provenance.
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.semantics.param_effects.context.{PeCtx}

fn projection_scalar(type_: HirType) -> bool:
    if type_ == nil: return false
    match type_.kind:
        case Int(_, _) | Float(_) | Bool | Char | Unit | Never: return true
        case _: return false

fn projection_base_type(ctx: PeCtx, base: HirExpr) -> HirType?:
    if base.has_type_ and base.type_ != nil: return Some(base.type_)
    var id = -1
    match base.kind:
        case Var(symbol) | NamedVar(symbol, _): id = symbol.id
        case _: return nil
    if ctx.module.symbols.symbols.contains_key(id):
        val symbol: HirSymbol = ctx.module.symbols.symbols[id]
        return symbol.type_
    nil

fn projection_inner(type_: HirType) -> HirType:
    match type_.kind:
        case Unique(inner) | Shared(inner) | Weak(inner) | Ref(inner, _) | Isolated(inner):
            return projection_inner(inner)
        case _: return type_

pub(package) fn projection_copies_scalar(ctx: PeCtx, expr: HirExpr, base: HirExpr) -> bool:
    if expr.has_type_ and expr.type_ != nil: return projection_scalar(expr.type_)
    match projection_base_type(ctx, base):
        case Some(raw):
            val type_ = projection_inner(raw)
            match expr.kind:
                case Index(_, _):
                    match type_.kind:
                        case Array(inner, _) | Slice(inner): return projection_scalar(inner)
                        case Dict(_, value): return projection_scalar(value)
                        case _: return false
                case Field(_, name, _):
                    match type_.kind:
                        case Named(symbol, _):
                            for class_ in ctx.module.classes.values():
                                if class_.symbol.id == symbol.id:
                                    for field in class_.fields:
                                        if field.name == name: return projection_scalar(field.type_)
                            for struct_ in ctx.module.structs.values():
                                if struct_.symbol.id == symbol.id:
                                    for field in struct_.fields:
                                        if field.name == name: return projection_scalar(field.type_)
                        case _: pass
                case _: pass
        case nil: pass
    false
