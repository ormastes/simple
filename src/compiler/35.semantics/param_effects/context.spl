# Shared context, flow facts, type classification and the read-only "uses"
# walker for param-effect inference (split from infer.spl for the 800-line
# module limit; no behaviour of its own).

use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*

# ============================================================================
# Context and flow facts
# ============================================================================

pub struct PeFlow:
    cont: i64       # consume state of the paths that continue: 0 none, 1 some, 2 all
    any: bool       # consumed on at least one path (including terminating ones)
    term: bool      # every path terminates (return / throw / break / continue)

pub fn _flow0() -> PeFlow:
    PeFlow(cont: 0, any: false, term: false)

pub class PeCtx:
    module: HirModule
    class_ids: {i64: bool}
    struct_ids: {i64: bool}
    class_names: {text: bool}
    by_sym: {i64: [text]}
    by_name: {text: [text]}
    method_sym_by_name: {text: i64}
    method_ids: {i64: bool}
    class_field_types: {text: HirType}
    local_ids: {i64: bool}
    owner_class_id: i64
    owner_is_receiver: bool
    consume_events: i64
    ids: [i64]
    mutated: bool
    suspended: bool
    amb_code: text
    amb_reason: text
    consume_reason: text
    line: i64

    me reset(ids: [i64]):
        self.ids = ids
        self.consume_events = 0
        self.mutated = false
        self.suspended = false
        self.amb_code = ""
        self.amb_reason = ""
        self.consume_reason = ""
        self.line = 0

    me ambiguous(code: text, reason: text, line: i64):
        if self.amb_code == "":
            self.amb_code = code
            self.amb_reason = reason
            self.line = line

    me consumed(reason: text, line: i64):
        self.consume_events = self.consume_events + 1
        if self.consume_reason == "":
            self.consume_reason = reason
            if self.line == 0: self.line = line

pub fn _has_id(ids: [i64], id: i64) -> bool:
    for i in ids:
        if i == id: return true
    false

pub fn _is_owner(ctx: PeCtx, e: HirExpr) -> bool:
    match e.kind:
        case Var(sym): return _has_id(ctx.ids, sym.id)
        case NamedVar(sym, _): return _has_id(ctx.ids, sym.id)
        case _: return false

pub fn _root_is_owner(ctx: PeCtx, e: HirExpr) -> bool:
    """Is `e` a place rooted at the owner (`p`, `p.f`, `p.f[i]`, ...)?"""
    match e.kind:
        case Var(_): return _is_owner(ctx, e)
        case NamedVar(_, _): return _is_owner(ctx, e)
        case Field(base, _, _): return _root_is_owner(ctx, base)
        case Index(base, _): return _root_is_owner(ctx, base)
        case TupleIndex(base, _): return _root_is_owner(ctx, base)
        case _: return false

# ============================================================================
# Type classification
# ============================================================================

pub fn _shared_type_name(name: text) -> bool:
    name == "Arc" or name == "Rc" or name == "Shared" or name == "SharedRef" or name == "AtomicRc"

pub fn _named_symbol_name(module: HirModule, id: i64) -> text:
    if module.symbols.symbols.contains_key(id):
        val s: HirSymbol = module.symbols.symbols[id]
        return s.name
    ""

pub fn _type_class(ctx: PeCtx, t: HirType) -> text:
    """"class" / "shared" / "ref" / "iso" / "ptr" / "" (value or unknown)."""
    if t == nil: return ""
    match t.kind:
        case Named(sym, _):
            val nm = _named_symbol_name(ctx.module, sym.id)
            if _shared_type_name(nm): return "shared"
            if ctx.class_ids.contains_key(sym.id): return "class"
            if nm != "" and ctx.class_names.contains_key(nm): return "class"
            if ctx.module.symbols.symbols.contains_key(sym.id):
                val s: HirSymbol = ctx.module.symbols.symbols[sym.id]
                match s.kind:
                    case Class: return "class"
                    case _: pass
            return ""
        case Optional(inner): return _type_class(ctx, inner)
        case Ref(_, _): return "ref"
        case Ptr(_, _): return "ptr"
        case Isolated(_): return "iso"
        case _: return ""

# ============================================================================
# Uses
# ============================================================================

pub fn _uses_opt(ctx: PeCtx, e: HirExpr?) -> bool:
    match e:
        case Some(x): return _uses(ctx, x)
        case nil: return false

pub fn _uses_list(ctx: PeCtx, es: [HirExpr]) -> bool:
    for x in es:
        if _uses(ctx, x): return true
    false

pub fn _uses_args(ctx: PeCtx, args: [HirCallArg]) -> bool:
    for a in args:
        if _uses(ctx, a.value): return true
    false

pub fn _uses_block(ctx: PeCtx, b: HirBlock) -> bool:
    for s in b.stmts:
        if _uses_stmt(ctx, s): return true
    if b.has: return _uses(ctx, b.value)
    false

pub fn _uses_block_opt(ctx: PeCtx, b: HirBlock?) -> bool:
    match b:
        case Some(x): return _uses_block(ctx, x)
        case nil: return false

pub fn _uses_stmt(ctx: PeCtx, s: HirStmt) -> bool:
    match s.kind:
        case Expr(e): return _uses(ctx, e)
        case Let(_, _, init): return _uses(ctx, init)
        case Assign(target, _, value): return _uses(ctx, target) or _uses(ctx, value)
        case Block(b): return _uses_block(ctx, b)
        case _: return false

pub fn _uses(ctx: PeCtx, e: HirExpr) -> bool:
    match e.kind:
        case Var(sym): return _has_id(ctx.ids, sym.id)
        case NamedVar(sym, _): return _has_id(ctx.ids, sym.id)
        case Field(base, _, _): return _uses(ctx, base)
        case Index(base, idx): return _uses(ctx, base) or _uses(ctx, idx)
        case TupleIndex(base, _): return _uses(ctx, base)
        case OptionalChain(base, _): return _uses(ctx, base)
        case NullCoalesce(l, r): return _uses(ctx, l) or _uses(ctx, r)
        case ExistsCheck(base): return _uses(ctx, base)
        case Unwrap(base): return _uses(ctx, base)
        case Binary(_, l, r): return _uses(ctx, l) or _uses(ctx, r)
        case Unary(_, o): return _uses(ctx, o)
        case Call(callee, args, _): return _uses(ctx, callee) or _uses_args(ctx, args)
        case MethodCall(recv, _, args, _): return _uses(ctx, recv) or _uses_args(ctx, args)
        case StaticCall(_, _, args, _): return _uses_args(ctx, args)
        case If(c, t, el): return _uses(ctx, c) or _uses_block(ctx, t) or _uses_block_opt(ctx, el)
        case IfChain(arms, el):
            for a in arms:
                if _uses(ctx, a.cond) or _uses_block(ctx, a.then_): return true
            return _uses_block_opt(ctx, el)
        case MatchCase(scrut, arms):
            if _uses(ctx, scrut): return true
            for a in arms:
                if a.has_guard and _uses(ctx, a.guard): return true
                if _uses_block(ctx, a.body): return true
            return false
        case Loop(body, _): return _uses_block(ctx, body)
        case While(c, body, _): return _uses(ctx, c) or _uses_block(ctx, body)
        case For(_, it, body, _): return _uses(ctx, it) or _uses_block(ctx, body)
        case With(items, body):
            for it in items:
                if _uses(ctx, it.context_expr): return true
            return _uses_block(ctx, body)
        case Lambda(_, body, captures):
            if captures != nil:
                for c in captures:
                    if _has_id(ctx.ids, c.id): return true
            if body == nil: return false
            return _uses(ctx, body)
        case Block(b): return _uses_block(ctx, b)
        case UnsafeBlock(b): return _uses_block(ctx, b)
        case LossBlock(b): return _uses_block(ctx, b)
        case NogradBlock(b): return _uses_block(ctx, b)
        case Return(v): return _uses_opt(ctx, v)
        case Break(_, v): return _uses_opt(ctx, v)
        case Throw(v): return _uses(ctx, v)
        case Try(x): return _uses(ctx, x)
        case Await(x): return _uses(ctx, x)
        case Yield(v): return _uses_opt(ctx, v)
        case ArrayLit(els, _): return _uses_list(ctx, els)
        case TupleLit(els): return _uses_list(ctx, els)
        case SetLit(els, _): return _uses_list(ctx, els)
        case ArrayRepeat(v, c, _): return _uses(ctx, v) or _uses(ctx, c)
        case DictLit(entries, _, _):
            for (k, v) in entries:
                if _uses(ctx, k) or _uses(ctx, v): return true
            return false
        case StructLit(_, fields):
            for (_, v) in fields:
                if _uses(ctx, v): return true
            return false
        case EnumLit(_, _, payload):
            match payload:
                case Some(pl):
                    match pl:
                        case Tuple(values): return _uses_list(ctx, values)
                        case Struct(fields):
                            for (_, v) in fields:
                                if _uses(ctx, v): return true
                            return false
                case nil: return false
        case StringLit(_, interps):
            match interps:
                case Some(xs):
                    for it in xs:
                        if _uses(ctx, it.expr): return true
                    return false
                case nil: return false
        case Cast(x, _): return _uses(ctx, x)
        case As(x, _): return _uses(ctx, x)
        case ConvertCall(x, _): return _uses(ctx, x)
        case TypeTest(v, _): return _uses(ctx, v)
        case Range(s, en, _, st): return _uses_opt(ctx, s) or _uses_opt(ctx, en) or _uses_opt(ctx, st)
        case Comprehension(_, x, clauses):
            if _uses(ctx, x): return true
            for c in clauses:
                match c.kind:
                    case For(_, it):
                        if _uses(ctx, it): return true
                    case If(cond):
                        if _uses(ctx, cond): return true
            return false
        case TryCatch(body, clauses, fin):
            if _uses_block(ctx, body): return true
            for c in clauses:
                if _uses_block(ctx, c.body): return true
            return _uses_block_opt(ctx, fin)
        case _: return false

pub fn _effects_by_sym(d: {i64: [text]}, id: i64) -> [text]:
    """Dict-of-array read through a LOCAL dict (not `ctx.field[k]`), which
    avoids the native class-field `d[k]` array-value gap."""
    if d.contains_key(id): return d[id]
    []

pub fn _effects_by_name(d: {text: [text]}, name: text) -> [text]:
    if d.contains_key(name): return d[name]
    []

pub fn _sym_by_name(d: {text: i64}, name: text) -> i64:
    if d.contains_key(name): return d[name]
    -1

pub fn _field_is(d: {text: HirType}, key: text) -> bool:
    d.contains_key(key)

pub fn _type_class_id(t: HirType) -> i64:
    if t == nil: return -1
    match t.kind:
        case Named(sym, _): return sym.id
        case Optional(inner): return _type_class_id(inner)
        case _: return -1

pub class PeIdSink:
    ids: {i64: bool}

    me add(id: i64):
        self.ids[id] = true

pub fn _collect_block_lets(b: HirBlock, out: PeIdSink):
    for st in b.stmts:
        match st.kind:
            case Let(sym, _, init):
                out.add(sym.id)
                _collect_expr_lets(init, out)
            case Expr(e): _collect_expr_lets(e, out)
            case Assign(_, _, v): _collect_expr_lets(v, out)
            case Block(inner): _collect_block_lets(inner, out)
            case _: pass
    if b.has: _collect_expr_lets(b.value, out)

pub fn _collect_block_opt_lets(b: HirBlock?, out: PeIdSink):
    match b:
        case Some(x): _collect_block_lets(x, out)
        case nil: pass

pub fn _collect_expr_lets(e: HirExpr, out: PeIdSink):
    """Symbols of locals bound anywhere in the body (let, for-variable)."""
    match e.kind:
        case If(_, t, el):
            _collect_block_lets(t, out)
            _collect_block_opt_lets(el, out)
        case IfChain(arms, el):
            for a in arms:
                _collect_block_lets(a.then_, out)
            _collect_block_opt_lets(el, out)
        case MatchCase(_, arms):
            for a in arms:
                _collect_block_lets(a.body, out)
        case Loop(body, _): _collect_block_lets(body, out)
        case While(_, body, _): _collect_block_lets(body, out)
        case For(v, _, body, _):
            out.add(v.id)
            _collect_block_lets(body, out)
        case Block(b): _collect_block_lets(b, out)
        case UnsafeBlock(b): _collect_block_lets(b, out)
        case _: pass

pub fn _function_locals(f: HirFunction) -> {i64: bool}:
    val sink = PeIdSink(ids: {})
    for p in f.params:
        sink.add(p.symbol.id)
    _collect_block_lets(f.body, sink)
    sink.ids
