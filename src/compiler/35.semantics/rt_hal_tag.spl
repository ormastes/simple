# codex-impl
# Semantic interpretation of the typed @rt(hal[, c][, rust]) metadata.

use compiler.common.attributes.{FunctionAttr}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.semantics.rt_criticality.{rt_profile_assurance_rank}
use compiler.frontend.rt_criticality_registry.{rt_criticality_claim_keys, rt_criticality_claim_fn, rt_criticality_profile}
use std.common.env_access.plan_sdn.{env_access_plan_parse_sdn_v1, env_access_plan_canonical_identity_v1}

pub struct RtHalTagMetadata:
    enabled: bool
    compare_c: bool
    compare_rust: bool
    error: text

var rt_hal_compilation_finalize_required = false
var rt_hal_compilation_plan_path = ""
var rt_hal_compilation_required_assurance_rank: i64 = 0
# Computed once during semantic admission from the complete canonical plan.
# MIR embeds this compiler-owned value; the runtime never treats an SDN rank
# or a public port field as sufficient authority for a replacement plan.
var rt_hal_compilation_plan_identity = ""

pub fn rt_hal_compilation_requires_finalize() -> bool:
    rt_hal_compilation_finalize_required

pub fn rt_hal_compilation_configured_plan_path() -> text:
    rt_hal_compilation_plan_path

pub fn rt_hal_compilation_required_assurance_rank() -> i64:
    rt_hal_compilation_required_assurance_rank

pub fn rt_hal_compilation_plan_identity() -> text:
    rt_hal_compilation_plan_identity

fn rt_hal_declared_assurance_rank(function_name: text) -> i64:
    # Missing provenance defaults to Critical, never to a weaker host tier.
    var rank = 0
    var found = false
    for key in rt_criticality_claim_keys():
        if rt_criticality_claim_fn(key) == function_name:
            found = true
            val candidate = rt_profile_assurance_rank(rt_criticality_profile(key))
            if candidate > rank:
                rank = candidate
    if found:
        rank
    else:
        3

pub fn rt_hal_tag_metadata(attr: FunctionAttr) -> RtHalTagMetadata:
    RtHalTagMetadata(
        enabled: attr.is_rt_hal and attr.rt_hal_error == "",
        compare_c: attr.is_rt_hal and attr.rt_hal_compare_c,
        compare_rust: attr.is_rt_hal and attr.rt_hal_compare_rust,
        error: attr.rt_hal_error
    )

pub fn rt_hal_function_metadata(function: HirFunction) -> RtHalTagMetadata:
    rt_hal_tag_metadata(function.func_attr)

pub fn rt_hal_tag_error(attr: FunctionAttr) -> text:
    val metadata = rt_hal_tag_metadata(attr)
    if metadata.error != "":
        return metadata.error
    if (metadata.compare_c or metadata.compare_rust) and not metadata.enabled:
        return "E-RT-HAL-TAG: comparator requires @rt(hal)"
    ""

# Environment effects at a foreign-comparison boundary have one representable
# authority: a *direct* call to a canonical EnvAccessPlan executor.  Do not
# infer authority from a spelling such as `*_env_access_*`: aliases, closures,
# wrappers and unresolved imports are precisely the shapes that can bypass the
# MIR-side capture inserted for a direct executor call.  This pass runs after
# resolution and before MIR, where it can still reject such a body rather than
# emitting an unobserved host effect.

val RT_HAL_ENV_CAPABILITY_NODE_CAP: i64 = 4096
val RT_HAL_ENV_CAPABILITY_EDGE_CAP: i64 = 16
# Each node can gain each of the four monotone risk bits once.  The scheduled
# worklist deduplicates queued nodes, so 5*N is a strict bounded lifetime cap
# (initial visit plus four updates), rather than an E-by-round allocation.
val RT_HAL_ENV_CAPABILITY_WORK_CAP: i64 = 20480

# A semantic fact must not allocate one variable-length edge list per AST
# fragment.  The graph has a deliberately small, explicit out-degree: unusual
# generated mega-wrappers fail with a diagnostic rather than making admission
# cost proportional to unbounded source fan-out.  These slots are also used
# for the reverse worklist graph below.
struct RtHalEnvCapabilityFact:
    direct_canonical: bool
    unresolved: bool
    indirect: bool
    overflow: bool
    callee_count: i64
    callee0: i64
    callee1: i64
    callee2: i64
    callee3: i64
    callee4: i64
    callee5: i64
    callee6: i64
    callee7: i64
    callee8: i64
    callee9: i64
    callee10: i64
    callee11: i64
    callee12: i64
    callee13: i64
    callee14: i64
    callee15: i64

fn rt_hal_env_fact_empty() -> RtHalEnvCapabilityFact:
    RtHalEnvCapabilityFact(direct_canonical: false, unresolved: false,
        indirect: false, overflow: false, callee_count: 0,
        callee0: -1, callee1: -1, callee2: -1, callee3: -1,
        callee4: -1, callee5: -1, callee6: -1, callee7: -1,
        callee8: -1, callee9: -1, callee10: -1, callee11: -1,
        callee12: -1, callee13: -1, callee14: -1, callee15: -1)

fn rt_hal_env_fact_callee_at(fact: RtHalEnvCapabilityFact, index: i64) -> i64:
    if index == 0:
        fact.callee0
    elif index == 1:
        fact.callee1
    elif index == 2:
        fact.callee2
    elif index == 3:
        fact.callee3
    elif index == 4:
        fact.callee4
    elif index == 5:
        fact.callee5
    elif index == 6:
        fact.callee6
    elif index == 7:
        fact.callee7
    elif index == 8:
        fact.callee8
    elif index == 9:
        fact.callee9
    elif index == 10:
        fact.callee10
    elif index == 11:
        fact.callee11
    elif index == 12:
        fact.callee12
    elif index == 13:
        fact.callee13
    elif index == 14:
        fact.callee14
    elif index == 15:
        fact.callee15
    else:
        -1

fn rt_hal_env_fact_add_callee(source: RtHalEnvCapabilityFact,
        callee: i64) -> RtHalEnvCapabilityFact:
    var fact = source
    var index = 0
    while index < fact.callee_count:
        if rt_hal_env_fact_callee_at(fact, index) == callee:
            return fact
        index = index + 1
    if fact.callee_count >= RT_HAL_ENV_CAPABILITY_EDGE_CAP:
        fact.overflow = true
        return fact
    if fact.callee_count == 0:
        fact.callee0 = callee
    elif fact.callee_count == 1:
        fact.callee1 = callee
    elif fact.callee_count == 2:
        fact.callee2 = callee
    elif fact.callee_count == 3:
        fact.callee3 = callee
    elif fact.callee_count == 4:
        fact.callee4 = callee
    elif fact.callee_count == 5:
        fact.callee5 = callee
    elif fact.callee_count == 6:
        fact.callee6 = callee
    elif fact.callee_count == 7:
        fact.callee7 = callee
    elif fact.callee_count == 8:
        fact.callee8 = callee
    elif fact.callee_count == 9:
        fact.callee9 = callee
    elif fact.callee_count == 10:
        fact.callee10 = callee
    elif fact.callee_count == 11:
        fact.callee11 = callee
    elif fact.callee_count == 12:
        fact.callee12 = callee
    elif fact.callee_count == 13:
        fact.callee13 = callee
    elif fact.callee_count == 14:
        fact.callee14 = callee
    elif fact.callee_count == 15:
        fact.callee15 = callee
    fact.callee_count = fact.callee_count + 1
    fact

fn rt_hal_env_fact_merge(left: RtHalEnvCapabilityFact,
        right: RtHalEnvCapabilityFact) -> RtHalEnvCapabilityFact:
    var result = left
    result.direct_canonical = left.direct_canonical or right.direct_canonical
    result.unresolved = left.unresolved or right.unresolved
    result.indirect = left.indirect or right.indirect
    result.overflow = left.overflow or right.overflow
    var index = 0
    while index < right.callee_count:
        result = rt_hal_env_fact_add_callee(result,
            rt_hal_env_fact_callee_at(right, index))
        index = index + 1
    result

fn rt_hal_env_fact_with_callee(id: i64) -> RtHalEnvCapabilityFact:
    rt_hal_env_fact_add_callee(rt_hal_env_fact_empty(), id)

fn rt_hal_env_canonical_owner(path: text, name: text) -> bool:
    # This is an identity allow-list, not a user-name heuristic.  The same
    # precise owners are recognized by MIR capture lowering; a user function
    # named `env_access_execute` in any other module is never admitted.
    (path == "app.io.env_access_host" and
        (name == "execute_host_env_access_plan" or
         name == "execute_host_env_access_plan_with_physical")) or
    (path == "std.common.env_access.executor" and name == "env_access_execute")

fn rt_hal_env_method_symbol(resolution: MethodResolution) -> i64?:
    # A qualified method has a module-local symbol ID.  Keep it unresolved
    # here rather than erasing the module component and accidentally granting
    # the capability to an identically numbered function in another module.
    match resolution:
        case InstanceMethod(_, method) | TraitMethod(_, method) |
             FreeFunction(method) | StaticMethod(_, method): Some(method.id)
        case _: nil

fn rt_hal_env_direct_call_fact(callee: HirExpr, function_names: Dict<i64, text>,
        canonical_ids: Dict<i64, bool>, extern_ids: Dict<i64, bool>) -> RtHalEnvCapabilityFact:
    match callee.kind:
        case NamedVar(symbol, _):
            if canonical_ids.contains_key(symbol.id):
                var fact = rt_hal_env_fact_empty()
                fact.direct_canonical = true
                fact
            elif function_names.contains_key(symbol.id) and not extern_ids.contains_key(symbol.id):
                rt_hal_env_fact_with_callee(symbol.id)
            else:
                var fact = rt_hal_env_fact_empty()
                fact.unresolved = true
                fact
        case Var(symbol):
            # `Var` is also how a function value copied into a local reaches
            # HIR.  It has no direct-export proof for MIR, even when its
            # numeric symbol happens to match a canonical declaration.  Make
            # the alias explicit at source instead of guessing it is callable.
            if function_names.contains_key(symbol.id) and not canonical_ids.contains_key(symbol.id) and
               not extern_ids.contains_key(symbol.id):
                rt_hal_env_fact_with_callee(symbol.id)
            else:
                var fact = rt_hal_env_fact_empty()
                fact.indirect = true
                fact
        case _:
            var fact = rt_hal_env_fact_empty()
            fact.indirect = true
            fact

fn rt_hal_env_args_fact(args: [HirCallArg], function_names: Dict<i64, text>,
        canonical_ids: Dict<i64, bool>, extern_ids: Dict<i64, bool>) -> RtHalEnvCapabilityFact:
    var result = rt_hal_env_fact_empty()
    for argument in args:
        result = rt_hal_env_fact_merge(result,
            rt_hal_env_expr_fact(argument.value, function_names, canonical_ids, extern_ids))
    result

fn rt_hal_env_block_fact(block: HirBlock, function_names: Dict<i64, text>,
        canonical_ids: Dict<i64, bool>, extern_ids: Dict<i64, bool>) -> RtHalEnvCapabilityFact:
    var result = rt_hal_env_fact_empty()
    for statement in block.stmts:
        match statement.kind:
            case Expr(expr) | Let(_, _, expr):
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_expr_fact(expr, function_names, canonical_ids, extern_ids))
            case Assign(target, _, value):
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_expr_fact(target, function_names, canonical_ids, extern_ids))
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
            case Block(inner):
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_block_fact(inner, function_names, canonical_ids, extern_ids))
            case SharedVal(_, _, has_init, init) | SharedVar(_, _, has_init, init):
                if has_init:
                    result = rt_hal_env_fact_merge(result,
                        rt_hal_env_expr_fact(init, function_names, canonical_ids, extern_ids))
            case GpuLaunch(config, body):
                for dimension in config.grid:
                    result = rt_hal_env_fact_merge(result,
                        rt_hal_env_expr_fact(dimension, function_names, canonical_ids, extern_ids))
                for dimension in config.block:
                    result = rt_hal_env_fact_merge(result,
                        rt_hal_env_expr_fact(dimension, function_names, canonical_ids, extern_ids))
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
            case AsmAssert(_): ()
    if block.has:
        result = rt_hal_env_fact_merge(result,
            rt_hal_env_expr_fact(block.value, function_names, canonical_ids, extern_ids))
    result

fn rt_hal_env_expr_fact(expr: HirExpr, function_names: Dict<i64, text>,
        canonical_ids: Dict<i64, bool>, extern_ids: Dict<i64, bool>) -> RtHalEnvCapabilityFact:
    var result = rt_hal_env_fact_empty()
    match expr.kind:
        case StringLit(_, Some(parts)):
            for part in parts:
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_expr_fact(part.expr, function_names, canonical_ids, extern_ids))
        case ArrayLit(items, _) | TupleLit(items) | SetLit(items, _):
            for item in items:
                result = rt_hal_env_fact_merge(result,
                    rt_hal_env_expr_fact(item, function_names, canonical_ids, extern_ids))
        case ArrayRepeat(value, count, _):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(count, function_names, canonical_ids, extern_ids))
        case DictLit(entries, _, _):
            for entry in entries:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(entry[0], function_names, canonical_ids, extern_ids))
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(entry[1], function_names, canonical_ids, extern_ids))
        case StructLit(_, fields):
            for field in fields:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(field[1], function_names, canonical_ids, extern_ids))
        case EnumLit(_, _, Some(HirEnumPayload.Tuple(values))):
            for value in values:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
        case EnumLit(_, _, Some(HirEnumPayload.Struct(fields))):
            for field in fields:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(field[1], function_names, canonical_ids, extern_ids))
        case Field(base, _, _) | TupleIndex(base, _) | OptionalChain(base, _) |
             ExistsCheck(base) | Unwrap(base) | Unary(_, base) | Cast(base, _) |
             As(base, _) | Await(base) | Try(base) | Spawn(base):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(base, function_names, canonical_ids, extern_ids))
        case Index(base, index) | Binary(_, base, index) | NullCoalesce(base, index):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(base, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(index, function_names, canonical_ids, extern_ids))
        case Call(callee, args, _):
            result = rt_hal_env_fact_merge(result,
                rt_hal_env_direct_call_fact(callee, function_names, canonical_ids, extern_ids))
            # A computed callee can itself execute while producing the function
            # value, so walk it as well; the outer call remains indirect.
            result = rt_hal_env_fact_merge(result,
                rt_hal_env_expr_fact(callee, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result,
                rt_hal_env_args_fact(args, function_names, canonical_ids, extern_ids))
        case MethodCall(receiver, _, args, resolution) | StaticCall(_, _, args, resolution):
            match rt_hal_env_method_symbol(resolution):
                Some(symbol):
                    if function_names.contains_key(symbol):
                        result = rt_hal_env_fact_merge(result, rt_hal_env_fact_with_callee(symbol))
                    else:
                        result.unresolved = true
                nil:
                    result.unresolved = true
            match expr.kind:
                case MethodCall(actual_receiver, _, _, _):
                    result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(actual_receiver, function_names, canonical_ids, extern_ids))
                case _: ()
            result = rt_hal_env_fact_merge(result, rt_hal_env_args_fact(args, function_names, canonical_ids, extern_ids))
        case If(cond, then_, else_):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(cond, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(then_, function_names, canonical_ids, extern_ids))
            match else_:
                case Some(block):
                    result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(block, function_names, canonical_ids, extern_ids))
                case nil: ()
        case IfChain(arms, else_):
            for arm in arms:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(arm.cond, function_names, canonical_ids, extern_ids))
                result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(arm.then_, function_names, canonical_ids, extern_ids))
            match else_:
                case Some(block):
                    result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(block, function_names, canonical_ids, extern_ids))
                case nil: ()
        case MatchCase(scrutinee, arms):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(scrutinee, function_names, canonical_ids, extern_ids))
            for arm in arms:
                if arm.has_guard:
                    result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(arm.guard, function_names, canonical_ids, extern_ids))
                result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(arm.body, function_names, canonical_ids, extern_ids))
        case Loop(body, _) | Block(body) | UnsafeBlock(body) | LossBlock(body) | NogradBlock(body):
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
        case While(cond, body, _):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(cond, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
        case For(_, iter, body, _):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(iter, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
        case With(items, body):
            for item in items:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(item.context_expr, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
        case Lambda(_, body, _):
            # A closure body is an indirect future call surface.  Traverse it
            # so a capability cannot be smuggled through a captured callable.
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(body, function_names, canonical_ids, extern_ids))
        case Return(Some(value)) | Break(_, Some(value)) | Throw(value) | Yield(Some(value)):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
        case Range(start, end, _, Some(step)):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(start, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(end, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(step, function_names, canonical_ids, extern_ids))
        case Range(start, end, _, nil):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(start, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(end, function_names, canonical_ids, extern_ids))
        case Comprehension(_, value, clauses):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
            for clause in clauses:
                match clause.kind:
                    case HirCompClauseKind.For(_, iter) | HirCompClauseKind.If(iter):
                        result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(iter, function_names, canonical_ids, extern_ids))
        case DictComprehension(key, value, clauses):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(key, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
            for clause in clauses:
                match clause.kind:
                    case HirCompClauseKind.For(_, iter) | HirCompClauseKind.If(iter):
                        result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(iter, function_names, canonical_ids, extern_ids))
        case ArrayLitSuffix(items, _):
            for item in items:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(item, function_names, canonical_ids, extern_ids))
        case KernelLaunch(kernel, grid, block, args):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(kernel, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(grid, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(block, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_args_fact(args, function_names, canonical_ids, extern_ids))
        case GpuIntrinsic(_, _, args):
            for item in args:
                result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(item, function_names, canonical_ids, extern_ids))
        case TypeTest(value, _):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(value, function_names, canonical_ids, extern_ids))
        case TryCatch(body, clauses, finally_):
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
            for clause in clauses:
                result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(clause.body, function_names, canonical_ids, extern_ids))
            match finally_:
                case Some(block):
                    result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(block, function_names, canonical_ids, extern_ids))
                case nil: ()
        # Custom/inline-assembly payloads are opaque to HIR.  Treating either
        # as Pure would be an allow-bypass, so make the capability admission
        # reject it before MIR rather than losing a physical effect transcript.
        case CustomBlock(_, _) | InlineAsm(_) | InlineAsmMatch(_):
            result.indirect = true
        case HostGpuLane(_, _, marker, body):
            result = rt_hal_env_fact_merge(result, rt_hal_env_expr_fact(marker, function_names, canonical_ids, extern_ids))
            result = rt_hal_env_fact_merge(result, rt_hal_env_block_fact(body, function_names, canonical_ids, extern_ids))
        # Explicit non-executing leaves.  Keeping this list here makes the
        # final wildcard an intentional fail-closed guard for future HIR
        # variants that add a child-bearing execution surface.
        case IntLit(_, _) | FloatLit(_, _) | StringLit(_, nil) | BoolLit(_) |
             CharLit(_) | UnitLit | NilLit | Var(_) | NamedVar(_, _) |
             EnumLit(_, _, nil) | Return(nil) | Break(_, nil) | Continue(_) |
             Yield(nil) | Error: ()
        case _:
            result.indirect = true
    result

fn rt_hal_env_fact_risky(fact: RtHalEnvCapabilityFact) -> bool:
    fact.direct_canonical or fact.unresolved or fact.indirect or fact.overflow

fn rt_hal_env_fact_summary_changed(left: RtHalEnvCapabilityFact,
        right: RtHalEnvCapabilityFact) -> bool:
    left.direct_canonical != right.direct_canonical or
    left.unresolved != right.unresolved or
    left.indirect != right.indirect or
    left.overflow != right.overflow

fn validate_rt_hal_env_capabilities(modules: Dict<text, HirModule>) -> [text]:
    var function_names: Dict<i64, text> = {}
    var canonical_ids: Dict<i64, bool> = {}
    var extern_ids: Dict<i64, bool> = {}
    var ambiguous_ids: Dict<i64, bool> = {}
    var facts: Dict<i64, RtHalEnvCapabilityFact> = {}
    var tagged: [HirFunction] = []
    for module_key in modules.keys():
        val module = modules[module_key]
        for function in module.functions.values():
            # Ambiguous numeric SymbolId values are never admitted as a direct
            # call identity; removing an entry makes their use unresolved.
            if function_names.contains_key(function.symbol.id):
                function_names.remove(function.symbol.id)
                ambiguous_ids[function.symbol.id] = true
                if canonical_ids.contains_key(function.symbol.id):
                    canonical_ids.remove(function.symbol.id)
            elif not ambiguous_ids.contains_key(function.symbol.id):
                function_names[function.symbol.id] = function.name
            if rt_hal_env_canonical_owner(module.path, function.name) and
               not ambiguous_ids.contains_key(function.symbol.id):
                canonical_ids[function.symbol.id] = true
            if function.is_extern and not canonical_ids.contains_key(function.symbol.id):
                extern_ids[function.symbol.id] = true
            if function.func_attr.is_rt_hal and
               (function.func_attr.rt_hal_compare_c or function.func_attr.rt_hal_compare_rust):
                tagged.push(function)
    for module in modules.values():
        for function in module.functions.values():
            # `facts` is keyed by the compiler's scalar SymbolId transport,
            # so an id known ambiguous above must never be last-write-wins
            # here. Collapse every duplicate-id row to an explicit unresolved
            # fact; tagged roots and wrappers then fail admission instead of
            # inheriting another module's summary.
            if ambiguous_ids.contains_key(function.symbol.id):
                var ambiguous = rt_hal_env_fact_empty()
                ambiguous.unresolved = true
                facts[function.symbol.id] = ambiguous
            else:
                facts[function.symbol.id] = rt_hal_env_block_fact(function.body,
                    function_names, canonical_ids, extern_ids)
    # Build a fixed-degree reverse graph and propagate only to affected
    # callers.  The old all-facts-per-round loop was O(rounds * E) and used a
    # dynamically growing callee array in every partial AST fact.  This cold
    # pass now retains only sixteen outgoing/incoming slots per function and
    # a deduplicated bounded worklist; oversize/fanout is a hard diagnostic.
    if facts.len() > RT_HAL_ENV_CAPABILITY_NODE_CAP:
        return ["E-RT-HAL-ENV-CAPABILITY-CAPACITY: function graph exceeds the 4096-node capability-admission bound"]
    var ids: [i64] = []
    for id in facts.keys():
        ids.push(id)
    var reverse: Dict<i64, RtHalEnvCapabilityFact> = {}
    var reverse_overflow = false
    for id in ids:
        val current = facts[id]
        if current.overflow:
            reverse_overflow = true
        var edge = 0
        while edge < current.callee_count:
            val callee = rt_hal_env_fact_callee_at(current, edge)
            if facts.contains_key(callee):
                val callers = reverse[callee] ?? rt_hal_env_fact_empty()
                val expanded_callers = rt_hal_env_fact_add_callee(callers, id)
                if expanded_callers.overflow:
                    reverse_overflow = true
                reverse[callee] = expanded_callers
            edge = edge + 1
    var queue = ids
    var scheduled: Dict<i64, bool> = {}
    for id in ids:
        scheduled[id] = true
    var queue_head = 0
    var work_overflow = false
    while queue_head < queue.len():
        val id = queue[queue_head]
        queue_head = queue_head + 1
        scheduled[id] = false
        val current = facts[id]
        var expanded = current
        var edge = 0
        while edge < current.callee_count:
            val callee = rt_hal_env_fact_callee_at(current, edge)
            if facts.contains_key(callee):
                val callee_fact = facts[callee]
                expanded.direct_canonical = expanded.direct_canonical or callee_fact.direct_canonical
                expanded.unresolved = expanded.unresolved or callee_fact.unresolved
                expanded.indirect = expanded.indirect or callee_fact.indirect
                expanded.overflow = expanded.overflow or callee_fact.overflow
            else:
                expanded.unresolved = true
            edge = edge + 1
        if rt_hal_env_fact_summary_changed(current, expanded):
            facts[id] = expanded
            if reverse.contains_key(id):
                val callers = reverse[id]
                var caller_index = 0
                while caller_index < callers.callee_count:
                    val caller = rt_hal_env_fact_callee_at(callers, caller_index)
                    if not (scheduled[caller] ?? false):
                        if queue.len() >= RT_HAL_ENV_CAPABILITY_WORK_CAP:
                            work_overflow = true
                        else:
                            queue.push(caller)
                            scheduled[caller] = true
                    caller_index = caller_index + 1
    if reverse_overflow or work_overflow:
        return ["E-RT-HAL-ENV-CAPABILITY-CAPACITY: capability graph exceeds the fixed 16-edge-per-node / 20480-work-item admission bound"]
    var errors: [text] = []
    for function in tagged:
        val own = facts[function.symbol.id]
        if own.overflow:
            errors.push("{function.name}: E-RT-HAL-ENV-CAPABILITY-CAPACITY: transitive environment-capability graph exceeds the fixed admission bound")
        elif own.indirect:
            errors.push("{function.name}: E-RT-HAL-ENV-CAPABILITY-INDIRECT: @rt(hal,c/rust) may invoke an indirect or opaque callable; only a resolved direct canonical EnvAccessPlan executor can be captured")
        elif own.unresolved:
            errors.push("{function.name}: E-RT-HAL-ENV-CAPABILITY-UNRESOLVED: @rt(hal,c/rust) has a callable whose environment capability cannot be proven; resolve it to a known Pure function or the canonical EnvAccessPlan executor")
        else:
            # A direct user function with an effect-capable transitive body is
            # a wrapper, even after summary propagation.  MIR captures the
            # canonical call in the tagged body only, so accepting this edge
            # would omit its effect transcript.
            var wrapper = false
            var callee_index = 0
            while callee_index < own.callee_count:
                val callee = rt_hal_env_fact_callee_at(own, callee_index)
                if facts.contains_key(callee) and rt_hal_env_fact_risky(facts[callee]):
                    wrapper = true
                callee_index = callee_index + 1
            if wrapper:
                errors.push("{function.name}: E-RT-HAL-ENV-CAPABILITY-WRAPPER: @rt(hal,c/rust) reaches an environment-capable wrapper; call the canonical EnvAccessPlan executor directly so MIR can capture the parent-owned effect")
    errors

pub fn validate_rt_hal_tags(modules: Dict<text, HirModule>, plan_path: text = "") -> [text]:
    var errors: [text] = []
    rt_hal_compilation_finalize_required = false
    rt_hal_compilation_plan_path = plan_path
    rt_hal_compilation_required_assurance_rank = 0
    rt_hal_compilation_plan_identity = ""
    for module_name in modules.keys():
        val module = modules[module_name]
        for function in module.functions.values():
            val tag_error = rt_hal_tag_error(function.func_attr)
            if tag_error != "":
                errors.push("{module_name}.{function.name}: {tag_error}")
            if function.func_attr.is_rt_hal:
                val has_foreign_comparator = (function.func_attr.rt_hal_compare_c or
                    function.func_attr.rt_hal_compare_rust)
                if has_foreign_comparator:
                    rt_hal_compilation_finalize_required = true
                    val rank = rt_hal_declared_assurance_rank(function.name)
                    if rank > rt_hal_compilation_required_assurance_rank:
                        rt_hal_compilation_required_assurance_rank = rank
                    if plan_path == "" or plan_path.len() > 4096 or not plan_path.starts_with("/") or plan_path.contains("/../") or plan_path.ends_with("/.."):
                        errors.push("{module_name}.{function.name}: E-RT-HAL-CONFIG: foreign comparison requires --rt-hal-plan with a bounded canonical absolute EnvAccessPlan path; implicit PATH discovery is forbidden")
                    # Foreign comparison receives an independently captured
                    # canonical operation/request transcript, not the Pure
                    # terminal receipt.  Parameter arity is therefore not a
                    # semantic restriction: MIR lowers the closed parameter
                    # tuple (scalars, UTF-8 text, tuples, fixed arrays, and
                    # Result branches) into the bounded request arena before
                    # entering the authored Pure body.  Unsupported parameter
                    # *types* fail at codec lowering rather than silently
                    # downgrading a parameterised function to oracle-fed IO.
                    if function.is_async:
                        errors.push("{module_name}.{function.name}: E-RT-HAL-SIGNATURE: async boundary receipts are unsupported")
                    # V2 retains the MIR value plus its canonical descriptor;
                    # semantic admission must not erase user return identity
                    # into the old i64 receipt ABI.
    # The emitted host call carries a compiler-owned identity of the entire
    # canonical plan, not merely its rank.  A same-rank plan replacement could
    # otherwise change tools, environment effects, or an operation selector
    # after semantic admission.  This is cold compiler work only.
    if (rt_hal_compilation_finalize_required and plan_path != "" and
        plan_path.len() <= 4096 and plan_path.starts_with("/") and
        not plan_path.contains("/../") and not plan_path.ends_with("/..")):
        match env_access_plan_parse_sdn_v1(file_read(plan_path)):
            case Err(problem):
                errors.push("E-RT-HAL-CONFIG: cannot bind canonical EnvAccessPlan identity: " + problem)
            case Ok(loaded):
                if loaded.required_assurance_rank != rt_hal_compilation_required_assurance_rank:
                    errors.push("E-RT-HAL-CONFIG: EnvAccessPlan assurance rank does not match the compiler-authoritative @rt(hal) rank")
                match env_access_plan_canonical_identity_v1(loaded):
                    case Err(problem):
                        errors.push("E-RT-HAL-CONFIG: cannot canonicalize EnvAccessPlan identity: " + problem)
                    case Ok(identity):
                        rt_hal_compilation_plan_identity = identity
    # This is intentionally a separate complete-body pass rather than a
    # spelling check in MIR.  If it returns no error, every admitted host
    # effect is a direct canonical executor call that the MIR transform below
    # can observe and encode; otherwise foreign comparison never reaches MIR.
    for capability_error in validate_rt_hal_env_capabilities(modules):
        errors.push(capability_error)
    errors

export RtHalTagMetadata, rt_hal_tag_metadata, rt_hal_function_metadata
export rt_hal_tag_error, validate_rt_hal_tags, rt_hal_compilation_requires_finalize
export rt_hal_compilation_configured_plan_path, rt_hal_compilation_required_assurance_rank, rt_hal_compilation_plan_identity
export validate_rt_hal_env_capabilities
