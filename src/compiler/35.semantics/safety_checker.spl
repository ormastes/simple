# Safety Checker
#
# Validates safety requirements for unsafe operations:
# - Inline assembly must be in unsafe blocks
# - Raw pointer operations must be in unsafe blocks
# - SFFI calls must be in unsafe blocks
#
# This is a separate validation pass that runs after HIR lowering.

use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.{Span}
use compiler.common.parallel_policy.policy_schema.{ResolvedParallelPolicyV1}
use compiler.semantics.boundary_transfer.{
    HirExecutionBoundary,
    HirRegionOrigin,
    classify_hir_boundary_transfer
}

# ============================================================================
# Safety Errors
# ============================================================================

enum SafetyError:
    """Safety checking error."""
    InlineAsmOutsideUnsafe(span: Span)
    UnsafeFfiOutsideUnsafe(span: Span)
    RawPointerOutsideUnsafe(span: Span)
    Other(message: text, span: Span)


# ============================================================================
# SafetyError Methods (was: impl SafetyError:)
# ============================================================================

# ============================================================================
# Safety Context
# ============================================================================

# E1047 (param-mutability-semantic, lane G2): semantic mirror of lint
# W-MC-REF-001 (35.semantics/lint/const_ref_default.spl), enforced from typed
# HIR instead of source text so it can't be fooled by formatting and can see
# through symbol-based aliasing/shadowing the text lint can't. Tracks, per
# current function, the non-`mut` params eligible to be flagged and whether
# each one's type is a `class` (reference type) -- s19
# (class_free_fn_mutation_dropped_native) protects class-param field/index
# mutation-through-reference by design, so only VALUE-type (struct/primitive)
# params are flagged for index-assign / known-mutating-method mutation.
# Reassignment of the parameter BINDING itself (`p = ...`) is flagged
# regardless of type -- rebinding the local never reaches the caller through
# either a class or a struct param, so it is always either a bug or a missing
# `mut`, exactly like the lint's `_crd_mutates` reassignment rule.
struct SafetyParamTrack:
    symbol_id: i64
    name: text
    is_class_type: bool


# E1048 (iterator-invalidation, lane G7): Rust's borrow checker rejects
# mutating a collection while iterating it; Simple silently allows
# `for x in xs: xs.push(...)`. Tracks, as a STACK (nested loops each push
# one entry), the collections currently being iterated by HIR symbol id --
# id not name, so shadowing/aliasing across scopes can't fool it, exactly
# like E1047's SafetyParamTrack. Only a `for` whose iterable is a plain
# local/param binding (`iter.kind` is `NamedVar`) is trackable; iterating a
# call result, literal, or range expression has no stable collection
# identity and is intentionally skipped (see the `For` case in
# safetychecker_check_expr). The stack shape gives nested-loop coverage for
# free: an inner loop's own push/pop only ever removes ITS entry, so an
# outer loop's collection stays flagged for the whole nested walk.
struct SafetyIterTrack:
    symbol_id: i64
    name: text


struct SafetyContext:
    """Tracks whether we're currently in an unsafe context."""
    in_unsafe: bool
    errors: [SafetyError]
    extern_fns: [text]      # module-local `extern fn` names (FFI rule)
    class_symbol_ids: [i64] # module-local `class` symbol ids (E1047 s19 gate)
    params: [SafetyParamTrack]  # current function's trackable non-mut params
    iter_tracks: [SafetyIterTrack]  # E1048: stack of collections currently being for-iterated


# ============================================================================
# SafetyContext Methods (was: impl SafetyContext:)
# ============================================================================

fn safetycontext_new() -> SafetyContext:
        SafetyContext(in_unsafe: false, errors: [], extern_fns: [], class_symbol_ids: [], params: [], iter_tracks: [])


# Raw-pointer runtime primitive families (see src/lib/nogc_sync_mut/ptr/raw.spl
# and src/lib/nogc_sync_mut/ptr/gc.spl). Name-based: these are extern SFFI
# entry points, so the callee name is the identity.
fn safety_is_raw_ptr_name(name: text) -> bool:
    if name.starts_with("rt_ptr_read"):
        return true
    if name.starts_with("rt_ptr_write"):
        return true
    if name == "rt_alloc" or name == "rt_free":
        return true
    if name.starts_with("ptr_add") or name.starts_with("ptr_sub"):
        return true
    false


fn safety_is_extern_fn(self: SafetyChecker, name: text) -> bool:
    for ext_name in self.context.extern_fns:
        if ext_name == name:
            return true
    false


# Shared rule application for a direct call to a named callee outside unsafe.
fn safetychecker_flag_callee(self: SafetyChecker, callee_name: text, span: Span):
    if safety_is_raw_ptr_name(callee_name):
        self.context.errors = self.context.errors.push(SafetyError.RawPointerOutsideUnsafe(span))
    elif safety_is_extern_fn(self, callee_name):
        self.context.errors = self.context.errors.push(SafetyError.UnsafeFfiOutsideUnsafe(span))


# ============================================================================
# E1047: param-mutability-semantic (lane G2)
# ============================================================================

# Same known-mutating method-name list as the lint (const_ref_default.spl's
# `_crd_mutating_methods`) -- kept in sync deliberately; upgrade path is a
# shared per-method mutation-effect table, not implemented here.
fn safety_mutating_methods() -> [text]:
    ["push", "pop", "insert", "remove", "clear", "sort"]


fn safety_lookup_param(self: SafetyChecker, symbol_id: i64) -> SafetyParamTrack?:
    for pt in self.context.params:
        if pt.symbol_id == symbol_id:
            return pt
    nil


# `target = value` can reach HIR two ways (hir_lowering/statements.spl):
# most paths route it straight to `HirStmtKind.Assign`, but the flat-parser
# fast path lowers it as `StmtKind.Expr` wrapping `ExprKind.Assign` and only
# rewrites THAT into `HirStmtKind.Assign` on its own early-return branch --
# a different frontend entry point (as used by `parse_full_frontend` here)
# can still hand SafetyChecker a plain `HirStmtKind.Expr` whose `.kind` is
# `HirExprKind.Assign` (same shape as HirStmtKind.Assign: target, op,
# value). Catch that shape here so E1047 doesn't silently miss it.
fn safetychecker_flag_expr_stmt_assign(self: SafetyChecker, expr: HirExpr):
    match expr.kind:
        case Assign(target, _, value):
            safetychecker_flag_param_assign(self, target)
        case _:
            pass


# Reassignment of the parameter BINDING (`p = ...`, including compound
# assignment -- the op is folded into HirStmtKind.Assign already). Flagged
# for both class- and struct-typed params: rebinding the local never reaches
# the caller through either kind of param, so it is not s19-protected.
fn safetychecker_flag_param_assign(self: SafetyChecker, target: HirExpr):
    match target.kind:
        case NamedVar(symbol, name):
            match safety_lookup_param(self, symbol.id):
                case Some(_found):
                    val msg = "E1047: parameter '{name}' is mutated but not declared mut"
                    self.context.errors = self.context.errors.push(SafetyError.Other(msg, target.span))
                case nil:
                    pass

        # `p[i] = ...` / `p[i] += ...` -- index-assign is s19-gated: only
        # flag when `p` is a non-class (VALUE-type) param.
        case Index(base, _):
            match base.kind:
                case NamedVar(bsymbol, bname):
                    match safety_lookup_param(self, bsymbol.id):
                        case Some(found):
                            if not found.is_class_type:
                                val msg = "E1047: parameter '{bname}' is mutated but not declared mut"
                                self.context.errors = self.context.errors.push(SafetyError.Other(msg, target.span))
                        case nil:
                            pass
                case _:
                    pass

        case _:
            pass


# Known-mutating method call (`p.push(..)` etc.) on a non-`mut` param.
# s19-gated: only flag when `p` is a non-class (VALUE-type) param.
fn safetychecker_flag_param_method_call(self: SafetyChecker, receiver: HirExpr, method: text, span: Span):
    var is_mutating = false
    for m in safety_mutating_methods():
        if m == method:
            is_mutating = true
    if not is_mutating:
        return
    match receiver.kind:
        case NamedVar(symbol, name):
            match safety_lookup_param(self, symbol.id):
                case Some(found):
                    if not found.is_class_type:
                        val msg = "E1047: parameter '{name}' is mutated but not declared mut"
                        self.context.errors = self.context.errors.push(SafetyError.Other(msg, span))
                case nil:
                    pass
        case _:
            pass


# ============================================================================
# E1048: iterator-invalidation (lane G7)
# ============================================================================

# Same known-mutating method-name list E1047 uses, plus `merge`. The
# AST-level collection anti-pattern desugar (`10.frontend/desugar/
# collection_desugar.spl`'s `try_rewrite_assign`, Pattern B) rewrites ANY
# `target = target + rhs` into `target.merge(rhs)` with no type gate, before
# HIR lowering ever sees it -- so `xs = xs + [1]` inside a `for x in xs:`
# body arrives here as a MethodCall(xs, "merge", ...), not an Assign. For a
# genuine collection binding (unlike E1047's scalar-param false-positive
# concern, which deliberately does NOT chase `merge`) this IS the real
# "collection mutated during iteration" shape and must be caught.
fn safety_iter_mutating_methods() -> [text]:
    ["push", "pop", "insert", "remove", "clear", "sort", "merge"]


fn safety_lookup_iter(self: SafetyChecker, symbol_id: i64) -> SafetyIterTrack?:
    for it in self.context.iter_tracks:
        if it.symbol_id == symbol_id:
            return it
    nil


# Reassignment (`xs = ...`) or index-assign (`xs[i] = ...`) of a collection
# currently being for-iterated. Unlike E1047 there is no class/struct
# s19 distinction here -- both shapes replace/mutate the very sequence the
# active `for` loop is walking, regardless of the binding's type.
fn safetychecker_flag_iter_assign(self: SafetyChecker, target: HirExpr):
    match target.kind:
        case NamedVar(symbol, name):
            match safety_lookup_iter(self, symbol.id):
                case Some(_found):
                    val msg = "E1048: collection '{name}' is mutated while being iterated"
                    self.context.errors = self.context.errors.push(SafetyError.Other(msg, target.span))
                case nil:
                    pass

        case Index(base, _):
            match base.kind:
                case NamedVar(bsymbol, bname):
                    match safety_lookup_iter(self, bsymbol.id):
                        case Some(_found):
                            val msg = "E1048: collection '{bname}' is mutated while being iterated"
                            self.context.errors = self.context.errors.push(SafetyError.Other(msg, target.span))
                        case nil:
                            pass
                case _:
                    pass

        case _:
            pass


# Mirror of safetychecker_flag_expr_stmt_assign: the flat-parser fast path
# can hand SafetyChecker a plain `HirStmtKind.Expr` wrapping
# `HirExprKind.Assign` instead of routing through `HirStmtKind.Assign` --
# catch that shape here too so E1048 doesn't silently miss it.
fn safetychecker_flag_expr_stmt_iter_assign(self: SafetyChecker, expr: HirExpr):
    match expr.kind:
        case Assign(target, _, value):
            safetychecker_flag_iter_assign(self, target)
        case _:
            pass


# Known-mutating method call (`xs.push(..)` etc., including the desugared
# `xs.merge(..)` shape) on a collection currently being for-iterated.
fn safetychecker_flag_iter_method_call(self: SafetyChecker, receiver: HirExpr, method: text, span: Span):
    var is_mutating = false
    for m in safety_iter_mutating_methods():
        if m == method:
            is_mutating = true
    if not is_mutating:
        return
    match receiver.kind:
        case NamedVar(symbol, name):
            match safety_lookup_iter(self, symbol.id):
                case Some(_found):
                    val msg = "E1048: collection '{name}' is mutated while being iterated"
                    self.context.errors = self.context.errors.push(SafetyError.Other(msg, span))
                case nil:
                    pass
        case _:
            pass


# ============================================================================
# Safety Checker
# ============================================================================

class SafetyChecker:
    """Validates safety requirements in HIR.

    MUST be a `class` (reference type), not a `struct`: the check_* functions
    below thread `self` through a deep recursive walk
    (check_module -> check_function -> check_block -> check_stmt ->
    check_expr -> ...) and append to `self.context.errors` at arbitrary
    recursion depth. A `struct` `self` is a value type -- passed BY COPY into
    each nested call -- so any `self.context.errors = ...push(...)` done
    inside a nested call mutates only that call's local copy and is lost the
    moment it returns, leaving the top-level caller's `errors` empty. This
    silently discarded every diagnostic the checker ever produced (all three
    rules), while `in_unsafe` toggling still looked like it worked because
    each block's own nested calls saw the mutation made earlier in the SAME
    downward call chain. `HirLowering` (compiler/20.hir/hir_lowering/types.spl)
    is a `class` for exactly this reason -- it accumulates `self.errors`
    across an equally deep recursive lowering walk."""
    context: SafetyContext


impl SafetyChecker:
    static fn create() -> SafetyChecker:
        SafetyChecker(context: safetycontext_new())


fn safetychecker_check_module(self: SafetyChecker, module: HirModule) -> [SafetyError]:
    """Check an entire module for safety violations."""
    # Collect module-local extern fn names first: direct calls to these are
    # FFI boundary crossings and must sit inside an `unsafe:` block.
    for _for_item_e in module.functions:
        val ext_func = _for_item_e[1]
        if ext_func.is_extern:
            self.context.extern_fns = self.context.extern_fns.push(ext_func.name)

    # Collect module-local `class` symbol ids (E1047 s19 gate): a param typed
    # Named(sym, _) whose sym is in this set is a reference type and must NOT
    # be flagged for index-assign / mutating-method mutation.
    for _for_item_cls in module.classes:
        val cls_ = _for_item_cls[1]
        self.context.class_symbol_ids = self.context.class_symbol_ids.push(cls_.symbol.id)

    # Check all functions
    for _for_item_0 in module.functions:
        val name = _for_item_0[0]
        val func = _for_item_0[1]
        safetychecker_check_function(self, func)

    # Check all methods in classes.
    #
    # `HirClass.methods` is `Dict<text, SymbolId>` (method name -> symbol),
    # NOT a body list -- iterating a Dict in this language yields (key,
    # value) tuples (same shape as the `module.functions` iteration just
    # above), so the old `for method in class_.methods:
    # safetychecker_check_function(self, method)` passed a raw tuple where a
    # `HirFunction` was expected and crashed the first time any spec defined
    # a class with a method body (E1047 lane G2, 2026-07-29): "semantic:
    # undefined field: unknown property or method 'params' on Tuple". Route
    # through the symbol instead and look the real body up in
    # `module.functions` (`Dict<SymbolId, HirFunction>`). NOTE: a class's
    # inline-method bodies are lowered in `declaration_lowering.spl:
    # lower_class` but only `hir_fn.symbol` is kept in `methods` -- the
    # `HirFunction` itself is never merged into `module.functions` for
    # class-embedded methods (unlike impl methods below, via
    # `lowered_impl_functions`), so `contains_key` is expected to miss and
    # skip here until that gap is closed upstream; this fix's job is only to
    # stop the crash and check what IS reachable.
    for _for_item_1 in module.classes:
        val class_ = _for_item_1[1]
        for _for_item_cm in class_.methods:
            val method_symbol = _for_item_cm[1]
            if module.functions.contains_key(method_symbol):
                safetychecker_check_function(self, module.functions[method_symbol])

    # Check all methods in impls. Same Dict<text, SymbolId> shape as classes
    # above, but impl method bodies ARE merged into `module.functions` (via
    # `self.lowered_impl_functions` in module_lowering.spl), so this path
    # now actually walks real bodies instead of being permanently dead.
    for impl_ in module.impls:
        for _for_item_im in impl_.methods:
            val method_symbol = _for_item_im[1]
            if module.functions.contains_key(method_symbol):
                safetychecker_check_function(self, module.functions[method_symbol])

    self.context.errors


fn safetychecker_build_param_tracks(self: SafetyChecker, params: [HirParam]) -> [SafetyParamTrack]:
    """Build the E1047-trackable param list for one function: non-`mut`,
    non-receiver (`self`/`me`) params, tagged with whether their type is a
    module-local `class` (s19-protected, reference semantics)."""
    var out: [SafetyParamTrack] = []
    for p in params:
        if p.is_mutable:
            continue
        if p.name == "self" or p.name == "me":
            continue
        var is_class = false
        match p.type_.kind:
            case Named(tsym, _):
                for csym_id in self.context.class_symbol_ids:
                    if csym_id == tsym.id:
                        is_class = true
            case _:
                pass
        out.push(SafetyParamTrack(symbol_id: p.symbol.id, name: p.name, is_class_type: is_class))
    out


fn safetychecker_check_function(self: SafetyChecker, func: HirFunction):
    """Check a function body for safety violations."""
    self.context.params = safetychecker_build_param_tracks(self, func.params)
    safetychecker_check_block(self, func.body)


fn safetychecker_check_block(self: SafetyChecker, block: HirBlock):
    """Check a block of statements."""
    for stmt in block.stmts:
        safetychecker_check_stmt(self, stmt)

    if block.has:
        safetychecker_check_expr(self, block.value)


fn safetychecker_check_stmt(self: SafetyChecker, stmt: HirStmt):
    """Check a statement for safety violations."""
    # NOTE: HirStmtKind's real variants are `Expr`, `Let` (covers both `val`
    # and `var` -- see compiler/hir/hir_definitions.spl:690-695), `Assign`
    # (target, op, value -- op is embedded, there is no separate `AssignOp`
    # variant), `Block`, and `AsmAssert`. This match previously matched on
    # `Val`/`Var`/`AssignOp`, none of which exist as HirStmtKind variants, so
    # those arms were permanently dead and every `val`/`var` initializer
    # (and every compound-assignment target/value) silently skipped the
    # safety walk -- e.g. `val p = rt_alloc(16)` outside `unsafe:` never
    # reached the Call check at all.
    match stmt.kind:
        case Expr(expr):
            safetychecker_check_expr(self, expr)
            safetychecker_flag_expr_stmt_assign(self, expr)
            safetychecker_flag_expr_stmt_iter_assign(self, expr)

        case Let(_, _, init):
            safetychecker_check_expr(self, init)

        case Assign(target, _, value):
            safetychecker_check_expr(self, target)
            safetychecker_check_expr(self, value)
            safetychecker_flag_param_assign(self, target)
            safetychecker_flag_iter_assign(self, target)

        case Block(block):
            safetychecker_check_block(self, block)

        case _:
            pass


fn safetychecker_check_args(self: SafetyChecker, args: [HirCallArg]):
    """Check safety in call arguments."""
    for arg in args:
        val arg_val: HirExpr = arg.value
        safetychecker_check_expr(self, arg_val)


fn safetychecker_check_expr(self: SafetyChecker, expr: HirExpr):
    """Check an expression for safety violations."""
    match expr.kind:
        # Unsafe block - enter unsafe context
        case UnsafeBlock(body):
            val was_unsafe = self.context.in_unsafe
            self.context.in_unsafe = true
            safetychecker_check_block(self, body)
            if not was_unsafe:
                self.context.in_unsafe = false

        # Inline assembly - must be in unsafe block
        case InlineAsm(asm_code):
            if not self.context.in_unsafe:
                self.context.errors = self.context.errors.push(SafetyError.InlineAsmOutsideUnsafe(expr.span))
            # Type check constraint expressions
            for constraint in asm_code.constraints:
                val cval: HirExpr = constraint.value
                safetychecker_check_expr(self, cval)

        # Target-dispatched inline assembly (asm match) - same rule as
        # plain InlineAsm; previously fell through the wildcard unchecked
        # (doc/08_tracking/bug/safety_checker_pass_never_invoked_2026-07-27.md).
        case InlineAsmMatch(_):
            if not self.context.in_unsafe:
                self.context.errors = self.context.errors.push(SafetyError.InlineAsmOutsideUnsafe(expr.span))

        # Binary operations
        case Binary(_, left, right):
            safetychecker_check_expr(self, left)
            safetychecker_check_expr(self, right)

        # Unary operations
        case Unary(_, operand):
            safetychecker_check_expr(self, operand)

        # Control flow
        case If(cond, then_, else_):
            safetychecker_check_expr(self, cond)
            safetychecker_check_block(self, then_)
            match else_:
                case Some(block):
                    safetychecker_check_block(self, block)
                case nil:
                    pass

        case IfChain(arms, else_):
            for arm in arms:
                val typed_arm: HirIfArm = arm
                safetychecker_check_expr(self, typed_arm.cond)
                safetychecker_check_block(self, typed_arm.then_)
            match else_:
                case Some(block):
                    safetychecker_check_block(self, block)
                case nil:
                    pass

        case MatchCase(scrutinee, arms):
            safetychecker_check_expr(self, scrutinee)
            for arm in arms:
                if arm.has_guard:
                    safetychecker_check_expr(self, arm.guard)
                safetychecker_check_block(self, arm.body)

        case Loop(body, _):
            safetychecker_check_block(self, body)

        case While(cond, body, _):
            safetychecker_check_expr(self, cond)
            safetychecker_check_block(self, body)

        case For(_, iter, body, _):
            safetychecker_check_expr(self, iter)
            # E1048: only a plain local/param binding has a stable
            # collection identity to track; a call result, literal, or
            # range expression is intentionally skipped (lane G7 scope).
            val saved_iter_depth = self.context.iter_tracks.len()
            match iter.kind:
                case NamedVar(symbol, name):
                    self.context.iter_tracks = self.context.iter_tracks.push(SafetyIterTrack(symbol_id: symbol.id, name: name))
                case _:
                    pass
            safetychecker_check_block(self, body)
            # Pop back to the pre-loop depth (stack semantics): this
            # removes only the entry THIS loop pushed, so an outer loop's
            # tracked collection stays active across sibling statements
            # that follow this nested loop but are still inside the outer
            # loop's own body.
            var restored_iter_tracks: [SafetyIterTrack] = []
            var iter_depth_idx = 0
            for track in self.context.iter_tracks:
                if iter_depth_idx < saved_iter_depth:
                    restored_iter_tracks = restored_iter_tracks.push(track)
                iter_depth_idx = iter_depth_idx + 1
            self.context.iter_tracks = restored_iter_tracks

        # Function calls: direct calls to raw-pointer primitives or module
        # extern fns outside an `unsafe:` block violate the safety boundary.
        case Call(callee, args, _):
            if not self.context.in_unsafe:
                match callee.kind:
                    case NamedVar(_, callee_name):
                        safetychecker_flag_callee(self, callee_name, expr.span)
                    case _:
                        pass
            safetychecker_check_expr(self, callee)
            safetychecker_check_args(self, args)

        case MethodCall(receiver, method_name, args, _):
            safetychecker_flag_param_method_call(self, receiver, method_name, expr.span)
            safetychecker_flag_iter_method_call(self, receiver, method_name, expr.span)
            safetychecker_check_expr(self, receiver)
            safetychecker_check_args(self, args)

        # Collections
        case ArrayLit(elements, _):
            for elem in elements:
                safetychecker_check_expr(self, elem)

        case ArrayRepeat(value, count, _):
            safetychecker_check_expr(self, value)
            safetychecker_check_expr(self, count)

        case TupleLit(elements):
            for elem in elements:
                safetychecker_check_expr(self, elem)

        case DictLit(entries, _, _):
            for _item_0 in entries:
                val key = _item_0[0]
                val value = _item_0[1]
                safetychecker_check_expr(self, key)
                safetychecker_check_expr(self, value)

        # Blocks
        case Block(block):
            safetychecker_check_block(self, block)

        case LossBlock(body):
            safetychecker_check_block(self, body)

        case NogradBlock(body):
            safetychecker_check_block(self, body)

        # Lambdas
        case Lambda(_, body, _):
            safetychecker_check_expr(self, body)

        # Returns and breaks
        case Return(value):
            match value:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass

        case Break(_, value):
            match value:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass

        case Throw(value):
            safetychecker_check_expr(self, value)

        case Try(expr_):
            safetychecker_check_expr(self, expr_)

        # Optional operations
        case OptionalChain(base, _):
            safetychecker_check_expr(self, base)

        case NullCoalesce(left, right):
            safetychecker_check_expr(self, left)
            safetychecker_check_expr(self, right)

        case ExistsCheck(base):
            safetychecker_check_expr(self, base)

        case Unwrap(base):
            safetychecker_check_expr(self, base)

        # Field access and indexing
        case Field(base, _, _):
            safetychecker_check_expr(self, base)

        case Index(base, index):
            safetychecker_check_expr(self, base)
            safetychecker_check_expr(self, index)

        # Struct and enum literals
        case StructLit(_, fields):
            for _item_1 in fields:
                val fval = _item_1[1]
                safetychecker_check_expr(self, fval)

        case EnumLit(_, _, payload):
            match payload:
                case Some(value):
                    match value:
                        case Tuple(exprs):
                            for expr_ in exprs:
                                safetychecker_check_expr(self, expr_)
                        case Struct(fields):
                            for _item_2 in fields:
                                val fval = _item_2[1]
                                safetychecker_check_expr(self, fval)
                        case _:
                            pass
                case nil:
                    pass

        # Casts
        case Cast(expr_, _):
            safetychecker_check_expr(self, expr_)

        case As(expr_, _):
            safetychecker_check_expr(self, expr_)

        # Range
        case Range(start, end_, _, step):
            match start:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass
            match end_:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass
            match step:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass

        # Comprehensions
        case Comprehension(_, expr_, clauses):
            safetychecker_check_expr(self, expr_)
            for clause in clauses:
                match clause.kind:
                    case For(_, iter):
                        safetychecker_check_expr(self, iter)
                    case If(cond):
                        safetychecker_check_expr(self, cond)

        # Async
        case Await(expr_):
            safetychecker_check_expr(self, expr_)

        case Yield(value):
            match value:
                case Some(expr_):
                    safetychecker_check_expr(self, expr_)
                case nil:
                    pass

        # Literals and simple expressions
        case IntLit(_, _):
            pass

        case FloatLit(_, _):
            pass

        case StringLit(_, _):
            pass

        case BoolLit(_):
            pass

        case CharLit(_):
            pass

        case UnitLit:
            pass

        case NilLit:
            pass

        case Var(_):
            pass

        case Error:
            pass

        case _:
            pass

# ============================================================================
# E1049: transfer-share (lane G8, 2026-07-29)
# ============================================================================
#
# Phase-1 scoping (see
# doc/01_research/language/simple_vs_rust_safety_property_audit_2026-07-28.md
# G8 "Transfer/Share structural capabilities" and
# doc/03_plan/agent_tasks/mission_critical_robustness_parallel_agents_2026-07-27.md
# "G8 Transfer/Share capabilities (needs contract lock)", deferred to Batch 3)
# found NO distinguishable "spawn site" or "actor message send" node at HIR
# level:
#   - The parser DOES have a dedicated `ExprKind.Spawn(Expr)` AST node
#     (`10.frontend/parser_types_expr.spl:227`, built by
#     `parse_spawn_expr` at `10.frontend/parser_extensions.spl:179-194`) but
#     it has ZERO callers anywhere in the frontend -- fully dead code. The one
#     HIR lowering dispatch that would ever see it,
#     `20.hir/hir_lowering/expressions.spl`'s `lower_hir_expr` match, has no
#     `case ExprKind.Spawn` arm and falls through to
#     `case _: self.error("unsupported expression kind", e.span)` (:837-839)
#     -- so if that AST node were ever produced, HIR lowering would hard-error.
#   - The only LIVE `spawn` is an ordinary builtin-named function call
#     (`spawn(Worker(...))`), lowered as a plain `HirExprKind.Call` with a
#     `NamedVar` callee, matched by callee-NAME STRING in three independent,
#     uncoordinated places today: `30.types/type_system/checker.spl:122`,
#     `30.types/type_system/builtin_registry.spl:123`, and
#     `50.mir/mir_effects.spl:315`. This rule reuses that same precedent
#     (string match on the callee name) rather than inventing a new one.
#   - Actors have NO representation in the type system at all: `module.actors`
#     (`20.hir/hir_lowering/module_surface.spl:240-242,357`,
#     `_Items/module_lowering.spl:546-547`) exists only for module-surface /
#     import wiring. There is no `HirTypeKind.Actor` (or any equivalent)
#     anywhere under `30.types`, so an actor-typed receiver cannot be told
#     apart from an ordinary class receiver at a `MethodCall` -- "gate an
#     actor message send" is therefore NOT decision-free and is out of scope
#     for this rule.
#   - `HirExpr.type_` is set to `nil` at HIR-lowering time
#     (`20.hir/hir_lowering/expressions.spl` `lower_hir_expr`'s final
#     `HirExpr(kind: kind, type_: nil, span: e.span)`) and is NEVER written
#     anywhere else in the compiler (`grep -rn '\.type_ =' 20.hir/ 30.types/`
#     is empty) -- there is no per-expression inferred type available to a
#     HIR-level pass. What IS available without any new inference wiring is
#     the DECLARED type on a parameter (`HirParam.type_: HirType`, mandatory,
#     straight from the source annotation) -- the same syntactic source
#     `safetychecker_build_param_tracks` already reads for E1047's
#     `is_class_type` gate. `iso T` is real end-to-end as of 2026-07-29
#     (`HirTypeKind.Isolated(inner: HirType)`, `20.hir/hir_types.spl:677`) and
#     shows up on that same declared-type field, so "declared `iso` or not"
#     is likewise decision-free.
#
# Net decision-free slice: a bare parameter reference (module-local `class`
# type -- share/reference/GC-aliasable semantics, via the same
# `class_symbol_ids` gate E1047 uses) passed DIRECTLY as an argument to a
# call whose callee is literally named `spawn`, when that parameter's
# declared type is not wrapped in `iso`. Deliberately NOT covered (each is a
# real language-design decision, not merely more code):
#   - actor message sends (`worker.tell(x)`) -- unenforceable, no Actor type
#   - a Send-derived-from-fields capability walk (the audit's original G8 ask)
#   - freshly-constructed spawn arguments (`spawn(Worker(x))`) -- trivially
#     unaliased by construction, and typing them needs the same missing
#     inferred-type plumbing above
#   - let-bound locals (only params are tracked; extending to lets needs a
#     scoped symbol-id -> declared-type table this lane did not build, to
#     keep this block free of new shared mutable state)
#
# SEPARATE finding surfaced while writing the spec for this rule (see
# `test/01_unit/compiler/semantics/transfer_share_semantic_spec.spl`'s own
# header and
# `doc/08_tracking/bug/spawn_call_expr_silently_becomes_nillit_2026-07-29.md`):
# on the currently-active Rust bootstrap seed binary, an actual `spawn(...)`
# CALL EXPRESSION (not just the `fn spawn(...)` declaration, which is a
# separate hard parse error since `spawn` lexes as `KwSpawn`, never
# `TOK_IDENT`) silently lowers to `HirExprKind.NilLit` -- discarding the
# callee and every argument -- with ZERO diagnostic anywhere. That is a
# `10.frontend/_FlatAstBridge/convert_nodes.spl` (bootstrap-seed-only
# frontend path) bug, upstream of and out-of-scope for this file; this
# rule's own correctness is proven against hand-built HIR instead (same
# technique `iso_move_pipeline_spec.spl` uses for an analogous parser-layer
# gap) so it is not blocked on that separate fix. Net effect: even once this
# rule is wired into the driver's real compile path, it cannot see a single
# real `spawn(...)` call site on the seed until that bridge bug is fixed --
# worth re-verifying against the self-hosted (non-seed) compiler, which was
# not available to build in this session.
#
# Implemented as its OWN top-level walk (own recursion, own function
# coverage), NOT woven into `safetychecker_check_expr` / `check_module` /
# `check_stmt` above -- so this block stays a clean append and merges
# textually against any other lane editing the primary dispatch in this
# file. Reuses `self.context.class_symbol_ids` (read-only here), which is
# populated by `safetychecker_check_module` -- callers should invoke
# `safetychecker_check_transfer_module` on the SAME `SafetyChecker` instance
# right after `safetychecker_check_module` for the same module (see
# `80.driver/driver.spl`'s `run_safety_warn_pass`).
struct SafetyTransferBinding:
    symbol_id: i64
    name: text
    is_class_type: bool
    declared_type: HirType

fn safety_transfer_type_is_class(type_: HirType, class_symbol_ids: [i64]) -> bool:
    match type_.kind:
        case Named(tsym, _):
            class_symbol_ids.contains(tsym.id)
        case Isolated(inner):
            safety_transfer_type_is_class(inner, class_symbol_ids)
        case _: false


fn safety_transfer_bindings_for_params(self: SafetyChecker, params: [HirParam]) -> [SafetyTransferBinding]:
    """Build the E1049-trackable binding list for one function's params:
    every non-receiver param, tagged with whether its DECLARED type is a
    module-local `class` (E1047's class_symbol_ids gate) and whether it is
    `iso`-wrapped (HirTypeKind.Isolated)."""
    var out: [SafetyTransferBinding] = []
    for p in params:
        if p.name == "self" or p.name == "me":
            continue
        val is_class = safety_transfer_type_is_class(p.type_,
            self.context.class_symbol_ids)
        out = out.push(SafetyTransferBinding(symbol_id: p.symbol.id,
            name: p.name, is_class_type: is_class,
            declared_type: p.type_))
    out


fn safety_transfer_lookup(bindings: [SafetyTransferBinding], symbol_id: i64) -> SafetyTransferBinding?:
    for b in bindings:
        if b.symbol_id == symbol_id:
            return b
    nil


# Recursive expression walk covering the statement/expression shapes needed
# to find `spawn(...)` call sites under common control flow (if/while/loop/
# for/block/lambda bodies, plain binary/unary/call/method-call/array/tuple/
# struct-lit nesting). `bindings` is threaded by VALUE (arrays are value
# types in this language -- see feedback_arrays_value_types) so a nested
# block naturally gets its own scoped copy without any explicit push/pop
# bookkeeping and without ever mutating the caller's list.
fn safety_transfer_walk_expr(self: SafetyChecker, expr: HirExpr,
                             bindings: [SafetyTransferBinding],
                             policy: ResolvedParallelPolicyV1,
                             out: [SafetyError]) -> [SafetyError]:
    match expr.kind:
        case Call(callee, args, _):
            var out2 = out
            match callee.kind:
                case NamedVar(_, callee_name):
                    # `spawn_actor` is the intended desugared spelling;
                    # `spawn` retains the hand-built HIR regression path while
                    # the seed bridge still drops ExprKind.Spawn.
                    if callee_name == "spawn" or callee_name == "spawn_actor":
                        for arg in args:
                            match arg.value.kind:
                                case NamedVar(asymbol, aname):
                                    match safety_transfer_lookup(bindings, asymbol.id):
                                        case Some(b):
                                            val decision = classify_hir_boundary_transfer(
                                                b.declared_type, b.is_class_type,
                                                HirExecutionBoundary.Thread,
                                                HirRegionOrigin.ParentExisting,
                                                false,
                                                policy)
                                            if decision.code.len() > 0:
                                                val msg = "{decision.code}: '{aname}' passed to spawn(): {decision.message}"
                                                out2 = out2.push(SafetyError.Other(msg, arg.value.span))
                                        case nil:
                                            pass
                                case _:
                                    pass
                case _:
                    pass
            out2 = safety_transfer_walk_expr(self, callee, bindings, policy, out2)
            for arg in args:
                out2 = safety_transfer_walk_expr(self, arg.value, bindings, policy, out2)
            out2

        case MethodCall(receiver, _, args, _):
            var out3 = safety_transfer_walk_expr(self, receiver, bindings, policy, out)
            for arg in args:
                out3 = safety_transfer_walk_expr(self, arg.value, bindings, policy, out3)
            out3

        case Binary(_, left, right):
            safety_transfer_walk_expr(self, right, bindings, policy,
                safety_transfer_walk_expr(self, left, bindings, policy, out))

        case Unary(_, operand):
            safety_transfer_walk_expr(self, operand, bindings, policy, out)

        case If(cond, then_, else_):
            var out4 = safety_transfer_walk_expr(self, cond, bindings, policy, out)
            out4 = safety_transfer_walk_block(self, then_, bindings, policy, out4)
            match else_:
                case Some(eb):
                    out4 = safety_transfer_walk_block(self, eb, bindings, policy, out4)
                case nil:
                    pass
            out4

        case IfChain(arms, else_):
            var out4 = out
            for arm in arms:
                val typed_arm: HirIfArm = arm
                out4 = safety_transfer_walk_expr(self, typed_arm.cond, bindings, policy, out4)
                out4 = safety_transfer_walk_block(self, typed_arm.then_, bindings, policy, out4)
            match else_:
                case Some(eb):
                    out4 = safety_transfer_walk_block(self, eb, bindings, policy, out4)
                case nil:
                    pass
            out4

        case Loop(body, _):
            safety_transfer_walk_block(self, body, bindings, policy, out)

        case While(cond, body, _):
            safety_transfer_walk_block(self, body, bindings, policy,
                safety_transfer_walk_expr(self, cond, bindings, policy, out))

        case For(_, iter, body, _):
            safety_transfer_walk_block(self, body, bindings, policy,
                safety_transfer_walk_expr(self, iter, bindings, policy, out))

        case Block(block):
            safety_transfer_walk_block(self, block, bindings, policy, out)

        case Lambda(_, body, _):
            safety_transfer_walk_expr(self, body, bindings, policy, out)

        case Return(value):
            match value:
                case Some(v):
                    safety_transfer_walk_expr(self, v, bindings, policy, out)
                case nil:
                    out

        case ArrayLit(elements, _):
            var out5 = out
            for e in elements:
                out5 = safety_transfer_walk_expr(self, e, bindings, policy, out5)
            out5

        case TupleLit(elements):
            var out6 = out
            for e in elements:
                out6 = safety_transfer_walk_expr(self, e, bindings, policy, out6)
            out6

        case StructLit(_, fields):
            var out7 = out
            for sfield in fields:
                val sval = sfield[1]
                out7 = safety_transfer_walk_expr(self, sval, bindings, policy, out7)
            out7

        case _:
            out


fn safety_transfer_walk_block(self: SafetyChecker, block: HirBlock,
                              bindings: [SafetyTransferBinding],
                              policy: ResolvedParallelPolicyV1,
                              out: [SafetyError]) -> [SafetyError]:
    var out_acc = out
    for stmt in block.stmts:
        match stmt.kind:
            case Expr(expr):
                out_acc = safety_transfer_walk_expr(self, expr, bindings, policy, out_acc)
            case Assign(target, _, value):
                out_acc = safety_transfer_walk_expr(self, target, bindings, policy, out_acc)
                out_acc = safety_transfer_walk_expr(self, value, bindings, policy, out_acc)
            case Block(inner):
                out_acc = safety_transfer_walk_block(self, inner, bindings, policy, out_acc)
            case Let(_, _, linit):
                out_acc = safety_transfer_walk_expr(self, linit, bindings, policy, out_acc)
            case _:
                pass
    if block.has:
        out_acc = safety_transfer_walk_expr(self, block.value, bindings, policy, out_acc)
    out_acc


fn safetychecker_check_transfer_module_with_policy(
    self: SafetyChecker,
    module: HirModule,
    policy: ResolvedParallelPolicyV1
) -> [SafetyError]:
    """E1049 top-level entry (lane G8). Independent traversal -- see the
    block comment above. Covers `module.functions` (plain functions AND
    impl methods, which are merged into `module.functions` by
    `module_lowering.spl`'s `lowered_impl_functions` -- same set
    `safetychecker_check_module`'s first loop walks); class-embedded method
    bodies are skipped, the same pre-existing gap `safetychecker_check_module`
    documents (they are never merged into `module.functions`)."""
    var out: [SafetyError] = []
    for _for_item in module.functions:
        val func = _for_item[1]
        val bindings = safety_transfer_bindings_for_params(self, func.params)
        out = safety_transfer_walk_block(self, func.body, bindings, policy, out)
    out

fn safetychecker_check_transfer_module(self: SafetyChecker,
                                       module: HirModule) -> [SafetyError]:
    safetychecker_check_transfer_module_with_policy(
        self, module, ResolvedParallelPolicyV1.balanced())


