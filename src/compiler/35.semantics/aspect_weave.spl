# C3 static-weave codegen: rewrite matched `forward` join points to invoke
# their validated advice function.
#
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (C3)
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (M5 = C3)
#
# WHAT THE PRIOR C3 COMMIT (ecd8cddab7e4) LEFT UNCLAIMED, VERBATIM FROM ITS
# OWN REPORT: "Static-weave codegen, the slot+generation sidecar, and the
# dynload/live-reload modes are the remainder of M5 and are not claimed."
# This file closes the FIRST of those three, for the ONE join-point kind
# `join_point_model.join_point_kind_is_measurable` can actually prove:
# `forward`. The other six kinds stay unwoven for the same reason
# `aspect_validation.spl` reports them UNMEASURED rather than assumed clean --
# there is no emitter to enumerate them from, so there is nothing here to
# weave against.
#
# WEAVE SHAPE: "static weave (zero disabled overhead)" per the plan means the
# advice call becomes part of the forwarder's own body -- no runtime table
# lookup, no dispatch through a plan object. Concretely: prepend a call to the
# advice function to the top of the matched forwarder's HIR body, ahead of
# its existing (single) delegating statement. This is deliberately the same
# "before advice, entry-block prepend" shape `50.mir/mir_aop_injection.spl`'s
# `inject_before_advice` already uses for physical join points -- one weave
# SHAPE in this tree, not two, even though the physical and logical weavers
# necessarily operate on different IRs (MIR vs. HIR) because a logical join
# point by definition has no physical function of its own to carry a MIR
# body until AFTER this pass runs.
#
# CALLER CONTRACT: this function must only run once `validate_aspect_contracts`
# (aspect_validation.spl) has reported ZERO errors for the compilation. It
# re-derives the same match (kind known, mode implemented, selector matched)
# so a caller that skips validation cannot silently weave a malformed advice,
# but it does NOT re-check the `@readonly @noalloc @bounded_time` obligations
# -- those are validation's job, not codegen's, exactly like C4's
# `effect_validation.spl` is the sole owner of loop/copy-budget verdicts.
#
# IDEMPOTENCE: `_forwarder_already_woven` scans the body for an existing call
# to the same advice function before prepending another. Without this, a
# driver that (for any reason -- a retry, an incremental re-run) called this
# function twice on the same HIR would insert the advice call twice, which is
# an observable behavioural change (the advice fires twice), not a harmless
# no-op re-weave.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.join_point_model.{
    JoinPoint, forward_join_points, join_points_matching, join_point_is_forwarder,
    join_point_kind_is_measurable, join_point_mode_is_implemented
}
use compiler.semantics.aspect_validation.{aspect_module_identity_index,
    AspectContractClaimV1, aspect_contract_claims_v1}
use compiler.frontend.aspect_registry.{aspect_registry_claim_keys}

fn _advice_call_expr(advice_fn_name: text, span: Span) -> HirExpr:
    val unit_type = HirType(kind: HirTypeKind.Unit, span: span)
    val callee = HirExpr(
        kind: HirExprKind.NamedVar(SymbolId(id: -1), advice_fn_name),
        has_type_: false, type_: unit_type, span: span)
    HirExpr(
        kind: HirExprKind.Call(callee, [], []),
        has_type_: false, type_: unit_type, span: span)

# True when `body` already opens with a call to `advice_fn_name` -- the
# idempotence guard documented above. Only the FIRST statement is checked:
# that is the only shape this weaver itself ever produces, so a match there
# is proof this exact pass already ran, not a false positive from advice
# appearing incidentally later in a (non-forwarder) body.
fn _forwarder_already_woven(body: HirBlock, advice_fn_name: text) -> bool:
    if body.stmts.len() == 0:
        return false
    val first: HirStmt = body.stmts[0]
    match first.kind:
        case HirStmtKind.Expr(e):
            val call: HirExpr = e
            match call.kind:
                case HirExprKind.Call(callee, _, _):
                    match callee.kind:
                        case HirExprKind.NamedVar(_, name):
                            name == advice_fn_name
                        case _:
                            false
                case _:
                    false
        case _:
            false

fn _weave_body(body: HirBlock, advice_fn_name: text) -> HirBlock:
    if _forwarder_already_woven(body, advice_fn_name):
        return body
    val advice_stmt = HirStmt(
        kind: HirStmtKind.Expr(_advice_call_expr(advice_fn_name, body.span)),
        span: body.span)
    var new_stmts: [HirStmt] = [advice_stmt]
    for s in body.stmts:
        new_stmts.push(s)
    HirBlock(stmts: new_stmts, has: body.has, value: body.value, span: body.span)

# Weave every validated, in-scope `forward` advice into its matched join
# point's forwarder body, mutating `modules` in place (HirModule.functions is
# a Dict, shared by reference the same way `60.mir_opt/mir_opt/mod.spl`'s
# `result_module.functions[updated.symbol] = updated` mutates MirModule).
# Returns the number of forwarder bodies actually rewritten, so a caller can
# assert "N advices requested, N woven" the way `mir_aop_injection.spl`'s
# `aop_weave_accounting` already does for the physical weaver.
struct AspectForwardWeaveClaimV1:
    registry_key: text
    selector: text
    advice_fn: text

# This is a body-free recipe derived from the real registry and original
# join-point universe. It is not an admission token: validate aspects first
# and bind/replay the recipe at the archive publication boundary.
pub fn aspect_forward_weave_claims_v1(module_ids: Dict<text, bool>,
        forwards: [JoinPoint]) -> [AspectForwardWeaveClaimV1]:
    aspect_forward_weave_contract_claims_v1(module_ids, forwards, aspect_contract_claims_v1())

pub fn aspect_forward_weave_contract_claims_v1(module_ids: Dict<text, bool>,
        forwards: [JoinPoint], contracts: [AspectContractClaimV1]) -> [AspectForwardWeaveClaimV1]:
    var claims: [AspectForwardWeaveClaimV1] = []
    if contracts.len() == 0:
        return claims

    for contract in contracts:
        val claim_path = contract.path
        val advice_fn = contract.advice_fn
        if advice_fn == "":
            continue
        if not module_ids.contains_key(claim_path):
            continue
        val kind = contract.kind
        if kind != "forward" or not join_point_kind_is_measurable(kind):
            continue
        val mode = contract.mode
        if not join_point_mode_is_implemented(mode):
            continue
        val selector = contract.selector
        if selector == "":
            continue
        val matched = join_points_matching(forwards, kind, selector)
        if matched.len() == 0:
            continue
        claims.push(AspectForwardWeaveClaimV1(registry_key: contract.registry_key,
            selector: selector, advice_fn: advice_fn))
    claims

# Operates on the actual complete body inside its caller's lease. This is the
# SAME per-claim rewrite used by the retained claim-major loop below.
pub fn weave_forward_advice_claim_in_module_v1(module_key: text, original: HirModule,
        module_ids: Dict<text, bool>, claim: AspectForwardWeaveClaimV1) -> (HirModule, i64):
    var module = original
    var woven: i64 = 0
    if not module_ids.contains_key(module.path) and not module_ids.contains_key(module.name) and
            not module_ids.contains_key(module_key): return (module, woven)
    for symbol in module.functions.keys():
        val func: HirFunction = module.functions[symbol]
        if func.name != claim.selector: continue
        # Re-read the live body for every claim. A prior rewrite can make it
        # cease to be a pure forwarder; cached original matches are not enough.
        if not join_point_is_forwarder(func): continue
        module.functions[symbol] = HirFunction(..func, body: _weave_body(func.body, claim.advice_fn))
        woven = woven + 1
    (module, woven)

# P4 incremental weave (generic_aop_macro_semantic_cache_plan_2026-10-24 §5.2):
# the immutable pre-advice BASE body of each join point, keyed by its
# join-point body digest (cache_contract/aspect_match_shard_v1
# JoinPointFactV1.base_body_digest). A pointcut/advice change reweaves from
# this base instead of re-lowering or stacking advice on an already-woven body.
# Persistent value: record returns a new store; first recorded body wins.
struct AspectWeaveBaseBodiesV1:
    bodies: Dict<text, HirBlock>

pub fn aspect_weave_base_bodies_new_v1() -> AspectWeaveBaseBodiesV1:
    AspectWeaveBaseBodiesV1(bodies: {})

pub fn aspect_weave_base_record_v1(store: AspectWeaveBaseBodiesV1, body_digest: text,
        base: HirBlock) -> AspectWeaveBaseBodiesV1:
    if store.bodies.contains_key(body_digest): return store
    var bodies: Dict<text, HirBlock> = {}
    for k in store.bodies.keys():
        bodies[k] = store.bodies[k]
    bodies[body_digest] = base
    AspectWeaveBaseBodiesV1(bodies: bodies)

# Rebuild `func` as BASE body + ordered advice. The live-forwarder precondition
# is checked on the base function exactly as the claim weaver does; a missing
# base or a non-forwarder base returns `func` unchanged (existing path owns it).
pub fn aspect_weave_from_base_v1(store: AspectWeaveBaseBodiesV1, body_digest: text,
        func: HirFunction, ordered_advice_fns: [text]) -> HirFunction:
    if not store.bodies.contains_key(body_digest): return func
    val base_func = HirFunction(..func, body: store.bodies[body_digest])
    if not join_point_is_forwarder(base_func): return func
    var body = base_func.body
    var i = ordered_advice_fns.len() - 1
    while i >= 0:
        body = _weave_body(body, ordered_advice_fns[i])
        i = i - 1
    HirFunction(..func, body: body)

fn weave_forward_advice(modules: Dict<text, HirModule>) -> i64:
    var woven: i64 = 0
    if aspect_registry_claim_keys().len() == 0: return woven
    val module_ids = aspect_module_identity_index(modules)
    val claims = aspect_forward_weave_claims_v1(module_ids, forward_join_points(modules))
    for claim in claims:

        # The selector names the forwarder's OWN symbol
        # (join_point_model.forward_join_points sets source_symbol = func.name),
        # so weave every function across the in-scope modules whose name
        # equals the selector -- there can be more than one under the same
        # name in different modules, and all of them are real matched edges.
        for module_key in modules.keys():
            val (module, module_woven) = weave_forward_advice_claim_in_module_v1(
                module_key, modules[module_key], module_ids, claim)
            woven = woven + module_woven
            # `module` is a VALUE COPY read out of `modules` above (Dict<text,
            # HirModule> indexing returns a copy of the struct, not a live
            # reference) -- mutating `module.functions[symbol]` only mutates
            # that copy. Without writing the copy back, every weave is lost:
            # the outer `modules` dict a caller inspects (or a second weave
            # pass re-reads) never observes the rewritten body at all.
            if module_woven > 0:
                modules[module_key] = module
    woven

export weave_forward_advice
export AspectForwardWeaveClaimV1, aspect_forward_weave_claims_v1
export weave_forward_advice_claim_in_module_v1
export aspect_forward_weave_contract_claims_v1
export AspectWeaveBaseBodiesV1, aspect_weave_base_bodies_new_v1
export aspect_weave_base_record_v1, aspect_weave_from_base_v1
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection
