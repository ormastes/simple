# C3 logical join-point model: the taxonomy of join-point kinds, and the
# enumeration of the ones this compilation can actually SEE.
#
# doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md §3 (C3)
# doc/03_plan/compiler/forwarding/
#   zero_cost_layers_c0_c5_staged_implementation_plan_2026-08-07.md (M5 = C3)
#
# The decision half of C3, deliberately split from the fact half exactly the
# way C5 splits `zero_forward_path_gate.spl` (decision) from
# `forward_hop_scan.spl` (facts): everything here is a pure function over
# supplied HIR, so a spec can drive it and a sabotage edit can turn it red.
#
# THE CENTRAL HONESTY RULE OF THIS FILE
# ------------------------------------
# The C3 spec names seven join-point kinds. Exactly ONE of them
# (`forward`) has an emitter on today's tree. For the other six there is no
# producer at all -- `20.hir/hir_forward_decl.spl`'s `logical_join_point_id`,
# which M5 was scoped to target, still has ZERO production consumers
# (`lower_forward_decls` is called only from its own spec; grep-verified
# 2026-08-09, and `forward_hop_scan.spl`'s header records the same finding).
#
# So an unmatched selector on those six kinds means "nothing enumerates this
# kind", NOT "the join point does not exist". Reporting either an assumed
# match (fail-open) or a plain not-found (a wrong reason) would be a lie about
# what was measured. `join_point_kind_is_measurable` marks the difference and
# `aspect_validation.spl` emits a distinct UNMEASURED diagnostic for it.
#
# WHY `forward` IS MEASURABLE WITHOUT M4
# --------------------------------------
# A logical forward edge is, by the plan's own words, "a business-logic-free
# forwarder": a function whose entire body is one delegating call. That shape
# is directly readable from lowered HIR bodies -- the same way C4's
# `effect_validation.spl` reads real loop and copy facts out of real bodies
# rather than waiting for a MIR pass that does not exist. This does not depend
# on `HirForwardDecl` being populated, and when M4 does populate it the two
# enumerations should agree; a disagreement is a real defect, not a tuning
# knob.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*

# ============================================================================
# Kind taxonomy
# ============================================================================

# The seven join-point kinds C3 names, verbatim from the plan:
#   "Aspects target logical edges (`forward(src,dst)`, `layer_view(a,b)`,
#    `scene_commit(kind)`, `render_batch(kind)`, `event_route(owner)`,
#    `fallback(class)`, frame boundary)"
fn join_point_kinds() -> [text]:
    ["forward", "layer_view", "scene_commit", "render_batch", "event_route",
     "fallback", "frame"]

# Kinds that are FORBIDDEN outright, not merely unimplemented:
#   "Never per-pixel/glyph/span/tile join points; hot-path join points only at
#    frame/commit/plan/batch/submit/event-batch/fallback."
#
# These are listed separately from "unknown" so the diagnostic can say WHY. An
# author who writes `@advice(pixel, ...)` has made a design error the plan
# explicitly rules out; telling them "unknown kind" would invite them to go
# looking for the right spelling of a thing that must never exist.
fn join_point_prohibited_kinds() -> [text]:
    ["pixel", "glyph", "span", "tile"]

fn join_point_kind_is_known(kind: text) -> bool:
    join_point_kinds().contains(kind)

fn join_point_kind_is_prohibited(kind: text) -> bool:
    join_point_prohibited_kinds().contains(kind)

# True only for kinds this compilation can actually ENUMERATE. See the header:
# `forward` alone has an emitter today.
#
# Deliberately a whitelist, not a blacklist. A new kind added to
# `join_point_kinds()` without an emitter must default to UNMEASURED; a
# blacklist would default it to "measurable" and silently fail open the moment
# someone extends the taxonomy.
fn join_point_kind_is_measurable(kind: text) -> bool:
    kind == "forward"

# Why a known-but-unmeasurable kind cannot be checked. Surfaced verbatim in the
# diagnostic so the reader learns the blocker, not just the verdict.
fn join_point_unmeasured_reason(kind: text) -> text:
    "no pass emits '" + kind + "' join points on this tree (M4 HirForwardDecl "
        + "has zero production consumers, and M5's scene/batch/event/fallback/"
        + "frame emitters are not built) -- the selector is UNMEASURED, not proven absent"

# ============================================================================
# Weave modes
# ============================================================================
# "Three modes: static weave (zero disabled overhead), startup dynload
#  (immutable AspectPlan before session, tables specialized once), live reload
#  (plan swap at frame boundary, epoch/RCU retirement)."
#
# The staged plan scopes this milestone to "Static-weave mode only for the
# first slice; dynload and live-reload modes are separate follow-on
# milestones, not bundled in." So the other two are RECOGNISED (a typo is
# still a typo) but REJECTED with an explicit not-implemented diagnostic --
# never silently downgraded to static, which would let source claim a
# hot-reloadable aspect and get a frozen one.

fn join_point_modes() -> [text]:
    ["static", "dynload", "live_reload"]

fn join_point_mode_is_known(mode: text) -> bool:
    join_point_modes().contains(mode)

fn join_point_mode_is_implemented(mode: text) -> bool:
    mode == "static"

# ============================================================================
# Fact half: enumerate `forward` join points from real lowered HIR
# ============================================================================

struct JoinPoint:
    kind: text
    # The logical source symbol -- the forwarder's own name. This is what a
    # selector matches on.
    source_symbol: text
    # The logical target the forwarder delegates to ("" when the callee is
    # indirect and carries no name).
    target_symbol: text
    # 1-based, assignment-ordered, stable for a given module set. Mirrors the
    # numbering `hir_forward_lowering.lower_forward_decls` gives
    # `HirForwardDecl.logical_join_point_id`, so the two enumerations can be
    # cross-checked when M4 lands.
    logical_join_point_id: i64

# "not a forwarder at all". Distinct from JOIN_POINT_TARGET_UNKNOWN below.
val JOIN_POINT_NOT_FORWARDER: text = ""

# "a forwarder, but the callee carries no resolvable name" -- an indirect call
# through a closure, function value or trait object.
#
# This sentinel is load-bearing and is why this pair of functions returns text
# rather than an `HirExpr?`: an indirect forwarder is still a REAL logical
# edge, and collapsing it to the same "" as a non-forwarder would silently
# delete join points from the enumeration. (It also keeps this file off the
# `if val`-on-Option path, which miscompiles under AOT on this tree.)
val JOIN_POINT_TARGET_UNKNOWN: text = "?"

# Name of a called symbol, or JOIN_POINT_TARGET_UNKNOWN when it has none.
#
# `Var(symbol)` yields UNKNOWN on purpose: `SymbolId` carries only an integer
# id, so resolving it to a name needs a symbol table this pure function is not
# given. Guessing would put a wrong target on a real edge.
fn join_point_callee_name(callee: HirExpr) -> text:
    match callee.kind:
        case HirExprKind.NamedVar(_, name):
            name
        case HirExprKind.Field(_, field, _):
            field
        case _:
            JOIN_POINT_TARGET_UNKNOWN

fn join_point_expr_is_call(expr: HirExpr) -> bool:
    match expr.kind:
        case HirExprKind.Call(_, _, _):
            true
        case HirExprKind.MethodCall(_, _, _, _):
            true
        case _:
            false

# Target name when `expr` IS a call, else JOIN_POINT_NOT_FORWARDER.
fn join_point_call_target(expr: HirExpr) -> text:
    match expr.kind:
        case HirExprKind.Call(callee, _, _):
            join_point_callee_name(callee)
        case HirExprKind.MethodCall(_, method, _, _):
            method
        case _:
            JOIN_POINT_NOT_FORWARDER

# Delegation target of a body that is a pure forwarder, else
# JOIN_POINT_NOT_FORWARDER.
#
# Three accepted shapes, and no others:
#   1. tail-expression body:   `fn a() -> T: b()`
#   2. single expression stmt: `fn a(): b()`
#   3. single `return` stmt:   `fn a() -> T:\n    return b()`
#
# Anything else -- two statements, a `val` binding, a conditional, a loop -- is
# business LOGIC, not forwarding, and is deliberately NOT a join point. This is
# the fail-CLOSED direction: over-recognising forwarders would make an aspect
# silently attach to a function that does real work, which is exactly the
# "advice observes a thing that isn't there" failure C3 must not have.
fn join_point_forward_target(body: HirBlock) -> text:
    if body.stmts.len() == 0:
        if body.has and join_point_expr_is_call(body.value):
            return join_point_call_target(body.value)
        return JOIN_POINT_NOT_FORWARDER
    if body.stmts.len() != 1 or body.has:
        return JOIN_POINT_NOT_FORWARDER
    # The exact-length guard is the bounds proof for this sole indexed read.
    # Keep it adjacent so future accepted shapes cannot accidentally make the
    # access reachable with an empty statement payload.
    val only: HirStmt = body.stmts[0]
    match only.kind:
        case HirStmtKind.Expr(e):
            val inner: HirExpr = e
            match inner.kind:
                case HirExprKind.Return(value):
                    match value:
                        Some(v):
                            val rv: HirExpr = v
                            if join_point_expr_is_call(rv):
                                return join_point_call_target(rv)
                            JOIN_POINT_NOT_FORWARDER
                        nil:
                            JOIN_POINT_NOT_FORWARDER
                case _:
                    if join_point_expr_is_call(inner):
                        return join_point_call_target(inner)
                    JOIN_POINT_NOT_FORWARDER
        case _:
            JOIN_POINT_NOT_FORWARDER

fn join_point_is_forwarder(func: HirFunction) -> bool:
    join_point_forward_target(func.body) != JOIN_POINT_NOT_FORWARDER

# Every `forward` join point visible in `modules`, in a deterministic order.
#
# Ordering is module-key order then declaration order within a module, so
# `logical_join_point_id` is stable for a given module set -- the stability
# property M5 was scoped to depend on.
fn forward_join_points(modules: Dict<text, HirModule>) -> [JoinPoint]:
    var out: [JoinPoint] = []
    var next_id: i64 = 1
    for module in modules.values():
        for func in module.functions.values():
            val target = join_point_forward_target(func.body)
            if target == JOIN_POINT_NOT_FORWARDER:
                continue
            out = out.push(JoinPoint(
                kind: "forward",
                source_symbol: func.name,
                target_symbol: target,
                logical_join_point_id: next_id))
            next_id = next_id + 1
    out

# Selector match: a selector names the LOGICAL SOURCE of the edge.
#
# Exact match only. No prefix/glob matching, on purpose: a glob that matches
# nothing looks identical to a glob that matches everything at the call site,
# and C3's whole value is knowing precisely which edges an aspect observes.
fn join_points_matching(points: [JoinPoint], kind: text, selector: text) -> [JoinPoint]:
    var out: [JoinPoint] = []
    for p in points:
        # Inspect and publish the iteration payload directly; an intermediate
        # JoinPoint value is an unnecessary aggregate copy.
        if p.kind == kind and p.source_symbol == selector:
            out = out.push(p)
    out

export JoinPoint, JOIN_POINT_NOT_FORWARDER, JOIN_POINT_TARGET_UNKNOWN
export join_point_kinds, join_point_prohibited_kinds
export join_point_kind_is_known, join_point_kind_is_prohibited
export join_point_kind_is_measurable, join_point_unmeasured_reason
export join_point_modes, join_point_mode_is_known, join_point_mode_is_implemented
export join_point_forward_target, join_point_is_forwarder, join_point_call_target
export join_point_expr_is_call, join_point_callee_name
export forward_join_points, join_points_matching
