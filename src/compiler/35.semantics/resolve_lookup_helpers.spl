# Method Resolver Lookup Helpers
#
# Cohesive helpers used by the HIR walk for inferred types, resolved-call
# result lookup, call arguments/defaults, and verification contracts.

use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.resolve.{MethodResolver}

impl MethodResolver:
    me resolve_verification_contract(contract: HirContractBlock?) -> HirContractBlock?:
        if val present_value = contract:
            val present: HirContractBlock = present_value
            var clauses: [HirContractClause] = []
            for clause in present.clauses:
                clauses.push(HirContractClause(
                    kind: clause.kind,
                    predicate: self.resolve_expr(clause.predicate),
                    binding_name: clause.binding_name,
                    span: clause.span
                ))
            return Some(HirContractBlock(clauses: clauses, proof_uses: present.proof_uses, outcome: present.outcome))
        nil

    me attach_inferred_type(expr: HirExpr) -> HirExpr:
        if expr.has_type_ and expr.type_ != nil:
            return expr
        val maybe_inferred = self.infer_expr_type(expr)
        match maybe_inferred:
            case Some(inferred):
                HirExpr(kind: expr.kind, has_type_: true, type_: inferred, span: expr.span)
            case nil:
                expr

    me infer_symbol_value_type(raw_symbol_id: i64, span: Span) -> HirType?:
        # Keep the resolver's native boundary scalar. Passing a value-type
        # SymbolId into a helper is miscompiled on the staged native lane; the
        # SymbolTable owner exposes get_symbol_raw for the same reason.
        if val symbol = self.symbols.get_symbol_raw(raw_symbol_id):
            if symbol.type_ != nil:
                val symbol_type = symbol.type_ ?? HirType(kind: HirTypeKind.Error, span: span)
                return symbol_type
            match symbol.kind:
                case Class | Struct | Enum:
                    return HirType(kind: HirTypeKind.Named(SymbolId(id: raw_symbol_id), []), span: span)
                case _: ()
        nil

    me infer_expr_type(expr: HirExpr) -> HirType?:
        if expr.has_type_ and expr.type_ != nil:
            val known_type = expr.type_ ?? HirType(kind: HirTypeKind.Error, span: expr.span)
            match known_type.kind:
                case Error | Infer(_, _): ()
                case _: return known_type
        match expr.kind:
            case Var(symbol): self.infer_symbol_value_type(symbol.id, expr.span)
            case NamedVar(symbol, _): self.infer_symbol_value_type(symbol.id, expr.span)
            case Call(callee, _, _):
                val callee_type = self.infer_expr_type(callee)
                if val found_type = callee_type:
                    match found_type.kind:
                        case Function(_, return_type, _): return return_type
                        case Named(_, _): return found_type
                        case _: ()
                nil
            case StructLit(type_, _): type_
            case Index(base, _):
                if val base_type = self.infer_expr_type(base):
                    match base_type.kind:
                        case Array(element, _) | Slice(element): return element
                        case Dict(_, value): return value
                        case _: ()
                nil
            case _: nil

    me resolve_call_result_type_raw(raw_symbol_id: i64?, fallback: HirType?) -> HirType?:
        """Use the resolved callee's return type when available."""
        # Keep the payload-enum boundary scalar. Passing MethodResolution into
        # this helper (and then through get_symbol_id()) can lose the adjacent
        # static owner field on staged native builds.
        if val symbol_id = raw_symbol_id:
            if val found_sym = self.symbols.get_symbol_raw(symbol_id):
                if val sym_type = found_sym.type_:
                    match sym_type.kind:
                        case Function(_, ret, _):
                            return ret
                        case _: ()
            return fallback
        return fallback

    me resolve_call_args(args: [HirCallArg]) -> [HirCallArg]:
        """Resolve method calls in call arguments."""
        var resolved: [HirCallArg] = []
        var arg_idx = 0
        while arg_idx < args.len():
            val arg: HirCallArg = args[arg_idx]
            resolved = resolved.push(HirCallArg(
                has_name: arg.has_name,
                name: arg.name,
                value: self.resolve_expr(arg.value),
                span: arg.span
            ))
            arg_idx = arg_idx + 1
        resolved

    me fill_call_defaults(callee: HirExpr, args: [HirCallArg], call_span: Span) -> [HirCallArg]:
        """Fill omitted trailing arguments of a direct function call with the
        callee's declared default values (G50 / M12 item 3b).

        Only direct free-function calls `Var(sym)` whose signature lives in the
        current module's function registry are handled; cross-module callees are
        absent from `module_functions` so the call is returned unchanged (safe
        no-op, never a spurious arity error). Named-argument calls are left
        untouched because trailing positional fill would misalign them.

        Limitation / deferred runtime-verification target: the lookup keys on the
        callee `Var` SymbolId matching the definition's `module.functions` key.
        SymbolId is by-name (`structure SymbolId where name`), so this holds for
        same-module direct calls; a runtime end-to-end check (omitted-arg call
        returns the default, not 0) is deferred to M12 delegation removal, since
        the seed interpreter cannot run the HIR lowering+resolve pipeline."""
        match callee.kind:
            case Var(sym):
                if not self.module_functions.contains_key(sym):
                    return args
                # Trailing positional fill is unsound across named args.
                for a in args:
                    if a.has_name:
                        return args
                val func = self.module_functions[sym]
                val params = func.params
                if args.len() >= params.len():
                    return args
                var filled: [HirCallArg] = args
                var i = args.len()
                while i < params.len():
                    val p = params[i]
                    if p.has_default:
                        filled = filled.push(HirCallArg(
                            has_name: false,
                            name: "",
                            value: self.resolve_expr(p.default),
                            span: call_span
                        ))
                    else:
                        # Arity-error half intentionally omitted (M12 3b). The lean
                        # bridge currently hardcodes `has_default: false`
                        # (_FlatAstBridge/convert_nodes.spl:571/682), so emitting a "too few
                        # arguments" error here would FALSE-FIRE on every valid
                        # omitted-default call. A missing param with no default also
                        # cannot be filled positionally, so stop and leave the call
                        # as-is (pre-existing behavior). Re-enable the arity error
                        # only after the bridge captures has_default faithfully.
                        return filled
                    i = i + 1
                return filled
            case _("indirect/computed callees have no static signature to fill"):
                return args

    me resolve_comp_clause(clause: HirCompClause) -> HirCompClause:
        """Resolve method calls in comprehension clause."""
        val kind = match clause.kind:
            case For(var_, iter):
                HirCompClauseKind.For(var_, self.resolve_expr(iter))
            case If(cond):
                HirCompClauseKind.If(self.resolve_expr(cond))

        HirCompClause(kind: kind, span: clause.span)
