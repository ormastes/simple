# K0-owned source-call fact extraction used by live semantic wiring.
# Standalone directory walking remains in compiler.tools.verify.layer_call_scan.

use std.nogc_sync_mut.io.file_ops.{file_exists}

struct ScannedModuleCalls:
    module_path: text
    callee_modules: [text]

fn _extract_callees(line: text) -> [text]:
    var callees: [text] = []
    var ident = ""
    var i = 0
    while i < line.len():
        val ch = line[i:i + 1]
        val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
        val is_digit = ch >= "0" and ch <= "9"
        if is_alpha or (is_digit and ident != ""):
            ident = ident + ch
        else:
            if ch == "(" and ident != "":
                callees.push(ident)
            ident = ""
        i = i + 1
    callees

fn _trim_import_target(target: text) -> text:
    var end_idx = target.len()
    var i = 0
    while i < target.len():
        val ch = target[i:i + 1]
        if ch == " " or ch == "{" or ch == "(" or ch == ",":
            if i < end_idx:
                end_idx = i
        i = i + 1
    target[0:end_idx]

fn _strip_trailing_dot(target: text) -> text:
    if target.ends_with("."):
        return target[0:target.len() - 1]
    target

fn _import_target_from_line(line: text) -> text:
    val trimmed = line.trim()
    if trimmed == "" or trimmed.starts_with("#"):
        return ""
    if trimmed.starts_with("use lazy "):
        return _strip_trailing_dot(_trim_import_target(trimmed[9:trimmed.len()]))
    if trimmed.starts_with("use "):
        return _strip_trailing_dot(_trim_import_target(trimmed[4:trimmed.len()]))
    if trimmed.starts_with("from "):
        return _strip_trailing_dot(_trim_import_target(trimmed[5:trimmed.len()]))
    ""

fn _imported_symbols(line: text) -> [text]:
    var symbols: [text] = []
    var open_idx = 0 - 1
    var i = 0
    while i < line.len():
        if line[i:i + 1] == "{":
            open_idx = i
        i = i + 1
    if open_idx < 0:
        return symbols
    val inside = line[open_idx + 1:line.len()]
    var close_idx = inside.len()
    var j = 0
    while j < inside.len():
        if inside[j:j + 1] == "}":
            close_idx = j
        j = j + 1
    for part in inside[0:close_idx].split(","):
        val name = part.trim()
        if name != "":
            symbols.push(name)
    symbols

fn _try_candidate(base_no_ext: text) -> text:
    val plain = base_no_ext + ".spl"
    if file_exists(plain):
        return plain
    val package = base_no_ext + "/__init__.spl"
    if file_exists(package):
        return package
    ""

fn _resolve_module_to_path(module: text) -> text:
    if module.starts_with("std."):
        val standard = _try_candidate("src/lib/" + module[4:module.len()].replace(".", "/"))
        if standard != "":
            return standard
    val relative = module.replace(".", "/")
    for root in ["src/lib/", "src/compiler/", "src/"]:
        val candidate = _try_candidate(root + relative)
        if candidate != "":
            return candidate
    ""

fn _local_fn_names(lines: [text]) -> {text: bool}:
    var names: {text: bool} = {}
    for line in lines:
        val trimmed = line.trim()
        if not trimmed.starts_with("fn "):
            continue
        val after_fn = trimmed[3:trimmed.len()]
        var name = ""
        var i = 0
        while i < after_fn.len():
            val ch = after_fn[i:i + 1]
            val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
            val is_digit = ch >= "0" and ch <= "9"
            if is_alpha or (is_digit and name != ""):
                name = name + ch
            else:
                break
            i = i + 1
        if name != "":
            names[name] = true
    names

fn scan_source_calls(path: text, content: text) -> ScannedModuleCalls:
    val lines = content.split("\n")
    var symbol_module: [{text: text}] = []
    for line in lines:
        val target = _import_target_from_line(line)
        if target == "":
            continue
        val resolved = _resolve_module_to_path(target)
        if resolved == "":
            continue
        for symbol in _imported_symbols(line):
            var entry: {text: text} = {}
            entry[symbol] = resolved
            symbol_module.push(entry)

    val local_names = _local_fn_names(lines)
    var callee_modules: [text] = []
    var seen: {text: bool} = {}
    for line in lines:
        for callee in _extract_callees(line):
            if local_names.has(callee):
                continue
            for entry in symbol_module:
                if entry.has(callee):
                    val resolved = entry[callee]
                    if not seen.has(resolved) or not seen[resolved]:
                        seen[resolved] = true
                        callee_modules.push(resolved)
    ScannedModuleCalls(module_path: path, callee_modules: callee_modules)

export ScannedModuleCalls, scan_source_calls
