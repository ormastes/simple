# Method Resolution Pass (UFCS Support)
#
# Resolves method calls using UFCS (Uniform Function Call Syntax) rules:
#   1. Instance method on receiver's type (highest priority)
#   2. Trait method implemented by receiver's type
#   3. Free function where receiver becomes first argument (UFCS)
#
# Example:
#   x.map()  -> InstanceMethod if x's class has map()
#   x.map()  -> TraitMethod if x implements trait with map()
#   x.map()  -> FreeFunction(map) if map(x) exists
#
# This pass runs after type inference to have full type information.
# Resolution strategies are in resolve_strategies.spl

use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.traits.traits.*
use compiler.semantics.resolve_strategies.*
# Keep the MethodResolver extension object in every entry-closure that owns the
# resolver.  Re-exporting it only from semantics.__init__ is insufficient when
# callers import this leaf directly (the bootstrap driver does), which leaves
# the extension calls as unresolved linker symbols.
use compiler.semantics.resolve_lookup_helpers.*
use compiler.hir.hir_types.{HirModule}  # explicit: a glob is not an import-origin for surface projection

# ============================================================================
# Type Compatibility
# ============================================================================

struct TypeChecker:
    """Type compatibility checking for UFCS resolution."""

    fn is_compatible(self, a: HirType, b: HirType) -> bool:
        """Check if type `a` is compatible with type `b` for UFCS.

        For UFCS, we check if the receiver type can be passed as the
        first parameter of a function. This includes:
        - Exact type match
        - Reference compatibility (T matches &T, &mut T)
        - Subtype relationships
        """
        match (a.kind, b.kind):
            # Exact matches
            case (Int(bits_a, signed_a), Int(bits_b, signed_b)):
                bits_a == bits_b and signed_a == signed_b
            case (Float(bits_a), Float(bits_b)):
                bits_a == bits_b
            case (Bool, Bool): true
            case (Char, Char): true
            case (Str, Str): true
            case (Unit, Unit): true

            # Named types (classes, structs, enums)
            case (Named(sym_a, args_a), Named(sym_b, args_b)):
                if sym_a.id != sym_b.id:
                    false
                elif args_a.len() != args_b.len():
                    false
                else:
                    var compatible = true
                    var i = 0
                    while i < args_a.len() and compatible:
                        compatible = self.is_compatible(args_a[i], args_b[i])
                        i = i + 1
                    compatible

            # Reference types - T is compatible with &T and &mut T
            case (_, Ref(inner, _)):
                self.is_compatible(a, inner)

            # Array types
            case (Array(elem_a, _), Array(elem_b, _)):
                self.is_compatible(elem_a, elem_b)

            # Slice types
            case (Slice(elem_a), Slice(elem_b)):
                self.is_compatible(elem_a, elem_b)

            # Optional types
            case (Optional(inner_a), Optional(inner_b)):
                self.is_compatible(inner_a, inner_b)

            # Type parameters - compatible if same name
            case (TypeParam(name_a, _), TypeParam(name_b, _)):
                name_a == name_b

            # Inference variables - always compatible (will be unified)
            case (Infer(_, _), _): true
            case (_, Infer(_, _)): true

            # Default: not compatible
            case _: false

    fn get_type_symbol(ty: HirType) -> SymbolId?:
        """Get the symbol ID for a named type."""
        match ty.kind:
            case Named(sym, _): sym
            case _: nil

    static fn primitive_type_key(kind: HirTypeKind) -> i64?:
        """Stable synthetic key for primitive Self types (i64, f32, bool, ...),
        which carry no SymbolId. `impl Trait for <primitive>` needs SOME key to
        register/look up under in `MethodResolver.trait_impls`; primitives are
        keyed here instead of being silently dropped (see
        doc/08_tracking/bug/primitive_receiver_trait_impl_dispatch_2026-08-07.md,
        Defect B). Distinct per (kind, bits, signedness) so e.g. `impl X for i32`
        and `impl X for i64` never collide."""
        match kind:
            case Int(bits, signed):
                if signed:
                    -1000 - bits
                else:
                    -2000 - bits
            case Float(bits): -3000 - bits
            case Bool: -4001
            case Char: -4002
            case Str: -4003
            case Unit: -4004
            case _: nil

# ============================================================================
# Method Resolver
# ============================================================================

class MethodResolver:
    """Resolves method calls using UFCS rules.

    Walks the HIR and resolves each MethodCall expression by trying:
    1. Instance method on the receiver's type
    2. Trait method implemented by the receiver's type
    3. Free function where receiver becomes first argument

    The resolver modifies the `resolution` field of MethodCall expressions.
    """

    symbols: SymbolTable
    type_checker: TypeChecker
    errors: [ResolveError]
    # Track implemented traits for types (type_id -> [trait_id])
    trait_impls: Dict<i64, [SymbolId]>
    # Enhanced trait solver with generic matching, coherence checking, supertrait resolution
    trait_solver: TraitSolver
    # Symbol of the function currently being resolved; nil outside a function body
    current_fn_sym: SymbolId?
    # Module function registry (SymbolId -> HirFunction), populated at the start of
    # resolve_module. self.symbols is intentionally empty in the resolve pass (see
    # resolve_methods), so call-site default-argument fill must read callee
    # signatures (params + defaults) from here. Empty when constructed standalone.
    module_functions: Dict<SymbolId, HirFunction>
    facet_interfaces: [HirFacetInterfaceDecl] = []
    facet_authority: ManifestSealAuthority? = nil

    static fn new(symbols: SymbolTable) -> MethodResolver:
        MethodResolver(
            symbols: symbols,
            type_checker: TypeChecker(),
            errors: [],
            trait_impls: {},
            trait_solver: TraitSolver.create(),
            current_fn_sym: nil,
            module_functions: {}
        )

    static fn with_trait_solver(symbols: SymbolTable, solver: TraitSolver) -> MethodResolver:
        """Create a MethodResolver with an existing TraitSolver (for integration with type inference)."""
        MethodResolver(
            symbols: symbols,
            type_checker: TypeChecker(),
            errors: [],
            trait_impls: {},
            trait_solver: solver,
            current_fn_sym: nil,
            module_functions: {}
        )

fn create_trait_solver_for_resolution() -> TraitSolver:
    TraitSolver(
        traits: {},
        impls: {},
        impls_by_type: {},
        cache: {},
        obligations: [],
        errors: [],
        assoc_resolver: AssocTypeResolver(
            traits: {},
            impls: {}
        )
    )

fn create_method_resolver(symbols: SymbolTable) -> MethodResolver:
    MethodResolver(
        symbols: symbols,
        type_checker: TypeChecker(),
        errors: [],
        trait_impls: {},
        trait_solver: create_trait_solver_for_resolution(),
        current_fn_sym: nil,
        module_functions: {}
    )

    # ========================================================================
    # Module Resolution
    # ========================================================================

    me resolve_module(module: HirModule, authority: ManifestSealAuthority?) -> HirModule:
        """Resolve all method calls in a module."""
        # Record the module's function registry so call-site default-argument fill
        # can read callee signatures (params + defaults) during expression resolution.
        self.module_functions = module.functions
        self.facet_interfaces = module.facet_interfaces
        self.facet_authority = authority
        # Build trait implementation map from impls
        self.build_trait_impls(module.impls)

        # Resolve functions
        var resolved_functions: Dict<SymbolId, HirFunction> = {}
        for key in module.functions.keys():
            val func = module.functions[key]
            resolved_functions[key] = self.resolve_function(func)

        # Resolve constants
        var resolved_constants: Dict<SymbolId, HirConst> = {}
        for key in module.constants.keys():
            val const_ = module.constants[key]
            resolved_constants[key] = HirConst(
                symbol: const_.symbol,
                name: const_.name,
                type_: const_.type_,
                value: self.resolve_expr(const_.value),
                is_mutable: const_.is_mutable,
                visibility: const_.visibility,
                is_public: const_.visibility.is_public(),
                is_volatile: const_.is_volatile,
                fixed_address: const_.fixed_address,
                span: const_.span
            )

        # Return resolved module
        HirModule(
            name: module.name,
            path: module.path,
            authored_path: module.authored_path,
            imports: module.imports,
            exports: module.exports,
            domain_blocks: module.domain_blocks,
            symbols: module.symbols,
            functions: resolved_functions,
            classes: module.classes,
            structs: module.structs,
            enums: module.enums,
            bitfields: module.bitfields,
            traits: resolved_traits,
            impls: module.impls,
            constants: resolved_constants,
            static_asserts: resolved_asserts,
            aop_advices: module.aop_advices,
            di_bindings: module.di_bindings,
            arch_rules: module.arch_rules,
            mock_decls: module.mock_decls,
            types: module.types,
            extend_enums: module.extend_enums,
            facet_interfaces: resolved_facet_interfaces,
            facet_impls: resolved_facet_impls,
            facet_bindings: module.facet_bindings,
            facet_requirements: module.facet_requirements
        )

    me build_trait_impls(impls: [HirImpl]):
        """Build a map of type -> implemented traits."""
        for impl_ in impls:
            match impl_.trait_:
                case Some(trait_type):
                    match self.type_checker.get_type_symbol(impl_.type_):
                        case Some(type_symbol):
                            if type_symbol == nil:
                                pass
                            else:
                                val type_id = type_symbol.id
                                match self.type_checker.get_type_symbol(trait_type):
                                    case Some(trait_symbol):
                                        if trait_symbol == nil:
                                            pass
                                        else:
                                            if not self.trait_impls[type_id].?:
                                                self.trait_impls[type_id] = []
                                            self.trait_impls[type_id] = self.trait_impls[type_id].push(trait_symbol)
                                    case nil:
                                        pass
                        case nil:
                            # Self type carries no SymbolId — a primitive
                            # (i64, f32, bool, ...). Register under the
                            # synthetic primitive key instead of dropping the
                            # impl (Defect B).
                            if val prim_key = TypeChecker.primitive_type_key(impl_.type_.kind):
                                match TypeChecker.get_type_symbol(trait_type):
                                    case Some(trait_symbol):
                                        if trait_symbol != nil:
                                            if not self.trait_impls[prim_key].?:
                                                self.trait_impls[prim_key] = []
                                            self.trait_impls[prim_key] = self.trait_impls[prim_key].push(trait_symbol)
                                    case nil:
                                        pass
                case nil:
                    pass

    # ========================================================================
    # Function Resolution
    # ========================================================================

    me resolve_function(func: HirFunction) -> HirFunction:
        """Resolve method calls in a function body."""
        self.current_fn_sym = Some(func.symbol)
        var resolved_params: [HirParam] = []
        for param in func.params:
            resolved_params.push(HirParam(
                symbol: param.symbol, name: param.name, type_: param.type_,
                has_default: param.has_default,
                default: if param.has_default: self.resolve_expr(param.default) else: param.default,
                span: param.span, is_mutable: param.is_mutable))
        HirFunction(
            symbol: func.symbol,
            name: func.name,
            type_params: func.type_params,
            params: resolved_params,
            return_type: func.return_type,
            body: self.resolve_block(func.body),
            effects: func.effects,
            visibility: func.visibility,
            is_async: func.is_async,
            is_static: func.is_static,
            is_public: func.visibility.is_public(),
            is_method: func.is_method,
            is_mutable: func.is_mutable,
            is_const: func.is_const,
            is_extern: func.is_extern,
            func_attr: func.func_attr,
            export_attr: func.export_attr,
            driver_manifest_attr: func.driver_manifest_attr,
            has_suspension: func.has_suspension,
            vhdl_metadata: func.vhdl_metadata,
            doc_comment: func.doc_comment,
            span: func.span,
            is_gpu_kernel: func.is_gpu_kernel,
            gpu_target: func.gpu_target,
            gpu_backend_order: func.gpu_backend_order,
            verification_contract: self.resolve_verification_contract(func.verification_contract)
        )

    me resolve_field(field: HirField) -> HirField:
        HirField(
            symbol: field.symbol, name: field.name, type_: field.type_,
            has_default: field.has_default,
            default: if field.has_default: self.resolve_expr(field.default) else: field.default,
            visibility: field.visibility, is_public: field.is_public,
            is_volatile: field.is_volatile, has_bits_attr: field.has_bits_attr,
            bits_width: field.bits_width, has_fixed_address: field.has_fixed_address,
            fixed_address: field.fixed_address, span: field.span)

    # ========================================================================
    # Block and Statement Resolution
    # ========================================================================

    me resolve_block(block: HirBlock) -> HirBlock:
        """Resolve method calls in a block."""
        var resolved_stmts: [HirStmt] = []
        for stmt in block.stmts:
            resolved_stmts = resolved_stmts.push(self.resolve_stmt(stmt))

        var resolved_value = block.value
        if block.has:
            resolved_value = self.resolve_expr(block.value)

        HirBlock(
            stmts: resolved_stmts,
            has: block.has,
            value: resolved_value,
            span: block.span,
            unsafe_caps: block.unsafe_caps
        )

    me resolve_stmt(stmt: HirStmt) -> HirStmt:
        """Resolve method calls in a statement."""
        val kind = match stmt.kind:
            case Expr(expr):
                HirStmtKind.Expr(self.resolve_expr(expr))

            case Let(symbol, type_, init):
                HirStmtKind.Let(symbol, type_, self.resolve_expr(init))

            case Assign(target, op, value):
                HirStmtKind.Assign(
                    self.resolve_expr(target),
                    op,
                    self.resolve_expr(value)
                )

            case Block(block):
                HirStmtKind.Block(self.resolve_block(block))

        HirStmt(kind: kind, span: stmt.span)

    # ========================================================================
    # Expression Resolution
    # ========================================================================

    me resolve_expr(expr: HirExpr) -> HirExpr:
        """Resolve method calls in an expression."""
        var resolved_type = expr.type_
        val kind = match expr.kind:
            # Method calls - the main target
            case MethodCall(receiver, method, call_args, resolution):
                val resolved_receiver = self.resolve_expr(receiver)
                val resolved_args = self.resolve_call_args(args)

                # Check if this is actually a static method call (Type.method())
                val is_static = self.is_static_method_call(resolved_receiver)

                # Only resolve if not already resolved
                val new_resolution = if resolution.is_resolved():
                    resolution
                elif is_static:
                    self.resolve_static_method(resolved_receiver, method, resolved_args)
                else:
                    self.resolve_method(resolved_receiver, method, resolved_args)

                val resolved_method_raw_id: i64? = match new_resolution:
                    case InstanceMethod(_, method_id): method_id.id
                    case TraitMethod(_, method_id): method_id.id
                    case FreeFunction(func_id): func_id.id
                    case StaticMethod(_, method_id): method_id.id
                    case Unresolved: nil

                resolved_type = self.resolve_call_result_type_raw(resolved_method_raw_id, expr.type_)
                HirExprKind.MethodCall(resolved_receiver, method, resolved_args, new_resolution)

            # Regular function calls - resolve arguments, then fill omitted
            # trailing default arguments from the callee signature (G50 / M12-3b).
            case Call(callee, args, type_args):
                val resolved_callee = self.resolve_expr(callee)
                val resolved_args = self.resolve_call_args(args)
                HirExprKind.Call(
                    resolved_callee,
                    self.fill_call_defaults(resolved_callee, resolved_args, expr.span),
                    type_args
                )

            case StaticCall(type_, method, call_args, resolution):
                HirExprKind.StaticCall(
                    type_, method, self.resolve_call_args(call_args), resolution)

            # Literals - no resolution needed
            case IntLit(_, _): expr.kind
            case FloatLit(_, _): expr.kind
            case StringLit(value, interps):
                match interps:
                    case Some(values):
                        var resolved_interps: [HirInterpolation] = []
                        for interp in values:
                            resolved_interps = resolved_interps.push(HirInterpolation(
                                expr: self.resolve_expr(interp.expr),
                                format: interp.format,
                                span: interp.span
                            ))
                        HirExprKind.StringLit(value, Some(resolved_interps))
                    case nil:
                        expr.kind
            case BoolLit(_): expr.kind
            case CharLit(_): expr.kind
            case UnitLit: expr.kind
            case NilLit: expr.kind

            # Variables
            case Var(_): expr.kind
            case NamedVar(symbol, name):
                # Name-preserving variant from hir_lowering that carries the
                # resolved symbol directly. Treat it like `Var` for method-
                # resolution passes so alias/imported identifiers do not hit
                # non-exhaustive match errors.
                HirExprKind.NamedVar(symbol, name)

            # Field access
            case Field(base, field, resolved):
                HirExprKind.Field(self.resolve_expr(base), field, resolved)

            # Index access
            case Index(base, index):
                HirExprKind.Index(self.resolve_expr(base), self.resolve_expr(index))

            case TupleIndex(base, index):
                HirExprKind.TupleIndex(self.resolve_expr(base), index)

            # Collections
            case ArrayLit(elements, type_):
                var resolved: [HirExpr] = []
                for e in elements:
                    resolved = resolved.push(self.resolve_expr(e))
                HirExprKind.ArrayLit(resolved, type_)

            case TupleLit(elements):
                var resolved: [HirExpr] = []
                for e in elements:
                    resolved = resolved.push(self.resolve_expr(e))
                HirExprKind.TupleLit(resolved)

            case SetLit(elements, elem_type):
                var resolved: [HirExpr] = []
                for e in elements:
                    resolved.push(self.resolve_expr(e))
                HirExprKind.SetLit(resolved, elem_type)

            case DictLit(entries, key_type, value_type):
                var resolved: [(HirExpr, HirExpr)] = []
                for (k, v) in entries:
                    resolved = resolved.push((self.resolve_expr(k), self.resolve_expr(v)))
                HirExprKind.DictLit(resolved, key_type, value_type)

            # Optional operations
            case OptionalChain(base, field):
                HirExprKind.OptionalChain(self.resolve_expr(base), field)

            case NullCoalesce(left, right):
                HirExprKind.NullCoalesce(self.resolve_expr(left), self.resolve_expr(right))

            case ExistsCheck(base):
                HirExprKind.ExistsCheck(self.resolve_expr(base))

            case Unwrap(base):
                HirExprKind.Unwrap(self.resolve_expr(base))

            # Operators
            case Binary(op, left, right):
                HirExprKind.Binary(op, self.resolve_expr(left), self.resolve_expr(right))

            case Unary(op, operand):
                HirExprKind.Unary(op, self.resolve_expr(operand))

            # Control flow
            case If(cond, then_, else_):
                val resolved_else = match else_:
                    case Some(block):
                        Some(self.resolve_block(block))
                    case nil:
                        nil
                HirExprKind.If(self.resolve_expr(cond), self.resolve_block(then_), resolved_else)

            case IfChain(arms, else_):
                var resolved_arms: [HirIfArm] = []
                for arm in arms:
                    val typed_arm: HirIfArm = arm
                    resolved_arms.push(HirIfArm(
                        cond: self.resolve_expr(typed_arm.cond),
                        then_: self.resolve_block(typed_arm.then_),
                        span: typed_arm.span
                    ))
                val resolved_else = match else_:
                    case Some(else_block): Some(self.resolve_block(else_block))
                    case nil: nil
                HirExprKind.IfChain(resolved_arms, resolved_else)

            case MatchCase(scrutinee, arms):
                var resolved_arms: [HirMatchArm] = []
                for arm in arms:
                    val resolved_guard = match arm.guard:
                        case Some(guard):
                            Some(self.resolve_expr(guard))
                        case nil:
                            nil
                    resolved_arms = resolved_arms.push(HirMatchArm(
                        pattern: arm.pattern,
                        guard: resolved_guard,
                        body: self.resolve_block(arm.body),
                        span: arm.span
                    ))
                HirExprKind.MatchCase(self.resolve_expr(scrutinee), resolved_arms)

            case Loop(body, label):
                HirExprKind.Loop(self.resolve_block(body), label)

            case While(cond, body, label):
                HirExprKind.While(self.resolve_expr(cond), self.resolve_block(body), label)

            case For(var_, iter, body, label):
                HirExprKind.For(var_, self.resolve_expr(iter), self.resolve_block(body), label)

            case With(items, body):
                var resolved_items: [HirWithItem] = []
                for item in items:
                    resolved_items.push(HirWithItem(
                        context_expr: self.resolve_expr(item.context_expr),
                        has_target: item.has_target, target: item.target, span: item.span))
                HirExprKind.With(resolved_items, self.resolve_block(body))

            # Closures
            case Lambda(params, body, captures):
                HirExprKind.Lambda(params, self.resolve_expr(body), captures)

            case Block(block):
                HirExprKind.Block(self.resolve_block(block))

            case HostGpuLane(lane_code, payload_size, marker, body):
                HirExprKind.HostGpuLane(
                    lane_code,
                    payload_size,
                    self.resolve_expr(marker),
                    self.resolve_block(body)
                )

            # Control transfer
            case Return(value):
                val resolved_value = if value.?: Some(self.resolve_expr(value.unwrap())) else: nil
                HirExprKind.Return(resolved_value)

            case Break(label, value):
                val resolved_value = match value:
                    case Some(expr_):
                        Some(self.resolve_expr(expr_))
                    case nil:
                        nil
                HirExprKind.Break(label, resolved_value)

            case Continue(label):
                HirExprKind.Continue(label)

            case Throw(value):
                HirExprKind.Throw(self.resolve_expr(value))

            case Try(e):
                HirExprKind.Try(self.resolve_expr(e))

            # Async
            case Await(e):
                HirExprKind.Await(self.resolve_expr(e))

            case Yield(value):
                val resolved_value = match value:
                    case Some(expr_):
                        Some(self.resolve_expr(expr_))
                    case nil:
                        nil
                HirExprKind.Yield(resolved_value)

            # Construction
            case StructLit(type_, fields):
                var resolved_fields: [(text, HirExpr)] = []
                for (name, value) in fields:
                    resolved_fields = resolved_fields.push((name, self.resolve_expr(value)))
                HirExprKind.StructLit(type_, resolved_fields)

            case EnumLit(type_, variant, payload):
                val resolved_payload = match payload:
                    case Some(value):
                        match value:
                            case Tuple(values):
                                var resolved: [HirExpr] = []
                                for v in values:
                                    resolved = resolved.push(self.resolve_expr(v))
                                Some(HirEnumPayload.Tuple(resolved))
                            case Struct(fields):
                                var resolved: [(text, HirExpr)] = []
                                for (name, value) in fields:
                                    resolved = resolved.push((name, self.resolve_expr(value)))
                                Some(HirEnumPayload.Struct(resolved))
                    case nil:
                        nil
                HirExprKind.EnumLit(type_, variant, resolved_payload)

            # Casts
            case Cast(e, target):
                HirExprKind.Cast(self.resolve_expr(e), target)

            case As(e, target):
                HirExprKind.As(self.resolve_expr(e), target)

            # Range
            case Range(start, end, inclusive, step):
                val resolved_start = match start:
                    case Some(expr_):
                        Some(self.resolve_expr(expr_))
                    case nil:
                        nil
                val resolved_end = match end:
                    case Some(expr_):
                        Some(self.resolve_expr(expr_))
                    case nil:
                        nil
                val resolved_step = match step:
                    case Some(expr_):
                        Some(self.resolve_expr(expr_))
                    case nil:
                        nil
                HirExprKind.Range(resolved_start, resolved_end, inclusive, resolved_step)

            # Comprehension
            case Comprehension(kind, e, clauses):
                var resolved_clauses: [HirCompClause] = []
                for clause in clauses:
                    resolved_clauses = resolved_clauses.push(self.resolve_comp_clause(clause))
                HirExprKind.Comprehension(kind, self.resolve_expr(e), resolved_clauses)

            # Custom blocks (pass through - no method resolution needed)
            case CustomBlock(kind, value):
                HirExprKind.CustomBlock(kind, value)

            # Math/DL blocks (resolve expressions in body)
            case LossBlock(body):
                HirExprKind.LossBlock(self.resolve_block(body))

            case NogradBlock(body):
                HirExprKind.NogradBlock(self.resolve_block(body))

            case UnsafeBlock(body):
                HirExprKind.UnsafeBlock(self.resolve_block(body))

            case InlineAsm(asm_node):
                HirExprKind.InlineAsm(self.resolve_asm(asm_node))

            case InlineAsmMatch(arms):
                var resolved_arms: [HirAsmMatchArm] = []
                for arm in arms:
                    var resolved_arm = arm
                    if arm.has_asm_body:
                        resolved_arm.asm_body = self.resolve_asm(arm.asm_body)
                    resolved_arms.push(resolved_arm)
                HirExprKind.InlineAsmMatch(resolved_arms)

            case TypeTest(value, type_name):
                HirExprKind.TypeTest(self.resolve_expr(value), type_name)

            case FacetAcquire(receiver, interface_type, _, _, mode):
                val resolved_receiver = self.resolve_expr(receiver)
                val interface_id = facet_sealed_interface_id(interface_type, self.facet_interfaces)
                if interface_id == nil:
                    self.errors.push(ResolveError(
                        message: "E-FACET002: facet acquisition type argument is not a sealed facet interface",
                        span: expr.span))
                    expr.kind
                else:
                    var sealed_hint: ConcreteTypeId? = nil
                    match mode:
                        case HirFacetAcquireMode.TryResident: pass
                        case _:
                            if not resolved_receiver.has_type_ or self.facet_authority == nil:
                                self.errors.push(ResolveError(
                                    message: "E-FACET003: facet receiver has no authenticated concrete type identity",
                                    span: expr.span))
                            else:
                                sealed_hint = facet_static_concrete_type_id_v1(
                                    resolved_receiver.type_, self.facet_authority.unwrap())
                                if sealed_hint == nil:
                                    self.errors.push(ResolveError(
                                        message: "E-FACET003: facet receiver concrete type identity is unresolved",
                                        span: expr.span))
                    HirExprKind.FacetAcquire(
                        resolved_receiver, interface_type, interface_id.unwrap(), sealed_hint, mode)

            # Error
            case Error: expr.kind

        HirExpr(kind: kind, has_type_: expr.has_type_, type_: resolved_type, span: expr.span)

    # ========================================================================
    # Method Resolution Logic (UFCS)
    # ========================================================================


# ============================================================================
# Resolution Errors
# ============================================================================

struct ResolveError:
    """Error during method resolution."""
    message: text
    span: Span

impl ResolveError:
    fn to_string() -> text:
        "resolve error at {self.span}: {self.message}"

# ============================================================================
# Public API
# ============================================================================

fn resolve_methods(module: HirModule,
        authority: ManifestSealAuthority? = nil) -> (HirModule, [ResolveError]):
    """Resolve all method calls in a module.

    This is the main entry point for the resolution pass.
    Returns the resolved module and any errors encountered.
    """
    # Phase 9 follow-up (2026-04-18): unstub by creating a fresh empty
    # SymbolTable. MethodResolver.try_method finds no instance methods
    # in the empty table, falls through to try_ufcs (free-function
    # dispatch with receiver as first arg). This is exactly what UI
    # phases 3-6 need so duplicate with_*/method definitions can be
    # collapsed eventually. See doc/05_design/compiler_rfc_ufcs.md.
    val symbols = SymbolTable.new()
    val resolver = create_method_resolver(symbols)
    val resolved = resolver.resolve_module(module)
    (resolved, resolver.errors)

fn resolve_methods_with_solver(module: HirModule, solver: TraitSolver,
        authority: ManifestSealAuthority? = nil) -> (HirModule, [ResolveError]):
    """Resolve all method calls in a module using an existing TraitSolver.

    This variant allows integration with type inference, where the TraitSolver
    has already been populated with trait definitions, impl blocks, and has
    checked trait obligations.

    Use this when:
    - Type inference has already run and created a TraitSolver
    - You want to use enhanced generic type matching for method resolution
    - You need trait bound checking during method resolution
    """
    # Until solver-aware facet lookup is implemented, route through the same
    # mandatory seal/sentinel gate.  Never let this compatibility entrypoint
    # bypass facet admission.
    resolve_methods(module, authority)
