# Stub Implementation Lint
#
# Detects functions with trivial/dummy implementations that may be
# unintentional stubs — bodies returning bare literals without using params.
#
# STUB001: Function with params returns trivial value (params unused)   WARNING
# STUB002: Zero-param function returns default value (possible stub)    INFO
# STUB003: Function body is an explicit placeholder marker              ERROR
#          (also covers an empty concrete body under the `critical`
#          assurance profile — see `_empty_body_is_error`, WP-8)
#
# Trivial "default" values: 0, "", false, nil, [], {}, (), Ok(nil)
#
# Does NOT flag:
# - extern fn declarations (no body)
# - Single-expression constant functions returning non-default literals
#   e.g. fn method_get() -> text: "GET"  or  fn API_KEY() -> i64: 3
# - Functions whose body satisfies the typed NoOp contract (WP-8, aerospace
#   hardening plan): exactly one `pass_do_nothing("non-empty reason")` call.
#   This is the ONLY exemption tied to intent — there is no name-based
#   exemption (`_noop_` prefix) and no "contains a pass marker anywhere"
#   exemption anymore. A function named `_noop_x` and one named
#   `helper_noop_x` are treated IDENTICALLY: both are flagged unless their
#   body is the typed NoOp contract. See `_is_noop_contract_body` below and
#   flight_rules.spl's placeholder list ("a `_noop_` name without a typed
#   NoOp contract" is itself a placeholder).
# - A lone bare `pass` (tag 35) as the WHOLE body — unchanged, out of this
#   WP's scope (see `_is_bare_pass_body`).
#
# Works with the arena-based core AST (integer-tagged nodes).

use compiler.core.ast_expr.{
    expr_get_tag, expr_get_int, expr_get_str, expr_get_left, expr_get_right,
    expr_get_args, expr_get_stmts
}
use compiler.frontend.core.ast_stmt.{
    stmt_get_tag, stmt_get_expr, stmt_get_body
}
use compiler.core.ast.{
    decl_get_tag, decl_get_name, decl_get_param_names, decl_get_body,
    decl_get_span, span_is_valid, span_line
}
use std.string_core.{char_code}
use compiler.common.assurance.policy.{strictness_for_profile_name}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}

# WP-8 (aerospace hardening plan, doc/03_plan/language/assurance/
# aerospace_hardening_plan_2026-08-07.md): an empty concrete function body
# used to be silently skipped under EVERY profile — see the removed skip in
# check_stub_impl. flight_rules.spl lists "an empty body" among the explicit
# placeholder shapes, so under `critical` it must be a hard error instead of
# invisible. Severity is routed through the WP-3 canonical policy resolver
# (strictness_for_profile_name) rather than a hardcoded string compare, same
# pattern as use_resolution.spl's `_w0407_severity`.
fn _empty_body_is_error(profile_name: text) -> bool:
    strictness_for_profile_name(profile_name).at_least(AssuranceStrictness.Critical)

fn stub_expr_get_tag(idx: i64) -> i64:
    expr_get_tag(idx)

fn stub_expr_get_int(idx: i64) -> i64:
    expr_get_int(idx)

fn stub_expr_get_str(idx: i64) -> text:
    expr_get_str(idx)

fn stub_expr_get_left(idx: i64) -> i64:
    expr_get_left(idx)

fn stub_expr_get_right(idx: i64) -> i64:
    expr_get_right(idx)

fn stub_expr_get_args(idx: i64) -> [i64]:
    expr_get_args(idx)

fn stub_expr_get_stmts(idx: i64) -> [i64]:
    expr_get_stmts(idx)

fn stub_stmt_get_tag(idx: i64) -> i64:
    stmt_get_tag(idx)

fn stub_stmt_get_expr(idx: i64) -> i64:
    stmt_get_expr(idx)

fn stub_stmt_get_body(idx: i64) -> [i64]:
    stmt_get_body(idx)

fn stub_decl_get_tag(idx: i64) -> i64:
    # Routed through the owning module's accessor (compiler.core.ast.decl_get_tag)
    # rather than reading the imported `decl_tag` array directly — a direct
    # cross-module read of the raw arena var is stale/empty under this
    # interpreter (see lint_pipeline_array_index_out_of_bounds_2026-07-30.md).
    decl_get_tag(idx)

fn stub_decl_get_name(idx: i64) -> text:
    decl_get_name(idx)

fn stub_decl_get_param_names(idx: i64) -> [text]:
    decl_get_param_names(idx)

fn stub_decl_get_body(idx: i64) -> [i64]:
    decl_get_body(idx)

# ============================================================================
# Warning Struct
# ============================================================================

struct StubImplWarning:
    code: text
    severity: text
    message: text
    hint: text
    fn_name: text
    line: i64 = 0

    fn fmt() -> text:
        "[" + self.code + "] " + self.severity + ": " + self.message + " in '" + self.fn_name + "' — " + self.hint

fn int_to_str(n: i64) -> text:
    if n == 0:
        return "0"
    var neg = false
    var v = n
    if n < 0:
        neg = true
        v = 0 - n
    # Collect digits least-significant-first into an array and join once
    # (rather than `result = ch + result` per digit) to avoid an O(n^2)
    # string-concat-in-loop (lint COLL006).
    var digits: [text] = []
    for _ in 0..20:
        if v == 0:
            break
        val d = v % 10
        var ch = "0"
        if d == 1: ch = "1"
        if d == 2: ch = "2"
        if d == 3: ch = "3"
        if d == 4: ch = "4"
        if d == 5: ch = "5"
        if d == 6: ch = "6"
        if d == 7: ch = "7"
        if d == 8: ch = "8"
        if d == 9: ch = "9"
        digits.push(ch)
        v = v / 10
    var reversed: [text] = []
    var i = digits.len() - 1
    while i >= 0:
        reversed.push(digits[i])
        i = i - 1
    val result = reversed.join("")
    if neg:
        return "-" + result
    result

# ============================================================================
# Main Entry Point
# ============================================================================

fn check_stub_impl(decl_indices: [i64], profile_name: text = "") -> [StubImplWarning]:
    """Run stub-implementation lint on module declarations.

    For each function, checks whether its body is a single trivial expression
    (a bare literal like 0, "", false, nil, [], (), or a return of one).
    If the function has parameters that are never referenced in the body,
    emits STUB001 (WARNING). If the function has no parameters but returns
    a default value, emits STUB002 (INFO).

    `profile_name` is the resolved assurance-profile name (e.g. "critical",
    "" for the permissive default). It currently decides only whether an
    empty concrete body is promoted from silently-skipped to STUB003 ERROR
    (WP-8); default "" preserves the pre-WP-8 behavior for every existing
    call site that has not been wired to a real resolved profile yet.
    """
    var warnings: [StubImplWarning] = []

    for idx in decl_indices:
        val tag = stub_decl_get_tag(idx)

        # Skip non-function and extern declarations
        if tag != 1:
            continue

        val fn_name = stub_decl_get_name(idx)
        val params = stub_decl_get_param_names(idx)
        val body = stub_decl_get_body(idx)
        val decl_span = decl_get_span(idx)
        val warning_line = if span_is_valid(decl_span): span_line(decl_span) else: 0

        # WP-8: name-based exemption removed. The ONLY intent-based exemption
        # is the typed NoOp contract — a body that is exactly one
        # `pass_do_nothing("non-empty reason")` call. `_noop_x` and
        # `helper_noop_x` are therefore treated identically: both fall
        # through to ordinary trivial-value analysis below unless their body
        # satisfies the contract.
        if _is_noop_contract_body(body):
            continue

        # An empty body (no statements at all) used to be silently skipped
        # under every profile. Under `critical` it is promoted to a hard
        # STUB003 error instead of being invisible; every other profile keeps
        # the historical silent skip (see `_empty_body_is_error`).
        if body.len() == 0:
            if _empty_body_is_error(profile_name):
                warnings.push(StubImplWarning(
                    code: "STUB003",
                    severity: "ERROR",
                    message: "empty function body (no statements) — no implementation present",
                    hint: "implement the function, or if it is intentionally a permanent no-op use a single pass_do_nothing(\"reason\") body",
                    fn_name: fn_name,
                    line: warning_line
                ))
            continue

        # Whole-body explicit placeholder markers (pass_todo / pass_dn /
        # pass_do_nothing with no reason) are hard failures. A
        # pass_do_nothing body WITH a reason never reaches this point — it
        # was already exempted above by `_is_noop_contract_body`.
        val placeholder_expr = get_single_placeholder_expr(body)
        if placeholder_expr >= 0:
            warnings.push(StubImplWarning(
                code: "STUB003",
                severity: "ERROR",
                message: "explicit placeholder function body",
                hint: "replace the placeholder body with a real implementation or mark the function with an allow override",
                fn_name: fn_name,
                line: warning_line
            ))
            continue

        # WP-8: the old "body contains a pass marker ANYWHERE" skip was
        # removed — it silently exempted any function whose body merely
        # MENTIONED `pass`/`pass_todo`/`pass_do_nothing`/`pass_dn` somewhere
        # (e.g. buried in a nested branch), not just a body that WAS one.
        # What remains is narrower and scoped only to the WHOLE body: a lone
        # bare `pass` (tag 35, carrying no message) as the entire function
        # body keeps its pre-WP-8 silent-skip treatment — this is unchanged,
        # out-of-scope behavior for this WP, not a new exemption; everything
        # else (pass_todo/pass_dn/unexplained pass_do_nothing -> STUB003
        # above, explained pass_do_nothing -> the typed NoOp contract above)
        # IS scoped by WP-8. `body_has_pass_marker`/`stmt_has_pass_marker`/
        # `expr_has_pass_marker` stay defined and exported below — they are
        # exercised directly by their own spec coverage, independent of this
        # lint's exemption path now.
        if _is_bare_pass_body(body):
            continue

        # Extract the single effective expression from the body
        val trivial_expr = get_single_trivial_expr(body)
        if trivial_expr < 0:
            continue

        # Determine what kind of trivial value it is
        val trivial_kind = classify_trivial(trivial_expr)
        if trivial_kind == "":
            continue

        # Now decide severity based on parameter usage
        if params.len() > 0:
            # Has parameters — check if any are used in body
            if not body_references_any_param(body, params):
                val param_count = int_to_str(params.len())
                warnings.push(StubImplWarning(
                    code: "STUB001",
                    severity: "WARNING",
                    message: "trivial " + trivial_kind + " return with " + param_count + " unused param(s)",
                    # WP-8 self-trigger fix: this hint used to recommend
                    # `pass_todo` as the fix. `pass_todo` is itself an
                    # explicit placeholder marker (STUB003, see
                    # get_single_placeholder_expr) — a function that follows
                    # this hint literally by making its whole body
                    # `pass_todo("...")` immediately re-triggers STUB003. The
                    # hint now recommends `pass_do_nothing`, the typed NoOp
                    # contract (`_is_noop_contract_body`), which is EXEMPT
                    # rather than a placeholder, so following it cannot
                    # self-trigger.
                    hint: "body is just '" + trivial_kind + "' — implement it, or if intentionally a permanent no-op use a single pass_do_nothing(\"reason\") body (not pass_todo, which is itself flagged as STUB003)",
                    fn_name: fn_name,
                    line: warning_line
                ))
        else:
            # No parameters — only flag default values, not meaningful constants
            if is_default_value(trivial_expr):
                warnings.push(StubImplWarning(
                    code: "STUB002",
                    severity: "INFO",
                    message: "trivial default " + trivial_kind + " return (possible stub)",
                    hint: "if intentional, mark with pass_do_nothing; if stub, use pass_todo",
                    fn_name: fn_name,
                    line: warning_line
                ))

    warnings

# ============================================================================
# Body Analysis: Extract Single Trivial Expression
# ============================================================================

fn get_single_trivial_expr(stmts: [i64]) -> i64:
    """If the body is a single statement containing a trivial expression,
    return that expression index. Otherwise return -1.

    Handles:
    - Single 1 with a bare literal (implicit return)
    - Single 1 with 19 wrapping a literal (explicit return)
    - Single 5 with a literal
    """
    if stmts.len() != 1:
        return -1

    val s = stmts[0]
    if s < 0:
        return -1

    val tag = stub_stmt_get_tag(s)

    if tag == 1:
        val e = stub_stmt_get_expr(s)
        if e < 0:
            return -1
        # Check for explicit return: 19 wrapping a literal
        if stub_expr_get_tag(e) == 19:
            val inner = stub_expr_get_left(e)
            if inner >= 0:
                return inner
            return -1
        # Bare expression (implicit return)
        return e

    if tag == 5:
        val e = stub_stmt_get_expr(s)
        if e >= 0:
            return e
        return -1

    -1

fn get_single_placeholder_expr(stmts: [i64]) -> i64:
    """Return the placeholder expression if the whole function body is only a
    single explicit placeholder marker: `pass_todo`, `pass_dn`, or a
    `pass_do_nothing` call with NO reason. Otherwise return -1.

    A `pass_do_nothing("non-empty reason")` body is deliberately NOT included
    here — it is the typed NoOp contract (`_is_noop_contract_body`) and is
    exempted earlier in `check_stub_impl`, before this function is ever
    reached for that body. But a bare `pass_do_nothing()` / `pass_do_nothing`
    with an EMPTY reason carries none of the contract's evidence (no reason
    was ever recorded — the parser's REQC001 check for this is only a warn,
    not an error, so it cannot be relied on to block it), so it falls through
    to here and is treated the same as any other unexplained placeholder
    marker. This mirrors the `_noop_`-name rule: an unexplained marker is
    never a contract any more than a bare name is."""
    if stmts.len() != 1:
        return -1

    val s = stmts[0]
    if s < 0:
        return -1

    val tag = stub_stmt_get_tag(s)
    if tag != 1 and tag != 5:
        return -1

    val e = stub_stmt_get_expr(s)
    if e < 0:
        return -1

    val e_tag = stub_expr_get_tag(e)
    if e_tag == 40 or e_tag == 43:
        return e
    if e_tag == 41 and stub_expr_get_str(e) == "":
        return e

    -1

# ============================================================================
# NoOp Contract (WP-8)
# ============================================================================
#
# The ONLY sanctioned way to mark a function as an intentional, permanent
# no-op is a body that is EXACTLY one `pass_do_nothing("non-empty reason")`
# call. This replaces both the old name-based exemption (`_noop_` prefix) and
# the old "any pass marker anywhere in the body" skip — a name is never a
# contract, and `pass_todo`/`pass_dn`/an unexplained `pass_do_nothing` remain
# explicit placeholders that require a real implementation or a reviewed
# waiver (flight_rules.spl lists all of these, plus a `_noop_` name without
# this contract, as placeholder shapes), not a name or a passing mention deep
# in a larger body.
fn _is_noop_contract_body(body: [i64]) -> bool:
    """True iff `body` is a single statement whose expression is exactly a
    `pass_do_nothing("non-empty reason")` call (tag 41) — the typed NoOp
    contract. A non-empty reason is REQUIRED: `pass_do_nothing()` /
    `pass_do_nothing("")` records no evidence of a deliberate decision and is
    NOT exempt (see `get_single_placeholder_expr`, which flags it instead) —
    an empty message is exactly as insufficient as a bare name."""
    if body.len() != 1:
        return false
    val s = body[0]
    if s < 0:
        return false
    val tag = stub_stmt_get_tag(s)
    if tag != 1 and tag != 5:
        return false
    val e = stub_stmt_get_expr(s)
    if e < 0:
        return false
    if stub_expr_get_tag(e) != 41:
        return false
    stub_expr_get_str(e) != ""

# A lone bare `pass` (tag 35) as the WHOLE function body — not a typed
# contract, just the historical (pre-WP-8, and still out of this WP's scope)
# "this is deliberately empty" shorthand. Narrower than the removed
# `body_has_pass_marker` skip: only fires when `pass` IS the entire body, not
# when it merely appears somewhere inside a larger one.
fn _is_bare_pass_body(body: [i64]) -> bool:
    if body.len() != 1:
        return false
    val s = body[0]
    if s < 0:
        return false
    val tag = stub_stmt_get_tag(s)
    if tag != 1 and tag != 5:
        return false
    val e = stub_stmt_get_expr(s)
    if e < 0:
        return false
    stub_expr_get_tag(e) == 35

# ============================================================================
# Trivial Expression Classification
# ============================================================================

fn classify_trivial(e: i64) -> text:
    """Classify an expression as a trivial literal. Returns a human-readable
    description of the trivial kind, or "" if not trivial."""
    if e < 0:
        return ""

    val tag = stub_expr_get_tag(e)

    if tag == 1:
        return "integer (" + int_to_str(stub_expr_get_int(e)) + ")"

    if tag == 2:
        return "float (" + stub_expr_get_str(e) + ")"

    if tag == 3:
        val s = stub_expr_get_str(e)
        if s == "":
            return "empty string (\"\")"
        return "string (\"" + s + "\")"

    if tag == 4:
        if stub_expr_get_int(e) == 0:
            return "false"
        return "true"

    if tag == 5:
        return "nil"

    if tag == 13:
        if stub_expr_get_args(e).len() == 0:
            return "empty array ([])"
        return ""

    if tag == 25:
        if stub_expr_get_args(e).len() == 0:
            return "empty dict ({})"
        return ""

    if tag == 33:
        return "unit (())"

    if tag == 28:
        if stub_expr_get_args(e).len() == 0:
            return "unit (())"
        return ""

    # Ok(nil) or Ok(0) pattern — 9 with callee "Ok" and single trivial arg
    if tag == 9:
        val callee = stub_expr_get_left(e)
        if callee >= 0 and stub_expr_get_tag(callee) == 6:
            if stub_expr_get_str(callee) == "Ok":
                val call_args = stub_expr_get_args(e)
                if call_args.len() == 1:
                    val inner = call_args[0]
                    if inner >= 0:
                        val inner_kind = classify_trivial(inner)
                        if inner_kind != "":
                            return "Ok(" + inner_kind + ")"

    # pass (without todo/do_nothing) — treated as trivial
    if tag == 35:
        return "pass"

    ""

fn is_default_value(e: i64) -> bool:
    """Check if expression is a "zero/default value" for its type.
    Used for STUB002 — zero-param functions returning defaults.

    Default values: 0, 0.0, "", false, nil, [], {}, (), pass
    NOT default: non-zero int, non-empty string, true (these are constants).
    """
    if e < 0:
        return false

    val tag = stub_expr_get_tag(e)

    if tag == 1:
        return stub_expr_get_int(e) == 0

    if tag == 2:
        val f = stub_expr_get_str(e)
        return f == "0" or f == "0.0" or f == "0.00"

    if tag == 3:
        return stub_expr_get_str(e) == ""

    if tag == 4:
        return stub_expr_get_int(e) == 0  # false

    if tag == 5:
        return true

    if tag == 13:
        return stub_expr_get_args(e).len() == 0

    if tag == 25:
        return stub_expr_get_args(e).len() == 0

    if tag == 33:
        return true

    if tag == 28:
        return stub_expr_get_args(e).len() == 0

    if tag == 35:
        return true

    # Ok(nil) or Ok(default)
    if tag == 9:
        val callee = stub_expr_get_left(e)
        if callee >= 0 and stub_expr_get_tag(callee) == 6:
            if stub_expr_get_str(callee) == "Ok":
                val call_args = stub_expr_get_args(e)
                if call_args.len() == 1:
                    return is_default_value(call_args[0])

    false

# ============================================================================
# Pass Marker Detection
# ============================================================================

fn body_has_pass_marker(stmts: [i64]) -> bool:
    """Check if any statement in the body contains pass, pass_todo,
    pass_do_nothing, or pass_dn. If so, the function is already marked and
    should not be flagged by STUB001/STUB002."""
    for s in stmts:
        if s < 0:
            continue
        if stmt_has_pass_marker(s):
            return true
    false

fn stmt_has_pass_marker(s: i64) -> bool:
    """Check if a statement or its children contain a pass marker."""
    if s < 0:
        return false

    val tag = stub_stmt_get_tag(s)

    # Check the expression in this statement
    val e = stub_stmt_get_expr(s)
    if e >= 0:
        if expr_has_pass_marker(e):
            return true

    # Recurse into child statements
    val children = stub_stmt_get_body(s)
    for child in children:
        if stmt_has_pass_marker(child):
            return true

    false

fn expr_has_pass_marker(e: i64) -> bool:
    """Check if an expression is or contains a pass marker."""
    if e < 0:
        return false

    val tag = stub_expr_get_tag(e)

    if tag == 35:
        return true
    if tag == 40:
        return true
    if tag == 41:
        return true
    if tag == 43:
        return true

    # Recurse into sub-expressions
    if expr_has_pass_marker(stub_expr_get_left(e)):
        return true
    if expr_has_pass_marker(stub_expr_get_right(e)):
        return true

    for arg in stub_expr_get_args(e):
        if expr_has_pass_marker(arg):
            return true

    for child_stmt in stub_expr_get_stmts(e):
        if stmt_has_pass_marker(child_stmt):
            return true

    false

# ============================================================================
# Parameter Usage Detection
# ============================================================================

fn stub_is_ident_char(ch: text) -> bool:
    """Check if a single character is valid inside an identifier token."""
    if ch.len() != 1:
        return false
    val c = char_code(ch)
    if c >= 97 and c <= 122:  # a-z
        return true
    if c >= 65 and c <= 90:  # A-Z
        return true
    if c >= 48 and c <= 57:  # 0-9
        return true
    if c == 95:  # _
        return true
    false

fn interpolation_hole_references_param(hole: text, params: [text]) -> bool:
    """Check whether any identifier token inside an interpolation hole's raw
    text (e.g. "a + b.c()" from "{a + b.c()}") matches a parameter name.

    This is a textual token scan rather than a real sub-parse: it splits the
    hole on non-identifier characters and compares each run against the
    parameter names. Good enough to answer "is this param referenced",
    including compound holes like `{a + b}` where both `a` and `b` matter.
    """
    var i = 0
    val n = hole.len()
    var start = -1
    while i < n:
        val ch = hole.slice(i, i + 1)
        if stub_is_ident_char(ch):
            if start < 0:
                start = i
        else:
            if start >= 0:
                val ident = hole.slice(start, i)
                for p in params:
                    if ident == p:
                        return true
                start = -1
        i = i + 1
    if start >= 0:
        val ident = hole.slice(start, n)
        for p in params:
            if ident == p:
                return true
    false

fn string_lit_references_param(s: text, params: [text]) -> bool:
    """Scan a string literal's raw template text for `{...}` interpolation
    holes and check whether any of them reference a parameter name.

    Handles escaped braces (`{{` / `}}` render as literal `{` / `}`, not a
    hole) and holes containing nested braces (brace-depth tracked so e.g.
    `{a.f({x: 1})}` closes at the matching outer `}`).
    """
    if params.len() == 0:
        return false
    var i = 0
    val n = s.len()
    while i < n:
        val ch = s.slice(i, i + 1)
        if ch == "{":
            if i + 1 < n and s.slice(i + 1, i + 2) == "{":
                i = i + 2
                continue
            # Start of an interpolation hole — scan to the matching close,
            # tracking nested brace depth, then slice the hole text out in
            # one shot (no per-character concatenation).
            var depth = 1
            val hole_start = i + 1
            var j = hole_start
            while j < n and depth > 0:
                val jch = s.slice(j, j + 1)
                if jch == "{":
                    depth = depth + 1
                elif jch == "}":
                    depth = depth - 1
                j = j + 1
            var hole_end = j
            if depth == 0:
                hole_end = j - 1  # exclude the matched closing brace
            val hole = s.slice(hole_start, hole_end)
            if interpolation_hole_references_param(hole, params):
                return true
            i = j
            continue
        if ch == "}":
            if i + 1 < n and s.slice(i + 1, i + 2) == "}":
                i = i + 2
                continue
        i = i + 1
    false

fn body_references_any_param(stmts: [i64], params: [text]) -> bool:
    """Check if any statement in the body references any of the given parameter names."""
    for s in stmts:
        if s < 0:
            continue
        if stmt_references_param(s, params):
            return true
    false

fn stmt_references_param(s: i64, params: [text]) -> bool:
    """Check if a statement references any parameter name."""
    if s < 0:
        return false

    val tag = stub_stmt_get_tag(s)

    # Check expression
    val e = stub_stmt_get_expr(s)
    if e >= 0:
        if expr_references_param(e, params):
            return true

    # Check statement name (e.g. val x = ... where x shadows a param — still a reference)
    # Actually, we don't count shadowing as usage.

    # Recurse into child statements
    for child in stub_stmt_get_body(s):
        if stmt_references_param(child, params):
            return true

    false

fn expr_references_param(e: i64, params: [text]) -> bool:
    """Check if an expression references any parameter name via 6."""
    if e < 0:
        return false

    val tag = stub_expr_get_tag(e)

    if tag == 6:
        val name = stub_expr_get_str(e)
        for p in params:
            if name == p:
                return true
        return false

    # String literal: params referenced only inside `{...}` interpolation
    # holes are otherwise invisible to this walk (the raw template text is
    # stored verbatim, unexpanded, in the literal's s_val — see
    # doc/08_tracking/bug/lint_stub001_false_positive_on_string_interpolation_param_2026-07-29.md).
    # Raw strings (i_val == 1, e.g. r"...") never interpolate, so `{...}`
    # inside them is literal text, not a parameter reference.
    if tag == 3:
        if stub_expr_get_int(e) != 1:
            if string_lit_references_param(stub_expr_get_str(e), params):
                return true

    # Recurse into sub-expressions
    if expr_references_param(stub_expr_get_left(e), params):
        return true
    if expr_references_param(stub_expr_get_right(e), params):
        return true

    for arg in stub_expr_get_args(e):
        if expr_references_param(arg, params):
            return true

    for child_stmt in stub_expr_get_stmts(e):
        if stmt_references_param(child_stmt, params):
            return true

    false

