# SPL-BOUND-003: unit erased to its primitive, then reasserted as a DIFFERENT
# unit without validated construction.
#
# `meters.value` (or `.raw()` / `.to_f64()` / `.to_i64()`) erases unit A to a
# bare number; casting that number straight into unit B (`Seconds(x)`) launders
# the dimension. Slice B3 of
# doc/03_plan/release/1.0.0/robust_boundaries_library_units_sffi_backends_plan_2026-11-15.md:
# function-local origin only (unit-typed parameters, `val x = Unit(...)`, plain
# copies and arithmetic on the erased value). Re-casting to the SAME unit A is
# allowed. Helpers returning an erased primitive are summarised (in-file and via
# BoundUnitSummary); the as-cast form is covered too.

use compiler.semantics.lint.lint_text.{code_line_snapshot, CodeLine, lint_is_vendor_path}

pub struct BoundUnitReassertFinding:
    code: text
    message: text
    note: text
    line_num: i64

fn _bur_indent(raw: text) -> i64:
    var i = 0
    while i < raw.byte_len() and raw.substring(i, i + 1) == " ":
        i = i + 1
    i

fn _bur_fn_header(line: text) -> bool:
    var rest = line
    for prefix in ["pub ", "static ", "async ", "unsafe "]:
        if rest.starts_with(prefix):
            rest = rest.substring(prefix.byte_len(), rest.byte_len())
    rest.starts_with("fn ") or rest.starts_with("me ")

fn _bur_ident_char(c: text) -> bool:
    (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
        (c >= "0" and c <= "9") or c == "_"

fn _bur_leading_ident(s: text) -> text:
    var i = 0
    while i < s.byte_len() and _bur_ident_char(s.substring(i, i + 1)):
        i = i + 1
    s.substring(0, i)

fn _bur_unit_decl_name(line: text) -> text:
    var rest = line
    if rest.starts_with("pub "):
        rest = rest.substring(4, rest.byte_len())
    if not rest.starts_with("unit "):
        return ""
    val name = _bur_leading_ident(rest.substring(5, rest.byte_len()))
    if rest.substring(5 + name.byte_len(), rest.byte_len()).starts_with(":"):
        return name
    ""

fn _bur_unit_imports(line: text, existing: [text]) -> [text]:
    var units = existing
    if not line.starts_with("use unit."):
        return units
    val open = line.find("{{")
    val close = line.find("}")
    if open < 0 or close <= open:
        return units
    for part in line.substring(open + 1, close).split(","):
        # `{Meter as M}` binds the local name M.
        var name = part.trim()
        val alias_at = name.find(" as ")
        if alias_at >= 0:
            name = name.substring(alias_at + 4, name.byte_len()).trim()
        if name != "" and not units.contains(name):
            units.push(name)
    units

# Whole-identifier occurrence of `len` bytes at `start` in `expr` (not a field
# of another value, not part of a longer identifier).
fn _bur_whole_at(expr: text, start: i64, len: i64) -> bool:
    val end = start + len
    val before_ok = start == 0 or
        (not _bur_ident_char(expr.substring(start - 1, start)) and
            expr.substring(start - 1, start) != ".")
    val after_ok = end >= expr.byte_len() or not _bur_ident_char(expr.substring(end, end + 1))
    before_ok and after_ok

fn _bur_mentions(expr: text, name: text) -> bool:
    var from = 0
    while from < expr.byte_len():
        val at = expr.substring(from, expr.byte_len()).find(name)
        if at < 0:
            return false
        if _bur_whole_at(expr, from + at, name.byte_len()):
            return true
        from = from + at + 1
    false

# `name.value`, `name.raw()`, `name.to_f64()` or `name.to_i64()` on a whole
# identifier `name`.
fn _bur_erases(expr: text, name: text) -> bool:
    for accessor in [".value", ".raw()", ".to_f64()", ".to_i64()"]:
        val needle = name + accessor
        var from = 0
        while from < expr.byte_len():
            val at = expr.substring(from, expr.byte_len()).find(needle)
            if at < 0:
                break
            val start = from + at
            val end = start + needle.byte_len()
            val tail_ok = end >= expr.byte_len() or not _bur_ident_char(expr.substring(end, end + 1))
            if _bur_whole_at(expr, start, name.byte_len()) and tail_ok:
                return true
            from = start + 1
    false

fn _bur_paren_depth(s: text) -> i64:
    var depth = 0
    var i = 0
    while i < s.byte_len():
        val c = s.substring(i, i + 1)
        if c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
        i = i + 1
    depth

# Index of the line closing a (possibly multi-line) fn header: the first line
# at or after `start` where the parens balance.
fn _bur_header_end(lines: [CodeLine], start: i64) -> i64:
    var depth = 0
    var k = start
    while k < lines.len() and k < start + 24:
        depth = depth + _bur_paren_depth(lines[k].trimmed)
        if depth <= 0:
            return k
        k = k + 1
    start

fn _bur_join(lines: [CodeLine], first: i64, last: i64) -> text:
    var joined = ""
    var k = first
    while k <= last:
        joined = joined + " " + lines[k].trimmed
        k = k + 1
    joined.trim()

# The byte loops below index single bytes; a multi-byte (non-ASCII) line would
# be split mid-character, so such lines are skipped.
fn _bur_ascii(s: text) -> bool:
    s.len() == s.byte_len()

fn _bur_binding(line: text) -> text:
    var rest = ""
    if line.starts_with("val "):
        rest = line.substring(4, line.byte_len())
    elif line.starts_with("var "):
        rest = line.substring(4, line.byte_len())
    else:
        val name = _bur_leading_ident(line)
        val after = line.substring(name.byte_len(), line.byte_len())
        if name != "" and after.starts_with(" = "):
            return name
        return ""
    _bur_leading_ident(rest)

fn _bur_rhs(line: text) -> text:
    val eq = line.find("=")
    if eq < 0:
        return ""
    line.substring(eq + 1, line.byte_len()).trim()

fn _bur_cast_args(expr: text, unit_name: text) -> [text]:
    var args: [text] = []
    val needle = unit_name + "("
    var from = 0
    while from < expr.byte_len():
        val k = expr.substring(from, expr.byte_len()).find(needle)
        if k < 0:
            return args
        val at = from + k
        from = at + needle.byte_len()
        if at > 0:
            val before = expr.substring(at - 1, at)
            if _bur_ident_char(before) or before == ".":
                continue
        var depth = 0
        var i = from
        while i < expr.byte_len():
            val c = expr.substring(i, i + 1)
            if c == "(":
                depth = depth + 1
            elif c == ")":
                if depth == 0:
                    args.push(expr.substring(from, i))
                    break
                depth = depth - 1
            i = i + 1
    args

fn _bur_index(names: [text], name: text) -> i64:
    var i = 0
    while i < names.len():
        if names[i] == name:
            return i
        i = i + 1
    -1

# Set (or add) the origin of `name`; an empty origin clears it.
fn _bur_set(names: [text], origins: [text], name: text, origin: text) -> i64:
    val at = _bur_index(names, name)
    if at >= 0:
        origins[at] = origin
    elif origin != "":
        names.push(name)
        origins.push(origin)
    0

# Unit-typed parameters of a function header: `fn f(a: Meter, b: i64)`.
fn _bur_param_units(header: text, units: [text], names: [text], origins: [text]) -> i64:
    val open = header.find("(")
    val close = header.find(")")
    if open < 0 or close <= open:
        return 0
    for part in header.substring(open + 1, close).split(","):
        val p = part.trim()
        val colon = p.find(":")
        if colon > 0:
            val ty = p.substring(colon + 1, p.byte_len()).trim()
            if units.contains(ty):
                _bur_set(names, origins, p.substring(0, colon).trim(), ty)
    0


# Operand of every `<operand> as Unit` cast (whole-identifier `Unit` after
# `as`): an optional balanced `(...)` preceded by an identifier/field path.
fn _bur_as_operands(expr: text, unit_name: text) -> [text]:
    var ops: [text] = []
    val needle = " as " + unit_name
    var from = 0
    while from < expr.byte_len():
        val k = expr.substring(from, expr.byte_len()).find(needle)
        if k < 0:
            return ops
        val at = from + k
        from = at + needle.byte_len()
        if from < expr.byte_len() and _bur_ident_char(expr.substring(from, from + 1)):
            continue
        var start = at
        if start > 0 and expr.substring(start - 1, start) == ")":
            var depth = 0
            while start > 0:
                val c = expr.substring(start - 1, start)
                if c == ")":
                    depth = depth + 1
                elif c == "(":
                    depth = depth - 1
                start = start - 1
                if depth == 0:
                    break
        while start > 0:
            val c = expr.substring(start - 1, start)
            if _bur_ident_char(c) or c == ".":
                start = start - 1
            else:
                break
        ops.push(expr.substring(start, at))
    ops

# Cross-file summary: `fns[i]` is a `pub fn` of `module` that returns a bare
# primitive erased from unit `units[i]`.
pub struct BoundUnitSummary:
    module: text
    fns: [text]
    units: [text]

fn _bur_fn_name(line: text) -> text:
    var rest = line
    for prefix in ["pub ", "static ", "async ", "unsafe "]:
        if rest.starts_with(prefix):
            rest = rest.substring(prefix.byte_len(), rest.byte_len())
    if rest.starts_with("fn ") or rest.starts_with("me "):
        return _bur_leading_ident(rest.substring(3, rest.byte_len()))
    ""

fn _bur_returns_primitive(header: text) -> bool:
    val arrow = header.find(" -> ")
    if arrow < 0:
        return false
    var rt = header.substring(arrow + 4, header.byte_len()).trim()
    if rt.ends_with(":"):
        rt = rt.substring(0, rt.byte_len() - 1).trim()
    ["f64", "f32", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8"].contains(rt)

# Whole-identifier call `name(` inside `expr`.
fn _bur_calls(expr: text, name: text) -> bool:
    val needle = name + "("
    var from = 0
    while from < expr.byte_len():
        val at = expr.substring(from, expr.byte_len()).find(needle)
        if at < 0:
            return false
        val start = from + at
        val before_ok = start == 0 or
            (not _bur_ident_char(expr.substring(start - 1, start)) and
                expr.substring(start - 1, start) != ".")
        if before_ok:
            return true
        from = start + 1
    false

# Unit that `expr` erased to a primitive, or "" when none. Unit-typed locals
# erase through an accessor; already-erased locals erase by mention; calls of
# summarised erasing functions erase their result. An origin different from
# `target` wins so a mixed expression still reports.
fn _bur_erased_origin(expr: text, unit_names: [text], unit_origins: [text], erased_names: [text], erased_origins: [text], sum_names: [text], sum_units: [text], target: text) -> text:
    var found = ""
    var i = 0
    while i < unit_names.len():
        if unit_origins[i] != "" and _bur_erases(expr, unit_names[i]):
            if unit_origins[i] != target:
                return unit_origins[i]
            found = unit_origins[i]
        i = i + 1
    i = 0
    while i < erased_names.len():
        if erased_origins[i] != "" and _bur_mentions(expr, erased_names[i]):
            if erased_origins[i] != target:
                return erased_origins[i]
            found = erased_origins[i]
        i = i + 1
    i = 0
    while i < sum_names.len():
        if _bur_calls(expr, sum_names[i]):
            if sum_units[i] != target:
                return sum_units[i]
            found = sum_units[i]
        i = i + 1
    found

# Local names bound by `use <module>.{a, b as c}` whose target is in a
# dependency summary, seeded as erasing functions.
fn _bur_seed_imports(lines: [CodeLine], deps: [BoundUnitSummary], sum_names: [text], sum_units: [text]) -> i64:
    for line in lines:
        val t = line.trimmed
        if not t.starts_with("use "):
            continue
        val open = t.find(".{{")
        val close = t.find("}")
        if open < 0 or close <= open:
            continue
        val module = t.substring(4, open).trim()
        for dep in deps:
            if dep.module != module:
                continue
            for part in t.substring(open + 2, close).split(","):
                var name = part.trim()
                var local = name
                val alias_at = name.find(" as ")
                if alias_at >= 0:
                    local = name.substring(alias_at + 4, name.byte_len()).trim()
                    name = name.substring(0, alias_at).trim()
                val at = _bur_index(dep.fns, name)
                if at >= 0 and local != "":
                    _bur_set(sum_names, sum_units, local, dep.units[at])
    0

struct BurRun:
    findings: [BoundUnitReassertFinding]
    sum_names: [text]
    sum_units: [text]
    sum_pubs: [text]

fn _bur_walk(lines: [CodeLine], units: [text], sum_names: [text], sum_units: [text], sum_pubs: [text]) -> [BoundUnitReassertFinding]:
    var findings: [BoundUnitReassertFinding] = []
    var i = 0
    while i < lines.len():
        val header = lines[i]
        if not _bur_fn_header(header.trimmed):
            i = i + 1
            continue
        val header_indent = _bur_indent(header.raw)
        var unit_names: [text] = []
        var unit_origins: [text] = []
        var erased_names: [text] = []
        var erased_origins: [text] = []
        val header_end = _bur_header_end(lines, i)
        val header_text = _bur_join(lines, i, header_end)
        _bur_param_units(header_text, units, unit_names, unit_origins)
        val returns_prim = _bur_returns_primitive(header_text)
        var ret_unit = ""
        var tail = ""
        var j = header_end + 1
        while j < lines.len():
            val body = lines[j]
            if body.trimmed == "":
                j = j + 1
                continue
            if _bur_indent(body.raw) <= header_indent:
                break
            if not _bur_ascii(body.trimmed):
                tail = ""
                j = j + 1
                continue
            var reported = false
            for unit_name in units:
                if reported:
                    break
                var operands = _bur_cast_args(body.trimmed, unit_name)
                for op in _bur_as_operands(body.trimmed, unit_name):
                    operands.push(op)
                for arg in operands:
                    val from_unit = _bur_erased_origin(arg, unit_names, unit_origins, erased_names, erased_origins, sum_names, sum_units, unit_name)
                    if from_unit != "" and from_unit != unit_name:
                        findings.push(BoundUnitReassertFinding(
                            code: "SPL-BOUND-003",
                            message: "unit `{from_unit}` erased to a primitive and reasserted as unit `{unit_name}`",
                            note: "convert between units with an explicit conversion (or a validated constructor returning Result<{unit_name}, ConstraintError>) instead of `.value` followed by `{unit_name}(...)`",
                            line_num: body.line_num
                        ))
                        reported = true
                        break
            val bound = _bur_binding(body.trimmed)
            if bound != "":
                tail = ""
                val rhs = _bur_rhs(body.trimmed)
                var rhs_unit = ""
                for unit_name in units:
                    if rhs.starts_with(unit_name + "("):
                        rhs_unit = unit_name
                val erased_from = _bur_erased_origin(rhs, unit_names, unit_origins, erased_names, erased_origins, sum_names, sum_units, "")
                # A rebinding replaces the origin of `bound`.
                _bur_set(unit_names, unit_origins, bound, rhs_unit)
                if rhs_unit != "":
                    _bur_set(erased_names, erased_origins, bound, "")
                else:
                    _bur_set(erased_names, erased_origins, bound, erased_from)
            else:
                tail = body.trimmed
                if tail.starts_with("return "):
                    tail = tail.substring(7, tail.byte_len())
                    if ret_unit == "":
                        ret_unit = _bur_erased_origin(tail, unit_names, unit_origins, erased_names, erased_origins, sum_names, sum_units, "")
            j = j + 1
        if returns_prim:
            if ret_unit == "" and tail != "":
                ret_unit = _bur_erased_origin(tail, unit_names, unit_origins, erased_names, erased_origins, sum_names, sum_units, "")
            val fname = _bur_fn_name(header.trimmed)
            if ret_unit != "" and fname != "":
                _bur_set(sum_names, sum_units, fname, ret_unit)
                if header.trimmed.starts_with("pub ") and not sum_pubs.contains(fname):
                    sum_pubs.push(fname)
        i = j
    findings

fn _bur_run(source: text, file_path: text, deps: [BoundUnitSummary]) -> BurRun:
    var run = BurRun(findings: [], sum_names: [], sum_units: [], sum_pubs: [])
    if lint_is_vendor_path(file_path):
        return run
    val lines = code_line_snapshot(source).lines
    var units: [text] = []
    for line in lines:
        val u = _bur_unit_decl_name(line.trimmed)
        if u != "" and not units.contains(u):
            units.push(u)
        units = _bur_unit_imports(line.trimmed, units)
    if units.len() < 1:
        return run
    _bur_seed_imports(lines, deps, run.sum_names, run.sum_units)
    # Three rounds resolve forward references and helper chains; only the last
    # round's findings are kept.
    var round = 0
    while round < 3:
        run.findings = _bur_walk(lines, units, run.sum_names, run.sum_units, run.sum_pubs)
        round = round + 1
    run

pub fn check_bound_unit_reasserts(source: text, file_path: text) -> [BoundUnitReassertFinding]:
    _bur_run(source, file_path, []).findings

pub fn check_bound_unit_reasserts_cross(source: text, file_path: text, deps: [BoundUnitSummary]) -> [BoundUnitReassertFinding]:
    _bur_run(source, file_path, deps).findings

# Exported summary of this module for its importers: `pub fn`s that return a
# bare primitive erased from a unit. `module` is filled in by the caller.
pub fn bound_unit_erasure_summary(source: text, file_path: text) -> BoundUnitSummary:
    val run = _bur_run(source, file_path, [])
    var fns: [text] = []
    var us: [text] = []
    var k = 0
    while k < run.sum_names.len():
        if run.sum_pubs.contains(run.sum_names[k]):
            fns.push(run.sum_names[k])
            us.push(run.sum_units[k])
        k = k + 1
    BoundUnitSummary(module: "", fns: fns, units: us)
