# No-GC Unique-Owner / Short-Borrow Readiness Lint
#
# Flags code that is valid under TODAY's semantics (class instances are shared
# references; parameters and receivers alias the caller's object) but would be
# rejected, or would silently change meaning, under the no-GC default of the
# ownership recovery plan: one unique owner per class instance, ownership
# transfer on assignment/store/insertion, and parameters/receivers that are
# STRICTLY SHORT inferred borrows (never returned, stored, captured by an
# escaping closure/task, or held across a suspension).
#
#   NOGC-OWN-001  use after an implicit ownership transfer of a class local
#                 (`val b = a`, `self.f = a`, `xs.push(a)`, `d[k] = a`, then
#                 `a` is used again on the same path)                WARNING
#   NOGC-BOR-001  a borrowed parameter / receiver (or a class-typed field of
#                 one) is returned                                    WARNING
#   NOGC-BOR-002  a borrowed parameter / receiver is stored into a field,
#                 index slot, container, or aggregate constructor    WARNING
#   NOGC-BOR-003  a borrowed parameter / receiver is captured by an escaping
#                 closure (returned, stored, or handed to a spawn API) WARNING
#   NOGC-BOR-004  a borrowed parameter / receiver is used after an `await`
#                 or `yield` in the same function                    WARNING
#   NOGC-ALIAS-001 a local is bound to a class-typed field/element of another
#                 owner and then mutated through that local (a persistent
#                 second reference to one owner)                     WARNING
#
# Fix direction (plan §3, §10): an explicit move with no later use, an explicit
# `.clone()` where an independent copy is intended, an explicit owner (`iso T`)
# for a parameter that is consumed, mutation through the owning path (a new
# short borrow), or a handle/ID for a long-lived relationship. NEVER a longer
# borrow, a lifetime parameter, implicit RC, or nil.
#
# Precision over recall. A value is "class-typed" only when the lint can SEE
# it: a `C(...)`/`C.new(...)` constructor, a `: C` annotation, or a parameter
# typed `C`, where `C` is a class declared in the file or passed in through
# `extra_classes` (the blast-radius driver passes a repo-wide class index from
# which names that are ALSO declared as struct/enum somewhere are removed).
# Structs, arrays, dicts, text and scalars are values and are never flagged.
# `iso T` parameters are explicit owners and are never treated as borrows.
# Unhandled shapes (moves inside loops, moves through unknown call results)
# are skipped, not guessed.
#
# Severity is WARNING, never Deny, until the bootstrap closure is converted.
#
# Contract: doc/03_plan/language/memory_safety/nogc_ownership_baseline_wp00_01_2026-10-20.md

use compiler.semantics.lint.lint_text.{code_line_snapshot}
use compiler.semantics.lint.nogc_own.text_scan.{
    nogc_is_ident, nogc_take_ident, nogc_indent_of, nogc_code_of,
    nogc_has_word, nogc_type_base, nogc_array_elem_base,
    nogc_split_top_commas, nogc_paren_balance, nogc_strip_decl_mods,
    nogc_is_fn_header, nogc_decl_parts, nogc_assign_parts,
    nogc_call_single_arg
}

pub struct NogcOwnFinding:
    code: text
    severity: text
    message: text
    hint: text
    line_num: i64
    file_path: text

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.file_path}:{self.line_num} — {self.message} — {self.hint}"

# ============================================================================
# File model (parallel arrays; one instance per checked file)
# ============================================================================

class NogcFile:
    nums: [i64]
    codes: [text]
    indents: [i64]
    classes: [text]
    aggregates: [text]
    extra_cls: {text: bool}
    extra_agg: {text: bool}
    f_owner: [text]
    f_name: [text]
    f_class: [text]
    f_elem: [text]
    m_owner: [text]
    m_name: [text]
    owners: [text]
    owner_inds: [i64]

fn _contains(xs: [text], x: text) -> bool:
    for v in xs:
        if v == x: return true
    false

fn _type_decl_name(code: text, kw: text) -> text:
    val rest = nogc_strip_decl_mods(code)
    if not rest.starts_with(kw): return ""
    nogc_take_ident(rest.substring(kw.len(), rest.len()).trim(), 0)

fn _impl_target(code: text) -> text:
    val rest = nogc_strip_decl_mods(code)
    if not rest.starts_with("impl "): return ""
    var body = rest.substring(5, rest.len()).trim()
    if body.starts_with("<"):
        val close = body.index_of(">")
        if close < 0: return ""
        body = body.substring(close + 1, body.len()).trim()
    val fat = body.index_of(" for ")
    if fat >= 0:
        body = body.substring(fat + 5, body.len()).trim()
    nogc_take_ident(body, 0)

fn _keyword_line(code: text) -> bool:
    val kws = ["fn ", "me ", "val ", "var ", "static ", "pub ", "use ", "export ", "return", "if ", "for ", "while ", "match ", "impl ", "class ", "struct ", "enum ", "trait ", "type ", "const ", "extern ", "@", "#"]
    for k in kws:
        if code.starts_with(k): return true
    false

fn _field_decl(code: text) -> [text]:
    """`name: Type` (optionally `pub`/`var`/`val`-prefixed) -> [name, Type]."""
    var c = code
    if c.starts_with("pub "): c = c.substring(4, c.len()).trim()
    if c.starts_with("var ") or c.starts_with("val "): c = c.substring(4, c.len()).trim()
    if c.starts_with("fn ") or c.starts_with("me ") or c.starts_with("static "): return []
    val name = nogc_take_ident(c, 0)
    if name == "": return []
    val after = c.substring(name.len(), c.len()).trim()
    if not after.starts_with(":"): return []
    if after.starts_with("::"): return []
    val ty = after.substring(1, after.len()).trim()
    if ty == "": return []
    [name, ty]

fn _build_file(source: text, extra_cls: {text: bool}, extra_agg: {text: bool}) -> NogcFile:
    val snap = code_line_snapshot(source)
    var nums: [i64] = []
    var codes: [text] = []
    var indents: [i64] = []
    for cl in snap.lines:
        nums.push(cl.line_num)
        val code = nogc_code_of(cl.raw)
        codes.push(code)
        if code == "":
            indents.push(999)
        else:
            indents.push(nogc_indent_of(cl.raw))
    snap.release()

    # In-file declarations; repo-wide names come through the extra_* sets.
    var classes: [text] = []
    var aggregates: [text] = []
    var i = 0
    while i < codes.len():
        if indents[i] == 0:
            val cn = _type_decl_name(codes[i], "class ")
            if cn != "" and not _contains(classes, cn):
                classes.push(cn)
            val sn = _type_decl_name(codes[i], "struct ")
            if sn != "" and not _contains(aggregates, sn):
                aggregates.push(sn)
        i = i + 1

    # Owner of each line (the enclosing top-level class/struct/impl block).
    var owners: [text] = []
    var owner_inds: [i64] = []
    var f_owner: [text] = []
    var f_name: [text] = []
    var f_class: [text] = []
    var f_elem: [text] = []
    var m_owner: [text] = []
    var m_name: [text] = []
    var owner = ""
    var owner_is_class_decl = false
    var body_indent = -1
    i = 0
    while i < codes.len():
        val code = codes[i]
        val ind = indents[i]
        if ind == 0:
            owner = ""
            owner_is_class_decl = false
            body_indent = -1
            val cn = _type_decl_name(code, "class ")
            if cn != "":
                owner = cn
                owner_is_class_decl = true
            else:
                val it = _impl_target(code)
                if it != "":
                    owner = it
                else:
                    val sn = _type_decl_name(code, "struct ")
                    if sn != "": owner = sn
        elif ind != 999 and owner != "":
            if body_indent < 0: body_indent = ind
            if ind == body_indent:
                val rest = nogc_strip_decl_mods(code)
                if rest.starts_with("me "):
                    m_owner.push(owner)
                    m_name.push(nogc_take_ident(rest.substring(3, rest.len()), 0))
                elif owner_is_class_decl and not _keyword_line(code):
                    val fd = _field_decl(code)
                    if fd.len() == 2:
                        val fb = nogc_type_base(fd[1])
                        val fe = nogc_array_elem_base(fd[1])
                        if (extra_cls.has(fb) or _contains(classes, fb)) or (extra_cls.has(fe) or _contains(classes, fe)):
                            f_owner.push(owner)
                            f_name.push(fd[0])
                            var fbc = ""
                            if (extra_cls.has(fb) or _contains(classes, fb)): fbc = fb
                            var fec = ""
                            if (extra_cls.has(fe) or _contains(classes, fe)): fec = fe
                            f_class.push(fbc)
                            f_elem.push(fec)
        owners.push(owner)
        owner_inds.push(body_indent)
        i = i + 1

    NogcFile(nums: nums, codes: codes, indents: indents, classes: classes,
        aggregates: aggregates, extra_cls: extra_cls, extra_agg: extra_agg, f_owner: f_owner, f_name: f_name,
        f_class: f_class, f_elem: f_elem, m_owner: m_owner, m_name: m_name,
        owners: owners, owner_inds: owner_inds)

fn _is_class(f: NogcFile, name: text) -> bool:
    if name == "": return false
    f.extra_cls.has(name) or _contains(f.classes, name)

fn _is_agg(f: NogcFile, name: text) -> bool:
    if name == "": return false
    f.extra_agg.has(name) or _contains(f.aggregates, name)

fn _field_class(f: NogcFile, owner: text, field: text) -> text:
    var i = 0
    while i < f.f_owner.len():
        if f.f_owner[i] == owner and f.f_name[i] == field:
            return f.f_class[i]
        i = i + 1
    ""

fn _field_elem(f: NogcFile, owner: text, field: text) -> text:
    var i = 0
    while i < f.f_owner.len():
        if f.f_owner[i] == owner and f.f_name[i] == field:
            return f.f_elem[i]
        i = i + 1
    ""

fn _is_me_method(f: NogcFile, owner: text, name: text) -> bool:
    var i = 0
    while i < f.m_owner.len():
        if f.m_owner[i] == owner and f.m_name[i] == name:
            return true
        i = i + 1
    false

# ============================================================================
# Function model
# ============================================================================

class NogcFn:
    name: text
    header: i64
    indent: i64
    body_start: i64
    body_end: i64
    has_return: bool
    receiver: text
    p_names: [text]
    p_class: [text]
    p_elem: [text]

fn _parse_fn(f: NogcFile, h: i64) -> NogcFn:
    var header = f.codes[h]
    var last = h
    var bal = nogc_paren_balance(header)
    while bal > 0 and last + 1 < f.codes.len() and last - h < 24:
        last = last + 1
        header = header + " " + f.codes[last]
        bal = nogc_paren_balance(header)
    val rest = nogc_strip_decl_mods(header)
    val is_static = header.starts_with("static ") or header.starts_with("pub static ")
    val name = nogc_take_ident(rest.substring(3, rest.len()), 0)
    val open = rest.index_of("(")
    var params_text = ""
    var tail = ""
    if open >= 0:
        var depth = 0
        var k = open
        var close = -1
        while k < rest.len() and close < 0:
            val ch = rest.substring(k, k + 1)
            if ch == "(": depth = depth + 1
            if ch == ")":
                depth = depth - 1
                if depth == 0: close = k
            k = k + 1
        if close > open:
            params_text = rest.substring(open + 1, close)
            tail = rest.substring(close + 1, rest.len())
    val ind = f.indents[h]
    val owner = f.owners[h]
    # Only a method declared directly in the class/impl body has a receiver;
    # a helper nested inside a method body does not.
    val is_method = ind > 0 and owner != "" and ind == f.owner_inds[h]
    var receiver = ""
    if is_method and not is_static and _is_class(f, owner):
        receiver = owner
    var p_names: [text] = []
    var p_class: [text] = []
    var p_elem: [text] = []
    for p in nogc_split_top_commas(params_text):
        var pt = p.trim()
        if pt.starts_with("mut "): pt = pt.substring(4, pt.len()).trim()
        if pt == "self":
            if is_method and _is_class(f, owner):
                receiver = owner
            continue
        val pn = nogc_take_ident(pt, 0)
        if pn == "": continue
        val colon = pt.index_of(":")
        if colon < 0: continue
        val ty = pt.substring(colon + 1, pt.len())
        val base = nogc_type_base(ty)
        val elem = nogc_array_elem_base(ty)
        p_names.push(pn)
        var pc = ""
        if _is_class(f, base): pc = base
        var pe = ""
        if _is_class(f, elem): pe = elem
        p_class.push(pc)
        p_elem.push(pe)
    var end = last + 1
    while end < f.codes.len() and (f.indents[end] == 999 or f.indents[end] > ind):
        end = end + 1
    val has_return = tail.index_of("->") >= 0 and tail.index_of("-> ()") < 0
    NogcFn(name: name, header: h, indent: ind, body_start: last + 1,
        body_end: end, has_return: has_return, receiver: receiver,
        p_names: p_names, p_class: p_class, p_elem: p_elem)

# Locals discovered while walking one function body.
class NogcLocals:
    names: [text]
    classes: [text]
    decl_at: [i64]

fn _local_class(locals: NogcLocals, name: text) -> text:
    var i = locals.names.len() - 1
    while i >= 0:
        if locals.names[i] == name: return locals.classes[i]
        i = i - 1
    ""

fn _local_decl(locals: NogcLocals, name: text) -> i64:
    var i = locals.names.len() - 1
    while i >= 0:
        if locals.names[i] == name: return locals.decl_at[i]
        i = i - 1
    -1

fn _param_class(fun: NogcFn, name: text) -> text:
    var i = 0
    while i < fun.p_names.len():
        if fun.p_names[i] == name: return fun.p_class[i]
        i = i + 1
    ""

fn _param_elem(fun: NogcFn, name: text) -> text:
    var i = 0
    while i < fun.p_names.len():
        if fun.p_names[i] == name: return fun.p_elem[i]
        i = i + 1
    ""

fn _ctor_class(f: NogcFile, rhs: text) -> text:
    """`C(...)` or `C.new(...)` with C a known class -> C."""
    val c = nogc_take_ident(rhs, 0)
    if c == "" or not _is_class(f, c): return ""
    val after = rhs.substring(c.len(), rhs.len())
    if after.starts_with("(") or after.starts_with(".new("): return c
    ""

fn _root_class(f: NogcFile, fun: NogcFn, locals: NogcLocals, root: text) -> text:
    if root == "self": return fun.receiver
    val pc = _param_class(fun, root)
    if pc != "": return pc
    _local_class(locals, root)

fn _place_class(f: NogcFile, fun: NogcFn, locals: NogcLocals, expr: text) -> text:
    """Class of a one-level place `X.f`, `X.f[i]`, or `X[i]`; else ""."""
    val root = nogc_take_ident(expr, 0)
    if root == "": return ""
    val after = expr.substring(root.len(), expr.len())
    if after.starts_with("."):
        val field = nogc_take_ident(after, 1)
        if field == "": return ""
        val rem = after.substring(1 + field.len(), after.len())
        val rc = _root_class(f, fun, locals, root)
        if rc == "": return ""
        if rem == "":
            return _field_class(f, rc, field)
        if rem.starts_with("[") and rem.ends_with("]") and rem.index_of("][") < 0:
            return _field_elem(f, rc, field)
        return ""
    if after.starts_with("[") and after.ends_with("]") and after.index_of("][") < 0:
        val pe = _param_elem(fun, root)
        if pe != "": return pe
    ""

# ============================================================================
# Path-sensitive forward scan (NOGC-OWN-001)
# ============================================================================

fn _starts_terminator(code: text) -> bool:
    if code == "return" or code.starts_with("return "): return true
    if code == "break" or code == "continue": return true
    if code.starts_with("panic(") or code.starts_with("raise "): return true
    false

fn _use_after(f: NogcFile, fun: NogcFn, t: i64, name: text, decl_at: i64) -> i64:
    """First line index on a path from transfer line `t` that uses `name`, or
    -1. Sibling `elif`/`else` branches and other match arms are skipped
    (mutually exclusive with the transfer); a terminator on the transfer's
    path ends the scan; a transfer inside a loop the local was declared
    outside of is skipped (not modelled); reassignment of `name` ends it."""
    val ti = f.indents[t]
    # Enclosing headers of the transfer line, innermost first.
    var h_ind: [i64] = []
    var h_kind: [text] = []
    var cur = ti
    var k = t - 1
    while k >= fun.body_start - 1 and k >= 0:
        if f.indents[k] != 999 and f.indents[k] < cur:
            val c = f.codes[k]
            var kind = "other"
            if c.starts_with("if ") or c.starts_with("elif ") or c.starts_with("else"):
                kind = "branch"
            elif c.starts_with("for ") or c.starts_with("while ") or c.starts_with("loop"):
                kind = "loop"
            elif c.starts_with("case "):
                kind = "arm"
            elif c.starts_with("match "):
                kind = "match"
            if kind == "loop" and decl_at < k:
                return -1
            h_ind.push(f.indents[k])
            h_kind.push(kind)
            cur = f.indents[k]
            if k <= fun.header: k = -1
        k = k - 1
    # A header directly under a `match` header is an arm.
    var hi = 0
    while hi + 1 < h_kind.len():
        if h_kind[hi + 1] == "match" and h_kind[hi] == "other":
            h_kind[hi] = "arm"
        hi = hi + 1

    var level = ti
    var j = t + 1
    while j < fun.body_end:
        val ind = f.indents[j]
        if ind == 999:
            j = j + 1
            continue
        val code = f.codes[j]
        # Drop headers we have left; detect sibling branches / arms.
        var skip = false
        var depth_i = 0
        var keep_ind: [i64] = []
        var keep_kind: [text] = []
        while depth_i < h_ind.len():
            if h_ind[depth_i] == ind and not skip:
                if h_kind[depth_i] == "branch" and (code.starts_with("elif ") or code.starts_with("else")):
                    skip = true
                elif h_kind[depth_i] == "arm":
                    skip = true
            if h_ind[depth_i] < ind or (h_ind[depth_i] == ind and skip):
                keep_ind.push(h_ind[depth_i])
                keep_kind.push(h_kind[depth_i])
            depth_i = depth_i + 1
        h_ind = keep_ind
        h_kind = keep_kind
        if skip:
            j = j + 1
            while j < fun.body_end and (f.indents[j] == 999 or f.indents[j] > ind):
                j = j + 1
            continue
        if ind < level: level = ind
        if nogc_has_word(code, name):
            val ap = nogc_assign_parts(code)
            if ap.len() == 2 and ap[0] == name and not nogc_has_word(ap[1], name):
                return -1
            return j
        if ind <= level and _starts_terminator(code):
            return -1
        j = j + 1
    -1

fn _moved_names(code: text) -> [text]:
    """Identifiers whose ownership this line hands to another place:
    `val b = a`, `b = a`, `x.f = a`, `d[k] = a`, `.push(a)`, `.append(a)`."""
    var out: [text] = []
    val dp = nogc_decl_parts(code)
    if dp.len() == 3 and nogc_is_ident(dp[2]) and dp[2] != dp[0]:
        out.push(dp[2])
    val ap = nogc_assign_parts(code)
    if ap.len() == 2 and nogc_is_ident(ap[1]) and ap[1] != ap[0]:
        out.push(ap[1])
    for a in nogc_call_single_arg(code, "push"):
        if nogc_is_ident(a): out.push(a)
    for a in nogc_call_single_arg(code, "append"):
        if nogc_is_ident(a): out.push(a)
    out

# ============================================================================
# Borrow escapes (NOGC-BOR-001..004)
# ============================================================================

fn _stores_name(f: NogcFile, code: text, b: text) -> bool:
    val ap = nogc_assign_parts(code)
    if ap.len() == 2 and ap[1] == b and (ap[0].index_of(".") >= 0 or ap[0].index_of("[") >= 0):
        return true
    for a in nogc_call_single_arg(code, "push"):
        if a == b: return true
    for a in nogc_call_single_arg(code, "append"):
        if a == b: return true
    for payload in nogc_call_single_arg(code, "insert"):
        val parts = nogc_split_top_commas(payload)
        if parts.len() >= 2 and parts[parts.len() - 1] == b: return true
    # Aggregate constructor `C(..., b, ...)` / `C(..., f: b, ...)`.
    var rest = code
    while true:
        val at = rest.index_of("(")
        if at < 0: return false
        var s = at
        while s > 0 and _ident_ch(rest.substring(s - 1, s)):
            s = s - 1
        val callee = rest.substring(s, at)
        val before_dot = s > 0 and rest.substring(s - 1, s) == "."
        if callee != "" and not before_dot and (_is_class(f, callee) or _is_agg(f, callee)):
            val inner = _paren_payload(rest.substring(at, rest.len()))
            for arg in nogc_split_top_commas(inner):
                if arg == b: return true
                val colon = arg.index_of(":")
                if colon > 0 and nogc_is_ident(arg.substring(0, colon).trim()) and arg.substring(colon + 1, arg.len()).trim() == b:
                    return true
        rest = rest.substring(at + 1, rest.len())
    false

fn _ident_ch(ch: text) -> bool:
    if ch == "_": return true
    if ch >= "a" and ch <= "z": return true
    if ch >= "A" and ch <= "Z": return true
    if ch >= "0" and ch <= "9": return true
    false

fn _paren_payload(s: text) -> text:
    """`(a, b(c), d) rest` -> `a, b(c), d`."""
    var depth = 0
    var i = 0
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if ch == "(": depth = depth + 1
        if ch == ")":
            depth = depth - 1
            if depth == 0: return s.substring(1, i)
        i = i + 1
    ""

fn _lambda_at(code: text) -> i64:
    """Index of a `\\x:` / `\\:` lambda introducer, or -1."""
    var rest = code
    var base = 0
    while true:
        val at = rest.index_of("\\")
        if at < 0: return -1
        val nxt = if at + 1 < rest.len(): rest.substring(at + 1, at + 2) else: ""
        if nxt == ":" or nxt == " " or _ident_ch(nxt):
            if not (nxt >= "0" and nxt <= "9"):
                return base + at
        base = base + at + 1
        rest = rest.substring(at + 1, rest.len())
    -1

fn _escaping_lambda(code: text, lam: i64) -> bool:
    val head = code.substring(0, lam)
    for api in ["spawn", "thread_spawn", "spawn_task", "task_spawn", "actor_spawn", "go"]:
        if nogc_has_word(head, api): return true
    if head.starts_with("return "): return true
    if head.ends_with(".push(") or head.ends_with(".append("): return true
    val ap = nogc_assign_parts(code)
    if ap.len() == 2 and ap[1].starts_with("\\") and (ap[0].index_of(".") >= 0 or ap[0].index_of("[") >= 0):
        return true
    false

fn _is_suspension(code: text) -> bool:
    nogc_has_word(code, "await") or nogc_has_word(code, "yield")

# ============================================================================
# Driver
# ============================================================================

class NogcSink:
    path: text
    findings: [NogcOwnFinding]

    me add(code: text, msg: text, hint: text, line: i64):
        for g in self.findings:
            if g.code == code and g.line_num == line: return
        self.findings.push(NogcOwnFinding(code: code, severity: "warning", message: msg, hint: hint, line_num: line, file_path: self.path))

fn _hint_move() -> text:
    "Under the no-GC unique-owner default this assignment MOVES the owner. Drop the later use, use `.clone()` only if an independent copy is intended, or keep a handle/ID for a long-lived relationship. Never extend a borrow."

fn _hint_return() -> text:
    "Parameters and receivers are strictly short borrows; returning one escapes its boundary. Take the parameter as an explicit owner (`iso T`) and return it, return a `.clone()` when an independent copy is intended, or return a handle/ID."

fn _hint_store() -> text:
    "Storing a short borrow retains it past the call. Take the parameter as an explicit owner (`iso T`) so the caller moves it in, store a `.clone()` when an independent copy is intended, or store a handle/ID."

fn _hint_capture() -> text:
    "An escaping closure or task outlives the call that lent the borrow. Move an owned value into it, or capture a handle/ID resolved briefly inside the closure."

fn _hint_suspend() -> text:
    "A short borrow cannot be held across a suspension. Copy out the values needed before the suspension, take an owned transfer or lease token, or re-resolve a handle after resuming."

fn _hint_alias() -> text:
    "The local is a second persistent reference to a value another place owns. Mutate through the owning path (`owner.f.x = ...`, a fresh short borrow), or use a handle/ID. Do not keep both."

fn _alias_mutated(f: NogcFile, fun: NogcFn, d: i64, name: text, cls: text) -> bool:
    """Is local `name` (bound at line index `d`) mutated through before it is
    rebound? Field assignment, compound assignment, push/append/insert on a
    member, or a call of a `me` method of its class."""
    val dot = "{name}."
    var k = d + 1
    while k < fun.body_end:
        val code = f.codes[k]
        val ap = nogc_assign_parts(code)
        if ap.len() == 2 and ap[0] == name:
            return false
        if code.starts_with(dot):
            if ap.len() == 2 and ap[0].starts_with(dot):
                return true
            for op in [" += ", " -= ", " *= ", " /= "]:
                val at = code.index_of(op)
                if at > 0 and code.substring(0, at).index_of("(") < 0:
                    return true
            val m = nogc_take_ident(code, dot.len())
            val after = code.substring(dot.len() + m.len(), code.len())
            if after.starts_with("(") and _is_me_method(f, cls, m):
                return true
            if after.starts_with(".push(") or after.starts_with(".append(") or after.starts_with(".insert("):
                return true
        k = k + 1
    false

fn _check_fn(f: NogcFile, fun: NogcFn, sink: NogcSink):
    var borrowed: [text] = []
    if fun.receiver != "":
        borrowed.push("self")
    var pi = 0
    while pi < fun.p_names.len():
        if fun.p_class[pi] != "":
            borrowed.push(fun.p_names[pi])
        pi = pi + 1

    var locals = NogcLocals(names: [], classes: [], decl_at: [])
    var body_ind = -1
    var tail = -1
    var susp = -1
    var j = fun.body_start
    while j < fun.body_end:
        if f.indents[j] == 999:
            j = j + 1
            continue
        if body_ind < 0: body_ind = f.indents[j]
        if f.indents[j] == body_ind: tail = j
        val code = f.codes[j]
        val line = f.nums[j]

        # ---- NOGC-OWN-001: implicit transfer of a class local, then reuse
        for mv in _moved_names(code):
            val lc = _local_class(locals, mv)
            if lc != "":
                val u = _use_after(f, fun, j, mv, _local_decl(locals, mv))
                if u >= 0:
                    sink.add("NOGC-OWN-001",
                        "`{mv}` (a `{lc}`) is used at line {f.nums[u]} after its ownership was transferred here (in `{fun.name}`)",
                        _hint_move(), line)

        # ---- local classification (after the transfer check: `val a = a`
        #      style rebinding on this line is a fresh owner)
        val dp = nogc_decl_parts(code)
        if dp.len() == 3:
            var lc = ""
            val ab = nogc_type_base(dp[1])
            if _is_class(f, ab): lc = ab
            if lc == "": lc = _ctor_class(f, dp[2])
            if lc == "" and nogc_is_ident(dp[2]):
                lc = _local_class(locals, dp[2])
            # ---- NOGC-ALIAS-001: local bound to another owner's class place
            val pc = _place_class(f, fun, locals, dp[2])
            if pc != "":
                if lc == "": lc = pc
                if _alias_mutated(f, fun, j, dp[0], pc):
                    sink.add("NOGC-ALIAS-001",
                        "`{dp[0]}` is bound to `{dp[2]}` (a `{pc}` owned by another place) and mutated through the local (in `{fun.name}`)",
                        _hint_alias(), line)
            locals.names.push(dp[0])
            locals.classes.push(lc)
            locals.decl_at.push(j)

        if susp < 0 and _is_suspension(code):
            susp = j

        val lam = _lambda_at(code)
        val lam_escapes = lam >= 0 and _escaping_lambda(code, lam)
        var bi = 0
        while bi < borrowed.len():
            val b = borrowed[bi]
            if b != "" and nogc_has_word(code, b):
                # ---- NOGC-BOR-001: return of a borrow (or its class field)
                if code == "return {b}":
                    sink.add("NOGC-BOR-001", "borrowed `{b}` is returned (in `{fun.name}`)", _hint_return(), line)
                elif code.starts_with("return {b}.") and _place_class(f, fun, locals, code.substring(7, code.len())) != "":
                    sink.add("NOGC-BOR-001",
                        "class-typed field `{code.substring(7, code.len())}` of borrowed `{b}` is returned (in `{fun.name}`)",
                        _hint_return(), line)
                # ---- NOGC-BOR-002: store of a borrow
                if _stores_name(f, code, b):
                    sink.add("NOGC-BOR-002", "borrowed `{b}` is stored past the call (in `{fun.name}`)", _hint_store(), line)
                # ---- NOGC-BOR-004: used after a suspension point
                if susp >= 0 and susp < j:
                    sink.add("NOGC-BOR-004",
                        "borrowed `{b}` is used after the suspension at line {f.nums[susp]} (in `{fun.name}`)",
                        _hint_suspend(), line)
            # ---- NOGC-BOR-003: capture by an escaping closure/task
            if b != "" and lam_escapes:
                var captured = nogc_has_word(code.substring(lam, code.len()), b)
                if not captured and code.ends_with(":"):
                    var k = j + 1
                    while k < fun.body_end and (f.indents[k] == 999 or f.indents[k] > f.indents[j]):
                        if nogc_has_word(f.codes[k], b): captured = true
                        k = k + 1
                if captured:
                    sink.add("NOGC-BOR-003",
                        "borrowed `{b}` is captured by an escaping closure/task (in `{fun.name}`)",
                        _hint_capture(), line)
            bi = bi + 1
        j = j + 1

    # ---- NOGC-BOR-001 tail-expression form
    if fun.has_return and tail >= 0:
        val tc = f.codes[tail]
        for b in borrowed:
            if b != "" and tc == b:
                sink.add("NOGC-BOR-001",
                    "borrowed `{b}` is returned as the tail expression (in `{fun.name}`)",
                    _hint_return(), f.nums[tail])
            elif b != "" and tc.starts_with("{b}.") and _place_class(f, fun, locals, tc) != "":
                sink.add("NOGC-BOR-001",
                    "class-typed field `{tc}` of borrowed `{b}` is returned as the tail expression (in `{fun.name}`)",
                    _hint_return(), f.nums[tail])

pub fn check_nogc_ownership_indexed(source: text, file_path: text, extra_cls: {text: bool}, extra_agg: {text: bool}) -> [NogcOwnFinding]:
    """Run every NOGC-* rule. `extra_cls`/`extra_agg` are repo-wide class and
    struct name sets (the blast-radius driver builds them once); in-file
    declarations are always added."""
    val f = _build_file(source, extra_cls, extra_agg)
    val sink = NogcSink(path: file_path, findings: [])
    if f.classes.len() == 0 and extra_cls.len() == 0:
        return sink.findings
    var h = 0
    while h < f.codes.len():
        if f.indents[h] != 999 and nogc_is_fn_header(f.codes[h]):
            _check_fn(f, _parse_fn(f, h), sink)
        h = h + 1
    sink.findings

pub fn check_nogc_ownership_with(source: text, file_path: text, extra_classes: [text], extra_aggregates: [text]) -> [NogcOwnFinding]:
    var cls: {text: bool} = {}
    for c in extra_classes:
        cls[c] = true
    var agg: {text: bool} = {}
    for a in extra_aggregates:
        agg[a] = true
    check_nogc_ownership_indexed(source, file_path, cls, agg)

pub fn check_nogc_ownership(source: text, file_path: text) -> [NogcOwnFinding]:
    check_nogc_ownership_indexed(source, file_path, {}, {})
