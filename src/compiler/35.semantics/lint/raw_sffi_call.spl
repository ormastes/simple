# Raw SFFI call lint.
#
# A raw extern declaration is an ABI assertion the compiler cannot validate.
# Calls must therefore live in the smallest function carrying an explicit
# `@unsafe(... capabilities: [ffi])` boundary. Safe wrappers validate and lift
# the result outside that raw helper.

use compiler.semantics.lint.lint_text.{iter_code_lines, CodeLine}

pub struct RawSffiCallFinding:
    code: text
    message: text
    note: text
    line_num: i64

fn _rsc_indent(raw: text) -> i64:
    var i = 0
    while i < raw.len() and raw.substring(i, i + 1) == " ":
        i = i + 1
    i

fn _rsc_fn_header(line: text) -> bool:
    line.starts_with("fn ") or line.starts_with("pub fn ") or
        line.starts_with("static fn ") or line.starts_with("pub static fn ") or
        line.starts_with("me ")

fn _rsc_extern_name(line: text) -> text:
    var rest = line.trim()
    if rest.starts_with("pub "):
        rest = rest.substring(4, rest.len()).trim()
    if not rest.starts_with("extern fn "):
        return ""
    rest = rest.substring(10, rest.len())
    val paren = rest.find("(")
    if paren <= 0:
        return ""
    rest.substring(0, paren).trim()

fn _rsc_calls_name(line: text, name: text) -> bool:
    val needle = name + "("
    line.starts_with(needle) or line.contains(" " + needle) or
        line.contains("(" + needle) or line.contains("[" + needle) or
        line.contains("," + needle) or line.contains("=" + needle) or
        line.contains(": " + needle)

fn _rsc_has_ffi_unsafe_boundary(lines: [CodeLine], header_index: i64) -> bool:
    var i = header_index - 1
    while i >= 0:
        val previous = lines[i].trimmed
        if previous == "":
            i = i - 1
            continue
        return previous.starts_with("@unsafe(") and previous.contains("capabilities") and
            previous.contains("ffi")
    false

pub fn check_raw_sffi_calls(source: text, file_path: text) -> [RawSffiCallFinding]:
    var findings: [RawSffiCallFinding] = []
    if file_path.contains("src/compiler_rust/vendor") or
        file_path.contains("src/runtime/vendor") or file_path.contains("sffi_gen"):
        return findings

    val lines = iter_code_lines(source)
    var externs: [text] = []
    for line in lines:
        val name = _rsc_extern_name(line.trimmed)
        if name != "" and not externs.contains(name):
            externs.push(name)

    var i = 0
    while i < lines.len():
        val header = lines[i]
        if _rsc_fn_header(header.trimmed):
            val ffi_unsafe = _rsc_has_ffi_unsafe_boundary(lines, i)
            val header_indent = _rsc_indent(header.raw)
            var j = i + 1
            while j < lines.len():
                val body = lines[j]
                if body.trimmed == "":
                    j = j + 1
                    continue
                if _rsc_indent(body.raw) <= header_indent:
                    break
                if not ffi_unsafe:
                    for name in externs:
                        if _rsc_calls_name(body.trimmed, name):
                            findings.push(RawSffiCallFinding(
                                code: "SFFI009",
                                message: "raw extern call `{name}` is outside an explicit ffi-unsafe boundary",
                                note: "move only the raw call into a private @unsafe(reason: ..., capabilities: [ffi]) helper; validate and lift its result in the safe caller",
                                line_num: body.line_num
                            ))
                            break
                j = j + 1
            i = j
            continue
        i = i + 1
    findings
