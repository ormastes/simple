# Silent-Default / Fail-Open Lint (mission-critical profile)
#
# silent_default: flags code that SUBSTITUTES A PLAUSIBLE-LOOKING CONSTANT for a
# missing answer instead of reporting the failure. In mission-critical code a
# fabricated value is worse than a crash: it propagates as if it were real data.
#
#   W-MC-DEF-001  in-domain constant default on a LOOKUP/RESOLUTION result   WARNING
#   W-MC-DEF-002  `.ok()` discarding an error and continuing                 WARNING
#   W-MC-DEF-003  vacuously-true success predicate (`failed == 0` only)      WARNING
#
# ---------------------------------------------------------------------------
# Why this rule exists (the defect it is modelled on)
# ---------------------------------------------------------------------------
# `src/compiler_rust/compiler/src/hir/lower/expr/access.rs:288` resolved a struct
# field index with `.unwrap_or(0)`. When resolution failed, EVERY field silently
# read field 0's slot. Demonstrated with `struct W3: first, length, tag` where
# `W3(first: 9, length: n, tag: 77)` printed `first=9 length=9 tag=9`. It blocked
# the bootstrap six times before anyone looked at the `unwrap_or`.
#
# ---------------------------------------------------------------------------
# THE DISCRIMINATOR: in-domain vs out-of-domain defaults
# ---------------------------------------------------------------------------
# `.unwrap_or(<const>)` is USUALLY FINE. It is a defect only when the constant is
# INDISTINGUISHABLE from a legitimate result — an *in-domain* value:
#
#   trimmed.index_of("(").unwrap_or(0)    <- DEFECT. 0 is a VALID index. "no
#                                            paren" is now "paren at column 0".
#   trimmed.index_of("(").unwrap_or(-1)   <- SAFE.  -1 is OUT of the index
#                                            domain, so callers must test it.
#
# So the rule flags in-domain constants (0, 1, true, "") on lookup/resolution
# receivers, and deliberately does NOT flag -1 and friends. Measured on this repo
# (2026-08-17): 146 `.unwrap_or(<const>)` sites tree-wide, 46 of them on a
# lookup-shaped receiver, and W-MC-DEF-001 fires on exactly ONE — which is a real
# fail-open (`erlang.spl:52`). 13 sites use the safe `-1` sentinel and are
# correctly silent. A rule that fired on all 146 would be turned off by week two.
#
# ---------------------------------------------------------------------------
# SEVERITY: WARNING TODAY. ESCALATION IS A ONE-LINE CHANGE.
# ---------------------------------------------------------------------------
# Every code here is WARNING so existing code keeps compiling — per the user
# instruction "at least warning now, latter bug when sw stable for
# compatibility". To promote to a hard error once the population is converted,
# change exactly ONE line in
#   src/compiler/90.tools/lint/_LintMain/config_and_model.spl
#       levels["silent_default"] = "warn"    ->    levels["silent_default"] = "deny"
# and nothing in this file. The severity text below is advisory metadata; the
# LintLevel that actually gates the build is set at that registry line. Do not
# escalate before `scripts/check/check-silent-default-baseline.shs` reports a
# baseline of 0 — escalating a rule ahead of its population is what made lint
# unusable the last three times.
#
# ---------------------------------------------------------------------------
# SCOPE: path-based mission-critical UNION an opt-in file marker
# ---------------------------------------------------------------------------
# Path scope alone would be VACUOUS: the five existing files under
# `src/lib/**/mission_critical/**` contain zero `unwrap_or`, zero `.ok()`, so a
# purely path-scoped rule could never fire on today's tree. Hence:
#
#   * W-MC-DEF-001 runs TREE-WIDE. It is sharp enough (1 hit / 146 candidates)
#     that scoping it would only hide real defects.
#   * W-MC-DEF-002 / -003 are noisier and run ONLY in mission-critical scope,
#     which is the union of:
#       - a path containing `/mission_critical/`
#       - a file declaring `@mission_critical` near the top
#     This mirrors `bare_primitive_internal` (registry level `allow` by default,
#     `warn` under the critical tier) and `raw_rt_access` (path predicate in the
#     rule body). No parallel mechanism is introduced.
#
# `@mission_critical` is INERT TODAY: it is only ever read by this text scan, is
# never parsed as an attribute by the compiler, and adding it to a file changes
# no codegen. It exists so a module can opt in before the directory convention
# catches up.
#
# ---------------------------------------------------------------------------
# SUPPRESSION (greppable, reason mandatory)
# ---------------------------------------------------------------------------
#   val idx = s.index_of("(").unwrap_or(0)  # lint:allow(silent_default) caller
#                                           # already tested contains("(")
#
# The marker must carry a non-empty reason after the closing paren, on the SAME
# line as the finding or on the line immediately above it. A bare
# `# lint:allow(silent_default)` with no text is IGNORED — it does not suppress —
# because "a rule with no escape hatch gets disabled wholesale, but an escape
# hatch with no reason is just a disabled rule spelled differently".
# Audit every suppression in the tree with:
#     /usr/bin/grep -rn 'lint:allow(silent_default)' src/
#
# This file uses text-heuristic analysis (no AST dependency) so it can run in
# interpreter-mode specs, exactly like raw_rt_access.spl. Cost is one linear pass
# over the lines with no per-declaration work, so it does not add to the
# superlinear per-declaration lint cost documented in .claude/rules/commands.md.

# ============================================================================
# Finding Struct
# ============================================================================

pub struct SilentDefaultFinding:
    code: text
    severity: text
    message: text
    name: text
    note: text
    line_num: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — {self.note}"

# ============================================================================
# Scope Helpers
# ============================================================================

fn _sd_is_mission_critical(source: text, file_path: text) -> bool:
    """Mission-critical scope = path convention UNION opt-in file marker.

    Path: any path containing `/mission_critical/` (matches both
    `src/lib/common/mission_critical/` and
    `src/lib/nogc_sync_mut/mission_critical/`).

    Marker: a top-of-file `@mission_critical` line. The marker is INERT — the
    compiler never parses it; only this scan reads it."""
    if file_path.contains("/mission_critical/"):
        return true
    if file_path.starts_with("mission_critical/"):
        return true
    val lines = source.split("\n")
    var i = 0
    while i < lines.len() and i < 30:
        val t = lines[i].trim()
        if t == "@mission_critical" or t.starts_with("@mission_critical ") or t == "#[mission_critical]":
            return true
        i = i + 1
    false

fn _sd_is_vendored(file_path: text) -> bool:
    """Owned-Code Scope per CLAUDE.md: never lint vendored third-party source."""
    if file_path.contains("/vendor/"):
        return true
    if file_path.contains("/node_modules/"):
        return true
    false

# ============================================================================
# Suppression
# ============================================================================

fn _sd_has_reasoned_suppression(line: text) -> bool:
    """True when `line` carries `lint:allow(silent_default)` FOLLOWED by a
    non-empty reason. A bare marker with no reason does not suppress."""
    val marker = "lint:allow(silent_default)"
    val idx = line.index_of(marker)
    if idx < 0:
        return false
    val after = line.substring(idx + marker.len(), line.len())
    # strip a continuation `#` so a wrapped comment still counts as a reason
    var reason = after.trim()
    if reason.starts_with("#"):
        reason = reason.substring(1, reason.len()).trim()
    reason.len() > 0

fn _sd_suppressed(lines: [text], idx: i64) -> bool:
    """Suppression applies on the finding's own line or the line above it."""
    if _sd_has_reasoned_suppression(lines[idx]):
        return true
    if idx > 0 and _sd_has_reasoned_suppression(lines[idx - 1]):
        return true
    false

# ============================================================================
# W-MC-DEF-001: in-domain constant default on a lookup/resolution result
# ============================================================================

fn _sd_in_domain_default(line: text) -> text:
    """Return the in-domain default constant used in `.unwrap_or(...)` /
    `.unwrap_or_default()` on this line, or "" if none.

    IN-DOMAIN (flagged): 0, 1, true, "" — every one of these is a value a
    successful lookup could legitimately have returned, so a caller cannot tell
    the fabricated answer from a real one.

    OUT-OF-DOMAIN (never flagged): -1 and other negative sentinels, which sit
    outside the result domain and therefore force the caller to test."""
    if line.contains(".unwrap_or_default()"):
        return "default"
    if line.contains(".unwrap_or(0)"):
        return "0"
    if line.contains(".unwrap_or(1)"):
        return "1"
    if line.contains(".unwrap_or(true)"):
        return "true"
    if line.contains(".unwrap_or(\"\")"):
        return "empty"
    ""

fn _sd_lookup_receiver(line: text) -> text:
    """Return the lookup/resolution method name whose result is being defaulted,
    or "" when the receiver is not lookup-shaped.

    Lookup-shaped means the call ANSWERS A QUESTION about existence or location —
    an index, an id, an offset, a slot, a field, a resolution. Those are the
    results whose absence must never be papered over. Plain accessors and
    configuration reads are intentionally excluded: `cfg.get("port")
    .unwrap_or(8080)` is a genuine default, not a guess."""
    val tokens = ["index_of(", "find_index(", "position(", "field_of(",
                  "slot_of(", "offset_of(", "id_of(", "resolve(",
                  "lookup(", "_index(", "_offset(", "_slot("]
    for tok in tokens:
        val at = line.index_of(tok)
        if at >= 0:
            return _sd_full_ident_ending_at(line, at + tok.len() - 1)
    ""

fn _sd_full_ident_ending_at(line: text, paren_idx: i64) -> text:
    """Walk left from the `(` at `paren_idx` and return the WHOLE identifier.

    Matching on a suffix token would mis-name the finding: `resolve_field_index(`
    matches the `_index(` token, but the thing that failed is
    `resolve_field_index`, and a diagnostic that names the wrong function sends
    the reader to the wrong line."""
    var start = paren_idx
    while start > 0:
        val ch = line.substring(start - 1, start)
        if _sd_is_ident_char(ch):
            start = start - 1
        else:
            break
    line.substring(start, paren_idx)

fn _sd_is_ident_char(ch: text) -> bool:
    """True for identifier characters (alnum or underscore)."""
    if ch == "_":
        return true
    val is_lower = ch >= "a" and ch <= "z"
    val is_upper = ch >= "A" and ch <= "Z"
    val is_digit = ch >= "0" and ch <= "9"
    is_lower or is_upper or is_digit

# ============================================================================
# W-MC-DEF-003: vacuously-true success predicate
# ============================================================================

fn _sd_vacuous_success_body(trimmed: text) -> bool:
    """A one-expression success predicate that only checks a FAILURE counter is
    zero. `TestRunResult::success()` was literally `total_failed == 0`, so a run
    that executed ZERO tests reported success. A sound predicate must also
    assert that work actually happened (`total_run > 0`)."""
    if not (trimmed.contains("== 0") or trimmed.contains("==0")):
        return false
    val mentions_failure = (trimmed.contains("failed") or trimmed.contains("failures")
                            or trimmed.contains("errors") or trimmed.contains("error_count"))
    if not mentions_failure:
        return false
    # already conjoined with a non-vacuity check -> sound, do not flag
    if trimmed.contains("> 0") or trimmed.contains(">0") or trimmed.contains(">= 1"):
        return false
    true

fn _sd_is_success_predicate_sig(trimmed: text) -> bool:
    """`fn`/`me` returning bool with a success-flavoured name."""
    if not (trimmed.starts_with("fn ") or trimmed.starts_with("me ")
            or trimmed.starts_with("pub fn ")):
        return false
    if not trimmed.contains("-> bool"):
        return false
    (trimmed.contains(" success") or trimmed.contains(" is_success")
     or trimmed.contains(" passed") or trimmed.contains(" is_ok")
     or trimmed.contains(" all_passed") or trimmed.contains(" ok("))

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn check_silent_default(source: text, file_path: text) -> [SilentDefaultFinding]:
    """Text-based heuristic for the W-MC-DEF-00x silent-default family.

    W-MC-DEF-001 runs tree-wide (it is sharp: 1 hit / 146 candidates).
    W-MC-DEF-002 and -003 run only in mission-critical scope (see
    `_sd_is_mission_critical`) because they are noisier.

    All findings are WARNING. See the file header for the exact one-line change
    that promotes the family to a hard error once the population is converted."""
    var findings: [SilentDefaultFinding] = []
    if _sd_is_vendored(file_path):
        return findings

    val mc = _sd_is_mission_critical(source, file_path)
    val lines = source.split("\n")
    var line_num = 0
    var in_success_fn = false

    for line in lines:
        line_num = line_num + 1
        val t = line.trim()
        if t.starts_with("#"):
            in_success_fn = false
            continue

        # --- W-MC-DEF-001 (tree-wide) ---
        val default_const = _sd_in_domain_default(t)
        if default_const != "":
            val recv = _sd_lookup_receiver(t)
            if recv != "" and not _sd_suppressed(lines, line_num - 1):
                findings.push(SilentDefaultFinding(
                    code: "W-MC-DEF-001",
                    severity: "WARNING",
                    message: "in-domain default `{default_const}` substituted for a failed `{recv}` lookup; a caller cannot tell it from a real result",
                    name: recv,
                    note: "return a Result/Option to the caller, or use an OUT-of-domain sentinel such as -1 that forces a test; suppress with `# lint:allow(silent_default) <reason>` if the default is provably safe",
                    line_num: line_num
                ))

        # --- W-MC-DEF-002 (mission-critical scope only) ---
        if mc and t.contains(".ok()"):
            if not _sd_suppressed(lines, line_num - 1):
                findings.push(SilentDefaultFinding(
                    code: "W-MC-DEF-002",
                    severity: "WARNING",
                    message: "`.ok()` discards the error and continues; mission-critical code must propagate the failure",
                    name: "ok",
                    note: "propagate with `?` or handle the error explicitly; suppress with `# lint:allow(silent_default) <reason>`",
                    line_num: line_num
                ))

        # --- W-MC-DEF-003 (mission-critical scope only) ---
        if mc:
            if _sd_is_success_predicate_sig(t):
                in_success_fn = true
            elif in_success_fn:
                if _sd_vacuous_success_body(t) and not _sd_suppressed(lines, line_num - 1):
                    findings.push(SilentDefaultFinding(
                        code: "W-MC-DEF-003",
                        severity: "WARNING",
                        message: "success predicate is vacuously true when nothing ran: it only checks a failure counter is zero",
                        name: "success",
                        note: "conjoin a non-vacuity check (e.g. `and total_run > 0`) so an empty run cannot report success",
                        line_num: line_num
                    ))
                    in_success_fn = false
                elif t.len() > 0:
                    in_success_fn = false
    findings
