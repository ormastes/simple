# Raw Runtime Intrinsic Access Lint
#
# raw_rt_access: warns when a module OUTSIDE the privileged tiers declares a
# raw `extern fn rt_*` runtime intrinsic directly. Application and library code
# must use the std wrappers instead of binding raw runtime symbols.
#
# RAW-RT-001: `extern fn rt_<name>` declared outside src/lib/ or src/runtime/   WARNING
#
# Privileged tiers may declare raw intrinsics directly. A source path is
# privileged when it sits under `src/lib/` or `src/runtime/` — the facade
# owners. `src/compiler/` is NOT privileged: a refactor (see
# llvm_native_link.spl) routed ~65 raw rt_* call sites in the compiler
# backend through the std.nogc_sync_mut.io_runtime facade because new
# `extern fn rt_*` decls in CLI-closure modules brick the deployed binary
# (unknown-extern rejection at module load kills ALL native-builds). This
# lint stays at WARNING severity (not Deny) so the many pre-existing
# `extern fn rt_*` declarations still in src/compiler/ (the compiler defines
# and bridges most of the rt_* runtime interface) do not fail the build —
# it flags them for review without gating on the existing count.
#
# This file uses text-heuristic analysis (no AST dependency) so it can run in
# interpreter-mode specs and parity-match the Rust seed lint. It scans
# `extern fn` lines the way concurrency_api_misuse's E-PAR-005 scan does and
# extracts the declared name to test the `rt_` prefix.

# ============================================================================
# Finding Struct
# ============================================================================

struct RawRtAccessFinding:
    code: text
    severity: text
    message: text
    name: text
    note: text
    line_num: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — {self.note}"

# ============================================================================
# Path Privilege Helper
# ============================================================================

pub fn raw_rt_provider_allowlist_allows(file_path: text, allowlist: text) -> bool:
    """Apply exact-file, directory-prefix, and suffix allowlist semantics."""
    var relative = file_path
    val src_at = file_path.find("src/")
    if src_at >= 0:
        relative = file_path.substring(src_at, file_path.len())
    for raw in allowlist.split("\n"):
        val entry = raw.trim()
        if entry == "" or entry.starts_with("#"):
            continue
        if entry.starts_with("suffix:"):
            val suffix = entry.substring(7, entry.len())
            if relative.ends_with(suffix):
                return true
        elif entry.ends_with("/") and relative.starts_with(entry):
            return true
        elif relative == entry:
            return true
    false

fn _rra_marks_runtime_intrinsics(source: text) -> bool:
    """File-level `@runtime_intrinsics` / `#[runtime_intrinsics]` opt-out marker.

    Code that legitimately implements or bridges the runtime (emulators,
    baremetal MMIO, crypto/protocol impls) may keep raw `rt_*` externs by
    declaring this marker near the top of the file. Mirrors the Rust seed
    `file_marks_runtime_intrinsics` (top-of-file scan)."""
    val lines = source.split("\n")
    var i = 0
    while i < lines.len() and i < 30:
        val t = lines[i].trim()
        if t == "@runtime_intrinsics" or t.starts_with("@runtime_intrinsics ") or t == "#[runtime_intrinsics]":
            return true
        i = i + 1
    false

# ============================================================================
# Extern Name Extraction
# ============================================================================

fn _rra_extern_fn_name(trimmed: text) -> text:
    """Extract the declared name from a trimmed `extern fn <name>...` line.

    Returns "" when the line is not an extern fn declaration with a name."""
    if not trimmed.starts_with("extern fn "):
        return ""
    val rest = trimmed.substring(10, trimmed.len()).trim()
    var name = ""
    var i = 0
    val rlen = rest.len()
    while i < rlen:
        val ch = rest.substring(i, i + 1)
        if _rra_is_ident_char(ch):
            name = name + ch
        else:
            break
        i = i + 1
    name

fn _rra_is_ident_char(ch: text) -> bool:
    """True for identifier characters (alnum or underscore)."""
    if ch == "_":
        return true
    val is_lower = ch >= "a" and ch <= "z"
    val is_upper = ch >= "A" and ch <= "Z"
    val is_digit = ch >= "0" and ch <= "9"
    is_lower or is_upper or is_digit

fn _rra_is_inline_space(ch: text) -> bool:
    ch == " " or ch == "\t"

fn _rra_leading_indent(line: text) -> i64:
    """Count leading indentation without allocating a trimmed copy."""
    var indent = 0
    while indent < line.len():
        val ch = line.substring(indent, indent + 1)
        if ch != " " and ch != "\t":
            break
        indent = indent + 1
    indent

pub fn raw_rt_wrapper_replacement(name: text) -> text:
    """Approved canonical wrapper for an exact, one-call contract only.

    This is intentionally a closed list rather than a prefix/name rewrite.
    Every entry below was compared with `std.nogc_sync_mut.io_runtime`:
    argument order, return representation, sentinel meaning, call count, and
    retry/copy behavior are unchanged. The lint offers a Safe edit only when
    that exact wrapper is already selectively imported. The list is source
    policy, not ABI/provider verification or signed-artifact admission.

    Nullable reads, sentinel-normalizing helpers, validation/lift wrappers,
    and helpers that add retries deliberately return "" here. In particular
    `rt_file_read_text`, `rt_env_get`, `rt_file_size`, and `rt_dir_list` stay
    warning-only because a rename could manufacture an empty/default value or
    change absence/failure semantics.
    """
    # Exact `(text, [text]) -> (text, text, i64)` transport; one raw call.
    if name == "rt_process_run": return "process_run"
    # Exact `(text, text) -> bool` mutation-status transport; one raw call.
    if name == "rt_env_set": return "env_set"
    # Exact one-call bool status contracts; no retry or normalization.
    if name == "rt_file_delete": return "file_delete"
    if name == "rt_file_copy": return "file_copy"
    if name == "rt_file_write_text": return "file_write_exact"
    if name == "rt_file_write_bytes": return "file_write_bytes"
    if name == "rt_file_append_text": return "file_append_text"
    if name == "rt_dir_create_all": return "dir_create_all"
    if name == "rt_dir_remove_all": return "dir_remove_all"
    if name == "rt_dir_exists": return "dir_exists"
    if name == "rt_file_rename": return "file_rename"
    if name == "rt_file_move": return "file_move_cross_device"
    # Exact scalar/unit contracts; wrappers add no allocation, lookup, or call.
    if name == "rt_process_run_timeout": return "process_run_timeout"
    if name == "rt_thread_sleep": return "thread_sleep"
    if name == "rt_hash_text": return "hash_text"
    if name == "rt_time_now_monotonic_ms": return "time_now_monotonic_ms"
    ""

fn _rra_fix_note(name: text) -> text:
    val wrapper = raw_rt_wrapper_replacement(name)
    if name == "rt_process_run":
        return "replace `rt_process_run(...)` with `process_run(...)` from the canonical std/app I/O facade; it preserves `(stdout, stderr, i64 exit_code)` transport; `simple lint --fix` applies this rename only when `process_run` is already imported"
    if name == "rt_env_set":
        return "replace `rt_env_set(...)` with `env_set(...)` from the canonical std/app I/O facade; it preserves the boolean mutation status; `simple lint --fix` applies this rename only when `env_set` is already imported"
    if wrapper != "":
        return "replace `{name}(...)` with `{wrapper}(...)` only through the approved exact-contract canonical facade mapping; `simple lint --fix` applies this rename only when `{wrapper}` is already imported"
    if name == "rt_env_get":
        return "use `env_get_nullable` from `std.nogc_sync_mut.io_runtime` for exact `text?` transport (including explicitly empty values); choose `env_get_opt` only when empty and absent are intentionally equivalent; `simple lint --fix` keeps this warning-only because return contracts differ"
    if name == "rt_file_read_text":
        return "use `file_read_text` from the canonical std/app I/O facade; `simple lint --fix` keeps this as a warning-only migration because nullable return contracts can differ"
    "route `{name}` through its std semantic facade; if none exists, create a provider wrapper instead of a product-side rt_* alias"

pub fn raw_rt_lexical_code_lines(source: text) -> [text]:
    """Blank comments and normal/triple strings while preserving columns."""
    var result: [text] = []
    var in_string = false
    var in_triple = false
    var escaped = false
    for raw_line in source.split("\n"):
        var pieces: [text] = []
        var i = 0
        while i < raw_line.len():
            val ch = raw_line.substring(i, i + 1)
            val triple = i + 2 < raw_line.len() and raw_line.substring(i, i + 3) == "\"\"\""
            if in_triple:
                if triple:
                    pieces.push(" ")
                    pieces.push(" ")
                    pieces.push(" ")
                    i = i + 3
                    in_triple = false
                else:
                    pieces.push(" ")
                    i = i + 1
                continue
            if in_string:
                pieces.push(" ")
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    in_string = false
                i = i + 1
                continue
            if ch == "#":
                while i < raw_line.len():
                    pieces.push(" ")
                    i = i + 1
                break
            if triple:
                pieces.push(" ")
                pieces.push(" ")
                pieces.push(" ")
                i = i + 3
                in_triple = true
                continue
            if ch == "\"":
                pieces.push(" ")
                i = i + 1
                in_string = true
                continue
            pieces.push(ch)
            i = i + 1
        result.push(pieces.join(""))
    result

fn _rra_names_in_call_position(line: text) -> [text]:
    var names: [text] = []
    var i = 0
    while i + 3 < line.len():
        val boundary_ok = i == 0 or not _rra_is_ident_char(line.substring(i - 1, i))
        if boundary_ok and line.substring(i, i + 3) == "rt_":
            var j = i + 3
            while j < line.len() and _rra_is_ident_char(line.substring(j, j + 1)):
                j = j + 1
            var k = j
            while k < line.len() and _rra_is_inline_space(line.substring(k, k + 1)):
                k = k + 1
            if j > i + 3 and k < line.len() and line.substring(k, k + 1) == "(":
                return (line.substring(i, j), i + 1)
            # A direct callee may be grouped: `(rt_remove)(path)`. Require the
            # matching lexical shape immediately around the name so a value
            # mention such as `consume(rt_remove)` is not classified as a call.
            if j > i + 3 and k < line.len() and line.substring(k, k + 1) == ")":
                var before = i - 1
                while before >= 0 and _rra_is_inline_space(line.substring(before, before + 1)):
                    before = before - 1
                var after = k + 1
                while after < line.len() and _rra_is_inline_space(line.substring(after, after + 1)):
                    after = after + 1
                if before >= 0 and line.substring(before, before + 1) == "(" and
                   after < line.len() and line.substring(after, after + 1) == "(":
                    var prefix = before - 1
                    while prefix >= 0 and _rra_is_inline_space(line.substring(prefix, prefix + 1)):
                        prefix = prefix - 1
                    # `consume(rt_remove)(path)` invokes consume's result, not
                    # the raw symbol. A grouped raw callee must begin the
                    # expression or follow punctuation; language keywords that
                    # introduce an expression are admitted explicitly below.
                    var group_is_callee = prefix < 0 or not _rra_is_ident_char(line.substring(prefix, prefix + 1))
                    if not group_is_callee:
                        var word_start = prefix
                        while word_start >= 0 and _rra_is_ident_char(line.substring(word_start, word_start + 1)):
                            word_start = word_start - 1
                        val prefix_word = line.substring(word_start + 1, prefix + 1)
                        group_is_callee = (prefix_word == "return" or prefix_word == "yield" or
                            prefix_word == "if" or prefix_word == "elif" or
                            prefix_word == "while" or prefix_word == "case" or
                            prefix_word == "not" or prefix_word == "and" or
                            prefix_word == "or" or prefix_word == "xor" or
                            prefix_word == "await" or prefix_word == "spawn" or
                            prefix_word == "match" or prefix_word == "in" or
                            prefix_word == "try" or prefix_word == "throw")
                    if group_is_callee:
                        return (line.substring(i, j), i + 1)
        search_from = i + 3
    ("", 0)

fn _rra_call_column(line: text, wanted: text) -> i64:
    var i = 0
    while i + wanted.len() <= line.len():
        val boundary_ok = i == 0 or not _rra_is_ident_char(line.substring(i - 1, i))
        if boundary_ok and line.substring(i, i + wanted.len()) == wanted:
            val end = i + wanted.len()
            var k = end
            while k < line.len() and line.substring(k, k + 1) == " ":
                k = k + 1
            if k < line.len() and line.substring(k, k + 1) == "(":
                return i + 1
        i = i + 1
    0

fn _rra_direct_import_names(line: text, import_context: bool) -> [text]:
    var names: [text] = []
    val t = line.trim()
    if not import_context and not t.starts_with("use ") and not t.starts_with("export use "):
        return ""
    # Search imported items only. For an unbraced import the final dotted
    # component is the imported binding; earlier rt_-looking path components
    # identify an owner rather than a directly imported runtime symbol.
    var candidate = line
    if t.starts_with("use ") or t.starts_with("export use "):
        val brace = line.find("{")
        if brace >= 0:
            candidate = line.substring(brace + 1, line.len())
        else:
            val paren = line.find("(")
            if paren >= 0:
                candidate = line.substring(paren + 1, line.len())
            else:
                var candidate_end = line.len()
                val alias = line.find(" as ")
                if alias >= 0:
                    candidate_end = alias
                # Start after the import keyword so no-dot imports such as
                # `use rt_remove` inspect the imported binding, not `use`.
                var candidate_start = line.find("use ") + 4
                var i = 0
                while i < candidate_end:
                    if line.substring(i, i + 1) == ".":
                        candidate_start = i + 1
                    i = i + 1
                candidate = line.substring(candidate_start, candidate_end)
    # Inspect only each imported source binding (the identifier before `as`).
    # Looking for rt_ anywhere in the item misclassifies `safe_api as rt_api`.
    for raw_item in candidate.split(","):
        val item = raw_item.trim()
        var i = 0
        while i < item.len() and not _rra_is_ident_char(item.substring(i, i + 1)):
            i = i + 1
        val start = i
        while i < item.len() and _rra_is_ident_char(item.substring(i, i + 1)):
            i = i + 1
        if i > start:
            val imported_name = item.substring(start, i)
            if imported_name.starts_with("rt_") and imported_name.len() > 3:
                return imported_name
    ""

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn check_raw_rt_access(source: text, file_path: text) -> [RawRtAccessFinding]:
    """Text-based heuristic for RAW-RT-001 detection.

    Emits a WARNING for each `extern fn rt_*` declaration in a non-privileged
    source file. Privileged tiers (src/lib/, src/runtime/) are skipped, matching
    the Rust seed lint `raw_rt_access`. Pass "" for file_path when unknown
    (treated as non-privileged)."""
    var findings: [RawRtAccessFinding] = []
    if _rra_is_privileged_path(file_path):
        return findings
    if _rra_marks_runtime_intrinsics(source):
        return findings

    val lines = source.split("\n")
    var line_num = 0
    for line in lines:
        line_num = line_num + 1
        val t = line.trim()
        if not t.starts_with("extern fn "):
            continue
        val name = _rra_extern_fn_name(t)
        if name == "":
            continue
        if not name.starts_with("rt_"):
            continue
        val msg = "application code must not declare raw runtime intrinsic `{name}` directly; use the std wrapper"
        findings.push(RawRtAccessFinding(
            code: "RAW-RT-001",
            severity: "WARNING",
            message: msg,
            name: name,
            note: "use the std wrapper (e.g. std.io_runtime.file_read / file_write) instead of extern fn rt_*",
            line_num: line_num
        ))
    findings
