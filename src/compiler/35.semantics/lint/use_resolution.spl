# Use Resolution Lint
#
# Detects `use` imports that don't resolve to existing .spl files.
# Catches dangling imports before they cause fatal module resolution errors.
#
# W0407: Unresolved import — module file not found                    WARNING
#         (promoted to ERROR under the `critical` assurance profile, WP-10)
#
# Checks both direct file (module.spl) and directory module (module/__init__.spl).
# Derives source root from the file path being linted.
#
# Works with the arena-based core AST (integer-tagged nodes).

use compiler.core.ast.{
    DECL_USE,
    decl_get_tag, decl_get_name
}
use compiler.common.assurance.policy.{strictness_for_profile_name}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}

extern fn rt_file_exists(path: text) -> bool

# WP-10 (aerospace hardening plan, doc/03_plan/language/assurance/
# aerospace_hardening_plan_2026-08-07.md): W0407 was warning-only under every
# profile, including `critical`, so an unresolved import could reach import
# admission (module_loader_core.spl) with no error anywhere in the chain.
# Severity is routed through the WP-3 canonical policy resolver
# (strictness_for_profile_name) rather than a hardcoded string compare, so a
# future alias/rung change to the ladder does not require a second edit here.
fn _w0407_severity(profile_name: text) -> text:
    if strictness_for_profile_name(profile_name).at_least(AssuranceStrictness.Critical):
        return "ERROR"
    "WARNING"

# ============================================================================
# Warning Struct
# ============================================================================

struct UseResolutionWarning:
    code: text
    severity: text
    message: text
    module_path: text

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — 'use {self.module_path}'"

# ============================================================================
# Helpers
# ============================================================================

fn _dots_to_slashes(path: text) -> text:
    """Convert dot-separated module path to slash-separated file path."""
    val parts = path.split(".")
    var result = parts[0]
    var i = 1
    while i < parts.len():
        result = result + "/" + parts[i]
        i = i + 1
    result

fn _derive_src_root(file_path: text) -> text:
    """Derive the src/ root directory from a file path being linted."""
    val parts = file_path.split("/src/")
    if parts.len() >= 2:
        return parts[0] + "/src/"
    if file_path.starts_with("src/"):
        return "src/"
    ""

# ============================================================================
# Main Entry Point
# ============================================================================

fn check_use_resolution(decl_indices: [i64], file_path: text, profile_name: text) -> [UseResolutionWarning]:
    """Check that all use imports resolve to existing .spl files.

    For each use declaration, converts the module path to a file path
    and checks if the file exists. Emits W0407 for unresolved imports.
    `profile_name` is the resolved assurance-profile name (e.g. "critical",
    "" for the permissive default); it decides whether the finding reports
    as WARNING or is promoted to ERROR.
    """
    var warnings: [UseResolutionWarning] = []
    val severity = _w0407_severity(profile_name)

    val src_root = _derive_src_root(file_path)
    if src_root == "":
        return []

    for idx in decl_indices:
        val tag = decl_get_tag(idx)

        if tag != DECL_USE:
            continue

        val mod_path = decl_get_name(idx)
        val rel_path = _dots_to_slashes(mod_path)
        val target_file = src_root + rel_path + ".spl"
        val dir_init = src_root + rel_path + "/__init__.spl"

        if (not rt_file_exists(target_file) and not rt_file_exists(dir_init)):
            warnings.push(UseResolutionWarning(
                code: "W0407",
                severity: severity,
                message: "unresolved import — module file not found",
                module_path: mod_path
            ))

    warnings

# ============================================================================
# Exports
# ============================================================================
