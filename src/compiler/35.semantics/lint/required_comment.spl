# Required Comment Lint
#
# Detects pass_todo, pass_do_nothing, pass_dn nodes and dangerous keyword
# calls that are missing a required comment string argument.
#
# REQC001: pass_* used without a comment string           WARNING
# REQC002: Dangerous keyword call without a comment       WARNING
# REQC003: todo(...) without useful rationale             WARNING
# REQC004: wildcard match arm without rationale           WARNING
#
# Works with the arena-based core AST (integer-tagged nodes).

use compiler.core.ast_expr.{
    expr_tag, expr_s_val, expr_left, expr_right,
    expr_extra, expr_args, expr_stmts
}
use compiler.frontend.core.ast_stmt.{
    stmt_tag, stmt_expr, stmt_body
}
use compiler.core.ast.{
    decl_tag, decl_name, decl_body_stmts,
    arm_get_pattern, arm_get_guard, arm_get_body, arm_get_rationale
}
use compiler.frontend.core.dangerous_keywords.{is_dangerous_keyword}

fn _required_comment_is_ident_char(ch: text) -> bool:
    if ch >= "a" and ch <= "z":
        return true
    if ch >= "A" and ch <= "Z":
        return true
    if ch >= "0" and ch <= "9":
        return true
    ch == "_"

fn _required_comment_is_horizontal_space(ch: text) -> bool:
    ch == " " or ch == "\t"

fn _required_comment_source_has_if_binding(source: text) -> bool:
    var pos = 0
    while pos < source.len():
        var keyword_len = 0
        if pos + 2 <= source.len() and source.slice(pos, pos + 2) == "if":
            keyword_len = 2
        elif pos + 4 <= source.len() and source.slice(pos, pos + 4) == "elif":
            keyword_len = 4

        if keyword_len > 0:
            val keyword_end = pos + keyword_len
            val starts_token = pos == 0 or not _required_comment_is_ident_char(source.slice(pos - 1, pos))
            if starts_token and keyword_end < source.len() and _required_comment_is_horizontal_space(source.slice(keyword_end, keyword_end + 1)):
                var binding_pos = keyword_end
                while binding_pos < source.len() and _required_comment_is_horizontal_space(source.slice(binding_pos, binding_pos + 1)):
                    binding_pos = binding_pos + 1
                if binding_pos + 3 <= source.len():
                    val binding = source.slice(binding_pos, binding_pos + 3)
                    val ends_token = binding_pos + 3 == source.len() or not _required_comment_is_ident_char(source.slice(binding_pos + 3, binding_pos + 4))
                    if (binding == "val" or binding == "var") and ends_token:
                        return true
        pos = pos + 1
    false

fn _required_comment_is_ident_char(ch: text) -> bool:
    if ch >= "a" and ch <= "z":
        return true
    if ch >= "A" and ch <= "Z":
        return true
    if ch >= "0" and ch <= "9":
        return true
    ch == "_"

fn _required_comment_is_horizontal_space(ch: text) -> bool:
    ch == " " or ch == "\t"

fn _required_comment_source_has_if_binding(source: text) -> bool:
    var pos = 0
    while pos < source.len():
        var keyword_len = 0
        if pos + 2 <= source.len() and source.slice(pos, pos + 2) == "if":
            keyword_len = 2
        elif pos + 4 <= source.len() and source.slice(pos, pos + 4) == "elif":
            keyword_len = 4

        if keyword_len > 0:
            val keyword_end = pos + keyword_len
            val starts_token = pos == 0 or not _required_comment_is_ident_char(source.slice(pos - 1, pos))
            if starts_token and keyword_end < source.len() and _required_comment_is_horizontal_space(source.slice(keyword_end, keyword_end + 1)):
                var binding_pos = keyword_end
                while binding_pos < source.len() and _required_comment_is_horizontal_space(source.slice(binding_pos, binding_pos + 1)):
                    binding_pos = binding_pos + 1
                if binding_pos + 3 <= source.len():
                    val binding = source.slice(binding_pos, binding_pos + 3)
                    val ends_token = binding_pos + 3 == source.len() or not _required_comment_is_ident_char(source.slice(binding_pos + 3, binding_pos + 4))
                    if (binding == "val" or binding == "var") and ends_token:
                        return true
        pos = pos + 1
    false

fn required_comment_source_may_match(source: text) -> bool:
    """Cheap conservative admission for the recursive REQC AST walk."""
    if source.contains("pass_") or source.contains("todo("):
        return true
    if source.contains("case _"):
        return true
    # Wildcard binding arms (`if val _`, `if var _`, and their `elif`
    # spellings) can produce REQC004 without containing a match `case _`.
    # Admit every if-binding source conservatively; the AST walk decides
    # whether the parsed head is actually an unrationalized wildcard. Match
    # keyword tokens separated by horizontal whitespace so formatting cannot
    # bypass the walk, while identifiers such as `different` and `value` do
    # not broadly admit unrelated sources.
    if _required_comment_source_has_if_binding(source):
        return true
    source_may_contain_dangerous_keyword(source)

fn req_comment_expr_get_tag(idx: i64) -> i64:
    if idx >= 0 and idx < expr_tag.len():
        return expr_tag[idx]
    -1

fn req_comment_expr_get_str(idx: i64) -> text:
    if idx >= 0 and idx < expr_s_val.len():
        return expr_s_val[idx]
    ""

fn req_comment_expr_get_left(idx: i64) -> i64:
    if idx >= 0 and idx < expr_left.len():
        return expr_left[idx]
    -1

fn req_comment_expr_get_right(idx: i64) -> i64:
    if idx >= 0 and idx < expr_right.len():
        return expr_right[idx]
    -1

fn req_comment_expr_get_extra(idx: i64) -> i64:
    if idx >= 0 and idx < expr_extra.len():
        return expr_extra[idx]
    -1

fn req_comment_expr_get_args(idx: i64) -> [i64]:
    if idx >= 0 and idx < expr_args.len():
        return expr_args[idx]
    []

fn req_comment_expr_get_stmts(idx: i64) -> [i64]:
    if idx >= 0 and idx < expr_stmts.len():
        return expr_stmts[idx]
    []

fn req_comment_stmt_get_tag(idx: i64) -> i64:
    if idx >= 0 and idx < stmt_tag.len():
        return stmt_tag[idx]
    -1

fn req_comment_stmt_get_expr(idx: i64) -> i64:
    if idx >= 0 and idx < stmt_expr.len():
        return stmt_expr[idx]
    -1

fn req_comment_stmt_get_body(idx: i64) -> [i64]:
    if idx >= 0 and idx < stmt_body.len():
        return stmt_body[idx]
    []

fn req_comment_stmt_get_type(idx: i64) -> i64:
    stmt_get_type(idx)

fn req_comment_decl_get_tag(idx: i64) -> i64:
    if idx >= 0 and idx < decl_tag.len():
        return decl_tag[idx]
    -1

fn req_comment_decl_get_name(idx: i64) -> text:
    if idx >= 0 and idx < decl_name.len():
        return decl_name[idx]
    ""

fn req_comment_decl_get_body(idx: i64) -> [i64]:
    if idx >= 0 and idx < decl_body_stmts.len():
        return decl_body_stmts[idx]
    []

# ============================================================================
# Warning Struct
# ============================================================================

class RequiredCommentWarning:
    code: text
    severity: text
    message: text
    hint: text
    site_name: text
    line: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} at '{self.site_name}' line {self.line} — {self.hint}"

# ============================================================================
# Main Entry Point
# ============================================================================

fn check_required_comment(decl_indices: [i64]) -> [RequiredCommentWarning]:
    """Walk module declarations and check pass_* and dangerous keyword nodes."""
    var warnings: [RequiredCommentWarning] = []

    for idx in decl_indices:
        val tag = decl_get_tag(idx)

        if tag != 1:
            continue

        val fn_name = decl_get_name(idx)
        val body = decl_get_body(idx)

        for stmt_idx in body:
            val stmt_warnings = _check_stmt(stmt_idx, fn_name)
            for warning in stmt_warnings:
                warnings.push(warning)

    warnings

fn _is_weak_rationale(msg: text) -> bool:
    val t = msg.trim().lower()
    if t == "":
        return true
    if t.len() < 10:
        return true
    if t == "todo" or t == "fix" or t == "later" or t == "unknown":
        return true
    if t == "because" or t == "n/a" or t == "na":
        return true
    false

fn _check_wildcard_rationale(pattern: i64, rationale: text, site_name: text) -> [RequiredCommentWarning]:
    var warnings: [RequiredCommentWarning] = []
    if pattern < 0:
        return warnings
    if req_comment_expr_get_tag(pattern) != 6 or req_comment_expr_get_str(pattern) != "_":
        return warnings
    if _is_weak_rationale(rationale):
        warnings.push(RequiredCommentWarning(
            code: "REQC004",
            severity: "warn",
            message: "wildcard match arm used without a rationale",
            hint: "Use case _(\"why catch-all is correct\"):",
            site_name: site_name,
            line: 0
        ))
    warnings

# ============================================================================
# Statement and Expression Walking
# ============================================================================

fn _check_stmt(stmt_idx: i64, site_name: text) -> [RequiredCommentWarning]:
    var warnings: [RequiredCommentWarning] = []
    if stmt_idx < 0:
        return warnings
    val tag = stmt_get_tag(stmt_idx)

    if tag == STMT_IF_CHAIN:
        val chain_id = req_comment_stmt_get_type(stmt_idx)
        var arm_id = flat_if_chain_first_arm_get(chain_id)
        var remaining = flat_if_chain_arm_count_get(chain_id)
        while arm_id >= 0 and remaining > 0:
            val arm_kind = flat_if_arm_kind_get(arm_id)
            if arm_kind == ARM_CONDITION:
                val head_warnings = _check_expr(flat_if_arm_head_get(arm_id), site_name)
                for warning in head_warnings: warnings.push(warning)
            elif arm_kind != ARM_CONDITION:
                val rationale_warnings = _check_wildcard_rationale(
                    flat_if_arm_head_get(arm_id),
                    flat_if_arm_rationale_get(arm_id),
                    site_name
                )
                for warning in rationale_warnings: warnings.push(warning)
            val init_warnings = _check_expr(flat_if_arm_init_get(arm_id), site_name)
            for warning in init_warnings: warnings.push(warning)
            var bi = 0
            while bi < flat_if_arm_body_count_get(arm_id):
                val stmt_warnings = _check_stmt(flat_if_arm_body_at(arm_id, bi), site_name)
                for warning in stmt_warnings: warnings.push(warning)
                bi = bi + 1
            arm_id = flat_if_arm_next_get(arm_id)
            remaining = remaining - 1
        var ei = 0
        while ei < flat_if_chain_else_stmt_count_get(chain_id):
            val stmt_warnings = _check_stmt(flat_if_chain_else_stmt_at(chain_id, ei), site_name)
            for warning in stmt_warnings: warnings.push(warning)
            ei = ei + 1
        return warnings

    if tag == 1:
        val e = stmt_get_expr(stmt_idx)
        val expr_warnings = _check_expr(e, site_name)
        for warning in expr_warnings:
            warnings.push(warning)
    elif tag == 5:
        val e = stmt_get_expr(stmt_idx)
        if e >= 0:
            val expr_warnings = _check_expr(e, site_name)
            for warning in expr_warnings:
                warnings.push(warning)
    elif tag == 10:
        val body = stmt_get_body(stmt_idx)
        for s in body:
            val stmt_warnings = _check_stmt(s, site_name)
            for warning in stmt_warnings:
                warnings.push(warning)
    elif tag == 6:
        val body = stmt_get_body(stmt_idx)
        for s in body:
            val stmt_warnings = _check_stmt(s, site_name)
            for warning in stmt_warnings:
                warnings.push(warning)
    elif tag == 7:
        val body = stmt_get_body(stmt_idx)
        for s in body:
            val stmt_warnings = _check_stmt(s, site_name)
            for warning in stmt_warnings:
                warnings.push(warning)
    elif tag == 8:
        val body = stmt_get_body(stmt_idx)
        for s in body:
            val stmt_warnings = _check_stmt(s, site_name)
            for warning in stmt_warnings:
                warnings.push(warning)
    elif tag == 9:
        val e = stmt_get_expr(stmt_idx)
        val expr_warnings = _check_expr(e, site_name)
        for warning in expr_warnings:
            warnings.push(warning)
        val arms = stmt_get_body(stmt_idx)
        for arm_idx in arms:
            val arm_warnings = _check_match_arm(arm_idx, site_name)
            for warning in arm_warnings:
                warnings.push(warning)
    warnings

fn _check_match_arm(arm_idx: i64, site_name: text) -> [RequiredCommentWarning]:
    var warnings: [RequiredCommentWarning] = []
    if arm_idx < 0:
        return warnings
    val pattern = arm_get_pattern(arm_idx)
    val pattern_warnings = _check_expr(pattern, site_name)
    for warning in pattern_warnings:
        warnings.push(warning)
    val guard = arm_get_guard(arm_idx)
    if guard >= 0:
        val guard_warnings = _check_expr(guard, site_name)
        for warning in guard_warnings:
            warnings.push(warning)
    if pattern >= 0 and expr_get_tag(pattern) == 6 and expr_get_str(pattern) == "_":
        val rationale = arm_get_rationale(arm_idx)
        if _is_weak_rationale(rationale):
            warnings.push(RequiredCommentWarning(
                code: "REQC004",
                severity: "warn",
                message: "wildcard match arm used without a rationale",
                hint: "Use case _(\"why catch-all is correct\"):",
                site_name: site_name,
                line: 0
            ))
    val body = arm_get_body(arm_idx)
    for s in body:
        val stmt_warnings = _check_stmt(s, site_name)
        for warning in stmt_warnings:
            warnings.push(warning)
    warnings

fn _check_expr(expr_idx: i64, site_name: text) -> [RequiredCommentWarning]:
    var warnings: [RequiredCommentWarning] = []
    if expr_idx < 0:
        return warnings
    val tag = expr_get_tag(expr_idx)

    if tag == EXPR_IF_CHAIN:
        val chain_id = req_comment_expr_get_extra(expr_idx)
        var arm_id = flat_if_chain_first_arm_get(chain_id)
        var remaining = flat_if_chain_arm_count_get(chain_id)
        while arm_id >= 0 and remaining > 0:
            val arm_kind = flat_if_arm_kind_get(arm_id)
            if arm_kind == ARM_CONDITION:
                val head_warnings = _check_expr(flat_if_arm_head_get(arm_id), site_name)
                for warning in head_warnings: warnings.push(warning)
            elif arm_kind != ARM_CONDITION:
                val rationale_warnings = _check_wildcard_rationale(
                    flat_if_arm_head_get(arm_id),
                    flat_if_arm_rationale_get(arm_id),
                    site_name
                )
                for warning in rationale_warnings: warnings.push(warning)
            for child in [flat_if_arm_init_get(arm_id), flat_if_arm_then_expr_get(arm_id)]:
                val child_warnings = _check_expr(child, site_name)
                for warning in child_warnings: warnings.push(warning)
            arm_id = flat_if_arm_next_get(arm_id)
            remaining = remaining - 1
        val else_warnings = _check_expr(flat_if_chain_else_expr_get(chain_id), site_name)
        for warning in else_warnings: warnings.push(warning)
        return warnings

    # Check pass_* nodes for missing comment
    val is_pass_todo = tag == 40
    val is_pass_dn = tag == 43
    val is_pass_do_nothing = tag == 41
    val is_pass = is_pass_todo or is_pass_dn
    val is_any_pass = is_pass or is_pass_do_nothing

    if is_any_pass:
        val msg = expr_get_str(expr_idx)
        if _is_weak_rationale(msg):
            val w = RequiredCommentWarning(
                code: "REQC001",
                severity: "warn",
                message: "pass_* used without a comment string",
                hint: "Add a rationale: pass_todo(\"what remains\", \"hint or issue\")",
                site_name: site_name,
                line: 0
            )
            warnings.push(w)
        return warnings

    if tag == 9:
        val callee_idx = expr_get_left(expr_idx)
        if callee_idx >= 0:
            val callee_tag = expr_get_tag(callee_idx)
            if callee_tag == 6:
                val callee_name = expr_get_str(callee_idx)
                if callee_name == "todo":
                    val args = expr_get_args(expr_idx)
                    var has_what = false
                    var has_hint = false
                    if args.len() > 0 and args[0] >= 0 and expr_get_tag(args[0]) == 3:
                        has_what = not _is_weak_rationale(expr_get_str(args[0]))
                    if args.len() > 1 and args[1] >= 0 and expr_get_tag(args[1]) == 3:
                        has_hint = not _is_weak_rationale(expr_get_str(args[1]))
                    if not has_what or not has_hint:
                        warnings.push(RequiredCommentWarning(
                            code: "REQC003",
                            severity: "warn",
                            message: "todo used without what-remains and next-step strings",
                            hint: "Use todo(\"what remains\", \"hint or issue\")",
                            site_name: site_name,
                            line: 0
                        ))
                if is_dangerous_keyword(callee_name):
                    val args = expr_get_args(expr_idx)
                    var has_comment = false
                    if args.len() > 0:
                        val first_arg = args[0]
                        if first_arg >= 0:
                            val first_tag = expr_get_tag(first_arg)
                            if first_tag == 3:
                                val first_val = expr_get_str(first_arg)
                                if not _is_weak_rationale(first_val):
                                    has_comment = true
                    if not has_comment:
                        val w = RequiredCommentWarning(
                            code: "REQC002",
                            severity: "warn",
                            message: "dangerous keyword '{callee_name}' used without a comment string",
                            hint: "Add a comment: {callee_name}(\"reason\")",
                            site_name: site_name,
                            line: 0
                        )
                        warnings.push(w)
        val args2 = expr_get_args(expr_idx)
        for arg in args2:
            val arg_warnings = _check_expr(arg, site_name)
            for warning in arg_warnings:
                warnings.push(warning)
        return warnings

    if tag == 15:
        val left_warnings = _check_expr(expr_get_left(expr_idx), site_name)
        for warning in left_warnings:
            warnings.push(warning)
        val arms = expr_get_args(expr_idx)
        for arm_idx in arms:
            val arm_warnings = _check_match_arm(arm_idx, site_name)
            for warning in arm_warnings:
                warnings.push(warning)
        return warnings

    if tag == 7:
        val left_warnings = _check_expr(expr_get_left(expr_idx), site_name)
        for warning in left_warnings:
            warnings.push(warning)
        val right_warnings = _check_expr(expr_get_right(expr_idx), site_name)
        for warning in right_warnings:
            warnings.push(warning)
    elif tag == 8:
        val left_warnings = _check_expr(expr_get_left(expr_idx), site_name)
        for warning in left_warnings:
            warnings.push(warning)
    elif tag == 14:
        val left_warnings = _check_expr(expr_get_left(expr_idx), site_name)
        for warning in left_warnings:
            warnings.push(warning)
        val right_warnings = _check_expr(expr_get_right(expr_idx), site_name)
        for warning in right_warnings:
            warnings.push(warning)
        val extra_warnings = _check_expr(expr_get_extra(expr_idx), site_name)
        for warning in extra_warnings:
            warnings.push(warning)
    elif tag == 18:
        val body = expr_get_stmts(expr_idx)
        for s in body:
            val stmt_warnings = _check_stmt(s, site_name)
            for warning in stmt_warnings:
                warnings.push(warning)
    warnings
