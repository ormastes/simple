# Linear-Scan-In-Loop Hot-Path Lint
#
# A primitive that scans or compacts an ENTIRE container costs O(n). Calling one
# once per item — inside a `for`/`while` body, or once per element of a
# collection being built — makes the enclosing work O(n^2). The cost is invisible
# at authoring time because each individual call looks cheap.
#
# PERF-SCAN-001: whole-container scan invoked inside a loop body        WARNING
#
# NOTE ON THE MOTIVATING EXAMPLE (corrected 2026-09-02): this rule was written
# after a Stage-3 stall in `rt_transient_heap_promote`, which was FIRST diagnosed
# as this exact shape — a per-item call to an O(n) whole-container scan. That
# diagnosis turned out to be WRONG: promote has a single call site and the Simple
# side already batches. The bug record carries the correction. The rule is kept
# because the SHAPE it detects is a real and well-established cost class (it is
# the same family as the PERF-COW-00x rules, whose bug record documents genuine
# O(n^2) collection building), not because it would have caught that particular
# stall. Do not cite the Stage-3 stall as a positive example of this rule firing.
# See doc/08_tracking/bug/stage3_quadratic_transient_heap_promote_2026-09-02.md
#
# Why a lint and not only a profiler finding: a profiler needs a reproduction
# that is already slow enough to notice. This shape is detectable from the source
# at authoring time, before it is ever run at scale.
#
# Severity is WARNING, never Deny — the tree already carries offenders, matching
# the precedent set by PERF-COW-00x and RAW-RT-00x: a rule is not escalated
# before its population is converted.
#
# Analysis is line-based text heuristics (no AST dependency), one linear pass —
# this lint must not itself commit the defect it detects.

use compiler.semantics.lint.lint_text.{code_line_snapshot, CodeLineSnapshot}

pub struct LinearScanFinding:
    code: text
    severity: text
    message: text
    hint: text
    line_num: i64

# Primitives whose cost is proportional to the WHOLE container, not to the
# argument. Each entry is a substring match against the code line.
#
# Deliberately a short, evidence-backed list rather than every plausible name:
# a perf lint that cries wolf gets disabled, and the precedent rules here all
# started narrow. Add a name only with a measured call site.
pub fn linear_scan_primitives() -> [text]:
    [
        "rt_transient_heap_promote",   # collections.rs:1949 -> scope.objects.retain
        ".retain(",                    # Vec::retain — full scan + compaction
        ".index_of(",                  # linear search
        ".contains(",                  # linear search on array receivers
        ".remove_at(",                 # shifts the tail
        ".keys()",                     # materialises every key
        ".values()",                   # materialises every value
    ]

fn line_indent(raw: text) -> i64:
    var n = 0
    while n < raw.len() and raw.byte_at(n) == 32:
        n = n + 1
    n

fn opens_loop(code: text) -> bool:
    val t = code.trim()
    t.starts_with("for ") or t.starts_with("while ")

pub fn check_linear_scan_in_loop_snapshot(
    snapshot: CodeLineSnapshot, file_path: text
) -> [LinearScanFinding]:
    """Report PERF-SCAN-001 for whole-container scans inside a loop body.

    One linear pass. A stack of enclosing loop-header indents tracks loop depth;
    a line is 'inside a loop' when its indent exceeds the innermost recorded
    header. The stack is reset at every function header so a loop in one function
    cannot capture calls in the next."""
    val _ = file_path
    var findings: [LinearScanFinding] = []
    var loop_indents: [i64] = []
    var prims = linear_scan_primitives()

    for cl in snapshot.lines:
        val raw = cl.raw
        val code = cl.code
        if code.trim() == "":
            continue
        val indent = line_indent(raw)

        # Function header resets loop context entirely.
        val t = code.trim()
        if t.starts_with("fn ") or t.starts_with("me ") or t.starts_with("pub fn "):
            loop_indents = []
            continue

        # Pop loops we have dedented out of.
        while loop_indents.len() > 0 and indent <= loop_indents[loop_indents.len() - 1]:
            loop_indents = loop_indents[0:loop_indents.len() - 1]

        if opens_loop(code):
            loop_indents = loop_indents.push(indent)
            continue

        if loop_indents.len() == 0:
            continue

        for p in prims:
            if code.contains(p):
                findings = findings.push(LinearScanFinding(
                    "PERF-SCAN-001",
                    "warning",
                    "whole-container scan `{p}` called inside a loop body — the enclosing work is O(n^2)",
                    "hoist it out of the loop, accumulate into a set and apply once after the loop, or use an O(1) keyed structure. This exact shape stalled Stage 3 (rt_transient_heap_promote -> Vec::retain, 760 modules).",
                    cl.line_num))
                break
    findings

pub fn check_linear_scan_in_loop(source: text, file_path: text) -> [LinearScanFinding]:
    check_linear_scan_in_loop_snapshot(code_line_snapshot(source), file_path)
