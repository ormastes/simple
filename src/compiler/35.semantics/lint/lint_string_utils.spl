# Lint String Utilities
#
# Shared text-search helpers used by multiple security lint modules.

fn find_substring(haystack: text, needle: text) -> i64:
    """Find the first occurrence of needle in haystack."""
    if needle.len() == 0:
        return 0
    if haystack.len() < needle.len():
        return -1
    var i = 0
    val limit = haystack.len() - needle.len() + 1
    while i < limit:
        if haystack.slice(i, i + needle.len()) == needle:
            return i
        i = i + 1
    -1

pub fn is_ident_char(ch: text) -> bool:
    """Check if a single character is valid in an identifier."""
    if ch.len() != 1:
        return false
    val c = ch.byte_at(0)
    if c >= 97 and c <= 122:
        return true
    if c >= 65 and c <= 90:
        return true
    if c >= 48 and c <= 57:
        return true
    if c == 95:
        return true
    false
