# Statement-Leading `-` / `+` Lint
#
# LEADOP001: a statement line whose FIRST token is `-` or `+`, sitting at the
#            SAME indentation as the previous statement                     WARNING
#
# Why this exists
# ---------------
# Under the Rust seed parser a line that begins with `-` or `+` and is not
# separated from the previous statement by a DEDENT is glued onto that
# statement's trailing expression as a BINARY operator:
#
#     fn f() -> i64:
#         if c == "f": return 15
#         <bare minus>1            # parses as `return (15 - 1)` -> 14
#
# The sentinel value is silently consumed, the tail expression disappears, and
# the fall-through path returns nil. Blank lines between the two do not stop
# it. ~20 hex decoders in-tree read every `f`/`F` as 14 because of this,
# including the kernel TLS trust-anchor decoder.
#
# Full analysis + truth table:
#   doc/08_tracking/bug/if_chain_last_arm_returns_previous_value_2026-07-28.md
#
# The parser fix is deferred (its directory has in-flight work and touching it
# forces a seed rebuild), so this lint is the agreed interim guard.
#
# Indent boundary — the whole value of this rule
# ---------------------------------------------
# A DEEPER-indented leading `-`/`+` line is the INTENDED continuation feature:
#
#     val s = 10
#         <deeper minus>5          # = 5, intentional, MUST NOT be flagged
#
# So the rule fires only when indent(candidate) == indent(previous statement).
#
# Three indent classes, and why only one is reported:
#
#   EQUAL   glued, silently wrong          -> LEADOP001            (276 in-tree)
#   DEEPER  the intended continuation      -> never flagged        (by design)
#   LESSER  a DEDENT is emitted, breaking  -> never flagged      (1044 in-tree)
#           the glue; the code is correct
#
# The LESSER class was measured, not assumed: 1044 in-tree sites, of which the
# canonical shape is a `while`/`if` block followed by a dedented bare `-1`
# tail. The bug doc's own truth table (cases D and M) proves those evaluate
# correctly. Reporting them would bury the 276 real hazards under 79% noise —
# precisely the false-positive flood that gets a lint rule switched off, which
# would hand the hazard straight back. Deeper indent is likewise never flagged.
#
# Not flagged:
#   `return -1`      — line does not START with the sign
#   `(-1)`           — parenthesised
#   `val z = -1`     — sign is not the first token
#   `-> i64`         — return arrow
#   `x -= 1`         — not sign-leading
#   docstring bullets (`- item` inside a `\"\"\"` block)
#   comment lines
#   lines continuing an already-open expression (previous line ends with an
#   operator, comma, or open bracket)
#
# Text-heuristic (no AST dependency) so it can run in interpreter-mode specs,
# matching raw_rt_access.spl.

# ============================================================================
# Finding Struct
# ============================================================================

pub struct LeadingOperatorFinding:
    code: text
    severity: text
    message: text
    op: text
    note: text
    line_num: i64

    fn fmt() -> text:
        "[{self.code}] {self.severity}: {self.message} — {self.note}"

# ============================================================================
# Helpers
# ============================================================================

fn _lop_indent_of(line: text) -> i64:
    """Number of leading whitespace columns (tab counts as one column)."""
    var n = 0
    val len = line.len()
    while n < len:
        val ch = line.substring(n, n + 1)
        if ch != " " and ch != "\t":
            break
        n = n + 1
    n

fn _lop_triple_quote_count(line: text) -> i64:
    """Count non-overlapping `\"\"\"` markers on a line."""
    var count = 0
    var i = 0
    val len = line.len()
    while i + 3 <= len:
        if line.substring(i, i + 3) == "\"\"\"":
            count = count + 1
            i = i + 3
        else:
            i = i + 1
    count

fn _lop_is_comment(trimmed: text) -> bool:
    """Comment or attribute line — neither a candidate nor a previous statement."""
    if trimmed.starts_with("#"):
        return true
    if trimmed.starts_with("@"):
        return true
    false

fn _lop_leading_sign(trimmed: text) -> text:
    """Return "-" / "+" when the line's FIRST token is a bare sign, else "".

    Rejects `->` (return arrow) and compound forms, and requires that the sign
    actually leads a value (something follows it on the line)."""
    val first = trimmed.substring(0, 1)
    if first != "-" and first != "+":
        return ""
    if trimmed.len() < 2:
        return ""
    val second = trimmed.substring(1, 2)
    # `->` return arrow, `-=` / `+=` compound assign, `--` / `++` separators.
    if second == ">" or second == "=" or second == first:
        return ""
    first

fn _lop_opens_continuation(trimmed: text) -> bool:
    """True when the previous statement is syntactically unfinished, so the next
    line is already part of it (multi-line call/array/expression)."""
    if trimmed.len() == 0:
        return true
    val last = trimmed.substring(trimmed.len() - 1, trimmed.len())
    if last == "," or last == "(" or last == "[" or last == "{":
        return true
    if last == "+" or last == "-" or last == "*" or last == "/" or last == "=":
        return true
    if last == ":":
        # Block header — the body must be deeper, so a same-indent sign line is
        # a syntax error rather than a silent-glue hazard.
        return true
    if trimmed.ends_with(" and") or trimmed.ends_with(" or") or trimmed.ends_with("\\"):
        return true
    false

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn check_leading_operator_lines(
    lines: [text], file_path: text
) -> [LeadingOperatorFinding]:
    """Flag statement-leading `-`/`+` lines that the seed parser silently glues
    onto the previous statement (LEADOP001).

    Fires only when indent(candidate) == indent(previous statement). A DEEPER
    indent is the intended continuation feature; a LESSER indent emits a DEDENT
    that breaks the glue. Neither is ever reported — see the file header."""
    var findings: [LeadingOperatorFinding] = []

    var in_doc = false
    var prev_indent = 0 - 1
    var prev_open = true
    var line_num = 0

    for line in lines:
        line_num = line_num + 1
        val trimmed = line.trim()

        # Docstring / block-string tracking: bullets inside `"""` are prose.
        val quotes = _lop_triple_quote_count(line)
        if in_doc:
            if quotes > 0 and quotes % 2 == 1:
                in_doc = false
            continue
        if quotes > 0 and quotes % 2 == 1:
            in_doc = true
            continue

        if trimmed.len() == 0:
            # Blank lines do NOT reset the previous statement — the seed glues
            # across them (case N in the bug doc).
            continue
        if _lop_is_comment(trimmed):
            continue

        val sign = _lop_leading_sign(trimmed)
        if sign != "":
            val indent = _lop_indent_of(line)
            if prev_indent >= 0 and indent == prev_indent and not prev_open:
                val msg = "statement-leading `{sign}` at the same indent as the previous statement is parsed as a BINARY operator continuing it"
                findings.push(LeadingOperatorFinding(
                    code: "LEADOP001",
                    severity: "WARNING",
                    message: msg,
                    op: sign,
                    note: "wrap the value in parentheses, or make it an explicit `return {sign}...`; an intentional continuation must be indented DEEPER than the statement it continues",
                    line_num: line_num
                ))
            # A glued line is not itself a new statement anchor.
            continue

        prev_indent = _lop_indent_of(line)
        prev_open = _lop_opens_continuation(trimmed)

    findings

pub fn check_leading_operator(source: text, file_path: text) -> [LeadingOperatorFinding]:
    """Compatibility entrypoint for callers that do not own a line snapshot."""
    check_leading_operator_lines(source.split("\n"), file_path)
