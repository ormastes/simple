export rt_expr_dispatches, rt_block_dispatches
export rt_direct_callee_dispatches
export rt_stable_fn_id, rt_module_matches
export rt_unambiguous_symbol_names
export rt_admit_with_manifest
export rt_hal_facts_with_reviewed_intrinsic
