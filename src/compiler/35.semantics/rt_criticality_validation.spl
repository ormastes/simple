# Production HIR adapter for `@rt` criticality declarations. The policy engine
# is fact-only (`rt_criticality.spl`); this file extracts one bounded graph from
# lowered functions and feeds it once per compilation.

use compiler.hir.hir_types.*
use compiler.hir.hir_definitions.*
use compiler.semantics.effect_validation.{effect_block_loops, effect_block_callees}
use compiler.semantics.effect_verifier.{LOOP_BOUND_NONE}
use compiler.semantics.rt_criticality.*
use compiler.frontend.rt_criticality_registry.{rt_criticality_claim_keys}
use compiler.frontend.rt_criticality_registry.{rt_criticality_claim_path, rt_criticality_claim_fn}
use compiler.frontend.rt_criticality_registry.{rt_criticality_profile, rt_criticality_reason}
use compiler.frontend.rt_criticality_registry.{rt_criticality_bounds_for}
use compiler.frontend.rt_criticality_registry.{rt_criticality_is_hal}

fn rt_name_effects(name: text) -> i64:
    var mask: i64 = 0
    val n = name.to_lower()
    if n.contains("malloc") or n.contains("realloc") or n.contains("heap_alloc"):
        mask = mask | RT_EFFECT_ALLOC
    if n.contains("sleep") or n.contains("blocking") or n.contains("wait"):
        mask = mask | RT_EFFECT_BLOCKING
    if n.contains("dispatch") or n.contains("invoke_dynamic") or n.contains("indirect_call"):
        mask = mask | RT_EFFECT_DISPATCH
    if n == "print" or n.contains("log") or n.contains("trace"):
        mask = mask | RT_EFFECT_LOGGING
    if n.contains("mutex") or n.contains("lock") or n.contains("semaphore") or n.contains("channel"):
        mask = mask | RT_EFFECT_SYNC
    if n.contains("dlopen") or n.contains("load_library") or n.contains("plugin_load") or n.contains("aspect_load"):
        mask = mask | RT_EFFECT_LOADER
    mask

fn rt_block_allocates(block: HirBlock) -> bool:
    for stmt in block.stmts:
        match stmt.kind:
            case HirStmtKind.Expr(expr):
                if rt_expr_allocates(expr): return true
            case HirStmtKind.Let(_, _, init):
                if rt_expr_allocates(init): return true
            case HirStmtKind.Assign(target, _, value):
                if rt_expr_allocates(target) or rt_expr_allocates(value): return true
            case HirStmtKind.Block(inner):
                if rt_block_allocates(inner): return true
            case HirStmtKind.AsmAssert(_):
                pass_dn
            case HirStmtKind.SharedVal(_, _, has_init, init):
                if has_init and rt_expr_allocates(init): return true
            case HirStmtKind.SharedVar(_, _, has_init, init):
                if has_init and rt_expr_allocates(init): return true
            case HirStmtKind.GpuLaunch(_, _):
                # Launch preparation is runtime/device work and is therefore
                # conservatively allocation-bearing in critical mode.
                return true
    if block.has: return rt_expr_allocates(block.value)
    false

fn rt_block_dispatches(block: HirBlock, fn_names: Dict<i64, text>) -> bool:
    for stmt in block.stmts:
        match stmt.kind:
            case HirStmtKind.Expr(expr):
                if rt_expr_dispatches(expr, fn_names): return true
            case HirStmtKind.Let(_, _, init):
                if rt_expr_dispatches(init, fn_names): return true
            case HirStmtKind.Assign(target, _, value):
                if rt_expr_dispatches(target, fn_names) or rt_expr_dispatches(value, fn_names): return true
            case HirStmtKind.Block(inner):
                if rt_block_dispatches(inner, fn_names): return true
            case HirStmtKind.AsmAssert(_):
                pass_dn
            case HirStmtKind.SharedVal(_, _, has_init, init):
                if has_init and rt_expr_dispatches(init, fn_names): return true
            case HirStmtKind.SharedVar(_, _, has_init, init):
                if has_init and rt_expr_dispatches(init, fn_names): return true
            case HirStmtKind.GpuLaunch(_, _):
                # A device launch is dispatch by definition, even if its
                # dimension expressions and body contain no indirect call.
                return true
    if block.has: return rt_expr_dispatches(block.value, fn_names)
    false

fn rt_direct_callee_dispatches(callee: HirExpr, fn_names: Dict<i64, text>) -> bool:
    match callee.kind:
        case HirExprKind.NamedVar(_, _): false
        case HirExprKind.Var(symbol): not fn_names.contains_key(symbol.id)
        case _: true

fn rt_expr_dispatches(expr: HirExpr, fn_names: Dict<i64, text>) -> bool:
    match expr.kind:
        case HirExprKind.IntLit(_, _): false
        case HirExprKind.FloatLit(_, _): false
        case HirExprKind.StringLit(_, interpolations):
            match interpolations:
                Some(parts):
                    for part in parts:
                        if rt_expr_dispatches(part.expr, fn_names): return true
                    false
                nil: false
        case HirExprKind.BoolLit(_): false
        case HirExprKind.CharLit(_): false
        case HirExprKind.UnitLit: false
        case HirExprKind.NilLit: false
        case HirExprKind.ArrayLit(elements, _):
            for item in elements:
                if rt_expr_dispatches(item, fn_names): return true
            false
        case HirExprKind.ArrayRepeat(value, count, _):
            rt_expr_dispatches(value, fn_names) or rt_expr_dispatches(count, fn_names)
        case HirExprKind.TupleLit(elements):
            for item in elements:
                if rt_expr_dispatches(item, fn_names): return true
            false
        case HirExprKind.DictLit(entries, _, _):
            for entry in entries:
                if rt_expr_dispatches(entry[0], fn_names) or rt_expr_dispatches(entry[1], fn_names): return true
            false
        case HirExprKind.SetLit(elements, _):
            for item in elements:
                if rt_expr_dispatches(item, fn_names): return true
            false
        case HirExprKind.Var(_): false
        case HirExprKind.NamedVar(_, _): false
        case HirExprKind.Field(base, _, _): rt_expr_dispatches(base, fn_names)
        case HirExprKind.Index(base, index): rt_expr_dispatches(base, fn_names) or rt_expr_dispatches(index, fn_names)
        case HirExprKind.TupleIndex(base, _): rt_expr_dispatches(base, fn_names)
        case HirExprKind.OptionalChain(base, _): rt_expr_dispatches(base, fn_names)
        case HirExprKind.ExistsCheck(base): rt_expr_dispatches(base, fn_names)
        case HirExprKind.Unwrap(base): rt_expr_dispatches(base, fn_names)
        case HirExprKind.Binary(_, left, right): rt_expr_dispatches(left, fn_names) or rt_expr_dispatches(right, fn_names)
        case HirExprKind.NullCoalesce(left, right): rt_expr_dispatches(left, fn_names) or rt_expr_dispatches(right, fn_names)
        case HirExprKind.Unary(_, value): rt_expr_dispatches(value, fn_names)
        case HirExprKind.Call(callee, args, _):
            if rt_direct_callee_dispatches(callee, fn_names): return true
            for arg in args:
                if rt_expr_dispatches(arg.value, fn_names): return true
            false
        # The shared callee extractor currently does not emit method/static
        # edges. Reject every such edge as untraced instead of pretending a
        # resolved receiver also proves the callee's transitive effects.
        case HirExprKind.MethodCall(_, _, _, _): true
        case HirExprKind.StaticCall(_, _, _, _): true
        case HirExprKind.If(cond, then_, else_):
            if rt_expr_dispatches(cond, fn_names) or rt_block_dispatches(then_, fn_names): return true
            match else_:
                Some(block): rt_block_dispatches(block, fn_names)
                nil: false
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                if rt_expr_dispatches(arm.cond, fn_names) or rt_block_dispatches(arm.then_, fn_names): return true
            match else_:
                Some(block): rt_block_dispatches(block, fn_names)
                nil: false
        case HirExprKind.MatchCase(scrutinee, arms):
            if rt_expr_dispatches(scrutinee, fn_names): return true
            for arm in arms:
                if rt_block_dispatches(arm.body, fn_names): return true
            false
        case HirExprKind.Loop(body, _): rt_block_dispatches(body, fn_names)
        case HirExprKind.While(cond, body, _): rt_expr_dispatches(cond, fn_names) or rt_block_dispatches(body, fn_names)
        case HirExprKind.For(_, iter, body, _): rt_expr_dispatches(iter, fn_names) or rt_block_dispatches(body, fn_names)
        case HirExprKind.With(items, body):
            for item in items:
                if rt_expr_dispatches(item.context_expr, fn_names): return true
            if rt_block_dispatches(body, fn_names): return true
            true
        case HirExprKind.Lambda(_, body, _): rt_expr_dispatches(body, fn_names)
        case HirExprKind.Block(body): rt_block_dispatches(body, fn_names)
        case HirExprKind.HostGpuLane(_, _, marker, body):
            if rt_expr_dispatches(marker, fn_names): return true
            if rt_block_dispatches(body, fn_names): return true
            true
        case HirExprKind.UnsafeBlock(body): rt_block_dispatches(body, fn_names)
        case HirExprKind.Return(value):
            match value:
                Some(v): rt_expr_dispatches(v, fn_names)
                nil: false
        case HirExprKind.Break(_, value):
            match value:
                Some(v): rt_expr_dispatches(v, fn_names)
                nil: false
        case HirExprKind.Continue(_): false
        case HirExprKind.Throw(value): rt_expr_dispatches(value, fn_names)
        case HirExprKind.Try(value): rt_expr_dispatches(value, fn_names)
        case HirExprKind.Await(value):
            if rt_expr_dispatches(value, fn_names): return true
            true
        case HirExprKind.Yield(value):
            match value:
                Some(v):
                    if rt_expr_dispatches(v, fn_names): return true
                nil: pass_dn
            true
        case HirExprKind.StructLit(_, fields):
            for field in fields:
                if rt_expr_dispatches(field[1], fn_names): return true
            false
        case HirExprKind.EnumLit(_, _, payload):
            match payload:
                Some(HirEnumPayload.Tuple(values)):
                    for value in values:
                        if rt_expr_dispatches(value, fn_names): return true
                    false
                Some(HirEnumPayload.Struct(fields)):
                    for field in fields:
                        if rt_expr_dispatches(field[1], fn_names): return true
                    false
                nil: false
        case HirExprKind.Cast(value, _): rt_expr_dispatches(value, fn_names)
        case HirExprKind.As(value, _): rt_expr_dispatches(value, fn_names)
        case HirExprKind.Range(start, end, _, step):
            if rt_expr_dispatches(start, fn_names) or rt_expr_dispatches(end, fn_names): return true
            match step:
                Some(value): rt_expr_dispatches(value, fn_names)
                nil: false
        case HirExprKind.Comprehension(_, _, _): true
        case HirExprKind.CustomBlock(_, _): true
        case HirExprKind.LossBlock(body): rt_block_dispatches(body, fn_names)
        case HirExprKind.NogradBlock(body): rt_block_dispatches(body, fn_names)
        case HirExprKind.InlineAsm(_): true
        case HirExprKind.InlineAsmMatch(_): true
        case HirExprKind.Error: true
        case HirExprKind.TypeTest(value, _): rt_expr_dispatches(value, fn_names)
        case _:
            true

fn rt_expr_allocates(expr: HirExpr) -> bool:
    match expr.kind:
        case HirExprKind.IntLit(_, _): false
        case HirExprKind.FloatLit(_, _): false
        case HirExprKind.BoolLit(_): false
        case HirExprKind.CharLit(_): false
        case HirExprKind.UnitLit: false
        case HirExprKind.NilLit: false
        case HirExprKind.ArrayLit(_, _): true
        case HirExprKind.ArrayRepeat(_, _, _): true
        case HirExprKind.DictLit(_, _, _): true
        case HirExprKind.SetLit(_, _): true
        case HirExprKind.Comprehension(_, _, _): true
        case HirExprKind.StringLit(_, interpolations):
            match interpolations:
                Some(parts): parts.len() > 0
                nil: false
        case HirExprKind.TupleLit(elements):
            for item in elements:
                if rt_expr_allocates(item): return true
            false
        case HirExprKind.Var(_): false
        case HirExprKind.NamedVar(_, _): false
        case HirExprKind.Field(base, _, _): rt_expr_allocates(base)
        case HirExprKind.Index(base, index): rt_expr_allocates(base) or rt_expr_allocates(index)
        case HirExprKind.TupleIndex(base, _): rt_expr_allocates(base)
        case HirExprKind.OptionalChain(base, _): rt_expr_allocates(base)
        case HirExprKind.ExistsCheck(base): rt_expr_allocates(base)
        case HirExprKind.Unwrap(base): rt_expr_allocates(base)
        case HirExprKind.Call(callee, args, _):
            if rt_expr_allocates(callee): return true
            for arg in args:
                if rt_expr_allocates(arg.value): return true
            false
        case HirExprKind.MethodCall(receiver, _, args, _):
            if rt_expr_allocates(receiver): return true
            for arg in args:
                if rt_expr_allocates(arg.value): return true
            false
        case HirExprKind.StaticCall(_, _, args, _):
            for arg in args:
                if rt_expr_allocates(arg.value): return true
            false
        case HirExprKind.If(cond, then_, else_):
            if rt_expr_allocates(cond) or rt_block_allocates(then_): return true
            match else_:
                Some(block): rt_block_allocates(block)
                nil: false
        case HirExprKind.IfChain(arms, else_):
            for arm in arms:
                if rt_expr_allocates(arm.cond) or rt_block_allocates(arm.then_): return true
            match else_:
                Some(block): rt_block_allocates(block)
                nil: false
        case HirExprKind.MatchCase(scrutinee, arms):
            if rt_expr_allocates(scrutinee): return true
            for arm in arms:
                if rt_block_allocates(arm.body): return true
            false
        case HirExprKind.Loop(body, _): rt_block_allocates(body)
        case HirExprKind.While(cond, body, _): rt_expr_allocates(cond) or rt_block_allocates(body)
        case HirExprKind.For(_, iter, body, _): rt_expr_allocates(iter) or rt_block_allocates(body)
        case HirExprKind.With(items, body):
            for item in items:
                if rt_expr_allocates(item.context_expr): return true
            rt_block_allocates(body)
        case HirExprKind.Block(body): rt_block_allocates(body)
        case HirExprKind.HostGpuLane(_, _, marker, body): rt_expr_allocates(marker) or rt_block_allocates(body)
        case HirExprKind.UnsafeBlock(body): rt_block_allocates(body)
        case HirExprKind.LossBlock(body): rt_block_allocates(body)
        case HirExprKind.NogradBlock(body): rt_block_allocates(body)
        case HirExprKind.Lambda(_, body, _): rt_expr_allocates(body)
        case HirExprKind.Binary(_, left, right): rt_expr_allocates(left) or rt_expr_allocates(right)
        case HirExprKind.NullCoalesce(left, right): rt_expr_allocates(left) or rt_expr_allocates(right)
        case HirExprKind.Unary(_, value): rt_expr_allocates(value)
        case HirExprKind.Return(value):
            match value:
                Some(v): rt_expr_allocates(v)
                nil: false
        case HirExprKind.Break(_, value):
            match value:
                Some(v): rt_expr_allocates(v)
                nil: false
        case HirExprKind.Continue(_): false
        case HirExprKind.Throw(value): rt_expr_allocates(value)
        case HirExprKind.Try(value): rt_expr_allocates(value)
        case HirExprKind.Await(value): rt_expr_allocates(value)
        case HirExprKind.Yield(value):
            match value:
                Some(v): rt_expr_allocates(v)
                nil: false
        case HirExprKind.StructLit(_, fields):
            for field in fields:
                if rt_expr_allocates(field[1]): return true
            false
        case HirExprKind.EnumLit(_, _, payload):
            match payload:
                Some(HirEnumPayload.Tuple(values)):
                    for value in values:
                        if rt_expr_allocates(value): return true
                    false
                Some(HirEnumPayload.Struct(fields)):
                    for field in fields:
                        if rt_expr_allocates(field[1]): return true
                    false
                nil: false
        case HirExprKind.Cast(value, _): rt_expr_allocates(value)
        case HirExprKind.As(value, _): rt_expr_allocates(value)
        case HirExprKind.Range(start, end, _, step):
            if rt_expr_allocates(start) or rt_expr_allocates(end): return true
            match step:
                Some(value): rt_expr_allocates(value)
                nil: false
        case HirExprKind.CustomBlock(_, _): true
        case HirExprKind.InlineAsm(_): false
        case HirExprKind.InlineAsmMatch(_): false
        case HirExprKind.Error: true
        case HirExprKind.TypeTest(value, _): rt_expr_allocates(value)
        case _:
            true

fn rt_module_ids(modules: Dict<text, HirModule>) -> [text]:
    var ids: [text] = []
    for key in modules.keys():
        val module = modules[key]
        if not ids.contains(key): ids.push(key)
        if module.path != "" and not ids.contains(module.path): ids.push(module.path)
        if module.name != "" and not ids.contains(module.name): ids.push(module.name)
    ids

fn rt_stable_fn_id(module_key: text, symbol_id: i64) -> text:
    module_key + "#" + symbol_id.to_text()

fn rt_module_matches(module_key: text, module: HirModule, claim_path: text) -> bool:
    claim_path == module_key or claim_path == module.path or claim_path == module.name

fn rt_unambiguous_symbol_names(modules: Dict<text, HirModule>) -> Dict<i64, text>:
    var names: Dict<i64, text> = {}
    var owners: Dict<i64, text> = {}
    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            val id = fn_.symbol.id
            if owners.contains_key(id) and owners[id] != module_key:
                names[id] = "__rt_ambiguous_symbol__"
            else:
                owners[id] = module_key
                names[id] = fn_.name
    names

fn rt_admit_with_manifest(root_id: text, facts: [RtCriticalFact]) -> [text]:
    val digest = rt_closure_digest(root_id, facts)
    val capabilities = rt_bound_manifest_capabilities()
    var adjusted: [RtCriticalFact] = []
    for fact in facts:
        val reviewed = rt_reviewed_bound_mask(fact.name, digest,
            rt_fact_observed_units(fact), capabilities)
        adjusted.push(RtCriticalFact(name: fact.name,
            own_effects: fact.own_effects,
            bounded_effects: fact.bounded_effects | reviewed,
            callees: fact.callees, line: fact.line,
            effect_units: fact.effect_units))
    rt_critical_admit(root_id, adjusted)

fn rt_hal_facts_with_reviewed_intrinsic(root_id: text,
    facts: [RtCriticalFact]) -> [RtCriticalFact]:
    val intrinsic_id = root_id + "::__rt_hal_boundary_enqueue_intrinsic"
    var out: [RtCriticalFact] = []
    for fact in facts:
        if fact.name == root_id:
            var callees = fact.callees
            callees.push(intrinsic_id)
            out.push(RtCriticalFact(name: fact.name,
                own_effects: fact.own_effects,
                bounded_effects: fact.bounded_effects,
                callees: callees, line: fact.line,
                effect_units: fact.effect_units))
        else:
            out.push(fact)
    var units: Dict<i64, i64> = {}
    units[RT_EFFECT_DISPATCH] = 1
    # Compiler-owned MIR injection is one bounded enqueue/dispatch per normal
    # exit. Its bound is intrinsic and cannot authorize any user/callee edge.
    out.push(RtCriticalFact(name: intrinsic_id,
        own_effects: RT_EFFECT_DISPATCH,
        bounded_effects: 0,
        callees: [], line: 0, effect_units: units))
    val digest = rt_closure_digest(root_id, out)
    val reviewed = [RtBoundCapability(subject_id: intrinsic_id,
        closure_digest: digest, effect: RT_EFFECT_DISPATCH,
        max_units: 1, review_id: "COMPILER-RT-HAL-INTRINSIC-V1")]
    val mask = rt_reviewed_bound_mask(intrinsic_id, digest, units, reviewed)
    var sealed: [RtCriticalFact] = []
    for fact in out:
        if fact.name == intrinsic_id:
            sealed.push(RtCriticalFact(name: fact.name,
                own_effects: fact.own_effects, bounded_effects: mask,
                callees: fact.callees, line: fact.line,
                effect_units: fact.effect_units))
        else:
            sealed.push(fact)
    sealed

fn rt_annotation_bound_diagnostic(fn_name: text, raw_bounds: text) -> text:
    if raw_bounds == "": return ""
    "error[RT-E-BOUND-CAPABILITY-UNVERIFIED]: @rt declaration '" +
        fn_name + "' uses annotation bounds; provide a reviewed typed numeric capability bound to the function closure"

fn rt_push_error(diagnostics: [RtCriticalDiagnostic], message: text) -> [RtCriticalDiagnostic]:
    diagnostics.push(RtCriticalDiagnostic(
        severity: RtCriticalDiagnosticSeverity.Error, message: message))

fn rt_push_warning(diagnostics: [RtCriticalDiagnostic], message: text) -> [RtCriticalDiagnostic]:
    diagnostics.push(RtCriticalDiagnostic(
        severity: RtCriticalDiagnosticSeverity.Warning, message: message))

val RT_REVIEWED_AUTHORITY_GROUP_LIMIT: i64 = 64

fn rt_fact_effect_units_scalar(fact: RtCriticalFact, effect: i64) -> i64:
    if fact.effect_units.len() > 0:
        if fact.effect_units.contains_key(effect): return fact.effect_units[effect]
        return 0
    if (fact.own_effects & effect) != 0: return 1
    0

val RT_REVIEWED_CAPABILITY_LIMIT: i64 = 4096
val RT_REVIEWED_AUTHORITY_ENTRY_LIMIT: i64 = 4096

fn validate_rt_criticality_diagnostics(modules: Dict<text, HirModule>) -> [RtCriticalDiagnostic]:
    var diagnostics: [RtCriticalDiagnostic] = []
    val claims = rt_criticality_claim_keys()
    var has_rt_hal = false
    for module in modules.values():
        for fn_ in module.functions.values():
            if fn_.func_attr.is_rt_hal: has_rt_hal = true
    if claims.len() == 0 and not has_rt_hal:
        rt_bound_manifest_clear()
        return diagnostics
    val names = rt_unambiguous_symbol_names(modules)
    # Bare names are translated only when unique. Duplicate unqualified names
    # never alias silently: their edges become unknown and fail closed.
    var unique_ids: Dict<text, text> = {}
    var ambiguous: Dict<text, bool> = {}
    # Claim keys use the parser's canonical `path|function` identity. Build all
    # accepted module aliases while visiting each function once, so root
    # resolution is O(V + R), not one full module scan per declaration.
    var claim_root_lookup: Dict<text, text> = {}
    var ambiguous_claim_roots: Dict<text, bool> = {}
    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            val stable = rt_stable_fn_id(module_key, fn_.symbol.id)
            if unique_ids.contains_key(fn_.name):
                ambiguous[fn_.name] = true
            else:
                unique_ids[fn_.name] = stable
            val key_by_module = module_key + "|" + fn_.name
            if claim_root_lookup.contains_key(key_by_module) and
               claim_root_lookup[key_by_module] != stable:
                ambiguous_claim_roots[key_by_module] = true
            else:
                claim_root_lookup[key_by_module] = stable
            if module.path != "":
                val key_by_path = module.path + "|" + fn_.name
                if claim_root_lookup.contains_key(key_by_path) and
                   claim_root_lookup[key_by_path] != stable:
                    ambiguous_claim_roots[key_by_path] = true
                else:
                    claim_root_lookup[key_by_path] = stable
            if module.name != "":
                val key_by_name = module.name + "|" + fn_.name
                if claim_root_lookup.contains_key(key_by_name) and
                   claim_root_lookup[key_by_name] != stable:
                    ambiguous_claim_roots[key_by_name] = true
                else:
                    claim_root_lookup[key_by_name] = stable
    var facts: [RtCriticalFact] = []
    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            var own = rt_name_effects(fn_.name)
            var units = rt_observed_effect_units(own)
            if rt_block_allocates(fn_.body):
                own = own | RT_EFFECT_ALLOC
                units[RT_EFFECT_ALLOC] = 1
            if rt_block_dispatches(fn_.body, names):
                own = own | RT_EFFECT_DISPATCH | RT_EFFECT_UNKNOWN
                units[RT_EFFECT_DISPATCH] = 1
            var unbounded_loop_count: i64 = 0
            for loop in effect_block_loops(fn_.body):
                if loop.bound_kind == LOOP_BOUND_NONE or loop.grows_container:
                    own = own | RT_EFFECT_LOOP
                    unbounded_loop_count = unbounded_loop_count + 1
            if unbounded_loop_count > 0: units[RT_EFFECT_LOOP] = unbounded_loop_count
            var stable_callees: [text] = []
            for raw_callee in effect_block_callees(fn_.body, names):
                if unique_ids.contains_key(raw_callee) and not ambiguous.contains_key(raw_callee):
                    stable_callees.push(unique_ids[raw_callee])
                else:
                    stable_callees.push("__rt_unknown_call__")
            facts.push(RtCriticalFact(name: rt_stable_fn_id(module_key, fn_.symbol.id), own_effects: own,
                bounded_effects: 0, callees: stable_callees,
                line: fn_.span.line, effect_units: units))
    # Resolve every root once, then propagate the strongest declaration rank
    # backwards through the existing call graph.  An unqualified @rt(hal) root
    # is Critical even in a default/moderate compilation, and a lower root that
    # reaches a Critical dependency is promoted rather than silently weakened.
    var claim_root_ids: Dict<text, text> = {}
    var declared_ranks: Dict<text, i64> = {}
    var declared_root_count: i64 = 0
    for key in claims:
        var root_id = ""
        if claim_root_lookup.contains_key(key) and
           not ambiguous_claim_roots.contains_key(key):
            root_id = claim_root_lookup[key]
        claim_root_ids[key] = root_id
        val rank = rt_profile_assurance_rank(rt_criticality_profile(key))
        if root_id != "":
            if not declared_ranks.contains_key(root_id):
                declared_ranks[root_id] = rank
                declared_root_count = declared_root_count + 1
            elif rank > declared_ranks[root_id]:
                declared_ranks[root_id] = rank
    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            if fn_.func_attr.is_rt_hal:
                val root_id = rt_stable_fn_id(module_key, fn_.symbol.id)
                if not declared_ranks.contains_key(root_id):
                    declared_ranks[root_id] = 3
                    declared_root_count = declared_root_count + 1
                elif declared_ranks[root_id] < 3:
                    declared_ranks[root_id] = 3
    # Reject oversized reviewed manifests before graph scratch or authority
    # maps are allocated. The digest set grows to at most limit+1 so even an
    # adversarial manifest cannot force unbounded pre-admission storage.
    val capability_count = rt_bound_manifest_count()
    var manifest_capacity_ok = true
    var digest_groups: Dict<text, bool> = {}
    if capability_count > RT_REVIEWED_CAPABILITY_LIMIT or
       (capability_count > 0 and
        declared_root_count > RT_REVIEWED_AUTHORITY_GROUP_LIMIT):
        manifest_capacity_ok = false
    if manifest_capacity_ok:
        var capability_index = 0
        while capability_index < capability_count:
            val capability = rt_bound_manifest_capability_at(
                capability_index).unwrap()
            capability_index = capability_index + 1
            if capability.closure_digest == "" or
               digest_groups.contains_key(capability.closure_digest):
                continue
            digest_groups[capability.closure_digest] = true
            if digest_groups.len() > RT_REVIEWED_AUTHORITY_GROUP_LIMIT:
                manifest_capacity_ok = false
                break
    if not manifest_capacity_ok:
        diagnostics = rt_push_error(diagnostics,
            "error[RT-E-BOUND-AUTHORITY-CAPACITY]: reviewed RT authority exceeds the bounded 64-root/64-digest/4096-capability admission capacity")
        rt_bound_manifest_clear()
        return diagnostics

    val fact_index = rt_fact_index(facts)
    var authority_masks: Dict<text, i64> = {}
    if manifest_capacity_ok:
        var capability_index = 0
        while capability_index < capability_count:
            val capability = rt_bound_manifest_capability_at(
                capability_index).unwrap()
            capability_index = capability_index + 1
            if capability.closure_digest == "" or
               capability.review_id == "" or
               capability.max_units <= 0 or
               not rt_effect_is_single(capability.effect) or
               not fact_index.contains_key(capability.subject_id):
                continue
            val subject_fact = facts[fact_index[capability.subject_id]]
            val actual = rt_fact_effect_units_scalar(
                subject_fact, capability.effect)
            if actual <= 0 or actual > capability.max_units: continue
            val authority_key = capability.closure_digest + "|" +
                capability.subject_id
            if not authority_masks.contains_key(authority_key) and
               authority_masks.len() >= RT_REVIEWED_AUTHORITY_ENTRY_LIMIT:
                manifest_capacity_ok = false
                diagnostics = rt_push_error(diagnostics,
                    "error[RT-E-BOUND-AUTHORITY-CAPACITY]: reviewed RT authority exceeds the bounded 4096 authority-entry admission capacity")
                break
            authority_masks[authority_key] =
                (authority_masks[authority_key] ?? 0) | capability.effect
    if not manifest_capacity_ok:
        rt_bound_manifest_clear()
        return diagnostics

    val effective_ranks = rt_effective_assurance_closure(facts, declared_ranks)
    var closure_scratch = RtCriticalClosureScratch.build(facts)
    var no_reviewed_authority: Dict<text, i64> = {}
    val base_closure_ok = closure_scratch.compute(facts, no_reviewed_authority)
    var closure_masks: [i64] = []
    var fact_position = 0
    while fact_position < facts.len():
        if base_closure_ok:
            closure_masks.push(closure_scratch.mask_at(fact_position))
        else:
            closure_masks.push(RT_EFFECT_UNKNOWN)
        fact_position = fact_position + 1
    val admission_bits = [RT_EFFECT_ALLOC, RT_EFFECT_BLOCKING, RT_EFFECT_LOOP,
        RT_EFFECT_RECURSION, RT_EFFECT_DISPATCH, RT_EFFECT_LOGGING,
        RT_EFFECT_SYNC, RT_EFFECT_LOADER, RT_EFFECT_UNKNOWN]
    # V1 authority digests include the root identity, so exact reviewed bounds
    # require one propagation per distinct digest authority. Both roots and
    # groups are explicitly capped; overflow is a typed fatal diagnostic and
    # all capabilities are ignored (fail closed). One scratch graph is reused
    # sequentially and only the final scalar root mask is retained.
    var reviewed_root_masks: Dict<text, i64> = {}
    if manifest_capacity_ok and capability_count > 0:
        var rt_roots: [text] = []
        for fact in facts:
            if declared_ranks.contains_key(fact.name): rt_roots.push(fact.name)
        val digest_material = rt_closure_digest_material(facts)
        for root_id in rt_roots:
            val digest = rt_closure_digest_from_material(root_id, digest_material)
            if not digest_groups.contains_key(digest): continue
            if closure_scratch.compute(facts, authority_masks, digest) and
               fact_index.contains_key(root_id):
                reviewed_root_masks[root_id] = closure_scratch.mask_at(
                    fact_index[root_id])
    var admitted_roots: Dict<text, bool> = {}
    for key in claims:
        val fn_name = rt_criticality_claim_fn(key)
        val profile = rt_criticality_profile(key)
        val root_id = claim_root_ids[key] ?? ""
        # The parser exclusively owns the implicit warning/error, preventing a
        # warning+error pair at the promotion epoch. Semantics owns explicit
        # profile validity and lower-tier reasons.
        if profile != "":
            for d in rt_critical_profile_diagnostics(fn_name, profile,
                rt_criticality_reason(key), rt_implicit_profile_is_error()):
                if d.starts_with("error["): diagnostics = rt_push_error(diagnostics, d)
        val raw_bound_error = rt_annotation_bound_diagnostic(fn_name,
            rt_criticality_bounds_for(key))
        if raw_bound_error != "": diagnostics = rt_push_error(diagnostics, raw_bound_error)
        # Only resolved roots deduplicate by graph identity. Each unresolved or
        # ambiguous declaration retains its own claim identity and diagnostic.
        val admission_identity = if root_id == "": "claim:" + key else: root_id
        if admitted_roots.contains_key(admission_identity): continue
        var effective_rank = rt_profile_assurance_rank(profile)
        if fact_index.contains_key(root_id):
            effective_rank = effective_ranks[fact_index[root_id]]
        var root_rejected = RT_EFFECT_UNKNOWN
        if fact_index.contains_key(root_id):
            root_rejected = closure_masks[fact_index[root_id]]
        if reviewed_root_masks.contains_key(root_id):
            root_rejected = reviewed_root_masks[root_id]
        if effective_rank >= 3:
            # The compiler-owned HAL enqueue is a reviewed bounded dispatch,
            # so it contributes no rejected user effect. Admit HAL and ordinary
            # roots against the same precomputed user closure; this removes the
            # former unbounded H*(V+E) modified-graph recomputation.
            for bit in admission_bits:
                if (root_rejected & bit) != 0:
                    diagnostics = rt_push_error(diagnostics,
                        "error[RT-E-UNBOUNDED-" + rt_effect_name(bit).to_upper() +
                        "]: critical RT closure '" + admission_identity +
                        "' contains unproved " + rt_effect_name(bit))
        elif fact_index.contains_key(root_id) and
             (root_rejected & RT_EFFECT_ALLOC) != 0:
            val code = if rt_implicit_profile_is_error():
                "error[RT-E-STEADY-ALLOCATION-001]"
            else:
                "warning[RT-W-STEADY-ALLOCATION-001]"
            val message = code + ": explicit lower-tier RT closure '" + fn_name +
                "' contains unproved steady-state allocation"
            if rt_implicit_profile_is_error():
                diagnostics = rt_push_error(diagnostics, message)
            else:
                diagnostics = rt_push_warning(diagnostics, message)
        admitted_roots[admission_identity] = true
    # Non-flat/full frontend routes preserve @rt(hal) directly in FunctionAttr
    # and do not emit the flat parser's inert criticality marker. Admit those
    # roots here with the same default critical closure, exactly once.
    for module_key in modules.keys():
        val module = modules[module_key]
        for fn_ in module.functions.values():
            if not fn_.func_attr.is_rt_hal: continue
            val root_id = rt_stable_fn_id(module_key, fn_.symbol.id)
            if admitted_roots.contains_key(root_id): continue
            var rejected = RT_EFFECT_UNKNOWN
            if fact_index.contains_key(root_id):
                rejected = closure_masks[fact_index[root_id]]
            if reviewed_root_masks.contains_key(root_id):
                rejected = reviewed_root_masks[root_id]
            for bit in admission_bits:
                if (rejected & bit) != 0:
                    diagnostics = rt_push_error(diagnostics,
                        "error[RT-E-UNBOUNDED-" + rt_effect_name(bit).to_upper() +
                        "]: critical RT closure '" + root_id +
                        "' contains unproved " + rt_effect_name(bit))
            admitted_roots[root_id] = true
    # Claims are emitted in parser registry/source order; remaining full-HIR
    # HAL roots follow the driver's module/function insertion order. Preserve
    # that stable producer order instead of an O(D^2) insertion sort.
    # A config owner must seal a fresh manifest for every compilation. Never
    # let reviewed authority leak into a later long-lived compiler request.
    rt_bound_manifest_clear()
    diagnostics

fn validate_rt_criticality(modules: Dict<text, HirModule>) -> [text]:
    var errors: [text] = []
    for diagnostic in validate_rt_criticality_diagnostics(modules):
        if diagnostic.severity == RtCriticalDiagnosticSeverity.Error:
            errors.push(diagnostic.message)
    errors

