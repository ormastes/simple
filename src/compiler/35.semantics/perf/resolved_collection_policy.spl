# ResolvedCollectionPolicyV1 — the collection row of the W1 data-policy
# envelope (data plan W1; adaptive collections plan 5.1/5.2, C2).
#
# One immutable record per collection creation origin. Source attributes
# (`@collection_algorithm` plus at most one site label) and SDN
# `data_policy.rules` rows both lower to it through the one W1 resolver.
# The canonical digest excludes provenance, so equivalent source and SDN
# declarations give byte-identical digests; provenance is kept alongside.
# Representation choices reuse CollectionPlanAlgorithm; no new enum.
#
# Deferred from the adaptive plan 5.1 sketch until a consumer needs them (W4/
# C5): semantic_contract_ref (CollectionSemanticContractV1 digest),
# objective_and_resource_budgets, named_policy_dependencies and per-field
# provenance. The record carries rule-level provenance only.

use std.common.crypto.sha256.{sha256_text}
use compiler.common.data.data_schema_contracts.*
use compiler.semantics.perf.collection_plan_selection.{CollectionPlanAlgorithm}
use compiler.semantics.perf.resolved_data_policy.{resolved_collection_token_v1}
use compiler.semantics.perf_facts.collection_contracts.{CollectionOriginV1}

pub const RESOLVED_COLLECTION_POLICY_CONTRACT_V1: i64 = 1
pub const RESOLVED_COLLECTION_POLICY_DIGEST_DOMAIN_V1: text = "simple.collection-policy/v1"

pub struct ResolvedCollectionPolicyV1:
    contract_version: i64
    origin: CollectionOriginV1
    choice: DataPolicyChoiceV1
    allowed_representations: [CollectionPlanAlgorithm]
    # Opaque references to hard constraints owned elsewhere (ABI, ownership,
    # progress); sorted. A profile can never remove one.
    hard_constraints: [text]
    # `key=value` workload hints; sorted.
    workload_hints: [text]
    # One of the data plan 11.1 application modes.
    switch_policy: text
    # resolved_policy_digest of the composed layout policy, or "".
    layout_policy_ref: text
    provenances: [DataDeclProvenanceV1]
    canonical_policy_digest: text

fn collection_sorted_v1(items: [text]) -> [text]:
    var out: [text] = []
    for item in items:
        var index = out.len()
        out.push(item)
        while index > 0 and out[index] < out[index - 1]:
            val swap = out[index - 1]
            out[index - 1] = out[index]
            out[index] = swap
            index = index - 1
    out

pub fn resolved_collection_switch_policy_valid_v1(mode: text) -> bool:
    mode == "report_only" or mode == "next_build" or mode == "next_instance" or
        mode == "new_snapshot" or mode == "exclusive_live" or mode == "shared_safe_point"

fn collection_lp_v1(value: text) -> text:
    "{value.len()}:{value}"

pub fn resolved_collection_policy_v1(origin: CollectionOriginV1, choice: DataPolicyChoiceV1,
                                     allowed: [CollectionPlanAlgorithm], hard_constraints: [text],
                                     workload_hints: [text], switch_policy: text,
                                     layout_policy_ref: text) -> Result<ResolvedCollectionPolicyV1, text>:
    if origin.origin_id.len() == 0:
        return Err("collection policy needs a creation origin")
    if data_policy_kind_code_v1(choice.kind) != data_policy_kind_code_v1(DataPolicyKindV1.Collection):
        return Err("choice is not a collection policy")
    if allowed.len() == 0:
        return Err("no allowed collection representation")
    var tokens: [text] = []
    for algorithm in allowed:
        val token = resolved_collection_token_v1(algorithm)
        for seen in tokens:
            if seen == token:
                return Err("representation '{token}' listed twice")
        tokens.push(token)
    if choice.choice != "auto":
        var admitted = false
        for token in tokens:
            if token == choice.choice:
                admitted = true
        if not admitted:
            return Err("choice '{choice.choice}' is not an allowed representation")
    if not resolved_collection_switch_policy_valid_v1(switch_policy):
        return Err("unknown switch policy '{switch_policy}'")
    val constraints = collection_sorted_v1(hard_constraints)
    val hints = collection_sorted_v1(workload_hints)
    for i in 1..constraints.len():
        if constraints[i] == constraints[i - 1]:
            return Err("hard constraint '{constraints[i]}' listed twice")
    for i in 1..hints.len():
        if hints[i] == hints[i - 1]:
            return Err("workload hint '{hints[i]}' listed twice")
    var canonical = RESOLVED_COLLECTION_POLICY_DIGEST_DOMAIN_V1 + "\norigin=" + collection_lp_v1(origin.origin_id) +
        "\nchoice=" + collection_lp_v1(choice.choice) + "\ndefault={choice.from_default}\nallowed="
    for token in collection_sorted_v1(tokens):
        canonical = canonical + collection_lp_v1(token)
    canonical = canonical + "\nconstraints="
    for c in constraints:
        canonical = canonical + collection_lp_v1(c)
    canonical = canonical + "\nhints="
    for h in hints:
        canonical = canonical + collection_lp_v1(h)
    canonical = canonical + "\nswitch=" + collection_lp_v1(switch_policy) + "\nlayout=" + collection_lp_v1(layout_policy_ref) + "\n"
    Ok(ResolvedCollectionPolicyV1(contract_version: RESOLVED_COLLECTION_POLICY_CONTRACT_V1,
        origin: origin, choice: choice, allowed_representations: allowed,
        hard_constraints: constraints, workload_hints: hints, switch_policy: switch_policy,
        layout_policy_ref: layout_policy_ref, provenances: choice.provenances,
        canonical_policy_digest: sha256_text(canonical)))

# ---------------------------------------------------------------------------
# Source binding (adaptive plan C2). One `@collection_algorithm(algo[, label])`
# becomes one exact-site W1 rule keyed by the parser's site ID: the label site
# `ast://<module>/label/<label>` or the `#n1.` hash site. "auto" states no
# preference, so it yields no rule and module/project rules still apply; any
# other algorithm is a binding source pin, so a conflicting SDN pin is a hard
# error rather than a silent winner.
# ---------------------------------------------------------------------------
pub fn collection_source_rules_v1(site_id: text, algorithm: text, path: text, line: i64,
                                  owner: text) -> Result<[DataPolicyRuleV1], text>:
    if algorithm != "auto" and algorithm != "linear" and algorithm != "hash" and algorithm != "ordered":
        return Err("unknown collection algorithm: {algorithm}")
    if not site_id.starts_with("ast://"):
        return Err("collection site '{site_id}' is not a parser site ID")
    if algorithm == "auto":
        return Ok([])
    Ok([data_policy_rule_v1(DataPolicyKindV1.Collection, site_id, DataRuleSpecificityV1.ExactSite,
        DataRuleStrengthV1.Pin, algorithm, false, data_decl_provenance_v1(DataDeclOriginV1.Spl, path, line, owner))])

fn collection_rule_applies_v1(origin: CollectionOriginV1, rule: DataPolicyRuleV1) -> bool:
    if data_policy_kind_code_v1(rule.kind) != data_policy_kind_code_v1(DataPolicyKindV1.Collection):
        return false
    match rule.specificity:
        case DataRuleSpecificityV1.ExactSite: rule.subject == origin.legacy_site_id
        case DataRuleSpecificityV1.Module: rule.subject == origin.module_key
        case DataRuleSpecificityV1.ProjectDefault: true
        # No owning-type collection subject is defined yet; never guess one.
        case DataRuleSpecificityV1.OwningType: false

pub fn resolved_collection_policy_for_site_v1(origin: CollectionOriginV1, rules: [DataPolicyRuleV1],
                                              switch_policy: text) -> Result<ResolvedCollectionPolicyV1, text>:
    """Resolve the source and SDN rules that apply to one creation origin."""
    var applicable: [DataPolicyRuleV1] = []
    for rule in rules:
        if collection_rule_applies_v1(origin, rule):
            applicable.push(rule)
    val choice = match data_policy_resolve_rules_v1(DataPolicyKindV1.Collection, applicable, "auto"):
        case Ok(c): c
        case Err(diagnostic): return Err(diagnostic.message)
    resolved_collection_policy_v1(origin, choice,
        [CollectionPlanAlgorithm.Linear, CollectionPlanAlgorithm.Hash, CollectionPlanAlgorithm.Ordered],
        [], [], switch_policy, "")
