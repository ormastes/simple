            case PerfFixKind.AlgorithmChange: "AlgorithmChange"

enum PerfFixApplicability:
    VerifiedSafe
    ReviewRequired
    Unavailable

impl PerfFixApplicability:
    fn name() -> text:
        match self:
            case PerfFixApplicability.VerifiedSafe: "VerifiedSafe"
            case PerfFixApplicability.ReviewRequired: "ReviewRequired"
            case PerfFixApplicability.Unavailable: "Unavailable"

struct LoopIdiomCandidateV1:
    rule_id: text
    action_id: text
    function_id: text
    semantic_revision: text
    dependency_fingerprint: text
    file: text
    source_span: Span
    family: LoopIdiomFamily
    replacement_preview: text
    expected_old_text: text
    applicability: PerfFixApplicability
    fix_kind: PerfFixKind
    obligations: [SafetyObligationStatusV1]
    resource_tradeoff_note: text
    disabled_reason: Option<text>

enum ContractVerificationVerdict:
    Verified
    Refuted
    Unproved

impl ContractVerificationVerdict:
    fn name() -> text:
        match self:
            case ContractVerificationVerdict.Verified: "Verified"
            case ContractVerificationVerdict.Refuted: "Refuted"
            case ContractVerificationVerdict.Unproved: "Unproved"

struct ResourceContractCheckV1:
    function_id: text
    resource: PerfResourceDimension
    declared_bound: CostExprV1
    declared_regime: BoundRegime
    strict_verification: bool
    verdict: ContractVerificationVerdict
    rule_code: text
    explanation: text
    witness_or_reason: text

struct PerfFindingRecordV1:
    rule_code: text
    stable_occurrence_id: text
    function_id: text
    file: text
    primary_span: Span
    related_locations: [ProvenanceEdgeV1]
    message: text
    evidence: Option<BoundEvidenceV1>
    tier: PerfAnalysisTier
    semantic_fingerprint: text
    fix_candidates: [LoopIdiomCandidateV1]

export PerfResourceDimension, BoundRelation, BoundRegime, AnalysisResultStatus
export BoundOrigin, PerfAnalysisTier, SizeMeasureKind, CostExprV1
export BoundEvidenceV1, SizeParameterV1, SizeRelationV1, ProvenanceEdgeV1
export FunctionCostSummaryV1, LoopIdiomFamily, SafetyObligationKind
export SafetyObligationStatusV1, PerfFixKind, PerfFixApplicability
export LoopIdiomCandidateV1, ContractVerificationVerdict, ResourceContractCheckV1
export PerfFindingRecordV1
