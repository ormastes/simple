            case LoopIdiomFamily.FilterMap: "filter_map"
            case LoopIdiomFamily.OrderedFold: "ordered_fold"
            case LoopIdiomFamily.AnySearch: "any"
            case LoopIdiomFamily.AllSearch: "all"
            case LoopIdiomFamily.FindSearch: "find"

enum SafetyObligationKind:
    CollectionIdentity
    Aliasing
    Mutation
    EvaluationOrder
    TimingEagerness
    FailurePrefixCleanup
    ControlFlowExits
    CaptureLifetime
    NumericSemantics
    OutputShapeDuplicates
    RuntimeEffects
    ResourceRestrictions
    RevisionCurrency

impl SafetyObligationKind:
    fn name() -> text:
        match self:
            case SafetyObligationKind.CollectionIdentity: "collection_identity"
            case SafetyObligationKind.Aliasing: "aliasing"
            case SafetyObligationKind.Mutation: "mutation"
            case SafetyObligationKind.EvaluationOrder: "evaluation_order"
            case SafetyObligationKind.TimingEagerness: "timing_eagerness"
            case SafetyObligationKind.FailurePrefixCleanup: "failure_prefix_cleanup"
            case SafetyObligationKind.ControlFlowExits: "control_flow_exits"
            case SafetyObligationKind.CaptureLifetime: "capture_lifetime"
            case SafetyObligationKind.NumericSemantics: "numeric_semantics"
            case SafetyObligationKind.OutputShapeDuplicates: "output_shape_duplicates"
            case SafetyObligationKind.RuntimeEffects: "runtime_effects"
            case SafetyObligationKind.ResourceRestrictions: "resource_restrictions"
            case SafetyObligationKind.RevisionCurrency: "revision_currency"

struct SafetyObligationStatusV1:
    kind: SafetyObligationKind
    discharged: bool
    reason: text

