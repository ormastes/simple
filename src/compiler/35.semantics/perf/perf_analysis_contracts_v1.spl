    Partial
    Unknown
    Cancelled

impl AnalysisResultStatus:
    fn name() -> text:
        match self:
            case AnalysisResultStatus.Complete: "Complete"
            case AnalysisResultStatus.Partial: "Partial"
            case AnalysisResultStatus.Unknown: "Unknown"
            case AnalysisResultStatus.Cancelled: "Cancelled"

enum BoundOrigin:
    Inferred
    ImportedContract
    Measured
    Heuristic

impl BoundOrigin:
    fn name() -> text:
        match self:
            case BoundOrigin.Inferred: "Inferred"
            case BoundOrigin.ImportedContract: "ImportedContract"
            case BoundOrigin.Measured: "Measured"
            case BoundOrigin.Heuristic: "Heuristic"

enum PerfAnalysisTier:
    T0ExistingFacts
    T1FastLocal
    T2Compositional
    T3DeepOptional
    T4Empirical

impl PerfAnalysisTier:
    fn name() -> text:
        match self:
            case PerfAnalysisTier.T0ExistingFacts: "T0"
            case PerfAnalysisTier.T1FastLocal: "T1"
            case PerfAnalysisTier.T2Compositional: "T2"
            case PerfAnalysisTier.T3DeepOptional: "T3"
            case PerfAnalysisTier.T4Empirical: "T4"

enum SizeMeasureKind:
    Length
    ByteLength
    CharCount
    NodeCount
    TreeDepth
    VertexCount
    EdgeCount
    GroupCount
    TotalElements
    DistinctKeys
    OutputMatches

impl SizeMeasureKind:
    fn name() -> text:
        match self:
            case SizeMeasureKind.Length: "length"
            case SizeMeasureKind.ByteLength: "bytes"
            case SizeMeasureKind.CharCount: "chars"
            case SizeMeasureKind.NodeCount: "nodes"
            case SizeMeasureKind.TreeDepth: "depth"
            case SizeMeasureKind.VertexCount: "vertices"
            case SizeMeasureKind.EdgeCount: "edges"
            case SizeMeasureKind.GroupCount: "group_count"
            case SizeMeasureKind.TotalElements: "total_elements"
            case SizeMeasureKind.DistinctKeys: "distinct_keys"
            case SizeMeasureKind.OutputMatches: "output_matches"

enum CostExprV1:
    Const(value: i64)
    Size(param_name: text, measure: SizeMeasureKind)
    Add(terms: [CostExprV1])
    Multiply(factors: [CostExprV1])
    Maximum(branches: [CostExprV1])
    LogBound(inner: CostExprV1)
    TriangularSum(outer: CostExprV1)
    AggregateSize(group_count: CostExprV1, total_elements: CostExprV1)
    KnownCalleeCost(callee_id: text, substituted: CostExprV1)
    CallbackTerm(callback_param: text, invocations: CostExprV1, body_cost: CostExprV1)
    UnknownTerm(reason: text)

struct BoundEvidenceV1:
    resource: PerfResourceDimension
    expression: CostExprV1
    rendered_expression: text
    relation: BoundRelation
    regime: BoundRegime
    model_id: text
    assumptions: [text]
    status: AnalysisResultStatus
    origin: BoundOrigin
    provenance_id: text

struct SizeParameterV1:
    param_name: text
    measure: SizeMeasureKind
    canonical_var: text

struct SizeRelationV1:
    lhs_var: text
    relation_op: text
    rhs_var: text

struct ProvenanceEdgeV1:
    node_id: text
    role: text
    file: text
    span: Span
    summary_line: text
    child_ids: [text]

struct FunctionCostSummaryV1:
    function_id: text
    function_symbol_id: i64
    semantic_revision: text
    size_parameters: [SizeParameterV1]
    size_relations: [SizeRelationV1]
    resource_bounds: [BoundEvidenceV1]
    output_cardinality: CostExprV1
    callback_cost_parameters: [text]
    effects_summary_id: text
    assumptions: [text]
    unresolved_terms: [text]
    dependency_summary_hashes: [text]
    implementation_digest: text
    provenance_root: text
    provenance_nodes: [ProvenanceEdgeV1]
    analyzer_version: text
    model_version: text
    configuration_fingerprint: text

enum LoopIdiomFamily:
    Map
    Filter
    FilterMap
    OrderedFold
    AnySearch
    AllSearch
    FindSearch

impl LoopIdiomFamily:
    fn name() -> text:
        match self:
