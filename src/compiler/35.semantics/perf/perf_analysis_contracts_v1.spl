# Performance Analysis and Collection Refactoring — Shared V1 Contracts
#
# Immutable side-table contracts shared across symbolic cost summaries,
# caller propagation, conservative loop-idiom recognition, 13-point refactor
# safety verification, resource contract verification, baseline comparison,
# lint batch projection, and LSP/CLI/MCP adapters.
#
# All records are read-only evidence/candidate structures. Normal compilation
# (T0) neither constructs nor depends on them unless an explicit lint/perf
# profile requests T1..T4 analysis.

use compiler.common.diagnostics.span.{Span}

enum PerfResourceDimension:
    Work
    AllocCount
    AllocBytesTotal
    AuxPeakBytes
    OutputBytes
    IoCalls
    IoBytes
    LockOps
    GpuTransferBytes

impl PerfResourceDimension:
    fn name() -> text:
        match self:
            case PerfResourceDimension.Work: "work"
            case PerfResourceDimension.AllocCount: "alloc_count"
            case PerfResourceDimension.AllocBytesTotal: "alloc_bytes_total"
            case PerfResourceDimension.AuxPeakBytes: "aux_peak_bytes"
            case PerfResourceDimension.OutputBytes: "output_bytes"
            case PerfResourceDimension.IoCalls: "io_calls"
            case PerfResourceDimension.IoBytes: "io_bytes"
            case PerfResourceDimension.LockOps: "lock_ops"
            case PerfResourceDimension.GpuTransferBytes: "gpu_transfer_bytes"

enum BoundRelation:
    UpperBound
    LowerBound
    Exact
    TightBound
    Estimate

impl BoundRelation:
    fn name() -> text:
        match self:
            case BoundRelation.UpperBound: "UpperBound"
            case BoundRelation.LowerBound: "LowerBound"
            case BoundRelation.Exact: "Exact"
            case BoundRelation.TightBound: "TightBound"
            case BoundRelation.Estimate: "Estimate"

enum BoundRegime:
    WorstCase
    Expected
    Amortized
    ExpectedAmortized

impl BoundRegime:
    fn name() -> text:
        match self:
            case BoundRegime.WorstCase: "WorstCase"
            case BoundRegime.Expected: "Expected"
            case BoundRegime.Amortized: "Amortized"
            case BoundRegime.ExpectedAmortized: "ExpectedAmortized"

enum AnalysisResultStatus:
