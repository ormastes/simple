# Layer-equivalence real-layout adapter (M2).
#
# Bridges the compiler's real struct-layout engine
# (`compiler.types.type_layout.compute_struct_layout`, backed by
# `_TypeLayout/layout_core.spl` + `arch_and_verify.spl`) into
# `layer_eq_checker.spl`'s `LayerEqType`/`LayerEqField` shape, so
# `check_layer_eq` can be fed the compiler's own computed offsets/sizes
# instead of hand-declared fixture facts.
#
# Promoted out of test/01_unit/compiler/semantics/
# layer_eq_checker_real_layout_spec.spl (which previously defined this
# adapter locally, spec-side only) per doc/03_plan/ui/perf/
# render_perf_replan_parallel_teams_2026-08-07.md T14. The spec now imports
# this production symbol instead of duplicating it.
#
# Deliberately kept in a sibling module rather than folded into
# layer_eq_checker.spl itself: layer_eq_checker.spl is self-contained (no HIR
# or type_layout imports) so it stays exercisable against synthetic
# LayerEqType fixtures without dragging in the layout engine's dependency
# graph; this adapter is the only piece that needs those imports.

use compiler.semantics.layer_eq_checker.{LayerEqField, LayerEqType}
use compiler.types.type_layout.{TypeLayout, type__to_text}

# Convert a real compiler `TypeLayout` (as produced by
# `compute_struct_layout`) into a `LayerEqType` that `check_layer_eq` can
# consume directly.
#
# `renames[i]` (parallel to `layout.fields`, by real declaration-order index)
# supplies the @layer_field target name for field i; "" means infer by same
# name — the same convention `LayerEqField.mapped_name` already uses.
#
# Ownership/mutability/address-space/unit/space/color/alpha tags are not
# carried by `TypeLayout` (a pure size/offset/align model), so they are left
# at their neutral defaults here (owned, mutable, no tags) — obligations 1-4
# are what this adapter proves against real layout; obligations 5-8 still
# need their declared-fact source wired separately.
fn layer_eq_type_from_layout(name: text, layout: TypeLayout, renames: [text]) -> LayerEqType:
    var out: [LayerEqField] = []
    var i = 0
    while i < layout.fields.len():
        val f = layout.fields[i]
        val rename = if i < renames.len(): renames[i] else: ""
        out.push(LayerEqField(
            name: f.name,
            type_name: type__to_text(f.type_),
            offset: f.offset,
            size: f.size,
            mapped_name: rename,
            ownership: "owned",
            mutable: true,
            address_space: "",
            unit_tag: "",
            space_tag: "",
            color_tag: "",
            alpha_tag: ""
        ))
        i = i + 1
    LayerEqType(name: name, total_size: layout.size, align: layout.align, fields: out,
        is_enum: false, discriminants: [])

export layer_eq_type_from_layout
