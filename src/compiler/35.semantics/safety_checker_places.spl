# Typed, bounded G7 class-owner collection places.
# Unsupported identities stay unmodeled; this is not a complete alias checker.
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.{Span}
use compiler.semantics.safety_checker.*

struct SafetyDeclaredCollectionField:
    field_id: i64
    is_collection: bool

struct SafetyClassAlias:
    owner_id: i64
    roots: Dict<i64, bool>

struct SafetyCollectionPlace:
    owner_id: i64
    field_id: i64
    roots: Dict<i64, bool>
    name: text

fn safety_class_owner(self: SafetyChecker, type_: HirType) -> i64:
    if type_ == nil: return -1
    match type_.kind:
        case Named(symbol, _):
            if self.context.place_class_ids.contains(symbol.id): return symbol.id
        case _: ()
    -1

fn safety_alias_value(self: SafetyChecker, value: HirExpr, owner: i64, fresh_id: i64) -> SafetyClassAlias?:
    match value.kind:
        case Var(symbol) | NamedVar(symbol, _):
            if self.context.class_aliases.contains(symbol.id):
                val alias = self.context.class_aliases[symbol.id]
                if alias.owner_id == owner: return alias
        case Call(callee, _, _):
            match callee.kind:
                case Var(symbol) | NamedVar(symbol, _):
                    if fresh_id >= 0 and symbol.id == owner:
                        return SafetyClassAlias(owner_id: owner, roots: {fresh_id: true})
                case _: ()
        case StructLit(type_, _):
            if fresh_id >= 0 and safety_class_owner(self, type_) == owner:
                return SafetyClassAlias(owner_id: owner, roots: {fresh_id: true})
        case _: ()
    nil

fn safety_alias_declare(self: SafetyChecker, symbol: SymbolId, type_: HirType, value: HirExpr):
    val owner = safety_class_owner(self, type_)
    if owner < 0: return
    if self.context.place_loop_depth > 0:
        self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(value.span)
    if val alias = safety_alias_value(self, value, owner, symbol.id):
        self.context.class_aliases[symbol.id] = alias
    else:
        self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(value.span)

fn safety_alias_rebind(self: SafetyChecker, target: HirExpr, value: HirExpr):
    match target.kind:
        case Var(symbol) | NamedVar(symbol, _):
            if self.context.class_aliases.contains(symbol.id):
                self.context.place_written_bindings[symbol.id] = true
                val previous = self.context.class_aliases[symbol.id]
                if val next = safety_alias_value(self, value, previous.owner_id, -1):
                    self.context.class_aliases[symbol.id] = next
                else:
                    # Forget stale identity: an opaque replacement cannot keep the old referent.
                    self.context.class_aliases.remove(symbol.id)
                    self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(value.span)
                if self.context.place_loop_depth > 0:
                    self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(target.span)
        case _: ()

fn safety_collection_place(self: SafetyChecker, expr: HirExpr) -> SafetyCollectionPlace?:
    match expr.kind:
        case Field(base, name, resolved):
            match base.kind:
                case Var(symbol) | NamedVar(symbol, _):
                    if self.context.class_aliases.contains(symbol.id):
                        val alias = self.context.class_aliases[symbol.id]
                        if self.context.place_owner_fields.contains(alias.owner_id):
                            val fields = self.context.place_owner_fields[alias.owner_id]
                            if fields.contains(name):
                                val declared = fields[name]
                                if declared.field_id >= 0 and declared.is_collection:
                                    if val field = resolved:
                                        if field.id != declared.field_id:
                                            self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(expr.span)
                                            return nil
                                    return SafetyCollectionPlace(owner_id: alias.owner_id, field_id: declared.field_id, roots: alias.roots, name: name)
                case _: ()
            self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(expr.span)
        case _: ()
    nil

fn safety_places_overlap(first: SafetyCollectionPlace, second: SafetyCollectionPlace) -> bool:
    if first.owner_id != second.owner_id or first.field_id != second.field_id: return false
    for root in first.roots:
        if second.roots.contains(root[0]): return true
    false

fn safety_flag_collection_place(self: SafetyChecker, expr: HirExpr, span: Span):
    if val place = safety_collection_place(self, expr):
        for active in self.context.collection_places:
            if safety_places_overlap(place, active):
                val msg = "E1048: collection '{place.name}' is mutated while being iterated"
                self.context.errors = self.context.errors.push(SafetyError.Other(msg, span))
                return

fn safety_alias_join(first: Dict<i64, SafetyClassAlias>, second: Dict<i64, SafetyClassAlias>) -> Dict<i64, SafetyClassAlias>:
    var joined: Dict<i64, SafetyClassAlias> = {}
    for key in first.keys():
        if second.contains(key):
            val mine: SafetyClassAlias = first[key]
            val other: SafetyClassAlias = second[key]
            if mine.owner_id == other.owner_id:
                var roots: Dict<i64, bool> = mine.roots
                for root in other.roots: roots[root[0]] = true
                joined[key] = SafetyClassAlias(owner_id: other.owner_id, roots: roots)
    joined

# Unsupported control-flow transfer: retain only incoming bindings not written
# by any visited path. Never export a last-arm/single-iteration state as exact.
fn safety_alias_forget_boundary(self: SafetyChecker, incoming: Dict<i64, SafetyClassAlias>, outer_writes: Dict<i64, bool>, span: Span):
    val writes = self.context.place_written_bindings
    var retained: Dict<i64, SafetyClassAlias> = {}
    for entry in incoming:
        if not writes.contains(entry[0]): retained[entry[0]] = entry[1]
    self.context.class_aliases = retained
    self.context.place_written_bindings = outer_writes
    for entry in writes:
        self.context.place_written_bindings[entry[0]] = true
    if writes.len() > 0:
        self.context.place_unmodeled_sites = self.context.place_unmodeled_sites.push(span)
