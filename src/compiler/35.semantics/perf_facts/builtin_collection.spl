# Canonical identity admission for existing builtin Array callback operations.
# This grants dispatch identity only, never callback purity or rewrite rights.
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirCallArg}
use compiler.hir.hir_types.{HirTypeKind, MethodResolution, CollectionBuiltinOperation}

fn resolve_builtin_collection_operation(
    receiver: HirExpr, method: text, args: [HirCallArg]
) -> MethodResolution?:
    if not receiver.has_type_ or receiver.type_ == nil:
        return nil
    match receiver.type_.kind:
        case HirTypeKind.Array(_, _): ()
        case _: return nil
    if args.len() != 1 or args[0].has_name:
        return nil
    # Match the actual native callback surface. Named callbacks and unknown
    # shapes remain on the original path until their ABI has been admitted.
    match args[0].value.kind:
        case HirExprKind.Lambda(params, _, captures):
            if params.len() != 1:
                return nil
            if method == "map":
                return Some(MethodResolution.BuiltinCollection(CollectionBuiltinOperation.ArrayMap))
            if method == "filter" and captures.len() == 0:
                return Some(MethodResolution.BuiltinCollection(CollectionBuiltinOperation.ArrayFilter))
        case _: ()
    nil

export resolve_builtin_collection_operation
