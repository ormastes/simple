# Typed view of a WeavingRule's predicate.
#
# `WeavingRule.predicate_text` stays as the on-disk/HIR-facing form for now —
# it is what `weavingconfig_from_aop_config` and `weavingconfig_from_hir_advices`
# receive from their sources. This accessor is the single point where that
# string becomes a typed, normalized `PointcutQuery`, so nothing downstream
# (matching, digesting, invalidation) ever touches the raw text again.
#
# Replacing the field itself requires the *producers* to emit a typed query
# (AopConfig.raw_predicate and HirAopAdvice.predicate_text are both text); that
# is the remaining half of prerequisite 1 and is tracked in the C4 report.

use compiler.mdsoc.weaving.weaving_rule.{WeavingRule}
use compiler.mdsoc.aop_index.pointcut_query.{PointcutQuery}
use compiler.mdsoc.aop_index.pointcut_parser.{pointcut_parse}

fn weavingrule_query(rule: WeavingRule) -> PointcutQuery:
    """The rule's predicate as a typed, normalized pointcut query."""
    pointcut_parse(rule.predicate_text)
