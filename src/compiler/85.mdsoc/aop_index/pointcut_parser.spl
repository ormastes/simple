# Parser: `WeavingRule.predicate_text` -> typed, normalized PointcutQuery.
#
# Grammar actually used in the tree today (weaving_config.spl):
#   query   := conj ( '|' conj )*
#   conj    := literal ( '&' literal )*
#   literal := [ '!' ] selector '(' argument ')'
#
# Anything outside this grammar — parentheses for grouping, an unknown
# selector, a malformed literal — yields POINTCUT_KIND_UNPARSED, whose read set
# is every descriptor field. Conservative is correct: a false miss is fine, a
# false hit is not.

use compiler.mdsoc.aop_index.pointcut_query.{
    PointcutAtom, PointcutClause, PointcutLiteral, PointcutQuery,
    POINTCUT_KIND_DNF, POINTCUT_KIND_ALL, POINTCUT_KIND_UNPARSED,
    pointcut_query_normalize, pointcut_selector_is_known
}

fn pointcut_split_on(src: text, sep: text) -> [text]:
    """Split `src` on a single-character separator."""
    var out: [text] = []
    var start = 0
    var i = 0
    val n = src.len()
    while i < n:
        if src.slice(i, i + 1) == sep:
            out = out.push(src.slice(start, i))
            start = i + 1
        i = i + 1
    out.push(src.slice(start, n))

struct ParsedLiteral:
    """Parse outcome. `ok == false` means the term is outside the grammar."""
    ok: bool
    literal: PointcutLiteral

fn parsed_literal_failed() -> ParsedLiteral:
    """The rejected-parse sentinel."""
    ParsedLiteral(
        ok: false,
        literal: PointcutLiteral(negated: false, atom: PointcutAtom(selector: "", argument: ""))
    )

fn pointcut_parse_literal(src: text) -> ParsedLiteral:
    """Parse `[!]selector(argument)`; `ok == false` when it does not fit."""
    var s = src.trim()
    var negated = false
    while s.starts_with("!"):
        negated = not negated
        s = s.slice(1, s.len()).trim()
    if not s.ends_with(")"):
        return parsed_literal_failed()
    val open = s.index_of("(")
    if open <= 0:
        return parsed_literal_failed()
    val selector = s.slice(0, open).trim()
    val argument = s.slice(open + 1, s.len() - 1).trim()
    if not pointcut_selector_is_known(selector):
        return parsed_literal_failed()
    if argument.contains("(") or argument.contains(")"):
        return parsed_literal_failed()
    if argument.is_empty():
        return parsed_literal_failed()
    ParsedLiteral(
        ok: true,
        literal: PointcutLiteral(
            negated: negated,
            atom: PointcutAtom(selector: selector, argument: argument)
        )
    )

fn pointcut_parse(predicate_text: text) -> PointcutQuery:
    """Parse a predicate string into a canonical PointcutQuery.

    An empty predicate is `all` — the in-tree convention for an unconditional
    rule. Anything unrepresentable becomes `unparsed`.
    """
    val raw = predicate_text.trim()
    if raw.is_empty():
        return PointcutQuery(kind: POINTCUT_KIND_ALL, clauses: [], raw: raw)
    var clauses: [PointcutClause] = []
    for alt in pointcut_split_on(src: raw, sep: "|"):
        var lits: [PointcutLiteral] = []
        for term in pointcut_split_on(src: alt, sep: "&"):
            val parsed = pointcut_parse_literal(term)
            if not parsed.ok:
                return PointcutQuery(kind: POINTCUT_KIND_UNPARSED, clauses: [], raw: raw)
            lits = lits.push(parsed.literal)
        if lits.is_empty():
            return PointcutQuery(kind: POINTCUT_KIND_UNPARSED, clauses: [], raw: raw)
        clauses = clauses.push(PointcutClause(literals: lits))

    pointcut_query_normalize(POINTCUT_KIND_DNF, clauses, raw)
