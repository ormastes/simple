# Stable join-point descriptor identity — prerequisite 7 of the AOP split.
#
# `JoinPoint` addresses its target by `BlockId{id: i64}`, a transient MIR index
# classified LOCAL_STATE by the frozen cache protocol
# (c0 §5b, `block.block_key.forbidden_identity_sources`). A cache key derived
# from it would change every time the MIR block numbering shifts, and — worse —
# could collide across unrelated functions.
#
# `JoinPointDescriptor` therefore carries NO BlockId and NO instruction index.
# Its identity is: the join-point kind (encoded BY NAME, never by ordinal, per
# c0 §7.8), the five backed JoinPointContext descriptor fields, and a
# disambiguating ordinal among join points that are otherwise byte-identical.
# That ordinal is assigned from the canonical content order, not from traversal
# order, so renumbering a block cannot move it.

use compiler.mdsoc.weaving.join_point.{JoinPoint, JoinPointContext}
use compiler.mdsoc.weaving.join_point_kind.{JoinPointKind}
use compiler.mdsoc.aop_index.pointcut_text.{pointcut_sort_texts, pointcut_text_lt}

struct JoinPointDescriptor:
    """Content-addressed identity of a join point. Free of any BlockId."""
    kind_name: text
    kind_operands: [text]
    qualified_name: text
    owning_scope: text
    signature: text
    attributes: [text]
    effects: [text]
    same_site_ordinal: i64

fn join_point_kind_name(kind: JoinPointKind) -> text:
    """The kind tag, encoded by NAME (c0 §7.8: never by ordinal)."""
    match kind:
        case Execution: return "Execution"
        case Decision: return "Decision"
        case Condition: return "Condition"
        case Error: return "Error"
        case SecurityGate: return "SecurityGate"
        case _: return "Unknown"  # rationale: reserved JoinPointKind values must degrade to a distinct unknown tag, never alias a named one

fn join_point_kind_operands(kind: JoinPointKind) -> [text]:
    """The kind's payload, in declaration order."""
    match kind:
        case Execution(function_name, signature): return [function_name, signature]
        case Decision(location): return [location]
        case Condition(location): return [location]
        case Error(location, error_type): return [location, error_type]
        case SecurityGate(capability, resource): return [capability, resource]
        case _: return []  # rationale: an unnamed future kind contributes no operands, keeping identity coarse rather than falsely fine-grained

fn join_point_descriptor_content_key(desc: JoinPointDescriptor) -> text:
    """Length-prefixed content key EXCLUDING `same_site_ordinal`.

    Two join points share a content key exactly when nothing observable to a
    selector distinguishes them.
    """
    var parts: [text] = []
    parts = parts.push(jpd_lp(desc.kind_name))
    parts = parts.push(desc.kind_operands.len().to_text() + ";")
    for op in desc.kind_operands:
        parts = parts.push(jpd_lp(op))
    parts = parts.push(jpd_lp(desc.qualified_name))
    parts = parts.push(jpd_lp(desc.owning_scope))
    parts = parts.push(jpd_lp(desc.signature))
    parts = parts.push(desc.attributes.len().to_text() + ";")
    for a in desc.attributes:
        parts = parts.push(jpd_lp(a))
    parts = parts.push(desc.effects.len().to_text() + ";")
    for e in desc.effects:
        parts = parts.push(jpd_lp(e))
    parts.join("")

fn jpd_lp(s: text) -> text:
    """`<len>:<s>` length prefix."""
    s.len().to_text() + ":" + s

fn join_point_descriptor_of(kind: JoinPointKind, ctx: JoinPointContext) -> JoinPointDescriptor:
    """Build an ordinal-zero descriptor. Attributes and effects are SETS."""
    JoinPointDescriptor(
        kind_name: join_point_kind_name(kind),
        kind_operands: join_point_kind_operands(kind),
        qualified_name: ctx.function_name,
        owning_scope: ctx.module_path,
        signature: ctx.signature,
        attributes: pointcut_sort_texts(ctx.attributes),
        effects: pointcut_sort_texts(ctx.effects),
        same_site_ordinal: 0
    )

fn join_point_descriptors_of(join_points: [JoinPoint]) -> [JoinPointDescriptor]:
    """Descriptors for a set of join points, with stable disambiguation.

    Ordinals are assigned after sorting by CONTENT key, so an unrelated BlockId
    renumbering — which only permutes the input order — cannot shift any
    descriptor's identity.
    """
    var built: [JoinPointDescriptor] = []
    for jp in join_points:
        built = built.push(join_point_descriptor_of(jp.kind, jp.context))

    # Insertion sort by content key.
    var sorted: [JoinPointDescriptor] = []
    for desc in built:
        val key = join_point_descriptor_content_key(desc)
        var placed: [JoinPointDescriptor] = []
        var inserted = false
        for existing in sorted:
            if not inserted and pointcut_text_lt(a: key, b: join_point_descriptor_content_key(existing)):
                placed = placed.push(desc)
                inserted = true
            placed = placed.push(existing)
        if not inserted:
            placed = placed.push(desc)
        sorted = placed

    var out: [JoinPointDescriptor] = []
    var last_key = ""
    var ordinal = 0
    var first = true
    for desc in sorted:
        val key = join_point_descriptor_content_key(desc)
        if first or key != last_key:
            ordinal = 0
        else:
            ordinal = ordinal + 1
        out = out.push(JoinPointDescriptor(
            kind_name: desc.kind_name,
            kind_operands: desc.kind_operands,
            qualified_name: desc.qualified_name,
            owning_scope: desc.owning_scope,
            signature: desc.signature,
            attributes: desc.attributes,
            effects: desc.effects,
            same_site_ordinal: ordinal
        ))
        last_key = key
        first = false
    out
