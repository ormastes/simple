# AOP invalidation transaction (design §16.5, matrix §16.6).
#
# Given a change kind + the reverse index, computes exactly which groups
# invalidate. Rows expressible with today's inputs are precise; rows whose
# precision requires the missing per-target weave artifact (plan §2b:
# weaving mutates MIR in place, no artifact exists) take a CONSERVATIVE
# over-invalidation and set `conservative = true`. This module never
# under-invalidates.
#
# Change kinds are text tags mirroring the 11 rows of
# test/02_integration/compiler/cache_v2/fixtures/aop_mutation_matrix.sdn.

use compiler.mdsoc.aop_index.reverse_index.{AopReverseIndex, aop_selectors_reading_field, aop_partitions_of_selector, aop_targets_of_advice}

# Matrix row tags (§16.6, fixture order).
val AOP_CHANGE_ADVICE_BODY_SYMBOLIC: text = "advice_body_symbolic"
val AOP_CHANGE_ADVICE_BODY_EMBEDDED: text = "advice_body_embedded"
val AOP_CHANGE_ADVICE_INTERFACE: text = "advice_interface"          # signature/form/effects
val AOP_CHANGE_ADVICE_PRIORITY: text = "advice_priority"
val AOP_CHANGE_POINTCUT_QUERY: text = "pointcut_query"
val AOP_CHANGE_POINTCUT_SCOPE: text = "pointcut_scope"
val AOP_CHANGE_TARGET_PRIVATE_BODY: text = "target_private_body"
val AOP_CHANGE_TARGET_DESCRIPTOR_FIELD: text = "target_descriptor_field"
val AOP_CHANGE_NEW_TARGET: text = "new_target"
val AOP_CHANGE_NEW_IMPORTED_ASPECT: text = "new_imported_aspect"
val AOP_CHANGE_RUNTIME_TOGGLE: text = "runtime_toggle"

struct AopInvalidationResult:
    candidate_partitions: [text]     # partition key digests to rebuild
    selections: [text]               # selector ids to reevaluate
    weave_targets: [text]            # target entities to reweave
    advice_artifacts: [text]         # advice_function names to rebuild
    link_load: bool                  # relink/reload required
    conservative: bool               # true when any axis was over-invalidated
    reason: text                     # names the missing prerequisite when conservative

fn aop_invalidation_empty() -> AopInvalidationResult:
    AopInvalidationResult(candidate_partitions: [], selections: [], weave_targets: [],
                          advice_artifacts: [], link_load: false,
                          conservative: false, reason: "")

fn aop_all_targets(index: AopReverseIndex) -> [text]:
    var out: [text] = []
    for ts in index.target_selections:
        out.push(ts.target_entity)
    out

# The transaction. `change_id` names the changed thing per row:
#   advice rows: advice_function name
#   pointcut rows: selector id
#   target rows: target entity (descriptor row: "entity\tfield" would need a
#     pair; we take entity via change_id and the field via changed_field)
fn aop_invalidate(kind: text, change_id: text, changed_field: text, index: AopReverseIndex) -> AopInvalidationResult:
    var r = aop_invalidation_empty()

    if kind == AOP_CHANGE_ADVICE_BODY_SYMBOLIC:
        # Row 1: No / No / No / Yes / Yes. Precise today — the interface
        # digest excludes the body, so selection and weave keys are stable.
        r.advice_artifacts.push(change_id)
        r.link_load = true
        return r

    if kind == AOP_CHANGE_ADVICE_BODY_EMBEDDED:
        # Row 2: weave_target = "affected targets". No embedded-weave mode
        # exists today, and no weave artifact records embedding — so we
        # cannot know which targets embed the body. CONSERVATIVE: reweave
        # every target selecting this advice.
        r.weave_targets = aop_targets_of_advice(index, change_id)
        r.advice_artifacts.push(change_id)
        r.link_load = true
        r.conservative = true
        r.reason = "no per-target weave artifact (weaving mutates MIR in place); embedding sites unknown"
        return r

    if kind == AOP_CHANGE_ADVICE_INTERFACE or kind == AOP_CHANGE_ADVICE_PRIORITY:
        # Rows 3-4: affected pointcuts + affected targets. No selector->advice
        # visibility filter exists (all rules see all advices), so "affected
        # pointcuts" = every selector — CONSERVATIVE on the selection axis.
        # Row 4's "targets whose order changed" needs an order diff over the
        # old selection shard; without stored shards we reweave all targets
        # of this advice — CONSERVATIVE, never under-invalidating.
        for rs in index.selector_read_sets:
            r.selections.push(rs.selector_id)
        r.weave_targets = aop_targets_of_advice(index, change_id)
        r.advice_artifacts.push(change_id)
        r.link_load = true
        r.conservative = true
        r.reason = "no per-selector advice visibility and no stored selection shards to diff order against"
        return r

    if kind == AOP_CHANGE_POINTCUT_QUERY or kind == AOP_CHANGE_POINTCUT_SCOPE:
        # Rows 5-6: that pointcut's selection; its partitions; selection-delta
        # targets. Without stored old selections the delta is unknown —
        # CONSERVATIVE: all targets the selector's partitions could reach
        # (approximated as all indexed targets).
        r.selections.push(change_id)
        r.candidate_partitions = aop_partitions_of_selector(index, change_id)
        r.weave_targets = aop_all_targets(index)
        r.link_load = true
        r.conservative = true
        r.reason = "no stored selection shard to compute the selection delta; no pointcut visibility/importers exist"
        return r

    if kind == AOP_CHANGE_TARGET_PRIVATE_BODY:
        # Row 7: descriptor unchanged -> candidate index No, selection No,
        # recompile target body preserving selection. Precise today.
        r.weave_targets.push(change_id)
        r.link_load = true
        return r

    if kind == AOP_CHANGE_TARGET_DESCRIPTOR_FIELD:
        # Row 8: one descriptor leaf; only selectors whose read-set includes
        # the changed field reevaluate. Precise via table 2.
        r.selections = aop_selectors_reading_field(index, changed_field)
        r.weave_targets.push(change_id)
        r.link_load = true
        return r

    if kind == AOP_CHANGE_NEW_TARGET:
        # Row 9: one leaf/path; applicable pointcuts. Without evaluating the
        # opaque predicate we cannot know applicability — CONSERVATIVE: all
        # selectors; weave only the new target.
        for rs in index.selector_read_sets:
            r.selections.push(rs.selector_id)
        r.weave_targets.push(change_id)
        r.link_load = true
        r.conservative = true
        r.reason = "predicate_text is opaque; applicability requires the typed matcher"
        return r

    if kind == AOP_CHANGE_NEW_IMPORTED_ASPECT:
        # Row 10: no aspect catalogs/scopes exist — CONSERVATIVE: everything
        # on the selection axis, all targets, new advice artifact.
        for rs in index.selector_read_sets:
            r.selections.push(rs.selector_id)
        r.weave_targets = aop_all_targets(index)
        r.advice_artifacts.push(change_id)
        r.link_load = true
        r.conservative = true
        r.reason = "no visible-aspect catalog or scope model exists"
        return r

    if kind == AOP_CHANGE_RUNTIME_TOGGLE:
        # Row 11: session-generation only. Precise.
        r.link_load = true          # session generation bump only
        return r

    # Unknown change kind: fail CLOSED — invalidate every axis.
    for rs in index.selector_read_sets:
        r.selections.push(rs.selector_id)
    for sp in index.selector_partitions:
        for p in sp.partition_key_digests:
            r.candidate_partitions.push(p)
    r.weave_targets = aop_all_targets(index)
    r.link_load = true
    r.conservative = true
    r.reason = "unknown change kind: fail-closed full invalidation"
    r
