# Module Loading Stage — ModuleResolverDiscoveryPort

use compiler.common.module_resolver_port.{ModuleResolverPort, module_resolver_port_empty}

struct ModuleResolverDiscoveryPort:
    name: text
    resolve_inputs_fn: fn([text]) -> Result<ModuleResolverPort, text>

impl ModuleResolverDiscoveryPort:
    fn resolve_inputs(inputs: [text]) -> Result<ModuleResolverPort, text>:
        self.resolve_inputs_fn(inputs)

fn _module_resolver_discovery_empty(inputs: [text]) -> Result<ModuleResolverPort, text>:
    Ok(module_resolver_port_empty())

fn module_resolver_discovery_port_empty() -> ModuleResolverDiscoveryPort:
    """Compatibility adapter for callers that do not opt into registry discovery."""
    ModuleResolverDiscoveryPort(
        name: "empty-module-resolver-discovery",
        resolve_inputs_fn: _module_resolver_discovery_empty
    )
