# Module Loading Stage — ModuleStoragePort
#
# File source reading (swappable in tests).
# Reads source text for a module at the given absolute path.
# Returns a typed error when the source cannot be read.

struct ModuleStoragePort:
    """File source reading (swappable in tests).

    Reads source text for a module at the given absolute path.
    Returns a typed error when the source cannot be read. `Ok("")` remains a
    valid registered empty source and is distinct from absence.
    """
    name: text
    read_source_fn: fn(text) -> Result<text, text>
