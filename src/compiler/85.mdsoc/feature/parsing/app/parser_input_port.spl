# Parsing Stage — ParserInputPort
#
# Token stream from the lexer.

use common.compute.placement_contracts.handles.{ArenaResidency}
use common.compute.placement_contracts.semantic.{AnyObject}

struct ParserInputPort:
    """Token stream from the lexer."""
    token_tags: [i64]
    token_texts: [text]
    token_lines: [i64]
    token_cols: [i64]
    token_count: i64
    source_text: text
    token_residency: ArenaResidency<AnyObject>
