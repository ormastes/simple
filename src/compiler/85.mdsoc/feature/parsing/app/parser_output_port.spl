# Parsing Stage — ParserOutputPort
#
# Parsed module output (arena indices + errors).

use compiler.mdsoc.feature.parsing.app.parse_error.{ParseError}
use common.compute.placement_contracts.handles.{ArenaResidency}
use common.compute.placement_contracts.semantic.{AnyObject}
use common.structural.identity.entity_id.{EntityRef}

struct ParserOutputPort:
    """Parsed module output (arena indices + errors)."""
    expr_count: i64
    stmt_count: i64
    decl_count: i64
    root_decls: [EntityRef]
    errors: [ParseError]
    error_count: i64
    syntax_residency: ArenaResidency<AnyObject>
