# Simple Compiler (Self-Hosting) Configuration

project:
  name: simple-compiler
  version: 1.0.0-rc.1
  type: application
  language: Simple
  tier: core

  root: .
  features:
    default: [jit]
    jit: []
    aot: []
    interpreter: []

  dependencies:
    - project: ../lib
    - project: ../../rust

# Allocatable mission-critical migration, STEP 1 (2026-08-28).
# The compiler (layers 00-90), the interpreter (10.frontend/core/interpreter,
# 95.interp) and the loader (99.loader) all live under this manifest, so one
# pin covers all three. `critical` = robust + REQ-MC rules; allocation is
# permitted for the toolchain (see mission_critical/alloc_diagnostic_config.spl
# `mc_alloc_toolchain_allowances`). `warning_phase` drops every critical-tier
# deny to a WARNING so the tree keeps building while every violation is
# visible. `mc_exceptions` names what is not held to the tier yet, with a
# reason; each skip is reported. Format:
# doc/07_guide/language/mission_critical_warning_phase_exceptions.md
lints:
  profile: critical
  warning_phase: true
  mc_exceptions: "src/compiler/90.tools/verify=verify scanners drive rt_* and extern surfaces directly; migrate after the checkers they scan, src/compiler/85.mdsoc=MDSOC weaving hosts dynamic composition (dynamic_composition.spl); needs the capability-scoped unsafe boundary first (REQ-MC-004), src/compiler/00.common/dynamic_identity/dense_tag_map.spl=primitive_api false-positive: dyn_tag/serialize_variant params are dense-tag-map wire indices/discriminants not business values; wrapping ripples into cross-lane serialization (lane_L1 triage 2026-08-28), src/compiler/10.frontend/core/flat_pool_codec.spl=primitive_api false-positive: flat_pool_enc_scalar_i64/bool encode raw scalar values by design; the primitive IS the codec payload (lane_L1 triage 2026-08-28), src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl=primitive_api false-positive: op_kind_to_binop(kind: i64) decodes a flat-AST discriminant tag; wrapping ripples into the flat-ast bridge format (lane_L1 triage 2026-08-28), src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl=primitive_api false-positive: parse_and_build_module_scoped(streaming_scope: bool) is an internal parse-mode flag, not a public value-domain API (lane_L1 triage 2026-08-28), src/compiler/20.hir/hir_lowering/module_surface_source_identity.spl=primitive_api false-positive: module_surface_index_for_source(source_index: i64) is an internal HIR module-table index, not a public value-domain API (lane_L1 triage 2026-08-28)"

access:
  friends:
    hir: [types, traits, mir, frontend]
    mir: [hir, types, mir_opt, backend]
    traits: [types, mir, backend]
    types: [mir, backend, driver]
    backend: [mir, mir_opt, types, driver]
    mir_opt: [backend, driver]
    driver: [backend, frontend, hir, mir, types, mir_opt, mdsoc, tools, interp, loader]
    mdsoc: [driver]
    tools: [driver]
