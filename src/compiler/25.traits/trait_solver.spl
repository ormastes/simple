# Trait Solver
#
# Obligation-based trait constraint solving with associated type support.
# Split from traits.spl for modularity.

use compiler.hir.hir.*
use compiler.hir.hir_types.{SymbolTable}
use compiler.frontend.core.lexer.*
use compiler.traits.trait_def.{SolverTraitDef, SolverTraitBound, AssocTypeDef, MethodSignature}
use compiler.traits.trait_impl.{ImplBlock}
use compiler.traits.trait_impl_bindings_v1.{trait_impl_bindings_v1}
use compiler.common.cache.reverse_reference_facts.{
    reverse_reference_owner_mark_incomplete_v1,
    reverse_reference_register_trait_candidate_v1
}
use compiler.traits.trait_coherence.{impls_overlap}
use compiler.traits.trait_validation.{TraitError}
use compiler.traits.associated_types.{AssocTypeProjection, AssocTypeResolver}

# ============================================================================
# Obligation
# ============================================================================

struct Obligation:
    """A trait bound that must be proven during type checking.

    Created when:
    - Calling a function with trait bounds
    - Using a method that requires a trait
    - Satisfying a where clause

    Must be satisfied by finding an impl block.
    Optionally includes associated type constraints (e.g., Iterator<Item=i64>).
    """
    type_: HirType                  # The type that must implement the trait
    trait_: HirSymbol                  # The trait that must be implemented
    cause: ObligationCause          # Why this obligation was created
    span: Span                      # Source location
    assoc_type_constraints: Dict<text, HirType>  # Associated type constraints

impl Obligation:
    static fn create(ty: HirType, trait_: HirSymbol, cause: ObligationCause, span: Span) -> Obligation:
        """Create a new obligation without associated type constraints."""
        Obligation(
            type_: ty,
            trait_: trait_,
            cause: cause,
            span: span,
            assoc_type_constraints: {}
        )

    static fn with_assoc_constraints(ty: HirType, trait_: HirSymbol, cause: ObligationCause, span: Span, constraints: Dict<text, HirType>) -> Obligation:
        """Create an obligation with associated type constraints.

        Example: I: Iterator<Item=i64> creates an obligation with
        assoc_type_constraints = {"Item": i64}.
        """
        Obligation(
            type_: ty,
            trait_: trait_,
            cause: cause,
            span: span,
            assoc_type_constraints: constraints
        )

    fn has_assoc_constraints() -> bool:
        """Check if this obligation has associated type constraints."""
        not self.assoc_type_constraints.is_empty()

    fn description() -> text:
        """Get human-readable description."""
        var desc = "require {self.type_} : {self.trait_}"
        if self.has_assoc_constraints():
            var constraints: [text] = []
            # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
            for name in self.assoc_type_constraints.keys():
                constraints = constraints.push("{name}=<type>")
            desc = "{desc}<{constraints.join(', ')}>"
        desc

enum ObligationCause:
    """Why an obligation was created (for error messages)."""
    FunctionCall(HirSymbol)            # From calling fn<T: Trait>
    MethodCall(HirSymbol, text)        # From calling method
    SolverTraitBound(HirSymbol)              # From where clause
    FieldAccess(HirSymbol, text)       # From accessing field
    BuiltIn                         # From built-in constraint

impl ObligationCause:
    fn description() -> text:
        match self:
            case FunctionCall(name):
                "function call to {name}"
            case MethodCall(receiver, method):
                "method call {receiver}.{method}"
            case SolverTraitBound(param):
                "trait bound on {param}"
            case FieldAccess(ty, field):
                "field access {ty}.{field}"
            case BuiltIn:
                "built-in constraint"

# ============================================================================
# Trait Solver
# ============================================================================

pub fn trait_reverse_symbol_identity_v1(symbol: HirSymbol) -> text:
    if symbol.name == "":
        return ""
    if val owner = symbol.defining_module:
        if owner != "":
            return "{owner}::{symbol.name}"
    ""

# SymbolId is local to this table. Callers must supply the same module's
# table that owns the HIR type, never a table selected by matching raw IDs.
# An absent owner or unsupported shape means unknown, not a shared identity.
pub fn trait_reverse_type_identity_v1(ty: HirType, symbols: SymbolTable?) -> text:
    match ty.kind:
        case Named(symbol, args):
            if symbols == nil:
                return ""
            val table = symbols.unwrap()
            if val resolved = table.get_symbol_raw(symbol.id):
                var identity = trait_reverse_symbol_identity_v1(resolved)
                if identity == "":
                    return ""
                if args.len() == 0:
                    return identity
                identity = identity + "<"
                for arg in args:
                    val arg_identity = trait_reverse_type_identity_v1(arg, symbols)
                    if arg_identity == "":
                        return ""
                    identity = identity + "{arg_identity.len()}:{arg_identity}"
                return identity + ">"
            ""
        case Int(bits, signed): if signed: "i{bits}" else: "u{bits}"
        case Float(bits): "f{bits}"
        case Bool: "bool"
        case Char: "char"
        case Str: "text"
        case Unit: "unit"
        case _: ""

fn trait_reverse_cause_identity_v1(cause: ObligationCause,
        fallback: text) -> text:
    match cause:
        case FunctionCall(symbol): trait_reverse_symbol_identity_v1(symbol)
        case MethodCall(symbol, _): trait_reverse_symbol_identity_v1(symbol)
        case SolverTraitBound(symbol): trait_reverse_symbol_identity_v1(symbol)
        case FieldAccess(symbol, _): trait_reverse_symbol_identity_v1(symbol)
        case BuiltIn: fallback

pub fn trait_solver_publish_trait_candidate_v1(subject: text,
        consumer: text, evidence: text):
    if subject == "" or consumer == "":
        reverse_reference_owner_mark_incomplete_v1("trait-type-implementation")
        return
    reverse_reference_register_trait_candidate_v1(subject, consumer, evidence)

class TraitSolver:
    """Solves trait obligations by searching impl blocks.

    Algorithm (simplified Rust trait solver):
    1. Collect obligations from function calls and method calls
    2. For each obligation T: Trait:
       a. Search for impl Trait for T
       b. Check where clauses recursively
       c. Check associated type constraints if present
       d. Report error if no impl found
    3. Cache results to avoid duplicate work
    """
    # All known trait definitions
    traits: Dict<HirSymbol, SolverTraitDef>

    # All known impl blocks (indexed by trait name)
    impls: Dict<HirSymbol, [ImplBlock]>

    # All known impl blocks (indexed by target type symbol)
    impls_by_type: Dict<HirSymbol, [ImplBlock]>

    # Cache of solved obligations: (type, trait) -> success
    cache: Dict<(HirType, HirSymbol), bool>

    # Only pending proofs, never optimistic successes; reset after each call.
    active: Dict<(HirType, HirSymbol), bool> = {}
    active_count: i64 = 0

    # Current obligations to solve
    obligations: [Obligation]

    # Errors encountered during solving
    errors: [TraitError]

    # Associated type resolver
    assoc_resolver: AssocTypeResolver

    # Map from method name to all declaring traits (required + default)
    # Used by resolve_strategies for method dispatch
    trait_methods: Dict<text, [HirSymbol]>

    # A module snapshot holds its containers by reference, with no per-fact
    # copy and no global retention. The ownerless legacy API stays conservative.
    reverse_symbols: SymbolTable?

impl TraitSolver:
    static fn create() -> TraitSolver:
        """Create a new trait solver."""
        TraitSolver(
            traits: {},
            impls: {},
            impls_by_type: {},
            cache: {},
            obligations: [],
            errors: [],
            assoc_resolver: AssocTypeResolver.create(),
            trait_methods: {},
            reverse_symbols: nil
        )

    static fn create_with_symbols(symbols: SymbolTable) -> TraitSolver:
        var solver = TraitSolver.create()
        solver.reverse_symbols = Some(symbols.module_snapshot())
        solver

    me add_trait(trait_def: SolverTraitDef):
        """Register a trait definition.

        Collects all method names (both required and default) into
        trait_methods for efficient lookup during method resolution.
        """
        # Trait replacement can change supertrait requirements for any cached
        # obligation, including obligations on traits which depend on this one.
        self.cache = {}
        self.traits[trait_def.name] = trait_def

        var assoc_resolver = self.assoc_resolver
        assoc_resolver.add_trait(trait_def)
        self.assoc_resolver = assoc_resolver

        for method in trait_def.methods:
            var owners: [HirSymbol] = if self.trait_methods.has(method.name): self.trait_methods[method.name] else: []
            owners.push(trait_def.name)
            self.trait_methods[method.name] = owners
        for default in trait_def.defaults:
            var owners: [HirSymbol] = if self.trait_methods.has(default.name): self.trait_methods[default.name] else: []
            owners.push(trait_def.name)
            self.trait_methods[default.name] = owners

    me add_impl(impl_block: ImplBlock):
        """Register an impl block.

        Indexes by both trait name and target type for efficient lookup.
        Also registers with the associated type resolver.
        """
        # A new impl can satisfy a cached miss or make a cached success
        # ambiguous. Dependent supertrait decisions must also be recomputed.
        self.cache = {}
        val trait_name = impl_block.trait_name
        val type_identity = trait_reverse_type_identity_v1(
            impl_block.for_type, self.reverse_symbols)
        # An impl can live outside both the trait and target type's module.
        # Resolve the actual method owner; never substitute the target owner.
        # Methodless impls lack declaration ownership in ImplBlock and must
        # remain incomplete until that information is explicitly available.
        var impl_consumer = ""
        if self.reverse_symbols != nil and impl_block.methods.len() > 0:
            val table = self.reverse_symbols.unwrap()
            val method = impl_block.methods[0]
            if val resolved = table.get_symbol_raw(method.symbol.id):
                if resolved.name == method.name:
                    impl_consumer = trait_reverse_symbol_identity_v1(resolved)
        if type_identity == "":
            reverse_reference_owner_mark_incomplete_v1("trait-type-implementation")
        trait_solver_publish_trait_candidate_v1(
            trait_reverse_symbol_identity_v1(trait_name), impl_consumer,
            "impl:{type_identity}:{impl_block.methods.len()}")

        # Index by trait name
        var impl_list_by_trait: [ImplBlock] = if self.impls[trait_name].?:
            self.impls[trait_name]
        else:
            []
        impl_list_by_trait = impl_list_by_trait.push(impl_block)
        self.impls[trait_name] = impl_list_by_trait

        # Index by target type (extract symbol from Named type)
        match impl_block.for_type.kind:
            case Named(type_symbol, _):
                var impl_list_by_type: [ImplBlock] = if self.impls_by_type[type_symbol].?:
                    self.impls_by_type[type_symbol]
                else:
                    []
                impl_list_by_type = impl_list_by_type.push(impl_block)
                self.impls_by_type[type_symbol] = impl_list_by_type
            case _: pass  # Skip non-named types for now

        # Register with associated type resolver
        self.assoc_resolver.add_impl(impl_block)

    me add_obligation(ty: HirType, trait_: HirSymbol, cause: ObligationCause, span: Span):
        """Add an obligation to solve."""
        val obligation = Obligation.create(ty, trait_, cause, span)
        val type_identity = trait_reverse_type_identity_v1(ty, self.reverse_symbols)
        if type_identity == "":
            reverse_reference_owner_mark_incomplete_v1("trait-type-implementation")
        trait_solver_publish_trait_candidate_v1(
            trait_reverse_symbol_identity_v1(trait_),
            trait_reverse_cause_identity_v1(
                cause, type_identity),
            "obligation:{type_identity}")
        self.obligations = self.obligations.push(obligation)

    fn has_obligations() -> bool:
        """Check if there are pending obligations."""
        not self.obligations.is_empty()

    me solve_all() -> Result<(), [TraitError]>:
        """Solve all pending obligations.

        Returns Ok if all obligations satisfied, Err with errors otherwise.
        """
        for obligation in self.obligations:
            match self.solve_obligation(obligation):
                case Err(err):
                    self.errors = self.errors.push(err)
                case _: pass

        # Clear obligations after solving
        self.obligations = []

        if self.errors.is_empty():
            Ok(())
        else:
            val errors = self.errors
            self.errors = []  # Clear for next round
            Err(errors)

    me solve_obligation(obligation: Obligation) -> Result<(), TraitError>:
        """Prove the full conditional closure before reporting success."""
        val key = (obligation.type_, obligation.trait_)
        if self.active.has(key) and self.active[key]:
            return Err(TraitError.CyclicBound(obligation.trait_, obligation.span))
        self.active[key] = true
        self.active_count = self.active_count + 1
        val result = self.solve_obligation_inner_v1(obligation)
        self.active[key] = false
        self.active_count = self.active_count - 1
        if self.active_count == 0: self.active = {}
        result

    me solve_obligation_inner_v1(obligation: Obligation) -> Result<(), TraitError>:
        val ty = obligation.type_
        val trait_ = obligation.trait_

        # Check cache (only for obligations without assoc constraints)
        val cache_key = (ty, trait_)
        if not obligation.has_assoc_constraints():
            if self.cache[cache_key].?:
                if self.cache[cache_key]:
                    return Ok(())
                else:
                    return Err(TraitError.Unsatisfied(obligation))

        # Retain every matching declaration for a useful ambiguity diagnostic.
        # Do not choose by registration order or cache ambiguity as a boolean:
        # that would erase the candidates on the next solve.
        var candidates: [ImplBlock] = []
        var bindings: Dict<i64, HirType> = {}
        if self.impls[trait_].?:
            for impl_block in self.impls[trait_]:
                if val matched = trait_impl_bindings_v1(impl_block, ty, self.reverse_symbols):
                    candidates = candidates.push(impl_block)
                    bindings = matched
        if candidates.len() > 1:
            return Err(TraitError.Ambiguous(ty, trait_, candidates))
        val selected: ImplBlock? = if candidates.len() == 1: Some(candidates[0]) else: nil
        match selected:
            case Some(impl_block):
                # Check where clauses recursively
                for bound in impl_block.where_clause:
                    match self.solve_instantiated_trait_bound_v1(bound, bindings, obligation):
                        case Err(e):
                            match e:
                                case TraitError.Ambiguous(_, _, _) | TraitError.CyclicBound(_, _): return Err(e)
                                case _:
                                    if not obligation.has_assoc_constraints(): self.cache[cache_key] = false
                            return Err(e)
                        case _: pass

                # Check supertrait obligations
                match self.check_supertraits(ty, trait_, obligation.span):
                    case Err(e):
                        match e:
                            case TraitError.Ambiguous(_, _, _) | TraitError.CyclicBound(_, _): return Err(e)
                            case _:
                                if not obligation.has_assoc_constraints(): self.cache[cache_key] = false
                        return Err(e)
                    case _: pass

                # Associated predicates never populate the unconstrained cache.
                if obligation.has_assoc_constraints():
                    match self.check_assoc_type_constraints(obligation, impl_block):
                        case Err(e): return Err(e)
                        case _: pass

                # Success - cache it
                if not obligation.has_assoc_constraints(): self.cache[cache_key] = true
                Ok(())

            case nil:
                # No impl found - cache failure
                if not obligation.has_assoc_constraints(): self.cache[cache_key] = false
                Err(TraitError.Unsatisfied(obligation))

    fn find_impl(ty: HirType, trait_: HirSymbol) -> ImplBlock?:
        """Find impl block for type and trait."""
        if not self.impls[trait_].?:
            return nil

        val impl_list = self.impls[trait_]
        for impl_block in impl_list:
            if impl_block.matches_type(ty):
                return Some(impl_block)

        nil

    me solve_instantiated_trait_bound_v1(bound: SolverTraitBound, bindings: Dict<i64, HirType>, parent: Obligation) -> Result<(), TraitError>:
        if not bindings.has(bound.type_param.id.id):
            return Err(TraitError.Unsatisfied(parent))
        val child = Obligation.create(bindings[bound.type_param.id.id], bound.trait_name,
            ObligationCause.SolverTraitBound(bound.type_param), parent.span)
        self.solve_obligation(child)

    me solve_trait_bound(bound: SolverTraitBound, span: Span) -> Result<(), TraitError>:
        # Legacy direct API has no matched impl or argument assignment. It must
        # never enqueue an unproved bound and report success.
        val unresolved = HirType(kind: HirTypeKind.TypeParam(bound.type_param.name, []), span: bound.span)
        Err(TraitError.Unsatisfied(Obligation.create(unresolved, bound.trait_name,
            ObligationCause.SolverTraitBound(bound.type_param), span)))

    me check_supertraits(ty: HirType, trait_: HirSymbol, span: Span) -> Result<(), TraitError>:
        """Check that type implements all supertraits of the given trait."""
        if not self.traits[trait_].?:
            return Ok(())

        val trait_def = self.traits[trait_]

        for supertrait_symbol in trait_def.supertraits:
            val cause = ObligationCause.SolverTraitBound(trait_)
            val supertrait_obligation = Obligation.create(ty, supertrait_symbol, cause, span)

            match self.solve_obligation(supertrait_obligation):
                case Err(e):
                    return Err(e)
                case _: pass

        Ok(())

    me check_assoc_type_constraints(obligation: Obligation, impl_block: ImplBlock) -> Result<(), TraitError>:
        """Check that an impl block satisfies associated type constraints.

        For an obligation like T: Iterator<Item=i64>, verifies that
        the impl's associated type for 'Item' matches i64.
        """
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for assoc_name in obligation.assoc_type_constraints.keys():
            val expected_type = obligation.assoc_type_constraints[assoc_name]
            val actual_type = impl_block.get_assoc_type_impl(assoc_name)
            if not actual_type.?:
                # Associated type not specified in impl - check for default
                return Err(TraitError.Unsatisfied(obligation))

            # Compare the actual type with the expected type
            val actual = match actual_type:
                Some(value):
                    value
                None:
                    return Err(TraitError.Unsatisfied(obligation))
            if actual.kind != expected_type.kind:
                return Err(TraitError.Unsatisfied(obligation))

        Ok(())

    me add_obligation_with_assoc(ty: HirType, trait_: HirSymbol, cause: ObligationCause, span: Span, constraints: Dict<text, HirType>):
        """Add an obligation with associated type constraints."""
        val obligation = Obligation.with_assoc_constraints(ty, trait_, cause, span, constraints)
        self.obligations = self.obligations.push(obligation)

    fn resolve_assoc_type(ty: HirType, trait_: HirSymbol, assoc_name: text) -> HirType?:
        """Resolve an associated type for a concrete type and trait.

        Example: resolve_assoc_type(Range, Iterator, "Item") -> i64
        """
        match self.find_impl(ty, trait_):
            case Some(impl_block):
                impl_block.get_assoc_type_impl(assoc_name)
            case nil:
                nil

    fn normalize_type(ty: HirType) -> HirType:
        """Normalize a type by resolving all associated type projections."""
        self.assoc_resolver.normalize(ty)

    fn get_trait(name: HirSymbol) -> SolverTraitDef?:
        """Get trait definition by name."""
        self.traits[name]

    fn find_trait_for_method(method_name: text) -> HirSymbol?:
        """Find the first registered trait that declares method_name."""
        if self.trait_methods.has(method_name):
            val owners: [HirSymbol] = self.trait_methods[method_name]
            if owners.len() > 0:
                return Some(owners[0])
        nil

    fn get_impls_for_type(type_symbol: HirSymbol) -> [ImplBlock]:
        """Get all impl blocks for a given type."""
        if self.impls_by_type[type_symbol].?:
            self.impls_by_type[type_symbol]
        else:
            []

    fn get_impls_for_trait(trait_name: HirSymbol) -> [ImplBlock]:
        """Get all impl blocks for a given trait."""
        if self.impls[trait_name].?:
            self.impls[trait_name]
        else:
            []

    fn find_impl_for_type_and_trait(type_symbol: HirSymbol, trait_name: HirSymbol) -> ImplBlock?:
        """Find specific impl block for (type, trait) pair."""
        val impls_for_type = self.get_impls_for_type(type_symbol)
        for impl_block in impls_for_type:
            if impl_block.trait_name == trait_name:
                return Some(impl_block)
        nil

    fn get_default_method(trait_name: HirSymbol, method_name: text) -> HirFunction?:
        """Get a default method implementation from a trait.

        Returns the default method body if the trait has one for the given name,
        nil otherwise. Used by method dispatch to fall back to default implementations
        when the impl block doesn't override a method.
        """
        if not self.traits[trait_name].?:
            return nil
        val trait_def = self.traits[trait_name]
        trait_def.get_default_method(method_name)

    fn is_method_required(trait_name: HirSymbol, method_name: text) -> bool:
        """Check if a method is required (no default) in a trait.

        Returns true if the method exists in the trait and has no default body.
        Returns false if the method has a default or doesn't exist in the trait.
        """
        if not self.traits[trait_name].?:
            return false
        val trait_def = self.traits[trait_name]
        trait_def.has_required_method(method_name)

    me check_coherence():
        """Check coherence rules (no overlapping impls)."""
        # BUG-001 fix: Use keys()-based iteration (for (k,v) in dict is broken in compiled mode)
        for trait_name in self.impls.keys():
            val impl_list: [ImplBlock] = self.impls[trait_name]
            for i in 0..impl_list.len():
                for j in (i + 1)..impl_list.len():
                    # @workaround bug=enum_payload_type_mismatch_dict_elem_untyped_2026-10-24 reason=Dict-erased element read has no static struct type; typed locals so field payloads type-check
                    val impl1: ImplBlock = impl_list[i]
                    val impl2: ImplBlock = impl_list[j]

                    if impls_overlap(impl1, impl2):
                        val error = TraitError.Overlapping(
                            trait_name,
                            impl1.for_type,
                            impl2.span
                        )
                        self.errors = self.errors.push(error)
