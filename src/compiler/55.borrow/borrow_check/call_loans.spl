"""Call-wide short loans, checked before entering a synchronous callee.

The boundary is the originating short scope, not the nested call's point.
Only a checked non-retaining contract may introduce a short loan. The caller
supplies live, non-delegated loans as `active`; these remain protected while
the callee runs, including callbacks or reentrant accesses.
"""

use compiler.borrow.borrow_check.borrow_graph.{Place, BorrowKind, place_conflicts_with, kind_conflicts_with, place_to_text}

pub struct CallLoan:
    place: Place
    kind: BorrowKind
    # -1: a fresh loan from an owner in this scope; >=0: forwarded loan.
    origin_boundary: i64 = -1
    contract_known: bool = false
    # May-alias alternatives expanded from one original operand share its
    # positional slot. -1 preserves independent-argument behavior.
    argument_index: i64 = -1

pub struct CallLoanError:
    point: i64
    message: text

pub fn check_call_loans(point: i64, boundary: i64, arguments: [CallLoan], active: [CallLoan]) -> [CallLoanError]:
    """Reject incompatible aliases, unknown contracts and boundary widening.

    Shared aliases are valid; any overlapping mutable/unique loan conflicts.
    Distinct fields remain independent under the existing Place rules.
    An explicitly delegated parent loan is absent from `active`; an arbitrary
    matching origin token never grants an exemption from an active conflict.
    """
    var errors: [CallLoanError] = []
    if boundary < 0:
        return [CallLoanError(point: point, message: "short call has no originating boundary")]
    var index = 0
    while index < arguments.len():
        val argument: CallLoan = arguments[index]
        if not argument.contract_known:
            errors = errors.push(CallLoanError(point: point, message: "short argument has no checked non-retaining contract"))
        if argument.origin_boundary < -1 or (argument.origin_boundary >= 0 and argument.origin_boundary != boundary):
            errors = errors.push(CallLoanError(point: point, message: "forwarded short borrow exceeds its originating boundary"))
        var previous = 0
        while previous < index:
            val other: CallLoan = arguments[previous]
            val same_argument = argument.argument_index >= 0 and argument.argument_index == other.argument_index
            if not same_argument and place_conflicts_with(argument.place, other.place) and kind_conflicts_with(argument.kind, other.kind):
                errors = errors.push(CallLoanError(point: point, message: "conflicting short call arguments for {place_to_text(argument.place)}"))
            previous = previous + 1
        for live in active:
            if place_conflicts_with(argument.place, live.place) and kind_conflicts_with(argument.kind, live.kind):
                errors = errors.push(CallLoanError(point: point, message: "reentrant access conflicts with active borrow of {place_to_text(argument.place)}"))
        index = index + 1
    errors
