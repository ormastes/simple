# Non-Lexical Lifetimes (NLL)
#
# Implements Non-Lexical Lifetimes for precise borrow checking.
# NLL allows borrows to end before the lexical scope ends,
# based on actual usage patterns.
#
# Based on Rust RFC 2094 (NLL) and Polonius.
#
# Key concepts:
# - Liveness: A variable is live if it may be used later
# - Region inference: Compute minimal regions for borrows
# - Error reporting: Generate helpful borrow errors

use compiler.borrow.borrow_check.lifetime.*
use compiler.borrow.borrow_check.nll_short_calls.*
use compiler.borrow.borrow_check.borrow_graph.*
use compiler.borrow.borrow_check.borrow_graph.{LoanAlias, Borrow, BorrowSet, Place, PlaceBase, PlaceElem, BorrowKind}
use compiler.borrow.borrow_check.ownership_flow.{OwnershipFlow, OwnershipEvent, OwnershipFlowError, ownership_write_covers}

# ============================================================================
# Control Flow Graph
# ============================================================================

struct BasicBlock:
    """A basic block in the CFG."""
    id: i64
    statements: [i64]      # Statement indices
    terminator_point: i64   # Global point shared with MIR fact emission
    terminator: Terminator
    predecessors: [i64]    # Block IDs
    successors: [i64]      # Block IDs

impl BasicBlock:
    static fn create(id: i64) -> BasicBlock:
        BasicBlock(
            id: id,
            statements: [],
            terminator_point: 0,
            terminator: Terminator.Unreachable,
            predecessors: [],
            successors: []
        )

enum Terminator:
    """Block terminator."""
    Return
    Goto(target: i64)
    SwitchInt(targets: [i64], otherwise: i64)
    Call(target: i64, unwind: i64?)
    Drop(target: i64, unwind: i64?)
    Unreachable


# ============================================================================
# BasicBlock Methods (was: impl BasicBlock:)
# ============================================================================

fn basicblock_create(id: i64) -> BasicBlock:
        BasicBlock(
            id: id,
            statements: [],
            terminator_point: 0,
            terminator: Terminator.Unreachable,
            predecessors: [],
            successors: []
        )


class ControlFlowGraph:
    """Control flow graph for a function."""
    blocks: Dict<i64, BasicBlock>
    entry: i64
    exit_blocks: [i64]

    static fn create() -> ControlFlowGraph:
        ControlFlowGraph(
            blocks: {},
            entry: 0,
            exit_blocks: []
        )

    me add_block(block: BasicBlock):
        """Add a block to the CFG."""
        self.blocks[block.id] = block

    me set_entry(block_id: i64):
        """Set the entry block."""
        self.entry = block_id

    me add_exit(block_id: i64):
        """Add an exit block."""
        self.exit_blocks = self.exit_blocks.push(block_id)

    me compute_predecessors():
        """Compute predecessor edges from successor edges."""
        for id in self.blocks.keys():
            val block = self.blocks[id]
            for succ_id in block.successors:
                if self.blocks.has(succ_id):
                    var succ_block = self.blocks[succ_id]
                    succ_block.predecessors = succ_block.predecessors.push(id)
                    self.blocks[succ_id] = succ_block

    fn get_block(id: i64) -> BasicBlock:
        """Get a block by ID. Explicit tail: mixed return/implicit-tail is
        miscompiled on the stage4 native lane (returns 0)."""
        if self.blocks.has(id):
            return self.blocks[id]
        return BasicBlock.create(id)

    fn block_entry_point(id: i64) -> i64:
        val block = self.get_block(id)
        if block.statements.len() > 0:
            return block.statements[0]
        block.terminator_point

    fn reverse_postorder() -> [i64]:
        """Get every reachable block in deterministic predecessor-first order.

        The old recursive helper mutated array parameters passed by value, so
        its caller observed empty `visited`/`order` arrays and NLL checked no
        blocks. This worklist is intentionally explicit. Loop-sensitive fixed
        point processing is a later step; no block may silently disappear."""
        var result: [i64] = []
        var pending: [i64] = [self.entry]
        var scheduled: Dict<i64, bool> = {}
        scheduled[self.entry] = true
        var cursor = 0
        while cursor < pending.len():
            val block_id = pending[cursor]
            cursor = cursor + 1
            result = result.push(block_id)
            if self.blocks.has(block_id):
                val block = self.blocks[block_id]
                for successor in block.successors:
                    if not scheduled.has(successor):
                        scheduled[successor] = true
                        pending = pending.push(successor)
        result

# ============================================================================
# Liveness Analysis
# ============================================================================

struct LivenessResult:
    """Result of liveness analysis."""
    # Variables live at entry of each block
    live_in: Dict<i64, [i64]>
    # Variables live at exit of each block
    live_out: Dict<i64, [i64]>

class LivenessAnalysis:
    """Computes variable liveness.

    A variable is live at a point if it may be used before being redefined.
    """
    cfg: ControlFlowGraph
    # Variables used in each block (before any def)
    uses: Dict<i64, [i64]>
    # Variables defined in each block
    defs: Dict<i64, [i64]>

    static fn create(cfg: ControlFlowGraph) -> LivenessAnalysis:
        LivenessAnalysis(
            cfg: cfg,
            uses: {},
            defs: {}
        )

    me record_use(block_id: i64, var_id: i64):
        """Record a variable use."""
        var block_uses: [i64] = self.uses[block_id] ?? []
        if not block_uses.contains(var_id):
            block_uses = block_uses.push(var_id)
        self.uses[block_id] = block_uses

    me record_def(block_id: i64, var_id: i64):
        """Record a variable definition."""
        var block_defs: [i64] = self.defs[block_id] ?? []
        if not block_defs.contains(var_id):
            block_defs = block_defs.push(var_id)
        self.defs[block_id] = block_defs

    me compute() -> LivenessResult:
        """Compute liveness using fixed-point iteration.

        Backward dataflow analysis:
        live_in[B] = use[B] ∪ (live_out[B] - def[B])
        live_out[B] = ∪ live_in[S] for all successors S
        """
        var live_in: Dict<i64, [i64]> = {}
        var live_out: Dict<i64, [i64]> = {}

        # Initialize
        for id in self.cfg.blocks.keys():
            live_in[id] = []
            live_out[id] = []

        # Fixed-point iteration (backward)
        var changed = true
        var iterations = 0
        val max_iter = 100

        while changed and iterations < max_iter:
            changed = false
            iterations = iterations + 1

            for id in self.cfg.blocks.keys():
                val block = self.cfg.blocks[id]
                # Compute live_out from successors
                var new_out: [i64] = []
                for succ_id in block.successors:
                    val succ_in: [i64] = live_in[succ_id] ?? []
                    for var_id in succ_in:
                        if not new_out.contains(var_id):
                            new_out = new_out.push(var_id)

                # Compute live_in
                val block_uses: [i64] = self.uses[id] ?? []
                val block_defs: [i64] = self.defs[id] ?? []

                var new_in: [i64] = block_uses
                for var_id in new_out:
                    if not block_defs.contains(var_id):
                        if not new_in.contains(var_id):
                            new_in = new_in.push(var_id)

                # Check for changes
                val old_in = live_in[id] ?? []
                val old_out = live_out[id] ?? []

                if new_in.len() != old_in.len() or new_out.len() != old_out.len():
                    changed = true

                live_in[id] = new_in
                live_out[id] = new_out

        LivenessResult(live_in: live_in, live_out: live_out)

# ============================================================================
# NLL Borrow Checker
# ============================================================================

struct SpanLabel:
    """A span with an associated label for error reporting."""
    span: i64
    label: text

struct NLLError:
    """NLL borrow checking error."""
    message: text
    # # DESUGARED: primary_span: i64
    has_primary_span: bool
    primary_span: i64
    secondary_spans: [SpanLabel]
    # # DESUGARED: help: text
    has_help: bool
    help: text


pub fn nllerror_format_related(err: NLLError) -> text:
    var result = ""
    for sl in err.secondary_spans:
        result = result + "|||RELATED:{sl.span}:1:{sl.label}"
    result

# ============================================================================
# NLLError Methods (was: impl NLLError:)
# ============================================================================

fn nllerror_borrow_conflict(borrow1: Borrow, borrow2: Borrow) -> NLLError:
        NLLError(
            # place_to_text / borrow_kind_to_text free fns: Place and
            # BorrowKind have no to_text METHOD — the method calls here
            # crashed at format time (latent while the checker was starved).
            message: "cannot borrow `{place_to_text(borrow1.place)}` as {borrow_kind_to_text(borrow1.kind)} because it is also borrowed as {borrow_kind_to_text(borrow2.kind)}",
            has_primary_span: true,
            primary_span: borrow1.borrow_point,
            secondary_spans: [SpanLabel(span: borrow2.borrow_point, label: "first borrow here")],
            has_help: true,
            help: "consider restructuring to avoid overlapping borrows"
        )


fn nllerror_use_while_borrowed(place: Place, borrow: Borrow, point: i64) -> NLLError:
        NLLError(
            message: "cannot use `{place_to_text(place)}` because it was mutably borrowed",
            has_primary_span: true,
            primary_span: point,
            secondary_spans: [SpanLabel(span: borrow.borrow_point, label: "mutable borrow occurs here")],
            has_help: false,
            help: ""
        )


fn nllerror_move_while_borrowed(place: Place, borrow: Borrow, point: i64) -> NLLError:
        NLLError(
            message: "cannot move out of `{place_to_text(place)}` because it is borrowed",
            has_primary_span: true,
            primary_span: point,
            secondary_spans: [SpanLabel(span: borrow.borrow_point, label: "borrow of `{place_to_text(place)}` occurs here")],
            has_help: false,
            help: ""
        )


enum LoanEvent:
    Create(loan_id: i64)
    Copy(source: Place, destination: Place)
    Assign(destination: Place)
    Use(place: Place, moving: bool)
    Escape(source: Place, reason: text)
    Suspend(reason: text)
    ShortCall(arguments: [Place], modes: [text])
    UnionCopy(sources: [Place], destination: Place)

pub fn loan_alias_place(alias: LoanAlias) -> Place:
    """Read the declared LoanAlias layout across native generic-loop boundaries."""
    alias.place

fn loan_alias_contains(aliases: [LoanAlias], candidate: LoanAlias) -> bool:
    for alias in aliases:
        if alias.loan_id == candidate.loan_id and loan_alias_origin_only(alias) == loan_alias_origin_only(candidate) and place_equals(loan_alias_place(alias), candidate.place):
            return true
    false

fn loan_alias_union(left: [LoanAlias], right: [LoanAlias]) -> [LoanAlias]:
    var merged: [LoanAlias] = []
    for alias in left:
        merged = merged.push(alias)
    for alias in right:
        if not loan_alias_contains(merged, alias):
            merged = merged.push(alias)
    merged


# @workaround bug=nll_live_aliases_method_arg_corruption_2026_10_22 reason=self_receiver_plus_array_arg_method_call_miscompiles_in_native_candidate
# Free function, not a method: `state = self.live_aliases(state, ...)`
# corrupted the aliases array argument in transit (state_len=0 at the call
# site, garbage length at function entry, deterministic SIGSEGV in the stage2
# sanity borrow_check). Same writeback/argument-shape defect family as
# cce1cddae19 (mir receiver writeback).
fn nll_live_aliases(aliases: [LoanAlias], live: [i64]) -> [LoanAlias]:
    var kept: [LoanAlias] = []
    for alias in aliases:
        var keep = true
        match loan_alias_place(alias).base:
            case PlaceBase.Local(local): keep = live.contains(local)
            case _: ()
        if keep: kept = kept.push(alias)
    kept

class NLLChecker:
    """Non-Lexical Lifetimes borrow checker.

    Performs precise borrow checking using:
    1. Region inference to compute minimal lifetimes
    2. Liveness analysis to determine when borrows end
    3. Conflict detection for overlapping borrows
    """
    cfg: ControlFlowGraph
    borrow_graph: BorrowGraph
    liveness: LivenessAnalysis
    lifetime_inference: LifetimeInference
    errors: [NLLError]
    ownership_flow: OwnershipFlow
    loan_events: Dict<i64, [LoanEvent]>
    point_uses: Dict<i64, [i64]>
    point_defs: Dict<i64, [i64]>
    initial_loans: [LoanAlias]
    loan_boundaries: Dict<i64, i64>
    loan_parents: Dict<i64, [LoanParent]>

    static fn create(cfg: ControlFlowGraph) -> NLLChecker:
        NLLChecker(
            cfg: cfg,
            borrow_graph: BorrowGraph.create(),
            liveness: LivenessAnalysis.create(cfg),
            lifetime_inference: LifetimeInference.create(),
            ownership_flow: OwnershipFlow.create(),
            loan_events: {}, point_uses: {}, point_defs: {},
            initial_loans: [], loan_boundaries: {}, loan_parents: {},
            errors: []
        )

    me check() -> bool:
        """Run the NLL borrow checker.

        Returns true if no errors.
        """
        # Moves use real edges, including loop backedges. The recorder must not
        # mutate BorrowGraph.moved_now: that source-order state conflates arms.
        var points: Dict<i64, [i64]> = {}
        var successors: Dict<i64, [i64]> = {}
        for id in self.cfg.blocks.keys():
            val block = self.cfg.blocks[id]
            var block_points: [i64] = []
            for point in block.statements:
                block_points = block_points.push(point)
            points[id] = block_points.push(block.terminator_point)
            successors[id] = block.successors
        val flow_errors: [OwnershipFlowError] = self.ownership_flow.check(self.cfg.entry, points, successors)
        for flow_error in flow_errors:
            val err: OwnershipFlowError = flow_error
            self.errors = self.errors.push(NLLError(
                message: err.message,
                has_primary_span: true,
                primary_span: err.point,
                secondary_spans: [],
                has_help: false,
                help: ""
            ))

        # Loans have their own CFG fixpoint and point liveness. Ownership's
        # maybe-moved lattice is independent of reference provenance.
        if flow_errors.is_empty():
            self.solve_loans(points)

        # Step 3: Run lifetime inference
        if not self.lifetime_inference.infer():
            # Direct field reads: accessor methods trap nil-receiver on the stage4
            # native lane (bug doc 2026-07-23, defect 3).
            for err in self.lifetime_inference.errors:
                self.errors = self.errors.push(NLLError(
                    message: err.message,
                    has_primary_span: true,
                    primary_span: err.span,
                    secondary_spans: [],
                    has_help: false,
                    help: ""
                ))

        # Step 4: Check borrow graph for conflicts
        for err in self.borrow_graph.errors:
            self.errors = self.errors.push(NLLError(
                message: err.message,
                has_primary_span: true,
                primary_span: err.point,
                secondary_spans: [],
                has_help: false,
                help: ""
            ))

        return self.errors.is_empty()

    me check_block(block_id: i64, liveness: LivenessResult):
        """Check a single basic block."""
        if not self.cfg.blocks.has(block_id):
            return
        val block = self.cfg.get_block(block_id)
        val entry_point = self.cfg.block_entry_point(block_id)
        # Propagate borrows from predecessors
        for pred_id in block.predecessors:
            val pred = self.cfg.get_block(pred_id)
            self.borrow_graph.propagate_borrows(pred.terminator_point, entry_point)

        # Check each statement
        var previous_point = -1
        for point in block.statements:
            if previous_point >= 0:
                self.borrow_graph.propagate_borrows(previous_point, point)
            self.check_statement(point)
            previous_point = point

        # Check terminator
        if previous_point >= 0:
            self.borrow_graph.propagate_borrows(previous_point,
                block.terminator_point)
        self.check_terminator(block.terminator, block.terminator_point, liveness)

    me check_statement(point: i64):
        """Check a statement for borrow violations.

        Checks the borrow graph at each program point for conflicts.
        Statements are identified by ID; the borrow graph tracks
        borrows, uses, and moves at each point.
        """
        # Check for borrow conflicts at this point
        # Free-function + if-val forms: receiver-transport and box-assuming
        # .unwrap() are miscompiled on the stage4 native lane (bug doc 2026-07-23).
        val borrow_set = self.borrow_graph.get_or_create_borrows(point)
        val active = borrowset_active_list(borrow_set.borrows)
        for borrow in active:
            val conflict = borrowset_conflicting_other(borrow_set.borrows, borrow)
            if val conflict_b = conflict:
                if borrow.id > conflict_b.id:
                    self.errors = self.errors.push(
                        nllerror_borrow_conflict(borrow, conflict_b))

    me check_terminator(term: Terminator, point: i64, liveness: LivenessResult):
        """Check terminator for borrow violations."""
        match term:
            case Return:
                # On return, all borrows must have ended
                val borrow_set = self.borrow_graph.get_or_create_borrows(point)
                val active = borrowset_active_list(borrow_set.borrows)
                for borrow in active:
                    # Only a borrow whose REFERENCE escapes via the return value
                    # can still be active at a return. Nothing in this checker
                    # ever ends a borrow (`end_borrow` has no callers and
                    # `propagate_borrows` copies every borrow forward
                    # unconditionally), so without this gate the arm fired for
                    # every function containing any `Ref` at all -- notably
                    # `f(pid, &mut status)`, whose out-parameter borrow is
                    # consumed by the call and never escapes. See
                    # `borrow_reference_escapes` for the accepted limits.
                    if not self.borrow_graph.borrow_reference_escapes(borrow.id):
                        continue
                    self.errors = self.errors.push(NLLError(
                        message: "borrow of `{place_to_text(borrow.place)}` may still be active at return",
                        has_primary_span: true,
                        primary_span: point,
                        secondary_spans: [SpanLabel(span: borrow.borrow_point, label: "borrow created here")],
                        has_help: true,
                        help: "ensure borrow ends before returning"
                    ))
            case Call(target, unwind):
                # Propagate borrows through call; check for conflicts
                self.borrow_graph.propagate_borrows(point,
                    self.cfg.block_entry_point(target))
            case Drop(target, unwind):
                # Propagate borrows through drop; check for conflicts
                self.borrow_graph.propagate_borrows(point,
                    self.cfg.block_entry_point(target))
            case Goto(target):
                self.borrow_graph.propagate_borrows(point,
                    self.cfg.block_entry_point(target))
            case SwitchInt(targets, otherwise):
                for t in targets:
                    self.borrow_graph.propagate_borrows(point,
                        self.cfg.block_entry_point(t))
                self.borrow_graph.propagate_borrows(point,
                    self.cfg.block_entry_point(otherwise))
            case Unreachable:
                pass

    me record_borrow(point: i64, place: Place, kind: BorrowKind, dest_local: i64) -> bool:
        """Record a borrow and check for conflicts.

        `dest_local` is the reference temp the `Ref` instruction writes to; it
        is what `check_terminator`'s `Return` arm needs in order to tell an
        escaping borrow from one that dies inside the function.
        """
        self.ownership_flow.record(point, OwnershipEvent.Read(place))
        self.record_live_use(point, place)
        self.record_live_def(point, Place.local(dest_local))
        val borrow = self.borrow_graph.record_borrow(point, place, kind)
        if borrow.is_none():
            return false
        self.borrow_graph.note_borrow_dest(borrow.unwrap().id, dest_local)
        self.record_loan_event(point, LoanEvent.Create(borrow.unwrap().id))
        # Add lifetime constraint
        self.lifetime_inference.env.add_outlives(
            borrow.unwrap().lifetime,
            Lifetime.Anonymous(point),
            "borrow must be valid at use"
        )
        true

    me record_returned_local(local_id: i64):
        """Record a local named by a `Ret` terminator operand."""
        self.borrow_graph.note_returned_local(local_id)

    me record_use(point: i64, place: Place):
        """Record use of a place."""
        self.ownership_flow.record(point, OwnershipEvent.Read(place))
        self.record_live_use(point, place)
        self.record_loan_event(point, LoanEvent.Use(place, false))

    me record_move(point: i64, place: Place):
        """Record move of a place."""
        self.ownership_flow.record(point, OwnershipEvent.Move(place))
        self.record_live_use(point, place)
        self.record_loan_event(point, LoanEvent.Use(place, true))

    me record_assign(point: i64, place: Place):
        """Record (re)initialization of a place.

        Kills forward-propagated moved-out state for the place so a
        re-initialized local is usable again (see BorrowGraph.record_assign).
        """
        self.ownership_flow.record(point, OwnershipEvent.Revive(place))
        self.record_live_def(point, place)
        self.record_loan_event(point, LoanEvent.Assign(place))

    me record_loan_event(point: i64, event: LoanEvent):
        var events: [LoanEvent] = []
        if self.loan_events.contains_key(point): events = self.loan_events[point]
        self.loan_events[point] = events.push(event)

    me record_live_use(point: i64, place: Place):
        match place.base:
            case PlaceBase.Local(local):
                var uses: [i64] = self.point_uses[point] ?? []
                if not uses.contains(local): uses = uses.push(local)
                self.point_uses[point] = uses
            case _: ()
        for projection in place.projections:
            match projection:
                case PlaceElem.Index(local):
                    var uses: [i64] = self.point_uses[point] ?? []
                    if not uses.contains(local): uses = uses.push(local)
                    self.point_uses[point] = uses
                case _: ()

    me record_live_def(point: i64, place: Place):
        if place.projections.len() != 0: return
        match place.base:
            case PlaceBase.Local(local):
                var defs: [i64] = self.point_defs[point] ?? []
                if not defs.contains(local): defs = defs.push(local)
                self.point_defs[point] = defs
            case _: ()

    me record_loan_copy(point: i64, source: Place, destination: Place):
        self.record_live_use(point, source)
        self.record_live_def(point, destination)
        self.record_loan_event(point, LoanEvent.Copy(source, destination))

    me record_loan_escape(point: i64, source: Place, reason: text):
        self.record_live_use(point, source)
        self.record_loan_event(point, LoanEvent.Escape(source, reason))

    me record_suspend(point: i64, reason: text):
        self.record_loan_event(point, LoanEvent.Suspend(reason))

    me loan_failure(point: i64, message: text):
        self.errors = self.errors.push(NLLError(message: message,
            has_primary_span: true, primary_span: point, secondary_spans: [],
            has_help: false, help: ""))


    me install_loans(point: i64, aliases: [LoanAlias]):
        self.borrow_graph.loan_aliases[point] = aliases
        var active = BorrowSet.create()
        for alias in aliases:
            if self.borrow_graph.loan_definitions.contains_key(alias.loan_id):
                active.borrows[alias.loan_id] = self.borrow_graph.loan_definitions[alias.loan_id]
        self.borrow_graph.point_borrows[point] = active

    me transfer_loans(point: i64, input: [LoanAlias], report: bool) -> [LoanAlias]:
        var state = loan_alias_union([], input)
        val events: [LoanEvent] = self.loan_events[point] ?? []
        for event in events:
            self.install_loans(point, state)
            match event:
                case LoanEvent.Create(id):
                    val created: Borrow = self.borrow_graph.loan_definitions[id]
                    if report:
                        var seen: [i64] = []
                        for alias in state:
                            val active: Borrow = self.borrow_graph.loan_definitions[alias.loan_id]
                            if not seen.contains(active.id) and place_conflicts_with(active.place, created.place) and kind_conflicts_with(active.kind, created.kind):
                                seen = seen.push(active.id)
                                self.errors = self.errors.push(nllerror_borrow_conflict(created, active))
                    state = self.create_loan_aliases(point, id, created.place, state)
                case LoanEvent.Copy(source, destination):
                    if place_conflicts_with(source, destination):
                        # The adapter records the write before provenance.
                        # Overlapping extraction/rebinding still reads the
                        # source value from before this instruction's write.
                        var preserved: [LoanAlias] = []
                        for alias in input:
                            if place_conflicts_with(loan_alias_place(alias), source): preserved = preserved.push(alias)
                        state = loan_alias_union(state, preserved)
                        self.install_loans(point, state)
                    self.borrow_graph.record_loan_copy(point, source, destination)
                    state = self.borrow_graph.loan_aliases[point]
                case LoanEvent.Assign(destination):
                    if report: self.borrow_graph.record_assign(point, destination)
                    var kept: [LoanAlias] = []
                    for alias in state:
                        if not ownership_write_covers(destination, loan_alias_place(alias)): kept = kept.push(alias)
                    state = kept
                case LoanEvent.Use(place, moving):
                    if report:
                        var seen: [i64] = []
                        for alias in state:
                            val active: Borrow = self.borrow_graph.loan_definitions[alias.loan_id]
                            if not seen.contains(active.id) and place_conflicts_with(place, active.place):
                                seen = seen.push(active.id)
                                if moving:
                                    self.errors = self.errors.push(nllerror_move_while_borrowed(place, active, point))
                                elif kind_is_mutable(active.kind):
                                    self.errors = self.errors.push(nllerror_use_while_borrowed(place, active, point))
                case LoanEvent.Escape(source, reason):
                    if report: self.borrow_graph.record_loan_escape(point, source, reason)
                case LoanEvent.Suspend(reason):
                    if report: self.borrow_graph.record_suspend(point, reason)
                case LoanEvent.ShortCall(arguments, modes):
                    if report: self.check_short_call(point, arguments, modes, state)
                case LoanEvent.UnionCopy(sources, destination):
                    state = self.transfer_loan_union(point, sources, destination, state, input)
        self.install_loans(point, state)
        state

    me solve_loans(points: Dict<i64, [i64]>):
        # Backward point liveness over actual successors, with use-before-def
        # preserved when both occur at one instruction. Fail closed on budget.
        var before: Dict<i64, [i64]> = {}
        var after: Dict<i64, [i64]> = {}
        var changed = true
        var work = 0
        val reachable = self.cfg.reverse_postorder()
        var point_ids: Dict<i64, bool> = {}
        for block_id in reachable:
            for point in points[block_id]: point_ids[point] = true
        for point in self.loan_events.keys():
            if not point_ids.contains_key(point):
                # Unreachable events are legal, unmapped ones are malformed.
                var mapped = false
                for block_id in points.keys():
                    if points[block_id].contains(point): mapped = true
                if not mapped:
                    self.loan_failure(point, "loan event has no CFG point")
                    return
        while changed:
            changed = false
            for block_id in reachable:
                val block = self.cfg.blocks[block_id]
                var live: [i64] = []
                for successor in block.successors:
                    val first = points[successor][0]
                    val next: [i64] = before[first] ?? []
                    for local in next:
                        if not live.contains(local): live = live.push(local)
                val block_points = points[block_id]
                var index = block_points.len()
                while index > 0:
                    index = index - 1
                    val point = block_points[index]
                    after[point] = live
                    val uses: [i64] = self.point_uses[point] ?? []
                    val defs: [i64] = self.point_defs[point] ?? []
                    var previous: [i64] = []
                    for local in uses: previous = previous.push(local)
                    for local in live:
                        if not defs.contains(local) and not previous.contains(local): previous = previous.push(local)
                    val old: [i64] = before[point] ?? []
                    if old.len() != previous.len(): changed = true
                    for local in previous:
                        if not old.contains(local): changed = true
                    before[point] = previous
                    live = previous
                    work = work + 1 + live.len()
                    if work > 1000000:
                        self.loan_failure(point, "loan liveness work budget exhausted")
                        return
        var incoming: Dict<i64, [LoanAlias]> = {}
        incoming[self.cfg.entry] = loan_alias_union([], self.initial_loans)
        var pending: [i64] = [self.cfg.entry]
        var cursor = 0
        while cursor < pending.len():
            val block_id = pending[cursor]
            cursor = cursor + 1
            var state: [LoanAlias] = incoming[block_id]
            for point in points[block_id]:
                state = nll_live_aliases(state, before[point])
                state = self.transfer_loans(point, state, false)
                state = nll_live_aliases(state, after[point])
                work = work + 1 + state.len()
                if work > 1000000:
                    self.loan_failure(point, "loan CFG work budget exhausted")
                    return
            for successor in self.cfg.blocks[block_id].successors:
                val first = not incoming.contains_key(successor)
                val old: [LoanAlias] = incoming[successor] ?? []
                val merged = loan_alias_union(old, state)
                incoming[successor] = merged
                if first or old.len() != merged.len(): pending = pending.push(successor)
        # Replay diagnostics only after all backedges and sibling joins converge.
        for block_id in incoming.keys():
            var state: [LoanAlias] = incoming[block_id]
            for point in points[block_id]:
                state = nll_live_aliases(state, before[point])
                state = self.transfer_loans(point, state, true)
                state = nll_live_aliases(state, after[point])

    fn get_errors() -> [NLLError]:
        """Get all NLL errors."""
        self.errors

    fn format_errors() -> [text]:
        """Format errors for display."""
        var result: [text] = []
        for err in self.errors:
            var msg = "error: {err.message}"
            if err.has_help:
                msg = "{msg}\n  help: {err.help}"
            result = result.push(msg)
        result

