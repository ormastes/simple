"""Deferred call-wide short-loan checks and function-entry loan origins."""
use compiler.borrow.borrow_check.nll.{NLLChecker, LoanEvent, loan_alias_union, loan_alias_place}
use compiler.borrow.borrow_check.borrow_graph.{Borrow, BorrowKind, LoanAlias, Place, PlaceElem, place_conflicts_with, place_equals, place_base_equals, place_elem_equals, place_append_projection, loan_alias_append}
use compiler.borrow.borrow_check.ownership_flow.{ownership_write_covers}
use compiler.borrow.borrow_check.call_loans.{CallLoan, check_call_loans}

pub struct LoanParent:
    loan_id: i64
    alias: Place

struct CallView:
    origin: i64
    place: Place

struct LoanWalk:
    id: i64
    suffix: [PlaceElem]
    visited: [i64]

pub fn loan_alias_origin_only(alias: LoanAlias) -> bool:
    alias.origin_only

impl NLLChecker:
    me record_short_parameter(local: i64, kind: BorrowKind, boundary: i64):
        if boundary < 0:
            self.loan_failure(-1, "short parameter has no originating boundary")
            return
        val id = self.borrow_graph.next_borrow_id
        self.borrow_graph.next_borrow_id = id + 1
        val referent = Place.static_var("short-parameter-{local}")
        val loan = Borrow.create(id, referent, kind,
            self.borrow_graph.lifetimes.fresh_lifetime(), -1)
        self.borrow_graph.loan_definitions[id] = loan
        self.borrow_graph.borrow_dest[id] = local
        self.loan_boundaries[id] = boundary
        self.initial_loans = loan_alias_append(self.initial_loans,
            LoanAlias(loan_id: id, place: Place.local(local)))

    me record_short_call(point: i64, arguments: [Place], modes: [text]):
        for argument in arguments: self.record_live_use(point, argument)
        self.record_loan_event(point, LoanEvent.ShortCall(arguments, modes))

    me record_loan_union(point: i64, sources: [Place], destination: Place):
        for source in sources: self.record_live_use(point, source)
        self.record_live_def(point, destination)
        self.record_loan_event(point, LoanEvent.UnionCopy(sources, destination))

    me transfer_loan_union(point: i64, sources: [Place], destination: Place, state: [LoanAlias], original: [LoanAlias]) -> [LoanAlias]:
        var input = loan_alias_union([], state)
        for source in sources:
            if place_conflicts_with(source, destination):
                for alias in original:
                    if place_conflicts_with(source, loan_alias_place(alias)): input = loan_alias_append(input, alias)
        var result: [LoanAlias] = []
        for alias in input:
            if not ownership_write_covers(destination, loan_alias_place(alias)):
                result = loan_alias_append(result, alias)
        for source in sources:
            self.borrow_graph.loan_aliases[point] = input
            self.borrow_graph.record_loan_copy(point, source, destination)
            result = loan_alias_union(result, self.borrow_graph.loan_aliases[point])
        result

    fn loan_is_ancestor(ancestor: i64, descendant: i64) -> bool:
        var pending: [i64] = [descendant]
        var visited: [i64] = []
        var cursor = 0
        while cursor < pending.len():
            val current = pending[cursor]
            cursor = cursor + 1
            if visited.contains(current): continue
            visited = visited.push(current)
            val parents: [LoanParent] = self.loan_parents[current] ?? []
            for parent in parents:
                if parent.loan_id == ancestor: return true
                if not visited.contains(parent.loan_id): pending = pending.push(parent.loan_id)
        false

    fn specific_call_aliases(aliases: [LoanAlias]) -> [LoanAlias]:
        # Only inherited lifetime links are excluded. A true parent view on
        # another predecessor retains origin_only=false across the join.
        var actual: [LoanAlias] = []
        for alias in aliases:
            if not loan_alias_origin_only(alias): actual = loan_alias_append(actual, alias)
        actual

    me create_loan_aliases(point: i64, id: i64, source: Place, input: [LoanAlias]) -> [LoanAlias]:
        self.record_call_parents(id, source, input)
        val destination = Place.local(self.borrow_graph.borrow_dest[id])
        self.borrow_graph.record_loan_copy(point, source, destination)
        val copied: [LoanAlias] = self.borrow_graph.loan_aliases[point]
        var state: [LoanAlias] = []
        for alias in copied:
            if ownership_write_covers(destination, loan_alias_place(alias)):
                state = loan_alias_append(state, LoanAlias(loan_id: alias.loan_id,
                    place: loan_alias_place(alias), origin_only: true))
            else:
                state = loan_alias_append(state, alias)
        # An explicit reference definition is the actual view; copied parent
        # links keep the underlying owner protected for its entire live range.
        loan_alias_append(state, LoanAlias(loan_id: id, place: destination))

    me record_call_parents(id: i64, source: Place, state: [LoanAlias]):
        var matching: [LoanAlias] = []
        for alias in state:
            if alias.loan_id != id and place_conflicts_with(source, loan_alias_place(alias)):
                matching = loan_alias_append(matching, alias)
        var parents: [LoanParent] = self.loan_parents[id] ?? []
        for alias in self.specific_call_aliases(matching):
            var found = false
            for parent in parents:
                if parent.loan_id == alias.loan_id and place_equals(parent.alias, loan_alias_place(alias)): found = true
            if not found: parents = parents.push(LoanParent(loan_id: alias.loan_id, alias: loan_alias_place(alias)))
        self.loan_parents[id] = parents

    me canonical_call_views(point: i64, id: i64) -> [CallView]:
        var pending: [LoanWalk] = [LoanWalk(id: id, suffix: [], visited: [])]
        var views: [CallView] = []
        var cursor = 0
        while cursor < pending.len():
            val walk: LoanWalk = pending[cursor]
            cursor = cursor + 1
            if cursor > 100000:
                self.loan_failure(point, "short call provenance work budget exhausted")
                return []
            if walk.visited.contains(walk.id):
                self.loan_failure(point, "short call has cyclic loan provenance")
                continue
            var visited: [i64] = []
            for previous in walk.visited: visited = visited.push(previous)
            visited = visited.push(walk.id)
            val loan: Borrow = self.borrow_graph.loan_definitions[walk.id]
            val parents: [LoanParent] = self.loan_parents[walk.id] ?? []
            if parents.is_empty():
                var projected: [PlaceElem] = []
                for projection in loan.place.projections: projected = place_append_projection(projected, projection)
                for projection in walk.suffix: projected = place_append_projection(projected, projection)
                views = views.push(CallView(origin: walk.id, place: Place(base: loan.place.base, projections: projected)))
            for parent in parents:
                var valid = place_base_equals(loan.place.base, parent.alias.base)
                if loan.place.projections.len() < parent.alias.projections.len(): valid = false
                var index = 0
                while valid and index < parent.alias.projections.len():
                    if not place_elem_equals(loan.place.projections[index], parent.alias.projections[index]): valid = false
                    index = index + 1
                if not valid:
                    self.loan_failure(point, "short call cannot resolve a projected loan origin")
                    continue
                var suffix: [PlaceElem] = []
                index = parent.alias.projections.len()
                if index < loan.place.projections.len():
                    match loan.place.projections[index]:
                        case PlaceElem.Deref: index = index + 1
                        case _: ()
                while index < loan.place.projections.len():
                    suffix = place_append_projection(suffix, loan.place.projections[index])
                    index = index + 1
                for projection in walk.suffix: suffix = place_append_projection(suffix, projection)
                pending = pending.push(LoanWalk(id: parent.loan_id, suffix: suffix, visited: visited))
        views

    me check_short_call(point: i64, arguments: [Place], modes: [text], state: [LoanAlias]):
        var calls: [CallLoan] = []
        var delegated: [i64] = []
        var boundary = point
        var has_origin = false
        var index = 0
        for argument in arguments:
            val mode: text = if index < modes.len(): modes[index] else: "unknown"
            index = index + 1
            val known = mode == "read-short" or mode == "mutate-short"
            val kind = if mode == "mutate-short": BorrowKind.Mutable else: BorrowKind.Shared
            var aliases: [LoanAlias] = []
            for alias in state:
                if place_conflicts_with(argument, loan_alias_place(alias)): aliases = loan_alias_append(aliases, alias)
            if aliases.is_empty():
                if known:
                    calls = calls.push(CallLoan(place: argument, kind: kind, origin_boundary: -1,
                        contract_known: true, argument_index: index - 1))
                continue
            if not known:
                self.borrow_graph.record_loan_escape(point, argument, "call argument requires a checked non-retaining short contract")
                continue
            for alias in aliases:
                val immediate: Borrow = self.borrow_graph.loan_definitions[alias.loan_id]
                if mode == "mutate-short" and immediate.kind == BorrowKind.Shared:
                    self.loan_failure(point, "shared short borrow cannot become exclusive")
                if not delegated.contains(alias.loan_id): delegated = delegated.push(alias.loan_id)
            var views: [CallView] = []
            for alias in self.specific_call_aliases(aliases):
                for view in self.canonical_call_views(point, alias.loan_id):
                    var projected: [PlaceElem] = []
                    for projection in view.place.projections: projected = place_append_projection(projected, projection)
                    var suffix_index = loan_alias_place(alias).projections.len()
                    if suffix_index < argument.projections.len():
                        match argument.projections[suffix_index]:
                            case PlaceElem.Deref: suffix_index = suffix_index + 1
                            case _: ()
                    while suffix_index < argument.projections.len():
                        projected = place_append_projection(projected, argument.projections[suffix_index])
                        suffix_index = suffix_index + 1
                    val projected_view = CallView(origin: view.origin,
                        place: Place(base: view.place.base, projections: projected))
                    var duplicate = false
                    for previous in views:
                        if previous.origin == projected_view.origin and place_equals(previous.place, projected_view.place): duplicate = true
                    if not duplicate: views = views.push(projected_view)
            if views.is_empty(): self.loan_failure(point, "short argument has no resolvable loan origin")
            for view in views:
                val loan: Borrow = self.borrow_graph.loan_definitions[view.origin]
                val token = self.loan_boundaries[view.origin] ?? -1
                if loan.borrow_point < 0 and token < 0:
                    self.loan_failure(point, "forwarded short borrow has no originating boundary")
                elif token >= 0 and not has_origin:
                    boundary = token
                    has_origin = true
                calls = calls.push(CallLoan(place: view.place, kind: kind,
                    origin_boundary: token, contract_known: true, argument_index: index - 1))
        var active: [CallLoan] = []
        var included: [i64] = []
        for alias in state:
            if not delegated.contains(alias.loan_id) and not included.contains(alias.loan_id):
                included = included.push(alias.loan_id)
                val loan: Borrow = self.borrow_graph.loan_definitions[alias.loan_id]
                for view in self.canonical_call_views(point, alias.loan_id):
                    active = active.push(CallLoan(place: view.place, kind: loan.kind,
                        origin_boundary: self.loan_boundaries[view.origin] ?? -1, contract_known: true))
        for error in check_call_loans(point, boundary, calls, active): self.loan_failure(error.point, error.message)
