# Borrow Graph
#
# Tracks borrows and their relationships for borrow checking.
# The borrow graph represents:
# - Active borrows at each program point
# - Conflicts between borrows
# - Invalidation of borrows
#
# Based on Rust's MIR borrow checker.

use compiler.borrow.borrow_check.lifetime.*

# ============================================================================
# Place (Memory Location)
# ============================================================================

pub enum PlaceBase:
    """Base of a memory place."""
    Local(id: i64)       # Local variable
    Static(name: text)   # Static variable
    Promoted(id: i64)    # Promoted constant

pub enum PlaceElem:
    """Element in a place projection."""
    Deref                      # *place
    Field(idx: i64)            # place.field
    Index(local: i64)          # place[idx]
    ConstantIndex(idx: i64)    # place[constant]
    Downcast(variant: i64)     # (place, )

pub struct Place:
    """A memory location (lvalue).

    Places are paths to memory: local, local.field, *local, etc.
    """
    base: PlaceBase
    projections: [PlaceElem]

impl Place:
    static fn local(id: i64) -> Place:
        Place(base: PlaceBase.Local(id), projections: [])

    static fn static_var(name: text) -> Place:
        Place(base: PlaceBase.Static(name), projections: [])


# ============================================================================
# Place/Kind Conflict Detection
# ============================================================================

pub fn place_base_equals(a: PlaceBase, b: PlaceBase) -> bool:
    """Check if two place bases are equal."""
    match a:
        case Local(a_id):
            match b:
                case Local(b_id): a_id == b_id
                case _: false
        case Static(a_name):
            match b:
                case Static(b_name): a_name == b_name
                case _: false
        case Promoted(a_id):
            match b:
                case Promoted(b_id): a_id == b_id
                case _: false

pub fn place_elem_equals(a: PlaceElem, b: PlaceElem) -> bool:
    """Check if two place projection elements are equal."""
    match a:
        case Deref:
            match b:
                case Deref: true
                case _: false
        case Field(a_idx):
            match b:
                case Field(b_idx): a_idx == b_idx
                case _: false
        case Index(a_local):
            match b:
                case Index(b_local): a_local == b_local
                case _: false
        case ConstantIndex(a_idx):
            match b:
                case ConstantIndex(b_idx): a_idx == b_idx
                case _: false
        case Downcast(a_v):
            match b:
                case Downcast(b_v): a_v == b_v
                case _: false

pub fn place_elem_may_overlap(a: PlaceElem, b: PlaceElem) -> bool:
    """Conservative projection overlap.

    `Index(local)` records the local that supplies an index, not its runtime
    value. Two different locals can therefore select the same element. They
    must conflict until range/value analysis emits an explicit disjointness
    proof; treating their local IDs as element IDs was unsound.
    """
    match a:
        case Field(a_idx):
            match b:
                case Field(b_idx): a_idx == b_idx
                case _: false
        case ConstantIndex(a_idx):
            match b:
                case ConstantIndex(b_idx): a_idx == b_idx
                case Index(_): true
                case _: false
        case Index(_):
            match b:
                case Index(_): true
                case ConstantIndex(_): true
                case _: false
        case Downcast(a_v):
            match b:
                case Downcast(b_v): a_v == b_v
                case _: false
        case Deref:
            match b:
                case Deref: true
                case _: false

pub fn place_conflicts_with(a: Place, b: Place) -> bool:
    """Check if two places conflict (one is a prefix of the other).

    Two places conflict when they refer to overlapping memory.
    Examples: x conflicts with x.field, x[0] conflicts with x.
    """
    val same_base = place_base_equals(a.base, b.base)
    if not same_base:
        return false
    # One is prefix of the other (e.g., x vs x.field)
    val a_len = a.projections.len()
    val b_len = b.projections.len()
    val min_len = if a_len < b_len: a_len else: b_len
    var i = 0
    while i < min_len:
        if not place_elem_may_overlap(a.projections[i], b.projections[i]):
            return false
        i = i + 1
    true

pub fn borrow_kind_to_text(k: BorrowKind) -> text:
    """Render a borrow kind for diagnostics (BorrowKind has no to_text
    method; same latent format-time crash class as place_to_text)."""
    match k:
        case Shared: "shared"
        case Mutable: "mutable"
        case Unique: "unique"

pub fn place_to_text(p: Place) -> text:
    """Render a place for diagnostics.

    SF1 (2026-07-28): the error constructors below used `place.to_text()`,
    but Place never had a to_text method — every move/borrow-of-moved error
    CRASHED at format time. Latent until now because the checker was
    starved of Move input and the paths never fired.
    """
    var s = ""
    match p.base:
        case Local(id):
            s = "local({id})"
        case Static(name):
            s = "static({name})"
        case Promoted(id):
            s = "promoted({id})"
    for proj in p.projections:
        match proj:
            case Deref:
                s = "*{s}"
            case Field(idx):
                s = "{s}.f{idx}"
            case Index(local):
                s = "{s}[local {local}]"
            case ConstantIndex(idx):
                s = "{s}[{idx}]"
            case Downcast(v):
                s = "({s} as variant {v})"
    s

pub fn place_equals(a: Place, b: Place) -> bool:
    """Check if two places are exactly equal (same base, same projection path)."""
    if not place_base_equals(a.base, b.base):
        return false
    if a.projections.len() != b.projections.len():
        return false
    var i = 0
    while i < a.projections.len():
        if not place_elem_equals(a.projections[i], b.projections[i]):
            return false
        i = i + 1
    true

pub fn kind_conflicts_with(a: BorrowKind, b: BorrowKind) -> bool:
    """Check if two borrow kinds conflict.

    Shared+Shared is OK, anything else conflicts.
    """
    match a:
        case Shared:
            match b:
                case Shared: false
                case _: true
        case _: true

pub fn kind_is_mutable(kind: BorrowKind) -> bool:
    """Check if a borrow kind is mutable."""
    match kind:
        case Mutable: true
        case Unique: true
        case Shared: false

# ============================================================================
# Place Methods (was: impl Place:)
# ============================================================================

pub fn place_local(id: i64) -> Place:
        """Create place for local variable."""
        Place(base: PlaceBase.Local(id), projections: [])


pub fn place_static_var(name: text) -> Place:
        """Create place for static variable."""
        Place(base: PlaceBase.Static(name), projections: [])


pub fn place_deref(self: Place) -> Place:
        """Add dereference projection."""
        Place(
            base: self.base,
            projections: self.projections.push(PlaceElem.Deref)
        )


pub fn place_field(self: Place, idx: i64) -> Place:
        """Add field projection."""
        Place(
            base: self.base,
            projections: self.projections.push(PlaceElem.Field(idx))
        )


pub fn place_index(self: Place, local: i64) -> Place:
        """Add index projection."""
        Place(
            base: self.base,
            projections: self.projections.push(PlaceElem.Index(local))
        )


# ============================================================================
# Borrow Kind
# ============================================================================

pub enum BorrowKind:
    """Kind of borrow."""
    Shared      # &T - immutable borrow
    Mutable     # &mut T - mutable borrow
    Unique      # Unique borrow (for closures)


# ============================================================================
# BorrowKind Methods (was: impl BorrowKind:)
# ============================================================================

# ============================================================================
# Borrow
# ============================================================================

pub struct Borrow:
    """A borrow of a place.

    Tracks where, what kind, and for how long.
    """
    id: i64
    place: Place
    kind: BorrowKind
    lifetime: Lifetime
    borrow_point: i64    # Where borrow was created
    activated: bool      # Two-phase borrow: activated yet

impl Borrow:
    static fn create(id: i64, place: Place, kind: BorrowKind, lifetime: Lifetime, point: i64) -> Borrow:
        Borrow(
            id: id,
            place: place,
            kind: kind,
            lifetime: lifetime,
            borrow_point: point,
            activated: true
        )

    static fn two_phase(id: i64, place: Place, kind: BorrowKind, lifetime: Lifetime, point: i64) -> Borrow:
        """Create two-phase borrow (not yet activated)."""
        Borrow(
            id: id,
            place: place,
            kind: kind,
            lifetime: lifetime,
            borrow_point: point,
            activated: false
        )


# ============================================================================
# Borrow Methods (was: impl Borrow:)
# ============================================================================

pub fn borrow_create(id: i64, place: Place, kind: BorrowKind, lifetime: Lifetime, point: i64) -> Borrow:
        Borrow(
            id: id,
            place: place,
            kind: kind,
            lifetime: lifetime,
            borrow_point: point,
            activated: true
        )


pub fn borrow_two_phase(id: i64, place: Place, kind: BorrowKind, lifetime: Lifetime, point: i64) -> Borrow:
        """Create two-phase borrow (not yet activated)."""
        Borrow(
            id: id,
            place: place,
            kind: kind,
            lifetime: lifetime,
            borrow_point: point,
            activated: false
        )


# ============================================================================
# Borrow Set
# ============================================================================

pub class BorrowSet:
    """Set of active borrows at a program point."""
    borrows: Dict<i64, Borrow>
    next_id: i64

    static fn create() -> BorrowSet:
        BorrowSet(borrows: {}, next_id: 0)

    me add_borrow(place: Place, kind: BorrowKind, lifetime: Lifetime, point: i64) -> Borrow:
        """Add a new borrow."""
        val id = self.next_id
        self.next_id = self.next_id + 1

        val borrow = borrow_create(id, place, kind, lifetime, point)
        self.borrows[id] = borrow
        borrow

    me remove_borrow(id: i64):
        """Remove a borrow."""
        var next: Dict<i64, Borrow> = {}
        for key in self.borrows.keys():
            if key != id:
                next[key] = self.borrows[key]
        self.borrows = next

    fn get_borrow(id: i64) -> Borrow?:
        """Get a borrow by ID.

        contains_key + index read, never `.get()`: a native struct-valued
        `Dict.get()` HIT returns a corrupt Option.
        See doc/07_guide/language/dict_native_pitfalls.md
        """
        if self.borrows.contains_key(id):
            return Some(self.borrows[id])
        return nil

    fn active_borrows() -> [Borrow]:
        """Get all active borrows."""
        var result: [Borrow] = []
        for id in self.borrows.keys():
            val borrow = self.borrows[id]
            result = result.push(borrow)
        return result

    fn borrows_of(place: Place) -> [Borrow]:
        """Get all borrows of a place (or prefix/suffix)."""
        var result: [Borrow] = []
        for id in self.borrows.keys():
            val borrow = self.borrows[id]
            if place_conflicts_with(borrow.place, place):
                result = result.push(borrow)
        return result

    fn has_conflicting_borrow(place: Place, kind: BorrowKind) -> Borrow?:
        """Check if there's a conflicting borrow."""
        for id in self.borrows.keys():
            val borrow = self.borrows[id]
            if place_conflicts_with(borrow.place, place):
                if kind_conflicts_with(borrow.kind, kind):
                    return borrow
        return nil

# Free-function forms of BorrowSet queries: on the stage4 native lane a
# method called on a value bound from a call return reads `self` fields as
# nil/0 (receiver-transport defect, see bug doc 2026-07-23). The Dict handle
# passed as a plain argument transports correctly.
pub fn borrowset_active_list(borrows: Dict<i64, Borrow>) -> [Borrow]:
    var result: [Borrow] = []
    for id in borrows.keys():
        result = result.push(borrows[id])
    return result

pub fn borrowset_conflicting(borrows: Dict<i64, Borrow>, place: Place, kind: BorrowKind) -> Borrow?:
    for id in borrows.keys():
        val borrow = borrows[id]
        if place_conflicts_with(borrow.place, place):
            if kind_conflicts_with(borrow.kind, kind):
                return borrow
    return nil

# ============================================================================
# Borrow Graph
# ============================================================================

pub struct BorrowError:
    """Borrow checking error."""
    message: text
    # # DESUGARED: borrow: Borrow
    has_borrow: bool
    borrow: Borrow
    # # DESUGARED: conflicting: Borrow
    has_conflicting: bool
    conflicting: Borrow
    point: i64


# ============================================================================
# BorrowError Methods (was: impl BorrowError:)
# ============================================================================

pub fn borrowerror_conflict(borrow: Borrow, conflicting: Borrow, point: i64) -> BorrowError:
        BorrowError(
            message: "Conflicting borrows",
            # # DESUGARED: borrow: Some(borrow)
            borrow: borrow,
            # # DESUGARED: conflicting: Some(conflicting)
            conflicting: conflicting,
            point: point
        )


pub fn borrowerror_use_after_move(place: Place, point: i64) -> BorrowError:
        BorrowError(
            message: "Use of moved value: {place_to_text(place)}",
            #  # DESUGARED: borrow: nil
            #  # DESUGARED: conflicting: nil
            point: point
        )


pub fn borrowerror_borrow_of_moved(place: Place, point: i64) -> BorrowError:
        BorrowError(
            message: "Borrow of moved value: {place_to_text(place)}",
            #  # DESUGARED: borrow: nil
            #  # DESUGARED: conflicting: nil
            point: point
        )


pub class BorrowGraph:
    """Graph tracking borrows throughout a function.

    Nodes are program points, edges represent borrow flow.
    """
    # Borrows active at each program point
    point_borrows: Dict<i64, BorrowSet>

    # Places that have been moved AT a given point (per-point gen record)
    moved_places: Dict<i64, [Place]>

    # Forward-propagated moved state (SF1 fix, 2026-07-28): the running
    # union of all moves recorded so far on the analysis walk, minus places
    # revived by a later reassignment (kill-on-reassign). The old design
    # only consulted moved_places[point] at the SAME point, so a move at
    # pt3 + use at pt7 was undetectable by construction.
    #
    # CFG note: mod.spl's analyze_mir_borrows records instructions in
    # program order with monotonically increasing points, so this linear
    # forward union is a conservative superset of the CFG may-move union
    # (a move inside one branch is also considered moved while walking the
    # sibling branch, not just after the join). That over-approximation is
    # acceptable: Move instructions only enter MIR from explicit move
    # sites, which Simple's surface language does not produce today
    # (assignment is copy for value types, reference-share for classes;
    # `iso` move-only transfer is planned but erased at HIR type lowering).
    moved_now: [Place]

    # Accumulated errors
    errors: [BorrowError]

    # Lifetime environment
    lifetimes: LifetimeEnv

    static fn create() -> BorrowGraph:
        BorrowGraph(
            point_borrows: {},
            moved_places: {},
            moved_now: [],
            errors: [],
            lifetimes: LifetimeEnv.create()
        )

    me get_or_create_borrows(point: i64) -> BorrowSet:
        """Get or create borrow set for a program point.

        contains_key + index read, never `.get()`: a native struct-valued
        `Dict.get()` HIT returns a non-nil Option with a CORRUPT payload
        (the value's heap pointer is right-shifted by 3), so the first field
        read segfaults. contains_key and the bracket read both decode
        correctly and share the same key encoding (lower_dict_key).
        See doc/07_guide/language/dict_native_pitfalls.md — this supersedes
        the earlier has()+bracket "probe mismatch" note, which came from the
        misdiagnosis round that the bug doc retracts."""
        if self.point_borrows.contains_key(point):
            return self.point_borrows[point]
        val set = BorrowSet.create()
        self.point_borrows[point] = set
        set

    me record_borrow(point: i64, place: Place, kind: BorrowKind) -> Borrow?:
        """Record a borrow at a program point.

        Returns the borrow if successful, nil if conflicting.
        """
        var borrow_set = self.get_or_create_borrows(point)

        # Check for conflicts
        val conflict = borrow_set.has_conflicting_borrow(place, kind)
        if conflict.?:
            val new_borrow = Borrow.create(0, place, kind, self.lifetimes.fresh_lifetime(), point)
            self.errors = self.errors.push(borrowerror_conflict(new_borrow, conflict.unwrap(), point))
            return nil

        # Check if place was moved (forward-propagated state, not just
        # moves recorded at this same point)
        for moved_place in self.moved_now:
            if place_conflicts_with(place, moved_place):
                self.errors = self.errors.push(borrowerror_borrow_of_moved(place, point))
                return nil

        # Create the borrow
        val lifetime = self.lifetimes.fresh_lifetime()
        val borrow = borrow_set.add_borrow(place, kind, lifetime, point)
        self.point_borrows[point] = borrow_set

        borrow

    me record_use(point: i64, place: Place):
        """Record a use of a place.

        Checks the place against the forward-propagated moved state
        (a move at ANY earlier point on the walk that has not been killed
        by a reassignment), not only moves recorded at this same point.
        """
        for moved_place in self.moved_now:
            if place_conflicts_with(place, moved_place):
                self.errors = self.errors.push(borrowerror_use_after_move(place, point))
                return

    me record_move(point: i64, place: Place):
        """Record a move of a place.

        Keeps the per-point gen record (moved_places) and adds the place
        to the forward moved state so later program points observe it.

        LANE ISO1 (2026-07-29): checks the forward-propagated moved state
        FIRST, mirroring record_use. Before this, moving an
        already-moved place (e.g. `val b = a; val c = a` where every
        place-read of an iso-typed `a` lowers to a real Move -- see
        mir_lowering_stmts.spl's mir_hir_type_is_isolated wiring, not just
        the first one) silently re-recorded the move with no diagnostic:
        record_use only ever saw an explicit Copy instruction, which an
        iso-typed source never emits (it is move-only by definition), so
        this exact "second transfer of an already-moved iso place" pattern
        -- the shape a real iso use-after-move program actually lowers to
        -- was invisible. A second move of a place already in moved_now IS
        a use-after-move: it reads memory the first move already
        invalidated.
        """
        for moved_place in self.moved_now:
            if place_conflicts_with(place, moved_place):
                self.errors = self.errors.push(borrowerror_use_after_move(place, point))
                return
        var moved: [Place] = self.moved_places[point] ?? []
        moved = moved.push(place)
        self.moved_places[point] = moved
        self.moved_now = self.moved_now.push(place)

    me record_assign(point: i64, place: Place):
        """Record an assignment to a place.

        This may invalidate borrows of the place. It also KILLS moved
        state the write fully covers (re-initialization revives the
        place): a whole-local write revives the local and everything
        under it; a projected write revives only the exact place.
        """
        if self.moved_now.len() > 0:
            var kept: [Place] = []
            for mp in self.moved_now:
                var killed = false
                if place.projections.len() == 0:
                    killed = place_base_equals(mp.base, place.base)
                else:
                    killed = place_equals(mp, place)
                if not killed:
                    kept = kept.push(mp)
            self.moved_now = kept
        var borrow_set = self.get_or_create_borrows(point)

        # Find conflicting borrows
        val conflicts = borrow_set.borrows_of(place)
        for borrow in conflicts:
            if kind_is_mutable(borrow.kind):
                self.errors = self.errors.push(BorrowError(
                    message: "Assignment while mutably borrowed: {place_to_text(place)}",
                    # # DESUGARED: borrow: Some(borrow)
            borrow: borrow,
                    conflicting: nil,
                    point: point
                ))

    me end_borrow(point: i64, borrow_id: i64):
        """End a borrow at a program point."""
        var borrow_set = self.get_or_create_borrows(point)
        borrow_set.remove_borrow(borrow_id)
        self.point_borrows[point] = borrow_set

    me propagate_borrows(from_point: i64, to_point: i64):
        """Propagate borrows from one point to another (control flow)."""
        val from_set = self.get_or_create_borrows(from_point)
        var to_set = self.get_or_create_borrows(to_point)

        for id in from_set.borrows.keys():
            val borrow = from_set.borrows[id]
            # Check if borrow is still live at to_point
            # (simplified: copy all borrows)
            to_set.borrows[borrow.id] = borrow

        self.point_borrows[to_point] = to_set

    fn get_errors() -> [BorrowError]:
        """Get all borrow errors."""
        self.errors

    fn has_errors() -> bool:
        """Check if there are borrow errors."""
        not self.errors.is_empty()
