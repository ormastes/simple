use compiler.common.driver_core_types.{CompileResult}
use compiler.driver.driver_public_compile_backends.{run_compile_to_path}
use compiler.driver.driver_compile_vhdl_source_map.{_compile_simple_vhdl_subset, _write_simple_vhdl_source_map, _file_contains_vhdl_design}

extern fn rt_file_read_text(path: text) -> text

pub fn aot_vhdl_file(path: text, output: text) -> CompileResult:
    val fallback_result = _compile_simple_vhdl_subset(path, output)
    if fallback_result.is_success():
        return fallback_result
    val fallback_errors = fallback_result.get_errors().join("\n")
    if fallback_errors.contains("VHDL subset fallback bit slice") or fallback_errors.contains("VHDL subset fallback concat") or fallback_errors.contains("VHDL Python-HDL parity gap") or fallback_errors.contains("VHDL-MEM-") or fallback_errors.contains("port collision after VHDL sanitization") or fallback_errors.contains("duplicate input port after VHDL sanitization"):
        return fallback_result
    val external_result = run_compile_to_path(path, output, ["--backend=vhdl"])
    if external_result.is_success() and _file_contains_vhdl_design(output):
        val source = rt_file_read_text(path) ?? ""
        val vhdl = rt_file_read_text(output) ?? ""
        _write_simple_vhdl_source_map(path, output, source, vhdl)
        return external_result
    external_result
