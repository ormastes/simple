# `.lib.sdn` sidecar emit and parse (AC-2). One `key: value` per line; text
# values are double-quoted, iface_parts is a quoted list.

use compiler.driver.libver.identity.{LibIdentity}

fn sdn_quote(s: text) -> text:
    "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

fn sdn_unquote(s: text) -> Option<text>:
    if s.len() < 2 or not s.starts_with("\"") or not s.ends_with("\""):
        return None
    Some(s[1:s.len() - 1].replace("\\\"", "\"").replace("\\\\", "\\"))

fn libver_emit_sidecar(id: LibIdentity) -> text:
    var quoted: [text] = []
    for p in id.iface_parts:
        quoted.push(sdn_quote(p))
    var lines: [text] = []
    lines.push("name: " + sdn_quote(id.name))
    lines.push("semver: " + sdn_quote(id.semver))
    lines.push("abi_major: {id.abi_major}")
    lines.push("abi_minor: {id.abi_minor}")
    lines.push("iface_digest: " + sdn_quote(id.iface_digest))
    lines.push("iface_parts: [" + quoted.join(", ") + "]")
    lines.push("producer: " + sdn_quote(id.producer))
    lines.push("triple: " + sdn_quote(id.triple))
    lines.push("cpu_tier: " + sdn_quote(id.cpu_tier))
    lines.push("sha256: " + sdn_quote(id.sha256))
    lines.join("\n") + "\n"

# Values per key, in file order; a duplicated key is malformed.
struct SidecarRow:
    key: text
    value: text

fn sidecar_rows(src: text) -> Option<[SidecarRow]>:
    var rows: [SidecarRow] = []
    for line in src.split("\n"):
        val t = line.trim()
        if t == "" or t.starts_with("#"):
            continue
        val at = t.index_of(":")
        if at <= 0:
            return None
        val key = t[0:at].trim()
        for r in rows:
            if r.key == key:
                return None
        rows.push(SidecarRow(key: key, value: t[at + 1:].trim()))
    Some(rows)

fn row_value(rows: [SidecarRow], key: text) -> text:
    for r in rows:
        if r.key == key:
            return r.value
    ""

fn row_text(rows: [SidecarRow], key: text) -> Option<text>:
    sdn_unquote(row_value(rows, key))

fn row_int(rows: [SidecarRow], key: text) -> Option<i64>:
    val v = row_value(rows, key)
    if v == "":
        return None
    for ch in v.chars():
        if ch < "0" or ch > "9":
            return None
    Some(v.to_int())

# Splits `["a", "b"]`; items may not contain `", "` (interface header lines do not).
fn row_list(rows: [SidecarRow], key: text) -> Option<[text]>:
    val v = row_value(rows, key)
    if v == "":
        return Some([])
    if not v.starts_with("[") or not v.ends_with("]"):
        return None
    val inner = v[1:v.len() - 1].trim()
    var out: [text] = []
    if inner == "":
        return Some(out)
    for item in inner.split("\", \""):
        var s = item
        if not s.starts_with("\""):
            s = "\"" + s
        if not s.ends_with("\"") or s.len() < 2:
            s = s + "\""
        match sdn_unquote(s):
            case Some(x): out.push(x)
            case None: return None
    Some(out)

fn libver_parse_sidecar(src: text) -> Option<LibIdentity>:
    val rows_opt = sidecar_rows(src)
    if rows_opt.is_none():
        return None
    val rows = rows_opt.unwrap()
    val name = row_text(rows, "name")
    val semver = row_text(rows, "semver")
    val abi_major = row_int(rows, "abi_major")
    val abi_minor = row_int(rows, "abi_minor")
    val digest = row_text(rows, "iface_digest")
    val parts = row_list(rows, "iface_parts")
    val producer = row_text(rows, "producer")
    val triple = row_text(rows, "triple")
    val tier = row_text(rows, "cpu_tier")
    val sha = row_text(rows, "sha256")
    if name.is_none() or semver.is_none() or abi_major.is_none() or abi_minor.is_none() or digest.is_none() or parts.is_none() or producer.is_none() or triple.is_none() or tier.is_none() or sha.is_none():
        return None
    Some(LibIdentity(name: name.unwrap(), semver: semver.unwrap(), abi_major: abi_major.unwrap(), abi_minor: abi_minor.unwrap(), iface_digest: digest.unwrap(), iface_parts: parts.unwrap(), producer: producer.unwrap(), triple: triple.unwrap(), cpu_tier: tier.unwrap(), sha256: sha.unwrap()))
