# File naming for versioned library artifacts (AC-3, AC-13..AC-17).
# Plan: doc/03_plan/compiler/lib_dylib_versioning_plan.md

struct LibPlatformNames:
    """Per-OS dynamic-library identity: file extension and the name the OS
    loader records (ELF DT_SONAME, Mach-O install_name, PE DLL name)."""
    os: text
    ext: text
    soname: text
    install_name: text
    compat_version: text

fn libver_os_of(triple: text) -> text:
    if triple.contains("windows"):
        return "windows"
    if triple.contains("apple") or triple.contains("darwin") or triple.contains("macos"):
        return "macos"
    if triple.contains("freebsd"):
        return "freebsd"
    if triple.contains("simpleos"):
        return "simpleos"
    if triple.contains("linux"):
        return "linux"
    ""

fn libver_dylib_ext(triple: text) -> text:
    match libver_os_of(triple):
        case "windows": "dll"
        case "macos": "dylib"
        case _: "so"

# ELF hosts (linux, freebsd, simpleos): soname lib<name>.so.<abi_major>.
# macOS: install_name @rpath/lib<name>.<abi_major>.dylib, compat <major>.<minor>.0.
# Windows: no soname; the DLL file name itself carries -v<abi_major>.
fn libver_platform_names(triple: text, name: text, abi_major: i64, abi_minor: i64) -> LibPlatformNames:
    val os = libver_os_of(triple)
    val ext = libver_dylib_ext(triple)
    var soname = ""
    var install_name = ""
    var compat = ""
    if os == "macos":
        install_name = "@rpath/lib{name}.{abi_major}.dylib"
        compat = "{abi_major}.{abi_minor}.0"
    elif os == "windows":
        soname = "{name}-v{abi_major}.dll"
    elif os != "":
        soname = "lib{name}.so.{abi_major}"
    LibPlatformNames(os: os, ext: ext, soname: soname, install_name: install_name, compat_version: compat)

fn name_stdlib(semver: text, triple: text, tier: text) -> text:
    "libsimple_std-{semver}-{triple}-{tier}.a"

fn name_backend(name: text, triple: text, abi: i64) -> text:
    "backend_{name}-{triple}-v{abi}.{libver_dylib_ext(triple)}"

fn name_tier_dylib(name: text, semver: text, triple: text, tier: text) -> text:
    "lib{name}-{semver}-{triple}-{tier}.{libver_dylib_ext(triple)}"

# Parsed artifact file name. Triples contain '-', so fields are recovered
# against a known triple list rather than by naive splitting.
struct LibNameParts:
    name: text
    semver: text
    abi: i64
    triple: text
    tier: text

fn libver_known_triples() -> [text]:
    ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "riscv64-unknown-linux-gnu", "x86_64-pc-windows-gnu", "aarch64-pc-windows-gnu", "x86_64-apple-darwin", "aarch64-apple-darwin", "x86_64-unknown-freebsd", "aarch64-unknown-freebsd", "riscv64-unknown-freebsd", "x86_64-unknown-simpleos", "aarch64-unknown-simpleos", "riscv64-unknown-simpleos"]

fn strip_suffix(s: text, suffix: text) -> text:
    if s.ends_with(suffix):
        return s[0:s.len() - suffix.len()]
    ""

# "<head>-<triple>-<tail>" -> (head, triple, tail); empty triple when none matches.
fn split_on_triple(s: text) -> (text, text, text):
    for t in libver_known_triples():
        val at = s.index_of("-{t}-")
        if at > 0:
            return (s[0:at], t, s[at + t.len() + 2:])
    ("", "", "")

fn parse_stdlib_name(filename: text) -> Option<LibNameParts>:
    if not filename.starts_with("libsimple_std-"):
        return None
    val body = strip_suffix(filename[14:], ".a")
    if body == "":
        return None
    val (semver, triple, tier) = split_on_triple("x-" + body)
    if triple == "":
        return None
    Some(LibNameParts(name: "simple_std", semver: semver[2:], abi: 0, triple: triple, tier: tier))

fn parse_backend_name(filename: text) -> Option<LibNameParts>:
    if not filename.starts_with("backend_"):
        return None
    val dot = filename.last_index_of(".")
    if dot < 0:
        return None
    val (name, triple, vabi) = split_on_triple(filename[8:dot])
    if triple == "" or not vabi.starts_with("v"):
        return None
    val abi = vabi[1:].to_int()
    Some(LibNameParts(name: name, semver: "", abi: abi, triple: triple, tier: ""))

fn parse_tier_dylib_name(filename: text) -> Option<LibNameParts>:
    if not filename.starts_with("lib"):
        return None
    val dot = filename.last_index_of(".")
    if dot < 0:
        return None
    val (head, triple, tier) = split_on_triple(filename[3:dot])
    if triple == "":
        return None
    val dash = head.last_index_of("-")
    if dash <= 0:
        return None
    Some(LibNameParts(name: head[0:dash], semver: head[dash + 1:], abi: 0, triple: triple, tier: tier))
