# Cache-key component (AC-9) and release publish manifest (AC-10).

use compiler.driver.libver.identity.{LibIdentity}
use compiler.driver.libver.sidecar.{sdn_quote}

# Length-prefixed fields so no field value can forge a neighbour's boundary.
fn libver_cache_component(id: LibIdentity) -> text:
    var out = "libver/v1"
    for f in [id.name, id.semver, "{id.abi_major}.{id.abi_minor}", id.iface_digest, id.producer, id.triple, id.cpu_tier]:
        out = out + "|{f.len()}:" + f
    out

struct LibPublishEntry:
    file_name: text
    id: LibIdentity

# Deterministic SDN manifest, sorted by file name, for the rc pipeline.
fn libver_publish_manifest(entries: [LibPublishEntry]) -> text:
    var names: [text] = []
    for e in entries:
        names.push(e.file_name)
    var lines: [text] = ["libs:"]
    for n in names.sort():
        for e in entries:
            if e.file_name == n:
                lines.push("  - file: " + sdn_quote(e.file_name))
                lines.push("    name: " + sdn_quote(e.id.name))
                lines.push("    semver: " + sdn_quote(e.id.semver))
                lines.push("    triple: " + sdn_quote(e.id.triple))
                lines.push("    cpu_tier: " + sdn_quote(e.id.cpu_tier))
                lines.push("    sha256: " + sdn_quote(e.id.sha256))
                break
    lines.join("\n") + "\n"
