# Library and dynamic-library version identity, admission, and manifest.
# Pure Simple implementation of AC-2 through AC-10 from the lib-versioning plan.
# Design: doc/05_design/compiler/lib_dylib_versioning.md

use compiler.driver.libver.identity ({LibIdentity})
use compiler.driver.libver.naming ({
    name_stdlib, name_backend, name_tier_dylib,
    parse_stdlib_name, parse_backend_name, parse_tier_dylib_name
})
use compiler.driver.libver.sidecar ({
    libver_emit_sidecar, libver_parse_sidecar
})
use compiler.driver.libver.admit ({
    LibHostReq, LibAdmit, LibRefusal,
    libver_admit
})
use compiler.driver.libver.cache ({
    libver_cache_component, libver_publish_manifest
})
