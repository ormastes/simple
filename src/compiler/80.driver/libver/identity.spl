# LibIdentity — canonical version identity for a library artifact.
# AC-2: LibIdentity round-trips through sidecar SDN emit/parse.

struct LibIdentity:
    """Canonical version identity for a library artifact.

    These fields uniquely identify a compiled library and are persisted in the
    sidecar SDN for admission checks. The digest uses interface_digest_of from
    action_key.spl (simple/interface/v1).
    """
    name: text              # Logical library name (e.g. "simple_std", "backend_llvm")
    semver: text            # Semantic version: MAJOR.MINOR.PATCH[-pre]
    abi_major: i64          # Binary ABI major version
    abi_minor: i64          # Binary ABI minor version
    iface_digest: text      # Interface digest (simple/interface/v1)
    iface_parts: [text]     # Optional: sorted list of interface items
    producer: text          # Compiler fingerprint of producing compiler
    triple: text            # LLVM target triple
    cpu_tier: text          # CPU tier level (e.g. "x86-64-v2", "armv8.2-a", "generic")
    sha256: text            # SHA256 of artifact bytes
