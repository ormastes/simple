    NativeMirSelectiveRowV1, native_mir_selective_load_bundle_v1,
    native_mir_selective_load_body_in_owned_scope_v1, native_mir_selective_provider_row_v1}
use compiler.driver.driver_build.native_mir_shard_export_v1.{native_mir_shard_export_dir_v1}
use compiler.driver.driver_build.native_mir_shard.{native_mir_shard_spec_v1,
    native_mir_shard_count_of_v1, native_mir_shard_claim_cap_v1,
    native_mir_shard_claim_v1, native_mir_shard_lpt_order_v1,
    NativeMirShardLinkInputsV1, native_mir_shard_link_inputs_v1}
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_inventory}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.backend.backend_helpers.{get_effective_backend_name}
use compiler.driver.driver_pipeline_lowering.{_driver_collect_mir_errors,
    driver_collect_mir_advisories, driver_mir_has_new_fatal_errors_v1,
    driver_trait_devirtualization_allowed_v1}
use compiler.driver.driver_pipeline_lowering.*
use compiler.driver.driver_mir_error_owner.{driver_trace_module_mir_errors}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings,
    hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.driver.cache.hir_mir_archive_consumer_v1.{MirArchiveLoweringFailureV1,
    mir_archive_failure_v1}
use compiler.hir.hir_types.{SymbolId, SymbolTable}
use compiler.hir.hir_symbol_table_methods.*
