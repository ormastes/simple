    bootstrap_fn_param_defaults_detach_for_archive_v1}
use compiler.mir._MirLowering.bootstrap_globals.{bootstrap_mir_registries_promote}
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLowering.declaration_providers_v1.*
use compiler.mir._MirLowering.declaration_enum_metadata_v1.*
use compiler.mir._MirLowering.declaration_inventory_barriers_v1.*
