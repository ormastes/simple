# Selective, process-private MIR worker. No source frontend fallback is legal.
# The producer owns admission; this consumer owns one decoded body at a time.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_mir_selective_producer_v1.{driver_mir_selective_context_identity_v1}
use compiler.driver.driver_mir_selective_eligibility_v1.{driver_mir_selective_explicit_native_eligible_v1,
    driver_mir_selective_bootstrap_owner_v1}
