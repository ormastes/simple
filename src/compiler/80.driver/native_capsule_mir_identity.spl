# Pure MIR content identity shared by driver capsules and native qualification.
# Keep input bytes and SymbolId key object identity unchanged.
use compiler.hir.hir_types.{SymbolId, HirType, HirTypeKind, DimExpr,
    DimExprKind, DeviceType, Effect, EffectKind}
use compiler.mir.mir_types.{MirTypeDef, MirTypeDefKind, LayoutPhase}
use compiler.mir.mir_instruction_graph.{MirModule, MirFunction}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common._Attributes.decl_attrs.{DriverManifestAttrKind,
    VhdlResetPolarity, VhdlResetSynchrony}
use compiler.mir.mir_json.{serialize_mir_function, serialize_mir_type,
    serialize_const_value}
use std.common.crypto.sha256.{sha256_text, Sha256StreamV1, sha256_stream_v1_new}
use std.common.text_bytes.{text_to_utf8_bytes}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin,
    transient_scope_pause, transient_scope_end, transient_promote}

fn storage_identity_text_v1(value: text) -> text:
    "{value.len()}:{value}"

fn native_capsule_sorted_symbol_ids_v1(keys: [SymbolId]) -> [SymbolId]:
    # Sorts an int permutation and never binds a struct element to a local.
    # Binding one (`val temporary = result[i]`) COPIES the struct under native
    # codegen, and a Dict keyed by a struct is keyed by object IDENTITY
    # (rt_core_dict_hash mixes the raw pointer, runtime_native.c:9220; and
    # rt_native_eq answers 0 for two distinct struct allocations,
    # runtime_native.c:4002). So every swapped key used to come back as a fresh
    # object its own dict no longer resolved, and the caller's
    # `module.functions[symbol]` answered nil -- site 8's SEGV in
    # serialize_mir_function.
    var ids: [i64] = []
    var i = 0
    while i < keys.len():
        ids.push(keys[i].id)
        i = i + 1
    var result: [SymbolId] = []
    for index in native_capsule_sorted_order_v1(ids):
        result.push(keys[index])
    result

# Ascending permutation of `ids`, ties kept in input order. This runs for every
# function/constant/static/type map on each capsule MIR identity computation
# (several times per module), so it is a bottom-up merge sort: O(n log n)
# instead of the former O(n^2) exchange sort. For distinct ids (the normal case
# for one module map) the permutation equals the exchange sort's; ties are stable.
pub fn native_capsule_sorted_order_v1(ids: [i64]) -> [i64]:
    val n = ids.len()
    var order: [i64] = []
    var scratch: [i64] = []
    var i = 0
    while i < n:
        order.push(i)
        scratch.push(i)
        i = i + 1
    var width = 1
    while width < n:
        var left = 0
        while left < n:
            var mid = left + width
            if mid > n:
                mid = n
            var right = left + width + width
            if right > n:
                right = n
            var a = left
            var b = mid
            var k = left
            while k < right:
                var take_left = false
                if a < mid:
                    if b >= right:
                        take_left = true
                    elif ids[order[a]] <= ids[order[b]]:
                        take_left = true
                if take_left:
                    scratch[k] = order[a]
                    a = a + 1
                else:
                    scratch[k] = order[b]
                    b = b + 1
                k = k + 1
            left = right
        val swapped = order
        order = scratch
        scratch = swapped
        width = width + width
    order

pub fn native_capsule_type_def_identity_v1(type_def: MirTypeDef) -> text:
    var kind_identity = ""
    match type_def.kind:
        case Struct(fields):
            var rows: [text] = []
            for field in fields:
                rows.push("{storage_identity_text_v1(field.name)}|{serialize_mir_type(field.type_)}|{field.offset}|{field.has_bits_attr}|{field.bits_width}")
            val joined_rows = rows.join(";")
            kind_identity = "struct|{storage_identity_text_v1(joined_rows)}"
        case Enum(variants):
            var rows: [text] = []
            for variant in variants:
                var payload = "none"
                if val payload_type = variant.payload:
                    payload = serialize_mir_type(payload_type)
                rows.push("{storage_identity_text_v1(variant.name)}|{variant.discriminant}|{storage_identity_text_v1(payload)}")
            val joined_rows = rows.join(";")
            kind_identity = "enum|{storage_identity_text_v1(joined_rows)}"
        case Union(variants):
            var rows: [text] = []
            for variant in variants: rows.push(serialize_mir_type(variant))
            val joined_rows = rows.join(";")
            kind_identity = "union|{storage_identity_text_v1(joined_rows)}"
    "{type_def.symbol.id}|{storage_identity_text_v1(type_def.name)}|{storage_identity_text_v1(kind_identity)}|{type_def.is_export_c}|{storage_identity_text_v1(type_def.export_name)}"

fn native_capsule_hir_type_identity_v1(type_: HirType) -> text:
    match type_.kind:
        case Int(bits, signed): "int:{bits}:{signed}"
        case Float(bits): "float:{bits}"
        case Bool: "bool"
        case Char: "char"
        case Str: "str"
        case Unit: "unit"
        case Nil: "nil"
        case Tuple(elements):
            var rows: [text] = []
            for element in elements: rows.push(native_capsule_hir_type_identity_v1(element))
            "tuple:{storage_identity_text_v1(rows.join(";"))}"
        case Array(element, size):
            var size_identity = "dynamic"
            if val fixed_size = size:
                # Workaround GH-2983: retain the known i64 at MIR method dispatch.
                # @workaround bug=native_identity_i64_receiver_type_loss_2026_10_11 reason=retain known i64 method receiver provenance without conversion
                val typed_size: i64 = fixed_size
                size_identity = typed_size.to_text()
            "array:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(element))}:{size_identity}"
        case Slice(element): "slice:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(element))}"
        case Dict(key, value): "dict:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(key))}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(value))}"
        case Ref(inner, mutable): "ref:{mutable}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Ptr(inner, mutable): "ptr:{mutable}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Optional(inner): "optional:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Result(ok, err): "result:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(ok))}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(err))}"
        case Named(symbol, args):
            var rows: [text] = []
            for arg in args: rows.push(native_capsule_hir_type_identity_v1(arg))
            "named:{symbol.id}:{storage_identity_text_v1(rows.join(";"))}"
        case TypeParam(name, bounds):
            var rows: [text] = []
            for bound in bounds: rows.push(native_capsule_hir_type_identity_v1(bound))
            "param:{storage_identity_text_v1(name)}:{storage_identity_text_v1(rows.join(";"))}"
        case Union(members):
            var rows: [text] = []
            for member in members: rows.push(native_capsule_hir_type_identity_v1(member))
            "union:{storage_identity_text_v1(rows.join(";"))}"
        case DynTrait(trait_): "dyn:{trait_.id}"
        case Function(params, ret, effects):
            var param_rows: [text] = []
            for param in params: param_rows.push(native_capsule_hir_type_identity_v1(param))
            var effect_rows: [text] = []
            for effect in effects: effect_rows.push(native_capsule_effect_identity_v1(effect))
            "fn:{storage_identity_text_v1(param_rows.join(";"))}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(ret))}:{storage_identity_text_v1(effect_rows.join(";"))}"
        case Projection(base, assoc_name): "projection:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(base))}:{storage_identity_text_v1(assoc_name)}"
        case Isolated(inner): "isolated:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Unique(inner): "unique:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Shared(inner): "shared:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Weak(inner): "weak:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(inner))}"
        case Infer(id, level): "infer:{id}:{level}"
        case Error: "error"
        case Never: "never"
        case Any: "any"
        case Tensor(element, dims, device):
            var dim_rows: [text] = []
            for dim in dims: dim_rows.push(native_capsule_dim_identity_v1(dim))
            var device_identity = "none"
            if val selected_device = device: device_identity = native_capsule_device_identity_v1(selected_device)
            "tensor:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(element))}:{storage_identity_text_v1(dim_rows.join(";"))}:{device_identity}"
        case Layer(input, output):
            var input_rows: [text] = []
            for dim in input: input_rows.push(native_capsule_dim_identity_v1(dim))
            var output_rows: [text] = []
            for dim in output: output_rows.push(native_capsule_dim_identity_v1(dim))
            "layer:{storage_identity_text_v1(input_rows.join(";"))}:{storage_identity_text_v1(output_rows.join(";"))}"

fn native_capsule_dim_identity_v1(dim: DimExpr) -> text:
    match dim.kind:
        case Literal(value): "literal:{value}"
        case Named(name, lo, hi):
            var lo_identity = "none"
            var hi_identity = "none"
            if val lo_value = lo:
                # @workaround bug=native_identity_i64_receiver_type_loss_2026_10_11 reason=retain known i64 method receiver provenance without conversion
                val typed_lo: i64 = lo_value
                lo_identity = typed_lo.to_text()
            if val hi_value = hi:
                # @workaround bug=native_identity_i64_receiver_type_loss_2026_10_11 reason=retain known i64 method receiver provenance without conversion
                val typed_hi: i64 = hi_value
                hi_identity = typed_hi.to_text()
            "named:{storage_identity_text_v1(name)}:{lo_identity}:{hi_identity}"
        case Var(id): "var:{id}"
        case Dynamic: "dynamic"
        case Broadcast: "broadcast"
        case ConstParam(name): "const:{storage_identity_text_v1(name)}"
        case Add(left, right): "add:{storage_identity_text_v1(native_capsule_dim_identity_v1(left))}:{storage_identity_text_v1(native_capsule_dim_identity_v1(right))}"
        case Mul(left, right): "mul:{storage_identity_text_v1(native_capsule_dim_identity_v1(left))}:{storage_identity_text_v1(native_capsule_dim_identity_v1(right))}"
        case Div(left, right): "div:{storage_identity_text_v1(native_capsule_dim_identity_v1(left))}:{storage_identity_text_v1(native_capsule_dim_identity_v1(right))}"

fn native_capsule_device_identity_v1(device: DeviceType) -> text:
    match device:
        case CPU: "cpu"
        case CUDA(id): "cuda:{id}"
        case Vulkan(id): "vulkan:{id}"

fn native_capsule_effect_identity_v1(effect: Effect) -> text:
    match effect.kind:
        case Pure: "pure"
        case IO: "io"
        case Async: "async"
        case Throws(type_): "throws:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(type_))}"
        case Mutates: "mutates"
        case Allocates: "allocates"
        case Custom(name): "custom:{storage_identity_text_v1(name)}"
        case Unknown: "unknown"

pub fn native_capsule_function_metadata_identity_v1(function: MirFunction) -> text:
    var generic_rows: [text] = []
    for param in function.generic_params: generic_rows.push(storage_identity_text_v1(param))
    var specialization = "none"
    if val specialization_name = function.specialization_of:
        specialization = storage_identity_text_v1(specialization_name)
    var binding_keys = function.type_bindings.keys()
    var i = 0
    while i < binding_keys.len():
        var j = i + 1
        while j < binding_keys.len():
            if binding_keys[j] < binding_keys[i]:
                val temporary = binding_keys[i]
                binding_keys[i] = binding_keys[j]
                binding_keys[j] = temporary
            j = j + 1
        i = i + 1
    var binding_rows: [text] = []
    for key in binding_keys:
        binding_rows.push("{storage_identity_text_v1(key)}:{storage_identity_text_v1(native_capsule_hir_type_identity_v1(function.type_bindings[key]))}")
    var layout_identity = "none"
    if val layout = function.layout_phase:
        layout_identity = match layout:
            case Startup: "startup"
            case FirstFrame: "first-frame"
            case Steady: "steady"
            case Cold: "cold"
    # `driver_manifest_attr` is nil whenever `has_driver_manifest_attr` is
    # false -- declaration_lowering.spl:549-550 stores the paired
    # `DriverManifestAttr?` straight through. Dereferencing it unguarded traps
    # with "undefined field 'kind': cannot access field on value of type 'nil'"
    # for EVERY ordinary function, which broke the whole AOT lane. Same defect
    # class as the 2026-08-01 SIGILL documented at declaration_lowering.spl:502.
    var manifest_kind = "none"
    var manifest_driver_class = 0
    var manifest_vendor = 0
    var manifest_version = ""
    var manifest_abi = ""
    var device_rows: [text] = []
    if function.has_driver_manifest_attr:
        manifest_kind = match function.driver_manifest_attr.kind:
            case Driver: "driver"
            case NativeLib: "native-lib"
        manifest_driver_class = function.driver_manifest_attr.driver_class
        manifest_vendor = function.driver_manifest_attr.vendor
        manifest_version = function.driver_manifest_attr.version
        manifest_abi = function.driver_manifest_attr.abi
        for device_id in function.driver_manifest_attr.device_ids:
            # @workaround bug=native_identity_i64_receiver_type_loss_2026_10_11 reason=retain known i64 method receiver provenance without conversion
            val typed_device_id: i64 = device_id
            device_rows.push(typed_device_id.to_text())
    var vhdl_generic_rows: [text] = []
    for generic in function.vhdl_metadata.generics:
        vhdl_generic_rows.push("{storage_identity_text_v1(generic.name)}:{storage_identity_text_v1(generic.type_text)}:{storage_identity_text_v1(generic.default_text)}")
    var validation_rows: [text] = []
    for error in function.vhdl_metadata.clocked.validation_errors:
        validation_rows.push(storage_identity_text_v1(error))
    var return_rows: [text] = []
    for field in function.vhdl_metadata.return_fields:
        return_rows.push("{storage_identity_text_v1(field.label)}:{storage_identity_text_v1(field.type_text)}")
    val reset_polarity = match function.vhdl_metadata.clocked.reset_polarity:
        case ActiveLow: "active-low"
        case ActiveHigh: "active-high"
    val reset_synchrony = match function.vhdl_metadata.clocked.reset_synchrony:
        case Async: "async"
        case Sync: "sync"
        case None_: "none"
    val identity = "generic={storage_identity_text_v1(generic_rows.join(";"))}|template={function.is_generic_template}|specialization={specialization}|bindings={storage_identity_text_v1(binding_rows.join(";"))}|layout={layout_identity}|kernel={function.is_kernel}:{storage_identity_text_v1(function.gpu_target)}:{storage_identity_text_v1(function.gpu_backend_order)}|export={function.is_export_c}:{storage_identity_text_v1(function.export_name)}|manifest={function.has_driver_manifest_attr}:{manifest_kind}:{manifest_driver_class}:{manifest_vendor}:{storage_identity_text_v1(device_rows.join(";"))}:{storage_identity_text_v1(manifest_version)}:{storage_identity_text_v1(manifest_abi)}|vhdl={function.has_vhdl_metadata}:{function.vhdl_metadata.is_hardware}:{storage_identity_text_v1(vhdl_generic_rows.join(";"))}:{function.vhdl_metadata.has_clocked}:{storage_identity_text_v1(function.vhdl_metadata.clocked.clock_signal)}:{storage_identity_text_v1(function.vhdl_metadata.clocked.reset_signal)}:{function.vhdl_metadata.clocked.has_reset}:{reset_polarity}:{reset_synchrony}:{storage_identity_text_v1(function.vhdl_metadata.clocked.domain)}:{function.vhdl_metadata.clocked.is_valid}:{storage_identity_text_v1(validation_rows.join(";"))}:{storage_identity_text_v1(return_rows.join(";"))}:{function.vhdl_metadata.flatten_struct_output}|fast-math={function.has_fast_math}|fpga={function.unroll_factor}:{function.pipeline_ii}:{function.memory_banks}"
    # XRay sled intent changes emitted code; appended only when set so every
    # static-off identity is unchanged.
    val emission = native_capsule_function_emission_identity_v1(function)
    if function.xray_mode != 0:
        return identity + "|xray={function.xray_mode}" + emission
    identity + emission

# reason: canonical identity text of emitter attributes
@allow(primitive_api)
pub fn native_capsule_function_emission_identity_v1(function: MirFunction) -> text:
    """Emitter-read function attributes that no other identity row carries:
    naked, forced inline, section, alignment, unmangled linkage, comdat, the
    SIMD requirement, strict no-GC and the short-call contracts
    (_MirToLlvm/core_codegen.spl). A body instantiated from another module
    brings these with it, and that module's interface slice drops bodies, so
    they must be in the consumer's MIR identity. "" when every one is at its
    default, so identities of ordinary functions are unchanged.
    """
    var contract_keys = function.short_call_contracts.keys()
    var i = 0
    while i < contract_keys.len():
        var j = i + 1
        while j < contract_keys.len():
            if contract_keys[j] < contract_keys[i]:
                val temporary = contract_keys[i]
                contract_keys[i] = contract_keys[j]
                contract_keys[j] = temporary
            j = j + 1
        i = i + 1
    var contract_rows: [text] = []
    for key in contract_keys:
        var value_rows: [text] = []
        for entry in function.short_call_contracts[key]:
            value_rows.push(storage_identity_text_v1(entry))
        contract_rows.push("{storage_identity_text_v1(key)}={storage_identity_text_v1(value_rows.join(","))}")
    if not function.is_naked and not function.is_inline and function.section == "" and
            function.align == 0 and not function.is_global and not function.is_comdat and
            function.simd_req_level == "" and function.simd_req_backend == "" and
            not function.simd_disabled and not function.nogc_strict and
            contract_rows.len() == 0:
        return ""
    "|emit=naked:{function.is_naked}:inline:{function.is_inline}:section:{storage_identity_text_v1(function.section)}:align:{function.align}:global:{function.is_global}:comdat:{function.is_comdat}:simd:{storage_identity_text_v1(function.simd_req_level)}:{storage_identity_text_v1(function.simd_req_backend)}:{function.simd_disabled}:nogc-strict:{function.nogc_strict}:short-calls:{storage_identity_text_v1(contract_rows.join(";"))}"

# reason: canonical identity text of emitter attributes
@allow(primitive_api)
pub fn native_capsule_static_emission_identity_v1(alignment: i64,
        visibility: Visibility, is_external: bool) -> text:
    """Emitter-read static attributes (alignment, hidden/default linkage,
    external declaration). "" at the defaults, so ordinary statics keep their
    identity. Visibility is folded exactly as llvm_static_linkage reads it.
    """
    val linkage = match visibility:
        case Visibility.Public: "public"
        case _: "hidden"
    if alignment == 0 and linkage == "hidden" and not is_external:
        return ""
    "|emit=align:{alignment}:linkage:{linkage}:external:{is_external}"

pub fn compute_native_capsule_mir_identity_v1(module: MirModule) -> text:
    # The immutable MIR predates this call. Serialization, metadata rows and
    # hashing buffers are scratch; only the digest escapes repeated witness,
    # capsule-freeze and validation calls. Preserve an existing caller scope.
    val owns_scratch = transient_scope_begin()
    val digest = native_capsule_mir_identity_unscoped_v1(module)
    if not owns_scratch: return digest
    if not transient_scope_pause():
        transient_scope_end()
        return ""
    val retained = transient_promote<text>(digest)
    val ended = transient_scope_end()
    if not retained or not ended: return ""
    digest

class _MirIdentityStreamHasherV1:
    """Bounded chunked incremental SHA-256 hasher avoiding giant row-join buffers."""
    stream: Sha256StreamV1
    has_row: bool
    failed: bool

    static fn create() -> _MirIdentityStreamHasherV1:
        _MirIdentityStreamHasherV1(
            stream: sha256_stream_v1_new(),
            has_row: false,
            failed: false
        )

    me feed_chunked(value: text):
        if self.failed:
            return
        val raw = text_to_utf8_bytes(value)
        val total = raw.len()
        if total <= 4096:
            if not self.stream.update(raw):
                self.failed = true
            return
        var off = 0
        while off < total:
            val rem = total - off
            val take = if rem < 4096: rem else: 4096
            var chunk: [u8] = [0u8; take]
            var i = 0
            while i < take:
                chunk[i] = raw[off + i]
                i = i + 1
            if not self.stream.update(chunk):
                self.failed = true
                return
            off = off + take

    me feed_row(row: text):
        if self.failed:
            return
        if self.has_row:
            if not self.stream.update_byte(10u8):
                self.failed = true
                return
        else:
            self.has_row = true
        self.feed_chunked(row)

    me finish_digest() -> text:
        if self.failed:
            return ""
        self.stream.finish_hex() ?? ""

fn native_capsule_mir_identity_unscoped_v1(module: MirModule) -> text:
    var hasher = _MirIdentityStreamHasherV1.create()
    hasher.feed_row("module|{storage_identity_text_v1(module.name)}")
    # Index each dict with the sorted keys() element itself: a `for symbol in`
    # binding of a SymbolId is a native struct COPY under the frozen Phase 2
    # pin, and struct dict keys hash by address in the C runtime, so the
    # lookup missed and serialize_mir_function read a nil MirFunction
    # (0xC0000005 reading 0x3 in the MIR shard worker).
    val function_keys = native_capsule_sorted_symbol_ids_v1(module.functions.keys())
    var function_i = 0
    while function_i < function_keys.len():
        val function = module.functions[function_keys[function_i]]
        hasher.feed_row("fn|{function_keys[function_i].id}|{storage_identity_text_v1(serialize_mir_function(function))}|{storage_identity_text_v1(native_capsule_function_metadata_identity_v1(function))}")
        function_i = function_i + 1
    val constant_keys = native_capsule_sorted_symbol_ids_v1(module.constants.keys())
    var constant_i = 0
    while constant_i < constant_keys.len():
        val constant = module.constants[constant_keys[constant_i]]
        hasher.feed_row("const|{constant_keys[constant_i].id}|{storage_identity_text_v1(constant.name)}|{serialize_mir_type(constant.type_)}|{storage_identity_text_v1(serialize_const_value(constant.value))}")
        constant_i = constant_i + 1
    val static_keys = native_capsule_sorted_symbol_ids_v1(module.statics.keys())
    var static_i = 0
    while static_i < static_keys.len():
        val static_value = module.statics[static_keys[static_i]]
        var init_identity = "none"
        if val init = static_value.init:
            init_identity = "{init.symbol.id}|{storage_identity_text_v1(init.name)}|{serialize_mir_type(init.type_)}|{storage_identity_text_v1(serialize_const_value(init.value))}"
        hasher.feed_row("static|{static_keys[static_i].id}|{storage_identity_text_v1(static_value.name)}|{serialize_mir_type(static_value.type_)}|{static_value.is_mutable}|{storage_identity_text_v1(init_identity)}" + native_capsule_static_emission_identity_v1(static_value.alignment, static_value.visibility, static_value.is_external))
        static_i = static_i + 1
    val type_keys = native_capsule_sorted_symbol_ids_v1(module.types.keys())
    var type_i = 0
    while type_i < type_keys.len():
        hasher.feed_row("type|{native_capsule_type_def_identity_v1(module.types[type_keys[type_i]])}")
        type_i = type_i + 1
    # Read by the emitter (xray ring exports); a row only when set.
    if module.xray_ring_wrap:
        hasher.feed_row("xray-ring-wrap|true")
    hasher.finish_digest()
