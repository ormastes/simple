# Lightweight compatibility facade for external compiler helpers.

# The process-delegating implementations are DEFINED as `external_*` and only
# ALIASED to the short public names here, so they cannot collide with the
# identically-signatured in-process definitions in driver_api_compile_single.spl.
# That collision is what made `check_file` dispatch to the external delegator
# and produced the compile-delegation loop. See that file's header for detail.
pub use compiler.driver.driver_public_compile_process.{
    external_compile_file as compile_file,
    external_compile_to_smf as compile_to_smf,
    external_compile_files as compile_files,
    external_jit_file as jit_file,
    external_check_file as check_file,
    external_parse_sdn_file as parse_sdn_file
}
pub use compiler.driver.driver_public_compile_backends.{
    aot_file, aot_c_file, aot_llvm_file, aot_llvm_native_file,
    aot_native_file_with_backend, aot_native_project_with_backend,
    aot_cuda_file, aot_opencl_file
}
pub use compiler.driver.driver_public_compile_vhdl.{aot_vhdl_file}
