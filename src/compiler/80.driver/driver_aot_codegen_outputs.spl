# Driver AOT source and GPU text outputs.

use compiler.backend.backend.backend_helpers.{compile_module_with_backend}
use compiler.backend.backend_types.{CompiledModule}
use compiler.backend.backend.cmake_gen.{generate_cmake_for_modules}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileResult, compileoptions_effective_mir_opt_level}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_source_loading.{_driver_entry_import_dirname}
use compiler.driver.aot_output_aggregation.{aot_join_text_fragments, aot_join_wat_fragments}
use compiler.common.config.{Logger}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text, recursive: bool) -> bool
extern fn rt_path_join(a: text, b: text) -> text

fn output_log_debug(log: Logger, message: text):
    if log.level >= 10:
        print "[DEBUG] {message}"

fn output_log_trace(log: Logger, message: text):
    if log.level >= 20:
        print "[TRACE] {message}"

fn output_log_info(log: Logger, message: text):
    if log.level >= 4:
        print "[INFO] {message}"

fn output_mir_opt_level(ctx: CompileContext) -> i64:
    compileoptions_effective_mir_opt_level(ctx.options)

impl CompilerDriver:
    me compile_to_c(output: text) -> CompileResult:
        """Compile all MIR modules to C++20 source."""
        if output.ends_with(".cpp") or output.ends_with(".c") or output.ends_with(".cxx"):
            return self.compile_to_c_single_file(output)
        self.compile_to_c_directory(output)

    me compile_to_c_single_file(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT C: generating C++20 to {output}")

        var c_fragments: [text] = []
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module: {name}")
            val compiled = compile_module_with_backend(
                "c", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "C codegen error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            c_fragments.push(module.assembly)

        val all_c_source = aot_join_text_fragments(c_fragments)
        if not rt_file_write_text(output, all_c_source):
            return CompileResult.CodegenError("Failed to write C++ source to {output}")
        output_log_info(log, "C++20 source written to {output}")
        CompileResult.Success(output)

    me compile_to_c_directory(output_dir: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT C (multi-file): generating C++20 to {output_dir}/")

        if not rt_dir_create(output_dir, true):
            return CompileResult.CodegenError(
                "Failed to create output directory {output_dir}")

        var module_files: [(text, text)] = []
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module: {name}")
            val compiled = compile_module_with_backend(
                "c", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "C codegen error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            val rel_path = name.replace(".", "/") + ".cpp"
            val full_path = rt_path_join(output_dir, rel_path)
            val parent_dir = _driver_entry_import_dirname(full_path)
            if not rt_dir_create(parent_dir, true):
                return CompileResult.CodegenError(
                    "Failed to create directory {parent_dir}")
            if not rt_file_write_text(full_path, module.assembly):
                return CompileResult.CodegenError("Failed to write {full_path}")

            if module.has_llvm_ir and module.llvm_ir != "":
                val h_rel_path = name.replace(".", "/") + ".h"
                val h_full_path = rt_path_join(output_dir, h_rel_path)
                if not rt_file_write_text(h_full_path, module.llvm_ir):
                    return CompileResult.CodegenError("Failed to write {h_full_path}")
                output_log_trace(log, "wrote {h_rel_path}")

            module_files.push((name, rel_path))
            output_log_trace(log, "wrote {rel_path}")

        val cmake_err = generate_cmake_for_modules(output_dir, module_files, log)
        if cmake_err != nil:
            return CompileResult.CodegenError(cmake_err)
        output_log_info(
            log,
            "C++20 multi-file output written to {output_dir}/ ({module_files.len()} modules)")
        CompileResult.Success(output_dir)

    me compile_to_cuda(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT CUDA: generating PTX to {output}")

        var ptx_fragments: [text] = []
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module to PTX: {name}")
            val compiled = compile_module_with_backend(
                "cuda", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "CUDA compile error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            ptx_fragments.push(module.assembly ?? "")

        val all_ptx = aot_join_text_fragments(ptx_fragments)
        if not rt_file_write_text(output, all_ptx):
            return CompileResult.CodegenError("Failed to write PTX to {output}")
        output_log_info(log, "PTX assembly written to {output}")
        CompileResult.Success(output)

    me compile_to_opencl(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT OpenCL: generating OpenCL C to {output}")

        var source_fragments: [text] = []
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module to OpenCL C: {name}")
            val compiled = compile_module_with_backend(
                "opencl", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "OpenCL compile error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            source_fragments.push(module.assembly ?? "")

        val all_source = aot_join_text_fragments(source_fragments)
        if not rt_file_write_text(output, all_source):
            return CompileResult.CodegenError(
                "Failed to write OpenCL source to {output}")
        output_log_info(log, "OpenCL C source written to {output}")
        CompileResult.Success(output)

    me compile_to_vulkan(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT Vulkan: generating SPIR-V assembly to {output}")

        var all_spirv = ""
        var entry_modules = 0
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module to Vulkan SPIR-V: {name}")
            val compiled = compile_module_with_backend(
                "vulkan", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "Vulkan compile error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            val assembly = module.assembly ?? ""
            if assembly.contains("OpEntryPoint GLCompute"):
                if entry_modules > 0:
                    return CompileResult.CodegenError(
                        "Vulkan output requires exactly one compute module")
                entry_modules = entry_modules + 1
                all_spirv = assembly

        if entry_modules == 0 or all_spirv == "":
            return CompileResult.CodegenError(
                "Vulkan backend produced no compute entry point")
        if not rt_file_write_text(output, all_spirv):
            return CompileResult.CodegenError(
                "Failed to write Vulkan SPIR-V assembly to {output}")
        output_log_info(log, "Vulkan SPIR-V assembly written to {output}")
        CompileResult.Success(output)

    me compile_to_wasm(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val is_release = ctx.options.release
        val opt_level = output_mir_opt_level(ctx)
        output_log_debug(log, "AOT WASM: generating WAT to {output}")

        var wat_fragments: [text] = []
        for name in ctx.mir_modules.keys():
            output_log_trace(log, "translating module to WAT: {name}")
            val compiled = compile_module_with_backend(
                "wasm", ctx.mir_modules[name], is_release, opt_level)
            if compiled.is_err():
                return CompileResult.CodegenError(
                    "WASM compile error in {name}: {compiled.unwrap_err()}")
            val module: CompiledModule = compiled.unwrap()
            wat_fragments.push(module.assembly ?? "")

        val all_wat = aot_join_wat_fragments(wat_fragments)
        if not rt_file_write_text(output, all_wat):
            return CompileResult.CodegenError("Failed to write WAT to {output}")
        output_log_info(log, "WAT written to {output}")
        CompileResult.Success(output)
