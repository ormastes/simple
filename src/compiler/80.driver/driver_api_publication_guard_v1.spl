# Publication guard for the named rule `extreme_public_api`. Evaluated once
# at phase-5 mode dispatch before interpret/JIT/AOT, on the retained facts of
# this compile. Own rule code and own diagnostics: it never rides the
# typecheck pass's warning list, so no unrelated robust warning is escalated.
use compiler.common.api_publication_decision_v1.{ApiPublicationDispositionV1,
    ApiPublicationDecisionV1, decide_api_publication_v1}
use compiler.common.api_publication_activation_v1.{extreme_public_api_active_v1,
    extreme_public_api_warn_only_v1, extreme_public_api_verbose_v1}
use compiler.driver.driver_types.{CompileContext}

# Warn-only (temporary default) diagnostics collapse to one warning per
# exporter module unless SIMPLE_EXTREME_PUBLIC_API_VERBOSE=1. Messages start
# with "[rule] <module>: ".
fn warn_only_summaries(messages: [text]) -> [text]:
    var order: [text] = []
    var counts: Dict<text, i64> = {}
    for message in messages:
        val module = message.split(": ")[0]
        if not counts.has(module): order.push(module)
        counts[module] = (counts[module] ?? 0) + 1
    var out: [text] = []
    for module in order:
        out.push("{module}: {counts[module] ?? 0} public API diagnostic(s) (warn-only, temporary until E3 stdlib migration; set SIMPLE_EXTREME_PUBLIC_API_VERBOSE=1 for details)")
    out

pub fn guard_api_publication_v1(ctx: CompileContext) -> ApiPublicationDecisionV1:
    val warn_only = extreme_public_api_warn_only_v1()
    val decision = decide_api_publication_v1(extreme_public_api_active_v1(),
        ctx.assurance_policy.strictness.name(), ctx.api_exposure, ctx.api_export_route_facts,
        ctx.api_export_closure_facts, warn_only)
    match decision.disposition:
        case ApiPublicationDispositionV1.Deny:
            for message in decision.diagnostics: ctx.add_error(message)
        case ApiPublicationDispositionV1.Warn:
            if warn_only and not extreme_public_api_verbose_v1():
                for message in warn_only_summaries(decision.diagnostics): ctx.add_warning(message)
            else:
                for message in decision.diagnostics: ctx.add_warning(message)
        case ApiPublicationDispositionV1.Advisory: ()
    ctx.api_publication_decision = Some(decision)
    decision
