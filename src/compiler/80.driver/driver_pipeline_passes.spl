# CompilerDriver borrow, async, and MIR optimization methods.

use compiler.borrow.borrow_check.*
use compiler.mir_opt.mod.{OptLevel, optimize_module_for_backend}
use compiler.mir_opt.optimizer_plugin.{
    optimizer_plugin_builtin_registry, optimizer_plugin_registry_names,
    optimizer_plugin_registry_select_kernel, optimizer_plugin_registry_run_selected_on_module
}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_log_helpers.{log_debug, log_warn}
use compiler.driver.driver_build.go_to_end.{go_to_end_enabled_v1}
use compiler.driver.driver_source_loading.{_format_nll_error}
use std.io_runtime.{env_get_opt}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

impl CompilerDriver:
    me borrow_check() -> bool:
        if self.ctx.options.no_borrow_check:
            log_warn("borrow check skipped (--no-borrow-check)")
            return true
        log_debug("running borrow check")
        if go_to_end_enabled_v1():
            # go-to-end: a module failing borrow check is recorded and evicted so
            # every other module still emits objects (mirrors the HIR/MIR stages).
            # Link is already skipped under go-to-end, so dependents need no
            # separate exclusion: they just lack a sibling object in a build that
            # never links.
            var failed_names: [text] = []
            for name in self.ctx.mir_modules.keys():
                val errors = self.borrow_check_module_scoped_v1(name)
                if errors.len() > 0:
                    for err in errors:
                        self.go_to_end.record("borrow", name, _format_nll_error(err))
                    self.go_to_end.exclude(name)
                    failed_names = failed_names.push(name)
            for failed_name in failed_names:
                self.ctx.evict_mir_module(failed_name)
            if failed_names.len() > 0:
                print "[go-to-end] borrow: {failed_names.len()} module(s) failed; continuing with {self.ctx.mir_modules.len()}"
            return not self.ctx.has_errors()
        for name in self.ctx.mir_modules.keys():
            val errors = self.borrow_check_module_scoped_v1(name)
            for err in errors:
                self.ctx.add_error(_format_nll_error(err))
        not self.ctx.has_errors()

    # Bug borrow_check_unscoped_rss_growth_2026_10_24: borrow check was the
    # only per-module MIR-phase pass with no transient scope, so every
    # checker/CFG/liveness allocation (~21-24 MB per module) stayed live for
    # the rest of the process. Run each module in its own scratch scope, as
    # MIR lowering does (_MirLowering/module_lowering.spl), and promote only
    # the error list. The check reads the already-promoted MIR and writes no
    # shared state, so the verdict is unchanged; if the scope is refused or
    # promotion fails the module is re-checked unscoped (same verdict, old RSS).
    fn borrow_check_module_scoped_v1(name: text) -> [NLLError]:
        if transient_array_scope_state_v1() != 0 or not transient_scope_begin():
            eprint("[borrow-scope] WARNING transient scope refused; checking UNSCOPED, arena retained: module={name}")
            return check_mir_module(self.ctx.mir_modules[name])
        val scoped_errors = check_mir_module(self.ctx.mir_modules[name])
        val paused = transient_scope_pause()
        val owned = paused and transient_promote(scoped_errors)
        val ended = transient_scope_end()
        if paused and owned and ended:
            return scoped_errors
        eprint("[borrow-scope] WARNING error-list promotion failed (paused={paused} owned={owned} ended={ended}); re-checking UNSCOPED: module={name}")
        check_mir_module(self.ctx.mir_modules[name])

    fn format_borrow_error(err: NLLError) -> text:
        _format_nll_error(err)

    me process_async() -> i64:
        # Async MIR lowering is owned by the MIR pipeline. The former tools
        # pass only built an unconsumed side table, so do not load a plugin
        # implementation into the kernel closure for dead work.
        0

    me optimize_mir_level(level: i64):
        if level <= 0:
            return

        log_debug("optimizing MIR modules")
        val backend_name = self.ctx.options.backend
        # ponytail: stage4 whole-MirModule returns erase late MirFunction
        # metadata; remove this bypass when that ABI copy bug is fixed.
        if backend_name == "vhdl":
            return

        val selected_level = if level == 1: OptLevel.Size elif level == 2: OptLevel.Speed else: OptLevel.Aggressive
        val requested_kernel = env_get_opt("SIMPLE_OPTIMIZER_KERNEL") ?? ""
        if requested_kernel == "":
            for name in self.ctx.mir_modules.keys():
                val optimized = optimize_module_for_backend(
                    self.ctx.mir_modules[name], selected_level, backend_name)
                self.ctx.mir_modules[name] = optimized
            return

        # A selected optimizer kernel replaces the built-in optimization
        # pipeline. Selection and its identity hashes are session work, not
        # per-module work; only execution remains inside the module loop.
        val registry = optimizer_plugin_builtin_registry(selected_level)
        val names = optimizer_plugin_registry_names(registry)
        val legacy_name = env_get_opt("SIMPLE_OPTIMIZER_LEGACY_KERNEL") ?? (if names.len() > 0: names[0] else: "")
        val allow_legacy = (env_get_opt("SIMPLE_OPTIMIZER_ALLOW_LEGACY") ?? "") == "1"
        match optimizer_plugin_registry_select_kernel(registry, requested_kernel, allow_legacy, legacy_name):
            Ok(selection):
                for name in self.ctx.mir_modules.keys():
                    val mir_module = self.ctx.mir_modules[name]
                    match optimizer_plugin_registry_run_selected_on_module(registry, selection, mir_module):
                        Ok(selected_module): self.ctx.mir_modules[name] = selected_module
                        Err(message): self.ctx.add_error(message)
            Err(message): self.ctx.add_error(message)
use compiler.common.diagnostics.span.{Span}
