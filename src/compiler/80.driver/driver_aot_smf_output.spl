extern fn rt_hash_text(s: text) -> i64

fn smf_log_debug(log: Logger, message: text):
    if log.level >= 10:
        print "[DEBUG] {message}"

fn smf_log_trace(log: Logger, message: text):
    if log.level >= 20:
        print "[TRACE] {message}"

fn smf_log_info(log: Logger, message: text):
    if log.level >= 4:
        print "[INFO] {message}"

fn smf_render_launch_metadata() -> text:
    val target = Target.host()
    "simple_launch_metadata:\n" +
        "  entry_kind: \"smf\"\n" +
        "  target_os: \"" + target.os + "\"\n" +
        "  target_arch: \"" + target.arch + "\"\n" +
        "  target_abi: \"smf\"\n" +
        "  uses_arg_parser: true\n" +
        "  mmap_hint: true\n"

fn smf_publish_demand_scc_outputs_v1(ctx: CompileContext, path: text) -> bool:
    if ctx.demand_scc_publication == nil:
        return true
    if (ctx.demand_compile_execution == nil or
            ctx.demand_mir_admission == nil or
            ctx.demand_dirty_modules.len() == 0):
        return false
    var ownership = ctx.demand_scc_publication!
    var execution = ctx.demand_compile_execution!
    for index in 0..ownership.modules.len():
        if not scc_publication_complete_smf_v1(
                &mut ownership,
                ownership.modules[index].entry.module_identity, path):
            ctx.demand_scc_publication = Some(ownership)
            ctx.demand_compile_execution = Some(execution)
            return false
    val dirty = ctx.demand_dirty_modules[0]
    val authority = PackageArchiveAuthorityV1(
        dirty.producer_compatibility_id, dirty.package_index_generation,
        dirty.configuration_variant, dirty.scv_revision,
        dirty.scv_tree_digest, dirty.scv_inventory_digest)
    var scc_identities: [text] = []
    for output in ownership.modules:
        if not scc_identities.contains(output.entry.scc_identity):
            scc_identities = scc_identities.push(output.entry.scc_identity)
    for scc_identity in scc_identities.sorted():
        var scheduled: [text] = []
        var modules: [SccModuleCompileOutputV1] = []
        for output in ownership.modules:
            if output.entry.scc_identity == scc_identity:
                scheduled = scheduled.push(output.entry.module_identity)
                modules = modules.push(output)
        if modules.len() == 0:
            ctx.demand_scc_publication = Some(ownership)
            ctx.demand_compile_execution = Some(execution)
            return false
        val completion = demand_compile_complete_scc_outputs_v1(
                execution, machine_cache_root(), authority,
                ctx.demand_mir_admission!,
                SccCompileOutputsV1(
                    scc_identity, scheduled.sorted(), modules),
                modules[0].baseline_artifact_identity,
                modules[0].baseline_artifact_digest)
        execution = completion.execution
        if not completion.accepted:
            ctx.demand_scc_publication = Some(ownership)
            ctx.demand_compile_execution = Some(execution)
            return false
    ctx.demand_scc_publication = Some(ownership)
    ctx.demand_compile_execution = Some(execution)
    true

impl CompilerDriver:
    me compile_to_smf(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val backend_name = ctx.options.backend
        val effective_backend = get_effective_backend_name(
            backend_name, ctx.options.release)
        smf_log_debug(
            log,
            "AOT SMF: compiling to {output} (backend: {effective_backend})")
        log_build_progress("smf_package", "modules", 0, ctx.mir_modules.len(), output, 0, 1, 0, 0, "running")

        val smf_result = self.collect_smf_bytes()
        if not smf_result.is_success():
            log_build_progress("smf_package", "modules", 0, ctx.mir_modules.len(), output, 1, 1, 1, 0, "failure")
            return smf_result
        val smf_bytes = smf_result.get_value()

        match link_to_smf(smf_bytes, output, ctx.options.verbose):
            case Ok(_):
                if not smf_publish_demand_scc_outputs_v1(ctx, output):
                    return CompileResult.CodegenError(
                        "demand-driven SCC SMF publication failed closed")
                log_build_progress("smf_package", "modules", ctx.mir_modules.len(), ctx.mir_modules.len(), output, 1, 1, 0, 0, "complete")
                smf_log_info(
                    log,
                    "SMF module written to {output} (backend: {effective_backend})")
                CompileResult.Success(output)
            case Err(e):
                log_build_progress("smf_package", "modules", 0, ctx.mir_modules.len(), output, 1, 1, 1, 0, "failure")
                CompileResult.CodegenError("Failed to write SMF file: {e}")

    me compile_to_self_contained(output: text) -> CompileResult:
        val ctx = self.ctx
        val log = ctx.logger
        val backend_name = ctx.options.backend
        val effective_backend = get_effective_backend_name(
            backend_name, ctx.options.release)
        smf_log_debug(
            log,
            "AOT self-contained: compiling to {output} (backend: {effective_backend})")

        val smf_result = self.collect_smf_bytes()
        if not smf_result.is_success():
            return smf_result
        val smf_bytes = smf_result.get_value()

        var config = SelfContainedConfig.default()
        config.verbose = ctx.options.verbose
        match link_to_self_contained(smf_bytes, output, config):
            case Ok(_):
                smf_log_info(
                    log,
                    "Self-contained binary written to {output} (backend: {effective_backend})")
                CompileResult.Success(output)
            case Err(e):
                CompileResult.CodegenError("Self-contained build failed: {e}")

    me collect_smf_bytes() -> CompileResult:
        val ctx: CompileContext = self.ctx
        val log = ctx.logger
        val backend_name = ctx.options.backend
        val opt_level = compileoptions_effective_mir_opt_level(ctx.options)
        var all_object_bytes: [u8] = []

        for name in ctx.mir_modules.keys():
            smf_log_trace(log, "compiling module for SMF: {name}")
            val compiled = compile_module_with_backend(
                backend_name,
                ctx.mir_modules[name],
                ctx.options.release,
                opt_level
            )
            match compiled:
                case Err(err):
                    return CompileResult.CodegenError(
                        "AOT compile error in {name}: {err.to_text()}")
                case Ok(module):
                    if val obj_bytes = module.object_code:
                        all_object_bytes = all_object_bytes.concat(obj_bytes)
                case _:
                    return CompileResult.CodegenError(
                        "AOT compile error in {name}: backend result not Ok")

        val deps = smf_collect_dependency_hashes(ctx)
        val entry_source_hash = if ctx.source_content_hashes_owner.len() > 0:
            ctx.source_content_hashes_owner[0]
        else:
            0
        val manifest_bytes = smf_collect_driver_manifest_bytes(ctx.mir_modules)
        val launch_metadata_bytes = smf_render_launch_metadata().bytes()
        val target = Target.host()
        val mode = ctx.options.smf_output_mode
        val smf_bytes = if mode == "elf_embedded":
            var opts = SmfBuildOptions.create(target)
            opts.deps = deps
            opts.source_hash = entry_source_hash
            opts.driver_manifest_bytes = manifest_bytes
            opts.launch_metadata_bytes = launch_metadata_bytes
            generate_smf_with_raw_code_options(all_object_bytes, opts)
        elif mode == "reloc_sections":
            var opts = SmfBuildOptions.create(target)
            opts.deps = deps
            opts.source_hash = entry_source_hash
            opts.driver_manifest_bytes = manifest_bytes
            opts.launch_metadata_bytes = launch_metadata_bytes
            build_smf_with_relocations(all_object_bytes, opts)
        else:
            var opts = SmfBuildOptions.create(target)
            opts.deps = deps
            opts.source_hash = entry_source_hash
            opts.driver_manifest_bytes = manifest_bytes
            opts.launch_metadata_bytes = launch_metadata_bytes
            generate_smf_with_options(all_object_bytes, opts)
        CompileResult.Success(smf_bytes)

fn smf_collect_driver_manifest_bytes(modules: Dict<text, MirModule>) -> [u8]:
    var payload: [u8] = []
    for module_name in modules.keys():
        val module = modules[module_name]
        for fn_ in module.functions.values():
            if fn_.has_driver_manifest_attr:
                payload = payload.concat(
                    smf_encode_driver_manifest_record(
                        fn_.name, fn_.driver_manifest_attr))
    payload

fn smf_encode_driver_manifest_record(
    name: text,
    attr: DriverManifestAttr
) -> [u8]:
    var buf: [u8] = []
    buf = buf.concat(smf_u32_to_bytes(0x44525653))
    var kind_byte: u8 = 0
    match attr.kind:
        case Driver:
            kind_byte = 0
        case NativeLib:
            kind_byte = 1
    buf = buf.push(kind_byte)
    buf = buf.push((attr.driver_class & 0xFF).to_u8())
    buf = buf.push(1)
    buf = buf.push(0)
    buf = buf.concat(smf_u32_to_bytes(attr.vendor as i32))
    buf = buf.concat(smf_u32_to_bytes(attr.device_ids.len() as i32))
    buf = buf.concat(smf_fixed_ascii_bytes(attr.version, 16))
    buf = buf.concat(smf_fixed_ascii_bytes(name, 32))
    for id in attr.device_ids:
        buf = buf.concat(smf_u32_to_bytes(0))
        buf = buf.concat(smf_u32_to_bytes(id as i32))
    buf

fn smf_fixed_ascii_bytes(value: text, width: i64) -> [u8]:
    var out: [u8] = []
    val raw = value.bytes()
    var i = 0
    while i < width:
        if i < raw.len():
            out = out.push(raw[i])
        else:
            out = out.push(0)
        i = i + 1
    out

fn smf_collect_dependency_hashes(ctx: CompileContext) -> [SmfDependencyEntry]:
    var deps: [SmfDependencyEntry] = []
    var seen: Dict<text, bool> = {}
    # An SMF is a linked whole-program artifact: implementation/body changes
    # in any source can change its behavior even when the public interface is
    # stable. Record every loaded physical source by content, rather than only
    # entry inputs by SHB interface hash.
    var source_index = 0
    while source_index < ctx.source_paths_owner.len():
        # Bind the receipt to the exact physical file whose loaded bytes were
        # hashed. Coverage wrappers may advertise an authored path while
        # carrying transformed content; switching to that path would pair one
        # file's identity with another file's bytes. A removed temp wrapper is
        # deliberately stale.
        val physical_path = _driver_physical_source_key(
            ctx.source_paths_owner[source_index])
        if physical_path != "" and not seen.has(physical_path):
            seen[physical_path] = true
            deps.push(
                SmfDependencyEntry(
                    module_path: physical_path,
                    content_hash: ctx.source_content_hashes_owner[source_index]))
        source_index = source_index + 1
    deps
use compiler.common.diagnostics.span.{Span}
