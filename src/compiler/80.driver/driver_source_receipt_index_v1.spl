# Scalar source-receipt lookup. The retained HIR loop owns the returned map;
# no source or surface aggregate crosses a per-module value boundary.

pub fn driver_source_receipt_pair_key_v1(path: text, module_name: text) -> text:
    # Frame the path so distinct (path,module) pairs cannot concatenate alike.
    "{path.len()}:{path}{module_name}"

pub fn driver_source_receipt_index_v1(paths: [text], module_names: [text],
        content_hashes: [i64], byte_length_count: i64) -> Dict<text, i64>:
    val count = paths.len()
    var indices: Dict<text, i64> = {}
    if module_names.len() != count or content_hashes.len() != count or byte_length_count != count:
        return indices
    var position: i64 = 0
    while position < count:
        val key = driver_source_receipt_pair_key_v1(paths[position], module_names[position])
        # Duplicate exact witnesses and zero hashes are not authority. Keep
        # the invalid sentinel for every later duplicate, including a third.
        if indices.has(key) or content_hashes[position] == 0:
            indices[key] = -1
        else:
            indices[key] = position
        position = position + 1
    indices
