use compiler.driver.driver.{compiler_driver_create, compiler_driver_run_compile, compiler_driver_run_compile_routed}
use compiler.driver.bootstrap_api_low_memory.{bootstrap_low_memory_requested}
use compiler.common.driver_core_modes.{CompileMode, driver_output_format_native}
use compiler.common.driver_compile_options.{driver_core_compile_options_default, compileoptions_normalize_mir_optimization}
use compiler.common.driver_compile_result.{CompileResult}
use compiler.driver.driver_phase_gates.{driver_streaming_mcdc_raw_is_off}
use std.nogc_sync_mut.io.env_ops.{env_get}

pub fn aot_native_project_with_backend_fixed(
    source_0: text,
    source_1: text,
    source_2: text,
    source_3: text,
    source_4: text,
    source_count: i64,
    entry: text,
    output: text,
    backend: text,
    strip: bool,
    release: bool,
    opt_level: i64,
    no_borrow_check: bool
) -> CompileResult:
    var options = driver_core_compile_options_default()
    if source_count <= 0:
        options.input_files = [entry]
    elif source_count == 1:
        options.input_files = [source_0, entry]
    elif source_count == 2:
        options.input_files = [source_0, source_1, entry]
    elif source_count == 3:
        options.input_files = [source_0, source_1, source_2, entry]
    elif source_count == 4:
        options.input_files = [source_0, source_1, source_2, source_3, entry]
    else:
        options.input_files = [source_0, source_1, source_2, source_3, source_4, entry]
    options.bootstrap_input_count = source_count + 1
    if source_count > 0:
        options.bootstrap_input_0 = source_0
    if source_count > 1:
        options.bootstrap_input_1 = source_1
    if source_count > 2:
        options.bootstrap_input_2 = source_2
    if source_count > 3:
        options.bootstrap_input_3 = source_3
    if source_count > 4:
        options.bootstrap_input_4 = source_4
    if source_count == 0:
        options.bootstrap_input_0 = entry
    elif source_count == 1:
        options.bootstrap_input_1 = entry
    elif source_count == 2:
        options.bootstrap_input_2 = entry
    elif source_count == 3:
        options.bootstrap_input_3 = entry
    elif source_count == 4:
        options.bootstrap_input_4 = entry
    else:
        options.bootstrap_input_5 = entry
    options.mode = CompileMode.Aot
    options.output_file = Some(output)
    options.output_format = driver_output_format_native()
    options.backend = backend
    options.release = release
    options.opt_level = opt_level
    options.no_borrow_check = no_borrow_check
    # Reclaim only for the explicit Stage4 low-memory profile. Ordinary focused
    # builds and the no-opt-in negative control retain their source buffers.
    options.low_memory = bootstrap_low_memory_requested()
    options = compileoptions_normalize_mir_optimization(options)
    var streaming_eligibility_mask: i64 = 1
    if backend != "vhdl":
        streaming_eligibility_mask = streaming_eligibility_mask + 2
    if (env_get("SIMPLE_COVERAGE") ?? "") != "1":
        streaming_eligibility_mask = streaming_eligibility_mask + 4
    if driver_streaming_mcdc_raw_is_off(env_get("SIMPLE_MCDC_MODE") ?? ""):
        streaming_eligibility_mask = streaming_eligibility_mask + 8
    val driver = compiler_driver_create(options)
    val stage4_streaming_requested = ((env_get("SIMPLE_BOOTSTRAP_STAGE4") ?? "") == "1" and
        (env_get("SIMPLE_STAGE4_STREAMING_SURFACES") ?? "") == "1")
    if stage4_streaming_requested:
        compiler_driver_run_compile_routed(driver, streaming_eligibility_mask)
    else:
        compiler_driver_run_compile(driver)
