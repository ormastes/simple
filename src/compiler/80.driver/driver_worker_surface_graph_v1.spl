# Pure dependency spelling and frozen-surface readiness shared by workers
# and their native graph regression. Filesystem resolution stays in the owner.
# Module ids a source names in `use` / `export use` / `pub use` lines: the
# path itself and, for a `{...}` group, each member as a possible submodule.
pub fn worker_surface_import_ids_v1(source: text) -> [text]:
    var out: [text] = []
    for line in source.replace("\r\n", "\n").split("\n"):
        var t = line.trim()
        val comment_at = t.index_of("#")
        if comment_at >= 0: t = t.substring(0, comment_at).trim()
        var rest = ""
        if t.starts_with("use "): rest = t.substring(4)
        elif t.starts_with("export use "): rest = t.substring(11)
        elif t.starts_with("pub use "): rest = t.substring(8)
        elif t.starts_with("import "): rest = t.substring(7)
        elif t.starts_with("from "):
            val import_at = t.index_of(" import ")
            if import_at > 5: rest = t.substring(5, import_at)
        elif t.starts_with("export ") and t.contains(" from "):
            val from_at = t.last_index_of(" from ")
            rest = t.substring(from_at + 6).trim()
            # Match the phase-1/parser rule: a bare export source is a
            # package sibling, never an unrelated root module of that name.
            if rest != "" and not rest.contains("."):
                rest = "." + rest
        elif t.starts_with("export "):
            # Frozen export routes resolve qualified members/globs against
            # the facade package first, then absolute registry names.
            # Keep both candidates: filesystem closure is conservative;
            # the frozen resolver remains authoritative for readiness.
            for item in t.substring(7).split(","):
                var qualified = item.trim()
                val alias_at = qualified.index_of(" as ")
                if alias_at > 0: qualified = qualified.substring(0, alias_at).trim()
                val separator = qualified.last_index_of(".")
                if separator > 0:
                    val qualifier = qualified.substring(0, separator)
                    val sibling = if qualifier.starts_with("."): qualifier else: "." + qualifier
                    if not out.contains(sibling): out.push(sibling)
                    if not out.contains(qualifier): out.push(qualifier)
        if rest == "":
            continue
        rest = rest.trim()
        val as_at = rest.index_of(" as ")
        if as_at > 0: rest = rest.substring(0, as_at)
        val brace = rest.index_of(".{")
        var base = if brace > 0: rest.substring(0, brace) else: rest
        if base.ends_with(".*"): base = base.substring(0, base.byte_len() - 2)
        if base != "" and not out.contains(base): out.push(base)
        if brace > 0:
            val close = rest.index_of("}")
            val inner = if close > brace: rest.substring(brace + 2, close) else: rest.substring(brace + 2)
            for item in inner.split(","):
                var name = item.trim()
                val item_as = name.index_of(" as ")
                if item_as > 0: name = name.substring(0, item_as).trim()
                if name != "" and name != "*":
                    val sub = base + "." + name
                    if not out.contains(sub): out.push(sub)
    out

# ready[i]: built[i] and every edge target (>= 0) of i is ready, transitively.
# edges are the frozen surface's import_target_indices + export route targets.
pub fn worker_surface_ready_v1(built: [bool], edges: [[i64]]) -> [bool]:
    var ready: [bool] = []
    for b in built:
        ready.push(b)
    var changed = true
    while changed:
        changed = false
        var i = 0
        while i < ready.len():
            if ready[i] and i < edges.len():
                for t in edges[i]:
                    if t >= 0 and (t >= ready.len() or not ready[t]):
                        ready[i] = false
                        changed = true
                        break
            i = i + 1
    ready

# Failure-only attribution over the same frozen import/export edges used by
# readiness. Negative edge indices are absent routes, as in readiness above.
# Bound examined edges and queue size; cycles cannot cause recursive overflow.
# reason: indices preserve the frozen graph's signed absent-route sentinel;
# inspected_edges is the bounded traversal counter recorded in failure receipts.
@allow(primitive_api)
pub struct WorkerSurfaceGapV1:
    reason: text
    source_index: i64
    target_index: i64
    inspected_edges: i64

# reason: root/edges use the existing frozen graph's i64 indices and -1 sentinel;
# edge_limit bounds inspected graph entries without changing that owner contract.
@allow(primitive_api)
pub fn worker_surface_gap_v1(root: i64, built: [bool], edges: [[i64]], edge_limit: i64 = 65536) -> WorkerSurfaceGapV1:
    if root < 0 or root >= built.len():
        return WorkerSurfaceGapV1("invalid-root", root, root, 0)
    if not built[root]:
        return WorkerSurfaceGapV1("unbuilt-root", root, root, 0)
    var visited: [bool] = []
    var vi = 0
    while vi < built.len():
        visited.push(false)
        vi = vi + 1
    visited[root] = true
    var queue: [i64] = [root]
    var cursor = 0
    var inspected = 0
    while cursor < queue.len():
        val current = queue[cursor]
        cursor = cursor + 1
        if current < edges.len():
            for target in edges[current]:
                if inspected >= edge_limit:
                    return WorkerSurfaceGapV1("search-limit", current, -1, inspected)
                inspected = inspected + 1
                if target < 0:
                    continue
                if target >= built.len():
                    return WorkerSurfaceGapV1("invalid-edge", current, target, inspected)
                if not built[target]:
                    return WorkerSurfaceGapV1("unbuilt-dependency", current, target, inspected)
                if not visited[target]:
                    visited[target] = true
                    queue.push(target)
    WorkerSurfaceGapV1("no-missing-surface", root, -1, inspected)

fn worker_surface_gap_path_v1(path: text) -> text:
    if path.byte_len() <= 512: return path
    var end = 512
    # substring uses byte offsets. Exclude the entire scalar when the limit
    # lands inside its UTF-8 continuation bytes, preserving valid path text.
    while end > 0:
        val byte = path.byte_at(end) as i64
        if byte < 128 or byte >= 192: break
        end = end - 1
    path.substring(0, end) + "...[truncated]"

pub fn worker_surface_gap_message_v1(gap: WorkerSurfaceGapV1, blocking_path: text, source_path: text, target_path: text) -> text:
    val root_path = worker_surface_gap_path_v1(blocking_path)
    val from_path = worker_surface_gap_path_v1(source_path)
    val to_path = worker_surface_gap_path_v1(target_path)
    "blocking_target={root_path} reachable-gap={gap.reason} source_index={gap.source_index} target_index={gap.target_index} inspected_edges={gap.inspected_edges} source={from_path} target={to_path}"

