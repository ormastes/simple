# SMF ELF Parser
#
# ELF object file parsing for SMF generation:
# - Extract .text section from ELF64 objects
# - Extract .rela.text relocations
# - Map ELF relocation types to SMF wire values

use compiler.driver.smf_binary_helpers.{_read_u16_le, _read_u32_le, _read_u64_le}

# Relocation entry extracted from ELF .rela.text section
struct ElfRelocEntry:
    offset: i64
    sym_idx: i64
    reloc_type: i64
    addend: i64

# Symbol entry extracted from ELF .symtab section
struct ElfSymEntry:
    name: text
    value: i64
    size: i64
    info: i64
    section_idx: i64

# Indices of every code section extract_code_from_object() concatenates into
# the merged Code blob: each SHT_PROGBITS section whose name starts with
# ".text", in section-index order, but ONLY when the section's [offset, offset
# + size) range actually fits inside object_code -- a truncated object file
# (or a truncated section header table entry) is skipped rather than
# accepted, exactly like extract_code_from_object()'s own bounds check.
# extract_code_from_object() and extract_elf_relocations() both call this
# single helper, so the set of sections they agree on can never diverge even
# on truncated/malformed input.
fn _find_text_section_indices(object_code: [u8], e_shoff: i64, e_shentsize: i64, e_shnum: i64, strtab_offset: i64) -> [i64]:
    var indices: [i64] = []
    var i = 0
    while i < e_shnum:
        val sh_off = e_shoff + (i * e_shentsize)
        if sh_off + 64 <= object_code.len():
            val sh_type = _read_u32_le(object_code, sh_off + 4)
            if sh_type == 1:
                val sh_name_idx = _read_u32_le(object_code, sh_off)
                val name_off = strtab_offset + sh_name_idx
                if name_off + 5 <= object_code.len():
                    # ".text" = 2E 74 65 78 74
                    val is_text = (object_code[name_off] == 0x2E and
                        object_code[name_off + 1] == 0x74 and
                        object_code[name_off + 2] == 0x65 and
                        object_code[name_off + 3] == 0x78 and
                        object_code[name_off + 4] == 0x74)
                    if is_text:
                        val sec_offset = _read_u64_le(object_code, sh_off + 24)
                        val sec_size = _read_u64_le(object_code, sh_off + 32)
                        val end_off = sec_offset + sec_size
                        if end_off <= object_code.len():
                            indices.push(i)
        i = i + 1
    indices

# Index of the FIRST code section extract_code_from_object() would place at
# offset 0 of the merged Code blob. Returns -1 when the object has none.
# Truncated-section bounds are checked via _find_text_section_indices(), so
# this agrees with extract_code_from_object() on truncated input by
# construction -- it can never pick a section extract_code_from_object()
# itself rejected as out-of-bounds.
fn _find_text_section_index(object_code: [u8], e_shoff: i64, e_shentsize: i64, e_shnum: i64, strtab_offset: i64) -> i64:
    val indices = _find_text_section_indices(object_code, e_shoff, e_shentsize, e_shnum, strtab_offset)
    if indices.len() > 0:
        return indices[0]
    -1

# Extract code section(s) from ELF object file.
# Parses the ELF64 header, finds every ".text"-prefixed SHT_PROGBITS section
# via the section header string table, and returns their bytes concatenated
# in section-index order. Falls back to returning raw bytes if not ELF.
#
# Under `-ffunction-sections` (the default for this backend's `llc` objects,
# see llvm_backend_tools.spl), a module with more than one function produces
# one ".text.<fn>" section PER function instead of a single ".text". Earlier
# this function kept only the first such section and silently dropped every
# other function's machine code from the compiled SMF module. It now
# concatenates ALL of them -- extract_elf_relocations() rebases each
# section's relocations by that same section's offset in this merged blob,
# so the two stay consistent (see _find_text_section_indices()).
fn extract_code_from_object(object_code: [u8]) -> [u8]:
    # Check ELF magic: 0x7f 'E' 'L' 'F'
    if object_code.len() < 64:
        return object_code  # Too small for ELF, treat as raw
    val magic_ok_0 = object_code[0] == 0x7F
    val magic_ok_1 = object_code[1] == 0x45  # 'E'
    val magic_ok_2 = object_code[2] == 0x4C  # 'L'
    val magic_ok_3 = object_code[3] == 0x46  # 'F'
    if not (magic_ok_0 and magic_ok_1 and magic_ok_2 and magic_ok_3):
        return object_code  # Not ELF, return as raw code bytes

    # Check 64-bit (class 2)
    val elf_class = object_code[4]
    if elf_class != 2:
        return object_code  # Not ELF64, return as raw

    # Parse ELF64 header fields (little-endian assumed)
    # e_shoff: offset 40, 8 bytes - section header table offset
    val e_shoff = _read_u64_le(object_code, 40)
    # e_shentsize: offset 58, 2 bytes - section header entry size
    val e_shentsize = _read_u16_le(object_code, 58)
    # e_shnum: offset 60, 2 bytes - number of section headers
    val e_shnum = _read_u16_le(object_code, 60)
    # e_shstrndx: offset 62, 2 bytes - section name string table index
    val e_shstrndx = _read_u16_le(object_code, 62)

    if e_shoff == 0 or e_shnum == 0 or e_shentsize < 64:
        return object_code  # No section headers

    # Read section name string table section header
    val shstrtab_off = e_shoff + (e_shstrndx * e_shentsize)
    if shstrtab_off + 64 > object_code.len():
        return object_code
    val strtab_offset = _read_u64_le(object_code, shstrtab_off + 24)
    val strtab_size = _read_u64_le(object_code, shstrtab_off + 32)

    # Find every ".text"-prefixed section (bounds-checked) and concatenate
    # their bytes, in section-index order, into one merged Code blob.
    val text_indices = _find_text_section_indices(object_code, e_shoff, e_shentsize, e_shnum, strtab_offset)
    if text_indices.len() == 0:
        # No .text section found, return raw bytes
        return object_code

    var code: [u8] = []
    for idx in text_indices:
        val sh_off = e_shoff + (idx * e_shentsize)
        val sec_offset = _read_u64_le(object_code, sh_off + 24)
        val sec_size = _read_u64_le(object_code, sh_off + 32)
        val end_off = sec_offset + sec_size
        var j = sec_offset
        while j < end_off:
            code.push(object_code[j])
            j = j + 1
    code

"""Extract .rela.text relocations from an ELF object file.

Parses ELF64 section headers to find .rela.text, then reads relocation entries.
Each ELF rela entry is 24 bytes: offset(8) + info(8) + addend(8).
"""
fn extract_elf_relocations(object_code: [u8]) -> [ElfRelocEntry]:
    if object_code.len() < 64:
        return []
    # Verify ELF magic
    val magic_ok = (object_code[0] == 0x7F and
        object_code[1] == 0x45 and
        object_code[2] == 0x4C and
        object_code[3] == 0x46)
    if not magic_ok:
        return []
    if object_code[4] != 2:
        return []

    val e_shoff = _read_u64_le(object_code, 40)
    val e_shentsize = _read_u16_le(object_code, 58)
    val e_shnum = _read_u16_le(object_code, 60)
    val e_shstrndx = _read_u16_le(object_code, 62)

    if e_shoff == 0 or e_shnum == 0 or e_shentsize < 64:
        return []

    # Get section name string table
    val shstrtab_off = e_shoff + (e_shstrndx * e_shentsize)
    if shstrtab_off + 64 > object_code.len():
        return []
    val strtab_offset = _read_u64_le(object_code, shstrtab_off + 24)

    # Relocation r_offset values are relative to the section the entries apply
    # to, so the entries must come from the SHT_RELA section attached to the
    # code section(s) extract_code_from_object() hands back -- otherwise the
    # offsets are applied to unrelated bytes. Selecting by NAME cannot do that:
    # a ".rela" prefix test also accepts ".rela.rodata" / ".rela.eh_frame", and
    # even an exact ".rela.text" test misses every OTHER function's relocations
    # under -ffunction-sections, where every function has its own
    # ".rela.text.<fn>". ELF records the link explicitly: a SHT_RELA section's
    # sh_info is the index of the section it relocates. Match on that.
    #
    # extract_code_from_object() concatenates ALL ".text"-prefixed sections
    # (in section-index order) into one merged Code blob, so relocations must
    # be collected from the SHT_RELA section attached to EACH of them, with
    # r_offset rebased by that section's start offset in the merged blob --
    # otherwise a relocation belonging to the second (or later) function would
    # be applied at the wrong byte offset in the merged Code blob.
    val text_indices = _find_text_section_indices(object_code, e_shoff, e_shentsize, e_shnum, strtab_offset)
    if text_indices.len() == 0:
        return []

    # Base offset of each collected .text section inside the merged Code
    # blob -- same running-sum order extract_code_from_object() concatenates
    # in, so the two agree on every relocation's rebased offset.
    var base_offsets: [i64] = []
    var running = 0
    for idx in text_indices:
        base_offsets.push(running)
        val sh_off = e_shoff + (idx * e_shentsize)
        val sec_size = _read_u64_le(object_code, sh_off + 32)
        running = running + sec_size

    var relocs: [ElfRelocEntry] = []
    var k = 0
    while k < text_indices.len():
        val text_idx = text_indices[k]
        val base = base_offsets[k]
        var i = 0
        while i < e_shnum:
            val sh_off = e_shoff + (i * e_shentsize)
            if sh_off + 64 <= object_code.len():
                val sh_type = _read_u32_le(object_code, sh_off + 4)
                val sh_info = _read_u32_le(object_code, sh_off + 44)
                if sh_type == 4 and sh_info == text_idx:
                    val sec_offset = _read_u64_le(object_code, sh_off + 24)
                    val sec_size = _read_u64_le(object_code, sh_off + 32)
                    val entry_size = 24
                    val count = sec_size / entry_size
                    var j = 0
                    while j < count:
                        val e_off = sec_offset + j * entry_size
                        if e_off + entry_size <= object_code.len():
                            val r_offset = _read_u64_le(object_code, e_off)
                            val r_info = _read_u64_le(object_code, e_off + 8)
                            val r_addend = _read_u64_le(object_code, e_off + 16)
                            val r_sym = (r_info >> 32) & 0xFFFFFFFF
                            val r_type = r_info & 0xFFFFFFFF
                            relocs.push(ElfRelocEntry(
                                offset: r_offset + base,
                                sym_idx: r_sym,
                                reloc_type: r_type,
                                addend: r_addend
                            ))
                        j = j + 1
            i = i + 1
        k = k + 1
    relocs

"""Map ELF x86_64 relocation types to SMF wire values."""
fn elf_reloc_type_to_smf(elf_type: i64) -> i32:
    # x86_64 ELF relocation types
    match elf_type:
        1: 1     # R_X86_64_64 -> Abs64
        2: 2     # R_X86_64_PC32 -> Rel32
        4: 3     # R_X86_64_PLT32 -> PltRel32
        9: 4     # R_X86_64_GOTPCREL -> GotRel32
        10: 5    # R_X86_64_32 -> Abs32
        11: 5    # R_X86_64_32S -> Abs32
        _: 1     # Default to Abs64
