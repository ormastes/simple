# Driver-owned handoff for prepared dynamic advice-slot metadata.
#
# Collection and validation are production-ready. Artifact/backend consumption
# is deliberately fail-closed until the canonical loader projection can be
# atomically installed/invalidated and dispatch pins its exact generation.

use compiler.mir.mir_data.{MirModule}
use compiler.mir.mir_instructions.{
    MirFunction, MirInstKind, MirOperand, MirOperandKind
}
use compiler.mir.mir_types.{
    LocalId, LocalKind, MirConstValue, MirType, MirTypeDef, MirTypeKind
}
use compiler.hir.hir_types.{SymbolId}
use compiler.common.structural_contracts.aop.{
    PreparedAdviceSlotPlan, prepared_advice_slot_plan_create
}
use compiler.mir.mir_serialization.{serialize_mir_prepared_advice_slots}
use compiler.common.driver_core_types.{CompileOptions}

fn collect_prepared_advice_slot_table_bytes(
    modules: Dict<text, MirModule>
) -> Result<[u8], text>:
    var plans: [PreparedAdviceSlotPlan] = []
    var slot_ids: [text] = []
    for module_name in modules.keys():
        for plan in modules[module_name].prepared_advice_slots:
            prepared_advice_slot_plan_create(
                plan.schema_id, plan.schema_version, plan.slot_id,
                plan.target_function_id, plan.admitted_forms)?
            if slot_ids.contains(plan.slot_id):
                return Err("E-AF010 duplicate prepared advice slot ID: {plan.slot_id}")
            slot_ids = slot_ids.push(plan.slot_id)
            plans = plans.push(plan)
    if plans.len() == 0:
        return Ok([])
    Ok(serialize_mir_prepared_advice_slots(plans).bytes())

fn prepared_advice_slot_artifact_gate(
    modules: Dict<text, MirModule>
) -> Result<(), text>:
    val table = collect_prepared_advice_slot_table_bytes(modules)?
    if table.len() > 0:
        return Err("E-AF010 prepared advice dispatch projection/trampoline is not lifecycle-safe")
    Ok(())

fn prepared_advice_context_type_matches(
    type_: MirType,
    module_types: Dict<SymbolId, MirTypeDef>
) -> bool:
    match type_.kind:
        case Struct(symbol):
            module_types.contains_key(symbol) and
                module_types[symbol].name == "AspectExecutionContext"
        case Ref(referent, _):
            prepared_advice_context_type_matches(referent, module_types)
        case _: false

fn prepared_advice_context_arg_local(
    func: MirFunction,
    module_types: Dict<SymbolId, MirTypeDef>,
    operand: MirOperand
) -> Result<(), text>:
    var expected_index: i64 = -1
    for index in 0..func.signature.params.len():
        if prepared_advice_context_type_matches(
            func.signature.params[index], module_types):
            if expected_index >= 0:
                return Err(
                    "E-AF010 prepared advice target must declare exactly one AspectExecutionContext parameter")
            expected_index = index
    if expected_index < 0:
        return Err(
            "E-AF010 prepared advice target must declare exactly one AspectExecutionContext parameter")

    match operand.kind:
        case Copy(local_id):
            for local in func.locals:
                if local.id.id == local_id.id:
                    match local.kind:
                        case LocalKind.Arg(index):
                            if index == expected_index and
                                prepared_advice_context_type_matches(
                                    local.type_, module_types):
                                return Ok(())
                        case _:
                            ()
            Err("E-AF010 prepared advice v2 context must copy the exact typed context Arg")
        case _:
            Err("E-AF010 prepared advice v2 context must copy the exact typed context Arg")

fn prepared_advice_const_text(operand: MirOperand, field: text) -> Result<text, text>:
    match operand.kind:
        case Const(Str(value), _): Ok(value)
        case _: Err("E-AF010 prepared advice v2 {field} must be constant text")

fn prepared_advice_slot_admits(
    module: MirModule,
    slot_id: text,
    phase: text
) -> bool:
    for plan in module.prepared_advice_slots:
        if plan.slot_id == slot_id and plan.admitted_forms.contains(phase):
            return true
    false

fn validate_prepared_advice_v2_inst(
    func: MirFunction,
    module: MirModule,
    destination: LocalId?,
    args: [MirOperand]
) -> Result<(), text>:
    if destination != nil:
        return Err("E-AF010 prepared advice v2 cannot produce a result")
    if args.len() != 3:
        return Err("E-AF010 prepared advice v2 requires context, slot, and phase")
    prepared_advice_context_arg_local(func, module.types, args[0])?
    val slot_id = prepared_advice_const_text(args[1], "slot")?
    val phase = prepared_advice_const_text(args[2], "phase")?
    if not prepared_advice_slot_admits(module, slot_id, phase):
        return Err("E-AF010 prepared advice v2 slot or phase is not admitted")
    Ok(())

fn validate_prepared_advice_v2_function(
    func: MirFunction,
    module: MirModule
) -> Result<bool, text>:
    var found = false
    for block in func.blocks:
        for inst in block.instructions:
            match inst.kind:
                case Intrinsic(destination, name, args):
                    if name == "simple.prepared_advice_dispatch.v2":
                        validate_prepared_advice_v2_inst(
                            func, module, destination, args)?
                        found = true
                case _:
                    ()
    Ok(found)

fn prepared_advice_surface_is_hosted_cpu_entry_closure(surface: text) -> bool:
    for backend in ["auto", "llvm", "llvm-lib", "cranelift", "native"]:
        if surface == "aot-entry-closure-host:{backend}":
            return true
    false

fn prepared_advice_driver_bridge(
    modules: Dict<text, MirModule>,
    surface: text
) -> Result<Dict<text, MirModule>, text>:
    val table = collect_prepared_advice_slot_table_bytes(modules)?
    if table.len() > 0 and not prepared_advice_surface_is_hosted_cpu_entry_closure(surface):
        return Err(
            "E-AF010 prepared dynamic advice is unsupported on {surface}; hosted CPU AOT entry-closure is required")
    var found_v2 = false
    for module_name in modules.keys():
        val module = modules[module_name]
        for symbol in module.functions.keys():
            if validate_prepared_advice_v2_function(
                module.functions[symbol], module)?:
                found_v2 = true
    if found_v2 or table.len() > 0:
        return Err(
            "E-AF010 prepared advice v2 is validated but cannot be rewritten safely: prepared_advice_dispatch_context_invoke Result propagation has no MIR owner")
    Ok(modules)

fn prepared_advice_residual_intrinsic(
    modules: Dict<text, MirModule>
) -> text?:
    for module in modules.values():
        for func in module.functions.values():
            for block in func.blocks:
                for inst in block.instructions:
                    match inst.kind:
                        case Intrinsic(_, name, _):
                            if name == "simple.prepared_advice_dispatch.v1" or
                                name == "simple.prepared_advice_dispatch.v2":
                                return Some(name)
                        case _:
                            ()
    nil

# One admission boundary shared by check/interpreter/JIT/AOT dispatch. Modes
# that cannot even materialize the prepared MIR reject the semantic option
# directly; MIR-capable paths reject any produced slot before backend codegen.
fn prepared_advice_execution_admission(
    options: CompileOptions,
    modules: Dict<text, MirModule>,
    surface: text
) -> Result<(), text>:
    if options.prepared_dynamic_advice and
        (surface == "check" or surface == "interpret" or surface == "smf_exec"):
        return Err(
            "E-AF010 prepared dynamic advice is unsupported on {surface}; no MIR dispatch may be ignored")
    val table = collect_prepared_advice_slot_table_bytes(modules)?
    if table.len() > 0 and not prepared_advice_surface_is_hosted_cpu_entry_closure(surface):
        return Err(
            "E-AF010 prepared dynamic advice is unsupported on {surface}; hosted CPU AOT entry-closure is required")
    if table.len() > 0:
        return Err(
            "E-AF010 prepared advice v2 ordinary-call Result propagation is not implemented")
    if val residual = prepared_advice_residual_intrinsic(modules):
        return Err(
            "E-AF010 prepared dynamic advice residual intrinsic is unsupported on {surface}: {residual}")
    Ok(())

export collect_prepared_advice_slot_table_bytes
export prepared_advice_slot_artifact_gate
export prepared_advice_execution_admission
export prepared_advice_driver_bridge
