# Immutable identity shared by compiler phase and memory evidence streams.

extern fn rt_env_get(key: text) -> text

var _driver_evidence_identity_captured: bool = false
var _driver_evidence_run_id: text = ""
var _driver_evidence_mode: text = ""

fn _driver_evidence_run_id_valid(run_id: text) -> bool:
    if run_id.len() < 8 or run_id.len() > 64:
        return false
    var index: i64 = 0
    while index < run_id.len():
        val ch = run_id.char_at(index)
        val safe = (ch >= "A" and ch <= "Z") or
            (ch >= "a" and ch <= "z") or
            (ch >= "0" and ch <= "9") or ch == "_" or ch == "-"
        if not safe:
            return false
        index = index + 1
    true

# Returns 0 when both durable sinks are disabled, 1 after one immutable capture,
# and -1 when evidence was requested without a run identity or initialized twice.
pub fn driver_evidence_identity_begin(pipeline: text) -> i64:
    if _driver_evidence_identity_captured:
        return -1
    val phase_path = rt_env_get("SIMPLE_COMPILER_PHASE_PROFILE_FILE") ?? ""
    val memory_path = rt_env_get("SIMPLE_MEM_SNAPSHOT_FILE") ?? ""
    if phase_path == "" and memory_path == "":
        return 0
    if pipeline != "streaming" and pipeline != "nonstreaming":
        return -1
    val run_id = rt_env_get("SIMPLE_EVIDENCE_RUN_ID") ?? ""
    if not _driver_evidence_run_id_valid(run_id):
        return -1
    _driver_evidence_run_id = run_id
    _driver_evidence_mode = pipeline
    _driver_evidence_identity_captured = true
    1

pub fn driver_evidence_run_id() -> text:
    if not _driver_evidence_identity_captured:
        return ""
    _driver_evidence_run_id

pub fn driver_evidence_mode() -> text:
    if not _driver_evidence_identity_captured:
        return ""
    _driver_evidence_mode
