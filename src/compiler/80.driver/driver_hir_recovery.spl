# Invocation-local HIR work ledger. Cache identity and validity remain owned by
# driver_hir_cache: PASS is a lowering outcome, never permission to load bytes.
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write, file_publish_noreplace}
use std.io_runtime.{file_exists, file_read, file_write, file_delete, dir_exists, dir_create_all, dir_list_optional, getpid}

var _hir_shard_publish_seq: i64 = 0
var _hir_shard_claim_probe_count: i64 = 0

fn hir_shard_next_publish_seq() -> i64:
    _hir_shard_publish_seq = _hir_shard_publish_seq + 1
    _hir_shard_publish_seq

# reason: scalar diagnostic probe counter for O(N) lock-free queue claim verification
@allow(primitive_api)
pub fn hir_shard_claim_probes_v1() -> i64:
    _hir_shard_claim_probe_count

pub fn hir_shard_claim_probes_reset_v1():
    _hir_shard_claim_probe_count = 0

fn hir_shard_claim_valid(record: text) -> bool:
    val fields = record.split("\n")
    fields.len() == 4 and fields[0] != "" and fields[1] != "" and fields[2] != "" and fields[3] == ""

# A replacement is only useful while inventory rows remain unclaimed; every
# claimed row is terminal after the seal, so relaunching would reload HIR for nothing.
pub fn hir_shard_recovery_can_replace(fail_fast: bool, exit_code: i64, new_claims: i64, unclaimed: i64) -> bool:
    not fail_fast and exit_code != 0 and new_claims > 0 and unclaimed > 0

pub fn hir_shard_aggregate_exit(failed_workers: i64, failed_modules: i64) -> i64:
    if failed_workers != 0 or failed_modules != 0: 1 else: 0

fn hir_shard_record_base(queue: text, path: text) -> text:
    "{queue}/{sha256_text(path)}"

fn hir_shard_record_publish(path: text, content: text) -> bool:
    file_atomic_write(path, content)

# Create-if-absent without a lock: the full record is staged privately, then
# linked into place without replacement, so readers never see a partial record.
# 1 = published, 0 = destination already exists, -1 = failure.
fn hir_shard_record_publish_new(path: text, content: text) -> i64:
    val seq = hir_shard_next_publish_seq()
    val temporary = "{path}.{getpid()}.{seq}.tmp"
    if not file_write(temporary, content):
        val _cleanup_err = file_delete(temporary)
        return -1
    val published = file_publish_noreplace(temporary, path)
    val _cleanup = file_delete(temporary)
    match published:
        case Ok(created): if created: 1 else: 0
        case Err(_): -1

fn hir_shard_owners_root_v1(queue: text) -> text:
    "{queue}/owners"

fn hir_shard_owner_dir_v1(queue: text, owner: text) -> text:
    "{queue}/owners/{sha256_text(owner)}"

fn hir_shard_tree_dir_v1(queue: text, root_owner: text) -> text:
    "{queue}/trees/{sha256_text(root_owner)}"

# Pre-publish atomic per-owner (and optional +fork root-tree) directory markers
# BEFORE linking `{base}.claim` so a crash at any instruction never leaves an
# unindexed live `.claim`, and concurrent `+fork` children never race on file_append.
fn _hir_shard_stage_owner_markers_v1(queue: text, owner: text, digest: text, path: text) -> (bool, text, text):
    val own_dir = hir_shard_owner_dir_v1(queue, owner)
    if not dir_create_all(own_dir):
        return (false, "", "")
    val own_marker = "{own_dir}/{digest}.claim"
    if hir_shard_record_publish_new(own_marker, "{owner}\n{path}\n") < 0:
        return (false, "", "")
    var tree_marker = ""
    val fork_parts = owner.split(HIR_SHARD_FORK_OWNER_MARK_V1)
    if fork_parts.len() > 1 and fork_parts[0] != "":
        val tree_dir = hir_shard_tree_dir_v1(queue, fork_parts[0])
        if not dir_create_all(tree_dir):
            val _rm_own = file_delete(own_marker)
            return (false, "", "")
        # Key by `{digest}-{sha256(owner)}` so a losing sibling under the same
        # `root_owner` cleans up only its own marker, never the winner's.
        tree_marker = "{tree_dir}/{digest}-{sha256_text(owner)}.claim"
        if hir_shard_record_publish_new(tree_marker, "{owner}\n{path}\n") < 0:
            val _rm_own = file_delete(own_marker)
            return (false, "", "")
    (true, own_marker, tree_marker)

fn _hir_shard_cleanup_owner_markers_v1(own_marker: text, tree_marker: text):
    if own_marker != "":
        val _d1 = file_delete(own_marker)
    if tree_marker != "":
        val _d2 = file_delete(tree_marker)

fn _hir_shard_marker_digest_v1(name: text) -> text:
    if not name.ends_with(".claim"):
        return ""
    if name.byte_len() > 70 and name.byte_at(64) == 45:
        return name.substring(0, 64)
    name.substring(0, name.byte_len() - 6)

# reason: ledger queue path and owner key returning verified claimed source paths
@allow(primitive_api)
pub fn hir_shard_owner_indexed_paths_v1(queue: text, owner: text) -> [text]?:
    if queue == "" or owner == "" or not dir_exists(queue):
        return None
    if not dir_exists(hir_shard_owners_root_v1(queue)):
        return None
    val own_dir = hir_shard_owner_dir_v1(queue, owner)
    var out: [text] = []
    if not dir_exists(own_dir):
        return Some(out)
    val listing = dir_list_optional(own_dir)
    if listing.is_none():
        return None
    var seen: Dict<text, bool> = {}
    for name in listing.unwrap():
        val digest = _hir_shard_marker_digest_v1(name)
        if digest == "":
            continue
        val claim_path = "{queue}/{digest}.claim"
        if not file_exists(claim_path):
            continue
        val claim = file_read(claim_path)
        if not hir_shard_claim_valid(claim):
            return None
        val fields = claim.split("\n")
        if fields.len() >= 3 and fields[0] == owner and not seen.contains_key(fields[1]):
            seen[fields[1]] = true
            out = out.push(fields[1])
    Some(out)

# Claims, terminals, and inventory publication are lockless (exclusive publish);
# claims are immutable until the invocation ends.
# Claim result codes. 1 = claimed, 0 = another owner holds it, negative =
# a named failure (hir_shard_claim_reason_v1) so the worker's error says why.
pub const HIR_SHARD_CLAIM_INVALID_ARGS_V1: i64 = -1
pub const HIR_SHARD_CLAIM_LOCK_TIMEOUT_V1: i64 = -2
pub const HIR_SHARD_CLAIM_PUBLISH_FAILED_V1: i64 = -3
pub const HIR_SHARD_CLAIM_INVALID_CLAIM_V1: i64 = -4
pub const HIR_SHARD_CLAIM_LEDGER_BLOCKED_V1: i64 = -5

pub fn hir_shard_claim_reason_v1(code: i64) -> text:
    if code == HIR_SHARD_CLAIM_INVALID_ARGS_V1: return "invalid-args (empty or multi-line owner/path/key)"
    if code == HIR_SHARD_CLAIM_LOCK_TIMEOUT_V1: return "lock-timeout (ledger .lock not acquired after retries)"
    if code == HIR_SHARD_CLAIM_PUBLISH_FAILED_V1: return "publish-failed (claim temp write or rename failed)"
    if code == HIR_SHARD_CLAIM_INVALID_CLAIM_V1: return "invalid-claim (existing claim record is corrupt)"
    if code == HIR_SHARD_CLAIM_LEDGER_BLOCKED_V1: return "ledger-blocked (another participant already blocked the ledger)"
    if code < 0: return "unknown-claim-failure ({code})"
    "ok"


pub fn hir_shard_recovery_claim(queue: text, owner: text, path: text, key: text) -> i64:
    if owner == "" or path == "" or key == "" or owner.contains("\n") or path.contains("\n") or key.contains("\n"):
        return HIR_SHARD_CLAIM_INVALID_ARGS_V1
    if queue == "" or not dir_exists(queue):
        return HIR_SHARD_CLAIM_PUBLISH_FAILED_V1
    _hir_shard_claim_probe_count = _hir_shard_claim_probe_count + 1
    val digest = sha256_text(path)
    val claim_path = "{queue}/{digest}.claim"
    # Fast-path read check before staging a temp file: claims are linked whole
    # and never deleted during an invocation, so an existing claim never needs
    # temp-file creation, hardlink attempt, or temp-file unlink.
    if file_exists(claim_path):
        return if hir_shard_claim_valid(file_read(claim_path)): 0 else: HIR_SHARD_CLAIM_INVALID_CLAIM_V1
    val (staged_ok, own_marker, tree_marker) = _hir_shard_stage_owner_markers_v1(queue, owner, digest, path)
    if not staged_ok:
        return HIR_SHARD_CLAIM_PUBLISH_FAILED_V1
    val record = owner + "\n" + path + "\n" + key + "\n"
    val published = hir_shard_record_publish_new(claim_path, record)
    if published == 1:
        return 1
    _hir_shard_cleanup_owner_markers_v1(own_marker, tree_marker)
    if published < 0: return HIR_SHARD_CLAIM_PUBLISH_FAILED_V1
    # An earlier claim landed concurrently; it was linked in complete, so validity is decidable.
    if hir_shard_claim_valid(file_read(claim_path)): 0 else: HIR_SHARD_CLAIM_INVALID_CLAIM_V1

pub fn hir_shard_recovery_terminal(queue: text, owner: text, path: text, state: text, cache_stored: bool) -> bool:
    if queue == "" or not dir_exists(queue):
        return false
    if state != "PASS" and state != "FAILED" and state != "CRASH" and state != "TIMEOUT" and state != "BLOCKED" and state != "SKIPPED":
        return false
    val base = hir_shard_record_base(queue, path)
    # The claim is immutable and only its owner terminalizes, so one exclusive
    # publish of the terminal is the only arbitration needed. An identical
    # existing terminal stays idempotent-true; a different one stays false.
    val claim = file_read("{base}.claim")
    if not hir_shard_claim_valid(claim) or not claim.starts_with(owner + "\n"): return false
    val cache = if cache_stored: "CACHE_STORED" else: "UNCACHED"
    val expected_terminal = state + "\n" + claim + cache + "\n"
    val terminal_path = "{base}.terminal"
    val published = hir_shard_record_publish_new(terminal_path, expected_terminal)
    if published == 1: return true
    published == 0 and file_read(terminal_path) == expected_terminal

# Called only after the coordinator has reaped this owner. No other owner's
# claim can be released or terminalized, and the offender is never requeued.
# The owner's fork tree ("<owner>+fork..." -- MIR fork children and the
# per-file unit loop's MIR child, see HIR_SHARD_FORK_OWNER_MARK_V1) is sealed
# with it, exactly as hir_shard_recovery_owner_tree_progress_v1 counts it:
# PR_SET_PDEATHSIG takes every rt_fork_shared_heap_v1 child down with a killed
# root, so those children never seal their own claims, and until 2026-11-13
# those rows stayed unsealed (close_inventory -1, crash attribution lost). The
# file worker's process_spawn_async batch children ("+fork-m<round>") arm the
# same signal themselves at native-build entry (Linux/FreeBSD; a host with no
# arm can still leave one running after a reaped root):
# doc/08_tracking/bug/native_build_reaped_worker_orphans_batch_children_2026-11-24.md
# Each row is terminalized under
# ITS OWN claim owner (the terminal must repeat the claim); rows a surviving
# child already sealed are skipped. Coordinator owners "<i>/<n>@<g>" never
# contain the mark, so a sibling root's tree is never matched.
fn _hir_shard_seal_dir_v1(queue: text, marker_dir: text, owner: text, allow_fork_tree: bool,
        state: text, seen: Dict<text, bool>) -> i64:
    if not dir_exists(marker_dir):
        return 0
    val listing = dir_list_optional(marker_dir)
    if listing.is_none():
        return -1
    var sealed: i64 = 0
    for name in listing.unwrap():
        val digest = _hir_shard_marker_digest_v1(name)
        if digest == "":
            continue
        if digest == "" or seen.contains_key(digest):
            continue
        val claim_path = "{queue}/{digest}.claim"
        if not file_exists(claim_path):
            continue
        val claim = file_read(claim_path)
        if not hir_shard_claim_valid(claim):
            return -1
        val fields = claim.split("\n")
        val matches_owner = fields.len() >= 3 and (fields[0] == owner or
            (allow_fork_tree and fields[0].starts_with(owner + HIR_SHARD_FORK_OWNER_MARK_V1)))
        if matches_owner:
            seen[digest] = true
            val terminal_path = "{queue}/{digest}.terminal"
            if not file_exists(terminal_path):
                if not hir_shard_recovery_terminal(queue, fields[0], fields[1], state, false):
                    return -1
                sealed = sealed + 1
    sealed

fn _hir_shard_seal_indexed_v1(queue: text, owner: text, state: text) -> i64?:
    if queue == "" or owner == "" or not dir_exists(queue):
        return None
    if not dir_exists(hir_shard_owners_root_v1(queue)):
        return None
    var seen: Dict<text, bool> = {}
    val own_sealed = _hir_shard_seal_dir_v1(queue, hir_shard_owner_dir_v1(queue, owner), owner, false, state, seen)
    if own_sealed < 0:
        return Some(-1)
    val tree_sealed = _hir_shard_seal_dir_v1(queue, hir_shard_tree_dir_v1(queue, owner), owner, true, state, seen)
    if tree_sealed < 0:
        return Some(-1)
    Some(own_sealed + tree_sealed)

pub fn hir_shard_recovery_seal(queue: text, owner: text, state: text) -> i64:
    if queue == "" or not dir_exists(queue):
        return -1
    match _hir_shard_seal_indexed_v1(queue, owner, state):
        case Some(count): return count
        case None: pass
    var sealed: i64 = 0
    val listing = dir_list_optional(queue)
    if listing.is_none(): return -1
    for name in listing.unwrap():
        if name.ends_with(".claim"):
            val claim = file_read("{queue}/{name}")
            if not hir_shard_claim_valid(claim): return -1
            val fields = claim.split("\n")
            if fields.len() >= 3 and (fields[0] == owner or
                    fields[0].starts_with(owner + HIR_SHARD_FORK_OWNER_MARK_V1)):
                val terminal_path = "{queue}/{name.substring(0, name.byte_len() - 6)}.terminal"
                if not file_exists(terminal_path):
                    if not hir_shard_recovery_terminal(queue, fields[0], fields[1], state, false):
                        return -1
                    sealed = sealed + 1
    sealed

pub fn hir_shard_recovery_progress(queue: text, owner: text) -> i64:
    if queue == "" or not dir_exists(queue):
        return -1
    if dir_exists(hir_shard_owners_root_v1(queue)):
        val own_dir = hir_shard_owner_dir_v1(queue, owner)
        if not dir_exists(own_dir):
            return 0
        val listing = dir_list_optional(own_dir)
        if listing.is_none():
            return -1
        var verified: i64 = 0
        var seen: Dict<text, bool> = {}
        for name in listing.unwrap():
            val digest = _hir_shard_marker_digest_v1(name)
            if digest == "":
                continue
            if digest == "" or seen.contains_key(digest):
                continue
            val claim_path = "{queue}/{digest}.claim"
            if not file_exists(claim_path):
                continue
            val claim = file_read(claim_path)
            if not hir_shard_claim_valid(claim):
                return -1
            if claim.starts_with(owner + "\n"):
                seen[digest] = true
                verified = verified + 1
        return verified
    var claimed: i64 = 0
    val listing = dir_list_optional(queue)
    if listing.is_none(): return -1
    for name in listing.unwrap():
        if name.ends_with(".claim"):
            val claim = file_read("{queue}/{name}")
            if not hir_shard_claim_valid(claim): return -1
            if claim.starts_with(owner + "\n"):
                claimed = claimed + 1
    claimed

# Separator between a MIR fork root's owner and its forked children's owners
# ("<root>+fork<i>/<n>[~r<k>]", driver_build/native_mir_fork_v1.spl).
# Coordinator owners ("<i>/<n>@<generation>") never contain it.
pub const HIR_SHARD_FORK_OWNER_MARK_V1: text = "+fork"

# Coordinator view of one reaped worker: its own claims plus every claim of
# the children it forked. A fork root claims nothing itself, so exact-owner
# progress would read 0 and refuse the replacement it is handing off to.
fn _hir_shard_count_dir_claims_v1(queue: text, marker_dir: text, owner: text, allow_fork_tree: bool,
        seen: Dict<text, bool>) -> i64:
    if not dir_exists(marker_dir):
        return 0
    val listing = dir_list_optional(marker_dir)
    if listing.is_none():
        return -1
    var verified: i64 = 0
    for name in listing.unwrap():
        val digest = _hir_shard_marker_digest_v1(name)
        if digest == "":
            continue
        if digest == "" or seen.contains_key(digest):
            continue
        val claim_path = "{queue}/{digest}.claim"
        if not file_exists(claim_path):
            continue
        val claim = file_read(claim_path)
        if not hir_shard_claim_valid(claim):
            return -1
        val matches_owner = claim.starts_with(owner + "\n") or
            (allow_fork_tree and claim.starts_with(owner + HIR_SHARD_FORK_OWNER_MARK_V1))
        if matches_owner:
            seen[digest] = true
            verified = verified + 1
    verified

pub fn hir_shard_recovery_owner_tree_progress_v1(queue: text, owner: text) -> i64:
    if queue == "" or not dir_exists(queue):
        return -1
    if dir_exists(hir_shard_owners_root_v1(queue)) or dir_exists("{queue}/trees"):
        var seen: Dict<text, bool> = {}
        val own_c = _hir_shard_count_dir_claims_v1(queue, hir_shard_owner_dir_v1(queue, owner), owner, false, seen)
        if own_c < 0:
            return -1
        val tree_c = _hir_shard_count_dir_claims_v1(queue, hir_shard_tree_dir_v1(queue, owner), owner, true, seen)
        if tree_c < 0:
            return -1
        return own_c + tree_c
    var claimed: i64 = 0
    val listing = dir_list_optional(queue)
    if listing.is_none(): return -1
    for name in listing.unwrap():
        if name.ends_with(".claim"):
            val claim = file_read("{queue}/{name}")
            if not hir_shard_claim_valid(claim): return -1
            if claim.starts_with(owner + "\n") or claim.starts_with(owner + HIR_SHARD_FORK_OWNER_MARK_V1):
                claimed = claimed + 1
    claimed

pub fn hir_shard_recovery_failure_count(queue: text) -> i64:
    var failures: i64 = 0
    val listing = dir_list_optional(queue)
    if listing == nil: return -1
    for name in listing.unwrap():
        if name.ends_with(".terminal"):
            val record = file_read("{queue}/{name}")
            val fields = record.split("\n")
            if fields.len() != 6 or fields[1] == "" or fields[2] == "" or fields[3] == "" or fields[5] != "":
                return -1
            if fields[4] != "CACHE_STORED" and fields[4] != "UNCACHED": return -1
            val claim_path = "{queue}/{name.substring(0, name.byte_len() - 9)}.claim"
            if file_read(claim_path) != fields[1] + "\n" + fields[2] + "\n" + fields[3] + "\n": return -1
            if not record.starts_with("PASS\n"):
                failures = failures + 1
    failures

# "<STATE> <module>" for every non-PASS terminal, sorted, so the coordinator's
# summary names each failed module instead of only counting them. Malformed
# terminals are left to hir_shard_recovery_failure_count, which reads -1.
pub fn hir_shard_recovery_failed_rows_v1(queue: text) -> [text]:
    var rows: [text] = []
    val listing = dir_list_optional(queue)
    if listing == nil: return rows
    for name in listing.unwrap():
        if name.ends_with(".terminal"):
            val fields = file_read("{queue}/{name}").split("\n")
            if fields.len() == 6 and fields[0] != "PASS" and fields[2] != "":
                rows = rows.push("{fields[0]} {fields[2]}")
    rows.sort()

# Source paths of every CRASH / TIMEOUT terminal, sorted: rows whose worker
# died or hung inside them. Under go-to-end the coordinator exports them as
# `hir_lower:<path>` on SIMPLE_ICE_SKIP_MODULES, so no downstream worker
# re-lowers a module that already killed one (driver_ice_boundary.spl
# ice_boundary_module_start). FAILED rows are not listed: a diagnostic failure
# is deterministic and cheap to redo, and recording it is what names it.
pub fn hir_shard_recovery_crashed_rows_v1(queue: text) -> [text]:
    var rows: [text] = []
    val listing = dir_list_optional(queue)
    if listing == nil: return rows
    for name in listing.unwrap():
        if name.ends_with(".terminal"):
            val fields = file_read("{queue}/{name}").split("\n")
            if fields.len() == 6 and (fields[0] == "CRASH" or fields[0] == "TIMEOUT") and fields[2] != "":
                rows = rows.push(fields[2])
    rows.sort()

# MIR fork MEMKILL (2026-11-22): the one sanctioned exception to "claims are
# immutable". The fork root SIGTERMed a child for memory (over its hard cap, or
# the host fell below its reserve); the child's unterminated rows are not a
# module failure, so instead of sealing them CRASH the root RELEASES them for a
# solo retry: an audit record goes to {queue}/memkill/<digest> (a subdirectory,
# so the seal fallback's queue listing never sees it), then the claim and its
# own/tree markers are deleted, which makes the row unclaimed again. The root
# calls this only with NO fork child alive and before forking the solo child,
# so no claimant can race the delete. A row in `released_before` was released
# once already and memory-killed again: it is sealed CRASH instead (each row is
# released at most once, so the loop terminates). Not a MEMKILL terminal: a
# terminal is immutable and could never become PASS, so the link would fail.
# Returns the rows released now; None on a ledger read/write failure.
# reason: ledger queue path, owner key and module-name rows
@allow(primitive_api)
pub fn hir_shard_recovery_release_memkill_v1(queue: text, owner: text, released_before: [text]) -> [text]?:
    val claimed_opt = hir_shard_owner_indexed_paths_v1(queue, owner)
    if not claimed_opt.?:
        return None
    var released: [text] = []
    val audit_dir = "{queue}/memkill"
    if not dir_create_all(audit_dir):
        return None
    val fork_parts = owner.split(HIR_SHARD_FORK_OWNER_MARK_V1)
    for path in claimed_opt.unwrap():
        val base = hir_shard_record_base(queue, path)
        if file_exists("{base}.terminal"):
            continue
        if released_before.contains(path):
            if not hir_shard_recovery_terminal(queue, owner, path, "CRASH", false):
                return None
            continue
        val digest = sha256_text(path)
        if hir_shard_record_publish_new("{audit_dir}/{digest}", "{owner}\n{path}\n") < 0:
            return None
        if not file_delete("{base}.claim"):
            return None
        val _own = file_delete("{hir_shard_owner_dir_v1(queue, owner)}/{digest}.claim")
        if fork_parts.len() > 1 and fork_parts[0] != "":
            val _tree = file_delete("{hir_shard_tree_dir_v1(queue, fork_parts[0])}/{digest}-{sha256_text(owner)}.claim")
        released = released.push(path)
    Some(released)

# True when the row has a terminal record (any state).
# reason: ledger queue path and module-name row
@allow(primitive_api)
pub fn hir_shard_recovery_row_terminal_v1(queue: text, path: text) -> bool:
    file_exists("{hir_shard_record_base(queue, path)}.terminal")

pub fn hir_shard_recovery_complete(queue: text, owner: text) -> bool:
    if queue == "" or owner == "" or not dir_exists(queue): return false
    hir_shard_record_publish("{queue}/{sha256_text(owner)}.done", owner)

pub fn hir_shard_recovery_finished(queue: text, owner: text) -> bool:
    file_read("{queue}/{sha256_text(owner)}.done") == owner

# A worker that crashed before claiming anything left nothing to seal and no
# partial record; its unclaimed rows stay claimable by live workers, so it
# fails only itself. Every other incomplete shape still blocks fail-closed.
pub fn hir_shard_recovery_reap_blocks_ledger_v1(code: i64, progress: i64, sealed: i64, finished: bool) -> bool:
    if code < 0 and progress == 0 and sealed == 0 and not finished: return false
    sealed < 0 or progress < 0 or (not finished and progress == 0) or code == 0 or (code > 0 and sealed > 0)

# The first BLOCKED reason wins: later participants that merely observed the
# block must not overwrite the root cause. Workers, MIR fork children and the
# coordinator all block without coordination, so the record is staged whole
# and linked in without replacement (same primitive as claims/terminals): a
# reader that sees the file sees one whole reason, and a concurrent second
# blocker observes the first instead of truncating over it (a check-then-write
# let the coordinator read an empty reason 8 of 96 rounds, 2026-11-13).
pub fn hir_shard_recovery_block(queue: text, reason: text) -> bool:
    if file_exists("{queue}/BLOCKED"): return true
    hir_shard_record_publish_new("{queue}/BLOCKED", reason) >= 0

pub fn hir_shard_recovery_blocked(queue: text) -> bool:
    file_exists("{queue}/BLOCKED")

# The first (root-cause) BLOCKED reason of a ledger, for the coordinator's
# aggregate-failure line; "" when the ledger is not blocked.
pub fn hir_shard_recovery_blocked_reason_v1(queue: text) -> text:
    if queue == "" or not file_exists("{queue}/BLOCKED"): return ""
    file_read("{queue}/BLOCKED").trim()

# Every worker publishes the same frozen source inventory before taking its
# first claim. A partial preflight has no inventory and remains global BLOCKED.
pub fn hir_shard_recovery_inventory(queue: text, identity: text, paths: [text]) -> bool:
    if queue == "" or identity == "" or paths.len() == 0 or not dir_exists(queue): return false
    val _owners_ready = dir_create_all(hir_shard_owners_root_v1(queue))
    var rows: [text] = [identity]
    for path in paths:
        if path == "" or path.contains("\n"): return false
        rows = rows.push(path)
    val record = rows.join("\n")
    val inv_path = "{queue}/inventory"
    if file_exists(inv_path):
        return file_read(inv_path) == record
    val created = hir_shard_record_publish_new(inv_path, record)
    if created == 1:
        return true
    if created < 0:
        return false
    file_read(inv_path) == record

# Why a worker's frozen inventory disagrees with the published one. A bare
# "publication failed" left the s3-wa replacement generation (5/5 workers,
# 2026-10-25) undiagnosable; this names the first differing field.
pub fn hir_shard_recovery_inventory_mismatch_v1(stored: text, identity: text, paths: [text]) -> text:
    if identity == "": return "empty closure identity"
    if paths.len() == 0: return "empty source inventory"
    if stored == "": return "no published inventory (lock or publish failed)"
    val rows = stored.split("\n")
    if rows[0] != identity: return "closure identity differs: published={rows[0]} worker={identity}"
    if rows.len() - 1 != paths.len(): return "row count differs: published={rows.len() - 1} worker={paths.len()}"
    var index = 0
    while index < paths.len():
        if rows[index + 1] != paths[index]:
            return "row {index} differs: published={rows[index + 1]} worker={paths[index]}"
        index = index + 1
    "match"

# Rows the go-to-end walk will never claim (excluded at HIR). Published beside
# the inventory under the same lock and the same must-match rule; the inventory
# itself is untouched so close_inventory and the link path see every row.
pub fn hir_shard_recovery_excluded(queue: text, identity: text, names: [text]) -> bool:
    if queue == "" or identity == "" or not dir_exists(queue): return false
    var rows: [text] = [identity]
    for name in names:
        if name == "" or name.contains("\n"): return false
        rows = rows.push(name)
    val record = rows.join("\n")
    val excl_path = "{queue}/excluded"
    if file_exists(excl_path):
        return file_read(excl_path) == record
    val created = hir_shard_record_publish_new(excl_path, record)
    if created == 1:
        return true
    if created < 0:
        return false
    file_read(excl_path) == record

# Withdraw a published inventory (and its exclusion record) while no row has
# been claimed, returning the ledger to its pre-inventory shape. Used when the
# MIR fork root declines after publishing (native_mir_fork_v1.spl): with the
# inventory left in place the coordinator's inventory close would seal every
# row BLOCKED and read "fail" instead of "fallback". False when any row is
# already claimed (nothing is withdrawn) or the ledger cannot be read.
pub fn hir_shard_recovery_withdraw_inventory_v1(queue: text) -> bool:
    val listing = dir_list_optional(queue)
    if listing.is_none():
        return false
    for name in listing.unwrap():
        if name.ends_with(".claim"):
            return false
    val inventory_gone = not file_exists("{queue}/inventory") or file_delete("{queue}/inventory")
    val excluded_gone = not file_exists("{queue}/excluded") or file_delete("{queue}/excluded")
    inventory_gone and excluded_gone

# Coordinator only, after every child has stopped. Acquire only unclaimed
# inventory rows; existing worker claims and their terminals stay immutable.
pub fn hir_shard_recovery_close_inventory(queue: text, fail_fast: bool) -> i64:
    val inventory = file_read("{queue}/inventory").split("\n")
    if inventory.len() < 2 or inventory[0] == "": return -1
    var unfinished: i64 = 0
    var index: i64 = 1
    while index < inventory.len():
        val path = inventory[index]
        if path == "": return -1
        val base = hir_shard_record_base(queue, path)
        if not file_exists("{base}.claim"):
            if hir_shard_recovery_claim(queue, "coordinator", path, inventory[0]) != 1: return -1
            val state = if fail_fast: "SKIPPED" else: "BLOCKED"
            if not hir_shard_recovery_terminal(queue, "coordinator", path, state, false): return -1
            unfinished = unfinished + 1
        elif not file_exists("{base}.terminal"):
            return -1
        index = index + 1
    unfinished

# Inventory rows with no claim yet; -1 when the inventory is unreadable.
pub fn hir_shard_recovery_unclaimed_count(queue: text) -> i64:
    val inventory = file_read("{queue}/inventory").split("\n")
    if inventory.len() < 2 or inventory[0] == "": return -1
    var excluded_set: Dict<text, bool> = {}
    if file_exists("{queue}/excluded"):
        for excl in file_read("{queue}/excluded").split("\n"):
            if excl != "":
                excluded_set[excl] = true
    var unclaimed: i64 = 0
    var index: i64 = 1
    while index < inventory.len():
        val path = inventory[index]
        if path == "": return -1
        if excluded_set.contains_key(path):
            index = index + 1
            continue
        if not file_exists("{hir_shard_record_base(queue, path)}.claim"):
            unclaimed = unclaimed + 1
        index = index + 1
    unclaimed


# Replacements wait until every worker from the current generation has stopped.
# Recheck the queue at that boundary because another worker may have claimed
# the last row after the failed worker was reaped.
pub fn hir_shard_recovery_replacements_dispatchable(queue: text, queued_replacements: i64) -> bool:
    queued_replacements > 0 and hir_shard_recovery_unclaimed_count(queue) > 0

# A worker reaped because its --timeout deadline elapsed (still running, poll
# result -2) is a TIMEOUT, not a CRASH. Exit/retry handling is identical.
pub fn hir_shard_reap_deadline_hit_v1(polled: i64, timeout_ms: i64, elapsed_ms: i64) -> bool:
    polled == -2 and timeout_ms > 0 and elapsed_ms >= timeout_ms

# The deadline is a no-progress watchdog: a worker whose owner tree claimed
# new rows since the clock was last armed gets a fresh window instead of the
# reap. An unreadable count (-1) never re-arms.
# reason: pure predicate over ledger claim counts, sibling of hir_shard_reap_deadline_hit_v1
@allow(primitive_api)
pub fn hir_shard_reap_deadline_rearm_v1(armed_claims: i64, claims_now: i64) -> bool:
    armed_claims >= 0 and claims_now > armed_claims

pub fn hir_shard_reap_state_v1(blocked: bool, code: i64, finished: bool, deadline_hit: bool) -> text:
    if blocked: return "BLOCKED"
    if code < 0:
        return if deadline_hit: "TIMEOUT" else: "CRASH"
    if finished: "FAILED" else: "BLOCKED"
