# HOISTED (2026-08-21): this was a FUNCTION-LOCAL `use` inside
# `compute_options_hash` below. The parser DISCARDS function-local `use`
# outright (10.frontend/core/parser_stmts.spl -> parse_use_stmt_inline returns a
# bare `pass`), so both names were unbound during HIR lowering: the signature's
# return type died as `unresolved type: CompileOptionsHash` and the call as
# `unresolved name: compile_options_hash_compute`. Same defect class as the
# `unresolved type: ByteOrder` case documented in
# 20.hir/hir_lowering/_Items/module_import_registration.spl. There is no cycle
# to avoid here -- cache/compile_options_hash.spl imports only std -- so the
# import belongs at module scope.
use compiler.driver.cache.compile_options_hash.{CompileOptionsHash, compile_options_hash_compute}
use compiler.common.assurance.policy.{policy_from_env_value}
use compiler.common.assurance.policy_schema.{ResolvedAssurancePolicyV1}
