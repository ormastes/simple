# Driver Helpers - Utility functions and types for the compiler driver
#
# Extracted from driver.spl to keep file sizes manageable.
# Contains:
# - Extern declarations for runtime helpers
# - Logging helper functions
# - Source reader state
# - CheckBackendImpl class
# - Source collection utilities
# - Error formatting helpers

use compiler.hir.hir.*
use compiler.backend.backend.backend_api.{Backend}
use compiler.types.type_infer.*
use compiler.borrow.borrow_check.*
use compiler.traits.trait_coherence.{CoherenceError}
use compiler.traits.trait_validation.{TraitError}
use compiler.semantics.const_eval.{ConstEvalError}
use driver_types.*

extern fn rt_dir_list(path: text) -> [text]
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_time_ms() -> i64

# Lightweight logging helpers (module-level free functions for simplicity)
# Phase 3: These stubs will be replaced with logger_port calls in
# CompilerDriver methods. Kept for backward compatibility with free functions.
fn log_debug(msg: text):
    ()
fn log_trace(msg: text):
    ()
fn log_info(msg: text):
    ()
fn log_warn(msg: text):
    print "[WARN] {msg}"
fn log_error(msg: text):
    print "[ERROR] {msg}"

# Phase 4: Track modules with fresh cached SMF (module_name -> source_path)
var _smf_cached_modules: {text: text} = {}

class CheckBackendImpl(Backend):
    fn name() -> text:
        "check"

    fn is_allowed(op: text) -> bool:
        # Allow everything for type checking
        true

    fn process_module(module: HirModule) -> Result<Any, text>:
        # Just validate, don't execute
        Ok(nil)

    fn eval_expr(expr: HirExpr, env: Environment) -> Result<Value, text>:
        # Don't evaluate, just return unit
        Ok(Value.Unit)

    fn exec_stmt(stmt: HirStmt, env: Environment) -> Result<Value, text>:
        Ok(Value.Unit)

